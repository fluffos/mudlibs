// MG-MudLib
// /d/wald/pteppic/cave10.c
// written by PtEPPiC 1995

inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

int open;

create()
{
   ::create();
   SetProp( P_INT_SHORT, "In der Eulenhoehle" );
   SetProp( P_INT_LONG,BS(
     "Der Gang endet hier in einem mittelgrossen, fast runden Raum, kein"
    +" natuerliches Licht dringt so tief ins Innere der Hoehle. Die Felswaende"
    +" sind kantig und grob, von vielen Spalten und Schatten ueberzogen, "
    +" an der oestlichen Wand kannst Du soetwas wie ein Muster erkennen." ));
   SetProp( P_LIGHT, 0 );
   SetProp( P_INDOORS, 1 );

   AddDetail( ({ "waende","wand" }) , BS(
      "Die Waende sind voller Furchen und Unebenheiten, in der Suedwand ist"
     +" die Oeffnung zu dem Gang nach draussen, an der Ostwand kannst Du" 
     +" undeutlich eine weisse Hoehlenzeichnung erkennen."
     )) ;
   AddDetail( ({"muster"}), BS( 
      "Als Du genauer hinsiehst, entpuppt sich das weisse Muster als eine"
     +" komplexe Hoehlenmalerei, Du solltest sie Dir wohl mal etwas genauer"
     +" ansehen."
      ));
   AddSpecialDetail( ({"malerei","hoehlenmalerei","zeichnung",
     "hoehlenzeichnung"}),
     "OstWand"  );
   AddDetail( ({"westwand"}), BS( 
     "Als Du naeher an die westliche Wand herantrittst, um sie zu inspizieren,"
    +" faellt die ein kleines gekritzeltes Symbol auf, unscheinbar, mit weisser"
    +" Kreide auf den kalten Fels gemalt."
     ));
   AddDetail( ({"ostwand"}), BS(
     "Eine weisse Hoehlenmalerei bedeckt fast die ganze oestliche Wand," 
    +" sie scheint vor langer Zeit entstanden zu sein." 
     ));
   AddSpecialDetail( "flamme", "Flame" );
   AddSpecialDetail( ({ "karos","karo" }), "Karo" );
   AddDetail( ({ "berge","berg" }), BS(
     "Ob die Berge in der Felszeichnung wohl die beiden Berge hier"
    +" symbolisieren sollen?"
     ));
   AddSpecialDetail( ({"symbol","gekritzel"}), "WestWand");
   AddSpecialDetail( ({"stange","steinstange"}), "Pole");
   AddSpecialDetail( ({"einkerbungen","einkerbung"}), "Carvings");
   AddSpecialDetail( "loch", "Hole" );
   AddExit( "suedosten", ROOM("cave7.lpc") );
   AddCmd( ({"drehe","dreh"}), "Turn" );
   AddCmd( ({"schlag","schlage","hacke","hack"}), "Hit" );
   AddItem( MON("owl.lpc"), REFRESH_DESTRUCT );
   open = 0;
}

string WestWand()
{
  return read_file(TEXT("pg_w_0.txt"));
}

string Flame()
{
  if (open==2) return 0;
  if (!open) return BS(
     "Als Du die Flamme in der Felszeichnung genauer betrachtest, stellst"
    +" Du fest, dass die Stelle im Stein voellig zerkratzt ist, so als haette"
    +" jemand desoefteren mit einer Spitzhacke oder einem Pickel darauf"
    +" eingeschlagen." );
   return "In der Flamme der Zeichnung stecke eine Spitzhacke." ;
}

string OstWand()
{
  switch ( open )
    {
      case 0:  return read_file(TEXT("pg_e_0.txt"));
      case 1:  return read_file(TEXT("pg_e_1.txt"));
      default: return read_file(TEXT("pg_e_2.txt"));
    }
}

string Pole()
{
  if (!open) return 0;
  return BS(
   "Auf der Dir zu gewandeten Seite der waagrecht aus der Wand stehenden"
  +" Stange sind seltsame Einkerbungen." );
}

string Carvings()
{
  if (!open) return 0;
  if (open==1) return read_file(TEXT("pg_e_3.txt"));
  return read_file(TEXT("pg_w_0.txt"));
}
 
string Karo()
{
  switch( open )
   {
     case 0: return BS(
       "Du kannst nichts ungewoehnliches an den Karos erkennen. Was sie wohl"
      +" bedeuten moegen?");
     case 1: return BS(
       "Aus dem mittleren Karo der Zeichnung ragt eine etwa 50cm lange Stange"
      +" aus der Wand hervor." );
     case 2: return 0;
   }
}

string Hole()
{ 
  if (open==1) return BS(
    "Wo vorher das mittlere Karo in der Zeichnung war, ist jetzt ein dunkles"
   +" Loch, in das Du nicht besonders tief hineinsehen kannst. Aus ihm ragt"
   +" eine steinerne Stange." );
  return 0;
}

int Turn( string str )
{
 if (str=="stange" || str=="steinstange")
  {
   if (!open) return 0;
   if (open==2) 
     {
       write( "Die Stange sitzt in ihrer Position fest.\n"); 
       return 1;
     }
   write( BS(
    "Du drehst die steinerne Stange mit dem Symbol auf der Dir zu gewandten"
   +" Seite unter leichter Anstrengung gegen den Uhrzeigersinn. Lautes"
   +" Knirschen ertoent von der oestlichen Seite der Hoehle her, Staub rieselt"
   +" von der Decke. Du hoffst das Du die Hoehle nicht zum einstuerzen bringst.\n"
   +"Als Du die Stange soweit gedreht hast, dass das kleine weisse Symbol nun"
   +" auf dem Kopf steht, rastet sie ein und ploetzlich erbebt fuer einen"
   +" kurzen Augenblick die ganze Hoehle, als sich die Westwand in der Mitte"
   +" teilt und wie die beiden Haelften einer Schiebetuer durch einen"
   +" verborgenen Mechanismus zur Seite schiebt, um den Blick freizugeben, auf"
   +" eine riesige, dahinter verborgene Felszeichnung." ));
   open++;
   return 1;
  } 
 return 0; 
}

int Hit( string str ) 
{
  notify_fail( "Womit willst Du das machen?\n" );
//  if (!present( "hacke",TP)
//    return 0;
  notify_fail( "Sowas siehst Du hier nicht.\n" );
  if ( open==2 ) return 0; 
  notify_fail( "Die Spitzhacke steckt schon in der Flamme fest.\n" );
  if ( open==1 ) return 0;
  notify_fail( "SYNTAX: schlage womit wohin \n" );
  if ( str=="mit spitzhacke in flamme" || str=="mit pickel in flamme" ||
       str=="spitzhacke in flamme" || str=="pickel in flamme" ||
       str=="hacke in flamme" ||
       str=="mit hacke in flamme" )
    {
      open++;
      write( BS(
       "Du schlaegst mitten in die Flamme in der Felszeichnung. Ein ratterndes"
      +" Geraeusch ertoent tief in der Felswand. Das mittlere Karo in der"
      +" Zeichnung wird durch einen verborgenen Mechanismus nach hinten gezogen"
      +" und eine Stange kommt in dem karofoermigen Loch zum Vorschein." ));
      return 1;  
    }
  return 0;
}

reset()
{ 
  ::reset();
  if (open!=0) 
  {
   write( BS("Ein greller Lichtblitz erfuellt den Raum - Du bist fuer ein paar"
            +" Sekunden geblendet, dann gewoehnen sich Deine Augen wieder an die"
            +" Dunkelheit der Hoehle." ));
   open=0;  
  }
}
