inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Geisterwald" );
  SetProp( P_INT_LONG,BS( 
    "Du stolperst weiter durch das schier endlose Grau, Deine Haut ist schon "+
    "ganz feucht vom Nebel. Du glaubst, die Luft bald nicht mehr atmen zu "+
    "koennen so dicht und undurchdringbar ist er. In Schlangenlinien bewegst "+
    "Du Dich zwischen fahlen Silhouetten von Baeumen hindurch, nicht selten "+
    "laeufts Du fast gegen eine der hohen Tannen. Hoffentlich kommst Du bald "+
    "hier raus, den Weg scheints Du entgueltig verloren zu haben." ));

  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "nebel" }), BS( "" ));
  AddDetail( ({ "moos" }), BS( "" ));
  AddDetail( ({ "boden" }), BS( "" ));
  AddDetail( ({ "himmel" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  AddDetail( ({ "tannen" }), BS( "" ));
  AddDetail( ({ "baeume" }), BS( "" ));
  AddDetail( ({ "silhouetten" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

//  AddItem(MON("geist"),REFRESH_DESTRUCT);
}
