inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Im Gebirgssee" );
  SetProp( P_INT_LONG,BS(
    "Du tauchst unter ins kuehle Nass des Gebirgssees, langsam gewoehnst Du "+
    "Dich an das Tauchen, das Atmen des Wassers, den leichten Druck auf den "+
    "Ohren und. Ein leuchtendes Blau umgibt Dich, ein Schwarm kleiner, bunter "+
    "Suesswasserfische schwimmt taenzelnd im bewegten, von oben einfallenden "+
    "Lichtschein vor Deiner Nase vorbei. Unter Dir wird es zunehmend dunkler, "+
    "Du erkennst jedoch ein paar Schlingpflanzen die von unten, Dir entgegen "+
    "in die Hoehe wachsen." ));"
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

  AddDetail( ({ "wasser"}), BS( "" ));
  AddDetail( ({ "licht", "lichteinfall", "lichtschein" }), BS( "" ));
  AddDetail( ({ "pflanzen", "schlingpflanzen" }), BS( "" ));
  AddDetail( ({ "blau"}), BS( "" ));
  AddDetail( ({ "fische", "schwarm", "suesswasserfische" }), BS( "" ));
  AddDetail( ({ "boden", "grund" }), BS( "" ));
  AddDetail( ({ "oberflaeche" }), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));

  AddExit( "unten", ROOM( "taucht weiter nach unten#lake2.lpc") );
//  AddItem(MON(""),REFRESH_DESTRUCT);
}
