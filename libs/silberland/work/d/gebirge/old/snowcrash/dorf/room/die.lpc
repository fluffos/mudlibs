inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_SHORT, "Ein schwarzer Wuerfel" );
  SetProp( P_LONG,BS(
  SetProp( P_NAME, "Wuerfel" );
  SetProp( P_GENDER, MALE );
  AddId( ({ "wuerfel" }) );

  SetProp( P_NOGET, 1 );

  AddCmd( ({ "rolle", "wuerfel" }), #'roll );
}

roll( string what )
{
  notify_fail( "SYNTAX: rolle WAS\n" );
  if ( !( what=="wuerfel" /* || what== ADJECTIVE */ ) ) return 0;
 
  eyes=random(6)+1;    
  write( BS(
    "Du rollst den "+COLOUR+" Wuerfel, und er bleibt mit einer "+eyes+" nach "+
    "oben liegen." ));
  say( TPN + " rollt einen Wuerfel.\n" );
  return 1;
}
