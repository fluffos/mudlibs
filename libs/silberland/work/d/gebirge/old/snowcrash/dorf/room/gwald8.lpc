create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Geisterwald" );
  SetProp( P_INT_LONG,BS( 
    "Verdammt, jetzt bist Du auch noch genau in einen Fluss getreten. Bis zu "+
    "den Knien circa fuehlst Du das kalte Nass bis auf die Haut. Schau "+
    "lieber, dass Du trotz dem dichten Nebel, der dir selbst die Sicht auf "+
/*????*/    "das Wasser vor Dir verwaehrt, moeglichst schnell hier rauskommst, sonst "+
    "faengst Du Dir noch eine Grippe ein." ));
  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "nebel" }), BS( "" ));
  AddDetail( ({ "moos" }), BS( "" ));
  AddDetail( ({ "boden" }), BS( "" ));
  AddDetail( ({ "himmel" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  AddDetail( ({ "tannen" }), BS( "" ));
  AddDetail( ({ "baeume" }), BS( "" ));
  AddDetail( ({ "silhouetten" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  AddDetail( ({ "weg" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

//  AddItem(MON("geist"),REFRESH_DESTRUCT);
}
