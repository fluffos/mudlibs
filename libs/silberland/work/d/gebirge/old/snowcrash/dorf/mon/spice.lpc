inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "/sys/moredef.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp (P_SHORT, "Mel C., eines der Spice Girls");
  SetProp (P_LONG, BS(
    "Mel C. ist ein recht huebsches Maedchen von sportlicher Statur. Sie "+
    "duerfte so um die 20 sein, hat glatte braune Haare, die ihr etwa "+
    "bis zum Kinn reichen und betaetigt sich in ihrer Freizeit gern als "+
    "Saengerin."));
  SetProp (P_NAME, "Mel C.");
  SetProp (P_GENDER, FEMALE);
  AddId ("mel");
  AddId ("mel b.");
  create_default_npc (5);
  SetProp (P_BODY, 10);
  SetProp (P_HEAL, 10);
  SetProp (P_SIZE, 12);
  SetProp (P_HANDS, ({" mit ihren zarten Haenden", 30}));
  SetProp (P_ALIGN, 50);
  SUID;
}

