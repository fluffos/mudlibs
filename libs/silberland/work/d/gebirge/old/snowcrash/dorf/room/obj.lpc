//
// written by PtEPPiC 1995

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_SHORT, "Ein umgehackter Baumstamm" );
  SetProp( P_LONG,BS(
    "Was diesen Baumstamm von allen anderen die Du bisher gesehen hast "+
    "unterscheidet ist, dass er im Inneren nicht aus normalem Holz besteht, "+
    "sondern mit Organen gefuellt ist, die eher tierische als pflanzliche "+
    "Charakteristika aufweisen, man koennte den Baum regelrecht 'ausweiden', "+
    "wie ein erlegtes Wild. Aus Holz ist nur ein etwa Rohr von etwa "+
    "zehn Zentimeter Dicke, das diese Organe schuetzend umgibt."+
  SetProp( P_NAME, "Baumstamm" );
  SetProp( P_GENDER, MALE );
  AddId( ({ "stamm", "baumstamm", "rohr" }) );

  SetProp( P_VALUE, 0 );
  SetProp( P_WEIGHT, 100000 );

  AddCmd( "weide", "gut" );
}

gut( str )
{
  notify_fail( "SYNTAX: weide WAS aus\n" );
  if ( str != "baum aus" ) return 0;

  notify_fail( 
    "Das wurde schon erledigt, der Baum ist eigentlich nur noch ein Rohr.\n" );
  if QueryProp( P_WEIGHT < 100000 ) return 0;


  write( BS(
    "Du entfernst alle Organe aus dem Inneren des toten 'Baumes' und hoehlst "+
    "ihn so total aus." ));
  say( BS(  
    TPN+" weidet einen Baum voellig aus. Blut und Gedaerme haeufen sich.",TP));
  SetProp( P_LONG, BS(
    "Dieser Baumstamm wurde innen ganz ausgehoehlt, nur ein Rohr mit etwa "+
    "zehn Zentimeter Wandstaerke ist zurueckgeblieben." ));
  SetProp( P_SHORT, "Ein umgehackter, ausgehoelter Baumstamm." );
  SetProp( P_WEIGHT, 40000 );
  AddId( "hohlbaum" );
}
