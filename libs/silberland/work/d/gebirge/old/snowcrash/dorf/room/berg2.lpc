inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Weiter oben am Berg" );
   SetProp( P_INT_LONG,break_string(
      "Der schmale Weg nach oben verliert sich hier mehr und mehr, die"
     +" Gegend gewinnt immer mehr an gebirgigerem Charakter, Flechten und"
     +" Moose bewachsen vereinzelt herumliegende Felsbrocken, die Baeume"
     +" wachsen spaerlicher.\n Du nutzt eine kurze Pause um Dich von den"
     +" Anstrengungen des Wanderns zu erholen und die Aussicht auf die"
     +" umliegende Waldregion zu geniessen.\n Graue Nebelschwaden werfen"
     +" eine Huelle um den Berg unter Dir, die deine Blicke nicht"
     +" durchdringen kennen, weiter im Sueden siehst Du hinab ins kleine"
     +" Dorf, im Westen ... und im Osten bishin .... ." ));
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddExit( "", ROOM("") );
   AddItem(MON(""),REFRESH_DESTRUCT);
}

