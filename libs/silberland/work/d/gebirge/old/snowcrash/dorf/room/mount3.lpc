inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "Am Bergsee" );
   SetProp( P_INT_LONG,break_string(
      "Die Umgebung wird immer gebirgiger, schroffe Felsformationen umgeben"
     +" Dich, steiniges Geroell bedeckt den Boden, sodass Du beim Gehen"
     +" schon etwas aufpassen musst, um Dich nicht an einer scharfen Kante zu"
     +" stossen.\n Mitten in dieser sonst so trostlos und irgendwie oeden"
     +" Umgebung eingebettet liegt ein kleiner Gebirgssee, dessen Oberflaeche"
     +" dunkelblau glaenzt wie ein Juwel."
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddExit( "", ROOM("") );
   AddItem(MON(""),REFRESH_DESTRUCT);
}

