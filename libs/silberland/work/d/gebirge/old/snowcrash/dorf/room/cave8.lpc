inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Auf einer Sandbank";
  SetProp( P_INT_LONG,BS(
    "Du stehst auf einer einzelnen Sandbank mitten im See in der "+
    "Eulenhoehle, fast wie eine Insel. Der sandige Boden unter Deinen "+
    "Fuessen ist weich und droht bei jeder Bewegung nachzugeben. Im Norden "+
    "kannst Du auf der spiegelnden Oberflaeche des Grottensees einige "+
    "groessere Steine erkennen, die eine Art Weg zu bilden scheinen."+
    "Lange Stalaktiten haengen von der Felsdecke, tropfende Geraeusche "+
    "durchdringen die Stille." ));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "waende","wand","felswand","felswaende" }) , BS(
    "Die Felswaende sind hellgrau bis weiss und scheinen sind nass von den "+
    "Tropfsteinen, hier und da scheint etwas Quarz oder anderes Mineral "+
    "an der glatten Wand zu glitzern." ));
  AddDetail( ({ "oberflaeche", "seeoberflaeche", "wasseroberflaeche" }), BS(
    "Die Oberflaeche des Wasser ist glatt und reflektierend wie ein "+
    "Spiegel, nur das herabfallednen Wassertropfen von den Stalaktiten bilden "+
    "manchmal leichte konzetrische Wellen. Im Norden kannst Du eine Reihe von "+
    "grossen, flachen Steinen erkennen." );
  AddDetail( ({ "steine" }), BS(
    "Die flachen, grauen Steine scheinen einen Weg nach Norden zu bilden, "+
    "zwar nicht in einer geraden Linie sondern etwas kurvig, aber sieh sehen "+
    "gross genug aus um auf sie steigen zu koennen, auch wenn manche etwas "+
    "weit von einander entfernt sind, und Dich zum Springen zwingen werden." )); 
  AddDetail( ({ "sand", "boden", "sandboden" }), BS(
    "Der weisse Sand scheint sich unter Dir zu bewegen, Du fuerchtest den "+
    "sicheren Stand zu verlieren. Die Sandbank auf der Du stehst ist nur "+
    "einige Meter lang, der Boden ist leicht huegelig." ));

  /* AddSound( ({ "tropfen","tropfsteine","wasser"}), BS(
     "Leise aber unentwaegt hoerst Du die kleine Wassertropfen von den"
    +" Tropfsteinen auf die Oberflaeche des Sees fallen." 
      )); */
}
