inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Unten im See" );
  SetProp( P_INT_LONG,BS(
    "Deine Fuesse beruehren den sandig, schlammigen Grund unter ihnen - Du "+
    "nun ganz am Boden des Sees. Kein Licht dringt mehr herunter, du siehst "+
    "ein paar merkwuerdige Lebensformen - einfache Tiere und Pflanzen die "+
    "diese unwirtsame Gegend bevoelkern. " );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
//  AddExit( "", ROOM("") );

  AddDetail( ({ "", "" }), BS( "" ));
  AddDetail( ({ "", "" }), BS( "" ));
  AddDetail( ({ "", "" }), BS( "" ));
  AddDetail( ({ "", "" }), BS( "" ));
//  AddSound( ({ "", "" }), BS( "" ));
//  AddSmell( ({ "", "" }), BS( "" ));
}
