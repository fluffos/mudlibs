// MorgenGrauen-MUDLib
// /d/wald/white3: Innenhof in der weissen Huette
// written by Pteppic

inherit "std/room";

include "../files.h"
include <properties.h>
include <language.h>

create()
{
  ::create();
  SetProp(P_INT_LONG, BS( 
     "Zu allen Seiten umgeben weisse Arkadengaenge den geraeumigen Innenhof"
    +" des Gebaeudes, vereinzelt Wachsen gruene Baeume eingfasst in Beeten"
    +" zwischen den Pflastersteinen die zu einem genauen Muster gelegt sind."
    +" Im Zentrum des Hofes steht ein steinerer Altar, die niedrigstehende"
    +" Sonne taucht"
    +" den Hof in rotgoldenes Licht." ));
  SetProp(P_INT_SHORT, "Im Innenhof eines grossen weissen Hauses");   
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);

  AddDetail(({"zaun"}),BS(
     ));
  AddDetail(({"blumen","rosen"}),BS(
     ));
  AddDetail(({"himmel"}),BS(
    "Ein endloses Blau, hell und rein, ohne den geringsten Makel, nicht die"
    " kleinste Wolke truebt den Blick nach oben" 
     ));
  AddDetail(({"sonne"}),BS(
    "Die Sonne strahlt golden am blauen Firmament, sie steht schon etwas tief,"
    " bald wird sie hinter dem Dach des weissen Hauses verschwinden." 
     ));
  AddDetail(({"vogel","voegel"}),BS(
    "Ein zwitschernder Vogel flattert ueber Dir im, er fliegt zu seinem Nest,"
    "dass er in den Balken des Daches gebaut hat."));
  AddDetail(({"nest","vogelnest"}),BS(""));
  AddDetail(({}),BS(""));
  AddDetail(({}),BS(""));
  AddDetail(({}),BS(""));
  AddDetail(({}),BS(""));
 
/*  AddSound(({}),BS(
    "Vogelgezwitscher erfuellt die sommerlich warme Luft, es klingt wie Musik"
    " in deinen Ohren."
     ));
*/
  AddExit( "norden", "xxx" );
  AddExit( "sueden", "xxx" );
  AddExit( "osten", "xxx" );
  AddExit( "westen", "xxx" );

}
