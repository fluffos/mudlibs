inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "In den Waeldern der ewigen Dunkelheit" );
   SetProp( P_INT_LONG,BS(
     "Nie wird Licht die ewige Nacht in diesen Waeldern erhellen koennen - "+
     "nur fahlen Schein wirft der blasse Mond ueber Dir herab - kaum genug um "+
     "die eigene Hand vor Augen sehen zu koennen. Hohe, maechtige Baeume "+
     "versperren Dir den Weg und dem groessten Teil des blassen Mondscheins "+
     "den Weg zum Boden. Leise hoerst du den Wind durch das Geaest streichen "+
     "begleitet von unheimlicvhen Tiergeraeuschen."  ));
   SetProp( P_LIGHT, 0 );
   SetProp( P_INDOORS, 1 );

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddExit( "", ROOM("") );
   AddItem(MON(""),REFRESH_DESTRUCT);
}
