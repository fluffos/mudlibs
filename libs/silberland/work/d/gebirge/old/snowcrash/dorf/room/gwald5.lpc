create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einer kleinen Huette im Geisterwald" );
  SetProp( P_INT_LONG,BS( 
    ""+
    "" ));

  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "nebel" }), BS( "" ));
  AddDetail( ({ "moos" }), BS( "" ));
  AddDetail( ({ "boden" }), BS( "" ));
  AddDetail( ({ "himmel" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

  AddExit( "westen", "#" + ROOM("gwald6") );
  AddExit( "suedosten", "#" + ROOM("gwald4") );
//  AddItem(MON("geist"),REFRESH_DESTRUCT);
}
