// MG.MudLib
// /d/wald/white1: Eingang in die weisse Huette
// written by Pteppic

create()
{
  ::create();
  SetProp(P_INT_LONG, BS( 
    "Direkt vor Dir erhebt sich ein ehrfurchterbietendes, weisses Haus, ein"
   +" makelloses Gebaeude, ganz aus Holz erbaut. Ein ebenfalls weiss"
   +" gestrichener Zaun umgebiet das Areal, der Rasen sieht gepflegt aus,"
   +" rote Blumen wachsen in den Beeten."
   +"" ));
  SetProp(P_INT_SHORT, "Vor dem Eingang zu einem grossen weissen Haus");   
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);

  AddDetail(({"zaun"}),BS(
    "Ein weisser Zaun aus einfachen, hoelzernen, oben zugespitzten Latten"
    " umgibt den Garten. Vor ihm wachsen blutrote Rosen in gepflegten Beeten."
     ));
  AddDetail(({"blumen","rosen"}),BS(
    "Rosen von einem dunklen, absolut reinen Rot, das vor dem weissen Zaun
    "fast wirkt wie Blut auf einem weissen Gewand."
     ));
  AddDetail(({"himmel"}),BS(
    "Ein endloses Blau, hell und rein, ohne den geringsten Makel, nicht die"
    " kleinste Wolke truebt den Blick nach oben" 
     ));
  AddDetail(({"sonne"}),BS(
    "Die Sonne strahlt golden am blauen Firmament, sie steht schon etwas tief,"
    " bald wird sie hinter dem Dach des weissen Hauses verschwinden." 
     ));
  AddDetail(({"dach"}),BS(
    "Das Dach ist weiss wie das ganze Haus, also Du nach oben blickst blendet"
    " Dich schon ein wenig die tief stehende Sonne." 
     ));
  AddDetail(({"eingang","tuer","pforte"}),BS(
    "Die Tuer ins innere des Hauses steht weit offen, scheint Dich mit offenen"
    " Armen zu empfangen."
     ));
  AddDetail(({"fenster"}),BS(
    "Du kannst durch eines der Fenster ins innere des Gebaeudes sehen, weisse"
    " Waende, weisse Moebel, alles strahlendes Weiss." 
     ));
  AddDetail(({"vogel","voegel"}),BS(
    "Ein zwitschernder Vogel flattert ueber Dir im, er fliegt zu seinem Nest,"
    "dass er in den Balken des Daches gebaut hat."));
  AddDetail(({"nest","vogelnest"}),BS(""));
  AddDetail(({}),BS(""));
  AddDetail(({}),BS(""));
  AddDetail(({}),BS(""));
  AddDetail(({}),BS(""));
 
  AddSound(({}),BS(
    "Vogelgezwitscher erfuellt die sommerlich warme Luft, es klingt wie Musik"
    " in deinen Ohren."
     ));

