inherit "/std/post";

#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Post von Snoqualmie" );
  SetProp( P_INT_LONG,BS( 
    "Du befindest Dich in einem typischen Postamt - vor Dir ein Schalter "+
    "hinter dem der Postmeister - ein uralter Mann mit langem weissem Bart - "+
    "sitzt, neben Dir zwei durch Vorhaenge vom Rest des Raumes abgetrennte "+
    "Schreibkabinen.\n"+
    "Du kannst hier Post die Du von anderen Spielern erhalten hast lesen und "+
    "Post an andere Spieler schreiben, indem Du <post> eingibst." ));

  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

  AddExit( "", "#" + ROOM("") );
  AddItem(MON("postler"),REFRESH_DESTRUCT);
}

