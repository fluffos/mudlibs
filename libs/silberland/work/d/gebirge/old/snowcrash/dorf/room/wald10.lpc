inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Im Wald von " );
  SetProp( P_INT_LONG,BS(
    "Die Schwaerze vor Dir ist unnatuerlich, wie ein Schlund der Dich zu "+
    "verschlingen droht, wie das abrupte Ende der Welt, wie eine absolut "+
    "glatt, schwarze Wand. Die Dunkelheit scheint exakt abgegrenzt zu sein, "+
    "wie ein mit einem Lineal gezogener Strich am braunen Waldboden, Du "+
    "nicht einmal in Umrissen erkennen, was sich hinter diesem Schleier der "+
    "Nacht verbirgt."  ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

//   AddExit( "norden", ROOM( "bergX") );
//   AddExit( "sueden", ROOM( "gwald1") );

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({ "schwaerze", "dunkelheit", }), BS( "" ));
   AddDetail( ({ "schwarz"}), BS( "" ));
   AddDetail( ({ "boden", "waldboden", "erde"}), BS( "" ));
   AddDetail( ({ "strich"}), BS( "" ));
   AddDetail( ({ "reisig","nadeln","tannennadeln"}), BS( "" ));
   AddDetail( ({ "himmel"}), BS( "" ));
   AddDetail( ({ "wand"}), BS( "" ));
   AddDetail( ({ "loch"}), BS( "" ));
   AddDetail( ({ ""}), BS( "" ));
   AddDetail( ({ ""}), BS( "" ));

   AddItem(MON(""),REFRESH_DESTRUCT);
}

