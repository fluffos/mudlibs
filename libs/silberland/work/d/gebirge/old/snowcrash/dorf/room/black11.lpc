inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG, BS( 
     "Das Zimmer ist weiss. Man kann gerade noch die Kanten ausmachen, an "+
     "denen die Waende zusammenstossen, sie heben sich in einem leichten "+
     "Grau vom Rest des Zimmers ab. Sonst ist alles weiss, kein Fenster, "+
     "keine Tuer, keine Einrichtungsgegenstaende,keine Lichtquelle, und "+
     "doch ist alles so hell hier drinnen und strahlt weiss. Weiss." ));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  AddDetail( ({""}), BS( "" );
  AddDetail( ({""}), BS( "" );
  AddDetail( ({""}), BS( "" );
//  AddSound( ({""}), BS( "" ));
//  AddSmell( ({""}), BS( "" ));

  
  AddExit( "", ROOM("") );
}

f_room_message(int msg_nr, object player)
{

  tell_object(player,message[msg_nr]);
}
