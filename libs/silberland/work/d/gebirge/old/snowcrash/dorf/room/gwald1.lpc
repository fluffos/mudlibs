inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,BS(
    "Der sich langsam bewegende Bodennebel reicht Dir nun etwa bis zu den "+
    "Knien, Du kannst nur noch selten ein Fleckchen Erdboden unter Deinen "+
    "ausmachen. Die maechtigen, dunklen Tannenbaeume stehen immer enger, "+
    "lassen immer weniger Licht zum Boden durchdringen. Die Geraeusche machen "+
    "Dich ziemlich nervoes, Du bildest Dir staendig ein, beobachtet zu werden "+
    "und glaubst dauernd, irgendwo in der Duesterheit eine Bewegung oder ein "+
    "paar Augen gesehen zu haben." ));

  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

  AddExit( "", "#" + ROOM("") );
//  AddItem(MON(""),REFRESH_DESTRUCT);
}

