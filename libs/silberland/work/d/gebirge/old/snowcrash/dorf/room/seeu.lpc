inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "An einem See bei einem Wasserfall" );
   SetProp( P_INT_LONG,BS(
     "Durch den Wasserfall noerdlich des kleinen See, an dem Du stehst"
    +" ist die Luft hier mit Feuchtigkeit ueberladen. Saftig gruenes Gras,"
    +" zarte Farne und die verschiedensten anderen Pflanzen gedeihen hier"
    +" rund um den See, auch die Bergwand beim Wasserfall ist mit leuchtend"
    +" gruenen Moosen bewachsen.\n"
    +"Ein Weg fuehrt nach Suedwesten und Nordosten am See vorbei, und nach"
    +" Norden zweigt ein kleiner Pfad ab, der die Bergwand entlang steil nach"
    +" oben fuehrt." )); 
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));
   AddDetail( ({""}), BS( "" ));

   AddExit( "norden", ROOM("fall") );
   AddExit( "nordosten", ROOM("wwx") );
   AddExit( "suedwesten", ROOM("wwy") );

 /*  AddItem(MON(""),REFRESH_DESTRUCT); */
}
