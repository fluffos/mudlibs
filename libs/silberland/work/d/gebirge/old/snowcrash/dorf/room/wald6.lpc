inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor einem Huegel" );
  SetProp( P_INT_LONG,BS(
    "Vor dem kleinen Huegel im Nebel kannst du zwei kleine steinerne Stufen, "+
    "die hinab zu einer kleinen Tuer mitten im Huegel fuehren, erkennen.\n"+
    "Du fragst Dich was hinter der Tuer im Inneren des Huegels liegen "+
    "koennte. " ));
  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 0 );

  AddExit( "", "#" + ROOM("") );

  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));
//  AddItem(MON(""),REFRESH_DESTRUCT);
}
