inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,BS(
    "Der Nebel raubt Dir jegliche Sicht, Du kannst kaum noch die eigene Hand "+
    "vor Augen erkennen, so dicht ist er. Du kannst gerade noch die hohen "+
    "schwarzen Silhouetten der Tannenbaeume im milchigen Weiss erkennen und "+
    "stolperst orientierungslos dort entlang, wo Du den Weg vermutest. "+
    "Unheimliche Geraeusche lassen Dich wuenschen, diesen Ort so schnell wie "+ 
    "nur moeglich zu verlassen, es zieht dich nach Osten, wo es etwas lichter "+
    "wird." ));

  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  AddDetail( ({ "" }), BS( "" ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

  AddExit( "", "#" + ROOM("") );
//  AddItem(MON("geist"),REFRESH_DESTRUCT);
}

