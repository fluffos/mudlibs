inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
   ::create();
   SetProp( P_INT_SHORT, "In der Eulenhoehle" );
   SetProp( P_INT_LONG,BS(
     "Der Gang endet hier in einer geraeumigen Hoehle, die bis zur Haelfe hin"
    +" mit Wasser angefuellt ist, in der klaren Oberflaeche des unterirdischen"
    +" Sees spiegeln sich die an der Decke haengenden Tropfsteine, welche, durch"
    +" die staendig auf das Wasser fallenden Tropfen, glucksende Geraeusche"
    +" erzeugen." ));
   SetProp( P_LIGHT, 0 );
   SetProp( P_INDOORS, 0 );
/*

BODEN _ WAND _ DECKE --- IN STD.HOEHLE EINBAUEN???

   AddDetail( ({ "nebel", "hochnebel"}) , BS(
      ""
     )) ;
   AddDetail( ({"wasser"}), BS(
     "Du glaubst, in der Tiefe des Wassers etwas leuchten zu sehen, vielleicht"
    +" taeuscht Du Dich auch nur."
     )); // ohne licht leuchten besser erkennbar machen !!!
   AddDetail( ({"oberflaeche","wasseroberflaeche"}), BS(
     "Die Wasseroberflaeche ist absolut glatt und eben, nicht die geringste"
    +" Stroemung stoert die Ruhe des Sees. Du kannst die gespiegelten "
    +" Stalaktiten von der Hoehlendecke erkennen, und Dir scheint so, als"
    +" wuerde etwas Licht aus den Tiefen des Sees heraufscheinen."
     ));
   AddDetail( ({"see"}), BS( "" ));
   AddDetail( ({"licht"}), BS( 
     "Du kannst nicht erkennen woher das Licht kommt, zu schwach scheint es,"
     " durch Deine zusaetzliche Lichtquelle noch an Helligkeit verlierend." ));
*/
   AddExit( "norden", ROOM("cave7") );
   AddExit( "suedwesten", ROOM("cave4") );
  // AddItem(MON(""),REFRESH_DESTRUCT);
}
