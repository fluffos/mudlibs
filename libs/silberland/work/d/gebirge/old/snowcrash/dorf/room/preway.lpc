// MorgenGrauen MudLib
// /.c
// written by PtEPPiC 1995

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,BS(
    "Du wanderst entlang eines holprigen Waldweges, passt bei jedem Schritt "+
    "auf, dass Du nicht ueber eine der zahlreichen Wurzeln stolperst oder in "+
    "eine Unebenheit trittst. Ein verwittertes Schild zeigt Dir an, dass Du "+
    "Richtung Osten, wo sich der Wald stark lichtet und Ausblick auf "+
    "bald in das Dorf Snoqualmie gelangst. Im Westen liegt der zunehmend "+
    "dichter werdende Geisterwald, Bodennebel bedecken "   ));
  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 0 );

  AddReadDetail( ({ "schild", "ortsschild" }), 
    "+-------------------------+ \n"+
    "|   W I L L K O M M E N   | \n"+
    "|                         | \n"+
    "|     in Snowqualmie      | \n"+
    "|    ( 502 Einwohner )    | \n"+
    "+-------------------------+ \n" );
  AddDetail( ({ "schild","ortschild" }), BS( 
    "Es ist schon etwas verwittert, aber der in weissen Buchstaben auf das"+
    "Holzbrett geschriebene Text ist noch deutlich zu erkennen. Im "+
    "Hintergrund ist das verblassende Bild, zweier schneebedeckter Gipfel "+
    "aufgemalt, genau, wie es sich Dir auftut wenn Du nach Osten blickst." ));
  AddDetail( ({ "nebel", "bodennebel" }), BS( 
    "Weisse, rauchige Fetzen, die bis in Kniehoehe ueber den Boden "+
    "hinwegziehen, vom Wind angetrieben, manchmal recht hohe "+
    "Geschwindigkeiten erreichend, sehen aus wie eine Fluessigkeit "+ ));
    "durch die Du schreitest." ));
  AddDetail( ({ "waldweg", "weg" }), BS(
    "Durch die vielen Wanderer und Planenwagen, die hier entlang des Weges "+
    "kommen, sind zwei tiefe Fahrrinnen im weichen Boden, in denen noch viele "+
    "abgehackte und abgeknickte Wurzeln der umstehenden Baeume zu sehen sind. "+
    "Zwischen den Rinnen leuchtet eine gruener Mittelstreifen durch den "+
    "Bodennebel." ));
  AddDetail( ({ "fahrrinnen", "rinnen" }), BS( "" ));
  AddDetail( ({ "mittelstreifen", "streifen" }), BS( "" ));
  AddDetail( ({ }), BS( "" ));
  AddDetail( ({ }), BS( "" ));
  AddDetail( ({ }), BS( "" ));
  AddDetail( ({ }), BS( "" ));
  AddDetail( ({ "boden", "erde" }), BS(
    "Die Erde ist von den Wurzeln der umliegenden Baeume durchzogen, "+
    "teilweise von Reisig und weichen Moosen bedeckt, durch den nahen Fluss "+
    "ziemlich feuchtig und stellenweise etwas morastig." ));
  AddDetail( ({ "wurzeln", "wurzel" }), BS(
    "Die Wurzeln der hohen Tannen durchziehen den Boden, auch wenn sich die"+
    "Bewohner des Dorfes Snoqualmie sich Muehe zu geben scheinen, sie von der "+
    "Strasse zu entfernen. Zu oft schon waerst Du beinahe gestolpert oder "+
    "hast Dir den Fuss gestossen." ));
  AddDetail( ({ "wanderer", "passanten" }), BS( 
    "Zuweilen ziehen einige Passanten vorueber, bunt zusammengewuerfeltes "+
    "Volk, kleine Haendler und Handwerker, Gaukler und Landstreicher. Manche "+
    "sind zur Fuss unterwegs, anderes ziehen mit von mueden Gaeulen und "+
    "altersschwachen Eseln gezogenen Planenwagen durch die Lande." ));
  AddDetail( ({ "wagen", "planenwagen" }), BS( 
    "Die Planenwagen, die Dir hier entlang des Weges begenet sind, machen "+
    "einen recht heruntergekommenen Eindruck: geflicktes Leinen, profisorisch "+
    "ausgebessertes Holz, zu oft reparierte Raeder, muede Zugtiere." ));
  AddDetail( ({ "baeume" }), BS( 
    "Die Baeume sehen aus, wie ueberall hier in den Waeldern: eindrucksvoll "+
    "hohe, dunkle Douglas Tannen." ));
  AddDetail( ({ "felder", "acker" }), BS( 
    "In Richtung Dorf siehst Du etwas kultiviertes Land, das die ewigen "+
    "Waelder unterbricht, das zwar wie ein brutal in die Landschaft "+
    "gerissenes Loch wirkt, aber wenigstens fuer etwas Abwechslung sorgt." ));
  AddDetail( ({ "huegel" }), BS( 
    "Im Osten siehst Du das Dorf, zwischen gruenen, runden Huegeln "+
    "eingebettet, die sich langsam zum Horizont hin zu hohen Bergen anheben, "+
    "auf denen das ganze Jahr hindurch Schnee liegt." ));
  AddDetail( ({ "berge" }), BS(
    "Die zwei schneebedeckten Gipfel im Osten sind recht hoch, zwei Zacken am "+
    "Horizont, grau vor staehlern blauem Himmel. Der, von Deiner Position "+
    "aus, linke Gipfel traegt den Namen __HUHU__ und der rechte wird von den "+
    "ortsansaessigen __KURD__ genannt. Zusammen nennt man sie die "+
    "Zwillingsgipfel." ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

  AddExit( "osten", "#" + ROOM("") );
  AddExit( "westen", "#" + ROOM("") );
//  AddItem(MON(""),REFRESH_DESTRUCT);
}

