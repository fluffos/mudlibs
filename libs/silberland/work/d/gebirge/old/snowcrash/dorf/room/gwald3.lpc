// MorgenGrauen MudLib
// /gwald.c
// written by PtEPPiC 1995

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,BS(
    "Nebel, Nebel nichts als Nebel. Du siehst absolut nichts, ein grauer "+
    "Schleier liegt vor deinen Augen, du fuehlst die Feuchtigkeit auf Deiner "+
    "Haut und stolperst unbeholfen durch das endlose Grau. Hoffenlich laeufst "+
    "Du nicht gegen einen Baum." ));
  SetProp( P_LIGHT,   1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "nebel" }), BS( 
    "Du drehst Dich ein paar Mal um die eigene Achse und nichts scheint sich "+
    "zu veraendern, es sieht hier ueberall gleich aus. Doch halt, da ist eine "+
    "Stelle, an der der dichte Nebel etwas aufzuklaren scheint." ));
  AddDetail( ({ "stelle" }), BS( 
    "Da ist eine Art Loch, mitten in den Unendlichkeit des Nebels gerissen, "+
    "keine Ahnung, was das sein koennte, aber es sieht irgendwie unnatuerlich "+
    "aus." ));
  AddDetail( ({ "loch" }), "hole" ); 
  AddDetail( ({ "boden" }), BS( 
    "Er ist wohl da, sonst wuerdest Du hier nicht stehen, doch Du vermagst "+
    "ihn nur zu spueren, nicht zu sehen." ));
  
//  AddSound( ({ "" }), BS( "" ));
//  AddSmell( ({ "" }), BS( "" ));

//  AddItem(MON("geist"),REFRESH_DESTRUCT);
}

hole()
{
  write( 
    "Was kann das wohl sein? Du gehst einfach einmal darauf zu.\n" );
  return TP->move(ROOM("gwald4"));
}
