// allow the stored articles to be examined by the customers

string ExamineArticles( string str )
{
object sotre;
object *stuff;

  call_other( storage, "???" );
  store = find_object( storage );
  if ( !stuff = all_inventory( store ) ) return;	
  for ( i=sizeof(stuff)-1;i>=0;i-- ) 
    {
      if ( stuff[i]->id( str ) ) return stuff[i]->QueryProp( P_LONG );
    }
}
