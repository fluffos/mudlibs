// MorgenGrauen MudLib
// /d/wald/room/berg5.c
// written by PtEPPiC 1995

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include "../files.h"

#define P_PTEPPIC_WATER "pteppic_water"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "An einem kleine Bergsee" );
  SetProp( P_INT_LONG,BS(
    "Direkt vor Dir liegt ein kleiner Bergsee, dunkleblau glaenzend wie ein "+
    "Juwel, die Oberflaeche wirkt glatt wie ein Spiegel, mitten in einer "+
    "wannenartigen Felsformation, die Dich vor dem Wind schuetzt. Rund um Dich "+
    "erheben sich die grauen, schroffen Felswaende, keine Pflanze gedeiht "+
    "hier.\n"+
    "Unter Dir, rund um den See liegt nur steiniges Geroell, kantige "+
    "Felsbrocken, ueber Dir treibt der Wind Wolkenfetzen ueber den blaugrauen "+
    "Himmel." ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

  AddDetail( ({ "see" }), BS( 
    "Besonders gross ist der See ja nicht, aber von nahezu unvorstellbarer "+
    "Schoenheit. Sicherlich wird dieser Eindruck noch verstaerkt von der "+
    "extremen Kontrastwirkung zum eintoenigen Grau der umliegenden Gebirgswelt."
    ));
  AddDetail( ({ "oberflaeche" }), BS( "" ));
  AddDetail( ({ "geroell", "felsbrocken" }), BS( "" ));
  AddDetail( ({ "steine" }), BS( "" ));
  AddDetail( ({ "stein" }), BS( "" ));
  AddDetail( ({ "fels" }), BS( "" ));
  AddDetail( ({ "gebirge", "gebirgswelt" }), BS( "" ));
  AddDetail( ({ "felswaende", "felswand", "wand", "waende" }), BS( "" ));
  AddDetail( ({ "wasser" }), BS( 
    "Es ist rein und klar, hat eine dunkelblaue Faerbung wie Du sie bis jetzt "+
    "selten gesehen hast. Man kann es sicher trinken, doch es ist wohl zu "+
    "kalt um darin zu schwimmen." ));
  AddDetail( ({ "boden" }), BS( 
    "Es ist unangenehm hier entlang zu gehen, Du spuerst die kantigen Felsen "+
    "und den von Schutt und Geroell uebersaeten Boden unter Dir, und passt "+
    "bei jedem Schritt auf Dich nicht zu verletzen." ));
  AddDetail( ({ "himmel" }), BS(
    "Den Teil des Himmels, auf den Dir die zu allen Seiten aufragenden "+
    "Felswaende den Blick freigeben, hat eine blaugraue Faerbung, erinnernd "+
    "an nasse Farben, die auf einem unfertigen Bild verrinnen." ));
  AddDetail( ({ "wolken", "wolkenfetzen", "fetzen" }), BS( 
    "Duenne Fetzen von Wolken, kaum an einer Stelle dick genug um das Blau "+
    "des dahinterliegenden Himmels abzudecken, werden vom kuehlen Wind "+
    "ueber Dir hinwegbewegt." ));

  AddExit( "", ROOM("") );
//  AddItem(MON(""),REFRESH_DESTRUCT);
  AddCmd( ({ "tauche", "tauch", "schwimme", "schwimm" }), #'dive );  
}

dive()
{
  notify_fail( "Du wuerdest Dir den Tod holen, das Wasser ist saukalt.\n" );
  if (!present(TAUCHERANZUG, TP)) return 0;

  write( BS(
    "Du steigst in den kalten See und entscheidest Dich dazu, lieber "+
    "schnell mit einem Satz hineinzuspringen, um die Kaelte schneller zu "+
    "ueberwinden." ));
  say( BS( 
    TPN + " steigt in das kalte Wasser des Bergsees, springt hinein und "+
    "taucht sofort unter." ));
  TP->move( ROOM("lake1"), M_SILENT | M_GO );
}

drink()
{
int howmuch;

  TP->SetProp( P_PTEPPIC_WATER, (howmuch = TP->QueryProp(P_PTEPPIC_WATER)+1) ); 
  if ( howmuch < 3 ) {
    write(
    "Das Wasser ist eiskalt, aber Du fuehlst Dich erfrischt und gestaerkt.\n" );
    TP->Heal_Self( random(10+5) );
  }
  else if ( howmuch < 5 ) {
    write( BS(
      "Schoen langsam hast Du genug von dem kalten Wasser .. dir zitterst "+
      "schon am ganzen Koerper." ));
//    clone_object( "schnupfen" )->move( TP );
  } 
  else {  
    write( BS( 
      "Du hast zuviel von dem eiskalten Wasser getrunken, jetzt scheinst Du "+
      "Dir eine Krippe eingefangen zu haben, das hast Du nun davon." ));
//    clone_object( "krippe" )->move( TP );
  }
  say( 
    TP + " trinkt etwas Wasser aus dem See.\n" );
}
