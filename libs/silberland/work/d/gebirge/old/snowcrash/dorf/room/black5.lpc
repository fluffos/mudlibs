inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include "../files.h"

create()
{
  ::create();
  SetProp( P_SHORT, "Ein leuchtender Kubus" );
  SetProp( P_LONG, BS( 
    "Ein leuchtender Wuerfel, mit etwa einem Meter Seitenlaenge, schwebt vor "+
    "Dir in der Dunkelheit. Er dreht sich um mehrere Achsen, und emittiert "+
    "dabei strahlend helles Licht, seltsame Muster bewegen sich staendig "+
    "ueber seine Oberflaeche hinweg." ));
  SetProp( P_INT_SHORT, "In einem kubischen Raum" );
//  SetProp( P_INT_LONG,BS( 
//    "Du bist umgeben von spiegelnden Stahlwaenden in einem wuerfelfoermigen, "+
//    "Raum nur der Boden hat andere Beschaffenheit. Er ist glatt und schwarz." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_TRANSPARENT, 1 );

  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));
  AddDetail( ({""}), BS( "" ));

  
  AddSound( ({""}), BS( "" ));
  AddSmell( ({""}), BS( "" ));

  AddExit( "", ROOM("") );
//  AddItem( OBJ("greendie"), REFRESH_DESTRUCT );
//  AddItem( OBJ("reddie"), REFRESH_DESTRUCT );
//  AddItem( OBJ("bluedie"), REFRESH_DESTRUCT );
}

_query_int_long()
{
string str;

  str =  
    "Du bist umgeben von spiegelnden Stahlwaenden in einem wuerfelfoermigen, "+
    "Raum nur der Boden hat andere Beschaffenheit. Er ist glatt und schwarz. ";
  present( "blackdie")->query_eyes() )
}
