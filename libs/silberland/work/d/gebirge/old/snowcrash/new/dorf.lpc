// desc:  	alle raeume im dorf im freien
// file: 	/d/gebirge/snowcrash/dorf/dorf.c
// author:	snowcrash@sl.mud.de
// last update:	20-08-97

inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "../defs.h"

create()
{
   ::create();
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:7]));

   AddDetail( ({ "nebel", "nebelschwaden"}) , BS(
      "Ziemlich duenne Nebelschwaden kriechen, von der leichten Brise angetrieben, ueber das Dorf hinweg. Du stehst bis zu Deinen Knien im milchigen Nebel."
     )) ;
   AddDetail( ({"brise","wind"}), 
      "Der Wind weht sacht aber kuehl vom Norden her, sehen kannst Du ihn"
     +" nicht wirklich, hoechstens in Form von Nebelschwaden und verdorrtem"
     +" Laub, die er ueber den Boden hinweg weht." ));
   AddDetail( "himmel", 
      "Eine graue Wolkendecke verbirgt den Himmel, Du bist Dir nicht einmal"
     +" sicher, wo genau die Sonne im Moment steht." );
   AddDetail( ({"wolken","wolkendecke"}), 
      "Die blassgraue, dichte Wolkendecke verbirgt den gesammten Himmel." );
   AddDetail( "sonne", 
      "Sie ist von der grauen Wolkendecke verborgen, Du wirst sie hier im"
     +" Dorf wohl nie zu Gesicht bekommen." );
   AddDetail( ({"dorf",tolower(TOWN_NAME)}), 
      "Du befindest Dich in "+TOWN_NAME+", einem stillen, kleinen Dorf in"
     +" den Bergen von "+LAND_NAME+"." );
   AddDetail( ({"berge"}), 
      "Die Berge sind ziemlich hoch und in Nebel verhuellt, nur die Spitzen"
     +" siehst Du herausragen." );
   AddDetail(({"spitzen","gipfel"}), 
      "Die Gipfel der Berge ragen durch die dichte Nebeldecke." );
   AddDetail( "gesicht", 
      "Kannst du ohne Spiegel wohl kaum sehen... Aber scheinbar bist du eh"
     +" ein Script und hast gar kein Gesicht. Na hoffentlich erzeugt das jetzt"
     +" keine Endlosrekursion. ;)" );
   AddDetail( "script",
      "Sowas wie Du." );
   AddDetail( "wetter", 
      "Es ist ziemlich eingezogen, eine dichte Wolkendecke verbirgt den Himmel"
     +" zur Gaenze. Eine kuehle Brise weht vom Norden her durch das Dorf." ); 
   
}
