// Der Geist von Daron

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <moredef.h>
#include <defines.h>

int counter;

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Der Geist von Daron");
  SetProp(P_LONG,
    "Dies ist der Geist Darons, einem der groessten Helden der Zwerge. "
    "Er klagt und jammert ueber sein Leid.\n"
  );

  SetProp(P_NAME, "Daron");
  AddId( ({"geist", "zwergengeist","daron"}) );
  set_living_name("daron");
  SetProp(P_GENDER, MALE);
  create_default_npc(20);

  SetProp(P_BODY, 0);
  SetProp(P_HANDS, ({" mit seiner Verzweiflung", 150, DT_MIND}));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Zwergengeist");
  SetProp(P_SIZE, 126);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "tritt aus einer magischen Wolke");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  SetProp(P_MNPC_AREA, ({"/d/gebirge/orw/grotte/room"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/gebirge/orw/grotte/room/grotte10");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);


  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      -1.0, DT_COLD:      -0.9, DT_WATER:    -1.0, DT_AIR:    -0.8,
      DT_LIGHTNING: -0.9, DT_EXPLOSION: -1.0, DT_SOUND:    -0.9, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      -1.0, DT_POISON:   -1.0, DT_TERROR: -1.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    -0.7, DT_MAGIC:     1.0, DT_MIND:   -1.0,
      DT_SLASH:     -1.0, DT_BLUDGEON:  -1.0, DT_PIERCE:   -1.0, DT_WHIP:   -1.0,
      DT_SQUEEZE:   -1.0, DT_RIP:       -1.0
     ]) );

  SetChats(3, ({
    "Der Geist von Daron klagt ueber sein Leid.\n",
    "Der Geist von Daron schwebt durch den Raum.\n",
    "Der Geist von Daron jammert entsetzlich.\n",
    "Der Geist von Daron loest sich in Luft auf und taucht sofort wieder auf.\n"
    }));

  SetProp(P_DEFAULT_INFO, "sagt: Ach koennte ich nur in Frieden ruhen!\n");
  AddInfo("ruhen",
	  "Ich moechte endlich in Frieden ruhen.",
	  "sagt: ");
  AddInfo("frieden",
	  "Ich kann nur dann in Frieden ruhen, wenn mich jemand "
	  "in einem fairen Kampf besiegt.",
	  "jammert: ");
  AddInfo("kampf",
	  "Ich bin mit normalen Waffen fast nicht zu verletzen.",
	  "spricht: ");
  AddInfo("waffen",
	  "Nur mit meiner Axt kannst Du mich besiegen.",
	  "sagt: ");
  AddInfo("axt",
	  "Wenn Du mich darum bittest, werde ich sie Dir geben.",
	  "sagt: ");
  AddInfo("leid",
	  "Vor langer Zeit hat mich Arknol in dieser Hoehle eingesperrt.",
	  "erzaehlt: ");
  AddInfo("arknol",
	  "Arknol ist der Gebirgsdaemon.",
	  "sagt: ");
  AddInfo("gebirgsdaemon",
	  "Er wurde in dieser Hoehle auf ewig verschlossen.",
	  "sagt: ");

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-55,T_RANGE_MAX:85]) );

  SetProp(P_SPELLRATE,  30);

  AddSpell(1,380,
   "Der Geist von Daron pruegelt wie wild auf Dich ein.\n",
   "Der Geist von Daron pruegelt wie wild auf @WEN ein.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,350,
   "Der Geist von Daron schwebt durch Dich hindurch.\n",
   "Der Geist von Daron schwebt durch @WEN hindurch.\n",
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_DIE_MSG, " loest sich dankend in Luft auf.\n");
  SetProp(P_NOCORPSE, 1);

  SUID;
  CLONEME( "/d/gebirge/orw/grotte/obj/gwuerfel");

  AddCmd( "bitte", "fktbitte" );
  counter=1;

}

int fktbitte(string str)
{
  object axtobj;
  notify_fail("Wen moechtest Du um etwas bitten?\n");
  if(!str) return 0;
  if (str=="daron um axt" ||
      str=="daron um geisteraxt" ||
      str=="um axt" ||
      str=="daron um waffe" ||
      str=="um geisteraxt" ||
      str=="um waffe")
  {
       if (!counter) return write(
         "Daron sagt: Ich habe die Axt schon hergegeben.\n"),1;
       axtobj = clone_object("/d/gebirge/orw/grotte/weapon/g_axt");
       if (axtobj->move(this_player(),M_GET|M_SILENT)== ME_TOO_HEAVY)
       {
       	 write(BS("Daron kann Dir die Axt nicht geben, da sie Dir zu schwer ist.\n"));
         axtobj->remove();
       	 return 1;
       }
       write(
       "Du bittest Daron um die Axt.\n"
       "Der Geist fliegt durch eine Wand und kommt einen kurzen "
       "Moment mit der Axt in den Haenden zurueck.\n"
       "Der Geist von Daron gibt Dir die Geisteraxt.\n");
       say(this_player()->Name()+
       " bekommt von Daron eine Axt.\n",this_player());
       counter--;
  return 1;
  }
 else return 0;
}    

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  write_file("/d/gebirge/orw/grotte/log/npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Daron.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    command_me("iss leiche");
    write_file("/d/gebirge/orw/grotte/log/npc.deads",
      ctime()+": Daron hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}                
          

reset()
{
      ::reset();
      counter=1;
}








