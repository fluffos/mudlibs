inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <defines.h>


void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Arknol, der Gebirgsdaemon");
  SetProp(P_LONG,
    "Arknol ist einer der aeltesten Daemonen im Silberland. Er ist zur "
    "selben Zeit entstanden als auch das Gebirge entstanden ist. Sein "
    "Koerper scheint vollkommen aus Stein zu sein. Seine Augen leuchten "
    "wie Rubine und seine Zunge ist so gruen wie ein Smaragd. Er koennte "
    "Dich mit einer Hand zerdruecken. Vor langer Zeit wurde er von einem "
    "maechtigen Krieger der Zwerge gefangen und hier in den Tiefen dieser "
    "Grotte eingesperrt.\n" );
  SetProp(P_NAME, "Arknol");
  SetProp(P_GENDER, MALE);
  AddId(({"arknol", "gebirgsdaemon","daemon"}));
  set_living_name("arknol");
  SetProp(P_INFO, "Arknols Koerper besteht vollkommen aus lebendem Felsgestein." );
  AddDetail("augen", "Seine Augen strahlen wie ein Rubin.");
  AddDetail("zunge", "Seine Zunge leuchtet gruen wie ein Smaragd.");
  SetProp(P_SMELL, "Trotz seines furchteregenden Aussehens duftet Arknol nach frischer Gebirgsluft.\n");
  SetProp(P_SOUND, "Arknol bruellt daemonisch!\n");

  create_default_npc(40);

  SetProp(P_ATTRIBUTES, ([ A_DEX:40, A_STR:40, A_INT:40, A_CON:40 ]) );

  SetProp(P_HANDS, ({" mit seinen Felsklauen",500,DT_BLUDGEON}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+100);
  SetProp(P_XP, QueryProp(P_XP)+10000);
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 546);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_BODY, QueryProp(P_BODY)+80);
  SetProp(P_RESISTANCE_STRENGTHS  , ([ DT_BLUDGEON:-1.0, DT_FIRE:-0.9, DT_WATER:-0.8, DT_AIR:0.1 ]));
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "kommt laut bruellend herein");
  SetProp(P_MSGOUT, "stampft raus");
  SetProp(P_MMSGIN, "kommt laut bruellend herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");

  SetChats(3, ({
    "Arknol bruellt entsetzlich.\n",
    "Arknol bruellt: Nie wirst Du lebend aus dieser Grotte entkommen!\n",
    "Arknol bruellt: Ich werde Dich zermalmen!\n",
    "Arknol durchdringt Dich mit seinen Blicken.\n"
    }));


  SetProp(P_DIE_MSG,  " stirbt mit einem entsetzlichen Schrei.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wir werden uns in der Hoelle wieder sehen!!!");
  SetProp(P_KILL_NAME, "Arknol, der Gebirgsdaemon");
  SetProp(P_KILL_MSG, "zerfetzt die Leiche in kleine Stuecke.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0 ]));

  AddInfo(DEFAULT_INFO, "bruellt Dich an.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Arknols Augen beginnen zu gluehen!\n" }) );

  SetProp(P_SPELLRATE,65);
  AddSpell(1,1100,
    "Arknol reisst Dir beinahe den Kopf aus.\n",
    "Arknol reisst @WEM beinahe den Kopf aus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,800,
    "Arknol zertruemmert Dir das Gesicht.\n",
    "Arknol zertruemmert @WEM das Gesicht.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,500,
    "Arknol zerbroeselt Dich zwischen seinen Steinfingern.\n",
    "Arknol zerbroeselt @WEN zwischen seinen Steinfingern.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
    "Arknols Blicke treffen Dich wie Feuerfontaenen.\n",
    "Arknols Blicke treffen @WEN wie Feuerfontaenen.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
    "Arknol zerdrueckt Dich an der Felswand.\n",
    "Arknol zerdrueckt @WEN an der Felswand.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(15, ({
  "Arknols Augen beginnen magisch zu leuchten.\n",
  "Arknol bruellt entsetzlich.\n",
  "Arknol zerkratzt Dich mit seinen Klauen.\n",
  "Arknol pruegelt mit lauten Schreien auf Dich ein.\n",
  "Der Gebirgsdaemon zerquetscht Deinen Arm.\n",
  "Arknols Faust kracht auf Dich herab.\n",
  "Arknol bruellt: Das war ein Fehler, elender Sterblicher!.\n"}) );

    SUID;
    CLONEME("/d/gebirge/orw/grotte/armour/thrak");
    command("trage thrak");
    "/obj/gemmaster"->DistributeGem(1,2,1,1);
    CLONEME("/obj/gems/rubin");
    CLONEME("/obj/gems/rubin");
    CLONEME("/obj/gems/smaragd");

    AddCmd( ({ "druecke","drueck" }),"nopefkt" );

}

int nopefkt(string str)
  {
  write("Arknol laesst Dich das nicht machen.\n");
  return 1;
  }


// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  object ob;
  if(objectp(ob=present("\nbarden_hero_killquest", QueryProp(P_KILLER)))) {
    ob->Mark();
  }
  
  write_file("/d/gebirge/orw/grotte/log/npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Arknol.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    command_me("iss leiche");
    write_file("/d/gebirge/orw/grotte/log/npc.deads",
      ctime()+": Arknol hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}                
                 

