
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Grottenolm");
  SetProp(P_LONG,
    "Der Grottenolm wuselt um deine Fuesse herum.");
  SetProp(P_NAME, "Grottenolm" );
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"grottenolm", "olm" }));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinem Maul",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_XP, QueryProp(P_XP)+5*100);
  SetProp(P_RACE, "Olm");
  SetProp(P_SIZE, 15);
  SetProp(P_ALIGN, -100);


  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "verkriecht sich");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp(P_KILL_MSG, "Du haettssst esss gar nicht erssst versssuchen sssollen!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("orw", "Orw hat mich erschaffen.","sagt: ");



  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Grottenolm will Deine Sachen nicht tragen.\n" }) );


  SetProp(P_SPELLRATE,90);
  AddSpell(6,100,
    "Der Grottenolm greift Dich mit seinen Giftzaehnen an.\n",
    "Der Grottenolm greift @WEN mit seinen Giftzaehnen an.\n",
    ({DT_POISON,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
    "Der Grottenolm veraetzt dich mit seiner Haut.\n",
    "Der Grottenolm veraetzt @WEN mit seiner Haut.\n",
    ({DT_POISON,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Grottenolm zischt Dich an.\n"}) );

  SetAttackChats(10, ({
    "Der Grottenolm pfaucht wild.\n"}) );

}