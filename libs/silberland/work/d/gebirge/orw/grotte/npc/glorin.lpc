// Fuer Hoehlenforscherquest geaendert am 04.03.2001 (Orw)
// Von Glorin bekommt man jetzt die Pinzette


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

string pinzettenantwort(string key);
string tauschantwort(string key);

void create() {

  object ob;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Glorin, der Grottenwaechter");
  SetProp(P_LONG,
    "Dieser steinalte Zwerg passt auf den Grotteneingang auf. Er hat einen sehr "
    "langen, grauen Bart. Trotz seines Alters sehen seine Augen noch unglaublich "
    "jung aus. Aufmerksam bewacht er das Tor zur Grotte. Solange er hier ist "
    "wird er Dich sicher nicht reinlassen." );

  SetProp(P_NAME, "Glorin");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"glorin", "waechter", "grottenwaechter", "zwerg","glorinistderwaechter" }));

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen alten Haenden",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 116);
  SetProp(P_ALIGN, 100);
  SetProp(P_XP, 500000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HP, 500);
  SetProp(P_SP, 500);
  SetProp(P_BODY, 100);
  set_living_name("glorin");

  SetProp(P_MSGIN, "kommt an um das Tor zu bewachen");
  SetProp(P_MSGOUT, "verschwindet in einer Felsspalte");

  SetProp(P_DIE_MSG,  " macht mal ein kleines Nickerchen.\n");

  SetProp(P_LOG_INFO, "/orw/hquest.log");

// Antworten des NPCs
  AddInfo(DEFAULT_INFO, ({
    "zieht fragend eine Braue hoch.\n",
    "sagt: Da musst Du jemand anders fragen!\n",
    "schaut Dich gelangweilt an.\n",
    "grummelt: Ich bin hier der Waechter und nicht Deine Infotante.\n",
    "sagt: ???\n"
    }));


  AddInfo("orw", "Er kommt oft hier her und besucht mich.","sagt: ");

  AddInfo( ({"grotte","grotteneingang","eingang"}),
    "Ich bewache im Auftrag des Aeltestenrates den Eingang um Abenteurer "
    "vor den Gefahren zu schuetzen.",
    "sagt: ");

  AddInfo( ({"gefahren","sterben","ende","abenteurer"}),
    "Es sind schon soviele in der Grotte umgekommen.",
    "seufzt: ");

  AddInfo( ({"rat","aeltestenrat","aeltesten"}),
    "Der Aeltestenrat hat vor Jahren beschlossen die Grotte zu versiegeln "
    "damit das sinnlose Sterben ein Ende nimmt.",
    "sagt: ");

  AddInfo( ({"jahre","jahren","zeit"}),
    "Ich bin schon so lange hier, ich glaube fast die Aeltesten haben auf "
    "mich vergessen. Wenn doch endlich mal jemand kaeme um mich abzuloesen.",
    "sagt: ");

  AddInfo( ({"schluessel"}),
    "Ich weiss wo sich der Schluessel befindet, aber ich werde ihn Dir sicher "
    "nicht geben.",
    "sagt: ");

  AddInfo( ({"see","wasser"}),
    "Wenn dieser bloede See nicht waere wuerden mich meine Freunde sicher "
    "oefter besuchen kommen. Ich vermisse sie schon sooo sehr!",
    "sagt: ");

  AddInfo( ({"freunde","henk","targ"}),
    "Henk, Targ und natuerlich Orw. Ich hoffe ich seh sie bald mal "
    "wieder.",
    "sagt: ");

  AddInfo( ({"tor","grottentor","oeffnen"}),
    "Ich lasse nicht zu, dass jemand das Tor oeffnet.",
    "sagt: ");

  AddInfo( ({"kiste","holzkiste","sitzgelegenheit","sitz"}),
    "Meine Kiste ist sehr bequem. *freu*",
    "sagt: ");

  AddInfo( ({"fell"}),
    "Das Fell stammt von einem Wolf. Ich hab ihn eigenhaendig getoetet.",
    "sagt: ");

  AddInfo( ({"wolf","woelfe"}),
    "Als ich noch jung war hab ich oefter mal einen Wolf erlegt.",
    "sagt: ");

  AddInfo( ({"besitztuemer"}),
    "Wie Du siehst bin ich ziemlich arm....",
    "sagt: ");

  AddInfo( ({"tisch"}),
    "Der Tisch und die Kiste sind meine einzigen Besitztuemer. "
    "Die kleine Kerze spendet mir wenigstens ein wenig Licht. "
    "Spiel ja nicht dran rum!",
    "sagt: ");

  AddInfo( ({"hilfe"}),
    "Hilfe? Wofuer brauchst Du Hilfe? Du bist hier sicher! "
    "Ich bewache das Tor um die Kreaturen fuer ewig gefangen zu halten.",
    "sagt: ");

  AddInfo( ({"name","glorin","grottenwaechter","waechter","begruessung"}),
    "Glorin, der Grottenwaechter zu Diensten.",
    "sagt: ");

  AddInfo( ({"bart","baerte"}),
    "Ich habe einen der laengsten Baerte Felonias!",
    "sagt: ");

  AddInfo( ({"felonia","zwergenstadt","stadt"}),
    "Du kennst Felonia die Zwergenstadt nicht? Wie bist Du dann hier her gekommen?",
    "fragt: ");

  AddInfo( ({"kreaturen","kreatur","tiefen"}),
    "In den Tiefen der Grotte hausen grausame Kreaturen.",
    "sagt: ");

  AddInfo( ({"wache"}),
    "Ich wache hier schon viele Jahre.",
    "sagt: ");

  AddInfo( ({"floss"}),
    "Alles was ich brauche bekomme ich mit dem Floss geliefert.",
    "sagt: ");

  AddInfo( ({"gnom","liebe"}),
    "Der Gnom ist ganz nett, obwohl ich seine Liebe zum Wasser nicht verstehen kann.",
    "sagt: ");

  AddInfo( ({"licht","kerze"}),
    "Ohne Kerze waers hier ziemlich finster.",
    "sagt: ");

  AddInfo( ({"auftrag"}),
    "Mein Auftrag ist die Grotte zu bewachen.",
    "sagt: ");

  AddInfo( ({"dienste","diensten"}),
    "Das ist doch nur eine zwergische Begruessung!",
    "arglt: ");

  AddInfo( ({"zwerg","zwerge"}),
    "Ich bin ein Zwerg, oder sieht man das nicht.",
    "sagt: ");
    
// Antworten zum neuen Questteil der Grotte
  AddInfo( ({"mykal","grottenhirte","hirte"}),
    "Mykal ist sehr gefaehrlich, ich wuerde ihn besser in Frieden lassen.",
    "sagt: ");
  AddInfo( ({"fungil"}),
    "Oh, der ist ganz nett, hast Du ihn schon getroffen?.",
    "fragt: ");
  AddInfo( ({"mykoniden","mykonid","pilzmenschen","pilzmensch"}),
    "In der Grotte gibts Mykoniden, also sei vorsichtig!",
    "sagt: ");
  AddInfo( ({"halron","hoehlenforscher","forscher"}),
    "Vor langer Zeit ist mal ein Forscher namens Halron in die Grotte "
    "gegangen. Seither hab ich ihn nicht mehr gesehen.",
    "sagt: ");
  AddInfo( ({"kipferl","gebaeck"}),
    "Der Baecker in Felonia macht ganz besonders gute Kipferl.",
    "sagt: ");
  AddInfo( ({"baecker"}),
    "Der Baecker in Felonia macht das beste Gebaeck im ganzen Silberland.",
    "sagt: ");
  AddInfo( ({"silberland","land"}),
    "Du befindest Dich hier im Silberland.",
    "sagt: ");
  AddInfo( ({"grottenschaender","schaender"}),
    "Ich hab mal von einem gehoert, aber gesehen hab ich ihn noch nie.",
    "schaudert: ");
  AddInfo( ({"frieden","friede"}),
    "Wuenschen wir uns nicht alle Frieden.",
    "grinst: ");


// Spezialantworten fuer Questpinzette
  AddInfo( ({"tausch","tauschhandel","handel"}),
    #'tauschantwort, "sagt grinsend: ");

  AddInfo( ({ "pinzette" }),
    #'pinzettenantwort, "antwortet: ", 1);



  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Glorin bedankt sich fuer das Geschenk.\n" }) );

// Zaubersprueche des NPCs
  SetProp(P_SPELLRATE,25);
  AddSpell(4,350,
    "Glorin haut Dir seinen Bart um die Ohren.\n",
    "Glorin haut @WEN seinen Bart um die Ohren.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,400,
    "Glorin springt Dir auf den grossen Zeh.\n",
    "Glorin springt @WEN auf den grossen Zeh.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,500,
    "Glorin wuergt Dich stark.\n",
    "Glorin wuergt @WEN stark.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));

// Chats
  SetChats(1, ({
    "Glorin schaut Dich mit seinen mueden, alten Augen an.\n",
    "Glorin setzt sich fuer einen Moment auf die Kiste.\n",
    "Glorin gaehnt.\n",
    "Glorin schlaeft beinahe ein.\n",
    "Glorin streicht sich nachdenklich ueber den Bart.\n",
    "Glorin sagt: Naja, solange ich hier wache kann niemandem etwas passieren.\n",
    "Glorin sagt: In der Grotte lauern grosse Gefahren.\n"}) );
  SetAttackChats(10, ({
    "Glorin sagt: Jaja, die Jugend von heute.\n",
    "Glorin verwuenscht Dich.\n",
    "Glorin verteidigt sich mit all seiner Kraft.\n",
    "Glorin sagt: Haetten wir das nicht friedlich regeln koennen?\n"}) );

// Inventory des NPCs
  SUID;
  CLONEME( "/d/gebirge/dusty/zwerge/obj/zkaxt" );
  command( "zuecke kampfaxt");
  CLONEME( "/p/armour/armour/kettenhemd" );
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/armour/ring/ring" );
  CLONEME( "/d/huegelland/orw/pfeifenladen/obj/grottenkraut" );
  command( "trage alles");

// Funktionen
  AddCmd( ({ "tausche","tausch" }),"fkttauschen" ); // Hoehlenforscherquest

}


// Spezialantwort betreffend Questpinzette
string pinzettenantwort(string key)
{
  if (!present("LANDBEH",TP))
  {
    return
      "Ich weiss echt nicht wovon Du sprichst.";
  }
  if (present("FANGPINZETTE",TP))
  {
    return
      "Wie gehts Dir mit der Pinzette, erfuellt sie ihren Zweck?";
  }
  return
    "Ja, ich habe eine Pinzette, die gebe ich aber nicht so einfach her. "
    "Sie leuchtet so wundervoll und ist so schoen verarbeitet...\n "
    "Ich waere aber mit einem Tauschhandel einverstanden.";
} 

string tauschantwort(string key)
{
  if (!present("LANDBEH",TP))
  {
    return
      "Ich weiss echt nicht wovon Du sprichst.";
  }
  if (present("FANGPINZETTE",TP))
  {
    return
      "Wir haben doch schon getauscht, gefaellt Dir die Pinzette?";
  }
  return
    "Der Baecker von Felonia baeckt super Kipferl! Wenn Du eines holst "
    "koennten wir Kipferl gegen Pinzette tauschen.";
}

// Hoehlenforscherquest Tauschfunktion
int fkttauschen(string str) 
{
  object questkipferl;
  object questfangpinzette;

  notify_fail("Was willst Du gegen was tauschen?\n");
  if(!str) return 0;
  if(str == "kipferl gegen pinzette" ||
     str == "pinzette gegen kipferl" ||
     str == "kipferl ein" ||
     str == "mit glorin")
  {
  if(!present("kipferl",TP)) 
  {
    write(BS(
      "Glorin sagt: Du hast ja gar kein Kipferl!\n"));
    return 1;
  }  
  if(!present("LANDBEH",TP)) 
  {
    write(BS(
      "Glorin fragt: Wovon sprichst Du eigentlich?\n"));
    return 1;
  }
  if(present("FANGPINZETTE",TP)) 
  {
    write(BS(
      "Glorin sagt: Unser Tauschhandel ist doch schon abgeschlossen!\n"));
    return 1;
  }
  tell_object(TP,
    "Du gibst Glorin ein Kipferl.\n"
    "Glorin sagt: Mhm, genau das brauch ich jetzt.\n"
    "Glorin sagt: Vielen Dank, hier hast Du die Pinzette, obwohl ich mich nur \n"
    "Glorin sagt: ungern von ihr trenne.\n"
    "Glorin gibt Dir eine Pinzette.\n");
  if(questkipferl=present("kipferl",TP)) questkipferl->remove();
  questfangpinzette=clone_object("/d/gebirge/orw/quest/obj/pinzette");
  if ( ME_TOO_HEAVY==questfangpinzette->move(TP,M_GET|M_SILENT) )
    questfangpinzette->move(TO,M_NOCHECK|M_SILENT);  
  return 1;
  }
}


void give_notify(object ob)
{
  if(ob->id("kipferl"))
  {
    if (present("LANDBEH",TP))
    {
      if (!present("FANGPINZETTE",TP))
      {
        write( 
        "Glorin sagt: Ich wollte ja eigentlich tauschen, aber wenn Du mir das \n"
        "Glorin sagt: Kipferl einfach so gibst nehm ichs natuerlich gern.\n"
        "Glorin sagt: Wenn Du die Pinzette immer noch willst, kannst Du ja noch\n"
        "Glorin sagt: ein Kipferl holen und dieses Mal dann mit mir tauschen...\n");
      
      }
      else
      {
      	write(
      	"Glorin sagt: Zwei Kipferl sind immer besser als Eins!\n"
      	"Glorin sagt: Vielen Dank!\n");
      }
    }
    else
    {
      write("Glorin sagt: Wow, Danke fuer das Kipferl!\n");
    }
  }
  else
  {
    write("Glorin sagt: Danke fuer "+ob->name(WEN,1)+"!\n");
  }
}


void StartReaction(string verb, string gruppe, string adverb, int touch) {
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
	"schaut Dich verwundert an.",
	"schaut "+TPN+" verwundert an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
	"fragt Dich: Was hab ich denn gemacht?",
	"fragt "+TPN+": Was hab ich denn gemacht?");
      break;
    case "albern":
      call_out("reaction", 0, TP,
	"laechelt froehlich.",
	"laechelt froehlich");
      break;
    case "fies":
      call_out("reaction", 0, TP,
	"zwickt Dir in den Hintern.",
	"zwickt "+TPN+" in den Hintern.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	"bewegt sich kein Stueck.",
	"bewegt sich kein Stueck.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
	"sagt: Hehe, "+TPN+".",
	"sagt: Hehe, "+TPN+".");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	"ist kalt wie ein Eisblock.",
	"ist kalt wie ein Eisblock.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
	"laechelt und grinst Dich an.",
	"laechelt und grinst "+TPN+" an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	"schaut verdutzt.",
	"schaut verdutzt.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
	"troestet Dich.",
	"troestet "+TPN+".");
      break;
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  write_file("/d/gebirge/orw/grotte/log/npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Glorin.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    command_me("iss leiche");
    write_file("/d/gebirge/orw/grotte/log/npc.deads",
      ctime()+": Glorin hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}                
