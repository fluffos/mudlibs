/* Eine kleine Fledermaus
   Orw, 23.06.2000 */

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>

void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Fledermaus");
  SetProp(P_LONG,
    "Eine kleine, schwarze Fledermaus. Ihre Augen funkeln im Schein deiner "
   +"Lichtquelle. Verwirrt flattert sie herum, sie bestimmt schon seit Jahren "
   +"kein Licht mehr gesehen. Sie ist nicht sehr stark und duerfte kein grosser "
   +"Gegner fuer Dich sein. Trotzdem moechtest Du keine Bekanntschaft mit ihren "
   +"kleinen spitzen Zaehnen machen.");
  SetProp(P_NAME, "Fledermaus");
  SetProp(P_GENDER, FEMALE);
  AddId(({"maus", "fledermaus"}));

  create_default_npc(6);

  SetProp(P_HANDS, ({" mit ihren Zaehnchen", 50+random(40), DT_RIP}));
//  SetProp(P_XP, 60000);
  SetProp(P_RACE, "Fledermaus");
  SetProp(P_SIZE, 21);
  SetProp(P_ALIGN, -60);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,([P_RACE:(["Elf":0.7, "Zwerg":1, "Mensch":0.6, "Hobbit":0.7, 0:0.0])]));
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");


  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine kleine Fledermaus");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Fledermaus kann und will deine Sachen nicht tragen.\n" }) );

}

