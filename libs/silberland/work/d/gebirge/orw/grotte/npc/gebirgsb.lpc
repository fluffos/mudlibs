inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <defines.h>

object ob;

void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Die Gebirgsbestie");
  SetProp(P_LONG,
    "Die Gebirgsbestie besteht aus Felsgestein. Sie muss sehr alt "
    "sein, da auf ihrem Koerper schon Moos und einige Pilze wachsen. "
    "Aus ihrem Maul haengt noch ein halber Fuss. Durch ihre Felshaut "
    "ist sie sicher besonders gut geschuetzt. " );
  SetProp(P_NAME, "Gebirgsbestie");
  SetProp(P_GENDER, FEMALE);
  AddId(({"bestie", "gebirgsbestie","monster","jemand"}));
  set_living_name("gebirgsbestie");
  SetProp(P_INFO, "Die Gebirgsbestie besteht vollkommen aus Fels." );
  AddDetail("haut", "Die Haut ist aus Felsgestein.");
  AddDetail("moos", "Sie lebt schon seit Urzeiten.");
  SetProp(P_SMELL, "Der Gestank der Leichenteile ueberwiegt.\n");
  SetProp(P_SOUND, "Sie bruellt fuerchterlich!\n");

  create_default_npc(40);

  SetProp(P_ATTRIBUTES, ([ A_DEX:40, A_STR:40, A_INT:40, A_CON:40 ]) );

  SetProp(P_HANDS, ({" mit ihren Felshaenden",400,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 200);
  SetProp(P_XP, 3000000);
  SetProp(P_RACE, "Bestie");
  SetProp(P_SIZE, 368);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-4);
  SetProp(P_AGGRESSIVE, 0.75);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS  , ([ DT_BLUDGEON:-1.0, DT_FIRE:-0.9, DT_WATER:-0.8, DT_AIR:0.7 ]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "klettert mit einem lauten Schrei herein");
  SetProp(P_MSGOUT, "klettert raus");
  SetProp(P_MMSGIN, "stampft wuetend auf");
  SetProp(P_MMSGOUT, "verschwindet einfach");

  SetProp(P_DIE_MSG,  " wird nie mehr Abenteurer fressen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "GRRRRMMPPPPPFFF!!! Elender!");
  SetProp(P_KILL_NAME, "Die Gebirgsbestie");
  SetProp(P_KILL_MSG, "beisst der Leiche den Kopf ab.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0 ]));

  SetProp(P_TRANSPARENT, 0);

  AddInfo(DEFAULT_INFO, "bruellt Dich an.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Gebirgsbestie wird wuetend!\n" }) );

  SetProp(P_SPELLRATE,65);
  AddSpell(1,1100,
    "Die Gebirgsbestie reisst Dir mit ihren Haenden das Herz aus dem Koerper.\n",
    "Die Gebirgsbestie reisst @WESSEN das Herz aus dem Koerper.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,800,
    "Die Gebirgsbestie schlaegt Dir in den Magen.\n",
    "Die Gebirgsbestie schlaegt @WEM in den Magen.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,500,
    "Die Gebirgsbestie wirft Gesteinsbrocken auf Dich.\n",
    "Die Gebirgsbestie wirft Gesteinsbrocken auf @WEN.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Die Gebirgsbestie laesst einen Teil der Decke auf Dich stuerzen.\n",
    "Die Gebirgsbestie laesst einen Teil der Decke auf @WEN stuerzen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Die Gebirgsbestie laesst ihren wuchtigen Koerper auf Dich fallen.\n",
    "Die Gebirgsbestie laesst ihren wuchtigen Koerper auf @WEN fallen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(15, ({
  "Die Gebirgsbestie schleudert Dich gegen die Wand.\n",
  "Die Gebirgsbestie lacht Dich aus.\n",
  "Die Gebirgsbestie wirft Dir einen Steinbrocken an den Kopf.\n",
  "Die Gebirgsbestie zerkratzt Dir das Gesicht.\n",
  "Die Gebirgsbestie aechtzt.\n",
  "Die Gebirgsbestie schlaegt wild auf Dich ein.\n",
  "Die Gebirgsbestie schaut Dich finster an.\n"}) );

  AddCmd( ({ "druecke","drueck" }),"nopefkt" );
  ob=clone_object("/gilden/druidenzirkel/armour/elementarring");
  ob->set_ring_element("erz");
  ob->move(ME, M_NOCHECK);

}

int nopefkt(string str)
  {
  write("Die Bestie laesst Dich das nicht machen.\n");
  return 1;
  }


// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  write_file("/d/gebirge/orw/grotte/log/npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt die Gebirgsbestie.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    command_me("iss leiche");
    write_file("/d/gebirge/orw/grotte/log/npc.deads",
      ctime()+": Die Gebirgsbestie hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}                
                 
                 
