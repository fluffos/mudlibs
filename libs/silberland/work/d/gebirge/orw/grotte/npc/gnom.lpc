/*
** Der junge Gnom steuert das Floss
** Orw, 21.06.2000
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein junger Gnom");
  SetProp(P_LONG,
	"Der junge Gnom sitzt am hinteren Ende des Flosses und steuert es\n"
  +	"geschickt von der einen Seite des Sees zur anderen.\n");

  SetProp(P_NAME, "Gnom");
  SetProp(P_GENDER, MALE);

  AddId("gnom");
  create_default_npc( 1 );
  SetProp(P_NOATTACK, "sagt: Wer sollte denn dann das Floss steuern? Du etwa?");
  SetProp(P_BODY, 10);
  SetProp(P_ALIGN, 300);
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 93);
  create_default_npc(10);

  SUID;
  CLONEME("/d/gebirge/orw/grotte/weapon/paddel");

  SetChats(10, ({
	 "Der Gnom spritzt Dich von oben bis unten mit Wasser voll.\n",
	 "Der Gnom sagt: Ich fuehle mich nur auf meinem Floss wohl!\n",
	 "Der Gnom kratzt sich am Hintern.\n",
	 "Der Gnom sagt: Zwerge fuerchten sich vor dem See.\n",
	 "Der Gnom bohrt in der Nase.\n",
	 "Der Gnom gruebelt vor sich hin.\n",
	 "Der Gnom sagt: Ich bin als der beste Steuermann im Silberland bekannt.\n",
	 "Der Gnom fragt: Warst Du schon mal in der Grotte?\n",
	 "Der Gnom taucht sein Paddel tief ins Wasser.\n",
  }) );

  AddInfo( ({"gnom"}),
	 "Ja, ich bin ein Gnom.",
	 "sagt: ");
  AddInfo( ({"floss"}),
	 "Ich liebe mein Floss.",
	 "sagt: ");
  AddInfo( ({"zwerge"}),
	 "Ich verstehe nicht, wieso sie das Wasser hassen.",
	 "sagt: ");
  AddInfo( ({"steuermann"}),
	 "Ich bin der Beste von allen!",
	 "sagt: ");
  AddInfo( ({"grotte"}),
	 "Die Grotte soll sehr gefaehrlich sein.",
	 "sagt: ");
  AddInfo( ({"wasser"}),
	 "Das Wasser des Sees ist sehr klar.",
	 "sagt: ");
  AddInfo( ({"see"}),
	 "Ich lebe seit meiner Geburt hier beim See.",
	 "sagt: ");
  AddInfo( ({"geburt"}),
	 "Das wird jetzt zu persoenlich!",
	 "sagt: ");
  AddInfo( ({"paddel"}),
	 "Du moechtest wohl auch gerne so ein huebsches Paddel.",
	 "sagt: ");
  AddInfo( ({"hintern"}),
	 "Was ist damit? Er juckt halt!",
	 "sagt: ");
  AddInfo( ({"nase"}),
	 "Gefaellt sie Dir?",
	 "sagt: ");
  AddInfo( ({"felonia","zwergenstadt","stadt"}),
	 "Felonia ist die grosse Zwergenstadt im Westen.",
	 "sagt: ");


}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe)
  {
	 case "fies":
		call_out("react", 0, "furzt Dich an",
	"furzt "+TP->name(WEN)+" an");
		break;
	 case "aergerlich":
		call_out("react", 0, "zittert wie Espenlaub", "zittert wie Espenlaub");
		break;
	 case "traurig":
		call_out("react", 0, "troestet Dich",
		  "streichelt "+TP->name(WEM, 2)+" troestend");
		break;
	 case "albern":
		call_out("react", 0, "spritzt Dich mit Wasser voll",
		  "spritzt "+TP->name(WEN)+" mit Wasser voll");
		break;
	 case "neutral":
		call_out("react", 0, "grinst Dich an", "grinst "+TP->name(WEN)+" an");
		break;
	 case "intim":
		call_out("react", 0, "gibt der eine saftige Ohrfeige",
			"gibt "+TP->name(WEN)+" eine saftige Ohrfeige");
		break;
	 case "froh":
		call_out("react", 0, "laechelt Dich froehlich an",
		  "laechelt "+TP->name(WEN)+" froehlich an");
		break;
	 case "aengstlich":
		call_out("react", 0, "floesst Dir neuen Mut ein",
		  "floesst "+TP->name(WEM)+" neuen Mut ein");
		break;
	 case "frech":
		call_out("react", 0, "grinst Dich an", "grinst "+TP->name(WEN)+" an");
		break;
	 case "nett":
		call_out("react", 0, "taetschelt Dich", "taetschelt "+TP->name(WEN));
		break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
	 tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
	 tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
