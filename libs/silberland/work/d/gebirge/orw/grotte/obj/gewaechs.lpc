inherit "std/food";

#include <properties.h>
#include <food.h>

void create()
{
if (!is_clone(this_object())) return;
::create();

SetProp(P_SHORT, "Ein dunkelgruenes Gewaechs");
SetProp(P_LONG,
"Du hast nie zuvor so eine Pflanze erblickt.\n");
SetProp(P_NAME, "Gewaechs");
SetProp(P_GENDER, NEUTER);
AddId(({"gewaechs", "pflanze"}));
SetProp(P_WEIGHT, 15);
SetProp(P_VALUE, 50);
SetProp(P_FOOD_INFO, ([F_HEAL : ({40, 40}), F_SOAK : 5]));
}

void BeimEssen()
{
write("Du wuergst das Gewaechs runter.\n");
say(this_player()->name()+" wuergt das Gewaechs runter.\n");
}
