#include <properties.h>
#include <language.h>
inherit "/std/thing";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Marmorkugel");
  SetProp(P_LONG,"Wofuer die wohl gut ist?\n");
  AddId( ({"kugel","marmorkugel"}) );
  SetProp(P_NAME, "Marmorkugel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 10);
  SetProp(P_WEIGHT, 250);

}