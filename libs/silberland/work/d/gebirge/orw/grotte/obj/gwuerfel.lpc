#include <properties.h>
#include <language.h>
inherit "/std/thing";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Granitwuerfel");
  SetProp(P_LONG,"Wofuer der wohl gut ist?\n");
  AddId( ({"wuerfel","granitwuerfel"}) );
  SetProp(P_NAME, "Granitwuerfel");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 10);
  SetProp(P_WEIGHT, 250);

}