
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <material.h>


create() {
   if(!is_clone(this_object())) return;
   ::create();
   SetProp(P_NAME, "Schluessel");
   SetProp(P_GENDER, MALE);
   SetProp(P_SHORT, "Ein verzierter Schluessel");
   SetProp(P_LONG,
     "Ein huebsch verzierter Schluessel. Wofuer der wohl sein wird?\n"
	  );
   AddId( ({ "schluessel","\narknolschluessel" }) );
   SetProp(P_WEIGHT, 10);
   SetProp(P_VALUE, 0);
   SetProp(P_MATERIAL, MAT_CHROMIUM );
   SetProp(P_MAGIC, 1);
}

string QueryDoorKey() {
  return ( "/d/gebirge/orw/grotte/room/grotte10:/d/gebirge/orw/grotte/room/grotte15" );
}
