
inherit "std/thing";

#include <properties.h>
#include <language.h>


create() {
   if(!is_clone(this_object())) return;
   ::create();
   SetProp(P_NAME, "Grottenschluessel");
   SetProp(P_GENDER, MALE);
   SetProp(P_SHORT, "Der Grottenschluessel");
   SetProp(P_LONG,
     "Der Schluessel passt sicher zu einem Tor. Zu welchem sagt ja schon der Name."
	  );
   AddId( ({ "grottenschluessel","schluessel" }) );
   SetProp(P_WEIGHT, 10);
   SetProp(P_VALUE, 0);
   SetProp(P_MATERIAL, MAT_IRON );
   SetProp(P_MAGIC, 1);
}

string QueryDoorKey() {
  return ( "/d/gebirge/orw/grotte/room/grotte1:/d/gebirge/orw/grotte/room/grotte2" );
}
