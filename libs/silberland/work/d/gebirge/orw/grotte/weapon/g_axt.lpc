
inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <weapon.h>
#include <material.h>

#define ALLOWED "/d/gebirge/orw/grotte/"


create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Die Geisteraxt");
  SetProp(P_LONG,
    "Dies ist die Axt Darons, eine magische Axt mit der Du ihm sicher "
    "seinen verdienten Frieden geben kannst.\n"
    );
  SetProp(P_NAME, "Geisteraxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt","geisteraxt"}) );
  SetProp(P_VALUE, 4500);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE, ({DT_MAGIC, DT_SLASH}) );
  SetProp(P_MATERIAL, ([MAT_OCTARINE:10, MAT_OAK:10, MAT_STEEL:30,
			MAT_MISC_MAGIC:50]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_WC, 80);
  SetProp(P_WC_FIX, 30);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_INFO,
    "Mit ihr wirst Du Daron sicher bezwingen koennen."
    );
  SetProp(P_HIT_FUNC, this_object());
}

int HitFunc(object enemy)
{
  if( enemy->id("daron") || lower_case(enemy->QueryProp(P_RACE))=="zwergengeist" )
    return 50+random(200);
  else
    return 0;
}


void reset()
{
  object ob;

  if (objectp(ob=QueryProp(P_WIELDED)) && interactive(ob))  // keine Netztoten!
  {
    ob=all_environment(ob)[<1];         // aeusserstes Environment==Raum
    if (file_name(ob)[0..strlen(ALLOWED)-1] != ALLOWED)
      call_out("remove_me",0);
  }
  ::reset();
}

remove_me()
{
  if (objectp(QueryProp(P_WIELDED)))
    QueryProp(P_WIELDED)->Message(Name(WER,1)+" loest sich ploetzlich auf.\n");
  remove();
}


