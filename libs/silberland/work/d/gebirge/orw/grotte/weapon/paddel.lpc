/*
** Das Paddel des Gnoms
** Orw, 21.06.2000
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
	  return;

  ::create();

  SetProp(P_SHORT, "Ein Paddel");
  SetProp(P_LONG,
		"Der Gnom benuetzt dieses Paddel um das Floss ueber den See zu steuern.\n"+
		"Das Floss und das Paddel sind seine einzigen Besitztuemer.\n");

  SetProp(P_NAME, "Paddel");
  SetProp(P_GENDER, MALE);

  AddId("paddel");
  SetProp(P_VALUE, 300);
  SetProp(P_WEIGHT, 1250);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 20);
  SetProp(P_NR_HANDS, 2);
}
