/* Die Hoehlen des Arknol */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>



create()
{
	::create();


	SetProp( P_INT_SHORT, "Eine geheime Hoehle" );
	SetProp( P_INT_LONG,
		"Du befindest im Norden der grossen Hoehle. Die Waende sind "
		"aus riesigen verzierten Steinplatten. Im Norden ist ein "
		"staehlernes Gitter. Im Sueden steht ein Sockel mit Kerzen darauf. "
		"Die Kerzen tauchen die Waende in ein unheimliches flackerndes "
		"Licht. Steinerne Statuen stehen in den Ecken und scheinen "
		"Dich mit ihren Blicken zu verfolgen.\n"
	);
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( ({"hoehle","raum","raums","boden"}),
		"Diese Hoehle ist sicher nicht auf natuerlichem Weg entstanden. "
		"Du wuerdest gerne wissen wer sie erbaut hat.\n"
	);
	AddDetail( ({ "waende" }),
		"Die Waende bestehen aus grossen Steinplatten, mit schoenen "
		"Verzierungen.\n"
	);
	AddDetail( ({ "steinplatten", "platten" }),
		"Du kannst wunderschoene Verzierungen an den Steinplatten entdecken. "
		"Du bist Dir sicher, dass sie ur alt sein muessen.\n"
	);
	AddDetail( ({ "statuen", "ebenbilder", "statue" }),
		"Die Statuen sehen furchteregend aus, sie scheinen Ebenbilder "
		"alter, schon laengst vergessener Daemonen zu sein.\n"
	);
	AddDetail( "verzierungen",
		"Die Verzierungen wurden in die Steinplatten gemeisselt. Du kannst "
		"hier alte zwergische Symbole und Bilder laengst vergangener "
		"Kaempfe finden.\n"
	);
	AddDetail( ({ "blicke","blicken" }),
		"Die Statuen scheinen Dich mit ihren Blicken zu verfolgen.\n"
	);
	AddDetail( ({"kaempfe","bilder","bild"}),
		"Die meisten der Kaempfe handeln von Zwergen die einen "
		"sicher fuenf mal so grossen Daemon bekaempfen.\n"
	);
	AddDetail( ({"zwerg","zwerge","zwergen"}),
		"Die Zwerge kaempfen gegen einen riesigen Daemon. Ob es "
		"diesen Daemon wirklich gegeben hat oder ob er nur der "
		"Phantasie des Kuenstlers entsprungen ist weisst Du nicht.\n"
	);
	AddDetail( ({"daemon","daemonen"}),
		"Du hoffst, diesen haesslichen Daemon nie persoenlich anzutreffen.\n"
	);
	AddDetail( "phantasie",
		"Hast Du Phantasie?\n"
	);
	AddDetail( ({"kuenstler","kuenstlers"}),
		"Ein wahrhaft begabter Kuenstler.\n"
	);
	AddDetail( "symbole",
		"Du kannst diese alten Symbole leider nicht entziffern.\n"
	);
	AddDetail( ({"kerzenhalter","kerzen","licht","kerzenhaltern","halter"}),
		"Die Kerzen in den Kerzenhaltern erhellen den Raum ein wenig.\n"
	);
	AddDetail( "mitte",
		"In der Mitte des Raums steht ein Sockel.\n"
	);
	AddDetail( "sockel",
		"Auf dem Sockel befinden sich einige Kerzenhalter.\n"
	);
	AddDetail( ({"ecken","ecke"}),
		"In jeder Ecke des Raums steht eine Statue.\n"
	);
	AddDetail( "decke",
		"Die Decke ist zwischen fuenf und sechs Meter hoch.\n"
	);
	AddDetail( ({"meter","masseinheit","einheit"}),
		"Eine Masseinheit!\n"
	);
	AddDetail( "weg",
		"Die Hoehle ist sicher nicht auf natuerlichem Weg entstanden.\n"
	);
	AddDetail( ({"wand","nordwand","tuer","geheimtuer","feldwand"}),
		"Im Norden ist ein Gitter in die Wand eingelassen.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Hinter dem Gitter kannst Du ein entsetzliches Bruellen hoeren."
	);
	AddSound( ({"gitter","bruellen"}),
		"Ein wirklich entsetzliches Bruellen!\n"
	);

	AddItem( "/d/gebirge/orw/grotte/npc/daron", REFRESH_DESTRUCT );

	NewDoor( "norden","./grotte15","gitter",
	 ({  D_NAME,"Gitter",
	D_GENDER, NEUTER,
	D_FLAGS, (DOOR_NEEDKEY|DOOR_RESET_CL|DOOR_CLOSED),
	D_MSGS, ({"nach Norden", "geht durch das Gitter",
				 "kommt durch das Gitter herein" }),
	D_SHORT,"Das Gitter ist %s. ",
	D_LONG,
		 "Ein riesiges staehlernes Gitter ist in der Felswand im Norden. "
		 "Wohin es Dich wohl fuehren koennte? Da Du hier aber keinen "
		 "anderen Ausgang findest, musst Du Wohl oder Uebel da rein. ",

	D_OPENTESTFUNC, "schluesseltest",

	}) );



	AddExit( "westen","/d/gebirge/orw/grotte/room/grotte11" );
	AddExit( "osten", "/d/gebirge/orw/grotte/room/grotte12" );
	AddExit( "sueden","/d/gebirge/orw/grotte/room/grotte7" );

}

mixed schluesseltest()
{
  object key;
  if( key = deep_present("\narknolschluessel", this_player()) ) {
    call_out("key_weg",0, key);
    return 0;
  }
  write("Damit kannst Du das Gitter nicht oeffnen.\n");
  return 1;
}

void key_weg(object key)
{
  write(key->Name(WER,1)+" zerbroeselt zu Staub.\n");
  key->remove();
}

void reset()
{
  ::reset();
  call_other("/d/gebirge/orw/grotte/room/grotte13", "my_reset" );
  call_other("/d/gebirge/orw/grotte/room/grotte14", "my_reset" );
}
