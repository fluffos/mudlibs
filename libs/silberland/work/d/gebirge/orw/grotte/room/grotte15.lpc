/* Grotte des Arknol */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>



create()
{
	::create();


	SetProp( P_INT_SHORT, "Die Hoehle des Arknol" );
	SetProp( P_INT_LONG,
		"Du befindest Dich in einer Hoehle welche zwar nicht breit, "
		"aber ziemlich hoch ist. Der Boden ist aus Marmor und die Waende "
		"sind aus spitzem Felsgestein. Von der Decke haengen Flechten "
		"die aus puren Edelsteinen bestehen zu scheinen.\n"
	);
	SetProp( P_LIGHT, 0 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( "hoehle",
		"Diese Hoehle ist sehr hoch, mindestens 10 Meter.\n"
	);
	AddDetail( ({ "boden", "marmor" }),
		"Der Boden besteht vollkommen aus Marmor.\n"
	);
	AddDetail( ({ "waende" }),
		"Die Waende bestehen aus spitzem Felsgestein. Die Nordwand faellt Dir "
		"besonders auf.\n"
	);
	AddDetail( ({ "nordwand", "wand" }),
		"An der Nordwand ist ein grosses Ornament in das Gestein gemeiselt "
		"worden.\n"
	);
	AddDetail( "ornament",
		"Das Ornament sieht ein bischen aus wie ein riesiges Auge.\n"
	);
	AddDetail( ({ "auge" }),
		"Ein Auge mit einer grossen Pupille.\n"
	);
	AddDetail( "pupille",
		"Die Pupille scheint beweglich zu sein, vielleicht kann man sie "
		"sie druecken.\n"
	);
	AddDetail( ({"felsgestein","gestein","steine","stein","felswand"}),
		"Schroffes Felsgestein, sicher sehr hart.\n"
	);
	AddDetail( ({"decke"}),
		"Von der Decke haengen Flechten, welche aus Edelstein zu sein scheinen.\n"
	);
	AddDetail( "flechten",
		"Leider sind sie viel zu weit oben, als das Du sie erreichen koenntest.\n"
	);
	AddDetail( ({"edelstein","edelsteinen"}),
		"Die Flechten an der Decke scheinen daraus zu bestehen.\n"
	);
	AddDetail( ({"meter","masseinheit","einheit"}),
		"Meter ist eine Masseinheit.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Im Moment herrscht Totenstille."
	);
	AddSound( "moment",
		"Zzzzt.\n"
	);
	AddSound( "totenstille",
		"Zzzzt.\n"
	);

	AddItem("/d/gebirge/orw/grotte/npc/arknol", REFRESH_DESTRUCT);




	AddCmd( ({"druecke","drueck"}), "fktdruecke");

	NewDoor( "sueden","./grotte10","gitter",
    ({  D_NAME,"Gitter",
	D_GENDER, NEUTER,
	D_FLAGS, (DOOR_NEEDKEY|DOOR_RESET_CL|DOOR_CLOSED),
	D_MSGS, ({"nach Sueden", "geht durch das Gitter",
				 "kommt durch das Gitter herein" }),
	D_SHORT,"Das Gitter ist %s. ",
	D_LONG,
		 "Ein grosses schweres Gitter ist in der Felswand im Sueden. "
		 "Es fuehrt Dich wieder in die grosse Hoehle zurueck. "
    }) );


}

fktdruecke(str)
{
  object axt;
  notify_fail("Was willst Du druecken?\n");
  if(str=="pupille" || str=="auf pupille")
    {
    write(BS("Ploetzlich beginnt die Luft um Dich herum zu flimmern und Du findest Dich in einem anderen Raum wieder.\n"));
    TP->move("/d/gebirge/orw/grotte/room/grotte3", M_GO, "","verschwindet in einem Luftwirbel","kommt ploetzlich aus dem Nichts"
	    +" heraus");

    if(axt=present("geisteraxt", this_player()) )
      {
      write(BS("Mit einem lauten Donnerknall loest sich Darons Geisteraxt in Rauch auf.\n"));
      axt->remove();
      return 1;
      }
    else
      return 1;
    }
  else
    return 0;
}