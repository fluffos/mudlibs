/* Die Hoehle der Gebirgsbestie */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>



create()
{
	::create();


	SetProp( P_INT_SHORT, "Die Hoehle der Gebirgsbestie" );
	SetProp( P_INT_LONG,
		"Dir gefriert das Blut in den Adern als Du den Haufen Knochen und\n"
	+	"Leichenteile siehst. Jemand muss hier arg gewuetet haben. Es stinkt\n"
	+	"bestialisch nach verfaultem Fleisch.\n"
	);
	SetProp( P_LIGHT, 0 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 4, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( "blut",
		"Am Boden und an den Waenden klebt ueberall Blut. Sogar bis an die Decke\n"
		"es ist gespritzt. Du zitterst vor Angst. An einer Wand faellt Dir etwas\n"
		"auf.\n"
	);
	AddDetail( ({ "boden", "waende", "decke" }),
		"Alles voller Blut!\n"
	);
	AddDetail( ({ "adern", "ader" }),
		"Das Blut gefriert Dir in den Adern.\n"
	);
	AddDetail( ({ "haufen" }),
		"Du siehst einen Haufen Knochen.\n"
	);
	AddDetail( "knochen",
		"Du siehst Knochen aller Rassen.\n"
	);
	AddDetail( ({ "jemand", "monster", "bestie" }),
		"Du bist froh, das Monster gerade nicht anzutreffen.\n"
	);
	AddDetail( "rassen",
		"Du siehst besonders viele Zwergenknochen.\n"
	);
	AddDetail( ({"koepfe","beine","arme"}),
		"Das Monster muss hier schon lange unschuldige Abenteurer verspeisen.\n"
	+	"Hoffentlich endest Du nicht genauso.\n"
	);
	AddDetail( "zwergenknochen",
		"Besonders viele Zwergenknochen liegen herum.\n"
	);
	AddDetail( ({"leichen","leichenteile"}),
		"Abgebissene Koepfe, Beine, Arme.\n"
	);
	AddDetail( ({"fleisch","hautfetzen","fetzen","haut"}),
		"Fleisch und Hautfetzen kleben an den Waenden.\n"
	);
	AddDetail( ({"abenteurer","naechste","naechster"}),
		"Du koenntest der Naechste sein!\n"
	);
	AddDetail( ({"wand","nordwand"}),
		"An der Nordwand ist ein Riss und an der Suedwand kannst Du "
		"einen kleinen Punkt erkennen.\n"
	);
	AddDetail( "punkt",
		"Ein kleiner Knopf, er ist blutverschmiert und fast nicht erkennbar.\n"
	);
	AddDetail( "knopf",
		"Du koenntest ihn druecken, wenn Du Dich traust.\n"
	);
	AddDetail( "riss",
		"Du koenntest Dich durchzwaengen.\n"
	);
	AddDetail( "angst",
		"Vor lauter Angst pinkelst Du Dich beinahe an.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Du hoerst das Klappern Deiner Zaehne."
	);
	AddSound( "klappern",
		"Deine Zaehne klappern.\n"
	);
	AddSound( "zaehne",
		"Sie klappern laut.\n"
	);

	AddSmell( DEFAULT_SMELL,
		"Es riecht stark nach Verwesung, Du musst Dich fast uebergeben."
	);
	AddSmell( ({"verwesung","gestank","fleisch"}),
		"Ein uebler Gestank, Dir wird schlecht.\n"
	);


	AddItem("/d/gebirge/orw/grotte/npc/gebirgsb", REFRESH_DESTRUCT );


	AddCmd( ({"zwaenge","zwaeng"}),  "fktzwaenge");
	AddCmd( ({"drueck", "druecke"}), "fktdruecke");



}

fktzwaenge(str)
{
  notify_fail("Wodurch willst Du Dich zwaengen?\n");
  if(str=="durch riss" || str=="durch spalt")
    {
    write(BS("Du zwaengst Dich durch den Riss in der Wand.\n"));
    TP->move("/d/gebirge/orw/grotte/room/grotte5", M_GO, "","zwaengt sich durch den Riss","kommt durch den Riss "
	    +"in der Wand herein");
    return 1;
    }
  else
    return 0;
}

int fktdruecke(string str)
{
  notify_fail("Was willst Du druecken?\n");
  if(str != "knopf" ) return 0;
  call_other("/d/gebirge/orw/grotte/room/grotte4", "open_secret_door" );
  write("Du drueckst auf den Knopf und spuerst ein leichtes Rumpeln.\n");
  say(CAP_TPN+" fummelt an der Suedwand herum und Du spuerst ein leichtes "
      "Rumpeln.\n");
  return 1;
}
