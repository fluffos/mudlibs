/* Anlegesteg von Felonia */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
	::create();

	SetProp( P_INT_SHORT, "Der unterirdische See" );
	SetProp( P_INT_LONG,
		"Du stehst an einem unterirdischen See. Das Wasser des Sees taucht\n"
	+	"die Umgebung in ein schoenes Blau, das sich an den Felswaenden spiegelt.\n"
	+	"Ein kleiner Steg geht gut zwei Meter auf den See hinaus. Eine Treppe\n"
	+	"fuehrt wieder in die Stadt hinauf. Beim Steg ist eine grosse Laterne\n"
	+	"angebracht, welche Dir genuegend Licht spendet. \n"
	+	"Ein Schild steht neben dem Steg.\n"
	);
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( "see",
		"Der See scheint ziemlich gross zu sein. Obwohl die Laterne sehr\n"
	+	"hell leuchtet, kannst du das andere Ufer nicht erkennen.\n"
	);
	AddDetail( ({ "laterne", "licht" }),
		"Die Laterne strahlt ein helles Licht aus.\n"
	);
	AddDetail( "treppe",
		"Die Treppe fuehrt Dich wieder nach Felonia hinauf.\n"
	);
	AddDetail( ({ "felonia", "heimat", "stadt" }),
		"Die Heimat der Zwerge. Eine wirklich praechtige Stadt.\n"
	);
	AddDetail( ({ "zwerge", "zwerg" }),
		"Wenn Du nicht mal Zwerge kennst, was machst Du dann in Felonia?\n"
	);
	AddDetail( ({ "wasser", "blau", "wellen" }),
		"Das Wasser strahlt in einem sehr schoenen Blau. Lustig spiegeln\n"
	+	"sich die Wellen an den Felswaenden.\n"
	);
	AddDetail( ({ "umgebung", "boden", "decke", "wand", "waende", "felswaende", 
	              "felswaenden","felswand" }),
		"Alles hier unten besteht aus hartem Feloniafels.\n"
	);
	AddDetail( ({ "feloniafels", "fels", "stein", "gestein" }),
		"Besonders hartes Gestein.\n"
	);
	AddDetail( ({ "steg", "anlegesteg", "holzsteg" }),
		"Ein kleiner Holzsteg, ein Schild steht daneben.\n"
	);
	AddDetail( ({ "schild", "tafel" }),
		"Du koenntest das Schild lesen....\n"
	);
	AddDetail( "meter",
		"Sogar Trolle muessten wissen wie lang ein Meter ist!\n"
	);
	AddDetail( ({ "troll", "trolle" }),
		"Bist Du etwa einer?\n"
	);
	AddDetail( "ufer",
		"Du kannst das andere Ufer von hier aus nicht sehen.\n"
	);
	AddDetail( "holz",
	        "Das einzige Holz hier unten ist das des Holzsteges."
	);
	AddReadDetail( ({ "schild", "tafel" }),
		"           -----------------------------------------------\n"
	+	"           |o                                           o|\n"
	+	"           |         Felonia <- Floss -> Grotte          |\n"
	+	"           |            Ueberfahrt ist GRATIS            |\n"
	+       "           |     Nur fuer die verwegensten Abenteurer    |\n"
	+	"           |               empfehlenswert!               |\n"
	+       "           |o                                           o|\n"
	+	"           -----------------------------------------------\n"
	);
	AddSound( DEFAULT_SOUND,
		"Manchmal kann man Wasser von der Decke in den See tropfen hoeren."
	);
	AddRoomMessage(
		({"Wasser tropft von der Decke in den See.\n"}),120);


	AddExit( "oben", "/d/gebirge/dusty/zwerge/room/schacht3" );
	AddItem( "/d/gebirge/orw/grotte/transp/floss", REFRESH_DESTRUCT, 1);
}