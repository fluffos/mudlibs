
/* Der Grotteneingang */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>

int counter;

create()
{
	object ob;
	::create();

	SetProp( P_INT_SHORT, "Der Grotteneingang" );
	SetProp( P_INT_LONG,
		"Du befindest Dich beim Eingang zur Grotte. Weit suedwestlich von Dir kannst\n"
	+	"Du noch das Licht der grossen Laterne sehen. Der Raum ist spaerlich\n"
	+	"beleuchtet, nur eine Kerze erhellt ihn ein wenig. An der Ostwand steht\n"
	+	"ein Tisch und daneben eine kleine Kiste.\n"
	);
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( "see",
		"Der See hat wirklich riesige Ausmasse. Du kannst die Laterne am anderen\n"
	+	"Ufer nur noch als kleinen Punkt erkennen.\n"
	);
	AddDetail( ({ "eingang", "grotteneingang" }),
		"Der Eingang zur Grotte ist durch ein grosses, schwarzes Tor geschuetzt.\n"
	);
	AddDetail( "raum",
		"Ein nur mit einer Kerze beleuchteter Raum.\n"
	);
	AddDetail( "ausmasse",
		"Sehr, sehr gross!\n"
	);
	AddDetail( ({ "laterne", "licht" }),
		"Die Laterne am anderen Ufer kann man nur noch als kleinen Punkt erkennen.\n"
	);
	AddDetail( "punkt",
		"Ein kleiner Punkt laesst erkennen, wo sich der Steg von Felonia befindet.\n"
	);
	AddDetail( ({ "steg", "felonia" }),
		"Mit dem Floss kannst Du wieder zurueck nach Felonia.\n"
	);
	AddDetail( "kerze",
		"Die Kerze erhellt den Raum ein wenig.\n"
	);
	AddDetail( "tisch",
		"Auf dem Tisch befindet sich eine Kerze.\n"
	+	"Ausserdem hat er eine Schublade.\n"
	);
	AddDetail( ({ "schublade", "lade" }),
		"Ob Du mal in ihr wuehlen koenntest?\n"
	);
	AddDetail( ({ "umgebung", "boden", "decke", "waende", "felswaende", "felswaenden" }),
		"Alles hier unten besteht aus hartem Feloniafels.\n"
	);
	AddDetail( ({ "feloniafels", "fels", "stein", "gestein" }),
		"Besonders hartes Gestein.\n"
	);
	AddDetail( ({ "kiste", "holzkiste" }),
		"Sie ist mit einem warmen Fell ueberzogen und dient wohl als Sitzgelegenheit.\n"
	);
	AddDetail( ({ "ostwand", "wand", "felswand" }),
		"An der Ostwand stehen ein Tisch und eine Kiste.\n"
	);
	AddDetail( "ufer",
		"Vom anderen Ufer leuchtet noch schwach das Licht der Laterne herueber.\n"
	);
	AddDetail( "fell",
		"Ueber die Kiste ist ein Fell gespannt, es scheint von einem Wolf zu stammen.\n"
	+	"Das Fell waermt sicher toll, Du koenntest Dich mal hinsetzen.\n"
	);
	AddDetail( "sitzgelegenheit",
		"Setz Dich doch und raste Dich aus.\n"
	);
	AddDetail( "schluessel",
		"Du kannst keinen Schluessel finden.\n"
	);
	AddDetail( "grotte",
		"Gern wuerdest Du die Grotte erforschen.\n"
	);
	AddDetail( ({ "ohr", "ohren", "dinger" }),
		"Ohren sind so seltsame Dinger, die an deinem Kopf angewachsen sind.\n"
	);
	AddDetail( "kopf",
		"Du untersuchst aber auch wirklich alles.......\n"
	);
	AddDetail( ({ "wolf", "woelfe" }),
		"Woelfe gibt es viele im Silberland, aber hier wirst Du keinen finden.\n"
	);
	AddDetail( ({ "silberland", "land" }),
		"Alles um Dich herum gehoert zum Silberland.\n"
	);
	AddDetail( "norden",
		"Im Norden befindet sich ein Tor zur Grotte.\n"
	);
	AddDetail( "floss",
		"Das Floss ist gerade nicht da.\n"
	);
	AddDetail( ({ "felsspalte", "spalte"}),
		"Glorin zieht sich in sie zurueck um zu schlafen.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Leise Geraeusche dringen an Dein Ohr. Sie werden sicher aus der Grotte stammen.\n"
	);
	AddSound( ({ "geraeusche", "geraeusch" }),
		"Die Geraeusche klingen furchteregend.\n"
	);
	AddRoomMessage(
		({"Du hoerst seltsame Geraeusche hinter dem Tor.\n"}),220);

	AddItem( "/d/gebirge/orw/grotte/transp/floss", REFRESH_DESTRUCT, 1);
	AddItem( "/d/gebirge/orw/grotte/npc/glorin", REFRESH_DESTRUCT );

	NewDoor( "norden","./grotte2","tor",
	 ({  D_NAME,"Tor",
	D_GENDER, NEUTER,
	D_FLAGS, (DOOR_NEEDKEY|DOOR_RESET_CL|DOOR_CLOSED),
	D_MSGS, ({"nach Norden", "geht durch das Tor",
				 "kommt durch das Tor herein" }),
	D_SHORT,"Das Tor zur Grotte ist %s. ",
	D_LONG,
		 "Ein stabiles, schwarzes Tor ist in der Felswand im Norden. "
		 "Es wird wohl zu der unterirdischen Grotte fuehren, gern wuerdest "
		 "Du sie erforschen. Nur der passende Schluessel fehlt. "
	 }) );

	AddCmd(({"setze","setz","sitze","sitz"}), "fktsetze");
	AddCmd(({"loese","loes"}), "fktloese");
	AddCmd(({"wuehle","wuehl"}),"fktwuehle");
	counter=1;

}

int fktsetze(string str)
{
  object kiste;
  notify_fail("Worauf moechtest Du Dich setzen?\n");
  if (str!="auf kiste") return 0;
  write(
       "Du setzt Dich gemuetlich auf die Kiste, das Fell waermt Dich. "
       "Zufrieden stehst Du wieder auf.\n");
  say(
  TP->Name()+
       " setzt sich fuer einen Moment auf die Kiste um sich auszurasten.\n",TP);
  return 1;
}


int fktwuehle(string str)
{
  object schluesselobj;
  notify_fail("Worin willst Du wuehlen?\n");
  if (!counter) return write(BS(
  "Du durchwuehlst die Lade, leider befindet sich nichts in ihr.\n")),1;
  if (str=="in lade" || str=="in schublade")
  {
       schluesselobj = clone_object("/d/gebirge/orw/grotte/obj/grottens");
       schluesselobj->move(this_player(),M_GET|M_SILENT);
       write(
       BS("Du oeffnest die Lade und wuehlst darin herum. "
       "Nach einiger Zeit findest Du einen Schluessel den Du sofort "
       "einsteckst.\n"));
       say(
       BS(TP->Name()+
       " wuehlt in der Lade herum.\n"),this_player());
       counter--;

  return 1;
  }
}

reset()
{
      ::reset();
      counter=1;
}

  int fktloese(string str)
{
  object glorin;
  notify_fail("Wen willst Du abloesen?\n");
  if(str!="glorin ab") return 0;
	if(this_player()->QueryProp(P_RACE) == "Zwerg" ){
		if(!glorin=present("glorinistderwaechter",this_object())) return write("Glorin ist doch gar nicht da!\n"),1;
		map_array(all_inventory(glorin), #'destruct);
		glorin->remove();
		write(BS(
		"Glorin dankt Dir und verschwindet in einer Felsspalte.\n"));
		say(BS(TP->Name()+
		" loest Glorin ab, er verschwindet in einer Felsspalte.\n"));
	return 1;
  }
  else {
	if(!glorin=present("glorinistderwaechter",this_object())) return write("Glorin ist doch gar nicht da!\n"),1;
	return write("Glorin sagt: Du bist ja nichtmal ein Zwerg!\n"),1;
  }
}
