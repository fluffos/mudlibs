/* Tiefer in der Grotte */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>



create()
{
	::create();


	SetProp( P_INT_SHORT, "Tiefer in der Grotte" );
	SetProp( P_INT_LONG,
		"Um Dich herum sind schroffe Felswaende. Es ist sehr feucht, Du\n"
	+	"stehst bis zu den Knoecheln im Wasser. An der Decke befindet sich\n"
	+	"das Loch durch das Du gekommen bist. Von Sueden kommt Dir ein komischer\n"
	+	"Geruch entgegen.\n"
	);
	SetProp( P_LIGHT, 0 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 6, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( "boden",
		"Auf dem Boden steht knoecheltief das Wasser.\n"
	);
	AddDetail( ({ "waende", "felswaende" }),
		"Schroffe Felswaende, doch eine sieht anders aus.\n"
	);
	AddDetail( ({ "knoecheln", "knoechel" }),
		"Keine Sorge, es sieht nicht aus als ob es steigen wuerde.\n"
	);
	AddDetail( ({ "westen", "osten", "norden","sueden" }),
		"Du bist von Felswanden eingeschlossen.\n"
	);
	AddDetail( "wasser",
		"Du stehst bis zu den Knoecheln im Wasser.\n"
	);
	AddDetail( ({ "sorge", "sorgen" }),
		"Dir macht eher der komische Geruch Sorgen.\n"
	);
	AddDetail( ({"wand","suedwand"}),
		"In der Suedwand befindet sich ein grosser Riss.\n"
	);
	AddDetail( "riss",
		"Du koenntest versuchen dich durchzuzwaengen.\n"
	);
	AddDetail( "loch",
		"Das Loch durch das Du heruntergeklettert bist.\n"
	);
	AddDetail( "decke",
		"An der Decke befindet sich ein Loch.\n"
	);

	AddSmell( DEFAULT_SMELL,
		"Ein verfaulter Geruch laesst Dich erschaudern."
	);
	AddSmell( "geruch",
		"Er kommt von der Suedwand, ein ziemlich unfreundlicher Geruch.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Du kannst ein leises Kratzen hoeren."
	);
	AddSound( "kratzen",
		"Hinter der Suedwand muss sich etwas verbergen.\n"
	);
	AddSound( ({ "suedwand", "wand" }),
		"Von dort kommt das Kratzen.\n"
	);


	AddItem("/d/gebirge/orw/grotte/npc/fleder", REFRESH_DESTRUCT);


	AddCmd( ({"klettere","kletter"}), "fktklettere");
	AddCmd( ({"zwaenge","zwaeng"}), "fktzwaenge");


}


fktklettere(str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str=="rauf" || str=="hoch")
    {
    write(BS("Du kletterst durch das Loch nach oben.\n"));
    TP->move("/d/gebirge/orw/grotte/room/grotte4", M_GO, "","klettert durch das Loch nach oben","kommt durch das Loch "
	    +"heraufgeklettert");
    return 1;
    }
  else
    return 0;
}

fktzwaenge(str)
{
  notify_fail("Wodurch willst Du Dich zwaengen?\n");
  if(str=="durch riss" || str=="durch spalt"){
    if(TP->QueryProp(P_LEVEL)>20){
      write(BS("Du zwaengst Dich durch den Riss in der Wand.\n"));
      TP->move("/d/gebirge/orw/grotte/room/grotte6", M_GO, "",
        "zwaengt sich durch den Riss",
        "kommt durch den Riss in der Wand herein");
      return 1;
    }
    else{
      write(BS("Du traust Dich nicht durch den Riss in der Wand.\n"));
      say(BS(TPN+" scheint sich nicht durch den Riss zu trauen.\n"));
      return 1;
    }      
  }
  else
    return 0;
}
