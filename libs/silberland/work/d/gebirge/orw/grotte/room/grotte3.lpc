/* Der Mittelteil des Gangs */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>

int olmcounter;

create()
{
	::create();

        olmcounter=1;

	SetProp( P_INT_SHORT, "Eine Grotte" );
	SetProp( P_INT_LONG,
		"Der Gang in dem du Dich befindest strahlt in einem leichten Violett\n"
	+	"das vom Edelsteingehalt des Gesteins ausgeht. Das Gestein ist feucht\n"
	+	"und am Boden haben sich Pfuetzen gebildet.\n"
	);
	SetProp( P_LIGHT, 0 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 6, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( "gang",
		"Der Gang geht von Westen nach Osten weiter.\n"
	);
	AddDetail( ({ "violett", "edelsteingehalt", "gehalt" }),
		"Die Waende leuchten schoen Violett durch deine Lichtquelle.\n"
	);
	AddDetail( ({ "lichtquelle", "quelle" }),
		"Du musst schon selbst wissen welche Lichtquelle Du benuetzt.\n"
	);
	AddDetail( ({ "pfuetzen", "wasser", "pfuetze" }),
		"Am Boden haben sich einige Pfuetzen gebildet.\n"
	);
	AddDetail( "moos",
		"Huebsches, weiches, dunkelgruenes Moos.\n"
	);
	AddDetail( ({ "umgebung", "boden", "decke", "felswaende", "felswaenden" }),
		"Alles hier leuchtet in diesem schoenen Violett.\n"
	);
	AddDetail( "stellen",
		"An vielen Stellen waechst Moos an den Waenden.\n"
	);
	AddDetail( ({"gestein","gesteins","edelsteinvorkommen","vorkommen"}),
		"Ein sehr schoenes Gestein, welches in einem leichten Violett glitzert.\n"
	+	"Bestimmt gibt es hier grosse Edelsteinvorkommen.\n"
	);
	AddDetail( ({"grotte"}),
		"Du stehst hier am Anfang der Grotte. Sie kommt Dir trotz ihrer \n"
	+	"Schoenheit ziemlich unheimlich vor.\n"
	);
	AddDetail( "schoenheit",
		"So etwas schoenes hast Du noch nie gesehen!\n"
	);
	AddDetail( ({"osten","westen"}),
		"Im Osten und im Westen fuehrt der Gang weiter.\n"
	);
	AddDetail( ({"felswand","nordwand","noerdliche felswand"}),
		"Die noerdliche Felswand ist mit Ritzen und Furchen durchzogen.\n"
	);
	AddDetail( ({"wand","waende"}),
		"Die Felswand im Norden sieht irgendwie anders aus.\n"
	);
	AddDetail( ({"ritzen","furchen","spalten"}),
		"Die Ritzen und Furchen durchziehen die ganze noerdliche Felswand.\n"
	+	"Eine etwas groessere Spalte faellt Dir auf.\n"
	);
	AddDetail( "spalte",
		"Wenn Du Dich traust koenntest Du reinfassen.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Du hoerst ein Zischeln."
	);
	AddSound( "richtung",
		"Irgendwo bei der Felswand zischelt etwas.\n"
	);
	AddSound( "zischeln",
		"Das Zischeln kommt aus noerdlicher Richtung.\n"
	);

	AddExit( "westen","/d/gebirge/orw/grotte/room/grotte2" );
	AddExit( "osten","/d/gebirge/orw/grotte/room/grotte4" );


	AddCmd( ({"fasse","fass"}), "fktfasse");



}


reset() {
  ::reset();
  if(!present("grottenolm",ME)) olmcounter=1;
}

int fktfasse(string str) {
  object ob;
  notify_fail("Wo willst Du reinfassen?\n");
  if(str != "in spalte")
    return 0;
  if(olmcounter != 1) {
    write(BS(
      "Du greifst in die Spalte aber findest nichts darin."));
    say(BS(
      CAP_TPN+" greift in eine Spalte und zieht die Hand anschliessend wieder "
      "enttaeuscht heraus."));
    return 1;
  }
  olmcounter=0;
  write(BS(
    "Du fasst in die Spalte, ploetzlich schiesst ein Grottenolm heraus und "
    "beisst Dich in den Finger!"));
  say(BS(
    CAP_TPN+" greift in die Spalte und zieht erschrocken die Hand wieder raus."));
  ob=clone_object( "/d/gebirge/orw/grotte/npc/grotteno" );
  if(ob) {
    ob->move(ME,M_GO);
    ob->Kill(TP);
  }
  return 1;
}
