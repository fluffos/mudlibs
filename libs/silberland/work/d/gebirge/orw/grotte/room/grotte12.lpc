/* Die Hoehlen des Arknol */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>


create()
{
	::create();


	SetProp( P_INT_SHORT, "Eine geheime Hoehle" );
	SetProp( P_INT_LONG,
		"Du befindest Dich im Nordosten der grossen Hoehle. Auf den Steinplatten "
		"befinden sich schoene Verzierungen. Im Nordosten ist ein kleiner hell "
		"erleuchteter Raum. In den Kerzenhaltern an der Wand stehen Kerzen welche, "
		"ein unheimliches flackerndes Licht ausstrahlen, das auch "
		"diesen Raum noch miterhellt. Steinerne Statuen stehen in den Ecken "
		"und scheinen Dich mit ihren Blicken zu verfolgen.\n"
	);
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( ({"hoehle","raum","raums","boden"}),
		"Diese Hoehle ist sicher nicht auf natuerlichem Weg entstanden. "
		"Du wuerdest gerne wissen wer sie erbaut hat.\n"
	);
	AddDetail( ({ "waende","wand" }),
		"Die Waende bestehen aus grossen Steinplatten, mit schoenen "
		"Verzierungen. Einige Kerzenhalter stehen an der Wand.\n"
	);
	AddDetail( ({ "steinplatten", "platten" }),
		"Du kannst wunderschoene Verzierungen an den Steinplatten entdecken. "
		"Du bist Dir sicher, dass sie ur alt sein muessen.\n"
	);
	AddDetail( ({ "statuen", "ebenbilder", "statue" }),
		"Die Statuen sehen furchteregend aus, sie scheinen Ebenbilder "
		"alter, schon laengst vergessener Daemonen zu sein.\n"
	);
	AddDetail( "verzierungen",
		"Die Verzierungen wurden in die Steinplatten gemeisselt. Du kannst "
		"hier alte zwergische Symbole und Bilder laengst vergangener "
		"Kaempfe finden.\n"
	);
	AddDetail( ({ "blicke","blicken" }),
		"Die Statuen scheinen Dich mit ihren Blicken zu verfolgen.\n"
	);
	AddDetail( ({"kaempfe","bilder","bild"}),
		"Die meisten der Kaempfe handeln von Zwergen die einen "
		"sicher fuenf mal so grossen Daemon bekaempfen.\n"
	);
	AddDetail( ({"zwerg","zwerge","zwergen"}),
		"Die Zwerge kaempfen gegen einen riesigen Daemon. Ob es "
		"diesen Daemon wirklich gegeben hat oder ob er nur der "
		"Phantasie des Kuenstlers entsprungen ist weisst Du nicht.\n"
	);
	AddDetail( ({"daemon","daemonen"}),
		"Du hoffst, diesen haesslichen Daemon nie persoenlich anzutreffen.\n"
	);
	AddDetail( "phantasie",
		"Hast Du Phantasie?\n"
	);
	AddDetail( ({"kuenstler","kuenstlers"}),
		"Ein wahrhaft begabter Kuenstler.\n"
	);
	AddDetail( "symbole",
		"Du kannst diese alten Symbole leider nicht entziffern.\n"
	);
	AddDetail( ({"kerzenhalter","kerzen","licht","kerzenhaltern"}),
		"Die Kerzen in den Kerzenhaltern erhellen den Raum ein wenig.\n"
	);
	AddDetail( ({"ecken","ecke"}),
		"In jeder Ecke des Raums steht eine Statue.\n"
	);
	AddDetail( "decke",
		"Die Decke ist zwischen fuenf und sechs Meter hoch.\n"
	);
	AddDetail( ({"meter","masseinheit","einheit"}),
		"Eine Masseinheit!\n"
	);
	AddDetail( "weg",
		"Die Hoehle ist sicher nicht auf natuerlichem Weg entstanden.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Hier ist es besonders ruhig."
	);

	AddItem("/d/gebirge/orw/grotte/npc/fleder", REFRESH_DESTRUCT);


	AddExit( "westen", "/d/gebirge/orw/grotte/room/grotte10" );
	AddExit( "sueden", "/d/gebirge/orw/grotte/room/grotte9" );
	AddExit( "nordosten", "/d/gebirge/orw/grotte/room/grotte14" );

}

