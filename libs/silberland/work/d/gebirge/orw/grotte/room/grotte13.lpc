/* Eine Felsnische in der Hoehle */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>

int counter;

create()
{
	::create();


	SetProp( P_INT_SHORT, "Tief unter dem Gebirge" );
	SetProp( P_INT_LONG,
		"Du stehst hier im nordwestlichsten Raum der Hoehle. An den Waenden sind "
		"Fackeln angebracht die den Raum hell erleuchten. In der Mitte steht ein "
		"kleiner Steinblock aus Granit.\n"
	);
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( "hoehle",
		"Wieso nur bist Du in diese Hoehle, Du koenntest Dich dafuer ohrfeigen.\n"
	);
	AddDetail( ({ "waenden", "wand", "waende" }),
		"An den Waenden sind Fackeln angebracht, welche den Raum hell erleuchten.\n"
	);
	AddDetail( ({ "fackeln", "fackel" }),
		"Sie strahlen ein helles Licht aus.\n"
	);
	AddDetail( "licht",
		"Die Fackeln erhellen den Raum und tauchen ihn in ein schoenes Licht.\n"
	);
	AddDetail( "boden",
		"Der Boden ist sehr staubig.\n"
	);
	AddDetail( "staub",
		"Der Boden ist mit einer dicken Staubschicht bedeckt.\n"
	);
	AddDetail( ({"staubschicht","schicht"}),
		"Hier war schon lange niemand mehr.\n"
	);
	AddDetail( "decke",
		"Die Decke ist hier ziemlich niedrig, wurde wohl von Zwergen gemacht.\n"
	);
	AddDetail( ({"zwergen","zwerge","zwerge"}),
		"Du bist Dir ziemlich sicher, dass der Raum von Zwergen gemacht wurde.\n"
	);
	AddDetail( "raum",
		"Ein kleiner Raum, er ist hell erleuchtet.\n"
	);
	AddDetail( ({"steinblock","block"}),
		"Er ist aus Granit und strahlt etwas magisches aus. Seine Oberseite sieht "
		"interessant aus.\n"
	);
	AddDetail( "granit",
		"Kalt und blass.\n"
	);
	AddDetail( "seite",
		"Die Oberseite des Steinblocks sieht interessant aus.\n"
	);
	AddDetail( "oberseite",
		"In der Oberseite befindet sich eine kleine quadratische Einbuchtung.\n"
	);
	AddDetail( "einbuchtung",
		"Ob man da etwas reinstecken kann?\n"
	);
	AddDetail( "mitte",
		"In der Mitte des Raums steht ein Steinblock.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Totenstille."
	);

	AddExit( "suedosten","/d/gebirge/orw/grotte/room/grotte11" );


	AddCmd( ({"stecke","steck"}), "fktstecke");
	counter=1;

}

int fktstecke(string str)
{ object key;
  notify_fail("Was willst Du wo reinstecken?\n");
  if( !str ) return 0;
  if( !key=present("granitwuerfel", this_player()) )
  {
    write("Irgendwie passt keines deiner Sachen in die Einbuchtung.\n");
    return 1;
  }
  if( str=="wuerfel in einbuchtung" || str=="granitwuerfel in einbuchtung" )
  {
    if( counter )
    {
      write("Du steckst den Wuerfel in die Einbuchtung und ploetzlich erscheint eine Marmorkugel in deinen Haenden.\n");
      say( CAP_TPN+" macht sich am Steinblock zu schaffen.\n", ({this_player()}) );
      CLONE( "/d/gebirge/orw/grotte/obj/mkugel", this_player());
      key->remove();
      counter--;
    }
    else
    {
      write("Du steckst den Wuerfel in die Einbuchtung, nichts passiert und Du steckst ihn wieder ein. Vielleicht solltest Du es spaeter nochmal versuchen.\n");
      say( CAP_TPN+" macht sich am Steinblock zu schaffen.\n", ({this_player()}) );
    }
    return 1;
  }
  return 0;
}

void my_reset()
{
  counter=1;
}
