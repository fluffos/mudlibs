/* Der Anfang des Gangs */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>

int counter;
int moos_weg=0;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Grotte" );
  SetProp( P_INT_LONG,
    "Der Gang in dem du Dich befindest strahlt in einem leichten Violett\n"
    "das vom Edelsteingehalt des Gesteins ausgeht. Das Gestein ist feucht\n"
    "und am Boden haben sich Pfuetzen gebildet. An manchen Stellen schimmert\n"
    "die Wand gruenlich.\n");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );


  AddDetail( "gang",
    "Der Gang geht nach Osten und nach Nordwesten weiter.");
  AddDetail( ({ "violett", "edelsteingehalt", "gehalt" }),
    "Die Waende leuchten schoen Violett durch deine Lichtquelle.");
  AddDetail( ({ "lichtquelle", "quelle" }),
    "Du musst schon selbst wissen, welche Lichtquelle Du benuetzt.");
  AddDetail( ({ "pfuetzen", "wasser", "pfuetze" }),
    "Am Boden haben sich einige Pfuetzen gebildet.");
  AddDetail( "moos",
    "Huebsches, weiches, dunkelgruenes Moos.");
  AddDetail( ({ "umgebung", "boden", "decke", "wand", "waende", "felswaende",
                "felswaenden" }),
    "Alles hier leuchtet in diesem schoenen Violett.");
  AddDetail( "stellen",
    "An vielen Stellen waechst Moos an den Waenden. Eine Stelle faellt Dir "
    "ganz besonders auf.");
  AddDetail( ({"gestein","gesteins","edelsteinvorkommen","vorkommen"}),
    "Ein sehr schoenes Gestein, welches in einem leichten Violett glitzert. "
    "Bestimmt gibt es hier grosse Edelsteinvorkommen.");
  AddDetail( ({"grotte"}),
    "Du stehst hier am Anfang der Grotte. Sie kommt Dir trotz ihrer "
    "Schoenheit ziemlich unheimlich vor.");
  AddDetail( "schoenheit",
    "So etwas schoenes hast Du noch nie gesehen!");
  AddDetail( "osten",
    "Im Osten fuehrt der Gang weiter.");
  AddDetail( "nordwesten",
    "Im Nordwesten fuehrt der Gang weiter.");
  AddDetail( "felswand",
    "In der suedlichen Felswand befindet sich das Tor der Grotte.");
  AddDetail( "see",
    "Um zum See zu gelangen musst Du schon durchs Tor gehen!");
  AddDetail( "anfang",
    "Hier beginnt der Gang und fuehrt nach Osten und Nordwesten "
    "weiter.");
  AddSpecialDetail(("stelle"),"stelle_schau");
  AddSpecialDetail(("loch"),"loch_schau");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein Flattern und ein Zischeln.");
  AddSound( "flattern",
    "An der Decke flattert etwas.");
  AddSound( "zischeln",
    "Das Zischeln kommt aus dem Osten.");

  AddExit( "osten","/d/gebirge/orw/grotte/room/grotte3" );
  AddExit( "nordwesten","/d/gebirge/orw/quest/room/grotte16" );

  AddItem( "/d/gebirge/orw/grotte/npc/fleder", REFRESH_DESTRUCT );

  AddCmd( ({"kratze","kratz"}), "fktkratze");
  AddCmd( ({"greife","greif"}), "fktgreife");
  counter=1;

  NewDoor( "sueden","./grotte1","tor",
  ({  D_NAME,"Tor",
      D_GENDER, NEUTER,
      D_FLAGS, (DOOR_NEEDKEY|DOOR_RESET_CL|DOOR_CLOSED),
      D_MSGS, ({"nach Sueden", "geht durch das Tor",
 			 "kommt durch das Tor herein" }),
      D_SHORT,"Das Tor der Grotte ist %s. ",
      D_LONG,
        "Ein stabiles, schwarzes Tor ist in der Felswand im Sueden. "
        "Es fuehrt wieder aus der Grotte raus zum See. "
  }) );
}

int fktkratze(string str)
{
  notify_fail("Was moechtest Du abkratzen?\n");
  if (str == "moos ab")
  {
   if(moos_weg == 1)
   {
       write("Aber das Moos wurde doch schon abgekratzt!\n");
       return 1;
   }
   else
   {
       write(
       "Du kratzt etwas Moos von der verdorrten Stelle ab und findest dahinter "
       "ein Loch.\n");
       say(
       TP->Name()+
       " kratzt an der Wand herum.\n",TP);
       moos_weg=1;
       return 1;
   }
  }
  else return 0;
}



int fktgreife(string str)
{
  object gewaechs;
  notify_fail("Wo moechtest Du reingreifen?\n");
  if (!counter) return write(BS(
  "Du greifst in das Loch, aber findest darin nichts als kaltes Gestein.\n")),1;
  if (str=="in loch")
  {
       gewaechs = clone_object("/d/gebirge/orw/grotte/obj/gewaechs");
       gewaechs->move(this_player(),M_GET|M_SILENT);
       write(
       BS("Du greifst in das Loch und reisst etwas von dem seltsamen Gewaechs "
	  "aus, das Du in dem Loch findest.\n"));
       say(
       BS(TP->Name()+
       " greift in ein Loch und findet etwas.\n"),this_player());
       counter--;

  return 1;
  }
}

stelle_schau()
{
  if (moos_weg==1)
    return ("Mitten in der Stelle ist jetzt ein kleines Loch.\n");
  else
    return ("An dieser Stelle ist das Moos verdorrt, Du koenntest versuchen es abzukratzen.\n");
}

loch_schau()
{
  if (moos_weg==1)
    return ("Du kannst nichts erkennen, versuch doch mal reinzugreifen.\n");
  else
    return ("Sowas siehst Du hier nicht!\n");
}


reset()
{
      ::reset();
      counter=1;
      moos_weg=0;
}
