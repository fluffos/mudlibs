/* Das Ende des Gangs */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <room.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>



create()
{
	::create();


	SetProp( P_INT_SHORT, "Eine Grotte" );
	SetProp( P_INT_LONG,
		"Der Gang in dem du Dich befindest strahlt in einem leichten Violett\n"
	+	"das vom Edelsteingehalt des Gesteins ausgeht. In der nordoestlichen\n"
	+	"Ecke ist ein grosses Loch im Boden.\n"
	);
	SetProp( P_LIGHT, 0 );
	SetProp( P_INDOORS, 1 );
	SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 6, ENV_TERRAIN: TT_CAVE]) );


	AddDetail( "gang",
		"Der Gang hoert hier im Osten auf.\n"
	);
	AddDetail( ({ "violett", "edelsteingehalt", "gehalt" }),
		"Die Waende leuchten schoen Violett durch deine Lichtquelle.\n"
	);
	AddDetail( ({ "lichtquelle", "quelle" }),
		"Du musst schon selbst wissen welche Lichtquelle Du benuetzt.\n"
	);
	AddDetail( ({ "pfuetzen", "wasser", "pfuetze","boden" }),
		"Am Boden haben sich einige Pfuetzen gebildet. In einer Ecke ist ein Loch.\n"
	);
	AddDetail( "moos",
		"Huebsches, weiches, dunkelgruenes Moos.\n"
	);
	AddDetail( ({ "umgebung", "boden", "decke", "felswaende", "felswaenden" }),
		"Alles hier leuchtet in diesem schoenen Violett.\n"
	);
	AddDetail( "stellen",
		"An vielen Stellen waechst Moos an den Waenden.\n"
	);
	AddDetail( ({"gestein","gesteins","edelsteinvorkommen","vorkommen"}),
		"Ein sehr schoenes Gestein, welches in einem leichten Violett glitzert.\n"
	+	"Bestimmt gibt es hier grosse Edelsteinvorkommen.\n"
	);
	AddDetail( ({"grotte"}),
		"Du stehst hier am Anfang der Grotte. Sie kommt Dir trotz ihrer \n"
	+	"Schoenheit ziemlich unheimlich vor.\n"
	);
	AddDetail( "schoenheit",
		"So etwas schoenes hast Du noch nie gesehen!\n"
	);
	AddDetail( ({"westen"}),
		"Im Westen fuehrt der Gang weiter.\n"
	);
	AddDetail( "ecke",
		"In der Ecke ist ein grosses Loch, es schein sehr weit nach unten zu fuehren.\n"
	);
	AddDetail( ({"wand","waende"}),
		"An den Waenden sind viele gruenliche Stellen.\n"
	);
	AddDetail( "ecken",
		"In einer der Ecken befindet sich ein grosses Loch.\n"
	);
	AddDetail( "loch",
		"Vielleicht kann man da runterklettern.\n"
	);

	AddSound( DEFAULT_SOUND,
		"Du hoerst ein Zischeln."
	);
	AddSound( "richtung",
		"Das Zischeln kommt aus westlicher Richtung.\n"
	);
	AddSound( "zischeln",
		"Das Zischeln kommt aus westlicher Richtung.\n"
	);

	AddExit( "westen","/d/gebirge/orw/grotte/room/grotte3" );


	AddCmd( ({"klettere","kletter"}), "fktklettere");



}

fktklettere(str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str=="runter" || str=="hinunter")
    {
    write(BS("Du kletterst durch das Loch hinunter.\n"));
    TP->move("/d/gebirge/orw/grotte/room/grotte5", M_GO, "","klettert durch das Loch hinunter","kommt durch das Loch "
	    +"heruntergeklettert");
    return 1;
    }
  else
    return 0;
}

void open_secret_door()
{
  tell_room( this_object(), "Eine Geheimtuer oeffnet sich.\n" );
  AddExit("norden", "/d/gebirge/orw/grotte/room/grotte7" );
}

void reset()
{
  ::reset();
  RemoveExit("norden");
}
