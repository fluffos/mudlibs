inherit "std/transport";

/* Das Floss auf dem unterirdischen See */
/* Orw, 20.06.2000 */

#include <properties.h>
#include <language.h>
#include <transport.h>
#include <rooms.h>

create()
{
  ::create();
  SetProp( P_NAME, "Floss" );
  AddId("floss");
  SetProp( P_GENDER, NEUTER );
  SetProp( P_INT_SHORT, "Auf einem kleinen Floss" );
  SetProp( P_INT_LONG,
		"Du befindest Dich auf einem kleinen Floss, das Dich sicher ueber\n"
	  +	"den unterirdischen See faehrt. Ein kleiner Gnom steuert es gekonnt\n"
	  +	"an das andere Ufer.\n"
	  );
  SetProp( P_SHORT, "Ein kleines Floss" );
  SetProp( P_LONG,
		"Ein kleines Floss transportiert Reisende ueber den unterirdischen See.\n"
	  +	"Es wird von einem jungen Gnom gesteuert. Vielleicht nimmt er Dich mit.\n"
	  );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);

  AddDetail( "ufer",
	"Nur durch das Licht kann man noch erkennen wo das Ufer liegt.\n"
  );
  AddDetail( "floss",
	"Das Floss besteht aus alten Bierfaessern, die mit Holzplanken zusammen \n"
  +	"zusammen gehalten werden.\n"
  );
  AddDetail( "see",
	"Der See ist glasklar, waere mehr Licht koennte man sicher auch in der Mitte \n"
  +	"bis auf den Grund sehen.\n"
  );
  AddDetail( "himmel",
	"Den kannst Du hier nicht sehen.\n"
  );
  AddDetail( ({ "bierfaesser", "faesser","bierfaessern"}),
	"Ploetzlich willst Du unbedingt ein kuehles Bierchen.\n"
  );
  AddDetail( ({ "holzplanken", "planken" }),
	"Sie sehen sehr stabil aus.\n"
  );
  AddDetail( "licht",
	"Vom Ufer leuchtet ein wenig Licht zu Dir.\n"
  );
  AddDetail( "gnom",
	"Er steuert das Floss.\n"
  );
  AddDetail( "boden",
	"Der Boden des Flosses besteht aus Bierfaessern.\n"
  );
  AddDetail( "bierchen",
	"Ja, ein Bierchen waer nicht schlecht.....\n"
  );
  AddDetail( "grund",
	"Der ist am Ufer sehr felsig.\n"
  );
  AddDetail( "mitte",
	"In der Mitte vom See ist es zu finster um bis auf den Grund zu sehen.\n"
  );
  AddDetail( "decke",
	"Gute zehn Meter ueber Dir, kannst Du die Decke erkennen.\n"
  );
  AddDetail( "wasser",
	"Das Wasser im See ist sehr klar.\n"
  );
  AddDetail( "felsen",
	"Der See ist an allen Seiten von Felsen umgeben.\n"
  );
  AddDetail( "paddel",
        "Der Gnom hat ein Paddel."
  );

  AddItem( "/d/gebirge/orw/grotte/npc/gnom", REFRESH_DESTRUCT);

  SetProp( P_DEPARTMSG, ({
	 "Der Gnom stoesst das Floss vom Ufer ab.\n",
	 "Das Floss legt ab.\n"
  }) );

  SetProp( P_ARRIVEMSG, ({
	 "Das Floss legt beim @@QueryArrived@@ an.\n",
	 "Ein Floss legt am Ufer an.\n"
  }) );

  SetProp( P_ENTERMSG, ({
	 "steigt auf das Floss",
	 "kommt auf das Floss"
  }) );

  SetProp( P_LEAVEMSG, ({
	 "steigt vom Floss",
	 "steigt vom Floss"
  }) );

  SetProp( P_LEAVEFAIL, ({"Beinahe waerst Du ins Wasser gefallen",
			  "faellt beinahe ins Wasser.\n"}) );

  SetProp( P_ENTERFAIL, "Es passen nur zwei Passagiere auf das Floss" );
  SetProp( P_MAX_PASSENGERS, 3 );

  /* Verben */
  AddCmd( ({ "steig", "steige", "spring", "springe" }), "steige" );
  AddCmd( ({ "betrete", "betritt", "besteig", "besteige" }), "myEnter");
  AddCmd( ({ "verlass", "verlasse" }), "myLeave");


  /* Kurs */
  AddRoute( "/d/gebirge/orw/grotte/room/grotte1", 30, 20, "Grotteneingang",
          ({"grotte","eingang","grotteneingang"}), "zum Grotteneingang" );
  AddMsg( "Der Gnom steuert das Floss in Richtung Anlegesteg.\n", 20 );
  AddMsg( "Das Floss naehert sich dem Ufer.\n", 10 );
  AddRoute( "/d/gebirge/orw/grotte/room/steg", 30, 20, "Steg",
          ({"stadt","steg","felonia","zwergenstadt"}), "zum Steg von Felonia");
  AddMsg( "Der Gnom steuert das Floss in Richtung Grotteneingang.\n", 20 );
  AddMsg( "Das Floss naehert sich dem Ufer.\n", 10 );


  Start();
}

int steige(string str)
{
  string arg, arg2;

  // Debuggt (Angrox)
  notify_fail("Von was oder auf was willst Du steigen?\n");
  if (!str) return 0;

  if (sscanf( str, "auf %s", arg ) > 0 && id(explode(arg," ")[0]))
	 return Enter();

  if (sscanf( str, "von %s", arg ) > 0 && id(explode(arg, " ")[0]))
	 return Leave();
}

int myEnter(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if (id(str)) return notify_fail("Das geht gerade nicht.\n"), Enter();
}

int myLeave(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if (id(str)) return notify_fail("Das geht gerade nicht.\n"), Leave();
}

