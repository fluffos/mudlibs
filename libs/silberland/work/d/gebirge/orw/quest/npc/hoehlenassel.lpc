//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Hoehlenassel
//  Erstellt  : 24.10.2000 (Orw)
//  Geaendert : -


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int gefangene_landtiere;

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"hoehlenassel", "tierchen", "assel","insekt","LANDTIERCHEN"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME,  "Hoehlenassel");
  SetProp (P_SHORT, "Eine Hoehlenassel");
  SetProp (P_LONG,
	"Die Hoehlenassel weidet Waende und Steine mit organischen "
	"Ueberzuegen ab. Sie hat einen kleinen runden Koerper und "
	"zwei kurze Fuehler.");

  create_default_npc(2);

  SetProp (P_ARTICLE, 1);
  SetProp (P_ALIGN, 5);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihren Fuehlern ", 30, DT_MAGIC}) );
  SetProp (P_SIZE, 1);

  SUID;

  SetChats(1, ({
	"Die Hoehlenassel kriecht ueber einen Stein.\n",
	"Die Hoehlenassel knabbert an einem Pilz.\n"}));

  SetProp (P_DIE_MSG, " wird nie wieder froehlich herumkriechen.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Hoehlenassel kann @WEN gar nicht tragen.\n" }) );
    
  SetProp(P_MSGIN,   "kriecht herein");
  SetProp(P_MSGOUT,  "kriecht");
  SetProp(P_MMSGIN,  "kriecht herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  
  
  AddCmd( ({"fange","fang"}), "fktfange");    

}

int fktfange(string str)
{
  object key;
  gefangene_landtiere=sizeof(filter_objects(all_inventory(this_player()),"id","LANDTIERCHENGEF"));
  notify_fail("Was willst Du womit fangen?\n");
  if( !str ) return 0;
  if( !key=present("FANGPINZETTE", this_player()) )
  {
    write("Du hast nicht das geeignete Werkzeug um die Assel zu fangen.\n");
    return 1;
  }
  if(gefangene_landtiere==3)
  {
    write("Du hast schon genuegend Landtierchen gefangen.\n");
    return 1;
  }  
  if(present("HOEHLENASSELGEF", this_player()) )
  {
    write("Du hast doch schon eine Hoehlenassel gefangen.\n");
    return 1;	
  }
  if(present("LANDBEHVOLL", this_player()) )
  {
    write("Du hast doch schon drei Landtierchen im Behaelter.\n");
    return 1;	
  }
  if( str=="assel mit pinzette" ||
      str=="hoehlenassel mit pinzette" ||
      str=="insekt mit pinzette" ||
      str=="tierchen mit pinzette" )
  {
    write("Geschickt faengst Du die Hoehlenassel mit der Pinzette.\n");
    say( CAP_TPN+" faengt geschickt eine Hoehlenassel.\n", ({this_player()}) );
    CLONE( OBJ "/hoehlenasselobj", this_player());
    this_object()->remove();
    return 1;
  }
  else 
    return 0;
}
