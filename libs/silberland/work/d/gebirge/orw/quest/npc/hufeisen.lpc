//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Hufeisennase
//  Erstellt  : 24.10.2000 (Orw)
//  Geaendert : -


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  
  create_default_npc(2+random(4));
  SetProp(P_ALIGN, -20-random(200));
  switch( QueryProp(P_LEVEL))
  {
    case 2:
      switch( random(3)) 
      {
        case 0:
          SetProp(P_SHORT, "Eine kleine Hufeisennase");
          SetProp(P_NAME_ADJ, "klein");
          AddAdjective( ({"klein", "kleine"}) ); 
          break;
        case 1:
          SetProp(P_SHORT, "Eine haessliche Hufeisennase");
          SetProp(P_NAME_ADJ, "haesslich");
          AddAdjective( ({"haesslich", "haessliche"}) ); 
          break;
        case 2:
          SetProp(P_SHORT, "Eine pelzige Hufeisennase");
          SetProp(P_NAME_ADJ, "pelzig");
          AddAdjective( ({"pelzig", "pelzige"}) ); 
          break;
      }
      break;
    case 3:
      switch( random(3) )
      {
        case 0:
          SetProp(P_SHORT, "Eine Hufeisennase");
          break;
        case 1:
          SetProp(P_SHORT, "Eine stinkige Hufeisennase");
          SetProp(P_NAME_ADJ, "stinkig");
          AddAdjective( ({"stinkig", "stinkige"}) );
          break;
        case 2:
          SetProp(P_SHORT, "Eine praechtige Hufeisennase");
          SetProp(P_NAME_ADJ, "praechtig");
          AddAdjective( ({"praechtig", "praechtige"}) ); 
          break;
      }
      break;
    case 4:
      switch( random(3) )
      {
        case 0:
          SetProp(P_SHORT, "Eine grosse Hufeisennase");
          SetProp(P_NAME_ADJ, "gross");
          AddAdjective( ({"gross", "grosse"}) ); 
          break;
        case 1:
          SetProp(P_SHORT, "Eine nette Hufeisennase");
          SetProp(P_NAME_ADJ, "nett");
          AddAdjective( ({"nett", "nette"}) );
          AddProp(P_ALIGN, 100); 
          break;
        case 2:
          SetProp(P_SHORT, "Eine pummelige Hufeisennase");
          SetProp(P_NAME_ADJ, "pummelig");
          AddAdjective( ({"pummelig", "pummelige"}) ); 
          break;
      }
      break;
    case 5:
      switch( random(3) )
      {
        case 0:
          SetProp(P_SHORT, "Eine riesige Hufeisennase");
          SetProp(P_NAME_ADJ, "riesig");
          AddAdjective( ({"riesig", "riesige"}) ); 
          break;
        case 1:
          SetProp(P_SHORT, "Eine gefaehrliche Hufeisennase");
          SetProp(P_NAME_ADJ, "gefaehrlich");
          AddAdjective( ({"gefaehrlich", "gefaehrliche"}) ); 
          break;
        case 2:
          SetProp(P_SHORT, "Eine boese Hufeisennase");
          SetProp(P_NAME_ADJ, "boes");
          AddAdjective( ({"boes", "boese"}) ); 
          AddProp(P_ALIGN, -150);
          break;
      }
      break;
  }
  
  AddId (({"hufeisennase","tierchen","eisennase","nase"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Hufeisennase");
  SetProp (P_LONG,
	Name(WER,1)+" haengt von der Decke und kuemmert sich nicht um Dich. "
	"Sie gehoert zu der Familie der Fledermaeuse und unterscheidet sich "
	"von seinen Artgenossen durch seine hufeisenfoermigen Nasenlappen. "
	"Dieses Hauptgebilde dient als Richtstrahler bei der Echopeilung, "
	"denn die Hufeisennasen erzeugen zwar ihre Ultraschall-Rufe wie "
	"alle Fledermaeuse mit der Kehlkopfmuskulatur, stossen sie aber "
	"dann nicht durch den Mund, sondern durch die Nase aus. Das hat "
	"den grossen Vorteil, dass sie mit geschlossenem Mund fliegen und "
	"im Flug die gefangenen Insekten verzehren koennen, ohne auf die "
	"Peilung verzichten zu muessen.");
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_RACE, "Fledermaus");
  SetProp (P_HANDS, ({" mit ihren Zaehnchen ", 30, DT_PIERCE}) );
  SetProp (P_SIZE, 5+random(3));
  SetProp (P_HEAL,2);
  
  SetProp(P_MSGIN,   "flattert herein");
  SetProp(P_MSGOUT,  "flattert");
  SetProp(P_MMSGIN,  "flattert herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");


  SUID;

  SetProp(P_SPELLRATE,20);
  AddSpell(1,30+random(20),
    Name(WER,1)+" beisst Dir ins Gesicht.\n",
    Name(WER,1)+" beisst @WEM ins Gesicht.\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));
    
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann @WEN gar nicht tragen.\n" }) );

  SetChats(1, ({
	Name(WER,1)+" flattert aufgeschreckt herum.\n",
	"Beinahe haettest Du "+Name(WER,1)+" aufgeweckt.\n",
	Name(WER,1)+" schlaeft unbekuemmert weiter.\n"}));
  AddInfo (DEFAULT_INFO, "wuerdigt Dich keines Blickes.\n");
  SetProp (P_DIE_MSG, " faellt toetlich getroffen zu Boden.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");
  
}

// Reaktionen auf den Spieler

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schaut einfach weg.",
        "schaut einfach weg.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "zeigt Dir ihre Zaehnchen.",
        "zeigt "+TPN+" ihre Zaehnchen.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "flattert aufgeregt.",
        "flattert aufgeregt.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "fletscht ihre Zaehnchen.",
        "fletscht ihre Zaehnchen.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "guckt Dich komisch an.", 
        "guckt "+TPN+" komisch an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "flattert mit den Nasenlappen.",
        "flattert mit den Nasenlappen.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "quitscht Dich vergnuegt an.",
        "quitscht "+TPN+" vergnuegt an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TPN+" gar nicht.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schenkt Dir einen troestenden Blick.",
        "schenkt "+TPN+" einen troestenden Blick.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

