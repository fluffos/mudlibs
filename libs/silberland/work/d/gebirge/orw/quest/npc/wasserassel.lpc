//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Wasserassel
//  Erstellt  : 24.10.2000 (Orw)
//  Geaendert : -


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int gefangene_wassertierchen;

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"wasserassel", "tierchen", "assel","insekt","WASSERTIERCHEN"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME,  "Wasserassel");
  SetProp (P_SHORT, "Eine Wasserassel");
  SetProp (P_LONG,
	"Die Wasserassel lebt im Wasser, Pfuetzen oder feuchten "
	"Hoehlenteilen. Sie hat einen kleinen laenglichen Koerper und "
	"zwei lange Fuehler.");

  create_default_npc(2);

  SetProp (P_ARTICLE, 1);
  SetProp (P_ALIGN, 5);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihren Fuehlern ", 30, DT_MAGIC}) );
  SetProp (P_SIZE, 1);

  SUID;

  SetChats(1, ({
	"Die Wasserassel kriecht im Wasser herum.\n",
	"Die Wasserassel wackelt mit ihren Fuehlern.\n"}));

  SetProp (P_DIE_MSG, " wird nie wieder froehlich herumkriechen.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Wasserassel kann @WEN gar nicht tragen.\n" }) );
    
  SetProp(P_MSGIN,   "kriecht herein");
  SetProp(P_MSGOUT,  "kriecht");
  SetProp(P_MMSGIN,  "kriecht herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  
  
  AddCmd( ({"fange","fang"}), "fktfange");    

}

int fktfange(string str)
{
  object key;
  gefangene_wassertierchen=sizeof(filter_objects(all_inventory(this_player()),"id","WASSERTIERCHENGEF"));
  notify_fail("Was willst Du womit fangen?\n");
  if( !str ) return 0;
  if( !key=present("FANGPINZETTE", this_player()) )
  {
    write("Du hast nicht das geeignete Werkzeug um die Assel zu fangen.\n");
    return 1;
  }
  if(gefangene_wassertierchen==3)
  {
    write("Du hast schon genuegend Wassertierchen gefangen.\n");
    return 1;
  }  
  if(present("WASSERASSELGEF", this_player()) )
  {
    write("Du hast doch schon eine Wasserassel gefangen.\n");
    return 1;	
  }
  if(present("WASSERBEHVOLL", this_player()) )
  {
    write("Du hast doch schon drei Wassertierchen im Behaelter.\n");
    return 1;	
  }
  if( str=="assel mit pinzette" ||
      str=="wasserassel mit pinzette" ||
      str=="insekt mit pinzette" ||
      str=="tierchen mit pinzette" )
  {
    write("Geschickt faengst Du die Wasserassel mit der Pinzette.\n");
    say( CAP_TPN+" faengt geschickt eine Wasserassel.\n", ({this_player()}) );
    CLONE( OBJ "/wasserasselobj", this_player());
    this_object()->remove();
    return 1;
  }
  else 
    return 0;
}
