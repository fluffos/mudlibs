//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Hoehlenflohkrebs
//  Erstellt  : 24.10.2000 (Orw)
//  Geaendert : -


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int gefangene_wassertierchen;

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"hoehlenflohkrebs", "tierchen", "flohkrebs","insekt","krebs",
           "WASSERTIERCHEN"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME,  "Hoehlenflohkrebs");
  SetProp (P_SHORT, "Ein Hoehlenflohkrebs");
  SetProp (P_LONG,
	"Der Hoehlenflohkrebs ist haeufig in Wasserhoehlen anzutreffen und "
	"seine Nahrung besteht aus Einzellern und Schlammwuermern. Er "
	"frisst auch den Hoehlenlehm, aus dem er die organischen "
	"Bestandteile verwendet.");

  create_default_npc(2);

  SetProp (P_ARTICLE, 1);
  SetProp (P_ALIGN, 5);
  SetProp (P_MAX_HANDS, 8);
  SetProp (P_HANDS, ({" mit seinen Fuehlern ", 30, DT_MAGIC}) );
  SetProp (P_SIZE, 1);

  SUID;

  SetChats(1, ({
	"Der Hoehlenflohkrebs krebst herum.\n",
	"Der Hoehlenflohkrebs frisst ein wenig Schlamm.\n"}));

  SetProp (P_DIE_MSG, " wird nie wieder froehlich herumkrabbeln.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hoehlenflohkrebs kann @WEN gar nicht tragen.\n" }) );
    
  SetProp(P_MSGIN,   "krabbelt herein");
  SetProp(P_MSGOUT,  "krabbelt");
  SetProp(P_MMSGIN,  "krabbelt herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  
  
  AddCmd( ({"fange","fang"}), "fktfange");    

}

int fktfange(string str)
{
  object key;
  gefangene_wassertierchen=sizeof(filter_objects(all_inventory(this_player()),"id","WASSERTIERCHENGEF"));
  notify_fail("Was willst Du womit fangen?\n");
  if( !str ) return 0;
  if( !key=present("FANGPINZETTE", this_player()) )
  {
    write("Du hast nicht das geeignete Werkzeug um den Krebs zu fangen.\n");
    return 1;
  }
  if(gefangene_wassertierchen==3)
  {
    write("Du hast schon genuegend Wassertierchen gefangen.\n");
    return 1;
  }  
  if(present("HOEHLENFLOHKREBSGEF", this_player()) )
  {
    write("Du hast doch schon einen Hoehlenflohkrebs gefangen.\n");
    return 1;	
  }
  if(present("WASSERBEHVOLL", this_player()) )
  {
    write("Du hast doch schon drei Wassertierchen im Behaelter.\n");
    return 1;	
  }
  if( str=="krebs mit pinzette" ||
      str=="flohkrebs mit pinzette" ||
      str=="hoehlenflohkrebs mit pinzette" ||
      str=="insekt mit pinzette" ||
      str=="tierchen mit pinzette" )
  {
    write("Geschickt faengst Du den Hoehlenflohkrebs mit der Pinzette.\n");
    say( CAP_TPN+" faengt geschickt einen Hoehlenflohkrebs.\n", ({this_player()}) );
    CLONE( OBJ "/krebsobj", this_player());
    this_object()->remove();
    return 1;
  }
  else 
    return 0;
}
