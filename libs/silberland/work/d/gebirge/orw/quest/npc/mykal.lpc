//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Mykal, der Grottenhirte
//  Erstellt  : 30.10.2000 (Orw)
//  Geaendert : -

inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

nosave string * mykalsaufgabe;
nosave string * pinzettensucher;
string aufgabeinfo(string key);
string pinzetteinfo(string key);
string ausruestunginfo(string key);

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  mykalsaufgabe=({});
  pinzettensucher=({});

  SetProp(P_SHORT, "Mykal, der Grottenhirte");
  SetProp(P_LONG,
    "Vor Dir steht ein riesiger Mykonid, halb Mensch, halb Giftpilz. "
    "Seine Kappe leuchtet gruen und sein Stengel ist schneeweiss. "
    "Er macht trotz seiner Groesse und seiner maechtigen Schritte "
    "einen sehr gutmuetigen Eindruck auf Dich, aber im Kampf moechtest "
    "Du ihm nicht begegnen. Solche Pilzmenschen haben magische Sporen, "
    "welche im Kampf eingesetzt eine fast unueberwindbare Waffe sind "
    "und die verschiedensten Auswirkungen auf Deine Gesundheit haben "
    "koennen.");
  SetProp(P_NAME, "Mykal");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:20]));
  AddId(({"mykal", "grottenhirte", "hirte", "pilz", "mykonid", "QUESTFLUFFI"}));
  set_living_name("mykal");

  create_default_npc(41);
  SetProp(P_HANDS, ({
    " mit seinen Sporen",QueryProp(P_HANDS)[1],DT_POISON}));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+500);
  SetProp(P_BODY, QueryProp(P_BODY)+50);
  SetProp(P_XP, QueryProp(P_XP)+20000*100); // Bonus fuer Spells
  SetProp(P_RACE, "Mykonid");
  SetProp(P_SIZE, 194+random(10));
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, -34);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN,   "stampft herein");
  SetProp(P_MSGOUT,  "stampft");
  SetProp(P_MMSGIN,  "waechst aus dem Boden");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " faellt toetlich getroffen um.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Wer beschuetzt jetzt meine Grotte?");
  SetProp(P_KILL_NAME,  "Mykal, der Grottenhirte");
  SetProp(P_KILL_MSG,   "Leg Dich nie wieder mit einem Mykoniden an");

  SetProp(P_LOG_INFO, "/orw/hquest.log");  

// Details des NPCs
  AddDetail( ({"kappe"}),
	 "Mykal hat eine riesige leuchtend gruene Kappe.");
  AddDetail( ({"mensch" }),
	 "Mykoniden sind halb menschlich und halb Giftpilz.");
  AddDetail( ({"mykoniden","pilzmenschen"}),
	 "Ob es hier mehr von denen gibt?");
  AddDetail( ({"giftpilz","gift"}),
	 "Mykal scheint giftig zu sein, also leg Dich lieber nicht mit "
	 "ihm an.");
  AddDetail( ({"stengel"}),
	 "Der Stengel ist schneeweiss.");
  AddDetail( ({"groesse"}),
	 "Mykal ist ungefaehr zwei Meter gross.");
  AddDetail( ({"schritte"}),
	 "Mykal stampft mit riesen Schritten herum.");
  AddDetail( ({"eindruck"}),
	 "Mykal macht einen sehr gutmuetigen Eindruck auf Dich.");
  AddDetail( ({"kampf","selbstmord","mord"}),
	 "Ein Kampf gegen Mykal waere glatter Selbstmord.");
  AddDetail( ({"sporen","bekanntschaft"}),
	 "Besser Du machst keine Bekanntschaft mit ihnen.");
  AddDetail( ({"waffe"}),
	 "Magische Sporen sind eine sehr gut Waffe.");
  AddDetail( ({"gesundheit","auswirkungen"}),
	 "Koennte schlimme Auswirkungen haben, sich mit Mykal anzulegen.");


// Antworten des NPCs
  AddInfo(DEFAULT_INFO, ({
    "sagt: Davon weiss ich nichts.\n",
    "gruebelt.\n",
    "fragt: Was meinst Du damit?\n",
    "fragt: Hmm?\n",
    "sagt: Noch nie davon gehoert.\n",
    "sagt: Keine Ahnung was Du meinst...."}) );
  AddInfo("orw", 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","erzaehlt erfreut: ");
    
// Standart Infos ueber die Grottentierchen
#include "../grottentierchen_infos.h"

  AddInfo( ({"grotte","hoehle" }),
    "Ich bin der Grottenhirte, alles in dieser Grotte steht unter meinem "
    "Schutz.",
    "sagt: ");
  AddInfo( ({"schutz"}),
    "Ich schuetze meine Grotte sehr gut, also sei vorsichtig und lass alles "
    "so wie es war.",
    "sagt: ");
  AddInfo( ({"halron","hoehlenforscher","forscher" }),
    "Dieser bloede Zwerg, kommt in meine Grotte und stampft herum als ob "
    "hier alles ihm gehoeren wuerde. Aber ich hab ihm seine Ausruestung "
    "weggenommen und ihm gezeigt wer hier der Mykonid im Haus ist, seither "
    "kauert er in dieser Nische im oberen Teil der Grotte und heult wie "
    "ein kleines Maedchen.",
    "sagt: ");
  AddInfo( ({"nische"}),
    "Die ist im oberen Teil der Hoehle.",
    "sagt: ");
  AddInfo( ({"teil","teile" }),
    "Du befindest Dich im unteren Teil der Grotte, im oberen Teil ist der "
    "Ausgang.",
    "sagt: ");
  AddInfo( ({"ausgang","eingang","tor" }),
    "Der Ausgang dieser Grotte ist mit einem Tor versiegelt, das vor langer "
    "Zeit die Zwerge dort in den Fels gehauen haben um sich vor den "
    "Gefahren dieser Grotte zu schuetzen.",
    "sagt: ");
  AddInfo( ({"zwerge"}),
    "Die Zwerge wohnen in Felonia, ihrer Stadt. Das ist nicht weit von hier "
    "und eigentlich muesstest Du daran vorbei gekommen sein, als Du Dich auf "
    "den Weg zu meiner Grotte gemacht hast.",
    "sagt: ");
  AddInfo( ({"zwerg"}),
    "Welchen Zwerg meinst Du? Ich kenne zwei Zwerge die hier in der Naehe "
    "leben, das sind Halron und Glorin.",
    "sagt: ");
  AddInfo( ({"glorin"}),
    "Ich habe nicht viel mit ihm zu tun und ich sehe ihn auch sehr selten. "
    "Er bewacht das Tor am Eingang der Grotte.",
    "sagt: ");
  AddInfo( ({"gebirgsbestie","bestie" }),
    "Die Gebirgsbestie ist sehr aggressiv, nimm Dich vor ihr in Acht. "
    "Sie ist zwar boese und abscheulich aber sie kommt wenigstens nie aus "
    "ihrem Versteck. Eine andere Bestie hingegen macht mir weitaus mehr "
    "Sorgen, ein Grottenschaender treibt seit einiger Zeit hier sein Unwesen.",
    "sagt: ");
  AddInfo( ({"sorgen","sorge" }),
    "Ein Grottenschaender terrorisiert die Grotte, er macht mir wirklich grosse "
    "Sorgen.",
    "seufzt: ");
  AddInfo( ({"versteck"}),
    "Du meinst das Versteck der Gebirgsbestie? Das ist im oestlichen Teil der "
    "Grotte.",
    "sagt: ");
  AddInfo( ({"tentakel","tentakelmonster","monster" }),
    "Das Tentakelmonster lebt seit langer Zeit hier. Ich lasse es leben weil "
    "sich dank ihm der Grottenschaender nicht zur Quelle traut.",
    "grinst: ");
  AddInfo( ({"quelle","plaetzchen"}),
    "Die Quelle ist ein echt flauschiges Plaetzchen, aber sei vorsichtig "
    "es ist auch nicht ungefaehrlich dort.",
    "warnt: ");
  AddInfo( ({"fungil"}),
    "Fungil ist einer der wenigen noch lebenden Verwandten, ich bin froh "
    "jemanden meinesgleichen hier zu haben, auch wenn er mich manchmal aergert.",
    "schmunzelt: ");
  AddInfo( ({"verwandte","verwandten" }),
    "Es gibt nicht mehr viele Mykoniden und in dieser Grotte gar nur mehr zwei.",
    "seufzt: ");
  AddInfo( ({"mykoniden","mykonid","pilzmenschen" }),
    "Mykoniden sind halb Mensch halb Giftpilz, Du weisst aber auch gar nichts.",
    "kichert: ");
  AddInfo( ({"mensch","menschen"}),
    "Menschen hab ich hier schon ewig nicht mehr gesehen.",
    "sagt: ");
  AddInfo( ({"grottenschaender","schaender","geselle" }),
    "Der Grottenschaender ist echt ein finsterer Geselle, zwar strohdumm "
    "aber er kann sich unsichtbar machen, deshalb finde ich ihn nicht. "
    "Wenn ihn nicht bald jemand erledigt wird er meine arme Grotte und "
    "mich noch in den Wahnsinn treiben.",
    "arglt: ");
  AddInfo( ({"wahnsinn"}),
    "ICH WERDE NOCH WAHNSINNIG!!!",
    "schreit: ");
  AddInfo( ({"pilze","pilz","giftpilz","giftpilze" }),
    "Pilze gibt es hier mehr als genug, schau Dich doch mal um!",
    "sagt: ");
  AddInfo( ({"felonia","stadt","zwergenstadt" }),
    "Felonia ist die Stadt der Zwerge, sie liegt nicht sehr weit von der "
    "Grotte entfernt.",
    "sagt: ");
  AddInfo( ({"gefahren","gefahr" }),
    "Ganz schoen gefaehrlich hier, deswegen muss ich auf meine Grotte "
    "auch so gut aufpassen.",
    "sagt: ");
  AddInfo( ({"thron","moosthron" }),
    "Huebsch, oder?",
    "fragt: ");
  AddInfo( ({"mykal","grottenhirte","hirte","pilzmensch" }),
    "Ich bin der Grottenhirte hier, Mykal ist mein Name!",
    "stellt sich vor: ");

// Specialinfos
  AddInfo( ({"pinzette"}),
    #'pinzetteinfo, "sagt: ", 1);
  AddInfo( ({"ausruestung","forscherausruestung"}),
    #'ausruestunginfo, "sagt: ", 1);
  AddInfo( ({"aufgabe"}),
    #'aufgabeinfo, "sagt: ", 1);
    
// Chats
  SetChats(2, ({
    "Mykal setzt sich kurz auf seinen Moosthron und steht dann "
    "ausgeruht wieder auf.\n",
    "Der Pilzmensch grinst Dich an.\n",
    "Mykal schaut Dir aufmerksam zu.\n",
    "Die Kappe von Mykal verfaerbt sich dunkelgruen.\n"}) );
  SetAttackChats(3, ({
    "Mykal lacht ueber Dich.\n",
    "Mykal laesst die Sporen tanzen.\n",
    "Der Pilzmensch aergert sich gruen und blau.\n",
    "Mykal schreit: DAS WAR DEIN LETZTER KAMPF!!!\n"}) );


// Zaubersprueche
  SetProp(P_SPELLRATE,30);
  AddSpell(3,400+random(300),
    "Mykal schiesst weisse Sporen auf Dich.\n",
    "Mykal schiesst weisse Sporen auf @WEN.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,150+random(100),
    "Mykal sondert eine ekelhafte Fluessigkeit aus.\n",
    "Mykal sondert eine ekelhafte Fluessigkeit aus.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,100,
    "Mykal versucht mit einem Sporennebel Deine Konzentration zu stoeren.\n",
    "Mykal versucht mit einem Sporennebel @WESSEN Konzentration zu stoeren.\n",
     DT_MAGIC,"spell_magie");
  AddDefaultSpell(2,200,DS_POISON,
    "Mykal beschiesst Dich mit kleinen, gruenen Giftsporen.\n",
    "Mykal beschiesst @WEN mit kleinen, gruenen Giftsporen.\n");

// Actionen wenn der NPC Gegenstaende bekommt
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Mykal sagt: Danke aber das brauche ich nicht!\n" }) );
    

  SUID;
  
}

// Specialinfo Funktionen
string aufgabeinfo(string key)
{
  if (present("QUESTZETTELDINGS",TP))
  {
    if (!present("FANGPINZETTE",TP))
    {    
      mykalsaufgabe+=({getuid(TP)});
      return "Hmja... die Aufgabe!\n"
           "Seit einiger Zeit treibt sich ein Grottenschaender\n"
           "in meiner Hoehle herum. Er verschmutzt das Wasser,\n"
           "toetet meine kleinen Schuetzlinge und stinkt grauenhaft.\n"
           "Bitte finde ihn und bring mir einen Beweis fuer seinen Tod.\n"
           "Leider kann ich Dir auch nichts genaueres sagen. Solche\n"
           "Biester sind schwer aufzuspueren.\n";
    }
    else
    {
      return "Du hast Die Aufgabe doch schon erledigt.";
    }
  }
  else
  {
    return "Ich habe keine Aufgabe fuer Dich.";
  }
}

string pinzetteinfo(string key)
{
  if (present("QUESTZETTELDINGS",TP))
  {
    if (present("FANGPINZETTE",TP))
    {    
      return "Du hast die Pinzette schon gefunden. Ich hoffe jetzt kannst Du "
             "Halron weiterhelfen.";
    }
    else
    {
      return "Ich weiss nicht wo ich die Pinzette verlegt habe. Aber vielleicht "
             "hat Fungil eine Ahnung wo sie sein koennte.";
    }
  }
  else
  {
    return "Ich weiss nicht wovon Du sprichst.";
  }  
}

string ausruestunginfo(string key)
{
  if (present("QUESTZETTELDINGS",TP))
  {
    if (present("LANDBEH",TP))
    {
      return "Du hast die Aufgabe erledigt und ich hab sie Dir schon gegeben.";
    }
    else
    {
      return "Erledige zuerst mal meine Aufgabe, dann gebe ich sie Dir.";
    }
  }
  else
  {
    return "Ich weiss nicht wovon Du sprichst.";
  }
}


// Reactionen wenn Mykal das Questobject "Ein Bueschel Grottenschaenderborsten"
// bekommt
void give_notify(object ob)
{
  object land_behaelter;
  object wasser_behaelter;
  object pinzette;
  if(ob->id("QUESTBUESCHELFELL"))
  {
    if (present("QUESTZETTELDINGS",TP))
    {
      if ((!present("LANDBEH",TP)) ||
          (!present("WASSERBEH",TP)))
      {
        write( 
        "Mykal sagt: Ja, das ist das Fell eines Grottenschaenders.\n"
        "Mykal sagt: Du hast die Aufgabe erledigt, ich bin Dir zu grossen Dank\n"
        "Mykal sagt: verpflichtet. Hier hast Du die versprochene Ausruestung\n"
        "Mykal sagt: zurueck. Leider fehlt die Pinzette, ich habe sie irgendwo\n"
        "Mykal sagt: verlegt.\n");
      
        if(!present("LANDBEH",TP))
        {
        land_behaelter=clone_object(OBJ"/landbehaelter");
        if ( ME_TOO_HEAVY==land_behaelter->move(TP,M_GET|M_SILENT) )
          land_behaelter->move(TO,M_NOCHECK|M_SILENT);  
        write("Mykal gibt Dir einen Behaelter fuer Landtierchen.\n"); 
        }
        if(!present("WASSERBEH",TP))
        {
        wasser_behaelter=clone_object(OBJ"/wasserbehaelter");
        if ( ME_TOO_HEAVY==wasser_behaelter->move(TP,M_GET|M_SILENT) )
          wasser_behaelter->move(TO,M_NOCHECK|M_SILENT);  
        write("Mykal gibt Dir einen Behaelter fuer Wassertierchen.\n");         
        }
        pinzettensucher+=({getuid(TP)});
        mykalsaufgabe-=({getuid(TP)});
      }
      else
      {
      	write("Mykal sagt: Du hast mir zwar schon Eins gegeben, aber danke!\n");
      }
    }
    else
    {
      write("Mykal sagt: Danke fuer das Bueschel!\n");
    }
  }
  else
  {
    write("Mykal sagt: Danke fuer "+ob->name(WEN,1)+"!\n");
  }
}



// Defend Funktion
Defend(int dam, string dtype, int spell, object enemy)    
{
  if (!pointerp(dtype))
      dtype = ({ dtype });


  if (sizeof(dtype & ({ DT_HOLY }) ))
  {
    tell_room(environment(), 
      "Ueber heilige Angriffe kann Mykal nur lachen.\n");
    return ::Defend(0, dtype, spell, enemy);
  }
     
   
  if (sizeof(dtype & ({ DT_UNHOLY }) ))
  {
    tell_room(environment(), 
      "Mykal fuerchtet sich ein wenig.\n");
    return ::Defend(0, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_ACID }) ))
  {
    tell_room(environment(), 
      "Mykal windet sich vor Schmerzen.\n");
    return ::Defend(dam+random(40), dtype, spell, enemy);
  }


  if (sizeof(dtype & ({ DT_LIGHTNING }) ))
  {
    tell_room(environment(), 
      "Mykal zittert bei diesem Angriff.\n");
    return ::Defend(dam+random(50), dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_ELECTRIC }) ))
  {
    tell_room(environment(), 
      "Mykal schreit laut auf.\n");
    return ::Defend(dam+random(30), dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_WATER }) ))
  {
    heal_self(dam*2);	
    tell_room(environment(), 
      "Mykal scheint zu noch riesiger zu werden.\n");
    return ::Defend(0, dtype, spell, enemy);
  }

  return ::Defend(dam, dtype, spell, enemy);    
}


// Funktionen der Zaubersprueche
void spell_magie(object enemy)
{
  switch(random(100))
  {
    case 0 .. 90:
      tell_object(enemy,
      "Mykal hat es geschafft Deine Konzentration zu stoeren.\n");
 
      enemy->AddSp(-(100+random(80)));
      break;
    case 91 .. 100:
      tell_object(enemy,
      "Mykal aergert sich ueber den gescheiterten Versuch.\n");
  }
}


// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  write_file(LOG "/questkills.log",
    ctime()+": "+CAP(getuid(PL))+" killt Mykal.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    command_me("sage Du wolltest es ja so haben!");
    write_file(LOG "/questdeads.log",
      ctime()+": Mykal hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}

// Begruessung des Spielers
init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}

void hallo() 
{ 
  if (MENV!=ENV(TP)) return;
  if (present("QUESTZETTELDINGS",TP) )
  {
    if ( -1!=member(pinzettensucher,getuid(TP)) )
    {
      if(!present("FANGPINZETTE",TP))
      {
        tell_room(environment(TO), 
        "Mykal sagt: Hi, "+TPN+"! Hast Du die Pinzette schon gefunden?\n");
        return;
      }
      else
      {
        tell_room(environment(TO), 
        "Mykal sagt: Oh, Du hast die Pinzette gefunden, gut gemacht!\n");
        pinzettensucher-=({getuid(TP)});
        return;
      }
    }
    if ( -1!=member(mykalsaufgabe,getuid(TP)) )
    {
      tell_room(environment(TO), 
        "Mykal kichert: Sag schon, wie weit bist Du mit der Quest?\n");
      return;
    }
    if(present("FANGPINZETTE",TP))
    {
        tell_room(environment(TO), 
        "Mykal sagt: Hi, "+TPN+"! Wie gehts Dir mit der Quest?\n");
        return;    
    }
    else
    {
      tell_room(environment(TO), 
        "\n"
        "Mykal sagt: Ah, "+TPN+" ich habe Dich schon erwartet!\n"
        "Mykal sagt: Du hilfst also Halron dem alten Zwerg.\n"
        "Mykal laechelt: Bestimmt fragst Du Dich woher ich das weiss. Ich weiss alles\n"
        "Mykal laechelt: was in meiner Grotte passiert.\n"
        "Mykal laechelt: Aber weil ich nicht so bin, werde ich Dir Halrons\n"
        "Mykal laechelt: Ausruestung zurueckgeben, WENN Du eine Aufgabe fuer mich\n"
        "Mykal laechelt: erledigst.\n"
        "Mykal laechelt: Ueberlege es Dir gut und wenn Du Halron wirklich helfen\n"
        "Mykal laechelt: willst, dann frag mich nach dieser Aufgabe.\n");
      return;
    }
  }
  else
  {
    if (TP->QueryProp(P_RACE)=="Hobbit")
    {
      switch(random(3))         
      {
      case 0:
        tell_room(environment(TO), "Mykal sagt: Gegruesst seist Du "
        +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"Frau":"Herr")+" "
        +capitalize((string)this_player()->QueryProp(P_RACE))+"!\n");
        break;
      case 1:
        tell_room(environment(TO), "Mykal sagt: Hallo, wie gehts "+TPN+"!\n");
        break;
      case 2:
        tell_room(environment(TO), "Mykal sagt: Was fuehrt Dich zu mir, "
        +capitalize((string)this_player()->QueryProp(P_RACE))+""
        +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"frau":"")+"?\n");
        break;
      default:
        tell_room(environment(TO), "Mykal sagt: Hi!\n");
      }
    }
    else
    {
      switch(random(3))         
      {
      case 0:
        tell_room(environment(TO), "Mykal sagt: Gegruesst seist Du "
        +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"Frau":"Herr")+" "
        +capitalize((string)this_player()->QueryProp(P_RACE))+"!\n");
        break;
      case 1:
        tell_room(environment(TO), "Mykal sagt: Hallo, wie gehts "+TPN+"!\n");
        break;
      case 2:
        tell_room(environment(TO), "Mykal sagt: Was fuehrt Dich zu mir, "
        +capitalize((string)this_player()->QueryProp(P_RACE))+""
        +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"in":"")+"?\n");
        break;
      default:
        tell_room(environment(TO), "Mykal sagt: Hi!\n");
      }
    }
  }
}


// Reaktionen des NPCs
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) 
  {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "floesst Dir neuen Mut ein.",
        "floesst "+TPN+" neuen Mut ein.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "fragt: Worueber aergerst Du Dich?",
        "fragt: Worueber aergert sich "+TPN+"?");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert: Hehe!",
        "kichert: Hehe!");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "arglt: Ja, aergere mich nur, "+TPN+"!",
        "arglt: Ja, aergere mich nur, "+TPN+"!");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "schreit: Nun werd mal nicht gleich frech!",
        "schreit: Nun werd mal nicht gleich frech, "+TPN+"!");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich froehlich an.", 
        "laechelt "+TPN+" froehlich an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "leuchtet ploetzlich knallrot auf.",
        "leuchtet ploetzlich knallrot auf.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "grinst Dich lieb und froehlich an.",
        "grinst "+TPN+" lieb und froehlich an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TPN+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich mit einem bunten Sporenregen.",
        "troestet "+TPN+" mit einem bunten Sporenregen.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}




void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

