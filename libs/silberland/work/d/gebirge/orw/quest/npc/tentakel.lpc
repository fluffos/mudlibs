//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Das Tentakelmonster
//  Erstellt  : 19.10.2000 (Orw)
//  Geaendert : 24.10.2000 (Orw)

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Tentakelmonster");
  SetProp(P_LONG,
    "Ein ekelhaftes Tentakelmonster. Es ist wohl durch einen missglueckten "
    "Zauberspruch eines grossen Zauberers entstanden und hat sich hier "
    "versteckt. Besser Du laesst es in Ruhe. Solche Monster haben kein "
    "Verstaendnis fuer kleine Abenteurer.");
  SetProp(P_NAME, "Tentakelmonster");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5,T_RANGE_MAX:10]));
  AddId(({"tentakel", "tentakelmonster", "monster"}));
  set_living_name("tentakelmonster");

  create_default_npc(40);
  SetProp(P_HANDS, ({
    " mit seinen Tentakeln",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+100);
  SetProp(P_BODY, QueryProp(P_BODY)+50);
  SetProp(P_XP, QueryProp(P_XP)+3000*100); // Bonus fuer Spells
  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 200+random(90));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL,27);
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "windet sich herein");
  SetProp(P_MSGOUT, "taucht weiter");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "ist ploetzlich weg");

  SetProp(P_DIE_MSG,  " sinkt toetlich getroffen auf den Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "GLAKTSCHL! BLOBB! BLUBBER!");
  SetProp(P_KILL_NAME, "Ein Tentakelmonster");
  SetProp(P_KILL_MSG, "BLUBBER! GLUCKSL! BLUBB!");

  AddInfo(DEFAULT_INFO, ({
    "versteht Dich doch gar nicht.\n",
    "schwimmt dumm herum.\n",
    "schaut Dich veraergert an.\n",
    "breitet seine Tentakel zum Angriff aus.\n"}) );
  AddInfo("orw", 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");

  SetChats(2, ({
    "Das Tentakelmonster versteckt sich hinter einigen Schlingpflanzen.\n",
    "Das Tentakelmonster gleitet sanft durchs Wasser.\n",
    "Das Tentakelmonster starrt Dich an.\n",
    "Das Tentakelmonster wirbelt etwas Schlamm auf.\n"}) );
  SetAttackChats(3, ({
    "Das Tentakelmonster verteidigt sich mit aller Kraft.\n",
    "Einige Tentakel schlaengeln sich um Deinen Hals.\n",
    "Das Tentakelmonster wirft mit Algen um sich.\n",
    "Das Tentakelmonster verfaengt sich in den Schlingpflanzen.\n"}) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Tentakelmonster will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(2,400+random(300),
    "Das Tentakelmonster wuergt Dich mit seinen Tentakeln.\n",
    "Das Tentakelmonster wuergt @WEN mit seinen Tentakeln.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,200+random(100),
    "Das Tentakelmonster beschiesst Dich mit kleinen Giftnesseln.\n",
    "Das Tentakelmonster beschiesst @WEN mit kleinen Giftnesseln.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,150+random(100),
    "Das Tentakelmonster spritzt Dich mit schwarzer Tinte voll.\n",
    "Das Tentakelmonster spritzt @WEN mit schwarzer Tinte voll.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1,
    "Das Tentakelmonster versucht Dich mit seinen Nesseln zu vergiften.\n",
    "Das Tentakelmonster versucht @WEN mit seinen Nesseln zu vergiften.\n",
     DT_POISON,"spell_vergiften");

  SUID;
  "/obj/pearlmaster"->DistributePearl(3,5,1,1);
}

// Defend Funktion

Defend(int dam, string dtype, int spell, object enemy)    
{
  if (!pointerp(dtype))
      dtype = ({ dtype });


  if (sizeof(dtype & ({ DT_HOLY }) ))
  {
    tell_room(environment(), 
      "Heilige Angriffe koennen dem Monster nichts anhaben.\n");
    return ::Defend(0, dtype, spell, enemy);
  }
     
   
  if (sizeof(dtype & ({ DT_UNHOLY }) ))
  {
    tell_room(environment(), 
      "Unheilige Angriffe koennen dem Monster nichts anhaben.\n");
    return ::Defend(0, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_ACID }) ))
  {
    tell_room(environment(), 
      "Das Tentakelmonster windet sich vor Schmerzen.\n");
    return ::Defend(2*dam, dtype, spell, enemy);
  }


  if (sizeof(dtype & ({ DT_LIGHTNING }) ))
  {
    tell_room(environment(), 
      "Das Tentakelmonster zittert bei Diesem Angriff.\n");
    return ::Defend(2*dam, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_ELECTRIC }) ))
  {
    tell_room(environment(), 
      "Das Tentakelmonster zittert bei Diesem Angriff.\n");
    return ::Defend(2*dam, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_WATER }) ))
  {
    heal_self(dam);	
    tell_room(environment(), 
      "Das Tentakelmonster scheint zu wachsen.\n");
    return ::Defend(0, dtype, spell, enemy);
  }

  return ::Defend(dam, dtype, spell, enemy);    
}


// Funktionen der Zaubersprueche

void spell_vergiften(object enemy)
{
  switch(random(100))
  {
    case 0 .. 90:
      tell_object(enemy,
      "Das Tentakelmonster hat es geschafft Dich zu vergiften.\n");
 
      enemy->AddPoison(1+random(5));
      break;
    case 91 .. 100:
      tell_object(enemy,
      "Das Tentakelmonster aergert sich ueber den Fehlschlag.\n");
  }
}


// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  write_file(LOG "/questkills.log",
    ctime()+": "+CAP(getuid(PL))+" killt das Tentakelmonster.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    write_file(LOG "/questdeads.log",
      ctime()+": Das Tentakelmonster hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "wird Dich gleich toeten.",
        "wird "+TPN+" gleich toeten.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "wird Dich gleich toeten.",
        "wird "+TPN+" gleich toeten.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.", 
        "schaut "+TPN+" verwundert an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TPN+" gar nicht.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
