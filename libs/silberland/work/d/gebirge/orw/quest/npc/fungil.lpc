//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Fungil, der kleine Pilz
//  Erstellt  : 25.10.2000 (Orw)
//  Geaendert : -

inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

string pinzettenantwort(string key);

void create() 
{
  if (!is_clone(TO)) return;
