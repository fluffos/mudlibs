  SetProp(P_SHORT, "Fungil, der kleine Pilz");
  SetProp(P_LONG,
    "Ein kleiner Pilz mit einer wunderhuebschen hellblauen Kappe. Er "
    "scheint einer der letzten Mykoniden zu sein, halb Mensch - halb "
    "Giftpilz. Doch Du fuerchtest Dich kein bisschen als Du sein "
    "nettes Laecheln siehst. Trotzdem solltest Du vorsichtig sein, "
    "man sagt Mykoniden grosse Faehigkeiten im Kampf nach.");
  SetProp(P_NAME, "Fungil");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5,T_RANGE_MAX:10]));
  AddId(({"fungil", "pilz", "mykonid"}));
  set_living_name("fungil");

  create_default_npc(31);
  SetProp(P_HANDS, ({
    " mit seinen Sporen",QueryProp(P_HANDS)[1],DT_POISON}));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+100);
  SetProp(P_BODY, QueryProp(P_BODY)+50);
  SetProp(P_XP, QueryProp(P_XP)+3000*100); // Bonus fuer Spells
  SetProp(P_RACE, "Mykonid");
  SetProp(P_SIZE, 40+random(10));
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, -25);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);

