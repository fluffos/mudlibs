  SetProp(P_MSGOUT,  "schlaeft ein");
  SetProp(P_MMSGIN,  "wacht auf");
  SetProp(P_MMSGOUT, "schlaeft ein");

  SetProp(P_DIE_MSG,  " faellt toetlich getroffen um.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Was sollte das jetzt?");
  SetProp(P_KILL_NAME,  "Fungil, der kleine Pilz");
  SetProp(P_KILL_MSG,   "Leg Dich nie wieder mit einem Mykoniden an");
  
  SetProp(P_LOG_INFO, "/orw/hquest.log");
  

// Details des NPCs

  AddDetail( ({"kappe"}),
	 "Fungil hat eine beeindruckende hellblau leuchtende Kappe.");
  AddDetail( ({"mensch" }),
	 "Mykoniden sind halb menschlich und halb Giftpilz.");
  AddDetail( ({"mykoniden"}),
	 "Ob es hier mehr von denen gibt?");
  AddDetail( ({"giftpilz","gift"}),
	 "Fungil scheint giftig zu sein, also leg Dich lieber nicht mit "
	 "ihm an.");
  AddDetail( ({"laecheln"}),
	 "Sein Laecheln sieht ca. so aus: :-)) , nur um 90 Grad gedreht.");
  AddDetail( ({"grad"}),
	 "Fungil lacht Dich aus.");
  AddDetail( ({"faehigkeiten"}),
	 "Hoffentlich wirst Du seine Faehigkeiten nie spueren muessen.");
  AddDetail( ({"kampf"}),
	 "Besser Du geraetst hier in keinen Kampf.");


// Antworten des NPCs
  AddInfo(DEFAULT_INFO, ({
    "sagt: Jetzt stell mal nicht so dumme Fragen!\n",
    "guckt dumm herum.\n",
    "schaut Dich veraergert an.\n",
    "fragt: Hmm ?\n",
    "sagt: Noch nie davon gehoert.\n"}) );
  AddInfo("orw", 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");
    
// Standart Infos ueber die Grottentierchen
#include "../grottentierchen_infos.h"

  AddInfo( ({"hoehle","grotte" }),
    "Ich wohne schon sooo lange in dieser Grotte, ich weiss nicht mal "
    "mehr wieso ich hier bin.",
    "kichert: ");
  AddInfo( ({"mykal","grottenhirte","hirte"}),
    "Mykal? Der passt hier auf alles auf! Ich bin froh, dass diese Grotte "
    "einen so guten Hirten hat.",
    "sagt: ");
  AddInfo( ({"halron","hoehlenforscher","forscher" }),
    "Ich kenne ihn. Hab ein paar mal mit ihm gesprochen. Ich glaube der ist "
    "ein bisserl plemplem. Der glaubt andauernd, dass ich ihm was tun will.",
    "sagt: ");
  AddInfo( ({"glorin","grottenwaechter","waechter" }),
    "Glorin ist ganz nett, ich besuche ihn manchmal. Wie die meisten Zwerge "
    "ist er ein bisserl eigensinnig, aber wenn man ihn mal ne Zeit kennt...",
    "sagt: ");
  AddInfo( ({"zwerge","zwerg" }),
    "Zwerge sind schon ziemlich eigenartig, aber ein paar sind ganz nett.",
    "sagt: ");
  AddInfo( ({"mykoniden","mykonid" }),
    "Ich bin ein Mykonid, es gibt nicht mehr viele meiner Rasse im "
    "Silberland.",
    "sagt: ");
  AddInfo( ({"silberland","land" }),
    "Du bist hier im Silberland, wenn auch gaaanz tief unter der "
    "Oberflaeche.",
    "sagt: ");
  AddInfo( ({"oberflaeche"}),
    "Ich war noch nie dort, aber ich habe gehoert, dass es dort sehr "
    "unangenehm sein soll, ganz trocken und heiss.",
    "schaudert: ");
  AddInfo( ({"moos","moose" }),
    "Das Moos in dieser Grotte ist wirklich sehr huebsch und saftig!",
    "erzaehlt stolz: ");
  AddInfo( ({"grottenschaender","schaender","bestie"}),
    "Irgendwo in dieser Grotte haelt sich ein Grottenschaender auf. "
    "Eine wirklich grauenhafte Bestie, leider ist er unsichtbar und "
    "man kann ihn nur mit besonders geschaerften Sinnen erblicken "
    "und bekaempfen. Waere toll wenn Du ihn finden koenntest, damit "
    "endlich wieder ruhig schlafen kann.",
    "erklaert zitternd: ");
  AddInfo( ({"sinne","sinnen"}),
    "Ich habe gehoert das es an der Oberflaeche des Silberlands ein "
    "Mittel geben soll das die Sinne so schaerft, dass man sogar "
    "unsichtbare Wesen sehen kann.",
    "sagt: ");
  AddInfo( ({"mittel"}),
    "Ich selbst kenne es nicht, habe nur davon gehoert.",
    "meint: ");
  AddInfo( ({"wesen"}),
    "Sei vorsichtig, in dieser Grotte gibt es auch boese Wesen!",
    "warnt: ");
  AddInfo( ({"pilz","pilze" }),
    "Ich bin ein Pilz, aber Du meinst wahrscheinlich meine pflanzlichen "
    "Verwandten. Von denen wachsen hier mehr als genug.",
    "sagt: ");
  AddInfo( ({"kappe"}),
    "Ich habe eine wundervolle Kappe, findest Du nicht auch?",
    "fragt stolz: ");
/*
  AddInfo( ({"","" }),
    " "
    ".",
    "sagt: ");

*/

// Spezialantwort fuer Questpinzette
  AddInfo( ({ "pinzette" }),
    #'pinzettenantwort, "antwortet: ", 1);


  SetChats(2, ({
    "Beinahe schlaeft Fungil wieder ein.\n",
    "Der Pilz knuddelt Dich.\n",
    "Fungil starrt Dich gelangweilt an.\n",
    "Die Kappe von Fungil leuchtet lustig.\n"}) );
  SetAttackChats(3, ({
    "Fungil verteidigt sich mit aller Kraft.\n",
    "Sporen fliegen durch den ganzen Raum.\n",
    "Der kleine Pilz wird dunkelgruen vor Wut.\n",
    "Fungil schreit: WARUM WILLST DU MICH TOETEN?!?\n"}) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Fungil will @WEN nicht tragen.\n" }) );

// Zaubersprueche

  SetProp(P_SPELLRATE,30);
  AddSpell(2,400+random(300),
    "Fungil schiesst weisse Sporen auf Dich.\n",
    "Fungil schiesst weisse Sporen auf @WEN.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,150+random(100),
    "Fungil sondert eine ekelhafte Fluessigkeit aus.\n",
    "Fungil sondert eine ekelhafte Fluessigkeit aus.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,100,
    "Fungil versucht mit einem Sporennebel Deine Konzentration zu stoeren.\n",
    "Fungil versucht mit einem Sporennebel @WESSEN Konzentration zu stoeren.\n",
     DT_MAGIC,"spell_magie");
  AddDefaultSpell(2,200,DS_POISON,
    "Fungil beschiesst Dich mit kleinen, gruenen Giftsporen.\n",
    "Fungil beschiesst @WEN mit kleinen, gruenen Giftsporen.\n");

  SUID;
  
}

// Defend Funktion

Defend(int dam, string dtype, int spell, object enemy)    
{
  if (!pointerp(dtype))
      dtype = ({ dtype });


  if (sizeof(dtype & ({ DT_HOLY }) ))
  {
    tell_room(environment(), 
      "Ueber heilige Angriffe kann Fungil nur lachen.\n");
    return ::Defend(0, dtype, spell, enemy);
  }
     
   
  if (sizeof(dtype & ({ DT_UNHOLY }) ))
  {
    tell_room(environment(), 
      "Fungil fuerchtet sich ein wenig.\n");
    return ::Defend(0, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_ACID }) ))
  {
    tell_room(environment(), 
      "Fungil windet sich vor Schmerzen.\n");
    return ::Defend(2*dam, dtype, spell, enemy);
  }


  if (sizeof(dtype & ({ DT_LIGHTNING }) ))
  {
    tell_room(environment(), 
      "Fungil zittert bei Diesem Angriff.\n");
    return ::Defend(2*dam, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_ELECTRIC }) ))
  {
    tell_room(environment(), 
      "Fungil schreit laut auf.\n");
    return ::Defend(2*dam, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_WATER }) ))
  {
    heal_self(dam);	
    tell_room(environment(), 
      "Fungil scheint zu wachsen.\n");
    return ::Defend(0, dtype, spell, enemy);
  }

  return ::Defend(dam, dtype, spell, enemy);    
}


// Spezialantwort betreffend Questpinzette
string pinzettenantwort(string key)
{
  if (!present("LANDBEH",TP))
  {
    return
      "Ich weiss echt nicht wovon Du sprichst.";
  }
  if (present("FANGPINZETTE",TP))
  {
    return
      "Oh du hast sie schon von Glorin bekommen? Das freut mich!";
  }
  return
    "Eine Pinzette? Hmm.. lass mich ueberlegen, ohja genau, ich hab vor ein paar "
    "Tagen eine gefunden. Ich hab sie Glorin gegeben, dem hat sie so gefallen "
    "weil sie so schoen golden glaenzt.";
} 


// Funktionen der Zaubersprueche

void spell_magie(object enemy)
{
  switch(random(100))
  {
    case 0 .. 90:
      tell_object(enemy,
      "Fungil hat es geschafft Deine Konzentration zu stoeren.\n");
 
      enemy->AddSp(-(40+random(40)));
      break;
    case 91 .. 100:
      tell_object(enemy,
      "Fungil aergert sich ueber den gescheiterten Versuch.\n");
  }
}


// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  write_file(LOG "/questkills.log",
    ctime()+": "+CAP(getuid(PL))+" killt Fungil.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    command_me("sage Und bist Du nun zufrieden?");
    write_file(LOG "/questdeads.log",
      ctime()+": Fungil hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}

// Begruessung des Spielers

init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}

void hallo() 
{ 
  if (MENV!=ENV(TP)) return;
  if (TP->QueryProp(P_RACE)=="Hobbit")
  {
    switch(random(3))         
    {
    case 0:
      tell_room(environment(TO), "Fungil sagt: Hallo, wie gehts "
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"Frau":"Herr")+" "
      +capitalize((string)this_player()->QueryProp(P_RACE))+"?\n");
      break;
    case 1:
      tell_room(environment(TO), "Fungil sagt: Sei Gegruesst, "+TPN+"!\n");
      break;
    case 2:
      tell_room(environment(TO), "Fungil sagt: Was fuehrt Dich zu mir, "
      +capitalize((string)this_player()->QueryProp(P_RACE))+""
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"frau":"")+"?\n");
      break;
    default:
      tell_room(environment(TO), "Fungil sagt: Hi!\n");
    }
  }
  else
  {
    switch(random(3))         
    {
    case 0:
      tell_room(environment(TO), "Fungil sagt: Hallo, wie gehts "
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"Frau":"Herr")+" "
      +capitalize((string)this_player()->QueryProp(P_RACE))+"?\n");
      break;
    case 1:
      tell_room(environment(TO), "Fungil sagt: Sei Gegruesst, "+TPN+"!\n");
      break;
    case 2:
      tell_room(environment(TO), "Fungil sagt: Was fuehrt Dich zu mir, "
      +capitalize((string)this_player()->QueryProp(P_RACE))+""
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"in":"")+"?\n");
      break;
    default:
      tell_room(environment(TO), "Fungil sagt: Hi!\n");
    }
  }
}


// Reaktionen des NPCs

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) 
  {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "floesst Dir neuen Mut ein.",
        "floesst "+TPN+" neuen Mut ein.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "fragt: Worueber aergerst Du Dich?",
        "fragt: Worueber aergert sich "+TPN+"?");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert: Des is jo a lustige Gaudi!",
        "kichert: Des is jo a lustige Gaudi!");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "arglt: Ja, aergere mich nur, "+TPN+"! Immer auf die Kleinen.",
        "arglt: Ja, aergere mich nur, "+TPN+"! Immer auf die Kleinen.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "schreit: Nun werd mal nicht gleich frech!",
        "schreit: Nun werd mal nicht gleich frech, "+TPN+"!");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich froehlich an.", 
        "laechelt "+TPN+" froehlich an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "leuchtet ploetzlich knallrot auf.",
        "leuchtet ploetzlich knallrot auf.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "grinst Dich lieb und froehlich an.",
        "grinst "+TPN+" lieb und froehlich an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TPN+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich mit einem bunten Sporenregen.",
        "troestet "+TPN+" mit einem bunten Sporenregen.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}




void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

