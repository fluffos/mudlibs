// Hier wird gespeichert wer gerade Halron hilft - damit ers auch noch weiss
// nachdem er gekillt wurde
#define QUESTSAVERAUM ROOM "/grotte17.lpc" 
nosave string * hilfehalron;
string belohnunginfo(string key);


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  hilfehalron=({});

  SetProp(P_SHORT, "Halron der Hoehlenforscher");
  SetProp(P_LONG,
    "Halron scheint schon lange in dieser Grotte zu wohnen. Sein langer "
    "Bart haengt ungewaschen bis zu seinen Knien, seine Kleidung ist "
    "zerfetzt und riecht als ob sie noch nie mit Wasser in Beruehrung "
    "gekommen waere. Verwirrt kauert Halron in seiner Nische und stammelt "
    "verruecktes Zeug.");
  SetProp(P_NAME, "Halron");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5,T_RANGE_MAX:10]));
  AddId(({"halron", "zwerg", "hoehlenforscher", "forscher", "QUESTFIFI"}));
  set_living_name("halron");

  create_default_npc(29);
  SetProp(P_HANDS, ({
    " mit seinen ungewaschenen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+100);
  SetProp(P_BODY, QueryProp(P_BODY)+10);
  SetProp(P_XP, QueryProp(P_XP)+3000*100); // Bonus fuer Spells
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 116+random(10));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.3, DT_COLD:     -0.3, DT_WATER:  0.3, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.3,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC: -0.2 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN,   "schlurft herein");
  SetProp(P_MSGOUT,  "schlurft");
  SetProp(P_MMSGIN,  "schlurft herein");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " stirbt mit einem entzetzlichen Schrei.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, 
         "Schaem Dich, wie sollen die anderen Spieler nun die Quest machen?");
  SetProp(P_KILL_NAME,  "Halron der Hoehlenforscher");
  SetProp(P_KILL_MSG,   
         "QuestNPCs greift man nicht ungestraft an, merk Dir das");
  
  SetProp(P_LOG_INFO, "/orw/hquest.log");

// Details des NPCs
  AddDetail( ({"bart"}),
	 "Wie jeder Zwerg hat Halron einen langen Bart.");
  AddDetail( ({"knie","knien"}),
	 "Ja, so lang ist sein Bart!");
  AddDetail( ({"kleidung"}),
	 "Zerfetzt, aber trotzdem scheint sie sehr warm zu sein.");
  AddDetail( ({"beruehrung"}),
	 "Die Kleidung ist wohl noch nie gewaschen worden.");
  AddDetail( ({"zeug"}),
	 "Sprich halt mal mit ihm.");


// Antworten des NPCs
  AddInfo(DEFAULT_INFO, ({
    "sagt irr: Hihihi! Frag mich nicht! Frag mich nicht!\n",
    "verdreht die Augen, sodass man nur noch das Weisse sieht.\n",
    "wird ploetzlich wuetend, beruhigt sich aber sofort wieder.\n",
    "grunzt: Hmm? Frag jemand anders, nicht mich, nicht mich!\n",
    "kichert: Noch nie davon gehoert.\n"}) );
  AddInfo("orw", 
    "Orw ist mein Schoepfer. WUAH! Hihi.","sagt irr: ");

// Standart Infos ueber die Grottentierchen
#include "../grottentierchen_infos.h"


  AddInfo( ({"hilfe","helfen" }),
    "Ich bin Forscher, doch ohne meiner Forschungsausruestung bin ich nicht "
    "einmal die Haelfte wert. Wenn Du mir helfen moechtest waere ich Dir sehr "
    "dankbar. Tippe einfach 'hilf halron' ein und ich erklaere Dir genaueres.",
    "weint: ");
  AddInfo( ({"aufgabe"}),
    "Vor langer Zeit habe ich hier mein Lager aufgeschlagen um die kleinen "
    "Hoehlenkrabbler zu erforschen. Leider bin ich in dieser Aufgabe noch "
    "keinen Schritt weiter gekommen.",
    "sagt: ");
  AddInfo( ({"lager","raum","nische"}),
    "Diese kleine Nische ist seit sehr langer Zeit mein Zuhause. Oh, wie "
    "gern wuerd ich wieder in den ehrwuerdigen Hallen von Felonia wandeln.",
    "arglt: ");
  AddInfo( ({"felonia","zwergenstadt","stadt"}),
    "Ich war schon so lange nicht mehr in Felonia, meine Zwergenbrueder "
    "haben mich bestimmt schon vergessen.",
    "sagt traurig: ");
  AddInfo( ({"zwerge","zwergenbrueder" }),
    "Sooo lange Zeit von Felonia weg, die kennen mich bestimmt nicht mehr!",
    "heult: ");
  AddInfo( ({"zuhause"}),
    "Jetzt ist diese kleine Nische mein Zuhause. Wenigstens ist es hier "
    "trocken.",
    "sagt: ");
  AddInfo( ({"hoehlenkrabbler","krabbler","hoehlentiere","tiere" }),
    "Leider habe ich meine Forschungsausruestung nicht mehr, sonst haette "
    "ich schon einige davon gefangen. Eigentlich bin ich ja nur wegen ihnen "
    "hier.",
    "sagt: ");
  AddInfo( ({"forschungsausruestung","ausruestung" }),
    "Ich habe sie nicht mehr, moechte jetzt aber auch nicht naeher darauf "
