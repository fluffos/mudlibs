//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Halron der Hoehlenforscher
//  Erstellt  : 29.10.2000 (Orw)
//  Geaendert : 01.09.2002 (Woody - Bugfixing)

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
