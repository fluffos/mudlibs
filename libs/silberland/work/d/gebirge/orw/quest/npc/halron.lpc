    "sagt verlegen: ");
  AddInfo( ({"hoehle","grotte" }),
    "Diese Grotte ist so faszinierend, das laesst das Herz eines jeden "
    "Forschers hoeher schlagen.",
    "sagt: ");
  AddInfo( ({"forscher","hoehlenforscher","grottenforscher"}),
    "Ich war der beste Forscher im ganzen Land, aber an dieser Grotte "
    "werde ich noch verzweifeln.",
    "arglt: ");
  AddInfo( ({"land"}),
    "Du weisst gar nicht, dass alles hier um uns herum Silberland heisst?",
    "staunt: ");
  AddInfo( ({"grottenschaender","schaender" }),
    "Ich habe schon mal von solchen Monstern gehoert, aber selbst "
    "noch nie eins gesehen.",
    "sagt: ");
  AddInfo( ({"tentakelmonster","tentakel" }),
    "Hast Du so eins gesehen? Ich moechte keinem Tentakelmonster begegnen!",
    "staunt: ");
  AddInfo( ({"mykal","grottenhirte","hirte" }),
    "Er wacht ueber diese Grotte, leg Dich nicht mit ihm an, er soll "
    "grosse magische und koerperliche Kraefte besitzen.",
    "schaudert: ");
  AddInfo( ({"fungil"}),
    "Fungil ist ein Mykonid. Er ist ganz nett, aber ich traue diesen "
    "Pilzmenschen nicht so recht.",
    "erzaehlt: ");
  AddInfo( ({"mykonid","mykoniden","pilzmenschen","pilzmensch"}),
    "Mykoniden sind ganz aussergewoehnliche Wesen, halb Giftpilz "
    "halb Mensch. Sie verfuegen ueber grosse magische Kraefte.",
    "sagt: ");
  AddInfo( ({"biospelaeologie","spelaeologie" }),
    "Die Lehre der Flora und Fauna in Hoehlen.",
    "sagt: ");
  AddInfo( ({"buecher","buch" }),
    "Ich habe hier die wichtigsten Buecher meiner Sammlung mitgenommen. "
    "Ich brauche sie fuer meine Studien.",
    "sagt: ");
  AddInfo( ({"flora","fauna" }),
    "Ich bin hauptsaechlich an der Flora der Grotte interessiert.",
    "sagt: ");
  AddInfo( ({"feuerstelle","stelle","feuer" }),
    "Auf dieser Feuerstelle koche ich mir meine Mahlzeiten.",
    "sagt: ");
  AddInfo( ({"mahlzeiten","mahlzeit" }),
    "Eine warme Mahlzeit braucht doch jeder.",
    "sagt: ");
  AddInfo( ({"pilz","pilze","giftpilz","giftpilze"}),
    "Pilze gibts in dieser Grotte viele, aber am gefaehrlichsten sind "
    "die Pilzmenschen, auch Mykoniden genannt.",
    "warnt: ");
  AddInfo( ({"kraefte","kraft"}),
    "Mykoniden besitzten grosse magische Kraefte, nimm Dich vor ihnen "
    "in Acht.",
    "warnt: ");
  AddInfo( ({"zwerg","halron" }),
    "Halron, der Zwerg zu Diensten!",
    "verneigt sich: ");
  AddInfo( ({"kleidung","kleider"}),
    "Diese Kleidung habe ich seit ich Felonia verlassen habe, also wundere "
    "Dich nicht, dass sie so zerrissen und schmutzig ist.",
    "sagt: ");
  AddInfo( ({"wasser","quelle" }),
    "Im unteren Teil der Grotte gibt es eine Quelle, aber sei vorsichtig "
    "wenn Du diese Hoehle betrittst. Ich habe schlimme Dinge darueber "
    "gehoert.",
    "warnt: ");
  AddInfo( ({"dinge"}),
    "Naja, man hoert so einiges.",
    "meint: ");
  AddInfo( ({"bart"}),
    "Ich bin sehr stolz auf meinen langen Bart, leider ist er im Moment "
    "sehr ungepflegt. Ich trau mich nicht ihn zu waschen, da ich furchteregende "
    "Dinge ueber die Quelle gehoert habe.",
    "sagt: ");
  AddInfo( ({"moos","moose" }),
    "Moose sind ein idealer Lebensraum fuer viele Hoehlentiere.",
    "sagt: ");
  AddInfo( ({"lebensraum"}),
    "Die Grotte ist der Lebensraum vieler Hoehlentiere.",
    "sagt: ");
  AddInfo( ({"dienste"}),
    "Das ist doch nur eine Begruessungsfloskel.",
    "arglt: ");
  AddInfo( ({"begruessungsfloskel","floskel" }),
    "Bist Du so bloed oder tust Du nur so?",
    "wundert sich: ");
  AddInfo( ({"decken","decke" }),
    "Ohne den Decken waere sogar mir kalt.",
    "stellt fest: ");
  AddInfo( ({"behaelter","pinzette" }),
    "Das gehoerte alles mal zu meiner Ausruestung.",
    "seufzt: ");
  AddInfo( ({"belohnung","questbelohnung","thermoskanne","kanne"}),
    #'belohnunginfo, "sagt: ", 1);



// Chats des NPCs
  SetChats(2, ({
    "Halron grinst verrueckt.\n",
    "Halron kauert sich zitternd in eine Ecke.\n",
    "Halron zwickt Dich.\n",
    "Halron sagt: Ach diese dumme, dumme Aufgabe.\n"}) );
  SetAttackChats(3, ({
    "Halron springt irr Durch den Raum.\n",
    "Der Bart von Halron kraeuselt sich vor Wut.\n",
    "Halron schreit: Haha, Du schaffst mich nie.\n",
    "Halron schreit: Was Du kannst, kann ich auch!\n"}) );

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Halron will @WEN nicht tragen.\n" }) );

// Zaubersprueche
  SetProp(P_SPELLRATE,30);
  AddSpell(2,100+random(100),
    "Halron springt Dir an die Gurgel.\n",
    "Halron springt @WEM an die Gurgel.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,100+random(100),
    "Eine kleine Duftwolke aus Halrons Kleidung verirrt sich in Deine Nase.\n",
    "Eine kleine Duftwolke aus Halrons Kleidung verirrt sich in @WESSEN Nase.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,100+random(100),
    "Halron schaut Dich mit einem irren Blick an.\n",
    "Halron schaut @WEN mit einem irren Blick an.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
     
// Funktionen
  AddCmd( ({ "hilf","helf","helfe" }), "fkthelfen" );
  AddCmd( ({ "ueberreiche","ueberreich" }), "fktueberreichen" );
//  AddCmd( ({ "","" }), "" );
//  AddCmd( ({ "" }), "" );

// Inventory des NPCs
  SUID;
  
  hilfehalron = QUESTSAVERAUM->get_hilfehalron();  
}


// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  write_file(LOG "/questkills.log",
    ctime()+": "+CAP(getuid(PL))+" killt Halron.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    command_me("sage ARGL!");
    write_file(LOG "/questdeads.log",
      ctime()+": Halron hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}

string belohnunginfo(string key)
{
  object kanne;
  if(TP->QueryQuest(HOEHLENQUEST))
  {
    if(present("QUESTKANNE",TP))
    {
      return "Du hast die Belohnung doch schon bekommen!";
    }
    else
    {
      kanne = clone_object(OBJ"/kanne");
      if ( ME_TOO_HEAVY == kanne->move(TP,M_GET|M_SILENT) )
      {
        kanne->remove();
        return "Also bevor ich Dir eine Belohnung geben kann, musst Du "
          "erst mal wieder was nehmen koennen, Du bist ja viel zu "
          "bepackt mit unnuetzem Zeug!";
      }
      else
      {
        write ("Halron gibt Dir eine Thermoskanne.\n");  
        return "Hier ist die Belohnung fuer Deine Muehe. "
               "Diese Thermoskanne hat mir hier unten gute Dienste erwiesen, "
               "ich hoffe Du kannst sie ebensogut gebrauchen wie ich. "
               "Falls Du die Thermoskanne mal verlieren solltest, "
               "kannst Du jederzeit zu mir kommen. Ich geb Dir dann "
               "eine Neue.";
      }
    }
  }
  else
  {
    return "Die Belohnung gibts erst wenn Du mir geholfen hast!";
  }
}

// Begruessung des Spielers
init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}

void hallo() 
{ 
  if (MENV!=ENV(TP)) return;
  if (TP->QueryProp(P_RACE)=="Hobbit")
  {
    switch(random(3))         
    {
    case 0:
      tell_room(environment(TO), "Halron kichert: Hihi, wie gehts "
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"Frau":"Herr")+" "
      +capitalize((string)this_player()->QueryProp(P_RACE))+"?\n");
      break;
    case 1:
      tell_room(environment(TO), "Halron grinst: Ich gruesse Dich, "+TPN+"!\n");
      break;
    case 2:
      tell_room(environment(TO), "Halron murmelt: Was machst Du hier, "
      +capitalize((string)this_player()->QueryProp(P_RACE))+""
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"frau":"")+"?\n");
      break;
    default:
      tell_room(environment(TO), "Halron sagt: Hi!\n");
    }
  }
  else
  {
    switch(random(3))         
    {
    case 0:
      tell_room(environment(TO), "Halron kichert: Hihi, wie gehts "
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"Frau":"Herr")+" "
      +capitalize((string)this_player()->QueryProp(P_RACE))+"?\n");
      break;
    case 1:
      tell_room(environment(TO), "Halron grinst: Ich gruesse Dich, "+TPN+"!\n");
      break;
    case 2:
      tell_room(environment(TO), "Halron murmelt: Was machst Du hier, "
      +capitalize((string)this_player()->QueryProp(P_RACE))+""
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"in":"")+"?\n");
      break;
    default:
      tell_room(environment(TO), "Halron sagt: Hi!\n");
    }
  }
}


// Reaktionen des NPCs
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) 
  {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "floesst Dir neuen Mut ein.",
        "floesst "+TPN+" neuen Mut ein.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "fragt: Worueber aergerst Du Dich?",
        "fragt: Worueber aergert sich "+TPN+"?");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert: Ich hatte schon lang keinen Spass mehr!",
        "kichert: Ich hatte schon lang keinen Spass mehr!");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "tritt Dich in den Hintern.",
        "tritt "+TPN+" in den Hintern.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "wird bald richtig wuetend.",
        "wird bald richtig wuetend.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich froehlich an.", 
        "laechelt "+TPN+" froehlich an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "hat keine Verwendung fuer Deine Zaertlichkeiten.",
        "hat keine Verwendung fuer die Zaertlichkeiten von "+TPN+".");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "grinst Dich lustig an.",
        "grinst "+TPN+" lustig an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TPN+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}




void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


fkthelfen(string str)
{
  notify_fail("Wem willst Du helfen?\n");
// Abfrage ob Quest schon gemacht
  if ( TP->QueryQuest(HOEHLENQUEST) )
  {
    tell_object(TP,
      "Halron kichert: Du hast mir doch schon geholfen, Du Dummerchen!\n");
    return 1;
  }
// Abfrage ob Quest schon begonnen
  if ( -1!=member( ({"halron","zwerg","hoehlenforscher","forscher"}),str) )
  {
    if ( -1!=member(hilfehalron,getuid(TP)) )
    {
      tell_object(TP,
        "Halron arglt: Du hilfst mir doch schon!\n");
      return 1;
    }
// Die Quest beginnt
    tell_object(TP,
      "\n"
      "Halron meint: Soso, Du willst also einem alten Zwerg aus der Patsche helfen.\n"
      "Halron meint: Dann erzaehle ich Dir mal worum es eigentlich genau geht:\n"
      "Halron kichert irr: Vor langer Zeit bin ich aus Felonia ausgezogen um diese\n"
      "Halron kichert irr: Grotte zu erforschen. Ein wirklich magischer Ort, wie Du\n"
      "Halron kichert irr: bald feststellen wirst. Ich habe meinen Liebsten lebwohl\n"
      "Halron kichert irr: gesagt und wollte baldigst mit einigen gefangenen\n"
      "Halron kichert irr: Tierchen in mein Heim zurueckkehren, um sie zu studieren...\n"
      );
    call_out("queststart",10);
    return 1;
  }
}

int queststart()
{
  object PERGAMENT;	
  if( MENV!=ENV(TP) ) 
  {
    write("Halron teilt Dir mit: He, wieso gehst Du davon wenn ich mit Dir\n"
          "Halron teilt Dir mit: rede?\n");
    return 1;
  }
  tell_object(TP,
    "Halron schaudert: Doch ich bin zu weit in das Gebiet von Mykal, dem\n"
    "Halron schaudert: Grottenhirten eingedrungen, welcher mir meine Ausruestung\n"
    "Halron schaudert: weggenommen hat. Ohne die gefangenen Tierchen kann\n"
    "Halron schaudert: ich nicht mehr zurueckkehren. Jeder Zwerg wuerde\n"
    "Halron schaudert: mich auslachen. Bitte hilf mir die Tierchen zu fangen!\n");
    
  if(!present("QUESTZETTELDINGS",TP))
  {
    PERGAMENT = clone_object(OBJ"/pergament");
    if ( ME_TOO_HEAVY == PERGAMENT->move(TP,M_GET|M_SILENT) )
    {
      PERGAMENT->remove();
      tell_object(TP,
          break_string( "Ich wuerde Dir ja jetzt gern ein wichtiges Pergament "
            "geben, aber leider bist Du viel zu bepackt mit unnuetzem Zeug! "
            "Leg erst mal ab und frag mich dann nochmal!",
            78, "Halron sagt: " ) );
      return 1;
    }
    tell_object(TP,
      "Halron sagt: Hier, ich gebe Dir ein Pergament auf dem ich alles was Du\n"
      "Halron sagt: zu wissen brauchst aufgeschrieben habe.\n"
      "Halron gibt Dir ein zerfleddertes Pergament.\n");  
  }   
  tell_room(environment(this_player()),
    TP->Name()+" und Halron tuscheln irgendetwas Unverstaendliches.\n",
    ({ TP }) );
  hilfehalron+=({getuid(TP)});
  QUESTSAVERAUM->set_hilfehalron(hilfehalron);
  return 1;
}

int fktueberreichen(string str) 
{
  object questlandbehaelter;
  object questwasserbehaelter;
  object questfangpinzette;
  object questpergament;
  int fertig;
  notify_fail("Was willst Du ueberreichen?\n");
  if(!str) return 0;
// Diverse Questabfragen
  if(str == "ausruestung" ||
     str == "halron die ausruestung" ||
     str == "halron ausruestung" ||
     str == "halron seine ausruestung")
  {
  if(TP->QueryQuest(HOEHLENQUEST)) 
  {
    write(BS(
      "Halron sagt: Aber Du hast mir Doch schon geholfen!\n"));
    return 1;
  }
  if(!present("LANDBEH",TP)) 
  {
    write(BS(
      "Halron sagt: Du hast meine Ausruestung ja noch gar nicht!\n"));
    return 1;
  }
  if(!present("LANDBEHVOLL",TP)) 
  {
    write(BS(
      "Halron sagt: Bevor Du mir die Ausruestung zurueckgibst, musst Du\n"
      "Halron sagt: beide Behaelter mit Tierchen fuellen.\n"));
    return 1;
  }
  if(!present("WASSERBEHVOLL",TP)) 
  {
    write(BS(
      "Halron sagt: Bevor Du mir die Ausruestung zurueckgibst, musst Du\n"
      "Halron sagt: beide Behaelter mit Tierchen fuellen.\n"));
    return 1;
  }  
  if(!present("FANGPINZETTE",TP)) 
  {
    write(BS(
      "Halron schreit: Was hast Du mit der Pinzette gemacht?\n"
      "Halron schreit: Du muesstest sie eigentlich haben, benachrichtige\n"
      "Halron schreit: Orw oder einen Regionsmagier des Gebirges.\n"));
    return 1;
  }
// Quest geschafft
  fertig = TP->GiveQuest(HOEHLENQUEST);
  if ( fertig==1 )
  {
    tell_object(TP,
      "Halron huepft vergnuegt herum.\n"
      "Halron freut sich: VIELEN DANK! Du hast mir sehr geholfen!.\n"
      "Halron freut sich: Ich habe auch eine Belohnung fuer Dich, wenn Du sie\n"
      "Halron freut sich: haben willst, dann frag mich einfach danach.\n"
      "Halron nimmt seine Ausruestung zurueck und laechelt Dich gluecklich an.\n");       
    write_file(HOEHLENQUESTLOG,sprintf ("%s: %s hat Halrons Ehre gerettet.\n",
      dtime(time()), capitalize(TP->query_real_name())) );
    if(questfangpinzette=present("FANGPINZETTE",TP)) questfangpinzette->remove();
    if(questwasserbehaelter=present("WASSERBEHVOLL",TP)) questwasserbehaelter->remove();
    if(questlandbehaelter=present("LANDBEHVOLL",TP)) questlandbehaelter->remove();
    if(questpergament=present("QUESTZETTELDINGS",TP)) questpergament->remove();
    hilfehalron-=({getuid(TP)});
    QUESTSAVERAUM->set_hilfehalron(hilfehalron);
    return 1;
  }
  else if( fertig!=-1)
  {
    write (sprintf("Unbekannter Fehler, bitte Orw oder zustaendigen Regionsmagier "+
                   "verstaendigen!\nFehlercode: %d\n", fertig));
    return 1;
  }  
  }
}



