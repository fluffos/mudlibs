//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Abendsegler
//  Erstellt  : 24.10.2000 (Orw)
//  Geaendert : -


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  
  
  AddId (({"abendsegler","tierchen","glattnase","segler","nase"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME,  "Abendsegler");
  SetProp (P_SHORT, "Ein Abendsegler");
  SetProp (P_LONG,
	"Der Abendsegler gehoert zur Fledermaussippe der Glattnasen. "
	"Wie ihr Name sagt, tragen die Glattnasen keine besonderen "
	"Nasenaufsaetze oder sonstigen Hautgebilde am Kopf. Dafuer sind "
	"ihre Ohren im allgemeinen ziemlich gross und weisen in ihrem "
	"Zentrum, die Ohroeffnung ueberragend, einen sogenannten Ohrdeckel "
	"auf, der wahrscheinlich fuer das Richtungshoeren bedeutsam ist. "
	"Der Abendsegler besitzt lange, schmale Fluegel und ist dadurch "
	"ein rassiger, schneller Flieger.");
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_RACE, "Fledermaus");
  SetProp (P_HANDS, ({" mit seinen Zaehnchen ", 30, DT_PIERCE}) );
  SetProp (P_SIZE, 7+random(3));
  SetProp (P_HEAL,2);
  SetProp (P_ALIGN, -20-random(200));
  
  SetProp(P_MSGIN,   "flattert herein");
  SetProp(P_MSGOUT,  "flattert");
  SetProp(P_MMSGIN,  "flattert herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "/hain1");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);


  SUID;
  create_default_npc(3+random(4));
  
  SetProp(P_SPELLRATE,20);
  AddSpell(1,30+random(20),
    "Der Abendsegler beisst Dir ins Gesicht.\n",
    "Der Abendsegler beisst @WEM ins Gesicht.\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]));
    
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Abendsegler kann @WEN gar nicht tragen.\n" }) );

  SetChats(1, ({
	"Der Abendsegler flattert aufgeschreckt herum.\n",
	"Der Abendsegler umkreist Dich.\n",
	"Mit schnellen Fluegelschlaegen fliegt der Abendsegler "
	"ueber Dich hinweg.\n"}));
  AddInfo (DEFAULT_INFO, "wuerdigt Dich keines Blickes.\n");
  SetProp (P_DIE_MSG, " faellt toetlich getroffen zu Boden.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");
  
}

// Reaktionen auf den Spieler

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schaut einfach weg.",
        "schaut einfach weg.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "zeigt Dir seine Zaehnchen.",
        "zeigt "+TPN+" seine Zaehnchen.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "flattert aufgeregt.",
        "flattert aufgeregt.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "fletscht seine Zaehnchen.",
        "fletscht seine Zaehnchen.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "guckt Dich komisch an.", 
        "guckt "+TPN+" komisch an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "wackelt mit seinen Ohren.",
        "wackelt mit seinen Ohren.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "quitscht Dich vergnuegt an.",
        "quitscht "+TPN+" vergnuegt an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TPN+" gar nicht.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schenkt Dir einen troestenden Blick.",
        "schenkt "+TPN+" einen troestenden Blick.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

