//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Doppelschwanz
//  Erstellt  : 24.10.2000 (Orw)
//  Geaendert : -


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int gefangene_landtiere;

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"doppelschwanz", "tierchen", "insekt", "LANDTIERCHEN"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME,  "Doppelschwanz");
  SetProp (P_SHORT, "Ein Doppelschwanz");
  SetProp (P_LONG,
	"Doppelschwaenze ernaehren sich von organischen Resten, "
	"Pilzfaeden, manche Arten sind raeuberisch und fressen Wuermer "
	"und Insektenlarven. Raeuberische Arten lokalisieren ihre Beute "
	"zunaechst mit den Antennen, beissen sie und packen sie "
	"anschliessend mit den zangenfoermigen Cerci, indem der "
	"Hinterleib skorpionsartig ueber den Kopf gebogen wird. Die "
	"Beute wird dann solange hin und her geschleift, bis sie tot "
	"ist.");
  AddDetail("schwanz",
        "Schwanz? Doch wohl eher Doppelschwanz, das ist ein Insekt!");

  create_default_npc(6);

  SetProp (P_ARTICLE, 1);
  SetProp (P_ALIGN, -10);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit seinen Beinchen  ", 30, DT_MAGIC}) );
  SetProp (P_SIZE, 1+random(2));

  SUID;

  SetChats(1, ({
	"Der Doppelschwanz versteckt sich hinter einem Pilz.\n",
	"Der Doppelschwanz sucht Nahrung.\n"}));

  SetProp (P_DIE_MSG, " wird nie wieder froehlich herumkriechen.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Doppelschwanz kann @WEN gar nicht tragen.\n" }) );
    
  SetProp(P_MSGIN,   "kriecht herein");
  SetProp(P_MSGOUT,  "kriecht");
  SetProp(P_MMSGIN,  "kriecht herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  
  
  AddCmd( ({"fange","fang"}), "fktfange");    

}

int fktfange(string str)
{
  object key;
  gefangene_landtiere=sizeof(filter_objects(all_inventory(this_player()),"id","LANDTIERCHENGEF"));
  notify_fail("Was willst Du womit fangen?\n");
  if( !str ) return 0;
  if( !key=present("FANGPINZETTE", this_player()) )
  {
    write("Du hast nicht das geeignete Werkzeug um den Doppelschwanz zu fangen.\n");
    return 1;
  }
  if(gefangene_landtiere==3)
  {
    write("Du hast schon genuegend Landtierchen gefangen.\n");
    return 1;
  }
  if(present("DOPPELSCHWANZGEF", this_player()) )
  {
    write("Du hast doch schon einen Doppelschwanz gefangen.\n");
    return 1;	
  }
  if(present("LANDBEHVOLL", this_player()) )
  {
    write("Du hast doch schon drei Landtierchen im Behaelter.\n");
    return 1;	
  }
  if( str=="doppelschwanz mit pinzette" ||
      str=="insekt mit pinzette" ||
      str=="tierchen mit pinzette" )
  {
    write("Geschickt faengst Du den Doppelschwanz mit der Pinzette.\n");
    say( CAP_TPN+" faengt geschickt einen Doppelschwanz.\n", ({this_player()}) );
    CLONE( OBJ "/schwanzobj", this_player());
    this_object()->remove();
    return 1;
  }
  if( str=="schwanz mit pinzette" ||
      str=="schwanz")
  {
    if(this_player()->QueryProp(P_GENDER, MALE))
    {
      write("Du fummelst an Deiner Hose herum, erwischst ihn aber nicht. :)\n");
      say  (CAP_TPN+" fummelt mit einer Pinzette an der Hose herum.\n",TP);
      return 1;
    }
    else
    {
      write("Schwanz? Doch wohl eher Doppelschwanz!\n");
      return 1;
    }
  }
  else 
    return 0;
}
