//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Ein Grottenschaender
//  Erstellt  : 30.10.2000 (Orw)
//  Geaendert : -

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"


void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Grottenschaender");
  SetProp(P_LONG,
    "Der Grottenschaender sieht furchteregend aus, gluehende rote Augen, "
    "kleine scharfe Zaehne und riesige Klauen an seinen Vorderbeinen. "
    "Sein borstiges Fell ist mit ekelhaftem Schleim verklebt und stinkt "
    "so arg, dass man den Gestank beinahe sehen kann. Brauner Sabber "
    "laeuft aus seinem Maul, waehrend er Dich hungrig ansieht.");
  SetProp(P_NAME, "Grottenschaender");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5,T_RANGE_MAX:10]));
  AddId(({"grottenschaender", "schaender", "monster"}));
  set_living_name("grottenschaender");

  create_default_npc(20);
  SetProp(P_HANDS, ({
    " mit seinen grausigen Klauen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+random(50));
  SetProp(P_BODY, QueryProp(P_BODY)+10);
  SetProp(P_XP, QueryProp(P_XP)+2000*100); // Bonus fuer Spells
  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 157+random(20));
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 17);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC, 50);

  SetProp(P_MSGIN,   "erscheint vor Deinen Augen");
  SetProp(P_MSGOUT,  "kriecht");
  SetProp(P_MMSGIN,  "erscheint wie aus dem Nichts");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " wird nie wieder Grotten schaenden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, 
         "Ich wollte doch noch ein paar Hoehlentierchen quaelen.");
  SetProp(P_KILL_NAME,  "Ein Grottenschaender");
  SetProp(P_KILL_MSG,   
         "AAAAAAAAHHHH Elender, das hast Du davon!");
  

// Details des NPCs

  AddDetail( ({"augen"}),
	 "Sie gluehen dunkelrot.");
  AddDetail( ({"zaehne","zahn"}),
	 "Klein, aber messerscharf!");
  AddDetail( ({"klauen","klaue","beine","vorderbeine",
               "vorderbeinen","beinen"}),
	 "Riesige grauenhafte Klauen!");
  AddDetail( ({"fell","schleim"}),
	 "Sein Fell ist mit ekelhaftem Schleim verklebt.");
  AddDetail( ({"gestank"}),
	 "Puh, riecht das Monster arg.");
  AddDetail( ({"sabber","maul"}),
	 "IGITT, braeunlicher Sabber laeuft aus dem Maul des "
	 "Grottenschaenders.");


// Antworten des NPCs

  AddInfo(DEFAULT_INFO, ({
    "versteht Dich nicht.\n",
    "richtet sich zum Angriff etwas auf.\n",
    "schaut Dich verstaendnislos an.\n",
    "grunzt: MPFGRRRRH GRRRRR GORGLOM!\n",
    "guckt boese.\n"}) );
  AddInfo("orw", 
    "Orw ist mein Schoepfer.","grunzt: ");

  SetChats(2, ({
    "Sabber tropft aus dem Maul des Grottenschaenders.\n",
    "Der Grottenschaender mampft einen kleinen Pilz.\n",
    "Der Grottenschaender grunzt wild.\n",
    "Das Fell des Grottenschaenders verbreitet einen "
    "unangenehmen Geruch.\n"}) );
  SetAttackChats(3, ({
    "Der Grottenschaender rotiert wild mit seinen Klauen.\n",
    "Der Grottenschaender grunzt laut.\n",
    "Sabber tropft aus dem weit aufgerissenen Maul des "
    "Grottenschaenders.\n"}) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Grottenschaender will @WEN nicht tragen.\n" }) );

// Zaubersprueche

  SetProp(P_SPELLRATE,30);
  AddSpell(2,200+random(100),
    "Der Grottenschaender bruellt Dich an.\n",
    "Der Grottenschaender bruellt @WEN an.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,200+random(75),
    "Der Grottenschaender piekst Dich mit seinen Borsten.\n",
    "Der Grottenschaender piekst @WEN mit seinen Borsten.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,200+random(50),
    "Der Grottenschaender sabbert Dich an.\n",
    "Der Grottenschaender sabbert @WEN an.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME(OBJ "/bueschel" );
  "/obj/gemmaster"->DistributeGem(1,2,1,1);
  
}

// Defend Funktion

Defend(int dam, string dtype, int spell, object enemy)    
{
  if (!pointerp(dtype))
      dtype = ({ dtype });


  if (sizeof(dtype & ({ DT_ACID }) ))
  {
    heal_self(dam);	
    tell_room(environment(), 
      "Der Grottenschaender heilt sich durch die Saeure.\n");
    return ::Defend(0, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_POISON }) ))
  {
    heal_self(dam);	
    tell_room(environment(), 
      "Der Grottenschaender heilt sich durch das Gift.\n");
    return ::Defend(0, dtype, spell, enemy);
  }


  return ::Defend(dam, dtype, spell, enemy);    
}


// Funktionen der Zaubersprueche




// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) 
{
  write_file(LOG "/questkills.log",
    ctime()+": "+CAP(getuid(PL))+" killt den Grottenschaender.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
    command_me("ruelpse");
    write_file(LOG "/questdeads.log",
      ctime()+": Der Grottenschaender hat gerade "+CAP(getuid(player))+
              " umgebracht.\n");
}


// Reaktionen des NPCs

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) 
  {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "funkelt zufrieden mit seinen gluehenden Augen.",
        "funkelt zufrieden mit seinen gluehenden Augen.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grunzt Dich an.",
        "grunzt "+TPN+" an.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "fletscht seine Zaehne.",
        "fletscht seine Zaehne.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "beisst Dich.",
        "beisst "+TPN+".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "wird bald richtig wuetend.",
        "wird bald richtig wuetend.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "schaut Dich aergerlich an.", 
        "schaut "+TPN+" aergerlich an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "wird wahnsinnig vor Wut.",
        "wird wahnsinnig vor Wut.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TPN+" gar nicht.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet "+TPN+" gar nicht.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "grinst Dich gemein an.",
        "grinst "+TPN+" gemein an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}




void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

