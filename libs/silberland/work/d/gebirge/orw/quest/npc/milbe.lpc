//  Projekt   : Die Hoehlenforscherquest
//  NPC Name  : Wassermilbe
//  Erstellt  : 24.10.2000 (Orw)
//  Geaendert : -


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int gefangene_wassertierchen;

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"wassermilbe", "tierchen", "milbe","insekt","WASSERTIERCHEN"}));
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME,  "Wassermilbe");
  SetProp (P_SHORT, "Eine Wassermilbe");
  SetProp (P_LONG,
	"Die Wassermilbe lebt im Schlamm, Wasser, Pfuetzen "
	"oder feuchten Hoehlenteilen. Fast alle Wassermilben sind Raeuber "
	"oder Parasiten. Die schwimmenden Raeuber durchstossen, wie ihre "
	"auf dem Land lebenden Verwandten, mit ihren Cheliceren die "
	"Koerper ihrer Opfer - Insektenlarven, Kleinkrebse, Wuermer oder "
	"weichhaeutige andere Milben - und saugen sie aus.");

  create_default_npc(2);

  SetProp (P_ARTICLE, 1);
  SetProp (P_ALIGN, 5);
  SetProp (P_MAX_HANDS, 6);
  SetProp (P_HANDS, ({" mit ihren Cheliceren  ", 30, DT_MAGIC}) );
  SetProp (P_SIZE, 1);

  SUID;

  SetChats(1, ({
	"Die Milbe kriecht im Wasser herum.\n",
	"Die Wassermilbe sucht Nahrung.\n"}));

  SetProp (P_DIE_MSG, " wird nie wieder froehlich herumkriechen.\n");
  SetProp (P_DEFAULT_INFO, "versteht Dich nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Wassermilbe kann @WEN gar nicht tragen.\n" }) );
    
  SetProp(P_MSGIN,   "kriecht herein");
  SetProp(P_MSGOUT,  "kriecht");
  SetProp(P_MMSGIN,  "kriecht herein");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  
  
  AddCmd( ({"fange","fang"}), "fktfange");    

}

int fktfange(string str)
{
  object key;
  gefangene_wassertierchen=sizeof(filter_objects(all_inventory(this_player()),"id","WASSERTIERCHENGEF"));
  notify_fail("Was willst Du womit fangen?\n");
  if( !str ) return 0;
  if( !key=present("FANGPINZETTE", this_player()) )
  {
    write("Du hast nicht das geeignete Werkzeug um die Milbe zu fangen.\n");
    return 1;
  }
  if(gefangene_wassertierchen==3)
  {
    write("Du hast schon genuegend Wassertierchen gefangen.\n");
    return 1;
  }  
  if(present("WASSERMILBEGEF", this_player()) )
  {
    write("Du hast doch schon eine Wassermilbe gefangen.\n");
    return 1;	
  }
  if(present("WASSERBEHVOLL", this_player()) )
  {
    write("Du hast doch schon drei Wassertierchen im Behaelter.\n");
    return 1;	
  }
  if( str=="milbe mit pinzette" ||
      str=="wassermilbe mit pinzette" ||
      str=="insekt mit pinzette" ||
      str=="tierchen mit pinzette" )
  {
    write("Geschickt faengst Du die Wassermilbe mit der Pinzette.\n");
    say( CAP_TPN+" faengt geschickt eine Wassermilbe.\n", ({this_player()}) );
    CLONE( OBJ "/milbeobj", this_player());
    this_object()->remove();
    return 1;
  }
  else 
    return 0;
}
