//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Ein Bueschel Grottenschaenderborsten
//  Erstellt    : 01.03.2001 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <material.h>
#include "../def.h"

int counter;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Bueschel Grottenschaenderborsten");
  SetProp(P_LONG,
	  "Das Bueschel Grottenschaenderborsten ist mit ekelhaftem "
	  "Schleim verklebt und stinkt so arg, dass man den Gestank "
	  "beinahe sehen kann. Du hoffst es bald los zu werden." );
  SetProp(P_INFO, 
          "Dieses Bueschel wird nach einiger Zeit wieder unsichtbar "
          "und verschwindet. Also ueberleg nicht lang und benutze "
          "es.");
  SetProp(P_NAME, "Bueschel Grottenschaenderborsten");
  SetProp(P_GENDER, NEUTER);
  AddId(({"grottenschaenderborsten", "schaenderborsten", "borsten", 
          "bueschel", "fell", "haare", "haar","QUESTBUESCHELFELL"}));

  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  
  counter=0;
}


reset() 
{ ::reset();
  if(counter==1)
  {
    call_out("remove_me",0);
  }
  counter++;
}

remove_me()
{
  write("Das Bueschel Grottenschaenderborsten wird unsichtbar und "
        "loest sich in Luft auf.\n");
  remove();
}