//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Aaskaefer (gefangen)
//  Erstellt    : 24.10.2000 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Aaskaefer");
  SetProp (P_LONG,
	"Du haeltst einen gefangenen Aaskaefer in Deinen Haenden. "
	"Du bist besonders vorsichtig um ihn nicht zu verletzen. "
	"Er lebt normalerweise im Moos und an feuchten Felswaenden.");
  SetProp(P_NAME, "Aaskaefer");
  SetProp(P_GENDER, MALE);
  
  AddId (({"aaskaefer", "tierchen", "kaefer","insekt","AASKAEFERGEF",
           "LANDTIERCHENGEF"}));

  SetProp(P_MATERIAL, MAT_MISC_LIVING );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}
