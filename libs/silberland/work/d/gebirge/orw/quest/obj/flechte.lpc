//  Projekt   : Die Hoehlenforscherquest
//  Food Name : Eine Flechte (verschiedene Farben)
//  Erstellt  : 01.03.2001 (Orw)
//  Geaendert : -

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

#define FARBE ({ "dunkelgruen","hellgruen","gruen","dunkelbraun", \
                 "hellbraun","braun","violett","glitzernd", \
		 "dunkelrot","kaminrot","schwarz","weiss" })
int color;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  color=random(11);

  SetProp(P_SHORT, "Eine "+FARBE[color]+"e Flechte");
  SetProp(P_LONG,
	  "In Deinen Haenden haeltst Du eine appetitlich aussehende "
	  ""+FARBE[color]+"e Flechte, welche nur in den tiefsten Hoehlen "
	  "des Gebirges waechst.");
  SetProp(P_NAME, "Flechte");
  SetProp(P_GENDER, FEMALE);
  AddId(({"flechte", "pflanze"}));
  SetProp(P_NAME_ADJ,FARBE[color]);
  AddAdjective(({FARBE[color],FARBE[color]+"e"}));
  SetProp(P_WEIGHT, 10+random(6));
  SetProp(P_VALUE, 10);
  SetProp(P_FOOD_INFO, ([F_HEAL : ({20, 10}), F_SOAK : 5]));
}

void BeimEssen()
{
  write("Du mampfst genuesslich die Flechte.\n");
  say(this_player()->name()+" isst die Flechte.\n");
}
