//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Pinzette
//  Erstellt    : 24.10.2000 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Pinzette");
  SetProp(P_LONG,
	  "Mit dieser Pinzette kann man kleine Hoehlentiere fangen, "
	  "ohne sie zu verletzen." );
  SetProp(P_INFO, "Sie gehoerte einmal Halron dem Hoehlenforscher.");
  SetProp(P_NAME, "Pinzette");
  SetProp(P_GENDER, FEMALE);
  AddId(({"pinzette","FANGPINZETTE"}));

  SetProp(P_MATERIAL, MAT_MISC_METAL );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}
