//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Ein zerfleddertes Pergament
//  Erstellt    : 03.03.2001 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <defines.h>
#include <material.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein zerfleddertes Pergament");
  SetProp(P_LONG,
          "\n"
          "Lieber Hobbyforscher!\n"
          "\n"          
	  "Als erstes musst Du versuchen die Ausruestung von Mykal zurueck "
	  "zu erlangen. Bei der Forschungsausruestung sind unter anderem "
	  "auch Behaelter in denen Du die gefangenen Tierchen aufbewahren "
	  "musst. Fange drei Land- sowie drei Wassertierchen und steck sie in "
	  "die jeweiligen Behaelter. Komm dann zu mir und ueberreiche mir die "
	  "komplette Ausruestung.\n"
	  "\n"
	  "Gezeichnet,\n"
	  "Halron der Hoehlenforscher" );
  SetProp(P_NAME, "Pergament");
  SetProp(P_GENDER, NEUTER);
  AddId(({"pergament","QUESTZETTELDINGS"}));

  SetProp(P_MATERIAL, MAT_PERGAMENT );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}
