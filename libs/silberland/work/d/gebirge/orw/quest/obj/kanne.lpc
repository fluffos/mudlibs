//  Projekt   : Die Hoehlenforscherquest
//  Objekt    : Questbelohnung (Eine Thermoskanne)
//  Erstellt  : 02.07.2001 (Orw)
//  Info      : Die Kanne kann in Raeumen die eines der Details 
//              "wasser","quelle","bach","see","fluss" 
//              enthalten mit Wasser befuellt werden.
//              In Raeumen welche bei query_drink() einen Wert ungleich 0
//              zurueckgeben (/std/pub.c) kann man Getraenke die dort
//              mit AddDrink eingefuegt wurden in die Kanne fuellen.
//              Pro Reset nur eine Befuellung moeglich.
//  31.01.2003: Bugfix, nun kann ma nichtsmehr einfuellen wenn der 
//              Wirt nicht da ist

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int    getrunken;      // Aktuelle Saettigung des Spielers
int    kann_trinken;   // Maximale Saettigung des Spielers
int    besoffen;       // Aktueller Alkoholgehalt des Spielers
int    max_besoffen;   // Maximaler Alkoholgehalt des Spielers
int    wassergefuellt; // 1 wenn Kanne mit Wasser gefuellt ist
int    pubgefuellt;    // 1 wenn Kanne mit PubGetraenk gefuellt ist
int    lp_heilung;     // LP-Heilung des Getraenks
int    mp_heilung;     // MP-Heilung des Getraenks
int    r_heilung;      // random-Wert der auf LPs/MPs aufgeteilt wird
int    saettigung;     // Saettigung des Getraenks
int    alcohol;        // Alkoholgehalt des Getraenks
int    preis;          // Der Preis des Getraenks
int    fuellcounter;   // pro Reset nur einmal anfuellen
int    wasserzaehler;  // pro Reset 5 mal anfuellen
string getraenk;       // Name des Getraenks
string *getraenk_ids;  // Array mit den IDs des Getraenks


create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Thermoskanne");
  SetProp(P_LONG,
	  "In Deinen Haenden haeltst Du eine huebsche Thermoskanne. "
	  "Du hast sie von Halron dem Hoehlenforscher bekommen, fuer "
	  "Deine grossartige Hilfe bei seinen Forschungsarbeiten.");
  SetProp(P_NAME, "Thermoskanne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, 
          "In die Thermoskanne kann man Wasser oder Getraenke aus Kneipen "
          "fuellen, um es dann spaeter zu trinken.\n"
          "Falls Du sie mal nicht mehr willst/brauchst/magst kannst "
	  "Du sie zerbrechen.");
  AddId(({"thermoskanne","kanne","QUESTKANNE"}));

  SetProp(P_MATERIAL, ([MAT_CERAMIC:70,MAT_GLASS:20,MAT_MISC_MAGIC:10]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  AddCmd(({"fuelle","fuell"}),"fktfuellen");
    wassergefuellt = 0;
    wasserzaehler  = 0;
    pubgefuellt    = 0;
    fuellcounter   = 0;
  AddCmd(({"trinke","trink"}),"fkttrinken");
  AddCmd(({"zerbreche","zerbrich"}),"fktzerbrechen");
}

int fktfuellen(string str)
{
  object raum;
  string was, womit;
  int i, gefunden, nr;
  mixed *drink;
  raum = ENV(TP);
  notify_fail("Was willst Du womit fuellen?\n");
  if(!str) return 0;
  if(wassergefuellt || pubgefuellt)
  {
    write("Deine Thermoskanne ist bereits mit '"+CAP(getraenk)+"' "
          "gefuellt.\n");
    return 1;
  }
  if(fuellcounter)
  {
    write("Du musst noch warten, bis Du Deine Kanne wieder anfuellen "
          "kannst.\n");
    return 1;
  }
  if(!(raum->query_drink()))
  {
    if(str=="thermoskanne mit wasser" ||
       str=="kanne mit wasser" ||
       str=="wasser in thermoskanne" ||
       str=="wasser in kanne")
    {
      if (member(raum->QueryProp(P_DETAILS), "wasser")  ||
          member(raum->QueryProp(P_DETAILS), "quelle")  ||
          member(raum->QueryProp(P_DETAILS), "bach")    ||
          member(raum->QueryProp(P_DETAILS), "see")     ||
          member(raum->QueryProp(P_DETAILS), "fluss")   ||
          member(({TT_WATER,TT_UNDERWATER}),
            raum->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN])!=-1) 
      {
        write("Du fuellst die Thermoskanne mit Wasser.\n");
        say(TPN+" fuellt eine Thermoskanne mit Wasser.\n");
        wassergefuellt = 1;
        wasserzaehler++;
        lp_heilung     = 6+random(5);
        mp_heilung     = 0;
        saettigung     = 4;
        alcohol        = 0;
        if(wasserzaehler>3)
        {
          fuellcounter   = 1;
        }
        getraenk       = "wasser";
        getraenk_ids   = ({"wasser"});
        AddProp(P_LONG, "In die Kanne hast Du '"+CAP(getraenk)+"' "
                        "gefuellt.");
        AddProp(P_SHORT, " (gefuellt)");
        SetProp(P_WEIGHT, 500);
        return 1;
      }
      else
      {
        write("Hier siehst Du kein Wasser...\n");
        return 1;
      } 
    }
    else
    {
      write(BS("Du bist hier in keiner Kneipe und kannst deshalb Deine Kanne "
            "nur mit Wasser fuellen. Falls es hier Wasser gibt..."));
      return 1;
    }
  }
  else
  {
    if(sscanf(str, "%s mit %s", was, womit) ||
       sscanf(str, "%s in %s", womit, was))
    {
      if(was=="thermoskanne" || was=="kanne")
      {
        drink    = raum->query_drink();
        gefunden = 0;
        for (i=0; i<sizeof(drink); i++)
        {
          if(member(drink[i][1], womit)!=-1) 
          {
            gefunden++;
            nr = i;
          }
        }
        if(gefunden>1)
        {
          write(BS("Es gibt hier mehrere Getraenke, die "+CAP(womit)+" im "
                "Namen haben, oder von der gleichen Sorte sind. "
                "Gib bitte den genauen Namen des Getraenks an."));
          return 1;
        }
        if(gefunden)
        {
          //preis = drink[nr][2];
          preis = ENV(TP)->QueryDrink(drink[nr][0])[8];

          if (preis <= 0) preis = 1000000;

          if(stringp(drink[nr][6]))
          {
            write(BS(drink[nr][0]+" ist ein Spezialgetraenk, das Deine "
                     "Thermoskanne moeglicherweise zerstoeren koennte, "
                     "deshalb fuellst Du dieses Getraenk lieber nicht rein."));
            return 1;            
          }
          if(preis>(TP->QueryMoney()))
          {
            write(BS(drink[nr][0]+" kostet "+preis+" Muenzen, Du hast aber "
                  "nur "+TP->QueryMoney()+" bei Dir!"));
            return 1;
          }
          else
          {
            if (!ENV(TP)->CheckKeeper(TP))
              return 1;
            if (ENV(TP)->query_ban(getuid(TP), 1))
              {
                ENV(TP)->ban_msg(TP);
                return 1;
              }


            TP->AddMoney(-preis);
            write(BS("Du fuellst Deine Kanne mit '"+drink[nr][0]+"' und "
                  "bezahlst die "+preis+" Muenzen."));
            say(TPN+" fuellt eine Thermoskanne mit '"+drink[nr][0]+"'.\n");
            pubgefuellt = 1;
            getraenk_ids   = drink[nr][1];
            if(intp(drink[nr][3]))
            {
              lp_heilung     = (drink[nr][3]);
              mp_heilung     = (drink[nr][3]);              
            }
            else
            {
              r_heilung      = random(drink[nr][3][2]);
              lp_heilung     = (drink[nr][3][0])+r_heilung;
              mp_heilung     = (drink[nr][3][1])+r_heilung;
            }
            saettigung     = drink[nr][5];
            alcohol        = drink[nr][4];
            fuellcounter   = 1;
            getraenk       = drink[nr][0];
            AddProp(P_LONG, "In die Kanne hast Du '"+CAP(getraenk)+"' "
                            "gefuellt.");
            AddProp(P_SHORT, " (gefuellt)");
            SetProp(P_WEIGHT, 500);
            return 1;
          }
        }
        else
        {
          write("So ein Getraenk gibt es hier nicht!\n");
          return 1;
        }
      }
      return 0;
    }
    return 0;
  }
}

int fkttrinken(string str)
{
  string was, woraus;
  notify_fail("Was willst Du woraus trinken?\n");
  if(!str) return 0;
  if(sscanf(str, "%s aus %s", was, woraus) == 2)
  {
    if(woraus=="thermoskanne" || woraus=="kanne")
    {
      if(wassergefuellt || pubgefuellt)
      {
        if(was==getraenk || member(getraenk_ids, was)!=-1)
        {
          getrunken    = TP->QueryProp(P_DRINK);
          kann_trinken = TP->QueryProp(P_MAX_DRINK);
          besoffen     = TP->QueryProp(P_ALCOHOL);
          max_besoffen = TP->QueryProp(P_MAX_ALCOHOL);
          if(getrunken + saettigung >= kann_trinken && saettigung > 0)
          {
            write("Aber Du kannst doch gar nichts mehr trinken.\n");
            return 1;
          }
          if(besoffen + alcohol >= max_besoffen && alcohol > 0)
          {
            write("Du bist schon zu besoffen, um noch etwas trinken.\n");
            return 1;
          }
          write("Du trinkst '"+CAP(getraenk)+"' aus der Thermoskanne.\n"
                "Leider ist sie jetzt wieder leer.\n");
          say(TPN+" trinkt '"+CAP(getraenk)+"' aus einer Thermoskanne.\n");
          TP->AddHp(lp_heilung);
          TP->AddSp(mp_heilung);
          TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK) + saettigung);
          TP->SetProp(P_ALCOHOL, TP->QueryProp(P_ALCOHOL) + alcohol);
          SetProp(P_LONG,
	    "In Deinen Haenden haeltst Du eine huebsche Thermoskanne. "
	    "Du hast sie von Halron dem Hoehlenforscher bekommen, fuer "
	    "Deine grossartige Hilfe bei seinen Forschungsarbeiten.");
	  SetProp(P_SHORT, "Eine Thermoskanne");
          SetProp(P_WEIGHT, 200);
          wassergefuellt = 0;
          pubgefuellt = 0;
          return 1;
        }
        else
        {
          write(BS("Aber Deine Thermoskanne ist doch mit "+CAP(getraenk)+
                " gefuellt und nicht mit "+CAP(was)+"."));
          return 1;
        }
      }
      notify_fail("Aber die Thermoskanne ist doch leer...\n");
      return 0;
    }
    return 0;
  }
  return 0;
}

int fktzerbrechen(string str)
{
  notify_fail("Was willst Du zerbrechen?\n");
  if(!str) return 0;
  if( str=="kanne" || str=="thermoskanne")
  {
    write(BS("Du wirfst die Thermoskanne auf den Boden. Sie zerbricht "
          "in tausend Scherben, die sich ploetzlich in Luft aufloesen. "
          "Gut dass Du Dir bei Halron jederzeit eine Neue holen kannst."));
    say(TPN+" wirft eine Thermoskanne auf den Boden, welche in tausend "
        "Scherben zerbricht.\n");
    TO->remove();
    return 1;
  }
  else return 0;
}

void reset()
{
  ::reset();
  if(fuellcounter)
  {
    write(BS("Deine Thermoskanne ist wieder bereit gefuellt zu "
             "werden."));
    fuellcounter = 0;
  }
}

varargs int move(mixed dest, int method,
                      string dir, string textout, string textin)
{
  call_out("EnvCheck", 0);
  return ::move(dest, method, dir, textout, textin);
}

void EnvCheck()
{
  if (ENV(ME) && query_once_interactive(ENV(ME)))
    return;
   else  fktzerbrechen("thermoskanne");  
}

