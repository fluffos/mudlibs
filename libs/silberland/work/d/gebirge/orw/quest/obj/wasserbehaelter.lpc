//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Behaelter für Wassertierchen
//  Erstellt    : 03.03.2001 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <defines.h>
#include <material.h>
#include "../def.h"

int gef_wassertiere;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Behaelter fuer Wassertierchen");
  SetProp(P_LONG,
	  "Dies ist ein Forschungsbehaelter in dem man kleine Wassertierchen "
	  "aufbewahren kann, ohne das ihnen etwas passiert. Der Boden des "
	  "Behaelters ist mit Kieselsteinen ausgelegt. Der Behaelter ist bis "
	  "zur Haelfte mit Wasser gefuellt. Darin werden sich gefangene "
	  "Tierchen sicher wohlfuehlen." );
  SetProp(P_INFO, 
          "Diesen magischen Behaelter kannst Du mit gefangenen Tierchen "
          "fuellen. Sobald Du drei Wassertierchen gefangen hast, kannst Du "
          "sie mit 'fuelle behaelter mit wassertierchen' reingeben.");
  SetProp(P_NAME, "Behaelter fuer Wassertierchen");
  SetProp(P_GENDER, MALE);
  AddId(({"behaelter","forschungsbehaelter","WASSERBEH"}));

  SetProp(P_MATERIAL, 
         ([MAT_GLASS:50,MAT_PLASTIC:20,MAT_MISC_STONE:10,MAT_WATER:20]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  AddCmd( ({"fuelle", "fuell"}), "fktfuelle");  
}

int fktfuelle(string str)
{
  object WASSERTIER;

  notify_fail ("Was willst Du womit fuellen?\n");
  if (!str) return 0;

  if  (	 str=="behaelter mit wassertierchen" ||
	 str=="behaelter mit wassertieren")
  {
    gef_wassertiere=sizeof(filter_objects(all_inventory(this_player()),"id",
                           "WASSERTIERCHENGEF"));
    switch(gef_wassertiere) 
    {
      case 0:
        write("Du hast noch kein einziges Wassertierchen gefangen, was willst Du "
              "also in den Behaelter stecken?\n");
        break;
      case 1:
        write("Du brauchst drei Wassertierchen um den Behaelter zu fuellen. "
              "Du hast aber erst Eines.\n");
        break;
      case 2:
        write("Du brauchst drei Wassertierchen um den Behaelter zu fuellen. "
              "Du hast aber erst Zwei.\n");
        break;
      case 3:
        write("Vorsichtig steckst Du die drei Wassertierchen in den Behaelter.\n");
        while(WASSERTIER=present("WASSERTIERCHENGEF", TP))
        {
          WASSERTIER->remove();
        }
        AddProp(P_SHORT, " (voll)");
        AddProp(P_LONG, "Drei kleine Tierchen springen lustig im Behaelter "
                        "herum.");
        AddId("WASSERBEHVOLL");
        break;
    }
    return 1;
  }
}