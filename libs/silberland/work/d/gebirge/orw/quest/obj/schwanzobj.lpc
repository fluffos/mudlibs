//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Doppelschwanz (gefangen)
//  Erstellt    : 24.10.2000 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Doppelschwanz");
  SetProp (P_LONG,
	"Du haeltst einen gefangenen Doppelschwanz in Deinen Haenden. "
	"Du bist besonders vorsichtig um ihn nicht zu verletzen. "
	"Er lebt normalerweise im Moos oder in Spalten und Ritzen.");
  SetProp(P_NAME, "Doppelschwanz");
  SetProp(P_GENDER, MALE);
  AddDetail("schwanz",
        "Das ist kein Schwanz, sondern ein Doppelschwanz, ein Insekt! "
        "Das hier immer gleich an das Eine gedacht wird. Tztztz.");
  
  AddId (({"doppelschwanz", "tierchen", "insekt","DOPPELSCHWANZGEF",
           "LANDTIERCHENGEF"}));

  SetProp(P_MATERIAL, MAT_MISC_LIVING );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}
