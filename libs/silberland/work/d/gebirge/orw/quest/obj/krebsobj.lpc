//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Hoehlenflohkrebs (gefangen)
//  Erstellt    : 24.10.2000 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Hoehlenflohkrebs");
  SetProp (P_LONG,
	"Du haeltst einen gefangenen Hoehlenflohkrebs in Deinen Haenden. "
	"Du bist besonders vorsichtig um ihn nicht zu verletzen. "
	"Er krabbelt lustig herum und wackelt mit seinen Fuehlern.");
  SetProp(P_NAME, "Hoehlenflohkrebs");
  SetProp(P_GENDER, MALE);
  
  AddId (({"hoehlenflohkrebs", "tierchen", "flohkrebs","insekt","krebs",
           "HOEHLENFLOHKREBSGEF","WASSERTIERCHENGEF"}));

  SetProp(P_MATERIAL, MAT_MISC_LIVING );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}
