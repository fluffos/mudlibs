//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Zwergspinne (gefangen)
//  Erstellt    : 24.10.2000 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Zwergspinne");
  SetProp (P_LONG,
	"Du haeltst eine gefangene Zwergspinne in Deinen Haenden. "
	"Du bist besonders vorsichtig um sie nicht zu verletzen. "
	"Sie lebt normalerweise im Moos oder in Spalten und Ritzen.");
  SetProp(P_NAME, "Zwergspinne");
  SetProp(P_GENDER, FEMALE);
  
  AddId (({"zwergspinne", "tierchen", "spinne","insekt","ZWERGSPINNEGEF",
           "LANDTIERCHENGEF"}));

  SetProp(P_MATERIAL, MAT_MISC_LIVING );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}
