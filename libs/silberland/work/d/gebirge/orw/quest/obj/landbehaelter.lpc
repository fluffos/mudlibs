//  Projekt     : Die Hoehlenforscherquest
//  Objekt Name : Behaelter für Landtierchen
//  Erstellt    : 03.03.2001 (Orw)
//  Geaendert   : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <defines.h>
#include <material.h>
#include "../def.h"

int gef_landtiere;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Behaelter fuer Landtierchen");
  SetProp(P_LONG,
	  "Dies ist ein Forschungsbehaelter in dem man kleine Landtierchen "
	  "aufbewahren kann, ohne das ihnen etwas passiert. Der Boden des "
	  "Behaelters ist mit Moos und Kieselsteinen ausgelegt. Auch zwei "
	  "kleine Farne kann man sehen. Darin werden sich gefangene "
	  "Tierchen sicher wohlfuehlen." );
  SetProp(P_INFO, 
          "Diesen magischen Behaelter kannst Du mit gefangenen Tierchen "
          "fuellen. Sobald Du drei Landtierchen gefangen hast, kannst Du "
          "sie mit 'fuelle behaelter mit landtierchen' reingeben.");
  SetProp(P_NAME, "Behaelter fuer Landtierchen");
  SetProp(P_GENDER, MALE);
  AddId(({"behaelter","forschungsbehaelter","LANDBEH"}));

  SetProp(P_MATERIAL, 
         ([MAT_GLASS:50,MAT_PLASTIC:30,MAT_MISC_STONE:10,MAT_MISC_HERBAL:10]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  AddCmd( ({"fuelle", "fuell"}), "fktfuelle");  
}

int fktfuelle(string str)
{
  object LANDTIER;
  
  notify_fail ("Was willst Du womit fuellen?\n");
  if (!str) return 0;

  if  (	 str=="behaelter mit landtierchen" ||
	 str=="behaelter mit landtieren")
  {
    gef_landtiere=sizeof(filter_objects(all_inventory(this_player()),"id",
                         "LANDTIERCHENGEF"));
    switch(gef_landtiere) 
    {
      case 0:
        write("Du hast noch kein einziges Landtierchen gefangen, was willst Du "
              "also in den Behaelter stecken?\n");
        break;
      case 1:
        write("Du brauchst drei Landtierchen um den Behaelter zu fuellen. "
              "Du hast aber erst Eines.\n");
        break;
      case 2:
        write("Du brauchst drei Landtierchen um den Behaelter zu fuellen. "
              "Du hast aber erst Zwei.\n");
        break;
      case 3:
        write("Vorsichtig steckst Du die drei Landtierchen in den Behaelter.\n");
        while(LANDTIER=present("LANDTIERCHENGEF", TP))
        {
          LANDTIER->remove();
        }
        AddProp(P_SHORT, " (voll)");
        AddProp(P_LONG, "Drei kleine Tierchen springen lustig im Behaelter "
                        "herum.");
        AddId("LANDBEHVOLL");
        break;
    }
    return 1;
  }
}