//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : In der Wassergrube
//  Erstellt  : 19.10.2000 (Orw)
//  Geaendert : 21.10.2000 (Orw)


inherit "/d/wasser/cirion/room/wroom";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"


create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Wassergrube" );
  SetProp(P_INT_LONG,
	 "Du befindest Dich ca. drei Meter unter Wasser. Knapp unter Dir "
	 "kannst Du den Grund sehen, auf dem viele Algen und "
	 "Schlingpflanzen wachsen. Das Wasser ist durch den aufgewirbelten "
	 "Schlamm ziemlich trueb. Du hoffst Dich in den Schlingpflanzen "
	 "nicht zu verfangen.");
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 4, ENV_TERRAIN: TT_UNDERWATER,
                          ENV_WATER:3]) );

/* Detailbeschreibungen */

  AddDetail( ({"wassergrube", "wasser", "raum","mulde","senke","lache"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"meter"}),
	 "Du hast noch soviel Luft um das hier zu untersuchen?");
  AddDetail( ({"luft"}),
	 "Die wird knapp.");
  AddDetail( ({"wand","waende" }),
	 "Vor lauter Algen und Schlingpflanzen kannst Du die Waende "
	 "nicht erkennen.");
  AddDetail( ({"pflanzen", "schlingpflanzen"}),
	 "Du hoffst Dich nicht in ihnen zu verfangen.");
  AddDetail( ({"algen", "alge"}),
	 "Gibts hier einige....");
  AddDetail( ({"schlamm"}),
	 "Durch den aufgewirbelten Schlamm ist das Wasser ziemlich "
	 "trueb.");
  AddDetail( ({"grund","boden"}),
	 "Der Grund ist gerade mal einen Meter unter Dir. "
	 "Er ist mit vielen Algen bedeckt.");
  AddDetail( ({"decke"}),
	 "Waere schon bloed wenns hier eine gaebe, wie wuerdest Du dann "
	 "auftauchen koennen?");


/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Du hoerst nur das plaetschern des Wassers.");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Unter Wasser kann man nichts riechen!");

/* Definition der Funktionen */

  AddCmd( ({"tauche", "tauch"}), "fkttauche");
//  AddCmd (({"", ""}),     "fktyyy");


/* NPCs und Objekte */

  AddItem( NPC "/tentakel", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");
}



/* Funktionen */

fkttauche(string str)
{

  notify_fail ("Wohin willst Du tauchen?\n");
  if (!str) return 0;

	

  if  (	 str=="nach oben" ||
	 str=="oben" ||
	 str=="rauf"||
	 str=="auf" ||
	 str=="raus"||
	 str=="hinauf")
	 {
	   switch(random(100))
	   {
	      case 0 .. 70:	
		  write("Du tauchst nach oben an die Oberflaeche.\n");
		  TP->move( ROOM "/quelle.lpc", M_GO, "oben" ,"taucht nach",
				"taucht auf");
		  return 1;
		  break;
	      case 71 .. 100:
	          write("Du hast Dich in den Schlingpflanzen verfangen!\n");
	          say  (TPN+" schafft es nicht aufzutauchen!\n");
	          return 1;
	   }
	 }
  else
	 return 0;
}
