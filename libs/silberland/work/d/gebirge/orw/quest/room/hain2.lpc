//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Die Mooshoehle
//  Erstellt  : 10.10.2000 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int pilzcounter;
int tierchencounter;

create()
{
  ::create();
  
  pilzcounter=1;

  SetProp(P_INT_SHORT, "Die Mooshoehle" );
  SetProp(P_INT_LONG,
	 "Du stehst hier im suedwestlichen Teil der Mooshoehle. Der "
	 "Moosboden wird Richtung Norden immer saftiger und gruener. "
	 "Grosse Pfuetzen haben sich hier gebildet, welche die Brutstaette "
	 "vieler kleiner Wuermer und anderer Wassertierchen zu sein "
	 "scheint. Nach Suedwesten geht es in eine kleine finstere "
	 "Oeffnung. Zwischen all den kleineren weissen und braunen Pilzen, "
	 "waechst hier auch ein ca. 40 cm grosser Pilz mit einer "
	 "hellblauen Kappe. Die Waende sind hier ziemlich rissig. Aus "
	 "grossen Spalten und Rissen wachsen lange Farnbueschel.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({ "mooshoehle", "hoehle", "grotte","teil","hoehlen"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"moosboden", "boden"}),
	 "Der ganze Boden ist mit Moos bedeckt.");
  AddDetail(({"moos","moose"}),
	 "Sehr saftiges dunkelgruenes Moos.");
  AddDetail( ({ "richtung","norden","osten" }),
	 "Die Hoehle erstreckt sich von hier nach Osten und dehnt sich "
	 "nach Norden aus.");
  AddDetail( ({ "pfuetzen", "pfuetze"}),
	 "Grosse Pfuetzen haben sich hier gebildet, welche die Brutstaette "
	 "vieler kleiner Wuermer und anderer Wasserbewohner zu sein scheint.");
  AddDetail( ({"brutstaette", "staette", "platz"}),
	 "Dies scheint der ideale Platz fuer kleine Wassertierchen und "
	 "Wuermer.");
  AddDetail( ({"wuermer","wurm"}),
	 "Vielleicht ist dies die geeignete Stelle um Wuermer und andere "
	 "Wasserbewohner zu finden.");
  AddDetail( ({"wassertierchen", "tierchen","wasserbewohner","bewohner"}),
	 "Dies scheint eine geeignete Stelle zu sein, um kleine "
	 "Wassertierchen zu finden.");
  AddDetail( ({"suedwesten"}),
	 "Im Suedwesten kannst Du eine kleine Oeffnung in der Wand "
	 "erkennen, gerade gross genug um durchzupassen.");
  AddDetail( ({"oeffnung"}),
	 "In der Wand im Suedwesten befindet sich eine kleine Oeffnung. "
	 "Du bist gespannt was Dich dort erwartet. Leise Geraeusche "
	 "dringen aus der Oeffnung an Dein Ohr.");
  AddDetail( ({"wand"}),
	 "Die Wand im Suedwesten unterscheidet sich von den anderen Waenden "
	 "durch eine kleine Oeffnung.");
  AddDetail( ({"geraeusche","geraeusch"}),
	 "Leise Geraeusche, klingen irgendwie nach dem Flattern von "
	 "Fluegeln.");
  AddDetail( ({"flattern"}),
	 "Lausch doch mal.");
  AddDetail( ({"ohr", "ohren"}),
	 "Die Geraeusche dringen an Dein Ohr.");
  AddDetail( ({"fluegeln","fluegel"}),
	 "Die Geraeusche klingen nach dem Flattern von Fluegeln.");
  AddDetail( ({"pilze","pilzen","vegetation","pflanzen"}),
	 "Viele kleine Pilze wachsen im Moos und an den Waenden. "
	 "Einer davon faellt Dir besonders auf. Er ist viel groesser als "
	 "die uebrigen Pilze und hat eine hellblaue Kappe.");
  AddDetail( ({"kappe"}),
	 "Eine schoene hellblaue Kappe, so gross wie das Rad eines "
	 "Pferdewagens.");
  AddDetail( ({"rad","pferdewagen","pferdewagens"}),
	 "Sowas suchst Du hier unten vergeblich!");
  AddDetail( ({"waende","waenden"}),
	 "Aus den Spalten, Rissen und Fugen der Waende wuchern grosse "
	 "Farnbueschel und kleine weisse Pilze.");
  AddDetail( ({"spalten", "risse", "fugen","rissen"}),
	 "Die Waende sind hier besonders rissig.");
  AddDetail( ({"farnbueschel","farne","farn","bueschel"}),
	 "Lange Farnbueschel wachsen aus den Waenden und haengen von der "
	 "Decke.");
  AddDetail( ({"stelle"}),
	 "Du koenntest mal versuchen die Pfuetze zu durchsuchen.");
  AddDetail( ({"elfennase","hobbitnase","trollnase","ogernase","nase"}),
	 "Deine Nase...");
  AddDetail( ({"gedanke","kopf","elf"}),
	 "Dumdidum.");

  AddDetail( ({"decke"}),
	 ([ 0:
	  "Die Decke ist hier sehr hoch. Die vielen Farne die von ihr "
	  "herunterhaengen faszinieren Dich.\n",
	  "zwerg":
	  "Noch nie hast Du eine so schoene Hoehle gesehen. Die Decke ist "
	  "hoch ueber Deinem Kopf. Zwerge lieben Hoehlen und diese ist "
	  "besonders schoen.\n",
	  "elf":
	  "Obwohl Du als Elf normalerweise keine Hoehlen magst, fasziniert "
	  "Dich diese gespenstisch wirkende Vegetation.\n",
	  "troll":
	  "Du freust Dich, dass Du endlich wieder aufrecht stehen kannst.\n",
	  "hobbit":
	  "Fasziniert starrst Du auf die vielen Farne und Pilze, die an den "
	  "Waenden und der Decke wachsen. Hobbits lieben Pflanzen auch wenn "
	  "sie in solchen kalt feuchten Hoehlen beheimatet sind.\n",
	  "oger":
	  "Dein erster Gedanke ist, ob man irgendwelche dieser Farne und "
	  "Pilze essen kann. Die Decke ist sehr hoch und Du kannst sie "
	  "nichtmal erreichen wenn Du raufspringen wuerdest.\n"

	 ]) );



/* Spezielle Details */

  AddSpecialDetail( ({"pilz"}), "fktweckepilz" );


/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Du hoerst ein Flattern aus der Oeffnung im Suedwesten.");
  AddSound( ({"flattern", "geraeusch","geraeusche"}),
	 "Es kommt definitiv aus der Oeffnung, ob du mal nachschauen "
	 "solltest?");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Aus den Pfuetzen kommt ein modriger Geruch.");
  AddSmell (({"moos", "pilze", "luft","geruch","modriger geruch"}),
	 ([ 0:
	  "IEHH! Das stinkt.\n",
	  "zwerge":
	  "Du findest diesen Geruch nichtmal schlecht, auch die kuehle "
	  "Luft der Hoehle macht Dir nichts aus.\n",
	  "elf":
	  "Der Geruch schmerzt in Deiner empfindlichen Elfennase.\n",
	  "troll":
	  "Du ruempfst Deine dicke Trollnase.\n",
	  "hobbit":
	  "Du ruempfst Deine kleine Hobbitnase.\n",
	  "oger":
	  "Der Geruch macht Dir nichts aus, Deine Ogernase ist einiges "
	  "gewoehnt.\n"

	 ]) );


/* Definition der Funktionen */

  AddCmd (({"durchsuche", "durchsuch"}),     "fktsuche");
            tierchencounter=1;
//  AddCmd( ({"", "", ""}), "fktxxx");

/* Ausgaenge */

  AddExit( "osten",      ROOM "/hain1" );
  AddExit( "suedwesten", ROOM "/fhoehle");
  AddExit( "norden",     ROOM "/hain3");


/* NPCs und Objekte */

//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");
}


/* Funktion des AddSpecialDetail */

fktweckepilz()
{
  object ob;
  if( pilzcounter==1 )
  {
    pilzcounter=0;
    write(
    "Als Du den Pilz genauer untersuchst ruehrt er sich ploetzlich.\n");
    say(
    "Als "+CAP_TPN+" den Pilz untersucht ruehrt sich dieser ploetzlich.\n");
    ob=clone_object( NPC "/fungil" );
    if(ob) 
    {
      ob->move(ME,M_GO);
    }
    return(" ");
  }
  else return("Der praechtige Pilz scheint tot zu sein.\n");

}

int fktsuche(string str) 
{
  object ob;
  notify_fail("Was willst Du durchsuchen?\n");
  if(str != "pfuetze" &&
     str != "wasser" &&
     str != "stelle")
    return 0;
  if(tierchencounter != 1) 
  {
    write(BS(
      "Du durchsuchst die Pfuetze kannst aber leider gar nichts finden."));
    say(BS(
      CAP_TPN+" durchsucht die Pfuetze, findet aber nichts."));
    return 1;
  }
  tierchencounter=0;
  write(BS(
    "Du schaffst es einen der Wasserbewohner aus der Pfuetze zu locken."));
  say(BS(
    CAP_TPN+" lockt erfolgreich einen Wasserbewohner aus der Pfuetze."));
  switch( random(2)) 
    {
      case 0:
        ob=clone_object( NPC "/fadenwurm" );
        break;
      case 1:
        ob=clone_object( NPC "/milbe" );
        break;
      }  
  if(ob) 
  {
    ob->move(ME,M_GO);
  }
  return 1;
}

reset() 
{ object ob;
  ::reset();
  if(ob=present("fungil", this_object()))
  {
    tell_room(TO, "Fungil sagt: Ich bin so muede!\n");
    tell_room(TO, "Der kleine Pilz schlaeft gemuetlich ein.\n");
    ob->remove();
  }
  pilzcounter=1;
  while(ob=present("WASSERTIERCHEN", this_object()))
  {
    tell_room(TO, sprintf("%s verkriecht sich.\n", ob->Name(WER)));
    ob->remove();
  }
  tierchencounter=1;
}