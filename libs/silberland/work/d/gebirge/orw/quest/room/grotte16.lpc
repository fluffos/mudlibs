//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Ein Grottengang
//  Erstellt  : 08.10.2000 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

int tierchencounter;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Grottengang" );
  SetProp(P_INT_LONG,
	 "Der Gang teilt sich hier in drei Richtungen. Im Nordosten "
	 "befindet sich eine dunkle Nische und im Westen kannst Du ein "
	 "gruenes Schimmern erkennen. Nach Suedosten kommst Du wieder zum "
	 "Tor des Grotteneingangs. An den Waenden wuchern kleine Pilze, "
	 "die nicht besonders geniessbar erscheinen. Der Edelsteingehalt "
	 "des Gesteins nimmt hier ab, die Felsen sind dunkelgrau und durch "
	 "schmale Risse eintretendes Wasser laesst sie leicht glitzern. "
	 "Obwohl sich Unbehagen in Dir breit macht, dringt Dich deine "
	 "Neugier weiter zu gehen.");
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({ "raum","grotte","raeume","raeumen" }),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"gang", "weg", "richtungen", "richtung","teil" }),
	 "Der Gang teilt sich hier nach Nordosten, Westen und Suedosten. "
	 "Welche Abenteuer man hier wohl erleben kann?");
  AddDetail(({"nordosten"}),
	 "Im Nordosten befindet sich eine dunkle Nische. Du muesstest schon "
	 "naeher gehen, um genaueres erkennen zu koennen.");
  AddDetail( ({ "nische" }),
	 "Du kannst von hier nichts genaues erkennen, aber Du hoerst ein "
	 "leises Murmeln. Wer oder was sich in dieser Nische bloss "
	 "versteckt?");
  AddDetail( ({ "murmeln", "geraeusche", "geraeusch" }),
	 "Hoer doch genauer hin, vielleicht findest Du heraus woher das "
	 "Murmeln stammt.");
  AddDetail( ({"westen"}),
	 "Ein gruenliches Schimmern faellt Dir im Westen auf. Koennte "
	 "von irgendwelchen Pflanzen stammen. Irgendwie erinnert es Dich "
	 "an das Leuchten von Gluehwuermchen.");
  AddDetail( ({"schimmern","schimmer"}),
	 "Entzueckt schaust Du nach Westen, das Schimmern zieht Dich "
	 "magisch an. Es erinnert Dich an das Leuchten von Gluehwuermchen.");
  AddDetail( ({"pflanzen", "pflanze"}),
	 "Im Westen erkennst Du ein Schimmern, das von Pflanzen stammen "
	 "koennte. Die einzigen Pflanzen in diesem Teil der Grotte sind ein "
	 "paar kleine, nicht sehr geniessbar aussehende Pilze.");
  AddDetail( ({"suedosten"}),
	 "Im Suedosten befindet sich der Grotteneingang.");
  AddDetail( ({"grotteneingang", "eingang", "tor","grotteneingangs"}),
	 "Im Suedosten liegt der Eingang zur Grotte.");
  AddDetail( ({"waende","wand","waenden"}),
	 "Die Waende sind hier dunkelgrau und nur noch leicht mit violetten "
	 "Edelsteinfasern durchzogen. Durch kleine Risse in den Felsen "
	 "tritt Wasser und verleiht ihnen ein schoenes Glitzern.");
  AddDetail( ({"edelsteinfasern","fasern","edelstein","faser",
	       "edelsteingehalt","gehalt"}),
	 "Die glitzernden Felsen sind hier mit violetten Edelsteinfasern "
	 "durchzogen.");
  AddDetail( ({"risse", "riss"}),
	 "Die Waende hier sind ziemlich rissig. Alles ist feucht "
	 "und kalt. BRRR!");
  AddDetail( ({"glitzern", "glitzer","anblick","schoenes"}),
	 "Es freut Dich in diesen kalt-feuchten Raeumen so etwas Schoenes "
	 "vorzufinden.");
  AddDetail( ({"gestein","stein","gesteins"}),
	 "Graues, mit schimmernden Fasern durchzogenes Gestein. "
	 "Ein wahrhaft schoener Anblick.");
  AddDetail( ({"wasser"}),
	 "Hier ist nicht viel Wasser, aber die Waende und der Boden sind "
	 "ziemlich feucht. Pass auf, dass Du nicht ausrutschst!");
  AddDetail( ({"boden","pfuetzen","pfuetze"}),
	 "Kleine Pfuetzen und abgestorbene Pilze machen den Boden "
	 "recht glitschig.");
  AddDetail( ({"pilze","pilz"}),
	 "An den Waenden wachsen weisse, kleine Pilze. "
	 "Sie sehen nicht besonders lecker aus.");
  AddDetail( ({"unbehagen"}),
	 "Du bist schon sehr gespannt was Dich hier erwarten wird. "
	 "Sollst Du nach Westen und das Schimmern untersuchen, oder doch "
	 "lieber im Nordosten in die dunkle Nische. Wie Du Dich auch "
	 "entscheidest, ein gutes Gefuehl hast Du dabei nicht.");
  AddDetail( ({"gefuehl"}),
	 "Trotz der Schoenheit des Gesteins packt Dich ein ungutes Gefuehl.");
  AddDetail( ({"schoenheit"}),
	 "Wirklich ein schoenes Glitzern.");
  AddDetail( ({"neugier"}),
	 "Trotz der Neugier die Dich weitergehen laesst, waechst in Dir "
	 "ein ungutes Gefuehl. Solltest Du doch umkehren?");
  AddDetail( ({"ohr","ohren"}),
	 "Hast Du etwa keine Ohren?");
  AddDetail( ({"abenteuer"}),
	 "Du musst schon selbst herausfinden, was es hier zu entdecken "
	 "gibt.");
  AddDetail( ({"gluehwuermchen", "leuchten", "wuermchen"}),
	 "Gluehwuermchen wirst Du in dieser Grotte vergeblich suchen.");
  AddDetail( ({"felsen","fels"}),
	 "Als Du den Fels genauer betrachtest, glaubst Du ein kleines "
	 "Tierchen zu erkennen.");
  AddDetail( ({"decken","hobbit","hoehlen","kopf","platz","probleme",
         "rassen","vieren"}),
	 "Du untersuchst aber auch alles...");


  AddDetail( ({"decke"}),
	 ([ 0:
	  "Die Decke ist hier sehr niedrig. Wenige cm sind zwischen ihr "
	  "und Deinem Kopf.\n",
	  "hobbit":
	  "Du als Hobbit hast noch viel Platz, obwohl die Decke doch sehr "
	  "niedrig ist.\n",
	  "zwerg":
	  "Du fuehlst Dich hier wie zuhause, andere Rassen haetten bestimmt "
	  "einige Probleme mit so niedrign Decken.\n",
	  "troll":
	  "Du kriechst schon auf allen Vieren. Trolle sind einfach nicht "
	  "fuer solch niedrige Hoehlen geschaffen.\n",
	  "elf":
	  "Obwohl Du noch ein wenig Platz zur Decke hast, fuehlst Du Dich "
	  "sehr beengt. Du hoffst, so bald wie moeglich diese Grotte zu "
	  "verlassen.\n"

	 ]) );
	
	 
/* Spezielle Details */

  AddSpecialDetail( ({"tierchen","tier"}), "fkttierchen" );
    tierchencounter=1;



/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Ein leises Murmeln dringt an dein Ohr. Wer oder was sich da wohl "
	 "im Nordosten versteckt?");
  AddSound( ({"murmeln", "geraeusch"}),
	 "Du musst wohl oder uebel naeher ran gehen, um zu sehen was Dich "
	 "dort erwartet.");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Die Luft riecht etwas abgestanden und modrig.");
  AddSmell (({"luft", "geruch"}),
	 ([ 0:
	  "Riecht nicht besonders gut, Du ruempfst Deine Nase.\n",
	  "zwerg":
	  "Du bist solche Hoehlengerueche gewohnt.\n",
	  "hobbit":
	  "Riecht nicht besonders gut, Du ruempfst Deine kleine Hobbitnase.\n",
	  "elf":
	  "Riecht nicht besonders gut, Du ruempfst Deine empfindliche "
	  "Elfennase.\n",
	  "troll":
	  "Trollnasen macht so ein modriger Gruch nichts aus.\n",
	  "oger":
	  "Trotz des modrigen Geruchs, denkst Du mal wieder nur an Essen. "
	  "Du bist eben ein Oger, was kannst man da schon machen.\n"

	 ]) );

/* Roommessage */

  AddRoomMessage( ({
  	"Ein leises Murmeln dringt aus der Nische im Nordosten.\n",
	"Das Murmeln wird etwas lauter.\n",
	"Etwas scheint sich in der Nische zu bewegen.\n"}),120);


/* Ausgaenge */

  AddExit( "suedosten", ANSCHLUSS);
  AddExit( "nordosten", ROOM "/grotte17");
  AddExit( "westen",    ROOM "/grotte18");




/* NPCs und Objekte */

//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");

}

fkttierchen()
{
  object ob;
  if( tierchencounter==1 )
  {
    tierchencounter=0;
    
    say(
    CAP_TPN+" scheint etwas gefunden zu haben.\n");
    switch( random(3)) 
      {
        case 0:
          ob=clone_object( NPC "/aaskaefer" );
          break;
        case 1:
          ob=clone_object( NPC "/laufkaefer" );
          break;
        case 2:
          ob=clone_object( NPC "/kurzfluegler" );
          break;
      }  

    if(ob) 
    {
      ob->move(ME,M_GO);
    }
    return(
      "Als Du den Fels genauer untersuchst scheuchst Du das kleine Tier auf.\n");
  }
  else return("Du scheinst Dich getaeuscht zu haben.\n");

}

reset() 
{ object ob;
  ::reset();
  while(ob=present("LANDTIERCHEN", this_object()))
  {
    tell_room(TO, sprintf("%s verkriecht sich.\n", ob->Name(WER)));
    ob->remove();
  }
  tierchencounter=1;
}