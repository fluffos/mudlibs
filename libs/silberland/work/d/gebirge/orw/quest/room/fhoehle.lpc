//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Die Fledermaushoehle
//  Erstellt  : 12.10.2000 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int tierchencounter;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Fledermaushoehle" );
  SetProp(P_INT_LONG,
	 "Durch die Oeffnung bist Du in eine dunkle kleine Hoehle gelangt, "
	 "die das Heim einer Fledermausfamilie zu sein scheint. Ausser ein "
	 "paar Farnbueschel auf dem Boden, gibt es hier keinerlei "
	 "Vegetation. Die Waende sind aus einem dunklen Felsgestein und an "
	 "der Decke haengen Tropfsteine. Die Fledermaeuse fuehlen sich hier "
	 "pudelwohl und scheinen Dich nichtmal zu bemerken. Du bist froh, "
	 "dass Hufeisennasen eine der friedlichsten Fledermausarten sind. "
	 "Wovon sich diese kleinen Tierchen bloss ernaehren?");
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({ "hoehle", "fledermaushoehle", "raum"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"oeffnung", "loch"}),
	 "In der nordoestlichen Wand ist eine kleine Oeffnung, durch die "
	 "ein wenig Licht dringt, aber leider nicht genug um hier ohne "
	 "Lichtquelle Details zu erkennen.");
  AddDetail(({"wand"}),
	 "In der nordoestlichen Wand ist die Oeffnung, durch die Du "
	 "gekommen bist.");
  AddDetail( ({ "licht" }),
	 "Von draussen strahlt zuwenig Licht in die Hoehle, um ohne eine "
	 "Lichtquelle etwas genaues sehen zu koennen.");
  AddDetail( ({ "lichtquelle", "quelle"}),
	 "Du musst schon selber wissen welche Lichtquelle Du bei dir "
	 "traegst.");
  AddDetail( ({"details", "detail"}),
	 "Ob es hier viele Details gibt?");
  AddDetail( ({"heim"}),
	 "Diese Hoehle wurde von einer Fledermausfamilie zu ihrem Heim "
	 "auserkoren. Fledermaeuse lieben solche dunklen Hoehlen.");
  AddDetail( ({"fledermausfamilie", "familie"}),
	 "Eine kleine Familie von Hufeisennasen, einer besonders friedlichen "
	 "Fledermausart. Sie verspeisen kleine Hoehleninsekten und lieben "
	 "wie alle Fledermaeuse dunkle Hoehlen.");
  AddDetail( ({"fledermaeuse","hufeisennasen","tierchen"}),
	 "Hufeisennasen sind Fledermaeuse, einer besonders friedlichen Art.");
  AddDetail( ({"fledermaus", "hufeisennase"}),
	 "Ist im Moment keine hier? Dann sind sie wohl auf Nahrungssuche.");
  AddDetail( ({"moment"}),
	 "Gerade keine Fledermaus hier? Wahrscheinlich sind sie auf "
	 "Nahrungssuche.");
  AddDetail( ({"nahrungssuche","suche"}),
	 "Fledermaeuse verspeisen am liebsten kleine Hoehleninsekten.");
  AddDetail( ({"hoehlen"}),
	 "Diese hier ist sehr dunkel!");
  AddDetail( ({"fledermausart", "fledermausarten","art","arten"}),
	 "Es gibt einige Fledermausarten und diese hier sind eben "
	 "Hufeisennasen.");
  AddDetail( ({"hoehleninsekten","insekten","nahrung"}),
	 "Hoehleninsekten sind fuer Hufeisennasen die liebste Nahrung.");
  AddDetail( ({"farnbueschel","farn","farne","bueschel"}),
	 "Auf dem Boden wachsen einige Farnbueschel, die einzige "
	 "Vegetation in dieser kleinen Hoehle.");
  AddDetail( ({"vegetation"}),
	 "Einige Farnbueschel wachsen auf dem dunklen Felsboden.");
  AddDetail( ({"boden","felsboden"}),
	 "Ein Boden aus sehr dunklem Felsgestein, einige Farnbueschel kannst "
	 "Du erkennen.");
  AddDetail( ({"waende"}),
	 "Die Waende bestehen aus dunklem Felsgestein und weisen einige "
	 "Spalten auf. In der nordoestlichen Wand befindet sich eine "
	 "kleine Oeffnung.");
  AddDetail( ({"felsgestein", "gestein"}),
	 "Ein wirklich sehr dunkles Gestein.");
  AddDetail( ({"tropfsteine","tropfstein"}),
	 "Die Tropfsteine sind wirklich wunderschoen.");
  AddDetail( ({"seite","seiten"}),
	 "Manchmal flattert eine Hufeisennase von einer Seite der Hoehle "
	 "zur anderen.");
  AddDetail( ({"spalten","spalte"}),
	 "Das grobe Felsgestein ist mit vielen Spalten und Furchen "
	 "zerklueftet.");
  AddDetail( ({"furchen"}),
	 "Eine Furche faellt Dir besonders auf.");
  AddDetail( ({"furche"}),
	 "In einer der Furchen ist ein kleines Loch.");
  AddDetail( ({"loch"}),
	 "Ziemlich nass da drin, ob Du mal reingreifen solltest?");
  AddDetail( ({"anblick","angst","derlim","kopf","ort","phobie",
         "tropfsteinen","unterwelt","vieren","zeit","zwerg","forschen"}),
	 "Lustig wie schnell die Zeit beim Forschen vergeht.");

  AddDetail( ({"decke"}),
	 ([ 0:
	  "Nicht sehr hoch aber Du kannst noch gerade bequem stehen, "
	  "ohne an den Tropfsteinen anzustossen.\n",
	  "zwerg":
	  "Fasziniert blickst Du auf die Decke der Hoehle, "
	  "Du als Zwerg bist begeistert von diesen wunderschoenen "
	  "Tropfsteinen.\n",
	  "elf":
	  "Dich packt diese elfische Angst, dass Dir die Decke samt "
	  "Tropfsteinen auf den Kopf fallen wird. "
	  "Eine angeborene Phobie, die Du auch hier nicht unterdruecken "
	  "kannst.\n",
	  "troll":
	  "Du kriechst auf allen Vieren. Die Hoehle ist einfach zu klein "
	  "fuer Dich und Du wuenschst Dir diesen Ort so schnell wie "
	  "moeglich zu verlassen.\n",
	  "hobbit":
	  "Der schoene Anblick dieser Tropfsteine laesst Dich fuer kurze "
	  "Zeit vergessen, wie weit Du doch von deinem geliebten Derlim "
	  "entfernt bist.\n",
	  "dunkelelf":
	  "Diese Hoehle erinnert Dich stark an die so vertrauten Hoehlen "
	  "der Unterwelt, in der Du aufgewachsen bist.\n"

	 ]) );


/* Spezielle Details */

//  AddSpecialDetail( ({""}), "zzz" );


/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Bis auf das seltene Flattern einer Hufeisennase, kannst Du "
	 "nichts Besonderes hoeren.");
  AddSound( ({"flattern", "hufeisennasen"}),
	 "Manchmal flattert eine Hufeisennase von einer Seite der Hoehle "
	 "zur anderen.");
  

/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Es riecht hier stark nach Fledermausexkrementen.");
  AddSmell( ({"fledermausexkremente", "exkremente","fledermausexkrementen"}),
	 "Daran willst Du nicht riechen!");
 

/* Definition der Funktionen */

  AddCmd( ({"greif", "greife"}), "fktgreife");
         tierchencounter=1;
//  AddCmd (({"", ""}),     "fktyyy");

/* Ausgaenge */

  AddExit( "nordosten", ROOM "/hain2" );

/* NPCs und Objekte */

  AddItem( NPC "/hufeisen", REFRESH_DESTRUCT);
  AddItem( NPC "/hufeisen", REFRESH_DESTRUCT);
  AddItem( NPC "/hufeisen", REFRESH_DESTRUCT);
//  AddItem( "");
}


int fktgreife(string str) 
{
  object ob;
  notify_fail("Wo willst Du hineingreifen?\n");
  if(str != "in loch hinein" &&
     str != "in loch rein" &&
     str != "in loch")
    return 0;
  if(tierchencounter != 1) 
  {
    write(BS(
      "Du greifst in das Loch, aber findest nichts brauchbares darin."));
    say(BS(
      CAP_TPN+" fummelt an der Wand herum."));
    return 1;
  }
  tierchencounter=0;
  write(BS(
    "Als Du deinen Finger in das Loch steckst zwickt Dich etwas."));
  say(BS(
    CAP_TPN+" fummelt an der Wand herum und erschrickt ploetzlich."));
  switch( random(3)) 
    {
      case 0:
        ob=clone_object( NPC "/spinne" );
        break;
      case 1:
        ob=clone_object( NPC "/zwergfuesser" );
        break;
      case 2:
        ob=clone_object( NPC "/turmschnecke" );
        break;
      }  
  if(ob) 
  {
    ob->move(ME,M_GO);
  }
  return 1;
}


reset()
{ object ob;
  ::reset();
  while(ob=present("LANDTIERCHEN", this_object()))
  {
    tell_room(TO, sprintf("%s verkriecht sich.\n", ob->Name(WER)));
    ob->remove();
  }
  tierchencounter=1;
}

