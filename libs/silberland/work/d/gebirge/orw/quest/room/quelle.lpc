//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Eine Quelle in der Mooshoehle
//  Erstellt  : 13.10.2000 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int trinkwasser;
int flechte;
int tierchencounter;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Quelle in der Mooshoehle" );
  SetProp(P_INT_LONG,
	 "In dieser Hoehle entspringt eine kleine Quelle, die in kleinen "
	 "Baechen von der Nordwand nach Westen verlaeuft und sich dort in "
	 "einer grossen Senke sammelt. Viele Algen und Schlingpflanzen "
	 "wachsen in dieser Wassermulde und manchmal kraeuselt sich die "
	 "Oberflaeche, als ob sich etwas Grosses am Grund bewegt. Der Rand "
	 "der Senke ist sehr schlammig und an den Waenden befinden sich "
	 "einige Kalkablagerungen. Die Quelle plaetschert lustig vor sich "
	 "hin und verleiht der Hoehle ein sehr beruhigendes Gefuehl. Das "
	 "Wasser der Quelle ist sehr klar, doch in der Senke vermischt es "
	 "sich mit Schlamm und man kann, wegen der Algen und "
	 "Schlingpflanzen, nicht bis zum Grund sehen.");
  SetProp(P_LIGHT,   0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({"raum", "hoehle", "teil"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"quelle"}),
	 "Aus Spalten und Furchen in der Nordwand entspringt eine kleine "
	 "Quelle, welche nach Westen verlaeuft und sich dort in einer "
	 "grossen Senke sammelt. Das Wasser der Quelle ist sehr klar "
	 "und hat bestimmt Trinkwasserqualitaet.");
  AddDetail( ({"baeche","baechen","bach"}),
	 "In kleinen, durch die Jahrhunderte entstandenen, Furchen und "
	 "Rinnen im Boden, fliesst die Quelle in westliche Richtung und "
	 "sammelt sich dort in einer grossen Mulde.");
  AddDetail( ({"nordwand","wand"}),
	 "In der Nordwand befinden sich viele Spalten und Risse, aus denen "
	 "Wasser austritt und dadurch eine kleine Quelle entsteht.");
  AddDetail( ({"westen"}),
	 "Im Westen befindet sich eine tiefe Mulde im Felsgestein, in der "
	 "sich das Wasser der Quelle sammelt und dadurch eine grosse "
	 "tiefe Lache entstanden ist.");
  AddDetail( ({"senke", "lache", "mulde", "wassermulde"}),
	 "Algen, Schlingpflanzen und aufgewirbelter Schlamm machen die "
	 "Lache so trueb, sodass man nicht bis auf den Grund sehen kann. "
	 "Der Rand der Senke ist im Suedosten wo Du gerade stehst "
	 "ziemlich schlammig, und an den Waenden die an die Wassermulde "
	 "grenzen hat sich befinden sich einige Kalkablagerungen.");
  AddDetail( ({"pflanzen"}),
	 "Auf dem trockenen Teil der Hoehle wachsen Moos und einige Pilze. "
	 "Im Wasser der Lache findest Du viele Algen und Schlingpflanzen.");
  AddDetail( ({"algen", "alge"}),
	 "Einige gruenbraune Algen treiben im Wasser.");
  AddDetail( ({"schlingpflanzen"}),
	 "Vom Grund der Wassermulde wachsen viele Schlingpflanzen bis an "
	 "die Oberflaeche. Nicht gerade einladend um zu baden.");
  AddDetail( ({"oberflaeche"}),
	 "Die Oberflaeche des Wassers steht, ausser an der Stelle, wo die "
	 "kleinen Baeche einmuenden, ganz still. Doch manchmal kraeuselt "
	 "sie sich, als ob sich etwas Grosses auf dem Grund bewegen "
	 "wuerde.");
  AddDetail( ({"grosses", "etwas"}),
	 "Das Wasser ist vom aufgewirbelten Schlamm zu trueb, um zu erkennen "
	 "um was es sich handeln koennte.");
  AddDetail( ({"grund"}),
	 "Das Wasser ist zu trueb, um bis auf den Grund zu sehen.");
  AddDetail( ({"rand"}),
	 "Der Rand der Senke ist ist im Suedosten wo Du gerade stehst "
	 "ziemlich schlammig, und an den Waenden die an die Wassermulde "
	 "grenzen hat sich befinden sich einige Kalkablagerungen.");
  AddDetail( ({"kalkablagerungen", "ablagerungen", "kalk"}),
	 "An den Waenden befinden sich einige Kalkablagerungen.");
  AddDetail( ({"suedosten","eingang"}),
	 "Im Suedosten befindet sich der Eingang zur Mooshoehle.");
  AddDetail( ({"trinkwasserqualitaet","wasserqualitaet","qualitaet",
               "trinkwasser"}),
	 "Das Wasser der Quelle ist sehr klar, bestimmt kann man es "
	 "trinken.");
  AddDetail( ({"wasser","wassers"}),
	 "Das Wasser der Quelle scheint Trinkwasser zu sein, aber das in "
	 "der Lache ist ziemlich trueb vom aufgewirbelten Schlamm.");
  AddDetail( ({"schlamm"}),
	 "Der Boden ist auf Deiner Seite der Lache sehr schlammig. "
	 "Du kannst ein paar kleine Wuermer im Schlamm erkennen.");
  AddDetail( ({"boden"}),
	 "Hier wo Du stehst ist der Boden noch mit Moos bedeckt, aber je "
	 "naeher man an die Lache herantritt, wird er immer schlammiger.");
  AddDetail( ({"moose","moos", "pilze", "pilz"}),
	 "Auf dem trockenen Teil dieser Hoehle wachsen einige Moose und "
	 "Pilze am Boden.");
  AddDetail( ({"mooshoehle"}),
	 "Die grosse Mooshoehle befindet sich im Suedosten.");
  AddDetail( ({"waende","waenden"}),
	 "Die Waende bestehen aus hartem Felsgestein und dort wo "
	 "Wasser an die Waende grenzt befinden sich einige "
	 "Kalkablagerungen.");
  AddDetail( ({"felsgestein","gestein","fels"}),
	 "Hartes Felsgestein.");
  AddDetail( ({"decke"}),
	 "Die Decke ist hier sehr hoch und besteht aus hartem Fels.");
  AddDetail( ({"spalten", "furchen","rinnen","rillen"}),
	 "In den Waenden befinden sich viele Spalten und Furchen aus denen "
	 "Wasser austritt und sich zu einer kleinen Quelle vereinigt.");
  AddDetail( ({"seite"}),
	 "Auf dieser Seite der Lache ist der Boden ziemlich schlammig.");
  AddDetail( ({"gefuehl"}),
	 "Ein sehr beruhigendes Gefuehl.");
  AddDetail( ({"stelle"}),
	 "An einer Stelle muenden die kleinen Baeche in die Mulde.");
  AddDetail( ({"jahrhunderte"}),
	 "Es hat Jahrhunderte gedauert bis das Wasser solche Furchen und "
	 "Rillen in den Boden geschnitten hat.");
  AddDetail( ({"risse"}),
	 "In einem der Risse waechst Etwas.");
  AddDetail( ({"riss"}),
	 "Du koenntest mal versuchen hinein zu fassen.");
  AddDetail( ({"etwas"}),
	 "Wirklich interessant dieser Riss.");
  AddDetail( ({"wuermer","wurm"}),
	 "Du koenntest versuchen einen heraus zu locken.");


/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Du hoerst das lustige Plaetschern der Quelle.");
  AddSound( ({"plaetschern", "quelle"}),
	 "Lustig plaetschert die Quelle vor sich hin.");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Die Luft hier riecht kuehl und erfrischend.");
  AddSmell( ({"luft", "quelle"}),
	 "Wirklich nicht schlecht diese Luft!");

/* Roommessage */

  AddRoomMessage( ({
  	"Die Quelle plaetschert lustig vor sich hin.\n",
	"Ploetzlich kraeuselt sich die Oberflaeche des Wassers.\n",
	"Irgendetwas bewegt sich am Grund der Mulde.\n" }),330);

/* Definition der Funktionen */

  AddCmd( ({"tauche", "tauch","springe","spring"}), "fkttauche");
  AddCmd( ({"trinke", "trink"}),                    "fkttrinke");
            trinkwasser=5;
  AddCmd( ({"fasse", "fass","greife","greif"}),     "fktfasse");
            flechte=1;
  AddCmd( ({"locke", "lock"}),                      "fktlocke");
            tierchencounter=1;

/* Ausgaenge */

  AddExit( "suedosten", ROOM "/hain3" );

/* NPCs und Objekte */

//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");
}



fkttauche(string str)
{

  notify_fail ("Wo willst Du reinspringen?\n");
  if (!str) return 0;

	

  if  (	 str=="in mulde" ||
	 str=="in wasser" ||
	 str=="rein"||
	 str=="in lache" ||
	 str=="in senke"||
	 str=="hinein"){
    if(TP->QueryProp(P_LEVEL)>20){
      write("Du springst in das Wasser.\n");
      TP->move( ROOM "/lache.lpc", M_GO, "ins Wasser" ,"springt",
        "kommt ins Wasser gesprungen");
      return 1;
    }
    else{
      write(BS("Das Wasser kommt zu unheimlich vor, um da reinzuspringen.\n"));
      say(BS(TPN+" traut sich nicht ins Wasser zu springen.\n"));
      return 1;
    }      
  }
  else return 0;
}

fkttrinke(string str)
{

  notify_fail ("Was willst Du trinken?\n");
  if (!str) return 0;

	

  if  (	 str=="wasser aus quelle" ||
	 str=="wasser aus baechen" ||
	 str=="wasser aus baechlein"||
	 str=="trinkwasser" ||
	 str=="wasser der quelle"||
	 str=="wasser der baechlein")
  {
    if (trinkwasser)
    {
      write("Du trinkst von dem Wasser aus der Quelle. "
            "Das Wasser erfrischt Dich und Du machst Dich wieder "
            "gestaerkt auf den Weg.\n");
      say  (TPN+" trinkt einen kraeftigen Schluck aus der Quelle.\n",TP);
      TP->heal_self(5+random(16));	
      TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+1);
      trinkwasser--;
      return 1;
    }
    else
    {
      write("Du trinkst von dem Wasser aus der Quelle. "
            "Das Wasser erfrischt Dich, aber irgendwie hattest Du Dir mehr "
            "erwartet.\n");
      say  (TPN+" trinkt einen kraeftigen Schluck aus der Quelle.\n",TP);	
      return 1;   	
    }
  }
  if  (	 str=="wasser aus lache" ||
	 str=="wasser aus senke" ||
	 str=="wasser aus mulde" ||
	 str=="truebes wasser"   ||
	 str=="wasser der lache" ||
	 str=="wasser der mulde" ||
	 str=="wasser der senke"){
    if(TP->QueryProp(P_LEVEL)>20){
      write("Du trinkst von dem Wasser aus der Lache. "
            "Ploetzlich kommt ein Tentakel aus dem Wasser geschossen, "
            "packt Dein Bein und zieht Dich hinein.\n");
      say  (TPN+" trinkt einen kraeftigen Schluck aus der Lache und "
            "wird ploetzlich von einem Tentakel ins Wasser gezogen.\n",TP);	
      TP->move( ROOM "/lache.lpc", M_GO, "ploetzlich futsch" ,"ist",
		"ins Wasser gezogen worden");      
      return 1;  
    }     
    else{
      write(BS("Du trinkst von dem Wasser aus der Lache, doch nichts passiert.\n"));
      say(BS(TPN+" trinkt einen kraeftigen Schluck aus der Lache.\n"));
      return 1;
    }
  }
  if (  str=="wasser"){
    write("Welches Wasser moechtest Du trinken, das aus der Quelle "
          "oder aus der Lache?\n");
    return 1;
  }
  else return 0;
}

int fktfasse(string str)
{
  object gewaechs;
  notify_fail("Wo moechtest Du reinfassen?\n");
  if(!str) return 0;
  if (!flechte) return write(BS(
     "Du greifst in den Riss und findest eine Flechte, die aber noch zu "
     "klein ist um ausgerissen zu werden.\n")),1;
  if (str=="in riss")
  {
    gewaechs = clone_object(OBJ"/flechte");
    gewaechs->move(this_player(),M_GET|M_SILENT);
    write(
    BS("Du greifst in den Riss und reisst etwas von der seltsamen "
       "Flechte aus, die Du in dem Riss findest.\n"));
    say(BS(TP->Name()+
       " greift in einen Riss und findet etwas.\n"),this_player());
    flechte--;

  return 1;
  }
}

int fktlocke(string str) 
{
  object ob;
  notify_fail("Was willst Du wo rauslocken?\n");
  if(str != "wurm aus schlamm" &&
     str != "wurm an" &&
     str != "wurm aus schlamm heraus" &&
     str != "wurm aus schlamm raus" &&
     str != "wuermer an" &&
     str != "wuermer aus schlamm" &&
     str != "wuermer aus schlamm heraus" &&
     str != "wuermer aus schlamm raus")
    return 0;
  if(tierchencounter != 1) 
  {
    write(BS(
      "Du versuchst einen Wurm aus dem Schlamm zu locken, doch die Wuermer "
      "verkriechen sich tief im Schlamm."));
    say(BS(
      CAP_TPN+" versucht einen Wurm anzulocken, gibt schliesslich aber "
      "enttaeuscht auf."));
    return 1;
  }
  tierchencounter=0;
  write(BS(
    "Du schaffst es einen der Wuermer aus dem Schlamm zu locken."));
  say(BS(
    CAP_TPN+" lockt erfolgreich einen Wurm aus dem Schlamm."));
  switch( random(3)) 
    {
      case 0:
        ob=clone_object( NPC "/borstenwurm" );
        break;
      case 1:
        ob=clone_object( NPC "/strudelwurm" );
        break;
      case 2:
        ob=clone_object( NPC "/schlammwurm" );
        break;
      }  
  if(ob) 
  {
    ob->move(ME,M_GO);
  }
  return 1;
}


reset()
{ object ob;
  ::reset();
  trinkwasser=5;
  flechte=1;
  while(ob=present("WASSERTIERCHEN", this_object()))
  {
    tell_room(TO, sprintf("%s verkriecht sich.\n", ob->Name(WER)));
    ob->remove();
  }
  tierchencounter=1;
}
