//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Der Moosthron
//  Erstellt  : 16.10.2000 (Orw)
//  Geaendert : 19.10.2000 (Orw)


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Der Moosthron" );
  SetProp(P_INT_LONG,
	 "Eine kleine Hoehle erstreckt sich hier nach Norden und zu Deiner "
	 "Linken und Deiner Rechten wachsen riesige Pilze. Zwischen dieser "
	 "Pilzallee fuehrt ein kleiner schmaler mit Moos gepolsterter Gang "
	 "bis zu einem Thron der fast gaenzlich aus Moosen zu bestehen "
	 "scheint. Von der Decke haengen leuchtende Flechten, die sich "
	 "bewegen als ob ein starker Wind wehen wuerde, doch Du kannst "
	 "nicht den Hauch eines Luftzuges spueren. Die Waende glitzern "
	 "und sind mit klitzekleinen Bergkristallen besetzt. Ein traumhaft "
	 "schoener Anblick, Du bist ganz hin und weg.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({"raum", "hoehle", "mooshoehle","pilzhoehle","grotte"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"norden"}),
	 "Die Hoehle ist laenglich und dehnt sich nach Norden noch "
	 "einige Meter aus.");
  AddDetail( ({"meter"}),
	 "Eine Masseinheit.");
  AddDetail( ({"masseinheit","einheit" }),
	 "Meter ?");
  AddDetail( ({"linken", "rechten","links","rechts"}),
	 "Du stehst inmitten einer Pilzallee, links und rechts befinden "
	 "riesige Pilze.");
  AddDetail( ({"pilze"}),
	 "Pilze, so gross wie Du noch nie welche gesehen hast! Die meisten "
	 "sind bestimmt einen Meter gross.");
  AddDetail( ({"pilzallee","allee","seite"}),
	 "An der linken und der rechten Seite der Hoehle wachsen riesige "
	 "Pilze.");
  AddDetail( ({"moos", "moose", "moosen"}),
	 "Saftiges gruenes Moos waechst ueberall am Boden, zwischen den "
	 "Pilzen und der Thron ist gaenzlich damit ueberwuchert.");
  AddDetail( ({"gang"}),
	 "Der Gang fuehrt durch die Pilzallee, bis zu einem grossen, mit "
	 "Moos ueberwucherten Thron.");
  AddDetail( ({"thron", "moosthron"}),
	 "Der Thron steht an der Nordwand der Hoehle und ist gaenzlich "
	 "mit Moos ueberwuchert. Du bist Dir sicher, dass er bestimmt sehr "
	 "weich und angenehm ist.");
  AddDetail( ({"nordwand", "wand"}),
	 "An der Nordwand steht ein grosser Thron.");
  AddDetail( ({"boden","moosboden"}),
	 "Der Boden ist durch das viele Moos sehr weich und links und "
	 "rechts vom Gang wachsen riesige Pilze.");
  AddDetail( ({"decke"}),
	 "Die Decke ist bestimmt fuenf Meter hoch, es besteht keine Gefahr, "
	 "das Du Dir den Kopf stosst.");
  AddDetail( ({"gefahr"}),
	 "Hm... im Moment ist keine Gefahr zu entdecken.");
  AddDetail( ({"moment"}),
	 "Moment mal! Denk vorher nach, was Du untersucht....");
  AddDetail( ({"flechten","flechte"}),
	 "Lange Flechten haengen von der Decke und scheinen sich im Wind "
	 "zu bewegen, obwohl man nicht den kleinsten Lufthauch spueren "
	 "kann.");
  AddDetail( ({"wind","lufthauch","luftzug","hauch","luftzuges"}),
	 "Hier herrscht totale Windstille.");
  AddDetail( ({"windstille","stille"}),
	 "Nicht der kleinste Luftzug zu spueren.");
  AddDetail( ({"waende"}),
	 "Die Waende bestehen aus kahlen Felsgestein. Sie glitzern und "
	 "scheinen mit kleinen Bergkristallen uebersaeht zu sein.");
  AddDetail( ({"bergkristalle", "kristalle", "bergkristallen"}),
	 "Sie sind leider zu klein, um sie mitzunehmen.");
  AddDetail( ({"anblick"}),
	 "Ein wahrlich traumhafter Anblick.");
  AddDetail( ({"felsgestein","gestein"}),
	 "Das Felsgestein glitzert wegen der kleinen Bergkristalle, "
	 "die sich darauf befinden.");
  AddDetail( ({"essen"}),
	 "Mhm, gudi *lechz*.");
  AddDetail( ({"zwergenkopf","zwerg","troll","kopf","sorge","schultern",
         "pilzen","etwas"}),
	 "Uninteressant.");


  AddDetail( ({"kopf"}),
	 ([ 0:
	  "Das runde Etwas zwischen Deinen Schultern.\n",
	  "trolle":
	  "Du gebrauchst ihn zwar nicht oft, aber was das ist muesste sogar "
	  "ein Troll wissen.\n",
	  "zwerg":
	  "Keine Sorge, Du wirst Dir Deinen Zwergenkopf bestimmt nicht "
	  "stossen. Welcher Zwerg ist fuenf Meter gross?n",
	  "oger":
	  "Dein Kopf denkt wie immer nur ans Essen.\n"
       	 ]) );




/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Hier ist es totenstill.");
  AddSound( ({"stille"}),
	 "Nichts zu hoeren.");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Hier riecht es ganz angenehm nach Moos und Pilzen.");
  AddSmell( ({"moos", "pilze","geruch"}),
	 "Gar kein so schlechter Geruch.");


/* Definition der Funktionen */

  AddCmd( ({"setze", "setz", "sitz", "sitze"}), "fktsetzen");
//  AddCmd (({"", ""}),     "fktyyy");

/* Ausgaenge */

  AddExit( "suedwesten", ROOM "/hain4" );

/* NPCs und Objekte */

  AddItem( NPC "/mykal", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");
}

int fktsetzen(string str)
{
  notify_fail("Worauf moechtest Du Dich setzen?\n");
  if(!str) return 0;
  if(str == "auf moosthron" ||
     str == "auf thron")
  {
    if (TP->QueryProp(P_RESTING)){
      write("Aber Du rastest Dich doch schon aus!\n");
      return 1;
    }
    if (QueryProp(P_GHOST)){
      write("Als Geist kannst Du nicht rasten oder Ruhe finden!\n");
      return 1;
    }
    if (time() < TP->QueryProp(P_LAST_AWAKE_TIME) + 300){
      write("Du hast Dich doch vor kurzem erst ausgeruht.\n");
      return 1;
    }
    if (present("QUESTFLUFFI",ENV(TP))){
      write("Mykal sagt: Wage es nicht Dich auf meinen Thron zu setzen!\n");
      return 1;
    }
    write(BS("Du setzt Dich auf den Moosthron und machst es "
             "Dir gemuetlich."));
    say(BS(TPN+" setzt sich gemuetlich auf den Moosthron und schliesst "
        "die Augen."));
    TP->command_me("raste");
    return 1;
  }
  return 0;
}