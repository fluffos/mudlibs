//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Ein riesiger Moosrasen
//  Erstellt  : 09.10.2000 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int tierchencounter;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein riesiger Moosrasen" );
  SetProp(P_INT_LONG,
	 "Erstaunt siehst Du Dich in dieser Hoehle um. In diesem Teil, der "
	 "sonst so kahlen Grotte, befindet sich ein riesiger Teppich aus "
	 "Moos. Auch einige andere Pflanzen wachsen hier und strahlen ein "
	 "gruenliches Licht aus. Gesteinsbrocken und grosse glatte Steine "
	 "liegen im Moos und sind ueberwuchert von kleinen Pilzen und "
	 "Farnen. Die Hoehle dehnt sich von Westen bis Norden noch weiter "
	 "aus und von der Decke haengen jede Menge gruene und braune "
	 "Flechten. Du sinkst beim gehen bis zu den Knoecheln in den "
	 "weichen feuchten Moosboden ein.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({ "hoehle", "grotte", "teil","raum","hoehlen"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"teppich", "moosteppich", "moosboden","boden"}),
	 "Ein riesiger Teppich aus Moosen, Farnen und anderen Pflanzen. "
	 "Der Boden ist hier sehr weich und auch sehr feucht, Du sinkst "
	 "beim gehen bis zu den Knoecheln ein.");
  AddDetail(({"moos","moose","moosen"}),
	 "Das Moos waechst hier besonders gut und bietet den kleinen "
	 "Hoehleninsekten ein kuschliges Zuhause.");
  AddDetail( ({ "pflanzen" }),
	 "In dieser Hoehle wachsen viele Arten von Pflanzen die Du noch "
	 "nie gesehen hast, darunter sind gruenweisse Farne, braune und "
	 "weisse Pilze, gruenbraune Flechten die von der Decke haengen "
	 "und gruenlich schimmernde Grashalme die den Raum ein wenig "
	 "erhellen.");
  AddDetail( ({ "farne", "farn","farnen"}),
	 "Die Farne in dieser Grotte sind gruenweisslich und haben sich gut "
	 "an die Bedingungen der spaerlich beleuchteten Hoehle angepasst.");
  AddDetail( ({"pilze", "pilz", "braune pilze", "weisse pilze","pilzen"}),
	 "Die Pilze wuchern an den Waenden und auf auf den Steinen, die "
	 "im Moos liegen. Sie sehen nicht besonders appetitlich aus.");
  AddDetail( ({"flechten","flechte"}),
	 "Von der Decke haengen lange, gruene und braune Flechten, welche "
	 "sehr feucht sind und im Licht der leuchtenden Grashalme lustig "
	 "funkeln und glitzern.");
  AddDetail( ({"grashalme", "halme", "gras", "grashalm", "halm"}),
	 "Jetzt weisst Du woher dieses gruenliche Schimmern kommt, "
	 "die Grashalme stroemen das Licht aus und tauchen die Hoehle "
	 "in ein gespenstisches Leuchten.");
  AddDetail( ({"licht", "leuchten", "schimmern"}),
	 "Grosse Grashalme verleihen der Hoehle ein gespenstisches "
	 "Leuchten.");
  AddDetail( ({"gesteinsbrocken", "brocken", "steine","steinen"}),
	 "Im Moos liegen einige grosse und kleine Gesteinsbrocken, die "
	 "das Zuhause einiger Pilze und Farne geworden sind. "
	 "Ein Stein faellt Dir besonders auf.");
  AddDetail( ({"zuhause", "heim", "hause"}),
	 "Die Hoehle ist ein Zuhause fuer viele Hoehleninsekten, "
	 "Fledermaeuse und Pflanzen.");
  AddDetail( ({"hoehleninsekten","insekten","hoehlentierchen","tierchen"}),
	 "Kleine Krabbeltierchen die im Moos, unter Steinen oder in "
	 "Pfuetzen wohnen. Vielleicht findest Du ja einige.");
  AddDetail( ({"pfuetzen", "pfuetze"}),
	 "Hier sind keine Pfuetzen, das Moos hat das ganze Wasser "
	 "aufgesaugt.");
  AddDetail( ({"wasser"}),
	 "Die ganze Hoehle ist sehr feucht, hier wird aber das Wasser "
	 "vom Moos aufgesaugt.");
  AddDetail( ({"krabbeltierchen","tierchen"}),
	 "Vielleicht findest Du ja einige dieser kleinen Tierchen.");
  AddDetail( ({"fledermaeuse","fledermaus"}),
	 "Einige Fledermaeuse haengen zwischen den Flechten an der Decke.");
  AddDetail( ({"menge"}),
	 "Jede Menge Flechten haengen an der Decke.");
  AddDetail( ({"waende","wand","ritzen","spalten","waenden"}),
	 "In allen Ritzen und Spalten der Waende wuchern Pilze.");
  AddDetail( ({"westen","norden"}),
	 "Die Hoehle dehnt sich nach Westen und Norden aus, sie scheint "
	 "ein schoenes Zuhause fuer viele Hoehleninsekten und Pflanzen "
	 "zu sein.");
  AddDetail( ({"knoecheln", "knoechel"}),
	 "Bis zu den Knoecheln versinkst Du im weichen Moosboden.");
  AddDetail( ({"fuesse"}),
	 "Hoffentlich stinken die nicht!");
  AddDetail( ({"bedingungen","bedingung"}),
	 "Die Farne und anderen Pflanzen haben sich daran angepasst.");
  AddDetail( ({"arten","vegetation"}),
	 "Hier gibt es viele Arten von Pflanzen.");
  AddDetail( ({"stein"}),
	 "Dieser Stein ist mit besonders viel Moos ueberwuchert. Ein "
	 "ideales Zuhause kleine Hoehlentierchen. Du koenntest "
	 "versuchen ihn umzudrehen.");
  AddDetail( ({"geraeusche"}),
	 "Du koenntest ihnen lauschen!");
  AddDetail( ({"elf","elfennase","gedanke","hobbitnase","kopf",
         "ogernase","trollnase"}),
	 "Hmm...!");


  AddDetail( ({"decke"}),
	 ([ 0:
	  "Die Decke ist hier sehr hoch. Die vielen Flechten, die von ihr "
	  "herunterhaengen, faszinieren Dich.\n",
	  "zwerg":
	  "Noch nie hast Du eine so schoene Hoehle gesehen. Die Decke ist "
	  "hoch ueber Deinem Kopf. Zwerge lieben Hoehlen und diese ist "
	  "besonders schoen.\n",
	  "elf":
	  "Obwohl Du als Elf normalerweise keine Hoehlen magst, fasziniert "
	  "Dich diese gespenstisch wirkende Vegetation.\n",
	  "troll":
	  "Du freust Dich, dass Du endlich wieder aufrecht stehen kannst.\n",
	  "hobbit":
	  "Fasziniert starrst Du auf die vielen glitzernden Flechten, die "
	  "von der Decke haengen. Hobbits lieben Pflanzen auch wenn sie "
	  "in solchen kalt feuchten Hoehlen beheimatet sind.\n",
	  "oger":
	  "Dein erster Gedanke ist, ob man irgendwelche dieser Flechten und "
	  "Pilze essen kann. Die Decke ist sehr hoch und Du kannst sie "
	  "nichtmal erreichen wenn Du raufspringen wuerdest.\n"

	 ]) );


/* Spezielle Details */

//  AddSpecialDetail( ({""}), "zzz" );


/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Du hoerst das Quatschen Deiner Fuesse auf dem nassen Moosteppich.");
  AddSound( ({"quatschen","geraeusch"}),
	 "Ein ziemlich lustiges Geraeusch in dieser kalt feuchten Hoehle.");



/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Es riecht hier nach modrigem Moos und vefaulten Pilzen.");

  AddSmell (({"moos", "pilze", "luft","geruch"}),
	 ([ 0:
	  "IEHH! Das stinkt.\n",
	  "zwerge":
	  "Du findest diesen Geruch nichtmal schlecht, auch die kuehle "
	  "Luft der Hoehle macht Dir nichts aus.\n",
	  "elf":
	  "Der Geruch schmerzt in Deiner empfindlichen Elfennase.\n",
	  "troll":
	  "Du ruempfst Deine dicke Trollnase.\n",
	  "hobbit":
	  "Du ruempfst Deine kleine Hobbitnase.\n",
	  "oger":
	  "Der Geruch macht Dir nichts aus, Deine Ogernase ist einiges "
	  "gewoehnt.\n"

	 ]) );

/* Roommessage */

  AddRoomMessage( ({
  	"Wasser tropft von den Flechten ins weiche Moos.\n"
	"Deine Fuesse machen komische Geraeusche im nassen Moos.\n"}),330);

/* Definition der Funktionen */

  AddCmd( ({"drehe", "dreh"}), "fktdrehe");
        tierchencounter=1;
//  AddCmd (({"", ""}),     "fktyyy");

/* Ausgaenge */

  AddExit( "suedoben", ROOM "/grotte18" );
  AddExit( "sueden",   ROOM "/grotte18" );
  SetProp( P_HIDE_EXITS, ({"sueden"}) );
  AddExit( "westen",   ROOM "/hain2");
  AddExit( "norden",   ROOM "/hain4");

/* NPCs und Objekte */

  AddItem( NPC "/segler", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");
}

int fktdrehe(string str) 
{
  object ob;
  notify_fail("Was willst Du umdrehen?\n");
  if(str != "stein" &&
     str != "stein um")
    return 0;
  if(tierchencounter != 1) 
  {
    write(BS(
      "Du drehst den Stein um kannst aber leider gar nichts finden."));
    say(BS(
      CAP_TPN+" dreht einen Stein um."));
    return 1;
  }
  tierchencounter=0;
  write(BS(
    "Als Du den Stein umdrehst, kriecht darunter ein kleines Tierchen "
    "hervor."));
  say(BS(
    CAP_TPN+" dreht einen Stein um."));
  switch( random(3)) 
    {
      case 0:
        ob=clone_object( NPC "/hoehlenassel" );
        break;
      case 1:
        ob=clone_object( NPC "/schwanz" );
        break;
      case 2:
        ob=clone_object( NPC "/schnirkelschnecke" );
        break;
      }  
  if(ob) 
  {
    ob->move(ME,M_GO);
  }
  return 1;
}


reset() 
{ object ob;
  ::reset();
  while(ob=present("LANDTIERCHEN", this_object()))
  {
    tell_room(TO, sprintf("%s verkriecht sich.\n", ob->Name(WER)));
    ob->remove();
  }
  tierchencounter=1;

}