//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Eine Nische in der Grotte
//  Erstellt  : 09.10.2000 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

string * hilfehalron;

create()
{
  ::create();

  hilfehalron = ({});

  SetProp(P_INT_SHORT, "Eine Nische in der Grotte" );
  SetProp(P_INT_LONG,
	 "Du stehst in einer kleinen Nische. Am Boden ist eine kleine "
	 "Feuerstelle und in der Ecke liegen einige Decken. Ein kleiner "
	 "Stapel Buecher steht auf einer der Decken. Ansonsten ist die "
	 "Nische ziemlich kahl. Das Gestein ist hier viel dunkler und auch "
	 "nicht so feucht, wie im uebrigen Teil der Grotte. Die Decke ist "
	 "vom Russ des Feuers schwarz gefaerbt. Im Moment ist die "
	 "Feuerstelle erloschen und ausser ein wenig vertrocknetes Moos "
	 "gibt es hier auch keine brennbaren Materialien.");
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 9, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({ "raum","grotte","raeume","raeumen","nische","feloniagrotte",
         "hoehlen"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"gang", "weg", "richtungen", "richtung","teil" }),
	 "Der Gang liegt in suedwestlicher Richtung.");

  AddDetail(({"waende","wand"}),
	 "Die Waende bestehen aus dunklem Felsgestein und die Decke "
	 "ist vom Russ schwarz gefaerbt. Dadurch wirkt die Nische "
	 "noch finsterer als sie ohnehin schon ist.");
  AddDetail( ({ "gestein","stein","felsgestein","fels","felsen" }),
	 "Die Felsen sind hier viel dunkler als in der uebrigen "
	 "Grotte. Diese Nische ist ideal, um unentdeckt zu bleiben.");
  AddDetail( ({ "bewohner"}),
	 "Hier wohnt Halron der Hoehlenforscher.");
  AddDetail( ({"zaehne","zaehnen"}),
	 "Du hast doch noch alle Deine Zaehne, oder?");
  AddDetail( ({"feuerstelle","feuers","feuer"}),
	 "Die Feuerstelle braucht der Bewohner, um sich seine Mahlzeiten zu "
	 "kochen. Die meiste Zeit brennt hier aber kein Feuer, weil "
	 "Brennstoffe in dieser Grotte ziemlich rar sind.");
  AddDetail( ({"mahlzeiten"}),
	 "Jeder muss mal was essen, wie sollte man sonst hier ueberleben?");
  AddDetail( ({"zeit"}),
	 "Ui, wie die Zeit vergeht.....!");
  AddDetail( ({"boden"}),
	 "Der Boden ist hier nicht so feucht wie im uebrigen Teil der "
	 "Grotte. Einige Decken liegen in einer Ecke.");
  AddDetail( ({"untertage","titeln","sporen","mykoniden","hufeisennasen",
	       "hufeisennase","hoehlenflora","fledermaeuse","biospelaeologie",
	     }),
	 "Du verspuerst keine Lust irgendeines dieser Buecher genauer "
	 "durchzulesen.");
  AddDetail( ({"decken"}),
	 "Die braucht der Bewohner, um nicht zu erfrieren und als "
	 "Schlafgelegenheit.");
  AddDetail( ({"decke", "stapel","schlafgelegenheit"}),
	 "Auf einer der Decken liegt ein Stapel Buecher.");
  AddDetail( ({"buecher","buch"}),
	 "Buecher mit Titeln wie z.B.:\n\n"
	 "Lebensraum Untertage\n"
	 "Biospelaeologie der Feloniagrotte\n"
	 "Hoehlenflora und -fauna\n"
	 "Mykoniden und ihre Sporen\n"
	 "Hufeisennasen und andere Fledermaeuse\n"
	 "u.s.w.\n\n"
	 "...irgendwie verspuerst Du keine Lust eines zu lesen.");
  AddDetail( ({"lust"}),
	 "Muss nicht sein....");
  AddDetail( ({"ecke","ecken"}),
	 "In einer Ecke liegen einige Decken.");
  AddDetail( ({"moment"}),
	 "Im Moment brennt kein Feuer, da hier Brennstoffe ziemlich rar "
	 "sind.");
  AddDetail( ({"luftzug","zug","lueftchen"}),
	 "Kein Lueftchen zu spueren oder zu hoeren.");
  AddDetail( ({"russ"}),
	 "Die Decke ist vom Russ des Feuers etwas schwarz gefaerbt.");
  AddDetail( ({"moos"}),
	 "Hier waechst nicht viel und Du moechtest auch kein Feuer "
	 "machen.");
  AddDetail( ({"brennstoffe","materialien","materialen","brennbares"}),
	 "Ausser verdorrtes Moos wird man in dieser Grotte nichts Brennbares "
	 "finden.");

  AddDetail( ({"regionsmagier","angrox","iwo"}),
	 "Regionsmagier sind z.B. Angrox und Iwo.");
  AddDetail( ({"orw"}),
	 "Orw hat diese Grotte erbaut.");
  AddDetail( ({"gesicht","haaren","hobbit","kopf","menge","platz",
         "probleme","rassen"}),
	 "Forschen, forschen, forschen.");


  AddDetail( ({"decke"}),
	 ([ 0:
	  "Die Decke ist hier sehr niedrig. Du ziehst Deinen Kopf ein um "
	  "nichts von dem Russ abzubekommen.\n",
	  "hobbit":
	  "Du als Hobbit hast noch viel Platz, obwohl die Decke doch sehr "
	  "niedrig ist.\n",
	  "zwerg":
	  "Du fuehlst Dich hier wie zuhause, andere Rassen haetten bestimmt "
	  "einige Probleme mit so niedrigen Decken.\n",
	  "troll":
	  "Du hast schon jede Menge Russ im Gesicht und in den Haaren. "
	  "Ist schon bloed wenn man so gross ist und an der Decke streift.\n",
	  "elf":
	  "Du ziehst vorsichtig den Kopf ein um nichts von dem Russ "
	  "abzubekommen. Elfen sind einfach nicht fuer solch dreckige "
	  "Hoehlen geschaffen.\n"

	 ]) );



/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Hier ist es sehr still, nichtmal einen kleinen Luftzug "
	 "kann man hoeren. Nur Du machst Geraeusche.");
  AddSound( ({"murmeln", "geraeusche"}),
	 "Du knirschst mit den Zaehnen.");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	  "Die Luft riecht etwas abgestanden und modrig.");
  AddSmell (({"luft", "geruch"}),
	 ([ 0:
	  "Riecht nicht besonders gut, Du ruempfst Deine Nase.\n",
	  "zwerg":
	  "Du bist solche Hoehlengerueche gewohnt.\n",
	  "hobbit":
	  "Riecht nicht besonders gut, Du ruempfst Deine kleine Hobbitnase.\n",
	  "elf":
	  "Riecht nicht besonders gut, Du ruempfst Deine empfindliche "
	  "Elfennase.\n",
	  "troll":
	  "Trollnasen macht so ein modriger Gruch nichts aus.\n",
	  "oger":
	  "Trotz des modrigen Geruchs, denkst Du mal wieder nur an Essen. "
	  "Du bist eben ein Oger, was kannst man da schon machen.\n"

	 ]) );


/* Ausgaenge */

  AddExit( "suedwesten", ROOM"/grotte16" );


/* NPCs und Objekte */

  AddItem( NPC "/halron", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");

}

set_hilfehalron(string newhilfehalron)
{
  hilfehalron = newhilfehalron;
}

get_hilfehalron()
{
  return hilfehalron;
}