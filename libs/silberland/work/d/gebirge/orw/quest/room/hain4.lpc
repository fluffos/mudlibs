//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Die Mooshoehle
//  Erstellt  : 13.10.2000 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Mooshoehle" );
  SetProp(P_INT_LONG,
	 "Hier wachsen sehr viele Pilze, in allen nur erdenklichen Farben "
	 "und Groessen. Grosse Gesteinsbrocken, welche mit Farnen und Moosen "
	 "ueberwuchert sind, liegen auf dem nach Nordosten leicht "
	 "ansteigenden Hoehlenboden. Ein Durchgang in der Wand vor Dir, "
	 "fuehrt in eine seltsame Pilzhoehle, aus der stapfende Geraeusche "
	 "an Dein Ohr dringen. An den Waenden wachsen einige Ranken einer "
	 "Dir unbekannten Pflanze, deren Blaetter ein giftiges Gruen "
	 "ausstrahlen und um den Durchgang einen lebendigen Torbogen bilden. "
	 "Zwischen den Gesteinsbrocken wachsen einige leuchtende "
	 "Grasbueschel, welche die Hoehle in ein magisches Licht huellen.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({ "mooshoehle", "hoehle", "grotte", "raum"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({ "pilze","pilzen"}),
	 "Sehr viele Pilze, in allen nur erdenklichen Farben und Groessen "
	 "wachsen in dieser Hoehle.");
  AddDetail( ({ "farben","farbe"}),
	 "Du siehst Pilze in blau, gruen, rot, gelb, violett und noch viele "
	 "andere.");
  AddDetail( ({ "blau","rot","gelb","violett" }),
	 "Sehr viele verschiedene Farben.");
  AddDetail( ({ "groessen", "groesse"}),
	 "Von ganz kleinen Pilzen, bis zu solchen, deren Kappe "
	 "so gross wie die Handflaeche eines Trolls ist.");
  AddDetail( ({"gesteinsbrocken", "brocken", "steine"}),
	 "Die Gesteinsbrocken sind ganz mit Farnen und Moosen ueberwachsen "
	 "und liegen auf dem weichen Moosboden.");
  AddDetail( ({"moosboden","hoehlenboden","boden"}),
	 "Der Hoehlenboden ist mit vielen Pilzen, Grasbuescheln und "
	 "sehr viel Moos uebersaet. Nach Nordosten steigt der Boden "
	 "leicht.");
  AddDetail( ({"pflanzen"}),
	 "Viele Farne, Flechten, Pilze, Graeser, ein dichter Moosteppich "
	 "und einige Ranken einer Dir unbekannten Pflanze.");
  AddDetail( ({"pflanze","ranken"}),
	 "Die Pflanze bildet um den Durchgang im Nordosten einen "
	 "lebendigen Torbogen. Ihre Blaetter sehen sehr giftig aus "
	 "und strahlen in einem saftigen Gruen.");
  AddDetail( ({"farne", "farn", "farnen"}),
	 "Die Farne wachsen hauptsaechlich auf den grossen "
	 "Gesteinsbrocken.");
  AddDetail( ({"flechten", "flechte"}),
	 "Von der Decke haengen viele braune und gruene Flechten.");
  AddDetail( ({"graeser","gras","grasbueschel","grashalme","bueschel",
         "halme","grashalm","halm","grasbuescheln"}),
	 "Das Gras strahlt in einem hellen gruenen Licht.");
  AddDetail( ({"licht"}),
	 "Das gruene Licht der Graeser erhellt den ganzen Raum.");
  AddDetail( ({"moosteppich", "teppich"}),
	 "Der Boden ist dicht mit Moos ueberwachsen, sodass man von "
	 "einem richtigen Moosteppich sprechen kann.");
  AddDetail( ({"moos","moose","moosen"}),
	 "Dunkles, gruenes, weiches Moos.");
  AddDetail( ({"decke"}),
	 "Die Decke ist hier sehr hoch, Du kannst ohne Probleme "
	 "aufrecht stehen. Einige Flechten haengen herunter.");
  AddDetail( ({"probleme","problem"}),
	 "Du kannst aufrecht stehen, ...also kein Problem, oder?");
  AddDetail( ({"nordosten"}),
	 "In der noerdoestlichen Wand befindet sich ein grosser "
	 "Durchgang, der in eine seltsame Pilzhoehle fuehrt.");
  AddDetail( ({"wand"}),
	 "Die Wand im Nordosten ist von einigen Ranken ueberwachsen, "
	 "die um einen grossen Durchgang einen lebendigen Torbogen "
	 "bilden.");
  AddDetail( ({"durchgang", "gang"}),
	 "Im Nordosten befindet sich ein Durchgang zu einer seltsamen "
	 "Pilzhoehle.");
  AddDetail( ({"pilzhoehle"}),
	 "Ausser, dass darin viele Pilze wachsen, kannst Du von hier nichts "
	 "erkennen.");
  AddDetail( ({"geraeusche"}),
	 "Woher die wohl kommen?");
  AddDetail( ({"ohr"}),
	 "Die Geraeusche dringen aus dem Nordosten an Dein Ohr.");
  AddDetail( ({"blaetter"}),
	 "Die Blaetter der Pflanze strahlen ein giftiges Gruen aus.");
  AddDetail( ({"waende","waenden"}),
	 "Die Waende sind aus hartem Felsgestein. An einer Wand waechst "
	 "eine Dir unbekannte Pflanze.");
  AddDetail( ({"felsgestein","gestein"}),
	 "Sehr hartes Felsgestein auf dem einige Ranken wachsen.");
  AddDetail( ({"gruen","giftgruen"}),
	 "Die seltsame Pflanze hat giftgruene Blaetter und hier wachsen "
	 "auch einige gruene Pilze.");
  AddDetail( ({"torbogen","bogen"}),
	 "Der Torbogen besteht ausschliesslich aus den Ranken der "
	 "seltsamen Pflanze.");
  AddDetail( ({"kappe","kappen"}),
	 "Du findest hier auch Pilze mit Kappen, so gross wie die "
	 "Handflaechen eines Trolls.");

  AddDetail( ({"handflaeche","haende","troll","trolle","trolls",
               "handflaechen","tag"}),
	 ([ 0:
	  "Ein Troll hat riesige Haende.\n",
	  "troll":
	  "Du siehst jeden Tag selbst wie gross Deine Handflaechen sind.\n"
	 ]) );


/* Spezielle Details */

//  AddSpecialDetail( ({""}), "zzz" );



/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Du hoerst leise stapfende Geraeusche aus der Pilzhoehle.");
  AddSound( ({"stapfen", "geraeusche","geraeusch"}),
	 "Wer wohl diese Geraeusche erzeugt?");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Ausser dem Duft der Pflanzen und Pilze kannst Du nichts "
	 "Besonderes riechen.");
  AddSmell( ({"duft", "pflanzen","pilze"}),
	 "Riecht gar nicht so schlecht.");

/* Definition der Funktionen */

//  AddCmd( ({"", "", ""}), "fktxxx");
//  AddCmd (({"", ""}),     "fktyyy");

/* Ausgaenge */

  AddExit( "sueden",    ROOM "/hain1" );
  AddExit( "westen",    ROOM "/hain3");
  AddExit( "nordosten", ROOM "/thron");

/* NPCs und Objekte */

//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");
}
