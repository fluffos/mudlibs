inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include "../def.h"

int tierchencounter;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Mooshoehle" );
  SetProp(P_INT_LONG,
	 "In diesem Teil der Mooshoehle ist das Moos besonders saftig und "
	 "gruen. Im Nordwesten hoerst Du das Plaetschern einer kleinen "
	 "Quelle, welche bestimmt der Grund fuer die zahlreichen Pflanzen "
	 "hier ist. Die Pilze werden hier weniger, dafuer spriessen die "
	 "Farne an Waenden und am Boden. Das lustige Plaetschern der Quelle "
	 "lockert die sonst kalte und duestere Stimmung der Grotte etwas "
	 "auf. Flechten und kleine Wurzeln, bedeckt mit glitzernden "
	 "Wassertropfen, haengen von der Decke und verleihen der Hoehle "
	 "ein magisches Flair.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({"teil", "mooshoehle", "hoehle", "raum", "grotte","hoehlen"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"moos"}),
	 "Hier ist das Moos besonders gruen und saftig.");
  AddDetail( ({"nordwesten"}),
	 "Im Nordwesten befindet sich ein kleiner Zugang zu einer "
	 "Quelle. Das lustige Plaetschern zieht Dich magisch an.");
  AddDetail( ({"quelle","zugang"}),
	 "Die Quelle liegt im Nordwesten und bewaessert diesen Teil "
	 "der Hoehle. Viele Pflanzen wachsen im feuchten Moosboden.");
  AddDetail( ({"plaetschern", "geraeusch"}),
	 "Du koenntest dem Geraeusch lauschen.");
  AddDetail( ({"grund"}),
	 "Die Quelle ist bestimmt der Grund fuer die zahlreichen "
	 "Pflanzen in diesem Teil der Grotte.");
  AddDetail( ({"pflanzen","hoehlenpflanzen","vegetation"}),
	 "Farne, Flechten, Graeser und ein paar Pilze wachsen hier "
	 "am Boden, an den Waenden und an der Decke.");
  AddDetail( ({"farne", "farn", "farnbueschel", "bueschel","farnen"}),
	 "An den Waenden und am Boden wachsen viele Farnbueschel die "
	 "in saftig gruen erstrahlen.");
  AddDetail( ({"pilze", "pilz"}),
	 "Die Pilze sind hier nicht mehr so zahlreich, trotzdem wachsen "
	 "noch einige zwischen den Farnen und den Flechten an der Decke.");
  AddDetail( ({"graeser", "gras", "grashalme", "grashalm","halm","halme",
         "grashalmen"}),
	 "Einige Graeser und laengere Grashalme wachsen aus dem dichten "
	 "Moosteppich und strahlen ein magisches gruenes Licht aus.");
  AddDetail( ({"flechten", "flechte"}),
	 "Lange braune und gruene Flechten haengen von der Decke und "
	 "glitzern im magisch gruenen Licht der Graeser.");
  AddDetail( ({"wurzeln"}),
	 "Von der Decke haengen auch einige kleine Wurzeln von Farnen "
	 "und anderen Pflanzen.");
  AddDetail( ({"waende", "waenden","wand"}),
	 "Die Waende sind feuchtkalt und bedeckt von vielen "
	 "Hoehlenpflanzen.");
  AddDetail( ({"boden", "moosboden"}),
	 "Der Boden ist mit einem riesigen Moosteppich bedeckt.");
  AddDetail( ({"moosteppich","teppich"}),
	 "Dichtes Moos bedeckt den ganzen Boden der Hoehle. An einer "
	 "etwas tieferen Stelle hat sich eine Pfuetze angesammelt.");
  AddDetail( ({"stimmung"}),
	 "Die ansonst duestere Stimmung der Hoehle wird hier durch das "
	 "lustige Plaetschern der Quelle aufgelockert.");
  AddDetail( ({"flair"}),
	 "Die mit Wassertropfen bedeckten Pflanzen, welche im gruenen "
	 "Licht der Grashalme glitzern, verleihen der Hoehle ein magisches "
	 "Flair.");
  AddDetail( ({"wassertropfen","tropfen"}),
	 "Die Pflanzen in diesem Teil der Grotte sind mit vielen "
	 "kleinen Wassertropfen bedeckt.");
  AddDetail( ({"licht"}),
	 "Von den Grashalmen geht ein magisch gruenes Licht aus.");
  AddDetail( ({"stelle", "pfuetze"}),
	 "Klares, kaltes Wasser hat sich hier angesammelt.");
  AddDetail( ({"wasser"}),
	 "Als Du das Wasser genauer betrachtest faellt Dir ein kleines "
	 "Tierchen auf.");
  AddDetail( ({"tierchen","tier"}),
	 "Du koenntest versuchen es heraus zu ziehen.");
  AddDetail( ({"kopf","gedanke","elf","weile"}),
	 "Du gruebelst eine Weile vor Dich hin.");

  AddDetail( ({"decke"}),
	 ([ 0:
	  "Die Decke ist hier sehr hoch. Die vielen Farne die von ihr "
	  "herunterhaengen faszinieren Dich.\n",
	  "zwerg":
	  "Noch nie hast Du eine so schoene Hoehle gesehen. Die Decke ist "
	  "hoch ueber Deinem Kopf. Zwerge lieben Hoehlen und diese ist "
	  "besonders schoen.\n",
	  "elf":
	  "Obwohl Du als Elf normalerweise keine Hoehlen magst, fasziniert "
	  "Dich diese magisch wirkende Vegetation.\n",
	  "hobbit":
	  "Fasziniert starrst Du auf die vielen Farne und Flechten, die an "
	  "den Waenden und der Decke wachsen. Hobbits lieben Pflanzen auch "
	  "wenn diese in solchen kalt feuchten Hoehlen beheimatet sind.\n",
	  "oger":
	  "Dein erster Gedanke ist, ob man irgendwelche dieser Farne und "
	  "Pilze essen kann. Die Decke ist sehr hoch und Du kannst sie "
	  "nichtmal erreichen wenn Du raufspringen wuerdest.\n"

	 ]) );


/* Spezielle Details */

//  AddSpecialDetail( ({""}), "zzz" );


/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Das Plaetschern der Quelle dringt aus dem Nordwesten zu Dir.");
  AddSound( ({"plaetschern", "geraeusch","quelle"}),
	 "Das Plaetschern zieht Dich magisch an.");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Hier riechts nicht so modrig wie im uebrigen Teil der Grotte.");

/* Definition der Funktionen */

  AddCmd( ({"ziehe", "zieh"}), "fktziehe");
         tierchencounter=1;
//  AddCmd (({"", ""}),     "fktyyy");

/* Ausgaenge */

  AddExit( "sueden",     ROOM "/hain2" );
  AddExit( "nordwesten", ROOM "/quelle");
  AddExit( "osten",      ROOM "/hain4");

/* NPCs und Objekte */

//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");
}


int fktziehe(string str) 
{
  object ob;
  notify_fail("Was willst Du wo rausziehen?\n");
  if(str != "tierchen aus wasser" &&
     str != "tierchen aus pfuetze" &&
     str != "tierchen aus stelle" &&
     str != "tierchen aus wasser raus" &&
     str != "tierchen aus pfuetze raus" &&
     str != "tierchen aus stelle raus" &&
     str != "tierchen aus wasser heraus" &&
     str != "tierchen aus pfuetze heraus" &&
     str != "tierchen aus stelle heraus")
    return 0;
  if(tierchencounter != 1) 
  {
    write(BS(
      "Du versuchst das Tierchen aus dem Wasser zu ziehen, doch das Tierchen "
      "ist schneller."));
    say(BS(
      CAP_TPN+" versucht etwas aus der Pfuetze zu ziehen, gibt aber "
      "schliesslich enttaeuscht auf."));
    return 1;
  }
  tierchencounter=0;
  write(BS(
    "Du schaffst es eines der Tierchen aus dem Wasser zu ziehen."));
  say(BS(
    CAP_TPN+" macht sich an der Pfuetze zu schaffen."));
  switch( random(2)) 
    {
      case 0:
        ob=clone_object( NPC "/wasserassel" );
        break;
      case 1:
        ob=clone_object( NPC "/krebs" );
        break;
      }  
  if(ob) 
  {
    ob->move(ME,M_GO);
  }
  return 1;
}


reset()
{ object ob;
  ::reset();
  while(ob=present("WASSERTIERCHEN", this_object()))
  {
    tell_room(TO, sprintf("%s verkriecht sich.\n", ob->Name(WER)));
    ob->remove();
  }
  tierchencounter=1;
}
