//  Projekt   : Die Hoehlenforscherquest
//  Raumname  : Ein Grottengang
//  Erstellt  : 09.10.2000 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Grottengang" );
  SetProp(P_INT_LONG,
	 "Der Gang verlaeuft hier von Osten nach Nordunten. Im Osten "
	 "ist es stockdunkel, doch von Nordunten schimmert ein gruenes "
	 "Licht herauf und erhellt den Raum ein wenig. Das Licht scheint "
	 "von einigen Pflanzen auszugehen, die dort unten in einem riesigen "
	 "Moosrasen wachsen. Die Waende und der Boden hier sind besonders "
	 "feucht, und die Temperatur scheint noch weiter zu sinken. "
	 "An der Decke wachsen einige Flechten und Pilze. "
	 "Im Suedwesten befindet sich eine kleine Hoehle.");
  AddId("schaender");
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 7, ENV_TERRAIN: TT_CAVE]) );

/* Detailbeschreibungen */

  AddDetail( ({ "raum","grotte","raeume","raeumen","hoehlen"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"gang", "weg", "richtungen", "richtung","teil" }),
	 "Der Gang verlaeuft hier von Osten nach Nordunten. "
	 "Was Dich im Norden wohl erwartet?");
  AddDetail(({"nordunten"}),
	 "Nordunten kannst Du einen riesigen Moosrasen erkennen. Um "
	 "ihn genauer zu untersuchen musst Du dort runter.");
  AddDetail( ({"osten"}),
	 "Im Osten kannst Du nichts besonderes erkennen.");
  AddDetail( ({"schimmern","schimmer","licht"}),
	 "Entzueckt schaust Du nach Nordunten. Das Schimmern zieht Dich "
	 "magisch an. Es erinnert Dich an das Leuchten von Gluehwuermchen.");
  AddDetail( ({"pflanzen", "pflanze"}),
	 "Von Nordunten erkennst Du ein Schimmern, das von Pflanzen stammen "
	 "koennte. Die einzigen Pflanzen in diesem Teil der Grotte sind ein "
	 "paar kleine, nicht sehr geniessbar aussehende Pilze und Flechten.");
  AddDetail( ({"acht","bloedsinn"}),
	 "Nimm Dich in Acht und untersuch nicht jeden Bloedsinn.");
  AddDetail( ({"waende","wand","waenden"}),
	 "Die Waende sind hier dunkelgrau und nur noch leicht mit violetten "
	 "Edelsteinfasern durchzogen. Durch kleine Risse in den Felsen "
	 "tritt Wasser und verleiht ihnen ein schoenes Glitzern.");
  AddDetail( ({"edelsteinfasern","fasern","edelstein","faser",
	       "edelsteingehalt","gehalt"}),
	 "Die glitzernden Felsen sind hier mit violetten Edelsteinfasern "
	 "durchzogen.");
  AddDetail( ({"risse", "riss"}),
	 "Die Waende hier sind ziemlich rissig. Alles ist ziemlich feucht "
	 "und kalt. BRRR!");
  AddDetail( ({"glitzern", "glitzer","anblick"}),
	 "Es freut Dich in diesen kalt-feuchten Raeumen so etwas schoenes "
	 "vorzufinden.");
  AddDetail( ({"felsen","fels","gestein","stein","gesteins"}),
	 "Graues, mit schimmernden Fasern durchzogenes Gestein. "
	 "Ein wahrhaft schoener Anblick.");
  AddDetail( ({"wasser"}),
	 "Hier sind einige Pfuetzen, die Waende und der Boden sind "
	 "ziemlich feucht. Pass auf, dass Du nicht ausrutschst!");
  AddDetail( ({"boden","pfuetzen","pfuetze"}),
	 "Kleine Pfuetzen und abgestorbene Pilze machen den Boden "
	 "recht glitschig.");
  AddDetail( ({"pilze","pilz"}),
	 "An den Waenden und an der Decke wachsen weisse, kleine Pilze. "
	 "Sie sehen nicht besonders lecker aus.");
  AddDetail( ({"fledermaus","fledermaeuse"}),
	 "Hier schwirren sicher einige umher, nimm Dich vor ihnen in Acht.");
  AddDetail( ({"flechten","flechte"}),
	 "Einige Flechten haengen von der Decke.");
  AddDetail( ({"schoenheit"}),
	 "Wirklich ein schoenes Glitzern.");
  AddDetail( ({"moosrasen","teppich","moosteppich","moos"}),
	 "Ein riesiger Teppich aus Moos befindet sich im noerdlichen "
	 "Raum.");
  AddDetail( ({"ohr","ohren"}),
	 "Hast Du etwa keine Ohren?");
  AddDetail( ({"temperatur"}),
	 "Die Temperatur faellt hier leicht ab. Hoffentlich hast Du genug "
	 "an um nicht zu frieren.");
  AddDetail( ({"gluehwuermchen", "leuchten", "wuermchen"}),
	 "Gluehwuermchen wirst Du in dieser Grotte vergeblich suchen.");
  AddDetail( ({"angst"}),
	 "Du bekommst maechtig Angst.");
  AddDetail( ({"suedwesten"}),
	 "Im Suedwesten befindet sich eine kleine Hoehle.");
  AddDetail( ({"hoehle"}),
	 "Eine kleine, unscheinbare Hoehle.");
  AddDetail( ({"decken","hobbit","kopf","platz","probleme","rassen","vieren"}),
	 "Du wirst muede vom vielen Untersuchen.");
  AddDetail( ({"untersuchen"}),
	 "Untersuchen kannst Du nicht untersuchen. :-)");


  AddDetail( ({"decke"}),
	 ([ 0:
	  "Die Decke ist hier sehr niedrig. Wenige cm sind zwischen ihr "
	  "und Deinem Kopf.\n",
	  "hobbit":
	  "Du als Hobbit hast noch viel Platz, obwohl die Decke doch sehr "
	  "niedrig ist.\n",
	  "zwerg":
	  "Du fuehlst Dich hier wie zuhause, andere Rassen haetten bestimmt "
	  "einige Probleme mit so niedrigen Decken.\n",
	  "troll":
	  "Du kriechst schon auf allen Vieren. Trolle sind einfach nicht "
	  "fuer solch niedrige Hoehlen geschaffen.\n",
	  "elf":
	  "Obwohl Du noch ein wenig Platz zur Decke hast, fuehlst Du Dich "
	  "sehr beengt. Du hoffst, so bald wie moeglich diese Grotte zu "
	  "verlassen.\n"

	 ]) );



/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Du hoerst das Flattern einer Fledermaus und noch Etwas, das Dir "
	 "irgendwie Angst einfloesset.");
  AddSound( ({"flattern", "geraeusch"}),
	 "Es gibt bestimmt einige Fledermaeuse hier.");
  AddSound( ({"etwas"}),
	 "Was das bloss sein mag?");
  AddSound( ({"kratzen"}),
	 "Komisch... jetzt ist es weg...");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Die Luft riecht etwas abgestanden und modrig.");
  AddSmell (({"luft", "geruch"}),
	 ([ 0:
	  "Riecht nicht besonders gut, Du ruemfst Deine Nase.\n",
	  "zwerg":
	  "Du bist solche Hoehlengerueche gewohnt.\n",
	  "hobbit":
	  "Riecht nicht besonders gut, Du ruemfst Deine kleine Hobbitnase.\n",
	  "elf":
	  "Riecht nicht besonders gut, Du ruemfst Deine empfindliche "
	  "Elfennase.\n",
	  "troll":
	  "Trollnasen macht so ein modriger Gruch nichts aus.\n",
	  "oger":
	  "Trotz des modrigen Geruchs, denkst Du mal wieder nur an Essen. "
	  "Du bist eben ein Oger, was kann man da schon machen.\n"

	 ]) );

/* Roommessage */

  AddRoomMessage( ({
  	"Du hoerst ein leises Kratzen, woher das bloss kommt?\n",
	"Bewegt sich da etwas? Hmm.. war wohl doch nichts.\n",
	"Du drehst Dich erschrocken um, war da eben etwas?\n"}),50);



/* Ausgaenge */

  AddExit( "nordunten", ROOM "/hain1" );
  AddExit( "norden",    ROOM "/hain1" );
  SetProp( P_HIDE_EXITS, ({"norden"}) );
  AddExit( "osten",     ROOM "/grotte16");


/* NPCs und Objekte */

//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( NPC "", REFRESH_DESTRUCT);
//  AddItem( "");

}