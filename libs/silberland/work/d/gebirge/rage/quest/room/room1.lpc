//Am Felsvorsprung, Rage Okt99

inherit "std/room";

#include "../def.h"

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Du stehst auf dem Felsvorsprung." );
  SetProp( P_INT_LONG,
    "Hier stehst Du nun am Felsvorsprung und blickst in den Anfaengerpark "
    "der Zwerge hinunter. Viele kleine, zierliche Tiere krabbeln am Boden "
    "herum und direkt daneben siehst Du den Gaertner, der Dir aufmunternd "
    "zuwinkt, wodurch Du beinahe deine Hoehenangst vergisst. Hinter Dir "
    "ist beruhigenderweise noch immer die Felswand. Wenn Du in die anderen "
    "Himmelsrichtungen blickst, siehst Du auch nur Felsen."
                      );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//DETAILS
  AddDetail( ({ "felsvorsprung","vorsprung" }),
    "Auf dem stehst Du gerade und blickst Dich um.");
  AddDetail( ({ "himmelsrichtungen","himmelsrichtung" }),
    "Welche ich meine, musst Du schon selbst wissen.");
  AddDetail( ({ "hoehenangst","angst" }),
    "8 Meter ueber dem sicheren Boden ist es besser, wenn Du keine hast.");
  AddDetail( ({ "park","anfaengerpark","gaertner","tier","tiere","zwerge" }),
    "Kletter wieder runter, dann kannst Du alles besser ausmachen." );
  AddDetail( ({ "zwerg","blu" }),
    "Blu steht weiter unten und winkt Dir aufmunternd zu." );
  AddDetail( ({ "fels","felsen" }),
    "Auf die anderen Felswaende wirst Du niemals raufkommen!" );
  AddDetail( ({ "felswaende","waende" }),
    "Die sind eindeutig viel zu weit weg. Glaub mir endlich.");
  AddDetail( ({ "felswand","wand" }),
    "Das Bild hat sich gegenueber vorher kaum, um nicht zu sagen gar nicht, "
    "veraendert. Wo Du auch hinblickst, gibt es nur Gestein, Risse und "
    "Spalten. Genauso wie Du dir eine typische Felswand vorgestellt hast.");
  AddDetail( ({ "bild" }),
    "Das Bild musst Du Dir schon bildlich vorstellen.");
  AddDetail( ({ "gestein" }),
    "Wie ueblich Granit. Ich erzaehle Dir da sicher nichts Neues.");
  AddDetail( ({ "granit" }),
    "Wenn Du mehr darueber wissen willst, frag einfach einen Geologen.");
  AddDetail( ({ "geologe","geologen" }),
    "Entweder Du kennst einen, oder Du wirst nie mehr ueber Granit erfahren.");
  AddDetail( ({ "boden" }),
    "Du stehst auf einem kleinen mit Kieselsteinen ueberfuellten Felsvorsprung. "
    "Zwischen zwei Felsen hat sich Dein Haken eingeklemmt, an dem das Seil "
    "hinunterhaengt.");
  AddDetail( ({ "haken","kletterhaken" }),
    "Der sitzt ganz fest, was auch gut ist, denn Du musst ja auch wieder runter.");
  AddDetail( ({ "seil" }),
    "Das wird Dir sicher beim Runterklettern helfen, also lass es dort.");
  AddDetail( ({ "runterklettern" }),
    "Nachdem ein Seil vom Felsvorsprung runterhaengt, kannst Du jederzeit auch "
    "hier runter.");
  AddDetail( ({ "fels","felsen" }),
    "Zwischen den einzigen zwei Felsen hier hat sich Dein Kletterhaken "
    "verklemmt. Das war ein exzellenter Wurf.");
  AddDetail( ({ "wurf" }),
    "Fuer diesen muss ich Dich sogar loben.");
  AddDetail( ({ "kieselsteine","kieselstein","stein","steine" }),
    "Die sind hoechstwahrscheinlich von oben heruntergekommen.");
  AddDetail( ({ "spalt","spalte","spalten" }),
    "Dir faellt nichts auf! Das bedeutet: Da ist auch nichts Wichtiges!");
  AddDetail( ({ "risse" }),
    "Einer sticht irgendwie hervor. Schau ihn ruhig mal naeher an! Er wird "
    "Dir schon nicht wehtun.");
  AddDetail( ({ "riss" }),
    "Etwas ist aeusserst verdaechtig.");
  AddDetail( ({ "etwas" }),
    "Das Etwas entpuppt sich als kleine Hoehle keine zwei Meter ueber Dir.");
  AddDetail( ({ "hoehle" }),
    "Eine Hoehle mit ungefaehr einem Meter Durchmesser. Ob da ein Lebewesen "
    "drinnen haust?");
  AddDetail( ({ "lebewesen" }),
    "Von hier siehst Du nur den Zwerg und ein paar Tiere unter Dir.");
  AddDetail( ({ "meter" }),
    "Entweder Du hast welche, oder Du hast keine.");
  AddDetail( ({ "durchmesser" }),
    "Zumindest gross genug, dass Du irgendwie reinpassen koenntest. Also "
    "klettere hin, und Du erfaehrst mehr.");     
  AddDetail( ({ "himmel" }),
    "Die Sonne strahlt mit all ihren Strahlen strahlend ins Tal.");
  AddDetail( ({ "sonne" }),
    "Gelb, gross und weit weg.");
  AddDetail( ({ "berg","berge" }),
    "Ja, ja. Es sind sehr viele davon da, auch wenn Du hauptsaechlich nur die "
    "Felswaende von ihnen sehen kannst.");
  AddDetail( ({ "tal" }),
    "Wenn Berge einen Platz umgeben, nennt man dies unter anderem Tal oder "
    "Kessel.");
  AddDetail( ({ "platz" }),
    "Du machst Platz! Steh wieder auf! Du bist schliesslich kein Hund.");
  AddDetail( ({ "hund" }),
    "Wenn Du es dir genau ueberlegst, hast Du schon lange keinen mehr hier "
    "gesehen.");
  AddDetail( ({ "kessel" }),
    "Schoen langsam kriegst Du Hunger, wenn Du an eine gute hausgemachte "
    "Suppe denkst.");
  AddDetail( ({ "suppe" }),
    "Traeum weiter!");
  AddDetail( ({ "hunger" }),
    "Allmaehlich hast Du einen.");
  AddDetail( ({ "strahl","strahlen" }),
    "Die Strahlen breiten ihr Licht ueberall hin aus. An einer Stelle in der "
    "Felswand wird es sogar reflektiert.");
  AddDetail( ({ "licht" }),
    "Hier ist es licht, woanders dunkel.");
  AddDetail( ({ "stelle" }),
    "Bei genauerem Hinsehen erkennst Du eine Muenze.");
  AddDetail( ({ "hinsehen" }),
    "Du siehst hin und staunst, dass Du noch immer die Muenze siehst.");
  AddDetail( ({ "muenze" }),
    "Da liegt doch tatsaechlich keine 5 Meter von dir entfernt vor einer "
    "Felsnische eine Muenze. Wie die wohl dort hinkam?");
  AddDetail( ({ "nische","felsnische" }),
    "Wie Du sie naeher betrachtest, bemerkst Du eine Taube, die dort landet "
    "und in der Nische verschwindet. Die Nische ist ziemlich weit weg. "
    "Wie wirst Du da wohl rueberkommen?");
  AddDetail( ({ "taube" }),
    "Jetzt ist sie weg.");

  AddSound( DEFAULT_SOUND,
    "Der Hauch eines Windes pfeift an Deinen Ohren vorbei.");
  AddSound( ({ "hauch","wind" }),
    "Ganz leise hoerst Du ihn pfeifen.");

  AddSmell( DEFAULT_SMELL,
    "Rate mal, wonach es in einer Felswand riechen koennte? Nach Steinen "
    "vielleicht?");
  AddSmell( ({ "stein","steine" }),
    "Du hebst einen Stein auf, und schnupperst ganz gespannt an ihm herum. "
    "Du kommst dann relativ rasch zum Schluss, dass es sich tatsaechlich "
    "um einen Stein handelt, der keinen besonderen Duft ausstroemt. Du "
    "legst ihn gleich wieder weg.");
//END DETAILS

  AddCmd( ({ "kletter","klettere" }), "klettern" );
}

//COMMANDS

klettern(string str)
{
  object BLU_SANDALEN;
  notify_fail("Wohin moechtest Du klettern?\n");

  if ( -1!=member( ({ "runter","hinunter",
                      "nach unten"
                    }),str) )
  {
    tell_object(TP,
      "Du rutschst elegant am Seil nach unten und fuehlst Dich gleich sicherer auf\n"
     +"festem Untergrund.\n");
    tell_room(environment(this_player()),
      TP->Name()+" klettert am Seil nach unten.\n",({ TP }) );
    TP->move("/d/gebirge/rage/quest/room/garten7.lpc",M_GO|M_SILENT);
    return 1;
  }
  else if ( -1!=member( ({ "zur hoehle","rauf","hinauf","riss",
			   "zu riss","in riss","zum riss",
                           "nach oben","zu der hoehle","zu hoehle"
                         }),str) )
  {
    tell_object(TP,
      "Du kletterst ohne Probleme zur Hoehle hinauf.\n");
    tell_room(environment(this_player()),
      TP->Name()+" klettert in der Felswand davon.\n",({ TP }) );
    TP->move("/d/gebirge/rage/quest/room/room3.lpc",M_GO|M_SILENT);
    return 1;
  }
  else if ( -1!=member( ({ "zur felsnische hinueber","zur felsnische",
                           "zur nische hinueber","zur nische",
                           "hinueber","rueber","zur nische rueber",
                           "zur felsnische rueber","zu felsnische hinueber",
			   "zu felsnische","zu nische hinueber","zu nische",
			   "zu nische rueber","zu felsnische rueber"
                         }),str) )
  {
    if ( !BLU_SANDALEN=present("BLU_SANDALEN",TP) )
    {
      tell_object(TP,
	"\n"	  
        "Nach genau 2,25 Meter rutschst Du mit Deinem Fuss aus und stuerzt die Felswand\n"
       +"hinunter. Du versuchst den Absturz noch irgendwie zu bremsen, doch eine ueble\n"
       +"Verstauchung bleibt nicht aus.\n");
      TP->AddHp(-20);
      tell_room(environment(this_player()),
        TP->Name()+" stuerzt brutal die Felswand hinunter. Du kannst gar nicht hinsehen,\n"
                  +"so arg schaut das aus.\n",({ TP }) );
      tell_object(TP,
        "Ausserdem lacht Dich der Zwerg noch schadenfroh aus, weil Du mit so einer\n"
       +"schlechten Ausruestung unterwegs bist.\n");
      TP->move("/d/gebirge/rage/quest/room/garten7.lpc",M_GO|M_SILENT);
      return -1;
    }
    if ( BLU_SANDALEN->QueryProp(P_WORN) )
    {
      tell_object(TP,
        "Beinahe rutschst Du aus, aber durch die haftende Sohle der Ledersandalen\n"
       +"bleibst Du in der Wand und erreichst sicher dein Ziel.\n");
      tell_room(environment(this_player()),
        TP->Name()+" klettert in der Felswand davon.\n",({ TP }) );
      TP->move("/d/gebirge/rage/quest/room/room2.lpc",M_GO|M_SILENT);
      return 1;
    }
    tell_object(TP,
      "\n"
      "Nach genau 2,25 Meter rutschst Du mit Deinem Fuss aus und stuerzt die Felswand\n"
     +"hinunter. Du versuchst den Absturz noch irgendwie zu bremsen, doch eine ueble\n"
     +"Verstauchung bleibt nicht aus.\n");
    TP->AddHp(-20);
    tell_room(environment(this_player()),
      TP->Name()+" stuerzt brutal die Felswand hinunter. Du kannst gar nicht\n"
                +"hinsehen, so arg schaut das aus.\n",({ TP }) );
    tell_object(TP,
      "Nur die Sandalen zu haben, hilft Dir auch nicht. Beim naechsten Mal\n"
     +"solltest Du sie vielleicht auch anziehen.\n");
    TP->move("/d/gebirge/rage/quest/room/garten7.lpc",M_GO|M_SILENT);
    return -1;
  }
  return 0;
}
