// Rage, September 99

inherit "std/room";

#include "../def.h"
#include "../bluquest.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

nosave string * bhaken;
nosave string * bseilfest;
nosave string * zug;

create()
{
  ::create();
  zug=({});
  bseilfest=({});

// ROOM DESCRIPTION

  SetProp( P_INT_SHORT, "Im Kapellgarten." );
  SetProp( P_INT_LONG,
    "Du stehst in einem kleinen Seitental des Kapellgartens. Hier sind noch "
    "weitere Beete angelegt, in denen noch mehr kleine gruene Pflaenzchen "
    "versuchen zu wachsen. Es scheint doch tatsaechlich, dass jemand das "
    "Tal begruenen will. Ausser im Sueden siehst Du glatte Felswaende, die "
    "sich immer weiter zurueckziehen, je hoeher sie werden."
                      );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_MOUNTAIN]) );

// END ROOM DESCRIPTION

// DETAILS
  AddDetail( ({ "unkraut" }),
    "Die Blumen bluehen, das Gemuese waechst, doch auch das Unkraut wuchert "
    "hier.");
  AddDetail( ({ "zwerge" }),
    "Fuer gewoehnlich schuerfen sie nach Gold und Edelsteine, aber nicht alle, "
    "wie Du hier sehen kannst.");
  AddDetail( ({ "gold" }),
    "Das musst Du schon wo anders suchen.");
  AddDetail( ({ "edelstein","edelsteine" }),
    "Die musst Du schon wo anders suchen.");
  AddDetail( ({ "osten" }),
    "Im Osten ragt eine Felswand beinahe in den Himmel.");
  AddDetail( ({ "sueden" }),
    "Im Sueden koenntest Du noch mehr Gemuese finden.");
  AddDetail( ({ "menge" }),
    "Sehr, sehr viele.");
  AddDetail( ({ "himmel" }),
    "Der Himmel zeigt sich von seiner schoensten Seite. Keine Wolken und eine "
    "strahlende Sonne.");
  AddDetail( ({ "seite" }),
    "Da gibt es immer schoene und nicht so schoene.");
  AddDetail( ({ "wolke","wolken" }),
    "Heute und hier ist keine zu sehen. Versuch, sie doch wo anders zu finden, "
    "falls Du dringend welche brauchen solltest.");
  AddDetail( ({ "sonne" }),
    "Sie strahlt eben. *strahl*");
  AddDetail( ({ "hoehe" }),
    "Irgendwo ueber Dir.");
  AddDetail( ({ "meter" }),
    "Wieviel ein Meter ist, kannst Du Dir sicher selbst gut vorstellen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist schoen gruen. So was aber auch! Das liegt wohl am Gras. "
    "Ausserdem stehen hier eine Menge Blumen herum.");
  AddDetail( ({ "gras" }),
    "Gras ist ueblicherweise gruen und gibt dem Boden seine Farbe.");
  AddDetail( ({ "farbe" }),
    "Selbstverstaendlich gruen. Ich hoffe, Du hast es nun kapiert.");
  AddDetail( ({ "blume","blumen" }),
    "Enorm viele Blumen, aber sie zu zaehlen, lohnt sich nicht.");
  AddDetail( ({ "seitental","tal" }),
    "Dieses Tal wird unglaublicherweise sogar gepflegt. Und das, obwohl Du "
    "Dich gerade bei den Zwergen aufhaeltst.");
  AddDetail( ({ "kapellgarten","garten" }),
    "Nachwievor befindest Du Dich in ihm und fuehlst Dich sogar wohl darin.");
  AddDetail( ({ "beet","beete" }),
    "Du entdeckst was unglaubliches! Als Du die Beete so betrachtest, "
    "bemerkst Du, dass Gemuese in ihnen waechst.");
  AddDetail( ({ "gemuese" }),
    "Neben den Anbausorten aus dem Sueden kommen hier noch Erdaepfel dazu. "
    "Jetzt weisst Du endlich, woher sie sie in der Kneipe haben.");
  AddDetail( ({ "anbausorten","sorten" }),
    "Wenn Du mehr darueber wissen willst, dann geh einfach nach Sueden.");
  AddDetail( ({ "kneipe" }),
    "Schau Dich einfach in der Zwergenhoehle um, dann findest Du ganz bestimmt "
    "eine.");
  AddDetail( ({ "zwergenhoehle","hoehle" }),
    "Du haeltst Dich noch immer im Kapellgarten der Zwergenhoehle auf.");
  AddDetail( ({ "erdaepfel" }),
    "In Felonia soll es ganz gute Erdaepfel in einem Lokal geben. Die kann ich "
    "nur weiterempfehlen. *sabber*schmatz*");
  AddDetail( ({ "felonia" }),
    "Die Zwergenhoehle heisst Felonia, falls Du es noch nicht gewusst hast.");
  AddDetail( ({ "lokal" }),
    "Bei manchen wird es auch Kneipe genannt.");
  AddDetail( ({ "pflaenzchen","pflanzen","pflanze" }),
    "Die wachsen hier in den Beeten, aber anscheinend hatten sie schon mal "
    "bessere Zeiten gesehen.");
  AddDetail( ({ "zeit","zeiten" }),
    "Ihre guten liegen bereits laenger zurueck.");
  AddDetail( ({ "felswaende","waende" }),
    "Die Felswand im Osten faellt Dir besonders auf.");
  AddDetail( ({ "felswand","wand" }),
    "Diese Wand ist mit vielen Rissen und Spalten zerfurcht, sodass ein "
    "Kletterversuch hier hinauf eigentlich von Erfolg gekroent sein sollte.");
  AddDetail( ({ "erfolg" }),
    "Den wirst Du heute noch haben, wenn Du Dich ordentlich anstrengst.");
  AddDetail( ({ "riss","risse" }),
    "Es sind ziemlich viele davon da. Die koennten Dir wahrscheinlich beim "
    "Klettern helfen.");
  AddDetail( ({ "kletterversuch","klettern","versuch" }),
    "Versuch es ruhig einmal! Probieren geht ueber studieren!");
  AddDetail( ({ "spalte","spalten" }),
    "Schwer zu sagen, ob mehr Spalten oder Risse sind. Dir faellt nur auf, "
    "dass sich neben einer Spalte ein Felsvorsprung befindet. Was da oben "
    "wohl sein mag?");
  AddDetail( ({ "felsvorsprung","vorsprung" }),
    "In 8 Meter Hoehe befindet sich ein kleiner Felsvorsprung, auf den Du "
    "gerade noch raufpassen wirst. Wie koennte man da am besten raufkommen?");
  AddDetail( ({ "ritze" }),
    "Du schaust die einzelnen Ritzen in der Umgebung durch und findest in "
    "einer tatsaechlich einen Gegenstand.");
  AddDetail( ({ "gegenstand" }),
    "Auf den zweiten Blick erweist er sich als Kletterhaken.");
  AddDetail( ({ "kletterhaken","haken" }),
    "Ein Haken, der sich ideal zum Klettern eignen muesste.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst die Schritte des Gaertners, der durch seine Beete schreitet.");
  AddSound( ({ "schritte" }),
    "Neben Deinen eigenen hoerst Du auch die des Gaertners.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier hauptsaechlich nach Blumen.");
  AddSmell( ({ "blume","blumen" }),
    "Ein wunderbarer Duft geht von ihnen aus.");
  AddSmell( ({ "duft" }),
    "Dieser Duft laesst sich nicht einfach mit Worten beschreiben.");

// END DETAILS

  AddItem("d/gebirge/rage/quest/npc/blu.lpc", REFRESH_DESTRUCT);

  AddExit( "sueden", "nach Sueden#" + "/d/gebirge/dusty/hoch/room/garten6.lpc" );

  AddCmd( ({ "zaehl","zaehle" }), "zaehlen");
  AddCmd( ({ "nimm","nehm","nehme" }), "nehmen");
  AddCmd( ({ "greif","greife" }), "greifen");
  AddCmd( ({ "fass","fasse" }), "fassen");
  AddCmd( ({ "kletter","klettere" }), "klettern" );
  AddCmd( ({ "wirf","werf","werfe","schmeiss","schmeisse" }), "werfen" );
  AddCmd( ({ "zieh","ziehe","ueberpruef","ueberpruefe","pruef","pruefe" }),
             "ziehen" );
  AddCmd( ({ "rupf","rupfe" }), "rupfen" );
}

// COMMANDS

int zaehlen(string str)
{
  notify_fail("Was moechtest Du zaehlen?\n");

  if ( -1!=member( ({ "blumen" }),str) )
  {
    tell_object(TP,
      "Du beginnst mit der Zaehlung: 1, 2, 3, ...\n"
      "\n"
      "98, 99, 100, ...\n"
      "\n"
      "265, 266, 267 ...\n"
      "\n"
      "341 Blumen genau.\n"
      "\n"
      "Ob Du wirklich mit diesem Wissen was anfangen kannst, wage ich zu bezweifeln.\n");
    tell_room(environment(this_player()),
      TP->Name()+" muss wohl in einem Tagtraum vertieft sein.\n",({ TP }) );
    return 1;
  }
}

int nehmen(string str)
{
  object BLU_HAKEN;

  notify_fail("Was moechtest Du nehmen?\n");

  if ( -1!=member( ({ "kletterhaken","haken",
                      "kletterhaken aus ritze","haken aus ritze"
                    }),str) )
  {
    if ( !BLU_HAKEN=present("BLU_HAKEN",TP) )
    {
      tell_object(TP,
        "So einfach geht das nicht. Der liegt ja in der Ritze drin. Ueberlege Dir eine\n"
        "andere Methode.\n");
      return 1;
    }
    tell_object(TP,
      "Du hast doch schon einen Haken. Jetzt ist keiner mehr da.\n");
    return -1;
  }
  return 0;
}

int greifen(string str)
{
  object BLU_HAKEN;

  notify_fail("Wohin moechtest Du greifen?\n");

  if ( -1!=member( ({ "in ritze","in ritze hinein",
                      "in ritze rein",
                      "nach kletterhaken","nach haken"
                    }),str) )
  {
    if ( BLU_HAKEN=present("BLU_HAKEN",TP) )
    {
      tell_object(TP,
        "Du hast doch schon einen Haken. Jetzt ist keiner mehr da.\n");
      return -1;
    }
    tell_object(TP,
      "Du greifst in die Ritze, kommst aber nicht ganz ran. Besser waere es, weiter\n"
      "hineinzufassen.\n");
    return 1;
  }
  return 0;
}

int fassen(string str)
{
  object BLU_HAKEN;

  notify_fail("Wohin willst Du wie fassen?\n");

  if ( TP->QueryQuest(BLUQUEST) )
  {
    tell_object(TP,
      "Blu sagt: Du hast mir die Phiole bereits besorgt. Du brauchst den Haken ganz\n"
      "Blu sagt: bestimmt nicht mehr. Nochmals recht herzlichen Dank.\n");
    return -1;
  }
  if ( -1!=member( ({ "in ritze hinein","in ritze rein",
                      "in ritze","nach kletterhaken","nach haken"
                    }),str) )
  {
    tell_object(TP,
      "Sagte ich nicht WEITER hineinfassen!\n");
    return -1;
  }
  else if ( -1!=member( ({ "weiter in ritze hinein","in ritze weiter hinein",
                           "weiter in ritze rein","in ritze weiter rein",
                           "weiter in ritze"
                         }),str) )
  {
    if ( BLU_HAKEN=present("BLU_HAKEN",TP) )
    {
      tell_object(TP,
        "Du hast doch schon einen Haken. Jetzt ist keiner mehr da.\n");
      return -1;
    }
    BLU_HAKEN=clone_object("/d/gebirge/rage/quest/obj/klhaken.lpc");
    if ( ME_TOO_HEAVY==BLU_HAKEN->move(TP,M_GET|M_SILENT) )
    {
      tell_object(TP,
        "Du fasst soweit es geht in die Ritze hinein und glaubst schon, Deinen Arm nie\n"
        "wiederzusehen, aber dann kriegst Du den Haken zu fassen, merkst aber, dass er\n"
        "Dir zu schwer ist. Leg vorher besser etwas ab.\n");
      BLU_HAKEN->remove();
      return -1;
    }
      tell_object(TP,
        "Du fasst soweit es geht in die Ritze hinein und glaubst schon, Deinen Arm nie\n"
        "wiederzusehen, aber dann kriegst Du den Haken zu fassen und mit einem Ruck\n"
        "haeltst Du ihn in Deiner Hand.\n");
      tell_room(environment(this_player()),
        TP->Name()+" scheint etwas gefunden zu haben.\n",({ TP }) );
      return 1;
  }
}

int klettern(string str)
{
  object BLU_HAKEN;

  notify_fail("Wohin moechtest Du klettern?\n");

  if ( TP->QueryQuest(BLUQUEST) )
  {
    tell_object(TP,
      "Blu sagt: Nachdem Du die Quest geschafft hast, musst Du hier nicht mehr rauf.\n");
    bseilfest-=({getuid(TP)});
    return -1;
  }
  if ( -1!=member( ({ "rauf","nach oben","hinauf","hoch",
		      "auf felswand","felswand","vorsprung",
		      "auf wand","wand",
                      "auf felsvorsprung","auf vorsprung","felsvorsprung"
                    }),str) )
  {
    if ( -1!=member(zug,getuid(TP)) )
    {
      tell_object(TP,
        "Du bringst deine Kletterkuenste voll zur Geltung und Schwuppdiwupp stehst\n"
        "Du am Felsvorsprung.\n");
      tell_room(environment(this_player()),
        TP->Name()+" klettert wie eine Gemse nach oben.\n",({ TP }) );
      TP->move("/d/gebirge/rage/quest/room/room1.lpc",M_GO|M_SILENT);
      return 1;
    }
    if ( -1!=member(bseilfest,getuid(TP)) )
    {
      tell_object(TP,
	"Voller Elan kletterst Du los, doch ploetzlich merkst Du, wie sich der Haken\n"
        "lockert. Ein Absturz ist unvermeidbar.\n");
      TP->AddHp(-12);
      tell_object(TP,
        "Nun ist es geschehen! Du hast Dir ein paar Abschuerfungen zugezogen, aber\n"
        "zum Glueck ist nicht mehr passiert. Ich wuerde mir das Seil beim naechsten\n"
        "Mal vorher genauer ansehen.\n");
      bseilfest-=({getuid(TP)});
      BLU_HAKEN=clone_object("/d/gebirge/rage/quest/obj/klhaken.lpc");
      BLU_HAKEN->seil();
      if ( ME_TOO_HEAVY==BLU_HAKEN->move(TP,M_GET|M_SILENT) )
      {
        tell_object(TP,
          "Der Haken ist Dir im Moment zu schwer.\n");
        BLU_HAKEN->move(TO,M_GET|M_SILENT);
        return -1;
      }
      return -1;
    }
    tell_object(TP,
      "Muehsam quaelst Du Dich von einer Spalte zum naechsten Riss, doch ploetzlich\n"
      "verlierst Du den Halt und stuerzt in die Tiefe. Ein geeignetes Utensil waere\n"
      "keine bloede Idee.\n");
    TP->AddHp(-8);
    tell_object(TP,
      "Da hast Du Dir ziemlich stark den Knoechel verstaucht.\n");
    tell_room(environment(this_player()),
      TP->Name()+" stuerzt die Felswand herunter. Hoffentlich geht es Dir dann besser.\n",
      ({ TP }) );
    return -1;
  }
  else if ( -1!=member( ({ "mit seil rauf","mit seil nach oben",
                          "mit seil auf felsvorsprung",
                          "mit seil auf vorsprung","mit seil hinauf"
                        }),str) )
  {
    if ( !present("seil",TP) )
    {
      tell_object(TP,
        "Ohne Seil wird es nicht gehen.\n");
      return -1;
    }
    tell_object(TP,
      "Leider hast Du kein Seil wie die Inder, das sich von allein nach oben\n"
      "schlaengelt. Vorher hochwerfen, damit es auch raufkommt, ist sicher besser.\n");
    return -1;
  }
}

int werfen (string str)
{
  object BLU_HAKEN;

  notify_fail("Was willst Du wohin werfen?\n");

  if ( -1!=member( ({ "seil hoch","seil nach oben",
                      "seil ueber felsvorsprung",
                      "seil ueber vorsprung","seil in die hoehe",
                      "seil rauf","seil hinauf"
                    }),str) )
  {
    if ( present("seil",TP) )
    {
      tell_object(TP,
        "Das war ein schoener Wurf. Unglaublicherweise hast Du sogar soviel Kraft, dass\n"
        "das Seilende am Vorsprung landet. Aber glaubst Du tatsaechlich, dass es sich\n"
        "von allein dort oben festbinden wird?\n"
        "Waehrend Du ueberlegst, welches Hilfsmittel Dir weiterhelfen koennte, fliegt\n"
        "das Seil wieder runter.\n");
      return -1;
    }
    if ( (BLU_HAKEN=present("BLU_HAKEN",TP))&&(BLU_HAKEN->seil_angebunden()) )
    {
      tell_object(TP,
        "Es waer besser, wenn Du den Haken hochwirfst, denn Du hast das Seil daran\n"
        "festgebunden.\n");
      return -1;
    }
    tell_object(TP,
      "Ohne Seil wird es nicht gehen.\n");
    return -1;
  }
  else if ( -1!=member( ({ "haken hoch","haken nach oben",
                           "haken ueber felsvorsprung","haken auf felsvorsprung",
                           "haken ueber vorsprung","haken auf vorsprung",
                           "haken rauf","haken hinauf","haken in die hoehe"
                         }),str) )
  {
    if ( !BLU_HAKEN=present("BLU_HAKEN",TP) )
    {
      tell_object(TP,
        "Damit Du einen hochwerfen kannst, solltest Du zuerst einen finden.\n");
      return -1;
    }
    if ( BLU_HAKEN->seil_angebunden() )
    {
      tell_object(TP,
        "Elegant schleuderst Du den Haken mit dem Seil ueber den Vorsprung, und er\n"
        "bleibt tatsaechlich auch oben. Bravo!\n");
      bseilfest+=({getuid(TP)});
      AddSpecialDetail( ({ "seil","haken","kletterhaken" }),"det_seil");
      BLU_HAKEN->remove();
      return 1;
    }
    tell_object(TP,
      "Du wirfst den Haken bis zum Felsvorsprung, dort trifft er kurz auf, bleibt\n"
      "aber nicht liegen und kommt direkt auf Dich zugeflogen.\n");
    tell_object(TP,
      "Ohoh, das wird ein Volltreffer.\n");
    TP->AddHp(-5);
    tell_object(TP,
      "Der Haken hat Dich voll am Kopf getroffen. Autsch!\n");
    tell_room(environment(this_player()),
      TP->Name()+" wird soeben vom eigenen Haken getroffen.\n",({ TP }) );
    return -1;
  }
}

int ziehen(string str)
{
  notify_fail("Woran willst Du ziehen?\n");

  if ( -1!=member( ({ "seil","am seil","an seil"
                    }),str) )
  {
    if ( -1!=member(bseilfest,getuid(TP)) )
    {
      tell_object(TP,
        "Du ziehst kraeftig am Seil und merkst, dass der Haken ganz sicher festsitzt.\n"
        "Jetzt kannst Du ohne Schwierigkeiten raufklettern.\n");
      zug+=({getuid(TP)});
      AddSpecialDetail( ({ "seil","haken","kletterhaken" }),"det_seil");
      return 1;
    }
    if ( !present("seil",TP) )
    {
      tell_object(TP,
        "Ohne Seil wird es nicht gehen.\n");
      return -1;
    }
    tell_object(TP,
      "Du ziehst verspielt am Seil herum, aber ob Dir dies bei der Quest wirklich\n"
      "weiterhilft, sei in Frage gestellt.\n");
    tell_room(environment(this_player()),
      TP->Name()+" spielt sich mit dem Seil herum.\n",({ TP }) );
    return -1;
    }
}

int rupfen(string str)
{
  notify_fail("Was willst Du gerne ausrupfen?\n");

  if ( str == "unkraut" ||
       str == "unkraut aus" )
  {
    write( BS(
      "Bei dem vielen Unkraut, denkst Du Dir, es waere schlau, es gleich "
      "direkt auszurupfen. So machst Du Dich schnell ans Werk, aber als "
      "Du siehst, dass es fast schneller nachwaechst als Du rupfen kannst, "
      "laesst Du es lieber bleiben.") );
    say(
      TPN+" will das Unkrauft ausrupfen, laesst es aber dann doch bleiben.\n" );
    return 1;
  }
}

string det_seil()
{
  if ( -1!=member(zug,getuid(TP)) )
  {
    return("Das Seil hast Du bereits ueberprueft. Du kannst endlich ohne Probleme\n"
           "raufklettern.\n"); 
  }
  if ( -1!=member(bseilfest,getuid(TP)) )
  {
    return ("Das Seil, das Du eben mit dem Haken raufgeworfen hast, haengt nun von oben\n"
            "herunter. Aber bevor Du loskletterst, wuerde ich das Seil ueberpruefen, ob\n"
            "es auch haelt.\n");
  }
  return 0;
}












