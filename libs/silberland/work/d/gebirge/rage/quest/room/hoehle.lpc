//Hoehle, Rage Okt99

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

//ROOM DESCRIPTION

  SetProp( P_INT_SHORT, "In einer dunklen Hoehle." );
  SetProp( P_INT_LONG,
    "Die Hoehle verjuengt sich recht bald. Dort, wo sie zu verschwinden "
    "droht, geht ein kleiner Spalt 15 Grad nach unten weg."
                      );

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

//END ROOM DESCRIPTION

//DETAILS

  AddDetail( ({ "hoehle" }),
    "Sie ist ziemlich dunkel. Du kannst hauptsaechlich nur Schatten und "
    "Schemen erkennen.");
  AddDetail( ({ "schatten" }),
    "War da eben einer, der sich bewegt hat? Kurzzeitig hast Du ein mulmiges "
    "Gefuehl, aber dann vergeht es wieder.");
  AddDetail( ({ "schemen" }),
    "Sie unterscheiden sich eigentlich ueberhaupt nicht von den Schatten.");
  AddDetail( ({ "gefuehl","gefuehle" }),
    "Man sollte sich immer auf seine Gefuehle verlassen. Du hattest schon mal ein "
    "besseres als jetzt.");
  AddDetail( ({ "spalt" }),
    "Dort, wo die Hoehle nicht mehr weitergeht, ist ein Spalt. Wenn Du Dich "
    "traust, dann rutsch dort runter. Wirst schon sehen, wo Du dann ankommst.");
  AddDetail( ({ "grad" }),
    "Genau so warm (oder eher kalt) ist es hier.");
  AddDetail( ({ "boden","decke" }),
    "Besteht aus festem Granit, sonst faellt Dir nichts daran auf.");
  AddDetail( ({ "wand","waende" }),
    "Wie auch der Boden und die Decke, so sind - kaum zu glauben - auch die "
    "Waende aus Granit.");
  AddDetail( ({ "granit" }),
    "Dieses Gestein ist so hart, dass Du Dich da nicht durchbeissen kannst.");
  AddDetail( ({ "gestein" }),
    "Ich sagte es schon, ein sehr hartes Gestein.");
//END DETAILS

  AddExit( "raus", "wieder raus#" + "/d/gebirge/rage/quest/room/room3.lpc" );

  AddCmd( ({ "beiss","beisse" }), "beissen");
  AddCmd( ({ "rutsch","rutsche" }), "rutschen");
}

//COMMANDS

beissen(string str)
{
  if ( -1!=member( ({ "am gestein","am granit","in granit","auf granit",
                      "gestein","granit","in gestein","auf gestein"
                    }),str) )
  {
//  Bissspuren, Lispeln beim Spieler
    tell_object(TP,
      "Du stuerzt Dich zur Wand und faengst an, daran herumzubeissen. Abgesehen\n"
      "davon, dass es sehr laut knirscht, tut sich nicht viel. Ich an Deiner Stelle\n"
      "wuerde damit aufhoeren.\n");
    tell_room(environment(this_player()),
      TP->Name()+" hat grad einen Heisshunger.\n",({ TP }) );
    return 1;
  }
  tell_object(TP,
    "Woran willst Du beissen?\n");
  return -1;
}

rutschen(string str)
{
  notify_fail("Wo willst Du rutschen?\n");

  if ( -1!=member( ({ "in spalt","in spalt runter","runter","durch spalt",
                      "in spalte","in spalte runter","durch spalte",
                      "spalt","spalte"
                    }),str) )
  {
    tell_object(TP,
      "Boah!! Das macht ja Spass. Du stoesst Dir zwar zweimal den Kopf an, aber\n"
      "passiert ist Dir nichts. Aja, falls Du es noch nicht bemerkt haben solltest:\n"
      "Du bist wieder beim Gaertner.\n");
    tell_room(environment(this_player()),
      TP->Name()+" verschwindet in dem Spalt.\n",({ TP }) );
    TP->move("d/gebirge/rage/quest/room/garten7.lpc",M_GO|M_SILENT);
    return 1;
  }
}
