//Vor der Hoehle, Rage Okt99

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

//ROOM DESCRIPTION

  SetProp( P_INT_SHORT, "Mitten in der Felswand." );
  SetProp( P_INT_LONG,
   "Du bist nun in einem Riss der Felswand, an deren Seite sich der Eingang "
   "zu einer Hoehle befindet."
                      );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//DETAILS

  AddDetail( ({ "boden" }),
    "Der ist weiter unter Dir, denn Du haengst in der Felswand drin.");
  AddDetail( ({ "felswand","wand" }),
    "Du bist freiwillig hierher geklettert. Sieh selbst zu, wie Du "
    "weiterkommst.");
  AddDetail( ({ "himmel" }),
    "Nachwievor wolkenfrei. So schnell veraendert der sich auch nicht.");
  AddDetail( ({ "riss" }),
    "In dem stehst Du.");
  AddDetail( ({ "seite" }),
    "Buecher haben meist viele, aber das tut nichts zur Sache.");
  AddDetail( ({ "buch","buecher" }),
    "Hier erblickst Du keines.");
  AddDetail( ({ "durchmesser" }),
    "Hat mit einem Messer relativ wenig zu tun.");
  AddDetail( ({ "messer" }),
    "Hier liegt keines herum, hoechstens Du hast grad eines abgelegt.");
  AddDetail( ({ "sache" }),
    "Welche wohl? Du bist ja nicht nur zum Spass hier.");
  AddDetail( ({ "spass" }),
    "Hast Du einen? Wenn nicht, kann ich auch nichts machen.");
  AddDetail( ({ "eingang" }),
    "Du koenntest ihn natuerlich auch als Ausgang betrachten.");
  AddDetail( ({ "ausgang" }),
    "Er koennte aber genauso gut der Eingang sein, wie Du zuerst vermutet hast.");
  AddDetail( ({ "hoehle" }),
    "Wie schon gesagt: Ein Meter Durchmesser. Geh ruhig rein!");
  AddDetail( ({ "meter" }),
    "Wenn Du beim Forschen so weitermachst, wirst Du nie welche haben.");
  AddDetail( ({ "forschen" }),
    "War nur gross, weil es die deutsche Grammatik so wuenscht. Ist weiter "
    "unwichtig.");
  AddDetail( ({ "grammatik" }),
    "Damit brauchst Du Dich nicht auseinanderzusetzen.");
  AddDetail( ({ "fels","felsen" }),
    "Da Du mitten in einer Felswand stehst, darfst Du Dich nicht wundern, "
    "sehr viele Felsen um Dich zu sehen. Dein Interesse an ihnen ist "
    "allerdings sehr klein, denn Du fragst Dich viel mehr, wie es jetzt "
    "weitergehen soll.");

  AddSmell( DEFAULT_SMELL,
    "Wie Du es Dir bereits dachtest, riecht es hier nach nichts.");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift noch immer, aber nicht mehr so stark.");
  AddSound( ({ "wind" }),
    "Du kannst ihn gerade noch wahrnehmen.");
//ENDDETAILS

  AddCmd( ({ "kletter","klettere" }), "klettern");

  AddExit( "hoehle", "in die Hoehle#" + "/d/gebirge/rage/quest/room/hoehle.lpc" );
}

//COMMANDS

klettern(string str)
{
  notify_fail ("Wohin moechtest Du klettern?\n");

  if ( -1!=member( ({ "runter","nach unten","hinunter",
                      "zum felsvorsprung","zum vorsprung"
                    }),str) )
  {
    tell_object(TP,
      "Du kletterst wieder zurueck zum Felsvorsprung.\n");
    tell_room(environment(this_player()),
      TP->Name()+" klettert zum Felsvorsprung hinunter.\n",({ TP }) );
    TP->move("/d/gebirge/rage/quest/room/room1.lpc",M_GO|M_SILENT);
    return -1;
  }
}
