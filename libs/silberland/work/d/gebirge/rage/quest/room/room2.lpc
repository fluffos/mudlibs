//Vor der Nische, Rage Okt99



inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

nosave int abgelenkt;

create()
{
  ::create();
  abgelenkt=0;

  SetProp( P_INT_SHORT, "Auf wackligen Beinen vor der Felsnische." );
  SetProp( P_INT_LONG,
    "Du stehst ein wenig wackelig auf Deinen Beinen genau vor der "
    "Felsnische. 5 Meter neben Dir ist der sichere Felsvorsprung. Du "
    "waerst nur zu gern wieder dort, aber Deine Neugier brachte dich "
    "hierher. Und 8 Meter unter Dir befindet sich der mehr oder weniger "
    "sichere Boden. Vor der Felsnische liegt noch eine Muenze, die Du "
    "vorher bereits gesehen hast. Die Taube entdeckst Du allerdings "
    "nirgends."
                      );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//DETAILS
  AddDetail( ({ "beine","knie" }),
    "Dir schlottern einwenig die Knie, wenn Du daran denkst, dass der "
    "Felsvorsprung so klein ist und nicht gerade sehr einladend und "
    "sicher wirkt.");
  AddDetail( ({ "taube" }),
    "Wo die nur stecken mag? Die muss doch in der Naehe sein.");
  AddDetail( ({ "naehe" }),
    "Sieh Dich um, womoeglich findest Du sie sogar.");
  AddDetail( ({ "muenze" }),
    "Nachdem Du Dir die Muenze genauer angesehen hast, musst Du leider "
    "erkennen, dass es nur ein Steinchen war, das silbern schillerte.");
  AddDetail( ({ "steinchen" }),
    "Du hast das Steinchen, das Dich ueberhaupt nicht interessiert, fuer "
    "eine Muenze gehalten.");
  AddDetail( ({ "boden" }),
    "Der Anfaengerpark von Felonia ist unter dir.");
  AddDetail( ({ "himmel" }),
    "Die Sonne strahlt noch immer.");
  AddDetail( ({ "sonne" }),
    "Am Himmel halt. Wo sonst sollte sie sein?");
  AddDetail( ({ "felsvorsprung","vorsprung" }),
    "Dort warst Du gerade noch. Irgendwie wuerdest Du gern wieder "
    "dorthin zurueckkehren.");
  AddDetail( ({ "fels","felsen" }),
    "Da Du vor einer Felsnische stehst, kannst Du natuerlich auch "
    "zahlreiche Felsen sehen. Die interessieren Dich aber bei weitem nicht "
    "so sehr wie die Nische." );
  AddDetail( ({ "felsnische","nische" }),
    "Die ist eindeutig zu klein zum Reinklettern. Da musst Du Dir schon "
    "etwas anderes ueberlegen.");
  AddDetail( ({ "anfaengerpark","park" }),
    "Spring runter, dann siehst Du ihn sicher gut!");
  AddDetail( ({ "felonia" }),
    "Die Hoehle der Zwerge.");
  AddDetail( ({ "hoehle" }),
    "Von hier aus eindeutig nicht zu sehen.");
  AddDetail( ({ "zwerge" }),
    "Aufgrund logischer Schlussfolgerung leben die wohl in der Zwergenhoehle.");
  AddDetail( ({ "schlussfolgerung" }),
    "Du folgerst, dass jetzt Schluss ist.");
  AddDetail( ({ "schluss" }),
    "Aus! Vorbei! Finito! Basta!");
  AddDetail( ({ "aus","vorbei","finito","basta" }),
    "Glaubst Du ernsthaft, ich beschreibe jeden Mist fuer dich?");
  AddDetail( ({ "mist" }),
    "Jawohl, ein schoener Mist. Denn jetzt geht es nicht mehr weiter.");
  AddDetail( ({ "meter" }),
    "Ein Laengenmass.");
  AddDetail( ({ "laengenmass","mass" }),
    "Das Mass einer Laenge.");
  AddDetail( ({ "laenge" }),
    "Manches ist lang, anderes kurz. *frechgrins*");
  AddDetail( ({ "zwerg" }),
    "Weit unter Dir geht einer im Park herum.");
  AddDetail( ({ "neugier" }),
    "Die brachte Dich auf diesen ungemuetlichen Vorsprung. Gib jetzt nicht "
    "mir die Schuld.");
  AddDetail( ({ "schuld" }),
    "Wie alle Magier bin auch ich unschuldig. :)");
  AddDetail( ({ "magier" }),
    "Das sind lustige Leutchen, die das Silberland in harter Arbeit "
    "programmieren. Cirion gehoert auch dazu :)");
  AddDetail( ({ "arbeit" }),
    "Du arbeitest derzeit wohl nicht, denn sonst wuerdest Du hier nicht "
    "herumforschen.");
  AddDetail( ({ "leutchen" }),
    "Eigentlich sind sie so wie Du und ich.");
  AddDetail( ({ "silberland","land" }),
    "Ein herrliches Land, durch welches Du schreitest.");
  AddDetail( ({ "quest" }),
    "Wenn ich mich richtig erinnere, dann machst Du gerade eine.");
  AddDetail( ({ "verwirklichung","gefuehl" }),
    "Es ist ein schoenes Gefuehl, etwas verwirklichen zu koennen.");
  AddDetail( ({ "cirion" }),
    "Der hat mir bei der Verwirklichung der Quest sehr geholfen, wofuer ich "
    "ihm aeusserst dankbar bin.");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift staerker an Deinen Ohren vorbei.");
  AddSound( ({ "wind" }),
    "Du hoerst ihn doch recht deutlich pfeifen.");

  AddSmell( DEFAULT_SMELL,
    "Rate mal, wonach es in einer Felswand riechen koennte? Nach Steinen "
    "vielleicht? Aber ein leicht stechender Geruch faellt Dir auch auf.");
  AddSmell( ({ "stein","steine" }),
    "Du hebst einen Stein auf, und schnupperst ganz gespannt an ihm herum. "
    "Du kommst dann relativ rasch zum Schluss, dass es sich tatsaechlich "
    "um einen Stein handelt, der keinen besonderen Duft ausstroemt.");
  AddSmell( ({ "geruch" }),
    "Der Geruch kommt eindeutig aus der Felsnische heraus.");

//END DETAILS

  AddCmd( ({ "kletter","klettere" }), "klettern" );
  AddCmd( ({ "greif","greife","fass","fasse" }), "greifen" );
  AddCmd( ({ "lock","locke" }), "locken" );
  AddCmd( ({ "hol","hole" }), "holen" );
  AddCmd( ({ "huepf","huepfe","spring","springe" }), "springen" );
}

//COMMANDS


springen(string str)
{
  if ( -1!=member( ({ "hinunter","runter","nach unten",
                      "in den Anfaengerpark","in den Park"
                    }),str) )
  {
    tell_object(TP,
      "Das waere der reinste Selbstmord, wenn Du da runterspringst. Da Du derzeit\n"
     +"in keiner depressiven Stimmung bist, laesst Du es doch sein.\n");
    tell_room(environment(this_player()),
      TP->Name()+" hat anscheinend vor, Selbstmord zu begehen.\n",({ TP }) );
    return 1;
  }
  tell_object(TP,
    "Wohin willst Du gern springen?\n");
  return -1;
}

klettern(string str)
{
  object BLU_SANDALEN;
  object BLU_PHIOLE;
  object BLU_STANGERL;

  notify_fail("Wohin moechtest Du klettern?\n");

  if ( -1!=member( ({ "zurueck","zum felsvorsprung","zum vorsprung",
                      "zu felsvorsprung","zu vorsprung",
                      "zurueck zum felsvorsprung",
                      "zurueck zu felsvorsprung",
                      "zurueck zum vorsprung","zurueck zu vorsprung"
                    }),str) )
  {
    if ( abgelenkt==1 )
    {
      remove_call_out("stangerl_weg");
      abgelenkt=0;
      tell_object(TP,
        "Waehrend Du davon kletterst, fliegen Dir die letzten Kruemel Deines\n"
       +"Salzstangerls aus der Hand.\n");
      if ( BLU_STANGERL=present("BLU_STANGERL",TP) ) BLU_STANGERL->remove();
    }
    if ( !BLU_SANDALEN=present("BLU_SANDALEN",TP) )
    {
      if ( BLU_PHIOLE=deep_present("BLU_PHIOLE",TP) )
      {
        tell_object(TP,
          "\n"
          "Nach genau 2,25 Meter rutschst Du mit Deinem Fuss aus und stuerzt die\n"
         +"Felswand hinunter. Du versuchst den Absturz noch irgendwie zu bremsen,\n"
         +"doch eine ueble Verstauchung bleibt nicht aus.\n"
         +"Die Phiole ist Dir dabei auch zerbrochen. So ein Pech aber auch.\n");
	BLU_PHIOLE->remove();
        TP->AddHp(-20);
        tell_room(environment(this_player()),
        TP->Name()+" stuerzt brutal die Felswand hinunter. Du kannst gar nicht\n"
                  +"hinsehen, so arg schaut das aus.\n",({ TP }) );
        tell_object(TP,
          "Ausserdem lacht Dich der Zwerg noch schadenfroh aus, weil Du mit so\n"
         +"einer schlechten Ausruestung unterwegs bist.\n");
        TP->move("/d/gebirge/rage/quest/room/garten7.lpc",M_GO|M_SILENT);
        return -1;  
      } 
      tell_object(TP,
        "\n"
        "Nach genau 2,25 Meter rutschst Du mit Deinem Fuss aus und stuerzt die\n"
       +"Felswand hinunter. Du versuchst den Absturz noch irgendwie zu bremsen,\n"
       +"doch eine ueble Verstauchung bleibt nicht aus.\n");
      TP->AddHp(-20);
      tell_room(environment(this_player()),
        TP->Name()+" stuerzt brutal die Felswand hinunter. Du kannst gar nicht\n"
                  +"hinsehen, so arg schaut das aus.\n",({ TP }) );
      tell_object(TP,
        "Ausserdem lacht Dich der Zwerg noch schadenfroh aus, weil Du mit so\n"
       +"einer schlechten Ausruestung unterwegs bist.\n");
      TP->move("/d/gebirge/rage/quest/room/garten7.lpc",M_GO|M_SILENT);
      return -1;
    }
    if ( BLU_SANDALEN->QueryProp(P_WORN) )
    {
      if ( BLU_PHIOLE=present("BLU_PHIOLE",TP) )
      {
        tell_room(environment(this_player()),
          TP->Name()+" klettert zum Felsvorsprung zurueck.\n",({ TP }) );
        TP->move("/d/gebirge/rage/quest/room/room1.lpc",M_GO|M_SILENT);
        tell_object(TP,
          "Du bist zwar zum Felsvorsprung zurueckgeklettert, doch leider rutscht\n"
          "Dir die Phiole aus der Hand, die dann auf dem Erdboden zerspringt.\n"
          "Du musst wohl eine neue holen.\n");
          BLU_PHIOLE->remove();
        return -1;
      }
      if ( BLU_PHIOLE=deep_present("BLU_PHIOLE",TP) )
      {
        if ( BLU_PHIOLE->verkorkt() )
        {
          tell_object(TP,
            "Du kletterst zum Felsvorsprung zurueck und bist froh, bald wieder\n"
           +"auf festem Untergrund stehen zu koennen.\n");
          tell_room(environment(this_player()),
            TP->Name()+" klettert zum Felsvorsprung zurueck.\n",({ TP }) );
          TP->move("/d/gebirge/rage/quest/room/room1.lpc",M_GO|M_SILENT);
          return 1;
        }
        tell_room(environment(this_player()),
          TP->Name()+" klettert zum Felsvorsprung zurueck.\n",({ TP }) );
        TP->move("/d/gebirge/rage/quest/room/room1.lpc",M_GO|M_SILENT);
        tell_object(TP,
          "Du bist zum Felsvorsprung zurueckgeklettert, merkst aber, dass die\n"
         +"Fluessigkeit aus der Phiole ausgeronnen ist. Da die Phiole somit\n"
         +"wertlos ist, wirft Du sie weg und beschliesst, eine neue zu holen.\n");
        BLU_PHIOLE->remove();
        return -1;
      }
      tell_room(environment(this_player()),
        TP->Name()+" klettert zum Felsvorsprung zurueck.\n",({ TP }) );
      tell_object(TP,
        "Du kletterst zum Felsvorsprung zurueck.\n");
      TP->move("/d/gebirge/rage/quest/room/room1.lpc",M_GO|M_SILENT);
      return -1;
    }
    tell_object(TP,
      "\n"
      "Nach genau 2,25 Meter rutschst Du mit Deinem Fuss aus und stuerzt die\n"
     +"Felswand hinunter. Du versuchst den Absturz noch irgendwie zu bremsen,\n"
     +"doch eine ueble Verstauchung bleibt nicht aus.\n");
    TP->AddHp(-20);
    tell_room(environment(this_player()),
      TP->Name()+" stuerzt brutal die Felswand hinunter. Du kannst gar nicht\n"
                +"hinsehen, so arg schaut das aus.\n",({ TP }) );
    tell_object(TP,
      "Nur die Sandalen zu haben, hilft Dir auch nicht. Beim naechsten Mal\n"
     +"solltest Du sie vielleicht auch anziehen.\n");
    TP->move("/d/gebirge/rage/quest/room/garten7.lpc",M_GO|M_SILENT);
    return -1;
  }
  return 0;
}

holen(string str)
{
  object BLU_PHIOLE;
  object BLU_STANGERL;

  notify_fail("Was willst Du womit wo herausholen?\n");

  if ( -1!=member( ({ "gegenstand mit stock aus nische heraus",
                      "phiole mit stock aus nische heraus",
                      "phiole mit stock aus nische","phiole mit stock aus felsnische",
                      "gegenstand mit stock aus felsnische heraus",
                      "phiole mit stock aus felsnische heraus",
		      "gegenstand mit stock aus felsnische","gegenstand mit stock aus nische"
                    }),str) )
  {
    if ( present("stock",TP) )
    {
      if ( abgelenkt==0 )
      {
        tell_object(TP,
          "Du kommst nicht an den Gegenstand ran, weil die Taube noch immer in\n"
         +"ihrem Bau steckt.\n");
        return -1;
      }
      if ( deep_present("BLU_PHIOLE",TP) )
      {
        tell_object(TP,
          "Du hast ja eine Phiole, die sollte reichen.\n");
        return -1;
      }
      BLU_PHIOLE=clone_object("/d/gebirge/rage/quest/obj/blu_phiole.lpc");
      if ( ME_TOO_HEAVY==BLU_PHIOLE->move(TP,M_GET|M_SILENT) )
      {
        tell_object(TP,
          "Du willst Dir gerade die Phiole aus der Nische angeln, merkst aber,\n"
         +"dass sie Dir zu schwer wird. Leg vorher was anderes ab, dann gehts.\n");
        BLU_PHIOLE->remove();
        return -1;
      }
      tell_object(TP,
        "Professionell angelst Du die Phiole aus der hintersten Ecke der Nische heraus,\n"
       +"waehrend die Taube nachwievor durch das Fressen abgelenkt ist.\n");
      tell_room(environment(this_player()),
        TP->Name()+" blickt sehr zufrieden drein.\n",({ TP }) );
      if ( find_call_out("stangerl_weg") )
      {
        tell_object(TP,
          "Kurz darauf hat auch die Taube die restlichen Kruemel gefressen, und sie\n"
	  "verschwindet wieder in ihrer Nische.\n");
        if ( BLU_STANGERL=present("BLU_STANGERL",TP) )
        {
          BLU_STANGERL->remove();
	  abgelenkt=0;
        } 
        remove_call_out("stangerl_weg");
        return 1;
      }
    }
    tell_object(TP,
      "Zuerst mal einen Stock haben, damit Du was machen kannst.\n");
    return -1;
  }
}

greifen(string str)
{
  notify_fail("Wohin moechtest Du greifen?\n");

  if ( -1!=member( ({ "in nische","in nische hinein",
                      "in felsnische","in felsnische hinein",
                      "in nische rein","in felsnische rein"
                    }),str) )
    {
      if ( abgelenkt==0 )
      {
        tell_object(TP,
          "Die Taube hat anscheinend schon auf Deine Hand gewartet und pickt wie von\n"
         +"Sinnen drauf ein.\n");
        TP->AddHp(-1);
        tell_room(environment(this_player()),
          TP->Name()+" hat wohl Probleme mit dem Vogel.\n",({ TP }) );
        tell_object(TP,
          "Du ziehst Deine Hand rasch wieder raus, bevor Du sie komplett verlierst.\n"
         +"Eventuell koenntest Du sie herauslocken, damit sie abgelenkt ist.\n");
        return 1;
      }
      tell_object(TP,
        "Du greifst mit der Hand in die Felsnische und spuerst ganz hinten einen\n"
       +"Gegenstand, an den Du nicht ganz rankommst. Ein Versuch mit einem Stock, da\n"
       +"etwas rausholen zu wollen, koennte zum Ziel fuehren, da bin ich sicher.\n");
      return -1;
    }
}

locken(string str)
{
  object BLU_STANGERL;
  object semmel;
  object kipferl;

  notify_fail("Womit willst Du die Taube locken?\n");
  
  if ( abgelenkt==1 )
  {
    tell_object(TP,
      "Die Taube hast Du doch schon laengst abgelenkt. Wird Zeit, dass Du Dich\n"
     +"um andere Sachen kuemmerst.\n");
    return -1;
  }
  if ( -1!=member( ({ "taube mit semmel","taube mit semmel heraus",
                      "taube mit semmel aus nische",
                      "taube mit semmel an",
                      "taube mit semmel aus felsnische",
                      "taube mit kipferl","taube mit kipferl heraus",
                      "taube mit kipferl an",
                      "taube mit kipferl aus nische",
                      "taube mit kipferl aus felsnische"
                   }),str) )
  {
  if ( (!semmel=present("semmel",TP)) && (!kipferl=present("kipferl",TP)) )
    {
      tell_object(TP,
        "Du musst das auch haben, damit Du die Taube rauslocken kannst.\n");
      return -1;
    }
    tell_object(TP,
      "Die Taube kommt langsam aus ihrem Versteck heraus, dreht dann aber\n"
     +"gleich wieder um. Anscheinend hat sie Salziges lieber. Koenntest ja\n"
     +"auch den Gaertner fragen, der hilft Dir sicher weiter.\n");
    tell_room(environment(this_player()),
      TP->Name()+" ueberlegt sich eine andere Methode.\n",({ TP }) );
    return -1;
  }
  if ( -1!=member( ({ "taube mit salzstangerl","taube mit salzstangerl heraus",
                      "taube mit salzstangerl aus nische",
                      "taube mit salzstangerl aus felsnische",
                      "taube mit salzstangerl raus","taube mit salzstangerl an",
                      "taube mit stangerl","taube mit stangerl heraus",
                      "taube mit stangerl aus nische","taube mit stangerl raus",
                      "taube mit stangerl an","taube mit stangerl aus felsnische"
                    }),str) )
  {
    if ( !BLU_STANGERL=present("BLU_STANGERL",TP) )
    {
      tell_object(TP,
        "Zuerst einmal das Salzstangerl vom Gaertner haben, dann kannst Du die\n"
       +"Taube herauslocken.\n");
      return -1;
    }
    if ( BLU_STANGERL->zerkleinert() )
    {
      tell_object(TP,
        "Die Taube springt auf ihren Beinchen heraus und frisst Dir aus der Hand. Du\n"
       +"solltest den Augenblick nuetzen und nachschauen, auf was die Taube aufgepasst\n"
       +"hat!\n");
        tell_room(environment(this_player()),
        TP->Name()+" lenkt gerade die Taube ab.\n", ({ TP }) );
      abgelenkt=1;
      call_out("stangerl_weg",45);
      return 1;
    }
    tell_object(TP,
      "Die Taube huepft aus der Nische heraus und schaut kurz Deine Hand mit dem\n"
     +"Stangerl an. Aber wie soll sie so ein grosses Stueck essen? Sie verschwindet\n"
     +"daraufhin wieder in ihrem Bau. Es waere besser, wenn Du vorher mit dem\n"
     +"Salzstangerl was machst.\n");
    tell_room(environment(this_player()),
      TP->Name()+" hat noch immer keinen Erfolg.\n", ({ TP }) );
    return -1;
  }
}

//COMMANDS END

int stangerl_weg()
{
  object BLU_STANGERL;

  if ( BLU_STANGERL=present("BLU_STANGERL",TP) )
  {
    tell_object(TP,
      "Jetzt hast Du zulange gewartet, um in der Nische etwas zu finden, denn die\n"
     +"Taube hat alle Broesel aufgefressen und verzieht sich wieder in ihren Bau.\n"
     +"Du solltest Dir besser ein neues Salzstangerl holen.\n");
    BLU_STANGERL->remove();
    abgelenkt=0;
    tell_room(environment(this_player()),
      TP->Name()+" aergert sich gerade gewaltig.\n", ({ TP }) );
  }
}



