//Phiole, Rage Okt99

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>

nosave int verkorkt;

create()
{
  if ( !is_clone(TO) ) return;
  ::create();
  verkorkt=0;

  SetProp(P_SHORT, "Eine Phiole");
  SetProp(P_LONG,
    "Ein kleines Flaeschchen, das mit einem Stoppel verschlossen ist und "
    "das ziemlich leicht zerbrechlich aussieht. In ihm ist die Fluessigkeit, "
    "nach der Du so lange gesucht hast." );
  SetProp(P_NAME, "Phiole");
  SetProp(P_GENDER, FEMALE);
  AddDetail( ({ "flaeschchen","flasche" }),
    "Eine kleine Flasche, Du Flasche! Als Du Dir die Phiole genauer ansiehst, "
    "stellst Du fest, dass das Glas so duenn ist, dass es besser waere, die "
    "Phiole sicher zu verstauen, bevor Du Dich auf den Weg zurueck machst.");
  AddDetail( ({ "glas" }),
    "Das Glas der Phiole ist hauchduenn. Besser verstau die Phiole, bevor sie "
    "noch kaputt geht.");
  AddDetail( ({ "stoppel" }),
    "Der scheint schon recht locker zu sein, ich wuerde an Deiner Stelle die "
    "Phiole damit verkorken, bevor noch was dummes passiert.");
  AddDetail( ({ "fluessigkeit" }),
    "Bei der Fluessigkeit scheint es sich um den Unkrautvernichter zu handeln, "
    "von der der Zwerg sprach. Also bring sie ihm rasch.");
  AddId( ({ "phiole","BLU_PHIOLE","QUESTOBJ" }) );

  SetProp(P_MATERIAL, MAT_GLASS );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_SMELL, "Die Fluessigkeit riecht ziemlich streng, zulange wuerde ich das nicht einatmen.\n");
  SetProp(P_SOUND, "Ein leichtes Blubbern kannst Du hoeren.\n");

  AddCmd( ({ "verkork","verkorke" }), "verkorken" );
}

verkorken (string str)
{
  notify_fail("Was moechtest Du verkorken?\n");

    if ( -1!=member( ({ "phiole","phiole mit stoppel"
                     }),str) )
    {
      notify_fail("Du hast doch die Phiole schon mit dem Stoppel verkorkt.\n");

      if( verkorkt==1 ) { return 0; }

      tell_object(TP,
        "Du steckst den Stoppel ganz fest in die Phiole. Jetzt rinnt da ganz bestimmt\n"
        "nichts mehr heraus.\n");
      tell_room(environment(this_player()),
        TP->Name()+" verschliesst die Phiole mit einem Stoppel.\n",({ TP }) );
      verkorkt=1;
      SetProp(P_SHORT, "Eine festverschlossene Phiole");
      SetProp(P_LONG,
        "Eine Phiole, die Du fest verkorkt hast." );
      AddDetail( ({ "stoppel" }),
        "Der Stoppel sitzt ganz fest in der Phiole. Da rinnt sicher nichts "
        "mehr heraus.");
      return 1;
    }
}
int verkorkt() { return verkorkt; }




