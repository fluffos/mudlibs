//Spezialsalzstangerl, Rage Okt 99

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>

nosave int zerkleinert;
create()
{
  if ( !is_clone(TO) ) return;
  ::create();
  zerkleinert=0;

  SetProp(P_SHORT, "Ein altes Salzstangerl");
  SetProp(P_LONG, "Ein altes Salzstangerl, das die Zeit, in der es frisch "
    "war, schon laengst hinter sich gelassen hat. Jetzt kann man es nur mehr "
    "als Futtermittel verwenden.");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 20);
  AddDetail( ({ "zeit" }),
    "Du schaetzt, dass das Salzstangerl mindestens eine Woche alt ist.");
  AddDetail( ({ "futtermittel","futter","mittel","fuettern" }),
    "Zum Fuettern von verschiedenen Tieren ist das Stangerl sicher bestens "
    "geeignet.");
  AddId( ({"stangerl","salzstangerl","BLU_STANGERL","QUESTOBJ" }) );
  SetProp(P_NAME, "Salzstangerl");
  SetProp(P_MATERIAL, ([MAT_BREAD:95, MAT_SALT:5]));
  SetProp(P_SMELL, "Das Salzstangerl riecht nur alt.\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Bist Du verrueckt, das Salzstangerl weglegen zu wollen?\n"
                    "Du wirst das sicher noch fuer etwas brauchen koennen.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 0);
  AddCmd( ({ "zerkleiner","zerkleinere","brich","breche",
             "zerteile","teile","zerbroesel","zerbroesle","zerbroesele",
             "zerkruemel","zerkruemle","zerkruemele" }), "zerkleinern" );
}

zerkleinern(string str)
{
  notify_fail("Was moechtest Du zerkleinern?\n");

  if( -1!=member( ({ "salzstangerl","stangerl","stangerl auseinander"
                  }),str) )
  {
    notify_fail("Das Salzstangerl wurde von Dir bereits in tausend kleine Teile zerteilt.\n"
                "Das muesste reichen!\n");

    if( zerkleinert==1 ) { return 0; }

    tell_object(TP,
      "Du nimmst das Salzstangerl in die Hand und zerteilst es sorgfaeltig in exakt\n"
      +(500+random(100))+" Teile. Irgendwie schien Dir diese Anzahl genau die richtige zu sein.\n");
    tell_room(environment(this_player()),
      TP->Name()+" macht was mit dem Salzstangerl.\n",({ TP }) );
    zerkleinert=1;

    SetProp(P_SHORT, "Ein ehemaliges Salzstangerl");
    SetProp(P_LONG, "Viel vom Salzstangerl ist nicht mehr geblieben, da es nun "
                    "nur mehr Kruemel gibt.");
    AddDetail( ({ "kruemel" }),
      "Die Kruemel koennen sicher leicht von Voegeln gefressen werden.");
    return 1;
  }
}
int zerkleinert() { return zerkleinert; }
