//Kletterhaken, Rage Okt 99

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>

nosave int seil;
create()
{
  if ( !is_clone(TO) ) return;
  ::create();
  seil=0;

  SetProp(P_SHORT, "Ein Kletterhaken");
  SetProp(P_LONG,
    "Du haeltst in Deinen Haenden einen Kletterhaken, wie ihn nur Zwerge "
    "schmieden koennen. Der ist so gut verarbeitet, dass Du damit sicher "
    "die steilsten Felswaende ueberwinden kannst." );
  SetProp(P_NAME, "Kletterhaken");
  SetProp(P_GENDER, MALE);
  AddDetail( ({"zwerg","zwerge"}),
   "Zwerge sind bekannt fuer die Herstellung von Waffen, aber auch, wie "
   "in diesem Fall, fuer Gebrauchsgegenstaende.");
  AddDetail( ({"felswand","felswaende","wand","waende"}),
   "Such Dir eine geeignete Wand, dann kann es schon losgehen mit der "
   "Kletterei!");
  AddDetail( ({"haende","hand"}),
   "Mit Deinen Haenden haettest Du das nie geschafft. Du bist froh, dass "
   "Dir diese Arbeit abgenommen wurde.");
  AddId( ({ "haken","kletterhaken","BLU_HAKEN","QUESTOBJ" }) );

  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Den Haken brauchst Du doch noch.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_SMELL, "Auch nach laengerem Schnuppern, riecht der Haken nach nichts.\n");
  AddCmd( ({ "bind","binde" }), "binden" );
}

binden (string str)
{
  notify_fail("Was moechtest Du woran festbinden?\n");

  if ( -1!=member( ({ "haken an seil fest","kletterhaken an seil fest",
                      "haken an seil","kletterhaken an seil",
                      "seil an haken","seil an kletterhaken",
                      "seil an haken fest","seil an kletterhaken fest"
                    }),str) )
  {
    notify_fail("Am Haken ist schon ein Seil festgebunden.\n");

    if( seil==1 ) { return 0; }

    notify_fail("Ohne Seil wird das wohl nichts werden.\n");

    if ( !present("seil",TP) ) { return 0; }

    tell_object(TP,
      "Du bindest das Seil gekonnt an den Kletterhaken.\n");
    tell_room(environment(this_player()),
      TP->Name()+" bindet das Seil gekonnt am Kletterhaken fest.\n",
      ({ TP }) );
    seil=1;
    present("seil",TP)->remove();

    SetProp(P_SHORT, "Ein Kletterhaken mit angebundenem Seil");
    SetProp(P_LONG,
      "An diesen Haken wurde erst vor kurzem ein Seil von Dir festgebunden." );
    return 1;
  }
}

seil()
{
  SetProp(P_SHORT, "Ein Kletterhaken mit angebundenem Seil");
  SetProp(P_LONG,
    "An diesen Haken wurde erst vor kurzem ein Seil von Dir festgebunden.");
  seil=1;
}

int seil_angebunden() { return seil; }
