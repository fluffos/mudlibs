//Ledersandalen, Rage Okt99

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Ledersandalen");
  SetProp(P_LONG,"Ein spezielles Paar Ledersandalen mit rutschfesten Sohlen, "
                 "ideal zum Klettern.");
  SetProp(P_NAME, "Paar Ledersandalen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 150);
  SetProp(P_WEIGHT, 250);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_SMELL, "Du brauchst sie nur zu tragen und nicht zu inhalieren, denn wer weiss, wie\n"
                   "oft sich der Gaertner in letzter Zeit gewaschen hat.\n");
  SetProp(P_NODROP,"Die Schuhe gibst Du freiwillig sicher nicht her.\n");
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  AddId( ({ "sandalen","ledersandalen","BLU_SANDALEN","QUESTOBJ" }) );

  AddDetail( ({ "sohle","sohlen" }),
    "Die Sohlen scheinen sehr haftend zu sein, denn Du bekommst kaum mehr "
    "Deinen Finger wieder runter.");
  AddDetail( ({ "klettern" }),
    "Wenn Du mal klettern gehst, wirst Du die Sandalen sicher gut brauchen "
    "koennen.");
}
