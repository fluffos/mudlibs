// Questansprechperson Blu, Rage Okt 99

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "../bluquest.h"

nosave string * hilfe;
string feenantwort(string key);
string belohnung(string key);

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  hilfe=({});

  SetProp(P_SHORT, "Blu Menerde, ein Zwergengaertner");
  SetProp(P_LONG,
    "Endlich scheinst Du den Gaertner dieser Beete gefunden zu haben. "
    "Aeusserlich sieht er aus wie alle anderen Zwerge, doch scheint ein Elf "
    "an ihm verlorengegangen zu sein. Er kuemmert sich um jedes kleinste "
    "Pflaenzchen, als ob sein Leben davon abhaengen wuerde. Doch ganz "
    "zufrieden blickt er nicht drein.");
  SetProp(P_NAME, "Blu Menerde");
  SetProp(P_GENDER, MALE);
  AddId( ({ "blu","blu menerde","gaertner","zwerg" }) );
  set_living_name("blu");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "zwerg");
  SetProp(P_SIZE, 123);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOATTACK, "will nicht mit Dir kaempfen.");
  SetProp(P_SOUND, "Blu murmelt dauernd etwas vor sich dahin.\n");
  SetProp(P_SMELL, "Wie nicht anders zu erwarten, riecht der Gaertner sehr "
                   "nach Garten.\n");
  SetProp(P_LOG_INFO, "/rage/blu");

//INFOS

  SetChats(3, ({
    "Blu murmelt irgendwas von Unkraut, das schneller nachwaechst, als er es\n"
    "jaeten kann.\n",
    "Der Gaertner schaut verzweifelt drein, anscheinend plagt ihn etwas.\n",
    "Blu ist sehr niedergeschlagen. Er verflucht das Unkraut, das ueberhand in\n"
    "seinem schoenen Garten nimmt.\n"
                }) );

  AddInfo(DEFAULT_INFO, ({
    "will nicht darueber reden.\n",
    "schaut Dich verwundert an.\n",
    "meint: Alles kann ich auch nicht wissen.\n",
    "denkt nur: Du bist wohl zu faul, Dir selbst darueber Gedanken zu\nBlu "
    "Menerde denkt nur: machen." }) );
  AddInfo( ({ "problem","plage","probleme","problemen" }),
    "Das grosse Problem ist das Unkraut, das hier waechst und mit dem ich "
    "kaum mehr fertig werde.",
    "sagt niedergeschlagen: ");
  AddInfo( ({ "unkraut","hilfe" }),
    "Viel zu viel Unkraut ist hier. Ich komme einfach mit dem Jaeten nicht "
    "mehr nach. Vielleicht willst Du mir helfen, falls ja, dann tippe "
    "'hilf blu' ein.",
    "erzaehlt: ");
  AddInfo( "jaeten",
    "Das Unkraut waechst schneller, als ich es jaeten kann.",
    "schnieft traurig: ");
  AddInfo( ({ "vogel","taube","bloeder vogel" }),
    "Ich glaub, es war eine Taube. Die hat ihr Nest irgendwo in der Felswand "
    "drin. Wo genau, weiss ich auch nicht. Was die wohl mit den Phiolen machen "
    "will?",
    "gruebbelt: ");
  AddInfo( "uebel",
    "Ja, genau. Schuld daran ist nur dieser Vogel, der mit meiner Phiole auf "
    "und davon geflogen ist.",
    "aergert sich ein wenig: ");
  AddInfo( ({ "nest","vogelnest" }),
    "Ich denke mal, die Taube wird ihr Nest irgendwo in der Felswand haben. "
    "Du wirst sie schon finden, da bin ich mir sicher.",
    "schaut Dich zuversichtlich an: ");
  AddInfo( "rage",
    "Rage? Hmmm. Von dem habe ich doch schon einmal gehoert. Ich kann aber "
    "mit dem Namen im Moment nichts anfangen.",
    "antwortet: ");
  AddInfo( "pflaenzchen",
    "Ja, ich habe hier sehr viele, kleine Pflaenzchen, um die ich mich "
    "kuemmern muss.",
    "nickt: ");
  AddInfo( ({ "blu","zwerg","gaertner" }),
    "Du kannst vielleicht unnoetige Fragen stellen. Soll ich mich jedes Mal "
    "fuer Dich vorstellen, wenn Du in den Raum kommst? Tststs.",
    "wundert sich: ");
  AddInfo( ({ "phiole","phiolen" }),
    "Naja, sie ist ziemlich klein, sonst haette sie der Vogel kaum schnappen "
    "koennen. Ich hoffe nur, dass der Stoppel noch drauf ist, sonst raucht "
    "die Fluessigkeit aus, und dann ist sie fuer nichts mehr zu gebrauchen.",
    "erklaert Dir: ");
  AddInfo( ({ "flaeschchen","flasche" }),
    "Meinst Du die Phiole vielleicht?",
    "frag nach: ");
  AddInfo( ({ "essen","futter","wuermer","taubenfutter","vogelfutter" }),
    "Tauben fressen hauptsaechlich Semmeln, Kipferl oder Salzstangerl, hin "
    "und wieder natuerlich auch Wuermer.",
    "teilt Dir mit: ");
  AddInfo( ({ "stock","holzstock","stab" }),
    "Hmm, in Felonia habe ich schon einmal einen Holzstock gesehen.",
    "redet mit Dir: ");
  AddInfo( ({ "vorsprung","felsvorsprung" }),
    "Ich klettere da bestimmt nicht hinauf!",
    "sagt energisch: ");
  AddInfo( ({ "fels","felsen" }),
    "Nachdem der Garten von Felswaenden umgeben ist, ist es nur logisch, dass "
    "es auch dementsprechend viele Felsen geben wird.",
    "schuettelt nur den Kopf: ");
  AddInfo( ({ "nische","felsnische" }),
    "Das kann leicht sein, dass in der Felswand irgendwo eine Nische ist, in "
    "der sich die Taube versteckt, aber das kann ich von hier unten nicht "
    "erkennen.",
    "nickt Dir zu: ");
  AddInfo( ({ "nest","taubennest" }),
    "Ich nehme schon mal an, dass die Taube auch ein Nest haben wird.",
    "mutmasst: ");
  AddInfo( ({ "stoppel","stopel","stoeppel","pfropfen" }),
    "Wenn der Stoppel nicht festsitzt, kann es passieren, dass die "
    "Fluessigkeit herausrinnt, und das waere ganz schlecht.",
    "erklaert Dir weiters: ");
  AddInfo( "behaelter",
    "Wozu brauchst Du einen Behaelter schon wieder? Ich habe keinen!",
    "kommt aus dem Staunen nicht raus: ");
  AddInfo( "kapelle",
    "Durch die bist Du doch zu mir gekommen.",
    "schuettelt nur den Kopf.");
  AddInfo( "koeder",
    "Willst Du angeln gehen oder was meinst Du jetzt?",
    "schaut Dich verdutzt an: ");
  AddInfo( ({ "fluessigkeit","mixtur","troepfchen" }),
    "Die Mixtur habe ich von Elsurion eines Tages bekommen, als wir ueber die "
    "neuesten Kraeuter und ihre Wirkungen gesprochen haben. Ich nenne sie "
    "einfach Unkrautvernichter, denn das ist genau das, was sie macht. Ein "
    "Troepfchen und das Unkraut ist binnen zwei Stunden weg. Wenn Du sie "
    "hast, tippe einfach 'vernichte unkraut'.",
    "sagt: ");
  AddInfo( ({ "wirkung","wirkungen" }),
    "Die Wirkungen diverser Kraeuter werde ich Dir sicher nicht verraten. Das "
    "musst Du schon selbst rausfinden.",
    "laechelt: ");
  AddInfo( "kraeuter",
    "Mit Elsurion rede ich immer ueber die neuesten Kraeuter, weil er sich "
    "ziemlich gut dabei auskennt.",
    "schweift aus: ");
  AddInfo( ({ "elsurion","plaeuschchen" }),
    "Das ist ein sehr guter Freund von mir, der in Tijara lebt. Wir treffen "
    "uns regelmaessig zu einem Plaeuschchen.",
    "antwortet: ");
  AddInfo( ({ "freund","freunde","freunden" }),
    "Also Elsurion ist ein sehr guter Freund von mir, aber ich habe noch sehr "
    "viele andere, aber die aufzuzaehlen wuerde Dich doch nur langweilen. Ich "
    "hoffe, dass Du auch schon ein paar Freunde im Silberland hast.",
    "blickt Dich an: ");
  AddInfo( "silberland",
    "Im Silberland wohne ich, so wie alle anderen, denen Du begegnest. Manche "
    "bleiben laenger hier, andere ziehen wieder schnell weiter.",
    "spricht: ");
  AddInfo( "tijara",
    "Hmm, da war ich jetzt laenger nicht mehr. Ich sollte man wieder bei "
    "Elsurion vorbeischauen.",
    "denkt laut: ");
  AddInfo( "gemuese",
    "Naja, ich bau schon verschiedene Sorten Gemuese an, wie Erdaepfel, "
    "Kresse, Bohnen und Fisolen.",
    "erzaehlt: ");
  AddInfo( ({ "erdaepfel","kresse","bohnen","fisolen" }),
    "Jaja, das baue ich hier in meinem kleinen Garten an.",
    "nickt: ");
  AddInfo( ({ "kletterschuhe","kletterschuhen","kletterstiefel","wanderstiefel",
              "kletterstiefeln","wanderstiefeln","bergstiefel","bergstiefeln",
              "stiefel","stiefeln" }),
    "So etwas habe ich leider nicht. Wie Du siehst, habe ich nur einfache "
    "Ledersandalen an.",
    "zuckt mit den Schultern: ");
  AddInfo( ({ "sack","beutel","saeckchen","tasche","fackel","laterne" }),
    "Sowas habe ich leider nicht dabei, darum musst Du Dich selbst kuemmern.",
    "meint nur: ");
  AddInfo( ({ "felswand","wand","felswaende","felswaenden","waende",
              "waenden" }),
    "Die Felswand direkt hinter Dir hat zwar einige Risse, an denen man sich "
    "festhalten kann, aber ohne einem geeigneten Hilfsmittel kannst Du sicher "
    "nicht hochklettern, dafuer geht es mit umso leichter.",
    "grinst Dich an: ");
  AddInfo( ({ "hoehle","hoehlen","hoehlenforscher" }),
    "Ich lebe zwar selbst in einer Hoehle, habe aber sonst nicht viel mit "
    "ihnen zu tun. Ich bin eben ein Gaertner und kein Hoehlenforscher.",
    "schweift ab: ");
  AddInfo( "mittel",
    "Meinst Du nun ein Hilfsmittel zum Klettern, ein Lockmittel fuer den Vogel "
    "oder das Unkrautvertilgungsmittel?",
    "fragt nach: ");
  AddInfo( ({ "hilfsmittel","utensil","kletterhilfe","kletterutensil",
              "kletterzeug","kletterwerkzeug","hilfsmitteln","hilfmittel",
              "kletterutensilien","utensilien" }),
    "Aso. Ohne Hilfsmittel wirst Du die Felswand sicher nicht raufkommen. Ein "
    "Seil und ein Kletterhaken waeren sicher vorteilhaft.",
    "antwortet: ");
  AddInfo( "werkzeug",
    "Bitte drueck Dich genauer aus! Meinst Du Garten- oder Kletterwerkzeug?",
    "fragt nach: ");
  AddInfo( ({ "muenze","geld" }),
    "Brauchst Du Geld? Dann geh doch am besten zur Bank. Ich habe keines fuer "
    "Dich.",
    "sagt: ");
  AddInfo( "bank",
    "In Midas gibt es eine Bank.",
    "nickt Dir zu: ");
  AddInfo( "seil",
    "Das kannst Du im Laden kaufen, falls Du keines haben solltest.",
    "sagt: ");
  AddInfo( ({ "lockmittel","futtermittel","locken","fressen","art" }),
    "Ich denke, dass sich als Lockmittel fuer einen Vogel irgendeine Art von "
    "Futter eignen koennte.",
    "denkt nach: ");
  AddInfo( "pflanzen",
    "In meinem Garten wachsen sowohl Blumen als auch Gemuese. Sie Dich "
    "ruhig um.",
    "sagt Dir mit der Hand deutend: ");
  AddInfo( "laden",
    "In Felonia gibt es einen Laden. Da bekommst Du auch sicher ein Seil.",
    "spricht: ");
  AddInfo( ({ "felonia","zwergenhoehle","hoehle" }),
    "Du bist gerade in einem Teil davon. In Felonia leben die Zwerge, aber "
    "das ist Dir sicher schon aufgefallen.",
    "sagt: ");
  AddInfo( "zwerge",
    "Die wirst Du oefters hier antreffen, denn schliesslich bist Du in "
    "einem Teil von Felonia.",
    "nickt: ");
  AddInfo( ({ "salzstangerl","salziges","salzigem","stangerl","salzigen",
              "salzstange","stange","salzstangen","salzstangerln",
              "salzstangel" }),
    "Ein Salzstangerl brauchst Du also? Ich habe da noch ein altes vom "
    "letzten Einkauf, das kannst Du gern haben. Bitte mich darum.",
    "sieht auf und sagt: ");
  AddInfo( "einkauf",
    "Auch ich muss hin und wieder etwas einkaufen. Alles zuechte ich auch "
    "nicht in meinem schoenen Garten.",
    "erklaert bereitwillig: ");
  AddInfo( "salz",
    "Mit Salz kann ich Dir nicht gerade weiterhelfen, aber dafuer mit einem "
    "Salzstangerl.",
    "bietet Dir seine Hilfe an: ");
  AddInfo( "brot",
    "Brot habe ich keines, aber ich koennte Dir mit einem Salzstangerl weiter "
    "helfen.",
    "bietet Dir an: ");
  AddInfo( ({ "blumen","sorten","blume" }),
    "Davon habe ich schon soviele verschiedene, dass ich selbst nicht mehr "
    "weiss, welche Sorten darunter sind.",
    "zuckt mit den Schultern: ");
  AddInfo( ({ "kipferl","semmerl","semmel","semmeln" }),
    "Kipferl und Semmel gibt es in der Baeckerei zu kaufen.",
    "antwortet Dir: ");
  AddInfo( ({ "salzbrezel","brezel" }),
    "Tut mir leid, Brezel habe ich keine, aber willst Du ein Salzstangerl?",
    "entschuldigt sich: ");
  AddInfo( "aufgabe",
    "Du willst schon aufgeben? Sehr schade, ich dachte Du wuerdest laenger "
    "durchhalten!",
    "spricht: ");
  AddInfo( "steigeisen",
    "Steigeisen solltest Du keines brauchen, sondern ein Seil und ein "
    "Kletterhaken muessten auch reichen.",
    "meint nur: ");
  AddInfo( ({ "kletterhaken","haken" }),
    "Den hat auch der Vogel mir weggeschnappt, aber der war ihm wohl zu "
    "schwer, denn ich sah noch, wie er ihn fallen liess. Ich schaetze, "
    "der muesste noch immer in einer Ritze in der Felswand liegen.",
    "erzaehlt: ");
  AddInfo( ({ "ledersandalen","sandalen","schuhe","schuh","schuhen",
              "sandale","schuhwerk" }),
    "Oja. Das sind gute Sandalen, die ich da habe. Die koennen einem beim "
    "Bergsteigen helfen aufgrund ihrer rutschfesten Sohle. Brauchst Du "
    "sie? Dann bitte mich einfach darum.",
    "gibt Dir die Auskunft: ");
  AddInfo( ({ "sohle","sohlen","bergsteigen" }),
    "Die ruschfesten Sohlen der Ledersandalen koennten Dir beim "
    "Bergsteigen sehr helfen.",
    "sagt: ");
  AddInfo( ({ "ausruestung","kletterausruestung" }),
    "Zum Klettern braucht man immer das geeignete Schuhwerk. Weshalb bist "
    "Du wohl ausgerutscht? Denk mal darueber nach!!",
    "tadelt Dich: ");
  AddInfo( ({ "unkrautvertilgungsmittel","unkrautvernichter",
              "unkrautvernichtungsmittel","unkrautvertilger",
              "vertilgungsmittel" }),
    "Ja, das ist in den Phiolen drin.",
    "berichtet: ");
  AddInfo( ({ "ritze","ritzen" }),
    "Schau mal dort nach! Der Haken muesste noch dort liegen.",
    "erklaert Dir: ");
  AddInfo( ({ "hacke","hacken" }),
    "Also wenn Du den Kletterhaken meinst, kann ich nur sagen, dass der "
    "irgendwo in der Felswand liegen muesste.",
    "nickt: ");
  AddInfo( ({ "name","namen" }),
    "Also gut. Fuer die ueberschlauen Leute wie Dich, die ueberhaupt nichts "
    "mitkriegen: Ich heisse Blu Menerde. Ich hoffe, Du willst jetzt nicht auch "
    "noch wissen, was mein Lieblingsessen ist.",
    "stoehnt: ");
  AddInfo( "lieblingsessen",
    "Du kannst aber einem auf die Nerven gehen. Lass mich in Ruh' und mache "
    "Dich an die Arbeit!",
    "grummelt: ");
  AddInfo( "garten",
    "Der Garten ist mein ein und alles. Jede freie Minute nuetze ich aus, um "
    "die Zeit im Kapellgarten zu geniessen. Ich hege die Blumen und sorge "
    "dafuer, dass das Gemuese von Unkraut frei bleibt.",
    "schwaermt: ");
  AddInfo( "kapellgarten",
    "Mein Garten gehoert zum Kapellgarten, den die Zwerge hier angelegt "
    "haben.",
    "gibt Dir Auskunft: ");
  AddInfo( ({ "klettern","kletterei" }),
    "Ohne hier zu klettern, wirst Du nicht weit kommen, denn es geht hier "
    "steil nach oben. Eine gute Kletterausruestung kann auch sicher nicht "
    "schaden!",
    "grinst: ");
  AddInfo( ({ "spalt","spalte","spalten","riss","risse","rissen" }),
    "Was genau meinst Du jetzt? Natuerlich haben Felswaende auch Spalten und "
    "Risse, aber das sollte doch nichts Neues fuer Dich sein.",
    "schaut verdutzt drein: ");
  AddInfo( ({ "jaeten","gartenarbeit","arbeit" }),
    "Es ist ganz wichtig regelmaessig zu jaeten, damit das Unkraut nicht zu "
    "sehr wuchert, aber es bleibt mir staendig eine Plage.",
    "seufzt: ");
  AddInfo( "leiter",
    "Was willst Du mit einer Leiter? Etwa auf die Feldwand damit klettern? "
    "Damit geht doch das nicht! Ein Seil und ein Kletterhaken muessen da schon "
    "her.",
    "schaut Dich erstaunt an: ");
  AddInfo( "methode",
    "Ah! Du willst wohl wissen, wie Du an den Kletterhaken kommst? Ich an "
    "Deiner Stelle wuerde einfach mal versuchen in die Ritze hineinzugreifen.",
    "hilft Dir weiter: ");
  AddInfo( ({ "gedanke","gedanken" }),
    "Mach Dir doch einmal deine eigenen Gedanken. Ich habe auch meine und die "
    "verrat ich Dir sicher nicht alle.",
    "wundert sich: ");
  AddInfo( "schaufel",
    "Sicher, eine Schaufel kann man schon hin und wieder bei der Gartenarbeit "
    "brauchen, aber derzeit brauche weder ich noch Du eine.",
    "gibt Dir recht: ");
  AddInfo( "angel",
    "Nein, also Angel habe ich wirklich keine bei mir. Ich wuerde es in einem "
    "Laden oder bei einem Angler probieren.",
    "sagt: ");
  AddInfo( ({ "angler","fischer" }),
    "Ich bin Gaertner, kein Fischer!",
    "stampft leicht auf den Boden auf: ");
  AddInfo( ({ "beet","beete","beeten","gemuesebeet" }),
    "Schau Dich ruhig hier um, ich habe hier einen schoenen Garten mit "
    "vielen Beeten.",
    "schwaermt: ");
  AddInfo( "ablenkung",
    "Wenn Du eine kleine Ablenkung brauchst, dann hilf mir einfach!",
    "nickt Dir zu: "); 
  AddInfo( "blumenerde",
    "Blumenerde kann ich fuer meinen Garten immer brauchen, und wenn Du es "
    "richtig betonst, dann hast Du Blu Menerde.",
    "kichert: ");
  AddInfo( ({ "rutsche","kind" }),
    "Was willst Du noch mit einer Rutsche? Du bist doch kein kleines Kind "
    "mehr!",
    "wundert sich: ");
  AddInfo( "quest",
    "Willst Du mir helfen oder wie meinst Du das?",
    "blickt Dich ueberrascht an: ");
  AddInfo( ({ "kruemeln","kruemel","krume","krumen","brotkruemel",
              "brotkruemeln" }),
    "Erwartest Du von mir, dass ich Kruemel eingesteckt habe oder wie meinst "
    "Du das?",
    "schaut verdutzt: ");
  AddInfo( "sex",
    "Du hast wohl keinen, wenn Du danach fragen musst!",
    "troestet Dich: ");
  AddInfo( "bonbon",
    "Also ich weiss nicht, wie Du darauf kommst, dass ich ein Bonbon fuer Dich "
    "haette. Ich kann Dir leider auch nicht sagen, wo Du eines findest.",
    "zuckt die Schultern: ");
  AddInfo( ({ "kork","korken" }),
    "Du bist schon selbst alt genug, dass Du wissen muesstest, was man mit "
    "einem Korken macht.",
    "laechelt Dir zu: ");
  AddInfo( ({ "binden","festbinden","befestigen" }),
    "Wenn Du einen Kletterhaken und ein Seil hast, koenntest Du das Seil "
    "am Kletterhaken festbinden.",
    "hilft Dir weiter: ");
  AddInfo( ({ "rutsche","rutschen" }),
    "Bist Du so verspielt, dass Du sonst nichts zu tun hast?",
    "schuettelt den Kopf: ");
  AddInfo( ({ "strauss","blumenstrauss","suche" }),
    "Mach Dich doch selbst auf die Suche nach einem!",
    "taetschelt Dir den Kopf: ");
  AddInfo( ({ "locke","locken","herauslocken","lockstoff" }),
    "Ich weiss ehrlich gesagt ueberhaupt nicht, was Du meinst.",
    "antwortet Dir: ");
  AddInfo( ({ "wurm","wuermer" }),
    "Wuermer sind gut fuer das Erdreich, denn sie lockern die Erde "
    "auf.",
    "nickt: ");
  AddInfo( ({ "erde","erdreich" }),
    "Davon wirst Du in meinem Garten sicher genug finden.",
    "kichert: ");
  AddInfo( ({ "ork","orks" }),
    "Mit Orks habe ich nichts zu tun!",
    "antwortet bestimmt: ");
  AddInfo( "baecker",
    "Einen Baecker wirst Du sehr leicht in Felonia finden.",
    "nicht Dir zu: ");
  AddInfo( "glueck",
    "Das kann man doch immer brauchen, findest Du nicht?",
    "grinst: ");
  AddInfo( ({ "vernichten","vernichte" }),
    "Wenn Du die Phiole hast, brauchst Du nur mehr das Unkraut damit "
    "vernichten und Du hast es geschafft.",
    "freut sich schon: ");
  AddInfo( "belohnung",
    #'belohnung,
    "antwortet: ", 1);
  
//fuer Feenquest

  AddInfo( ({ "heckenschere","schere","gartenschere" }),
    "Ja, ich habe tatsaechlich eine Heckenschere auf meinen Wanderungen in der "
    "Naehe des Feenschlosses gefunden. Bei der Gartenarbeit ist die immer gut "
    "zu gebrauchen. Bist Du in solch einer Not, dass Du sie brauchst? Dann "
    "tippe <brauche schere>.",
    "sagt erfreut: ", 1);
  AddInfo( ({ "schaerfe","schaerfen","schleifen","schleifer" }),
    "Ich bin nur ein einfacher Gaertner, ich kann Dir doch keine Gartenschere "
    "schaerfen. Da musst Du Dir wen anders suchen.",
    "entschuldigt sich: ");
  AddInfo( "oberdiener",
    "Im Feenschloss gibt es einen Oberdiener, der darauf achtet, dass alle im "
    "Schloss auch fleiss arbeiten, weil die Feen sind es gewohnt, dass alles "
    "um ihnen herum sauber und rein ist.",
    "meint: ");
  AddInfo( ({ "gartenwerkzeug","gartenwerkzeuge","gartenwerkzeugen" }),
    "Gartenwerkzeuge gibt es sehr viele verschiedene. Die zaehle ich Dir nun "
    "ganz sicher nicht auf. Fuer Dich ist nur die Heckenschere wichtig!",
    "antwortet gelangweilt: ");
  AddInfo( ({ "feenschloss","schloss" }),
    "Das Feenschloss liegt im Silberwald. Immer, wenn ich von einem Besuch bei "
    "Elsurion nach Hause zurueckgehe, schaue ich kurz beim Schloss vorbei und "
    "kontrolliere den Zustand der Hecke.",
    "berichtet: ");
  AddInfo( "besuch",
    "Selbstverstaendlich besuche ich meine Freunde auf meinen Wanderungen. "
    "Machst Du das etwa nicht?",
    "blickt Dich fragend an: ");
  AddInfo( "silberwald",
    "Der Silberwald breitet sich suedlich vom Gebirge bis nach Midas aus. "
    "Darin liegt unter anderem auch das Feenschloss.",
    "erklaert ausfuehrlich: ");
  AddInfo( "midas",
    "Midas liegt suedoestlich vom Silberwald. Dort findest Du sicher alles, "
    "was Du so brauchen kannst.",
    "hilft Dir weiter: ");
  AddInfo( "gebirge",
    "Du befindest Dich mitten im Gebirge, wie Dir sicher schon aufgefallen "
    "ist.",
    "schuettelt nur den Kopf: ");
  AddInfo( ({ "hecke","hecken" }),
    "Die Hecke schneide ich im Durchschnitt einmal in der Woche, weil die "
    "Feen, mit ihren zaertlichen Haenden, sich ja nicht schmutzig machen "
    "wollen und ihnen ausserdem die noetige Kraft fehlt, um die Heckenschere "
    "verwenden zu koennen.",
    "blickt Dich an: ");
  AddInfo( "woche",
    "Einmal pro Woche schau ich beim Feenschloss vorbei, um die Hecke zu "
    "schneiden. ",
    "berichtet: ");
  AddInfo( ({ "kraft","muskelkraft" }),
    "Feen sind eben nicht so stark, denen fehlt die noetige Kraft, um die "
    "Heckenschere verwenden zu koennen",
    "schuettelt den Kopf: ");
  AddInfo( ({ "hand","haende","haenden" }),
     "Jaja, die Feen haben so zaertliche Haende, dass sie sich zu schade sind, "
     "eine Heckenschere selbst in die Hand zu nehmen.",
     "kichert ein wenig: ");
  AddInfo( ({ "blase","blasen" }),
    "Falls Du lange mit der Heckenschere herum schneidest, kann es schon "
    "passieren, dass Du Blasen an den Haenden bekommst!",
    "warnt Dich: ");
  AddInfo( ({ "handschuh","handschuhe","handschuhen" }),
    "Also ich kann meine Gartenarbeit ohne Handschuhe erledigen. Wie das bei "
    "Dir aussieht, kann ich natuerlich nicht sagen.",
    "meint nur: ");
  AddInfo( "labyrinth",
    "Bei dem Feenschloss gibt es ein Labyrinth, dessen Hecken ich regelmässig "
    "schneide.",
    "erzaehlt: ");
  AddInfo( ({ "baldu","hobbit" }),
    "Achja, Baldu, das ist ein feiner Hobbit. Den hab ich schon ein paar Mal "
    "getroffen auf meinen Wanderungen. Den koennte ich auch mal wieder "
    "besuchen. Danke, dass Du mich erinnerst.",
    "schaut Dich erfreut an: ");
  AddInfo( ({ "wanderung","wanderungen" }),
    "Ich weiss gar nicht mehr ganz genau, wohin ich ueberall auf meinen "
    "Wanderungen gekommen bin, aber gesehen habe ich schon sehr viel.",
    "sagt: ");
  AddInfo( ({ "rasse","rassen" }),
    "Ich finde, dass die Feen eine nette Rasse sind. Es gibt noch viele "
    "andere, aber Du wirst Du sicher noch kennen lernen.",
    "blickt verschwaermt drein: ");
  AddInfo( ({ "fee","feen" }),
    #'feenantwort, "antwortet: ", 1);
    
//INFOS END

//OBJECTS

  SUID;
  CLONEME("d/gebirge/dusty/zwerge/obj/zhose.lpc");
  CLONEME("d/gebirge/rage/quest/obj/ledersandalen.lpc");
  CLONEME("d/gebirge/dusty/zwerge/obj/kapu.lpc");
  CLONEME("p/armour/armour/hemd.lpc");
  command("trage alles");

//DETAILS

  AddDetail( ({ "gaertner" }),
    "Es ist schon ungewoehnlich, dass ein Zwerg ein Gaertner ist, aber dieser "
    "scheint seine Berufung gefunden zu haben.");
  AddDetail( ({ "zwerge" }),
    "Fuer gewoehnlich schuerfen sie nach Gold und Edelsteine, aber nicht alle, "
    "wie Du hier sehen kannst.");
  AddDetail( ({ "gold" }),
    "Das musst Du schon wo anders suchen.");
  AddDetail( ({ "edelsteine","edelstein" }),
    "Die musst Du schon wo anders suchen.");
  AddDetail( ({ "elf","elfen" }),
    "Elfen sind Meister, was Blumen, Pflanzen und anderes Gruenzeug anbelangt. "
    "Ganz kannst Du deinen Augen nicht trauen, dass dieser Garten tatsaechlich "
    "von einem Zwerg angelegt worden ist.");
  AddDetail( ({ "augen" }),
    "Untersuch nicht jeden Mist!");
  AddDetail( ({ "mist" }),
    "Pfui, Du stinkst!");
//END DETAILS

  AddCmd( ({ "bitt","bitte" }), "bitten" );
  AddCmd( ({ "vernichte","vernicht" }), "vernichten" );
  AddCmd( ({ "hilf","helf","helfe" }), "helfen" );
  AddCmd( ({ "brauche" }), "brauchen" );
}
//fuer Feenquest
string feenantwort(string key)
{
  if ( TP->QueryProp(P_GENDER)==MALE )
  {
    return
      "Die Feen sind eine nette Rasse. Ihnen fehlt es zwar an Muskelkraft, "
      "dafuer sind sie sehr klug und geschickt.\n"
      "Und unter uns: Sie koennen auch sehr betoerend sein.";
  }
  return
    "Die Feen sind eine nette Rasse. Ihnen fehlt es zwar an Muskelkraft, "
    "dafuer sind sie sehr klug und geschickt.";
} 

string belohnung(string key)
{
  if ( TP -> QueryQuest(BLUQUEST) )
    return
      "Du hast Deine Belohnung schon bekommen, noch eine bekommst Du von "
      "mir nicht, auch wenn Du bettelst.";
  return
    "Wenn Du mir hilfst, dann kannst Du eine Belohnung von mir bekommen.";
}
//COMMANDS

vernichten(string str)
{
  object BLU_PHIOLE;
  object BLU_STANGERL;
  object seil;
  object BLU_HAKEN;
  object BLU_SANDALEN;
  object blume;
  int fertig;

  notify_fail("Was genau willst Du machen?\n");

  if ( TP->QueryQuest(BLUQUEST) )
  {
    tell_object(TP,
      "Blu sagt: Du hast mir die Phiole bereits besorgt. Du brauchst nichts "
      "mehr tun.\n"
      "Blu sagt: Nochmals recht herzlichen Dank.\n");
    return 1;
  } 
// QUESTENDE

  if ( -1!=member( ({ "unkraut" }),str) )
  {
    if ( -1!=member(hilfe,getuid(TP)) )
    {
      if ( BLU_PHIOLE=present("BLU_PHIOLE",TP) )
      {
        fertig = TP->GiveQuest(BLUQUEST);
	if ( fertig==1 )
	{
          tell_object(TP,
            "Vorsichtig ziehst Du den Stoppel aus der Phiole und laesst einen "
            "Tropfen aufs\n"
            "Beet tropfen. Du siehst jetzt schon, dass das Unkraut langsam "
            "zurueckgeht.\n"
            "Blu nimmt Dir dankbar die Phiole aus der Hand und ueberreicht Dir "
            "als\n"
            "Belohnung eine schoene Blume.\n"
            "Waehrend Du Dir noch Gedanken machst, wie Du wieder an dein Seil "
            "kommst, hast\n"
            "Du es ploetzlich in der Hand, nur der Haken ist weg.\n"
            "");       
          write_file( BLUQUESTLOG,sprintf ("%s: %s hat Blu sehr helfen "
                                           "koennen.\n",
            dtime(time()), capitalize(TP->query_real_name())) );
	}
	else if( fertig!=-1)
	{
          write (sprintf("Unbekannter Fehler, bitte den zustaendigen Magier "+
                             "verstaendigen!\nFehlercode: %d\n", fertig));
          return;
        }  
        blume=clone_object("/d/seher/feyaria/obj/blume.lpc");
	if ( ME_TOO_HEAVY==blume->move(TP,M_GET|M_SILENT) )
          blume->move(TO,M_NOCHECK|M_SILENT);
        seil=clone_object("/obj/seil.lpc");
        if ( ME_TOO_HEAVY==seil->move(TP,M_GET|M_SILENT) )
          seil->move(TO,M_NOCHECK|M_SILENT);

	if ( BLU_STANGERL=present("BLU_STANGERL",TP) ) BLU_STANGERL->remove();
        if ( BLU_HAKEN=present("BLU_HAKEN",TP) ) BLU_HAKEN->remove();  
        if ( BLU_SANDALEN=present("BLU_SANDALEN",TP) ) BLU_SANDALEN->remove();
        hilfe-=({getuid(TP)});
        BLU_PHIOLE->remove();
        return 1;
      }
      tell_object(TP,
        "Blu kichert: Guter Witz, aber dazu brauchst Du auf alle Faelle die "
        "Phiole!\n");
      return -1;
    } 
    tell_object(TP,
      "Blu sagt verdutzt: Du hilfst mir ja nicht einmal!\n");
    return -1;
  }
}

//fuer Feenquest
brauchen(string str)
{
  object HUTSCHLEIER;
  object schere;
  
  notify_fail("Was brauchst Du von Blu?\n");  

  if ( -1!=member( ({ "schere" }),str) )
  {
    if ( present("\nheckenschere",TP) ) 
    {
      tell_object(TP,
        "Blu schaut Dich erstaunt an: Jetzt sag einmal! Wieviele Scheren willst Du\n"
        "Blu schaut Dich erstaunt an: von mir? Du hast doch schon eine.\n");
      return -1;
    } 
    if ( present("HUTSCHLEIER",TP) || present("\nFEENQUESTOBJ",TP) )
    {
      tell_object(TP,
        "Blu meint: Wie ich sehe, brauchst Du sie sehr dringend. Bitte sehr! Hier hast\n"
        "Blu meint: Du sie! Und freudiges Herumschneiden! Pass auf, dass Du keine\n"
        "Blu meint: Blasen bekommst!\n"
        "\n"
        "Blu reicht Dir die Heckenschere.\n");
      schere=clone_object("/d/ebene/ronja/feenquest/weapon/hschere.lpc");
      if ( ME_TOO_HEAVY==schere->move(TP,M_GET|M_SILENT) )
      {
        tell_object(TP,
          "Blu will Dir die Schere geben, aber sie ist Dir zu schwer.\n");
        schere->remove();
        return -1;
      }
      return 1;
    }
    tell_object(TP,
      "Blu sagt: Tut mir leid, "+TP->Name()+", aber die Heckenschere brauche ich selbst.\n"
      "Blu sagt: Komm doch einfach spaeter noch einmal, solange werde ich sie nicht\n"
      "Blu sagt: mehr brauchen.\n");
    return -1;
  }
}

bitten(string str)
{
  object BLU_PHIOLE;
  object BLU_SANDALEN;
  object BLU_STANGERL;
 
  if ( TP->QueryQuest(BLUQUEST) )
  {
    tell_object(TP,
      "Blu meint: Du brauchst nichts mehr, denn Du hast mir schon geholfen.\n");
    return -1;
  }
  if ( -1!=member(hilfe,getuid(TP)) )
  {
    if ( -1!=member( ({ "blu um schuhe", "blu um ledersandalen",
                        "blu um sandalen","gaertner um schuhe",
                        "gaertner um ledersandalen",
                        "gaertner um sandalen","zwerg um schuhe",
                        "zwerg um ledersandalen","zwerg um sandalen"
                      }),str) )
    {
      if ( present("BLU_SANDALEN",TP) )
      {
        tell_object(TP,
          "Blu meint: Ich habe doch nur ein Paar gehabt, und das hast jetzt Du.\n");
        return -1;
      }
      BLU_SANDALEN=clone_object("/d/gebirge/rage/quest/obj/ledersandalen.lpc");
      if ( ME_TOO_HEAVY==BLU_SANDALEN->move(TP,M_GET|M_SILENT) )
      {
        tell_object(TP,
          "Blu will Dir die Schuhe zwar geben, aber sie sind zu schwer fuer Dich.\n");
        BLU_SANDALEN->remove();
        return -1;
      }
      tell_object(TP,
        "Blu sagt: Hier bitte! Ich hoffe, Du hast damit mehr Glueck.\n");
      tell_room(environment(this_player()),
        TP->Name()+" hat etwas vom Gaertner bekommen.\n",({ TP }) );
      return 1;
    }
    if ( -1!=member( ({ "blu um salzstangerl","gaertner um salzstangerl",
			"zwerg um salzstangerl","blu um salzstange",
			"gaertner um salzstange","zwerg um salzstange"
                     }),str) )
    {
      if ( present("BLU_STANGERL",TP) )
      {
        tell_object(TP,
          "Blu tadelt Dich: Sei nicht so gierig, Du hast doch erst eben eines von mir\n"
          "Blu tadelt Dich: bekommen.\n");
        return -1;
      }
      if ( deep_present("BLU_PHIOLE",TP) )
      {
        tell_object(TP,
          "Du brauchst nun kein Salzstangerl mehr. Vernichte bitte nur mehr das Unkraut,\n"
          "dann hast Du mir sehr geholfen.\n");
        return -1;
      } 
      BLU_STANGERL=clone_object("/d/gebirge/rage/quest/obj/futterstangerl.lpc");
      if ( ME_TOO_HEAVY==BLU_STANGERL->move(TP,M_GET|M_SILENT) )
      {
        tell_object(TP,
          "Blu will Dir zwar das Salzstangerl geben, aber es ist zu schwer \n"
          "fuer Dich.\n");
        BLU_STANGERL->remove();
        return -1;
      }
      tell_object(TP,
        "Blu sagt: Hier bitte! Ich hoffe, das hilft Dir weiter.\n");
      tell_room(environment(this_player()),
        TP->Name()+" hat etwas vom Gaertner bekommen.\n",({ TP }) );
      return 1;
    }
    tell_object(TP,
      "Um was moechtest Du Blu bitten?\n");
    return -1;
  }
  tell_object(TP,
    "Blu meint: Du solltest mir schon zuerst helfen, bevor Du etwas von mir willst!\n");
  return -1;
}

helfen(string str)
{
  notify_fail("Wem willst Du helfen?\n");

  if ( TP->QueryQuest(BLUQUEST) )
  {
    tell_object(TP,
      "Blu sagt erleichtert: Vielen Dank, aber Du hast mir schon einmal geholfen!\n");
    return -1;
  }
  if ( -1!=member( ({ "blu","gaertner" }),str) )
  {
    if ( -1!=member(hilfe,getuid(TP)) )
    {
      tell_object(TP,
        "Blu meint: Ich dachte, Du hilfst mir bereits. Hast Du es Dir anders ueberlegt?\n");
      return -1;
    }
//QUESTSTART
    tell_object(TP,
      "Blu schaut auf: Du willst mir helfen? Das ist aber nett, dann erzaehl ich Dir,\n"
      "Blu schaut auf: was mein Problem ist.\n"
      "\n"
      "Blu erzaehlt Dir: Schuld an dem Uebel ist nur ein bloeder Vogel, der mir\n"
      "Blu erzaehlt Dir: meine letzte Phiole mit dem Unkrautvertilgungsmittel\n"
      "Blu erzaehlt Dir: gestohlen hat. Ich brauche ganz dringend wieder eine. Je\n"
      "Blu erzaehlt Dir: frueher, desto besser, sonst werde ich nie mehr Herr ueber\n"
      "Blu erzaehlt Dir: das Unkraut.\n");
    tell_room(environment(this_player()),
      TP->Name()+" ist in ein intensives Gespraech mit dem Gaertner verwickelt.\n",
      ({ TP }) );
    hilfe+=({getuid(TP)});
    return 1;
  }
}
//COMMANDS END

give_notify(object obj)
{
  if ( obj->id("BLU_PHIOLE") )
  {
   command_me("sag Sehr gut. Du hast die Phiole gefunden! Vernichte das Unkraut damit und\n"
              "Du hast mir sehr geholfen.\n");
   command_me(sprintf("gib %s an %s", lower_case(obj->name(RAW)), getuid(TP)));
   return ::give_notify(obj);
  } 
  command_me("sag Damit fange ich aber nichts an!");
  command_me(sprintf("gib %s an %s", lower_case(obj->name(RAW)), getuid(TP)));
  return ::give_notify(obj);
}
