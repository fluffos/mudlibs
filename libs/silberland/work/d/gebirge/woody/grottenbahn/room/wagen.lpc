
/*
** Standard-Objekt fuer den Wagen der Grottenbahn
** ---
** Mar  9, 1997  Woody
*/

#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../files.h"

inherit "std/room";
inherit ROOM("gb_sequencer");

mapping allowed=([]);
string prefix;
string *seq;
int cur;

SetColor(string f)
{
  SetProp(P_INT_SHORT, "In einem "+f+"en Wagen");
  SetProp(P_INT_LONG,
      "Du befindest Dich in einem doch recht geraeumigen, "+f+"en Wagen "
      "inmitten der beruehmt-beruechtigten Grottenbahn des Silberlands. "
      "Die Bank hinter Dir laedt zwar zum Sitzen ein, aber irgendwie ist "
      "es weder der richtige Ort noch die richtige Zeit, um sich entspannt "
      "zurueckzulehnen...");
}

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetColor("weiss");
  SetProp(P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));

  AddDetail ( ({ "wagen", "eindruck" }),
      "Der Wagen, in dem Du sitzt, macht keinen sehr vertrauenserweckenden "
      "Eindruck. An allen Ecken und Enden knarrt es, und der Haltegriff "
      "unmittelbar vor Dir hat wohl auch schon bessere Tage gesehen...");
  AddDetail ( ({ "ecken", "enden" }),
      "Obwohl der Wagen eigentlich relativ rundlich gebaut ist, hat er "
      "doch auch gefaehrliche Ecken und Enden. Pass auf, dass Du Dich "
      "nicht verletzt!");
  AddDetail ( ({ "haltegriff", "griff" }),
      "An ihm koennen sich schwaechere oder schwaechelnde Abenteurer "
      "festhalten.");
  AddDetail ( ({ "abenteurer" }),
      "Bist Du vielleicht einer?");
  AddDetail ( ({ "grottenbahn", "bahn" }),
      "Der Wagen, in dem Du sitzt, gehoert der Grottenbahn GesmbH des "
      "Silberlands, deren Bahn weithin beruehmt-beruechtigt ist und "
      "Erzaehlungen zufolge ziemlich gefaehrlich sein kann.");
  AddDetail ( ({ "bank", "sitzen" }),
      "Die Bank hinter Dir ist mit einem seltsamen Stoff ueberzogen, "
      "sieht zwar nicht ganz unbequem aus, aber Du hast besseres zu "
      "tun, als Dich jetzt darauf auszuruhen...");
  AddDetail ( ({ "stoff" }),
      "Es ist ein seltsamer mit mattem Rot gefaerbter Stoff, der sich "
      "kalt anfuehlt. Als Deine Hand darueberstreicht, bekommst Du "
      "eine Gaensehaut...");
  AddDetail ( ({ "rot", "dunkelrot" }),
      "Ganz gewoehnliches Dunkelrot, etwas schmutzig.");
  AddDetail ( ({ "hand" }),
      "Das, was an Deinen Armen dranhaengt, nennt man Hand.");
  AddDetail ( ({ "arm", "arme" }),
      "Du praesentierst allen Deine starken Arme.");
  AddDetail ( ({ "gaensehaut" }),
      "Brrrrr Wwwwwww Sssssssshhhhhh... Eklig!");
  AddDetail ( ({ "brrrrr", "wwwwwww", "sssssssshhhhhh" }),
      "Komm schon, lass das, das ist ja schon nicht mehr feierlich :-)");
  AddDetail ( ({ "schmutz" }),
      "Du betrachtest den Schmutz auf dem Stoff genauer, stellst "
      "aber nichts Besonderes fest.");
  AddDetail ( ({ "ort", "zeit" }),
      "Ort: Ein Wagen in der Grottenbahn. Zeit: Spielt das eine Rolle?");
  AddDetail ( ({ "rolle" }),
      "Nein, spielt es nicht :).");

  previous_object()->CustomizeObject();
}

