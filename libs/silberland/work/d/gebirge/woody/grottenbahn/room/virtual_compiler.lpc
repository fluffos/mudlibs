#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include "../files.h"

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM("") );
  SetProp(P_STD_OBJECT, ROOM("wagen"));
  SetProp(P_VALID_NAME, "wagen");
}

string Validate(string file)
{
  int x;
  string was, farbe;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", was, farbe) == 2) &&
      was == QueryProp(P_VALID_NAME) &&
      (member(GB_WAGENFARBEN, farbe) != -1))
    return file;
  else
    return 0;
}

int CustomizeObject()
{
  string name,foo,farbe;
  int x;
  if(!(name = ::CustomizeObject()) || sscanf(name,"%s:%s",foo,farbe)!=2)
    return 0;
  PO->SetColor(farbe);
  // if (!IS_SEER(TP)) PO->SetProp(P_LIGHT, 0);  // *grins*
  return 1;
}
