/*
** Der kleine gruene Grottenzwerg  (w) Woody@SL
** ---
** 1997-03-02  1.0  Release
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../files.h"
#define KARTENPREIS 900

mapping gekauft;

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"grottenzwerg", "zwerg"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Grottenzwerg");
  // SetProp (P_NAME_ADJ, "klein gruen");  // wird nicht richtig konjugiert :(
  SetProp (P_SHORT, "Ein kleiner gruener Grottenzwerg");
  SetProp (P_LONG, "Der kleine gruene Grottenzwerg grinst Dich gierig an. "
      "Seine Augen funkeln geheimnisvoll und sein Blick durchbohrt Dich "
      "geradezu. Seine Aufgabe ist es, gegen Goldmuenzen Fahrkarten fuer "
      "die beruehmt-beruechtigte Grottenbahn zu verkaufen.");
  SetProp (P_ALIGN, 50+random(50));
  SetProp (P_LEVEL, 15);
  SetProp (P_MAX_HP, 500+random(200));
  SetProp (P_MAX_SP, 300);
  SetProp (P_XP, 500000);
  SetProp (P_BODY, 45+random(20));
  SetProp (P_HEAL, -10);
  SetProp (P_SIZE, 120+random(20));
  SetProp (P_RACE, "Zwerg");
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_HANDS, ({" mit seinen kraeftigen Haenden", 180, DT_BLUDGEON}) );

  SetProp (P_SPELLRATE, 25);

  AddSpell(1, 300, 
    "Der Grottenzwerg legt Dich uebers Kreuz.\n",
    "Der Grottenzwerg legt @WEN uebers Kreuz.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 500, 
    "Der Grottenzwerg wirft einen Feuerpfeil nach Dir.\n",
    "Der Grottenzwerg wirft einen Feuerpfeil nach @WEM.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(6, ({
    "Der Grottenzwerg ruft: Das wirst Du bereuen!\n",
    "Der Grottenzwerg faucht Dich wuetend an.\n",
    "Der Grottenzwerg ist ausser sich vor Wut.\n"}) );

  // SetProp (P_DIE_MSG, " sinkt tot zu Boden.\n");
  SetProp (P_DEFAULT_INFO, ({
      "schaut Dich verwundert an.\n",
      "mustert Dich fragend.\n",
      "fragt Dich gierig: Hast Du etwas Gold?\n",
      "sagt verzweifelt: Ich weiss doch auch nicht alles!\n" }) );
  AddInfo (({"zwerg", "grottenzwerg"}), "nickt laechelnd.\n");
  AddInfo (({"bahn", "grottenbahn", "grotte"}),
      "Jaja, die Grottenbahn, sie ist einfach phantastisch! Du musst "
      "sie einmal gesehen haben, aber nimm Dich in acht! Da drinnen ist "
      "es extrem gefaehrlich, Du solltest schon starke Nerven haben! "
      "Aus diesem Grund ist es auch verboten, jedwege Art der Nahrung "
      "mitzunehmen. Die Fahrkarten fuer die Grottenbahn verkaufe "
      "uebrigens ich.", "erzaehlt: ");
  AddInfo (({"nahrung", "essen"}),
      "Solltest Du dennoch etwas mitzunehmen versuchen, so wird es Dir "
      "beim Eingang ersatzlos abgenommen!", "warnt Dich: ");
  AddInfo (({"karte", "karten", "fahrkarte", "fahrkarten"}),
      "Ja, wenn Du willst, verkaufe ich Dir eine Fahrkarte fuer die "
      "Grottenbahn! Die Syntax ist einfach: <kaufe karte>, aber ich "
      "kann Dir wegen des grossen Ansturms nur von Zeit zu Zeit eine "
      "geben. Der Preis fuer eine Karte betraegt momentan "+
      KARTENPREIS+" Goldmuenzen.", "sagt: ");
  AddInfo (({"kartenpreis", "preis"}),
      "Der Preis betraegt derzeit "+KARTENPREIS+" Goldmuenzen.\n",
      "sagt: ");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Grottenzwerg sagt: Was soll ich damit?\n" }) );

  AddCmd ( ({"kauf", "kaufe"}), "kaufe" );
  gekauft=([]);
}

void reset()
{
  ::reset();
  gekauft=([]);
}

int kaufe(string str)
{
  notify_fail("Was willst Du kaufen?\n");
  if (!str) return 0;
  notify_fail("Das kannst Du nicht kaufen.\n");
  if (str!="karte" && str!="fahrkarte") return 0;
  if (member(gekauft,getuid(TP)))
  {
    write ("Der Grottenzwerg sagt: Aber Dir habe ich erst kuerzlich eine "
           "Karte verkauft!\n");
    return 1;
  }
  if (TP->QueryMoney() < KARTENPREIS)
  {
    write("Der Grottenzwerg sagt: Du hast doch gar nicht genug Geld dabei!\n");
    return 1;
  }
  if (present("\ngrottenkarte", TP))
  {
    write("Der Grottenzwerg sagt: Aber Du hast doch schon eine Karte!\n");
    return 1;
  }
  write ("Der Grottenzwerg verkauft Dir eine Fahrkarte.\n");
  say ("Der Grottenzwerg verkauft "+TP->name(WEM)+" eine Fahrkarte.\n", TP);
  gekauft += ([ getuid(TP) ]);
  CLONETPNOCHK(OBJ("fahrkarte"));
  TP->AddMoney(-KARTENPREIS);
  return 1;
}

