/*
** Eine Fahrkarte fuer die Grottenbahn, Woody
** ---
** Mar 7, 1997  Initial Release
*/

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include "../files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId ( ({ "fahrkarte", "karte", "\ngrottenkarte" }) );
  SetProp (P_SHORT, "Eine Fahrkarte");
  SetProp (P_LONG, "Du haeltst eine Fahrkarte fuer die beruehmt-beruechtigte "
      "Grottenbahn des Silberlands in Haenden. Sie berechtigt Dich zu einer "
      "Fahrt ins Ungewisse. Ein kleiner Schriftzug ganz unten sagt: 'Fahrt "
      "auf eigene Gefahr'.");
  SetProp (P_NAME, "Fahrkarte");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_NOGET, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_VALUE, 2000);
  SetProp (P_WEIGHT, 50);
  SetProp (P_MATERIAL, MAT_PAPER);
  SetProp (P_INFO,
    "Dein (Ueber-) Leben garantiert dieses Stueckchen Papier gewiss nicht.\n");
}

