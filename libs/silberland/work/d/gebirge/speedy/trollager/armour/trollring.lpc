
#include <properties.h>
#include <combat.h>

#include "../def.h"

inherit "std/armour";
 
create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Trollring");
  SetProp(P_LONG,
    "Ein kleiner Ring, voellig aus einem grauen Stein, und mit einigen "
    "Diamanten bestueckt.");
  SetProp(P_NAME, "Trollring");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 3);
  SetProp(P_WEIGHT, 270);
  SetProp(P_VALUE, 3000+random(200));
  SetProp(P_MATERIAL, ([MAT_STONE:80, MAT_DIAMOND:20]) );

  AddId( ({"ring","trollring"}) );
}
