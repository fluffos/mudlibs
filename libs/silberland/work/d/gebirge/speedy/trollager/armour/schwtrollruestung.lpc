
#include <properties.h>
#include <combat.h>
#include "../def.h"

inherit "std/armour";
 
create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine schwere Trollruestung");
  SetProp(P_LONG,
    "Ein gut gearbeitete Ruestung, bringt sicher einigen Schutz. Sie "
    "besteht vor allem aus Lederplatten mit eingearbeiteten Knochen, die "
    "sicher sehr viel Schutz geben. Lederriemen halten das ganze zusammen "
    "und staerken die Ruestung noch mehr. ");
  SetProp(P_NAME, "Trollruestung");
  SetProp(P_NAME_ADJ, "schwer" );
  SetProp(P_GENDER, FEMALE);
  AddId(({"ruestung", "trollruestung"}));
  AddAdjective( ({"schwer", "schwere"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 35);
  SetProp(P_WEIGHT, 2800);
  SetProp(P_VALUE, 900 +random(100));
  SetProp(P_MATERIAL, ([MAT_LEATHER:40, MAT_BONE:40, MAT_COPPER:20]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Troll"})]) );

}
