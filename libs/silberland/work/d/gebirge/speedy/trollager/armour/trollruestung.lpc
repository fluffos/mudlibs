
#include <properties.h>
#include <combat.h>
#include "../def.h"

inherit "std/armour";
 
create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine leichte Trollruestung");
  SetProp(P_LONG,
    "Eine nicht sonderlich gut gearbeitete Ruestung. Anziehen kann man sie "
    "aber trotzdem. Sie besteht vor allem aus Lederplatten mit "
    "eingearbeiteten Knochen, die ein wenig fuer Schutz sorgen. Die "
    "Verbindungen sind aus Kupfer und einige Kupferstuecke verbinden die "
    "Knochen und Lederplatten. ");
  SetProp(P_NAME, "Trollruestung");
  SetProp(P_GENDER, FEMALE);
  AddId(({"ruestung", "trollruestung"}));
  SetProp(P_NAME_ADJ, "leicht" );
  AddAdjective( ({"leichte", "leichte"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 18);
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 300 +random(100));
  SetProp(P_MATERIAL, ([MAT_LEATHER:40, MAT_BONE:40, MAT_COPPER:20]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Troll"})]) );
}
