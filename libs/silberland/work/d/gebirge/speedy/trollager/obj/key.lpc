
inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../def.h"

create() {
  if(!is_clone(TO)) return;

  ::create();
  SetProp(P_SHORT, "Ein Trollschluessel");
  SetProp(P_LONG,
    "Ein recht schwerer Schluessel aus Eisen. Ziemlich normal fuer einen "
    "Schluessel.");
  SetProp(P_NAME, "Schluessel");
  AddId( ({"trollschluessel","schluessel"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 30);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
}

// fuer die schatzkammer
int ichBinDerTrollschluessel() {
  return 1;
}
