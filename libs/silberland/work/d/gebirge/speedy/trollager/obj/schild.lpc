
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hinweisschild fuer Troll-Anfaenger");
  SetProp(P_LONG,
    "Dieses kleine Schild hat wohl mal ein netter? Magier hier fallengelassen. "
    "Wenn Du ein Troll bist, kannst Du es bestimmt lesen." );
  SetProp(P_NAME, "Hinweisschild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "hinweisschild","schild" }) );

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Das Schild ist fest im Boden verankert.\n");

  AddCmd( ({ "lies","les","lese" }) , "liesfkt" );

}

int liesfkt(string str) {
  notify_fail("Was moechtest Du lesen?\n");
  if (str != "schild" && str != "hinweisschild") return 0;
  if (!TP->id("Trollspieler")) {
    write(BS(
      "Das Schild ist nur fuer Trolle gedacht. Du kannst die Sprache "
      "nicht lesen. So ein Aerger aber auch."));
    return 1;
  }
  write("Auf dem Schild steht:\n");
  write("---------------------\n");
  write(BS(
    "Hallo ihr trolligen Trolle. Einem unser Aeltesten, dem Gjordil, wurde "
    "etwas entwendet. So als gutmuetigen Anfang koenntet Ihr ja mal zu ihm "
    "gehen und ihn nach Hilfe fragen ( Das ist eine Quest fuer Anfaenger "
    "der Trolle und steht nur deshalb in der Questliste weiter unten, weil "
    "sie fuer andere Rassen sehr viel schwerer ist ). Anm. von -= Zordan =-"));
  return 1;
}
