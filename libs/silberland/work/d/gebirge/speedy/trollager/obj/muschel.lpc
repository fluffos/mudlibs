
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"

inherit "/std/thing";

string zauberwort, zbrwrt;

create() {
  ::create();
  SetProp(P_SHORT,"Eine Muschel");
  SetProp(P_LONG,
    "Eine schoene braune Meeresmuschel mit einer grossen "
    "trichterfoermigen Oeffnung. Wenn man ein Ohr an die Muschel haelt "
    "kann man angeblich das Meer rauschen hoeren.");
  SetProp(P_INFO,
    "Diese Muschel kann Dir in einer hilflosen Situation helfen.");
  AddId( ({ "muschel","meeresmuschel" }) );
  SetProp(P_NAME, "Muschel");
  SetProp(P_NODROP, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 2000);
  SetProp(P_MATERIAL, ([MAT_PEARL:100]));

  randomwort();

  AddCmd( ({"halte","halt"}),         "wisper");
  AddCmd( ({"fluester","fluestere"}), "fluester");
  AddCmd( ({"lausch","lausche"}),     "xlauschen" );

  AddDetail( "oeffnung",
    "Die Oeffnung ist in der Muschel. Wenn man an ihr lauscht kann man das "
    "Meer rauschen hoeren. ");
}

int ichBinEineMuschel() {
  return 1;
}

fluester(str) { 
  string target;

  if (TP && !IS_WIZARD(TP))
    if (str!=zbrwrt) return 0;
    else ;
  else
    if (str!="weghier") return 0;

  // wenn die muschel aus dem gebiet des lagers rauskommt wird sie deaktiviert
  if(((string)ENV(TP))[0..strlen(ROOM "" )-1] != ROOM "" ) {
    write(BS(
      "Die Muschel sagt: Ich bin nicht in Gefahr, also hab ich keine Lust "
      "Dir zu helfen."));
    return 1;
  }

  write(BS(
    "Du fluesterst leise: \""+str+"\".\n"+
    "Ploetzlich verschwimmt alles vor Deinen Augen und ein starkes "+
    "Schwindelgefuehl ueberkommt Dich."));
  say(CAP_TPN+" fluestert leise: \""+str+"\".\n");
  switch(random(10)) {
    case  0: {target="/d/dschungel/feyaria/felseninsel/room/steg";break;}
    case  1: {target="/d/wasser/lupus/pier/room/plattform-s";break;}
    case  2: {target="/d/dschungel/feyaria/tijara/room/steg_d1";break;}
    case  3: {target="/d/wasser/feyaria/schiffe/yacht";break;}
    case  4: {target="/d/wasser/feyaria/schiffe/hschiff";break;}
    case  5: {target="/d/dschungel/feyaria/tijara/obj/karavel";break;}
    case  6: {target="/d/dschungel/feyaria/tijara/obj/fischerboot";break;}
    case  7: {target="/d/dschungel/feyaria/kueste/room/room_j3";break;}
    case  8: {target="/d/dschungel/feyaria/kueste/room/room_a7";break;}
    case  9: {target="/d/kristallwald/sargola/see/room/0809";break;}
    case 10: {target="";break;}
    case 11: {target="";break;}
    case 12: {target="";break;}
    case 13: {target="";break;}
    case 14: {target="";break;}
  }
  if (catch(call_other(target,"???")))  // Sicherheitsabfrage (woody)
    raise_error(target+" not loadable! Please check.\n");
  TP->move(target, M_TPORT, 0,
    "wird von einer Muschel davongezogen", 
    "wird mit einer Muschel in der Hand sichtbar");
  write(BS(
    "Die Muschel faellt Dir aus der Hand und versinkt in den Tiefen "
    "des Meeres."));
  TO->remove();
  return 1;
}

wisper(str) { 
  notify_fail("Halte was an was?\n");
  if ((str!="muschel an ohr")&&(str!="muschel ans ohr")&&
      (str!="ohr an muschel"))
    return 0;
  write(BS(
    "Du haeltst die Muschel an Dein Ohr."));
  write(BS(
    "Aus dem Inneren der Muschel wispert Dir eine leise Stimme zu: Ich bin "
    "von den Trollen eingefangen worden, aber Du hast mich befreit. Als "
    "Dank werde ich Dir einmal das Leben retten. Wenn Du in einer "
    "bedrohlichen Lage bist, so fluester das Zauberwort \""+zauberwort+
    "\", aber ohne die Selbstlaute dazwischen!"));
 return 1;
}

xlauschen(str) {
  notify_fail("An was willst Du lauschen?\n");
  if( (str=="muschel") || (str=="an muschel") ) {
    write(BS(
      "Du haeltst die Muschel an Dein Ohr."));
    write(BS(
      "Aus dem Inneren der Muschel wispert Dir eine leise Stimme zu: Ich bin "
      "von den Trollen eingefangen worden, aber Du hast mich befreit. Als "
      "Dank werde ich Dir einmal das Leben retten. Wenn Du in einer "
      "bedrohlichen Lage bist, so fluester das Zauberwort \""+zauberwort+
      "\", aber ohne die Selbstlaute dazwischen!"));
    return 1;
  }
  return 0;
}

randomwort() { 
  int i;
  zauberwort="";
  zbrwrt="";
  for (i=33;i;i--)
    switch(random(15)) { 
      case 0..1: {zauberwort=zauberwort+"o";break;}
      case 2..3: {zauberwort=zauberwort+"u";break;}
      case 4..5: {zauberwort=zauberwort+"a";break;}
      case 6..7: {zauberwort=zauberwort+"l";zbrwrt=zbrwrt+"l";break;}
      case 8..9: {zauberwort=zauberwort+"b";zbrwrt=zbrwrt+"b";break;}
      case 10: {zauberwort=zauberwort+"p";zbrwrt=zbrwrt+"p";break;}
      case 11: {zauberwort=zauberwort+"g";zbrwrt=zbrwrt+"g";break;}
      case 12: {zauberwort=zauberwort+"q";zbrwrt=zbrwrt+"q";break;}
      case 13: {zauberwort=zauberwort+"w";zbrwrt=zbrwrt+"w";break;}
      case 14: zauberwort=zauberwort+"s";zbrwrt=zbrwrt+"s";
    }
}
