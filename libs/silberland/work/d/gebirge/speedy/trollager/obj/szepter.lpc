
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <wizlevels.h>
#include "../def.h"

inherit "/std/thing";

#define SZCOST 28

int firsttime;

create() {
  ::create();
  SetProp(P_SHORT,"Das Szepter der Macht");
  SetProp(P_LONG,
    "Das Szepter des Trollhaeuptlings. Es ist ein goldener Stab mit 2 "
    "Rubinen dran, die Dich wie zwei Augen boese anstarren. Angeblich kann "
    "man damit durch verborgene Zauberkraefte Macht auf andere Personen "
    "ausueben.");

  SetProp(P_INFO,
    "Mit dem Kommando 'befehle <spielername> kommando argumente' kann man "
    "Spieler einige Befehle ausfuehren lassen. Die Liste der Kommandos "
    "siehst Du mit 'szepterliste'. Die Argumente bestimmen, wie der Befehl "
    "ausgefuehrt werden soll. zB: befehle spieler huepfe wild -> Spieler "
    "huepft wild in der Gegend herum. Bei Monstern geht es auch, wenn man "
    "den vollen Namen angibt. Allerdings soll das Szepter auch recht "
    "launisch sein.");
  AddId( ({"szepter","machtszepter","szepter der macht","goldszepter"}) );
  SetProp(P_NAME, "Szepter der Macht");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 8000);
  SetProp(P_MATERIAL, 
    ([MAT_RUBY:5, MAT_GOLD:50, MAT_WOOD:20, MAT_CERAMIC:10, MAT_IRON:15]) );

  AddCmd("befehle", "aktion");
  AddCmd("szepterliste", "liste");
  AddCmd("szeptergeheimliste", "geheim");
  firsttime=1;
}

aktion(str) { 
  int i, hier, sp;
  object *inv;
  object opfer;
  string einspieler, spieler, kommando, arg, du, di, du1, di1, mall;

  str=TP->_unparsed_args();
  notify_fail("Wem willst du was befehlen?\n");
  if (!str) return 0;
  du=""; 
  di="";
  if (sscanf(str, "%s %s %s", spieler, kommando, arg)<2) {
    if (sscanf(str, "%s %s", spieler, kommando)!=2) return 0;
    arg=""; 
  } else {
    arg=arg+" ";
  }
  if (TP->QueryProp(P_LEVEL)<4) {
    write(BS(
      "Du kannst mit dem Szepter noch nicht umgehen, Deine Stufe ist leider "
      "noch zu niedrig."));
    return 1; 
  }
  if (((sp=TP->QueryProp(P_SP))<SZCOST) && !IS_LEARNER(TP)) {
    write(BS(
      "Deine Magie reicht nicht aus um mit dem Szepter umzugehen."));
    return 1; 
  }
  if (kommando=="huepfe") {
    du="huepfst"; du1="in der Gegend herum";
    di="huepft"; di1="in der Gegend herum"; }
  if (kommando=="tanze") {
    du="tanzt"; du1="den Ententanz";    
    di="tanzt"; di1="den Ententanz"; }
  if (kommando=="groehle") {
    du="groehlst"; du1="in der Gegend rum";
    di="groehlt"; di1="in der Gegend rum"; }
  if (kommando=="jodel") {
    du="jodelst"; du1="mit jauchzender Stimme"; 
    di="jodelt"; di1="mit jauchzender Stimme"; }
  if (kommando=="heule") {
    du="heulst"; du1="den Mond an"; 
    di="heult"; di1="den Mond an"; }
  if (kommando=="sabbere") {
    du="sabberst"; du1="auf den Boden"; 
    di="sabbert"; di1="auf den Boden"; }
  if (kommando=="quieke") {  
    du="quiekst"; du1="entsetzlich laut auf";   
    di="quiekt"; di1="entsetzlich laut auf"; }  
  if (kommando=="krieche") {
    du="kriechst"; du1="im Staub";
    di="kriecht"; di1="im Staub"; }
  if (kommando=="schreie") {
    du="schreist"; du1="wie am Spiess";
    di="schreit"; di1="wie am Spiess"; }
  if (kommando=="zucke") {
    du="zuckst"; du1="wild herum";
    di="zuckt"; di1="wild herum"; }
  if (kommando=="verneige") {
    du="verneigst Dich"; du1="ehrfuerchtig";
    di="verneigt sich"; di1="ehrfuerchtig"; }
  if (kommando=="gucke") {
    du="guckst"; du1="aus der Waeche";
    di="guckt"; di1="aus der Waesche"; }
  if (kommando=="lasse") {
    du="laesst"; du1="die Hosen runter. Peinlich, Peinlich";
    di="laesst"; di1="die Hosen runter"; }
  if (kommando=="bohre") {
    du="bohrst"; du1="in der Nase";
    di="bohrt"; di1="in der Nase"; }
  if (kommando=="rappe") {
    du="rappst"; du1="wie MC Hammer. Echt cool!";
    di="rappt"; di1="wie MC Hammer. Sieht cool aus"; }
   if (kommando=="grunze") {
    du="grunzt"; du1="primitive Urlaute. Genierst Du Dich nicht dabei?";
    di="grunzt"; di1="primitive Urlaute. Eine Wildsau koennts nicht besser"; }
  if (kommando=="mache") {
    du="machst"; du1="einen Handstand. Tolle Vorstellung";
    di="macht"; di1="einen Handstand wie ein Zirkusclown"; }
  if (kommando=="strippe") {
    du="legst"; du1="einen Striptease hin, ganz professionell";
    di="legt"; di1="einen Striptease hin, toller Anblick"; }
  if (kommando=="pinkel") {
    du="pinkelst"; du1="ein Lackerl auf den Boden. Schlechte Manieren!";
    di="pinkelt"; di1="ein Lackerl auf den Boden, wie ein Huendchen"; }
  if (kommando=="fummel") {
    du="fummelst an"; du1="herum";
    di="fummelt an"; di1="herum"; }
  if (kommando=="furze") {
    du="laesst einen"; du1="Furz fahren";  
    di="laesst einen"; di1="Furz fahren"; }
  if (kommando=="wackel") {
    du="wackelst"; du1="mit dem Hintern";  
    di="wackelt"; di1="mit dem Hintern"; }
  if (kommando=="mecker") {
    du="meckerst"; du1="und springst dabei wie ein Ziegenbock im Kreis herum";
    di="meckert"; di1="und springt dabei wie ein Ziegenbock im Kreis herum";}
  if (kommando=="haue") {
    du="haust dir"; du1="einen Ziegelstein an den Schaedel";  
    di="haut sich"; di1="einen Ziegelstein an den Schaedel"; }
  if (kommando=="glotze") {
    du="glotzt mit offenem Mund"; du1="an";
    di="glotzt mit offenem Mund"; di1="an und wird ganz rot dabei"; }
  if (kommando=="maennchen") {
    du="machst"; du1="Maennchen wie ein Hund";
    di="macht"; di1="Maennchen und hechelt dabei wie ein Hund"; }
  if (kommando=="bewundere") {
    du="bewunderst"; du1="mit ehrfuerchtigem Blick";
    di="bewundert"; di1="vor Ehrfurcht erzitternd"; }
  if (kommando=="grapsche") {
    du="grapscht"; du1="an den Popo";
    di="grapscht"; di1="an den Popo"; }
/*
  if (kommando=="") {
    du=""; du1="";
    di=""; di1=""; }
*/
  if (du=="") {
    write(BS(
      "Das Szepter der Macht kennt diesen Befehl leider nicht."));
    return 1; 
  }
  switch(random(6)) {
  case 0: {
    mall="fuchtelt mit einem Szepter herum.\n";
    break; }
  case 1: {
    mall="tut irgendwas geheimnisvolles.\n";
    break; }
  case 2: {
    mall="schwingt ein Szepter.\n";
    break; }
  case 3: {
    mall="vollfuehrt einen Zauber.\n";
    break; }
  case 4: {
    mall="murmelt etwas.\n";
    break; }
  case 5: {
    mall="brabbelt eigenartige Woerter.\n";
    break; }
  }
  einspieler = "ein "+spieler;
  hier=0;
  inv=all_inventory(ENV(TP));
  for (i=0;i<sizeof(inv);i++)
    if (living(inv[i])) /* &&(!IS_LEARNING(inv[i]))) */ 
    if ((lower_case(inv[i]->name(WER,1))==spieler)||
        (lower_case(inv[i]->name(WER,0))==einspieler)) {
          hier=1; opfer=inv[i]; }
  if (hier==0) {
    write(CAP(spieler)+" ist nicht hier.\n"); 
    return 1; 
  }
  write(BS(
    "Du schwingst Dein Szepter und sprichst leise den Befehl aus."));
  if (!IS_LEARNER(this_player())) {
    TP->SetProp(P_SP, sp-SZCOST);
  }
  if ((random(5)==1)&&(firsttime==0)) {
    write(BS(
      "Das Szepter weigert sich einfach mal, "+CAP(spieler)+" Deinen "
      "Befehl ausfuehren zu lassen. Statt dessen laesst es seinen Zauber "
      "an Dir wirken."));
    spieler=lower_case(TP->name(WER,1));
    opfer=TP; 
  }
  firsttime=0;
  for (i=0;i<sizeof(inv);i++) {
    if (living(inv[i])) {
      if ((lower_case(inv[i]->name(WER,1))==spieler)||
          (lower_case(inv[i]->name(WER,0))==einspieler)) {
        tell_object(inv[i],TP->name(WER,1)+
                    " fuchtelt mit einem Szepter in Deine Richtung.\n"+
                    "Du "+du+" "+arg+du1+".\n");
      } else {
        if (inv[i]!=TP)
          tell_object(inv[i],this_player()->name(WER,1)+" "+mall);
          tell_object(inv[i], capitalize(opfer->name(WER,1))+
                    " "+di+" "+arg+di1+".\n");
      }
    }
  }
  return 1;
}

geheim() { 
  write(
    "Folgende Sachen bietet Dir das Szepter zusaetzlich:\n"
    "groehle   [... in der Gegend rum]\n"
    "lasse     [... die Hosen runter]\n"
    "fummel    [an ... herum]\n"
    "grapsche  [... an den Popo]\n"
    "glotze    [glotzt mit offenem Mund ... an]\n"
    "strippe   [lege ... einen Striptease hin]\n");
  return 1;
}

liste() { 
  write(
    "Folgende Befehle bietet Dir das Szepter:\n"
    "huepfe    [... in der Gegend herum]\n"
    "tanze     [... den Ententanz]\n"
    "jodel     [... mit jauchzender Stimme]\n"
    "heule     [... den Mond an]\n"
    "sabbere   [... auf den Boden]\n"
    "quieke    [... entsetzlich laut auf]\n"
    "krieche   [... im Staub]\n"
    "schreie   [... wie am Spiess]\n"
    "zucke     [... wild herum]\n"
    "verneige  [... ehrfuerchtig]\n"
    "bewundere [... mit ehrfuerchtigem Blick]\n"
    "haue      [dir ... einen Ziegelstein an den Schaedel]\n"
    "gucke     [... aus der Waeche]\n"
    "bohre     [... in der Nase]\n"
    "rappe     [... wie MC Hammer]\n"
    "grunze    [... primitive Urlaute]\n"
    "mache     [... einen Handstand]\n"
    "wackel    [... mit dem Hintern]\n"
    "mecker    [... und springe wie ein Ziegenbock herum]\n"
    "furze     [lasse einen ... Furz fahren]\n"
    "maennchen [mache ... maennchen wie ein Hund]\n");
  return 1;
}
