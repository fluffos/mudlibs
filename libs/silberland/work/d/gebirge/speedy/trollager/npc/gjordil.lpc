
#include <properties.h>
#include <defines.h>
#include <language.h>

#include "../def.h"

inherit "std/npc";

string belohnung(string str);

create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Gjordil, der alte Troll");
  SetProp(P_LONG,
    "Das ist Gjordil, der aelteste Troll des Lagers. Seine Haut ist noch "
    "runzliger als die der anderen Trolle. Sein langes weisses Haar haengt "
    "wild herunter. Seine Augen strahlen viel Weisheit aus. Er kann Dir "
    "viele Geschichten ueber das Trollager erzaehlen, wenn Du ihn danach "
    "fragst.");
  SetProp(P_NAME, "Gjordil");
  SetProp(P_GENDER, MALE);
  SetProp (P_ARTICLE,0); 
  SetProp(P_RACE, "Troll");
  AddId( ({"troll","alter","alten","gjordil"}) );
  create_default_npc(15);
  SetProp(P_ALIGN, 500);
  SetProp(P_SIZE, random(40)+299);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:0.5, DT_AIR:-0.5, DT_TERROR:-0.5]));

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Gjordil gibt @WEN zurueck.\n" }) );

  set_living_name("gjordil");

  SUID;
  CLONEME( WEAPON "krueckstock" );
  command("zueck stock");

  AddInfo( ({"geschichten","geschichte"}),
    "Ich kann Dir vieles ueber das Trollager erzaehlen.",
    "sagt: ");

  AddDetail( ({"haar","haare"}),
    "Das Haar von Gjordil, ist sicher schon sehr alt, wie auch Gjordil "
    "selbst. Es ist lang, weiss und ungepflegt. Gjordil ist halt ein "
    "Troll."); 

  SetProp(P_DEFAULT_INFO,
    "sagt: Davon weiss ich nichts. Ich kann Dir nur von diesem Lager hier "
    "erzaehlen.");

  SetProp(P_LOG_INFO, "zordan/gjordil-quest.log");

  AddInfo( ({"trollamulett","amulett"}), "@@amulett@@");

  AddInfo( ({"szepter","szepter der macht"}), 
    "Ja, ja, das Szepter ist ein maechtiges Spielzeug, es soll auch noch "
    "eine geheime Liste, neben der 'Szepterliste', geben.","sagt: "); 

  AddInfo( "trollen", 
    "Unsere Waechter gehen, nicht normal wie Du, sondern sie 'trollen' sich, "
    "damit koennen sie sich besser fortbewegen, denn sie sind doch sehr "
    "gross.","sagt: ");

  AddInfo(({"lager","trollager"}), 
    "Wir Trolle haben dieses Lager vor langer Zeit gegruendet. "
    "Dieser Platz bietet uns gute Verteidigunsmoeglichkeiten und schuetzt "
    "uns vor feindlichen Angriffen aufgrund der hohen Felsen die das Lager "
    "umgeben. Unsere Hauptfeinde sind Menschen, Elfen, Zwerge und Hobbits, "
    "die uns immer wieder angreifen. Viele von ihnen landen entweder im "
    "Gefaengnis oder gleich auf dem Bratspiess. In der Huette oestlich von "
    "dem grossen Baum kannst Du unseren Haeuptling besuchen, der sich am "
    "liebsten in Gesellschaft von unseren Trollfrauen aufhaelt. Unsere "
    "Schaetze, die wir im Kampf von unseren Feinden erworben haben, liegen "
    "bewacht in der Hoehle im Sueden des Lagers. Normalerweise halten sich "
    "im Lager nur friedliche Trolle auf, allerdings sind unsere Waechter "
    "immer wachsam und einsatzbereit. Ich kann Dir gerne mehr ueber die "
    "Hoehle, den Haeuptling, den Bratspiess, das Gefaengnis, die Trollwache "
    "und ueber uns Trolle selbst erzaehlen.", "erzaehlt: ");

  AddInfo(({"angriffe","angriff"}), 
    "Angriffe? Das ist wenn sich so degenerierte Spieler "
    "einbilden, sie koennen es mit uns Trollen aufnehmen um Erfahrung zu "
    "sammeln und dann erst hier draufgehen.", "regt sich auf: ");

  AddInfo( ({"versteck"}),
    "Ich weiss leider gar nichts ueber ein Versteck.",
    "sagt: ");

  AddInfo("kampf", 
    "Komm nur her, ich zeig Dir gleich, was ordentliche Hiebe sind!",
    "bruellt: ");

  AddInfo(({"verteidigung","verteidigunsmoeglichkeiten"}),
    "spricht: Das Lager ist gut verteidigt, ja.\n");

  AddInfo(({"hoehle","grotte"}), 
    "Sagenhafte Schaetze haben wir im Laufe der Zeit in der "
    "Hoehle gehortet. Schon viele Abenteurer haben bereits versucht, dort "
    "einzudringen und die Schaetze zu stehlen. Nicht wenigen von ihnen hat "
    "es das Leben gekostet, denn unsere Wache hat immer ein Auge auf unsere "
    "wertvollen Gegenstaende dort.", "erzaehlt: ");

  AddInfo(({"schatz","schaetze","gegenstaende","beute","edelstein",
            "edelsteine","steine","stein","diamant","diamanten"}), 
    "Die kostbaren Gegenstende in unserer Schatzkammer sind "
    "hauptsaechlich Diamanten, Edelsteine und Geld. Ansonsten liegt noch "
    "etwas Geruempel dort rum, was wir unseren Feinden abgenommen haben. "
    "Aber lass lieber die Finger davon! Unsere Wachen sind sehr aufmerksam.",
    "prahlt: ");

  AddInfo(({"haeuptling","boss","chef","anfuehrer","kommandant"}), 
    "Unser Haeuptling haelt sich im allgemeinen in seiner Huette auf. "
    "Er ist nicht nur ein sehr starker Troll, er kennt sich auch mit Magie "
    "gut aus. Wie gesagt, am liebsten ist er in Gesellschaft von unserem "
    "huebschen Trollmaedchen. Seine Huette hat er angeblich mit raffinierten "
    "Fallen ausgestattet, die ihn vor Feinden schuetzen sollen.",
    "sagt: ");

  AddInfo( ({"magie","kunst"}),
    "Der Trollhaeuptling kennt sich recht gut mit der Kunst der Magie aus.",
    "sagt: ");

  AddInfo(({"huette","haeuptlingshuette","haus"}), 
    "Die Huette ist auf einem kleinen Erdhuegel erbaut, sodass unser "
    "Haeuptling einen Ueberblick auf das Lager hat. Am besten Du geht "
    "mal hin und siehst Dich dort selbst um. Sie befindet sich oestlich "
    "des grossen Baumes.", "sagt: ");

  AddInfo(({"maedchen","frauen","trollmaedchen","trollfrauen","trollin"}),
    "Jaja, die huebschen Trollmaedchen. Leider stehen die immer nur "
    "bei dem Haeuptling rum und suchen Schutz bei ihm. Der beschenkt sie "
    "natuerlich auch reichlich mit Schmuck und Geld.", "raunt: ");

  AddInfo(({"baum","eiche"}), 
    "Der grosse Baum steht mitten in unserem Lager. Von dort "
    "oben kann man das ganze Lager uerberblicken. Fur unseren kleinen Jungen "
    "haben wir mal eine Strickleiter daran befestigt.", "erzaehlt: ");

  AddInfo(({"leiter","strickleiter"}), 
    "Ohne die Strickleiter koennte man den hohen Baum kaum besteigen "
    "Allerdings fluechten sich Eindringlinge im Lager immer vor der Wache "
    "da hinauf und ziehen die Strickleiter nach oben, diese Feiglinge.",
    "sagt: ");

  AddInfo(({"junge","trolljunge","bub","bursche","lausbub","spitzbub"}), 
    "Er ist ein lieber kleiner frecher Junge, der den Leuten immer "
    "gerne Streiche spielt, ein richtiger Troll halt. Er treibt sich immer "
    "alleine im Lager herum, da sein Papa bei der Trollwache beschaeftigt "
    "ist. Irgendwie traue ich ihm aber nicht ueber den Weg.", "erzaehlt: ");

  AddInfo( ({"leute"}),
    "Leute wie Du und ich.",
    "seufzt: ");

  AddInfo( ({"weg"}),
    "Trau ihm bloss nicht. Der freche Junge luegt nicht selten!",
    "sagt: ");

  AddInfo( ({"streich","streiche"}),
    "Der kleine Trolljunge spielt fast jedem einen gemeinen Streich wenn "
    "er kann.",
    "sagt: ");

  AddInfo(({"spiess","bratspiess","essen","grill"}),
    "Der Bratspiess ist da um unsere Feinde und Eindringlinge im "
    "Lager zu roesten um sie nachher zu fressen. Von den paar Pflanzen und "
    "Kraeutern hier im Lager werden wir ja doch nicht satt. Er befindet sich "
    "direkt vor dem Gefaengnis, wo unser Schlaechter die Gefangenen fuer den "
    "Spiess vorbereitet.", "quasselt: ");

  AddInfo(({"gefangenen","gefangene","insassen","opfer"}), 
    "Ein paar Goblins oder Orks verirren sich immer in unserem Lager. "
    "Aber hie und da erwischen wir auch andere Rassen, das sorgt "
    "etwas fuer Abwechslung am Speiseplan.", "sagt: ");

  AddInfo(({"menschen","zwerge","elfen","orks","goblins","hobbits"}),
    "grinst: Ja, sowas gehoert an den Bratspiess, lecker!\n"); 

  AddInfo(({"gefaengnis","kittchen","knast","haefen"}), 
    "Unserem Gefaengnis ist noch keiner entkommen. Man kommt zwar "
    "leicht hinein, aber nicht mehr raus. Es befindet sich in einer kleinen "
    "Einhoehlung mit einer Tuere aus Gitterstaeben am Eingang. Dort drinnen "
    "kann man unseren Schlaechter kennenlernen.", "labert: ");

  AddInfo(({"gitter","tuere","gitterstaebe","kraeuter","pflanzen",
	    "einhoehlung","eingang","schmuck"}),
    "mault: Schau's dir doch selbst mal an.\n");

  AddInfo(({"schlaechter","trollschlaechter"}), 
    "Der Schlaechter ist unser staerkster Troll und seine Arbeit "
    "macht ihm sichtlich Spass. Besser Du kommst ihm nicht in die Naehe. "
    "Er haelt sich in unserem Gefaengnis auf.", "grinst: ");

  AddInfo("arbeit", 
    "Meinst Du die Arbeit unseres Schlaechters? Der hackt den "
    "Gefangenen mit seinem Schlachtbeil die Koepfe ab. Was sollte er sonst "
    "tun?", "erzaehlt: ");

  AddInfo(({"beil","schlachtbeil"}), 
    "Es ist eine fuerchterliche Waffe, allerdings gibts sie der "
    "Schlaechter sicherlich nicht freiwillig her.", "erzaehlt: ");

  AddInfo(({"wache","wachen","waechter","trollwache","trollwaechter",
            "trollwachen"}), 
    "Unsere Waechter sorgen fuer Sicherheit hier im Lager. Sie "
    "sind recht starke Trolle, mit denen nicht zu spassen ist. Normalerweise "
    "schlafen sie auf ihrem Posten beim Eingang, trotzdem entgeht ihnen kein "
    "Diebstahl der Schaetze hier im Lager. Sie sind nicht fuer lange "
    "Verhandlungen bereit, sondern schlagen sofort zu, sobald sie auf Feinde "
    "treffen. Leg Dich besser nicht mit ihnen an.", "quatscht: ");

  AddInfo(({"posten","wachposten","wachzimmer"}), 
    "Der Wachposten befindet sich auf einem Felsvorsprung am "
    "Eingang des Lagers. Von dort koennen unsere Waechter das ganze Lager "
    "ueberblicken, ohne selbst gesehen zu werden. Nur vor dem Eingang kann "
    "man die Waechter sehen, wenn sie nicht gerade im Einsatz im Lager "
    "sind.", "erzaehlt: ");

  AddInfo(({"feinde","feind"}), 
    "sagt: Feinde sind eigentlich alle Nicht-Trolle!");

  AddInfo(({"diebstahl","raub"}),
    "doziert: Das ist, wenn jemand etwas stiehlt!");

  AddInfo(({"trolle","troll"}), 
    "Wir Trolle sind im allgemeinen im Gebirge und auch in "
    "Hoehlen beheimatet. Trolle sind mit den Kobolden und Daemonen verwandt "
    "und verfuegen wie diese auch ueber Zauberkraefte. Wenn Trolle "
    "allerdings Sonnenlicht ausgesetzt sind, verlieren sie ihre "
    "Zauberkraft.", "erzaehlt: ");

  AddInfo(({"zauber","zauberkraft","zauberkraefte"}), 
    "Trolle verwenden ihre Zauberkraefte um anderen Lebewesen boese "
    "Krankheiten und aehnlichen Unfug anzuhexen.", "sagt: ");

  AddInfo( ({"lebewesen","wesen"}),
    "Es leben viele Lebewesen im Trollager. Trolle verwenden meist eine "
    "boese Zauberkraft um fremde Lebewesen erkranken zu lassen.",
    "sagt: ");

  AddInfo( ({"krankheiten","krankheit","unfug"}),
    "Das sind ganz boese Krankheiten. Meist unheilbar.",
    "sagt: ");

  AddInfo(({"licht","sonnenlicht"}), 
    "Ja, das Sonnenlicht ist ein Problem. Da happerts immer mit der "
    "Magie.", "raunzt: ");

  AddInfo(({"stock","krueckstock","kruecke"}), 
    "meckert: Den bekommst Du nicht, ich brauch ihn noch.");

  AddInfo("zaubertrank",
    "sagt: Ach was Zaubertrank. Ich trink da lieber unseren Trollschnaps.");

  AddInfo(({"schnaps","trollschnaps"}),
    "kramt in seinen Taschen und flucht: Verdammt! Wo ist denn mein\n"
    "Schnaps hin? Hat den wer geklaut?");

  AddInfo( ({ "abenteuer","quest","aufgabe","hilfe"}), "@@hilfefkt@@" );

  AddInfo( ({"griff"}),
    "Mein wunderbarer Griff ist mir abhanden gekommen. Ich glaube nicht, "
    "dass ich ihn verloren habe. Dazu steckt der viel zu fest auf meinem "
    "Krueckstock. Ich denke eher eine Rotznase hat ihn mir gestohlen!", 
    "sagt wuetend: ");

  AddInfo( ({"rotznase"}), 
    "Ich glaube ein aelterer Troll wuerde sich es niemals wagen, MIR "
    "etwas zu stehlen! Nur einem kleinen und frechen Troll wuerde ich das "
    "zutrauen.",
    "sagt: ");

  AddInfo( ({"suche"}),
    "Wenn Du fuer mich auf die Suche gehen willst, dann biete mir einfach "
    "Deine Hilfe an.",
    "sagt: ");

  // Trollbelohnung
  AddInfo(({"belohnung","gebiss","bergpumagebiss"}), #'belohnung, "sagt: ");
  
  AddCmd( "biete","bietefkt" );
}

amulett() {
  int i;
  object *inv;

  for(i=sizeof(inv=deep_inventory(TP)); i;) {
    i--;
    if(inv[i]->ichBinEinTrollamulett()) {
      write(BS(
        "Gjordil sagt: Aber Du hast doch schon eines."));
      return "laechelt.\n";
    }
  }
  write(BS(
    "Gjordil sagt: Schade, mir sind leider alle ausgegangen."));
//  CLONE( ARMOUR "trollamulet", TP);
//  write(BS(
//    "Gjordil gibt Dir ein Trollamulett."));
  return "laechelt.\n";
}


// Questteil

string hilfefkt(string str) {

//  if (!IS_WIZARD(TP)) return 0;

  if(!present(QUESTITEM,TP)) {
    write(break_string(
      "Du kannst mir vielleicht wirklich helfen. Mir wurde etwas gestohlen. "
      "Nur ich bin schon zu alt und zu schwach, um es selber zu suchen. Du "
      "koenntest Dich ja fuer mich auf die Suche begeben. Wenn Du das wirklich "
      "fuer mich machen moechtest, dann biete mir doch einfach Deine Hilfe an.",
      78,"Gjordil sagt: "));
    return "schaut Dich fragend an.";
  }
  write(break_string(
    "Wie ich sehe hast Du meinen Griff noch nicht gefunden.",
    78,"Gjordil sagt: "));
  return "seufzt.";
}

int bietefkt(string str) {
  object ob;

//  if (!IS_WIZARD(TP)) return 0;

  notify_fail("Moechtest Du vielleicht Deine Hilfe anbieten?\n");
  if (str != "hilfe an" && str != "gjordil hilfe an") return 0;
  if(present(QUESTITEM,TP)) {
    write(break_string(
      "Aber Du hast mir Deine Hilfe doch schon angeboten. Hast Du meinen "
      "Griff schon gefunden?",
      78,"Gjordil raunzt: "));
    return 1;
  }
  if(TP->QueryQuest(QUESTNAME)) {
    write(break_string(
      "Danke, aber Du hast meinen Griff doch schon gefunden und ihn mir "
      "gebracht.",
      78,"Gjordil sagt erfreut: "));
    return 1;
  }
  write(break_string(
    "Ok, "+CAP_TPN+". Vor einiger Zeit wurde mir von meinem Krueckstock "
    "ein kleiner Griff entwendet. Ich glaube eigentlich nicht, dass ich ihn "
    "einfach so verloren habe, sondern er wurde einfach so gestohlen! Ich "
    "bin ja aber leider viel zu alt und zu schwach, um selber danach auf "
    "die Suche zu gehen. Also mach Dich auf die Suche und finde meinen "
    "Griff.",
    78,"Gjordil sagt: "));
  CLONE( "/d/gebirge/zordan/gjordil/obj/gjordilquest" , TP);
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" beginnt die Quest.\n" );
  return 1;
}

void give_notify(object was) {
  object ob;

  if (!was->id(QUESTGRIFF)) return ::give_notify(was);
  if (!ob=present(QUESTITEM,TP)) {
    write(break_string("Oh danke.",78,"Gjordil sagt: "));
    was->remove();
    return;
  }

  if(!ob->checkgefragt() || !ob->checkfunkeln() ||
     !ob->checkfalle() || !ob->checkgebaut() || !ob->checkquest()) {
    write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(TP))+" CHEATET????\n" );
    write(break_string(
      "Hier stimmt aber irgendetwas nicht!!! Benachrichtige einen Magier, "
      "ich kann es nicht verantworten, dass Du die Quest so bekommst!!!",
      78,"Gjordil sagt: "));
    was->move(TP,M_SILENT || M_NOCHECK);
    write(BS("Gjordil gibt Dir den Griff zurueck."));
    return;
  }

  write("Gjordil faengt laut an zu jubeln.\n");
  write("Gjordil schreit: Du hast meinen Griff also gefunden!!!\n");
  write(BS(
    "Gjordil nimmt den Griff und seinen Krueckstock in die Haende. "
    "Daraufhin spricht er ein paar unverstaendliche Zauberwoerter auf und "
    "der Griff faengt hell an zu leuchten. Ganz langsam steckt Gjordil den "
    "Griff danach auf den Krueckstock und das Leuchten verschwindet." ));
  write("Gjordil strahlt Dich an.\n");

  switch(TP->GiveQuest(QUESTNAME)) {
    case 1:  write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(TP))+" loest die Quest.\n" );
             write_file("/log/quests/gjordil",
               dtime(time())+": "+CAP(getuid(TP))+" loest die Quest.\n" );
             break;
    default: write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(TP))+" -> UNBEKANNTER FEHLER!!\n" );
             write(BS(
               "ACHTUNG: Unbekannter Fehler!! Bitte wende Dich SOFORT an "
               "einen anwesenden Magier!!!"));
             return ::give_notify(was);
             break;
  }
  was->remove();
  ob->remove();
  if(was=present(QUESTAST,TP)) was->remove();
  if(was=present(QUESTSCHNUR,TP)) was->remove();
  if(was=present(QUESTFALLE,TP)) was->remove();
  domainshout("Gjordil ruft: "+CAP_TPN+" hat mir erfolgreich "
              "bei der Suche geholfen!\n",
              "^/d/gebirge/*", 1);
  
  //Wenn Troll dann Trollgeschenk
  if(TP->QueryProp(P_RACE)=="Troll")
    call_out("trolldank", 0, TP);
  
  return;
}

//Trollgeschenk PROtheG Racetool
void trolldank(object pl)
{
  if(!objectp(pl)) return;
  if(!present(pl, MENV)) return;
  
  if(present("\nPROtheG_Racetool", pl)) return;
  
  command_me("sage Als Dank bekommst Du von mir dieses Gebiss eines "
	     "Bergpumas. Moege es Dir viele, gute Dienste leisten. "
	     "Solltest Du es einmal verlieren, frage mich einfach nach "
	     "'belohnung'.");
  
  clone_object("/p/service/protheg/rt/obj/trollgebiss")->move(pl, M_NOCHECK);

  write(BS("Du nimmst das Gebiss dankend an Dich."));
}

// Trollgeschenk spaeter per AddInfo Closure
string belohnung(string str)
{
  if(!TP) return "";

  if(!TP->QueryQuest(QUESTNAME))
    return "Wofuer willst Du eine Belohnung haben? Du hast mir doch noch "
           "garnicht geholfen!";

  if(TP->QueryProp(P_RACE)!="Troll")
    return "Nur Trolle bekommen eine Belohnung von mir!";	  

  if(present("\nPROtheG_Racetool", TP)) 
    return "Aber Du hast doch bereits ein Bergpumagebiss!";
  
  clone_object("/p/service/protheg/rt/obj/trollgebiss")->move(TP, M_NOCHECK);

  return "Hier hast Du Deine Belohnung, ein Bergpumagebiss.";
}
