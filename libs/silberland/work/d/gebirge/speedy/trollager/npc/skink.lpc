
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

int schwanz;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  schwanz=1;

  SetProp(P_SHORT, "Ein Feuerbauchskink");
  SetProp(P_LONG,
    "Dieser Skink gehoert zur Familie der Glattechsen. Seine Haut ist so "
    "glatt wie die von Schlangen und er hat vier kurze Beinchen. Er "
    "kann nicht zuengeln wie eine Schlange, da seine Zunge nicht gespalten "
    "ist. Bei Gefahr wirft er seine Schwanzspitze ab, um seinen Angreifer "
    "abzulenken. Dieser Skink ist besonders schoen, da seine Flanken eine "
    "feueraehnliche orange-rote Zeichnung aufweist.");

  SetProp(P_NAME, "Feuerbauchskink");
  SetProp(P_GENDER, MALE);
  AddId(({"feuerbauchskink", "skink"}));

  create_default_npc(6);
  SetProp(P_HANDS, ({" mit seinem langen Schwanz",
                     QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Skink");
  SetProp(P_SIZE, 20+random(10));
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,1);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.0, DT_WATER:  0.2, DT_AIR:    0.0, 
      DT_LIGHTNING:  0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "kommt hereingekrochen");
  SetProp(P_MSGOUT, "huscht weiter");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, (ROOM "t") );
  SetProp(P_MNPC_WAIT, ({ 15, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "t1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " ist platt auf dem Boden zerquetscht.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Feuerbauchskink will @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,60,
    "Der Feuerbauchskink schnappt Dir ins Bein.\n",
    "Der Feuerbauchskink schnappt @WEM ins Bein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SUID;
}

void init() {
  ::init();
  if (TP && TP->id("\n_grille") && !interactive(TP)) {
    call_out("friss",0);
  }
}

void friss() {
  if (!MENV || !TP) return; //Sicher ist sicher (Feyaria)
  if (!present(TP,MENV)) return;
  tell_room(MENV,BS(
    "Der Feuerbauchskink schnappt in Richtung der Zweipunktgrille."));
  if(!random(5)) {
    tell_room(MENV,BS(
      "Der Feuerbauchskink erwischt die Zweipunktgrille und frisst sie auf."));
    TP->remove();
  } else {
    tell_room(MENV,BS(
      "Der Feuerbauchskink verfehlt die Zweipunktgrille."));
  }
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  if (!random(5) && schwanz) {
    SetProp(P_LONG,
    "Dieser Skink gehoert zur Familie der Glattechsen. Seine Haut ist so "
    "glatt wie die von Schlangen und er hat vier kurze Beinchen. Er "
    "kann nicht zuengeln wie eine Schlange, da seine Zunge nicht gespalten "
    "ist. Bei Gefahr wirft er seine Schwanzspitze ab, um seinen Angreifer "
    "abzulenken. Dieser Skink ist besonders schoen, da sein bauch eine "
    "feueraehnliche orange-rote Zeichnung aufweist. Er hat in einem Kampf "
    "wohl gerade seinen Schwanz abgeworfen.");
    schwanz=0;
    dam=0;
    if (MENV) {
      tell_room(MENV,BS(
        "Der Feuerbauchskink wirft seinen Schwanz ab."), ({ enemy }) );
      tell_object(enemy,BS(
        "Der Feuerbauchskink wirft seinen Schwanz ab. Du bist verwirrt und "
        "triffst den Skink deshalb nicht, sondern nur den Schwanz."));
      SetProp(P_HANDS, ({" mit seinem Maul",
                         QueryProp(P_HANDS)[1],DT_BLUDGEON}));
    }
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

void reset() {
  ::reset();
  if (!schwanz) {
    if (MENV) {
      tell_room(MENV,BS(
        "Dem Feuerbauchskink waechst ein neuer Schwanz nach."));
    }
    schwanz=1;
    SetProp(P_HANDS, ({" mit seinem langen Schwanz",
                       QueryProp(P_HANDS)[1],DT_BLUDGEON}));
    SetProp(P_LONG,
      "Dieser Skink gehoert zur Familie der Glattechsen. Seine Haut ist so "
      "glatt wie die von Schlangen und er hat vier kurze Beinchen. Er "
      "kann nicht zuengeln wie eine Schlange, da seine Zunge nicht gespalten "
      "ist. Bei Gefahr wirft er seine Schwanzspitze ab, um seinen Angreifer "
      "abzulenken. Dieser Skink ist besonders schoen, da sein bauch eine "
      "feueraehnliche orange-rote Zeichnung aufweist.");
   }
}
