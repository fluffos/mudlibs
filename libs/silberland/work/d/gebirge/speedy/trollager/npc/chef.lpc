
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../def.h"

inherit "std/npc";

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Trollhaeuptling");
  SetProp(P_LONG,
    "Der Trollhaeuptling ist ein recht grosser und starker "
    "Troll, aber haesslich wie all die anderen. Obwohl er nur wenig Ruestung "
    "traegt ist er beim Kampf sicher ein starker Gegner. "
    "Er sieht mit majetaetischen Blick auf Dich herab.");
  SetProp(P_NAME, "Haeuptling");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Troll");
  AddId(({"chef","troll","trollhaeuptling","haeuptling", "Keulenexperte", "Axtexperte"}));
  create_default_npc(28);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:0.5, DT_AIR:-0.5, DT_TERROR:-0.5]));
  SetProp(P_ALIGN, -500);
  SetProp(P_SIZE, random(50)+299);

  SUID;
  switch (random(4) )
  {
    case 0: CLONEME( WEAPON "trollkeule" );break;
    case 1: CLONEME( "/p/weapon/club/steinkeule"); break;
    case 2: CLONEME( "/p/weapon/club/stachelkeule"); break;
    case 3: CLONEME( "/p/weapon/axe/steinaxt"); break;
  }
  CLONEME( ARMOUR "schwtrollruestung" );
  CLONEME( OBJ "key" );
  command("zuecke keule");
  command("zuecke axt");
  command("ziehe alles an");

  SetAttackChats(45, ({"@@zauber@@"}));
  SetChats(10, ({"@@flirten@@"}));
}

ziering(object taeter) { 
  tell_room(MENV,break_string(
    "Was? "+taeter->name(WER,1)+" will sich an meine Maedchen ranmachen? "
    "Na warte!",78,"Der Haeuptling sagt: "));
  command("ziehe ring");
}

hilfmir(object en) { 
  tell_room(MENV,break_string(
    "Hey! "+en->name(WER,1)+" will meine Maedchen toeten! Na warte!",78,
    "Der Haeuptling schreit: "));
  command("ziehe ring");
}

flirten() { 
  if (present("trollmaedchen")) {
    switch(random(8)) {
      case 0: say("Der Haeuptling laechelt ein Trollmaedchen an.\n");break;
      case 1: say("Der Haeuptling grapscht einem Trollmaedchen auf den Po."+
                  "\nDas Trollmaedchen quiekt laut auf.\n");break;
      case 2: say("Der Haeuptling fluestert einem Trollmaedchen was zu.\n"+
                  "Das Maedchen schaut Dich an und kichert albern.\n");break;
      case 3: say("Der Haeuptling knuddelt ein Trollmaedchen.\n");break;
      case 4: say("Der Haeuptling fummelt an einem Trollmaedchen rum und"+
                  " grinst frech.\n"+
                  "Das Maedchen haut dem Haeuptling eine runter.\n");break;
      case 5: say("Der Haeuptling knutscht seine Trollmaedchen zaertlich"+
                  ".\n");break;
      case 6: say("Der Haeuptling sagt: Finger weg von meinen Maedchen,"+
         " sonst koennt\nDer Haeuptling sagt: ihr was erleben!.\n");break;
      case 7: say("Der Haeuptling knurrt Dich boese an.\n");break;
    }
  }
  return "";
}

zauber() {
  string mesg, mesh;
  object en;

  en = QueryEnemy();
  switch (random(11)) {
  case 0:
    mesg="hext ";
    mesh=" eine fette Warze an den Po";
    break;
  case 1:
    mesg="hext ";
    mesh=" lauter lila-gelbe Tupfen ins Gesicht";
    break;
  case 2:
    mesg="zaubert ";
    mesh=" eine lange Nase";
    break;
  case 3:
    mesg="hext ";
    mesh=" zwei lange Eselsohren an";
    break;
  case 4:
    mesg="hext ";
    mesh=" zwei Ochsenhoerner an den Kopf";
    break;
  case 5:
    mesg="verwandelt ";
    mesh=" die Beine in Klumpfuesse";
    break;
  case 6:
    mesg="spricht einen Fluch aus. ";
    mesh=" wachsen ploetzlich lauter haessliche"+
         " Haare am ganzen Koerper";
    break;
  case 7:
    mesg="hext ";
    mesh=" zwei lange vorstehende Zaehne an";
    break;
  case 8:
    mesg="verwandelt die Haende von ";
    mesh=" in Bockshufe";
    break;
  case 9:
    mesg="zaubert ";
    mesh=" ein niedliches kleines Ringelschwaenzchen an den"+
         " Hintern";
    break;
  case 10:
    mesg="zaubert ";
    mesh=" lauter eitrige gruene Beulen an den Koerper";
    break;
  }
  tell_object(en, "Der Haeuptling "+mesg+"Dir"+mesh+"!\n");
  say("Der Haeuptling "+mesg+en->name(WEM,1)+mesh+"!\n", en);

  return "";
}

