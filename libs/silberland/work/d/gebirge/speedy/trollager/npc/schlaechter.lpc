
#include <combat.h>
#include <properties.h>
#include <attributes.h>
#include <language.h> 
#include <defines.h>
#include <wizlevels.h>
#include <moving.h>

#include "../def.h"

inherit "std/npc";

int deathtime;
 
create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein grimmiger Schlaechter");
  SetProp(P_LONG,
    "Der Schlaechter ist ein unheimlich muskuloeser Troll, der schon eher "
    "einem Riesen gleicht. Er starrt Dich mit durchdringendem Blick an, der "
    "keine Zweifel mehr laesst: Wenn es an der Zeit ist, wird er seine "
    "Arbeit tun, das Abschlachten seiner Opfer. Mit seinem blutigen "
    "Schlachtbeil versteht er sehr gut umzugehen.");
  SetProp(P_NAME, "Schlaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"schlaechter", "troll","trollschlaechter"}));
  SetProp(P_RACE, "Troll");
  create_default_npc(28);
  SetProp(P_ALIGN, -1000);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:0.5, DT_AIR:-0.5, DT_TERROR:-0.5]));
  SetProp(P_NOCORPSE, 0);
  SetProp(P_SIZE, random(50)+290);
  SetProp(P_KILL_MSG, "Und wieder einer, der glaubt, er waere besser ...");
  SetChats(10, ({"@@arbeit@@"}));

  SUID;
  CLONEME( WEAPON "schlachtbeil" );
  command("zuecke beil");

  AddCmd("ende","feigheit");
  deathtime=0;

  SetProp(P_DEFAULT_INFO,
    "sagt: Ich kann die was ueber meine Arbeit erzaehlen.");

  AddInfo( ({"arbeit","schlachten"}),
    "Haha, das Schlachten von hilflosen Gefangenen ist meine Spezialistaet. "
    "Alle paar Minuten suche ich mir jemanden aus und den hacke ich seinen "
    "Kopf ab. Denn Koepfe schmecken sehr gut!", "sagt grimmig: ");
}

arbeit() { 
  int i;
  switch (random(11)) {
      case 1: 
        say(BS(
          "Der Schlaechter schwingt sein Beil mit einer Hand."));
        break; 
      case 2: 
        say(BS(
          "Der Schlaechter fuehlt Deine Wadeln, ob auch genug dran ist, "
          "damit es fuer einen guten Braten am Spiess reicht.")); 
        break; 
      case 3: 
        say(
          "Der Schlaechter sagt: Ja wen haben wir denn da heute?\n"
          "Der Schlaechter knuddelt Dich.\n");
        break;
      case 4: 
        say(
          "Der Schlaechter singt: Knock, knock, kocking on heavens door,\n"
          "Der Schlaechter singt: hi, hi, hi hi yeh...\n");
        break; 
      case 5: 
        say(BS(
          "Der Schlaechter schaut Dich an und schleckt sich gierig die "
          "Lippen."));  
        break;
      case 0: 
        say(BS(
          "Der Schlaechter putzt seine dreckigen Fingernaegel mit dem "
          "Schlachtbeil."));
        break;
      case 10: 
        say(
          "Der Schlaechter warnt: Wenn da jemand 'Ende' macht, dann\n"
	  "Der Schlaechter warnt: schlacht ich ihn auf der Stelle ab!\n");
        break; 
      case 6..9: 
        doyourjob();
  }
  return "";
}

doyourjob() {
  deathtime--;
  if (deathtime==-1) deathtime=3;
  switch(deathtime) {
  case 3: {
    say(
      "Der Schlaechter sagt gelangweilt: Wann gibts endlich wieder mal\n"
      "Der Schlaechter sagt gelangweilt: Arbeit fuer mich und mein Beil?\n");
    break;
  }
  case 2: {
    say(
      "Der Schlaechter grunzt: So, jetzt wirds langsam Zeit.\n"
      "Er schaut Dich an und meint: Na, wie waers denn mit Dir, Kleiner?\n");
    break;
  }
  case 1: {
    say(
     "Der Schlaechter sagt: So, jetzt gibts gleich wieder Arbeit\n"+
     "Der Schlaechter sagt: Wer meldet sich freiwillig?\n"+
     "Der Schlaechter grinst dreckig.\n");
    break;
  }
  case 0:
    kopfab();
  }
}

kopfab() {
  say(break_string(
    "So, jetzt ist einer dran von euch!",78,"Der Schlaechter bruellt: "));
  say(BS(
    "Schlaechter greift wahllos in die Runde..... Jetzt wirds spannend!"));
  call_out("action",5);
}

action() {
  int i;
  int anzahl;
  object *inv, *npcs, *players;
  object opfer;

  inv=all_inventory(MENV);
  npcs = players = ({ });
  inv -= ({ TO });
  for(i=sizeof(inv); i; ) {
    i--;
    if(inv[i]->gefangen()) {
      npcs += ({ inv[i] });
    } else {
      if(interactive(inv[i])) {
	players += ({ inv[i] });
      }
    }
  }
  if(sizeof(npcs)) {
    opfer = npcs[0];
  } else {
    if(sizeof(players)) {
      opfer = players[random(sizeof(players))];
    } else {
      return;
    }
  }
  if(opfer->id("Trollspieler")) {
    tell_object(opfer, 
      "Der Schlaechter bruellt Dich an: Hey, Du bist ja einer von uns! Verschwinde!\n"
      "Der Schlaechter wirft Dich raus.\n");
    tell_room(MENV, "Der Schlaechter packt "+
          CAP(getuid(opfer))+
         " und wirft "+opfer->QueryPronoun(WEN)+" aus den Raum.\n", 
         ({opfer}));
    opfer->move("/d/gebirge/speedy/trollager/room/boss", M_GO, "raus", 
         "fliegt", "fliegt herein");
    return;
  }
  if(interactive(opfer)) {
    tell_object(opfer,
      "Der Schlaechter greift nach DIR!!!\n"+BS(
      "Du versucht wegzurennen, doch der Schlaechter packt Dich am " 
      "Kragen und legt Deinen Kopf auf die Schlachtbank.")+
      "SCHNAPPPPP! Mit einem maechtigen Schlag hackt er Dir den Kopf "
      "ab.\n");
  }
  say(BS(
    "Der Schlaechter greift nach "+opfer->name(WEM,1)+", "+
    opfer->name(WER,1)+" versucht wegzurennen, aber der Schlaechter "
    "ist schneller. Er schnappt sich "+opfer->name(WEN,1)+" und legt "
    "sein hilflos zappelndes Opfer auf die Schlachtbank. SCHNAPPPPP! "
    "Schon ist der Kopf "+opfer->name(WESSEN,1)+" vom Rumpf "
    "getrennt. Der Schlaechter krallt sich den Kopf und verschluckt "
    "ihn mit einem Haps."), opfer);
  SetProp(P_KILL_MSG, "Haha, wieder rollt ein Kopf.");
  opfer->die();
  if (opfer) death( opfer );
  SetProp(P_KILL_MSG, "Und wieder einer, der glaubt, er waere besser ...");
}

feigheit() { 
  domainshout(BS(
    "Der Schlaechter bruellt: "+TP->name(WER,1)+" die feige Sau, "+
    "hat bei mir ENDE gemacht!!"), "gebirge");
  return 0;
}

death(object spieler) {
  object ob;

  tell_room(ROOM "jail", "Ein Troll ruft: Ich hol schon die Leiche!\n");
  ob=first_inventory(ROOM "jail");
  if( !living(ob) ) {
    if ( ob->move(ROOM "tres", M_SILENT) ) {
      tell_room( ROOM "jail", BS(
        "Ein kleiner Troll schleppt die Leiche von "+spieler->name(WER,1)+
        " davon."));
      tell_room(ROOM "tres", BS(
	"Ein kleiner Troll schleppt die Leiche von "+spieler->name(WER,1)+
        " herein, und wirft sie in eine Ecke."));
      call_other(ROOM "spiess","opfer",spieler->name(WER,1),100000);
    }
  }
}
