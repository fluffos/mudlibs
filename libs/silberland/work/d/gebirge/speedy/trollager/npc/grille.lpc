
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Zweipunktgrille");
  SetProp(P_LONG,
    "Bei dieser Grille handelt es sich um eine Zweipunktgrille, die wie "
    "eine dicke, schwarze Heuschrecke aussieht. Den Namen traegt sie wegen "
    "ihrer beiden Punkte auf den Fluegelansaetzen. Mit ihren langen "
    "Sprungbeinen kann sie geschickt vor den gefraessigen Skinken fluechten.");

  SetProp(P_NAME, "Zweipunktgrille");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zweipunktgrille", "grille", "\n_grille" }));

  create_default_npc(3);
  SetProp(P_HANDS, ({" mit ihren kleinen Fluegeln",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Grille");
  SetProp(P_SIZE, 5);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_WIMPY, 10);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    -1.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:   0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR:  0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft weiter");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM "t") );
  SetProp(P_MNPC_WAIT, ({ 15, 15, 15 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "t1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " landet toedlich getroffen auf dem Boden.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Zweipunktgrille kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,5);
  AddSpell(1,50,
    "Die Zweipunktgrille springt Dir direkt ins Auge.\n",
    "Die Zweipunktgrille springt @WEM direkt ins Auge.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));

  SetChats(15, ({
    "Die Zweipunktgrille huepft knapp an Dir vorbei.\n",
    "Die Zweipunktgrille putzt ihre Fluegelansaetze.\n",
    "Die Zweipunktgrille zirpt Dir ein Liedchen vor.\n",
    "@@zirpen@@",
    "Die Zweipunktgrille zirpt.\n"}) );

  SUID;
}

zirpen() {
  mapping ex;
  mixed ziel;
  object *rooms,ob;
  string *ind;
  int i;
  if(MENV && !interactive(MENV)) {
    ex=MENV->QueryProp(P_EXITS)+MENV->QueryProp(P_SPECIAL_EXITS);
    if (mappingp(ex)) {
      ind=m_indices(ex);
      rooms=({ });
      for (i=sizeof(ind)-1;i>=0;i--) {
        if (!stringp(ziel=ex[ind[i]])) continue;
        if (!ob=find_object(ziel)) continue;
        rooms+=({ ob });
      }
      for (i=sizeof(rooms)-1;i>=0;i--) {
        tell_room(rooms[i],BS(
          "Du hoerst aus der Ferne eine Zweipunktgrille zirpen.\n"));
      }
    }
  }
  return "Die Zweipunktgrille zirpt sehr laut.\n";
}
