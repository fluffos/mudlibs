
#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/npc";

create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Trolljunge");
  SetProp(P_LONG,
    "Ein junger kleiner frecher Troll. Er hat zersauste "
    "schwarze Haare, eine lange Trollnase und ein breites Grinsen im "
    "Gesicht. Er freut sich sichtlich, wenn ihm Abenteurer Gesellschaft "
    "leisten.");
  SetProp(P_NAME, "Trolljunge");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Troll");
  AddId( ({"troll", "junge", "trolljunge", "lausbub"}) );
  create_default_npc(5);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:0.5, DT_AIR:-0.5, DT_TERROR:-0.5]));
  SetProp(P_ALIGN, 0);
  SetProp(P_SIZE, random(40)+190);
  SetProp(P_NOATTACK,"erzaehlt Dir eine Geschichte ueber seine "
                     "Mutter\nund Du bekommst Mitleid.");

  SUID;

  CLONEME ( "/p/weapon/knife/messer" );
  command("zuecke messer");

  AddCmd("biete","freundschaft");

  SetChats(10, ({
    "Der Trolljunge grinst frech.\n",
    "Der Trolljunge lacht Dich aus.\n",
    "Der Trolljunge grinst dummelig.\n",
    "Der Trolljunge rotflt.\n",
    "Der Trolljunge zueckt einen Drachentoeter.\n",
    "Der Trolljunge sagt: Wetten wir, ich schuette dir nen Kuebel Wasser "+
    "ins\nDer Trolljunge sagt: Gesicht, und du wirst nicht nass?\n"+
    "Der Trolljunge schuettet Dir einen Kuebel Wasser ins Gesicht, du wirst "+
    "waschelnass.\n"+
    "Der Trolljunge grinst: Wette verloren.\n",
    "Der Tod sagt: KOMM MIT MIR, STERBLICHER!\n",
    "Der Trolljunge sagt: Wenn Du mir ein Silberhalsband bringst, "+
    "bekommst du\nDer Trolljunge sagt: einen Zaubertrank von mir, ehrlich.\n",
    "Der Trolljunge zieht deine Nase lang und laesst sie zurueckschnalzen.\n",
    "Der Trolljunge klaut deinen Teddy und verknotet ihm Arme und Beine.\n",
    "Der Trolljunge wirft einen Feuerball nach Dir.\n",
    "Der Trolljunge pinkelt dir vor die Fuesse und grinst Dich frech an.\n",
    "Der Trolljunge zieht eine Flasche Trollschnaps aus seiner Tasche und "+
    "saugt\nkraeftig daran.\n",
    "Der Trolljunge raucht sich eine Golowar Filterlos an und blaest dir "
    "eine\ndicke Rauchwolke ins Gesicht.\n"+
    "Du hustet dir die Lunge aus dem Leib.\n",
    "Der Trolljunge verflucht Dich.\n",
    "Der Trolljunge zieht dir die Ohren lang.\n",
    "Der Trolljunge grinst: So doof wie Du aussiehst, sollte man dich zum\n"+
    "Der Trolljunge grinst: Vogel Rok stellen.\n",
    "Ein riesiges Untierbaby kommt an.\n",
    "Der Trolljunge bietet Dir Freundschaft an.\n",
    "Der Trolljunge sagt: Unsere Trollamulette haben Zauberkraft.\n"}));

  SetProp(P_LOG_INFO, "zordan/gjordil-quest.log");

  AddInfo( ({"gjordil","stammesaeltester","aeltester" }),
    "Gjordil ist unser Stammesaeltester. Er weiss sehr viel ueber uns "
    "und unser Lager. Wenn Du mehr wissen moechtest darueber, geh doch "
    "mal zu ihm und frag ihn.",
    "sagt: ");

  AddInfo( ({"lager","trollager"}),
    "Ich spiele hier immer im Lager. Mein Vater ist das Oberhaupt der "
    "Trollwachen.",
    "sagt: ");

  AddInfo( ({"mutter","mama"}),
    "Meine Mutter wurde von irgendwem gefressen.",
    "zuckt: ");

  AddInfo( ({"vater","papa"}),
    "Mein grosser Vater muss hier irgendwo im Lager sein. Er befiehlt die "
    "Trollwachen.",
    "sagt: ");

  AddInfo( ({"trollwachen","wachen","trollwache","wache"}),
    "Die passen auf mich und unser Lager auf.",
    "sagt: ");

  AddInfo( ({"griff"}),
    "Wie kommst Du denn nur jetzt bloss auf einen Griff?",
    "sagt verlegen: ");

  AddInfo( ({"quest","hilfe"}),
    "Danke, aber ich brauche Deine schwache Hilfe sicher nicht.",
    "lacht: ");

  AddInfo( ({"krueckstock","stock"}),
    "Der Gjordil hat einen wunderschoenen Krueckstock. Am Liebsten wuerde "
    "ich ihn ja gerne haben. Aber er meinte ich bekomme ihn nicht.",
    "schnieft: ");

  AddInfo( ({"stehlen","diebstahl","gestohlen","dieb","entwenden","rauben",
             "raub","geraubt","stehle","raeuber"}),
    "Ich habe schon mal dem Gjordil was gestohlen und dicke Beute gemacht. "
    "Aber wehe Du verraetst ihm was davon, ich werde alles abstreiten!",
    "erroetet und gibt an: ");

  AddInfo( ({"beute"}),
    "Hehe, na die Beute habe ich nicht bei mir. Ich habe sie sehr gut "
    "versteckt. Sooo bloed bin ich nun auch wieder nicht!",
    "grinst: ");

  AddInfo( ({"versteck"}),
    "Na glaubst Du ernsthaft ich verrate DIR etwas darueber? Koennte ja jeder "
    "kommen und so bloede bin ich sicher nicht, mein Geheimversteck zu "
    "verraten!",
    "sagt forsch: ");

  AddInfo( ({"luege","luegen","luegner","luegnerin"}),
    "Ich sage immer die Wahrheit.",
    "sagt: ");

  AddInfo( ({"wahrheit"}),
    "Hehe, aber nur zu meinem Vater.",
    "sagt grinsend: ");

  AddInfo( ({"geld","muenzen","muenze"}),
    "Ich bin ganz sicher nicht bestechlich!",
    "schimpft: ");

  AddInfo( ({"halsband","band"}),
    "Weisst Du etwa nicht wo man das bekommen kann?",
    "lacht Dich aus: ");

  AddInfo( ({"baum","baeume"}),
    "Es gibt hier einen tollen Baum zum Spielen im Trollager.",
    "sagt erfreut: ");

  AddInfo( ({"spiel","spielen"}),
    "Spielst Du denn nie? Achne, Du bist ja schon ganz grau wegen Deinem "
    "Alter.",
    "lacht: ");

  AddInfo( ({"streich","streiche","jedem","jeder"}),
    "Ich spiele mit Jedem hier einen Streich.",
    "prustet los: ");

  AddInfo( ({"boden"}),
    "Vom Boden aus kann man es nicht sehen. Es ist gigantisch gut versteckt.",
    "grinst: ");

  AddInfo( ({"zordan"}),
    "Den verarsche ich immer wieder gerne.",
    "grinst: ");

  AddInfo( ({"berg","berge","erde"}),
    "Mein Vater ist so gross wie ein Berg und stampft Dich sicher ungespitzt "
    "in die Erde.",
    "lacht Dich aus: ");


  AddInfo( ({"geheimversteck"}), "@@versteck@@" );
}

freundschaft(str) {
  notify_fail("Wem willst Du was anbieten?\n");
  if (!str) return 0;
  if((str=="trolljungen freundschaft an")||
     (str=="trolljunge freundschaft an")||
     (str=="junge freundschaft an")||
     (str=="jungen freundschaft an")) {
    write("Der Trolljunge bruellt: Reingefallen!\n"+
	  "Der Junge lacht: Sowas doofes wie du als Freund? - noe.\n");
    return 1; 
  }
}

string versteck() {
  object item;
  if (item=present( QUESTITEM, TP)) {
    item->gefragt();
  }
  write(break_string(
    "Du bist sicher viel zu klein um es direkt vom Boden aus zu sehen. Und "
    "NEIN, ich werde Dir nicht verraten wo es ist. Schliesslich ist es sehr "
    "gut versteckt und niemand hat es bisher gefunden!",78,
    "Der Trolljunge mustert Dich: "));
  return "lacht Dich aus.";
}
