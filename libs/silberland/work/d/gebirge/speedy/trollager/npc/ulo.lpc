
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ulo, der Trollhaendler");
  SetProp(P_LONG,
    "Vor Dir steht ein uralter Troll. Er handelt mit allen Waren, mit denen "
    "Trolle zu tun haben. Du solltest Dich allerdings nicht von seinem "
    "hohen Alter taeuschen lassen. Betruegen oder gar Angreifen wird er "
    "sicherlich sehr hart bestrafen.");
  SetProp(P_NAME, "Ulo");
  SetProp(P_GENDER, MALE);
  AddId( ({"\n_ulo", "ulo", "haendler", "trollhaendler", "troll"}) );
  set_living_name("ulo");

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen dicken Haenden",
                   QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 300+random(50));
  SetProp(P_ALIGN, -300);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.5, DT_COLD:      -0.2, DT_WATER:   0.0, DT_AIR:   -0.5, 
      DT_LIGHTNING:  0.0, DT_EXPLOSION:  0.0, DT_SOUND:  -1.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON:  0.0, DT_TERROR:-0.5,
      DT_HOLY:       0.0, DT_UNHOLY:    -0.5, DT_MAGIC:   0.0 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an und kramt in seinen Sachen");
  SetProp(P_MSGOUT, "verzieht sich");

  AddInfo(DEFAULT_INFO, "mag Dir darauf nicht antworten.\n");
  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Ulo sagt: Danke.\n" }) );

  SetProp(P_SPELLRATE,80);

  AddSpell(3,300,
    "Ulo schlaegt Dir mitten in den Magen.\n",
    "Ulo schlaegt @WEM mitten in den Magen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,500,
    "Ulo gibt Dir einen harten Faustschlag mitten ins Gesicht.\n",
    "Ulo gibt @WEM einen harten Faustschlag mitten ins Gesicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1000,
    "Ulo sticht Dir seinen Dolch ins Herz.\n",
    "Ulo sticht @WEM seinen Dolch ins Herz.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Ulo fragt: Hast Du nicht zu verkaufen?\n",
    "Ulo sortiert seine Waren.\n",
    "Ulo schaut Dich erwartungsvoll an.\n",
    "Ulo zaehlt sein Geld.\n",
    "Ulo fragt: Willst Du nicht was kaufen?\n"}) );
  SetAttackChats(10, ({
    "Ulo sagt: Dir werde ich nie wieder was verkaufen!\n",
    "Ulo wuetet wie ein Wilder.\n",
    "Ulo rast wie besessen.\n",
    "Ulo schreit: Hilfe, Wachen!\n"}) );

  ob=clone_object("/obj/money");
  ob->AddAmount(300+random(300));
  ob->move(ME,M_NOCHECK);

  SUID;
  CLONEME(WEAPON "trolldolch" );
  command("zuecke trolldolch");
  CLONEME("/p/armour/armour/hemd" );
  CLONEME("/p/armour/boots/lederschuhe" );
  command("trage alles");
}

int _query_wimpy() { return 0; }
