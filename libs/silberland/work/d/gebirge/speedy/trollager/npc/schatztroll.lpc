
#include <properties.h>
#include "../def.h"

inherit "std/npc";

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Schatzwache");
  SetProp(P_LONG,
    "Ein grosser boeser Troll. Unter seinem zersausten "
    "Haar blicken Dich zwei freche Augen an. Er hat eine knorrige, lange Nase "
    "und sein Koerper ist mit wuscheligem Fell bedeckt.");
  SetProp(P_NAME, "Schatzwache");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Troll");
  AddId( ({"troll","wache","schatzwache","\n_schatzwache","\n_helptroll", "Keulenexperte", "Axtexperte"}) );
  create_default_npc(23);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:0.5, DT_AIR:-0.5, DT_TERROR:-0.5]));
  SetProp(P_ALIGN, -417);
  SetProp(P_SIZE, random(40)+299);
  SUID;
  switch( random(4) )
  {
    case 0: CLONEME( WEAPON "trolldolch" );break;
    case 1: CLONEME( "/p/weapon/club/dornenkeule");break;
    case 2: CLONEME( "/p/weapon/club/stachelkeule");break;
    case 3: CLONEME( "/p/weapon/axe/steinbeil");break;
  }
  CLONEME( ARMOUR "trollruestung" );
  command("zuecke dolch");
  command("zuecke keule");
  command("zuecke beil");
  command("ziehe alles an");
}

init() {
  ::init();
  if (TP && TP->id("\n_schatzwache")) AddDefender(TP);
  if (TP && TP->id("\n_helptroll")) AddDefender(TP);
}

void InformDefend(object enemy) {
  Kill(enemy);
}
