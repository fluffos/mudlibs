
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

#include "../def.h"

#define MTIME 15

inherit "std/npc";

init() {
  ::init();
  if (TP && TP->id("\n_helptroll")) AddDefender(TP);
  if (TP && TP->id("\n_schatzwache")) AddDefender(TP);
}

void InformDefend(object enemy) {
  Kill(enemy);
}

create() { 
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Trollwaechter");
  SetProp(P_LONG,
     "Ein grosser, starker Troll. Er hat ein haessliches, runzliges Gesicht "
     "und schaut Dich grimmig an. Da er zur Trollwache gehoert, ist er "
     "stark bewaffnet. Seine Aufgabe ist: Alle Eindringlinge im Lager zu "
     "toeten.");
  SetProp(P_NAME, "Trollwaechter");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Troll");
  SetProp(P_MSGOUT, "trollt sich");
  AddId( ({"troll","trollwaechter","waechter","wache",
           "trollwache","\n_helptroll", "Axtkaempfer", "Keulenkaempfer"}));
  create_default_npc(18+random(3));
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:0.5, DT_AIR:-0.5, DT_TERROR:-0.5]));
  SetProp(P_ALIGN, -437);
  SetProp(P_SIZE, random(40)+299);
  SetProp(P_AGGRESSIVE, ([P_RACE:(["Troll":0.0, 0:1]) ]) );
  SetProp(P_MAX_HANDS, 2); 

  SUID;
//  clone_object(OBJ("diamant"))->move(this_object());
  switch( random(4) )
  {
    case 0: CLONEME( WEAPON "trollschwert" ); break;
    case 1: CLONEME( "/p/weapon/club/stachelkeule" ); break;
    case 2: CLONEME( "/p/weapon/club/steinkeule"); break;
    case 3: CLONEME( "/p/weapon/axe/steinbeil"); break;
  }
  CLONEME( ARMOUR "trollruestung" );
  command("zuecke keule");
  command("zuecke beil");
  command("ziehe ruestung an");
  command("zuecke schwert");

  call_out("weiter", random(10)+1);
  call_out("feierabend",1200+random(200));

  SetProp(P_SPELLRATE,40);

  AddSpell(10,300,
    "Der Trollwaechter pruegelt auf Dich ein.\n",
    "Der Trollwaechter pruegelt auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,400,
    "Der Trollwaechter vergraebt Dich unter sich.\n",
    "Der Trollwaechter vergraebt @WEN unter sich.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,500,
    "Der Trollwaechter zerschmettert Dein Gehirn.\n",
    "Der Trollwaechter zerschmettert @WESSEN Gehirn.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(40, ({
    "Der Trollwaechter bruellt: Sterben musst du!\n",
    "Der Trollwaechter bruellt: Auf dem Bratspiess wirst du bruzzeln!\n",
  }) );
}

weiter() { 
  int t;

  if ( ( environment() ) != ( find_object( ROOM "tres" ) ) &&
     (strstr(file_name(environment()),"/seher/") == -1) )
    command_me("nimm alles");
  t = random(MTIME)+1;
  if (ME->InFight() && random(3)) {
    call_out("weiter", t);
    return;
  }
  t+=letsgo();
  call_out("weiter", t);
}

int letsgo() { 

  if (environment()==find_object(ROOM "entr" )) {
    command_me("osten"); 
    return 3; 
  }
  if (environment()==find_object(ROOM "boss" )) {
    if (random(10)<6) command_me("westen");
    else command_me("sueden");
    return 0; 
  }
  if (environment()==find_object(ROOM "spiess" )) {
    command_me("westen");
    return 0; 
  }
  if (environment()==find_object(ROOM "t1" )) {
    if (random(3)==1) command_me("westen"); 
    else Flee(); 
    return 0; 
  }
  if (environment()==find_object(ROOM "t6" )) {
    switch(random(6)) { 
      case 0..1: { command_me("osten"); break; }
      case 2..3: { command_me("suedwesten"); break; }
      case 4: { command_me("nordwesten"); break; }
      case 5: { command_me("norden"); break; } 
    }
    return 0; 
  }
  if(environment()==find_object(ROOM "t4" )) {
    // birnschuettler
    switch(random(11)) {
      case 0..4: { command_me("norden"); break; }
      case 5..7: { command_me("nordosten"); break; }
      case  8:   { command_me("suedosten"); break; }
      case  9:   { command_me("schuettle baum"); break; }
      case 10:   { command_me("oben"); break; }
    }
    return 0; 
  }
  if (environment()==find_object(ROOM "t3" )) {
    if (random(4)==1)
      command_me("osten");
    else
      Flee(); 
    return 0; 
  }
  Flee();
  return 0;
}

feierabend() { 
  int i;
  object *inv;

  say( BS(
    "Der Trollwaechter sagt: So, Feierabend auf nach Hause."));
  inv=all_inventory();
  for(i=0;i<sizeof(inv);i++) {
    if((inv[i]->name()=="ein Diamant") ||
       (inv[i]->name()=="eine leichte Trollruestung") ||
       (inv[i]->name()=="ein Trollschwert"))
      inv[i]->remove();
    else
      inv[i]->move(ROOM "tres", M_SILENT);
  }
  remove();
}
