
#include <properties.h>
#include "../def.h"

inherit "std/npc";

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Gefangener");
  SetProp(P_LONG,
    "Ein Gefangener der Trolle. Er ist schon ziemlich abgemagert. "
    "Wahrscheinlich wird es Dir auch bald so ergehen wenn Du nicht "
    "schnellstens einen Ausgang findest.");
  SetProp(P_NAME, ({"Gefangene","Gefangenen","Gefangenen","Gefangenen"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  AddId( ({"mensch","gefangener","gefangenen"}) );
  create_default_npc(1);
  SetProp(P_ALIGN, 0);
  SetProp(P_SIZE, random(40)+150);
}

int _set_hp(int hp) {
  if (hp>5) hp=5;
  return Set(P_HP, hp);
}

int gefangen () {
  return 1;
}

int _query_wimpy() { return 0; }
