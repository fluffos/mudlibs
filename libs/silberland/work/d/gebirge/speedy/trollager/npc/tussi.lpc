
#include <properties.h>
#include <combat.h>
#include "../def.h"

inherit "std/npc";

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Trollmaedchen");
  SetProp(P_LONG,
    "Dies ist ein weiblicher Troll. Sie ist eigentlich so haesslich wie "
    "alle anderen Trolle, es sei denn Du bist selber einer. Denn dann ist "
    "sie wirklich bildschoen. Unter ihrem struppigen schwarzen Haar schauen Dich "
    "zwei freche Augen an. Sie hat eine runzlige lange Nase und grinst dich "
    "verfuehrerisch an.");
  SetProp(P_NAME, "Trollmaedchen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Troll");
  AddId( ({"troll","trollin","maedchen","trollmaedchen"}) );
  create_default_npc(5);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:0.5, DT_AIR:-0.5, DT_TERROR:-0.5]));
  SetProp(P_ALIGN, 0);
  SetProp(P_SIZE, random(50)+299);

  SUID;
  CLONEME ( ARMOUR "trollring" );
  command_me("trage alles");
}

Defend(egal, wurscht, schnurz, en) { 
  object chef;
  if (chef=present("trollhaeuptling", MENV)) chef->hilfmir(en);
  return ::Defend(egal, wurscht, schnurz, en);
}

// Reactions

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  object ob;
  if (!ob=present("trollhaeuptling",MENV)) return;
  switch (gruppe) {
    case "albern":
    case "fies":
    case "frech":
    case "froh":
    case "intim":
    case "nett":
    case "neutral":
      call_other(ob,"ziering",TP);
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}
