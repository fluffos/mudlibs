
#include <properties.h>
#include "../def.h"

inherit "std/npc";

init() {
  ::init();
  if (TP && TP->id("\n_helptroll")) AddDefender(TP);
}

void InformDefend(object enemy) {
  Kill(enemy);
}

create() {
  object cash;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Troll");
  SetProp(P_LONG,
    "Ein grosser boeser Troll. Unter seinem zerzausten "
    "Haar blicken Dich zwei freche Augen an. Er hat eine knorrige lange "
    "Nase und sein Koerper ist mit wuscheligem Fell bedeckt.");
  SetProp(P_NAME, "Troll");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Troll");
  AddId( ({ "troll","\n_helptroll", "Axtkaempfer", "Keulenkaempfer" }) );
  create_default_npc(17);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:0.5, DT_AIR:-0.5, DT_TERROR:-0.5]));
  SetProp(P_ALIGN, -417);
  SetProp(P_SIZE, random(40)+299);

  SUID;
  switch( random(4) )
  {
    case 0: CLONEME( WEAPON "trolldolch" ); break;
    case 1: CLONEME( "/p/weapon/club/dornenknueppel" ); break;
    case 2: CLONEME( "/p/weapon/club/dornenkeule"); break;
    case 3: CLONEME( "/p/weapon/axe/steinbeil"); break;
  }
  CLONEME( ARMOUR "trollruestung" );
  command("zuecke dolch");
  command("zuecke knueppel");
  command("zuecke keule");
  command("zuecke beil");
  command("ziehe alles an");
  CLONEME( "/obj/fackel" );
  cash = clone_object("/obj/money");
  cash->SetProp(P_AMOUNT, random(180)+20);
  cash->move(this_object());
}

catch_tell(str) { 
  str=lower_case(str);
  if(strstr(str, "sagt: hi")!=-1) call_out("saghi",0);
}

saghi() { 
  if (random(2)) say("Ein Troll bruellt: Hi!\n"); 
}
