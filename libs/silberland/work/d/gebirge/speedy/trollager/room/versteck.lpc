
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

nosave string *kraut;
string *saveload;

create() {
  ::create();

  kraut=({ });

  SetProp( P_INT_SHORT, "In einem kleinen Versteck" );
  SetProp( P_INT_LONG,
    "Die Sonne schafft es kaum, auch nur einen Sonnenstrahl direkt auf den "
    "Boden durchzubringen. Hier direkt im Unterholz sind eine Menge Zweige "
    "und Aeste beiseite geraeumt worden. Man kann hier zwar nicht gemuetlich "
    "stehen, aber so leicht gehockt passt Du leicht hinein. Ein paar Voegel "
    "kannst Du zwitschern hoeren." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "himmel" }),
    "Vor lauter Zweigen und Aesten kannst Du den Himmel nicht mehr richtig "
    "erkennen. Die Sonne selber schafft es kaum, diesen Ort zu erhellen.");

  AddDetail( ({ "sonnenstrahl","sonnenstrahlen","strahl","strahlen" }),
    "Ein paar ganz wenige Sonnenstrahlen schaffen es doch bis zum Boden. "
    "Es reicht gerade so aus, um diesen Ort zu erhellen.");

  AddDetail( ({ "menge" }),
    "Das sind wirklich sehr viele Zweige und Aeste. Du hast aber echt keine "
    "Lust sie zu zaehlen.");

  AddDetail( ({ "lust","frage" }),
    "Ob Lust oder nicht. Die Frage ist eher: Was wuerde es bringen?");

  AddDetail( ({ "unterholz" }),
    "Du befindest Dich mitten in einem dicken Unterholz. Dieser Ort bietet "
    "nicht gerade viel Platz fuer Leute wie Dich. Er wurde wohl kuenstlich "
    "durch eine kleine Person geschaffen.");

  AddDetail( ({ "ausmasse" }),
    "Du schaust an Dir runter. Jop, Du hast schon ganz gute Ausmasse."
    "Ob da eine Diaet helfen wuerde? ;)");

  AddDetail( ({ "diaet" }),
    "Vielleicht, vielleicht auch nicht?");

  AddDetail( ({ "leute" }),
    "Mit Leute sind hier jetzt alle Erwachsenen gemeint.");

  AddDetail( ({ "erwachsene","erwachsener" }),
    "Du bist erwachsen. Jedenfalls glaubst Du es wohl. Von Deinen Ausmassen "
    "muss man das aber auch annehmen. Schliesslich hast Du hier nicht gerade "
    "viel Platz.");

  AddDetail( ({ "platz" }),
    "Der Platz ist hier wirklich sehr begrenzt.");

  AddDetail( ({ "ort" }),
    "Dieser Ort befindet sich im dichten Unterholz. Wahrscheinlich hat der "
    "kleine Trolljunge ihn hier errichtet.");

  AddDetail( ({ "person" }),
    "Du graebst in Deinen Gedanken und Dir faellt dazu eigentlich nur der "
    "kleine Trolljunge ein.");

  AddDetail( ({ "gedanken" }),
    "Mach Dir mal jetzt Gedanken darueber, was der Trolljunge hier gemacht "
    "haben koennte.");

  AddDetail( ({ "trolljunge","junge" }),
    "Fuer einen Erwachsenen ist es hier einfach zu eng. Aber fuer einen "
    "kleinen Jungen bietet er ein gutes Versteck.");

  AddDetail( ({ "versteck" }),
    "Ja, man koennte diesen Ort ein richtiges Versteck nennen.");

  AddDetail( ({ "holz" }),
    "Das Holz der Baeume und Straeucher ist ganz normal.");

  AddDetail( ({ "baum","baeume" }),
    "Du kannst nur ein paar Staemme und Wurzeln von Baeumen erkennen.");

  AddDetail( ({ "staemme","stamm" }),
    "Die Staemme der Baeume werden meist durch die Straeucher verdeckt. "
    "Sie sind auch nicht besonders dick.");

  AddDetail( ({ "straeucher","strauch" }),
    "Unzaehlbar viele Straeucher sind rings um Dich herum. Sie bilden "
    "ein richtiges Dickicht.");

  AddDetail( ({ "dickicht" }),
    "Die kannst von hier aus das Trollager nicht mehr sehen. Aber Du "
    "weisst ja, dass Du eh mitten drin bist :)");

  AddDetail( ({ "trollager","lager" }),
    "Das ist draussen. Oder besser gesagt, Du bist schon mittendrin, "
    "allerdings im Unterholz.");

  AddDetail( ({ "troll","trolle" }),
    "Wenn Du selber keiner bist, dann siehst Du hier auch keinen.");

  AddDetail( ({ "zweige" }),
    "Viele der kleinen Zweige wurden beiseite geraeumt. Wahrscheinlich um "
    "hier den Ort ein wenig auszuweiten. Einer der Zweige zeigt eine "
    "seltsame Einkerbung.");

  AddDetail( ({ "aeste" }),
    "Viele der duennen Aeste liegen auf dem Boden, andere wiederrum wurden "
    "entweder beiseite geschoben oder aber haengen noch an den Straeuchern. "
    "Einer der besonders kleinen Aeste faellt Dir irgendwie ins Auge.");

  AddDetail( ({ "auge" }),
    "Naja, waere er Dir wirklich ins Auge gefallen, dann haettest Du ein "
    "Problem.");

  AddDetail( ({ "problem" }),
    "Aber das hast Du ja eigentlich nicht, oder?");

  AddDetail( ({ "voegel" }),
    "Du kannst die Voegel nur hoeren, aber keine sehen. Dafuer ist es hier "
    "viel zu sehr verwachsen.");

  AddDetail( ({ "gefahr" }),
    "Die ist sicher nicht gering im Trollager.");

  AddSound( DEFAULT_SOUND,
    "Du kannst das Zwitschern der Voegel deutlich hoeren.");
    
  AddSound( "zwitschern",
    "*tschiiirp* *tschiiiirrrrrp*");
    
  AddSound( "voegel",
    "Die Voegel zwitschern froehlich vor sich hin. Ihnen droht bei den "
    "Trollen wohl keine Gefahr.");
    
  AddSmell( DEFAULT_SMELL,
    "Du riechst den frischen Duft von Wald.");

  AddSmell( ({ "duft","wald" }),
    "Der Wald duftet richtig schoen frisch.");

  AddCmd( ({ "zaehl","zaehle" }),         "zaehlfkt");
  AddCmd( ({ "brich","brech","breche" }), "brechfkt");
  AddCmd( ({ "fummel","fummle" }),        "fummelfkt");
  AddCmd( ({ "bastle","bastel" }),        "bastelfkt");
  AddCmd( ({ "befestige" }),              "befestigefkt");
  AddCmd( ({ "nimm","nehm","nehme" }),    "nimmfkt");
  AddCmd( ({ "befreie","befrei" }),       "befreiefkt");

  AddExit( "raus", "./t3" );

  AddSpecialDetail( "zweig",      "zweigfkt");
  AddSpecialDetail( "ast",        "astfkt");
  AddSpecialDetail( "sonne",      "sonnefkt");
  AddSpecialDetail( "schnur",     "schnurfkt");
  AddSpecialDetail( "einkerbung", "kerbfkt" );
  AddSpecialDetail( "falle",      "fallefkt" );
  AddSpecialDetail( "boden",      "bodenfkt");
  AddSpecialDetail( "korb",       "korbfkt");
  AddSpecialDetail( "wiesel",     "wieselfkt");
  AddSpecialDetail( "griff",      "grifffkt");

  if (restore_object(QUESTSAVE)) {
    kraut=saveload;
  }

}

init() {
  ::init();
  if(TP && interactive(TP)) call_out("saghi",4);
}

void saghi() {
  if(present(TP,ME)) {
    tell_object(TP,BS(
      "Ein flinkes Wiesel rennt auf dem Boden umher und schaut Dich nervoes "
      "und neugierig an. Es scheint etwas auf dem Boden zu beschuetzen."));
  }
}

int zaehlfkt(string str) {
  notify_fail("Was moechtest Du zaehlen? Deine letzten Stunden?\n");
  if(!str) return 0;
  if(str == "meine letzten stunden" || str == "deine letzten stunden") {
    write(BS(
      "Du faengst laut an zu zaehlen. Nach eins hoerst Du auf. Warum nur?"));
    say(CAP_TPN+" faengt leise an bis eins zu zaehlen.\n");
    return 1;
  }
  if(str == "zweige" || str == "aeste") {
    write(BS(
      "Du machst Deine Haende frei und faengst an laut die Zweige und Aeste "
      "zu zaehlen. Nach ein paar dutzend machst Du erst einmal eine kleine "
      "Pause. Sofort machst Du Dich aber wieder daran und mit einem Grinsen "
      "meinst Du, genau "+random(100)+" Zweige und "+random(50)+" Aeste zu "
      "erkennen."));
    say(BS(
      CAP_TPN+" faengt wie ein Bloeder an die Zweige und Aeste zu zaehlen."));
    return 1;
  }
  return 0;
}

string zweigfkt() {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  return BS(
    "Der Zweig direkt ueber Dir hat eine seltsame Einkerbung. So als ob "
    "man daran etwas befestigen koennte.");
}

string astfkt() {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (present(QUESTAST,TP) || present(QUESTFALLE,TP))
    return
      BS("Du hast den kleinen Ast bei Dir.");
  if (item->checkfalle())
    return
      BS("Du hast den Ast mit der Schnur an der Einkerbung befestigt.");
  if (deep_present(QUESTGRIFF,TP))
    return
      BS("Der kleine Ast wird hier nicht mehr gebraucht.");
  return
    BS("Einer der kleinsten Aeste sieht sehr komisch aus. Er wurde wohl "
       "geschnitzt und vielleicht koenntest Du ihn Dir ja abbrechen.");
}

int brechfkt(string str) {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (item->checkfalle()) return 0;
  if (item->checkquest()) return 0;
  if (item->checkgebaut()) return 0;
  if (present(QUESTAST,TP) || present(QUESTFALLE,TP)) return 0;
  if (deep_present(QUESTGRIFF,TP)) return 0;
  notify_fail("Was moechtest Du denn gerne abbrechen?\n");
  if(str != "ast" && str != "ast ab") return 0;
  write(BS(
    "Du brichst den kleinen Ast vorsichtig ab und steckst ihn ein."));
  say(CAP_TPN+" bricht einen kleinen Ast ab und steckt ihn ein.\n");
  item=clone_object("/d/gebirge/zordan/gjordil/obj/ast");
  item->move(TP,M_SILENT | M_NOCHECK);
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" findet den Ast.\n" );
  return 1;
}

string sonnefkt() {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (present(QUESTSCHNUR,TP) || present(QUESTFALLE,TP))
    return
      BS("Die Sonne schafft es kaum auch nur einen Sonnenstrahl auf den "
         "Boden zu bekommen.");
  if (item->checkfalle() || deep_present(QUESTGRIFF,TP))
    return
      BS("Die Sonne schafft es kaum auch nur einen Sonnenstrahl auf den "
         "Boden zu bekommen.");
  return
    BS("Die Sonne schafft es kaum auch nur einen Sonnenstrahl auf den "
       "Boden zu bringen. Aber was ist das? Eine kleine Schnur baumelt "
       "mitten im Dickicht.");
}

string schnurfkt() {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (present(QUESTSCHNUR,TP) || present(QUESTFALLE,TP))
    return
      BS("Du hast die kleine Schnur bei Dir.");
  if (item->checkfalle())
    return
      BS("Du hast den Ast mit der Schnur an der Einkerbung befestigt.");
  if (deep_present(QUESTGRIFF,TP))
    return
      BS("Du musst Dich wohl getaeuscht haben. Da ist gar keine Schnur.");
  return
    BS("Eine kleine Schnur hat sich im Dickicht verfangen. Du koenntest ja "
       "mal versuchen sie aus dem Dickicht zu fummeln.");
}

int fummelfkt(string str) {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (item->checkfalle()) return 0;
  if (item->checkquest()) return 0;
  if (item->checkgebaut()) return 0;
  if (present(QUESTSCHNUR,TP) || present(QUESTFALLE,TP)) return 0;
  if (deep_present(QUESTGRIFF,TP)) return 0;
  notify_fail("Was moechtest Du denn gerne wo rumfummeln?\n");
  if(str != "schnur aus dickicht" && str != "schnur") return 0;
  if(str == "schnur") {
    notify_fail("Woraus moechtest Du die Schnur fummeln?\n");
    return 0;
  }
  write(BS(
    "Du fummelst solange an der Schnur in dem Dickicht herum, bis Du sie "
    "endlich nach langer Zeit befreit hast. Du steckst die Schnur natuerlich "
    "sofort ein."));
  say(CAP_TPN+" fummelt eine ganze Weile im Dickicht herum.\n");
  item=clone_object("/d/gebirge/zordan/gjordil/obj/schnur");
  item->move(TP,M_SILENT | M_NOCHECK);
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" findet die Schnur.\n" );
  return 1;
}

string kerbfkt() {
  string str;
  object item;
  str="Einer der Zweige hat eine seltsame Einkerbung. Sie sieht irgendwie "
      "unnatuerlich aber dennoch gewollt aus.";
  if (!item=present(QUESTITEM, TP)) return BS(str);
  if (!item->checkgefragt()) return BS(str);
  if (!item->checkfunkeln()) return BS(str);
  if (present(QUESTAST,TP) || present(QUESTSCHNUR,TP)) return BS(str);

  str="Einer der Zweige hat eine seltsame Einkerbung. Sie sieht irgendwie "
      "unnatuerlich aber dennoch gewollt aus. Du ueberlegst Dir, ob man nicht "
      "irgendwie den kleinen Ast mit der Schnur daran befestigen koennte.";
  if (present(QUESTFALLE,TP)) return BS(str);

  str="Einer der Zweige hat eine seltsame Einkerbung. Sie sieht irgendwie "
      "unnatuerlich aber dennoch gewollt aus. Du hast den kleinen Ast mit "
      "der Schnur daran befestigt.";
  if (item->checkfalle()) return BS(str);

  str="Einer der Zweige hat eine seltsame Einkerbung. Sie sieht irgendwie "
      "unnatuerlich aber dennoch gewollt aus.";
  return BS(str);  
}

int befestigefkt(string str) {
  object item,ob;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (item->checkfalle()) return 0;
  if (item->checkquest()) return 0;
  if (item->checkgebaut()) return 0;
  if (present(QUESTAST,TP) || present(QUESTSCHNUR,TP)) return 0;
  if (!ob=present(QUESTFALLE,TP)) return 0;
  if (deep_present(QUESTGRIFF,TP)) return 0;
  notify_fail("Was moechtest Du woran befestigen?\n");
  if(!str) return 0;
  if(str == "schnur" || str== "ast") {
    notify_fail("Woran moechtest Du das befestigen?\n");
    return 0;
  }
  if(str != "schnur an einkerbung" && str != "ast an einkerbung") return 0;
  write(BS(
    "Du nimmst den kleinen Ast mit der Schnur und befestigst ihn an der "
    "Einkerbung. Vielleicht waere es jetzt moeglich damit und dem Korb "
    "auf dem Boden eine Falle zu basteln?"));
  say(CAP_TPN+" befestigt etwas im Dickicht.\n");
  item->falle();
  ob->remove();
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" befestigt Ast und Schnur.\n" );
  return 1;
}

string fallefkt() {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (!item->checkfalle()) return 0;
  if (present(QUESTAST,TP) || present(QUESTSCHNUR,TP) ||
      present(QUESTFALLE,TP)) return 0;
  if (deep_present(QUESTGRIFF,TP)) return 0;
  if (item->checkgebaut())
    return BS(
      "Du hast eine wundervolle Falle fuer den Wiesel gebaut. Der Wiesel "
      "hockt darin und wird Dich sicher nicht mehr daran hindern, den "
      "Griff zu nehmen.");
  return BS(
    "Du koenntest vielleicht mit dem kleinen Korb, dem Ast und der Schnur "
    "eine wunderbare und gemeine Falle fuer das Wiesel basteln!");
}

string bodenfkt() {
  string str;
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  str="Neben einem kleinen Korb liegt ein kleiner Griff mitten auf dem "
      "Boden. Der Boden selber ist voll mit lauter Zweigen und Aesten.";
  if(!deep_present(QUESTGRIFF,TP)) return BS(str);
  str="Der Boden ist voll mit lauter Zweigen und Aesten. Ein kleiner, "
      "unnuetzer Korb liegt hier herum.";
  if (item->checkfrei()) return BS(str);
  str="Der Boden ist voll mit lauter Zweigen und Aesten. Ein kleiner Korb "
      "steht hier herum. Du hast darin das Wiesel gefangen.";
  return BS(str);  
}

string korbfkt() {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (item->checkfrei())
    return BS(
      "Der Korb liegt jetzt wohl fuer immer unnuetzt auf dem Boden.");
  if (deep_present(QUESTGRIFF,TP) || item->checkgebaut())
    return BS(
      "Der Korb liegt auf dem Boden. Du hast das flinke Wiesel darin "
      "gefangen.");
  if (item->checkfalle())
    return BS(
      "Der Korb liegt umgedreht auf dem Boden. Du koenntest vielleicht aus "
      "ihm, dem Ast und der Schnur eine wunderbare und gemeine Falle fuer "
      "das Wiesel basteln.");
  return BS(
    "Ein umgedrehter Korb liegt auf dem Boden. Neben ihm liegt ein kleiner "
    "Griff quasi greifbar nahe.");
}

string wieselfkt() {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (item->checkfrei())
    return BS(
      "Du hast das Wiesel wieder aus dem Korb befreit und es laeuft im "
      "Dickicht vergnuegt umher.");
  if (present(QUESTGRIFF,TP) || item->checkgebaut())
    return BS(
      "Du hast das Wiesel mit dem Korb gefangen. Es sitzt jetzt darin und "
      "bewegt sich ueberhaupt nicht mehr.");
  return BS(
    "Ein kleines Wiesel huscht hier ueber den Boden. Es ist viel zu schnell, "
    "als dass Du es jemals erwischen koenntest.");
}

string grifffkt() {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (deep_present(QUESTGRIFF,TP))
    return BS("Du hast den Griff doch bei Dir.");
  if (item->checkgebaut()) return BS(
    "Ein wundervoller Griff liegt hier einfach so auf dem Boden. Jetzt wo "
    "der Wiesel gefangen ist, kannst Du ihn sicher auch leicht an Dich "
    "nehmen.");
  return BS(
    "Ein wundervoller Griff liegt hier einfach so auf dem Boden. Waere ja zu "
    "einfach, wenn man ihn einfach so nehmen koennte.");
}

int bastelfkt(string str) {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (!item->checkfalle()) return 0;
  if (item->checkgebaut()) return 0;
  if (item->checkquest()) return 0;
  if (present(QUESTAST,TP) || present(QUESTSCHNUR,TP) ||
      present(QUESTFALLE,TP)) return 0;
  if (deep_present(QUESTGRIFF,TP)) return 0;
  notify_fail("Was moechtest Du denn gerne basteln?\n");
  if(str != "falle") return 0;
  item->gebaut();
  write(BS(
    "Du hebst den Korb ein klein wenig an und steckst den Ast mit der Schnur "
    "unter Spannung darunter. Das Wiesel bemerkt Dein Treiben und kommt "
    "dahergerast. Und es passiert was passieren musste: Du trittst zurueck "
    "und schon kurz darauf rennt das Wiesel voll in die Falle. Der kleine "
    "Ast schnellt zurueck und das Wiesel ist unter dem Korb gefangen."));
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" faengt das Wiesel.\n" );
  return 1;
}

int nimmfkt(string str) {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  notify_fail("WAS nehmen?\n");
  if(!str) return 0;
  notify_fail("Das geht nicht!");
  if(str == "korb") {
    write(BS(
      "Du bist irgendwie der Meinung, der Korb ist noch fuer irgendetwas "
      "zu gebrauchen. Aber nur wenn er auf dem Boden liegen bleibt."));
    return 1;
  }
  if(str == "ast") {
    write(BS("Du kannst den Ast nicht einfach so nehmen."));
    return 1;
  }
  if(str == "schnur") {
    write(BS("Du kannst die Schnur nicht einfach so nehmen."));
    return 1;
  }
  if(str != "griff") return 0;
  if (item->checkquest()) return 0;
  if (deep_present(QUESTGRIFF,TP)) return 0;
  if (!item->checkgebaut()) {
    write(BS(
      "Du versuchst einfach so den Griff zu nehmen. Doch gerade als Du ihn "
      "nehmen willst, huscht ein kleines Wiesel aus dem Unterholz hervor, "
      "schnappt sich den Griff und legt ihn ein kleines Stueck weiter wieder "
      "ab."));
    return 1;
  }
  // quest geschafft, wir loggen mal das nehmen des griffes mit :P
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" bekommt den Griff.\n" );
  item->quest();
  item=clone_object("/d/gebirge/zordan/gjordil/obj/griff");
  item->move(TP, M_SILENT | M_NOCHECK);
  write(BS("Du nimmst den Griff vom Boden an Dich und jubelst."));
  say(CAP_TPN+" nimmt etwas vom Boden an sich.\n");
  return 1;
}

int befreiefkt(string str) {
  object item;
  if (!item=present(QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  if (!item->checkquest()) return 0;
  if (item->checkfrei()) return 0;
  notify_fail("Was moechtest Du gerne befreien?\n");
  if(str != "wiesel") return 0;
  item->frei();
  if(member(kraut,getuid(TP)) != -1) {
    write(BS(
      "Du fasst Dir ein Herz und befreist das Wiesel aus seiner misslichen "
      "Lage wieder. Das Wiesel flitzt einmal um den Korb und schaut Dich "
      "angstvoll an."));
    write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" VERSUCHT eine zweite "
             "Befreiung des Wiesels.\n" );
    return 1;
  }
  
  kraut+=({ getuid(TP) });
  saveload=kraut;
  save_object(QUESTSAVE);
  write(BS(
    "Du fasst Dir ein Herz und befreist das Wiesel aus seiner misslichen "
    "Lage wieder. Das Wiesel flitzt einmal um den Korb und schaut Dich "
    "erst angstvoll an. Dann aber verschwindet es kurz im Dickicht und "
    "kommt mit einem kleinen Kraut wieder, welches Du sofort einsteckst."));
  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" befreit das Wiesel.\n" );
  item=clone_object("/d/dschungel/feyaria/tijara/obj/wunder");
  item->SetProp(P_NODROP,BS("Dank Sengir, der hier in der Quest einen Bug "
    "ausgenutzt und nicht gemeldet hat, darfst Du dieses spezielle "
    "Wunderkraut leider nicht weglegen."));
  item->SetProp(P_NEVERDROP,1);
  item->move(TP, M_SILENT | M_NOCHECK);
  return 1;
}
