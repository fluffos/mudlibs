
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <wizlevels.h>

#include "../def.h"

inherit ROOM "trollraum";

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Huette des Trollhaeuptlings");
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INT_LONG,
  "Du befindest Dich in einer aus Aesten und Blaettern gebauten Huette. Ein "
  "grosser Stein dient hier dem Haeuptling der Trolle als Thron. Obwohl die "
  "Huette auf einfachste Weise zusammengebaut wurde, ist es recht gemuetlich "
  "hier. Im Norden faellt Dir ein kleiner Durchschlupf in der Wand auf mit "
  "einem Schild darueber. Am Boden faellt Dir eine Platte aus Holzbrettern "
  "auf. Der Ausgang der Huette liegt im Westen. ");

  AddDetail( ({ "weise","art" }),
    "Diese Art und Weise ist wirklich die einfachste, die Du bisher gesehen "
    "hast. Zu viel mehr sind Trolle ja auch nicht faehig, da sie viel zu "
    "ungeschickt in sowas sind.");

  AddDetail( ({ "haeuptling" }),
    "Ist er gerade nicht da? Falls doch schau ihn Dir doch an.");

  AddDetail(({"holz","hoelzer","waende","ast","wand","aeste","blaetter"}),
    "Ziemlich primitives Baumaterial, aber zu mehr sind die dummen Trolle "
    "nicht faehig.");

  AddDetail(({"baumaterial","material"}),
    "Aus mehr als Aesten, Blaettern und Hoelzern besteht diese Huette "
    "nicht.");

  AddDetail(({"huette","haus","raum"}),
    "Es ist recht geraeumig und gemuetlich.");

  AddDetail(({"stein","thron","felsbrocken","fels","brocken"}),
    "Ein grosser Felsbrocken als Sitzgelegenheit fuer den Haeuptling.");

  AddDetail("sitzgelegenheit",
    "Manchmal sitzt der Haeuptling hier.");

  AddDetail(({"durchschlupf","loch"}),
    "Ein kleines Loch in der Wand, wo du gerade noch durchpasst. Du siehst "
    "aber nicht, wohin es fuehrt. Ein Schild ist darueber befestigt.");

  AddDetail(({"schild","totenschaedel","schaedel","aexte","hintergrund"}),
    "Es zeigt einen Totenschaedel mit zwei gekreuzten Aexten im "
    "Hintergrund.");

  AddDetail("boden",
    "Am Boden siehst Du eine quadratische Platte aus Holzbohlen.");

  AddDetail(({"platte","bodenplatte","holzplatte"}),
    "Die Platte befindet sich genau unter Dir. Auf einer Seite sind "
    "Scharniere befestigt, auf der anderen Seite ein Eisenring.");

  AddDetail(({"holzbohlen","bohlen","planken","bretter","holzbretter"}),
    "Auf den Holzbohlen siehst Du Einkerbungen, als ob sich hier wer "
    "verzeifelt festgekrallt haette.");

  AddDetail(({"ring","eisenring"}),
    "Du kannst daran ziehen.");

  AddDetail(({"scharniere"}),
    "Die gehoeren wahrscheinlich dazu, um die Holzplatte zu bewegen.");

  AddDetail(({"einkerbung","einkerbungen"}),
    "Sieht so aus, wie wenn sich hier jemand festhalten wollte.");

  AddDetail(({"ausgang"}),
    "Hier kommst Du wieder in das Lager zurueck.");

  AddDetail( ({"seiten","seite"}),
    "Die Seiten der Huette, bestehen aus Holz.");

  AddDetail("decke",
    "Die Decke besteht vorallem aus Aesten und Blaettern, die ein wenig "
    "Schutz geben.");

  AddDetail( ({ "schutz","dank" }),
    "Gott sei Dank gibt es eine Decke hier, die den Raum vor allen "
    "moeglichem schuetzt.");

  AddReadDetail("schild","Schau es Dir einfach mal an.\n");

  AddCmd(({"zieh","ziehe"}),"ziehe");

  AddExit("westen",ROOM "t6");
  AddExit("sueden", ROOM "kapelle");
  AddSpecialExit("norden","schlupfloch");

  AddItem(NPC "chef",  REFRESH_DESTRUCT);
  AddItem(NPC "tussi", REFRESH_DESTRUCT);
  AddItem(NPC "tussi", REFRESH_DESTRUCT);
}

ziehe(str) { 
  notify_fail("Woran willst Du ziehen?\n");
  if ( (str=="ring")||(str=="eisenring")||(str=="an ring")|| 
       (str=="am ring")||(str=="an eisenring")) {
    say(CAP_TPN+" zieht an einem Eisenring am Boden.\n");
    write("Du ziehst an einem Eisenring am Boden.\n");
    falltuer(); 
    return 1;
  }
  return 0;
}

falltuer() { 
  int i;
  object *inv;

  tell_room(ME,
    "Ploetzlich oeffnet sich eine Falltuer am Boden.\n");
  tell_room(ROOM "jail",
    "Eine Falltuer an der Decke oeffnet sich.\n");
  tell_room(ME, BS(
    "Du faellst durch ein Loch im Boden nach unten, wo Du hart auf einem "
    "Steinboden aufschlaegst."));
  inv=all_inventory(ME);
  for (i=0;i<sizeof(inv);i++) {
    if( living(inv[i]) && query_once_interactive(inv[i])) {
      inv[i]->move(ROOM "jail", M_GO, "",
        "faellt durch ein Loch im Boden nach unten",
        "plumpst von der Decke hinunter auf den Boden"); 
    }
  }
  tell_room(ROOM "jail",
    "Die Falltuer an der Decke schliesst sich wieder.\n");
}   

schlupfloch() {
  if(TP->id("Trollspieler")) {
    if(present("haeuptling")) 
      tell_room(ME,break_string(
        "HALT, "+TPN+"! Du darfst nicht nach Norden gehen! Ich verbiete es "
        "Dir einfach!",78,"Der Haeuptling bruellt: "));
    else 
      write(BS(
        "Du weisst genau das dort das Gefaengnis ist und willst dort gar "
        "nicht rein!"));
    return 1;
  }
  write(BS(
    "Huch! Du schluepfst durch das kleine Loch und rutscht durch einen "
    "engen schluepfrigen Tunnel rasant nach unten. Du faellst in einen Raum "
    "wo Du hart auf einem Steinboden aufschlaegst."));
  TP->move(ROOM "jail", M_GO, "",
    "kriecht durch ein Loch in der Wand nach Norden",
    "plumpst von einem Loch in der Decke herein");
  return 1;
}
