
#include "../def.h"

inherit "/std/laden";

#include <properties.h>
#include <language.h>
#include <laden.h>
#include <wizlevels.h>

create() {
  ::create();

  SetStorageRoom( ROOM "laden-store");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer kleinen Hoehle. Ein paar Fackeln "
    "haengen an den Waenden und erhellen sie. Es liegen viele Sachen "
    "herum und im hinteren Teil der Hoehle ist ein kleiner Ladentisch "
    "zu sehen. Durch ein riesiges Loch im Norden kannst Du die Hoehle "
    "wieder verlassen.");
  SetProp( P_INT_SHORT, "Ein Trollhaendler" );

  SetProp(P_HIDE_EXITS, ({ "norden" }) );

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "\n_ulo");
  SetProp(P_SHOPKEEPER_NAME, "Ulo");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "fackeln","fackel" }),
    "Die Fackeln stecken direkt in der Wand und verbreiten genug Licht.");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind aus hartem Felsgestein. In ihnen stecken ein paar "
    "Fackeln und erhellen die Hoehle.");

  AddDetail( ({ "felsgestein","gestein","fels" }),
    "Das ist wirklich sehr sehr harter Fels.");

  AddDetail( ({ "decke" }),
    "Du kannst Du Decke kaum sehen, so hoch ueber Dir ist sie.");

  AddDetail( ({ "boden" }),
    "Auf dem felsigen Boden liegen diverse Sachen herum. Du hast schon "
    "fast Schwierigkeiten, nicht auf etwas draufzutreten.");

  AddDetail( ({ "schwierigkeiten" }),
    "Nur fast. Es geht gerade noch.");

  AddDetail( ({ "teil" }),
    "Im hinteren Teil der Hoehle ist ein Ladentisch und im vorderen "
    "Teil liegen viele Sachen herum.");

  AddDetail( ({ "ladentisch","tisch" }),
    "Der Ladentisch dient dem Haendler wohl, seine Geschaefte zu erledigen. "
    "Auf ihm liegt eine kleine Anleitung.");

  AddDetail( ({ "anleitung" }),
    "Du kannst sie lesen.");

  AddDetail( ({ "haendler","ulo" }),
    "Ist Ulo gerade nicht da?");

  AddDetail( ({ "geschaefte" }),
    "Wie man an der Abnutzung des Tisches sehen kann, gehen die Geschaefte "
    "hier wohl wirklich sehr gut.");

  AddDetail( ({ "abnutzung" }),
    "Der Ladentisch ist schon sehr abgenutzt.");

  AddDetail( ({ "sachen","waffen","ruestungen" }),
    "Diverse Sachen liegen ueberall herum. Waffen, Ruestungen und "
    "verschiedene, meist nuetzliche Sachen sind das. Wenn Du mehr darueber "
    "erfahren willst, dann frag doch mal Ulo.");

  AddDetail( ({ "licht" }),
    "Das Licht der Fackeln scheint hell in die Hoehle.");

  AddDetail( ({ "loch" }),
    "Durch das wirklich riesige Loch im Norden kannst Du die Hoehle wieder "
    "verlassen.");

  AddReadDetail( "anleitung" ,
"Du kannst hier folgende Dinge tun:\n"
"<zeige>             Gibt eine Uebersicht ueber das Angebot.\n"
"<zeige> rue|ver|waf Uebersicht ueber Ruestungen/Verschiedenes/Waffen.\n"
"<unt> nummer        Gibt eine Beschreibung eines Gegenstands aus.\n"
"<kaufe> nummer|name Du kaufst einen bestimmten Gegenstand.\n"
"<verkaufe> etwas    Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
"<verkaufe> alles    Du verkaufst alles was Du nicht traegt oder auf \n"
"                    <behalte> gesetzt hast ( siehe 'hilfe behalte' ).\n"
"<versetze> etwas    Du verkaufst einen Gegenstand, egal wieviel der\n"
"                    Haendler dafuer bezahlt.\n"
"<schaetz> etwas     Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
"                    wert waere, wenn Du ihn verkaufen wuerdest.\n");

  AddSound( DEFAULT_SOUND,
    "Ein paar der Sachen schlagen aneinander.");
    
  AddSound( ({ "sachen","sache","geraeusche","geraeusch","menge" }),
    "Sie klingeln, rascheln, und machen noch jede Menge anderer Geraeusche.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nicht sehr arg nach den Trollen. Die herumliegenden "
    "Sachen verbreiten einen unangenehmen Gestank.");

  AddSmell( ({"troll","trolle"}) ,
    "Die anderen Rassen meinen, Trolle stinken. Sie selber meinen das "
    "natuerlich genau umgekehrt.");

  AddSmell( "sachen",
    "Die Sachen riechen alt und abgestanden.");

  AddSmell( "gestank",
    "Der Gestank ist wirklich kaum auszuhalten.");

  AddItem( NPC "ulo", REFRESH_DESTRUCT);
  //AddItem( "/d/ebene/obj/div/teddyautomat", REFRESH_REMOVE);

  AddExit( "nordoben", "./t4");
  AddExit( "norden", "./t4");
}

nosave int checkrace() {
  object ob;
  if (TP->QueryProp(P_RACE) == "Troll") return 1;
  if (ob=present("\n_ulo",ME)) {
    notify_fail(BS(
      "Ulo schaut Dich mit boesen Augen an und schreit: 'Mit Dir mache ich "
      "doch keine Geschaefte!' und greift Dich sogleich an!"));
    tell_room(ME,BS(sprintf(
      "Ulo schaut %s mit boesen Augen an und schreit: 'Mit Dir mache ich "
      "doch keine Geschaefte!' und greift %s sogleich an!",
      TP->name(WER),TP->QueryPronoun(WEN))), ({ TP }));
    if (!IS_WIZARD(TP)) ob->Kill(TP);
    return 0;
  }
  notify_fail("Ulo ist leider nicht da!\n");
  return 0;
}

buy(string str) {
  if (checkrace(TP)) return ::buy(str);
  return 0;
}

sell(string str, int f) {
  if (checkrace(TP)) return ::sell(str,f);
  return 0;
}

force_sell(string str) {
  if (checkrace(TP)) return ::force_sell(str);
  return 0;
}
