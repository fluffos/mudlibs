
#include <moving.h>
#include <properties.h>
#include "def.h"

inherit ROOM "trollraum";

int trolle, trollwaechter, is_long;

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"In der Trollagerzentrale.");
  SetProp(P_INT_LONG,
	  "Du bist in der Zentrale des Trollagers, hier kannst Du alles "
          "ueberwachen. Kommandos: alle, player");
 
  AddCmd( "player", "lager");
  AddCmd( "alle", "lager2");

  AddExit("lager", ROOM("entr"));
}

lager() { 
  int i;

  trolle=0;
  trollwaechter=0;

  write("------------------------------------------\n");
  write("Im Trollager befinden sich im Augenblick :\n");
  write("------------------------------------------\n");

  for(i=sizeof(ROOMS); i; i--) {
    call_other(ROOM(ROOMS[i-1]), "");
    listeauf(ROOM(ROOMS[i-1]));
  }

  if(trolle==1) 
    write("  Ein armseliger Troll.\n");
  if(trolle>1)
    write("  "+trolle+" Trolle.\n");
  if(trollwaechter==1)
    write("  Ein Trollwaechter.\n");
  if(trollwaechter>1)
    write("  "+trollwaechter+" Trollwaechter.\n");
  return "";
}

varargs
listeauf(string raum) {
  int i,j;
  int *var;
  object *inv;
  string text,player;
  string *leer;
  object loc;

  var=allocate(4);
  leer=allocate(4);
  text=""; is_long=0;

  inv=all_inventory(find_object(raum));

  for(i=0;i<sizeof(inv);i++) {
    if(living(inv[i])) {
      if( (inv[i]->QueryProp(P_RACE)=="Troll") && 
	  (!inv[i]->id("schlaechter")) )
	if(inv[i]->id("trollwaechter"))
	  trollwaechter++;
	else {
	  if(!inv[i]->id("schlaechter"))
	    trolle++;
	}
	else {
          var[0]=inv[i]->QueryProp(P_HP);
      	  var[1]=inv[i]->QueryProp(P_MAX_HP);
	  var[2]=inv[i]->QueryProp(P_SP);
	  var[3]=inv[i]->QueryProp(P_MAX_SP);
	  loc=environment(inv[i]);
          player=CAP(inv[i]->name(WER,0));
          while (strlen(player)<20) 
            player+=" ";
	  
	  for(j=0;j<4;j++) 
            leer[j]="";

          for(j=0;j<4;j++) {
            if( var[j] < 100 ) leer[j]=" ";
            if( var[j] <  10 ) leer[j]="  ";
	  }

          text=player+":  HP: ";
          for(j=0;j<4;j++) {
	    text+=leer[j];
            text+=var[j];

	    if(j==1)
	      text+=" --- MP: ";
            else
	      if( j<3 ) text+=" / ";
          }
	  text+="\n -> ";
	  text+=sprintf("%O",loc);
	  write(text+"\n");
        } // else
    }
  }   
}

lager2() { 
  int i;

  trolle=0;
  trollwaechter=0;

  write("------------------------------------------\n");
  write("Im Trollager befinden sich im Augenblick :\n");
  write("------------------------------------------\n");

  for(i=sizeof(ROOMS); i; i--) { // jeden raum auflisten
    //say("ROOM: "+ROOM(ROOMS[i-1]));
    call_other(ROOM(ROOMS[i-1]), "");
    listeauf2(ROOM(ROOMS[i-1]));
  }

  return "";
}

varargs
listeauf2(string raum) {
  int i,j;
  int *var;
  object *inv;
  string text,player;
  string *leer;
  object loc;

  var=allocate(4);
  leer=allocate(4);
  text=""; is_long=0;

  inv=all_inventory(find_object(raum));

  for(i=0;i<sizeof(inv);i++) {
    if(living(inv[i])) {
          var[0]=inv[i]->QueryProp(P_HP);
      	  var[1]=inv[i]->QueryProp(P_MAX_HP);
	  var[2]=inv[i]->QueryProp(P_SP);
	  var[3]=inv[i]->QueryProp(P_MAX_SP);
	  loc=environment(inv[i]);
          player=CAP(inv[i]->name(WER,0));
          while (strlen(player)<20) 
            player+=" ";
	  
	  for(j=0;j<4;j++) 
            leer[j]="";

          for(j=0;j<4;j++) {
            if( var[j] < 100 ) leer[j]=" ";
            if( var[j] <  10 ) leer[j]="  ";
	  }

          text=player+":  HP: ";
          for(j=0;j<4;j++) {
	    text+=leer[j];
            text+=var[j];

	    if(j==1)
	      text+=" --- MP: ";
            else
	      if( j<3 ) text+=" / ";
          }
	  text+="\n -> ";
	  text+=sprintf("%O",loc);
	  write(text+"\n");
    }
  }   
}
