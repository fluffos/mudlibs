
#include <properties.h>
#include <defines.h>
#include <exploration.h>

#include "../def.h"

inherit ROOM "trollraum";

int *flagarr;
object *untarr;

create() {
  ::create();
  flagarr=({});
  untarr=({});

  SetProp(P_LIGHT,0);
  SetProp(P_INT_SHORT,"Die Schatzkammer der Trolle");
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INT_LONG,
    "Ein geraeumiger Raum am Ende der Hoehle. Hier haeufen die Trolle "
    "ihre Beute an. Die Blutspuren und Knochen deuten allerdings darauf "
    "hin, dass hier schon etliche Abenteurer ihre Habgier mit dem Leben "
    "bezahlt haben.");

  AddDetail( ({ "leben","preis" }),
    "Das Leben zu verlieren ist ein hoher Preis. Sicher ist er auch Dir "
    "viel zu hoch.");

  AddDetail( ({ "habgier" }),
    "Sie darf niemals zu gross werden, sonst stirbt man vorzeitig.");

  AddDetail( ({ "ende" }),
    "Du bist am Ende der Hoehle angekommen. Hier geht es definitiv nicht "
    "weiter.");

  AddDetail(({"hoehle","raum","fels","stein"}),
    "Hier ist es sehr finster und unheimlich, sei froh, dass Du eine "
    "Lichtquelle hast.");

  AddDetail( ({ "feuer" }),
    "Das Feuer ist draussen. Hoffentlich endest nicht gerade Du darauf.");

  AddDetail(({"schatz","beute","schicksal"}),
    "Die ehemaligen Besitzer dieser Gegenstaende wurden aufgespiesst und "
    "ueber dem Feuer gegrillt. Pass auf, dass Dich nicht dasselbe "
    "Schicksal ereilt!");

  AddDetail(({"spuren","blutspuren","knochen"}),
    "Hoffentlich endest Du nicht auch so.");

  AddDetail( "besitzer",
    "Die wirst du wohl kaum kennen ...");

  AddDetail( "himmel",
    "Du bist in einer Hoehle, hier siehst du keinen Himmel.");

  AddDetail( "lichtquelle",
    "Deine Lichtquelle hilft Dir Dich in dieser finsteren Hoehle zu "
    "orientieren.");

  AddDetail( ({ "gegenstaende","zeit" }),
    "Der gesamte Schatz der Trolle besteht aus Gegenstaenden, die mit der "
    "Zeit zusammengetragen wurden.");

  AddDetail( "decke",
    "Die Decke der Hoehle ist hoch oben, von hier kannst Du nicht mehr "
    "erkennen.");

  AddExit("osten", "./cave");

  AddCmd( ({"nimm","steck","stecke","gib",
            "gebe","geb","nehm","nehme",
            "leg","lege" }),"alarm");
  AddCmd( ({"schau","unt","untersuche",
            "untersuch","schaue","betrachte"}), "uwand");  

  AddItem ("/obj/gems/rubin", REFRESH_DESTRUCT);
  AddItem ("/obj/gems/rubin", REFRESH_DESTRUCT);
  AddItem ("/obj/gems/turmalin", REFRESH_DESTRUCT);
  AddItem ("/obj/gems/turmalin", REFRESH_DESTRUCT);
  AddItem ("/obj/gems/diamant", REFRESH_DESTRUCT);
  AddItem ("/obj/gems/diamant", REFRESH_DESTRUCT);
}

reset() {
  flagarr=({});
  untarr=({});
  ::reset();
}

uwand(str) {
/*
  wand geht immer

bit: aktion
  0: wand
  1: spalten
  2: objekt
  3: figur
  4: blutflecken
  5: zeichnungen
  6: gebilde
  7: bild
  8: rechteck

*/

  switch(str) {
    case "waende":
    case "wand":
      write(BS(
        "An der Wand entdeckst Du einige Spalten, Ritzen und viele "
	"Blutflecken."));
      setflag(0x00000001);
      break;
    case "spalten":
    case "ritzen":
      if(testflag(0x00000001)) {
	write(BS(
	  "In den Spalten entdeckst Du ein glitzerndes Objekt."));
        setflag(0x00000002);
      }
      else return 0;
      break;
    case "objekt":
    case "glitzern":
      if(testflag(0x00000002)) {
	write(BS(
	  "Es sieht aus wie eine kleine, schimmernde Figur."));
        setflag(0x00000004);
      }
      else return 0;
      break;
    case "figur":
    case "haeuptling":
    case "trollhaeuptling":
    case "schimmern":
      if(testflag(0x00000004)) {
	write(BS(
	  "Die Figur stellt den Trollhaeuptling dar, sie ist in den Stein "+
	  "hineingelassen."));
	setflag(0x00000008);
      }
      else return 0;
      break;
    case "blutflecken":
    case "flecken":
    case "blut":
      if(testflag(0x00000001)) {
	write(BS(
	  "Die Blutflecken sehen aus wie Zeichnungen aus laengst vergangener "+
	  "Zeit."));
	setflag(0x00000010);
      }
      else return 0;
      break;
    case "zeichnung":
    case "zeichnungen":
      if(testflag(0x00000010)) {
	write(BS(
	  "Die Zeichnungen stellen eine Art rechteckiges Gebilde dar."));
	setflag(0x00000020);
      }
      else return 0;
      break;
    case "gebilde":
      if(testflag(0x00000020)) {
	write(BS(
	  "Du glaubst ein Bild in dem rechteckigen Gebilde zu erkennen."));
	setflag(0x00000040);
      }
      else return 0;
      break;
    case "bild":
      if(testflag(0x00000040)) {
	write(BS(
	  "Du hast Dich getaeuscht, und kannst doch nichts erkennen, "+
	  "ausser einem Rechteck."));
	setflag(0x00000080);
      }
      else return 0;
      break;
    case "rechteck":
      if(testflag(0x00000020)) {
        if(testflag(0x000000FF)) {
	  guatGschaut(); 
          EPMASTER->GiveExplorationPoint("rechteck", EP_MISC);
	}
	else write(BS(
          "Hm, wahrscheinlich hast Du doch nicht genau genug geschaut."));
      } else return 0;
      break;
    default: return 0;
  }
  return 1;
}

alarm() {
  if (!interactive(TP)) return;
  call_other(ROOM "entr", "alarm", CAP_TPN+" raubt unsere Schatzkammer aus");
  return 0;
}

guatGschaut() {
  object *inv;
  int i;
  
  for(i=sizeof(inv=all_inventory(TP)); i;) {
    i--;
    if(inv[i]->ichBinDerTrollschluessel()) {
      CLONE( OBJ "szepter", TP);
      alarm();
      inv[i]->remove();
      write(BS(
	"Du oeffnest mit dem Trollschluessel ein hinter dem Rechteck "
	"verborgenes, kleines Tuerchen, und findest ein Szepter. Als Du "
	"das Tuerchen wieder zuwirfst, verschwindet Dein Schluessel."));
      say(BS(
	CAP_TPN+" oeffnet ein verborgenes Tuerchen und "
	"nimmt einen Gegenstand zu sich."));
      return;
    }
  }
  write(BS(
    "Du fuehlst, dass Dir ein Gegenstand fehlt...vielleicht ein Schluessel?\n"));
}

int testflag(int flag) {
  int i;

  if(i=member(untarr, TP) == -1) i=0;
  else
    i=flagarr[i];
  return flag & i;
}

setflag(int flag) {
  int i;

  i=member(untarr, TP);
  if( i == -1 ) {
    untarr+=({ TP });
    flagarr+=({flag});
  }
  else {
    flagarr[i] |= flag;
  }
}
