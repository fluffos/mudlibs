
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "../def.h"

inherit ROOM "trollraum";

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im Trollager");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18]) );
  SetProp(P_INT_LONG,
    "Du stehst inmitten des Trollagers. Der Ausgang liegt im Nordwesten, im "
    "Suedwesten siehst Du einen hohen Baum und im Osten siehst Du ein "
    "Holzfeuer, auf dem gerade etwas gegrillt wird. Nach Sueden geht es "
    "noch tiefer in das von Felsen umringte Lager hinein und im Norden "
    "steht eine kleine, verkommene Huette.");

  AddDetail("huette",
    "Die Huette ist ziemlich runtergekommen. Du kannst sie einfach nach "
    "Norden betreten.");

  AddDetail("ausgang",
    "Ausgang? Hmm.. Vielleicht der Weg hinaus?");

  AddDetail("weg",
    "Du stehst auf einer Kreuzung.");

  AddDetail("kreuzung",
    "Du gelangst hier im Osten zur Feuerstelle, im Sueden und Suedwesten "
    "weiter in das Lager hinein und nach Nordosten Richtung Ausgang.");

  AddDetail(({"feuer","holzfeuer"}),
    "Eine Feuerstelle mit einem Bratspiess darueber fuer Abenteurer wie "
    "Dich.");

  AddDetail("baum",
    "Ein hoher Baum, an dem eine Strickleiter befestigt ist.");

  AddDetail(({"fels","felsen"}),
    "Sie ragen steil auf allen Seiten des Lagers empor, und sind "
    "unmoeglich zu besteigen.");

  AddDetail( ({"leiter","strickleiter"}) ,
    "Die Leiter befindet sich suedwestlich von hier, und ist an der Eiche "
    "festgeknotet.");

  AddDetail( ({ "eiche" }),
    "Die Eiche ueberstrahlt das ganze Trollager. Gewalltig ist sie in den "
    "Himmel gewachsen.");

  AddDetail( ({"feuerstelle","stelle","feuer"}),
    "Ueber dem Holzfeuer im Osten haengt ein Bratspiess.");

  AddDetail( ({"bratspiess","spiess","braten"}),
    "Der Bratspiess ist im Osten. Er duftet bis hier her.");

  AddSound (DEFAULT_SOUND,
    "Du hoerst das Bruzeln des Feuers von Osten.");

  AddSound ("bruzeln",
    "Naja es bruzelt halt. Vielleicht kannst Du etwas riechen..");

  AddSmell ( DEFAULT_SMELL,
    "Vom Osten her riechst du den Duft von gebratenen Fleisch.");

  AddSmell ( ({"braten","fleisch","duft"}),
    "Der Braten riecht hervorragend. Vielleicht solltest Du mal hingehen.");

  AddExit("nordwesten", "./t1");
  AddExit("suedwesten", "./t4");
  AddExit("osten",      "./spiess");
  AddExit("sueden",     "./t5");
//  AddExit("norden",     "./trollgilde");
  AddExit("norden",     "/gilden/abenteurer/trollgilde");

  AddItem(NPC "grille", REFRESH_DESTRUCT);

  AddCmd( ({ "bahn","bahne" }) , "bahnefkt" );

}

int bahnefkt(string str) {
  object item;
  if (!item=present( QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  notify_fail("Was moechtest Du Dir wohin bahnen?\n");
  if (str == "weg") {
    notify_fail("Wohin moechtest Du Dir einen Weg bahnen?\n");
    return 0;
  }
  if (str == "weg in unterholz" || str == "weg nach unterholz" ||
      str == "weg zu funkeln" || str == "weg zum unterholz" ||
      str == "weg ins unterholz" || str == "weg zum funkeln") {
    write(BS(
      "Du versuchst Dir einen Weg ins Unterholz zu bahnen. Mit viel Muehe "
      "und Not gelingt es Dir dann schliesslich."));
    TP->move(ROOM "versteck", M_GO, "",
      "windet sich durch das Unterholz",
      "bahnt sich einen Weg herein");
    return 1;
  }
  return 0;
}
