
#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

create () { 
  ::create();
  AddCmd( ({ "ergib","ergebe","ergeb" }), "ergeben");

  AddDetail("himmel",
    "Der Himmel erstrahlt in tiefstem Blau.");

  AddDetail( ({"boden","weg"}),
    "Am Boden liegen viele Knochen von verstorbenen Abenteurern herum.");

  AddDetail(({"abenteurer","abenteurern"}),
    "Kennst Du bestimmt nicht ...");

  AddDetail( ({"knochen","teil","knochenteil"}),
    "Naja, halt Knochen: Arme, Beine, Koepfe und sonstige Knochen, ...");

  AddDetail( ({"arme","arm","beine","bein","kopf","koepfe"}),
    "Der Knochenteil stammt sicher von einem armen Hund."); 

  AddDetail( ({ "hund" }),
    "Von dem ist nichts mehr uebrig.");

  AddDetail( ({"trollager","lager"}),
    "Ja, genau. Du bist im Trollager.");

  AddDetail( "blau",
    "So ein schoenes Blau, Du hoffst, es noch lange betrachten zu koennen.");

  AddDetail( ({"seiten","seite"}),
    "Die Felswaende ragen hoch, fast bis in den Himmel.");

  AddDetail( ({ "felswaende","waende","felswand" }),
    "Gigantische Felswaende bohren sich in den Himmel. Du wirst kaum eine "
    "der Waende erklimmen koennen.");

  AddDetail( "trolle",
    "Die Trolle sind toedlich und sehr gefaehrlich.");

  AddSound (DEFAULT_SOUND,
    "Du hoerst nur seltsame Geraeusche von den Trollen.");

  AddSound ( ({"geraeusche","troll","trolle","trollen" }) ,
    "Die Trolle machen fuerchterlichen Laerm, Dir wird ganz angst und bange.");

  AddSound( "laerm",
    "Der Laerm ist fast unertraeglich, furchtbar diese Geraeusche.");

  AddSmell ( DEFAULT_SMELL,
    "Es stinkt nach Troll.");
}

ergeben() { 
  if (ENV(TP)==find_object(ROOM "jail" )) {
    write(BS(
      "Du bist ja schon im Gefaengnis."));
    return 1; 
  }
  write(
    "Du bruellst: Ich ergebe mich!\n"+
    BS(
    "Sofort eilt ein starker Troll herbei, nimmt Dich gefangen und "
    "schmeisst Dich ins Gefaengnis."));
  say(CAP_TPN+" bruellt: Ich ergebe mich!\n");
  TP->move(ROOM "jail", M_TPORT, "",
    "wird von einem Troll gefangengenommen und davongeschleppt",
    "wird ins Gefaengnis geschmissen");
  return 1;
}

NotifyPlayerDeath(object spieler, object killa, int EP) {
  object ob; 

  tell_room(ENV(killa), 
    "Ein Troll ruft: Ich hol schon die Leiche!\n");
  ob=first_inventory(environment(killa));
//  say(sprintf("Object: %O\n",ob));
  if( !living(ob) ) {
    if ( ob->move(ROOM "tres", M_SILENT) ) {
      tell_room(ENV(killa), BS(
        "Ein kleiner Troll schleppt die Leiche von "+spieler->name(WER,1)+
        " davon."));
      tell_room(ROOM "tres", BS(
	"Ein kleiner Troll schleppt die Leiche von "+spieler->name(WER,1)+
        " herein, und wirft sie in eine Ecke."));
      if(spieler->QueryProp(P_LEVEL)>10)
        call_other(ROOM "spiess","opfer",spieler->name(WER,1),EP);
    }
  }
}
