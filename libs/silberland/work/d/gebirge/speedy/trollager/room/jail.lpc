
#include <properties.h>
#include <language.h>
#include "../def.h"

#define OFFEN 1
#define ZU 0
#define VORHANDEN 1
#define FORT 0

#define is_member(xx, x) (member(xx, x) != -1)

inherit ROOM "trollraum";

string stuer;
int tuer, lade, muschel;
object *hatmuschel;

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im Trollager");
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "entsetzen" }),
    "Du denkst . o O (Warum gerade ich???)");

  AddDetail(({"spiess","bratspiess","feuer","holzfeuer","braten",
              "feuerstelle"}),
    "Wenn Du nicht bald aus diesem Gefaengnis rauskommst, wirst Du mal dort "
    "enden.");

  AddDetail(({"bank","schlachtbank","schlaege","schlag"}),
    "Die Schlachtbank ist aus massiven Holz gebaut und kann wuchtige "
    "Schlaege aushalten. Sie ist mit Einkerbungen uebersaet und voller "
    "Blutflecken und Knochensplitter. Auf einer Seite befindet sich eine "
    "kleine Schublade.");

  AddDetail(({"gefaengnis","raum"}),
    "Das Gefaengnis ist einfach in einen Felsen gehauen und ist ein "
    "ungemuetlicher Ort.");

  AddDetail(({"einhoehlung","felsen","wand","fels","ort","waende"}),
    "Es wurde eine Einhoehlung in den Felsen geschlagen, die gross genug "
    "ist um Gefangene darin zu lagern.");

  AddDetail( ({ "insassen","insasse" }),
    "Du bist wohl leider einer von ihnen. :(");

  AddDetail( ({ "gefangene" }),
    "Die werden hier gehalten und gelagert.");

  AddDetail(({"eingang","tuer","gefaengnistuer"}),
    "Das ist eine massive Gefaengnistuer bestehend aus Eisenstaeben.");

  AddDetail(({"eisenstaebe","staebe","eisen"}),
    "Die Eisenstaebe sind ca. 5 cm dick, da gibt es keine Moeglichkeit "
    "auszubrechen.");

  AddDetail("moeglichkeit",
    "Die Moeglichkeit hier auszubrechen ist sehr gering. ");

  AddDetail(({"ecke",""}),
    "In der Ecke steht eine grosse Schlachtbank.");

  AddDetail(({"eichenholz","holz"}),
    "Die Schlachtbank besteht aus diesem Material, sehr schoen ...");

  AddDetail(({"decke","falltuer"}),
    "Die Falltuere ist geschlossen.");

  AddDetail(({"boden"}),
    "Der Boden ist dreckig und man findet vereinzelte Blutflecken.");

  AddDetail(({"dreck","blut","blutflecken","flecken","knochensplitter",
              "splitter"}),
    "Ujee, ... stammt wahrscheinlicht von anderen Abenteurern.");

  AddDetail( ({"einkerbungen","kerben"}),
    "Die stammen bestimmt von der Axt des Schlaechters.");

  AddDetail( ({ "schlaechter" }),
    "Der Schlaechter koepft, wenn er anwesend ist, hier ohne Gnade jeden "
    "Gefangenen.");

  AddDetail( ({ "gnade" }),
    "Die kennt der Schlaechter nicht.");

  AddDetail( ({ "axt" }),
    "Das muss eine gigantische Axt sein!");

  AddDetail( "material",
    "Wie gesagt: schoenes Eichenholz.");

  AddDetail( ({ "anblick" }),
    "Der Anblick ist wirklich furchterregend.");

  AddSpecialDetail( ({"lade","schublade"}), "schublade");
  AddSpecialDetail( ({"muschel"}),          "muschel");

  AddCmd(({"schliesse","schliess"}),"schliesse");
  AddCmd("oeffne","oeffne");
  AddCmd(({"sperr","sperre","mach"}),"tuersyntax");
  AddCmd("nimm", "nehmen");

  AddItem(NPC "schlaechter", REFRESH_DESTRUCT);
  AddItem(NPC "gefangener", REFRESH_DESTRUCT);
  AddItem(NPC "gefangener", REFRESH_DESTRUCT);
  AddItem(NPC "gefangener", REFRESH_DESTRUCT);

  lade = ZU;
  hatmuschel = ({});
  tuer = ZU;
  inituer();
}

reset() {
  ::reset();
  lade=ZU;
  hatmuschel = ({});
}

muschel() {
  if(lade==ZU) return;
  if(is_member(hatmuschel, TP))
    return BS("Wo soll hier eine Muschel sein?");
  else
    return BS("Die Muschel liegt in der Schublade.");
}

schublade() { 
  if(lade==ZU)
    write("Die Schublade ist geschlossen.\n");
  else
    if(is_member(hatmuschel, TP))
      write("Die Schublade ist leer.\n");
    else
      write("In der Schublade befindet sich eine Muschel.\n");
  return "";
}

nehmen(str) { 
  object *inv;
  int i;

  if (!str) return;
  if ((str=="muschel") || (str=="muschel aus lade") || 
     (str=="muschel aus schublade")) {
    if ((lade==OFFEN)) {
      if(is_member(hatmuschel, TP)) return 0;
      else {
	hatmuschel += ({ TP });
	for(i=sizeof(inv=deep_inventory(TP)); i;) {
	  i--;
	  if(inv[i]->ichBinEineMuschel()) {
	    write(BS(
	     "Du nimmst eine zweite Muschel.\nPloetzlich sagt die erste "
	     "Muschel: Meine Frau! Die beiden Muscheln sinken sich in die "
	     "Arme, und fliegen davon!"));
	    inv[i]->remove();
	    say(BS(
	      CAP_TPN+" nimmt eine Muschel. Ploetzlich "
	      "fliegen zwei Muscheln davon."));
	    return 1;
	  }
	}
	CLONE(OBJ "muschel", TP);
	write("Du nimmst die Muschel aus der Schublade.\n");
	say(CAP_TPN+" nimmt eine Muschel.\n");
	return 1; 
      }
    }
  }
  return 0;
}

inituer() {
  if(tuer==ZU)
    stuer="Die Gefaengnistuer ist fest verschlossen.\n";
  else   
    stuer="Die Gefaengnistuer ist offen!\n";
  schau();
}

schau() { 
  SetProp(P_INT_LONG, BS(
   "Du stellst mit Entsetzen fest, dass du im Gefaengnis der Trolle "
   "eingesperrt bist. Das Gefaengnis ist eine kleine Einhoehlung im Felsen, "
   "an dessen Eingang sich eine sehr solide Tuere aus Eisenstaeben befindet. "
   "Dahinter siehst Du eine Feuerstelle mit einem Bratspiess, wo die "
   "Insassen dieses Gefaengnisses wohl meistens enden. In einer Ecke "
   "dieses Raumes befindet sich eine Schlachtbank aus massiven Eichenholz, "
   "deren Anblick nicht sehr beruhigend auf Dich wirkt. An der Decke siehst "
   "Du noch eine kleine Falltuer. "+stuer));
}

oeffne(str) {
  notify_fail("Was willst Du oeffnen?.\n");
  if ((str=="lade") || (str=="schublade")) {
    if (lade==ZU) {
      write("Du oeffnest die Schublade.\n");
      say(CAP_TPN+" oeffnet eine Schublade.\n");
      lade=OFFEN;
    } else write("Die Schublade ist ja schon offen.\n");
    return 1;
  }
  if ((str=="gefaengnistuer")||(str=="gefaengnis")||(str=="tuer 2")) {
    if (tuer==ZU)
      write(BS(
        "So sehr Du Dich auch anstrengst, diese Tuer laesst sich leider"
        "nur von aussen oeffnen."));
    else write("Die Tuere ist doch schon offen!\n");
    return 1;
  }
  if ((str=="tuer")||(str=="tuer 1")||(str=="falltuer")||(str=="holztuer")) {
    write("Du betaetigst einen kleinen Riegel an der Falltuer.\n");
    say(CAP_TPN+" betaetigt einen kleinen Riegel an der Falltuer.\n"); 
    call_other(ROOM "boss","falltuer");
    return 1;
  }
  return 0;
}

schliesse(str) { 
  notify_fail("Du kannst hier hoechstens Tueren schliessen!\n");
  if ((str=="lade")||(str=="schublade")) {
    if (lade==OFFEN) {
      write("Du schliesst die Schublade.\n");
      say(CAP_TPN+" schliesst eine Schublade.\n");
      lade=ZU;
    } else write("Die Schublade ist ja schon geschlossen.\n"); 
    return 1;
  }
  if ((str=="tuer") || (str=="tuere") || (str=="gefaengnistuer")) {
    if (tuer==OFFEN) {
      say(CAP_TPN+" schliesst die Gefaengnistuer von innen.\n");
      write("Du schliesst die Gefaengnistuer.\n");
      tuerzu();
    } else write("Die Tuere ist doch schon geschlossen!\n");
   return 1;
  }
  return 0;
}  

tuersyntax() { 
  write("Du kannst von hier aus nur die Tuere schliessen!\n");
  return 1;
}

tuerzu() { 
  RemoveExit("westen");
  tuer=ZU;
  call_other(ROOM "spiess","exttuerzu");
  inituer();
}

exttuerauf() { 
  AddExit("westen",ROOM "spiess");
  tuer=OFFEN;
  tell_room(ME,
    "Die Gefaengnistuer wird von aussen geoeffnet. Du bist befreit!\n");
  inituer();
}

exttuerzu() { 
  RemoveExit("westen");
  tuer=ZU;
  tell_room(ME,
    "Die Gefaengnistuer wird von aussen geschlossen.\n");
  inituer();
}
