
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

inherit ROOM "trollraum";

int alert;

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Eingang zum Trollager");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18]) );
  SetProp(P_INT_LONG,
    "Du befindest Dich am Eingang zum Trollager. Das Lager ist auf einer "
    "Lichtung errichtet, die von Felsen umgeben ist. Dich ueberkommt ein "
    "beklemmendes Gefuehl als Du erkennst, dass dieses Felsenportal der "
    "einzige Ausweg aus dem Lager ist. Du solltest hier lieber vorsichtig "
    "sein angesichts der herumliegenden und abgenagten Knochen "
    "verstorbener Abenteurer.");

  AddDetail( ({ "gefuehl" }),
    "Das ist ein wirklich beklemmendes Gefuehl.");

  AddDetail(({"fels","felsen","felswaende","waende"}),
    "Sie ragen steil auf allen Seiten des Lagers empor und sind "
    "unmoeglich zu besteigen.");

  AddDetail(({"felsenportal","portal","durchgang"}),
    "Ein schmaler Durchgang zwischen den Felsen.");

  AddDetail("knochen",
    "Sie sind sauber abgenagt.");

  AddDetail( "lichtung",
    "Eine schoene, grosse, gruene Lichtung.");

  AddDetail( ({"ausweg","ausgang"}),
    "Der Ausweg liegt im Westen, also wenn Du feig bist, hau bloss ab von "
    "hier.");

  AddDetail( "eingang",
    "Der Eingang des Lagers liegt hier, nach Osten kommst du tiefer ins "
    "Lager hinein.");

  AddSpecialExit("westen","rausda");
  AddSpecialExit("osten","xosten");

  AddItem(NPC "troll2", REFRESH_DESTRUCT);
  AddItem(NPC "troll2", REFRESH_DESTRUCT);

  alert=NO;
}

xosten() {
  if (TP->QueryProp(P_GHOST) && TP->QueryProp(P_RACE) != "Troll") {
    write(BS(
      "Als Geist brauchst Du nicht ins Trollager zu gehen. Die Trolle "
      "moegen keine Geister ..."));
    return 1;
  }
  if (TP->QueryGuest()) {
    write(BS(
      "Gaeste haben bei den Trollen nichts zu suchen. Die Trolle moegen keine "
      "Gaeste oder besser gesagt: Sie wuerden Dich sofort auffressen."));
    return 1;
  }
  TP->move(ROOM "t1", M_GO, "", "geht nach Osten");
  return 1;
}

alarm(string art) { 
  string meldung;
  int i;
  object ob;

  if (alert==YES) return;
  alert=YES;
  for(i = strlen(art)-1; i >= 0; --i) 
    art[i..i] = capitalize(art[i..i]);
  domainshout("Die Trollwache ruft: "+art+"! ALAAARM!!\n", "gebirge");
  call_out("stopp", 901);
  tell_room(ME, BS(
    "Sechs Trollwaechter huepfen ploetzlich von einem Felsvorsprung herab!"));
  clone_object(NPC "wache")->move(ME, M_SILENT | M_TPORT);
  clone_object(NPC "wache")->move(ME, M_SILENT | M_TPORT);
  clone_object(NPC "wache")->move(ME, M_SILENT | M_TPORT);
  clone_object(NPC "wache")->move(ME, M_SILENT | M_TPORT);
  clone_object(NPC "wache")->move(ME, M_SILENT | M_TPORT);
  clone_object(NPC "wache")->move(ME, M_SILENT | M_TPORT);
}

stopp() { 
  alert=NO;
}

isalert() { 
  return(alert);
}

rausda() { 
  int i;
  object *inv;

  if (TP->QueryProp(P_RACE)!="Troll") {
    if (present("trollwaechter")) {
      write(BS(
        "Der Trollwaechter versperrt Dir den Weg. Der Trollwaechter "
        "schnauzt Dich an: Nee Freundchen, du bleibst schoen da. Du sollst "
        "an unserem Bratspiess enden!"));
      return 1;
    }
  }
  return "/d/gebirge/eros/room/berg_t18";
}

init() {
  ::init();
  if (TP->QueryGuest()) {
    write(BS(
      "Gaeste haben bei den Trollen nichts zu suchen. Die Trolle moegen keine "
      "Gaeste oder besser gesagt: Sie wuerden Dich sofort auffressen."));
    TP->command_me("westen");
  }
}


varargs int PreventInsert(object ob)
{
  if (!ob->id("\nwalker")) return ::PreventInsert(ob);

  if (ob->QueryProp("walker_walking")) ob->Stopwalk();
  else ob->MakeMeWalk("trollager");
  
  return ::PreventInsert(ob);
}