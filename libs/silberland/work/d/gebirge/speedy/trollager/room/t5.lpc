
#include <properties.h>
#include "../def.h"

inherit ROOM "trollraum";

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im Trollager");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18]) );
  SetProp(P_INT_LONG,
    "Du befindest Dich inmitten des Trollagers. Um Dich herum wachsen "
    "ueberall gruene Pflanzen, die inmitten der hohen Berge eine "
    "romantische Stimmung hervorrufen. Der Weg fuehrt hier von Norden nach "
    "Sueden, wo Du einen Hoehleneingang erkennen kannst.");

  AddDetail("pflanzen",
    "Ueppige gruene Pflanzen mit grossen Blaettern.");

  AddDetail("blaetter",
    "Sie sind rund und gross, allerdings nicht essbar, weshalb sich die "
    "Trolle vorlaeufig von Abenteurern ernaehren, die sich in ihrem Lager "
    "verirren.");

  AddDetail(({"berge","felsen","berg"}),
    "Steil aufragende Felsen tuermen sich um das Lager herum auf.");

  AddDetail(({"hoehle","eingang","hoehleneingang"}),
    "Ein finsterer Eingang in den Berg.");

  AddDetail("stimmung",
    "Eine herrliche Stimmung herrscht hier, am liebsten willst Du gar nicht "
    "mehr weg.");

  AddItem(NPC "trolljunge", REFRESH_DESTRUCT);

  AddExit("norden","./t3");
  AddExit("sueden","./t6");

  AddCmd( ({ "bahn","bahne" }) , "bahnefkt" );
}

int bahnefkt(string str) {
  object item;
  if (!item=present( QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  notify_fail("Was moechtest Du Dir wohin bahnen?\n");
  if (str == "weg") {
    notify_fail("Wohin moechtest Du Dir einen Weg bahnen?\n");
    return 0;
  }
  if (str == "weg in unterholz" || str == "weg nach unterholz" ||
      str == "weg zu funkeln" || str == "weg zum unterholz" ||
      str == "weg ins unterholz" || str == "weg zum funkeln") {
    write(BS(
      "Du versuchst Dir einen Weg ins Unterholz zu bahnen. Aber es gelingt "
      "Dir an dieser Stelle nicht."));
    return 1;
  }
  return 0;
}
