
#include <properties.h>
#include "../def.h"

inherit ROOM "trollraum";

int cloned;

create() {
  ::create();

  cloned=0;

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im Trollager");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18]) );
  SetProp(P_INT_LONG,
    "Du befindest Dich im Sueden des Trollagers. Nach Osten kommst Du zu "
    "einer primitiven Huette, die dem Haeuptling der Trolle als Residenz "
    "dient. Im Suedwesten oeffnet sich ein finsterer Eingang zu einer "
    "Hoehle, in der die Trolle vermutlich ihre Schaetze und erbeuteten "
    "Gegenstaende aufbewahren.");

  AddDetail( ({ "haeuptling" }),
    "Du musst schon in die Huette gehen um ihn zu sehen.");

  AddDetail(({"huette","residenz"}),
    "Schau doch einfach mal rein.");

  AddDetail(({"eingang","hoehle","hoehleneingang"}),
    "Der Eingang zur Hoehle ist wird ueblicherweise bewacht, anscheinend "
    "befinden sich wertvolle Schaetze darin.");

  AddDetail(({"schaetze","gegenstaende"}),
    "Na, schau doch mal in der Hoehle nach!");

  AddDetail( "boden",
    "Der Boden ist festgetrampelt.");

  AddCmd( ({ "bahn","bahne" }) , "bahnefkt" );

  AddItem(NPC "grille", REFRESH_DESTRUCT);

  AddExit("norden",     "./t5");
  AddExit("nordwesten", "./t4");
  AddExit("osten",      "./boss");
  AddExit("suedwesten", "./cave");
}

reset() {
  ::reset();
  cloned=0;
}

int bahnefkt(string str) {
  object item;
  if (!item=present( QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  notify_fail("Was moechtest Du Dir wohin bahnen?\n");
  if (str == "weg") {
    notify_fail("Wohin moechtest Du Dir einen Weg bahnen?\n");
    return 0;
  }
  if (str == "weg in unterholz" || str == "weg nach unterholz" ||
      str == "weg zu funkeln" || str == "weg zum unterholz" ||
      str == "weg ins unterholz" || str == "weg zum funkeln") {
    if(cloned!=0) {
      write(BS(
        "Du versuchst Dir einen Weg ins Unterholz zu bahnen. Aber es gelingt "
        "Dir an dieser Stelle nicht."));
      return 1;
    }
    write(BS(
      "Du versuchst Dir einen Weg ins Unterholz zu bahnen. Aber es gelingt "
      "Dir an dieser Stelle nicht. Dafuer scheuchst Du eine kleine "
      "Fliege auf, die Dich sofort angreift."));
    item=clone_object("/d/gebirge/zordan/gjordil/npc/fliege");
    item->move(ME,M_NOCHECK);
    item->Kill(TP);
    cloned=1;
    return 1;
  }
  return 0;
}
