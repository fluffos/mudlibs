
inherit "std/room";

#include <properties.h>
#include "../def.h"

string tafel();

create() {
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
  SetProp( P_INT_LONG,
      "Du befindest Dich in einem geraeumigen Zelt. Der Boden des Zeltes "
      "besteht aus Lehm, auf dem ein grosser Kreis mit seltsamen Symbolen "
      "aufgemalt ist. Die Planen des Zeltes bestehen aus einer Art Leder, "
      "das ebenfalls mit Symbolen uebersaet ist. Auf einer Seite befindet "
      "sich wohl ein Ausgang Richtung Norden. Auf der anderen Seite sind "
      "viele Namen und Symbole auf die Zeltplane gemalt. Es handelt sich wohl "
      "um die Liste der hier geborenen Trolle.");
  SetProp( P_INT_SHORT, "Im Schamanenzelt" );

  AddDetail( ({ "seite" }),
    "Im Norden ist der Ausgang und im Sueden sind viele Namen und Symbole "
    "auf die Zeltplane gemalt worden.");

  AddDetail( ({"raum", "zelt", "schamanenzelt"}),
    "Du stehst mittendrin.");

  AddDetail( ({"decke", "waende"}),
    "Das besteht aus Zeltplane.");

  AddDetail( ({ "wand" }),
    "Jede der Waende besteht hier aus einer Zeltplane.");

  AddDetail( ({"plane", "zeltplane"}),
    "Die Zeltplane grenzt das Zelt vom uebrigen Trollager ab. Sie "
    "besteht aus Leder, und ist mit seltsamen Symbolen verziert.");

  AddDetail( ({ "leder","art" }),
    "Das Leder ... hmm ... es scheint sich dabei um gegerbte Elfenhaut "
    "zu handeln.");
  AddDetail("elfenhaut", 
    "Warum die wohl gerade Elfenhaut nehmen? Hmm. Du ueberlegst. "
    "Weil es so viele von denen gibt? Vermutlich.");

  AddDetail( "boden",
    "Der Boden ist aus festgestampftem Lehm und mit seltsamen Zeichen "
    "uebersaeht. ");

  AddDetail( "lehm",
    "Der Lehm am Boden ist festgestampft. ");

  AddDetail(({"symbole","zeichen"}),
      "Die Symbole, die sowohl am Boden als auch an der Zeltplane "
      "angebracht sind, scheinen eine rituelle Bedeutung zu haben. ");

  AddDetail("bedeutung", 
      "Es handelt sich bei den Symbolen um eine Stilisierung von "
      "Geburt, Tod und Wiedergeburt. Genaueres kannst Du auch nicht "
      "sagen.");

  AddDetail("stilisierung",
      "Die Symbole sind sehr stilistiert, also sehr allgemein gehalten "
      "und nicht der Wirklichkeit entsprechend.");

  AddDetail("wirklichkeit", 
      "Du bist wirklich ... oder?");

  AddDetail(({"tod", "neuanfang"}),
      "Der Tod scheint hier nicht das Ende zu sein, offenbar findet "
      "das Leben seinen Weg in der Wiedergeburt.");

  AddDetail("leben", 
      "Das Leben scheint hier koerperlich fuehlbar zu sein.");

  AddDetail("ende", 
      "Wenn Du die Symbole richtig deutest, gibt es kein Ende. Nur einen "
      "Neuanfang.");

  AddDetail("geburt", 
      "Du kannst folgendes deuten: Die Geburt ist der Anfang.");

  AddDetail("anfang", 
      "Der Anfang des Lebens ist damit gemeint.");

  AddDetail("wiedergeburt", 
      "Du interpretierst: Durch die Wiedergeburt wird der Kreis des Lebens "
      "geschlossen.");

  AddDetail(({"kreis", "weg"}), 
      "Der Kreis der Wiedergeburt besteht aus Geburt, Tod und Wiedergeburt.");

  AddDetail(({"norden", "ausgang"}),
    "Da geht es raus in das Trollager. ");

  AddDetail( "trollager",
    "Das ist weiter draussen. Du musst schon nach Norden gehen um mehr "
    "davon zu entdecken.");

  AddDetail( ({ "troll","trolle" }),
    "Hier werden die Trolle zum Leben erweckt.");

  AddDetail( ({"namen", "liste", "tafel"}), "Du kannst sie lesen.");

  AddReadDetail( ({"namen", "liste", "tafel"}), #'tafel );
  
  AddCmd( "bete", "bete" );

  AddExit( "norden", "./boss");

  AddItem( OBJ "schild", REFRESH_REMOVE );
  AddItem("/p/service/obj/zettel/zettelmaschine", REFRESH_REMOVE);
//  AddItem("/obj/zeitungsautomat",REFRESH_REMOVE);
}

bete() {
  write(BS(
    "Du kniest nieder und haeltst eine kurze Andacht. "));
  if( TP->QueryProp(P_GHOST) ) {
    say(BS(
      "Der Geist von "+CAP_TPN+" kniet nieder und haelt eine kurze Andacht."));
    write(BS(
      "Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "
      "aus. Du spuerst langsam wieder, wie Blut Deinen Koerper von neuem "
      "durchstroemt. "));
    say(BS(
      CAP_TPN+" erscheint ploetzlich wieder in koerperlicher Form. "));
    TP->SetProp( P_GHOST, 0 );
  }
  else
    say(BS(
      CAP_TPN+" kniet nieder und haelt eine kurze Andacht. "));
  return 1;
}

string tafel() {
  TP->more("/etc/toptrolle.read",1);
  return "";
}
