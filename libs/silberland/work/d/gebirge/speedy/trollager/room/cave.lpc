
#include <properties.h>
#include <moving.h>
#include <language.h>

#include "../def.h"

inherit ROOM "trollraum";

object *tanken;

create() {
  ::create();
  tanken=({});

  SetProp(P_LIGHT, 0);
  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INT_LONG,
    "Ein gewundener Gang in einer Hoehle. Im Nordosten kannst Du den "
    "Ausgang erkennen. Im Westen befindet sich die Schatzkammer der "
    "Trolle. Wenn Du Mut hast, geh weiter, wenn nicht, verlasse die Hoehle "
    "lieber so schnell wie moeglich.");

  AddDetail( ({ "decke" }),
    "Die Decke besteht aus hartem Fels und ist sehr hoch.");

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "mut" }),
    "Bringst Du genug Mut mit?");

  AddDetail(({"schatz","kammer","schatzkammer"}),
    "All die Schaetze, die die Trolle mit der Zeit angehaeuft haben.");

  AddDetail( ({ "zeit","anbeginn" }),
    "Die Trolle wohnen schon seit Anbeginn der Zeit hier. Sie duerften "
    "also seitdem vieles angesammelt haben.");

  AddDetail( ({ "schaetze" }),
    "Das sind bestimmt nicht wenige.");

  AddDetail("ausgang",
    "Ein schwacher Lichtschein deutet im Nordosten auf den Ausgang der "
    "Hoehle hin.");

  AddDetail( ({ "lichtschein","licht","schein" }),
    "Der Ausgang duerfte im Nordosten liegen, denn von dort scheint ein "
    "wenig Licht herein.");

  AddDetail("gang",
    "Ein in den Felsen geschlagener Gang von Westen nach Nordosten, der sehr "
    "niedrig ist, Du musst schon aufpassen, damit Du Dir nicht den Kopf "
    "an den Steinen anschlaegst.");

  AddDetail("boden",
    "Der Boden besteht vorwiegend aus Felsen und Steinen, man muss schon "
    "aufpassen, damit man nicht ausrutscht.");

  AddDetail( ({"felsen","fels","stein","steine"}),
    "Sehr spitz und gefaehrlich, fasse lieber nichts an.");

  AddDetail( "himmel",
    "In dieser Hoehle siehst Du keinen Himmel.");

  AddCmd( ({"greif","greife","fass","fasse"}), "anfassen");

  AddDetail( ({ "wand","waende" }),
    "Die Waende drohen Dich fast zu erdruecken. Ihr spitzer Fels laedt nicht "
    "gerade zum rasten ein.");

  AddSpecialExit("westen", "schatzkammer");
  AddExit("nordosten", ROOM "t6");

  AddItem(NPC "schatztroll", REFRESH_DESTRUCT);
  AddItem(NPC "schatztroll", REFRESH_DESTRUCT);
  AddItem(NPC "schatztroll", REFRESH_DESTRUCT);

  AddItem("/gilden/bardengilde/obj/ehrenstatue", REFRESH_DESTRUCT, (["hero": "grimm"]));
}

reset() {
  ::reset();
  tanken=({});
}

schatzkammer() {
  if (present("schatzwache")) {
    write(
      "Die Schatzwache versperrt Dir den Weg.\n"
      "Die Schatzwache sagt: Glaubst du, dass Du so einfach in die "
      "Schatzkammer kommst.\n");
    return 1; 
  }
  return ROOM "tres";
}

anfassen(str) {
  notify_fail("Was willst Du anfassen?\n");
  if ( (str=="auf felsen") || (str=="felsen") || (str=="auf fels") || 
       (str=="fels") || (str=="steine") || (str=="stein") || 
       (str=="auf steine") || (str=="auf stein") || (str=="felsen an") ||
       (str=="fels an") || (str=="steine an") || (str=="stein an") ) {
     say(CAP_TPN+" fasst auf einen Felsen.\n");
     write("Du fasst einen kleinen Felsen an.\n");
     felsen(); 
     return 1;
  }
  return 0;
}

felsen() {
  int i;
  object *inv;

  for(i=sizeof(inv=all_inventory(TP)); i;) {
    i--;
    if(inv[i]->ichBinEinTrollamulett()) {
      if(inv[i]->QueryWorn()) {
        if (member(tanken, TP) == -1) {
	  tanken+=({ TP });     
          TP->heal_self(100+random(50));
          write(BS(
            "Du spuerst eine magische Kraft die Dich durchfaehrt."));
        } 
        else 
          write(BS(
            "Du spuerst nichts, der Stein muss sich erst erholen."));
        return 1;
      } 
    }
  }
  write(BS("Du bekommst einen magischen Schlag."));
  TP->reduce_hit_point(random(20)+10);
  return 1;
}
