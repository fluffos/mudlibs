
#include <moving.h>
#include <properties.h>
#include "../def.h"

inherit ROOM "trollraum";

int leiter, trolle, trollwaechter, trollspieler, sonst;
string sleiter;

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Auf einem Baum");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18]) );

  AddDetail( ({ "ueberblick","blick" }),
    "Der Ueberblick von hier aus ist wirklich gewaltig.");

  AddDetail( ({ "berg","berge" }),
    "Die Berge sind rings um Dich herum.");

  AddDetail( ({"ast","aeste"}) ,
    "Die Aeste sind weit, in alle Himmelsrichtungen, gewachsen. Sehr gross "
    "und dick.");

  AddDetail( ({ "himmelsrichtungen","himmelsrichtung","richtungen","richtung" }),
    "Na sie sind einfach in alle Richtungen gewachsen.");

  AddDetail( ({"baum","eiche"}) ,
    "Naja eine Eiche halt, sehr gross und bestimmt auch sehr alt.");

  AddDetail(({"boden","plattform"}),
    "Auf den Aesten des Baumes hatten die Trolle fuer die Jungen eine kleine "
    "Plattform gebaut. Durch ein Loch im Boden der Plattform kann man nach "
    "unten gelangen.");

  AddDetail( ({ "jungen" }),
    "Derzeit scheint aber keiner der Jungen hier zu spielen.");

  AddDetail("loch",
    "Durch das Loch kann man nach unten gelangen.");

  AddDetail( "oase" ,
    "Das Lager sieht wie eine Oase von hier oben aus.");

  AddDetail( ({"felswaende","waende","fels"}) ,
    "Sie ragen steil auf allen Seiten des Lagers empor, und sind unmoeglich "
    "zu besteigen.");

  AddDetail(({"leiter","strickleiter"}),
    "Die Strickleiter laesst sich mit 'zieh leiter hoch' nach oben ziehen "
    "und mit 'lass leiter runter' hinunterlassen.");

  AddSpecialDetail( ({"lager","trollager","unten","hinunter","runter"}),
		    "lager");

  AddSpecialDetail( ({ "norden","funkeln","gebuesch","unterholz" }) , 
                       "funkeln" );

  AddSpecialExit("unten","gehrunter");
  
  AddCmd( ({"lasse","ziehe","zieh","lass"}) ,"aktion");

  AddCmd(({"kletter","klettere"}),"kletter");

  leiter = 0;
  inileiter();  
}

lager() { 
  int i;

  trolle=0;
  trollwaechter=0;
  trollspieler=0;
  sonst=0;

  write("Im gesamten Trollager befinden sich im Augenblick :\n");

  for(i=sizeof(ROOMS); i; i--) {
    call_other("/d/gebirge/speedy/trollager/room/"+ROOMS[i-1], "???");
    listeauf("/d/gebirge/speedy/trollager/room/"+ROOMS[i-1], 1);
  }

  if(trolle==1) 
    write("  Ein armseliger Troll.\n");
  if(trolle>1)
    write("  "+trolle+" Trolle.\n");
  if(trollwaechter==1)
    write("  Ein Trollwaechter.\n");
  if(trollwaechter>1)
    write("  "+trollwaechter+" Trollwaechter.\n");
  if(trollspieler==1)
    write("  Ein einsamer Trollspieler.\n");
  if(trollspieler>1)
    write("  "+trollspieler+" Trollspieler.\n");
  if(sonst==1)
    write("  Ein einsamer Spieler anderer Rasse.\n");
  if(sonst>1)
    write("  "+sonst+" Spieler anderer Rasse.\n");
  if( (trolle==0) && (trollwaechter==0) && (trollspieler==0) )
    write("  kein einziger Troll.\n" );
  return "";
}

string funkeln() {
  object item;
  if (item=present( QUESTITEM, TP)) {
    if (item->checkgefragt()) {
      item->funkeln();
      return(BS(
        "Das Funkeln im Norden kommt aus einem Gebuesch im Unterholz. "
        "Vielleicht solltest Du dem mal besser nachgehen!"));
    }
  }
  return 0;
}

varargs listeauf(string raum, int flag) {
  int i;
  object *inv;

  inv=all_inventory(find_object(raum));
  for(i=0;i<sizeof(inv);i++) {
    if(living(inv[i])) {
      if(inv[i]->QueryProp(P_RACE)=="Troll") {
        if (!interactive(inv[i])) {
          if(inv[i]->id("trollwaechter")) trollwaechter++;
          else if(!inv[i]->id("schlaechter")) trolle++;
        } else {
          trollspieler++;
        }
      } else {
        if(!flag) write("  "+CAP(inv[i]->name(WER,0))+".\n");
        if (interactive(inv[i])) sonst++;
      }
    }
  }
}

schau() {
  string str;
  str="Du sitzt auf den Aesten eines hohen Baumes. Tief unter Dir "
      "kannst Du das Lager der Trolle sehen. Es sieht wie eine gruene "
      "Oase zwischen den steilen Felswaenden der Berge aus. Von hier "
      "oben hast Du einen wunderbaren Ueberblick. "+sleiter+"@@quest@@";
  SetProp(P_INT_LONG, BS(str));
}

string quest() {
  object item;
  if (item=present( QUESTITEM, TP)) {
    if (item->checkgefragt()) {
      return "Direkt im Norden unter\nDir kannst Du ein Funkeln erkennen.";
    }
  }
  return "";
}

inileiter() {
  if (leiter==0)
    sleiter="Eine Strickleiter haengt von hier am Baum herab.\n";
  else
    sleiter="Die Strickleiter ist gerade hochgezogen.\n";
  schau();
}

aktion(str) {
  notify_fail("Was willst Du tun?\n");
  if (str=="leiter runter") { 
    if(leiter==1) {
      leiterrunter(); 
      write("Du laesst die Strickleiter hinunter.\n");
      say(CAP_TPN+" laesst die Strickleiter hinunter.\n");
    }
    else
      write("Die Leiter ist aber schon unten!\n");
    return 1;
  }
  if(str=="leiter hoch") { 
    if(leiter==0) { 
      leiterhoch(); 
      write("Du ziehst die Strickleiter hinauf.\n");
      say(CAP_TPN+" zieht die Strickleiter hinauf.\n");}
    else
      write("Die Leiter ist aber schon oben!\n");
    return 1;
  }
  return 0;
}

leiterrunter() {
  AddSpecialExit("unten","gehrunter");
  leiter=0;
  call_other(ROOM "t4","leiterrunter");
  inileiter();
}

leiterhoch() {
  RemoveSpecialExit("unten");
  leiter=1;
  call_other(ROOM "t4","leiterhoch");
  inileiter();
}

gehrunter() {
  write("Du kletterst die Strickleiter hinunter.\n");
  TP->move(ROOM "t4", M_GO, "",
      "klettert die Strickleiter hinunter",
      "kommt heruntergeklettert");
  return 1;
}

kletter() {
  write(BS(
    "Der Baum ist so hoch ueber dem Boden, dass Du Dich nicht traust, "
    "hier herumzuklettern."));
  return 1;
}
