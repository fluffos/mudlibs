
#include <properties.h>
#include <language.h>

#include "../def.h"

#define OFFEN 1
#define ZU 0

inherit ROOM "trollraum";

int portionen;
string lastopfer;
string sspiess;
string stuer;
int tuer;

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im Trollager");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18]) );

  AddDetail( ({ "essen" }),
    "Die Trolle treffen sich hier um ihre notwendige Nahrung zu sich zu "
    "nehmen.");

  AddDetail( ({ "nahrung" }),
    "Die Trolle ernaehren sich vor allem von frischem Fleisch.");

  AddDetail( ({ "fleisch" }),
    "Frisch gebratenes Fleisch. Das Wasser laeuft den Trollen da im Munde "
    "zusammen.");

  AddDetail( ({ "wasser" }),
    "*sabber*");

  AddDetail( ({ "mund","munde" }),
    "Der Mund eines Trolls kann fast alles an Fleisch verdruecken.");

  AddDetail(({"boden"}),
    "Der Boden ist festgetrampelt, und ueberall liegen Fleischreste umher.");

  AddDetail(({"tuer","gefaengnistuer"}),
    "Das ist eine massive Gefaengnistuer bestehend aus Eisenstaeben.");

  AddDetail(({"staebe","eisenstaebe"}),
    "Die Eisenstaebe sind ca. 5 cm dick, da gibt es keine Moeglichkeit "
    "einzubrechen.");

  AddDetail(({"fleischreste","reste"}),
    "Die stammen wohl vom Braten, oder von toten Abenteurern.");

  AddDetail(({"stein","fels"}),
    "Es wurde eine Einhoehlung in den Felsen geschlagen, die gross genug"
    "ist um Gefangene darin zu lagern.");

  AddDetail(({"gefangener", "gefangene"}),
    "Die Gefangenen sind hinter der Gefaengnistuer.");
 
  AddDetail( ({ "ork","goblin","golbine","gobo" }),
    "Gut durchgebraten haengt er an dem Spiess.");

  AddSound (DEFAULT_SOUND,
    "Du hoerst nur seltsame Geraeusche von den Trolls.");

  AddSound ( ({"spiess","bratspiess","feuer","holzfeuer","braten"}) ,
    "Du hoerst das Fleisch ueber dem Feuer bruzzeln.");

  AddSound ( ({"gefaengnis","opfer","gefangene","eindringling",
               "eindringlinge"}),
    "Seltsame Geraeusche dringen aus dem Gefaengnis.");

  AddSmell ( DEFAULT_SMELL,
    "Es stinkt nach Troll.");

  AddSmell ( ({"spiess","bratspiess","feuer","holzfeuer","braten"}),
    "Das Fleisch stinkt furchtbar.");

  AddSpecialDetail(({"gefaengnis","opfer","gefangene","eindringling",
                     "eindringlinge"}),"haefn");

  AddSpecialDetail( ({"spiess","bratspiess","feuer","holzfeuer","braten"}), 
		      "xspiess");
 
  AddCmd(({"iss","esse","friss","fresse","mampf","koste"}),"friss");
  AddCmd(({"schliesse","schliess"}),"schliesse");
  AddCmd("oeffne","oeffne");
  AddCmd(({"sperr","sperre","mach"}),"tuersyntax");

  AddExit("westen", "./t3");

  AddItem(NPC "troll1", REFRESH_DESTRUCT);
  AddItem(NPC "troll1", REFRESH_DESTRUCT);

  tuer = ZU;
  sspiess="";
  inituer();
  portionen = 6;
  lastopfer=getopfer();
  inispiess();
}

reset() {
  ::reset();
  brate();
}

xspiess() {
  if (portionen>0) {
    write(BS(
      "Ein Bratspiess ist ueber dem Feuer verankert um Feinde der Trolle "
      "darauf zu braten. "+lastopfer+" haengt gerade daran."));
    switch (portionen) {
      case 1: write ("Der Spiess ist schon fast total abgefressen.\n"); break;
      case 2: write ("Am Spiess ist nur noch wenig Fleisch uebrig.\n"); break;
      case 3: write ("Am Spiess haengen schon noch ein paar groessere "+
                     "Stuecke.\n"); break;
      case 4: write ("Der Spiess ist noch gross genug fuer Dich.\n"); break;
      case 5: write ("Der Spiess ist noch fast ganz frisch.\n"); break;
      case 6: write ("Der Spiess ist noch frisch.\n"); break;
      default: write ("Hmm, irgenswo ein Fehler --> MAGIER rufen!!!\n");
    }
  } 
  else {
    write(BS(
      "Hier sollte ein Bratspiess haengen, doch im Moment ist keiner da."));
  }
  return "";
}

inituer() { 
  if (tuer==ZU) stuer="Die Gefaengnistuer ist verschlossen.\n";
  else          stuer="Die Gefaengnistuer ist offen!\n";
  schau();
}

schau() { 
  SetProp(P_INT_LONG, BS(
  "Du befindest Dich im Osten des Trollagers. Am Boden brennt ein kleines "
  "Holzfeuer, ueber dem ein Bratspiess befestigt ist. Hier versammeln sich "
  "die Trolle des Lagers zum Essen, wenn wieder mal ein Eindringling im "
  "Lager geschlachtet wurde. Oestlich befindet sich ein solides Gefaengnis "
  "in dem sich die armen Opfer der Trolle befinden. Die Tuer laesst sich nur "
  "von hier oeffnen. "+sspiess+stuer));
}

haefn() { 
  object *inv;
  int i;
  object *help;

  write(BS(
    "Das Gefaengnis besteht aus einer kleinen Einhoehlung im Felsen. "
    "Eine Tuer aus Metallstaeben verhindert hier jeglichen Fluchtversuch. "
    "Im Gefaengnis befinden sich :"));
  call_other(ROOM "jail", "???");
  inv=all_inventory(find_object(ROOM "jail"));
  for(i=0;i<sizeof(inv);i++)
    if (living(inv[i])) 
      write(CAP(inv[i]->name(WER,0)+".\n"));
  return "";
}

oeffne(str) {
  object t;
 
  notify_fail("Du kannst hier hoechstens Tueren oeffnen!\n");
  if ((str=="tuer") || (str=="tuere") || (str=="gefaengnistuer")) {
    if (tuer==ZU) {
      say(CAP_TPN+" oeffnet die Gefaengnistuer.\n");
      write("Du oeffnest die Gefaengnistuer.\n");
      tuerauf();
      if (t=present("troll")) {
        t->wirfrein();
      }
    }
    else write("Die Tuere ist doch schon offen!\n");
    return 1;
  }
  return 0;
}  

schliesse(str) { 
  notify_fail("Du kannst hier hoechstens Tueren schliessen!\n");
  if ((str=="tuer") || (str=="tuere") || (str=="gefaengnistuer")) {
    if (tuer==OFFEN) {
      say(CAP_TPN+" schliesst die Gefaengnistuer.\n");
      write("Du schliesst die Gefaengnistuer.\n");
      tuerzu();
    } else write("Die Tuere ist doch schon geschlossen!\n");
    return 1;
  }
  return 0;
}  

tuersyntax() { 
  write("Du kannst hier nur die Tuer oeffnen oder schliessen, klar?\n");
}

tuerauf() { 
  AddExit("osten", "./jail");
  tuer=OFFEN;
  call_other(ROOM "jail","exttuerauf");
  inituer();
  call_out("restuer", 600);
}

restuer() { 
  machtuerzu(); 
}

tuerzu() { 
  while(!remove_call_out("restuer"));
  machtuerzu();
}

machtuerzu() { 
  RemoveExit("osten");
  tuer=ZU;
  call_other(ROOM "jail","exttuerzu");
  inituer();
}

exttuerzu() { 
  RemoveExit("osten");
  tuer=ZU;
  tell_room(ME,
    "Die Gefaengnistuer wird von der anderen Seite geschlossen.\n");
  inituer();
}

brate() {
  if (portionen==0) tell_room(ME,
    "Ein Troll haengt eine neue Leiche auf den Spiess.\n");
  portionen = 4+random(3);
  inispiess();
}

opfer( string st, int EP) {
  lastopfer=st;
  inispiess();
  if (EP>50000) portionen=6; 
  if (portionen>0) 
    tell_room(ME, BS("Ein Troll haengt eine neue Leiche auf den Spiess."));
}

inispiess() {
  if (portionen>0)
    sspiess=lastopfer+" bruzzelt hier auf einem Spiess ueber dem Feuer.\n";
  else
    sspiess="Ein leerer Spiess.\n";
  schau();
  return;
}

friss() {
  if (portionen>0) {
    write(BS(
      "Du schneidest Dir ein Stueck vom Bratspiess ab und isst es. "
      "Es schmeckt wirklich gut und du fuehlst, wie Du wieder zu Kraeften "
      "kommst."));
    say(CAP_TPN+" schneidet sich ein Stueck vom Spiess ab und isst es.\n");
    TP->heal_self(60+random(20));
    portionen--;
    if (portionen==0) {
      lastopfer = getopfer();
      write(BS("Ein neuer Spiess ist schon in Arbeit..."));
    }
    inispiess(); 
  }
  else
     write("Der Braten ist leider schon weggefressen.\n");
  return 1;
}

string getopfer() {
  string leiche;

  if (random(2)==0) leiche = "Ein fetter Ork";
  else              leiche = "Ein langer Goblin";
  return (leiche);
}
