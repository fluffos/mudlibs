
#include <properties.h>
#include "../def.h"

inherit ROOM "trollraum";

create() {
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im Trollager");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18]) );
  SetProp(P_INT_LONG,
    "Du befindest dich im noerdlichen Teil des Trollagers. Westlich von "
    "Dir ragen Felsen empor, die das Lager abgrenzen. Suedlich steht ein "
    "hoher Baum. Ueberall liegen abgenagte Knochen und Schaedel herum. "
    "Der Weg verlaeuft von Norden nach Sueden. Im Osten wird der Weg durch "
    "dichte Gebuesche begrenzt.");

  AddDetail( ({"Baum","Eiche"}),
    "Du erkennst, dass eine Strickleiter nach oben fuehrt.");

  AddDetail(({"fels","felsen"}),
    "Sie ragen steil auf allen Seiten des Lagers empor, und sind "
    "unmoeglich zu besteigen.");

  AddDetail( "teil",
    "Von hier aus kommst du nach Sueden weiter in Lager hinein, und gegen "
    "Norden, kannst Du das Lager wieder verlassen.");

  AddDetail( ({"strickleiter","leiter"}),
    "Die Leiter befindet sich suedlich von hier, und ist an der Eiche "
    "festgeknotet.");

  AddDetail( ({"schaedel","knochen"}),
    "Ueberall liegen diese Leichenreste herum. Grauenhaft, wie diese Trolle "
    "ihre Opfer abnagen.");

  AddDetail( "weg",
    "Der Weg verlaeuft hier von Norden nach Sueden.");

  AddDetail( "opfer",
    "Arme Hunde sind die, welche den Trollen in die Haende fallen.");

  AddDetail( ({ "haende","feuer" }),
    "Denn wenn Du einmal in die Haende der Trolle gefallen bist, dann "
    "braten sie Dich sicher auf dem Feuer und fressen Dich danach auf.");

  AddDetail( ({"leichenreste","reste"}),
    "Pfui, aeeee, graus, .....");

  AddSpecialDetail( ({"bissspuren","spuren"}), "xspuren");
  AddSpecialDetail( ({"gebuesche","gebuesch","busch"}), "gebuesch");
  AddSpecialDetail( ({"unterholz","holz","blick"}), "holz");
  AddSpecialDetail( ({"funkel","funkeln"}), "funkeln");
  AddSpecialDetail( ({"stelle"}), "stelle");

  AddExit("norden","./t1");
  AddExit("sueden","./t4");

  AddItem(NPC "wache", REFRESH_DESTRUCT);
  AddItem(NPC "wache", REFRESH_DESTRUCT);

  AddCmd( ({ "bahn","bahne" }) , "bahnefkt" );

}

xspuren() {
  write(BS(
    "Du siehst, dass hier schon so mancher "+TP->QueryProp(P_RACE)+
    " ins Gras gebissen hat."));
  return "";
}

gebuesch() {
  object item;
  if (item=present( QUESTITEM, TP)) {
    if (item->checkgefragt() && item->checkfunkeln()) {
      return(BS(
        "Die Gebuesche sind hier sehr dicht, ein Weiterkommen an der "
        "oestlichen Seite wird dadurch fast unmoeglich gemacht. Du kannst "
        "einige Bissspuren und mitten im Unterholz ein leichtes Funkeln "
        "erkennen."));
    }
  }
  return(BS(
    "Die Gebuesche sind hier sehr dicht, ein Weiterkommen an der oestlichen "
    "Seite wird dadurch unmoeglich gemacht. Du kannst einige Bissspuren "
    "daran erkennen."));
}

holz() {
  object item;
  if (item=present( QUESTITEM, TP)) {
    if (item->checkgefragt() && item->checkfunkeln()) {
      return(BS(
        "Tief im dichten Unterholz kannst Du ein leichtes Funkeln "
        "erkennen. So auf den ersten Blick kannst Du aber keinen Weg "
        "dorthin erkennen."));
    }
  } 
  return 0;
}

funkeln() {
  object item;
  if (item=present( QUESTITEM, TP)) {
    if (item->checkgefragt() && item->checkfunkeln()) {
      return(BS(
        "Das Funkeln kommt aus dem dichten Unterholz. Du versucht vergeblich "
        "Dir einen Weg dorhin zu bahnen. Du wirst schon eine andere Stelle "
        "suchen muessen, um dorthin zu gelangen."));
    }
  } 
  return 0;
}

stelle() {
  object item;
  if (item=present( QUESTITEM, TP)) {
    if (item->checkgefragt() && item->checkfunkeln()) {
      return(BS(
        "Na Du musst Dir das Lager einfach genauer ansehen und von oben "
        "vorstellen."));
      return "";
    }
  } 
  return 0;
}

int bahnefkt(string str) {
  object item;
  if (!item=present( QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  notify_fail("Was moechtest Du Dir wohin bahnen?\n");
  if (str == "weg") {
    notify_fail("Wohin moechtest Du Dir einen Weg bahnen?\n");
    return 0;
  }
  if (str == "weg in unterholz" || str == "weg nach unterholz" ||
      str == "weg zu funkeln" || str == "weg zum unterholz" ||
      str == "weg ins unterholz" || str == "weg zum funkeln") {
    write(BS(
      "Du versuchst Dir einen Weg ins Unterholz zu bahnen. Aber es gelingt "
      "Dir an dieser Stelle nicht."));
    return 1;
  }
  return 0;
}
