
#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit ROOM "trollraum";

int cloned;

void create() {
  ::create();

  cloned=0;

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im Trollager");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18]) );
  SetProp(P_INT_LONG,
    "Du befindest Dich im noerdlichen Teil des Trollagers. Vor Dir oeffnet "
    "sich eine gruene, bluehende Lichtung, eingeschlossen von steilen "
    "Felsen. Am Boden liegt ein sauber abgenagtes Skelett herum.");

  AddDetail("skelett",
    "Das Skelett eines Abenteurers. Er wollte das Trollager kartografieren "
    "und hat wohl seine Nase zu tief hineingesteckt.");

  AddDetail( ({ "nase" }),
    "Die Nase ist natuerlich nicht mehr da.");

  AddDetail(({"fels","felsen"}),
    "Sie ragen steil auf allen Seiten des Lagers empor, und sind "
    "unmoeglich zu besteigen.");

  AddDetail( "lichtung" ,
    "Eine schoene, grosse, guene Lichtung.");

  AddDetail( "boden" ,
    "Lauter Blutflecken sind am Boden verstreut.");

  AddDetail( ({"blut","flecken","blutflecken"}),
    "Hoffentlich von keinem deiner Freunde ...");

  AddDetail( ({ "freunde" }),
    "Mach doch mal 'fwer'.");

  AddDetail( ({"lichtung","teil"}),
    "Du stehst hier auf einer leichten Erhebung am Nordende des Trollagers. "
    "Obwohl Dich die Sonnenstrahlen angenehm waermen, ueberkommt Dich ein "
    "unangenehmes Gefuehl.");

  AddDetail( ({ "gefuehl" }),
    "Dieses Gefuehl dringt tief in Dich ein und ist unbehaglich.");

  AddDetail( ({"sonnenstrahlen","strahlen"}),
    "Angenehm warm, wenn Du in den Sonnenstrahlen stehst. Es scheint so, als "
    "waere, das hier die einzige Stelle, des Lagers, wo die Sonnenstrahlen "
    "hindringen koennen.");

  AddDetail( "sonne",
    "Die Sonne sieht sehr klein von hier unten aus, aber doch dringen einige "
    "Sonnenstrahlen zu Dir herunter.");

  AddDetail( ({"erhebung","nordende","stelle"}),
    "Eine kleine Erhebung am Nordende des Lagers, an dieser Stelle kannst Du "
    "etwas weiter sehen, als in anderen Teilen des Lagers.");

  AddSpecialDetail( "abenteurer", "xabenteurer");

  AddExit("sueden",ROOM "t2");
  AddExit("suedosten",ROOM "t3");

  AddSpecialExit("westen","rausda");

  AddItem(NPC "gjordil", REFRESH_DESTRUCT);
  AddItem(NPC "skink", REFRESH_DESTRUCT);

  AddCmd( ({ "bahn","bahne" }) , "bahnefkt" );

}

reset() {
  ::reset();
  cloned=0;
}

xabenteurer() {
  return BS("Hmm, scheint ein "+TP->QueryProp(P_RACE)+" zu sein.");
}

rausda() { 
  if (this_player()->QueryProp(P_RACE)!="Troll") {
    if (present("trollwaechter")) {
      write(
        "Der Trollwaechter versperrt Dir den Weg.\n"
        "Der Trollwaechter sagt: Schoen hiergeblieben, Freundchen.\n");
      return 1; 
    }
  }
  return ROOM "entr";
}

int bahnefkt(string str) {
  object item;
  if (!item=present( QUESTITEM, TP)) return 0;
  if (!item->checkgefragt()) return 0;
  if (!item->checkfunkeln()) return 0;
  notify_fail("Was moechtest Du Dir wohin bahnen?\n");
  if (str == "weg") {
    notify_fail("Wohin moechtest Du Dir einen Weg bahnen?\n");
    return 0;
  }
  if (str == "weg in unterholz" || str == "weg nach unterholz" ||
      str == "weg zu funkeln" || str == "weg zum unterholz" ||
      str == "weg ins unterholz" || str == "weg zum funkeln") {
    if(cloned!=0) {
      write(BS(
        "Du versuchst Dir einen Weg ins Unterholz zu bahnen. Aber es gelingt "
        "Dir an dieser Stelle nicht."));
      return 1;
    }
    write(BS(
      "Du versuchst Dir einen Weg ins Unterholz zu bahnen. Aber es gelingt "
      "Dir an dieser Stelle nicht. Auf einmal schreckt ein kleiner "
      "Kaefer aus dem Unterholz hervor und attackiert Dich!"));
    item=clone_object("/d/gebirge/zordan/gjordil/npc/mistkaefer");
    item->move(ME,M_NOCHECK);
    item->Kill(TP);
    cloned=1;
    return 1;
  }
  return 0;
}
