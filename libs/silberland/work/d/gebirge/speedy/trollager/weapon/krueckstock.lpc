
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"


create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Krueckstock");
  SetProp(P_LONG,
    "Ein fester Holzstock, mit vielen Kerben. Ist sicher schon sehr alt.");
  SetProp(P_NAME, "Krueckstock");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 500);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 50);
  SetProp(P_WC_BONUS, (["gjordil":100]) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));

  AddId (({"stock", "krueckstock"}));

  AddDetail( "kerben",
    "Die Kerben sehen ganz schoen alt aus.");
}
