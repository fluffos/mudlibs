
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Eine Trollkeule");
  SetProp (P_LONG, 
    "Die Trollkeule ist ein Pruegel mit Eisenspitzen am Ende. Mit einer "
    "gewissen Kraft kann man seinem Gegner damit sicher den Schaedel "
    "einhauen.");
  SetProp (P_NAME, "Trollkeule");
  SetProp (P_GENDER, FEMALE);
  AddId (({"keule", "trollkeule"}));
  SetProp (P_VALUE, 1000);
  SetProp (P_WEIGHT, 4000);
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, DT_BLUDGEON);
  SetProp (P_WC, 150);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS,
          (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_WOOD:80, MAT_IRON:20]));
}
