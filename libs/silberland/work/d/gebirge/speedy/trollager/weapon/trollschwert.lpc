
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Ein Trollschwert");
  SetProp (P_LONG, 
    "Das Trollschwert ist ein Schwert speziell fuer Trolle. Es ist riesig "
    "gross und seine Klinge ist nicht einmal so dermassen scharf. Aber durch "
    "die unglaubliche Kraft eines Trolles ist es eine sehr gefuerchtete Waffe.");
  SetProp (P_NAME, "Trollschwert");
  SetProp (P_GENDER, NEUTER);
  AddId (({"schwert", "trollschwert"}));
  SetProp (P_VALUE, 1000+random(200));
  SetProp (P_WEIGHT, 2000);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_WC, 160);
  SetProp (P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON:90, MAT_WOOD:10]) );
}
