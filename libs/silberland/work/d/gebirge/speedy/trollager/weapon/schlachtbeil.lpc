
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>

#include "../def.h" 

#define TEOB tell_object

inherit "std/weapon";
 
int lasthit, xyident;
int last_wielded;

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schlachtbeil");
  SetProp(P_LONG,
    "Das blutige Schlachtbeil ist eine starke Waffe. In den Haenden eines "
    "blutruenstigen Schlaechters sicher eine sehr gefaehrliche!");
  SetProp(P_NAME, "Schlachtbeil");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WC, 180);
  AddId( ({"beil","schlachtbeil","schlaechterbeil"}) );
  SetProp(P_VALUE, 10000);
  SetProp(P_WEIGHT, 4000);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON:30, MAT_WOOD:70]));
  AddCmd ("smash", "smash");

  SetProp(P_INFO,
    "Das Schlachtbeil ist eine sehr maechtige Waffe. Mit 'SMASH' kannst "
    "Du einen Spezialschlag ausfuehren, der allen Npc's im gegenwaertigen "
    "Raum einen einen Rundumschlag versetzt.");

  SetProp(P_WIELD_FUNC, TO);

}

smash(str) {
  object *inv, *op, *en, *ki;
  int i, kraft, sp;
  mixed qe;

  if (!TO->QueryProp(P_WIELDED)) return;
  if (str) {
    write(BS(
      "'Smash' alleine reicht vollkommen aus."));
    return;
  }
  if((time()-lasthit) < 180) {
    write(BS(
      "Du bist von Deinem letzten 'Smash' noch zu erschoepft!"));
    return 1;
  }
  if((time()-last_wielded) < 4) {
    write(BS(
      "Sofort nach dem Zuecken geht das leider nicht!"));
    return 1;
  }
  if( (sp=TP->QueryProp(P_SP))<10 ) {
   write(BS(
     "Du hast nicht genug magische Kraft zu einem Rundumschlag."));
   return 1; 
  } else {
    TP->SetProp(P_SP, sp-10);
  }
  lasthit=time();
  inv=all_inventory(ENV(TP));
  op=({ });
  for (i=0; i<sizeof(inv); i++) {
    if ((living(inv[i])) && (!query_once_interactive(inv[i]))) {
      op+=({ inv[i] });
    }
  }
  op-=({ TP });
  en=TP->PresentEnemies();
  ki=op-en;
  for (i=0;i<sizeof(ki);i++) {
    write (ki[i]->name()+" gehoert gekillt.\n");
    TP->Kill(ki[i]);
  }
  write(BS(
    "Du holst zu einem kraeftigen Rundumschlag aus."));
  say(BS(
    CAP_TPN+" holt zu einem kraeftigen Rundumschlag aus."));
  kraft=(5 * TP->QueryAttribute(A_STR)) + 40;
  for (i=0;i<sizeof(op);i++) {
    op[i]->Defend(kraft, DT_SLASH, 0, TP);
  }
  return 1;
}

int WieldFunc(object ob) {
  last_wielded = time();
  return 1;	
}
