#include "../def.h"

inherit ROOM "dung-inh";

int moos;

int MoosDa();

void create()
{
  ::create();

  AddCmd( CMD_ESSEN, "cmd_essen" );

  AddExit( "norden", GETEXIT("03_03") );
  AddExit( "westen", GETEXIT("02_04") );

  MoosDa();
}

void MoosDa()
{
  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An der Mauer kannst Du ein seltsames Gewaechs erkennen. "
  );

  AddDetail( ({"stein","steine","mauersteine","mauerstein"}),
    "Auf den Mauersteinen waechst ein komisches Moos. "
  );

  AddDetail( ({"gewaechs","moos"}),
    "Das Moos ist gruen, und hat sich im Laufe der Zeit an den Mauersteinen "
    "festgefressen. Vielleicht kann man es essen. "
  );

  moos = 3;
}

void MoosWeg()
{
  moos--;
  if(moos < 0)
  {
    RemoveDetail( ({"wand","waende","mauer","mauern"}) );
    RemoveDetail( ({"stein","steine","mauersteine","mauerstein"}) );
    RemoveDetail( ({"gewaechs","moos"}) );
  }
}

reset()
{
  MoosDa();
  ::reset();
}

int cmd_essen(string str)
{
  notify_fail("Was willst Du essen?\n");
  if(!str || str == "") return 0;
  if(!(str == "moos")) return 0;

  if(moos < 1)
  {
    TELLPLAYER("Welches Moos denn?\n");
    return 1;
  }

  TELLPLAYER(BS("Du rupfst etwas Moos von der Mauer und isst es, ploetzlich "
                "fuehlst Du Dich etwas gestaerkt. "));
  TP->heal_self(80);
  MoosWeg();
  return 1;
}
