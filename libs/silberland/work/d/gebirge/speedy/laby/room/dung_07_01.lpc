#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"fallgitter","gitter"}), "detail_gitter" );

  AddCmd( CMD_OEFFNEN, "cmd_oeffnen" );

  AddExit( "westen", GETEXIT("06_01") );
  AddExit( "sueden", GETEXIT("07_02") );
  AddExit( "osten" , ([EX_DEST : GETEXIT("08_01"),EX_TESTFUNC : "exittest"]));
}

int exittest(string dir)
{
  if(SMASTER->QueryDoorStatus(TPUID,"E") == DOOROPENED) return 1;
  TELLPLAYER("Der Durchgang nach Osten ist durch ein geschlossenes "
             "Gitter blockiert.\n");
  return 0;
}

string _query_int_long()
{
  string s;

  if(SMASTER->QueryDoorStatus(TPUID,"E") == DOOROPENED)
  {
    s = "Im Osten befindet sich ein geoeffnetes Fallgitter. ";
  }
  else
  {
    s = "Im Osten befindet sich ein geschlossenes Fallgitter. ";
  }

  return BS(ltext1 + s);
}

string detail_gitter(string str)
{
  string s;

  if(SMASTER->QueryDoorStatus(TPUID,"E") == DOOROPENED)
  {
    s = "Im Osten befindet sich ein geoeffnetes Fallgitter. ";
  }
  else
  {
    s = "Im Osten befindet sich ein geschlossenes Fallgitter. ";
  }

  return BS(s);
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "gitter"         ||
       str == "fallgitter"     )) return 0;

  if(SMASTER->QueryDoorStatus(TPUID,"E") == DOOROPENED)
  {
    TELLPLAYER("Das Gitter ist doch bereits offen.");
  }
  else
  {
    TELLPLAYER(BS("Das Gitter im Osten ist geschlossen. Es sieht auch nicht "
                  "so aus, als ob es einfach zu oeffnen waere. "));
  }

  return 1;
}

