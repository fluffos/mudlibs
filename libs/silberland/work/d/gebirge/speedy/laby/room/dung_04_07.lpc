#include "../def.h"

inherit ROOM "dung-inh";

string detail_tafel();

void create()
{
  ::create();

  ltext2 = "An der Wand erkennst Du eine Tafel.";

  AddDetail( ({"tafel"}),
    "Die Tafel besteht aus Metall, vielleicht kannst Du sie lesen."
  );

  AddDetail( ({"metall"}),
    "Das Metall glaenzt schoen im Licht. "
  );

  AddReadDetail( ({"tafel"}), #'detail_tafel );

  AddExit( "westen", GETEXIT("03_07") );
}

string detail_tafel()
{
  return "Auf der Tafel steht eine Zahl: "+SMASTER->QueryCode2(TPUID)+"\n";
}
