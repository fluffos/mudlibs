#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "In der Mitte des Raumes steht komischerweise ein voellig "
           "verdorrter Baum. ";

  AddDetail( ({"mitte"}),
    "Genau in der Mitte des Raumes scheint es so, wie wenn ein Baum "
    "aus dem Boden wachsen wuerde. "
  );

  AddDetail( ({"baum"}),
    "Der Baum, wie auch seine Aeste, ist voellig verdorrt und verfault. "
    "Irgendwie hat er es geschafft durch die Steine zu wachsen, aber da er "
    "wahrscheinlich zuwenig Wasser hatte ist er abgestorben. "
  );

  AddDetail( ({"wasser"}),
    "Ja genau, von dem gibts hier zuwenig. "
  );

  AddSpecialDetail( ({"ast","aeste"}), "detail_ast" );
  AddSpecialDetail( ({"y","y-stueck","ystueck","stueck"}), "detail_stueck" );

  AddCmd( ({"brich","breche","brech"}), "cmd_brechen" );

  AddExit( "norden", GETEXIT("10_05") );
  AddExit( "sueden", GETEXIT("10_07") );
}

int cmd_brechen(string str)
{
  object ob;

  notify_fail("Was willst Du abbrechen?\n");
  if(!str || str == "") return 0;
  if(!(str=="ast ab"         ||
       str=="holz ab"        ||
       str=="stueck ab"      ||
       str=="y-stueck ab"    ||
       str=="y ab"           ||
       str=="ystueck ab"     ||
       str=="y stueck ab"    )) return 0;

  if(SMASTER->QueryFlag(TPUID, F_GET_HOLZ)) return 0;

  ob = clone_object(OBJ "holz");
  if(ob->move(TP,M_GET|M_SILENT) != 1)
  {
    TELLPLAYER("Du kannst nichts mehr tragen.\n");
    ob->remove();
    return 1;
  }

  TELLPLAYER("Du brichst den Ast ab und steckst ihn ein.\n");
  SMASTER->SetFlag(TPUID,F_GET_HOLZ);
  return 1;
}

string detail_stueck(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_HOLZ))
    return "Der eine Ast sieht aus wie ein Y. Vielleicht kannst Du den "
           "brauchen.\n";

  return NICHTDA;
}

string detail_ast(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_HOLZ))
    return BS("Der Baum hat zwar nicht mehr viele Aeste, aber einige sind "
              "noch da. Ein Ast sieht aus wie ein Y-Stueck.");

  return BS("Der Baum hat nur mehr wenige Aeste, ausserdem fehlt anscheinend "
            "ein Ast. Den hat wohl jemand abgebrochen.");
}
