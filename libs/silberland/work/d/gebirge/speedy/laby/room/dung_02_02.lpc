#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "An der westlichen Wand siehst Du eine Leiter, die nach oben "
           "fuehrt. ";

  AddDetail( ({"leiter"}),
    "Die Leiter fuehrt wieder hinaus, dort wo Du hergekommen bist. "
  );

  AddExit( "norden", GETEXIT("02_01") );
  AddExit( "osten",  GETEXIT("03_02") );
  AddExit( "oben",   ROOM "start" );
}
