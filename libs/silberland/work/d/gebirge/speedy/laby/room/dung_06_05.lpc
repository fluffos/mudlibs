#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"fallgitter","gitter"}), "detail_gitter" );

  AddDetail( ({"schluesselloch","loch"}),
    "Das Loch sieht aus wie ein Schluesselloch, wahrscheinlich kann "
    "man damit das Gitter aufsperren. "
  );

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An der Wand entdeckst du einen Stein, in dem ein Loch ist. "
  );

  AddDetail( ({"stein","steine","mauersteine","mauerstein"}),
    "Ein Stein in der Mauer hat ein Loch, ziemlich klein, aber dennoch ein "
    "Loch. "
  );

  AddCmd( CMD_OEFFNEN,          "cmd_oeffnen" );
  AddCmd( ({"sperr","sperre"}), "cmd_sperren" );

  AddExit( "norden", GETEXIT("06_04") );
  AddExit( "osten" , ([EX_DEST : GETEXIT("07_05"),EX_TESTFUNC : "exittest"]));

}

int exittest(string dir)
{
  if(SMASTER->QueryDoorStatus(TPUID,"F") == DOOROPENED) return 1;
  TELLPLAYER("Der Durchgang nach Osten ist durch ein geschlossenes "
             "Gitter blockiert.\n");
  return 0;
}

string _query_int_long()
{
  string s;

  if(SMASTER->QueryDoorStatus(TPUID,"F") == DOOROPENED)
  {
    s = "Im Osten befindet sich ein geoeffnetes Fallgitter. ";
  }
  else
  {
    s = "Im Osten befindet sich ein geschlossenes Fallgitter. ";
  }

  return BS(ltext1 + s);
}

string detail_gitter(string str)
{
  string s;

  if(SMASTER->QueryDoorStatus(TPUID,"F") == DOOROPENED)
  {
    s = "Im Osten befindet sich ein geoeffnetes Fallgitter. ";
  }
  else
  {
    s = "Das Gitter ist sehr robust, so einfach bekommst Du es sicher nicht "+
        "auf. ";
  }

  return BS(s);
}

int cmd_sperren(string str)
{
  notify_fail("Was willst Du aufsperren?\n");
  if(!str || str == "") return 0;

  if(!(str=="gitter auf"                              ||
       str=="fallgitter auf"                          ||
       str=="gitter mit schluessel auf"               ||
       str=="fallgitter mit schluessel auf"           ||
       str=="gitter mit rostigem schluessel auf"      ||
       str=="fall gitter mit rostigem schluessel auf" )) return 0;

  if(SMASTER->QueryDoorStatus(TPUID,"F") == DOOROPENED)
  {
    TELLPLAYER("Das Gitter ist doch bereits offen.\n");
    return 1;
  }

  if(!present("\nspy_eisenschluessel", TP))
  {
    TELLPLAYER("Du hast keinen passenden Schluessel dabei.\n");
    return 1;
  }

  TELLPLAYER(BS("Du steckst den Eisenschluessel in das Schluesselloch und "
                "drehst ihn um. Langsam und quietschend oeffnet sich das "
                "Gitter."));

  SMASTER->SetFlag(TPUID,F_TUER_F_OFFEN);
  SMASTER->SetDoorStatus(TPUID,"F",DOOROPENED);

  if(SMASTER->QueryDoorStatus(TPUID,"F") != DOOROPENED)
  {
    TELLPLAYER("Das Gitter faellt ploetzlich krachend wieder herunter.\n");
  }

  return 1;
}

//evtl as zusatz "steck schluessel in loch" bzw oeffne gitter mit schluessel
//zulassen

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;

  // Etwas flexibler fuer Leute, die eigentlich wissen, was zu tun ist:
  // (woody, 2004-08-30)
  if(str == "gitter mit schluessel"     ||
     str == "fallgitter mit schluessel" ||
     str == "gitter mit rostigem schluessel" ||
     str == "fallgitter mit rostigem schluessel")
    return cmd_sperren("gitter auf");

  if(!(str == "gitter"         ||
       str == "fallgitter"     )) return 0;

  if(SMASTER->QueryDoorStatus(TPUID,"F") == DOOROPENED) // E->F (bugfix woody 2004-08-30)
  {
    TELLPLAYER("Das Gitter ist doch bereits offen.\n");
  }
  else
  {
    TELLPLAYER(BS("Das Gitter im Osten ist geschlossen. Es sieht auch nicht "
                  "so aus, als ob es einfach zu oeffnen waere."));
  }

  return 1;
}
