#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"gitter","fallgitter"}),  "detail_gitter" );
  AddSpecialDetail( ({"eisenstaebe","staebe"}), "detail_eisen" );
  AddSpecialDetail( ({"knopf"}),                "detail_knopf" );

  AddCmd( CMD_OEFFNEN,  "cmd_oeffnen" );
  AddCmd( CMD_DRUECKEN, "cmd_druecken" );

  AddExit( "norden", GETEXIT("02_04") );
  AddExit( "westen", GETEXIT("01_05") );
  AddExit( "sueden", GETEXIT("02_06") );
  AddExit( "osten" , ([EX_DEST : GETEXIT("03_05"),EX_TESTFUNC : "exittest"]));
}

int exittest(string dir)
{
  if(SMASTER->QueryDoorStatus(TPUID,"G") == DOOROPENED) return 1;
  TELLPLAYER("Der Durchgang nach Osten ist durch ein geschlossenes "
             "Gitter blockiert.\n");
  return 0;
}

string _query_int_long()
{
  string s;

  if(SMASTER->QueryDoorStatus(TPUID,"G") == DOOROPENED)
  {
    s = "Im Osten befindet sich ein geoeffnetes Fallgitter. ";
  }
  else
  {
    s = "Im Osten befindet sich ein geschlossenes Fallgitter. ";
  }

  return BS(ltext1 + s);
}

object ort()
{
  return TO;
}

int cmd_druecken(string str)
{
  notify_fail("Was moechtest Du druecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "knopf")) return 0;

  TELLPLAYER(BS("Der ist zu weit entfernt, als dass Du ihn erreichen "
                "koenntest"));
  return 1;
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "gitter"         ||
       str == "fallgitter"     )) return 0;

  if(SMASTER->QueryDoorStatus(TPUID,"G") == DOOROPENED)
  {
    TELLPLAYER("Aber das Gitter ist doch schon offen.\n ");
    return 1;
  }

  TELLPLAYER("Das Gitter ist viel zu schwer, das wirst Du nie anheben "
             "koennen.\n");
  return 1;
}

string detail_gitter(string str)
{
  if(SMASTER->QueryDoorStatus(TPUID,"G") == DOOROPENED)
    return "Das Fallgitter ist geoeffnet, Du kannst durchgehen.\n";

  return BS("Das Fallgitter ist zu, es besteht aus starken Eisenstaeben "
            "und geht sicher nicht so einfach auf. ");
}

string detail_eisen(string str)
{
  if(SMASTER->QueryDoorStatus(TPUID,"G") == DOOROPENED)
    return "Die Eisenstaebe sind stark und dick.\n";

  return BS("Als Du die Eisenstaebe untersuchst, faellt Dir auf der anderen "
            "Seite des Gitters ein Knopf auf, der wahrscheinlich dazu "
            "gehoert, das Gitter zu oeffnen.");
}

string detail_knopf(string str)
{
  if(SMASTER->QueryDoorStatus(TPUID,"G") == DOOROPENED)
    return "Jetzt weisst Du, dass der Knopf zum Oeffnen des Gitters "
           "gehoert.\n";

  return "Du muesstest den Knopf irgendwie reindruecken koennen, aber wie "
         "nur.\n";
}



