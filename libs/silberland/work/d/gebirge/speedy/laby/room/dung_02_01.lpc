#include "../def.h"

inherit ROOM "dung-inh";

int count;

void create()
{
  ::create();

  ltext2 = "In der Ecke steht eine kleine Kiste. ";

  AddDetail( ({"kiste"}),
    "Die Kiste besteht aus Holz, ist ca. 50 cm hoch und randvoll mit "
    "lauter Papierzetteln. "
  );

  AddDetail( ({"ecke"}),
    "In einer finsteren Ecke das Raumes siehst Du eine Kiste stehen. "
  );

  AddDetail( ({"holz"}),
    "Das Holz der Kiste ist schon ziemlich verrottet, scheint sehr alt "
    "zu sein. "
  );

  AddDetail( ({"zettel","papier","papierzettel"}),
    "Die meisten Zetteln sind nur mehr ganz kleine Stuecke, die uebrigen "
    "sind sehr zerfetzt. Vielleicht kannst Du noch ein paar Stuecke "
    "entdecken, die noch ganz sind. "
  );

  AddDetail( ({"stuecke","stueck"}),
    "Das Papier besteht fast ausschliesslich nur noch aus ganz kleinen "
    "Stuecken. "
  );

  AddCmd( CMD_DURCHSUCHEN, "cmd_durchsuchen" );
  AddCmd( CMD_NEHMEN,      "cmd_nehmen" );

  AddExit( "westen", GETEXIT("01_01") );
  AddExit( "sueden", GETEXIT("02_02") );

  count=0;
}

void reset()
{
  count=0;
  ::reset();
}

void init()
{
  count=0;
  ::init();
}

int cmd_durchsuchen(string str)
{
  object ob;

  notify_fail( "Was willst Du durchsuchen?\n" );
  if(!str || str == "") return 0;
  if(!(str == "kiste"     ||
       str == "in kiste"  )) return 0;

  count++;
  switch(count)
  {
    case 1 :
      TELLPLAYER(BS("Du durchsuchst die Kiste, aber da findest Du nichts, "
                    "Du muesstest die Kiste schon genauer durchsuchen. "));
      break;

    case 2 :
      TELLPLAYER(BS("Du durchsuchst die Kiste genauer, aber die Zettel sind "
                    "so zerfetzt, dass man nicht so leicht was findet. "));
      break;

    default:
      if(!SMASTER->QueryFlag(TPUID,F_GET_ZETTEL))
      {
        ob = clone_object(OBJ "zettel");
        if(ob->move(TP, M_GET) != 1)
        {
          TELLPLAYER(BS("Du Schwaechling kannst noch nicht mal mehr einen "
                        "kleinen Zettel tragen, dabei sah der eigentlich recht "
                        "interessant aus."));
          ob->remove();
        }
        else
        {
          SMASTER->SetFlag(TPUID,F_GET_ZETTEL);
          TELLPLAYER(BS("Und noch einmal wuehlst Du in der Kiste umher, "
                        "endlich siehst Du einen interessanten Zettel, den Du "
                        "einsteckst. "));
        }
      }
      else
      {
        TELLPLAYER(BS("Und wieder steckst Du deine Haende in die Kiste und "
                      "beginnst zu suchen ... aber leider ohne Erfolg. "));
      }
  }

  return 1;
}

int cmd_nehmen(string str)
{
  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "zettel"                    ||
       str == "zerfetzten zettel"         )) return 0;

  if(present("\nspy_zettel",TP))
  {
    TELLPLAYER("Nein, einer reicht.\n");
    return 1;
  }

  TELLPLAYER(BS("Du nimmst Dir einen Zettel, kannst aber nicht mehr entziffern "
                "was darauf stehst und wirfst ihn wieder in die Kiste."));
  return 1;
}


