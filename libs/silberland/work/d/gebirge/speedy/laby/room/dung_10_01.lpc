#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "An einer Wand steht ein Regal.";

  AddDetail( ({"regal"}),
    "Das Regal ist ca. 2 Meter hoch und breit, und hat mehrere Faecher. "
  );

  AddDetail( ({"fach","faecher"}),
    "Es sind insgesamt 4 Faecher von denen 3 leer sind. Nur das oberste "
    "enthaelt einige Gegenstaende. "
  );

  AddDetail( ({"gegenstaende"}),
    "Ganz oben im Regal stehen einige Glaeser. "
  );

  AddDetail( ({"glas","glaeser"}),
    "Einige davon sind zu, einige offen und einige sind ganz kaputt. Du "
    "musst schon aufpassen dass Du nicht in die Scherben fasst. "
  );

  AddDetail( ({"scherben"}),
    "Die sind nicht so interessant, die Deckel der geschlossenen Glaeser "
    "sind lustig. "
  );

  AddDetail( ({"deckel","metalldeckel","holzdeckel","papierdeckel"}),
    "Du entdeckst verschiedene Arten von Deckel: ein Metalldeckel, einen "
    "Holzdeckel und einen Papierdeckel. "
  );

  AddDetail( ({"arten"}),
    "Warum nicht jedes Glas den gleichen Deckel hat bleibt wohl eine "
    "nicht zu beantwortende Frage. "
  );

  AddSpecialDetail( ({"papier"}), "detail_papier" );
  AddSpecialDetail( ({"gummi"}),  "detail_gummi" );

  AddCmd( CMD_OEFFNEN                   ,   "cmd_oeffnen" );
  AddCmd( CMD_NEHMEN+({"ziehe","zieh"}) ,   "cmd_ziehen" );

  AddExit( "sueden", GETEXIT("10_02") );
}

string detail_papier()
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_GUMMI))
    return BS("Dieser Deckel ist aus Papier und mit einem Gummi am Glas "
              "befestigt, so dass es nicht aufgeht. ");

  return BS("Der Deckel ist aus Papier und liegt eigentlich nur auf dem "
            "Glas lose auf.");
}

string detail_gummi(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_GUMMI))
    return "Der Gummi dient dazu, dass das Papier fest am Glas gehalten "
           "wird.\n ";

  return NICHTDA;
}

int cmd_oeffnen(string str)
{
  notify_fail(BS("Welchen Deckel willst Du oeffnen? Den Papierdeckel, "
                 "den Metalldeckel oder den Holzdeckel?"));
  if(!str || str == "") return 0;
  if(str == "deckel")   return 0;

  if(str == "papierdeckel")
  {
    if(!SMASTER->QueryFlag(TPUID,F_GET_GUMMI))
    {
      TELLPLAYER(BS("Du ziehst den Gummi vom Glas, nimmst das Papier weg "
                    "und das Glas ist offen. Du schaust hinein, aber leider "
                    "ist nichts drinnen. Also schliesst Du es wieder. "));
      return 1;
    }
    TELLPLAYER(BS("Du nimmst das Papier vom Glas, siehst hinein, entdeckst "
                  "nichts darin und machst das Glas wieder zu. "));
    return 1;
  }

  if(str == "holzdeckel")
  {
    TELLPLAYER(BS("Du klappst den Holzdeckel herunter. In dem Glas ist "
                  "aber nichts, also schliesst Du es wieder. ") );
    return 1;
  }

  if( str == "metalldeckel" )
  {
    TELLPLAYER(BS("Du schraubst den Metalldeckel herrunter und weisst "
                  "jetzt, dass das Glas leer ist. Du schraubst es wieder zu. ") );
    return 1;
  }

  return 0;
}

int cmd_ziehen(string str)
{
  object ob;

  if(SMASTER->QueryFlag(TPUID,F_GET_GUMMI)) return 0;

  notify_fail("Was willst Du von wo herunterziehen?\n");

  if(!str || str == "") return 0;

  if(!(str=="gummi von glas herunter"         ||
       str=="gummi von glas runter"           ||
       str=="gummi von glas"                  ||
       str=="gummi von papier herunter"       ||
       str=="gummi von papier runter"         ||
       str=="gummi von papier"                ||
       str=="gummi von deckel herunter"       ||
       str=="gummi von deckel runter"         ||
       str=="gummi von deckel"                ||
       str=="gummi von papierdeckel herunter" ||
       str=="gummi von papierdeckel runter"   ||
       str=="gummi von papierdeckel"          ||
       str=="gummi ab"                        ||
       str=="gummi weg"                       )) return 0;

  ob = clone_object(OBJ "gummi");
  if(ob->move(TP, M_GET|M_SILENT) != 1)
  {
    TELLPLAYER("Du kannst selbst dieses Gummi nicht mehr nicht mehr tragen.\n");
    ob->remove();
    return 1;
  }

  TELLPLAYER("Du nimmst den Gummi vom Glas herunter.\n");
  SMASTER->SetFlag(TPUID,F_GET_GUMMI);
  return 1;
}

