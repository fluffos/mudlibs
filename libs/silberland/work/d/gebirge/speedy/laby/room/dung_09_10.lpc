#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "An der Wand siehst Du eine seltsame Nische. ";

  AddSpecialDetail( ({"nische"}), "detail_nische" );
  AddSpecialDetail( ({"muenze"}), "detail_muenze" );

  AddExit( "norden", GETEXIT("09_09") );
  AddExit( "westen", GETEXIT("08_10") );

  AddCmd( CMD_NEHMEN, "cmd_nehmen" );
}

string detail_nische(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_MUENZE_B))
    return BS("Die Nische ist in der Wand eingelassen. Sie ist ca. 50 cm "
              "breit und nur 20 cm hoch. In der Nische liegt eine Muenze, "
              "vielleicht kannst Du sie nehmen. ");

  return BS("Die Nische ist in der Wand eingelassen. Sie ist ca. 50 cm "
            "breit und nur 20 cm hoch. ");
}

string detail_muenze(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_MUENZE_B))
    return "Eine blaue Muenze liegt in der Nische.\n";

  return NICHTDA;
}

int cmd_nehmen(string str)
{
  object ob;

  if(SMASTER->QueryFlag(TPUID,F_GET_MUENZE_B)) return 0;

  notify_fail("Was willst Du nehmen?\n");
  if(!str || str == "") return 0;
  if(!(str=="muenze" || str=="muenze aus nische")) return 0;

  if(SMASTER->QueryStatus(TPUID,S_KRAFTFELD))
  {
    TELLPLAYER("Irgendwas hindert Dich daran die Muenze zu nehmen.\n");
    return 1;
  }

  ob = clone_object(OBJ "muenze");
  ob->Customize("blau");
  if(ob->move(TP,M_GET|M_SILENT) != 1)
  {
    TELLPLAYER("Du kannst aber nichts mehr tragen.\n");
    ob->remove();
    return 1;
  }

  TELLPLAYER("Du nimmst die Muenze aus der Nische.\n");
  SMASTER->SetFlag(TPUID,F_GET_MUENZE_B);
  return 1;
}

