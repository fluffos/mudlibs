#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "In der Ecke faellt Dir noch ein kleiner Steinhaufen auf. ";

  AddDetail( ({"steine","haufen","steinhaufen","stein"}),
    "In der Ecke siehst Du einen kleinen Steinhaufen, der ca. einen halben "
    "Meter hoch ist. Wenn Du willst, kannst Du ja einige Steine "
    "mitnehmen. "
  );

  AddDetail( ({"ecke"}),
    "In einer finsteren Ecke kannst Du einen kleinen Steinhaufen "
    "entdecken. "
  );

  AddCmd( CMD_NEHMEN,                             "cmd_nehmen" );
  AddCmd( ({"wirf","werf","werfe","leg","lege"}), "cmd_legen" );

  AddExit( "westen", GETEXIT("07_04") );
}

int cmd_legen(string str)
{
  object ob;

  notify_fail( "Was willst Du wegwerfen oder legen?\n");
  if(!str || str == "") return 0;
  if(!(str=="stein weg" || str == "stein")) return 0;

  if(ob = deep_present("\nspy_stein", TP))
  {
    TELLPLAYER("Du legst den Stein wieder auf den Haufen.\n");
    ob->remove();
    return 1;
  }

  if(deep_present("stein", TP))
  {
    TELLPLAYER("Du ueberlegst es Dir doch anders.\n");
    return 1;
  }

  TELLPLAYER("Du hast keinen Stein dabei.\n");
  return 1;
}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail("Was willst Du nehmen?\n");
  if(!str || str == "") return 0;

  if(!(str == "stein"        ||
       str == "stein mit"    ||
       str == "steine"       ||
       str == "steine mit"   ))  return 0;

  ob = clone_object(OBJ "stein");
  if(ob->move(TP, M_GET|M_SILENT) != 1)
  {
    TELLPLAYER("Aber Du kannst ja nichts mehr tragen.\n");
    ob->remove();
    return 1;
  }
  SMASTER->SetFlag(TPUID, F_GET_STEIN);
  TELLPLAYER(BS("Du steckst einen kleinen Stein ein, hoffentlich brauchst "
                "Du ihn auch fuer irgendwas. "));
  return 1;
}
