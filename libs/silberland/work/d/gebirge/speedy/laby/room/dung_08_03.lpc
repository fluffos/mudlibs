#include "../def.h"

inherit ROOM "dung-inh";

int wasser;

void create()
{
  ::create();

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An einer der Mauern, kannst Du eine kleines Loch erkennen. "
  );

  AddDetail( ({"stein","steine","mauersteine","mauerstein"}),
    "Ein paar Mauersteine haben ein Loch, was da wohl drinnen sein mag. "
  );

  AddDetail( ({"loch"}),
    "Du kannst entdecken, dass sich in diesem Loch eine seltsame "+
    "Fluessigkeit sammelt, die durch die Mauer runterrinnt. "
  );

  AddDetail( ({"fluessigkeit","wasser"}),
    "Naja sieht nicht gerade schmackhaft aus, aber vielleicht kann man es "+
    "trotzdem trinken. "
  );

  AddCmd( CMD_TRINKEN, "cmd_trinken" );

  AddExit( "osten", GETEXIT("09_03") );

  wasser=4;
}

void reset()
{
  wasser = 4;
  ::reset();
}

int cmd_trinken(string str)
{
  notify_fail("Was moechtest Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser"       ||
       str == "fluessigkeit" )) return 0;

  if(wasser <= 0)
  {
    TELLPLAYER(BS("Das Wasser muss sich erst wieder sammeln, im Moment ist "
                  "keines mehr da."));
  }
  else
  {
    TELLPLAYER(BS("Die Fluessigkeit erfrischt Dich einigermassen, Du "
                  "spuerst auch eine heilsame Wirkung. "));
    wasser--;
    TP->heal_self(100);
  }
  return 1;
}

