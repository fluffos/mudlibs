#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "In der Mitte des Raumes steht ein wunderbarer Tisch, und an der "
           "Wand erkennst Du eine Inschrift. ";

  AddSpecialDetail( ({"tisch"}), "detail_tisch" );

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "In der Wand ist eine Inschrift eingraviert. "
  );

  AddDetail( ({"inschrift"}),
    "Probier sie doch zu lesen. "
  );

  AddReadDetail( ({"inschrift"}),
    "Wenn Du zu Saruman gebracht werden willst kannst Du Dich teleportieren, "
    "wenn du 'anfang' tippst. "
  );

  AddCmd( CMD_NEHMEN,   "cmd_nehmen" );
  AddCmd( ({"anfang"}), "cmd_anfang" );

  AddExit( "osten", GETEXIT("05_04") );
}

int cmd_anfang(string str)
{
  int res;

  res = TP->move(ROOM "start", M_TPORT|M_NOCHECK);

//DB(sprintf("RESULT %d\n", res));
  return 1;
}

string detail_tisch(string str)
{
  if(SMASTER->QueryFlag(TPUID,F_GET_ROLLE))
  {
    return "Auf dem Tisch liegt nichts, sonderbar ...\n";
  }

  return BS(
    "Auf dem Tisch liegt die Schriftrolle, die Du suchen sollst. Am "
    "Besten steck sie gleich ein und bringe sie zu dem alten Mann. ");
}

int cmd_nehmen(string str)
{
  object ob;
  int fehler;

  if(SMASTER->QueryFlag(TPUID,F_GET_ROLLE)) return 0;

  notify_fail("Was willst Du nehmen?\n");
  if(!str || str == "") return 0;
  if(!(str == "schriftrolle" || str == "rolle")) return 0;

  ob = clone_object(OBJ "schriftrolle");
  if(ob->move(TP,M_GET) != 1)
  {
    TELLPLAYER("Du Schwaechling kannst noch nicht mal diese Schriftrolle "
               "tragen.\n");
    ob->remove();
    return 1;
  }

  TELLPLAYER("Du nimmst die Schriftrolle vom Tisch.\n");
  SMASTER->SetFlag(TPUID,F_GET_ROLLE );
  return 1;
}

