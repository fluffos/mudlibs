#include "../def.h"
#include "dungeon.h"
#include <ansi.h>

inherit "/std/room";

string ltext1;
string ltext2;
int doorroom;

void create()
{
  int i, light;

  ::create();

  ltext1 = "";
  ltext2 = "";

  light=random(2);

  for(i=0;i<5;i++)
  {
    switch(i)
    {
      case 0: ltext1 += LANG_1[random(5)]; break;
      case 1: ltext1 += LANG_2[random(5)]; break;
      case 2: ltext1 += LANG_3[random(5)]; break;
      case 3: if(light) ltext1 += LANG_4_LICHT[random(5)]; break;
      case 4: ltext1 += LANG_5[random(5)]; break;
    }
  }

  SetProp(P_INT_SHORT, "In einem duesteren Gang" );
  SetProp(P_LIGHT, light);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_NO_TPORT, NO_TPORT);

  AddDetail( ({"raum"}),
    D_RAUM[random(3)]
  );

  AddDetail( ({"atmosphaere","gewoelbe","platz"}),
    D_GEWOELBE[random(3)]
  );

  AddDetail( ({"dunkelheit"}),
    D_DUNKELHEIT[random(3)]
  );

  AddDetail( ({"wand","waende","mauer","mauern"}),
    D_WAND[random(3)]
  );

  AddDetail( ({"zement"}),
    D_ZEMENT[random(3)]
  );

  AddDetail( ({"seite","seiten"}),
    D_SEITE[random(3)]
  );

  AddDetail( ({"stein","steine","mauersteine","mauerstein"}),
    D_SEITE[random(3)]
  );

  AddDetail( ({"staub","dreck","schmutz"}),
    D_STAUB[random(3)]
  );

  AddDetail( ({"vorrat","atemvorrat","luft"}),
    D_LUFT[random(3)]
  );

  AddDetail( ({"zug","luftzug","wind","windzug"}),
    D_ZUG[random(3)]
  );

  AddDetail( ({"gang","gaenge"}),
    D_GANG[random(3)]
  );

  if(light)
  AddDetail( ({"licht","lichtquelle","fackel","lichtschein","schein", "quelle"}),
    D_LICHT[random(3)]
  );

  AddDetail( ({"boden"}),
    D_BODEN[random(3)]
  );

  AddDetail( ({"faeulnis","verfaultes"}),
    D_FAUL[random(3)]
  );

  AddDetail( ({"eindruck","gefuehl"}),
    D_EINDRUCK[random(3)]
  );

  AddDetail( ({"zustand"}),
    D_ZUSTAND[random(3)]
  );

  AddDetail( ({"decke"}),
    D_DECKE[random(3)]
  );

  AddDetail( ({"sinn","zweck"}),
    D_SINN[random(3)]
  );

  AddSmell( DEFAULT_SMELL, SM_DEFAULT[random(3)] );
  AddSmell( ({"faeulnis","verfaultes"}), SM_VERFAULTES[random(3)] );
  AddSound( DEFAULT_SOUND, SO_DEFAULT[random(3)] );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );

  SUID;

  doorroom = 0;
}

void TestPlayer(object player)
{
  string s, uuid;
  int diff;

  if(IS_WIZARD(player))               return;
  if(player->QueryProp(P_TESTPLAYER)) return;

  uuid = getuuid(player);

  if(!SMASTER->IsQuester(uuid))
  {
    tell_object(player, "Was treibst Du Dich denn hier herum?\n");
    return;
  }

  if(SMASTER->QueryTimeLimit(getuuid(player)))
  {
    player->move(ROOM "start", M_NOCHECK|M_SILENT);
    return;
  }

  diff = SMASTER->QueryTime(uuid) + QUESTTIME - time();

  if((diff < 300) && (SMASTER->QueryWarning(uuid, 1) == 0))
  {
    s = "Du hast nur noch sehr wenig Zeit. Beeil Dich, sonst ist die "
        "Schriftrolle verloren!";
    s = BSI(s,"Saruman teilt Dir mit: ");

    if(player->QueryProp(P_TTY))
      s = ANSI_BOLD+ANSI_RED+s[0..<2]+ANSI_NORMAL+"\n";

    tell_object(player, s);
    SMASTER->SetWarning(uuid, 0);
    SMASTER->SetWarning(uuid, 1);

    return;
  }


  if((diff < 900) && (SMASTER->QueryWarning(uuid, 0) == 0))
  {
    s = "Du hast nur noch wenig Zeit. Beeil Dich, sonst ist die "
        "Schriftrolle verloren.";
    s = BSI(s,"Saruman teilt Dir mit: ");

    if(player->QueryProp(P_TTY))
      s = ANSI_BOLD+ANSI_RED+s[0..<2]+ANSI_NORMAL+"\n";

    tell_object(player, s);
    SMASTER->SetWarning(uuid, 0);

    return;
  }
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  TestPlayer(TP);
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, die Schriftrolle zu finden.\n");
  return 0;
}

string _query_int_long()
{
  return BS(ltext1+ltext2);
}

void AddOpenDoor(string dir)
{
  ltext2 = "Im "+dir+" befindet sich ein geoeffnetes Fallgitter. ";

  AddDetail( ({"fallgitter","gitter"}),
    "Das Gitter im "+dir+" ist offen."
  );

  AddCmd( CMD_OEFFNEN,                "cmd_oeffnen" );
  AddCmd( ({"schliess","schliesse"}), "cmd_schliessen" );

  doorroom = 1;
}

int cmd_oeffnen(string str)
{
  if(!doorroom) return 0;

  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(!(str == "gitter"         ||
       str == "fallgitter"     )) return 0;

  TELLPLAYER("Das Gitter ist doch schon offen.\n");
  return 1;
}

int cmd_schliessen(string str)
{
  if(!doorroom) return 0;

  notify_fail("Was moechtest Du schliessen\n");

  if(!str || str == "") return 0;

  if(!(str == "gitter"         ||
       str == "fallgitter"     )) return 0;

  TELLPLAYER(BS("Du versuchst das Gitter zu schliessen, schaffst es aber "
                "nicht. Ist vielleicht auch besser so."));
  return 1;
}

void BecomesNetAlive(object player)
{
  TestPlayer(player);
}

