#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "An der noerdlichen Wand siehst Du ausserdem noch eine grosse "
           "Kurbel.";

  AddDetail( ({"rost"}),
    "Der Rost ist schon alt, aber er hat sich schon so in die Kurbel "
    "hineingefressen, dass da nichts mehr geht. "
  );

  AddSpecialDetail( ({"kurbel"}),  "detail_kurbel" );
  AddSpecialDetail( ({"rad"}),     "detail_rad" );
  AddSpecialDetail( ({"kette"}),   "detail_kette" );

  AddCmd( ({"kurbel","kurble","dreh","drehe"}), "cmd_drehen" );
  AddCmd( CMD_NEHMEN,                           "cmd_nehmen" );

  AddExit( "osten",  GETEXIT("08_04") );
  AddExit( "westen", GETEXIT("06_04") );
}

string detail_kette(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_KETTE))
    return "Die Kette verbindet die Kurbel und das Rad.\n";

  return NICHTDA;
}

string detail_rad(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_KETTE))
    return BS("Das Rad ist an der Wand befestigt und mit der Kurbel ueber "
              "eine Kette verbunden. ");

  return "Du siehst ein an der Wand befestigtest Rad.\n";
}

string detail_kurbel(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_KETTE))
    return BS("Die Kurbel ist gross und rund, einige Meter davon entfernt "
              "befindet sich ein kleines Rad. Die Kurbel und das Rad sind "
              "durch eine Kette verbunden. ");

  return BS("Die Kurbel ist gross und rund, einige Meter davon entfernt "
            "befindet sich ein kleines Rad. Wahrscheinlich benoetigt man "
            "eine Kette um das Rad anzutreiben. ");
}

int cmd_drehen(string str)
{
  notify_fail("Woran willst Du drehen?\n");
  if(!str || str == "") return 0;

  if(str == "kurbel" || str == "an kurbel")
  {
    TELLPLAYER(BS("Die Kurbel bewegt sich keinen Millimeter, die ist "
                  "wahrscheinlich schon eingerostet. "));
    return 1;
  }

  if(str == "rad" || str == "an rad")
  {
    TELLPLAYER(BS("Das hat keinen Sinn, das Rad ist viel zu klein. Probier "
                  "es doch an der Kurbel. "));
    return 1;
  }

  return 0;
}

int cmd_nehmen(string str)
{
  object ob;

  if(SMASTER->QueryFlag(TPUID,F_GET_KETTE)) return 0;

  notify_fail( "Was willst Du nehmen?\n" );
  if(!str || str == "") return 0;
  if(!(str == "kette"               ||
       str == "kette  von rad"      ||
       str == "kette von kurbel"    ||
       str == "kette ab"            ||
       str == "kette  von rad ab"   ||
       str == "kette von kurbel ab" )) return 0;

  ob = clone_object(OBJ "kette");
  if(ob->move(TP, M_GET) != 1)
  {
    TELLPLAYER("Die Kette ist viel zu schwer fuer Dich.\n");
    ob->remove();
    return 1;
  }

  TELLPLAYER("Du nimmst die Kette von der Kurbel herunter.\n");
  SMASTER->SetFlag(TPUID,F_GET_KETTE);
  return 1;
}
