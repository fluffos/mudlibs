#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "Weiters steht in der Mitte des Raumes steht eine grosse "
           "Statue. ";

  AddDetail( ({"statue"}),
    "Die Statue ist gross und voellig aus Stein, sie repraesentiert einen "
    "Untoten. "
  );

  AddDetail( ({"untoten","untoter"}),
    "Die Statue stellt eine Mumie dar. Sie hat einen furchtbaren Kopf, "
    "schreckliche Haende, und einen in Leinen gewickelten Koerper. "
  );

  AddDetail( ({"kopf"}),
    "Der Kopf schaut richtig furchtbar aus. Die Augen blicken Dich an, "
    "egal wo Du stehtst im Raum, Dir kommt es so vor als wenn Dich jemand "
    "beobachten wuerde. Der Hals verbindet den Kopf mit dem uebrigen "
    "Koerper, doch auch dieser ist nicht sehr schoen. "
  );

  AddDetail( ({"stein"}),
    "Der Stein aus dem die Statue besteht, ist glatt und schoen poliert. "
  );

  AddDetail( ({"augen"}),
    "Die Augen der Statue schauen Dich immer an, obwohl die Statue kalt ist "
    "scheint es so, als ob sich die Augen bewegen wuerden. "
  );

  AddDetail( ({"koerper"}),
    "Der Koerper der Mumie ist ganz in Leinen gewickelt, aber auch diese "
    "sind aus Stein. "
  );

  AddDetail( ({"leinen"}),
    "Die Leinen umgeben den ganzen Koerper, wenn sie nicht aus Stein "+
    "waeren, wuerden sie brennen. "
  );

  AddDetail( ({"haende","hand"}),
    "Die Haende sind gross und schrecklich, wenn die Dich kriegen wuerden "+
    "wuerde es Dir bestimmt nicht gut gehen. "
  );

  AddSpecialDetail( ({"hals"}),                       "detail_hals" );
  AddSpecialDetail( ({"amulett","seltsames amulett"}), "detail_amulett" );

  AddCmd( CMD_NEHMEN, "cmd_nehmen" );

  AddExit( "osten", GETEXIT("05_06") );
}

string detail_hals()
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_AMULETT))
    return BS("Als Du den Hals naeher betrachtest, faellt Dir auf, dass ein "
              "seltsames Amulett daran haengt.");

  return "Der Hals ist kalt wie Stein. Voellig irrelevant.";
}

string detail_amulett(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_AMULETT))
    return "Wenn Du es nehmen wuerdest, koenntest Du es genauer anschauen.\n";

  return "Sowas siehst Du hier nicht!\n";
}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail("Was moechtest Du nehmen?\n");
  if(!str || str == "") return 0;
  if(!(str == "amulett" || str == "seltsames amulett")) return 0;

  if(SMASTER->QueryFlag(TPUID,F_GET_AMULETT)) return 0;

  ob = clone_object(OBJ "amulett");
  if(ob->move(TP, M_GET) != 1)
  {
    TELLPLAYER("Du kannst aber nichts mehr tragen.\n");
    ob->remove();
    return 1;
  }

  TELLPLAYER("Du nimmst das Amulett von dem Hals der Statue, und steckst es "
             "ein.\n");
  SMASTER->SetFlag(TPUID,F_GET_AMULETT);
  return 1;
}
