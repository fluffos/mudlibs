#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Huette von Saruman");
  SetProp(P_INT_LONG,
    "Du stehst in der kleinen Huette von Saruman. Die Einrichtung ist "
    "schlicht aber nett. Es befinden sich ein Tisch, mehrere Sessel und "
    "eine Sitzbank in diesem Zimmer. Erleuchtet wird der Raum durch eine "
    "Oellampe, die an der Decke aufgehaengt ist. An der Ost- und Nordseite "
    "befindet sich ein Fenster, das den Raum auch noch ein wenig erhellt. "
    "Am Boden liegt ein grosser Teppich. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  AddDetail( ({"huette","zimmer","raum"}),
    "Das Zimmer, wo Du gerade stehst ist klein, doch fuer den alten Mann "
    "scheint es zu reichen. "
  );

  AddDetail( ({"einrichtung"}),
    "Die Einrichtung ist etwas spaerlich, aber doch ganz nett. Hier "
    "befindet sich ein Tisch, einige Sessel und eine Sitzbank. "
  );

  AddDetail( ({"tisch"}),
    "Der Tisch steht in der Mitte des Zimmers und dient dazu einige Sachen "
    "darauf abzustellen. "
  );

  AddDetail( ({"mitte"}),
    "In der Mitte des Zimmers steht nur ein grosser Tisch. "
  );

  AddDetail( ({"sessel"}),
    "Einige Sessel stehen neben dem Tisch, man muss ja auch wo sitzen "
    "koennen. "
  );

  AddDetail( ({"bank","sitzbank"}),
    "Die Sitzbank scheint sehr gemuetlich zu sein. Darauf sitzt Saruman "
    "immer wenn er gerade nichts zu tun hat. "
  );

  AddDetail( ({"oellampe","lampe"}),
    "Die kleine Oellampe, die an der Decke haengt, erhellt das Zimmer auch "
    "nachts. Schliesslich will Saruman ja was sehen. "
  );

  AddDetail( ({"decke"}),
    "An der Decke haengt eine Oellampe herunter, sonst ist sie einfach nur "
    "aus Holz, wie auch alles andere hier. "
  );

  AddDetail( ({"fenster"}),
    "Durch die Fenster dringt am Tage das Sonnenlicht, damit das kleine "
    "Zimmer auch einwenig erleuchtet ist. "
  );

  AddDetail( ({"seite","ostseite","nordseite","wand","waende"}),
    "Die Waende des Zimmers sind aus Holz, es haengen einige Bilder an "
    "diesen. "
  );

  AddDetail( ({"boden"}),
    "Am Boden liegt ein grosser Teppich. "
  );

  AddDetail( ({"unter teppich"}),
    "Vielleicht kann man den Teppich beiseite rollen. "
  );

  AddDetail( ({"teppich"}),
    "Der Teppich ist sehr schoen genaeht, man sieht es gleich, dass es "
    "echte Handarbeit ist. Was da wohl drunter sein mag. "
  );

  AddDetail( ({"handarbeit","arbeit"}),
    "Das ist wirklich hervorragend gearbeitet, hat bestimmt viel Zeit in "
    "Anspruch genommen. "
  );

  AddDetail( ({"holz"}),
    "Alles hier ist aus Holz, die Waende, die Decke und sogar der Boden. "
  );

  AddDetail( ({"bild","bilder"}),
    "Die Bilder zeigen vor allem Saruman mit seinen Bekannten und "
    "Freunden."
  );

  AddDetail( ({"freunde","verwandte","bekannte"}),
    "Die kennst Du sicher alle nicht. "
  );

  AddItem(NPC "saruman", REFRESH_DESTRUCT );
//AddItem( OBJ("tafel"), REFRESH_REMOVE );

  AddCmd( ({"roll","rolle","schiebe","schieb"}), "cmd_schieben" );

  AddExit( "sueden", "/d/gebirge/dusty/weg/j22" );
}

int cmd_schieben(string str)
{
  notify_fail("Was moechtest Du wegrollen?\n");

  if(!str || str == "") return 0;
  if(!(str == "teppich"           ||
       str == "teppich weg"       ||
       str == "teppich auf"       ||
       str == "teppich beiseite"  ||
       str == "teppich zur seite" )) return 0;

  if(SMASTER->IsQuester(TPUID))
  {
    TELLOTHERS(BS(TPN+" rollt einen Teppich zur Seite und oeffnet eine "
                  "Falltuere, die Saruman sofort wieder verschliesst. "
                  "Danach rollt Saruman den Teppich wieder ueber die "
                  "Falltuere."));
    TELLPLAYER(BS("Du rollst den Teppich zur Seite und entdeckst eine "
                  "Falltuer. Schnell oeffnest Du die Falltuer und steigst "
                  "die Leiter hinab. Du siehst noch, wie Saruman die "
                  "Falltuer wieder schliesst."));

    TP->move(GETEXIT("02_02"),M_GO|M_SILENT, "", "", "");
    return 1;
  }

  TELLPLAYER("Saruman schimpft: Lass meinen Teppich liegen!\n");
  return 1;
}

