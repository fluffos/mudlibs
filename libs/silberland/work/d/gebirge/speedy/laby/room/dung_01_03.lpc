#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "An der Wand steht desweiteren ein Buecherregal. ";

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An einer Wand siehst Du ein grosses Buecherregal mit vielen "
    "Buechern. "
  );

  AddDetail( ({"buecherregal","regal"}),
    "Das Buecherregal ist voll mit Buechern, und braucht fast die ganze "
    "Wand. "
  );

  AddSpecialDetail( ({"buecher"}),      "detail_buecher" );
  AddSpecialDetail( ({"ausstrahlung"}), "detail_ausstrahlung" );
  AddSpecialDetail( ({"buch"}),         "detail_buch" );

  AddCmd( CMD_LESEN, "cmd_lesen" );

  AddExit( "osten",  GETEXIT("02_03") );
  AddExit( "sueden", GETEXIT("01_04") );
}

string detail_buecher()
{
  string s;

  s = "Sehr viele Buecher, sie sind zwar staubig aber noch in einem "
      "brauchbaren Zustand. ";

  if(!SMASTER->QueryFlag(TPUID, F_GET_MUENZE_R))
  {
    s += "Du spuerst eine magische Ausstrahlung eines Buches besonders. ";
  }

  return BS(s);
}

mixed detail_ausstrahlung()
{
  if(!SMASTER->QueryFlag(TPUID, F_GET_MUENZE_R))
    return "Die Ausstrahlung eines Buches ist faszinierend.\n";
  return 0;
}

mixed detail_buch()
{
  if(!SMASTER->QueryFlag(TPUID, F_GET_MUENZE_R))
    return BS(
      "Du nimmst das Buch heraus und haeltst es in deinen Haenden. Der "
      "Titel lautet: HRUz' ThsdUI. Was das wohl heissen mag? ");
  return 0;
}

cmd_lesen(str)
{
  object ob;
  string s;

  if(!str || str == "") return 0;
  if(!(str == "buch"         ||
       str == "buecher"      )) return 0;

  if( str=="buecher" )
  {
    TELLPLAYER("Da wuerdest Du Wochen brauchen ... \n");
    return 1;
  }

  if(SMASTER->QueryFlag(TPUID, F_GET_MUENZE_R))
  {
    TELLPLAYER("Die Buecher scheinen nicht interessant zu sein, warum also "
               "lesen.\n");
    return 1;
  }

  s = "Du schlagst die erste Seite des Buches auf, aber Du kannst "
      "kein Wort verstehen. Die Sprache ist Dir unbekannt. ";

  if(random(40) < 20)
  {
    s += "Ploetzlich faellt Dir auf, dass das Buch eigentlich sehr leicht "
         "ist. Du blaetterst einige Seiten weiter und siehe da in der "
         "Mitte sind die Seiten bis zum Rand herausgeschnitten, so dass "
         "ein Loch in der Mitte ist. In der Mitte des Buches liegt eine "
         "Muenze, die Du sofort einsteckst. ";

    ob = clone_object(OBJ "muenze");
    ob->Customize("rot");
    ob->move(TP, M_NOCHECK);
    SMASTER->SetFlag(TPUID, F_GET_MUENZE_R);
  }
  else
  {
    s += "Vielleicht musst Du mehr ueben, um etwas zu verstehen. ";
  }

  TELLPLAYER(BS(s));
  return 1;
}

