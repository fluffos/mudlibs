#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"fallgitter","gitter"}), "detail_gitter" );

  AddDetail( ({"loch"}),
    "Ein ganz normales Loch, gerade gross genug, um hineinzugreifen. "
  );

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An der Wand entdeckst Du einen Stein, in dem ein Loch ist. "
  );

  AddDetail( ({"stein","steine","mauersteine","mauerstein"}),
    "Ein Stein in der Mauer hat ein Loch, das Loch ist ganz schwarz, was "
    "da wohl drinnen sein mag. "
  );

  AddCmd( CMD_OEFFNEN,          "cmd_oeffnen" );
  AddCmd( CMD_GREIFEN,          "cmd_greifen" );
  AddCmd( ({"steck","stecke"}), "cmd_stecken" );
  AddCmd( ({"drehe","dreh"}),   "cmd_drehen" );

  AddExit( "osten",  GETEXIT("04_08") );
  AddExit( "sueden", GETEXIT("03_09") );
  AddExit("westen", ([EX_DEST : GETEXIT("02_08"),EX_TESTFUNC : "exittest"]));
}

int exittest(string dir)
{
  if(SMASTER->QueryDoorStatus(TPUID,"H") == DOOROPENED) return 1;
  TELLPLAYER("Der Durchgang nach Westen ist durch ein geschlossenes "
             "Gitter blockiert.\n");
  return 0;
}

string _query_int_long()
{
  string s;

  if(SMASTER->QueryDoorStatus(TPUID,"H") == DOOROPENED)
    s = "Im Westen befindet sich ein offenes Fallgitter. ";
  else
    s = "Im Westen befindet sich ein geschlossenes Fallgitter. ";

  return BS(ltext1+s);
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "gitter"         ||
       str == "fallgitter"     )) return 0;

  if(SMASTER->QueryDoorStatus(TPUID,"H") == DOOROPENED)
  {
    TELLPLAYER("Das Gitter ist doch schon offen.\n");
  }
  else
  {
    TELLPLAYER("Du versuchst das Gitter hochzuschieben, doch irgendetwas "
               "blockiert.\n");
  }

  return 1;
}

int cmd_drehen(string str)
{
  string s;

  if(!SMASTER->QueryFlag(TPUID,F_AMULETT_REINGESTECKT)) return 0;

  notify_fail("Was moechtest Du drehen?\n");
  if(!str || str == "") return 0;
  if(!(str == "amulett"             ||
       str == "seltsames amulett"   ||
       str == "achteckiges amulett" )) return 0;

  s = "Du greifst in das Loch und drehst das Amulett einmal im Kreis. ";

  if(SMASTER->QueryDoorStatus(TPUID,"H") == DOOROPENED)
  {
    s += "Nichts passiert. ";
  }
  else
  {
    SMASTER->SetFlag(TPUID,F_TUER_H_OFFEN);
    SMASTER->SetDoorStatus(TPUID,"H",DOOROPENED);
    s += "Das Tor im Westen oeffnet sich mit lautem Quietschen.";
  }

  TELLPLAYER(BS(s));
  return 1;
}

int cmd_greifen(string str)
{
  notify_fail("Wo moechtest Du reingreifen?\n");
  if(!str || str == "") return 0;
  if(!(str == "loch" || str == "in loch")) return 0;

  if(SMASTER->QueryFlag(TPUID,F_AMULETT_REINGESTECKT))
  {
    TELLPLAYER(BS("Du greifst in das Loch und spuerst das Amulett drinnen, "
                  "vielleicht solltest Du damit noch was tun. "));

  }
  else
  {
    TELLPLAYER("Du greifst in das Loch, und spuerst, das es innen "
               "achteckig ist.\n ");
  }

  return 1;
}

int cmd_stecken(string str)
{
  object ob;

  notify_fail("Was moechtest Du wo hineinstecken?\n");
  if(!str || str == "") return 0;
  if(!(str == "amulett in loch"                    ||
       str == "amulett in loch hinein"             ||
       str == "seltsames amulett in loch"          ||
       str == "seltsames amulett in loch hinein"   ||
       str == "achteckiges amulett in loch"        ||
       str == "achteckiges amulett in loch hinein" )) return 0;

  if(!ob=present("\nspy_amulett", TP))
  {
    TELLPLAYER("Du hast kein passendes Amulett dabei.\n");
    return 1;
  }

  TELLPLAYER("Du steckst das achteckige Amulett in das Loch hinein.\n");
  if(SMASTER->SetFlag(TPUID,F_AMULETT_REINGESTECKT));
  ob->remove();
  return 1;
}

string detail_gitter(string str)
{
  if(SMASTER->QueryDoorStatus(TPUID,"H") == DOOROPENED)
    return "Das Gitter ist offen, Du kannst hindurchgehen.\n";

  return "Das Gitter ist sehr robust, so einfach bekommst Du es sicher "
         "nicht auf.\n";
}









