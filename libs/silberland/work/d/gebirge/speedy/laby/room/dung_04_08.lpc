#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "An einer Wand siehst Du ein Holzbrett, das aussieht wie ein "
           "Kleiderstaender. ";

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An der Wand ist ein Holzbrett angeschraubt. "
  );

  AddDetail( ({"holzbrett","brett","staender","kleiderstaender"}),
    "Das Holzbrett ist an die Wand geschraubt, und hat mehrere Holzstuecke "
    "an denen man was aufhaengen kann. "
  );

  AddSpecialDetail( ({"holzstuecke","stuecke","holzstueck","stueck"}),
                                                    "detail_stueck" );
  AddSpecialDetail( ({"strick"}),                   "detail_strick" );

  AddCmd( CMD_NEHMEN, "cmd_nehmen" );

  AddExit( "osten",  GETEXIT("05_08") );
  AddExit( "westen", GETEXIT("03_08") );
}

string detail_strick(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_SEIL))
    return "Vielleicht solltest Du es zuerst nehmen.\n";

  return "Sowas siehst Du hier nicht\n";
}

string detail_stueck(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_SEIL))
    return BS("Die Holzstuecke stehen ca. 10 cm aus dem Brett heraus. An "
              "einem haengt ein Strick.");

  return "Die Holzstuecke stehen auf dem Brett heraus, da koennte man was "
         "aufhaengen.\n ";
}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail( "Was willst Du nehmen?\n" );
  if(!str || str == "") return 0;

  if(!(str == "strick"                ||
       str == "strick von holzstueck" ||
       str == "strick von stueck"     )) return 0;

  if(SMASTER->QueryFlag(TPUID,F_GET_SEIL)) return 0;

  ob = clone_object(OBJ "strick");
  if(ob->move(TP, M_GET) != 1)
  {
    TELLPLAYER("Du kannst aber nichts mehr tragen.\n");
    ob->remove();
    return 1;
  }

  TELLPLAYER("Du nimmst den Strick herunter.\n");
  SMASTER->SetFlag(TPUID,F_GET_SEIL);
  return 1;
}
