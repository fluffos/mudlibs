#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"fallgitter","gitter"}), "detail_gitter" );

  AddCmd( CMD_OEFFNEN,                      "cmd_oeffnen" );
  AddCmd( ({"schliess","schliesse"})      , "cmd_schliessen");

  AddExit( "norden", GETEXIT("06_07") );
  AddExit( "osten" , ([EX_DEST : GETEXIT("07_08"),EX_TESTFUNC : "exittest"]));

}

int exittest(string dir)
{
  if(SMASTER->QueryDoorStatus(TPUID,"I") == DOOROPENED) return 1;
  TELLPLAYER("Der Durchgang nach Osten ist durch ein geschlossenes "
             "Gitter blockiert.\n");
  return 0;
}

string _query_int_long()
{
  string s;

  if(SMASTER->QueryDoorStatus(TPUID,"I") == DOOROPENED)
  {
    s = "Im Osten befindet sich ein geoeffnetes Fallgitter. ";
  }
  else
  {
    s = "Im Osten befindet sich ein geschlossenes Fallgitter. ";
  }

  return BS(ltext1 + s);
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "gitter"         ||
       str == "fallgitter"     )) return 0;

  if(SMASTER->QueryDoorStatus(TPUID,"I") == DOOROPENED)
  {
    TELLPLAYER("Aber das Gitter ist doch schon offen.\n ");
    return 1;
  }

  TELLPLAYER("Das Gitter ist viel zu schwer, das wirst Du nie anheben "
             "koennen.\n");
  return 1;
}

string detail_gitter(string str)
{
  if(SMASTER->QueryDoorStatus(TPUID,"I") == DOOROPENED)
    return "Das Fallgitter ist geoeffnet, Du kannst durchgehen.\n";

  return "Das Fallgitter ist geschlossen.\n";
}


