#include "../def.h"

inherit ROOM "dung-inh";

#define ZU 0
#define OFFEN 1

int schrank;

void create()
{
  ::create();

  ltext2 = "An einer Wand des Raumes stehen ein Tisch und ein Schrank. ";

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An der Wand steht ein Tisch und ein Schrank. "
  );

  AddDetail( ({"schrank"}),
    "Der Schrank besteht aus Holz und schaut auch ziemlich alt aus. "
  );

  AddDetail( ({"tisch"}),
    "Der Tisch steht an der Wand neben dem Schrank und besteht gaenzlich "
    "aus Holz. Auf dem Tisch liegt lauter Geruempel. "
  );

  AddDetail( ({"holz"}),
    "Das Holz ist uralt, fast schon ganz verrottet, ein Wunder das "
    "hier noch was steht. "
  );

  AddDetail( ({"messing"}),
    "Messing? Ist so aehnlich wie Eisen. "
  );

  AddDetail( ({"eisen"}),
    "Eisen? Ist so aehnlich wie Messing. "
  );

  AddDetail( ({"geruempel"}),
    "Das Geruempel besteht aus lauter kaputten Geschirr, hier ist nichts "
    "mehr zu gebrauchen. "
  );

  AddDetail( ({"geschirr"}),
    "Du erkennst zwar, dass das Meiste aus Messing bestand, aber hier kann "
    "man nichts mehr brauchen. "
  );

  AddSpecialDetail( ({"sachen"}),                 "detail_sachen" );
  AddSpecialDetail( ({"messingteller","teller"}), "detail_teller" );
  AddSpecialDetail( ({"messingbecher","becher"}), "detail_becher" );
  AddSpecialDetail( ({"rest"}),                   "detail_rest" );
  AddSpecialDetail( ({"loeffel"}),                "detail_loeffel" );

  AddCmd( CMD_OEFFNEN,                "cmd_oeffnen" );
  AddCmd( CMD_NEHMEN,                 "cmd_nehmen" );
  AddCmd( ({"schliess","schliesse"}), "cmd_schliessen" );

  AddExit( "norden", GETEXIT("01_01") );

  schrank = ZU;
}

void reset()
{
  ::reset();

  schrank = ZU;
}

mixed detail_sachen(string str)
{
  if(schrank == OFFEN)
  {
    return BS(
      "Die Sachen sind schon sehr alt und rostig, Du siehst da ein "
      "Messingbecher und einige Messingteller. Der Rest ist schon ziemlich "
      "verrostet und uninteressant. ");
  }
  return 0;
}

mixed detail_teller(string str)
{
  if(schrank == OFFEN)
  {
    return BS(
      "Die Teller bestehen aus Messing und sind ziemlich verrostet. ");
  }
  return 0;
}

mixed detail_becher(string str)
{
  if(schrank == OFFEN)
  {
    if(SMASTER->QueryFlag(TPUID,F_GET_LOEFFEL))
      return "Der Becher besteht aus Messing und ist ziemlich stumpf.\n";

    return BS("Der Becher besteht aus Messing und ist ziemlich stumpf, im "
              "Becher steht ein Loeffel. ");
  }
  return 0;
}

mixed detail_rest(string str)
{
  if(schrank == OFFEN)
  {
    return BS(
      "Das ist sind lauter unnoetige Sachen, brauchst Du bestimmt nicht. ");
  }
  return 0;
}

mixed detail_loeffel(string str)
{
  if(!SMASTER->QueryFlag(TPUID,F_GET_LOEFFEL))
  {
    return BS(
      "Vielleicht solltest Du ihn einstecken. ");
  }
  return 0;
}

int cmd_nehmen(string str)
{
  object ob;
  int fehler;

  if(schrank == ZU) return 0;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "loeffel")) return 0;
  if(SMASTER->QueryFlag(TPUID, F_GET_LOEFFEL)) return 0;

  ob = clone_object(OBJ "loeffel");
  if(ob->move(TP, M_GET) != 1)
  {
    TELLPLAYER("Du kannst aber nichts mehr tragen.\n");
    ob->remove();
    return 1;
  }

  TELLPLAYER("Du nimmst den Loeffel aus dem Becher.\n");
  SMASTER->SetFlag(TPUID, F_GET_LOEFFEL);

  return 1;
}

int cmd_oeffnen(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(!str || str == "") return 0;
  if(!(str == "schrank")) return 0;

  if(schrank == ZU )
  {
    TELLPLAYER("Du oeffnest den Schrank und siehst einige Sachen darin "
               "liegen. \n");
    schrank = OFFEN;
  }
  else
  {
    TELLPLAYER("Aber der Schrank ist doch schon offen, es liegen einige "
               "Sachen darin. \n");
  }

  return 1;
}

int cmd_schliessen(string str)
{
  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;
  if(!(str == "schrank")) return 0;

  if(schrank == ZU)
  {
    TELLPLAYER("Der Schrank ist schon zu.\n");
  }
  else
  {
    TELLPLAYER("Du schliesst den Schrank. ");
    schrank = ZU;
  }

  return 1;
}



