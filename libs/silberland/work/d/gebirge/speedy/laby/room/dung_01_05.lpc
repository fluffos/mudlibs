#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "An der Wand entdeckst Du eine kleine Zeichnung. ";

  AddDetail( ({"zeichnung"}),
    "Auf der Zeichnung siehst Du an der einen Seite einen Untoten und an "
    "der zweiten eine Fackel. Wofuer das nur gut sein mag?"
  );

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An der Wand ist eine kleine Zeichnung eingraviert. "
  );

  AddDetail( ({"untoter"}),
    "Der Untote sieht schrecklich aus, wie eine Mumie. "
  );

  AddExit( "norden", GETEXIT("01_04") );
  AddExit( "osten",  GETEXIT("02_05") );
}
