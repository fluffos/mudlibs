#include "../def.h"

#define UNTEN 0
#define OBEN 1
#define LEER 0
#define VOLL 1

inherit ROOM "dung-inh";

int fuellung, eimer;

void create()
{
  ::create();

  ltext2 = "Ausserdem siehst Du in der Mitte des Raumes einen kleinen "
           "Brunnen.";

  AddDetail( ({"brunnen"}),
    "In der Mitte des Raumes ist ein kleiner Brunnen aufgebaut. Auf diesem "
    "ist eine Vorrichtung mit einer Kurbel gebaut, mit der man einen Eimer "
    "runterkurbeln und wieder hochkurbeln kann. "
  );

  AddDetail( ({"vorrichtung"}),
    "Die Vorrichtung besteht aus Holz und verhindert, dass der Eimer "
    "runterfallen kann. "
  );

  AddDetail( ({"holz"}),
    "Das Holz, aus dem die Vorrichtung besteht, ist schon ziemlich alt. "
  );

  AddDetail( ({"kurbel"}),
    "Mit der kann man den Eimer hoch kurbeln und auch wieder runter "
    "kurbeln. "
  );

  AddSpecialDetail( ({"eimer"}),  "detail_eimer" );
  AddSpecialDetail( ({"wasser"}), "detail_wasser" );

  AddCmd( ({"kurble","kurbel","kurbele"}), "cmd_kurbeln" );
  AddCmd( CMD_TRINKEN,                     "cmd_trinken" );

  AddExit( "norden", GETEXIT("09_03") );

  fuellung = LEER;
  eimer    = OBEN;
}

string detail_wasser(string str)
{
  if(eimer==OBEN)
  {
    if(fuellung == VOLL)
      return BS("Das Wasser in dem Eimer kann man sicher trinken, glaenzt "
                "auch schoen im Licht. ");

    return BS("Im Eimer ist kein Wasser, vielleicht solltest Du welches "
              "raufholen. ");
  }

  return NICHTDA;
}

string detail_eimer(string str)
{
  if( eimer == UNTEN )
    return "Der Eimer ist gerade im Brunnen, kurbel ihn doch rauf.\n";

  if(fuellung == VOLL)
      return "Ein stinknormaler Eimer, der mit Wasser gefuellt ist.\n";

  return BS("Ein stinknormaler leerer Eimer, vielleicht solltest Du "
            "versuchen ihn zu fuellen. ");
}

int cmd_kurbeln(string str)
{
  notify_fail("Was willst Du wohin kurbeln?\n");
  if(!str || str == "") return 0;

  if( str=="eimer runter" || str == "eimer herunter" )
  {
    if(eimer == UNTEN)
    {
      TELLPLAYER("Aber der Eimer ist doch schon unten.\n");
      return 1;
    }
    TELLPLAYER("Du kurbelst den Eimer nach unten.\n");
    fuellung = VOLL;
    eimer    = UNTEN;
    return 1;
  }

  if(str == "eimer hoch" || str == "eimer rauf")
  {
    if( eimer==OBEN )
    {
      TELLPLAYER("Aber der Eimer ist doch oben.\n");
      return 1;
    }
    TELLPLAYER("Du kurbelst den Eimer herauf.\n");
    eimer=OBEN;
    return 1;
  }
  return 0;
}

int cmd_trinken(string str)
{

  notify_fail("Woraus willst Du trinken?\n");
  if(!str || str == "") return 0;

  if(!(str == "aus eimer"       ||
       str == "wasser"          ||
       str == "wasser aus eimer")) return 0;

  if(eimer == UNTEN)
  {
    TELLPLAYER("Du siehst gar keinen Eimer.\n");
    return 1;
  }

  if(fuellung == LEER )
  {
    TELLPLAYER("Der Eimer ist LEER.\n");
    return 1;
  }

  if(TP->QueryProp(P_DRINK) + 20 > TP->QueryProp(P_MAX_DRINK) )
  {
    TELLPLAYER("Du kannst wirklich nichts mehr trinken!\n");
    return 1;
  }

  TP->AddProp(P_DRINK, 20);
  TP->heal_self(30);
  TELLPLAYER(BS("Du trinkst aus dem Eimer und fuehlst Dich von allen "
                "Schmerzen befreit. "));
  fuellung=LEER;
  return 1;
}
