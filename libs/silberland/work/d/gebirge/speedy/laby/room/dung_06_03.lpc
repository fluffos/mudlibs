#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  // eine Wand ist schon ziemlich erledigt. Man muss die Ritzen und Spalten
  // vergroessern (mit einem Loeffel) und kann dann mit einer Schaufel
  // durchgraben.

  AddDetail( ({"wand","waende","mauer","mauern","loch"}),
    "In der oestlichen Wand ist ein Loch, dort kannst Du durchklettern. "
  );

  AddCmd( CMD_KLETTERN, "cmd_klettern" );

  AddExit( "sueden", GETEXIT("06_04") );
}

int cmd_klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(!str || str == "") return 0;
  if(!(str=="loch"         ||
       str=="mauer"        ||
       str=="durch loch"   ||
       str=="durch mauer"  ||
       str=="wand"         ||
       str=="durch wand"   ||
       str=="in loch"      )) return 0;

  TELLPLAYER("Du kletterst durch das Loch nach Osten.\n");
  TP->move(GETEXIT("07_03"), M_GO|M_SILENT, "", "", "" );
  return 1;
}

