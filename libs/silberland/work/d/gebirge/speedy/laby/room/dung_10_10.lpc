#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  ltext2 = "An der Wand entdeckst Du einen Hebel. ";

  AddDetail( ({"hebel"}),
    "Ein ganz normaler Hebel, den man rauf und runterstellen kann. "
  );

  AddSpecialDetail( ({"tafel"}), "detail_tafel" );

  AddCmd( ({"ziehe","zieh"}),   "cmd_ziehen" );
  AddCmd( ({"stell","stelle"}), "cmd_stellen" );

  AddExit( "norden", GETEXIT("10_09") );

  SMASTER->SetStatus(TPUID, S_KRAFTFELD);
}

string detail_tafel(string str)
{
  string s;

  s = "Auf der Tafel steht nur EIN und AUS. Im Moment steht der Hebel "
      "auf ";

  if(SMASTER->QueryStatus(TPUID, S_KRAFTFELD))
    s += "EIN.";
  else
    s += "AUS.";

  return BS(s);
}

int cmd_ziehen(string str)
{
  notify_fail( "Woran willst Du ziehen?\n" );
  if(!str || str == "") return 0;
  if(!(str == "an hebel" || str == "hebel")) return 0;

  if(SMASTER->QueryStatus(TPUID,S_KRAFTFELD))
  {
    SMASTER->SetFlag(TPUID, F_KRAFTFELD);
    SMASTER->ClearStatus(TPUID, S_KRAFTFELD);
    TELLPLAYER("Du stellst den Hebel auf aus.\n");
    return 1;
  }

  TELLPLAYER("Du stellst den Hebel auf ein.\n");
  SMASTER->SetStatus(TPUID, S_KRAFTFELD);
  return 1;
}

int cmd_stellen(string str)
{
  notify_fail("Syntax: stelle hebel auf <ein | aus>\n");
  if(!str || str == "") return 0;

  if(str == "hebel auf ein" || str == "hebel ein")
  {
    if(SMASTER->QueryStatus(TPUID,S_KRAFTFELD))
    {
      TELLPLAYER("Der Hebel steht schon auf ein.\n");
    }
    else
    {
      TELLPLAYER("Du stellst den Hebel auf ein.\n");
      SMASTER->SetStatus(TPUID, S_KRAFTFELD);
    }
    return 1;
  }

  if(str == "hebel auf aus" || str == "hebel aus")
  {
    if(SMASTER->QueryStatus(TPUID,S_KRAFTFELD))
    {
      TELLPLAYER("Du stellst den Hebel auf aus.\n");
      SMASTER->SetFlag(TPUID,F_KRAFTFELD);
      SMASTER->ClearStatus(TPUID,S_KRAFTFELD);
    }
    else
    {
      TELLPLAYER("Der Hebel steht schon auf aus.\n");
    }
    return 1;
  }

  return 0;
}
