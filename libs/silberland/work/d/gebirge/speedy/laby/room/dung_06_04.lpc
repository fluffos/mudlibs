#include "../def.h"

inherit ROOM "dung-inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"fallgitter","gitter"}),    "detail_gitter" );
  AddSpecialDetail( ({"brett","lampen","lampe"}), "detail_brett" );

  AddSpecialDetail( ({"rote lampe"})  ,           "detail_rlampe" );
  AddSpecialDetail( ({"gruene lampe"}),           "detail_glampe" );
  AddSpecialDetail( ({"blaue lampe"}) ,           "detail_blampe" );

  AddDetail( ({"wand","waende","mauer","mauern"}),
    "An der Wand entdeckst du eine seltsame Vorrichtung. "
  );

  AddDetail( "vorrichtung",
    "Die Vorrichtung sieht aus wie ein Automat, mit einem Muenzschlitz. "
  );

  AddDetail( ({"automat"}),
    "In diesen Automaten kann man mittels des Muenzschlitzes Muenzen "
    "reinwerfen, gleich daneben siehst Du ein kleines Brett. "
  );

  AddDetail( ({"schlitz","muenzschlitz"}),
    "Dieser Schlitz dient dazu, dass man Muenzen in diese Vorrichtung "
    "einwerfen kann. "
  );

  AddCmd( CMD_OEFFNEN,               "cmd_oeffnen" );
  AddCmd( ({"wirf","werfe","werf"}), "cmd_werfen" );

  AddExit("osten",  GETEXIT("07_04") );
  AddExit("norden", GETEXIT("06_03") );
  AddExit("sueden", GETEXIT("06_05") );
  AddExit("westen", ([EX_DEST : GETEXIT("05_04"),EX_TESTFUNC : "exittest"]));
}

int exittest(string dir)
{
  if(SMASTER->QueryDoorStatus(TPUID,"K") == DOOROPENED) return 1;
  TELLPLAYER("Der Durchgang nach Westen ist durch ein geschlossenes "
             "Gitter blockiert.\n");
  return 0;
}

string _query_int_long()
{
  string s;

  if(SMASTER->QueryDoorStatus(TPUID,"K") == DOOROPENED)
    s = "Im Westen befindet sich ein offenes Fallgitter. ";
  else
    s = "Im Westen befindet sich ein geschlossenes Fallgitter. ";

  return BS(ltext1+s);
}

void check(string color)
{
  string s;

  s = "Du wirfst die "+color+"e Muenze in den Muenzschlitz. Die "+color+
      "e Lampe leuchtet daraufhin auf. ";

  if(SMASTER->QueryFlag(TPUID,F_ROT_DRINNEN)  &&
     SMASTER->QueryFlag(TPUID,F_BLAU_DRINNEN) &&
     SMASTER->QueryFlag(TPUID,F_GRUEN_DRINNEN) )
  {
    s += "Ploetzlich faengt alles zu Rumpeln an und das Fallgitter "
         "westlich von Dir oeffnet sich.";

    SMASTER->SetFlag(TPUID,F_TUER_K_OFFEN);
    SMASTER->SetDoorStatus(TPUID,"K",DOOROPENED);
  }

  TELLPLAYER(BS(s));
  return;
}

int cmd_werfen(string str)
{
  object ob;

  notify_fail( "Was willst Du wo einwerfen?\n" );
  if(!str || str == "") return 0;

  if((str == "muenze in schlitz"       ||
      str == "geld in schlitz"         ||
      str == "muenze in muenzschlitz"  ||
      str == "geld in muenzschlitz"    ||
      str == "muenze in automat"       ||
      str == "geld in automat"         ))
  {
    if(TP->QueryMoney() > 0)
    {
      TELLPLAYER("Du wirfst eine Muenze in den Automaten.\n");
      TP->AddMoney(-1);
    }
    else
    {
      TELLPLAYER("Aber Du hast ja gar kein Geld.\n");
    }
    return 1;
  }

  if((str=="rote muenze in schlitz")     ||
     (str=="rote muenze in automat")     ||
     (str=="rote muenze in muenzschlitz") )
  {
    if(ob = present("\nspy_rote_muenze",TP))
    {
      SMASTER->SetFlag(TPUID, F_ROT_DRINNEN);
      check("rot");
      ob->remove();
      return 1;
    }
    return 0;
  }

  if( (str=="blaue muenze in schlitz")     ||
      (str=="blaue muenze in automat")     ||
      (str=="blaue muenze in muenzschlitz") )
  {
    if(ob = present("\nspy_blaue_muenze", TP))
    {
      SMASTER->SetFlag(TPUID,F_BLAU_DRINNEN);
      check("blau");
      ob->remove();
      return 1;
    }
    return 0;
  }

  if( (str=="gruene muenze in schlitz")     ||
      (str=="gruene muenze in automat")     ||
      (str=="gruene muenze in muenzschlitz") )
  {
    if(ob = present("\nspy_gruene_muenze", TP))
    {
      SMASTER->SetFlag(TPUID,F_GRUEN_DRINNEN);
      check("gruen");
      ob->remove();
      return 1;
    }
    return 0;
  }

  return 0;
}

string detail_rlampe(string str)
{
  string s;

  s  = "Die rote Lampe leuchtet ";
  s += SMASTER->QueryFlag(TPUID,F_ROT_DRINNEN)   ? "hell.\n" : "nicht.\n";

  return s;
}

string detail_glampe(string str)
{
  string s;

  s  = "Die gruene Lampe leuchtet ";
  s += SMASTER->QueryFlag(TPUID,F_GRUEN_DRINNEN)   ? "hell.\n" : "nicht.\n";

  return s;
}

string detail_blampe(string str)
{
  string s;

  s  = "Die blaue Lampe leuchtet ";
  s += SMASTER->QueryFlag(TPUID,F_BLAU_DRINNEN)   ? "hell.\n" : "nicht.\n";

  return s;
}

string detail_brett(string str)
{
  return "Auf dem Brett siehst Du drei Lampen: \n"+
         detail_rlampe("")+detail_glampe("")+detail_blampe("");
}

string detail_gitter(string str)
{
  if(SMASTER->QueryDoorStatus(TPUID,"K") == DOOROPENED)
    return "Das Gitter im Westen ist offen.\n";

  return "Das Gitter im Westen ist geschlossen, das geht sicherlich nich so "
         "leicht aiuf.\n";
}


