#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Holzstueck");
  SetProp( P_LONG,
    "Das ist ein Holzstueck, dass die Form eines Ys hat, vielleicht kann "
    "man damit was basteln."
  );

  AddId( ({"holzstueck","holz","stueck","\nspy_holz"}) );
  SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
  SetProp(P_NAME,"Y-Holzstueck" );
  SetProp(P_GENDER, NEUTER );
  SetProp(P_WEIGHT, 100 );

  AddCmd( ({"bastel","bastle","bastele"}), "cmd_basteln" );
}

int cmd_basteln(string str)
{
  TELLPLAYER("Vielleicht solltest Du etwas an das Holz anbinden.\n");
  return 1;
}
