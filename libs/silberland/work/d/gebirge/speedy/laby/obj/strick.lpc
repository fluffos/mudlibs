#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Strick" );
  SetProp(P_LONG,
    "Hier hast Du einen Strick, der ist ca. 10 Meter lang. "
  );

  AddId( ({"strick","\nspy_strick"}) );
  SetProp(P_MATERIAL, MAT_CANNABIS );
  SetProp(P_NAME, "Strick");
  SetProp(P_GENDER, MALE );
  SetProp(P_WEIGHT, 250 );
}
