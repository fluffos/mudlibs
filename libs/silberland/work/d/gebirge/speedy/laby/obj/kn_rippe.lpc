#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Eine Rippe" );
  SetProp(P_LONG,
    "Das ist eine Rippe eines Skeletts, sie ist voellig fleischlos."
  );

  AddId( ({"rippe","knochen","rippenknochen","\nspy_rippe"}) );
  SetProp(P_MATERIAL, ([MAT_BONE:100]) );
  SetProp(P_NAME,"Rippenknochen" );
  SetProp(P_GENDER, FEMALE );
  SetProp(P_WEIGHT, 250 );
}

