#include "../def.h"

inherit OBJ "std_obj";

string rollentext;

string detail_rolle();

void create()
{
  string s,wort;
  int c,i,j,k,slen,punkt;
  int n_woerter,n_buchstaben,count;

  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Eine alte Schriftrolle");
  SetProp( P_LONG,
    "Du haelst eine alte Schriftrolle in Deinen Haenden. "
  );

  AddId( ({"schriftrolle","rolle","\nspy_rolle"}) );

  SetProp(P_NAME_ADJ, "alt");
  AddAdjective( ({"alten","alter","altem","altes","alte"}) );

  SetProp(P_MATERIAL, ([MAT_PAPER:100]) );
  SetProp(P_NAME,"Schriftrolle" );
  SetProp(P_GENDER, FEMALE );
  SetProp(P_WEIGHT, 150 );

  AddReadDetail( ({"rolle","schriftrolle"}) , #'detail_rolle);

  s          = "abcdefghijklmnopqrstuvwxyz";
  slen       = strlen(s);
  rollentext = "";
  punkt      = 1;
  count      = 0;

  n_woerter = 60 + random(20);

  for(i=0;i<n_woerter;i++)
  {
    n_buchstaben = 3 + random(5);
    wort = "";
    for(j=0;j<n_buchstaben;j++)
    {
      k = random(slen);
      wort += s[k..k];
    }
    if(punkt || (!random(5))) wort = capitalize(wort);

    rollentext += wort;
    punkt = 0;
    if((!random(7) && count > 3) || count > 9)
    {
      punkt = 1;
      count = 0;
      rollentext += ". ";
    }
    else
    {
      count++;
      rollentext += " ";
    }
  }

  rollentext = BS(rollentext[0..<2] + ".");
}

string detail_rolle()
{
  return "Auf der Schriftrolle steht:\n"+rollentext+"\nWas das wohl heissen "
      "mag ...\n";
}


