#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein rostiger Eisenschluessel");
  SetProp(P_LONG,
    "Das ist ein sehr rostiger Eisenschluessel, aber verwenden kann man "
    "ihn bestimmt noch. "
  );

  AddId( ({"\nspy_eisenschluessel","schluessel","eisenschluessel"}) );

  SetProp(P_NAME_ADJ, "rostig");
  AddAdjective( ({"rostigen","rostiger","rostigem","rostiges"}) );

  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 200);
}
