#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Loeffel");
  SetProp( P_LONG,
    "Ein stinknormaler Loeffel, etwas rostig, aber immer noch ein "
    "Loeffel. "
  );

  SetProp(P_INFO, BS(
    "Dieser Loeffel kann ueberhaupt nichts. Das ist nur ein Loeffel, und "
    "nicht mehr. "
  ));

  AddId( ({"loeffel","\nspy_loeffel"}) );

  SetProp(P_NAME_ADJ, "rostig");
  AddAdjective( ({"rostigen","rostiger","rostigem","rostiges","rostige"}) );

  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_NAME,"Loeffel");
  SetProp(P_GENDER, MALE );
  SetProp(P_WEIGHT, 50 );
}

