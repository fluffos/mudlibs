#include "../def.h"

inherit OBJ "std_obj";

string farbe;

void create()
{
  if(!is_clone(TO)) return;

  farbe = "";

  ::create();

  AddId( ({"muenze"}) );
  SetProp(P_MATERIAL, ([MAT_GOLD:100]) );
  SetProp(P_NAME, "Muenze");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 50 );
}

void Customize(string f)
{
  farbe = f;

  SetProp(P_NAME_ADJ, f);
  AddAdjective( ({f+"en",f+"er",f+"em",f+"es",f+"e"}) );

  AddId( ({"\nspy_"+f+"e_muenze"}) );
}

string _query_short()
{
  string s;

  s = (farbe == "") ? "" : " "+farbe+"e";

  return "Eine"+s+" Muenze";
}

string _query_long()
{
  string s;

  s = (farbe == "") ? "" : " "+farbe+"e";

  return BS("Das ist eine"+s+" Muenze, sie ist etwas kleiner als die "
            "normalen Muenzen, und auch etwas schwerer.");
}
