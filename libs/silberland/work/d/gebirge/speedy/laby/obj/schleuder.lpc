#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Eine Steinschleuder");
  SetProp(P_LONG,
    "Das ist eine Steinschleuder, mit der kann man Steine schleudern. Wer "
    "haette das gedacht?"
  );

  AddId( ({"schleuder","steinschleuder","\nspy_schleuder"}) );
  SetProp(P_MATERIAL, ([MAT_GUM:20, MAT_WOOD:80]) );
  SetProp(P_NAME, "Steinschleuder" );
  SetProp(P_GENDER, FEMALE );
  SetProp(P_WEIGHT, 150 );

  AddCmd( ({"schleuder","schleudere"}), "cmd_schleudern" );
}

int cmd_schleudern(string str)
{
  object ob;

  notify_fail("Was moechtest Du schleudern?\n");

  if(!str || str == "") return 0;
  if(!(str == "stein"             ||
       str == "stein auf knopf"   ||
       str == "stein gegen knopf" )) return 0;

  if(!(ob=present("stein",TP)))
  {
    TELLPLAYER("Du hast keinen Stein bei Dir.\n");
    return -1;
  }

  if(ob->QueryProp(P_WEIGHT) > 150)
  {
    TELLPLAYER(BS(ob->Name(WER)+" ist zu schwer um ihn mit der Schleuder "
                  "fortzuschiessen."));
    return -1;
  }

  if(!ob->id("\nspy_stein"))
  {
    TELLPLAYER(BS("Du schiesst einen Stein mit der Schleuder fort und "
                  "hoerst ihn irgendwo in den Gaengen aufschlagen und "
                  "fortkullern."));
    ob->remove();
    return -1;
  }

  if(str == "stein")
  {
    TELLPLAYER(BS("Du schleuderst einen Stein einfach so durch die Gegend. "
                  "Machts Spass? Du hoerst beim Aufprall, dass der Stein "
                  "zerbricht."));
    ob->remove();
    return 1;
  }

  if(SMASTER->QueryDoorStatus(TPUID,"G") == DOOROPENED)
  {
    TELLPLAYER(BS("Du schiesst einen Stein auf den Knopf, aber nichts "
                  "passiert. Der Stein zerbricht, als er auf dem Boden "
                  "aufschlaegt. "));
    ob->remove();
    return 1;
  }

  if(ENV(TO) && (ENV(ENV(TO)) == ENV(ENV(TO))->ort()) )
  {
    TELLPLAYER(BS("Du schleuderst einen Stein auf den Knopf hinter dem "
                  "Gitter. Der Stein zerbricht wie er auf den Boden "
                  "aufschlaegt und das Gitter oeffnet sich laut rasselnd. "));
    SMASTER->SetDoorStatus(TPUID,"G",DOOROPENED);
    ob->remove();
    return 1;
  }

  TELLPLAYER(BS("Du schleuderst einen Stein einfach so durch die Gegend. "
                "Machts Spass? Du hoerst beim Aufprall, dass der Stein "
                "zerbricht."));
  ob->remove();
  return -1;
}


