#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Eine Kette" );
  SetProp(P_LONG,
    "Eine gut gearbeitete Kette, die ca. 2 Meter lang ist, vielleicht kann "+
    "man sie fuer irgendwas verwenden. "
  );

  AddId( ({"kette","\nspy_kette"}) );
  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_NAME,"Kette" );
  SetProp(P_GENDER, FEMALE );
  SetProp(P_WEIGHT, 5000 );
}
