#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein kleiner Stein");
  SetProp( P_LONG,
    "Du haeltst einen kleinen Stein in Deinen Haenden, vielleicht kannst Du "
    "ihn wo dagegen schiessen. "
  );

  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines"}) );

  AddId( ({"stein","\nspy_stein"}) );
  SetProp(P_MATERIAL, ([MAT_STONE:100]) );
  SetProp(P_NAME, "Stein");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 100 );
}
