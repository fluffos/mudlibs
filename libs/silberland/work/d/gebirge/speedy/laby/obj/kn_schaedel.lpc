#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Schaedelknochen");
  SetProp(P_LONG,
    "Das ist der Schaedelknochen eines Skeletts, er ist voellig "
    "fleischlos."
  );

  SetProp(P_INFO,
    BS("Der Schaedel scheint irgendwas in sich zu haben, vielleicht "
       "kannst Du es irgendwie rauskriegen.")
  );

  AddId( ({"knochen","schaedel","schaedelknochen","\nspy_schaedel"}) );
  SetProp(P_MATERIAL, ([MAT_BONE:100]) );
  SetProp(P_NAME,"Schaedelknochen" );
  SetProp(P_GENDER, MALE );
  SetProp(P_WEIGHT, 250 );

  AddCmd( ({"brich","breche","brech","zerlege","zerleg"}), "cmd_oeffnen" );
  AddCmd( CMD_OEFFNEN,                                     "cmd_oeffnen" );
}

int cmd_oeffnen(string str)
{
  object ob;

  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "schaedel"            ||
       str == "schaedelknochen"     ||
       str == "schaedel auf"        ||
       str == "schaedelknochen auf" ||
       str == "knochen"             ||
       str == "knochen auf"         )) return 0;

  TELLPLAYER(BS("Du oeffnest den Schaedelknochen und findest ein Stueck "
                "Draht darin. ") );

  ob=clone_object(OBJ "draht");
  ob->move(TP, M_NOCHECK); //kein Gewichtscheck, da schaedel entfernt wird

  SMASTER->SetFlag(TPUID, F_BRICH_SCHAEDEL);

  RemoveCmd( ({"brich","breche","brech","zerlege","zerleg"}));
  RemoveCmd( CMD_OEFFNEN                                    );

  call_out("remove",0);
  return 1;
}

