#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Armknochen");
  SetProp(P_LONG,
    "Du haelst einen Knochen eines Armes in Deinen Haenden, er ist voellig "+
    "fleischlos."
  );

  AddId( ({"knochen","arm","armknochen","\nspy_arm"}) );
  SetProp(P_MATERIAL, ([MAT_BONE:100]) );
  SetProp(P_NAME,"Armknochen");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 250 );
}

