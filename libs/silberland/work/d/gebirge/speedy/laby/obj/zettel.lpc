#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein ziemlich zerfetzter Zettel");
  SetProp(P_LONG,
    "Du haeltst einen etwas zerfetzten Zettel in Deinen Haenden, Du kannst "
    "ihn lesen. "
  );

  AddId( ({"zettel","\nspy_zettel"}) );

  SetProp(P_NAME_ADJ, "zerfetzt");
  AddAdjective( ({"zerfetzten","zerfetzter","zerfetztem","zerfetztes"}) );

  SetProp(P_MATERIAL, ([MAT_PAPER:100]) );
  SetProp(P_NAME,"Zettel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10);

  AddReadDetail( ({"zettel"}),
    "Der Zettel ist schon arg zerfetzt, du kannst nur noch eine Zahl darauf "
    "erkennen: "+SMASTER->QueryCode1(TPUID)+"."
  );
}


