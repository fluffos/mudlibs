#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp( P_SHORT,"Ein Seil mit Haken" );
  SetProp( P_LONG,
    "Du hast hier ein Seil an dessen Ende ein Haken befestigt ist, jetzt "
    "brauchst Du nur noch die Fische zum angeln suchen. "
  );

  AddId( ({"seil","hakenseil","\nspy_seil-haken"}) );

  SetProp(P_MATERIAL, ([MAT_CLOTH:80, MAT_IRON:20]) );
  SetProp(P_NAME, "Strick");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 350);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 1);
}

