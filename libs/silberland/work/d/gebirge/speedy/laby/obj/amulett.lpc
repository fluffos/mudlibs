#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein achteckiges Amulett");
  SetProp(P_LONG,
    "Dies ist ein Amulett, das einzige seltsame daran ist, dass es acht "
    "Ecken hat. "
  );

  AddId( ({"amulett","\nspy_amulett"}) );

  SetProp(P_NAME_ADJ, ({"achteckig"}) );
  AddAdjective( ({"achteckigen"
                 ,"achteckiger"
                 ,"achteckigem"
                 ,"achteckiges"
                 ,"achteckige"
                 })
  );

  SetProp(P_MATERIAL, ([MAT_CERAMIC:100]) );
  SetProp(P_NAME, "Amulett");
  SetProp(P_GENDER, NEUTER );
  SetProp(P_WEIGHT, 500 );


  AddDetail( ({"ecke","ecken"}) ,
    "Es sind genau acht Ecken."
  );

}
