#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein kurzes Drahtstueck" );
  SetProp( P_LONG,
    "Du siehst ein kurzes Drahtstueck, vielleicht kann man es zu was "+
    "verwenden. "
  );

  AddId( ({"draht","drahtstueck","\nspy_draht"}) );

  SetProp(P_NAME_ADJ, "kurz");
  AddAdjective( ({"kurzen","kurzer","kurzem","kurzes"}) );

  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_NAME, "Drahtstueck");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 100);

  SetProp( P_INFO,
    BS("Du untersuchst das Drahtstueck ganz genau und biegst es auch hin "
       "und her, kannst aber nichts besonderes entdecken.\n" )
  );

  AddCmd( ({"verbiege","verbieg","bieg","biege"}), "cmd_biegen" );
}

int cmd_biegen(string str)
{
  object ob;

  notify_fail("Was moechtest Du biegen?\n");

  if(!str || str == "") return 0;
  if(!id(str)) return 0;

  TELLPLAYER(BS("Du biegst etwas an dem Drahtstueck herum und haelst auf "
                "einmal einen Haken in den Haenden."));

  ob=clone_object(OBJ "haken");
  ob->move(TP, M_NOCHECK);

  SMASTER->SetFlag(TPUID,F_BIEGE_DRAHT);

  RemoveCmd( ({"verbiege","verbieg","bieg","biege"}) );
  call_out("remove",0);

  return 1;
}

