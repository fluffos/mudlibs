#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Eine stabile Schaufel" );
  SetProp( P_LONG,
    "Diese Schaufel ist etwas kleiner als eine Normale und sieht sehr stabil "
    "aus Man kann mit ihr aber genausogut graben. ");
  AddId( ({"schaufel","\nspy_schaufel"}) );

  SetProp(P_NAME_ADJ, "stabil");
  AddAdjective( ({"stabilen","stabiler","stabilem","stabiles","stabile"}) );

  SetProp(P_NAME, "Schaufel" );
  SetProp(P_GENDER, FEMALE );
  SetProp(P_VALUE, 50 );
  SetProp(P_WEIGHT, 1200 );
}
