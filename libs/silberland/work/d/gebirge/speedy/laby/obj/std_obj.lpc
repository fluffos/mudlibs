#include "../def.h"

inherit "/std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  AddId( ({SARUMANID}) );

  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 1);

  SUID;
}
