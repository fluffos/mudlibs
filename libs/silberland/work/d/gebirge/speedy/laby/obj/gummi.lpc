#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Gummiband");
  SetProp( P_LONG,
    "Das ist ein Gummiband, ziemlich stark und fest. Der Gummi, laesst sich "
    "leicht ausdehnen, vielleicht kannst du ihn wo anbinden. "
  );

  AddId( ({"gummi","gummiband","band","\nspy_gummi"}) );
  SetProp(P_MATERIAL, ([MAT_GUM:100]) );
  SetProp(P_NAME, "Gummiband" );
  SetProp(P_GENDER, NEUTER );
  SetProp(P_WEIGHT, 50 );

  AddCmd( ({"befestige","binde","bind"}), "cmd_binden" );
}

int cmd_binden(string str)
{
  object ob;

  notify_fail("Was moechtest Du woran binden?\n");

  if(!str || str == "") return 0;

  if(!(str == "band an holz"             ||
       str == "gummi an holz"            ||
       str == "gummiband an holz"        ||
       str == "band an holzstueck"       ||
       str == "gummi an holzstueck"      ||
       str == "gummiband an holzstueck"  ||
       str == "band an stueck"           ||
       str == "gummi an stueck"          ||
       str == "gummiband an stueck"      )) return 0;

  if(!(ob=present("\nspy_holz",TP)))
  {
    TELLPLAYER("Du hast kein geeignetes Holzstueck dabei.\n");
    return 1;
  }

  ob->remove();
  ob=clone_object(OBJ "schleuder");
  ob->move(TP, M_NOCHECK);

  SMASTER->SetFlag(TPUID,F_BEFESTIGE_GUMMI);

  TELLPLAYER(BS("Du bindest das Gummiband an das Holzstueck und erhaeltst "
                "eine Schleuder."));

  RemoveCmd( ({"befestige","binde","bind"}) );
  call_out("remove",0);

  return 1;
}


