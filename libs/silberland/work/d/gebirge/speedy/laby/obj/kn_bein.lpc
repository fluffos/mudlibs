#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Beinknochen");
  SetProp(P_LONG,
    "Hier siehst Du einen Beinknochen eines Skeletts, er ist voellig "+
    "fleischlos."
  );

  AddId( ({"knochen","bein","beinknochen","\nspy_bein"}) );
  SetProp(P_MATERIAL, ([MAT_BONE:100]) );
  SetProp(P_NAME,"Beinknochen" );
  SetProp(P_GENDER, MALE );
  SetProp(P_WEIGHT, 250 );
}

