#include "../def.h"

inherit OBJ "std_obj";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Haken");
  SetProp(P_LONG,
    "Du haeltst einen kleinen Haken in Deinen Haenden, den muesstest Du "
    "noch wo festbinden. "
  );

  AddId( ({"haken","\nspy_haken"}) );

  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines"}) );

  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_NAME, "Haken");
  SetProp(P_GENDER, MALE );
  SetProp(P_WEIGHT, 100 );

  AddCmd( ({"bind","binde","befestige"}), "cmd_befestigen" );
}

int cmd_befestigen(string str)
{
  object ob;

  notify_fail("Was moechtest Du woran befestigen?\n");

  if(!str || str == "") return 0;
  if(!(str == "haken an strick"         ||
       str == "strick an haken"         )) return 0;

  if(!(ob=present("\nspy_strick",TP)))
  {
    TELLPLAYER("Du hast doch gar keinen geeigneten Strick dabei.\n");
    return 1;
  }

  ob->remove();

  ob = clone_object(OBJ "haken-seil");
  ob->move(TP, M_NOCHECK);

  SMASTER->SetFlag(TPUID, F_BEFESTIGE_HAKEN);

  TELLPLAYER("Du befestigst den Haken an dem Seil.\n");

  RemoveCmd( ({"bind","binde","befestige"}) );
  call_out("remove",0);

  return 1;
}

