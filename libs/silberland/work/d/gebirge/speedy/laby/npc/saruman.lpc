#include "../def.h"

inherit "std/npc";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <ansi.h>

#define NPCNAME "saruman"

string info_belohnung();
string info_fortschritt();

string *flop;
string *pl;

void Chats(int i)
{
  if(i)
  {
    SetChats(10,
      ({Name(WER)+" murmelt was in seinen Bart.\n"
       ,Name(WER)+" geht verzweifelt auf und ab.\n"
       ,Name(WER)+" sagt: Wenn ich nur wuesste, wer helfen kann.\n"
       })
    );
  }
  else
  {
    SetChats(10,
      ({Name(WER)+" murmelt was in seinen Bart.\n"
       ,Name(WER)+" geht verzweifelt auf und ab.\n"
       ,Name(WER)+" sagt: Wie lange dauert das denn noch?\n"
       })
    );

  }
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, capitalize(NPCNAME));
  SetProp(P_LONG,
    "Das ist "+capitalize(NPCNAME)+", ein alter weiser Mann. Er hat einen "
    "langen weissen Bart, und schoene Kleidung an. Ausserdem sieht er "
    "nicht gar froehlich aus. Er geht im Zimmer auf und ab als wenn er "
    "grosse Sorgen haette. "
  );

  SetProp(P_NAME, capitalize(NPCNAME));
  AddId(NPCNAME,"NOCONTROL","NOWIMPY");
  set_living_name(NPCNAME);

  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  AddClass(CL_HUMAN);

  create_default_npc(25);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_ALIGN, 250);
  SetProp(P_SIZE, 180);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 20);

  SetProp(P_REJECT,
    ({REJECT_GIVE,Name(WER)+" sagt: Behalte es, wirst Du brauchen.\n"}) );

  SetProp(P_NOATTACK, "schaut Dich nur traurig an.");
  SetProp(P_ARTICLE, 0 );
//SetProp(P_LOG_INFO, "speedy.saruman");

  AddDetail( ({"bart"}),
    "Der Bart ist weiss und lang, er haengt fast bis zum Boden herab."
  );

  AddDetail( ({"kleidung"}),
    Name(WESSEN)+" Kleidung ist sehr schoen und glaenzt im Licht des "
    "Raumes, die war bestimmt sehr teuer. "
  );

  AddCmd( ({"biete"}), "cmd_helfen" );

  SetProp( P_DEFAULT_INFO,
    "sagt: Davon weiss ich leider nichts.\n");

  AddInfo( ({"hilfe","aufgabe","quest","sorgen"}),
    "Ich suche jemanden, der sich in das Labyrinth der Untoten begibt "
    "und mir meine Schriftrolle findet.",
    "sagt: "
  );

  AddInfo( ({"labyrinth"}),
    "Das Labyrinth ist furchtbar und grauenvoll, ich wuerde mich da nie "
    "hinunter trauen. ",
    "meint aengstlich: "
  );

  AddInfo( ({"untote","untoten","hunde"}),
    "Die gemeinen Hunde haben mir meine wertvollste Schriftrolle gestohlen, "
    "und sie irgendwo in dem Labyrinth versteckt. Wenn ich nicht so feige "
    "waere, haette ich sie mir schon geholt. ",
    "sagt: "
  );

  AddInfo( ({"schriftrolle","rolle"}),
    "Die Schriftrolle ist sehr maechtig, sie bedeutet fuer mich alles. Einst "
    "habe ich wichtige Bemerkungen darauf geschrieben, die ich jetzt "
    "brauchen wuerde. ",
    "erzaehlt: "
  );

  AddInfo( ({"bemerkung","bemerkungen"}),
    "Es handelt sich dabei um wichtige Zaubersprueche, die man fuer "
    "viele Zwecke verwenden kann. Ich koennte Dich ja einen lehren, aber "
    "Du musst mir schon zuerst die Schriftrolle bringen. Wenn Du mir helfen "
    "willst biete mir einfach Deine Hilfe an. ",
    "sagt: "
  );

  AddInfo( ({"zaubersprueche","sprueche","zauber"}),
    "Die Zauber sind sehr, sehr maechtig. Vielleicht die Maechtigesten "
    "im Silberland. ",
    "meint: "
  );

  AddInfo( ({"feig","feigheit"}),
    "Meine Feigheit ist so gross, ich schaeme mich dafuer. ",
    "sagt beschaemt: "
  );

  AddInfo( ({"silberland"}),
    "Silberland ist schoen, nicht wahr?",
    "sagt froehlich: "
  );

  AddInfo( ({"speedy"}),
    "Speedy hat mich und das Labyrinth der Untoten erbaut. ",
    "murmelt: "
  );

  AddInfo( ({"angrox"}),
    "Angrox ist ein grosser Magier, der Papa von Speedy. ",
    "sagt stolz: "
  );

  AddInfo( ({"belohnung"}) ,
    #'info_belohnung
    ,
    "meint: "
  );

  AddInfo( ({"fortschritt"}) ,
    #'info_fortschritt
    ,
    "murmelt: "
  );

  AddCmd( ({"biete","hilf","helf","helfe"}), "cmd_helfen" );

  flop = ({ });
  pl   = ({ });

  Chats(1);
}

void Msg(object pl)
{
  tell_object(pl, BSI("Die Zeit ist um, ich kann Dich nicht laenger "
                      "beschuetzen. Leider hast Du es nicht geschafft, "
                      "die Schriftrolle zu finden. ", Name(WER)+ " sagt "
                      "enttaeuscht: "));

  SMASTER->DeleteQuester(getuuid(pl));
  flop += ({ getuuid(pl) });

  Chats(1);
}

void EndQuest(string uuid)
{
  object player;
  string s;

  SMASTER->DeleteQuester(uuid);
  flop += ({ uuid });

  player = find_player(explode(uuid, "_")[0]);

  if(!player) return;

  s = "Die Zeit ist um, ich kann Dich nicht laenger beschuetzen. "
      "Leider hast Du es nicht geschafft, die Schriftrolle zu "
      "finden. ";

  if((ENV(player) != ENV(TO))                             &&
     (file_name(ENV(player))[0..strlen(ROOM)-1] == ROOM)   )
  {
    s += "Zu Deiner Sicherheit teleportiere ich Dich aus dem Labyrinth "
         "heraus. ";

    player->move(ENV(TO), M_GO, "in einem blaeulichen Leuchten",
      "erscheint", "verschwindet in einem blaeulichen Leuchten"
    );
  }

  s = BSI(s, Name(WER)+" teilt Dir mit: ");

  if(player->QueryProp(P_TTY))
    s = ANSI_BOLD+ANSI_RED+s[0..<2]+ANSI_NORMAL+"\n";

  tell_object(player, s);

  Chats(1);
}

public void learn_bard_magic_eye(object pl) {
  if(!pl->QueryQuest(SPEEDYLABYQUEST)) return;
  command_me(sprintf("sag Ah! Gut, dass du da bist, %s! Ich denke jetzt ist "
             "es an der Zeit dir zu zeigen, was auf der Schriftrolle war, die "
            "du fuer mich gefunden hast.", pl->Name(WER)));
  tell_room(environment(this_object()), sprintf("%s zeigt %s eine alte Schriftrolle.\n", 
            this_object()->Name(WER), pl->name(WEM)), ({pl}));
  tell_object(pl, sprintf("%s zeigt Dir eine alte Schriftrolle.\n", Name(WER)));
  call_out("LearnBardSpell", 2, this_player(), "die strasse gleitet fort", 
               "Dieses Lied laesst deine Sinne aus deinem Koerper treten, und dich so an "
               "Orte gehen, ohne wirklich dort zu sein.", 
               "spiele 'die strasse gleitet fort'");
  return;
}

void init()
{
  ::init();

  if(!is_clone(TO)) return;

  if(!TP)                              return;
  if(!interactive(TP))                 return;

  if(TP->QueryProp(P_GUILD) == "bardengilde" &&
  TP->QueryProp(P_GUILD_LEVEL) > 6 &&
  TP->QuerySkill("die strasse gleitet fort") == 0) {
    call_out("learn_bard_magic_eye", 1, TP);
  }

  if(!SMASTER->IsQuester(getuuid(TP))) return;
  if(SMASTER->QueryTimeLimit(getuuid(TP))) call_out("Msg", 0, TP);
}

void reset()
{
  ::reset();

  if(!is_clone(TO)) return;

  flop = ({ });
  pl   = ({ });

  if(sizeof(SMASTER->QueryQuester()) == 0) Chats(1);
}

int RemoveQuestThings(object player)
{
  object *inv;
  int i;

  inv = filter_objects(deep_inventory(player), "id", SARUMANID);

  if(i = sizeof(inv))
  {
    tell_object(player,BSI("Na da hast Du ja noch jede Menge anderer "
                           "Gegenstaende aus dem Labyrinth mitgebracht, "
                           "zeig mal her.",Name(WER)+" sagt "
                           "interessiert: "));
    tell_object(player, Name(WER)+" nimmt Dir einige Gegenstaende ab.\n");
    while(i--) inv[i]->remove();
  }
  return 1;
}

int cmd_helfen(string str)
{
  object ob, player;
  string *uuid, s;

  notify_fail("Was willst Du wem (an)bieten?\n");
  if(!str || str == "") return 0;
  if(!(str == "hilfe an"          ||
       str == NPCNAME+" hilfe an" ||
       str == NPCNAME             )) return 0;


  if(member(flop, getuuid(TP)) > -1)
  {
    tell_object(TP, BSI("Ich habe zur Zeit keine Kraft, Dich noch einmal "
                        "in dem Labyrinth zu beschuetzen. Komm spaeter "
                        "nochmal. ", Name(WER)+" seufzt: "));
    return -1;
  }

  if(SMASTER->IsQuester(TPUID))
  {
    tell_object(TP,BSI(
      "Bringe mir mal die Schriftrolle, dann sehen wir weiter. Und beeil "
      "Dich! Oder willst Du wissen, wie weit du schon bist? Dann frage "
      "mich doch einfach nach Fortschritt oder teile mir \"Wie weit bin "
      "ich?\" mit. ", Name(WER)+" sagt verzweifelt: "));
    return -1;
  }

  if(sizeof(uuid = SMASTER->QueryQuester()))
  {
    if(!SMASTER->QueryTimeLimit(uuid[0]))
    {
      s = BSI("Im Moment kannst Du mir nicht helfen. Es ist schon jemand im "
              "Labyrinth drin. Und ich kann immer nur einen im Labyrinth "
              "vor den Untoten beschuetzen. Vielleicht kannst Du mir ja "
              "spaeter mal helfen.", Name(WER)+" sagt: ");

      tell_object(TP, s);
      return -1;
    }

    EndQuest(uuid[0]);
  }

  tell_object(TP,BSI(
    "Gut, wenn Du bereit bist, dann kannst Du das Labyrinth der Untoten "
    "betreten. Ich kann Dich aber von hier aus nur "+QUESTTIME/3600+
    " Stunden beschuetzen. Also beeile Dich und viel Glueck bei Deiner "
    "Suche nach der Schriftrolle. Wenn Du wissen moechtest, wie "
    "weit Du bist, so teile mir \"Wie weit bin ich?\" mit oder frage mich "
    "nach Fortschritt, wenn Du neben mir stehst. ",
    Name(WER)+" sagt: ")
  );

  SMASTER->StartQuest(TPUID);
  SMASTER->SetFlag(TPUID, F_START);
  SMASTER->Msg(TPUID+" hat die Quest begonnen");

  Chats(0);

  return 1;
}

void QuestLog(string s)
{
  write_file(SPEEDYLABYQUESTLOG, dtime(time())+"  "+s+"\n");
}

void give_notify(object obj)
{
  int result, i, z;
  string uid;
  object ob;

  if(!(obj->id("\nspy_rolle"))) return ::give_notify(obj);

  obj->remove();

  if(!SMASTER->IsQuester(TPUID))
  {
    SMASTER->Msg(TPUID+" hat die Schriftrolle OHNE ANWEISUNG gefunden");

    tell_object(TP,BSI("Nanu? Ich hab' Dich ja gar nicht gebeten, mir "
                       "eine Schriftrolle zu bringen. Naja, danke "
                       "trotzdem.",Name(WER)+" sagt erstaunt: "));
    RemoveQuestThings(TP);
    return;
  }

  Chats(1);
  uid = CAP(getuid(TP));
  result = TP->GiveQuest(SPEEDYLABYQUEST);

  switch(result)
  {
    case 1:
      SMASTER->Msg(uid+" hat die Quest KOMPLETT ABGESCHLOSSEN ("+z+"%)");
      QuestLog(uid+" hat "+Name(WEM)+" geholfen, die Schriftrolle zu finden.");
      SMASTER->DeleteQuester(getuuid(TP));
      break;

    case -1:
      SMASTER->Msg(uid + " loest die Quest wiederholt");
      QuestLog(uid + " loest die Quest zum wiederholten Mal.");
      SMASTER->DeleteQuester(getuuid(TP));
      break;

    case -2:
      SMASTER->Msg(uid + " loest die noch nicht eingetragene Quest");
      QuestLog(uid + " loest die nicht eingetragene Quest");
      tell_room(TO, "Die Quest ist noch nicht eingetragen.\n");
      SMASTER->DeleteQuester(getuuid(TP));
      break;

    case -3:
      SMASTER->Msg(uid + " loest die Quest, aber unbefugter Zugriff");
      QuestLog(uid + " loest die Quest, Fehler unbefugter Zugriff.");
      tell_room(TO, "Unbefugter Zugriff.\n");
      SMASTER->DeleteQuester(getuuid(TP));
      break;

    case -4:
      SMASTER->Msg(uid + " loest die nicht aktive Quest");
      QuestLog(uid + " loest die nicht aktive Quest");
      tell_room(TO, "Die Quest ist derzeit deaktiviert.\n");
      SMASTER->DeleteQuester(getuuid(TP));
      break;

    default:
      SMASTER->Msg(sprintf("%s loest die Quest mit Fehler %d", uid, result));
      QuestLog(sprintf("%s loest die Quest mit Fehler %d", uid, result));
      tell_room(TO, sprintf("Unbekannter Fehler bei der Questvergabe: "
                            "%d\n",result));
//    Questdaten bleiben im Master erhalten...
      break;
  }


  if(result == 1 || result == -1)
  {
    tell_object(TP, BSI("JA! Die Schriftrolle, Du hast es tatsaechlich "
                        "geschafft. Da hast Du Dir aber eine Belohnung "
                        "verdient. ", Name(WER)+" freut sich: "));
  }

  RemoveQuestThings(TP);
  return;
}

string info_belohnung()
{
  object ob;

  if(!TP->QueryQuest(SPEEDYLABYQUEST))
  {
    tell_object(TP,BSI("Belohnung gibts nur fuer die, die mir auch "
                       "geholfen haben.",Name(WER)+" murmelt: "));
    return "";
  }

  if(present("\nspy_finde",TP))
  {
    tell_object(TP,BSI("Du hast Deine Belohnung doch schon laengst "
                       "erhalten.",Name(WER)+" sagt erstaunt: "));
    return "";
  }

  if(member(pl, getuuid(TP) ) != -1)
  {
    tell_object(TP, BS("Tut mir leid, ich habe keine Belohnung mehr fuer "
                       "Dich da. Komm spaeter wieder. "));
    return "";
  }

  ob = clone_object(OBJ "kaleidoskop");
  if(ob->move(TP, M_GET) == 1)
  {
    tell_object(TP,BSI("Hier hast Du ein Kaleidoskop. Mit seiner Hilfe "
                       "kannst Du andere Spieler ueber weite Entfernungen "
                       "beobachten. Es ist magisch und kann auch durch "
                       "Felsen und Mauern schauen.",Name(WER)+" sagt: "));
    ob->SetOwner(getuuid(TP));
    pl += ({ getuuid(TP) });
  }
  else
  {
    ob->remove();
    tell_object(TP, BSI("Du bist schon so beladen, Du kannst meine Belohnung "
                        "ja gar nicht mehr tragen!", Name(WER)+" seufzt: "));
  }

  return "";
}

string ScoreToString(string uuid)
{
  string s;

  switch( SMASTER->QueryProgress(uuid))
  {
    case  0..10:
      s = "Also viel hast Du noch nicht geloest. ";
      break;

    case 11..20:
      s = "Ein bisschen kennst Du Dich ja schon aus. ";
      break;

    case 21..30:
      s = "Viel kennst Du noch nicht, aber Du erfaehrst immer mehr. ";
      break;

    case 31..40:
      s = "Der Durchschnitt kommt schon in Reichweite. ";
      break;

    case 41..50:
      s = "Du steht kurz vor dem Durchschnitt. ";
      break;

    case 51..60:
      s = "Du bist jetzt ungefaehr bei der Haelfte. ";
      break;

    case 61..70:
      s = "Mehr als die Haelfte hast Du schon geloest. ";
      break;

    case 71..80:
      s = "Jetzt wird es bald spannend, Du naeherst Dich dem Ende. ";

      break;
    case 81..90:
      s = "Ein kleines Stueck noch, und Du hast es geschafft. ";
      break;

    case 91..99:
      s = "Du stehtst kurz vor der Vollendung. ";
      break;

    default: // 100 Prozent
      s = "Du spuerst, dass Du alles fertig hast. ";
      break;
  }

  return s;
}

void catch_tell(string str)
{
  string wer, was;

  if(!TI) return;

  if(sscanf(str, "%s teilt Dir mit: %s\n", wer, was)!=2) return;

  if(!(was == lower_case("wie weit bin ich?")  ||
       was == lower_case("wie weit bin ich")   ||
       was == lower_case("wie weit bin ich ?") )) return;

  if(ENV(TI) == ENV(TO))
  {
    tell_object(TI, BSI("Also wenn Du neben mir stehst, frag mich doch "
                        "einfach nach Fortschritt.", Name(WER)+" schaut "
                        "Dich an: "));
    return;
  }

  if(!SMASTER->IsQuester(getuuid(TI)))
  {
    tell_object(TI, Name(WER)+" teilt Dir mit: Du hilfst mir doch gar "
                    "nicht!\n");
    return;
  }

  if(SMASTER->QueryTimeLimit(getuuid(TI)))
  {
    EndQuest(getuuid(TI));
    return;
  }

  tell_object(TI, BSI(ScoreToString(getuuid(TI)),
                      Name(WER)+" teilt Dir mit: "));

  return;
}

string info_fortschritt()
{
  string s;

  if(!SMASTER->IsQuester(getuuid(TP)))
  {
    tell_object(TI, Name(WER)+" schaut erstaunt: Aber Du hilfst mir doch "
                    "gar nicht!\n");
    return "";
  }

  if(SMASTER->QueryTimeLimit(getuuid(TP)))
  {
    Msg(TP);
    return "";
  }

  tell_object(TP, BSI(ScoreToString(getuuid(TP)),
                      Name(WER)+" sagt ernst: "));

  return "";
}

