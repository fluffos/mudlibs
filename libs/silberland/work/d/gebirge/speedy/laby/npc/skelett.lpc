#include "../def.h"

inherit "std/npc";

void create()
{
  object ob;

  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG,
    "Ein voellig fleischloses Skelett. Seine Knochen klappern bei jeder "
    "Bewegung richtig unheimlich. Sein Schaedel ist von innen her blutrot "
    "erleuchtet. "
  );

  SetProp(P_NAME,"Skelett");
  AddId( ({"skelett","NOWIMPY","NOCONTROL"}) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_RACE, "Elf");
  AddClass(CL_UNDEAD);

  create_default_npc(15);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_ALIGN, -250);
  SetProp(P_SIZE, 180);
  AddClass(CL_SKELETON);
  SetProp(P_HANDS, ({" mit Knochenfingern",QueryProp(P_HANDS)[1],DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -20);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_REJECT, ({REJECT_DROP,"Das Skelett laesst es fallen.\n"}) );
  SetProp(P_DIE_MSG, " klappert in sich zusammen.\n" );
  SetProp(P_NOCORPSE, 1);

  AddInfo( DEFAULT_INFO, "ignoriert Dich.\n" );

  AddDetail( ({"knochen"}),
    "Die Knochen des Skeletts, sind voellig fleischlos, und klappern bei "
    "jeder Bewegung. "
  );

  AddDetail( ({"schaedel"}),
    "Der Schaedel wird von innen her hell erleuchtet, irgendetwas magisches "
    "scheint da drinnen zu sein."
  );

  SUID;
  CLONEME(OBJ "kn_schaedel" );
  CLONEME(OBJ "kn_bein" );
  CLONEME(OBJ "kn_bein" );
  CLONEME(OBJ "kn_arm"  );
  CLONEME(OBJ "kn_arm"  );
  CLONEME(OBJ "kn_rippe" );
  CLONEME(OBJ "kn_rippe" );
  CLONEME(OBJ "kn_rippe" );
  CLONEME(OBJ "kn_rippe" );
}

