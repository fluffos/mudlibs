#include "../def.h"

inherit "std/npc";

void create()
{
  object ob;

  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Mumie");
  SetProp(P_LONG,
    "Eine voellig mit Tuechern eingehuellte Mumie. Sie ist sehr gross "
    "und schaut fuerchterlich aus. Die Augen funkeln in einem graesslichen "
    "Rot. "
  );

  SetProp(P_NAME,"Mumie" );
  AddId( ({"mumie","NOWIMPY","NOCONTROL"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Elf" );
  AddClass( ({CL_UNDEAD,CL_SKELETON}) );

  create_default_npc(25);
  SetProp(P_AGGRESSIVE, 0 );
  SetProp(P_ALIGN, -250 );
  SetProp(P_SIZE, 180 );
  SetProp(P_XP, 0 );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      1.2, DT_COLD:     -0.9, DT_WATER:      -0.9
     , DT_AIR:      -0.9, DT_LIGHTNING:-0.9, DT_EXPLOSION:  -0.9
     , DT_SOUND:    -0.9, DT_LIGHT:    -0.9, DT_ELECTRIC:   -0.9
     , DT_ACID:     -0.9, DT_POISON:   -0.9, DT_TERROR:     -0.9
     , DT_HOLY:     -0.9, DT_UNHOLY:   -0.9, DT_MAGIC:      -0.9
     , DT_MIND:     -0.9, DT_SLASH:    -0.9, DT_BLUDGEON:   -0.9
     , DT_PIERCE:   -0.9, DT_SQUEEZE:  -0.9, DT_WHIP:       -0.9
     , DT_RIP:      -0.9
     ])
  );

  SetProp(P_HANDS, ({" mit grauenvollen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    ,DT_BLUDGEON
                    })
  );

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MAX_SP, 200);
  SetProp(P_SP, 200);
  SetProp(P_HEAL, -20);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft hinaus");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_REJECT, ({REJECT_DROP,"Die Mumie laesst es fallen.\n"}) );
  SetProp(P_DIE_MSG, " faellt in sich zusammen.\n" );
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n" );

  AddDetail( ({"tuecher"}),
    "Die Tuecher sind schmutzig, sie huellen die Mumie von oben bis unten "
    "ein. "
  );

  AddDetail( ({"augen","auge"}),
    "Die Augen sehen furchtbar aus, sie funkeln in einer schrecklichen "
    "Farbe. "
  );

  AddDetail( ({"rot"}),
    "Lange kannst Du da nicht hinschauen, die rote Farbe wirkt so "
    "furchteinfloessend. Schrecklich ... "
  );

  AddDetail( ({"eisenschluessel","schluessel"}),
    "Schaut aus wie ein rostiger Eisenschluessel, den brauchst Du "
    "bestimmt. "
  );

  SUID;
  CLONEME(OBJ "schluessel" );

  SetProp(P_SPELLRATE, 30);

  AddSpell( 5, 350,
    "Die Mumie rammt ihre Haende in Dich hinein.\n",
    "Das Mumie rammt ihre Haende in @WEN hinein.\n"
  );

  AddSpell( 5, 600,
    "Die Mumie beruehrt Dich toedlich.\n",
    "Die Mumie beruehrt @WEN toedlich.\n"
  );

  AddCmd("zuende|zuend&mumie",
    "cmd_zuenden",
    "Was moechtest Du anzuenden?"
  );

  AddCmd("zuende|zuend&mumie&fackel",
    "cmd_zuenden",
    "Was moechtest Du womit anzuenden?"
  );
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if((QueryProp(P_SP) >  10 ) &&
     (QueryProp(P_HP) < 350 ))
  {
    AddSp(-10);
    AddHp(100+random(30));
    tell_room(ENV(TO),"Die Mumie leuchtet ganz kurz sehr hell auf.\n");
  }

  return ::Defend(dam,dam_type,spell,enemy);
}

int cmd_zuenden(string str)
{
  object ob;

  if(!ob=present("fackel", TP))
  {
    TELLPLAYER("Du hast ja gar keine Fackel dabei.\n");
    return -1;
  }

  if(!ob->_query_lighted())
  {
    TELLPLAYER("Aber die Fackel brennt ja gar nicht.\n");
    return -1;
  }

  SetProp(P_DIE_MSG, " geht in Feuer auf.\n" );
  TELLPLAYER(BS("Du naeherst Dich vorsichtig der Mumie, nimmst Deine Fackel "
                "und zuendest sie an. "));


  do_damage(5000, TP);
  return 1;
}


