// statue.c
// Eine Drachenstatue, um das Tor zum Drachenkoenig zu oeffnen. 
// 1998-11-28 Feyaria@SilberLand

#include "../def.h"
#include "../drachen.h"

inherit "/std/thing";

int edelstein;

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  edelstein=0;
  
  SetProp(P_SHORT, "Eine Drachenstatue");
  SetProp(P_LONG, 
    "Du siehst ein grosses steinernes Podest, auf dem die Statue eines "
    "Drachen steht. Der Drache ist exzellent gearbeitet, und waere er nicht "
    "viel kleiner als ein echter Drache, koennte man ihn fast fuer einen "
    "versteinerten Drachen halten. Das Drachenmaul ist weit geoeffnet und "
    "man kann sogar die scharfen Zaehne erkennen.");
  SetProp(P_NAME, "Drachenstatue" );
  SetProp(P_GENDER, FEMALE);
  AddId( ({"statue", "drachenstatue", "\ndrachenquest_statue"}) );

  AddDetail( ({"stein", "marmor"}),
    "Es handelt sich um grauen, fein gemaserten Marmor.");
  AddDetail( ({"podest"}),
    "Der Drache steht auf einem grossen Podest.");
  AddDetail( ({"drache"}),
    "Der Drache ist exzellent gearbeitet, und waere er nicht "
    "viel kleiner als ein echter Drache, koennte man ihn fast fuer einen "
    "versteinerten Drachen halten. Das Drachenmaul ist weit geoeffnet und "
    "man kann sogar die scharfen Zaehne erkennen.");
  AddDetail( ({"maul", "drachenmaul"}),
    "Das Drachenmaul ist weit geoeffnet und man kann sogar die scharfen "
    "Zaehne erkennen. Mitten im Maul befindet sich eine seltsam geformte "
    "Oeffnung. Sie ist gerade gross genug, dass man dort einen kleinen "
    "Gegenstand platzieren kann.");
  AddDetail( ({"gegenstand"}),
    "Nur einen kleinen Gegenstand kann man in dieser Oeffnung platzieren. "
    "Vielleicht einen Edelstein oder etwas aehnliches.");
  AddSpecialDetail( ({"oeffnung"}), "oeffnung");
  AddDetail( ({"zaehne", "drachenzaehne"}),
    "Die Zaehne im Maul sind fast so scharf wie echte Drachenzaehne.");  
  
  SetProp(P_VALUE, 10000);
  SetProp(P_WEIGHT, 300000);
  SetProp(P_MATERIAL, MAT_MARBLE);
  SetProp(P_NOGET, "Die Drachenstatue ist hier fest verankert.\n"); 

  AddCmd( ({"platzier", "platziere"}), "cmd_platzieren");
}

int env2int()
{
  switch( file_name(MENV) )
  {
    case SMARAGD_ROOM: return 1;
    case RUBIN_ROOM: return 2;
    case SAPHIR_ROOM: return 3;
    case DIAMANT_ROOM: return 4;
    case AMETHYST_ROOM: return 5;
    default: write("\nBUG!! Die Drachenstatue darf hier nicht stehen!!\n"
                   "Sofort Feyaria verstaendigen!!!\n\n");
             call_out("remove",0);
             return 0;
  }
}

string oeffnung()
{
  switch( env2int() )
  {
    case 1: return ( edelstein ? "In der Oeffnung steckt ein Smagard.\n":
                "Die Oeffnung ist gruen und hat eine runde Form.\n");
    case 2: return (edelstein ? "In der Oeffnung steckt ein Rubin.\n":
                "Die Oeffnung ist rot und hat eine dreieckige Form.\n");
    case 3: return ( edelstein ? "In der Oeffnung steckt ein Saphir.\n":
                "Die Oeffnung ist blau und hat eine viereckige Form.\n");
    case 4: return ( edelstein ? "In der Oeffnung steckt ein Diamant.\n":
                "Die Oeffnung ist durchsichtig und hat eine sechseckige Form.\n");
    case 5: return ( edelstein ? "In der Oeffnung steckt ein Amethyst.\n":
                "Die Oeffnung ist violett und hat eine fuenfeckige Form.\n");
    default: return "";
  }
}

int cmd_platzieren(string str)
{
  string edel, art;
  object stein;
  notify_fail("Was willst worin platzieren?\n");
  if( !str ) return 0;
  if( sscanf(str, "%s in oeffnung", edel)!= 1 ) return 0;
  if( ! stein=present(edel, TP) )
    return notify_fail("Aber Du hast doch gar kein "+CAP(edel)+"!\n"),0;
  if( !stein->id("EDELSTEIN") )
    return notify_fail("Es passen nur Edelsteine in diese Oeffnung!\n"),0;
  if( edelstein )
    return notify_fail("Da ist schon ein Edelstein in der Oeffnung!\n"),0;
  switch( env2int() )
  {
    case 1: art=MAT_EMERALD; break;
    case 2: art=MAT_RUBY; break;
    case 3: art=MAT_SAPPHIRE; break;
    case 4: art=MAT_DIAMOND; break;
    case 5: art=MAT_AMETHYST; break;
    default: art=""; break;
  }
  if( stein->QueryMaterial(art)!=100 )
    return notify_fail(stein->Name(WER,1)+ " passt nicht in diese "
        "Oeffnung!\n"),0;
  write("Du platzierst einen "+"/p/daemon/materialdb"->MaterialName(art)+
      " in der Oeffnung im Drachenmaul.\n");
  say(CAP_TPN+ " steckt etwas in das Drachenmaul.\n", ({TP}) );
  if( stein->id("Unit") )
    stein->AddAmount(-1);
  else
    stein->remove();
  edelstein=2; 
  return 1;
}
      
void reset()
{
  ::reset();
  if( edelstein ) edelstein--;
}

int query_edelstein()
{
  return edelstein;
}

int set_edelstein(int was)
{
  if( getuid(PO)!="feyaria" ) return -1;
  edelstein=was;
  return 1;
}

