// drachenkrone.c
// Die Krone des Drachenkoenigs 
// 1999-02-14 Feyaria@SilberLand

#include "../def.h"
#include "../drachen.h"

inherit "/std/thing";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Die Drachenkrone");
  SetProp(P_LONG, 
    "Die Krone des Drachenkoenigs besteht aus einem riesigen Goldreif. "
    "Sie ist so gross, dass sie niemand ausser einem Drachen aufsetzen kann. "
    "Ihre Magie ist so stark, dass sich Deine Haare aufstellen, wenn Du "
    "sie beruehrst." );
  SetProp(P_NAME, "Drachenkrone" );
  AddId( ({"krone", "drachenkrone", DRACHENQUESTKRONE}) );

  SetProp(P_VALUE, 10000);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_MAGIC, 1); 
}

