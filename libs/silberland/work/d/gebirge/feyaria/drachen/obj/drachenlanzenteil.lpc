// die Einzelteile der Drachenlanze
// 2001-04-19 Feyaria@SilberLand

#include "../def.h"

inherit "/std/thing";

int art;
int magic;

void create()
{
  string longtext;
  if( !is_clone(this_object()) ) return;
  ::create();
  switch(random(100))
  {
    case 0..50: magic=1;break;
    case 51..80: magic=2; break;
    case 81..99: magic=4; break;
  }
  switch(art=random(3))
  {
    case  0:
      SetProp(P_SHORT, "Die Spitze einer Lanze");
       
      longtext= "Dies ist die Spitze einer maechtigen Lanze. Leider fehlt sowohl der "
        "Schaft als auch der Griff, sodass man diesen Lanzenteil ueberhaupt nicht im "
        "Kampf einsetzen kann.";
      SetProp(P_NAME, "Lanzenspitze" );
      SetProp(P_GENDER, FEMALE);
      AddId( ({"spitze", "lanzenspitze", "\ndrachenlanzenspitze"}) );

      SetProp(P_WEIGHT, 3000);
     
      switch(magic)
      {
        case 1:
          SetProp(P_VALUE, 1000);
          SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
          longtext+=
            " Die Lanzenspitze besteht aus normalem Stahl und ist von ziemlich "
            "einfacher Machart.";
          SetProp(P_INFO,
            "Diese Lanzenspitze ist eher von minderwertiger Qualitaet.");  
          break;
        case 2:
          SetProp(P_VALUE, 2000);
          SetProp(P_MATERIAL, ([MAT_MITHRIL:100]) );
          longtext+=
            " Die Lanzenspitze besteht aus funkelndem Mithril und ist von guter "
            " Machart.";
          SetProp(P_INFO,
            "Diese Lanzenspitze ist eigentlich von guter Qualitaet.");  
          break;
        case 4:
          SetProp(P_VALUE, 4000);
          SetProp(P_MATERIAL, ([MAT_ADAMANT:100]) );
          longtext+=
            " Die Lanzenspitze besteht aus haertestem Adamant und stammt sicher " 
            "aus der Hand eines meisterlichen Handwerkers.";
          SetProp(P_INFO,
            "Diese Lanzenspitze ist von hervorragender Qualitaet.");  
          break;
      }
      SetProp(P_LONG, longtext+
        " Mit den vielen Widerhaken wuerde diese Spitze eine gute Waffe ergeben, "
       "wenn sie zu einer kompletten Waffe zusammengebaut waere.");  
      break;
    case 1:
      SetProp(P_SHORT, "Der Griff einer Lanze");
       
      longtext= "Dies ist der Griff einer grossen Lanze. Leider fehlt sowohl der "
        "Schaft als auch die Spitze, sodass man diesen Lanzenteil ueberhaupt nicht im "
        "Kampf einsetzen kann.";
      SetProp(P_NAME, "Lanzengriff" );
      SetProp(P_GENDER, MALE);
      AddId( ({"griff", "lanzengriff", "\ndrachenlanzengriff"}) );

      SetProp(P_WEIGHT, 2000);
     
      switch(magic)
      {
        case 1:
          SetProp(P_VALUE, 1000);
          SetProp(P_MATERIAL, ([MAT_PELT:100]) );
          longtext+=
            " Der Griff besteht aus Fell und ist von ziemlich "
            "einfacher Machart.";
          SetProp(P_INFO,
            "Dieser Griff ist eher von minderwertiger Qualitaet.");  
          break;
        case 2:
          SetProp(P_VALUE, 2000);
          SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
          longtext+=
            " Der Griff besteht aus feinem Leder und ist von guter "
            " Machart.";
          SetProp(P_INFO,
            "Dieser Griff ist eigentlich von guter Qualitaet.");  
          break;
        case 4:
          SetProp(P_VALUE, 4000);
          SetProp(P_MATERIAL, ([MAT_SILK:100]) );
          longtext+=
            " Der Griff besteht aus feinster Seide und stammt sicher " 
            "aus der Hand eines meisterlichen Handwerkers.";
          SetProp(P_INFO,
            "Dieser Griff ist von hervorragender Qualitaet.");  
          break;
      }
      SetProp(P_LONG, longtext+
        " Dieser Lanzengriff wuerde sicher gut in der Hand liegen, wenn er "
        "einmal zu einer richtigen Waffe zusammengebaut waere.");  
      break;
    case 2:  
      SetProp(P_SHORT, "Der Schaft einer Lanze");
       
      longtext= "Dies ist der Schaft einer grossen Lanze. Leider fehlt sowohl der "
        "Griff als auch die Spitze, sodass man diesen Lanzenteil ueberhaupt nicht im "
        "Kampf einsetzen kann.";
      SetProp(P_NAME, "Lanzenschaft" );
      SetProp(P_GENDER, MALE);
      AddId( ({"schaft", "lanzenschaft", "\ndrachenlanzenschaft"}) );

      SetProp(P_WEIGHT, 4000);
      switch(magic)
      {
        case 1:
          SetProp(P_VALUE, 1000);
          SetProp(P_MATERIAL, ([MAT_MISC_WOOD:100]) );
          longtext+=
            " Der Schaft besteht aus normalem Holz und ist von ziemlich "
            "einfacher Machart.";
          SetProp(P_INFO,
            "Dieser Schaft ist eher von minderwertiger Qualitaet.");  
          break;
        case 2:
          SetProp(P_VALUE, 2000);
          SetProp(P_MATERIAL, ([MAT_OAK:100]) );
          longtext+=
            " Der Schaft besteht aus hartem Eichenholz und ist von guter "
            " Machart.";
          SetProp(P_INFO,
            "Dieser Schaft ist eigentlich von guter Qualitaet.");  
          break;
        case 4:
          SetProp(P_VALUE, 4000);
          SetProp(P_MATERIAL, ([MAT_ELM_WOOD:100]) );
          longtext+=
            " Der Schaft besteht aus sehr schoenem Ulemnholz und stammt sicher "
            "aus der Hand eines meisterlichen Handwerkers.";
          SetProp(P_INFO,
            "Dieser Schaft ist von hervorragender Qualitaet.");  
          break;
      }
      SetProp(P_LONG, longtext+
        " Dieser Lanzenschaft waere sicher ein guter Bestandteil einer Waffe, "
        "falls man noch einen Griff und eine passende Spitze hat.");  
      break;
  }
}

void modify_dragonlance(object ob)
{
  ob->add_dragon_magic(magic, art);
}

int _query_magic()
{
  return magic;
}
