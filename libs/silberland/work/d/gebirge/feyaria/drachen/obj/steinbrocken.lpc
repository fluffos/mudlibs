// steinbrocken.c
// Ein Steinbrocken, aus dem spaeter einaml die Steinscheibe fuer die
// Drachenquest wird
// 1998-07-29 Feyaria@SilberLand

#include "../def.h"

inherit "/std/thing";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Ein seltsamer Steinbrocken");
  SetProp(P_LONG, BS(
    "Dieser Steinbrocken besteht aus einer seltsamen Gesteinsart, die "
    "sicher sehr selten ist, sonst haettest Du sie sicher schon des "
    "oefteren solche Steine gesehen. Was man damit wohl anfangen kann?") );
  SetProp(P_NAME, "Steinbrocken" );
  SetProp(P_NAME_ADJ, "seltsam" );
  SetProp(P_GENDER, MALE);
  AddId( ({"stein", "brocken", "steinbrocken", "\ndrachenstein"}) );
  AddAdjective( ({"seltsam", "seltsamen"}) );

  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 1000);
  
}

