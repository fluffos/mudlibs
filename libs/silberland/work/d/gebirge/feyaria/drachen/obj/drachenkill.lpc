// drachenkill.c
// Hilfsobject, dass nur der Killer des Drachenkoenigs zum Schatz kommt 
// 1999-02-14 Feyaria@SilberLand

#include "../def.h"

inherit "/std/thing";

int zeit, durchwuehlt;

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, 0);
  AddId( ({"\ndrachenkoenigkill"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_INVIS, 1);
  zeit = 0;
  durchwuehlt=0;
}

void reset()
{
  ::reset();
  if( zeit++ > 1 ) call_out("remove",0);
}

int set_durchwuehlt()
{
  if( !PO || file_name(PO)!=ROOM "schatz" )
    return -1;
  durchwuehlt=1;
}

int query_durchwuehlt()
{
  return durchwuehlt;
}

