inherit "std/armour";

#include <combat.h>
#include <properties.h>

void create()
{
  int value;
  string s, mat, mattext;
  
  if (!is_clone(this_object())) return;
  ::create();

  switch(random(3))
  {
    case 0: mat=MAT_GOLD; 
            value=300;
            mattext=({"Gold", "purem Gold"})[random(2)]; 
            break;
    case 1: mat=MAT_SILVER; 
            value=100; 
            mattext=({"poliertem Silber", "geflochteten Silberfaeden",
                      "Silber"})[random(3)];
            break;
    case 2: mat=MAT_PLATINUM; 
            value=500;
            mattext=({"Platin", "glaenzendem Platin"})[random(2)]; 
            break;
  }
  SetProp(P_SHORT, "Wunderschoene Ohrringe");
  SetProp(P_LONG, 
    "Diese wunderschoenen Ohrringe aus "+mattext+" sind sicher extrem "
    "wertvoll. Sie sind das Meisterwerk eines zwergischen Goldschmiedes.");
  SetProp(P_NAME, "Ohrringe");
  SetProp(P_NAME_ADJ, "wunderschoen" );
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"ohrringe"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_MATERIAL, ([ mat:100 ]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 650+value);

}

