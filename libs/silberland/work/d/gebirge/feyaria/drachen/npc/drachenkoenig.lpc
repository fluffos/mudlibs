// Drachenkoenig
// 1998-10-09 Feyaria@SilberLand

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells";

#include "../def.h"
 
void create()
{
  if(!is_clone(this_object()) ) return;

  ::create();
  SetProp(P_NAME, "Drachenkoenig");
  create_default_dragon(5,12,2,35+random(25));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_HP_DELAY, 0);

  SetProp(P_SHORT, "Der Drachenkoenig");
  SetProp(P_LONG, 
    "Der Drachenkoenig ist ein gewaltiger diamantener Drache. Er ist wohl ueber "
    "20 Meter lang und seine Schuppen strahlen in gleissendem Licht. Eine "
    "wahrhaft majestaetische Aura umgibt ihn, sodass Du das Beduerfnis "
    "hast, Dich vor seiner beinahe goettlichen Macht in den Staub zu werfen. "
    "Seine tellergrossen, wissenden Augen scheinen tief in Deine Gedanken "
    "einzudringen - sicher kannst Du vor dieser uralten und allwissenden "
    "Kreatur nichts verbergen.");
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_SIZE, 2000);
  SetProp(P_WEIGHT, 20000000);
  SetProp(P_ARTICLE, 2);
  AddId(({"drachenkoenig", "koenig"}) );

  AddLibrary( "/d/gebirge/feyaria/drachen/drachen.lib", 2);

  AddDefaultSpell(1, 800, DS_PARALYZE,
    "Der strenge Blick des Drachenkoenigs laesst Dich erstarren!\n",
    "Der strenge Blick des Drachenkoenigs laesst @WEN erstarren!\n",
    4);
  AddDefaultSpell(1, 900, DS_MASS_FEAR,
    "Der Drachenkoenig schlaegt Dich in die Flucht!\n",
    "Der Drachenkoenig schlaegt Dich in die Flucht!\n");
  AddDefaultSpell(1, 1500, DS_MASS_POISON,
    "Der Drachenkoenig atmet ein giftgruene Wolke aus.\n",
    "Der Drachenkoenig atmet ein giftgruene Wolke aus.\n",5);
  AddDefaultSpell(1, 2000, DS_MASS_DAMAGE,
    "Eine gewaltiger Kettenblitz saust durch den Raum.\n",
    "Eine gewaltiger Kettenblitz saust durch den Raum.\n", 
    DT_LIGHTNING);
  AddDefaultSpell(1, 1700, DS_SLOW,
    "Der Drachenkoenig friert Dich ein.\n",
    "Der Drachenkoenig friert @WEN ein.\n", 
    10 );   
  SUID;
  CLONEME("/d/astral/feyaria/draconia/obj/schuppe");
}

void die(int poisondeath)
{
  write_file(LOG "drache",
    ctime()+": "+CAP(getuid(TP))+" killt den Drachenkoenig.\n");
  if( TP && !IS_LEARNER(TP) )
  {
    shout(TP->Name()+
        " hat den Drachenkoenig bezwungen.\n");
    CLONE( OBJ "drachenkill", TP);
    if (0 && interactive(TP) && !present("\nschuppenhaut", TP))
    { 
      CLONE(SCHUPPENHAUT, TP);
      tell_object(TP, BS(
            "\nDas Blut des Drachen sprudelt aus seiner zerstueckelten Leiche "
            "heraus und bildet einen richtigen blutroten See vor Dir. Berauscht "
            "von Deinem glorreichen Sieg springst Du voller Freude in den See und "
            "beginnst Dich darin herumzuwaelzen, bis Dein gesamter Koerper vom "
            "Drachenblut bedeckt ist. Die Essenz des Drachen dringt in Dich ein "
            "und Du fuehlst. wie Deine Haut immer schuppiger wird. Die Magie des "
            "Drachens hat von Dir Besitz ergriffen.\n\n"));
      tell_room(environment(TP),BS( "\n\n" + TP->Name() + "%s waelzt "
            "sich im Blut des Drachen und bekommt eine ganz schuppige Haut.\n\\n\nn"),
          ({TP}));
    }

  }
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "drache",
    ctime()+": Der Drachenkoenig hat gerade "+CAP(getuid(player))+
      " umgebracht.\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}

varargs void
ModifySkillAttribute(object caster, string atrname, int value, int duration,
                         mixed fun) 
{
  if (previous_object() && previous_object()!=this_object() ) 
    return;
  ::ModifySkillAttribute(caster, atrname, value, duration, fun);
}

int _query_disable_attack() { return 0; }
int _query_disable_spell() { return 0; }
int _query_paralyzed() { return 0; }

int Defend(int dam, string dtype, int spell, object enemy)
{
  if (interactive(enemy) && random(2))
    SetProp( P_PREFERED_ENEMY, ({80,enemy}));
  if (dam > 700) dam = 700;
  return ::Defend(dam, dtype, spell, enemy);
}

