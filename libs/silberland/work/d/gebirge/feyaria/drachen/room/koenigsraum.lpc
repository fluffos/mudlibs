// Der Raum des Drachenkoenigs 
// 19.Feb 1999 Feyaria@SL


#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Hoehle des Drachenkoenigs");
  SetProp(P_INT_LONG, 
    "Du stehst in der riesiegen Hoehle des Drachenkoenigs. Die Waende sind "
    "vom Feueratem des Drachen ganz schwarz gefaerbt. Die Decke der Hoehle "
    "ist so weit oben, dass Du sie in diesem duesteren Licht kaum erkennen "
    "kannst. Der Boden besteht aus grossen Marmorplatten, die aber voellig "
    "zerkratzt sind. "
    "Im Sueden fuehrt ein Gang aus der Hoehle hinaus, waehrend man durch "
    "eine Oeffnung in der Nordwand die Schatzkammer des Drachenkoenigs "
    "betreten kann.");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:19, ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ({"hoehle", "wohnhoehle"}),
    "Du stehst in der Wohnhoehle des Drachenkoenigs.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende bestehen aus hartem Fels und sind vom Feueratem des "
    "Drachen ganz verkohlt, zum Teil broeckelt sogar Asche von den Waende.");
  AddDetail( ({"fels", "stein", "gestein"}),
    "Die Waende bestehen aus hartem Gestein, sind aber vom Atem des Drachen "
    "zum Teil zu Asche verbrannt.");
  AddDetail( ({"teil"}),
    "Nur ein Teil der Waende ist verbrannt, an einigen Stellen kann man "
    "noch den urspruenglichen Fels sehen.");
  AddDetail( ({"stellen", "stelle"}),
    "An einigen Stellen sind die Waende nicht voellig verkohlt und man "
    "kann die Maserung des Gesteins erkennen.");
  AddDetail( ({"maserung"}),
    "Die Maserung des Gesteins kann man nur an wenigen Stellen erkennen, "
    "weil ansonsten ja fast alles vom Flammenatem des Drachenkoenigs "
    "verkohlt ist.");
  AddDetail( ({"asche"}),
    "Asche broeckelt von den Waenden.");
  AddDetail( ({"feueratem", "flammenatem", "atem"}),
    "Der Feueratem des Drachenkoenigs muss gewaltig sein, da er sogar "
    "harten Fels in Asche verwandeln kann.");
  AddDetail( ({"drache", "drachenkoenig"}),
    "Der Drachenkoenig muss risengross sein, wenn er so ein grosse "
    "Wohnhoehle hat.");
  AddDetail( ({"decke"}),
    "Die Decke der Hoehle ist so weit oben, dass Du sie in diesem "
    "duesteren Licht kaum erkennen kannst.");
  AddDetail( ({"boden"}),
    "Der Boden besteht aus grossen Marmorplatten, die aber voellig "
    "zerkratzt sind. Die Krallen des Drachenkoenigs muessen sehr scharf "
    "sein!");
  AddDetail( ({"marmor", "marmorplatten", "platten"}),
    "Am Boden sind Platten aus Marmor verlegt. Sie sind allerdings von den "
    "Krallen des Drachenkoenigs ziemlich zerkratzt.");
  AddDetail( ({"kralle", "krallen"}),
    "Die Krallen des Drachenkoenigs muessen sehr scharf sein, da der Boden "
    "so zerkratzt ist.");
  AddDetail( ({"licht"}),
    "Das Licht in dieser Hoehle ist sehr duester.");
  AddDetail( ({"gang", "sueden"}),
    "Im Sueden fuehrt ein Gang aus der Hoehle hinaus.");
  AddDetail( ({"norden", "nordwand", "oeffnung"}),
    "An der Nordwand befindet sich eine Oeffnung, durch die man die "
    "Schatzkammer des Drachenkoenigs betreten kann.");
  AddDetail( ({"schatzkammer", "schatz", "kammer"}),
    "Gold und Juwelen blinken aus der Schatzkammer heraus.");
  AddDetail( ({"gold", "juwelen", "schaetze"}),
    "Um an diese Schaetze zu gelangen, musst Du vorher am Drachenkoenig "
    "vobei.");
  AddSmell( ({DEFAULT_SMELL}),
    "Es richt nach Drache.");
  
  AddCmd( ({"betrete", "betritt"}), "betreten");
  
  AddExit( "sueden", "./vorraum" );

  AddItem( NPC "drachenkoenig", REFRESH_DESTRUCT );
  set_next_reset(3*24*3600);
}

int betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( !str ) return 0;
  if( member(({"schatzkammer", "kammer", "oeffnung"}),str)==-1 ) return 0;
  if( present("drachenkoenig") )
    return write("Der Drachenkoenig laesst Dich nicht vorbei.\n"), 1;
  if( !present("\ndrachenkoenigkill", TP) )
    return write(BS("Eine magische Barriere haelt Dich ab. Scheinbar kann "
        "nur der Drachenkoenig selber die Schatzkammer betreten.")), 1;
  write("Du betrittst die Schatzkammer des Drachenkoenigs.\n");
  TP->move(ROOM "schatz", M_GO, "die Schatzkammer des Drachenkoenigs",
      "betritt", "kommt herein");
  return 1;
}

void reset()
{
  ::reset();
  set_next_reset(3*24*3600);
}
