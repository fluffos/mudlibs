// der Drachenhort des Drachenkoenigs
// 19.Feb 1999 Feyaria@SL

#include "../def.h"

inherit "std/room";

int schatz;

void create()
{
  ::create();

  schatz=1;
  SetProp(P_INT_SHORT, "Der Drachenhort des Drachenkoenigs");
  SetProp(P_INT_LONG, 
    "Vor Dir tuermt sich der Hort des Drachenkoenigs bis zur Decke auf. "
    "Gewaltige Schaetze lagern hier. Alles kannst Du sicher nicht "
    "mitnehmen, aber wenn Du den Schatz durchwuehlst, kannst Du sicher "
    "viele wertvolle Dinge finden, die Du mitnehmen kannst.");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:19, ENV_TERRAIN:TT_CAVE]) );
  
  AddDetail( ({"hort", "drachenhort", "schatz", "schaetze"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"drachenkoenig", "koenig", "drache"}),
    "Da Du hier beim Hort des Drachenkoenigs stehst, wirst Du wohl den "
    "Drachen besiegt haben.");
  AddDetail( ({"boden", "wand", "waende", "decke"}),
    "Von Boden, Waenden und Decke kannst Du nichts erkennen. Alles ist voll "
    "mit Schaetzen.");
  AddSound( ({DEFAULT_SOUND, "klimpern", "muenzen", "muenze"}), 
    "Du hoerst das Klimpern von Muenzen.");
  
  AddCmd( ({"wuehl", "wuehle", "durchwuehl", "durchwuehle"}), "wuehlen");
  AddExit( "raus", "./koenigsraum" );
}

void clone_magic(string str)
{
  object ob;
  ob=clone_object(str);
  TP->SetProp("itemd_time", 0);
  find_object(ITEMD)->identify(ob,-1,100,100,({1,4,12,18,20}),1 );
  ob->move(TO, M_NOCHECK);
}

int wuehlen(string str)
{
  object ob;
  int i;
  notify_fail("Was willst Du durchwuehlen?\n");
  if( !str ) return 0;
  if( member( ({"hort", "drachenhort", "in hort", "in drachenhort", "schatz",
       "drachenschatz", "in schatz", "in drachenschatz"}), str) !=- 1 )
  {
    if( !schatz )
      write("Der Hort wurde schon durchwuehlt.\n");
    else
    {
      if( !objectp(ob=present("\ndrachenkoenigkill", TP)) && !IS_ARCH(TP))
        return write(BS("Aus Angst vor dem Drachenkoenig traust Du Dich "
                        "nicht, den Schatz zu durchwuehlen.")),1;
      if(!IS_ARCH(TP) &&  ob->query_durchwuehlt())
        return write("Du hast den Hort des Drachenkoenigs schon "
                     "durchwuehlt.\n"),1;
      if(!IS_ARCH(TP)) ob->set_durchwuehlt();
      schatz=0;
      write("Du durchwuehlst den Drachenhort und findest viele Schaetze.\n");
      say(CAP_TPN+ " durchwuehlt den Drachenhort.\n");
      CLONE( OBJ "drachenkrone", TO);
      clone_magic(({"/p/armour/helm/mithrilhelm", "/p/armour/armour/mithrilpanzer",
                    "/p/armour/bracers/mithrilarmschienen"})[random(3)] );
      clone_magic(({"/p/armour/gloves/lederhandschuhe", "/p/armour/boots/lederstiefel",
                    "/p/armour/trousers/lederhose"}) [random(3)] );
      clone_magic(({"/p/weapon/sword/breitschwert", "/p/weapon/knife/langdolch",
                    "/p/weapon/spear/angriffsspeer"}) [random(3)]);
      CLONE("/gilden/druidenzirkel/armour/elementarhandschuhe", TO);
      CLONE(({WEAPON "davul", WEAPON "kithara", WEAPON "dudelsack", WEAPON "borimbrambok"})[random(4)], TO);
      CLONE(WEAPON "koenigsaxt", TO);
      clone_magic("/p/armour/ring/ring");
      clone_magic("/p/armour/amulet/amulett");
      CLONE(ARMOUR "ohrringe", TO);
      ob=clone_object("/obj/money");
      ob->SetProp(P_AMOUNT, 10000+random(20000) );
      ob->move(ME, M_NOCHECK);
      for(i=random(5)+2;i>=0;i--)
        CLONE("/d/dschungel/feyaria/tijara/obj/wbalsam", TO);
      for(i=random(5)+2;i>=0;i--)
        CLONE("/d/dschungel/feyaria/tijara/obj/rbalsam", TO);
      for(i=random(3)+1;i>=0;i--)
        CLONE( OBJ "goettertrank", TO);
      "/obj/gemmaster"->DistributeGem(20,10,1,TO);
    }
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  schatz=1;
}

