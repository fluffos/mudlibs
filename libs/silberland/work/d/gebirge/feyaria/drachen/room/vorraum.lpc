// Der Raum vor dem Drachenkoenig 
// 19.Feb 1999 Feyaria@SL

#include "../def.h"
#include "../drachen.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer grossen Hoehle");
  SetProp(P_INT_LONG, 
    "Du stehst in einer gewaltigen Hoehle. An der Suedwand befindet sich "
    "ein grosses Portal. An der Nordwand oeffnet sich ein Gang, der von "
    "zwei Statuen bewacht wird.");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:19, ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ({"hoehle"}),
    "Die Hoehle ist wahrhaft riesengross.");
  AddDetail( ({"suedwand", "portal"}),
    "An der Suedwand befindet sich ein grosses Portal.");
  AddDetail( ({"nordwand"}),
    "An der Nordwand geht ein Gang weiter nach Norden. Zwei Statuen stehen "
    "am Beginn des Gangs.");
  AddDetail( ({"beginn"}),
    "Der Gang beginnt an der Nordwand und fuehrt von dort weiter nach "
    "Norden.");
  AddDetail( ({"waende" }),
    "Die Waende bestehen aus hartem Felsen.");
  AddDetail( ({"fels", "felsen"}),
    "Der Fels, aus dem diese Hoehle besteht, ist sehr hart.");
  AddDetail( ({"wand"}),
    "Es gibt hier vier Waende, jeweils in den vier Himmelsrichtungen eine.");
  AddDetail( ({"himmelsrichtung", "himmelsrichtungen", "richtung", 
               "richtungen", "norden", "sueden", "osten", "westen"}),
    "Die vier Himmelsrichtungen sind Norden, Osten, Sueden und Westen.");
  AddDetail( ({"westwand"}),
    "Die Westwand besteht aus hartem Fels und weisst keine Besonderheiten "
    "auf.");
  AddDetail( ({"besonderheit", "besonderheiten"}),
    "Auf der Westwand sind echt keine Besonderheiten, glaub mir doch!");
  AddDetail( ({"ostwand"}),
    "Auf der Ostwand ist ein seltsames Symbol in den Fels eingeritzt.");
  AddDetail( ({"symbol"}),
    "Das seltsame Symbol an der Ostwand stellt sich bei naeherer "
    "Betrachtung als eine Krone mit 10 Zacken heraus.");
  AddDetail( ({"krone", "drachenkrone"}),
    "Bei der Krone handelt es sich scheinbar um die Drachenkrone.");
  AddDetail( ({"zacken", "zacke"}),
    "Die Krone hat zehn Zacken, wohl fuer jede Drachenart eine.");
  AddDetail( ({"drachenart", "art", "drachenarten", "arten"}),
    "Es gibt 10 Drachenarten, aber das weisst Du ja, sonst wuerdest Du "
    "nicht hier stehen.");
  AddDetail( ({"10", "zehn", "zahl"}),
    "Die Zahl Zehn ist eine sehr interessante Zahl.");
  AddDetail( ({"boden"}),
    "Der Boden ist rauh und besteht aus hartem Fels.");
  AddDetail( ({"decke"}),
    "Die Decke ist weit ueber Dir und besteht wohl aus Fels.");
  AddDetail( ({"gang"}),
    "Der Gang fuehrt an den Statuen vorbei weiter nach Norden.");
  AddDetail( ({"statue", "statuen"}),
    "Die Statuen haben eine meschenaehnliche Gestalt und scheinen den "
    "Gang zu bewachen. Sie bestehen aus einem golden schimmernden Metall.");
  AddDetail( ({"metall"}),
    "Welches Metall meinst Du? Das gold schimmernde Metall der Statuen oder "
    "das dunkle Metall des Portals.");
  AddDetail( ({"gold schimmerndes metall", "gold schimmerndes metall"}),
    "Das Metall, aus dem die Statuen geformt sind, schimmert golden, es "
    "handelt sich aber nicht um Gold sondern um ein voellig unbekanntes "
    "Metall. Wahrscheinlich wurde es von der Magie des Drachenkoenigs "
    "erzeugt.");
  AddDetail( ({"gold"}),
    "Das Metall der Statuen ist definitiv nicht Gold!");  
  AddDetail( ({"magie"}),
    "Die Magie des Drachenkoenigs soll sehr maechtig sein.");
  AddDetail( ({"drachenkoenig", "drache"}), 
    "Der Drachenkoenig muss hier irgendwo sein, denn es riecht schon sehr "
    "stark nach Drache.");
  AddDetail( ({"gestalt", "menschen"}),
    "Die Gestalt der Statuen aehnelt nur entfernt der von Menschen. Sie "
    "haben einen saeulenfoermigen Unterkoerper, einen runden Oberkoerper, "
    "zwei kurze Arme und einen gesichtslosen Kopf.");
  AddDetail( ({"unterkoerper"}),
    "Der Unterkoerper der Statuen ist saeulenfoermig.");
  AddDetail( ({"oberkoerper", "rund", "kugelrund"}),
    "Der Oberkoerper der Statuen ist kugelrund.");  
  AddDetail( ({"arme"}),
    "Die Statuen haben kurze Arme, die zur Decke hinauf gerichtet sind.");
  AddDetail( ({"kopf", "koepfe", "gesicht"}),
    "Die Koepfe der Statuen haben kein Gesicht.");
  AddDetail( ({"symbol", "symbole", "mitte"}),
    "In der Mitte des Portals befinden sich fuenf Symbole. Es handelt sich "
    "um einen gruenen Kreis, ein rotes Dreiecki, ein blaues Viereck, "
    "ein violettes Fuenfeck und ein weisses Sechseck.");
  AddDetail( ({"dunkles metall", "dunkle metall", "stahl"}),
    "Das Portal besteht aus einem sehr dunklem Metall. Es koennte sich um "
    "geschwaerzten Stahl handeln.");
  AddSpecialDetail( ({"kreis", "gruener kreis"}), "smaragd");
  AddSpecialDetail( ({"dreieck", "rotes dreieck"}), "rubin");
  AddSpecialDetail( ({"viereck", "blaues viereck"}), "saphir");
  AddSpecialDetail( ({"fuenfeck", "blaues fuenfeck"}), "amethyst");
  AddSpecialDetail( ({"sechseck", "blaues sechseck"}), "diamant");
  
  AddSmell( ({DEFAULT_SMELL}),
    "Es richt stark nach Drachen.");  
  
  AddExit( "norden", ([EX_DEST: "./koenigsraum",
                       EX_TESTFUNC: "drachentest"]) );

  NewDoor( "sueden", ROOM "portal", ({"portal"}),
         ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
            D_SHORT, "Ein gewaltiges, %ses Portal.",
            D_LONG, BS("Das Portal ist gewaltig gross und besteht aus dunklem "
              "Metall. In der Mitte befinden sich fuenf Symbole. Ein gruener "
              "Kreis, ein rotes Dreieck, und ein blaues Viereck, "
              "ein violettes Fuenfeck und ein weisses Sechseck."),
            D_NAME, "Portal",
            D_GENDER, NEUTER,
            D_CMDS, "oeffne",
            D_OPENTESTFUNC, "edelsteintest",
         }) );

}

int drachentest()
{
  object ob;
  int *drachen;
  int i, summe;
  if( !ob=present("\ndrachenquest", TP) ) 
    return write("Eine magische Barriere blockiert den Weg.\n"),0;
  if( !pointerp(drachen=ob->QueryProp(P_AUTOLOADOBJ)) || 
      sizeof(drachen)!=16 ) 
    return write(BS("Die Drachen Deiner Steinscheibe gluehen auf, aber Du "
        "kannst die magische Barriere nicht durchschreiten.")),0;
  summe=0;
  for( i=0;i<15;i++) 
    if( drachen[i] ) summe++;
  if( summe<15 ) 
    return write(BS("Die Drachen Deiner Steinscheibe gluehen auf, aber Du "
        "kannst die magische Barriere nicht durchschreiten.")),0;
  return 1;
}

int statuen_test(int i)
{
  object ob;
  string wo;
  switch(i) {
    case 1: wo = SMARAGD_ROOM; break;
    case 2: wo = RUBIN_ROOM; break;
    case 3: wo = SAPHIR_ROOM; break;
    case 4: wo = DIAMANT_ROOM; break;
    case 5: wo = AMETHYST_ROOM; break;
    default: write("BUG!\n"); return 0;
  }        
  call_other(wo, "???", 0);
  if( find_object(wo) && (ob=present("\ndrachenquest_statue", find_object(wo))) )
    return ob->query_edelstein();
  else
    return 0;
}

int edelsteintest()
{
  int i;
  for( i=1;i<6;i++){
    if( !statuen_test(i) )
      return write("Das Portal laesst sich nicht oeffnen!\n"),1;
  }
  return 0;
}

string smaragd()
{
  if( statuen_test(1) )
    return "Der gruene Kreis leuchtet hell auf.\n";
  else
    return "Der gruene Kreis ist dunkel.\n";
}

string rubin()
{
  if( statuen_test(2) )
    return "Das rote Dreieck leuchtet hell auf.\n";
  else
    return "Das rote Dreieck ist dunkel.\n";
}

string amethyst()
{
  if( statuen_test(5) )
    return "Das violette Fuenfeck leuchtet hell auf.\n";
  else
    return "Das violette Fuenfeck ist dunkel.\n";
}

string diamant()
{
  if( statuen_test(4) )
    return "Das weisse Sechseck leuchtet hell auf.\n";
  else
    return "Das weisse Sechseck ist dunkel.\n";
}

