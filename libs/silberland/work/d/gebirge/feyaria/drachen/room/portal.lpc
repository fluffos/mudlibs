// Portal vor der Hoehle des Drachenkoenigs 
// 19.Feb 1999 Feyaria@SL

#include "../def.h"
#include "../drachen.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem gewaltigen Portal");
  SetProp(P_INT_LONG, 
    "Du stehst auf einem schmalen Sims vor einem gewaltigen Portal, das sich "
    "hier mitten in der Felswand befindet. Da ausser der anstrengenden "
    "Kletterei nach unten kein Weg von hier wegfuehrt, muss wohl eine "
    "gewaltige, gefluegelte Kreatur hinter diesem Portal hausen. Weit unter "
    "Dir kannst Du den Gebirgspfad erkennen."); 
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_MOUNTAIN]) );

  AddDetail( ({"boden"}),
    "Als Boden kann man das schmale Sims nicht bezeichnen, auf dem Du "
    "gerade stehst. Der echte Boden ist weit unter Dir am Fuss der "
    "Felswand.");
  AddDetail( ({"fuss"}),
    "Der echte Boden befindet sich am Fuss der Bergwand.");  
  AddDetail( ({"sims"}),
    "Das Sims, auf dem Du stehst, ist nicht viel breiter als Deine Fuesse. "
    "Lange solltest Du hier nicht herumstehen.");
  AddDetail( ({"fuesse"}),
    "Deine Fuesse sind fast so breit wie das Sims.");
  AddDetail( ({"wand", "felswand", "bergwand"}),
    "Du bist mitten in einer Felswand, die sich steil nach oben und unten "
    "fortsetzt.");
  AddDetail( ({"kletterei", "klettern"}),
    "Nur durch anstrengendes Klettern konntest Du hier heraufkommen.");
  AddDetail( ({"weg"}),
    "Ausser Klettern oder Fliegen fuehrt hier kein Weg weg.");
  AddDetail( ({"fliegen"}),
     (["fee": "Die vielen Luftwirbel an der Felswand sind fuer Deine "
              "beschraenkten Flugfaehigkeiten einfach zu viel. Du musst "
              "Dich wohl oder uebel aufs Klettern verlassen.",
       0: "Du denkst . o O (Fliegen muesste man koennen!)"]) );
  AddDetail( ({"pfad", "gebirgspfad"}),
    "Weit unter Dir befindet sich der Pfad durchs Gebirge.");
  AddDetail( ({"gebirge"}),
    "Du befindest Dich mitten im Gebirge.");
  AddDetail( ({"himmel", "wolken"}),
    "Der Himmel ist etwas von Wolken verhangen.");
  AddDetail( ({"kreatur", "gefluegelte kreatur"}),
    "Bei einer so grossen gefluegelten Kreatur musst Du unwillkuerlich "
    "an einen Drachen denken.");
  AddDetail( ({"drachen", "drache"}),
    "Es wird wohl ein sehr maechtiger Drache hinter diesem Portal hausen.");
  AddDetail( ({"symbol", "symbole", "mitte"}),
    "In der Mitte des Portals befinden sich fuenf Symbole. Es handelt sich "
    "um einen gruenen Kreis, ein rotes Dreieck, ein blaues Viereck, "
    "ein violettes Fuenfeck und ein weisses Sechseck.");
  AddDetail( ({"metall", "stahl"}),
    "Das Portal besteht aus einem sehr dunklem Metall. Es koennte sich um "
    "geschwaerzten Stahl haendeln.");
  AddSpecialDetail( ({"kreis", "gruener kreis"}), "smaragd");
  AddSpecialDetail( ({"dreieck", "rotes dreieck"}), "rubin");
  AddSpecialDetail( ({"viereck", "blaues viereck"}), "saphir");
  AddSpecialDetail( ({"fuenfeck", "blaues fuenfeck"}), "amethyst");
  AddSpecialDetail( ({"sechseck", "blaues sechseck"}), "diamant");

  AddExit( "runter", "/d/gebirge/eros/room/berg_d18");

  NewDoor( "norden", ROOM "vorraum", ({"portal"}),
         ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
            D_SHORT, "Ein gewaltiges, %ses Portal.",
            D_LONG, BS("Das Portal ist gewaltig gross und besteht aus dunklem "
              "Metall. In der Mitte befinden sich fuenf Symbole. Ein gruener "
              "Kreis, ein rotes Dreieck, und ein blaues Viereck, "
              "ein violettes Fuenfeck und ein weisses Sechseck."),
            D_NAME, "Portal",
            D_GENDER, NEUTER,
            D_CMDS, "oeffne",
            D_OPENTESTFUNC, "edelsteintest",
         }) );

}

int statuen_test(int i)
{
  object ob;
  string wo;
  switch(i) {
    case 1: wo = SMARAGD_ROOM; break;
    case 2: wo = RUBIN_ROOM; break;
    case 3: wo = SAPHIR_ROOM; break;
    case 4: wo = DIAMANT_ROOM; break;
    case 5: wo = AMETHYST_ROOM; break;
    default: write("BUG!\n"); return 0;
  }        
  catch(call_other(wo, "???", 0));
  if( find_object(wo) && ob=present("\ndrachenquest_statue", find_object(wo)) )
    return ob->query_edelstein();
  else
    return 0;
}

int edelsteintest()
{
  int i;
  for( i=1;i<4;i++){
    if( !statuen_test(i) )
      return write("Das Portal laesst sich nicht oeffnen!\n"),1;
  }
  return 0;
}

string smaragd()
{
  if( statuen_test(1) )
    return "Der gruene Kreis leuchtet hell auf.\n";
  else
    return "Der gruene Kreis ist dunkel.\n";
}

string rubin()
{
  if( statuen_test(2) )
    return "Das rote Dreieck leuchtet hell auf.\n";
  else
    return "Das rote Dreieck ist dunkel.\n";
}

string saphir()
{
  if( statuen_test(3) )
    return "Das blaue Viereck leuchtet hell auf.\n";
  else
    return "Das blaue Viereck ist dunkel.\n";
}

string amethyst()
{
  if( statuen_test(5) )
    return "Das violette Fuenfeck leuchtet hell auf.\n";
  else
    return "Das violette Fuenfeck ist dunkel.\n";
}

string diamant()
{
  if( statuen_test(4) )
    return "Das weisse Sechseck leuchtet hell auf.\n";
  else
    return "Das weisse Sechseck ist dunkel.\n";
}

