#include "../def.h"
#include "/p/daemon/itemd/itemd.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Die Axt des Zwergenkoenigs");
  SetProp(P_LONG, BS(
    "Dies ist die legendaere Axt des Zwergenkoenigs. Trotz ihres Alters "
    "schaut sie noch wie neu aus. Der staehlerne Griff ist vergoldet und mit "
    "vielen Edelsteinen verziert. Das gewaltige, doppelschneidige Axtblatt "
    "ist enorm scharf und besteht aus einem sehr harten und silbrig "
    "glaenzenden Metall."));
  SetProp(P_NAME, "Koenigsaxt");                 
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "koenigsaxt"}) );  
  SetProp(P_INFO, BS(
    "Diese uralte Axt ist das Werk eines Meisterschmiedes, wie es sie "
    "heutzutage gar nicht mehr gibt."));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 285);
  SetProp(P_WC_BONUS, (["Zwerg":200]) );
  SetProp(P_WC_FIX, 35);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_QUALITY_DECAY, 550);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 7);
  SetProp(P_VALUE, 50000);
  SetProp(P_WEIGHT, 2900);
  SetProp(P_WIELD_RESTRICTIONS, 
    ([P_LEVEL:70, A_STR:27, A_DEX:23, A_CON:25, SR_BAD:300]) );
  SetProp(P_MATERIAL, ([MAT_MITHRIL:40, MAT_STEEL:40, MAT_GOLD:12, 
    MAT_RUBY:2, MAT_EMERALD:2, MAT_DIAMOND:2, MAT_SAPPHIRE:2]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp("waffenbalsam", 10);

  call_other("/p/daemon/itemd/functions/hitfuncdragon2", "???");
  SetProp(P_HIT_FUNC, find_object("/p/daemon/itemd/functions/hitfuncdragon2"));

  SetProp(P_ITEMD_TMPMAGIC, ({1500, 1500}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void reset()
{
  if( !is_clone(TO) ) return;
  ::reset();

  if( !objectp(QueryProp(P_HIT_FUNC)) )
  {
    call_other("/p/daemon/itemd/functions/hitfuncdragon2", "???");
    SetProp(P_HIT_FUNC, find_object("/p/daemon/itemd/functions/hitfuncdragon2"));
  }
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

