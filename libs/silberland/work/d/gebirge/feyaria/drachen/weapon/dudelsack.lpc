#include "../def.h"
#include "/p/daemon/itemd/itemd.h"
#include "/p/std/barden/instrument.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenschuppendudelsack");
  SetProp(P_LONG, BS(
    "Dieser gewaltige Dudelsack ist ein wahres Meisterwerk der "
    "Drachenschuppenschmidekunst. Er wurde aus dem schuppigen "
    "Balg eines roten Drachen gefertigt. Fuenf lange aus Drachenhorn "
    "geschnitzte Pfeifen gehen davon ab, mit denen verschiedene "
    "Melodien erzeugt werden koennen. Das Mundstueck wurde offenbar "
    "aus den Zaehnen des Untiers gehaemmert. Es scheint so, als "
    "waere das ganze Instrument aus einem einzigen Drachen gemacht."));
  SetProp(P_NAME, "Drachenschuppendudelsack");                 
  SetProp(P_GENDER, FEMALE);
  AddId( ({"dudelsack", "sackpfeife", "\ninstrument", "drachenschuppendudelsack"}) );  
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 35);
  SetProp(P_DAM_TYPE, ({DT_SOUND}) );
  SetProp(P_QUALITY_DECAY, 550);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 5);
  SetProp(P_VALUE, 25000);
  SetProp(P_WEIGHT, 1900);
  SetProp(P_WIELD_RESTRICTIONS, 
    ([P_LEVEL:50, A_DEX:25, A_CON:23, P_GUILD:"bardengilde"]) );
  SetProp(P_MATERIAL, ([MAT_HORN:25, MAT_LEATHER:50, MAT_MAGIC: 25]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp("waffenbalsam", 10);

  SetProp(P_INSTRUMENT_TYPE, IT_WIND);
  SetProp(P_INSTRUMENT_LEVEL, 6);
}

