// /d/dschungel/feyaria/tijara/weapon/drachentoeter.c
// Ein Drachentoeter, eine wirklich maechtige Waffe zum Kampf gegen Drachen
// 23-11-96  Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

string oldtitle, creator;

int M, griff, metall, holz;

create()
{
  if( !is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Die Drachenlanze");
  SetProp(P_NAME, "Drachenlanze");
  SetProp(P_INFO, BS(
    "Dies ist eine Drachenlanze aus dem Reich der Legende. Selbst der "
    "staerkste Drache laesst sich mit dieser Lanze toeten. Weil der "
    "Drachentoeter aber so lange ist, ist er gegen kleine Wesen fast "
    "unwirksam.") );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_DAM_TYPE, ({DT_RIP, DT_PIERCE}) );
  SetProp(P_WC, 0);
  SetProp(P_WC_FIX, 0);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_QUALITY_DECAY, 1);
  SetProp(P_MATERIAL, ([MAT_MAGIC:5]) );
  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 300+random(100));
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_UNWIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
  SetProp("waffenbalsam", 10);
  SetProp(P_WIELD_RESTRICTIONS, ([P_XP:2222222, 
                                  SR_SEER: 1,
                                  A_STR: 25]) );
  
  AddId( ({"drachentoeter", "toeter", "lanze", "drachenlanze"}) );

  AddDetail( ({"spitze", "widerhaken"}), BS(
    "Die Widerhaken an der Spitze koennen sogar fuer einen Drachen toedlich "
    "sein.") );
  M=0;
}

int add_dragon_magic(int magic, int art)
{
  if( getuid(PO)==getuid() && !creator)
  {
    M+=magic;
    switch(art)
    {
      case 0:
        SetProp(P_WC, (magic==4?300:220+magic*30) );
        metall=({"",MAT_STEEL,MAT_MITHRIL,"",MAT_ADAMANT})[magic];
        SetProp(P_MATERIAL, QueryProp(P_MATERIAL)+([ metall:30]) );
        SetProp(P_VALUE, QueryProp(P_VALUE)*(magic+2) );
        break;
      case 1:
        SetProp(P_WC_FIX, (magic==1?0:magic*10) );
        griff=({"",MAT_PELT,MAT_LEATHER,"",MAT_SILK})[magic];
        SetProp(P_MATERIAL, QueryProp(P_MATERIAL)+([ griff:5]) );
        SetProp(P_VALUE, QueryProp(P_VALUE)*magic );
        break;
      case 2:
        SetProp(P_QUALITY_DECAY, 50*magic);
        holz=({"",MAT_MISC_WOOD,MAT_OAK,"",MAT_ELM_WOOD})[magic];
        SetProp(P_MATERIAL, QueryProp(P_MATERIAL)+([ holz:60]) );
        SetProp(P_VALUE, QueryProp(P_VALUE)*(magic+1) );
        break;
    }
  }
}

int query_dragon_magic()
{
  return M;
}

int WieldFunc(object waffe)
{
  TP->Set(P_TITLE, symbol_function("title", TO), F_QUERY_METHOD);
  return 1;
}

string title()
{
  if( !QueryProp(P_WIELDED) )
    return "";
  if( QueryProp(P_WIELDED)->QueryProp(P_GENDER)==FEMALE )
    return "die Drachenjaegerin";
  else
    return "der Drachenjaeger";
}

int UnwieldFunc(object waffe)
{
  QueryProp(P_WIELDED)->Set(P_TITLE, 0, F_QUERY_METHOD);
  return 1;
}

int HitFunc(object enemy)
{
  int schaden;
  if( enemy->QueryProp(P_SIZE)<100 )
  {
    write(BS(CAP(enemy->name(WER) )+" ist zu klein um mit dieser Waffe "
      "getroffen zu werden."));
    return -350;
  }
  if( enemy->QueryProp(P_SIZE)<200 && random(2) )
  {
    write( CAP(enemy->name(WER) )+" weicht Deiner Attacke aus.\n");
    return -250;
  }
  if( enemy->QueryProp(P_RACE)=="Drache" )
  {
    schaden=5*M+random(100+10*M);
    if( random(20000/M)==666 )
    {
      write("Die Magie der Drachenlanze vernichtet "+enemy->name(WEN)+".\n");
      return M*80+random(M*80);
    }
    if( schaden>200)
      write("Die Magie der Drachenlanze wendet sich gegen "+
       enemy->name(WEN)+".\n");
    return enemy->QueryProp(P_LEVEL)+schaden;
  }
  return 0;  
}

void fertig()
{
  if(!creator)
  {
    creator=getuid(TP);
    SetProp(P_LONG, 
        "Der Drachentoeter ist eine lange Lanze, deren Spitze mit vielen "
        "Widerhaken ausgeruestet ist. Sie ist die einzige Waffe, mit der man "
        "einen grossen Drachen vernuenftig bekaempfen kann. Der Stiel der Lanze "
        "besteht aus "+MATERIALDB->MaterialName(holz, WEM, TP)+
        ", und die widerhakenbestueckte Spitze wurde aus "+
        MATERIALDB->MaterialName(metall, WEM, TP)+" geschmiedet. Der Griff "
        "besteht aus "+MATERIALDB->MaterialName(griff, WEM, TP)+". Nur die "
        "begabtesten Schmiede sind in der Lage, eine solche Waffe herzustellen, "
        "diese wurde von "+CAP(creator)+" hergestellt.");
  }
}

