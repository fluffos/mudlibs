#include "../def.h"
#include "/p/daemon/itemd/itemd.h"
#include "/p/std/barden/instrument.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Eine praechtige Davul");
  SetProp(P_LONG, BS(
    "Diese praechtig geschmueckte Davul ist eine zweifellige Zylindertrommel, "
    "die mit Drachenhaut bespannt wurde. Der Koerper wurde aus einem seltenen, "
    "gruenlich schimmernden Holz gefertigt und ist mit zahlreichen Edelsteinen "
    "verziert. Ein breites Schulterband aus Ziegenfell wurde an kleinen Holzknubbeln "
    "angebunden, damit du die Davul angenehm tragen kannst. Ein grosser Schlegel "
    "wurde ebenfalls an den Trommelkoerper gebunden."));
  SetProp(P_NAME, "Davul");
  SetProp(P_NAME_ADJ, "praechtig")                 ;
  SetProp(P_GENDER, FEMALE);
  AddId( ({"davul", "\ninstrument", "trommel"}) );  
  AddAdjective( ({"praechtige", "praechtigen"}));
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 35);
  SetProp(P_DAM_TYPE, ({DT_SOUND, DT_BLUDGEON}) );
  SetProp(P_QUALITY_DECAY, 550);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 5);
  SetProp(P_VALUE, 25000);
  SetProp(P_WEIGHT, 1900);
  SetProp(P_WIELD_RESTRICTIONS, 
    ([P_LEVEL:50, A_DEX:25, A_CON:23, P_GUILD:"bardengilde"]) );
  SetProp(P_MATERIAL, ([MAT_SKIN:25, MAT_WOOD:50, MAT_MAGIC: 25]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp("waffenbalsam", 10);

  SetProp(P_INSTRUMENT_TYPE, IT_DRUM);
  SetProp(P_INSTRUMENT_LEVEL, 6);
}

