#include "../def.h"
#include "/p/daemon/itemd/itemd.h"
#include "/p/std/barden/instrument.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Eine verwachsene Kithara");
  SetProp(P_LONG, BS(
    "Die Kithara ist ein Saiteninstrument mit zehn Saiten, die offenbar aus "
    "einem natuerlich gewachsenen Ast gemacht wurde. Aus den Enden des Astes, "
    "der den Koerper formt wachsen sogar noch einzelne, gruene Blaetter. Die "
    "Saiten scheinen aus purem Gold zu bestehen."));
  SetProp(P_NAME, "Kithara");
  SetProp(P_NAME_ADJ, "verwachsen")                 ;
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kithara", "\ninstrument", "harfe"}) );  
  AddAdjective( ({"verwachsene", "verwachsenen"}));
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 35);
  SetProp(P_DAM_TYPE, ({DT_SOUND}) );
  SetProp(P_QUALITY_DECAY, 550);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 5);
  SetProp(P_VALUE, 25000);
  SetProp(P_WEIGHT, 1900);
  SetProp(P_WIELD_RESTRICTIONS, 
    ([P_LEVEL:50, A_DEX:25, A_CON:23, P_GUILD:"bardengilde"]) );
  SetProp(P_MATERIAL, ([MAT_SKIN:25, MAT_WOOD:50, MAT_MAGIC: 25]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp("waffenbalsam", 10);

  SetProp(P_INSTRUMENT_TYPE, IT_STRING);
  SetProp(P_INSTRUMENT_LEVEL, 6);
}

