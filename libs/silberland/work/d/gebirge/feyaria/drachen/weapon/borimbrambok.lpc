#include "../def.h"
#include "/p/daemon/itemd/itemd.h"
#include "/p/std/barden/instrument.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Borimbrambok");
  SetProp(P_LONG, BS(
    "Der Borimbrambok ist ein aeussert selten gefertigtes Glasinstrument. "
    "Er besteht aus drei mit feinen Glasroehrchen verbundenen Koerpern, die "
    "in Rot, Blau und Gruen schimmern. Aus dem wuerfelfoermigen roten Koerper "
    "ragen drei glaeserne Blashaelse, waehrend der blaue, pyramidenfoermige "
    "Koerper mit fuenf Haelsen, und der gruene ikosaederfoermige Koerper mit ganzen "
    "sieben Haelsen bestuckt ist. Um den Bormbrambok, ein Meisterwerk der "
    "Glasblaskunst, zu spielen muessen verschiedene Loecher an den Koerpern "
    "zugehalten und sanft ueber die Blashaelse gepustet werde. Nur ein Meisterbarde "
    "ihm einen Ton entlocken!"));
  SetProp(P_NAME, "Borimbrambok");               ;
  SetProp(P_GENDER, MALE);
  AddId( ({"borimbrambok", "\ninstrument"}) );  
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 35);
  SetProp(P_DAM_TYPE, ({DT_SOUND}) );
  SetProp(P_QUALITY_DECAY, 550);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 5);
  SetProp(P_VALUE, 25000);
  SetProp(P_WEIGHT, 1900);
  SetProp(P_WIELD_RESTRICTIONS, 
    ([P_LEVEL:50, A_DEX:25, A_CON:23, P_GUILD:"bardengilde"]) );
  SetProp(P_MATERIAL, ([MAT_SKIN:25, MAT_WOOD:50, MAT_MAGIC: 25]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp("waffenbalsam", 10);

  SetProp(P_INSTRUMENT_TYPE, IT_GLASS);
  SetProp(P_INSTRUMENT_LEVEL, 6);
}

