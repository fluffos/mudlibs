/*
** Wolfspfoten
** Eros - 1996-05-15
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../berg.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"wolfspfoten", "wolfspfote", "pfote", "pfoten"}));
  SetProp (P_SHORT, "Ein Paar Wolfspfoten");
  SetProp (P_LONG, "Ein Paar Wolfspfoten, aus festem Wolfsleder.\n");
  SetProp (P_NAME, "Paar Wolfspfoten");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 750);

  SetProp (P_ARMOUR_TYPE, AT_GLOVE);
  SetProp (P_AC, 8);

  SetProp (P_MATERIAL, MAT_FUR);
}
