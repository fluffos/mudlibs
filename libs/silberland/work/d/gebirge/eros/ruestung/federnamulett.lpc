/*
** Federnamulett
** 1996-05-05 Eros
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../berg.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"amulett","federnamulett"}));
  SetProp (P_SHORT, "Ein Federnamulett");
  SetProp (P_LONG, bs("Dieses Amulett hat einmal dem maechtigen "+
    "Vogel-Rok gehoert. Es besteht aus sehr widerstandsfaehigen Federn. "+
    "Sie sind nach einem ganz bestimmten Muster ineinandergelegt, und "+
    "somit ein guter Schutz.\n"));
  SetProp (P_NAME, "Federnamulett");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 900);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 5);

  SetProp (P_MATERIAL, ({MAT_HORN}));

  AddDetail ( ({"federn", "feder"}), 
    bs("Du pruefst genau und stellst fest, sie sind "+
    "sehr widerstandsfaehig.\n"));
  AddDetail ("muster", bs("Du bestaunst minutenlang dieses "+
    "Muster. Kannst aber nicht feststellen wie es genau aufgebaut ist.\n"));
}
