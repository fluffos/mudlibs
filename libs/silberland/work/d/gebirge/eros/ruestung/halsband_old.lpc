inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../berg.h"

#define HEALTIME 480
#define P_HEAL_TIME "halsband_heal_time"
int ready;
int restzeit;
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  ready = 0;
  AddId (({"halsband","band", "\nnein"}));
  SetProp (P_SHORT, "Ein Halsband");
  SetProp (P_LONG, BS("Dieses Halsband sieht wirklich praechtig aus. "
    "Viele kleine Steine, die in ihm fein eingebettet sind, strahlen "
    "und glitzern im Licht."));
  SetProp (P_NAME, "Halsband");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 1900);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_MISC);
  SetProp (P_AC, 0);
//  SetProp(P_WEAR_FUNC, TO );
//  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_INFO, "Dieses Halsband besitzt tatsaechlich magische "+
    "Kraefte. Jedoch wirkt die Magie \ndes Bandes nur, wenn "+
    "es Deine Haut spuert. Dies bedeutet auch, dass Du es \nzuerst "+
    "mit Deinen Kraeften aufladen musst, bevor es Dir helfen kann.\n"
    "Die Zauberworte lauten: \n"
    "\t'heile mich silberkraft' -> Du wirst wieder stark sein \n"
    "\t'heile mich silbermagie' -> Du wirst wieder zaubern koennen \n"
    "\t'heile mich silbermacht' -> Du wirst stark und kannst wieder "
    "zaubern \n");	
  SetProp (P_MATERIAL, ([MAT_LEATHER:80, MAT_JEWEL:20]) );

  AddSpecialDetail ( ({"halsband", "band"}), "halsband_det");
  AddDetail (({"steine", "stein"}),
    BS("Sie glitzern nicht nur hell, sie scheinen auch eine sehr positive "
    "Kraft auszustrahlen."));
  AddDetail (({"kraft", "kraefte", "magie"}), 
    BS("Dieses Band besitzt sicher "
    "magische Kraefte. Identifiziere es einmal mit Deinen magischen "
    "Kraeften."));

  AddCmd(({"heile", "heil"}), "silberkraft");
  
  SetProp(P_HEAL_TIME, time() );
  restzeit=0;
}

