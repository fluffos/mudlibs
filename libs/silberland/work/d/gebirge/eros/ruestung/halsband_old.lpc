BecomesNetDead(object wer) {
  if(wer==QueryProp(P_WORN)) {
//    restzeit=find_call_out("aufladen");
//    while(remove_call_out("aufladen")!=-1);
    restzeit=time()-QueryProp(P_HEAL_TIME);
  } 
}

BecomesNetAlive(object wer) {
  if(wer==QueryProp(P_WORN)) {
//    if((find_call_out("aufladen")==-1) && (restzeit>=0) && 
//       (!ready) && (QueryWorn() == wer))
//      call_out("aufladen", restzeit);
    SetProp(P_HEAL_TIME, time()-restzeit);
  }
}

