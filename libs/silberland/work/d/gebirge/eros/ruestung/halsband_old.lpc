string halsband_det()
{
  string l;
  l="Dieses Halsband sieht wirklich praechtig aus. "
    "Viele kleine Steine, die in ihm fein eingebettet sind, strahlen "
    "und glitzern ";
  if ( time()-QueryProp(P_HEAL_TIME)<HEALTIME ||
      time()-QueryProp(P_EQUIP_TIME)<HEALTIME/2 )
    l+="im Licht.";
  else
    l+="sehr hell im Licht.";
  return BS(l);
}

int silberkraft(string str)
{
  string was;
  if (QueryWorn()!=this_player())
  {
    notify_fail(BS("Die Kraft des Halsbandes kann nur auf Dich uebergehen, "
    "wenn Du es auch angezogen hast."));
    return 0;
  }

  if ( time()-QueryProp(P_HEAL_TIME)<HEALTIME ||
      time()-QueryProp(P_EQUIP_TIME)<HEALTIME/2 )
  {
    notify_fail(BS("So wie jeder magische Gegenstand muss auch das Halsband "
        "erst wieder seine magischen Kraefte erlangen."));
    return 0;
  }

  if(!str) return 0;

  if( this_player()->InFight() && this_player()->QueryProp(P_ATTACK_BUSY) )
  {
    notify_fail("Du bist zu erschoepft, um Dich zu heilen!\n"); 
    return 0;  
  }
  
  if (str=="mich silbermagie")
  {
    this_player()->AddSp(85+random(30));
    was="Magie.";
  }
  else if (str=="mich silberkraft")
  {
    this_player()->AddHp(85+random(30));
    was="Kraft.";
  }
  else if (str=="mich silbermacht")
  {
    this_player()->heal_self(40+random(20));
    was="Macht.";
  }
  else
  {
    notify_fail("Was soll Dich heilen?\n"); 
    return 0;  
  }

  write(BS("Eine magische Aura huellt Dich ein, und gibt Dir wieder "+was));
  
  say(BS("Eine magische Aura huellt "+this_player()->name(WER,RAW)+" kurz "
      "ein, und gibt "+this_player()->QueryPronoun(WEM)+" neue "+was));
  SetProp(P_HEAL_TIME, time() );
  if( this_player()->InFight() )
    this_player()->SetProp(P_ATTACK_BUSY, 1+random(3));
  return 1;
}

