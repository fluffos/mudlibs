/*
** Schuppenpanzer
** 1996-05-05 Eros
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../berg.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"panzer","schuppenpanzer"}));
  SetProp (P_SHORT, "Ein Schuppenpanzer");
  SetProp (P_LONG, bs("Dieser Schuppenpanzer besteht aus den legendaeren "+
    "Schuppen des Vogel-Rok. Die Schuppen sind durchzogen von Metall. "+
    "Sie sind daher ein besonders guter Schutz gegen Waffen aller "+
    "Art.\n"));
  SetProp (P_NAME, "Schuppenpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1200);
  SetProp (P_VALUE, 3500);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 37+random(3));

  SetProp (P_MATERIAL, ([MAT_HORN:80, MAT_MISC_METAL:20]) );
  SetProp (P_WEAR_RESTRICTIONS, ([P_LEVEL: 15 ,A_CON: 15]));

  AddDetail ("schuppen", "Sie sind unglaublich stabil, dabei aber leicht "+
    "und sehr beweglich untereinander.\nFast glaubt man, ein feines "+
    "Schuppenhemd vor sich zu haben.\n");

}
