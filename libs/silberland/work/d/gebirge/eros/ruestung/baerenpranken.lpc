/*
** Baerenpranken
** Eros - 1996-05-17
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../berg.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"baerenpranken", "baerenpranke", "pranken", "pranke"}));
  SetProp (P_SHORT, "Ein Paar Baerenpranken");
  SetProp (P_LONG, bs("Ein Paar grosse Baerenpranken, aus fester "+
    "Baerenhaut. Sie geben ein gutes Paar Stiefel ab.\n"));
  SetProp (P_NAME, "Paar Baerenpranken");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 400);
  SetProp (P_VALUE, 750);

  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 6);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3,T_HEAT_PROT:-1]) );
  SetProp (P_MATERIAL, MAT_FUR);

}
