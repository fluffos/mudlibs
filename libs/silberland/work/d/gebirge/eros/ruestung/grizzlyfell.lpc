/*
** Grizzlyfell
** (w) 1996-04-06 Woody@SL
** Eros 1996-05-07
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../berg.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"fell","grizzlyfell","\nfell_is_gerb_able"}));
  SetProp (P_SHORT, "Ein Grizzlyfell");
  SetProp (P_LONG, bs(
    "Dieses Baerenfell gehoerte wohl einmal einem grossen Grizzlybaeren. "+ 
    "Es schuetzt nicht nur, sondern waermt Dich auch.\n"));
  SetProp (P_NAME, "Grizzlyfell");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 1200);
  SetProp (P_VALUE, 750);

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 7);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5, T_HEAT_PROT:-3]) );
      
  SetProp (P_MATERIAL, MAT_FUR);
}
