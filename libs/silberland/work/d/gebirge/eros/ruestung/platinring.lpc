/*
** Platinring
** 1996-05-05 Eros
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../berg.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"ring","platinring"}));
  SetProp (P_SHORT, "Ein Platinring");
  SetProp (P_LONG, bs("Dieser Ring stammt aus einer der besten "+
    "Zwergenschmieden. Er ist unglaublich fein und zierlich gearbeitet. "+
    "Wunderschoene Runen sind darauf eingraviert. Sie sollen den "+
    "Besitzer vor allem Boesen bewahren.\n"));
  SetProp (P_NAME, "Platinring");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 700);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_RING);
  SetProp (P_AC, 5);

  SetProp (P_MATERIAL, MAT_PLATINUM );

  AddDetail ("platin", bs("Du pruefst genau und stellst fest, es ist "+
    "tatsaechlich reines Platin.\n"));
  AddDetail ("runen", bs("Du betrachtest begeistert die herrlichen "+
    "Runen. Sie stellen in Zwergenschrift gute Bannzauber dar. Mehr "+
    "kannst Du leider nicht erkennen.\n"));

}
