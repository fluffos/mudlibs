/*
** Wanderzwerg - Eros
** 1996-05-27
** Revision: 15.11.96 ->align reduziert, Damage_Typ includiert
*/


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "/d/gebirge/eros/berg.h"

create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Wanderzwerg");
  SetProp(P_LONG, bs(
    "Dieser Zwerg durchwandert schon seit Jahren das Gebirge. Er musste "+
    "viele Kaempfe ueberstehen, vorallem mit Woelfen. Deshalb sieht er "+
    "auch etwas zerkratzt aus, und hat viele Narben am Koerper. Dieses "+
    "einsame Leben machte ihn boesartig und sonderbar. Du hast von ihm "+
    "sicher nichts Gutes zu erwarten.\n"));
  SetProp(P_NAME,"Wanderzwerg");
  AddId(({"wanderzwerg", "zwerg"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Zwerg");
  create_default_npc(10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_HANDS, ({" mit seinen kleinen Haenden", 65, DT_BLUDGEON}));
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE  : -0.2, DT_POISON: -0.4, 
                                     DT_MAGIC :  0.2, DT_WATER :  0.4, ]) );
  SetProp(P_ALIGN, 20);
  SetProp(P_SIZE, 90+random(30));
  SetProp(P_XP, 40000);
  SetProp(P_MSGOUT, "schlurft weiter");
  SetProp(P_MSGIN, "schlurft gelangweilt herein");
//  set_living_name("wanderzwerg");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Wanderzwerg setzt eine freundliche Miene auf, mehr jedoch "+
    "nicht.\n"}) );
  SetProp(P_DIE_MSG, " stirbt fluchend unter Deinem Schlag.\n");
  SetProp(P_DEFAULT_INFO, "lacht Dich aus.\n");


  AddDetail ("koerper", "Der Koerper ist voller Narben.\n");
  AddDetail ("narben", "Sie zeugen von den vielen Kaempfen des "+
    "Wanderzwerges.\n");
  AddDetail ("narbe", "Sie sieht schlimm aus.\n");

  SetAttackChats(30, ({
    "Der Wanderzwerg spuckt Dich an.\n",
    "Der Wanderzwerg belegt Dich mit einem Fluch.\n",
    "Der Wanderzwerg tritt Dir gegen Dein Schienbein.\n",
    "Der Wanderzwerg beisst Dich in Deinen Fuss.\n"}));

  AddInfo("gebirge", "brummelt: Such doch selber rum.\n");
  AddInfo("magier", "kichert ueber Dich.\n");
  AddInfo(({"zwerge", "zwerg", "wanderzwerg", "wanderzwerge"}), 
    "brummelt: Was geht Dich das eigentlich an?\n");


  SUID;
  CLONEME (OBJ("beutel"));
  ob = clone_object ("/obj/money");
  ob->SetProp(P_AMOUNT, 500+random(401));
  ob->move(ME);


  SetProp(P_MNPC_AREA, ("/d/gebirge"));
  SetProp(P_MNPC_WAIT, ({ 10, 40, 40 }));
  SetProp (P_MNPC_DEFAULTROOM, "/d/gebirge/dusty/weg/k27");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

}

Attack(object enemy)
{
  int i;
  object ob; string raum;
  mapping exits; string *ausgaenge;
  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for (i = sizeof(ausgaenge)-1; i>=0; i--)
  {
  if (!objectp(enemy)) return;
  for (ob=first_inventory(exits[ausgaenge[i]]);ob;ob=next_inventory(ob))
      if (living(ob) && !query_once_interactive(ob) &&
        ob->id("wanderzwerg"))
      {
        raum = environment(this_player());
        ob->move(raum,M_TPORT,0,
        "springt davon als er einen Freund rufen hoert",
        "kommt hocherzuernt angelaufen");
        if(ob) // Koennte durch begruessungsschlag sterben
          ob->Kill(enemy);
      return ::Attack(enemy);
      }
  }

  if (!objectp(enemy)) return;
  for (ob=first_inventory(environment());ob;ob=next_inventory(ob))
        if (living(ob) && !query_once_interactive(ob) &&
                ob->id("wanderzwerg"))
          ob->Kill(enemy);
  return ::Attack(enemy);

}

