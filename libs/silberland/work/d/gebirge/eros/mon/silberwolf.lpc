/*
** Silberwolf - Eros und Eumel
** 1996-05-18
** Revision: 15.11.96 -> Damage_Typ includiert, Align reduziert,
**			 P_BODY reduziert
*/


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "/d/gebirge/eros/berg.h"

#define WMASTER "/d/gebirge/eros/wolfmaster"

void create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Silberwolf");
  SetProp(P_LONG, bs(
    "Ein maechtiger Silberwolf, der Dich gefaehrlich anstarrt. Sein "+
    "scharfes Gebiss schreckt Dich. Hoffentlich greift er Dich nicht "+
    "an.\n"));
  SetProp(P_NAME,"Silberwolf");
  AddId(({"silberwolf", "wolf", "\nsilberwolf_moving"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Wolf");
  create_default_npc(18);
  SetProp(P_DEFAULT_INFO, "knurrt Dich boese an.\n");
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_HANDS, ({" mit seinem scharfen Gebiss", 135, DT_RIP}));
  SetProp(P_ALIGN, 10);
  SetProp(P_SIZE, 110);
  SetProp(P_XP, 160000);
  SetProp (P_MSGOUT, "trottet weiter");
  SetProp (P_MSGIN, "trottet langsam herein");
//  set_living_name("silberwolf");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wolf will Deine Sachen nicht tragen.\n" }) );

  SUID;
  CLONEME ("/p/armour/cloak/wolfsfell");
  command ("ziehe wolfsfell an");
  CLONEME (WEAPON("wolfszahn"));

  SetProp(P_MNPC_AREA, ("/d/gebirge"));
  SetProp(P_MNPC_WAIT, ({ 10, 40, 40 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("berg_p19"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  WMASTER->add_wolf();

}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
    WMASTER->ruf_um_hilfe(enemy);
    return ::Defend(dam, dam_type, spell, enemy);
  }

void Attack(object enemy)
{
  int i;
  object ob, raum;
  mapping exits; string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for (i = sizeof(ausgaenge)-1; i>=0; i--)
  {
  if (!objectp(enemy)) return;
  for (ob=first_inventory(exits[ausgaenge[i]]);ob;ob=next_inventory(ob))
      if (living(ob) && !query_once_interactive(ob) &&
        ob->id("\nsilberwolf_moving"))
      {
        raum = environment(this_player());
        ob->move(raum,M_TPORT,0,
        "rennt davon als er ein Heulen aus der Ferne hoert",
        "kommt in gestrecktem Galopp angerannt");
        if (objectp(ob))
          ob->Kill(enemy);
      return ::Attack(enemy);
      }
  }

  if (!objectp(enemy)) return;
  for (ob=first_inventory(environment());ob;ob=next_inventory(ob))
        if (living(ob) && !query_once_interactive(ob) &&
                ob->id("silberwolf"))
          ob->Kill(enemy);
  return ::Attack(enemy);

}

varargs int remove(int arg)
  {
    WMASTER->remove_wolf(this_object());
    ::remove(arg);
  }

