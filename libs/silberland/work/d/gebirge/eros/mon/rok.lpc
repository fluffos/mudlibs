/*
** Vogel-Rok, Gebirge
** ---
** 1996-05-05 Eros und Eumel
** Revision: 15.11.96 -> Damage_Typ includiert, P_RACE includiert, 
**			 P_SIZE includiert, <new_skills.h> includiert,
**			 SHOW_DAMAGE includiert
** 10.3.98 : Umstellung auf default_spells
*/

inherit "std/npc";
inherit "std/npc/spells";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/gilden/waldlaeufer/ranger_tasks.h"

#include "../berg.h"

#define WMASTER "/d/gebirge/eros/wolfmaster"

void create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"rok","vogel","vogel-rok"}) );
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Rok");
  SetProp (P_SHORT, "Der Vogel-Rok");
  SetProp (P_LONG, "Der Vogel-Rok ist ein gewaltiges Tier. Er ist der "+
    "Koenig des Gebirges. Seine "+
    "enorme Groesse beeindruckt Dich sehr. Seine Augen betrachten Dich "+
    "gelangweilt. Trotzdem zucken seine scharfen Krallen in Deine "+
    "Richtung. Du solltest aufpassen, dass er Dich derweilen nicht mit "+
    "seinem harten Schnabel zerdrueckt.");
  SetProp (P_AGGRESSIVE, 0);
  SetProp (P_KILL_MSG,
    "Was suchst Du auch bei meinem Nest kleiner Wurm?");
  SetProp(P_KILL_NAME, "Der Vogel-Rok");
  SetProp (P_ALIGN, -200);
  create_default_npc(39);
  SetProp (P_RACE, "Vogel");
  SetProp (P_MAX_HANDS, 4);
  SetProp (P_SIZE, 300);
  SetProp (P_HANDS, 
    ({" mit seinen scharfen Krallen", QueryProp(P_HANDS)[1], DT_RIP}) );

  set_living_name("rok");

  // euid setzen, damit Ausruestung gecloned werden kann
  SUID;

  // Ausruestung
  CLONEME(ARMOUR("schuppenpanzer"));
  command ("ziehe schuppenpanzer an");
  if( random(3) )
  {
    CLONEME(ARMOUR("platinring"));
    command ("ziehe platinring an");
  }
  if( random(3) )
  {
    CLONEME(ARMOUR("federnamulett"));
    command ("ziehe federnamulett an");
  }

  AddDetail ("tier", "Der Vogel-Rok ist wahrhaftig eine Groesse fuer "+
    "sich.");
  AddDetail ("groesse", "Dieser riesige Vogel erweckt in Dir die "+
    "schrecklichsten Alptraeume. Wehe Du greifst ihn an, er wuerde "+
    "Dich wie eine Maus zertreten.");
  AddDetail ("krallen", "Diese scharfen und maechtigen Krallen sind "+
    "eine toedliche Waffe im Kampf. Verwesungsgeruch geht von ihnen "+
    "aus.");
  AddDetail ("schnabel", "Der Schnabel scheint irgendwie zu glitzern, "+
    "fast als ob er aus Stahl waere. Er ist eine toedliche Waffe fuer "+
    "jeden Gegner.");
  AddDetail ("augen", "Sie daemmern dunkel und es umspielt sie eine "+
    "gruenliche Aura. Irgendwie keimt der Verdacht in Dir auf, dass "+
    "sie dunkle Kraefte heraufbeschwoeren koennten.");
  AddDetail ("aura", "Sie umhuellt die Augen des Vogel-Rok. Die "+
    "Aura scheint stark geladen zu sein.");

  SetProp(P_SPELLRATE, 45);

  AddSpell(5,650,
    "Der Vogel-Rok feuert einen Strahl aus seinen Augen auf Dich.\n",
    "Der Vogel-Rok trifft @WEN mit seinem Augenstrahl.\n",
    DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,200,
    "Der Vogel-Rok haucht Dich mit seinem Todesatem an.\n",
    "Der Vogel-Rok haucht @WEN mit seinem Todesatem an.\n",
    DT_MAGIC, "flucht", ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1,200,DS_PARALYZE,
    "Der Vogel-Rok paralysiert Dich mit seinen Augen.\n",
    "Der Vogel-Rok paralysiert @WEN mit seinen Augen.\n");

  SetAttackChats(30, ({
    "Der Vogel-Rok kraechzt markerschuetternd.\n",
    "Der Vogel-Rok blickt Dich vernichtend an.\n",
    "Der Vogel-Rok wirft sich noch wuetender in den Kampf.\n",
    "Der Vogel-Rok fixiert Dich mit seinen Augen.\n",
    "Der Vogel-Rok haucht Dich mit seinem Todesatem an.\n",   
    "Der Vogel-Rok feuert einen Strahl aus seinen Augen auf Dich.\n"
    }) );

  SetProp (P_DIE_MSG, " stoesst seinen Todesschrei aus.\n");
  SetProp (P_DEFAULT_INFO, "kraechzt laut.\n");
  SetProp (P_MURDER_MSG, "Warte auf meine Wiederkehr, %s!\n");
  AddInfo ("rok", "schaut boese.\n");
  AddInfo ("vogel", "schaut boese.\n");
  AddInfo ("vogel-rok", "schaut boese.\n");
  AddInfo ("eier", "schnaubt Dich an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Vogel-Rok beachtet Deine wertlosen Sachen nicht einmal.\n" }) );

  WMASTER->add_wolf();

}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
    WMASTER->ruf_um_hilfe(enemy);
    return ::Defend(dam, dam_type, spell, enemy);
  }


varargs void die(int poisondeath)
{
  object ob;

  domainshout(this_player()->Name(WER,RAW)+" hat dem Vogel-Rok "+
    "seinen Todesstoss versetzt.\n", ({"gebirge","ebene"}) );

  ob = TP || QueryProp(P_KILLER);
  if(ob->QueryProp(P_GUILD) == "bardengilde" && ob->QuerySkill("lass den wind dich tragen") == 0)  {
    LearnBardSpell(ob, "lass den wind dich tragen", 
      "Dieses Lied verwandelt dich oder dein Ziel in einen Regenbogenfalken, der jeden Ort im Silberland aufsuchen kann.",
      "spiele 'lass den wind dich tragen' [auf <spieler>]");
  } else if(objectp(ob = present(RANGER_TASK_COURIER, TP || QueryProp(P_KILLER)))) {
    ob->SetTeil(3);
  }

  ::die(poisondeath);
}

void flucht()
{
  EnemyPresent()->SetProp(P_WIMPY,200);
  tell_object(EnemyPresent(),"Der Vogel-Rok teilt Dir mit: Du bist dem "+
    "Tod gerade noch einmal entronnen.\n");
  if( random(2) )
    EnemyPresent()->move("/d/gebirge/eros/room/berg_e19", M_GO, "runter", 
      "geht", "kommt an");
  else
    EnemyPresent()->move("/d/huegelland/feyaria/weg/room/wald3", M_GO, "hinunter",
      "faellt weit", "faellt von oben herein");
}

varargs int remove(int arg)
  {
    WMASTER->remove_wolf(this_object());
    return ::remove(arg);
  }

