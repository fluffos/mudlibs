/*
** Anfuehrerwolf - Eros
** 1996-05-11
** Revision: 15.11.96 -> Damage_Typ includiert, Livingname includiert,
** 			 Align reduziert, P_BODY reduziert
*/


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../berg.h"

#define WMASTER "/d/gebirge/eros/wolfmaster"

void create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Anfuehrersilberwolf");
  SetProp(P_LONG, bs(
    "Ein maechtiger Silberwolf, der Dich gefaehrlich anstarrt. Sein "+
    "scharfes Gebiss schreckt Dich. Dieser Wolf ist nicht zu unrecht "+
    "Anfuehrer dieses Rudels. Man merkt es an seinen klugen Augen.\n"));
  SetProp(P_NAME,"Anfuehrersilberwolf");
  AddId(({"silberwolf", "wolf", "anfuehrer", "anfuehrerwolf",
    "anfuehrersilberwolf"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Wolf");
  create_default_npc(22);
  SetProp(P_AGGRESSIVE, 0.3);
  SetProp(P_BODY, 95);
  SetProp(P_HANDS, ({" mit seinem scharfen Gebiss", 350, DT_RIP}));
  SetProp(P_ALIGN, 50);
  SetProp(P_SIZE, 150);
  SetProp(P_NOMAGIC, 25);
//  set_living_name("anfuehrerwolf");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wolf will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,33);

  AddSpell(1,350,
    "Der Anfuehrersilberwolf beisst Dir eine tiefe Fleischwunde ins Bein!\n",
    "Der Anfuehrersilberwolf beisst @WEM eine tiefe Fleischwunde ins Bein!\n",
     ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );
        
  
  SUID;
  CLONEME ("/p/armour/cloak/wolfsfell");
  command ("ziehe wolfsfell an");
  CLONEME (WEAPON("wolfszahn"));
  CLONEME (ARMOUR("wolfspfoten"));
  command ("ziehe wolfspfoten an");

  AddDetail ("anfuehrer", "Seine klugen Augen ueberwachen alles hier.\n");
  AddDetail ("rudel", "Du stehst davor.\n");
  AddDetail ("augen", "Sie haben schon viel von der Welt gesehen.\n");

  WMASTER->add_wolf();

}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
    WMASTER->ruf_um_hilfe(enemy);
    return ::Defend(dam, dam_type, spell, enemy);
  }

void Attack(object enemy)
{
  object ob;

  for (ob=first_inventory(environment());ob;ob=next_inventory(ob))
        if (living(ob) && !query_once_interactive(ob) &&
                ob->id("silberwolf"))
          ob->Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
  {
    WMASTER->remove_wolf(this_object());
    return::remove(arg);
  }
