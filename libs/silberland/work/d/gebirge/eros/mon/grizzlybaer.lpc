/*
** Grizzlybaer - Eros
** 1996-05-11
** Revision: 15.11.96 -> Damage_Typ includiert, P_RACE includiert
**			 P_BODY reduziert
*/


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../berg.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Babygrizzlybaer");
  SetProp(P_LONG, BS(
    "Ein putziger kleiner Grizzlybaer, der Dich neugierig ansieht. Sein "+
    "ganzes Wesen weckt in Dir den Eindruck, dass er noch sehr "+
    "verspielt ist. Obwohl er bereits ziemlich scharfe Krallen besitzt, "+
    "sieht er noch nicht sehr gefaehrlich aus. Aber Vorsicht, seine "+
    "Mutter und sein Vater sind sicher nicht weit.\n"));
  SetProp(P_NAME,"Babygrizzlybaer");
  AddId(({"grizzlybaer", "baer", "grizzly", "babygrizzly",
    "babygrizzlybaer", "babybaer"}));
  SetProp(P_GENDER, MALE);
  create_default_npc(18);
  SetProp(P_DEFAULT_INFO, "schleckt Dich von oben bis unten ab.\n");
  SetProp(P_BODY, 90);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", 450, DT_RIP}));
  SetProp(P_ALIGN, 200);
  SetProp(P_SIZE, 110);
  SetProp(P_RACE, "Baer");
  SetProp(P_INFO, bs("Der kleine Babygrizzlybaer ist sicher staerker "+
    "als es den Anschein hat, und er hat sehr starke Eltern!\n"));
//  set_living_name("babygrizzlybaer");

  SUID;
  CLONEME (ARMOUR("grizzlyfell"));
  command ("ziehe grizzlyfell an");
  CLONEME (ARMOUR("baerenpranken"));
  command ("ziehe baerenpranken an");
  CLONEME (WEAPON("grizzlykralle"));

}
