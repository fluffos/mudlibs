/*
** Wolfszahn
** Eros 1996-05-11
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../berg.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"wolfszahn","zahn"}));
  SetProp (P_SHORT, "Ein Wolfszahn");

  SetProp (P_LONG, "Der scharfe Zahn eines Silberwolfs.\n");
  SetProp (P_NAME, "Wolfszahn");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 550);
  SetProp (P_WEIGHT, 600);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 80);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_HORN);
}
