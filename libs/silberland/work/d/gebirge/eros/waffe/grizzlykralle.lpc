/*
** Grizzlykralle
** Eros 1996-05-11
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../berg.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"grizzlykralle","kralle"}));
  SetProp (P_SHORT, "Eine Grizzlykralle");
  SetProp (P_LONG, "Die scharfe Kralle eines Grizzlybaeren.\n");
  SetProp (P_NAME, "Grizzlykralle");
  SetProp (P_GENDER, FEMALE);

  SetProp (P_VALUE, 750);
  SetProp (P_WEIGHT, 800);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 95);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_HORN);
}
