** Eros 1996-05-07
*/


inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../berg.h"

create()
{
	::create();

	SetProp( P_INT_SHORT, "Ein Gebirgspfad");
	SetProp( P_INT_LONG, bs( "Du gehst auf einem ziemlich ausgetrampelt "
		+"wirkenden Gebirgspfad. Schotter und Steine liegen am Weg. "
		+"Der Berg, den Du erblickst, wirkt irgendwie todbringend "
		+"und unheimlich. Du musst allen Mut aufbringen, um "
		+"ueberhaupt noch voran zu kommen. Im Norden fuehrt der Weg "
                +"in einen kleinen Turm hinein.\n"));
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN:TT_MOUNTAIN]));

  AddDetail( ({ "staub", "staubschicht", "schicht" }),
		"Du malst gelangweilt einige Kreise in den Staub.\n");

  AddDetail( ({"turm"}),
      "Er sieht gar nicht unheimlich aus, geht einfach mal rein!");
  AddDetail( ({ "schotter" }),
           break_string( "Der Schotter besteht aus einzelnen kleinen "+
           "Steinen, ideal, um auch nach langen Wanderungen keine Wunden "+
           "an den Fuessen zu bekommen. Auch bei anstrengenden "+
           "Bergbesteigungen wie diesen!", 78 ) );
  AddDetail( ({ "farbe", "farben" }),
        break_string( "Grau, schwarz, ocker, roetlich, blaeulich...", 78 ));
  AddDetail( ({ "formen", "form" }),
                break_string( "Eckig, rund, abgeschliffen, gezackt, "+
                "gekantet, gross, klein, duenn, dick...", 78 ) );
  AddDetail( ({ "steine", "stein" }),
                break_string( "Die Steine haben alle moeglichen Formen und "+
                "Farben. Sie scheinen jedoch wertlos zu sein, denn edel "+
                "schaut keiner von ihnen aus.", 78 ) );
  AddDetail( ({ "fuesse", "fuessen" }),
                break_string( "Noch keine Wunden dran zu sehen!", 78 ) );
  AddDetail( ({ "himmel" }),
        break_string( "Der Himmel befindet sich graublau ueber Dir.", 78 ) );
  AddDetail( ({ "weg", "gebirgspfad", "boden", "grund", "pfad" }),
                break_string( "Der Boden besteht aus Schotter, so wie "+
                "offensichtlich der ganze Pfad, zu diesem unheimlichen Berge "+ 
                "vor Dir fuehrt.", 78 ) );

  AddDetail( ({ "berg", "berge" }),
                break_string( "Der Berg lauert geheimnisvoll auf Deine "+   
                "Ankunft. Du ueberlegst, ob er Dich verschlingen will oder "+
                "Dir unglaubliche Reichtuemer bescheren wird.", 78 ) );

  AddExit("westen", ROOM("berg_r18"));
  AddExit("osten", ROOM("berg_t18"));

}
