inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../berg.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Schluchteingang");
  SetProp( P_INT_LONG, bs( "Du muehst Dich den Pfad herauf, und stehst "+
    "vor dem Eingang einer Schlucht. Steile Waende ziehen sich rechts "+
    "und links hoch. Es wird auch etwas kuehler. Diffuse Schatten "+
    "bewegen sich, fast als ob sich Lebewesen dahinter verbergen "+
    "wuerden. Mit einem mulmigen Gefuehl stehst Du vor der Schlucht.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_MOUNTAIN]));

  AddDetail( ({ "pfad", "boden"}),
    "Du folgst einem steilen Pfad, der auf festem Boden angelegt ist.\n");

  AddDetail( ({ "eingang", "schluchteingang" }), 
    bs("Du stehst am Eingang einer finsteren Schlucht. Die Waende "+
    "verdecken die freie Sicht auf die Sonne. Ein mulmiges Gefuehl "+
    "beschleicht Dich.\n"));
  AddDetail( ({ "waende", "wand" }),
    bs("Die Waende erstrecken sich weit nach oben. Diffuse Schatten "+
    "spielen an ihnen entlang. Ob es hier Steinschlag gibt?\n"));
  AddDetail("schlucht",
    bs("Ja, Du stehst vor einer Schlucht. Jetzt kannst Du Dich "+
    "entscheiden, ob Du rein gehst, oder doch lieber umkehrst.\n"));
  AddDetail( ({ "schatten", "wesen", "lebewesen" }),
    bs("Die Schatten sehen aus als wuerden sie leben. Doch genaueres "+
    "kann man von hier aus nicht feststellen.\n"));
  AddDetail( ({ "stein", "steinschlag", "schlag", "steine" }),
    bs("Huch da poltert gerade wieder ein Stein auf Dich herunter. "+
    "Mit viel Geschicklichkeit bist Du dem Tod doch noch entgangen.\n"));
  AddDetail("himmel",
    bs("Der Himmel befindet sich graublau ueber Dir.\n"));
  AddDetail("gefuehl",
    bs("Irgendwie scheint Dich Dein Gefuehl vor irgend etwas warnen "+
    "zu wollen, aber nur vor was?\n"));

  AddDetail( ({ "berg", "berge" }),
    bs("Der Berg lauert geheimnisvoll auf Deine "+   
    "Ankunft. Du ueberlegst, ob er Dich verschlingen will oder "+
    "Dir unglaubliche Reichtuemer bescheren wird.\n"));

  AddExit("suedwesten", ROOM("berg_m19"));
  AddExit("osten", ROOM("berg_o18"));

}
