inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../berg.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "In einer Felswand");
  SetProp (P_INT_LONG, bs(
    "Du stehst auf einem grossen Vorsprung in der Felswand. Steil "+
    "geht es rund um Dich bergab. Du froestelst. Hoffentlich werden "+
    "keine Steine locker und reissen Dich mit in die Tiefe. Ein "+
    "riesiges Nest faellt Dir auf, in dem ein maechtiger Vogel-Rok "+
    "wohl seine Eier ausbruetet. Die Felswand fuehrt hier weiter nach "
    "oben. Was da oben wohl ist? Ob man da raufklettern kann?"));

  AddDetail ("vorsprung", bs("Du stehst mitten auf einem grossen "+
    "Vorsprung in der Felswand.\n"));
  AddDetail (({"felswand", "wand"}), 
      "Die ist ueberall um Dich enorm steil. Allerdings fuer einen "
      "gestandenn Helden wie Dich duerfte es kein Problem sein, weiter "
      "nach oben zu klettern.");
  AddDetail( ({"helden", "held"}),
      "Ja, Du bist einer. Oder?");
  AddDetail( ({"problem"}),
      "Naja, es ist schon steil ... aber fuer einen Helden wie Dich ist "
      "das _absolut_ kein Problem ...");
  AddDetail ("steine", "Sie koennten Dich in die Tiefe mitreissen.\n");
  AddDetail ("tiefe", "Wuah, Dir schwindelt so tief ist es hier.\n");
  AddDetail ("boden", "Der Boden besteht aus Fels. Einige Knochen "+
    "verteilen sich ueber ihn.\n");
  AddDetail ("fels", "Fester Fels ist das.\n");
  AddDetail (({"rok", "vogel", "vogel-rok"}), "Er ist zum Glueck "+
    "gerade nicht da.\n");
  AddDetail (({"ei","eier"}), "Sie liegen in dem riesigen Nest.\n");
  AddDetail ("nest", bs(
    "Das riesige Nest des Vogel-Rok. Grosse Eier "+
    "liegen darin, und warten darauf ausgebruetet zu werden.\n"));
  AddDetail ("knochen", "Hm, da waren wohl wieder einige Abenteurer "+
    "etwas zu unvorsichtig.\n");
  AddDetail ("sonne", "Sie scheint heute sehr kraeftig, aber "+
    "Hoehensonne soll ja gut fuer die Haut sein.\n");
  AddDetail ("himmel", "Der Himmel strahlt Dich mit seinem blau "+
    "beruhigend an.\n");
  AddDetail ("blau", "Ja es ist himmlisches himmelblau.\n");
  AddDetail ( ({"geraeusche", "geraeusch"}),
    "Vielleicht solltest Du es mit lauschen probieren?\n");
  AddDetail ("duft", "Vielleicht solltest Du es mit riechen probieren?\n");
  AddDetail ("ende", "Das ist ein Befehl. Du kannst ihn eingeben.\n");

  AddSound (({DEFAULT_SOUND,"geraeusche"}), bs("Du vernimmst ein "+
    "hohles Brausen, das wohl der Wind erzeugt.\n"));
  AddSound ("geraeusch", bs("Du vernimmst ein "+
    "hohles Brausen, das wohl der Wind erzeugt.\n"));
  AddSound ("brausen", bs("Ja, Du hoerst den Wind ueber den Fels "+
    "brausen.\n"));
  AddSound ("wind", bs("Er erzeugt ein leichtes Brausen.\n"));

  AddSmell (({DEFAULT_SMELL,"duft"}), bs("Es riecht hier streng nach "+
    "Schweiss.\n"));
  AddSmell ("schweiss", bs("Er riecht sehr aetzend und sticht in Deiner "+
    "Nase.\n"));

  AddItem (MON("rok"), REFRESH_DESTRUCT);

  AddExit("runter", ROOM("berg_e19"));
  AddCmd( ({"kletter", "klettere"}), "climb");
}

int climb(string str) {
  notify_fail("Wohin willst Du klettern?\n");
  if(!str) return 0;
  notify_fail("Dorthin kannst Du nicht klettern!\n");
  if( member( ({"wand","felswand","felswand rauf","felswand hoch",
     "auf felswand", "auf wand", "rauf", "nach oben"}), str)!=-1 )
  {
    if( present("seil", TP) )
    {
      if( present("kletterhaken", TP) )
      {
        if( TP->QueryAttribute(A_DEX)<13)
        {
          write("Du bist nicht geschickt genug fuer so eine Kletterei.\n");
          return 1;
        }
        write( BS("Mit Hilfe von Seil und Kletterhaken kannst Du die steile "
          "Felswand bezwingen.") );
        TP->move("/d/gebirge/feyaria/drachen/room/portal", M_GO, 
            "die steile Felswand hinauf",
             "klettert", "kommt heraufgeklettert");
        return 1;
      }
      write( BS("Mit einem Seil alleine kannst Du es nicht schaffen. Du "
        "braeuchtest noch Kletterhaken, denn die Felswand ist hier wirklich "
        "sehr steil.") );
      return 1;
    }
    write( BS("Die Felswand ist hier zu steil, um noch hoeher zu klettern. "
      "Du braeuchtest schon eine spezielle Kletterausruestung dafuer.") );
    return 1;
  }
  return 0;
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}

