/*
** Bergflanke
** ---
** 1996-04-10 (Woody) 1.0  Release
** 1996-05-06 (Eros)
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../berg.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "Auf einem Bergpfad");
  SetProp (P_INT_LONG, bs(
    "Du erreichst eine kleine Weggabelung. Ein Weg zweigt nach "+
    "Nordwesten ab, er wirkt duester auf Dich. Der andere Weg gleicht "+
    "einem Wanderpfad. Schotter und Steine erschweren Dir auch hier "+
    "das Weiterkommen. Der unheimliche Berg scheint immer hoeher zu "+
    "werden, ob das eine optische Taeuschung ist?\n"));

  AddDetail ("schotter", bs("Er liegt ueberall am Weg herum und "+
    "erschwert das weiterkommen.\n"));
  AddDetail (({"steine", "stein"}), bs("Sie liegen auf und neben dem "+
    "Weg, und verursachen Dir Schwierigkeiten beim weitergehen.\n"));
  AddDetail ("berg", bs("Er ragt bedrohlich und erdrueckend vor Dir in "+
    "den Himmel auf. Du musst all Deinen Mut zusammenraufen um "+
    "ueberhaupt noch weiter zu gehen.\n"));
  AddDetail ("taeuschung", bs("Ja es war eine Taeuschung, denn Du "+
    "gelangst immer hoeher auf den Berg hinauf.\n"));
  AddDetail ("boden", bs("Du stehst fest und sicher auf ihm.\n"));
  AddDetail ("himmel", bs("Der Himmel spannt sich in einem schoenen "+
    "himmelblau ueber Dir. Die Sonne scheint hell.\n"));
  AddDetail (({"weg", "gabelung", "weggabelung"}), bs("Der Weg teilt sich "+
    "hier in zwei Richtungen auf. Eine nordwestliche und eine "+
    "nordoestliche.\n"));
  AddDetail (({"wanderpfad", "pfad", "bergpfad"}),
    bs("Er scheint oefters benutzt zu "+
    "werden. Wahrscheinlich kommt man auf ihm zur Bergspitze hoch.\n"));
  AddDetail (({"bergspitze", "spitze"}), bs("Du bist noch viel zu "+
    "weit entfernt, um irgendetwas zu erkennen.\n"));
  AddDetail ("sonne", bs("Sie scheint heute sehr kraeftig, aber "+
    "Hoehensonne soll ja gut fuer die Haut sein.\n"));
  AddDetail ("blau", bs("Ja es ist himmlisches himmelblau.\n"));
  AddDetail ( ({"geraeusche", "geraeusch"}), bs("Vielleicht "+
    "solltest Du es mit lauschen probieren?\n"));
  AddDetail ("duft", bs("Vielleicht solltest Du es mit riechen "+
    "probieren?\n"));
  AddDetail ("ende", bs("Das ist ein Befehl. Du kannst ihn eingeben.\n"));

  AddSound (({DEFAULT_SOUND,"geraeusche"}), bs("Du vernimmst ein "+
    "hohles Brausen, das wohl der Wind erzeugt.\n"));
  AddSound ("geraeusch", bs("Du vernimmst ein "+
    "hohles Brausen, das wohl der Wind erzeugt.\n"));
  AddSound ("brausen", bs("Ja, Du hoerst den Wind ueber den Weg "+
    "brausen.\n"));
  AddSound ("wind", bs("Er erzeugt ein leichtes Brausen.\n"));

  AddSmell (({DEFAULT_SMELL,"duft"}), bs("Es riecht hier streng nach "+
    "Schweiss.\n"));
  AddSmell ("schweiss", bs("Hm, Du hast Dich beim Wandern wohl sehr "+
    "angestrengt.\n"));

  AddItem (MON("silberwolf"), REFRESH_DESTRUCT);

  AddExit("nordosten", ROOM("berg_j19"));
  AddExit("nordwesten", ROOM("berg_h19"));
  AddExit("runter", WEG("i21"));
  AddExit("unten", WEG("i21"));

  SetProp (P_HIDE_EXITS, ({"runter"}) );
}
