/*
** Bergwald
** ---
** 1996-04-10 (Woody) 1.0  Release
** 1996-05-07 (Eros)
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../berg.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_FOREST]));
  SetProp (P_INT_SHORT, "In einem Wald");
  SetProp (P_INT_LONG, bs(
    "Du muehst Dich den Pfad herauf, und stehst ploetzlich am Eingang "+
    "zu einem Wald. Riesige alte Tannen und Fichten wachsen in den "+
    "Himmel. Duester trifft Dich der Schatten der Baeume, und Du "+
    "merkst wie es wieder kuehler wird. Zwischen den Baeumen fuehrt "+
    "der Pfad nach Nordosten tiefer in den Wald hinein.\n"));

  AddDetail (({"pfad", "weg"}), bs("Er fuehrt nach Nordosten in den "+
    "dunklen Wald hinein.\n"));
  AddDetail ("berg", bs("Er ragt bedrohlich und erdrueckend vor Dir in "+
    "den Himmel auf. Du musst all Deinen Mut zusammenraufen um "+
    "ueberhaupt noch weiter zu gehen.\n"));
  AddDetail ("eingang", bs("Du stehst vor einem alten Wald. "+
    "Alte Baeume stehen rund um Dich. Sie wiegen sich sanft im Wind.\n"));
  AddDetail ("boden", bs("Du stehst fest und sicher auf ihm.\n"));
  AddDetail ("himmel", bs("Der Himmel spannt sich in einem schoenen "+
    "himmelblau ueber Dir. Die Sonne scheint hell.\n"));
  AddDetail ("sonne", bs("Sie scheint heute sehr kraeftig, aber "+
    "Hoehensonne soll ja gut fuer die Haut sein.\n"));
  AddDetail ("wald", bs("Du stehst vor einem alten Wald mit knorrigen "+
    "Baeumen, die sich im Wind wiegen.\n"));
  AddDetail ("blau", bs("Ja es ist himmlisches himmelblau.\n"));
  AddDetail ( ({"baeume", "baum"}), bs("Sie muessen schon recht lange "+
    "hier stehen, so alt wie sie aussehen.\n"));
  AddDetail ( ({"tanne", "tannen"}), bs("Sie stehen in dichten Reihen "+
    "vor Dir, und lassen Dir nur den einen Weg frei.\n"));
  AddDetail ( ({"fichte", "fichten"}), bs("Sie verfinstern den Wald und "+
    "machen ein Eindringen abseits des Weges unmoeglich.\n"));
  AddDetail ("schatten", bs("Die Schatten bewegen sich zwischen den "+
    "Baeumen. Es koennten wilde Tiere oder auch noch uebleres sein.\n"));
  AddDetail ( ({"geraeusche", "geraeusch"}), bs("Vielleicht "+
    "solltest Du es mit lauschen probieren?\n"));
  AddDetail ("duft", bs("Vielleicht solltest Du es mit riechen "+
    "probieren?\n"));
  AddDetail ("ende", bs("Das ist ein Befehl. Du kannst ihn eingeben.\n"));
  AddDetail ( ({"zapfen", "tannenzapfen"}), bs("Du kannst nichts "+
    "genaueres erkennen.\n"));
  AddSound (({DEFAULT_SOUND,"geraeusche"}), bs("Du vernimmst ein "+
    "leises Rauschen, das wohl der Wind erzeugt.\n"));
  AddSound ("geraeusch", bs("Du vernimmst ein "+
    "leises Rauschen, das wohl der Wind erzeugt.\n"));
  AddSound ("rauschen", bs("Ja, Du hoerst den Wind ueber die Baeume "+
    "rauschen.\n"));
  AddSound ("wind", bs("Er scheint Dir Geschichten von mutigen "+
    "Abenteurern zu erzaehlen.\n"));
  AddSound ("geschichten", bs("Du lauscht begeistert was Dir der Wind "+
    "alles berichtet.\n"));

  AddSmell (({DEFAULT_SMELL,"duft"}), bs("Es riecht hier nach frischen "+
    "Tannenzapfen.\n"));
  AddSmell ( ({"zapfen", "tannenzapfen"}),
    bs("Hmmm, wie das herrlich duftet!\n"));

  AddItem (MON("wanderzwerg"), REFRESH_DESTRUCT);
  AddExit("nordwesten", "/d/gebirge/impulz/paladinweg/room/weg_7");
  AddExit("suedwesten", ROOM("berg_u14"));
  AddExit("nordosten", ROOM("berg_w12"));
}
