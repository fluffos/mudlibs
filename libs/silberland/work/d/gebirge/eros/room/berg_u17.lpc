** Eros 1996-05-07
*/


inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../berg.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Geroellfeld");
  SetProp( P_INT_LONG, bs( "Du stehst am Beginn eines Geroellfeldes, "+
    "das sich weit nach oben hinzieht. Links und rechts von Dir siehst "+
    "Du nur Steine. Manche groesser, manche kleiner. Dir wird vor "+
    "lauter Steinen ganz uebel. Der Pfad endet hier. Du kannst nur "+
    "versuchen das Geroellfeld nach oben zu erklimmen, oder "+
    "umkehren.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN:TT_MOUNTAIN]));

  AddDetail( ({ "staub", "staubschicht", "schicht" }),
   bs("Ueber dem Geroellfeld liegt eine dicke Staubschicht.\n"));

  AddDetail( ({ "schotter" }),
    bs("Der Schotter besteht aus einzelnen kleinen "+
    "Steinen, ideal, um auch nach langen Wanderungen keine Wunden "+
    "an den Fuessen zu bekommen. Auch bei anstrengenden "+
    "Bergbesteigungen wie diesen!\n"));
  AddDetail( ({ "farbe", "farben" }),
    bs("Grau, schwarz, ocker, roetlich, blaeulich...\n"));
  AddDetail( ({ "formen", "form" }),
    bs("Eckig, rund, abgeschliffen, gezackt, "+
    "gekantet, gross, klein, duenn, dick...\n"));
  AddDetail( ({ "steine", "stein" }),
    bs("Die Steine haben alle moeglichen Formen und "+
    "Farben. Sie scheinen jedoch wertlos zu sein, denn edel "+
    "schaut keiner von ihnen aus.\n"));
  AddDetail( ({ "fuesse", "fuessen" }),
    bs("Noch keine Wunden dran zu sehen!\n"));
  AddDetail( ({ "himmel" }),
    bs("Der Himmel befindet sich graublau ueber Dir.\n"));
  AddDetail( ({ "geroellfeld", "boden", "feld", "pfad", "geroell" }),
    bs("Geroell, wohin Du auch schaust. Diese Eintoenigkeit geht Dir "+
    "wirklich ziemlich auf Die Nerven. Du solltest versuchen so "+
    "schnell als moeglich diese Einoede zu verlassen, um Schaeden "+
    "an Deinem Gemuet zu vermeiden.\n"));
  AddDetail( ({"einoede", "nerven", "eintoenigkeit", "schaeden", "schaden"}),
    bs("Deine Nerven sind bald am Ende.\n"));
  AddDetail( ({ "berg", "berge" }),
    bs("Der Berg lauert geheimnisvoll auf Deine "+   
    "Ankunft. Du ueberlegst, ob er Dich verschlingen will oder "+
    "Dir unglaubliche Reichtuemer bescheren wird.\n"));

  AddItem (MON("silberwolf"), REFRESH_DESTRUCT);

  AddExit("suedwesten", ROOM("berg_t18"));
  AddExit("oben", ROOM("berg_u16"));

}
