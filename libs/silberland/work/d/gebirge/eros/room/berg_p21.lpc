/*
** Hoehle
** Eros 1996-05-07
*/


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include "../berg.h"

int halsband;

create()
{
  ::create();
  halsband = 1;
  SetProp( P_INT_SHORT, "Eine Hoehle");
  SetProp( P_INT_LONG, bs( "Du stehst mitten in der Hoehle der "+
    "Silberwoelfe. Von draussen faellt noch etwas Licht herein. Die "+
    "Hoehle sieht verwildert aus. Knochen und Fleischreste liegen am "+
    "Boden herum. An den Waenden bemerkst Du Kratzspuren. Hoffentlich "+
    "haben die Woelfe nicht gerade jetzt Hunger!\n"));
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN:TT_CAVE]));

  AddDetail ("hoehle", bs("Sie ist erfuellt von einem graesslichen "+
    "Gestank, der Dich fast umwirft. Wild verstreut liegen Knochen und "+
    "Fleischreste am Boden herum.\n"));
  AddDetail ("boden" , bs("Eine grosse Menge Knochen und Fleischreste "+
    "zeugen davon, dass diese Woelfe bereits viele Opfer gefunden haben. "+
    "Vielleicht bist Du ja das naechste.\n"));
  AddDetail ("decke", bs("Es scheint sich hier um eine natuerliche "+
    "Hoehle zu handeln. Du entdeckst ausser scharfen Zacken nichts "+
    "besonderes.\n"));
  AddDetail (({"zacke", "zacken"}), bs("Sie sehen ziemlich scharf aus.\n"));
  AddDetail (({"wand", "waende"}), bs("Du bemerkst Kratzspuren daran. "+
    "Sie stammen sicher von den Woelfen, die hier ihre Krallen geschaerft "+
    "haben. An einer Wand entdeckst Du eine Nische.\n"));
  AddDetail (({"spuren", "kratzspuren"}), bs("Sie sind ziemlich tief. "+
    "Die Woelfe scheinen hier viel und oft ihre Krallen zu schaerfen.\n"));
  AddDetail ("knochen", bs("Es scheint sich vorwiegend um Menschenknochen "+
    "zu handeln. Aber es liegen auch Zwergenknochen, und sogar vereinzelt "+
    "Hobbitknochen darunter.\n"));
  AddDetail ("menschenknochen", bs("Sie liegen in grosser Anzahl am "+
    "Boden herum. Menschen scheinen die Lieblingsopfer der Woelfe zu "+
    "sein.\n"));
  AddDetail ("zwergenknochen", bs("Sie liegen nicht mehr so haeufig in "+
    "in der Hoehle herum.\n"));
  AddDetail ("hobbitknochen", bs("Unglaublich, Du hast tatsaechlich einen "+
    "Hobbitknochen gefunden. An ihm haengen sogar noch einige "+
    "Fleischreste. Schnell wirfst Du ihn wieder weg.\n"));
  AddDetail (({"fleischreste", "reste", "fleisch"}), bs("Vergammelter "+
    "Geruch steigt Dir in die Nase. Dir wird uebel als Du erkennst, dass "+
    "es Reste eines ehemaligen Elfen sind. Anscheinend war der Elf die "+
    "letzte Mahlzeit der Woelfe.\n"));
  AddDetail (({"geruch", "gestank"}), bs("Rieche doch mal.\n"));
  AddSpecialDetail("nische", "nische");
  AddSmell (({DEFAULT_SMELL,"gestank"}), bs("Der Gestank ist widerlich. "+
    "Es riecht nach toten Menschen, Zwergen, Elfen und Hobbits.\n"));
  AddSmell ("geruch", bs("Dieser arme Elf war wohl leider nicht schnell "+
    "genug um den Woelfen zu entkommen.\n"));

  AddItem (MON("anfuehrerwolf"), REFRESH_DESTRUCT);
  AddItem (MON("silberwolf2"), REFRESH_DESTRUCT);
  AddItem (MON("silberwolf2"), REFRESH_DESTRUCT);
  AddItem (MON("silberwolf2"), REFRESH_DESTRUCT);

  AddExit("nordwesten", ROOM("berg_o20"));

  set_next_reset(-1); // wird ab jetzt vom Raum davor resettet, Zordan

}

reset()
  {
    //  tell_object(find_player("zordan"),sprintf("PO: %O\n",previous_object()));
    if(file_name(previous_object()) != ROOM("berg_o20")) return;
    ::reset();
    halsband = 1;
    set_next_reset(-1); // wird ab jetzt vom Raum davor resettet, Zordan
  }

create_halsband()
  {
    object a;
    a = clone_object(ARMOUR("halsband"));
    return a;
  }

nische()
  {
    if (present("silberwolf"))
    return "Der Wolf laesst Dich nicht an die Nische heran.\n";

    if (!halsband)
    return "Die Nische ist leider leer, da war wohl jemand schneller.\n";
    write("In der Nische liegt ein wunderschoenes Halsband.\n");
    halsband_nehmen();
    return "";
  }

halsband_nehmen()
  {
    object a;
    int ret;
    a = create_halsband();
    ret = a->move(this_player());
    if (ret==ME_TOO_HEAVY)
    {
      write("Du versuchst das Halsband zu nehmen, aber es ist Dir zu "+
      "schwer.\n");
      a->remove();
      return "";
    }
    write("Du nimmst das Halsband aus der Nische.\n");
    say(capitalize(this_player()->name())+" nimmt ein Halsband aus "+
      "der Nische.\n");
    halsband = 0;
    return "";
  }

