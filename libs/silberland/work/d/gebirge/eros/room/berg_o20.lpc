** Eros 1996-05-07
*/


inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "../berg.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Schlucht");
  SetProp( P_INT_LONG, bs( "Du stehst mitten in der tiefen Schlucht. "+
    "Die Waende gehen erschreckend steil nach oben, unmoeglich sie zu "+
    "erklettern. Einige Steine liegen am Boden, ob es hier Steinschlag "+
    "gibt? Die Schatten werden immer duesterer. Hoffentlich kannst Du "+
    "angreifende Feinde rechtzeitig erkennen. Ein kleiner Spalt "+
    "oeffnet sich nach Nordosten, und Du erkennst einen Eingang "+
    "zu einer Hoehle.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_MOUNTAIN]));

  AddDetail( ({ "pfad", "boden"}),
    "Du folgst einem duesteren Pfad, der auf festen Boden angelegt ist.\n");
  AddDetail(({"spalte", "spalt"}),
    bs("Durch den kleinen Spalt kannst Du zwischen den steilen Waenden "+
    "hindurchgehen.\n"));
  AddDetail(({"eingang", "eingaenge"}),
    bs("Er sieht duester und gefaehrlich aus. Sicher verbergen sich "+
    "darin nur weitere Woelfe.\n"));
  AddDetail(({"hoehle", "hoehlen"}),
    bs("Du kannst von hier nur erkennen, dass sie finster und "+
    "gefaehrlich aussieht.\n"));
  AddDetail( ({ "waende", "wand" }),
    bs("Die Waende erstrecken sich weit nach oben. Diffuse Schatten "+
    "spielen an ihnen entlang. Ob es hier Steinschlag gibt?\n"));
  AddDetail("schlucht",
    bs("Ja, Du stehst in einer Schlucht. Jetzt kannst Du Dich "+
    "entscheiden, ob Du weiter gehst, oder doch lieber umkehrst.\n"));
  AddDetail( ({ "schatten", "wesen", "lebewesen" }),
    bs("Die Schatten sehen aus als wuerden sie leben. Doch genaueres "+
    "kann man von hier aus nicht feststellen.\n"));
  AddDetail( ({ "stein", "steinschlag", "schlag", "steine" }),
    bs("Huch, da poltert gerade wieder ein Stein auf Dich herunter. "+
    "Mit viel Geschicklichkeit bist Du dem Tod doch noch entgangen.\n"));
  AddDetail("himmel",
    bs("Der Himmel befindet sich graublau ueber Dir.\n"));
  AddDetail("gefuehl",
    bs("Irgendwie scheint Dich Dein Gefuehl vor irgend etwas warnen "+
    "zu wollen, aber nur vor was?\n"));

  AddDetail( ({ "berg", "berge" }),
    bs("Der Berg lauert geheimnisvoll auf Deine "+   
    "Ankunft. Du ueberlegst, ob er Dich verschlingen will oder "+
    "Dir unglaubliche Reichtuemer bescheren wird.\n"));

  AddItem (MON("silberwolf2"), REFRESH_DESTRUCT);
  AddItem (MON("silberwolf2"), REFRESH_DESTRUCT);
  AddItem (MON("silberwolf2"), REFRESH_DESTRUCT);

  AddGuardedExit("suedosten", (ROOM("berg_p21")), 
    "silberwolf", "Der Silberwolf versperrt Dir den Weg.\n");
  AddExit("nordosten", ROOM("berg_p19"));

}

reset() {
  call_other( ROOM ("berg_p21") , "reset");
  ::reset();
}

