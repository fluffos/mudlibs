#include <properties.h>
inherit "/std/container";
#include "../berg.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Lederbeutel");
  SetProp(P_LONG, bs("Ein Beutel aus feinem Leder. Er bietet einigen "+
    "Platz fuer alle moeglichen Sachen, die Du so mit Dir rumschleppst.\n"));
  AddId(({"beutel", "lederbeutel"}));
  SetProp(P_NAME, "Lederbeutel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 250);
  SetProp(P_MAX_WEIGHT, 12000);
  SetProp(P_VALUE, 400);
  SetProp(P_INFO, bs("Dieser Lederbeutel ermoeglicht es Dir, mehr Sachen "+
    "mit Dir herum zu tragen.\n"));
  SetProp(P_MATERIAL, MAT_LEATHER);
  AddDetail("leder", bs("Feines Leder das sich weich und angenehm "+
    "anfuehlt.\n"));

}
