#include "../def.h"

inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>

void create()
{
    if (!is_clone(TO))
        return;
    ::create();

    SetProp(P_NAME, "Ser Aldren");
    SetProp(P_SHORT, "Ser Aldren, Veteran der Rosenwacht");
    SetProp(P_LONG,
        "Ser Aldren hat zahllose Feldzuege fuer die Goldene Rose ueberstanden. Sein Blick "
        "ist wachsam, und die lange Narbe ueber dem linken Auge verraet, dass er schon "
        "manche Belagerung ueberlebt hat. Sein Schild traegt frische Kerbungen, als haette "
        "er ihn erst gestern gebrauchen muessen.");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Mensch");
    AddId(({ "ser", "aldren", "paladin", "veteran", "rosenwacht", "paladinveteran" }));

    create_default_npc(38);
    SetProp(P_ALIGN, 1500);
    SetProp(P_SIZE, 190);
    SetProp(P_HEAL, 4);
    SetProp(P_WIMPY, 0);
    SetProp(P_KILL_NAME, "Ser Aldren");
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_HOLY:  -0.35,
        DT_FIRE:  -0.10,
        DT_COLD:   -0.05,
        DT_POISON:-0.25,
        DT_UNHOLY: 0.20,
    ]));
    SetProp(P_MSGIN, "tritt mit festen Schritten heran");
    SetProp(P_MSGOUT, "setzt seinen Patrouillenweg fort");
    SetProp(P_MMSGIN, "tritt aus einem hellen Licht");
    SetProp(P_MMSGOUT, "verblasst in einem Lichtblitz");

    SetChats(4, ({
        "Ser Aldren murmelt ein kurzes Gebet und beruehrt das Rosenabzeichen an seiner Brust.\n",
        "Ser Aldren legt die Hand an den Schildrand und sichert den Pfad mit geuebtem Blick.\n",
        "Mit ruhiger Stimme sagt Ser Aldren: \"Nur wer ehrenhaft ist, darf zur Festung weiter.\".\n",
    }));
    SetAttackChats(4, ({
        "Ser Aldren ruft: \"Bei Dustys Licht wirst du keine Unschuld verletzen!\".\n",
        "Ser Aldren schlaegt mit einer blitzenden Klinge zu.\n",
        "Der Veteran hebt den Buckler und rennt dich fast um.\n",
    }));

    AddSpell(2, 320,
        "Ser Aldren ruft ein blendendes Licht herunter, das dich versengt!\n",
        "Ser Aldren ruft ein blendendes Licht herunter, das @WEN versengt!\n",
        DT_HOLY,
        ([ SP_SHOW_DAMAGE: 1 ]));
    AddSpell(1, 280,
        "Der Veteran stoesst seinen Schild in deinen Bauch und schneidet mit der Klinge nach.\n",
        "Ser Aldren stoesst @WEM den Schild in den Bauch und schneidet mit der Klinge nach.\n",
        DT_SLASH,
        ([ SP_SHOW_DAMAGE: 1 ]));
    AddSpell(2, 340,
        "Ser Aldren zeichnet eine Flamme in die Luft, die mit heiligem Feuer nach dir schlaegt!\n",
        "Ser Aldren zeichnet eine Flamme in die Luft, die @WEN mit heiligem Feuer trifft!\n",
        DT_FIRE,
        ([ SP_SHOW_DAMAGE: 1 ]));
    AddSpell(1, 300,
        "Der Veteran ruft Dustys Urteil an, und eine Druckwelle schleudert dich zurueck!\n",
        "Ser Aldren ruft Dustys Urteil an, und eine Druckwelle schleudert @WEN zurueck!\n",
        DT_BLUDGEON,
        ([ SP_SHOW_DAMAGE: 1 ]));

    AddInfo(({"dusty", "ehre"}),
        "Dusty verlangt von uns, dass wir die Berge sicher halten. Jeder, der mit guten Absichten kommt, darf passieren.",
        "erklaert: ");
    AddInfo(({"versorgung", "karren"}),
        "Ich begleite oft die Versorgungskarren. Wer sie angreift, lernt meine Klinge kennen.",
        "brummt: ");

    SUID;
    CLONEME(WEAPON "rosenwacht_klinge");
    CLONEME(ARMOUR "rosenwacht_schild");
    CLONEME("/p/armour/armour/plattenpanzer");
    CLONEME("/p/armour/boots/eisenschuhe");
    CLONEME("/p/armour/helm/tellerhelm");
    command("trage alles");
    command("zuecke glanzklinge");

    SetProp(P_MNPC_AREA, ({ ROOM "ostweg", ROOM "festung_osttor" }));
    SetProp(P_MNPC_WAIT, ({ 6, 10, 5 }));
    SetProp(P_MNPC_DEFAULTROOM, ROOM "ostweg_3");
    SetProp(P_MNPC_FLAGS,
        MOV_BACKWARDS | MOV_OUTDOORS | MOV_MOVES);
}
