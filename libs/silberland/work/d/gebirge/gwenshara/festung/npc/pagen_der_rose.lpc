#include "../def.h"

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

void create()
{
    int lvl;

    if (!is_clone(TO))
        return;
    ::create();

    AddId(({ "page", "pagen", "page_der_rose", "paladinpage" }));
    SetProp(P_NAME, "Page der Rose");
    SetProp(P_GENDER, ({ MALE, FEMALE })[random(2)]);
    SetProp(P_SHORT, "Ein Page der Goldenen Rose");
    SetProp(P_LONG,
        "Dieser junge Page traegt ein eingearbeitetes Wappen der Goldenen Rose. "
        "Er bewegt sich rasch zwischen Hof, Mauern und Bruecken, stets bereit "
        "Botschaften zu bringen oder den Weg frei zu halten.");
    SetProp(P_RACE, "Mensch");
    SetProp(P_ALIGN, 500 + random(200));
    SetProp(P_SIZE, 165 + random(10));
    SetProp(P_MAX_HANDS, 2);

    lvl = 10 + random(11); // 10..20
    create_default_npc(lvl);

    SetProp(P_HANDS, ({
        " mit seiner Trainingsklinge",
        40,
        DT_SLASH,
    }));
    SetProp(P_RESISTANCE_STRENGTHS,
        ([ DT_HOLY: -0.10, DT_UNHOLY: 0.10 ]));
    SetProp(P_HEAL, 1);
    SetProp(P_AGGRESSIVE, 0);
    SetProp(P_WIMPY, 0);
    SetProp(P_MSGIN, "eilt heran");
    SetProp(P_MSGOUT, "lauert weiter");
    SetProp(P_DIE_MSG,
        " sinkt keuchend zu Boden und versucht, das Wappen zu schuetzen.\n");
    SetProp(P_KILL_NAME, "Page der Rose");
    SetProp(P_DEFAULT_INFO,
        "verbeugt sich hastig und wartet auf Anweisungen.\n");
    SetProp(P_LOG_INFO, "npc_pagen_rose");

    SetProp(P_SPELLRATE, 8);
    AddSpell(2, 80,
        "Der Page holt tief Luft und fuehrt einen geuebten Schnitt aus.\n",
        "Der Page fuehrt einen geuebten Schnitt gegen @WEN aus.\n",
        DT_SLASH,
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1, 120,
        "Ein schwaches Licht umhuellt den Page und haertet seinen Schlag.\n",
        "Ein schwaches Licht umhuellt den Page, waehrend er @WEN trifft.\n",
        DT_HOLY,
        ([SP_SHOW_DAMAGE: 1]));

    SetChats(3, ({
        "Der Page murmelt eine Botschaft und bricht in leichten Lauf aus.\n",
        "Schnelle Schritte hallen, als der Page die Strecke abmisst.\n",
        "Der Page legt eine Hand aufs Wappen und rezitiert eine kurze Losung.\n",
    }));
    SetAttackChats(4, ({
        "Der Page ruft: \"Fuer die Rose!\".\n",
        "Der Page versucht, Dich mit schnellen Fuellen zu verwirren.\n",
        "Der Page duckt sich und schlaegt nach Deinen Beinen.\n",
    }));

    AddInfo(({"auftrag", "botschaft"}),
        "Ich bringe Befehle zwischen Hoefen, Mauern und Bruecke. "
        "Selbst Traege muessen rennen lernen.",
        "erklaert der Page: ");
    AddInfo(({"training", "uebung"}),
        "Pages lernen zuerst Aufmerksamkeit, dann Schwertarbeit. "
        "Niemand passiert, ohne gesehen zu werden.",
        "meint der Page: ");

    SetProp(P_REJECT, ({ REJECT_DROP,
        "Der Page schuettelt eilig den Kopf: \"Ich trage nur Ordensgut.\".\n" }));

    SUID;
    CLONEME("/p/weapon/sword/holzschwert");
    command("zuecke holzschwert");
    CLONEME("/p/armour/armour/lederpanzer");
    CLONEME("/p/armour/boots/lederstiefel");
    CLONEME("/p/armour/belt/guertel");
    command("trage alles");

    SetProp(P_MNPC_AREA, ({ ROOM }));
    SetProp(P_MNPC_WAIT, ({ 6, 16, 10 }));
    SetProp(P_MNPC_DEFAULTROOM, ROOM "festung_5");
    SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_OUTDOORS | MOV_INDOORS |
        MOV_BACKWARDS | MOV_MAYLOAD);
}
