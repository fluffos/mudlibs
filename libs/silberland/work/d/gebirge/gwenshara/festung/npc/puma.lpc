inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "ein Bergpuma");
  SetProp(P_LONG,
    "Ein schlanker, muskuloeser Bergpuma mit sandfarbenem Fell und gelblichen Augen. "
    "Er bewegt sich lautlos, die Krallen halb ausgefahren, und sein Schweif peitscht "
    "unruhig durch die kalte Luft.");
  SetProp(P_NAME, "Bergpuma");
  SetProp(P_GENDER, NEUTER);
  AddId(({"puma","bergpuma","raubkatze","katze"}));

  create_default_npc(20);

  SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1], DT_SLASH}));

  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 55);     // mittelgross, schlank
  SetProp(P_WEIGHT, 65000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 2);
  SetProp(P_AGGRESSIVE, 0);     // greift nicht sofort an
  SetProp(P_WIMPY, 15);         // zieht sich verletzt zurueck
  SetProp(P_NOMAGIC, 0);

  // leichte Naturresistenzen
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_COLD:0.05, DT_AIR:0.05, DT_SOUND:0.05]));

  SetProp(P_MSGIN, "schleicht heran");
  SetProp(P_MSGOUT, "schleicht davon");
  SetProp(P_MMSGIN, "taucht lautlos aus dem Nebel auf");
  SetProp(P_MMSGOUT, "gleitet geraeuschlos in den Nebel");

  SetProp(P_DIE_MSG,  " bricht reglos zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ein heiseres Fauchen verhallt im Wind.");
  SetProp(P_KILL_NAME, "Bergpuma");
  SetProp(P_KILL_MSG, "Der Puma stoesst ein kehliges Knurren aus.");

  AddInfo(DEFAULT_INFO, "legt die Ohren an und mustert Dich aus gelben Augen.\n");

  // Zusatzinfos (look keywords)
  AddInfo(({"fell","pelz"}), 
    "Das Fell ist dicht und kurz; es tarnt ihn perfekt im grauen Gestein.",
    "schnauft: ");

  SetProp(P_REJECT, ({ REJECT_DROP,
    "Der Puma ignoriert Dein Angebot und faucht nur leise.\n" }) );

  // Keine Zauber
  SetProp(P_SPELLRATE,0);

  // Natuerliche “Spezialattacken” ueber Chat/Combat-Flavor
  SetChats(4, ({
    "Der Bergpuma schnuppert in den Wind.\n",
    "Der Schweif des Bergpumas peitscht unruhig.\n",
    "Der Bergpuma blinzelt und schiebt sich lautlos einen Schritt zur Seite.\n"
  }) );

  SetAttackChats(10, ({
    "Der Bergpuma faucht und schlaegt blitzschnell nach Dir.\n",
    "Krallen schneiden durch die Luft.\n",
    "Ein tiefer Knurrlaut vibriert in der Brust des Bergpumas.\n"
  }) );
}

// Reaktionen (kurz & tierisch)
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "faucht unsicher und weicht einen Schritt zurueck.",
        "faucht unsicher und macht einen Satz zur Seite.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "legt die Ohren an und zeigt die Zaehne.",
        "knurrt tief und scharrt mit den Krallen.");
      break;
    case "nett":
    case "neutral":
      call_out("reaction", 0, TP,
        "schnuppert kurz an Dir.",
        "schnuppert in die Luft und blinzelt.");
      break;
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "stoesst ein drohendes Fauchen aus.",
        "faucht und schlaegt mit der Pfote in die Luft.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laesst den Schweif locker kreisen.",
        "schnaubt leise und wirkt entspannt.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "blickt kurz zum Boden und seufzt kaum hoerbar.",
        "senkt den Kopf und wird still.");
      break;
    case "albern":
    case "intim":
      call_out("reaction", 0, TP,
        "stupst Dich vorsichtig mit der Nase an.",
        "rollt sich halb ab und beobachtet Dich aus schmalen Augen.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
