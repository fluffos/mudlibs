#include "../def.h"

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
    if (!is_clone(TO))
        return;
    ::create();

    SetProp(P_NAME, "Grukmar");
    SetProp(P_SHORT, "Grukmar, ein Hoehlentroll der Schlucht");
    SetProp(P_LONG,
        "Grukmar ist ein breitschultriger Hoehlentroll. Seine Haut wirkt wie rauer "
        "Fels, und seine Augen flackern im Feuer der Hoehle. Er bewacht grollend "
        "seinen Kochtopf und alles, was in seine Hoelle stolpert.");
    SetProp(P_GENDER, MALE);
    AddId(({ "grukmar", "hohlentroll", "troll", "\ndreckstroll" }));

    create_default_npc(30);

    SetProp(P_RACE, "Troll");
    SetProp(P_ALIGN, -200);
    SetProp(P_SIZE, 250);
    SetProp(P_WEIGHT, 220000);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_HEAL, 4);
    SetProp(P_MSGIN, "stampft herein");
    SetProp(P_MSGOUT, "poltert davon");
    SetProp(P_AGGRESSIVE, 1);

    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_SLASH: -0.15,
        DT_BLUDGEON: -0.05,
        DT_PIERCE: -0.05,
        DT_COLD: -0.30,
        DT_FIRE:  0.30,
        DT_POISON: -0.20,
        DT_HOLY:  0.20,
        DT_TERROR: -0.10,
    ]));

    SetProp(P_SPELLRATE, 15);
    AddSpell(2, 260,
        "Grukmar holt mit beiden Haenden aus und schmettert seine Faust wie einen "
        "Vorschlaghammer auf dich nieder.\n",
        "Grukmar schmettert seine Faust wie einen Vorschlaghammer auf @WEN nieder.\n",
        DT_BLUDGEON,
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1, 320,
        "Der Troll reißt einen glimmenden Knochen aus dem Feuer und schleudert ihn "
        "auf dich.\n",
        "Grukmar schleudert einen glimmenden Knochen aus dem Feuer auf @WEN.\n",
        DT_FIRE,
        ([SP_SHOW_DAMAGE: 1]));

    SetChats(3, ({
        "Grukmar schnauft schwer und ruert mit einem gewaltigen Löffel im Topf.\n",
        "Ein dumpfes Knurren rollt durch die Hoehle, als Grukmar den Boden scharrt.\n",
        "Der Troll zieht eine Knochenkette fest und grinst boese.\n",
    }));
    SetAttackChats(4, ({
        "Grukmar bruellt: \"Mein Topf! Mein Fleisch!\".\n",
        "Der Troll schnauft und wirft sich mit seiner ganzen Masse nach vorn.\n",
        "Grukmar lacht rau und schwingt seine Felsfaeuste.\n",
    }));

    AddInfo(({"topf", "kochtopf"}),
        "Topf kocht! Kein fremder Finger drin! Grukmar passt auf!",
        "brummt: ");
    AddInfo(({"knochen", "schaetze"}),
        "Ich sammle Knochen, ja. Meine! Lass sie liegen!",
        "knurrt der Troll: ");

    SetProp(P_REJECT, ({ REJECT_DROP,
        "Grukmar fletscht die Zaehne und schuettelt den Kopf.\n" }));
    SetProp(P_KILL_MSG, "Grukmar brüllt: \"Niemand klaut meinen Eintopf!\".");

    SUID;
    CLONEME("/p/armour/armour/lederpanzer");
    CLONEME("/p/armour/belt/guertel");
    CLONEME("/p/armour/boots/lederstiefel");
    command("trage alles");
}
