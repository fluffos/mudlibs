#include "../def.h"

inherit NPC "paladin_wache";

protected void configure_guard()
{
    guard_name = "Dame Selis";
    guard_gender = FEMALE;
    guard_level = 24;
    guard_glevel = 12;
    guard_short_suffix = ", Paladinin der Bannerlinie";
    guard_long =
        "Dame Selis traegt das Banner der Goldenen Rose bei jedem "
        "Rundgang. Ihr Schritt ist fest, und niemand stellt das Wort der "
        "Komturin in Frage, wenn sie spricht.";
    guard_align = 1220;
}
