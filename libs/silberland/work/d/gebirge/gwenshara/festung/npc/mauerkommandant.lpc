#include "../def.h"

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

void init()
{
    ::init();
    if (this_player() &&
        (this_player()->id("mauerwaechter") ||
         this_player()->id("paladinwache")))
    {
        AddDefender(this_player());
    }
}

void create()
{
    if (!is_clone(TO))
        return;
    ::create();

    AddId(({
        "kommandant",
        "mauerkommandant",
        "elfenkommandant",
        "paladinwache",
        "kommandant_elandor",
        "elandor",
        "Schwertexperte"
    }));
    SetProp(P_NAME, "Kommandant Elandor");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Elf");
    SetProp(P_SHORT, "Kommandant Elandor, die Klinge der Mauerwache");
    SetProp(P_LONG,
        "Der hochgewachsene Elf traegt ein helles Mantelgewand unter "
        "der Kettenruestung. Sein Blick springt ueber jede Zinne, waehrend "
        "Schwert und Schild stets griffbereit bleiben.");
    SetProp(P_ALIGN, 1250 + random(100));
    SetProp(P_SIZE, 185);
    SetProp(P_MAX_HANDS, 2);
    create_default_npc(30);
    SetProp(P_HANDS, ({
        " mit seinem Ordensschwert",
        QueryProp(P_HANDS)[1],
        DT_SLASH,
    }));
    SetProp(P_RESISTANCE_STRENGTHS,
        ([ DT_HOLY: -0.30, DT_UNHOLY: 0.30, DT_TERROR: -0.20 ]));
    SetProp(P_HEAL, 3);
    SetProp(P_AGGRESSIVE, 0);
    SetProp(P_WIMPY, 0);
    SetProp(P_MSGIN, "betritt den Wachweg mit ruhigen Schritten");
    SetProp(P_MSGOUT, "setzt seine Patrouille fort");
    SetProp(P_MMSGIN, "taucht mit flatterndem Mantel zwischen den Zinnen auf");
    SetProp(P_MMSGOUT, "verschwindet hinter den Zinnen");
    SetProp(P_DIE_MSG,
        " sinkt auf ein Knie, stuetzt sich auf das Schwert und flackert "
        "im Licht aus.\n");
    SetProp(P_KILL_NAME, "Kommandant Elandor");
    SetProp(P_KILL_MSG, "Die Mauerwache vergisst nichts.");
    SetProp(P_DEFAULT_INFO,
        "blickt ueber den Wachweg und prueft jede Bewegung.\n");
    SetProp(P_LOG_INFO, "npc_mauerkommandant");

    SetProp(P_SPELLRATE, 18);
    AddSpell(2, 200,
        "Kommandant Elandor wirbelt sein Ordensschwert in einem "
        "messerscharfen Bogen.\n",
        "Kommandant Elandor wirbelt sein Ordensschwert gegen @WEN.\n",
        DT_SLASH,
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(2, 260,
        "Ein goldener Schildglanz schlaegt von Elandors Waffe in deine "
        "Brust.\n",
        "Ein goldener Schildglanz schlaegt von Elandors Waffe in @WEN "
        "hinein.\n",
        DT_HOLY,
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1, 320,
        "Elandor rammt dir den Schild in den Bauch und nutzt die Luecke "
        "fuer einen praezisen Stich.\n",
        "Elandor rammt @WEM den Schild in den Bauch und fuegt einen "
        "praezisen Stich hinzu.\n",
        ( DT_BLUDGEON, DT_PIERCE ),
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1, 240,
        "Elandor zeichnet ein glimmendes Sigill in die Luft und schleudert "
        "eine Lanze aus Licht durch deinen Brustkorb.\n",
        "Elandor zeichnet ein glimmendes Sigill und schleudert eine "
        "Lichtlanze durch @WEN.\n",
        DT_LIGHT,
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1, 210,
        "Ein stiller Segen laesst Elandors Ordenssymbol aufleuchten und "
        "heilige Funken brennen ueber deine Haut.\n",
        "Ein stiller Segen laesst Elandors Ordenssymbol aufleuchten und "
        "heilige Funken tanzen ueber @WEN.\n",
        DT_HOLY,
        ([SP_SHOW_DAMAGE: 1]));

    SetChats(3, ({
        "Kommandant Elandor fluestert ein altes Elfengebet.\n",
        "Elandor gleitet mit der Hand ueber den Schildrand und prueft die "
        "Kerben.\n",
        "Der Kommandant zeichnet mit der Fingerspitze eine Rune auf den "
        "Brustpanzer.\n",
    }));
    SetAttackChats(5, ({
        "Elandor ruft: \"Im Namen der Rose und des Waldes!\".\n",
        "Das Schwert des Kommandanten sirrt dicht an deinem Hals vorbei.\n",
        "Ein kalter Windstoss begleitet Elandors naechsten Streich.\n",
        "Der Schild des Kommandanten prallt hart gegen deinen Angriff.\n",
    }));

    AddInfo(({"mauerwache", "wachweg"}), 
        "Ich fuehre die Patrouillen. Kein Schritt bleibt ohne Bericht.",
        "erklaert Elandor: ");
    AddInfo(({"elfen", "orden", "goldene_rose"}),
        "Die Goldene Rose vertraute mir den Befehl, weil Wald und Festung "
        "verbunden sind.",
        "sagt Elandor: ");

    SetProp(P_REJECT, ({ REJECT_DROP,
        "Elandor hebt den Schild: \"Deine Last bleibt die deine.\".\n" }));

    SUID;
    CLONEME("/p/weapon/sword/langschwert");
    command("zuecke langschwert");
    CLONEME("/p/armour/shield/eisenschild");
    command("trage schild");
    CLONEME("/p/armour/armour/kettenpanzer");
    CLONEME("/p/armour/helm/kettenhaube");
    CLONEME("/p/armour/bracers/messingarmschienen");
    CLONEME("/p/armour/boots/lederstiefel");
    command("trage alles");

    SetProp(P_MNPC_AREA, ({
        ROOM "wachweg_x",
        ROOM "festung_suedturm",
        ROOM "festung_nordturm",
    }));
    SetProp(P_MNPC_WAIT, ({ 6, 18, 10 }));
    SetProp(P_MNPC_DEFAULTROOM, ROOM "wachweg_x3y0");
    SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES |
        MOV_BACKWARDS | MOV_MAYLOAD | MOV_INFIGHT);
}
