#include "../def.h"

inherit NPC "paladin_wache";

protected void configure_guard()
{
    guard_name = "Ser Galen";
    guard_gender = MALE;
    guard_level = 23;
    guard_glevel = 12;
    guard_short_suffix = ", Paladin der Nordzinnen";
    guard_long =
        "Ser Galen ueberblickt vom Nordturm aus das ganze Gebirge. Sein Blick "
        "ist hart wie der Stahl seines Schwertes, und jedes Stoergeraeusch wird "
        "sofort verfolgt.";
    guard_align = 1175;
}
