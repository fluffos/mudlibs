#include "../def.h"

inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
    if (!is_clone(TO))
        return;
    ::create();

    SetProp(P_NAME, "Bromgar Eisenwall");
    SetProp(P_SHORT, "Bromgar Eisenwall, Brueckenwaechter der Rose");
    SetProp(P_LONG,
        "Der Zwergenpaladin Bromgar steht mitten auf der Bruecke und laesst "
        "keinen Blick zur Seite wandern. Sein Bihander ruht auf den Schultern, "
        "während die Kettenringe im Wind klirren.");
    SetProp(P_GENDER, MALE);
    AddId(({ "bromgar", "eisenwall", "brueckenwaechter", "paladin", "zwerg" }));

    create_default_npc(25);

    SetProp(P_RACE, "Zwerg");
    SetProp(P_ALIGN, 1050);
    SetProp(P_SIZE, 135);
    SetProp(P_WEIGHT, 90000);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_HEAL, 3);
    SetProp(P_MSGIN, "stampft ueber die Bruecke");
    SetProp(P_MSGOUT, "zieht sich zur Bruecke zurueck");

    SetProp(P_RESISTANCE_STRENGTHS,
        ([ DT_TERROR: -0.20, DT_HOLY: -0.25, DT_UNHOLY: 0.20 ]));

    SetProp(P_SPELLRATE, 10);
    AddSpell(1, 220,
        "Bromgar hebt den Bihander ueber den Kopf und schlaegt ihn mit einem "
        "knackenden Aufprall herunter.\n",
        "Bromgar hebt den Bihander ueber den Kopf und schlaegt ihn auf @WEN "
        "herab.\n",
        DT_SLASH,
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1, 260,
        "Der Zwerg knurrt ein Gebet und seine Waffe blitzt in heiligem Licht.\n",
        "Der Zwerg knurrt ein Gebet und Bromgars Bihander blitzt gegen @WEN.\n",
        DT_HOLY,
        ([SP_SHOW_DAMAGE: 1]));

    SetChats(4, ({
        "Bromgar prueft jeden Bolzen am Brueckengeländer.\n",
        "Der Zwerg stampft den Fuss auf die Planken und lauscht dem Echo.\n",
        "Bromgar knurrt: \"Niemand stuerzt hier ein... solange ich stehe.\".\n",
    }));
    SetAttackChats(4, ({
        "Bromgar bellt: \"Zurueck! Diese Bruecke gehoert der Rose.\".\n",
        "Der Bihander des Zwerges saust in einer breiten Bahn nach vorn.\n",
        "Funken spruehen, als Bromgar den Schlag mit purem Stahl blockt.\n",
    }));

    AddInfo(({"bruecke", "brueckenweg"}),
        "Diese Bruecke fuehrt direkt in den Hof. Bromgar duldet hier keine "
        "Unruhe.",
        "knurrt: ");
    AddInfo(({"bihander", "waffe"}),
        "Mein Bihander haelt seit drei Belagerungen. Er haelt auch Dich auf.",
        "sagt Bromgar: ");

    SetProp(P_REJECT, ({ REJECT_DROP,
        "Bromgar schuettelt den Kopf: \"Ich trage meinen eigenen Stahl.\".\n" }));
    SetProp(P_KILL_MSG, "Bromgar brummt: \"Die Bruecke bleibt heil.\"");

    SUID;
    CLONEME(WEAPON "bihander");
    command("zuecke bihander");
    CLONEME("/p/armour/armour/kettenpanzer");
    CLONEME("/p/armour/boots/lederstiefel");
    CLONEME("/p/armour/belt/guertel");
    CLONEME("/p/armour/gloves/panzerhandschuhe");
    command("trage alles");
}
