#include "../def.h"

inherit "std/npc";

void create()
{
    if (!is_clone(TO))
        return;
    ::create();

    SetProp(P_NAME, "Pilger");
    SetProp(P_SHORT, "ein in Gedanken versunkener Pilger");
    SetProp(P_LONG,
        "Der Pilger traegt einen wettergegerbten Mantel, unter dem ein einfaches Wappen "
        "der Dustys zu sehen ist. Ein geschnitzter Stab stuetzt seine Schritte, "
        "waehrend er still Gebete murmelt und immer wieder ehrfurchtsvoll zum Schrein hinueberblickt.");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Mensch");
    AddId(({ "pilger", "wanderer", "dustypilger" }));

    create_default_npc(12);
    SetProp(P_ALIGN, 1000);
    SetProp(P_SIZE, 180);
    SetProp(P_WEIGHT, 80000);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_HANDS, ({ " mit seinem Pilgerstab", 60, DT_BLUDGEON }));
    SetProp(P_WIMPY, 0);

    SetProp(P_MSGIN, "kommt betend");
    SetProp(P_MSGOUT, "pilgert weiter");
    SetProp(P_MMSGIN, "erscheint leise murmelnd");
    SetProp(P_MMSGOUT, "verblasst in einem stillen Gebet");

    SetChats(3, ({
        "Der Pilger raunt: \"Dusty fuehre uns sicher ueber diesen Pfad.\".\n",
        "Der Pilger bleibt kurz stehen, um auf den Schrein zu blicken.\n",
        "Der Pilger klopft seinen Stab zweimal gegen den Boden und setzt den Weg fort.\n",
    }));
    SetAttackChats(1, ({
        "Der Pilger ruft: \"Frieden, Bruder!\" und versucht Dich zu besaenftigen.\n",
    }));

    AddInfo(({"schrein", "dusty"}), 
        "Der Schrein ist mein Ziel auf dieser Reise. Dort bitte ich um Staerke fuer alle, die den Weg bewachen.",
        "sagt: ");
    AddInfo("pfad",
        "Der Pfad ist hart, aber jeder Schritt erinnert uns an unsere Geluebde.",
        "murmelt: ");
}
