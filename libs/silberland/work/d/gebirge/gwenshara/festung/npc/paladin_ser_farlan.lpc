#include "../def.h"

inherit NPC "paladin_wache";

protected void configure_guard()
{
    guard_name = "Ser Farlan";
    guard_gender = MALE;
    guard_level = 21;
    guard_glevel = 11;
    guard_short_suffix = ", Paladin der Wachwege";
    guard_long =
        "Ser Farlan patrouilliert unermuedlich die Wachwege. Er traegt "
        "tiefe Kerben auf dem Schildrand als Erinnerung an jeden ueberstandenen "
        "Angriff.";
    guard_align = 1150;
}
