#include "../def.h"

inherit NPC "paladin_wache";

protected void configure_guard()
{
    guard_name = "Dame Lorin";
    guard_gender = FEMALE;
    guard_level = 20;
    guard_glevel = 10;
    guard_short_suffix = ", Paladinin der Heilenden Linie";
    guard_long =
        "Dame Lorin traegt frische Segensrunen auf dem Wappenrock. Sie "
        "verbindet Verletzte ebenso schnell, wie sie Klingen stoppt.";
    guard_align = 1180;
}
