#include "../def.h"

inherit NPC "paladin_wache";

protected void configure_guard()
{
    guard_name = "Ser Calem";
    guard_gender = MALE;
    guard_level = 19;
    guard_glevel = 10;
    guard_short_suffix = ", Paladin der Schildlinie";
    guard_long =
        "Ser Calem haelt die Schildlinie entlang der Mauern. Seine Bewegungen "
        "sind ruhig, doch jede Muskelfaser steht bereit, die goldene Rose zu "
        "verteidigen.";
    guard_align = 1120;
}
