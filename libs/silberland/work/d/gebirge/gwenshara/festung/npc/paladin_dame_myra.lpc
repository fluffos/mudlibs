#include "../def.h"

inherit NPC "paladin_wache";

protected void configure_guard()
{
    guard_name = "Dame Myra";
    guard_gender = FEMALE;
    guard_level = 22;
    guard_glevel = 11;
    guard_short_suffix = ", Paladinin der Lautlosen Wache";
    guard_long =
        "Dame Myra bewegt sich leise ueber den Wachweg und lauscht jedem "
        "Windhauch. Ihr Schild ist mit feinen Segenszeichen geschmueckt, die "
        "im Mondlicht glimmen.";
    guard_align = 1200;
}
