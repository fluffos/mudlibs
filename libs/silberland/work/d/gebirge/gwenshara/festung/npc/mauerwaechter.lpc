#include "../def.h"

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

void init()
{
    ::init();
    if (this_player() &&
        (this_player()->id("mauerwaechter") ||
         this_player()->id("paladinwache")))
    {
        AddDefender(this_player());
    }
}

void create()
{
    if (!is_clone(TO))
        return;
    ::create();

    AddId(({"mauerwaechter", "waechter", "paladinwache", "wachposten"}));
    SetProp(P_NAME, "Mauerwaechter");
    SetProp(P_GENDER, ({MALE, FEMALE})[random(2)]);
    SetProp(P_SHORT, "Ein Mauerwaechter der Goldenen Rose");
    SetProp(P_LONG,
        "Der Mauerwaechter traegt die hellen Farben des Ordens und haelt "
        "den Wachweg frei. Jeder Atemzug bleibt kontrolliert, waehrend der "
        "Blick entlang der Brustwehr tastet.");
    SetProp(P_RACE, "Mensch");
    SetProp(P_ALIGN, 700 + random(300));
    SetProp(P_SIZE, 175 + random(10));
    SetProp(P_MAX_HANDS, 2);
    create_default_npc(24);
    SetProp(P_HANDS, ({
        " mit gepanzerter Faust",
        QueryProp(P_HANDS)[1],
        DT_BLUDGEON,
    }));
    SetProp(P_RESISTANCE_STRENGTHS,
        ([ DT_HOLY: -0.25, DT_UNHOLY: 0.25, DT_TERROR: -0.15 ]));
    SetProp(P_HEAL, 2);
    SetProp(P_AGGRESSIVE, 0);
    SetProp(P_WIMPY, 0);
    SetProp(P_MSGIN, "tritt auf den Wachweg");
    SetProp(P_MSGOUT, "setzt seine Patrouille fort");
    SetProp(P_MMSGIN, "taucht zwischen den Zinnen auf");
    SetProp(P_MMSGOUT, "verschwindet zwischen den Zinnen");
    SetProp(P_DIE_MSG,
        " stuerzt gegen die Brustwehr und bleibt reglos liegen.\n");
    SetProp(P_KILL_NAME, "Mauerwaechter");
    SetProp(P_KILL_MSG, "Der Wachweg bleibt rein.");
    SetProp(P_DEFAULT_INFO, "nickt nur knapp und bleibt aufmerksam.\n");
    SetProp(P_LOG_INFO, "npc_mauerwaechter");

    SetProp(P_SPELLRATE, 12);
    AddSpell(2, 150,
        "Der Mauerwaechter rammt dir den Schaft seiner Hellebarde in den "
        "Brustkorb.\n",
        "Der Mauerwaechter rammt @WEM den Schaft seiner Hellebarde in den "
        "Brustkorb.\n",
        DT_BLUDGEON,
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1, 220,
        "Ein helles Flimmern laesst den Streich des Mauerwaechters "
        "aufflammen.\n",
        "Ein helles Flimmern laesst den Streich des Mauerwaechters gegen "
        "@WEN aufflammen.\n",
        DT_HOLY,
        ([SP_SHOW_DAMAGE: 1]));

    SetChats(3, ({
        "Der Mauerwaechter legt zwei Finger auf die Brustwehr und lauscht.\n",
        "Ein leises Gebet wispert ueber die Lippen des Mauerwaechters.\n",
        "Der Mantel des Mauerwaechters knistert im frostigen Wind.\n",
    }));
    SetAttackChats(5, ({
        "Der Mauerwaechter ruft: \"Im Namen der Rose, halt ein!\".\n",
        "Die Hellebarde des Mauerwaechters blitzt in einer engen Kurve.\n",
        "Der Mauerwaechter stoesst dich mit der Schulter zurueck.\n",
        "Funken spruehen, als der Mauerwaechter die Waffe hart blockt.\n",
    }));

    AddInfo(({"wachweg", "mauerweg"}),
        "Der Wachweg gehoert dem Orden. Wir halten ihn frei und melden jede "
        "Bewegung.",
        "erklaert: ");
    AddInfo(({"patrouille", "patrouillen"}),
        "Patrouillen wechseln mit jedem Schlag der Sanduhr. Keiner geht "
        "allein.",
        "erklaert: ");
    AddInfo(({"goldene_rose", "orden", "festung"}),
        "Die Festung ist geweiht. Wer sie betritt, folgt den Geboten der "
        "Goldenen Rose.",
        "sagt: ");

    SetProp(P_REJECT, ({ REJECT_DROP,
        "<name> schuettelt den Kopf: \"Behalt Deine Sachen, Reisender.\".\n" }));

    SUID;
    CLONEME("/p/weapon/spear/hellebarde");
    command("zuecke hellebarde");
    CLONEME("/p/armour/armour/kettenpanzer");
    if (random(2))
        CLONEME("/p/armour/helm/kettenhaube");
    if (random(2))
        CLONEME("/p/armour/bracers/messingarmschienen");
    if (random(2))
        CLONEME("/p/armour/boots/lederstiefel");
    command("trage alles");

    SetProp(P_MNPC_AREA, ({
        ROOM "wachweg_x",
        ROOM "festung_nordturm",
        ROOM "festung_suedturm",
    }));
    SetProp(P_MNPC_WAIT, ({ 10, 25, 15 }));
    SetProp(P_MNPC_DEFAULTROOM, ROOM "wachweg_x0y1");
    SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES |
        MOV_BACKWARDS | MOV_MAYLOAD);
}
