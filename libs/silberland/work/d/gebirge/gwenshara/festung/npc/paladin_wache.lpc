#include "../def.h"

inherit "/p/std/npc/paladin_npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

protected string guard_name = "Paladin der Rose";
protected int guard_gender = MALE;
protected int guard_level = 20;
protected int guard_glevel = 10;
protected string guard_short_suffix = ", ein Paladin der Goldenen Rose";
protected string guard_long =
    "Der Paladin traegt den hellen Wappenrock der Goldenen Rose und "
    "haelt sein Schwert stets griffbereit. Wachsamkeit und Pflicht "
    "zeichnen jede seiner Bewegungen.";
protected int guard_align = 1100;

protected void configure_guard() { }
protected void configure_equipment() { }

public void create()
{
    if (!is_clone(TO))
        return;
    ::create();

    configure_guard();
    create_default_paladin(guard_level, guard_glevel);

    AddId(explode(lower_case(guard_name), " "));
    AddId(({ regreplace(lower_case(guard_name), " ", "_", 1) }));
    SetProp(P_NAME, guard_name);
    SetProp(P_GENDER, guard_gender);
    SetProp(P_RACE, "Mensch");
    SetProp(P_SHORT, guard_name + guard_short_suffix);
    SetProp(P_LONG, guard_long);
    AddId(({ "paladin", "paladin_wache", "rosenwache", "paladin_der_rose" }));
    SetProp(P_ARTICLE, 0);
    SetProp(P_ALIGN, guard_align);
    SetProp(P_HEAL, 2);
    SetProp(P_SIZE, 185);
    SetProp(P_KILL_NAME, guard_name);

    SetChats(3, ({
        "Der Paladin zieht die Lederhandschuhe fester.\n",
        "Ein leises Gebet huscht ueber die Lippen des Paladins.\n",
        "Der Paladin kontrolliert die Schneide seines Schwertes mit geuebtem Blick.\n",
    }));
    SetAttackChats(5, ({
        "Der Paladin ruft: \"Im Namen Dustys, halte ein!\".\n",
        "Die Klinge des Paladins gleitet blitzschnell nach vorne.\n",
        "Der Paladin hebt den Schild und stoesst kraftvoll zu.\n",
    }));

    SetProp(P_SPELLRATE, 20);
    AddSpell(2, 200,
        "Die Klinge des Paladins schlaegt in einem heissen Lichtbogen zu.\n",
        "Die Klinge des Paladins schlaegt @WEN in einem heissen Lichtbogen.\n",
        DT_HOLY,
        ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1, 260,
        "Der Paladin rammt dir den Schild in den Bauch und reisst die Wunde mit "
        "dem Schwert auf.\n",
        "Der Paladin rammt @WEM den Schild in den Bauch und reisst die Wunde "
        "mit dem Schwert auf.\n",
        DT_SLASH,
        ([SP_SHOW_DAMAGE: 1]));

    SUID;
    CLONEME("/gilden/paladine/weapon/paladinschwert");
    command("zuecke paladinschwert");
    CLONEME("/p/armour/shield/eisenschild");
    CLONEME("/p/armour/armour/kettenpanzer");
    CLONEME("/p/armour/helm/kettenhaube");
    CLONEME("/p/armour/boots/lederstiefel");
    command("trage alles");
    configure_equipment();
}
