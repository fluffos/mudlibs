#include "../def.h"

inherit "std/mnpc";

void create()
{
    if (!is_clone(TO))
        return;
    ::create();

    SetProp(P_NAME, "Versorgungskarren");
    SetProp(P_SHORT, "ein knarrender Versorgungskarren");
    SetProp(P_LONG,
        "Der Versorgungskarren besteht aus schwerem Gebirgsholz, dessen Planken von "
        "dicken Eisenringen gehalten werden. Zwei massige Zugtiere tragen das Joch und "
        "ziehen den Wagen in stetigem Rhythmus den Pfad entlang. Kisten, Saecke und "
        "Fassbaender sind mit Seilen verzurrt, und der Duft von Oel und Getreide liegt "
        "in der Luft.");
    SetProp(P_GENDER, NEUTER);
    SetProp(P_RACE, "Fahrzeug");
    AddId(({ "versorgungskarren", "karren", "wagen", "versorgungswagen" }));

    create_default_npc(12);
    SetProp(P_ALIGN, 100);
    SetProp(P_SIZE, 260);
    SetProp(P_WEIGHT, 450000);
    SetProp(P_MAX_HANDS, 1);
    SetProp(P_HANDS, ({ " mit seiner Deichsel", 90, DT_BLUDGEON }));
    SetProp(P_WIMPY, 0);

    SetProp(P_MSGIN, "rumpelt heran");
    SetProp(P_MSGOUT, "rumpelt davon");
    SetProp(P_MMSGIN, "rollt knarrend aus einer Kurve herein");
    SetProp(P_MMSGOUT, "rollt knarrend davon");

    SetChats(3, ({
        "Die Eisenreifen des Versorgungskarrens kreischen kurz auf, als sie ueber blanken Fels rutschen.\n",
        "Kisten schlagen dumpf gegeneinander, waehrend der Versorgungskarren eine weitere Kurve nimmt.\n",
        "Die Zugtiere schnauben schwer, doch der Versorgungskarren rollt unbeirrt weiter bergauf.\n",
    }));

    AddInfo(({"ladung", "kisten", "saecke", "faesser"}),
        "Die Ladung besteht aus Werkzeug, Hafer, Oelflaschen und allem, was die Festung fuer den Alltag braucht.",
        "klappert: ");
    AddInfo(({"fahrer", "lenker"}),
        "Der eigentliche Fuhrer sitzt gut versteckt auf dem Bock und laesst die Tiere fast von alleine laufen.",
        "meint eine raue Stimme: ");

    SetProp(P_MNPC_AREA, ({ ROOM "ostweg", ROOM "festung_osttor" }));
    SetProp(P_MNPC_WAIT, ({ 8, 12, 5 }));
    SetProp(P_MNPC_DEFAULTROOM, ROOM "ostweg_7");
    SetProp(P_MNPC_FLAGS,
        MOV_BACKWARDS | MOV_OUTDOORS | MOV_MOVES);
}
