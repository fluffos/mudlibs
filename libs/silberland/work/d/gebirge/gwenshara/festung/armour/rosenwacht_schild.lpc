#include "../def.h"

inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <armour.h>
#include <material.h>

void create()
{
    ::create();

    SetProp(P_SHORT, "Ein vergoldeter Rosenbuckler");
    SetProp(P_LONG,
        "Der Buckler aus gehaertetem Stahl ist kreisrund und traegt in der Mitte eine "
        "erhabene Rose. Die Kante ist mit Messing verstaerkt und zeigt kaum Abschabungen.");
    SetProp(P_NAME, "Rosenbuckler");
    SetProp(P_GENDER, MALE);
    SetProp(P_NAME_ADJ, "vergoldet");
    AddId(({ "rosenbuckler", "buckler", "schild", "rosenschild" }));
    AddAdjective(({ "vergoldeter", "vergoldeten", "vergoldetem" }));

    SetProp(P_ARMOUR_TYPE, AT_SHIELD);
    SetProp(P_AC, 27);
    SetProp(P_WEIGHT, 3200);
    SetProp(P_VALUE, 3800);
    SetProp(P_QUALITY_DECAY, 180);
    SetProp(P_MATERIAL, ([ MAT_STEEL:90, MAT_BRASS:10 ]));
}
