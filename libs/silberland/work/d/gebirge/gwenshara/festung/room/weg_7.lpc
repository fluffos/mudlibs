#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein enger Durchstieg im Gebirge");
    SetProp(P_INT_LONG,
    "Zwei massive Felsen lehnen sich so dicht aneinander, dass du dich seitwaerts "
    "hindurchzwaengen musst. Das Gestein ist feucht, und deine Schritte hallen "
    "gedaempft von den Waenden wider.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("felsen",
        "Die Felsen stehen so dicht beieinander, dass kaum Raum bleibt.");
    AddDetail("gestein",
        "Das Gestein ist feucht und glatt vom staendigen Nebel.");
    AddDetail("waenden",
        "Die Waende ruecken eng zusammen und schlucken den Klang.");
    AddDetail("schritte",
        "Deine Schritte klingen gedaempft und kurz.");
    AddDetail("enge",
        "Die Enge zwingt dich, dich seitwaerts zu drehen.");
    AddDetail("durchstieg",
        "Der Durchstieg wirkt schmal, aber passierbar.");
    AddDetail("feuchtigkeit",
        "Feuchtigkeit perlt an den Waenden herab.");
    AddDetail("boden",
        "Der Boden ist uneben und rutschig.");
    AddDetail("licht",
        "Nur wenig Licht faellt von oben herein.");
    AddDetail("luft",
        "Die Luft ist kuehl und riecht nach nassem Stein.");
        AddDetail("himmel",
        "Ein schmaler Streifen Himmel schimmert weit ueber dir.");
    AddDetail("klang",
        "Der Klang deiner Bewegung verliert sich sofort in der Enge.");
    AddDetail("nebel",
        "Feiner Nebel haengt zwischen den Felsen und bewegt sich kaum.");
    AddDetail("raum",
        "Der Raum zwischen den Felsen ist so eng, dass du kaum atmen magst.");
    AddDetail("waende",
        "Die Waende sind feucht und kalt, mit feinen Rissen durchzogen.");
    AddDetail("bewegung",
        "Jede Bewegung hallt leise zwischen den Felsen wider.");
    AddDetail(({"rissen", "riss", "risse"}),
        "Feine Risse durchziehen den Felsen und glitzern feucht im Licht.");
    AddDetail("streifen",
        "Ein heller Streifen zieht sich ueber dir und weist den Weg.");




//--Ausgaenge--------------------------------------------------------------

    AddExit( "suedwesten", ROOM "weg_6" );
    AddExit( "suedosten", ROOM "weg_8");

//--Items & NPCs-----------------------------------------------------------

}
