#include "../def.h"

inherit "std/room";

void create()
{
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Auf dem Wachweg der Festung");
    SetProp(P_INT_LONG,
        "Du befindest dich auf dem schmalen Wachweg entlang der Ringmauer. "
        "Auf der einen Seite ragt die gezackte Brustwehr empor, auf der "
        "anderen faellt der Blick in den Hof mit seinen stetig eilenden "
        "Patrouillen. Stiefelschritte hallen ueber die Steinplatten, und "
        "die eisige Hoehenluft riecht nach Oel, Metall und angespannter "
        "Wachsamkeit.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_TOWN]));

//--Details----------------------------------------------------------------

    AddDetail(({"wachweg", "weg", "mauerweg"}),
        "Der Wachweg folgt der kompletten Ringmauer und erlaubt schnelle "
        "Patrouillen zwischen den Tuermern.");
    AddDetail(({"ringmauer", "mauer", "mauern"}),
        "Die Mauer ist breit genug fuer zwei Paladine nebeneinander und "
        "von Kerben und Narben vergangener Belagerungen gezeichnet.");
    AddDetail(({"kerben", "narben", "belagerungen"}),
        "Tiefe Kerben und geschwaerzte Narben erinnern an fruehere "
        "Belagerungen, als Katapulte den Stein erschuetterten.");
    AddDetail("katapulte",
        "Katapulte standen einst direkt ueber der Brustwehr.");
    AddDetail(({"brustwehr", "bruestungen", "zinnen"}),
        "Hohe Brustwehren mit schmalen Schiessscharten schuetzen die "
        "Patrouillen, waehrend sie ueber das Umland wachen.");
    AddDetail(({"schiessscharten", "scharten"}),
        "Die Scharten sind kaum breiter als ein Handruecken und doch "
        "gross genug, um Pfeile oder Armbrustbolzen hinauszuschiessen.");
    AddDetail("scharte",
        "Jede Scharte bleibt schmal fuer den Schutz.");
    AddDetail("schutz",
        "Schutz bedeutet hier, so wenig Flaeche wie noetig zu zeigen.");
    AddDetail("handruecken",
        "Mehr als einen Handruecken darf eine Scharte nicht oeffnen, "
        "sonst waere der Schutz dahin.");
    AddDetail(({"armbrustbolzen", "pfeile"}),
        "Armbrustbolzen und Pfeile liegen in geordneten Koechern bereit, "
        "damit jeder Schuss sofort sitzt.");
    AddDetail("koechern",
        "Koechern haengen ordentlich an der Brustwehr.");
    AddDetail("schuss",
        "Ein Schuss erfolgt hier nur nach Zeichen.");
    AddDetail(({"hof", "innenhof"}),
        "Tief unten im Hof trainieren Knappen, schleifen Waffen und "
        "bereiten die Paladine ihre Ausruestung vor.");
    AddDetail("knappen",
        "Knappen spurten zwischen Waffenstaendern und schleppen "
        "Ausruestung zu den Patrouillen.");
    AddDetail("waffenstaendern",
        "Waffenstaendern stehen eng an der Mauer.");
    AddDetail(({"patrouillen", "wachposten", "paladine", "waechter"}),
        "Paladine gehen hier regelmaessig auf und ab, halten Blickkontakt "
        "und wechseln mit kurzen Zeichen ihre Positionen.");
    AddDetail(({"blick", "blickkontakt", "positionen", "zeichen"}),
        "Ein kurzer Blickkontakt und zwei Fingerzeichen genuegen, um "
        "Positionen zu tauschen oder eine Gefahr im Umland zu melden.");
    AddDetail("fingerzeichen",
        "Fingerzeichen ersetzen hier jedes Wort.");
    AddDetail("gefahr",
        "Gefahr wird mit einem einzelnen Zeichen gemeldet.");
    AddDetail("bewegung",
        "Bewegung unterhalb der Mauer faellt sofort auf.");
    AddDetail("wachen",
        "Wachen zaehlen Tritte und Blicke im selben Rhythmus.");
    AddDetail("steinplatten",
        "Glatte Steinplatten bilden den Boden des Wachwegs und tragen die "
        "Spuren zahlloser Stiefelschritte.");
    AddDetail(({"boden", "stein", "spuren"}),
        "Der Boden besteht aus hellen Steinquadern, deren abgegriffene "
        "Spuren von endlosen Wachen berichten.");
    AddDetail("steinquadern",
        "Steinquadern liegen dicht und ohne Spalt.");
    AddDetail(({"stiefelschritte", "klirren"}),
        "Jeder Stiefelschritt klingt trocken auf dem Stein, begleitet "
        "vom Klirren locker sitzender Ruestungen.");
    AddDetail("stiefelschritt",
        "Ein einzelner Stiefelschritt hallt schon weit.");
    AddDetail("wind",
        "Der Wind treibt kalte Fetzen aus Nebel und Schnee ueber den Weg "
        "und zerrt an deinem Mantel.");
    AddDetail(({"himmel", "luft", "hoehenluft"}),
        "Der Himmel wirkt nah und bleich, die Hoehenluft schneidet "
        "frostig in die Lungen und laesst jeden Atem sichtbar werden.");
    AddDetail("atem",
        "Atem bildet sofort eine kleine Wolke.");
    AddDetail("lungen",
        "Die Lungen brennen nach wenigen schnellen Schritten.");
    AddDetail("frost",
        "Frost sitzt selbst an den Ruestungen.");
    AddDetail("seite",
        "Eine Seite wird von den Mauern der Tuerme eingefasst, die andere "
        "oeffnet sich zum Umland.");
    AddDetail("tuermern",
        "Die Tuerme erheben sich in regelmaessigen Abstaenden und bieten "
        "Deckung sowie Treppen in den Innenhof.");
    AddDetail("abstaenden",
        "Gleiche Abstaenden helfen den Wachen beim Zaehlen.");
    AddDetail("deckung",
        "Deckung geben Zinnen, Mauern und Tuerme.");
    AddDetail("treppen",
        "Treppen fuehren von hier aus in jeden Turm.");
    AddDetail("tuerme",
        "Tuerme wirken wie stumme Wachtposten.");
    AddDetail("umland",
        "Das Umland besteht aus grauen Haengen, Geruell und eisigen "
        "Pfaden, die sich zum Horizont verlieren.");
    AddDetail("haengen",
        "Haengen fallen steil zum Umland.");
    AddDetail("geruell",
        "Geruell rutscht bei jedem Wind.");
    AddDetail("pfaden",
        "Pfaden ziehen wie helle Spuren durchs Umland.");
    AddDetail("horizont",
        "Am Horizont verschwimmt alles im Nebel.");
    AddDetail(({"ausruestung", "ruestungen", "metall", "stahl", "waffen"}),
        "Ausruestung wird hier sorgfaeltig gepflegt: Metall und Stahl "
        "glaenzen trotz Frost, Waffen stehen in Halterungen bereit.");
    AddDetail("halterungen",
        "Halterungen bestehen einfach aus Metall.");
    AddDetail(({"oel", "kettenoel", "metallduft"}),
        "Der Geruch von Kettenoel haengt in der Luft, damit Metall und "
        "Stahl weich und geschmeidig bleiben.");
    AddDetail("geruch",
        "Der Geruch mischt Metall, Oel und Stein.");
    AddDetail("wachsamkeit",
        "Jede Bewegung und jedes Geraeusch wird geprueft, denn "
        "Wachsamkeit ist hier oben Gesetz.");
    AddDetail("geraeusch",
        "Geraeusch ohne Zeichen stoppt die Wachen.");
    AddDetail("gesetz",
        "Gesetz bedeutet hier, niemanden ungesehen passieren zu lassen.");
    AddDetail("rufe",
        "Rufe werden hier nur gefluestert, damit sie nicht ueber die "
        "Mauern hinweg verraten, wie viele Wachen unterwegs sind.");
    AddDetail("hauch",
        "Ein Hauch reicht, um Zeichen weiterzugeben.");

//--Sinneseindruecke------------------------------------------------------

    AddSound(DEFAULT_SOUND,
        "Gedaempfte Rufe der Wachposten und das regelmaessige Klirren von "
        "Ruestungen hallen ueber den Wachweg.");
    AddSmell(DEFAULT_SMELL,
        "Die Luft riecht nach Kettenoel, geschliffenem Stahl, kaltem Stein "
        "und einem Hauch von Oel.");
}
