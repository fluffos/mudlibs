#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein suedlicher Trainingshof");
    SetProp(P_INT_LONG,
        "Die Sonne erreicht diesen Hof seltener, und das Gestein ist feucht vom Nebel. "
        "Hier ueben die Wachsamen den Umgang mit Schild und Speer. Ein schlichter Brunnen "
        "steht in der Mitte, das Wasser dunkel und unbewegt.");
//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

    AddDetail("sonne",
        "Die Sonne erreicht diesen Hof kaum und scheint nur schwach.");
    AddDetail("hof",
        "Der Hof bleibt feucht und kuhl im Schatten der Mauern.");
    AddDetail("gestein",
        "Dunkles Gestein glaenzt feucht vom Nebel.");
    AddDetail("nebel",
        "Der Nebel liegt still ueber dem Hof und bewegt sich kaum.");
    AddDetail("wachsamen",
        "Die Wachsamen ueben schweigend weiter.");
    AddDetail("schild",
        "Die Schilde werden schweigend getestet.");
    AddDetail(({"speer", "speere"}),
        "Speere schneiden leise durch den Nebel.");
    AddDetail("brunnen",
        "Ein schlichter Brunnen ruht unbewegt in der Mitte.");
    AddDetail("mitte",
        "Die Mitte bleibt leer und still.");
    AddDetail("wasser",
        "Dunkles Wasser riecht leicht bitter.");
    AddDetail("schatten",
        "Schatten liegen dicht um die Wachsamen und verschlucken fast alles.");
    AddDetail("mauern",
        "Die Mauern stehen nahe beieinander und lassen kaum Sonne ein.");
    AddDetail("boden",
        "Der Boden bleibt feucht und hart unter den Stiefeln.");
    AddDetail(({"stiefeln", "stiefel"}),
        "Deine Stiefel klatschen dumpf auf den Boden.");
    AddDetail("himmel",
        "Der Himmel erscheint nur blass zwischen den Mauern.");
    AddDetail("umgang",
        "Der Umgang mit Schild und Speer wirkt konzentriert und ruhig.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "norden", ROOM "festung_2" );
    AddExit( "nordosten", ROOM "festung_5");
    AddExit( "osten", ROOM "festung_6");

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "pagen_der_rose", REFRESH_DESTRUCT);
}
