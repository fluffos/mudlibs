#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein windiger Grat ueber den Schluchten");
    SetProp(P_INT_LONG,
    "Der Pfad aus dem Canyon erreicht hier einen schmalen Grat, von dem aus du "
    "weit ueber die Nebel des Gebirges blickst. Der Wind peitscht an den Felsen, "
    "und das Licht des Ostens glimmt wie ein Versprechen. Weiter oestlich "
    "zeichnet sich der Schatten einer gewaltigen Mauer ab.");



//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("boden",
        "Der Boden ist rau und uneben, vom Wind blank geschliffen.");
    AddDetail("canyon",
        "Tief unter dir liegt der Canyon, gefuellt mit dichten Nebeln.");
    AddDetail("felsen",
        "Die Felsen sind scharfkantig und tragen Spuren vieler Stuerme.");
    AddDetail("gebirges",
        "Das Gebirge dehnt sich endlos aus, grau und maechtig wie ein schlafender Riese.");
    AddDetail("grat",
        "Der Grat ist schmal und windgepeitscht, kaum breit genug fuer einen sicheren Stand.");
    AddDetail("himmel",
        "Der Himmel spannt sich weit ueber dir, von fahlem Blau und ziehenden Wolken.");
    AddDetail("licht",
        "Das Licht des Ostens bricht sich im Nebel und glimmt wie fluessiges Silber.");
    AddDetail("mauer",
        "Am Horizont erhebt sich eine gewaltige Mauer, dunkel gegen das aufhellende Licht.");
    AddDetail("nebel",
        "Die Nebel wogen in langsamen Stroemen durch die Schluchten unter dir.");
    AddDetail("ostens",
        "Im Osten glimmt das Licht staerker, verheissungsvoll und still zugleich.");
    AddDetail("pfad",
        "Der Pfad fuehrt ueber den Grat, schmal und von Wind und Zeit gezeichnet.");
    AddDetail("schatten",
        "Der Schatten der Mauer liegt lang ueber dem Fels und verschluckt das Licht.");
    AddDetail("versprechen",
        "Im Licht des Ostens liegt das Versprechen von Waerme und Ziel.");
    AddDetail("wind",
        "Der Wind peitscht ueber den Grat und singt in den Ritzen des Felsens.");
    AddDetail("blau",
        "Ein fahles Blau liegt ueber dem Himmel und fliesst in das Grau des Nebels.");
    AddDetail("fels",
        "Der Fels ist rau und kalt, von Wind und Frost gezeichnet.");
    AddDetail("gebirge",
        "Das Gebirge erstreckt sich bis zum Horizont, voller Schatten und Licht.");
    AddDetail("horizont",
        "Am Horizont verschwimmen Himmel und Stein zu einer silbrigen Linie.");
    AddDetail("riese",
        "Der Riese des Gebirges ruht unbewegt, doch seine Groesse ist spuerbar.");
    AddDetail("ritzen",
        "In den Ritzen des Felses pfeift der Wind und hinterlaesst feinen Staub.");
    AddDetail("schluchten",
        "Die Schluchten darunter sind tief und gefuellt mit rollenden Nebeln.");
    AddDetail("silber",
        "Ein Hauch von Silber glimmt auf den nassen Steinen.");
    AddDetail("spuren",
        "Schmale Spuren von Schuhen oder Tieren fuehren ueber den Grat.");
    AddDetail("stand",
        "Der Stand auf dem Grat ist unsicher, der Wind zerrt an deinem Gleichgewicht.");
    AddDetail("stroemen",
        "Die Nebel ziehen in traegen Stroemen durch die Tiefe.");
    AddDetail("stuerme",
        "Alte Stuerme haben den Fels geschliffen und seine Kanten scharf gemacht.");
    AddDetail("waerme",
        "Von Waerme ist hier nichts zu spueren, nur das kalte Licht des Morgens.");
    AddDetail("wolken",
        "Wolkenfetzen treiben ueber den Himmel und werfen fluechtige Schatten.");
    AddDetail("zeit",
        "Die Zeit scheint hier stillzustehen, gefangen im Wind und Stein.");
    AddDetail("ziel",
        "Im Osten erkennst du das Ziel deiner Reise: die dunkle Festung am Ende des Grats.");
    AddDetail("ende",
        "Am Ende des Grats erhebt sich die Mauer der Festung.");
    AddDetail("festung",
        "Die Festung thront ueber dem Gebirge wie ein Waechter aus Stein.");
    AddDetail("frost",
        "Feiner Frost ueberzieht den Fels und glitzert im fruehen Licht.");
    AddDetail("gleichgewicht",
        "Du musst dein Gleichgewicht halten, waehrend der Wind an dir zerrt.");
    AddDetail("grau",
        "Ein kuehles Grau liegt ueber allem, durchzogen von hellem Nebel.");
    AddDetail("groesse",
        "Die Groesse der Landschaft laesst dich klein und staunend zurueck.");
    AddDetail("hauch",
        "Ein Hauch von Eis weht ueber den Grat und kriecht dir in den Nacken.");
    AddDetail("kanten",
        "Die Kanten des Felses sind scharf und schneiden beinahe in die Hand.");
    AddDetail("linie",
        "Die Linie des Grats zieht sich wie eine Schneise durch den Nebel.");
    AddDetail("morgens",
        "Die Kaelte des Morgens laesst den Atem weiss vor dir aufsteigen.");
    AddDetail("reise",
        "Deine Reise hat dich hierher gefuehrt, an den Rand zwischen Licht und Schatten.");
    AddDetail("schuhen",
        "An deinen Schuhen klebt feuchter Staub vom steilen Aufstieg.");
    AddDetail("staub",
        "Feiner Staub wirbelt bei jedem Schritt auf und wird vom Wind fortgetragen.");
    AddDetail("stein",
        "Der Stein fuehlt sich glatt und alt an, als waere er ewig hier gewesen.");
    AddDetail("steinen",
        "Zwischen den Steinen glitzern kleine Eiskristalle.");
    AddDetail("tiefe",
        "Die Tiefe unter dir verliert sich im Nebel und scheint bodenlos.");
    AddDetail("tieren",
        "Nur vereinzelte Spuren von Tieren zeugen von Leben auf diesem Grat.");
    AddDetail("atem",
        "Dein Atem steigt als weisse Wolke auf und verweht im Wind.");
    AddDetail("aufstieg",
        "Der Aufstieg war steil und muehsam, doch die Aussicht belohnt dich.");
    AddDetail("eis",
        "Duennes Eis hat sich in Spalten und ueber feuchte Steine gelegt.");
    AddDetail("eiskristalle",
        "Eiskristalle funkeln auf dem Boden wie verstreuter Staub.");
    AddDetail("hand",
        "Deine Hand spuert die raue Kaelte des Felses bei jeder Beruehrung.");
    AddDetail("kaelte",
        "Die Kaelte ist schneidend und klar, wie der Atem des Gebirges selbst.");
    AddDetail("landschaft",
        "Die Landschaft oeffnet sich weit, ein endloses Meer aus Nebel und Stein.");
    AddDetail("leben",
        "Von Leben ist kaum etwas zu sehen, nur der Wind bewegt sich frei.");
    AddDetail("nacken",
        "Kalter Wind streicht dir ueber den Nacken und laesst dich froesteln.");
    AddDetail("rand",
        "Der Rand des Grats faellt steil ab und verliert sich im Grau.");
    AddDetail("schneise",
        "Eine Schneise aus Licht durchbricht den Nebel und weist nach Osten.");
    AddDetail("schritt",
        "Jeder Schritt hallt dumpf und verliert sich im Wind.");
    AddDetail("waechter",
        "Der Waechter aus Stein thront unbewegt ueber der Schlucht.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "suedwestunten", ROOM "weg_10" );
    AddExit( "osten", ROOM "weg_12");

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "outrider", REFRESH_DESTRUCT);
}
