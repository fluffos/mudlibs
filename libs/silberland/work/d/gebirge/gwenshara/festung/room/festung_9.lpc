#include "../def.h"

inherit "std/room";

void create()
{
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein Durchgang in den inneren Mauern");
    SetProp(P_INT_LONG,
        "Die Mauer ueffnet sich zu einem breiten Durchgang, dessen Boden vom Regen "
        "dunkel verfaerbt ist. Hier sammeln sich die Paladine vor der Wache, bevor sie "
        "in den Burgfried gerufen werden. Eine schwere Tuer aus Metall fuehrt nach Osten.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("durchgang",
        "Der Durchgang wirkt wie eine Kehle aus Stein.");
    AddDetail("kehle",
        "Wie eine aufgerissene Kehle fuehrt der Durchgang in den Bauch der Festung.");
    AddDetail("bauch",
        "Im Bauch der Festung hallen Schritte dumpf und verlieren sich in den Mauern.");
    AddDetail("schritte",
        "Schritte hallen wie hohle Trommelschlaege zwischen den Mauern.");
    AddDetail("trommelschlaege",
        "Trommelschlaege und Schritte klingen hier kaum voneinander zu unterscheiden.");
    AddDetail("schritt",
        "Jeder Schritt wird bewusst gesetzt, als waere der Boden zerbrechlich.");
    AddDetail("festung",
        "Die Festung wirkt hier wachsam, als beobachte sie jede Regung.");
    AddDetail("regung",
        "Jede Regung im Durchgang scheint sofort bemerkt zu werden.");
    AddDetail("erwartung",
        "Eine dichte Erwartung liegt in der Luft und drueckt auf die Stimme.");
    AddDetail(({"mauer", "mauern"}),
        "Die innere Mauer oeffnet sich hier wie ein Torso.");
    AddDetail("torso",
        "Der Torso der Mauer scheint lebendig und zieht alles in sein Innerstes.");
    AddDetail("innerstes",
        "Wer tiefer geht, spuert das Innerste der Festung mit jeder Faser.");
    AddDetail("innerste",
        "Das Innerste der Festung liegt nur wenige Schritte weiter im Schatten.");
    AddDetail("faser",
        "Bis in jede Faser der Luft schwingt die Erwartung der Wache.");
    AddDetail("boden",
        "Dunkler Boden schimmert nass vom Regen.");
    AddDetail("stein",
        "Der Stein fuehlt sich feucht und dennoch erstaunlich glatt an.");
    AddDetail("regen",
        "Frischer Regen haelt den Stein kuhl.");
    AddDetail("paladine",
        "Paladine sammeln sich schweigend vor ihrer Pflicht.");
    AddDetail("pflicht",
        "Die Pflicht legt sich wie ein Gewicht auf die Schultern der Wartenden.");
    AddDetail("gewicht",
        "Das Gewicht der Verantwortung zieht selbst den Atem schwerer.");
    AddDetail("verantwortung",
        "Verantwortung liegt sichtbar auf den Gesichtern der Soldaten.");
    AddDetail("gesichtern",
        "Auf den Gesichtern steht eine muede Ruhe, die nichts veraet.");
    AddDetail("soldaten",
        "Die Soldaten wirken wie aus dem Stein selbst herausgemeisselt.");
    AddDetail("atem",
        "Jeder Atemzug dampft kurz und verliert sich im Durchgang.");
    AddDetail("atemzug",
        "Ein einzelner Atemzug reicht, um den kalten Hauch zu spueren.");
    AddDetail("hauch",
        "Ein kalter Hauch streicht durch den Durchgang wie eine Warnung.");
    AddDetail("schultern",
        "Schultern unter Ruestung wirken angespannt wie gespannte Sehnen.");
    AddDetail("ruestung",
        "Jede Ruestung traegt Scharten, die von frueheren Schlachten erzaehlen.");
    AddDetail("scharten",
        "Scharten uebersaeen den Stahl wie kleine Narben.");
    AddDetail("schlachten",
        "Schlachten haben jede Platte gezeichnet und doch nicht gebrochen.");
    AddDetail("sehnen",
        "Sehnen stehen hart unter der Haut, bereit fuer den naechsten Befehl.");
    AddDetail("haut",
        "Die Haut ist trotz Kaelte feucht vom dauernden Warten.");
    AddDetail("befehl",
        "Ein Befehl braucht hier nur ein Nicken, niemals ein Wort.");
    AddDetail("wartenden",
        "Die Wartenden stehen reglos, nur der Blick wandert ueber die Reihen.");
    AddDetail("reihen",
        "Die Reihen der Paladine sind so exakt, als seien sie in den Stein gemeisselt.");
    AddDetail("wache",
        "Die Wache beginnt hier mit einem stillen Nicken.");
    AddDetail("augen",
        "Augen folgen jeder Bewegung, auch wenn Koerper still stehen.");
    AddDetail("nicken",
        "Ein einziges kurzes Nicken reicht, um die Schicht zu beginnen.");
    AddDetail("schicht",
        "Jede neue Schicht gleicht einem Ritual, das keine Worte braucht.");
    AddDetail("ritual",
        "Das Ritual des Wachwechsels verlaeuft lautlos, nur Augen und Banner bewegen sich.");
    AddDetail("wachwechsels",
        "Der Wachwechsels selbst ist so praezise, dass kaum Zeit vergeht.");
    AddDetail("worte",
        "Worte sind hier ueberfluessig; ein Blick genuegt fuer den Befehl.");
    AddDetail("banner",
        "Banner haengen schwer an der Mauer und zittern nur beim Ruf zur Wache.");
    AddDetail("burgfried",
        "Der Burgfried wartet ernst auf die naechste Abloesung.");
    AddDetail("abloesung",
        "Die Abloesung steht bereit, die Naechte gegen die Morgen zu tauschen.");
    AddDetail("naechte",
        "Die Naechte ziehen langsam vorbei, waehrend Plattenruestungen kuhl bleiben.");
    AddDetail("morgen",
        "Die Morgen bringen kaum Waerme, aber neues Licht auf die Ruestungen.");
    AddDetail("plattenruestungen",
        "Plattenruestungen schimmern matt und tragen die Male vergangener Kaempfe.");
    AddDetail("kaempfe",
        "Kaempfe haben Metall und Gemueter gleichermassen geschmiedet.");
    AddDetail("ruestungen",
        "Ruestungen klirren leise, wenn die Reihen sich sortieren.");
    AddDetail("tuer",
        "Eine schwere Tuer blockt den Osten wie ein Schild.");
    AddDetail("schild",
        "Das Schild aus Metall ist blank und reflektiert jeden Blick.");
    AddDetail("metall",
        "Kuehles Metall traegt fein polierte Schlieren.");
    AddDetail("metalltuer",
        "Die Metalltuer wirkt wie eine lebendige Barriere zwischen Festung und Weg.");
    AddDetail("barriere",
        "Die Barriere ist mehr als Metall; sie scheint auch Willensstaerke zu pruefen.");
    AddDetail("willensstaerke",
        "Nur Willensstaerke haelt hier stand, wenn der Wind die Glieder auskuehlt.");
    AddDetail("schlieren",
        "Feine Schlieren verraten, wie oft hier Hande ueber das Metall gefahren sind.");
    AddDetail("hande",
        "Raue Hande haben hier unzaehlige Male den Griff geprueft.");
    AddDetail("griff",
        "Der Griff der Tuer ist glatt poliert und doch voller kleiner Macken.");
    AddDetail("macken",
        "Macken im Metall erinnern an ungezaehlte griffbereite Finger.");
    AddDetail("osten",
        "Nach Osten fuehrt der Weg hinaus zum Osttor.");
    AddDetail("weg",
        "Der Weg nach Osten ist breit genug, damit zwei Zuege aneinander vorbeikommen.");
    AddDetail("zuege",
        "Zuege von Paladinen koennen hier ohne Hast aneinander vorbeimarschieren.");
    AddDetail("hast",
        "Hast haette hier keinen Platz; jeder Schritt bleibt kontrolliert.");
    AddDetail("platz",
        "Platz ist knapp bemessen, doch exakt vermessen.");
    AddDetail("osttor",
        "Das Osttor liegt hinter der Metalltuer und fuehrt hinab zum hoelzernen Steg.");
    AddDetail("steg",
        "Der hoelzerne Steg knarrt leise, selbst wenn niemand ihn betritt.");
    AddDetail("himmel",
        "Nur ein schmales Band Himmel ist ueber dem Durchgang zu sehen.");
    AddDetail("band",
        "Das Band des Himmels wirkt wie eine schmale Hoffnung ueber dem Durchgang.");
    AddDetail("blick",
        "Der Blick gleitet unweigerlich nach oben zu dem schmalen Lichtstreifen.");
    AddDetail("hoffnung",
        "Die Hoffnung haengt hier wie das schmale Lichtband ueber den Koepfen.");
    AddDetail("koepfen",
        "Ueber den Koepfen liegt die Kante der Mauer wie ein fester Deckel.");
    AddDetail("licht",
        "Ein milchiges Licht sickert durch die schmale Oeffnung.");
    AddDetail("lichtband",
        "Ein schmales Lichtband zeichnet den Verlauf des Durchgangs.");
    AddDetail("oeffnung",
        "Die Oeffnung nach oben ist kaum mehr als ein Riss im Gemauer.");
    AddDetail("lichtstreifen",
        "Der Lichtstreifen zeichnet helle Male auf den nassen Boden.");
    AddDetail("male",
        "Male aus Licht und Schatten uebersaeen den Boden wie geheime Zeichen.");
    AddDetail("zeichen",
        "Zeichen aus Wasser und Staub verschwinden nach wenigen Augenblicken.");
    AddDetail("waerme",
        "Waerme bleibt draussen; nur ein Hauch erreicht diesen Durchgang.");
    AddDetail("luft",
        "Die Luft riecht nach Metall und nassem Stein.");
    AddDetail("schatten",
        "Schatten kleben an den Mauern und verschlucken jede Farbe.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "nordwesten", ROOM "festung_7" );
    AddExit( "suedwesten", ROOM "festung_8" );
    AddExit( "osten", ROOM "festung_osttor" );

//--Items & NPCs-----------------------------------------------------------
    
    AddItem(NPC "paladin_dame_lorin", REFRESH_DESTRUCT);
}


int testfunc()
{
    write("Die Tuer ist aktuell verschlossen und laesst sich nicht oeffnen.\n");
    return 0;
}
