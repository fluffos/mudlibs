#include "../def.h"

inherit "std/room";

void create()
{
    ::create();
//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Eine Kehre auf einem Bergpfad");
    SetProp(P_INT_LONG,
        "Der Pfad macht hier eine scharfe Kehre und fuehrt weiter den Berg hinauf. "
        "Er wird hier steiler als zuvor und der Boden ist mit ettlichem Geroell bedeckt."
    );


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------
    AddDetail(({"berg", "flanken", "pass", "fels"}),
        "Der Berg ragt steil ueber dir auf; seine Flanken wirken wie mit Messerhieben "
        "aus dem Fels geschnitten.");
    AddDetail(({"boden", "angelegenheit", "staub", "steine", "steinen"}),
        "Der Boden ist uneben und mit ausgetretenen Spuren bedeckt, die jeden Schritt "
        "zu einer rutschigen Angelegenheit machen.");
    AddDetail(({"geroell", "schieferplatten"}),
        "Das Geroell besteht aus scharfkantigen Schieferplatten und kleinen, rollenden "
        "Steinen, die unter deinen Stiefeln knirschen.");
    AddDetail(({"himmel", "wolkenfetzen"}),
        "Der Himmel spannt sich klar und hell ueber dem Pass, nur vereinzelt ziehen "
        "duenne Wolkenfetzen vorbei.");
    AddDetail(({"kehre", "bogen"}),
        "Die Kehre ist eng und zwingt jeden Wanderer, langsam und vorsichtig zu gehen, "
        "damit kein Fuss verrutscht.");
    AddDetail(({"pfad", "personen"}),
        "Der Pfad windet sich in einem scharfen Bogen weiter den Hang hinauf und ist hier "
        "kaum breit genug fuer zwei Personen nebeneinander.");
    AddDetail(({"hang", "tiefe", "kante"}),
        "Der Hang stuertzt direkt neben dem Pfad in die Tiefe, und lose Steine kullern immer wieder "
        "ueber die Kante.");
    AddDetail(({"steigung", "steiler", "schritt", "berggaenger"}),
        "Die Steigung wird hier so abrupt, dass selbst geuebte Berggaenger kurz verschnaufen muessen.");
    AddDetail(({"spuren", "kerben", "radspuren", "packtieren", "stiefeln"}),
        "Zwischen Geroell und Staub erkennst du Radspuren und tiefe Kerben von alten Packtieren.");
    AddDetail(({"schiefer", "messerhieben", "dach", "tritt"}),
        "Flache Schieferplatten ueberschichten sich wie ein zerbrochenes Dach und splittern bei jedem Tritt.");
    AddDetail(({"wind", "wanderer", "fuss", "felshaken", "geschmack", "gesteins"}),
        "Ein stoischer Wind fegt um die Felshaken und traegt den Geschmack kalten Gesteins mit sich.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "ostweg_5" );
    AddExit( "suedwestunten", ROOM "ostweg_7" );

//--Items & NPCs-----------------------------------------------------------

}
