#include "../def.h"

inherit "std/room";

void create()
{
    ::create();
//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Am Beginn eines steilen Bergpfads");
    SetProp(P_INT_LONG,
      "Hier beginnt ein steiler Pfad, der den Berg hinauf fuehrt. Der Boden ist mit losem "
      "Gestein bedeckt, und der Pfad windet sich zwischen schroffen Felsen hindurch. Alte "
      "Fruchen zeigen, dass hier oefter Furhwerke vorbei kommen."
    );


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------
    AddDetail(({"berg", "gebirge"}),
        "Der Berg erhebt sich wie eine graue Mauer ueber dem Pfad, und weiter oben erkennst du "
        "die gezackten Silhouetten einer Festung.");
    AddDetail("boden",
        "Der Boden ist locker und besteht hauptsaechlich aus bruechigem, staubigem Geruempel, "
        "das bei jedem Schritt leicht ins Rutschen geraet.");
    AddDetail(({"felsen", "felswaende", "fels"}),
        "Die schroffen Felsen tragen Kerben vom ewigen Wind und sind mit trockenem Flechtenbewuchs "
        "ueberzogen.");
    AddDetail("basalt",
        "Der Basalt ist glattgeschliffen und fast schwarz, als haette jemand die Hitze eines "
        "Vulkans darin eingeschlossen.");
    AddDetail(({"vulkans", "grollen"}),
        "Du meinst, noch das ferne Grollen eines erloschenen Vulkans im Stein zu spueren.");
    AddDetail("farben",
        "Die Farben des Berges scheinen im klaren Licht besonders lebendig: kaltes Grau, "
        "metallisches Blau und das Braun vertrockneter Pflanzen.");
    AddDetail(({"festung", "festung"}),
        "Die Festung thront weiter oben auf einem Absatz und ueberwacht schweigend den "
        "ganzen Bergpfad.");
    AddDetail(({"flechtenbewuchs", "inseln"}),
        "Zwischen den Rissen klebt zarter Flechtenbewuchs, der sich in gruene Inseln auf dem "
        "Gestein ausbreitet.");
    AddDetail(({"geruempel", "kieseln", "steinsplittern"}),
        "Ueberall liegt loses Geruempel aus Kieseln, Staub und gebrochenen Steinsplittern, die "
        "von vorbeiziehenden Lasten aufgewirbelt werden.");
    AddDetail(({"fruchen", "furchen"}),
        "Tiefe Fruchen ziehen sich parallel zum Pfad und verraten, dass hier regelmaessig schwere "
        "Lasten vorbei geschleift werden.");
    AddDetail(({"kerben", "messer"}),
        "Die Kerben in den Felsen stammen vom Wind, der kleine Steinchen wie Messer darueber wehen "
        "laesst.");
    AddDetail(({"kurven", "kurve"}),
        "Die Kurven des Pfades sind so eng, dass ein einzelner Fehltritt reicht, um den steilen "
        "Hang hinabzurutschen.");
    AddDetail("lasten",
        "Manchmal glaubst du, das Echo alter Lasten zu hoeren, die knarrend nach oben gezerrt "
        "wurden.");
    AddDetail("luft",
        "Die Luft ist duenn und trocken; jeder Atemzug schmeckt nach Stein und Staub.");
    AddDetail("mauer",
        "Der Berg erhebt sich wie eine Mauer, die keinen Blick auf das, was dahinter liegt, "
        "freigibt.");
    AddDetail("furhwerke",
        "Die Spuren der Furhwerke stammen vermutlich von Versorgungswagen, die langsam zur Festung "
        "klettern und dabei laut knarzen.");
    AddDetail("gestein",
        "Zwischen den Steinen glitzern helle Quarze, doch das meiste Gestein ist dunkler Basalt, "
        "der sprichwoertlich jeden Schritt prueft.");
    AddDetail(({"quarze", "glas", "lichtpunkte"}),
        "Kleine Quarze blitzen wie Glas in der Sonne und bilden winzige Lichtpunkte zwischen dem "
        "grauen Geruempel.");
    AddDetail(({"rutschen", "rutschung"}),
        "Schon ein zu harter Schritt kann eine kleine Rutschung ausloesen, weshalb jeder Schritt "
        "bedacht gesetzt werden sollte.");
    AddDetail(({"schritt", "schritte"}),
        "Deine Schritte hinterlassen nur kurz Spuren, bevor der Wind die kleinen Steine wieder "
        "hineinweht.");
    AddDetail(({"silhouetten", "tuermen"}),
        "Gegen den Himmel zeichnen sich die Silhouetten von Tuermen und Mauern ab, als waeren sie "
        "aus dem Fels selbst gewachsen.");
    AddDetail(({"spuren", "abdruecke", "wagenraeder", "stiefeln"}),
        "Verschiedene Spuren ueberschneiden sich hier: Hufe, Wagenraeder und die leichten Abdruecke "
        "von Stiefeln.");
    AddDetail(({"steinen", "steine", "stein", "steinchen", "brocken", "splitter"}),
        "Die Steine reichen von daumengrossen Brocken bis hin zu feinem Splitter, alle scharf und "
        "kantig.");
    AddDetail("versorgungswagen",
        "Die Versorgungswagen kraxeln langsam bergauf; du kannst dir vorstellen, wie ihre Beladung "
        "bei jeder Kurve bedrohlich knarzt.");
    AddDetail("himmel",
        "Der Himmel spannt sich klar und wolkenlos ueber dir; die Luft ist duenn und laesst die "
        "Farben fast uebernatuerlich grell wirken.");
    AddDetail(({"wind", "boeen", "schwingen"}),
        "Der Wind pfeift in stoessigen Boeen durch die Felsen und traegt staubige Schwingen uebers "
        "Gelaende.");
    AddDetail(({"pfad", "bergpfad"}),
        "Der Pfad windet sich in engen Kurven nach oben, streckenweise kaum breiter als zwei "
        "Schritte und von losen Steinen gesaeumt.");
    AddDetail("absatz",
        "Ein schmaler Absatz oberhalb des Pfad bietet wieder eine Moeglichkeit sich auszuruhen.");
    AddDetail("atemzug",
        "Jeder Atemzug schmeckt nach trockenem Stein und erinnert dich daran, wie hoch du bereits bist.");
    AddDetail("beladung",
        "Die Beladung der Wagen ist wohl unterschiedlich.");
    AddDetail(({"blautoene", "blau"}),
        "Metallische Blautoene schimmern im Stein.");
    AddDetail("blick",
        "Der Blick reicht nur bis zur naechsten Biegung, weil der Pfad immer wieder von Felswaenden verdeckt wird.");
    AddDetail("braun",
        "Duerres Braun verwelkter Pflanzen kontrastiert mit dem dunklen Gestein.");
    AddDetail("pflanzen",
        "Nur widerstandsfaehige Pflanzen ueberleben hier, indem sie sich flach an die Felsen schmiegen.");
    AddDetail("echo",
        "Fernes Echo zerrissener Rufe laeuft zwischen den Felsen hin und her.");
    AddDetail("fehltritt",
        "Ein Fehltritt koennte dich unweigerlich den Hang hinunter schicken.");
    AddDetail("gelaende",
        "Das Gelaende macht jeden Schritt schwierig.");
    AddDetail("grau",
        "Das Grau der Felsen variiert von silbern bis anthrazit.");
    AddDetail("hang",
        "Der Hang faellt direkt neben dir ab und verschluckt jeden Stein, der sich loest.");
    AddDetail("hitze",
        "Die ist nicht wirklich da.");
    AddDetail("licht",
        "Hartes Licht spiegelt sich auf den Quarzen.");
    AddDetail("rissen",
        "Feine Risse ziehen sich wie Spinnweben durch die Felsen.");
    AddDetail("sonne",
        "Die Sonne steht gnadenlos.");
    AddDetail("staub",
        "Ein feiner Staubfilm legt sich ueber alles.");
    AddDetail("biegung",
        "Die naechste Biegung ist gleich westlich von hier.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "nordostoben", ROOM "ostweg_6" );
    AddExit( "sueden", ([
        EX_DEST: "/d/ebene/gwenshara/kyranda/room/norbadenweg_5"]) );

//--Items & NPCs-----------------------------------------------------------

    AddItem(NPC "versorgungskarren", REFRESH_DESTRUCT);
}


int testfunc()
{
    write("Ein Hangrutsch blockiert aktuell den Weg nach Osten.\n");
    return 0;
}
