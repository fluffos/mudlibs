#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein verlassener Gebirgspfad");
    SetProp(P_INT_LONG,
    "Der Weg windet sich zwischen rauen Felsen hindurch. Kalter Nebel haengt "
    "in den Spalten, und der Wind traegt den fernen Klang von rollendem Gestein. "
    "Nach Osten fuehrt der Pfad tiefer in das Gebirge hinein.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

        AddDetail(({"weg","pfad"}),
        "Der Pfad ist schmal und ausgetreten, als haetten ihn zahllose Fuesse ueber Jahre geformt.");
    AddDetail(({"felsen","fels"}),
        "Die Felsen sind rau und kalt, mit Stellen, an denen der Wind sie glattgeschliffen hat.");
    AddDetail("nebel",
        "Kalter Nebel haengt traege in der Luft und sammelt sich in den tieferen Spalten des Gesteins.");
    AddDetail(({"spalten","spalte"}),
        "Die Spalten ziehen sich tief in den Fels hinein, und aus ihnen steigt kuehle Feuchtigkeit auf.");
    AddDetail("wind",
        "Ein bestaendiger Wind weht aus Osten herueber und traegt den fernen Klang rollender Steine.");
    AddDetail("klang",
        "Der Klang hallt von den Felswaenden wider, dumpf und schwer, als ruehrte sich das Gebirge selbst.");
    AddDetail("gestein",
        "Das Gestein wirkt uralt und dicht, durchzogen von feinen Rissen, in denen sich der Nebel verfaengt.");
    AddDetail("osten",
        "Nach Osten hin wird der Nebel heller, und der Pfad scheint sich in eine steilere Passage zu verlieren.");
    AddDetail("gebirge",
        "Das Gebirge um dich wirkt gewaltig und unbewegt, ein grauer Koerper aus Stein und Stille.");
    AddDetail("boden",
        "Der Boden ist uneben und hart, von duennen Schichten aus Staub und Stein bedeckt.");
    AddDetail("felswaenden",
        "Die Felswaende ragen eng auf beiden Seiten empor und verschlucken jedes Echo des Windes.");
    AddDetail("feuchtigkeit",
        "Feine Feuchtigkeit liegt auf allem und laesst das Gestein matt schimmern.");
    AddDetail("fuesse",
        "Unter deinen Fuessen knirschen lose Steine, und jeder Schritt hallt dumpf nach.");
    AddDetail("himmel",
        "Ueber dir spannt sich ein blassgrauer Himmel, der kaum zwischen den Felswaenden zu sehen ist.");
    AddDetail("jahre",
        "Viele Jahre haben den Pfad gezeichnet, jede Spur erzaehlt von Vergaenglichkeit und Bestaendigkeit zugleich.");
    AddDetail("koerper",
        "Der Koerper des Gebirges wirkt lebendig, als atme er mit dem Wind und dem Nebel zugleich.");
    AddDetail("luft",
        "Die Luft ist kuehl und schwer, erfuellt vom Geruch nassen Steins.");
    AddDetail("passage",
        "Die Passage nach Osten wirkt schmaler, doch der Blick zieht dich unweigerlich dorthin.");
    AddDetail("rissen",
        "Feine Risse durchziehen die Felsen und bilden ein Netz aus dunklen Linien im grauen Stein.");
    AddDetail("stein",
        "Der Stein ist kalt und sproede, mit winzigen Splittern, die im diffusen Licht glitzern.");
    AddDetail("stellen",
        "An manchen Stellen wirkt der Fels glatt wie Glas, als haette er sich unter grossem Druck verformt.");
    AddDetail("stille",
        "Eine tiefe Stille liegt ueber dem Ort, nur unterbrochen vom fernen Wispern des Windes.");
    AddDetail("bestaendigkeit",
        "In der Bestaendigkeit des Gesteins liegt eine stille Wuerde, die selbst den Wind zum Schweigen bringt.");
    AddDetail("blick",
        "Dein Blick verliert sich im Grau des Nebels und findet keine klare Grenze zwischen Fels und Himmel.");
    AddDetail("druck",
        "Der Druck der Jahrhunderte hat den Stein verdichtet und glatt geschliffen wie alte Knochen.");
    AddDetail("echo",
        "Ein fernes Echo antwortet auf jeden Laut, kaum hoerbar und doch gegenwaertig.");
    AddDetail("felswaende",
        "Die Felswaende auf beiden Seiten sind rau und nass vom Nebel, durchzogen von dunklen Streifen.");
    AddDetail("geruch",
        "Ein feiner Geruch nach kaltem Stein und feuchtem Moos haengt in der Luft.");
    AddDetail("glas",
        "Das Gestein glaenzt stellenweise wie Glas, als haette es die Kaelte selbst poliert.");
    AddDetail("licht",
        "Das Licht ist matt und farblos, kaum mehr als ein Schimmer im dichten Nebel.");
    AddDetail("linien",
        "Die Linien in den Rissen folgen keiner Ordnung und wirken wie zufaellige Runen des Gebirges.");
    AddDetail("netz",
        "Ein feines Netz aus Rissen zieht sich ueber die Steinflaeche, kaum sichtbar unter der Feuchtigkeit.");
    AddDetail("ort",
        "Der Ort wirkt verlassen und doch wachsam, als wuesste er von all den Schritten, die hier vergangen sind.");
    AddDetail("risse",
        "Die Risse sind schmal und tief, von dunklem Wasser ausgewaschen und schimmernd im Nebellicht.");
    AddDetail("schichten",
        "Duenne Schichten aus Staub und feinem Kies bedecken den Boden, als habe sich die Zeit selbst hier abgelagert.");
    AddDetail("schritt",
        "Jeder Schritt hallt zwischen den Waenden nach und verliert sich in der Stille.");
    AddDetail("seiten",
        "Zu beiden Seiten steigen die Felsen steil an, als wollten sie den Himmel selbst abschirmen.");
    AddDetail("splittern",
        "Winzige Splitter funkeln im grauen Stein, als hielten sie Reste alten Lichts fest.");
    AddDetail("spur",
        "Eine einzelne Spur zieht sich durch den Staub, frisch genug, um Unruhe zu wecken.");
    AddDetail("staub",
        "Feiner Staub bedeckt das Gestein und loest sich bei jedem Schritt in duennen Schwaden.");
    AddDetail("vergaenglichkeit",
        "In der Vergaenglichkeit dieses Pfades liegt eine eigentuemliche Ruhe, als sei alles bereits geschehen.");
    AddDetail("wispern",
        "Ein leises Wispern schwebt im Wind, zu schwach, um Worte zu bilden, doch vertraut wie Erinnerung.");
    AddDetail("erinnerung",
        "Etwas in der Luft ruft ferne Erinnerung wach.");
    AddDetail("grau",
        "Alles liegt in Grau, weich und grenzenlos.");
    AddDetail("grenze",
        "Keine klare Grenze trennt Erde und Himmel.");
    AddDetail("jahrhunderte",
        "Jahrhunderte haben diesen Stein geformt.");
    AddDetail("kaelte",
        "Die Kaelte kriecht durch den Fels und in deine Haut.");
    AddDetail("kies",
        "Feiner Kies rutscht leise unter deinen Fuessen.");
    AddDetail("knochen",
        "Der Stein wirkt hart und alt wie uralte Knochen.");
    AddDetail("laut",
        "Jeder Laut klingt zu laut in der Stille.");
    AddDetail("moos",
        "Feuchtes Moos klebt an den Schattenseiten der Felsen.");
    AddDetail("nebellicht",
        "Das Nebellicht schimmert bleich und ruhelos.");
    AddDetail("ordnung",
        "Keine Ordnung lenkt die Linien des Gesteins.");
    AddDetail("reste",
        "Zwischen den Ritzen glimmen Reste alten Lichts.");
    AddDetail("ruhe",
        "Ruhe liegt schwer ueber diesem Ort.");
    AddDetail("runen",
        "Die Risse aehneln Runen, die niemand mehr liest.");
    AddDetail("schimmer",
        "Ein schwacher Schimmer tanzt auf dem feuchten Stein.");
    AddDetail("schwaden",
        "Duenne Schwaden aus Staub und Nebel ziehen vorbei.");
    AddDetail("schweigen",
        "Das Schweigen hier ist tiefer als jede Dunkelheit.");
    AddDetail("splitter",
        "Kleine Splitter glitzern im grauen Licht.");
    AddDetail("steinflaeche",
        "Die Steinflaeche ist glatt und kuehl unter der Feuchtigkeit.");
    AddDetail("streifen",
        "Dunkle Streifen ziehen sich ueber den Fels.");
    AddDetail("unruhe",
        "Eine leise Unruhe schwingt im Wind.");
    AddDetail("waenden",
        "Die Waende steigen eng auf und halten das Licht gefangen.");
    AddDetail("wasser",
        "Wasser tropft in gleichmaessigem Rhythmus aus den Rissen.");
    AddDetail("worte",
        "Keine Worte finden hier Halt, sie verwehen im Wind.");
    AddDetail("wuerde",
        "In diesem Stein ruht eine stille Wuerde.");
    AddDetail("zeit",
        "Die Zeit scheint hier stillzustehen.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "suedwesten", ROOM "weg_2" );
    AddExit( "osten", ROOM "weg_4");

//--Items & NPCs-----------------------------------------------------------

}
