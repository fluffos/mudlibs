#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Vor dem Tor der Goldenen Rose");
    SetProp(P_INT_LONG,
    "Zwei gewaltige Felswaende rahmen das Tor der Festung, das direkt in den Berg "
    "hineingehauen wurde. Ueber dem Eingang flattert ein Banner mit einer "
    "goldenen Rose im Wind, das schwach in der grauen Luft leuchtet. Der Boden "
    "vor dem Tor ist glattgetreten, und die Luft traegt den metallischen Duft "
    "von Oel, Stahl und Weihrauch.");





//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("banner",
        "Das Banner zeigt eine goldene Rose, deren Stoff im Wind leise flattert.");
    AddDetail("berg",
        "Der Berg erhebt sich dunkel ueber dem Tor, gewaltig und still.");
    AddDetail("boden",
        "Der Boden ist glattgetreten und glaenzt vom stetigen Wind.");
    AddDetail("duft",
        "Ein feiner Duft nach Uel, Metall und Weihrauch liegt in der Luft.");
    AddDetail("eingang",
        "Der Eingang fuehrt direkt in den Fels und ist von schweren Mauern umrahmt.");
    AddDetail("felswaende",
        "Die Felswaende zu beiden Seiten ragen hoch auf und werfen lange Schatten.");
    AddDetail("festung",
        "Die Festung ist halb in den Berg geschlagen und wirkt uralt, doch unerschuetterlich.");
    AddDetail("himmel",
        "Der Himmel ist blassgrau und traegt das Licht wie kaltes Glas.");
    AddDetail("luft",
        "Die Luft ist kuehl und riecht nach Metall und Stein.");
    AddDetail("rose",
        "Die goldene Rose auf dem Banner schimmert matt im fahlen Licht.");
    AddDetail("stahl",
        "Der Stahl des Tores glaenzt dunkel, von Uel und Regen geglaettet.");
    AddDetail("tor",
        "Das Tor ist hoch und schwer, mit metallenen Verstrebungen und alten Gravuren.");
    AddDetail("weihrauch",
        "Ein Hauch von Weihrauch mischt sich in den Wind, suess und bitter zugleich.");
    AddDetail("wind",
        "Der Wind traegt das Banner sacht hin und her und rauscht zwischen den Felsen.");
    AddDetail("fels",
        "Der Fels um das Tor ist glatt und traegt Spuren von Werkzeugen.");
    AddDetail("glas",
        "Das Licht im Himmel bricht sich wie in truebem Glas.");
    AddDetail("gravuren",
        "Die Gravuren im Tor zeigen Rosenblaetter und alte, verblasste Runen.");
    AddDetail("hauch",
        "Ein Hauch von Waerme liegt im Wind, kaum spuerbar und doch fremd.");
    AddDetail("licht",
        "Das Licht wirkt gedaempft, als wuerde es durch Nebel gefiltert.");
    AddDetail("mauern",
        "Die Mauern um das Tor sind fest und ohne jede Zierde.");
    AddDetail("metall",
        "Das Metall glaenzt dunkel und riecht nach Uel und Regen.");
    AddDetail("regen",
        "Feiner Regen faellt aus dem grauen Himmel und perlt am Stahl des Tores ab.");
    AddDetail("schatten",
        "Die Schatten der Felswaende fallen lang ueber den Eingang.");
    AddDetail("seiten",
        "Zu beiden Seiten des Tores fuehren schmale Pfade entlang der Mauern.");
    AddDetail("stein",
        "Der Stein ist alt und fest, durchzogen von feinen Adern aus Erz.");
    AddDetail("stoff",
        "Der Stoff des Banners ist schwer und traegt Spuren vieler Stuerme.");
    AddDetail("verstrebungen",
        "Die Verstrebungen aus Stahl halten das Tor zusammen und schimmern im Licht.");
    AddDetail("adern",
        "Feine Adern ziehen sich durch den Stein und glitzern schwach im Licht.");
    AddDetail("erz",
        "Spuren von Erz schimmern im Fels, dunkelrot und schwer.");
    AddDetail("nebel",
        "Der Nebel haengt traege ueber dem Tor und daempft jedes Geraeusch.");
    AddDetail("pfade",
        "Die Pfade an den Seiten sind schmal und fuehren entlang der Mauern ins Ungewisse.");
    AddDetail("rosenblaetter",
        "Die Rosenblaetter in den Gravuren wirken lebendig, als bewegte sie der Wind.");
    AddDetail("runen",
        "Die Runen sind alt und fast verwittert, doch ein schwaches Leuchten haftet ihnen an.");
    AddDetail("spuren",
        "Im glatten Boden sind Spuren von Hufen und Stiefeln zu erkennen.");
    AddDetail("stuerme",
        "Viele Stuerme haben hier getobt, doch der Ort wirkt unerschuettert.");
    AddDetail("waerme",
        "Die Waerme im Wind scheint fehl am Platz, wie ein ferner Atem aus dem Inneren der Festung.");
    AddDetail("werkzeugen",
        "Feine Einkerbungen im Fels zeugen von Werkzeugen, die laengst verrostet sind.");
    AddDetail("zierde",
        "Keine Zierde schmueckt das Tor, nur die Rose ueber ihm verleiht ihm Wuerde.");
    AddDetail("atem",
        "Ein warmer Atem scheint aus dem Inneren der Festung zu stroemen.");
    AddDetail("einkerbungen",
        "Die Einkerbungen im Stein sind tief und wirken von Hand geschlagen.");
    AddDetail("geraeusch",
        "Kein Geraeusch dringt aus dem Tor, nur der Wind fuellt die Stille.");
    AddDetail("hufen",
        "Die Spuren der Hufen verlaufen bis direkt vor das Tor und verlieren sich dort.");
    AddDetail("inneren",
        "Aus dem Inneren dringt ein schwacher Glanz, als brenne dort ein verborgenes Feuer.");
    AddDetail("leuchten",
        "Ein zartes Leuchten liegt auf den Runen, kaum sichtbar im grauen Licht.");
    AddDetail("ort",
        "Der Ort wirkt ehrwuerdig und still, als hielte er den Atem der Berge an.");
    AddDetail("platz",
        "Der Platz vor dem Tor ist eben und leer, bereit fuer Ankunft oder Abschied.");
    AddDetail("stiefeln",
        "Zwischen den Spuren sind deutliche Abdruecke schwerer Stiefel zu erkennen.");
    AddDetail("ungewisse",
        "Das Ungewisse hinter dem Tor zieht dich an und floesst zugleich Ehrfurcht ein.");
    AddDetail("wuerde",
        "In der Schlichtheit des Tores liegt eine unerwartete Wuerde.");
    AddDetail("abdruecke",
        "Die Abdruecke im Boden sind tief, als haetten schwere Stiefel sie hinterlassen.");
    AddDetail("abschied",
        "Ein Hauch von Abschied liegt in der Luft, still und unausgesprochen.");
    AddDetail("ankunft",
        "Der Platz vor dem Tor fuehlt sich nach Ankunft an, nach einem Ende und einem Beginn zugleich.");
    AddDetail("ehrfurcht",
        "Ehrfurcht steigt in dir auf, als du das Tor betrachtest.");
    AddDetail("feuer",
        "Hinter den Mauern glimmt das Feuer schwach, wie der Atem eines schlafenden Waechters.");
    AddDetail("glanz",
        "Ein matter Glanz liegt auf Metall und Stein, kaum mehr als ein Nachhall von Licht.");
    AddDetail("hand",
        "Die Hand eines Meisters muss das Tor erschaffen haben, so praezise ist seine Arbeit.");
    AddDetail("schlichtheit",
        "In der Schlichtheit des Bauwerks liegt eine Kraft, die keinen Schmuck braucht.");
    AddDetail("stiefel",
        "Die Stiefelabdruecke fuehren zum Tor und enden dort im glatten Stein.");
    AddDetail("stille",
        "Eine tiefe Stille liegt ueber dem Ort, nur vom Wind durchbrochen.");
    AddDetail("arbeit",
        "Die Arbeit am Tor ist schlicht und makellos.");
    AddDetail("bauwerks",
        "Die Linien des Bauwerks sind klar und ohne Zier.");
    AddDetail("beginn",
        "Ein leiser Beginn liegt in der Luft, wie ein unausgesprochenes Versprechen.");
    AddDetail("ende",
        "Das Ende des Weges fuehlt sich nah an, ruhig und endgueltig.");
    AddDetail("kraft",
        "In der Schwere des Steins ruht stille Kraft.");
    AddDetail("meisters",
        "Die Hand des Meisters zeigt sich in jedem Schnitt des Felses.");
    AddDetail("nachhall",
        "Ein Nachhall von Klang und Licht bleibt zwischen den Mauern zurueck.");
    AddDetail("schmuck",
        "Kein Schmuck ziert das Tor, nur Zweck und Wuerde.");
    AddDetail("stiefelabdruecke",
        "Die Stiefelabdruecke im Staub fuehren direkt bis ans Tor.");
    AddDetail("waechters",
        "Der Atem des Waechters scheint noch im Wind zu liegen.");
    AddDetail("klang",
        "Ein ferner Klang verweilt in der Luft, kaum mehr als Erinnerung.");
    AddDetail("linien",
        "Die Linien im Stein verlaufen gerade und ohne Unterbrechung.");
    AddDetail("schnitt",
        "Jeder Schnitt im Fels ist sauber und mit sicherer Hand gefuehrt.");
    AddDetail("schwere",
        "Die Schwere der Mauern liegt spuerbar in der Luft.");
    AddDetail("staub",
        "Feiner Staub bedeckt den Boden und glitzert im schwachen Licht.");
    AddDetail("versprechen",
        "Ein stilles Versprechen scheint im goldenen Banner zu liegen.");
    AddDetail("weges",
        "Am Ende des Weges wartet das Tor, fest und unbewegt.");
    AddDetail("zier",
        "Keine Zier lenkt vom Tor ab, nur seine Groesse spricht fuer sich.");
    AddDetail("zweck",
        "Alles hier folgt einem klaren Zweck.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "weg_13" );
    AddExit( "osten", ROOM "festung_westtor");

//--Items & NPCs-----------------------------------------------------------

}
