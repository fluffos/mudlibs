#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein steiler Bergpfad");
    SetProp(P_INT_LONG,
        "Der Pfad windet sich steil den Berghang hinauf, gesaeumt von schroffen Felsen "
        "und vereinzelten Kiefern, die dem Wind trotzen. Der Boden ist mit losem "
        "Gestein bedeckt, und die Luft ist klar und frisch. Unten im Tal glitzert ein "
        "weiter Fluss, der sich durch die Landschaft schlaengelt. Der Pfad fuehrt weiter "
        "hinauf zu einer Festung, deren Umrisse gegen den Himmel zeichnen sich.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------
    AddDetail(({"pfad", "bergpfad", "schritt"}),
        "Der Pfad windet sich steil den Hang hinauf und zwingt dich, jeden Schritt genau zu setzen.");
    AddDetail(({"berghang", "hang", "vegetation", "stellen"}),
        "Der Berghang ist steil und felsig, mit nur wenigen Stellen, an denen sich Vegetation halten kann.");
    AddDetail(({"felsen", "gestein", "zaehne", "wetter"}),
        "Die schroffen Felsen ragen wie Zaehne aus dem Boden und sind von Wind und Wetter geglaettet.");
    AddDetail(({"kiefern", "staemme"}),
        "Die vereinzelten Kiefern haben verwundene Staemme und trotzen stoisch dem Wind.");
    AddDetail(({"boden", "tritt"}),
        "Der Boden besteht aus losem Gestein und knirscht bei jedem Tritt.");
    AddDetail(({"luft", "harz", "stein"}),
        "Die Luft ist klar und frisch, leicht nach Harz und kaltem Stein duftend.");
    AddDetail(({"wind", "mantel"}),
        "Der Wind pfeift zwischen den Felsen hindurch und zerrt an deinem Mantel.");
    AddDetail(({"tal", "mosaik", "feldern", "bachlaeufen"}),
        "Das Tal liegt tief unter dir und zeigt ein Mosaik aus Feldern und Bachlaeufen.");
    AddDetail(({"fluss", "sonnenlicht", "silber"}),
        "Der Fluss glitzert im Sonnenlicht wie fluesiges Silber und schlaengelt sich durch die Landschaft.");
    AddDetail(({"landschaft", "waeldern", "gehoeften"}),
        "Die Landschaft unten wechselt zwischen Feldern, Waeldern und verstreuten Gehoeften.");
    AddDetail(({"festung", "umrisse", "gipfel"}),
        "Weit oben zeichnen sich die Umrisse der Festung ab, als wuerden sie direkt in den Himmel wachsen.");
    AddDetail(({"himmel", "schleierwolken"}),
        "Der Himmel ist klar, nur ein paar leichte Schleierwolken treiben Richtung Gipfel.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "nordwestoben", ROOM "festung_osttor" );
    AddExit( "osten", ROOM "ostweg_2" );

//--Items & NPCs-----------------------------------------------------------

}
