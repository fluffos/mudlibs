#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Das Westtor der Festung");
    SetProp(P_INT_LONG,
        "Das gewaltige Tor steht offen und zeigt die Zugbruecke, die ueber den "
        "Abgrund zum Grat fuehrt. Der Wind traegt den Klang der Gebirgsweite herein.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

    AddDetail("abgrund",
        "Der Abgrund klafft schwarz unter der Bruecke.");
    AddDetail("boden",
        "Der Boden ist glattgetreten und leicht feucht.");
    AddDetail("gebirgsweite",
        "Die Gebirgsweite klingt wie fernes Rauschen.");
    AddDetail("grat",
        "Der Grat liegt westlich und verliert sich im Grau.");
    AddDetail("himmel",
        "Der Himmel haengt bleich ueber den Zinnen.");
    AddDetail("klang",
        "Ein heller Klang weht von draussen herein.");
    AddDetail("tor",    
        "Das Tor steht offen und wirkt doch schwer.");
    AddDetail("wind",
        "Der Wind zieht kuehl durch den Durchgang.");
    AddDetail("zugbruecke",
        "Die Zugbruecke spannt sich ueber die Tiefe und schwankt leicht.");
    AddDetail("bruecke",
        "Die Bruecke knarrt leise unter dem Wind.");
    AddDetail("durchgang",
        "Der Durchgang fuehrt von der Zugbruecke in den Hof.");
    AddDetail("grau",
        "Ein bleiches Grau liegt ueber allem wie ein Schleier.");
    AddDetail("rauschen",
        "Das Rauschen des Windes mischt sich mit fernem Donner.");
    AddDetail("tiefe",
        "Die Tiefe unter der Bruecke verschlingt jeden Laut.");
    AddDetail("zinnen",
        "Die Zinnen werfen gezackte Schatten auf das Tor.");
    AddDetail("donner",
        "Ein ferner Donner rollt ueber die Berge hinweg.");
    AddDetail("hof",
        "Hinter dem Tor oeffnet sich der Hof der Festung, gepflastert und still.");
    AddDetail("laut",
        "Kein Laut durchbricht die Luft ausser dem Wind.");
    AddDetail("schatten",
        "Die Schatten der Zinnen tanzen ueber das Tor wie dunkle Finger.");
    AddDetail("schleier",
        "Ein Schleier aus Nebel zieht traege durch den Durchgang.");
    AddDetail("berge",
        "Die Berge ragen im Westen wie dunkle Waechter empor.");
    AddDetail("festung",
        "Die Festung erhebt sich still und maechtig hinter dem Tor.");
    AddDetail(({"finger","schattenfinger"}),
        "Die Schattenfinger kriechen langsam ueber den Stein.");
    AddDetail("luft",
        "Die Luft riecht nach Stein und kaltem Metall.");
    AddDetail("nebel",
        "Nebel schleicht ueber die Bruecke und verschluckt den Blick nach draussen.");
    AddDetail("blick",
        "Der Blick nach draussen verliert sich im dichten Grau.");
    AddDetail("metall",
        "Kaltes Metall zieht feine Linien ueber das Tor und schimmert matt.");
    AddDetail("stein",
        "Der Stein ist alt und glatt vom Wind geschliffen.");
    AddDetail("waechter",
        "Die Berge stehen da wie uralte Waechter der Festung.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "weg_14" );
    AddExit( "osten", ROOM "festung_2");

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "torwache", REFRESH_DESTRUCT);
    AddItem(NPC "torwache", REFRESH_DESTRUCT);
}
