#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein steiler Bergpfad");
    SetProp(P_INT_LONG,
        "Der Bergpfad fuehrt hier an einem Steilhang entlang, gesaeumt von schroffen Felsen "
        "und vereinzeltem Gestruepp. Der Boden besteht aus dem Fels des Berges und ist "
        "einigermassen ausgetreten. Die Luft ist klar und frisch, und der Blick reicht weit "
        "in die Ebene hinab.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------
    AddDetail(({"bergpfad", "berg", "hang", "pfad"}), 
        "Der Bergpfad klebt eng am Steilhang und zwingt dich, den Felsen dicht zu folgen.");
    AddDetail(({"steilhang", "berges", "gestein", "tiefe", "wand"}), 
        "Der Steilhang faellt fast senkrecht in die Tiefe, einer unruhigen Wand aus schimmerndem Gestein.");
    AddDetail(({"felsen", "fels", "passagen", "platz"}), 
        "Schroffe Felsen stemmen sich in den Pfad und bilden schmale Passagen, die kaum Platz lassen.");
    AddDetail(({"gestruepp", "felsritzen", "dornen"}), 
        "Vereinzeltes Gestruepp haelt sich zwischen den Felsritzen und klammert sich mit zackigen Dornen fest.");
    AddDetail(({"boden", "stein", "schritten"}), 
        "Der Boden besteht aus blankem Fels des Berges und ist von vielen Schritten geglaettet.");
    AddDetail(({"blick", "baeche", "silberfaden"}), 
        "Der Blick gleitet weit in die Ebene hinab, wo kleine Baeche wie Silberfaden wirken.");
    AddDetail(({"ebene", "feldern", "waeldern", "teppich"}), 
        "Die Ebene unter dir breitet sich wie ein Teppich aus Feldern und Waeldern aus.");
    AddDetail("himmel", 
        "Der Himmel spannt sich klar ueber dir, als wuerde er den Hang beschuetzen.");
    AddDetail(({"luft", "pflanzenresten"}), 
        "Die Luft ist duenn und riecht nach kaltem Stein und trockenen Pflanzenresten.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "westoben", ROOM "ostweg_3" );
    AddExit( "osten", ROOM "ostweg_5" );

//--Items & NPCs-----------------------------------------------------------

}
