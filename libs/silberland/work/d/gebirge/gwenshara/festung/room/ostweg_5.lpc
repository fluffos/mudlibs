#include "../def.h"

inherit "std/room";

string *prayers;

void create()
{
    ::create();
    prayers = ({ });
//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Eine breite Stelle auf einem Bergpfad");
    SetProp(P_INT_LONG,
        "Der Pfad weitet sich hier zu einer breiten Stelle, die von schroffen Felsen "
        "umgeben ist. Dieser Platz dient wohl zum Ausweichen, falls ein Karren den "
        "Weg passiert. In einer Nische an der Wand ist ein kleiner Schrein eingerichtet, "
        "der von Wanderern gepflegt wird.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------
    AddDetail(({"schrein", "schutzpatron"}),
        "Der kleine Schrein ist Dusty gewidmet ist aus grob behauenen Steinen errichtet und mit "
        "einigen Opfergaben geschmueckt.");
    AddDetail(({"nische", "wand", "stelle"}),
        "In der Nische ist ein kleiner Schrein eingerichtet, der von Wanderern "
        "gepflegt wird und die hier beten.");
    AddDetail(({"opfergaben", "kerzenresten", "steinen", "geschenke"}),
        "Die Opfergaben bestehen aus kleinen Steinen, getrockneten Blumen und "
        "einigen Kerzenresten.");
    AddDetail(({"blumen", "pflanze"}),
        "Es handelt sich offenbar um das seltene Dustyveilchen.");
    AddDetail("dustyveilchen",
        "Das Dustyveilchen ist eine zarte Pflanze, die nur in der Ebene waechst und.");
    AddDetail(({"dusty", "paladine", "ehre", "gerechtigkeit", "mut"}),
        "Dusty ist der Schutzpatron der Paladine und steht fuer Mut, Ehre und Gerechtigkeit.");
    AddDetail(({"pfad", "weg", "sicht"}),
        "Der Pfad verbreitert sich hier etwas, sodass man leichter die Sicht zur Ebene hat.");
    AddDetail(({"platz", "ausweichen", "ausweichstelle"}),
        "Der Platz dient als Ausweichstelle, wenn ein Karren den Weg blockiert.");
    AddDetail(({"boden", "gestein", "staub", "scherben"}),
        "Der Boden besteht aus festgetretenem Gestein, das mit Staub und einigen Scherben bedeckt ist.");
    AddDetail(({"felsen", "risse"}),
        "Die Felsen bilden eine natuergliche Wand, deren Risse den Schrein schuetzen.");
    AddDetail(({"karren", "radspuren", "versorgungskarren"}),
        "Frische Radspuren zeigen, dass hier oft Versorgungskarren anhalten.");
    AddDetail(({"himmel", "band"}),
        "Ueber den Felsen kannst du ein schmales Band Himmel erkennen.");
    AddDetail(({"ebene", "ferne"}),
        "Von diesem Punkt aus siehst du in der Ferne die Ebene, aus der die Dustyveilchen stammen.");
    AddDetail(({"stelle", "punkt"}),
        "Die Stelle ist breit genug, dass zwei Wanderer nebeneinander rasten koennen.");
    AddDetail(({"wanderern", "wanderer"}),
        "Wanderer hinterlassen hier kleine Geschenke, die den Schrein schmuecken.");
//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "ostweg_4" );
    AddExit( "osten", ROOM "ostweg_6" );

//--Items & NPCs-----------------------------------------------------------

    AddItem(NPC "pilger", REFRESH_DESTRUCT);

//--Kommandos---------------------------------------------------------
    AddCmd(({"bete", "bet"}), "cmd_beten");
}

public int cmd_beten(string str)
{
    notify_fail("Wo willst du beten?\n");
    if(str == "" || !str)
        return 0;
    if(str != "vor schrein" && str != "an schrein" && str != "bei schrein")
        return 0;

    write(BS("Du kniest dich vor den Schrein und betest zu Dusty, dem Schutzpatron der Paladine. "
          "Ein warmes Gefuehl durchstroemt dich, und du spuerst, wie deine Sorgen leichter werden."));
    say(BS(this_player()->GetName() + " kniet sich vor den Schrein und betet still.\n"));

    if(member(prayers, getuid(TP)) < 0) {
        prayers += ({ getuid(TP) });
        TP->AddHP(10 + random(10));
        TP->AddSP(10 + random(10));
        TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN) + random(100));
    }

    return 1;
}

public void reset()
{
    ::reset();
    prayers = ({ });
}
