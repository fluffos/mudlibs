#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein stiller Bogen am Suedrand des Hofes");
    SetProp(P_INT_LONG,
        "Zwischen den Steinpfeilern ist es still. Von hier fuehrt ein schmaler Gang zum "
        "Suedturm, und das Klirren von Waffen klingt gedaempft herueber. Eine Spur von "
        "Weihrauch liegt in der Luft.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("bogen",
        "Der Bogen spannt sich leise ueber den Rand des Hofes.");
    AddDetail("suedrand",
        "Am Suedrand liegt der Hof fast schattenstill.");
    AddDetail("hof",
        "Der Hof wirkt hier geschuetzt und ruhig.");
    AddDetail(({"steinpfeiler", "pfeiler"}),
        "Schwere Steinpfeiler halten die Last der Gaenge.");
    AddDetail("gang",
        "Ein schmaler Gang fuehrt geradlinig zum Suedturm.");
    AddDetail("suedturm",
        "Der Suedturm wartet still hinter dem Gang.");
    AddDetail("klirren",
        "Gedaempftes Klirren von Waffen hallt aus der Ferne.");
    AddDetail("waffen",
        "Die Waffen scheinen nie ganz zur Ruhe zu kommen.");
    AddDetail("spur",
        "Eine feine Spur aus Weihrauch schwebt in der Luft.");
    AddDetail("weihrauch",
        "Weihrauch legt sich wie warmer Hauch auf den Stein.");
    AddDetail("luft",
        "Die Luft ist klar und von stiller Andacht erfuellt.");
    AddDetail("andacht",
        "Eine stille Andacht liegt wie ein hauchdunner Schleier ueber allem.");
    AddDetail("boden",
        "Glattgetretene Steinplatten, kuehl und dicht, trinken jedes Geraeusch.");
    AddDetail("ferne",
        "Aus der Ferne dringt gedaempftes Klirren und verliert sich im Hof.");
    AddDetail("gaenge",
        "Die Gaenge liegen schwer ueber den Pfeilern und verschwinden im Halbdunkel.");
    AddDetail("hauch",
        "Ein warmer Hauch von Weihrauch streicht kaum spuerbar durch die Luft.");
    AddDetail("himmel",
        "Der Himmel ueber dem Hof wirkt fahl und hoch, im kuehlen Berglicht.");
    AddDetail("last",
        "Eine unsichtbare Last aus Stein und Schweigen macht die Stimmen leiser.");
    AddDetail("ruhe",
        "Die Ruhe sammelt sich in den Schatten und daempft jeden Schritt.");
    AddDetail("stein",
        "Alter, rauer Stein mit kuehler Haut und feinem Staub haftet ueberall.");
    AddDetail("berglicht",
        "Bleiches Berglicht faellt klar herab und schaerft die Konturen.");
    AddDetail("geraeusch",
        "Jedes Geraeusch wird hier leiser und versickert im Hof.");
    AddDetail("geraeusche",
        "Selbst Geraeusche verlieren sich leise zwischen den Pfeilern.");
    AddDetail("halbdunkel",
        "Im Halbdunkel verlieren die Gaenge ihre Schaerfe und werden zu Schatten.");
    AddDetail("dunkel",
        "Dunkel sammelt sich zwischen den Pfeilern und wacht still.");
    AddDetail("haut",
        "Auf der kuehlen Haut des Steins liegt feiner Staub.");
    AddDetail("steinhaut",
        "Die Steinhaut ist kuehl und von feinem Staub gepudert.");
    AddDetail("schatten",
        "Schatten sammeln sich in den Winkeln und atmen langsam.");
    AddDetail("schleier",
        "Ein feiner Schleier aus Weihrauch und Ruhe liegt ueber dem Ort.");
    AddDetail("schritt",
        "Jeder Schritt klingt kurz an und wird sogleich verschluckt.");
    AddDetail("schritte",
        "Schritte klingen kurz an und vergehen im Stein.");
    AddDetail("tritt",
        "Ein Tritt hallt kaum nach, als muesse er sich beugen.");
    AddDetail("tritte",
        "Tritte werden weich und verlieren ihre Schaerfe.");
    AddDetail("schweigen",
        "Altes Schweigen haelt die Mauern und spannt sie ruhig.");
    AddDetail("stille",
        "Stille liegt schwer ueber Hof und Gaengen.");
    AddDetail("staub",
        "Feiner Staub tanzt im Licht, waehrend die Luft kaum sich regt.");
    AddDetail("steinplatten",
        "Breite, glattgetretene Steinplatten tragen die Last gelassen.");
    AddDetail(({"platten","bodenplatten"}),
        "Breite, glattgetretene Steinplatten tragen die Last gelassen.");
    AddDetail("stimmen",
        "Selbst Stimmen klingen geduckt, als spraechen sie gegen die Mauern.");
    AddDetail("atem",
        "Ein angehaltener Atem liegt ueber Hof und Gaengen.");
    AddDetail("festung",
        "Die Festung ruht schwer am Berg und schweigt.");
    AddDetail("linien",
        "Feine Linien ziehen ueber den Stein wie stilles Schriftwerk.");
    AddDetail("schattensaum",
        "Am Schattensaum werden Formen weich und Stimmen geduckt.");
    AddDetail("berg",
        "Der Berg haelt die Festung nah und spendet Kuehle.");
    AddDetail("kanten",
        "Scharfe Kanten zeichnen Stein und Schattensaum im Berglicht.");
    AddDetail("konturen",
        "Im klaren Berglicht treten Konturen hart und ruhig hervor.");
    AddDetail("kuehle",
        "Trockene Kuehle liegt auf Stein und Luft.");
    AddDetail("ort",
        "Der Ort wirkt gesammelt, als hielte er den Atem an.");
    AddDetail("risse",
        "Feine Risse durchziehen den Stein wie alte Linien.");
    AddDetail("schaerfe",
        "Die Schaerfe der Linien schwindet im Halbdunkel.");
    AddDetail(({"winkel","winkeln"}),
        "In den Winkeln verdichten sich Schatten und Schweigen.");
    AddDetail("stimme",
        "Eine einzelne Stimme klingt geduckt, als fuerchte sie die Mauern.");
    AddDetail(({"mauer","mauern"}),
        "Alte Mauern tragen das Schweigen und halten die Kuehle.");
    AddDetail("gewicht",
        "Das Gewicht des Steins haelt alles geduckt und ruhig.");
    AddDetail("gewoelbe",
        "Das Gewoelbe spannt sich ruhig und sammelt die Kuehle.");
    AddDetail("weite",
        "Die Weite dahinter klingt wie eine ferne Verheissung.");
    AddDetail(({"korridor","korridore"}),
        "Schmale Korridore ziehen am Suedrand entlang, still und geradlinig.");
    AddDetail("firmament",
        "Das Firmament liegt fahl ueber dem Hof und bleibt fern.");
    AddDetail("fels",
        "Roher Fels schimmert grau im Mauerwerk und bleibt kalt.");
    AddDetail("licht",
        "Klares Licht vom Berg betont Kanten und feine Risse.");
    AddDetail("luftzug",
        "Ein kaum merklicher Luftzug traegt den Weihrauch weiter.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "norden", ROOM "festung_5" );
    AddExit( "osten", ROOM "festung_8");
    AddExit( "westen", ROOM "festung_3");
    AddExit( "nordwesten", ROOM "festung_2");
    AddExit( "sueden", ROOM "festung_suedturm");

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "paladin_dame_myra", REFRESH_DESTRUCT);
}
