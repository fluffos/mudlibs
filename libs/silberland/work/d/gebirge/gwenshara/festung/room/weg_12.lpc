#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein heller Kamm aus grauem Fels");
    SetProp(P_INT_LONG,
    "Der Grat verbreitert sich zu einem hellen Kamm, von dem man das Tal kaum "
    "noch sehen kann. Das Gestein hier ist glatt und schimmert matt im Wind. "
    "In der Ferne erkennst du Zinnen aus Stein, und der Klang von Metall traegt "
    "sich ueber die Boeen heran.");




//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("boden",
        "Der Boden ist fest und glatt, vom Wind blank geschliffen.");
    AddDetail("boeen",
        "Starke Boeen fegen ueber den Kamm und zerren an deiner Kleidung.");
    AddDetail("ferne",
        "In der Ferne verschwimmen Himmel und Gebirge zu einem blassen Grau.");
    AddDetail("gestein",
        "Das Gestein ist hell und fein geschichtet, von winzigen Rissen durchzogen.");
    AddDetail("grat",
        "Der Grat weitet sich hier zu einem sicheren, aber windigen Pfad.");
    AddDetail("himmel",
        "Der Himmel spannt sich weit ueber dir, lichtdurchzogen und klar.");
    AddDetail("kamm",
        "Der Kamm besteht aus hellgrauem Fels, glatt und kuehl unter deiner Hand.");
    AddDetail("klang",
        "Ein heller Klang aus der Ferne traegt sich ueber den Wind, metallisch und rein.");
    AddDetail("metall",
        "Das Metall klingt, als schluege jemand gegen eine grosse Glocke oder Ruestung.");
    AddDetail("stein",
        "Der Stein ist hell und schimmert matt im wechselnden Licht.");
    AddDetail("tal",
        "Das Tal liegt weit unter dir, verborgen unter einer Decke aus Nebel.");
    AddDetail("wind",
        "Der Wind weht stetig und traegt den Duft von Frost und Ferne.");
    AddDetail("zinnen",
        "Die Zinnen ragen aus dem Nebel wie Zaehne aus grauem Stein, fest und unbeweglich.");
    AddDetail("decke",
        "Eine dichte Decke aus Nebel liegt ueber dem Tal und bewegt sich kaum.");
    AddDetail("duft",
        "Ein kuehler Duft nach Stein und Frost weht mit dem Wind herauf.");
    AddDetail("fels",
        "Der Fels ist hell und glatt, als haette ihn das Licht selbst geformt.");
    AddDetail("frost",
        "Feiner Frost glitzert auf dem Stein und schmilzt in der Sonne.");
    AddDetail("gebirge",
        "Das Gebirge breitet sich endlos aus, still und ehrfurchtgebietend.");
    AddDetail("glocke",
        "Der Klang erinnert an eine ferne Glocke, hell und getragen vom Wind.");
    AddDetail("grau",
        "Ein zartes Grau ueberzieht Himmel und Stein, weich und gleichmaessig.");
    AddDetail("hand",
        "Deine Hand gleitet ueber das Gestein und spuert seine kuehle Glaette.");
    AddDetail("kleidung",
        "Deine Kleidung flattert im Wind und schlaegt gegen deine Beine.");
    AddDetail("licht",
        "Das Licht bricht sich im Nebel und legt silberne Schleier ueber den Fels.");
    AddDetail("nebel",
        "Der Nebel zieht langsam ueber den Grat und schimmert im Licht.");
    AddDetail("pfad",
        "Der Pfad folgt dem Kamm, klar erkennbar und von Wind geglaettet.");
    AddDetail("rissen",
        "Feine Risse durchziehen den Fels und glitzern im Licht.");
    AddDetail("ruestung",
        "Das ferne Metall klingt, als traefe Ruestung auf Stein.");
    AddDetail("zaehne",
        "Die Zinnen erinnern an Zaehne, alt und unbeweglich im Nebel.");
    AddDetail("beine",
        "Der Wind streift deine Beine und traegt die Kaelte mit sich.");
    AddDetail("glaette",
        "Die Glaette des Felses laesst deine Finger leicht darueber gleiten.");
    AddDetail("risse",
        "Die Risse im Stein wirken alt, als haetten sie Jahrhunderte ueberdauert.");
    AddDetail("schleier",
        "Ein feiner Schleier aus Licht und Nebel liegt ueber dem Grat.");
    AddDetail("sonne",
        "Die Sonne bricht schwach durch die Wolken und laesst das Gestein silbern leuchten.");
    AddDetail("finger",
        "Deine Finger fuehlen den Felses, kalt und glatt zugleich.");
    AddDetail("jahrhunderte",
        "Der Fels traegt die Spuren von Jahrhunderten aus Wind und Frost.");
    AddDetail("kaelte",
        "Die Kaelte ist schneidend, doch klar und belebend.");
    AddDetail("wolken",
        "Hohe Wolken ziehen langsam dahin und brechen das Licht.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "weg_11" );
    AddExit( "osten", ROOM "weg_13");

//--Items & NPCs-----------------------------------------------------------

}
