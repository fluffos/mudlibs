#include "../def.h"

inherit "std/room";

void create()
{
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Der untere Boden der Schlucht");
    SetProp(P_INT_LONG,
    "Du stehst auf dem feuchten Grund einer engen Schlucht. Nebel zieht in "
    "schweren Schwaden zwischen den Felswaenden, und von oben tropft Wasser "
    "auf den kuehlen Stein. Nach Norden hin steigt ein Pfad steil an.");



//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail(({"waende", "waenden", "felswaende", "felswaenden"}),
        "Nebel sammelt sich hier in schweren Schaden und verdeckt die Felswaende fast ganz.");
    AddDetail("schwaden",
        "Die Schwaden sind dick und schwer. Sie ziehen sich bis zur Oberkante der Felswand.");
    AddDetail(({"kante", "oberkante"}),
        "Sie ist kaum zu erkennen. Doch halt da! Da ist ein dunkler Fleck an der Fleswand.");
    AddDetail(({"fleck"}),
        "Sieht aus wie ein Hoehleneingang.");
    AddDetail(({"eingang", "hoehleneingang"}),
        "Dunkel droht er ueber dir. Mit etwas Geschick kannst du dort hinklettern.");
    AddDetail("geschick",
        "Du siehst gerade so geschickt genug aus.");
        AddDetail("boden",
        "Der Boden ist glatt und feucht, von Tropfen und Nebel ueberzogen.");
    AddDetail("schlucht",
        "Die Schlucht ist eng und dunkel, das Wasser gluckert leise zwischen den Steinen.");
    AddDetail("nebel",
        "Der Nebel haengt dicht und bewegt sich nur, wenn der Wind durch die Spalten faehrt.");
    AddDetail("felswaende",
        "Die Felswaende glaenzen nass, und feine Rinnsale ziehen helle Streifen ueber das Gestein.");
    AddDetail("wasser",
        "Von oben tropft Wasser stetig herab und sammelt sich in kleinen Pfuetzen.");
    AddDetail("stein",
        "Der Stein ist kuehl und glatt, mit feinen Rissen, aus denen Feuchtigkeit sickert.");
    AddDetail("pfad",
        "Ein steiler Pfad fuehrt nach Norden hinauf, glitschig und unregelmaessig.");
    AddDetail("wind",
        "Ein kalter Wind faehrt durch die Schlucht und traegt den Geruch von nassem Fels.");
    AddDetail("spalten",
        "Die Spalten in der Wand wirken tief und dunkel, als fuehrten sie in verborgenes Gestein.");
    AddDetail("rinnsale",
        "Feine Rinnsale schimmern im Nebellicht und laufen ueber den Fels.");
    AddDetail("pfuetzen",
        "Kleine Pfuetzen glitzern auf dem Boden und zittern bei jedem Windstoss.");
    AddDetail("licht",
        "Nur ein blasser Schimmer dringt von oben herab, kaum genug, um den Boden zu erkennen.");
    AddDetail("geruch",
        "Ein schwerer Geruch nach feuchtem Stein und Erde liegt in der Luft.");
    AddDetail("luft",
        "Die Luft ist kuehl und still, nur das Tropfen durchbricht die Stille.");
    AddDetail("stille",
        "Eine tiefe Stille liegt ueber der Schlucht, schwer wie der Nebel selbst.");
    AddDetail("hoehleneingang",
        "Der dunkle Hoehleneingang ueber dir wirkt wie ein gaehnendes Maul im Fels.");
    AddDetail("felswand",
        "Die Felswand ist hoch und glatt, doch in der Mitte ist der Hoehleneingang zu erkennen.");
    AddDetail("geschick",
        "Mit etwas Geschick koenntest du an den feuchten Vorspruengen emporklettern.");
        AddDetail("erde",
        "Feuchte Erde mischt sich mit kleinen Steinbrocken und sammelt sich in den Ritzen.");
    AddDetail("fels",
        "Der Fels ist dunkel und schwer, vom staendigen Wasser glatt gewaschen.");
    AddDetail("feuchtigkeit",
        "Feuchtigkeit perlt ueberall an den Waenden herab und sammelt sich im Boden.");
    AddDetail("fleswand",
        "Die Felswand ist hoch und glatt, ihr Stein glaenzt vom Wasser.");
    AddDetail("gestein",
        "Das Gestein wirkt alt und poroes, durchzogen von feinen Linien.");
    AddDetail("grund",
        "Der Grund ist weich und kalt, getraenkt vom Tropfwasser.");
    AddDetail("himmel",
        "Ein schmaler Streifen Himmel ist weit oben zu sehen, grau und unbewegt.");
    AddDetail("maul",
        "Das Maul der Hoehle wirkt finster und abweisend, als wuerde es dich mustern.");
    AddDetail("mitte",
        "In der Mitte der Wand schimmert der dunkle Fleck des Eingangs.");
    AddDetail("nebellicht",
        "Das Nebellicht flackert schwach auf dem nassen Fels.");
    AddDetail("rissen",
        "Die Risse verlaufen schraeg ueber den Stein und fuehren das Wasser nach unten.");
    AddDetail("schaden",
        "Die Schaeden im Fels stammen von altem Wasserlauf und Frost.");
    AddDetail("streifen",
        "Helle Streifen ziehen sich wie Adern ueber den dunklen Stein.");
    AddDetail("tropfen",
        "Einzelne Tropfen fallen regelmaessig und hallen durch die Schlucht.");
    AddDetail("wand",
        "Die Wand ist glatt und nass, mit dunklen Schatten in ihren Vertiefungen.");
    AddDetail("windstoss",
        "Ein Windstoss faehrt durch die Enge und laesst den Nebel erzittern.");
    AddDetail("adern",
        "Feine Adern durchziehen den Fels und glaenzen im feuchten Licht.");
    AddDetail("enge",
        "Die Enge der Schlucht laesst jeden Laut laut und nah erscheinen.");
    AddDetail("frost",
        "Alter Frost hat den Stein gesprengt und kleine Risse hinterlassen.");
    AddDetail("hoehlе",
        "Die Hoehle ueber dir wirkt still und dunkel, als wuerde sie auf dich warten.");
    AddDetail("linien",
        "Feine Linien folgen dem Verlauf des Gesteins und wirken fast geordnet.");
    AddDetail("risse",
        "Die Risse sind schmal und tief, mit dunklem Wasser gefuellt.");
    AddDetail("ritzen",
        "In den Ritzen sammelt sich Feuchtigkeit und bildet winzige Tropfen.");
    AddDetail("schaeden",
        "Kleine Schaeden im Gestein erzaehlen von der Gewalt des Wassers und der Zeit.");
    AddDetail("schatten",
        "Schatten flackern ueber die Felsen, wenn das Nebellicht sich bewegt.");
    AddDetail("steinbrocken",
        "Lose Steinbrocken liegen verstreut auf dem Boden und glaenzen nass.");
    AddDetail("tropfwasser",
        "Tropfwasser rinnt in feinen Bahnen ueber den Fels und hallt leise.");
    AddDetail("vertiefungen",
        "Die Vertiefungen in der Wand sind glatt und mit Wasser gefuellt.");
    AddDetail(({"vorspruengen","vorspruenge"}),
        "Kleine Vorspruenge im Fels bieten gerade genug Halt zum Klettern.");
    AddDetail("wasserlauf",
        "Ein schwacher Wasserlauf zieht sich wie eine Spur durch den feuchten Boden.");



//--Ausgaenge--------------------------------------------------------------

    AddExit( "nordwestoben", ROOM "weg_5" );
    AddExit( "nordosten", ROOM "weg_7");

//--Items & NPCs-----------------------------------------------------------

//--Commands---------------------------------------------------------------
    AddCmd("kletter|klettere&hoch|rauf|zu eingang|zum eingang", "cmd_klettern", "Wohin willst du klettern?");
}

public int cmd_klettern() {
    write(BS("Geschickt kletterst du die Felswand empor zum Hoehleneingang."));
    say(BS(TPN+" klettert geschickt die Felswand empor."));
    TP->move(ROOM "hoehle", M_SILENT|M_GO);
    return 1;
}
