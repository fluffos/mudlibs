#include "../def.h"

inherit "std/room";

void create()
{
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein noerdlicher Uebungsplatz im Hof");
    SetProp(P_INT_LONG,
        "Hier trainieren die Juengeren unter Aufsicht der Ritter. Im festgetretenen "
        "Sand sind Schwertkerben und Fussspuren zu sehen, und ein hoelzernes Podest "
        "traegt Uebungspuppen in verschiedenen Ruestungen. Aus dem Norden zieht kalte "
        "Luft zwischen den Felswaenden hindurch.");



//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

    AddDetail("aufsicht",
        "Die Aufsicht der Ritter ist streng und aufmerksam.");
    AddDetail("boden",
        "Der Boden ist festgetreten und von Schritten gezeichnet.");
    AddDetail("felswaenden",
        "Die Felswaenden werfen kuehle Schatten ueber den Platz.");
    AddDetail("fussspuren",
        "Ueberall sind Fussspuren, manche tief und frisch.");
    AddDetail("himmel",
        "Der Himmel ueber dem Hof ist blass und windig.");
    AddDetail("juengeren",
        "Die Juengeren schwitzen und stolpern, noch nicht kampferprobt.");
    AddDetail("luft",
        "Kalte Luft zieht vom Norden herein.");
    AddDetail("norden",
        "Der Norden bringt kuehle Winde in den Hof.");
    AddDetail("podest",
        "Das Podest ist aus grobem Holz gezimmert und steht fest im Sand.");
    AddDetail("ritter",
        "Die Ritter beobachten streng und greifen nur selten ein.");
    AddDetail("ruestungen",
        "Die Ruestungen der Puppen sind verbeult und voller Kerben.");
    AddDetail("sand",
        "Feiner, heller Sand bedeckt den Platz.");
    AddDetail("schwertkerben",
        "Tiefe Schwertkerben durchziehen den Boden wie alte Narben.");
    AddDetail("hof",
        "Der Hof oeffnet sich weit nach Sueden und wirkt belebt.");
    AddDetail("holz",
        "Das Holz des Podests ist rau und wettergegerbt.");
    AddDetail("kerben",
        "Die Kerben sind tief und sprechen von hartem Training.");
    AddDetail("narben",
        "Wie Narben ziehen sich die Kerben durch den Sand.");
    AddDetail(({"platz", "uebungsplatz"}),
        "Der Platz ist offen und von Felswaenden eingerahmt.");
    AddDetail(({"puppen", "uebungspuppen"}),
        "Die Puppen tragen alte, verbeulte Ruestungen.");
    AddDetail("schatten",
        "Die Schatten der Felswaende liegen lang und kuhl ueber dem Platz.");
    AddDetail("schritten",
        "Die Spuren unzaehliger Schritten haben den Boden geglaettet.");
    AddDetail("felswaende",
        "Die Felswaende ragen hoch und schuetzen den Platz vor dem Wind.");
    AddDetail("spuren",
        "Ueberall finden sich Spuren intensiven Trainings.");
    AddDetail("training",
        "Das Training ist hart und unerbittlich, wie es hier seit Generationen ist.");
    AddDetail("generationen",
        "Seit Generationen wird hier gekaempft und gelernt.");
    AddDetail("wind",
        "Der Wind traegt kalte Luft vom Norden ueber den Platz.");



//--Ausgaenge--------------------------------------------------------------

    AddExit( "osten", ROOM "festung_4" );
    AddExit( "sueden", ROOM "festung_2");
    AddExit( "suedosten", ROOM "festung_5");

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "pagen_der_rose", REFRESH_DESTRUCT);
    AddItem(NPC "pagen_der_rose", REFRESH_DESTRUCT);

//--Commands---------------------------------------------------------------
    AddCmd("uebe|ueb|trainiere|trainier&an|mit|puppe|uebungspuppe|puppen|uebungspuppen", "cmd_ueben", "Woran willst du ueben?");
}

public int cmd_ueben() {
    write(BS("Du fuehrst ein paar harte Schlage gegen eine Uebungspuppe, stellst aber fest, dass du schon zu gut dafuer bist."));
    say(BS(TPN+" fuehrt ein paar harte Schlaege gegen eine der Uebungspuppen."));
    return 1;
}
