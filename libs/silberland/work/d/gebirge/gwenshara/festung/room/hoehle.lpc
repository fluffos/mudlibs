#include "../def.h"

inherit "std/room";

int kiste;

void create()
{
    ::create();
    kiste = 1;

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Eine dreckige Trollhoehle");
    SetProp(P_INT_LONG,
    "Du stehst hier mitten in einer dreckigen Hoehle. An den Waenden tuermen "
    "sich kleine Knochenhaufen. Weiter hinten ist ein verdrecktes Schlaflager "
    "und ein grosser Kochtopf blubbert vor dir.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

    AddDetail("boden", "Der Boden besteht aus festgetretener Erde und Fels.");

    AddDetail("erde", "Ein kleiner Erdhaufen faellt dir besonders auf.");

    AddDetail(({"erdhaufen", "haufen"}), 
        "Es sieht aus als haette hier jemand frisch umgegraben.");

    AddDetail("fels",
        "Der Fels ist feucht und von Russ geschwaerzt.");
    AddDetail("decke", "Massiver Fels. Gut.");
    AddDetail("himmel",
        "Vom Himmel ist hier nichts zu sehen, nur dunkles Gestein ueber dir.");
    AddDetail("hoehlе",
        "Die Hoehle riecht nach altem Rauch und nasser Erde.");
    AddDetail(({"knochenhaufen","knochen"}),
        "Zwischen den Knochenhaufen glaenzen alte Splitter und braeunliche Flecken.");
    AddDetail("kochtopf",
        "Der Kochtopf blubbert traege vor sich hin, ein Gestank nach Fett und altem Fleisch steigt auf.");
    AddDetail("schlaflager",
        "Das Schlaflager besteht aus zerfetzten Fellen und stinkendem Heu.");
    AddDetail("waenden",
        "Die Waende sind feucht und uneben, ueberzogen mit Schlieren aus Dreck und Rauch.");
        AddDetail("dreck",
        "Der Dreck liegt dick auf allem und riecht nach Moder.");
    AddDetail("fellen",
        "Die Felle sind zerrissen und von dunklen Flecken uebersaet.");
    AddDetail("fett",
        "Verkrustetes Fett glaenzt in den Ritzen des Kochtopfs.");
    AddDetail("flecken",
        "Dunkle Flecken ziehen sich ueber den Boden und trocknen langsam ein.");
    AddDetail("fleisch",
        "Reste von Fleisch kleben an den Topfraendern und dampfen leicht.");
    AddDetail("gestank",
        "Ein schwerer Gestank haengt in der Luft und brennt in der Nase.");
    AddDetail("gestein",
        "Das Gestein ist rau und mit Russ ueberzogen.");
    AddDetail("heu",
        "Das Heu ist feucht und schimmelt an den Raendern.");
    AddDetail("hoehlе",
        "Die Hoehle ist niedrig und drueckt schwer auf deine Schultern.");
    AddDetail("rauch",
        "Rauchschwaden haengen unter der Decke und ziehen langsam hinaus.");
    AddDetail("russ",
        "Schwarzer Russ hat sich auf Stein und Knochen gelegt.");
    AddDetail("schlieren",
        "Schlieren aus Fett und Schmutz laufen ueber die Waende.");
    AddDetail("splitter",
        "Knochensplitter liegen verstreut zwischen den Haufen.");
    AddDetail("waende",
        "Die Waende sind uneben und klebrig vor Schmutz.");
        AddDetail("felle",
        "Die Felle sind hart und verfilzt, kaum noch als Decken zu gebrauchen.");
    AddDetail("hoehlе",
        "Die Hoehle ist eng und drueckend, als wollte sie dich verschlingen.");
    AddDetail("luft",
        "Die Luft ist dick und warm, erfuellt von Rauch und Gestank.");
    AddDetail("moder",
        "Ein suesslicher Modergeruch steigt vom Boden auf.");
    AddDetail("nase",
        "Der beissende Gestank steigt dir scharf in die Nase.");
    AddDetail("raendern",
        "An den Raendern des Lagers klebt altes, verfaerbtes Heu.");
    AddDetail("ritzen",
        "Zwischen den Ritzen des Felsens hat sich Fett und Asche gesammelt.");
    AddDetail("schmutz",
        "Schmutz klebt ueberall, als waere die Hoehle selbst lebendig.");
    AddDetail("stein",
        "Der Stein ist rau und schmierig von Russ und Dreck.");
    AddDetail("topfraendern",
        "An den Topfraendern haengen klebrige Reste, die unheilvoll dampfen.");
    AddDetail("asche",
        "Feine Asche liegt in grauen Haeufchen zwischen den Steinen.");
    AddDetail("felsens",
        "Der Felsensockel ist rau und von Kratzspuren ueberzogen.");
    AddDetail("hoehlе",
        "Die Hoehle hallt dumpf von jedem Geraeusch wider.");
    AddDetail("lagers",
        "Am Rand des Lagers stapeln sich alte Felle und Knochenreste.");
    AddDetail("modergeruch",
        "Der Modergeruch ist ueberall und beisst dir in die Nase.");
    AddDetail("reste",
        "Reste vergangener Mahlzeiten liegen zerstreut auf dem Boden.");
    AddDetail("felsensockel",
        "Der Felsensockel ist uneben und glaenzt feucht im flackernden Licht.");
    AddDetail("haeufchen",
        "Kleine Haeufchen aus Asche und Dreck liegen verstreut auf dem Boden.");
    AddDetail("hoehlе",
        "Die Hoehle wirkt lebendig, als wuerde sie atmen und lauschen.");
    AddDetail("knochenreste",
        "Knochenreste liegen in den Schatten, halb im Schmutz vergraben.");
    AddDetail("kratzspuren",
        "Tiefe Kratzspuren ziehen sich ueber den Fels, roh und unruhig.");
    AddDetail("mahlzeiten",
        "Von vergangenen Mahlzeiten zeugen nur Fettspuren und schmutzige Knochen.");
    AddDetail("rand",
        "Am Rand der Hoehle stapeln sich Geroell und alte Abfaelle.");
    AddDetail("abfaelle",
        "Alte Abfaelle liegen in fauligen Haufen am Rand der Hoehle.");
    AddDetail("fettspuren",
        "Fettspuren glaenzen schmutzig im schwachen Licht des Feuers.");
    AddDetail("geroell",
        "Geroell und Staub haben sich in den Ecken der Hoehle gesammelt.");
    AddDetail("hoehlе",
        "Die Hoehle ist daemmrig, nur das Feuer wirft flackerndes Licht an die Waende.");
    AddDetail("licht",
        "Das Licht tanzt unruhig ueber die feuchten Steine.");
    AddDetail("schatten",
        "Schatten huschen ueber die Waende, als wuerden sie sich bewegen.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "unten", ROOM "weg_6" );

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "hohlentroll", REFRESH_DESTRUCT);

//--Commands---------------------------------------------------------------
    AddCmd("grab|grabe|buddel|buddle&in&erde|haufen|erdhaufen", "cmd_graben", "Worin willst du graben?");
}

public int cmd_graben() {
    object ob;

    if(!present("schaufel", TP)) {
        write(BS("Ohne Grubengrabgeraet wird das eher nichts."));
        return -1;
    }

    if(present("\ndreckstroll"))  {
        write(BS("Der Troll bruellt dich an: HE!!! LASS MEIN SCHATZ!!!"));
        return -1;
    }

    write(BS("Du graebst im Erdhaufen und..."));
    say(BS(TPN+" graebt in der Erde herum."));
    if(!kiste) {
        write(BS("... findest nichts?! Da war wohl jemand schneller."));
    } else {
        write(BS("... foerderst ein altes Schwert zu Tage."));
        ob = clone_object(WEAPON "heldenschwert");
        ob->move(TO, M_NOCHECK);
        kiste = 0;
    }
    return 1;
}