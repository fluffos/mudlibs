#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Eine aufsteigende Felsstufe");
    SetProp(P_INT_LONG,
    "Der Pfad steigt steil an, ueber glatte Stufen aus schimmerndem Stein. "
    "Zwischen den Nebelschwaden glueht im Osten ein silbriges Licht, das dich "
    "weiter zum Grat zu locken scheint.");



//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("boden",
        "Der Boden ist glatt und kalt, feucht vom Nebel.");
    AddDetail("grat",
        "Der Grat ueber dir zeichnet sich schemenhaft im aufhellenden Licht ab.");
    AddDetail("himmel",
        "Der Himmel im Osten glimmt silbern, als wuerde er sich oeffnen.");
    AddDetail("licht",
        "Das Licht im Osten scheint lebendig und zieht deinen Blick an.");
    AddDetail("nebelschwaden",
        "Die Nebelschwaden wallen traege den Hang hinauf und brechen im Licht.");
    AddDetail("pfad",
        "Der Pfad steigt steil an und wirkt wie in das Gestein hineingeschnitten.");
    AddDetail("stein",
        "Der Stein ist glatt und schimmert, als truege er einen Hauch von Frost.");
    AddDetail("stufen",
        "Die Stufen sind unregelmaessig und rutschig, aber fest im Fels verwurzelt.");
    AddDetail("blick",
        "Dein Blick folgt dem Licht nach Osten und verliert sich im Nebel.");
    AddDetail("fels",
        "Der Fels ist glatt und fest, doch von feinen Rissen durchzogen.");
    AddDetail("frost",
        "Ein Hauch von Frost liegt auf dem Stein und glitzert im Licht.");
    AddDetail("gestein",
        "Das Gestein wirkt alt und schimmert, als truege es eigenes Leuchten.");
    AddDetail("hang",
        "Der Hang steigt steil an und verschwindet im aufbrechenden Licht.");
    AddDetail("hauch",
        "Ein feiner Hauch von Kaelte streift ueber deine Haut.");
    AddDetail("nebel",
        "Der Nebel reisst in Schleiern auf und gibt den Blick auf den Grat frei.");
    AddDetail("haut",
        "Die Kaelte legt sich wie ein duenner Film auf deine Haut.");
    AddDetail("kaelte",
        "Die Kaelte beisst sanft und macht die Luft glasklar.");
    AddDetail("leuchten",
        "Ein zartes Leuchten zieht sich ueber das Gestein, fluechtig wie Atem.");
    AddDetail("rissen",
        "Die Risse im Fels glitzern, als leuchte etwas darunter.");
    AddDetail("schleiern",
        "Zwischen den Schleiern des Nebels schimmert der Grat in silbernem Licht.");
    AddDetail("atem",
        "Dein Atem bildet kleine Wolken, die sich rasch im Wind verlieren.");
    AddDetail("film",
        "Ein feiner Film aus Feuchtigkeit liegt ueber dem Stein.");
    AddDetail("luft",
        "Die Luft ist klar und still, nur das Licht scheint sich zu bewegen.");
    AddDetail("risse",
        "Die Risse sind schmal und funkeln, als waere Frost darin gefangen.");
    AddDetail("feuchtigkeit",
        "Die Feuchtigkeit haengt in der Luft und laesst den Stein matt glaenzen.");
    AddDetail("wind",
        "Ein leiser Wind streicht ueber den Grat und traegt den Nebel davon.");
    AddDetail("wolken",
        "Hohe Wolken treiben ueber den Himmel und gluehen im fahlen Licht.");



//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "weg_8" );
    AddExit( "osten", ROOM "weg_10");

//--Items & NPCs-----------------------------------------------------------

}
