#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein ueberdachter Bogen im westlichen Hof");
    SetProp(P_INT_LONG,
        "Ein breiter Torbogen fuehrt hier hinaus zur Zugbruecke. Der Boden ist glatt "
        "getreten, und an den Pfeilern haengen Gebetsbaender, die im Wind flattern. "
        "Paladine kommen und gehen, ihre Stimmen mischen sich mit dem Klang von Stahl.");




//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

    AddDetail("boden",
        "Der Boden ist glattgetreten und leicht poliert vom steten Schritt.");
    AddDetail("gebetsbaender",
        "Die Gebetsbaender flattern leise und tragen verwitterte Zeichen.");
    AddDetail("himmel",
        "Zwischen den Mauern schimmert ein blasser Himmel hindurch.");
    AddDetail("klang",
        "Der Klang von Schritten und Metall fuellt den Torbogen.");
    AddDetail("pfeilern",
        "Die Pfeiler sind schlicht, doch mit alten Segenszeichen versehen.");
    AddDetail("stahl",
        "Stahl hallt im Hof wider, sauber und klar.");
    AddDetail("stimmen",
        "Stimmen hallen durcheinander, ernst und diszipliniert.");
    AddDetail("torbogen",
        "Der Torbogen ist breit, stabil und fest in den Stein gehauen.");
    AddDetail("wind",
        "Der Wind streicht durch den Hof und spielt mit den Baendern.");
    AddDetail("zugbruecke",
        "Die Zugbruecke ist von hier aus gut zu sehen und fuehrt hinaus ins Gebirge.");
    AddDetail("baendern",
        "Die Baendern flattern leicht und werfen flatternde Schatten auf den Boden.");
    AddDetail("gebirge",
        "Hinter der Zugbruecke erhebt sich das Gebirge wie eine Wand aus Stein.");
    AddDetail("hof",
        "Der Hof ist offen und hell, ein Ort des Kommens und Gehens.");
    AddDetail("mauern",
        "Die Mauern ringsum sind hoch und wirken alt und fest.");
    AddDetail("metall",
        "Metall glaenzt im Licht und klingt hell bei jeder Bewegung.");
    AddDetail("pfeiler",
        "Die Pfeiler tragen die Last des Bogens und sind schlicht verziert.");
    AddDetail("schritt",
        "Der Schritt der Paladine klingt gleichmaessig und fest.");
    AddDetail("segenszeichen",
        "Die Segenszeichen auf den Pfeilern sind alt, aber sorgsam gepflegt.");
    AddDetail("stein",
        "Der Stein ist glatt vom Wetter und den Jahren.");
    AddDetail("zeichen",
        "Die Zeichen auf den Baendern sind verblasst, aber noch lesbar.");
    AddDetail("bewegung",
        "Jede Bewegung hallt kurz zwischen den Mauern nach.");
    AddDetail("bogens",
        "Die Rundung des Bogens wirft weiche Schatten auf den Stein.");
    AddDetail("gehens",
        "Das Gehen vieler Stiefel hat den Boden geglaettet.");
    AddDetail("jahren",
        "Ueber die Jahre hat Wind und Wetter die Steine geglaettet.");
    AddDetail("kommens",
        "Das Kommen der Paladine wirkt ruhig und geordnet.");
    AddDetail("last",
        "Die Last des Bogens ruht schwer auf den Pfeilern.");
    AddDetail("licht",
        "Das Licht faellt gedaempft durch die Oeffnung des Bogens.");
    AddDetail("ort",
        "Der Ort fuehlt sich sicher und geweiht an.");
    AddDetail("paladine",
        "Die Paladine bewegen sich diszipliniert und schweigsam.");
    AddDetail("schatten",
        "Schatten kriechen ueber die Pflastersteine des Hofs.");
    AddDetail("wand",
        "Die Wand aus Gebirge rahmt das Westtor wie ein stiller Waechter.");
    AddDetail("wetter",
        "Wetter und Zeit haben ihre Spuren im Stein hinterlassen.");
    AddDetail("gehen",
        "Beim Gehen hallen die Schritte leise im Bogen.");
    AddDetail("jahre",
        "Jahre des Gebets und der Wacht liegen in diesen Steinen.");
    AddDetail("kommen",
        "Das Kommen und Gehen ist Teil des Rhythmus dieses Ortes.");
    AddDetail("oeffnung",
        "Die Oeffnung des Bogens gibt den Blick auf die Zugbruecke frei.");
    AddDetail("pflastersteine",
        "Die Pflastersteine sind glatt und hell vom steten Gebrauch.");
    AddDetail("rundung",
        "Die Rundung des Bogens fuegt sich harmonisch in die Mauern.");
    AddDetail("spuren",
        "Spuren vieler Fuesse ziehen sich durch den Hof.");
    AddDetail("stiefel",
        "Stiefel haben ueber die Jahre jeden Stein geglaettet.");
    AddDetail("waechter",
        "Das Gebirge steht wie ein stummer Waechter ueber dem Tor.");
    AddDetail(({"westtor", "tor"}),
        "Das Westtor ist von hier gut zu erkennen.");
    AddDetail("zeit",
        "Zeit und Wind haben diesen Ort geformt und geglaettet.");
    AddDetail("blick",
        "Der Blick durch den Torbogen schweift hinaus zur Zugbruecke.");
    AddDetail("bogen",
        "Der Bogen ist breit und alt, doch maechtig und fest.");
    AddDetail("fuesse",
        "Fuesse haben hier unzaehlige Wege gezogen.");
    AddDetail("gebets",
        "Der Duft alten Gebets liegt noch immer in der Luft.");
    AddDetail("gebrauch",
        "Gebrauch und Zeit haben den Stein weich geschliffen.");
    AddDetail("rhythmus",
        "Der Rhythmus der Schritte praegt diesen Ort.");
    AddDetail("teil",
        "Alles hier wirkt wie Teil eines groesseren Ganzen.");
    AddDetail("wacht",
        "Die Wacht an diesem Tor dauert an, ungebrochen und still.");
    AddDetail("duft",
        "Ein feiner Duft von Weihrauch haengt in der Luft.");
    AddDetail("ganzen",
        "Alles hier fuegt sich still in ein groesseres Ganzes.");
    AddDetail("luft",
        "Die Luft ist klar und traegt den Klang der Stimmen.");
    AddDetail("wege",
        "Wege kreuzen sich hier, bevor sie hinaus ins Gebirge fuehren.");
    AddDetail("ganzes",
        "Das Ganzes wirkt geordnet.");
    AddDetail("weihrauch",
        "Weihrauchduft liegt schwer in der kuehlen Luft.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "norden", ROOM "festung_1" );
    AddExit( "nordosten", ROOM "festung_4");
    AddExit( "osten", ROOM "festung_5");
    AddExit( "westen", ROOM "festung_westtor");
    AddExit( "suedosten", ROOM "festung_6");
    AddExit( "sueden", ROOM "festung_3");

//--Items & NPCs-----------------------------------------------------------

}
