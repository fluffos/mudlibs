#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Das Zentrum des Paladinhofs");
    SetProp(P_INT_LONG,
        "Im Mittelpunkt des Hofes erhebt sich eine gepflasterte Flaeche, auf der eine "
        "Statue der Guettlichen Rose steht. Ihr Blick richtet sich nach Osten, wo der "
        "Burgfried glaenzt. Ringsum sind die Spuren zahlloser Uebungen im Stein eingelassen.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("zentrum",
        "Das Zentrum des Hofes wirkt wie ein heiliger Knotenpunkt.");
    AddDetail("mittelpunkt",
        "Im Mittelpunkt steigt die gepflasterte Flaeche leicht an.");
    AddDetail("paladinhof",
        "Der Paladinhof summt von erinnerter Disziplin.");
    AddDetail("hof",
        "Der Hof traegt die Zeichen vieler Morgenappelle.");
    AddDetail("flaeche",
        "Die Flaeche ist glatt verlegt und blank gescheuert.");
    AddDetail("statue",
        "Die Statue der Goettlichen Rose hebt sich stolz ueber den Stein.");
    AddDetail(({"goettliche rose", "rose"}), 
        "Die Goettliche Rose streut stille Zuversicht.");
    AddDetail("blick",
        "Ihr Blick ruht fest auf dem Osten.");
    AddDetail("osten",
        "Nach Osten hin glaenzt der Burgfried im Licht.");
    AddDetail("burgfried",
        "Der Burgfried funkelt wie ein versiegeltes Versprechen.");
    AddDetail("spuren",
        "Spuren zahlloser Uebungen ritzen sich in die Steine.");
    AddDetail("uebungen",
        "Die Uebungen haben den Platz hart und diszipliniert gemacht.");
    AddDetail("stein",
        "Warmer Stein speichert die Kraft der letzten Sonne.");
    AddDetail("boden",
        "Der Boden ist sauber gepflastert und vom Dienst blank gescheuert.");
    AddDetail("goettliche",
        "Die Goettliche wird hier in der Rose geehrt; ihr Segen ruht still.");
    AddDetail("guettlichen",
        "Die Guettlichen ist gemeint: die Rose der Goettlichen und ihr leiser Segen.");
    AddDetail("himmel",
        "Heller Himmel spannt sich offen; aus Osten faellt klares Licht.");
    AddDetail("kraft",
        "Gesammelte Kraft der Uebungen schwingt im Stein nach.");
    AddDetail("licht",
        "Klares Licht hebt Kanten und alte Zeichen im Pflaster.");
    AddDetail("morgenappelle",
        "Die Ordnung der Morgenappelle hat den Stein gezeichnet.");
    AddDetail("platz",
        "Ein offener Platz, geschaffen fuer Schritt und Ordnung.");
    AddDetail("sonne",
        "Die Sonne giesst helles Licht ueber Hof und Burgfried.");
    AddDetail("versprechen",
        "Ein Versprechen von Schutz und Bestand liegt leise in der Luft.");
    AddDetail("zeichen",
        "Alte Zeichen der Ordnung schneiden sich tief in die Platten.");
    AddDetail("zuversicht",
        "Stille Zuversicht breitet sich von der Rose aus.");
    AddDetail("dauer",
        "Schlichte Dauer durchzieht den Platz wie ein stilles Versprechen.");
    AddDetail("hauch",
        "Ein leiser Hauch von Zuversicht und Segen liegt in der Luft.");
    AddDetail("leuten",
        "Die Leute des Hofes wirken gesammelt und ruhig in ihrer Pflicht.");
    AddDetail("ort",
        "Der Ort fuehlt sich geordnet an, als waere er gesegnet.");
    AddDetail("reihen",
        "Geschlossene Reihen, gezeichnet von Dienst und Uebung.");
    AddDetail("steinplatten",
        "Steinplatten, breit und fest, tragen Schritt und Ordnung.");
    AddDetail("takt",
        "Ein fester Takt haelt die Schritte gleich und sicher.");
    AddDetail("uebung",
        "Uebung haertet den Platz und diszipliniert die Bewegung.");
    AddDetail("bewegung",
        "Gelenkte Bewegung, ruhig und praezise im Takt.");
    AddDetail("leute",
        "Die Leute des Hofes wirken gesammelt und pflichtbewusst.");
    AddDetail("pflicht",
        "Schlichte Pflicht haelt Reihen und Blick nach Osten fest.");
    AddDetail("bestand",
        "Bestand und Dauer praegen diesen Ort wie eingraviert.");
    AddDetail("dienst",
        "Der Dienst haelt den Platz blank und die Reihen geschlossen.");
    AddDetail("kanten",
        "Scharfe Kanten treten im klaren Licht deutlich hervor.");
    AddDetail("luft",
        "Helle, ruhige Luft traegt einen Hauch von Zuversicht.");
    AddDetail("ordnung",
        "Strenge Ordnung liegt ueber Hof und Morgenappellen.");
    AddDetail("pflaster",
        "Fest gefuegtes Pflaster, glatt verlegt und sorgfaeltig gepflegt.");
    AddDetail("platten",
        "Breite Steinplatten zeigen Spuren von Schritt und Uebung.");
    AddDetail("schritt",
        "Ein geuebter Schritt, gleichmaessig und fest im Takt.");
    AddDetail("schutz",
        "Ein leiser Schutz geht von Rose und Burgfried aus.");
    AddDetail("segen",
        "Ein stiller Segen ruht auf Platz und Leuten.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "norden", ROOM "festung_4" );
    AddExit( "osten", ROOM "festung_palatin");
    AddExit( "westen", ROOM "festung_2");
    AddExit( "suedwesten", ROOM "festung_3");
    AddExit( "sueden", ROOM "festung_6");
    AddExit( "nordwesten", ROOM "festung_1");

//--Items & NPCs-----------------------------------------------------------

}
