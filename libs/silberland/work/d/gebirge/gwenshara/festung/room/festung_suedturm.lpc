#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Der Suedturm der Goldenen Rose");
    SetProp(P_INT_LONG,
        "Der Turm dient als Wach- und Rastplatz fuer die Paladine. An den Waenden "
        "stehen Waffengestelle, daneben einfache Pritschen und Kisten mit "
        "Versorgungsguetern. Durch die schmalen Fenster zieht kalte Luft herein, "
        "die den Duft von Leder und Stahl traegt.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

    AddDetail("suedturm",
        "Der Suedturm wacht ueber den Hof wie ein Ruheposten.");
    AddDetail("hof",
        "Der Hof ist von hier aus nur als grauer Fleck zu sehen.");
    AddDetail("fleck",
        "Ein grauer Fleck im Nebel markiert den Hof.");
    AddDetail("erde",
        "Erde und Schnee mischen sich zu fleckigen Mustern unten.");
    AddDetail("schnee",
        "Schnee gleisst nur kurz, bevor der Wind ihn davontraegt.");
    AddDetail("nebel",
        "Nebel kriecht selbst in grosser Hoehe entlang.");
    AddDetail(({"figuren", "spielfiguren"}),
        "Figuren auf dem Hof wirken von hier aus wie winzige Spielfiguren.");
    AddDetail("wach",
        "Wach bedeutet hier, jeden Schritt auf dem Hof zu ueberwachen.");
    AddDetail("wachposten",
        "Wachposten stehen so, dass sie jede Leiter und Treppe sehen.");
    AddDetail("posten",
        "Posten decken jede Sichtlinie ab.");
    AddDetail("leiter",
        "Leiter fuehren entlang der Mauerkrone.");
    AddDetail("treppe",
        "Die Treppe windet sich eng an der Innenwand hinab.");
    AddDetail("schritt",
        "Schritt und Atem geraten automatisch in Gleichklang.");
    AddDetail("turm",
        "Der Turm beherbergt Wache und Rast zugleich.");
    AddDetail("wachplatz",
        "Der Wachplatz ist schlicht, doch stets besetzt.");
    AddDetail("platz",
        "Platz ist knapp, daher steht alles in klaren Reihen.");
    AddDetail("raum",
        "Raum bleibt gerade genug fuer zwei Personen nebeneinander.");
    AddDetail("personen",
        "Personen muessen sich hier staendig aneinander vorbeidruecken.");
    AddDetail("reihen",
        "Reihen aus Betten und Kisten lassen kaum Freiraum.");
    AddDetail("betten",
        "Betten stehen dicht an dicht, damit mehr Ausruestung hineinpasst.");
    AddDetail("ordnung",
        "Ordnung bedeutet hier, dass jeder Griff im Dunkeln sitzt.");
    AddDetail("fehler",
        "Fehler bei der Ordnung wuerden sofort auffallen.");
    AddDetail("ordnung",
        "Ordnung zeigt sich in jeder Linie der aufgestellten Betten.");
    AddDetail("reihen",
        "Reihen aus Betten und Kisten lassen kaum Raum fuer Fehler.");
    AddDetail("rastplatz",
        "Ein kleiner Rastplatz bietet mueden Paladinen kurze Pausen.");
    AddDetail("betten",
        "Betten gibt es nur wenige, damit die Wachposten nicht einschlafen.");
    AddDetail("paladine",
        "Paladine legen hier Ruestungen ab und tauschen fluechtige Worte.");
    AddDetail("bewegungen",
        "Bewegungen der Wachenden bleiben ruhig und geuebt.");
    AddDetail("wachenden",
        "Die Wachenden wechseln ihre Position ohne viel Aufhebens.");
    AddDetail("aufhebens",
        "Aufhebens macht hier niemand; alles geschieht still.");
    AddDetail("position",
        "Positionen werden nur mit einem kurzen Nicken gewechselt.");
    AddDetail("nicken",
        "Ein knappes Nicken ersetzt hier lange Anweisungen.");
    AddDetail("brettspiel",
        "Der Hof wirkt von hier oben wie ein Brettspiel mit lebenden Figuren.");
    AddDetail("figuren",
        "Figuren bewegen sich unten wie auf Feldern.");
    AddDetail("feldern",
        "Auf Feldern aus Stein und Erde verteilen sich die Wachposten.");
    AddDetail("gedanken",
        "Gedanken klaeren sich beim Blick auf den Hof.");
    AddDetail("blick",
        "Blickst du nach unten, siehst du den Hof wie ein Brettspiel.");
    AddDetail("worte",
        "Worte bleiben kurz, damit niemand abgelenkt wird.");
    AddDetail("wort",
        "Ein einziges Wort kann hier schon Befehl oder Warnung sein.");
    AddDetail("befehl",
        "Ein Befehl besteht oft nur aus einem Namen und einem Ziel.");
    AddDetail("ziel",
        "Das Ziel ist meist ein neuer Posten oder eine Vorratskiste.");
    AddDetail("anweisungen",
        "Anweisungen werden einmal ausgesprochen und dann befolgt.");
    AddDetail("warnung",
        "Warnung wird gefluestert, damit sie nicht durch den Turm hallt.");
    AddDetail("waende",
        "Die Waende sind von Kerben und eingeritzten Gebeten gezeichnet.");
    AddDetail("runen",
        "Runen markieren die Dienste vergangener Wachen.");
    AddDetail("dienste",
        "Dienste werden hier oben noch mit einem Messer in den Stein geritzt.");
    AddDetail("ritzzeichen",
        "Ritzzeichen bestehen aus kurzen Kerben und Pfeilen fuer besondere Meldungen.");
    AddDetail(({"dienst", "schicht", "dienstzeit"}),
        "Dienstzeit steht neben den Runen in kurzer Schrift.");
    AddDetail("dienstzeiten",
        "Dienstzeiten werden in den Stein geritzt, damit niemand sie vergisst.");
    AddDetail("messer",
        "Messer fuer die Ritzzeichen liegen auf einem Regal.");
    AddDetail("pfeile",
        "Pfeile neben den Namen zeigen verlaengerte Dienste an.");
    AddDetail("regal",
        "Das Regal ist kaum breiter als ein Unterarm.");
    AddDetail("regal",
        "Ein schmales Regal traegt Messer, Polierlappen und Buch.");
    AddDetail("namen",
        "Namen stehen neben jeder eingravierten Schicht.");
    AddDetail("diensteintrag",
        "Jeder Diensteintrag nennt Name, Stunde und Waffengattung.");
    AddDetail("vorkommnisse",
        "Vorkommnisse stehen in einer eigenen Spalte am Rand.");
    AddDetail("spalte",
        "Spalte und Zeile werden mit kleinen Kreuzen markiert.");
    AddDetail("kreuzen",
        "Kreuzen markieren erledigte Aufgaben.");
    AddDetail("zeile",
        "Zeile fuer Zeile bleibt frei von Klecksen.");
    AddDetail("meldungen",
        "Meldungen ueber besondere Vorkommnisse stehen am Rand.");
    AddDetail("schrift",
        "Schrift und Runen wirken grob, aber deutlich.");
    AddDetail("kerben",
        "Kerben zeugen von geuebtem Umgang mit Waffen und Ruestungen.");
    AddDetail("gebeten",
        "Gebeten in alten Runen laufen ueber den Stein.");
    AddDetail("waffengestelle",
        "Waffengestelle halten blank polierte Klingen bereit.");
    AddDetail("gestell",
        "Ein Gestell traegt nur eine Waffenart, damit niemand ruetteln muss.");
    AddDetail("waffenart",
        "Jede Waffenart hat ihren festen Platz.");
    AddDetail("waffen",
        "Waffen stehen stets innerhalb einer Armlaenge bereit.");
    AddDetail("armlaenge",
        "Eine Armlaenge genuegt, um jedes Gestell zu erreichen.");
    AddDetail("gleichklang",
        "Gleichklang von Schritt und Atem haelt wach.");
    AddDetail("klingen",
        "Klingen werden jeden Abend nachgeschliffen.");
    AddDetail("pritschen",
        "Einfache Pritschen warten mit sauber gefalteten Decken.");
    AddDetail("decken",
        "Decken sind dick und halten selbst Hoehenkaelte fern.");
    AddDetail("hoehenkaelte",
        "Hoehenkaelte kratzt nur, solange man noch nass ist.");
    AddDetail("kaelte",
        "Kaelte sitzt in jeder Fuge und macht die Finger steif.");
    AddDetail("kisten",
        "Schwere Kisten bergen ordentlich verstaute Vorrate.");
    AddDetail("vorratskiste",
        "Eine Vorratskiste enthaelt immer Wasserflaschen und Decken.");
    AddDetail("vorrate",
        "Vorrate bestehen aus Trockenkraut, Oel und Verbandstoff.");
    AddDetail("trockenkraut",
        "Trockenkraut haengt in Buendeln von einem Haken.");
    AddDetail("haken",
        "Haken aus Eisen tragen Buendel und Ausruestung.");
    AddDetail("ausruestung",
        "Ausruestung haengt griffbereit an den eisernen Haken.");
    AddDetail("buendeln",
        "Buendeln aus Kraeutern trocknen in der Zugluft.");
    AddDetail("buendel",
        "Ein Buendel aus Kraeutern wird bei Bedarf rasch eingesammelt.");
    AddDetail("kraeutern",
        "Kraeutern duftet herbe und frisch, selbst im trockenen Zustand.");
    AddDetail("kraeuter",
        "Kraeuter werden nach Wirkung sortiert in kleine Saeckchen gepackt.");
    AddDetail("wirkung",
        "Wirkung der Kraeuter reicht von beruhigend bis anregend.");
    AddDetail("saeckchen",
        "Saeckchen aus Leinenstoffen haengen an den Kisten.");
    AddDetail("leinenstoffen",
        "Leinenstoffen wird hier nicht gefaerbt, damit man Flecken sieht.");
    AddDetail("zugluft",
        "Zugluft streicht stetig durch den Turm und trocknet Kraeuter und Leder.");
    AddDetail("oel",
        "Oel wird fuer Waffen wie auch fuer Leder verwendet.");
    AddDetail("verbandstoff",
        "Verbandstoff liegt sauber gerollt bereit.");
    AddDetail("versorgungsgueter",
        "Versorgungsgueter sind nach Bedarf beschriftet.");
    AddDetail("bedarf",
        "Bedarf wird taeglich uebers Buch kontrolliert.");
    AddDetail("buch",
        "Ein Buch mit straffer Handschrift dokumentiert jede Entnahme.");
    AddDetail("rand",
        "Am Rand der Seiten stehen kurze Rand bemerkungen zur Disziplin.");
    AddDetail("randbemerkungen",
        "Randbemerkungen notieren Sonderaufgaben und Mahnungen.");
    AddDetail("sonderaufgaben",
        "Sonderaufgaben sind selten, werden aber fett markiert.");
    AddDetail("mahnungen",
        "Mahnungen erinnern an verlorene Ausruestung oder verspaetete Dienste.");
    AddDetail("randbemerkungen",
        "Randbemerkungen vermerken Sonderaufgaben oder Mahnungen.");
    AddDetail("entnahme",
        "Entnahme wird mit Namen und Dienstzeit vermerkt.");
    AddDetail("handschrift",
        "Handschrift und Tintenstriche wirken soldatisch knapp.");
    AddDetail("tintenstriche",
        "Tintenstriche bleiben streng und ohne Schnoerkel.");
    AddDetail("disziplin",
        "Die Randbemerkungen sagen dir, dass die Disziplin gut ist.");
    AddDetail("seiten",
        "Die Seiten enthalten allerlei Meldungen.");
    AddDetail("schnoerkel",
        "Schnoerkel sind hier unerwuenscht; alles bleibt streng nutzlich.");
    AddDetail("abend",
        "Am Abend ist es am belebtesten, wenn die abgeloeste Wache eintrifft.");
    AddDetail("fenster",
        "Schmale Fenster lassen nur Streifen von Licht herein.");
    AddDetail("streifen",
        "Streifen aus Helligkeit liegen wie Buehnenlinien am Boden.");
    AddDetail("helligkeit",
        "Helligkeit wirkt im Turm immer leicht blaeulich.");
    AddDetail("buehnenlinien",
        "Buehnenlinien aus Licht zeigen dir, wie weit der Staub gewischt ist.");
    AddDetail("staub",
        "Staub bleibt nur dort liegen, wo niemand steht.");
    AddDetail("licht",
        "Licht zeichnet kantige Muster auf Holz und Stein.");
    AddDetail("holz",
        "Holzbohlen knarren leise unter den schweren Stiefeln.");
    AddDetail("stiefeln",
        "Stiefeln hinterlassen matte Spuren auf dem Boden.");
    AddDetail("spuren",
        "Spuren verschwinden schnell, weil staendig gekehrt wird.");
    AddDetail("muster",
        "Muster aus Licht und Schatten wandern mit den Wolken.");
    AddDetail("schatten",
        "Schatten markieren die Dienstzeiten wie eine Sonnenuhr.");
    AddDetail("sonnenuhr",
        "Wie eine Sonnenuhr verraten die Schatten die Stunde.");
    AddDetail("saeule",
        "Eine einzelne Saeule reicht aus, um den Schatten zu werfen.");
    AddDetail("stunde",
        "Die Stunde laesst sich am Schatten einer einzigen Saeule ablesen.");
    AddDetail("boden",
        "Der Boden ist glatt getreten und sauber gefegt.");
    AddDetail("tuer",
        "Die Tuer ist dick, doch laesst sie jeden Luftzug durch.");
    AddDetail("luftzug",
        "Ein leichter Luftzug kuendigt an, wenn jemand die Tuer oeffnet.");
    AddDetail("stein",
        "Steinplatten tragen kaum Abnutzung, so sorgsam werden sie gepflegt.");
    AddDetail("abnutzung",
        "Abnutzung beschraenkt sich auf kleine stumpfe Stellen.");
    AddDetail("stellen",
        "Stellen nahe der Tuer werden besonders oft betreten.");
    AddDetail("luft",
        "Kalte Luft riecht nach Leder und Stahl.");
    AddDetail("hoehe",
        "Hoehe laesst die Stimmen gedaempft und fern wirken.");
    AddDetail("himmel",
        "Himmel erscheint nur als schmaler Streifen zwischen den Zinnen.");
    AddDetail("zinnen",
        "Zinnen wirken von innen wie fingerbreite Schatten.");
    AddDetail("stimmen",
        "Stimmen aus dem Hof klingen nur wie fernes Summen.");
    AddDetail("summen",
        "Summen und leises Lachen mischen sich mit dem Wind.");
    AddDetail("lachen",
        "Lachen klingt hier wie ein kurzer Glockenton.");
    AddDetail("glockenton",
        "Ein Glockenton hallt laenger als jedes Wort.");
    AddDetail("summen",
        "Summen und leises Lachen dringen kaum bis hier herauf.");
    AddDetail("atem",
        "Atem bildet kleine Wolken vor dem Gesicht.");
    AddDetail("gesicht",
        "Gesicht und Finger roteleuchten von der Kaelte.");
    AddDetail("finger",
        "Finger bleiben unbedeckt, damit die Riemen schnell geloest werden koennen.");
    AddDetail("kaelte",
        "Kaelte zwingt die Wache immer wieder zu kurzen Bewegungen.");
    AddDetail("duft",
        "Ein Duft von Lederpflege und geputzten Klingen haengt hier.");
    AddDetail("lederpflege",
        "Lederpflege steht offen bereit, damit Ruestungen weich bleiben.");
    AddDetail("leder",
        "Weiches Leder liegt zusammen mit Polierlappen bereit.");
    AddDetail("polierlappen",
        "Polierlappen sind vom Metall bereits geschwaerzt.");
    AddDetail("metall",
        "Metallkanten spiegeln das Licht, sobald du dich bewegst.");
    AddDetail("eisen",
        "Eisenstangen am Fenster verhindern, dass jemand hinausfaellt.");
    AddDetail("stahl",
        "Stahl schimmert dunkel unter dem feuchten Atem der Hoehe.");
    AddDetail("ruestungen",
        "Ruestungen lehnen sorgfaeltig gestapelt an den Waenden.");
    AddDetail("ruestung",
        "Eine einzelne Ruestung wirkt beinahe wie eine schlafende Wache.");
    AddDetail("zustand",
        "Der Zustand jeder Ruestung wird nach jeder Wache geprueft.");
    AddDetail("riemen",
        "Riemen liegen zusammengerollt fuer schnelle Korrekturen bereit.");
    AddDetail("korrekturen",
        "Korrekturen an den Ruestungen werden sofort vorgenommen.");
    AddDetail("umgang",
        "Umgang mit Ruestungen und Waffen wird hier oben geuebt.");
    AddDetail("rast",
        "Rast ist hier kurz, aber kostbar.");
    AddDetail("pausen",
        "Pausen werden genutzt, um Waffen und Gedanken zu ordnen.");
    AddDetail("wolken",
        "Wolken ziehen vor dem schmalen Himmel wie graue Streifen vorbei.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "norden", ROOM "festung_6" );
    AddExit( "westoben", ROOM "wachweg_x1y2" );
    AddExit( "ostoben", ROOM "wachweg_x3y2" );

//--Items & NPCs-----------------------------------------------------------

    AddItem(NPC "paladin_ser_calem", REFRESH_DESTRUCT);
}
