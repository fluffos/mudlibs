#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein scharfer Knick im Canyonpfad");
    SetProp(P_INT_LONG,
    "Die Felswaende biegen abrupt nach Sueden ab. Wasser perlt an ihnen hinab, "
    "und zwischen den Rissen glimmt feuchter Schiefer. Ein Seitenweg fuehrt "
    "nach Suedosten hinunter in dunklere Schluchten.");



//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("boden",
        "Der Boden ist rutschig vom Wasser und mit feinem Kies bedeckt.");
    AddDetail(({"felswaende","felswand"}),
        "Die Felswaende sind glatt und dunkel vom stetigen Wasserlauf.");
    AddDetail("himmel",
        "Nur ein schmaler Streifen Himmel ist zwischen den Waenden zu sehen.");
    AddDetail("rissen",
        "Aus den Rissen rinnt Wasser und sammelt sich in kleinen Pfuetzen.");
    AddDetail("schiefer",
        "Der Schiefer glimmt feucht im schwindenden Licht.");
    AddDetail("schluchten",
        "Die Schluchten darunter wirken tief und still, als fuehrten sie ins Herz des Gebirges.");
    AddDetail("seitenweg",
        "Ein schmaler Seitenweg fuehrt steil nach Suedosten hinab, kaum mehr als eine Spur im Fels.");
        AddDetail("fels",
        "Der Fels ist kalt und fest, von Wasser glatt geschliffen.");
    AddDetail("gebirges",
        "Das Gebirge wirkt hier enger, als wuerde es sich ueber dir schliessen.");
    AddDetail("herz",
        "Tief unten schlaegt das Herz des Gebirges im dumpfen Grollen des Wassers.");
    AddDetail("kies",
        "Feiner Kies rutscht bei jedem Schritt leise ueber den Fels.");
    AddDetail("licht",
        "Ein schwaches Licht faellt von oben herab und spiegelt sich im Wasser.");
    AddDetail("pfuetzen",
        "Kleine Pfuetzen glitzern zwischen den Steinen und zittern im Wind.");
    AddDetail("spur",
        "Eine einzelne Spur im nassen Boden verliert sich nach Sueden.");
    AddDetail("streifen",
        "Helle Streifen aus Quarz zeichnen Linien durch das dunkle Gestein.");
    AddDetail("waenden",
        "Die Waende steigen steil empor und schliessen den Himmel fast voellig ein.");
    AddDetail("wasser",
        "Wasser rinnt in duennen Faeden an den Felsen herab und tropft leise.");
    AddDetail("wasserlauf",
        "Der Wasserlauf windet sich in winzigen Rillen ueber den glatten Stein.");
    AddDetail("faeden",
        "Feine Faeden aus Wasser glitzern im schwachen Licht.");
    AddDetail("gebirge",
        "Das Gebirge atmet hier Kuehle und Dunkelheit.");
    AddDetail("gestein",
        "Das Gestein wirkt hart und uralt, kaum vom Wasser veraendert.");
    AddDetail("grollen",
        "Tief im Fels klingt ein fernes Grollen, dumpf und schwer.");
    AddDetail("linien",
        "Feine Linien ziehen sich wie Adern durch den Stein.");
    AddDetail("quarz",
        "Der Quarz schimmert hell zwischen den dunklen Schichten.");
    AddDetail("rillen",
        "Schmale Rillen durchziehen den Fels und leiten das Wasser ab.");
    AddDetail("schritt",
        "Jeder Schritt hallt gedaempft zwischen den Waenden nach.");
    AddDetail("stein",
        "Der Stein ist glatt und feucht, fast ohne Halt.");
    AddDetail("waende",
        "Die Waende ruecken dicht zusammen und lassen kaum Licht herein.");
    AddDetail("wind",
        "Ein Windstoss faehrt durch die Schlucht und traegt den Geruch von kaltem Wasser.");
    AddDetail("adern",
        "Die Adern im Fels leuchten schwach im feuchten Licht.");
    AddDetail("dunkelheit",
        "Die Dunkelheit sammelt sich in den Spalten und bleibt dort liegen.");
    AddDetail("geruch",
        "Ein schwerer Geruch nach nassem Stein erfuellt die Luft.");
    AddDetail("halt",
        "Ohne festen Halt wirkt jeder Schritt gefaehrlich nah am Abgrund.");
    AddDetail("kuehle",
        "Die Kuehle steigt vom Boden auf und legt sich auf deine Haut.");
    AddDetail("schichten",
        "Duenne Schichten aus Gestein loesen sich unter dem Wasser und gleiten davon.");
    AddDetail("schlucht",
        "Die Schlucht oeffnet sich nach Sueden hin in tiefes Grau.");
    AddDetail("windstoss",
        "Ein einzelner Windstoss streicht durch die Enge und zerreisst kurz den Nebel.");
    AddDetail("abgrund",
        "Der Abgrund faellt lautlos hinab und verliert sich im Nebel.");
    AddDetail(({"enge", "atmen", "seiten"}),
        "Die Enge drueckt von allen Seiten und macht das Atmen schwer.");
    AddDetail("grau",
        "Ein gleichmaessiges Grau liegt ueber allem, ohne Dunkelheit oder Tiefe.");
    AddDetail("haut",
        "Deine Haut fuehlt sich kuehl an.");
    AddDetail("luft",
        "Die Luft ist still und schmeckt nach Stein und Wasser.");
    AddDetail("nebel",
        "Der Nebel kriecht in jede Spalte und bewegt sich kaum.");
    AddDetail(({"spalten", "spalte"}),
        "Die Spalten im Fels sind schmal und tief, gefuellt mit Dunkelheit.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "weg_4" );
    AddExit( "suedostunten", ROOM "weg_6");

//--Items & NPCs-----------------------------------------------------------

}
