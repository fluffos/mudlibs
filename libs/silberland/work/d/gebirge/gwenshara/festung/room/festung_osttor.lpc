#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Das Westtor der Festung");
    SetProp(P_INT_LONG,
        "Das grosse Holztor der Festung ist mit Eisenbändern beschlagen und wirkt "
        "unueberwindbar. An den Seiten ragen hohe Mauern aus dem Fels, die das Tor "
        "schuetzen. Der Boden ist mit Staub bedeckt, und die Luft ist schwer vom "
        "Geruch nach Oel und Metall. Hinter dem Tor fuehrt eine Metalltuer durch den "
        "inneren Wall in die Festung. Nach Suedosten hin faellt ein steiler Pfad "
        "den Berg hinab.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------
    AddDetail(({"tor", "holztor", "haupttor"}),
        "Das Holztor ist mit schweren Eisenbaendern beschlagen, traegt Kerben von alten Schlachten und wirkt unerschuetterlich.");
    AddDetail(({"kerben", "narben"}),
        "Die Kerben stammen von alten Schlachten und verlaufen wie Narben ueber das Holz.");
    AddDetail(({"schlachten", "macken", "spuren"}),
        "Schlachten haben hier tobt, und ihre Spuren zeigen sich in den Macken des Tores.");
    AddDetail(({"eisenbaender", "eisenband", "eisenb"}), 
        "Die Eisenbaender sind fest vernietet und glaenzen trotz des Staubs matt im Licht.");
    AddDetail(({"festung", "mauern", "seiten", "seitenwaende"}),
        "Die Mauern der Festung ragen direkt aus dem Fels und bilden links und rechts massive Seitenwaende.");
    AddDetail(({"fels", "berg", "grundlage", "steinen"}),
        "Der Fels des Berges bildet die natuergliche Grundlage fuer Tor und Mauern und zeigt kaum bearbeitete Steinen.");
    AddDetail(({"boden", "staub", "schritt"}),
        "Der Boden ist mit feinem Staub bedeckt, der bei jedem Schritt aufwirbelt.");
    AddDetail(({"luft", "geruch", "oel", "metall"}),
        "Die Luft traegt den schweren Geruch von Oel und Metall, als wuerde das Tor staendig gepflegt.");
    AddDetail("metalltuer",
        "Hinter dem Haupttor befindet sich eine kleinere Metalltuer, die in den inneren Wall fuehrt.");
    AddDetail(({"wall", "verteidigungslinie"}),
        "Der Wall ist eine zusaetzliche Verteidigungslinie, massiv und glatt geschmiedet.");
    AddDetail(({"pfad", "felsvorspruengen"}),
        "Ein steiler Pfad fuehrt nach Suedosten den Berg hinab und windet sich zwischen Felsvorspruengen.");
    AddDetail(({"himmel", "kontrast", "licht"}),
        "Ueber den Mauern spannt sich ein klarer Himmel, dessen Licht den Kontrast zu den dunklen Steinen betont.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "festung_9" );
    AddExit( "suedostunten", ROOM "ostweg_1" );

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "torwache", REFRESH_DESTRUCT);
    AddItem(NPC "torwache", REFRESH_DESTRUCT);
}
