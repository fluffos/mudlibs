#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein schattiger, windstiller Pfad");
    SetProp(P_INT_LONG,
    "Hier unten herrscht fast vollkommene Stille. Nur das Tropfen von Wasser "
    "und das ferne Echo des Windes erinnern an Bewegung. Der Weg fuehrt weiter "
    "nach Osten, wo das Licht wieder heller wird.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("bewegung",
        "Jede Bewegung scheint hier gedaempft, als hielte der Fels den Atem an.");
    AddDetail("boden",
        "Der Boden ist feucht und glatt, mit kleinen Pfuetzen dazwischen.");
    AddDetail("echo",
        "Ein fernes Echo hallt von unsichtbaren Waenden zurueck.");
    AddDetail("himmel",
        "Nur ein matter Himmel ist zwischen den Felsen zu erahnen.");
    AddDetail("licht",
        "Das Licht wird nach Osten hin heller, aber bleibt weich und grau.");
    AddDetail("stille",
        "Die Stille ist so dicht, dass selbst dein Atem laut wirkt.");
    AddDetail("tropfen",
        "Tropfen fallen gleichmaessig von oben und zerspringen am Boden.");
    AddDetail("wasser",
        "Klares Wasser rinnt in duennen Spuren zwischen den Steinen.");
    AddDetail("weg",
        "Der Weg zieht sich schmal nach Osten und verliert sich im helleren Nebel.");
    AddDetail("windes",
        "Vom Wind ist nur ein fernes Saeuseln zu hoeren, kaum mehr als Erinnerung.");
    AddDetail("atem",
        "Dein Atem steht sichtbar in der kuehlen Luft und loest sich langsam auf.");
    AddDetail("erinnerung",
        "Alles wirkt fern, wie eine Erinnerung an etwas laengst Vergangenes.");
    AddDetail("fels",
        "Der Fels um dich ist glatt und dunkel, vom Wasser glaenzend poliert.");
    AddDetail("nebel",
        "Feiner Nebel liegt am Boden und bewegt sich kaum merklich.");
    AddDetail("pfuetzen",
        "Kleine Pfuetzen spiegeln das blasse Licht und zittern beim leisesten Schritt.");
    AddDetail("saeuseln",
        "Ein leises Saeuseln zieht durch die Enge und klingt fast wie ein Fluestern.");
    AddDetail("spuren",
        "Zwischen den Steinen sind undeutliche Spuren im feuchten Boden zu sehen.");
    AddDetail("steinen",
        "Die Steine sind glatt und kalt, ueberzogen mit duenner Feuchtigkeit.");
    AddDetail("waenden",
        "Die Waende sind nah und fangen jedes Geraeusch ein.");
    AddDetail("wind",
        "Ein kaum spuerbarer Wind bewegt den Nebel in langsamen Wellen.");
    AddDetail("enge",
        "Die Enge drueckt sich gegen dich und laesst kaum Raum zum Atmen.");
    AddDetail("feuchtigkeit",
        "Feuchtigkeit haengt schwer in der Luft und legt sich auf deine Haut.");
    AddDetail("fluestern",
        "Ein kaum hoerbares Fluestern scheint aus dem Nebel zu kommen.");
    AddDetail("geraeusch",
        "Jedes Geraeusch klingt hier lauter, als wuerde die Schlucht zuhoeren.");
    AddDetail("luft",
        "Die Luft ist kuehl und schmeckt nach Stein und Wasser.");
    AddDetail("schritt",
        "Jeder Schritt hallt dumpf und wird sofort von der Stille verschluckt.");
    AddDetail("steine",
        "Die Steine unter deinen Fuessen sind glatt und feucht.");
    AddDetail("vergangenes",
        "Etwas im Nebel erinnert an Vergangenes, das nicht greifbar ist.");
    AddDetail("waende",
        "Die Waende schliessen sich eng um den Weg und halten den Nebel fest.");
    AddDetail("wellen",
        "Feine Wellen laufen durch den Nebel, wenn der Wind darueber streicht.");
    AddDetail("atmen",
        "Du atmest flach, um die schwere Luft nicht zu stoeren.");
    AddDetail("fuessen",
        "Unter deinen Fuessen klebt feuchter Staub und kuehler Sand.");
    AddDetail("haut",
        "Feine Kaelte legt sich auf deine Haut wie ein Schleier.");
    AddDetail("raum",
        "Der Raum um dich wirkt eng und voller Nebel.");
    AddDetail("schlucht",
        "Die Schlucht ist kaum sichtbar, sie verliert sich im Grau.");
    AddDetail("stein",
        "Der Stein fuehlt sich glatt an, feucht und schwer von Kaelte.");
    AddDetail("grau",
        "Ein gleichmaessiges Grau.");
    AddDetail("kaelte",
        "Die Kaelte kriecht langsam in deine Haut.");
    AddDetail("sand",
        "Feiner Sand klebt an den feuchten Steinen.");
    AddDetail("schleier",
        "Ein duenner Nebel liegt ueber allem.");
    AddDetail("staub",
        "Feuchter Staub glitzert matt im spaerlichen Licht.");



//--Ausgaenge--------------------------------------------------------------

    AddExit( "nordwesten", ROOM "weg_7" );
    AddExit( "osten", ROOM "weg_9");

//--Items & NPCs-----------------------------------------------------------

}
