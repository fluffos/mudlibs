#include "../def.h"

inherit "std/room";

void create()
{
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Der Nordturm der Goldenen Rose");
    SetProp(P_INT_LONG,
    "Der Turm ragt ueber den Grat hinaus und bietet einen weiten Blick ueber "
    "die grauen Nebel des Gebirges. Zwischen den Schiessscharten haengen "
    "Signalbanner und Glocken, die im Wind klingen. An einem Querbalken "
    "haengt eine grosse Glocke. Ein Strang fuehrt bis hier herab. Der Raum "
    "riecht nach Uel, Metall und kaltem Stein.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("turm",
        "Der Turm schneidet wie ein Speer in den Nebel.");
    AddDetail("grat",
        "Der Grat liegt tief unter dir im grauen Dunst.");
    AddDetail("blick",
        "Ein weiter Blick faellt ueber die Gebirgskaemme.");
    AddDetail("nebel",
        "Graue Nebel rollen langsam an der Mauer vorbei.");
    AddDetail("gebirge",
        "Das Gebirge streckt gezackte Ruecken in die Ferne.");
    AddDetail(({"schiessscharten", "scharten"}),
        "Durch die Schiessscharten zieht kuehle Luft.");
    AddDetail("signalbanner",
        "Signalbanner liegen bereit, straff gebunden.");
    AddDetail("glocken",
        "Glocken klingen hell, sobald der Wind sie beruehrt.");
    AddDetail(({"glocke","grosse glocke"}),
        "Eine grosse Glocke haengt am Querbalken; ein Strang fuehrt herab.");
    AddDetail("wind",
        "Der Wind traegt Echos von fernen Gaengen heran.");
    AddDetail("raum",
        "Der Raum wirkt eng, doch voller Wacht.");
    AddDetail(({"oel","uel"}),
        "Der Geruch von geschmiertem Oel liegt schwer in der Luft.");
    AddDetail("metall",
        "Poliertes Metall glitzert in kaltem Licht.");
    AddDetail("stein",
        "Kaltem Stein haftet feiner Reif an.");
    AddDetail("boden",
        "Rauer Boden, von Stiefeln geglaettet und vom Reif kuehl.");
    AddDetail("dunst",
        "Grauer Dunst zieht in Schlieren am Mauerwerk vorbei.");
    AddDetail("echos",
        "Echos von Schritten und Rufen verwehen zwischen den Scharten.");
    AddDetail("ferne",
        "In der Ferne brechen Gebirgskaemme aus den Wolken.");
    AddDetail("gaengen",
        "Aus den Gaengen der Festung steigen gedaempfte Klaenge herauf.");
    AddDetail("gebirgskaemme",
        "Gezackte Gebirgskaemme staffeln sich bis an den Horizont.");
    AddDetail("himmel",
        "Der Himmel ist bleich und weit ueber dem Grat.");
    AddDetail("licht",
        "Kaltes Licht legt harte Kanten auf Metall und Stein.");
    AddDetail("luft",
        "Kuehle Luft faehrt durch die Scharten und traegt den Klang.");
    AddDetail("mauer",
        "Die Mauer steht dick und alt, vom Wind poliert.");
    AddDetail("reif",
        "Feiner Reif perlt in zarten Kanten am kalten Stein.");
    AddDetail("ruecken",
        "Gezackte Ruecken der Berge wogen wie Wellen in der Ferne.");
    AddDetail("speer",
        "Wie ein Speer steht der Turm im Wind.");
    AddDetail("wacht",
        "Wacht liegt ueber allem: wachsam, straff, ohne Nachsicht.");
    AddDetail("berge",
        "Die Berge liegen gestaffelt; die Ruecken sind gezackt und fern.");
    AddDetail("festung",
        "Die Festung sitzt am Grat und haelt still Wacht.");
    AddDetail("geruch",
        "Ein Geruch aus Oel, Metall und kaltem Stein mischt sich.");
    AddDetail("horizont",
        "Am Horizont saeumen Gebirgskaemme die Linie der Wolken.");
    AddDetail("kanten",
        "Harte Kanten blitzen an Metall und bereiftem Stein.");
    AddDetail("klaenge",
        "Gedaempfte Klaenge steigen aus den Gaengen und verwehen.");
    AddDetail("klang",
        "Der Klang der Glocken traegt weit und verrauscht im Wind.");
    AddDetail("mauerwerk",
        "Altes Mauerwerk: vom Wind poliert, vom Reif ueberhaucht.");
    AddDetail("nachsicht",
        "Nachsicht hat hier keinen Platz; die Wacht bleibt straff.");
    AddDetail("rufen",
        "Rufen klingen hell an und verlieren sich im Dunst.");
    AddDetail("schlieren",
        "Schlieren aus Dunst ziehen laengs der Mauer hinab.");
    AddDetail("schritten",
        "Von Schritten bleiben nur leise Echos zwischen den Scharten.");
    AddDetail("stiefeln",
        "Von Stiefeln geglaettet, wirkt der Boden hart und kuehl.");
    AddDetail("wellen",
        "In der Ferne wogen die Berge wie Wellen.");
    AddDetail("wolken",
        "Wolken zerreissen an den Kaemmen und treiben talwaerts.");
    AddDetail("kaemmen",
        "Die Kaemmen schneiden dunkel in die bleiche Ferne.");
    AddDetail("linie",
        "Die Linie des Horizonts liegt scharf zwischen Wolken und Stein.");
    AddDetail("platz",
        "Der Platz im Turm ist eng bemessen und zweckmaessig.");
    AddDetail("querbalken",
        "Ein dicker Querbalken traegt die grosse Glocke.");
    AddDetail("strang",
        "Ein fester Strang fuehrt von der Glocke bis hier herab.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "sueden", ROOM "festung_4" );
    AddExit("westoben", ROOM "wachweg_x1y0" );
    AddExit( "ostoben", ROOM "wachweg_x3y0" );

//--Items & NPCs-----------------------------------------------------------

    AddItem(NPC "paladin_ser_galen", REFRESH_DESTRUCT);

//--Interaktion: Glocke laeuten---------------------------------------
    AddCmd(({"laeut","laeute","laeuten"}), "cmd_laeuten");

}

//--Kommandos--------------------------------------------------------------

int cmd_laeuten(string str) {
    notify_fail("Was willst du laeuten?\n");

    if(str != "glocke" && str != "glocken") return 0;

    write(BS("Du ziehst fest am Strand und laeutest die Glocke."));
    say(BS(TPN+" laeutet die Glocke."));
    return 1;
}
