#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein Gang entlang der nuerdlichen Mauer");
    SetProp(P_INT_LONG,
        "Der Weg fuehrt eng entlang der Innenmauer, von der aus man den Hof ueberblickt. "
        "Schmale Fenster geben den Blick in die graue Weite frei. Ein Banner mit der "
        "goldenen Rose flattert ueber dir im Wind.");



//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("gang",
        "Der Gang folgt knapp der hohen Innenmauer.");
    AddDetail("weg",
        "Ein enger Weg fuehrt ueber den Mauerrand entlang.");
    AddDetail("mauergang",
        "Der Mauergang ist kaum breiter als zwei Schritte und laesst keinen Raum zum "
        "Ausweichen.");
    AddDetail("ausweichen",
        "Ausweichen ist hier unmoeglich; selbst das Zittern der Knie muss unterdrueckt "
        "werden.");
    AddDetail("raum",
        "Der knappe Raum entlang der Mauer zwingt dich, exakt auf der Linie zu bleiben.");
    AddDetail("boden",
        "Der Boden besteht aus glatt abgetretenen Steinplatten, die jeden Schritt dumpf "
        "weitertragen.");
    AddDetail("steinplatten",
        "Die Steinplatten tragen Spuren zahlloser Stiefel und sind in der Mitte glatt "
        "poliert.");
    AddDetail("stiefel",
        "Nur schwer gepanzerte Stiefel wagen sich hierher; die Abdruecke wirken wie "
        "eingebrannte Mahnungen.");
    AddDetail("abdruck",
        "Ein einzelner Abdruck hebt sich dunkler vom Stein ab und verraet hektische "
        "Schritte.");
    AddDetail("abdruecke",
        "Die Abdruecke vergangener Patrouillen liegen wie dunkle Schatten im Stein.");
    AddDetail("patrouillen",
        "Patrouillen ziehen hier seit Jahren dieselben Bahnen und hinterlassen stoische "
        "Trittspuren.");
    AddDetail("mahnungen",
        "Jeder Abdruck ist eine stumme Mahnung, hier keinen Schritt zu verschwenden.");
    AddDetail("mahnung",
        "Die Mahnung des Steins klingt lauter als jede Stimme des Wachhauptmanns.");
    AddDetail("mitte",
        "In der Mitte des Ganges ist der Stein blank poliert, waehrend die Raender rau "
        "bleiben.");
    AddDetail("raender",
        "An den Raendern bleibt der Stein rau und bruechig, als muesse er jeden Moment "
        "nachgeben.");
    AddDetail("moment",
        "Ein einziger Moment der Unaufmerksamkeit koennte dich aus dem Gleichgewicht "
        "bringen.");
    AddDetail("schritt",
        "Jeder Schritt hallt leise entlang der Mauer, als wuerde der Stein selbst "
        "zusehen.");
    AddDetail("absturz",
        "Ein Fehltritt wuerde unweigerlich den Absturz in die Tiefe bedeuten.");
    AddDetail("fehltritt",
        "Schon der leiseste Fehltritt koennte dich in die Wolken unter dir stuerzen.");
    AddDetail("innenmauer",
        "Die Innenmauer steigt glatt und wehrhaft empor.");
    AddDetail("mauer",
        "Die noerdliche Mauer bietet freien Blick ueber den Hof.");
    AddDetail("hof",
        "Von hier oben liegt der Hof wie ein geordnetes Feld.");
    AddDetail("feld",
        "Der geordnete Hof erinnert an ein musterhaft gezogenes Feld, dessen Linien man "
        "nur von hier oben erkennt.");
    AddDetail("linien",
        "Saubere Linien ziehen sich ueber den Hof und zerfallen weiter draussen in wilde "
        "Spuren.");
    AddDetail("abweichung",
        "Es gibt hier oben keinen Platz fuer Abweichung; alles folgt strengen Linien.");
    AddDetail("platz",
        "Platz ist hier ein Privileg; selbst der Wind muss sich schmal machen.");
    AddDetail("privileg",
        "Das Privileg, hier stehen zu duerfen, wird nur den Wachen der Festung zuteil.");
    AddDetail("fenster",
        "Schmale Fenster schneiden die Kante der Mauer.");
    AddDetail("kante",
        "Die Kante der Mauer wirkt scharf wie eine Messerschneide und zwingt zu "
        "vorsichtigen Schritten.");
    AddDetail("messerschneide",
        "Wie die Klinge eines Messers trennt der Mauerrand den sicheren Gang vom Absturz.");
    AddDetail("messers",
        "Das Bild eines Messers draengt sich auf, sobald der Wind an der Kante zerrt.");
    AddDetail("bild",
        "Vor deinem inneren Auge steht das Bild einer Schneide, die jeden Wagemut "
        "bestraft.");
    AddDetail("schneide",
        "Die Schneide der Mauer fuehlt sich unsichtbar, aber jederzeit praesent an.");
    AddDetail("wagemut",
        "Wagemut wird hier nicht belohnt; die Hoehe prueft jede Selbstueberschaetzung.");
    AddDetail("klinge",
        "Die Klinge, die hier herschneidet, besteht aus Sturm, Stein und Hoehe.");
    AddDetail("hoehe",
        "Die Hoehe raubt dir schier den Atem und macht die Knie weich.");
    AddDetail("atem",
        "Der Atem geht schneller, sobald der Blick in die Tiefe schweift.");
    AddDetail("knie",
        "Die Knie beginnen zu zittern, obwohl du sie mit aller Kraft still haelst.");
    AddDetail("sturm",
        "Ein stetiger Sturm zerrt an Kleidung und Gedanken gleichermassen.");
    AddDetail("kleidung",
        "Kleidung flattert im Sturm und schlaegt gegen deine Ruestung.");
    AddDetail("gedanken",
        "Selbst deine Gedanken werden vom Sturm aufgewuehlt.");
    AddDetail("blick",
        "Der Blick schweift weit in graue Fernen.");
    AddDetail("fernen",
        "In den Fernen verschwimmen Berge und Nebel zu einem einzigen graueren "
        "Streifen.");
    AddDetail("ferne",
        "Die Ferne lockt und schreckt zugleich, weil sie keine Orientierung bietet.");
    AddDetail("orientierung",
        "Jede Orientierung geht im Dunst verloren; es bleibt nur der schmale Gang als "
        "Referenz.");
    AddDetail("dunst",
        "Ein feiner Dunst haengt ueber dem Hof und verschluckt Konturen.");
    AddDetail("referenz",
        "Als Referenz bleibt dir nur der Mauerverlauf, alles andere verschwimmt.");
    AddDetail("berge",
        "Die Berge in der Ferne ragen wie dunkle Zacken aus dem Nebelmeer.");
    AddDetail("gipfel",
        "Die Gipfel schneiden wie Lanzen in den Himmel.");
    AddDetail("lanzen",
        "Lanzenlange Gipfelspitzen richten sich wie eine stachelige Krone gegen den "
        "Himmel.");
    AddDetail("zacken",
        "Zackenfoermige Gipfel zerreissen die Wolken wie die Klaue eines Ungeheuers.");
    AddDetail("klaue",
        "Die Klaue der Berge scheint nach allem zu greifen, was den Mauerrand verlaesst.");
    AddDetail("ungeheuers",
        "Unsichtbare Umrisse eines Ungeheuers zeichnen sich im Nebel der Berge ab.");
    AddDetail("umrisse",
        "Die Umrisse der Berge verschwimmen, als wuerden sie jederzeit ihre Form wechseln.");
    AddDetail("wolken",
        "Wolken treiben dicht ueber den Spitzen und verschlucken jeden Laut.");
    AddDetail("spitzen",
        "Die Spitzen der Mauer und der Berge verlieren sich zugleich in den Wolken.");
    AddDetail("laut",
        "Kein Laut bleibt lange erhalten; der Wind zerreisst jedes Geraeusch.");
    AddDetail("streifen",
        "Der Horizont erscheint nur als duennes graues Band, ein Streifen zwischen Himmel "
        "und Stein.");
    AddDetail("band",
        "Das graue Band des Horizonts wirkt wie ein zu eng gespannter Guertel.");
    AddDetail("guertel",
        "Wie ein Guertel schnuert der Horizont die Weite ein und haelt sie zusammen.");
    AddDetail("horizont",
        "Der Horizont versteckt sich hinter Nebelschleiern und scheint starr zu warten.");
    AddDetail("nebelschleiern",
        "Nebelschleier ziehen traege dahin und verbergen, was hinter ihnen lauert.");
    AddDetail("weite",
        "Die graue Weite scheint unendlich zu sein.");
    AddDetail("duesterkeit",
        "Eine bestaendige Duesterkeit liegt ueber dem Gang, genaehrt vom Schatten der "
        "Mauern und dem bleiernen Himmel.");
    AddDetail("dunkelheit",
        "Die Dunkelheit unter dem Mauerrand scheint selbst das schwache Licht zu "
        "verschlingen.");
    AddDetail("schatten",
        "Schatten kriechen an der Mauer entlang und lassen die Augen nach verborgenen "
        "Bewegungen suchen.");
    AddDetail("bewegungen",
        "Mit jeder Windboee glaubst du Bewegungen im Augenwinkel zu sehen.");
    AddDetail("windboee",
        "Jede Windboee jagt wie ein unsichtbarer Gegner am Mauerrand entlang.");
    AddDetail("gegner",
        "Der Wind fuehlt sich wie ein unsichtbarer Gegner an, der dich pruefen will.");
    AddDetail("augenwinkel",
        "Im Augenwinkel zuckt es staendig, als wuerde sich etwas zwischen den Steinen "
        "verbergen.");
    AddDetail("augen",
        "Deine Augen muessen sich an das diffuse Licht gewoehnen und brennen leicht.");
    AddDetail("auge",
        "Ein einzelnes Auge wagt kaum, tiefer als bis zur naechsten Mauerfuge zu blicken.");
    AddDetail("banner",
        "Ein Banner raschelt unruhig ueber deinem Kopf.");
    AddDetail("rose",
        "Die goldene Rose strahlt trotz der Duesterkeit.");
    AddDetail("kopf",
        "Ueber deinem Kopf ziehen Banner und Wind um die Wette, sodass du instinktiv "
        "den Nacken einziehst.");
    AddDetail("nacken",
        "Dein Nacken spannt sich an, sobald der Wind das Banner wie eine Peitsche knallen "
        "laesst.");
    AddDetail("wette",
        "Banner und Wind liefern sich eine endlose Wette darum, wer zuerst nachgeben "
        "wird.");
    AddDetail("peitsche",
        "Wenn der Wind das Banner faengt, klingt es wie der Schlag einer Peitsche.");
    AddDetail("schlag",
        "Der Schlag schneidet durch die Luft und hallt noch lange in deinen Ohren nach.");
    AddDetail("ohren",
        "Deine Ohren klingeln vom steten Prasseln der flatternden Stoffe.");
    AddDetail("himmel",
        "Der Himmel spannt sich als graue Decke ueber die Festung und laesst kein "
        "freundliches Licht hindurch.");
    AddDetail("decke",
        "Die Wolkendecke liegt schwer auf der Festung und drueckt die Farben zu einem "
        "matten Grau.");
    AddDetail("wolkendecke",
        "Die Wolkendecke ist so dicht, dass selbst Raubvoegel sie meiden.");
    AddDetail("raubvoegel",
        "Nicht einmal Raubvoegel wagen sich durch diese tiefliegenden Wolken.");
    AddDetail("farben",
        "Alle Farben scheinen hier in eine Palette aus Grau gezwungen.");
    AddDetail("farbe",
        "Jede Farbe wirkt gedaempft, als laege Staub auf der Welt.");
    AddDetail("staub",
        "Feiner Staub legt sich wie ein Schleier ueber jede Kontur.");
    AddDetail("welt",
        "Die Welt hier oben wirkt fern und entsaettigt, als wuerde sie nur aus Schatten bestehen.");
    AddDetail("palette",
        "Die Palette aus Grau reicht von blassem Stein bis zu fast schwarzem Schatten.");
    AddDetail("grau",
        "Selbst das Grau hat hier verschiedene Abstufungen, vom blassen Aschton bis zum "
        "fast schwarzen Schatten.");
    AddDetail("abstufungen",
        "Die Abstufungen des Graus lassen das Auge nach Kontrasten suchen.");
    AddDetail("kontrasten",
        "Kontrasten musst du dir einbilden; die Landschaft liefert kaum welche.");
    AddDetail("aschton",
        "Ein fahler Aschton ueberzieht alles, was nicht im tiefen Schatten liegt.");
    AddDetail("licht",
        "Kaum ein Lichtstrahl durchdringt das Grau; selbst am Tage wirkt der Gang wie in "
        "Daemmerung.");
    AddDetail("lichtstrahl",
        "Wenn selten ein Lichtstrahl bricht, funkelt er an den Kanten wie Glas.");
    AddDetail("glas",
        "Glasgleiche Reflexe flackern ueber den Steinen und verschwinden sofort wieder.");
    AddDetail("reflexe",
        "Reflexe huschen ueber die Steine, sobald ein Funken Licht einfaellt.");
    AddDetail("daemmerung",
        "Der Gang fuehlt sich an wie eine endlose Daemmerung ohne Sonnenaufgang.");
    AddDetail("sonnenaufgang",
        "Der Sonnenaufgang erreicht diesen Gang kaum.");
    AddDetail("festung",
        "Die Festung um dich herum wirkt wie ein lebendiges Wesen aus Stein, das jeden "
        "Besucher pruefend betrachtet.");
    AddDetail("wesen",
        "Das steinerne Wesen der Festung scheint jedes Geraeusch zu registrieren.");
    AddDetail("geraeusch",
        "Jedes Geraeusch wird vom Stein aufgenommen und weitgetragen.");
    AddDetail("besucher",
        "Besucher werden hier oben sofort sichtbar; Verstecke gibt es keine.");
    AddDetail("verstecke",
        "Verstecke gibt es keine; nur Wind und Stein begleiten dich.");
    AddDetail("wind",
        "Wind peitscht scharf entlang der Steine.");
    AddDetail("luft",
        "Die Luft schmeckt nach kaltem Stein und aufgewirbeltem Staub.");
    AddDetail("steine",
        "Die Steine der Mauer sind von Jahren des Windes abgeschliffen und fuehlen sich "
        "unter den Fingern kalt an.");
    AddDetail("stein",
        "Jeder einzelne Stein wirkt bewusst gesetzt und voller Geschichte.");
    AddDetail("geschichte",
        "Geschichten von Belagerungen und Siegen kleben an jedem Quader.");
    AddDetail("belagerungen",
        "Belagerungen haben den Mauern das Leiden zahlloser Tage eingebrannt.");
    AddDetail("siegen",
        "Siegen folgten nur kurze Momente der Ruhe, bevor die Winde wieder anrannten.");
    AddDetail("quader",
        "Jeder Quader passt exakt in den naechsten, als waere kein Platz fuer Fehler.");
    AddDetail("jahren",
        "Ueber die Jahre haben Wind und Frost kleine Risse in den Stein geschnitten.");
    AddDetail("jahre",
        "Die Jahre haben aus der Festung ein Archiv aus Narben gemacht.");
    AddDetail("archiv",
        "Wie ein Archiv bewahrt die Mauer jeden Schnitt und jede Kerbe.");
    AddDetail("narben",
        "Narben ziehen sich ueber die Steine und verraten vergangene Kaempfe.");
    AddDetail("kaempfe",
        "Kaempfe spiegeln sich in jeder abgeplatzten Kante.");
    AddDetail("zeichen",
        "Die Zeichen der Schlachten wurden nie ganz abgeschliffen.");
    AddDetail("fingern",
        "Wenn du mit den Fingern ueber die Mauer streichst, fuehlst du jede Kerbe und "
        "jeden Bruch.");
    AddDetail("kerbe",
        "Kerben von alten Schlachten sind zwischen die neueren Risse gemischt.");
    AddDetail("schnitt",
        "Jeder Schnitt im Stein ist sorgsam vernarbt, aber nie ganz verschwunden.");
    AddDetail("schlachten",
        "Schlachten haben tiefe Zeichen hinterlassen, die niemand ausbessern wollte.");
    AddDetail("bruch",
        "Mancher Bruch im Stein ist kunstvoll ausgebessert, andere klaffen offen.");
    AddDetail("risse",
        "Feine Risse laufe wie Kartenlinien ueber die Steinoberflaeche.");
    AddDetail("kartenlinien",
        "Die Risse wirken wie Kartenlinien eines unbekannten Landes.");
    AddDetail("landes",
        "Das Landesrelief scheint sich in die Mauer graviert zu haben.");
    AddDetail("steinoberflaeche",
        "Die Steinoberflaeche ist rau wie Pergament, das zu oft gefaltet wurde.");
    AddDetail("pergament",
        "Pergamentartige Schichten loesen sich dort, wo der Stein am duennsten wird.");
    AddDetail("frost",
        "Frost hat in kalten Naechten Wasser in die Ritzen getrieben und sie geweitet.");
    AddDetail("winter",
        "Im Winter knackt die Mauer so laut, dass man sie im ganzen Hof hoert.");
    AddDetail("naechten",
        "In eisigen Naechten knackt die Mauer, als wuerde sie lebendig atmen.");
    AddDetail("wasser",
        "Wenn Wasser in die Fugen sickert, gefriert es zu heimlichen Keilen.");
    AddDetail("fugen",
        "Fugen geben unter der Kaelte leicht nach und verraten die Schwachstellen.");
    AddDetail("keilen",
        "Gefrorene Keile sprengen winzige Schollen aus dem Stein.");
    AddDetail("ritzen",
        "Kleinste Ritzen weiten sich jeden Winter ein wenig mehr.");
    AddDetail("mauerrand",
        "Der Mauerrand zieht sich wie eine duenne Spur entlang der Festung und trennt "
        "Sicherheit von Abgrund.");
    AddDetail("spur",
        "Die Spur des Mauerrands fuehrt schnurgerade weiter und laesst keine Abweichung "
        "zu.");
    AddDetail("sicherheit",
        "Nur die schmale Sicherheit der Mauer trennt dich vom Sturz in die Tiefe.");
    AddDetail("sturz",
        "Der Sturz waere lang genug, dass selbst Schreie im Wind verloren gingen.");
    AddDetail("schreie",
        "Schreie wuerden im Wind zerrissen, noch bevor sie den Hof erreichten.");
    AddDetail("abgrund",
        "Jenseits der Mauer oeffnet sich ein unheimlicher Abgrund, in dem Wind und Nebel "
        "einander jagen.");
    AddDetail("nebel",
        "Der Nebel sammelt sich am Fels und loest jeden Versuch auf, die Tiefe auszumachen.");
    AddDetail("versuch",
        "Jeder Versuch, tiefer zu blicken, endet im gleichen undurchdringlichen Grau.");
    AddDetail("tiefe",
        "Die Tiefe gleicht einem offenen Schlund, dessen Ende niemand kennt.");
    AddDetail("schlund",
        "Der Schlund unter dem Mauerrand wirkt bodenlos.");
    AddDetail("ende",
        "Ein Ende ist nicht auszumachen; nur Nebel und Dunkelheit warten dort unten.");
    AddDetail("fels",
        "Der Fels unter dem Nebel wirkt zerklueftet und unbarmherzig.");
    AddDetail("nebelmeer",
        "Das Nebelmeer breitet sich zwischen den Bergen aus und verschluckt jede Farbe.");
    AddDetail("tage",
        "Selbst an hellen Tagen bleibt der Mauergang nur spaerlich beleuchtet.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "festung_4" );
    AddExit( "suedosten", ROOM "festung_9" );

//--Items & NPCs-----------------------------------------------------------

}