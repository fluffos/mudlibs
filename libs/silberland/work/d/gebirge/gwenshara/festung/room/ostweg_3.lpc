#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein steiler Bergpfad");
    SetProp(P_INT_LONG,
        "Der Bergpofad windet sich hier in einer Serpentine den Hang hinauf. "
        "Eine einzelne Kiefer klammert sich an den steilen Hang, und der Boden "
        "besteht aus dem Fels des Berges. Kalter Wind weht dir um die Nase.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------
    AddDetail(({"bergpofad", "bergpfad", "pfad"}),
        "Der Bergpfad macht hier eine enge Serpentine und zwingt dich, dicht am Hang zu bleiben.");
    AddDetail(({"serpentine", "kurve", "linie"}),
        "Die Serpentine schneidet tief in den Hang und laesst den Pfad wie eine eingeritzte Linie wirken.");
    AddDetail(({"hang", "berges", "seitenblick", "wagnis"}),
        "Der Hang des Berges faellt steil ab und macht jeden Seitenblick zu einem Wagnis.");
    AddDetail(({"kiefer", "baum", "wurzeln"}),
        "Die einzelne Kiefer krallt ihre Wurzeln in den Fels und scheint trotz des Winds zu ueberleben.");
    AddDetail(({"boden", "erde"}),
        "Der Boden ist hart und rau, nur wenig Erde bedeckt den blanken Stein.");
    AddDetail(({"fels", "stein", "rissen"}),
        "Der Fels des Berges schimmert grau und ist von alten Rissen durchzogen.");
    AddDetail(({"himmel", "band"}),
        "Zwischen Hang und Kiefer blitzt ein schmales Band Himmel hervor.");
    AddDetail(({"wind", "wellen"}),
        "Der Wind ist eisig und fegt in stoessigen Wellen den Hang entlang.");
    AddDetail(({"nase", "geruch", "harz"}),
        "Der kalte Wind laesst deine Nase prickeln und traegt den Geruch von Harz heran.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "nordostoben", ROOM "ostweg_2" );
    AddExit( "ostunten", ROOM "ostweg_4" );

//--Items & NPCs-----------------------------------------------------------

    AddItem(NPC "paladin_veteran", REFRESH_DESTRUCT);
}
