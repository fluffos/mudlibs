#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein steiler Bergpfad");
    SetProp(P_INT_LONG,
        "Heir macht der Pfad eine scharfe Kehrtwende und fuehrt weiter den Berg hinauf. "
        "Die Felsen werden hier noch schroffer, und vereinzelte Kiefern klammern sich "
        "an den Hang. Der Boden ist mit losem Gestein bedeckt, und die Luft ist klar und frisch.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------
    AddDetail(({"berg", "pfad", "bergpfad", "kurve"}),
        "Der Bergpfad legt sich in einer scharfen Kurve an den Hang, als wolle er den Felsen umarmen.");
    AddDetail("kehrtwende",
        "Die Kehrtwende ist so eng, dass du dich automatisch an der Felswand abstuetzt.");
    AddDetail(({"felsen", "gestein", "felswand", "felswaenden", "felsw", "narben", "geriesel", "winds"}),
        "Die Felsen zeigen tiefe Narben des Winds und wirken wie poliert vom ewigen Geriesel.");
    AddDetail(({"kiefern", "krallenwurzeln", "staemme"}),
        "Die vereinzelten Kiefern haben knorrige Staemme und Krallenwurzeln, mit denen sie sich festhalten.");
    AddDetail(({"hang", "erde", "halt"}),
        "Der Hang steigt steil an und traegt nur wenig Erde, sodass jeder Schritt pruede fuer festen Halt sorgt.");
    AddDetail(({"boden", "st", "stiefeln", "schritt"}),
        "Der Boden ist rutschig vor losem Gestein, das unter den Stiefeln knirscht.");
    AddDetail(({"himmel", "fenster", "greifen"}),
        "Ein schmales Fenster Himmel liegt zwischen den Felswaenden und wirkt fast zum Greifen nah.");
    AddDetail(({"luft", "kaelte"}),
        "Die Luft ist klar und frisch, traegt aber die Kaelte des Berges in sich.");

//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "ostweg_1" );
    AddExit( "suedwestunten", ROOM "ostweg_3" );

//--Items & NPCs-----------------------------------------------------------

}
