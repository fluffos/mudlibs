#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein kahler Gebirgsweg");
    SetProp(P_INT_LONG,
        "Du folgst einem Nebelverhangenen, kahlen Gebirgsweg. Er fuehrt "
        "schnurstracks von Nord nach Sued und ist schon sehr ausgetreten."
        "Ein leichter Bodennebel zieht bestaendeig nach Sueden hin ab.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail(({"weg", "gebirgsweg", "pfad", "boden"}),
        "Der Weg besteht aus blankgeschliffenem Fels, der unter zahllosen "
        "Stiefeln glaenzt. Zwischen den flachen Rillen sammeln sich "
        "Schieferbrocken und harter Kies, die bei jedem Schritt leise knirschen.");
    AddDetail(({"kies", "schieferbrocken", "steine"}),
        "Graue Brocken aus Schiefer und zahniger Kies liegen in lockeren "
        "Haufen. Manche Steine glitzern feucht, andere tragen den Staub vieler "
        "Reisender und lassen erahnen, wie haeufig hier Schritte hallten.");
    AddDetail("rillen",
        "Die Rillen im Fels ziehen sich wie ausgetrocknete Bachlaeufe in Nord- "
        "und Suedrichtung. Sie geben deinen Fuessen Halt, auch wenn der Boden "
        "vor Feuchtigkeit schimmert.");
    AddDetail(({"nebel", "schleier", "nebelwasser", "nebelverhangenen"}),
        "Kaltes Nebelwasser haengt wie ein silbriger Schleier in der Luft und "
        "legt sich feucht auf deine Haut. Der Nebel riecht nach nassem Stein "
        "und einem Hauch von altem Metall.");
    AddDetail(({"bodennebel", "nebelbank", "schwaden"}),
        "Der Bodennebel kriecht in zarten Schwaden ueber den Weg, als wuerde er "
        "einem unsichtbaren Ruf gen Sueden folgen. Immer wieder reissen die "
        "Schleier auf und geben den Blick auf die dunklen Steine darunter frei.");
    AddDetail(({"felsen", "fels", "felswand", "felsplatten", "spalten", "risse"}),
        "Rauhe Felsplatten saeumen den Weg, voller Risse, an denen sich Krusten "
        "aus Flechten und kristallinem Reif festhalten. In den Spalten glimmt es "
        "schwach, als spiegelte sich fernes Wetterleuchten.");
    AddDetail("flechten",
        "Graugruene Flechten schmiegen sich an den Stein und bilden duenne, "
        "trockene Inseln inmitten des kalten Felses.");
    AddDetail("krusten",
        "Die Krusten wirken wie vernarbte Haut, die sich ueber den Fels gelegt "
        "hat und die Erinnerungen vergangener Winter bewahrt.");
    AddDetail("reif",
        "Ein hauchdunner Reif ueberzieht manchen Stein und funkelt, sobald sich "
        "das ferne Wetterleuchten darin bricht.");
    AddDetail("blick",
        "Dein Blick verliert sich schnell im schleierhaften Grau; nur grobe "
        "Konturen zeichnen den Weg nach und lassen viel Raum fuer Fantasie.");
    AddDetail("himmel",
        "Ueber dir spannt sich ein blassgrauer Himmel, in dem nur selten ein "
        "heller Fleck verraten wuerde, wo die Sonne steht.");
    AddDetail("luft",
        "Die Luft ist kuehl und schmeckt nach mineralischem Wasser. Jeder Atemzug "
        "traegt einen feinen metallischen Nachhall mit sich.");
    AddDetail("hauch",
        "Ein kaum wahrnehmbarer Hauch liegt auf allem, als hauchte das Gebirge "
        "selbst Nebel und Geheimnisse aus.");
    AddDetail("haut",
        "Feine Nebeltroepfchen setzen sich auf deiner Haut ab und hinterlassen "
        "einen kuehlen Schimmer.");
    AddDetail("metall",
        "Der metallische Ton in der Luft erinnert an rostige Werkzeuge, die lange "
        "im Regen gelegen haben.");
    AddDetail("ruf",
        "Aus dem Nebel scheint ein ferner Ruf zu wehen, vielleicht bloss ein "
        "Echo des Windes, vielleicht mehr.");
    AddDetail("schritt",
        "Jeder Schritt klingt dumpf auf dem glatten Fels und hallt kurz zwischen "
        "den Felswaenden nach.");
    AddDetail("stiefeln",
        "Auf dem Gestein zeichnen sich tiefe Spuren unzaehliger Stiefeln ab, ein "
        "Puzzle aus Reisen, Eile und Flucht.");
    AddDetail("wetterleuchten",
        "In der Ferne zuckt ein blasses Wetterleuchten und malt fluechtige Muster "
        "ueber die Felswaende.");
    AddDetail(({"stein"}),
        "Der Stein hier oben ist alt und dicht; jede Pore hat den Geschmack von "
        "Wind und sturmgeborenem Eis angenommen.");
    AddDetail("geraeusch",
        "Aus der Ferne traegt der Wind dumpfes Grollen heran, doch hier oben "
        "herrscht nur das gedempfte Knistern der Kiesel unter deinen Schritten.");
        AddDetail(({"spuren"}), 
        "Tiefe Spuren ziehen sich dicht an dicht durch den Weg.");
    AddDetail(({"konturen"}), 
        "Grobe Konturen treten im Grau nur schwach hervor.");
    AddDetail(({"echo"}), 
        "Ein kurzes Echo antwortet auf jeden Schritt und verklingt im Nebel.");
    AddDetail(({"wind"}), 
        "Der Wind weht kuehl den Hang hinab und riecht nach Stein.");
    AddDetail(({"grollen"}), 
        "Dumpfes Grollen liegt fern und schwer in der Luft.");
    AddDetail(({"knistern"}), 
        "Leises Knistern begleitet den Kies bei jedem Schritt.");
    AddDetail(({"kiesel"}), 
        "Kleine Kiesel rutschen unter den Stiefeln weg.");
    AddDetail(({"feuchtigkeit"}), 
        "Feuchtigkeit liegt als duenne Schicht auf Fels und Haut.");
    AddDetail(({"poren"}), 
        "Feine Poren im Stein wirken dunkel und dicht.");
    AddDetail(({"gestein"}), 
        "Hartes Gestein bildet eine glatte, kalte Flaeche.");
    AddDetail(({"staub"}), 
        "Feiner Staub haftet trocken an Stein und Stiefeln.");
    AddDetail(({"schimmer"}), 
        "Ein matter Schimmer liegt ueber Fels und Nebel.");
    AddDetail(({"fleck"}), 
        "Ein heller Fleck deutet den Stand der Sonne an.");
    AddDetail(({"sonne"}), 
        "Die Sonne bleibt ein blasser Schein hinter dem Grau.");
    AddDetail(({"norden","sueden"}), 
        "Der Weg zieht schnurstracks von Norden nach Sueden.");
    AddDetail(({"schritte"}), 
        "Schritte hallen kurz und verlieren sich im Nebel.");
        AddDetail("atemzug",
        "Jeder Atemzug schmeckt nach kaltem Stein und feuchtem Nebel.");
    AddDetail("bachlaeufe",
        "Verwaiste Bachlaeufe haben ihre Spuren in den Fels gegraben.");
    AddDetail("brocken",
        "Schwere Brocken liegen traege zwischen den Rillen und glimmen feucht.");
    AddDetail("eile",
        "Etwas in der Luft fluestert von alter Eile und hastigen Schritten.");
    AddDetail("eis",
        "Ein Hauch von Eis liegt ueber den Schatten und funkelt stumm.");
    AddDetail("erinnerungen",
        "Erinnerungen haften am Gestein wie Schatten vergangener Winter.");
    AddDetail("fantasie",
        "Deine Fantasie malt Gestalten in das endlose Grau.");
    AddDetail(({"felswaende","felswaenden"}),
        "Die Felswaende steigen schroff auf und verschlucken jedes Echo.");
    AddDetail("ferne",
        "In der Ferne blitzt es matt, als atmete das Wetter selbst.");
    AddDetail("flaeche",
        "Die Flaeche des Felses ist glatt und kalt wie altes Glas.");
    AddDetail("flucht",
        "Ein Hauch von Flucht schwingt in den Spuren vergangener Reisender.");
    AddDetail("fuessen",
        "Unter deinen Fuessen klingt der Fels dumpf und bestaendig.");
    AddDetail("gebirge",
        "Das Gebirge ruht schweigend, ein grauer Leib aus uraltem Stein.");
    AddDetail("geheimnisse",
        "Das Gebirge wahrt seine Geheimnisse im Nebel wie in Schlaf.");
    AddDetail("geschmack",
        "Ein mineralischer Geschmack bleibt auf der Zunge zurueck.");
    AddDetail("grau",
        "Alles ist in Grau getaucht, weich und ohne Kontur.");
    AddDetail("halt",
        "Die flachen Rillen geben dir gerade genug Halt im glatten Fels.");
    AddDetail("hang",
        "Der Hang faellt steil ab, in Nebel und verschwommene Tiefe.");
    AddDetail("haufen",
        "Lockere Haufen aus Schiefer und Kies bilden kleine Hindernisse.");
    AddDetail("inseln",
        "Die Flechten bilden kleine, raue Inseln auf dem kahlen Stein.");
    AddDetail("muster",
        "Feine Muster aus Frost und Risslinien durchziehen die Felshaut.");
    AddDetail("nachhall",
        "Ein leiser Nachhall bleibt, selbst wenn alles wieder still wird.");
    AddDetail("nebeltroepfchen",
        "Winzige Nebeltroepfchen schweben in der Luft und schimmern blass.");
    AddDetail("pore",
        "Aus jeder Pore des Steins atmet das alte Gebirge Kuehle aus.");
    AddDetail("puzzle",
        "Die Abdruecke der Stiefel formen ein Puzzle aus Geschichten.");
    AddDetail("raum",
        "Der Raum zwischen Himmel und Weg scheint seltsam still zu atmen.");
    AddDetail("regen",
        "Feiner Regen haengt unsichtbar im Nebel und kuehlt die Haut.");
    AddDetail("reisen",
        "Spuren vieler Reisen haben den Fels glattgeschliffen.");
    AddDetail("reisender",
        "Mancher Reisender mag hier innegehalten haben, bevor er verschwand.");
    AddDetail("schein",
        "Ein matter Schein bricht sich im feuchten Reif und flieht wieder.");
    AddDetail("schicht",
        "Eine duenne Schicht Feuchtigkeit liegt auf allem, kalt und klar.");
    AddDetail("schiefer",
        "Dunkler Schiefer blitzt zwischen den Kieseln hervor.");
    AddDetail("stand",
        "Der Stand der Sonne bleibt hinter dem Nebel verborgen.");
    AddDetail("suedrichtung",
        "In Suedrichtung wirkt der Nebel dichter, fast ziehend.");
    AddDetail("ton",
        "Ein metallischer Ton schwingt im Wind, kaum hoerbar.");
    AddDetail("wasser",
        "Das Wasser riecht nach Stein und schmeckt nach Frost.");
    AddDetail("werkzeuge",
        "Alte Werkzeuge koennten hier im Nebel vergessen worden sein.");
    AddDetail("winter",
        "Der Stein traegt die Narben zahlloser Winter.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "sueden",  ANSCHLUSS_GEBIRGE );
    AddExit( "norden", ROOM "weg_2");

//--Items & NPCs-----------------------------------------------------------

}
