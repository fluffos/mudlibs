    AddDetail("halbdunkel",
        "Halbdunkel verleiht allem einen beinahe mystischen Eindruck.");
    AddDetail("eindruck",
        "Der Eindruck ist zugleich ehrfurchtgebietend und beruhigend.");
    AddDetail("gesten",
        "Gesten werden klein und respektvoll gehalten.");
    AddDetail("schweigen",
        "Schweigen zaehlt hier als Zustimmung.");
    AddDetail("Schweigen",
