#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Die Halle des Burgfrieds");
    SetProp(P_INT_LONG,
        "Hier, im Herzen der Festung, ueffnet sich die Palatinhalle in erhabener Weite. "
        "Licht faellt durch ein rundes Oculusfenster auf den steinernen Boden, wo das "
        "Wappen der Goldenen Rose in Bronze eingelassen ist. Zwischen den Saeulen "
        "stehen Ritterschreine, und der Duft von Oel, Eisen und Weihrauch erfuellt den Raum.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

    AddDetail("halle",
        "Die Halle oeffnet sich weit und voller stiller Macht.");
    AddDetail("architektur",
        "Die Architektur verbindet klare Linien mit sanften Boegen.");
    AddDetail("boegen",
        "Boegen stuetzen die Kuppel wie ruhige Arme.");
    AddDetail("arme",
        "Arme aus Stein scheinen die Halle sanft zu tragen.");
    AddDetail("haende",
        "Haende aus Stein scheinen unsichtbar jede Saeule zu fuehren.");
    AddDetail("macht",
        "Macht zeigt sich hier als ruhige Praesenz.");
    AddDetail("praesenz",
        "Eine stille Praesenz haelt alles in Balance.");
