#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein Mauerweg am sueduestlichen Rand der Festung");
    SetProp(P_INT_LONG,
        "Hier zieht sich ein schmaler Weg entlang der Mauer. Moos waechst in den Fugen, "
        "und die Steine glaenzen vom Nebel. Im Osten fuehrt eine Treppe hinauf zu den "
        "Wachtgaengen ueber den Zinnen.");



//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("mauerweg",
        "Der Mauerweg zieht sich wie ein schmaler Grat entlang.");
    AddDetail("rand",
        "Am suedoestlichen Rand fuehlt sich die Festung besonders hoch an.");
    AddDetail("seite",
        "Diese Seite der Festung haengt direkt ueber den Haeusern.");
    AddDetail("festung",
        "Die Festung wirkt hier draussen rau und wachsam.");
    AddDetail("weg",
        "Der Weg bietet gerade genug Platz fuer zwei Schritte.");
    AddDetail("platz",
        "Platz fuer einen sicheren Schritt ist knapp.");
    AddDetail("schritt",
        "Jeder Schritt muss sorgfaeltig gesetzt werden.");
    AddDetail("mauer",
        "Die Mauer fuehlt sich kalt und von Nebel glitschig an.");
    AddDetail("mauerrand",
        "Der Mauerrand trennt Weg und Tiefe nur durch eine Handbreit.");
    AddDetail("moos",
        "Saftiges Moos fuellt jede Ritze mit weichem Gruen.");
    AddDetail("gruen",
        "Gruen schimmert zwischen den Steinen.");
    AddDetail("ritze",
        "Jede Ritze wirkt wie eine schmale Ader im Stein.");
    AddDetail("ader",
        "Eine einzelne Ader aus Moos zieht sich ueber den Stein.");
    AddDetail("fugen",
        "Die Fugen speichern Feuchtigkeit wie dunkle Linien.");
    AddDetail("linien",
        "Linien aus Moos ziehen sich wie feine Adern ueber den Stein.");
    AddDetail("adern",
        "Adern aus Gruen durchziehen den grauen Mauerrand.");
    AddDetail("handbreit",
        "Nur eine Handbreit Stein trennt dich vom Fall.");
    AddDetail("abgrund",
        "Direkt neben dem Weg klafft der Abgrund.");
    AddDetail("steine",
        "Glaenzende Steine spiegeln das gedaempfte Licht.");
    AddDetail("stein",
        "Der Stein ist kuehl und feucht.");
    AddDetail("fels",
        "Der Fels darunter bleibt unbewegt, egal wie nass er wird.");
    AddDetail("licht",
        "Nur ein gedaempftes Licht dringt hier herab.");
    AddDetail("nebel",
        "Nebel perlt in feinen Tropfen ueber die Kanten.");
    AddDetail("tropfen",
        "Tropfen laufen langsam zu Boden.");
    AddDetail("kanten",
        "Die Kanten der Mauer fuehlen sich vom Nebel weich geschliffen an.");
    AddDetail("osten",
        "Nach Osten lockt die Treppe zu den Gaengen.");
    AddDetail("gaengen",
        "Die Gaenge ueber der Treppe verlaufen wie schmale Buehnen.");
    AddDetail("linie",
        "Die Linie des Wegs erlaubt kein Ausweichen.");
    AddDetail("gaenge",
        "Die Gaenge zwingen jeden Schritt in eine Linie.");
    AddDetail("buehnen",
        "Die Buehnen aus Stein lassen kaum Platz fuer Patrouillen.");
    AddDetail("patrouillen",
        "Patrouillen muessen hier im Gleichtakt gehen.");
    AddDetail("gleichtakt",
        "Gleichtakt verhindert Stossen am Rand.");
    AddDetail("treppe",
        "Die Treppe schraubt sich schmal hinauf zu den Wachtgaengen.");
    AddDetail("wachtgaenge",
        "Auf den Wachtgaengen steht der Wind selten still.");
    AddDetail("wind",
        "Wind pfeift durch jede Luecke in der Bruestung.");
    AddDetail("luecke",
        "Durch jede Luecke draengt sich der Nebel.");
    AddDetail("bruestung",
        "Die Bruestung ist feucht und laeuft mit Tropfen voll.");
    AddDetail("zinnen",
        "Ueber den Zinnen wartet der Blick auf das Gebirge.");
    AddDetail("blick",
        "Der Blick schweift kurz ueber die tiefer liegenden Berge.");
    AddDetail("berge",
        "Die Berge bilden dunkle Staufen am Horizont.");
    AddDetail("staufen",
        "Staufen aus Fels staffeln sich bis zum Licht.");
    AddDetail("gebirge",
        "Hinter der Festung ragen graue Zacken des Gebirges.");
    AddDetail("zacken",
        "Zacken schneiden wie Messer in den Himmel.");
    AddDetail("gipfel",
        "Jeder Gipfel wirkt wie eine dunkle Spitze.");
    AddDetail("messer",
        "Die Gipfel wirken wie blankgezogene Messer.");
    AddDetail("horizont",
        "Der Horizont verschwimmt zwischen Nebel und Fels.");
    AddDetail("boden",
    
        "Der Boden ist feucht und glatt getreten.");
    AddDetail("feuchtigkeit",
        "Feuchtigkeit kriecht durch jede Ritze.");
    AddDetail("himmel",
        "Nur ein schmaler Streifen Himmel ist sichtbar.");
    AddDetail("streifen",
        "Der Streifen Licht wirkt wie eine duenne Klinge.");
    AddDetail("klinge",
        "Die Klinge aus Licht schneidet den Nebel auf.");
    AddDetail("schritte",
        "Schritte klingen gedaempft auf dem feuchten Stein.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "festung_6" );
    AddExit( "nordosten", ROOM "festung_9" );

//--Items & NPCs-----------------------------------------------------------

}
