#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Eine schmale Zugbruecke ueber einem Abgrund");
    SetProp(P_INT_LONG,
    "Hier endet der Grat abrupt in einer Kluft, ueber der eine hoelzerne Zugbruecke "
    "gespannt ist. Ketten aechzen leise im Wind, und aus dem Nebel dringt das "
    "ferne Klirren von Ruestungen. Jenseits der Bruecke erhebt sich das steinerne "
    "Tor der Festung, halb in den Berg geschlagen.");





//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("berg",
        "Der Berg ragt steil empor, das Tor scheint direkt in ihn hineingeschlagen.");
    AddDetail("boden",
        "Der Boden endet abrupt am Rand der Kluft, wo die Bruecke beginnt.");
    AddDetail("bruecke",
        "Die Bruecke besteht aus schweren Holzbalken, die sich leicht unter deinem Gewicht bewegen.");
    AddDetail("festung",
        "Die Festung thront ueber der Schlucht, still und unnahbar.");
    AddDetail("grat",
        "Der Grat endet hier scharf, als haette ihn jemand mit einem Messer geschnitten.");
    AddDetail("himmel",
        "Der Himmel ueber dir ist bleigrau und voller ziehender Nebelschwaden.");
    AddDetail("klirren",
        "Das ferne Klirren klingt metallisch und traegt ueber den Wind.");
    AddDetail("kluft",
        "Die Kluft unter dir verliert sich in Dunkelheit, kein Laut steigt daraus auf.");
    AddDetail("nebel",
        "Der Nebel steigt aus der Tiefe auf und legt sich ueber die Bruecke wie ein Schleier.");
    AddDetail("ruestungen",
        "Das Klirren der Ruestungen hallt unregelmaessig, als kaeme es von Wachen hinter dem Tor.");
    AddDetail("tor",
        "Das steinerne Tor ist halb in den Berg gehauen, schwer und unbewegt.");
    AddDetail("wind",
        "Der Wind pfeift durch die Ketten der Bruecke und traegt den Klang weit hinaus.");
    AddDetail("zugbruecke",
        "Die Zugbruecke schwankt leicht im Wind, die Ketten aechzen bei jeder Bewegung.");
    AddDetail("bewegung",
        "Jede Bewegung laesst die Bruecke leicht erzittern.");
    AddDetail("dunkelheit",
        "Die Dunkelheit in der Tiefe scheint endlos und still.");
    AddDetail("gewicht",
        "Das Gewicht deiner Schritte bringt die Holzbalken zum Knarren.");
    AddDetail("holzbalken",
        "Die Holzbalken sind alt, feucht und mit Metallklammern gesichert.");
    AddDetail("ketten",
        "Die Ketten aechzen bei jeder Boee und glaenzen vor Feuchtigkeit.");
    AddDetail("klang",
        "Der Klang der Ketten mischt sich mit dem Wind zu einem dumpfen Lied.");
    AddDetail("laut",
        "Kein Laut dringt aus der Tiefe empor, nur der Wind antwortet dir.");
    AddDetail("messer",
        "Der Grat endet so scharf, dass er an eine Messerklinge erinnert.");
    AddDetail("nebelschwaden",
        "Nebelschwaden treiben langsam ueber die Bruecke und verdecken kurz das Tor.");
    AddDetail("rand",
        "Der Rand der Kluft ist bruechig und faellt steil in die Tiefe.");
    AddDetail("schleier",
        "Ein Schleier aus Nebel legt sich ueber die Ketten und den Fels.");
    AddDetail("schlucht",
        "Die Schlucht unter der Bruecke ist weit und von Nebel verschluckt.");
    AddDetail("tiefe",
        "Die Tiefe darunter ist schwarz und scheint keinen Grund zu haben.");
    AddDetail("wachen",
        "Hinter dem Tor bewegen sich Wachen, kaum sichtbar im Nebel.");
    AddDetail("boee",
        "Eine ploetzliche Boee laesst die Bruecke erzittern und die Ketten singen.");
    AddDetail("fels",
        "Der Fels am Rand ist rau und broeckelt stellenweise vom Wind.");
    AddDetail("feuchtigkeit",
        "Feuchtigkeit perlt ueber das Metall und sammelt sich in kleinen Tropfen.");
    AddDetail("grund",
        "Kein Grund ist in der Tiefe zu erkennen, nur Dunkelheit und Nebel.");
    AddDetail("knarren",
        "Ein tiefes Knarren begleitet jeden deiner Schritte ueber das Holz.");
    AddDetail("lied",
        "Das dumpfe Lied aus Wind und Eisen erfuellt die Luft mit Unruhe.");
    AddDetail("messerklinge",
        "Die Messerklinge des Grats glaenzt im fahlen Licht wie geschliffener Stahl.");
    AddDetail("metallklammern",
        "Die Metallklammern halten die Bruecke zusammen, rostig, aber standhaft.");
    AddDetail("schritte",
        "Deine Schritte hallen hohl auf den Bohlen und verlieren sich im Wind.");
    AddDetail("bohlen",
        "Die Bohlen sind feucht und geben bei jedem Schritt leicht nach.");
    AddDetail("eisen",
        "Das Eisen der Ketten ist dunkel und traegt Spuren von Rost.");
    AddDetail("holz",
        "Das Holz der Bruecke ist alt, rissig und vom Wind geglaettet.");
    AddDetail("licht",
        "Blasses Licht bricht durch den Nebel und glimmt auf Metall und Holz.");
    AddDetail("luft",
        "Die Luft ist kalt und schmeckt nach Metall und Regen.");
    AddDetail("metall",
        "Das Metall glaenzt matt, feucht vom Nebel und vom Atem des Windes.");
    AddDetail("stahl",
        "Der Stahl der Ketten ist dunkel und schwer, aber ungebrochen.");
    AddDetail("tropfen",
        "Tropfen fallen von den Ketten und zerspringen auf den Bohlen.");
    AddDetail("unruhe",
        "Eine leise Unruhe liegt in der Luft, als hielte die Bruecke den Atem an.");
    AddDetail("atem",
        "Dein Atem bildet feine Schwaden, die rasch vom Wind davongetragen werden.");
    AddDetail("regen",
        "Feiner Regen mischt sich mit dem Nebel und glaenzt auf dem Holz.");
    AddDetail("rost",
        "Rost zieht roetliche Linien ueber das Metall der Ketten.");
    AddDetail("schritt",
        "Jeder Schritt klingt wie ein fernes Echo zwischen Fels und Wind.");
    AddDetail("spuren",
        "Zwischen den Bohlen siehst du alte Spuren, halb vom Regen verwischt.");



//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "weg_12" );
    AddExit( "osten", ROOM "weg_14");

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "brueckenwaechter", REFRESH_DESTRUCT);
}
