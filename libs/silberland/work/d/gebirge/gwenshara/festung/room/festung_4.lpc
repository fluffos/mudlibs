#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein kuehler Winkel unter dem Nordbogen");
    SetProp(P_INT_LONG,
        "Die Mauern hier sind hoch und beschatten den Hof. Unter steinernen Buegen "
        "liegen Stapel von Waffen und Trainingsruestungen. Von oben weht der Ruf einer "
        "Glocke aus dem Nordturm herab.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("winkel",
        "Der Winkel liegt schattig und kuehl unter dem Nordbogen.");
    AddDetail("nordbogen",
        "Der Nordbogen spannt sich schwer ueber den Hof.");
    AddDetail("mauern",
        "Hohe Mauern halten Wind und Licht zurueck.");
    AddDetail("hof",
        "Vom Hof dringen gedaempfte Stimmen herauf.");
    AddDetail("boegen",
        "Steinerne Boegen tragen die Last der oberen Gaenge.");
    AddDetail("buegen",
        "Steinerne Buegen tragen die Last der oberen Gaenge.");
    AddDetail("stapel",
        "Sauber gestapelte Ausruestung wartet auf den naechsten Drill.");
    AddDetail("ausruestung",
        "Ausruestung liegt geordnet bereit: geputzt, geoelt und straff verschnallt.");
    AddDetail("waffen",
        "Schimmernde Waffen sind sorgfaeltig geordnet.");
    AddDetail("trainingsruestungen",
        "Abgenutzte Trainingsruestungen duften nach Oel und Leder.");
    AddDetail("leder",
        "Weiches Leder knarzt leise und haelt noch Waerme.");
    AddDetail("oel",
        "Frisches Oel glitzert in feinen Spuren an Metallkanten.");
    AddDetail("ruf",
        "Ein kurzer Ruf hallt von oben durch den Winkel.");
    AddDetail("glocke",
        "Die Glocke des Nordturms schwingt langsam aus.");
    AddDetail("nordturm",
        "Vom Nordturm weht kuehler Wind herab.");
    AddDetail("bogen",
        "Der Bogen traegt still die Last und sammelt Schatten.");
    AddDetail("kuehle",
        "Dichte Kuehle haelt unter den Boegen und ordnet den Atem.");
    AddDetail("linien",
        "Steinerne Linien fuehren den Blick entlang der Pfeiler empor.");
    AddDetail("luft",
        "Die Luft ist kuehl und riecht nach Oel und Leder.");
    AddDetail(({"mauerwerk","mauerwerks"}),
        "Schweres Mauerwerk ruht sicher auf Bogen und Pfeilern.");
    AddDetail("oelfilm",
        "Ein feiner Oelfilm laesst die Metallkanten leise schimmern.");
    AddDetail("rest",
        "Ein Rest Waerme haelt im Leder, trotz des Winds.");
    AddDetail("ruestung",
        "Eine einzelne Ruestung wartet bereit: gegurtet, geputzt, geoelt.");
    AddDetail("ruhe",
        "Kuehle Ruhe liegt im Winkel und daempft den Klang.");
    AddDetail("klang",
        "Der Klang der Schritte wird von Kuehle und Stein geschluckt.");
    AddDetail("atem",
        "Der Atem geht ruhig in der Kuehle unter den Boegen.");
    AddDetail(({"pfeiler","pfeilern"}),
        "Schwere Pfeiler steigen auf und tragen Boegen und Gaenge.");
    AddDetail("blick",
        "Der Blick folgt den steinernen Linien hinauf zum Bogen.");
    AddDetail("duft",
        "Ein Duft aus Oel und Leder haengt in der Kuehle.");
    AddDetail("gaenge",
        "Obere Gaenge verlaufen dunkel hinter den Boegen und tragen die Last.");
    AddDetail("glockenklang",
        "Glockenklang perlt vom Nordturm und verweht im Wind.");
    AddDetail("last",
        "Schwere Last des Mauerwerks ruht sicher auf den Boegen.");
    AddDetail("metallkanten",
        "Metallkanten schimmern, von einem feinen Oelfilm ueberzogen.");
    AddDetail("reihen",
        "Stramme Reihen von Ruestung und Waffen, ordentlich und griffbereit.");
    AddDetail("schatten",
        "Schatten sammeln sich unter den Boegen und kuehlen die Luft.");
    AddDetail("schritten",
        "Von Schritten geglaettet, klingt der Boden nur noch leise.");
    AddDetail("spuren",
        "Feine Spuren von Oel und Drill liegen auf Stein und Leder.");
    AddDetail("stein",
        "Kalter Stein traegt Duft von Oel und die Ruhe des Winkels.");
    AddDetail("streifen",
        "Ein heller Streifen Himmel liegt schmal zwischen den Mauern.");
    AddDetail("waerme",
        "Ein Rest Waerme haelt im Leder, waehrend der Wind kuehlt.");
    AddDetail("boden",
        "Der Boden ist fest gepflastert und von Schritten geglaettet.");
    AddDetail("drill",
        "Harter Drill haelt Reihen straff und den Blick nach oben ruhig.");
    AddDetail("himmel",
        "Ein schmaler Streifen Himmel blickt blass zwischen den Mauern hervor.");
    AddDetail("licht",
        "Gedaempftes Licht bricht an Stein und schmiegt sich in Schatten.");
    AddDetail("stimmen",
        "Gedaempfte Stimmen steigen vom Hof herauf und verlieren sich.");
    AddDetail("wind",
        "Kuehler Wind traegt den Glockenklang und den Duft von Oel.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "norden", ROOM "festung_nordturm" );
    AddExit( "osten", ROOM "festung_7");
    AddExit( "westen", ROOM "festung_1");
    AddExit( "sueden", ROOM "festung_5");
    AddExit( "suedwesten", ROOM "festung_2");

//--Items & NPCs-----------------------------------------------------------
    
    AddItem(NPC "paladin_dame_selis", REFRESH_DESTRUCT);
}
