#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein schmaler Grat zwischen Nebelwaenden");
    SetProp(P_INT_LONG,
    "Hier verengt sich der Pfad zu einem bruechigen Grat, der von Nebel "
    "umhuellt ist. Der Boden unter deinen Fuessen ist glatt, und aus dem Grau "
    "ist kaum zu erkennen, wo der Weg endet.");


//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail("boden",
        "Der Boden ist glatt und feucht, als haette der Nebel ihn poliert.");
    AddDetail("fuessen",
        "Unter deinen Fuessen knirscht kaum etwas, nur glatter Stein und Wind.");
    AddDetail("grat",
        "Der Grat ist schmal und bruechig, jeder Schritt erfordert Vorsicht.");
    AddDetail("grau",
        "Alles um dich verschwimmt im Grau, ohne Form oder Entfernung.");
    AddDetail("himmel",
        "Der Himmel ist kaum zu sehen, ein blasser Schimmer ueber den Nebelwaenden.");
    AddDetail("nebel",
        "Dichter Nebel umhuellt dich, kalt und tastend wie ein lebendiges Wesen.");
    AddDetail("pfad",
        "Der Pfad verengt sich hier zu einer schmalen Linie ueber dem Abgrund.");
    AddDetail("weg",
        "Der Weg scheint sich im Grau aufzuloesen, als wolle er dich pruefen, bevor er dich weiterlaesst.");
    AddDetail("abgrund",
        "Der Abgrund faellt lautlos in dichten Nebel.");
    AddDetail("entfernung",
        "Die Entfernung verliert sich im Grau.");
    AddDetail("form",
        "Keine Form bleibt lange erkennbar.");
    AddDetail("linie",
        "Die Linie des Pfades flimmert im Nebel.");
    AddDetail("nebelwaenden",
        "Die Nebelwaende schwanken traege hin und her.");
    AddDetail("schimmer",
        "Ein matter Schimmer bricht sich im feuchten Dunst.");
    AddDetail("schritt",
        "Jeder Schritt hallt dumpf ueber den Grat.");
    AddDetail("stein",
        "Der Stein ist glatt und kuehl unter deinen Sohlen.");
    AddDetail("vorsicht",
        "Vorsicht ist hier dein einziger Halt.");
    AddDetail("wesen",
        "Etwas im Nebel wirkt lauernd und lebendig.");
    AddDetail("wind",
        "Der Wind weht stossweise und zerrt am Nebel.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "westen", ROOM "weg_3" );
    AddExit( "osten", ROOM "weg_5");

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "puma", REFRESH_DESTRUCT);
}
