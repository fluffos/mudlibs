#include "../def.h"

inherit "std/room";

void create()
{
    replace_program("/std/room");
    ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Ein kahler Gebirgsweg");
    SetProp(P_INT_LONG,
        "Der Weg durch das Gebirge, auf dem du dich hier befindest, macht "
        "hier eine harte Biegung. Links uns rechts von dir erheben sich steile "
        "Felswaende. Es gibt nur zwei Richtungen, in die du gehen kannst.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

    AddDetail(({"biegung","kurve"}),
        "Die Biegung schneidet scharf in den Fels, als habe das Gebirge selbst sie eingerissen.");
    AddDetail(({"boden","pfad"}),
        "Der Boden ist glattgetreten und kalt, mit feinen Rissen im grauen Stein.");
    AddDetail(({"felswaende","felswand"}),
        "Die Felswaende ragen steil auf und scheinen jeden Laut zu verschlucken.");
    AddDetail("gebirge",
        "Das Gebirge liegt schwer und still um dich, ein grauer Koloss aus uraltem Gestein.");
    AddDetail("himmel",
        "Ein blasser Himmel spannt sich zwischen den Waenden, farblos und fern.");
    AddDetail("weg",
        "Der Weg windet sich eng zwischen den Felsen hindurch und verliert sich in Schatten.");
    AddDetail("fels",
        "Der Fels wirkt dicht und alt, von Wind und Zeit geglaettet.");
    AddDetail("gestein",
        "Hartes Gestein zieht sich unter deinen Fuessen entlang, rau und kalt.");
    AddDetail("koloss",
        "Der graue Koloss aus Stein ruht unbewegt, als wache er ueber dich.");
    AddDetail("laut",
        "Jeder Laut hallt zwischen den Waenden wider und verfaellt schnell in Stille.");
    AddDetail("rissen",
        "Feine Risse durchziehen den Boden wie vergessene Schriftzeichen.");
    AddDetail("schatten",
        "Dunkle Schatten haften an den Felswaenden und bewegen sich kaum wahrnehmbar.");
    AddDetail("stein",
        "Der Stein ist feucht vom Nebel und riecht nach kalter Tiefe.");
    AddDetail("waenden",
        "Die Waenden ragen eng zusammen, als wollten sie den Himmel verbergen.");
    AddDetail("fuessen",
        "Unter deinen Fuessen knirscht feiner Kies und verraet jeden Schritt.");
    AddDetail("nebel",
        "Duenner Nebel zieht durch die Biegung und legt sich feucht auf Haut und Stein.");
    AddDetail("risse",
        "Die Risse im Boden wirken alt und folgen keiner erkennbaren Ordnung.");
    AddDetail("schriftzeichen",
        "Die Risse erinnern an Schriftzeichen, als wolle der Fels etwas erzaehlen.");
    AddDetail("stille",
        "Eine tiefe Stille liegt ueber allem, schwer wie der Fels selbst.");
    AddDetail("tiefe",
        "Die Tiefe zwischen den Waenden wirkt bodenlos und fluestert in der Stille.");
    AddDetail("wind",
        "Ein leiser Wind streicht durch die Spalte und traegt den Duft von Stein.");
    AddDetail("zeit",
        "Die Zeit scheint hier stillzustehen, gefangen im grauen Gestein.");


//--Ausgaenge--------------------------------------------------------------

    AddExit( "sueden", ROOM "weg_1" );
    AddExit( "nordosten", ROOM "weg_3");

//--Items & NPCs-----------------------------------------------------------
    AddItem(NPC "pagen_der_rose", REFRESH_DESTRUCT);
}
