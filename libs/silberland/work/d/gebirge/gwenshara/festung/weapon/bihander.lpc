#include "../def.h"

inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <weapon.h>

void create()
{
    ::create();

    SetProp(P_SHORT, "ein schwerer Bihander mit Rosenornamenten");
    SetProp(P_LONG,
        "Dieser Bihander wurde fuer die Paladine der Goldenen Rose geschmiedet. "
        "Auf der breiten Klinge verlaufen eingelegte Silberlinien, die beim "
        "Schwingen ein dumpfes Brummen erzeugen.");
    SetProp(P_NAME, "Bihander");
    SetProp(P_GENDER, NEUTER);
    AddId(({ "bihander", "zweihandschwert", "schwert" }));

    SetProp(P_WEAPON_TYPE, WT_SWORD);
    SetProp(P_NR_HANDS, 2);
    SetProp(P_DAM_TYPE, ({ DT_SLASH, DT_BLUDGEON }));
    SetProp(P_WC, 210);
    SetProp(P_VALUE, 2000);
    SetProp(P_WEIGHT, 6500);
}
