#include "../def.h"

inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <weapon.h>
#include <thing/material.h>

#define HERO_ALIGN 500

private int hero_bonus();
private int is_true_hero(object wielder);

void create()
{
    ::create();

    SetProp(P_SHORT, "Ein rostiges Schwert");
    SetProp(P_LONG,
        "Auf den ersten Blick wirkt dieses Schwert alt, die Klinge ist matt "
        "und rostig. Doch zwischen den rissigen Runen flackert ein kaum "
        "wahrnehmbares Licht, als erinnere sich der Stahl an grosse Taten.");
    SetProp(P_NAME, "Schwert");
    SetProp(P_NAME_ADJ, "rostig");
    SetProp(P_GENDER, NEUTER);
    AddId(({ "heldenschwert", "schwert", "klinge", "rostklinge" }));
    SetProp(P_INFO,
        "Unter der rostigen Oberflaeche schlummert die Klinge einer wahren Heldin. "
        "Nur Haende mit reinem Herzen koennen ihre Kraft erwecken.");

    SetProp(P_WEAPON_TYPE, WT_SWORD);
    SetProp(P_NR_HANDS, 1);
    SetProp(P_DAM_TYPE, ({ DT_SLASH, DT_PIERCE }));
    SetProp(P_WC, 155);
    SetProp(P_WEIGHT, 3200);
    SetProp(P_VALUE, 5500);
    SetProp(P_MATERIAL, MAT_STEEL);
    SetProp(P_HIT_FUNC, TO);
    SetProp(P_HIT_FUNC, TO);
}

int HitFunc(object enemy)
{
    return hero_bonus();
}

private int hero_bonus()
{
    object wielder;
    int bonus;

    wielder = QueryProp(P_WIELDED);
    if (!is_true_hero(wielder))
        return 0;

    bonus = 20 + random(25);
    if (!random(5) && objectp(wielder)) {
        tell_object(wielder, "Das Heldenschwert erstrahlt kurz und verstaerkt deinen Schlag.\n");
        return bonus * 2;
    }

    return bonus;
}

private int is_true_hero(object wielder)
{
    if (!objectp(wielder))
        return 0;
    if (wielder->QueryProp(P_ALIGN) <= HERO_ALIGN)
        return 0;

    return wielder->QueryProp(P_LEVEL) >= 40;
}
