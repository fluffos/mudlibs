#include "../def.h"

inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <weapon.h>
#include <material.h>

void create()
{
    ::create();

    SetProp(P_SHORT, "Eine Glanzklinge der Rosenwacht");
    SetProp(P_LONG,
        "Diese breite Klinge wurde aus poliertem Stahl geschmiedet und mit feinen "
        "Silberadern verstaerkt. Ein Rosenrelief zieht sich vom Parierelement bis zur "
        "Spitze und scheint im Licht schwach zu leuchten.");
    SetProp(P_NAME, "Glanzklinge");
    SetProp(P_GENDER, FEMALE);
    AddId(({ "glanzklinge", "schwert", "rosenklinge", "klinge" }));

    SetProp(P_WEAPON_TYPE, WT_SWORD);
    SetProp(P_NR_HANDS, 1);
    SetProp(P_DAM_TYPE, ({ DT_SLASH, DT_HOLY }));
    SetProp(P_WC, 160);
    SetProp(P_WEIGHT, 1200);
    SetProp(P_VALUE, 4500);
    SetProp(P_MATERIAL, ([ MAT_STEEL:85, MAT_SILVER:15 ]));
}
