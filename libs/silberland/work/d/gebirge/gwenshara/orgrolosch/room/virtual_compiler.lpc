#include "../def.h"
#include "/p/daemon/pcgd/pcgd.h"

inherit "std/virtual/v_compiler.lpc";

#include <v_compiler.h>

private mapping map;

void create() 
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "vc_room");

  map = PCGD->LayoutPathToMap(PCG_LAYOUT_BIVARIANT_LINEAR, ({MAP_NODE_START, MAP_NODE_UNDEF, ({MAP_NODE_UNDEF, MAP_NODE_UNDEF}),MAP_NODE_UNDEF, MAP_NODE_END}));
  SetProp("map", map);
}

public mixed Validate(string file) {
    string name, foo, bar;
    int x, y, z;
    DB("validate\n");

    file = ::Validate(file);

    if(sscanf(file, "%d:%d:%d", x, y, z) == 3) {
        if(map[y][x] != 0) return x + ":" +  y + ":" + z;
        DB(sprintf("invalid room: %d:%d:%d\n", x, y, z));
        return 0;
    }

    DB(sprintf("sscanf failed: %s\n", file));
    return 0;
}

public mixed CustomizeObject() {
    string name;
    int x, y, z;

    DB("Customizing...\n");

    if (!(name = ::CustomizeObject()) || sscanf(name, "%d:%d:%d", x, y, z) != 3) return 0;

    DB(sprintf("Cusotmizing: %s\n", name));
    PCGD->LoadBiome(BIOMES "tunnel");
    DB("biome loaded\n");
    DB(sprintf("describeRoom ret = %d",  PCGD->DescribeRoom(BIOMES "tunnel", PO, 5, PCG_EACH_BUCKET_ONE|PCG_CONTENT_ONLY_ONCE, 0.7)));

    if(map[y][x][PCG_L_EXITS]&PCG_EXIT_EAST) PO->AddExit("osten", sprintf("%s%d:%d:%d", ROOM, x+1, y, z));
    if(map[y][x][PCG_L_EXITS]&PCG_EXIT_NORTH) PO->AddExit("norden", sprintf("%s%d:%d:%d", ROOM, x, y-1, z));
    if(map[y][x][PCG_L_EXITS]&PCG_EXIT_WEST) PO->AddExit("westen", sprintf("%s%d:%d:%d", ROOM, x-1, y, z));
    if(map[y][x][PCG_L_EXITS]&PCG_EXIT_SOUTH) PO->AddExit("sueden", sprintf("%s%d:%d:%d", ROOM, x, y+1, z));

    PO->SetProp("type", map[y][x][PCG_L_TYPE]);

    DB("Customizing done.\n");
    return 1;
}