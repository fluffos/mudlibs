#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/room";

int humus, wasser, erz, feuer, eis, luft, closeAgain;

void create()
{
  ::create();
  humus = wasser = erz = feuer = eis = luft = 0;
  closeAgain = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Am Eingang einer magisch versiegelten Hoehle");
  SetProp(P_INT_LONG,
    "Vor dir erhebt sich eine hohe Felswand aus dunklem Gestein. In die Wand "
    "wurde aus goldenen Linien das Abbild eines Tores eingelassen. An jeder Seite "
    "dieses Tores findest du drei ringfoermige Einbuchtungen. In der Mitte sind "
    "grosse goldene Lettern eingelassen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "wand", "felswand", "fels" }),
    "Vor dir rangt eine hohe Felswand aus dunklem Gestein in den Himmel.");

  AddDetail( ({ "stein", "gestein" }),
    "Das Gestein der Felswand ist merkwuerdig dunkel. Es scheint dir so, als wuerde "
    "sich darin ein sanftes Kraeuseln bewegen.");

  AddDetail( ({ "linien", "goldlinien" }),
    "Feine Linien aus Gold wurden in die Felswand eingelassen. Sie erzeugen das "
    "Abbild eines grossen Tores.");

  AddDetail( ({ "abbild", "tor", "tores", "tors", "linien", "goldlinien" }),
    "Die feinen Goldlinien bilden ein Tor zu dessen Seiten sich sechse ringfoermige "
    "Einbuchtungen befinden. Grosse, ebenfalls goldene, Lettern sind genau in der "
    "Mitte eingelassen.");

  AddDetail( ({ "einbuchtungen" }),
    "Links und rechts des Tores befinden sich jeweils drei, etwa einen Zentimeter "
    "durchmessende, ringfoermige Einbuchtungen. Du kannst dir jede davon genauer ansehen "
    "(untersuche <seite> obere|mitttlere|untere einbuchtung, z.B. 'untersuche linke obere "
    "einbuchtung').");

  AddDetail( ({ "mitte", "lettern", "nachricht" }),
    "In geschwungenen Lettern wurde in der Mitte des Tores eine Nachricht hinterlassen.");

  AddReadDetail( ({ "nachricht", "mitte", "tor", "lettern" }),
    "Dort steht:\n"
    "Dieser Weg ist versperrt.\n"
    "Die Elemente halten ihn.\n"
    "Dieser Weg ist versperrt.\n"
    "Die Nacht liegt dahinter.\n"
    "Dieser Weg ist versperrt.\n"
    "Sechs Waechter wachen ueber das Siegel.\n"
    "Dieser Weg ist versperrt.\n"
    "Das Wort bindet die Finsternis.\n");

  AddDetail( ({ "himmel" }),
    "Duester droht der Himmel ueber dir. Keine Wolke ist zu sehen, aber auch keine Sonne.");

  AddDetail( ({ "wolke", "sonne" }),
    "Nicht zu sehen...");

  AddDetail( ({ "kraeuseln" }),
    "Unter der dunklen Oberflaeche des Steins scheinen sich dunkle Schlieren zu bewegen.");

  AddDetail( ({ "gold" }),
    "Es scheint dir echtes Gold zu sein!");

  AddDetail( ({ "seiten", "seite" }),
    "Links und rechts befinden sich jeweils drei Einbuchtungen.");

  AddDetail( ({ "zentimeter" }),
    "Ja, etwa ein Zentimeter. Ungefaehr so, wie ein Finger.");

  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des Gesteins ist hart.");

  AddDetail( ({ "schlieren" }),
    "Ab und an blitzen unter diesen Schlieren helle Einschluesse hervor.");

  AddDetail( ({ "einschluesse" }),
    "Sieht fast aus, wie Diamanten, die da tief im Fels verborgen sind.");

  AddDetail( ({ "diamanten" }),
    "Moment mal! Das sind ja Sterne!");

  AddDetail( ({ "sterne" }),
    "Du kannst es kaum glauben, doch es scheint, als wuerde unter dem Fels, durch "
    "dunkle Schlieren hindurch der Nachthimmel zu erkennen sein.");

  AddDetail( ({ "nachthimmel" }),
    "Unglaublich. Hier ist es doch immer Tag!");

  AddDetail( ({ "tag" }),
    "Ja, du bist dir sicher: Hier gibt es keine Nacht.");

  AddDetail( ({ "nacht" }),
    "Die befindet sich wohl auf der anderen Seite des Tors.");

  AddDetail( ({ "finger", "form", "groesse" }),
    "Die Einbuchtungen haben etwa die Form und Groesse eines Rings.");

  AddDetail( ({ "ring", "rings" }),
    "Sehr merkwuerdig.");

  AddDetail( ({ "boden" }),
    "Der Boden ist mit Geroell uebersaeaet.");

  AddDetail( ({ "geroell" }),
    "Nicht weiter interessant.");

  AddSpecialDetail( ({ "linke obere einbuchtung" }),
    "detail_ring_humus"); 

  AddSpecialDetail( ({ "linke mittlere einbuchtung" }),
    "detail_ring_wasser");

  AddSpecialDetail( ({ "linke untere einbuchtung" }),
    "detail_ring_erz");

  AddSpecialDetail( ({ "rechte obere einbuchtung" }),
    "detail_ring_luft");

  AddSpecialDetail( ({ "rechte mittlere einbuchtung" }),
    "detail_ring_eis");

  AddSpecialDetail( ({ "rechte untere einbuchtung" }),
    "detail_ring_feuer");

  AddCmd( ({"setz", "setze", "steck", "stecke", "gib", "gebe"}), "cmd_einbuchtung");

  AddItem(NPC "orasimandolias", REFRESH_DESTRUCT);

  AddExit("osten", ANSCHLUSS_GEBIRGE);
}

public int cmd_einbuchtung(string str) {
    string what, seite, pos, extra, element;
    object item;
    int blocked;

    notify_fail("Was willst du in welche Einbuchtung setzen?\n");
    if(!str || str == "") return 0;
    if(sscanf(str, "%s in %s %s einbuchtung", what, seite, pos) != 3) return 0;

    
    if(objectp(present("\ngwenshara_hoehle_portal"))) {
        write(BS("Das Portral wurde bereits geoeffnet!"));
        return -1;
    }
    
    if(!objectp(item=present(what, TP))) {
        write(BS("Sowas hast du gar nicht dabei!"));
        return -1;
    }

    if(seite != "linke" && seite != "rechte") {
        write(BS("In welche Einbuchtung willst du das setzen? (linke obere, rechte mittlere, ...)"));
        return -1;
    }

    if(pos != "obere" && pos != "mittlere" && pos != "untere") {
        write(BS("In welche Einbuchtung willst du das setzen? (linke obere, rechte mittlere, ...)"));
        return -1;
    }

    if(!item->id(ELEMENT_RING_FEUER) && !item->id(ELEMENT_RING_WASSER) && 
       !item->id(ELEMENT_RING_ERZ) && !item->id(ELEMENT_RING_LUFT) && 
       !item->id(ELEMENT_RING_HUMUS) && !item->id(ELEMENT_RING_EIS)) {
        write(BS("Hm. Das passt da nicht rein."));
        return -1;
    }

    if(seite == "linke") {
        switch(pos) {
            case "obere":    element = HUMUS; break;
            case "mittlere": element = WASSER; break;
            case "untere":   element = ERZ; break;
        }
    } else {
        switch(pos) {
            case "obere":    element = LUFT; break;
            case "mittlere": element = EIS; break;
            case "untere":   element = FEUER; break;
        }
    }

    blocked = 0;
    switch(element) {
        case HUMUS: blocked = humus; break;
        case WASSER: blocked = wasser; break;
        case ERZ: blocked = erz; break;
        case LUFT: blocked = luft; break;
        case EIS: blocked = eis; break;
        case FEUER: blocked = feuer; break;
    }
    if(blocked) {
        write(BS("In dieser Einbuchtung steckt bereits ein Ring!"));
        return -1;
    }

    write(BS("Du setzt " + item->name(WEN) + " in die Einbuchtung."));
    say(BS(TPN+ " setzt einen Ring in eine Einbuchtung."));

    if(!item->id(ELEMENT_RING_+element)) {
        write(BS("Mit einem lautem Knall explodiert er!"));
        say(BS("Mit einem lauten Knall explodiert!"));
        SetProp(P_KILL_NAME, "Die Macht eines elementaren Siegels");
        TP->do_damage(20);
    } else {
        write(BS("Ein sanftes gluehen geht von der Einbuchtung aus."));
        say(BS("Ein sanftes gluehen geht von der Einbuchtung aus."));

        switch(element) {
            case HUMUS: humus = 1; break;
            case WASSER: wasser = 1; break;
            case ERZ: erz = 1; break;
            case LUFT: luft = 1; break;
            case EIS: eis = 1; break;
            case FEUER: feuer = 1; break;
        }
    }

    call_out("CheckAll", 2);
    return 1;
}

public void CheckAll( ) {
    object ob;
    if(!humus || !wasser || !erz || !luft || !eis || !feuer) return;

    tell_room(TO, BS("Die goldenen Linien leuchten auf und in der Mitte des Tors oeffnet sich ein Durchgang."));
    AddExit("durchgang", ([
        EX_DEST: ANSCHLUSS_NACHT,
        EX_MSG: "in die Finsternis des Durchgangs"
    ]));
    closeAgain = time () + 14400; // durchgang bleibt 4 stunden offen
}

public void resetState() {
  if(humus | wasser | erz | feuer | eis | luft) {
    tell_room(TO, BS("Das Gluehen der Ringe verlischt und sie zerfallen zu Staub."));
  }

  humus = wasser = erz = feuer = eis = luft = 0;

  if(member(QueryProp(P_EXITS), "durchgang")) {
      tell_room(TO, BS("Der Durchgang schliesst sich grollend."));
      RemoveExit("durchgang");
  }
}

public void reset() {
    ::reset();

    if(time() > closeAgain && member(QueryProp(P_EXITS), "durchgang")) resetState();
}

public string detail_ring_humus() {
    string str;
    str = "In der Mitte der Einbuchtung sind zwei konzentrische Kreise eingemeisselt. ";
    if(humus) str += "Ein Humusring wurde darin eingesetzt und pulsiert in gruenem Gluehen.";
    else str += "Sie ist leer.";
    return BS(str);
}

