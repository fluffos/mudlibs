    string str;
    str = "In der Mitte der Einbuchtung sind zwei Wellenlinien eingemeisselt. ";
    if(wasser) str += "Ein Wasserring wurde darin eingesetzt und pulsiert in blauen Gluehen.";
    else str += "Sie ist leer.";
    return BS(str);
}

