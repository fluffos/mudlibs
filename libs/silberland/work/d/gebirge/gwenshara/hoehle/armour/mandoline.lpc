inherit "/gilden/bardengilde/instrument/base_string";

#include <properties.h>
#include <combat.h>
#include "/p/std/barden/instrument.h"
#include "../def.h"

public void create() {
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Mandoline");
  SetProp(P_LONG, 
	  BS("Die Mandoline ist aus Holz gefertigt und hat einen dicken Bauch, der als "
       "Klangkoerper dient. Sie ist mit kupfernen Saiten bespannt. Ein kundiger "
       "Musiker kann auf ihr rasche Melodien spielen.")); 
  SetProp(P_NAME, "Mandoline");
  SetProp(P_GENDER, FEMALE);
  AddId(({"mandoline"}));
  SetProp(P_INSTRUMENT_LEVEL, 5);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_WOOD:75, MAT_COPPER: 25]));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}














