#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";
inherit "/gilden/bardengilde/obj/std_spellprovider";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Orasimandolias sitzt hier und spielt seine Mandoline");
  SetProp(P_LONG,
    "Vor dir sitzt ein Mensch im buten Gewand eines Barden. Seine Laute hat "
    "hat er umgeschnallt und spielt darauf ein paar schnelle Lieder. Leider "
    "sind all seine Lieder irgendwie traurig. Sein braunes Haar faellt wellig "
    "unter seinem Hut hervor und seine blaue Augen wirken ebenso traurig. Ein "
    "heller Stern umkreist ihn.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Orasimandolias");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"orasimandolias", "NOCONTROL", "NOWIMPY", "Schwertexperte"}));
  AddClass( ({ CL_HUMAN }) );

  set_living_name("orasimandolias");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_GUILD, "bardengilde");
  SetProp(P_GUILD_LEVEL, 8);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_LIGHT, 1); // aktive ode an die sterne :)
  SetProp(P_SIZE, 160);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" bedankt sich dafuer.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_SOUND:    -0.2]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "spielt auf seiner Mandoline.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"tor","durchgang", "wand", "felswand"}),
    "Das Tor, das hier in den Felsen eingelassen ist, ist ein magisches Siegel. Es "
    "heisst, dass es von einem maechtigen Druiden geschaffen wurde, um eine Kreatur "
    "der Nacht darin zu bannen. Meine Liebste, Giseleha, konnte es oeffnen und ist "
    "hindurch gegangen! Seit dem ist sie verschollen. Alles was sie dabei hatte war "
    "ihr Druidenamulett und Abenteurerausruestung.",
    "sagt: ");

  AddInfo( ({"ausruestung", "abenteurerausruestung"}),
    "Fackeln, Seile, Schaufeln und solche Dinge eben. Was man braucht, wenn mann "
    "auf Abenteuer zieht.", "sagt: ");

  AddInfo( ({"amulett", "druidenamulett"}),
    "Das ist die Insignie der Druiden, die hilft die elementare Macht zu fokussieren.",
    "sagt: ");

  AddInfo( ({"druide", "druiden"}),
    "Ein alter Druide hat diesen Bann geschaffen. Mehr weiss ich darueber leider auch nicht. "
    "Aber vermutlich benoetigt das Tor irgendwelche Elementargegenstaende, um geoffnet zu werden.",
    "sagt: ");

  AddInfo( ({"hilfe"}),
     "Wenn es dir nur gelingen koennte dieses Tor zu oeffnen und das Uebel darin "
     "gefangen zu halten... dann waere mir und dem Silberland geholfen!", "sagt: ");

  AddInfo( ({"gegenstaende"}),
    "Keine Ahnung was genau es war. Irgendetwas, das Druiden eben verwenden.", "sagt: ");

  AddInfo( ({"elemente"}),
     "Es heisst, dass dieses Tor ein altes Siegel der Element verbirgt, das ein "
     "finsteres Uebel gefangen haelt. Die Geschichten darum sind wage. Doch meine "
     "Liebste, Giseleha, ist selbst Druidin und wollte sichergehen, dass das Siegel "
     "erneuert wird, bevor die Kreatur sich daraus befreit. Es heisst, die maechtige "
     "Kraft der Element beschuetzt diesen Weg.", "sagt: ");

  AddInfo( ({"liebste", "giseleha"}),
    "Giseleha und ich sind hier her gekommen, um dieses Tor zu oeffnen. Sie hat "
    "es hindurch geschafft, ich nicht. Seit sie weg ist, ist mein Herz so leer. "
    "Ich fuerchte, sie wird nie mehr zurueck kehren.",
    "seufzt: ");

  AddInfo( ({"sieben schritte", "lied"}),
    "Das Lied 'Sieben Schritte' webt ein besonderes Band zwischen zwei Lebewesen. "
    "Eine fast undurchdringliche Freundschaft. Es ist eines meiner besten Lieder. "
    "Doch ohne meine Liebste fehlt mir der Wille es jemandem zu zeigen. Wenn mir "
    "ein Barde durch zumindest einen Beweis ihres Ablebens bringen koennte, so "
    "koennte ich innerlich abschliessen...", "sagt: ");

  AddInfo( ({"kreatur", "nacht", "kreatur der nacht", "uebel"}),
    "Ich weiss nicht, worum es sich handeln koennte. Giseleha meinte, dass es "
    "eine schreckliche Kreatur von der finsteren Seite des Silberlands sein muss. "
    "Sie wollte den Bann des alten Druiden hier erneuern. Doch ich fuerchte, "
    "das ging schief.", "sagt: ");

  AddInfo( ({"siegel", "tor"}),
    "Ich weiss leider nicht, wie man dieses Siegel oeffnet oder schliesst. Giseleha hatte "
    "irgendwelche Gegenstaende dabei, die den Durchgang oeffnen konnte, der von "
    "hier zu diesem Siegel fuehren soll.", "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 50);

  AddSpell(2, 200,
    "Eine Flamme rast von "+Name(WEM)+" aus auf dich zu!\n",
    "Eine Flamme rast von "+Name(WEM)+" aus auf @WEN zu!\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 150,
    Name(WER)+" singt ein schrilles Vibrato, das in deinen Ohren schmerzt!\n",
    Name(WER)+" singt ein schrilles Vibrato!\n", DT_SOUND, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 100, 
    Name(WER)+" schlaegt dir ins Gesicht.\n",
    Name(WER)+" schlaegt @WEM ins Gesicht.\n", DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 350, 
        Name(WER)+" ruft: \"Nimmermehr!\" und deutet auf dich.\n",
        Name(WER)+" ruft: \"Nimmermehr!\" und deutet auf @WEN.\n", DT_MIND, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_DEAF,
    Name(WER)+ " singt ein schrilles Vibrato, das in deinen Ohren schmerzt!\n",
    Name(WER)+" singt ein schrilles Vibrato!\n");

  AddDefaultSpell(1, 1, DS_SLOW,
        Name(WER)+" singt ein Schlaflied.\n",
        Name(WER)+" singt ein Schlaflied.\n");
  
//--Chats------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" spielt auf seiner Mandoline.\n",
    Name(WER, 1)+" seufzt traurig.\n",
    Name(WER, 1)+" fragt: Oh liebste Giselahea, wo bist du nur?\n",
    Name(WER, 1)+" fragt: Ich hoffe das Siegel ist noch verschlossen...\n",
    Name(WER, 1)+" singt ein trauriges Lied.\n",
    Name(WER, 1)+" untersucht die Felswand.\n",
    Name(WER, 1)+" fragt: Kannst du herausfinden, wie man das Tor oeffnet?\n",
    Name(WER, 1)+" laesst seine Finger geschickt ueber die Mandoline gleiten.\n",
    Name(WER, 1)+" singt die Rabenballade.\n",
    Name(WER, 1)+" stimmt seine Mandoline.\n",
    Name(WER, 1)+" singt die Ode an die Sterne.\n"
   }) );

   AddLibrary("/gilden/bardengilde/libs/allgemein.lib", 1);

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/sword/stossdegen" );
  command("zuecke stossdegen");

  CLONEME(ARMOUR "mandoline" );
  CLONEME("/p/armour/helm/hut");
  CLONEME("/p/armour/cloak/umhang");
  CLONEME("/p/armour/trousers/seidenhose");
  CLONEME("/p/armour/armour/hemd");
  CLONEME("/gilden/bardengilde/armour/bbrosche");
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

public int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
    string *dt;

    if(!pointerp(dam_type)) {
        dt = ({ dam_type });
    } else {
        dt = dam_type;
    }

    if(spell != 0 && !random(3)) {
        if(QueryProp("lorica")) {
          if(!random(3)) {
              tell_room(ENV(TO), BS("Regenbogenfarbenes Licht flackert um "+ TO->Name(WEN) +" herum auf und absorbiert den Angriff!"));
              return ::Defend(0, dt, spell, enemy);
          } else {
              tell_room(ENV(TO), BS("Regenbogenfarbenes Licht flackert um "+ TO->Name(WEN) +" herum auf und schwaecht den Angriff ab!"));
              return ::Defend(dam/2, dt, spell, enemy);
          }

          if(!random(4)) {
            tell_room(ENV(TO), BS("Das regenbogenfarbene um " + name(WEN, 1) + " verblasst."));
            SetProp("lorica", 0);
          }
        }
    }

    if(!random(2) && !QueryProp("lorica")) {
      tell_room(ENV(TO), BS(sprintf("Ein regenbogenfarbenes Netz schimmert kurz um %s auf.\n", name(WEN, 1))));
      SetProp("lorica", 1);
    }

    if(!random(5) || 
       member(dt, DT_FIRE) > -1 || 
       member(dt, DT_EXPLOSION) > -1 || 
       member(dt, DT_PIERCE) > -1) {

      if(!QueryProp("no_schutz")) {
        tell_room(ENV(TO), BS(Name(WESSEN, 1)+" Ruestung vibriert kurz und gibt die Tonleiter von sich!"));

        if(!random(7)) {
          tell_room(ENV(TO), BS("Die Schutzmelodie um " + Name(WEN) + " verklingt!"));
          SetProp("no_schutz", 1);
        }
      } else {
        tell_room(ENV(TO), BS(Name(WESSEN, 1) + " Ruesting vibriert im Schall einer Zaubermelodie."));
        SetProp("no_schutz", 0);
      }
        return ::Defend(dam/2, dt, spell, enemy);
    }

    return ::Defend(dam, dt, spell, enemy);
}

private void alestra_reduced_attack(object target, int inspiration) {
  object ob;

  if(!objectp(ob=present("\nbard_passive_weakness", target))) {

    ob = clone_object("/gilden/bardengilde/obj/alestra_reduce_atk");
    if(ob->move(target, M_NOCHECK|M_GET) != 1) {
      ob->remove(1);
      ob = 0;
    }
  }

  if(objectp(ob)) {
    ob->Setup(inspiration);
  }

  target->UpdateAttributes();

  return;
}

public void Attack(object enemy) {
    if(!random(3)) {
        enemy->Defend(50+random(150), DT_COLD, ([SP_NAME:"haette ich ein herz", SP_SHOW_DAMAGE: 1]), TO);
        if(!random(5)) {
            tell_object(enemy, BS("Eine Welle der Verzweiflung geht von " + Name(WEM, 1)+" aus und laesst dich kraftlos werden!"));
            alestra_reduced_attack(enemy, 5);
        }
    }

    ::Attack(enemy);
    return;
}

public void give_notify(object ob) {
  if(ob->id("\ngwenshara_siegel_amulett") && TP->QueryProp(P_GUILD) == "bardengilde" && TP->QuerySkill("sieben schritte") == 0) {
    LearnBardSpell(TP, "sieben schritte",
                   "Dieses Lied verzaubert ein Lebewesen, dass es dich als Freund betrachtet und beschuetzen "
                   "wird. Doch uebertreibe es nicht! Nicht alle werden bis Tod kaempfen und wenn eure "
                   "Weltanschauung zu weit auseinander liegt, mag es dir auch nicht gelingen.",
                   "spiele 'sieben schritte' auf <ziel>");
    command_me("sag Vielen Dank, " + TPN + "! Nun weiss ich zumindest, dass sie tot ist.");
    command_me("emote weint bitterlich.");
    ob->remove(1);
  }
}
