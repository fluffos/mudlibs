#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein scharfes Skalpell");
  SetProp(P_LONG,
    "Dieses Skalpell ist aeusserst scharf, schaerfer als jede Rasierklinge, "
    "die du kennst. Es ist besonders gut dazu geeignet Operationen durchzufuehren, "
    "oder sehr blutige Wunden zu verursachen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Skalpell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"skalpell"}) );

  SetProp(P_NAME_ADJ, "scharf" );
  AddAdjective( ({"scharfen","scharfer","scharfem","scharfes","scharfe"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_TITANIUM );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 20);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 110);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );

  SetProp(P_WC_BONUS, (["\ngeisterhaus_zarisa": 200]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Wer nicht gut damit umgehen kann, laeuft Gefahr sich zu schneiden!"));
}

int WieldFunc(object waffe) 
{
  if(TP->QuerySkill(FIGHT(WT_KNIFE)) == 0 && !random(2)) {
    tell_object(ENV(TO), BS("Aua! Als du das Skalpell angreifst schneidest du dich."));
    ENV(TO)->AddHp(-random(20));
  }

  return 1;
}

int UnwieldFunc(object waffe) 
{
  
  if(TP->QuerySkill(FIGHT(WT_KNIFE)) == 0 && !random(2)) {
    tell_object(ENV(TO), BS("Aua! Als du das Skalpell angreifst schneidest du dich."));
    ENV(TO)->AddHp(-random(20));
  }

  return 1;
}
