#include "../def.h"
#include <exploration.h>

inherit "std/npc";
inherit "/std/npc/spells";

private int drinking;

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  drinking = 0;

  SetProp(P_SHORT, "Ein struppiger schwarzer Kater namens 'Beelzebub' treibt sich hier herum");
  SetProp(P_LONG,
    "Dieser Kater ist besonders reudig und struppig. Sein schwarzes fell ist "
    "mittellang und an einigen Stellen ziemlich verfilzt. Seine gelben Augen "
    "blicken dich - etwas zu - intelligent an. Ab und zu glaubst du, dass sie "
    "sogar aufgluehen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Beelzebub");
  SetProp(P_GENDER, MALE);
  AddId(({"kater", "beelzebub", "katze"}));
  AddClass( ({CL_ANIMAL, CL_DEMON}) );
  SetProp(P_ARTICLE, 0);

  SetProp(P_INFO, BS("Das ist eigentlich gar keine Katze, sondern ein Daemon."));

  set_living_name("beelezbubderschwarzekater");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20);

  SetProp(P_HANDS, ({" mit seinen scharfen Krallen",
                    QueryProp(P_HANDS)[1],
                    ({DT_UNHOLY, DT_MAGIC})
                    }) );

  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 8000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_NOMAGIC, 30);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" hat keine Daumen um das zu halten.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:     -0.1, DT_WATER:       0.1,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.2,
       DT_SOUND:     0.1, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.5,
       DT_HOLY:      0.2, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.1,
       DT_MIND:      0.1, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");
  SetProp(P_MMSGIN, "erscheint in einem Pentagramm aus Flammen");
  SetProp(P_MMSGOUT, "verschwindet zischend im Erdboden");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " loest sich in einen Schwarm aus Fliegen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Das kommt davon, wenn man sich vom ersten Eindruck taeuschen laesst...");
  SetProp(P_KILL_MSG, "Ich komme wieeeeedeeeer!");

//--Infos------------------------------------------------------------------

  SetChats(1,
  ({Name(WER, 1)+" putzt sein Fell.\n",
    Name(WER, 1)+" blickt dich mit ueberaus intelligenten Augen an.\n",
    Name(WER, 1)+" schnueffelt an deiner Hand.\n",
    Name(WER, 1)+" wuergt einen Haarballen hoch.\n",
    Name(WER, 1)+" kratzt sich hinterm Ohr.\n",
    Name(WER, 1)+" maunzt klaeglich.\n",
    Name(WESSEN, 1)+" Augen lodern kurz gelb auf.\n",
    Name(WER, 1)+" sagt: Miau!.\n",
    Name(WER, 1)+" setzt sich hin.\n",
    Name(WER, 1)+" wandert zwischen deinen Beinen hindurch.\n",
    Name(WER, 1)+" schaerft seine Krallen an deiner Hose.\n",
    Name(WER, 1)+" leckt sich den Po.\n"
   }) );

  AddInfo(DEFAULT_INFO, " maunzt dich an.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"beelzebub", "daemon"}),
    "Okay. Hoer zu: Ich bin der leibhaftige Beelzebub! Wirklich. Irgend so ein "
    "bleiches Goer hat versucht mich zu beschwoeren und dabei einen Fehler gemacht. "
    "Jetzt stecke ich hier in diesem Katzenkoerper fest. Ehrlich!",
    "sagt: ");

  AddInfo( ({"hilfe", "helfen"}),
    "Helfen? Klar kannst du mir helfen. Hilf mir aus diesem Koerper zu entkommen "
    "und mein RACHEEEE zu nehmen.", "maunzt: ");

  AddInfo( ({"koerper", "katzenkoerper"}),
    "Ich stecke nur in diesem Koerper, weil die Beschwoerung nicht vollendet wurde!", "miaut: ");

  AddInfo( ({"beschwoerung", "anrufung"}),
    "Mittwoch, das dumme Goer, hat meine unheilige Anrufung einfach vollkommen versaut! "
    "Aber du kannst das wieder richten. Dem Ritual haben wichtige Zutaten gefehlt!", "maunzt: ");

  AddInfo( ({"zutaten"}),
    "Aeh... ich meine natuerlich nicht Zutanten, sonder... aeh... Komponenten!", "stammelt: ");

  AddInfo( ({"komponenten"}),
    "Besorge eine Ananas, eine Kokosnuss, Milch und eine Flasche Rum. Dann musst du nur mein "
    "Rezept befolgen.", "sagt: ");

  AddInfo( ({"rezept"}),
    "Rezept? Nein. Da hast du dich verhoert. Du musst das Ritual korrekt durchfuehren!", "miaut: ");

  AddInfo( ({"ritual"}),
    "Also. Wenn du die Ritualkomponenten hast, dann musst du sie in der Kueche in den "
    "Cocktailshaker... aeh in den Zaubertrankmischer fuellen und gut schuetteln. "
    "Dann bekommst du einen Zaubertrank, den ich brauche, um mich dieser laestigen, haarigen "
    "Huelle zu entledigen!", "jammert: ");

  AddInfo( ({"ananas", "kokosnuss"}),
    "Ich habe gehoert, dass es die im Dschungel geben soll.", "fluestert: ");

  AddInfo( ({"milch"}),
    "Die beste Milch gibt es am Bauernhof bei Midas. Also sie ist die beste, weil "
    "sie am besten fuer das unheilige Ritual geeignet ist.", "fluestert: ");

  AddInfo( ({"rum"}),
    "Keine Ahnung. In irgendeiner Kneipe wirst du den schon finden.", "sagt: ");

  AddInfo( ({"thermoskann"}),
    "Hab keine mehr. Die hab ich einem Hoehlenforscher geborgt, der damit "
    "verschwunden ist.", "miaut: ");

  AddInfo( ({"mittwoch"}),
    "Mittwoch ist ein doofes Goer. Sie hat mich hier gebunden.", "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 60);

  AddSpell(2, 250,
    Name(WER) + " kratzt dich mit seinen Krallen.\n",
    Name(WER) + " kratzt @WEN mit seinen Krallen.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 200,
    Name(WER)+" faucht dich an!\n",
    Name(WER)+" faucht @WEN an!\n", DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

    AddSpell(1, 250,
      Name(WER)+" sagt: Ich bin keine Katze, sondern ein schrecklicher Daemon!!!\n",
      Name(WER)+" sagt: Ich bin keine Katze, sondern ein schrecklicher Daemon!!!\n", 
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));


//--Ausruestung------------------------------------------------------------

  SUID;
}

public void init() {
  if(!is_clone(TO)) return;

  ::init();
  if(random(3)) return;

  if(find_call_out("command_me") == -1) {
    if(TP->QueryProp(P_GUILD) == "paladine") {
      call_out("command_me", 0, "emote faucht laut auf.");
    } else if(TP->QueryProp(P_ALIGN) < 0) {
      call_out("command_me", 0, "emote schnurrt wohlig.");
    } else {
      call_out("command_me", 0, "emote macht einen Katzenbuckel.");
    }
  }
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

public void give_notify(object ob) {
  if(!drinking && ob->id("\ngeisterhaus_pina_colada")) {
    drinking = 1;
    command_me("emote grinst ueberlegen.");
    command_me("sag Wunderbar! Nun steht meinem Entkommen aus diesem Koerper nichts mehr im Weg!");
    ob->remove(1);
    call_out("drink_pina_colada_1", 2, TP);
    return;
  }

  return ::give_notify(ob);
}

public void drink_pina_colada_1(object who)  {
  command_me("emote trinkt den Pina Colada mit einem Schluck aus.");
  call_out("drink_pina_colada_2", 2, who);
}

public void drink_pina_colada_2(object who) {
  object ob;

  if(!present(who, ENV(TO))) {
    command_me("sag Huch? Schon weg? Sowas von ungeduldig...");
  } else {
    command_me("sag Danke, " + who->Name() + " ! Nimm dies als Zeichen meiner Dankbarkeit!");
    ob = clone_object(ARMOUR "pentagramm");
    if(ob->move(who, M_GET) != 1) {
      command_me("Sag Oh. Du kannst es nicht tragen. Dann lass ich es hier liegen.");
      ob->move(ENV(TO), M_NOCHECK);
    } else {
      tell_object(who, BS(Name() + " gibt dir ein Pentagrammamulett."));
      tell_room(ENV(who), BS(Name() + " gibt " + who->name(WEM) + " ein Pentagrammamulett."));
    }
  }

  call_out("drink_pina_colada_3", 2, who);
}

public void drink_pina_colada_3(object who) {
  command_me("emote explodiert in einen Schwarm aus Fliegen.");
  EPMASTER->GiveExplorationPoint("pinacolada", EP_MISC);
  remove(1);
}