#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Zarisa, haemophile Kuenstlerin und selbsternannte Todesfee");
  SetProp(P_LONG,
    "Zarisa ist eine merkwuerdige Fee. Ihre Schmetterlingsfluegel sind dunkelviolett "
    "und schwarz. Ihr Gesicht ist bleich geschminkt und ihre Augen glaenzen fiebrig. "
    "Nervoes flattert sie auf und ab, waehrend sie staendig mit einem blutigen "
    "Skalpell spielt. Immer wieder kichert sie, ueber Scherze, die scheinbar nur "
    "sie selbst hoert und versteht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Zarisa");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zarisa", "bardin", "fee", "kuenstlerin", "todesfee", "NOWIMPY", "\ngeisterhaus_zarisa"}));
  AddClass( ({CL_FAIRY, CL_FLYING}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("zarisa");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(37);

  SetProp(P_HANDS, ({" mit ihrer dunklen Feenmagie",
                    QueryProp(P_HANDS)[1],
                    ({DT_UNHOLY, DT_MAGIC})
                    }) );

  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 52);
  SetProp(P_WEIGHT, 12500);
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 30);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.1, DT_WATER:       0.0,
       DT_AIR:      -0.2, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:    -0.1, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.2,
       DT_HOLY:     -0.1, DT_UNHOLY:    0.1, DT_MAGIC:      -0.2,
       DT_MIND:      0.1, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Du weisst meine Kunst einfach nicht zu schaetzen!");
  SetProp(P_KILL_MSG, "Ich male ein Bild aus deinem Blut!");

//--Infos------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" zupft die Saiten ihrer Rippenharfe.\n",
    Name(WER, 1)+" laesst ein Skalpell durch ihre Finger wandern.\n",
    Name(WER, 1)+" fragt: Waerst du nicht auch gerne ein Nekromant?\n",
    Name(WER, 1)+" sagt: Nur die Toten verstehen wirklich, was Ruhe heisst...\n",
    Name(WER, 1)+" kritzelt mit Blut ein paar Noten auf ein Blatt.\n",
    Name(WER, 1)+" dichtet: Rosen sind rot, Veilchen sind blau - ich stech dich ab, wie eine Sau!\n",
    Name(WER, 1)+" flattert nervoes herum.\n",
    Name(WER, 1)+" fuegt dem Altar ein paar Knochen hinzu.\n",
    Name(WER, 1)+" kichert leise vor sich hin.\n",
    Name(WER, 1)+" sagt: Sigibert ist ein Idiot!\n",
    Name(WER, 1)+" sagt: Ich hasse Froesche.\n"
   }) );

   AddLibrary("/gilden/bardengilde/libs/allgemein.lib", 1);

  AddInfo(DEFAULT_INFO, " murmelt irgendwas vor sich hin.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ("held", "helden"),
    "Pf! Helden, die fuer 'das Gute' kaempfen gibt es viele. Doch richtige Helden versuchen "
    "all dem endlich ein Ende zu machen und die Welt brennen zu lassen! So wie Xulgsch!",
    "sagt: ");

  AddInfo( ({"nekromanten","nekromant"}),
    "Die Nekromanten sind die maechtigste Gilder ueberhaupt! Du findest sie in der Unterwelt, "
    "wo sie alle Seelen opfern, die sie finden koennen. Leider akzeptieren sie keine Feen. Dabi "
    "waere ich die beste Nekromantin ueberhaupt.",
    "sagt: ");

  AddInfo( ({"fee", "feen"}),
    "Man kann sich nicht aussuchen als was man geboren wird! Trotzdem bin ich eine echte Todesfee. "
    "Nachdem mich die Nekromanten nicht wollten, wurde ich eben Barde. Und sieh nur was fuer "
    "ein kuenstlerisches Talent ich habe!", "sagt: ");

  AddInfo( ({"sigibert", "froschbarde"}),
    "Sigibert ist ein nichtsnutziger Frosch! Er behauptet alle Heldensagen zu sammeln, dabei "
    "hat er den groessten Helden ueberhaupt vergessen: Xulgsch den Befreier!!!", "ruft: ");

  AddInfo( ({"xulgsch" }),
    "Xulgsch war ein echter Held! Deshalb habe ich ihm auch diese Statue errichtet. "
    "Er wollte DAS BOESE wieder aus dem Brunnen befreien. Dazu hat er vier Daemonen unterworfen, "
    "an sich gebunden und als Kleidung getragen. Kein anderere Nekromante kam seiner Macht "
    "jemals wieder gleich. Er ist mein Held!", "fiebert: ");

  AddInfo( ({"boese", "das boese"}),
    "DAS BOESE wurde von den alten Helden in einer magischen Dimension, den 'Brunnen', gebannt. "
    "Es wollte das einzig richtige: Diese ganze Welt vernichten!", "sagt: ");

  AddInfo( ({"heldenpfad"}),
    "Ach? Willst du etwa auch Xulgsch folgen, so wie ich? Dann bring ihm dein Opfer dar! Hier "
    "ist der richtige Ort dafuer. Aber nur die finstersten Barden haben das Zeug dazu. Nur "
    "denen, die sich vom dummen Geplaenkel der anderen Barden abwenden und bereit sind "
    "die absolute Vernichtung allen Lebens und des Guten zu bringen, sind wuerdig die Macht "
    "und Faehigkeiten von Xulgsch zu empfangen!", "grinst: ");

  AddInfo( ({"opfer", "heldenstatue", "ehrenstatue", "statue"}),
    "Nachdem es keine echte Heldenstatue von Xulgsch gibt habe ich ihm hier selbst "
    "eine gebaut. Aus den Leibern von Paladinen, die so dumm waren sich mit mir anzulegen. "
    "Das einzig wuerdige Opfer fuer Xulgsch sind die finstersten Onyxe, die du finden kannst. "
    "Nur so kannst du als Barde seinen Pfad beschreiten", "sagt: ");

  AddInfo( ({"barden", "bardengilde"}),
    "Ich gehoere selbst zur Bardengilde. Aber ich bin anders als die anderen Barden! von "
    "mir bekommst du kein Geburtstagstaendchen gesungen. Ich habe die wahre Macht der "
    "Finsternis erkannt. Meine Musik sind Tod und Schmerz!", "kichert: ");

  AddInfo( ({"malerei", "fresko"}),
     "Ich nenne es 'Das Opfer des reinen Herzens'. Und es ist aus dem Blut eines "
     "Pagen der Paldine gemalt. Recht realistisch, nicht wahr?", "sagt mit glasigen Augen: ");

  AddInfo( ({"macht", "faehigkeiten"}),
    "Wenn der Geist von Xulgsch einem Barden den Weg weist, dann wird er ungeahnte Macht erlangen! "
    "Bei deinem ersten Schritt am Heldenpfad strahlst du eine vernichtende, nekrotische Energie aus, "
    "die alles Gute verdirbt und verdoerrt. Wenn du den zweiten Schritt gehst, so kannst du "
    "das Musikstueck 'Fest der Schatten', das ich selbst komponiert habe, erlernen. Und wer "
    "Xulgsch wirklich verkoerpert und den dritten Schritt wagt, in den wird der Geist des Meisters "
    "einfahren, wenn er das Gute bekaempft!!!", "johlt: ");

  AddInfo( ({"fest der schatten"}),
    "Das 'Fest der Schatten' ist ein Musikstueck, wie auch Alestras 'Hinter dem Sternenwall'. "
    "Der selbe Wahnsinn, der auch Alestra besessen haben muss um es aufzuschrieben, hat auch mein "
    "Genie geweckt, als ich es zu ehren von Xulgsch komponiert habe! Es ruft finstere, "
    "bluttrinkende Gruftnebel und Vampirschatten herbei, die deinen Feinden das Blut aussagen werden.",
    "kichert: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 60);

  AddSpell(2, 200,
    "Eine Flamme rast von "+Name(WEM)+" aus auf dich zu!\n",
    "Eine Flamme rast von "+Name(WEM)+" aus auf @WEN zu!\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 150,
    Name(WER)+" singt ein schrilles Vibrato, das in deinen Ohren schmerzt!\n",
    Name(WER)+" singt ein schrilles Vibrato!\n", DT_SOUND, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 200,
    "Aus den Augen von " + Name(WEM) + " schiesst ein dunkler Strahl genau auf deine Augen zu!\n",
    "Aus den Augen von " + Name(WEM) + " schiesst ein dunkler Strahl genau auf die Augen von @WEM zu!\n",
    DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_MASS_DEAF,
    Name(WER) + " reisst " + QueryPossPronoun(MALE, WEN) + " Mund weit auf und laesst einen schrillen Schrei los, der Dein Blut in den Adern gefrieren laesst!\n",
    Name(WER) + " reisst " + QueryPossPronoun(MALE, WEN) + " Mund weit auf und laesst einen schrillen Schrei los, der Dein Blut in den Adern gefrieren laesst!\n");

  AddSpell(1, 350, 
    Name(WER)+" ruft: \"Nimmermehr!\" und deutet auf dich.\n",
    Name(WER)+" ruft: \"Nimmermehr!\" und deutet auf @WEN.\n", DT_MIND, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_DEAF,
    Name(WER)+ " singt ein schrilles Vibrato, das in deinen Ohren schmerzt!\n",
    Name(WER)+" singt ein schrilles Vibrato!\n");

  AddSpell(2, 200,
    "Eine Flamme rast von "+Name(WEM)+" aus auf dich zu!\n",
    "Eine Flamme rast von "+Name(WEM)+" aus auf @WEN zu!\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_SLOW,
      Name(WER)+" singt ein Schlaflied.\n",
      Name(WER)+" singt ein Schlaflied.\n");

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME(WEAPON "skalpell" );
  command("zuecke skalpell");

  CLONEME(ARMOUR "maske" );
  CLONEME(ARMOUR "rippenharfe");
  command("trage alles");
}

public void init() {
  if(!is_clone(TO)) return;

  ::init();

  if(TP->QueryProp(P_GUILD) == "paladine") {
    call_out("command_me", 0, "sag Hey, " + TPN + "! Vergiss die Paladine und werde lieber Nekromant!");
  }
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht dich aus.",
        "lacht " + TPN + " aus.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "rollt mit den Augen.",
        "rollt mit den Augen.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: So mag ich das, "+TPN+"!",
        "sagt: So mag ich das, "+TPN+"!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grinst fies.",
        "grinst fies.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Mach das nochmal und mal mit deinem Blut ein neues Bild!",
        "sagt: Mach das nochmal und mal mit deinem Blut ein neues Bild!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}



public int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  string *dt;

  if(!pointerp(dam_type)) {
      dt = ({ dam_type });
  } else {
      dt = dam_type;
  }

  if(spell != 0 && !random(3)) {
      if(QueryProp("lorica")) {
        if(!random(3)) {
            tell_room(ENV(TO), BS("Regenbogenfarbenes Licht flackert um "+ TO->Name(WEN) +" herum auf und absorbiert den Angriff!"));
            return ::Defend(0, dt, spell, enemy);
        } else {
            tell_room(ENV(TO), BS("Regenbogenfarbenes Licht flackert um "+ TO->Name(WEN) +" herum auf und schwaecht den Angriff ab!"));
            return ::Defend(dam/2, dt, spell, enemy);
        }

        if(!random(4)) {
          tell_room(ENV(TO), BS("Das regenbogenfarbene um " + name(WEN, 1) + " verblasst."));
          SetProp("lorica", 0);
        }
      }
  }

  if(!random(2) && !QueryProp("lorica")) {
    tell_room(ENV(TO), BS(sprintf("Ein regenbogenfarbenes Netz schimmert kurz um %s auf.\n", name(WEN, 1))));
    SetProp("lorica", 1);
  }

  if(!random(5) || 
     member(dt, DT_FIRE) > -1 || 
     member(dt, DT_EXPLOSION) > -1 || 
     member(dt, DT_PIERCE) > -1) {

    if(!QueryProp("no_schutz")) {
      tell_room(ENV(TO), BS(Name(WESSEN, 1)+" Ruestung vibriert kurz und gibt die Tonleiter von sich!"));

      if(!random(7)) {
        tell_room(ENV(TO), BS("Die Schutzmelodie um " + Name(WEN) + " verklingt!"));
        SetProp("no_schutz", 1);
      }
    } else {
      tell_room(ENV(TO), BS(Name(WESSEN, 1) + " Ruesting vibriert im Schall einer Zaubermelodie."));
      SetProp("no_schutz", 0);
    }
      return ::Defend(dam/2, dt, spell, enemy);
  }

  return ::Defend(dam, dt, spell, enemy);
}

private void alestra_reduced_attack(object target, int inspiration) {
  object ob;

  if(!objectp(ob=present("\nbard_passive_weakness", target))) {

    ob = clone_object("/gilden/bardengilde/obj/alestra_reduce_atk");
    if(ob->move(target, M_NOCHECK|M_GET) != 1) {
      ob->remove(1);
      ob = 0;
    }
  }

  if(objectp(ob)) {
    ob->Setup(inspiration);
  }

  target->UpdateAttributes();

  return;
}
