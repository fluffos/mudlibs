#include "../def.h"
inherit "/std/npc";

void create() {
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein hirnloser Zombie");
  SetProp(P_LONG,
    "Ein stumpfer, hirnloser Zombie. Hirnlos in wahrsten Sinne des Wortes. "
    "Sein Schaedel wurde aufgeknackt und ist leer.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Zombie");
  SetProp(P_GENDER, MALE);
  AddId(({"zombie", "\ngeisterhaus_zombie"}));

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinen fauligen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -666);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" laesst @WEN fallen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.5, DT_COLD:     -0.5, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: -0.5, DT_EXPLOSION:   0.2,
       DT_SOUND:     0.0, DT_LIGHT:     0.2, DT_ELECTRIC:   -0.5,
       DT_ACID:      0.0, DT_POISON:   -1.0, DT_TERROR:     -0.8,
       DT_HOLY:      0.5, DT_UNHOLY:   -0.5, DT_MAGIC:       0.0,
       DT_MIND:     -1.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "stoehnt leise.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Ausruestung------------------------------------------------------------

  SUID;
}

void die(int poisondeath)
{
  object killer, ob, hammer;
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  killer = QueryProp(P_KILLER) || TP;
  if(objectp(killer)) {
    if(objectp(ob=present(QUESTOB_ID, killer))) {
      if(!ob->QueryHammer() && !objectp(present(QUEST_HAMMER_ID, TP)) && !objectp(present(QUEST_OEL_ID, TO))) {
        hammer = clone_object(OBJ "schaedelhammer");
        if(hammer->move(killer, M_GET) != 1) {
          tell_object(killer, BS("Aus dem Kopf des Zombies faellt ein Hammer. Leider kannst du nicht tragen und er "
                                 "verschwindet im Gebuesch."));
          hammer->remove(1);
        } else {
          tell_object(killer, BS("Aus dem Kopf des Zombies faellt ein Hammer, den du sofort einsteckst."));
        }
      }
    }
  } 

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

public void reset() {
  ::reset();

  if(is_clone(this_object())) {
    remove();
  }
}