#include "../def.h"
#include <exploration.h>
#include "/gilden/nekromanten/nekro_properties.h"

inherit "/p/std/npc/nekro_npc";

void create() {
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Igor");
  SetProp(P_LONG,
    "Dieser Igor kuemmert sich in der Villa offenbar um die Hausarbeit. So "
    "wie jeder Igor ist er klein, buckelig und alles andere als schoen "
    "anzusehen. Seine ungleichgrossen Glubschaugen sind gelb unterlaufen und "
    "stieren dich an. Ab und zu tropft ein kleiner Sabberfaden aus seinem "
    "schiefen Mund. Eine Naehte an Kopf, Armen und Beinen zeigen, wo er "
    "aus verschiedenen Lebewesen zusammengestueckelt wurde.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Igor");
  SetProp(P_GENDER, MALE);
  AddId(({"igor", "untoter", "hausdiener"}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15);

  SetProp(P_HANDS, ({" mit seinen klobigen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" steckt @WEN ein.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.5, DT_COLD:     -0.5, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: -0.5, DT_EXPLOSION:   0.2,
       DT_SOUND:     0.0, DT_LIGHT:     0.2, DT_ELECTRIC:   -0.5,
       DT_ACID:      0.0, DT_POISON:   -1.0, DT_TERROR:     -0.8,
       DT_HOLY:      0.5, DT_UNHOLY:   -0.5, DT_MAGIC:       0.0,
       DT_MIND:     -1.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "kueche");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "starrt dich dumpf an.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"mittwoch"}),
    "Mittwoch Freundin. Igor mag! Geben Igor Essen!",
    "murmelt: ");

  AddInfo( ({"igor"}),
    "Igor ist ein Igor.",
    "sagt: ");

  AddInfo( ({"ananas", "kokosnuss", "milch", "rum"}),
    "Mmmh. Essen. Hirn?",
    "sagt: ");

  AddInfo( ({"hirn"}),
    "Mmmh! Igor, Hiiiirn!",
    "sagt: ");

  AddInfo( ({"arbeit", "hausarbeit"}),
    "Igor, arbeiten!",
    "murmelt: ");

  AddInfo( ({"doktor", "frank", "fran n stein"}),
    "Dokotur macht Aua gut!",
    "sagt: ");

  AddInfo( ({"zimmer"}),
    "Igor macht Zimmer sauber!",
    "sagt: ");

  AddInfo( ({"zarisa"}),
    "Hihi. Lustig!",
    "kichert: ");

  AddInfo( ({"balsamieroel", "oel"}),
    "Igor hat Oel bekommen. Gut gegen Stinkefleisch. Igor hat nicht mehr. Mittwoch wollte haben!",
    "sagt: ");

  AddInfo( ({"doktor", "frank", "frank n stein"}),
    "Der Doktor gibt Igor Zeug. Nicht stinken.",
    "sagt: ");


//--Chats------------------------------------------------------------------

  SetChats(1,
  ({Name(WER, 1)+" fegt den Boden.\n",
    Name(WER, 1)+" schleppt ein paar schwere Sachen herum.\n",
    Name(WER, 1)+" wischt mit einem dreckigen Staubtuch.\n",
    Name(WER, 1)+" bohrt in der Nase.\n",
    Name(WER, 1)+" kratzt sich am Kopf.\n",
    Name(WER, 1)+" sabbert auf den Boden.\n",
    Name(WER, 1)+" durchsucht seine Taschen nach irgendwas.\n",
   }) );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/armour/cloak/lederschuerze" );
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

public string short() {
  string *fn, s;

  if(QueryProp(P_NEKRO_MASTERED_BY)) {
    return ::short();
  }

  s = "Ein Igor ";

  fn = explode(file_name(environment(TO)), "/");


  if(sizeof(fn) < 5) return s + "steht hier verloren herum.\n";

  switch(fn[5]) {
    case "kueche": return s + "macht gerade den Abwasch.\n"; break;
    case "halle": return  s + "fegt den Boden.\n"; break;
    case "petshop": return s + "raeumt ein paar Kisten aus.\n"; break;
    case "kaminzimmer": return s + "staubt die ausgestopften Koepfe ab.\n"; break;
    case "gang": return s + "fegt den Boden.\n"; break;
    case "doktor": return s + "laesst sich vom Doktor verarzten.\n"; break;
    case "barde": return s + "versucht das Blut aufzuwischen.\n"; break;
    case "schlafzimmer": return s + "schuettelt die Kissen auf.\n"; break;
    default: return s + "sieht sich hier nach Arbeit um.\n"; break;
  }

  return s;
}

public void give_notify(object ob) {
  if(ob->id("untotenfutter") || ob->id("hirn")) {
    command_me("sag Mmmmh! Hiiiiirn!");
    command_me("emote isst "+ob->name(WEN, 1)+" auf.");
    ob->remove(1);
    EPMASTER->GiveExplorationPoint("igor_hirn", EP_MISC);
    return;
  }

  ::give_notify(ob);
}