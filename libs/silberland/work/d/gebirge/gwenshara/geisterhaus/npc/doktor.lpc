#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Doktor Frank N. Stein, der Arzt dem die Toten vertrauen");
  SetProp(P_LONG,
    "");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Doktor Frank");
  SetProp(P_GENDER, MALE);
  AddId(({"doktor", "frank", "doktor frank", "doktor stein", "\ngeisterhaus_doktor",
          "NOWIMPY", "NOCONTROL", "QUEST_OBJ"}));
  SetProp(P_ARTICLE, 0);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(25);
                    
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 20);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" steckt @WEN geistesabwesend ein.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " sagt: Das sagt mir nichts. Gar nichts.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"hilfe", "helfen"}),
    "Ah! Ja. In der Tat koennte ich etwas hilfe bei einem meiner Patienten "
    "gebrauchen. Ein Geist, der eine Transition in einen Koerper anstrebt. "
    "Es handelt sich dabei um eine sehr exerimentelle und neuartige Therapie. "
    "Leider habe ich aktuell keinen geeigneten Koerper bei der Hand. Du "
    "koenntest mir das Rohmaterial besorgen! Wenn du mir helfen moechtest, "
    "<biete> mir deine Hilfe an!", "sagt: ");

  AddInfo( ({"therapie", "experiment"}),
    "Die Transition in einen neuen Koerper fuer Verstorbene ist eine neuartige "
    "und ueberaus experimentelle Therapie, die ich entwickelt habe. Das Gute ist, "
    "dass meine Patienten kaum etwas zu verlieren haben. Tot sind sie ja schon!",
    "sagt: ");

  AddInfo( ({"material", "rohmaterial"}),
    "Hmhm. Nunja. Ein paar Arme, Beine, ein Hirn, ein Rueckgrat und ein "
    "Torso waeren noetig. Weisst du, jeder Geist hat seine eigenen, spezifischen "
    "Beduerfnisse an den jeweiligen Koerper. Da muss alle zusammenpassen, sonst "
    "endet das in einem Fiasko!", "sagt: ");

  AddInfo( ({"koerperteile", "arme", "beine", "hirn", "rueckgrat", "torso"}),
    "Ich benoetige Koerperteile, um eine Koerper fuer einen Geist zu schaffen, "
    "der dann darin 'leben' kann. Diese muessen genaue Anforderungen erfuellen. ",
    "sagt: ");

  AddInfo( ({"anforderungen", "beduerfnisse", "liste"}),
    "Jeder Transkorporale hat andere Anforderungen und Beduerfnisse, die mit "
    "seinem Leben und seinem Tod zusammenhaengen. Wenn du mir zur Hand gehst, "
    "gebe ich dir eine genaue Liste was ich fuer meinen aktuellen Patienten "
    "suche. Bedenke jedoch, dass ich die Anforderungen an die Maechtigkeit der "
    "Koeperteile deiner Erfahrung anpassen werde.", "sagt: ");

  AddInfo( ({"untote", "geister", "untoter", "skelette", "zombies", "vampir", "vampire",
             "skelett", "zombie", "ghoul", "ghoule", "mumie", "mumien"}),
    "Postmortologie ist mein Spezialgebiet. Das umfasst das Wiederherstellen und "
    "chirurgische Aufbessern von Untoten aller Art. Egal, ob Zombies, Skelette, "
    "Geister, Vampire oder Ghoule - ich bin der Arzt, dem Untote vertrauen!", "sagt: ");

  AddInfo( ({"wiederherstellen", "heilen", "heilung", "reparieren"}),
    "Wenn du, oder ein Untoter, den du kennst, zu Schaden gekommen ist, kann ich ihn, sie "
    "oder es wiederherstellen. Sieh dir einfach meine Preisliste an!", "sagt: ");

  AddInfo( ({"preisliste", "preise"}),
    "Brauchst du neue Augen? Hab ich im Angebot! Die Preisliste haengt dort an der Wand.",
    "sagt: ");

  AddInfo( ({"aufbessern", "verbessern", "aufbesserung", "verbesserung"}),
    "Ich habe eine Sonderausbildung in der plastischen Mortochirgurgie. Also dem "
    "Aufhuebschen und Verbessern von untoten Koerpern. Sieh dir einfach meine "
    "Preisliste an.", "sagt: ");

  AddInfo( ({"balsamierkoefferchen", "einbalsamieren", "haltbarmachen", "koefferchen", "koffer"}),
    "Herrje - ich Schussel! Da hab ich doch wohl glatt alle Dinge aus meinem Koefferchen "
    "irgendwo verlegt. Das tut mir schrecklich leid! Damit du alle Koerperteile sammeln "
    "kannst brauchst du natuerlich eine Knochensaege, einen Schaedelhammer und Balsamieroel. "
    "Ich denke das muss alles hier irgendwo sein!", "sagt: ");

  AddInfo( ({"knochensaege", "saege"}),
    "Eine Knochensaege brauchst du, um Arme oder Beine vom Torso abzuschneiden. Ich erinnere "
    "mich, dass ich hier in meinem Schrank eine Ersatzknochensaege habe. Nimm einfach die, wenn "
    "du eine brauchst.", "sagt: ");
  
  AddInfo( ({"schrank", "schloss", "code", "zahlencode", "zahlen", "zahlenschloss"}),
    "Natuerlich ist mein Schrank versperrt. Wenn ich das nicht mache, bringt mich die "
    "Aerztekammer um! Den Code? Gute Frage! Den vergess ich gerne. Ich hab allerdings "
    "einen Hinweis fuer mich selbst notiert.", "sagt: ");

  AddInfo( ({"hinweis", "zettel"}),
    "Auch eine gute Frage! Ich habe mir einen Hinweis fuer den Code des Zahlenschlosses "
    "auf einem Zettel notiert. Das Dumme ist nur: Ich habe vergessen wo ich den Hinweis "
    "versteckt habe. Er befindet sich aber garantiert irgendwo hier in der Praxis!",
    "sagt: ");

  AddInfo( ({"hammer", "schaedelhammer"}),
    "Wenn man an das Hirn einer Leiche kommen will, ist ein Schaedelhammer zum knacken der "
    "Schadeldecke unerlaesslich. Die letzte Person, die sich meinen ausgebort hat war "
    "Mittwoch... sie vergisst gerne mal Dinge zurueckzugeben.", "sagt: ");

  AddInfo( ({"fluessigkeit", "balsamierfluessigkeit", "oel", "balsamieroel"}),
    "Eigentlich ist das Einbalsamieren von Leichenteilen nur zur Bequemlichkeit. "
    "Sie verrotten sonst so schnell. Unser Igor holt sich ab und zu etwas Balsamieroel "
    "von mir, damit er nicht weiter vor sich hin rottet und irgendwann zum Skelett wird.",
    "sagt: ");

  AddInfo( ({"maschine", "funktion"}),
    "Die Maschine ist von mir eigens entwickelt. Sie dient dazu Koerper zu beleben und "
    "Geister darin einfahren zu lassen. Damit versuche ich meinen Patienten zu helfen "
    "ein neues Leben zu finden!", "sagt: ");

//--Ausruestung------------------------------------------------------------

  SUID;

  AddCmd( ({"biete", "biet"}), "cmd_hilfe");
}

public int cmd_hilfe(string str) {
  string wem, was;
  object ob;
  int r;

  notify_fail("Wem willst du was anbieten?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s %s an", wem, was) != 2) return 0;
  if(!id(wem) || was != "hilfe") return 0;

  if(InFight()) {
    write("Der Doktor ist gerade beschaeftig und hat keine Zeit fuer dich.\n");
    return -1;
  }

  if(TP->QueryQuest(QUESTNAME)) {
    command_me("sag Aber " + TPN + ", du hast mir doch schon wunderbar geholfen!");
    return 1;
  }

  if(objectp(present(QUESTOB_ID, TP))) {
    command_me("sag Du hilfst mir bereits, " + TPN+". Besorge mir die Koerperteile auf der "
               "Liste. Danke!");
    return 1;
  }

  if(objectp(present(QUESTOB_ID_HELM, TP))) {
    command_me("sag Du hilfst mir bereits, " + TPN+". Lade den Helm mit Blitzen auf!");
    return 1;
  }

  ob = clone_object(OBJ "kt_koffer");
  r = ob->move(TP, M_GET);
  if(r != 1) {
    command_me("sag Ich wuerde dir gern die Sachen geben, "+TPN+", aber leider kannst du "
               "gerade nicht mehr tragen. Komm wieder, wenn du bereit bist!");
    ob->remove(1);
    return -1;
  }

  command_me("sag Wunderbar! Danke fuer deine Hilfe, "+TPN+"! In diesem Koefferchen "
             "hier findest du alles, was du brauchst. Ich habe dir auch eine Liste "
             "mit den gesuchten Koerperteilen fuer unseren aktuellen Patienten beigelegt. "
             "Denke aber daran nicht irgendwelche Leichenteile zu besorgen. Ich erwarte, "
             "dass du Leichenteile bringst, die deiner eigenen Erfahrung angemessen sind! "
             "Wenn du alles hast, leg es einfach in den Koffer und bring ihn zu mir zurueck.");
  write(BS(Name(WER)+" gibt dir ein kleines Lederkoefferchen."));
  say(BS(Name(WER)+" gibt " + TPN + " ein kleines Lederkoefferchen."));
  command_me("sag Viel Erfolg!");
  return 1;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

public void give_koffer(object ob) {
  if(ob->id(QUESTOB_ID)) {
    if(ob->AllDone()) {
      ob->remove(1);
      command_me("sag Perfekt, " + TPN +"! Jetzt fehlt uns nur noch ein ausreichend "
                 "schockender Antreiber. Dazu habe ich die richtige Loesung: Wir brauchen "
                 "ENERGIE!");
      command_me("sag Setz dir einfach diesen Helm auf. Er absorbiert alle Energie aus "
                 "aus Stromschlaegen und Blitzen. Jeder Stromschlag und Blitz der dich "
                 "trifft laedt den Energieakkumulator auf. Bring ihn mir wieder, wenn er "
                 "voll aufgeladen ist!");
      ob = clone_object(ARMOUR "kt_helm");
      ob->SetProp("targetload", TP->QueryProp(P_LEVEL) * 10);
      ob->move(TP, M_NOCHECK);
      tell_object(TP, BS(Name(WER) + " gibt Dir einen Helm mit langem Blitzableiter."));
      tell_room(ENV(TO), BS(Name(WER) + " gibt " + TPN + " einen Helm mit langem Blitzableiter."));
      return;    
    } else {
      command_me("sag Da fehlen noch Koerperteile, " + TPN + ". Komm wieder, wenn du alles hast!");
      ob->move(TP, M_NOCHECK);
      return;
    }
  }
  return;
}

public void init() {
  object ob;
  ::init();

  if(interactive(TP) && objectp(ob=present(QUESTOB_ID_HELM, TP))) {
    if(!ob->IsFull()) {
      call_out("command_me", 2, "sag Du hast noch nicht genug Energie gesammelt, " + TPN +"! Wir brauchen mehr!");
    } else {
      call_out("command_me", 2, "sag Wunderbar, " + TPN +"! Du hast genug Energie gesammelt. Entlade den Helm an der Maschine!");
    }
  }
}
