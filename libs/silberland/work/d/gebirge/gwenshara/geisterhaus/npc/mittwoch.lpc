#include "../def.h"

inherit "/p/service/angel/haustiere/std_petshop_vendor";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Mittwoch, ein blasses Maedchen");
  SetProp(P_LONG,
    "Wenn es eine Farbe gibt die Mittwoch gut beschreibt, dann waere das schwarz-weiss. "
    "Wobei das eigentlich keine Farbe ist. Sie ist ein junges Meschenmaedchen mit "
    "zwei schwarzen, geflochtenen Zoepfen und einem absolut ausdruckslosen Gesicht. "
    "Ihr schwarzes Kleid ist sauber gebuegelt mit gestaerktem Kragen. Auf ihrer Schulter "
    "sitzt eine ziemlich grosse, haarige, schwarze Spinne.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Mittwoch");
  SetProp(P_GENDER, FEMALE);
  AddId(({"mittwoch", "maedchen", "NOCONTROL", "NOWIMPY", "\ngeisterhaus_mittwoch"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("mittwoch");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 152);
  SetProp(P_WEIGHT, 40000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 30);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Oh! Hallo, Lars. Lange nicht gesehen.");

//--Infos------------------------------------------------------------------

  SetChats(1,
  ({Name(WER, 1)+" blickt dich ausdruckslos an.\n",
    Name(WER, 1)+" fragt: Wie denkst du ueber Enthauptungen?\n",
    Name(WER, 1)+" zupft einen Geist aus der Luft.\n",
    Name(WER, 1)+" streichelt ihre Spinne.\n",
    Name(WER, 1)+" verfuettert ein paar lebende Fliegen an ihre Spinne.\n",
    Name(WER, 1)+" sagt: Auch Untote haben ein gutes Leben verdient.\n",
    Name(WER, 1)+" streicht ihr Kleid glatt.\n",
    Name(WER, 1)+" zieht eine Augenbraue hoch, als sie dich sieht.\n",
    Name(WER, 1)+" sagt: Daemonenbeschwoerungen waren frueher auch besser.\n",
    Name(WER, 1)+" sammelt ein paar Spinnweben ein.\n",
    Name(WER, 1)+" sieht sich nach verloregagengenen Untoten um.\n",  
    Name(WER, 1)+" knabbert an einem Keks.\n"
   }) );

  AddInfo(DEFAULT_INFO, ({
    "sagt: Ich bin nicht schlecht drauf. Ich bin einfach ich.\n",
    "sagt: Du koenntest Luzifer deine Seele fuer dieses Wissen verkaufen.\n",
    "fragt: Wusstest du, dass Pfadfinderkekse gar nicht aus Pfadfindern gemacht werden?\n",
    "sieht dich ausdruckslos an.\n"
  }));
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"untote", "untoter", "alternatives leben", "alternativ lebende", "unleben"}),
    "Untote sind auch nur Lebewesen. Also eigentlich nicht. Sie sind alternativ Lebende. "
    "Sie haben genauso unsere Achtung und Fuersorge verdient, wie Noch-Lebende. Leider "
    "werden sie oft missverstanden. Deshalb habe ich dieses Asyl gegruendet.",
    "sagt: ");

  AddInfo( ({"asyl", "adoptionsstelle", "asylheim"}),
    "Dieses Asylheim ist ein Ort, an dem wir missverstandende, ausgesetzte und "
    "ausgenutzte Untote wieder aufpeppeln und ihnen eine neue Zukunft verschaffen!", "sagt: ");

  AddInfo( ({"adoption", "adoptieren", "unlebenspartner"}),
    "Echte Freunde von Untoten erschaffen nicht neu, sondern adoptieren die Streuner. "
    "Auf der Tafel hier ist vermerkt welche armen Alternativ-Lebenden gerade auf der "
    "Suche nach einem neuen Unlebenspartner sind. Ich vermittle nur an die, den den "
    "Beweis erbracht haben, dass sie sich wirklich um unsere untoten Freunde sorgen.", "sagt: s");

  AddInfo( ({"beweis", "beweisen"}),
    "Frag mal Doktor Frank im Obergeschoss. Er tut viel Gutes fuer die nicht-lebenden "
    "Mitbuerger. Vielleicht kann er deine Hilfe gebrauchen. Das waere ein guter Beweis.", "sagt: ");

  AddInfo( ({"irrlicht", "irrlichter", "irrlichtern"}),
    "Irrlichter sind stark missverstandene Geisterscheinungen. Eigentlich sind sie nicht viel "
    "intelligenter als eine Maus. Und trotzdem werfen die Sterblichen ihnen vor, dass sie "
    "Menschen in Suempfe locken wollen. Im Grunde sind sie einfach ektoplasmische Ansammlungen. "
    "Nicht echte Geister im eigentlichen Sinn.", "sagt: ");

  AddInfo( ({"kraehe", "skelettkraehe"}),
    "Skelettkraehen sind die Opfer nekromantischer Untriebe. Sie entstehen oft einfach als "
    "Nebenprodukt von Totenbeschwoerungen. Nekromanten, die andere Untote erschaffen "
    "kuemmern sich dann nicht weiter um sie, und so muessen sie ihr Leben ganz allein fristen. "
    "Dabei gehoeren Kraehen eigentlich zu intelligenteren Tieren. Es zeigt nur wie unverantowrtlich "
    "Nekromanten meistens handeln!", "sagt: ");

  AddInfo( ({"ratte", "vampirratte"}),
    "Eigentlich sind Vampirratten mindestens genauso klug, wie normale Ratten. Es gibt "
    "unzaehlige davon am Friedhof. Die armen Kleinen werden oft zum Opfer fuer angehende "
    "Paladine, weil sie denken, damit das Boese auszumerken. Anstatt sie umzubringen, waere "
    "es aber viel besser sie zu sterilisieren und dann an einen guten Haushalt abzugeben, "
    "der sich ausreichend mit den kleinen Rackern beschaeftigt.", "sagt: ");

  AddInfo( ({"haendchen"}),
    "Die krabbelnden Haendchen entstehen oft als Uebungsobjekte angehender Totenbeschwoerer. "
    "Sie lernen dabei einzelne Gliedmassen zu beleben und ab und zu entwischt eines. Wenn wir "
    "so ein Haendchen dann auflesen ist es meistens ganz veraengstigt. Wir kuemmern uns dann "
    "mit ausreichenden Manikueren darum und suchen ein neues Zuhause fuer es. Sie sind "
    "im allgemeinen sehr loyal, wenn sie einen erstmal ins Herz... oder die Finger... "
    "geschlossen haben.", "sagt: ");

  AddInfo( ({"geist", "geister"}),
    "Echte Geister sind vielfaelltig in ihrer Erscheinung. Wenn sie entstehen, sind sie anfangs "
    "oft sehr verwirrt und rachsuechtig. Sobald sich das gelegt hat sind sie dann komplett allein "
    "an irgendeinem Ort, den sie nicht kennen. Wenn wir sie dann finden dauert es oft, bis sie "
    "wieder in dem rechten Geisteszustand sind, um wieder hinaus in die Welt zu kommen.", "sagt: ");

  AddInfo( ({"vampirwolf", "wolf"}),
    "Vampirwoelfe sind hier am Friedhof heimisch. Im Grunde kommen sie gut allein zu recht. Sie "
    "sind sehr zaehe Kaempfernaturen. Ab und zu wird einer aber durch einen Paladin oder durch einen "
    "anderen Untoten verletzt. Dann nehmen wir ihn auf und der Doktor kuemmert sich um sie. Nachdem "
    "Vampirwoelfe eigentlich Rudeltiere sind leben sie gern in Gemeinschaft. Sie sind sowas wie die "
    "Schosshuendchen unter den Untoten. Also natuerlich nur dann, wenn man gut mit ihnen umgehen kann!", "sagt: ");

  AddInfo( ({"nekromanten", "totenbeschwoerer", "nekromant"}),
    "Nekromanten und andere Totenbeschwoerer sind einer der Hauptfaktoren fuer die vielen "
    "heimatlosen Untoten. Sie erschaffen staendig neue anstatt zu recyclen. Darum setze ich in "
    "erster Linie auf Aufklaerung!", "sagt: ");

  AddInfo( ({"aufklaerung"}),
    "Ich habe schon weit ueber 50 Briefe an Xarfai geschrieben. Bisher leider noch keine "
    "Antwort. Ich vermute ja, dass er mich gar nicht so ernst nimmt.", "sagt: ");

  AddInfo( ({"xarfai"}),
    "Xarfai ist der oberste der Nekromanten. Er lebt inmitten eines Saeuresees in der Unterwelt. Eine "
    "interessante Wahl des Wohnorts. Fuer meine Haut war der Aufenthalt dort nicht wirklich gut. Deshalb "
    "Habe ich mich hier niedergelassen. Hier ist auch das bessere Wetter.", "sagt: ");

  AddInfo( ({"paladine", "paladin"}),
    "Ach... Paladine sind wirklich schwierig. Noch unbelehrbarer als Nekromanten. Ayla schickt "
    "staendig irgendwelche Paladinschueler auf den Friedhof um die Vampirratten und Vampirwoelfe "
    "beseitigen zu lassen. Welchen Schaden das fuer das Oekosystem anrichtet brauche ich ja wohl "
    "nicht zu erwaehnen.", "sagt: ");

  AddInfo( ({"doktor", "frank", "frank n stein", "doktor stein", "doktor frank"}),
    "Doktor Frank ist der Arzt, dem Untote vertrauen! Ab und zu ist er etwas verstreut, "
    "leistet aber ganz gute Arbeit. Sein Fachgebiet ist die reanimative Medizin. Dafuer "
    "gibt es nicht viele Experten. Er ist einer meiner Untermieter.", "sagt: ");

  AddInfo( ({"untermieter", "mieter"}),
    "Denkst du ich koennte mir so eine Villa bei den Immobilienpreisen alleine leisten?! Ich "
    "habe ein paar Untermieter, die mit mir gemeinsam die Kosten stemmen. Aktuell sind "
    "Doktor Frank N. Stein und Zarisa hier Mieter.", "sagt: ");

  AddInfo( ({"zarisa"}),
    "Zugegeben, Zarisa ist eine eigenwillige Fee. Ich glaube sie ist sowas wie eine Bardin. "
    "Ihre Einrichtungsgeschmack ist gewoehnungsbeduerftig, aber sie ist immerhin etwas leiser "
    "als meine vorherige Mitbewohnerin.", "sagt: ");

  AddInfo( ({"mitbewohnerin", "werwoelfin"}),
    "Frueher hatte ich eine Werwoelfin als Zimmergenossin. Das war nicht immer ganz einfach, "
    "weil sie einmal im Monat ihre besonderen Tage hatte. Und das Geheule kann einem den letzten "
    "Nerv rauben. Naja. Mittlerweile ist sie auf Reisen.", "sagt: ");

  AddInfo( ({"montag"}),
    "Montag ist mein Vetter dritten Grades.", "sagt: ");

  AddInfo( ({"dienstag"}),
    "Dienstag ist mein aelterer Bruder, der ein Auslandsjahr in Andracia macht.", "sagt: ");

  AddInfo( ({"donnerstag"}),
    "Donnerstag ist meine Cousine. Sie ist den Nekromanten beigetreten und hat jeztt "
    "irgendsoeinen 'supercoolen' Kuenstlernamen angeommen.", "sagt: ");

  AddInfo( ({"freitag"}),
    "Mein Onkel Freitag war ein beruehmter Weltreisender. Irgendwann ist er im Dschungel beim "
    "Besuch eines Kannibalenstamms verschollen. Ich denke es wird ihm dort ganz gut gehen. Er "
    "war schon immer begeistert von Kulinarik.", "sagt: ");

  AddInfo( ({"samstag"}),
    "Samstag ist meine kleine Schwester. Total nervig.", "rollt mit den Augen: ");

  AddInfo( ({"sonntag"}),
    "Sonntag ist das schwarze Schaf der Familie. Er wurde Paladin!", "sagt: ");

  AddInfo( ({"igor", "igors"}),
    "Igors sind oftmals die Helfer und Assistenten von verrueckten Wissenschaftlern und Nekromanten. "
    "Man mag es kaum glauben, aber sie gehoeren zu den vernunftbegabten Untoten. Ein Igor wird "
    "geschaffen, in dem die Teile verschiedener Leichen zusammengenaeht und dann mit einem Blitz zum "
    "Leben erweckt werden. Der Igor, der hier in der Villa hilft ist ein solches Exemplar. Im Grunde "
    "ist er ganz in Ordnung.", "sagt: ");

  AddInfo( ({"katze", "beelzebub"}),
    "Der Kater ist hier aufgetaucht als ich versucht habe einen Daemon zu beschwoeren. Er behauptet "
    "felsenfest, dass er der Daemon Beelzebub waere. Absoluter Schwachsinn, wenn du mich fragst. "
    "Staendig versucht er Besuchern aufzuschwatzen, dass sie ihm Alkohol geben. Wenn er mal wieder "
    "seine verrueckten fuenf Minuten hat, gib ihm einfach Katzenminze.", "sagt: ");

  AddInfo( ({"minze", "katzenminze"}),
    "In meinem Zimmer muesste irgendwo noch ein Paeckchen sein.", "sagt: ");

  AddInfo( ({"rabe", "nimmermehr"}),
    "Hast du den alten Raben schon gefunden? Er versteckt sich gern irgendwo im Haus. Keine Ahnung "
    "wo der her kommt. Er war schon hier als wir eingezogen sind. Hat wohl dem Vorbesitzer gehoert.",
    "sagt: ");

  AddInfo( ({"vorbesitzer"}),
    "Den habe ich nie kennengelernt. Ist gestorben, bevor ich hier war. Schade eigentlich. Ich haette "
    "ihn gerne begraben.", "sagt: ");

  AddInfo( ({"beschwoerung", "daemonenbeschwoerung", "daemonen"}),
    "Ich hab einmal versucht einen Daemon zu beschwoeren. Alles was dabei herausgekommen ist, war eine "
    "schwarze Katze, die behauptet sie waere ein Daemon. Das Ritual habe ich aus einem Buch von meiner "
    "Oma.", "sagt: ");

  AddInfo( ({"oma", "hexe"}),
    "Meine Oma ist eine alte Hexe.", "sagt: ");

  AddInfo( ({"oma wetterwachs", "wetterwachs"}),
    "Das ist meine Oma. Sie ist eine der Hexen, die im Moor bei Polaris leben.", "sagt: ");

  AddInfo( ({"schaedelhammer", "hammer"}), 
    "Ja, den Schaedelhammer hatte ich. Er ist ein wunderbares Werkzeug, um an das leckere Gehirn in den Schaedeln heranzukommen. "
    "Ich hatte ihn neulich im Garten, um einem Zombie eine kleine Denkpause zu verschaffen.", "sagt: ");
  
  AddInfo("zombie", 
     "Oh, der arme Zombie, den ich im Garten begraben habe? Er hat sein Gehirn nicht mehr gebraucht, "
     "also habe ich es mir geliehen. Zombies sind so undankbar.", "fluestert: ");
  
  AddInfo("garten", 
    "Der Garten? Ein grossartiger Ort fuer Freizeitaktivitaeten. Ich habe dort neulich "
    "einen Zombie begraben, nachdem ich ihm das Gehirn entnommen hatte. Ein perfekter Tag im Gruenen.", "freut sich: ");

  AddInfo( ({"freizeitaktivitaeten", "aktivitaeten"}), 
    "Meine Freizeitaktivitaeten? Nun, ich verbringe gerne Zeit im Garten, "
    "wo ich mich um meine bluehenden Pflanzen und untoten Haustiere kuemmere. Ausserdem geniesse ich das "
    "Lesen von Gruselgeschichten und die Pflege meiner morbiden Sammlung. Und natuerlich, hin und wieder "
    "gehe ich auf Friedhofsspaziergaenge, um die Gesellschaft der Verstorbenen zu suchen. Es gibt nichts "
    "Besseres, als die Stille eines Friedhofs zu geniessen, waehrend die Seelen der Toten fluestern.", "schwaermt: ");

  AddInfo(({"schachtel"}), 
    "Oh, diese alten Dinge? Nun ja, wir alle haben unsere kleinen Geheimnisse, nicht wahr? Ja, ich habe "
    "tatsaechlich eine Schachtel mit Erinnerungsstuecken unter meinem Bett versteckt. Darin befindet sich ein "
    "Foto von einem Maedchen, dass ich einst sehr mochte, Plueschhandschellen von einer etwas ungewoehnlichen "
    "Geburtstagsfeier, eine alte Puppe, die mir als Kind gehoerte, und Balsamieroel, um meine blasse Schoenheit "
    "beizubehalten. Ich hege seltsame Neigungen, das gebe ich zu, aber das macht das Leben interessant, oder? "
    "Jeder von uns hat ein bisschen Dunkelheit in sich, nicht wahr?", "spricht monoton: ");

  AddInfo( ({"maedchen", "emma"}),
    "Das Maedchen, Emma, auf dem Foto war jemand, den ich vor langer Zeit gekannt habe. Sie war charmant, aber "
    "sie hatte ein dunkles Geheimnis. Sie war ein Werwolf. Wir hatten eine ungewoehnliche Verbindung, "
    "und ich kann nicht leugnen, dass mich ihre wilde Seite faszinierte.", "fluestert: ");

  AddInfo( ({"handschellen"}),
    "Diese Handschellen sind ein Relikt von einer meiner Geburtstagsfeiern, die etwas aussergewoehnlich "
    "war, um es gelinde auszudruecken. Es war eine besondere Nacht, und die Handschellen sind ein stummer "
    "Zeuge davon.", "sagt: ");

  AddInfo( ({"puppe"}),
    "Die Puppe gehoerte mir als Kind. Sie hat einen gewissen nostalgischen Wert fuer mich. Ich habe "
    "sie immer gemocht, auch wenn sie etwas gruselig aussieht. Manchmal fuehle ich mich zu unheimlichen "
    "Dingen hingezogen. Du etwa nicht?", "sagt: ");

  AddInfo( ({"oel", "balsamieroel"}),
    "Ich benutze das Balsamieroel, um meine blasse Haut beizubehalten. Ich habe eine Vorliebe fuer "
    "eine blasse Erscheinungen, und es hilft mir, meinen bleichen Teint zu bewahren. Ein kleiner Makel "
    "in meiner seltsamen Sammlung, nicht wahr?", "sagt: ");

  AddInfo( ({"feier", "geburtstagsfeier"}),
    "Die Geburtstagsfeier, von der die Handschellen stammen, war eine denkwuerdige Veranstaltung, "
    "bei der die Grenzen zwischen dem Leben und dem, was danach kommt, verschwommen sind. Es war eine "
    "Nacht, in der die Dunkelheit tief und unheimlich war, und seltsame Dinge geschahen. Mehr kann ich "
    "dazu nicht sagen, aber lass mich dir versichern, dass es eine Erfahrung war, die man nicht so "
    "schnell vergisst.", "kichert: ");

  AddInfo( ({"saege", "knochensaege"}),
    "Doktor Frank arbeitet mit sowas.", "sagt: ");

  AddInfo( ({"familie", "bruder", "schwester", "vater", "mutter", "cousin"}),
    "In meiner Familie gibt es diese merkwuerdige Namenstradition.", "rollt mit den Augen: ");
  
  AddInfo( ({"namen", "name"}),
    "Namen sind maechtig. Doktor Frank mag zum Beispiel seinen Mittelnamen nicht. Darum verschweigt er ihn.",
    "sagt: ");

  AddInfo( ({"namenstradition", "tradition"}),
    "Einfach nur laecherlich. Sie haben mich auch nach der Tradition benannt.", "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 60);

  AddSpell(2, 250,
    "Die Spinne auf " + Name(WESSEN) + " Schulter beisst dich!\n",
    "Die Spinne auf "+Name(WESSEN)+" Schullter beisst @WEN!\n",
     DT_POISON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5, 200,
    Name(WER)+" tritt dir gegens Schienbein!\n",
    Name(WER)+" tritt @WEN gegens Schienbein!\n", DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 350,
   Name(WESSEN) + " Augen rollen nach hinten. Mit finsteren Worten verflucht sie dich!\n",
   Name(WESSEN) + " Augen rollen nach hinten. Mit finsteren Worten verflucht sie @WEN!\n",
    DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_POISON,
    "Die Spinne auf " + Name(WESSEN) + " Schulter beisst dich!\n",
    "Die Spinne auf "+Name(WESSEN)+" Schullter beisst @WEN!\n",
     DT_POISON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 500, 
    "Zwischen "+Name(WESSEN)+" Haenden zucken Blitze. Dann beruehrt sie dich!\n",
    "Zwischen "+Name(WESSEN)+" Haenden zucken Blitze. Dann beruehrt sie @WEN!\n", DT_ELECTRIC, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_BLIND,
    Name(WER)+ " kratzt dir die Augen aus!\n",
    Name(WER)+" kratzt @WEM die Augen aus!\n");

//--Ausruestung------------------------------------------------------------

  SUID;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sieht dich wunderlich an.",
        "sieht "+TPN+" wunderlich an.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "rollt mit den Augen.",
        "rollt mit den Augen.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Das ist amateurhaft, "+TPN+"!",
        "sagt: Das ist amateurhaft, "+TPN+"!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
      "rollt mit den Augen.",
      "rollt mit den Augen.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Es ist unangebracht sowas ohne Einverstaendnis mit anderen zu machen.",
        "sagt: Es ist unangebracht sowas ohne Einverstaendnis mit anderen zu machen.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "starrt dich irgendwie angeekelt - oder ueberfordert - an.",
        "starrt "+TPN+" irgendwie angeekelt - oder ueberfordert - an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}

void GiveIntroduction ()
{
   write ("Mittwoch gibt Dir noch einen morschen Knochen und meint:\n"+
         BS("Seid nett zu Eurem neuen Gefaehrten, denn selbst das treuste alternativ Lebende vertraegt nicht alles! "
            "Denk also ans richtige Futter, dass du auch hier kaufen kannst." ));
   say ( "Mittwoch gibt "+this_player()->Name(WEM)+" noch einen Gegenstand und meint:\n"+
        BS("Seid nett zu Eurem neuen Gefaehrten, denn selbst das treuste alternativ Lebende vertraegt nicht alles! "
        "Denk also ans richtige Futter, dass du auch hier kaufen kannst." ), ({this_player()}) );
}