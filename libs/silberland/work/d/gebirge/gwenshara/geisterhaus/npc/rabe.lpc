#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzer Rabe, der staendig 'Nimmermehr!' kraechzt");
  SetProp(P_LONG,
    "Eigentlich ein ganz normaler, schwarzer Rabe. Nur haelt er seine Klappe nicht "
    "und kraechzt staendig 'nimmermehr'. Das macht dich wahnsinnig.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Rabe");
  SetProp(P_GENDER, MALE);
  AddId(({"rabe", "nimmermehr"}));
  AddClass( ({CL_ANIMAL, CL_FLYING}) );
  SetProp(P_ARTICLE, 1);

  set_living_name("derschwarzerabenimmermehr");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(12);

  SetProp(P_HANDS, ({" mit seinen scharfen Krallen",
                    QueryProp(P_HANDS)[1],
                    ({DT_UNHOLY, DT_MAGIC})
                    }) );
                    
  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 40);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kraechzt und laesst @WEN fallen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");

//--Tod--------------------------------------------------------------------

  SetProp(P_MURDER_MSG, "Nimmermehr!");
  SetProp(P_KILL_MSG, "Nimmermehr!");

//--Infos------------------------------------------------------------------

  SetChats(3,
  ({Name(WER, 1)+" kraechzt: Nimmermehr!\n",
   }) );

  AddInfo(DEFAULT_INFO, " schaut dich an.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Ausruestung------------------------------------------------------------

  SUID;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}