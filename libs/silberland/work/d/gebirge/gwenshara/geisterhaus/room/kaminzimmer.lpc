#include "../def.h"

inherit "std/room";

private int rabe;

void create()
{
  ::create();
  rabe = 1;

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "Im Kaminzimmer einer gruseligen Villa");
    SetProp(P_INT_LONG,
        "Dieses Zimmer ist dafuer gedacht, um hier zu lesen oder Zeit mit "
        "Nachdenken zu verbringen. Ein grosser Kamin beherrscht den Raum, vor "
        "dem zwei alte und vergilbte Sessel stehen. Zwischen ihnen ein kleiner, "
        "von Ratten angenagter Beistelltisch. Jeder freie Fleck der Waende wurde "
        "mit toten Tieren behaengt. Da sind Rehgeweihe, Dachskoepfe, ausgestopfte "
        "Voegel und Nager. Ueber dem Kamin haengt ein grosser Elchkopf.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

    AddDetail( ({ "waende" }),
        "Die gruen tapezierten Waende sind ueber und ueber mit den Ueberresten toter Tiere "
        "behaengt.");

    AddDetail( ({ "ueberreste", "ueberresten" }),
        "Koepfe, Geweihe, ausgestopfte Kleintiere. Alles was das Jaegerherz hoeher schlagen laesst.");

    AddDetail( ({ "tiere", "tieren" }),
        "Du kannst verschiedene Tiere sehen: Da sind Geweihe, Dachskoepfe, ausgestoepfte Voegel und "
        "Nagetiere");

    AddDetail( ({"geweihe"}),
        "Du wuerdest sagen, dass hier die Geweihe von acht Rehboecken, teilweise ganz und teilweise "
        "gebrochen im Zimmer verteilt sind. Ein paar merkwuerdiger Hoerner haengen ueber "
        "der Tuer.");

    AddDetail( ({ "hoerner" }),
        "Es sind merkwuerdig verdrehte Daemonenhoerner, kommt dir vor.");

    AddDetail( ({ "daemonenhoerner" }),
        "Bei genauerem Hinsehen erkensnt du doch, dass hier lediglich die Hoerner von zwei "
        "Ziegen einfach nur merkwuerdig aneinander gehaengt wurden.");

    AddDetail( ({ "voegel" }),
        "Du erkennst etwa zwoelf Voegel verteilt. Drei davon sind Stoerche und ein Wiedehopf "
        "wurde auf einen Ast in einer Ecke gestellt. Der Grossteil wird von einem Schwarm "
        "Spatzen ausgemacht, der unterm der Leuchter an der Decke drapiert wurde. Der Rest "
        "sind Raben.");

    AddDetail( ({"raben"}),
        "Die ausgestopften Raben funkeln dich dunkel von oben herab an. Bei einem der Raben "
        "meinst du sogar, dass er sich gerade eben bewegt haette!");

    AddDetail( ({ "nagetiere" }),
        "Eine Unzahl an Nagetieren steht hier auf Steinen, Holzplatten und Aesten herum. "
        "Wer auch immer diese Tiere gejagd hat, hatte wohl einen besonderen Hass auf Marder. "
        "Drei von diesen Viechern sind links und genau so viele nochmal rechts neben dem "
        "Kamin aufgestellt.");

    AddDetail("beistelltisch", "Der kleine Beistelltisch zwischen den Sesseln ist von Ratten angenagt und in einem desolaten Zustand.");

    AddDetail("boden", "Der Boden des Raumes ist mit einem alten, verstaubten Teppich bedeckt.");
    
    AddDetail("dachskoepfe", "Einige Dachskoepfe sind an der Wand befestigt und wirken alt und vergilbt.");
    
    AddDetail("elchkopf", "Ueber dem Kamin haengt ein imposanter Elchkopf, der den Raum dominiert.");
    
    AddDetail("fleck", "Jeder freie Fleck an den Waenden ist mit toten Tieren behaengt.");
    
    AddDetail("kamin", "Der grosse Kamin ist das zentrale Element des Raumes und sorgt fuer eine duestere Atmosphaere.");
    
    AddDetail("nachdenken", "Der Raum scheint dafuer gemacht zu sein, hier in Ruhe nachzudenken und Zeit zu verbringen.");
    
    AddDetail("nager", "Verschiedene ausgestopfte Nagetiere sind im Raum verteilt, darunter auch einige Marder.");
    
    AddDetail("ratten", "Der Beistelltisch wurde von Ratten angefressen, und du kannst noch einige der Nager herumhuschen sehen.");
    
    AddDetail("raum", "Das Kaminzimmer der gruseligen Villa ist ein Ort des Nachdenkens und der Ruhe.");
    
    AddDetail("rehgeweihe", "Die Rehgeweihe sind im Raum verteilt und zeugen von Jagderfolgen.");
    
    AddDetail(({"aesten", "aeste"}), "Einige Aeste sind auf Steinen, Holzplatten und dem Beistelltisch im Raum verteilt.");

    AddDetail("ast", "Ein einzelner Ast liegt auf dem Beistelltisch und wirkt, als waere er von Nagetieren bearbeitet worden.");

    AddDetail("atmosphaere", "Die Atmosphaere in diesem Raum ist duester und erfuellt von morbider Dekoration.");

    AddDetail("dachsk", "Die ausgestopften Dachse an der Wand wirken alt und vergilbt.");

    AddDetail("decke", "Die Decke des Raumes ist von den vielen ausgestopften Tieren dominiert.");

    AddDetail("ecke", "In einer Ecke des Raumes steht der Elchkopf ueber dem Kamin.");

    AddDetail("element", "Der grosse Kamin ist ein zentrales Element des Raumes und sorgt fuer eine gruselige Stimmung.");

    AddDetail("grossteil", "Der Grossteil der ausgestopften Tiere an den Waenden besteht aus Geweihen, Dachskoepfen, Voegeln und Nagetieren.");

    AddDetail("hass", "Es scheint, als haette der Sammler der ausgestopften Tiere einen besonderen Hass auf Marder gehabt.");

    AddDetail("himmel", "Der Himmel draussen ist nicht sichtbar, da es keine Fenster gibt.");

    AddDetail("hinsehen", "Wenn du genauer hinblickst, erkennst du viele Einzelheiten in der morbiden Dekoration des Raumes.");

    AddDetail("holzplatten", "Einige der Nagetiere stehen auf Holzplatten, die im Raum verteilt sind.");

    AddDetail("jaegerherz", "Der Raum erinnert an den Salon eines Jaegers, der seine Jagderfolge zur Schau stellt.");

    AddDetail(({"jagderfolgen", "jagderfolge"}), "Die vielen ausgestopften Tiere an den Waenden zeugen von erfolgreichen Jagderfolgen.");

    AddDetail("kaminzimmer", "Du befindest dich im Kaminzimmer einer gruseligen Villa.");

    AddDetail("kleintiere", "Unter den ausgestopften Tieren findest du auch Kleintiere wie Marder und Wiedehopf.");

    AddDetail("leuchter", "Ein Schwarm Spatzen wurde unter dem Leuchter an der Decke drapiert.");

    AddDetail("marder", "Einige der ausgestopften Tiere sind Marder, die neben dem Kamin aufgestellt sind.");

    AddDetail("ort", "Dieser Raum ist ein ungewoehnlicher Ort, gefuellt mit ausgestopften Tieren und morbider Dekoration.");

    AddDetail(({"rehboecken", "rehboecke"}), "Die Geweihe von acht Rehboecken sind im Raum verteilt, einige davon sind ganz, andere gebrochen.");

    AddDetail("rest", "Der Raum wirkt wie der Rest eines gruseligen Sammlerstuecks.");

    AddDetail("ruhe", "Der Raum strahlt eine unheimliche Ruhe aus, die zum Nachdenken einlaedt.");

    AddDetail("schwarm", "Ein Schwarm Spatzen wurde unter dem Leuchter an der Decke drapiert und wirkt leblos.");

    AddDetail("sessel", "Zwei alte und vergilbte Sessel stehen vor dem Kamin und laden zum Verweilen ein.");

    AddDetail("spatzen", "Die sechs ausgestopften Spatzen unter dem Leuchter wirken leblos und erstarrt.");

    AddDetail("steinen", "Einige Nagetiere stehen auf Steinen im Raum verteilt.");

    AddDetail("stoerche", "Drei Stoerche sind unter den ausgestopften Voegeln im Raum.");

    AddDetail("teppich", "Der Boden des Raumes ist mit einem alten, verstaubten Teppich bedeckt.");

    AddDetail("tuer", "Die Tuer fuehrt zurueck in die Villa.");

    AddDetail("unzahl", "Es gibt eine Unzahl ausgestopfter Tiere in diesem Raum.");

    AddDetail("viechern", "Die vielen ausgestopften Tiere im Raum wirken gruselig und surreal.");

    AddDetail("villa", "Dieser Raum befindet sich in einer gruseligen Villa.");

    AddDetail("wand", "Die Waende sind mit den ausgestopften Tieren behaengt und verleihen dem Raum eine morbide Atmosphaere.");

    AddDetail("wiedehopf", "Ein ausgestopfter Wiedehopf wurde auf einen Ast in einer Ecke gestellt.");

    AddDetail("zeit", "Dieser Raum laedt dazu ein, Zeit mit Nachdenken zu verbringen und die morbide Dekoration zu betrachten.");

    AddDetail(({"ziegen", "ziegenhoerner"}), "Die verdrehten Ziegenhoerner wirken merkwuerdig und sind ueber der Tuer angebracht.");

    AddDetail("zimmer", "Du befindest dich in einem ungewoehnlich gestalteten Zimmer mit morbider Dekoration.");

    AddDetail("zustand", "Der Zustand des Beistelltisches ist desolat und von Ratten angenagt.");

    AddDetail("dekoration", "Die morbide Dekoration dieses Raumes besteht aus den ausgestopften Tieren an den Waenden und anderen seltsamen Objekten.");

    AddDetail("einzelheiten", "Bei genauer Betrachtung kannst du viele Einzelheiten in der Dekoration dieses Raumes erkennen.");

    AddDetail("fenster", "Es gibt keine Fenster in diesem Raum, was die duestere Stimmung verstaerkt.");

    AddDetail("jaegers", "Die ausgestopften Tiere erinnern an die Trophaeen eines Jaegers.");

    AddDetail("salon", "Dieser Raum koennte als ein ungewoehnlicher Salon betrachtet werden, der von einem eigenartigen Sammler eingerichtet wurde.");

    AddDetail("sammler", "Der Sammler dieses Raumes hatte offensichtlich eine Vorliebe fuer ausgestopfte Tiere und morbide Dekoration.");

    AddDetail("sammlerstuecks", "Der Raum selbst wirkt wie das Sammlerstueck eines eigenartigen Liebhabers.");

    AddDetail("schau", "Die ausgestopften Tiere dienen hier zur Schau und erzeugen eine unheimliche Stimmung.");

    AddDetail("stimmung", "Die Stimmung in diesem Raum ist duester und gespenstisch, was zum Verweilen einlaedt.");

    AddDetail("verweilen", "Die alten Sessel vor dem Kamin laden dazu ein, einen Moment innezuhalten und die morbide Dekoration zu betrachten.");


    AddSpecialDetail( ({"rabe"}), "detail_rabe");
//--Ausgaenge--------------------------------------------------------------

   AddExit( "sueden", ROOM "halle" );

   AddCmd("verweile|verweil&auf&sessel", "cmd_verweilen", "Worauf willst du verweilen?\n");

}

public int cmd_verweilen(string str) {
  write(BS("Du setzt sich einen Moment auf einen der staubigen alten Sessel. Doch gleich erhebst "
           "du dich nervoes wieder... Hier kannst du nicht gut ausrasten."));
  say(BS(TPN+" setzt sich kurz auf einen Sessel, steht aber gleich wieder auf."));
  return 1;         
}

public string detail_rabe() {
  if(rabe && find_call_out("get_raven") == -1 && !objectp(find_living("derrabenimmermehr"))) {
    call_out("get_raven", 0);
    return BS("Als du den ausgestopften Raben genauer beaugst reckt er ploetzlich "
              "den Kopf nach dir und kraechzt: NIMMERMEHR!");
  } else {
    return BS("Es muss sich um einen Schattenspiel gehandelt haben. Der Rabe ist tatsaechlich "
              "ausgestopft und mausetot.");
  }
}

public void get_raven() {
  object ob;

  ob = clone_object(NPC "rabe");
  if(ob->move(TO, M_GO) != 1) {
    ob->remove();
    return;
  }

  rabe = 0;
  return;
}

public void reset() {
  ::reset();

  if(!rabe && find_call_out("get_raven") == -1 && !objectp(find_living("derrabenimmermehr"))) {
    rabe = 1;
  }
}