#include "../def.h"

inherit "std/room";

void create()
{
  replace_program("/std/room");
  ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "In einem Gang in einer gruseligen Villa");
    SetProp(P_INT_LONG,
        "Bei jedem deiner Schritte knarzt es unter deinen Fuessen, da "
        "dieser Gang mit alten und teils morschen Bohlen ausgelegt ist. "
        "Die Waende sind mit einer alten, gruen-gelben Tapete mit einem "
        "sehr verwirrenden Muster beklebt. Am hinteren Ende dieses Ganges "
        "steht ein grosser, ausgestopfter Baer. Mehrere Tueren gehen "
        "von hier aus in andere Zimmer.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

    AddDetail("baer", "Der ausgestopfte Baer steht am hinteren Ende des Ganges und wirkt bedrohlich.");

    AddDetail("boden", "Der Boden dieses Ganges besteht aus alten und morschen Bohlen, die bei jedem Schritt knarzen.");

    AddDetail("bohlen", "Die Bohlen des Bodens sind alt und morsch, wodurch sie bei jedem Schritt laut knarzen.");

    AddDetail("ende", "Am Ende des Ganges steht der ausgestopfte Baer und versperrt den Weg.");

    AddDetail("fuessen", "Unter deinen Fuessen knarzt es bei jedem Schritt, was die gruselige Atmosphaere verstaerkt.");

    AddDetail("gang", "Der Gang ist duester und unheimlich, mit alten Bohlen und einer gruen-gelben Tapete mit verwirrendem Muster an den Waenden.");

    AddDetail("himmel", "Der Himmel draussen ist nicht sichtbar, da es keine Fenster gibt.");

    AddDetail("muster", "Das Muster auf der gruen-gelben Tapete wirkt verwirrend und verstaerkt die gruselige Atmosphaere.");

    AddDetail("schritte", "Deine Schritte hallen laut durch den Gang und erzeugen eine unheimliche Stimmung.");

    AddDetail("tapete", "Die gruen-gelbe Tapete an den Waenden ist alt und abgenutzt, mit einem verwirrenden Muster.");

    AddDetail("tueren", "Mehrere Tueren fuehren von diesem Gang aus in andere Zimmer der Villa.");

    AddDetail("waende", "Die Waende sind mit der gruen-gelben Tapete bedeckt und tragen zum unheimlichen Ambiente bei.");

    AddDetail("zimmer", "Die Tueren fuehren zu verschiedenen Zimmern in der gruseligen Villa, deren Geheimnisse du vielleicht noch entdecken wirst.");

    AddDetail("ambiente", "Das Ambiente in diesem Gang ist duester und unheimlich, was eine gruselige Stimmung erzeugt.");

    AddDetail("atmosphaere", "Die Atmosphaere in diesem Gang ist gespenstisch und verstaerkt das unheimliche Gefuehl.");

    AddDetail("fenster", "Es gibt keine Fenster in diesem Gang, und er ist in Dunkelheit gehuellt, was die gruselige Stimmung verstaerkt.");

    AddDetail("geheimnisse", "Der Gang birgt sicherlich viele Geheimnisse, die darauf warten, entdeckt zu werden.");

    AddDetail("schritt", "Jeder deiner Schritte hallt in diesem duesteren Gang wider und verstaerkt die gespenstische Stimmung.");

    AddDetail("stimmung", "Die Stimmung in diesem Gang ist unheimlich und vermittelt das Gefuehl, dass hier etwas Geheimnisvolles geschehen ist.");

    AddDetail("villa", "Du befindest dich in einer gruseligen Villa, die viele Geheimnisse birgt und eine bedrohliche Atmosphaere ausstrahlt.");

    AddDetail("weg", "Der Weg fuehrt dich weiter durch den duesteren Gang, wo weitere Geheimnisse auf dich warten koennten.");

    AddDetail("dunkelheit", "Die Dunkelheit in diesem Gang ist erdrueckend und verstaerkt das geheimnisvolle Ambiente.");

    AddDetail("gefuehl", "Ein unheimliches Gefuehl durchdringt dich, waehrend du durch den duesteren Gang schreitest.");

    AddDetail("geheimnisvolles", "Der Gang verbirgt viele geheimnisvolle Aspekte, die neugierig machen und den Nervenkitzel steigern.");

    AddDetail("aspekte", "Die verschiedenen Aspekte dieses geheimnisvollen Gangs ziehen deine Aufmerksamkeit auf sich und verstaerken die düúestere Atmosphaere.");

    AddDetail("nervenkitzel", "Während du durch den Gang gehst, spuerst du einen unheimlichen Nervenkitzel, der von den verborgenen Geheimnissen und der Dunkelheit des Ortes herruehrt.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "unten", ROOM "halle" );
  AddExit( "norden", ROOM "doktor");
  AddExit( "sueden", ROOM "barde");
  AddExit( "osten", ROOM "schlafzimmer");

//--Items & NPCs-----------------------------------------------------------

}
