#include "../def.h"

inherit "std/room";

private int katze, sarg;
private object graeber;

void create()
{
  ::create();

  katze = sarg = 1;
  graeber = 0;

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "In einem gruseligen Vorgarten");
    SetProp(P_INT_LONG,
        "Du befindest dich hier in einem duesteren Garten vor einer alten "
        "Villa. Ein schmiedeeisernes Tor grenzt den Garten von dem Friedhof "
        "ab. Rings um dich stehen mehr oder weniger verkrueppelte Buesche, "
        "so dass du erahnen kannst, dass dieses Anwesen wohl einst huebsch "
        "war. Doch jetzt sind die Spuren von Verfall ueberall zu erkennen. "
        "Vor dem Eingang zum Haus steht ein einzelner, verkrueppelter "
        "und kahler Baum. Rings um dich wallt bestaendig ein kuehler Gruftnebel "
        "ueber die feuchte Graberde.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

    AddDetail( ({ "garten", "vorgarten" }),
        "Obwohl nicht sehr einladend, zeigen dir die verkrueppelten Buesche und das "
        "modrige Gras, dass du hier einer Art Vorgarten gelandet bist.");

    AddDetail( ({ "gras" }),
        "Da paar wenigen Grasflecken, die du in der modrigen Erde findest sind alle "
        "bestenfalls grau-gruen und sehen sehr kraenklich aus. So als wuerde ihnen "
        "irgendetwas das Leben aussaugen.");

    AddDetail( ({ "leben" }),
        "Dieser ganze Ort wirkt irgendwie krank und leblos.");

    AddDetail( ({ "villa", "haus", "hauses" }),
        "Duester und drohend erhebt sich eine alte Villa vor dir. Sie war einst "
        "wohl sehr edel, ist aber jetzt vom Verfall gepraegt. Die Farbe an der Mauer "
        "blaettert ab und stellenweise ist das blanke Mauerwerk zu erkennen. Die "
        "Fenster stieren wie dunkle Augenhoehlen von der Fassade und Efeu rankt "
        "sich bis zum Dach nach oben.");

    AddDetail( ({ "farbe" }),
        "Die Mauern waren wohl einmal weiss getuencht. Jetzt sind sie eher grau und "
        "ganze Brocken von Putz fallen von ihr ab.");

    AddDetail( ({ "mauer" }),
        "Die Mauern der Villa rotten genauso vor sich hin, wie alles andere hier.");

    AddDetail( ({ "mauerwerk" }),
        "Dort, wo der Putz abbroeckelt, kannst du die Ziegel der Mauer erkennen.");

    AddDetail( ({ "fenster" }),
        "Obwohl alle Fenster noch gut mit Glas versehen sind, scheinen sie dir wie "
        "leere Augenhoehlen auf dich herab zu stieren. Moment? Hast du da nicht gerade "
        "eine Bewegung entdeckt?!");

    AddDetail( ({ "hoehlen", "augenhoehlen" }),
        "Die Fenster wirken wie unzaehlige Augenhoehlen. Als wuerde dich das Haus genau "
        "beobachten.");

    AddDetail( ({ "fassade", "wand", "hauswand" }),
        "Die Fassade der Villa war einst prachtvoll. Einige verblassende Malerein sind noch "
        "zu erkennen. Jetzt rankt sich an ihr Efeu bis zum Dach empor.");

    AddDetail( ({ "efeu" }),
        "Eine Seite des Hauses ist dicht mit Efeu bewachsen. Ob man daran wohl hochklettern "
        "koennte?");

    AddDetail( ({ "dach" }),
        "Das Dach ist mit roten Holzschindeln gedeckt. Hier und dort scheint es bereits eingesunken "
        "und generell nicht wunderbar in Schuss zu sein. Ganz oben am Haus queitscht ein alter Wetterhahn "
        "vor sich hin.");

    AddDetail( ({ "schindeln", "holzschindeln" }),
        "Rote, modernde Holzschindeln bedecken das Dach.");

    AddDetail( ({ "schuss" }),
        "Diese Villa hat schon bessere Zeiten gesehen.");

    AddDetail( ({ "zeiten" }),
        "Frueher war eben alles besser.");

    AddDetail( ({ "hahn", "wetterhahn" }),
        "Merkwuedrig. Der Wetterhahn bewegt sich gar nicht mit dem Wind. Und war da nicht eben ein Schatten?");

    AddDetail( ({ "wind" }),
        "Der Wind weht mal von hier und mal von dort.");

    AddDetail( ({ "schatten" }),
        "Du bist dir fast sicher, dass du dort am Dach einen Schatten gesehen hast.");

    AddDetail( ({ "tor" }),
        "Ein schmiedeeisernes Tor trennt dieses Anwesen vom Friedhof. Die Torfluegel "
        "bestehen aus verschlungenen Metallstangen. Es steht weit offen.");

    AddDetail( ({ "fluegel", "torfluegel" }),
        "Die beiden Fluegel des Tors stehen sperrangelweit offen.");

    AddDetail( ({ "stangen", "metallstangen" }),
        "Das Tor wurde aus einzelnen Metallstangen gemacht, die ein verschlungenes Muster bilden.");

    AddDetail( ({ "muster" }),
        "Ein verworrenes, verschlungenes Muster.");

    AddDetail( ({ "friedhof" }),
        "Der Friedhof befindet sich westlich von dir, vor dem Tor. Dort ist es "
        "mindestens ebenso unheimlich wie hier.");

    AddDetail( ({ "buesche" }),
        "Wie knoecherne und verkrueppelte Finger ragen die kahlen Zweige der Buesche "
        "in den Himmel. Der Wind raschelt leise hindurch. Gerademal der Weg, der zum "
        "Eingang der Villa fuehrt ist von ihnen verschont. Links und rechts davon "
        "bilden sie an manchen Stellen ein dichtes, kahles Unterholz.");

    AddDetail( ({ "finger", "knochenfinger" }),
        "Die Zweige der Buesche ragen wie verkrueppelte Knochenfinger in die hoehe.");

    AddDetail( ({ "zweige" }),
        "Die einzelnen kahlen Zweige der Buesche scheinen dir wir grapschende Klauen nach oben "
        "zu ragen.");

    AddDetail( ({ "klauen" }),
        "Ganz so, als wuerde sich da etwas durch den Boden zu graben versuchen...");

    AddDetail( ({ "weg" }),
        "Der Weg, der durch diesen Garten zur Villa fuehrt, besteht eigentlich nur aus modriger "
        "Graberde.");

    AddDetail( ({ "stellen" }),
        "An manchen Stellen im Garten bilden die krueppeligen Buesche ein dichtes Unterholz.");

    AddDetail( ({ "unterholz" }),
        "Dort wo die Zweige der Buesche sich ineinander verfangen ist ein dichtes Unterholz "
        "entstanden. Ab und zu geht ein Rascheln und Raunen hindurch, als wuerde darin etwas "
        "leben. Und waren da nicht gerade gelb leuchtende Augen?!");

    AddDetail( ({ "rascheln", "raunen" }),
        "Die Buesche bewegen sich ab und zu, als wuerde darin etwas herumschleichen.");

    AddDetail( ({ "augen" }),
        "Eindeutig! Zwei gelb leuchtende Augen mit geschlitzten Pupillen starren dich aus "
        "dem Unterholz an, als waest du leichte Beute.");

    AddDetail( ({ "pupillen" }),
        "Regelrecht raubtierhaft, aber auch ueberaus intelligent.");

    AddDetail( ({ "beute" }),
        "Bist du leichte Beute, oder scheuchst du das Monster auf?");

    AddDetail( ({ "monster" }),
        "Vermutlich ein schreckliches Monster, dass dich fressen will.");

    AddDetail( ({ "anwesen" }),
        "Dieses ganze Anwesen war vor langer Zeit sicher einst sehr edel und gut "
        "gepflegt. Jetzt ist der Garten verwildet und die Villa dem Verfall preisgegeben.");

    AddDetail( ({ "zeit" }),
        "Auch deine Zeit laeuft ab.");

    AddDetail( ({ "spuren", "verfall" }),
        "Uerbeall um dich herum merkst du die Spuren von Verfall und Verwesung. Die Buesche "
        "sind kahl, die Mauer broeckelig und das Dach hie und da eingefallen. Moos und Efeu "
        "wachsen an der Hauswand. Sogar der Boden besteht nur aus modriger Erde und grauem Gras.");

    AddDetail( ({ "verwesung" }),
        "Du kannst sehen und riechen.");

    AddDetail( ({ "moos" }),
        "Feuchtes Moos hat sich an der Mauer festgesaugt.");

    AddDetail( ({ "boden" }),
        "Der Boden rings um dich besteht eigentlich nur aus modriger Erde und grauem Gras.");

    AddDetail( ({ "eingang" }),
        "Der Eingang zum Haus ist ueber drei kleine Stufen zu erreichen. Die Tuer ist aus "
        "schwarz-braunem Holz von dem der Lack abblaettert. Neben dem Eingang siehst du eine "
        "goldene Plakette.");

    AddDetail( ({ "stufen" }),
        "Die Stufen sind aus Stein gehauen und ebenso broeckelt. Sie sind mit Rissen durchzogen.");

    AddDetail( ({ "tuer" }),
        "Die Tuer ist eine recht gewoehnlich, wenn auch vernachlaessigte Tuer. Sie ist braun-schwarz "
        "lackiert, wobei der Lack bereits abzublaettern beginnt.");

    AddDetail( ({ "holz" }),
        "Das Holz der Tuer war urspruenglich wohl nicht braun-schwarz, sondern einfache Birke.");

    AddDetail( ({ "lack" }),
        "Der Lack blaettert bereits von der Tuer, was aussieht wie Klauenspuren.");

    AddDetail( ({ "plakette" }),
        "Die goldene Plakette prangt neben der Eingangstuer. Auf ihr steht etwas geschrieben.");

    AddReadDetail( ({ "plakette" }),
        "A.A.L - Asylheim fuer Alternatives Leben.\n\"Ob tot oder untot, alle Formen von alternativem Leben sind gerne willkommen.\"\n\n"
        "1. Stock: Dr. Frank N. Stein, Facharzt fuer reanimative Medizin, Ordination nach Terminvereinbarung");

    AddDetail( ({ "birke" }),
        "Billiges Holz, leicht zu verarbeiten.");

    AddDetail( ({ "klauenspuren" }),
        "Ist wohl nur Einbildung.");

    AddDetail( ({ "einbildung" }),
        "Hoffentlich.");

    AddDetail( ({ "baum" }),
        "Ein knorriger und verwachsener Baum reckt sich vor dem Haus in den Himmel. Kein einziges "
        "Blatt waechst darauf. Die verdrehten Aeste winden sich wie gebrochene Arme. Grau-gruene "
        "Flechten haengen von ihnen herab.");

    AddDetail( ({ "himmel" }),
        "Der Himmel ist von grau-schwarzen Regenwolken bedeckt.");

    AddDetail( ({ "wolken", "regenwolken", "wetter" }),
        "Nicht gerade das beste Wetter.");

    AddDetail( ({ "blatt" }),
        "Kein einziges davon ist zu sehen.");

    AddDetail( ({ "aeste", "arme" }),
        "Die Aeste sehen aus wie mehrfach gebrochene Arme. Das kann nichts Gutes verheissen. Von einem "
        "der Aeste baumelt etwas herab.");
    
    AddDetail( ({ "flechten" }),
        "Unheimliche grau-gruene Flechten wehen im Wind.");

    AddDetail( ({ "ast" }),
        "Wuha! Von dem Ast haengt ein Strick mit elegantem Henkersknoten.");

    AddDetail( ({ "strick" }),
        "Der Strick sieht recht neu aus und wurde fachkundig zu einem Henkersknoten gebunden.");

    AddDetail( ({ "knoten", "henkersknoten" }),
        "Eine Galgenschlinge. Wozu man die hier brauchen koennte?");

    AddDetail( ({ "schlinge", "galgenschlinge" }),
        "Vielleicht hat's hier jemandem gereicht mit dem Leben? Du koenntest ja mal probieren, ob die Schlinge passt.");

    AddDetail( ({ "nebel", "gruftnebel" }),
        "Grauer, dichter Gruftnebel wallt in unregelmaessigen Abstaenden ueber den Boden. "
        "Wuesstest du es nicht besser, wuerdest du erwarten, dass sich jeden Moment ein Untoter "
        "aus der feuchten Erde wuehlt.");

    AddDetail( ({ "abstaende", "abstaenden" }),
        "Unregelmaessig wallt Gruftnebel ueber den Boden.");

    AddDetail( ({ "moment" }),
        "Jetzt gerade!");

    AddDetail( ({ "untoter" }),
        "Angespannt wartetst du... aber nicht passiert.");

    AddDetail( ({ "erde", "graberde" }),
        "Das feuchte Erdreich um dich herum scheint wie frische Graberde. Modrig und nass "
        "klebt es an deinen Schuhen.");

    AddDetail( ({ "schuhe", "schuhen" }),
        "Deine Schuhe werden hier ganz versaut. Die Erde scheint recht locker zu sein, so wie sie an "
        "dor klebt. Ob hier jemand gerade erst umgegraben hat?");

//--Kommandos--------------------------------------------------------------

  AddCmd( CMD_KLETTERN, "cmd_hochklettern" );
  AddCmd( ({ "scheuch", "scheuche" }), "cmd_scheuchen" );
  AddCmd( ({"probiere", "probier"}), "cmd_schlinge");
  AddCmd( ({"grab", "grabe", "buddel", "buddle"}), "cmd_graben");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ANSCHLUSS_GEBIRGE );
  AddExit( "osten", ROOM "halle");

//--Items & NPCs-----------------------------------------------------------

}

//--Funktionen fuer Kommandos----------------------------------------------

public int cmd_schlinge(string str) {
    notify_fail("Was willst du probieren?\n");
    if(str != "schlinge" && str != "strick" && str != "galgenstrick" &&
       str != "galgen" && str != "galgenschlinge") return 0;

    write(BS("Vorsichtig legst du dir den Strick um den Hals. Passt wie angegossen. Du laesst es doch lieber."));
    say(BS(TPN + " klettert auf den Baum und legt sich einen Strick um den Hals."));

    return 1;
}

int cmd_hochklettern(string str)
{
  notify_fail("Woran willst du hochklettern?\n");

  if (!str || str == "") return 0;
  if (str != "an efeu hoch" && str != "an mauer hoch") return 0;

  tell_object(TP, BS("Mit einem kraftvollen Zug willst du dich am Efeu hochziehen. Doch just in diesem Moment reisst ein Teil "
              "der Pflanze ab und du krachst unsanft zu Boden. Mit lautem Kraechzen fliegt ein Schwarm Kraehen vom Dach weg."));
  say(BS(TPN + " versucht am Efeu hochzuklettern und reisst dabei einen Teil der Pflanze zu Boden."));

  TP->AddHp(-10);

  return 1;
}

int cmd_scheuchen(string str) {
    object ob;
    notify_fail("Was willst du aufscheuchen?\n");
    if(!str || str == "") return 0;
    if(str != "monster auf" && str != "etwas auf" && 
       str != "tier auf" && str != "augen auf") return 0;
       
    write(BS("Mit grossem Getoese rennst du auf das Augenpaar zu."));
    say(BS(TPN + " rennt mir grossem Getoese und Gefuchtel ins Unterholz"));

    if(katze) {
        tell_room(TO, BS("Mit einem Fauchen und Zischen springt eine struppige schwarze Katze hinter den Bueschen hervor."));
        ob = clone_object(NPC "beelzebub");
        if(ob->move(TO, M_GO) != 1) {
            ob->remove();
        }
        katze = 0;
    } else {
        write(BS("Ausser ein paar Kratzern durch die Buesche hast du nichts erreicht... Du musst dich getaeuscht haben."));
        say(BS(TPN + " kommt mit ein paar Kratzern auf den Armen wieder zurueck."));
        TP->AddHp(-5);
    }

    return 1;
}

int cmd_graben(string str) {
    object ob;

    notify_fail("Wo willst du graben?\n");
    if(!str || str == "") return 0;
    if(str != "in erde" && str == "in graberde" &&
       str != "in boden" && str == "hier") return 0;

    if(objectp(graeber)) {
        write(BS("Da graebt doch gerade jemand! Warte doch mal ab."));
        return -1;
    }

    write(BS("Du beginnst ein Loch in der weichen Erde auszuheben."));
    say(BS(TPN + " hebt ein Loch in der weichen Erde aus"));
    graeber = TP;
    TP->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: 6,
        PARALYZE_MSG: "Du graebst gerade.\n",
        PARALYZE_MSG_OTHER: "%s graebt immer weiter.\n",
        PARALYZE_END: "Erledigt steckst du die Schaufel wieder weg und...\n",
        PARALYZE_END_OTHER: "%s hat fertig gegraben, klettert aus dem Loch und ...\n"]));

    call_out("graben_ende", 8, TP);
    return 1;
}

public void graben_ende(object pl) {
    object ob;
    if(sarg) {
        tell_object(pl, BS("... foerderst doch tatsaechlich einen alten, muffigen Sarg zu Tage!"));
        tell_room(TO, BS("... und hebt einen alten, muffigen Sarg heraus!"), ({pl}));
        ob = clone_object(OBJ "sarg");
        if(ob->move(TO, M_NOCHECK|M_SILENT) != 1) {
            ob->remove();
        }
        sarg = 0;
    } else {
        tell_object(pl, BS("...findest nichts. Schade."));
        tell_room(TO, BS("... sieht etwas enttaeuscht aus."), ({pl}));
    }

    graeber = 0;
}

public void reset() {    
    ::reset();

    if(!objectp(find_living("beelezbubderschwarzekater"))) {
        katze = 1;
        tell_room(TO, BS("Irgendwas raschelt zwischen den Bueschen."));
    }

    sarg = 1;
}