#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "In einem blutverschmierten Zimmer");
    SetProp(P_INT_LONG,
        "Du stehst in einem blutverschmierten Raum, ueberall Blut zu sehen, an den "
        "Waenden und der Decke auf dem Boden einfach ueberall du bist dir sicher, dass "
        "hier jemand wohnt und seine Rituale abhaelt. In der Ecke steht "
        "ein riesiger Altar. Uerbeall liegen Knochen und Knochenteile verstreut.");

//--Umgebung---------------------------------------------------------------

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 1);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

    AddDetail( ({ "blut" }),
        "Du bist leider kein Vampir der das Blut zu ordnen könnte, aber du könntest es ja mal kosten?");
    
    AddDetail( ({"vampir"}),
        "Gibt es am Friedhof im Osten von Burg Sturmfels wenn man daran glauben möchte. Oder hier auch?");

    AddDetail ( "friedhof",
        "Oestlich von Sturmfels liegt der Friedhof. Ein exzellenter Ort, um die Toten zu rufen!");

    AddDetail( ({"sturmfels", "burg"}),
        "Die Heimstatt der Goettin Dusty und ihrer Paladine.");

    AddDetail( ({"statt", "heimstatt"}),
        "Heilig und voller Gutem. Eine echte Burg der Paladine eben.");

    AddDetail( ({"paladin", "paladine"}),
        "Paladine sind die Streiter der Dusty fuer das Gute.");

    AddSpecialDetail( ({"heilig", "heiligkeit"}), "detail_heilig");

    AddDetail( ({"heiliger"}), 
        "Meinst du es ist gut hier, im Herz der Insel der Nekromanten über das Gute nach zu denken?");

    AddDetail( ({"nekromanten"}),
        "Leichenfledderer, Untotenbeschwoerer und Moerder, die am liebsten alle Seelen dem Boesen opfern wuerden.");

    AddDetail( ({"gute", "gutem", "gutes", "schlechtes"}),
        "Es gibt eben Gutes und Schlechtes, was bist du?");

    AddDetail( "seele", 
        "Pass auf das nicht deine Seele noch geopfert wird!");

    AddDetail( ({"waende", "wand"}),
        "Die Waende sind ueber und über mit Blut verschmiert. In all den Spritzern und Kleksen meinst du da und dort "
        "Worte lesen zu koennen.");

    AddDetail( "worte",
        "Ganz sicher. Hier wurden mit krakeliger Handschrift Worte aus Blut an die Waende geschmiert.");

    AddDetail("handschrift",
        "Die Handschrift ist krakelig und von einer kleinen Person.");

    AddReadDetail("worte",
        "Die Worte beschreiben Gedichte, Lieder und Reime, die vom Toeten, Morden und Zerstueckeln singen.");

    AddDetail( ({"toeten", "morden", "zerstueckeln"}),
        "Wer auch immer hier lebt muss ein krankes Hirn haben.");

    AddDetail( ({"hirn"}),
        "Du blickst dich um, findest aber keines. Schade eigentlich.");

    AddDetail( ({"decke"}),
        "Die Decke ist, wie die Waende und der gesammte Raum, mit Blut verschmiert. Eine Art Malerei scheint darauf gepinselt zu sein.");

    AddDetail( ({"malerei"}),
        "Tatsaechlich! Es handelt sich um ueberraschend detailreiches Fresko.");

    AddDetail( ({"fresko"}),
        "Da Fresko zeigt einen Nekromanten, der gerade einen Paladin qualvoll opfert und sein Herz den jenseitigen Fuersten "
        "der Niederhoellen opfert, in dem er es aufisst. Eine wirklich hervorragende Arbeit!");

    AddDetail( ({"herz"}),
        "Wie alles auf dem Fresko ist auch das Herz detailgetreu gezeichnet. Sogar ausgesprochen anatomisch korrekt!");

    AddDetail( ({"fuersten"}),
        "Schemenhaft sind die sieben Fuersten der Niederhoellen abgebildet.");

    AddDetail( ({"arbeit"}),
        "Wenn die Person, der dieser Ort gehoert nicht offensichtlich vollkommen gestoert waere, dann waere diese "
        "Arbeit in Rot auf Weiss ein echtes Meisterwerk. Gestoert, aber gut gemacht!");

    AddDetail( ({"person"}),
        "Wer auch immer hier lebt ist sicher vollkommen gestoert. Und ausserdem klein und flugfaehig.");

    AddDetail( ({"rot", "weiss", "blutrot", "knochenweiss", "farben"}),
        "Blutrot und Knocheneeiss sind hier die tonangebenden Farben. Geschmackvoll aber gewoehnungsbeduerftig.");

    AddDetail( ({"niederhoellen", "hoellen"}),
        "Die Niederhoellen sind der jenseigte Ort hinter dem Abgrund, wo die Seelenmuehle die Seelen der Frevler "
        "und Geopferten unter unsaeglichen Schmerzen zermalmt.");

    AddDetail( ({"ort", "orte"}),
        "Hier sind ueberall Orte!");

    AddDetail( ({"abgrund"}),
        "Der Abgrund ist eine besondere Ebene der Existenz, in der viele Daemonen hausen.");

    AddDetail( ({"ebene", "existenz"}),
        "Es gibt mehrere Ebenen der Existenz, wie eben den Abgrund.");

    AddDetail( "daemonen",
        "Daemonen sind, aehnlich den Nekromanten, Feinde allen Lebens.");

    AddDetail( ({"leben", "lebens"}),
        "Das Leben und das Gute an sich ist ihnen verhasst.");
    
    AddDetail( ({"freveler"}),
        "Jene, die gegen alles Gute verstossen haben.");

    AddDetail( "geopferten",
        "Hoffentlich bist du nicht bald einer davon!");

    AddDetail( "schmerzen",
        "Suesse, langsame Qualen...");

    AddDetail( "qualen",
        "Tausende und abertausende Qualen, die dich verzehren.");

    AddDetail( "boden",
        "Der Boden ist, wie der Rest, mit Blut bespritzt. Ausserdem stehen daruf ein Tisch samt Stuehlen.");

    AddDetail( "rest",
        "Der ganze Raum eben.");

    AddDetail( "tisch",
        "Auf dem Tisch befindet sich nichts interessantes. Nur Papierfetzen und Schriftrollen.");

    AddDetail( "papierfetzen",
        "Wortfetzen und merkwuerdige Symbole. Offenbar war jemand mit dem Ergebnis nicht zufrieden.");

    AddDetail( ({"wortfetzen"}),
        "Kaum noch zu entziffern.");

    AddDetail( "symbole",
        "Merkwuerdige Kringel, Linien und Faehnchen.");

    AddDetail( ({"kringel", "linien", "faehnchen"}),
        "Sieht aus wie... Noten?");

    AddDetail( "noten",
        "Offenbar hat sich hier jemand am Komponieren eines Musikstuecks versucht.");

    AddDetail( ({"komponieren", "musikstueck", "musikstuecks"}),
        "Irgendwie macht es das noch gruseliger, dass hier wohl eine Kuenstlerin lebt.");

    AddDetail( ({"kuenstlerin"}),
        "Offensichtlich wird dieser Ort von einer Kuenstlerin behaust. Genie und Wahnsinn sind "
        "oft nahe beieinander.");

    AddDetail( ({"genie", "wahnsinn"}),
        "Genie und Wahnsinn sind zwei seiten einer Muenze.");

    AddDetail( ({"seiten", "muenze"}),
        "Jetzt reicht es aber mit den Metaphern.");
    
    AddDetail( ({"metaphern"}),
        "ES REICHT!!!");

    AddDetail( ({"rollen", "schriftrollen"}),
        "Die Schriftrollen sind mit schwarzen Siegeln verschlossen.");

    AddDetail( ({"siegel", "siegeln"}),
        "Die Schritfrollen wurden mit schwarzen Siegeln verschlossen. Wer weiss welche "
        "Geheimnisse sie bergen?");

    AddDetail( ({"geheimnisse"}),
        "Die sind hinter den schwarzen Siegeln verborgen.");

    AddReadDetail( ({"rollen", "schriftrollen"}),
        "Du kannst sie nicht einfach so lasen, da sie vesiegelt sind.");
        
    AddDetail( ({"stuehle", "holzstuehle"}),
        "Schlichte und normale Holzstühle die keine Besonderheiten aufweisen ausser das sie wie der gesammte Raum mit Blut verschmiert sind.");

    AddDetail( "besonderheiten",
        "Tja. Die fehlen. Komisch.");

    AddDetail( "rituale", 
        "Welche Rituale auch immer hier abgehalten werden willst du dir gar nicht vorstelle. Alleine die Menge an Blut "
        "laesst schreckliche Arten von Folter und Grauen erahnen.");

    AddDetail( ({"arten", "folter"}),
        "Es gibt unzaehlige Arten von Folter, die du dir gar nicht ausmalen willst. Doch wer auch immer hier "
        "wohnt muss ein Meister darin sein.");

    AddDetail( "meister",
        "Auch die Folter ist eine Kunst.");

    AddDetail("kunst",
        "Ja. Hier lebt jemand, der der Kunst sehr zugetan ist. Auch wenn es eher eine sehr... abstrakte Kunst ist.");

    AddDetail( ({"knochen", "knochenteile"}),
        "Ueberall liegen Knochen verstreut herum. Dir scheint sogar der Altar aus Knochen zu bestehen. Vermutlich "
        "handelt es sich um die Ueberreste jener, die hier den Tod gefunden haben.");

    AddDetail( "ueberreste",
        "Du erkennst die Uberreste verschiedenster Rassen.");

    AddDetail( "rassen",
        "Allerlei Rassen aus dem Silberland. Zumindest scheint der Eigentuemer dieses Ortes keine Vorbehalte "
        "gegenueber irgendwelcher Rassen zu haben.");

    AddDetail( ({"silberland", "silberlands"}),
        "Da bist du gerade!");

    AddDetail( "eigentuemer",
        "Irgendwem muss das hier alles ja gehoeren.");

    AddDetail( "vorbehalte",
        "Wie krank auch immer das Hirn sein mag. Rassistisch ist es nicht.");

    AddDetail( "rassen",
        "Die Bewohner des Silberlands.");

    AddDetail( "altar",
        "Dir stockt regelrecht der Atem als du den Altar begutachtest. Er besteht ganz und gar aus Knochen. "
        "Neben schwarzen Kerzen erhebt sich darauf, mannshoch, eine skelettartige Statue");

    AddDetail( "atem",
        "Er ist nur noch flach und kaum merkbar. Bist du schon tot?");

    AddDetail( "kerzen",
        "Schwarze Kerzen flackern auf dem Altar.");

    AddDetail( "statue",
        "Die Statue stellt einen maechtigen Nekromanten dar, der sich hoch ueber einen Elfen erhebt. "
        "Sein Koerper ist aus Knochen verschiedener Rassen geformt und er ist in eine Robe aus blutiger "
        "Haut gekleidet. Seine Augen sind aus schwarzen Onyxen und funkeln im Kerzenschein. In der Hand "
        "haelt die Statue einen Dolch aus Onyx, mit dem sie dem Elfen gerade die Brust aufschneidet. In "
        "tropfendem Blut steht unter der Statue geschrieben: XULGSCH DER BEFREIER");

    AddDetail( "koerper",
        "Der skeletthafte Koerper des Nekromanten wurde aus Knochen gebaut. In seinem Inneren kannst du "
        "sogar Gedaerm erkennen.");

    AddDetail( ({"inneren", "inneres", "gedaerm"}),
        "Im Inneren der Statue sind tatsaechlich anatomisch korrekte Ineereien!");

    AddDetail( ({"innereein"}),
        "Richtig widerlich und noch glitschig. Ob sie noch warm sind? Vielleicht moechtest du ja darin "
        "wuehlen?");

    AddDetail( "nekromanten",
        "Wen die Statue wohl darstellen soll?");

    AddDetail( ({"elfen", "elf"}),
        "Der Elf ist in die Ruestung eiens Paladins gekleidet. Offenbar handelt es sich bei ihm nicht "
        "um irgendwen, sondern um einen hochrangigen Paladin.");

    AddDetail( ({"ruestung", "kettenhemd"}),
        "Das Kettenhemd, dass der Elf traegt wurde aus vielen einezlenen Fingerknoechelchen gemacht.");

    AddDetail( ({"knoechelchen", "fingerknoechelchen"}),
        "Irgendjemand hat sich hier abscheulich viel Muehe gegeben.");

    AddDetail( ({"muehe"}),
        "Hier hat jemand wohl viel Schweiss und Blut investiert. Woertlich genommen!");

    AddDetail( "schweiss",
        "Gut, den findest du hier nicht. Blut dafuer schon.");

    AddDetail( ({"robe"}),
        "Die Robe der Statue wurde aus waschechter und noch feucht-blutiger Haut geschneidert.");

    AddDetail( ({"haut", "menschenhaut"}),
        "Sieht aus wie Menschenhaut.");

    AddDetail( ({"augen"}),
        "Die Augen der Statue sind aus funkelnden Onyxen gemacht.");

    AddDetail( ({"onyx", "onyxe", "onyxen"}),
        "Schwarze Onyxe stehen fuer das Boese.");

    AddDetail( ({"hand", "dolch"}),
        "Die Statue haelt einen Dolch in der Hand.");

    AddDetail( ({"brust"}),
        "Die Brust des Elfen ist bereits mit einem Schnitt geoeffnet.");

    AddDetail( ({"schnitt"}),
        "Aus dem Schnitt rinnt ein duenner Faden aus Blut. Echtes Blut!");

    AddDetail( ({"faden"}),
        "Das ist echtes, frisches Blut...");

    AddDetail( ({"raum"}), QueryProp(P_INT_LONG));

//--Kommandos--------------------------------------------------------------

  AddCmd( ({ "koste", "kost" }), "cmd_kosten" );
  AddCmd( ({ "wuehle", "wuehl" }), "cmd_wuehlen" );

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "gang" );

//--Items & NPCs-----------------------------------------------------------

  AddItem( "/gilden/bardengilde/obj/ehrenstatue" , REFRESH_DESTRUCT, (["hero": "xulgsch", P_INVIS: 1]));
  AddItem( NPC "zarisa", REFRESH_DESTRUCT);
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_kosten(string str)
{
  notify_fail("Was willst Du kosten?\n");

  if (!str || str == "") return 0;
  if (str != "blut") return 0;

  tell_object(TP, BS("Du schleckst ueber das Blut an der Wand. Schmeckt metallisch. Eindeutig kein Kunstblut!"));
  Message(TP->Name(WER, 1)+" schleckt die Wand ab. Wiederlich!\n", MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-10);

  return 1;
}

int cmd_wuehlen(string str) {
    notify_fail("Worin willst du wuehlen?\n");
    if(!str || str == "") return 0;
    if(str != "in gedaerm" && str != "in innerein" && 
       str != "in eingeweide" && str != "in gedaermen") return 0;
       
    write(BS("Schmatzend wuehlst du in den Gedaermen der Statue."));
    say(BS(TPN + " wuehlt schmatzend in den Gedaermen der Statue herum."));

    return 1;
}

int cmd_brechen(string str) {
    notify_fail("Was willst du brechen?");
    if(!str || str == "") return 0;
    if(str != "siegel" && str == "siegel auf") return 0;

    write(BS("Du brichst eines der Wachssiegel auf und liest die Schriftrolle. Nur "
             "noch mehr merkwuerdige Kringel, Linien und Striche!"));
    say(BS(TPN + " liest eine der Schritfrollen."));

    return 1;
}

//--Funktionen fuer Details------------------------------------------------

string detail_heilig() {
  if(TP->QueryProp(P_ALIGN) < -50) {
    return "Du bist sicher nicht heilig.\n";
  } else if(TP->QueryProp(P_ALIGN) > 50) {
    return "Du gehoerst zum Guten!\n";
  }
  return "Du stehst irgendwo dazwischen.\n";
}
