#include "../def.h"

inherit "/p/service/angel/haustiere/std_petshop";

#include "/p/service/angel/haustiere/std_pet.h"
#include "laden.h"

#define PET_NPC "/p/service/angel/haustiere/npc/"

void Angebot()
{
  RemovePet("all");

  if(random(100) <= 90)
    AddPet("irrlicht", PET_NPC "ut_irrlicht");

  if(random(100) <= 55)
    AddPet("skelettkraehe", PET_NPC "ut_skelettkraehe");

  if(random(100) <= 50)
    AddPet("vampirratte", PET_NPC "ut_vampirratte");

  if(random(100) <= 85)
    AddPet("haendchen", PET_NPC "ut_haendchen");

  if(random(100) <= 60)
    AddPet("geist", PET_NPC "ut_geist");

  if(random(100) <= 30)
    AddPet("vampirwolf", PET_NPC "ut_vampirwolf");
}

void create()
{
  ::create();

  // Laden-Konstanten:
  SetProp(P_SHOPKEEPER_NAME, "Mittwoch");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SHOPKEEPER_ID, "\ngeisterhaus_mittwoch");

  catch(call_other(ROOM "pet_store", "???"));
  SetStorageRoom(ROOM "pet_store");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]));

  SetProp(P_INT_SHORT, "Adoptionsstelle fuer alternative Lebensformen");
  SetProp(P_INT_LONG,
	  "Du stehst in einer Art von Arbeitszimmer. Die Waende sind ueber und "
    "und ueber mit Regalen behaengt, in denen sich kleine Kaefige und "
    "leuchtende Glaeser befinden. Ein grosser, dunkler Schreibtisch steht "
    "Mitten im Raum. Auf ihm tuermen sich etliche Zettel und Plakate. Ein "
    "Totenschaedel, der ebenfalls am Schreibtisch steht, spendet Licht ueber "
    "eine Kerze, die auf ihm steckt. In einer Ecke stapeln sich einige "
    "Kisten. Eine Tafel unter der grossen Aufschrift 'Adoptionsstelle fuer "
    "alternative Lebensformen' gibt Auskunft ueber die Adoptionsmoeglichkeiten.");

  SetProp(P_PET_KONFIG_TOOL, OBJ "pet_knochen");

  AddReadDetail(({"tafel", "preistafel"}), CLOSURE(GetPriceList));
  AddDetail(({"regale", "kaefige", "glaeser"}), "Die Regale sind vollgestopft mit kleinen Kaefigen und leuchtenden Glaesern, in denen sich ungewoehnliche Wesen zu befinden scheinen.");
  AddDetail("schreibtisch", "Der grosse, dunkle Schreibtisch in der Mitte des Raums ist mit Zetteln und Plakaten bedeckt. Ein Totenschaedel mit einer Kerze spendet Licht auf dem Schreibtisch.");
  AddDetail(({"zettel", "plakate"}), "Die Zettel und Plakate auf dem Schreibtisch bieten Informationen ueber die verschiedenen Adoptionsmoeglichkeiten und merkwuerdige Wesen.");
  AddDetail("totenschaedel", "Der Totenschaedel auf dem Schreibtisch strahlt Licht von der Kerze aus und wirkt mysterioes.");
  AddDetail("kerze", "Die Kerze auf dem Totenschaedel spendet gedaempftes Licht und erzeugt eine geheimnisvolle Atmosphaere.");
  AddDetail("kisten", "In der Ecke des Raums stapeln sich einige Kisten, deren Inhalt verborgen bleibt.");
  AddDetail("tafel", "Die Tafel unter der grossen Aufschrift 'Adoptionsstelle fuer alternative Lebensformen' bietet Informationen ueber die verfuegbaren Adoptionsmoeglichkeiten.");
  AddDetail("arbeitszimmer", "Dies ist offensichtlich ein Arbeitszimmer, das fuer die Adoptionsstelle fuer alternative Lebensformen genutzt wird.");
  AddDetail("alternative lebensformen", "Die Adoptionsstelle konzentriert sich auf die Vermittlung von ungewoehnlichen Wesen und Lebensformen.");
  AddDetail("mittwoch", "Mittwoch ist die Inhaberin dieser Adoptionsstelle und scheint in geheimnisvolle Geschaefte verwickelt zu sein.");
  AddDetail("adoptionsstelle", "Dies ist die zentrale Adoptionsstelle fuer alternative Wesen und Lebensformen. Hier koennen diese Wesen eine neue Heimat finden und eine Chance auf ein besseres Leben erhalten.");
  AddDetail(({"adoptionsmoeglichkeiten", "moeglichkeiten", "moeglichkeit"}), "Die Adoptionsmoeglichkeiten werden auf Plakaten und einer Tafel ausfuehrlich dargestellt. Hier erfaehrst du, wie du ungewoehnliche Wesen adoptieren und fuer sie sorgen kannst.");
  AddDetail("art", "Die Art der Wesen, die hier adoptiert werden koennen, ist aeusserst vielfaeltig und reicht von magischen Kreaturen bis hin zu exotischen Geschoepfen.");
  AddDetail("aufschrift", "Die Aufschrift 'Adoptionsstelle fuer alternative Lebensformen' ist deutlich auf der Tafel neben der Wand angebracht. Sie weist auf den Zweck dieses Raumes hin.");
  AddDetail("auskunft", "Die Tafel neben der Wand gibt ausfuehrliche Auskunft ueber die verschiedenen Adoptionsmoeglichkeiten, Gebuehren und Anforderungen.");
  AddDetail("boden", "Der Boden dieses Raumes ist schlicht und unauffaellig, bedeckt mit einem einfachen Holzfussboden.");
  AddDetail("decke", "Die Decke ist hoch und unauffaellig, sie verstaerkt die geheimnisvolle Atmosphaere dieses Raumes.");
  AddDetail("ecke", "In einer Ecke des Raumes befinden sich stapelweise Kisten, die den Inhalt verborgen halten. Es scheint, als wuerden hier weitere Geheimnisse lauern.");
  AddDetail("wesen", "Die Regale sind voll mit kleinen Kaefigen und leuchtenden Glaesern, in denen merkwuerdige Wesen zu finden sind. Sie blicken dich neugierig an.");
  AddDetail("atmosphaere", "Die Atmosphaere dieses Raumes ist geheimnisvoll und erwartungsvoll. Das gedaempfte Licht und die ungewoehnlichen Wesen tragen dazu bei.");
  AddDetail("inhalt", "Der Inhalt der Kisten in der Ecke bleibt verborgen und wirft Raetsel auf. Es koennte sich um weitere ungewoehnliche Wesen oder Artefakte handeln.");
  AddDetail("lebensformen", "Die Adoptionsstelle konzentriert sich auf die Vermittlung von ungewoehnlichen Lebensformen, die anderswo vielleicht keine Heimat finden wuerden.");
  AddDetail("licht", "Das Licht wird von einer einzelnen Kerze auf einem Totenschaedel gespendet, was eine geheimnisvolle Stimmung im Raum erzeugt.");
  AddDetail("mitten", "Der grosse, dunkle Schreibtisch steht mitten im Raum und ist mit einer Vielzahl von Zetteln und Plakaten bedeckt. Hier scheint die zentrale Informationsquelle zu sein.");
  AddDetail("informationen", "Die Informationen ueber die Adoptionsmoeglichkeiten sind auf den zahlreichen Zetteln und Plakaten zu finden, die den Schreibtisch bedecken.");
  AddDetail("raum", "Dieser Raum ist als Arbeitszimmer fuer die Adoptionsstelle eingerichtet und wirkt voller geheimnisvoller Wesen und Moeglichkeiten.");
  AddDetail("waende", "Die Waende sind mit Regalen behaengt, auf denen sich Kaefige und Glaeser mit ungewoehnlichen Wesen befinden. Hier scheint die Hauptausstellungsflaeche zu sein.");
  AddDetail("wand", "Die Wand neben der Tafel traegt die Aufschrift 'Adoptionsstelle fuer alternative Lebensformen', die die Bedeutung dieses Raumes verdeutlicht.");
  AddDetail("chance", "In diesem Raum haben merkwuerdige Wesen und Kreaturen die Chance auf ein neues, besseres Leben und eine liebevolle Heimat.");
  AddDetail("heimat", "Die Adoptionsstelle bietet ungewoehnlichen Wesen die Moeglichkeit, eine neue Heimat zu finden und ein erfuelltes Leben zu fuehren.");
  AddDetail("leben", "Hier koennen ungewoehnliche Lebensformen ein neues Leben beginnen und ihre Existenz in der Welt geniessen.");
  AddDetail("geschoepfen", "Die Regale beherbergen eine Vielzahl von Geschoepfen und Kreaturen, die darauf warten, adoptiert zu werden.");
  AddDetail("kreaturen", "Die Kreaturen auf den Regalen reichen von magischen Geschoepfen bis zu exotischen Wesen.");
  AddDetail("zweck", "Der Zweck dieses Raumes ist es, ungewoehnlichen Wesen eine Chance zu geben, ein glueckliches Leben zu fuehren.");
  AddDetail("anforderungen", "Die Tafel gibt Informationen ueber die Anforderungen, die fuer die Adoption ungewoehnlicher Wesen erforderlich sind.");
  AddDetail("gebuehren", "Die Tafel gibt auch Auskunft ueber die Gebuehren, die mit der Adoption verbunden sind.");
  AddDetail("holzfussboden", "Der Holzfussboden dieses Raumes ist schlicht und stabil.");
  AddDetail("geheimnisse", "Die Kisten in der Ecke bergen vielleicht Geheimnisse und Ueberraschungen, die darauf warten, entdeckt zu werden.");
  AddDetail("artefakte", "Es koennte sein, dass in den Kisten seltene Artefakte oder besondere Gegenstaende versteckt sind.");
  AddDetail("raetsel", "Die Inhalte der Kisten koennten Raetsel oder ungeloeste Fragen aufwerfen, die neugierige Besucher herausfordern.");
  AddDetail("vermutung", "Es bleibt der Raum fuer Vermutungen und Spekulationen ueber die verborgenen Schaetze und Geheimnisse.");
  AddDetail("stimmung", "Die Stimmung in diesem Raum ist geheimnisvoll und erwartungsvoll, perfekt fuer die Entdeckung ungewoehnlicher Wesen.");
  AddDetail("informationsquelle", "Der grosse Schreibtisch in der Mitte des Raumes dient als Informationsquelle fuer alles, was mit der Adoption von Wesen zu tun hat.");
  AddDetail("vielzahl", "Eine Vielzahl von Informationen und Moeglichkeiten sind auf den zahlreichen Plakaten und Zetteln verfuegbar.");
  AddDetail("moeglichkeiten", "Hier gibt es unzaehlige Moeglichkeiten, ungewoehnliche Wesen zu adoptieren und fuer sie zu sorgen.");
  AddDetail("hauptausstellungsflaeche", "Die Regale in diesem Raum dienen als Hauptausstellungsflaeche fuer die vielfaeltigen Lebensformen und Kreaturen.");
  AddDetail(({"bedeutung", "funktion"}), "Die Aufschrift 'Adoptionsstelle fuer alternative Lebensformen' traegt zur Bedeutung dieses Raumes bei und weist auf seine wichtige Funktion hin.");
  AddDetail("existenz", "Dieser Raum bietet ungewoehnlichen Wesen die Moeglichkeit, ihre Existenz in der Welt zu finden und ein erfuelltes Leben zu fuehren.");
  AddDetail("welt", "In dieser Adoptionsstelle koennen ungewoehnliche Wesen eine neue Welt und eine liebevolle Heimat finden.");
  AddDetail("adoption", "Die Adoptionsstelle ermoeglicht es, ungewoehnliche Wesen zu adoptieren und fuer sie zu sorgen.");
  AddDetail("ueberraschungen", "Die Kisten in der Ecke koennten Ueberraschungen und Geheimnisse enthalten, die darauf warten, entdeckt zu werden.");
  AddDetail("gegenstaende", "Es koennte sein, dass in den Kisten seltene Gegenstaende oder besondere Artefakte versteckt sind.");
  AddDetail("besucher", "Besucher haben die Gelegenheit, Fragen zu stellen und seltsame Wesen zu entdecken.");
  AddDetail("fragen", "Besucher koennen Fragen ueber die Adoption und die verfuegbaren Wesen stellen.");
  AddDetail("vermittlung", "Die Adoptionsstelle dient der Vermittlung von ungewoehnlichen Wesen an liebevolle Familien und Personen.");
  AddDetail("entdeckung", "Besucher koennen hier die Entdeckung ungewoehnlicher Wesen und Lebensformen erleben.");
  AddDetail("mitte", "Der grosse, dunkle Schreibtisch steht in der Mitte des Raumes und ist das Herzstueck dieser Adoptionsstelle.");
  AddDetail("familien", "Diese Adoptionsstelle vermittelt alternativlebende Wesen an liebevolle Familien, die bereit sind, ihnen eine Heimat zu bieten.");
  AddDetail(({"personen", "einzelpersonen"}), "Auch Einzelpersonen haben hier die Moeglichkeit, die ungewoehnlichen Wesen zu adoptieren und für sie zu sorgen.");
  AddDetail("herzstueck", "Der große, dunkle Schreibtisch in der Mitte des Raumes ist das Herzstueck dieser Adoptionsstelle und der zentrale Ort für alle Informationen und Angelegenheiten rund um die Adoption von Wesen.");
  
  
  Angebot();

  AddItem(NPC "mittwoch", REFRESH_DESTRUCT);

  RemoveItem("/obj/entsorg");

  AddExit("norden", ROOM "halle");

  AddCmd( ({"waehle", "waehl"}), "cmd_waehlen");
}

public int cmd_waehlen(string str) {
  if(!TP->QueryQuest(QUESTNAME)) {
    write(BS("Mittwoch vergibt Untote nur an Leute, die den Beweis erbracht haben, "
             "dass sie sich wirklich um den Erhalt von alternativem Leben engagieren!"));
    return -1;
  }
  return ::BuyPet(str);
}

void reset()
{
  ::reset();

  call_out("Angebot", 10+random(10));
}

int sell(string str, int f)
{
  if(present("mittwoch"))
    return write(BS("Mittwoch sagt: Tut mir leid, aber ich kaufe nichts "
		    "an!")), 1;

  return ::sell(str, f);
}
