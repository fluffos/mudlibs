    AddDetail("kreationen",
        "Hier kannst du deine eigenen kulinarischen Kreationen zubereiten.");
    
    AddDetail("leckeres",
        "In dieser Kueche kannst du sicherlich etwas Leckeres zubereiten.");
    
    AddDetail( ({"utensilien", "kuechenutensilien"}),
        "Die Regale sind voller nuetzlicher Kuechenutensilien.");
    
    AddDetail(({"bedarf", "beduerfnisse"}),
        "Die Kueche ist gut ausgestattet, um alle deine kulinarischen Beduerfnisse zu erfuellen.");
    
    AddDetail("einsatz",
        "Die Kuechenmesser stehen bereit und warten auf ihren Einsatz in der Zubereitung von Mahlzeiten.");
    
    AddDetail(({"mahlzeiten", "gerichten", "gerichte"}),
        "In dieser Kueche kannst du leckere Mahlzeiten zubereiten.");
    
    AddDetail("ort",
        "Dies ist der perfekte Ort, um deine kulinarischen Kreationen zu zaubern.");
    
    AddDetail( ({"zubereiten", "zubereitung"}),
        "Du kannst hier verschiedene Zutaten zu koestlichen Gerichten zubereiten.");
    
    
    
//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ROOM "halle" );

//--Items & NPCs-----------------------------------------------------------
  AddItem( NPC "igor", REFRESH_DESTRUCT );

  AddCmd( ({"fuell", "fuelle", "gib", "gebe", "geb", "lege", "leg"}), "cmd_fuellen");
  AddCmd( ({"schuettel", "schuettle"}), "cmd_schuetteln");
}

public int cmd_fuellen(string str) {
  string was, wo, rest;
  object ob;

  notify_fail("Was wilst du wo hineinfuellen?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s in %s", was, wo) != 2) return 0;

  if(member(({"ananas", "kokosnuss", "rum", "milch"}), was) < 0) {
    notify_fail("DAS gehoert da sicher nicht rein.\n");
    return 0;
  }

  if(member(({"mixer", "shaker", "cocktailmixer", "cocktailshaker", "mischer", "zaubertrankmsicher", "zaubertrankmixer"}), wo) < 0) {
    notify_fail("WO willst du das reinfuellen?\n");
    return 0;
  }

  if(!objectp(ob=present(was, TP))) {
    write("Aber das hast du doch gar nicht bei dir!\n");
    return -1;
  }

  switch(was) {
    case "ananas": ananas = 1; break;
    case "kokosnuss": kokosnuss = 1; break;
    case "milch": milch = 1; break;
    case "rum": rum = 1; break;
    default:
      write("Das laesst sich sicher nicht gut mischen.\n");
      return -1;
      break;
  }

  write(sprintf("Du fuellst %s in den Zaubertrankmischer.\n", ob->name(WEN, 1)));
  say(sprintf("%s fuellt %s in den Zaubertrankmischer.\n", TP->Name(WER), ob->name(WEN, 1)));
  ob->remove(1);
  return 1;
}

public int cmd_schuetteln(string str) {
  object ob;
  int r;
  notify_fail("Was willst du schuetteln?\n");
  if(member(({"mixer", "shaker", "cocktailmixer", "cocktailshaker", "mischer", "zaubertrankmsicher", "zaubertrankmixer"}), str) < 0) return 0;

  if(!ananas || !milch || !kokosnuss || !rum) {
    write("Hm. Da fehlt noch was.\n");
    return -1;
  }

  write(BS("Du schuettelst den Zaubertrankmischer mit allen Zutaten ordentlich durch und fuellst "
           "das cremige, aber alkoholhaltige Resultat in ein Glas."));
  say(BS(TPN+" schuettelt  den Zaubertrankmischer mit allen Zutaten ordentlich durch und fuellt "
         "das cremige, aber alkoholhaltige Resultat in ein Glas."));

  ob = clone_object(OBJ "pinacolada");
  r = ob->move(TP, M_GET);
  if(r == 1) return 1;

  if(r == ME_TOO_HEAVY || r == ME_TOO_MUCH) {
    write("Leider kannst du das Glas nicht mehr tragen. Draum stellst du es ab.\n");
    ob->move(TO, M_NOCHECK);
  } else {
    write("Hoppla! Wegen eines Fehlers faellt dir das Glas runter.\n");
    ob->remove(1);
  }

  return 1;
}

public void reset() {
  ::reset();
  if(time() - lastPinaColada > 10800) { // 3 Stunden
    milch = ananas = kokosnuss = rum = 0;
  }
}
