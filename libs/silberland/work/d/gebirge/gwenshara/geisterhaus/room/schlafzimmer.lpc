#include "../def.h"

inherit "std/room";

public void create()
{
    ::create();

    SetProp(P_INT_SHORT, "Mittwochs Schlafzimmer");
    SetProp(P_INT_LONG,
        "Du betrittst Mittwochs Schlafzimmer, das sich in dunklen, morbiden Farbtoenen praesentiert. "
        "Die Waende sind mit duesteren Gemaelden geschmueckt, auf denen morbide Szenen und Untote "
        "dargestellt sind. Das Bett ist ein schmiedeeisernes Himmelbett mit verzierten Gitterstaeben. "
        "Eine Kerze auf dem Nachttisch spendet ein schummriges Licht. Es herrscht eine unheimliche "
        "Atmosphaere in diesem Raum.");

    SetProp(P_LIGHT, 1);
    SetProp(P_INDOORS, 1);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]));

    AddDetail("atmosphaere", "Die Atmosphaere in diesem Raum ist duester und morbide.");
    AddDetail("bett", "Das Bett ist ein schmiedeeisernes Himmelbett mit verzierten Gitterstaeben.");
    AddDetail("boden", "Der Boden ist mit einem alten Teppich bedeckt.");
    AddDetail("decke", "Die Decke ist mit dunklen Stoffen verhangen.");
    AddDetail("farbtoenen", "Die Farbtoene in diesem Raum sind dunkel und morbide.");
    AddDetail("gemaelden", "Die Gemaelde an den Waenden zeigen morbide Szenen und Untote in duesteren Farben.");
    AddDetail("gitterstaeben", "Die Gitterstaebe am Himmelbett sind kunstvoll verziert.");
    AddDetail("himmelbett", "Das Himmelbett ist ein schmiedeeisernes Bett mit einem kunstvoll verzierten Gestell.");
    AddDetail("kerze", "Die Kerze auf dem Nachttisch spendet ein schummriges Licht.");
    AddDetail("licht", "Das Licht im Raum ist gedaempft und schummrig.");
    AddDetail("nachttisch", "Auf dem Nachttisch steht eine Kerze und einige mysterioese Gegenstaende.");
    AddDetail("raum", "Das Schlafzimmer ist duester und von einer gespenstischen Stimmung durchzogen.");
    AddDetail("schlafzimmer", "Du befindest dich im Schlafzimmer von Mittwoch. Es ist ein duesterer Raum mit morbiden Details und einer gespenstischen Atmosphaere.");
    AddDetail("szenen", "Die Gemaelde an den Waenden zeigen morbide Szenen und Untote in duesteren Farben.");
    AddDetail("untote", "Die Gemaelde an den Waenden zeigen duestere Darstellungen von Untoten, die dem Raum eine unheimliche Aura verleihen.");
    AddDetail("waende", "Die Waende sind mit gruen-gelber Tapete mit einem verwirrenden Muster bedeckt.");
    AddDetail("wand", "An einer Wand befindet sich ein grosser Spiegel, der das Zimmer noch geheimnisvoller wirken laesst.");
    AddDetail("teppich", "Der Teppich ist schwarz, mit langen Haaren und sehr weich. Er verschwindet in der Dunkelheit unter dem Bett.");
    AddDetail("dunkelheit", "Die Dunkelheit unter dem Bett koennte alle moeglichen Geheimnisse verbergen.");
    AddDetail("geheimnisse", "Du koenntest versuchen diese Geheimnisse zu lueften. Vielleicht ist ja unter dem Bett ein Geheimversteck?");
    AddDetail("geheimversteck", "Wenn du dich traust, koenntest du einfach mal unter das Bett fassen...");
    AddDetail("aura", "Die Aura in diesem Zimmer ist duester und unheimlich.");
    AddDetail("darstellungen", "Die Darstellungen auf den Gemaelden sind duester und morbide.");
    AddDetail("details", "Die Details in diesem Raum sind gruselig und unheimlich.");
    AddDetail("farben", "Die Farben in diesem Raum sind dunkel und duester.");
    AddDetail("farbtoene", "Die Farbtoene in diesem Raum sind dunkel und morbide.");
    AddDetail("gegenstaende", "Auf dem Nachttisch liegen einige mysterioese Gegenstaende.");
    AddDetail("gemaelde", "Die Gemaelde an den Waenden zeigen morbide Szenen und Untote in duesteren Farben.");
    AddDetail("gestell", "Das Gestell des Himmelbetts ist kunstvoll verziert.");
    AddDetail("gitterstaebe", "Die Gitterstaebe am Himmelbett sind kunstvoll verziert.");
    AddDetail("mittwoch", "Mittwoch ist die Bewohnerin dieses unheimlichen Zimmers.");
    AddDetail("muster", "Das Muster auf der Tapete ist verwirrend und unheimlich.");
    AddDetail("spiegel", "Der grosse Spiegel an der Wand verleiht dem Zimmer eine geheimnisvolle Atmosphaere.");
    AddDetail("stimmung", "Die Stimmung in diesem Raum ist gespenstisch und unheimlich.");
    AddDetail(({"stoffen", "stoffe"}), "Die Stoffe an der Decke und am Himmelbett sind dunkel und duester.");
    AddDetail("tapete", "Die Tapete an den Waenden hat ein verwirrendes Muster.");
    AddDetail("zimmer", "Das Zimmer hat eine gruselige Atmosphaere und ist mit morbiden Details geschmueckt.");
    AddDetail(({"haare", "haaren"}), "Die langen Haare des Teppichs sind unglaublich flauschig. Da will man sich richtig anschmiegen.");



    AddExit("westen", ROOM "gang");

    AddCmd("fass|fasse&unter&bett|himmelbett", "cmd_fassen", "Wohin willst du fassen?\n");
}

public int cmd_fassen(string str) {
    object ob;
    
    write(BS("Du fasst allen Mut zusammen und greifst beherzt unter das Bett. Nach einem Moment des Tastens holst du "
             "eine alte Schachtel darunter hervor. Darin findest du eine alte Puppe, das abgegriffene Foto eines "
             "blonden Maedchens, das mit Herzchen umrahmt ist und ein paar rosa Plueschhandschellen."));
    say(BS(TPN+" kriecht halb unters Bett."));

    if(objectp(ob=present(QUESTOB_ID, TP))) {
        write(BS("Ausserdem entdeckst du eine Flasche Balsamieroel. Warum das da drin ist willst du nicht so genau wissen."));
        
        if(ob->QueryOel() || objectp(present(QUEST_OEL_ID, TP)) || objectp(present(QUEST_OEL_ID, TO))) {
            write(BS("Da du bereits so ein Oel hast, laesst du es in der Schachtel."));
        } else {
            ob = clone_object(OBJ "balsamieroel");
            if(ob->move(TP, M_GET) != 1) {
              write(BS("Leider kannst du es gerade nicht tragen und laesst es liegen."));
              ob->remove(1);
            } else {
                write(BS("Schnell steckst du das gesuchte Balsamieroel ein."));
            }
        }
    }

    write(BS("Peinlich beruehrt schiebst du die Schachtel wieder zurueck. Etwas Privatsphaere darf schon noch sein..."));
    return 1;
}
