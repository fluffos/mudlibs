public void create() {
  ::create();

//--Beschreibungen---------------------------------------------------------

    SetProp(P_INT_SHORT, "In der Praxis von Doktor Frank N. Stein");
    SetProp(P_INT_LONG,
        "Dieses Zimmer hier ueberrascht dich ziemlich. Du stehst mitten in "
        "einer Arztpraxis. An einem grossen Eichentisch kann der Doktor "
        "seine Patienten in Empfang nehmen. Rechter Hand findest du eine "
        "Liege, die sich auf alle moeglichen Arten verstellen laesst. "
        "Davor liegen einige Instrumente, die so aussehen als waeren sie "
        "dazu gedacht jemanden zu foltern, auf einem Tischchen. Eine "
        "sonderbare Maschine steht in der linken hinteren Ecke. Die Waende "
        "sind voll mit Plakaten, Bildern und Diplomen. Alles wirkt so, "
        "als wuerde sich der Doktor bemuehen hier einen sauberen Eindruck "
        "zu hinterlassen aber Kleinigkeiten lassen dich daran zweifeln.");

