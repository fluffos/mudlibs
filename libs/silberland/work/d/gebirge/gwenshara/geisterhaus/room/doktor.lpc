public int cmd_oeffnen(string str) {
  notify_fail("Was moechtest du oeffnen?\n");
  if(!str || str == "") return 0;
  if(str != "schrank" && str != "schloss") return 0;

  write(BS("Du ruettelst am Schrank, doch er ist fest verschlossen."));
  say(BS(TPN+" ruettelt am Schrank."));
  return 1;
}

public int cmd_blaettern(string str) {
  notify_fail("Worin willst du blaettern?\n");

  if(str == "rote akte" || str == "rote patientenakte" || str == "in roter akte" || str == "in roter patientenakte" ||
     str == "durch rote akte" || str == "durch rote patientenakte") {
      write(BS("Du blaetterst durch die Akte und stellst fest, dass der Patient mit dem Pseudonym D. Ante wohl "
               "an fortgeschrittenem Zombiefieber erkrankt ist und sein Gehirn schon nur mehr eine schleimige "
               "Masse von Stumpfsinn sein soll. Echt ekelhaft."));
      return 1;
  } else if(str == "blaue akte" || str == "blaue patientenakte" || str == "in blauer akte" || str == "in blauer patientenakte" ||
            str == "durch blaue akte" || str == "durch blaue patientenakte" || str == "in memo" ||str == "durch memo") {
      write(BS("Es handelt sich um ein Memo zum Thema Datensicherheit der Aerztekammer. Fett unterstrichen ist der Satz: "
               "Bewahren sie Zugangscodes, Passwoerter u.ae. niemals an offensichtlichen Orten, wie der Unterseite ihrer "
               "Schreibtischschreibunterlage auf!"));
      return 1;
  } else if(str == "gruene akte" || str == "gruene patientenakte" || str == "in gruener akte" || str == "in gruener patientenakte" ||
            str == "durch gruene akte" || str == "durch gruene patientenakte") {
      write(BS("Der Patient 'A. N. Grox', offenbar ein Pseudonym, ist offenbar ein wichtiger Magier. Er hat sich wohl "
               "waehrend den Arbeiten an der Nekromantengilde am kleinen Zeh verletzt. Nicht sehr interessant."));
      return 1;
  }

  return 0;
}

public int cmd_lesen(string str) {
  notify_fail("Was willst du lesen?\n");
  if(str == "diplom" || str == "diplome") {
    write(BS(sprintf("Es handelt sich um verschiedene Diplome, auf denen gross der Name des "
          "Doktors prangt und die zeigen, dass er sich viel fortgebildet hat.")));
    return 1;
  } else if(str == "name" || str == "name des doktors") {
    write(BS("In grossen goldenen Lettern steht da:"));
    write(sprintf("    Frank %s Stein\n",names[strlen(TP->QueryProp(P_NAME))%sizeof(names)]));
    return 1;
  }

  return 0;
}

public int cmd_schloss(string str) {
  int zahl;
  string was;
  object ob;

  notify_fail("Worauf willst du das Schloss stellen?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s auf %d", was, zahl) != 2) return 0;
  if(was != "schloss" && was != "zahlenschloss") {
    write(BS("Du kannst hier nur das Zahlenschloss stellen!"));
    return -1;
  }

  if(zahl != strlen(names[strlen(TP->QueryProp(P_NAME))%sizeof(names)])*100 + 
             animalsSolution[strlen(TP->QueryProp(P_NAME))%sizeof(animalsSolution)]*10 +
             familySolution[strlen(TP->QueryProp(P_NAME))%sizeof(familySolution)]) {
      write(BS("Du stellst die Zahl ein, doch nichts passiert."));
      return -1;
  }

  write(BS("Mit einem Klicken springt das Schloss auf."));
  if(!objectp(ob=present(QUESTOB_ID, TP))) {
    write(BS("Leider ist der Schrank leer."));
    return 1;
  }

  if(ob->QuerySaege() || objectp(present(QUEST_SAEGE_ID, TP)) || objectp(present(QUEST_SAEGE_ID, TO))) {
    write(BS("Im Schrank findest du eine Knochensaege. Da du bereits eine Knochensaege hast, laesst du sie liegen."));
    return 1;
  }

  ob = clone_object(OBJ "knochensaege");
  if(ob->move(TP, M_GET) != 1) {
    write(BS("Im Schrank fundest du eine Knochensaege. Leider kannst du sie gerade nicht tragen und laesst sie liegen."));
    ob->remove(1);
    return 1;
  }

  write(BS("Im Schank findest du eine Knochensaege, die du sofort einsteckst."));
  return 1;
}

public int *combinationForPlayer(object ob) {
  return ({strlen(names[strlen(ob->QueryProp(P_NAME))%sizeof(names)]),  
           animalsSolution[strlen(ob->QueryProp(P_NAME))%sizeof(animalsSolution)],
           familySolution[strlen(ob->QueryProp(P_NAME))%sizeof(familySolution)]});
}

public string *getNames() {
  return names;
}

public int cmd_drehen(string str) {
  notify_fail("Was willst du umdrehen?\n");
  if(str != "unterlage um" && str != "schreibunterlage um") return 0;

  write(BS("Du drehst die Schreibunterlage um und findest darunter einen Zettel angeklebt auf dem steht:"));
  write(BS("1. Frank ????? Stein"));
  write(BS(sprintf("2. %s im Kaminzimmer", animals[strlen(TP->QueryProp(P_NAME))%sizeof(animals)])));
  write(BS(sprintf("3. Mittwochs %s", family[strlen(TP->QueryProp(P_NAME))%sizeof(family)])));

  return 1;
}

public int cmd_entladen(string str) {
  object helm;

  notify_fail("Was willst woran entladen?\n");
  if(str != "helm an maschine" && str != "lederhelm an maschine" &&
     str != "energie an maschine" && str != "flaeschchen an maschine" && 
     str != "glasflaeschchen an maschine") return 0;

  if(!objectp(helm=present(QUESTOB_ID_HELM, TP))) {
    write(BS("Du hast keinen Helm bei dir?"));
    return -1;
  }

  if(!helm->IsFull()) {
    write(BS("Der Helm ist noch nicht fertig aufgeladen!"));
    return -1;
  }

  if(!objectp(present("\ngeisterhaus_doktor"))) {
    write(BS("Der Doktor ist gerade nicht da. Warte besser auf ihn!"));
    return -1;
  }

  write(BS("Du haengst den Helm an die Kupferdraehte der Maschine."));
  say(BS(TPN+" haengt den einen Helm an die Kupferdraehte der Maschine."));

  helm->remove(1);

  TP->SetProp(P_PARALYZED, 300);
  call_out("resurrect_sequence", 0, 0, TP);
  return 1;
}

public void resurrect_sequence(int step, object pl) {
  int r;
  object ob;

  if(step > 6) {
    TP->SetProp(P_PARALYZED, 0);
    r=pl->GiveQuest(QUESTNAME);
    if(r != 1) {
      tell_object(pl, BS("!! FEHLER: " + r + "\n"));
      return;
    }

    tell_object(pl, break_string("Ohje! Es scheint, dass der Verstand meines Patienten nicht gut transferiert "
                                 "wurde. Ich brauche wohl noch weitere Experimente. Viel Freude mit deinem persoenlichen Igor!", 78,
                                 "Doktor Frank N. Stein sagt: ") );
    ob = clone_object(NPC "hilfsigor");
    ob->create_default_npc(pl->QueryProp(P_LEVEL)/2>28?28:pl->QueryProp(P_LEVEL)/2);
    ob->SetMaster(pl);
    ob->follow_me(pl);
    ob->help_me(pl);
    if(ob->move(TO, M_NOCHECK) != 1) {
      ob->remove(1);
    }
    return;
  }

  switch(step) {
    case 0: 
      tell_object(pl, BS("Mit Blitzen, Zischen und Fauchen springt gruenliche Energie von dem Helm auf die Maschine ueber."));
      tell_object(pl, BS("Eine kleine Glasflasche an der Maschine beginnnt sich mit gruenlicher Fluessigkeit zu fuellen."));
      break;
    case 1:
      tell_object(pl, BS("Schnell macht sich der Dokotor daran den aus verschiedenen Teilen zusammen genaehten Koerper an "
                         "das Wirrwarr aus Kabeln und Draehten zu haengen."));
      break;
    case 2:
      tell_object(pl, BS("Nun holt er eine vekorkte Flasche aus seinem Mantel und steckt sie an den Fuellstutzen."));
      break;
    case 3:
      tell_object(pl, BS("Mit schaurigem Heulen und einem lauten *PFLOMP* wird weisser Geisternebel aus der Flasche in die "
                         "Maschine gesaugt, die sofort zu rattern beginnt."));
      break;
    case 4:
      tell_object(pl, BS("Blitze zucken knisternd ueber die Draehte in den den toten Koerper."));
      break;
    case 5:
      tell_object(pl, BS("Mit einem Ruck erhebt sich der Koerper!"));
      break;
    case 6:
      tell_object(pl, BS("Dumpf stoehnende steht der neugeborene Igor auf und schaut dumpf drein."));
      domainshout("Doktor Frank N. Stein ruft: ES LEEEEEEBT! ES LEEEEBT!\n", "/d/gebirge/*", 1);
      tell_object(pl, BS("Doktor Frank N. Stein ruft: ES LEEEEEEBT! ES LEEEEBT!"));
      break;
  }

  call_out("resurrect_sequence", 4, ++step, pl);
}
