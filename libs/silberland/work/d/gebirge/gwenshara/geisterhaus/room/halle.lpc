#include "../def.h"

inherit "/std/room";

void create() {
    ::create();
    SetProp(P_INT_SHORT, "Eingangshalle der Villa");
    SetProp(P_INT_LONG, "Nun stehst du in der Eingangshalle der Villa. Auch hier ist alles von Verfall gepraegt. Ein ehemals roter, jetzt aber ausgeblichener Teppich bedeckt den Fliesenboden. Eine breite Treppe aus Marmor fuehrt nach oben ins Obergeschoss. Von der Decke haengt ein schwerer, grosser Kerzenleuchter aus Messing herab. Die Waende sind mit allerlei antiken Bildern behaengt und zwei grosse Mahagonitueren fuehren in weitere Raeume.");
    
    AddDetail(({"eingangshalle", "raum", "halle"}), "Du befindest dich in der Eingangshalle der Villa, die von Verfall und Vernachlaessigung gezeichnet ist.");
    AddDetail("teppich", "Der Teppich ist ausgeblichen und zeigt deutliche Abnutzungsspuren. Frueher mag er rot gewesen sein, aber jetzt sind nur noch verblasste Reste dieser Farbe zu erkennen. Loecher zieren seine Oberflaeche, und er hat viel von seinem einstigen Glanz verloren.");
    AddDetail("farbe", "Die einst leuchtend rote Farbe des Teppichs ist jetzt verblasst und kaum noch erkennbar.");
    AddDetail(({"treppe", "marmortreppe"}), "Die Marmortreppe, die ins Obergeschoss fuehrt, ist staubig und ungepflegt. Frueher mag sie poliert gewesen sein, doch nun sind deutliche Spuren der Zeit sichtbar. Die Stufen bestehen aus grossen Marmorplatten, und die Handlaeufe aus Messing sind stumpf und verkratzt. Die Treppe wirkt zudem instabil, und es gibt lose Stufen.");
    AddDetail("kerzenleuchter", "Der massive Messing-Kerzenleuchter haengt schief von der Decke und ist von Staub bedeckt. Einst praechtig verziert und vergoldet, sind jetzt nur noch abgeblaetterte und verkratzte Reste seiner einstigen Pracht zu sehen.");
    AddDetail("waende", "Die Waende sind mit antiken Bildern behaengt, die einst wertvoll waren. Doch die Zeit und Feuchtigkeit haben ihre Spuren hinterlassen. Viele der Bilder sind verblasst und zeigen Anzeichen von Schaeden. Landschaften und Portraets laengst vergessener Personen dominieren die Sammlung, aber einige wenige sind immer noch beeindruckend und unbeschaedigt.");
    AddDetail(({"tueren", "mahagonitueren"}), "Die massiven Mahagonitueren sind von Alter und Verfall gezeichnet, aber sie zeugen auch von frueherer Pracht und Eleganz.");
    AddDetail("bilder", "Die antiken Bilder an den Waenden erzaehlen von vergangener Schoenheit und Kunstfertigkeit, sind aber jetzt von Feuchtigkeit und Verfall gezeichnet. Einige zeigen beeindruckende Landschaften, andere Portraets laengst vergessener Personen.");
    AddDetail(({"wasser", "feuchtigkeit"}), "Feuchtigkeit hat sich in die Waende eingeschlichen und hinterliess Flecken, Schimmel und Risse. Die Farben der Bilder sind verblasst, und der Raum riecht modrig und vernachlaessigt.");
    AddDetail("flecken", "Zahlreiche Flecken zieren den Raum, einige gross und dunkel, andere klein und hell. Sie stammen vermutlich von Wasser oder Feuchtigkeit und beeintraechtigen die Farben der Waende und Bilder. Einige dieser Flecken sind bereits von Schimmel befallen.");
    AddDetail(({"gefuehl", "beduerfnis"}), "In diesem Raum herrscht ein unangenehmes Gefuehl von Verfall und Vernachlaessigung. Die Kaelte und Feuchtigkeit verstaerken den Eindruck, dass hier seit langem niemand mehr fuer die Instandhaltung gesorgt hat. Es draengt einen foermlich, diesen Ort schnell zu verlassen.");
    AddSmell("geruch", "Ein unangenehmer Geruch von Staub und Verfall liegt in der Luft und konzentriert sich besonders in der Naehe des Teppichs und der Waende, verstaerkt das Gefuehl von Vernachlaessigung.");
    AddDetail("risse", "Risse in den Waenden, verursacht durch Alter und Feuchtigkeit, sind unregelmaessig und weisen auf mangelnde Instandhaltung hin. Einige Putzstellen sind abgebrochen, und es scheint, dass seit Jahren keine Reparaturen durchgefuehrt wurden.");
    AddDetail("alter", "Das Alter der Villa ist allgegenwaertig spuerbar. Alles ist abgenutzt und verwittert, die Waende und der Boden zeigen deutliche Anzeichen von Feuchtigkeit und zeitbedingten Schaeden. Offensichtlich wurde die Villa seit vielen Jahren vernachlaessigt.");
    AddDetail("anzeichen", "Ueberall in der Villa sind Anzeichen von Alter und Verfall sichtbar. Feuchtigkeit hat die Waende beschaedigt, der Teppich ist abgenutzt, und selbst die Tueren tragen Gebrauchsspuren. Es ist offensichtlich, dass seit langer Zeit keine Instandhaltung mehr stattgefunden hat, und die Spuren der Vernachlaessigung sind ueberall erkennbar.");
    AddDetail("gebrauchsspuren", "Gebrauchsspuren sind an vielen Gegenstaenden in der Eingangshalle sichtbar. Die Marmortreppe zeigt Abnutzungsspuren von vielen Jahren des Betretens, der Teppich ist von jahrelanger Benutzung gezeichnet, und sogar die Tueren und Waende tragen Dellen und Kratzer.");
    AddDetail(({"abnutzung", "benutzung"}), "Die Abnutzung ist in der Eingangshalle deutlich sichtbar.");
    AddDetail(({"dellen", "eindruecke"}), "Die Dellen an den Tueren zeugen von haeufigem oeffnen und Schliessen.");
    AddDetail(({"gegenstaende", "gegenstaenden"}), "Die Gegenstaende in der Eingangshalle sind alt und stark beansprucht. Der Teppich, die Treppe, der Kerzenleuchter, die Waende und die Tueren sind von Verfall gezeichnet und zeigen Anzeichen von Alter.");
    AddDetail("putz", "Der Putz an den Waenden ist rissig und broeckelig. Es scheint, als waere er seit Jahren nicht erneuert worden, und einige Stellen sind abgebrochen, sodass das darunterliegende Mauerwerk sichtbar ist. Feuchtigkeit hat ebenfalls ihre Spuren hinterlassen.");
    AddDetail(({"mauer", "mauerwerk"}), "Das Mauerwerk ist von Feuchtigkeit betroffen, und der Putz ist abgeblaettert.");
    AddDetail("schaeden", "Die Schaeden in der Eingangshalle sind offensichtlich, und der Verfall ist ueberall sichtbar.");
    AddDetail("schimmel", "In einigen Ecken der Waende ist gruener Schimmel zu sehen, begleitet von einem modrigen Geruch. Es scheint, als haette sich der Schimmel hier seit langem ungehindert ausgebreitet und ist sogar auf einige der Bilder uebergegangen.");
    AddDetail("rahmen", "Die Rahmen der Bilder in der Eingangshalle sind alt und verwittert. Einige sind verzogen und weisen Risse auf, waehrend andere deutliche Gebrauchsspuren zeigen. Trotzdem erkennt man noch die einstige Pracht und kunstvolle Gestaltung.");
    AddDetail(({"gold", "silber", "verzierungen"}), "Die einst praechtigen Gold- und Silberverzierungen an den Bilderrahmen sind abgeblaettert und verkratzt. Sie erinnern nur noch schwach an ihre einstige Schoenheit.");
    AddDetail("holz", "Das Holz in der Eingangshalle ist alt und abgenutzt. Es zeigt sichtbare Spuren von Gebrauch und Feuchtigkeit, manche Stellen sind verzogen.");
    AddDetail("landschaften", "Die meisten der Bilder an den Waenden sind Landschaftsdarstellungen. Sie moegen einst detailliert und beeindruckend gewesen sein, doch jetzt sind sie von Feuchtigkeit beschaedigt und verblasst.");
    AddDetail(({"personen", "portraets", "figuren"}), "Einige der Portraets zeigen Personen in praechtiger Kleidung und ernster Miene, waehrend andere informeller sind. Einige der Personen koennten historische Figuren sein, andere scheinen aus dem persoenlichen Umfeld des Malers zu stammen.");
    AddDetail(({"umfeld", "maler"}), "Leider ist der Maler unbekannt, da er seine Bilder nicht signiert hat.");
    AddDetail(({"kleider", "kleidern"}), "Die Personen in den antiken Bildern tragen praechtige, aufwendig verzierte Kleider aus edlen Stoffen, die gut erkennbar sind.");
    AddDetail(({"boden", "fliesen", "fliesenboden"}), "Der Fliesenboden ist stark von Verfall gezeichnet, einige Fliesen sind gebrochen oder verschoben.");
    AddDetail("putzstellen", "Einige Putzstellen an den Waenden sind abgebrochen und zeigen das darunterliegende Mauerwerk. Sie sind Zeugen von Vernachlaessigung und mangelnder Instandhaltung.");
    AddDetail("reparaturen", "Deutliche Spuren von notwendigen Reparaturen sind ueberall sichtbar. Es scheint, als haetten seit Jahren keine Reparaturen mehr stattgefunden.");
    AddDetail("ecken", "In den Ecken des Raumes sammelt sich Staub und Schmutz, und sie sind besonders von Feuchtigkeit und Schaeden betroffen.");
    AddDetail("eindruck", "Die Eindruecke an den Tueren sind deutliche Hinweise auf haeufiges Betreten und Schliessen.");
    AddDetail("kaelte", "Die Kaelte in diesem Raum verstaerkt das Gefuehl von Vernachlaessigung und Verfall.");
    AddDetail("ort", "Dieser Ort ist ein trauriges Beispiel fuer Vernachlaessigung und Verfall.");
    AddDetail("luft", "Die Luft in diesem Raum ist stickig und erfuellt von einem unangenehmen Geruch von Staub und Verfall.");
    AddDetail("naehe", "In der Naehe des Teppichs und der Waende konzentriert sich der unangenehme Geruch und verstaerkt das Gefuehl von Vernachlaessigung.");
    AddDetail("kunstfertigkeit", "Die Kunstfertigkeit, die einst in der Gestaltung dieser Villa steckte, ist nur noch in den verblassten Bildern zu erahnen.");
    AddDetail("landschaftsdarstellungen", "Die meisten Bilder an den Waenden sind Landschaftsdarstellungen, die einst detailliert und beeindruckend waren, nun aber von Feuchtigkeit und Verfall gezeichnet sind.");
    AddDetail("kleidung", "Die Personen in den antiken Bildern tragen praechtige, aufwendig verzierte Kleider aus edlen Stoffen, die gut erkennbar sind.");
    AddDetail("miene", "Die Miene der dargestellten Personen variiert von ernst und nachdenklich bis zu entspannt und froehlich.");
    AddDetail("schoenheit", "Die Bilder zeugen von vergangener Schoenheit, die jedoch durch die Zeit und Vernachlaessigung beeintraechtigt wurde.");
    AddDetail("vernachlaessigung", "Die Vernachlaessigung dieses Ortes ist ueberall erkennbar und hat zu deutlichen Schaeden gefuehrt.");
    AddDetail("pracht", "Die einstige Pracht und Eleganz dieses Ortes ist nur noch in Fragmenten und Resten zu sehen.");
    AddDetail("reste", "Die Reste der einstigen Schoenheit und Pracht sind ueberall sichtbar.");
    AddDetail("staub", "Staub bedeckt viele Oberflaechen und verstaerkt den Eindruck von Vernachlaessigung.");
    AddDetail("jahren", "Seit vielen Jahren scheint niemand mehr fuer die Instandhaltung dieses Ortes gesorgt zu haben.");
    AddDetail("eleganz", "Die einstige Eleganz und Raffinesse dieses Ortes ist nun von Verfall und Feuchtigkeit ueberschattet.");
    AddDetail("marmor", "Der Marmor der Treppe und der Marmorplatten zeigt deutliche Spuren von Abnutzung und Feuchtigkeit.");
    AddDetail("messing", "Das Messing des Kerzenleuchters und der Handlaeufe ist stumpf und verkratzt.");
    AddDetail("obergeschoss", "Das Obergeschoss ist ueber die breite Marmortreppe zu erreichen.");
    AddDetail("raeume", "Die grossen Mahagonitueren fuehren in weitere Raeume.");
    AddDetail("abnutzungsspuren", "Abnutzungsspuren sind an vielen Gegenstaenden in der Eingangshalle sichtbar.");
    AddDetail("glanz", "Der einstige Glanz des Teppichs und anderer Gegenstaende ist stark verblasst.");
    AddDetail("oberflaeche", "Die Oberflaeche des Teppichs ist gezeichnet von Flecken und Loechern.");
    AddDetail("handlaeufe", "Die Handlaeufe der Treppe aus poliertem Messing sind stumpf und verkratzt.");
    AddDetail("marmorplatten", "Die Marmorplatten der Treppe zeigen deutliche Spuren der Zeit und Abnutzung.");
    AddDetail("spuren", "ueberall sind Spuren von Verfall und Vernachlaessigung zu sehen.");
    AddDetail("stufen", "Die Stufen der Treppe aus Marmor sind glatt geschliffen von vielen Jahren des Betretens.");
    AddDetail("zeit", "Die Zeit hat diesem Ort stark zugesetzt und ihn gepraegt.");
    AddDetail("verfall", "Der Verfall dieses Ortes ist ueberall sichtbar.");
    AddDetail("villa", "Die Villa hat ihren einstigen Glanz und ihre Pracht verloren und ist nun ein trauriges Beispiel fuer Vernachlaessigung.");
    AddDetail("betretenes", "Viele Stellen im Raum zeigen Spuren von betretenen Wegen und Abnutzung.");
    AddDetail("schliessen", "Die Tueren tragen Kratzer und Dellen, die auf haeufiges oeffnen und Schliessen hinweisen.");
    AddDetail("kratzer", "Die Tueren und einige Oberflaechen zeigen deutliche Kratzer und Gebrauchsspuren.");
    AddDetail("instandhaltung", "Es ist offensichtlich, dass seit langer Zeit keine Instandhaltung mehr stattgefunden hat.");
    AddDetail("sammlung", "Die Sammlung von Bildern an den Waenden erzaehlt von vergangener Schoenheit und Kunstfertigkeit, die nun von Verfall und Feuchtigkeit beeintraechtigt ist.");
    AddDetail("stellen", "An verschiedenen Stellen im Raum sind Schaeden und Abnutzungsspuren sichtbar, die auf jahrelange Vernachlaessigung hinweisen.");
    AddDetail("zeugen", "Die Waende und Gegenstaende in diesem Raum zeugen von vergangener Pracht und Eleganz, die nun stark verblasst ist.");
    AddDetail("schmutz", "Schmutz hat sich in den Ecken des Raumes angesammelt und verstaerkt den Eindruck von Vernachlaessigung.");
    AddDetail("gestaltung", "Die Gestaltung dieses Ortes, die einst von Raffinesse und Kunstfertigkeit zeugte, ist jetzt von Verfall ueberschattet.");
    AddDetail("stoffen", "Die Kleider der Personen auf den Bildern sind aus edlen Stoffen gefertigt und detailreich dargestellt.");
    AddDetail("fragmenten", "Die einstige Pracht dieses Ortes ist nun nur noch in Fragmenten erkennbar.");
    AddDetail("hinweise", "Ueberall im Raum finden sich Hinweise auf die Zeit und die Vernachlaessigung, die diesem Ort zugesetzt haben.");
    AddDetail("raffinesse", "Die einstige Raffinesse und Eleganz dieses Ortes ist nun von Verfall und Feuchtigkeit ueberschattet.");
    AddDetail("loechern", "Loecher zieren die Oberflaeche des Teppichs und sind ein deutliches Zeichen von Abnutzung.");
    AddDetail("beispiel", "Dieser Ort ist ein trauriges Beispiel fuer Vernachlaessigung und den Verlust von einstiger Pracht.");
    AddDetail("zeichen", "Die Zeichen von Verfall und Vernachlaessigung sind allgegenwaertig und praegen diesen Ort.");
    AddDetail("verlust", "Der Verlust von einstiger Schoenheit und Pracht ist in jedem Detail dieses Ortes spuerbar.");


    AddExit( "westen", ROOM "vorgarten" );
    AddExit( "norden", ROOM "kaminzimmer");
    AddExit( "sueden", ROOM "petshop");
    AddExit( "osten", ROOM "kueche");
    AddExit( "oben", ROOM "gang");
}
