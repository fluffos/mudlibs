#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Flasche Balsamieroel");
  SetProp(P_LONG,
    "Diese Glasflasche enthaelt gut einen Liter Balsamieroel. Man nutzt es, "
    "um Leichen und Leichenteile zu konservieren, damit sie nicht verrotten.");

//--Namen------------------------------------------------------------------

SetProp(P_INFO, "Das Balsamieroel benoetigst du um Koerperteile zu konservieren. "
"Sie gehoert in dein Koefferchen.");
  SetProp(P_NAME, "Balsamieroel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"QUESTOBJ", QUEST_OEL_ID, "flasche", "oel", "balsamieroel"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_GLASS: 20, MAT_MISC_DRUG: 80]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);

}
