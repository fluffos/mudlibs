/*
** Fuchsfutter fuer den Petshop
**
**
*/

inherit "/std/thing";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create()
{
  ::create();

  SetProp(P_SHORT, "Etwas Hirnmasse");
  SetProp(P_NAME, "Hirnmasse");
  SetProp(P_LONG, 
	  BS("Du haeltst ein paar Kruemel graeuliche Hirnmasse in der Hand. "
       "Soweit du weisst es es genau das, was Untote jeglicher Art "
       "gerne als Leckerlis bekommen."));

  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 15);
  SetProp(P_WEIGHT, 50);
  AddId(({"masse","hirnmasse","katzenfutter","fuchsfutter", "futter", "untotenfutter"}));
}
