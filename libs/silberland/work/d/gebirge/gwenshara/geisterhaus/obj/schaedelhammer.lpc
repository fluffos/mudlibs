#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Schaedelhammer");
  SetProp(P_LONG,
    "Dieser kleine Hammer ist mit einem duennen Griff und einem schweren "
    "Rundkopf versehen. Die andere Rueckseite des Kopfs hat einen Spitz. Er "
    "eignet sich besonders dazu Schaedel aufzuknecken und das Gehirn zu "
    "entnehmen.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Diesen Hammer benoetigst du um Koerperteile zu entnehmen. "
                  "Er gehoert in dein Koefferchen.");
  SetProp(P_NAME, "Schaedelhammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"QUESTOBJ", "hammer", "schaedelhammer", QUEST_HAMMER_ID}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_STEEL: 50, MAT_MISC_WOOD: 50]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);

}
