inherit "/std/food";

#include <food.h>
#include "../def.h"

public void create() {
    if(!is_clone(TO)) return;
    ::create(({"trink", "trinke"}));

    SetProp(P_NAME, "Pina Colada");
    SetProp(P_SHORT, "Ein Glas mit Pina Colada");
    SetProp(P_LONG,  
        "Dieses Glas ist mit einem cremig-weissen Pina Colada gefuellt. "
        "Es duftet nach Ananas, Kokos und einem guten Schuss Rum. Die Milch "
        "sorgt fuer die extra Cremigkeit. Nur das Schirmchen fehlt.");

    SetProp(P_WEIGHT, 200);
    SetProp(P_GENDER, NEUTER);
    SetProp(P_MATERIAL, ([MAT_GLASS: 20, MAT_FRUIT: 30, MAT_ALCOHOL: 30, MAT_MILK: 20]));

    SetProp(P_FOOD_STATE, F_COOKED);
    SetProp(P_FOOD_INFO, ([
        F_HEAL: 30,
        F_DRINK: 10,
        F_ALCOHOL: 10,
        F_MSG: "Genuesslich schuettest du dir den Pina Colada rein.\n",
        F_MSG_ROOM: " schuettet sich einen Pina Colada rein.\n",
        F_VERB: "trinken"
    ]));

    AddId(({"pina colada", "pina", "colada", "glas", "\ngeisterhaus_pina_colada"}));

}