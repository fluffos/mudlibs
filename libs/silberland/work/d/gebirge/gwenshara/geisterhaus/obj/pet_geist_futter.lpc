/*
** Fuchsfutter fuer den Petshop
**
**
*/

inherit "/std/thing";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create()
{
  ::create();

  SetProp(P_SHORT, "Etwas ektoplasmischer Schleim");
  SetProp(P_NAME, "Schleim");
  SetProp(P_NAME_ADJ, ({"ektpolasmisch"}));
  AddAdjective(({"ektpolasmisch","ektpolasmischen","ektpolasmischer","ektpolasmischem"}));
  SetProp(P_LONG, 
	  "Es ist schwer zu sagen was du da eigentlich in der Hand haeltst. Dieser Schleim "
    "leuchtet irgendwie Geisterhaft. Er fuehlt sich stofflich und doch nicht stofflich "
    "an. Das ist wohl das, was Geister essen.");

  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 10);
  SetProp(P_WEIGHT, 0);
  AddId(({"schleim","geisterfutter","untotenfutter", "futter"}));
}
