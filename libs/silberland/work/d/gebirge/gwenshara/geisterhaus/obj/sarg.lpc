
#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein einfacher Holzsarg");
  SetProp(P_LONG,
    "Vor dir liegt ein einfacher Holzsarg, der krude zusammen gezimmer ist. "
    "Mit etwas Gewalt kann man ihn wohl aufbrechen. Aber pass auf, was daraus "
    "hervorkommt!");

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Sarg");
  SetProp(P_GENDER, MALE);
  AddId( ({"QUESTOBJ", "\ngeisterhaus_sarg", "sarg", "holzsarg"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 100]) );
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, "Der Sarg ist zu schwer.");

  AddCmd("brich|breche&sarg|holzsarg&auf", "cmd_aufbrechen", "Was willst du aufbrechen?\n");
}

public int cmd_aufbrechen() {
  object zombie;

  write(BS("Mit einem geuebten Hieb brichst du den Sarg auf."));
  say(BS(TPN+" zerschlaegt den Sarg mit einem gezielten Hieb."));

  if(random(40) > TP->QueryAttribute(A_DEX)) {
    write(BS("Aua! Bei dem Versuch hast du dir die Hand verletzt."));
    TP->AddHp(-10);
  }

  zombie = clone_object(NPC "zombie");
  if(zombie->move(environment(this_object()), M_GO|M_NOCHECK) != 1) {
    write(BS("Leider war der Sarg leer?!"));
    zombie->remove(1);
    return -1;
  }

  remove(1);
  return 1;
}

public void reset() {
  ::reset();

  if(!is_clone(this_object())) return;

  if(objectp(environment(this_object()))) {
    tell_room(environment(this_object()), "Der Sarg zerfaellt.\n");
  }

  remove(1);
}
