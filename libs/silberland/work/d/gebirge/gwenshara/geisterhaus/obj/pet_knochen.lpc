#include "../def.h"

inherit "/p/service/angel/haustiere/std_pet_item";
inherit "/d/wueste/protheg/most/std_things";

void _delay(string dummy)
{
  ::BringPetBack(dummy);
}

nosave int BringPetBack(string str)
{
  notify_fail(BS("Woran moechtest Du reiben?"));
  if(!str) return 0;   

  if(str=="kristall")
    {	
      write(BS("Du reibst an dem Knochen und er vibriert kurz..."));
      
      tell_room(ENV(TP), 
		BS(TPN+" reibt an einem morschen Knochen."), ({TP}));

      call_out("_delay", 2, str);
      return 1;
    }

  return 0;
}

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_NAME, "Knochen");
  SetProp(P_SHORT, "Ein morscher Knochen");
  SetProp(P_NAME_ADJ, "morsch");
  SetProp(P_LONG,  
	  BS("Diesen Knochen hast du von Mittwoch bekommen, als du deinen "
       "alternativen Lebenspartner adoptiert hast. Mit ihm kannst "
       "du dich um deinen neuen, nichtlebenden Freund kuemmern."));
  
  SetProp(P_INFO, 
	  make_document(
	  "Mit diesem Kristall kannst Du folgendes tun:\n"
	  "--------------------------------------------\n \n"
	  "reiben:    Damit kannst Du Dein Haustier wieder zurueckholen.\n"
	  "pethelp:   Dieses Kommando zeigt Dir einen Hilfetext an.\n"
	  "petconfig: Damit kannst Du Dein Haustier veraendern.\n\n"
	  "entlasse <haustiername> fuer immer:\n"
	  "!!! WARNUNG !!! Entlassungen kann man nicht rueckgaengig machen.\n"));
  
  SetProp(P_WEIGHT, 1);
  
  SetProp(P_GENDER, MALE);
  
  SetProp(P_ARTICLE, 0);
  
  SUID;
  
  AddId(({"knochen"}));
  AddAdjective(({"morsch", "morscher", "morschen", "morschem"}));
  
  AddCmd(({"reibe", "reib"}) , "BringPetBack");
}
