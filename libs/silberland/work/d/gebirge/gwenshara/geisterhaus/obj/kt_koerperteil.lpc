#include "../def.h"

inherit "/std/thing";

public void create() {
  ::create();
  if(!is_clone(TO)) return;

  SetProp(P_SHORT, "Ein Koerperteil");
  SetProp(P_NAME, "Koerperteil");
  
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 500);
  SetProp(P_NOBUY, 1);

  AddId(({"teil", "koerperteil", QUEST_KT_ID}));

  call_out("decay", 300);
}

public void reset() {
    ::reset();
    if(!is_clone(this_object())) return;

    if(objectp(environment(this_object())) && !living(environment(this_object()))) {
        remove();
    }
}

public void decay() {
    if(QueryProp("einbalsamiert")) return;

    if(objectp(ENV(TO))) tell_object(ENV(TO), BS(Name(WER) + " verwest."));
    if(objectp(ENV(TO))) tell_room(ENV(TO), BS(Name(WER) + " verwest."));
    remove(1);
}

public void SetValues(string was, string welches, string rasse, int level) {
    SetProp(P_RACE, rasse);
    SetProp(P_LEVEL, level);

    switch(was) {
        case "arm":
            SetProp(P_NAME, "Arm");
            SetProp(P_SHORT, sprintf("Der %se Arm eines %s", welches[0..strlen(welches)-2], rasse));
            SetProp(P_LONG, sprintf("Das ist der abgetrennte %se Arm eines %s.", welches[0..strlen(welches)-2], rasse));
            AddId("\n"+was+"_"+welches);
            AddId("arm");
            SetProp("bodypart", (welches=="rechts"?ARM_RECHTS:ARM_LINKS));
            break;
        case "bein":
            SetProp(P_NAME, "Bein");
            SetProp(P_SHORT, sprintf("Das %se Bein eines %s", welches[0..strlen(welches)-2], rasse));
            SetProp(P_LONG, sprintf("Das ist das abgetrennte %se Bein eines %s.", welches[0..strlen(welches)-2], rasse));
            AddId("\n"+was+"_"+welches);
            AddId("bein");
            SetProp("bodypart", (welches=="rechts"?BEIN_RECHTS:BEIN_LINKS));
            break;
        case "torso":
            SetProp(P_NAME, "Torso");
            SetProp(P_SHORT, sprintf("Der Torso eines %s", rasse));
            SetProp(P_LONG, sprintf("Das ist das abgetrennte Torso eines %s ohne alle Gliedmassen.", rasse));
            AddId("\ntorso");
            AddId("torso");
            SetProp("bodypart", TORSO);
            break;
        case "hirn":
            SetProp(P_NAME, "Hirn");
            SetProp(P_SHORT, sprintf("Das Gehirn eines %s", rasse));
            SetProp(P_LONG, sprintf("Dies ist das Gehirn eines %s, wie du an der Farbe erkennst.", rasse));
            AddId("\ntorso");
            AddId("hirn");
            AddId("gehirn");
            SetProp("bodypart", HIRN);
            break;
        default:
            raise_error("unbekanntes koerperteil\n"); break;
    }
}
