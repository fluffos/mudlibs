#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Knochensaege");
  SetProp(P_LONG,
    "Diese Saege mit dem einfachen Holzgriff und den feinen Zacken am "
    "Saegeblatt wurde dazu gemacht Knochen zu durchschneiden und Glieder "
    "zu amuptieren.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Diese Saege benoetigst du um Koerperteile zu entnehmen. "
  "Sie gehoert in dein Koefferchen.");
  SetProp(P_NAME, "Knochensaege");
  SetProp(P_GENDER, FEMALE);
  AddId( ({QUEST_SAEGE_ID, "QUESTOBJ", "saege", "knochensaege"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_STEEL );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);

}
