inherit "/gilden/bardengilde/instrument/base_string";

#include <properties.h>
#include <combat.h>
#include "/p/std/barden/instrument.h"
#include "../def.h"

public void create() {
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Harfe aus Rippen");
  SetProp(P_LONG, 
	  "Diese Harfe ist aus de Brustknochen eines menschengrossen Zweibeiners gemacht. "
    "vielleicht war sie mal ein Mensch oder Elf? Jetzt ist der Spender allerdings "
    "zu einer Harfe umgearbeitet worden. Feuchtes Saiten aus Gedaerm sind eingespannt."); 
  SetProp(P_NAME, "Rippenharfe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"harfe", "rippenharfe"}));
  SetProp(P_INSTRUMENT_LEVEL, 5);
  SetProp(P_HANDS, 2);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_WOOD:75, MAT_COPPER: 25]));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}














