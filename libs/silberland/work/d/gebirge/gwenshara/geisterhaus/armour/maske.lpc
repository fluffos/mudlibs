#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine selbstgemachte Schaedelmaske");
  SetProp(P_LONG,
    "Diese Maske zeigt die schmerzverzerrten, angsterfuellten Zuege eines "
    "Elfen. Sie wurden offenbar aus echter Gesichtshaut gemacht und wird "
    "ueber den Kopf gezogen. Ein wenig erinnert dich das Gesicht an das "
    "von Mythar. Allerdings ist das keine echte Schaedelmaske der Nekromanten, "
    "sondern wirkt eher selbstgemacht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schaedelmaske");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"maske", "schaedelmaske"}) );

  SetProp(P_NAME_ADJ, "selbstgemacht" );
  AddAdjective( ({"selbstgemachte","selbstgemachten"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_SKIN );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_NEKRO_BONUS, (["all": 5]));
}
