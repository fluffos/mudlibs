#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "std/armour";

private int enabled;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();
  enabled = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine unheiliges Pentagrammamulett");
  SetProp(P_LONG,
    "An einer schwarzen Lederkordel haengt ein glitzerndes Pentagramm aus "
    "Silber. Mitten im Pentagramm ist ein Katzenkopf eingelassen. Auf seiner "
    "Rueckseite stehen die Buchstaben: BZB. Du bist dir sicher, dass es sich "
    "Dabei um unheiliges Teufelszeug handelt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Pentagrammamulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", "pentagrammamulett"}) );

  SetProp(P_NAME_ADJ, "unheilig" );
  AddAdjective( ({"unheiliges","unheiligen", "unheiligem"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER: 20, MAT_SILVER: 70, MAT_MISC_UNHOLY: 10]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 666);
  SetProp(P_NOBUY, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 2);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_MAGIC, 1);
  SetProp(P_INFO, "Dieses Amulett laesst seinen traeger dank daemonischer "
                  "Zauberei im Dunklen sehen.");

  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
}

int WearFunc(object me)
{
  if(!ENV(TO)->is_class_member(CL_NIGHTVISION)) {
    tell_object(ENV(TO), BS("Deine Augen gewoehnen sich ploetzlich an die Dunkelheit."));
    ENV(TO)->AddClass(CL_NIGHTVISION);
    enabled = 1;
  }
  return 1;
}

int RemoveFunc(object me)
{
  if(enabled) {
    tell_object(ENV(TO), BS("Deine Augen werden wieder normal."));
    ENV(TO)->RemoveClass(CL_NIGHTVISION);
    enabled = 0;
  }
  return 1;
}

