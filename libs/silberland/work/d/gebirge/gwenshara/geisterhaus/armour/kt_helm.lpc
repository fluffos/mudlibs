#include "../def.h"

inherit "std/armour";

private int load;

public string fuellstand() {
  switch(100*load/QueryProp("targetload")) {
    case 0 .. 10: return "komplett leer"; break;
    case 11 .. 20: return "ein bisschen gefuellt"; break;
    case 21 .. 30: return "etwa zu einem Viertel gefuellt"; break;
    case 31 .. 40: return "etwa ein Drittel gefuellt"; break;
    case 41 .. 45: return "weniger als halbvoll"; break;
    case 46 .. 55: return "halbvoll"; break;
    case 56 .. 60: return "mehr als halbvoll"; break;
    case 61 .. 70: return "in etwa zwei Drittel gefuellt"; break;
    case 71 .. 80: return "circa zu Dreivierteln voll"; break;
    case 81 .. 90: return "schon mehr als dreiviertel voll"; break;
    case 91 .. 99: return "fast ganz gefuellt"; break;
    default: return "vollstaendig gefuellt"; break;
  }
  return "fehlerhaft. Melde Dich bei einem Magier";
}

public int IsFull() {
  return load >= QueryProp("targetload");
}

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  load = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine merkwuerdiger Helm mit Blitzableiter");
  SetProp(P_LONG,
    "Eigentlich ist das hier ein Lederhelm. Allerdings wurde er mit vielen "
    "Draehten und Spulen umwickelt und eine lange Kupferstange auf ihm "
    "montiert, die mit einem kleinen Glasflaeschchen verbunden ist. "
    "In dem Glasflaeschchen wabert eine gruenlich leuchtende Fluessigkeit. "
    "Es ist @@fuellstand@@.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Helm mit Blitzableiter");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"QUESTOBJ", "helm", "lederhelm", "blitableiterhelm", QUESTOB_ID_HELM}) );

  SetProp(P_NAME_ADJ, "merwuerdig" );
  AddAdjective( ({"merkwuerdiger","merkwuerdigen","merkwuerdigem"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER: 50, MAT_COPPER: 20, MAT_GLASS: 10, MAT_MAGIC: 20]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 1000);

  SetProp(P_DEFEND_FUNC, TO);
}

public int DefendFunc(string *dtyp, mixed spell, object enemy) {
  if(member(dtyp, DT_LIGHTNING) || member(dtyp, DT_ELECTRIC)) {
    if(load < QueryProp("targetload")) {
      tell_object(QueryProp(P_WORN), BS("Der Blitz schlaegt in den Helm ein und das Flaeschchen fuellt sich."));
      load += 1 + random(10);
    } else {
      tell_object(QueryProp(P_WORN), BS("Der Blitz schlaegt in den Helm ein, doch das Flaeschchen ist bereits vollstaendig gefuellt."));
    }
    return 10;
  }
  return 0;
}
