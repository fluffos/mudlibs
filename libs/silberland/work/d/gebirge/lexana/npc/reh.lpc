/* *******************************************
		     Reh mit Fleischstuecken

    Stellt das Fleisch zu verfuegung um Wolf zu locken
    und um Pumababys zu fuettern.

    <c> Lexana@SilberLand		   crt. 25.05.1997	
    Original by Feyaria@Silberland
   *******************************************
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <moredef.h>
#include "/players/lexana/magierrat/magierrat.h"
#define SHORT "Ein scheues Reh"

void unsichtbar();
int invis;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, SHORT);
  SetProp(P_LONG, BS(
    "Das Reh hat ein rostrotes, weiches Fell und ein kleines, zweiendiges "
    "Geweih. Es schaut Dich scheu mit seinen grossen, braunen Rehaugen an."));
  SetProp(P_NAME, "Reh");
  SetProp(P_NAME_ADJ, "scheu");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"reh"}) );
  AddAdjective( ({"scheu", "scheues"}) );

  create_default_npc(7);
  SetProp(P_HANDS, ({" mit seinem kleinen Geweih", 50, DT_PIERCE}));
  SetProp(P_RACE, "Hirsch");
  SetProp(P_SIZE, 65+random(10));
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WEIGHT, 20000);
//  SetProp(P_WIMPY, 25);
  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");

  AddInfo(DEFAULT_INFO, "schaut Dich verschreckt an.\n");

  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen, doch Lexana hat mich trainiert.\n");
  AddInfo("lexana", "Lexana hat mich angepasst.\n");


  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Das Reh kann nichts mit Deinen Sachen anfangen.\n"}));


  SetChats(3, ({
    "Das Reh schaut Dich ganz scheu mit seinen grossen Rehaugen an.\n",
    "Das Reh knabbert an den Blaettern der Baeume.\n",
    "Das Reh blickt nervoes hin und her.\n",
    "Das Reh zittert leicht.\n",
    "Das Reh schaut sich aengstlich um.\n",
    "Das Reh zieht pruefend die Luft in seine Nuestern.\n",
    "Das Reh schnuppert.\n"}) );

  seteuid(getuid(TO));
  create_geweih()->move(TO);
  command("zuecke geweih");

  SetProp(P_MNPC_AREA, ({ FL_QS_ROOM "001", FL_QS_ROOM "011", FL_QS_ROOM "010",
		FL_QS_ROOM "022", FL_QS_ROOM "033", FL_QS_ROOM "043", 
		FL_QS_ROOM "053", FL_QS_ROOM "063", FL_QS_ROOM "073" }) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM,  FL_QS_ROOM "010");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);


  SetProp(P_DIE_MSG, " bricht tot zusammen.\n");

  invis=0;



}

object create_geweih()
{
  object o;
  
  o = clone_object("std/weapon");
  o->SetProp(P_SHORT, "Ein Rehgeweih");
  o->SetProp(P_LONG, BS(
     "Das ist das Geweih eines kleinen Rehs."));
  o->SetProp(P_NAME, "Rehgeweih");
  o->SetProp(P_GENDER, NEUTER);
  o->AddId(({"geweih", "rehgeweih"}));
  o->SetProp(P_VALUE, 550+random(100));
  o->SetProp(P_WEIGHT, 600+random(120));
  o->SetProp(P_MATERIAL, MAT_HORN);
  o->SetProp(P_WEAPON_TYPE, WT_SPEAR);
  o->SetProp(P_DAM_TYPE, DT_PIERCE);
  o->SetProp(P_WC, 50+random(10));
  o->SetProp(P_NR_HANDS, 2);
  return o;
}


void init()
{
  ::init();
  if( TP->QueryProp(P_LEVEL) >= 20+random(100) && !invis)
  {
    invis=1;
    call_out("unsichtbar",0);
  }  
}

void unsichtbar()
{
  if( ENV(TP)==MENV)
    tell_object(TP, "Als das Reh Dich sieht, fluechtet es in den Wald.\n");
  tell_room(MENV, "Als das Reh "+ TP->name(WEN) + " sieht, fluechtet es "
         "in den Wald.\n", ({TP}) );
  RemoveId( ({"reh"}) );
  SetProp(P_NOATTACK, 1);        
  SetProp(P_SHORT, 0);
  while (remove_call_out("sichtbar")!=-1) ;
  call_out("sichtbar", 5+random(20));
  invis=1;
  SetProp(P_GHOST,1);
  SetProp(P_CHAT_CHANCE,0);
}

void sichtbar()
{
  tell_room(MENV, "Ein Reh kommt vorsichtig aus dem Wald heraus.\n");
  SetProp(P_SHORT, SHORT);
  SetProp(P_NOATTACK, 0);
  AddId(({"reh"}));
  invis=0;
  SetProp(P_GHOST,0);
  SetProp(P_CHAT_CHANCE,3);
}

Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if( dam+random(150)>400 )
  {  
    tell_room(MENV, "Das Reh fluechtet vor lauter Schreck in den Wald.\n" );
    unsichtbar();
    while (remove_call_out("sichtbar")!=-1) ;
    call_out("sichtbar", 20+random(20));
    return;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}


void die(int poisondeath) {

// erstelle 2 Stuecke Fleisch
  clone_object(FL_QS_OBJEKT+"fleisch.lpc")->move(environment(TO),M_NOCHECK);
  clone_object(FL_QS_OBJEKT+"fleisch.lpc")->move(environment(TO),M_NOCHECK);

  ::die(poisondeath);

}