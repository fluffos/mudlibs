    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Waldwolf ) "
               " -%d EP\n", lostexp) );
  }
}  */

void die(int poisondeath) {


// erzeuge den unteren Stein  
  clone_object(FL_QS_OBJEKT+"u_stein.lpc")->move(environment(TO),M_NOCHECK);

  write(BS("Als der Wolf verendet kannst du sehen woran er geknabbert hat... an einer "+ 	   	    "Steintafel.\n"));

  ::die(poisondeath);
}

int lockewolf(string str) {

  string wen;
  string womit;
  object ob;

  notify_fail(BS("Wen willst Du denn locken?\n"));

  if (!str) return 0;

  if (sscanf(str,"%s mit %s",wen,womit)) {
    if (wen=="wolf") {
      if (womit=="fleisch" || womit=="rehfleisch") {
        if (!(ob=present("fleisch",this_player()))) {
	  write(BS("Aber soetwas besitzt Du doch gar nicht."));
	  return 1;
	}
	write(BS("Der Wolf stuerzt sich gierig auf das herrliche Stueck Rehfleisch "+
		  "und zerrt es gierig in das Dickicht hinein. Jetzt siehst Du auch "+
		  "woran der Wolf geknabbert hat... an einer Steintafel.\n"));

	clone_object(FL_QS_OBJEKT+"u_stein.lpc")->move(environment(TO),M_NOCHECK);	

        ob->remove();
	this_object()->remove();
	
	return 1;
      }
    }
  }

  write(BS("Womit willst du denn locken....?"));

  return 1;
}