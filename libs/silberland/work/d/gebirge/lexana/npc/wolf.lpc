inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


#include "/players/lexana/magierrat/magierrat.h"

int lockewolf(string str);

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein gefaehrlicher Wolf");
  SetProp(P_LONG, BS(
    "Dieser grosse, boese Wolf hat ein dickes schwarzes Fell und ein "
    "grosses Maul voller spitzer Zaehne. Aus seinen gelben Augen schaut er "
    "Dich hasserfuellt an. Sicher ist er gerade sehr hungrig.\n"
    "Er scheint an einem Gegenstand zu knabbern."));
  SetProp(P_INFO, BS(
    "Dieser Wolf sieht sehr gefaehrlich aus. Mit seinen spitzen Zaehnen "
    "kann er Dich mit einem einzigen Biss in die Kehle toeten, also sei "
    "sehr vorsichtig."));
  SetProp(P_NAME, "Wolf");
  SetProp(P_GENDER, MALE);
  AddId("wolf");

  AddDetail(({"gegenstand","ding","etwas"}),BS("Du kannst nicht erkennen worum es sich handelt. "+
				"Vielleicht koenntest Du den hungrigen Wolf irgendwie locken?"));

  AddDetail("locken",BS("Naja wenn er so hungrig ist, ist er sicherlich empfaenglich fuer etwas Fleisch."));

  AddDetail("fleisch",BS("Sowas moegen Woelfe..."));

  AddDetail( ({"zahn", "zaehne", "maul"}),
    "Die Zaehne des Wolfes sind wirklich spitz! Du moechtest seinem Maul "
    "nicht in die Quere kommen!");
  AddDetail( ({"augen", "auge"}),
    "Der Wolf hat kleine, gelbe Augen mit denen er Dich hasserfuellt und "
    "aufmerksam beobachtet.");
  AddDetail( ({"fell"}),
    "Das schwarze Fell ist typisch fuer einen Wolf. Da es schon sehr "
    "abgewetzt ist, schaut der Wolf schon sehr alt und erfahren aus.");
  
  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinem fuerchterlichen Gebiss", 160, DT_RIP}));
  SetProp(P_MAX_HP, 200);
  SetProp(P_XP, 6000*100);
  SetProp(P_RACE, "Wolf");
  SetProp(P_SIZE, 150+random(10));
  SetProp(P_ALIGN, -222);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_TERROR, DT_COLD,DT_FIRE}) );

  SetProp(P_MSGIN, "kommt knurrend an");
  SetProp(P_MSGOUT, "geht knurrend");
  SetProp(P_MMSGIN, "kommt knurrend an");
  SetProp(P_MMSGOUT, "will hier nicht mehr knurren");

  AddInfo(DEFAULT_INFO, "knurrt dich hungrig an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen und Lexana hat mich mutiert.", "teilt Dir mit: ");
  AddInfo("lexana", "Lexana ist lieb. Vorallem ihr Riesenbonbon.", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Waldwolf will Deine Sachen nicht.\n"}));
  SetProp(P_DIE_MSG, " heult das letzte mal.\n");

  SetChats(3, ({
    "Der Waldwolf knurrt Dich an.\n",
    "Der Waldwolf heult furchterregend.\n",
    "Der Waldwolf fletscht seine Zaehne.\n"}) );

  SetProp(P_SPELLRATE, 30);
  AddSpell(9, 555,
    "Der Waldwolf beisst Dich ins Bein.\n",
    "Der Waldwolf beisst @WEN ins Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 999,
    "Der Waldwolf springt Dir an die Kehle.\n",
    "Der Waldwolf springt @WEM an die Kehle.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddCmd(({"lock","locke","fuetter","fuettere"}),"lockewolf");
}

