/* ***********************************************
			    Rehfleisch 	

	Um den Wolf wegzulocken oder die Pumababys zu
	fuettern.

	<c> Lexana@Silberland		crt. 25.05.1997
   ************************************************
*/

inherit "std/thing";

#include <properties.h>

#include <combat.h>

#include <language.h>

#include "/players/lexana/magierrat/magierrat.h"

int essen(string str);
int forget();

create()  {
  if (!is_clone(TO)) return;

  ::create();

  AddId (({"fleisch","rehfleisch"}));

  SetProp (P_SHORT, "Ein Stueck Rehfleisch");

  SetProp (P_LONG, BS("Ein saftiges mageres Stueck Rehfleisch das viel zu schade ist "+
	                  "roh hinuntergeschlungen zu werden. Du solltest eine spezielle "+
			  "Verwendung dafuer finden.\n"));

  AddDetail("verwendung","Die Verwendung des Fleisches musst du bestimmen.");

  SetProp (P_NAME, "Rehfleisch");

  SetProp (P_GENDER, NEUTER);

  SetProp (P_WEIGHT, 500);

  SetProp (P_VALUE, 200);

  SetProp (P_NOBUY, 1);

  SetProp (P_AC, 0);

  AddCmd(({"esse","iss"}),"essen");

  AddCmd(({"oja","ja","doch"}),"forget");

}  

int essen(string str) {

  notify_fail(BS("Was genau wuerdest Du gerne essen?"));

  if (str=="fleisch" || str=="rehfleisch") {
    write(BS("Nein, nein, nein Du willst doch nicht wirklich eine derartige Delikatesse einfach roh verzehren. "+
              "Fuer dieses Fleisch solltest Du etwas Spezielles vorsehen"));
    return 1;	
  } /* endif */

  return 0;  
}

int forget() {
  write(BS("Vergiss es!"));

  return 1;
}