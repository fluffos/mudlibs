/* *****************************************
	Die erste Steinhaelfte der Geschichte von

			  Lexan

 	        <c>by Lexana@Silberwald
	
					crt. 24.05.97
   ******************************************
*/

inherit "/std/thing";

#include <properties.h>

#include <language.h>

#include "/players/sargola/def_kristall.h"


int read; // bestimmt ob diese Steinhaelfte bereits glesen wurde (wichtig damit der Player 
	  // das Quest fortsetzen kann.)

string stoneread();


create() {

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Die obere Haelfte einer Steintafel");

  SetProp(P_LONG, BS("Du haeltst die teilweise verwitterte obere Haelfte einer "+
			 "Steintafel in Deinen Haenden. Auf dem Stein kannst du "+
			 "altertuemliche Zeichen entdecken.\n"));

  SetProp(P_GENDER, FEMALE);

  SetProp(P_WEIGHT, 100);

  SetProp(P_VALUE, 0);

  SetProp(P_NOBUY, 1);

  SetProp(P_NAME, "obere Haelfte einer Steintafel");

  AddId (({"tafel", "steintafel","stein","haelfte","steinhaelfte","\no_stein"})); 


  AddDetail (({"inschrift","zeichen","schrift","dialekt"}), BS("Ein etwas aelterer Dialekt, vielleicht gelingt es "+
						     "Dir ja ihn zu lesen.\n"));

  AddReadDetail ( ({"inschrift", "schrift","zeichen","dialekt"}), BS("@@stoneread@@"));

}


string stoneread() {

	if (!(present("\no_stein",this_player()))) {
	  return "\nBevor Du versuchst die Zeichen zu entzifferst solltest du den Stein einmal nehmen.\n";
	}

	if (TP->QueryAttribute(A_INT)>10) {
		
		read=1;
	  

TP->More(BS("Du versuchts die Inschrift zu entziffern...\n\nIch, Mengal der Seher, spuere wie "+
	"die Kraft des Lebens meinen Koerper verlaesst. "+
	"Durch den Schleier meines Unterbewusstseins zeigt sich bereits die Fratze, der knochige "+
	"Schaedel des Todes, der unbarmherzig seine knochige Hand nach mir ausstreckt... "+
	"aus diesem Grunde muss ich eilen, die Erfahrungen und Nachforschungen meines gesamten "+
	"Leben hier festzuhalten:\n\n" +
	"Die Geschichte der Stadt Lexan\n\n"+
	"moege jener, der diese Aufzeichnungen findet meine Suche vollenden...\n\n"+
	"In einer laengst vergessenen Zeit, als wenige Wesen ihre Fuesse auf diesen Erdboden "+
	"setzten, da herrschte Frieden in diesem Land. Zentrum der damaligen Macht war der Rat "+
	"der Magier; das Zentrum des Handels war die Stadt Lexan, in der eben dieser Rat "+
	"zusammentraf um zu beschliessen und zu richten. An einem bestimmten Tag jeden Jahres "+
	"kamen Magier aus allen Teilen des Landes herbei um ueber die Zukunft zu Rate zu sitzen.\n"+
	"Die Magier, munkelte man, konnten allein mit der Macht ihres Geistes Meere versetzen "+
	"und Berge zerbersten lassen, und immer wieder traten Geruechte auf, dass sie in Wahrheit "+
	"nicht von dieser Welt seien.\n"+
	"Der Rat der Magier regierte weise und gerecht bis an dem Tag, an dem der Segen der Goetter "+
	"von diesen Land wich. An eben dem Tag, als der Rat sich wieder zur Beratung versammelte, "+
	"oeffneten sich die Schlunde der Hoelle und gebaren Monster, ...nein Teufel von solcher Boesheit "+
	"und Grausamkeit, dass das gesamte Land wie gelaehmt darniederlag. Nach zwoelf Stunden der "+
	"Verwuestung und des Todes am Tage und zwoelf Stunden der Grausamkeit und Furcht in der Nacht "+
	"verschwanden diese Ausgeburten der Unterwelt so schnell wie sie gekommen waren....\n\n"+
	"Hier endet die Inschrift. Du bist zwar interressiert das Ende der Geschichte zu erfahren, doch "+
	"angesichts des schlechten Zustandes der Steinhaelfte zweifelst Du daran die zweite Haelfte "+
	"unversehrt zu finden.\n"));
		return "";
	} else
	{

// Player kann nun entweder INT erhoehen od. einen anderen Spieler die Tafel lesen lassen

		return "\n\nDu versucht die Inschrift zu entziffern...\n\n...doch bist leider nicht intelligent genug.\n";
	}

}

int query_read() {
  return read;
}