/* *****************************************
	Die zweite Steinhaelfte der Geschichte von

			  Lexan

 	        <c>by Lexana@Silberwald
	
					crt. 24.05.97
   ******************************************
*/

inherit "/std/thing";

#include <properties.h>

#include <language.h>

#include "/players/sargola/def_kristall.h"


int read; // bestimmt ob diese Steinhaelfte bereits glesen wurde (wichtig damit der Player 
	  // das Quest fortsetzen kann.)

string stoneread();


create() {

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Die untere Haelfte einer Steintafel");

  SetProp(P_LONG, BS("Du haeltst die teilweise verwitterte untere Haelfte einer "+
			 "Steintafel in Deinen Haenden. Auf dem Stein kannst du "+
			 "altertuemliche Zeichen entdecken.\n"));

  SetProp(P_GENDER, FEMALE);

  SetProp(P_WEIGHT, 100);

  SetProp(P_VALUE, 0);

  SetProp(P_NOBUY, 1);

  SetProp(P_NAME, "untere Haelfte einer Steintafel");

  AddId (({"tafel", "steintafel","stein","haelfte","steinhaelfte","\nu_stein"})); 


  AddDetail (({"inschrift","zeichen","schrift","dialekt"}), BS("Ein etwas aelterer Dialekt, vielleicht gelingt es "+
						     "Dir ja ihn zu lesen.\n"));

  AddReadDetail ( ({"inschrift", "schrift","zeichen","dialekt"}), BS("@@stoneread@@"));

}


string stoneread() {
	
	if (!(present("\nu_stein",this_player()))) {
	  return "\nBevor Du die Schriftzeichen entziffern willst, soltest Du sie zuerst nehmen.\n";
	}

	if (TP->QueryAttribute(A_INT)>11) {
		
		read=1;

TP->More(BS("...Dieser Tag riss tiefe Narben in das Land, dessen Bevoelkerung und in den "+
	"Rat der Magier. Sei es durch die Entladung der unfassbar hohen negativen Energien oder durch "+
        "eine Veraenderung der geistigen Maechte der Magier..., der sonst so besonne Rat war sich "+
        "erstmals in seiner weiteren Vorgangsweise uneins. Teile des Rates sollen angeblich Ihren klaren "+
        "Verstand eingebuesst haben und Geruechten zu folge haben sich einige Magier sogar gegen das "+
        "Volk selbst gewandt.\n"+
        "Der Rat loeste sich auf, die Magier teils ihrer klaren Sinne, teils ihrer Kraefte beraubt verloren "+
        "sich in den den Weiten des Landes, und mit dem Rat starb auch Lexan.\n"+
        "Das Volk, ihren geistigen Fuehrern beraubt, begann sich in Kleinkriege zu verstricken und bildete "+
        "eigene Metropolen die fanatisch gegen alles Fremde verteidigt wurde.\n"+
        "Das gesamte Land zerbrach.\n"+
        "Die Stadt Lexan geriet seit damals immer mehr in Vergessenheit, und niemand weiss heute genau "+
        "wo diese Stadt gelegen haben muss bzw. ob sie ueberhaupt je exisitiert hat. Junge Abenteurer jedenfalls, "+
        "die sich Reichtum, Macht und Ehre erhofften und sich auf die Suche begaben, wurden von Ihren "+
        "Vaetern und Muettern nie mehr wieder gesehen.\n"+
        "Neben den ueblichen Geruechten von Schaetzen und magischen Kraeften kann man ab und zu auch "+
        "einigen seltsamen Vermutungen lauschen: angeblich sollen die ueberlebenden Magier seit geraumer "+
        "Zeit versuchen sich wieder zu finden und erneut einen Rat der Magier zu gruenden...\n"+
        "Du bekommst irgendwie das Gefuehl, dass der Seher noch weit mehr mitteilen wollte, doch der Tod "+
        "ein wenig schneller war als er...\n"));

		return "";
	} else
	{

// Player kann nun entweder INT erhoehen od. einen anderen Spieler die Tafel lesen lassen

		return "\n\nDu versucht die Inschrift zu entziffern...\n\n...doch bist leider nicht intelligent genug.\n";
	}

}

int query_read() {
  return read;
}