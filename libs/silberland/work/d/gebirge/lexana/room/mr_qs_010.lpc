#include <properties.h>
#include <moving.h>
#include <language.h>

#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";


// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine Sackgasse im Wald");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Der Waldweg endet in einer Sackgasse. Baeume und Straeucher machen "+
			       "den Weg hier unpassierbar. Der grossartigen Stimmung, die in diesem Wald "+
			       "herrscht, tut dies jedoch keinerlei Abbruch.\n"+
			       "In einem nahen Gebuesch kannst du einen Moosfleck erkennen der sich "+
			       "irgendwie vom restlichen Moos unterscheidet."));

  AddDetail("moos",BS("Das Moos bedeckt Steine, Teile des Bodens und auch einige Baumstaemme. "+
			  "Ein Moosfleck sieht irgendwie anders aus."));

  AddDetail(({"steine","stein"}),BS("Die Steine sind von Moos bedeckt."));

  AddDetail(({"moosfleck","fleck"}),BS("Der Moosfleck sieht aus als haette er einem Tier vor kurzem als "+
					  "Schlafplatz gedient. Da keine Spuren von Krallen oder Aehnlichem zu "+
					  "sehen sind, nimmst Du an, dass es sich um ein Reh gehandeln haben muss."));

  AddDetail("reh",BS("Das Reh duerfte auf dem Moos geschlafen haben."));

  AddDetail(({"schlafplatz","platz"}),BS("Der Schlafplatz besteht aus etwas zusammengedruecktem Moos."));

  AddDetail(({"spuren","krallen","spur","kralle"}),BS("Du kannst keine Spuren von Krallen entdecken."));

  AddDetail(({"sackgasse","gasse"}),BS("Du stehst mitten in einer Sackgasse."));

  AddDetail(({"osten","o"}),BS("Gen Osten glaubst du eine Kreuzung zu erblicken"));	

  AddExit("westen",FL_QS_ROOM+"mr_qs_011.lpc");  

  AddItem (FL_QS_NPC+"reh.lpc", REFRESH_DESTRUCT);

}
