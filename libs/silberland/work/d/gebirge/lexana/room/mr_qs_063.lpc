#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";




// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein freundlicher Weg, tief in einem grossen Wald.");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Du befindest Dich tief in einem grossen aber freundlichen Wald. "+
			       "Du beginnst Dich langsam zu fragen welche Ausmasse dieser Wald noch "+
			       "besitzt da keinerlei Grenzen abzusehen sind.\n"+
			       "Sowohl nach Norden wie nach Sueden scheint sich der Weg tiefer durch den "+
			       "Wald zu schlaengeln."));

  AddDetail(({"norden","n"}),BS("Hm...irgendwie kannst du nichts genaueres erkennen...ausser Wald, Wald "+
				   "und nochmals Wald."));
 	
  AddDetail(({"sueden","s"}),BS("Ebenso wie im Norden kannst du auch im Sueden nichts als Wald erkennen. "));

  AddDetail("ausmasse",BS("Der Wald scheint Dir unendlich gross zu sein."));

  AddDetail(({"grenzen","grenze"}),BS("Also die Grenzen des Waldes befinden sich sicher irgendwo, "+
					  "aber hier duerften sie sich nicht befinden."));

  


  AddExit("norden",FL_QS_ROOM+"mr_qs_053.lpc");  

  AddExit("sueden",FL_QS_ROOM+"mr_qs_073.lpc");	

}





