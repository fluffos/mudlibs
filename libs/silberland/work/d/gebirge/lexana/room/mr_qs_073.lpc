#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";


int gotosouth();


// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine Sackgasse im Wald.");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Hier endet der Waldweg aprupt. Waehrend er im Norden schnell an "+
			       "Breite gewinnt, ist er im Sueden von undurchdringlichem Dickicht "+
			       "regelrecht verstopft. Naja, einmal muss alles, selbst ein so romantischer "+
			       "Waldweg ein Ende haben."));

  AddDetail(({"norden","n"}),BS("Hier wird der Waldweg schnell breiter."));
 	
  AddDetail(({"sueden","s"}),BS("Dort ist nur undurchdringliches Dickicht."));

  AddDetail(({"weg","waldweg","ende"}),BS("Wie bereits gesagt, der Weg endet hier."));

  AddDetail("dickicht",BS("Das Dickicht ist undurchdringlich. Die Zweige, Blaetter und Dornen "+
			    "scheinen sich so verkeilt zu haben, dass seltsamerweise nicht einmal der Wind sie zu "+
			    "bewegen vermag."));

  AddDetail(({"zweige","blaetter","dornen"}),BS("Schon seltsam, dass sich Zweige, Blaettern und Dornen "+
						     "derart miteinander verkeilen koennen."));
  
  AddDetail(({"wind","windstoss"}),BS("Selbst der Wind hat das Dickicht nicht bewegen koennen. Auch das rege "+
					   "Treiben und Leben der Waldbewohner nimmt hier ein Ende. Wie kannst "+
					   "Du dieses Dickicht je ueberwinden wenn nichteinmal der Wind es kann?"));

  AddDetail(({"treiben","leben","waldbewohner","bewohner"}),BS("Im Sueden kannst nichts dergleichen erblicken."));

/* Also das duerften genug Hinweise gewesen sein, um auf den unsichtbaren Ausgang im sueden hinzuweisen */

  AddCmd(({"sueden","s"}),"gotosouth");

  AddExit("norden",FL_QS_ROOM+"mr_qs_063.lpc");  

}


int gotosouth() {

/* Textausgabe bis 1.Pruefung fertiggestellt wurde
	write(BS("\nAls Du das Trugbild erkennst, steigst Du forsch durch das angebliche Dickicht.\n"+
	      "Doch ploetzlich durchstroemt ein Gedanke Dein Gehirn:\n"+
	      "Du sollst wissen tapferer Recke, Silberland ist noch nicht bereit fuer die Rueckkehr des Rates.\n\n"+
	      "Eine unwiderstehliche Macht draengt Dich zurueck nach Norden...vielleicht solltest du ja erst spaeter "+
	      "wiederkommen.\n"));
*/

  write(BS("Als Du das Trugbild erkennst, steigst Du forsch durch das angebliche Dickicht...\n"));	
  call_out("gothrough",1);

  return 1;
}

int gothrough() {
  object obj;
  object obj2;

  if(obj=present("\no_stein",this_player()) && obj2=present("\nu_stein",this_player())) {  
    if((obj->query_read()) && (obj2->query_read())) {
      write(BS("Eine unwiederstehliche Macht erfasst Dich und Du hoerst Deine erstaunte Stimme fluestern: "+
	    "Stelle Dich der Pruefung des Charakters..."));
      this_player()->move(FL_1ST_ROOM+"mr_1st_083.lpc",M_GO,"im Dickicht","verschwindet",
                          "kommt aus dem Dickicht");
      return 1;

    } /* endif */
  } /* endif */

    write(BS("Ploetzlich durchstroemt ein Gedanke Dein Gehirn:\n Oh Unwissender, die Zeit " +
	      "fuer Dich ist noch nicht gekommen um hier weiterzuschreiten...\n"+
	      "Eine unwiederstehliche Macht draengt Dich zurueck nach Norden.\n"));
    say(this_player()->name()+" laeuft gegen das Dickicht und wird zurueckgeworfen.\n");
    return 1;	
 
}
