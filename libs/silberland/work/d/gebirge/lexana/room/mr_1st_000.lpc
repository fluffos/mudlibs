inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <language.h>

#include "/players/lexana/magierrat/magierrat.h"


// definiere Procs/Funcs
string suggestion();


// constructor
void create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:26]));

  AddDetail("lexana","Jop,jop Lexana die Gruselkoenigen hat diese Gegend hier verbrochen.");

  AddRoomMessage ( 
      ({"Eine kraeftige Windboe erschreckt Dich.\n",
	"Ploetzlich hast Du das dringende Beduernis zu Deiner Mama nach Hause zu laufen.\n"}), 60 );
}