#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";




// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine Sackgasse im Dickicht.");

  SetProp(P_INT_LONG, BS ("Du bist hier am Ende des Dickichtpfades angelangt. Ab hier "+
			       "hilft kein Roden und kein Zwaengen mehr, hier ist Schluss.\n"+
			       "Richtung Osten kannst Du zurueckgehen.\n"+
			       "Am Rand des "+
			       "Dickichts hat ein wildes Tier sein Lager augeschlagen.\n"));


  AddDetail(({"osten","o"}),BS("Von dort kommst Du gerade."));

  AddDetail(({"dickicht","pfad","dickichtpfad","ende","schluss"}),BS("Der enge Pfad der hier durch das Dickicht "+
								"fuehrt, hat nun ein Ende gefunden."));

  AddDetail(({"roden","zwaengen"}),BS("Also bei diesem Dickicht hast Du keinerlei Chancen."));

  AddDetail("chancen",BS("Vergiss es!"));

  AddDetail("richtung",BS("Die einzige Richtung in die du gehen kannst ist Osten."));

  AddDetail("rand",BS("Dort befindet sich das Lager eines wilden Tieres"));

  AddDetail("lager",BS("Das Lager eines wilden Tieres."));

  AddDetail("tier",BS("Du kannst leider nicht genau feststellen um welches Tier es sich handelt."));

// Wolf hinzufuegen
  AddItem (FL_QS_NPC+"wolf.lpc", REFRESH_DESTRUCT);

  AddExit("osten",FL_QS_ROOM+"mr_qs_044.lpc");  

}





