#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_1ST_ROOM+"mr_1st_000";

// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein unfreundliche Waldweg.");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Der Wald wird immer schlimmer und gruseliger. Nicht einmal das Sonnenlicht "+
	"traut sich mehr so richtig hier hineinzuscheinen. Ein Zombie starrt Dich mit grossen Augen an."));

  AddDetail("zombie","Als Du das Zombie naeher untersuchst entdeckst Du, dass es sich doch nur um einen Baum "+
	"handelt.");

  AddDetail("baum","Keine Angst, selbst Lars haette den Baum fuer ein Zombie gehalten.");

  AddDetail("wald","Der ist sehr gruselig hier, Du beschliesst schnell weiterzugehen.");

  AddDetail(({"sonnenlicht","licht","sonne"}),"Es traut sich gerade noch soviel Licht in diesen Wald, dass Du "+
	"nicht im Dunkeln stapfen musst.");

  AddDetail(({"augen","auge"}),"Die Augen des Zombies funkeln Dich gefaehrlich an.");

  AddExit("nordosten",FL_1ST_ROOM+"mr_1st_083.lpc");
  AddExit("sueden",FL_1ST_ROOM+"mr_1st_0a4.lpc");
 	

}

