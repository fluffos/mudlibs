#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_1ST_ROOM+"mr_1st_000";

// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein unfreundliche Kreuzung im Dickicht.");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Im Gegensatz zu dem im Norden befindlichen, romantischen Waeldchen, ist der "+
	"Wald hier eher ein großer Haufen Dickicht der unfreundlich und irgendwie sehr gefaehrlich aussieht. Weiters "+
	"kannst Du Wege nach Suedosten und Suedwesten erkennen die nicht viel Besseres verheissen."));

  AddDetail(({"norden","n"}),"Durch das Dickicht kannst Du einen freundlichen Wald erspaehen.");

  AddDetail("gegensatz","Der Gegensatz zum noerdlichen Wald koennte groesser gar nicht sein. Die Baeume und "+
	"Straeucher wirken verkrueppelt und vertrocknet, die Graeser verbrannt und auch die Lebewesen die Du "+
	"erblicken kannst wirken feindlich und unfreundlich.");

  AddDetail(({"wald","waeldchen"}),"Der Wald hier sieht nicht gerade einladend aus. Wenn man ganz exakt sein "+
	"moechte muesste man sagen der Wald sieht ausserordentlich ausladend aus. ");

  AddDetail("dickicht","Also davon gibts hier mehr als genug. Du wuerdest sogar sagen Du stehst mittendrin.");

  AddDetail("haufen","Man koennte bei diesen Unmengen von Dickicht durchaus von einem Haufen sprechen.");

  AddDetail("unmengen","Du, es ist wirklich sehr viel Dickicht.");

  AddDetail("weg","Der Weg auf dem Du Dich nun befindest ist ebenfalls sehr unfreundlich. Statt Gras und Blumen "+
	"wird der Weg nun von Dornenranken, Disteln und aehnlichem Gewaechsen ueberwuchert.");

  AddDetail("wege","Die Wege die Du hier sehen kannst, gehen nach Norden, Suedosten und Suedwesten.");

  AddDetail(({"suedwesten","sw","suedosten","so"}),"Du ueberlegst ob Du dort tatsaechlich hinwillst.");

  AddDetail("besseres","Geh nach Norden, dort ist es wirklich nett und romantisch.");

  AddDetail("baeume","Die Baeume sehen aus wie grosse Monster.");

  AddDetail("monster","Uaaaaahhhhhhhhh.....pfah hast Du dich jetzt erschreckt, aber es waren nur die Baeume.");

  AddDetail("straeucher","Die sehen aus wie die Kinder der Baeume...also wie Monsterkinder.");

  AddDetail(({"kinder","monsterkinder"}),"Naja, die sind nicht ganz so fuerchterlich.");

  AddDetail(({"graeser","gras"}),"Duerr und braun...haesslich.");

  AddDetail("lebewesen","All diese Dinge die man grauslich und unsympathisch findet also: Spinnen, Schlangen, "+
 	"Wuermer, Asseln und kleine behaarte Tiere mit roten Punkten die Purzelbaeume schlagen.");

  AddDetail("blumen","Sowas gibts hier leider nicht.");

  AddDetail(({"dornen","ranken","dornenranken"}),"Pass auf, dass dich die Dornenranken nicht stechen!");

  AddDetail("disteln","Die schauen hier besonders stachelig aus.");

  AddDetail("gewaechse","Sie sind alle sehr abstossend.");  

  AddDetail(({"spinnen","schlangen","wuermer","asseln"}),"Grauslich, gell?");

  AddDetail("tiere","Nichts besonderes, sind behaart, rot gepunktet und schlagen Purzelbaeume. Kennt doch eh jeder...");

  AddDetail(({"purzelbaume","purzelbaum"}),"Die kleinen behaarten, roten Tiere koennen die Purzebaeume "+
	"sogar rueckwaerts schlagen.");


  AddExit("norden",FL_QS_ROOM+"mr_qs_073.lpc");
  AddExit("suedwesten",FL_1ST_ROOM+"mr_1st_094.lpc");
  AddExit("suedosten",FL_1ST_ROOM+"mr_1st_092.lpc");
 	

}

