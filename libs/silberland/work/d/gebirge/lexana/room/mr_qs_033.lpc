#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";




// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Der Weg schlaengelt sich weiter in den Wald hinein.");

  SetProp(P_INT_LONG, BS ("Dieses Waldstueck ist wieder erfuellt von geschaeftigem Treiben "+
			       "und Leben. Emsige Tiere arbeiten unermuedlich daran, ihre Art im "+
			       "ewigen Kampf der natuerlichen Auslese bestehen zu lassen.\n"+
			       "Richtung Nordosten duerfte sich der Waldweg fotsetzen, weiter "+
			       "suedlich meinst Du, durch die Baeume, eine Kreuzung erspaehen "+
			       "zu koennen."));


  AddDetail(({"nordosten","no"}),BS("Dort duerfte sich der Waldweg fortsetzen."));

  AddDetail(({"sueden","s","kreuzung"}),BS("Du bist nicht sicher ob sich dort eine Kreuzung befindet. "+
				    "Schau doch einfach genau nach."));	

  AddDetail(({"waldstueck","stueck"}),BS("Hier herrscht reges Leben."));
 
  AddDetail(({"leben","treiben"}),BS("Du schaust dem regen Treiben der Tiere fasziniert zu."));

  AddDetail(({"art","arten"}),BS("Die Arten die du hier siehst sind emsig dabei zu Ueberleben."));

  AddDetail("auslese",BS("Die natuerliche Auslese, welche die Gesetze des Lebens bestimmt, "+
			    "laesst den Starken ueberleben und den Schwachen sterben."));

  AddDetail(({"starken","stark","schwachen","schwach"}),BS("Du kannst nicht eindeutig erkennen "+
								"welches der Tiere staerker oder schwaecher "+
								"ist. "));

  AddDetail(({"gesetz","gesetze"}),BS("Jaja die Gesetze des Lebens scheinen brutal."));

// ACHTUNG !!! Funktioniert die Ueberlagerung von bereits bestehenden Details?
  AddDetail(({"tiere","kampf"}),BS("Diese Tiere sind einzig damit beschaeftgt zu ueberleben."));

  AddDetail("ueberleben",BS("Das solltest du wenn moeglich auch tun."));


  AddExit("sueden",FL_QS_ROOM+"mr_qs_043.lpc");  

  AddExit("nordosten",FL_QS_ROOM+"mr_qs_022.lpc");	

}





