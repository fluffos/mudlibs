#include <properties.h>
#include <moving.h>
#include <language.h>

#include "/players/lexana/magierrat/magierrat.h"

inherit FL_1ST_ROOM+"mr_1st_000";

// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein unfreundliche Sackgasse.");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Nachdem alle Dornen, Disteln und sogar das Unkraut Dich ausgiebig gepiekt haben "+
	"erkennst Du, dass Du Dich in einer Sackgasse befindest. Irgendwie kannst Du hier die Praesenz "+
	"von etwas ueberirdischen fuehlen. Du solltest hier besser keinen Fehler machen."));

  

  AddExit("osten",FL_1ST_ROOM+"mr_1st_0a4.lpc");

}