#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";




// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine Weg fuehrt tiefer in den Wald.");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Tiefer und tiefer fuehrt dieser Weg in den Wald hinein. "+
			       "Blumen und Graeser sorgen auch hier fuer eine abwechslungsreiche "+
			       "Landschaft.\n"+
			       "Im Norden scheint eine Art Kreuzung zu sein waehrend der Weg im "+
			       "Sueden weiter in den Wald hineinfuehrt."));

  AddDetail(({"kreuzung","norden","n"}),BS("Du bist Dir nicht so sicher, aber weiter im Norden koennte "+
					  "sich eine Kreuzung befinden."));
 	
  AddDetail(({"sueden","s"}),BS("Weiter im Sueden fuehrt der Weg tiefer in den Wald hinein."));



  AddExit("norden",FL_QS_ROOM+"mr_qs_043.lpc");  

  AddExit("sueden",FL_QS_ROOM+"mr_qs_063.lpc");	

}





