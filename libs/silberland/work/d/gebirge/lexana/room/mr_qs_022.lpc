#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";




// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Der Weg schlaengelt sich tiefer durch den Wald");

  SetProp(P_INT_LONG, BS ("Der Weg fuehrt hier tiefer in den Wald hinein. "+
			       "Die Baeume stehen hier zwar etwas dichter " +
			       "trotzdem dringt noch immer mehr als genug Licht " +
			       "durch das Blaetterdach, um die Umgebung ausreichend zu "+
			       "beleuchten. Im Nordosten duerfte sich der Wald etwas lichten, "+
			       "im Suedwesten hingegen scheint der Pfad noch tiefer in diesen Wald "+
			       "einzudringen.\n"));

  AddDetail("umgebung",BS("Sie ist wunderschoen und noch immer ausreichend beleuchtet "+
			  "so dass du sie ohne Probleme geniessen kannst."));

  AddDetail(({"problem","probleme"}),BS("Du hast im Moment keine Probleme."));

  AddDetail(({"nordosten","no"}),BS("Dort duerfte sich eine Weggabelung befinden."));

  AddDetail(({"suedwesten","sw"}),BS("Hier fuehrt der Pfad tiefer in den Wald."));	


  AddExit("suedwesten",FL_QS_ROOM+"mr_qs_033.lpc");  

  AddExit("nordosten",FL_QS_ROOM+"mr_qs_011.lpc");	

}





