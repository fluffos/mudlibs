#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";

string ausgraben();		

string dickicht_desc();

int verschiebeskelett(string str);
int rodewald(string str);

int verschoben;		// wurde skelett schon verschoben ?
int gerodet;			// wurde Dickicht bereits gerodet ?
int ausgegraben;		// wurde Schimmer bereits untersucht?


// constructor
void create() {

  ::create();
  
  SetProp(P_INT_SHORT, "Ein Weg inmitten eines maechtigen Waldes.");

  SetProp(P_INT_LONG, BS ("Du befindest dich noch immer in diesem herrlichen Stueck Wald. "+
			       "Ein Baum reiht sich an den anderen um eine Landschaft "+
			       "zu schaffen, die ihresgleichen sucht.\n"+		
			       "Eine gewisse Stelle des Waldbodens scheint die Tiere hier "+
			       "besonders zu interessieren."));


  AddDetail("stelle",BS("Als Du diese Stelle genauer untersuchts kannst Du einen seltsamen, "+
			"weisslichen Schimmer entdecken."));

  AddDetail("schimmer",#'ausgraben);		

  AddDetail("zeit",BS("Die Zeit heilt alle Wunden, diese jedoch nicht mehr."));

  AddDetail("atem",BS("Du hauchst kraeftig und versuchst Deinen Atem zu erkennen. Leider klappt "+
			"das nicht, da es viel zu warm ist."));

  AddDetail(({"erde","moos"}),BS("Das Skelett wird von viel Erde und Moos bedeckt."));

  AddDetail("ruhe",BS("Das Skelett liegt hier zur letzten Ruhe gebettet."));


  AddSpecialDetail(({"skelett","ausgrabungen","ausgrabung"}),"unt_skelett");

  AddDetail(({"knochen","ueberreste","reste"}),BS("Die sehen ziemlich mitgenommen aus."));

  AddDetail(({"spuren","zaehne","krallen","zahnspuren","krallenspuren"}),BS("Die Zahn und Krallenspuren " +
								"duerften von einem wilden Tier stammen das "+
								"ziemlichen Hunger haben muss, dass es sich " +
								"sogar ueber so alte Knochen hermacht. " +
								"Als Du Deinen Blick bereits abwenden willst, "+
								"entdeckst Du eine eigenartige Schleifspur im Gras."));

  AddDetail(({"schleifspur","schleifspuren","spur"}),BS("Du kannst der Schleifspur bis zum Beginn des "+
							"westlichen Dickichts folgen."));		

  AddDetail(({"dickicht","westen"}),#'dickicht_desc);

  AddDetail("werkzeug",BS("Da Du kein Werzeug bei Dir hast, koenntes Du vielleicht ein Schwert oder eine "+
			"Kampfaxt missbrauchen um das Dickicht zu roden."));

  AddDetail(({"schwert","axt","kampfaxt"}),BS("Hast Du soetwas bei Dir?"));	


  AddDetail("gegenstand",BS("Du kannst Ihn nicht genau erkennen, vielleicht solltest du versuchen das "+
				"Skelett zu verschieben...?"));	


  AddCmd("verschiebe","verschiebeskelett");

  AddCmd("rode","rodewald");

  if (gerodet) {
    AddExit("westen",FL_QS_ROOM+"mr_qs_44.lpc");
  } /* endif */

  AddExit("sueden",FL_QS_ROOM+"mr_qs_053.lpc");  
  AddExit("norden",FL_QS_ROOM+"mr_qs_033.lpc");  

}

void reset() {

	gerodet=0;
	verschoben=0;

	RemoveExit("westen");

	::reset();	
}

int rodewald(string str) {
  
  object ob;

  notify_fail(BS("Weisst Du auch was Du roden willst?"));

  if (ob=present("schwert",TP)) {
    if (!ob->QueryProp(P_WIELDED)) {
      write(BS("Zum Roden musst Du Dein Schwert auch zuecken."));
      return 1;	
    }
  } else {
    if (ob=present("axt",TP)) {
      if (!ob->QueryProp(P_WIELDED)) {
        write(BS("Zum Roden musst Du Deine Axt auch zuecken."));
        return 1;
      }
    } else {
      write(BS("Du hast kein entsprechendes Werkzeug bei Dir."));
      return 1;
    }
  }

  if (str=="wald") {
	write(BS("Um Himmels willen, Du willst doch nicht den ganzen Wald hier roden?!\n"));
	return 1;
  } /* endif */

  if (gerodet) {
    write(BS("Als Du genauer hinsiehst entdeckst Du, das jemand hier bereits gerodet haben muss."));
    return 1;
  }

  if (str=="dickicht") {
    write(BS("Du beginnst das Dickicht zu roden. Pfuh, ganz schoen anstrengend, aber gute Arbeit, im "+
	      "Westen kannst Du jetzt weitergehen.\n"));

    say(BS(this_player()->name(WER,2)+" beginnt wie verrueckt auf das Dickicht einzuschlagen.\n"));
	
    AddExit("westen",FL_QS_ROOM+"mr_qs_044.lpc");

    gerodet=1;
    return 1;
  } /* endif */

  return 0;

}

int verschiebeskelett(string str) {

  notify_fail(BS("Du willst etwas verschieben.....supertolle Idee.....aber......was?"));
if (ausgegraben) {
  if (verschoben) {
    write(BS("Irgendjemand scheint dies bereits getan zu haben."));
    return 1;
  } else {		
    if (str=="skelett" || str=="knochen") {
	  
      say(BS(this_player()->name(WER,2)+" scheint etwas zu bewegen.\n"));	

      write(BS("Als Du das Skelett zur Seite schiebst entdeckst du darunter die Haelfte eines "+
                "bereits etwas mitgenommenen Steins. "));

      AddItem(FL_QS_OBJEKT+"o_stein.lpc");		         
 		
      verschoben=1;	
      return 1;
    } /* endif */
  } /* endif */
} else {
  write("Wie bitte?\n");
  return 1;
}
  return 0;
}

string dickicht_desc() {
  if (gerodet) {
    return BS("Das Dickicht im Westen wurde proffesionell gerodet. Gute Arbeit!\n");
  } else {
    return BS("Das Dickicht scheint hier nicht besonders wiederstandsfaehig und "+
           "bereits ein wenig abgetrocknet zu sein. Vielleicht kann man es ja mit einem "+
           "geeignetem Werkzeug roden.\n");
  } /* endif */
}

string ausgraben() {
  ausgegraben=1;
  return BS("Dir stockt der Atem als du beginnst Erde, Moos und Pflanzen zu entfernen. "+
         "Deine Ausgrabungen legen die Ueberreste eines menschlichen Skelettes frei, "+
         "das schon vor laengerer Zeit hier die letzte Ruhe gefunden zu haben scheint.\n");
}

string unt_skelett(string str) {
  if (ausgegraben) {
    if (str=="skelett") {
      return BS("Das Skelett ist zweifellos bereits seit laengerem an dieser Stelle gelegen. Spuren von " +
             "scharfen Zaehnen und Krallen duerften den Knochen aber erst kuerzlich beigebracht worden "+
             "sein. Das Skelett scheint sich irgendwie schutzend ueber einen Gegenstand zu beugen.\n");
    }
    if (str=="ausgrabungen" || str=="ausgrabung") {
      return "Die Ausgrabungen haben Dich etwas erschoepft.";
    }
  } else {
    return "Was willst Du untersuchen?\n";
  }
  
}