#include <properties.h>
#include <moving.h>
#include <language.h>

#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";


// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine Waldkreuzung");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Du befindest Dich auf einer Kreuzung die den Wald hier teilt. "+
			       "Alle Wege scheinen tiefer in den Wald hineinzufuehren, Du bist "+
			       "Dir nicht ganz sicher, welchem Du folgen sollst.\n"+
				"Neben Blumen, Bueschen und anderen Pflanzen hat sich hier auch "+
				"viel Moos angesiedelt das diesem Stueckchen Wald eine besondere "+
				"Frische verleiht."));

  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));

  AddDetail("wege","Alle Wege die Du sehen kannst fuehren tiefer in den Wald hinein.");

  AddDetail("moos",BS("Das Moos bedeckt Steine, Teile des Bodens und auch einige Baumstaemme."));

  AddDetail(({"kreuzung","wegkreuzung"}),BS("Die Kreuzung teilt hier den Wald. Wege fuehren nach Norden, "+
						 "Osten und Suedwesten."));

  AddDetail(({"stueck","stueckchen","waldstueck","waldstueckchen"}),BS("Dieses Waldstueckchen besteht "+
										"zum groessten Teil aus einer Kreuzung."));	

  AddDetail(({"stein","steine"}),BS("Die Steine sind von Moos ueberwachsen."));


   AddExit("norden",FL_QS_ROOM+"mr_qs_001.lpc");  
   AddExit("osten",FL_QS_ROOM+"mr_qs_010.lpc");
   AddExit("suedwesten",FL_QS_ROOM+"mr_qs_022.lpc");	

}
