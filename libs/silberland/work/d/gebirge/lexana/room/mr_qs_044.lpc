#include <properties.h>
#include <moving.h>
#include <language.h>


#include "/players/lexana/magierrat/magierrat.h"

inherit FL_QS_ROOM+"mr_qs_000";




// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein Weg durch das Dickicht.");

  SetProp(P_INT_LONG, BS ("Der Weg fuehrt hier tiefer in das Dickicht hinein. "+
			       "Da das Dickicht gen Westen zu wesentlich dichter wird, "+
			       "beginnst Du Dich langsam zu fragen was Dich dort "+
			       "wohl erwarten wird.\n"));
 
  AddDetail("dickicht",BS("Du bist von Dickicht umgeben. Ausser zwei schmalen Durchgaengen "+
			    "im Westen bzw. Osten ist es Dir unmoeglich das Dickicht weiter zu erforschen.\n"));

  AddDetail(({"durchgang","durchgaenge"}),BS("Die Durchgaenge sind hier recht eng. Du wirst Muehe haben "+
					      "dich hier durchzuzwaengen."));
 	
  AddDetail("muehe",BS("Naja, so schlimm wird's schon nicht werden."));

  AddDetail(({"osten","o"}),BS("Dort scheint das Dickicht zu enden."));

  AddDetail(({"westen","w"}),BS("Das Dickicht wird dort wesentlich dichter."));	



  AddExit("westen",FL_QS_ROOM+"mr_qs_045.lpc");  

  AddExit("osten",FL_QS_ROOM+"mr_qs_043.lpc");	

}





