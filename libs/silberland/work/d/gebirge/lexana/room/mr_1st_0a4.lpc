#include <properties.h>
#include <moving.h>
#include <language.h>

#include "/players/lexana/magierrat/magierrat.h"

inherit FL_1ST_ROOM+"mr_1st_000";

// constructor
void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein unfreundliche Kreuzung.");

/* Ok, Beginn der normalen Raumbeschreibungen */

  SetProp(P_INT_LONG, BS ("Hier vervielfaeltigt sich das Gruseln. Du stehst naemlich inmitten einer "+
	"kleinen Waldkreuzung die Dir die Wahl zwischen Dornen, Disteln und Unkraut im Westen, "+
	"Dornen, Disteln und Unkraut um Sueden und Dornen, Disteln und Unkraut im Norden laesst. "+
	"Ach, wie ist das Leben doch abwechslungsreich!"));

  AddDetail(({"gruseln","grusel"}),"Der ganze Wald hier ist ausserst gruselig.");

  AddDetail("wald","Der Wald ist hier wunderschoen, friedlich, freundlich...wenn da nicht die Dornen, "
	"Disteln, das Unkraut die gruseligen Tiere und die komische Gaensehaut auf Deinem Ruecken waere.");

  AddDetail(({"waldkreuzung","kreuzung"}),"Die Kreuzung hat den Vorteil, dass Du jetzt selbst waehlen "+
	"kannst welche der Dornen und Disteln Dich als naechstes pieken darf. Irgendwie fuehlst Du Dich "+
	"jetzt ein wenig gluecklicher.");

  AddDetail(({"norden","n","westen","w","sueden","s"}),"Dort gibt es Dornen, Disteln und Unkraut. Wenn Du "+
	"besonderes Glueck hast, ist dort vielleicht auch noch ein grosses unfreundliches Monster das Dich "+
	"zum Nachtisch schnell mal schnabuliert.");

  AddDetail(({"distel","disteln","dornen","unkraut"}),"Du hast absolut keine Lust mehr diese Dinge zu untersuchen.");

  AddDetail("leben","Das hast Du Dir immer ein wenig schoener vorgestellt.");

  AddDetail("vorteil","Immerhin lassen Dir das Unkraut, die Dornen und Disteln die Wahl...");

  AddDetail("gaensehaut","Dein Ruecken ist voll davon.");

  AddDetail("ruecken","Vor lauter Gaensehaut kannst Du den kaum erkennen.");

  AddDetail("tiere","Das gruseligste daran ist, dass es hier gar keine gibt.");

  AddExit("norden",FL_1ST_ROOM+"mr_1st_094.lpc");
  AddExit("sueden",FL_1ST_ROOM+"mr_1st_0b4.lpc");
  AddExit("westen",FL_1ST_ROOM+"mr_1st_0a5.lpc");

}