#pragma strong_types

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create() 
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Geldfresser");
  SetProp(P_LONG, "Ein unersaettlicher Geldfresser.\n");
  SetProp(P_NAME, "Geldfresser");
  SetProp(P_GENDER, MALE);
  SetProp(P_REJECT, ({ REJECT_DROP, "wech"}) );
  ob = clone_object("/obj/money");
  ob->SetProp(P_AMOUNT, 1000);
  ob->move(this_object());
  AddId( ({"fresser", "geldfresser"}) );
//  RegisterGive("GetSomething", 0);
}

int GetSomething(object ob) 
{
  call_out("eat_it", 4+random(4), ob);
  return 1;
}

void give_notify(object ob) 
{
  sequencer::give_notify(ob);
  npc::give_notify(ob);
}

void eat_it(object ob)
{
  say("Der Geldfresser verspeist " + ob->name(WEN,2)+ ".\n");
  if (!ob->remove(0)) destruct(ob);
}
                     