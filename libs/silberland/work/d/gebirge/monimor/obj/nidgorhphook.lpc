
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../moni.h"

obj owner = find_living("nidgor");

create()
{
  if (!is_clone(this_object())) return;
	::create();


  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  SetProp(P_INVIS, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_GENDER,MALE);
  AddId("\nnidgorhphook");

  owner->AddHpHook(ME);

}

NotifyHpChange()
{
  int hp, maxHp;

  hp = owner->QueryProp(P_HP);
  maxHp = owner->QueryProp(P_MAX_HP);
  
  if ((hp<=0) || (!living(owner)))
    {
      return;
    }
  if(hp < lastHP)
    hp = 2*(lastHP - hp) + hp;
    maxHp = 2*(lastHP - hp) + maxHp;
    tell_room(environment(this_player()),"Nidgor hat "+hp+" ("+maxHp
    +") LP.\n");
    lastHP = hp;
}

