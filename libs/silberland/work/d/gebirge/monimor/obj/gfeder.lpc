inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

   SetProp(P_SHORT, "Eine Greifenfeder");
   SetProp(P_NAME, "Greifenfeder");
   SetProp(P_LONG,"Die Greifenfeder ist ein prachtvolles Schmuckstueck. "
+"Sie glaenzt golden und hat einen leichten Rotschimmer. Du kannst "
+"Sie anziehen.\n");
   SetProp(P_GENDER, FEMALE);
   AddId(({"feder","greifenfeder"}));
   SetProp(P_ARMOUR_TYPE, AT_HELMET);
   SetProp(P_AC, 1);
   SetProp(P_WEIGHT, 5);
   SetProp(P_VALUE, 200);
   SetProp(P_MATERIAL,MAT_MISC);
}
