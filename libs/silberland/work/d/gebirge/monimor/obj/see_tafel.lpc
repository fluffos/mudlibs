// Schwimm_Dummy, in reger Zusammenarbeit mit Nostromo entstanden 
//
// Monimor, Mai 1997

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../moni.h"



create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Eine Tafel");
  SetProp(P_LONG,"Eine alte, von Wuermern zerfressene Tafel. Etwas steht auf "
    +"ihr geschrieben.\n");
  SetProp(P_WEIGHT,3000);
  SetProp(P_NAME,"Tafel");
  SetProp(P_NOGET,1);
  SetProp(P_NOBUY,1);
  AddReadDetail("tafel","Dies ist der See des Ruesselwurms. Sei Dir "
    +"der Gefahr hier stets bewusst, denn der Wurm hortet hier seine Beute. Diebstahl "
    +"wuerde er sowohl nicht gutheissen, als auch unbestraft lassen. Wenn Du im See also "
    +"etwas finden solltest, so lasse die Finger davon, dann kann Dir nichts passieren.\n");
  SetProp(P_GENDER,FEMALE);
  AddId("tafel");
}





