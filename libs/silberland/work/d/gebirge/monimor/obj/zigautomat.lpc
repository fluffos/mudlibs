//
//   Ein Zigarettenautomat, aus dem man sich ein Zigarettenpackerl
//   holen kann
//
// Project: Die Seele Nalfas
//
//=========================================================================


inherit "std/thing";

#include "/secure/wizlevels.h"
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../def.h"

#define MONEY this_player()->QueryMoney()

#define COST 40

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_LONG,
    "Das ist ein Zigarettenautomat der vereinigten Tabakwerke Monimors. "
    "Du siehst einen Knopf an der Frontseite. Darunter ist ein Schild angebracht."
  );
  SetProp(P_SHORT,"Ein Zigarettenautomat");
  AddId(({"automat","zigarettenautomat"}));
  SetProp(P_INFO,"TOD DURCH LUNGENKREBS KANN IHRER GESUNDHEIT ERHEBLICH SCHADEN.\n");
  SetProp(P_NAME,"Zigarettenautomat");
  SetProp(P_WEIGHT,3000);
  SetProp(P_NOBUY,1);
  SetProp(P_NOGET,1);
  SetProp(P_GENDER,MALE);
  AddDetail(({"knopf", "frontseite" }),
    "Den Knopf an der Frontseite kannst Du druecken."
  );
  AddDetail("schild",
    "Du kannst es lesen."
  );
  AddDetail("tabakwerke",
    "Den Tabakwerken gehoert dieser Automat."
  );
  AddReadDetail("schild",
    "Eine Packung Zigaretten kostet 40 Muenzen."
  );

  AddCmd(({"druecke","drueck"}),"drueck");
  }

drueck(str)
{
  object ob;
  if (!stringp(str) || str=="")
    return(notify_fail("WAS willst Du druecken?\n"),0);
  if (str=="knopf")
  {
    if (IS_WIZARD(this_player()))
    {
      ob=clone_object(KOBJ "pack" );
      ob->move(TP);
      write("Du drueckst den Knopf und erhaeltst eine Packung Zigaretten.\n");
      ENV(TO)->Message(BS(TP->NAME(WER)+" drueckt einen Knopf auf dem Zigarettenautomat."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return 1;
    }
    else
    {
      if (COST>MONEY)
      {
        write("Du kannst Dir keine Zigaretten mehr leisten.\n");
        return 1;
      }
      else
      {
        ob=clone_object(KOBJ "pack");
        write(BS("Du wirfst 40 Muenzen in den Automaten, drueckst den Knopf "
                +"und erhaeltst eine Packung Zigaretten."));
        ENV(TO)->Message(BS(TP->name(WER)+" wirft "+COST+" Muenzen in den Automaten, "
                +"drueckt den Knopf und erhaelt eine Packung Zigaretten."),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
        {
          write(BS("Du kannst die Zigaretten nicht mehr tragen und laesst sie "
               +"fallen."));
          ENV(TO)->Message(BS(TP->name(WER)+" kann die Zigaretten leider nicht mehr tragen "
                 +"und laesst sie fallen."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
          ob->move(TO,M_PUT);
        }
        TP->AddMoney(-COST);
        return 1;
      }
    }
  }

  return(notify_fail("DAS kannst Du nicht druecken.\n"),0);
}
