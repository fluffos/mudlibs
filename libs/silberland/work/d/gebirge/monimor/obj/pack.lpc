inherit "std/thing";  
   
#include "/secure/wizlevels.h"
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../def.h"

int number=20;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_LONG,
    "Dies ist ein Zigarettenpackerl der Marke Ingerimm aus den "
    "vereinigten Tabakwerken Monimors. Auf der Packung siehst Du "
    "einen kunstvoll geschmiedeten Kampfhammer, als Symbol des Kampfes "
    "und der Schmiedkunst. Mit <nimm zigarette aus packung> kannst Du "
    "Dir eine Zigarette nehmen. RAUCHEN KANN IHRE GESUNDHEIT GEFAEHRDEN.");

  SetProp(P_NAME,"Zigarettenpackerl");
  AddId(({"packerl","packung","zigarettenpackerl","zigarettenpackung"}));
  SetProp(P_WEIGHT,5+number*3);
  SetProp(P_GENDER,NEUTER);
  SetProp(P_VALUE,number);
  AddCmd("nimm","nimm");
}

nimm(str)
{
  object ob;
  if(!stringp(str) || str=="")
    return (notify_fail("WAS willst Du WORAUS nehmen?"),0);
  if (str == "zigarette aus packung" || str == "zigarette aus packerl"){
    if (number > 0){
      number--;
      ob=clone_object(KOBJ "zigarette");
      ob->move(TP);
      write("Du nimmst eine Zigarette aus dem Packerl.\n");
      ENV(TP)->Message(BS(TP->name(WER)+" nimmt eine Zigarette aus einem Packerl."),
                       MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return 1;
    }
    else
      return(notify_fail("Das Packerl ist leer.\n"),0);
  }
  else
    return(notify_fail("DAS kannst Du nicht nehmen.\n"),0);
}

string _query_short()
{
  string s;
  
  switch(number)
  {
    case 1: 
      s = "Ein Zigarettenpackerl mit einer Zigarette";
      break;
    case 0:
      s = "Ein leeres Zigarettenpackerl";
      break;
    default:
      s = "Ein Zigarettenpackerl mit "+number+" Zigaretten";
      break;
  }
  
  return s;
}

int _query_value()
{
  return (number||1); // Damit mans noch verkaufen kann
}

int _query_weight()
{
  return 5+number*3;
}