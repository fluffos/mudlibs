#include "../def.h"

inherit "std/weapon";
#include <combat.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein abgebrochener Flaschenhals");
  SetProp(P_LONG,
    "Das ist ein abgebrochener Flaschenhals von einer Bierflasche. Geschickt "
    "eingesetzt kann man jemanden damit sicher verletzen.");
  SetProp(P_INFO, "Der Flaschenhals ist von einer Flasche Moni-Bier.");
  SetProp(P_NAME, "Flaschenhals");
  SetProp(P_GENDER, MALE);
  AddId( ({"hals", "flaschenhals"}) );

  SetProp(P_WEAPON_TYPE, WT_MISC );
  SetProp(P_WC, 100);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_GLASS );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL,1);

}
