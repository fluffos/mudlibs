///   Der Stummel zur Zigarette
///   Er ist schon ausgedaempft und liegt nur so rum,
///   der Richtigkeit halber.
///
///
///
///
///
///
///
///
///
///Monimor
///Maerz 1997


inherit "std/thing";  
   
#include "/secure/wizlevels.h"
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../moni.h"

object besitzer=TPN;


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT,"Ein Zigarettenstummel von "+CAP(besitzer));
  SetProp(P_LONG,bs("Dieser Zigarettenstummel glimmt nicht mehr. Er stammt von einer aus Monimors vereinigten Tabakwerken stammenden Zigarette ab. Jemand hat wohl diese Zigarette ausgedaempft."));
  SetProp(P_NAME,"Zigarettenstummel");
  AddId(({"stummel","zigarettenstummel"}));
  SetProp(P_INFO,"TOD teilt dir mit: RAUCHEN GEFAEHRDET DIE GESUNDHEIT, HARHAR.\n");
  SetProp(P_WEIGHT,2);
  SetProp(P_GENDER,MALE);
  AddCmd(({"rauche","rauch","zuende","zuend"}),"rauch");
}

rauch(str)
{
  if(!stringp(str) || str=="")
    return (notify_fail("WAS willst Du rauchen?\n"),0);
  if(str=="stummel" || str=="zigarettenstummel" || str=="stummel an" || str=="zigarettenstummel an"){
    write("Du willst doch nicht etwas Gebrauchtes rauchen, was schon am Boden lag!\n");
    return 1;
  }
  else
    return(notify_fail("DAS kannst Du nicht rauchen.\n"),0);
}

reset()
{
  object ob;
  ob=MENV;
  if (ob && !interactive(ob))
  {
    if (ob->QueryProp(P_EXITS))
       tell_room (ob, "Ein Zigarettenstummel loest sich auf.\n");
    remove();
  }
}
