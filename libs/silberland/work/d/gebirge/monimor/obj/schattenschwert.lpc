inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

SetProp(P_SHORT,"Ein Schattenschwert");
SetProp(P_LONG,break_string("Das Schattenschwert ist ein schoen gefertigtes Schwert, das seinem Namen alle Ehre macht, denn es hat keinen Schatten, weil es scheinbar selbst der Schatten von einem Schwert ist.",78));
  SetProp(P_NAME,"Schattenschwert");
  SetProp(P_GENDER,NEUTER);
  AddId(({"schwert","schattenschwert"}));

  SetProp(P_VALUE,1300);
  SetProp(P_WEIGHT, 800);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_WC,150);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,MAT_MAGIC);
}
