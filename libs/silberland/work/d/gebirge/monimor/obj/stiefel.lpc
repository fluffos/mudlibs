inherit "std/armour";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"stiefel","zwergenstiefel"}));
  SetProp(P_SHORT,"Ein Paar Zwergenstiefel");
  SetProp(P_LONG,
    "Die Stiefel sind aus weichem, ausgeleiertem "
	"Leder. Sie sind mit Hanf gebunden und die Sohle ist durch "
	"einige Naehte verstaerkt. Ein kleines Fuchspelzfellbueschel "
	"umkranzt das obere Ende der Stiefel.");
  SetProp(P_NAME,"Zwergenstiefel");
  AddAdjective(({"ausgeleiert","ausgeleierte","weich","weiche"}));
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT,200);
  SetProp(P_VALUE,300);
  SetProp(P_ARMOUR_TYPE,AT_BOOT);
  SetProp(P_AC,3);
  }
