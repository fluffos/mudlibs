inherit "std/armour";

#include <combat.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId("umhang");
  AddAdjective(({"wallender","wallend","wallenden"}));
  SetProp(P_SHORT,"Ein wallender Umhang");
  SetProp(P_LONG,
    "Das ist der traditionelle Umhang der Hueter der Seelen. Er ist "
    "sehr leicht und bequem zu tragen. Er ist mit kunstvollen "
    "Ornamenten verziert.");
  SetProp(P_NAME,"Umhang");
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT,100);
  SetProp(P_VALUE,600);
  SetProp(P_ARMOUR_TYPE,AT_CLOAK);
  SetProp(P_AC,5);
}
