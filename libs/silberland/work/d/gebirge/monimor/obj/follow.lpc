inherit "std/thing";  
   
#include "/secure/wizlevels.h"
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../moni.h"

object meister,slave;


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "");
  AddId("follow");
}

init()
{
  meister=TP;
  slave=clone_object(NPC("sklave"));
  slave->move(environment(environment(this_object())), M_GO);
  slave->AddMstr(meister->QueryProp(P_NAME));
  meister->AddPursuer(slave);
}

