inherit "std/thing";  

#include <combat.h>
#include <language.h>
#include "/secure/wizlevels.h"
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../moni.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Wurfgeschoss");
  SetProp(P_LONG,bs("Dieses Wurfgeschoss wirft riesige Steine auf einen Gegner. Es ist ein beweglicher Katapult. Es ist so gross wie ein Zwerg und wird immer von einem Sklaven gezogen. Das Geschoss wird durch ein Lederband Gespannt und wenn man das Band mit einem Hebel frei gibt, federt der Wurfarm nach vorne und wirft den Stein. Mit <feuer> kannst Du das Geschoss abfeuern."));
  SetProp(P_NAME,"Wurfgeschoss");
  AddId(({"geschoss","wurfgeschoss","katapult"}));
  SetProp(P_WEIGHT,100000);
  SetProp(P_SIZE,130);
  SetProp(P_GENDER,NEUTER);
  SetProp(P_VALUE,3000);
  SetProp(P_NOBUY,1);
  AddCmd(({"feuer","feuere"}),"feuer");
  SetProp(P_NOGET,1);
  SetProp(P_COMBATCMDS,(["feuer":
                         ([C_MIN:0,C_AVG:20,C_MAX:35,
                           C_DTYPES:({DT_BLUDGEON,DT_SLASH})
                         ])
                       ])
         );
}

feuer(string str)
{
  object victim,taeter;
  if(!stringp(str) || str=="")
    return (notify_fail("Syntax:    feuer <gegner>\n"),0);
//  if(!id(str))
//    return(notify_fail("Darauf kannst Du nicht feuern.\n"),0);
//  else {
//    victim=str;
//    write("Du feuerst auf "+str+".\n");
//    say("Das Geschoss feuert auf "+str+".\n");
//    return 1;
//  }
}

    
  
