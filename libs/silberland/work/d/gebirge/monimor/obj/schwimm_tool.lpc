// Schwimm_Dummy, in reger Zusammenarbeit mit Nostromo entstanden 
//
// Monimor, Mai 1997

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../moni.h"


string env;
int i=1;

create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  SetProp(P_INVIS, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_GENDER,MALE);
  SetProp(P_KILL_NAME,"Der Ertrinkungstod");
  AddId  (({"\nswim_dummy"}));
  AddCmd (({"wo"}), "where");
}

where()
{
 write("Aktuelle Positiion:\n");
 write(env);
 write("\n ");
 return 1;
}

string QueryFrom()
{
  return env;
}

void SetFrom(string str)
{
  env=str;
}

init()
{
  ::init();
  call_out("drown",0);
}

void drown()
{
  int weight;
  weight=TP->QueryProp(P_TOTAL_WEIGHT)/1000-TP->QueryProp(P_WEIGHT)/1000;
  if(weight>=30)
  {
    TP->die(0);
  }
  else
  {
    call_out("schleife",60+2*random(20)-weight);
  }
}

void schleife()
{
  switch(i){
    case 1 : {
      write("Du wirst langsam muede. Du schleppst viel mit Dir herum beim Schwimmen.\n");
      i=i+1;
      break;}
    case 2 : {
      write("Du solltest daran denken zurueck zu schwimmen. Du koenntest untergehen.\n");
      i=i+1;
      break;}
    case 3 : {
      write("Lass lieber alles fallen, oder schwimm wie der Teufel zurueck!\n");
      i=i+1;
      break;}
    case 4 : {
      write(bs("Dir wird Dein Gepaeck zu schwer, Du strampelst noch einmal "
        "verzwifelt, doch gehst schliesslich unter und ertrinkst."));
      say(TPN+" strampelt um sein Leben und geht unter.\n");
      TP->die(0);
      remove();
      break;
    }
  }
  call_out("drown",0);
}
