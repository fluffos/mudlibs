inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"ruestung","schattenruestung"}));
  SetProp(P_SHORT,"Eine Schattenruestung");
  SetProp(P_LONG,
    "Du kannst durch die Schattenruestung hindurchsehen. Du denkst, dass "
    "daher wohl auch der Name fuer die Ruestung stammt. Du siehst "
    "schoene Verzierungen im Brustbereich, sonst ist die Ruestung frei "
    "von Verschoenerungsversuchen geblieben.");

  SetProp(P_NAME,"Schattenruestung");
  SetProp(P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 700);
  SetProp(P_VALUE,800);

   SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
   SetProp (P_AC, 15);

   SetProp(P_MATERIAL,MAT_MAGIC);

   AddDetail(({"verzierung","verzierungen"}), 
     "Sie zeigen das Wappen einer lange ausgestorbenen Gilde: "
     "der Schattenkaempfer.");
}

