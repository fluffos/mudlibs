inherit "std/armour";

#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Das dunkle Amulett");
  SetProp(P_LONG,
    "Das dunkle Amulett ist ein wunderschoen verziertes Stueck. Es hat "
    "Schnoerkel, die an Schlangen und Wuermer erinnern, doch diese beissen "
    "sich ins Gesicht und die Schwaenze sind ineinander verwickelt. Insgesamt "
    "gesehen scheint es ein Kunstwerk aus alten Tagen zu sein.");

  AddDetail("stueck",
    "Dieses Amulett hat keine Farbe. Es ist nur dunkel. Es ist schoen verziert."
  );
  AddDetail(({"schnoerkel","schlangen","wuermer"}),
    "Die Schnoerkel erinnern an Schlangen, die sich ins Gesicht beissen. Die "
    "Augen der Schlangen funkeln rot."
  );
  AddDetail("gesicht",
    "Die Schlangen beissen sich ins Gesicht. Es sieht schmerzverzerrt aus, "
    "das eine wie das andere. Die Augen beider funkeln rot."
  );
  AddDetail(({"auge","aug","augen"}),
    "Die Augen beider Schlangen funkeln rot. Sie strahlen eine seltsame Energie aus."
  );
  AddDetail("energie",
    "Dieses Amulett hat vermutlich magische Kraefte."
  );
  SetProp(P_INFO,
    BS("Das Amulett ist aus einem magischen Erz gefertigt. Es hat auch magische Kraft, "
      +"vermutlich kann es das Raumkontinuum stoeren."));

  AddId(({"amulett","dunkelamulett"}));
  SetProp(P_NAME,"Dunkelamulett");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_WEIGHT,20);
  SetProp(P_ARMOUR_TYPE,AT_AMULET);
  SetProp(P_AC,3);
  SetProp(P_MATERIAL,MAT_MAGIC);
}
