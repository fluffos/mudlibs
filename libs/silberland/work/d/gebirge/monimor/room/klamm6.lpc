inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In einer engen Spalte.");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer engen Spalte, die nach Nordwesten weiterfuehrt "
    "und nach Osten in eine Kreuzung muendet. Hoffentlich hast Du keine "
    "Platzangst, denn die Felswaende ruecken Dir sprichwoertlich auf den Leib. "
    "Der Nebel ist seltsamerweise etwas lichter hier, vielleicht kommt das auch "
    "davon, dass eine steife Brise hier durchweht. Trotzdem ist Dir nicht kalt.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15,ENV_TERRAIN:TT_MOUNTAIN]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "wind" }),
    "Es weht eine steife Brise."
  );
  AddDetail( ({ "abenteurer", "seele", "seelen" }),
    "Diese Brise koennten umherstreifende Seelen verstorbener Abenteurer sein."
  );
  AddDetail( ({ "himmel" }),
    "Du kannst den Himmel erahnen, da der Nebel hier nicht so dicht ist. "
    "Allerdings sind die Waende etwas zu hoch, um den Himmel wirklich "
    "gut zu erkennen."
  );
  AddDetail( ({ "nebel" }),
    "Der Nebel ist hier nicht so dicht. Eine steife Brise weht hier durch."
  );
  AddDetail( ({ "leib", "koerper" }),
    "Das ist Dein Koerper."
  );
  AddDetail( ({ "gebiet", "klamm" }),
    "Du bist in der Klamm der Seelen."
  );
  AddDetail( ({ "ritze", "ritzen", "fuge", "fugen" }),
    "Der Fels ist absolut blank, Du kannst sowas beim besten Willen nicht erkennen."
  );
  AddDetail( ({ "willen" }),
    "Du kannst Dich noch so sehr anstrengen. Finden wirst Du hier nichts."
  );
  AddDetail( ({ "fels" }),
    "Der Fels ist blitzblank, keine Ritzen, keine Fugen, nichts."
  );
  AddDetail( ({ "kreuzung" }),
    "Du kannst die Kreuzung im Osten erkennen."
  );
  AddDetail( ({ "stein", "steine" }),
    "Du siehst keine Steine, der Weg ist absolut blank, wie poliert."
  );
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt nach Osten zur Kreuzung und nach Nordwesten weiter der "
    "Spalte entlang. Du siehst keinen einzigen Stein oder aehnliches auf dem Weg."
  );
  AddDetail( ({ "relief" }),
    "Du kannst kein Relief erkennen."
  );
  AddDetail( ({ "wand", "waende", "boden", "felswaende", "felswand" }),
    "Der Boden und auch die Waende dieser Spalte bestehen aus blankem Fels. "
    "Du kannst kein Relief erkennen."
  );
  AddDetail( ({ "spalte" }),
    "Du stehst in einer engen Spalte, die von Osten nach Nordwesten fuehrt."
  );
  AddDetail(({"verhaeltnis","verhaeltnisse","witterungsverhaeltnis",
              "witterungsverhaeltnisse"}),
    "Trotz der steifen Brise ist es nicht kalt. Das koennten die Seelen "
    "verstorbener Abenteurer sein, die Dich hier warm umspuelen."
  );
  AddDetail("brise",
    "Du wunderst Dich, warum Dir bei diesen Witterungsverhaeltnissen nicht "
    "kalt ist. Hoffentlich ist nicht das der Grund, woher die Klamm ihren "
    "Namen hat: Von den verlorenen Seelen armer Abenteurer, die wie Du "
    "dieses Gebiet durchstreiften."
  );
  AddDetail( ({ "grund", "namen" }),
    "Der Sage nach sind die Seelen der hier verstorbenen Abenteurer verflucht. "
    "Angeblich hat die Klamm daher ihren Namen."
  );
  AddDetail( ({ "platzangst" }),
    "Es ist extrem eng hier."
  );
  AddDetail( ({ "sage" }),
    "Der Sage nach ist die Klamm so entstanden, dass der Urgrossvater Monimors, "
    "ein grosser und maechtiger Gott, vor lauter Wut auf die Menschen mit seiner "
    "Axt den Boden spaltete und die Seelen der Menschen verfluchte."
  );
  AddDetail( ({ "axt", "erdspalte" }),
    "Die Erdspalte sieht wie von einer riesigen von goettlicher Hand gefuehrten "
    "Axt gezogen aus."
  );
  AddDetail( ({ "hand", "gott" }),
    "Der Sage nach fuehrte Monimors Urgrossvater diese Axt."
  );
  AddDetail( ({ "menschen", "seelen", "wut", "urgrossvater" }),
    "Vor lauter Wut auf die Menschen lies Monimors Urgrossvater seine Axt den "
    "Boden spalten und verfluchte alle Seelen der Menschen, die hier sterben "
    "sollten, auf ewig hier gefangen zu sein."
  );
  AddDetail("nase",
    "Das ist wohl Deine eigene Nase."
  );

  AddSound(({DEFAULT_SOUND,"wind","brise"}),
    "Du hoerst den Wind durch die Klamm ziehen."
  );

  AddSmell(DEFAULT_SMELL,
    "Der Nebel riecht schwefelartig. Es faellt Dir wieder leichter "
    "hier zu atmen."
  );
  AddSmell("schwefel",
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("nebel", 
    "Der Nebel riecht nach Schwefel."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig. Das ist wohl der Nebel."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("osten", "./klamm4");
  AddExit("nordwesten", "./klamm8");
}
