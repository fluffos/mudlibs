inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Der Weg zum Haus" );
  SetProp(P_INT_LONG,
    "Du befindest Dich auf dem Weg zu einem Haus, das Du im Suedosten siehst. "
    "Der Weg ist mit feinen Kieselsteinen bestreut worden, sodass Dir das "
    "Gehen hier viel leichter faellt. Rings um Dich siehst Du nur blanken "
    "Fels. Ein deprimierender Anblick.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,0);

  AddDetail( ({ "farbe" }),
    "Du kannst eigentlich keine Farbe erkennen. Es ist ... dunkel."
  );
  AddDetail( ({ "stein" }),
    "Hier scheint alles total glatt zu sein, ausserdem ist es Dir "
    "unmoeglich, die Farbe zu identifizieren."
  );
  AddDetail( ({ "anblick", "eindruck" }),
    "Rund um Dich nur Fels, das gibt einen erdrueckenden Eindruck."
  );
  AddDetail( ({ "wand", "waende","felswand","felswaende" }),
    "Die Felswaende sind total glatt."
  );
  AddDetail("boden",
    "Der Boden besteht aus Fels. Auf ihm siehst Du einen Weg."
  );
  AddDetail("himmel",
    "Der Nebel ist so dicht, dass Du den Himmel nicht mehr siehst."
  );
  AddDetail("nebel",
    "Der Nebel ist sehr dicht hier."
  );
  AddDetail( ({ "fels" }),
    "Die Felswaende bestehen aus blankem Stein. Du siehst weder "
    "Furchen, noch Spalten, seltsam, aber die Waende sind total glatt."
  );
  AddDetail( ({ "kristall", "kristalle", "quarzkristalle", "quarzkristall" }),
    "Sowas kennst Du doch, doch gerade das ist seltsam, weil Dir auf "
    "dem bisherigen Weg kein einziger Stein untergekommen ist, der "
    "Dir bekannt gewesen waere."
  );
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt zu einem kleinen Haus. Er ist mit Kieselsteinen ausgestreut."
  );
  AddDetail( ({ "garten" }),
    "Der Garten sieht sehr ungepflegt aus. Es ist schwer zu sagen was Unkraut "
    "und was erwuenschte Pflanzen sind. Offensichtlich war schon lange niemand "
    "da um den Garten zu pflegen."
  );
  AddDetail( ({ "haus" }),
    "Du siehst ein Haus vor Dir. Es ist sehr klein, ungeschmueckt und "
    "der Garten sieht verwahrlost aus. Wer mag hier wohl wohnen?"
  );
  AddDetail( ({"steine","kieselsteine"}),
    "Die Steine bestehen aus durchsichtigen Quarzkristallen. Jemand muss "
    "sich hier grosse Muehe gemacht haben."
  );
  AddDetail("schwefel",
    "Du kannst ihn nicht sehen, aber riechen."
  );
  AddDetail( ({ "furchen", "spalten" }),
    "So sehr Du Dich auch bemuehst, Du findest keine Furchen und Spalten."
  );
  AddDetail( ({ "muehe" }),
    "Hier hat sich Jemand die Muehe gemacht den Weg mit kleinen Kieselsteinen "
    "zu bestreuen."
  );
  AddDetail( ({ "jemand" }),
    "Wer das wohl war?"
  );
  AddDetail( ({ "unkraut", "pflanzen" }),
    "Schwer zu erkennen was was ist."
  );

  AddSmell(({DEFAULT_SMELL,"nebel"}),
    "Der Nebel riecht schwefelig."
  );
  AddSmell("schwefel",
    "Schwefel stinkt erbaermlich."
  );
  AddSound(({DEFAULT_SOUND,"steine","stein","kieselstein","kieselsteine", "schritte"}),
    "Kieselsteine knirschen unter Deinen Schritten."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("suedosten", "./klammhaus" );
  AddExit("westen", "./klamm1" );

}
