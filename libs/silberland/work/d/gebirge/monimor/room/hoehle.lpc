inherit "std/room";

#include "../def.h"

#define ENTERLOG "/d/gebirge/monimor/log/hoehle_enter"

status fackelfound;
status spiegel;
nosave mapping entered = ([]);

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Eine dunkle Hoehle" );
  SetProp(P_INT_LONG,
    "Du bist in einer dunklen Hoehle. "
	"Du kannst sie verlassen, oder auch nach Suedwesten weiter in sie "
	"vordringen. Die Waende bestehen aus dem selben Material, wie die "
	"Felswaende ausserhalb der Hoehle (logisch, oder?). Nur Du siehst, "
	"dass sie nicht so regelmaessig sind. Da sind Spalten, Ritzen "
	"und auch kleine Fugen. Der Boden allerdings ist wiederum komplett "
	"glatt. Du denkst, dass die Hoehle vermutlich kuenstlich angelegt "
	"wurde.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12,ENV_TERRAIN:TT_CAVE]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "fackel", "fackeln" }), 
    "Hier sind keine Fackeln. Vielleicht ist die Hoehle unbewohnt?"
  );
  AddDetail( ({ "waerme" }), 
    "Die Hoehlenwand strahlt etwas Waerme ab. Es ist nicht kalt hier."
  );
  AddDetail( ({ "material","gestein" }), 
    "Das Material, aus dem die Waende hier sind, ist ein seltsam dunkles "
    "Gestein. Es strahlt etwas Waerme ab, sodass Dir nicht kalt ist."
  );
  AddDetail( ({ "hoehle" }), 
    "Du bist in einer niedrigen Hoehle. Sie ist vermutlich von Zwergen "
    "erschaffen. Es ist sehr dunkel hier herinnen, wenn jemand hier wohnen "
    "wuerde, waeren hier wohl Fackeln."
  );
  AddDetail( ({ "decke" }), 
    "Die Decke ist nicht sehr hoch. Sie ist gerade so hoch, dass ein Zwerg "
    "bequem aufrecht stehen kann. Vermutlich haben Zwerge die Hoehle erschaffen."
  );
  AddDetail( ({ "zwerg", "zwerge", "hoch" }), 
    "Ein Zwerg ist ca. 1.20 hoch. Sie sind geschickte Tunnelgraeber und natuerlich "
    "waere es Verschwendung die Tunnel hoeher zu machen."
  );
  AddDetail( ({ "tunnelgraeber", "graeber" }), 
    "Zwerge koennen nicht nur Tunnel graben. Auch die hohen Kuenste des Schmiedens "
    "beherrschen sie vortrefflich."
  );
  AddDetail( ({ "kuenste", "kunst", "schmieden" }), 
    "Die Zwerge in Felonia wisssen sicherlich mehr darueber zu berichten."
  );
  AddDetail( ({ "felonia", "hauptstadt", "stadt" }), 
    "Felonia ist die Hauptstadt der Zwerge und befindet sich tief im Gebirge."
  );
  AddDetail( ({ "gebirge", "gegend" }), 
    "Das Gebirge ist eine rauhe Gegend."
  );
  AddDetail( ({ "tunnel", "verschwendung", "koerpergroesse", "groesse" }), 
    "Die Tunnel hoeher als die eigene Koerpergroesse zu gestalten, waere Verschwendung."
  );
  AddDetail( ({ "relief" }), 
    "Die Vertiefungen geben der Hoehlenwand ein bizarres Relief."
  );
  AddDetail( ({ "vertiefung", "vertiefungen" }), 
    "Sie geben der Wand ein eigenes Relief."
  );
  AddDetail( ({ "spalte", "spalten", "ritze", "ritzen", "fuge", "fugen" }), 
    "Du siehst mehrere Vertiefungen in der Wand."
  );
  AddDetail( ({ "wand", "waende" ,"felswaende","hoehlenwand","felswand", "gegensatz"}), 
    "Die Waende sind voller Spalten, Ritzen und Fugen."
  );
  AddDetail("boden", 
    "Im Gegensatz zu den Waenden ist der Boden spiegelglatt!"
  );
  AddSpecialDetail("spiegel","spiegel");

//--Kommandos--------------------------------------------------------------

  AddCmd(({"schau","schaue","sieh"}), "schau");
  AddCmd(CMD_GREIFEN, "greif");

//--Ausgaenge--------------------------------------------------------------

  AddExit("raus", "./klamm8");
  AddExit("suedwesten", "./hoehle1");

  fackelfound = FALSE;
  spiegel = FALSE;

}

int schau(string str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WO willst Du hineinsehen?\n"),0);
  if (str=="spiegel" || str=="in spiegel") 
  {
    if (spiegel)
      write ("Du siehst Dein duemmlich schauendes Spiegelbild.\n" );
    else
    {
      write(BS("Als Du in den Spiegel siehst, veraendert sich "+
	  "alles rund um Dich: Der Raum wird von einem seltsamen Licht "+
	  "erfuellt und vor Deinen Augen erscheint ein Bild Monimors, "+
	  "das sagt:'Vertraue in Ingerimm'. Ploetzlich verschwindet "+
	  "Monimor wieder ."));
      Message(BS(TP->name(WER)+" schaut in den Spiegel."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      spiegel = TRUE;
      // clone und move des Amuletts
    }
    return 1;
  }
  else
    return (notify_fail ("Da kannst Du nicht hinein schauen.\n"),0);
}

string spiegel(string key)
{
if (spiegel)
 return "Da war wohl jemand vor Dir da, die Magie dieses Raumes hat auch Grenzen.\n";
else
  return BS("Der Spiegel strahlt eine arkane Energie aus, vielleicht solltest "
        +"Du einfach mal hinein sehen?");
}

reset()
{
  fackelfound = FALSE;
  spiegel = FALSE;
  ::reset();
}

int greif(string str)
{
  object myfackel;

  if (!stringp(str) || str=="")
    return (notify_fail ("WO willst Du hinein greifen?\n"),0);

  if(str=="in spalte" || str=="in ritze" || str=="in fuge" || str=="in vertiefung") 
  {
    if (fackelfound)
	  write ("Du findest nichts in dieser Vertiefung.\n");
    else
    {
	  write (BS("Als Du in die Vertiefung greifst, findest Du eine Fackel."));
      Message(BS(TP->name(WER)+" greift in eine Vertiefung."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
	  myfackel = clone_object("/obj/fackel");
	  
	  if(ME_TOO_HEAVY==myfackel->move(TP,M_GET|M_SILENT))
      {
        write(BS("Du kannst die Fackel nicht mehr tragen und laesst sie "
             +"fallen."));
        Message(BS(TP->name(WER)+" kann die Fackel leider nicht mehr tragen "
               +"und laesst sie fallen."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        myfackel->move(TO,M_PUT);
      }
      fackelfound = TRUE;
    }
    return 1;
  }
  else
    return (notify_fail ("Da kannst Du nicht hineingreifen.\n"),0);
}
void init()
{

  ::init();
  if (!TP || !query_once_interactive(TP)) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt die Hoehle.\n",
    dtime(time()), CAP(getuid(TP))));
}
