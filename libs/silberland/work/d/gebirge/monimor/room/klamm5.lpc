inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Eine Sackgasse");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer Sackgasse. Umgeben "
  	"von Fels ausser im Westen, kannst Du kaum die Hand vor Deinen Augen "
  	"sehen. Dir ist nicht ganz wohl bei dem Gedanken, in einem nahezu "
  	"abgeschlossenen Raum zu stehen, in dem die Waende so erdrueckend wirken, "
  	"wie es hier der Fall ist.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "fall" }), 
    "Erdrueckend."
  );
  AddDetail( ({ "ausgang" }), 
    "Nach Westen ist der Ausgang."
  );
  AddDetail( ({ "monimor" }), 
    "Den muesstest Du fragen, wie es um Deine Augen steht."
  );
  AddDetail( ({ "medicus" }), 
    "Im Moment ist keiner da, aber Du weisst, dass Monimor ein Medicus ist."
  );
  AddDetail( ({ "moment" }),
    "Grade jetzt."
  );
  AddDetail( ({ "gedanken", "ruecken" }),
    "Dir laeuft es eiskalt den Ruecken runter bei diesem Gedanken."
  );
  AddDetail( ({ "auge", "augen", "angst", "sicherheit" }), 
    "Keine Angst, Deine Augen sind gesund, hoffentlich. Du muesstest schon "
    "einen Medicus konsultieren, um absolute Sicherheit zu bekommen."
  );
  AddDetail( ({ "hand" }), 
    "Die kannst Du leider momentan bei diesem Nebel nicht sehen."
  );
  AddDetail( ({ "himmel" }), 
    "Du koenntest ihn sehen, waere da nicht dieser dichte Nebel."
  );
  AddDetail( ({ "gang" }), 
    "Der Gang endet hier in einer Sackgasse."
  );
  AddDetail( ({ "decke", "art" }), 
    "Dieser Raum hat keine Decke, weil es tatsaechlich eine Art Gang ist, "
    "der hier endet und dessen Decke der Himmel zu sein scheint."
  );
  AddDetail( ({ "raum" }), 
    "Es ist bedrueckend eng in diesem Raum. Die Waende sind hier ziemlich "
    "nah beinander. Ausserdem unterscheidet sich dieser Raum von anderen, "
    "weil er keine Decke hat."
  );
  AddDetail( ({ "klamm", "seelen" }), 
    "Eine Sackgasse in der Klamm der Seelen."
  );
  AddDetail( ({ "fels" }), 
    "Der Fels ist wie ueberall hier in der Klamm ohne sonderliche Unebenheiten."
  );
  AddDetail(({"unebenheit","unebenheiten"}),
    "Hier sind keine Unebenheiten. Alles ist total glatt."
  );
  AddDetail( ({ "gasse", "sackgasse" }), 
    "Tja, hier gehts nicht mehr weiter."
  );
  AddDetail( ({ "nebel" }), 
    "Der Nebel ist hier besonders dicht!"
  );
  AddDetail(({"waende","wand"}),
    "Langsam tastest Du Dich an der Wand entlang, bis Du ueber dem Ausgang "
    "eine Inschrift an der Westwand findest."
  );
  AddDetail( ({ "westwand" }),
    "Ueber dem Ausgang in der Westwand findest Du eine Inschrift."
  );
  AddDetail("boden",
    "Auch der Boden ist total glatt und aus Fels."
  );
  AddDetail(({"schrift","inschrift"}),
    "Du kannst sie lesen."
  );
  AddDetail("nase",
    "Das ist wohl Deine eigene Nase."
  );

  AddReadDetail(({"inschrift","schrift"}), 
    "Bedenke Fremder, der Du wagemutig gewagt hast, in die Klamm der "
    "Seelen einzudringen, dass hier einiges nicht der Art ist, als es "
    "beschrieben in den Schriften der Menschen. Dies ist ein Stueck Land, "
    "bei dessen Erschaffung arkane Maechte mit im Spiel waren."
  );

  AddSound( DEFAULT_SOUND,
    "Es ist beaengstigend still."
  );

  AddSmell(DEFAULT_SMELL,
    "Der Nebel riecht schwefelartig. Es faellt Dir schwer zu atmen."
  );
  AddSmell("schwefel",
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("nebel", 
    "Der Nebel riecht nach Schwefel."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig. Das ist wohl der Nebel."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("westen", "./klamm4");

//--Items & NPCs-----------------------------------------------------------

  AddItem(KNPC "schatten", REFRESH_DESTRUCT);
  AddItem(KNPC "schatten", REFRESH_DESTRUCT);

}
