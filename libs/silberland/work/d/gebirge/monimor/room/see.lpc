inherit "std/room";

#include "../def.h"

create()
{

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Der See des Ruesselwurms");
  SetProp(P_INT_LONG,
    "Du bist am See des Ruesselwurms angekommen. Hin und wieder "
    "siehst Du Schwaden von Wasserdampf aufsteigen, da es doch warm ist, "
    "und der See nicht allzu gross ist. Vielleicht ist auch das der Grund, "
    "weshalb die ganze Schlucht voller Nebel ist, weil sich der aufsteigende "
    "Dampf weiter oben staut, und dann in die tiefer gelegene Schlucht abzieht. "
    "Der See liegt in einer kesselfoermigen Vertiefung, die nur zwei Wege "
    "freigibt. Die Waende des Kessels sind etwas zerfurcht, Du erkennst "
    "aber, dass Du die Spitze des Kessels nicht erreichen kannst. Nach "
    "Osten jedenfalls fuehrt ein Weg, nach Suedwesten kommst Du zurueck "
    "in die Klamm."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "fels" }),
    "Der selbe Fels wie im Rest der Klamm der Seelen. Er ist einfach nur dunkel."
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist auch hier aus Fels."
  );
  AddDetail( ({ "himmel" }),
    "Den Himmel kannst Du von hier aus sehen, "+
    "obwohl es leicht nebelig ist."
  );
  AddDetail( ({ "rest" }),
    "Der Rest der Klamm der Seelen hat glatte "+
    "Waende."
  );
  AddDetail( ({ "zustand" }),
    "Die Waende sind total zerfurcht. Ihr Zustand "+
    "ist verglichen mit dem Rest der Klamm eher schlecht."
  );
  AddDetail( ({ "vertiefung" }),
    "Der Kessel ist eine Vertiefung."
  );
  AddDetail( ({ "klamm", "seelen" }),
    "Die Klamm der Seelen."
  );
  AddDetail( ({ "heimat" }),
    "Der See beheimatet den Ruesselwurm."
  );
  AddDetail( ({ "grund" }),
    "Der Grund fuer den Nebel in der Klamm ist der "+
    "See."
  );
  AddDetail( ({ "material", "materialien" }),
    "Davon gibt es viele."
  );
  AddDetail( ({ "diamant" }),
    "Diamant ist eines der haertesten Materialien."
  );
  AddDetail( ({ "spitze" }),
    "Der Kessel ist nach oben offen. Die Spitze "
    "kannst Du zwar sehen, aber durch klettern wirst Du sie wohl "
    "nicht erreichen."
  );
  AddDetail( ({ "krallen" }),
    "Mit den Krallen kann der Ruesselwurm "
    "vermutlich Diamant schneiden dem Zustand der Waende nach zu "
    "urteilen."
  );
  AddDetail( ({ "wand", "waende" }),
    "Die Waende des Kessels sind etwas "
    "zerklueftet. Vermutlich wetzt der Ruesselwurm an ihnen seine "
    "Krallen."
  );
  AddDetail( ({ "kessel" }),
    "Die Waende des Kessels steigen "
    "auseinanderweichend auf und werden gegen die Spitze zu "
    "wieder enger. Die Spitze des nach oben offenen Kessels "
    "kannst Du gerade noch erkennen."
  );
  AddDetail( ({ "see" }),
    "Das ist ein grosser See. Er ist die Heimat "
    "des Ruesselwurms."
  );
  AddDetail( ({ "nebel" }),
    "Von hier zieht der Nebel in die Schlucht."
  );
  AddDetail( ({ "reste" }),
    "Du siehst Knochen als Reste von einem Kampf."
  );
  AddDetail( ({ "knochen" }),
    "Das duerften Reste von einem Kampf sein."
  );
  AddDetail( ({ "kampf" }),
    "Ein wagemutiger und toerichter Abenteurer der den Ruesselwurm "
    "herausgefordert hat."
  );
  AddDetail( ({ "abenteurer" }),
    "Nur Knochen sind von ihm uebrig geblieben."
  );
  AddDetail( ({ "ufer" }),
    "Die Wellen des Sees schlagen gegen das Ufer. "
    "Ueberall am Ufer siehst Du Knochen."
  );
  AddDetail( ({ "wellen" }),
    "Die Wellen schlagen gegen das Ufer des Sees."
  );
  AddDetail( ({ "schlucht", "weg" }),
    "Du kannst nach Suedwesten wieder in die "
    "tiefer gelegene Schlucht zurueckkehren."
  );
  AddDetail(({"schwaden","schwade","dampf","wasserdampf"}),
    "Die aufsteigenden Schwaden von Wasserdampf sind der Grund fuer den Nebel "
    "in der tiefer gelegenen Schlucht."
  );

  AddSound(DEFAULT_SOUND,
    "Wellen schlagen gegen das Ufer, ein vertrautes Geraeusch."
  );
  AddSound(({"see", "geraeusch" }),
    "Du hoerst Die Wellen ans Ufer schlagen."
  );


//--Kommandos--------------------------------------------------------------

  AddCmd(({"schwimme","schwimm"}),"schwimm");

//--Items & NPCs-----------------------------------------------------------

  AddItem(KNPC "wurm", REFRESH_DESTRUCT);
  AddGuardedExit("osten", "./see1","wurm",
    "Der Ruesselwurm versperrt Dir den Weg nach Osten.");

//--Ausgaenge--------------------------------------------------------------

  AddExit("suedwesten", "./klamm7");
}

// Spaeter in den See schwimmen um zu Relm zu gelangen
schwimm(str)
{
  notify_fail ("WORIN willst Du denn schwimmen?\n" );
  if (str=="see" || str=="in see" || str=="im see")
  {
    write(BS("Bist Du wahnsinnig? Du willst doch nicht den Ruesselwurm aufwecken!"));
    Message(BS(TP->name(WER)+" hat gerade einen Selbstmordversuch unternommen: "+
    TP->QueryPronoun(WER)+" wollte in den See springen. "+
    TP->QueryPronoun(WER)+" haette dabei sicher den Ruesselwurm aufgeweckt. "
    "Dusty sei Dank hat "+TP->QueryPronoun(WER)+" es doch unterlassen, ein Bad zu nehmen!"),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }

  return 0;
}
