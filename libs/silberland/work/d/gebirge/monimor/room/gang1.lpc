inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein Gang durch das Gebirge");
  SetProp(P_INT_LONG, "Du bist in einem Gang, der Dich durch das "
                      "Gesteinsmassiv des Gebirges fuehrt. Es scheint vielmehr "
                      "ein natuerlicher Stollen, als ein Gang zu sein. "
                      "Allerdings duerfte schon laenger niemand mehr hier "
                      "gewesen sein, da der Boden ziemlich staubig ist.");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "granit","gesteinsart" }),
    "Granit ist eine dreifaerbige Gesteinsart. Dieser ist mehr roetlich.");
  AddDetail( ({ "massen", "masse", "gesteinsmasse", "gesteinsmassen","gestein" }),
    "Du kannst Dir nur in etwa vorstellen, wieviel an Masse ueber Deinem Kopf "
    "schwebt. Es beaengstigt Dich jedoch allein der Gedanke, in diesem Stollen "
    "Deine letzte Ruhestaette zu finden, wuerde die Decke ueber Dir "
    "einbrechen.");
  AddDetail(({"gedanke","kopf", "gedanken"}),
    "Wirklich beaengstigend!");
  AddDetail(({"ruhestaette","staette", "ruhe", "tonnen"}),
    "Ein beaengstigender Gedanke, unter soviel Tonnen Gestein begraben zu "
    "werden. Andererseits, an solch einer Staette haettest Du wirklich Deine "
    "Ruhe.");
  AddDetail( ({ "decke" }),
    "Die Decke ist nicht besonders hoch. Du kannst sie fast mit Deiner Hand "
    "erreichen. Sie ist von kleineren Spalten zerfurcht. Du hoffst, dass sie "
    "nicht ueber Dir einbricht, denn die Gesteinsmassen ueber Dir wuerden Dich "
    "gnadenlos erdruecken.");
  AddDetail( ({ "riss", "risse" }),
    "Die Risse sind durch die Scherbewegungen entstanden, die das Gebirge bei "
    "seiner Entstehung durchmachen musste. Sie sind fast gross genug, dass man "
    "sie betreten koennte, aber selbst Zwerge sind zu gross dafuer. In den "
    "Rissen ist nichts, ausser Staub, der hier ueberall am Boden ist." );
  AddDetail(({"scherbewegungen", "bewegungen", "kraft", "entstehung"}),
    "Welch ungeheure Kraft muss hier gewirkt haben um solche Massen zu bewegen.");
  AddDetail(({"hand", "umstaende", "umstaenden", "haende"}),
    "Unter normalen Umstaenden solltest Du zwei davon haben.");
  AddDetail( ({ "spalt", "spalten" }),
    "Die Spalten sind nicht besonders tief. Sie geben dem Stollen ein bizarres "
    "Aussehen.");
  AddDetail("aussehen",
    "Die Spalten geben dem Stollen ein bizarres Aussehen.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus Granit. Sie sind total zerklueftet. Du siehst "
    "Spalten und Risse in den Waenden.");
  AddDetail( ({ "gestein", "gesteinsmassiv", "massiv" }),
    "Das Gestein umgibt Dich. Es bildet Waende und Boden des Stollens in dem "
    "Du Dich befindest. Soviel Du von Gesteinskunde weisst, duerfte es sich "
    "um Granit handeln.");
  AddDetail(({"gesteinskunde"}),
    ([ 0: "Du bist nicht sonderlich gut in Gesteinskunde, aber das es "
          "sich um Granit handelt kannst du noch erkennen.", // Der Defaulttext
       "zwerg":  // Die Rasse wird klein geschrieben!
          "In Gesteinskunde warst Du immer gut, es faellt Dir ausgesprochen "
          "leicht, das Gestein als Granit zu erkennen." ]) );
  AddDetail( ({ "gang", "stollen" }),
    "Dieser Gang fuehrt durchs Gebirge, aber wohin?");
  AddDetail("boden",
    "Der Boden ist von einer Staubschicht bedeckt, die sich sehen laesst.");
  AddDetail(({"staub","staubschicht"}),
    "Der Staub hat sich wohl im Laufe der Zeit hier angesammelt. Ausser ein "
    "paar Fussspuren ist nichts zu sehen.");
  AddDetail(({"laufe","zeit", "sprichwort"}),
    "Das ist nur so ein Sprichwort.");
  AddDetail("gebirge",
    "Das Gebirge haben die Goetter erschaffen. Du bist momentan in einem "
    "Stollen durch das Gebirge.");
  AddDetail(({"goetter","woody", "dusty"}),
    "Woody und Dusty.");
  AddDetail(({"fusspuren","spuren", "fussspuren"}),
    "Das sind wohl Deine eigenen Spuren, die Du hier hinterlassen hast.");
  AddDetail(({"zwerge","heimat"}),
    "Das Gebirge ist die Heimat der Zwerge.");

//--Ausgaenge--------------------------------------------------------------

  AddExit("suedosten", "./gang2");
  AddExit("nordwesten", "./gang");

//--Kommandos--------------------------------------------------------------

  AddCmd( "greif|greife&in&risse|riss|spalten|nischen", "cmdgreifen",
          "In was willst Du greifen?|WOHIN willst du greifen?" );

}

int cmdgreifen(string key)
{
  write(BS("Du greifst in die Risse und ... schlitzt Dir die Finger an "
          +"den spitzen Steinen auf."));
  TP->AddHp(-(15+random(15)));
  return 1;
}
