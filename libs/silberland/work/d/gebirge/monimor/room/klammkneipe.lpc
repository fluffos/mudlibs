inherit "std/pub";

#include <pub.h>
#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Kneipe Sauf und Fall"
  );
  SetProp(P_INT_LONG,
    "Das ist die Kneipe 'Sauf und Fall'. Sie ist in einer Hoehle, die "
    "kuenstlich in den Fels geschlagen wurde. Der Raum ist sehr klein, "
    "so dass nur ein kleiner Tisch Platz hat, um den herum fuenf Stuehle "
    "stehen. Der Boden ist blank poliert und die Waende ebenso. Nur ein Bild "
    "des Inhabers haengt ueber der Theke. Die Theke selbst ist etwa zwei "
    "Zwerge lang und einen halben Zwerg hoch. Ist wohl eine Zwergenkneipe."
    "\n"+"Mit <menue> kannst Du sehen, was es zu kaufen gibt.\n"
  );

//--Umgebung---------------------------------------------------------------

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "zost"
  );
  SetProp(P_PUBKEEPER_NAME, "Zost"
  );

//--Drinks---------------------------------------------------------------

  AddDrink("Klammwasser",({"klammwasser","wasser"}),44,10,0,7,
    ({"Du trinkst ein Klammwasser. Baeh, schmeckt das schlecht.\n",
      "&& trinkt ein Klammwasser.\n"}));
  AddDrink("Halbe","halbe",50,10,6,6,
    ({"Du schuettest eine Halbe auf einmal runter und ruelpst.\n",
      "&& schuettet eine Halbe auf einmal runter und ruelpst.\n"}));
  AddDrink("MegaMix",({"mix","megamix","mega","mm"}),500,40,20,50,"mega"
  );
  AddDrink("Seiterl","seiterl",30,7,4,4,
    ({"Du trinkst ein \"Kinderbier\", alle lachen Dich aus.\n",
      "&& trinkt ein \"Kinderbier\" und Du lachst &4 aus.\n"}));
  AddDrink("Ethannotol","ethannotol",1000,20,0,10,"ethannotol"
  );

//--Food---------------------------------------------------------------

  AddFood("Butterbrot","butterbrot",23,15,7,
    ({"Du schlingst gierig ein Butterbrot.\n",
    "&& schlingt gierig ein Butterbrot.\n"}));
  AddFood("Schmalzbrot",({"brot","schmalzbrot","schmalz"}),60,20,8,
    ({"Du ziehst Dir ein Schmalzbrot rein, mhhhh.\n",
    "&& geniesst sichtlich ein Schmalzbrot.\n"}));
  AddFood("Guhlasch",({"guhlasch","gulyasch"}),170,40,14, "guhlasch_essen");

//--Details----------------------------------------------------------------

  AddDetail( ({ "wirt", "zost" }),
    "Der ist wohl grade nicht da."
  );
  AddDetail( ({ "klamm" }),
    "Du bist in einer Kneipe der Klamm."
  );
  AddDetail( ({ "firma" }),
    "Monimor hat mehrere."
  );
  AddDetail( ({ "raum" }),
    "Der Raum ist nicht sehr gross. Hier passen "
    "nur ein kleiner Tisch, fuenf Stuehle und eine kleine Theke herein."
  );
  AddDetail( ({ "incorporated" }),
    "Von dieser Firma wurde Zost damals gemalt."
  );
  AddDetail( ({ "glas", "glaeser" }),
    "Aus Glaesern trinkt man, auch hier. Momentan "
    "werden sie allerdings zum vermutlich x-ten mal von Zost "
    "gewaschen."
  );
  AddDetail( ({ "fall" }),
    "Nach dem Saufen kommt der Fall."
  );
  AddDetail( ({ "sauf" }),
    "Die Kneipe heisst vermutlich so, weil man hier etwas trinken kann."
  );
  AddDetail( ({ "geschaeft", "geschaefte" }),
    "Die Geschaefte in der Klamm duerften nicht "
    "gut gehen. Du erkennst das daran, dass alles sauber geputzt "
    "ist und der Wirt ziemlich brummig aussieht. Haette er keine "
    "Stammgaeste, muesste Zost vermutlich zusperren."
  );
  AddDetail( ({ "gast", "stammgast", "gaeste", "stammgaeste" }),
    "Offenbar hat der Wirt Stammgaeste, denn sonst "
    "koennte er hier nicht leben. Momentan ist von den "
    "Stammgaesten aber niemand da."
  );
  AddDetail( ({ "platz", "person", "personen" }),
    "Es ist Platz fuer fuenf Personen am Tisch. Allerdings sitzt dort niemand."
  );
  AddDetail( ({ "hoehe" }),
    "Alles hier hat einfach die richtige Hoehe "
    "fuer Zwerge. Scheint fuer Zwerge eingerichtet zu sein."
  );
  AddDetail( ({ "kneipe", "zwergenkneipe" }),
    "Die Kneipe ist fuer Zwerge eingerichtet. Eine "
    "niedrige Theke, ein niedriger Tisch und ebenso niedrige "
    "Stuehle stehen hier herinnen. Scheint eine Kneipe fuer "
    "Zwerge zu sein. Sie heisst 'Sauf und Fall'."
  );
  AddDetail( ({ "zwerg", "zwerge" }),
    "Die Zwerge leben in Felonia. Nach verrichteter Arbeit gehen sie gerne "
    "einen heben."
  );
  AddDetail( ({ "felonia", "hauptstadt" }),
    "Felonia ist die Hauptstadt der Zwerge."
  );
  AddDetail( ({ "arbeit" }),
    "Nach verrichteter Arbeit gehen Zwerge gerne einen saufen. Auch wenn \"Sauf "
    "und Fall\" etwas abseits liegt, ist die Kneipe sehr beliebt bei den Zwergen."
  );
  AddDetail( ({ "holz" }),
    "Das Holz duerfte ziemlich stabil sein."
  );
  AddDetail( ({ "theke" }),
    "Die Theke ist zwei Zwerge lang und etwa einen "
    "halben Zwerg hoch. Das ist fuer den Wirt gerade die richtige "
    "Hoehe, um angenehm arbeiten zu koennen. Die Theke ist aus "
    "Holz und sauberst geputzt. Vielleicht ist dem Wirt langweilig."
  );
  AddDetail( ({ "sessel", "stuhl", "stuehle" }),
    "Fuenf Stuehle stehen um einen Tisch herum. "
    "Sie sind aus Holz und schon sehr durchgesessen. Vermutlich "
    "hat der Wirt Stammgaeste, denn sonst muesste er hier zusperren."
  );
  AddDetail( ({ "tisch" }),
    "Der Tisch hat die richtige Hoehe fuer Zwerge. "
    "Es ist genug Platz fuer fuenf Personen."
  );
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind blank poliert und glatt. An einer Wand haengt ein Bild."
  );
  AddDetail( ({ "silberland" }),
    "Um das Silberland zu untersuchen, braeuchtest Du eine Karte."
  );
  AddDetail( ({ "fels", "stein", "steine" }),
    "Der selbe Fels wie in der restlichen Klamm. "
    "Er ist einfach nur dunkel. Die Hoehle wurde kuenstlich in "
    "den Fels gehauen."
  );
  AddDetail( ({ "iglu","form" }),
    "Ein Iglu ist hier nicht anzufinden, aber die "
    "Form der Hoehle gleicht einem Iglu."
  );
  AddDetail( ({ "eck", "ecke" }),
    "Die Hoehle ist eher rund gebaut, wie ein Iglu. Es gibt keine scharfen Ecken."
  );
  AddDetail( ({ "decke" }),
    "Die Decke ist nicht sehr hoch, doch Du kannst "
    "bequem aufrecht stehen."
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist blank poliert und glatt. Zost "
    "hat ihn scheinbar vor kurzem geputzt."
  );
  AddDetail("hoehle",
    "Die Hoehle wurde kuenstlich in den Fels geschlagen. Jetzt beherbergt "
    "sie eine Kneipe."
  );
  AddDetail(({"bild","inhaber"}),
    "                       ++++++\n"
   + "                      +      +\n"
   + "                     +  *  *  + \n"
   + "                     +    |   +\n"
   + "                     +   --   +\n"
   + "                     +  _____ +\n"
   + "                     +        +\n"
   + "\n"
   + "\n"
   + "Moni_Incorporated, 1997, Zost, der Wirt.\n"
  );

  AddSound( DEFAULT_SOUND,
    "Du hoerst, dass jemand Glaeser spuelt. Ansonsten hoerst Du nichts."
  );

  AddSound( ({ "abwasch","abwaschen","spuele","spuelen","stille" }),
    "Jemand spuelt ein paar Glaeser ab."
  );

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Malz und Bier. Hier fuehlst Du Dich wohl."
  );

  AddSmell( ({ "malz","bier" }),
    "Es riecht nach Malz und Bier. Hier fuehlst Du Dich wohl."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("osten", "./klamm2");

//--Items & NPCs-----------------------------------------------------------

  AddItem(KOBJ "zigautomat" ,REFRESH_REMOVE);
  AddItem(KNPC "wirt" , REFRESH_DESTRUCT);

}

public void guhlasch_essen() {
  object task;

  write(BS("Hui, ein boeses Guhlasch...\n"));
  say(BS(TPN+"isst boesartigerweise ein Guhlasch.\n"));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(6);
  }
}

int ethannotol(object zaehler, object trinker)
{
  if (trinker->QueryProp(P_BLIND))
  {
    tell_object(trinker, "Du trinkst ein Glas Ethannotol und siehe da: Du kannst sehen!\n");
    Message(BS(trinker->Name(WER)+" freut sich nach dem Genuss eines Glases "
           +"Ethannotol."),MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ trinker }) ]) );
    trinker->SetProp(P_BLIND,0);
    return 1;
  }
  else
  {
    tell_object(trinker, "Du drinkst ein Glas Ethannotol.\n");
    Message(BS(trinker->Name(WER)+" trinkt ein Glas Ethannotol. "),
            MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ trinker }) ]) );
    return 1;
  }
}

int mega(object zaehler, object trinker)
{
  tell_object(trinker,"Du stuerzt einen MegaMix runter und ploetzlich...\n");
  Message(BS(trinker->Name(WER)+" trinkt einen MegaMix und wird zu einem Geist."),
          MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ trinker }) ]) );
  trinker->SetProp(P_GHOST,1);
  call_out("undie",60, trinker);
  return 1;
}

void undie(object trinker)
{
  tell_object(trinker,"Du erwachst wieder zum Leben.\n");
  trinker->SetProp(P_GHOST,0);
}