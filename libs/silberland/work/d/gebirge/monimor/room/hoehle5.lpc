inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In einer Sackgasse" );
  SetProp(P_INT_LONG,
    "Du bist in einer weiteren Sackgasse der Hoehle angekommen. Du siehst "
    "Dich etwas um und erkennst, dass es genauso aussieht, wie ueberall "
    "hier in der Hoehle. Allerdings ist hier etwas Moos, das sich von dem "
    "Wasser, das von der Decke tropft, ernaehrt. Nach Westen kommst Du zur "
    "Kreuzung zurueck.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12,ENV_TERRAIN:TT_CAVE]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "kreuzung" }), 
    "Die Kreuzung ist im Westen."
  );
  AddDetail( ({ "sackgasse" }), 
    "Hier geht es nicht mehr weiter."
  );
  AddDetail(({"berg","berge"}),"Du siehst folgendes: \n"
+"                                     /\\ \n"
+"                                    /  \\   /\\ \n"
+"                                   /     -   | \n"
+"                               /\\_/           \\ \n"
  ); 
  AddDetail( ({ "relief" }), 
    "Die Vertiefungen an der Wand geben der Hoehle ein bizarres Relief. "
    "Es erinnert Dich an Berge."
  );
  AddDetail( ({ "hoehle", "teil", "raum" }), 
    "Dieser Raum ist ein weiterer Teil dieser Hoehle. Es ist feucht hier."
  );
  AddDetail( ({ "decke" }), 
    "Von der Decke tropft etwas Wasser herab."
  );
  AddDetail( ({ "raum" }), 
    "Der Raum ist feuchter als andere hier in der Hoehle, das ist auch der "
    "Grund, warum hier Moos wachsen kann."
  );
  AddDetail( ({ "ecke", "ecken" }), 
    "Die Ecken sind feucht und das ermoeglicht dem Moos dort zu wachsen."
  );
  AddDetail( ({ "vertiefung", "vertiefungen" }), 
    "Du kannst nichts besonderes an den Vertiefungen feststellen, ausser "
    "dass sie der Wand ein eigenes Relief geben."
  );
  AddDetail( ({ "spalte", "spalten", "ritze", "ritzen" }), 
    "Du versuchst in die Spalte reinzugreifen, um sie naeher zu untersuchen, "
    "aber Du kannst nichts besonderes an den Vertiefungen feststellen."
  );
  AddDetail( ({ "wand","waende" }), 
    "An der Wand siehst Du ausser Moos noch einige Ritzen und Spalten."
  );
  AddDetail( ({ "pfuetzen", "pfuetze" }),
    "Die Pfuetzen stammen von dem Wasser, das von der Decke tropft."
  );
  AddDetail( ({ "boden" }), 
    "Am Boden sind mehrere kleine Pfuetzen."
  );
  AddDetail("moos",
    "Es waechst in den Ecken des Raumes."
  );
  AddDetail("wasser",
    "Es tropft von der Decke."
  );

  AddSmell(DEFAULT_SMELL,
    "Es riecht irgendwie modrig."
  );

  AddSmell("wasser",
    "Es riecht modrig. Es duerfte giftig sein."
  );

  AddRoomMessage(({BS("Du hoerst, wie ein Wassertropfen in eine Pfuetze tropft.")}));

//--Kommandos--------------------------------------------------------------

  AddCmd(({"trink","trinke"}), "trinke");

//--Ausgaenge--------------------------------------------------------------

  AddExit("westen", "./hoehle3");

}

int trinke(string str)

{
  if (!stringp(str) || str=="")
    return (notify_fail ("WAS willst Du trinken?\n"),0);
  if (str=="wasser")
  {
    write(BS("Ein hoellischer Schmerz durchfaehrt Deine Glieder. Vielleicht "
     +"haettest Du Dir besser ansehen sollen, was Du da trinkst!"));
    Message(BS(TP->Name(WER)+" trinkt ein wenig Wasser und zuckt "
    +"schmerzverzerrt zusammen."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    SetProp(P_KILL_NAME, "Giftiges Wasser" );
    TP->Defend(40+random(40), DT_POISON, 1, TO);
    return 1;
  }
  else
    return (notify_fail ("Das kannst Du nicht trinken.\n"),0);
}
