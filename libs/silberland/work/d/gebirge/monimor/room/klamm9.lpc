inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"An der Felswand entlang"
  );
  SetProp(P_INT_LONG,"Du bist in einer engen Spalte, links und rechts "
    "von Fels beengt. Als Du Dich umsiehst, siehst Du ein paar Spalten "
    "in der Felswand, die wohl einst von einem fuerchterlichen Kampf "
    "stammen, denn die Spalten erinnern Dich an Wunden, die ein Schwert "
    "in einem Baum hinterlassen wuerde. Was muss das fuer eine maechtige "
    "Waffe gewesen sein..."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);

  AddDetail( ({ "klamm", "seelen" }),
    "Die Klamm der Seelen."
  );
  AddDetail( ({ "streich", "steiche" }), 
    "Die Streiche eines maechtigen Schwertes kann "
    "man noch an der Felswand erkennen."
  );
  AddDetail( ({ "sage", "boese" }), 
    "Der Sage nach kann Nidgor, somit auch das "
    "Boese, nur durch ein gewisses Schwert vernichtet werden."
  );
  AddDetail( ({ "gebiet" }), 
    "Das Gebiet der Wissenschaften."
  );
  AddDetail( ({ "kampf" }), 
    "Hier muss ein fuerchterlicher Kampf "
    "stattgefunden haben."
  );
  AddDetail( ({ "lauf", "dinge", "ding" }), 
    "WIE funktioniert WAS? Das ist das Gebiet der "
    "Naturwissenschaften."
  );
  AddDetail( ({ "naturwissenschaft", "naturwissenschaften", "wissenschaft", "wissenschaften" }), 
    "Sie befassen sich mit dem Lauf der Dinge."
  );
  AddDetail( ({ "raetsel" }), 
    "Davon gibt es viele, auch viele ungeloeste Raetsel."
  );
  AddDetail( ({ "magie" }), 
    "Magie ist eines der noch nicht geklaerten Raetsel unserer Naturwissenschaften."
  );
  AddDetail( ({ "nidgor", "herr", "herren" }), 
    "Nidgor ist der Herr des Boesen der Sage nach. "
    "Hier ist er nicht anzutreffen. Du musst ihn woanders suchen."
  );
  AddDetail( ({ "wille", "willen" }), 
    "Du kannst Dich anstrengen, soviel Du willst, "
    "Du wirst dieses Auge nicht sehen koennen."
  );
  AddDetail( ({ "auge" }), 
    "Dein geistiges Auge kannst Du beim besten "
    "Willen nicht sehen."
  );
  AddDetail( ({ "bild" }), 
    "Ein Bild vor Deinem geistigen Auge."
  );
  AddDetail( ({ "waffe" }), 
    "Ein Schwert ist eine Waffe, doch hier ist keine Waffe."
  );
  AddDetail( ({ "schwert" }), 
    "Das muss eine maechtige Waffe gewesen sein."
  );
  AddDetail( ({ "baum" }), 
    "Als Du die Waende betrachtest, erinnert Dich dieses Bild an einen Baum, "
    "der von einem Schwert verwundet worden ist."
  );
  AddDetail("nebel",
    "Dichter Nebel umgibt Dich."
  );
  AddDetail("himmel",
    "Du kannst den Himmel vor lauter Nebel nicht sehen."
  );
  AddDetail( ({ "fels" }), 
    "Der Fels ist dunkel, wie ueberall hier."
  );
  AddDetail( ({ "boden", "weg" }), 
    "Der Boden ist aus blankem Fels. Der Weg "
    "fuehrt von Nordosten nach Sueden."
  );
  AddDetail( ({ "wand", "waende","felswand","felswaende" }), 
    "An den Waenden, die auch hier aus Fels sind, "
    "befinden sich maechtige Spalten."
  );
  AddDetail(({"spalte","spalten","wunde","wunden"}),
    "Die Spalten in der Wand stammen von den Streichen eines maechtigen "
    "Schwertes. Der Sage nach, ist dieses und eine seltsame Magie die "
    "einzige Waffe, mit der man Nidgor, den Herren des Boesen besiegen kann."
  );
  AddDetail("nase",
    "Das ist wohl Deine eigene Nase."
  );

  AddSound(({DEFAULT_SOUND,"wind","brise"}),
    "Du hoerst den Wind durch die Klamm ziehen."
  );

  AddSmell(({DEFAULT_SMELL, "nebel" }),
    "Der Nebel riecht schwefelartig. Du wuerdest gerne wieder was "
    "anderes riechen als diesen Nebel."
  );
  AddSmell("schwefel",
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig. Das ist wohl der Nebel."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("nordosten", "./klamm8.lpc");
  AddExit("sueden", "./klamm11");
  AddExit("westen", "/d/gebirge/gwenshara/hoehle/room/eingang");

}