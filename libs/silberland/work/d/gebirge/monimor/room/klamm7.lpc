inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

int lochfound;

create()
{
   ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Der Weg zum See");
  SetProp(P_INT_LONG,
    "Du bist auf einem leicht ansteigenden Weg, der zu einem kleinen See "
    "fuehrt. Du kannst das erkennen, weil seltsamerweise der Nebel "
    "nachlaesst, aber das Wetter spielt bekanntlich in magischen Welten "
    "immer andere Toene, als man es normal gewohnt ist ;) Nach Nordosten "
    "gelangst Du zum See, nach Sueden zu der Kreuzung.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "wetter" }), 
    "Das Wetter spielt hier oft verrueckt. Sei froh, dass es nicht regnet."
  );
  AddDetail( ({ "himmel" }), 
    "Der Nebel laesst zwar nach, doch den Himmel kannst Du noch nicht erkennen."
  );
  AddDetail( ({ "wand", "waende" }), 
    "Die Waende sind hier aus blankem Fels. Nur die Ostwand kannst Du nicht "
    "genauer betrachten, weil dort der Nebel stark verdichtet ist."
  );
  AddDetail( ({ "klamm", "seelen" }), 
    "Du bist in der Klamm der Seelen."
  );
  AddDetail( ({ "ausmass", "ausmasse" }), 
    "Die Ausmasse des Sees kannst Du nur sehr schlecht erkennen, da es sehr "
    "nebelig ist. Er scheint aber gross zu sein."
  );
  AddDetail( ({ "see" }), 
    "Von hier aus kannst Du einen See erkennen, die Ausmasse sind aber nur "
    "schwer abzuschaetzen, weil es hier ziemlich nebelig ist."
  );
  AddDetail( ({ "boden" }), 
    "Der Boden ist aalglatt."
  );
  AddDetail( ({ "kreuzung" }), 
    "Die Kreuzung liegt im Sueden."
  );
  AddDetail( ({ "fels" }), 
    "Der Fels ist hier aalglatt, keine Ritze, nicht mal ein Kratzer. Jedoch "
    "die Ostwand kannst Du nicht sehen, weil eine Nebelverdichtung vor ihr ist."
  );
  AddDetail("weg",
    "Der Weg steigt etwas zum See hin an. Er besteht wie ueberall hier in der "
    "Klamm aus blankem Fels."
  );
  AddDetail("nebel",
    "An der Ostwand ist eine starke Verdichtung des Nebels."
  );
  AddDetail( ({ "kratzer" }), 
    "Kein Kratzer zu sehen. Auch beim fuenften Blick nicht."
  );
  AddDetail( ({ "blick" }), 
    "Du wirst ganz wirr beim staendigen Fels anstarren."
  );
  AddDetail( ({ "nebelverdichtung" }), 
    ""
  );
  AddDetail( ({ "ritze", "finger", "fingern" }), 
    "Der Fels ist aalglatt. Du streichst mit Deinen Fingern ueber ihn, findest "
    "aber keine Ritze."
  );
  AddDetail( ({ "welten", "volksweisheit", "weisheit" }), 
    "Wie sagt die alte Volksweisheit. \"Andere Welten, anderes Wetter\""
  );
  AddDetail( ({ "toene" }), 
    "Wie waers mit lauschen?"
  );

  AddSpecialDetail("ostwand","ostwand");
  AddSpecialDetail("loch","loch");
  AddSpecialDetail("verdichtung","dicht");
  AddSpecialDetail("ostwand", "wand");

  AddSound( DEFAULT_SOUND,
    "Absolut still."
  );

  AddSound( ({ "toene" }),
    "Um Toene zu hoeren muesstest Du sie schon spielen."
  );

  AddSmell( DEFAULT_SMELL,
    "Der Nebel ueberdeckt jeden Geruch."
  );

  AddSmell( ({ "nebel","geruch" }),
    "Feucht."
  );

//--Kommandos--------------------------------------------------------------

  AddCmd(({"spiele","spiel"}),"spiel");
  AddCmd(({"blas","blase","puste"}),"blase");
  AddCmd(({"schieb","schiebe","lege",}),"def_blasen" );
  AddCmd(({"klettere","kletter"}),"kletter" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(KNPC "schatten", REFRESH_DESTRUCT);

//--Ausgaenge--------------------------------------------------------------

  AddExit("nordosten", "./see");
  AddExit("sueden", "./klamm4");
  
  lochfound = 0;
}

//--Funktionen fuer Kommandos----------------------------------------------

int def_blasen(string str)
{ 
  notify_fail ("Was willst Du schieben?\n");
  if (str=="nebel weg" || str=="wand frei" || "nebel")
  {
    write("Man kann Nebel auch wegblasen.\n");
    Message(BS(TP->name(WER)+" versucht die Ostwand freizulegen."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
  return 0;
}

int kletter(string str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WO willst du hinein klettern?\n"),0);

  if (str=="loch" || str == "in loch") 
  {
    if (lochfound)
    {
      write ("Du kletterst in ein Loch.\n");
      Message(BS(TP->name(WER)+" klettert in ein Loch."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      TP->move( "/d/gebirge/monimor/room/klamm10", M_GO);
      return 1;
    }
    else
    {
      write ("Du hast noch nichts zum Reinklettern gefunden!\n");
      return -1;
    }
  }
}

int spiel(string str)
{
  notify_fail("WAS willst du spielen?\n");
  if (str == "toene" || str =="ton") {
    write (BS("Du spielst die Toene eines Regenliedes. Vielleicht solltest "
          +"Du schnell hier verschwinden, sonst wirst Du noch nass ;)\n"));

    Message(BS(TP->name(WER)+" spielt Toene eines Regenliedes, es duerfte "
            +"bald regnen."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }
  return 0;
}

int blase(string str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WAS willst Du weg blasen?\n"), 0);

  if (str=="nebel weg" || str=="nebel") 
  {
    if (lochfound)
      write ("Da ist doch kein Nebel mehr an der Ostwand, nur ein Loch!\n");
    else
    {
	  write(BS("Du holst tief Luft und blaest was das Zeug haelt und der Nebel "
	          +"verfluechtigt sich tatsaechlich."));
      Message(BS(TP->name(WER)+"  blaest den Nebel an der Ostwand weg."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      lochfound = 1;
      return 1;
    }
  }
  else
    return (notify_fail ("Das kannst Du nicht wegblasen.\n"), 0);
}

string ostwand(string key)
{
  if (lochfound)
    return BS("Du siehst ein Loch in der Ostwand. Du koenntest versuchen hinein "
           "zu klettern.");
  else
    return BS("An der Ostwand siehst Du eine Verdichtung des Nebels. Du kannst "
             +"deshalb die Ostwand nicht wirklich sehen, vielleicht solltest "
             +"du versuchen, doch irgendwie die Wand freizulegen!");
}

string loch(string key)
{
  if (lochfound)
   return "Du koenntest versuchen rein zu klettern.\n";
  else
    return "Du solltest erst mal ein Loch finden, denkst Du nicht?\n";
}

string dicht(string key)
{
  if (lochfound)
    return "Hier ist keine Verdichtung mehr.\n";
  else
    return "Eine Verdichtung des Nebels an der Ostwand.\n";
}


void reset()
{
  if(lochfound)
  {
    lochfound = 0;
    Message(BS("Der Nebel wird wieder dichter."), MSGFLAG_VISUAL);
  }
  
  return::reset();
}