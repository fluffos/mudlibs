inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Klamm der Seelen");
  SetProp(P_INT_LONG, 
    "Der Nebel rund um Dich nimmt zu. Es ist aber immer noch hell genug, "
    "um alles zu sehen, was Dich umgibt: So siehst Du steile Felswaende "
    "links und rechts von Dir in die Hoehe ragen. Lange genug bist Du "
    "nun in die Klamm abgestiegen und im Norden scheint der Abstieg nun "
    "auch ein Ende zu haben. Der Nebel scheint sich aber leider nicht "
    "zu lichten.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15,ENV_TERRAIN:TT_MOUNTAIN]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "abstieg", "norden", "ende" }),
    "Der Abstieg scheint im Norden ein Ende zu haben."
  );
  AddDetail("hoehe",
    "Die Waende ragen links und rechts von Dir in die Hoehe. Du siehst "
    "durch den Nebel nicht wie hoch."
  );
  AddDetail( ({ "gestein","fels","muehe" }), 
    "Das Gestein ist glatt, so als haette sich jemand die Muehe gemacht "
    "es zu polieren."
  );
  AddDetail( ({ "ostwand" }), 
    "An der Ostwand ist etwas, das wie ein Altar aussieht."
  );
  AddDetail( ({ "inschrift" }), 
    "Du kannst sie lesen."
  );
  AddDetail( ({ "klamm", "seelen" }), 
    "Du befindest Dich in der Klamm der Seelen. Der Nebel hier ist "
    "schon ziemlich dicht."
  );
  AddDetail( ({ "artefakt" }), 
    "Als Du das Artefakt naeher begutachtest, siehst Du eine Inschrift."
  );
  AddDetail( ({ "altar", "betrachten" }), 
    "Beim naeheren Betrachten denkst Du, dass es doch kein Altar ist, "
    "eher ein magisches Artefakt. Du kannst momentan nicht genau sagen, "
    "was es wirklich ist. Vielleicht kommst Du spaeter noch darauf."
  );
  AddDetail( ({ "wand", "waende", "felswand", "felswaende" }), 
    "Die Felswaende bestehen aus glattem Gestein, ohne Erhoehung oder "
    "Vertiefung, nur an der Ostwand kannst Du etwas erkennen, was "
    "wie ein Altar aussieht."
  );
  AddDetail( ({ "erhoehung", "vertiefung" }),
    "Keine Erhoehung oder Vertiefung ist bei diesen Waenden zu erkennen."
  );
  AddDetail( ({ "nebel" }), 
    "Der Nebel wird, je tiefer Du in die Klamm vordringst, dichter."
  );
  AddDetail("boden",
    "Am Boden scheint durch das Geroell immer mehr der blanke Fels "
    "durch, aus dem auch die Waende links und rechts von Dir bestehen.");
  AddDetail("geroell",
    "Das Geroell wird hier immer weniger."
  );
  AddDetail("himmel",
    "Durch den dichten Nebel kannst Du den Himmel nicht mehr erkennen."
  );
  AddDetail("nase",
    "Das ist wohl Deine eigene Nase."
  );
  AddDetail( ({ "fuss", "fuesse" }), 
   "Das sind Deine eigenen Fuesse."
  );

  AddReadDetail("inschrift",
    "Wenn Du das Amulett der Dunkelheit gefunden, so wird Dir ein helles "
    "Wunder geschehen. Doch wage es besser nicht!"
  );

  AddSound(DEFAULT_SOUND,
    "Du hoerst ein paar Kieselsteine unter Deinen Fuessen knirschen."
  );
  AddSound(({"steine","stein","kieselstein","kieselsteine"}),
    "Wenn Du auftrittst, knirscht es unter Deinen Fuessen."
  );

  AddSmell(DEFAULT_SMELL,
    "Der Nebel riecht fast schwefelig."
  );
  AddSmell("schwefel",
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("nebel", 
    "Der Nebel riecht etwas nach Schwefel, genau kannst "
    "Du das nicht definieren."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig. Das ist wohl der Nebel."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("westen", "./klammkneipe");
  AddExit("norden", "./klamm4");
  AddExit("suedwesten", "./klamm1");

//--Items & NPCs-----------------------------------------------------------
  
  AddItem(KNPC "schatten",REFRESH_DESTRUCT);
  AddItem(KNPC "schatten",REFRESH_DESTRUCT);
}
init()
{
  ::init();

  if (present("dunkelamulett",TP))
  {
    call_out("morkas",2);
    return 1;
  }
}

morkas()
{
  tell_object(TP,"\n"+BS("Als Du am Altar vorbeischreitest, wirst Du von "
+"einem Strudel erfasst, der Dich aus der Klamm wegreisst. Du ruderst "
+"verzweifelt mit den Armen, doch es gibt offensichtlich kein "
+"Entrinnen. Dir wird schwarz vor Augen, aber das willst Du nicht "
+"zulassen, denn ohnmaechtig kannst Du kaum gegen diese Magie "
+"ankaempfen. Du kaempfst also weiter einen verbissenen Kampf mit "
+"einer Dir unbekannten arkanen Quelle. Ja, Du weisst nicht mal gegen "
+"wen oder was Du Dich wehrst. Da faellt Dir das Amulett ein. Du "
+"versuchst es wegzuwerfen, doch Deine Haende werden durch den "
+"Strudel herumgewirbelt, dass Du schliesslich aufgibst nach dem "
+"Amulett zu greifen. 'Was tun?' denkst Du, 'Ich will nicht sterben, nicht "
+"so, ohne zu wissen, was mich toetet.' Also nimmst Du nochmals "
+"all Deine Kraft zusammen, doch es hilft nichts.")+"\nStille und "
+"Finsternis.\n\nDoch siehe da, als Du aufwachst, denkst Du: 'Nein, "
+"tot bin ich nicht. Im Himmel ist es nicht so dunkel.' Also siehst Du "
+"Dich um.\n\n");
//  this_player()->move(ROOM "room_01",M_GO);
}