inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

int beutelfound;

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Eine Sackgasse");
  SetProp(P_INT_LONG,
    "Du stehst jetzt in einer Sackgasse der Hoehle. Auch hier ist der "
    "Boden glatt und die Waende gerippt. In den Ecken hat sich etwas "
    "Schimmel und Moos angesesetzt, als Zeichen, dass es hier wieder "
    "etwas feuchter ist.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12,ENV_TERRAIN:TT_CAVE]));

//--Details----------------------------------------------------------------

  AddSpecialDetail(({"ritze","spalte","fuge","ritzen","fugen","spalten"}),"spalte" );
  AddDetail( ({ "zeichen" }), 
    "Das Wachstum von Schimmel ist ein Zeichen dafuer, dass es feucht ist."
  );
  AddDetail( ({ "eck", "ecke", "ecken" }), 
    "In den Ecken dieses Raumes waechst Schimmel. Es ist eher feucht hier "
    "und das beguenstigt das Wachstum des Schimmels."
  );
  AddDetail( ({ "sackgasse" }), 
    "Hier geht es nicht mehr weiter."
  );
  AddDetail( ({ "hoehle","teil","raum","rest" }), 
    "Dieser Raum ist nur ein Teil der ganzen Hoehle. Hier endet die Hoehle "
    "in einer Sackgasse."
  );
  AddDetail( ({ "decke" }), 
    "Die Decke ist sehr niedrig. Selbst ein Zwerg haette Muehe aufrecht zu stehen."
  );
  AddDetail( ({ "wand","waende" }), 
    "An der Wand findest Du Ritzen, Fugen und Spalten."
  );
  AddDetail( ({ "schimmel" }), 
    "Hier schimmeln die Ecken des Raumes, vor allem natuerlich die an der "
    "Decke, weil es feuchter ist, als in anderen Teilen der Hoehle."
  );
  AddDetail( ({ "moos" }), 
    "Das Moos hat sich in den Ecken des Raumes angesetzt, weil es hier etwas "
    "feuchter ist, als im Rest der Hoehle."
  );
  AddDetail("boden",
    "Der Boden ist aalglatt."
  );

  beutelfound = 0;

//--Ausgaenge--------------------------------------------------------------

  AddExit("suedosten", "./hoehle3");

//--Kommandos--------------------------------------------------------------

  AddCmd(({"greif","greife"}),"greif");

//  AddCmd(({"zwaeng","zwaenge"}),"zwaeng");
}

int greif(string str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WO willst Du hineingreifen?\n"),0);

  if (str=="in spalte" || str=="in ritze" || str=="in fuge") 
  {
    if (beutelfound)
	  write ("Du greifst in die Spalte und findest nichts.\n");
    else
    {
	  write (BS("Du greifst in die Spalte und findest einen Beutel, den "
	           +"Du sofort einsteckst."));
      Message(BS(TP->Name(WER)+" greift in eine Spalte"), 
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
	  clone_object("/d/gebirge/eros/obj/beutel")->move(this_player());
	  beutelfound =1;
    }
    return 1;
  }
  else
    return (notify_fail ("Da kannst du nicht hinein greifen.\n"),0);
}

reset()
{
  beutelfound = 0;
  ::reset();
}

string spalte(string str)
{
  if (beutelfound)
    return(BS("Die ganze Wand ist voller Spalten. Jemand duerfte schon "
             +"reingegriffen haben."));
  else
    return(BS("Die ganze Wand ist voller Spalten. Vielleicht kann man reingreifen."));
}

int zwaeng(string str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WO willst Du Dich durchzwaengen?\n"),0);
  if (str=="durch spalte" || str=="spalte")
    {
      write("Du machst Dich duenn und schluepfst durch eine Spalte.\n");
      Message(BS(TP->Name(WER)+" zwaengt sich durch eine Spalte."), 
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

      TP->move( "/d/gebirge/monimor/room/hoehle_01",M_GO);
      return 1;
    }
  else
    return (notify_fail("Da kannst Du dich nicht durchzwaengen.\n"),0);
}