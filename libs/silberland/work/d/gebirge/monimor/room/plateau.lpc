inherit "std/room";

#include "../def.h"

create()
{
  
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein Plateau in den Bergen");
  SetProp(P_INT_LONG, "Du stehst auf einem Plateau in den Bergen des "
    "Silberlands. Es ist circa zehn mal fuenf Meter gross. Ueberall siehst Du "
    "Knochen und Ueberreste von Lebewesen. Irgendjemand muss hier sehr hungrig "
    "gewesen sein. Vielleicht ist es auch fuer Dich gefaehrlich, noch laenger "
    "hier zu bleiben!");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "wesen", "lebewesen" }), 
    "Von Lebewesen kann man hier nicht mehr sprechen. Du siehst nur mehr "
    "ihre Ueberreste.");
  AddDetail( ({ "schnee", "baumgrenze" }), 
    "Auf manchen Bergspitzen liegt Schnee oberhalb der Baumgrenze.");
  AddDetail(({"hose","hemd"}),
    "Du kannst nicht mehr erkennen, was Hose und was Hemd war.");
  AddDetail("himmel",
    "Bis auf einige kleinere Wolken ist der Himmel blau und die Sonne strahlt."
  );
  AddDetail("sonne",
    "Die Sonne strahlt ungetruebt vom Himmel herab.");
  AddDetail(({"wolke","wolken"}),
    "Nur kleinere Wolken sind am Himmel zu sehen. Keine von ihnen verdeckt "
    "die Sonne.");
  AddDetail( ({ "stuecke", "stueck", "kleidung", 
                "kleidungsstuecke", "kleidungsstueck" }), 
    "Die Kleidungsstuecke sind durch einen grausamen Kampf zerfetzt worden, "
    "so dass Du nicht mehr zwischen Hose und Hemd unterscheiden kannst.");
  AddDetail( ({ "gestein" }), 
    "Das Gestein besteht aus Granit.");
  AddDetail( ({ "relief","aussehen" }), 
    "Es sieht so aus, als haette hier ein fuerchterlicher Kampf gewuetet. "
    "Die Waende sind total zerklueftet und das gibt ihnen ein bizarres "
    "Aussehen.");
  AddDetail( ({ "land" }), 
    "Dieses Gebiet ist eher als Gebirge zu bezeichnen.");
  AddDetail( ({ "gebiet", "gegend" }), 
    "Dieses Gebiet ist noch nicht kartographiert. Es gibt einige Geruechte, "
    "dass die Goetter dieses Land vergessen haben und deshalb das Boese "
    "ueber diese Gegend regiert.");
  AddDetail( ({ "geruechte", "boese" }), 
    "Geruechteweise soll das Boese ueber diese Gegend regieren.");
  AddDetail(({"goetter","woody", "dusty"}),
    "Woody und Dusty.");
  AddDetail( ({ "gang", "stollen" }), 
    "Durch einen Durchschlupf gelangst Du in einen Stollen, der durch das "
    "Gebirge fuehrt. Er ist natuerlich entstanden, ohne dass jemand Hand "
    "angelegt haette.");
  AddDetail(({"hand"}),
    "Der Stollen ist vollkommen natuerlich entstanden.");
  AddDetail( ({ "boden" }), 
    "Der Boden des Plateaus besteht aus Granit. Er ist uebersaeht von "
    "Knochen.");
  AddDetail( ({ "ausblick" }), 
    "Du hast einen schoenen Ausblick auf die umliegenden Berge.");
  AddDetail( ({ "wand", "waende", "felswand", "felswaende" }), 
    "Die Waende sind von tiefen Furchen durchzogen. Sie bestehen grossteils "
    "aus Granitgestein.");
  AddDetail( ({ "granit", "granitgestein" }), 
    "Granit ist ein besonders hartes, dreifaerbiges Gestein.");
  AddDetail( ({ "fels" }), 
    "Du kannst feststellen, dass es sich grossteils um Granit handelt.");
  AddDetail( ({ "baum", "baueme", "nadelbaum", "nadelbaeume", "baeumen",
                "schneegrenze" }), 
    "Manche Berge sind total mit Nadelbaeumen bewachsen, andere nur bis zur "
    "Schneegrenze, wieder andere Berge bestehen nur aus blankem Fels.");
  AddDetail( ({ "kette", "ketten", "berg", "berge", "bergkette", "bergketten" }), 
    "Du siehst viele Berge, allerdings duerfte dieses Gebiet noch nicht "
    "kartographiert sein, da Du keinen dieser Berge beim Namen kennst.");
  AddDetail(({"namen","schall", "rauch"}),
    "Namen sind auch nur Schall und Rauch.");
  AddDetail( ({ "spitze", "spitzen", "gipfel", "bergspitzen", "bergspitze" }), 
    "Du siehst die Gipfel einiger der hoechsten Berge dieses Gebirges. "
    "Manche sind mit Schnee bedeckt, andere sind dicht mit Baeumen "
    "bewachsen.");
  AddDetail( ({ "gebirge" }), 
    "Du stehst auf einem Plateau des Gebirges. Du hast einen schoenen "
    "Ausblick auf die Spitzen und Gipfel der grossen Bergketten dieser "
    "Gegend.");
  AddDetail( ({ "schlupf", "durchschlupf" }), 
    "Der Durchschlupf fuehrt in einen Stollen durch das Gebirge.");
  AddDetail( ({ "artefakte", "artefakt", "ueberbleibsel", "untier" }), 
    "Das duerften Ueberbleibsel eines Kampfes mit einem Untier sein.");
  AddDetail(({"fleisch","eingeweide"}),
    "So etwas siehst Du nicht mehr. Das wurde vermutlich schon gefressen.");
  AddDetail("plateau",
    "Auf dem Plateau liegen Knochen und Ueberreste von Lebewesen herum. "
    "Es misst circa 10 mal 5 Meter, wie Du schaetzt. Du siehst einen "
    "Durchschlupf, der in einen Gang in den Bergen fuehrt.Die Felswaende, "
    "die das Plateau begrenzen, zeigen viele Furchen und Spalten.");
  AddDetail(({"meter"}),
    "Circa 10 mal 5.");
  AddDetail("knochen",
    "Die Knochen sind bis auf den letzten Rest vom Fleisch befreit und "
    "zeigen Zahnabdruecke eines schier uebergrossen Tieres. Du hast auch "
    "schon gehoert, dass es hier im Silberland Drachen geben soll. Vielleicht "
    "ist es hier gefaehrlich!");
  AddDetail(({"tier","tieres"}),
    "Die Zahnabdruecke muessen von einem schier uebergrossem Tier stammen.");
  AddDetail(({"silberland"}),
    "Dort befindest Du Dich gerade.");
  AddDetail(({"drachen","drache"}),
    "Einem Drachen begegnet man frueher als einem lieb sein kann.");
  AddDetail(({"reste","ueberreste","rest", "unkenntlichkeit"}),
    "Unter den Ueberresten befinden sich Kleidungsstuecke, die bis zur "
    "Unkenntlichkeit zerfetzt wurden. Hier muss ein fuerchterlicher Kampf "
    "gewuetet haben. Fleisch oder Eingeweide siehst du allerdings nicht! Das "
    "scheint alles schon von dem Sieger verzehrt worden zu sein.");
  AddDetail(({"sieger"}),
    "Solch einem Sieger sollte man besser nicht begegnen.");
  AddDetail(({"spalten","spalte","furchen","furche", "umgebung", 
              "ursprung", "ursprungs"}),
    "Du siehst Dir das Relief der Umgebung genauer an und erkennst, dass "
    "dieses natuerlichen Ursprungs ist, oder vielleicht doch nicht? Wer "
    "weiss, vielleicht sind sie Artefakte eines grossen Kampfes, der "
    "sicherlich um Leben und Tod ging!");
  AddDetail(({"leben","tod", "kampf"}),
    "Ein Kampf auf Leben und Tod!");
  AddDetail(({"abdruecke","abdruck","zahnabdruecke","zahnabdruck"}),
  	"Die Knochen weisen riesige Zahnabdruecke auf. Sie wurden vermutlich "
  	"abgenagt.");

//--Ausgaenge--------------------------------------------------------------

  AddExit("suedosten", "./gang");

//--Items & NPCs-----------------------------------------------------------

  AddItem(TRN "mahldor", REFRESH_DESTRUCT,1);
}

