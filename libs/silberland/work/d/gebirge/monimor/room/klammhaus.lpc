inherit "std/room";

#include "../def.h"

string name;
string strSessel(string key);

create()
{
  ::create();

  name = 0;
//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Im Haus des weisen Mannes");
  SetProp(P_INT_LONG,
    "Du befindest Dich im Haus des weisen Mannes der Klamm der Seelen. "
    "Er hat gar keinen Namen, da er so weise ist, dass er die "
    "Ueberdruessigkeit der Klassifizierung der Lebewesen erkannt hat, "
    "und sich deshalb seines eigenen Namens entledigt hat. Du siehst Regale, "
    "einen Tisch, einen Sessel und eine kleine Kochnische. Sehr komfortabel "
    "ist das Zimmer also nicht eingerichtet, aber da der Weise so weise ist, "
    "dass er die Ueberdruessigkeit des Komforts erkannt hat, schlaeft er am "
    "liebsten auf dem Boden und beschraenkt sein Inventar auf das Notwendigste. Den "
    "Sessel und den Tisch allerdings wollte er nicht missen, vermutlich um etwas "
    "duemmeren Besuch allen Komfort zukommen zu lassen, den er nun nicht mehr "
    "zu geniessen pflegt. Das Haus kann man durch die Tuer wieder verlassen. "
    "Neben dieser ist ein einzelnes Fenster allerdings die einzige Oeffnung nach "
    "aussen."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_NO_MNPC,1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "duft" }), 
    "Der Duft von Nelken. Aber waere riechen nicht angebrachter?"
  );
  AddDetail( ({ "nelke", "nelken" }), 
    "Der Duft kommt vermutlich aus dem Garten."
  );
  AddDetail( ({ "inventar", "notwendigste" }), 
    "Viel ist nicht hier. Du siehst einen Stuhl, einen Tisch und Regale."
  );
  AddDetail( ({ "zimmer" }), 
    "Das Haus besteht aus nur einem Zimmer."
  );
  AddDetail( ({ "wand", "waende" }), 
    "Die Waende sind weiss gestrichen. Ausser "
    "einem Fenster und einer Tuer sind sie ungeschmueckt. "
    "Ausserdem sind Regale an den Waenden."
  );
  AddDetail( ({ "decke", "reichweite" }), 
    "Die Decke befindet sich ausser Reichweite. Sie ist ungeschmueckt "
    "und lediglich weiss gestrichen."
  );
  AddDetail( ({ "ofen" }), 
    "Der Ofen heizt zugleich das Haus und den Herd."
  );
  AddDetail( ({ "haus" }), 
    "Du bist im Haus des Weisen."
  );
  AddDetail( ({ "garten" }), 
    "Der Garten sieht durchs Fenster betrachtet "
    "richtig verwahrlost aus."
  );
  AddDetail( ({ "raum" }), 
    "Du stehst in einem Raum im Haus des weisen "
    "Mannes in der Klamm der Seelen."
  );
  AddDetail( ({ "staub", "schicht", "staubschicht" }), 
    "Als Du den Staub auf dem Herd betrachtest, "
    "erkennst Du, dass ueberall im Raum sich bereits Staub "
    "abgesetzt hat. Der weise Mann scheint laenger nicht hier "
    "gewesen zu sein. Wo mag er bloss sein?"
  );
  AddDetail( ({ "herd", "platte", "herdplatte", "platten", "herdplatten" }),
    "Es befindet sich eine feine Staubschicht "
    "ueber der Herdplatte. Der weise Mann duerfte bereits laenger "
    "nicht mehr gekocht haben."
  );
  AddDetail( ({ "nische", "kochnische" }), 
    "Die Kochnische besteht aus zwei Herdplatten "
    "und einem kleinen Ofen. Hier duerfte der weise Mann kochen."
  );
  AddDetail( ({ "sessel", "stuhl" }), #'strSessel
  );
  AddDetail( ({ "armlehnen", "armlehne", "komfort" }),
    "Zuviel Komfort ist auch nicht gut. Der weise Mann ist schon vor langer Zeit "
    "des Komforts ueberdruessig geworden."
  );
  AddDetail( ({ "mitte" }), 
    "In der Mitte des Raumes steht ein Tisch."
  );
  AddDetail( ({ "tisch" }), 
    "Der Tisch ist klein und rund. Er steht in "
    "der Mitte des Raumes. Er ist fuer die Besucher des weisen "
    "Mannes vorgesehen, damit diese weltlichen Komfort geniessen "
    "koennen."
  );
  AddDetail( ({ "oeffnung" }), 
    "Die Tuer und das Fenster sind die einzigen Oeffnungen nach aussen."
  );
  AddDetail( ({ "tuer", "tuere" }), 
    "Durch die Tuer kannst Du das Haus wieder verlassen."
  );
  AddDetail( ({ "fenster" }), 
    "Durch das Fenster siehst Du in den total verwahrlosten Garten."
  );
  AddDetail( ({ "bett" }), 
    "Der Weise schlaeft auf dem Boden. Ich weiss nicht wo Du ein Bett gesehen "
    "hast."
  );
  AddDetail( ({ "boden", "gesellschaft", "ueberdruessigkeit", "ueberdruessig" }), 
    "Der weise Mann schlaeft auf dem Boden. Er braucht den Komfort der "
    "modernen Gesellschaft nicht."
  );
  AddDetail(({"regal","regale"}), 
    "In den Regalen stehen massenweise Buecher, die der Weise vermutlich "
    "alle selbst geschrieben hat. Nur, niemand scheint sie lesen zu wollen."
  );
  AddDetail(({"buch","buecher", "ausgabe"}), 
    "Die meisten Buecher stehen in vielfacher Ausgabe hier. Niemand scheint "
    "die Buecher des Weisen lesen zu wollen. Vermutlich sind die "
    "Silberland-Bewohner einfach noch nicht reif fuer die unendliche Weisheit "
    "des Einsiedlers."
  );
  AddDetail( ({ "mann", "einsiedler", "bewohner", "weise" }),
    "Er scheint schon laengere Zeit weg zu sein."
  );
  AddDetail( ({ "zeit" }),
    "Zeit ist relativ."
  );
  AddDetail( ({ "besuch", "besucher" }),
    "Offensichtlich bist Du zu besuch."
  );
  AddDetail( ({ "namen", "lebewesen", "klassifizierung" }),
    "Er hat gar keinen Namen, da er so weise ist, dass er die "
    "Ueberdruessigkeit der Klassifizierung der Lebewesen erkannt hat, "
    "und sich deshalb seines eigenen Namens entledigt hat."
  );
  AddDetail( ({ "klamm", "seelen" }), 
    "Du befindest Dich in der Klamm der Seelen. Warum man hier ein Haus errichten "
    "sollte ist Dir allerdings nicht klar."
  );
  AddDetail( ({ "weisheit", "dummheit" }),
    "Die Weisheit des Einsiedlers ist nahezu unendlich. Nur die menschliche Dummheit "
    "ist noch groesser."
  );
  AddDetail( ({ "silberland" }),
    "Dort befindest Du Dich."
  );

  AddSound( DEFAULT_SOUND,
    "Es ist verdaechtig still in diesem Haus."
  );

  AddSound( ({ "stille", "still" }),
    "Liegt vielleicht daran das der Besitzer des Hauses nicht da ist."
  );

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Nelken."
  );

  AddSmell( ({ "nelke","nelken" }),
    "Es riecht nach Nelken."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("raus", "./klamm3");

  AddCmd( ({ "sitz", "sitze", "setz", "setze" }), "cmdsitzen" );
  AddCmd( ({ "steh", "stehe", "erheb", "erhebe" }), "cmdaufstehen" );

}

//--Funktionen fuer Kommandos----------------------------------------------

//auf Sessel sitzen:
int cmdsitzen(string str)
{
  notify_fail("Wo moechtest Du Dich hinsetzen?\n");

  if(!str || str == "") return 0;

  if(str == "auf sessel" || str == "in sessel")
  {
    if(name == getuid(TP))
    {
      write(BS("Aber Du sitzt doch schon im Sessel!"));
      return -1;
    }

    if(!name)
    {
      write(BS("Du machst es Dir in dem Sessel bequem."));
      Message(BS(TP->Name(WER)+" macht es sich in dem Sessel bequem.") ,MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      name = getuid(TP);
      return 1;
    }
    else
    {
      write(BS("Aber in dem Sessel sitzt schon "+capitalize(name)+"."));
      return -1;
    }
  }
  return 0;
}

//aufstehen:
int cmdaufstehen(string str)
{
  notify_fail("Von wo moechtest Du aufstehen?\n");

  if(!str || str == "") return 0;

  if(str == "von sessel auf" || str == "auf")
  {
    if(name == getuid(TP))
    {
      write(BS("Du stehst aus dem Sessel auf."));
      Message(BS(TP->Name(WER)+" steht aus dem Sessel auf."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      name = 0;
      return 1;
    }
    else
    {
      write(BS("Aber Du sitzt doch gar nicht im Sessel?"));
      return -1;
    }
  }
  return 0;
}

string strSessel(string key)
{
  string txt;
  txt= "Der Sessel hat ja nicht einmal eine Armlehne!!! Naja, der weise Mann "
      +"wollte das mit dem Komfort natuerlich auch nicht uebertreiben. ";

  if(name == getuid(TP))
    txt += "Du hast es Dir in ihm bequem gemacht. ";
  else if(name)
    txt += capitalize(name)+" hat es sich in ihm bequem gemacht. ";

  txt += "Der Sessel steht uebrigens neben dem Tisch.";

  return BS(txt);
}
