inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In der Hoehle");
  SetProp(P_INT_LONG,
    "Du hast einen Kreuzungspunkt in der Hoehle erreicht. Es fuehren zwei "
    "Wege nach Osten und Sueden und einer setzt den bisherigen Weg nach "
    "Nordwesten fort. Das Gefuehl der Platzangst macht nun der Angst vor "
    "der tiefen Finsternis Platz. Der Boden ist staubtrocken und die "
    "Waende, wie ueberall hier, voller Ritzen und Fugen. Du denkst Dir "
    "schoen langsam, ob sich irgendwer etwas dabei gedacht hat, als er "
    "diese toedlich langweilige Hoehle erschaffen hat.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12,ENV_TERRAIN:TT_CAVE]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "finsternis" }), 
    "Es ist sehr dunkel in diesem Teil der Hoehle."
  );
  AddDetail( ({ "gefuehl", "angst" }), 
    "Du hast nun nicht mehr Angst, dass es zu eng ist. Du fuerchtest Dich "
    "vor der Finsternis hier in der Hoehle."
  );
  AddDetail( ({ "decke" }), 
    "Die Decke wird hier wieder etwas niedriger. Selbst ein Zwerg haette "
    "Muehe aufrecht zu stehen."
  );
  AddDetail( ({ "wand","waende" }), 
    "In der Wand sind mehrere Ritzen und Fugen."
  );
  AddDetail( ({ "artefakt", "artefakte" }), 
    "Es sind Ritzen und Fugen, die beim Hoehlenbau entstanden sind."
  );
  AddDetail( ({ "wasser" }), 
    "Das Wasser kommt aus der oestlichen Hoehle. Um es naeher zu untersuchen, "
    "solltest Du dorthin gehen."
  );
  AddDetail( ({ "weg" }), 
    "Es fuehren Wege nach Osten, Sueden, Nordwesten und Suedosten. Sie sind "
    "alle eben und glatt. Auf dem Weg, der nach Osten fuehrt, bahnt sich "
    "etwas Wasser einen Weg aus der Hoehle."
  );
  AddDetail( ({ "hoehle" }), 
    "Dieser Teil der Hoehle stellt eine Kreuzung dar."
  );
  AddDetail( ({ "punkt", "kreuzung", "kreuzungspunkt","teil" }), 
     "Du bist an einem Kreuzungspunkt in der Hoehle. Wege fuehren nach Osten, "
     "Sueden, Suedosten und Nordwesten."
  );
  AddDetail(({"spalte","spalten","ritze","ritzen","fuge","fugen"}),
    "Du findest nichts besonderes an den Vertiefungen der Wand."
  );
  AddDetail(({"vertiefung","vertiefungen"}),
    "Es sind Spalten, Fugen und Ritzen in der Wand. Sie sind Artefakte des "
    "Hoehlenbaus. Im Gegensatz zur Wand ist der Boden aalglatt."
  );
  AddDetail("boden",
    "Der Boden ist aalglatt."
  );
  AddDetail("staub",
    "Nur weil der Boden staubrocken ist, muss hier noch lange kein Staub "
    "sein. Im Gegenteil: der Boden ist sauber und glatt."
  );
  
//--Ausgaenge--------------------------------------------------------------

  AddExit("nordwesten", "./hoehle4");
  AddExit("osten", "./hoehle5");
  AddExit("sueden", "./hoehle6");
  AddExit("suedosten", "./hoehle2");
}
