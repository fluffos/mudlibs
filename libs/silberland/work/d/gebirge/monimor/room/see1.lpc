inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Am Seeufer"
  );
  SetProp(P_INT_LONG,
    "Du stehst am Ufer eines Sees in der Klamm der Seelen. Der "
    "See ist die Heimat des gefuerchteten Ruesselwurms. Vermutlich "
    "hast Du schon seine Bekanntschaft gemacht ;) Obwohl Du hier am "
    "Ufer eines Sees stehst, erinnert Dich dieser Anblick nicht an die "
    "schoenen Gebirgs- oder Badeseen, die Du sonst gewohnt bist. Alles "
    "was Du hier siehst, ist eine Kloake, verdreckt und .. tja voll Blut. "
    "Schwimmen willst Du auf alle Faelle nicht mehr. Rings um den See sind "
    "Felswaende, ebenso blutverschmiert, wie der Boden hier. Der Ruesselwurm "
    "scheint einiges verbrochen zu haben."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "anblick" }),
   "Dieser Anblick laesst Dich erstarren. Was Du siehst, deutet auf "
   "fuerchterliche Kaempfe hin."
  );
  AddDetail( ({ "kaempfe", "kampf", "wunder" }),
    "Die Kaempfe muessen verheerend gewesen sein."
  );
  AddDetail( ({ "ufer" }),
   "Es ist das Ufer des Sees, in welchem der Ruesselwurm lebt."
  );
  AddDetail( ({ "see", "kloake", "wasser" }),
   "Der See ist eher als Kloake zu bezeichnen. Das Wasser ist schmutzig und "
   "blutrot, kein Wunder nach dem Kampf, der hier stattgefunden haben muss."
  );
  AddDetail( ({ "gebirgssee", "badesee" }),
    "Der See bietet wirklich nicht den Anblick eines schoenen, ruhigen und "
    "traumhaften Sees."
  );
  AddDetail("blut",
    "Das Blut ist teils noch fluessig, teils nicht mehr. Der fluessige "
    "Teil duerfte von dem Kampf, der erst vor kurzem hier stattgefunden "
    "haben muss, stammen, das bereits verklumpte Blut scheint von frueheren "
    "Mahlzeiten des Ruesselwurms zu sein."
  );
  AddDetail( ({ "teil" }),
    "Der fluessige."
  );
  AddDetail( ({ "mahlzeiten" }),
    "Hier nimmt der Ruesselwurm scheinbar seine Mahlzeiten zu sich."
  );
  AddDetail(({"verklumptes Blut","altes Blut"}),
    "Als Du so das geronnene Blut betrachtest, laeuft es Dir kalt den "
    "Ruecken hinunter, bei dem Gedanken, dass Du auch einmal so enden "
    "haettest koennen. Andererseits bedauerst Du diejenigen, die hier schon "
    "gestorben sind."
  );
  AddDetail(({"wand","waende","felswand","felswaende"}),
    "Die Felswaende sind blutverschmiert, was an einen gewaltigen "
    "Kampf erinnert."
  );
  AddDetail("boden",
    "Der Boden ist wie auch die Felswaende voll Blut. Einzelne "
    "Leichenteile sind noch erkennbar, aber ansonsten siehst Du nichts "
    "am Boden."
  );
  AddDetail(({"teile","leichenteile"}),
    "Du glaubst einen Menschen- und einen Elfenknochen identifizieren "
    "zu koennen. Allerdings siehst Du keine Zwergenknochen. Tja, Zwerge "
    "duerften also doch die kluegsten Lebewesen sein."
  );
  AddDetail( ({ "lebewesen", "zwergenknochen", "zwerge" }),
    "Es liegen keine Zwergenknochen da, sie sind eindeutig die kluegsten "
    "Lebewesen."
  );
  AddDetail(({"knochen","menschenknochen","elfenknochen"}),
    "Du betrachtest die Knochen, und kannst sie voneinander "
    "unterscheiden. Du bist stolz auf Deine Leistung, laesst "
    "die Knochen aber sofort von Ekel gepackt wieder fallen."
  );
  AddDetail( ({ "leistung" }),
    "Die einzelnen Knochen zu unterscheiden war gar nicht so leicht."
  );
  AddDetail( ({ "ekel" }),
    "Du schuettelst Dich."
  );
  AddDetail( ({ "bekanntschaft", "ruesselwurm" }),
    "Du bist ihm schon begegnet, oder?"
  );
  AddDetail( ({ "faelle", "lust" }),
    "Auf schwimmen hast Du keine Lust mehr."
  );
  AddDetail( ({ "heimat" }),
    "Der See ist die Heimat des Ruesselwurms."
  );
  AddDetail( ({ "himmel", "sonne" }),
    "Der Himmel ist grau und absolut trostlos. Die Sonne versteckt sich "
    "erfolgreich."
  );
  AddDetail( ({ "klamm", "seelen" }),
    "Die Klamm der Seelen."
  );

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach abgestandenem Blut.\n"
  );
  AddSmell("blut",
    "Das Blut stinkt bestialisch.\n"
  );
  AddSmell("see",
    "Der See stinkt nache dem Blut, das sich in ihn ergoss.\n"
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("westen", "./see" );

//--Items & NPCs-----------------------------------------------------------

  AddItem(KOBJ "wecker",REFRESH_REMOVE);

}
