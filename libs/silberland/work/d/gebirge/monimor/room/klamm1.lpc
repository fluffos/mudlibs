inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include <defines.h>

#define ENTERLOG "/d/gebirge/monimor/log/klamm_enter"

nosave mapping entered = ([]);

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Schlucht"
  );
  SetProp(P_INT_LONG, 
    "Du bist auf dem Weg in die Klamm der Seelen. Es geht maessig bergab, "
    "so dass Du keine Probleme hast weiterzukommen. Weiter im Nordosten "
    "scheint allerdings der Nebel zuzunehmen und im Osten zweigt seltsamerweise "
    "ein kleiner Weg ab (Bedenke, dass Du selbst gerade nicht auf einem "
    "Weg bist.)"
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15,ENV_TERRAIN:TT_MOUNTAIN]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "fuss", "fuesse" }), 
   "Das sind Deine eigenen Fuesse."
  );
  AddDetail( ({ "himmel" }), 
    "Du kannst den Himmel durch den Nebel fast nicht mehr erkennen."
  );
  AddDetail( ({ "gestank" }), 
    "Es stinkt. Vielleicht solltest Du mal schnuppern, um genauer herauszufinden, "
    "was da so stinkt."
  );
  AddDetail("nase",
    "Das ist wohl Deine eigene Nase."
  );
  AddDetail("schwefel",
    "Es riecht danach."
  );
  AddDetail( ({ "feld", "geroellfeld" }), 
    "Das Geroellfeld liegt suedlich von hier."
  );
  AddDetail( ({ "boden" }), 
    "Der Boden ist von Steinen uebersaeht. Auf dem kleinen Weg sind allerdings "
    "feine Kieselsteine."
  );
  AddDetail( ({ "schlucht" }), 
    "Du bist in der Klamm der Seelen."
  );
  AddDetail( ({ "erdfurche", "furche" }), 
    "Du bist in der Klamm der Seelen, einer Schlucht."
  );
  AddDetail( ({ "klamm", "seelen" }), 
    "Du befindest Dich in der Klamm der Seelen. Sie ist eine langgezogene "
    "Erdfurche."
  );
  AddDetail( ({ "nebel" }), 
    "Der Nebel wird je tiefer Du in die Klamm vordringst dichter. Er riecht "
    "irgendwie seltsam."
  );
  AddDetail( ({ "steine", "kieselsteine" }), 
    "Die Kieselsteine sind viel feiner als die Steine auf dem Geroellfeld. "
    "Der Weg scheint absichtlich angelegt worden zu sein."
  );
  AddDetail("weg",
    "Der Weg scheint von Menschenhand geformt. Du koenntest nachsehen, wohin er "
    "Dich fuehrt. Die Kieselsteine am Boden scheinen sich etwas von denen in "
    "der Klamm zu unterscheiden."
  );
  AddDetail( ({ "probleme" }),
    "Noch hast Du keine."
  );
  AddDetail( ({ "menschenhand" }),
    "Der Weg scheint von Menschenhand geformt worden zu sein."
  );

  AddSound(DEFAULT_SOUND,
    "Du hoerst ein paar Kieselsteine unter Deinen Fuessen knirschen."
  );
  AddSound(({"steine","stein","kieselstein","kieselsteine"}),
    "Wenn Du auftrittst, knirscht es unter Deinen Fuessen."
  );

  AddSmell(DEFAULT_SMELL,
    "Der Nebel riecht fast schwefelig."
  );
  AddSmell("schwefel",
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("nebel", 
    "Der Nebel riecht etwas nach Schwefel, genau kannst "
    "Du das nicht definieren."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig. Das ist wohl der Nebel."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("nordosten", "./klamm2");
  AddExit("osten", "./klamm3");
  AddExit("sueden", "./klamm");

//--Items & NPCs-----------------------------------------------------------

  AddItem(KNPC "seelendieb", REFRESH_DESTRUCT);
}

void init()
{
  ::init();
  if (!TP) return;
  if (member(entered, getuid(TP))) return;
  entered += ([getuid(TP)]);
  write_file (ENTERLOG,
    sprintf ("%s: %s betritt die Klamm der Seelen.\n",
    dtime(time()), CAP(getuid(TP))));
}
