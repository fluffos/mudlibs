inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Eine Kreuzung in der Klamm der Seelen");
  SetProp(P_INT_LONG,
    "Du hast nun endlich den Boden der Klamm erreicht, wo sich scheinbar "
    "eine Art natuerliche Kreuzung befindet. Die Felswaende ragen hier "
    "besonders hoch zum Himmel, sodass Du diesen, schon allein wegen des "
    "dichten Nebels, kaum noch sehen kannst (Du meinst zumindest, dass das, "
    "woher das Licht kommt, die Sonne am Himmelszelt ist). Nach Norden steigt "
    "der Weg etwas an und nach Westen kannst Du durch eine Spalte schluepfen. "
    "Auch der Boden besteht jetzt aus blankem Fels.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15,ENV_TERRAIN:TT_MOUNTAIN]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "sueden" }), 
    "Das ist der Weg, der aus der Klamm hinaus fuehrt."
  );
  AddDetail( ({ "sackgasse", "gasse" }), 
    "Der Weg im Osten fuehrt in eine Sackgasse."
  );
  AddDetail( ({ "osten" }), 
    "Der Weg fuehrt in eine Sackgasse."
  );
  AddDetail( ({ "norden" }), 
    "Hier steigt der Weg etwas an."
  );
  AddDetail( ({ "westen" }), 
    "Im Westen ist ein Weg durch eine Spalte."
  );
  AddDetail( ({ "richtung", "richtungen", "himmelsrichtung", "himmelsrichtungen" }), 
    "Die vier Himmelsrichtungen sind: Norden, Osten, Sueden und Westen. In "
    "jede dieser Richtungen fuehrt ein Weg."
  );
  AddDetail( ({ "klamm", "punkt" }), 
    "Du bist am tiefsten Punkt der Klamm angekommen. Auch der Nebel ist hier "
    "am dichtesten."
  );
  AddDetail( ({ "nebel" }), 
    "Hier ist der Nebel absolut am dichtesten, weil Du am tiefsten Punkt der "
    "Klamm angekommen bist."
  );
  AddDetail( ({ "fels" }), 
    "Der Fels ist hier blitzblank, keine Spalte, keine Ritze, nichts, was "
    "Du normalerweise an einer Felswand vermuten wuerdest."
  );
  AddDetail( ({ "spalte" }), 
    "Das ist eine groessere Spalte, durch die Du nach Westen weitergehen kannst."
  );
  AddDetail( ({ "ritzen", "spalten", "ritze" }), 
    "Keine Ritzen und Spalten vorhanden."
  );
  AddDetail( ({ "felswand", "felswaende", "wand", "waende" }), 
    "Die Waende sind aus blankem Fels. Du siehst weder Ritzen, noch Spalten."
  );
  AddDetail( ({ "licht" }), 
    "Es ist nicht besonders hell, die Sonne gibt nur mattes Licht."
  );
  AddDetail( ({ "sonne" }), 
    "Du meinst die Sonne am Himmel zu erkennen, sie gibt allerdings nur "
    "mattes Licht."
  );
  AddDetail( ({ "himmel", "himmelszelt", "zelt" }), 
    "Du meinst den Himmel erkennen zu koennen, aber bei diesem Nebel ist das "
    "eher unwahrscheinlich."
  );
  AddDetail(({"stelle","stellen"}),
    "An manchen Stellen schimmert der Felsboden richtig, so als ob viele "
    "Leute ihn mit ihren Schuhsohlen poliert haetten."
  );
  AddDetail( ({ "weg", "kreuzung", "art" }), 
    "Vier Wege fuehren von hier in die vier Himmelsrichtungen. Nach Norden "
    "steigt der Weg an, nach Westen fuehrt ein Weg in eine Spalte."
  );
  AddDetail(({"boden", "felsboden" }),
    "Der Boden besteht aus blankem Fels. Er macht den Eindruck, als ob "
    "haeufig Personen hier herumgehen, weil er an manchen Stellen besonders "
    "schimmert."
  );
  AddDetail( ({ "eindruck", "personen", "leute" }),
    "Viele Personen haben den Boden an manchen Stellen blankgerieben."
  );
  AddDetail( ({ "schuhsohlen", "sohlen" }),
    "Viele Schuhsohlen haben diesen Boden bereits gesehen."
  );
  AddDetail("nase",
    "Das ist wohl Deine eigene Nase."
  );

  AddSound( DEFAULT_SOUND,
    "Absolut still."
  );

  AddSmell(DEFAULT_SMELL,
    "Der Nebel riecht schwefelartig. Es faellt Dir schwer zu atmen."
  );
  AddSmell("schwefel",
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("nebel", 
    "Der Nebel riecht nach Schwefel."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig. Das ist wohl der Nebel."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("westen", "./klamm6");
  AddExit("osten", "./klamm5");
  AddExit("sueden", "./klamm2");
  AddExit("norden", "./klamm7");

//--Items & NPCs-----------------------------------------------------------

  AddItem(KNPC "seelendieb",REFRESH_DESTRUCT);
}
