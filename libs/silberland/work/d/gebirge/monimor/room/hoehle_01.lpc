inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer Drachenhoehle");
  SetProp(P_INT_LONG, 
    "Du bist in einer Hoehle angekommen, die Dir kalte Schauer ueber "
    "den Ruecken jagt. Hier muessen schon viele Kaempfe stattgefunden "
    "haben. Ueberall klebt ausgetrocknetes Blut und vereinzelt liegen "
    "Knochen herum.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);

//--Details----------------------------------------------------------------

  AddDetail( ({"hoehle","drachenhoehle"}),
    "Diese Hoehle wird von einem Drachen bewohnt. Ueberall liegen "
    "Knochen herum und Blut klebt an den Waenden."
  );
  AddDetail("schauer",
    "Du hast ein mulmiges Gefuehl."
  );
  AddDetail("gefuehl",
    "Du fuehlst Dich nicht wohl hier. Es koennte Dir uebel bekommen, noch "
    "laenger hier zu bleiben."
  );
  AddDetail("ruecken",
    "Auf Deinem Ruecken stehen die Haare zu Berge."
  );
  AddDetail(({"berg","berge"}),
    "Sicher nicht das Gebirge, in dem diese Hoehle sich befindet."
  );
  AddDetail(({"gebirge","hoehle","klamm"}),
    "Diese Hoehle befindet sich in den Bergen der Klamm der Seelen."
  );
  AddDetail(({"haar","haare"}),
    "Deine Haare wollen sich gar nicht mehr beruhigen."
  );
  AddDetail(({"kampf","kaempfe"}),
    "Du kannst nur noch die Ueberreste mehrerer Kaempfe erkennen."
  );
  AddDetail(({"rest","reste","ueberrest","ueberreste"}),
    "Blut und Knochen zeugen von mehreren Kaempfen."
  );
  AddDetail("blut",
    "Das Blut stammt vermutlich von verwegenen Abenteurern, die sich mit "
    "dem Drachen eingelassen haben. Es ist bereits eingetrocknet."
  );
  AddDetail("abenteurer",
    "Du siehst nur noch deren Ueberreste."
  );
  AddDetail("knochen",
    "Die Knochen sind fein saeuberlich abgeleckt worden. Der Drache duerfte "
    "mehrere Festmahle abgehalten haben."
  );
  AddDetail("festmahl",
    "Sie zu, dass Du nicht das naechste bist."
  );
  AddDetail(({"wand","waende"}),
    "Du kamst aus einer Spalte im Norden und im Westen ist ein Durchgang zu "
    "sehen. An den Waenden klebt Blut."
  );
  AddSpecialDetail(({"westen","gang","durchgang"}),
    "gang"
  );
  AddDetail(({"norden","spalte"}),
    "Durch die Spalte im Norden kommst Du zurueck in die Wohnhoehle."
  );
  AddDetail("wohnhoehle",
    "Du kannst die Wohnhoehle von hier nicht erkennen."
  );

//--Items&Npcs-------------------------------------------------------------

  AddItem(KNPC "hdrache",REFRESH_DESTRUCT);

//--Ausgaenge--------------------------------------------------------------

  AddGuardedExit("westen", "./hoehle_02",
                 "drache",
                 "Der Drache versperrt Dir den Weg nach Westen.\n");
  AddExit("spalte", "./hoehle4");
}

gang()
{
  if (present ("\nworm"))
    return "Der Drache versperrt den Gang. Du kannst nicht viel ausser dem Drachen erkennen.\n";
  else
    return "Der Gang nach Westen ist frei begehbar.\n";
}