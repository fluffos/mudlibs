inherit "std/room";

#include <moving.h>
#include <player.h>
#include "../def.h"

create()
{

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In einem Loch.");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem Loch, in dem Du "
  	"gluecklicherweise noch aufrecht stehen kannst. Irgendwie riecht es etwas "
  	"modrig und faulig. Du ueberlegst, woher das kommen kann und siehst Dich "
  	"etwas um. Da faellt Dir das Moos am Boden auf. Die Waende wiederum sind "
  	"spiegelglatt und die Decke zeigt vereinzelt Tropfsteine, von welchen "
  	"langsam Wasser in einzelne Pfuetzen am Boden tropft.");
  	
//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);

//--Details----------------------------------------------------------------

  AddDetail( ({ "decke" }),
    "Von der Decke haengen Tropfsteine herunter. Es muss eine lange Zeit "
    "vergangen sein bis die Tropfsteine so aussahen wie sie heute aussehen."
  );
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind hier, wie anscheinend ueberall, spiegelglatt. "
    "Weder Spalten noch Risse sind zu finden."
  );
  AddDetail(({"steine","stein","tropfsteine","tropfstein", "stalaktiten"}),
    "Tropfsteine sind Kalkablagerungen und entstehen in Hoehlen durch kalkhaltiges, "
    "fliessendes und insbesondere durch tropfendes Wasser. Der Wasserfluss "
    "ist dabei in der Regel sehr gering."
  );
  AddDetail( ({ "moos", "lebensform" }),
    "Das Moos waechst am Boden und scheint sich vom Wasser der Pfuetzen zu "
    "ernaehren. Vielleicht stinkt es deshalb so. Jedenfalls duerfte das Moos "
    "die einzige Lebensform sein, die dieses Wasser entgiften kann."
  );
  AddDetail( ({ "wasser" }),
    "Das Wasser tropft von den Tropfsteinen herab und sammelt sich in einzelnen "
    "Pfuetzen. Es stinkt bestialisch. Du solltest nicht davon trinken."
  );
  AddDetail( ({ "pfuetze", "pfuetzen" }),
    "Sie enthalten das Wasser, das von den Tropfsteinen heruntertropft. "
    "Scheinbar ernaehren sie mit dem Wasser das Moos."
  );
  AddDetail("boden",
    "Am Boden sind vereinzelt Pfuetzen und etwas Moos, ausserdem stehst Du "
    "grade drauf."
  );
  AddDetail( ({ "kopf"}),
    "Du musst vorsichtig sein, das Du Dir nicht den Kopf an der niedrigen Decke "
    "stoesst. "
  );
  AddDetail( ({ "loch" }),
    "Hoehle waere zu sehr geschmeichelt fuer dieses Loch."
  );
  AddDetail( ({ "hoehle" }),
    "Eher ein Loch."
  );
  AddDetail( ({ "spalten", "risse" }),
    "Nicht zu finden."
  );
  AddDetail( ({ "kalkablagerungen", "kalkablagerung", "ablagerungen", 
                "ablagerung" }),
    "Kalk lagert sich an der Decke ab und bildet so die Stalaktiten. "
  );
  AddDetail( ({ "zeit" }),
    "Tropfsteine entstehen und wachsen im menschlichen Massstab gesehen nur sehr "
    "langsam. Die genaue Geschwindigkeit von Tropfsteinen variiert jedoch und "
    "haengt von mehreren Faktoren ab"
  );
  AddDetail( ({ "massstab", "jahrzehnte" }),
    "Der menschliche Massstab umfasst meist nur wenige Jahrzehnte. Tropfsteine "
    "entstehen in einer viel laengeren Zeit."
  );
  AddDetail( ({ "geschwindigkeit", "tropfsteinwachstums" }),
    "Die Geschwindigkeit des Wachstums von Tropfsteinen haengt von mehreren "
    "Faktoren ab."
  );
  AddDetail( ({ "wachstum" }),
    "Das Wachstum der Tropfsteine kann durch Hoehlenbesucher gestoert werden. "
    "Beruehrt man einen Tropfstein, so setzt sich Fett von der Haut ab und "
    "verhindert an dieser Stelle zukuenftige Kalkablagerungen."
  );
  AddDetail( ({ "hoehlenbesucher", "besucher" }),
    "So wie Du einer bist."
  );
  AddDetail( ({ "fett", "haut", "stelle" }),
    "Beruehrt man einen Tropfstein, so setzt sich Fett von der Haut ab und "
    "verhindert an dieser Stelle zukuenftige Kalkablagerungen."
  );
  AddDetail( ({ "faktoren" }),
    "Da waeren die Kalkkonzentration im Wasser, der CO2-Gehalt im Wasser und "
    "in der Hoehle, ausserdem die Menge des herabtropfenden Wassers und "
    "schliesslich die Temperatur."
  );
  AddDetail( ({ "kalkkonzentration", "co2", "co2-gehalt", "gehalt", "menge",
                "temperatur" }),
    "Alles Faktoren die die Geschwindigkeit des Tropfsteinwachstums beeinflussen."
  );
  AddDetail( ({ "regel" }),
    "In der Regel ist der Wasserfluss sehr gering."
  );
  AddDetail( ({ "wasserfluss" }),
    "Der Wasserfluss ist hier nur sehr gering."
  );

  AddSound(({DEFAULT_SOUND,"wasser"}),
    "Ab und zu tropft etwas Wasser herunter."
  );

  AddSmell(DEFAULT_SMELL,
    "Irgendwie riecht es modrig."
  );
  AddSmell("moder",
    "Ekelhaft, das kann nicht gesund sein."
  );
  AddSmell(({"wasser","pfuetze"}),
    "Das Wasser der Pfuetzen stinkt modrig."
  );
  AddSmell(({"moos"}),
    "Sogar das Moos stinkt wegen dem Wasser."
  );
  
  AddCmd(({"trinke","trink"}),"trinke" );
  
  AddExit("raus", "./klamm7");
}

int trinke(string str)
{
  notify_fail ("WORAUS willst Du trinken?");
  if (str=="aus pfuetze" || str == "wasser" || str == "wasser aus pfuetze") 
  {
    write ("Dich durchfaehrt ein schrecklicher Schmerz.\n");
    Message(BS(TP->name(WER)+" hat versucht, sich zu vergiften."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    SetProp(P_KILL_NAME, "Giftiges Wasser" );

    TP->Defend(50+random(50), DT_POISON, 1, TO);
    return 1;
  }
  else
    return (notify_fail ("Daraus kannst Du nicht trinken.\n"),0);
}