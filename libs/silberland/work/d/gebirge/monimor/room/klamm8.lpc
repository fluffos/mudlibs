inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

int schuttweg;

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"Eine Abzweigung in der Felsspalte");
  SetProp(P_INT_LONG,
    "Der Weg macht hier eine Wende nach Suedwesten "
  	"und fuehrt weiter an der Felswand entlang. Der Weg erinnert Dich an all "
  	"die anderen hier in der Klamm, nur etwas ist seltsam.");

//--Umgebung---------------------------------------------------------------

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "himmel" }),
    "Du kannst den Himmel durch den Nebel nicht erkennen."
  );
  AddDetail( ({ "nebel" }),
    "Der Nebel ist hier doch wieder ziemlich dicht."
  );
  AddDetail( ({ "schlucht" }),
    "Die Klamm der Seelen."
  );
  AddDetail( ({ "stein", "steine" }),
    "Der Schutt besteht aus Steinen."
  );
  AddDetail( ({ "rand" }),
    "Am Rand des Weges kannst Du etwas erkennen."
  );
  AddDetail( ({ "klamm", "seelen" }),
    "Die Klamm der Seelen."
  );
  AddDetail( ({ "verlauf" }),
    "Der Verlauf dieser Spalte ist bedingt durch die Macht von Monimors "
    "Urgrossvater, der die Klamm erschuf."
  );
  AddDetail( ({ "knick", "wende" }),
    "Die Klamm gibt hier einen Verlauf von Suedosten nach Suedwesten vor, "
    "so entsteht hier ein Knick."
  );
  AddDetail( ({ "fels", "felswand" }),
    "Die Waende bestehen aus blankem Fels. Der Fels ist seltsam dunkel, "
    "schwarz kann man ihn nicht nennen, einfach...dunkel."
  );
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind aus blankem Fels, nur etwas ist anders."
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist etwas anders als sonst hier in der Schlucht."
  );
  AddDetail( ({ "weg" }),
    "Der Weg macht hier einen Knick von Suedosten nach Suedwesten. Am "
    "Rand siehst Du etwas."
  );
  AddDetail("etwas",
    "Jetzt weisst Du was Dich hier stoert: Hier liegt "+
  	"jede Menge Schutt an der Wand. Es sieht aus, als waere er von oben "+
  	"(wo auch immer das ist, das kannst Du bei diesem Nebel ja nicht "+
  	"feststellen) heruntergefallen.");
  AddDetail("schutt",
    "Er scheint von oben heruntergefallen zu sein. "+
  	"Vielleicht verbirgt er ja etwas?");
  AddDetail("macht",
    "Seine Macht war nahezu grenzenlos."
  );
  AddDetail( ({ "menschen", "seelen", "wut", "urgrossvater" }),
    "Vor lauter Wut auf die Menschen lies Monimors Urgrossvater seine Axt den "
    "Boden spalten und verfluchte alle Seelen der Menschen, die hier sterben "
    "sollten, auf ewig hier gefangen zu sein."
  );
  AddDetail( ({ "sage" }),
    "Der Sage nach ist die Klamm so entstanden, dass der Urgrossvater Monimors, "
    "ein grosser und maechtiger Gott, vor lauter Wut auf die Menschen mit seiner "
    "Axt den Boden spaltete und die Seelen der Menschen verfluchte."
  );
  AddDetail( ({ "axt", "erdspalte", "spalte" }),
    "Die Erdspalte sieht wie von einer riesigen von goettlicher Hand gefuehrten "
    "Axt gezogen aus."
  );
  AddDetail( ({ "hand", "gott" }),
    "Der Sage nach fuehrte Monimors Urgrossvater diese Axt."
  );
  AddDetail("nase",
    "Du tastest nach Deiner Nase. Oh mein Gott! Sie ist weg ... Puh, Glueck "
    "gehabt da ist sie. Der Nebel hat Dich nur Dein Ziel verfehlen lassen."
  );
  AddDetail(({"glueck"}),
    "Glueck gehabt. Deine Nase ist noch da."
  );
  AddDetail("ziel",
    "Deine Nase war Dein Ziel."
  );

  AddSpecialDetail("schutt","d_schutt" );
  AddSpecialDetail(({"eingang","hoehleneingang","hoehle"}),"d_hoehle");

  AddSound(({DEFAULT_SOUND,"wind","brise"}),
    "Du hoerst den Wind durch die Klamm ziehen."
  );

  AddSmell(DEFAULT_SMELL,
    "Der Nebel riecht schwefelartig. Es faellt Dir schwer zu atmen."
  );
  AddSmell("schwefel",
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("nebel", 
    "Der Nebel riecht nach Schwefel."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig. Das ist wohl der Nebel."
  );

//--Items & NPCs-----------------------------------------------------------

  AddItem(KNPC "seelendieb", REFRESH_DESTRUCT);

//--Ausgaenge--------------------------------------------------------------

  AddExit("suedosten", "./klamm6");
  AddExit("suedwesten", "./klamm9");

//--Kommandos--------------------------------------------------------------

  AddCmd(({"betrete","betritt","kletter","klettere"}), "hoehle" );
  AddCmd(({"raeum","raeume"}),"raeume"  );

  schuttweg=0;
}
int raeume(string str)
{
  if(!stringp(str) || str=="")
   return (notify_fail("WAS willst du weg raeumen?\n"),0);
   
  if (str == "schutt weg") 
  {
    if (schuttweg)
      write("Das ist doch schon geschehen.\n");
    else
    {
      write(BS("Du findest einen Hoehleneingang, nachdem du den Schutt "
    	   +"beiseite geraeumt hast."));
      Message(BS(TP->name(WER,2)+" raeumt den Schutt weg."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      schuttweg = 1;
    }
    return 1;
  }
  else
    return(notify_fail("Das kannst du nicht wegraeumen.\n"), 0);
}

string d_schutt(string key)
{
  if(schuttweg)
    return "Du siehst weggeraeumten Schutt und den vorher verborgenen Eingang.\n";
  else
    return BS("Der Schutt scheint von oben herabgefallen zu sein, vielleicht ist "
          +"etwas dahinter verborgen? Du muesstest den Schutt wegraeumen.");
}
int hoehle(string str)
{
  notify_fail("WAS willst Du denn betreten?\n"  );
  if (str == "eingang" || str == "hoehle" || str=="in eingang" || str=="in hoehle")
  {
    if (schuttweg)
    {
      write ("Du betrittst den Hoehleneingang.\n");
      Message(BS(TP->name(WER,2)+" betritt den Hoehleneingang."),
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      this_player()->move("/d/gebirge/monimor/room/hoehle",M_GO);
      return 1;
    }
    else
      return notify_fail(BS("Du solltest den Eingang erst freilegen, "
       "bevor du ihn betrittst.")),0;
  }
}

reset()
{
  schuttweg = 0;
  ::reset();
}

string d_hoehle(string key)
{
  if (schuttweg)
    return "Du siehst den Eingang zu einer Hoehle. Du kannst sie betreten.\n";
  else
    return "Du solltest erst einmal den Eingang zur Hoehle finden.\n";
}
