inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../moni.h"

int amulettfound;

create()
{
  ::create();

  amulettfound=0;     // Amulett=Eintrittskarte nach Morkas.

  SSH("Im Hort des Hoehlendrachen");
  SLO("Das ist der Hort des Hoehlendrachen. Hier hat er seine 'Schaetze' "
+"versteckt. Es liegt ein grosser Haufen auf dem Boden.");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);

// Raumdetails

  AddDetail("boden","Der Boden ist bedeckt von den 'Schaetzen' "
+"des Drachen.\n");
  AddDetail("decke","Der Drache hat die Decke kuenstlich etwas "
+"hoeher gemacht, weil er ansonsten nicht hereingepasst haette.\n");
  AddDetail("hort","Hier bewahrt der Drache seine 'Schaetze' auf, die "
+"er mit seinem Leben bewachte. Etwas Wertvolles sollte deshalb "
+"doch dabeisein.\n");
  AddDetail(({"drache","hoehlendrache"}),"Der Drache hat mit seinem "
+"Leben bezahlt, um zu verhindern, dass Du hier her kommst.\n");
  AddDetail(({"wertvolles","schatz","schaetze"}),"Diese Definition ist "
+"wohl sehr subjektiv. Du siehst hier eigentlich nur Geruempel am "
+"Boden liegen.\n");
  AddDetail("hoehle","Die Hoehle wurde vom Drachen kuenstlich "
+"hoeher gemacht. Sie ist der Hort des Drachen.\n");
  AddSpecialDetail("geruempel","geruempel");
  AddDetail("definition","Was definierst Du als Schatz?\n");
  AddDetail("haufen","Die 'Schaetze' des drachen tuermen sich fast "
+"bis an die Decke.\n");
  AddDetail(({"ruestung","ruestungen","schwert","schwerter"}),"Alles "
+"zerbrochen. Hier hat der Drache wohl etwas uebertrieben.\n");
  AddDetail("alles","Definitiv alles ist zerbrochen, was auf dem Haufen "
+"herumliegt.\n");

  AddExit("osten",HOEHLE("hoehle_01"));
}

geruempel()
{
object ob,am;
  if (amulettfound)
    return "Du siehst einen Haufen Geruempel am Boden herumliegen. Zerbrochene Ruestungen und Schwerter, alles nutzlos und unbrauchbar.\n";
    else
      {
        write("Du durchwuehlst den Haufen Geruempel und findest ausser "
+"zerbrochenen Schwertern und Ruestungen einige Muenzen und ein "
+"Amulett, was Du sofort einsteckst.\n");
        ob = CLONEOB ("/obj/money");
        ob->SetProp(P_AMOUNT, 1000+random(500));
        ob->move(TP);
        am = CLONEOB(OBJ("amulett"));
        am->move(TP);
        amulettfound=1;
        return 1;
      }
}