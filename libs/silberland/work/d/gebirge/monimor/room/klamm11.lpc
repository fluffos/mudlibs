inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"
int erdeweg;

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In einer Sackgasse");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer weiteren Sackgasse der Klamm der Seelen. "
    "Hier ist nun absolut kein Nebel mehr. Dieses Ende der Schlucht duerfte "
    "eine Art Abzug darstellen, der die warme Luft nach oben abfuehrt. Du "
    "siehst die Dir bereits zur Gewohnheit werdenden Felswaende rings um Dich, "
    "die nur den Weg nach Norden frei lassen. Der Boden allerdings scheint "
    "nicht aus Fels zu sein.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);

//--Details----------------------------------------------------------------

  AddDetail( ({ "entfernung" }),
    "Der Himmel ist weit entfernt von Dir."
  );
  AddDetail( ({ "himmel" }),
    "Du kannst den Himmel in weiter Entfernung erkennen."
  );
  AddDetail( ({ "nebel" }),
    "Der Nebel wird nach oben abgezogen."
  );
  AddDetail( ({ "ende" }),
    "Eine Sackgasse."
  );
  AddDetail( ({ "schlucht" }),
    "Die Schlucht ist bekannt als die Klamm der Seelen."
  );
  AddDetail( ({ "abzug", "luft", "kaminabzug", "art" }),
    "Die warme Luft wird hier, wie in einem Kaminabzug, nach oben gesaugt."
  );
  AddDetail( ({ "klamm", "seelen" }),
    "Du bist in der Klamm der Seelen."
  );
  AddDetail( ({ "weg" }),
    "Der Weg ist hier zu Ende. Es geht nur nach Norden zurueck in die Klamm."
  );
  AddDetail( ({ "sache", "sachen" }),
    "Es ist nichts mehr da, was Du an Sachen untersuchen koenntest!"
  );
  AddDetail( ({ "erde" }),
    "Der Boden ist hier nicht aus Fels, sondern aus Erde."
  );
  AddDetail( ({ "fels" }),
    "Der Fels ist hart und aalglatt."
  );
  AddDetail(({"wand","waende","felswand","felswaende"}),
    "Die Waende sind aus massivem Fels. Keine Ritze, keine Fuge, keine "
    "Spalte ist zu sehen, dabei haettest Du Dich schon so drauf "
    "gefreut, irgendwo hineinzugreifen :))"
  );
  AddSpecialDetail(({"loch", "boden" }),"boden");
  AddSpecialDetail(({"kontur","konturen"}), "boden");
  AddSpecialDetail("schwert", "schwert");
  AddDetail( ({ "ritze", "fuge", "spalte" }),
    "Sowas siehst Du alles nicht."
  );
  AddDetail( ({ "gewohnheit" }),
    "Langsam gewoehnst Du Dich an die Felswaende."
  );
  AddDetail( ({ "sackgasse" }),
    "Hier gehts nicht weiter."
  );
  AddDetail(({"nase", "abwechslung"}),
    "Zur Abwechslung untersuchst Du Deine Nase mal nicht."
  );

  AddSound(({DEFAULT_SOUND,"wind","brise"}),
    "Du hoerst den Wind durch die Klamm pfeifen."
  );

  AddSmell(DEFAULT_SMELL,
    "Der Nebel riecht schwefelartig. Da der Nebel nach oben gezogen wird "
    "faellt es Dir sehr leicht hier zu atmen."
  );
  AddSmell("schwefel",
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("nebel", 
    "Der Nebel riecht nach Schwefel."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig. Das ist wohl der Nebel."
  );

//--Kommandos--------------------------------------------------------------

  AddCmd(({"grab","grabe"}),"grabe");

//--Ausgaenge--------------------------------------------------------------

  AddExit("norden", "./klamm9" );

}
boden(str)
{
  if (erdeweg)
    return BS("Du siehst ein mit Haenden gegrabenes Loch im Boden. "
      +"Mit viel Phantasie erkennst Du die Konturen eines grossen Bihaenders. "
      +"Doch irgendjemand muss diese maechtige Waffe schon in seinen Besitz "
      +"gebracht haben, weil sie nicht mehr da ist ;)");
  else
    return BS("Du erkennst, dass der Boden weich ist, fast wie Erde. "
      +"Du koenntest versuchen ein Loch zu graben.");

}
schwert()
{
  if (erdeweg)
    return BS("Das Schwert hat schon jemand genommen, also was willst "
      +"Du daran untersuchen??? Hast Du schon mal unsichtbare oder "
      "verschwundene Sachen untersucht?");
  else
    return BS("Da ist kein Schwert, das Du untersuchen koenntest.");

}
grabe(str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WAS willst Du graben?\n"),0);

  if (str=="loch" ) 
  {
	if (erdeweg)
	  write ("Da ist Dir schon jemand zuvorgekommen.\n");
	else
	{
	  write(BS("Du faengst wie wild mit den Haenden zu graben an und legst "
	       +"ein Loch von passabler Groesse frei, Du siehst die Konturen "
	       +"eines grossen Schwertes, doch irgendjemand muss es schon "
	       +"entfernt haben."));
      Message(BS(TP->name(WER)+" graebt wie wild mit seinen Haenden ein Loch "
           +"in den Boden."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
	}
    return (erdeweg = 1);
  }
  else
	return (notify_fail ("Das kannst Du nicht graben.\n"),0);
}

reset()
{
  erdeweg = 0;
  ::reset();
}
