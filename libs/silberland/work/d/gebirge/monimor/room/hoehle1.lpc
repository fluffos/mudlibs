inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In der Hoehle");
  SetProp(P_INT_LONG,
    "Du bist nun weiter in die Hoehle vorgedrungen. Es ist stockfinster "
    "und alles was Du erkennen kannst, sind einige Spalten in der Wand. "
    "Der Boden wiederum  ist aalglatt, sodass Du sogar aufpassen musst, "
    "dass Du nicht ausrutscht. Nach Westen kannst Du noch weiter in die "
    "Hoehle vordringen, nach Nordosten geht es Richtung Ausgang.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12,ENV_TERRAIN:TT_CAVE]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "decke" }), 
    "Die Decke ist eher niedrig. Auch an ihr sind kleinere Ritzen."
  );
  AddDetail( ({ "ausgang" }), 
    "Der Ausgang befindet sich nordoestlich von hier."
  );
  AddDetail( ({ "boden" }), 
    "Der Boden ist aalglatt."
  );
  AddDetail( ({ "raum","empfangshalle","halle" }), 
    "Dieser Raum gleicht einer Empfangshalle: Er ist gross und annaehernd "
    "rund. Die Waende zeigen mehrere Spalten, waehrend der Boden aalglatt ist."
  );
  AddDetail( ({ "hoehle","teil" }), 
    "Dieser Raum ist nur ein Teil der ganzen Hoehle!"
  );
  AddDetail(({"spalte","ritze","fuge","spalten","ritzen","fugen"}),
    "Du siehst einige kleinere Spalten in der Felswand."
  );
  AddDetail(({"wand","waende","felswand"}),
    "An der Wand sind einige Spalten."
  );

//--Ausgaenge--------------------------------------------------------------

  AddExit("westen", "./hoehle2");
  AddExit("nordosten", "./hoehle");

}
