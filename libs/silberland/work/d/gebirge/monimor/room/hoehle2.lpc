inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In der Hoehle");
  SetProp(P_INT_LONG,"Du bist noch tiefer in die Hoehle eingedrungen, "
    "allerdings bekommst Du jetzt wieder ein seltsames Gefuehl. Du fuehlst "
    "Dich beengt und die Waende scheinen Dich erdruecken zu wollen. Du "
    "trittst in eine Pfuetze, die Du auf dem Boden uebersehen hast und "
    "aergerst Dich, dass jetzt auch noch Deine Sachen nass sind. Oh, "
    "der Raum hier scheint im grossen und ganzen etwas feucht zu sein. Das "
    "Wasser kommt scheinbar von oben.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12,ENV_TERRAIN:TT_CAVE]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "boden" }), 
    "Ueberall auf dem Boden sind kleine Pfuetzen. Pass auf, dass Du "
    "nicht hineintrittst."
  );
  AddDetail( ({ "platz" }), 
    "Die Waende ruecken hier naeher zusammen, deshalb hast du weniger "
    "Platz. Hoffentlich hast Du keine Platzangst."
  );
  AddDetail( ({ "gefuehl" }), 
    "Du hast ein seltsames Gefuehl. Tja es duerfte Platzangst sein."
  );
  AddDetail( ({ "hoehle","teil" }), 
    "Dieser Raum ist nur Teil der ganzen Hoehle!"
  );
  AddDetail( ({ "raum" }), 
    "Der Raum ist feuchter, als so manch anderer in dieser Hoehle."
  );
  AddDetail( ({ "decke" }), 
    "Von der Decke tropft etwas Wasser in die Pfuetzen am Boden."
  );
  AddDetail( ({ "sache", "sachen" }), 
    "Dein Gewand duerfte bald wieder trocken sein, weil es nicht "
    "kalt ist in dieser Hoehle."
  );
  AddDetail( ({ "weg" }), 
    "Der Weg fuehrt von Osten nach Nordwesten. Es sind einige "
    "Pfuetzen auf dem Boden."
  );
  AddDetail( ({ "wand", "waende" }), 
    "Du fuehlst Dich von den Waenden bedraengt, da sie ziemlich nah "
    "aneinanderstehen und kaum Platz lassen, um dem Weg folgen zu koennen."
  );
  AddDetail("pfuetze",
    "Wasser tropft von der Decke in die Pfuetze."
  );
  AddDetail("gestein",
    "Das Gestein ist hier in der ganzen Klamm das selbe. Es gibt unter "
    "anderem dem Regenwasser, das es durchwandert einen seltsamen Duft "
    "mit. Deshalb solltest Du nicht von dem Wasser trinken."
  );
  AddDetail("wasser",
    "Das Wasser riecht irgendwie seltsam."
  );

  AddSmell(DEFAULT_SMELL,
    "Es riecht irgendwie modrig."
  );
  AddSmell(({"moder"}),
    "Es riecht modrig. Das Wasser der Pfuetzen duerfte nicht gesund sein."
  );
  AddSmell("wasser",
    "Das Wasser riecht modrig, so als wuerde es faulen. Den Geruch duerfte "
    "es aber trotzdem von der Reise durch das Gestein mitgenommen haben."
  );

  AddRoomMessage(({"Du hoerst, wie ein Wassertropfen in eine Pfuetze tropft.\n"}));

//--Ausgaenge--------------------------------------------------------------

  AddExit("osten", "./hoehle1");
  AddExit("nordwesten", "./hoehle3");

//--Kommandos--------------------------------------------------------------

  AddCmd("trinke","trinke");

}
int trinke(string str)

{
  if (!stringp(str) || str=="")
    return (notify_fail ("WAS willst Du trinken?\n"),0);
  if (str=="wasser")
  {
    write(BS("Ein hoellischer Schmerz durchfaehrt Deine Glieder. Vielleicht "
     +"haettest Du Dir besser ansehen sollen, was Du da trinkst!"));
    Message(BS(TP->Name(WER)+" trinkt ein wenig Wasser und zuckt "
    +"schmerzverzerrt zusammen."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    SetProp(P_KILL_NAME, "Giftiges Wasser" );
    TP->Defend(40+random(40), DT_POISON, 1, TO);
    return 1;
  }
  else
    return (notify_fail ("Das kannst Du nicht trinken.\n"),0);
}
