inherit "std/room";

#include "../def.h"

create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT,"In einer Sackgasse");
  SetProp(P_INT_LONG,
    "Du bist in einer weiteren Sackgasse der Hoehle angelangt. Die Waende "
    "sind wie ueberall hier, auch der Boden ist glatt. Wer koennte Interesse "
    "haben, eine Hoehle zu bauen, die scheinbar absolut leer ist? Du denkst, "
    "dass das vermutlich eine Wohnhoehle aus alter Zeit ist, die vielleicht "
    "sogar Monimors Urgrossvater bewohnt hat. Tatsaechlich siehst Du auch ein "
    "Bild und eine Inschrift darunter an der Wand.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12,ENV_TERRAIN:TT_CAVE]));

//--Details----------------------------------------------------------------

  AddDetail( ({ "gesicht" }),
    "Tringmors Nase ist etwas schief. Ausserdem sieht er nicht besonders "
    "gluecklich aus."
  );
  AddDetail( ({ "weisheit" }),
    "Weisheit erkennt man an einem Bart!"
  );
  AddDetail( ({ "pluenderer" }),
    "Sie sind ja nicht mehr da!"
  );
  AddDetail( ({ "familie", "zwergenfamilie" }),
    "Einen Teil der Familie Monimors kannst Du auf dem Bild erkennen."
  );
  AddDetail( ({ "sackgasse" }),
    "Diese Sackgasse war der Wohnraum der Zwergenfamilie."
  );
  AddDetail( ({ "sript" }),
    "BIST DU EINES?"
  );
  AddDetail( ({ "decke" }),
    "Die Decke ist hier etwas hoeher, sodass Du bequem stehen kannst."
  );
  AddDetail( ({ "aufnahme","qualitaet","aufnahmequalitaet" }),
    "Dieses Bild muss schon vor langer Zeit gemacht worden sein, wenn "
    "man die Aufnahmequalitaet beachtet."
  );
  AddDetail( ({ "nase" }),
    "Tja, Tringmor hat mal eine drauf gekriegt, seitdem ist sie etwas schief."
  );
  AddDetail( ({ "bart" }),
    "Tod sagt: 'HAST DU SCHON EINMAL EIN BABY MIT BART GESEHEN? WENN DU "
    "EIN SCRIPT BIST, HOL ICH DICH MIR!'"
  );
  AddDetail( ({ "hoehle", "wohnhoehle" }),
    "Das duerfte einst die Wohnhoehle Monimors Familie gewesen sein. "
    "Allerdings siehst Du ausser einem Bild nichts mehr, was daran "
    "erinnert. Hier duerften Pluenderer am Werk gewesen sein."
  );
  AddDetail( ({ "boden" }),
    "Der Boden ist aalglatt."
  );
  AddDetail( ({ "inschrift" }),
    "Du kannst versuchen sie zu lesen."
  );
  AddDetail( ({ "wand","waende" }),
    "Ein Bild haengt an der Wand, darunter ist eine Inschrift."
  );
  AddDetail(({"monimor","baby"}),
    "Das ist Monimor, als er noch ein Baby war: \n"
+"                        /~~~~~\\ \n"
+"                       / *   * \\  \n"
+"                      | \\  U  / | \n"
+"                       \\ \\___/ / \n"
+"                        \\_____/ \n"
+"Jetzt ist Monimor schon alt und weise, deshalb traegt er einen Bart.\n"
  );
  AddDetail(({"urgrossvater","tringmor"}),
    "Das ist Monimors Urgrossvater Tringmor: \n"
+"                       /~~~~\\ \n"
+"                      /      \\ \n"
+"                      |-O/\\O-| \n"
+"                      |  U   | \n"
+"                      | /~~\\ | \n"
+"                      /\\____/\\ \n"
+"                     ~         ~ \n"
+"\n"
+"Zum Zeitpunkt dieser Aufnahme, war Tringmor nicht sehr gut aufgelegt.\n"
  );
  AddDetail("bild",
    "Es zeigt Monimors Urgrossvater, als er gerade Monimor, der damals, "
    "als das Bild entstanden ist, noch ein Baby war, in den Schlaf wiegt. "
    "Monimor war scheinbar immer schon so suess."
  );

  AddReadDetail("inschrift",
    "Dies ist ein magischer Ort, wenn sich Probleme Dir eroeffnen, "
    "so wende Dich an Monimor, den Erben des grossen Tringmor. Allerdings "
    "bedenke, dass eben diese Magie durch einfache Gegenstaende auch zu "
    "betruegen ist. Andererseits, hier ist alles nicht so, wie es zu sein "
    "scheint, vor allem in den boesen Hallen des Nidgor, in Morkas.   "
    "PS: Das Gebiet hier ist noch im entstehen, viele Dinge kommen erst "
    "noch dazu, von denen hier die Rede ist..");

//--Ausgaenge--------------------------------------------------------------

 AddExit("norden", "./hoehle3");
}
