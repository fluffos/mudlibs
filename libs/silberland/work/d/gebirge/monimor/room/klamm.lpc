inherit "std/room";

#include "../def.h"

create()
{
   ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Die Klamm der Seelen");
  SetProp(P_INT_LONG,
        "Du stehst am Anfang eines Abhangs, der Dich in die Tiefe der Klamm "
	"der Seelen fuehrt. Rings um Dich siehst Du Steine, weit und "
	"breit nichts als Steine. Im Norden erscheint Dir ein begehbarer "
	"Weg zu sein, der immer tiefer in die Erdfurche fuehrt. Du hoffst, "
	"dass Du auf diesem Weg auch wieder nach Hause kommst, den Du "
	"zur Anreise genommen hast. Vielleicht solltest Du beten, dass "
	"Mahldor Dich auf seinem Ruecken wieder zurueck bringt, denn der "
	"einzige Weg fuehrt in die Schlucht."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15,ENV_TERRAIN:TT_MOUNTAIN]));

//--Details----------------------------------------------------------------

  AddDetail(({"himmel", "blau"}),
    "Der Himmel strahlt in seinem herrlichsten Blau."
  );
  AddDetail("sonne",
    "Die Sonne strahlt ungetruebt."
  );
  AddDetail( ({ "boden" }),
    "Hier ist der Boden zu einer Klamm gespalten."
  );
  AddDetail( ({ "stueck", "flaeche" }),
    "Du siehst ein Stueck begehbare Flaeche durch das Geroellfeld. Man kann "
    "dieses Stueck auch Weg nennen."
  );
  AddDetail( ({ "schlucht" }),
    "Die Schlucht ist bekannt als die Klamm der Seelen."
  );
  AddDetail( ({ "gebiet" }),
    "Es ist das Gebiet der Klamm der Seelen."
  );
  AddDetail( ({ "nebel" }),
    "Der Nebel hat sich fast in der ganzen Klamm breit gemacht."
  );
  AddDetail( ({ "tiefe", "schein" }),
    "So tief scheint die Klamm der Seelen nicht zu sein, aber der Schein "
    "koennte truegen, weil die Klamm sehr nebelig ist."
  );
  AddDetail( ({ "furche","erdfurche","spalte","erdspalte"}),
    "Diese Erdfurche ist die Klamm der Seelen, in geheimnisumwobenes Gebiet."
  );
  AddDetail( ({ "steine" }),
    "Die Steine bilden ein riesiges Geroellfeld."
  );
  AddDetail( ({ "feld", "geroellfeld", "geroell" }),
    "Du solltest versuchen auf dem Weg zu bleiben, sonst koennte es passieren, "
    "dass sich das Geroell selbstaendig macht und Du darunter begraben wirst."
  );
  AddDetail( ({ "weg" }),
    "Der WEG ist nicht wirklich ein Weg. Vielmehr siehst Du ein begehbares "
    "Stueck Geroellfeld, das einigermassen sicher aussieht."
  );
  AddDetail( ({ "klamm" }),
    "Nach Norden fuehrt ein Weg in die Klamm. Die Klamm ist eine Erdspalte, "
    "die von hier wie von einer Axt gezogen aussieht. Der Sage nach ist die "
    "Klamm auch so entstanden, dass der Urgrossvater Monimors, ein grosser "
    "Gott, vor lauter Wut auf die Menschen mit seiner Axt den Boden spaltete "
    "und die Seelen der Menschen, die hier sterben sollten, verfluchte, auf "
    "ewig hier gefangen zu sein."
  );
  AddDetail( ({ "anfang" }),
    "Richtig, Es ist der Anfang des Abstiegs in die Klamm der Seelen."
  );
  AddDetail("abhang",
    "Du bist verwundert, dass er nicht allzu steil nach unten fuehrt, "
    "irgendetwas sagt Dir, dass Du trotzdem den sicheren Abstieg im Norden "
    "waehlen solltest."
  );
  AddDetail( ({ "abstieg", "norden" }),
    "Der Abhang taeuscht ein wenig. Sicherer ist es wenn Du den Abstieg "
    "im Norden nimmst."
  );
  AddDetail( ({ "anreise" }),
    "Du kannst nur beten diesen Weg noch nehmen zu koennen den Du hergenommen "
    "hast."
  );
  AddDetail( ({ "axt" }),
    "Die Erdspalte sieht wie von einer riesigen von goettlicher Hand gefuehrten "
    "Axt gezogen aus."
  );
  AddDetail( ({ "hand", "gott" }),
    "Der Sage nach fuehrte Monimors Urgrossvater diese Axt."
  );
  AddDetail( ({ "menschen", "seelen", "wut", "urgrossvater" }),
    "Vor lauter Wut auf die Menschen lies Monimors Urgrossvater seine Axt den "
    "Boden spalten und verfluchte alle Seelen der Menschen, die hier sterben "
    "sollten, auf ewig hier gefangen zu sein."
  );
  AddDetail( ({ "sage" }),
    "Der Sage nach ist die Klamm so entstanden, dass der Urgrossvater Monimors, "
    "ein grosser und maechtiger Gott, vor lauter Wut auf die Menschen mit seiner "
    "Axt den Boden spaltete und die Seelen der Menschen verfluchte."
  );
  AddDetail( ({ "mahldor" }),
    "Mahldor scheint nicht da zu sein. Vielleicht solltest Du beten das er "
    "wiederkommt und Dich von hier zurueck bringt."
  );
  AddDetail( ({ "ruecken" }),
    "Mahldor hat auf seinem Ruecken schon viele Abenteurer zur Klamm gebracht. "
    "Nur wenige kehrten jedoch zurueck."
  );
  AddDetail( ({ "abenteurer" }),
    "Die Seelen der verstorbenen Abenteurer sind dazu verdammt auf ewig hier "
    "gefangen zu sein."
  );

  AddSound(DEFAULT_SOUND,
    "Du hoerst ein paar Kieselsteine unter Deinen Fuessen knirschen. Der Wind "
    "traegt ein paar Stimmen aus der Klamm empor."
  );
  AddSound(({"steine","stein","kieselstein","kieselsteine","tritt"}),
    "Mit jedem Tritt loesen sich ein paar und rollen die Schlucht hinab."
  );
  AddSound(({"wind", "stimmen", "klamm", "klagen"}),
    "Die Klagen der verstorbenen Seelen.");

  AddSmell(DEFAULT_SMELL,
    "Der Wind traegt den Geruch von Schwefel aus der Schlucht herauf."
  );
  AddSmell(({"schwefel", "nase"}),
    "Ein uebler Gestank steigt Dir in die Nase."
  );
  AddSmell("gestank",
    "Es stinkt schwefelig."
  );

//--Kommandos--------------------------------------------------------------

  AddCmd(({"bete", "bet"}),"cmd_beten");

//--Ausgaenge--------------------------------------------------------------

  AddExit("norden", "./klamm1");

  AddItem(TRN "mahldor" ,REFRESH_DESTRUCT,1);
}

//--Funktionen fuer Kommandos----------------------------------------------

int cmd_beten(string str)
{
  object moni;
  notify_fail("Willst Du beten, dass Monimor Dir hilft, oder, dass Mahldor "
             +"Dich zurueck bringt?\n");
  if(str=="dass mahldor mich zurueck bringt" ||
     str=="mahldor mich zurueck bringt"    )
  {
    write("Das kannst Du nur hoffen.\n");
    Message(BS(TP->name(WER,2)+" betet verzweifelt um Hilfe."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
  }

  if(str=="dass monimor mir hilft" ||
     str=="monimor mir hilft"    )
  {
    moni = find_player("monimor");
    
    if(moni && !moni->QueryProp(P_INVIS))
    {
      write("Monimor ist im Moment grade idle.\n");
    }
    else
    {
      write("Monimor ist im Moment gar nicht da.\n");
    }
    
    Message(BS(TP->name(WER,2)+" betet verzweifelt um Hilfe."),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    
    return 1;
  }
  return 0;
}
