inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../moni.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;

::create();

  AddId("schatten");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schatten");
  SetProp(P_SHORT,"Ein Schatten");
  SetProp(P_LONG,break_string("Der Schatten ist ein finsterer Kaempfer aus einer lange verstorbenen Gilde. Diese hat einst die Klamm vor Seelenraeubern beschuetzt, doch inzwischen sind auch die Schatten habgierig geworden. Sie schrecken vor nichts zurueck, um an mehr Geld zu kommen.",78));
  AddDetail("kaempfer",bs("Sein Blick ist starr und finster. Er scheint Dich mit seinen Blicken zu durchbohren."));
  AddDetail("blick",bs("Der Blick des Schattens scheint geradewegs durch Dich durchzugehen. Scheinbar fixiert er Deine Seele."));
  SetProp(P_INFO,bs("Der Schatten lebt nicht wirklich. Er bezieht seine Energie aus den Seelen der Lebenden, das erhaelt ihn in einem dem Leben aehnlichen Zustand."));
  SetProp(P_ALIGN,-100);
  SetProp(P_SIZE,187);
  SetProp(P_RACE, "Schatten");
  SetProp(P_NOCORPSE,1);
  
  create_default_npc(17);
  SetProp(P_HANDS,({" mit einem Hauch von TOD", 170, DT_BLUDGEON}) );

  AddInfo("schatten","grinst:'Das bin ich. Gibst Du mir Deine Seele?'\n");
  AddInfo("seele","ist begeistert:'Ich gebe Dir 500 Muenzen dafuer!'\n");
  AddSpell(1, 200,
    "Der Schatten schleudert einen imaginaeren Wurfstern nach Dir.\n",
    "Der Schatten schleudert einen imaginaeren Wurfstern nach @WEM.\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  SetProp(P_DIE_MSG," schreit und verschwindet tot in einer Spalte.\n");
  AddInfo("\ndefault info","denkt . o O (Was will der bloss von mir?)\n");
  
  seteuid(getuid(this_object()));

  clone_object(OBJ("schattenschwert"))->move(this_object());
   command("zuecke schwert");
  clone_object(OBJ("schattenruestung"))->move(this_object());
   command("ziehe ruestung an");

  SetAttackChats(20, ({ "Ich denke, das haettest Du lassen sollen.\n",
    "Der Schatten sagt: Ich weiss, ich sollte nicht ueber Dich lachen, aber..\n",
    "Der Schatten lacht sich die Seele aus dem Koerper, den er nicht hat.\n"
    }) );

    SetProp (P_MNPC_AREA, ROOM("klamm"));
  SetProp (P_MNPC_WAIT, ({ 30, 90, 120 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("klamm7.lpc"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES);
}

void die(int p) {
  object item;
  mixed vars;
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(4, TP)) {
    vars=item->GetVar();
    if(!mappingp(vars)) 
      vars=([]);
    if(!member(vars, "schatten")) 
      vars+=(["schatten":0]);
    vars["schatten"]++;
    if(vars["schatten"]>=3)
      item->SetFlag(0);
    item->SetVar(vars);
  }
  return ::die(p);
}
