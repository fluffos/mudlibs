inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Zost, der Wirt");
  SetProp(P_LONG,
    "Das ist Zost, der Wirt der Kneipe 'Sauf und Fall'. Er ist fuer einen "
    "Zwerg mittelgross. Er traegt eine Schuerze und waescht Glaeser ab. Er "
    "sieht finster aus, nachdem die Geschaefte in dieser entlegenen Ecke des "
    "Silberlands nicht besonders gut gehen duerften.");
  SetProp(P_NAME, "Zost");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE,0);
  SetProp(P_RACE,"Zwerg");
  AddId(({"zost", "wirt", "zwerg"}));

  SetProp(P_LOG_INFO,"/torian/zost");

  create_default_npc(19);
  SetProp(P_HANDS, ({" mit einem vernichtenden Blick", QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_MAX_HP,450 );
  SetProp(P_BODY, 160);
  SetProp(P_SIZE, 130);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);;

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "Lass mich in Ruhe!","schreit: ");

  AddInfo("amazora","Monimors Lieblingshexchen :) Klein aber gemein.","kichert: ");
  AddInfo("nostromo","Das is so ein kleiner, staendig schwarz Angezogener. Der "
    +"hat ausserdem eine ganz komische Gespraechsfuehrungstaktik.","meckert: ");
  AddInfo(({"gespraechsfuehrungstaktik","taktik","fuehrung","gespraechsfuehrung"}),
    "Naja, red' halt mal mit ihm. Das wird Dich ganz schoen nerven. Dieser "
    +"Psychoquatsch!","laestert: ");
  AddInfo(({"quatsch","psychoquatsch"}),"Hmm, wie soll ich Dir das beibringen. "
    +"Der wiederholt halt alles was Du sagst, und das eeeeendlos lang.","arglt: ");
  AddInfo("dusty","Dusty ist der Chef von der ganzen Region hier. Knuddelige "
    +"Goettin uebrigens.","kichert: ");
  AddInfo("woody","Jo, Woody ist Monimors Papa. Der ist auch ein Gott. Spielt "
    +"uebrigens gern Maexchen.","grinst: ");
  AddInfo("maexchen","Das haben die alle mal gemeinsam gespielt, diese Goetter, "
    +"Magier, Spieler und so weiter. Die treffen sich ja manchmal auch "
    +"RL.","erklaert: ");
  AddInfo("angrox","Der ist da Regionsmagier und ein guter Freund Monimors. "
    +"Ich sag's Dir, da is' was im Busch bei denen. Ich glaub die wollen "
    +"eine Gilde machen oder so.","fluestert: ");
  AddInfo("thor","Nettes Maedel *hihi*. Sie ist glaub ich nicht nur "
    +"die Tochter von Angrox.","kichert: ");
  AddInfo("semira","Die ist gaaanz lieb. Sie ist immer fuer einen kleinen "
    +"Plausch zu haben. Ausserdem mag sie, genauso wie Crea und Monimor auch "
    +"Josef Hader. Das macht sie gleich noch um Klassen sympathischer *grins*, "
    +"sofern eine Steigerung noch moeglich ist. Ausserdem ist da noch was "
    +"mit Crea, aber da solltet ihr sie lieber selber fregen.","sagt: ");
  AddInfo(({"hader","josef","josef hader"}),"Das ist der wohl beste "
    +"Kabarettist auf Erden.","schwaermt: ");
  AddInfo(({"creative","crea"}),"Ueber Crea laesst Monimor nix kommen. "
    +"Da solltest Du dich hueten, auch nur ein negatives Wort ueber "
    +"ihn zu verlieren. Monimor hat Crea naemlich besonders gern.","warnt Dich: ");
  AddInfo(({"wuschel","wuschi"}),"Jaja, Wuschel... Die will und will einfach "
    +"nicht mit Monimor auf ein Bier gehen. Das nenn' ich symptomatisch.",
    "fluestert: ");
  AddInfo("dante","Jaja, Dante is' auch so einer... Der hat nur Schabernack "
    +"im Kopf. Huete Dich vor der Malaria!","grinst: ");
  AddInfo(({"frau","traumfrau"}),"Monimor hat mir von ihr erzaehlt. Hat 'nen "
    +"guten Geschmack, der Bursche.","schwaermt: ");
  AddInfo("geschmack","Frag ihn doch selber. Sowas ist schliesslich "
    +"vertraulich.","sagt: ");
  AddInfo(({"fey","feyaria"}),"Hmm, dass ich jetzt nichts falsches sag. SIE "
    +"ist auch EINE der besseren Freundinnen Monimors. Sie ist die Chefin "
    +"vom Dschungel.","erklaert: ");
  AddInfo("dschungel","Glitschige Angelegenheit, zu feuchtes Klima fuer mich.",
    "erzaehlt: ");
  AddInfo("sargola","Zufaelligerweise ist das auch ein Freund Monimors. "
    +"Monimor beklagt sich in letzter Zeit oefters bei mir, dass er ihn "
    +"nicht mehr so oft sieht.","sagt: ");
  AddInfo("omrani","Ui, die hat Monimor jetzt nun wirklich lange nicht mehr "
    +"gesehen. Dabei wuerd er sich sooooo darauf freuen.","sagt: ");
  AddInfo(({"levitikus","levi"}),"Der Seher-Koenig? Hihi, ein kleiner "
    +"schusseliger Kerl.","kichert: ");
  AddInfo("gordo","Der hat sich auch rar gemacht. Letzten Geruchten zur Folge, "
    +"soll er sich fast nur mehr im Morgengrauen herumtreiben. Schade "
    +"eigentlich. Ein echt netter Kerl.","trauert: ");
  AddInfo("mond","Der Mond ist aufgegaaaangen.","singt: ");
  AddInfo("monimor", "Monimor hat mich erschaffen. Klasser Bursch "
    +"uebrigens. Ich denk' er traeumt noch immer von seiner Traumfrau.","sagt: ");

  // Allgemeine Infos

  AddInfo(({"klamm","klamm der seelen"}),"Ja, Du bist in der Klamm der "
    +"Seelen. Hier spuken einige Gestalten herum. Vielleicht sind "
    +"einige von ihnen Seelen. Auf alle Faelle heisst es, wer hier stirbt, "
    +"ist auf ewig verflucht, sein Dasein hier zu fristen. Angeblich hat "
    +"Monimors Urgrossvater mit einem maechtigem Axthieb das Gebirge "
    +"gespalten und so die Klamm erschaffen haben.","erzaehlt: ");
  AddInfo(({"seele","seelen"}),"Das sind die immateriellen Reste der "
    +"Verstorbenen. Sie muessen hier herumspuken, fuer immer!","betont: ");
  AddInfo("ethannotol","Ist soviel ich weiss nicht alkoholisch, hat auch die "
    +"entgegengesetzte Wirkung von Ethanol.","sagt: ");
  AddInfo(({"gast","gaeste"}),"Momentan ist die Kneipe nur schwach besucht.",
    "winselt: ");
  AddInfo(({"stammgast","stammgaeste"}),"Die sind momentan nicht da. Das ist "
    +"ein Club von dem verrueckten Alten da drueben. Die kommen manchmal "
    +"herueber auf ein Bier, weil es bei dem alten Dillo nichts alkoholisches "
    +"zu trinken gibt.","laestert: ");
  AddInfo(({"weiser","alter","dillo"}),"Ja, das ist ein Dillo. Er nennt sich "
    +"zwar weise, aber was der faselt, versteht ja doch keiner.","lacht: ");
  AddInfo(({"langeweile","langweilig","fad"}),"Ja, mir ist langweilig. Waere "
    +"Dir doch auch, wenn Du nur herumstehn muesstest. Also, kauf was, dann "
    +"kann ich endlich wieder was vernuenftiges tun.","mault: ");
  AddInfo("club","Das ist so ein Club von Angebern. Die glauben alle, total "
    +"toll und schlau zu sein.","macht sich lustig: ");
  AddInfo("angeber","Naja, die tun halt so gescheit. Ob sie 's sind, stell "
    +"ich offiziell in Frage!","lacht: ");
  AddInfo("bild","Das soll mich darstellen. Ich denke nur, dass mich das "
    +"nicht wirklich getroffen hat. Monimor sollte lieber beim Proggen "
    +"bleiben und das Zeichnen lassen.","nervt: ");
  AddInfo("proggen","Monimor tut das so manchmal. Genau weiss ich auch nicht "
    +"was das ist, aber immer wenn er was fertig geproggt hat, wird das "
    +"Gebiet hier groesser. Komisch, nicht?","philosophiert: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Zost will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(1,300,
    "Zost schleudert Dich gegen die Wand.\n",
    "Zost schleudert @WEN gegen die Wand.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
  "Schon in der Bibel steht geschrieben, tust Zost nicht lieben, wirst "
  +"geschlagen von Hieben.\n"}) );

  SUID;
  CLONEME(KOBJ "flaschenhals" );
  command("zuecke flaschenhals");
  CLONEME( "/p/armour/cloak/schuerze" );
  command("trage alles");
}