///   Ein Sklave:
///---------------------------------------------------
///
///   Diser Sklave zieht ein Geschoss.
///   Nachdem Sklaverei etwas abstossendes ist,
///   wird sein Meister mit niedriger P_ALIGN bestraft.
///
///
///
///
///
///
///Monimor
///Maerz 1997


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../moni.h"
#include <new_skills.h>

string meister;

AddMstr(str)
{
  meister=str;
}

create()
{
  if (!is_clone(this_object())) return;
  
::create();
  AddId(({"sklave","schani","geschosszieher","zieher"}));
  SetProp(P_SHORT,"Ein Geschosszieher");
  SetProp(P_LONG,"Dieser Geschosszieher ist ein Sklave"+bs(". Er sieht ziemlich muede aus, weil er die ganze Zeit dieses schwere Geschoss ziehen muss. Er ist nur in Lumpen gekleidet, die sicher seit zwei Jahren nicht mehr gewaschen wurden. Der Sklave ist sehr muskuloes, sonst koennte er das Geschoss sicher nicht ziehen, aber er scheint ziemlich friedfertig zu sein."));
  SetProp(P_NAME,"Sklave");
  SetProp(P_GENDER,MALE);
  SetProp(P_SIZE,190);
  SetProp(P_ALIGN,200);
  SetProp(P_LEVEL,15);
  SetProp(P_MAX_HP,500+random(50));
  SetProp(P_MAX_SP,200);
  SetProp(P_XP,100000);
  SetProp(P_BODY,140);
  SetProp(P_MAX_HANDS,4);
  SetProp(P_HANDS,({" schlaegt Dir mit der Faust ins Gesicht",100,DT_BLUDGEON}));
  SetProp(P_RESISTANCE,({DT_BLUDGEON}));
  SetProp(P_VULNERABILITY,({DT_WHIP}));
  SetProp(P_REJECT,({REJECT_KEEP,"Der Sklave bedankt sich aufrichtig bei Dir fuer Deine Guete.\n"}));
  SetProp(P_MSGIN,"folgt "+meister+" herein");
  SetProp(P_MSGOUT,"folgt "+meister+" nach");
  AddInfo("sklave",bs("Ja, ich bin ein Sklave, so bin ich geboren, so werde ich sterben."));
  AddInfo("monimor",bs("Monimor ist ein guter Zwerg, hoffentlich erloest er mich von diesen Qualen."));
  AddInfo(({"qual","qualen"}),bs("Dieses Geschoss ist nicht gerade leicht, zieh Du das mal Dein Leben lang."));
  
  SetProp(P_SPELLRATE,30);
  SetProp(P_DIE_MSG," schaut noch einmal laechelnd zum Himmel und stirbt befreit.\n");
  AddSpell(1,200,
    "Der Sklave tritt Dir in die Nieren.\n",
    "Der Sklave tritt @WEM in die Nieren.\n",
    ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
}


