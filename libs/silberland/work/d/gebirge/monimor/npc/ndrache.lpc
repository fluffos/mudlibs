//  Ich hab hier einen Drachen von Lamuerte etwas veraendert:
//  P_LONG erzaehlt was von Narzist-> in 
//  /d/gebirge/monimor/room/see/see_09.c sind lauter spiegel
//  dort greift der drache mit einer wahrscheinlichkeit von
//  1/3 den spieler an, mit 2/3 haut er daneben.
//  allerdings ist der drache AddPursuer gesetzt, aber er ist
//  ansonsten so ziemlich der schwaechst moegliche drache
//
//  Monimor@SL, August 1997

inherit "/d/ebene/lamuerte/drachen/dnpc.lpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../moni.h"

create()
{ 
int zufall;
  if (!is_clone(this_object())) return;
  ::create();
  create_default_dragon(1,2,0,6);
  SetProp(P_LONG,"Dieser Drache ist kein gewoehnlicher seiner Art. "
	+"Er ist ein Narzist. Wenn er einen Spiegel sieht, ist er kaum "
	+"noch von etwas anderem zu begeistern, auch nicht von einem "
	+"Kampf. Dennoch ist nicht mit ihm zu spassen.\n");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  player->RemovePursuer(ME);
  write_file(LOG("ndrache.kills"),
    ctime()+": Der Narzistenndrache hat gerade "+CAP(getuid(player))+" umgebracht.\n"+CAP(getuid(player))+" verlor "+lostexp+" XP.\n");
}

void die(string arg)
{
  write_file(LOG("ndrache.dies"),
  ctime()+": "+CAP(getuid(TP))+" toetet den Narzistendrachen.\n");
  ::die(arg);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  enemy->AddPursuer(ME);
  ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  if(present("spiegeldummy",environment(ME)))
  {
    switch(random(30))
	{
	  case 0 .. 10 : ::Attack(enemy); break;
	  case 11 .. 20 : enemy->Defend(0,DT_MAGIC,0,0);
	    tell_object(enemy,"Der Drache schaut sich im Spiegel an "
		  +"und vergisst, dass er mit Dir kaempft.\n"); 
		tell_room(environment(ME),"Der Drache schaut sich im Spiegel "
		  +"an und vergisst mit "+enemy->name(WEM,1)+" zu kaempfen.\n",({enemy}));
		break;
      case 21 .. 29 : enemy->Defend(0,DT_MAGIC,0,0);
		tell_object(enemy,"Der Drache greift Dein Spiegelbild an.\n");
		tell_room(environment(ME),"Der Drache greift "
		  +enemy->name(WESSEN,1)+" Spiegelbild an.\n",({enemy}));
		break;
	}
  }
  else
	{
	::Attack(enemy);
	}
}
