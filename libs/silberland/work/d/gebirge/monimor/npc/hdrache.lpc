inherit "/d/ebene/lamuerte/drachen/dnpc.lpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../moni.h"

create()
{ 
int zufall;
  if (!is_clone(this_object())) return;
  ::create();
  create_default_dragon(4,2,0,15);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("hdrache.kills"),
    ctime()+": Der Hoehlendrache hat gerade "+CAP(getuid(player))+" umgebracht.\n"+CAP(getuid(player))+" verlor "+lostexp+" XP.\n");
  command("nimm alles aus leiche");
  tell_room(environment(ME), "Der Drache verschwindet nach Westen.\n");
  this_object()->move(HOEHLE("hoehle_02"),M_GO);
  tell_room(environment(ME), "Der Drache kommt an.\n");
  command("lass alles fallen");
  command("nimm schuppen");
  tell_room(environment(ME), "Der Drache verschwindet nach Osten.\n");
  this_object()->move(HOEHLE("hoehle_01"),M_GO);
  tell_room(environment(ME), "Der Drache kommt an.\n");
}

void die(string arg)
{
  write_file(LOG("hdrache.dies"),
  ctime()+": "+CAP(getuid(TP))+" toetet den Hoehlendrachen.\n");
  ::die(arg);
}

