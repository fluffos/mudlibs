inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../moni.h"
#include <new_skills.h>

#define ELEMENT_SECURE "secure_prop"
create()
{
  if (!is_clone(this_object())) return;

::create();

  AddId(({"dieb","seelendieb"}));
  SetProp(P_GENDER,MALE);
  SetProp(P_NAME,"Seelendieb");
  SetProp(P_SHORT,"Ein Seelendieb");
  SetProp(P_LONG,bs("Der Seelendieb ist ein zwielichtiger Geselle. Er ist staendig auf der Suche nach neuen Opfern, denen er die Seele klauen kann. Er ist nicht besonders gross, dafuer scheint er ziemlich fies zu sein. Das glaubst Du zumindest an seinem Gesichtsausdruck zu erkennen."));
  AddDetail("geselle",bs("Er hat gelernt, Abenteurern die Seele zu entreissen."));
  AddDetail(({"ausdruck","gesichtsausdruck"}),bs("Du siehst in ein total abgebruehtes Gesicht. Nichts duerfte dieser Gestalt zuwider sein, um an ihr Ziel zu gelangen."));
  AddDetail("gestalt",bs("Der Seelendieb ist etwa 1.70 gross und muskuloes."));
  SetProp(P_SIZE,172);
  SetProp(P_ALIGN,-100);
  
  create_default_npc(18);
  SetProp(P_BODY,120);
  SetProp(P_MAX_HANDS,4);
  SetProp(P_HANDS,({" beisst Dich in die Nase",180,DT_BLUDGEON}));
  SetProp(P_RESISTANCE,({DT_COLD}));
  SetProp(P_REJECT,({REJECT_KEEP,"Der Seelendieb nimmt was ihm gegeben und grinst.\n"}));
  SetProp(P_VULNERABILITY,({DT_SLASH,DT_PIERCE}));

  SUID
  CLONEME("/p/weapon/sword/saebel");
    command("zuecke saebel");
  CLONEME(OBJ("umhang"));
    command("ziehe umhang an");


  AddInfo("\ndefault info","giert nach Deiner wissensdurstigen Seele.\n");
  AddInfo("seele","laechzt: 'Willst Du mir Deine geben?'\n");
  AddInfo("dieb","bruellt:'Willst du mich beleidigen?'\n");
  AddInfo("monimor","grummelt:'Seine Seele werd' ich ...'\n");
  AddInfo("klamm","sagt:'Frueher mussten wir uns verstecken, aber jetzt...\n");
  AddSpell(1,50,
    "Der Seelendieb reisst ein Stueck Deiner Seele aus Dir heraus.\n",
    "Der Seelendieb reisst ein Stueck aus @WESSEN Seele heraus.\n",
    DT_MAGIC, "diebstahl" );
  SetProp(P_SPELLRATE,30);
  SetProp(P_DEFAULT_INFO,"giert nach Deiner wissbegierigen Seele.\n");
  SetProp(P_DIE_MSG," bruellt sich die Seele aus dem Leib und stirbt.\n");
  SetAttackChats(40,({"Der Seelendieb sagt: Du solltest Dir nicht soviel vornehmen.\n"}));

  SetProp(P_MNPC_AREA, ROOM("klamm"));
  SetProp(P_MNPC_WAIT,({30,90,150}));
  SetProp(P_MNPC_DEFAULTROOM,ROOM("klamm1"));
  SetProp(P_MNPC_FLAGS,MOV_OUTDOORS + MOV_MOVES);
}

diebstahl()
{
  EnemyPresent()->restore_spell_points(-10-random(20) );
}


void die(int poisondeath)
{
  object spieler, ob, item;
  mixed vars;
  spieler=ME->QueryProp(P_KILLER);
  if((spieler->QueryProp(P_GUILD))=="druidenzirkel" &&
     (spieler->QueryProp(P_GUILD_LEVEL))==3)
    {
      ob=clone_object("/gilden/druidenzirkel/obj/task");
      ob->move(spieler, M_NOCHECK);
      ob->SetProp(ELEMENT_SECURE, 4);
    } 
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(4, TP)) {
    vars=item->GetVar();
    if(!mappingp(vars)) 
      vars=([]);
    if(!member(vars, "seelendieb")) 
      vars+=(["seelendieb":0]);
    vars["seelendieb"]++;
    if(vars["seelendieb"]>=3)
      item->SetFlag(1);
    item->SetVar(vars);
  }
::die(poisondeath);
}
