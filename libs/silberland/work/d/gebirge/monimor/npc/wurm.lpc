inherit "std/mnpc";

#include <combat.h>
#include <mnpc.h>
#include "../def.h"
#include <defines.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;

::create();

  AddId(({"ruesselwurm","wurm"}));
  SetProp(P_GENDER,MALE);
  SetProp(P_NAME,"Ruesselwurm");
  SetProp(P_SHORT,"Ein Ruesselwurm");
  SetProp(P_LONG, 
    "Der Ruesselwurm ist ein wahrhaft maechtiges Tier. Er ist groesser "
    "als alles was Du bisher gesehen hast. Ausserdem duerfte er Hunger haben. "
    "Er versperrt Dir den Weg nach Osten. Um an ihm vorbeizukommen, wirst "
    "Du ihn wohl toeten muessen. Eine aeusserst deprimierende Aussicht. "
    "Sein Kopf alleine ist so gross, dass Du dreimal in seinem Rachen Platz "
    "haettest. Sein grauer Panzer schimmert im Licht, das an den Wassertropfen "
    "reflektiert wird, und ihn mit einer schaurigen Aura umgibt. Sein Schwanz "
    "ist mit spitzen Stacheln versehen, die ungefaehr von Deiner Groesse sind "
    "und deren Spitzen im Licht der Sonne aufblitzen, wie die Schneide eines "
    "Henkerbeils. Ungefaehr so duerfte auch ihre Wirkung auf Deinen Koerper sein, "
    "wenn du von dieser maechtigen Waffe getroffen werden wuerdest."
  );
  SetProp(P_INFO, "Dieses Wesen ist von dunkler Magie erfuellt. Du spuerst, "
                  "wie boese dieses Untier ist und bedauerst sein tristes Wesen, "
                  "dessen Erfuellung es ist zu toeten, was ihm zu nahe kommt.");
  SetProp(P_SIZE,1324);
  SetProp(P_RESISTANCE,({DT_BLUDGEON,DT_WHIP,DT_PIERCE,DT_FIRE,DT_WATER,DT_LIGHT}));
  SetProp(P_ALIGN,-500);
  SetProp(P_KILL_MSG,"So ein Wurm, denkst Du wirklich, dass DU mich besiegen koenntest?");
  
  create_default_npc(29);
  SetProp(P_BODY,120);
  SetProp(P_MAX_HANDS,5);
  SetProp(P_HANDS,({" mit seinem Stachelschwanz",300,DT_BLUDGEON}));
  set_living_name("ruesselwurm");
  SUID;

  SetProp(P_SPELLRATE, 40);

  AddSpell(7,600,
    "Der Ruesselwurm greift Dich mit einem Feuerstrahl an.\n",
    "Der Ruesselwurm greift @WEN mit einem Feuerstrahl an.\n",
    ({DT_FIRE,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(1,200,
    "Der Ruesselwurm wirft Dir einen boesen Blick zu.\n",
    "Der Ruesselwurm wirft @WEM einen boesen Blick zu.\n",
    ({DT_LIGHT,DT_MAGIC}),"blende",([SP_SHOW_DAMAGE:1]));

  SetAttackChats(30, " lacht Dich aus.\n");
  SetProp(P_DEFAULT_INFO,"faucht Dich boese an.\n");
  SetProp(P_DIE_MSG, " stoesst einen markerschuetternden Schrei aus und stuerzt in den See.\n");
  SetProp(P_NOCORPSE,1);
  AddDetail(({"panzer","schuppen","tropfen","wassertropfen"}),
    "Wassertropfen spiegeln sich an dem maechtigen Panzer  des Ruesselwurms. "
    "Nur eine seiner Schuppen waere vermutlich der perfekte Schutz gegen einer "
    "Gegner Deiner Groesse, wenn Du eine haettest..."
  );
  AddDetail("tier",
    "Tier ist wohl nicht passend, Untier, vielmehr Ungeheuer waere passender."
  );
  AddDetail("kopf",
    "Der Kopf ist wie auch der ganze Koerper des Drachen tiefschwarz. Er ist "
    "zwei Zwerge gross und haette auch keine Muehe eine Kuh mit einem Satz zu "
    "verschlingen. Viele Narben uebersaehen diese Fratze und Rauch steigt aus "
    "seinen Nuestern empor. Die beiden Augen duerften Dich bereits jetzt schon "
    "verschlungen haben."
  );
  AddDetail("koerper",
    "Der Koerper des Drachen misst sicher gemeinsam mit dem Kopf zehn Zwerge. "
    "Er ist von einem tiefschwarzen Panzer bedeckt, an dem Wassertropfen das Licht "
    "der Sonne reflektieren."
  );
  AddDetail(({"narbe","narben"}),
    "Der Wurm hat viele Narben ueber den ganzen Koerper verteilt, sofern man an "
    "einem Panzer von Narben sprechen kann. Vielmehr siehst Du viele Scharten, "
    "von denen keine tief genug war, um das Drachentier zu verletzen."
  );
  AddDetail(({"scharte","scharten"}),
    "In vielen Kaempfen hat der Ruesselwurm Schwert- und Axtschlaege hinnehmen "
    "muessen. Kein Schlag jedoch hat den Panzer je durchdrungen."
  );
  AddDetail(({"aug","auge","augen"}),
    "Die Augen des Wurms verschlingen Dich bei lebendigem Leib. In ihnen funkelt "
    "die Magie eines Drachenwesens. Entfernt erinnern Dich diese Augen an die einer "
    "Katze, nur sind diese Augen um einiges groesser und strahlen ein grellgruenes "
    "Licht aus."
  );
  AddDetail("licht",
    "Dieses Licht muss magischen Ursprungs sein, anders kannst Du Dir das nicht "
    "erklaeren."
  );
  AddDetail("aura",
    "Der Ruesselwurm strahlt eine eiskalte Aura aus, die Dir eine Gaensehaut ueber "
    "den ganzen Koerper jagt. Dieses Tier ist wirklich abgrundtief boese."
  );
  AddDetail("rachen",
    "Du solltest Dich nicht zu weit vorwagen, sonst passierst Du diesen Rachen "
    "auf dem Weg zu Deiner eigenen Verdauung. Doch Du schaetzt, dass dieser "
    "finstere Schlund Dich etwa dreimal fasst."
  );
  AddDetail(({"beil","henkerbeil"}), 
    "Diese funkelnden Spitzen erinnern Dich an die Schneide eines Henkerbeils, "
    "das, hocherhoben ueber dem Kopf des Schlaechters, in der Sonne glaenzt."
  );
  AddDetail(({"stachel","stacheln","spitze","spitzen"}),
    "Die Spitzen der Stacheln reflektieren das Sonnenlicht, sodass Du "
    "annaehernd geblendet bist. Du weisst, dass diese Stacheln aeusserst "
    "maechtige Waffen darstellen, sollte der Ruesselwurm mit dem "
    "Schwanz nach Dir schlagen."
  );
  AddDetail("schwanz",
    "Der Schwanz des Ruesselwurms ist mit Stacheln besetzt. Du zaehlst zehn und "
    "denkst im selben Moment, dass auch einer reichen wuerde, um Dich ausser "
    "Gefecht zu setzen."
  );
}
void die(string arg)
{
  write_file(LOG "wurm.dies",
    ctime()+": "+CAP(getuid(TP))+" toetet den Ruesselwurm.\n");
    domainshout(capitalize(this_player()->name(WER,RAW))+" hat den "
        "Ruesselwurm erlegt!\n", ({"gebirge"}) );
  ::die(arg);
}
void NotifyPlayerDeath(object player,object killer, int lostexp)
{
  write_file(LOG "wurm.kills",
    ctime()+": Der Wurm hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

void blende(object enemy,int damage,string damtype)
{
  if ( !random(5) && enemy)
  {
    enemy->SetProp(P_BLIND,100);
    return;
  }
}