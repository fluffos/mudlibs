inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  if (!is_clone(this_object())) return;

::create();
  AddId(({"dunkler","ritter","dunkler ritter"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Dunkler Ritter");
  SetProp(P_SHORT, "Ein Dunkler Ritter");
  SetProp(P_LONG,
	"Der dunkle Ritter macht einen furchteinfloessenden Eindruck."+
	"Du solltest ihm lieber aus dem Weg gehen.\n");
  SetProp(P_ALIGN, -200);
  SetProp(P_SIZE,190);
  SetProp(P_LEVEL, 12);
  SetProp(P_MAX_HP, 300);
  SetProp(P_MAX_SP, 300);
  SetProp(P_RESISTANCE,({DT_FIRE,DT_BLUDGEON}));
  SetProp(P_XP, 350000);
  SetProp(P_BODY, 80);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HANDS, ({" schlaegt dir unfairerweise in die ...", 65,
	DT_BLUDGEON}) );
  set_living_name("dunkelritter");

  SetProp(P_SPELLRATE, 30);
  AddSpell(1,180,
	"Der dunkle Ritter schleudert alles boese nach Dir.\n",
	"Der dunkle Ritter schleudert alles Boese nach @WEM.\n");
  SetProp(P_DIE_MSG, " kanns einfach nicht glauben, dass er tot ist.\n");
  SetProp(P_DEFAULT_INFO, " sagt: putz Dir doch selbst den Hintern.\n");

seteuid(getuid(this_object()));

  clone_object("/players/monimor/tools/dschwert")->move(this_object());
   command("zuecke schwert");
  clone_object("/players/monimor/tools/druestung")->move(this_object());
   command("ziehe panzer an");
  clone_object("/players/monimor/tools/dhelm")->move(this_object());
   command("ziehe helm an");
  SetChats(50, ({
   "Der dunkle Ritter zieht Dich an deinen Haaren.\n",
   "Der dunkle Ritter sagt: Gib mir all Dein GOOOLD!\n",
   "Der dunkler Ritter sagt: Ver*zensur* Dich endlich!\n"
  }) );
  SetAttackChats(50, ({
   "Der dunkle Ritter sagt: Beschwer Dich ja nicht bei TOD ueber mich ;)\n",
   "Der dunkle Ritter sagt: PECH GEHABT, DU BIST nicht tod :)))))\n"
  }) );
}
