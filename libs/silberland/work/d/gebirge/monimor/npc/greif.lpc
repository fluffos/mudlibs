inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../moni.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;

::create();

  AddId(({"gott","greif"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Greif");
  SetProp(P_SHORT,"Ein Greif");
  SetProp(P_LONG,bs("Der Greif ist ein stolzes Tier. Er hat den Koerper "
+"eines Loewen und die Schwingen und den Schaedel eines Adlers. "
+"Sein Fell glaenzt rotgold und die weitausladenden Fluegel glitzern "
+"guelden im Schein der Sonne."));
  SetProp(P_HEAL,10);
  SetProp(P_MSGOUT,"fliegt weg");

  SetProp(P_ALIGN,100);
  SetProp(P_SIZE,200+random(50));
  
  create_default_npc(15);
  SetProp(P_MAX_HP, 300);
  SetProp(P_MAX_SP, 300);
  SetProp(P_XP, 2500*100);
  SetProp(P_BODY, 85+random(30));
  SetProp(P_HANDS,({" mit seinem Schnabel", 150, DT_BLUDGEON}) );


  AddInfo("greif","prahlt:'Bin ich nicht ein goettliches Geschoepf?!'\n");
  AddInfo("gott","ist begeistert:'Willst Du mich so ansprechen? Du "
+"darfst wenn Du willst.'\n");
  AddSpell(1, 200,
    "Der Greif kraechzt Dich mit Schnabelgeruch an.\n",
    "Der Greif kraechzt @WEN mit Schnabelgeruch an.\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  SetProp(P_DIE_MSG," kraechzt noch einmal schmerzverzerrt und stirbt.\n");
  AddInfo("\ndefault info","denkt . o O (Das Pack laesst mich auch nie in Ruhe)\n");
  
  SUID;
    clone_object(OBJ("gfeder"))->move(this_object());
    command("ziehe feder an");


  SetAttackChats(20, ({ "Der Greif zetert: Du Gotteslaesterer, das buesst Du mir.\n",
    "Der Greif sagt: Flieh solange Du noch kannst.\n",
    }) );
// Greif fliegt random weg und tankt ein bisschen auf.

  call_out("tank",10+random(10));
}

tank()
{
  ME->move(SEE("greifdef"),M_NOCHECK);
  SetProp(P_HP,ME->QueryProp(P_HP)+
       random(ME->QueryProp(P_MAX_HP)-ME->QueryProp(P_HP)));
  call_out("zurueck",5+random(5));
}

zurueck()
{
  ME->move(SEE("greifenh"),M_NOCHECK);
  call_out("tank",10+random(10));
}
