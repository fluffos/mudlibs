///   Zigarette:
///     Die Zigarette kostet LPs mit jedem Zug, nach einer gewissen
///     Zahl an zuegen wird man darauf hingewiesen, die Zigarette besser
///     auszudaempfen, sonst raucht man den Filter und das ist giftig.
///
///
///
///
///
///
///
///
///
///
///Monimor
///Maerz 1997


inherit "std/thing";  
   
#include "/secure/wizlevels.h"
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../moni.h"
#define textlist ({ "Du Ziehst an Deiner Zigarette.\n", \
  "Du inhalierst kraeftig.\n", \
  "Du nimmst einen tiefen Zug von Deiner Zigarette.\n", \
  "Du beginnst fuerchterlich zu husten, als Du an der Zigarette ziehst.\n", \
  "Du ziehst genuesslich an Deiner Zigarette.\n", \
  "Nach diesem Zug an der Zigarette wird Dir fast uebel.\n", \
  "HAAAAAAAATSCHIIIIIIII!\n", \
  "Du lehnst Dich laesig in ein Eck und ziehst an Deiner Zigarette.\n", \
  "Du blaest ein Ringerl mit dem Rauch der Zigarette und huepfst durch.\n" \
                 });
#define othertxt ({ " zieht an einer Zigarette.\n", \
  " inhaliert kraeftig.\n", \
  " nimmt einen tiefen Zug von einer Zigarette.\n", \
  " beginnt fuerchterlich zu husten.\n", \
  " zieht genuesslich an einer Zigarette.\n", \
  " wird fast uebel von der Zigarette.\n", \
  " hustet: HAAAAAAAAATSCHIIIIIIII!\n", \
  " lehnt laessig in einer Ecke und zieht an einer Zigarette.\n", \
  " blaest ein Ringerl mit dem Rauch der Zigarette und huepft durch.\n" \
                 });
                 

int i,ra;
string str_old=TP->QueryProp(P_TITLE);
string str_new;
string gender=TP->QueryProp(P_GENDER);
string *text,*text_other;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  text=textlist;
  text_other=othertxt;
  
  SetProp(P_LONG,bs("Diese Zigarette ist von der Marke Ingerimm aus den vereinigten Tabakwerken Monimors. Du kannst sie rauchen. Wenn sie ausgeraucht ist, solltest Du sie lieber ausmachen. Du zuendest Die Zigarette mit <rauche zigarette> an und mit <daempfe zigarette aus> kannst Du sie ausdaempfen, wegwerfen koennte Braende verursachen! RAUCHEN KANN IHRE GESUNDHEIT GEFAEHRDEN."));
  SetProp(P_SHORT,"Eine Zigarette");
  AddId("zigarette");
  SetProp(P_VALUE,1);
  SetProp(P_WEIGHT,3);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_NAME,"Zigarette");
  SetProp(P_INFO,bs("RAUCHEN KANN IHRE GESUNDHEIT GEFAEHRDEN"));
  AddCmd(({"rauch","rauche"}),"rauch");
  AddCmd(({"daempf","daempfe"}),"daempf");
  AddCmd(({"wirf","werfe"}),"wirf");
}
rauch(str)
{
  if (str=="zigarette" || str=="tschigg"){
   if (ra)
    return (notify_fail("Diese Zigarette rauchst Du schon.\n"),0);
   else
    { 
      ra = 1;
      SetProp(P_NODROP,"Eine brennende Zigarette wirft man nicht weg!\n");
      say(this_player()->name()+" zuendet sich eine Zigarette an.\n");
      write("Du zuendest Dir eine Zigarette an.\n");
      SetProp(P_SHORT,"Eine frische Zigarette (gluehend)");
        if (gender != FEMALE){
          str_new=str_old+" gefaehrdet seine Gesundheit durch Rauchen";
          TP->SetProp(P_TITLE,str_new);
          call_out("zieht",0);
        return 1;
        }
        else
        {
          str_new=str_old+" gefaehrdet ihre Gesundheit durch Rauchen";
          TP->SetProp(P_TITLE,str_new);
          call_out("zieht",0);
        return 1;
        }
     
    }
 
    return 1;
  }
  else
    return (notify_fail("DAS kannst Du nicht rauchen.\n"),0);
}

void zieht()
{
int ran;
string this,that;
  while(i != 16){
  ran=random(sizeof(text));
  this=text [ ran ];
  that=text_other [ran];
  if (i != 15 && i !=13 && i != 14 && i >=7){
    write(this);
      say(this_player()->name()+that);
      this_player()->do_damage(2,0);
      SetProp(P_SHORT,"Eine halbe Zigarette (gluehend)");
      i=i+1;
      call_out("schleife",20+random(10));
     }
   else
    if (i != 15 && i !=13 && i != 14 && i < 7){
      write(this);
      say(this_player()->name()+that);
      this_player()->do_damage(2,0);
      i=i+1;
      call_out("schleife",20+random(10));
     }
     else     
     if (i > 14){
      write("Du rauchst bereits den Filter.\n");
      say(TPN+" raucht den Filter einer Zigarette.\n");
      SetProp(P_SHORT,"Ein glimmender Zigarettenstummel.\n");
      TP->do_damage(5+random(i),0);
      TP->SetProp(P_POISON,random(3));
      i=i+1;
      call_out("weg",20);
     }
     else
      { 
        write(bs("Du ziehst an Deiner Zigarette, solltest aber mal dran denken sie auszudaempfen."));
        say(TPN+" zieht an einer Zigarette.\n");
        TP->do_damage(2,0);
        SetProp(P_SHORT,"Eine fast abgebrannte Zigarette (gluehend)");
        i=i+1;
        call_out("schleife",20+random(10));
       }
    return 0;
  }
}

daempf(str)
{
 object ob,obst;
 ob=this_object();
  if(!stringp(str) || str=="")
    return (notify_fail("WAS willst Du ausdaempfen?\n"),0);
  if(str=="zigarette aus" || str=="tschigg aus" || str=="zigarette" || str=="tschigg"){    
    if (ra)
    {
    write("Du daempfst Deine Zigarette aus.\n");
    say(TPN+" daempft eine Zigarette aus.\n");
    TP->SetProp(P_TITLE,str_old);
    obst=clone_object(OBJ("stummel"));
    obst->move(TP); 
    remove();
    return 1;
    }
    else
      return (notify_fail("Diese Zigarette brennt doch gar nicht.\n"),0);
    }
  else
    return "DAS kannst Du nicht ausdaempfen.\n";
}

void weg()
{
 object ob,stu;
 ob=this_object();
  write("Du daempfst Deinen glimmenden Zigarettenstummel aus.\n");
  say(TPN+" daempft einen glimmenden Zigarettenstummel aus.\n");
  TP->SetProp(P_TITLE,str_old);
  stu=clone_object(OBJ("stummel"));
  stu->move(TP);
  remove();
}

init()
{
  i=0;
  ra=0;
  ::init();
}
void schleife()
{
  call_out("zieht",0);
}

string extra_look()
{
  if (ra)
    {
      if (environment()->QueryProp(P_GENDER)==FEMALE)
        return BS ("Sie raucht eine Zigarette.\n");
      else
        return BS ("Er raucht eine Zigarette.\n");
    }
}
reset()
{
  object ob;
  ob=MENV;
  if (ob && !interactive(ob))
  {
    if (ob->QueryProp(P_EXITS))
       tell_room (ob, "Ein Zigarettenstummel loest sich auf.\n");
    remove();
  }
}
