inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../moni.h"

create()
{
  if (!is_clone(this_object())) return;

::create();

  SetProp(P_ARTICLE,0);
  SetProp(P_SHORT,"Relm, der Ambosszwerg");
  SetProp(P_LONG,bs("Das ist Relm vom Ambossgebirge. Er ist vor kurzem aus einem anderen Land hierher gezogen. Er ist nicht sehr gross, selbst fuer einen Zwerg. Er traegt eine Schuerze und einen Kochloeffel bei sich."));
  SetProp(P_NAME,"Relm");
  SetProp(P_GENDER,MALE);
  AddId(({"koch","zwerg","relm","ambosszwerg"}));
  SetProp(P_SIZE,120);
  SetProp(P_ALIGN,30);
  SetProp(P_LEVEL,20);
  SetProp(P_LOG_INFO,1);
  create_default_npc(20);
  SetProp(P_RACE,"Ambosszwerg");
  SetProp(P_XP,900000);
  SetProp(P_BODY,100);
  SetProp(P_HANDS,({" wischt mit Dir den Boden",120,DT_BLUDGEON}));
  
  //Informationen
  
  AddInfo("monimor","sagt: 'Netter Kerl, was?'\n");
  AddInfo(({"problem","hilfe"}),"Vor vielen Jahren war ich Schmied. Ich schuf "
    +"ein wahrhaft maechtiges Schwert. Leider hat Nidgor das herausgefunden "
    +"und in seiner endlosen Gier wollte er es haben. Ich wollte es ihm nicht "
    +"geben und so hat er die Seele meine Tochter Nalfa entfuehrt. Du wuerdest mir "
    +"sehr helfen, wenn Du sie mir wiederbringst.","klagt: ");
  AddInfo("schmied","Ja, ich war einmal Schmied. Ich habe ein Schwert "
    +"geschmiedet, welches Nidgor unbedingt haben wollte."," sagt: ");
  AddInfo("schwert","Das Schwert hat magische Kraefte, deshalb hab ich es "
    +"auch versteckt. Nidgor wollte es haben und hat deshalb die Seele "
    +"meiner Tochter entfuehrt.","sagt: ");
  AddInfo(({"nidgor","magier"}),"Nidgor ist ein boeser Magier, er will die "
    +"Macht ueber das SilberLand an sich reissen. Dazu benoetigt er aber "
    +"mein Schwert. Nachdem er mich meiner Tochter beraubt hat, hat er "
    +"sich wieder in Morkas verkrochen dieser Hund.","braust auf: ");
  AddInfo("morkas","Morkas ist die Unterirdische Behausung Nidgors. er "
    +"hat diese Stadt geschaffen, ohne offensichtlichen Eingang. Man kommt "
    +"nur durch ein Amulett dorthin.","stoehnt: ");
  AddInfo("amulett","Mit dem Amulett kommt man angeblich nach Morkas. "
    +"Ich weiss leider selber nicht genau wie.","sagt: ");
  AddInfo(({"nalfa","tochter","seele"}),"Nalfa ist meine Tochter und Nidgor "
    +"hat ihre Seele entfuehrt. Bitte bring sie mir zurueck.","schluchzt: ");
  AddInfo(({"kraft","kraefte"}),"Das Schwert ist eine sehr maechtige Waffe. "
    +"Ich moechte Dich nicht in Gefahr bringen, indem ich Dir etwas "
    +"darueber erzaehle.","sagt: ");
  AddInfo("koch","Ich war einmal Schmied, doch ich war zu gut. Um niemanden "
    +"zu gefaehrden, habe ich beschlossen, den Schmiedehammer niederzulegen "
    +"und etwas fuer das Gemeinwohl zu tun.","sagt: ");
}
