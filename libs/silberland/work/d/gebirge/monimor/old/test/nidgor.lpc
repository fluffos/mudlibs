// /d/gebirge/monimor/morkas/npc/nidgor.c   
// Der Herrscher von Morkas, 'fast' nur durch eins zu 
// killen, Waffe fallen lassen
// 16-4-97 Monimor

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../moni.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Nidgor, der Hueter des Boesen");
  SetProp(P_LONG, BS(
    "Nidgor ist ein grossgewachsener Mensch. Er hat etwas "
    +"spitze Ohren, was vermuten laesst, dass auch "
    +"Elfenblut in seinen Adern fliesst. Sein schwarzes "
    +"Haar faellt auf seine Schultern herab, glaenzend "
    +"und wohlgepflegt. Sein schlanker Koerper wirkt "
    +"anmutig und beinahe verfuehrerisch, kein Wunder, "
    +"dass so viele Schergen sich um ihn tummeln. Sein "
    +"Gesicht hat schlanke Zuege mit hochstehenden "
    +"Backenknochen, einer hohen Stirn und duesterschwarzen "
    +"Augen."));
  SetProp(P_NAME, "Nidgor");
  SetProp(P_GENDER, MALE);
  AddId(({"nidgor", "herr", "hueter"}));
  set_living_name("nidgor");
  SetProp(P_ARTICLE,0);

  create_default_npc(40);
  // P_LEVEL   = x
  SetProp(P_MAX_SP,80*8+42+random(30));
  SetProp(P_MAX_HP,80*10+50+random(50));
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit einer Handbewegung",500,DT_MAGIC}));
  // SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 205);
  SetProp(P_ALIGN, -500-random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-50);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON,DT_MAGIC,DT_LIGHT,DT_SLASH,DT_WHIP,DT_PIERCE,DT_FIRE,DT_WATER })); 
//  SetProp(P_VULNERABILITY, ({ DT_ }));
//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,50);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das Boese muss weiter leben");
  SetProp(P_KILL_NAME, "Nidgor");
  SetProp(P_KILL_MSG, "Und das Boese siegt wieder!");

  AddInfo(DEFAULT_INFO, "jagt einen kalten Schauer ueber Dich.\n");
  AddInfo("monimor", "Monimor hat mich erschaffen.","sagt: ");
  SetProp(P_LOG_INFO, "nidgor.log");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Nidgor nimmt keine Geschenke an.\n" }) );

  SetProp(P_SPELLRATE,0);
  // AddSpell(1,0,
//    ".\n",
//    ".\n",
//     DT_,([SP_SHOW_DAMAGE:1]));

//  SetChats(3, ({
//  ".\n"}) );
//  SetAttackChats(10, ({
//  ".\n"}) );

  SUID;
//  CLONEME(WEAPON "" );
//  command("zuecke waffe");
//  CLONEME(ARMOUR "" );
//  command("trage alles");
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  write_file(LOG("nidgor.dies"),
    ctime()+": "+CAP(getuid(PL))+" killt Nidgor.\n");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("npc.kills"),
    ctime()+": Nidgor hat gerade "+CAP(getuid(PL))+" umgebracht.\n");
}
