#include <defines.h>
#include "../moni.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Testobjekt");
  SetProp(P_LONG, "Immer noch ein Testobjekt: Eingabe von <eingabe> "
	+"fuehrt zur Eingabe.\n"+"\a");
  AddId("test");
}

