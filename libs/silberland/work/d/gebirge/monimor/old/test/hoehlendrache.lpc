// Der Hoehlendrache   
// 
// Maerz 1997
// Monimor

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../moni.h"
#include <defines.h>

#define LOG(x) "/d/gebirge/monimor/log/"+x

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hoehlendrache");
  SetProp(P_LONG, BS(
    "Der Hoehlendrache ist etwa fuenf Schritt lang und von schwaerzlichen und "
    +"braeunlichen Schuppen bedeckt. Seine vier Beinpaare sind aeusserst "
    +"muskuloes, so dass sie die vorderen zwei Klauen gut als Griffwerkzeuge "
    +"verwenden koennen. Er hat keine Fluegel und ist auch nicht "
    +"flugfaehig, legt allerdinds zu Fuss ein fuer Drachen ungeahntes Tempo "
    +"vor. Er bewacht seinen Hort und ist bekannt dafuer, dass er, wenn jemand "
    +"etwas davon entfernt, diesen Ungluecklichen bis in die entlegensten "
    +"Gebiete verfolgt."));
  SetProp(P_NAME, "Hoehlendrache");
  SetProp(P_GENDER, MALE);
  AddId(({"hoehlendrache", "drache"}));
  set_living_name("hoehlendrache");

  create_default_npc(22);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" schlaegt mit seiner Klaue nach Dir",230,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 440);
  SetProp(P_BODY, 150);
  // SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Drache");
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, -20);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,20);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 40);
  SetProp(P_RESISTANCE, ({ DT_MAGIC,DT_FIRE }));
  SetProp(P_VULNERABILITY, ({ DT_LIGHT }));
  // SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "kommt hereingestuerzt");
  SetProp(P_MSGOUT, "zieht davon");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  // SetProp(P_MNPC_AREA, (ROOM) );
  // SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  // SetProp(P_MNPC_DEFAULTROOM, ROOM("test"));
  // SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_SPECIAL + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " bruellt schmerzverzerrt und faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Dich hol ich mir noch.");
  SetProp(P_KILL_NAME, "Hoehlendrache");
  SetProp(P_KILL_MSG, "Ich nehme was mir gehoert!");

  AddInfo(DEFAULT_INFO, "bruellt Dich an.\n");
  AddInfo("monimor", "Monimor hat mich erschaffen.","sagt: ");
  // SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Hoehlendrache steckt gierig etwas zu seinem Hort.\n" }) );

  SetProp(P_SPELLRATE,35);
  AddSpell(3,300,
    "Der Hoehlendrache wirft Dir einen Ignifaxius entgegen.\n",
    "Der Hoehlendrache wirft @WEM einen Ignifaxius entgegen.\n",
     ({ DT_MAGIC, DT_FIRE}), ([SP_SHOW_DAMAGE:1]));
   AddSpell(1,200,
     "Der Hoehlendrache zerbeisst Deine Ruestung.\n",
     "Der Hoehlendrache zerbeisst @WESSEN Ruestung.\n",
     DT_BLUDGEON, "beiss", ([SP_SHOW_DAMAGE:1]));

  // SetChats(3, ({
  // ".\n"}) );
  SetAttackChats(10, ({
  " faucht Dich an.\n"}) );
  SetAttackChats(10, ({
  " bruellt Dich an.\n"}) );

  SUID;
  // CLONEME(WEAPON "" );
  // command("zuecke waffe");
  // CLONEME(ARMOUR "" );
  // command("trage alles");
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  write_file(LOG("hdrache.dies"),
    ctime()+": "+CAP(getuid(PL))+" killt den Hoehlendrachen.\n");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("hdrache.kills"),
    ctime()+": Der Hoehlendrache hat gerade "+CAP(getuid(PL))+" umgebracht.\n");
}

