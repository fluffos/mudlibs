// Eigentlich nur die zerbissenen Ruestung des Gegners
// vom Hoehlendrachen
// Maerz 1997 Monimor

#include <defines.h>
#include "../moni.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine zerbissene Ruestung");
  SetProp(P_LONG, BS( 
    "Diese Ruestung ist nur mehr sehr begrenzt brauchbar. Sie wurde offenbar "
    +"von sehr scharfen Zaehnen durchbissen.") );
  SetProp(P_INFO, BS("Diese Ruestung ist kaum brauchbar.") );
  SetProp(P_NAME, "Muellruestung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"ruestung", "zerbissene", "zerbissene ruestung"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 1);
  // SetProp(P_MATERIAL, MAT_ );
  // SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

  // SetProp(P_WEAR_FUNC, TO );
  // SetProp(P_REMOVE_FUNC, TO );
  // SetProp(P_DEFEND_FUNC, TO );
}
