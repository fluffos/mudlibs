inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

object pass;

create()
{
  ::create();

  pass=0;

  SSH("Der Vorraum zum Wohn- und Festbezirk");
  SetProp(P_INT_LONG,"Dies ist der Vorraum zum Wohn- und Festbezirk "
        +"von Morkas. Hier schlafen Nidgors Schergen einerseits, "
        +"andererseits empfaengt Nidgor hier seine Gaeste. Im Westen "
        +"ist die grosse Empfangshalle. Von dort hoerst Du einiges "
        +"Murmeln. Die Decke ist hier etwas hoeher und die Waende sind "
        +"mit schwarzen Wandteppichen verhangen. Fackeln erhellen "
        +"diesen Raum.\n");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21]));

  AddDetail( ({"empfangshalle", "halle"}), "Du musst sie schon betreten "
            +"um sie genau zu sehen.");
  AddDetail( ({"morkas", "stadt"}), "Du bist ja in Morkas. Was willst Du "
            +"noch mehr?");
  AddDetail( ({"nigor", "herrscher"}), "Der Herrscher dieser Stadt. Doch "
            +"er strebt nach Hoeherem.");
  AddDetail( ({"hoeheres", "hoeherem"}), "Wenn Du das anstrebst sei auf "
            +"der Hut.");
  AddDetail( ({"fackel", "fackeln"}), "Die Fackeln tauchen den Raum in "
            +"ein gespenstig flackerndes Licht.");
  AddDetail( ({"wandteppich", "wandteppiche", "teppich", "teppiche"}),
             "Der Teppich ist voller graesslicher Fratzen mit verzerrten "
            +"Gesichtern.");
  AddDetail( ({"gast", "gaeste"}), "Hier warten sie, bis sie von Nigor "
            +"vorgeladen werden. Da Du nicht zu ihnen gehoerst sei lieber "
            +"vorsichtig.");
  AddDetail( ({"fratze", "fratzen", "gesicht", "gesichter"}),
             "Die Gesichter sehen schrecklich aus. Die langen weissen "
            +"Fangzaehne geben einen scharfen Kontrast zu den laeuchtend "
            +"roten Augen und den schmutzig schwarzen Haaren.");
  AddDetail( ({"zahn", "zaehne", "fangzahn", "fangzaehne"}),
             "Sie sehen gefaehrlich spitz aus. Du willst sicher nicht in "
            +"Kontakt mit ihnen kommen.");
  AddDetail( ({"auge", "augen"}), "Sie leuchten tiefrot, alsob siemit "
            +"Kalium eingerieben worden waeren.");
  AddDetail( ({"kalium"}), "Willst Du eine Priese in Deine Augen?");
  AddDetail( ({"haar", "haare"}), "Ungepfegt und schmutziggrau wie sie "
            +"sind kannst Du nichts Genaues an ihnen erkennen.");
  AddDetail( ({"genaues"}), "Soetwas kannst Du ja nicht erkennen.");
  AddDetail( ({"licht"}), "Du wuerdest Dich wohler fuehlen, wenn es "
            +"heller hier waere.");
  AddDetail( ({"eiche", "holz", "eichenholz"}), "Es ist aeusserst massiv. "
            +"Du siehst keine Moeglichkeit, das Holz aufzubrechen.");
  AddDetail( ({"schluessel"}), "Womir kannst Du nur die Tuer "
            +"aufbekommen?");
  AddDetail( ({"berechtigung"}), "Der Ritter verlangt danach. Ob er sich "
            +"Taeuschen laesst?");
  AddDetail(({"angel","angeln"}),"Die Angeln halten die Tuer fest "
        +"in ihrem Rahmen. Sie sehen sehr massiv aus.\n");

// Da ich annehme, dass ein Ritter in den Raum kommt hab ich ihn nicht
// ausdetailiert. Vergiss nicht, dass Du abfragst, ob der RTTER im Raum
// ist, wenn die Berechtigung gezeigt wird.

  NewDoor("nordosten",MORKAS("room_b05"),({"tuer","eichholztuer"}),
                  ({  D_NAME, "Eichholztuer",
                          D_GENDER, FEMALE,
                          D_SHORT,"Im Nordosten ist eine %se "
                                 +"Eichholztuer.",
                          D_LONG, "Die Tuer ist fest in ihren Angeln "
                                 +"verankert. Sie ist aus massivem "
                                 +"Eichholz gefertigt und strotzt jedem "
                                 +"Oeffnungsversuch, es sei denn, man hat "
                                 +"einen passenden Schluessel.\n" ,
              D_CMDS, "oeffne",
                          D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL
                  }));

  AddCmd(({"zeige","zeig"}),"show");
  AddCmd(({"w","westen"}),"west");
  AddItem(MONPC("dunkler"),REFRESH_DESTRUCT);
  AddExit("westen",MORKAS("room_f02"));
}

west()
{
  if(present("dunkler",ME))
  {
    if(!pass || pass!=TP)
        {
          write("Der Ritter laesst Dich nicht passieren. Du benoetigst "
                +"eine Berechtigung.\n");
      say("Der Ritter laesst "+this_player()->name(WEN,1)+" nicht "
                +"passieren.\n");
      return 1;
        }
    else
        {
          write("Der Ritter laesst Dich passieren.\n");
          say("Der Ritter laesst "+this_player()->name(WEN,1)+
            " passieren.\n");
        }
  }
}

show(str)
{
  if(!stringp(str) || str=="")
        return(notify_fail("WAS willst Du WEM zeigen?\n"),0);
  if(member(({"ritter berechtigung","ritter zettel",
        "dunkler berechtigung","dunkler zettel","dunklem zettel",
        "dunklem berechtigung",}),str)>-1)
  {
        if(present("berechtigung",TP))
        {
      write("Du zeigst dem Ritter Deine Berechtigung.\n");
          say(TPN+" zeigt dem Ritter eine Berechtigung.\n");
          pass=TP;
          return 1;
    }
        else
          return(notify_fail("Du hast keine Berechtigung bei Dir.\n"),0);
  }
  else
        return(notify_fail("Das kannst Du soetwas nicht zeigen.\n"),0);
}
