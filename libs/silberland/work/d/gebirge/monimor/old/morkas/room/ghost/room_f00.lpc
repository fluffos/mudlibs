inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);


  AddDetail( ({"decke"}), "Die Halle ist so hoch, dass Du nur schwach die "
            +"Umrisse von matten, dunklen Steinspitzen.");
  AddDetail( ({"umriss", "umrisse"}), "Genaueres kannst Du nicht "
            +"erkennen.");
  AddDetail( ({"spitze", "spitzen", "steinspitze", "steinspitzen"}),
             "Hoffentlich ist keine locker. Sie koennten Dich sonst glatt "
            +"erschlagen.");
  AddDetail( ({"boden"}), "Obwohl sich hier niemand besonders um
            +"Sauberkeit zu kuemmern scheint ist der Boden trotzdem "
            +"vollkommen sauber. Die dunkeln steinplatten scheinen dunkel "
            +"zu strahlen.");
  AddDetail( ({"sauberkeit"}), "Wie durch geisterhand ist hier alles sehr "
            +"gepflegt.");
  AddDetail( ({"wand", "waende"}), "Die Waende sind ganz von "
            +"Wandteppichen und Vorhaengen verdeckt sodass du nichts von "
            +"ihrer kalten, steinernen Fassade bemerkst.");
  AddDetail( ({"fassade"}), "Waeren nicht so viele Vorhaenge und Teppiche "
            +"da koenntest Du sie genauer betrachten.");
  AddDetail( ({"vorhang", "vorhaenge"}), "Bunt, aber ohne Muster. "
            +"Vielleicht etwas zu dunkel fuer Deinen Geschmack.");
  AddDetail( ({"leute"}), "Viele Schergen siehst Du hier.");

// Kann man da - je nachdem, ob man 'richtig' gekleidet ist oder nicht -
// unterscheiden: "So wie Du gekleidet bist koenntest Du fast einer von
// ihnen sein." und "Sie mustern dich misstrauisch. Deine Kleidung ist
// auch sehr auffaellig."

  AddDetail( ({"kleidung"}), "Sieh doch nur, was Du an hast.");
  AddDetail( ({"morkas", "stadt"}), "Du bist ja in Morkas. Was willst Du "
            +"noch mehr?");
  AddDetail( ({"nigor", "herrscher"}), "Der Herrscher dieser Stadt. Doch "
            +"er strebt nach Hoeherem.");
  AddDetail( ({"hoeheres", "hoeherem"}), "Wenn Du das anstrebst sei auf "
            +"der Hut.");
  AddDetail( ({"fackel", "fackeln"}), "Die Fackeln tauchen den Raum in "
            +"ein gespenstig flackerndes Licht.");
  AddDetail( ({"wandteppich", "wandteppiche", "teppich", "teppiche"}),
             "Der Teppich ist voller graesslicher Fratzen mit verzerrten "
            +"Gesichtern.");
  AddDetail( ({"fratze", "fratzen", "gesicht", "gesichter"}),
             "Die Gesichter sehen schrecklich aus. Die langen weissen "
            +"Fangzaehne geben einen scharfen Kontrast zu den laeuchtend "
            +"roten Augen und den schmutzig schwarzen Haaren.");
  AddDetail( ({"zahn", "zaehne", "fangzahn", "fangzaehne"}),
             "Sie sehen gefaehrlich spitz aus. Du willst sicher nicht in "
            +"Kontakt mit ihnen kommen.");
  AddDetail( ({"auge", "augen"}), "Sie leuchten tiefrot, alsob siemit "
            +"Kalium eingerieben worden waeren.");
  AddDetail( ({"kalium"}), "Willst Du eine Priese in Deine Augen?");
  AddDetail( ({"haar", "haare"}), "Ungepfegt und schmutziggrau wie sie "
            +"sind kannst Du nichts Genaues an ihnen erkennen.");
  AddDetail( ({"genaues"}), "Soetwas kannst Du ja nicht erkennen.");


}
