
inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"
#include "buero.h"

create()
{
  ::create();

  BUERO
  POST

  SetProp(P_INT_SHORT,"Ein Buerozimmer in Morkas");
  SetProp(P_INT_LONG,"Du bist in einem Buerozimmer von Morkas. "
	+"Hier steht ein Tisch, ein Stuhl, ein Regal mit Buechern "
	+"und eine Leiter. Das Buero ist nicht besetzt. An der "
	+"Wand faellt Dir ein Loch auf. Fackeln erhellen das "
	+"Zimmer.\n");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);

  AddDetail(({"zimmer","buero","buerozimmer"}),"Du bist in einem "
	+"Buerozimmer von Morkas. Es ist drei mal drei Zwerge "
	+"gross.\n");
  AddDetail("morkas","Du bist in Morkas, in einem Buero.\n");
  AddDetail(({"buch","buecher"}),"Das duerften die Buecher sein, "
	+"die wohl auch hier gefuehrt werden.\n");
  AddDetail("regal","Das Regal reicht bis zur Decke hoch. Es ist "
	+"voller Buecher.\n");
  AddDetail("decke","Das Regal reicht bis an die niedrige Decke.\n");
  AddDetail("boden","Der Boden ist blank wie geleckt. Es sieht "
	+"insgesamt sehr ordentlich hier aus.\n");
  AddDetail("leiter","Mit dieser verschiebbaren Leiter kann man "
	+"zu den Regalen hinaufsteigen.\n");
  AddDetail(({"filz","auflage","schreibauflage"}),"Die Schreibauflage "
	+"des Schreibtisches ist aus gruenem Filz.\n");
  AddDetail("stuhl","Der Stuhl sieht ziemlich durchgesessen aus.\n");
  AddDetail(({"lade","schublade"}),"Du kannst sie oeffnen.\n");
  AddDetail(({"wand","waende"}),"Die Waende sind total glatt. Nur "
	+"an einer Wand siehst Du ein Loch.\n");

  AddCmd("oeffne","open");

  AddItem(MOOB("maypost"),REFRESH_REMOVE);
  AddExit("sueden",MORKAS("room_b03"));
}

COMMS

open(str)
{
  if(!stringp(str) || str=="")
	return(notify_fail("WAS willst Du oeffnen?\n"),0);
  if(str=="lade" || str=="schublade")
  {
    write("Du oeffnest die Schublade, aber weil Du nichts "
	  +"darin findest, schliesst Du sie enttaeuscht wieder.\n");
    say(TPN+" oeffnet die Schublade, schliesst sie aber "
	  +"enttaeuscht wieder.\n",TP);
    return 1;
  }
  else
	return(notify_fail("Das kannst Du nicht oeffnen.\n"),0);
}

