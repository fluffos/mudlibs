inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;

::create();
  AddId(({"putze","putzfrau","frau"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Putze");
  SetProp(P_SHORT,"Eine Putzfrau");
  SetProp(P_LONG,"Die Putze ist eine kleine, untergesetzte Frau. "
	+"Ihr Gewicht scheint das Deine um ein Zehnfaches zu "
	+"uebertreffen. Sie traegt eine abgetragene Schuerze und ein "
	+"Kopftuch, ausserdem scheint sie einen Vollbart zu bekommen. "
	+"Ihre Beine sind unrasiert und zeigen alles andere als nur "
	+"Wollhaare. Ihre Waffe ist ein Klosauger und ein Putzfetzen, "
	+"mit denen sie jedes Koernchen Staub wohl bis aufs "
	+"bittere Ende bekaempft.");
  SetProp(P_SIZE,150);
  SetProp(P_ALIGN,0);
  
  create_default_npc(9);
  SetProp(P_HANDS,({" mit ihrer vollen Leibeshuelle",90, DT_BLUDGEON}));
  set_living_name("putze");
  AddSpell(1,50,
    "Die Putze scheuert Dir eine.\n",
    "Die Putze scheuert @WEM eine.\n");
  SetProp(P_DIE_MSG," betet noch einmal zu den Putzgoettern und stirbt.\n");
  SetProp(P_DEFAULT_INFO,"sagt: kuemmer Dich um Deinen eigenen Dreck.\n");
  SetChats(20,({
    "Die Putze sagt: So ein Saustall!\n",
    "Die Putze droht: Mach hier bloss nichts schmutzig Du Luemmel.\n",
    "Die Putze wirbelt geschaeftig mit ihrem Sauger herum.\n"}));
  SetAttackChats(40,({
    "Die Putze ruft: Du dreckiger Mistkaefer.\n",
    "Die Putze sagt: Niemand entkommt der Wut einer Putzwuetigen.\n"}));
  SUID;


  clone_object(MOOB("fetzen"))->move(this_object());
    command("ziehe fetzen an");
  clone_object(MOOB("sauger"))->move(this_object());
    command("zuecke sauger");
}
