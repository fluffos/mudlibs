// Ein Dunkler Ritter
// Der Ritter greift jemanden nur dann an, wenn man nicht getarnt als
// Ritter ist.
// Fehlt der dunkle Helm, ist die Wahrscheinlichkeit hoeher enttarnt
// zu werden. Fehlt dann noch die dunkle Ruestung, und sogar das
// dunkle Schwert, wird man praktisch immer angegriffen.
// Zwerge werden eher geduldet als Menschen, Elfen werden wegen
// ihrer spitzen Ohren sofort erkannt, wenn alles fehlt (auch wegen
// ihrer Groesse).
//
// Monimor@Silberland, Juli 1997



inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"


create()
{
  if (!is_clone(this_object())) return;

::create();
  AddId(({"dunkler","ritter","dunkler ritter"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Dunkler Ritter");
  SetProp(P_SHORT, "Ein Dunkler Ritter");
  SetProp(P_LONG, bs(
	"Der dunkle Ritter macht einen furchteinfloessenden Eindruck. "
	+"Er gehoert zu den Spiessgesellen Nidgors. Offenbar hat dieser " 
	+"den Ritter seiner Seele entmaechtigt, Das erkennst Du an seinem "
	+"starrn Blick."));
  SetProp(P_ALIGN, -200);
  SetProp(P_SIZE,130+random(30));
  
  create_default_npc(18);
  SetProp(P_RESISTANCE,({DT_FIRE,DT_BLUDGEON}));
//  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HANDS, ({" schlaegt dir unfairerweise in die ...", 180,
	DT_BLUDGEON}) );
  set_living_name("dunkelritter");

  SetProp(P_SPELLRATE, 30);
  AddSpell(1,180+random(80),
	"Der dunkle Ritter schleudert alles boese nach Dir.\n",
	"Der dunkle Ritter schleudert alles Boese nach @WEM.\n");
  SetProp(P_DIE_MSG, " kanns einfach nicht glauben, dass er tot ist.\n");
  SetProp(P_DEFAULT_INFO, " sagt: Das Losungswort ist Thain, ohne dem sag ich Dir nichts.\n");

seteuid(getuid(this_object()));

  clone_object(MOOB("dschwert"))->move(this_object());
   command("zuecke schwert");
  clone_object(MOOB("druestung"))->move(this_object());
   command("ziehe panzer an");
  clone_object(MOOB("dhelm"))->move(this_object());
   command("ziehe helm an");
  
  
  SetChats(1, ({
  "Der dunkle Ritter zieht Dich an deinen Haaren.\n",
   "Der dunkle Ritter sagt: Gib mir all Dein GOOOLD!\n",
   "Der dunkler Ritter sagt: Ver*zensur* Dich endlich!\n"
  }) );
  SetAttackChats(20, ({
   "Der dunkle Ritter sagt: Beschwer Dich ja nicht bei TOD ueber mich ;)\n",
   "Der dunkle Ritter sagt: PECH GEHABT, DU BIST nicht tod :)))))\n"
  }) );
}

init()
{
  int i;
  object player;
  object *armour;
  object *helmet;
  object sword;
  ::init();
  player=TP;
  i=0;
  write("Grundeinstellung.\n");
  SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.0, "Elf":0.4, 0:0.2]) ]) );
  helmet=filter_objects(TP->QueryProp(P_ARMOURS),"id",AT_HELMET);
  armour=filter_objects(TP->QueryProp(P_ARMOURS),"id",AT_ARMOUR);
  sword=TP->QueryProp(P_WEAPON);
  printf("helmet = %O\narmour = %O\nsword = %O\n",helmet,armour,sword);
  write("\n");
if (sizeof(helmet) && objectp(helmet[0]))
    {
      if (!helmet[0]->id("\ndhelm"))
      {
        SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.3, "Elf":0.7, 0:0.5]) ]) );
        write("dhelm fehlt.\n");
        if (sizeof(armour) && objectp(armour[0]))
        {
        if (!armour[0]->id("\ndruestung"))
          {
            write("druestung fehlt.\n");
            SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.5, "Elf":0.9, 0:0.7]) ]) );
            if (TP->QueryProp(P_WEAPON)!=0)
            {
              if (!sword->id("\ndschwert"))
                {
                  write("nicht mal ein dschwert!\n");
                  SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.7, "Elf":1, 0:0.9]) ]) );
                }
                else
                {
                  write("hat dschwert.\n");
                }
            }
            else
            {
               write("hat gar kein schwert.\n");
               SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.7, "Elf":1, 0:0.9]) ]) );
            }
          }
          else
          {
            write("hat druestung.\n");
          }
        }
        else
        {
          write("hat gar keine ruestung.\n");
          SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.5, "Elf":0.9, 0:0.7]) ]) );
        }
      }
      else
      {
        write("zumindest dhelm auf.->Grundeinstellung.\n");
        SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.0, "Elf":0.4, 0:0.2]) ]) );
      }
    }
  else
  {
    write("Der hat net amal irgendeinen Helm auf.\n");
    SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.7, "Elf":1, 0:0.9]) ]) );
  }
}
