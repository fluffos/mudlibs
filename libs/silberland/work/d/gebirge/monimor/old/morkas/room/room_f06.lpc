
inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SSH("Die Empfangshalle");
  SetProp(P_INT_LONG,"Du befindest Dich nun in der grossen "
	+"Empfangshalle von Morkas. Dies ist der suedliche Teil. "
	+"Von hier fuehrt ein Gang in den Wohnbezirk von Morkas. "
	+"Wenn Du Dich nach Sueden hinter der Saeule davonschleichen "
	+"koenntest, wuerdest Du unbemerkt in den Wohnbereich "
	+"vordringen koennen.\n");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);

  AddExit("sueden",MORKAS("room_f07"));
  AddExit("norden",MORKAS("room_f04"));
  AddExit("nordosten",MORKAS("room_f03"));
  AddExit("nordwesten",MORKAS("room_f05"));
}
