inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SSH("Der Gang durch einen Buerokomplex");
  SetProp(P_INT_LONG,"Der Gang knickt nochmal um, diesmal von "
	+"Norden nach Suedwesten. Im Osten ist ein Laden. Ueber "
	+"der Tuer steht in grossen Buchstaben 'Gorwilds Allerlei'. "
	+"Im Westen ist nichts als Fels. Die Decke scheint Dich "
	+"erdruecken zu wollen und der Boden scheint ihr dabei "
	+"zuhilfe zu eilen.\n");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:5]));

  AddDetail("gang","Der Gang ist hier besonders niedrig.\n");
  AddDetail("laden","Der Laden gehoert Gorwild. Er sieht sehr "
	+"ungepflegt aus, soweit Du das von hier beurteilen kannst.\n");
  AddDetail("tuer",([ "mensch": "Du muesstest Deinen Kopf etwas "
	+"einziehen, um durchzupassen.\n",0: "Du passt gemuetlich "
	+"durch den Tuerstock. Jeder, der groesser ist, muss sich "
	+"ducken, um durch die niedrige Tuer zu kommen.\n","elf": 
	"Du muesstest Dich schon tief buecken, um durch diese niegrige "
	+"Tuer zu passen.\n" ]) );
  AddDetail("kopf",([ 0: "Du hast einen relativ schoenen sogar.\n",
	"mensch": "Deinen Kopf muesstest Du etwas einziehen, da "
	+"die Tuer fuer Dich zu niedrig ist.\n","elf": "Du "
	+"musst Deinen Kopf auch wegen der niedrigen Decke einziehen, "
	+"nicht bloss wenn Du durch die Tuer gehen wolltest.\n" ]) );
  AddDetail("decke",([ 0: "Niedrig ist die Decke schon, aber Du "
	+"kannst aufrecht stehen.\n", "mensch": "Du kannst gerade "
	+"noch aufrecht stehen, so niedrig ist die Decke hier.\n",
	"elf": "Du musst Deinen Kopf einziehen, um nicht an der "
	+"Decke anzustossen.\n" ]) );
  AddDetail(({"buchstabe","buchstaben"}),"Du liest: 'Gorwilds "
	+"Allerlei'. So heisst wohl der Laden.\n");
  AddDetail("gorwild","Ihm gehoert vermutlich der Laden.\n");
  AddDetail("allerlei","Man wird einiges in dem Laden finden, "
	+"hoert sich zumindest so an.\n");
  AddDetail("fels","Der Fels im Westen bildet eine ununterbrochene "
	+"Wand. Sie fuehrt von Norden nach Suedwesten.\n");
  AddDetail("wand","Sie laeuft im Westen dem Gang entlang.\n");
  AddDetail("boden","Der Boden steigt etwas zu Decke an, deshalb "
	+"ist es hier besonders niedrig.\n");

  AddItem(MONPC("dunkler"),REFRESH_DESTRUCT);
  AddExit("norden",MORKAS("room_b03"));
  AddExit("suedwesten",MORKAS("room_b05"));
  AddExit("osten",MORKAS("laden"));
}
