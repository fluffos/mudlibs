inherit "std/npc";

#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"
#include <new_skills.h>

create ()

{
  if (!is_clone(this_object())) return;

  ::create();

   SetProp(P_SHORT,"Ein Weiser Mann");
   SetProp(P_LONG,"Ein Weiser Mann aus der Klamm der Seelen. Er ist lediglich in "
      +"eine lange weisse Robe gekleidet. Er hat einen langen weissen Bart und ein "
      +"scharf geschnittenes Gesicht. Er hat eine zackige Nase, hervorstechende, "
      +"hochsitzende Backenknochen und tiefsitzende dunkelbraune Augen, die Dich "
      +"sanft zu durchdringen scheinen. In seinen Haenden haelt er lediglich einen "
      +"Wanderstab und an dem Ringfinger seiner linken Hand leuchtet ein hellblauer "
      +"walnussgrosser Ring.\n");
   SetProp(P_ALIGN,1000);
   SetProp(P_GENDER,MALE);
   SetProp(P_NAME,"Weise Mann");
   SetProp(P_RACE,"Zauberwesen");
   AddId("weiser Mann");
   AddId("weiser");
   AddId("mann");
   
   create_default_npc( 30 );

   SetProp(P_HANDS, ({" mit einem gezielten Schlag in die Lenden", 300}));

   set_living_name ("weiser");

   seteuid(getuid(this_object()));


  clone_object(MOOB("wanderstab"))->move(this_object());
   command("zuecke wanderstab");

   SetProp(P_SPELLRATE,60);
   AddSpell(1,250,
	  "Der Weise zieht Dir kraeftig eins ueber.\n",
	  "Der Weise zieht @WEM kraeftig eins ueber.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
   AddSpell(2,300,
	  "Der Weise fabriziert Muesli aus Deinen Gehirnwindungen.\n",
	  "Der Weise fabriziert Muesli aus @WESSEN Gehirnwindungen.\n",
    DT_HOLY,([SP_SHOW_DAMAGE:1]));

   SetChats(2, ({
    "Der Weise laeuft ungeduldig im Zimmer auf und ab.\n",
    "Der Weise sagt: Die Jugend ist auch nicht mehr, was sie einmal war.\n"
   }) );
   SetAttackChats(30, ({
    "Der Weise sagt: Das haettest Du Dir frueher ueberlegen sollen.\n",
    "Der Weise lacht Dich herzhaft aus.\n"
   }) );
   AddInfo("weisheit",
   "sagt: Das ist mein zweiter Vorname ;)\n");
   AddInfo("monimor",
   "sagt: Ein toller Typ, oder ;)\n");
   AddInfo("medizin",
   "sagt beleidigt: Das ist Monimors Spezialgebiet, da darfst Du nicht mich fragen.\n");
  AddInfo(({"klamm","klamm der seelen","seelenklamm"}),
    "Die Klamm war einst ein friedlicher Ort. Dafuer habe ich gesorgt. Doch Raeuber "
    +"und zwielichtige Gestalten haben sie heimgesucht, dann wurde es schwer fuer "
    +"mich alleine, fuer Ruhe zu sorgen.\n","klagt: ");
  AddInfo(({"nalfa","tochter"}),"Nalfa ist die Tochter von Relm. Sie wurde von Nidgor "
    +"entfuehrt. Ich denke ich bin zuweit gegangen. Ihre Seele gilt es ihm zu "
    +"entreissen.\n","erklaert: ");
  AddInfo("seele","Nidgor stiehlt Leuten die Seele und macht sie so zu seinen "
    +"willenlosen Sklaven. Auch Nalfas Seele hat er geraubt, um mich in die Falle "
    +"zu locken und aus Relm das Versteck des Schwertes zu pressen.\n","klagt: ");
  AddInfo("falle","Ich bin Nidgor in die Falle gelaufen. Er wusste ich wuerde "
    +"versuchen Relm zu helfen. Er dachte ich alleine koennte ihm schaden.\n","berichtet: ");
  AddInfo(({"sklave","sklaven"}),"Die laufen hier alle herum. Sie sind alle "
    +"einheitlich gekleidet, da sie sich sonst nicht erkennen wuerden. Sie sind so "
    +"dumm, dass sie sich von einer einfachen Ruestung taeuschen lassen, jeden "
    +"Andersgekleideten wuerden sie sofort attackieren.\n","laechelt: ");
  AddInfo("schwert","Relm hat es geschmiedet. Ein praechtiges Schwert, es war in "
    +"der Lage die Hand des es Fuehrenden so zu leiten, dass man mit ihm bewaffnet "
    +"annaehernd unbesiegbar war. Deshalb hat Relm es vernichtet, wie ich ihm "
    +"aufgetragen habe.\n","erklaert: ");
  AddInfo("relm","Relm ist ein guter Freund von mir und Nalfa ist seine Tochter. "
    +"ich hoffe er hat das Schwert auch wirklich vernichtet, denn in Nidgors "
    +"Haenden koennte dadurch viel Schaden entstehen.\n","erzaehlt: ");
  AddInfo("schaden","Nidgor versucht die Weltherrschaft an sich zu reissen.\n","sagt: ");
  AddInfo(({"weltherrschaft","herrschaft"}),"Jemand muss ihn aufhalten und ich kann "
    +"das nicht sein.\n","erlaeutert: ");
  AddInfo("nidgor","Nidgor ist mein boeses Spiegelbild. Ich hatte versucht, alles "
    +"Boese aus mir zu beseitigen, um vollkommen zu werden, doch das Boese hat "
    +"sich selbststaendig gemacht.\n","schluchzt: ");
  AddInfo(({"boeses","boese"}),"Ich habe mit einem magischen Spiegel alles Boese "
    +"aus mir gebannt, doch es konfluierte und bildete Nidgor.\n","sagt: ");
  AddInfo("spiegel","Der Spiegel ist zerbrochen, dennoch verbietet Nidgor Spiegel "
    +"in Morkas.\n","trauert: ");
  AddInfo("morkas","In seiner Brutstaette duerfte nirgendwo ein Spiegel zu finden "
    +"sein, er duerfte Spiegel fuerchten.\n","flucht: ");
  AddInfo(({"stab","wanderstab","stock"}),"Ich bin nicht mehr der juengste Mann, der "
    +"hier auf Erden wandelt. Ich brauche ihn als Stuetze.\n","seufzt: ");
  AddInfo("statue","Ich habe von einer Theorie gehoert, die besagt, dass man "
    +"Seelen in Statuen gefangenhalten kann. Relm ist da der Spezialist als "
    +"Schmied. Bring ihm die Statue und gib sie ihm.\n","erklaert: ");
  AddInfo("weg","Ich vermute, dass man Nidgor einen Spiegel vorhalten muss.\n",
    "philosophiert: ");
  AddCmd(({"frag","frage"}),"qask");

   SetProp(P_DEFAULT_INFO,"grummelt: Ich weiss scheinbar doch nicht alles..\n");
}

int defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  ::Defend(dam=0,dam_type,spell,enemy);
}

qask(str)
{
string who,what;
  if(sscanf(str,"%s nach %s",who,what))
    if(member(({"weiser","weiser mann","mann"}),who)!=-1 &&
      member(({"stab","stock","wanderstab"}),what)!=-1)
        if(present("wanderstab",ME))
          if(!deep_present("wanderstab",TP)){
            write("Der Weise Mann sagt: Och, den brauch ich hier im Verlies nicht mehr, "
               +"Du kannst ihn haben.\n");
            say("Der Weise Mann gibt "+TPN+" einen Wanderstab.\n");
            present("wanderstab",ME)->move(TP,M_GIVE);
            return 1;
           }
}
