inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SSH("Der Buerokomplex von Morkas");
  SetProp(P_INT_LONG,"Der Gang fuehrt weiter von Nordwesten nach "
	+"Osten. Zu beiden Seiten des Ganges sind Buerozimmer. Die "
	+"Decke wird hier wieder etwas niedriger, aber das scheint "
	+"der natuerlichen Form des Gesteins zu entsprechen. Tatsaechlich "
	+"sieht es so aus, als waere hier keine Hand angelegt worden. "
	+"Nicht einmal Fackeln siehst Du hier.\n");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:15]));

  AddDetail( ({ "stiefel" }), 
                break_string( "Die Stiefel muessen schwer und gross gewesen "+
                "sein.", 78 ) );
  AddDetail( ({ "spur", "spuren" }), 
                break_string( "Spuren schwerer Stiefel.", 78 ) );
  AddDetail( ({ "boden" }), 
                break_string( "Der Boden ist von Spuren schwerer Stiefel "+
                "uebersaeht.", 78 ) );
  AddDetail(({"fackel","fackeln"}),"Hier sind keine Fackeln. "
	+"Der Gang ist nicht veraendert worden.\n");
  AddDetail(({"gestein","fels"}),"Der typische Fels der Klamm, keine Ritzen und Fugen.\n");
  AddDetail("wand",bs("Die Wand besteht aus Felsgestein."));
  AddDetail("gang","Der Gang wurde nicht veraendert, er ist noch "
	+"ganz natuerlich.\n");
  AddDetail(({"seite","seiten","zimmer","buerozimmer"}),"Zu beiden "
	+"Seiten wurden Buerozimmer aus dem Fels geschlagen. Deren "
	+"Anlagen waren aber bereits da.\n");
  AddDetail(({"anlage","anlagen"}),"Der Gang selbst wurde nicht "
	+"veraendert, die Zimmer wurden nur aus dem Gestein kleiner "
	+"Ausbuchtungen des Ganges herausgeschlagen.\n");
  AddDetail(({"ausbuchtung","ausbuchtungen"}),"Sie wurden zu "
	+"Zimmern vergroessert.\n");
  AddDetail(({"decke","verlauf"}),"Die Decke folgt dem natuerlichen Verlauf "
	+"dieses Ganges. Sie wurde nicht veraendert. Offenbar war es "
	+"niemandem der Muehe wert.\n"); 
  AddDetail("muehe","Niemand hat es wert befunden, diesen Gang "
	+"zu veraendern.\n");
  AddDetail("form","Die Form des Ganges ist noch unveraendert. "
	+"Er erstreckt sich von Nordwesten nach Osten.\n");
  AddDetail("hand","Hier hat niemand Hand angelegt, lediglich in "
	+"kleineren Ausbuchtungen.\n");

  AddItem(MONPC("dunkler"),REFRESH_DESTRUCT);
  AddExit("nordwesten",MORKAS("room_b01"));
  AddExit("osten",MORKAS("room_b03"));
}
