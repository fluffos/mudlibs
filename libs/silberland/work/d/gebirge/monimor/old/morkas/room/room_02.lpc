inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"
#include "room1.h"

create()
{
  ::create();

  LOOK
  DETAILS
 
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:15]));

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  AddExit("osten",MORKAS("room_03"));
  AddExit("westen",MORKAS("room_01"));
}
