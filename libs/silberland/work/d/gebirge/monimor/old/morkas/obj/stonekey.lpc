
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
if (!is_clone(this_object())) return;

::create();

SetProp(P_SHORT, "Ein steinerner Schluessel");
SetProp(P_LONG, "Dieser Schluessel ist aus Stein. Dementsprechend "
  +"schwer ist er auch, doch nicht allzuschwer. Welche Tuer "
  +"mag er sperren?\n");
SetProp(P_NAME, "Steinschluessel");
AddId(({"schluessel","steinschluessel"}));
SetProp(P_WEIGHT,200);
SetProp(P_GENDER, MALE);
SetProp(P_VALUE, 40);
}

string QueryDoorKey()
{
  return (MORKAS("room_b05")+":"+MORKAS("room_f01"));
}
