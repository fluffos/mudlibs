// tja, hier ist der grosse showdown zwischen gut und boese. hier kann man
// nidgor den spiegel zeigen, dann loest er sich auf und verschmilzt mit
// dem weisen mann aus der klamm. erst wenn man nidgor besiegt hat, kann
// man die goldene statue, die hier rumsteht nehmen, die die seele nalfas
// beinhaltet.
// Ausserdem, wenn nidgor anwesend ist, saugt er fast alles licht in sich
// auf, sodass man 2 fackeln braucht, um etwas zu sehen, ansonsten ist
// der raum erhellt
//
// Monimor@SL, Oktober 1997

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <language.h>
#include <properties.h>
#include "../def.h"
#include "buero.h"

create()
{
  ::create();

  SSH("Im Zentrum von Morkas");
  SetProp(P_INT_LONG,"Du bist nun im Zentrum von Morkas angelangt. Hier ist "
    +"die Brutstaette Nidgors Uebelkeit. Hier hat er sich alle seine "
    +"teuflischen Plaene ausgedacht und versucht in die Tat umzusetzen. "
    +"Du siehst einen Schreibtisch, einen Stuhl und ein Regal am hinteren "
    +"Ende des Raumes. Du musst Deine ganze Kraft zusammensammeln, um Deine "
    +"Sinne darauf zu konzentrieren, denn hier ist die Dunkelheit noch "
    +"drueckender.\n");
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:15+random(5),ENV_TERRAIN:TT_TOWN]));
POST
// Auch hier geht die Rohrpostleitung her.
BUERO

  AddDetail("zentrum",bs("Dies ist das Zentrum von Morkas. Hier "
    +"lebt und arbeitet Nidgor."));
  AddDetail("boden",bs("Den Boden kannst Du nicht erkennen, Du bist "
	+"einfach zu schwach um soweit genaueres zu erkennen. Es muss "
	+"aber ein Boden da sein, denn wo sonst koenntest Du gerade "
	+"stehen."));
  AddDetail(({"staette","brutstaette"}),bs("Hier bruetet Nidgor "
	+"all seine ueblen Plaene aus, hier werden sie geboren und "
	+"gezuechtet, hoffentlich allerdings nicht umgesetzt."));
  AddDetail("decke",bs("Die Decke ist fuer Dich nicht erreichbar, "
	+"durch die schier undurchdringbare Dunkelheit auch nicht "
	+"zu sehen."));
  AddDetail("dunkelheit",bs("Eine drueckende Dunkelheit, die Nidgor "
	+"auszustrahlen scheint."));
  AddDetail("ende",bs("Das kostet Dich nun einiges an Kraft, aber "
	+"Du kannst am anderen Ende des Raumes ein Regal erblicken."));
  AddDetail("kraft",bs("Die Dunkelheit strengt Dich sehr an, "
	+"sodass Du alle Kraft zusammennehmen musst, um etwas zu "
	+"erkennen."));
  AddDetail("morkas","Du befindest Dich gerade im Zentrum von "
	+"Morkas, der Stadt im Stein.");
  AddDetail(({"stadt","stein"}),bs("Morkas ist eine unterirdische "
	+"Stadt, rundum sie ist bloss Stein."));
  AddDetail(({"plan","plaene"}),"Nidgor will die Welt unterwerfen.\n");
  AddDetail(({"welt","teil"}),"Du bist auch Teil dieser Welt.\n");
  AddDetail("raum","Dieser Raum ist in tiefe Dunkelheit gehuellt.\n");
  AddDetail("regal",bs("Du kannst es gerade noch erkennen. Eine "
	+"goldene Statue siehst Du dort."));
  AddDetail(({"tisch","schreibtisch"}),bs("Das ist Nidgors "
	+"Schreibtisch. Hier arbeitet er an seinen Plaenen."));
  AddDetail(({"sinn","sinne"}),"Deine Augen alleine koennen diese "
	+"Dunkelheit beinahe nicht durchdringen.\n");
  AddDetail("stuhl","Ein schlichter Stuhl. Nidgor sitzt gewoehnlich "
	+"darauf.\n");
  AddDetail("tat",bs("Um zu verhindern, dass Nidgors Plaene in die "
	+"Tat umgesetzt werden, bist Du hier."));
  AddDetail("uebelkeit",bs("Nidgors Uebelkeit wurzelt sehr tief. "
	+"Er ist durch und durch boese."));
  AddDetail(({"wand","waende"}),bs("Du kannst keine Waende ausmachen. "
	+"So ist es Dir unmoeglich abzuschaetzen, wie gross dieser "
	+"Raum ist. Doch schliesslich kannst Du eine Wand erkennen, "
	+"in der ein Loch ist."));

  AddItem(MOOB("maypost"),REFRESH_REMOVE);
  AddItem(QUESTOB("statue"),REFRESH_REMOVE);
  AddItem(MONPC("nidgor"),REFRESH_DESTRUCT);
  AddCmd(({"nimm","nehme"}),"ni");

  AddExit("osten",MORKAS("room_f11"));
}

COMMS

ni(string str)
{
  if(str=="statue" || str=="statue aus regal")
  {
    if(present("nidgor"))
    {
      write("Nidgor versperrt Dir den Weg.\n");
      return 1;
    }
    else
    {
      write("Du nimmst eine Statue aus dem Regal.\n");
      clone_object(QUESTOB("statue"))->move(TP,M_NOCHECK);
      return 1;
    }
  }
}

init()
{
::init();
  if (present("nidgor"))
    {
      SetProp(P_LIGHT,0);
      write("Irgendetwas saugt alles Licht in sich auf.\n");
    }
  else
    {
    if(!present("weiser"))
      SetProp(P_LIGHT,0);
    else
    {
      write("Ein angenehmes Licht erfuellt diesen Raum.\n");
      SetProp(P_LIGHT,1);
    }
    }
}

reset()
{
  ::reset();
  if(present("sekretaer"))
  {
    present("sekretaer")->remove();
	say("Der Sekretaer geht genervt zurueck an die Arbeit.\n");
  }

  if(present("weiser"))
  {
    present("weiser")->remove();
    say("Der Weise hat beschlossen zu gehen.\n");
  }
}
