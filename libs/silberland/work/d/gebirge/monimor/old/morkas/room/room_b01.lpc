inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

int open;

create()
{
  ::create();

  SSH("Der Gang durch einen Buerokomplex");
  SetProp(P_INT_LONG,"Dieser Gang fuehrt offenbar durch einen "
	+"Arbeitsbereich von Morkas. Auch dieser Gang ist mit "
	+"Fackeln ausgeleuchtet und ermoeglicht Dir einen Blick "
	+"in Zimmer zu beiden Seiten des Ganges. Diese sind wie "
	+"Bueros ausgestattet. Offenbar wird hier Organisatorisches "
	+"geregelt. An der Nordwand ist eine Gittertuer und an der "
	+"Suedwand ein Hebel.\n");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:15]));

  AddDetail( ({ "zwerg", "zwerge" }), 
                break_string( "So misst man hier, wie hoch die Decke ist.", 78 ) );
  AddDetail("blick","Dein Blick faellt in so manches Zimmer.\n");
  AddDetail(({"zimmer","buerozimmer"}),"Typische Buerozimmer.\n");
  AddDetail("decke","Die Decke ist hier drei Zwerge hoch.\n");
  AddDetail(({"gestein","felsgestein","fels"}),"Das Gestein der "
	+"Klamm. Dieser Gang duerfte in deren Gestein gehauen sein.\n");
  AddDetail("gang","Dieser Gang fuehrt durch einen Buerokomplex.\n");
  AddDetail(({"halterung","halterungen"}),"In den Halterungen "
	+"stecken Fackeln.\n");
  AddDetail("morkas","Du befindest Dich in Morkas, der Stadt im "
	+"Gestein der Klamm.\n");
  AddDetail("stadt","Die Stadt macht einen insgesamt dusteren "
	+"Eindruck.\n");
  AddDetail("eindruck","Duster, sehr duster.\n");
  AddDetail(({"organisatorisches","planung"}),"Hier geschieht die "
	+"Planung des Untergangs der Welt.\n");
  AddDetail(({"untergang","welt"}),"Hier geschieht die Planung "
	+"des Untergangs der Welt. Nidgor will die Macht.\n");
  AddDetail(({"macht","nidgor"}),"Nidgor will die Macht ueber "
	+"die Welt.\n");
  AddDetail(({"seite","seiten"}),"Zu beiden Seiten des Ganges "
	+"kannst Du Buerozimmer sehen.\n");
  AddDetail(({"buero","komplex","buerokomplex"}),"In diesem Komplex "
	+"wird Organisatorisches geregelt.\n");
  AddDetail(({"bereich","arbeitsbereich"}),"Hier wird gearbeitet.\n");
  AddDetail(({"fackel","fackeln"}),"Die Fackeln stecken in Halterungen. Sie erhellen den Gang.\n");
  AddDetail(({"gestein","fels"}),"Der typische Fels der Klamm, keine Ritzen und Fugen.\n");
  AddDetail(({"ritze","ritzen","fuge","fugen"}),"Soetwas kannst Du "
	+"im Gestein der Klamm nicht erwarten.\n");
  AddDetail("boden","Auf diesem Boden duerfte viel gegangen werden.\n");
  AddDetail("klamm","Du bist tief innerhalb ihres Gesteins.\n");
  AddDetail(({"wand","waende"}),"Die Wand besteht aus Felsgestein. An der "
	+"Suedwand erkennst Du einen Hebel, in der Nordwand ist eine "
	+"Gittertuer.\n");
  AddDetail("nordwand","In der Nordwand ist eine Gittertuer.\n");
  AddDetail(({"zimmer","buero"}),"Ein Buero im Buerokomplex von Morkas.\n");
  AddDetail("suedwand","An der Suedwand ist ein Hebel.\n");
  AddSpecialDetail("hebel","u_hebel");
  AddSpecialDetail(({"tuer","gitter","gittertuer"}),"u_tuer");

  AddCmd(({"druecke","drueck","bewege"}),"bewege");
  AddCmd(({"norden","n"}),"north");
  AddExit("suedosten",MORKAS("room_b02"));
}

bewege(str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WAS willst Du bewegen?\n"),0);
  if(open)
	return (notify_fail("Das Gitter ist bereits oben.\n"),0);
  if (str=="hebel")
  {
    write("Du drueckst den Hebel und ein Gittertor geht auf.\n");
	say (TPN+" bewegt einen Hebel und das Gittertor geht auf.\n");
    AddExit("norden",MORKAS("room_10"));
	open=1;
	return 1;
  }
  else
    return bs("Das kannst Du nicht bewegen.");
}

get_open(int i)
{
  open=i;
}

reset()
{
  ::reset();
  open=0;
  if(sizeof(ME->QueryProp(P_EXITS))==2)
  {
    RemoveExit("norden");
	find_object(MORKAS("room_10"))->key(0);
	find_object(MORKAS("room_10"))->RemoveExit("sueden");
  }
}

north()
{
  object dest;

  if(!open)
  {
	write("Du stoesst Dir den Kopf an dem Gittertor.\n");
	say(TPN+" stoesst sich den Kopf an dem Gittertor.\n");
	return 1;
  }
  else
	{
	  write("Als du unter dem Gittertor durchgehst, faellt "
		+"es ploetzlich hinter Dir zu.\n");
      open=0;
	  ME->get_open(0);
	  dest=find_object(MORKAS("room_10"));
	  dest->key(0);
      if(sizeof(dest->QueryProp(P_EXITS))==2)
	  {
	    dest->RemoveExit("sueden");
	  }
	}
}

init()
{
  string *exits;

  ::init();
  exits=ME->QueryProp(P_EXITS);
  if(!open)
  {
	if(sizeof(exits)==2)
	{
	  RemoveExit("norden");
	}
  }
  else
  {
    if(sizeof(exits)==1)
	{
	  AddExit("norden",MORKAS("room_10"));
	}
  }
}

u_hebel()
{
  if(open)
	return("Der Hebel ist nach unten gedrueckt.\n");
  else
	return("Der Hebel steht nach oben.\n");
}

u_tuer()
{
  if(open)
	return("Die Gittertuer ist offen.\n");
  else
	return("Die Gittertuer ist geschlossen.\n");
}
