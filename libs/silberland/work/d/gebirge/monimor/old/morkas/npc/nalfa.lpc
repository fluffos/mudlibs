
// Monimor@Silberland, Juli 1997

inherit "std/mnpc";

#include <actions.h>
#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

int tim,tom;
object ueberbringer,dummy;
int followme;
string active,long;
string lo="Nalfa ist eine Zwergin von sagenhafter "
 +"Schoenheit. Ihr rotes Haar reicht bis zu ihren "
 +"Fuessen, ihr etwas molliger Koerper hat die Anmut "
 +"einer Elfin und ihr Gesicht ist weich wie samt. Kein "
 +"Wunder, dass sich die ganze Zwergenschaft des Silber"
 +"landes um ihre Gunst streitet. Sie ist Relms ganzer "
 +"Stolz, denn bekanntlich ist die Wahrscheinlichkeit "
 +"sehr gering, eine Tochter zu bekommen, was der Grund "
 +"fuer den Reichtum einiger stolzer Zwergenvaeter ist, "
 +"die sich eine ordentliche Aussteuer bezahlen lassen. "
 +"\n"+"Nalfa";
int activity;

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  ueberbringer=0;
  followme=20;
  active="Der reglose Koerper Nalfas";
  activity=0;
  long="s Koerper liegt reglos auf einem Bett.";

  SetProp(P_SHORT,active);
  SetProp(P_LONG,lo+long+"\n");
  SetProp(P_ALIGN,50);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_RACE,"Zwerg");
  SetProp(P_NAME,"Nalfa");
  SetProp(P_ARTICLE,0);
  SetProp(P_SIZE,120+random(30));
  AddId(({"nalfa","zwergin"}));
  SetProp(P_NOATTACK,"s Anmut macht es Dir unmoeglich, "
	+"ihr auch nur ein Haar zu kruemmen.");
  
  SetProp(P_AUTOLOADOBJ,followme);
  AddCmd(({"schlafe","schlaf"}),"schlaf");
  AddCmd(({"ende","exit","quit"}),"ende");
  create_default_npc(10);
  set_living_name("nalfa");

}

void give_notify(object ob)
{
  if( (ob->id("\nnalfadiadem")) )
	  {
	    ueberbringer=TP;
		if(!activity && ueberbringer->QueryProp(P_GENDER)==MALE)
		  {
		    write("Du beugst Dich ueber Nalfas reglosen Koerper, "
			  +"um ihr das Diadem aufzusetzen. Ploetzlich "
			  +"beginnt der ganze Raum zu leuchten und ein warmes "
			  +"Licht umspuelt Dich, schliesslich oeffnet Nalfa "
			  +"langsam ihre Augen und das erste was sie sieht "
			  +"ist Dein Gesicht. Mit einem freudigen Jauchzen "
			  +"faellt sie Dir um den Hals und bedankt sich mit "
			  +"annaehernd tausend weichen Kuessen auf Deine "
			  +"hochroten Wangen. Sie beteuert, ueberall hinzugehen, "
			  +"wohin Dein Weg Dich auch hinfuehren man und Dir "
			  +"nie von der Seite zu weichen. Anschliessend umarmt "
			  +"sie ihren Vater, dessen Augen sich mit Traenen "
			  +"gefuellt sind und diese vor Glueck nun nicht mehr "
			  +"im Zaum zu halten vermag. Auch er bedankt sich "
			  +"bei Dir, jedoch mit etwas Wehmut, da er weiss, "
			  +"dass seine Tochter ihn nun verlassen wird, um "
			  +"mit Dir ein neues Leben zu beginnen. Tja, wie "
			  +"es aussieht, hast Du eine Verehrerin, auch wenn "
			  +"Dir das nicht passen sollte, so schnell wirst "
			  +"Du Nalfa wohl nicht mehr los und nichts wird "
			  +"ihr hundertdreiundzwanzig Jahre altes Herz bewegen, "
			  +"Dich zu verlassen, ausser ihr eigener Wille oder "
			  +"der Tot, der euch zu scheiden vermag.\n");
            say(ueberbringer->name()+" beugt sich ueber Nalfas "
			  +"reglosen Koerper, um ihr ein Diadem aufzusetzen. "
			  +"Ploetzlich beginnt der ganze Raum zu leuchten "
			  +"und ein warmes Licht umspuelt Dich, schliesslich "
			  +"oeffnet Nalfa langsam ihre Augen, um tief in "
			  +ueberbringer->name()+"s Augen zu blicken. Sie "
			  +"faellt "+ueberbringer->name()+" um den Hals "
			  +"und bedankt sich mit annaehernd tausend Kuessen, "
			  +"umarmt ihren Vater und beschliesst, "
			  +ueberbringer->name()+" ueberall hin zu folgen. "
			  +ueberbringer->name()+"s Gesichtsausdruck verraet, "
			  +"dass das etwas zu schnell fuer ihn ging, doch "
			  +"weiss er momentan noch nicht mit dieser Situation "
			  +"umzugehen. Ausserdem duerfte er sich ziemlich "
			  +"freuen, zwei Leben wieder einen Sinn gegeben "
			  +"zu haben und ergibt sich daher mit einem Laecheln "
			  +"seinem Schicksal.\n",ueberbringer);
            ueberbringer->AddPursuer(ME);
			activity=1;
			environment(ME)->d_var(activity);
			active="Die verliebte Zwergenschoenheit Nalfa";
			SetProp(P_SHORT,active);
			long=" ist in "+ueberbringer->name()+" verliebt.";
			SetProp(P_LONG,lo+long+"\n");
			call_out("removeme",0);
		  }
        if(!activity && ueberbringer->QueryProp(P_GENDER)==FEMALE)
		  {
		    write("Du beugst Dich langsam ueber Nalfas reglosen "
			  +"Koerper, um ihr das Diadem aufzusetzen. "
			  +"Ploetzlich beginnt der ganze Raum zu leuchten "
			  +"und ein warmes Licht umspuelt Dich, schliesslich "
			  +"oeffnet Nalfa langsam ihre Augen, um tief in "
			  +"Deine Augen zu blicken. Mit einem freudigen "
			  +"Jauchzen faellt sie Dir um den Hals und bedankt "
			  +"sich bei Dir, dass Du sie gerettet hast. Sie "
			  +"wird Dich nie vergessen und den Anblick Deiner "
			  +"Augen ist wohl mit dem zu vergleichen, was "
			  +"ein Neugeborenes zuerst sieht, wenn es auf "
			  +"die Welt kommt. Diesen Anblick wird Nalfa  "
			  +"wohl nie vergessen.\n");
            say(ueberbringer->name()+" beugt sich ueber Nalfas "
			  +"reglosen Koerper, um ihr ein Diadem aufzusetzen. "
			  +"Ploetzlich beginnt der ganze Raum zu leuchten "
			  +"und ein warmes Licht umspuelt Dich, schliesslich "
			  +"oeffnet Nalfa langsam ihre Augen, um tief in "
			  +ueberbringer->name()+"s Augen zu blicken. Sie "
			  +"faellt "+ueberbringer->name()+" um den Hals "
			  +"und bedankt sich bei ihr, dass sie zwei Zwergen "
			  +"einen neuen Sinn im Leben und einen neuen"
			  +"Anfang geschenkt hat.\n");
            activity=1;
			environment(ME)->d_var(activity);
            active="Die wunderschoene Zwergin Nalfa";
			SetProp(P_SHORT,active);
			long=" ist quicklebendig.";
			SetProp(P_LONG,lo+long+"\n");

		  }
	  }
}
schlaf(str)
{
    object *diade;
  if(!ueberbringer) return 0;
  if(str=="ein")
  {

    if(TP->id()==ueberbringer->id() && ueberbringer->QueryProp(P_GENDER)==MALE)
    {
      tim=time();
      write("Nalfa huepft mit Dir ins Heiabettchen.\n");
      say("Nalfa huepft mit "+ueberbringer->name(WEM,1)+" ins Heiabettchen.\n", ueberbringer);
      ME->move(ueberbringer,M_SILENT|M_NOCHECK);

      diade=filter_objects(all_inventory(ME),"id");
      if(sizeof(diade) && objectp(diade[0]))
      {
        diade[0]->move(ueberbringer,M_SILENT|M_NOCHECK);
      }
      }
    }
  return 0;
}

reset()
{

  ::reset();
  followme--;
  SetProp(P_AUTOLOADOBJ,followme);

  if(followme==0)
    {
      tell_object(ueberbringer,"Oje Liebling, ich bekomme doch schon grosses Heimweh, ich denke "
        +"ich werde zurueck zu meinem Vater gehen.  Ich hoffe Du verstehst mich "
        +"und bist mir nicht allzu boese, sagt Nalfa mit weinenden Augen, kuesst Dich "
        +"noch ein letztes mal und geht mit gesenktem Kopf weg. Welch ein bewegender Augenblich.\n");
      tell_room(environment(ME),"Hier spielt sich gerade ein Liebesdrama ab. Nalfa beschliesst "
        +ueberbringer->name(WEN,1)+" zu verlassen, da sie starkes Heimweh hat, kuesst "
        +ueberbringer->name(WEN,1)+" noch ein letztes mal und geht weinend. Du bist zu "
        +"Traenen geruehrt und man sieht Dir Dein Mitgefuehl an den feuchten Augen an.\n",ueberbringer);
      ME->remove();
    }
}

void BecomesNetAlive()
{
  int i;
  object *dia;
  object env;

  int tam;
  env=environment(ME);
  tom=time();
  tam=tom-tim;
  if(ueberbringer!=0)
  {
  if(tam>=2)
  {
  if(interactive(env))
    {
      ueberbringer=env;
      ME->move(environment(environment(ME)),M_SILENT|M_NOCHECK);
      tim=0;
      tom=0;
      tell_object(ueberbringer,"Nalfa ist mit Dir ins SL gekommen.\n");
printf("ueberbringer = %O\n",ueberbringer);
      say("Nalfa ist mit "+ueberbringer->name(WEM,1)+" ins Silberland gekommen.\n",ueberbringer);
	  ueberbringer->AddPursuer(ME);
      if(present("\ngolddiadem",ueberbringer))
      {
        dia=filter_objects(all_inventory(ueberbringer),"id");
        if(sizeof(dia) && objectp(dia[0]))
        {
          for(i=sizeof(dia)-1;i>=0;i--)
          {
          if(dia[i]->id()=="\ngolddiadem")
  {
    dia[i]->move(ME,M_SILENT|M_NOCHECK);
  }
          }
        }
      }
    }
  }
  }
}

nalfagoes()
{
  say("Nalfa geht zu "+ueberbringer->name(WEM,1)+" ins Heiabettchen.\n", ueberbringer);
  ME->move(ueberbringer,M_SILENT|M_NOCHECK);
}
