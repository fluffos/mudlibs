inherit "std/thing";  
   
#include "/secure/wizlevels.h"
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../def.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein goldenes Diadem");
  SetProp(P_LONG,"Dieses Diadem hat Relm, der Ambosszwerg, "
	+"geschmiedet. Es funkelt und glitzert und wirft Dir "
	+"Dein Spiegelbild etwas verzerrt zurueck. Es ist "
	+"annaehernd halbkreisfoermig und hat eine trapezoide "
	+"Auftreibung am vorderen Umfang, mit unleserlichen, "
	+"vermutlich zwergischen Runen, die bereits in der "
	+"Gussform als Matrix gedient haben muessen, da diese "
	+"Vertiefungen ohne Makel sind und kein Meister der "
	+"Schmiedekunst wohl so eine kunstvolle Gravur "
	+"meisseln koennte.\n");
  SetProp(P_INFO,"Das Diadem traegt die Seele eines Lebewesens. "
	+"finde das richtige Lebewesen und gib es ihm, so wird "
	+"dessen Koerper wieder von Leben und Geist erfuellt.\n");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_NAME,"Golddiadem");
  SetProp(P_VALUE,10000);
  SetProp(P_WEIGHT,250);
  SetProp(P_NOBUY,1);

  AddId(({"diadem","\nnalfadiadem","golddiadem"}));
  }

