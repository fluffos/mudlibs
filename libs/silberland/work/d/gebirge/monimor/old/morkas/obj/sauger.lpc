inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include "../def.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT,"Ein Klosauger");
  SetProp(P_LONG,"Mit diesem Klosauger kann man so einiges aus "
	+"einer Toilette rausholen, alles was ein Klo letztlendlich "
	+"verstopfen kann. Ausserdem kann man damit ja auch zuschlagen. "
	+"Der Sauger besteht aus einem Holststiel und einer roten "
	+"Gummihaube, die man an das Ziel ansetzt, um dann damit zu "
	+"pumpen. Das fordert allerdings einiges an Geschick.");
  SetProp(P_GENDER,MALE);
  AddId(({"sauger","klosauger"}));
  SetProp(P_VALUE,50);
  SetProp(P_WEIGHT,200);
  SetProp(P_NAME,"Klosauger");
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE,DT_BLUDGEON);
  SetProp(P_MATERIAL,MAT_WOOD);
  SetProp(P_NR_HANDS,1);
  SetProp(P_WC,10);
}
