inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../moni.h"

create()
{
  ::create();

  SSH("Ein Gang in Morkas");
  SLO("Du befindest Dich in einer Sackgasse der Hallen von Morkas. Trotz des etwas duesteren Lichtes kannst Du noch genug sehen, da Fackeln den Gang ausleuchten. Es ist kuehl hier drinnen, Du duerftest also irgendwo innerhalb des Gebirges sein. Genau kannst Du es nicht wissen, da es keinen begehbaren Weg hierher gibt. Die Waende und der Boden des Ganges sind dunkel. Insgesamt herrscht eine duestere Atmosphaere.");
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:5]));
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  AddDetail( ({ "licht" }), 
                break_string( "Das Licht der Fackeln ist ziemlich duester.", 78 ) );
  AddDetail("gang",bs("Der Gang fuehrt durch die Hallen von Morkas. Es ist ziemlich duester hier."));
  AddDetail(({"halle","hallen"}),"Die Hallen von Morkas.\n");
  AddDetail(({"fackel","fackeln"}),"Die Fackeln stecken in Halterungen. Sie erhellen den Gang.\n");
  AddDetail("morkas",bs("Morkas ist eine Art Stadt mitten im Gestein der Klamm der Seelen."));
  AddDetail("klamm",bs("Die kannst Du von hier aus nicht sehen, weil Duim Gestein der Klamm bist."));
  AddDetail(({"gestein","fels"}),"Der typische Fels der Klamm, keine Ritzen und Fugen.\m");
  AddDetail(({"weg","boden"}),bs("Auf dem Boden ist etwas Staub."));
  AddDetail("staub",bs("Du kannst Spuren im Staub erkennen."));
  AddDetail(({"spur","spuren"}),bs("Ausser Deinen eigenen Spuren, siehst Du Spuren schwerer Metallstiefel."));
  AddDetail("gebirge",bs("Du befindest Dich im Gesteinsmassiv der Klamm der Seelen in den Hallen von Morkas."));
  AddDetail("atmosphaere","Eine ziemlich duestere Atmosphaere herrscht hier.\n");
  AddDetail("stadt","Du bist in Morkas.\n");
  AddDetail("wand",bs("Die Wand besteht aus Felsgestein."));
  AddDetail(({"halterung","halterungen"}),bs("Die Fackeln stecken in ihnen. Sie sind an der Wand befestigt."));
  AddDetail("fels",bs("Der Fels ist aalglatt, keine Spalten und keine Fugen. Er ist nicht wirklich schwarz, sondern dunkel. Seltsam, aber trotzdem scheint diese Felsart das Licht staerker zu absorbieren, als wenn sie schwarz waere."));
  AddExit("westen",MORKAS("room_15"));
  AddItem("/players/monimor/npc/dunkler",REFRESH_DESTRUCT);
}
