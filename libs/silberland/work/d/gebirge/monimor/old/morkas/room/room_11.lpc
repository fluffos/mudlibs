inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:10]));
  SetProp (P_INT_SHORT, "Kneipe 'Zum Dunklen Bock'");
  SetProp(P_INT_LONG,"Du bist in der Stadtkneipe von Morkas 'Zum Dunklen Bock'. "
	+"Hier gibt es alles, was ein kaltes Herz begehrt, nur "
	+"Fluessiges versteht sich. Allerlei ueble Gestalten traiben "
	+"sich in dieser Spelunke herum, doch das soll Dich nicht "
	+"stoeren. Der Raum hat besteht aus einer Bar, ein paar "
	+"Barhockern und drei Tischen mit jeweils vier Sesseln, die "
	+"herum stehen. Von ueberall hoerst Du lautes Groelen, was auf "
	+"den Alkoholkonsum in dieser Spelunke schliessen laesst. An "
	+"der Wand hinter der Bar ist eine Tafel angebracht, die du "
	+"mit <menue> lesen kannst. Nach Nordosten kommst Du in einen "
	+"duesteren Gang, nach Sueden zurueck in den Hauptgang von Morkas.");
  AddDetail( ({ "bock" }), 
                break_string( "Das ist wohl der Name der Kneipe, einen Bock "+
                "siehst Du hier sonst naemlich nicht.", 78 ) );
  AddDetail(({"dunkler","dunklen"}),"So wie alles hier dunkel ist, "
	+"so heisst denn auch die Bar.\n");
  AddDetail("raum","Sehr gross ist dieser verrauchte Raum nicht.\n");
  AddDetail(({"stein","gestein"}),"Der typische Stein der Klamm.\n");
  AddDetail("morkas","Die Stadt im Stein.\n");
  AddDetail("stadt","Morkas ist eine Stadt, eine Stadt im Stein.\n");
  AddDetail("name","Zum Dunklen Bock.\n");
  AddDetail("herz","Kalte Herzen befriedigen hier ihren Alkoholtrieb.\n");
  AddDetail(({"trieb","alkoholtrieb"}),"Wohl einer der niedrigsten.\n");
  AddDetail("klamm","Du bist tief im Gestein der Klamm.\n");
  AddDetail("gang","Im Nordosten is ein duesterer Gang. Wo fuehrt er "
	+"hin?\n");
  AddDetail(({"wand","waende","felswand","felswaende"}),
	"Die Waende bestehen aus dem ueblichen fels der Klamm. An einer "
	+"Wand ist eine Tafel angebracht.\n");
  AddDetail("sinn","Nichts gutes in diesem.\n");
  AddDetail("fluessiges","Fluessiges kann man trinken.\n");
  AddDetail(({"stadtkneipe","kneipe"}),bs("Da bist Du gerade, allerdings machen Dich die duesteren Gestalten etwas nervoes."));
  AddDetail(({"gestalt","gestalten"}),bs("Allerlei boese Gestalten, die sicher nichts anderes im Sinn haben, als zu saufen, zu morden und zu weibern."));
  AddDetail("spelunke",bs("Das ist wohl der treffendere Ausdruck fuer diese kneipe."));
  AddDetail("wand",bs("An der Felswand hinter der Bar ist eine Tafel angebracht."));
  AddDetail(({"bar","barhocker","hocker"}),bs("An der Bar sitzen auf mehreren Barhockern duestere Gestalten, die sich ein Bock-bier nach dem anderen runterkippen."));
  AddDetail("tafel",bs("Du kannst die Tafel mit <menue> lesen."));
  AddDetail(({"tisch","tische"}),bs("An den Tischen sitzen betrunkene Bewohner dieser Stadt, die ihr Schicksal im Alkohol ertraenken."));
  AddDetail("schicksal","Ob die Bewohner sich ihres Schicksals bewusst "
	+"sind?\n");
  AddDetail("hauptgang","Der Gang ist suedlich von hier.\n");
  AddDetail("alkohol","Viele hier trinken, um sich zu betrinken.\n");
  AddDetail(({"konsum","alkoholkonsum"}),"Er ist ziemlich hoch, wenn "
	+"man bedenkt, dass hier bloss Alkohol ausgeschenkt wird.\n");
  AddDetail("ausdruck","Spelunke waere der richtige Ausdruck.\n");
  AddDetail("boden","Der Boden wurde schon lange nicht mehr gesaeubert.\n");
  AddDetail("decke","Hier ist alles so vernebelt, dass Du die Decke "
	+"nicht sehr gut erkennen kannst.\n");
  AddDetail("bewohner","Sie wohnen in Morkas, kleine untersetzte "
	+"Zwerge, die doch grosser sind als normale Zwerge.\n");
  AddDetail(({"zwerg","zwerge"}),"Die Bewohner von Morkas sind "
	+"etwas zu gross geratene Zwerge.\n");
  AddDetail("groelen","Du kansst es hoeren. Es hat nur entfernt mit "
	+"Gesang zu tun.\n");
  AddDetail("gesang","Soetwas hoerst Du wirklich nicht.\n");
  AddDetail(({"sessel"}),bs("Auf den Sesseln sitzen duestere Gestalten und betrinken sich sinnlos."));
  AddSound(({DEFAULT_SOUND,"groelen"}),bs("Von den Tischen, wie auch von der Bar toent lautes Gegroel zu Dir herueber. Es erinnert Dich allerdings nur ganz entfernt an Gesang."));
  AddSmell(({DEFAULT_SMELL,"kotze"}),bs("Es riecht ganz uebel nach Kotze hier herinnen. Allzu starke Trinker duerften hier nicht herinnen sein, allerdings weisst Cu auch nicht, wieviel der Uebeltaeter bereits getrunken hat."));
  AddDetail(({"taeter","uebeltaeter"}),bs("Irgendjemand muss doch hier gekotzt haben."));
  AddDrink("Sturm","sturm",20,5,2,2,
	({bs("Du trinkst einen heurigen Sturm und fuehlst Dich besser."),
	  bs("&& trinkt einen heurigen Sturm")}));
  AddDrink("Edelweizen",({"weizen","edelweizen"}),50,10,8,6,
	({bs("Du bestellst ein Edelweizen und erhaeltst ein Glas heller Freude mit glaenzender Krone."),
	  bs("&& trinkt ein Glas heller Freude.")}));
  AddDrink("Weihnachtsbock",({"bock","w-bock","weihnachtsbock"}), 100,30,12,4,
	({bs("Als Du dein Bockbier trinkst, ueberkommt Dich ein weihnachtliches Gefuehl, und Du waerst jetzt am liebsten bei Deiner Familie."),
	  bs("&& bekommt einen Heiligenschein von einem Weihnachtsbock.")}));
  AddDrink("Mass","mass",300,60,18,8,
	({bs("Du setzt an und trinkst die Mass auf einmal aus. Du hast Glueck, dass Dir dabei nicht wieder die Haelfte hochgekommen ist."),
	  bs("&& trinkt eine Mass auf einmal aus und kotzt sich beinahe an.")}));
  AddDrink("Eisbier","eisbier",500,100,10,3,
	({
	  bs("Du setzt zu einem Zug kuehlen Eisbiers an und spuerst "
		+"seine heilende Wirkung in die Nasenloecher hochkribbeln."),
      "&& trinkt ein Eisbier und Du siehst den Schaum aus seiner "
		+"Nase hervortreten.\n"
	}));

  AddExit("sueden",MORKAS("room_03"));
  AddExit("nordosten",MORKAS("room_12"));
}
