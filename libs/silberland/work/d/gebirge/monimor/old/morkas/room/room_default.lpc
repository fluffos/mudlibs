
inherit "/d/gebirge/monimor/morkas/room/room_f00.lpc";


#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SSH("Die Empfangshalle");
  SetProp( P_INT_LONG,"Du befindest Dich "
        + "nun in der grossen "
        +"Empfangshalle von Morkas. Dies ist der oestliche Teil "
        +"der Halle. Von hier hast Du einen guten Ueberblick ueber "
        +"das geschaeftige Treiben. Auch hier haengen Vorhaenge, liegen "
        +"Teppiche und auch eine Saeule steht hier.\n");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);

  AddDetail( ({"ueberblick"}), "Von hier kannst Du die ganze Empfangshalle "
        +"sehen.");
  AddDetail( ({"saeule"}), "Ohne die Saeule wuerde die Decke sicher auf "
        +"dich herunterstuerzen. Auf der westlichen Seite des Saeule ist "
        +"ein grosses Symbol in die Saeule eingraviert.");
  AddDetail( ({"seite"}), "auf der zur Mitte der Halle gewandten Seite "
        +"ist ein Symbol eingraviert.");
  AddDetail( ({"mitte"}), "Die Mitte des Raumes ist im Westen. Geh doch "
        +"hin.");
  AddDetail( ({"symbol"}), "Das Symbol sieht aus wie eine Rune. Sie "
        +"scheint den Einwohnern von Morkas sehr wichtig zu sein.");
  AddDetail( ({"einwohner"}), "Du siehst viele Leute hier in der Halle.");
  AddDetail( ({"rune"}), "DU betrachtest Die Rune genau. Obwohl Du sie "
        +"nicht lesen kannst hast Du ein Gefuehl, alsob sie fuer die "
        +"Seele stehen wuerde.");
  AddDetail( ({"gefuehl", "gefuehle"}), "Also Deine Gefuehle musst Du "
        +"schon selbst kennen.");
  AddDetail( ({"seele"}), "Die Seele ist fuer Die Einwohner deshalb so "
        +"wichtig, weil Nigor ihnen die ihrige genommen hat.");

  AddExit("suedwesten",MORKAS("room_f06"));
  AddExit("westen",MORKAS("room_f04"));
  AddExit("nordwesten",MORKAS("room_f02"));
}

