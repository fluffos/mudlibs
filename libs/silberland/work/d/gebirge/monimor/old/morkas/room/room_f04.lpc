
inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SSH("Die Empfangshalle");
  SetProp(P_INT_LONG,"Du befindest Dich nun in der grossen "
	+"Empfangshalle von Morkas. Du stehst hier in deren Mitte, "
	+"wo auch die groesste der fuenf Saeulen zu finden ist. "
	+"Vorhaenge haengen an der Saeule, Teppiche um sie herum. "
	+"Getraenke werden gereicht, Du wirst nicht einmal bemerkt.\n");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);

  AddExit("westen",MORKAS("room_f05"));
  AddExit("sueden",MORKAS("room_f06"));
  AddExit("norden",MORKAS("room_f02"));
  AddExit("osten",MORKAS("room_f03"));
}
