inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
   
  SetProp (P_SHORT, "Ein dunkles Schwert");
  SetProp (P_NAME, "Dunkelschwert");

SetProp (P_LONG,
  "Das Schwert hat seltsamerweise keine besonderen Schnoerkel.\n"+
  "Doch das ist nicht der Grund, warum es so leicht ist. Es liegtvielmehr\n"+
 "an dem seltsamen Metall, aus dem es geschmiedet ist. Daran duerfte es\n"+
 "auch liegen, dass du die Farbe des Schwertes nicht eindeutig definieren\n"+
 "kannst.\n");


   SetProp(P_GENDER, NEUTER);

   AddId (({ "\ndschwert","schwert","dunkelschwert"}));

SetProp(P_VALUE, 1800);
  SetProp(P_WEIGHT,10000);
   SetProp(P_WEAPON_TYPE, WT_SWORD);
   SetProp(P_DAM_TYPE, DT_SLASH);
   SetProp(P_WC, 165);
   SetProp(P_NR_HANDS, 2);
   SetProp(P_MATERIAL,MAT_MAGIC);
}
