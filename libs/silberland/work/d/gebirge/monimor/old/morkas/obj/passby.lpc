
inherit "std/thing";

#include "/secure/wizlevels.h"
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Eine Berechtigung");
  SetProp(P_LONG,"Mit dieser Berechtigung darfst Du etwas. "
	+"Es steht bloss Berechtigung darauf, deshalb kann man "
	+"schwer sagen, wozu man berechtigt ist.\n");
  AddId(({"berechtigung","zettel","passby"}));
  SetProp(P_NOSELL,1);
  SetProp(P_NOBUY,1);
  SetProp(P_NAME,"Berechtigung");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,10);
  SetProp(P_INFO,"Man koennte die Berechtigung ja jemandem zeigen.\n");
}

