// Relm ist der Auftraggeber der Quest `Die Seele der Nalfa'
// Er gibt einem ausserdem Schmiedehammer und Schmelztiegel,
// um das Diadem fuer Nalfa zu giessen, welches sie wieder 
// zum Leben erweckt.
//
// Monimor@Silberland, Juli 1997

inherit "std/npc";
inherit "/std/more";

#include <actions.h>
#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

object ueberbringer,*people,statu;

create()
{
  if (!is_clone(this_object())) return;

::create();

  SetProp(P_SHORT,"Relm, der Ambosszwerg");
  SetProp(P_LONG,bs("Das ist Relm vom Ambossgebirge. Er ist "
    +"vor kurzem aus einem anderen Land hierher gezogen. Er ist "
	+"nicht sehr gross, selbst fuer einen Zwerg. Er traegt "
	+"eine Schuerze und einen Kochloeffel bei sich."));
  SetProp(P_NAME,"Relm");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER,MALE);
  AddId(({"koch","zwerg","relm","ambosszwerg"}));
  SetProp(P_SIZE,120);
  SetProp(P_ALIGN,30);
  // SetProp(P_LEVEL,20);
  SetProp(P_LOG_INFO,1);
  create_default_npc(20);
  SetProp(P_RACE,"Ambosszwerg");
  // SetProp(P_XP,900000);
  // SetProp(P_BODY,100);
  SetProp(P_HANDS,({" wischt mit Dir den Boden",200,DT_BLUDGEON}));
  SetProp(P_NOATTACK,"duckt sich und lacht: `Das sollte ein Scherz sein, nicht wahr?'");  // Ist halt ein Quest-Npc
  set_living_name("relm");

  //Informationen
  
  AddInfo("monimor","sagt: 'Netter Kerl, was?'\n");
  AddInfo(({"problem","hilfe"}),"Vor vielen Jahren war ich Schmied. "
    +"Ich wohnte damals noch im Ambossgebirge, doch mein Freund, "
	+"ein weiser Mann, der hier wohnte, bat mich hier her zu "
	+"ziehen. Er sagte, dass er ein Problem haette, seine "
	+"'dunkle Seite' zu eliminieren. Ich sollte ihm dabei helfen, "
	+"indem ich ihm ein magisches Schwert schmieden sollte. "
	+"Kurz danach berichtete er mir, er haette einen Weg gefunden "
	+"und er brauche meine Hilfe nicht mehr. Er sagte mir aber auch, "
	+"dass das Schwert, welches ich schon geschmiedet hatte, "
	+"eine wahrhaft zu maechtige Waffe waere und ich solle sie "
	+"vernichten. Tja, da das aber nun mein Meisterwerk war, habe "
	+"ich das Schwert bloss versteckt. Der weise Mann kam mich "
	+"wieder besuchen und berichtete, dass er seine boese Seite "
	+"eliminiert habe. Ich habe ihn auf seine Frage hin, ob "
	+"ich das Schwert denn nun vernichtet habe, belogen und "
	+"versicherte ihm, dass ich es zerstoert haette. Doch "
	+"wenige Tage spaeter kam er wieder, total aufgeloest, und "
	+"faselte unverstaendliches Zeug von Gefahr etc.\n","klagt: ");
  AddInfo("gefahr",	"Tja, an dem Tag, der dem Besuch des weisen "
	+"Mannes folgte, war meine Tochter Nalfa wie versteinert. "
	+"Der weise Mann kam noch am selben Tag zu mir und erklaerte: "
	+"Sein boeses Wesen haette sich zu einer eigenstaendigen "
	+"Person zusammengefuegt und wolle ihn nun vernichten, da "
	+"er der einzige waere, der Nidgor, so heisst das Boese, "
	+"aus dieser Welt jagen koenne. Deshalb habe er die Seele "
	+"meiner Tochter als Pfand genommen, um den weisen Mann "
	+"zu koedern. Er entschuldigte sich bei mir und sagte, dass "
	+"er sich Nidgor stellen und dass dann Nalfa wieder "
	+"zum Leben erwachen wuerde. Seitdem ist er verschwunden, "
	+"doch Nalfa ist noch immer nicht wieder erwacht. Ich fuerchte, "
	+"dass Nidgor den weisen Mann betrogen hat. Willst Du mir "
	+"helfen, Nalfas Seele zu befreien, dann antworte ja. "
	+"Du wuerdest mir damit sehr helfen.\n","klagt: ");
  TP->More();
  AddInfo("schmied","Ja, ich war einmal Schmied. Ich habe ein Schwert "
    +"geschmiedet, welches ich zerstoeren haette sollen. Doch ich "
	+"tat es nicht. Als der weise Mann ploetzlich verschwunden war, "
	+"habe ich es aus seinem Versteck ausgegraben und vernichtet."
	+"Ich dachte so meine geliebte Tochter wieder zurueck zu "
	+"bekommen, doch es half nichts.\n","weint: ");
  AddInfo("schwert","Das Schwert hat magische Kraefte, deshalb hab ich es "
    +"auch versteckt. Es war doch schliesslich mein Meisterwerk, "
	+"soetwas vernichtet man nicht einfach. Letztendlich habe ich "
	+"mich dann aber doch dazu durchgerungen es zu vernichten.\n",
   "sagt: ");
  AddInfo(({"nidgor","magier"}),"Nidgor ist ein boeser Magier, er will die "
    +"Macht ueber das SilberLand an sich reissen. Deshalb hat er "
    +"mich meiner Tochter beraubt, um den weisen Mann zu koedern, "
    +"weil nur der weiss, wie man Nidgor besiegen kann. "
	+"Jetzt hat sich dieser Feigling nach Morkas verkrochen wie "
	+"ein raeudiger Hund, der darauf wartet, dass der rechte "
	+"Zeitpunkt kaeme, um seinen Plan durchzufuehren.\n","braust auf: ");
  AddInfo("morkas","Morkas ist die Unterirdische Behausung Nidgors. er "
    +"hat diese Stadt geschaffen, ohne offensichtlichen Eingang. Man kommt "
    +"nur durch ein Amulett dorthin.\n","stoehnt: ");
  AddInfo("amulett","Mit dem Amulett kommt man angeblich nach Morkas. "
    +"Ich weiss leider selber nicht genau wie, geschweige denn "
	+"wo es ist, doch die Sage sagt, dass es von einem Drachen "
	+"in einer Hoehle gehortet wird.\n","sagt: ");
  AddInfo(({"nalfa","tochter","seele"}),"Nalfa ist meine Tochter und Nidgor "
    +"hat ihre Seele entfuehrt. Bitte bring sie mir zurueck.","schluchzt: ");
  AddInfo(({"kraft","kraefte"}),"Das Schwert ist eine sehr maechtige Waffe. "
    +"Ich moechte Dich nicht in Gefahr bringen, indem ich Dir etwas "
    +"darueber erzaehle.","sagt: ");
  AddInfo("koch","Ich war einmal Schmied, doch ich war zu gut. Um niemanden "
    +"zu gefaehrden, habe ich beschlossen, den Schmiedehammer niederzulegen "
    +"und etwas fuer das Gemeinwohl zu tun.","sagt: ");
  AddInfo(({"amboss","gebirge","ambossgebirge"}),"Das Ambossgebirge ist "
    +"weit weg von hier. Ich bin lange mit meiner Tochter gewandert, um "
    +"hierher zu ziehen. Es ist ein wunderbarer Ort. Soviel Erz hast Du "
    +"noch nie gesehen, doch hier ist das Erz magisch.\n","schwaermt: ");
  AddInfo("erz","Ich habe das magische Erz, welches ich hier gefunden habe "
    +"etwa hundert und noch hundert mal gefaltet und ein Schwert von "
    +"wahrhaft grosser Macht geschaffen.\n","erklaert: ");
  AddInfo(({"freund","weiser mann","weiser"}),"Der weise Mann hat mich gebeten "
    +"ihm zu helfen, ich tats und er schimpfte mich dafuer. Doch als er "
    +"fuer meine Tochter nach Morkas ging, wusste ich, dass ich so einen "
    +"Freund wohl nie wieder finden wuerde.\n","schluchzt: ");
  AddInfo(({"dunkle seite","seite"}),"Der Weise hat versucht seine dunkle "
    +"Seite abzulegen, doch duerfte dabei etwas schief gegangen sein, denn "
    +"diese dunkle Seite hat sich zum absoluten Boesen aggregiert.\n",
    "fluestert: ");
  AddInfo(({"boeses wesen","wesen","boese","boeses"}),"Das Boese hat sich "
    +"zu einem Wesen namens Nidgor vereint.\n","nuschelt: ");
  AddInfo("weg","Das musst Du den Weisen schon selbst fragen, denn mir hat "
    +"er das nicht erklaert.\n","raunzt: ");
  AddInfo(({"werk","meisterwerk"}),"Ein wahrhaft fabelhaftes Schwert, "
    +"eigentlich weine ich ihm immer noch nach.\n","schnieft: ");
  AddInfo(({"besuch","tag","tag nach besuch"}),"Der Tag nach dem Besuch des Weisen "
    +"war der wohl schlimmste in meinem Leben, denn als ich Nalfa wecken "
    +"wollte, reagierte sie nicht und blickte starr an die Decke. Seither "
    +"hat sie kein Lebenszeichen mehr von sich gegeben.\n","weint: ");
  AddInfo("pfand","Nidgor hat Nalfas Seele als Pfand genommen, doch als sich "
    +"der Weise ihm stellte, hat er sie nicht wieder frei gegeben.\n",
    "klagt: ");
  AddInfo("hoehle","Die Hoehle muss nahe von hier sein, wenn man der Sage "
    +"glauben darf.\n","sagt: ");
  AddInfo("drache","In der Hoehle hat sich ein Drache niedergelassen, der "
    +"in seinem Hort ein Amulett behuetet. So sagt es die Sage.\n","erzaehlt: ");
  AddInfo("sage","Der Sage nach kommt man mit einem dunklen Amulett nach "
    +"Morkas, doch dieses wird von einem Drachen, vor dem man sich hueten "
    +"moege, weil er selten gierig ist, bewacht.\n","berichtet: ");
  AddInfo(({"goldstatue","statue"}),"Man kann Seelen in Goldstatuen "
    +"verwahren. Ich kann sie jedoch daraus befreien. Ist es Nalfa, die "
    +"Du in einer Statue vermutest? Dann gib mir die Statue!\n","jauchzt: ");
}

void give_notify(object ob)
{
  if( (ob->id("\ngoldstatue")) )
	  {
		ueberbringer=TP;
		statu=ob;
	    write("Als Du Relm die Statue gibst, jauchzt dieser erfreut "
		  +"und sagt:`Warte kurz, ich muss schnell ein Feuer "
		  +"anmachen, dann mach ich ein Diadem. Das setzt Du "
		  +"Nalfa dann auf. Hoffentlich funktioniert das so. "
		  +"Der weise Mann hat mir zumindest mitgeteilt, dass "
		  +"Nalfa nur so wieder zum leben erweckt werden kann.'\n");
        say(TPN+" gibt Relm eine golden Statue, welcher sich "
		  +"jauchzend darueber freut und "+TPN+" bedeutet kurz "
		  +"zu warten.\n",ueberbringer);

        call_out("feuer",5);
		return;
      }
  ::give_notify(ob);
}

void feuer()
{
  tell_room(environment(ME),"\n"+"Relm zuendet ein Feuer an, stellt einen "
	+"Schmelztiegel auf ein Gestell, das er ueber der Feuerstelle "
	+"angebracht hat und legt die Statue in den Tiegel.\n\n");
  statu->remove();
  call_out("schmilzt",10);
}

void schmilzt()
{
  tell_room(environment(ME),"\n"+"Langsam beginnt das Gold der Statue "
	+"zu schmelzen.\n\n");
  call_out("guss",10);
}

void guss()
{
  tell_room(environment(ME),"\n"+"Schliesslich ist alles Gold in dem "
	+"Tiegel geschmolzen und Relm nimmt ihn von der Flamme. Er "
	+"geht mit dem Tiegel zu einer kleinen Werkbank und giesst den "
	+"Inhalt des Tiegels in eine vorgefertigte Aussgussform. Relm "
	+"versieht die Form mit einem Deckel und haelt sie in kaltes "
	+"Wasser, offensichtlich um das Goldgeschmeide abzukuehlen.\n\n");
  call_out("kuehl",5);
}

void kuehl()
{
  int i;
  object dia;

  if (!present(ueberbringer,environment(ME)))
  {
	tell_object(ueberbringer,"Relm teilt Dir mit: Ich bin fertig! "
	  +"Ich lege Dir das Diadem zur Seite. Gib es dann einfach "
	  +"Nalfa.\n");
	tell_room(environment(ME),"Relm zieht den Behaelter aus dem "
	  +"Wasser, nimmt ein goldenes Diadem aus ihm heraus und "
	  +"legt es fuer "+ueberbringer->name()+" zur Seite.");
    dia=clone_object(QUESTOB("diadem"));
	dia->move(environment(ME),M_SILENT);
  }
  else
  {
	dia=clone_object(QUESTOB("diadem"));
	dia->move(ME,M_NOCHECK);
	dia->move(ueberbringer,M_GIVE);
    tell_object(ueberbringer,"Relm zieht dan Behaelter aus dem Wasser, oeffnet ihn und "
	  +"gibt Dir ein goldenes Diadem. Er sagt, dass Du es Nalfa "
	  +"bloss zu geben brauchst.\n");
    people=filter_array(all_inventory(environment(ME)),#'interactive);

	for(i=sizeof(people)-1;i>=0;i--)
	  {
	   if(present(people[i]))
	   {
	    if(people[i]!=ueberbringer)
		  {
		    tell_object(people[i],"Relm zieht den Behaelter aus dem "
			  +"Wasser, oeffnet ihn und gibt "+ueberbringer->name()
			  +" ein goldenes Diadem.\n");
		  
		  }
       }  
	  }
  }
}



