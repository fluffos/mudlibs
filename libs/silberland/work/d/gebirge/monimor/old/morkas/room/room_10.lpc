inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"
#include "./room1.h"

object dest;
int keytest;

create()
{
  ::create();

  dest=find_object(MORKAS("room_b01"));

  SSH("Ein Gang in Morkas");
  SLO("Hier bist Du nun am Ende des Ganges angekommen. Er endet "
    "vor einer Gittertuere. Durch das spaerliche Licht erkennst Du "
    "Rost an ihr. An den Waenden haengen auch hier Fackeln, die den "
    "Gang etwas erhellen.");
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:5]));
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  AddDetail( ({ "seele", "seelen" }), 
                break_string( "Hoffentlich stolperst Du ueber keine.", 78 ) );
  AddDetail( ({ "licht" }), 
                break_string( "Das Licht der Fackeln ist ziemlich duester.", 78 ) );
keytest=0;
  AddDetail("gang",bs("Der Gang fuehrt durch die Hallen von Morkas. Es ist ziemlich duester hier."));
  AddDetail(({"fackel","fackeln"}),"Die Fackeln stecken in Halterungen. Sie erhellen den Gang.\n");
  AddDetail("morkas",bs("Morkas ist eine Art Stadt mitten im Gestein der Klamm der Seelen."));
  AddDetail("klamm",bs("Die kannst Du von hier aus nicht sehen, weil Du im Gestein der Klamm bist."));
  AddDetail(({"felsart","art"}),"Der Fels der Klamm.\n");
  AddDetail(({"weg","boden"}),bs("Auf dem Boden ist etwas Staub."));
  AddDetail("staub",bs("Du kannst Spuren im Staub erkennen."));
  AddDetail(({"spur","spuren"}),bs("Ausser Deinen eigenen Spuren, siehst Du Spuren schwerer Metallstiefel."));
  AddDetail("gebirge",bs("Du befindest Dich im Gesteinsmassiv der Klamm der Seelen in den Hallen von Morkas."));
  AddDetail("stadt","Du bist in Morkas.\n");
  AddDetail(({"halterung","halterungen"}),bs("Die Fackeln stecken in ihnen. Sie sind an der Wand befestigt."));
  AddDetail(({"fels","gestein"}),"Der Fels ist aalglatt, keine "
	+"Spalten und keine Fugen. Er ist nicht wirklich schwarz, "
	+"sondern dunkel. Seltsam, aber trotzdem scheint diese "
	+"Felsart das Licht staerker zu absorbieren, als wenn "
	+"sie schwarz waere.");
  AddDetail("decke","Die Decke senkt sich zur Gittertuer zu.\n");
  AddDetail("ende","Das Ende von einem langen Gang.\n");
  AddDetail(({"halle","hallen"}),"Die Hallen von Morkas.\n");
  AddDetail(({"fuge","spalte","spalten","fugen"}),"Das Gestein der "
	+"Klamm und auch von hier hat soetwas nicht.\n");
  AddDetail(({"stiefel","metallstiefel"}),"Die Spuren am Boden "
	+"verraten, welche Stiefel hier entlanggelaufen sind: schwere "
	+"Metallstiefel an Fuessen schwerer Maenner.\n");
  AddDetail(({"fuesse","fuss"}),"Nur Deine Fuesse kannst Du sehen.\n");
  AddDetail(({"mann","maenner"}),"Die Spuren am Boden ruehren von "
	+"ihnen her.\n");
  AddDetail("rost","Die Gittertuer ist rostig.\n");
  AddDetail(({"wand","waende"}),"In der suedlichen Wand ist eine "
	+"Gittertuer.\n");

  AddSpecialDetail(({"tuer","gittertuer","gitter"}),"u_tuer");
  AddSpecialDetail(({"hebel"}),"u_hebel");
  
  AddExit("norden",MORKAS("room_09"));
  AddCmd(({"druecke","bewege"}), "rbewege");
}

key(int i)
{
  keytest=i;
}

rbewege(str)
{
  if (!stringp(str) || str=="")
    return (notify_fail ("WAS willst Du WOMIT druecken?\n"),0);
  if (str=="hebel mit stab" || str=="hebel mit wanderstab" )
  {
   if(!keytest){
   if(present ("wanderstab",this_player()))
    {
        write(bs("Du drueckst den Hebel mit dem Wanderstab nach unten und "
           "das Gitter geht auf."));
        say(TPN+" oeffnet das Gittertor.\n");
        AddExit("sueden",MORKAS("room_b01"));
        keytest=1;
		dest->get_open(1);
        return 1;
        } 
   else 
     {
        write ("Du hast nichts passendes, womit Du das tun koenntest dabei.\n");
        return 1;
      }
      }
      else
        {
          write("Aber das Gitter ist doch schon offen.\n");
          return 1;
         }
     }
  else {
    write("WAS willst Du WOMIT bewegen. So geht das jedenfalls "
	  +"nicht.\n");
    return 1;
   }
}

reset()
{
  ::reset();
  keytest=0;
  if(sizeof(ME->QueryProp(P_EXITS))==2)
  {
    RemoveExit("sueden");
	dest->get_open(0);
  }
}

init()
{
  string *exits;

  ::init();
  exits=ME->QueryProp(P_EXITS);
  if(!keytest)
  {
    if(sizeof(exits)==2)
	{
	  RemoveExit("sueden");
	  dest->get_open(0);
	}
  }
  else
  {
    if(sizeof(exits)==1)
	{
	  AddExit("sueden",MORKAS("room_b01"));
	  dest->get_open(1);
	}
  }

}

u_hebel()
{
  if(!keytest)
	return("Der Hebel befindet sich hinter der Gittertuere in "
	  +"einem anderen Raum. Vielleicht kannst Du ihn trotzdem bewegen.\n");
  else
    return("Der Hebel wurde nach unten gedrueckt. Er befindet sich "
	  +"nebenan.\n");
}

u_tuer()
{
  if(!keytest)
	return("Die Gittertuer versperrt den Weg nach Sueden.\n");
  else
	return("Die Gittertuer ist nach oben gezogen.\n");
}
