inherit "/d/gebirge/monimor/morkas/room/room_f00.lpc";

#include <moving.h>
#include <player.h>
#include "../def.h"
#include <properties.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT,"Die Empfangshalle");
  SetProp( P_INT_LONG, "Du befindest Dich "
        +"nun in der grossen "
        +"Empfangshalle von Morkas. Dies ist der nordoestliche Teil. "
        +"In jedem der fuenf Teile der Halle befindet sich je eine "
        +"Saeule, die die hohe Decke traegt. Der Boden ist mit "
        +"kunstvollen Teppichen ausgelegt. An den Waenden sind "
        +"Vorhaenge gespannt. Es tummeln sich viele Leute hier. "
        +"Die Halle wird von vielen Fackeln erhellt.\n");


  AddDetail( ({"saeule"}), "Die Saeule traegt die Decke der Halle. Auf "
        + "ihr siehst Du ein grosses Halbrelief auf der sueldichen "
        + "Seite. Ansonsten ist der dunkle Fels vollkommen glatt.");
  AddDetail( ({"relieff", "halbrelieff"}), "Das Relieff zeigt einen "
        + "grossen Kaempfer. In seinen Haenden schwingt er eine riesige "
        + "Streitaxt.");
  AddDetail( ({"kaempfer", "huehne", "krieger"}), "Du siehst einen "
        + "grossen Krieger, Der voll Mut eine ganze Armee anfuehrt.");
  AddDetail( ({"armee"}), "Der Krieger steht voll Mut in der ersten "
        + "Reihe und nicht in sicherer Entfernung zum Schlachtfeld.");
  AddDetail( ({"entfernung"}), "Alles, was weit weg ist ist in dieser.");
  AddDetail( ({"mut"}), "Dieses Relieff duerfte wohl als Symbol dafuer "
        + "gesehen werden.");
  AddDetail( ({"streitaxt", "axt", "waffe"}), "Eine furchtbare Waffe. "
        + "Falls Du sie jemals besitzt kannst Du Dich gluecklich "
        + "schaetzen. Wenn Dein Feind sie in Haenden haelt, dann gnaden "
        + "Dir die Goetter.");
// Lustiges Detail waer ' ... dann gnade dir' + Gottname, Wobei Gottname
// = 'Dusty' wenn spieler maennlich und 'Woody' wenn spieler weiblich.
  AddDetail( ({"feind", "feinde"}), "Huete Dich immer vor ihnen.");
  AddDetail( ({"hand", "haende"}), "Eins ... Zwei ...  Alle da. Glueck "
        + "gehabt.");
  AddDetail( ({"seite", "suedliche seite", "teil", "suedlicher teil"}),
        "Nur am suedlichen Teil der Saeule siehst du ein Halbrelieff. "
        + "Derrestliche Teil ist vollkommen blank.");
  AddDetail( ({"fels", "felsen"}), "Alle Felsen hier sind dunkel und "
        + "matt.");
  AddDetail( ({"teil", "teile"}), "Dies ist der noerdliche Teil der "
        + "grossen Empfangshalle.");

  AddExit("osten",MORKAS("room_f01"));
  AddExit("sueden",MORKAS("room_f04"));
  AddExit("suedosten",MORKAS("room_f03"));
  AddExit("suedwesten",MORKAS("room_f05"));
}
