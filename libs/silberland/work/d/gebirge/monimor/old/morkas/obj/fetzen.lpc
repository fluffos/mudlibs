inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"fetzen","putzfetzen"}));
  SetProp(P_SHORT,"Ein Putzfetzen");
  SetProp(P_LONG,"Mit diesem Putzfetzen kann man so manches sauber "
	+"machen. Er scheint einmal ein Unterhemd gewesen zu sein, "
	+"vermutlich vom Mann der dazugehoerigen Putzfrau. Der Fetzen "
	+"ist schon ziemlich schmutzig, was darauf schliessen laesst, "
	+"dass schon viel damit gearbeitet wurde.");
  SetProp(P_NAME,"Putzfetzen");
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT,50);
  SetProp(P_VALUE,10);
  SetProp(P_ARMOUR_TYPE,AT_CLOAK);
  SetProp(P_AC,3);
}
