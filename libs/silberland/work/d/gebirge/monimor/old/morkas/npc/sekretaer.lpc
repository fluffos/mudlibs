
// Monimor@Silberland, Juli 1997

inherit "std/mnpc";

#include <actions.h>
#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT,"Ein Sekretaer");
  SetProp(P_LONG,"Das ist der Privatsekretaer von Nidgor. Er "
	  +"macht Schreibarbeiten und solchen Kram. Wenn eine "
	  +"Rohrpost von Nidgor kommt, die ihn zum Diktat ruft, "
	  +"dann haelt ihn nichts mehr.");
  SetProp(P_ALIGN,-10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_GENDER,MALE);
  SetProp(P_SIZE,130+random(30));
  SetProp(P_NAME,"Sekretaer");
  AddId(({"sekretaer","privatsekretaer"}));

  create_default_npc(15);

  SetProp(P_NOATTACK," duckt sich und sagt: `Ich ruf die Wachen, "
	 +"wenn Du nicht sofort aufhoerst!");
  AddCmd(({"schick","schicke"}),"schick");
}  

schick(str)
{
  object *empf;
  string empfaenger;
  int l;
  if(!present("rohrpost",TP))
	return(notify_fail("Du hast doch gar keine Rohrpost!\n"),0);
  if(!stringp(str) || str=="")
	return(notify_fail("Syntax: <schicke rohrpost an <empfaenger>>\n"),0);
  if(sscanf(str,"rohrpost an %s",empfaenger)>0)
  {
    if(ME==find_living(empfaenger))
	{
	  write("Der Sekretaer sagt: Soetwas doofes. Steht neben mir "
		+"und schickt mir eine Rohrpost. Hier hast Du sie wieder, "
		+"Du kannst mit mir, wenn ich im selben Raum bin schliesslich "
		+"auch sprechen.\n");
      say("Der Sekretaer gibt "+TP->name(WEM,1)+" seine "
		+"Rohrpost zurueck.\n");
      return 1;
	}
  }
}
