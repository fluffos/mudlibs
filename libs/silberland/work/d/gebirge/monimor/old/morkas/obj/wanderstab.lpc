inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create()
{

if (!is_clone(this_object()))
   return;

  ::create();

   SetProp(P_SHORT,"Ein Wanderstab");
   SetProp(P_LONG,"Ein dicker, wuchtiger Ast einer Dir unbekannten Baumart.\n");
   SetProp(P_NAME,"Wanderstab");
   SetProp(P_GENDER, MALE);
   AddId("\nwanderstab");
   AddId("stab");
   AddId("wanderstab");
   AddId("stab");
   SetProp(P_VALUE, 600);
   SetProp(P_WEIGHT, 500);

   SetProp(P_WEAPON_TYPE, WT_CLUB);
   SetProp(P_DAM_TYPE, DT_BLUDGEON);

   SetProp(P_WC, 40);
   SetProp(P_NR_HANDS, 1);
}
