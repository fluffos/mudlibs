inherit "std/thing";

#include "/secure/wizlevels.h"
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../def.h"

string absender,stri;
int kuerzel,i;
int hier(object ob);

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Eine Rohrpost");
  SetProp(P_LONG,"Mit der Rohrpost werden Nachrichten in "
	  +"Morkas verschickt. Man kann sie natuerlich auch "
	  +"lesen. Man kann sie auch in gewissen Raeumen, die "
	  +"die noetige Oeffnung zum Rohrpostsystem besitzen, "
	  +"verschicken.\n");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,250);
  SetProp(P_VALUE,50);
  SetProp(P_NOBUY,1);
  SetProp(P_NAME,"Rohrpost");
  AddId(({"post","rohrpost"}));
  AddCmd(({"lies","lese"}),"msg");
  AddCmd(({"schick","schicke"}),"send");
}

set_vars(int i,string stri)
{
  kuerzel=i;
  absender=stri;
}

msg(str)
{
  string nachricht;
  if (!stringp(str) || str=="")
	return(notify_fail("WAS willst Du lesen?\n"),0);
  if (str=="post" || str=="rohrpost")
  {
    switch(kuerzel)
	{
	  case 1: write(CAP(absender)+" schreibt: Zum Diktat!\n");
		break;
      case 2: write(CAP(absender)+" schreibt: Zigarettenpause!\n");
		break;
      case 3: write(CAP(absender)+" schreibt: bin Ausserhalb, "
		+"rekrutiere gerade.\n"); break;
      case 4: write(CAP(absender)+" schreibt: bin kurz weg -> "
	    +"uriniere gerade.\n"); break;
      case 5: write(CAP(absender)+" schreibt: bin beim Chef.\n");
		break;
	  default: write("Irgendwas funzt net ...\n"); break;
	}
    return 1;
  }
  else
	return(notify_fail("Das kannst Du nicht lesen.\n"),0);
}

send(str)
{
  string empfaenger;
  object *empf;
  int l;
  if(!interactive(environment(ME)))
	return(notify_fail("Du hast doch gar keine Rohrpost!\n"),0);
  if(!stringp(str) || str=="")
	return(notify_fail("Syntax: <schicke rohrpost an <empfaenger>>\n"),0);
  if(present("\nmaypost",environment(environment(ME))))
  {
  if(sscanf(str,"rohrpost an %s",empfaenger)>0)
  {
  if(present(empfaenger,environment(environment(ME))))
	return(notify_fail("Aber der Empfaenger ist mit Dir im "
	  +"selben Raum, willst Du ihm das nicht persoenlich sagen?\n"),0);
    write("Du schickst eine Rohrpost. Empfaenger: "+CAP(empfaenger)+"\n");
	say(TPN+" schickt eine Rohrpost. Empfaenger: "+CAP(empfaenger)+"\n");
	if(empfaenger=="sekretaer")
	{
	  ME->move(MORKAS("room_b07"),M_NOCHECK);
      if(present("sekretaer",environment(ME)) && kuerzel==1 &&
		  absender=="nidgor")
	  {
	    tell_room(environment(ME),"Der Sekretaer liest eine "
		  +"Rohrpost, packt seinen Notizblock samt Bleistift "
		  +"und geht.\n");
        empf=filter_array(all_inventory(environment(ME)),#'hier);
		for(l=sizeof(empf)-1;l>=0;l--)
		{
		  if(present(empf[0]))
		  {
		    if(empf[0]->id("sekretaer"))
			{
			  empf[0]->move(MORKAS("room_n01"),M_GO);
			  return 1;
			}
		  }
		}
	  }
	}
    tell_room(environment(ME),"Eine Rohrpost kommt an, der "
	  +"Sekretaer liest sie und legt sie beiseite.\n");
    return 1;
 }
 else
   return(notify_fail("Das kannst Du nicht abschicken.\n"),0);
 }
 else
   return(notify_fail("Hier kannst Du keine Rohrpost abschicken.\n"),0);
}

int hier(object ob)
{
  if(ob->id("sekretaer"))
	return 1;
  else
	return 0;
}
