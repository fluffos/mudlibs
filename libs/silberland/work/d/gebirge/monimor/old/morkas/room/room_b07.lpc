
inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"
#include "buero.h"

create()
{
  ::create();

  BUERO
  POST

  SetProp(P_INT_SHORT,"Das Buero des Sekretaers");
  SetProp(P_INT_LONG,"Das ist das Buero des Privatsekretaers von "
	  +"Nidgor. Der Raum ist durch Fackeln erhellt, sodass "
	  +"Du seine Einrichtung gut erkennen kannst. Du siehst "
	  +"Einen Schreibtisch, einen Sessel, ein Regal und ein "
	  +"Loch in der Wand.");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);

  AddDetail(({"lade","schublade"}),"Du kannst sie oeffnen.\n");
  AddDetail("boden","Auf dem Boden liegen einige Zettel.\n");
  AddDetail("zettel","Keine besonderen Zettel.\n");
  AddDetail(({"buero","buerozimmer","zimmer","raum"}),"Dieses "
	+"Zimmer ist ein Buero. Es ist sehr unordentlich hier. "
	+"Ueberall liegen Zettel herum.\n");
  AddDetail("decke","Die Decke ist nicht sehr hoch und ungeschmueckt.\n");
  AddDetail("einrichtung","Du siehst einen Stuhl, einen Tisch und "
	+"ein Regal.\n");
  AddDetail(({"fackel","fackeln"}),"Fackeln erhellen diesen Raum.\n");
  AddDetail(({"filz","auflage","schreibauflage"}),"Der Schreibtisch "
	+"ist mit gruenem Filz ueberzogen, dort wo man schreibt.\n");
  AddDetail("morkas","Du bist in Morkas.\n");
  AddDetail("nidgor","Nidgor herrscht ueber all das hier.\n");
  AddDetail("regal","In dem Regal stehen viele Buecher.\n");
  AddDetail(({"buch","buecher"}),"Uninteressant, was der Sekretaer "
	+"hineinschrieb. Es handelt sich um die Bilanzen von Morkas.\n");
  AddDetail(({"bilanz","bilanzen"}),"Man muesste alle Buecher "
	+"lesen um etwas darueber herauszufinden. Das wuerde zu lange "
	+"dauern.\n");
  AddDetail(({"sessel","stuhl"}),"Der Stuhl steht beim Schreibtisch. "
	+"Er sieht schon ziemlich durchgesessen aus.\n");
  AddDetail("wand","In der Wand ist ein Loch. Daneben haengt einen "
	+"Tafel.\n");
  AddDetail("waende","Die Waende sind aus dem Gestein der Klamm. "
	+"In einer Wand ist ein Loch.\n");
  AddDetail("zugang","Das Loch ist der Zugang zum Rohrpostsystem "
	+"von Morkas. Dadurch ist dieser Raum mit ganz Morkas "
	+"vernetzt.\n");
  AddDetail(({"flecke","fleck","flecken","tintenfleck","tintenflecke",
	"tintenflecken"}),"Du kannst mehrere Tintenflecken auf dem "
	+"Schreibtisch sehen. Er scheint nicht besonders gepflegt.\n");
  AddDetail("vorbau","Der Vorbau erhebt sich hinter der "
	+"Schreibauflage etwa eine Elle hoch.\n");
  AddDetail("gestein","Das typische Gestein der Klamm.\n");
  AddDetail("klamm","Du bist tief innerhalb des Gesteins der Klamm.\n");

  AddCmd(({"oeffne"}),"lade");
  AddItem(MOOB("maypost"),REFRESH_REMOVE);
  AddItem(MONPC("sekretaer"),REFRESH_DESTRUCT);
  AddExit("westen",MORKAS("room_b03"));
}

COMMS

lade(str)
{
  if(!stringp(str) || str=="")
	return(notify_fail("WAS willst Du oeffnen?\n"),0);
  if(str=="lade" || str=="schublade")
  {
    if(present("sekretaer",ME))
    {
      write("Der Sekretaer laesst Dich nicht an die Lade ran.\n");
	  say("Der Sekretaer laesst "+this_player()->name(WEN,1)+" nicht "
	    +"an die Lade ran.\n");
      return 1;
    }
    else
    {
      if(present("steinschluessel",TP) || deep_present("steinschluessel",
	    TP))
      {
	    write("Du oeffnest die Schublade, findest aber nichts, was "
	  	  +"Du nicht schon haettest.\n");
        say(TPN+" oeffnet die Schublade, schliesst sie aber wieder "
		  +"enttaeuscht.\n");
        return 1;
	  }
	  else
	  {
	    write("Du oeffnest die Lade und entdeckst einen Schluessel "
		  +"und einen Zettel. Du packst beides ein.\n");
        say(TPN+" oeffnet die Lade und packt erfreut etwas ein.\n");
	    clone_object(MOOB("stonekey"))->move(TP,M_SILENT);
	    clone_object(MOOB("passby"))->move(TP,M_SILENT);
		return 1;
	  }
    }
  }
  else
    return(notify_fail("Das kannst Du nicht oeffnen.\n"),0); 
}

reset()
{
  object sekr;
  ::reset();
  if(!present("sekretaer",ME))
  {
    if(find_living("sekretaer"))
	{
	  find_living("sekretaer")->move(ME,M_GO);
	}
	else
	{
	  AddItem(MONPC("sekretaer"),REFRESH_DESTRUCT);
	}
  }
}

