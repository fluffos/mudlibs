inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

   AddId(({"\ndruestung","panzer","dunklelpanzer"}));
   SetProp (P_SHORT,"Ein dunkler Panzer");
   SetProp (P_LONG,
      "Der Panzer ist sehr leicht, scheint aber sehr robust zu\n"+
"sein. Die Farbe kannst Du nicht definieren und schwarz willst Du ihn\n"+
"auch nicht nennen. Dunkel eben. Vielleicht liegt das und auch das geringe\n"+
"Gewicht daran, dass es ein Panzer eines Magiewesens ist.\n");
   SetProp (P_NAME, "Dunkelpanzer");
   SetProp (P_GENDER, MALE);
   SetProp (P_WEIGHT, 700);
   SetProp (P_VALUE, 1400);

   SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
   SetProp (P_AC, 25);

   SetProp(P_MATERIAL,MAT_MAGIC);
}
