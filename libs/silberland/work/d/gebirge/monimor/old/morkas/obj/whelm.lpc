inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId(({"helm","waechterhelm"}));
   SetProp(P_SHORT, "Ein verbeulter Helm");
   SetProp(P_NAME, "Waechterhelm");
   SetProp(P_LONG, "Der Helm ist der typische Helm der Kerkerwache "
	 +"von Morkas. Er ist total verbeult und alt.\n");
   SetProp(P_GENDER, MALE);
   AddId(({"helme","waechterhelm"}));
   SetProp(P_ARMOUR_TYPE, AT_HELMET);
   SetProp(P_AC, 3);
   SetProp(P_WEIGHT, 200);
   SetProp(P_VALUE, 100);
   SetProp(P_MATERIAL,MAT_IRON);
}
