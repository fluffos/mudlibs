inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

int parole,getrunken;
object uebermittler;

create()
{
  ::create();

  parole=0;
  uebermittler=0;

  SSH("Der Kerker von Morkas");
  SetProp(P_INT_LONG,"Du befindest Dich im Kerker von Morkas. Hier "
	+"ist es nun wirklich duster. Wenn es keine Fackeln gaebe, wuerde "
	+"man hier gar nichts sehen. Die Waende bestehen aus Felsgestein, "
	+"aber sie scheinen noch dunkler zu sein, als Du das schon gewohnt "
	+"bist. Hier steht ein kleiner Tisch mit einem Sessel davor. Das "
	+"duerfte also das Wachzimmer des Kerkers sein.");
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5+random(5)]));
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  AddDetail( ({ "licht" }), 
                break_string( "Das Licht der Fackeln ist ziemlich duester.", 78 ) );

  AddDetail("art","Eine Stadt im Stein.\n");
  AddDetail("stein","Im Stein der Klamm.\n"); 
  AddDetail("decke",bs("Die Decke ist hier nicht sehr hoch und "
	+"unrgelmeaessig gewoelbt."));
  AddDetail(({"felsart","fels"}),bs("Der uebliche Fels der Klamm. "
	+"Er ist total glatt."));
  AddDetail(({"gestein","felsgestein"}),"Gestein bildet diesen Kerker.\n");
  AddDetail("kerker","Hier werden Gefangene aufbewahrt. "
	+"Es ist sehr unwirtlich hier.\n");
  AddDetail(({"stiefel","metallstiefel"}),bs("Hier muss jemand mit "
	+"schweren Stiefeln gegangen sein. Du kannst deren Spur "
	+"deutlich erkennen."));
  AddDetail("raum",bs("Der Raum ist von Fackeln erhellt. Gefangene "
	+"werden hier nicht aufbewahrt, sondern oestlich von hier."));
  AddDetail(({"gefangener","gefangene"}),bs("Hier in diesem Raum "
	+"halten sich nur Waechter auf. Oestlich von hier werden die "
	+"Gefangenen verwahrt."));
  AddDetail(({"fugen","fuge","ritze","ritzen","spalte","spalten"}),bs("Soetwas "
	+"wirst Du hier nirgends finden, nur ausnahmsweise maximal."));
  AddDetail(({"seele","seelen"}),bs("Die spuken hier ueberall herum."));
  AddDetail(({"zimmer","wachzimmer"}),bs("Hier sitzen die Waechter "
	+"und wachen ueber die Gefangenen."));
  AddDetail(({"wand","waende"}),bs("Du siehst aalglatte Waende. Sie "
	+"sind aus dem Gestein der Klamm."));
  AddDetail(({"fackel","fackeln"}),"Die Fackeln stecken in Halterungen. Sie erhellen den Raum.\n");
  AddDetail("morkas",bs("Morkas ist eine Art Stadt mitten im Gestein der Klamm der Seelen."));
  AddDetail("klamm",bs("Die kannst Du von hier aus nicht sehen, weil Du im Gestein der Klamm bist."));
  AddDetail(({"gestein","fels"}),"Der typische Fels der Klamm, keine Ritzen und Fugen.\m");
  AddDetail(({"boden"}),bs("Auf dem Boden ist etwas Staub."));
  AddDetail("staub",bs("Du kannst Spuren im Staub erkennen."));
  AddDetail(({"spur","spuren"}),bs("Ausser Deinen eigenen Spuren, siehst Du Spuren schwerer Metallstiefel."));
  AddDetail("gebirge",bs("Du befindest Dich im Gesteinsmassiv der Klamm der Seelen in den Hallen von Morkas."));
  AddDetail("atmosphaere","Eine ziemlich duestere Atmosphaere herrscht hier.\n");
  AddDetail("stadt","Du bist in Morkas.\n");
  AddDetail(({"waerter","waechter"}),bs("Sie bewachen die Gefangenen "
	+"des Kerkers."));
  AddDetail("wand",bs("Die Wand besteht aus Felsgestein."));
  AddDetail(({"halterung","halterungen"}),bs("Die Fackeln stecken in ihnen. Sie sind an der Wand befestigt."));
  AddDetail("fels",bs("Der Fels ist aalglatt, keine Spalten und keine Fugen. Er ist nicht wirklich schwarz, sondern dunkel. Seltsam, aber trotzdem scheint diese Felsart das Licht staerker zu absorbieren, als wenn sie schwarz waere."));
  AddDetail("sessel",bs("Das ist der Sessel eines Waerters. Er ist klein und die Sitzflaeche schon beinahe durchgesessen."));
  AddDetail("sitzflaeche",bs("Der Sessel fuerfte viel benutzt sein, da von der Sitzflaeche fast nichts mehr uebrig ist."));
  AddDetail("tisch",bs("Der Tisch ist klein, niedrig und viereckig. Einige Flaschen stehen auf ihm."));
  AddSpecialDetail("flaschen","flasche");
  AddCmd(({"trinke","trink"}),"trink");
  AddCmd(({"o","osten"}),"east");
  AddCmd(({"sag","sage"}),"say");

  AddExit("sueden",MORKAS("kerker_01"));
  AddExit("oben",MORKAS("room_16"));

  AddExit("osten",MORKAS("kerker_02"));
  AddItem(MONPC("waechter"),REFRESH_DESTRUCT);


//ACHTUNG moni! hier musst du noch einen waechter proggen :)
}
trink(str)
{
    if(!stringp(str) || str=="")
   return (notify_fail("WORAUS willst Du trinken?\n"),0);
    if (str=="aus flasche" || str=="flasche") {
   if (getrunken)
    write ("Die Flasche ist leer.\n");
   else
    {
	write(bs("Du nimmst einen kraeftigen Schluck und fuehlst Dich gleich etwas besser."));
	say(TPN+" nimmt einen kraeftigen Schluck aus der Flasche.\n");
    this_player()->heal_self(random(30));
    }
  return (getrunken = 1);
    }
    else
	return (notify_fail("Daraus kannst Du nicht trinken.\n"),0);
  }

flasche()
{
  if (getrunken)
    return(notify_fail("Die Flasche ist schon leer.\n"),0);
  else
    return bs("Du koenntest aus der Flasche trinken.");
}

east()
{
  if(present("waechter"),environment(TP))
  {
    if(parole && uebermittler==TP)
	{
	  write("Der Waechter laesst Dich bereitwillig durch.\n");
	  say("Der Waechter laesst "+TP->name(WEN,1)+" bereitwillig durch.\n");
	  parole=0;
	  uebermittler=0;
	}
	else
	{
	  if(present("waechter")){
	  write("Der Waechter laesst Dich nicht durch.\n");
	  say("Der Waechter laesst "+TP->name(WEN,1)+" nicht durch.\n",TP);
	  return 1;}
	}
  }
  else
	return 0;
}

say(str)
{
if(present("waechter"))
  if(str=="thain" || str=="Thain" || str=="THAIN")
  {
    parole=1;
	uebermittler=TP;
	write("Der Waechter ist hocherfreut. Offenbar hat er seit "
	  +"schon laenger die Parole nicht mehr gehoert. Er wird "
	  +"Dich durchlassen.\n");
    say("Der Waechter freut sich. Du weisst nich warum.\n",TP);
	return 1;
  }
}

