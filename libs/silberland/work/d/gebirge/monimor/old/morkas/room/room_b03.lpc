inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SSH("Der Buerokomplex");
  SetProp(P_INT_LONG,"Der Gang biegt hier von Westen nach Sueden ab. "
	+"Nach Norden und Osten sind Eingaenge zu Buerozimmern. Auch "
	+"hier ist es dunkel. Die Decke allerdings steigt wieder etwas "
	+"an.\n");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:15]));

  AddDetail(({"gestein","fels"}),"Der typische Fels der Klamm, keine Ritzen und Fugen.\m");
  AddDetail(({"ritze","ritzen","fuge","fugen"}),"Soetwas gibt es "
	+"im Gestein der Klamm nicht.\n");
  AddDetail("klamm","Du bist tief innerhalb ihres Gesteins.\n");
  AddDetail("boden","Du siehst viele Spuren.\n");
  AddDetail(({"spur","spuren"}),"Sie sind stark verwischt. Hier "
	+"duerfte viel los sein.\n");
  AddDetail("gang","Der Gang wurde natuerlich belassen.\n");
  AddDetail(({"eingang","eingaenge"}),"Im Noden und Osten sind "
	+"Eingaenge zu Buerozimmern.\n");
  AddDetail(({"zimmer","buerozimmer"}),"In den Zimmern wird "
	+"geschaeftig gearbeitet.\n");
  AddDetail("decke","Die Decke wird wieder etwas hoeher.\n");
  
  AddExit("osten",MORKAS("room_b07"));
  AddExit("norden",MORKAS("room_b08"));
  AddExit("westen",MORKAS("room_b02"));
  AddExit("sueden",MORKAS("room_b04"));
}
