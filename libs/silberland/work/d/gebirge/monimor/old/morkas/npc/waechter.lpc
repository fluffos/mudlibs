// Monimor@Silberland, Juli 1997



inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"


create()
{
  if (!is_clone(this_object())) return;

::create();
  AddId(({"waechter","kerkerwaechter"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Kerkerwaechter");
  SetProp(P_SHORT, "Ein Kerkerwaechter");
  SetProp(P_LONG, "Der Kerkerwaechter ist ein kleiner untersetzter, "
	+"aber wohl kraeftiger Zwerg. Sein Bart reicht bis an seinen "
	+"Schwertfortsatz seines Brustbeins, sodass er bereits auf "
	+"seinem dicken Bauch zu liegen kommt. Sein grimmiger Blick "
	+"scheint Dich fragend zu durchbohren, als warte er auf "
	+"etwas.\n");
  SetProp(P_ALIGN, -100);
  SetProp(P_SIZE,120+random(20));
  
  create_default_npc(18);
  SetProp(P_HANDS, ({" tritt Dir in den Bauch", 180,
	DT_BLUDGEON}) );
  set_living_name("kerkerwaechter");

  SetProp(P_SPELLRATE, 30);
  AddSpell(1,180+random(50),
	"Der Kerkerwaechter schlaegt einen Aufwaertshaken.\n",
	"Der schlaegt @WEN mit einem Aufwertshaken.\n");
  SetProp(P_DIE_MSG, " scheidet sich den Bauch haltend dahin.\n");
  AddInfo(DEFAULT_INFO, "Sag mir das Losungswort und wir beide "
	+"haben kein Problem miteinander.","meckert: ");

seteuid(getuid(this_object()));

  clone_object(MOOB("wschwert"))->move(this_object());
   command("zuecke schwert");
  clone_object(MOOB("wpanzer"))->move(this_object());
   command("ziehe panzer an");
  clone_object(MOOB("whelm"))->move(this_object());
   command("ziehe helm an");
  
  
  SetChats(5, ({
	"Der Kerkerwaechter sagt: Na, wie lautet die Parole?\n"
	"Der Kerkerwaechter scharrt mit seinen Fuessen auf dem Boden.\n"
  }) );
}

