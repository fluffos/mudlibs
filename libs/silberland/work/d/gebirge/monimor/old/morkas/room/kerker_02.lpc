inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

int getrunken;

create()
{
  ::create();

  SSH("Der Kerker von Morkas");
  SetProp(P_INT_LONG,"Du bist in einer Zelle des Kerkers von Morkas. "
	+"Der quadratische Raum wird von vier Felswaenden begrenzt. "
	+"In der Westwand ist eine Oeffnung, durch die Du hier raus "
	+"kommst. Auf dem Boden liegt eine Strohmatte und sehr viel "
	+"Staub. In den Ecken sind Spinnweben als weiteres Zeichen, "
	+"dass hier schon lange nicht mehr geputzt wurde. Die Waende "
	+"sind mit seltsamen Zahlen vollgekritzelt und in als Du "
	+"naeher hinsiehst, siehst Du, dass darunter ein Skelett "
	+"liegt, das krampfhaft ein Stueck Kreide in seiner toten Hand haelt.");
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:5]));
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);

  AddDetail("person","Was uebrig von ihr ist, ist das Skelett.\n");
  AddDetail("raum","Du stehst darin.\n");
  AddDetail(({"seele","seelen"}),bs("Vielleicht ist die Seele "
	+"dieses Skelettes noch irgendwo hier."));
  AddDetail(({"skelett"}),bs("Hier hat wohl jemand laenger "
	+"eingesessen. Die Hand des Skeletts haelt noch ein Stueck Kreide "
	+"fest umschlungen."));
  AddDetail("westwand","Du kannst eine Oeffnung in ihr entdecken.\n");
  AddDetail("zelle","Bis auf ein Skelett ist hier niemand eingesperrt.\n");
  AddDetail("oeffnung","Sie ist in der Westwand. Nicht besonders "
	+"hoch, aber man kann bequem hindurchschreiten.\n");
  AddDetail("decke","Die Decke ist hier sehr niedrig.\n");
  AddDetail(({"felsart","felsgestein","gestein"}),"Der typische "
	+"Fels der Klamm.\n");
  AddDetail(({"fuge","fugen","ritze","ritzen","spalte","spalten"}),
	"Soetwas findest Du fast nirgends in der Klamm.\n");
  AddDetail("hand",bs("Bloss das Skelett einer Hand. Sie haelt noch "
	+"ein Stueck Kreide.")); 
  AddDetail("morkas",bs("Morkas ist eine Stadt mitten im Gestein der Klamm der Seelen."));
  AddDetail("klamm",bs("Die kannst Du von hier aus nicht sehen, weil Du im Gestein der Klamm bist."));
  AddDetail(({"gestein","fels"}),"Der typische Fels der Klamm, keine Ritzen und Fugen.\m");
  AddDetail(({"boden"}),bs("Auf dem Boden liegt viel Staub und eine Strohmatte."));
  AddDetail("staub",bs("Du kannst Spuren im Staub erkennen."));
  AddDetail(({"spur","spuren"}),bs("Ausser Deinen eigenen Spuren, siehst Du Spuren schwerer Metallstiefel und einer anderen unseligen Person."));
  AddDetail("gebirge",bs("Du befindest Dich im Gesteinsmassiv der Klamm der Seelen in den Hallen von Morkas."));
  AddDetail("atmosphaere","Eine ziemlich duestere Atmosphaere herrscht hier.\n");
  AddDetail("stadt","Du bist in Morkas.\n");
  AddDetail("kerker","Du stehst mitten drin.\n");
  AddDetail(({"stueck","kreide"}),bs("Damit kann man schreiben, bloss dieses "
	+"Stueck kann man aus der verkrampften Hand des Skelettes "
	+"nicht mehr befreien."));
  AddDetail("tag","Tag 0 war auch der letzte Tag dieser unseligen "
	+"Person.\n");
  AddDetail();
  AddDetail(({"wand","waende","felswand","felswaende"}),bs("Die "
	+"Waende bestehen aus Felsgestein. An einer Wand stehen "
	+"Zahlen, darunter liegt ein Skelett."));
  AddDetail("zahlen",bs("Du siehst Dir die Zahlen genauer an und erkennst, dass es sich wohl darum handeln musste, wie lange hier jemand noch abzusitzen hatte, doch als der Tag 0 kam, fing er wieder bei 360 an. Tja .."));
  AddDetail(({"matte","strohmatte","stroh"}),bs("Sehr gemuetlich duerfte man hier nicht schlafen.."));
  AddDetail(({"ecke","ecken"}),bs("In den Ecken sind viele Spinnweben."));
  AddDetail(({"weben","spinnweben"}),bs("Hier scheint lange niemand mehr geputzt zu haben, soviele Spinnweben sind hier."));
  AddDetail("zeichen",bs("Spinnweben, Staub, .."));
  AddDetail("..",bs("Das haettest Du Dir denken koennen, dass man das nicht untersuchen kann ;)"));
  AddDetail("fels",bs("Der Fels ist aalglatt, keine Spalten und keine Fugen. Er ist nicht wirklich schwarz, sondern dunkel. Seltsam, aber trotzdem scheint diese Felsart das Licht staerker zu absorbieren, als wenn sie schwarz waere."));
  AddDetail("licht","Das Licht wird hier sehr stark absorbiert und "
	+"wirkt dadurch sehr duester.\n");
  AddDetail(({"stiefel","metallstiefel"}),bs("Die Spuren deuten "
	+"darauf hin, dass hier schwere Stiefel verewigt sind. Ihre "
	+"Traeger duerften etwas regelrecht hinter sich hergeschleift "
	+"haben."));
  AddDetail("traeger","Vermutlich arbeiten sie hier.\n");


  AddExit("westen",MORKAS("kerker"));
}
