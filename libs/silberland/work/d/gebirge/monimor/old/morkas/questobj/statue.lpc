
inherit "std/thing";  
   
#include "/secure/wizlevels.h"
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../def.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_LONG,"Du siehst Dir die kleine goldene Statue an, die "
	+"Dich an das Abbild Nalfas erinnert. Vielleicht hat diese "
	+"Statue etwas mit dem Problem des Relm zu tun.\n");
  SetProp(P_SHORT,"Eine kleine Goldstatue");
  SetProp(P_INFO,"In dieser Statue ist veilleicht die Seele der "
	+"Nalfa eingesperrt.\n");
  SetProp(P_NAME,"Goldstatue");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,250);
  SetProp(P_VALUE,5000);
  SetProp(P_NOBUY,1);

  AddId(({"statue","goldstatue","\ngoldstatue"}));
}

