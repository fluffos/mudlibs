
// Nidgor, der Herr des Boesen. letzer Gegner in der
// Quest 'Die Seele der Nalfa'
// Er huetet die Seelen seiner Untergebenen und der Nalfa.
// Aggressionen gegen ihn machen ihn nur staerker, zu besiegen
// ist er nur, indem man ihm einen Spiegel vors Gesicht
// haelt->naeheres siehe quest_doku
//
// Monimor@Silberland, Juli 1997



inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
#include <new_skills.h>

int lastHP=this_object()->QueryProp(P_MAX_HP);
int hand=400;
create()
{
  if (!is_clone(this_object())) return;

  ::create();

  AddId(({"nidgor","herr"}));
  SetProp(P_ARTICLE,0);
  SetProp(P_NAME,"Nidgor");
  SetProp(P_SHORT,"Nidgor, der Herr des Boesen");
  SetProp(P_LONG,"Nidgor ist der Herr des Boesen. Er ist grossgewachsen "
	+"und befehligt ein Heer von Zwergen, die unter seinem Bann "
	+"stehen und willenlos dienen. Sein Haar ist so schwarz wie "
	+"seine Magie und ebenso schwarz sind seine Augen, in deren "
	+"Tiefe Du dich verlieren koenntest. Nidgor traegt eine Robe "
	+"aus schwarzem Leinen, die mit silbernen Ornamenten bestickt "
	+"ist und schwarze Lederstiefel, die bis zu seinen Knien reichen."
    +"Er traegt keine Waffe. Nidgor muss ein maechtiger Magier sein"
  );
  SetProp(P_GENDER,MALE);
  SetProp(P_ALIGN,-1000);
  SetProp(P_SIZE,200);
  set_living_name("nidgor");

  create_default_npc(30);
  SetProp(P_HANDS,({" mit allem was boese ist",hand,DT_MAGIC }) );

//  clone_object(MOOB("nidgorhphook"))->move(this_object());

// ME->AddHpHook();

  SetProp(P_SPELLRATE,60);

  AddSpell(3,200+random(100),
	"Nidgor entzieht Dir Dein gutes Gemuet.\n",
	"Nidgor entzieht @WEM das gute Gemuet.\n",
	DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  AddInfo(DEFAULT_INFO,"Lass die dummen Fragen Fragen sein, schliesse "
    +"Dich mir einfach an, dann wird alles gut.\n","grinst: ");
  // Ich bin nicht ganz sicher, ob ich da einen command schliesse nidgor an
  // einfuehren soll, der evt. den tod fuer den betroffenen bedeutet, da er
  // letztendlich seine seele aufgibt. idee per mail bitte :)
  AddInfo("statue","Du willst die Statue? Hol sie Dir doch!\n","hoehnt: ");
  AddInfo("weiser","Ein alter Narr ist er, sonst nichts. Soll er sich "
    +"doch zum Teufel scheren!\n","flucht:");
  AddInfo("relm","Bloss ein Mittel zum Zweck der Kleine. Er hat sich "
    +"seine Misere selbst zuzuschreiben.\n","raunt: ");
  AddInfo("misere","Haette er dieses Schwert nicht geschmiedet ...\n",
    "raunt: ");
  AddInfo("schwert","Hast Du es? Ich wuerde Dich reich belohnen!\n","geifert: ");
  AddInfo("nalfa","Sie ist bloss ein unschuldiges Opfer.\n","lacht: ");
  AddInfo("opfer","Hahahahahahahaha!\n","prustet: ");
  AddInfo(({"seele","seelen"}),"Seelen werden in Goldstatuen festgehalten.\n","grinst: ");
}

