int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int ran,hp,maxHp;
  ::Defend(dam=0,dam_type,spell,enemy);
  hp=ME->QueryProp(P_HP);
  maxHp=ME->QueryProp(P_MAX_HP);
  tell_room(ENV(enemy),"Nidgor hat "+hp+" ("+maxHp+") LP und "
	+hand+" Hands.\n");
  ran=random(7);
  if (ran==1)
  {
    ME->SetProp(P_HANDS,({" mit allem was boese ist",hand,
		DT_MAGIC }) );
    hand=hand+random(50);
	return 1;
  }

}
