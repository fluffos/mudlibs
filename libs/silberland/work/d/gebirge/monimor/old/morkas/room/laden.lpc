
inherit "std/laden";

#include <properties.h>
#include <laden.h>
#include "../def.h"

create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In einem Laden.\n");
  SetProp(P_INT_LONG,"Du stehst in einem Laden in Morkas. Ein "
	+"kleiner Tresen steht im hinteren Ende des Raumes. An der "
	+"Wand haengt ein Schild. Der kleine Raum ist mit nutzlosem "
	+"Krempel ueberfuellt. Der Muellschlucker duerfte nicht "
	+"so fleissig sein.\n");
  SetProp(P_SHOP_FLAGS,SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "der Verkaeufer");
  SetProp(P_SHOPKEEPER_ID,"gorwild");
  SetProp(P_SHOPKEEPER_GENDER,MALE);

  AddDetail(({"waende","wand"}),"An einer Wand haengt ein Schild.\n");
  AddReadDetail ("schild",
	"Verfuegbare Befehle:\n"+
	"<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
	"<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"+
	"<kaufe> nummer oder\n"+
	"<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
	"<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
	"<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
	"                  Haendler dafuer bezahlt.\n"+
	"<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
	"                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  SetStorageRoom (MORKAS("lagerraum"));

  AddDetail("laden","Hier kann man Sachen kaufen, verkaufen etc. "
	+"Es sieht ziemlich unordentlich hier aus.\n");
  AddDetail(({"sache","sachen"}),"Was Du hast und was Du willst.\n");
  AddDetail("morkas","Du bist in einem Laden in Morkas.\n");
  AddDetail("tresen","Ein kleiner Tresen steht im hinteren Teil "
	+"des Raumes. Er ist umgeben von Krempel, nutzlosem wie "
	+"sinnvollem.\n");
  AddDetail(({"teil","ende"}),"Dieser Teil ist der wohl "
	+"unordentlichste. Der Tresen ist fast total versteckt hinter "
	+"lauter Krempel.\n");
  AddDetail("wand","An der Wand haengt ein Schild. Die Wand ist "
	+"ausserdem das einzige hier, wo kein Krempel herumliegt.\n");
  AddDetail("schild","Du kannst es lesen.\n");
  AddSpecialDetail(({"gorwild","verkaeufer"}),"verk");
  AddDetail("raum","Der Raum ist nicht gross, dafuer mit sinnlosem "
	+"Krempel ueberfuellt, der hier ueberall herumliegt. Es "
	+"bedarf eines geuebten Verkaeufers sich hier zurechtzufinden.\n");
  AddDetail("krempel","Vieles, wenn nicht alles was Deinem "
	+"Wortschatz gelaeufig und dennoch kaeuflich zu erwerben ist, "
	+"liegt hier am Boden herum, mehr oder eher minder "
	+"funktionstuechtig.\n");
  AddDetail(({"wortschatz","schatz"}),"Wahrlich viel muss hier "
	+"herumliegen, bloss einen Schatz wirst Du hier nicht finden, "
	+"obwohl das wohl Teil deines Wortschatzes ist.\n");
  AddDetail("boden","Auf dem Boden liegt allerhand Krempel herum. "
	+"Du musst aufpassen, dass Du auf nichts trittst, der "
	+"Verkaeufer wuerde Dich dafuer sicher bezahlen lassen.\n");
  AddDetail("decke","Ein Wunder, dass der Krempel sich nicht bis "
	+"zur Decke stapelt, die hier nicht allzu hoch ist.\n");
  AddDetail("wunder","Glaubst Du an Wunder?\n");

  AddItem(MONPC("verkaeufer"),REFRESH_DESTRUCT);

  AddExit("westen",MORKAS("room_b04"));
}

verk()
{
  if(present("gorwild"))
	return "Gorwild ist hier der begnadete Verkaeufer, ohne ihn "
	  +"geht hier nichts.\n";
  else
	return "Da kein Verkaeufer da ist, wird hier nichts gehen. "
	  +"Nur Gorwild kennt sich hier aus.\n";
}
