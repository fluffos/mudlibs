
inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

#define riddles \
  ({ \
	"Welche Pruefung muss der Apfel bestehen, um vom " \
	   +"Baum fallen zu duerfen?\nAntworte!\n", \
    "Sich einen solchen zu heben, siehst Du dem Knochen " \
	  +"nicht an.\nAntworte!\n",  \
    "Dein Haar wird mit des Berges Ruecken keine Freude " \
	  +"haben. Womit?\nAntworte!\n", \
    "So bewegt ES nun die Zeit, ohne ihm kommt auch ein Wagen " \
	  +"nicht weit.\nAntworte!\n", \
    "Goettlich sind sie und dennoch klein. Wer?\nAntworte!\n", \
    "Wenn aus der Spur das 'T' verschwindet, mit ihr den " \
          +"Fluss man ueberwindet. Womit?\nAntworte!\n", \
    "Ob die wohl dem Koenig der Waelder gebuehrt? Was?\nAntworte!\n",  \
    "wenn's Dich nicht DIE kuemmert, wird's auch nie Dein Kaffe. Was?\nAntworte!\n", \
    "Es sorgt fuer weite Spruenge, aber auch fuer verminderte Transparenz. Was?\n" \
          +"Antworte!\n", \
    "DIE setzen sich dem Fluchtstress von sinkenden Schiffen erst gar nicht aus. " \
          +"Wer?\nAntworte!\n", \
    "Fuer Pfand bringt ES hoffentlich Gewinn, doch dem Warten nimmt ES den Sinn. " \
          +"Was?\nAntworte!\n", \
    "Sorgt fuer sekundenlangen Horrer am Heu. Was?\nAntworte!\n", \
    "Er laesst sich in der Abwartezeit trinken. Wer?\nAntworte!\n", \
    "Umgekehrt ist das Gedicht so zu setzen. Wie?\nAntworte!\n", \
    "Stichhaltig sitzt Du bei gehobener Aufbruchsstimmung vergleichsweise drauf.\n" \
          +" Worauf?\nAntworte!\n", \
    "Dabei ringst Du in der Baumschule nach Worten. Wobei?\nAntworte!\n", \
    "Beim Tele-Toast zu erheben-gibt der Aussicht mehr als wahre Groesse. Was?\n" \
          +"Antworte!\n" \
  });

int numb, knows,answered;
string *rid;

create()
{
  ::create();

  rid=riddles;

  SSH("Der Vorraum zum Tod");
  SetProp(P_INT_LONG,"                               Das Atrium Mortis\n"
    +"Von hier kommst Du oestlich wieder in sichere Gefilde. Im Westen "
    +"allerdings koennten schlimme Sachen mit Dir passieren. Dich "
    +"ueberkommt ein mulmiges Gefuehl bei dem Gedanken. Allerdings "
    +"hat dieser ganze Raum etwas Drueckendes. Du fuehlst Dich kleiner "
    +"und irgendwie unbedeutend im Vergleich zu dem, was Dich im Westen "
    +"erwartet. Schwarze Schatten legen sich auf Dein Herz, sobald Du auch "
    +"nur Deinen Blick zum Ursprung diesen erdrueckenden Gefuehles "
    +"wendest. Deine Umgebung kannst Du nur schemenhaft wahrnehmen, alles "
    +"scheint verschleiert von einer hoeheren Macht zu sein.\n");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15+random(5),ENV_TERRAIN:TT_TOWN]));
  
  //  Details
  AddDetail("gefilde",bs("Im Osten ist es sicherer als hier. Von dort hast "
    +"Du diesen Raum hier betreten."));
  AddDetail("raum",bs("Du kannst hier nicht viel erkennen, ausser, dass Dich "
    +"ein mulmiges Gefuehl ueberkommt, kannst Du nichts weiteres feststellen."));
  AddDetail(({"boden","decke","himmel","wand","waende"}),bs("Du kannst hier "
    +"nichts erkennen. Alles hier ist von einer seltsamen Dunkelheit, die "
    +"auch Dein Herz erfuellt, verschleiert."));
  AddDetail("osten","Von dort kommst Du urspruenglich.\n");
  AddDetail("westen",bs("Wenn Du in diese Richtung blickst, befaellt Dich ein "
    +"mulmiges Gefuehl.\n"));
  AddDetail(({"sache","sachen"}),bs("Atrium mortis, was kann das wohl bedeuten."
    +" vielleicht verraet es etwas ueber diese Sachen. Vielleicht solltest "
    +"Du einfach mal versuchen, nach Westen zu gehen."));
  AddDetail(({"atrium","mortis","atrium mortis"}),bs("Ein unheilvoller Name. "
    +"Du koenntest den Namen verstehen, wenn Du ihn uebersetzt."));
  AddDetail(({"name","namen"}),"Der Name dieses Raumes ist Atrium mortis.\n");
  AddDetail("gefuehl",bs("Wenn Du nach Westen blickst, hast Du das Gefuehl, "
    +"als wuerden sich dunkle Schatten auf Dein Herz legen."));
  AddDetail(({"gedanke","gedanken"}),bs("Nicht die schoensten Gedanken. Wirst "
    +"Du je wieder zurueckkehren, wenn Du Dich nach Westen wendest?"));
  AddDetail("drueckendes","Irgendwie fuehlst Du Dich erdrueckt von der ganzen "
    +"Stimmung in diesem Raum.\n");
  AddDetail("stimmung",bs("Die Stimmung hier wirkt erdrueckend. Von Westen "
    +"ruehrt nichts gutes her."));
  AddDetail("vergleich",bs("Langsam wirst Du wirklich neugierig, was sich "
    +"Da nun im Westen verbirgt. Allerdings wirkst Du klein und "
    +"unbedeutend neben dem, was sich im Westen verbirgt."));
  AddDetail("schatten",bs("Dunkle Schatten legen sich auf Dein Herz. Du "
    +"fuerchtest Dich. Du scheinst dem Ursprung des Boesen in dieser "
    +"Gegend naeher denn je."));
  AddDetail("herz",bs("Dein Herz schlaegt nun sehr schnell. Du fuehlst Deine "
    +"Schlagadern wie sie einem Wasserhammer gleich schlagen."));
  AddDetail(({"ader","adern","schlagader","schlagadern"}),
    bs("Du fuehlst, wie Deine Adern pulsieren, rhythmisch, aber nun sehr "
    +"schnell und hart."));
  AddDetail(({"hammer","wasserhammer"}),"Deine Schlagadern koennte nun jeder "
    +"sehen, so stark schlaegt Dein Herz.\n");
  AddDetail("blick",bs("Du kannst Deinen Blick fast nicht mehr vom Westen "
    +"abwenden. Du fuehlst Dich stark dorthin gezogen."));
  AddDetail("ursprung",bs("Im Westen scheint der Ursprung dieser Stimmung zu "
    +"sein. Vielleicht musst Du gerade dorthin."));
  AddDetail("macht",bs("Du weisst, dass sie im Westen sein muss. Sie ist es, "
    +"die Schatten auf alles Lebende hier wirft."));
  AddDetail(({"lebendes","lebende"}),bs("Hier scheint alles von diesen "
    +"unheilvollen Schatten erfuellt zu sein."));
  AddDetail(({"boeses","boese","boesen"}),"Du bist hier dem Ursprung des "
    +"Boesen deutlich naeher.\n");
  AddDetail("umgebung",bs("Du kannst sie nur schemenhaft wahrnehmen."));
  AddDetail("gegend",bs("Diese ganze Gegend ist von einer seltsamen "
    +"drueckenden Dunkelheit erfuellt."));
  AddDetail("dunkelheit","Die Dunkelheit droht Dich einzuverleiben.\n");
 
  AddCmd(({"w","westen"}),"d_west");
  AddCmd(({"antwort","antworte"}),"answ");
 
  AddExit("osten",MORKAS("room_f  "));
  AddExit("westen",MORKAS("room_n01"));
}

init()
{
  ::init();
  numb=random(sizeof(rid));
  printf("numb=%O",numb);
  answered=0;
  knows=0;
}

d_west()
{
  if(!knows && !answered)
  {
  tell_room(environment(TP),"Eine Stimme spricht: Warte, "+TPN+", sag "
	+"mir: "+rid[numb]);
  return 1;
  }
  if(!knows && answered)
  {
    tell_room(environment(TP),"Eine Stimme spricht: Weiter so, und "
	  +"Du wirst hier Deinen Tod finden, "+TPN+"!\n");
    TP->do_damage(random(20));
	answered = 0;
	return 1;
  }
  if(knows && answered)
  {
    tell_room(environment(TP),"Eine Stimme spricht: Du darfst "
	  +"passieren, "+TPN+".\n");
    TP->move(MORKAS("room_n01"),M_GO);
	return 1;
  }
}

answ(string str)
{
  if(!stringp(str) || str==""){
    tell_room(environment(TP),TPN+", Antworte auf die Frage!\n");
	return 1;
  }
  if(str)
  {
    switch(numb)
	{
	  case 0: if(str=="matura" || str=="die matura")
	          {
			    answered=1;
				knows=1;
			  } 
			  else
			  {
			    answered=1;
				knows=0;
			  }
			  break;
      case 1: if(str=="bruch" || str=="ein bruch")
			  {
			    answered=1;
				knows=1;
			  }
			  else
			  {
			    answered=1;
				knows=0;
			  }
			  break;
      case 2: if(str=="kamm" || str=="mit einem kamm")
              {
			    answered=1;
				knows=1;
			  }
			  else
			  {
			    answered=1;
				knows=0;
			  }
			  break;
      case 3: if(str=="rad" || str=="ein rad")
			  {
			    answered=1;
				knows=1;
			  }
			  else
			  {
			    answered=1;
				knows=0;
			  }
			  break;
      case 4: if(str=="zwerg" || str=="zwerge" || str=="die zwerge")
			  {
			    answered=1;
				knows=1;
			  }
			  else
			  {
			    answered=1;
				knows=0;
			  }
			  break;
      case 5: if(str=="faehre" || str=="eine faehre")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break; 
      case 6: if(str=="baumkrone" || str=="die baumkrone" || str=="eine baumkrone")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 7: if(str=="bohne" || str=="die bohne")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 8: if(str=="anlaufen" || str=="angelaufen")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 9: if (str=="landratte" || str=="landratten")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 10: if(str=="versetzen")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 11: if(str=="schreck" || str=="schrecke")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 12: if (str=="tee")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 13: if(str=="invers" || str=="in vers")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 14: if(str=="nadel" || str=="nadeln" || str=="auf nadeln")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 15: if(str=="stammeln")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
      case 16: if(str=="fernglas")
                          {
                             answered=1;
                             knows=1;
                          }
                          else
                          {
                             answered=1;
                             knows=0;
                          }
                          break;
    }
	if(knows!=1)
	{
	  tell_room(environment(TP),"Eine Stimme spricht: "+TPN+", Du hast "
		+"nicht richtig geantwortet, wage nicht zu passieren.\n");
      return 1;
	}
	else
	{
	  tell_room(environment(TP),"Eine Stimme spricht: "+TPN+", Du hast "
		+"gut gewaehlt, Du darfst passieren.\n");
      return 1;
	}
  }
}
