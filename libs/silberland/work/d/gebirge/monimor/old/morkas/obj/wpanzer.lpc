inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

   AddId(({"waechterpanzer","panzer"}));
   SetProp (P_SHORT,"Ein verbeulter Panzer");
   SetProp (P_LONG, "Dieser Panzer ist total verbeult, dennoch "
	 +"scheint er gut Dienste leisten zu koennen. Das ist der "
	 +"typische Panzer, wie die Kerkerwaechter in Morkas ihn "
	 +"verwenden.\n");
   SetProp (P_NAME, "Waechterpanzer");
   SetProp (P_GENDER, MALE);
   SetProp (P_WEIGHT, 1700);
   SetProp (P_VALUE, 1000);

   SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
   SetProp (P_AC, 20);

   SetProp(P_MATERIAL,MAT_IRON);
}
