inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

   SetProp(P_SHORT, "Ein dunkler Helm");
   SetProp(P_NAME, "Dunkelhelm");
   SetProp(P_LONG,
	"Dieser Helm ist nun wirklich sehr leicht, und deshalb auch\n"
	+"angenehm zu tragen. Er ist aus einem Dir unbekannten Erz\n"
	+"gefertigt, was vermuten laesst, dass es arkanen Ursprungs\n"
	+"ist.\n");
   SetProp(P_GENDER, MALE);
   AddId(({"\ndhelm","helm","dunkelhelm"}));
   SetProp(P_ARMOUR_TYPE, AT_HELMET);
   SetProp(P_AC, 5);
   SetProp(P_WEIGHT, 200);
   SetProp(P_VALUE, 200);
   SetProp(P_MATERIAL,MAT_MAGIC);
}
