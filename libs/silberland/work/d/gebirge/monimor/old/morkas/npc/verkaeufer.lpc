
// Monimor@Silberland, Juli 1997

inherit "std/mnpc";

#include <actions.h>
#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT,"Gorwild, der Verkaeufer");
  SetProp(P_LONG, "Gorwild ist ein Verkaeufer, wie es selten einen "
	+"gibt. Nur er allein kann aus dem Geruempel hier etwas finden. "
	+"Er ist ein Zwerg mit einem langen Bart, den er um auf seine "
	+"Schultern gelegt traegt. Sein dicker Bauch versteckt seinen "
	+"Guertel, wenn er ueberhaupt einen traegt.\n");
  SetProp(P_ALIGN,-10);
  SetProp(P_GENDER,MALE);
   SetProp(P_SIZE,130+random(30));
  SetProp(P_NAME,"Verkaeufer");
  AddId(({"verkaeufer","gorwild"}));

  create_default_npc(14);

  AddInfo(DEFAULT_INFO, "Sag was Du willst, ansonsten lass mich "
	+"in Ruhe. Ich will zurueck zu meinem Schlaefchen.","schnarcht: ");
}
