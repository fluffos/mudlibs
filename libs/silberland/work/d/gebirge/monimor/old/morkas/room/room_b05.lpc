
inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SSH("Der Gang durch einen Buerokomplex");
  SetProp(P_INT_LONG,"Hier endet der Gang an einer Tuer. Die "
	+"Tuer liegt in einem festen Rahmen, den zu sprengen "
	+"versuchen sinnlos waere, man wuerde sich nur verletzen. "
	+"Die Decke ist nun wieder etwas hoeher, auch der Boden "
	+"hat sich etwas gesenkt. Weder links noch rechts findest "
	+"Du irgendwelche Zimmer.\n");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:15]));

  AddDetail("gang","Der Gang endet hier an einer Tuer.\n");
  AddDetail("rahmen","Der Rahmen der Tuer ist sehr massiv.\n");
  AddDetail("decke","Die Decke ist hier wieder etwas hoeher.\n");
  AddDetail("boden","Der Boden sinkt nach Suedwesten etwas ab.\n");
  AddDetail("zimmer","Hier sind keine Zimmer, weder links noch "
	+"rechts von Dir.\n");
  AddDetail(({"angel","angeln"}),"Die Angeln halten die Tuer fest "
	+"in ihrem Rahmen. Sie sehen sehr massiv aus.\n");
  AddDetail(({"holz","eichholz"}),"Dieses Holz ist sehr massiv.\n");
  AddDetail(({"versuch","oeffnungsversuch"}),"Wohl nur mit einem "
	+"Schluessel erfolgreich.\n");

  NewDoor("suedwesten",MORKAS("room_f01"),({"tuer","eichholztuer"}),
	  ({  D_NAME,"Eichholztuer",
		  D_GENDER, FEMALE,
		  D_SHORT,"Im Suedwesten ist eine %se Eichholztuer.",
		  D_LONG, "Die Tuer ist fest in ihren Angeln verankert. "
			+"Sie ist aus massivem Eichholz gefertigt und strotzt "
			+"jedem Oeffnungsversuch, es sei denn, man hat einen "
			+"passenden Schluessel.\n" ,
          D_CMDS, "oeffne",
          D_FLAGS, DOOR_NEEDKEY | DOOR_CLOSED | DOOR_RESET_CL
	  }) );

  AddExit("nordosten",MORKAS("room_b04"));
}

