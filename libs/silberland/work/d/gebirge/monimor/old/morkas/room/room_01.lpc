inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();
  SSH("Der Eingang von Morkas");
  SetProp(P_INT_LONG,"Du befindest Dich in der Eingangshalle von "
	+"Morkas. Die Halle misst sechzig mal sechzig Fuss. Sie ist "
	+"mit Steinen aus der Klamm der Seelen gepflastert. Vier Saeulen "
	+"tragen das Dach, waehrend eine fuenfte Saeule in der Mitte "
	+"scheinbar nur zur Zierde dient. Sie laeuft von oben nach "
	+"unten auf eine abgerundete Pyramide zu, deren Grundflaeche "
	+"achtkantig ist und in langen dreikantigen Steinleisten bis "
	+"an die Waende der Halle auslaufen, wo sie mit der Decke "
	+"verschmelzen. Alle zehn Fuss findest Du eine Fackel, die "
	+"die Halle in ein daemmriges Licht huellen, da die Waende "
	+"viel davon absorbieren und nicht wieder zuruecksenden. Der "
	+"Ausgang fuehrt durch ein gruen schimmerndes Portal am "
	+"Westende der Halle.\n");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  AddExit("portal",ROOM("see.lpc"));

  AddDetail( ({ "redensart" }), 
                break_string( "Was wird das wohl sein.", 78 ) );
  AddDetail(({"pyramide","form"}),"Die fuenfte Saeule hat die Form einer "
	+"Pyramide mit achteckiger Grundflaeche. Sie laeuft von der Decke "
	+"auf den Boden zu.\n");
  AddDetail("grundflaeche","Die Grundflaeche der fuenften Saeule "
	+"ist achteckig und ist an der Decke.\n");
  AddDetail(({"halle","eingang","eingangshalle"}),"Du befindest "
	+"Dich in einer grossen Halle. Hier betreten Nidgors "
	+"Schergen Morkas.\n");
  AddDetail(({"scherge","schergen"}),"Die Schergen Nidgors helfen "
	+"ihm in seinem Vorhaben. Es sind ihrer viele.\n");
  AddDetail("vorhaben","Der Weg ist das Ziel.\n");
  AddDetail("morkas","Morkas ist ein Bollwerk des Boesen. Doch "
	+"solange das Boese es nicht zustande bringt, vereint gegen "
	+"das Gute zu kaempfen, besteht noch ein Hoffnung, das Silberland "
	+"von dieser Gefahr zu befreien.\n");
  AddDetail(({"bollwerk","boese"}),"Hier hausen Nidgor und seine "
	+"Schergen. Ein maechtiges Heer hat sich hier zusammengerafft. "
	+"Das Ziel: Der Sieg ueber das Gute.\n");
  AddDetail("sieg","Noch ist es nicht so weit.\n");
  AddDetail(({"sprung","sphaerensprung"}),"Wagst Du den Sprung? Dann "
	+"betrete das Portal.\n");
  AddDetail("gute","Schwarz-weiss-Malerei, die Guten gegen die "
	+"Boesen. Wo gehoerst Du dazu?\n");
  AddDetail(({"herr","nidgor"}),"Nidgor ist der Herr ueber diese Stadt. Hier "
	+"in dieser Halle ist er nicht.\n");
  AddDetail(({"hoffnung","silberland"}),"Es gibt sicher noch Hoffnung "
	+"fuer das Silberland. Du bist ja hier.\n");
  AddDetail("gefahr","Von hier geht eine Gefahr fuer das ganze "
	+"Silberland aus. Nidgor will die Alleinherrschaft.\n");
  AddDetail(({"herrschaft","alleinherrschaft","herrscher"}),"Ein Herrscher ueber "
	+"alle anderen. Das ist wahrlich nicht wuenschenswert.\n");
  AddDetail("stadt","Morkas ist eine Stadt im Stein. Der Eingang "
	+"kann nur mit Magie gefunden werden, genauso wie der Ausgang "
	+"nicht eine direkte Wegstrecke miteinander verbindet, sondern "
	+"durch verschiedene Sphaeren der Magie fuehrt.\n");
  AddDetail(({"sphaere","sphaeren","magie","zutritt"}),"Nur die verschlungenen "
	+"Pfade der Magie verschaffen Zutritt in diese Hallen.\n");
  AddDetail(({"mut","torheit"}),"Mut oder Torheit, gar unterschiedlich "
	+"sind diese beiden nicht.\n");
  AddDetail(({"pfad","pfade"}),"Sie zu beschreiten bedarf den Mut "
	+"des Abenteurers, oder vielmehr dessen Torheit, oder die "
	+"Erfahrung des Magiekundigen.\n");
  AddDetail(({"magier","magiekundiger","magiekundige"}),"Magier "
	+"sind magiekundig und wissen sich ihrer zu betaetigen.\n");
  AddDetail(({"weg","wegstrecke","strecke"}),"Der Weg hierher "
	+"fuehrt ueber die Sphaeren der Magie.\n");
  AddDetail(({"stein","steine"}),"Die Steine sind aus der Klamm "
	+"der Seelen. Sie messen sechs mal sechs Fuss und sehen "
	+"schwer aus. Ihre Farbe ist nicht zu beschreiben.\n");
  AddDetail(({"farbe","farben"}),"Du kannst nur erkennen, dass die "
	+"Steine dunkel sind, besser kannst Du sie nicht beschreiben.\n");
  AddDetail("klamm","In der Klamm der Seelen liegt der Eingang zu "
	+"diesen Hallen.\n");
  AddDetail(({"saeule","saeulen"}),"Vier Saeulen stuetzen die Decke. "
	+"Sie sind fest gebaut und es wuerde vier Maenner benoetigen, "
	+"um sie zu umfassen. Zu ihren Fuessen gehen sie auseinander, um "
	+"sich zur Mitte hin etwas zu verjuengen und sich gleich darauf "
	+"wieder zur Decke zu zu verbreitern. Von der Decke blicken "
	+"Fratzen in alle vier Himmelsrichtungen, um Fremde abzuschrecken. "
	+"Die fuenfte Saeule dient offenbar nur der Zierde und "
	+"erfuellt keine Stuetzfunktion.\n");
  AddDetail("punkt","Der hoechste Punkt der Halle ist in ihrer Mitte "
	+"und misst annaehernd zwanzig Fuss.\n");
  AddDetail(({"decke","dach"}),"Die Decke ist nach oben halbkreisfoermig "
	+"ausgegoehlt, sodass in der Mitte der Halle ihr hoechster "
	+"Punkt mit annaehernd zwanzig Fuss liegt. Dort wo ihre "
	+"stuetzenden Saeulen mit ihr zusammentreffen blicken vier "
	+"Fratzen in die Himmelsrichtungen. Ansonsten ist sie "
	+"schmucklos.\n");
  AddDetail("maenner","Vier gestandene Maenner.\n");
  AddDetail(({"fuss","fuesse"}),"Die Fuesse der stuetzenden Saeulen "
	+"sind breiter als deren Mitte.\n");
  AddDetail("schwachpunkt","Der Schwachpunkt der Saeulen ist deren "
	+"Mitte.\n");
  AddDetail("mitte","Die Mitte der Saeulen ist deren Schwachpunkt. "
	+"Dort sind sie am duennsten, doch immer noch dicker, als so "
	+"mancher Baumriese.\n");
  AddDetail(({"baum","baeume","baumriese"}),"Wahrhaft maechtige Baeume, "
        +"doch hier siehst "
	+"Du keinen einzigen Baum.\n");
  AddSpecialDetail(({"abenteurer","gilde"}),"gilde");
  AddDetail(({"portal","ausgang"}),"Das Portal flackert in einem "
	+"gruenen Licht. Es ist eingerahmt von zwei Schlangen, die "
	+"sich um das Portal raekeln, in entgegengesetzter Richtung.\n");
  AddDetail(({"schlange","schlangen"}),"Die Schlangen raekeln sich "
	+"um das Portal. Sie sind aus dem Stein gehauen. Ihre Augen "
	+"scheinen das gruene Licht zu reflektieren.\n");
  AddDetail(({"auge","augen"}),"Die Augen der Schlangen reflektieren "
	+"das Licht des Portals. Als Du in diese schlitzfoermigen Augen "
	+"blickst erschauderst Du, als ob Dich eine kalte Hand im "
	+"Kragen gepackt haette.\n");
  AddDetail("kragen","Du greifst nach deinem Kragen, kannst aber "
	+"nichts Ungewoehnliches feststellen.\n");
  AddDetail("ungewoehnliches","Soetwas konntest Du nicht feststellen.\n");
  AddDetail("hand","Du drehst Dich um, siehst aber nichts.\n");
  AddDetail("boden","Der Boden ist mit Steinen aus der Klamm "
	+"ausgelegt.\n");
  AddDetail("erfahrung","Weise alte Magier, deren Mut fuer einen "
	+"Sphaerensprung nicht mehr beansprucht wird, ja, die sind "
	+"erfahren.\n");
  AddDetail(({"fackel","fackeln"}),"In dieser Halle haengern derer "
	+"einige. Sie huellen die Halle in ein daemmriges Licht.\n");
  AddDetail(({"fratze","fratzen"}),"Du siehst in die Fratzen von "
	+"orkaehnlichen Steingeschoepfen, die mit furchteinfloessenden "
	+"Blicken von der Decke herabblicken. Ihr weit aufgerissener "
	+"Rachen scheint Dich mit Haut und Haaren verspeisen zu wollen.\n");
  AddDetail("rachen","Du koenntest weit in den Rachen der Fratzen "
	+"hineinblicken, waeren sie lebendig, soweit ist er eroeffnet.\n");
  AddDetail(({"haut","haar","haare"}),"Das ist nur so eine "
	+"Redensart.\n");
  AddDetail(({"blick","blicke"}),"Furchteinfloessende Blicke.\n");
  AddDetail(({"leiste","steinleiste","steinleisten","leisten"}),
	"Die Steinleisten laufen von der Grundflaeche der Pyramide "
	+"zu den Waenden der Halle zu.\n");
  AddDetail(({"funktion","stuetzfunktion"}),"Die fuenfte Saeule hat "
	+"derer keine. Sie ist zu schwach gebaut.\n");
  AddDetail(({"wand","waende"}),"Die Waende der Halle ragen fuenfzehn "
	+"Fuss hoch. Sie sind glatt, makel- sowie schmucklos.\n");
  AddDetail("westende","Hier ist der Ausgang aus den Hallen. Doch "
	+"wohin mag er fuehren.\n");
  AddDetail("zierde","Die Saeule in der Mitte soll bloss gefallen.\n");
  AddDetail(({"geschoepf","geschoepfe","steingeschoepf","steingeschoepfe"}),
	"Diese Geschoepfe wurden in den Stein der Saeulen geschlagen und "
	+"ihre orkaehnlichen Fratzen starren nun von der Decke in "
	+"die vier Himmelsrichtungen.\n");
  AddDetail(({"himmelsrichtung","himmelsrichtungen","richtungen"}),
	"Die kennst Du sicher.\n");
  AddDetail(({"fremder","fremde","besucher"}),"Die Fratzen sollen ungebetene "
	+"Besucher erschrecken. Du gehoerst vermutlich dazu.\n");
  AddDetail("kampf","Nidgor ruestet fuer den letzten Kampf auf.\n");
  AddDetail("heer","Nidgor sammelt sein Heer fuer den letzten Kampf.\n");
  AddDetail("licht","Das Licht des Portals ist gruen, das der "
	+"Fackeln ein daemmriges gelbliches Rot.\n");
  AddDetail("rot","Ein sanft flackerndes, daemmrig schwaches Rot.\n");
  AddDetail("ziel","Das Ziel des Boesen ist das Gute zu vernichten.\n");

  AddItem(MONPC("dunkler"),REFRESH_DESTRUCT);
  AddItem(MONPC("dunkler"),REFRESH_DESTRUCT);

  AddExit("osten",MORKAS("room_02"));
}

gilde()
{
  if(TP->QueryProp(P_GUILD)=="abenteurer")
	return("Du gehoerst sogar zu dieser Gilde.\n");
  else
	return("Ein Abenteurer bist Du wohl, bloss gehoerst Du einer "
	  +"anderen Gilde an.\n");
}
