
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../def.h"

int followme;
object na,ueberbringer;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  ueberbringer=environment(ME);
  followme=10;
  SetProp(P_AUTOLOADOBJ,followme);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  SetProp(P_INVIS, 1);
  SetProp(P_NODROP,1);
  AddId("\nnalfadummy");
}

reset()
{
  ::reset();
  if(followme > 0 && interactive(ueberbringer))
	{
      followme--;
	  SetProp(P_AUTOLOADOBJ,followme);
	}
  if(followme < 1)
	{
	  SetProp(P_AUTOLOADOBJ,0);
	  remove(ME);
	  na->remove();
	}
}

BecomesNetAlive()
{
  na=clone_object(MONPC("nalfa"));
  na->move(environment(ueberbringer),M_GO);
}

BecomesNetDead()
{
  na->remove();
}
