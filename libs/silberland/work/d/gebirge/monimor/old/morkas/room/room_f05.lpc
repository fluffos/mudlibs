
inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SSH("Die Empfangshalle");
  SetProp(P_INT_LONG,"Du befindest Dich nun in der grossen "
	+"Empfangshalle von Morkas. Dies ist der westliche Teil. "
	+"Hier ist es etwas ruhiger und weniger geschaeftig. Du "
	+"kannst Von hier aus in Ruhe alle beobachten, ohne aufzufallen. "
	+"Du siehst Botschafter aller Rassen und Laender. Sie "
	+"unterhalten sich in der gemeinsamen Sprache, doch klingt "
	+"sie Dir fremd, so - gehaessig und boesartig.\n");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);

  AddExit("nordosten",MORKAS("room_f02"));
  AddExit("suedosten",MORKAS("room_f06"));
  AddExit("osten",MORKAS("room_f04"));
}
