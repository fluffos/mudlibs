inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "../def.h"

int al,dr,put;

create()
{
  ::create();

  SSH("Eine Toilette");
  SetProp(P_INT_LONG,"Auf dieser Toilette sieht es uebel aus. Hier "
	+"duerfte schon lange nicht mehr geputzt worden sein. Vielleicht "
	+"kann man mal nach einer Putzfrau rufen, die hier diesen "
	+"Dreck aufraeumt. Es stinkt auch ziemlich. Dass Maenner immer "
	+"die Klodeckel nach oben klappen muessen.\n");
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:15]));
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  
  AddDetail("decke","Die niedrige Decke ist das einzige, was sauber "
	+"ist hier.\n");
  AddDetail("dreck","Eine Putzfrau wuerde ihn vielleicht wegraeumen.\n");
  AddDetail(({"ecke","ecken"}),"Die Ecken sind sehr unhygienisch.\n");
  AddDetail(({"fels","felsgestein","gestein"}),"Der Fels ist wie "
	+"ueberall hier total glatt.\n");
  AddDetail("fliesen","Fliesen gibt es hier keine. Sie waeren auch "
	+"total ueberfluessig.\n");
  AddDetail(({"deckel","klodeckel"}),"Die Klodeckel sind nach oben "
	+"geklappt, weil Maenner zu faul sind, sie wieder runter zu "
	+"klappen.\n");
  AddDetail("leute","Leute wie Du und ich, bloss weniger sitthaft.\n");
  AddDetail(({"putze","putzfrau","frau"}),"Die koennte hier sauber "
	+"machen. Wie koennte man sie hierherbringen?\n");
  AddDetail("verschwendung","Wahrlich verschwenderisch ist es, derart "
	+"grossartige Buecher so zu missbrauchen.\n");
  AddDetail(({"weiser","weisen"}),"Ein weiser Mann, der weise Buecher "
	+"schrieb.\n");
  AddDetail("wesen","Wesen waere doch fast untertrieben. Bloss sehr "
	+"dumme Maenner vermutlich.\n");
  AddDetail(({"mann","maenner"}),"Maenner sind doch alle gleich.\n");
  AddDetail(({"klo","toilette"}),bs("Unbeschreiblich dieser Saustall, hier sollte mal jemand putzen."));
  AddDetail("saustall",bs("Hier haben Leute in Ecken erbrochen und die Toilette mit Klopapier verstopft."));
  AddDetail(({"klopapier","papier"}),"Oh, hier scheinen sehr "
	+"intelligente Wesen zu defaezieren, denn Du findest als "
	+"Klopapier Buecher von Monimor und einem gewissen Weisen. Ob "
	+"diese Buecher je gelesen wurden?");
  AddDetail(({"buch","buecher"}),bs("Das waren vermutlich doch nur "
	+"unterdurchschnittlich intelligente Wesen, die sich mit diesen "
	+"fabelhaften Buechern bloss gereinigt haben, was fuer eine "
	+"Verschwendung. Jetzt verstopfen die Buecher das Klo."));
  AddDetail(({"wand","waende","boden"}),"Blanker Fels, keine Fliesen.\n");
  AddCmd(({"pisse","piss","pinkle"}),"piss");
  AddCmd(({"erbreche","erbrich"}),"erbrich");
  AddCmd(({"ruf","rufe"}),"ruf");
  AddExit("suedwesten",MORKAS("room_11"));
}
erbrich()
{
  int ran,pin;
  if (al)
    write("Du findest keine Ecke mehr, in die Du erbrechen kannst.\n");
  else
  {
    if (TP->QueryProp(P_ALCOHOL)!=0)
    {
        ran=TP->QueryProp(P_ALCOHOL)-random(TP->QueryProp(P_ALCOHOL));
        TP->SetProp(P_ALCOHOL,ran);
        write ("Du erbrichst beinahe Deine Eingeweide, so schlecht ist Dir.\n");
        say (TPN+" erbricht in eine Ecke.\n");
		if(present("putze"))
		{
		  write("Die Putze zieht Dir eins ueber, weil Du ihr Klo "
			+"schmutzig machst.\n");
          say("Die Putze zieht "+TP->name(WEM,1)+" eine ueber.\n");
          TP->do_damage(random(10),present("putze"));
		}
    return (al = 1);
    }
    else
        write("Du bist doch nicht betrunken!\n");
  }
  return 1;
}
piss()
{
  int pin;
  if (dr)
    write("Das Klo ist verstopft, Du musst Dich noch zusammenreissen.\n");
  else
  {
    if (TP->QueryProp(P_DRINK)!=0)
    {
        pin=TP->QueryProp(P_DRINK)-random(TP->QueryProp(P_DRINK));
        TP->SetProp(P_DRINK,pin);
        write ("Du pinkelst in die Klomuschel, bis sie uebergeht.\n");
        say (TPN+" pinkelt das Klo voll.\n");
		if(present("putze"))
		{
		  write("Die Putze zieht Dir eins ueber, weil Du ihr Klo "
			+"schmutzig machst.\n");
          say("Die Putze zieht "+TP->name(WEM,1)+" eine ueber.\n");
		  TP->do_damage(random(10),present("putze"));
        }
    return (dr = 1);
    }
    else
        write("Du hast doch gar keinen Harndrang!\n");
  }
  return 1;
}

kotze()
{
  if (al)
    return ("Hier hat nichts mehr platz.\n");
  else
    return (bs("Das ist nun wirklich ein ekelhafter Anblick."));
}
reset()
{
  object putze;
  putze=present("putze",ME);
  al = 0;
  dr = 0;
  put = 0;
  ::reset();
  if(putze)
  {
    tell_room(ME,"Die Putze verkruemelt sich kruemellos.\n");
	putze->remove();
	putze=0;
  }
}

ruf(str)
{
notify_fail("Wonach willst Du rufen?\n");
if(!str) return 0;
    if(member(({"putze","putzfrau","nach putze","nach putzfrau"}),str)>-1)
    {
	  if(!present("putze",ME) && !put)
	  {
	    al=random(1);
	    dr=random(1);
		write("Du rufst Nach einer Putze und es kommt sogar eine.\n");
		say(TPN+" ruft nach einer Putze und es kommt sogar eine.\n");
		clone_object(MONPC("putze"))->move(ME,M_GO | M_SILENT);
	    put=1;
      }
  else
  {
    if(put)
	  return("Hier wurde bereits geputz.\n");
    if(present("putze",ME))
	  return("Die Putze ist doch nicht taub!\n");
  }
  return 1;
  }
} 
