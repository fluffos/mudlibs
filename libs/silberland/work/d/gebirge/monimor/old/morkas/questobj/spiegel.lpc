
inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

create()
{ 
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_NAME,"Spiegel");
  SetProp(P_SHORT,"Ein grosser Spiegel");
  SetProp(P_LONG,"Dieser Spiegel ist einen Schritt hoch und etwas "
	+"mehr als halb so breit. Er hat nur einen schlichten Rahmen, "
	+"ist aber trotzdem relativ schwer. Du kannst Dein Gesicht in "
	+"dem Spiegel sehen.\n");
  SetProp(P_INFO,"Man kann auch anderen den Spiegel vorhalten, wenn "
	+"sie sich darin betrachten wollen.\n");
  SetProp(P_VALUE,500);
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT,5000);
  AddId(({"spiegel","\nnidgorspiegel"}));

  AddCmd(({"halte","halt"}),"show");
}


show(string str)
{
  string empf;
  object us;
  
  if(!stringp(str) || str=="")
    return(notify_fail("WAS willst Du WEM vorhalten?\n"),0);
  if(sscanf(str,"spiegel %s vor",empf)>0)
  {
    if(empf!="nidgor")
    {
      if(!present(empf,environment(TP)))
        return(notify_fail(CAP(empf)+" ist nicht hier.\n"),0);
      else
      {
        write("Du haeltst "+CAP(empf)+" den Spiegel vor.\n");
        if(find_living(empf) && present(empf,environment(TP)))
        {
          us=find_living(empf);
          tell_room(environment(TP),TPN+" haelt "+CAP(empf)+" einen Spiegel "
            +"vors Gesicht.\n",({TP,us}));
          tell_object(us,TPN+" haelt Dir einen Spiegel vors Gesicht. Du "
            +"bist von Dir entzueckt.\n");
        }
        else
          say(TPN+" haelt "+CAP(empf)+" einen Spiegel vor.\n");
        return 1;
      }
    }
    else
    {
      write(bs("Als Du Nidgor den Spiegel zeigst, verzieht sich sein Gesicht "
          +"schmerzerfuellt. Ploetzlich siehst Du einen gleissenden "
          +"Lichtstrahl, der Dich zu blenden droht. Nachdem sich Deine "
          +"Augen wieder erholt haben, siehst Du, dass der Weise Mann vor Dir "
          +"steht und Dich anlaechelt. Er sagt Dir, dass nun alles gut sei "
          +"und dass Du Dich sputen musst, um seinem Freund Relm zu helfen."));
        say(TPN+bs(" zeigt Nidgor einen Spiegel, doch als dieser sich darin "
          +"sieht, wird sein Gesicht von Schmerz verzerrt und ein gleissendes "
          +"Licht erfuellt den Raum. Als sich Deine Augen wieder erholt haben, "
          +"siehst Du den weisen Mann aus der Klamm mit "+TPN+" sprechen."));
        present("nidgor",environment(TP))->remove();
        if (!find_living("weiser")){
          clone_object(MONPC("weiser"))->move(environment(TP),M_SILENT |
            M_NOCHECK);
        }
        else { 
          find_living("weiser")->move(environment(TP),M_SILENT | M_NOCHECK);
        }
        return 1;
    }
  }
  else
    return(notify_fail("So geht das nicht.\n"),0);
}
