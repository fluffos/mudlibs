// Wecker
// ---
// 24.8.98: Woody: invis Magier gehn nun gar nimmer zu wecken

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"

int weck_func(object player, object adress);
int abgestellt;
int check_idle(object idleone);

create()
{ 
  if (!is_clone(TO) )  return;
  ::create();

  abgestellt=0;

  AddId("wecker");
  SetProp(P_SHORT,"Ein Wecker");
  SetProp(P_LONG,"Dieser Wecker ermoeglicht Dir, andere Spieler "
	+"zu wecken. Ausserdem kannst Du Dich auch zu einem bestimmten "
	+"Zeitpunkt wecken lassen.\n");
  SetProp(P_WEIGHT,125);
  SetProp(P_NAME,"Wecker");
  SetProp(P_VALUE,250);
  SetProp(P_GENDER,MALE);
  SetProp(P_AUTOLOADOBJ,1);
  SetProp(P_INFO,"Nach genauerem Ueberlegen kommst Du darauf:\n"
	+"Syntax: wecke <spieler> oder stelle wecker auf <std min>.\n"
	+"Das klingt dann etwa so: \a\a\a\a\a\a\a\a\a\a\n"
	+"    Etwas laenger vielleicht.\n"
	+"Du solltest Dich auf alle Faelle davor hueten, jemanden mit "
	+"dem Wecker zu belaestigen: Er wird bei Beschwerde entzogen. "
	+"Abgesehen davon, lohnt es sich, zuerst ping zu versuchen, "
	+"nur hartnaeckiges ideln sollte mit wecke beendet werden, "
	+"sprich unter drei Minuten Idle-Zeit geht gar nichts. "
	+"Ausserdem: einen Tauben zu wecken hat nicht viel Sinn, "
	+"klingt einleuchtend. Weiters muss sich der Wecker nach "
	+"einem Weckversuch erst einmal aufziehen, das erfordert "
	+"eine gewisse Zeit, in der man den Wecker nicht einsetzen kann.\n"
	+"Wer diesen Wecker als Belaestigung empfindet, kann sich ausserdem "
	+"durch ignoriere spielername.wecker davor schuetzen.\n");
  SetProp(P_MATERIAL,MAT_IRON);

  AddCmd("ping","ping");
  AddCmd(({"schlaf","schlafe"}),"sleep");
  AddCmd(({"stornier","storniere"}),"storno");
  AddCmd(({"wecke","weck"}),"weck");
  AddCmd(({"stell","stelle"}),"stell");
}

ping(str)
{
  string *does_ignore;
  object pl;
  
  if(!str)
	return(notify_fail("WEN willst Du anpingen?\n"),0);

  if (find_call_out("delay")!=-1)
    return(notify_fail("Du kannst den Wecker momentan nicht "
          +"benutzen. Er zieht sich gerade selber auf.\n"),0);

  pl=find_player(str);
  if(pl && !pl->QueryProp(P_INVIS))
  {
    call_out("delay",10+random(10));
    does_ignore=pl->QueryProp(P_IGNORE);
/*
    if(pl->QueryProp(P_INVIS))
    {
          if(!check_idle(find_living(str)))
            return(notify_fail("Wer nicht da ist, ist ziemlich lange "
                  +"idle, denkst Du nicht auch?\n"),0);
          if (does_ignore &&
            member(does_ignore, lower_case(getuid(TP))+".wecker") != -1)
                  return(notify_fail(CAP(str)+" ist gerade nicht da.\n"),0);
      write(CAP(str)+" ist gerade nicht da.\n");
      tell_object(find_living(str),TPN+" versucht Dich anzupingen. "
            +"Du brauchst nicht zu antworten, denn er weiss nicht, "
            +"ob Du auch wirklich da bist.\a\n");
      return 1;
    }
    else
*/
    {
          if (does_ignore &&
            member(does_ignore, lower_case(getuid(TP))+".wecker") != -1)
            {
              write(pl->Name(WER)+" ignoriert Deinen Wecker.\n");
              return 1;
            }
          else
          {
            write("Du pingst "+CAP(str)+" an.\n");
            pl->Message( TPN+" pingt Dich an.\a\n",
            MSGFLAG_TELL);
            return 1;
          }
    }
  }
  else
    return(notify_fail(CAP(str)+" ist gerade nicht da.\n"),0);
}

weck(str)
{
  string *does_ignore;
  object pl;

  if(!str)
	return(notify_fail("WEN willst Du wecken?\n"),0);
  if(str)
  {
  if (find_call_out("delay")!=-1)
    return(notify_fail("Du kannst den Wecker momentan nicht "
	  +"benutzen. Er zieht sich gerade selber auf.\n"),0);

  pl=find_player(str);
  if(pl && !pl->QueryProp(P_INVIS))
	{
	  call_out("delay",30+random(10));
	  does_ignore=pl->QueryProp(P_IGNORE);
/*
	  if(pl->QueryProp(P_INVIS))
	  {
		if (!check_idle(find_living(str)))
		  return(notify_fail("Jemand, der nicht da ist, kann auch "
			+"nicht idle sein, bzw ist diese Art von Idlen nicht "
			+"gemeint.\n"),0);
        if (does_ignore &&
		  member(does_ignore, lower_case(getuid(TP))+".wecker") != -1)
		    return(notify_fail(CAP(str)+" ist gerade nicht da.\n"),0);
	    
		write(CAP(str)+" ist gerade nicht da.\n");
		tell_object(find_living(str),TPN+" versucht Dich zu wecken. "
		  +"Du brauchst nicht zu antworten, denn er weiss nicht, "
		  +"ob Du auch wirklich da bist.\n");
        weck_func(TP,find_living(str));
		return 1;
	  }
	  else
*/
	  {
            if (!check_idle(pl))
              return(notify_fail(pl->Name(WER,1)+" ist noch nicht "
                    +"einmal drei Minuten idle, versuch doch, "+
                    pl->name(WEN,1)+" erst einmal sanfter zu "
                    +"wecken.\n"),0);
            if (does_ignore &&
              member(does_ignore, lower_case(getuid(TP))+".wecker") != -1)
            {
            write(pl->Name(WER)+" ignoriert Deinen Wecker.\n");
                  return 1;
            }
            else
            {
	      write("Du versuchst "+CAP(str)+" zu wecken.\n");
		  pl->Message( TPN+" versucht, Dich zu "
		    +"wecken.\n",MSGFLAG_TELL);
              weck_func(TP,pl);
              return 1;
            }
          }
        }
	else
	  return(notify_fail(CAP(str)+" ist gerade nicht da.\n"),0);
  }
}

weck_func(object player, object address)
{
  int i;

  for(i=1;i<6;i++)
  {
    address->Message("\a",MSGFLAG_TELL);
    if(i<=3)
	  address->Message("Ein Wecker klingelt.\n",MSGFLAG_TELL);
  }
}

stell(str)
{
  int hh,mm,ss,now, then, min, hour;
  if(!stringp(str) || str=="")
	return(notify_fail("Auf welche Zeit willst Du den Wecker stellen?\n"),0);
  if(sscanf(str, "wecker auf %d %d", hour, min )>0 ) 
  {
    if(find_call_out("awake")!=-1)
	{
	  write("Du hast bereits einen Weckvorgang am laufen, storniere "
		+"Diesen zuerst.\n");
      return "";
	}
	else
	{
	  write("Ok, Wecker gestellt auf "+hour+"."+min+".\n");
	  sscanf(dtime(time())[<8..],"%d:%d:%d",hh,mm,ss);
	  now=ss+60*(mm+60*hh);
	  then=hour*3600+min*60;
	  if(now<then)
	    call_out("awake",then-now+ss);
      if(then<now)
		call_out("awake",86400-now+then+ss);
	  return 1;
	}
  }
  else
	return(notify_fail("Syntax: stelle wecker auf <std> <min>\n"),0);
}

awake()
{
  if(interactive(environment(ME)))
  {
    write("Dein Wecker laeutet, es ist "+ctime()+".\n");
	tell_room(environment(environment(ME)),TP->name(WESSEN,1)+" Wecker "
	  +"laeutet.\n",({TP}));
    weck_func(TP,TP);
    return 1;
  }
  else
  {
    if(environment(ME)->QueryProp(P_EXITS))
	{
	  tell_room(environment(ME),"Ein herrenloser Wecker laeutet und "
		+"loest sich traurig auf.\n");
      remove();
	}
	else
	{
	  printf("Ein Wecker laeutet.\n");
	  weck_func(TP,TP);
	}
  }
}

sleep(str)
{
  if(str=="ein")
  {
  if(find_call_out("awake")!=-1)
  {
	abgestellt=1;
	remove_call_out("awake");
	tell_object(environment(ME),"WECKER ABGESTELLT!!!\n");
  }
  }
}

void BecomesNetAlive()  //  scheint bei magiern nicht so zu funzen?
{
  if(abgestellt)
  {
	tell_object(environment(ME),
	  "Dein Wecker wurde abgestellt, weil ein Auftrag im Laufen "
	  +"war, Du aber eingeschlafen bist.\n");
    abgestellt=0;
  }
}

storno(str)
{
  if(!stringp(str) || str=="")
	return(notify_fail("WAS willst Du stornieren.\n"),0);
  if(member(({"wecker","weckauftrag","auftrag"}),str)>-1)
  {
	if(find_call_out("awake")==-1)
	  return(notify_fail("Du hast keinen Auftrag laufen.\n"),0);
    write("Auftrag storniert\n");
	remove_call_out("awake");
	return 1;
  }
  else
	return(notify_fail("Syntax: storniere auftrag.\n"),0);
}

delay()
{
  tell_object(TP,"Der Wecker ist nun frisch aufgeladen, Du kannst "
	+"ihn wieder verwenden.\n");
}

check_idle(object idleone)
{
  if(query_idle(idleone)<180)
	return 0;
  else
    return 1;
}
