inherit "std/thing";

#include "/secure/wizlevels.h"
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_LONG,"");
  SetProp(P_SHORT,0);
  SetProp(P_NOGET,1);
  SetProp(P_INVIS,0); // nur zur Sicherheit, ich weiss ...
  AddId("\nmaypost");
}

