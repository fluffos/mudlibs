#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Weg um den See" );
  SetProp( P_INT_LONG, BS(
    "Der Weg fuehrt weiter an der Felswand und am See entlang. Noch immer "
    +"ist nichts von einer Vegetation zu sehen.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18]) );

  STAND1
  STAND2
  
  AddCmd(({"schwimm","schwimme"}),"schwimm");
  
  AddDetail("vegetation",bs("Hier lebt nichts, hier wirst Du also keine "
    +"Vegetation finden."));
    
//  AddSound( DEFAULT_SOUND,
//    "");
    
//  AddSmell( DEFAULT_SMELL,
//    "");

//  AddRoomMessage( 
//    ({""}),30,"func");

  
  AddExit("osten",SEE("see_04"));
  AddExit("nordwesten",SEE("see_06"));

}

SWIM
