
//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, Mai 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Weg um den See" );
  SetProp( P_INT_LONG, "Der Weg folgt weiter seinem Verlauf um den "
	+"See. Er ragt hier etwas in den See hinein. Von hier kann man "
	+"sogar das andere Ufer des Sees sehen. Davon, dass hier der "
	+"Ruesselwurm haust, kann man hier nichts erkennen. Es ist "
	+"friedlich und ruhig, nur die Wellen hoert man sanft ans "
	+"Ufer schlagen.\n");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15+random(5)]) );

  STAND1
  STAND2

  AddDetail("verlauf","Der Weg folgt in seinem Verlauf einer "
	+"Beuge des Sees, der hier am engsten ist.\n"); 
  AddDetail("beuge","Beuge ist wohl nicht das richtige Wort. Der "
	+"See wird hier bloss enger.\n");

  AddCmd(({"schwimm","schwimme"}),"schwimm");

  AddExit("nordosten",SEE("see_07"));
  AddExit("westen",SEE("see_09"));
}

SWIM

