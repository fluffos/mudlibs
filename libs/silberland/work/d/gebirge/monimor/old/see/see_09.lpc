
//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, Mai 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Weg um den See" );
  SetProp( P_INT_LONG, "Verblueffend.\nAls Du diesen Teile des "
	+"Weges betrittst, bist Du von lauter Spiegeln umgeben. "
	+"Tatsaechlich sind die Waende des Kessels hier so glatt, "
	+"dass Du Dich in ihnen wieder siehst. Eine kleine "
	+"Vertiefung in der Wand des Kessels erzeugt eine kleine "
	+"Nische, die mehrere Seitenwaende bietet, in denen Du "
	+"Dein Spiegelbild betrachten kannst.\n");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15+random(5)]) );

  STAND1
  STAND2

  AddDetail(({"wand","waende","seitenwand","seitenwaende"}),
	"Die Waende des Kessles kleiden hier eine Nische aus, die "
	+"Dein Spiegelbild vielfach zurueckwerfen. Der Stein der Klamm "
	+"ist hier so glatt, dass man sich darin spiegelt.\n");
  AddDetail(({"stein","gestein"}),"Das Gestein der Klamm ist hier "
	+"besonders glatt. Das ist der richtige Ort fuer Narzisten.\n");
  AddDetail(({"narzist","narzisten"}),"Narzisten finden sich selbst "
	+"sehr schoen und verbringen immens viel Zeit damit, sich selbst "
	+"zu betrachten. Einen sinnvollen Kampf kann man hier nicht mit "
	+"ihnen fuehren, da sie wohl zusehr damit beschaeftigt waeren, "
	+"sich selbst zu betrachten.\n");
  AddDetail(({"vertiefung","nische"}),"Die Waende des Kessels "
	+"bilden hier eine kleine Nische.\n");
  AddDetail(({"bild","spiegelbild"}),"Bist Du ein Narzist?\n");

  AddCmd(({"schwimm","schwimme"}),"schwimm");

  AddExit("nordwesten",SEE("see_10"));
  AddExit("osten",SEE("see_08"));

  AddItem(OBJ("spiegeldummy"),REFRESH_REMOVE);
}

SWIM

