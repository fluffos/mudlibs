//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, Mai 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Weg um den See" );
  SetProp( P_INT_LONG, BS(
    "Der Weg macht hier gezwungenermassen einen Knick von Nordwesten nach "
    +"Sueden. Die Wand und der See lassen nur wenig Platz, um im Trockenen "
    +"zu bleiben.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18]) );

  STAND1
  STAND2
  
  AddDetail("knick",bs("Der Weg macht hier einen Knick. Die Felswaende des "
    +"Kessels zwingen den See und auch den Weg von Nordwesten nach Sueden."));
  AddDetail(({"platz","trockene","trockenen","trockenes"}),bs("Hier kommen "
    +"See und Felswand sich ziemlich nahe, sodass nur ein wenig Platz ist, "
    +"wo Du nicht nass wirst."));
  
  AddCmd(({"schwimm","schwimme"}),"schwimm");
  

//  AddSound( DEFAULT_SOUND,
//    "");
    
//  AddSmell( DEFAULT_SMELL,
//    "");

//  AddRoomMessage( 
//    ({""}),30,"func");

  
  AddExit("sueden",SEE("see_02"));
  AddExit("nordwesten",SEE("see_04"));
}

SWIM
