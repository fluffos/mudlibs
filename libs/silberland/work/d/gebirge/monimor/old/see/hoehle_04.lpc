
#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

int active;

create()
{
  ::create();


  SetProp(P_INT_LONG,"Du bist im Schlafzimmer der Hoehle "
   +"angelangt. Hier steht ein Bett und ein Nachtkaestchen. "
   +"Das Zimmer ist von vier Fackeln erhellt.\n");
  SetProp(P_INT_SHORT,"In einem Schlafzimmer einer Hoehle");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18]) );

  AddDetail(({"zimmer","schlafzimmer"}),"Dieses Zimmer "
	+"ist mit einem Bett und einem Nachtkaestchen eingerichtet. "
	+"Es ist von vier Fackeln erhellt.\n");
  AddDetail(({"hoehle","teil"}),"Dieses Zimmer ist nur ein "
	+"Teil einer groesseren Hoehle.\n");
  AddDetail(({"kaestchen","nachtkaestchen"}),"Neben dem Bett "
	+"steht ein Nachtkaestchen. Es steht nichts darauf.\n");
  AddSpecialDetail("bett","bett");

  AddExit("westen",SEE("hoehle_02"));
  AddItem(MONPC("nalfa"),REFRESH_REMOVE);
}

bett()
{
  if(!active)
	return "Auf dem Bett liegt Nalfa, eine wunderschoene Zwergin.\n";
  else
	return "Das Bett ist nicht gemacht. Es sieht unordentlich aus.\n";
}

d_var(int i)
{
  active=i;
}
