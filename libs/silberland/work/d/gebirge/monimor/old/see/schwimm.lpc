#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

string env;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Schwimmend im See" );
  SetProp( P_INT_LONG, BS(
    "Du schwimmst im See der Klamm der Seelen. In einiger Entfernung "
    +"siehst Du das Ufer. Die Wellen sind nicht sehr hoch, sodass Dir das "
    +"Wasser nicht zu sehr ins Gesicht schlaegt."));
    
  SWIM_DETAILS
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15]) );
  
  AddRoomMessage(({"Es blubbert.\n","Wasser tropft Dir ins Gesicht.\n",
    "Eine Welle taucht Dich kurz unter.\n"}),
    30,"raeume");
  AddCmd( ({ "schwimme","schwimm" }), "schwimm" );
  AddCmd( ({ "tauch","tauche" }), "tauch" );

}

schwimm(string str )
{
  object o;
  notify_fail( "Wohin willst Du schwimmen?\n" );
  if( member(({"zum land","zurueck","zum ufer","land","ufer","weg","an land",
    "raus","nach land","nach ufer","ans ufer"}),str)>-1 )
  {
    if(present("\nswim_dummy",TP))
    {
      write("Du schwimmst zurueck.\n");
      say( TPN+" kommt aus dem See zurueckgeschwommen.\n");
      o=present("\nswim_dummy",TP);
      env=(o->QueryFrom());
      o->remove();
      TP->move(env,M_GO);
      return 1;
    }
    else
    {
      write(bs("Hier kannst Du nur weggetranst werden, bist Du kein Magier, "
          "dann wende Dich an einen, der Dir hilft. Trotzdem geht hier etwas "
          "nicht mit richtigen Dingen zu."));
          this_player()->move(TP->QueryProp(P_LAST_COMMAND_ENV), 
M_GO|M_SILENT|M_NO_SHOW);
      return 1;
    }
  }
}

DIVE

raeume()
{
  object ob,next;
  for(ob=first_inventory(this_object());ob;)
    {
      next=next_inventory(ob);
      if(!living(ob))
        {
          tell_room(this_object(),ob->QueryProp(P_SHORT)+" versinkt gerade.\n");
          ob->move(SEE("tauch"),M_NOCHECK);
        }
      ob=next;        
    }
}
