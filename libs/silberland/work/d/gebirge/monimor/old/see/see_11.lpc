
//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, August 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT,"Der Weg um den See");
  SetProp(P_INT_LONG,"Der Weg macht hier einen Knick von "
	+"Suedwesten nach Osten. Im Osten hoerst Du das leise "
	+"Plaetschern eines Baches. Dorthin wird er auch etwas "
	+"breiter, da die Felswand sich vom See etwas entfernt. "
	+"Der Weg duerfte erst vor kurzem angelegt worden sein, "
	+"da er nicht viel benutzt aussieht. Nur langsam konnte "
	+"Platz dem See abgerungen werden und davon ist hier nicht "
	+"viel.\n");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15+random(7)]) );

  STAND1
  STAND2

  AddDetail(({"plaetschern","bach"}),"Du kannst im Osten einen "
	+"Bach hoeren. Er duerfte nicht weit weg sein.\n");
  AddDetail("knick","Der Weg kommt von Suedwesten und biegt nach "
	+"Osten.\n");
  AddDetail("platz","Nur sehr muehsam kann hier dem See Platz "
	+"Abgerungen werden. Viele Schritte muessen noch gegangen "
	+"werden, dass sich hier ein stattlicher Weg findet.\n");
  AddDetail(({"schritt","schritte"}),"Mit Deinen Schritten beteiligst "
	+"Du Dich daran, hier einen ansehlichen Weg zu schaffen.\n");
  
  AddSound(({"bach","plaetschern"}),"Aus dem Osten dringt das "
	+"Plaetschern eines Baches zu Dir.\n");

  AddExit("osten",SEE("see_10"));
  AddExit("suedwesten",SEE("see_12"));
}
