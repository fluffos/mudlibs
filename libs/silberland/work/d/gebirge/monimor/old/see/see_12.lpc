
//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, August 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <combat.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT,"Der Weg um den See");
  SetProp(P_INT_LONG,"Der Weg fuehrt schnurgerade von "
	+"Suedwesten nach Nordosten. Hier ist es sehr eng. Der See "
	+"laesst nur wenig Platz zum Gehen. Manchmal tropft dir etwas "
	+"Wasser auf dein Schuhwerk. Dennoch ist auch fuer einen "
	+"fetten Ork genug Platz, um hier entlang zu wandeln.\n");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15+random(7)]) );

  STAND1
  STAND2

  AddDetail("platz","Es ist so eng hier, dass Dir Wasser auf Dein "
	+"Schuhwerk tropft, wenn Wellen ans Ufer schlagen.\n");
  AddDetail("ork","Du kannst Dich gluecklich schaetzen, dass "
	+"keiner hier ist.\n");
  AddSpecialDetail("schuhwerk","boots"); // ->epidee!!!!! denk dran moni

  AddExit("suedwesten",SEE("see_13"));
  AddExit("nordosten",SEE("see_11"));
}

boots()
{
  object *boot;
  boot=filter_objects(TP->QueryProp(P_ARMOURS),"id",AT_BOOT);
  if(sizeof(boot) && objectp(boot[0]))
  {
    return ("Dir traegst "+boot[0]->name(WEN,1)+".\n");
  }
  else
  {
    return ("Du bist barfuss unterwegs.\n");
  }
}
