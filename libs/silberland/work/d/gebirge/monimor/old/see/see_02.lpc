//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, Mai 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Weg um den See" );
  SetProp( P_INT_LONG, BS(
    "Du bist auf einem Weg um den See in der Klamm der Seelen. Er ist sehr "
    +"schmal. Er laeuft zwischem dem Ufer des Sees und den Waenden des "
    +"Kessels von Felswaenden, die Dich umgeben. Ein Schild steht an eine "
    +"Wand gelehnt.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18]) );

  STAND1
  STAND2
  
  AddCmd(({"schwimm","schwimme"}),"schwimm");
  
  AddDetail( ({ "zug", "zuge", "anfall", 
                "schwaecheanfall" }), 
                break_string( "Tja, ein Schwaecheanfall wuerde Deinen Tod "+
                "bedeuten. Du wuerdest ertrinken.", 78 ) );
  AddDetail( ({ "schild" }),
  "Du kannst es lesen.");

//  AddSound( DEFAULT_SOUND,
//    "");
    
//  AddSmell( DEFAULT_SMELL,
//    "");

//  AddRoomMessage( 
//    ({""}),30,"func");

  AddReadDetail("schild",bs("An einem See kann man schwimmen. Man sollte nur "
      +"darauf achten, dass man nicht zu schwer traegt, da man sonst "
      +"im Zuge eines Schwaecheanfalls ertrinken koennte."));
  
  AddExit("suedwesten",ROOM("see1"));
  AddExit("norden",SEE("see_03"));
}

SWIM
