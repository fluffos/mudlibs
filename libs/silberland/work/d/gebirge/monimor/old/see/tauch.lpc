//   Tauch_default_room
//   Aus schwimm.c taucht man hier her.
//   Ausserdem: Wenn man hier nimmt, was rumliegt, hat man den 
//   Ruesselwurm, sollte er noch leben, am hals.
//
//   Monimor, Mai 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

object ob;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Unter Wasser" );
  SetProp( P_INT_LONG, BS(
    "Du tauchst unter Wasser im See der Klamm der Seelen. Hoffentlich hast "
    +"Du genug Luft geholt, denn Dich umgibt nur Wasser, kaltes Wasser.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: random(8)+5]) );

  AddDetail( ({ "wasser" }),
    "Das Wasser ist sehr kalt. Es ist total klar.\n");
  AddDetail("see","Du tauchst im See. Weit kannst Du nicht sehen.\n");
  AddDetail("klamm","Du tauchst im See der Klamm. Die Klamm selbst "
	+"siehst Du hier nicht.\n");

  ob=CLONEOB("/obj/money");
  ob->SetProp(P_AMOUNT, 1000+random(500));
  ob->move(ME);

  AddCmd(({"nimm","nehme"}),"take");
  AddCmd(({"tauch","tauche"}),"tauch");
}

tauch(string str)
{
  notify_fail( "Wohin willst Du tauchen?\n" );
  if(member(({ "auf", "oben", "raus"}),str)>-1 )
  {
    write("Du tauchst auf.\n");
    say( TPN+" taucht auf.\n");
    TP->move(SEE("schwimm"),M_GO);
    return 1;
  }
  else
  {
    write("Dahin kannst Du nicht tauchen.\n");
    return 1;
  }
}

take(str)
{
  object wurm;
  wurm=find_living("ruesselwurm");
  printf("wurm gibts: %O\n",wurm);
  if(stringp(str) || str!="")
  {
  if(wurm->id("ruesselwurm"))
  {
	printf("wurm is da: %O\n",wurm);
    wurm->move(ME,M_NOCHECK);
    TP->AddPursuer(wurm);
    write("Das war der Hort des Ruesselwurms, Du haettest besser "
	  +"die Finger davon gelassen.\n");
    wurm->SetProp(P_AGGRESSIVE,1);
  }
  }
  return 0;
}

