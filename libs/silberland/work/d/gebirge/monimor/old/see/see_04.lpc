//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, Mai 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Weg um den See" );
  SetProp( P_INT_LONG, BS(
    "Der Weg wirkt oede und unbelebt. Nichts hier scheint auch nur Leben "
    +"zuzulassen. Selbst das Leben spendende Wasser scheint nur Steine zu "
    +"beherbergen. Dennoch scheint dies dem Ruesselwurm nichts auszumachen. "
    +"Du ueberlegst, ob er nicht absichtlich diesen See zu seiner Heimat "
    +"auserkoren hat, um seinen Hort vor Dieben zu schuetzen. Vielleicht ist "
    +"hier am See oder in ihm etwas versteckt.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18]) );

  STAND1
  STAND2
  
  AddCmd(({"schwimm","schwimme"}),"schwimm");
  
  AddDetail("hort","Drachen horten ihre Beute und bewachen sie.\n");
  AddDetail("beute","Diebesgut, Kriegausbeute, ...\n");
  AddDetail(({"diebe","dieb"}),bs("Hier ist absolut niemand."));
  AddDetail("leben","Hier lebt nichts. Der See ist total kahl und so auch der Weg.\n");

//  AddSound( DEFAULT_SOUND,
//    "");
    
//  AddSmell( DEFAULT_SMELL,
//    "");

//  AddRoomMessage( 
//    ({""}),30,"func");

  
  AddExit("suedosten",SEE("see_03"));
  AddExit("westen",SEE("see_05"));
}

SWIM
