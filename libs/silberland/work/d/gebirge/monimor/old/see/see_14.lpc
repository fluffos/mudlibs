
//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, August 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT,"Der Weg um den See");
  SetProp(P_INT_LONG,"Hier ist es total schattig. Eine Felswand im "
	+"Sueden erlaubt der Sonne annaehernd keinen Lichtstrahl "
	+"hierherzusenden. Du stehst auf einem kleinen Felsvorsprung, "
	+"der in einen See hineinragt. Im Norden ist ein Weg. In der "
	+"Suedwand siehst Du ein Loch.\n");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10+random(7)]) );

  STAND1
  STAND2

  AddDetail("loch","Es ist ziemlich breit. Du koenntest versuchen "
	+"durchzuklettern.\n");
  AddDetail(({"vorsprung","felsvorsprung"}),"Du stehst auf einem "
	+"kleinen Felsvorsprung, der in einen See hineinragt. Von "
	+"hier fuehrt ein Weg weg.\n");
  AddDetail(({"strahl","lichtstrahl"}),"Die Felswand im Sueden wirft "
	+"annaehernd einen totalen Schatten.\n");
  AddDetail("schatten","Es ist fast finster.\n");

  AddItem(OBJ("see_tafel"),REFRESH_REMOVE);
  AddCmd(({"kletter","klettere"}),"klettern");

  AddExit("norden",SEE("see_13"));
}

klettern(str)
{
  if(!stringp(str) || str=="")
	return (notify_fail("WO willst Du durchklettern?\n"),0);
  if(member(({"durch loch","loch","in loch"}),str)>-1)
  {
    write("Du kletterst durch ein Loch.\n");
	say(TPN+" klettert durch ein Loch.\n",TP);
	TP->move(ROOM("hoehle4"),M_GO);
	return 1;
  }
  else
	return(notify_fail("Da kannst Du nicht durchklettern.\n"),0);
}
