
#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();


  SetProp(P_INT_LONG,"Du stehst nun in einem kleinen Badezimmer. "
	+"Aus Stein gemeisselt siehst Du ein kleines und ein grosses "
	+"Becken in der Wand. Ein Handtuch haengt an der Wand. "
	+"Neben dem Handtuch haengt ein Spiegel an derselben Wand. "
	+"Ausserdem siehst Du einen Tigerpelz als Teppich auf dem "
	+"Boden.\n");
  SetProp(P_INT_SHORT,"In einem Bad in einer Hoehle");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23]) );

  AddDetail(({"bad","zimmer","badezimmer"}),"Nachdem was Du hier "
	+"siehst, muss das wohl ein Badezimmer sein.\n");
  AddDetail(({"becken"}),"Du siehst zwei Becken, eines dient wohl "
	+"als Badewanne, das andere als Waschbecken.\n");
  AddDetail(({"wanne","badewanne"}),"Sie ist aus Stein gemeisselt. "
	+"Deshalb steht sie etwas hinter dem Niveau der Wand.\n");
  AddDetail("waschbecken","Das Waschbecken haengt etwas hinter dem "
	+"Niveau der Wand, da aus der Wand herausgemeisselt wurde. Es "
	+"ist an der gegenueberliegenden Wand der Badewanne. So wie "
	+"es gefertigt ist, muss es Zwergenwerk sein.\n");
  AddDetail("niveau","Das Becken und die Wanne sind etwas hinter "
	+"dem Niveau der Wand, da sie aus ihr herausgearbeitet wurden.\n");
  AddDetail("wand","In der Wand links von Dir ist ein Waschbecken, "
	+"ueber dem ein Spiegel und neben dem ein Handtuch haengt. In "
	+"die gegenueberliegende Wand ist eine Badewanne gehauen. Dir "
	+"gegenueber ist eine leere Wand und hinter Dir fuehrt ein Stollen "
	+"durch die Wand zurueck.\n");
  AddDetail("boden","Auf dem Boden liegt ein Teppich.\n");
  AddDetail(({"teppich","tigerpelzteppich"}),"Auf dem Boden liegt ein "
	+"Teppich aus Tigerpelz.\n");
  AddDetail(({"tigerpelz","pelz","tiger"}),"Der Pelz eines toten Tigers. "
	+"Auch sein Kopf ist noch dran.\n");
  AddDetail(({"kopf","zahn","zaehne"}),"Die Zaehne des Tigers lachen "
	+"Dich an.\n");
  AddDetail(({"tuch","handtuch"}),"Damit kann man sich abtrocknen. "
	+"Es ist moosgruen.\n");
  AddDetail("spiegel","Huch, das bist ja Du!\n");

  AddExit("westen",SEE("hoehle_01"));
}
