
#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();


  SetProp(P_INT_LONG,"Das ist die Wohnkueche der Hoehle. Hier "
	+"steht ein kleiner Steinherd, ein Haeufchen Holz, ein "
	+"paar Strohballen, die wohl zum Sitzen dienen, ein Schrank "
	+"und allerhand Plunder herum. Insgesamt sieht es noch nicht "
	+"sehr wohnlich aus.\n");
  SetProp(P_INT_SHORT,"Eine Wohnkueche in einer Hoehle");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15]) );

  AddDetail(({"kueche","wohnkueche","zimmer","wohnzimmer"}),
	"Dieser Teil der Hoehle erinnert an eine Wohnkueche. "
	+"Ein Herd und eine ungemuetlich aussehende Sitzgelegenheit "
	+"deuten darauf hin.\n");
  AddDetail(({"teil","hoehle"}),"Dieses Zimmer ist nur ein Teil "
	+"einer groesseren Hoehle. Sie wird von Relm, dem Ambosszwerg "
	+"bewohnt.\n");
  AddDetail(({"herd","steinherd"}),"Der Herd ist aus massivem "
	+"Gestein, das ausgehoelt wurde. Er wird mit Holz beheizt.\n");
  AddDetail(({"stein","gestein"}),"Das Gestein entspricht dem, "
	+"das hier ueberall zu finden ist.\n");
  AddDetail(({"haufen","haeufchen","holz"}),"Dieser Haufen Holz "
	+"wurde angelegt, um den Herd zu beheizen.\n");
  AddDetail(({"ballen","strohballen"}),"Auf diesen Strohballen "
	+"kann man sitzen. Sie sind nicht die komfortabelste Art "
	+"der Innenausstattung, doch sind sie immer noch weicher "
	+"als Stein.\n");
  AddDetail(({"ausstattung","innenausstattung"}),"Das Zimmer "
	+"ist mit ein paar Strohballen, einem Schrank und einem "
	+"Herd ausgestattet.\n");
  AddDetail("schrank","Der Schrank ist aus massivem Eichenholz. "
	+"Er sieht ziemlich stabil aus.\n");
  AddDetail("eichenholz","Der Schrank besteht aus schoen gemasertem "
	+"Eichenholz. Dieses Holz ist dafuer bekannt, sehr stabil zu "
	+"sein.\n");
  AddDetail("plunder","Du siehst vieles herumliegen, was noch nicht "
	+"eingeraeumt wurde. Offensichtlich ist Relm hier erst vor "
	+"kurzem eingezogen und ist noch nicht dazu gekommen, alles "
	+"zu verstauen. Was da so herumliegt, erinnert an Werkzeug aus "
	+"einer Schmiede.\n");
  AddDetail("werkzeug","Was man halt so in einer Schmiede benoetigt. "
	+"Hammer, Zange, ...\n");
  AddDetail(({"hammer","zange"}),"Davon liegt hier reichlich herum.\n");
  AddDetail("schmiede","Das hier ist keine Schmiede, bloss das "
	+"Werkzeug stammt aus einer.\n");
  AddDetail("boden","Am Boden liegt allerhand Plunder herum.\n");
  AddDetail("decke","Die Decke ist nicht besonders hoch.\n");
  AddDetail(({"gelegenheit","sitzgelegenheit"}),"Sofern man "
	+"ein paar Strohballen so nennen kann ...\n");
  AddDetail(({"wand","waende"}),"Dir faellt nichts besonderes an "
	+"den Waenden auf. Sie bestehen aus Fels.\n");


  AddItem(MONPC("relm"),REFRESH_DESTRUCT);
  AddExit("sueden",SEE("hoehle_01"));
  AddExit("osten",SEE("hoehle_04"));
}

