
//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor@SL, August 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Weg um den See" );
  SetProp( P_INT_LONG, "Du siehst hier an der Felswand ueber Dir "
	+"einen kleinen Vorsprung. Ansonsten sieht es hier nicht anders "
	+"aus als woanders am See.\n");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18]) );

  STAND1
  STAND2

  AddDetail(({"wand","felswand"}),"Du siehst einen Vorsprung ueber "
	+"Dir. Er ist nicht sehr hoch oben.\n");
  AddDetail("vorsprung","Ueber Dir in der Felswand ist ein Vorsprung. "
	+"Vielleicht kann man hochklettern.\n");
  
  AddCmd(({"schwimm","schwimme"}),"schwimm");
  AddExit("suedosten",SEE("see_06"));
  AddExit("suedwesten",SEE("see_08"));

  AddCmd(({"kletter","klettere"}),"klettern");
}

SWIM

klettern(str)
{
  if(!stringp(str) || str=="")
	return(notify_fail("WOHIN willst Du klettern?\n"),0);
  if ( member(({"vorsprung","auf vorsprung","hoch","oben",
	"auf wand","auf felswand","wand","felswand","felsvorsprung",
	"auf felsvorsprung","nach oben"}),str)>-1 )
  {
    write("Du kletterst auf einen Vorsprung.\n");
	say(TPN+" klettert auf einen Vorsprung.\n",TP);
	TP->move(SEE("greifenh"),M_GO);
	return 1;
  }
  else
	return(notify_fail("Da kannst Du nicht hinklettern.\n"),0);
}
