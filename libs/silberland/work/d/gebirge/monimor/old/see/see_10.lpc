
//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, August 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT,"Der Weg um den See");
  SetProp(P_INT_LONG,"Der Weg fuehrt direkt am See entlang. "
	+"Zwischen See und Felswand ist hier allerdings eine "
	+"Lichtung. Als Du genauer hinsiehst, siehst Du, dass "
	+"hier tatsaechlich ein grosser Spalt in der Felswand ist, "
	+"durch den ein Bach seinen Weg bahnt.\n");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15+random(10)]) );

  STAND1
  STAND2

  AddDetail(({"lichtung"}),"Zwischen dem See und der Felswand "
	+"ist hier eine Lichtung von zehn mal zehn Meter Groesse. "
	+"Sie gleicht einer Lichtung in einem Wald nicht im geringsten, "
	+"da hier keine Baeume, sondern Felswaende ihre Umgrenzung "
	+"bilden. Die Lichtung ist begruent, ein Bach fliesst mitten "
	+"durch sie durch und sogar ein Baum steht neben ihm. "
	+"Neben dem Baum stehen zwei Findlinge von der Groesse eines "
	+"hochgewachsenen Elfen, je einer auf der oestlichen und einer "
	+"auf der westlichen Seite.\n");
  AddDetail(({"wand","felswand","waende","felswaende"}),"Die Waende "
	+"sind makellos. Sie wirken wie poliert, doch ist hier ein "
	+"grosser Spalt, der die Makellosigkeit der Waende stoert. "
	+"Durch ihn kommt ein Bach hindurchgeflossen.\n");
  AddDetail(({"makellosigkeit","spalt"}),"Der Spalt in der "
	+"Felswand stoert deren Makellosigkeit. Er ist etwa drei Zwerge "
	+"hoch und drei Schritt breit. Wie tief er ist, kann man von "
	+"hier schwer sagen, doch kommt ein Bach aus ihm hervot.\n");
  AddDetail("bach","Der Bach kommt aus einem Spalt in der "
	+"Felswand. Er speist den See und offenbar auch die Wiese "
	+"dieser Lichtung, sowie einen Baum. Der Bach fliesst "
	+"annaehernd in der Mitte der Lichtung durch, bloss um "
	+"den Baum, der die Mitte der Lichtung bildet, macht er einen "
	+"Bogen, sodass er zwischen Baum und Findling an dessen "
	+"westlicher Seite hindurchfliesst.\n");
  AddDetail("baum","Der Baum bildet annaehernd die rechnerische "
	+"Mitte dieser Lichtung. Es ist ein alter, hochgewachsener "
	+"sowie weitgefaecherter Baum, der seine Aeste in alle "
	+"Himmelsrichtungen streckt und einen angenehm kuehlen Schatten "
	+"wirft. Der Stamm des Baumes ist von einer dunklen Borke "
	+"ueberzogen, dunkelbraun. Tatsaechlich siehst Du hier "
	+"zum ersten Mal in der Klamm etwas Farbe. Der Stamm ist "
	+"fest und scheint viele Unwetter und Stuerme ueberstanden "
	+"zu haben, was seine Zeichnung andeutet.\n");
  AddDetail("stamm","Der Stamm des Baumes ist dick und stark. "
	+"Er wird von einer dunkelbraunen Borke gekleidet und "
	+"viele starke Aeste entspringen aus ihm. Die Geschichte, "
	+"die dieser Stamm zu erzaehlen haette, wuerde selbst das "
	+"Gedaechtnis der aeltesten und weisesten der Weisen "
	+"ueberfordern, dessen eingedenk zu sein.\n");
  AddDetail("geschichte","Der Baum hat schon vieles kommen und "
	+"gehen sehen, vieles erlebt und vieles wohl auch "
	+"verschwiegen.\n");
  AddDetail(({"weise","weisen","gedaechtnis"}),"Das Gedaechtnis "
	+"der Weisen soll allumfassend sein, doch ist es doch bloss "
	+"das von Sterblichen und somit fehlbar.\n");
  AddDetail(({"sterblicher","sterblichen","sterbliche"}),"Wohl "
	+"jemand, der nicht ewig lebt.\n");
  AddDetail(({"ast","aeste"}),"Die Aeste des Baumes senken sich "
	+"tief, als haetten sie eine schwere Last zu tragen. Sie "
	+"zeigen in alle Himmelsrichtungen, starke, lange Aeste, "
	+"die einen angenehm kuehlen Schatten auf die Lichtung "
	+"werfen, die sonst der prallen Sonne ausgeliefert waere. "
	+"Die Aeste sind mit vielen Blaettern bestueckt, grossen, "
	+"dunkelgruenen gefiederten Blaettern, wie Du sie noch "
	+"nie gesehen hast.\n");
  AddDetail(({"blatt","blaetter"}),"Solche Blaetter hast Du "
	+"noch nie gesehen. Du kannst sie keinem Dir bekannten "
	+"Baum zuordnen. Sie sind drei Handteller gross, dunkelgruen "
	+"und gefiedert. Sie scheinen sich langsam und bedaechtig "
	+"zu bewegen, obwohl kein Wind weht.\n");
  AddDetail("wind","Es geht kein Wind. Es ist absolut still. "
	+"Nur die Blaetter rauschen leise.\n");
  AddDetail("borke","Die Borke des Baumes ist alt und zerfurcht, "
	+"gezeichnet von vielen unwettern.\n");
  AddDetail(({"farbe","farben","vielfalt"}),"Diese Lichtung scheint wahrlich "
	+"seltsam zu sein. Farben sind hier in einer wahren Vielfalt "
	+"zu finden, was man ansonsten in der Klamm nicht kann.\n");
  AddDetail(({"findling","steine"}),"Zwei Findlinge stehen zu "
	+"Seiten des Baumes. Sie sind vom Gestein der Klamm "
	+"geschlagen und wieder fein poliert, sodass auch sie "
	+"makellos glatt sind. Vermutlich hat jemand sie absichtlich "
	+"hierher gestellt. Jetzt ruhen die Aeste des Baumes auf "
	+"ihnen.\n");
  AddDetail("gestein","Das Gestein der Findlinge ist total "
	+"glatt.\n");
  AddDetail(({"himmelsrichtung","himmelsrichtungen"}),"Die kennst "
	+"Du alle. Wie sonst koenntest Du Dich hier wohl zurechtfinden?\n");
  AddDetail("last","Die Aeste des Baumes haben wahrlich eine "
	+"schwere Last zu tragen, sind sie doch von Blaettern reich "
	+"bestueckt und tragen sie doch auch weitere, kleinere Aeste.\n");
  AddDetail("mitte","Annaehernd in der rechnerischen Mitte der "
	+"Lichtung steht ein alter Baum.\n");
  AddDetail("seite","Auf seiner oestlichen und westlichen Seite "
	+"hat der Baum je einen Findling stehen, auf denen seine "
	+"Aeste ruhen.\n");
  AddDetail("umgrenzung","Sie wird von Felswaenden und dem Weg "
	+"gebildet.\n");
  AddDetail(({"wiese","gras"}),"Das Gras der Wiese wird offenbar "
	+"von dem Bach genaehrt. Es ist hochgewachsen, saftig gruen und nicht von "
	+"den Strahlen der Sonne verbrannt, sofern es unter dem "
	+"Schatten des Baumes Schutz findet.\n");
  AddDetail(({"strahl","strahlen","sonne"}),"Die Strahlen der "
	+"Sonne wuerden Dich unerbittlich treffen, waere nicht "
	+"der schattenspendende Baum.\n");
  AddDetail(({"schutz","schatten"}),"Der kuehle Schatten, den der "
	+"Baum wirft, bietet dem Gras Schutz vor allzu gleissender "
	+"Sonne.\n");
  AddDetail("handteller","Du hast selber welche.\n");
  AddDetail(({"unwetter","sturm","stuerme"}),"Der Baum ist so alt, "
	+"dass er davon sicher schon genug erlebt hat. Das sagt auch "
	+"die Zeichnung, die er derer davongetragen hat.\n");
  AddDetail(({"zeichnung","spur","spuren"}),"Viele Unwetter haben ihre Spuren an "
	+"dem Baum hinterlassen. Abgebrochene Aeste, eine rauhe "
	+"Borke und dergleichen, wodurch der Baum jedoch bloss "
	+"gewachsen ist.\n");
  AddDetail("wald","Ein Baum macht noch keinen Wald.\n");
  AddDetail("baeume","Wer spricht von Baeumen? Einen Baum kannst Du "
	+"sehen.\n");
  AddDetail("bogen","Der Bach windet sich um Den Baum, sodass er "
	+"zwischen diesem und dem Findling auf dessen westlicher Seite "
	+"hindurchfliesst.\n");

  AddSound(({"rauschen","blaetter"}),"Du hoerst die Blaetter rauschen, "
	+"obwohl von einem Wind keine Spur ist.\n");
  AddSound("wind","So sehr Du Dich auch anstrengst, Du kannst keinen "
	+"auch noch so geringen Wind hoeren.\n");
  AddSmell(DEFAULT_SMELL,"Du riechst den angenehmen Duft einer "
	+"Wiese.\n");
  AddSmell(({"duft","wiese"}),"Der Duft erinnert Dich an so manch "
	+"anderen, fast elfischen Ort.\n");

  AddExit("suedosten",SEE("see_09"));
  AddExit("westen",SEE("see_11"));

  AddItem(NPC("ndrache"),REFRESH_DESTRUCT);

}

