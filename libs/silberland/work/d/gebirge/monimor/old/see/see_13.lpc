
//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, August 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT,"Der Weg um den See");
  SetProp(P_INT_LONG,"Du trittst aus dem Schatten des Gebirges "
	+"hervor und siehst Dich erst mal gruendlich um. Westlich "
	+"tuermen sich Felswaende empor, waehrend oestlich von Dir "
	+"ein See liegt. Der Weg auf dem Du stehst fuehrt von Sueden "
	+"nach Nordosten. Im Sueden siehst Du eine hoehe Felswand "
	+"emporragen. Im Nordosten fuehrt der Weg weiter um den See "
	+"herum.\n");
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10+random(7)]) );

  STAND1
  STAND2

  AddExit("sueden",SEE("see_14"));
  AddExit("nordosten",SEE("see_12"));
}
