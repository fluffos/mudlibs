//   Der Greifenhorst am See
//
//   Monimor, Mai 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Greifenhorst" );
  SetProp( P_INT_LONG, "Du stehst auf einem kleinen Felsvorsprung. "
	+"Er ist mit Stroh und abgebrochenen Zweigen ausgelegt. Du "
	+"siehst drei oberschenkelgrosse Eier hier liegen. Hast Du "
	+"soetwas nicht schon irgendwo gesehen? Doch, das sind die "
	+"Eier eines Greifen. Dann muss das hier ein Greifenhorst sein."
  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18]) );

  AddDetail(({"vorsprung","felsvorsprung","horst","greifenhorst"}),
	"Du stehst in einem Greifenhorst, der mit Stroh und Zweigen "
	+"ausgelegt ist. Drei Eier liegen herum.\n");
  AddDetail(({"stroh","zweig","zweige"}),"Damit ist der Horst "
	+"ausgelegt. Offensichtlich finden Greifen das gemuetlich.\n");
  AddDetail(({"ei","eier"}),"Die Eier sind oberschenkelgross und "
	+"sehen dementsprechend schwer aus. Du solltest die Finger "
	+"von ihnen lassen.\n");
  AddDetail("himmel","Du kannst hier den Himmel schon ganz gut "
	+"erkennen. Schliesslich bist Du ihm hier etwas naeher. "
	+"Von hier kannst Du sogar einige Wolken vorueberziehen "
	+"sehen.\n");
  AddDetail(({"wolke","wolken"}),"Sie ziehen langsam und duenn "
	+"am Himmel vorueber.\n");
  AddDetail("boden","Der Boden ist mit Stroh und abgebrochenen "
	+"Aesten ausgelegt. Greifen versuchen sich so ein gemuetliches "
	+"Nest zu schaffen.\n");
  AddDetail("nest","Das Nest eines Greifen heisst Horst.\n");
  AddSound( DEFAULT_SOUND,
    "Der Wind weht um den Vorsprung und singt ein beruhigendes Lied.\n");
  AddSound("wind","Der Wind verursacht ein Pfeifen, das sich wie "
	+"Gesang anhoert.\n");
  AddSound(({"gesang","lied","schlaflied"}),"Dieses Lied wirkt auf Dich wie "
	+"ein Schlaflied. Du erinnerst Dich an Deine Mutter, die "
	+"Dir immer vor dem Schlafen vorgesungen hat.\n");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Vogelkot.\n");
  AddSmell(({"kot","vogelkot"}),"Greifen duerften nicht weit fliegen, "
	+"um ihr Geschaeft zu verrichten. Es stinkt bestialisch.\n");

  AddItem(NPC("greif"),REFRESH_DESTRUCT);
  AddCmd(({"kletter","klettere"}),"klettern");
}

klettern(str)
{
  if(!stringp(str) || str=="")
		  return(notify_fail("WOHIN willst Du klettern?\n"),0);
  if(member(({"runter","unten","nach unten","zurueck"}),str)>-1)
  {
    write("Du kletterst nach unten.\n");
	say(TPN+" klettert nach unten.\n",TP);
	TP->move(SEE("see_07"),M_GO);
	return 1;
  }
  else
	return(notify_fail("Da kannst Du nicht hinklettern.\n"),0);
}
