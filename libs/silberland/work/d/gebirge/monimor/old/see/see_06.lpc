//   Der See in der Klamm der Seelen
//   Details in /d/gebirge/monimor/room/see/see.h
//
//   Monimor, Mai 1997

#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include "./see.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Der Weg um den See" );
  SetProp( P_INT_LONG, BS(
    "Hier ist der Weg etwas breiter. An der Felswand haengt ein Moosteppich "
    +"herab. Ansonsten bietet sich Dir der selbe Anblick wie ueberall hier "
    +"am See.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18]) );

  STAND1
  STAND2
  
  AddCmd(({"schwimm","schwimme"}),"schwimm");
  
  AddDetail(({"moos","teppich","moosteppich"}),bs("Der Teppich ist "
    +"offensichtlich von Zwergenhand aus Moos geflochten. Das Moos ist "
    +"feucht. Was ist wohl hinter dem Teppich."));
  AddDetail("anblick",bs("Hier sieht es wie ueberall hier um den See "
    +"aus. Glatter Fels hier und da der See. Nur an der Wand haengt hier ein "
    +"Moosteppich."));
    
//  AddSound( DEFAULT_SOUND,
//    "");
    
//  AddSmell( DEFAULT_SMELL,
//    "");

//  AddRoomMessage( 
//    ({""}),30,"func");

  
  AddExit("suedosten",SEE("see_05"));
  AddExit("nordwesten",SEE("see_07"));
  AddExit("nordosten",SEE("hoehle_01"),"durch das Moos");
}

SWIM
