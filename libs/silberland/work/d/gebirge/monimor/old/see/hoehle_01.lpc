
#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();


  SetProp(P_INT_LONG,"Du bist in einer kleinen Hoehle angelangt. "
	+"irgendwie erinnert sie Dich an eine Art Vorraum. Es fuehren "
	+"Stollen nach Osten und Norden, im Suedwesten ist der "
	+"Ausgang. In die Wand ist ein Kleiderstaender eingemeisselt. "
	+"Ein Paar Stiefel steht neben dem Eingang. Der Raum wird "
	+"von zwei Fackeln erhellt.\n");
  SetProp(P_INT_SHORT,"Im Vorraum einer Zwergenhoehle");
  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15]) );

  AddDetail(({"art","vorraum","raum"}),"Diese Hoehle sieht aus wie ein "
	+"Vorraum zu anderen Hoehlenteilen. Ein Kleiderstaender "
	+"erinnert Dich an einen typischen Vorraum.\n");
  AddDetail(({"stollen","verbindungsstollen","verbindung"}),
	"Von hier fuehren zwei Verbindungsstollen in andere Teile "
	+"der Hoehle. Die Decke ist dort etwas niedriger.\n");
  AddDetail("boden","Der Boden ist sauber geputzt. Beim Eingang "
	+"steht ein Paar Stiefel.\n");
  AddDetail("decke","Die Decke ist nicht sehr hoch. Zu den "
	+"Verbindungsstollen wird sie immer niedriger.\n");
  AddDetail(({"ausgang","moos","teppich","moosteppich"}),
	"Der Ausgang im Suedwesten ist von durch Moosteppich "
	+"verdeckt.\n");
  AddDetail(({"fackel","fackeln"}),"Zwei Fackeln erhellen die "
	+"Hoehle, sonst koenntest Du hier nichts sehen.\n");
  AddDetail(({"staender","kleiderstaender"}),"Hier ist ein "
	+"Kleiderstaender in die Wand eingemeisselt worden. Er "
	+"besteht aus einer Querstange, an die Kleiderbuegel "
	+"gehaengt werden koennen.\n");
  AddDetail(({"stange","querstange"}),"Sie ist aus der Wand "
	+"herausgemeisselt worden und verlaeuft horizontal.\n");
  AddDetail(({"buegel","kleiderbuegel"}),"Hier sind keine "
	+"Kleiderbuegel. Vermutlich ist diese Hoehle noch nicht "
	+"lange bewohnt.\n");
  AddDetail("eingang","Hiermit ist wohl auch der Ausgang "
	+"gemeint.\n");
  

  AddItem(OBJ("stiefel"),REFRESH_REMOVE);
  AddExit("norden",SEE("hoehle_02"));
  AddExit("osten",SEE("hoehle_03"));
  AddExit("suedwesten",SEE("see_06"));
}

