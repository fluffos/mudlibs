inherit "std/transport";
#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  ::create();

  SetProp(P_NAME,"Mahldor");
  AddId( ({"mahldor","drache"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_INT_SHORT,"Auf Mahldors Ruecken");
  SetProp(P_INT_LONG,
    "Du sitzt auf Mahldors Ruecken, der mit rasender Geschwindigkeit durch "
    "die Wolken fliegen kann. Du krallst Dich jetzt fest in seinen Panzer, "
    "um nicht herunter zu fallen, was sicherlich fatal waere.");
  SetProp(P_SHORT,"Mahldor, der Flugdrache");
  SetProp(P_LONG, 
    "Mahldor ist ein annaehernd 5 Zwerge grosser Drache. Sein Panzer glitzert "
    "im hellen Schein der Sonne, sodass Du foermlich geblendet bist. Du "
    "koenntest versuchen, auf seinen Ruecken zu klettern.");
  SetProp(P_LIGHT,1);
  SetProp(P_TRANSPARENT,1);
  SetProp(P_DEPARTMSG,({ "Mahldor schwingt die riesigen Fluegel und steigt in die Luft.\n",
   "Mahldor hebt gerade vom Boden ab und fliegt davon.\n"}) );
  SetProp(P_ARRIVEMSG,({
   "Mahldor naehert sich @@QueryArrived@@ und landet.\n",
   "Mahldor landet soeben von seinem Flug durch die Wolken.\n" }) );
  SetProp(P_ENTERMSG,({ "klettert auf Mahldors Ruecken",
   "kommt hochgeklettert" }) );
  SetProp(P_LEAVEMSG, ({ "klettert von Mahldors Ruecken",
   "klettert von Mahldors Ruecken" }) );

  SetProp(P_LEAVEFAIL, ({
   "Mahldor fliegt gerade ziemlich hoch, Du koenntest Dich verletzen",
   "unternahm gerade einen Selbstmordversuch und liess es doch sein"}) );
  SetProp(P_ENTERFAIL,"Es koennen nur 3 Leute gleichzeitig mitfliegen.\n" );
  SetProp(P_MAX_PASSENGERS, 3);

  AddCmd( ({"steig","steige","kletter","klettere"}),"klettere");
  SetProp(P_NAME,"Mahldor");
  SetProp(P_ARTICLE,0);

//  set_living_name("mahldor");
  AddDetail( ({ "licht", "sonne" }), 
    "Das Sonnenlicht wird an Mahldors Schuppen bizarr reflektiert. Es ist "
    "sehr hell und wenn Du in die Sonne schaust, blendet es Dich.");
  AddDetail( ({ "drache","mahldor" }), 
    "Mahldor ist ein wahrhaft riesiger Drache. Man erzaehlt sich, dass er "
    "an Tagen guter Laune sogar Passagiere befoerdert, indem sie "
    "\"auf Mahldor klettern\".");
  AddDetail( ({ "nacken" }), 
    "Haifischflossenaehnliche Schuppen nehmen entlang Mahldors Nacken von "
    "Kopf bis Ruecken zu an Groesse ab. Kleinere Schuppen stehen auch "
    "entlang des Rueckens empor, an denen man sich anhalten koennte.");
  AddDetail( ({ "hals" }), 
    "Mahldors Hals geht fliessend in seine Brust ueber. Er beginnt relativ "
    "schmal hinter dem maechtigen Kopf des Drachens, wird aber auf den "
    "Uebergang zu immer breiter, bis man schliesslich keine klare Trennung "
    "zur Brust hin mehr erkennen kann. Auf Mahldors Nacken stehen unzaehlige "
    "Schuppen senkrecht in die Hoehe, die Dich an Haifischflossen erinnern.");
  AddDetail( ({ "brust" }), 
    "Mahldors Brust ist durch unzaehlige groessere und kleinere Muskelpakete "
    "segmentiert. Im Gegensatz zu seinem Panzer wirkt die Brust allerdings "
    "matt und mehr graeulich." );
  AddDetail( ({ "fluegel" }), 
    "Die Fluegel Mahldors haben eine unglaubliche Spannweite. Du schaetzt, "
    "dass diese Fluegel in etwa drei Personen mittleren Gewichts tragen "
    "koennen. Sie ragen aus dem fluessigen Uebergang zwischen Mahldors "
    "maechtigem Hals und seiner segmentierten Brust hervor. Mit der "
    "Fluegelmasse koennte man gut zehn Zelte naehen, aber wer wird schon "
    "einem so gutmuetigen Drachen nach dem Leben trachten.");
  AddDetail("ruecken",
    "Es ist moeglich, auf Mahldors Ruecken zu klettern. Sein Panzer glaenzt "
    "silbern im Licht der Sonne, die an jeder Schuppe bizarr reflektiert "
    "wird. Der Ruecken des Drachen wird so zu einem wahren Lichtermeer.");
  AddDetail("panzer",
    "Der Panzer besteht aus unzaehligen Schuppen. An jeder "
  	"einzelnen wird das Licht der Sonne bizarr reflektiert.");
  AddDetail(({"schuppe","schuppen"}),
    "Hornschuppen, die sehr robust wirken und silbern glaenzen.");
  AddDetail(({"meer","lichtermeer"}),
    "Ein atemberaubender Anblick.");
  AddDetail("reflektionen",
    "Das Licht der Sonne wird an den Schuppen des Panzers reflektiert. "
    "Die Reflektionen erscheinen in den verschiedensten Farben und ergeben "
    "zusammen einen sibernen Glanz.");
  AddDetail(({"farbe","farben"}),
    "Du siehst viele davon. Einige kannst Du nicht mal benennen.");
  AddDetail("silber",
    "Silbern erscheint Dir nur der Glanz des Panzers.");
  AddDetail("glanz",
    "Der Panzer des Drachen glaenzt.");

  AddRoute("/d/gebirge/monimor/room/klamm",60,20,"der Klamm der Seelen",
      ({"klamm","seelenklamm","klamm der seelen"}), "zum Klamm der Seelen");
  AddMsg("Mahldor nimmt nun Kurs auf das Gebirge.\n",20);
  AddMsg("Du siehst bereits das Gebirge unter Dir.\n",10);
  AddMsg("Mahldor geht in den Sinkflug ueber.\n",10);

  AddRoute("/d/gebirge/monimor/room/plateau",60,20,"einem Plateau",
      ({"plateau","gebirge","gebirgsplateau"}),"zum Plateau");
  AddMsg("Du siehst die Klamm der Seelen unter Dir.\n",20);
  AddMsg("Mahldor geht in den Sinkflug ueber.\n",10);

  Start();

}
klettere(str)
{
  string arg, arg2;

  if(!stringp(str) || str=="")
    return (notify_fail("WORAUF willst Du klettern?\n"),0);
  if (sscanf( str, "auf %s", arg ) > 0 && id(explode(arg," ")[0]))
    return Enter();
  if(sscanf(str, "von %s", arg) > 0 && id(explode(arg, "") [0]) || str=="runter")
    return Leave();
}
