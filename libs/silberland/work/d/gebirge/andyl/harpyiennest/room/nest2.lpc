#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "In einer dunklen Hoehle");
  SetProp (P_INT_LONG, "Die Hoehle scheint hier etwas enger zu werden "
	   +"dafuer auch ein wenig trockener. In der Luft liegt ein "
	   +"unangenehm suesslicher Duft. Ein leises Quietschen ist "
	   +"aus Nordosten zu vernehmen. Es ist ziemlich kuehl hier "
	   +"und Dich fasst die Gewissheit, dass dies kein Ort ist "
	   +"wo sich gutartige Lebewesen verbergen wuerden. Ein Gang "
	   +"fuehrt nach Nordwesten und ein zweiter nach Sueden.\n");

  // ROOM DESCRIPTION END;
  


  // DETAILS START;
  
  AddDetail(({"gang", "gaenge"}),
	    "Hier gibt es zwei Gaenge. Ein Gang fuehrt nach Nordwesten "
	    +"und der andere nach Sueden.\n");
  AddDetail(({"boden", "steinboden", "hoehlenboden"}),
	    "Ein ganz normaler Hoehlenboden aus massivem Fels. Er ist "
	    +"ziemlich feucht.\n");
  AddDetail(({"wand", "waende"}),
	     "Die Waende sind feucht und aus massivem Fels. An der Ostwand "
	     +"bemerkst Du jedoch etwas.\n");
  AddDetail(({"ostwand"}),
	    "Du untersuchst die Ostwand naeher und entdeckst eine kleine "
	    +"Kerbe im Fels.\n");
  AddDetail(("kerbe"),
	    "Vielleicht kann man da reingreifen oder etwas reinstecken.\n");  
  AddDetail(({"decke"}),
	    "Die Decke ist aus solidem Fels.\n");
  AddDetail(({"fels", "fall", "gestein", "granit"}),
	    "Du weisst zwar nicht aus welchem Gestein dieser Fels "
	    +"ist, aber in jedem Fall ist er etwas weniger hart als "
	    +"Granit.\n");
  AddDetail(("hoehle"),
	    "Diese Hoehle ist Dir nicht ganz geheuer.\n");
  AddDetail(("ort"),
	    "Du fuehlst Dich ziemlich unwohl an diesem Ort.\n");
  AddDetail(({"gewissheit", "stimmung"}),
	    "Die Gewissheit in dem Unterschlupf eines boesartigen "
	    +"Geschoepfes zu sein hebt nicht gerade Deine Stimmung.\n");
  AddDetail(({"unterschlupf", "vermutung"}),
	    "Hier legt sich die Vermutung nahe, dass Du im Unterschlupf "
	    +"eines boesartigen Geschoepfes bist.\n");
  AddDetail(({"geschoepf", "geschoepfe", "boesartiges geschoepf", "boesartige geschoepfe"}),
	    "Solche Geschoepfe wie hinterlistige Berggoblins , geifernde "
	    +"Werwoelfe oder Schlimmeres.\n");
  AddDetail(({"schlimmeres", "bekanntschaft"}),
	    "Mit so etwas moechtest du eher keine Bekanntschaft machen.\n");
  AddDetail(({"berggoblin", "berggoblins", "gesellen", "masse"}),
	    "Berggoblins sind im hoechsten Masse hinterlistige Gesellen.\n");
  AddDetail(({"werwolf", "werwoelfe", "sekundenschnelle"}),
	     "Ein Werwolf koennte Dich in Sekundenschnelle zerreissen und "
	     +"selbst wenn Du dies ueberleben wuerdest, wuerde es nachher nur "
	     +"noch schlimmer werden.\n");
  AddDetail(("lebewesen"),
	    "Im Silberland gibt es viele Lebewesen.\n");
  AddDetail(({"silberland", "welt"}),
	    "Das Silberland ist die Welt in der Du Dich gerade befindest.\n");
  AddDetail(("quietschen"),
	    "Du kannst ihm ja mal lauschen.\n");
  AddSound(({"quietschen"}),
	   "Das Quietschen muss von einem oder mehreren Geschoepfen stammen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Quietschen aus Nordosten.\n");
  AddSmell(("luft"),
	   "Die Luft riecht unangenehm suesslich hier.\n");
  AddDetail(({"luft", "duft"}),
	    "Riech mal.\n");
  AddSmell(("duft"),
	   "Dieser suessliche Duft ist Dir sehr unangenehm.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht unangenehm suesslich hier.\n");
  // DETAILS ENDE

  // EXITS START
  AddExit ("nordwesten", ROOM"nest1");
  AddExit ("sueden", ROOM"nest3");
  // EXITS END
  
  // COMMANDS START
  AddCmd(({"greif", "greife"}), "greif_was");
  AddCmd(({"steck", "stecke"}), "stecke_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

greif_was(str)
{
  notify_fail("In was willst Du greifen?\n");
  if (!str) return 0;
  if ((str == "in kerbe" || str == "in kerbe hinein" ||
       str == "in kerbe rein"))
    {
      write(BS("Du greifst in die Kerbe findest jedoch nichts "
	       +"ungewoehnliches.\n"));
      return 1;
    }
  else return 0;
}

stecke_was(str)
{
  notify_fail("Was willst Du wohin stecken?\n"); 
  if (!str) return 0;
  else return 1;
}




















