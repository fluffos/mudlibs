#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "Im Nahrungslager der Harpyie");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Hier endet die Hoehle abrupt. Diese Kammer "
	   +"scheint das Nahrungslager der Harpyie zu sein. Ueberall "
	   +"sind Kadaver von Lebewesen zu sehen, die wahrscheinlich "
	   +"fuer den weiteren Verzehr gedacht sind. Jedoch scheinen "
	   +"manche von diesen Kadavern nicht mehr ganz frisch zu sein. "
	   +"Dementsprechend riecht es hier auch. Ein Gang fuehrt wieder "
	   +"zurueck ins Harpyiennest.\n");

  // ROOM DESCRIPTION END;
  

  // DETAILS START;
  
  AddDetail(({"harpyiennest", "nest",}),
	    "Das eigentliche Harpyiennest befindet sich nordwestlich von "
	    +"hier.\n");
  AddDetail(({"gang"}),
	    "Der Gang fuehrt zurueck ins Harpyiennest.\n");
  AddDetail(({"wand", "waende","Natuerliches"}),
	    "Das Gestein der Waende ist auffaellig hell und glatt. "
	    +"Es scheint sich dabei um nichts Natuerliches zu " 
	    +"handeln.\n");
  AddDetail(("decke"),
	    "Die Decke ist aus einem eigenartigen, hellen Gestein.\n");
  AddDetail(("boden"),
	    "Der Boden ist ziemlich glatt und aus einem sonderbaren "
	    +"hellen Gestein.\n");
  AddDetail(({"gestein", "ursprung"}),
	    "Das Gestein ist keines natuerlichen Ursprungs. Es muss "
	    +"kuenstlich geschaffen worden sein.\n");
  AddDetail(({"kammer", "art"}),
	    "Diese Kammer scheint eine Art Nahrungslager zu sein.\n");
  AddDetail(({"nahrungslager", "lager", "speisekammer"}),
	    "Du scheinst Dich jetzt im Nahrungslager der Harpyie zu "
	    +"befinden. Also Dir vergeht hier eher der Appetit als sich, "
	    +"wie in einer normalen Speisekammer ueblich, zu steigern.\n");
  AddDetail(("lebewesen"),
	    "Es scheinen ausnahmslos Tiere gewesen zu sein.\n");
  AddDetail(("appetit"),
	    "Du hast derzeit jeglichen Appetit verloren.\n");
  AddDetail(("hoehle"),
	    "Die Hoehle endet hier.\n");
  AddDetail(({"harpyie", "harpyien", "wahnsinn"}),
	    "Wie Du wahrscheinlich selbst festgestellt hast, "
	    +"sind Harpyien garstige Chimaeren die dem Wahnsinn "
	    +"verfallen sind.\n");
  AddDetail(({"chimaeren", "mischwesen"}),
	    "Chimaeren sind Mischwesen welche meist von "
	    +"tiefboesen Magiebegabten erschaffen werden.\n");
  AddDetail(({"magiebegabte", "boese", "boesen"}),
	    "Magiebegabte die dem Boesen dienen koennen "
	    +"viel Unheil anrichten.\n");
  AddDetail(("unheil"),
	    "Hoffentlich widerfaehrt Dir so etwas nicht.\n");
  AddDetail(("verzehr"),
	    "Die Kadaver die hier herumliegen scheinen fuehr "
	    +"den Verzehr gedacht zu sein.\n");
  AddDetail(({"kadaver", "tierkadaver"}),
	    "Die Kadaver stammen ausnahmslos von Tieren "
	    +"aus den Bergregionen.\n");
  AddDetail(({"tier", "tier"}),
	    "Die Tiere haben wie es aussieht nicht viel "
	    +"Glueck gehabt.\n");
  AddDetail(("glueck"),
	    "Hoffentlich hast Du mehr Glueck als die bedauernswerten "
	    +"Tiere die hier gelandet sind.\n");
  AddDetail(({"bergregion", "bergregionen", "region", "regionen", "lupe"}),
	    "In den Bergregionen gibt es viele verschiedene Tiere. "
	    +"Falls Du die noch nicht kennst solltest Du diese "
	    +"Regionen genauer unter die Lupe nehmen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es stinkt hier nach verwesendern Kadavern.\n");
  AddSmell(({"kadaver", "kadavern"}),
	   "Ihhh, ist das ein uebler Geruch.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein Quietschen aus Nordwesten.\n");
  AddSound(("quietschen"),
	   "Ziemlich schrill und disharmonisch.\n");
  
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("nordwesten"), ROOM"harpyiennest");
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}


















