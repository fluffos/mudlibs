#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:27, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_NAME, "Bestialischer Gestank");
  SetProp (P_INT_SHORT, "Im Harpyiennest");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du befindest Dich hier in einem Harpyiennest. "
	   +"Es ist unangenehm warm hier. Ueberall liegt altes, schimmliges "
	   +"Stroh in dem zusaetzlich eine Unzahl verwesender Teile "
	   +"verschiedenster Lebewesen liegt. Es stinkt bestialisch und "
	   +"Du musst Dich beherrschen, dass Du den Inhalt deines Magens "
	   +"nicht vorzeitig wieder hergibst. Zwei Gaenge sind vorhanden. "
	   +"Einer fuehrt nach Sueden der andere nach Suedosten.\n");

  // ROOM DESCRIPTION END;
  

  // DETAILS START;
  
  AddDetail(({"harpyiennest", "nest", "harpyie", "ort"}),
	    "Du befindest Dich hier im Nest einer Harpyie. Es "
	    +"ist ein Ort an dem Du lieber nicht oft sein moechtest. "
	    +"Du fuehlst Dich sichtlich unwohl.\n");
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt hier zwei Gaenge. Einer fuehrt nach Suedosten, der "
	    +"andere nach Sueden.\n");
  AddDetail(({"wand", "waende", "hoehlenwaende"}),
	    "Die Waende sind aus einem sehr hellen Gestein. Sie " 
	    +"sind auch um etliches glatter als normale Hoehlenwaende. "
	    +"Da und dort kannst Du auch Blutflecken erkennen.\n");
  AddDetail(("stroh"),
	    "Das Stroh ist alt und schimmlig. Zwischen dem Stroh "
	    +"kannst Du eine Unzahl an verwesenden Koerperteilen "
	    +"erkennen.\n");
  AddDetail(("boden"),
	    "Der Boden ist von Stroh und verwesenden Koerperteilen "
	    +"uebersaet.\n");
  AddDetail(("decke"),
	    "Die Decke besteht aus einem seltsam hellen Gestein.\n");
  AddDetail(({"gestein", "Ursprung"}),
	    "Das Gestein ist seltsam hell und scheint nicht natuerlichen "
	    +"Ursprungs zu sein. Es muss also kuenstlich geschaffen "
	    +"worden sein.\n");
  AddDetail(({"flecken", "blutflecken", "flecken"}),
	    "Die Blutflecken duerften von bedauernswerten Opfern der "
	    +"Harpyie stammen.\n");
  AddDetail(("opfer"),
	    "Die verwesenden Teile der Opfer sind ueberall zu sehen.\n");
  AddDetail(("unzahl"),
	    "Eine wahre Unzahl an verwesenden Koerperteilen "
	    +"ist ueber den Boden verstreut.\n");
  AddDetail(("tiere"),
	    "Die Tiere waren entweder unvorsichtig oder hatten "
	    +"einfach nur Pech.\n");
  AddDetail(("pech"),
	    "Hoffentlich hast Du nicht soviel Pech.\n");
  AddDetail(({"teile", "koerperteile"}),
	    "Es sind Koerperteile der verschiedensten Lebewesen die "
	    +"hier ueberall herumliegen.\n");
  AddSpecialDetail(({"lebewesen"}), "lebewesen_schau");
  AddDetail(("anblick"),
	    "Der Anblick ist absolut nicht appetitlich.\n");
  AddDetail(("inhalt"),
	    "Du musst Dich sehr beherrschen um den Inhalt deines "
	    +"Magens nicht ueber den Boden zu verteilen.\n");
  AddDetail(({"magen", "willen"}),
	    "Dein Magen scheint kurz davor zu sein zu revoltieren. Der "
	    +"Gestank ist auch beim besten Willen kaum zu ertragen.\n");
  AddDetail(("gestank"),
	    "Du solltest nicht versuchen mehr von ihm zu riechen.\n");
  
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es stinkt hier bestialisch.\n");
  

  // DETAILS ENDE
  
  // EXITS START
  AddExit (("sueden"), ROOM+"nest5");
  AddExit (("suedosten"), ROOM+"lager");
  // EXITS END
  
  
  // COMMANDS START
  AddCmd(({"lausch", "lausche"}), "lausch_mal");
  AddCmd(({"riech", "rieche"}), "riech_was");
  AddCmd(({"fuetter", "fuettere"}), "fuetter_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

lebewesen_schau()
{
  if (TP->QueryProp(P_RACE)=="fee")
    {
      return("Es duerfte sich dabei hauptsaechlich um unvorsichtige Tiere "
	     +"handeln. Als Du genauer schaust siehst Du aber auch die "
	     +"verfaulenden Koerperteile einer Fee. Dir wird uebel bei diesem "
	     +"Anblick.\n");
    }
  else
    {
    return("Es duerfte sich dabei hauptsaechlich um unvorsichtige Tiere "
	   +"handeln. Als Du genauer schaust siehst Du aber auch die "
	   +"verfaulenden Koerperteile eines "+capitalize(TP->QueryProp(P_RACE))
	   +"s. Dir wird uebel bei diesem Anblick.\n");
    }
}


lausch_mal(str)
{
  notify_fail("Wem oder was willst Du lauschen?\n");
  
  // AUF JUNGE ABFRAGEN

}


riech_was(str)
{
  if ((str == "gestank"))
    {
      write(BS("Du kannst Dich nicht mehr beherrschen "
	       +"und uebergibst Dich kraftig.\n"));
      TP->do_damage(5);
      return 1;
    }
  return 0;
}


fuetter_was(str)
{
  notify_fail("Wen oder was moechtest Du fuettern?\n");
  if (!str) return 0;
  write(BS("da geht no nix.\n"));
  return 1;
}
  


reset()
{
  ::reset();
}  

















