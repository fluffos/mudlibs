#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "In einer dunklen Hoehle");
  SetProp (P_INT_LONG, "Du stehst in einer dunklen nassen "
	   +"Hoehle. Wasser tropft auf Dich herab und Dir ist kalt. "
	   +"Es ist eng und die Luft ist stickig hier unten. "
	   +"Seltsame Geraeusche sind aus oestlicher Richtung "
	   +"zu hoeren. Du scheinst nicht allein in dieser Hoehle "
	   +"zu sein. Durch ein Loch in der Decke kommt man wieder "
	   +"nach oben.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  
  AddDetail(({"boden", "hoehlenboden", "unzahl"}),
	    "Ein typischer Hoehlenboden aus zerklueftetem Fels "
	    +"auf dem eine Unzahl an Gesteinsbrocken herumliegen. "
	    +"Mehrere Pfuetzen haben sich durch das herabtropfende "
	    +"Wasser gebildet.\n");
  AddDetail(({"luft"}),
	    "Du kannst sie ja mal riechen.\n");
  AddSmell(("luft"),
	   "Die Luft riecht stickig. Irgendwas ist hier faul.\n");
  AddDetail(({"brocken", "gesteinsbrocken", "gestein"}),
	    "Normale Gesteinsbrocken wie sie in jeder Hoehle zu "
	    +"erwarten waeren.\n");
  AddDetail(({"pfuetze", "pfuetzen", "wasserpfuetze", "wasserpfuetzen"}),
	    "Mehrer Wasserpfuetzen haben sich durch das staendig "
	    +"herabtropfende Wasser gebildet.\n");
  AddDetail(({"wand", "waende", "felswaende", "felswand"}),
	    "Harte, zerklueftete Felswaende in denen sich da und dort "
	    +"eingige Wasserrinnsale gebildet haben.\n");
  AddDetail(({"wasserrinnsale", "rinnsal", "rinnsale", "wasserrinnsal"}),
	    "In ihnen fliesst klares Gebirgswasser nach unten.\n");
  AddDetail(({"wasser", "gebirgswasser"}),
	    "Klares, reines Gebirgswasser. Wenn man das etwas "
	    +"verfeinern wuerde, koennte man es glatt als "
	    +"'Feloniaquelle' verkaufen.\n");
  AddDetail(({"feloniaquelle", "mineralwasser"}),
	    "Feloniaquelle waere doch ein guter Name fuer ein "
	    +"Mineralwasser, oder?\n");
  AddDetail(({"name", "namen"}),
	    "Kennst Du etwa einen besseren Namen als 'Feloniaquelle' "
	    +"fuer ein Mineralwasser?\n");
  AddDetail(("decke"),
	    "Die Decke einer Hoehle aus solidem Fels. Wasser tropft "
	    +"von ihr herunter direkt in Deine Nase. Ausserdem kannst "
	    +"Du noch ein Loch in ihr erkennen.\n");
  AddDetail(({"loch", "oberflaeche"}),
	    "Durch das Loch kommst Du wieder an die Oberflaeche.\n");
  AddDetail(({"nase", "wassertropfen", "hatschi"}),
	    "Ein Wassertropfen trifft Dich direkt in die Nase und "
	    +"Du befoerdest ihn mit einem lauten * HATSCHI * wieder "
	    +"nach draussen.\n");
  AddDetail(({"fels", "weisheit", "zeh"}),
	    "Eine zwergische Weisheit besagt:\n "
	    +"Knallt gegen den Fels der grosse Zeh,\n "
	    +"tut der grosse Zeh Dir weh!\n");
  AddDetail(("hoehle"),
	    "Du stehst in einer Hoehle wie sie im Lehrbuch steht.\n");
  AddDetail(("lehrbuch"),
	    "Ueber sowas hast Du sicher gerne geschlafen, stimmts?\n");
  AddDetail(({"richtung", "geraeusche", "geraeusch"}),
	    "Aus oestlicher Richtung kannst Du Gerauesche vernehmen.\n");
  AddSound(({"geraeusche", "geraeusch", "quietschen"}),
	   "Hoert sich an wie das Quietschen mehrerer Irrer.\n");
  AddDetail(({"irre", "mudder", "menschen", "schlussfolgerung", "irrer"}),
	    "Eine echt gnomische Schlussfolgerung:\n"
	    +"Irren ist menschlich.\n"
	    +"Mudder sind Menschen.\n"
	    +"Ergo: Mudder sind Irre.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst seltsame Geraeusche von Osten.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht unangenehm hier.\n");
  // DETAILS ENDE

  // EXITS START
  AddExit ("loch", ROOM"plattform");
  AddExit ("suedosten", ROOM"nest2");
  // EXITS END

  // COMMANDS START
 
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}
























