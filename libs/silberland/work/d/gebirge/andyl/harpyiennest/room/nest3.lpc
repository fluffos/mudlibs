#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int staub=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "In einer dunklen Hoehle");
  SetProp (P_INT_LONG, "In diesem Teil der Hoehle scheint es keine "
	   +"Wasseradern mehr zu geben. Alles ist relativ trocken. "
	   +"Trotzdem ueberkommt Dich bei dem Klang des leisen Quietschen "
	   +"aus Nordosten ein ungutes Gefuehl. Ein altes Skelett, vermutlich "
	   +"von einem Zwergenarbeiter, liegt in einer verstaubten Ecke und "
	   +"hebt auch nicht unbedingt Deine Stimmung. Zwei Gaenge sind hier "
	   +"zu erkennen. Einer fuehrt nach Norden der andere nach Suedosten.\n");

  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  
  AddDetail(({"gang", "gaenge"}),
	    "Hier gibt es zwei Gaenge. Ein Gang fuehrt nach Norden     "
	    +"und der andere nach Suedosten.\n");
  AddDetail(({"boden", "steinboden", "hoehlenboden"}),
	    "Massiver Fels. Ein typischer Hoehlenboden also.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende sind hart wie Fels. Liegt vermutlich daran, dass "
	    +"sie auch aus Fels sind.\n");  
  AddDetail(({"wasserader", "wasseradern", "ader", "adern", "teil"}),
	    "Es schwint in diesem teil der Hoehle keine Wasseradern mehr zu "
	    +"geben. Deswegen ist es hier auch um einiges trockener als "
	    +"beim Eingang der Hoehle.\n");
  AddDetail(({"eingang"}),
	    "Der Eingang der Hoehle muss irgendwo im Nordwesten liegen.\n");
  AddDetail(({"decke"}),
	    "Die Decke ist aus solidem Fels.\n");
  AddDetail(({"eck", "ecke"}),
	    "In der Ecke liegt ein Skelett, welches vermutlich von einem "
	    +"Zwergenarbeiter stammt.\n");
  AddDetail(("skelett"),
	    "Als Du das Skelett naeher untersuchst faellt Dir auf, dass "
	    +"eine Hand auf eine Platte zeigt.\n");
  AddSpecialDetail(("platte"), "platte_schau");
  AddSpecialDetail(("staub"), "staub_schau");
  AddSpecialDetail(("runen"), "runen_schau");
  AddReadDetail(("runen"),
		"Die Runen und bedeuten folgendes:\n"
		+"'Wer immer dies hier liest ist in grosser "
		+"Gefahr. Ich habe entdeckt, dass hinter einer "
		+"Geheimtuer das Nest einer Ha....'\n"
		+"Ab hier konnte der Verfasser wohl nichts mehr "
		+"schreiben.\n");
  AddDetail(({"fels"}),
	    "Du bist felsenfest davon ueberzeugt, dass dies hier ein"
	    +"sehr massiver Fels ist.\n");;
  AddDetail(({"hoehle", "hoehlen"}),
	    "Du stehst jetzt in einer dunklen, engen Hoehle. Na, hoffentlich "
	    +"hast du keine Platzangst.\n");
  AddDetail(("platzangst"),
	    "Deine Hand scheint eh schon zu zittern. Bist Du sicher das "
	    +"Du keine Platzangst hast?\n");
  AddDetail(("hand"),
	    "Deine Hand zittert tatsaechlich etwas. Liegt wohl an dem Geschoepf, "
	    +"welches da gerade darauf herumkrabbelt.\n");
  AddDetail(("geschoepf"),
	    "Es ist eine kleine Spinne die sich sofort in einen Felsspalt "
	    +"zurueckzieht als Du sie beruehrst.\n");
  AddDetail(("gefuehl"),
	    "Dein Gefuehl sagt Dir, dass hier irgendetwas nicht stimmt.\n");
  AddDetail(({"spinne", "felsspalt"}),
	    "Die Spinne kommt jetzt sicher nicht mehr so schnell aus dem "
	    +"Felsspalt hervor.\n");
  AddDetail(("stimmung"),
	    "Deine Stimmung ist nicht sehr erheitert.\n");
  AddDetail(({"zwergenarbeiter", "arbeiter", "zwerge", "zwerg"}),
	    "Es ist nicht ungewoehnlich, dass Zwerge in dunklen Hoehlen arbeiten.\n");
  
  AddDetail(({"quietschen", "klang"}),
	    "Du kannst ihm ja mal lauschen.\n");
  AddSound(("klang"),
	   "Der Klang des Quietschens stimmt Dich nicht sehr erfreut.\n");
  AddSound(({"quietschen"}),
	   "Das Quietschen muss von einem oder mehreren Geschoepfen stammen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Quietschen aus Nordosten.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "auffaelliges"}),
	    "Du riechst nichts Auffaelliges.\n");
  // DETAILS ENDE

  // EXITS START
  AddExit ("norden", ROOM"nest2");
  AddExit ("suedosten", ROOM"nest4");
  // EXITS END
  
  // COMMANDS START
  AddCmd(({"wisch", "wische"}), "wisch_weg");  
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}


wisch_weg(str)
{
  notify_fail("Was willst Du wegwischen?\n");
  if (!str) return 0;
  if ((str == "staub" || str == "staub weg" || "staub von platte"
      || str == "staub von platte weg"))
    {
      if (staub==1)
	{
	  write(BS("Du wischt den Staub von der Platte weg und "
		   +"entdeckst ein paar Runen.\n"));
	  staub=0;
	  return 1;
	}
      else 
	{
	  write(BS("Das brauchst Du nicht mehr machen.\n"));
	  return 1;
	}
    }
  else return 0;
}


staub_schau()
{
  if (staub==1)
    {
      return(BS("Vielleicht kannst Du den vielen Staub ja von der Platte "
		+"wegwischen.\n"));
    }
  else return(BS("Normaler Staub.\n"));
}     


platte_schau()
{
  if (staub==1)
    {
      return(BS("Die Platte ist von viel Staub verdeckt. Vielleicht kannst "
		+"Du den ja wegwischen.\n"));
    }
  else return(BS("Auf der Platte sind einige Runen die Du vielleicht lesen "
		 +"kannst.\n"));
}

runen_schau()
{
  if (staub==1)
    {
      return(BS("Sowas siehst Du hier nicht.\n"));
    }
  else return(BS("Du koenntest versuchen sie zu lesen.\n"));
}   




reset()
{
  ::reset();
  staub=1;
}









