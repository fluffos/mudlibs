#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int harpyie=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "In einer dunklen Hoehle");
  SetProp (P_INT_LONG, "Du stehst jetzt hinter der Geheimtuer "
	   +"in einem Teil der Hoehle, welcher sich deutlich vom "
	   +"Rest der Hoehle unterscheidet. Das Gestein ist viel "
	   +"heller und es ist auch um einiges waermer. Ein lautes, "
	   +"bedrohliches Quietschen ist aus noerdlicher Richtung zu "
	   +"hoeren. Zudem stinkt es hier nach Tod und Verwesung. "
	   +"Ein Gang fuehrt nach Norden.\n");

  // ROOM DESCRIPTION END;
  

  // DETAILS START;
  
  AddDetail(({"gang"}),
	    "Du siehst hier ein Gang der nach Norden fuehrt.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende sind aus einem sehr hellen Gestein. Sie " 
	    +"sind auch um etliches glatter als normale Hoehlenwaende. "
	    +"In der Westwand muesste irgendwo eine Geheimtuer sein, aber "
	    +"auch an der Ostwand faellt Dir etwas auf.\n");
  AddDetail(("rest"),
	    "Dieser Teil der Hoehle unterscheidet sich deutlich vom "
	    +"Rest der Hoehle.\n");
  AddDetail(({"teil", "hoehle", "teile"}),
	    "Dieser Teil der Hoehle unterscheidet sich deutlich von "
	    +"den vorangegangen Teilen. Alles ist viel heller und wirkt "
	    +"irgendwie kuenstlich.\n");
  AddDetail(("hoehlenwaende"),
	    "Normale Hoehlenwaende sind rauh und zerklueftet. Hier "
	    +"jedoch sind sie ziemlich glatt. Das muss also irgendjemand "
	    +"kuenstlich geschaffen haben.\n");
  AddDetail(("boden"),
	    "Der Boden ist voellig glatt aus einem seltsamen hellen "
	    +"Gestein.\n");
  AddDetail(("decke"),
	    "Die Decke ist auffaellig glatt und aus einem sehr hellen "
	    +"Gestein.\n");
  AddDetail(("gestein"),
	    "Das Gestein aehnelt keinem Gestein welches Du kennst. "
	    +"Das muss jemand kuenstlich geschaffen haben.\n");
  AddDetail(("ostwand"),
	    "Da ist eine kleine gruene Platte.\n");
  AddDetail(("platte"),
	    "Die sieht aus als koennte man sie bewegen. "
	    +"Vielleicht solltest Du einfach mal draufdruecken.\n");
  AddDetail(({"geheimtuer", "westwand", "tuer", "tuere", "geheimtuere"}),
	    "Eigentlich sieht man es der Westwand ueberhaupt nicht an, "
	    +"dass da eine Geheimtuer sein soll. Nirgends sind Ritzen "
	    +"oder Fugen zu sehen.\n");
  AddDetail(({"fugen", "ritzen"}),
	    "Du siehst keine Ritzen oder Fugen. Das geht wohl nicht mit "
	    +"rechten Dingen zu.\n");
  AddDetail(("quietschen"),
	    "Du hoerst es jetzt schon sehr deutlich.\n");
  AddSound(("quietschen"),
	   "Das Quietschen aus noerdlicher Richtung ist ohrenbetaeubend "
	   +"und scheint sehr nahe zu sein. Der Klang jagt Dir einen "
	   +"Schauer ueber den Ruecken.\n");
  AddDetail(({"ruecken", "schauer"}),
	    "Dir laeuft ein richtiger Schauer bei dem Klang des "
	    +"Quietschens ueber den Ruecken.\n");
  AddSound(("klang"),
	   "Der Klang des Quietschens ist wahrlich ohrenbeteubend.\n");
  AddDetail(("richtung"),
	    "Das solltest Du eigentlich selber wissen.\n");
  AddDetail(("dinge"),
	    "Mit rechten Dingen kann es hier sicher nicht zugehen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein lautes Quietschen aus Norden.\n");
  AddSmell(("luft"),
	   "Die Luft riecht unangenehm suesslich hier.\n");
  AddDetail(({"luft", "duft"}),
	    "Riech mal.\n");
  AddDetail(({"tod", "verwesung"}),
	    "Du kannst Tod und Verwesung hier ziemlich deutlich "
	    +"riechen.\n");
  AddSmell(({"verwesung", "tod"}),
	   "Ihhh, dein Magen rumort schon recht auffaellig.\n");
  AddDetail(({"magen"}),
	    "Viel mehr von dem Gestank würdest Dein Magen sicher "
	    +"nicht mehr vertragen.\n");
  AddDetail(("gestank"),
	    "Das wahr wohl zuviel fuer Deinen Magen. Du uebergibst "
	    +"Dich herzhaft.\n");
  AddSmell(("gestank"),
	   "Du wirst ploetzlich ganz gruen und uebergibst Dich "
	   +"herzhaft.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier nach Tod und Verwesung.\n");
  // DETAILS ENDE
  
  // EXITS START
  AddSpecialExit (("norden"), "norden_exit");
  // EXITS END
  
  // COMMANDS START
  AddCmd(({"drueck", "druecke"}), "druecke_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}


druecke_was(str)
{
  notify_fail("Was willst Du druecken?\n");
  if (!str) return 0;
  if ((str == "platte" || str == "auf platte" || 
       str == "auf platte drauf")) 
    {
      write(BS("Du drueckst die Platte und wirst ploetzlich von der "
	       +"Westwand regelrecht eingesaugt und wieder ausgespuckt.\n"));
      TP->move(ROOM"nest2", M_GO, 0, 
	       "ist ploetzlich weg", "wird hereingeschleudert");
      return 1;
    }
  else return 0;
}


norden_exit()
{
  write("Da is no nix.\n");
  return TP->move(ROOM"harpyiennest", M_GO, 0,
		  "geht nach Norden", "kommt an");
}

stecke_was(str)
{
  notify_fail("Was willst Du wohin stecken?\n"); 
  if (!str) return 0;
  else return 1;
}

reset()
{
  ::reset();
  harpyie=1;
}  

















