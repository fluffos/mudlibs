#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int loch=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_NAME, "waghalsiger Kletterausflug");
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Auf einer kleinen Plattform.");
  SetProp (P_INT_LONG, "Du stehst jetzt auf einer kleinen Plattform. Es ist "
	   +"kuehl und windig hier oben. Vor Dir ragt eine maechtige Felswand "
	   +"auf die nicht mal ein geuebter Bergsteiger erklettern wuerde. "
	   +"Mehrere Buesche stehen am Rand der Plattform und direkt an der "
	   +"Wand. Ein seltsames Geraeusch ist aus der Richtung der "
	   +"Felswand zu hoeren.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
 
  AddDetail(({"plattform", "form"}),
	    "Du stehst jetzt auf einer kleinen Plattform im Gebirge.\n");
  AddDetail(("gebirge"),
	    "Naja, einen normales Gebirge eben. Mit Bergen und so.\n");
  AddDetail(({"richtung", "hin-richtung"}),
	    "Na hoffentlich erwartet Dich hier keine Hin-Richtung.\n");
  AddDetail(("himmel"),
	    "Hoch ueber Dir erstreckt sich der riesige Himmel. Ob Du ihn "
	    +"wohl jemals erreichen wirs?\n");
  AddDetail(("bergsteiger"),
	    "Selbst erfahrene und geuebte Bergsteiger wuerden vor dieser "
	    +"Felswand halt machen.\n");
  AddDetail(({"boden", "felsboden"}),
	    "Harter Felsboden.\n");
  AddDetail(({"felsen", "fels"}),
	    "Hier ist ein sehr harter Fels.\n");
  AddDetail(("rand"),
	    "Auch am Rand der Plattform wachsen einige Buesche.\n");
  AddDetail(({"berg", "berge"}),
	    "Hoch, hart, steil, gewaltig, maechtig, erfurchtsgebietend. All das "
	    +"sind die Berge.\n");
  AddDetail(({"wind"}),
	    "Er fluestert Dir etwas zu. Lausche ihm!\n");
  AddSound(("wind"),
	   "Der Wind fluestert: Hier ist sicher was im Busch!\n");
  AddDetail(({"wand", "felswand"}),
	    "Eine steile, hoch aufragende Felswand. Selbst geuebte Bergsteiger wuerden "
	    +"diese Wand nicht beklettern wollen. Am Fuss der Felswand sind mehrere "
	    +"Buesche.\n");
  AddDetail(({"buesche"}),
	    "Hier sind mehrere struppige verwahrloste Buesche. Aus einem Busch hoerst Du "
	    "ein seltsames Geraeusch.\n");
  AddSpecialDetail(("busch"), "busch_schau");
  AddSpecialDetail(({"zweige", "zweig"}), "zweige_schau");
  AddSpecialDetail(({"loch"}), "loch_schau");
  AddSound(({"felswand", "wand"}),
	   "Das Geraeusch kommt von einem der Buesche. Den solltest Du genauer untersuchen.\n");
  
  AddSound(({"geraeusch"}),
	   "Es hoert sich ziemlich bedrohlich an und kommt aus einem Busch.\n");
  AddSound( DEFAULT_SOUND,
	    "Ein seltsames Geraeusch ist aus Richtung der Felswand zu hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Ein unangenehmer Geruch kommt aus Richtung der Felswand. Da scheint irgendwas "
	    +"zu sein.\n");
  // EXITS START
  AddExit ("runter", ROOM"nest1.lpc");
  
  // EXITS END

  // COMMANDS START
  AddCmd(({"biege", "bieg"}), "biege_was");
  AddCmd(({"zwaenge", "zwaeng"}), "zwaenge_durch");
  AddCmd(({"klettere", "kletter"}), "kletter_auf");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

loch_schau()
{
  if (loch==0)
    {
      return ("Sowas siehst Du da nicht!\n");
    }
  else
    {
      return("Ein dunkles Loch durch das man sich sicher durchzwaengen kann. Was wohl "
	     +"dahinter ist?\n");
    }
}   

busch_schau()
{
  if (loch==0)
    {
      return ("Ein kleiner struppiger Busch. Hinter ihm scheint irgendetwas zu sein. "
	      +"Vielleicht koennte man ja die Zweige auseinanderbiegen.\n");
    }
  else
    {
      return("Ein kleiner struppiger Busch. Die Zweige von ihm wurden auseinandergebogen "
	     +"und geben so ein Loch in der Felswand frei.\n");
    }
}

zweige_schau()
{
  if (loch==0)
    {
      return ("Die Zweige des Busches sind sehr dicht. Aber man koennte "
	      +"trotzdem versuchen sie auseinander zu biegen.\n");
    }
  else
    {
      return("Die dichten Zweige des Busches wurden auseinandergebogen "
	     +"und geben jetzt den Blick auf ein Loch .\n");
    }
}


zwaenge_durch(str)
{
  notify_fail("Durch was Du Dich zwaengen?\n");
  if (!str) return 0;
  if ((str == "durch loch" || str == "in loch" || str == "loch"))
    {
      if (loch==0)
	{
	  write("Sowas siehst Du hier nicht.\n");
	  return 1;
	}
      else
	{
	  write("Du zwaengst Dich durch das Loch ins Unbekannte.\n");
          TP->move(ROOM"nest1",M_TPORT);
	  return 1;
	}
    }
  else return 0;
}

biege_was(str)
{
  notify_fail("Was willst du auseinanderbiegen?\n");
  if (!str) return 0;
  if ((str == "zweige" || str == "zweige auseinander"))
    {
      if (loch==0)
	{
	  write("Du biegst die Zweige des Busches auseinander und ein "
		+"Loch in der Felswand kommt zum Vorschein.\n");
	  loch=1;
	  return 1;
	}
      else
	{
	  write("Die Zweige sind ja schon auseinandergebogen worden.\n");
          return 1;
	}
    }
  else return 0;
}

kletter_auf(str)
{
  notify_fail("Wo willst Du hinaufklettern?\n");
  if (!str) return 0;
  if ((str == "auf wand" || str == "auf felswand" || str == "wand" 
       || str=="felswand" || str == "wand hinauf" || str == "felswand hinauf"
       || str=="auf wand hinauf" || str =="auf felswand hinauf"))
    {
      write("Du willst doch nicht ernsthaft diese gefaehrliche Felswand "
	    +"besteigen? Wenn doch tippe <klettere waghalsig auf felswand>.\n"); 
      return 1;
    }
  if (str == "waghalsig auf felswand")
    {
      write("Du versuchst die Felswand zu erklimmen doch rutschtst ab, faellst und "
	    +"verletzt Dich.\n");
      TP->do_damage(random(100));
      return 1;
    }
  else return 0;
}


reset()
{
  loch=0;
}























