#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int kralle=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "In einem eingestuerzten Gang");
  SetProp (P_INT_LONG, "In diesem Gang ist kein weiterkommen mehr moeglich. "
	   +"Die Decke muss vor einiger Zeit schon heruntergekommen sein. "
	   +"Grosse Felsbrocken liegen auf einem grossen Haufen uebereinander "
	   +"und blockieren den kompletten Gang. Von dem beunruhigenden "
	   +"Quietschen ist kaum noch etwas zu hoeren und zudem ist es hier "
	   +"staubtrocken. Von hier kannst Du nur noch zurueck nach Nordwesten.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  
  AddDetail(({"gang", "gaenge"}),
	    "Du befindest Dich hier in einem Gang der schon vor einiger "
	    +"Zeit eingestuerzt sein muss.\n");
  AddDetail(({"boden", "steinboden", "hoehlenboden"}),
	    "Der Boden und ist von Schutt und Gesteinsbrocken uebersaeht.\n");
  AddDetail(("schutt"),
	    "Dieser Schutt duerfte einmal zur Decke gehoert haben.\n");
  AddDetail(({"gesteinsbrocken", "brocken", "bestandteil"}),
	    "Die vielen Gesteinsbrocken die da am Boden herumliegen, duerften "
	    +"einstmal Bestandteil der Decke gewesen zu sein.\n");
  AddDetail(({"felsbrocken", "betrachtung", "menge"}),
	    "Es ist eine stattliche Menge an Felsbrocken die sich "
	    +"hier angehaeuft hat. Eine Stelle kommt Dir bei genauerer "
	    +"Betrachtung seltsam vor.\n");
  AddDetail(({"stelle", "art"}),
	    "Da scheint eine Art Fuss zwischen den Felsbrocken hervorzuragen.\n");
  AddSpecialDetail(("fuss"), "fuss_schau");
  AddDetail(({"wand", "waende", "auffaelliges", "teilen", "gegensatz"}),
	    "An den Waenden kannst Du nichts Auffaelliges entdecken. Einzig, dass sie "
	    +"im Gegensatz zu den vorhergehenden Teilen der Hoehle staubtrocken sind.\n");
  AddDetail(("hoehle"),
	    "Du bist jetzt in ein einer dunklen, engen Hoehle.\n");
  AddDetail(("haufen"),
	    "Da hat sich ein grosser Haufen an grossen Felsbrocken angesammelt.\n");
  AddDetail(({"decke", "teile"}),
	    "Die Decke muss vor einiger Zeit bereits eingestuerzt sein. Jetzt blockieren die "
	    +"herabgefallen Teile den Gang und verhindern so jedes Weiterkommen.\n");
  AddDetail(("weiterkommen"),
	    "Hier gibts kein Weiterkommen.\n");
  AddDetail(("zeit"),
	    "Muss schon eine Zeit lang her sein.\n");
  AddDetail(({"quietschen"}),
	    "Du kannst ja versuchen dem Quietschen zu lauschen.\n");
  AddDetail(("wesen"),
	    "Ein vogelaehnliches Wesen, was konnte das bloss sein.\n");
  AddSound(({"quietschen"}),
	   "Das Quietschen ist kaum noch zu hoeren, scheint aber von Norden "
	   +"zu kommen.\n"); 
  AddSpecialDetail(("kralle"), "kralle_schau");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein ganz leises Quietschen von Norden.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "auffaelliges"}),
	    "Du riechst nichts Auffaelliges.\n");
  // DETAILS ENDE
  
  // EXITS START
  AddExit ("nordwesten", ROOM"nest3");
  // EXITS END
  
  // COMMANDS START
  AddCmd(({"breche", "brich"}), "brich_ab");  
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}


kralle_schau()
{
  if (kralle==1)
    {
      return("Die Kralle haengt lose von dem Fuss herunter. Die koennte "
	     +"man sicher leicht abbrechen.\n");
    }
  else return("Du siehst hier keine Kralle.\n"); 
}

fuss_schau()
{
  if (kralle==1)
    {
      return("Das scheint der Fuss eines vogelaehnlichen Wesens zu sein. "
	     +"Eine Kralle haengt lose von dem Fuss herunter. Die koennte "
	     +"man sicher leicht abbrechen.\n");
    }
  else return("Das scheint der Fuss eines vogelaehnlichen Wesens zu sein.\n");
}




brich_ab(str)
{
  notify_fail("Was willst Du abbrechen?\n");
  if (!str) return 0;
  if ((str == "kralle" || str == "kralle weg" || "harpyienkralle"
      || str == "harpyienkralle ab"))
    {
      if (kralle==1)
	{
	  write(BS("Du brichst die Kralle ab und steckst sie ein.\n"));
	  // Kralle spieler clonen
	  kralle=0;
	  return 1;
	}
      else 
	{
	  write(BS("Da ist keine Kralle zu sehen.\n"));
	  return 1;
	}
    }
  else return 0;
}

reset()
{
  ::reset();
  kralle=1;
}









