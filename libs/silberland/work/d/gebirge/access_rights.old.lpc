#include <wizlevels.h>
#include <properties.h>

#ifdef DEBUG
#undef DEBUG
#endif
#undef DEBUG   "iwo"

#define LORDS ({ "iwo" })
#define INFORM "iwo"

inherit "/std/thing";
inherit "/std/container/restrictions";

// Function prototypes
void reload_data();
int access_rights(string name, string file, int readflag, int def);
string _query_int_short();
string int_long();
string invlist(object who, object *inv);

// Global variables
private mapping access_rights = ([]);
private nosave string mydomain = "";

void create()
{
  if (is_clone(this_object())) return;

  mydomain = upperstring(explode(file_name(this_object()), "/")[1]);

  ::create();
  
  SetProp(P_INT_SHORT, sprintf("Zugriffskontrollraum fuer %s",mydomain));

  seteuid(getuid());
  reload_data();

  AddCmd(({"add"}), "addright");
  AddCmd(({"show"}), "showrights");
  AddCmd(({"del"}), "delright");
  AddCmd(({"store"}), "store");
  AddCmd(({"selbstmord"}), "suicide");
}

nosave int suicide()
{
  SetProp(P_KILL_NAME, "Selbstmord");
  SetProp(P_KILL_MSG, "Das ist doch keine Loesung, %s!");
  this_player()->SetProp(P_WANTS_TO_LEARN, 0);
  this_player()->die();
  return 1;
}

nosave int showrights(string str)
{
  string * members, * dirs;
  string outstr, hstr;
  int i,ii;

  outstr = hstr = "";

  if (find_player(INFORM))
    tell_object(find_player(INFORM), break_string(
      sprintf("show %O (%O:<%O>)", str, this_player(), this_interactive()),
      78, sprintf("%s ACCESS CONTROL: ", mydomain)));


  if (!str || str=="")
    {
      outstr += "Uebersicht der Berechtigungen:\n";
      outstr += "------------------------------\n";    
      members = m_indices(access_rights);

      for (i=0;i<sizeof(members);i++)
        {
	  dirs = m_indices(access_rights[members[i],0]);
	  
	  for (ii=0;ii<sizeof(dirs);ii++)
	    dirs[ii] += sprintf("(%s)",access_rights[members[i],0][dirs[ii],0]);
	
	  outstr += sprintf("%=12.15-s: %=65-s\n", 
	    members[i], implode(dirs, ", "));
	}
  
      this_player()->More(outstr);
      
      return 1;

    }
    
  notify_fail(sprintf("Kein Eintrag fuer '%s' gefunden.\n", str));
  if (!member(access_rights, str)) return 0;
  
  outstr = sprintf("Berechtigungen fuer '%s':\n", str);
  outstr+= sprintf("%'-'*s\n",strlen(outstr),"");
    
  members = m_indices(access_rights[str,0]);
  for (i=0;i<sizeof(access_rights[str,0]);i++)
    hstr += sprintf("%=3-s%=60-s\n", access_rights[str,0][members[i],0], members[i]);

  outstr += sprintf("%=12.15-s: %=65-s\n", str, hstr);
    
  this_player()->More(outstr);
  
  return 1;  
}

int store()
{
  if(save_object(explode(file_name(this_object()),"#")[0]));
    tell_object(this_player(), "Configuration stored.\n");
  return 1;
}

nosave int delright(string str)
{
  string who,where,what;

  str = this_player()->_unparsed_args();

  if (!str) str = "";

  if (find_player(INFORM))
    tell_object(find_player(INFORM), break_string(
      sprintf("del %O (%O:<%O>)", str, this_player(), this_interactive()),
      78, sprintf("%s ACCESS CONTROL: ", mydomain)));

  notify_fail("Kein Zugriff!\n");
  if (this_player() != this_interactive()) return 0;
  if (member(LORDS, getuid(this_player()))==-1 && !IS_ARCH(this_player())) return 0;

  notify_fail("Usage: del <name>|* [<file>|<directory>]\n");
  if (sscanf(str, "%s %s", who, where)!=2 &&
      sscanf(str, "%s", who)!=1) return 0;

  notify_fail(sprintf("Kein eintrag fuer '%s'.\n", who));
  if (!member(access_rights, who)) return 0;

  if (!where || where=="")
    {
      notify_fail("Couldn't substract from access_rights!\n");
      if (access_rights -= ([ who ]))
        tell_object(this_player(), 
	  sprintf("Benutzer '%s' geloescht.\n", who));
      else return 0;
      return 1;
    }

  notify_fail(sprintf("Kein Eintrag '%s' fuer Benutzer %s\n", where, who));
  if (!member(access_rights[who,0], where)) return 0;

  notify_fail("Couldn't substract from access_rights (2)!\n");
  if (access_rights[who,0] -= ([ where ]))
    tell_object(this_player(), 
      sprintf("Rechte fuer '%s' auf '%s' entfernt.\n",who,where));
  else return 0;

  if (sizeof(access_rights[who,0])<=0)
    {
      notify_fail("Substract from access_rights failed!\n");
      if (access_rights -= ([ who ]))
        tell_object(this_player(),
	  sprintf("Benutzer '%s' entfernt.\n", who));
      else return 0;
    }
    
  return 1;
}



nosave int addright(string str)
{
  string who,where,what;

  str = this_player()->_unparsed_args();

  if (!str) str = "";

  if (find_player(INFORM))
    tell_object(find_player(INFORM), break_string(
      sprintf("add %O (%O:<%O>)", str, this_player(), this_interactive()),
      78, sprintf("%s ACCESS CONTROL: ", mydomain)));

  notify_fail("Kein Zugriff!\n");
  if (this_player() != this_interactive()) return 0;
  if (member(LORDS, getuid(this_player()))==-1 && !IS_ARCH(this_player())) return 0;

  notify_fail("Usage: add <name>|* <file>|<directory> r|w|worldwriteable\n");
  if (sscanf(str, "%s %s %s", who, where, what)!=3) return 0;

  if (lowerstring(what) != "w" && lowerstring(what) != "r" 
      && lowerstring(what) != "worldwriteable" 
      && lowerstring(what) != "x") return 0;
  
  if (who=="*")
    if (lowerstring(what) == "w")
    {
      tell_object(this_player(), "!WARNING! WORLD WRITEABLE ENTRY REJECTED!\n");
      return 1;
    }
    else if (lowerstring(what) == "worldwriteable")
           {
             tell_object(this_player(), "WORLD WRITEABLE ENTRY CERATED - VERIFY!!!\n");
             what = "w";
           }
         else
           tell_object(this_player(), "!WARNING! WORLD READABLE ENTRY!\n");
  
  
  if (!member(access_rights, who))
    access_rights += ([who: ([where: what,]),]);
  else
    access_rights[who, 0] += ([where: what,]);

  tell_object(this_player(), sprintf("%s: %O\n",who, access_rights[who,0]));

    
  return 1;
}

/*
mixed QueryProp(string str)
{
  if (!stringp(str)||str=="") return 0;
  return call_other(this_object(), "_query_"+str);
}
*/
string _query_int_short()
{
  return sprintf("Im Zugriffskontrollraum fuer die Region %s\n",
    mydomain);
}


string int_long()
{
  string outstr;
  
  outstr = "";
  if (IS_LEARNER(this_player()) && this_player()->QueryProp(P_WANTS_TO_LEARN))
    outstr  += sprintf("[%s|uid:%s:%s]\n",
      file_name(this_object()),
      getuid(this_object()),
      geteuid(this_object())); 
  outstr += sprintf("Im Zugriffskontrollraum fuer die Region %s\n\n",
    mydomain);

  outstr += "Kommandos:\n";
  outstr += "  add <name>|* <file>|<directory> r|w|x|worldwriteable*\n";
  outstr += "  del <name>|* [<file>|<directory>]\n";
  outstr += "  show\n";
  outstr += "\n* Grossbuchstaben setzten rekursive Rechte.\n";
  outstr += "\nBenutzerrechte gehen vor allgemeinen('*') Rechten.\n";
  outstr += "File-Rechte gehen vor Verzeichnisrechte.\n";
  outstr += "Rekursivrechte werden nur angewendet wenn kein anderes\n";
  outstr += "Recht zutrifft.\n";
  outstr += "Dadurch ergibt sich, dass auch Auschlussrechte ('x') \n";
  outstr += "vergeben werden koennen.\n"; 
  outstr += "Es gibt einen sichtbaren Ausgang: Selbstmord.\n";
  outstr+=invlist(this_player(), all_inventory(this_object()));
  
  return outstr;
}

private nosave string invlist(object who, object *inv)
{
  int i, iswiz;
  string descr;
  
  descr="";
  iswiz = IS_LEARNER(who) && who->QueryProp(P_WANTS_TO_LEARN);
  
  for (i=0;i<sizeof(inv);i++)
    {
      string sh;
      if (inv[i]==who) continue;
      sh = inv[i]->short();
      if (iswiz)
        {
	  if (sh) sh=sh[0..<2]+" ["+file_name(inv[i])+"]\n";
	  else sh = "["+file_name(inv[i])+"]\n";
        }
      if (sh) descr += sh;
      
    }
  return descr;
}


private nosave void reload_data()
{
  restore_object(explode(file_name(this_object()),"#")[0]);
}

int access_rights(string name, string file, int readflag, int def)
{
  string *s;
  string dir, *dirs;
  string access_type;
  int n,i;

  mapping mm;

#ifdef DEBUG
  if (find_player(DEBUG))
    tell_object(find_player(DEBUG),
        sprintf(" * ebene::access_rights: %O - %O - %O - %O\n",
          name,file,readflag,def));
#endif

  s = explode(file, "/");
  dir = implode(s[0..<2], "/");



  // OK, first check user rights (order file, dir)
  if (member(access_rights, name))
    if (member(access_rights[name,0],file)) // File
      access_type = access_rights[name,0][file,0];
    else if (member(access_rights[name,0],dir)) // Directory
      access_type = access_rights[name,0][dir,0];
    else if (member(access_rights[name,0],"*"))
      access_type = access_rights[name,0]["*",0]; // Global user right

  // If we don't have user rights look for recursive user rights      
  if (!access_type && member(access_rights, name))
    {
      dirs = m_indices(access_rights[name,0]);
      for (i=0;i<sizeof(dirs);i++)
        if(strstr("RWX",access_rights[name,0][dirs[i],0])!=-1 
	  && strstr(file,dirs[i], 0)!=-1)
	  { 
	    access_type = access_rights[name,0][dirs[i],0];
	    break;
	  }
    }   

  // If there's no user right now we go for global ones ('*')
  if (!access_type && member(access_rights, "*"))
    if (member(access_rights["*",0],file)) // File
      access_type = access_rights["*",0][file,0];
    else if (member(access_rights["*",0], dir)) // Directory
      access_type = access_rights["*",0][dir,0];
    else
      {
        // If we still got no access let's compare file to global
        // recursive rights
        dirs = m_indices(access_rights["*",0]);
        for (i=0;i<sizeof(dirs);i++)
          if(strstr("RWX",access_rights["*",0][dirs[i],0])!=-1 
	    && strstr(file,dirs[i], 0)!=-1)
	    { 
	      access_type = access_rights["*",0][dirs[i],0];
	      break;
	    }
      }
 

  // File has any entry?
  if (!access_type || access_type == "" || lowerstring(access_type) == "x")
    {
      if (lowerstring(access_type) != "x") return def;

#ifdef DEBUG
      if (find_player(DEBUG))
        tell_object(find_player(DEBUG),
	  sprintf("Zugriff verweigert - Name: %s, File: %s, Read: %d, Def: %d\n",
	    name, file, readflag, def));
#endif
      return 0;
    }



  // safety
  if (lowerstring(access_type) != "w" 
      && lowerstring(access_type) != "r") return 0;
  
  // Write attempt on read only file
  if (lowerstring(access_type) != "w" && !readflag)
    {
      tell_object(find_player(name), 
        sprintf("Schreibzugriff auf %s verweigert.\n", file));
#ifdef DEBUG
      tell_object(find_player(DEBUG),
        sprintf("Nowrite: Name: %s, File: %s, Type: %s\n",
	  name, file, access_type));
#endif
      return 0;
    }
  return 1;
}


void init()
{
  ::init();
  if (this_player() && this_player()->QueryProp(P_INVIS))
    tell_room(this_object(), sprintf("(%s) betritt den Raum.\n", capitalize(getuid(this_player()))));
}