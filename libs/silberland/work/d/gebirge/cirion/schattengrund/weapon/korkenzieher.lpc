#include "../schattengrund.h"

inherit "std/weapon";

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Korkenzieher");
  SetProp(P_LONG,
    "Das ist ein wirklich edler Korkenzieher, sein Griff ist aus einem "
    "dunklen, roetliche Holz gefertigt, waehrend die metallenen Windungen "
    "aus einem fast schwarzen Metall sind." );
  SetProp(P_NAME, "Korkenzieher");
  SetProp(P_GENDER, MALE);
  AddId( ({"korkenzieher", "korkendreher"}) );

  AddDetail(({"griff"}),
    "Der Griff des Korkenzieher ist aus einem dunklen, roetliche Holz "
    "gefertigt und kunstvoll mit wunderschoenen, geschnitzten Mustern "
    "verziert.");
  AddDetail(({"muster","schnitzereien","schnitzerei","weinreben","weinrebe",
              "reben","rebe"}),
    "Die Schnitzereien stellen Weinreben dar, die sich um ein kleines Wappen "
    "ranken.");
  AddDetail(({"wappen"}),
    "Es handelt sich um das Wappen derer vom Schattengrund, blabla"/*DADA*/);
  AddDetail(({"schattengrund"}),
    "Der Schattengrund ist ein kleines, verstecktes Gebirgstal");
  AddDetail(({"tal","gebirgstal","gebirge"}),
    "Das musst Du schon selbst aufsuchen.");
  AddDetail(({"holz"}),
    "Der Griff des Korkenziehers ist aus einem dunklen, roetlichen Holz, das "
    "ziemlich hart zu sein scheint. Ein wirklich edles Material.");
  AddDetail(({"material"}),
    "Welches Material, das Holz, oder das Metall?");
  AddDetail(({"windungen","windung"}),
    "Die Windungen des Korkenziehers sind aus einem dunklen, fast schwarzen "
    "Metall gefertigt.");
  AddDetail(({"metall"}),
    "Die Windungen sind aus einem dunklen, fast schwarzen Metall gefertigt, "
    "welches das Licht zu absorbieren scheint. Es scheint ziemlich hart zu "
    "sein. Ein wahrhaft edles Material.");
  AddDetail(({"licht"}),
    "Das Licht wird scheinbar von dem dunklen Metall absorbiert.");
      
  SetProp(P_WEAPON_TYPE, WT_MISC );
  SetProp(P_WC, 35);
  SetProp(P_DAM_TYPE, DT_RIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:50,MAT_MISC_WOOD:50]) );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 500);
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_WC_FIXFACTOR, 0.8 );
}