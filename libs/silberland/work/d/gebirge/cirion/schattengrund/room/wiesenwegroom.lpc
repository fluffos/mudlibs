#include "/d/gebirge/cirion/schattengrund/schattengrund.h"

inherit "std/room";

int hagebutten;

void create()
{
  ::create();
  hagebutten=1+random(3);
  SetProp(P_INT_SHORT,"Ein Weg durch die Wiesen");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);

  AddDetail(({"tal"}),
    "Dieser Tal hier, umgeben von steilen und hohen Bergen muss wohl der "
    "beruehmte Schattengrund sein.");
  AddDetail(({"schattengrund","adelssitz"}),
    "Der Schattengrund ist der Adelssitz derer vom Schattengrund, wie der "
    "Name schon sagt.");
  AddDetail(({"name"}),
    "Der Name dieses Tals ist Schattengrund.");
  AddDetail(({"berge","berg"}),
    "Rund um das Tal herum liegen hohe Berge mit schneebedeckten Gipfeln. "
    "Sicher sind sie schwer zu erklimmen, daher ist der Pass im Sueden der "
    "einzige Weg, der ins Tal fuehrt.");
  AddDetail(({"gipfel"}),
    "Viele Gipfel siehst Du rund um das Tal, alle sehr hoch und schneebeckt.");
  AddDetail(({"pass"}),
    "Im Sueden ist ein Pass ueber die Berge, der aus dem Tal herausfuehrt.");
  SetProp(P_INT_LONG,
    "Du stehst auf einem von Bueschen gesaeumten Feldweg, der hier mitten "
    "durch die bluehende bunte Wiesen und reifende Felder fuehrt. In "
    "einigen Abstaenden stehen auch immer mal wieder Baeume am Wegesrand. "
    "Der Weg selbst ist teils grasbewachsen "
    "und breit genug, um einem Fuhrwerk Platz zur Durchfahrt zu gewaehren.");
  AddDetail(({"busch","buesche"}),
    "Dichte, gruene Buesche wachsen seitlich des Weges, an einigen kannst "
    "Du reife Hagebutten erkennen, andere sind stachelig und dornig.");
  AddSpecialDetail(({"hagebutte","hagebutten"}),
    "hagebutten_fun");
  AddDetail(({"weg","feldweg","boden","fuhrwerk","platz","durchfahrt"}),
    "Der Feldweg ist mit Gras bewachsen und hie und da mit Steinen bedeckt. "
    "Er ist gerade so breit, dass ein Fuhrwerk darauf bequem entlangfahren "
    "kann.");
  AddDetail(({"gras"}),
    "Saftiges, gruenes Gras waechst in der Mitte des Weges.");
  AddDetail(({"stein","steine"}),
    "Kieselgrosse Steine liegen auf dem Weg herum.");
  AddDetail(({"wiese","wiesen"}),
    "Rundum liegen bluehende Wiesen, auf denen Kuehe und Schafe weiden.");
  AddDetail(({"kuh","kuehe","schaf","schafe"}),
    "Kuehe und Schafe weiden auf den weiten, bunt bluehenden Wiesen.");
  AddDetail(({"felder","feld"}),
    "Auf den Felder steht das goldene, reifende Getreide schon ziemlich "
    "hoch, bald ist sicher Erntezeit.");
  AddDetail(({"getreide"}),
    "Unterschiedliches Getreide waechst auf den Feldern und ist schon "
    "fast erntereif.");
  AddDetail(({"erntezeit"}),
    "Bald ist sicher Erntezeit.");
  AddDetail(({"baum","baeume","obstbaeume","obstbaum"}),
    "In einigen Abstaenden stehen am Wegesrand Birken, Buchen und auch "
    "Obstbaeume mit leckeren Aepfeln oder Birnen daran. Leider hast Du "
    "keine Idee, wie Du das Obst herunterbringen sollst.");
  AddDetail(({"birke","birken"}),
    "Die Birken sind etwas kleinere Baeume mit silberweisser Rinde und "
    "kleinen Blaettchen.");
  AddDetail(({"buche","buchen"}),
    "Die Buchen sind grosse, schlanke Baeume mit weiten Kronen.");
  AddDetail(({"krone","kronen"}),
    "Die Kronen der Buchen sind hoeher und groesser, als die der anderen "
    "Baeume, und tiefgruen.");
  AddDetail(({"blaettchen"}),
    "Die Blaettchen der Birken sind klein und hellgruen.");
  AddDetail(({"obst","aepfel","birnen","apfel","birne"}),
    "Das haengt zu hoch, um es zu pfluecken.");
  AddDetail(({"rinde"}),
    "Die Rinde der Birken ist silberweiss.");
  AddDetail(({"silberland","welt"}),
    "Das Silberland ist die wunderschoene Welt, in der Du Dich momentan "
    "befindest.");
  AddDetail(({"cirion","schoepfer"}),
    "Cirion ist der Schoepfer dieses Tals.");

  AddCmd(({"pflueck","pfluecke"}),"pflueck_fun");
}

reset()
{
  ::reset();
  hagebutten=1+random(3);
}

string hagebutten_fun(string detail)
{
  switch (detail)
  {
    case "hagebutte":
    case "hagebutten":
      if (hagebutten==0)
        return "Da sind nicht mehr so viele Hagebutten.\n";
      else
        return "Einige, schoene, reife Hagebutten. Vielleicht "
               "kann man die pfluecken?\n";
      break;
  }
}

int pflueck_fun(string str)
{
  notify_fail("Was moechtest Du pfluecken?");
  if (-1==member(({"hagebutte","hagebutten"}),str))
    return 0;
  if (hagebutten==0)
  {
    write(BS(
      "Da sind nur noch wenige Hagebutten, die laesst Du lieber haengen."));
    return 1;
  }
  else
  {
    hagebutten--;
    write(BS("Du pflueckst Dir eine der reifen Hagebutten."));
    clone_object("/d/huegelland/raballion/hobbits/obj/hagebutte")->move(TP,M_GET);
    return 1;
  }
}