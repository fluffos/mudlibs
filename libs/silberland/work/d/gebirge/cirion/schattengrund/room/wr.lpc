#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/gebirge/cirion/schattengrund/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Neuer Raum");
  SetProp(P_INT_LONG,
    "Der Weg fuehrt mitten durch einen grossen, verschneiten Garten hindurch "
    "geradewegs auf das alte, graue Herrenhaus zu. Rechts und links des Weges "
    "wachsen verschneite Rosenhecken, und direkt vor dem Haus, auf einem "
    "kleinen runden Vorplatz steht ein Springbrunnen, der allerdings jetzt "
    "im Winter nur mit Schnee gefuellt ist. Das Herrenhaus erhebt sich "
    "dahinter alt und ehrwuerdig, es scheint fast, als wuerde es schon seit "
    "Anbeginn der Zeit hier stehen.");
  // ROOM DESCRIPTION END
  AddDetail ( ({"schattengrund","tal"}),
    "Das Tal hier nennt sich Schattengrund, denn es ist der Stammsitz "+
    "derer von Schattengrund.");
  AddDetail ( ({"sitz", "stammsitz"}),
    "Das bedeutet, dass die von Schattengrund in diesem Tal schon seit "+
    "langer Zeit leben.");
  AddDetail ( ({"grenze", "grenzen"}),
    "Die Grenzen des Schattengrundes sind die umliegenden, hohen Berge.");
  AddDetail ( ({"berg", "berge"}),
    "Hohe Berge umschliessen das Tal wie einen Guertel und trennen es von "+
    "der Aussenwelt ab. Einzig ein schmaler Pass im Sueden erlaubt, das Tal "+
    "zu betreten oder zu verlassen.");
  AddDetail ( ({"pass"}),
    "Im Sueden fuehrt ein schmaler Pass ueber das Gebirge aus dem Tal "+
    "heraus.");
  AddDetail ( ({"guertel"}),
    "Wie ein Guertel liegt das Gebirge um das Tal.");
  AddDetail ( ({"gebirge"}),
    "Rund um das Tal erstreckt sich das weite Gebirge mit seinen vielen "+
    "hohen Bergen.");
  AddDetail ( ({"aussenwelt", "silberland", "welt"}),
    "Die Aussenwelt ist das Silberland.");

  // DETAILS START
  AddDetail ( ({"jahreszeit", "winter"}),
    "Die jetztige Jahreszeit mit ihrem Schnee und ihrer Kaelte nennt sich "+
    "Winter.");
  AddDetail ( ({"kiesweg", "weg"}),
    "Der schmale Kiesweg ist voellig verschneit, er fuehrt zwischen den "+
    "zwei verschneiten Rosenhecken hindurch genau auf das alte Herrenhaus "+
    "zu.");
  AddDetail ( ({"platz", "vorplatz"}),
    "Ein kleiner, runder Vorplatz befindet sich direkt vor dem Herrenhaus, "+
    "in seiner Mitte steht ein kleiner Springbrunnen. Der Platz ist voellig "+
    "mit Schnee bedeckt.");
  AddDetail ( ({"brunnen", "springbrunnen"}),
    "Der Springbrunnen besteht aus einem kleinen, runden, mit weissen "+
    "Marmorplatten ausgelegten Becken, in dessen Mitte eine kleine Figur "+
    "steht. Die Figur hat die Haende ueber den Kopf erhoben. Der ganze "+
    "Brunnen ist jedoch verschneit.");
  AddDetail ( ({"schleier", "schnee"}),
    "Wie ein weisser Schleier hat sich der Schnee ueber die gesamte "+
    "Landschaft, den Garten und das Haus gelegt, es scheint fast so, als "+
    "wuerde das Tal sanft schlafen.");
  AddDetail ( ({"hecke", "hecken", "rosenhecke", 
                "rosenhecken"}),
    "Zwei Rosenhecken wachsen links und rechts des Weges, und trennen ihn "+
    "von den Gaerten ab. Die Hecken haben beide eine hohe Schneekrone.");
  AddDetail ( ({"krone", "schneekrone"}),
    "Eine dicke, hohe Schneekrone hat sich auf die Hecken gelegt.");
  AddDetail ( ({"mitte"}),
    "In der Mitte des Vorplatzes steht ein kleiner, verschneiter Brunnen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "/players/cirion/workroom");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
