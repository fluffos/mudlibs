#include "/d/gebirge/cirion/schattengrund/schattengrund.h"
#include "/players/cirion/seasond/seasond.h"

inherit WIESENWEG;

void create()
{  	
  ::create();
}

void static_create()
{
 ::static_create();

  AddExit("norden",ROOM"/roombf0");
  AddExit("osten",ROOM"/roomce0"); 
}

void remove_all()
{
  ::remove_all();
  
}

void spring()
{
  ::spring();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "Hier zweigt ein schmaler Pfad nach Norden ab, der zu einem kleinen "
    "Fachwerkhaus inmitten von Baeumen und Bueschen fuehrt. Weit im Osten "
    "kannst Du ein grosses Herrenhaus erkennen. Nach Westen hin fuehrt der "
    "Weg in einen grossen Wald. Ganz im Sueden des Tals kannst Du den Pass "
    "erkennen, der aus dem Tal herausfuehrt.");
  AddDetail(({"pfad"}),
    "Der schmale Pfad windet sich zwischen Bueschen und Baeumen hindurch auf "
    "ein kleines Fachwerkhaus zu.");  
  AddDetail(({"fachwerkhaus","bauernhaus"}),
    "Es scheint sich um ein kleines Bauernhaus zu handeln, welches inmitten "
    "der Baeume und Buesche liegt. Hinter dem Haus scheint ein kleiner Garten "
    "zu sein, und dahinter liegen Felder und Wiesen.");  
  AddDetail(({"garten","gemuesegarten"}),
    "Ein kleiner Gemuesegarten scheint hinter dem Bauernhaus zu liegen.");  
  AddDetail(({"haus","haeuser"}),
    "Welches Haus meinst Du, das Fachwerkhaus oder das Herrenhaus?");  
  AddDetail(({"herrenhaus"}),
    "Das alte, graue Herrenhaus liegt weit im Osten.");  
  AddDetail(({"westen","wald"}),
    "Im Westen beginnt der grosse Wald, der die ganze westliche Haelfte des "
    "Tales bedeckt. Grosse, alte und junge, kleine Baeume bilden einen "
    "merkwuerdigen Kontrast. Der Wald ist frisch und gruen und strahlt doch "
    "eine Erhabenheit und Ehrwuerdigkeit aus, die auf sein Alter schliessen "
    "laesst.");  
  AddDetail(({"haelfte"}),
    "Die ganze westliche Haelfte des Schattengrundes ist von dem grossen, "
    "alten Wald bedeckt, der ein Stueckchen westlich von hier beginnt, "
    "waehrend die andere Haelfte des Tales mit Wiesen und Feldern kultiviert "
    "ist.");  
  AddDetail(({"baum","baeume"}),
    "In einigen Abstaenden stehen am Wegesrand immer wieder verschiedene "
    "Baeume. Du kannst Birken und Buchen erkennen, aber auch einige bluehende "
    "Obstbaeume. Im Westen beginnt der grosse Wald, der die eine Haelfte des "
    "Tales bedeckt, die Baeume dort sind teils gross und ehrwuerdig, aber "
    "auch teils klein und frisch und bilden so einen merkwuerdigen Kontrast.");
  AddDetail(({"kontrast"}),
    "Der Kontrast zwischen den grossen, alten, ehrwuerdigen Baeumen und den "
    "frischen, jungen westlich im Wald besonders merkwuerdig. Der Wald strahlt "
    "ein Alter und eine Energie aus, die erstaunlich, ja fast magisch zu "
    "nennen sind.");  
  AddDetail(({"erhabenheit","ehrwuerdigkeit","alter","energie"}),
    "Die Energie und das Alter, welches der Wald auszustrahlen scheint sind "
    "wirklich fast schon magisch zu nennen.");  
  AddDetail(({"stueckchen","stueck"}),
    "Weit ist es nicht mehr.");  
  AddDetail(({"",""}),
    "");  
  AddDetail(({"",""}),
    "");  
  AddDetail(({"",""}),
    "");  
  AddDetail(({"",""}),
    "");  
  AddDetail(({"",""}),
    "");  
  AddDetail(({"",""}),
    "");  
  AddDetail(({"",""}),
    "");  
  AddDetail(({"",""}),
    "");  
  AddDetail(({"",""}),
    "");  
}

