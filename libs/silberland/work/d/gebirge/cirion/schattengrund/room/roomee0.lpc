#include "../schattengrund.h"
#include "/players/cirion/seasond/seasond.h"

inherit SEASONROOM;

int rosen;

void create()
{  	
  ::create();
  SetProp(P_INT_SHORT,"Inmitten eines Rosengartens");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
}

reset()
{
  if (SEASOND->QuerySeason()==SPRING)
    rosen=3;
  if (SEASOND->QuerySeason()==SUMMER)
    rosen=5;
  return ::reset();
}

void static_create()
{
  ::static_create();
  
  AddExit("westen",ROOM"/roomde0");
  AddExit("osten","in das Herrenhaus#"ROOM"/roomfe0"); 
}

void remove_all()
{
  ::remove_all();
  
}

void spring()
{
  ::spring();
  rosen=3;
  SetProp(P_INT_LONG,
    "Der Weg fuehrt mitten durch einen wunderschoenen Rosengarten nach "
    "Osten, geradewegs auf das alte, graue Herrenhaus zu. Rechts und links "
    "des Weges wachsen Rosenhecken, und direkt vor dem Haus, auf einem kleinen, "
    "runden Vorplatz steht ein Springbrunnen, der munter vor sich hinplaetschert. "
    "Das Herrenhaus erhebt sich dahinter alt und ehrwuerdig, es scheint fast, als "
    "wuerde es schon seit Anbeginn der Zeit hier stehen.");
  AddDetail(({"rosengarten","garten"}),
    "Ein grosser Rosengarten erstreckt sich hier links und rechts des Weges. "
    "Du kannst die unterschiedlichsten Rosen erkennen: weisse, gelbe, hellrote "
    "und auch die klassischen tiefdunkelroten Rosen, die man gerne einer "
    "geliebten Person schenkt.");  
  AddDetail(({"weg"}),
    "Ein schoener, mit Kies bestreuter Weg fuehrt von West nach Ost auf das "
    "alte Herrenhaus und seinen kleinen Vorplatz zu. Seitlich des Weges "
    "wachsen herrliche Rosenhecken.");  
  AddDetail(({"kies","stein","steine","kiesel","kieselsteine"}),
    "Der Weg hier ist mit feinstem weissen Kies belegt, der unter jedem Deiner "
    "Schritte ein wenig knirscht.");  
  AddDetail(({"schritte","schritt"}),
    "Die machst Du, wenn Du Dich vorwaerts bewegst.");  
  AddDetail(({"herrenhaus","haus"}),
    "Vor Dir erhebt sich das altehrwuerdige Herrenhaus. Es macht fast den Eindruck, "
    "als wuerde es seit Anbeginn der Zeit hier stehen. Es ist aus grauem "
    "Bruchstein gemauert und hat ein dunkles, fast schwarzes Schieferdach. "
    "Einige grosse, holzgefertigte Fenster sind auf dieser Seite zu sehen, "
    "und eine grosse, hoelzerne Tuer fuehrt ins Innere des Hauses.");  
  AddDetail(({"eindruck"}),
    "Der Eindruck entsteht, weil das Haus wirklich schon uralt aussieht. "
    "Allerdings ist es gut gepflegt worden.");  
  AddDetail(({"anbeginn","zeit","anbeginn der zeit"}),
    "Ja, es scheint fast, als wuerde es seit Anbeginn der Zeit hier stehn.");  
  AddDetail(({"bruchstein","stein","brocken","gesteinsbrocken","gestein"}),
    "Das Haus besteht aus grauem Bruchstein, grossen, unbearbeiteten "
    "Gesteinsbrocken, die ihm einen urwuechsigen und natuerlichen Eindruck "
    "verleihen.");  
  AddDetail(({"dach","schieferdach","hausdach"}),
    "Das Dach des alten Herrenhauses ist mit dunklen, fast schwarzen "
    "Schieferplatten gedeckt. Einige grosse, aus Bruchstein gemauerte "
    "Schornsteine ragen daraus hervor, doch jetzt im Fruehling rauchen "
    "sie nicht mehr.");  
  AddDetail(({"schieferplatten","schieferplatte"}),
    "Dunkle, fast schwarze und nur grob behauene Schieferplatten "
    "bilden das Dach des alten Herrenhauses.");  
  AddDetail(({"fruehling"}),
    "Ja, jetzt ist Fruehling.");  
  AddDetail(({"tuer","tuere","eingangstuer","eingangstuere"}),
    "Eine grosse,mit wundervollen Schnitzereien verzierte hoelzerne Tuer "
    "fuehrt ins Innere des Hauses.");  
  AddDetail(({"schnitzereien","schnitzerei"}),
    "Die Schnitzereien auf der grossen Eingangstuer sind wunderschoen, sie "
    "zeigen das Wappen derer vom Schattengrund, umrahmt von ungezaehlten, "
    "stilisierten Rosenblueten. Sie erinnern Dich stark an die Rosenblueten, "
    "die hier ueberall um Dich herum im Garten stehen.");  
  AddDetail(({"inneres","innere"}),
    "Ins Innere des Hauses kannst Du von hier aus nicht schauen.");  
  AddDetail(({"fenster","holzfenster"}),
    "Grosse, helle Holzfenster oeffnen sich zu dieser Seite des Hauses, "
    "sicherlich faellt durch sie genug Licht ins Innere.");  
  AddDetail(({"vorplatz","platz"}),
    "Ein kleiner, runder Vorplatz befindet sich direkt vor dem Herrenhaus, "
    "und in seiner Mitte steht ein leise vor sich hinplaetschernder "
    "Springbrunnen. Der Platz ist voellig mit weissen Kieselsteinen bedeckt.");  
  AddDetail(({"springbrunnen","brunnen"}),
    "Der Springbrunnen besteht aus einem kleinen, runden, mit weissen Marmorplatten "
    "ausgelegten Becken, in dessen Mitte eine kleine Figur steht. Die Figur "
    "hat die Haende ueber den Kopf erhoben, und zwischen ihnen steigt ein "
    "Wasserstrahl nach oben, der mit einem sanften Plaetschern ins Becken "
    "zurueckstuerzt.");
  AddDetail(({"marmorplatten","marmorplatte","becken"}),
    "Das kleine Becken besteht aus makellosen, weissen,glatt geschliffenen "
    "Marmorplatten und ist mit klarem, kuehlen Wasser gefuellt.");  
  AddDetail(({"platte","platten"}),
    "Welche Platten meinst Du?");  
  AddDetail(({"mitte"}),
    "In der Mitte des kleinen Beckens steht eine kleine Figur.");  
  AddDetail(({"figur","frauenfigur"}),
    "Die kleine Figur ist ebenfalls aus weissem Marmor gefertigt und stellt "
    "eine wunderschoene junge Frau dar, die beide Haende ueber den Kopf "
    "erhoben hat. Direkt zwischen ihren Haenden scheint der Wasserstrahl "
    "zu entstehen, der senkrecht in die Luft steigt, um mit einem sanften "
    "Plaetschern wieder zurueck in das Becken zu stuerzen. Die Frau scheint "
    "dabei ein wenig zu laecheln.");  
  AddDetail(({"frau"}),
    "Die Frau traegt ein kurzes Kleid und hat fast hueftlange Haare, die "
    "wild ueber ihre Schultern und ihren Ruecken haengen. Sie scheint ein "
    "wenig zu laecheln.");  
  AddDetail(({"kleid"}),
    "Ein kurzes, elegantes Kleid.");  
  AddDetail(({"haar","haare","schultern","schulter","ruecken"}),
    "Die Haare der Frau sind fast hueftlang und haengen ihr lose ueber "
    "Schultern und Ruecken.");  
  AddDetail(({"marmor"}),
    "Der Springbrunnen ist aus wunderbarem, weissem, geschliffenen Marmor "
    "gefertigt.");  
  AddDetail(({"hand","haende"}),
    "Die Frau hat die Haende ueber den Kopf erhoben, und zwischen ihnen "
    "schiesst der Wasserstrahl in die Hoehe.");  
  AddDetail(({"wasserstrahl","strahl","hoehe"}),
    "Der Wasserstrahl schiesst zwischen den Haenden der kleinen Frauenfigur "
    "in die Hoehe, um mit einem sanften Plaetschern wieder in das Becken "
    "zurueckzustuerzen.");  
  AddDetail(({"plaetschern"}),
    "Das solltest Du Dir vielleicht einmal anhoeren.");  
  AddSound(DEFAULT_SOUND,"Du hoerst ein leises Plaetschern von dem kleinen "
  "Springbrunnen, der vor dem Herrenhaus steht.");
  AddSound("plaetschern","Sanft und beruhigend klingt das Plaetschern "
  "des kleinen Springbrunnens.");
  AddDetail(({"luft"}),
    "Die Luft ist ueberall um Dich herum.");  
  AddDetail(({"wasser"}),
    "Das Wasser im Becken des Springbrunnens ist klar und kuehl.");  
  AddDetail(({"rosenhecken","rosenhecke","hecken","hecke"}),
    "Dichte Rosenhecken wachsen zu beiden Seiten des Weges und grenzen ihn "
    "so von dem wunderschoenen Rosengarten ab.");  
  AddDetail(({"rosen","rose"}),
    "Im Rosengarten und in den Rosenhecken wachsen die unterschiedlichsten, "
    "wunderschoenen Rosen: Tiefrote, gelbe, hellrote und weisse Rosenblueten "
    "kannst Du erkennen.");  
  AddDetail(({"rosenblueten","rosenbluete","blueten","bluete"}),
    "Die Rosenblueten sind riesengross und wunderschoen.");  
  AddSmell(({DEFAULT_SMELL,"rosenblueten","rosenbluete","blueten",
             "bluete","rosen","rose"}),
             "Du riechst den betoerenden Geruch von hunderten Rosenblueten.");
  AddDetail(({"schattengrund"}),
    "Der Schattengrund ist dieses Gebirgstal, die Heimat derer vom Schattengrund.");  
  AddDetail(({"gebirgstal","tal"}),
    "Dieses Gebirgstal heisst Schattengrund.");  
  AddDetail(({"wappen"}),
    "");  
  AddDetail(({"schornsteine","schornstein"}),
    "Die Schornsteine auf dem Dach sind aus Bruchstein gemauert. Sie sind "
    "sicher zum Heizen des Hauses gedacht, doch jetzt im Fruehling werden sie "
    "nur selten benutzt.");  
  AddDetail(({"heizen"}),
    "Man heizt, damit es warm ist.");  
  AddDetail(({"person"}),
    "Es ist ein schoener Brauch einer geliebten Person eine rote Rose zu "
    "schenken.");
  AddDetail(({"licht"}),
    "Hier draussen ist es hell, und damit es im Haus auch hell ist, hat es "
    "Fenster.");  
    
  AddCmd(({"pflueck","pfluecke"}),"cmd_pflueck");
}

