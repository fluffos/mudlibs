void sunshine()
{
  ::sunshine();
  if (QuerySeason()!=WINTER)
  {
    AddSound(DEFAULT_SOUND,
      "Du hoerst das sanfte Plaetschern des Springbrunnens und das Zwitschern "
      "von Voegeln.");
    AddSound(({"voegeln","voegel","zwischern","gezwitscher"}),
      "Die Voegel zwitschern lustig durcheinander.");
    AddSound(({"plaetschern","brunnen","springbrunnen"}),
      "Sanft plaetschert der Springbrunnen vor sich hin, es ist ein "
      "beruhigendes Geraeusch.");
  }
  else
  {
    AddSound(DEFAULT_SOUND,
      "Es ist ziemlich still, nur ab und zu hoert man das Kraechzen eines Raben.");
    AddSound(({"kraechzen","rabe","raben"}),
      "'Kraaaahk!' kraechzt ab und zu ein Rabe in der Ferne.");
  }
}
