int cmd_pflueck(string str)
{
  object rose;
  
  notify_fail("Was moechtest Du pfluecken?\n");
  if (-1==member(({"rose"
                  ,"rosen"
                  ,"rose von hecke"
                  ,"rosen von hecke"
                  ,"rosenbluete"
                  ,"bluete"
                  ,"rosenblueten"
                  ,"blueten"}),str))
    return 0;
  if (!rosen)
  {
    tell_object(TP,BS(
      "Du moechtest doch sicher nicht die letzten Rosen abpfluecken.\n"));
    return 1;
  }
  rose=clone_object(OBJ"/rose");
  if (rose->move(TP,M_GET)==(ME_TOO_MUCH||ME_TOO_HEAVY))
  {
    tell_object(TP,BS(
      "Du kannst keine Rose mehr tragen, daher laesst Du sie lieber stehen."));
    rose->remove();
    return 1;
  }
  tell_object(TP,BS(
    "Du pflueckst eine der wunderschoenen Rosen aus der Hecke."));
  tell_room(TO,BS(
    TP->Name()+" pflueckt eine der wunderschoenen Rosen aus der Hecke."),
    ({TP}));
  rosen--;
  return 1;
}

