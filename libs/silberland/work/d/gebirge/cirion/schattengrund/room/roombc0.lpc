#include "/d/gebirge/cirion/schattengrund/schattengrund.h"

inherit FELDER;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));
  SetProp (P_INT_SHORT, "Auf einem Pfad zwischen Feldern");
  SetProp (P_INT_LONG,
    "Ein schmaler Trampelpfad fuehrt hier zwischen den Feldern hindurch "+
    "bis zum Waldrand im Westen. Links und rechts des Pfades liegen "+
    "reifende, sich im leichten Wind wiegende Kornfelder. Gleich vor Dir "+
    "kommt das schmale Bach des Schattenbaches aus dem Wald heraus, um "+
    "einen Knick nach Sueden zu machen und weiter den Waldrand entlang zu "+
    "fuehren. Im Norden kannst Du eine riesige Weider erkennen, waehrend "+
    "im Osten ein Feldweg mitten durch die Felder und Wiesen verlaeuft.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"weide"}),
    "Noerdlich von hier kannst Du eine riesige, uralte Weide erkennen. Um "+
    "sie Dir genauer anzusehen, solltest Du allerdings naeher herangehen.");
  AddDetail ( ({"rand", "waldrand"}),
    "Der Waldrand beginnt gleich hier, und verlaeuft nach Sueden hin "+
    "jenseits des Bachbettes, und weit nach Norden.");
  AddDetail ( ({"pfad", "trampelpfad"}),
    "Ein schmaler, scheinbar kaum benutzter Trampelfpad fuehrt zwischen "+
    "den Feldern hindurch bis zum Waldrand.");
  AddDetail ( ({"knick", "bett", "bachbett"}),
    "Das Bett des Baches macht hier einen Knick nach Sueden und verlaeuft "+
    "weiter entlang des Waldrandes.");
  AddDetail ( ({"bach"}),
    "Gleich vor Dir fliesst der glitzernde Schattenbach in seinem schmalen "+
    "Bett aus dem Wald heraus. Leise plaetschernd fliesst er von hier nach "+
    "Sueden. Viele kleine Insekten fliegen um und ueber dem Bach, und an "+
    "manchen Stellen steht dichtes Schilf an seinem Ufer. Im klaren Wasser "+
    "kannst Du einige Fische und auch andres Getier erkennen.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht hier aus einem schmalen, mit Gras bewachsenen und "+
    "anscheinend kaum benutzen Trampelpfad, der zwischen den Kornfeldern "+
    "hindurchfuehrt.");
  AddDetail ( ({"feld", "felder", "kornfeld", 
                "kornfelder"}),
    "Felder mit unterschiedlichsten Getreidearten wachsen hier links und "+
    "rechts des Pfades. Das Korn ist schon gelb und fast ausgereift und "+
    "wiegt sich im sanften Wind leicht hin und her. Zwischen dem Getreide "+
    "kannst Du immer wieder einzelne, leuchtend rote Mohnblumen erkennen. ");
  AddDetail ( ({"feldweg", "weg"}),
    "Im Osten erkennst du einen Feldweg, der vom Sueden her vom Gebirge "+
    "herunterkommt und weiter nach Norden zwischen den Feldern und Wiesen "+
    "hindurchfuehrt.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", "./roomcc0");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
