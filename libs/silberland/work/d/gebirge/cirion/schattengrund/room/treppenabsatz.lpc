#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/gebirge/cirion/schattengrund/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Ein voellig neuer Raum");
  SetProp (P_INT_LONG,
    "Du stehst am Fuss einer breiten Treppe, die nach oben fuehrt. Vor "+
    "Dir oeffnet sich ein dunkler Gang, der nach Westen fuehrt. Der ganze "+
    "Raum scheint aus solidem Felsen geschlagen zu sein, allerdings sind "+
    "die Waende sauber geglaettet.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind zwar aus dem rohen Felsgestein herausgehauen, aber "+
    "sorgfaeltig geglaettet worden, so dass man keine Unebenheit erkennen "+
    "kann.");
  AddDetail ( ({"unebenheit", "unebenheiten"}),
    "Mit blossem Auge kannst Du hier keine Unebenheiten erkennen, da "+
    "muesstest Du schon die Waende genauer untersuchen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Hier herrscht absolute Stille.");
  AddDetail ( ({"stille"}),
    "Was moechtest Du denn daran untersuchen??");
  AddDetail ( ({"treppe"}),
    "Eine breite Treppe fuehrt hier nach ostoben auf einen grossen "+
    "Treppenabsatz. Von oben scheint etwas Licht herab, aber es reicht "+
    "nicht aus, den Raum hier unten zu erhellen. Die Treppe selbst ist mit "+
    "hellen Marmorplatten belegt, das Gelaender ist auch aus dem Stein "+
    "gehauen und mit einer Griffleiste aus einem silbrig schimmernden "+
    "Material versehen.");
  AddDetail ( ({"absatz", "treppenabsatz"}),
    "Der Treppenabsatz ist von hier aus ostoben.");
  AddDetail ( ({"fels", "felsgestein", "gestein", 
                "stein"}),
    "Der ganze Gang und auch die Treppe sind aus dunkelgrauem Felsgestein "+
    "gehauen, das muss eine ganze Menge Arbeit gewesen sein, vor allem, das "+
    "alles sorgfaeltig geglaettet wurde.");
  AddDetail ( ({"raum"}),
    "Der Raum ist eigentlich ein Gang, der von der Treppe im Osten weiter "+
    "nach Westen fuehrt.");
  AddDetail ( ({"arbeit", "menge"}),
    "Ja, solche einen Raum aus dem Felsen zu hauen, ist eine ganze Menge "+
    "schweisstreibender Arbeit. Nur ein Zwerg wuerde an so etwas seinen "+
    "Spass haben.");
  AddDetail ( ({"gelaender"}),
    "Das Gelaender der Treppe ist auch aus dem grauen Gestein "+
    "herausgehauen. Es ist oben mit einer Griffleiste aus einem silbrig "+
    "schimmernden Material versehen.");
  AddDetail ( ({"fuss"}),
    "Hier ist der Fuss der Treppe.");
  AddDetail ( ({"griffleiste", "leiste"}),
    "Eine mit wundervollen Schnitzereien verzierte Griffleiste aus einem "+
    "silbirgen, elfenbeinaehnlichen Material ist am Gelaender angebracht.");
  AddDetail ( ({"ornament", "ornamente", "schnitzerei", 
                "schnitzereien"}),
    "Die Schnitzereien sind kleine Ornamente, die sich an der gesamten "+
    "Griffleiste entlangziehen.");
  AddDetail ( ({"elfenbein", "material"}),
    "Bei dem Material, aus dem die Griffleiste geschnitzt ist, scheint es "+
    "sich um eine Art Elfenbein zu handeln, allerdings sicher nicht von "+
    "normalen Elefanten, denn dazu ist es zu silbrig.");
  AddDetail ( ({"marmorplatte", "marmorplatten", "platte", 
                "platten"}),
    "Die Treppe ist mit hellen, fast weissen Marmorplatten belegt. Der "+
    "Marmor hat eine feine, graeuliche Struktur.");
  AddDetail ( ({"marmor", "struktur"}),
    "Du erkennst in den Marmorplatten eine feine, graeuliche Struktur.");
  AddDetail ( ({"licht"}),
    "Von oben faellt ein klein wenig Licht herab, aber es reicht nicht "+
    "aus, den Raum zu erhellen.");
  AddDetail ( ({"elefant", "elefanten"}),
    "Du siehst hier weder einen Elefant noch denkst Du, dass das Elfenbein "+
    "von einem Elefanten stammt.");
  AddDetail ( ({"decke"}),
    "Die Decke scheint direkt aus dem Felsgestein gehauen zu sein. Sie ist "+
    "sauber geglaettet.");
  AddDetail ( ({"boden"}),
    "Der Boden ist direkt aus dem grauen Felsgestein geschlagen und sauber "+
    "geglaettet. Ein wenig Staub liegt an den Seiten des Ganges.");
  AddDetail ( ({"seite", "seiten", "staub"}),
    "Dieser Gang scheint haeufiger benutzt zu werden, denn nur an den "+
    "Seiten findest Du etwas Staub.");
  AddDetail ( ({"gang"}),
    "Der Gang fuehrt nach Westen in die Dunkelheit.");
  AddDetail ( ({"dunkelheit"}),
    "Im Westen sieht es ziemlich dunkel aus.");
  // DETAILS END

  // EXITS START
  AddExit ("raus", "/players/cirion/workroom");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
