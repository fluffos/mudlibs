#include "/d/gebirge/cirion/schattengrund/schattengrund.h"
#include "/players/cirion/seasond/seasond.h"

inherit FELDER;

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Unter einer uralten Weide");
}

void static_create()
{
 ::static_create();
  AddDetail ( ({"entfernung"}),
    "Das ist schon ganz schoen weit.");
 
  AddExit("osten",ROOM"/roomcd0");
}

void remove_all()
{
  ::remove_all();
  
}

void spring()
{
  ::spring();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "");
  
}
void summer()
{
  ::summer();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "");
  
}
void autumn()
{
  ::autumn();
  SetProp(P_INT_LONG,
    "Du stehtst auf einer grossen Wiese am Rande des Waldes, der sich von "
    "hier bis weit in den Westen erstreckt. Mitten auf der Wiese steht "
    "eine riesige, uralte Weide, deren Krone sich fast ueber die gesamte "
    "Wiese erstreckt. Ihr Laub ist leuchtend Gelb gefaerbt, und viele "
    "Blaetter liegen auch schon auf dem Boden. Im Norden und Westen kannst "
    "Du in einiger Entfernung einen schmalen Feldweg erkennen, dier sich "
    "durch die Felder schlaengelt, waehrend sich im Sueden weitere Wiesen "
    "und Felder anschliessen.");
  AddDetail ( ({"boden"}),
    "Du stehst auf einer weiten Wiese.");
  AddDetail ( ({"wiese"}),
    "Ueberall auf der Wiese liegen bereits gelbe und braune Blaetter der "+
    "riesigen Weide, die in der Mitte der Wiese steht.");
  AddDetail ( ({"weide"}),
    "In der Mitte der Wiese steht eine riesige, uralte Weide, deren Krone "+
    "sich weitausladen fast ueber die ganze Wiese erstreckt. Ihre Blaetter "+
    "sind grossteil leuchtend gelb und ihre Aeste und Zweige haengen fast "+
    "wie goldene Sturzbaeche herunter.");
  AddDetail ( ({"aeste", "ast", "geaest", 
                "zweig", "zweige"}),
    "Das Geaest der Weide haengt fast wie goldenen Sturzbaeche herab und "+
    "erstreckt sich ueber der ganzen Wiese.");
  AddDetail ( ({"wald"}),
    "Der riesige Wald, der sich von hier bis zu den Grenzen des Tales im "+
    "Westen erstreckt ist in allen Farben gefaerbt. Er ist ein wunderbarer "+
    "Anblick.");
  AddDetail ( ({"sturzbach", "sturzbaeche"}),
    "Fast wie goldene Sturzbaecher haengen die Aeste und Zweige der "+
    "riesigen, uralten Weide herab.");
  AddDetail ( ({"rand", "waldrand"}),
    "Der Waldrand erstreckt sich von weit im Sueden bis zum noerdlichen "+
    "Ende des Tales.");
  AddDetail ( ({"mitte"}),
    "In der Mitte der Wiese steht eine uralte, riesige Weide.");
  AddDetail ( ({"blaetter", "blatt", "laub"}),
    "Das Laub der Weide ist leuchtend gelb gefaerbt, waehrend der Wald in "+
    "allen Farben schillert. Auch auf dem Boden liegt schon einiges gelbes "+
    "oder braeunliches Laub.");
  AddDetail ( ({"krone"}),
    "Die Krone der grossen Weide erstreckt sich fast ueber die ganze Wiese "+
    "und ist leuchtend gelb gefaerbt.");
  AddDetail ( ({"gelb"}),
    "Die Blaetter der Weide sind in einem leuchtenden Gelb gefaerbt.");
  AddDetail ( ({"feldweg", "weg"}),
    "Im Norden und Osten kannst Du in einiger Entfernung einen von Baeumen "+
    "und Bueschen gesaeumten Feldweg erkennen.");
  AddDetail ( ({"rand"}),
    "Die Grenzen des Schattengrundes sind die umliegenden, hohen Berge.");
  AddDetail ( ({"farbe", "farben"}),
    "Die Blaetter der Weide sind leuchtend gelb, waehrend der Wald im "+
    "Westen in gelb, rot und braun gefaerbt ist.");
  AddDetail ( ({"buesche", "busch"}),
    "Kleinere Buesche und Baeume saeumen den Feldweg, der sich im Osten "+
    "und Norden in einiger Entfernung vorbeischlaengelt.");
  AddDetail ( ({"baeume", "baum"}),
    "Du kannst eine ganze Menge Baume erkennnen. Gleich im Westen beginnt "+
    "ein grosser Wald, im Osten und Norden siehst Du einzelne Baeume am "+
    "Rande eines Feldweges, und inmitten der Wiese, auf der Du stehst, "+
    "steht eine riesige, uralte Weide.");
  AddDetail ( ({"anblick"}),
    "Es ist ein herrlicher Anblick. Du koenntest hier stundenlang stehen.");
  AddDetail ( ({"menge"}),
    "Sehr sehr viele.");
  AddDetail(({"feld","felder","wiesen","stoppelfeld","stoppelfelder"}),
    "Ringsum liegen weite Wiesen und abgeerntete Stoppelfelder.");
  
}
void winter()
{
  ::winter();
  SetProp (P_INT_LONG,
    "Du stehst auf einer tiefverschneiten Wiese am Rande des Waldes, der "+
    "sich von hier bis weit in den Westen erstreckt. Mitten auf der Wiese "+
    "steht eine uralte, riesige Weide, deren Geaest sich unter der Last "+
    "des vielen Schnees tief heruntergebeugt hat. Im Norden und Westen "+
    "kannst Du in einiger Entfernung einen schmalen Feldweg erkennen, "+
    "waehrend sich im Sueden weite, verschneite Felder anschliessen.");
  AddDetail ( ({"wiese"}),
    "Die Wiese, auf der Du stehst ist mit Schnee bedeckt, der sicher 50 "+
    "Zentimeter hoch liegt. Du hinterlaesst tiefe Spuren im Schnee.");
  AddDetail ( ({"laenge", "zentimeter", "zwergenlaenge"}),
    "50 Zentimeter, das ist fast eine halbe Zwergenlaenge.");
  AddDetail ( ({"baum", "weide", "weidenbaum"}),
    "Mitten auf der Wiese steht eine riesige, uralte, tiefverschneite "+
    "Weide, deren Krone sich fast ueber die ganze Wiese spannt. Ihre Aeste "+
    "haengen wegen des vielen Schnees tief herab und beruehren an manchen "+
    "Stellen sogar den Boden.");
  AddDetail ( ({"wald"}),
    "Hinter der Wiese im Westen beginnt der tiefverschneite Wald, der sich "+
    "bis weit in den Westen zu den Grenzen des Schattengrundes erstreckt. "+
    "Jetzt im Winter wirkt der Wald ein wenig kahl.");
  AddDetail ( ({"winter"}),
    "Ja, die Jahreszeit mit dem vielen Schnee und der Kaelte wird Winter "+
    "genannt.");
  AddDetail ( ({"stelle", "stellen"}),
    "Die Aeste der Weide biegen sich so stark unter der Last des Schnees, "+
    "dass sie an einigen Stellen den Boden beruehren.");
  AddDetail ( ({"spuren"}),
    "Du entdeckst hinter Dir im Schnee Deine eigenen Spuren. Als Du etwas "+
    "genauer hinsiehst, kannst du auch die Spuren von verschiedenen Tieren "+
    "erkennen.");
  AddDetail ( ({"tieren"}),
    "Du erkennst die Spuren von Hasen, von Rebhuehnern und hie und da "+
    "meinst Du auch die Spur eines Rehs zu sehen.");
  AddDetail ( ({"reh", "spur"}),
    "Tatsaechlich, eine schmale Faehrte eines Rehs fuehrt hier quer ueber "+
    "die verschneite Wiese.");
  AddDetail ( ({"schnee"}),
    "Der Schnee bedeckt alles, den Boden, die Weide und auch den Wald im "+
    "Westen.");
 AddDetail ( ({"rebhuehner", "rebhuhn"}),
    "Du kannst im Schnee schwache Spuren von Rebhuehnern erkennen.");
  AddDetail ( ({"rand", "waldrand"}),
    "Der Waldrand liegt gleich hinter der tiefverschneiten Wiese und "+
    "erstreckt sich weit von Sueden nach Norden.");
  AddDetail ( ({"last", "menge", "schneelast", 
                "schneemenge"}),
    "Eine gewaltige Schneemenge lastet auf den Aesten der riesigen Weide.");
  AddDetail ( ({"krone"}),
    "Die Krone der alten Weide ist riesengross und erstreckt sich fast "+
    "ueber die ganze Wiese. Sie ist bis auf den vielen Schnee voellig kahl.");
  AddDetail ( ({"kaelte"}),
    "Es ist wirklich ziemlich kalt.");
  AddDetail ( ({"jahreszeit"}),
    "Im Moment ist es Winter.");
  AddDetail ( ({"moment"}),
    "Das ist jetzt.");
  AddDetail ( ({"hase", "hasen"}),
    "Du erkennst im Schnee viele Spuren von Hasen, und auch ihre Losung.");
  AddDetail ( ({"auscheidung", "ausscheidungen", "losung"}),
    "Die Losung sind die Ausscheidungen der Hasen, kleine braune "+
    "Kuegelchen die hier immer wieder herumliegen.");
  AddDetail ( ({"kuegelchen", "kugel", "kugeln"}),
    "Die kleinen Kuegelchen liegen hier ueberall herum.");
  AddDetail ( ({"aeste", "ast", "geaest"}),
    "Die vielen Aeste der Weide biegen sich wegen der grossen Schneelast "+
    "tief durch.");
  AddDetail ( ({"feldweg", "weg"}),
    "In Osten und Norden kannst Du in einiger Entfernung einen von "+
    "Bueschen und Baeumen gesaeumten Feldweg erkennen.");
  AddDetail ( ({"feld", "felder", "wiesen"}),
    "Tiefverschneite Wiesen und Felder erstrecken sich von hier aus nach "+
    "Norden, Osten und Sueden.");
  AddDetail ( ({"faehrte"}),
    "Wohin die Faehrte des Rehs wohl fuehren mag?");
  AddDetail ( ({"buesche", "busch"}),
    "Der schmale Feldweg wird von Bueschen und Baeumen gesaeumt.");
  AddDetail ( ({"boden"}),
    "Du stehtst auf einer tiefverschneiten Wiese.");
  AddDetail ( ({"baeume"}),
    "Du siehst eine Menge Baeume, einmal den verschneiten Wald im Westen, "+
    "und zum anderen die einzelnen Baeume, die den schmalen Feldweg "+
    "saeumen. Am auffaelligsten ist jedoch die riesige Weide, die hier "+
    "mitten auf der Wiese steht.");
  
}
