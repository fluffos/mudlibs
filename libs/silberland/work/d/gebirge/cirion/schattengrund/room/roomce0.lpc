#include "/d/gebirge/cirion/schattengrund/schattengrund.h"
#include "/players/cirion/seasond/seasond.h"

inherit WIESENWEG;

void create()
{  	
  ::create();
}

void static_create()
{
 ::static_create();

  AddExit("westen",ROOM"/roombe0");
  AddExit("osten",ROOM"/roomde0"); 
}

void remove_all()
{
  ::remove_all();
  
}

void spring()
{
  ::spring();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "Im Westen kannst Du den gruenenden Wald sehen, der sich ueber die "
    "westliche Haelfte des Tals erstreckt. Nordwestlich, versteckt zwischen "
    "einigen Baeumen und Bueschen siehst Du ein kleines Fachwerkhaus. "
    "Ganz im Osten kannst Du in einiger Entfernung ein grosses Herrenhaus "
    "erkennen, und weit im Sueden schliesslich siehst Du den hohen Pass, "
    "welcher der einzige Weg in und aus dem Tal ist.");
  AddDetail(({"wald"}),
    "Grosse, gruenende Laubbaeume bilden den Wald, der sich ueber die ganze "
    "westliche Haelfte des Schattengrundes erstreckt.");  
  AddDetail(({"laubbaeume"}),
    "Die Laubbaeume sind ziemlich hoch und haben viele helle, junge Blaetter.");  
  AddDetail(({"blaetter"}),
    "Viele Blaetter an den Baeumen sind hell und jung.");  
  AddDetail(({"haelfte"}),
    "Der Wald nimmt ungefaehr die Haelfte des Tales ein, waehrend die andere "
    "mit Feldern und Wiesen kultiviert ist.");  
  AddDetail(({"fachwerkhaus","bauernhaus"}),
    "Es scheint sich um ein kleines Bauernhaus zu handeln, welches versteckt "
    "zwischen den Baeumen steht.");  
  AddDetail(({"haus"}),
    "Welches Haus meinst Du, das Fachwerkhaus oder das Herrenhaus?");  
  AddDetail(({"entfernung"}),
    "Es ist schon etwas weiter weg.");  
  AddDetail(({"Herrenhaus"}),
    "Es scheint ein grosses, zweistoeckiges Herrenhaus aus grauem Gestein zu "
    "sein.");  
  AddDetail(({"gestein"}),
    "Dunkelgraues Gestein, mehr kannst Du von hier aus nicht erkennen.");  
  AddDetail(({"sueden"}),
    "Im Sueden fuehrt ein schmaler Pass ueber die Berge.");  
  
}
