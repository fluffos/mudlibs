void autumn()
{
  ::autumn();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "Suedoestlich von hier erkennst Du ein kleines Bauernhaus, waehrend sich "
    "im Nordosten ein grosses Herrenhaus erhebt. Weit im Westen kannst Du "
    "den Wald erkennen, der in den buntensten Farben leuchtet");
  AddDetail(({"haus"}),
    "Welches Haus meinst Du, das Bauernhaus oder das Herrenhaus?");
  AddDetail(({"bauernhaus","fachwerkhaus"}),
    "Du siehst suedoestlich von hier ein kleines Fachwerkhaus mit "
    "dunkelbrauenen Holzbalken. Es ist scheinbar mit Stroh gedeckt. ");
  AddDetail(({"stroh","dach"}),
    "Das Dach des Bauernhauses scheint mit Stroh gedeckt zu sein.");
  AddDetail(({"holzbalken","balken"}),
    "Diese Balken sind typisch fuer Fachwerkhaeuser. Sie stuetzen das "
    "Gemaeuer und halten so das Haus zusammen.");
  AddDetail(({"gemaeuer","waende","wand"}),
    "Die Waende des Fachwerkhauses bestehen aus einem lehmaehnlichen Material.");
  AddDetail(({"Material"}),
    "Es scheint etwas lehmaehnliches zu sein, allerdings ist es weiss gestrichen.");
  AddDetail(({"herrenhaus"}),
    "Das Herrenhaus ist zweistoeckig und besteht ganz aus grauem Gestein.");
  AddDetail(({"gestein"}),
    "Das Gestein ist sicher sehr stabil.");
  AddDetail(({"wald"}),
    "Der Wald erstreckt sich weit im Westen des Tals und leuchtet in den "
    "verschiedensten Farben. Es ist ein herrlicher Anblick.");
    
}
void winter()
{
  ::winter();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "Suedoestlich von hier erkennst Du ein kleines ,verschneites Bauernhaus, "
    "waehrend sich im Nordosten ein grosses Herrenhaus erhebt. Weit im Westen "
    "kannst Du den tief verschneiten Wald erkennen.");
  AddDetail(({"haus"}),
    "Welches Haus meinst Du, das Bauernhaus oder das Herrenhaus?");
  AddDetail(({"bauernhaus","fachwerkhaus"}),
    "Das kleine Bauernhaus steht mitten in den weissen Wiesen und Feldern. "
    "Es ist ein Fachwerkhaus mit einem Schornstein, aus dem eine duenne "
    "Fahne hellgrauen Rauchs in den Himmel steigt.");
  AddDetail(({"schornstein"}),
    "Auf dem Dach des kleinen Bauernhauses ist ein Schornstein, aus dem eine "
    "duenne Rauchsaeule in den Himmel steigt.");
  AddDetail(({}),
    "");
  AddDetail(({}),
    "");
  AddDetail(({}),
    "");
  AddDetail(({}),
    "");
  AddDetail(({}),
    "");
  AddDetail(({}),
    "");
  
}
