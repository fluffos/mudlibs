#include "/d/gebirge/cirion/schattengrund/schattengrund.h"
#include "/players/cirion/seasond/seasond.h"

inherit WIESENWEG;

void create()
{  	
  ::create();
}

void static_create()
{
  ::static_create();
  
  AddExit("sueden",ROOM"/roomcc0");
  AddExit("nordosten",ROOM"/roomde0");
  AddExit("westen",ROOM"/roombd0");
  AddExit("osten",ROOM"/roomdd0");
}

void remove_all()
{
  ::remove_all();
  
}

void spring()
{
  ::spring();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "Suedoestlich von hier erkennst Du ein kleines Bauernhaus, waehrend sich "
    "im Nordosten ein grosses Herrenhaus erhebt. Weit im Westen kannst Du "
    "den Wald erkennen.");
  AddDetail(({"haus"}),
    "Welches Haus meinst Du, das Bauernhaus oder das Herrenhaus?");
  AddDetail(({"bauernhaus","fachwerkhaus"}),
    "Du siehst suedoestlich von hier ein kleines Fachwerkhaus mit "
    "dunkelbrauenen Holzbalken. Es ist scheinbar mit Stroh gedeckt.");
  AddDetail(({"stroh","dach"}),
    "Das Dach des Bauernhauses scheint mit Stroh gedeckt zu sein.");
  AddDetail(({"holzbalken","balken"}),
    "Diese Balken sind typisch fuer Fachwerkhaeuser. Sie stuetzten das "
    "Gemaeuer und halten so das Haus zusammen.");
  AddDetail(({"gemaeuer","waende","wand"}),
    "Die Waende des Fachwerkhauses bestehen aus einem lehmaehnlichen Material.");
  AddDetail(({"Material"}),
    "Es scheint etwas lehmaehnliches zu sein, allerdings ist es weiss gestrichen.");
  AddDetail(({"herrenhaus"}),
    "Das Herrenhaus ist zweistoeckig und besteht ganz aus grauem Gestein.");
  AddDetail(({"gestein"}),
    "Das Gestein ist sicher sehr stabil.");
  AddDetail(({"wald"}),
    "Der Wald erstreckt sich weit im Westen des Tals.");
  AddDetail(({}),
    "");
  AddDetail(({}),
    "");
  AddDetail(({}),
    "");
    
}
