#include "/d/gebirge/cirion/schattengrund/schattengrund.h"

inherit WIESENWEG;

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Ein Weg durch die Wiesen");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_INT_LONG,
    "Du stehst auf einem von Bueschen gesaeumten Feldweg, der hier mitten "
    "durch die bluehende bunte Wiesen und reifende Felder fuehrt. In "
    "einigen Abstaenden stehen auch immer mal wieder Baeume am Wegesrand. "
    "Der Weg selbst ist teils grasbewachsen "
    "und breit genug, um einem Fuhrwerk Platz zur Durchfahrt zu gewaehren."
    "Oestlich von hier scheint ein kleines Bauernhaus zu stehen, im Nordosten "
    "kann man in einiger Entfernung ein altes Herrenhaus erkennen, und weiter "
    "im Westen liegt der Wald.");

  AddDetail(({"haus"}),
    "Welches meinst Du, das Bauern- oder das Herrenhaus?");
  AddDetail(({"herrenhaus"}),
    "Das ist ein grosses, zweistoeckiges Herrenhaus aus grauem Gestein, "
    "welches in einiger Entfernung im Nordosten steht.");
  AddDetail(({"bauernhaus","fachwerkhaus"}),
    "Das ist ein kleines weissen Fachwerkhaus mit dunkelbrauenen "
    "Holzbalken. Es scheint wohl mit Stroh gedeckt zu sein. Hinter dem Haus "
    "ist ein kleiner Garten.");
  AddDetail(({"holzbalken","balken"}),
    "Die Balken stuetzen die Hauswaende und halten so das Haus zusammen. Sie "
    "sind aus einem dunkelbrauenen Holz.");
  AddDetail(({"holz"}),
    "Du kannst nicht so genau sagen, um was fuer ein Holz es sich handelt.");
  AddDetail(({"stroh","dach"}),
    "Das Dach des Hauses ist mit Stroh gedeckt. Das mag nicht sehr "
    "wiederstandsfaehig sein, aber hier im Tal ist das Klima eher gemaessigt.");
  AddDetail(({"klima"}),
    "Das Klima hier im Tal ist wohl eher gemaessigt.");
  AddDetail(({"garten"}),
    "Im Garten kannst Du allerlei Gemuese und auch einige Obstbaeume erkennen.");
  AddDetail(({"gemuese"}),
    "Von hier kannst Du das nicht so genau sehen.");
  AddDetail(({"obstbaeume"}),
    "Du siehst im Garten einige Obstbaeume.");
  AddDetail(({"gestein"}),
    "Es ist bloss graues Gestein, genaueres vermagst Du aus dieser Entfernung "
    "nicht zu sagen.");
  AddDetail(({"wald"}),
    "Weiter im Westen des Tales liegt ein dichter, gruener Wald.");
  AddDetail(({""}),
    "");
  AddDetail(({""}),
    "");
  AddDetail(({""}),
    "");
  AddDetail(({""}),
    "");
  AddDetail(({""}),
    "");
  AddDetail(({""}),
    "");
  AddDetail(({""}),
    "");

  AddExit("suedwestoben",ROOM"/roombb0");
  AddExit("suedwesten",ROOM"/roombb0");
  AddExit("norden",ROOM"/roomcd0");
  AddExit("westen",ROOM"/roombc0");
  AddExit("osten",ROOM"/roomdc0");
  AddExit("suedosten",ROOM"/roomdb0");
  SetProp(P_HIDE_EXITS,({"suedwesten"}));
}
