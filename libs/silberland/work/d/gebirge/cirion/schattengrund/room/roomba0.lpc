#include "/d/gebirge/cirion/schattengrund/schattengrund.h"

inherit "std/room";

int blumen;

void create()
{
  ::create();
  blumen=2;
  SetProp(P_INT_SHORT,"Ein Weg im Gebirge");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_INT_LONG,
    "Ein schmaler Weg, gerade breit genug fuer einen Pferdewagen, schlaengelt "
    "sich hier ueber ein weites, nach Norden ansteigendes Geroellfeld. "
    "Seitlich des Geroellfeldes steigen die Berflanken steiler an, und "
    "verengen sich nach Norden hin auf einen schmalen Pass zu. \n"
    "Das ganze Geroellfeld ist ueber und ueber mit den schoensten Wildblumen "
    "bewachsen, und Schmetterlinge, Bienen und andere kleine Insekten "
    "fliegen zwischen den Blueten hin und her.");

  AddDetail("weg",
    "Der Weg ist gerade so breit, dass ein Pferdewagen hier bequem entlang "
    "fahren kann, und er windet sich in weiten Kurven das Geroellfeld hoch, "
    "so dass er an keiner Stelle besonders steil ist. Sicherlich wird der "
    "Weg nicht sehr haeufig benutzt, da nur wenige Spuren auf ihm zu sehen "
    "sind.");
  AddDetail(({"spuren","spur","pferdewagen","wagen"}),
    "Es sind nur wenige Spuren von Pferdewagen zu sehen, daher vermutest Du, "
    "dass der Weg nur recht selten benutzt wird.");
  AddDetail(({"geroellfeld"}),
    "Das Geroellfeld erstreckt sich sicher ueber mehrere hundert Meter nach "
    "Norden, wobei es kontinuierlich ansteigt. Die Bergflanken links und "
    "rechts kommen sich dabei immer naeher, so dass sich sich ganz oben auf "
    "dem Pass beinahe beruehren. Dort scheint ein schmaler Hohlweg ueber den "
    "Berggrat zu fuehren. In weiten Kurven zieht sich der schmale Weg das "
    "Geroellfeld hinauf.");
  AddDetail("bergflanken",
    "Rechts und links des Geroellfeldes steigen die Bergflanken steil an, so "
    "dass sie richtige Felswaende bilden. Die beiden Felswaende werden nach "
    "oben hin immer steiler und hoeher, um sich schliesslich auf der "
    "Passhoehe beinahe zu Treffen und dort einen schmalen Hohlweg zu bilden, "
    "der sich ueber den Berggrat zieht.");
  AddDetail(({"pass","berggrat","grat","uebergang"}),
    "Ganz oben im Norden, wo sich die Felswaende beinahe treffen fuehrt ein "
    "schmaler Hohlweg ueber den Berggrat. Rechts und links des Hohlweges "
    "steigt das Gelaende steil an auf zwei hohe, schneebedeckte Bergkuppen "
    "zu. Einen solchen Uebergang ueber einen Bergrat nennt man auch Pass, "
    "denn es ist die einzige Stelle, an der man mehr oder weniger problemlos "
    "den Grat ueberqueren kann.");
  AddDetail(({"felsbrocken","felsen","brocken","fels"}),
    "Hier liegen Felsbrocken in den unterschiedlichsten Groessen, von "
    "Kieselgroesse bis weit ueber Mannshoehe. Dazwischen wachsen die "
    "schoensten Wildblumen.");
  AddDetail(({"bergkuppen","bergkuppe","kuppen","kuppe"}),
    "Zwei hohe, tief verschneite Bergkuppen erheben sich zu beiden Seiten "
    "des Hohlwegs.");
  AddDetail(({"felswaende","felswand","waende","wand","seiten","seite"}),
    "Rechts und links des Geroellfeldes sind an den Seiten hohe Felswaende, "
    "die nach oben hin immer steiler werden und schliesslich einen "
    "schmalen Hohlweg ueber den Pass bilden.");
  AddDetail(({"wildblumen","blumen","blueten","bluete","wildblume","blume"}),
    "Die schoensten Wildbluemn wachsen hier zwischen dem ganzen Geroell. Sie "
    "haben wunderbare, durftende Blueten. Vielleicht koenntest Du einige "
    "pfluecken?");
  AddDetail(({"insekten","insekt","bienen","biene","schmetterlinge","schmetterling"}),
    "Bienen, Schmetterlinge und andere kleine Insekten fliegen hier zwischen den "
    "Blueten hin und her, immer auf der Suche nach Nahrung.");
  AddDetail(({"nahrung","bluetenstaub","staub"}),
    "Fuer die Insekten ist der Bluetenstaub eine hervorragende Nahrung.");
  AddCmd(({"pfluecke","pflueck"}),"pflueck_fun");
  AddSmell(DEFAULT_SMELL,"Es riecht nach Blumen.");
  AddSmell(({"wildblumen","blumen","blueten","bluete","wildblume","blume"}),
    "Die Blumen riechen herrlich.");

  AddExit("nordoben",ROOM"/roombb0");
  AddExit("norden",ROOM"/roombb0");
  AddExit("suedwestunten","/d/gebirge/angrox/4elem/room/weg/berg_r4");
  AddExit("suedwesten","/d/gebirge/angrox/4elem/room/weg/berg_r4");
  SetProp(P_HIDE_EXITS,({"norden","suedwesten"}));
}

reset()
{
  ::reset();
  if (blumen<2)
    blumen++;
}

int pflueck_fun(string str)
{
  object strauss;

  notify_fail("Was moechtest Du pfluecken?\n");
  if (-1==member(({"blume"
                 ,"blumen"
                 ,"wildblume"
                 ,"wildblumen"
                 ,"blumenstrauss"
                 ,"wildblumenstraus"}),str))
    return 0;
  notify_fail("Leider stehen hier nicht mehr genug Wildblumen.\n");
  if (blumen<1)
    return 0;
  strauss=clone_object(OBJ"/blumenstrauss");
  if (ME_TOO_HEAVY==strauss->move(TP,M_GET|M_SILENT))
  {
    tell_object(TP,BS(
      "Soviel kannst Du nicht mehr tragen, also laesst Du die Blumen stehn."));
    strauss->remove();
    return 1;
  }
  tell_object(TP,BS("Du pflueckst einen wunderschoenen Strauss Wildblumen."));
  tell_room(TO,BS(
    TP->Name()+" pflueckt einen wunderschoenen Straus Wildblumen."),({TP}));
  blumen--;
  return 1;
}