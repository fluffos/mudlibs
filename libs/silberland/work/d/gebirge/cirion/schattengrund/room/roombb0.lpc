#include "/d/gebirge/cirion/schattengrund/schattengrund.h"

inherit "std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Auf einem Pass");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_INT_LONG,
    "Du stehst nun am Ende eines schmalen Hohlweges, der ueber den "
    "Gebirgspass fuehrt. Links und rechts steigen die Felswaende steil "
    "an zu zwei schneebedeckten Gipfeln hinauf, im Sueden kannst Du eine "
    "Menge weiterer Gipfel erkennen. Noerdlich vor Dir oeffnet sich ein "
    "kleines Gebirgstal, welches in einem tiefen Einschnitt des Gebirges "
    "liegt. Rundum liegen hohe Bergketten, doch das Tal ist gross genug, "
    "um von der Sonne noch reichlich bedacht zu werden. Direkt vor Dir "
    "schlaengelt sich eine schmale Wagenspur den Hang hinab in das Tal.");

  AddDetail(({"weg","hohlweg","boden"}),
    "Ein schmaler Weg schlaengelt sich hier zwischen den beiden Felswaenden "
    "entlang, um dann im Norden hinunter in das Gebirgstal zu fuehren. Der "
    "Weg ist gerade breit genug, dass ein Pferdefuhrwerk bequem auf ihm "
    "fahren kann.");
  AddDetail(({"einschnitt"}),
    "Das Tal liegt zwar tief eingeschnitten und geschuetzt, aber es ist gross "
    "genug, dass ausreichend Sonnenlicht hier hinunterfaellt.");
  AddDetail(({"felswaende","felswand","waende","wand"}),
    "Die Felswaende steigen sicher zu beiden Seiten 15 Meter fast senkrecht "
    "an, um dann in eine etwas wengiger steile Steigung auf die "
    "schneebedeckten Gipfel ueberzugehen.");
  AddDetail(({"haus","herrenhaus"}),
    "Am nordoestlichen Ende des Tals steht ein grosses, altes Herrenhaus. "
    "Von hier aus kannst Du nicht viel mehr erkennen, als dass es zwei "
    "Stockwerke hat, und nach Westen hin eine grosse Eingangstuer.");
  AddDetail(({"stockwerke","tuer","eingangstuer"}),
    "Um das zu betrachten, musst Du schon naeher auf das Haus zugehen.");
  AddDetail(({"gebirge","berge","bergketten"}),
    "Das kleine Tal wird rundum eingeschlossen von hohen Bergen, die zu "
    "besteigen fast unmoeglich erscheint. Daher ist hier der einzige Weg, "
    "um in das Tal zu gelangen. Allein im Norden des Tals scheint ein "
    "schmaler Pfad an den Bergen emporzufuehren.");
  AddDetail(({"gipfel","ferne","horizont"}),
    "Die Gipfel runherum sind schneebedeckt und erstrecken sich in die "
    "Ferne bis zum Horizont.");
  AddDetail(({"pass","gebirgspass"}),
    "Du stehst auf einem schmalen Pass, der ueber den Gebirgsgrat in das Tal "
    "hinunter fuehrt.");
  AddDetail(({"tal","gebirgstal"}),
    "Der Weg fuehrt hinab in das Tal und schlaengelt sich dort durch weite, "
    "bluehende Wiesen und gruene Felder. Ein kleiner Bach fliesst quer durch "
    "das Tal, und im Westen befindet sich ein kleines Waeldchen. Ganz am "
    "Ende des Tals, eher im Osten, kannst Du ein grosses, altes Herrenhaus "
    "erkennen. Wenn Dich nicht alles taeuscht, muss es sich hier um den "
    "beruehmten Schattengrund handeln.");
  AddDetail(({"wiesen"}),
    "Bluehende Wiesen mit weidendem Vieh liegen unten im Tal.");
  AddDetail(({"vieh","rinder"}),
    "Rinder weiden unten auf den bluehenden Wiesen.");
  AddDetail(({"felder"}),
    "Weite gruene Felder liegen unten im Tal. Dazwischen erkennst "
    "Du auch einige Bauernhaeuser.");
  AddDetail(({"bach","schattenbach"}),
    "Wenn das Tal hier der Schattengrund ist, dann muss das wohl der "
    "Schattenbach sein. Er entspringt scheinbar irgendwo im westlichen "
    "Teil des Gebirges, denn von dort kommt er als schmaler, glitzernder "
    "Wasserfall in den Wald herabgestuertzt. Ziemlich in der Mitte des Tales "
    "kommt er aus dem Wald geflossen, um dann nach Suedosten weiterzufliessen.");
  AddDetail(({"wasserfall"}),
    "Ein schmaler, silbrig glitzernder Wasserfall faellt im Westen des Tals "
    "von den Bergen herab, um dort im Wald zu verschwinden.");
  AddDetail(({"waeldchen","wald","westhaelfte"}),
    "Das Waeldchen erstreckt sich fast ueber die ganze Westhaelfte des Tales. "
    "Viele grosse, alte Baeume stehen dort, und der Wald strahlt in einem "
    "kraeftigen dunkelfgruen.");
  AddDetail(({"baeume"}),
    "Du solltest das vielleicht mal aus der Naehe betrachten.");
  AddDetail(({"haeuser","bauernhaeuser","fachwerkhaeuser"}),
    "Von hier oben sehen die kleinen Fachwerkhaeuser niedlich und klein aus.");
  AddDetail(({"pfad"}),
    "Der Pfad windet sich in engen Kurven am Gebirge nach oben, er scheint "
    "bis zu einem kleinen blumenbewachsenen,Plateau zu fuehren.");
  AddDetail(({"plateau"}),
    "Als Du ganz genau hinsiehst, kannst Du erkennen, dass die Blumen "
    "scheinbar auf einer Ruine wachsen.");
  AddDetail(({"blumen"}),
    "Bunte Blumen, Du kannst sie vonhier nicht so genau erkennen.");
  AddDetail(({"ruine","grundflaeche"}),
    "Du kannst nicht erkennen, was das einmal gewesen sein kann, aber es "
    "scheint eine recht grosse Grundflaeche gehabt zu haben, das es das "
    "ganze Plateau auszufuellen scheint.");
  AddDetail(({"hang"}),
    "Der Hang, der von hier oben hinunter ins Tal fuehrt ist nicht ganz so "
    "steil wie die uebrigen Berge ringsum. Daher fuehrt hier eine schmale "
    "Wagenspur ins Tal hinab.");
  AddDetail(({"spur","wagenspur"}),
    "Die Wagenspur beginnt hier oben am Ende des Hohlweges und fuehrt in "
    "weiten Boegen ins Tal hinab. Dort schlaengelt sie sich durch die "
    "Wiesen und Felder, um schliesslich zu dem Herrenhaus am Ostende des "
    "Tals zu fuehren.");

  AddExit("nordostunten",ROOM"/roomcc0");
  AddExit("nordosten",ROOM"/roomcc0");
  AddExit("suedunten",ROOM"/roomba0");
  AddExit("sueden",ROOM"/roomba0");
  SetProp(P_HIDE_EXITS,({"nordosten","sueden"}));
}
