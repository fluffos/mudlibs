#include "/d/gebirge/cirion/schattengrund/schattengrund.h"
#include "/players/cirion/seasond/seasond.h"

inherit WIESENWEG;

void create()
{  	
  ::create();
}

void static_create()
{
 ::static_create();

  AddExit("suedwesten",ROOM"/roomcd0");
  AddExit("norden",ROOM"/roomdf0");
  AddExit("westen",ROOM"/roomce0");
  AddExit("osten",ROOM"/roomee0"); 
}

void remove_all()
{
  ::remove_all();
  
}

void spring()
{
  ::spring();
  SetProp(P_INT_LONG,
    "Du stehst auf einem von Bueschen gesaeumten Feldweg, der hier mitten "
    "durch die frischen gruenen Wiesen und Felder fuehrt. In einigen "
    "Abstaenden stehen auch immer mal wieder Baeume am Wegesrand. Der "
    "Weg selbst ist teils grasbewachsen "
    "und breit genug, um einem Fuhrwerk Platz zur Durchfahrt zu gewaehren."
    "Hier verzweigt sich der Weg. Im Osten fuehrt er "
    "geradewegs auf das grosse, zweistoeckige Herrenhaus zu, welches Du "
    "schon vorhin sehen konntest, waehrend er nach Westen hin weiter "
    "durch die Wiesen und Felder auf den fernen Wald zulaeuft.");
  AddDetail(({"osten"}),
    "Nach Osten hin fuehrt der Weg geradewegs auf das alte, zweistoeckige "
    "Herrenhaus zu, welches man von fast ueberall hier im Tal sehen kann.");  
  AddDetail(({"westen"}),
    "Im Westen liegen noch mehr Wiesen und Felder, und auch ein Bauernhaus "
    "meinst Du erkennen zu koennen. Ganz im Westen liegt eine grosser Wald.");  
  AddDetail(({"herrenhaus","haus"}),
    "Das Herrenhaus liegt noch ein Stueckchen weiter im Osten. Es ist ein "
    "zweistoeckiges, grosses Haus aus grauem Gestein, das schon recht alt, "
    "aber keineswegs ungepflegt aussieht.");  
  AddDetail(({"gestein"}),
    "Von hier aus kannst Du nicht viel mehr erkennen, als dass das Gestein "
    "grau ist.");  
  AddDetail(({"stueckchen"}),
    "Naja, besonders weit ist es nicht mehr.");  
  AddDetail(({"wald"}),
    "Der Wald ist frischgruen und wirkt aus der Ferne ruhig. Er ist sicher "
    "ein sehr erholsamer Ort.");  
  AddDetail(({"ferne"}),
    "Bis dort ist es schon ein Stueck Weg.");  
  AddDetail(({"bauernhaus"}),
    "Im Nordwesten kannst Du in der Ferne ein kleines Bauernhaus erkennen.");  
  AddDetail(({}),
    "");  
}
void summer()
{
  ::summer();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "Hier verzweigt sich der Weg. Im Osten fuehrt er "
    "geradewegs auf das grosse, zweistoeckige Herrenhaus zu, welches Du "
    "schon vorhin sehen konntest, waehrend er nach Westen hin weiter "
    "durch die bluehenden Wiesen und reifenden Felder auf den dunklen, "
    "gruenen Wald zulaeuft.");
  AddDetail(({"herrenhaus","haus"}),
    "Das grosse, zweistoeckige Herrenhaus steht noch etwas weiter oestlich "
    "von hier. Es besteht fast voellig aus grauem Gestein und scheint schon "
    "ziemlich alt zu sein, wenn auch nicht ungepflegt.");  
  AddDetail(({"gestein","steine"}),
    "Schwere, graue Steine sind es, aus denen das Haus erbaut wurde.");  
  AddDetail(({"westen"}),
    "Weit im Westen liegt der dunkelgruene Wald. Davor und auch rund um Dich "
    "herum liegen bluehende Wiesen und reifende Felder, und im Nordwesten "
    "meinst Du zwischen einige Baeumen und Straeuchern auch ein kleines "
    "Bauernhaus erkennen zu koennen.");  
  AddDetail(({"bauernhaus"}),
    "Das Bauernhaus liegt versteckt zwischen Baeumen und Straeuchern.");  
  AddDetail(({"wald"}),
    "Still liegt der dunkelgruene Wald im Westen.");  
  
}
void autumn()
{
  ::autumn();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "Hier verzweigt sich der Weg. Im Osten fuehrt er "
    "geradewegs auf das grosse, zweistoeckige Herrenhaus zu, welches Du "
    "schon vorhin sehen konntest, waehrend er nach Westen hin weiter "
    "durch die Wiesen und Acker auf den bunten Wald zulaeuft.");
  AddDetail(({"herrenhaus","haus"}),
    "Das grosse, zweistoeckige Herrenhaus steht noch ein wenig weiter im "
    "Osten. Es scheint fast voellig aus grauem Gestein erbaut zu sein, und "
    "sieht schon ziemlich alt, wenn auch nicht ungepflegt aus.");  
  AddDetail(({"gestein"}),
    "Dunkles, graues Gestein ist es, aus dem das Herrenhaus erbaut wurde.");  
  AddDetail(({"westen"}),
    "Im Westen siehst Du den wunderschoenen, bunt leuchtenden Wald in "
    "einiger Entfernung, und im Nordwesten kannst Du zwischen einigen "
    "Baeumen und Straeuchern ein kleines Bauernhaus erkennen.");  
  AddDetail(({"bauernhaus","fachwerkhaus"}),
    "Das Bauernhaus scheint ein kleines Fachwerkhaus zu sein, welches versteckt "
    "zwischen Baeumen und Straeuchern steht.");  
  AddDetail(({"acker"}),
    "Die Felder sind bereits abgeerntet und daher nicht mehr als stoppelige "
    "Acker.");  
  AddDetail(({"wald"}),
    "Der Wald leuchtet wunderschoen in den verschiedensten Farben.");  
  AddDetail(({"farben","farbe"}),
    "Rot, gelb und gruen leuchtet der Wald. Er ist ein wunderschoener Anblick.");  
  
}
void winter()
{
  ::winter();
  SetProp(P_INT_LONG,QueryProp(P_INT_LONG)+
    "Hier verzweigt sich der Weg. Im Osten fuehrt er "
    "geradewegs auf das grosse, zweistoeckige Herrenhaus zu, welches Du "
    "schon vorhin sehen konntest, waehrend er nach Westen hin weiter "
    "durch die verschneiten Wiesen auf den fernen Wald zulaeuft.");
  AddDetail(({"haus","herrenhaus"}),
    "Das Herrenhaus liegt von Dir aus gesehen im Osten. Es ist ein altes, "
    "zweistoeckiges Haus, dessen Dach voellig mit Schnee bedeckt ist. ");  
  AddDetail("dach",
    "Das Dach des Herrenhauses ist voellig mit Schnee zugedeckt.");  
  AddDetail(({"westen"}),
    "Im Westen liegen schneebedeckte Wiesen und in der Ferne der weisse "
    "Wald. Ein wenig im Nordwesten kannst Du eine kleine Erhebung entdecken.");  
  AddDetail(({"erhebung"}),
    "Als Du genauer hinschaust, erkennst Du, dass es sich bei der Erhebung "
    "um ein voellig verschneites Bauernhaus handeln muss.");  
  AddDetail(({"bauernhaus"}),
    "Das Bauernhaus versinkt fast vollstaendig im tiefen Schnee, der hier "
    "ueberall liegt, daher haettest Du es auch beinah uebersehen. Aber jetzt "
    "erkennst Du auch die schmale Rauchfahne, die offenbar aus dem Schornstein "
    "aufsteigt");  
  AddDetail(({"rauchfahne","fahne","rauch"}),
    "Die schmale Rauchfahne steigt aus dem Schornstein des Bauernhauses auf "
    "und ist aus dieser Entfernung kaum zu erkennen.");  
  AddDetail(({"entfernung","stueck"}),
    "Das ist schon noch ein ganzen Stueck zu laufen.");  
  AddDetail(({"schornstein","schneehaufen"}),
    "Vom Schornstein des Hauses ist nicht viel mehr als ein kleiner "
    "Schneehaufen zu sehen, aus dem eine schmale Rauchfahne aufsteigt.");  
  AddDetail(({"wiesen","felder","flaechen","flaeche","wiese","feld"}),
    "Du nimmst einfach an, dass es sich bei den tief verschneiten, weissen "
    "Flaechen rund um Dich herum um Wiesen oder Felder handelt.");  
  AddDetail(({"wald"}),
    "Im Westen kannst Du in der Ferne den tief verschneiten Wald sehen.");  
  
}
