#include "../schattengrund.h"

inherit "std/thing";

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Korken");
  SetProp(P_LONG,
    "Das ist ein kleiner Korken von einer Weinflasche. Auf der Oberseite "
    "ist ein kleines Wappen eingebrannt." );
  SetProp(P_NAME, "Korken");
  SetProp(P_GENDER, MALE);
  AddId("korken");
  SetProp(P_MATERIAL, MAT_CORK );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 0);
  SetProp(P_SMELL,"Der Korken riecht noch ein wenig nach Wein.\n");
  AddDetail(({"wappen"}),
    "Oben auf dem Korken klein das Wappen derer vom Schattengrund eingebrannt.");
  AddDetail(({"oberseite","seite"}),
    "Auf der Oberseite des Korkens ist ein kleines Wappen eingebrannt.");
  AddDetail(({"schattengrund"}),
    "Der Schattengrund ist ein kleines Tal im Gebirge.");
  AddDetail(({"tal","gebirge"}),
    "Das musst Du schon selbst suchen.");
}
