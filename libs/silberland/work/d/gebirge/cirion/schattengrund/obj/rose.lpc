#include "../schattengrund.h"

#define ROSECOLORS ({"dunkelrot","hellrot","gelb","weiss"})

inherit "std/thing";

int color;

create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  color=random(3);
  SetProp(P_SHORT, "Eine "+ROSECOLORS[color]+"e Rose");
  SetProp(P_LONG,
    "Das ist eine wunderschoene, grosse, "+ROSECOLORS[color]+"e Rosebluete mit einem "
    "dunkelgruenen Stiel." );
  SetProp(P_NAME, "Rose");
  SetProp(P_NAME_ADJ,ROSECOLORS[color]);
  SetProp(P_GENDER, FEMALE);
  AddId(({"rose","rosenbluete"}));
  AddAdjective(({ROSECOLORS[color],ROSECOLORS[color]+"e"}));
  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 30);
  SetProp(P_SMELL,"Die Rose duftet herrlich.\n");
  AddDetail(({"stiel"}),
    "Der Stiel ist dunkelgruen und lang. Es sind noch einige Blaetter am "
    "Stiel und vor allem auch spitze Dornen.");
  AddDetail(({"dorn","dornen"}),
    "Die Dornen am Stiel sind spitz und man kann sich daran sicher leicht "
    "verletzen. Trotzdem gehoeren sie zu einer richtigen Rose dazu.");  
  AddDetail(({"blaetter","blatt","rosenblaetter","rosenblatt"}),
    "Einige Rosenblaetter sind noch am Stiel.");  
}