#include "../schattengrund.h"

inherit "std/thing";

private int amount;
private string wine;

create() {
  if (!is_clone(TO)) return;
  ::create();
  wine="rot";
  amount=700; // Milliliter
  SetProp(P_SHORT, "Eine "+CAP(wine)+"weinpfuetze");
  SetProp(P_LONG,
    "Das ist eine grosse Pfuetze von "+CAP(wine)+"wein.");
  SetProp(P_NAME, CAP(wine)+"weinpfuetze");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wein",wine+"wein",wine+"weinpfuetze","weinpfuetze","pfuetze"}));

  SetProp(P_MATERIAL, ([MAT_MISC_FLUID:100,MAT_MISC_FOOD:100]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL,"Was soll ich denn damit?\n");
  SetProp(P_NOGET, "Na, wie moechtest du denn eine Pfuetze aufnehmen?\n");
}

int TrinkWein(object pl,int schluck)
{
  if (!objectp(pl)||!living(pl))
    return 0;
  if (!intp(schluck)||schluck<1)
    return 0;
  if (amount<schluck)
    schluck=amount;
  if (!pl->drink_soft(schluck/10))
    return 0;
  schluck=-TO->AddAmount(-schluck);
  if (!pl->drink_alcohol(schluck/15))
    return 0;
  pl->AddHp(schluck/25);
  return schluck; 
}

int _query_value()
{
  return (amount*2);
}

int _query_weight()
{
  return amount;
}

string SetWine(string newwine)
{
  if (!stringp(newwine))
    return 0;
  if (wine!="rot"&&wine!="weiss")
    return 0;
  wine=newwine;
  return wine;
}

int SetAmount(int newamount)
{
  if (!intp(newamount))
    return 0;
  if (newamount<1)
    return 0;
  amount=newamount;
  return amount;
}

int AddAmount(int addamount)
{
  if (!intp(addamount))
    return 0;
  if (-addamount>=amount)
  {
    addamount=-amount;
    call_out("remove",0);
  }
  amount+=addamount;
  return addamount;
}