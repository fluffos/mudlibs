#include "../schattengrund.h"

inherit "std/thing";

create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein wunderschoener Wildblumenstrauss");
  SetProp(P_LONG,
    "Das ist ein wunderschoener Wildblumenstrauss. Er besteht aus den "
    "verschiedensten Blumen und ist sicher muehevoll gepflueckt worden." );
  SetProp(P_NAME, "Wildblumenstrauss");
  SetProp(P_NAME_ADJ,"wunderschoen");
  SetProp(P_GENDER, MALE);
  AddId(({"strauss","blumenstrauss","wildblumenstrauss"}));

  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 200);
  
  AddDetail(({"blume","blumen","bluete","blueten","wildblume","wildblumen"}),
    "Der Blumenstrauss besteht aus den verschiedensten Wildblumen, die "
    "herrlich bunte und duftende Blueten haben.");
  
  AddCmd(({"riech","rieche"}),"riech_fun");
}

reset()
{
  ::reset();
  switch (SEASOND->QuerySeason())
  {
    case SUMMER:
      break;
    case AUTUMN:
      tell_object(TP,BS("Dein Wildblumenstrauss beginnt zu verwelken."));
      SetProp(P_SHORT,"Ein verwelkter Wildblumenstrauss");
      SetProp(P_LONG,
        "Das war einmal ein wunderschoener Wildblumenstrauss. Nun ist er "
        "verwelkt und gar nicht mehr so schoen.");
      SetProp(P_NAME_ADJ,"verwelkt");
      RemoveDetail(0);
      break;
    case WINTER:
      tell_object(TP,BS("Dein Wildblumenstrauss ist vertrocknet."));
      SetProp(P_SHORT,"Ein vertrockneter Wildblumenstrauss");
      SetProp(P_LONG,
        "Das war einmal ein wunderschoener Wildblumenstrauss, doch nun "
        "ist er verwelkt und vertrocknet, er ist schon ganz braun.");
      SetProp(P_NAME_ADJ,"vertrocknet");
      RemoveDetail(0);
      break;
    default:
      tell_object(TP,BS(
        "Der Wildblumenstrauss ist endgueltig verrottet und zerfaellt zu "
        "Staub."));
      remove();
      break;
  }
}

int riech_fun(string arg)
{
  notify_fail("Woran moechtest Du riechen?\n");
  if (-1==member(({"an blumenstrauss"
                  ,"an strauss"
                  ,"an wildblumenstrauss"
                  ,"strauss"
                  ,"blumenstrauss"
                  ,"wildblumenstrauss"
                  ,"blueten"
                  ,"bluete"
                  ,"blumen"
                  ,"blume"
                  ,"wildblumen"
                  ,"wildblume"
                  }),arg))
    return 0;
  switch (SEASOND->QuerySeason())
  {
    case SUMMER:
      tell_object(TP,BS("Der Wildblumenstrauss duftet herrlich nach Sommer "
        "und laesst Dich fuer einen Augenblick Deine Sorgen vergessen."));
      tell_room(ENV(TP),BS(TP->Name()+" riecht mit einem gluecklichen "
        "Gesichtsausdruck an einem Wildblumenstrauss"),({TP}));
      break;
    case AUTUMN:
      tell_object(TP,BS("Der verwelkte Wildblumenstrauss riecht schon "
        "reichlich vergammelt."));
      tell_room(ENV(TP),BS(TP->Name()+" riecht an einem verwelkten "
        "Wildblumenstrauss und verzieht das Gesicht."),({TP}));
      break;
    case WINTER:
      tell_object(TP,BS("Der vertrocknete Wildblumenstrauss riecht nach "
        "gar nichts mehr."));
      tell_room(ENV(TP),BS(TP->Name()+" riecht an einem vertrockneten "
        "Wildblumenstrauss."),({TP}));
      break;
    default:
      tell_object(TP,BS("Der Wildblumenstrauss ist schon ueber seine Zeit "
        "hinaus und zerfaellt zu Staub."));
      tell_room(ENV(TP),BS(TP->Name()+" moechte an einem Wildblumenstrauss "
        "riechen, doch dieser zerfaellt zu Staub."),({TP}));
      remove();
      break;
  }
  return 1;
}    