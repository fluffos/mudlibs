#include "../schattengrund.h"

inherit "std/thing";

create() {}

init()
{
  if (!TP)
  {
    remove();
    return;
  } 
  if (!query_once_interactive(TP))
  {
    remove();
    return;
  }
  clone_object(OBJ"/weinflasche")->move(TP,M_NOCHECK);
  clone_object(OBJ"/weinglas")->move(TP,M_NOCHECK);
  clone_object(OBJ"/weinglas")->move(TP,M_NOCHECK);
  clone_object(WEAPON"/korkenzieher")->move(TP,M_NOCHECK);
  remove();
  return;
}