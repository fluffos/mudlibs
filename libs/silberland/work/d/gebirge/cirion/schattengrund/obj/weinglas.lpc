#include "../schattengrund.h"

inherit "std/thing";

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kristallenes Weinglas");
  SetProp(P_LONG,
    "Das ist ein edel geformtes Weinglas aus feinstem Kristall. Es glitzert "
    "und funkelt im Licht. Auf dem Fuss des Glases ist ganz fein das Wappen "
    "derer vom Schattengrund eingraviert." );
  SetProp(P_NAME, "Weinglas");
  SetProp(P_NAME_ADJ,"kristallen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"weinglas","glas","kristallglas"}));
  AddAdjective(({"kristallenes","kristallenen"}));
  SetProp(P_MATERIAL, ([MAT_GLASS:70,MAT_QUARTZ:30]) );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 450);
  AddCmd(({"trink","trinke"}),"trink_fun");
}

int trink_fun(string str)
{
  notify_fail("Was oder woraus moechtest Du denn trinken?\n");
  if (-1==member(({"an glas","an weinglas","an kristallglas",
                   "aus glas","aus weinglas","aus kristallglas",
                   "wein"}),str))
    return 0;
  notify_fail("Dazu brauchst Du mindestens eine freie Hand.\n");
  if (2==TP->QueryProp(P_USED_HANDS))
    return 0;
  notify_fail("Das Weinglas ist doch leer.\n");
  if (!present("wein",TO))
    return 0;
  tell_object(TP,BS(
    "Du nippst an Deinem Weinglas."));
  tell_room(ENV(TP),BS(
    TP->Name()+" nippt an seinem Weinglas."),({TP}));
  present("wein",TO)->TrinkWein(TP,15);
  return 1;  
}

int Fill(string filename,int menge)
{
  object inv;
  int weight,retval; 
  
  weight=0;
  retval=1;
  for (inv=first_inventory(TO);inv;inv=next_inventory(inv)) 
  {
    weight+=inv->QueryProp(P_WEIGHT);
  }
  for (inv=first_inventory(TO);inv;inv=next_inventory(inv)) 
  {
    if (file_name(inv)==filename)
      break;
  }
  if ((weight+menge)>101)
  {
    menge=(100-weight);
    retval=0;
  }
  if (!inv)
  {
    sscanf(filename,"%s#",filename);
    inv=clone_object(filename);
    inv->move(TO,M_NOCHECK);
    inv->SetAmount(menge);
  }
  else
  {
    inv->AddAmount(menge);
  }
  return retval;
}

remove()
{
  object inv,next;
  for(inv=first_inventory(TO);inv;)
  {
    next=next_inventory(inv);
    inv->remove();
    inv=next;
  }
  return::remove();
}