#include <properties.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Sackgasse");

  SetProp(P_INT_LONG,
    "Du betrittst eine kreisrunde Flaeche, die nach allen Seiten "
    "von schier endlos hohen Felswaenden umschlossen ist. Weit oben "
    "kannst Du den Himmel sehen, und es scheint, als gaebe es hier keinen "
    "anderen Weg raus, als den, durch den Du hier hergekommen bist.");

  AddDetail( ({ "flaeche" }),
    "Die Flaeche ist vollkommen rund, und hat einen Durchmesser von "
    "etwa fuenf grossen Schritten.");
  AddDetail( ({ "seiten" }),
    "Die Flaeche scheint nach allen Seiten von Felswaenden - oder vielmehr "
    "einer durchgehenden Wand begrenzt zu sein.");
  AddDetail( ({ "felswaende", "felswaenden" }),
    "Eigentlich ist es vielmehr eine einzige Felswand, die hier einen "
    "runden Platz bildet.");
  AddDetail( ({ "fels", "felswand" }),
    "Der Fels bildet hier keinerlei Spalten oder risse in denen mal Halt "
    "finden koennte.");
  AddDetail( ({ "platz" }),
    "Ein Streich der Natur, oder ein Spielplatz der Goetter? Wer weiss...");
  AddDetail( ({ "himmel", "blau" }),
    "Hoch oben kannst Du das Blau des Himmels sehen.");
  AddDetail( ({ "weg" }),
    "Der einzige Weg raus ist jener, durch den Du gekommen bist.");
}


