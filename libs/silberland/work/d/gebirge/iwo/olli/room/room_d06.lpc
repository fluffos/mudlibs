inherit "std/room";

#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types



void create()
{

  ::create();

  SetProp(P_INT_SHORT, "Inmitten einer grasbewachsenen Ebene");

  SetProp(P_INT_LONG,
    "Wohin Du Dich auch wendest, ueberall siehst Du nur Gras. "
    "Die Ebene hier scheint das Paradies fuer alle Wiederkaeuer "
    "zu sein. Hoch droben am Himmel steht strahlend die Sonne "
    "und hie und da bewegen sich die Graeser im Wind.");

  AddDetail( ({ "gras" }), "Das Gras hier ist saftig gruen.");
  AddDetail( ({ "paradies" }), "Naja, Du bist ja keine Kuh, "
    "aber ansonsten waers eins fuer Dich.");
  AddDetail( ({ "wiederkaeuer", "kaeuer" }),
    "Schafe und Kuehe sind welche davon, aber davon siehst Du hier "
    "keine.");
  AddDetail( ({ "himmel", "himmels" }),
    "Inmitten des blauen Himmels steht strahlend hell die Sonne.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint, und erhellt dadurch die Umgebung.");
  AddDetail( ({ "umgebung" }),
    QueryProp(P_INT_LONG));
  AddDetail( ({ "graeser" }),
    "Gelegentlich wogen die hiesigen Graeser sanft im Wind.");
  AddDetail( ({ "wind" }),
    "Nicht, dass Du ihn sehen koenntest, jedoch laesst die Bewegung "
    "der Graeser darauf schliessen, dass er trotzdem existiert.");
  AddDetail( ({ "bewegung" }),
    "Es handelt sich hierbei um ein leichtes Schwanken.");
  AddDetail( ({ "schwanken" }),
    "Du wirst irgendwie seekrank davon.");
  AddDetail( ({ "boden" }),
    "Den Boden kannst Du nicht wirklich erkennen, da das doch recht "
    "dichte Gras den Blick dorthin verwehrt.");
  AddDetail( ({ "blick" }),
    "Wenn Du nur sehen koenntest, wie dumm Du nun schaust.");
  AddDetail( ({ "kuh", "kuehe" }),
    "Du siehst viele rosa Kuehe.");
  AddDetail( ({ "ebene" }),
    QueryProp(P_INT_LONG));

  AddExit("norden", ROOM "room_e06");
  AddExit("nordosten", ROOM "room_e07");
  AddExit("osten", ROOM "room_d07");
  AddExit("westen", ROOM "room_d05");
  AddExit("nordwesten", ROOM "room_e05");  
}


