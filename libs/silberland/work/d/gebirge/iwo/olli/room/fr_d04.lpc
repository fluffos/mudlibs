#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types

inherit "std/room";


void create()
{
  if (is_clone(this_object())) return;

  ::create();

  AddId( ({ "\nfelsraum" }) );

  SetProp(P_INT_SHORT, "Inmitten einer grasbewachsenen Ebene");

  SetProp(P_INT_LONG,
    "Hier, inmitten der gruenen Idylle truebt nur der haessliche "
    "Brocken nordwestlich von Dir das sonst so malerische Bild. "
    "Das Gras wiegt sich sanft im Wind, und Du wuestest nicht, was "
    "Du lieber taetest, als hier ein wenig zu rasten.");
  
  AddDetail( ({ "idylle" }),
    "Dir faellt ein, dass Du etwas in der Art schoneinmal gesehen "
    "hast.");
  AddDetail( ({ "art" }),
    "Dies ist wirklich von einer kranken solchen.");
  AddDetail( ({ "brocken" }),
    "Naja, eigentlich ist es mehr ein felsen, was nichts daran "
    "aendert, dass er absolut haesslich ist.");
  AddDetail( ({ "felsen" }),
    "Daran kannst Du nicht viel mehr erkennen, als dass er grau, "
    "hart, kantig und nicht zu klein ist.");
  AddDetail( ({ "bild" }),
    "Als Du kurz Deine Augen schliesst, erkennst Du ein "
    "Kaestchen aus einem seltsamen Material mit etwas durchsichtigem "
    "vorne dran. Dahinter liegen verstreut irgendwelche winzigen "
    "Bildchen, und dahinter fuellt diese gruene Idylle den rest "
    "dieser bizarren Vision.");
  AddDetail( ({ "material", "kaestchen", "bildchen", "vision" }),
    "Leider ist die Vision schonwieder weg.");
  AddDetail( ({ "gras" }),
    "Wie Du tief drinnen schon vorher wusstest, ist das Gras "
    "gruen. Es bewegt sich sanft im Wind.");
  AddDetail( ({ "wind" }),
    "So sehr Du Dich anstrengst, kannst Du den Wind dennoch nicht "
    "sehen.");
  AddDetail( ({ "augen" }),
    "Du schielst, was das Zeug haelt, kannst aber trotzdem Deine "
    "eigenen Augen nicht sehen.");
  AddDetail( ({ "zeug" }),
    "Zeug halt, nicht weiter wichtig.");
  AddDetail( ({ "boden" }),
    "Der Boden unter Deinen Fuessen ist fest, eben und mit Gras "
    "bewachsen.");
  AddDetail( ({ "fuessen", "fuesse" }),
    "Du stehst mit Deinen Fuessen fest am Boden.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist strahlend blau. Ein paar kleine Woelkchen ziehen "
    "unberuehrt durch Dich ziellos ihres Weges.");
  AddDetail( ({ "woelkchen", "wolken" }),
    "Die Woelkchen sind weiss und sehen fast aus wie "
    "Watte. ");
  AddDetail( ({ "watte" }),
    "Gibt es hier nicht, nur die Wolken sehen aus, als bestaenden sie "
    "daraus.");
    

  AddCmd ( ({ "kletter", "klettere" }), "cmd_climb");

  AddExit( "norden", ROOM "fr_e04.lpc");
  AddExit( "westen", ROOM "fr_d03.lpc");
  AddExit( "suedwesten", ROOM "room_c03.lpc");
  AddExit( "nordosten", ROOM "room_e05");
  AddExit( "osten", ROOM "room_d05");

}

int cmd_climb(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (str != "auf fels" && str != "auf felsen")
    return 0;

  TP->move(ROOM "fels.lpc", M_GO, "auf den Felsen", "klettert", 
    "kommt heraufgeklettert");

  return 1;  
}


