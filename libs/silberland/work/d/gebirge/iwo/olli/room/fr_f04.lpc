#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types

inherit "std/room";


void create()
{
  if (is_clone(this_object())) return;

  ::create();

  AddId( ({ "\nfelsraum" }) );

  SetProp(P_INT_SHORT, "Inmitten einer grasbewachsenen Ebene");

  SetProp(P_INT_LONG,
    "Waehrend suedwestlich von Dir ein gewaltiger Felsen mitten "
    "im Gras liegt, breitet sich in alle anderen Richtungen "
    "eine ueppige, grasbewachsene Ebene aus. Die saftigen "
    "Halme wogen sanft im Wind, und die Sonne lacht Dich "
    "strahlend aus.");

  AddDetail( ({ "felsen", "fels", "brocken", "felsbrocken" }),
    "Steinhart liegt der massive Felsbrocken vor Dir.");
  AddDetail( ({ "gras" }),
    "Eigentlich ist es kaum besonders. Es ist gruen, saftig "
    "und voellig uninteressant fuer Dich.");
  AddDetail( ({ "richtungen" }),
    "Davon gibt es viele, geh sie einfach entlang!");
  AddDetail( ({ "ebene" }),
    "Du staunst, dass sie tatsaechlich eben ist, denkst aber "
    "nicht weiter darueber nach.");
  AddDetail( ({ "halme", "grashalme", "grashalm" }),
    "Die Grashalme bestehen eigentlich vollstaendig aus Gras, "
    "und dass Dich dieses nicht sonderlich interessiert, hast "
    "Du ja schon festgestellt.");
  AddDetail( ({ "wind" }),
    "Der Wind weht froehlich von einem Grashalm zum naechsten.");
  AddDetail( ({ "sonne" }),
    "Sie ist schon ganz gelb vor lauter lachen.");
  AddDetail( ({ "boden" }),
    "Der Boden unter Dir wirkt relativ fest, und durch das viele "
    "Gras auch relativ gruen.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist blau, weil sich in ihm das Meer spiegelt.");
  AddDetail( ({ "meer" }),
    "Das Meer ist blau, weil sich darin der Himmel spiegelt. "
    "Angeschmiert, was?");
  
  AddCmd ( ({ "kletter", "klettere" }), "cmd_climb");

  AddExit( "westen", ROOM "fr_f03.lpc");
  AddExit( "sueden", ROOM "fr_e04.lpc");
  AddExit( "nordwesten", ROOM "room_g03");
  AddExit( "osten", ROOM "room_f05.lpc");
  AddExit( "nordosten", ROOM "room_g05.lpc");
  AddExit( "suedosten", ROOM "room_e05");
}

int cmd_climb(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (str != "auf fels" && str != "auf felsen")
    return 0;

  TP->move(ROOM "fels.lpc", M_GO, "auf den Felsen", "klettert", 
    "kommt heraufgeklettert");

  return 1;  
}


