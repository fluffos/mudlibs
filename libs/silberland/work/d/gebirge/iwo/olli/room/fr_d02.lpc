#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types

inherit "std/room";


void create()
{
  if (is_clone(this_object())) return;

  ::create();

  AddId( ({ "\nfelsraum" }) );

  SetProp(P_INT_SHORT, "Inmitten einer grasbewachsenen Ebene");

  SetProp(P_INT_LONG,
    "Die leichte Brise hier regt die umliegenden Grashalme "
    "sanft an sich rhytmisch im Takt zu bewegen. Nichts "
    "schiene diese malerische Idylle zu stoeren, laege "
    "da micht direkt nordoestlich von Dir ein kantiger "
    "Felsbrocken.");

  AddDetail( ({ "brise" }),
    "Jemand hat wohl zwei Finger in eine Tuete Wind gesteckt, "
    "und diese dann hierher runterrieseln lassen.");
  AddDetail( ({ "tuete" }),
    "Eine uebliche voller Wind halt.");
  AddDetail( ({ "wind" }),
    "Nicht, dass Du den besonders gut sehen koenntest, "
    "dennoch weisst Du, dass er da ist.");
  AddDetail( ({ "finger" }),
    "Kleine, wurstartige Dinger, innen knusprig - wahrscheinlich "
    "hast Du auch welche davon.");
  AddDetail( ({ "takt" }),
    "Kurz schwingst Du im Takt mit, stellst jedoch fest, dass "
    "Dir davon uebel wird.");
  AddDetail( ({ "idylle" }),
    "Hier ist es beinahe schon kitschig schoen.");
  AddDetail( ({ "felsbrocken", "fels" }),
    "Der massive Felsbrocken liegt hier voellig ungeniert "
    "pudelnackt inmitten der ansonsten so fehlerfreien "
    "Ebene.");
  AddDetail( ({ "ebene" }),
    "Absolut eben halt.");
  AddDetail( ({ "himmel" }),
    "Die Sonne beschiesst froehlich die Ebene mit ihren "
    "Strahlen.");
  AddDetail( ({ "sonne" }),
    "Die haengt da oben am Himmel und verstrahlt Dich.");
  AddDetail( ({ "strahlen" }),
    "Sie sehen zwar nicht besonders gefaehrlich aus, aber "
    "trotzdem sind sie Dir nicht gaz geheuer.");
  AddDetail( ({ "dinger" }),
    "Diese Dinger nennen sich Finger.");
  AddDetail( ({ "grashalme", "halme" }),
    "Hierbei handelt es sich um schmale, gruene Halme "
    "aus Gras. Du bist erstaunt.");
  AddDetail( ({ "gras" }),
    "Es ist gruen, umgibt Dich und laesst sich nicht rauchen.");
  AddDetail( ({ "boden" }),
    "Du bist voellig begeistert, herausgefunden zu haben, "
    "dass der Boden mit Gras bewachsen ist.");



  AddCmd ( ({ "kletter", "klettere" }), "cmd_climb");

  AddExit( "norden", ROOM "fr_e02.lpc");
  AddExit( "osten", ROOM "fr_d03.lpc");
  AddExit( "nordwesten", ROOM "room_e01.lpc");
  AddExit( "suedosten", ROOM "room_c03.lpc");

}

int cmd_climb(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (str != "auf fels" && str != "auf felsen")
    return 0;

  TP->move(ROOM "fels.lpc", M_GO, "auf den Felsen", "klettert", 
    "kommt heraufgeklettert");

  return 1;  
}


