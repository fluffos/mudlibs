#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types

inherit "std/room";


void create()
{
  if (is_clone(this_object())) return;

  ::create();

  AddId ( ({ "\nfelsen" }) );

  SetProp(P_INT_SHORT, "Auf einem Felsen");

  SetProp(P_INT_LONG,
    "Du stehst hier auf einem kleinen Felsen inmitten "
    "der sonst recht ueppig mit Gras bewachsenen Ebene. "
    "Von hier aus hast kannst Du beinahe die komplette "
    "Flaeche ueberblicken.");

  AddDetail( ({ "felsen" }),
    "Der Felsen ist nicht recht hoch, jedoch viel zu "
    "unwegsam, um einfach so hinter zu wandern.");
  AddDetail( ({ "gras" }),
    "Das Gras hier waechst froehlich vor sich hin - "
    "nichteinmal herumirrende Schafe oder Abenteurer "
    "scheint es zur Kenntnis zu nehmen.");
  AddDetail( ({ "kenntnis" }),
    "Kennst Du nicht.");
  AddDetail( ({ "schafe" }),
    "Riesige Wollknaeuel mit Beinen.");
  AddDetail( ({ "wollknaeuel", "knaeuel" }),
    "Schafe halt.");
  AddDetail( ({ "beine", "beinen" }),
    "Um sich fortbewegen zu koennen, ist es ratsam "
    "ueber solche zu verfuegen.");
  AddDetail( ({ "ebene" }),
    "Erstaunlicher Weise ist diese Ebene ziemlich flach - "
    "wirklich bemerkenswert... aber sonst waehrs wohl eine "
    "Unebene.");
  AddDetail( ({ "unebene" }),
    "Du denkst doch nicht wirklich, dass es soetwas gibt?!");
  AddDetail( ({ "weise" }),
    "Ob Du das bist, wird sich noch entscheiden.");
  AddDetail( ({ "flaeche" }),
    "Natuerlich koennte man hier nun wieder die Geschichte "
    "mit flach und unflach erzaehlen, jedoch verlierst Du "
    "ganz plotzlich auf unerklaerliche Weise das Interesse.");
  AddDetail( ({ "interesse" }),
    "Tja, das hast Du wohl hier irgendwo verloren. Wer "
    "suchet, der findet - und alles andere waer jetzt "
    "wohl geschmacklos.");
  AddDetail( ({ "geschichte" }),
    "Als ich ein Iwo war, ging ich in Iwo's Bar\n"
    "Und mir wurde sonnenklar\n"
    "Ich war ein bisschen sonderbar.");
  AddDetail( ({ "bar" }),
    "Siehts hier aus wie inner Bar?");
  AddDetail( ({ "iwo" }),
    "Er kam, sah nichts - und versagte.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist hier blauer als blau, und die Sonne "
    "scheint viel heller als hell.");
  AddDetail( ({ "sonne" }),
    "Die Sonne sonnt sich froehlich in ihren eigenen Strahlen. "
    "Dir wird fast schlecht bei dem Gedanken, dass sich jemand "
    "so auf seinen Lorbeeren ausruht");
  AddDetail( ({ "strahlen" }),
    "Nicht, dass Du das selber etwas besser koenntest - aber "
    "trotzdem findest Du das unangebracht.");
  AddDetail( ({ "gedanken" }),
    "Du lauscht gespannt Deinen Gedanken... findest Dich "
    "jedoch sogleich etwas langweilig.");
  AddDetail( ({ "lorbeeren" }),
    "Irgendwie kam dieses eklig schmeckende Gewaechs zu dem "
    "Ruf als Zeichen fuer Anerkennung zu stehen.");
  AddDetail( ({ "gewaechs" }),
    "Huch, da steht doch glatt so ein Lorbeerbusch - das "
    "haettest Du jetzt aber nicht gedacht!");
  AddDetail( ({ "ruf" }),
    "Frag mal jemand nach Deinem?");
  AddDetail( ({ "zeichen" }),
    "Du suchst angestrengt nach irgendwelchen Zeichen, kannst "
    "jedoch ausser diesem Busch hier siehst Du keine.");
  AddDetail( ({ "anerkennung" }),
    "Du erkennst Deine Existenz an, und widmest Dich wieder "
    "Deiner Umgebung.");
  AddDetail( ({ "existenz" }),
    "Du untersuchst, also bist Du... was auch immer.");
  AddDetail( ({ "umgebung" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "busch", "lorbeerbusch" }),
    "Ein recht unspektakulaeres Gewaechs. Es hat ein paar "
    "Aeste, und daran ein paar Blaetter.");
  AddDetail( ({ "aeste", "aesten" }),
    "An den langweiligen, typisch aestigen Aesten haengen "
    "unmotiviert ein paar noch viel langweiligere Blaetter.");
  AddDetail( ({ "blaetter" }),
    "Halbherzig begutachtest Du die oede an den Aesten "
    "haengenden Blaetter... und erkennst, dass es tatsaechlich "
    "Blaetter sind! Du bist begeistert und laesst sie "
    "ungestoert weiterblaettern.");
  AddDetail( ({ "abenteurer" }),
    "Du bist einer - wenn auch kein sonderlich grosser.");
  AddDetail( ({ "boden" }),
    "Der Boden ist etwas felsig hier, aber ansonsten recht "
    "in Ordnung.");
  AddDetail( ({ "ordnung" }),
    "Ja, ist er - was auch immer das heissen mag.");
  
  AddCmd( ({ "such", "suche" }), "find_it");
  AddCmd( ({ "kletter", "klettere" }), "climb_to");


  AddItem( NPC "olli.lpc", REFRESH_DESTRUCT);

}



int find_it (string what)
{
  notify_fail("Was moechtest Du suchen?\n");
  if (what != "interesse")
    return 0;

  tell_object(this_player(), break_string("Du suchst "
    "verzweifelt nach Deinem Interesse, gibst das aber "
    "mangels dessen bald wider auf.", 78));

  return 1;
}


int climb_to (string str)
{
  string where;
  string dest;

  notify_fail("Wohin moechtest Du klettern?\n");

  if (!stringp(str)) return 0;

  if (sscanf(str, "nach %s", where) != 1)
    return 0;

  switch (where)
    {
      case "nordunten":
        dest = ROOM + "fr_f03.lpc";
        break;
      case "nordostunten":
        dest = ROOM + "fr_f04.lpc";
        break;
      case "ostunten":
        dest = ROOM + "fr_e04.lpc";
        break;
      case "suedostunten":
        dest = ROOM + "fr_d04.lpc";
        break;
      case "suedunten":
        dest = ROOM + "fr_d03.lpc";
        break;
      case "suedwestunten":
        dest = ROOM + "fr_d02.lpc";
        break;
      case "westunten":
        dest = ROOM + "fr_e02.lpc";
        break;
      case "nordwestunten":
        dest = ROOM + "fr_f02.lpc";
        break;
      default:
        notify_fail("Wohin genau moechtest Du klettern?\n");
        return 0;
    }

 return   TP->move(dest, M_GO, "nach unten", "klettert",
    "kommt herunter geklettert"); 

}

