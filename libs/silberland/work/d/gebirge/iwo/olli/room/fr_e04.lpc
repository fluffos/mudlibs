#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types

inherit "std/room";


void create()
{
  if (is_clone(this_object())) return;

  ::create();

  AddId( ({ "\nfelsraum" }) );

  SetProp(P_INT_SHORT, "Inmitten einer grasbewachsenen Ebene");

  SetProp(P_INT_LONG,
    "Westlich von Dir verschandelt ein kantiger Felsen die "
    "saftig-gruene Umgebung. Das gruen Gras ueberall auf der "
    "Ebene waer wohl ziemlich schmackhaft, wenn Du ein "
    "Schaf waerst. Die Sonne braet Dich gemuetlich mit "
    "ihren Strahlen, und Du findest es ziemlich langweilig "
    "hier.");

  AddDetail( ({ "felsen" }),
    "Der Felsen ist gross, hart und westlich von Dir.");
  AddDetail( ({ "umgebung" }),
    "Die Umgebung hier ist ziemlich eben, und durch das "
    "viele Gras auch ziemlich Gruen.");
  AddDetail( ({ "gras" }),
    "Das Gras hier ist wie ueberall hier in der Umgebung "
    "saftig gruen.");
  AddDetail( ({ "ebene" }),
    "Die Ebene ist nicht sonderlich gross, dafuer gewaltig "
    "gruen.");
  AddDetail( ({ "schaf" }),
    "Du bist keins, und Du siehst keins.");
  AddDetail( ({ "sonne" }),
    "Die Sonne hangt wie festgenagelt am Himmel und versorgt "
    "Dich mit Waerme und Licht.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist strahlend blau, und mitten drinnen haengt "
    "gelb leuchtend die Sonne.");
  AddDetail( ({ "waerme" }),
    "Gottseidank spendet die Sonne etwas Waerme, sonst waer "
    "es wohl .. aeh.. ziemlich kalt hier.");
  AddDetail( ({ "licht" }),
    "Das Licht umhuellt die gesamte Umgebung.");
  AddDetail( ({ "boden" }),
    "Hier am Boden waechst wie ueberall hier Gras. An ein paar "
    "Stellen hast Du es platt getreten.");
  AddDetail( ({ "stellen" }),
    "Hier hast Du das Gras zertrampelt. Waechst aber wieder nach.");
  AddDetail( ({ "strahlen" }),
    "Die Strahlen kommen von der Sonne und machen es hier hell und "
    "warm. Du findest das faszinierend.");
  AddDetail( ({ "gruen" }),
    "Das Gras ist so unglaublich gruen, dass Du Dich schon nach "
    "einer anderen Farbe sehnst.");
  AddDetail( ({ "farbe" }),
    "Du findest das viele Gruen zum Heulen.");
  AddDetail( ({ "heulen" }),
    "Das wuerdest Du gerne.");

  

  AddCmd ( ({ "kletter", "klettere" }), "cmd_climb");

  AddExit( "norden", ROOM "fr_f04.lpc");
  AddExit( "sueden", ROOM "fr_d04.lpc");
  AddExit( "nordosten", ROOM "room_f05");
  AddExit( "osten", ROOM "room_e05");
  AddExit( "suedosten", ROOM "room_d05");

  AddItem(NPC "wolf.lpc", REFRESH_DESTRUCT);

}

int cmd_climb(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (str != "auf fels" && str != "auf felsen")
    return 0;

  TP->move(ROOM "fels.lpc", M_GO, "auf den Felsen", "klettert", 
    "kommt heraufgeklettert");

  return 1;  
}

//
// Diese Funktion haelt die Woelfe am Laufen
// indem init() mit TP aufgerufen wird, und
// dadurch PlayerMet aktualisiert wird
void init_wolf()
{
  int i;
  mixed *items;

  items = QueryProp(P_ITEMS);

  for (i=0; i < sizeof(items); i++)
    if (items[i][2] == sprintf("%s%s", NPC, "wolf.lpc"))
      if (objectp(items[i][0])) items[i][0]->init();

}
