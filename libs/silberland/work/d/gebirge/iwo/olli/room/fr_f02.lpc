#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types

inherit "std/room";


void create()
{
  if (is_clone(this_object())) return;

  ::create();

  AddId( ({ "\nfelsraum" }) );

  SetProp(P_INT_SHORT, "Inmitten einer grasbewachsenen Ebene");

  SetProp(P_INT_LONG,
    "Die unendliche gruene Weite, welche Dich umgibt, geht Dir "
    "mittlerweilen schon ziemlich auf die Nerven. Gottseidank "
    "liegt suedoestlich von hier ein Felsen, der zumindest "
    "etwas Abwechslung in die sonst so monotone Ebene bringt.");
  AddDetail( ({ "weite", "weiten" }),
    "Unendliche Weiten, dies sind Deine Abenteuer auf der "
    "Suche nach neuen Herausforderungen, die niemals zuvor "
    "ein Abenteurer bestanden hat.");
  AddDetail( ({ "abenteuer" }),
    "Stolz bist Du zurecht drauf, dass Du schon einige "
    "bestanden hast.");
  AddDetail( ({ "suche" }),
    "Nachdem Du nochimmer suchst, kann Deine nicht besonders "
    "erfolgreich sein. Dennoch gibst Du nicht auf. Gut so!");
  AddDetail( ({ "nerven" }),
    "Die jetzt zu betrachten waer wohl etwas zu blutig.");
  AddDetail( ({ "felsen", "fels" }),
    "Der Felsen liegt einfach nur da. Sehr ueberzeugend.");
  AddDetail( ({ "abwechslung" }),
    "Du waerst froh, wenn sich hier endlich mal etwas "
    "aendern wuerde.");
  AddDetail( ({ "ebene" }),
    "Die Ebene scheint Dich in alle Richtungen zu umgeben.");
  AddDetail( ({ "richtungen" }),
    "Du solltest einfach mal hingehen.");
  AddDetail( ({ "boden" }),
    "Wie nicht anders zu erwarten war, befinder sich der Boden "
    "nochimmer genau dort, wo Du ihn das letzte Mal gefunden "
    "hast.");
  AddDetail( ({ "mal" }),
    "Diesmal, naechstes...");
  AddDetail( ({ "abenteurer" }),
    "Du hoffst einmal ein grosser unter ihnen zu werden.");
  AddDetail( ({ "herausforderungen" }),
    "Grosse und kleine - wie diese hier.");
  AddDetail( ({ "himmel" }),
    "Du himmelst den Himmel kurz an, beschliesst dann aber "
    "das wieder bleiben zu lassen. Bricht auch nicht viel.");


  AddCmd ( ({ "kletter", "klettere" }), "cmd_climb");

  AddExit( "sueden", ROOM "fr_e02.lpc");
  AddExit( "osten", ROOM "fr_f03.lpc");
  AddExit( "suedwesten", ROOM "room_e01");
  AddExit( "nordosten", ROOM "room_g03");

  AddItem(NPC "wolf.lpc", REFRESH_DESTRUCT);

}

int cmd_climb(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (str != "auf fels" && str != "auf felsen")
    return 0;

  TP->move(ROOM "fels.lpc", M_GO, "auf den Felsen", "klettert", 
    "kommt heraufgeklettert");

  return 1;  
}



//
// Diese Funktion haelt die Woelfe am Laufen
// indem init() mit TP aufgerufen wird, und
// dadurch PlayerMet aktualisiert wird
void init_wolf()
{
  int i;
  mixed *items;

  items = QueryProp(P_ITEMS);

  for (i=0; i < sizeof(items); i++)
    if (items[i][2] == sprintf("%s%s", NPC, "wolf.lpc"))
      if (objectp(items[i][0])) items[i][0]->init();

}

