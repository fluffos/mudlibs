#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types

inherit "std/room";


void create()
{
  if (is_clone(this_object())) return;

  ::create();

  AddId( ({ "\nfelsraum" }) );

  SetProp(P_INT_SHORT, "Inmitten einer grasbewachsenen Ebene");

  SetProp(P_INT_LONG,
    "Rund um Dich waechst froehlich ueppiges Gras vor sich in. "
    "Oestlich von Dir lungert waehrenddessen ein mittelgrosser "
    "Felsen auf ein paar zermantschen Grasbuescheln herum. "
    "Die Sonne strengt sich an, um genuegend Strahlen fuer "
    "so faule Sonnenanbeter zu produzieren.");

  AddDetail( ({ "gras" }),
    "Ganz gewoehnliches, nicht sonderlich aufregendes Gras. "
    "Gruen natuerlich.");
  AddDetail( ({ "fels", "felsen" }),
    "Der kantige Felsen macht nicht gerade den Eindruck, als "
    "wuerde er sich in absehbarer Zeit aufrappel um davon "
    "zu laufen - demnach besteht wohl eher weniger Gefahr "
    "fuer Dich von ihm erschlagen zu werden.");
  AddDetail( ({ "eindruck" }),
    "Du versuchst den Felsen einzudruecken, scheiterst aber - "
    "was auch nicht anders zu erwarten war.");
  AddDetail( ({ "zeit" }),
    "Zeit ist etwas, was an diesem Felsen spurlos vorueber "
    "zu gehen scheint.");
  AddDetail( ({ "gefahr" }),
    "Herumwandernde Felsen stellen eher weniger eine dar, "
    "wobei dieser hier aber auch irgendwie hier her gekommen "
    "sein muss. Auf jeden Fall ist es besser ihm wenn es "
    "darauf ankommt nicht im Weg zu stehen.");
  AddDetail( ({ "weg" }),
    "Ein Weg ist etwas, was aufgrund der generell recht gut "
    "begehbaren Ebene niemals geschaffen wurde.");
  AddDetail( ({ "ebene" }),
    "Du begutachtest fachmaennisch die Ebene, und kommst "
    "zu dem Schluss, dass sie tatsaechlich ziemlich eben ist.");
  AddDetail( ({ "schluss" }),
    "Um Schluss zu machen, koenntest Du hier einfach warten "
    "bis der Felsen Dich ueberrent.");
  AddDetail( ({ "sonne" }),
    "Die Sonne ist schon ganz rot vom vielen Strahlen.");
  AddDetail( ({ "strahlen" }),
    "Geschickt weichst Du den Strahlen der Sonne aus.");
  AddDetail( ({ "grasbuescheln", "grasbueschel", "bueschel" }),
    "Das Gras bueschelt unbeirrt durch Deine Anwesenheit "
    "ungeniert vor sich hin.");
  AddDetail( ({ "anwesenheit" }),
    "Wohl etwas abwesend, wa?");
  AddDetail( ({ "fall" }),
    "Du bist ein besonders schwieriger Fall, dennoch wirst Du "
    "Dich loesen.");
  AddDetail( ({ "sonnenanbeter", "anbeter" }),
    "Das sind diejenigen, die ihre Zeit damit zu verbringen "
    "scheinen.");
  AddDetail( ({ "himmel" }),
    "Der Himmel blaut so wie er sollte dahin, wobei Du glaubst "
    "zu erkennen, dass er schon mal besser geblaut haette.");
  AddDetail( ({ "boden" }),
    "Der Boden liegt Dir wie immer zu Deinen Fuessen - ganz "
    "unabhaengig davon, ob Du damit zufrieden bist oder nicht. "
    "Der versteckt sich unter dem Gras.");
  AddDetail( ({ "fuesse", "fuessen" }),
    "Ohne die waerst Du ziemlich angeschmiert. Wiederum "
    "ueberlegst Du, wie der Felsen wohl hierher gekommen "
    "sein mag.");


  AddCmd ( ({ "kletter", "klettere" }), "cmd_climb");

  AddExit( "sueden", ROOM "fr_d02");
  AddExit( "norden", ROOM "fr_f02");
  AddExit( "westen", ROOM "room_e01");
}

int cmd_climb(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (str != "auf fels" && str != "auf felsen")
    return 0;

  TP->move(ROOM "fels.lpc", M_GO, "auf den Felsen", "klettert", 
    "kommt heraufgeklettert");

  return 1;  
}


