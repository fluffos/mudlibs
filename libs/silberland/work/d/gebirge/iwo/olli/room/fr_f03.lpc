#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>

#include "../def.h"

#pragma strong_types

inherit "std/room";


void create()
{
  if (is_clone(this_object())) return;

  ::create();

  AddId( ({ "\nfelsraum" }) );

  SetProp(P_INT_SHORT, "Inmitten einer grasbewachsenen Ebene");

  SetProp(P_INT_LONG,
    "Suedlich von Dir macht sich ein fetter Felsen inmitten "
    "der ansonsten makellosen Ebene breit. Das Gras ist "
    "eigentlich wunderbar gruen, und der ach so blaue "
    "Himmel haelt die Sonne fest, wo sie hin gehoert.");

  AddDetail( ({ "felsen", "fels" }),
    "Er ist nicht sonderlich hoch, jedoch viel zu unwegsam "
    "um einfach so auf ihn hinauf zu spazieren.");
  AddDetail( ({ "ebene" }),
    "Die Ebene breitet sich gleichmaessig rund um Dich aus.");
  AddDetail( ({ "gras" }),
    "Das saftig gruene Gras laesst vermuten, dass es sehr "
    "gesund ist.");
  AddDetail( ({ "himmel" }),
    "Der himmel ist hier makellos blau, und die Sonne spendet "
    "ausreichend Licht, um sich hier wohl zu fuehlen.");
  AddDetail( ({ "licht" }),
    "Gerade genug, jedoch auch nicht zu viel.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht unverschaemt vom Himmel und veraergert "
    "diejenigen, die das Licht verabscheuen.");
  AddDetail( ({ "boden" }),
    "Auch hier ist der Boden reichlich bedeckt mit Gras.");


  AddCmd ( ({ "kletter", "klettere" }), "cmd_climb");

  AddExit( "westen", ROOM "fr_f02.lpc");
  AddExit( "osten", ROOM "fr_f04.lpc");
  AddExit( "norden", ROOM "room_g03.lpc");

}

int cmd_climb(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (str != "auf fels" && str != "auf felsen")
    return 0;

  TP->move(ROOM "fels.lpc", M_GO, "auf den Felsen", "klettert", 
    "kommt heraufgeklettert");

  return 1;  
}


