
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"pelz","schafspelz", "\nschafspelz"}));
  SetProp (P_SHORT, "Ein Schafspelz");
  SetProp (P_LONG,
    "Dieses Stueck Pelz gehoerte frueher wohl einmal einem Schaf. "
    "Er sieht schon ziemlich benutzt aus.");
  SetProp (P_NAME, "Schafspelz");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 300);
  SetProp (P_INFO,
    "Wenn Du diesen Pelz traegst, kann man Dich kaum von einem "
    "Schaf unterscheiden.\n");

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 5);

  SetProp (P_MATERIAL, MAT_PELT);
  
}


