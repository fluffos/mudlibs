void set_cmds()
{
  curr_cmds = CMDS;

  while (sizeof(curr_cmds) > 3)
    curr_cmds -= ({ curr_cmds[random(sizeof(curr_cmds))] });

  if (find_player("iwo"))
    tell_object(find_player("iwo"), BS("Olli Cmds: " + sprintf("%O", curr_cmds)));
}

int trusted(object pl)
{
  object *arm;
  int i;

  arm = pl->QueryProp(P_ARMOURS);

  while (i < sizeof(arm) && arm[i])
    if (arm[i++]->id("\nschafspelz"))
      return 1;

  return 0;
}


int cmd_erschrecken(string str)
{
  notify_fail("Wen willst Du erschrecken?\n");

  if (!id(str)) return 0;

  tell_object(TP, BS("Du erschreckst Olli."));

  tell_room(ENV(ME), BS(TP->Name(WER) + " erschreckt Olli "
    + "fuerchterlich."), ({ TP }));

  call_out("run_away", 2+random(5));

  panic++;

  return 1;
}


void run_away(int wolf)
{

  while (remove_call_out("run_away") != -1);

  call_out("decrease_panic", PANIC_RATE); 

  tell_room(ENV(ME), BS("Ploetzlich reisst Olli die Augen "
    + "weit auf und beginnt irr zu bloeken."));

  if (ENV(ME)->id("\nfelsraum"))
    {
      tell_room(ENV(ME), BS("Olli springt wie vom boesen Schwein "
        + "gebissen auf den Felsen."));
      TO->move(FELSRAUM, M_SILENT + M_NOCHECK);

      tell_room(ENV(ME), BS("Olli kommt wild bloekend herauf "
        + "gesprungen."));

    }
  else
    do_walk();
}

void start_panic(object pl)
{
  panic++;

  tell_room(ENV(ME), BS("Olli erschrickt fuerchterlich, als er " +
    TP->name(WEN) + " sieht."), ({ TP }));
  tell_object(TP, BS("Olli erschricht fuerchterlich, als er Dich "
    "sieht."));
  call_out("run_away", 0);

  SetProp(P_MSGIN, "kommt voellig verstoert hereingalloppiert");
  SetProp(P_MSGOUT, "galloppiert voellig verstoert");

}


void decrease_panic()
{
  
  while (remove_call_out("decrease_panic") != -1);

  if (--panic <= 0)
    {
      tell_room(ENV(ME), ME->Name(WER) + " beruhigt sich wieder.\n");
      SetProp(P_MSGIN, "schlendert herein");
      SetProp(P_MSGOUT, "schlendert");
      panic = 0;
    }

  if (panic > 0) call_out("decrease_panic", PANIC_RATE);

}


// Fuers Seil
int tie(string what)
{

  if (panic > 0)
    {
      tell_object(TP, BS("Olli ist viel zu aufgeregt dafuer.\n"));
      return 0;
    }

  if (random(100)>50)
    {
      tell_object(TP, BS("Olli kriegt es mit der Angst zu tun, als "
        "Du versuchst ihm die Schlinge um den Hals zu legen."));
      panic++;
      call_out("run_away", 0);
      tell_object(TP, BS("Vielleicht klappt es beim naechsten Mal!\n"));
      return 0;
    }


  return tied = 1;
  
}


int untie()
{
  tied = 0;
  ME->RemovePursuer(PO);
  return 1;
}


void init()
{
  if (!trusted(TP))
    call_out("start_panic", 0, TP);
  ::init();
}

void reset()
{
  if (is_clone(this_object()))
    do_walk();
  ::reset();
}
