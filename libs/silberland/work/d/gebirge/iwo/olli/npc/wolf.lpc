#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include <combat.h>
#include <mnpc.h>
#include <properties.h>
#include <npc.h>

#include "../def.h"

inherit "std/mnpc";

#pragma strong_types

#define FELSRAUM ROOM "fels.lpc"

void create()
{
  if (!is_clone(this_object()))
    return;

  ::create();

  create_default_npc(10);

  AddId( ({ "wolf", "\niwowolf" }) );

  SetProp(P_SHORT, "Ein grosser, boeser Wolf");

  SetProp(P_NAME, "Wolf");

  SetProp(P_ARTICLE, 1);

  SetProp(P_GENDER, MALE);

  SetProp(P_NAME_ADJ, "boes");

  SetProp(P_LONG, "Vor Dir steht ein grosser, boeser Wolf. Selbst "
    "Wickie haette angst vor diesem Ungetuem. Seile riesigen, weissen "
    "Zaehne scheinen regelrecht nach frischem Fleisch zu lechzen.");

  SetProp(P_NOATTACK, "fletscht die Zaehne.");

  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MNPC_DEFAULTROOM, ROOM "fr_e04.lpc");

  SetProp(P_MNPC_AREA, ROOM "fr_");

  SetProp(P_MNPC_WAIT, ({ 5, 5, 10 }));

  SetProp(P_MNPC_FLAGS, MOV_INFIGHT | MOV_MOVES | MOV_MAYLOAD | MOV_BACKWARDS | MOV_INDOORS | MOV_OUTDOORS | MOV_SPECIAL);

  SetProp(P_ALIGN, -100);
}


