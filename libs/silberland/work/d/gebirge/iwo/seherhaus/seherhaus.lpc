#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <defines.h>
#include <moving.h>
#include <wizlevels.h>
#include <moredef.h>
#include "def.h"

int tuerstat = 0;

void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,1);
  SetProp( P_INT_SHORT, "Teiresias' und Iwo's Wohnhoehle" );
  SetProp( P_INT_LONG,
           "Das ist die Wohnhoehle von Teiresias und Iwo. Das ganze "
           "sieht irgendwie mehr wie eine Kurstaette, als ein Raum "
           "in dem man wohnt aus. An der Ostwand befindet sich eine "
           "kleine Tuere, die in die Sauna fuehrt, und an der "
           "Westwand befinden sich Stangen voller Badeanzuege, "
           "Badehosen und Badetuechern. Im Boden, nahe der Wand "
           "ist ein Solebecken eingelassen, welches leicht vor sich "
           "hindampft."
           );

  AddDetail( ({ "waende", "wand" }),
             "Welche Wand meinst Du denn?");
  
  AddSpecialDetail( ({ "ostwand" }), "ostwandfkt");
  AddSpecialDetail( ({ "tuer", "tuere", "saunatuer",
                         "saunatuere", "Holztuer",
                         "holztuere" }), "querydoor");
  AddDetail( ({ "fenster" }),
             "Es ist ziemlich angelaufen, aber vielleicht "
             "kannst Du trozdem durch in die Sauna blicken.");
  AddDetail( ({ "sauna" }),
             "Scheinbar befindet sich hinter der kleinen Tuer eine "
             "Sauna, in der man sicher herrlich entspannen kann.");
  AddDetail( ({ "stange", "stangen" }),
             "Auf den Stangen haengen unzaehlige Badeanzuege und "
             "Badehosen.");
  AddDetail( ({ "badeanzuege", "anzuege" }),
             "Du kannst Dir sicher einen nehmen davon und anziehen.");
  AddDetail( ({ "badehosen", "hosen" }),
             "Du kannst Dir sicher eine nehmen davon und anziehen.");
  AddDetail( ({ "badetuecher", "badetuechern" }),
             "Sicherlich darfst Du Dir eines ausleihen, um Dich abzutrocknen.");
  AddDetail( ({ "boden" }),
             "Der Boden ist mit schoenen geheizten Marmorplatten ausgelegt.");
  AddDetail( ({ "marmorplatten", "marmorplatte",
                  "platten", "platte", "marmor" }),
             "Die Platten bestehen aus braunem Marmor und haben eine angenehme "
             "Temperatur.");
  AddDetail( ({ "temperatur" }),
             "Es ist angenehm warm hier. Man koennte glatt in Badekleidung "
             "rumlaufen hier.");
  AddDetail( ({ "badekleidung", "kleidung" }),
             "An der Wand sind einige Stangen befestigt, an denen sicher "
             "genug davon haengt.");
  AddDetail ( ({ "decke", "licht", "note", "kuppel" }),
              "An der Decke ist eine kleine Kuppel, durch die genuegend "
              "Licht eindringt, um dem Raum eine angenehm schwummrige "
              "Note zu geben.");
  AddDetail( ({ "iwo" }),
             "Iwo ist der Architekt dieser Staette.");
  AddDetail( ({ "architekt" }),
             "Naja... eigentlich ist er ja keiner, sondern nur ein "
             "Magier. Aber gemacht hat er dies alles trotzdem.");
  AddDetail( ({ "magier" }),
             "Sie arbeiten fleissig an neuen Gebieten.");
  AddDetail( ({ "gebieten", "gebiete" }),
             "Das gebirge ausserhalb der Hoehle ist eines.");
  AddDetail( ({ "hoehle", "wohnhoehle", "staette", "raum", "kurstaette" }),
             TO->QueryProp(P_INT_LONG));
  AddDetail( ({ "solebecken", "becken", "solebeckens" }),
             "Kleine Stufen fuehren in ein Solebecken voller angenehm "
             "warmen Wasser. Du kannst es sicher betreten.");
  AddDetail( ({ "stufen" }),
             "Sie ermoeglichen ein bequemes betreten den Solebeckens.");
  AddDetail( ({ "wasser" }),
             "Es ist angenehm warm, und leicht salzhaltig - einfach perfekt "
             "fuer Deine gestresste Haut und fuer ein wenig Entspannung.");
  AddDetail( ({ "haut" }),
             "Deine Haut kann sicher ein Bad im warmen Wasser vertragen.");
  AddDetail( ({ "entspannung" }),
             "Garantiert wirst Du im Solebecken diese finden.");
  AddDetail( ({ "bad" }),
             "Du sehst Dich nach einem Bad im warmen Becken.");
  AddDetail( ({ "teiresias" }),
             "Teiresias ist einer der Bewohner dieser Hoehle.");
  AddDetail( ({ "bewohner" }),
             "Teiresias und Iwo wohnen hier.");
  AddDetail( ({ "westwand" }),
             "An der Westwand befindet sich das Solebecken. Durch ein Loch "
             "in der Hoehlenwand kann man rausschwimmen, und ein Bad im "
             "kalten Freien umgeben von angenehm warmen Wasser geniessen.");
  AddDetail( ({ "freies", "freien", "freie" }),
             "Du kannst von hier nicht raussehen, aber aus dem Becken kannst "
             "Du sicher rausschwimmen.");
  AddDetail( ({ "loch", "hoehlenwand" }),
             "Das Loch in der wand fuehrt ins Freie.");

  

  AddExit("raus", "/d/gebirge/iwo/oink/hoehle.lpc");
  AddExit("rumpelkammer", RUMPELKAMMER);

  AddCmd( ({ "oeffne" }), "oeffnen");
  AddCmd( ({ "schliess", "schliesse" }), "schliessen");
  AddCmd( ({ "blicke" }), "blicken");
  AddCmd( ({ "betrete", "schwimme" }), "betreten");

}


string querydoor()
{
  string retstr;

  if (tuerstat)
    retstr = "Irgendjemand scheint die Tuere zur Sauna offen gelassen " +
      "zu haben und die ganze schoene Waerme entweicht.";
  else
    
    retstr = "Durch ein kleines angelaufenes Fenster in der Holztuere " +
      "kannst Du vielleicht in die Sauna blicken, um zu sehen, wer sich " +
      "zur Zeit darin aufhaelt.";
  
  return BS(retstr);

}



string ostwandfkt(string key)
{
  string retstr;
  
  retstr = "An der steinigen Wand befindet sich ein Thermometer, dass " +
    "90 Grad anzeigt. Darunter befindet sich eine Art Uhr, die den " +
    "naechsten Aufguss anzeigt. ";

  retstr += querydoor();

  return BS(retstr);

}




int saunabetr()
{
  if (TP->QueryProp(P_ARMOURS) != ({}) || TP->QueryProp(P_WEAPON))
    {
      tell_object(TP, BS("Aber, aber.. Wer wird denn da mit "
                         "Kleidung oder Waffen in die Sauna wollen?"));
    }
  else
    {
      tell_object(TP, BS("Du solltest schnell die Tuere schliessen "
                         "hinter Dir."));

      return TP->move(SAUNA, 
                      M_GO, 0, "betritt die Sauna", "betritt die Sauna");
    }

  return 1;

}


int oeffnen(string str)
{

  notify_fail("WAS willst Du oeffnen?\n");
  if (!str) return 0;

  if (str != "tuer" && str != "tuere"
      && str != "saunatuer" && str != "saunatuere") return 0;

  notify_fail("Oops, die Tuere ist verschlossen. Da will wohl wer allein sein?\n");
  if (SAUNA->query_locked()) return 0;

  notify_fail("Die Tuere ist doch schon offen!\n");
  if (tuerstat) return 0;

  tell_object(TP, BS("Du oeffnetst die Saunatuere."));
  tell_room(ME, BS(TP->Name(WER) + " oeffnet die Saunatuere."), ({ TP }));

  tell_room(SAUNA, BS("Die Tuere wird von aussen geoeffnet."));

  tuerstat = 1;
  AddSpecialExit("sauna", "saunabetr");
  find_object(SAUNA)->opendoor();

  return 1;
}


int schliessen(string str)
{

  notify_fail("WAS willst Du schliessen?\n");
  if (!str) return 0;

  if (str != "tuer" && str != "tuere"
      && str != "saunatuer" && str != "saunatuere") return 0;

  notify_fail("Die Tuere ist doch schon geschlossen!\n");
  if (!tuerstat) return 0;

  tell_object(TP, BS("Du schliesst die Saunatuere."));
  tell_room(ME, BS(TP->Name(WER) + " schliesst die Saunatuere."), ({ TP }));

  tell_room(SAUNA, BS("Die Tuere wird von aussen geschlossen."));

  tuerstat = 0;
  RemoveExit("sauna");
  find_object(SAUNA)->closedoor();

  return 1;
}

int opendoor()
{
  tuerstat = 1;
  AddSpecialExit("sauna", "saunabetr");
  return 1;
}

int closedoor()
{
  tuerstat = 0;
  RemoveExit("sauna");
  return 1;
}


int blicken(string str)
{
  string *saunarer;
  object *tmpob;
  int i;
  
  notify_fail("WO willst Du durchblicken?\n");
  if (!str) return 0;

  if (str != "in sauna" && str != "durch fenster" && str != "durch tuer") 
    return 0;

  tell_room(ME, BS(TP->Name(WER) + " blickt durch das kleine Fenster "
                   "in der Saunatuere."), ({ TP }) );

  tell_room(SAUNA, BS(TP->Name(WER) + 
                      " presst von draussen sein Gesicht gegen das "
                      "kleine Fenster in der Tuere."));

  tell_object(TP, BS("Du schaust durch das kleine Fenster in die Sauna, "
              "kannst jedoch da es angelaufen ist nur die Umrisse "
              "der Personen erkennen."));
  tell_object(TP, "Zur Zeit befinden sich in der Sauna:\n");

  tmpob = all_inventory(find_object(SAUNA));

  saunarer = allocate(sizeof(tmpob));

  for (i = 0; i < sizeof(tmpob); i++)
    if (living(tmpob[i]))
      saunarer[i] = tmpob[i]->Name(WER);

  if (sizeof(saunarer)<= 0) tell_object(TP, BS("Niemand."));
  else tell_object(TP, BS(implode(saunarer, ", ")));

  return 1;
    
}


int betreten(string str)
{
  string *was;

  notify_fail("WAS willst Du betreten?\n");
  if (!str) return 0;

  was = explode(str, " ");

  if (member(was, "becken") == -1 && member(was, "solebecken") == -1) return 0;
  tell_object(TP, BS("Leider ist das Becken noch abgedeckt. Wahrscheinlich "
                     "wird noch daran gearbeitet. Du solltest es spaeter "
                     "nocheinmal probieren."));

  return 1;

}

/* Wir resetten nicht */
void reset()
{
  return;
}