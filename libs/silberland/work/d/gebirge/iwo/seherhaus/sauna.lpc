#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <defines.h>
#include <moving.h>
#include <wizlevels.h>
#include <moredef.h>

#include "def.h"

int tuerstat = 0;
int locked = 0;

string *a_allowed = ({ "angrox", "iwo", "teiresias", "woody", "zordan" });

void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,1);
  SetProp( P_INT_SHORT, "In der Sauna" );
  SetProp( P_INT_LONG,
           "Du befindest Dich in einer Sauna. Die Decke, Waende und der "
           "Boden sind genauso wie die riesigen Stufen vollstaendig "
           "aus glattgehobeltem und geschliffenem Holz. "
           "In einer Ecke stehen ein kleiner Ofen und ein Eimer voll "
           "Wasser in dem eine Kelle zum schoepfen haengt."
           );

  AddDetail( ({ "sauna", "raum" }), 
             "Hier kannst Du Dich mit Freunden mal so richtig "
             "ausschwitzen, und Deinem Koerper etwas guts tun. "
             "Es hat hier konstant 90 Grad - die optimale Temperatur "
             "um ein bisschen rumzuhaengen und zu entspannen.");
  AddDetail( ({ "freunde", "freunden" }),
             "Ja, Deine Freunde sollest Du hierher mitnehmen um "
             "gemeinsam zu entspannen.");
  AddDetail( ({ "koerper" }),
             "Nach den anstrengenden Kaempfen, die Du gefuehrt hast, "
             "wird Dir etwas entpannen sicher nicht schaden.");
  AddDetail( ({ "kaempfe", "kaempfen" }),
             "Viele davon hast Du schon bestritten.");
  AddDetail( ({ "grad" }),
             "Das ist eine Einheit fuer Temperatur.");
  AddDetail( ({ "einheit" }),
             "Darueber moechtest Du eigentlich garnicht nachdenken.");
  AddDetail( ({ "temperatur" }),
             "Hier herrschen genau 90 Grad.");
  AddDetail( ({ "decke", "licht" }),
             "Kleine, bunt leuchtende Plaettchen befinden sich an der "
             "Decke, und tauchen die Sauna in ein wohliges Daemmerlicht.");
  AddDetail( ({ "plaettchen" }),
             "Du hast keine Ahnung wie und warum sie leuchten, aber Du "
             "fuehlst Dich auch zu entspannt, um darueber nachzudenken.");
  AddDetail( ({ "daemmerlicht" }),
             "Genau richtig, um ein bisschen rumzudoesen.");
  AddDetail( ({ "wand", "waende" }),
             "Die Waende sind mit glattgeschliffenen Holzplanken versehen - "
             "perfekt, um sich dagegen zu lehen. In einer der Waende "
             "befindet sich die Tuere durch die Du die Sauna betreten "
             "hast.");
  AddDetail( ({ "holz", "planken", "holzplanken" }),
             "Fast alles hier ist aus Holz. So richtig zum Wohlfuehlen.");
  AddDetail( ({ "wohlfuehlen" }),
             "Genau das ist es, was Du hier machst.");
  AddDetail( ({ "ecke", "ecken" }),
             "In einer Ecke steht der kleine Ofen, der die Sauna "
             "heizt. Daneben steht ein Eimer voll Wasser mit einer "
             "Kelle darin.");
  AddDetail ( ({ "ofen", "fassung", "lavabrocken", "brocken" }),
              "Der Ofen sorgt fuer die richtige Hitze hier herinnen. "
              "Eigentlich ist es ja garkein richtiger Ofen. Es ist eine "
              "Fassung fuer gluehende Lavabrocken, die eine enorme "
              "Hitze verbreiten.");
  AddDetail ( ({ "hitze" }),
              "Es ist wirklich ganzschoen heiss hier. Aber deshalb bist "
              "Du ja auch hier.");
  AddDetail ( ({ "boden" }),
              "Genauso wie alles andere hier, ist der Boden mit "
              "sauber verarbeiten Holzplanken ausgelegt.");
  AddDetail ( ({ "ahnung" }),
              "Du hast keine, aber das ist Dir hier voellig egal. Du "
              "willst einfach nur entspannen.");
  AddDetail ( ({ "stufen", "stufe", "ebene", "ebenen", "holzstufen" }),
              "Die riesigen Holzstufen bilden drei Ebenen unterschiedlicher "
              "Temperatur. Je nachdem ob Du es heisser oder kuehler "
              "haben willst, kannst Du dich weiter nach oben, oder weiter "
              "nach unten setzen.");
  AddDetail ( ({ "eimer", "kelle" }),
              "Mit der Kelle, die im dem Eimer haengt, koenntest Du "
              "eigentlich einen Aufguss machen.");
  AddDetail ( ({ "aufguss" }),
              "Du koenntest ganz einfach Wasser ueber die heissen "
              "steine giessen.");                
  AddDetail ( ({ "wasser" }),
              "Es wuerde sicher herrlich verdamfpen, wenn es auf die "
              "heissen Steine gelangt.");
  AddDetail ( ({ "steine" }),
              "Gluehende Lavabrocken, die den Raum mit ihrer "
              "unglaublichen Hitze erwaermen.");
  AddDetail ( ({ "tuer", "tuere", "fenster" }),
              "Ein kleines, leicht angelaufenes Fenster in der "
              "Tuer ermoeglicht es nach draussen zu sehen. Die "
              "Tuere kann man oeffnen und schliessen, jedoch ist "
              "es ratsam, sie moeglichst geschlossen zu halten, "
              "damit keine kostbare Waerme entweicht.");

  AddDetail ( ({ "waerme" }),
              "Du fuehlst Dich einfach so richtig pudelwohl hier.");

  AddSmell (DEFAULT_SMELL, 
            "Es riecht hier angenehm nach aetherischen "
            "Oelen. So richtig angehem einfach.");
  AddSmell( ({ "oele", "oelen" }),
            "Du kannst nicht rausriechen welche genau es sind, "
            "aber es riecht soooooooo gut.");
  AddSound(DEFAULT_SOUND,
           "Es ist absolut still.");
  

                    

  AddCmd( ({ "oeffne" }), "oeffnen");
  AddCmd( ({ "schliesse" , "schliess" }), "schliessen");
  AddCmd( ({ "giesse", "aufgiessen", "aufguss" }), "aufguss");
  AddCmd( ({ "sperre", "sperr", "lock" }), "lock");
  AddCmd( ({ "enstperre", "aufsperren", "unlock" }), "unlock");

}


int aufguss()
{
  tell_room(ME, BS(TP->Name(WER) + " giesst etwas Wasser ueber die "
                   "gluehenden Steine im Ofen, welches sofort mit "
                   "leisem Zischen verdampft."), ({ TP }));

  tell_object(TP, BS("Du giesst etwas Wasser ueber die "
                     "gluehenden Steine im Ofen, welches sofort mit "
                     "leisem Zischen verdampft."));

  return 1;
}




int oeffnen(string str)
{

  notify_fail("WAS willst Du oeffnen?\n");
  if (!str) return 0;

  if (str != "tuer" && str != "tuere"
      && str != "saunatuer" && str != "saunatuere") return 0;

  notify_fail("Die Tuere ist doch schon offen!\n");
  if (tuerstat) return 0;

  notify_fail("Die Tuer ist verschlossen!\n");
  if(locked) return 0;

  tell_object(TP, BS("Du oeffnetst die Saunatuere."));
  tell_room(ME, BS(TP->Name(WER) + " oeffnet die Saunatuere."), ({ TP }));

  tell_room(SEHERHAUS, BS("Die Tuere wird von innen geoeffnet."));


  AddExit("raus", SEHERHAUS);
  find_object(SEHERHAUS)->opendoor();
  tuerstat = 1;

  return 1;
}

int schliessen(string str)
{

  notify_fail("WAS willst Du schliessen?\n");
  if (!str) return 0;

  if (str != "tuer" && str != "tuere"
      && str != "saunatuer" && str != "saunatuere") return 0;

  notify_fail("Die Tuere ist doch schon geschlossen!\n");
  if (!tuerstat) return 0;

  tell_object(TP, BS("Du schliesst die Saunatuere."));
  tell_room(ME, BS(TP->Name(WER) + " schliesst die Saunatuere."), ({ TP }));

  tell_room(SEHERHAUS, BS("Die Tuere wird von innen geschlossen."));


  RemoveExit("raus");
  find_object(SEHERHAUS)->closedoor();
  tuerstat = 0;

  return 1;
}

int opendoor()
{
  tuerstat = 1;
  AddExit("raus", SEHERHAUS);
  return 1;
}

int closedoor()
{
  tuerstat = 0;
  RemoveExit("raus");
  return 1;
}

int lock()
{
  string p_id;

  p_id = getuid(TP);
 
  if (member(a_allowed, p_id)==-1) return 0;

  notify_fail("Der Raum ist schon verschlossen!\n");
  if (locked) return 0;

  locked = 1;

  SetProp(P_NO_TPORT, 1);

  return 1;
  
}


int unlock()
{
  string p_id;
 
  p_id = getuid(TP);

  if (member(a_allowed, p_id) == -1) return 0;

  notify_fail("Der Raum ist doch garnicht verschlossen?\n");
  if (!locked) return 0;

  locked = 0;

  SetProp(P_NO_TPORT, 0);

  return 1;

}

int query_locked()
{
  return locked;
}


void init()
{
  ::init();

  if (!locked) return;

  if (member(a_allowed, getuid(TP)) != -1) return;

  tell_object(TP, BS("Die enorme Hitze weht Dich wieder raus."));

  if(TP->QueryProp(P_LAST_COMMAND_ENV))
    {
      TP->move(TP->QueryProp(P_LAST_COMMAND_ENV), M_NOCHECK + M_TPORT);
    }
  else
    {
      TP->move("/gilden/abenteurer", M_NOCHECK + M_TPORT);
    }

  return;   
}

/* Wir resetten nicht. */
void reset()
{
  return;
}

int prevent_insert()
{
  if (!locked) return 1;
  
  if (member(a_allowed, getuid(TP)) != -1) return 1;
  
  return 0;

}