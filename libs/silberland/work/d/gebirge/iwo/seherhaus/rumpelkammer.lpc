inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include "def.h"


create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "In einer Rumpelkammer");
  SetProp (P_INT_LONG, "In dieser Kammer liegen normalerweise "
    "diverse Waffen, Ruestungen und sonstiges Zeugs.\n\n"
    "DU WEISST GENAU, DASS DU NICHTS OHNE ERLAUBNIS NEHMEN WILLST HIER!\n"
    );

  AddExit("raus", SEHERHAUS);


}                                        


/* Wir resetten nicht */
void reset()
{
  return;
}