#include <defines.h>
#include <combat.h>
#include <properties.h>
#include <moredef.h>
#include <moving.h>

#include "../def.h"

inherit "std/npc";

void create()
{
  object ob;

  if (!is_clone(TO)) return;

  ::create();

  create_default_npc(10);

  AddId(({"ilandi", "magielehrling"}));

  SetProp(P_NAME, "Ilandi");
  SetProp(P_SHORT, "Ilandi der angehende Magielehrling"); 

  SetProp(P_LONG,
    "Ilandi ist ein kleines, hageres Buerschen. Den Hut auf "
    "seinem Kopf hat wohl seine Mutter aus einem alten "
    "Filzumhang genaeht. Ueber seine Schultern haengt ein "
    "zerfetzter Umhang mit grinsenden Sternen und einem "
    "knollennasigen Mond darauf. Wahrscheinlich war es mal "
    "ein Vorhang oder ein Leintuch aus dem Kinderzimmer.");

  SetProp(P_ALIGN, 600);
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);  
  SetProp(P_NOATTACK, " wuerdest nicht einmal Du etwas antun.");

  SetChats(10,
      ({ 
          TO->Name(WER) + " heult sich die Augen aus dem Kopf.\n",
          TO->Name(WER) + " jammert: So werde ich nie ein Zauberer.\n",
          TO->Name(WER) + " schluchzt herzzerreissend.\n",
          TO->Name(WER) + " wimmert: Wenn mir nur jemand helfen wuede!\n"
       }));


  AddInfo( ({ "hilfe", "problem" }),
    "Ich moechte gerne Zauberer werden. Dazu brauche ich jedoch "
    "einen Zauberstab. Staendig verlaufe ich mich in diesem "
    "verdammten Wald. So wird das nie etwas. Moechtest Du mir nicht "
    "Deine Hilfe anbieten?",
    "sagt: ", 1);
  AddInfo( ({ "stab", "zauberstab" }),
    "Der oberste der Zauberer meinte, dass ich in diesem Wald einen "
    "finden wuerde.",
    "sagt: ", 1);
  AddInfo( ({ "wald" }),
    "Dieser Wald hat etwas Seltsames an sich. Kaum hat man sich ein "
    "paar Schritte hinein getraut, verliert man voellig die "
    "Orientierung.");
  

  AddCmd( ({ "biet", "biete" }), "do_help");

  if (ob = clone_object("/p/armour/cloak/umhang"))
    ob->move(ME, M_NOCHECK) 
      && ob->SetProp(P_SHORT, "Ein zerfetzer Umhang");

  if (ob = clone_object("/p/armour/helm/hut"))
    ob->move(ME, M_NOCHECK) 
      && ob->SetProp(P_SHORT, "Ein loechriger Spitzhut");

  if (ob = clone_object(OBJ+"/saege.lpc"))
    ob->move(ME, M_NOCHECK);

  command_me("trage alles");

}


int do_help(string str)
{
  object ob;

  notify_fail("Wem moechtest Du Hilfe anbieten?\n");

  if (str != "ilandi hilfe an" && str != "magielehrling hilfe an")
    return 0;

  tell_object(this_player(),
    break_string("Der oberste der Zauberer hat mir "
    "gesagt, dass ich in diesem Wald einen geeigneten Ast fuer "
    "meinen Zauberstab finden kann. Angeblich waechst hier eine "
    "seltene Art magischer Baeume, deren Aeste wohl die einzigen "
    "sind, welche sich fuer Zauberstaebe eignen. Ich habe schon "
    "versucht einen solchen Baum zu finden, jedoch verlaufe ich "
    "staendig in diesen fuerchterlichen Wald. Vielen Dank, dass Du "
    "mir helfen moechtest! Hier habe ich noch eine Saege fuer Dich.",
    78, TO->Name(WER) + " sagt: ")); 


  if (!present("\nilandisaege", TP))
    {
      ob = clone_object(OBJ+"/saege.lpc");
      ob->move(ME, M_NOCHECK);
      ob->SetProp(P_NODROP, 0);
      if (give_obj(ob, TP))
        ob->SetProp(P_NODROP, 1);
      else
        ob->remove();
    }
  else
    tell_object(this_player(), "Ilandi sagt: Huch, die hab ich Dir schon gegeben!\n");

  return 1;
}
