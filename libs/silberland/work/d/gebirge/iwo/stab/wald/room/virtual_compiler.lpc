mixed CustomizeObject()
{
  string file, *xfile;
  int x,y;
  object wm;

  file = to_string(::CustomizeObject());

  xfile = explode(file, ":");

  x = to_int(xfile[1]);
  y = to_int(xfile[2]);

  wm = find_object(WOODMASTER);
 
  if (!objectp(wm))
    tell_object(find_player("iwo"), "Kein WM!\n");

  if (wm->IsValidRoom(x, y))
    {
      previous_object()->Customize(x, y);
      return file;
    }

  previous_object()->remove();
  return 0;
}


