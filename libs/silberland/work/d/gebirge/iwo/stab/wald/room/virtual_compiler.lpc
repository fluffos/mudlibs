#include <properties.h>
#include <defines.h>
#include <moving.h>
#include <v_compiler.h>
#include <wizlevels.h>

#include "../def.h"

inherit "std/virtual/v_compiler";

void create()
{
  ::create();

  seteuid(getuid(this_object()));

  SetProp(P_COMPILER_PATH, WROOM);
  SetProp(P_STD_OBJECT, STDWOOD);
}

