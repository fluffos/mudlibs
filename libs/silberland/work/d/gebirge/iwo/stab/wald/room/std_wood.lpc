#include <defines.h>
#include <properties.h>
#include <moving.h>

#include "../def.h"

#define P_XY "xy"
#define P_HEADING "heading"


inherit "std/room";

// Prototypes
void Customize(int x, int y);
string TransformExit(object viewer, string exit);


string * a_x = ({ "norden", "nordosten", "osten", "suedosten",
                  "sueden", "suedwesten", "westen", "nordwesten" });
string * a_d = ({ "vorne", "rechtsvorne", "rechts", "rechtshinten",
                  "hinten", "linkshinten", "links", "linksvorne" });

void create()
{
  ::create();

  seteuid(getuid(this_object()));

  SetProp(P_INT_SHORT, "In einem Wald");

  SetProp(P_INT_LONG,
    "Je tiefer Du in den Wald hinein gehst, desto mehr hast Du "
    "das Gefuehl die Orientierung zu verlieren. Ein Baum sieht "
    "aus wie der andere, der Boden sieht ueberall gleich aus, "
    "und den Himmel kannst Du auch nirgends erblicken, um Dich "
    "an der Sonne zu orientieren. Jeder Moment, den Du hier "
    "verbringst, verstaerkt Deine Angst hier nie wieder raus "
    "zu finden.");

  AddDetail( ({ "wald" }),
    "Hier im Wald gibt es kaum etwas, das Deine Aufmerksamkeit "
    "erregt. Die Baeume sehen ueberall gleich aus, und davon "
    "hast Du mittlerweilen schon genug gesehen. Eigentlich "
    "moechtest Du nurmehr finden wonach Du suchst, und dann "
    "moeglichst bald wieder das Weite suchen.");
  AddDetail( ({ "aufmerksamkeit" }),
    "Dir faellt es schwer, Dich bei dieser Einoede auf etwas "
    "Bestimmtes zu konzentrieren.");
  AddDetail( ({ "einoede" }),
    "Dich langweilt, dass der Wald sich so unaufregend gleichmaessig "
    "zeigt.");
  AddDetail( ({ "bestimmtes" }),
    "Wenn es nur etwas Bestimmtes gaebe hier!");
  AddDetail( ({ "baeume", "baeumen" }),
    "Die Baeume sind hier vorbildlich gemischt. Manche tragen "
    "Blaetter, waehrend andere Nadeln tragen - und wiederum andere "
    "tragen keines von beiden. Die meisten Baeume hier, scheinen "
    "schon ziemlich alt zu sein.");
  AddDetail( ({ "blaetter" }),
    "Leider sind die Blaetter viel zu weit oben, um sie genauer "
    "zu erkennen.");
  AddDetail( ({ "nadeln" }),
    "Hoch droben in den Baeumen sind die Nadeln gruen, und am Boden "
    "liegen welche, die schon braun und vertrocknet sind.");
  AddDetail( ({ "boden" }),
    "Der Boden ist bedeckt mit verwelkten Blaettern und abgefallenen "
    "Nadeln. Nicht besonders aufregend.");
  AddDetail( ({ "himmel" }),
    "Die Blaetter und Nadeln bilden ein dichtes Dach, welches Dir "
    "welches Deinen Blick auf den Himmel abschirmt.");
  AddDetail( ({ "blick" }),
    "Wohin Du siehst - Wald!");
  AddDetail( ({ "sonne" }),
    "Obwohl die Sonne etwas durch die Blaetter scheint, und Deine "
    "Umgebung in mattes Licht taucht, kannst Du nicht erahnen in "
    "welcher Richtung sie liegt.");
  AddDetail( ({ "angst" }),
    "Du hast ganz schoene Angst die Orientierung zu verlieren.");
  AddDetail( ({ "orientierung" }),
    "Es gibt hier keine moeglichkeit, sich zu orientieren.");
  AddDetail( ({ "moment" }),
    "Schonwieder ist einer vorbei.");
  AddDetail( ({ "licht" }),
    "Hier herrscht nicht viel Licht, aber es reicht, dass tagsichtige "
    "Wesen sehen koennen.");
  AddDetail( ({ "wesen" }),
    "Nicht einmal solche kannst Du hier sehen.");
  AddDetail( ({ "baum" }),
    "Eigentlich sehen alle Baeume hier gleich aus. Kein "
    "Grund, sich mit einem einzelnen zu beschaeftigen.");
  AddDetail( ({ "umgebung" }),
    "Deine Umgebung ist deutlich von Baeumen gepraegt.");
  AddDetail( ({ "gefuehl" }),
    "Dein Gefuehl sagt Dir, dass Du die Orientierung verloren "
    "hast.");
  AddDetail( ({ "weite" }),
    "Wenn Du nur wuesstest, wo das ist...");
  AddDetail( ({ "dach" }),
    "Das Dach ist so dicht, dass es Dir jeglichen Blick auf den "
    "Himmel verwehrt.");


  previous_object()->CustomizeObject();

  AddCmd("map", "mapfun");
  AddCmd(a_d, "exitfun");
}

void Customize(int x, int y)
{
  mapping exits;
  string *ex_keys;
  int i;

  exits = WOODMASTER->GiveExits(x, y);

  SetProp(P_XY, ({ x, y }));

  ex_keys = m_indices(exits);


  for (i=0; i < sizeof(ex_keys); i++)
    AddExit(ex_keys[i], exits[ex_keys[i], 0]);
}

varargs string GetExits(object viewer)
{
  string exstr;
  int i, mod_i, mod;

  exstr = ::GetExits(viewer);

  mod = viewer->QueryProp(P_HEADING);

  for (i = 0; i < sizeof(a_x); i++)
    {
      mod_i = i - mod;
      if (mod_i > 7) mod_i -= 8;
      if (mod_i < 0) mod_i += 8;

      exstr = implode(explode(exstr, sprintf("$%s$", a_x[i])), a_d[mod_i]);  
//    exstr = regreplace(exstr, sprintf("$%s$", a_x[i]), a_d[mod_i], 1);
     // tell_object(find_player("iwo"), sprintf("REP: %s -> %s\n",  a_x[i], a_d[mod_i]));
    }

  return exstr;
}

int mapfun()
{
  int *xy;

  xy = QueryProp(P_XY);

  tell_object(this_player(), sprintf("%s\n", WOODMASTER->ShowIMap(xy[0], xy[1])));

  return 1;
}

int exitfun()
{
  string *x;
  int num, head, i;
  object *inv;

  x = m_indices(QueryProp(P_EXITS));

  num = member(a_d, query_verb()) + this_player()->QueryProp(P_HEADING);

  if (num < 0) num += 8;
  if (num > 7) num -= 8;

  if (member(x, sprintf("$%s$", a_x[num])) == -1)
    {
      tell_object(this_player(), "Dahin kannst Du nicht gehen.\n");
      return 1;
    }
  
  head = this_player()->QueryProp(P_HEADING);
  head += member(a_d, query_verb());
  if (head > 7) head -= 8;
  if (head < 0) head += 8;
  this_player()->SetProp(P_HEADING, head);

  if (this_player()->move(QueryProp(P_EXITS)[sprintf("$%s$", a_x[num])], M_GO))
    tell_room(QueryProp(P_EXITS)[sprintf("$%s$", a_x[num])],
      break_string(sprintf("%s %s.", 
                     this_player()->Name(WER),
                     this_player()->QueryProp(P_MSGIN)), 78),
        ({ this_player() }));

  if (!this_player()->QueryProp(P_INVIS))
    {
      inv = all_inventory(ME);

      for (i=0; i < sizeof(inv); i++)
        if (!this_player()->QueryProp(P_INVIS))
          tell_object(inv[i],
            break_string(sprintf("%s %s nach %s.",
                           this_player()->Name(WER),
                           this_player()->QueryProp(P_MSGOUT),
                           TransformExit(inv[i], a_x[num])), 78));
    }

  return 1;
}

string TransformExit(object viewer, string exit)
{
  int key;

  key = member(a_x, exit);

  // Alter by heading
  key += viewer->QueryProp(P_HEADING);

  if (key < 0) key += 8;
  if (key > 7) key -= 8;

  return a_d[key];
}
