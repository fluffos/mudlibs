#include <properties.h>


inherit "std/npc";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  create_default_npc(10);

  AddId( ({ "herum", "baum" }) );

  SetProp(P_NAME, "Herum");

  SetProp(P_GENDER, MALE);

  SetProp(P_SHORT, "Ein magischer Herum");

  SetProp(P_LONG, "Long");

  SetProp(P_ARTICLE, 1);

}
