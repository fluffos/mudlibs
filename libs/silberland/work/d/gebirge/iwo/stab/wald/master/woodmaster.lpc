#include <defines.h>
#include <properties.h>
#include <moving.h>

#define MAP "/d/gebirge/iwo/stab/wald/master/map.asc"
#define TREE "/d/gebirge/iwo/stab/wald/npc/tree.lpc"
#define ROOMDIR "/d/gebirge/iwo/stab/wald/room/"
#define NUM_TREES 5 

#define MYDEBUG(x) if (find_player("iwo")) tell_object(find_player("iwo"), break_string(x, 78, "WOOD: "))


inherit "std/thing";

// Variables
string *map = ({});
string *known_rooms = ({});
object *known_trees = ({});
mapping players = ([]);

//  Prototypes
void create();
int LoadMap();
int SetupKnownRooms();
int SetupTrees();
int *Coords2Mapc(int x, int y);
int *Mapc2Coords(int x, int y);

void create()
{
  if (is_clone(this_object())) return;

  seteuid(getuid(this_object()));

  ::create();

  LoadMap();
  SetupKnownRooms();
  SetupTrees();
}

int *Mapc2Coords(int x, int y)
{
  y = (sizeof(map)-1)/2 - (y / 2);
  x = x / 2;
  return ({ x, y });
}

int *Coords2Mapc(int x, int y)
{
  y = sizeof(map)-1 - (y * 2);
  x = x * 2;
  return ({ x, y });
}

int IsValidRoom(int x, int y)
{
  int *coords;

  coords = Coords2Mapc(x, y);

  //MYDEBUG(sprintf("%O", coords));
  //MYDEBUG(map[coords[1]]);
  return map[coords[1]][coords[0]] == 'o';
}


int GetField(int x, int y)
{
  int *c;

  c = Coords2Mapc(x, y);

  return map[c[1]][c[0]];
}


mapping GiveExits(int x, int y)
{
  mapping ex;
  int tx, ty;

  // Transform to mapcoords
  ty = sizeof(map)-1 - (y * 2);
  tx = x * 2;

  ex = ([]);
//tell_object(find_player("iwo"), sprintf("Norden: %c\n", GetField(x, y+1)));
  // Norden
  if (map[ty-1][tx]== '|')
    ex += ([ "$norden$" : sprintf("./wood:%d:%d", x, y+1) ]);
  // NOrdosten
  if (member("/X", map[ty-1][tx+1]) != -1)
    ex += ([ "$nordosten$" : sprintf("./wood:%d:%d", x+1, y+1) ]);
  // Osten
  if (x == 26 && y == 9) // Check fuer Wald verlassen
    ex += ([ "$osten$": "/d/gebirge/iwo/stab/room/waldrand.lpc" ]);
  else
    if (map[ty][tx+1] == '-')
      ex += ([ "$osten$" : sprintf("./wood:%d:%d", x+1, y) ]);
  // Suedosten
  if (member("\\X", map[ty+1][tx+1]) != -1)
    ex += ([ "$suedosten$" : sprintf("./wood:%d:%d", x+1, y-1) ]);
  // Sueden
  if (map[ty+1][tx] == '|')
    ex += ([ "$sueden$" : sprintf("./wood:%d:%d", x, y-1) ]);
  // Suedwesten
  if (member("/X", map[ty+1][tx-1]) != -1)
    ex += ([ "$suedwesten$" : sprintf("./wood:%d:%d", x-1, y-1) ]);
  // Westen
  if (map[ty][tx-1] == '-')
    ex += ([ "$westen$" : sprintf("./wood:%d:%d", x-1, y) ]);
  // Nordwesten
  if (member("\\X", map[ty-1][tx-1]) != -1)
    ex += ([ "$nordwesten$" : sprintf("./wood:%d:%d", x-1, y+1) ]);

  return ex;
}


int ShowMap()
{
  tell_object(this_player(), implode(map, "\n") + "\n");

  return 1; 
}

string ShowIMap(int x, int y)
{
  int *c;
  string *tmap , str;
  int *arrows, arrow;

  c = Coords2Mapc(x, y);
  tmap = ({}) + map;

  tmap[c[1]][c[0]] = '#';

  str = implode(tmap, "\n");

  switch ((int) this_player()->QueryProp("heading"))
    {
      case 0:
        str += "\n --- \n| # |\n|   |\n|   |\n --- \n";
        break;
      case 1:
        str += "\n --- \n|  #|\n|   |\n|   |\n --- \n";
        break;
      case 2:
        str += "\n --- \n|   |\n|  #|\n|   |\n --- \n";
        break;
      case 3:
        str += "\n --- \n|   |\n|   |\n|  #|\n --- \n";
        break;
      case 4:
        str += "\n --- \n|   |\n|   |\n| # |\n --- \n";
        break;
      case 5:
        str += "\n --- \n|   |\n|   |\n|#  |\n --- \n";
        break;
      case 6:
        str += "\n --- \n|   |\n|#  |\n|   |\n --- \n";
        break;
      case 7:
        str += "\n --- \n|#  |\n|   |\n|   |\n --- \n";
        break;
      default:
        str += "\n --- \n| # |\n|   |\n|   |\n --- \n";
    }

  return str;
}   

int LoadMap()
{
  string buf;

  if (!buf = read_file(MAP))
    {
      MYDEBUG("Karte nicht lesbar!");
      return -1;
    }

  //MYDEBUG(buf);

  map = explode(buf, "\n");

  return 1;
}

// Probably a bit expensive
int SetupKnownRooms()
{
  int my, mx;
  int *c;

  for (my = 0; my < sizeof(map); my++)
    {
      for (mx = 0; mx < strlen(map[my]); mx++)
        {
          if (map[my][mx] == 'o')
            {
              c = Mapc2Coords(mx, my);
              known_rooms += ({ sprintf("wood:%d:%d", c[0], c[1]) });
            }
        }
    }
}


int SetupTrees()
{
  object ob;
  string *rooms, dst;
  int i, r;

  MYDEBUG("SETUPTREES");

  rooms = ({}) + known_rooms;

  for (i = sizeof(known_trees); i < NUM_TREES; i++)
    {
      r = random(sizeof(rooms));

      dst = sprintf("%s%s", ROOMDIR, rooms[r]);

      MYDEBUG(sprintf("Placing at %s", rooms[r]));

      call_other(dst, "???", 0);

      ob = clone_object(TREE);

      known_trees += ({ ob });

      if (ob->move(dst, M_NOCHECK))
        MYDEBUG(sprintf("Ok (%O)", ob));
      else
        MYDEBUG("FAILED!");

      rooms -= ({ rooms[r] });
    }

  return 1;
}

varargs int remove(int silent)
{
  int i;
  object ob;

MYDEBUG("here");

  known_trees -= ({ 0 });

  for (i=0; i < sizeof(known_trees); i++)
    {
      MYDEBUG(sprintf("Zerstoere %O\n", known_trees[i]));

      known_trees[i]->remove();
    }


  for (i=0; i < sizeof(known_rooms); i++)
    {
      ob = find_object(sprintf("%s%s", ROOMDIR, known_rooms[i]));


      if (ob)
        {
          MYDEBUG(sprintf("Zerstoere %s\n", known_rooms[i]));
          ob->remove();
        }
    }

MYDEBUG("here2");
  return ::remove(silent);
}


