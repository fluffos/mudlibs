#include <defines.h>
#include <properties.h>

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "An einem Waldrand");

  SetProp(P_INT_LONG,
    "Du stehst am Rande eines riesigen Waldes. Scheinbar uralte "
    "Baeume geben hier einen Weg in die untiefen dieses selstsamen "
    "Waldes frei. Ein paar manshohe Graeser zieren den Rand hier, "
    "so dass eine fast schon malerische Idylle entsteht.");

  AddDetail( ({ "wald", "waldes" }),
    "Der Wald scheit sehr dicht zu sein, und hauptsaechlich aus "
    "sehr alten Baeumen zu bestehen.");
  AddDetail( ({ "baeume", "nadelbaeume", "laubbaeume" }),
    "Hier wachsen durcheinander Nadel- und Laubbaeume - ein "
    "richtig gesunder Wald sozusagen.");
  AddDetail( ({ "weg" }),
    "Der Weg, den Du gekommen bist, scheint hier weiter in den Wald "
    "zu fuehren - oder heraus... ");
  AddDetail( ({ "graeser" }),
    "Mannshohe - oder zumindest zwergenhohe - Graeser saeumen den "
    "Waldrand.");
  AddDetail( ({ "idylle" }),
    "Am liebesten wuerdest Du es Dir hier ein bisschen gemuetlich "
    "machen und rasten.");
  AddDetail( ({ "boden" }),
    "Hier am Boden waechst etwas vom staendigen darueberlatschen "
    "zurueckgebliebenes Gras.");
  AddDetail( ({ "gras" }),
    "Ansonsten sieht es eigentlich recht fit aus - findest Du "
    "zumindest.");
  AddDetail( ({ "himmel" }),
    "Hoch droben am Himmel brennt strahlend die Sonne herunter. "
    "Nur bedingt angenehm.");
  AddDetail( ({ "sonne" }),
    "Die Sonne lacht frech herunter.");
  AddDetail( ({ "rand", "rande", "waldrand" }),
    "Hier endet der dichte Wald.");


  AddExit("nordosten", "/d/gebirge/iwo/weg/room/04-08.lpc");
  AddExit("westen", "/d/gebirge/iwo/stab/wald/room/wood:26:9");

  AddItem(NPC+"/ilandi.lpc", REFRESH_DESTRUCT);
  
}

varargs int PreventInsert(object ob)
{
  if (ob && query_once_interactive(ob))
    ob->SetProp("heading", 6);

  return ::PreventInsert(ob);
}

