#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>


inherit "std/thing";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  AddId( ({ "saege", "\nilandisaege" }));

  SetProp(P_NAME, "Saege");
  SetProp(P_SHORT, "Eine kleine Saege");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([ MAT_WOOD: 60, MAT_IRON: 40 ]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Die brauchst Du wohl noch!\n");

  SetProp(P_LONG, "Diese kleine Saege liegt gut in der Hand. Sie "
    "reicht locker aus, um einen armdicken Ast abzuschneiden.");

  AddCmd( ({ "schneid", "schneide", "saeg", "saege" }),
    "cut_off");
}

int cut_off(string str)
{
  notify_fail("Was moechtest Du abschneiden?\n");

  if (str != "ast ab")
    return 0;

  notify_fail("Irgendwie fehlt Dir noch der richtige Baum.\n");
  return 0;
}
