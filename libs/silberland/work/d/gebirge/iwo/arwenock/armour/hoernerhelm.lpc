#define WIZNAME "andyl"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>ls



create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId (({"helm", "hoernerhelm"}));
  SetProp (P_SHORT, "Ein zwergischer Hoernerhelm");
  SetProp (P_LONG, "Es ist ein typischer zwergischer Hoernerhelm. "
	   +"Er ist mit vielen Nieten und Stacheln besetzt und hat "
	   +"zwei spitze Hoerner. Er hat eine matte dunkle Farbe "
	   +"und wirk auf Gegner sicherlich bedrohlich.\n");
  SetProp (P_NAME, "Hoernerhelm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 2000);
  SetProp (P_VALUE, 2500);
  SetProp (P_ARMOUR_TYPE, AT_HELMET); 
  SetProp (P_AC, 10);
  SetProp (P_EFFECTIVE_WC, 100);
  SetProp (P_QUALITY_DECAY, 100);
  SetProp (P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_BLUDGEON:3]));
  SetProp (P_MATERIAL, ([MAT_STEEL:90, MAT_HORN:10]));
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );
}
