inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Hose");
  SetProp(P_LONG, 
    "Eine gewoehnliche dunkelblaue Hose. Sehr billig und einfach "
    "gearbeitet." );
  SetProp(P_NAME, "Hose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_CLOTH:50, MAT_LEATHER:25, MAT_FELT:25]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 250);
}
