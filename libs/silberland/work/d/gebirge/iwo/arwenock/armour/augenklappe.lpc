inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

#define WIZNAME "andyl"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"klappe", "augenklappe"}));
  SetProp (P_SHORT, "Eine dunkle metallene Augenklappe");
  SetProp (P_LONG,
	   "Es ist eine dunkle metallene Augenklappe welche "
	   +"mit Nieten besetzt ist. Wer dies traegt macht sicher "
	   +"einen sehr finsteren Eindruck.\n");
  SetProp (P_NAME, "Augenklappe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 10);
  SetProp (P_VALUE, 20);
  SetProp (P_ARMOUR_TYPE, AT_MISC);
  SetProp (P_AC, 0);
  SetProp (P_WORN_TEXT, "getragen");
  SetProp (P_MATERIAL, MAT_IRON);
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );
}
