/*
** Ein Panzer der Stadtwache von Arwenock
**
** by AnDyL@Silberland
**
** 01.03.2000
**
** Last updated: 01.03.2000
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

#define WIZNAME "andyl"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"panzer","arwenockpanzer"}));
  SetProp (P_SHORT, "Ein Arwenockpanzer");
  SetProp (P_LONG,
	   "Der Arwenockpanzer wird ausschliesslich von der Stadtwache von "
	   +"Arwenock verwendet. Er ist eine praechtige Kombination aus "
	   +"Mithril und Stahl welches sehr sauber verarbeitet wurde. "
	   +"Das Wappen von Arwenock, die Eiche mit dem Reh und dem "
	   +"knieenden Ritter, ziert die Brustplatte des Panzers. "
	   +"Er bietet sicher einen sehr guten Schutz gegen alle moeglichen "
	   +"physikalische Angriffe.\n");
  SetProp (P_NAME, "Arwenockpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 3000);
  SetProp (P_VALUE, 2800);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 35);
  SetProp (P_MATERIAL, ([MAT_STEEL:50, MAT_MITHRIL:50]));
  SetProp (P_QUALITY_DECAY, 170+random(20) );
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:16, A_CON:15]) );
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );
}










