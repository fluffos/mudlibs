inherit "std/armour";

#include <properties.h>
#include <combat.h>

#define MAXFUELL 10 // Liter

int fuellstand = 0;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Eimer");
  SetProp(P_LONG, 
    "Der eimer ist nicht sonderlich gross, er mag vielleicht "
    "zehn Helme voller Wasser fassen. Er besteht aus relativ "
    "duennen Blech, und hat schon die eine oder andere Beule. "
    "Sein oberes Ende ziert ein kleiner Griff aus Holz.");

  SetProp(P_NAME, "Eimer");
  SetProp(P_GENDER, MALE);
  AddId (({"eimer"}));
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD); 
  SetProp(P_AC, 15); 
  SetProp (P_MATERIAL, ([ MAT_IRON: 95, MAT_WOOD: 5 ]));

  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 100);

  AddDetail(( { "griff" }),
    "Eigentlich nich wirklich interessant. Er erleichtert Dir "
    "lediglich das Tragen des Eimers.");

}


int AddFill(int l)
{
  fuellstand += l;  
  return fuellstand;
}

int QueryFill()
{
  return fuellstand;
} 

