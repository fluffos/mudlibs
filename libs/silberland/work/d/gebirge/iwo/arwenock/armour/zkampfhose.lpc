/*
**              Kampfhose des Oberruepels
**
**
**              Zaknafein, Februar 2000
** 
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();   

  SetProp(P_SHORT, "Eine Kampfhose");
  SetProp(P_LONG, "Die Kampfhose besteht aus sehr dickem und robustem Leder. "
                 +"An den Knien und und im Genitalbreich wurde sie besonders "
                 +"verstaerkt, wodurch sie hervorragend schuetzt.\n");
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_NAME, "Kampfhose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "kampfhose" , "hose" }) );
  SetProp(P_WEIGHT, 1820);
  SetProp(P_VALUE, 650);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 8);
}
