/*
**              Kampfhose des Oberruepels
**
**
**              Zaknafein, Februar 2000
** 
*/

inherit "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();   

  SetProp(P_SHORT, "Ein Achselhemd");
  SetProp(P_LONG, "Das Achselhemd ist schon ziemlich zerschlissen und verbreitet "
                 +"einen uebelriechenden Geruch. Es war wohl mal weiss, aber das "
                 +"kann man nur noch erahnen, da es mit Flecken uebersaeht ist. "
                 +"Es koennte aber gut sein, dass es Dich vor Kaelte schuetzt, wenn "
                 +"Du es unter Deiner Ruestung traegst.\n");
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_NAME, "Achselhemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "achselhemd" , "hemd" }) );
  SetProp(P_WEIGHT, 230);
  SetProp(P_VALUE, 50);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:2, T_HEAT_PROT:0 ]) );
  SetProp(P_SMELL, "Wuahh, das Achselhemd riecht arg nach Schweiss!\n");
  SetProp("underwear_type", "Top");

}
