// Zaknafein Mai 2000

#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

#define WIZNAME "zaknafein"

create()
{
  ::create();

  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" ); 
  SetProp(P_INT_SHORT, "Auf dem Marktplatz in Arwenock");
  SetProp(P_INT_LONG, 
    "Du stehst jetzt am suedlichen Ende des Marktplatzes in Arwenock. Auch "
   +"hier schieben sich viele Haendler und Passanten an dir vorbei wie mitten "
   +"auf dem Platz weiter im Norden, wo Du neben den marktplatzueblichen Staenden "
   +"auch noch einige Aufbauten erkennen kannst. Im Westen kannst du noch die Stadtmauer "
   +"erkennen. Im Sueden siehst du ein Haus, aus dessen Fenstern ein Schimmern "
   +"zu erkennen ist. Nach Osten fuehrt die Strasse weiter stadteinwaerts.\n");

  AddDetail( "ende" ,
    "Hier endet der Marktplatz in suedlicher Richtung.\n");
  AddDetail( ({ "richtung" , "richtungen" }) ,
    "In einige Richtungen kann man sich bewegen.\n");
  AddDetail( ({ "platz" , "marktplatz" }) ,
    "Du stehst hier am suedlichen Ende des Marktplatzes. "
   +"Weiter im Norden sind die Staende aufgebaut. An den Staenden kaufen viele Passanten "
   +"Waren ein. Ausserdem siehst Du einige Aufbauten.\n");
   AddDetail( ({ "staende" , "stand" , "staenden" }) ,
    "Viele Staende stehen auf dem Marktplatz. An den Staenden preisen Haendler ihre Waren an. "
   +"Viele Passanten kaufen ihnen die Waren auch ab.\n");
  AddDetail( ({ "ware" , "waren" }) ,
    "Du musst schon hingehen, um zu erkennen, was sie anbieten.\n");
  
  AddDetail( "aufbauten" ,
    "Einige Stangen ragen in den Himmel. Zwischen zweien haengt "
    +"bedrohlich ein grosses Axtblatt.\n");
  AddDetail( ({ "stangen" , "stange" , "axtblatt" , "stadtmauer" }) ,
    "So genau kannst Du es von hier aus nicht "
    +"erkennen. Vielleicht solltest Du mal naeher ran gehen.\n");
  AddDetail( ({ "himmel" , "wetter" }) ,
    "Die Sonne brennt vom wolkenlosen Himmel herab. "
    +"Lediglich ein leichter Wind sorgt fuer ein wenig Abkuehlung.\n");
  AddDetail( "sonne" ,
    "Sie steht hoch am Himmel und brennt auf Arwenock und Dich nieder.\n");
  AddDetail( "wind" ,
    "Er sorgt fuer ein wenig Kuehlung.\n");
  AddDetail( ({ "kuehlung" , "abkuehlung" }) ,
    "Sehr angenehm, dieser Wind.\n");
  AddDetail( "arwenock" ,
    "So heisst diese Stadt, die ueberall als Haendlerparadies bekannt ist.\n");
  AddDetail( "stadt" ,
    "Hier leben viele Menschen.\n");
  AddDetail( ({ "mensch" , "menschen", "lebewesen" }) ,
    "Das sind Lebewesen wie Du.\n");
  AddDetail( "haendler" ,
    "Haendler gibt es hier wie Sand am Meer, da Arwenock ueberall als Handelsparadies "
   +"bekannt ist.\n");
  AddDetail( ({ "sand" , "meer" }) ,
    "Das sagt man halt so...\n");
  AddDetail( "passanten"  ,
    "Die Passanten machen wohl hier eilig ihre Einkaeufe.\n");
  AddDetail( ({ "einkaeufe" , "einkauf" }) ,
    "Man kann hier fast ueberall sein Geld ausgeben.\n");
  AddDetail( "geld" ,
    "Du schaust in deine Geldboerse und stellst erleichtert fest, dass noch alles da ist.\n");
  AddDetail( "geldboerse" ,
    "Da bewahrt man sein Geld drin auf.\n");
  AddDetail( ({ "paradies" , "haendlerparadies" , "handelsparadies" }) ,
    "Den Haendlern scheint es hier richtig gut zu gehen, sonst waeren wohl auch nicht "
    +"so viele hier!\n");
  AddDetail( "strasse" ,
    "Sie fuehrt nach Osten in die Stadt.\n");
  AddDetail( "osten" ,
    "Gehst du nicht nach Osten, tust du hier verrosten.\n");
  AddDetail( "eisen" ,
    "Die Stangen und das Axtblatt scheinen aus Eisen zu sein.");
  AddDetail( "haus" , 
    "Das Haus hat eine grosse Tuer, ueber der ein Schild haengt. Die Fenster zu "
   +"beiden Seiten der Tuer schimmern in einem schwachen Licht. Aus dem Haus dringen laute "
   +"Sauflieder.\n");
  AddDetail( "schild" ,
    "Du kannst es lesen.\n");
  AddDetail( ({ "seite"}) ,
    "An beiden Seiten befinden sich Fenster.\n");
  AddDetail( "tuer" ,
    "Eine grosse Tuer aus schwarzem Kristall versperrt dir die Sicht ins Innere des Hauses.\n");
  AddDetail( ({ "kristall" }),
    "Die grosse Tuer ist aus schwarzem Kristall.");
  AddDetail( "fenster" , 
    "Durch die schwarzen Kristallscheiben kann man fast nichts im Inneren erkennen. Lediglich "
   +"ein schwaches Schimmern dringt nach aussen. \n");
  AddDetail( ({ "schimmern" , "schimmer" , "licht" }) , 
    "Durch die Scheiben dringt nur wenig Licht nach draussen.\n");
  AddDetail( ({ "sicht" , "kristallscheiben" , "scheiben" }) ,
    "Leider kannst du durch den Kristall nichts erkennen.\n");
  AddDetail( "innere" ,
    "Warum gehst du nicht einfach mal rein ?\n");
  AddReadDetail( "schild" ,
    "Kneipe zum Drachenmaul\n");
  
  AddDetail( ({"sauflieder" , "gegroehle"}),
    "Laut gegroehlt schallen die Sauflieder aus dem Haus.\n");
  AddSound( DEFAULT_SOUND ,
    "Die Haendler preisen laut ihre Waren an. Aus dem Haus im Sueden ist lautes Gegroehle zu hoeren.\n");
  AddSound( ({ "sauflieder" , "gegroele" }) ,
    "Ana ged no, ana ged no rein...\n");
  AddSmell( DEFAULT_SMELL ,
    "Vom Markt her kommen viele verschiedene Gerueche herueber. Dazu mischen sich noch Duft von leckerern Speisen "
   +"aus dem Haus im Sueden.\n");
  AddSmell( ({ "gerueche" , "geruch" }) ,
    "Es riecht nach allem moeglichen.\n");
  AddSmell( ({ "duft" , "speisen" }) ,
    "Dir laeuft schon das Wasser im Mund zusammen.\n");



  AddExit( "osten",  ROOM "room_D-03" );
  AddExit( "norden", ROOM "room_C-04" );
  AddExit( "westen", ROOM "room_B-03" );
  AddExit( "sueden", ROOM "zkneipe" );

}
