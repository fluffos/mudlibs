/*
**         Armenviertel von Arwenock
**
**          Zaknafein, Februar 2000
*/

#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#define WIZNAME "zaknafein"

create()
{
  ::create();
  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_TOWN])); 
  SetProp(P_INT_SHORT, "In einem schaebigen Stadtteil von Arwenock" );
  SetProp(P_INT_LONG,
    "Du kommst nun in den Teil der Stadt, in dem die armen Einwohner "
   +"Arwenocks wohnen. Schaebige, verkommene Haeuser saeumen die "
   +"schmale Gasse, die durch das Armenviertel fuehrt. Hin und wieder "
   +"huscht eine zwielichtige Gestalt an Dir vorbei. Du solltest hier "
   +"besonders auf Deine Geldboerse Acht geben.");
 
  AddDetail( ({ "teil" , "stadt" , "arwenocks" , "arwenock" , "viertel" , "armenviertel" }) ,
    "In diesem Teil der Stadt wohnen die armen Einwohner Arwenocks. "
   +"Ausserdem treiben sich hier viele zwielichtige Gestalten rum.\n");
  AddDetail( "einwohner" ,
    "Gelegentlich schlendert ein Einwohner die Gasse entlang.\n");
  AddDetail( ({ "gestalt" , "gestalten" }) ,
    "Es wunderte Dich nicht, wenn Dir eine davon was staehle.\n");
  AddDetail( ({ "haeuser" , "haus" }) ,
    "Die Haeuser sind ziemlich schaebig und heruntergekommen. Betreten "
   +"solltest Du wohl keines von ihnen.\n");
  AddDetail( ({ "fenster" , "tuer" , "tueren" }) ,
    "Die Fenster und Tueren der Haeuser sind verschlossen.\n");
  AddDetail( ({ "boerse" , "geldboerse" }) ,
    "Hast Du sie noch?\n");
  AddDetail( ({ "reform" , "rechtschreibreform" , "acht" }) ,
    "Nach der Rechtschreibreform schreibt man nicht mehr 'achtgeben', sonder "
   +"'Acht geben'. Was aber nicht heisst, dass man 'Acht' gleich untersuchen "
   +"muss. ;) \n");
  AddDetail("boden" ,
    "Der Boden hier in der Gasse wurde mit Steinen gepflastert.\n");
  AddDetail( ({ "pflastersteine" , "steine" }) ,
    "Die Pflastersteine wurden hier nicht sehr sorgfaeltig verlegt. "
   +"Zwischen den einzelnen Steinen klaffen grosse Luecken.\n");
  AddDetail( ({ "luecke" , "luecken" }) ,
    "Du schaust in eine der Luecken, findest aber nichts.\n");
  AddDetail("gasse" ,
    "Die Gasse hier ist recht eng und schaebig.\n");
  AddDetail("himmel" ,
    "Ein paar Wolken verdecken die Sonne.\n");
  AddDetail( ({ "wolke" , "wolken" }) ,
    "Es wird wohl bald regnen.\n");
  AddDetail("sonne" ,
    "Sie ist hinter den Wolken verborgen.\n");
  AddDetail("kind" ,
    "Du denkst . o O ( Das arme Kind! )\n");
  AddDetail( ({ "ratte" , "ratten" }) ,
    "Es wundert Dich nicht, dass es hier Ratten gibt.\n");

  AddSmell( DEFAULT_SMELL , "Hier riecht es nicht gerade sehr angenehm.\n");
  AddSound( DEFAULT_SOUND , "In einem der Haeuser streitet ein Ehepaar.\n");
  AddSound( ({ "streit" , "ehepaar" }) , 
            "Sei nicht so neugierig. Das geht Dich wirklich nichts an.\n");

  AddRoomMessage( ({ "Eine Ratte huscht ueber den Boden.\n",
                     "Es stinkt hier wirklich schrecklich!\n",
                     "Ein Kind weint in einem der Haeuser.\n",
                     "Eine Gestalt, die es besonders eilig hat, stoesst mit Dir zusammen.\n"
                  }), 30, "dieb");

  AddExit( "suedwesten", ROOM "room_B-06" );
  AddExit( "osten", ROOM "room_D-07" );

}

dieb( int msg ) // geplant ist noch ein Raum, in dem das Geld dann liegt ;)
{
if (msg == 3)
{
  if((this_player()->QueryMoney())>=500)
  {
    this_player()->AddMoney(-random(500));
    if((this_player()->QueryProp(P_ATTRIBUTES)[A_DEX]) > random(35) )
    {
     write(BS("Warum kommt Dir Deine Geldboerse ploetzlich so leicht vor?\n"));
    }
  }
}
} 
