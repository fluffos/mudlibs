
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Hier sind eher die etwas herungergekommenen Gebaeude. "
    "Scheinbar ist hier etwas aermeres Volk sesshaft. Da Du "
    "Dich selbst vom Jungabenteurer, nackt, dumm und wehrlos "
    "hochgearbeitet hast, empfindest Du Sympathie fuer die "
    "Bewohner und Verstaendnis fuer deren Lage.");
  AddDetail( ({ "gebaeude" }),
    "Alles an den Gebaeuden hier scheint nur notduerftig "
    "aufrecht erhalten zu werden. Vieles scheint irgendwie "
    "geflickt.");
  AddDetail( ({ "volk" }),
    "Leute wie Du und.... Aeh naja.... Wie Du halt.");
  AddDetail( ({ "jungabenteurer", "abenteurer" }),
    "Schau Dich halt an! Du bist einer von ihnen.");
  AddDetail( ({ "sympathie" }),
    "Das siechste natuerlich nicht.");
  AddDetail( ({ "bewohner" }),
    "Viele davon leben hier. Sie bilden das Volk.");
  AddDetail( ({ "verstaendnis" }),
    "Du verstehst und geniesst.");
  AddDetail( ({ "lage" }),
    "Etwas aermer halt.");


  AddExit( "westen", ROOM "room_G-07" );
  AddExit( "sueden", ROOM "room_H-06" );

}
