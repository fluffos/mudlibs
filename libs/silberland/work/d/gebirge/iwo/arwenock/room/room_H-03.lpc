
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "querolin"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer engen Gasse in Arwenock");
  
  SetProp(P_INT_LONG, 
          "Du stehst vor der gewaltigen Stadtmauer der Stadt und siehst von "
         +"hier aus der Strasse nach Westen entlang. Viele Passanten tummeln "
         +"sich hier und Du musst schon aufpassen nicht ueber den Haufen "
         +"gerannt zu werden. An der Strassenecke jedoch hat sich eine "
         +"groessere Gruppe angesammelt. ");
  
  AddDetail( ({"passanten","passant"}),
        "Pass gut auf, sonst rennt Dich noch einer um. ");

  AddDetail( ({"haufen","haeufchen","ferkel"}),
        "Hast Du etwa ein Haeufchen gemacht? Ferkel. ");

  AddDetail( ({"strassenecke","ecke","gruppe"}),
        "An der Strassenecke steht eine groessere Anzahl von Leuten. ");

  AddDetail( ({"leute","leuten"}),
        "Geschickt draengst Du Dich etwas nach vorne um zu erkennen warum "
       +"hier so ein Auflauf ist. Ein kleiner Stand befindet sich hier. ");

  AddDetail( ({"stand","gewuerzstand"}),
        "Eine kleine Frau, vermutlich Suedlaenderin wie Du gleich erkennst, "
       +"verkauft hier Gewuerze auf einem kleinen Tisch. ");

  AddDetail( ({"tisch"}),
        "Auf dem Tisch liegen einige kleine Saeckchen mit Gewuerzen. Darunter "
       +"hat die Frau ein kariertes Tischtuch ausgereitet. ");

  AddDetail( ({"saeckchen","beutel"}),
        "In den kleinen Saeckchen hat die Frau ihre Gewuerze eingefuellt. "
       +"Kleine Zettel sind an ihnen angebracht worden. ");

  AddDetail( ({"zettel","preisschild","preisschilder","schilder","zetteln"}),
        "Auf den zetteln steht der Name des Gewurzes, das Gewicht des "
       +"Saeckchens und der Preis. ");

  AddDetail( ({"name","gewicht","preis"}),
        "Das steht alles auf den Zetteln an den Saeckchen. ");

  AddDetail( ({"tischtuch","tuch"}),
        "Das Tischtuch ist kariert und die Gewuerze liegen darauf. ");

  AddDetail( ({"frau","suedlaenderin","grund","aussehen"}),
        "Die Frau verkauft hier Gewuerze. Auf Grund ihres Aussehens hast Du "
       +"natuerlich sofort erkannt, dass Sie aus dem Sueden kommt. ");

  AddDetail( ({"sueden"}),
        "Von weit weg im Sueden. ");

  AddDetail( ({"gewuerze","gewuerz"}),
        "Die Frau verkauft hier die verschiedensten Gewuerze von Aranzini "
       +"bis Zimt. ");

  AddDetail( ({"zimt","aranzini"}),
        "Das ist eines der Gewuerze die hier verkauft werden. ");

  AddDetail( ({"auflauf","menschenauflauf","versammlungen"}),
        "Ein Menschenauflauf eben. So wie ueberall bei groesseren "
       +"Versammlungen. ");

  AddDetail(({"stadtmauer", "mauer"}), 
          "Die Stadtmauer baut sich in Ihrer ganzen groesse vor Dir auf. "
         +"Du bist Dir sicher, dass nichts diese Mauer einreissen kann. ");

  AddDetail(({"strasse"}),
          "Du befindest Dich auf dem Ostweg und blickst von hier aus auf "
         +"einer Querstrasse Richtung Innenstadt. ");

  AddDetail(({"querstrasse","innenstadt","westen"}),
          "In einiger Entfernung ist dort ein Markt zu sehen. ");

  AddDetail( "markt", "Du wirst schon hingehen muessen... ");

  AddSound(DEFAULT_SOUND, 
          "Von der Strassenecke her dringt Stimmengewirr zu Dir. ");

  AddSound( ({"stimmengewirr","stimmen","strassenecke","ecke"}),
          "Anscheinden wird dort um etwas gefeilscht. ");

  AddSmell(DEFAULT_SMELL, 
          "Ein etwas eigenartiger Geruch verbreitet sich hier. Es riecht "
         +"sehr intensiv nach Gewuerzen. ");

  AddSmell( ({"gewuerze","gewuerzen","geruch"}),
          "Der Geruch kommt von der Strassenecke. ");

  AddExit( "norden", ROOM "room_H-04" );
  AddExit( "sueden", ROOM "room_H-02" );
  AddExit( "westen", ROOM "room_G-03" );

}
