
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "querolin"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer engen Gasse in Arwenock");
  
  SetProp(P_INT_LONG, 
          "Der Weg fuehrt Dich entlang der Stadtmauer von Arwenock vorbei. "
         +"Im Westen befindet sich ein kleiner Garten der jedoch von "
         +"keinerlei Umzeunung oder sonstigem eingerenzt wird. Am Boden "
         +"vor Dir liegen ueberall kleine gelbe Kuegelchen verstreut, und "
         +"ein komisches Geraeusch dringt aus dem Garten. ");
 
  AddDetail( ({"garten","grundstueck"}),
        "Der Garten ist nicht gut einzusehen, da er von Straeuchern und "
       +"Bueschen umgeben ist. ");

  AddDetail( ({"boden"}),
        "Am Boden liegen lauter kleine gelbe Kuegelchen verstreut. Was das "
       +"wohl sein koennte? ");

  AddDetail( ({"kuegelchen"}),
        "Als Du eines genauer betrachtest stellst Du fest, dass es sich "
       +"dabei um Mais handelt. ");

  AddDetail( ({"mais"}),
        "Jetzt ist Dir auch klar woher das Gegacker stammt und wozu der "
       +"Mais hier herumliegt. ");

  AddDetail( ({"gegacker"}),
        "Das Gegacker stammt vermutlich von Huehnern die in dem kleinen "
       +"Garten sind. ");

  AddDetail( ({"huehner","huehnern","huhn"}),
        "Der Mais dient den Huehnern als Futter. Die Huehner picken ihn "
       +"einfach vom Boden auf. Warum aber hier draussen welcher liegt "
       +"ist eine andere Sache, wo doch hier gar keine Huehner sind. ");

  AddDetail( ({"sache"}),
        "Die Huehner sind doch alle im Garten, warum also hier der Mais "
       +"liegt ist Dir nicht ganz klar, aber vielleicht laufen ja auch "
       +"manchmal welche heraus und picken die Maiskoerner auf. ");

  AddDetail( ({"maiskoerner"}),
        "Kleine gelbe Maiskoerner. Ein hervorragendes Huehnerfutter. "
        "Der Mais stammt vermutlich von einem Bauernhof. ");

  AddDetail( ({"bauer","bauern"}),
        "Hier kennst Du keinen, aber in der naehe von Midas befindet sich "
       +"angeblich einer. ");

  AddDetail( ({"midas"}),
        "Midas ist eine Stadt die weit weg von hier in der Eben liegt. ");

  AddDetail( ({"ebene"}),
        "Die Region in der sich die Stadt Midas befindet wird Ebene "
       +"genannt. ");

  AddDetail( ({"region"}),
        "Du befindest Dich hier in der Region Gebirge. ");

  AddDetail( ({"futter","huehnerfutter"}),
        "Huehner fressen am liebesten Mais. ");

  AddDetail( ({"weg","strasse","gasse"}),
        "Der Weg fuehrt zwischen dem kleinen Garten und der Stadtmauer "
       +"hindurch ");

  AddDetail( ({"umzeunung","eingrenzung","zaun","gartenzaun"}),
        "Der Garten wird von keinem Zaun eingegrenzt. Nur einige Straeucher "
       +"wurden entlang der Grundgrenze gepflanzt. ");

  AddDetail( ({"straeucher","buesche","gebuesch","strauch"}),
        "Entlang der Grundgrenze zum Garten sind verschiedene Straeucher "
       +"und Buesche gepflanzt worden. ");

  AddDetail( ({"grundgrenze","grund","grenze"}),
        "Entlang dieser wurden einige Straeucher und Buesche gepflanzt. ");

  AddDetail( ({"westen"}),
        "Dort befindet sich ein kleiner Garten. ");

  AddDetail(({"stadtmauer", "mauer","osten"}), 
            "Die gewaltige Stadtmauer ragt oestlich von Dir weit in den "
           +"Himmel. ");

  AddDetail( ({"arwenock","stadt"}),
        "Du befindest Dich in der wundervollen Stadt Arwenock inmitten "
       +"des Gebirges. ");

  AddDetail( ({"gebirges","gebirge"}),
        "Den kannst Du von hier aus leider nicht sehen. ");

  AddDetail( ({"sueden"}),
        "Du kannst der Stadtmauer weiter nach Sueden folgen. ");

  AddDetail( ({"norden"}),
        "Nach Norden fuehrt Dich der schmale Weg weiter der Gasse entlang. ");

  AddSound(DEFAULT_SOUND, 
           "Aus dem Garten dringen komische Geraeusche heraus.");

  AddSound( ({"geraeusche","geraeusch","garten"}),
           "Aus dem Garten dringt ein Gackern. ");

  AddSound("gackern", "Was da wohl dahintersteckt. ");

  AddSmell(DEFAULT_SMELL, 
           "Hier riecht es irgendwie nach Stall. ");

  AddSmell("stall","Der Geruch kommt aus dem kleinen Garten. ");

  AddExit( "norden", ROOM "room_H-05" );
  AddExit( "sueden", ROOM "room_H-03" );

}
