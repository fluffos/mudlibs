
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst mitten auf einem relativ breiten Weg der vom "
    "West- zum Ostende der Stadt fuehrt. Viele Stimmen sind "
    "zu hoeren und staendig rempelt Dich jemand an. "
    "Der Weg ist von vielen Haeuser umrandet, so wie es "
    "in einer grossen Stadt ueblich ist. Viel faellt Dir "
    "ansonsten nicht auf. ");

  AddDetail( ({ "ende", "west", "ost", "westende", "ostende", "O" }),
    "Du denkst . o O (Alles hat ein Ende nur die Wurst hat zwei) ");

  AddDetail( ({ "alles", "Ausnahme" }),
    "Aber auch wirklich alles. Mit einer Ausnahme: Wurst - die "
    "hat naemlich zwei davon. ");

  AddDetail( ({ "silberwald", "wald" }),
    "Viele interessante Dinge kann man im Silberwald entdecken. \n"
    "Man muss sie nur suchen... ");

  AddDetail( ({ "ding", "dinge" }),
    "Davon gibt es viele verschiedene. ");

  AddDetail( ({ "weg", "platz", "weges", "wegs" }),
    "Der Weg ist wie alle in dieser Stadt. Lediglich ein kleiner "
    "Ast faellt Dir auf. ");

  AddDetail( ({ "ast" }),
    "Als Du ihn naeher betrachtest stellst Du fest, dass er "
    "eigentlich gar nichts Besonderes ist. Vielmehr handelt "
    "es sich um einen Ast wie er Silberwald haufenweise zu " 
    "finden ist. ");

  AddDetail( ({ "haeuser", "umrandet" }),
    "Alle Haeuser sehen ziemlich aehnlich aus. Nur eine Haus "
    "faellt Dir besonders auf. ");

  AddDetail( ({ "haus", "besonders" }),
    "Du kannst gar nicht sagen was Dir daran so besonders  "
    "auffaellt, lediglich die Farbe und die Art wie es "
    "gebaut wurde fasziniert Dich. ");

  AddDetail( ({ "farbe", "hausfarbe" }),
    "Ein blasses Alpengruen ist auf der Vorderseite zu sehen. "
    "Die Rueckseite kannst du von hier aus nicht erkennen, "
    "bist Dir aber sicher, dass es auch die gleiche sein wird. ");

  AddDetail( ({ "alpengruen", "gruen" }),
    "Ein wundervolles Gruen. Es erinnert Dich an die wundervollen, "
    "saftigen Wiesen in den Alpen. ");

  AddDetail( ({ "alpen" }),
    "Die sind von hier aus nicht zu sehen. ");

  AddDetail( ({ "wiese", "wiesen", "erinnerungen" }),
    "Du schwelgst in deinen Erinnerungen an saftige, gruene "
    "Wiesen in den Alpen vom letzten bergsteigen. ");

  AddDetail( ({ "vorder", "vorderseite" }),
    "Die kannst Du sehr gut erkennen, nur die Rueckseite siehst "
    "Du von hier aus nicht. ");

  AddDetail( ({ "rueckseite", "rueck", "hinterseite" }),
    "Die Rueckseite sieht man wirklich nicht. ");

  AddDetail( ({ "seite", "seiten" }),
    "Die Seiten siehst Du auch noch einigermassen gut. "
    "Und wie Du schon vermutet hast - Sie sind auch alpengruen. ");

  AddDetail( ({ "art", "bauart", "bauweise" }),
    "Es ist ein typisches Fertigteilhaus wie es hier eigentlich "
    "nur selten gebaut wird. ");

  AddDetail( ({ "fertigteilhaus", "fertigteil" }),
    "Du wunderst Dich, dass hier ueberhaupt so ein Haus steht. ");

  AddSound(DEFAULT_SOUND, "Du kannst hier eigentlich kaum " 
    "Geraeusche wahrnehmen, da das vom Norden her kommende "
    "laute Stimmengewirr viel zu laut ist. ");

  AddSound ( ({ "geraeusche", "geraeusch" }),
    "Ausser dem Stimmengewirr aus dem Norden und dem Knurren deines "
    "Magens hoerst du kaum welche. ");

  AddSound( ({ "knurren" }),
    "krummmmel... knurrr... ");

  AddDetail( ({ "magen", "magens" }),
    "Der Magen ist das Organ in Dir, welches das unmoeglich Zeugs "
    "verdauen muss, das Du Essen nennst. ");

  AddDetail( ({ "essen", "zeug", "zeugs", "wurst" }),
    "Schau Dir doch mal an was Du alles in Dich reinstopfst. ");

  AddDetail( ({ "organ", "organe" }),
    "Der Magen ist bei Dir sicher nicht das Kleinste. ");

  AddDetail( ({ "kleinste"}),
    "Gegenteil von klein. ");

  AddSound( ({ "stimmengewirr", "stimmen", "gewirr" } ),
    "Es scheint als ob sich im Norden viele Menschen befinden. "
    "Du beginnst zu gruebeln, was sich dort befinden koennte. ");

  AddDetail( ({ "mensch", "menschen" }),
    "Hast du noch nie einen gesehen??? ");

  AddDetail( ({ "norden", "dort" }),
    "Jetzt entsinnst Du Dich: Der Markt befindet sich dort.  "
    "Du denkst . o O (Dort ist sicher viel zu forschen). ");

  AddDetail( ({ "markt" }),
    "Der Markt von Arwenock. Eine der groessten Atraktionen "
    "hier. Ein besuch lohnt sich fuer Dich sicherlich. ");

  AddDetail( ({ "atraktion", "atraktionen", "besonderes" }),
    "Na etwas besonderes eben. ");

  AddSmell(DEFAULT_SMELL, "Viele Gerueche kannst du aufschnappen. \n");

  AddSmell( ({"geruch", "gerueche"}),
    "Du kannst keine genauen Gerueche erkenne, da viel zu viele "
    "unterschiedliche Gerueche auf Dich einwirken. \n"
    "Ob die wohl alle vom Markt kommen??? ");

  AddExit( "norden", ROOM "room_D-04" );
  AddExit( "osten",  ROOM "room_E-03" );
  AddExit( "westen", ROOM "room_C-03" );

}
