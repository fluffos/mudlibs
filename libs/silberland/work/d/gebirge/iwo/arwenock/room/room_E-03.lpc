
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du befindest Dich auf einem Weg, welcher Dich quer durch das  "
    "wunderschoene Arwenock fuehrt. Im Sueden kannst Du ein grosses "
    "Gebaeude erkenne, bei dem Du dir aber noch nicht sicher bist um "
    "was es sich handelt. Ansonsten ist hier alles genauso wie auf "
    "den anderen Wegen hier, ausser dem kleinen Baum der am Wegesrand "
    "steht. ");

  AddDetail( ({ "sueden", "gebaeude" }),
    "Im Sueden kannst Du ein groesseres Gebaeude ausmachen. Es sieht "
    "irgendwie schon alt aus. Du bist Dir sicher, dass ein Besuch sich "
    "dort fuer Dich als sehr interessant erweisen wird. ");

  AddDetail( ({ "besuch" }),
    "Du brauchst nur hinzugehen. Wenns Dir nicht gefaellt, gehst Du "
    "halt einfach wieder. ");

  AddDetail( ({ "baum" }),
    "Von den Wurzeln aus bis zur Baumkrone ist er wunderschoen und "
    "gerade gewachsen. Der Stamm sieht so aus, als wuerde er schon "
    "viel aushalten. ");

  AddDetail( ({ "krone", "baumkrone" }),
    "In der Baumkrone ist ein kleines Vogelnest. ");

  AddDetail( ({ "nest", "vogelnest", "vogel" }),
    "Im Vogelnest siehst Du zwar keinen Vogel, aber jetzt weisst Du wo "
    "der Geruch herkam. Der Vogel dem das Nest gehoert hat sich von  "
    "jemandem das Essen stibitzt. Hoffentlich schmeckt es ihm auch. ");

  AddDetail( ({ "essen", "futter" }),
    "Jamm. Das sieht wirklich lecker aus. Fast ueberkommt es Dich und "
    "Du moechtest etwas Pasta probieren. Da der arme Vogel dann aber "
    "hungern muesste, beschliesst Du es doch zu lassen. ");

  AddDetail( ({ "baumstamm", "stamm" }),
    "Auf dem Baumstamm ist ein Schriftzug eingeritzt. "
    "Du versucht ihn zu entziffern und kannst folgendes erkennen: \n\n"
    "    /----+       /----  \n"
    "    |    |   |   |      \n"
    "    |----|  -+-  |      \n"
    "    |    |   |   |      \n"
    "    |    |       +----  \n\n");

  AddDetail( ({ "schriftzug", "zug", "schrift" }),
    "Schooooooen. Das muss wohl ein verliebtes Paar in den Stamm "
    "geritzt haben, zum Beweis ihrer Liebe. ");

  AddDetail( ({ "beweis", "paar", "liebe" }),
    "Es muss wirklich ein sehr verliebtes Paar gewesen sein. \n"
    "Du denkst . o O (Wie romantisch). ");

  AddDetail( ({ "wegesrand", "rand" }),
    "Ein kleiner Baum schlaegt dort seine Wurzeln in den Boden. ");

  AddDetail( ({ "wurzeln", "wurzel" }),
    "Viele kannst Du nicht erkennen, die meisten befinden sich "
    "unterirdisch. Wie bei den meisten Baeumen. ");

  AddDetail( ({ "weg", "platz" }),
    "Eine kleine Pfuetze hat sich am Weg gebildet. ");

  AddDetail( ({ "pfuetze", "lache" }),
    "Als Du die kleine Pfuetze genauer betrachtest, bemerkst Du einen "
    "Fisch der darin herumschwimmt. ");

  AddDetail( ({ "fisch", "fische" }),
    "Neugierig wie Du bist greifst Du in die Pfuetze und versuchst den "
    "Fisch zu fangen, da bemerkst Du dass der Fisch nur ein grosses "
    "Blatt ist. Enttaeuscht ziehst Du deine Hand wieder heraus und "
    "merkst das Du jetzt schmutzige Finger hast. \n"
    "Du denkst . o O (Na toll). \n");

  AddDetail( ({ "hand", "finger" }),
    "Schnell putzt Du Deine Finger in deiner sowieso schon schmutzigen "
    "Hose ab, und hoffst das Dich dabei niemand sieht. ");

  AddDetail( ({ "blatt" }),
    "Ein ganz normales Blatt, wie Sie jedes Jahr im Herbst von den "
    "Baeumen fallen. Wo das wohl herkommt? ");

  AddDetail( ({ "baeumen", "silberwald", "baeume" }),
    "Im Silberwald gibt es davon sehr viele. ");

  AddDetail( ({ "herbst", "jahreszeit", "jahreszeiten", "jahr" }),
    "Du ueberlegst kurz welche Jahreszeit momentan herrscht, so sehr "
    "Du Dich auch anstrengst, aber Du kommst einfach nicht drauf. ");

  AddDetail( ({ "hose", "hosen", "Flecken" }),
    "Zum Glueck sieht man keine Flecken auf ihr. ");

  AddDetail( ({ "glueck" }),
    "Du hast wirklich Glueck gehabt, dass man keine Flecken bemerkt. ");

  AddSound(DEFAULT_SOUND, "Hier ist es auf jedenfall um einiges "
    "ruhiger als auf dem Marktplatz. Angenehme Stille herscht hier. \n");

  AddSound( ({ "still", "stille"}),
    "Sie ist einfach herrlich. ");
  
  AddDetail( ({"marktplatz", "markt", "nordwesten"}),
    "Der Marktplatz befindet sich weiter im Nordwesten. ");

  AddSmell(DEFAULT_SMELL, "Es schein als wuerdest Du Pasta riechen, "
    "Du bist Dir aber nicht im klaren wo der Geruch herkommt. \n");

  AddSmell( ({"geruch", "pasta"}),
    "Du bist Dir sicher - Es handelt sich eindeutig um Pasta."
    "Deine feine Nase wuerde Dich doch nicht beluegen. "
    "Du schupperst herum, kannst aber nichts entdecke. ");

  AddDetail( ({ "nase", "ding" }),
    "Das ist das riiiiesen Ding mitten in Deinem Gesicht ");

  AddDetail( ({ "gesicht" }),
    "Das ist das wo Deine Nase angewachsen ist. ");

  AddExit( "osten",  ROOM "room_F-03" );
  AddExit( "westen", ROOM "room_D-03" );
  AddExit( "sueden", ROOM "room_E-02" );

}
