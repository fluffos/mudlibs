#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <language.h>

#define HANDSCHELLEN "\nhandschellen"
#define WIZNAME "protheg"
#define BK(x) break_string(x,78,"",BS_LEAVE_MY_LFS+BS_NO_PARINDENT)
#define DB(x) if (find_player(WIZNAME)) tell_object(find_player(WIZNAME),(x))

create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einer stinkenden kleinen Kerkerzelle");
  SetProp(P_INT_LONG,
	  "Du befindest Dich hier in einem stinkenden, engen Loch, auch "+
	  "Kerker genannt. Der einzige Weg in die Freiheit ist wohl die "+
	  "Kerkertuer, die jedoch fest verschlossen ist. Ein kleines "+
	  "Kerkerfenster ist ueber der Tuer angebracht, es ist jedoch "+
	  "zu klein, um Licht durchzulassen.\n");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  SetProp(P_NOQUIT, 1);
  SetProp(P_NOMAGIC, 100);

  AddDetail(({"boden","strohhaufen","haufen","stroh"}),
	     "Ein kleiner Strohhaufen liegt am Boden, das soll wohl die "+
	     "Schlafstaette sein.");
  AddDetail(({"staette","schlafstaette"}),
	    "Du schauderst...\n");
  AddDetail(({"loch","kerker","zelle"}),
	    TO->QueryProp(P_INT_LONG));
  AddDetail("decke",
	    "Die Decke verschwindet oben irgendwo in der Dunkelheit.\n");
  AddDetail("dunkelheit",
	    "Da oben scheint nichts besonderes zu sein.\n");
  AddDetail(({"freiheit","weg"}),
	    "Der einzige Weg in die Freiheit ist durch die Tuer, doch die ist "+
	    "fest verschlossen, oder?\n");
  AddDetail(({"wand","waende"}),
	    "Eiskalte steinerne Waende.\n");
  AddDetail(({"tuer","kerkertuer"}),
	    "Ein kleines Schildchen ist an der Kerkertuer befestigt.\n"+
	    "Wenn man sie nur irgendwie aufbekommen koennte...\n");
  AddDetail(({"schluesseln","schluessel"}),
	    "Die haettest Du jetzt wohl gerne...\n");
  AddDetail("schluesselbund",
	    "Wenn Du an den herankommen koenntest...\n");
  AddDetail(({"fenster","kerkerfenster"}),
	    "Das kleine Kerkerfenster ist ueber der Kerkertuer angebracht, "+
	    "laesst aber kein Licht aus dem Nebenraum herein...\n");
  AddDetail("nebenraum",
	    "Im Nebenraum sitzt der Henker und passt auf die Gefangenen auf.\n");
  AddDetail("henker",
	    "Der Henker wird Dich bald richten!\n");
  AddDetail("gefangene",
	    "So jemand wie Du!\n");
  AddDetail("licht",
	    "Durch das Kerkerfenster kommt kaum Licht, so dass die Zelle recht "+
	    "duester ist.\n");
  AddDetail("schildchen",
	    "Da scheint etwas draufzustehen...\n");
  AddReadDetail("schildchen",
		"Auf dem Schildchen steht:\n"+
		"     'Begnadigungen nur moeglich wenn Du im Silberland bleibst!'\n");
  AddSound(DEFAULT_SOUND,
	   "Irgendwo hoerst Du ein deutliches *Plopp* von einem Wassertropfen\n");
  AddSound("klirren",
	   "Das klingt wie der Schluesselbund des Henkers.\n");

  AddSound(({"tropfen","wassertropfen","plopp"}),
	   "Von der Decke scheint es zu tropfen.\n");

  AddSmell(DEFAULT_SMELL,
	   "Hier riecht es erbaermlich! Besonders von dem Stroh geht ein "+
	   "bestialischer Gestank aus...\n");
  AddSmell(({"stroh","gestank"}),
	   "Der letzte vor Dir duerfte nicht sonderlich gut gerochen haben...\n");
  
  AddRoomMessage(({"*Plopp* ein Wassertropfen schlaegt neben Dir auf.\n",
		     "Von draussen hoerst Du ein leises Klirren von Schluesseln.\n",
		     "Hat sich da nicht gerade etwas im Stroh bewegt?\n",
		     "Du fuehlst Dich beobachtet...\n",
		     "Du blickst zu dem Fenster, war da nicht gerade etwas?\n"}),
		 100);
  
  AddCmd(({"oeffne"}), "oeffnenfake" );
  AddCmd(({"kletter","klettere"}), "kletternfake" );
}

oeffnenfake(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(!str) return 0;

  if(str=="tuer"||str=="kerkertuer")
    {
      write("Du ziehst und zerrst an der Kerkertuer, doch sie oeffnet sich nicht.\n");
      if(!random(3)) write("Du hoerst den Henker rufen: 'Lass die Tuer in Ruh!'\n");
      return 1;
    }
  return 0;
}

kletternfake(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(!str) return 0;
  if(str=="raus"||str=="durch fenster"||str=="raus durch fenster"||
     str=="durch kerkerfenster"||str=="raus durch kerkerfenster")
    return write("Du kletterst zu dem Kerkerfenster hin und willst Dich "+
		 "durchzwaengen, jedoch bist Du viel zu gross und fett dazu!\n"+
		 "Von Draussen hoerst Du den Henker laut auflachen.\n"),1;
  return 0;
}

varargs string GetExits(object viewer)
{
  return "Hier gibt es keinen Weg raus!\n";
}

RegisterVictim(object victim, string why)
{
  object hc;

  if(present(HANDSCHELLEN,victim)) return -1;
  hc=clone_object(OBJ "hc");
  hc->move(victim, M_NOCHECK);
  hc->Grund(why);
  call_out("punish",300+random(200),victim);
  victim->move(TO, M_GO, "von ein paar Stadtwaechtern abgefuehrt",
	       "wird", "wird hereingeschleudert");
}

init()
{
  object tp;

  ::init();
  
  if(interactive(tp=TP))
    {
      if(present(HANDSCHELLEN, tp))
	{
	  call_out("punish",30,tp);
	  tell_object(tp, 
		      "Von draussen hoerst Du eine Stimme:\n"+
		      "'Aah, wieder da! Gleich kommst Du dran!\n");
	}
      else
	tp->move(ROOM "room_C-04", M_GO, "von ein paar Stadtwaechtern weggefuehrt",
		 "wird", "wird von ein paar Stadtwaechtern hereingefuehrt");
    }
}

punish(object who)
{
  object hc;

  if(ENV(who) && ENV(who)!=TO) return;

  if(!hc=present(HANDSCHELLEN, who))
    return who->move(ROOM "room_C-04", M_GO, "von ein paar Stadtwaechtern weggefuehrt",
		     "wird", "wird von ein paar Stadtwaechtern hereingefuehrt");

  if(ROOM "room_C-04"->hinrichtung_seq_1(who, hc->QueryWhy()))
    hc->remove();
  else
    {
      call_out("punish",300, who);
      tell_object(who, "Der Henker ruft von draussen: 'Du bekommst eine Gnadenfrist!'\n");
    }
}

Release(string pl)
{
  object hc,who;
  
  if(!who=find_player(pl)) return 2;
  if(hc=present(HANDSCHELLEN, who))
    hc->remove();
  if(ENV(who) && ENV(who)==TO)
    {
      who->move(ROOM "room_C-04", M_GO, "von ein paar Stadtwaechtern weggefuehrt",
		"wird", "wird von ein paar Stadtwaechtern hereingefuehrt");
      return 1;
    }
  return 0;
}
