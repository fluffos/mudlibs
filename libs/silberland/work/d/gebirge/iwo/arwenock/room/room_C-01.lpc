
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_LONG, 
    "Der Weg fuehrt Dich hier nach Nordosten weiter Richtung "
    "Stadttor und nach Westen tiefer in die Stadt. Die Gebaeude "
    "scheinen zum Teil schon etwas schaebig zu sein, jedoch sind "
    "sie in einem recht guten Zustand. Die Stadtmauer grenzt "
    "hier Arwenock ab.");

  AddDetail( ({ "weg" }),
    "Der Weg ist mit etwas abgelatschen Steinen gepflastert.");
  AddDetail( ({ "richtung", "westen", "nordosten" }),
    "Das kann man sicher nicht sehen!");
  AddDetail( ({ "stadttor", "tor" }),
    "Dazu musst Du schon naeher ran gehen.");
  AddDetail( ({ "gebaeude", "stil" }),
    "Die Gebaeude haben keinen erkennbaren Stil, scheinen jedoch "
    "recht zweckdienlich zu sein.");
  AddDetail( ({ "teil", "suedteil" }),
    "Du befindest Dich im Suedteil.");
  AddDetail( ({ "zustand" }),
    "Der Zustand scheint in Ordnung zu sein.");
  AddDetail( ({ "ordnung" }),
    "Alles in..");
  AddDetail( ({ "stadtmauer", "mauer" }),
    "Die Stadtmauer zieht sich von hier nach Nordwesten. Das "
    "massive Mauerwerk stellt ein unueberwindbares Hindernis dar.");
  AddDetail( ({ "hindernis" }),
    "Die Mauer ist wahrlich eines.");
  AddDetail( ({ "mauerwerk", "wall" }),
    "Riesige Mauersteine bilden hier einen massiven Wall.");
  AddDetail( ({ "mauersteine", "gemaeuer" }),
    "Die Steine sind aus den Bergen des Gebirges gehauen. In Bodennaehe "
    "bilden ein paar kleinere Steine eine kleinen Bogen.");
  AddDetail( ({ "bodennaehe" }),
    "Hier sind ein paar kleinere Steine zu einem Bogen gemauert.");
  AddDetail( ({ "bogen" }),
    "Der Bogen bildet einen niedrigen Durchlass durch das Gemaeuer.");
  AddDetail( ({ "durchlass", "abfluss" }),
    "Es scheint nicht, als fuehre das Loch durch die Mauer durch, "
    "sondern eher als reiche es in den Boden. Wahrscheinlich "
    "um das Regenwasser ablaufen zu lassen. Unter der Oberflaeche "
    "kann es dann schoen versickern.");
  AddDetail( ({ "loch" }),
    "Auf der anderen Seite des Bogens scheint sich das Loch etwas "
    "zu vergroessern.");
  AddDetail( ({ "seite" }),
    "Welche meinst Du denn?");
  AddDetail( ({ "andere seite" }),
    "Ein schwacher Schimmer scheint von dort zu kommen.");
  AddDetail( ({ "regenwasser" }),
    "Du kannst Dich nicht erinnern, dass es hier jemals geregnet "
    "haette. Wozu also dieser Abfluss?");
  AddDetail( ({ "schimmer" }),
    "Vielleicht kann man da ja irgendwie hin?");
  
  AddCmd( ({ "steig", "steige" }), "enter");


  AddExit( "osten", ROOM "room_D-01" );
  AddExit( "nordwesten", ROOM "room_B-02" );

}


int enter(string str)
{
  string what, extra;

  notify_fail("Wohin willst Du steigen?\n");

  if (!stringp(str) || sscanf(str, "in %s %s", what, extra) != 2)
    return 0;

  if (member( ({ "loch", "durchlass", "grotte",
                 "abfluss", "bogen" }), what)==-1) return 0;

  if (member( ({ "rein", "hinab", "hinunter", "rein" }),
      extra) == -1) return 0;

  return TP->move(ROOM "donation", M_GO, "");

}

