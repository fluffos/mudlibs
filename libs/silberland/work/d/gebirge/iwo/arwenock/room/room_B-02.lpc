
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "querolin"

create()
{
  ::create();
//---------------------------------------------


  SetProp(P_INT_LONG,
    "Der Weg fuehrt Dich hier an einer kleinen Wegbiegung vorbei. Von Norden "
    "her schliesst der Weg zum Haupttor und zum Marktplatz an. Richtung "
    "Suedwesten kannst Du der grossen Stadtmauer entlang weitergehen. Zwischen "
    "der Mauer und dem Weg befindet sich ein schmaler Gruenstreifen. Auf der "
    "anderen Seite des Weges ragen einige Haeuser empor. Auch hier tummeln "
    "sich einige Menschen, aber zumindest wirst Du hier nicht sofort ueberrannt. ");

  AddDetail( ({ "seite" }),
    "Auf der einen befindet sich die gewaltige Stadtmauer, auf der anderen zwei "
    "Haeuser. Dazwischen verlaeuft der Weg und ein schmaler Gruenstreifen. ");

  AddDetail( ({ "gruenstreifen" }),
    "Auf dem schmalen Gruenstreifen, wachsen eine Vielzahl von Blumen. Von dort "
    "duftete es auch herrlich nach Blueten. ");

  AddDetail( ({ "blumen", "blume" }),
    "Viele verschieden bluehen hier. Einige davon kennst Du. Gaensebluemchen, "
    "Huflattich, Leberbluemchen, Loewenzahn und ein kleiner Rosenbusch. ");

  AddDetail( ({ "busch", "rosenbusch", "rosen" }),
    "Ein wunderschoen gewachsener Rosenbusch steht vor Dir. Jeder Gaertner "
    "haette waere froh ueber ein solches Prachtexemplar. Nur an einer "
    "kleinen Stelle hat er einen Makel. ");

  AddDetail( ({ "prachtexemplar", "exemplar", "prach" }),
    "Das ist wirklich eines. ");

  AddDetail( ({ "makel", "stelle" }),
    "Anscheinend hat hier jemand schon eine kleine Rosenbluete abgeschnitten. "
    "Vermutlich wird er sie seiner Liebsten gebracht haben. ");

  AddDetail( ({ "rosenbluete" }),
    "Naja eine fehlt, aber die anderen sehen traumhaft aus. ");

  AddDetail( ({ "liebsten", "liebste", "rose" }),
    "Die wird sich sicherlich sehr darueber gefreut haben. Wer wuerde sich "
    "nicht ueber eine Rose freuen, nochdazu ueber eine so schoene. ");

  AddDetail( ({ "salat", "unkraut" }),
    "Wenn Du darueber genaueres wissen moechtest, dann geh zu Blu, dem Gaertner. "
    "Der weiss sicherlich gut Bescheid ueber sowas. ");

  AddDetail( ({ "blu", "gaertner", "felonia","anfaengerpark", "garten" }),
    "Du findest ihn in Felonia im Anfaengerpark. Dort betreibt er einen "
    "wundervollen Garten. ");

  AddDetail( ({ "loewenzahn" }),
    "Eigentlich ist Loewenzahn ja Unkraut, aber man kann ihn auch zu einem "
    "koestlichen Salat verarbeiten. ");

  AddDetail( ({ "leberbluemchen" }),
    "Leberbluemchen sind aehnlich wie Gaensebluemchen, nur haben Sie nicht so "
    "feine Bluetenblaetter sondern eher grosse. Ausserdem sind sie nicht weiss, "
    "vielmehr erstrahlen sie in einem starken lila. ");

  AddDetail( ({ "huflattich" }),
    "Huflattich ist eine kleine gruene Pflanze mit gelben Bluetenblaettern. "
    "Die Blaetter des Huflattichs sind am Boden angewachsen. ");

  AddDetail( ({ "gaensebluemchen" }),
    "Das sind kleine zierliche Pflaenzchen, mit einem gruenen Stiel und "
    "ebensolchen Blaettern. Meist haben sie weisse Bluetenblaetter. ");

  AddDetail( ({ "stiel", "stengel", "teil" }),
    "Das ist der Teil der Pflanze, welcher vom Boden her am Bluetenkopf "
    "angewachsen ist. Die meisten von Ihnen sind gruen. ");

  AddDetail( ({ "bluetenkopf", "pflanzenkopf" }),
    "Am Bluetenkopf sind die Bluetenblaetter angewachsen. ");

  AddDetail( ({ "bluetenblaetter", "bluete", "blueten", "bluetenblaettern" }),
    "Die Blueten sind fast bei allen Pflanzen das Schoenste. Sie sind oft "
    "sehr auffallend bunt und praechtig geformt. Damit sollen Bienen und "
    "andere Insekten angelockt werden. ");

  AddDetail( ({ "blaetter", "blatt" }),
    "Die Blaetter sind meist nicht so schoen wie die Blueten. ");

  AddDetail( ({ "bienen", "biene", "insekt", "insekten", "hilfe" }),
    "Mit Hilfe von Bienen und Insekten werden die Bluetenpollen verbreitet "
    "und somit koennen sich die Pflanzen vermehren. ");

  AddDetail( ({ "bluetenpollen", "pollen", "allergiker" }),
    "Allergiker werden diese schmerzhaft in Erinnerung haben. ");

  AddDetail( ({ "pflanze", "pflanzen", "pflaenzchen", "gruenzeug", "banausen" }),
    "Von einigen Banausen werden sie auch Gruenzeug genannt. ");

  AddDetail( ({ "haeuser" }),
    "Ein kleineres Einfamilienhaus, und ein weiters, jedoch um einiges groessers "
    "Mehrfamilienhaus stehen hier. ");

  AddDetail( ({ "einfamilienhaus" }),
    "Nichts besonderes kannst an dem kleinen Haeuschen erkenne, ausser dass es "
    "auf Dich einen sehr gemuetlichen Eindruck macht. ");

  AddDetail( ({ "mehrfamilienhaus" }),
    "Es ist um einiges groesser gebaut als das schlichtere Einfamilienhaus.");

  AddDetail( ({ "haeuschen", "eindruck" }),
    "Irgendwie fasziniert Dich dieses kleine Haeuschen doch, seine schlichte "
    "Bauweise und der Flair den es ausstrahlt. ");

  AddDetail( ({ "flair" }),
    "Das Haeuschen hat wirklich einen besonderen Flair. ");

  AddDetail( ({ "bauweise"}),
    "Klein, schlicht - aber doch recht nett. Irgendwie wuenscht Du dir, auch "
    "ein solches Haeuschen Dein Eigen nennen zu duerfen. ");

  AddDetail( ({ "menschen", "passanten" }),
    "Einige tummeln sich hier noch rum. Aber die meisten sind auf oder in der "
    "Naehe des Marktplatzes unterwegs. ");

  AddDetail( ({ "weg", "weges", "wege" }),
    "Du befindest Dich gerade auf einem. ");

  AddDetail( ({ "wegbiegung", "biegung" }),
    "Die Wegbiegung fuehrt Dich in zwei Richtungen. Nach Norden gelangst Du zum "
    "Haupttor und weiter auf den Marktplatz. Richtung Suedosten kannst du dem "
    "Weg der Stadtmauer entlang weiter folgen. ");

  AddDetail( ({ "richtungen", "richtung" }),
    "Hier kannst Du nur in zwei gehen. Norden und Suedosten. ");

  AddDetail( ({ "norden", "haupttor", "marktplatz", "marktplatzes" }),
    "Wenn Du dem Weg weiter nach Norden folgst kommst Du zum Haupttor und auf "
    "den Marktplatz der Stadt. ");

  AddDetail( ({ "suedosten" }),
    "Richtung Soedosten kannst Du den Weg entlang der Stadtmauer weitergehen. ");

  AddDetail( ({ "stadtmauer", "mauer" }),
    "Die maechtige Stadtmauer befindet sich nur einige Meter von Dir entfernt. "
    "Sie ist so hoch, dass Du nicht versuchen solltest auf sie zu klettern. ");

  AddDetail( ({ "meter","zentimeter","millimeter" }),
    "Ein Meter sind 100 Zentimeter, oder auch 1000 Millimeter. Anders ausgedrueckt, "
    "Ein Meter ist ungefaehr so weit, wie du mit einem grossen Schritt "
    "gehen kannst. ");

  AddDetail( ({ "schritt" }),
    "Ein Schritt ist, wenn Du einen Fuss vor den anderen setzt. Auch 'gehen' "
    "genannt. ");

  AddDetail( ({ "fuss"}),
    "Da hast Du sogar zwei davon. ");

  AddSound(DEFAULT_SOUND, "Du kannst eigentlich nur den normalen Strassenlaerm "
    "vernehmen. \n");

  AddSound( ({ "strassenlaerm", "laerm"}),
    "Dabei handelt es sich um die normalen Geraeusche von Passanten. ");

  AddSound( ({ "geraeusche"}), "Solche wie Sie normale Menschen machen. ");

  AddSound( ({"passanten", "menschen"}), 
    "Warst Du noch nie auf einem belebten Weg? ");

  AddSmell(DEFAULT_SMELL, "Frischer Bluetenduft dringt in deine Nase. \n");

  AddSmell( ({"duft", "bluetenduft", "blueten" }),
    "Hmmm. Herrlich dieser Duft nach frischen Blueten. ");

  AddDetail( ({ "nase", "finger" }),
    "Du tippst mit deinem Finger auf deine Nase. Ja, sie ist noch da. ");

//---------------------------------------------
  AddExit( "suedosten", ROOM "room_C-01" );
  AddExit( "norden", ROOM "room_B-03" );

}
