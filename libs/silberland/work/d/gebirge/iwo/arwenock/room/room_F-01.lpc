
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Dieses Stueckchen Weg entbehrt jeglicher Besonderheiten. "
    "Bei einer Besichtigungstour der Stadt ist dieser Fleck "
    "sicher alles andere als die erste Adresse. Vielleicht "
    "ein Steinmetz koennte sich noch an den sauber behauenen "
    "Pflastersteinen ergoetzen, oder ein Maler koennte der "
    "abblaetternden Farbe der Hauswaende etwas abgewinnen. "
    "Fuer Dich jedoch ist es hier unglaublich langweilig.");
  AddDetail( ({ "stueckchen" }),
    "Mit 'Stueckchen' ist hier ein kleiner Abschnitt gemeint.");
  AddDetail( ({ "abschnitt" }),
    "Abschnitt - so wie Stueckchen.");
  AddDetail( ({ "besonderheiten" }),
    "Egal wie sehr Du Dich anstrengst - Du kannst keine erkennen.");
  AddDetail( ({ "besichtigungstour" }),
    "Soetwas kann man nciht sehen - und selbst, wenn - es wuerde "
    "Dich nicht die Bohne interessiern.");
  AddDetail( ({ "bohne" }),
    "Amuesiert beobachtest Du, wie eine ueber das Pflaster kullert "
    "um gleich darauf in einer Spalte zu verschwinden.");
  AddDetail( ({ "spalte" }),
    "Am Grund der Spalte kannst Du eine Bohne erkennen.");
  AddDetail( ({ "grund" }),
    "Es scheint, als waere es fruchtbare Erde. Vielleicht "
    "waechst hier einmal eine Bohnenstaude.");
  AddDetail( ({ "staude", "bohnenstaude" }),
    "Derzeit siehst Du hier keine.");
  AddDetail( ({ "adresse" }),
    "Du kannst keine Hausnummer erblicken, also weisst Du sie nicht.");
  AddDetail( ({ "steinmetz" }),
    "Hier ist natuerlich keiner. Was taete er auch hier?");
  AddDetail( ({ "maler" }),
    "Dem Zustand der Farbe nach, war laenger kein Maler hier.");
  AddDetail( ({ "farbe" }),
    "Du weisst nicht, welche es fueher mal war. Nun ist es Grau - "
    "zum Teil vom Dreck, der Rest Schimmel.");
  AddDetail( ({ "grau", "dreck", "schimmel" }),
    "Die Mischung aus Dreck und Schimmel ergibt ein fleckiges Grau.");
  AddDetail( ({ "fleck", "wand", "schandfleck" }),
    "Die ganue Wand ist ein Schandfleck fuer die sonst recht "
    "feine Stadt.");
  AddDetail( ({ "mischung" }),
    "Zu mehr oder weniger gleichen Teilen.");
  AddDetail( ({ "hausnummer", "nummer" }),
    "Eine Hausnummer kannst Du hier nirgends erkennen.");
  AddDetail( ({ "erde" }),
    "Die Erde hier scheint fruchtbar zu sein.");
  AddDetail( ({ "teil" }),
    "Du siehst hier kein 'Teil'.");
  AddDetail( ({ "zustand" }),
    "Der Zustand laesst sich am Besten mit 'miserabel' und "
    "herungergekommen beschreiben.");
  AddDetail( ({ "hauswaende", "waende" }),
    "Die interessieren Dich ganz- und garnicht.");



  AddExit( "osten", ROOM "room_G-01" );
  AddExit( "westen", ROOM "room_E-01" );

}
