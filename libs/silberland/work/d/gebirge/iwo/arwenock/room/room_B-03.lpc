#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

#define WIZNAME "andyl"

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Bei der Stadtmauer von Arwenock");
  SetProp(P_INT_LONG, 
	  "Du stehst in einem Teil der Stadt Arwenock der sich "
	  +"suedlich vom Stadttor befindet. Westlich von Dir ist "
	  +"die massive Stadtmauer und oestlich von Dir sind einige "
	  +"mehrstoeckige Haeuser zu "
	  +"sehen. Du hoerst ein seltsames Brodeln aus den Wohnungen "
	  +"im Osten. Was da wohl wieder gemacht wird? "
	  +"Die Strasse fuehrt von hier in drei "
	  +"Richtungen weiter: Nach Sueden der Stadtmauer entlang, "
	  +"wegnach Osten ins Innere der Stadt und nach Norden zum Stadttor.\n");
  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  // DETAILS START
  
  AddDetail(("teil"),
	      "Du stehst jetzt in einem Teil der Stadt Arwenock.\n");
  AddDetail(({"boden", "strasse"}),
	    "Die Strasse ist sauber mit Pflastersteinen ausgelegt zwischen denen "
	    +"da und dort etwas Moos waechst. Ein paar Schmierereien fallen Dir "
	    +"am Boden auf.\n");
  AddDetail(("schmierereien"),
	    "Du kannst sie lesen.\n");
  AddReadDetail(({"schmierereien"}),
		"Du liest:\n"
		+"Elfen, Menschen, Feen die schmecken,\n"
		+"mir jederzeit an allen Ecken.\n"
		+"              - Walta von der Ogerweide -\n");
  AddDetail(("himmel"),
	    "Die Sonne scheint sanft auf dich vom blauen Himmel herab. Auch ein "
	    +"paar kleine weisse Woelkchen sin zu sehen.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint sanft auf Dich herunter.\n");
  AddDetail(("woelkchen"),
	    "Ein paar vereinzelte weisse Woelkchen sind am Himmel zu entdecken.\n");
  AddDetail(("innere"),
	    "Richtung Osten fuehrt die Strasse ins Innere der Stadt.\n");
  AddDetail(({"richtung", "richtungen"}),
	    "Du kommst von hier in die die Richtungen Osten, Norden und Sueden.\n");
  AddDetail(({"steine", "pflastersteine"}),
	    "Einfache graue Pflastersteine mit welchen die Strasse erbaut wurde.\n");
  AddDetail(("moos"),
	    "Das Moos waechst da und dort zwischen den Pflastersteinen. Aber auch an "
	    +"der Stadtmauer kannst Du welches entdecken.\n");
  AddDetail(("stadt"),
	    "Du stehst jetzt in der beeindruckenden Handelsstadt Arwenock.\n"); 
  AddDetail(({"arwenock", "handelsstadt"}),
	    "Arwenock ist eine grosse Handelsstadt in welcher Du Waren von "
	    +"den verschiedensten Voelkern erwerben kannst.\n");
  AddDetail(("waren"),
	    "Hier findest Du sicher viele interessante Waren.\n");
  AddDetail(({"voelker", "angehoerige"}),
	    "Arwenock wurde von Angehoerigen verschiedenster Voelker erbaut die "
	    +"hier auch regen Handel treiben.\n");
  AddDetail(({"handel"}),
	    "Gehandelt wird in Arwenock ueberaus viel.\n");
  AddDetail(({"tor", "stadttor"}),
	    "Das praechtige Stadttor von Arwenock befindet sich noerdlich von hier. "
	    +"Es leuchtet in einem sanften Blau.\n");
  AddDetail(({"blau", "farbe"}),
	    "Das Stadttor leuchtet in der Farbe Blau.\n");
  AddDetail(({"stadtmauer", "mauer"}),
	    "Die steinerne Stadtmauer von Arwenock ist ziemlich massiv und ist von "
	    +"Moos und Efeu bedeckt Du kannst auch einen Pilz entdecken.\n");
  AddDetail(("efeu"),
	    "Der Efeu rankt sich da quer ueber die Stadtmauer hoch.\n");
  AddDetail(({"haeuser", "haus"}),
	    "Die Haeuser bestehen grossteils aus Stein mit Metallarbeiten daran "
	    +"und huebschen Glasfenstern.\n");
  AddDetail(("stein"),
	    "Stein, so wie er hier beinahe ueberall zu finden ist.\n");
  AddDetail(({"fenster", "glasfenster"}),
	    "Das Glasfenster ist ueberaus huebsch verziert. Jedoch sind die Fenster "
	    +"seltsam angeschwaerzt. Ob das was zu bedeuten hat?\n");
  AddDetail(("glas"),
	    "Das Glas ist fein gearbeitet aber seltsam angeschwaerzt.\n");
  AddDetail(("metallarbeiten"),
	    "Bei den Metallarbeiten handelt es sich hauptsaechlich um Rahmen fuer die "
	    +"Fenster und um ein paar Laternen.\n");
  AddDetail(({"metall", "metalle", "eisen", "kupfer"}),
	    "Es sind  hauptsaechlich Eisen und Kupfer die hier sehr sauber "
	    +"verarbeitet wurden.\n"); 
  AddDetail(({"rahmen", "metallrahmen", "fensterrahmen"}),
	    "Die Metallrahmen sind ueberaus huebsch verziert.\n");
  AddDetail(("laternen"),
	    "Ein paar metallene Laternen haengen an den Hauswaenden. Die sorgen in der "
	    +"Nacht fuer Licht.\n");
  AddDetail(("nacht"),
	    "Selbst in der Nacht ist es hier mit den Laternen nicht voellig dunkel.\n");
  AddDetail(("licht"),
	    "In der Nacht spenden die Laternen Licht.\n"); 
  AddDetail(({"waende", "wand", "hauswaende", "hauswand"}),
	    "Die Hauswaende bestehen aus Stein.\n"); 
  AddDetail(("pilz"),
	    "Der gruengelbe Pilz ist ueber und ueber mit seltsamen Sporen bedeckt.\n");
  AddSpecialDetail(("sporen"), "sporen_schau");
  AddDetail(({"wohnung", "wohnungen"}),
	    "Die Wohnungen befinden sich in den Haeusern oestlich von hier.\n");
  AddDetail(("brodeln"),
	   "Du kannst ja mal lauschen.\n");
  AddSound(DEFAULT_SOUND, 
	   "Du hoerst ein eigenartiges Brodeln aus den Wohnungen im Osten.\n");
  AddSound(("brodeln"),
	    "Hoert sich an als wuerde da jemand etwas kochen. Du kannst auf einmal "
	    +"auch eine Stimme reden hoeren.\n");
  AddSound(("stimme"),
	    "Die Stimme sagt: Was passiert jetzt wenn ich das hier in den "
	    +"Kessel werfe?\n");
  AddDetail(({"kessel", "kaaaawwwummmmmsss"}),
	    "Als Du naeher untersuchen willst was es mit dem Kessel auf sich hat "
	    +"hoerst Du auf einmal ein gewaltige *KAAAAWWWUMMMMMSSS* und ein kleiner "
	    +"Gnom fliegt, gefolgt von einer riesigen Schwefelwolke, aus einem Fenster "
	    +"knallt gegen die Strasse, rappelt sich aber gleich wieder auf und fasselt "
	    +"etwas was sich anhoert wie 'ichhabdochgewsusstdassdazuvielsaranostindrinwar' "
	    +"und verschwindet wieder in den Wohnungen.\n");
  AddDetail(("schwefelwolke"),
	    "Die verzieht sich jetzt langsam wieder.\n");
  AddDetail(("gnom"),
	    "Der ist schon wieder in der Wohnung verschwunden.\n");
  AddSmell(DEFAULT_SMELL,
           "Es riecht hier so seltsam nach Schwefel.\n");
  AddSmell(({"schwefel", "geruch", "schwefelgeruch"}),
	   "Der Schwefelgeruch kommt von den Wohnungen.\n");
  AddDetail(("gesicht"),
	    "Erklaer mal wie Du das schaffen willst, Dir selbst ins Gesicht zu "
	    +"blicken.\n");
  AddDetail(("augen"),
	    "Wahhh, die brennen jetzt fuerchterlich.\n");


  AddExit( "sueden", ROOM "room_B-02" );
  AddExit( "norden", ROOM "room_B-04" );
  AddExit( "osten",  ROOM "room_C-03" );

}

sporen_schau()
{
  TP->AddHp(-5);
  return(BS("Wie Du Sporen untersuchen willst, fliegen diese auf einmal "
	    +"in dein Gesicht und fangen furchtbar an in deinen Augen zu "
	    +"brennen.\n"));
}
