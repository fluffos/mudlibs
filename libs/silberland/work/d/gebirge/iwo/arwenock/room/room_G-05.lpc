
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();
//-----------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest Dich auf dem Weg vom Marktplatz in Richtung Ostweg. "
    "Nach Westen kommst Du zum Postamt und weiter an den Marktplatz. "
    "Auch hier herrscht reges Treiben. Viele Menschen laufen Dir ueber "
    "den Weg. Hoffentlich triffst Du auf keine Taschendiebe, denn die "
    "haben in der grossen Menschenmenge hier eine gute Deckung. Achte "
    "also auf dein Hab und Gut. ");

  AddDetail( ({ "deckung" }),
    "Sie koennen in der Menschenmenge bestens untertauchen. Und sind, "
    "wenn sie einmal fort sind, kaum mehr zu finden. ");

  AddDetail( ({ "treiben", "menschen", "leute" }),
    "Viele Leute sind hier unterwegs. Du solltest aufpassen, eventuell "
    "sind hier auch Taschendiebe unterwegs. ");

  AddDetail( ({ "diebe", "taschendiebe" }),
    "Solch ungute Zeitgenossen findet man auf dicht gedraengten Wegen "
    "immer wieder. Hier fuehlen sie sich sicher, da sie in der Menge "
    "kaum auffallen. Pass also gut auf deine Sachen auf. ");

  AddDetail( ({ "menge", "zeitgenossen", "menschenmengen","menschenmenge" }),
    "In groesseren Menschenmengen fuehlen sie sich wie zuhause. ");

  AddDetail( ({ "post", "postamt", "ort" }),
    "Das Postamt findest Du weiter westlich von hier. Wenn Du jemandem "
    "eine Nachricht zukommen lassen willst, ist das der richtige Ort "
    "um dies zu erledigen. ");

  AddDetail( ({ "nachricht","nachrichten","mails","mail","e-mail","mudmail",
    "mudmails" }),
    "E-Mails und Mudmails koennen von dort versendet werden. ");

  AddDetail( ({ "ostweg", "ost", "osten" }),
    "Der Ostweg befindet sich wie gesagt im Osten. Er fuehrt Dich vom "
    "Norden der Stadt in den Sueden. ");

  AddDetail( ({ "norden", "sueden", "westen" }),
    "Du hast zwar keinen Kompass, aber dem Stand der Sonne nach, findest "
    "Du Dich etwas zurecht. ");

  AddDetail( ({ "sonne", "scheibe" }),
    "Die Sonne ist die kreisrunde, helleuchtende Scheibe am Himmel. "
    "Mit Ihrer Hilfe kann man sich schon sehr gut Orientieren. ");

  AddDetail( ({ "hilfe", "stand", "himmel" }),
    "Die Sonne geht im Osten auf, im Sueden steht sie zu Mittag am "
    "hoechsten und im Westen geht sie unter. Mit dieser Hilfe, kannst "
    "Du Dich schon etwas Orientieren. ");

  AddDetail( ({ "mittag" }),
    "Da steht die Sonne am hoechsten. ");

  AddDetail( ({ "orientieren", "orientierung" }),
    "Zum Orientieren unterwegs kann man die Sonne herrlich zu Hilfe "
    "nehmen. ");

  AddDetail( ({ "weg", "wege", "weges" }),
    "Ein Weg. Nach eingehender betrachtung des Weges stellst Du fest, "
    "er sieht aus wie der, den Du vorhin untersucht hast. ");
    
  AddDetail( ({ "silberwald", "wald" }),
    "Viele interessante Sachen kann man im Silberwald entdecken. "
    "Man muss sie nur suchen... ");

  AddDetail( ({ "marktplatz", "platz" }),
    "Der Marktplatz befindet sich westlich von hier. Viele interessante "
    "Dinge sind dort, zu erforschen, ausserdem ist angeblich eine Guillotine "
    "dort aufgestellt. ");

  AddDetail( ({ "guillotine", "dinge" }),
    "Von der Guillotine hast Du schon einiges gehoert. Sie dient aber "
    "hauptsaechlich der abschreckung von Betruegern und Dieben. ");

  AddDetail( ({ "betrueger", "betruegern", "dieben", "diebe" }),
    "Solche Zeitgenossen gibt es leider immer wieder. Pass gut auf Deine "
    "Sachen auf, dann kann Dir nichts abhanden kommen. ");

  AddDetail( ({ "sachen", "hab", "gut", "hab und gut" }),
    "Wenn Du sie behalten willst, dann gib gut acht auf sie. Ansonsten "
    "sind sie schneller weg als Du denkst. ");

  AddSound(DEFAULT_SOUND, "Es ist hier zwar nicht so laut wie auf dem "
    "Markt, aber wo viele Menschen sind, ist es eben nicht ruhiger. \n");

  AddSound( ({ "markt", "menschen"}),
    "Am Markt ist es noch lauter, die Menschen hier verhalten sich aber "
    "ebenfalls nicht sehr leise. ");

  AddSmell(DEFAULT_SMELL, "Verschiedene Duefte dringen in deine Nase. \n");

  AddSmell( ({"duft", "duefte" }),
    "Genaueres kannst Du nicht erriechen. ");

  AddDetail( ({ "nase", "gesicht" }),
    "Die ist mitten im Gesicht. Zumindest bei Dir. ");

//-----------------------------------------------------
  AddExit( "osten",  ROOM "room_H-05" );
  AddExit( "westen", ROOM "room_F-05" );

}
