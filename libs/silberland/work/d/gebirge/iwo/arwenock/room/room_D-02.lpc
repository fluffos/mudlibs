
#include "../def.h"

inherit STDROOM;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
#include <wizlevels.h>

// #include "files.h"

int exitfun();
int klautest();
int kissenfkt();
int katana_weg;
create()
{
  ::create();

  SetProp(P_NO_TPORT, 1);

  SetProp(P_INT_SHORT, "In einem Ausstellungsraum");
  
  SetProp(P_INT_LONG,
    "Du stehst hier in einem Ausstellungsraum. Eigentlich "
    "haettest Du hier einen vollen Raum erwartet, siehst "
    "jedoch nur einen Sockel mit einem roten Kissen auf dem "
    "irgendetwas liegt mit einem kleinen goldenen Schild "
    "neben dem Kissen befestigt.");

  AddDetail( ({ "ausstellungsraum", "raum" }),
    "Da werden von Zeit zu Zeit Ausstellungen abgehalten.");
    
  AddDetail( ({ "ausstellungen", "ausstellung" }),
    "Zur Zeit sind die maechtigsten Waffen des Silberlandes "
    "ausgestellt.");

  AddDetail( ({ "zeit" }),
    "... ist relativ. Aber das ist Dir relativ wurscht.");
    
  AddDetail( ({ "waffen" }), "Sieh Dich halt mal um.");
  
  AddDetail( ({ "boden" }),
    "Der Boden ist hier aus Holz - fein saeuberlich beplankt.");
    
  AddDetail( ({ "holz" }),
    "Eigentlich hast du keinen Tau wasfuer Holz das sein koennte.");
    
  AddDetail( ({ "tau" }),
    "Als Du genau hinsiehst erkennst Du am Boden einen kleinen "
    "Tautropfen.");

  AddDetail( ({ "tropfen", "tautropfen", "wassertropfen" }),
    "Der winzige Tropfen glaenzt in der Sonne. Eine Ameise trinkt davon.");
    
  AddDetail( ({ "ameise" }),
    "Ploetzlich wird ein Sonnenstrahl gebuendelt von der Form des "
    "Wassertropfens und versengt die Ameise. Mit einem kleinen "
    "Rauchwoelkchen verdampft sie worauf sofort eine neue hereinkrabbelt.");

  AddDetail( ({ "form" }),
    "Fast wie eine Lupe.");
    
  AddDetail( ({ "lupe" }),
    "Lupen sind wenn man sie in die Sonne haelt eine gefaehrliche "
    "Waffe.");
    
  AddDetail( ({ "rauchwoelkchen", "woelkchen" }),
    "*puff* und es hat sich verzogen."); 

  AddDetail( ({ "sonnenstrahl", "strahl" }),
    "Nur ein klitzekleiner welcher.");
    
  AddDetail( ({ "sonne" }),
    "Grosse, gelbe Scheibe am Himmel. Leuchtet im Dunkeln.");
    
  AddDetail( ({ "himmel" }),
    "Du siehst nur die Decke.");
    
  AddDetail( ({ "decke" }),
    "Du starrst an die Decke, siehst aber nix besonderes.");
    
  AddDetail( ({ "kissen", "samtkissen", "schwert" }), #'kissenfkt);
  
  AddDetail( ({ "sockel" }),
    "Auf dem huefthohen Sockel liegt ein rotes Samtkissen. Daneben "
    "ist ein kleines goldenes Schild montiert.");
    
  AddDetail( ({ "schild" }),
    "Da steht was drauf.");
    
  AddReadDetail( ({ "schild" }),
    "\n\n       Drachenkopf Katana         \n"
    "                                  \n"
    " Dieses einzigartige Katana wurde \n"
    " uns  von   einem   grossherzigen \n"
    " Spender ueberlassen.  Das Metall \n"
    " seiner Klinge  wurde zweihundert \n"
    " mal  gefaltet  und  ist  dadurch \n"
    " die   beste   Klinge,  die   uns \n"
    " bekannt ist.                     \n"
    " Seine genaue Herkunft ist leider \n"
    " unbekannt.                       \n"
    "                                  \n"
    "        BERUEHREN VERBOTEN!       \n"
    "        -------------------       \n");
   
    
  AddExit( "osten", ([EX_DEST: ROOM "room_E-02",
                      EX_TESTFUNC: #'exitfun,
		      EX_FUNC: #'klautest]) );


  AddItem(NPC "museumswache", REFRESH_DESTRUCT);
  AddItem(NPC "museumswache", REFRESH_DESTRUCT);

  restore_object(ROOM "katanaraum");

  AddCmd( ({ "beruehre", "beruehr", "fasse", "fass" }), "touchfun");
  AddCmd( ({ "stiehl", "stehl", "stehle", "stiehle" }), "stealfunc");
  AddCmd( ({ "schlaf", "schlafe" }), "schlaffkt");
  AddCmd( ({ "ende" }), "endefkt");

}

int endefkt()
{
  tell_object(TP, BS("Jaja, das ist nun Dein Ende. Stirb elendiger Dieb!"));
  return 1;
}

int schlaffkt()
{
  tell_object(TP, BS("Aber, aber - hier kann man doch nicht schlafen!"));
  return 1;
}


int stealfunc(string str)
{
  object ob;

  notify_fail("Was willst Du denn stehlen?\n");
  if (!str || (strstr(str, "katana") == -1 && strstr(str, "schwert") == -1)) return 0;
  
  notify_fail("Scheinbar hat das Schwert schon jemand gestohlen!\n");
  if (katana_weg) return 0;
  
  notify_fail(BS("Die Wachen koennen ziemlich sauer werden wenn Du "
                 "das Schwert klaust. Willst Du es trotzdem stehlen?"));

  if (strstr(str, "trotzdem") == -1) return 0;

  
  ob = clone_object(WEAPON "katana");
  
  if (ob->move(TP) == ME_TOO_HEAVY)
    {
      notify_fail("Du kannst das Schwert nichtmeht tragen!");
      ob->destruct();
      return 0;
    }
  
  tell_object(TP, BS("Schnell nimmst Du das Schwert an Dich."));
  tell_room(ENV(TP), BS("Fast unbemerkt nimmt " + TP->Name(WER) +
                         " das Schwert an sich."), ({ TP }));
  
		     
  katana_weg = 1;

  return 1;
}


int touchfun(string str)
{
  notify_fail("Was moechtest Du beruehren?\n");
  if (!str || (str != "katana" && str != "schwert")) return 0;
  
  notify_fail("Aber das Schwert ist doch gar nicht da!\n");
  if (katana_weg) return 0;
  
  tell_room(ENV(TP), BS(TP->Name(WER) + " beruehrt vorsichtig das Schwert."), ({ TP }));
  
  tell_object(TP, BS("Du beruehrst vorsichtig das Schwert, "
                     "aber nichts passiert. Die Wachen scheinen es nicht "
                     "gesehen zu haben. Vielleicht kannst Du das Schwert "
		     "ja stehlen?\n"));

  return 1;
}


int exitfun()
{
  object *tmpobj;
  int i;
  int leave;
  int show;
    
  leave = 1;
  show = random(3);

  if (TP->InFight())
    {
      tell_object(TP, BS("Die Museumswache laesst Dich nicht vorbei.\n"));
      return 0;
    }

  if(!present("museumswache", ME)) return 1;
  
  if (show == 1 || katana_weg == 1)
    {
    tell_object(TP, BS("Eine Wache durchsucht Dich gruendlich."));
    tell_room(ENV(TP), BS("Eine Wache durchsucht " + TP->Name(WEN) +
                          " gruendlich."), ({ TP }));
    }
  
  if (deep_present("katana", TP))
    {
      TMI("Katana klau!");
      if (IS_ARCH(TP))
        {
          tell_object(TP, 
            BS("Du bist ERZMAGIER und wirst durchgelassen!\n"));
          return 1;
        }
      tmpobj = all_inventory(ME);
      for (i = 0; i < sizeof(tmpobj); i++)
        {
	  if (tmpobj[i]->name() == "eine Museumswache")
	    {
	      tmpobj[i]->Kill(TP);
	      leave = 0;
	    }
	}
    }
    
  if (leave && show == 1)
    {
      tell_room(ENV(TP), BS("Die Wache nickt zustimmen."));
    }
    
  return leave;
}

varargs int PreventLeave(object pl, mixed dest)
{
  object sword;

  sword = deep_present("katana", pl);

  if (objectp(sword))
    {
      write_file(ALOG "katana_leave.log", sprintf("%s ENV: %O DST: %O PO: %O\n", ctime(), pl, dest, previous_object()));
      TMI("KATANA WURDE GEKLAUT!");
      sword->remove(); 
    }

  return ::PreventLeave(pl, dest);
}
int klautest()
{
  object sword;
  int succ;
  
  if ((sword = deep_present("katana", TP)))
    {
      TMI("JA");
      katana_weg = 1;
      save_object(ROOM "katanaraum");
    }

  succ = TP->move(ROOM "room_E-02", M_NOCHECK + M_GO, "nach osten");

  if (objectp(sword))
    {
      TMI("AUCH");
      tell_object(TP, BS("Die Balance tritt aus dem Schatten und nimmt Dir das Schwert weg."));
      TMI(sprintf("%O", TP));
      sword->move(ENV(TP), M_NOCHECK);
    }
    
  return succ;
  
}

int wiederda()
{
  katana_weg = 0;
  save_object(ROOM "katanaraum");
  return 1;
}


int iskatanaweg()
{
  return katana_weg;
}


string kissenfkt()
{
  if (katana_weg == 1)
    {
      return BS("Das Kissen ist vollkommen leer. Es scheint als waere "
                "mal etwas darauf gelegen, aber jetzt ist nichts da.");
    }
    
  return BS("Auf dem Kissen liegt ein kunstvoll gearbeitetes Schwert "
            "dessen Klinge im Licht funkelt.");
}
