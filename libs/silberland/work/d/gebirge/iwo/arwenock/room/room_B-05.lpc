#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

#define WIZNAME "andyl"

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Bei der Stadtmauer von Arwenock");
  SetProp(P_INT_LONG, 
	  "Du stehst in einem Teil der Stadt Arwenock der sich "
	  +"noerdlich vom Stadttor befindet. Westlich von Dir ist "
	  +"die massive Stadtmauer und oestlich von Dir sind einige "
	  +"mehrstoeckige Haeuser aus Holz und Stein zu sehen. Du "
	  +"hoerst da und dort immer wieder Gespraechsfetzen aus den "
	  +"Wohnungen. Die Strasse fuehrt von hier in drei Richtungen "
	  +"weiter: Nach Norden der Stadtmauer entlang, nach Osten ins "
	  +"Innere der Stadt und nach Sueden zum Stadttor.\n");
  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );
  // DETAILS START
  
  AddDetail(("teil"),
	    "Du stehst jetzt in einem Teil der Stadt Arwenock.\n");
  AddDetail(({"boden", "strasse"}),
	    "Die Strasse ist sauber mit Pflastersteinen ausgelegt zwischen denen "
	    +"da und dort etwas Moos waechst.\n");
  AddDetail(("himmel"),
	    "Die Sonne scheint sanft auf dich vom blauen Himmel herab. Auch ein "
	    +"paar kleine weisse Woelkchen sin zu sehen.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint sanft auf Dich herunter.\n");
  AddDetail(("woelkchen"),
	    "Ein paar vereinzelte weisse Woelkchen sind am Himmel zu entdecken.\n");
  AddDetail(("innere"),
	    "Richtung Osten fuehrt die Strasse ins Innere der Stadt.\n");
  AddDetail(({"richtung", "richtungen"}),
	    "Du kommst von hier in die die Richtungen Osten, Norden und Sueden.\n");
  AddDetail(({"steine", "pflastersteine"}),
	    "Einfache graue Pflastersteine mit welchen die Strasse erbaut wurde.\n");
  AddDetail(("moos"),
	    "Das Moos waechst da und dort zwischen den Pflastersteinen. Aber auch an "
	    +"der Stadtmauer kannst Du welches entdecken.\n");
  AddDetail(("stadt"),
	    "Du stehst jetzt in der beeindruckenden Handelsstadt Arwenock.\n"); 
  AddDetail(({"arwenock", "handelsstadt"}),
	    "Arwenock ist eine grosse Handelsstadt in welcher Du Waren von "
	    +"den verschiedensten Voelkern erwerben kannst.\n");
  AddDetail(("waren"),
	    "Hier findest Du sicher viele interessante Waren.\n");
  AddDetail(({"voelker", "angehoerige"}),
	    "Arwenock wurde von Angehoerigen verschiedenster Voelker erbaut die "
	    +"hier auch regen Handel treiben.\n");
  AddDetail(({"handel"}),
	    "Gehandelt wird in Arwenock ueberaus viel.\n");
  AddDetail(({"tor", "stadttor"}),
	    "Das praechtige Stadttor von Arwenock befindet sich suedlich von hier. "
	    +"Es leuchtet in einem sanften Blau.\n");
  AddDetail(({"blau", "farbe"}),
	    "Das Stadttor leuchtet in der Farbe Blau.\n");
  AddDetail(({"stadtmauer", "mauer"}),
	    "Die steinerne Stadtmauer von Arwenock ist ziemlich massiv und ist von "
	    +"Moos und Efeu bedeckt. Ein paar Kritzeleien fallen Dir auf.\n");
  AddDetail(("kritzeleien"),
	    "Du kannst sie lesen.\n");
  AddReadDetail(("kritzeleien"),
		"Da steht:\n "
		+"'Xarfei war hier!',\n"
		+"'Trans mich rauf Woody!'\n"
		+"und\n"
		+"'Nieder mit dem Magierpack!'\n");
  AddDetail(("efeu"),
	    "Der Efeu rankt sich da quer ueber die Stadtmauer hoch.\n");
  AddDetail(({"haeuser", "haus"}),
	    "Es sind schoene mehrstoeckige Haeuser mit huebschen Fenstern "
	    +"und mit Waenden die eine gelungene Kombination aus Holz und "
	    +"Stein sind.\n");
  AddDetail(({"wand", "waende", "kombination"}),
	    "Die Waende der Haeuser bestehen aus einer gelungenen Kombination "
	    +"von Holz und Stein.\n");
  AddDetail(({"stein", "rotstich"}),
	    "Es ist ein graeulicher Stein mit einem leichten Rotstich.\n");
  AddDetail(({"holz", "eichenholz"}),
	    "Es duerfte sich dabei um solides Eichenholz handeln.\n");
  AddDetail(("fenster"),
	    "Die Fenster sind aus buntem Glas welches ein paar huebsche "
	    +"Muster aufweist.\n");
  AddDetail(("muster"),
	    "Die Muster im Glas der Fenster sind sehr huebsch anzusehen.\n");
  AddDetail(("glas"),
	    "Das Glas ist sehr sauber gearbeitet und weist huebsche Muster "
	    +"auf.\n");
  AddDetail(("wohnungen"),
	    "Die Wohnungen befinden sich in den Haeusern oestlich von Dir.\n");
  AddDetail(("wohnung"),
	    "Da duerfte gerade gekocht werden.\n");
  AddDetail(("gespraechsfetzen"),
	    "Du kannst ihnen ja mal lauschen.\n");
  AddSound(DEFAULT_SOUND, 
	   "Du vernimmst einige Gespraechsfetzen aus den Wohnungen im Osten.\n");
  AddSound(({"gespraechsfetzen", "gebrabbel"}), 
	   "Es ist zumeist nur sinnloses Gebrabbel aber ein Stoehnen faellt Dir auf.\n");
  AddSound(({"stoehnen", "ja"}), 
	   "Du hoerst: Ja, JA weiter so. Das ist wunderbar! Das Stoehnen geht in ein "
	   +"Aechzen ueber.\n");
  AddSound(("aechzen"),
	    "Du hoerst: Ohja, gleich ist es soweit. Das Aechzen geht in einen "
	    +"Freudenschrei begleitet von einem Rumpeln ueber.\n");
  AddSound(({"freudenschrei", "schrei", "rumpeln"}),
	   "Du hoerst: *rumpel* Ja, endlich geschafft. Endlich ist der schwere "
	   +"Kasten dort wo er sein soll.\n");
  AddDetail(("kasten"),
	    "Der wird wohl irgendwo dort oben stehen.\n");
  AddSmell(DEFAULT_SMELL,
           "Aus einer der Wohnungen dringt ein hoechst angenehmer Duft an deine "
	   +"Nase.\n");
  AddSmell(("duft"),
	   "Es duerfte sich dabei um den Duft eines wunderbaren Mahles handeln. "
	   +"Da sind wahrscheinlich Hobbits am Werk.\n");
  AddDetail(("mahl"),
	    "Riech mal.\n");
  AddSmell(("mahl"),
	   "Riecht koestlich.\n");
  AddDetail(("werk"),
	    "Der Duft laesst darauf schliessen, dass hier Hobbits am Werk sind.\n");
  AddDetail(({"hobbits", "koeche"}),
	    "Hobbits sind ja bekanntlich die besten Koeche des Silberlandes.\n"); 
  AddDetail(("silberland"),
	    "Das solltest Du aber schon selber wissen.\n");
  AddDetail(("nase"),
	    "Damit kann man riechen.\n");
  
  AddExit( "sueden", ROOM "room_B-04" );
  AddExit( "norden", ROOM "room_B-06" );
  AddExit( "osten",  ROOM "room_C-05" );

}





