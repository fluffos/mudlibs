
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer engen Gasse in Arwenock");
  
  SetProp(P_INT_LONG, BS(
          "Du befindest Dich im suedoestlichen Winkel in Arwenock."
         +" Nach Westen fuehrt ein breiter Weg in weiterer"
         +" Folge zum Stadttor, nach Norden siehst Du eine enge Gasse,"
         +" begrenzt nur durch die Mauern der Haeuser und die"
         +" Stadtmauer."));
  
  AddDetail(({"winkel", "kanten", "ecken"}), BS(
            "Aufgrund der alten Bauweise der Haeuser und Gassen findest"
           +" Du hier ueberall Winkel, Kanten und Ecken. Die Stadt"
           +" haette wohl mal mehr Geld fuer die Planung ausgeben sollen."));
  AddDetail("bauweise", BS(
            "Du lehnst Dich gemuetlich an die Stadtmauer und betrachtest"
           +" die Bauwerke genauer. Du bist beeindruckt von den zahlreichen"
           +" Fachwerkhaeusern."));
  AddDetail(({"mauern", "mauer", "stadtmauer"}), BS(
            "Die Stadtmauer befindet sich genau suedlich und oestlich von"
           +" Dir."));
  AddDetail(({"werke", "bauwerke"}), BS(
            "Bei den Bauwerken handelt es sich im wesentlichen ausschliesslich"
           +" um Fachwerkhaeuser"));
  AddDetail(({"fachwerk", "haeuser", "fachwerkhaeuser"}), BS(
            "Trotzdem die meisten Haeuser schon ziemlich alt aussehen, sind"
           +" sie dennoch stabil und trotzem jedem Sturm."));
  AddDetail("sturm", BS(
            "Sei froh, dass es gerade nicht stuermt!"));
  AddDetail("planung", BS(
            "Nunja, als Stadtplaner haette man sicher kein schlechtes"
           +" Einkommen hier! Man muesste direkt mal den Buergermeister"
           +" befragen."));
  AddDetail("einkommen", BS(
            "Du wirst hier ja wohl nix verdienen koennen, bei Deiner"
           +" ungenauen Planung!"));
  AddDetail(({"planer", "stadtplaner"}), BS(
            "Frag doch mal den Buergermeister, ob Du ihm nicht behilflich"
           +" sein kannst."));
  AddDetail("buergermeister", BS(
            "Den Buergermeister wirst Du hier sicher nicht finden."));
  AddDetail("weg", BS(
            "Der Weg ist schoen gepflastert, direkt bequem zum drauf"
           +" laufen."));
  AddDetail(({"strassenpflaster", "pflaster"}), BS(
            "Da scheint sich ja wirklich jemand Muehe gemacht zu haben"
           +" diese Gassen emsig zu pflastern."));
  AddDetail("muehe", BS(
            "Ein bisschen mehr bemuehen koenntest Du Dich auch!"));
  AddDetail(({"gasse", "gassen"}), BS(
            "Viele Gassen fuehren durch Arwenock. Diese enge Gasse,"
           +" die nach Norden fuehrt, ist eine davon."));
  AddDetail(({"stadt", "arwenock"}), BS(
            "Korrekt, Du befindest Dich gerade in Arwenock."));
  AddDetail("boden", BS(
            "Auf dem Boden siehst Du nur ganz gewoehnliches Strassenpflaster."));
  AddDetail("folge", BS(
            "Zuerst folgst Du dem Weg nach Westen dann gelangst Du bestimmt"
           +" zum Stadttor."));
  AddDetail(({"tor", "stadttor"}), BS(
            "Durch das Stadttor betreten alle Reisenden diese Stadt."));
  AddDetail("reisende", BS(
            "Ich wuerd mal sagen Du zaehlst selber dazu!"));
  AddDetail("himmel", BS(
            "Du siehst eigentlich nur strahlend blauen Himmel, ein paar"
           +" Wolken hie und da. Und eine Sonne gibts auch natuerlich."));
  AddDetail("sonne", BS(
            "Autsch! Nicht direkt in die Sonne schauen!"));
  AddDetail("wolken", BS(
            "Die Wolken sehen aus wie Wolken. Erstaunlich, nicht?"));
  AddDetail("zikade", BS(
            "So sehr Du Dich auch bemuehst, dem Zirpen der Zikade zu folgen,"
           +" Du kannst sie einfach nicht entdecken."));
  AddDetail(({"nischen", "mauernischen", "nische", "mauernische"}), BS(
            "Du siehst ziemlich viele Mauernischen, jedoch die eine mit der"
           +" Zikade findest Du einfach nicht.")),
  AddDetail("haus", BS(
            "Das Haus nordwestlich von Dir faellt genauso wie viele"
           +" andre Haeuser hier unter 'Fachwerk'."));
  AddDetail("stock", BS(
            "Eine Sensation! Das Haus nordwestlich von Dir hat sogar einen"
           +" ersten Stock! Unglaublich!"));
  AddDetail("sensation", BS(
            "Wenn Du recht ueberlegst - so sensationell war das auch wieder"
           +" nicht."));
  AddDetail("nase", BS(
            "Du greifst irritiert schnell in Dein Gesicht und stellst"
           +" erleichtert fest: Nase noch da."));
  AddDetail("gesicht", BS(
            "Beim Abtasten der Nase hast Du festgestellt, dass das Gesicht"
           +" an sich auch noch vollstaendig ist."));
  AddDetail("luft", BS(
            "Ohne die Luft koenntest Du vermutlich gar nicht atmen."));
  AddSound(DEFAULT_SOUND, BS(
           "Suedlich von Dir glaubst Du ein leises Zirpen zu vernehmen."));
  AddSound("zirpen", BS(
           "Das leise Zirpen duerfte wohl von einer Zikade stammen, die"
          +" sich in einer Mauernische vor der prallen Sonne schuetzt."));
  AddSound("zikade", BS(
           "Die Zikade zirpt leise vor sich hin."));
  AddSmell(DEFAULT_SMELL, BS(
           "Du reckst Deine Nase hoch in die Luft, und stellst fest,"
          +" dass in dem Haus nordwestlich von Dir (im ersten Stock)"
          +" gekocht wird. Was genau kannst Du Dir jedoch nicht vorstellen,"
          +" willst Du bei dem eher seltsamen Geruch auch nicht."));
  AddSmell("geruch", BS(
           "Du schnupperst noch einmal intensiv. Nein wirklich, etwas gutes"
          +" wird da bestimmt nicht zubereitet!"));

  AddExit( "norden", ROOM "room_H-02" );
  AddExit( "westen", ROOM "room_G-01" );

}
