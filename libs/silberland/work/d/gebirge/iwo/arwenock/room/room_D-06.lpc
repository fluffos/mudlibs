
#include "../def.h"

inherit STDROOM;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Rathaus von Arwenock");

  SetProp(P_INT_LONG,
    "Du befindest Dich hier im Empfangsbereich des Rathauses von "
    "Arwenock. Hinter einem kleinen Pult sitzt der Protier und "
    "geht nach typischer Beamtenmanier keiner Betaetigung nach. "
    "An der Wand haengt eine Anschlagtafel mit Hinweisen zu den "
    "verschiedenen Abteilungen.");

  AddDetail( ({ "empfangsbereich", "bereich", "empfaenge", "empfaengen" }),
    "Hier ist es genau so langweilig wie in den meisten Empfaengen. "
    "In einer Ecke steht ein Staender mit verschiedenen Prospekten "
    "ueber Dinge, von denen Du gar nichts wissen moechtest.");
  AddDetail( ({ "ecke", "ecken" }),
    "In einer der Ecken steht ein Prospektstaender.");
  AddDetail( ({ "staender", "prospektstaender" }),
    "Ein paar Prospekte stecken drinnen.");
  AddDetail( ({ "prospekte", "prospekt" }),
    "Du siehst welche mit Ueberschriften wie:\n\n"
    "\tKuerbisfest in Arwenock\n"
    "\tKeine weitere Muelldeponie im Gebirge\n"
    "\tWarum wir stolz auf unsere Region sind\n"
    "\tLebensraum Gebirgswald\n"
    "Etwas gelangweilt laesst Du sie liegen.");
  AddReadDetail( ({ "prospekt", "prospekte" }),
    "Die interessieren Dich wirklich ueberhaupt nicht.");
  AddDetail( ({ "dinge" }),
    "Du koenntest Dir die Prospekte ja mal ansehen.");

  AddDetail( ({ "rathaus" }),
    "Das Rathaus beherbergt die oberste Verwaltung der Region. Hier "
    "kann man Antraege stellen, Beschwerden vorbringen und andere "
    "Behoerdengaenge erledigen.");
  AddDetail( ({ "verwaltung", "abteilungen" }),
    "Die Verwaltung ist hier in unterschiedlichen Abteilungen "
    "angesiedelt. Genaueres darueber steht sicher auf der "
    "Anschlagtafel."); 
  AddDetail( ({ "region", "gebirge" }),
    "Die hiesige Region heisst 'Gebirge'.");
  AddDetail( ({ "antraege" }),
    "In den zustaendigen Abteilungen kann man Antraege stellen.");
  AddDetail( ({ "beschwerden" }),
    "Im Beschwerdebriefkasten kann man ausgefuellte Kaertchen mit "
    "Beschwerden los werden.");
  AddDetail( ({ "beschwerdebriefkasten", "kaertchen" }),
    "Genaueres dazu kann Dir sicher der Portier sagen.");
  AddDetail( ({ "behoerdengaenge" }),
    "Diese kannst Du hier erledigen.");
  AddDetail( ({ "pult" }),
    "Ein kleines, hoelzernes Pult steht beinahe mitten im "
    "Empfangsbereich. Dahinter steht ein kleiner Stuhl auf dem "
    "es sich ueberlicher Weise ein Portier bequem macht.");
  AddDetail( ({ "stuhl" }),
    "Der Stuhl sieht eigentlich recht bequem aus, und bietet auf der "
    "ziemlich abgesessenen Sitzflaeche Platz fuer den Portier.");
  AddDetail( ({ "sitzflaeche" }),
    "Sie ist schon fast durchgewetzt.");
  AddDetail( ({ "platz" }),
    "Gerade recht fuer das Hinterteil eines Beamten.");
  AddDetail( ({ "hinterteil" }),
    "Der Portier waer sicher nicht sonderlich erfreut, wenn Du seines "
    "anstarrst.");
  AddDetail( ({ "weise" }),
    "Ueblicher halt.");
  AddDetail( ({ "betaetigung" }),
    "Sie besteht wohl hauptsaechlich darin in fremder Leute Antraege "
    "zu schmoekern.");
  AddDetail( ({ "leute" }),
    "Leute wie Du.");
  AddDetail( ({ "beamtenmanier" }),
    "Naja, darueber wie manierlich das wirklich ist, muss wohl jeder "
    "fuer sich selbst entscheiden.");
  

  AddExit( "raus", ROOM "room_D-05" ); 
  AddExit( "sueden", ROOM "room_D-05" ); 
  SetProp(P_HIDE_EXITS, ({ "sueden" }));

}
