#define WIZNAME "Iwo"
#include "../def.h"

inherit STDROOM;

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

#define OPEN 1

int extestfun();
string statusfunc();
    
void create()
{
  ::create();
  

  SetProp( P_INT_SHORT, sprintf("Im Waffen- und Ruestungsmuseum von %s",
                                 STADT ));
  SetProp( P_INT_LONG,
           "Ein schwacher Lichtschein, der durch die kleinen Fenster in den "
           "Waenden eindringt, erhellt die Vorhalle des Museums. Ueberall "
           "haengen Plakate verschiedener Veranstaltungen und Ausstellungen."
           "Duch die Durchgaenge im Osten und Westen kannst Du die "
	   "Ausstellungsraeume besuchen, und "
           "im Norden befindet sich die Tuer durch die Du das Museum betreten "
           "hast.@@statusfunc@@");

  // Details. weils so schon iss *gaehn*

  AddDetail( ({"lichtschein", "schein"}),
             "Durch die kleinen verglasten Oeffnungen in den Waenden, genannt "
             "Fenster, dringt schwummriges Licht in den Raum ein.");
  AddDetail( ({"oeffnung", "oeffnungen"}),
             "Kleine Holzrahmen fassen kunstvoll gefertigte Glasscheiben ein, "
             "und ermoeglichen dadurch dem Licht den Raum zu fluten");
  AddDetail( ({"rahmen", "holzrahmen"}),
             "Irgendjemand hat sie gefertigt, um dafuer zu sorgen, dass das "
             "Glas nicht aus den Oeffnungen faellt. Genial einfach.");
  AddDetail( ({"irgendjemand"}),
             "Irgendjemand kannst Du nicht sehn. Wie auch?");
  AddDetail( ({"glas", "scheiben", "glasscheiben", "glasscheibe"}),
             "Unglaublich, aber wahr. Es ist hart, und man kann trotzdem durch "
             "sehen. Du bist voellig ueberwaeltigt.Und der Ueberhammer ist, dass "
             "man auch noch die Nase oder die Zunge dagegendruecken kann.");
  AddDetail( ({"ueberhammer"}),
             "Das willst Du eigentlich nicht wissen.");
  AddDetail( ({"hammer"}),
             "Du siehst hier keinen Hammer.");
  AddDetail( ({"nase"}),
             "Boah, ist die dick Mann!");
  AddDetail( ({"zunge"}),
             "Du versuchst einen Blick auf Deine Zunge zu erhaschen, versagst "
             "jedoch klaeglich.");
  AddDetail( ({"licht", "atmosphaere"}),
             "Das durch die kleinen Fenster eindringende Licht, reicht voellig aus, "
             "um den Raum eine angehehm schwummrige Atmosphaere zu geben.");
  AddDetail( ({"plakate"}),
      "Die Plakate sind schon ziemlich vergilbt und Du kannst leider nichtmehr "
      "lesen was draufsteht. Nur eines scheint relativ neu zu sein.");
      
  AddDetail( ({ "ausstellungsraeume", "raeume" }),
      "Nach Osten und nach Westen kann man sie betreten.");
      
  AddDetail( ({ "tuer" }),
      "Die Tuere nach Norden ist geoeffnet. Durch sie bist Du reingekommen.");
      
  AddDetail( ({ "waende", "wand", "waenden" }),
      "An den Waenden haengen verschiedene bunte Plakate.");
      
  AddDetail( ({ "vorhalle", "halle" }),
      "Da befindest Du Dich gerade.");
      
  AddDetail( ({ "veranstaltungen", "veranstaltung" }),
      "Irgendwelche Vortraege oder Fuehrungen von irgendwelchen "
      "Professoren oder so.");
      
  AddDetail( ({ "vortraege", "fuehrungen", "geschwafel" }),
      "Sinnloses Geschwafel Waffen und Ruestungen.");

  AddDetail( ({ "ruestungen", "waffen" }),
      "Einige davon kannst Du in den Ausstellungsraeumen "
      "besichtigen.");
      
  AddDetail( ({ "professoren" }),
      "Im Moment sind keine da.");
      
  AddDetail( ({ "museum", "museums" }),
     "Im Museum befindest Du Dich gerade.");
     
  AddDetail( ({ "ausstellung", "ausstellungen" }),
     "Hier siehst man Waffen und Ruestungen.");
     
  AddDetail( ({ "raum" }), ME->QueryProp(P_INT_LONG));

  AddDetail( ({ "moment" }),
     "Als Du ihn erforschen willst, isser auch schonwieder weg. "
     "Schade eigentlich.");

  AddDetail( ({ "himmel" }),
     "Hier herinnen? Unsinn.");

  AddDetail( ({ "boden" }),
     "Der Boden ist hier fein saeuberlich mit Holzplanken ausgelegt.");
     
  AddDetail( ({ "planken", "holzplanken" }),
     "Ein bisschen schmutzig vom Strassenstaub, aber in Ordnung.");
     
  AddDetail( ({ "ordnung" }),
     "... ist das halbe Leben.");
     
  AddDetail( ({ "leben", "haelfte" }),
     "Du lebst in der andern Haelfte.");

  AddDetail( ({ "fenster" }),
     "Fenster nennt man die Oeffnungen in der Wand.");
     
  AddDetail( ({ "durchgaenge", "durchgang" }),
     "Die Durchgaenge fuehren in die Ausstellungsraeume.");

  AddDetail( ({ "strassenstaub", "staub" }),
     "Ordinaerer Dreck halt.");
     
  AddDetail( ({ "dreck" }),
     "So, wie er halt ueberall runliegt.");
     
  AddDetail( ({ "plakat" }),
     "Du kannst es wohl lesen.");
     
  AddReadDetail( ({ "plakat" }),
     "+------------------------------+\n"
     "|                              |\n"
     "|          VITAE FIN           |\n"
     "|                              |\n"
     "|                              |\n"
     "|                              |\n"
     "| Ausstellung der maechtigsten |\n"
     "|   Waffen des SilberLandes    |\n"
     "|                              |\n"
     "|                              |\n"
     "|                              |\n"
     "|                              |\n"
     "| Eintritt: 120 Muenzen        |\n"
     "+------------------------------+\n");
     
  
  AddExit( "norden", ROOM "room_E-03" );
 
  if (OPEN)
    {
      AddExit( "osten",  ([EX_DEST: ROOM "room_F-02",
                           EX_TESTFUNC: #'extestfun,]) );
      AddExit( "westen",  ([EX_DEST: ROOM "room_D-02",
                           EX_TESTFUNC: #'extestfun,]) );
    }

  AddItem(NPC "cardula", REFRESH_DESTRUCT);
  
}


string statusfunc()
{
  if(OPEN) return "Das Museum ist heute\ngeoeffnet.";
  
  else 
    {
      AddDetail( ({"kette", "ketten"}),
        "And den Ketten haengen Schilder.");

      AddDetail( ({ "schild", "schilder" }),
        "Du kannst es mit lesen versuchen.");
	
      AddReadDetail( ({ "schild", "schilder" }),
        "Auf den Schildern steht:\n    Geschlossen.\n"); 
      return " Die Durchgaenge sind mit\nKetten versperrt.";
    }
}


string _query_int_long()
{
  return BS( 
    "Ein schwacher Lichtschein, der durch die kleinen Fenster in den "
  + "Waenden eindringt, erhellt die Vorhalle des Museums. Ueberall "
  + "haengen Plakate verschiedener Veranstaltungen und Ausstellungen. "
  + "Durch die Durchgaenge im Osten und Westen kannst Du die "
  + "Ausstellungsraeume besuchen, und "
  + "im Norden befindet sich die Tuer durch die Du das Museum betreten "
  + "hast. " + statusfunc());
  
}



int extestfun()
{
  object ob;
  if (ob = present("cardula", ME))
    {
      if(!ob->checkentrance(TP)) return 0;
    }
    
  return 1;
}
