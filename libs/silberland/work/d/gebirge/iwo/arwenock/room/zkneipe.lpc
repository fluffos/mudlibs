// Kneipe, Mai 2001, von Angrox@SL angefangen und von Zak fertiggestellt

inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <pub.h>
#include "../def.h"
#include "/d/gebirge/directions.h"
#include <moredef.h>
#include <defines.h>

#define WIZNAME "zaknafein"

string bauchwatschn();

void create()
{
  ::create();

  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" ); 
 
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "\ntolgura");
  SetProp(P_PUBKEEPER_NAME, "Tolgura");
  SetProp(P_PUBMSG_NOKEEPER, "Tolgura ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Tolgura. Kein Wunder, "
      "dass sie Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Tolgura kaempft. Hilf ihr lieber, dann bekommst Du frueher was."));
  SetProp(P_PUBMSG_FIGHTING, "Tolgura kaempft gerade.\n");

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:23]));
  SetProp (P_INT_SHORT, "Schenke 'Drachenmaul'");


  AddItem (NPC "tolgura", REFRESH_DESTRUCT);


  AddDrink ("Drachentoeter", ({ "drachentoeter", "toeter" }),
      1700, ({ 65, 40, 5 }), 7, 10, ({ BS("Tolgura bringt Dir einen "
      "mit Drachenreliefen verzierten Kelch voll mit einer "
      "blutroten Fuessigkeit. Du kippst den Kelch in einem "
      "Zug runter und wischt Dir was danebengegangen ist mit "
      "einer barbarischen Armgeste ab."),
      BS("&& kippt einen mit Drachenreliefen verzierten Kelch "
      "voller blutroter Fluessigkeit in einem Zug runter und "
      "wischt sich mit einer barbarischen Handbewegung das was "
      "nicht im Mund Platz hatte weg.") }));

  AddDrink ("Seicherlwasser", ({ "seicherlwasser", "wasser" }),
      100, ({ 21,19 }), 0, 10, ({ BS("Tolgura bringt Dir ein "
      "Seicherlwasser."),
      BS("&& kippt sich ein Seicherlwasser runter.") }));

  AddDrink ("Ein Humpen Drachenbraeu", ({ "braeu", "drachenbraeu",
      "humpen" }), 150, ({ 15,10 }), 2, 2, ({ BS("Tolgura bringt "
      "Dir einen Humpen Drachenbraeu, welchen Du in einem Zug "
      "runter schuettest."), BS("&& schuettet sich einen Humpen "
      "Drachenbraeu in die Kehle.") }));

  AddFood ("Eine gegrillte Drachenplatte", ({ "platte",
      "drachenplatte" }), 2500, ({ 100, 80 }), 17, ({ BS("Tolgura "
      "serviert Dir eine riesige, genial duftende Drachenplatte, "
      "welche Du sogleich genussvoll verzehrst."),
      BS("&& verzehrt schmatzend ein koestlich duftende "
      "Drachenplatte.")}));

  AddFood ("Ein Drachenbratlbrot", ({ "brot", "bradlbrot", "brot" }),
      150, ({ 28,14 }), 8, ({ BS("Du schnappst Dir ein "
      "Drachenbratlbrot von der Theke und wuergst es genussvoll "
      "hinunter."), BS("&& wuergt genussvoll ein Drachenbratlbrot "
      "hinunter.") }));
 
  AddDetail( ({ "goetter", "goettern" }),
    "Die solltest Du als waschechter Silberlaender schon kennen!");
  AddDetail( ({ "silberlaender" }),
    "Du bist einer davon. Waschecht, farbfest... und weichgespuelt.");
  AddDetail( ({ "kneipe" }),
    "Das Drachenmaul ist Treffpunkt der legendaeren Drachentoeter.");
  AddDetail( ({ "drachentoeter", "toeter" }),
    "Du bist vielleicht sogar einer von ihnen.");
  AddDetail( ({ "geschmack" }),
    "Die Speisen und Getraenke hier sind wohl g'schmackig!");
  AddDetail( ({ "speisen", "getraenke" }),
    "Tipp doch einfach mal 'menue'.");
  AddDetail( ({ "baenke", "tische" }),
    "Die Baenke und Tische sind aus grob gehauenem Holz.");
  AddDetail( ({ "holz" }),
    "Das Holz stammt wohl aus den Waeldern des Silberlandes.");
  AddDetail( ({ "waeldern", "waelder" }),
    "Du hast wohl schon so einige von ihnen durchstreift.");
  AddDetail( ({ "silberlandes", "silberland" }),
    "Da befindest Du Dich gerade.");
  AddDetail( ({ "flair" }),
    "Ziemlich rustikal. Wie man es von einer Kneipe dieses Namens "
    "erwarten kann.");
  AddDetail( ({ "name", "namems" }),
    "'Drachenmaul'.");
  AddDetail( ({ "raumes", "raum" }), #'_query_int_long);
  AddDetail( ({ "drachenmaul", "maul" }),
    "Die Kneipe hier heisst deshalb so, weil sie von aussen "
    "aussieht wie ein Drachenmaul.");
  AddDetail( ({ "wand", "waende" }),
    "An den Waenden haengen diverse Kuriositaeten.");
  AddDetail( ({ "kuriositaeten" }),
    "Drachenschuppen, Dornenschwaenze und anderes Zeugs.");
  AddDetail( ({ "zeugs" }),
    "Nichs, dem Du etwas abgewinnen kannst.");
  AddDetail( ({ "drachenschuppen" }),
    "Recht viel kann man daran nicht erkennen.");
  AddDetail( ({ "dornenschwaenze", "schwaenze" }),
    "Ein paar mit echt ueblen Dornen besetzte Schwaenze. Eine "
    "der toedlichen Waffen der Drachen.");
  AddDetail( ({ "waffen" }),
    "Zum Beispiel Dornenschwaenze.");
  AddDetail( ({ "drachen" }),
    "Im Silberland kannst Du einige finden.");
  AddDetail( ({ "dornen" }),
    "Messerscharfe, dolchartige Dornen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus hoelzernen Dielen.");
  AddDetail( ({ "dielen" }),
    "Die Dielen sind aus Holz und recht sauber verlegt.");
  AddDetail( ({ "decke" }),
    "Die Decke ist nicht sonderlich weit oben unt wird "
    "gestuetzt durch massives Gebaelk.");
  AddDetail( ({ "gebaelk" }),
    "Es wirkt recht massiv, und ist wie beinahe alles hier aus "
    "Holz.");
  AddDetail( ({ "lederhose" }),
    "Eine handelsuebliche Lederhose. Scheinbar um drei Nummern zu "
    "klein.");
  AddDetail( ({ "lederoberteil", "oberteil" }),
    "Wui, wohl viel zu klein. Der Bauch ist zu sehen.");
  AddDetail( ({ "bauch" }), #'bauchwatschn);

  AddDetail( ({ "theke", "schank" }),
    "Wie es nicht anders sein koennte hier, ist die Theke "
    "aus massivem Holz.");
  AddDetail( ({ "zahn" }),
    "Der eindrucksvolle Zahn scheint aus dem Maul eines "
    "Drachen zu stammen.");
  AddDetail( ({ "frau" }),
    "Tolgura heisst die Wirtin hier.");  
  AddDetail( ({ "treffpunkt" }),
    "Diese Kneipe hier ist einer!");
  AddDetail( ({ "teil" }),
    "Der hintere.");

  AddExit( NORDEN, ROOM "room_C-03" );
}

string bauchwatschn()
{
  tell_room(ME, BS("Tolgura verpasst " + TP->name(WEM) + " eine "
    "deftige Ohrfeige."), ({ TP }));

  tell_object(TP, BS("Tolgura verpasst Dir eine deftige Ohrfeige."));
  TP->AddHp(-5);

  return "";
}

string _query_int_long() {
  string txt;
  txt="Bei allen Goettern! Das ist eine Kneipe nach Deinem Geschmack! "
      "Grob gehauene Baenke und Tische verleihen ihr ein rustikales "
      "Flair. Im hinteren Teil des Raumes spannt sich eine - "
      "ebenfalls aus grob gehauenen Holz bestehende - Theke durch "
      "die Kneipe.";
  if(present(QueryProp(P_PUBKEEPER_ID), TO)) 
    txt+=" Hinter der Theke steht eine grosse, kraeftige Frau, die "
      "mit einem engen Lederoberteil und Lederhose bekleidet ist. ";
  else txt+=" Im Moment ist die Theke leider verwaist. ";
  txt+="An den Waenden haengen diverse Kuriositaeten, am auffaelligsten "
       "ist dabei ein riesiger Zahn, der ueber der Theke haengt.";
  return BS(txt);
}

