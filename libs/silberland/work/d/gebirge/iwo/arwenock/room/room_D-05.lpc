
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();
//-----------------------------------------------

  SetProp(P_INT_LONG,
    "Der Weg hier fuehrt Dich quer druch die Stadt in Richtung "
    "Ostweg und zurueck. Von hier aus kannst Du den Marktplatz "
    "bereits etwas ueberblicken. Da viele Passanten bzw. einige "
    "Marktstandel jedoch groesser sind als Du, siehst Du weit noch "
    "nicht alles hier. Ein bisschen erinnert Dich die Stimmung "
    "hier an einen Flohmarkt. ");

  AddDetail( ({ "flohmarkt", "stimmung", "eindruck" }),
    "Naja es handelt sich natuerlich um keinen Flohmarkt, aber "
    "dein erster Eindruck erinnerte Dich an einen. ");

  AddDetail( ({ "weg", "wege", "wegen" }),
    "Der Weg unterscheidet sich kaum von den anderen in der "
    "Stadt. ");

  AddDetail( ({ "richtung", "ostweg", "osten"}),
    "Wo koennt sich der Ostweg nur befinden? \n"
    "Kleine Rauchwolken steigen ueber deinem Kopf auf. \n"
    "Du denkst   . o O (Im Osten?) ");

  AddDetail( ({ "rauchwolken", "wolken", "kopf" }),
    "Sie verblassen schon wieder. ");

  AddDetail( ({ "passanten", "passant", "leute" }),
    "Viele Passanten queren Deinen Weg. Hier herrscht schon ein reges "
    "Treiben auf den Wegen. ");

  AddDetail( ({ "treiben"}),
    "Ja hier ist schon einiges los. ");

  AddDetail( ({ "marktplatz", "platz", "markt", "auslaeufer" }),
    "Die Auslaeufer des Marktplatzes kannst Du hier noch ausmachen. ");

  AddDetail( ({ "marktstandel", "standel" }),
    "Ein paar davon kannst Du hier schon sehen. Ein Stand faellt Dir "
    "allerdings besonders auf. ");

  AddDetail( ({ "marktstand", "stand" }),
    "Momentan kannst Du noch nicht sagen, was Dich an diesem Stand so "
    "sehr interessiert. Er sieht aus wie jeder andere Stand hier. "
    "Ein einfaches Holzgestell aus vier Fuessen, die uebereinander "
    "gekreuzt sind, sodass jeweils zwei von Ihnen ein 'X' ergeben, "
    "sowie einer grossen Tischplatte auf der sich die Waren befinden, "
    "welche hier zum Kauf angeboten werden. Nach oben hin ist der "
    "Stand von einem grossen Leinentuch, welches auch als Schutz "
    "vor Regen und Sonne dient, bedeckt. ");

  AddDetail( ({ "x" }),
    "Die Fuesse sind wie ein 'X' uebereinandergekruezt. ");

  AddDetail( ({ "schutz", "sonne", "regen" }),
    "Ob es vor Regen gut schuetzt, kannst Du nicht sagen, aber vor der "
    "Sonne gewaehrt es sicherlich einen ausreichenden Schutz. ");

  AddDetail( ({ "tischplatte", "platte", "tisch" }),
    "Auf der Tischplatte liegen die verschiedensten Waren, die der "
    "Marktverkaeufer hier zum Kauf anbietet. Sicherlich wird man mit "
    "ihm auch feilschen koennen. ");

  AddDetail( ({ "waren", "ware", "dinge", "ding", "kauf" }),
    "Allerlei Dinge liegen auf dem Tisch aufgebreitet. Wirklich "
    "interessant findest Du davon allerdings nichts. ");

  AddDetail( ({ "leinentuch", "tuch" }),
    "Das Leinentuch besteht aus grob gewebtem Stoff. Ab und an erkennst "
    "Du, dass es schon geflickt worden ist. Es duerfte auch nicht mehr "
    "das juengste sein. ");

  AddDetail( ({ "stoff"}),
    "Als Du den Stoff genauer betrachtest, faellt Dir ein Muster auf. ");

  AddDetail( ({ "muster", "mitte" }),
    "Eingentlich handelt es sich dabei weniger um ein Muster, sondern "
    "vielmehr um ein Wappen. ");

  AddDetail( ({ "wappen" }),
    "Anscheinend hat der Verkaeufer hier einen alten Teppich verwendet, "
    "der zu frueherer Zeit einmal ein Wandteppich war. Ein praechtiges "
    "Wappen ist in der Mitte zu erkennen. Leider ist die Farbe schon "
    "etwas verblasst, aber ansonsten wuerde es sich in deinem Wohnzimmer "
    "sicher gut machen. ");

  AddDetail( ({ "teppich", "wandteppich" }),
    "Solche wie sie in Schloessern und Burgen oft zu bewundern sind. ");

  AddDetail( ({ "schloessern","schloss","burg","burgen","wohnzimmer" }),
    "Ja daran erinnert dich der Wandteppich. ");

  AddDetail( ({ "farbe", "restaurator" }),
    "Schade, dass es schon so sehr verblasst ist. Nur ein geschickter "
    "Restaurator koennte es noch retten. ");

  AddDetail( ({ "fuessen", "fuss" }),
    "Die Fuesse sind wie gesagt gekreuzt zu einem 'X' und bestehen "
    "aus Holz, welches einfach mit Naegeln an der Tischplatte "
    "befestigt worden ist. ");

  AddDetail( ({ "naegeln", "nagel", "stahl", "form", "naegel" }),
    "Der Form nach, sind es normale Naegel aus Stahl. ");

  AddDetail( ({ "holz" }),
    "Vermutlich handelt es sich um Holz aus dem Silberwald. ");

  AddDetail( ({ "silberwald", "wald" }),
    "Der Silberwald besteht aus viel Wald. Der wiederum besteht "
    "aus viel Holz. ");

  AddDetail( ({ "holzgestell", "gestell" }),
    "Das Gestell ist relativ einfach zusammengezimmert. Sehr stabil "
    "sieht es zwar nicht aus, aber dem Marktverkaeufer scheint das "
    "egal zu sein. ");

  AddDetail( ({ "marktverkaeufer", "verkaeufer" }),
    "Komisch wo der wohl gerade sein mag. \n"
    "Du denkst   . o O (Der holt sich sicher grade ein warmes "
    "Leberkaessemmerl). ");

  AddDetail( ({ "leberkaessemmerl","semmerl","semmel","leberkaessemmel" }),
    "Sehen kannst Du keines, aber vielleicht erkennst Du es anders. ");

  AddSound(DEFAULT_SOUND, "Du hoerst viele unterschiedliche Stimmen, "
     "welche sich gegenseitig in der Lautstaerke uebertreffen wollen. \n");

  AddSound( ({ "stimme", "stimmen", "lautstaerke", "feilschen" } ),
    "Lautes Feilschen drinkt an Dein Ohr. Von den vielen unterschiedlich "
    "Stimmen ist es Dir aber unmoeglich eine herauszuhoeren. ");

  AddSmell(DEFAULT_SMELL, "Jamm! Es riecht hier nach frischem Leberkaese. \n");

  AddSmell( ({"jamm", "leberkaese", "leberkas", "kaese","bauernleberkaese"}),
    "Herrlicher, frisch duftender Bauernleberkaese. Am liebsten wuerdest "
    "Du Dir gleich eine warme Leberkaessemmel kaufen, aber Du kannst nicht "
    "ausmachen wo genau der Geruch herkommt. ");

  AddSmell( ({"geruch", "leberkaessemmel", "leberkaesesemmel", "semmel"}),
    "Wenn Du nur wuesstest wo der Geruch herkommt... \n"
    "Du beginnst fast zu weinen. ");

//-----------------------------------------------
  AddExit( "osten",  ROOM "room_E-05" );
  AddExit( "westen", ROOM "room_C-05" );
  AddExit( "sueden", ROOM "room_D-04" ); 

}
