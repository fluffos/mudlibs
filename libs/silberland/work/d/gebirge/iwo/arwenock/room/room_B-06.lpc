
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "querolin"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst ziemlich im nordwestlichsten Eck von Arwenock. Hinter Dir "
    "ragt die maechtige Stadtmauer in die Hoehe. Gegenueber der Mauer erhebt " 
    "sich ein grosses Haus aus dem Boden. Irgendwie fuehlst Du Dich wie in "
    "einer Schlucht. Richtung Sueden kommst Du zum Haupttor der Stadt sowie "
    "zum Marktplatz. Nach Nordosten kannst Du dem Weg der Mauer entlang "
    "folgen. Am Rande der Wegbiegung steht ein kleiner Nussbaum. ");

  AddDetail( ({ "rande" }),
    "Dort wo der Weg selbst endet, und eine kleine Gruenflaeche zwischen ihm und "
    "der Mauer entstanden ist. ");

  AddDetail( ({ "gruenflaeche" }),
    "Gruenflaechen sind in einer Stadt etwas sehr schoenes. Aber hier hat sich "
    "eine noch wacker gehalten. ");

  AddDetail( ({ "wegbiegung", "biegung" }),
    "Wenn der Weg nicht gerade weiterfuehrt, sondern leicht in eine Richtung "
    "neigt, dann nennt man das eine Wegbiegung. Unter bestimmten Umstaenden "
    "kann aus einer Wegbiegung auch eine Kreuzung werden. Ein kleines Baeumchen "
    "steht in dieser Wegbiegung. ");

  AddDetail( ({ "kreuzung", "umstaenden", "wege" }),
    "Und zwar dann, wenn zwei Wege aufeinander treffen. ");

  AddDetail( ({ "baeumchen" }),
    "Nun gut. So klein ist der Baum dann doch wieder nicht. ");

  AddDetail( ({ "baum", "nussbaum" }),
    "Ein praechtig gewachsener Nussbaum steht vor Dir. Er hat kraeftige Aeste "
    "und einen Stamm, ueber den sich jedes Saegewerk freuen wuerde. ");

  AddDetail( ({ "stamm" }),
    "Der Stamm ist gut gewachsen. Jeder Saegewerksbesitzer wuerde seine helle "
    "freude an dem Stamm haben. Vom Stamm aus gehen einige Wurzeln weg. ");

  AddDetail( ({ "saegewerk" }),
    "Im Saegewerk wuerde der Baum zu Brettern und anderen Holzprodukten "
    "verarbeitet. ");

  AddDetail( ({ "saegewerksbesitzer" }),
    "Denen gehoert das Saegewerk. Darum heissen sie ja auch so. ");

  AddDetail( ({ "brettern", "bretter" }),
    "Zum Glueck steht der Baum noch im ganzen da. ");

  AddDetail( ({ "holzprodukten", "holzprodukte" }),
    "Vieles kann man aus Holz bzw. Brettern machen. ");

  AddDetail( ({ "wurzel", "wurzeln" }),
    "Was ein grosser Baum ist, hat auch grosse Wurzeln die tief ins Erdreich "
    "ragen. ");

  AddDetail( ({ "erdreich" }),
    "Darin siehst Du ausserdem ein kleines Taefelchen stecken. Es duerfte "
    "irgendetwas mit dem Baum zu tun haben. ");

  AddDetail( ({ "taefelchen", "tafel" }),
    "Auf dem Taefelchen steht: \n"
    "   +----------------------------------------+ \n"
    "   |  DIESER BAUM STEHT UNTER NATURSCHUTZ!  | \n"
    "   |          Die Stadtverwaltung.          | \n"
    "   +----------------------------------------+ \n"
    "                      | |                     \n"
    "                      | |                     \n");

  AddDetail( ({ "aeste", "ast" }),
    "An den Aesten sind eine vielzahl von Blueten und Blaettern gewachsen. "
    "Anscheinend blueht der Baum gerade. ");

  AddDetail( ({ "blaetter", "blaettern" }),
    "Typische Blaetter, wie sie nur ein Nussbaum hat. ");

  AddDetail( ({ "blueten", "bluete" }),
    "Aus diesen wunderbar duftenden Blueten werden sicherlich in kuerze "
    "Nuesse werden. ");

  AddDetail( ({ "nuesse", "nuss" }),
    "Aus den Nuessen kann man dann viele Sachen machen. Nusskuchen, "
    "Nussgeist, Studentenfutter, Futter fuer die Voegel im Winter... ");

  AddDetail( ({ "Sachen", "nusskuchen", "studentenfutter" }),
    "Jamm. Am liebsten wuerdest Du jetzt etwas davon dabei haben. ");

  AddDetail( ({ "nussgeist", "geist", "troepfchen" }),
    "Auch ein Troepfchen davon wuerdest du wohl kaum ablehnen. ");

  AddDetail( ({ "futter", "voegel", "winter" }),
    "Auch die Voegel freuen sich im Winter, wenn jemand an sei denkt, "
    "und ihnen etwas Futter zukommen laesst. ");

  AddDetail( ({ "sueden", "haupttor", "marktplatz" }),
    "Wenn Du von hier aus weiter Richtung Sueden gehst, kommst Du zu "
    "dem gewaltigen Stadttor, durch welches man die Stadt betreten und "
    "verlassen kann. Auch der Marktplatz befindet sich dort. ");

  AddDetail( ({ "stadttor", "tor" }),
    "Von hieraus kannst Du es nicht mehr so gut erkennen. Du wirst schon "
    "naeher rangehen muessen um es genauer untersuchen zu koennen. ");

  AddDetail( ({ "richtung" }),
    "Von hier aus kannst Du nur in zwei gehen. Nach Sueden oder nach "
    "Nordosten. ");

  AddDetail( ({ "nordosten" }),
    "Nach Nordosten fuehrt der Weg weiter der Mauer entlang. ");

  AddDetail( ({ "weg" }),
    "Auf dem Weg kann man noch einige Spuren erkennen. Ansonsten ist er "
    "nichts besonders. ");

  AddDetail( ({ "spuren" }),
    "Bei den Spuren handelt es sich um Fussabdruecke. ");

  AddDetail( ({ "fusspuren", "fussabdruecke" }),
    "Jemand duerfte hier etwas Erde an den Schuhen gehabt haben. "
    "Zumindest hat er erdige Fusspuren hinterlassen. ");

  AddDetail( ({ "schuhen", "schuhe" }),
    "Vermutlich ist er zuvor in etwas Erde getreten. ");

  AddDetail( ({ "erde" }),
    "Braune, dreckige Erde. Solche wie sie in Waeldern gefunden wird. ");

  AddDetail( ({ "waeldern", "wald" }),
    "Ausserhalb der Stadt findest Du sicherlich schnell einen. ");

  AddDetail( ({ "schlucht" }),
    "Genau wie in einer Schlucht im Gebirge fuehlst Du dich hier. "
    "Nur dass es hier keine schroffen Felsklippen gibt. ");

  AddDetail( ({ "felsklippen", "fels", "klippen" }),
    "Felsklippen sind sehr gefaehrlich. Leicht kann man von Ihnen "
    "runterstuertzen. Aber die gibt es zum Glueck nur im Gebirge. ");

  AddDetail( ({ "glueck" }),
    "Natuerlich gehoert nicht nur Glueck sondern auch Koennen dazu. ");

  AddDetail( ({ "koennen" }),
    "Koennen sollte man zum Bergsteigen schon mitbringen, ansonsten "
    "sollte man zumindest viel Glueck haben. ");

  AddDetail( ({ "gebirge", "berge", "bergsteigen" }),
    "Im Gebirge gibt es viele grosse Berge. Auf mache von Ihnen kann man "
    "sogar steigen. Allerdings ist das nicht gerade ungefaehrlich. ");

  AddDetail( ({ "haus" }),
    "Ein normales zweistoeckiges Haus aus Lehm und Holz wie sie hier "
    "des oefteren anzutreffen sind. ");

  AddDetail( ({ "lehm", "ziegel" }),
    "Der Lehm wird zu diesem Zweck gebrannt. ");

  AddDetail( ({ "zweck" }),
    "Aus dem gebrannten Lehm werden Ziegel hergestellt. ");

  AddDetail( ({ "holz", "dach" }),
    "Das Dach und die Fenster sind aus Holz. ");

  AddDetail( ({ "fenster" }),
    "Die Fenster haben grosse Fensterlaeden und fast alle haben durchsichtige "
    "Scheiben. Nur eines hat eine undurchsichtige Scheibe. ");

  AddDetail( ({ "fensterlaeden", "laeden" }),
    "Die Fensterlaeden bestehn aus kleinen zusammengeleimten Holzsprossen, die "
    "von einem geschnitzten Rahmen umgeben sind. ");

  AddDetail( ({ "holzsprossen", "sprossen" }),
    "Die Holzsprossen sind am Rahmen angeleimt, mit einer neutralen Farbe "
    "gestrichen worden. ");

  AddDetail( ({ "rahmen", "holzrahmen", "fensterrahmen" }),
    "Der Rahmen ist ebenfalls lackiert, und mit wunderschoenen Schnitzereien "
    "verziehrt. ");

  AddDetail( ({ "schnitzereien", "schnitzerei", "meisterleistung" }),
    "Eine wahre Meisterleistung ist diese Schnitzerei. Du wuerdest das auch "
    "gerne so beherrschen. ");

  AddDetail( ({ "farbe"}),
    "Die Farbe ist sehr rein und klar. Vermutlich ist es gar keine Farbe "
    "sondern vielmehr ein Holzanstrich. ");

  AddDetail( ({ "holzanstrich", "anstrich" }),
    "Der Anstrich passt gut zu den Fensterlaeden. ");

  AddDetail( ({ "scheibe", "bad" }),
    "Hinter dieser wird sich sicher das Bad befinden. ");

  AddDetail( ({ "scheiben"}),
    "Durch die Scheiben im Erdgeschoss kann man ins Haus hineinsehen. ");

  AddDetail( ({ "erdgeschoss" }),
    "Im Erdgeschoss befinden sich 2 Fenster. Hinter dem ersten erkennst Du "
    "ein Esszimmer und hinter dem zweiten duerfte sich die Speisekammer "
    "befinden. ");

  AddDetail( ({ "esszimmer" }),
    "Im Esszimmer kannst Du einen grossen Tisch und vier Sessel erkennen. "
    "Der Tisch ist schon gedeckt. Sicherlich werden die Hausbesitzer bald "
    "etwas essen. ");

  AddDetail( ({ "tisch", "hausbesitzer", "sessel" }),
    "Alles sieht so aus, alls wuerden die Hausbesitzer gleich etwas essen "
    "wollen. ");

  AddDetail( ({ "speisekammer" }),
    "In der Speisekammer werden viele herrliche Wuerste aufbewahrt. Einen "
    "saftigen Schinken kannst Du auch sehen. Speck, Kaese und ein Fass "
    "glaubst du ebenfalls noch zu erkennen. ");

  AddDetail( ({ "wuerste", "wurst", "schinken","speck","kaese" }),
    "Am liebsten wuerdest zu davon kosten. ");

  AddDetail( ({ "fass" }),
    "Alles stadtbekannter Fasskenner, bemerkst Du natuerlich sofort, dass "
    "es sich dabei nur um ein Bierfass handel kann. ");

  AddDetail( ({ "fasskenner", "kenner" }),
    "So koennte man Dich schon bezeichnen. ");

  AddDetail( ({ "bierfass", "bier" }),
    "Vermutlich handelt es sich um Bier aus Felonia. Dort gibt es angeblich "
    "das allerbeste. ");

  AddDetail( ({ "felonia", "zwergenstadt", "tief" }),
    "Felonia ist die Zwergenstadt. Sie liegt irgendwo im Gebirge versteckt. "
    "Tief unter der Erde. ");

  AddDetail( ({ "eck", "ecke" }),
    "Zugegeben - es ist ein grosse etwas abgerundete Ecke, aber dennoch "
    "kann man es als solche bezeichnen. Als Versteck ist diese Ecke allerdings "
    "kaum zu verwenden. ");

  AddDetail( ({ "versteck" }),
    "Wenn Du Dich vor jemandem verstecken willst, koenntest Du es freilich "
    "schon versuchen, aber wirklich viel Deckung wirst du hier nicht finden. ");

  AddDetail( ({ "deckung" }),
    "Wie gesagt, kaum etwas geeignetes ist in der Ecke vorhanden. ");

  AddDetail( ({ "stadtmauer", "mauer", "hoehe" }),
    "Die Stadtmauer ist wirklich eine der groessten und besten Befestigungen, "
    "die Du bisher gesehen hast. Kaum ein Schutzwall kommt dem nahe, was die "
    "Erbauer dieser Stadt hier vollbracht haben. Ihr Werk ist sicher auch noch "
    "aus grosser Ferne gut zu betrachten. ");

  AddDetail( ({ "ferne" }),
    "Auch aus der Ferne sieht man die Stadtmauer sicherlich noch gut. ");

  AddDetail( ({ "schutzwall", "wall" }),
    "Es ist wirklich ein maechtiger. ");

  AddDetail( ({ "erbauer" }),
    "Das muessen starke und vor allem auch ausdauernde Stadtbewohner gewesen "
    "sein. ");

  AddDetail( ({ "stadtbewohner", "bewohner" }),
    "Wenn Du Dich umsiehst, wirst Du sicher welche treffen. ");

  AddDetail( ({ "bauer", "xaver"}),
    "Davon kannst Du keine sehen hier. Nur ab und an kommt Xaver hier vorbei. ");

  AddDetail( ({ "befestigungen", "werk", "seltenheit" }),
    "So eine maechtige Befestigungsanlage ist wirklich eine Seltenheit. "
    "Du fuehlst Dich hier sicherer als daheim. ");

  AddDetail( ({ "befestigungsanlage", "anlage", "meisterwerk" }),
    "Wahrlich ein Meisterwerk. ");

  AddSound(DEFAULT_SOUND, "Leise Stimmen sind zu hoeren. \n");

  AddSound( ({ "stimme", "stimmen"}),
    "Genauers kannst Du nicht heraushoeren, jedoch scheint es, als ob nicht "
    "allzuweit entfernt jemand Streit hat. ");

  AddSound( ({"streit"}), "Um was dabei geht verstehst Du leider nicht.");

  AddSmell(DEFAULT_SMELL, "Es duftet herrlich nach Blueten. \n");

  AddSmell( ({"bluete", "duefte", "blueten","bluetenduft" }),
    "Der herrliche Bluetenduft steigt in Deine Nase. Wo der nur herkommen "
    "mag. ");

  AddDetail( ({ "nase", "gesicht" }),
    "Die ist mitten im Gesicht. Zumindest bei Dir. ");

  AddExit( "sueden", ROOM "room_B-05" );
  AddExit( "nordosten", ROOM "room_C-07" );

  AddCmd (({"klettere","kletter"}), "kletter");
}

kletter(string str)
{
   string race;

   notify_fail ("Wohin willst Du klettern? Auf den Baum?\n");
   if (!str) return 0;
      
   race = TP->QueryProp(P_RACE);
   
  if ( str=="nach oben" ||
        str=="rauf" ||
        str=="auf den baum"||
        str=="hinauf" ||
        str=="oben"||
        str=="auf baum"||
        str=="auf baum hinauf"||
        str=="in baum"||
        str=="zum baum" )
    {     
    switch(race)
      {
      case "Elf":
        {
        tell_object(TP, BS("Du kletterst geschickt auf Baum, so wie Du es schon viele "+
              "male gemacht hast. "));
        TP->move(ROOM"baum_B-06.lpc", M_GO, "klettert geschickt auf einen Baum.");
        return 1;
        }
      default:
        {
        tell_object(TP, BS("Du kletterst mit etwas Muehe auf den Baum, schaffst es "+
              "aber ohne groessere Probleme raufzukommen. "));
        TP->move(ROOM"baum_B-06.lpc", M_GO, "klettert auf einen Baum.");
        return 1;
        }
      }
    }
  else
    return 0;
  if ( str=="nach unten" ||
       str=="runter" ||
       str=="raus")
  {
       tell_object(TP, BS("Da must Du zuerst schon raufklettern... "));
  }
}
  

