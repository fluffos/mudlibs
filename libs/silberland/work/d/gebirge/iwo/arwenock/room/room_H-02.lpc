
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer engen Gasse in Arwenock");
  SetProp(P_INT_LONG, BS(
          "Du wandelst in einer engen Gasse am Ostende des kleinen"
         +" Staedtchens Arwenock. Oestlich von Dir ist die hohe"
         +" Stadtmauer, im Westen blickst Du auf ein zweistoeckiges"
         +" Haus."));
  AddDetail("boden", BS(
            "Auf dem Boden erkennst Du quadratische Pflastersteine,"
           +" praktisch ohne grosse Fugen verlegt, direkt meisterlich"
           +" verarbeitet."));
  AddDetail(({"fuge", "fugen"}), BS(
            "Das Pflaster ist wirklich ohne Fugen verlegt. Sehr"
           +" sauber gearbeitet, beurteilst Du bei genauerem"
           +" Hinsehen."));
  AddDetail("hinsehen", BS(
            "Du blickst noch genauer und entdeckst tatsaechlich statt"
           +" einer Fuge eine winzige Ritze. Da hat doch tatsaechlich"
           +" der Pflastermeister schlampig gearbeitet."));
  AddDetail(({"meister", "pflastermeister"}), BS(
            "Alles in allem betrachtet hat der Pflastermeister der"
           +" Stadt sehr gut gearbeitet."));
  AddDetail(({"stadt", "arwenock", "kleinstadt", "staedtchen"}), BS(
            "Du befindest Dich gerade in der Kleinstadt Arwenock."));
  AddDetail("ritze", BS(
            "Du untersuchst die Ritze genauer und stellst fest, dass"
           +" sich ein Loewenzahnsamen hierherverirrt hat, denn aus"
           +" der Ritze waechst ein winziges Loewenzahnpflaenzchen."));
  AddDetail(({"samen", "dinger", "loewenzahnsamen"}), BS(
            "Diese Dinger sind ja nicht auszuhalten, ueberall verirren"
           +" sie sich hin und schlagen Wurzeln."));
  AddDetail("wurzeln", BS(
            "Selbst hier in dieser winzigen Ritze hat sich ein Loewenzahnsamen"
           +" eingenistet und Wurzeln geschlagen."));
  AddDetail(({"pflaenzchen", "loewenzahnpflaenzchen", "loewenzahn"}), BS(
            "Das kleine Pflaenzchen ist noch zu klein um es auszureissen."
           +" Aber wozu braeuchtest Du es auch..."));
  AddDetail("gasse", BS(
            "Du befindest Dich in einer engen Gasse die ganz im Osten"
           +" der Stadt den Norden mit dem Sueden verbindet."));
  AddDetail(({"mauer", "stadtmauer"}), BS(
            "Hoch ragt sie auf neben Dir, die Stadtmauer. Sie scheint"
           +" wirklich jeder Macht zu trotzden, die das Staedtchen"
           +" Arwenock jemals bedrohen koennte."));
  AddDetail("macht", BS(
            "Du denkst schaudernd an alles moegliche Boese was Dir"
           +" einfaellt, jedoch glaubst Du kaum, dass irgendetwas"
           +" derartiges diese Stadtmauer einfach vernichten koennte."));
  AddDetail(({"boese", "boeses"}), BS(
            "Noch mal Glueck gehabt... es ist nix Boeses da."));
  AddDetail("glueck", BS(
            "Froehlich pfeifst Du ein Liedchen vor Dich hin. Soooo viel"
           +" Glueck hat man doch nicht alle Tage!"));
  AddSpecialDetail(({"tag", "tage"}), "day");
  AddSpecialDetail("liedchen", "song");
  AddDetail("haus", BS(
            "Bei dem haus westlich von Dir handelt es sich um einen"
           +" massiven Fachwerkbau mit einem schoenen Dach."));
  AddDetail(({"bauten", "fachwerkbauten", "bau", "fachwerkbau"}), BS(
            "Du traust Dich nicht zu schaetzen wie alt dieses Haus"
           +" wirklich ist, denn Fachwerkbauten koennen ueber Jahrhunderte"
           +" stehen."));
  AddDetail("jahrhunderte", BS(
            "Du ueberlegst, wie viele Jahrhunderte dieses Haus westlich"
           +" von Dir schon auf dem Buckel haben mag."));
  AddDetail("buckel", BS(
            "Nunja, einen Buckel hat das Haus ja nun wirklich nicht."));
  AddCmd(({"schaetz", "schaetze"}), "house_age");
  AddDetail("jahre", BS(
            "Es sind schon viele Jahre ins Land gegangen seit dieses"
           +" Haus gebaut wurde."));
  AddDetail(({"silberland", "land"}), BS(
            "Tja, Du befindest Dich hier im Silberland."));
  AddDetail("dach", BS(
            "Sosehr Du Dich anstrengst, nach oben zu blicken, Du"
           +" kannst nicht auf das Dach sehen, es ist zu hoch oben."));
  AddDetail(({"ende", "ostende"}), BS(
            "Du befindest Dich am oestlichen Ende der Stadt Arwenock."));
  AddDetail("himmel", BS(
            "Schoooooooeeen blau. So ein gutes Wetter!"));
  AddDetail("wetter", BS(
            "Das Wetter laedt richtig zum Forschen ein."));
  AddDetail("forschen", BS(
            "Deswegen bist Du doch hier oder?"));
  AddDetail(({"naegel", "bilder", "beispiel", "bild", "wand", "nagel"}), BS(
            "Naegel dienen zum Beispiel dazu, Bilder an die Wand zu haengen."));
  AddDetail(({"inneren", "inneres"}), BS(
            "Wenn es Dich interessiert, was in dem Haus ist, so geh doch"
           +" hinein."));
  AddSound(DEFAULT_SOUND, BS(
           "Du lauscht angestrengt, und stellst fest, dass ein sanftes"
          +" Haemmern aus dem Inneren des Hauses westlich von Dir"
          +" dringt."));
  AddSound("haemmern", BS(
           "Vermutlich arbeitet jemand im Haus und haut einen Nagel in"
          +" die Wand um ein Bild aufzuhaengen."));
  AddSmell(DEFAULT_SMELL, BS(
           "Zuviele Gerueche hier. Du kannst Dich nicht auf einen"
          +" einzelnen konzentrieren."));
  AddSmell("gerueche", BS(
           "Alles Moegliche riecht hier nach irgendwas. Du bist zu"
          +" faul um Dich auf etwas Bestimmtes zu konzentrieren."));
  
  AddExit( "norden", ROOM "room_H-03" );
  AddExit( "sueden", ROOM "room_H-01" );

}

day()
{
  string d;
  
  d=explode(dtime(time()), ",")[0];
  switch (d) {
    case "Son": d="Sonntag"; break;
    case "Mon": d="Montag"; break;
    case "Die": d="Dienstag"; break;
    case "Mit": d="Mittwoch"; break;
    case "Don": d="Donnerstag"; break;
    case "Fre": d="Freitag"; break;
    case "Sam": d="Samstag"; break;
  }
  return BS("Du denkst nach und stellst fest: Heute ist "+d+".");
}

song()
{
  string s;
  
  s="Du pfeifst irgendetwas ";
  switch(random(8)) {
    case 0: s+="italienisches."; break;
    case 1: s+="modernes."; break;
    case 2: s+="unbekanntes."; break;
    case 3: s+="von ... wie hiess er denn noch..."; break;
    case 4: s+="flottes."; break;
    case 5: s+="langsames."; break;
    case 6: s+="beschwingtes."; break;
    case 7: s+="von Dir selber komponiertes."; break;
  }
  return BS(s);
}

house_age(str)
{
  if (!str || (str!="haus" && str!="bau" && str!="fachwerkbau"))
    return 0;
  write(BS(sprintf("Du bist Dir nicht sicher, aber Du schaetzt das Haus"
       +" auf circa...... %d Jahre.", random(250)+50)));
  return 1;
}

