#ifndef WIZNAME
#define WIZNAME "bastard"
#endif


inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

#include "../def.h"


void create()
{

  //closure light;
  
  //light = lambda(0, ({#'return, ({#'call_other, AMASTER, "getlight"})}));

  ::create();

  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep");
  SetProp( P_INT_SHORT, sprintf("Irgendwo in %s", STADT));
  SetProp( P_INT_LONG,
           sprintf("Du bist irgendwo im schoenen Staedtchen %s.", STADT));
             

  //  SetProp( P_LIGHT, #'call_other, AMASTER, "givelight");	   
  SetProp (P_LIGHT, 1);
  SetProp( P_INDOORS, 0 );

  /*
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: ({ #'call_other, AMASTER, "givelight" }),
                            ENV_TERRAIN: TT_TOWN]) );
  */

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21,
                           ENV_TERRAIN: TT_HOUSE]) );
}

void reset()
{
  if (AMASTER->EventActive()) return;
  ::reset();
}
