/*
** Postzentrale in Arwenock
** Kopie vom Postamt MIDAS
** ---
** 1996-01-27  Woody  Release
*/

#define WIZNAME "iwo"

inherit "/std/post";

#include <properties.h>
#include "../def.h"

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, sprintf("Postzentrale von %s", STADT));
  SetProp (P_INT_LONG, 
    "Dies hier ist das kleine Postamt von Arwenock. "+
    "Von hier aus kannst Du Briefe an Deine Mitspieler schicken und "+
    "Briefe von ihnen lesen. Wenn Du das willst, tippe \"post\". "+
    "Ruhe vor anderen Anwesenden und dem typischen Stimmengemurmel in "+
    "einer Post hast Du, wenn Du eine der Ein-Personen-Kabinen betrittst. "+
    "Nach Sueden gelangst Du auf die Strasse zurueck.");

  AddDetail ( ({"wand", "waende"}), "Die Waende sind gelb.\n");
  AddDetail ( "decke", "Die Decke ist gelb.\n");
  AddDetail ( "boden", "Der Boden ist gelb.\n");
  AddDetail ( "kabinen", "Sie sind gelb. Wie alles hier.\n");

  AddSound (DEFAULT_SOUND, "Stimmengemurmel erfuellt den Raum.\n");
  AddSound ( ({"stimmen","gemurmel","stimmengemurmel"}),
    "Einfach nur wirres Stimmengemurmel, Inhalte kriegst Du nicht mit.\n");
  AddSound ( ({"inhalte"}),
    "Jemand sagt: Rhabarber Hnzlegrmpf!\n"
    "Du fuehlst Dich klueger.\n");

  AddExit("sueden", ROOM "room_F-05");
  AddItem("/std/postschalter");
}
