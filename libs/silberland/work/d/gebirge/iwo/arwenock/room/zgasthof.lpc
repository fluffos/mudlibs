/*
**    Gasthof in Arwenock mit Quax als Wirt
**
**    Zaknafein, Mai 2001
**
*/

#include "../def.h"
inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <pub.h>

#define WIZNAME "zaknafein"

int geld=1;

create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Gasthof 'Zur taenzelnden Zwergin'");

  SetProp (P_INT_LONG, "Du fuehlst Dich in diesem Gasthof sehr wohl. Die geschmackvolle "
                      +"Einrichtung und die dezente Musik einer Band sorgen fuer eine "
                      +"sehr angenehme Atmosphaere. Im hinteren Teil des Gasthofes tanzt eine "
                      +"Zwergin auf einer kleinen, runden Buehne. Um die tanzende Zwergin "
                      +"herum stehen einige Gaeste und spenden ihr begeisterten Beifall. "
                      +"@@wirt_func@@"); 

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "quax");
  SetProp(P_PUBKEEPER_NAME, "quax");
  SetProp(P_PUBMSG_NOKEEPER, "Quax, der Wirt, ist nicht da. Wer den wohl wieder gekillt hat?\n");
  SetProp(P_PUBMSG_NOENEMY, "Denkst Du, Quax ist so bloed und bedient Dich?\n");
  SetProp(P_PUBMSG_NOINVITE, "Ne, Quax bedient wohl kaum seine Feinde.\n");
  SetProp(P_PUBMSG_FIGHTING, "Merkst Du nicht, dass Quax gerade beschaeftigt ist?\n");

  AddDetail ( ({"quax","wirt"}), 
    "Ups, wo ist der denn hin? Hoffentlich hat ihn niemand umgelegt...\n");
  AddDetail ( "theke", 
    "An der Theke haengt eine Speisekarte und hinter der Theke stehen einige Regale.\n");
  AddDetail ("regale", 
    "In den Regalen bewahrt Quax Glaeser und Spirituosen auf.\n");
  AddDetail ( ({ "spirituose" , "spirituosen" }), 
    "Die Spirituosen bewahrt Quax in einem kleinen Regal hinter der Theke auf.\n");
  AddDetail ( ({"glas","glaeser"}), 
    "Sie sind sehr sauber. Quax ist was das angeht sehr gewissenhaft.\n");
  AddDetail ("regal", 
    "Neben dem Regal steht die Kasse.\n");
  AddDetail ("kasse", 
    "Hui, in der Kasse befindet sich sicher ein Haufen Kohle und wohl auch ein paar Schuldscheine.\n");
  AddDetail ( ({"kohle","schotter","kies","moneten", "zaster", "Bares" , "bargeld" , "geld" }), 
    "Kohle, Schotter, Kies, Moneten, Zaster, Bares, ... Du weisst schon.\n");
  AddDetail ("haufen", 
    "Also eher viel...\n");
  AddDetail ( ({"scheine","schuldscheine", "schuldschein" , "schein" }), 
    "Schuldscheine sind nur fast so gut wie Bargeld.\n");
  AddDetail ( ({ "karte" , "speisekarte" }), 
    "Mit 'menue' kannst Du sie lesen.\n");
  AddDetail ( ({"einrichtung","moebel"}), 
    "Wirklich sehr geschmackvoll. Die Gaststaette ist auch gut besucht. Fast alle "
   +"Tische sind besetzt.\n");
  AddDetail ( ({"tisch","tische"}), 
    "An den Tischen sitzen zahlreiche Gaeste und geniessen ihre Speisen.\n");
  AddDetail ( ({"speisen","speise"}), 
    "Na, bekommst Du auch schon Hunger?\n");
  AddDetail ( "hunger" , 
    "Wenn Du 'menue' eingibst, bekommst Du eine Speisekarte.\n");
  AddDetail ( ({"gast","gaeste"}), 
    "Die meisten Gaeste essen gerade, aber einige haben sich um die tanzende Zwergin "
   +"versammelt und schauen ihrem Tanz begeistert zu.\n");
  AddDetail( ({ "tanz" }),
    "Fuer eine Zwergin tanzt sie ganz schoen sexy. Ziemlich schwer bei der miserablen Musik.");
  AddDetail ( ({"staette","gaststaette"}), 
    "Wegen der angenehmen Musik und der gemuetlichen Atmosphaere fuehlst Du Dich hier sehr wohl.\n");

  AddDetail( ({ "wand", "waende" }),
    "Die Waende hier zeigen keinerlei Besonderheiten.");
  AddDetail( ({ "besonderheiten" }),
    "Der ganze Gasthof ist besonders.");

  AddDetail( ({ "boden" }),
    "Massive Holzdielen bilden den ebenso massiven Boden.");
  AddDetail( ({ "holzdielen", "dielen" }),
    "Sauber verlegte, massive Holzdielen.");
  
  AddDetail( ({ "gasthof" }), 
    "Du befindest Dich im Gasthof 'Zur taenzelnden Zwergin'.");

  AddDetail( ({ "atmosphaere" }),
     "Die Atmosphaere ist ganz gut hier. Etwas stickig vielleicht.");

  AddDetail( ({ "band" }),
    "Naja, Band ist vielleicht etwas uebertrieben. Ein einsamer "
    "Minnesaenger hockt auf einem dreibeinigen Schemel, und klaempert "
    "sich an seiner voellig verstimmten Laute einen runter.");
  AddDetail( ({ "minnesaenger" }),
    "Er wirkt etwas vergammelt, und von Musik scheint er auch keine Ahnung zu "
    "haben.");
  AddDetail( ({ "musik" }),
    "Naja, Musik kann man das eigentlich nicht nennen, stimmt.");
  AddDetail( ({ "schemel" }),
    "Ein rundes Stueck Holz mit drei Beinen.");
  AddDetail( ({ "beine" }),
    "Du schaust auf Deine krummen Beine, und stellst fest, dass Du nicht "
    "immer so schwere Ruestungen tragen solltest.");
  AddDetail( ({ "ruestung" , "ruestungen" }),
    "Sie geben Dir Schutz. Sie koennen aber auch krumme Beine verursachen ...");
  AddDetail( ({ "schutz" }),
    "Wenn Du Schutz suchst, krieche unter den Rock Deiner Mutter!");
  AddDetail( ({ "rock" , "mutter" }),
    "Ja, dort fuehltest Du Dich richtig geborgen...");
  AddDetail( ({ "laute" }),
    "Spaeter wurde dann mal eine Harfe daraus.");
  AddDetail( ({ "harfe" }),
    "Frag Anvar, der hat damit was zu tun.");
  AddDetail( ({ "anvar", "druiden", "steinkreis" }),
    "Schauts hier aus wie im Steinkreis der Druiden?");
  AddDetail( ({"holz"}),
    "Ein universelles Baumaterial aus Baeumen.");
  AddDetail( ({ "baumaterial" }),
    "Holz ist eines.");
  AddDetail( ({ "baeumen", "baeume" }),
    "Siehst Du hier nicht, nur tote - genannt Holz.");
  AddDetail( ({ "buehne" }),
    "Ein paar erschreckend schleissig zusammengeschusterte Bretter bilden "
    "eine Art Buehne. Du hoffst, dass der grottenschlechte Minnesaenger "
    "irgendwann durchbricht, und sich dabei den Hals bricht.");
  AddDetail( ({ "hals" }),
    "Bist Du ein Vampir?");
  AddDetail( ({ "vampir" }),
    "Diesbezueglich solltest Du mit dem Herrn des Jenseits 'Dante' in Kontakt treten.");
  AddDetail( ({ "jenseits" }),
    "Ein Vampir z.B. befoerdert Dich sicher gerne dahin.");
  AddDetail( ({ "kontakt" }),
    "Den wirst Du hier kaum finden.");
  AddDetail( ({ "dante" , "herrn" }),
    "Such ihn, und Du wirst nichts finden!");
  AddDetail( ({ "ahnung" }),
    "Haettest Du jetzt gerne?");
  AddDetail( ({ "art" }),
    "So eine!");
  AddDetail( ({ "beifall" }),
    "Beifall insofern, dass faule Tomaten und Eier erschreckend nahe der "
    "Augenhoehe in einer zuegigen, horizontalen Vorwaertsbewegung durch "
    "den Raum in Richtung Buehne fliegen.");
  AddDetail( ({ "raum" }),
    "Du stehst in ihm.");
  AddDetail( ({ "Vorwaertsbewegung" }),
    "Passe auf, dass Du nicht getroffen wirst!");
  AddDetail( ({ "stueck", "teil" }),
    "Ein Teil des Ganzen.");
  AddDetail( ({ "ganzes","ganzen" }),
    "Alle Teile ergeben ein Ganzes.");
  AddDetail( ({ "augenhoehe" }),
    "Naja, vielleicht in der eines Zwerges... wer weiss, was ein Troll in "
    "dieser Hoehe hat.");
  AddDetail( ({ "hoehe" , "troll","sachen" }),
    "Du wirst hier keine Sachen lesen koennen, die nicht jugendfrei sind!");
  AddDetail( ({ "zwerg","zwerges","zwerge" }),
    "Auch Zwerge kommen gelegentlich nach Arwenock.");
  AddDetail( ({ "decke", "holzdecke" }),
    "Vom Rauch geschwaerzte Bretter bilden die Holzdecke.");
  AddDetail( ({ "luft" }),
    "Erstaunlich, aber hier kann man die Luft sogar sehen. Unmengen "
    "von Rauch geben ihr einen Koerper.");
  AddDetail( ({ "koerper" }),
    "Etwas, dass man anfassen kann.");
  AddDetail( ({ "unmengen" }),
    "Sehr viel.");
  AddDetail( ({ "rauch" }),
    "Der Rauch kommt von den vielen Zigaretten.");
  AddDetail( ({ "zigaretten","zigarette" }),
    "Die Zigaretten verpesten hier die Luft.");
  AddDetail( ({ "bretter" }),
    "Die Bretter stammen von den umliegenden Baeumen.");
  AddDetail( ({ "eier", "tomaten" }),
    "Fliegen ziemlich tief heute :-)");
  AddDetail( ({ "ohren" }),
    "Die fallen Dir gleich ab. Ziemlich grausig die Musik.");  
  AddDetail( ({ "arwenock" , "stadt"  }),
    "Arwenock ist wirklich eine schoene Stadt!"); 
  AddDetail( ({ "zwergin" }),
    "Viele Gaeste stehen um die tanzende Zwergin herum und schauen ihr gebannt zu.");
  AddReadDetail ( ({"karte","speisekarte"}), 
    "Gib doch einfach 'menue' ein.\n");

 

  AddSmell ( DEFAULT_SMELL, 
    "Sehr dicke Luft hier.");
  AddSound (DEFAULT_SOUND,
    "Das Gejaule des Minnesaengers betaeubt Deine Ohren.\n");
  AddSound ( ({ "gejaule" }),
    "Echt erbaermlich.\n");

  AddDrink("Ein Glas kalte Milch", ({ "glas" , "milch" }) ,
    150, ({ 10,10,10 }), 0, 4, 
    ({"Quax grinst Dich an und bruellt laut durch die Kneipe: "
      "'Ein Glas Milch fuer den Helden hier bitte!' Erroetet nimmst Du das Glas an Dich und "
      "und trinkst es schnell aus. Hoffentlich hat das keiner gesehen...", 
      "&&, das Weichei, trinkt ein Glas kalte Milch. Du musst grinsen."}) );

  AddDrink("Ein kuehles Pils", "pils" ,
    250, ({ 20,20,10 }), 3, 3, 
    ({"Quax zapft Dir ein frisches, kuehles Pils und bringt es Dir. "
      "Du kannst Dich nicht zurueckhalten und trinkst es sofort aus. Leider musst Du davon ruelpsen...", 
      "&& bekommt von Quax ein kuehles Pils serviert und trinkt es gierig aus."}) );

  AddDrink("Ein herber Martini dry", ({ "Martini dry" , "martini" , "dry" }) ,
    530, ({ 10,10,2 }), 3, -2, 
    ({"Quax grinst Dich an, zueckt seinen Shaker und mixt Dir einen Martini dry."
      "1 cl Vermouth dry, 4 cl Gin, zum Schluss eine gruene Olive und fertig! Mit einem "
      "Schluck ist er weg. Und nun noch die Olive. Du bekommst gleich Lust auf einen "
      "neuen.", 
      "&& geniesst einen Martini dry."}) );

  AddFood("Ein deftiger Kartoffelauflauf", ({"kartoffelauflauf","auflauf"}),    
  220, ({30,30,10}), 11, ({      
     "Quax serviert Dir einen wunderbar duftenden Kartoffelauflauf, auf den " 
     "Du Dich sofort gierig stuerzt. Nach kurzer Zeit ist davon nichts mehr uebrig.",  
     "Quax serviert && einen wunderbar duftenden Kartoffelauslauf, den && sofort verputzt." }) );

  AddFood("Frisch gemetzeltes Drachengehirn", ({"hirn","drachengehirn","gehirn"}),    
  750, ({50,50,10}), 22, ({      
     "Quax stellt einen Topf auf den Herd, schaufelt etwas Gehirn rein und schmeckt es noch " 
     "mit viel Salz ab. Kurz aufkochen, einmal umruehren und fertig! Du fragst Dich noch, ob "
     "Du das Zeugs wirklich essen solltest, aber Du hast ja schliesslich schon bezahlt...",  
     "&& wuergt in heldenhafter Manier einen Topf voll Drachenhirn runter." }) );

  AddCmd( "oeffne", "oeffnen" );

  AddItem (NPC "zwirt", REFRESH_DESTRUCT);

  AddExit ("sueden", ROOM "room_C-05");
}

string wirt_func()
   {
    if (present("\nzwirt"))
     return("Hinter der Theke steht der Wirt dieses Gasthofes und \nschaut Dich aufmerksam an.");
    else
     return("Merkwuerdig ist nur, dass hinter der Theke niemand \nsteht. Wo ist nur der Wirt?");
   }

oeffnen( str )
{
notify_fail( "Was moechstest Du oeffnen?\n" );
if( str == "kasse" || str == "die kasse" )
	{
           object ob;
	   object obj1;
	   object obj2;
   
  	   if (ob=present(("\nzwirt"), this_object()))
    		{
   		 write("Glaubst Du nicht, dass Quax was dagegen haette?\n");
        	}
           else
		{
		tell_room(environment(this_player()), 
			capitalize(this_player()->Name())+" macht sich an der Kasse zu schaffen.\n", ({this_player() }));
		write(BS("Unbemerkt von den anderen Gaesten oeffnest Du die Kasse..."));
	           if(geld==1) 
		    {
                      this_player()->AddMoney(random(5000));
		      write("Du findest etwas Geld");
		      geld=0;
	            }
	            else
	              write("Du findest eine enorme Menge an Luft");
   
		    if(obj1=present(("\narwqi"), this_player()))
		      { 
                 	if(obj1->queryspielstand()==1) 
			{
                 	  if(obj2=deep_present(("\nzakschein"), this_player()))
			    write(", aber sonst leider nichts");
			  else 
		            {
			      clone_object(OBJ "zschein" )->move(this_player(), M_NOCHECK);
                              write(" und einen Schuldschein"); 
			    }
			}
		      }
		    write(".\n"); 
		} 
           return 1;
        }
return 0;	 
}

reset()
{
  ::reset();
  geld=1;
}
