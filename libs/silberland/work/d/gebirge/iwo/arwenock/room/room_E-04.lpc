/*
**    Hier befindet sich das (versteckte) Sehertor von Arwenock
**
**    (Bei dem Blumenmaedchen in diesem Raum beginnt die 
**     'Mini-Quest', die man machen muss, um das Tor zu finden.)
**
**                 Zaknafein, Februar 2000
*/

#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#define WIZNAME "zaknafein"

create()
{
  ::create();
  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_TOWN])); 
  SetProp(P_INT_SHORT, "Vor dem Tempel in Arwenock" );
  SetProp(P_INT_LONG,
    "Du befindest Dich nun so ziemlich in der Mitte Arwenocks. Im Osten "
   +"befindet sich der prunkvolle Tempel, der eines der auffaelligsten "
   +"Gebaeude hier in Arwenock ist. Folgst Du der Strasse nach Westen, so "
   +"gelangst Du zum Marktplatz, auf dem eine furchterregende Guillotine "
   +"steht. Auf der Strasse herrscht reges Treiben. Zahlreiche Passanten "
   +"und Haendler eilen an Dir vorbei. Am Rande der Strasse steht ein "
   +"kleiner Blumenstand, hinter dem ein suesses Maedchen ihre Blumen "
   +"anpreist.");

  AddDetail( ({ "paradies" , "handelsparadies" }) ,
    "Hier kann man wohl fast alles kaufen.\n");
  AddDetail( ({ "worten" , "treiben" }) ,
    "Mit anderen Worten: Es ist viel los hier!\n");
  AddDetail( "guillotine" ,
    "Du solltest aufpassen, nicht den Kopf zu verlieren.\n");
  AddDetail( "kopf" ,
    "Du stellst beruhigt fest, dass er noch auf Deinem Hals sitzt.\n");
  AddDetail( "hals",
    "Das kann sich aber schnell aendern, wenn Du unschuldige Passanten oder "
   +"Stadtwachen angreifst.\n");
  AddDetail( ({ "wachen" , "wache" , "stadtwache" , "stadtwachen" }) ,
    "Schaue Dich mal um. Arwenock wird gut bewacht.\n");
  AddDetail( "strasse" ,
    "Diese belebte Strasse fuert von Osten nach Westen. Oder umgekehrt? Hmmm.\n");
  AddDetail( ({ "platz" , "marktplatz" }) ,
    "Auf dem Marktplatz bieten zahlreiche Haendler ihre Waren an.\n");
  AddDetail( ({ "ware" , "waren" }) ,
    "Du musst schon hingehen, um zu erkennen, was sie anbieten.\n");
  AddDetail( "haendler" ,
    "Haendler gibt es hier wie Sand am Meer, das Arwenock ueberall als Handelsparadies "
   +"bekannt ist.\n");
  AddDetail( ({ "sand" , "meer" }) ,
    "Das sagt man halt so...\n");
  AddDetail( "passanten"  ,
    "Die Passanten machen wohl hier eilig ihre Einkaeufe.\n");
  AddDetail( ({ "einkaeufe" , "einkauf" }) ,
    "Man kann hier fast an jeder Ecke sein Geld ausgeben.\n");
  AddDetail( ({ "ecke" , "geld" }) ,
    "Packt Dich auch schon die Einkaufswut?\n");
  AddDetail( ({ "wut" , "einkaufswut" }) ,
    "Ne, eher die Forscherwut.\n");
  AddDetail( "forscherwut"  ,
    "Was hiermit bewiesen ist. ;)\n");
  AddDetail( ({ "rand" , "rande" }) ,
    "Dort steht ein kleienr Blumenstand.\n");
  AddDetail( ({ "blumenstrauss"  , "strauss" , "straeusse" , "blumenstraeusse" , "blumen" }) ,
    "Moechtest Du etwa einen Blumenstrauss kaeuflich erwerben? Die Blumen sehen "
   +"wirklich wunderbar aus und duften herrlich.\n");
  AddDetail( ({ "blumenmaedchen" , "maedchen" }) ,
    "Hm, ist es nicht da?\n");
  AddDetail( ({ "stand" , "blumenstand" }) ,
    "Auf dem Blumenstand liegen zahlreiche Blumen, aus denen das Blumenmaedchen "
   +"wunderschoene Blumenstraeusse zusammenstellt.\n");
  AddDetail( ({ "arwenocks" , "arwenock" , "mitte" }) ,
    "Du muesstest Dich so ziemlich in der Mitte Arwenocks befinden.\n"); 
  AddDetail( "himmel" ,
    "Du siehst einen strahlend blauen Himmel.\n");
  AddDetail( "boden" ,
    "Pflastersteine bedecken den Boden.\n");
  AddDetail( ({ "steine" , "pflaster" , "pflastersteine" }) ,
    "Die Pflastersteine wurden recht ordentlich verlegt, sodass niemand ueber "
   +"sie stolpern kann.\n");
  AddDetail( "tempel" ,
    "Der Tempel wirkt auserordentlich prunkvoll. Du moechtest ihn am liebsten mal aus "
   +"aus der Naehe betrachten.\n");
  AddDetail( ({ "naehe" , "nah" }) ,
    "Gehe doch naeher an den Tempel ran.\n");
  AddDetail( "gebaeude"  ,
    "Ich meine den Tempel. Aber auch das Museum, das suedlich von Dir liegt, ist "
   +"sicher einen Besuch wert.\n");
  AddDetail( ({ "museum" , "besuch" }) ,
    "Naja, eigentlich moechtest Du lieber metzeln, als das Museum zu besichtigen. Hm, "
   +"es soll aber ein Waffenmuseum sein. Vielleicht lohnt es sich doch?\n");
  AddDetail( "waffenmuseum",
    "Das Waffenmuseum liegt suedlich von hier.\n");
  AddDetail(  "osten"  ,
    "Gehst Du weiter nach Osten, so gelangst Du zum Tempel.\n");
  AddDetail( "westen",
    "Westlich von Dir liegt der Marktplatz.\n");

 
  AddSmell( DEFAULT_SMELL , "Der Duft frischer Blumen liegt in der Luft.\n");
  AddSmell( ({ "duft" , "blumen" , "luft" }) ,
            "Es riecht einfach wunderbar.\n");
  AddSound( DEFAULT_SOUND , "Es ist recht laut hier. Du hoerst zahlreiche Stimmen von den "
                           +"Passanten und den Haendlern hier.\n");
  AddSound( "stimmen" ,
            "Du kannst nichts besonderes verstehen.\n");
 
  AddItem( "/obj/sehertor", REFRESH_NONE, (["rw_sehertor_disc": 0]) );
  AddItem(NPC "zmaedchen" , REFRESH_REMOVE,([P_AGGRESSIVE:0]));
 
  AddExit( "osten",  ROOM "room_F-04" );
  AddExit( "westen", ROOM "room_D-04" );

}
