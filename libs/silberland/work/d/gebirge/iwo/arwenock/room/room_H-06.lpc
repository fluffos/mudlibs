
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du befindest Dich am Ostweg. Er fuehrt vom Norden in den Sueden "
    "und - wenn man so will - auch wieder zurueck. Hier wird der Weg "
    "schon relativ schmal, und durch die hohen Haeuser laesst auch "
    "das Licht etwas nach. Hier koennten sich vielleicht sogar "
    "dunkle Gestalten herumtreiben.");
  AddDetail( ({ "ostweg" }),
    "Darauf befindest Du Dich.");
  AddDetail( ({ "norden", "sueden" }),
    "Das sieht man nicht.");
  AddDetail( ({ "weg" }),
    "Der Weg auf dem Du Dich befindest nennt sich Ostweg.");
  AddDetail( ({ "haeuser", "haeusern" }),
    "Die Haeuser hier sind relativ hoch, und schirmen viel "
    "des Sonnenlichtes ab.");
  AddDetail( ({ "sonnenlichtes", "sonnenlicht", "licht" }),
    "Viel davon wird von den Haeusern abgeschirmt.");
  AddDetail( ({ "gestalten" }),
    "Dunkle Gestalten haben die ungute Eigenschaft sich "
    "recht gut zu verbergen.");

  AddExit( "norden", ROOM "room_H-07" );
  AddExit( "sueden", ROOM "room_H-05" );

}
