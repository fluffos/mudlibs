
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();

  SetProp(P_INT_LONG,
   "Nach Norden geht es hier in die 'taenzelnde Zwergin' waehrend "
   "suedlich von Dir der Marktplatz liegt. Geplauder dringt von "
   "ueberall an Dein Ohr. Irgendwie geluestet Dir nach einem Abstecher "
   "in die hiesige Kneipe.");

  AddDetail( ({ "kneipe", "zwergin" }),
    "Geh' doch einfach mal rein?");
  AddDetail( ({ "marktplatz", "markt" }),
    "Viel mehr, als die Marktstaende kannst Du von hier aus nicht "
    "erkennen.");
  AddDetail( ({ "marktstaende", "staende" }),
    "Um sie genauer zu betrachen, musst Du naeher ran gehen.");
  AddDetail( ({ "geplauder" }),
    "Das kann man nur hoeren, nicht aber sehen.");
  AddDetail( ({ "ohr" }),
    "Verzweifelt versuchst Du auf Dein Ohr zu schielen, was Dir aber "
    "nicht so recht gelingt. Macht sicher einen amuesanten Eindruck.");
  AddDetail( ({ "eindruck" }),
    "Wie peinlich :-)");
  AddDetail( ({ "abstecher" }),
    "Damit meint man etweder einen Dolch, oder einen kurzen Besuch.");


  AddExit( "osten",  ROOM "room_D-05" );
  AddExit( "westen", ROOM "room_B-05" );
  AddExit( "norden", ROOM "zgasthof" );
  AddExit( "sueden", ROOM "room_C-04" ); 

}
