
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Dieser Weg bringt Dich vom Marktplatz nach osten zum "
    "Ostweg, oder zurueck. Staendig huscht irgendwer vorbei, "
    "stoesst und rempelt Dich, dass Dir garnicht so wohl ist "
    "in Deiner Haut. Vielleicht solltest Du gut Acht geben auf "
    "Deine Sachen. Man kann ja nie wissen, ob nicht etwas "
    "wegkommt. Nach Norden kannst Du Gorwans Laden betreten, "
    "und weiter oestlich glaubst Du das Postamt zu erkennen.");

  AddDetail( ({ "platz", "marktplatz" }),
    "Er befindet sich weiter westlich. Um etwas zu erkennen, "
    "musst Du wohl naeher ran gehen.");
    
  AddDetail( ({ "ostweg" }),
    "Es ist erstaunlich aber wahr - Der Ostweg liegt im Osten.");
    
  AddDetail( ({ "haut" }),
    "Deine Haut wirkt etwas rauh. Du solltest sie wohl mit "
    "Drachenfett behalndeln.");
    
  AddDetail( ({ "drachenfett", "fett" }),
    "Dazu musst Du wohl erst einen fetten Drachen finden.");
    
  AddDetail( ({ "drache", "drachen" }),
    "Hier mitten in der Stadt wird wohl kaum einer sein?!");
    
  AddDetail( ({ "sachen" }),
    "Ja, es kann leicht passieren, dass Du ploetzlich nichtmehr alle "
    "bei Dir hast. Sei also vorsichtig!");
    
  AddDetail( ({ "gorwan" }),
    "Er wird wohl in seinem Laden sein.");
    
  AddDetail( ({ "laden" }),
    "Du kannst nach Norden reingehen, und Dich mal umsehen.");
    
  AddDetail( ({ "acht" }),
    "Jo, solltest Du dringend geben.");
    
  AddDetail( ({ "postamt", "amt" }),
    "Geh halt mal naeher ran!");

  AddExit( "osten",  ROOM "room_F-05" );
  AddExit( "westen", ROOM "room_D-05" );
  AddExit( "norden", ROOM "room_E-06" ); 

  AddItem(NPC "jarlaxle", REFRESH_DESTRUCT);

}
