
#include "../def.h"

inherit STDROOM;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
// #include "files.h"

#define P_DONATED "donated"
#define P_NODONATE "nodonate"
#define P_DONATED_VALUE "donated_value"

create()
{
  ::create();

  seteuid(getuid(this_object()));

  SetProp(P_INT_SHORT, "In einer Grotte");

  SetProp(P_INDOORS, 1);
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_LIGHT, 0);

  SetProp(P_INT_LONG, "Hier ist es gerade hoch genug, um aufrecht "
    "zu stehen. Eine kleine Quelle am Ende der Grotte plaetschert "
    "leise vor sich hin. Hier scheint nichts von Abenteurerhand "
    "bearbeitet zu sein. Rechts neben der Quelle bildet ein Felsen "
    "eine Art Ablage, waehrend auf der anderen Seite verschwindet "
    "das Quellwasser "
    "in einem finsteren Loch verschwindet. Knapp ueber dem Boden "
    "liegt beinahe wie Nebel eine blaeulich schimmernde Schicht.");

  AddDetail( ({ "quelle" }),
    "Aus einer kleinen Oeffnung in einer der felsigen Waende "
    "sprudelt froehlich frisches Quellwasser.");
  AddDetail( ({ "oeffnung" }),
    "Die Oeffnung ist gerade mal gross genug um dem Wasser Platz "
    "zum Ausdringen zu bieten.");
  AddDetail( ({ "wasser", "quellwasser", "quellwassers", "wassers" }),
    "Das frische Quellwasser hat sich wohl seinen Weg durch das "
    "Gebirge gebahnt um hier fuer einen kurzen Moment die Welt "
    "der Sterblichen zu durchqueren.");
  AddDetail( ({ "weg" }),
    "Was das Wasser auf seinem Weg durch die Berge schon gesehen "
    "hat, kannst Du nicht erahnen.");
  AddDetail( ({ "gebirge" }),
    "Das Gebirge kannst Du hier nicht sehen. Du bist irgendwie "
    "mittendrin.");
  AddDetail( ({ "berge", "teil", "berges", "berg" }),
    "Diese Grotte ist wohl Teil eines Berges.");
  AddDetail( ({ "platz" }),
    "Der Platz reicht um das Wasser austreten zu lassen.");
  AddDetail( ({ "ausdringen" }),
    "Das Wasser dringt aus dem Gestein aus.");
  AddDetail( ({ "gestein" }),
    "Das Gestein hier wurde wohl durch die Kraft des Quellwassers "
    "ausgespuelt und bildet seither diese Grotte.");
  AddDetail( ({ "kraft" }),
    "Die Kraft des Quellwassers scheint nicht sonderlich gross, "
    "jedoch hat es alle Zeit der Welt.");
  AddDetail( ({ "welt", "silberland" }),
    "Die Welt hier heisst 'Silberland'.");
  AddDetail( ({ "zeit", "jahrhunderte" }),
    "Zeit ist etwas, das hier nicht zaehlt.");
  AddDetail( ({ "waende", "wand", "waenden" }),
    "Waende kann man das hier eigentlich garnicht nennen. Vielmehr "
    "hat die Kraft des Wassers in Laufe der Jahrhunderte eine "
    "Hoehle aus dem Gestein ausgehoehlt.");
  AddDetail( ({ "hoehle" }),
    "Eher eine Grotte.");
  AddDetail( ({ "lauf", "laufe" }),
    "Der Lauf der Zeit ist wie das Wasser dieser Quelle unaufhaltbar.");
  AddDetail( ({ "moment" }),
    "Und schon ist er vorbei.");
  AddDetail( ({ "sterblichen", "sterbliche", "sterblicher" }),
    "Du bist wohl sterblich.");
  AddDetail( ({ "schicht" }),
    "Die bodennahe Schicht schimmert blaeulich und wirkt irgendwie "
    "wie Nebel. Sie scheint nicht von Abenteurern geschaffen, sondern "
    "duerfte eher natuerlichen Ursprunges sein.");
  AddDetail( ({ "abenteurer", "abenteurern", "abenteurers" }),
    "So wie Du und.. Naja - wie Du.");
  AddDetail( ({ "ursprung", "ursprunges" }),
    "Das Feld scheint natuerlichen Ursprunges zu sein. Wohl irgendwie "
    "magisch.");
  AddDetail( ({ "feld" }),
    "Du stehst mit beiden Beinen darin.");
  AddDetail( ({ "beinen", "beine" }),
    "Du siehst Deine Beine entlang gen Boden. Sie durchschneiden die "
    "schimmernde Schicht, ohne sie zu stoeren oder davon Schaden zu "
    "nehmen.");
  AddDetail( ({ "schaden" }),
    "Das Feld scheint nicht gefaehrlich zu sein.");
  AddDetail( ({ "abenteurerhand", "hand" }),
    "Die Hand eines Abenteurers.");  
  AddDetail( ({ "boden" }),
    "Knapp ueber dem Boden ist eine blaeulich schimmernde Schicht.");  
  AddDetail( ({ "ablage" }),
    "In der Ablage hat sich eine kleine Pfuetze gebildet.");
  AddDetail( ({ "pfuetze" }),
    "Die Pfuetze ist nicht besonders tief, noch kannst Du sonst "
    "daran etwas Besonderes erkennen.");
  AddDetail( ({ "besonderes" }),
    "Nichts.");
  AddDetail( ({ "art" }),
    "Eine davon.");
  AddDetail( ({ "ende" }),
    "Am Ende der Grotte plaetschert munter eine kleine Quelle.");
  AddDetail( ({ "loch" }),
    "Das Loch ist stockdunkel und fuehrt ins Ungewisse.");
  AddDetail( ({ "ungewisse", "ungewisses" }),
    "Was dort ist, weisst Du nicht.");
  AddDetail( ({ "felsen" }),
    "Ein Felsen bildet eine Art Ablage.");
  AddDetail( ({ "grotte" }),
    "Die Grotte ist eine vom Wasser geschaffene kleine Hoehle.");
  AddDetail( ({ "decke" }),
    "Die Decke ist nicht wirklich von den Waenden getrennt.");
  AddDetail( ({ "nebel" }),
    "Nebel siehst Du keinen, aber eine blaeulich schimmernde "
    "Schicht knapp ueber dem Boden, die aussieht wie solcher.");
  AddDetail( ({ "seite" }),
    "Auf dieser Seite verschwindet das Quellwasser in einem "
    "finsteren Loch.");


  AddExit( "ostoben", ROOM "room_C-01" );

  
}

varargs int PreventInsert (object ob)
{
  int parent;
  object *armours;
  int i;

  if ((parent = ::PreventInsert(ob)) != 0) return parent;

  if (!environment(ob) || ob->QueryProp(P_NODONATE)) return 0;

  if (living(ob) || query_once_interactive(ob))
    {
      if (pointerp(armours = ob->QueryProp(P_ARMOURS)))
        for (i=0;i<sizeof(armours);i++)
          if (armours[i]->QueryProp(P_ARMOUR_TYPE) == AT_BOOT)
            {
              if (armours[i]->QueryProp(P_DONATED) 
                  || armours[i]->QueryProp(P_NODONATE)) return 0;
              armours[i]->SetProp(P_DONATED_VALUE, 
                  armours[i]->QueryProp(P_VALUE));
              armours[i]->SetProp(P_VALUE, 0);
              armours[i]->SetProp(P_DONATED, 1);
              SetProp(P_LIGHT, 2);
              tell_room(ME, BS("Die blaeulich schimmernde Schicht "
                "blitzt kurz auf."));
              SetProp(P_LIGHT, 0);
              write_file(ALOG + "donation.log",
                sprintf("%s %O %O\n", ctime(), environment(armours[i]),
                    armours[i]));
              return 0;
            }
      return 0;
    } // if (living(ob) || query_once_interactive(ob)) 
    
  if (!ob->QueryProp(P_DONATED) && !ob->QueryProp(P_NODONATE))
    {
      ob->SetProp(P_DONATED_VALUE, ob->QueryProp(P_VALUE));
      ob->SetProp(P_VALUE, 0);
      ob->SetProp(P_DONATED, 1);
      SetProp(P_LIGHT, 2);
      tell_room(ME, BS("Die blaeulich schimmernde Schicht "
        "blitzt kurz auf."));
      SetProp(P_LIGHT, 0);
      write_file(ALOG + "donation.log",
        sprintf("%s %O %O\n", ctime(), environment(ob), ob));
    }

  return 0; 
 
}

