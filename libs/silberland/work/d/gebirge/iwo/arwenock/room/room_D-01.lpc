
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst mitten im schoenen Staedtchen " + STADT + "."
    "Der doch recht breite Weg fuehrt Dich entweder in "
    "westliche, oder in oestliche Richtung. Die Gebaeude "
    "hier scheinen alt, aber doch recht sauber - als waeren "
    "sie frisch renoviert. Irgendwo aus einem Fenster toent "
    "nervendes Geschrei.");
  
  AddDetail( ({ "staedtchen" }),
    "Ein paar Haeuser, die eine oder andere Gasse sowie ein "
    "zuenftiger Marktplatz und schon hat man ein feines "
    "Staedtchen.");
  AddDetail( ({ "haeuser" }),
    "Die Haeuser hier scheinen nicht mehr ganz neu zu sein, "
    "trotzdem in recht passablem Zustand.");
  AddDetail( ({ "marktplatz" }),
    "Den siehst Du von hier aus natuerlich nicht.");
  AddDetail( ({ "zustand", "gebaeude" }),
    "Die Gebaeude scheinen wohl kuerzlich renoviert worden zu "
    "sein.");
  AddDetail( ({ "weg", "gasse" }),
    "Der breite Weg ist ordentlich mit Pflastersteinen "
    "bepflastert.");
  AddDetail( ({ "richtung" }),
    "Osten oder Westen - DAS ist hier die Frage!");
  AddDetail( ({ "frage" }),
    "Heascht, kannma das sehen??");
  AddSound( DEFAULT_SOUND, "Osten oder Westen?");
  AddDetail( ({ "fenster" }),
    "Das Fenster steht offen. Gefaehrlich, gefaehrlich!");
  AddSound ( ({ "geschrei" }),
    "Es scheint sich um einen recht lebhaften Streit zu handeln. "
    "Du solltest wohl verschwinden bevor Dich ein Blumentopf "
    "am Kopf trifft.");
  AddSound ( ({ "kopf" }),
    "Dein Kopf klingt hohl. Und es surrt etwas.");


  

  AddExit( "osten", ROOM "room_E-01" );
  AddExit( "westen", ROOM "room_C-01" );

}
