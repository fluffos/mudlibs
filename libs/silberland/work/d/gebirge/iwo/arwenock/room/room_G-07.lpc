
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "zaknafein"

int anzahl=5;

create()
{
  ::create();
  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_TOWN])); 
  SetProp(P_INT_SHORT, "In einem schaebigen Stadtteil von Arwenock" );
  SetProp(P_INT_LONG,
    "Hier beginnt das Armenviertel Arwenocks. Schaebige Haeuser saeumen die "
   +"schmale, schmutzige Gasse die durch diesen heruntergekommenen Teil der "
   +"Stadt fuehrt. Die Fenster und Tueren der Haeuser sind fest verschlossen. "
   +"Anscheinend haben die Anwohner hier grosse Angst vor Dieben und dem "
   +"sonstigen Gesindel, das sich hier rumtreibt.");
 
  AddDetail( ({ "teil" , "stadt" , "arwenocks" , "arwenock" , "viertel" , "armenviertel" }) ,
    "In diesem Teil der Stadt wohnen die armen Einwohner Arwenocks. "
   +"Ausserdem treibt sich hier viel Gesindel rum.\n");
  AddDetail( "einwohner" ,
    "Die Einwohner leben in den schaebigen Haeusern hier.\n");
  AddDetail( "gesindel",
    "Besonders vor den Ruepeln muss man sicht hier in Acht nehmen. Sie terrorisieren "
   +"jeden hier in der Stadt und belaestigen alle, die durch die Gasse schlendern.\n");
  AddDetail( "acht" ,
    "Nimm Dich ja in Acht hier.\n");
  AddDetail( ({ "haeusern" , "haeuser" , "haus" }) ,
    "Die Haeuser sind ziemlich schaebig und heruntergekommen. Betreten "
   +"solltest Du wohl keines von ihnen.\n");
  AddDetail( ({ "fenster" , "tuer" , "tueren" }) ,
    "Die Fenster und Tueren der Haeuser sind fest verschlossen.\n");
  AddDetail( ({ "dieb" , "diebe" }) ,
    "Die Anwohner machen es den Dieben schwer, da sie ihre Tueren und Fenster fest "
   +"verschliessen.\n");
  AddDetail( ({ "hemd" , "angst" }) ,
    "Mache Dir nicht gleich ins Hemd. So gefaehrlich ist es hier auch wieder nicht...\n");
  AddDetail( ({ "ruepel" , "ruepeln" }) ,
    "Die Ruepel treiben sich hier irgendwo rum. Sei vorsichtig, wenn Du ihnen begegnest.\n");
  AddDetail( "boden" ,
    "Der Boden hier in der Gasse wurde mit Steinen gepflastert.\n");
  AddDetail( "anwohner" ,
    "Du muesstest schon durch die Fenster schauen, um sie zu sehen.\n");
  AddDetail( ({ "durch die fenster" , "durch fenster" , "durch das fenster" , "durch ein fenster" }) ,
    "Du schaust neugierig durch ein paar Fenster. Hinter einem Fenster erblickst Du eine "
   +"Familie, die gerade isst.\n");
  AddDetail( "familie" ,
    "Gierig stuerzen sie sich auf das Essen.\n");
  AddDetail( "essen" ,
    "Das Essen sieht sehr lecker aus. Hm, vielleicht geben sie Dir etwas davon, wenn Du "
   +"an das Fenster klopfst. Arme Leute haben meistens ein grosses Herz.\n");
  AddDetail( ({ "herz" , "leute" }),
    "Probiere es doch mal...\n");
  AddDetail( ({ "pflastersteine" , "steine" }) ,
    "Die Pflastersteine wurden hier nicht sehr sorgfaeltig verlegt. "
   +"Zwischen den einzelnen Steinen klaffen grosse Luecken.\n");
  AddDetail( ({ "luecke" , "luecken" }) ,
    "Du schaust in eine der Luecken, findest aber nichts.\n");
  AddDetail( "gasse" ,
    "Die Gasse hier ist recht eng und schaebig.\n");
  AddDetail( "himmel" ,
    "Ein paar Wolken verdecken die Sonne.\n");
  AddDetail( ({ "wolke" , "wolken" }) ,
    "Es wird wohl bald regnen.\n");
  AddDetail( "sonne" ,
    "Sie ist hinter den Wolken verborgen.\n");
  AddDetail( ({ "ratte" , "ratten" }) ,
    "Es wundert Dich nicht, dass es hier Ratten gibt.\n");

  AddSmell( DEFAULT_SMELL , "Hier riecht es nicht gerade sehr angenehm.\n");
  AddSound( DEFAULT_SOUND , "In einem der Haeuser streitet ein Ehepaar.\n");
  AddSound( ({ "streit" , "ehepaar" }) , 
            "Sei nicht so neugierig. Das geht Dich wirklich nichts an.\n");
 
  AddCmd( ({ "klopf" , "klopfe"  }) , "klopfen");
  
  AddExit( "westen", ROOM "room_F-07" );
  AddExit( "osten", ROOM "room_H-07" );

}

reset()
{
  ::reset();
anzahl=5;
}

klopfen( str )
{
notify_fail( "An was moechtest Du denn klopfen?\n" );
if( str == "an fenster" || str == "fenster" || str == "an das fenster" )
	{
           if (anzahl != 0 )  
           {
             if((this_player()->QueryMoney())>=5000)
              {
                write(BS("Die Mutter offnet das Fenster und meint, Du seist zu reich "
                         +"und koenntest Dir bestimmt selbst was kaufen. Dann setzt sie "
                         +"sich wieder an den Tisch.\n"));
              }
              else
              {

                if(find_player("zaknafein")) tell_object(find_player("zaknafein"),
                break_string(capitalize("zaknafein")+", "
                 +capitalize(TP->query_real_name())+" hat sich von mir heilen lassen!", 78,
                 "Eine Buergerin von Arwenock teilt Dir mit: "));
                write_file ("/players/zaknafein/arw.log",
                sprintf ("%s  %s hat sich in Arwenock heilen lassen!\n",
                          dtime(time()), capitalize(TP->query_real_name())));

                anzahl = anzahl -1;
                this_player()->heal_self(20+random(5));
                write(BS("Die Mutter oeffnet das Fenster und sagt mitfuehlend, dass sie Dir "
                         +"gerne etwas gibt, weil Du so arm bist. Sie schaut Dir noch dabei "
                         +"zu, wie Du gierig das Essen runterschlingst, bevor sie sich wieder "
                         +"an den Tisch setzt. Du fuehlst Dich von dem Essen gestaerkt.\n"));
              }
               
            return 1;
           }
           else
           {
           write(BS("Die Mutter oeffnet das Fenster und erklaert Dir, dass sie leider "
                    +"nichts mehr fuer Dich hat. Vielleicht morgen wieder... Dann schliesst "
                    +"sie das Fenster wieder und geht zurueck zum Tisch.\n"));
           return 1;
           }
        }
return 0;	
}

