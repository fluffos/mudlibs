#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


#define WIZNAME "andyl"

int exitfun()
{
  if ((AMASTER->QueryDoorState("Haupttor"))==0)
    {
      write(BS("Das Haupttor ist geschlossen. Du kannst "
	       +"die Stadt jetzt nicht betreten.\n"));
      return 0;

    }
  else return 1;
}

create()
{
  ::create();
  SetProp(P_INT_SHORT, "Ein Weg vor Arwenock");
  SetProp(P_INT_LONG,
	  "Du befindest Dich auf einem breiten Weg welcher nach Arwenock "
	  +"fuehrt oder davon weg, je nach Sichtweise. Oestlich von Dir ragt "
	  +"das praechtige Stadttor von Arwenock auf welches in einem "
	  +"blaeulichem Licht erstrahlt. Im Westen siehst Du den Waldrand "
	  +"des Gebirgswaldes. Ueber Dir scheint die Sonne sanft auf Dich "
	  +"herab und auch ein paar Voegel kannst Du entdecken. Insgesamt "
	  +"wirkt alles sehr friedlich hier.\n"
	  +"@@doorinfo@@");
  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  // DETAILS START

  AddDetail(({"weg"}),
	    "Der Weg ist sauber mit Pflastersteinen ausgelegt. Zwischen "
	    +"den Pflastersteinen waechst hier und dort etwas Moos. Neben "
	    +"dem Weg siehst Du Gras und verschiedene Blumen.\n");
  AddDetail(("gras"),
	    "Gruenes, saftiges Gras.\n");
  AddDetail(({"blumen", "haufen"}),
	    "Es gibt hier einen Haufen Blumen in allen verschiedenen Farben "
	    +"und Formen.\n");
  AddDetail(("formen"),
	    "Die Formen der Blumen sind alle unterschiedlich.\n");
  AddDetail(({"farben", "umgebung"}),
	    "Die Verschiedenen Farben der Blumen lassen die Umgebung "
	    +"schoen bunt erscheinen.\n");
  AddDetail(({"moos"}),
	    "Das Moos waechst da zwischen den Pflastersteinen. Soll Dir ja "
	    +"ganz recht sein, denn wie heisst es so schoen:\n"
	    +"Ohne Moos nix los!.\n");
  AddDetail(("himmel"),
	    "Sanft scheint die Sonne vom blauen Himmel herunter. Ein paar "
	    +"kleine Wolken und einige Voegel kannst Du entdecken.\n");
  AddDetail(("sonne"),
	    "Sanft scheint die Sonne auf Dich herunter.\n");
  AddDetail(("wolken"),
	    "Es sind nur ein paar kleine weisse Wolken.\n");
  AddDetail(("voegel"),
	    "Zwitschernd fliegen die Voegel an Dir vorrueber. Ist ja "
	    +"direkt kitschig diese Szene.\n");
  AddDetail(("szene"),
	    "Manche Szenen koennen schon sehr kitschig sein.\n");
  AddDetail(("boden"),
	    "Du stehst auf einem Weg aus Pflastersteinen.\n");
  AddDetail(({"steine", "pflastersteine"}),
	    "Einfache graue Pflastersteine mit denen der Weg hier gebaut "
	    +"worden ist.\n");
  AddDetail(({"arwenock", "stadt"}),
	    "Die Stadt, welche Du im Osten siehst, wird Arwenock genannt. "
	    +"Es ist ein wahres Handelsparadies in dem Angehoerige "
	    +"verschiedenster Voelker mit unterschiedlichsten Waren handeln. "
	    +"Auch fuer Dich ist dort sicher etwas Interessantes dabei.\n");
  AddDetail(({"voelker", "volk", "angehoerige"}),
	    "In Arwenock wirst Du Angehoerige verschiedenster Voelker "
	    +"treffen.\n");
  AddDetail(("interessantes"),
	    "In Arwenock wirst Du sicher einiges Interessantes entdecken.\n");
  AddDetail(({"paradies", "handelsparadies"}),
	    "Arwenock ist ein wahres Handelsparadies in welchem Du die "
	    +"Waren eines jeden Volkes finden kannst.\n");
  AddDetail(("waren"),
	    "Waren kannst Du in Arwenock genuegend finden, von maechtigen "
	    +"Waffen ueber praechtige Ruestungen bis zu allerlei Kleinkram.\n");
  AddDetail(("waffen"),
	    "Du koenntest sicher einige maechtige Waffen erstehen. Denn Du "
	    +"weisst ja: Angriff ist die beste Verteidigung!\n");
  AddDetail(({"angriff", "verteidigung"}),
	    "Angriff ist die beste Verteidigung.\n");
  AddDetail(({"ruestung", "ruestungen"}),
	    "In Arwenock gibt es sicher ein paar Haendler, die auch praechtige "
	    +"Ruestungen in ihrem Sortiment haben.\n");
  AddDetail(("sortiment"),
	    "Das Sortiment der Haendler in Arwenock ist sicher gross.\n");
  AddDetail(("haendler"),
	    "Davon wirst Du in Arwenock genug finden.\n"); 
  AddDetail(("kleinkram"),
	    "Der eine oder andere Kleinkram kann ja bei manchen Abenteuern "
	    +"sehr nuetzlich sein.\n");
  AddDetail(("abenteuer"),
	    "Davon wirst Du wahrscheinlich noch so einige im Silberland erleben.\n");
  AddDetail(("silberland"),
	    "Was das Silberland ist solltest Du mittlerweile aber bereits wissen.\n");
  AddDetail(("sichtweise"),
	    "In manchen Situationen kommt es nur auf die Sichtweise an.\n");
  AddDetail(("situationen"),
	    "Es gibt genuegend Situationen in denen es nur auf die Sichtweise "
	    +"ankommt.\n");
  AddDetail(({"tor", "stadttor"}),
	    "Das Stadttor von Arwenock erstrahlt in einem blaeulichen Licht. Ob "
	    +"da wohl Magie im Spiel ist?\n");
  AddDetail(({"magie", "spiel"}),
	    "Ob wohl Magie bei dem Stadttor von Arwenock im Spiel ist?\n");
  AddDetail(("licht"),
	    "Das blaeuliche Licht laesst das Stadttor von Arwenock erstrahlen.\n");
  AddDetail(("waldrand"),
	    "Der Waldrand des Gebirgswaldes ist westlich von hier zu sehen.\n");
  AddDetail(({"wald", "gebirgswald"}),
	    "Im Westen ist der Gebirgswald. Du kannst ja dort mal hinschauen und ihn "
	    +"naeher begutachten.\n");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst das Summen einiger Insekten und einige Geraeusche aus der "
	   +"Stadt.\n");
  AddDetail(("insekten"),
	    "Die summen da froehlich vor sich hin.\n");
  AddDetail(({"geraeusche", "stadtlaerm"}),
	    "Typischer Stadtlaerm.\n");
  AddSound(({"summen", "zzzzzzzzzzhhhhhh"}),
           "Zzzzzzzzzzhhhhhh!!!\n");
  AddSmell(DEFAULT_SMELL, "Der Geruch von frischen Gras und Blumen dringt an Deine Nase.\n");
  AddSmell(("blumen"),
	   "Die riechen gut!\n");
  AddSmell(("gras"),
	   "Riecht frisch und saftig.\n");
  AddDetail(({"nase", "ding"}),
	    "Das Ding vor deinen Augen.\n");
  AddDetail(({"augen", "dinger"}),
	    "Die Dinger hinter Deiner Nase.\n");
  AddSpecialDetail(({"stadttor", "tor", "haupttor"}), "tor_schau");
  // DETAILS ENDE

  // ITEMS START

  // ITEMS ENDE


  // COMMANDS START

  AddCmd(({"oeffne"}), "oeffne_was");
  AddCmd(({"schliess", "schliesse"}), "schliess_was");

  // COMMANDS ENDE

  // EXITS START
  
  AddExit( "westen", "/d/gebirge/iwo/weg/room/08-15" );
  AddExit( "osten", ([EX_DEST: ROOM "room_B-04", 
  EX_TESTFUNC: CLOSURE(exitfun),
  EX_MSG: "durch das Stadttor",
  EX_PLMSG: "Du durchschreitest das Stadttor von Arwenock.\n",
  EXG_RMMSG: "@Wer durchschreitet das Stadttor von Arwenock.\n" ]) ); 
  // EXITS ENDE

}

tor_schau()
{
  write(BS("Das Stadttor von Arwenock erstrahlt in einem blaeulichen Licht. Ob "
	   +"da wohl Magie im Spiel ist?.\n"));
  if ((AMASTER->QueryDoorState("Haupttor"))==0)
    {
      return("Das Stadttor ist geschlossen.\n");
    }
  else
    {
      return("Das Stadttor ist geoeffnet.\n");
    }
}


string doorinfo()
{
  if ((AMASTER->QueryDoorState("Haupttor"))==0)
    {
      return("Das Haupttor ist geschlossen.");
    }
  else
    {
      return("Das Haupttor ist geoeffnet.");
    }
}

oeffne_was(str)
{
  notify_fail(BS("Was willst Du oeffnen?\n"));
  if (!str) return 0;
  if ((str == "tor" || str == "stadttor" || str == "haupttor"))
    {
      if ((AMASTER->QueryDoorState("Haupttor"))==0)
	{
	  write(BS("Du kannst das Stadttor von hier aus nicht oeffnen.\n"));
	  return 1;
	}
      else
	{
	  write(BS("Das Stadttor ist doch schon offen.\n"));
	  return 1;
	}
    }
  else return 0;
}

schliess_was(str)
{
  notify_fail(BS("Was willst Du schliessen?\n"));
  if (!str) return 0;
  if ((str == "tor" || str == "stadttor" || str == "haupttor"))
    {
      if ((AMASTER->QueryDoorState("Haupttor"))==1)
	{
	  write(BS("Du kannst das Stadttor von hier aus nicht schliessen.\n"));
	  return 1;
	}
      else
	{
	  write(BS("Das Stadttor ist doch schon offen.\n"));
	  return 1;
	}
    }
  else return 0;
}







