
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "querolin"

create()
{
  ::create();
// -------------------------------------------------


  SetProp(P_INT_LONG,
    "Du steht etwas entfernt vom Marktplatz auf einem kleinen Weg, der "
    "Dich Richtung Osten zu einer Kirche fuehrt. Vom Marktplatz her, hoerst "
    "Du noch viele verschiedene Stimmen durcheinanderrufen, obwohl es hier "
    "auch nicht besonders ruhig ist. Einige Passanten draengen sich an Dir "
    "vorbei und Du sehnst Dich nach etwas Ruhe. Vor einem kleinen Haus ist "
    "ein Garten, der mit einem weissen Lattenzaun eingegrenzt ist. ");

  AddDetail( ({ "lattenzaun", "zaun", "lattenzaeune", "farbe" }),
    "Der Lattenzaun ist mir weisser Farbe gestrichen worden und sieht auch "
    "kaum anders aus als andere Lattenzaeune die Du kennst. Einige Naegel "
    "sind jedoch nur schleissig eingeschlagen worden und stehen etwas heraus. ");

  AddDetail( ({ "naegel", "holz"}),
    "Einige Naegel stehen etwas aus dem Holz heraus. An einem Nagel haengt "
    "sogar etwas dran. ");

  AddDetail( ({ "nagel", "etwas" }),
    "An dem Nagel haengt ein alter Stoffsack. ");

  AddDetail( ({ "stoffsack", "stoff", "sack" }),
    "Als Du den Stoffsack genauer betrachtest bemerkst Du, dass es kein Sack, "
    "sondern viel mehr eine alte Socke ist. ");

  AddDetail( ({ "socke", "socken" }),
    "Die alte Socke haengt an dem Nagel herunter. Wer die wohl hier hingehaengt "
    "haben mag? ");

  AddDetail( ({ "garten" }),
    "Der Garten sieht bereits etwas verwildert aus. Ueberall waechst Unkraut, "
    "und einiges an Baumaterial liegt auch herum. ");

  AddDetail( ({ "unkraut" }),
    "Eigentlich waechst hier kein Unkraut, vielmehr wuchert es hier. ");

  AddDetail( ({ "baumaterial", "material", "baustellen" }),
    "So wie es auf vielen Baustellen anztreffen ist. Ein paar Bretter "
    "ein grosser Trog, zwei Kuebel und eine Palette Zement. ");

  AddDetail( ({ "bretter", "brett", "kuebel" }),
    "Da ist nichts Besonderes mehr daran zu erkennen. ");
 	
  AddDetail( ({ "besonderes" }),
    "Wie schon gesagt nichts Besonderes ist zu erkennen. ");

  AddDetail( ({ "trog","wasser" }),
    "Der Trog ist mit Wasser gefuellt. ");

  AddDetail( ({ "palette","zement","saecke","umbau","hauses","holzpalette" }),
    "Acht Saecke mit Zement liegen auf der kleinen Holzpalette. Das Zement "
    "wird wohl zum Umbau des Hauses gebraucht. ");

  AddDetail( ({ "haus"}),
    "Das kleine Haus sieht verlassen aus. Zumindest ist im Postkasten schon "
    "ein grosser Berg an Post, die wohl schon sehr lange im selbigen liegt. ");

  AddDetail( ({ "postkasten", "post", "berg" }),
    "Viele Briefe stecke in dem kleinen Postkasten, und aussen haengt ein "
    "kleines Schild am Postkasten. ");

  AddDetail( ({ "briefe","leute" }),
    "Du wirst doch wohl nicht fremder Leute Post lesen - oder? ");

  AddDetail( ({ "schild" }),
    "Auf dem gelben Schild steht: Wegen umbau derzeit nicht zuhause. "
    "Jetzt weisst Du warum das Haus so verlassen aussieht. ");

  AddDetail( ({ "ruhe" }),
    "Schoen waers... ");

  AddDetail( ({ "passanten", "passant", "menschenmenge" }),
    "Kaum glaubst Du einen genauer ansehen zu koennen, ist er schon wieder in "
    "der grossen Menschenmenge verschwunden. ");

  AddDetail( ({ "markt", "marktplatz", "platz" }),
    "Der Marktplatz befindet sich etwas abseits im Westen. ");

  AddDetail( ({ "westen" }),
    "Gegenueber der Kirche welche im Osten schon deutlich zu erkennen ist, "
    "befindet sich der Marktplatz. Und Du stehst in der Mitte. ");

  AddDetail( ({ "richtung", "osten" }),
    "Nach Osten fuehrt Dich der Weg zu einer Kirche. ");

  AddDetail( ({ "kirche", "kirchen", "tueren" }),
    "Die maechtige Kirche ist das religioese Zentrum der Stadt. Sie ist "
    "sicherlich eines der prunkvollsten Bauwerke hier. Riesige Fenster "
    "aus bemaltem Glas. Die Tueren der Kirche stehen weit offen, so "
    "dass Du sie betreten kannst. ");

  AddDetail( ({ "zentrum" }),
    "Fuer alle die beten wollen, ist die Kirche der beste ort dafuer. ");

  AddDetail( ({ "bauwerke", "bauwerk","prunkstueck","gebaeude","museum" }),
    "Hierbei handelt es sich um ein wirkliches Prunkstueck. Es ist das wohl "
    "das schoenste Gebaeude hier. Naja bis auf das Museum. ");

  AddDetail( ({ "fenster", "glas", "prachtstuecke", "glasfenster" }),
    "Wie bei den meisten Kirchen, hat auch diese hier Glasfenster die in den "
    "schillernsten Farben bemalt sind. Von aussen wirken die Fenster zwar "
    "meist schlicht und einfach, aber von innen sind sie ware Prachtstuecke. ");

  AddSound(DEFAULT_SOUND, "Vom Markt her ist lautes rufen zu hoeren, aber " 
    "auch von nicht so weiter entfernung nimmst Du Stimmen war. ");

  AddSound ( ({ "stimmen", "stimme", "passanten" }),
    "Die Stimmen kommen von den vielen Passanten hier. Genaueres kannst Du "
    "aber nicht erlauschen. ");

  AddSound( ({"markt","marktplatz","rufe"}), 
    "Vom Markt her drohenen viele unterschiedliche Rufe, sodass Du keinen "
    "bestimmten genauer hoerst. ");

  AddSmell(DEFAULT_SMELL, "Nichts besonders ist hier zu riechen. \n");

  AddSmell( ({"nichts"}),
    "Hast Du schon mal nichts gerochen? \n"
    "Dann weisst Du ja wie es hier riecht. ");

// -------------------------------------------------
  AddExit( "norden", ROOM "room_D-05" );
  AddExit( "sueden", ROOM "room_D-03" );
  AddExit( "osten",  ROOM "room_E-04" );
  AddExit( "westen", ROOM "room_C-04" );

  AddItem(NPC "ovulendil.lpc", REFRESH_DESTRUCT);

}
