  AddDetail(("mitte"),
	    "In der Mitte des Wappens ist eine grosse kraeftige Eiche zu sehen.\n");

  AddDetail(({"eiche", "gemeinschaft"}),
	    "Die Eiche symbolisiert die Gemeinschaft von Arwenock.\n");
  AddDetail(({"reh", "frieden"}),
