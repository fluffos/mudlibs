  AddDetail(({"bauwerk", "bauwerke"}),
	    "Das Tor gehoert zu den grossartigsten Bauwerken, die Du jemals gesehen hast.\n");
  AddDetail(({"feenzauber", "zauber"}),
	    "Der Feenzauber laesst das Tor in einem blaeulichem Licht erstrahlen. Der Zauber soll anscheinend "
