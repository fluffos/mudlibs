  AddDetail(({"volk", "voelker"}),
	    "Arwenock wurde von den Angehoerigen verschiedenster Voelker erbaut. "
	    +"Deswegen ist es auch nicht verwunderlich, dass die Kunst so vieler "
	    +"Voelker in der Stadt zu bestaunen ist.\n");

  AddDetail(("kunst"),
	    "Arwenock eine Stadt in der man die Kunst vieler Voelker bewundern "
