#include "../def.h"

inherit STDWEG;
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

#define WIZNAME "andyl"

int exitfun()
{
  object ob;
  if ((AMASTER->QueryDoorState("Haupttor"))==1)
    {
      if (ob=present("bronawar", ENV(TP)) && TP->IsEnemy(ob))
	{
	  write(BS("Bronawar hindert Dich daran, die Stadt zu verlassen "
		   +"und bruellt: Du kommst hier nicht vorbei!\n"));
	  return 0;
	}
      if (ob=present("turanis", ENV(TP)) && TP->IsEnemy(ob))
	{
	  write(BS("Turanis hindert Dich daran, die Stadt zu verlassen "
		   +"und droht: Hier kommst Du nicht vorbei!\n"));
	  return 0;
	}
      return 1;
    }
  else
    {
      tell_object(TP, BS("Das Stadttor ist geschlossen. Du kannst "
	       +"die Stadt jetzt nicht verlassen."));
      return 0;
    }
}

create()
{
  ::create();
  AddId("\nhaupttor");
  SetProp(P_INT_SHORT, "Das Haupttor von Arwenock");
  SetProp(P_INT_LONG, 
	  "Stolz ragt das Haupttor von Arwenock vor Dir auf, einzigartig "
	  +"in seiner Bauweise. Meister eines jeden Volkes haben hier mitgearbeit. "
	  +"Du siehst Handarbeiten von Elfen, Steinmetzarbeiten von Zwergen, Glasarbeiten "
	  +"von Hobbits und Metallarbeiten von Menschen welche alle dieses beeindruckende "
	  +"Bauwerk ausmachen. Dazu kommt noch ein Feenzauber der das Tor in einem "
	  +"hellen Blau erstrahlen laesst. Erfuerchtig betrachtest Du dieses Kunstwerk. "
	  +"Deine Blicke bleiben auf einem Schild welches am Torbogen befestigt wurde "
	  +"haengen. Darauf prangt das Wappen der Stadt unter dem eine kunstvoll gefertgte "
	  +"Tafel haengt. Arwenock ist ueberall im Silberland als ein Handelsparadies "
	  +"bekannt in dem Du mit hoher Wahrscheinlichkeit auch die eine oder andere Raritaet "
	  +"finden wirst. Ein Weg fuehrt nach Westen wieder zurueck in den Wald, im "
	  +"Osten befindet sich der Marktplatz und nach Norden und Sueden kannst Du an "
	  +"der Stadtmauer entlang gehen.\n"
	  +"@@doorinfo@@");
  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  // DETAILS START
  
  AddDetail(("blicke"),
	    "Deine Blicke bleiben an einem Schild am Torbogen haengen.\n");
  AddDetail(("angehoerige"),
	    "Angehoerige aller Voelker haben beim Bau dieses Kunstwerks mitgeholfen.\n");
  AddDetail(({"boden"}), 
	    "Der Boden ist sauber mit farbigen Pflastersteinen ausgelegt welche zusammen "
	    +"ein huebsches Muster bilden.\n");
  AddDetail(({"pflastersteine", "steine"}),
	    "Die farbigen Pflastersteine bilden ein huebsches Muster.\n");
  AddDetail(("muster"),
	    "Es ist ein sehr huebsches Muster welches Dir sehr gefaellt.\n"); 
  AddDetail(("meisterwerk"),
	    "Dieses Tor ist ein wahres Meisterwerk.\n");
  AddDetail(("himmel"),
	    "Sanft scheint die Sonne vom Himmel. Ein paar weisse Woelkchen sind ebenfalls zu "
	    +"entdecken.\n");
  AddDetail(("sonne"),
	    "Sanft scheint die Sonne auf Dich herab.\n");
  AddDetail(("wolken"),
	    "Das sind bestenfalls Woelkchen.\n");
  AddDetail(("woelkchen"),
	    "Ein paar kleine weisse Woelkchen sind am Himmel zu entdecken.\n");
  AddDetail(("bedarfsfall"),
	    "Im Bedarfsfall sollten die Torfluegel sogar dem maechtigsten Gegner "
	    +"widerstehen.\n");
  AddDetail(({"gegner", "drachen", "beispiel"}),
	    "Maechtige Gegner wie Drachen zum Beispiel.\n");
  AddDetail(({"elfen", "zwerge", "hobbits", "menschen", "feen", "errichtung"}),
	    "Elfen, Zwerge, Hobbits, Menschen und Feen haben massgeblich zu der "
	    +"Errichtung dieses Kunstwerks beigetragen.\n");
  AddDetail(("kunstwerk"),
	    "Das Tor ist ein wahres Kunstwerk an welchem ein jedes Volk mitgearbeitet "
