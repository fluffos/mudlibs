  AddDetail(("glueck"),
	    "Glueck kann man immer gebrauchen.\n"); 
  AddDetail(("weg"),
	    "Der Weg fuehrt zurueck in den Wald.\n");
  AddDetail(("marktplatz"),
	    "Der Marktplatz befindet sich oestlich von hier. Du kannst einige Marktstaende erkennen, "
	    +"aber auch eine Guillotine und einen Pranger.\n");
  AddDetail(({"staende", "marktstaende"}),
	    "Im Osten kannst Du die Marktstaende erkennen. Ob man da wohl etwas feines kaufen kann.\n");
  AddDetail(("guillotine"),
	    "Du hoffst, dass Du nie naeher Bekanntschaft mit dieser machen wirst.\n");
  AddDetail(("bekanntschaft"),
	    "Die Bekanntschaft mit einer Guillotine waehrt meistens nicht sehrlange.\n");
  AddDetail(("pranger"),
	    "Du hoffst, dass Du nie auf den Pranger kommen wirst. Aber einer so brave "
	    +"Person wie Du es bist kann das eh nie passieren.\n");
  AddDetail(("person"),
	    "Oder bist Du etwa doch nicht so brav wie es den Schein hat?\n");
  AddDetail(("schein"),
	    "Der Schein truegt oft.\n");
  AddDetail(({"fluegel", "torfluegel"}),
	    "Es sind praechtig verzierte Torfluegel, welche jedoch so stabil aussehen, "
	    +"als koennten sie selbst den staerksten Gegnern trotzen.\n");

  AddDetail( ({ "wald" }),
           "Westlich von Dir liegt der Wald."); 
 
  AddSound(DEFAULT_SOUND, 
	   "Du hoerst die typischen geraeusche einer Stadt. Geschrei von Kindern, "
	   +"die Ansagen von Marktschreiern und das Gerede der Passanten, sowie "
	   +"die harten Befehle der Stadtwache.\n");
  AddSound(({"geschrei", "kindern", "iiiiieeeehhhhhhhhhhaaaaaa"}),
	   "Ein schrilles IIIIIEEEEHHHHHHHHHHAAAAAA droehnt an Dein Ohr.\n");
  AddSound(({"ansagen", "marktschreier", "aepfel", "apfel", "ansage"}),
	    "Einen Ansage ist besonders laut, welche lautet: Frische schoene "
	    +"Aepfel! Denkt dran was der Apfel kann!\n");
  AddSound(({"befehle", "stadtwache", "acht", "um", "nase"}),
	    "Du hoerst: Hab Acht! Rechts Um! Die Nase schneuzt!\n");
  AddSound(({"gerede", "passanten"}),
	   "Blablalabberfaselunsinnquatschundnochvielesunsinnigesmehr.\n");
  AddSmell(DEFAULT_SMELL, 
	   "Du nimmst viele unterschiedliche Gerueche wahr, kannst aber keinen davon identifizieren.\n");
  AddSmell(("gerueche"),
	   "Du nimmst viele unterschiedliche Gerueche wahr, kannst aber keinen davon identifizieren.\n");
  
  AddSpecialDetail(({"silberland", "weiten", "bereiche", "abenteuer", "gebiete", "zivilisationen"}), "silberland_schau"); 
  AddSpecialDetail(({"stadttor", "haupttor", "tor"}), "tor_schau");
  
  // DETAILS ENDE
  
  

  // ITEMS START
  
  AddItem(NPC"turanis", REFRESH_DESTRUCT);
  AddItem(NPC"bronawar", REFRESH_DESTRUCT);

  // ITEMS ENDE


  // COMMANDS START
  AddCmd(({"oeffne"}), "oeffne_was");
  AddCmd(({"schliess", "schliesse"}), "schliess_was");

  // COMMANDS ENDE

  // EXITS START

  AddExit( "sueden", ROOM "room_B-03" );
  AddExit( "norden", ROOM "room_B-05" );
  AddExit( "osten",  ROOM "room_C-04" );
  AddExit( "westen", ([EX_DEST: ROOM "room_A-04",
  EX_TESTFUNC: CLOSURE(exitfun),
  EX_MSG: "durch das Stadttor",
  EX_PLMSG: "Du durchschreitest das Stadttor von Arwenock.\n",
  EXG_RMMSG: "@Wer durchschreitet das Stadttor von Arwenock.\n" ]) ); 
  // EXITS ENDE
}

oeffne_was(str)
{
  notify_fail(BS("Was willst Du oeffnen?\n"));
  if (!str) return 0;
  if ((str == "tor" || str == "stadttor" || str == "haupttor"))
    {
      if ((AMASTER->QueryDoorState("Haupttor"))==1)
	{
	  tell_object(TP, ("Das Tor ist ja schon offen.\n"));
	  return 1;
	}
      else
	{
	  if (present("bronawar", ME))
	    {
	      tell_object(TP, BS("Bronawar stellt sich vor Dich und brummt: "
		       +"Das Tor bleibt zu!\n"));
	      return 1;
	    }
	  else if (present("turanis", ME))
	    {
	      tell_object(TP, BS("Turanis versperrt Dir den Weg und meint: "
		       +"Das Tor muss geschlossen bleiben!\n"));
	      return 1;
	    }
	  else
	    {
	      tell_object(TP, BS("Du schiebst den Riegel beiseite und "
		       +"oeffnest das Stadttor."));
              tell_room(ME, BS(TP->Name(WER) + " schiebt den Riegel beisite und oeffnet das Stadttor."), ({ TP }));
	      AMASTER->OpenDoor("Haupttor");
	      return 1;
	    }
	}
    }
  else return 1;
}

schliess_was(str)
{
  notify_fail(BS("Was willst Du schliessen?\n"));
  if (!str) return 0;
  if ((str == "tor" || str == "stadttor" || str == "haupttor"))
    {
      if ((AMASTER->QueryDoorState("Haupttor"))==0)
	{
	  notify_fail("Das Tor ist ja schon zu.\n");
	  return 0;
	}
      else
	{
	  if (present("bronawar", ME))
	    {
	      notify_fail(BS("Bronawar stellt sich vor Dich und brummt: "
		       +"Das Tor bleibt offen!\n"));
	      return 0;
	    }
	  if (present("turanis", ME))
	    {
	      notify_fail(BS("Turanis versperrt Dir den Weg und meint: "
		       +"Das Tor muss offen bleiben!\n"));
	      return 0;
	    }
	  else
	    {
	      tell_object(TP, BS("Mit einiger Muehe schliesst Du das Stadttor.\n"));
              tell_room(ME, BS(TP->Name(WER) + " schliesst das Stadttor."), ({ TP }));
	      AMASTER->CloseDoor("Haupttor");
	      return 1;
	    }
	}
    }
  else return 0;
}

int ArkensOpenDoor()
{
  schliess_was("haupttor");
  return 0;
}

tor_schau()
{
  write(BS("Das Haupttor von Arwenock ist ein wahres Meisterwerk. Daran haben die "
	   +"Meister eines jeden Volkes mitgearbeitet. Es hat zwei grosse Fluegel "
	   +"die reich verziert sind und dennoch so stabil wirken als koennen sie "
	   +"im Bedarfsfall sogar dem maechtigsten Gegner wiederstehen.\n"));
  if ((AMASTER->QueryDoorState("Haupttor"))==0)
    {
      return("Das Haupttor ist geschlossen.\n");
    }
  else
    {
      return("Das Haupttor ist geoeffnet.\n");
    }
}

string doorinfo()
{
  if ((AMASTER->QueryDoorState("Haupttor"))==0)
    {
      return("Das Haupttor ist geschlossen.");
    }
  else
    {
      return("Das Haupttor ist geoeffnet.");
    }
}

silberland_schau()
{
  if ((TP->QueryProp(P_GENDER))=="FEMALE")
    {
      return(BS("Das Silberland...unendliche Weiten...dies sind die "
		+"Abenteuer von "+(TP->QueryProp(P_NAME))+" die mutig "
		+"Monster bekaempft, fremde Gebiete und ungekannte "
		+"Zivilisationen erforscht. Dabei dringt Sie in Bereiche "
		+"vor die nie ein Silberlaender zuvor gesehen hat.\n")); 
    }
  else
    {
      return(BS("Das Silberland...unendliche Weiten...dies sind die "
		+"Abenteuer von "+(TP->QueryProp(P_NAME))+" der mutig "
		+"Monster bekaempft, fremde Gebiete und ungekannte "
		+"Zivilisationen erforscht. Dabei dringt er in Bereiche "
		+"vor die nie ein Silberlaender zuvor gesehen hat.\n"));
    }
}

public void init() {
	::init();
  
	if(interactive(this_player())) {
	  check_bard_awf_quest(this_player());
	}
  }
