  AddDetail(({"ritter", "schutz", "sicherheit"}),
	    "Der kniedende Ritter soll Schutz und Sicherheit symbolisieren.\n"); 
  AddDetail(({"handelsparadies", "paradies", "wahrscheinlichkeit"}),
	    "Arwenock ist als wahres Handelsparadies bekannt. Hier findest Du mit hoher "
