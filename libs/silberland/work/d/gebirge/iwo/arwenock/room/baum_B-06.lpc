// Arwenock Baum 
// Querolin@silberland  Maerz 2000

#include "../def.h"

inherit STDWEG;

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>

#define WIZNAME "querolin"

int cloned;

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einem Baum inmitten von Arwenock" );
  SetProp(P_INT_LONG,
    "Die Aussicht von dem Baum ist herrlich und es wird Dir die Aesthetik der "+
    "Staedteplanung von Arwenock klar. Schoen in die Landschaft integriert, "+
    "Hier oben ist es schon um einiges ruhiger als unten auf den von hektischem "+
    "Treiben der vielen Haendler und Passanten ueberfuellten Wegen. Ruhe und "+
    "Friedfertigkeit erfuellen diesen Ort hier. Am liebsten wuerdest Du gar "+
    "nicht mehr runterklettern von hier. ");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );
    
  AddDetail( ({ "baum"}),
    "Jepp am Baum ist alles dran, was ein Baum so hat: Stamm, Aeste, Zweige und Blaetter.");

  AddDetail( ({ "ast", "aeste"}),
    "An einem Ast entdeckst Du ein Loch.");

  AddDetail( ({ "stamm"}),
    "Am Stamm wachsen Aeste raus und und daraus Zweige und daran haengen Blaetter.");

  AddDetail( ({ "loch"}),
    "Vielleicht solltest Du mal hineingreifen...?");

  AddDetail( ({ "zweig", "zweige"}),
    "Aus den Aesten wachsen Zweige und daran haengen Blaetter. Schoen nicht?");

  AddDetail( ({ "blaetter" }),
    "Viele Blaetter haengen an den Zweigen. Ein Besonderes faellt Dir auf. ");

  AddDetail( ({ "blatt" }),
    "Meinst du das Besondere? ");

  AddDetail( ({ "besonderes", "besondere" }),
    "Es sieht irgendwie komisch aus. Als Du hingreifst flattert es schnell auf "
    "einen anderen Zweig. Vermutlich handelt es sich um einen Schmetterling. ");

  AddDetail( ({ "schmetterling"}),
    "Es soll welche geben die so gut getarnt sind, dass sie wie Blaetter "
    "aussehen. ");

  AddDetail( ({ "aesthetik" }),
    "Wirklich wundervoll. ");

  AddDetail( ({ "aussicht", "sicht" }),
    "Du kannst von hier fast ganz Arwenock ueberblicken. ");

  AddDetail( ({ "friedfertigkeit", "hier"}),
    "Du fuehlst Dich wohl hier oben. ");

  AddDetail( ({ "haendler", "passanten" }),
    "Die kannst Du am Weg unten und auf dem Marktplatz erkennen. \n"
    "Du bist Dir sicher, dass sie Dich nicht sehen koennen. ");

  AddDetail( ({ "marktplatz" }),
    "Den kannst Du in einiger entfernung erkennen. ");

  AddDetail( ({ "landschaft", "ort", "moment" }),
    "Fuer einen Moment glaubst Du, dass wirklich alles perfekt ist... \n");

  AddDetail( ({ "geldboerse", "boerse" }),
    "Du denkst . o O ( Geldboerse? Die is mir jetzt egal) \n"
    "Du bist wirklich verzaubert von diesem Ort hier. ");

  AddDetail( ({ "staedteplanung", "planung" }),
    "Ein wahrer Kuenstler muss diese Stadt erschaffen haben. "
    "Wer das wohl war??? ");

  AddDetail( ({ "iwo", "kuenstler" }),
    "Du denkst . o O ( Heinzelmaennchen? Iwo is ja egal jetzt ) \n"
    "Du grinst leicht. \n");

  AddDetail( ({ "heinzelmaennchen", "maennchen" }),
    "Die gibts es schon lange nicht mehr. Bessergesagt es wurden schon "
    "lange keine mehr gesehen... ");

  AddDetail( ({ "treiben", "wegen" }),
    "Auf den Wegen unter Dir herrscht reges Treiben. ");

  AddDetail( ({ "wind" }),
    "Der blaest hier ab und zu. ");

  AddDetail( ({ "junge", "kind" }),
    "Der Junge ist so erschreckt als Du ihn bemerkt hast, dass er gleich "
    "wieder weggelaufen ist. ");

  AddDetail( ({ "hund" }),
    "Du kannst hier keinen sehen. Aber ab und zu bellt einer. ");
  
  AddDetail( ({"haare", "berge"}), "Deine Haare stehen dir zu Berge. ");

  AddSound( DEFAULT_SOUND, "Nur ab und zu ist Hundegebell zu hoeren.");

  AddSound( ({"bellen", "hund", "hundegebell"}),
    "Es duerft sich um einen grossen Hund handeln - zumindest hoert er sich "
    "an wie ein solcher. ");

  AddSmell( DEFAULT_SMELL, "Es riecht nach Baum hier. " );

  AddSmell( ({"baum"}), "Wer ausser Dir kommt schon auf die Idee an einem "
    "Baum zu schnuppern??? ");

  AddRoomMessage ( ({
    "Der Wind blaest Dir durch Deine Haare.\n",
    "Ein kleiner Junge schaut von unten herauf zu Dir.\n",
    "In einiger entfernung hoerst Du einen Hund bellen.\n" }), 60);

  AddCmd( ({"greif", "greife"}), "greif");
  AddCmd (({"klettere","kletter"}), "kletter");
  AddCmd( ({"spring","springe","huepf","huepfe"}), "springen");

}

kletter(string str)
{
 notify_fail("Rauf gings ja schoen, aber runterklettern kannst Du nicht. \n"+
             "Vielleicht kann man aber runterspringen.\n");
 return(0);
}

greif (string str)                                                                     
{                                                                               
 notify_fail("Worein willst Du greifen?\n");                                    
                                                                                
 if (str != "loch" && str !="in loch")
        return 0;                                                               
                                                                                
  if (cloned) 
{                                                                 
      tell_object(TP, BS("Nichts darin. So ein Pech, das waere sicher "+
	"ein schoenes Versteck fuer einen Zaubertrank gewesen."));               
                                                                               
	return 1;
}

	tell_object(TP, BS("Du greifst in das Loch und findest ein Honigzuckerl.\n"));

	clone_object("/players/querolin/obj/honigzno.lpc")->move(TP);
//	TK("Honigzuckerl vom Baum in Arwenock geclont!\n");
	cloned++;
	return 1;
}

reset()
{
  ::reset();
  cloned=0;
}

springen(string str)
{
   string race;

   notify_fail ("Wohin willst Du springen? Runter?\n");
   if (!str) return 0;
      
   race = TP->QueryProp(P_RACE);
   
  if ( str=="nach unten" ||
        str=="runter" ||
        str=="zum boden"||
        str=="vom baum runter" ||
        str=="von baum runter"||
        str=="baum"||
        str=="von baum hinunter"||
        str=="hinunter"||
        str=="raus")
    {     
    switch(race)
      {
      case "Elf":
        {
        tell_object(TP, BS("Du springst geschickt vom Baum, so wie Du es schon viele "+
              "male gemacht hast, aber als Du am Boden aufkommst, verstauchst "+
              "Du Dir Deinen Knoechel leicht."));
        TP->AddHp(-3);
        TP->move(ROOM"room_B-06.lpc", M_GO, "springt hinunter");
        return 1;
        }
      default:
        {
        tell_object(TP, BS("Du springst geschickt vom Baum, verstauchst Dir aber Deinen "+
              "Knoechel leicht."));
        TP->AddHp(-6);
        TP->move(ROOM"room_B-06.lpc", M_GO, "springt hinunter");
        return 1;
        }
      }
    }
  else
    return 0;
  if ( str=="nach oben" ||
       str=="rauf" ||
       str=="weiter")
  {
       tell_object(TP, BS("Du beschliesst es lieber doch zu lassen... "));
  }
}



