
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();
//-------------------------------------------------

  SetProp(P_INT_LONG,
    "Der Weg auf dem Du hier entlangschlenderst, unterscheidet sich "
    "kaum von all den anderen Wegen hier. Einige Haeuser stehen am "
    "Wegrand und in einem kleinen Vorgarten siehst Du ein Beet. Bei "
    "dem Beet duerfte es sich um ein Gemuesebeet handeln. Ansonsten "
    "faellt Dir momentan nicht mehr auf. ");

  AddDetail( ({ "gaerten", "vorgaerten", "vorgarten", "garten" }),
    "Ein kleiner Vorgarten faellt Dir auf. Darin befinden sich einige "
    "Beete. ");

  AddDetail( ({ "beete", "gemuesebeete" }),
    "In den Beeten werden verschiedene Kraeuter angepflanzt. Ein Beet "
    "zieht Dich besonders an. ");

  AddDetail( ({ "beet", "gemuesebeet" }),
    "Das Beet duftet herrlich nach Kraeutern. Du siehst Petersille, "
    "gruenen Pfeffer, Dill, Lauch und viele andere Kraeuter. Daneben "
    "waechst auch noch anderes Gemuese. ");

  AddDetail( ({ "gemuese" }),
    "Bei dem Gemuese handelt es sich ueberwiegend um gruenen Salat, "
    "Radieschen, Kohl und Paradeiser. ");

  AddDetail( ({ "paradeiser" }),
    "Auch bekannt als Tomaten. ");

  AddDetail( ({ "tomaten" }),
    "Das sind kleine bis mittelgrosse rote fruchtarte Gewaechse, "
    "welche ueberwiegend strauchartig wachsen. ");

  AddDetail( ({ "gewaechs", "gewaechse" }),
    "Alles, meist pflanzliche, das waechst nennt man so.");

  AddDetail( ({ "salat", "radieschen" }),
    "Fast moechtest Du reingreifen und Dir etwas davon stibitzen. ");

  AddDetail( ({ "kohl", "rosenkohl", "kenntnissen" }),
    "Laut Deinen eigenen Kenntnissen duerfte es sich um Rosenkohl "
    "handeln. Er sieht wirklich herrlich aus mit wundervollen "
    "kraeftig gewachsenen Blaettern. ");

  AddDetail( ({ "blaetter", "blaettern" }),
    "Unter einem Blatt scheint sich etwas zu bewegen. ");

  AddDetail( ({ "blatt" }),
    "Fast wirkt es lebendig. Du greifst ueber den Zaun in das Beet, "
    "und hebst das Blatt hoch. Ploetzlich laeuft ein grosser Kaefer "
    "aufgeschreckt davon. Iiiiiiehh. Wie ekelig. ");

  AddDetail( ({ "zaun" }),
    "Der kleine Vorgarten ist von einem Zaun aus weissen Holzlatten "
    "eingegrenzt. ");

  AddDetail( ({ "holzlatten", "latten" }),
    "Die Latten bestehen aus weiss lakiertem Holz. ");

  AddDetail( ({ "holz" }),
    "Die Holzlatten sind weiss lackiert. ");

  AddDetail( ({ "kaefer", "angst" }),
    "Der kleine Kaefer ist vor lauter Angst schnell weggelaufen. ");

  AddDetail( ({ "petersille", "dill", "lauch", "kraeuter", "kraeutern" }),
    "Bei diesem Anblick moechtest Du Dir daraus sofort einen frischen "
    "Salat machen. ");

  AddDetail( ({ "salat", "anblick" }),
    "Ja ein Salat waere jetzt genau richtig. Jammmm. ");

  AddDetail( ({ "pfeffer", "gruener" }),
    "Es verwundert Dich, dass der hier ueberhaupt waechst. Hier muss "
    "wohl ein fleissiger Gaertner am Werk sein. ");

  AddDetail( ({ "gaertner", "werk" }),
    "Du staunst ueber die Genauigkeit wie die Beete angelegt sind, und "
    "die Sorgfalt, mit der sie gepflegt werden. ");

  AddDetail( ({ "genauigkeit", "sorgfalt" }),
    "Es muss wohl ein wirklich fleissiger Gaertner hier wohnen. ");

  AddDetail( ({ "haeuser", "haus", "haeusern" }),
    "Nunja Du befindest Dich in einer nicht allzukleinen Stadt. "
    "Kein Wunder, dass hier welche stehen - oder? ");

  AddDetail( ({ "wunder" }),
    "Angeblich soll es solche geben... \n"
    "Sicher bist Du dir dabei allerdings nicht. ");

  AddDetail( ({ "wegrand", "rand" }),
    "Der befindet sich seitlich des Weges. ");

  AddDetail( ({ "platz", "weg", "wege", "wegen", "weges" }),
    "Wie schon erwaehnt, er unterscheidet sich nicht wesentlich von "
    "all den anderen hier. Wie fast ueberall liegen vereinzelt ein "
    "paar Steine, Aeste und solch Zeug herum. Obwohl die Stadt an "
    "sich eigentlich schon als Sauber gilt. ");

  AddDetail( ({ "sauber", "zeug" }),
    "Viel Schmutz liegt hier nicht herum. Nur vereinzelt kannst Du "
    "etwas entdecken. Aber auch das beeintraechtigt das Stadtbild "
    "nicht sehr. ");

  AddDetail( ({ "stadtbild", "bild" }),
    "Alles in allem ist es doch eine sehr interessante Stadt. ");
    
  AddDetail( ({ "Aeste", "Ast" }),
    "Doch halt unter einem Ast glaubst Du etwas entdeckt zu haben. "
    "Dem Aeusseren nach schein es aus Stoff zu sein. ");

  AddDetail( ({ "aeusseren", "stoff" }),
    "Als Du naeher hingehst bemerkst Du, dass es sich dabei um ein "
    "normales Papiertaschentuch handelt. ");

  AddDetail( ({ "papiertaschentuch", "taschentuch", "papier", 
    "taschentuches" }),
    "Bei genauerer Betrachtung des Taschentuches bemerkst Du ein "
    "Muster das eingepraegt ist. ");

  AddDetail( ({ "muster", "betrachtung", "wort", "druckfehler" }),
    "Da ist ein Wort eingepraegt: 'Feh'. \n"
    "Du vermutest, dass es fuer eine Fee bestimmt war, aber dann von "
    "dieser weggeworfen wurde, weil das Wort 'Fee' falsch geschrieben "
    "wurde. Auch dir gefaellt ein Taschentuch mit Druckfehler nicht, "
    "also beschliesst Du es liegen zu lassen. ");

  AddDetail( ({ "fee", "wesen" }),
    "Das sind anmutige Wesen. Hier in der naehe sind schon einige "
    "gesehen worden. ");

  AddSound(DEFAULT_SOUND, "Ausser dem Summen einer Biene hoerst Du nur "
    "den ueblichen Strassenlaerm. \n");

  AddSound( ({ "summen", "biene", "summ" } ),
    "Summ Summ Summ. ");

  AddSound( ({ "strassenlaerm", "laerm"}),
    "Es ist der uebliche Laerm, den man hier ueberall in der Stadt zu "
    "hoeren bekommt. Schliesslich ist die Stadt stark frequentiert "
    "von Haendlern und anderen Reisenden. ");

  AddDetail( ({ "haendler", "haendlern", "reisende", "reisenden" }),
    "Viele von denen tummeln sich in der Stadt herum. "
    "Hier sind allerding momentan nur wenige unterwegs. ");

  AddSmell(DEFAULT_SMELL, "Irgendwie riecht es hier nach Kraeutern. \n");

  AddSmell( ({"kraut", "kraeuter", "dressing", "kraeuterdressing" }),
    "Es riecht wie daheim wenn es frisches Kraeuterdressing gibt. ");

//-------------------------------------------------

  AddExit( "osten",  ROOM "room_G-03" );
  AddExit( "westen", ROOM "room_E-03" );

}
