
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "querolin"

create()
{
  ::create();
//---------------------------------------------------

  SetProp(P_INT_LONG,
    "Du befindest Dich auf dem Ostweg, welcher Dich vom noerdlichen zum "
    "suedlichen Ende der Stadt bringt. Richtung Westen gelangst Du ins "
    "Postamt bzw. auf den Markt. Viele Menschen draengen sich auf der "
    "stark frequentierten Kreuzung an Dir vorbei. Ein Dir bekanntes "
    "Geraeusch dringt an Dein Ohr. Auf dem Weg vor Dir liegt etwas "
    "metallenes, dessen Schimmern Deine Aufmerksamkeit erregt. ");

  AddDetail( ({ "kreuzung"}),
    "Hier sind wirklich viele Menschen unterwegs. Als Du ploetzlich einen "
    "aelteren Mann mit einem Hut siehst, musst Du lachen. ");

  AddDetail( ({ "mann", "hut", "hueten" }),
    "Der Hut den der aeltere Mann traegt sieht nicht nur bereits uralt aus, "
    "er hat auch noch eine lange Feder auf ihm stecken. ");

  AddDetail( ({ "feder" }),
    "Auf normalen Hueten findet man die verschiedensten Vogelfeder, aber auf "
    "diesem Hut steckt die Feder eines Papageis. Die Papageienfeder passt "
    "aber absolut nicht auf den alten Hut, findest Du jedenfalls. ");

  AddDetail( ({ "vogelfeder", "vogel","hutfeder","enten","graugaense","gaense",
    "wildgaense","straeusse","strauss","straussenfedern" }),
    "Man kann die unterschiedlichsten Feder als Hutfeder benutzen, Enten, "
    "Graugaense, Wildgaense, kleine Straussenfedern... \n");

  AddDetail( ({ "papageienfeder", "papageis" }),
    "Die Papageienfeder schimmert in allen Farben. Von Rot ueber Gelb, Gruen "
    "bis hin zu Blau sind alle vertreten. ");

  AddDetail( ({ "farben", "rot", "gelb", "gruen", "blau" }),
    "Die Farben passen auf nur den Hut, wenn er als Faschingsdekoration "
    "verwendet wird. ");

  AddDetail( ({ "dekoration", "faschingsdekoration" }),
    "Fuer das waere der Hut gut zu gebrauchen. Ansonten wuerdest Du ihn aber "
    "bestimmt nicht tragen. Nicht mal wenn Du dafuer bezahlt werden wuerdest. ");

  AddDetail( ({ "aufmerksamkeit", "grund" }),
    "Du bist wirklich neugierig. Vielleicht solltest Du dem Schimmern "
    "auf den Grund gehen. ");

  AddDetail( ({ "menschen" }),
    "Dir sind es hier eigentlich schon zuviele hier. Staendig wirst Du "
    "von irgendjemandem angerempelt. Ab und an tritt Dir jemand auf  "
    "deine Schuhe. ");

  AddDetail( ({ "schuhe", "schuh" }),
    "Wofuer Du die heute morgen noch geputzt hast??? Koennen die nicht "
    "besser aufpassen. \n"
    "Du aergerst Dich gruen und blau. \n"
    "Ein metallisches Schimmern faellt Dir dabei ploetzlich auf. ");

  AddDetail( ({ "schimmern", "schimmer", "metallenes", "metallisches" }),
    "Als Du Dich nach unten beugst um das Schimmern genauer zu untersuchen, "
    "bemerkst Du, dass es sich um ein kleines Hufeisen handelt. ");

  AddDetail( ({ "hufeisen", "huf", "eisen" }),
    "Ein Pferd duerfte dieses Hufeisen vermutlich hier verloren haben. "
    "Angeblich bringen Hufeisen Glueck, da Dir das aber zu aberglaeubisch "
    "ist, legst Du das Hufeisen wieder weg und bedauerst kurz das arme "
    "Pferd, welches jetzt ohne das Hufeisen herumlaufen muss. ");

  AddDetail( ({ "glueck" }),
    "Du besitzt nicht genug Aberglauben um ueber Glueck auch nur ein Wort "
    "verlieren zu wollen. ");

  AddDetail( ({ "wort" }),
    "Nicht ein einziges. ");

  AddDetail( ({ "aberglauben", "glauben" }),
    "Nein, aberglaeubisch bist Du was Hufeisen anlangt kein bisschen. ");

  AddDetail( ({ "westen" }),
    "Uber den Weg nach Westen gelangst Du zum Postamt und anschliessend "
    "weiter auf den Markt. ");

  AddDetail( ({ "markt", "postamt" }),
    "Wenn Du nach westen gehst kommst Du am einfachsten und schnellsten "
    "dort hin. ");

  AddDetail( ({ "ostweg" }),
    "Der Ostweg fuehrt Dich vom Norden zum Sueden der Stadt und umgekehrt. "
    "Er bietet eine schnell Moeglichkeit vom einen zum anderen Ende zu "
    "kommen. ");

  AddDetail( ({ "moeglichkeit" }),
    "Natuerlich gibt es auch noch andere. ");

  AddDetail( ({ "ende", "norden", "sueden" }),
    "Vom noerdlichsten zum suedlichsten Winkel der Stadt. ");

  AddDetail( ({ "winkel" }),
    "Na eben von Norden nach Sueden. ");

  AddSound(DEFAULT_SOUND, "Ausser dem ueblichen Strassenlaerm kannst Du "
    "noch Hufschlaege hoeren. \n");

  AddSound( ({ "strassenlaerm","laerm","markt","menschen"}),
    "Am Markt ist es noch lauter, die Menschen hier verhalten sich aber "
    "ebenfalls nicht sehr leise. ");

  AddSound( ({"geraeusch"}), "Das Geraeusch erninnert Dich an Hufe. ");

  AddSound( ({ "hufschlaege","huf","schlaege","hufe","tier"}),
    "Du vermutest, dass hier in der naehe ein Pferd oder ein Esel sein muss. ");

  AddDetail( ({ "pferd", "esel" }),
    "Du kannst kein solches Tier sehen, aber hoeren kannst Du es genau. ");

  AddSmell(DEFAULT_SMELL, "Ein eigenartiger Geruch dringt in deine Nase. \n");

  AddSmell( ({"geruch" }),
    "Irgendwie riecht es nach Stall. ");

  AddSmell( ({"stall"}), "Von wo der Geruch kommt siehst und erschnueffelst "
    "Du leider nicht. ");

  AddDetail( ({ "stall" }),
    "Hier befindet sich kein Stall, vermutlich wird nur ein Tier hier irgedwo "
    "herumlaufen und den Geruch verbreiten. ");

  AddDetail( ({ "nase", "gesicht" }),
    "Die ist mitten im Gesicht. Zumindest bei Dir. ");

//---------------------------------------------------
  AddExit( "norden", ROOM "room_H-06" );
  AddExit( "sueden", ROOM "room_H-04" );
  AddExit( "westen", ROOM "room_G-05" );

}
