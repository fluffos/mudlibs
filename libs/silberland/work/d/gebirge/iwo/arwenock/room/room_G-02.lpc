
#include "../def.h"

inherit STDROOM;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem alten Haus");

  SetProp(P_INT_LONG, "Dieses alte Haus besteht schon seit den "
    "Anfaengen der Stadt Arwenock. Das alte Gebaelk scheint "
    "Dinge gesehen zu haben, von denen Du nichteinmal zu traeumen "
    "wagst. Eine steinerene Treppe fuehrt Dich nach unten.");

  AddDetail( ({ "haus" }), "Du stehst mitten drinnen in einem Haus.");
  AddDetail( ({ "anfaenge" }), "Damals, als erst wenige Haeuser "
    "gebaut waren in Arwenock");
  AddDetail( ({ "stadt", "arwenock" }),
    "Arwenock, so heist diese Stadt des Handels.");
  AddDetail( ({ "gebaelk","holz" }),
    "Das hoelzerne Gebaelk scheint uralt zu sein.");
  AddDetail( ({ "dinge" }),
    "Dinge von denen nicht zu traeumen wagst.");
  AddDetail( ({ "treppe" }),
    "Die schmale Treppe besteht vollstaendig aus Stein. Sie fuehrt "
    "nach unten."); 
  AddDetail( ({ "decke" }),
    "Die Decke ist alt, aber unauffaellig.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waenge gehoeren wohl neu gestrichen. Stellenweise blaettert "
    "die Farbe schon ab.");
  AddDetail( ({ "farbe" }),
    "Recht viel davon findet sich nichtmehr an den Waenden.");
  AddDetail( ({ "stein" }), "Kalt und hart. Sein halt.");

  AddExit( "norden", ROOM "room_G-03" );
  //AddExit("unten", CAVEPATH+"/room/connect03");
  //SetProp(P_HIDE_EXITS, ({ "unten" }));
  AddCmd( ({ "unten" }), "walk_down");

  
}

int walk_down()
{
  tell_object(TP, "Das geht jetzt nicht.\n");
  return 1;
}

