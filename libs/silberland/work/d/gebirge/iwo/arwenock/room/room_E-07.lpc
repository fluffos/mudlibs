#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#define WIZNAME "zaknafein"

create()
{
  ::create();
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_TOWN])); 
  SetProp(P_INT_SHORT, "Auf einem Platz im Armenviertel Arwenocks" );
  SetProp(P_INT_LONG,
    "Du stehst nun auf einem kleinen Platz inmitten des Armenviertels. Hier befindet "
   +"ein kahler Baum, um den mehrere Baenke stehen. Dem Baum entstroemt ein "
   +"unangenehmer Geruch. Am Boden liegen zahlreiche leere Bierflaschen und Scherben. "
   +"Lauter schraege Typen lungern hier rum und betrinken sich.");
 
  AddDetail( ({ "wolke" , "wolken" }) ,
    "Es wird wohl bald regnen.\n");
  AddDetail("sonne" ,
    "Sie ist hinter den Wolken verborgen.\n");
  AddDetail( "himmel" ,
    "Es ist ziemlich bewoelkt.\n");
  AddDetail( ({ "arwenocks" , "arwenock" , "viertel" , "armenviertel" , "armenviertels" }) ,
    "Hier moechtest Du nicht wohnen, glaube mir.\n");
  AddDetail( ({ "punkt" , "treffpunkt" , "platz" }) ,
    "Der Platz dient wohl als Treffpunkt fuer die ueblen Gestalten, die "
   +"hier wohnen.\n");
  AddDetail( ({ "typen" , "gestalten" }) ,
    "Schaue Dich mal um...\n");
  AddDetail("urin" ,
    "Sehen kannst Du ihn nicht, aber riechen...\n");
  AddDetail( ({ "haus" , "haeuser" }) ,
    "Die Haeuser, die den Platz umranden, sehen ziemlich heruntergekommen aus.\n");
  AddDetail( ({ "flasche" , "flaschen" ,"bierflasche" , "bierflaschen" }) ,
    "Sie sind alle leer. Wenn Du Bier haben moechtest, musst Du Dir schon selber "
   +"welches kaufen.\n");
  AddDetail("bier" ,
    "Ich empfehle da Becks, Jever, Flens oder Pilsener Urquell.\n");
  AddDetail( ({ "becks" , "jever", "flens" , "pilsener urquell" , "urquell" , "pilsener" })  ,
    "Sehr lecker das Bier.\n");
  AddDetail("baum" ,
    "Ein kahler Baum steht hier. Er muss ziemlich gelitten haben.\n");
  AddDetail( ({ "bank" , "baenke" }) ,
    "Die Baenke sehen ziemlich demoliert aus. Sich hinzusetzen waere wohl lebensgefaehrlich.\n");
  AddDetail("scherben" ,
    "Es sieht so aus, als ob jemand ein paar Bierflaschen gegen die umliegenden Haeuser "
   +"geworfen hat. Welcher Ruepel das wohl gemacht hat? Passe lieber auf, dass Du Dich nicht "
   +"an ihnen verletzt.\n");
  AddDetail("ruepel" ,
    "Sind keine da?\n");
  AddDetail("boden" ,
    "Der Boden hier auf dem Platz wurde mit Steinen gepflastert. Auf ihm liegen zahlreiche "
   +"leere Bierflaschen.\n");
  AddDetail( ({ "pflastersteine" , "steine" }) ,
    "Die Pflastersteine wurden hier nicht sehr sorgfaeltig verlegt. "
   +"Zwischen den einzelnen Steinen klaffen grosse Luecken.\n");
  AddDetail( ({ "luecke" , "luecken" }) ,
    "Du schaust in eine der Luecken, findest aber nichts.\n");

 
 

  AddSmell( DEFAULT_SMELL , "Dem Baum entstroemt ein ekelhafter Geruch.\n");
  AddSmell( "geruch" ,
            "Hm, das koennte Urin sein.\n");
  AddSmell( "urin" ,
            "Ja klar, solltest mal genau riechen. Vielleicht kannst Du ja feststelllen, wie alt "
           +"er ist. Waer doch interessant...\n");
  AddSound( DEFAULT_SOUND , "Lauter Besoffene groehlen hier rum.\n");
  AddSound( ({ "besoffene" ,"groehlen" }) , 
               "Es ist nicht besonders interessant, glaube mir.\n");

  AddItem(NPC "zruepel" , REFRESH_DESTRUCT);
  AddItem(NPC "zruepel" , REFRESH_DESTRUCT);
  AddItem(NPC "zruepel" , REFRESH_DESTRUCT);
  //AddItem(NPC "zdieb" , REFRESH_DESTRUCT);
  AddExit( "westen", ROOM "room_D-07" );
  AddExit( "osten", ROOM "room_F-07" );

}
