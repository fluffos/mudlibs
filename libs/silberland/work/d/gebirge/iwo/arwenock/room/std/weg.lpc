#include "../def.h"

inherit STDROOM;


#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, sprintf("Auf einem Weg in %s", STADT));
  SetProp( P_INT_LONG, sprintf(
           "Der Weg fuehrt Dich durch die Stadt %s. Immerwieder schubsen "
	   "Dich vorbeilaufende Passanten, und Geplauder dringt an Dein "
	   "Ohr.", STADT));
           
  AddDetail( ({ STADT, "stadt" }), sprintf(
           "Ja, %s heisst die Stadt in der Du Dich gerade befindest.", STADT));

  AddDetail( ({ "weg" }),
           "Der Weg bringt Dich durch die Stadt. Der Boden ist mit "
	   "Pflastersteinen befestigt, die Deinen Fuessen festen Halt "
	   "geben.");
	   
  AddDetail( ({ "boden" }),
           "Ausser den Pflastersteinen und etwas Schmutz kannst Du am Boden "
	   "nichts Auffaelliges erkennen.");
	   
  AddDetail( ({ "pflastersteine", "pflaster", "steine", "pflastersteinen" }),
           "Fast quadratische Steinquader. Einer faellt Dir besonders auf.");
	   
  AddDetail( ({ "steinquader", "quader", "stein", "pflasterstein" }),
           "Ui, doch nichts. Du hast Dich wahrscheinlich getaeuscht.");
	   
  AddDetail( ({ "schmutz", "strassenschmutz" }),
           "Der uebliche Strassenschmutz halt, wie er auf jedem Weg oder "
	   "jeder Strasse zu finden ist.");

  AddDetail( ({ "strasse" }),
           "Du bist Dir nicht sicher, ob Du dies als Weg oder als Strasse "
	   "bezeichenen sollst. Wenn mans genau nimmt, ist es auch egal.");
	   
  AddDetail( ({ "fuesse", "fuessen" }),
           "Du spielst mit den Zehen, und freust Dich, dass sie sich "
	   "wirklich auf Kommando bewegen.");
	   
  AddDetail( ({ "zehen", "dinger"}),
           "Kleine, knuppelinge Dinger.");

  AddDetail( ({ "kommando" }),
           "Das interessiert Dich nicht wirklich.");

  AddDetail( ({ "ohr" }),
           "Du wackelst mit dem Ohr.");

  AddDetail( ({ "gebaeude", "gebaeuden" }),
           "Ja, sowas gibt es bekanntlich in einer Stadt.");

  AddDetail( ({ "passanten" }),
           "Immerwieder huscht jemand vorbei an Dir. Du solltest auf "
	   "Deine Geldboerse achten.");

  AddDetail( ({ "auffaelliges" }),
           "Sowas siehst Du eben nicht!");

  AddDetail( ({ "himmel" }),
           "Der Himmel ist strahlend blau hier.");

  AddDetail( ({ "halt" }), 
           "Die Pflastersteine geben Deinen Fuessen ausreichend davon.");

	   
  AddSound( ({ "plaudern", "geplauder" }),
           "Es scheint aus den Gebaeuden zu dringen.");
	  	   
}


void reset()
{
  if (!AMASTER->EventActive()) ::reset();
}
