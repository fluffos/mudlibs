
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "zaknafein"

create()
{
  ::create();
  //SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_TOWN])); 
  SetProp(P_INT_SHORT, "In einem schaebigen Stadtteil von Arwenock" );
  SetProp(P_INT_LONG,
    "Du schlenderst weiter die dunkle, enge Gasse entlang. Die verfallenen Haeuser "
   +"hinterlassen langsam einen deprimierenden Eindruck bei Dir. Manchmal stolperst "
   +"Du ueber einen Pflasterstein, der aus dem Boden herausragt. Im Westen befindet "
   +"sich ein kleiner Platz, auf dem sich Betrunkene herumtreiben und groehlen.");

  AddDetail( ({ "westen" , "platz" }) ,
    "Der Platz befindet sich westlich von Dir. Kannst ja mal hingehen.\n");
  AddDetail( "eindruck" ,
    "Viele glauben es nicht, aber Du bist wirklich sehr sensibel.\n");
  AddDetail("himmel" ,
    "Ein paar Wolken verdecken die Sonne.\n");
  AddDetail( ({ "wolke" , "wolken" }) ,
    "Es wird wohl bald regnen.\n");
  AddDetail("sonne" ,
    "Sie ist hinter den Wolken verborgen.\n");
  AddDetail( ({ "strahl" , "sonnenstrahl" }) ,
    "Hierher verirren sich nur wenige Sonnenstrahlen, weshalb es auch "
   +"finster ist.\n");
  AddDetail( ({ "arwenocks" , "arwenock" , "viertel" , "armenviertel" }) ,
    "Hier moechtest Du nicht wohnen, glaube mir.\n");
  AddDetail( "betrunkene" ,
    "Manchmal hoerst Du, wie sie groehlen.\n");
  AddDetail( "haeuser" ,
    "Die Haeuser sind hier ebenso heruntergekommen wie anderswo in dem "
   +"Armenviertel auch.\n");
  AddDetail( "gasse" ,
    "Lauter zerfallene Haeuser, arme Leute... Wirklich deprimierend!\n");
  AddDetail( "leute" ,
    "Sie wohnen in den Haeusern hier.\n");
  AddDetail("boden" ,
    "Der Boden hier in der Gasse wurde mit Steinen gepflastert.\n");
  AddDetail( ({ "pflastersteine" , "steine" }) ,
    "Die Pflastersteine wurden hier nicht sehr sorgfaeltig verlegt. "
   +"Manchmal ragen welche so weit aus dem Boden heraus, dass man leicht ueber sie "
   +"stolpern kann.\n");
  AddDetail( ({ "stein" , "pflasterstein" }) ,
    "Hm, ist das nicht der, ueber den Du gerade gestolpert bist?\n");

  AddSmell( DEFAULT_SMELL , "Welch ein Gestank hier!\n");
  AddSmell( ({ "gestank" }) ,
            "Der Gestank kommt aus den umliegenden Haeusern.\n");
  AddSound( DEFAULT_SOUND , "Du hoerst ein paar Betrunkene groehlen.\n");
  AddSound( ({"betrunkene" , "groehlen" , "westen" }) , 
               "Das Groehlen kommt aus dem Westen.\n");
  AddExit( "westen", ROOM "room_E-07" );
  AddExit( "osten", ROOM "room_G-07" );

}
