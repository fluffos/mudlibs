
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Westlich fuehrt der Weg in weiterer Folge zum Stadttor. "
    "In oestlicher Richtung liegt eine Biegung nach Norden. "
    "Hier in den Randwegen ist weniger los, als in der restlichen "
    "Stadt. Dennoch herrscht hier mehr oder weniger reger "
    "Personenverkehr.");
  AddDetail( ({ "weg", "weges" }),
    "Der bequem breite Weg ist mit Pflastersteinen befestigt.");
  AddDetail( ({ "folge", "folgen" }),
    "Beinahe alles hat Folgen.");
  AddDetail( ({ "stadttor", "tor" }),
    "Das Stadttor dient dazu, die Stadt bei Gefahr zu verriegeln. "
    "Sehen kannst Du es jedoch von hier nicht.");
  AddDetail( ({ "gefahr", "angreifer", "art" }),
    "Angreifer jeder Art.");
  AddDetail( ({ "richtung" }),
    "Nachdem Du an keinem Ende des Weges bist, gibt es zwei davon.");
  AddDetail( ({ "ende" }),
    "Da hoert etwas auf.");
  AddDetail( ({ "biegung" }),
    "Leider kannst Du um diese nicht rumsehen, aber Du kannst "
    "erkennen, dass der Weg danach nach Norden weiterfuehrt.");
  AddDetail( ({ "norden" }),
    "Dahin kannst Du gehen, jedoch nicht sehen.");
  AddDetail( ({ "randwege", "wege", "randwegen" }),
    "Die Randwege sind etwas abseits von Zentrum.");
  AddDetail( ({ "zentrum" }),
    "Das kannst Du hier nicht sehen.");
  AddDetail( ({ "personenverkehr", "verkehr" }),
    "Gelegentlich ist der Weg hier sehr stark frequentiert.");
  AddDetail( ({ "frequenz" }),
    "80 Hertz");
  AddDetail( ({ "hertz" }),
    "Summmmmmmmm....");



  AddExit( "osten", ROOM "room_F-01" );
  AddExit( "westen", ROOM "room_D-01" );

}
