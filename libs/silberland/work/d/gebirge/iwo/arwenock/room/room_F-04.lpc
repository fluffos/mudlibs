#define WIZNAME "Iwo"
#include "../def.h"

inherit STDROOM;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
// #include "files.h"


// function predef
string paradings();
string magierfkt();
string woodyfkt();
string dustyfkt();

create()
{
  ::create();

  SetProp(P_INT_SHORT, sprintf("In der Kirche von %s", STADT));

  SetProp(P_INT_LONG,
      "Du befindest Dich in der Kirche von Arwenock. Wohliges "
      "Licht durchdringt die grossen, verzierten Fenster und "
      "flutet den Raum mit Lichtstrahlen in den verschiedensten "
      "Farben. Ein grosser Altar im vorderen Bereich ziert ein "
      "Podest, auf welchem die Priester ihre Lobgesaenge und "
      "Predigten abhalten.");


  AddDetail( ({ "kirche" }),
      "An diesem Ort kannst Du Dich besinnen und Deine Goetter "
      "anbeten. Diese Kirche sit wohl speziell Dusty gewidmet, "
      "denn die grosse Statue in der Ecke ist ein Abbild von "
      "ihr.");
      
  AddDetail( ({ "dusty", "abbild" }),
      "Auch wenn eine Statue kaum ihre unglaubliche Schoenheit "
      "wiedergeben kann, ist dieses Gebilde doch von feinster "
      "Qualitaet und der Anblick laesst Dich vor Ehrfurcht und "
      "Liebe erstarren.");
      
  AddDetail( ({ "ehrfurcht", "liebe" }), #'paradings);      

  AddDetail( ({ "altar" }),
      "Der maechtige Altar ist in der Mitte mit einem strahlend "
      "weissen Tuch abgedeckt. Darauf steht eine Vase mit "
      "verschiedenen Wiesenblumen.");
      
  AddDetail( ({ "tuch" }),
      "Das Tuch ist reinweiss, und ziert den Altar. Es scheint, als "
      "waere darunter eine art Relief.");
      
  AddDetail( ({ "relief" }),
      "Leider kannst Du nicht genug sehen, um zu erkennen "
      "was das ist, aber vielleicht kannst Du es ja irgendwie "
      "anders wahrnehmen.");
      
  AddDetail( ({ "vase" }),
      "In der beinahe schon schlicht anmutenden Vase aus Ton steckt "
      "ein Strauss verschiedener Wiesenblumen.");
      
  AddDetail( ({ "ton" }),
      "Die Formen der Vase wirken klar und einfach. Irgendwie passt "
      "das garnicht so recht in das bombastische Bauwerk.");
      
  AddDetail( ({"strauss", "blumenstrauss", "wiesenblumen", "blumen", "inhalt"}),
      "Die Blumen sind einfach und wunderschoen. Scheinbar ist Dusty "
      "eine sehr naturverbundene Goettin und diese einfache Vase "
      "mit dem wunderschoenen natuerlichen Inhalt wurde speziell "
      "aufgestellt, um sie zu ehren.");

  AddDetail( ({ "bauwerk" }),
      "Du kannst nur vermuten, wer dieses wunderbare Bauwerk geschaffen "
      "hat, aber Du bist Dir ziemlich sicher, dass Magie im spiel war.");
      
  AddDetail( ({ "magie" }),
      "Anscheinend gibt es auch Magier die Dusty ehren und schaetzen.");

  AddDetail( ({ "form", "formen" }),
      "Die Formen sind klar und einfach.");
      
  AddDetail( ({ "magier" }), #'magierfkt);

  AddDetail( ({ "goettin" }),
      "Zum Anbeginn der Zeit hat die Goettin Dusty zusammen mit "
      "Gott Woody begonnen diese Welt zu erschaffen.");
      
  AddDetail( ({ "dusty" }), #'dustyfkt);
  
  AddDetail( ({ "woody" }), #'woodyfkt);
  
  AddDetail( ({ "gott" }),
      "Woody ist Gott hier.");

  AddDetail( ({ "anbeginn", "entstehungszeit", "ereignisse" }),
      "Am Anbeginn der Zeit gab es hier weder Land, noch Lebewesen. "
      "Sphaerisches Rauschen erfuellte die Ebenen - nur das Geplauder "
      "der Goetter und die astralen Beben hervorgerufen durch ihr "
      "Schaffen waren wahrzunehmen.");
      
  AddDetail( ({ "ebenen" }),
      "Du denkst . o O (hilfe ebenen ist toll)");
      
  AddDetail( ({ "beben", "schaffen" }),
      "Die Erde erzitterte, und die Luft bebte im Wandel des Nichts "
      "zu einer Welt wie sie nie jemand zuvor gesehen haben sollte.");

  AddDetail( ({ "nichts", "zeit" }),
      "Absolut nichts war da zum Anbeginn der Zeit.");      

  AddDetail( ({ "erde" }),
      "Aus ihr wurdest Du geschaffen, also behandle sie mit dem noetigen "
      "Respekt.");
      
  AddDetail( ({ "respekt" }),
      "Vergiss nicht: Respekt ist alles.");

  AddDetail( ({ "luft" }),
      "Heute ist die Luft klar und geeignet fuer Dich zum Atmen. Das "
      "hast Du alleine den Goettern zu verdanken.");

  AddDetail( ({ "atem", "atmen" }),
      "Du holst tief Luft und fuellst Deine Lungen mit dem Elixier des "
      "Leben.");      

  AddDetail( ({ "elixier" }),
      "Die Luft ist eines der wichtigsten um leben zu koennen.");
      
  AddDetail( ({ "leben" }),
      "Du forscht - also bist Du.");      

  AddDetail( ({ "lunge", "lungen" }),
      "Es waer ziemlich krank, koenntest Du Deine Lungen einfach so "
      "sehen.");

  AddDetail( ({ "wandel", "ereignis" }),
      "Ja, der Wandel vom Nichts zu der Welt wie Du sie heute kennst "
      "war ein wahrlich grossartiges Ereignis.");

  AddDetail( ({ "geplauder" }),
      "Selbst heute noch kann man wenn man ganz leise ist und gut "
      "aufpasst von Zeit zu Zeit die goettlichen Stimmen vernehmen.");
      
  AddDetail( ({ "stimmen" }),
      "Wenn Du jetzt Stimmen hoerst solltest Du das dringend behandeln "
      "lassen.");

  AddDetail( ({ "land", "silberland", "welt" }),
      "Als die Goetter ihr Werk vollendet hatten und sahen, dass es "
      "gut war entschieden sie dieses Land 'SilberLand' zu nennen.");

  AddDetail( ({ "werk" }),
      "Die Goetter haben gute Arbeit geleistet, denn das Land ist "
      "fruchtbar und die Lebewesen vermehren sich mit unglaublicher "
      "Schnelle.");
      
  AddDetail( ({ "schnelle", "wort" }),
      "Eigentlich kein recht schoenes Wort :->");

  AddDetail( ({ "arbeit", "dienste" }),
      "Heute verrichten die Arbeiten hauptsaechlich die Magier, die "
      "- so hoffe ich - auch akzeptable Dienste leisten.");      

  AddDetail( ({ "lebewesen" }),
      "Lebewesen der verschiedensten Kulturen und Rassen treiben sich "
      "hier nun rum, und fuellen die Ebenen und Raeume mit Leben.");
      
  AddDetail( ({ "rassen", "kulturen" }),
      "Das ginge nun wohl zu weit es zu erklaeren.");

  AddDetail( ({ "raeume" }),
      "Du stehst in einem von ihnen.");
      
  AddDetail( ({ "rauschen" }),
      "Ein rauschen, wie es nur direkt nach dem Weltuntergang zu "
      "hoeren ist.");

  AddDetail( ({ "armageddon", "weltuntergang" }),
      "Armageddon wird ihn wohl rechtzeitig verkuenden.");
      
  AddDetail( ({ "arwenock", "staedchen" }),
      "So heisst das schoene Staedchen in dem Du Dich gerade "
      "befindest.");

  AddDetail( ({ "bereich", "geltung", "rest", "podest" }),
      "Der Bereich um den Altar ist etwas erhoben gegenueber "
      "dem Rest der Kirche um ihn mehr zur Geltung zu bringen.");
      
  AddDetail( ({ "boden", "marmor", "silberlandmarmor" }),
      "Der Boden ist mit echtem Silberlandmarmor ausgelegt.");
      
  AddDetail( ({ "farben" }),
      "Die Farben entstehen durch das farbige Glas das die "
      "Fensterscheiben bildet.");

  AddDetail( ({ "fenster", "scheiben", "glas", "glasscheiben", "fensterscheiben" }),
      "Die Fenster bestehen aus farbigen Glasscheiben, die "
      "verschiedene Ereignisse aus der Entstehungszeit des "
      "SilberLandes darstellen.");
      
  AddDetail( ({ "himmel" }),
     "Um den Himmel zu sehen wirst Du wohl ins Freie gehen muessen, aber "
     "Du ahnst, dass irgendwo da oben die Goetter sitzen und ueber Dich "
     "wachen.");
     
  AddDetail( ({ "freie", "freies" }),
     "Nach westen kommst Du wieder raus ins Freie."); 
            
  AddDetail( ({ "goetter" }),
     "Die Goetter hier sind Dusty und Woody.");

  AddDetail( ({ "anblick" }),
     "Du zitterst vor Ehrfurcht.");
     
  AddDetail( ({ "gebilde" }),
     "Das Gebilde ist ein Abbild Dustys");
     
  AddDetail( ({ "qualitaet", "zeugnis", "handwerkskunst" }),
     "Ein Zeugnis bester Handwerkskunst.");

  AddDetail( ({ "schoenheit", "antlitz" }),
     "Unbeschreibliche Schoenheit ziert das Antlitz Dustys so dass "
     "es unmoeglich waere es hier in Worte oder Gedanken zu fassen. "
     "Vielleicht hast Du selbst einmal das Glueck ihr zu begegenen "
     "um einen Hauch ihrer Vollkommenheit wahrzunehmen.");
     
  AddDetail( ({ "hauch" }),
     "Nur einen Hauch. Ganz wenig also.");
     
  AddDetail( ({ "glueck" }),
      "Gluecklich sein ist auch nur Glueck.");
      
  AddDetail( ({ "vollkommenheit" }),
      "Ihre Vollkommenheit ist es was Dich so beeindruckt.");
      
  AddDetail( ({ "worte", "gedanken" }),
      "In eben jene kann man es nicht fassen.");
      
  AddDetail( ({ "ecke" }),
      "In der Ecke, die eigentlich den zentralsten Punkt "
      "darstellt, erhebt sich eine goettliche Statue Dustys.");
      
  AddDetail( ({ "punkt" }),
      ".");
      
  AddDetail( ({ "strich" }),
      "-");

  AddDetail( ({ "statue" }),
      "Die Statue zeigt Dusty in ihrerer Vollkommenheit.");
      
  AddDetail( ({ "lichtstrahlen", "strahlen", "licht" }),
      "Das Licht wird durch die farbigen Glasscheiben gebrochen "
      "und erscheint dadurch in den schoensten Farben.");
      
  AddDetail( ({ "gesaenge", "lobgesaenge" }),
      "Momentan kannst Du keine hoeren, aber Du bist Dir sicher, dass "
      "Du sie auch garnicht hoeren willst.");
      
  AddDetail( ({ "ort", "staette" }),
      "Dieser Ort hier ist eine heilige Staette. Bitte verhalte "
      "Dich angemessen.");

  AddDetail( ({ "predigt", "predigten" }),
      "Hie und da wird hier gemeinsam zu Dusty gebetet. Momentan "
      "aber kannst Du in Ruhe alleine beten.");
      
  AddDetail( ({ "ruhe" }),
     "Angenehme Ruhe erfuellt den Raum.");
     
  AddSound(DEFAULT_SOUND, "Es ist angenehm ruhig.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht etwas nach Weihrauch.");
  
  AddSmell( ({"weihrauch", "rauch" }),
      "Ein angenehmer Duft, der Deine Nase liebkost.");
      
  AddDetail( ({ "nase" }),
      "Das Stupsdings in Deinem Gesicht.");

  AddDetail( ({ "stupsdings" }),
      "Suess. :-)");
      
  AddDetail( ({ "gesicht" }),
      "Das wirst Du wohl kaum sehen :-)");
      
  AddDetail( ({ "duft" }),
      "Du kannst riechen.");
      
  AddDetail( ({ "priester" }),
      "Zur Zeit ist kein Priester da, aber vielleicht kommt "
      "er ja wieder.");
      
  AddDetail( ({ "raum" }),
      "Du stehst in der Kirche.");

  AddDetail( ({ "mitte" }),
      "In der Mitte steht ein Altar.");      

  AddCmd( ({ "taste", "tast", "ertaste", "ertast", "fuehl", "fuehle" }),
    "relieffkt");

  AddCmd( ({ "hebe", "heb" }), "tuchheben");
  AddCmd( ({ "bete", "bet", "beten" }), "bete");

  AddExit( "westen", ROOM "room_E-04" );

}

string magierfkt()
{
  TP->command_me("hilfe magier");
  return "Du bist nun um einiges klueger.\n";
}

string dustyfkt()
{
  TP->command_me("finger dusty");
  return "Das ist Dusty.\n";
}

string woodyfkt()
{
  TP->command_me("finger woody");
  return "Das ist Woody.\n";
}


string paradings()
{
  TP->SetProp(P_PARALYZED, ([PARALYZE_MSG: "Du bist erstarrt vor Ehrfurcht\n",
                             PARALYZE_TIME: 10,
			     PARALYZE_MSG_OTHER: "%s erstarrt vor Ehrfurcht\n",
		             PARALYZE_END: "Du kriegst Dich wieder ein.\n",
			     ]));

  return "Du erstarrst vor Ehrfurcht und Liebe.\n";

}


int relieffkt(string str)
{
  notify_fail("Was willst Du denn ertasten?\n");
  if (!str || strstr(str, "relief") == -1) return 0;
  
  tell_object(TP, BS("Du schliesst die Augen und versuchst durch "
                     "Ertasten das Relief zu erkennen. Leider kannst "
		     "Du nicht feststellen worum es sich handelt. "
		     "Vielleicht kannst Du das Tuch ja mal aufheben?"));

  return 1;
  
}


int tuchheben(string str)
{
  notify_fail("Was willst Du denn anheben?\n");
  if(!str || strstr(str, "tuch") == -1) return 0;
  
  tell_object(TP, BS("Vorsichtig hebst Du das Tuch an und erhascht "
                     "einen fluechtigen Blick auf das Relief."));
		     
  tell_object(TP, BS("Es Zeigt ein Ritual wie ein Zwerg vor Dusty "
                     "kniet und nach ein paar merkwuerdigen Gesten "
		     "als Elf sich erhebt."));
		     
  return 1;
}


// 1:1 von Woody Kapelle in Midas kopiert

bete() {
  write ("Du kniest nieder und haeltst eine kurze Andacht.\n");
  if (this_player()->QueryProp(P_GHOST))
  {
    say ("Der Geist von "+this_player()->name()+
        " kniet nieder und haelt eine kurze Andacht.\n");
    write ("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "+
      "aus.\nDu spuerst langsam wieder, wie Blut Deinen Koerper von neuem "+
      "durchstroemt.\n");
    say (this_player()->name()+" erscheint ploetzlich wieder in "+
      "koerperlicher Form.\n");
    this_player()->SetProp(P_GHOST,0);
  }
  else
    say (this_player()->name()+" kniet nieder und haelt eine kurze Andacht.\n");
  return 1;
}

