
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

#define WIZNAME "creative"

create()
{
  ::create();

  SetProp(P_INT_LONG, 
    "Hier, entlang der Haeuser tut sich nicht besonders viel. "
    "Gelegentlich schlendern Fremde vorbei um Ihren Rundgang "
    "durch die Stadt gen Stadttor abzuschliessen. Die Eingeborenen "
    "hasten hier nur schnell durch, um moeglichst schnell voran zu "
    "kommen.");
  AddDetail( ({ "haeuser" }),
    "Die Haeuser hier sind nicht sonderlich interessant. Hier ein "
    "Fenster, da eine Wand...");
  AddDetail( ({ "fenster" }),
    "Etwas Holz, etwas Glas und auf einem pickt a z'gatschte Fliege.");
  AddDetail( ({ "fliege" }),
    "Die hatte sicher auch schon einen besseren Tag. Flache Sache :-)");
  AddDetail( ({ "glas" }),
    "Nachdem Glas durchsichtig ist, kannst Du es nicht sehen. Nur "
    "ein paar Fingerabdruecke lassen Dich vermuten, dass die Fenster "
    "doch nicht einfach nur Loecher sind.");
  AddDetail( ({ "eingeborene" }),
    "Blo'fuassade - das solltest Du ihnen gegenueber aber nicht "
    "erwaehnen.");
  
  AddDetail( ({ "fingerabdruecke", "abdruecke" }),
    "Fettige Flecken von Wurstfingern.");
  AddDetail( ({ "flecken" }),
    "Igitt.");
  AddDetail( ({ "wurstfingern", "wurstfinger", "finger" }),
    "Du wackelst mit Deinen Fingern und schmunzelst.");
  AddDetail( ({ "loecher" }),
    "Siehst Du keine - ist Glas davor.");
  AddDetail( ({ "fremde" }),
    "Du fuehlst, dass Du gemeint bist.");
  AddDetail( ({ "holz" }),
    "Die Fensterrahmen sind aus Holz.");
  AddDetail( ({ "fensterrahmen", "rahmen" }),
    "Ja, Fensterrahmen. Aus Holz. Pfoah ey!");
  AddDetail( ({ "rundgang" }),
    "Kamma dat sehn?");
  AddDetail( ({ "stadttor", "tor" }),
    "Das Stadttor ist woanders. Im Westen naemlich."); 

  AddExit( "osten", ROOM "room_H-01" );
  AddExit( "westen", ROOM "room_F-01" );

}
