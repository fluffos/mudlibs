#include "../def.h"

inherit STDROOM;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>

#define WIZNAME "iwo"

#define OFFEN 1
#define GESCHLOSSEN 0

#define KASTEN_H 1
#define KASTEN_K 2


// Prototypes
void SetupKastenInv();



int s_kasten_h = GESCHLOSSEN;
int s_kasten_k = GESCHLOSSEN; 

object kasten_h_cont;
object kasten_k_cont;

int socken = 1;
int floor_dirty = 1;

create()
{
  ::create();
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_HOUSE])); 
  SetProp(P_INT_SHORT, "In einer kleinen Reihenhauswohnung" );
  SetProp(P_INT_LONG,
    "Hier sieht es ziemlich chaotisch aus. Waehrend sich ein Teil "
    "des an sich recht stattlichen Raumes zu einer Art Eingangsbereich "
    "formt, gibt es hier auch noch eine Wohn- und Esskueche. "
    "Anscheinend gibt es hier keine Rumpelkammer, denn das ganze "
    "Zeugs, dass man sonst fein saeuberlich in einem dunklen "
    "Kaemmerchen verschwinden laesst, ist hier irgendwie gleichmaessig "
    "in der Gegend verteilt, um zumindest den Anschein von Ordnung "
