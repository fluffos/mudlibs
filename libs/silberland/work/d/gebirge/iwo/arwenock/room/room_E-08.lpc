int do_clean(string what)
{
  object eimer;
  object mob;
  int fill;

  notify_fail("Was moechtest Du wischen?\n");
  if (what != "boden") return 0;

  notify_fail("Dazu brauchst Du wohl einen Eimer.\n");
  if (!(eimer = present("eimer", TP)))
    return 0;  

  notify_fail("Mit einem leeren Eimer wird das wohl nichts.\n");
  if (!(fill = eimer->QueryFill())) return 0;

  notify_fail("In dem Eimer ist doch viel zu wenig Wasser!\n");
  if (fill < 5) return 0;

  notify_fail("Willst Du mit den Haenden aufwischen?\n");
  if (!(mob = present("mob", TP))) return 0;

  notify_fail("Du solltest den Mob schon zuecken!\n");
  if (!mob->QueryWielded()) return 0;

  notify_fail("Aber der Boden ist doch schon sauber!\n");
  if (!floor_dirty) return 0;

  tell_object(TP, BS("Voller Enthusiasmus nimmst Du den Mob "
                     "fester in die Hand, und beginnst "
                     "schwungvoll den Boden zu wischen."));
  tell_room(ME, BS(TP->Name(WER) + " fasst sich ein Herz "
                   "und wischt den Boden."));

  TP->SetProp(P_PARALYZED,
    ([ PARALYZE_TIME: 10,
       PARALYZE_MSG: BS("Voller Enthusiasmus nimmst Du den Mob "
                        "fester in die Hand, und beginnst "
                         "schwungvoll den Boden zu wischen."),
       PARALYZE_MSG_OTHER: BS(TP->Name(WER) + " fasst sich ein Herz "
                              "und wischt den Boden."),
       PARALYZE_END: BS("Zufrieden betrachtest Du Dein Werk."),
       PARALYZE_END_OTHER: BS(TP->Name(WER) + " grinst glorreich.") ]));

  eimer->AddFill(-fill);

  floor_dirty = 0;

  return 1;
}



string d_floor(string key)
{
  if (!floor_dirty)
    return BS("Der Boden scheint frisch gewischt zu sein.");

  return BS("Der Boden ist etwas schmutzig. Hier sollte mal "
            "Jemand sauber machen.");
}



string d_underwear(string key)
{
  string str;

  str = "Du willst nicht wirklich in fremder Unterwaesche "
      + "wuehlen";
  if (socken) str += ", jedoch fallen Dir Stutzen auf.";
  else str += ".";

  return BS(str);

}

string d_socks(string key)
{
  string str;

  if (!socken)
    return BS("Huch, da war wohl schon jemand vor Dir da.");

  return BS("Inmitten der Kisten liegen doch tatsaechlich zwei "
            "Stutzen. Du koenntest sie eventuell nehmen.");

}


int GetSocks()
{
  object ob;

  if (!socken)
    {
      tell_object(TP, BS("Es sind leider keine Stutzen mehr da."));
      return 1;
    }

  ob = clone_object(ARMOUR "stutze.lpc");

  if (ob->move(TP, M_GET) == ME_TOO_HEAVY)
    {
      tell_object(TP, BS("Du kannst " + ob->name(WEN) + " nicht mehr "
        "tragen."));
      ob->move(ME);
    }
  
  ob = clone_object(ARMOUR "stutze.lpc");

  if (ob->move(TP, M_GET) == ME_TOO_HEAVY)
    {
      tell_object(TP, BS("Du kannst " + ob->name(WEN) + " nicht mehr "
        "tragen."));
      ob->move(ME);
    }

  socken = 0;

  return 1;  
}


int do_get(string str)
{
  string format,
         what, 
         where;

  object cont,
         ob;

  int    k_status,
         mval;

  if (str == "stutzen" || str == "stutzen aus kiste")
    return GetSocks();

  format = "%s aus %s kasten";

  notify_fail("Was willst Du nehmen?\n");
  if (!sscanf(str, format, what, where)==2) return 0;

  notify_fail("Was willst Du woraus nehmen?\n");

  switch (where)
    {
      case "hohem":
      case "hohen":
        cont     = kasten_h_cont;
        k_status = s_kasten_h;
        break;
      case "kleinem":
      case "kleinen":
        cont     = kasten_k_cont;
        k_status = s_kasten_k;
        break;
      default:
        return 0;
    }


  if (k_status != OFFEN)
    {
      tell_object(TP, BS("Der Kasten ist doch geschlossen!\n"));
      return 1;
    }



  if (!(ob = present(what, cont)))
    return 0;

  notify_fail("Nimmfehler!i\n");
  if (!(mval = ob->move(TP, M_GET)))
    {
      switch(mval)
        {
          case ME_TOO_HEAVY:
            tell_object(TP, BS("Du kannst " 
                           + ob->name(WEN) 
                           + " nicht mehr tragen!"));
            break;
          default:
            tell_object(TP, BS("Etwas verhindert, dass Du "
                           + ob->name(WEN)
                           + " nimmst!"));
        }
      return 1;
    } // if (!(mval = ob->move(TP, M_GET)))

  tell_object(TP, BS("Du nimmst " + ob->name(WEN) + "."));
  tell_room(ME, BS(TP->Name(WER) + " nimmt " + ob->name(WEN) + "."),
    /* Exclude */ ({ TP }) );

  return 1;

}




void SetupKastenInv()
{
  object ob;

  // Hoher Kasten
  ob = clone_object("/obj/fackel.lpc");
  if (objectp(ob))
      ob->move(kasten_h_cont, M_NOCHECK);

  ob = clone_object(ARMOUR "eimer.lpc");
  if (objectp(ob))
      ob->move(kasten_h_cont, M_NOCHECK);

  ob = clone_object(WEAPON "besen.lpc");
  if (objectp(ob))
      ob->move(kasten_h_cont, M_NOCHECK);

  ob = clone_object(WEAPON "mob.lpc");
  if (objectp(ob))
      ob->move(kasten_h_cont, M_NOCHECK);

/*
  ob = clone_object(ARMOUR "kehrschaufel.lpc");
  if (objectp(ob)) kasten_h_inv += ({ ob });

  ob = clone_object(WEAPON "spaten.lpc");
  if (objectp(ob)) kasten_h_inv += ({ ob });

  ob = clone_object(WEAPON "harke.lpc");
  if (objectp(ob)) kasten_h_inv += ({ ob });

  ob = clone_object(WEAPON "rechen.lpc");
  if (objectp(ob)) kasten_h_inv += ({ ob });
*/
}





string ShowInv(object cont, object pl)
{
  object *inv;
  int i;
  string str;

  if (!cont)
    return "FEHLER!\n";

  inv = all_inventory(cont);

  if (sizeof(inv)<=0)
    return "Nichts.\n";

  str = "";

  for (i=0; i < sizeof(inv); i++)
    str += inv[i]->Name(WER) + ".\n";

  return str;
}


string d_kasten_h(string key)
{
  string str;
  string str2;

  str = "Der hoehere der beiden Kaesten ist in etwa so hoch wie "
      + "ein etwas groesserer Zwerg. An seinen Tueren sind kleine "
      + "hoelzerne Knaeufe befestigt.";

  switch (s_kasten_h)
    {
      case OFFEN:
        str += " Anscheinend ist der Kasten die Sparvariante einer "
             + "Rumpelkammer. Darin finden sich: ";
        str2 = ShowInv(kasten_h_cont, TP);
        
        break;
      default:
        str += " Der Kasten ist geschlossen.";
    }

  return BS(str) + str2;

}

int DoFail(string str)
{
  notify_fail(BS(str));
  return 0;
}


int DoOpen(string what)
{
  switch (what)
    {
      case "kasten":
        notify_fail("Was moechtest Du oeffnen?\n");
        return 0;
      case "hohen kasten":
        if (s_kasten_h == OFFEN)
          return DoFail("Der Kasten ist doch schon offen!");
        tell_object(TP, BS("Der hohe Kasten quietscht etwas, als "
                           "Du ihn oeffnest."));
        tell_room(ME, BS(TP->Name(WER) + " oeffnet einen hohen Kasten."),
                  ({ TP }));
        s_kasten_h = OFFEN;
        return 1;
      case "kleinen kasten":
        if (s_kasten_k == OFFEN)
          return DoFail("Der Kasten ist doch schon offen!");
        tell_object(TP, BS("Schwungvoll oeffnest Du den kleineren "
                           "Kasten."));
        tell_room(ME, BS(TP->Name(WER) + " oeffnet einen kleinen "
                         "kasten"), ({ TP }));
        s_kasten_k = OFFEN;
        return 1;
      default:
        notify_fail("Was moechtest Du oeffnen?\n");
        return 0;
    }

  // ANSI C schaden
  return 0;

}


void reset()
{
  object *inv;
  int i;

  socken = 1;
  floor_dirty = 1;

  inv = all_inventory(kasten_h_cont);

  for (i=0; i < sizeof(inv); i++)
    inv[i]->remove();
    
  inv = all_inventory(kasten_k_cont);

  for (i=0; i < sizeof(inv); i++)
    inv[i]->remove();
    
  ::reset();

  SetupKastenInv();
}

