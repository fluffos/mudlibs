/*
**               Das Haus des Oberruepels             
**
**
**                Zaknafein, Februar 2000
**
*/

#include "../def.h"

inherit STDROOM;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

#define WIZNAME "zaknafein"

create()
{
  ::create();
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_HOUSE])); 
  SetProp(P_INT_SHORT, "Im Haus des Oberruepels" );
  SetProp(P_INT_LONG,
    "Hier im Haus des Oberruepels herrscht absolutes Chaos. Am Boden "
   +"liegen unmengen an leeren Bierflaschen, in der Kochnische stapelt "
   +"sich unabgewaschenes Geschirr und eine dicke Staubschicht liegt auf "
   +"den Moebeln. In der Mitte des Raumes steht ein Tisch, auf dem ein "
   +"Kartenspiel liegt.");
 
  AddDetail( "chaos",
    "Schaue Dich mal um, dann weisst Du, was ich meine.\n");
  AddDetail( "fenster",
    "Die Fenster sind so schmutzig, dass man kaum hindurchschauen kann.\n");
  AddDetail( "boden"  ,
    "Den Boden kann man kaum sehen, weil hier so viele Bierflaschen liegen.\n");
  AddDetail( "decke" ,
    "Von der Decke haengt eine kleine, schaebige Lampe herunter.\n");
  AddDetail( "lampe" ,
    "Die Lampe spendet dem Raum ein wenig Licht.\n");
  AddDetail( "licht" ,
    "Wenn die Lampe nicht so schmutzig waere, gaebe es hier mehr Licht.\n");
  AddDetail( ({ "wand" , "waende" }) ,
    "An einer Wand steht ein abgenutztes Bett.\n");
  AddDetail( "bett"  ,
    "Du musst wuergen. Die Bettwaesche wurde wohl schon seit Jahren nicht "
   +"mehr gewechselt.\n");
  AddDetail( ({ "waesche" , "bettwaesche" }) ,
    "Wenn man sich in dieses Bett legt, holt man sich bestimmt nur Krankheiten.\n");
  AddDetail( "krankheiten" ,
    "Geschlechtskrankheiten meine ich...\n");
  AddDetail( "geschlechtskrankheiten" ,
    "Dich scheint das Thema ja sehr zu interessieren. Schon eine gehabt?\n");
  AddDetail( "thema" ,
    "Bitte untersuche nicht weiter, sonst steckst Du mich noch an... :)\n");
  AddDetail( ({ "bierflaschen" , "flaschen" }) ,
    "Die Bierflaschen sind leider alle leer. Einige liegen wohl schon seit "
   +"Jahren hier.\n");
  AddDetail( ({ "jahre" , "jahren" }) ,
    "Der Oberruepel raeumt wohl nie auf!\n");
  AddDetail( ({ "ruepel" , "oberruepel" }) ,
    "Ist er nicht da? Hm, er ruepelt wohl gerade woanders rum...\n");
  AddDetail( ({ "nische" , "kochnische" }) ,
    "Du kannst Dir kaum vorstellen, dass der Ruepel kocht.\n");
  AddDetail( "geschirr",
    "Wuahh, da bildet sich ja schon Leben drauf.\n");
  AddDetail( "leben"  ,
    "Naja, sagt man halt so.\n");
  AddDetail( ({ "staub" , "schicht" , "staubschicht" }) ,
    "Eine dicke, schmierige Staubschicht liegt auf den Moebeln.\n");
  AddDetail( ({ "moebel" , "moebeln" }) ,
    "Besonders wertvoll scheinen die Moebel nicht zu sein.\n");
  AddDetail( ({ "haus" , "raum" , "raumes" }) ,
    "Hier wohnt also der Oberruepel. Tststs...\n");
  AddDetail("mitte" ,
    "Dort steht ein Tisch.\n");
  AddDetail( ({"stuehle" , "stuhl" }) ,
    "Stuehle gibt es hier auch. Sie stehen beim Tisch.\n");
  AddDetail( ({ "spiel" , "karten" , "kartenspiel" }) ,
    "Ein gewoehnliches Kartenspiel. Es ist nur sehr klebrig und verdreckt.\n");
  AddDetail( "tisch" ,
    "Auf dem Tisch stehen etliche Bierflaschen und auch ein Kartenspiel liegt "
   +"dort. Der Oberruepel spielt also lieber mit Karten, als hier aufzuraeumen.\n");
  
  AddSmell( DEFAULT_SMELL , "Es riecht hier abartig.\n");
  AddSound( DEFAULT_SOUND , "Es ist recht still hier.\n");
 
  AddItem(NPC "zobruepel" , REFRESH_REMOVE,([P_AGGRESSIVE:0]));

  AddExit( "raus", ROOM "room_D-07" );

}