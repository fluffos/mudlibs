#define WIZNAME "iwo"

inherit "std/laden";

#include <properties.h>
#include <laden.h>
#include "../def.h"

#define LAGER ROOM "lagerraum"


create()
{
  ::create();
  SetProp (P_INT_SHORT, sprintf("Gorwans Laden in %s", STADT));
  SetProp (P_INT_LONG,
    "Hier in dem fast schaebig anmutenden Laden, herrscht reges "
    "Treiben. Immerwieder huschen Haendler und Touristen herein, "
    "und kaufen oder verkaufen von Lebensmittel ueber Waffen und "
    "Ruestungen bis Krimskrams fast alles. Irgendwo muss ein "
    "riesiges Lager sein, wo das ganze Zeug abgelegt ist, denn "
    "in den Regalen an den Waenden kannst Du fast nichts finden.");

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "gorwan");
  SetProp(P_SHOPKEEPER_NAME, "Gorwan");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({"kram", "krams", "krimskram", "krimskrams", "zeug", "zeugs"}),
    "Die Dinge halt, die eigentlich keiner brauchen kann, "
    "abre trotzdem recht nett sind.");

  AddDetail( ({"ding", "dinge", "lebensmittel"}),
    "Auf einer Tafel steht, wie Du Dir die Dinge hier zeigen lassn "
    "kannst.");

  AddDetail( ({ "lager" }),
    "Das Lager ist wohl hinter dem Vorhang auf der anderen Seite "
    "der Theke.");
    
  AddDetail( ({ "vorhang" }),
    "Der Vorhang ist geschlossen, so dass Du nicht ins Lager sehen kannst");
    
  AddDetail( ({ "seite" }),
    "Du befindest Dich auf der anderen.");
    

  AddDetail ("laden", "Du stehst mittendrin.\n");

  AddDetail ("kasse",
    "Eine grosse, alte Kasse. Sie zeigt gerade 1923,00 an.\n");

  AddDetail ("tafel", "Du kannst sie lesen.\n");

  AddDetail ( ({"boden", "wand", "waende", "decke"}),
    "Du kannst daran nichts besonderes erkennen.\n");

  AddDetail( ({"touristen", "tourist"}),
    "Du bist zum Beispiel ein Tourist hier.");
    
  AddDetail( ({"beispiel"}),
    "Du schaust Dich an.\nDu denkst . o O (deprimierend!)");

  AddDetail( ({"ruestungen", "waffen", "brauchbares"}),
    "Mit etwas Glueck findest Du hier etwas Brauchbares.");

  AddDetail( ({"glueck"}),
    "Moege eben dieses auf Deiner Seite sein.");

  AddDetail( ({"treiben"}),
    "Du erroetest beschaemt.");

  AddDetail( ({ "regale", "sachen", "regal", "regalen" }),
    "In den Regal ist nicht besonders viel. Das meiste Zeugs liegt "
    "wohl im Lager.");

  AddDetail( ({ "O" }),
    "Das ist ein 'O'. Voellig uninteressant.");


  AddDetail( ({ "theke" }),
    "Auf der Theke steht eine kleine Kasse. Ausserdem kannst Du "
    "eine kleine Tafel sehen.");

  AddDetail( ({ "sueden", "strasse" }),
    "Nach Sueden kommst Du wieder raus auf die Strasse.");

  AddReadDetail ("tafel",
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"+
    "<kaufe> nummer oder\n"+
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
    "                  Haendler dafuer bezahlt.\n"+
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

  SetStorageRoom (LAGER);


  AddItem (NPC "gorwan", REFRESH_DESTRUCT);
  
  AddExit ("sueden", ROOM "room_E-05");
}

void reset()
{
  if (AMASTER->EventActive()) return;
  ::reset();
}
