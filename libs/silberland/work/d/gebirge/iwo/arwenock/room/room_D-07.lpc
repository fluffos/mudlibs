#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#define WIZNAME "zaknafein"

create()
{
  ::create();
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_TOWN])); 
  SetProp(P_INT_SHORT, "In einem schaebigen Stadtteil von Arwenock" );
  SetProp(P_INT_LONG,
    "Auf Deinem Weg durch die schmale Gasse, die durch das Armenviertel "
   +"Arwenocks fuehrt, bist Du nun an eine Stelle gelangt, an der die "
   +"heruntergekommenen Haeuser so dicht beieinander stehen, dass gerade "
   +"mal zwei Personen nebeneinander durch die Gasse gehen koennen. "
   +"Kaum ein Sonnenstrahl trifft auf den Boden, so dass es hier ein "
   +"wenig duester ist.");

  AddDetail( ({ "falle" , "personen" }) ,
    "Es handelt sich in diesem Falle nur um hypothetische Personen.\n");
  AddDetail( ({ "wolke" , "wolken" }) ,
    "Es wird wohl bald regnen.\n");
  AddDetail("sonne" ,
    "Sie ist hinter den Wolken verborgen.\n");
  AddDetail( ({ "strahl" , "sonnenstrahl" }) ,
    "Hierher verirren sich nur wenige Sonnenstrahlen, weshalb es auch "
   +"finster ist.\n");
  AddDetail( ({ "wolke" , "wolken" }) ,
    "Es wird wohl bald regnen.\n");
  AddDetail("sonne" ,
    "Sie ist hinter den Wolken verborgen.\n");
  AddDetail( ({ "arwenocks" , "arwenock" , "viertel" , "armenviertel" }) ,
    "Hier moechtest Du nicht wohnen, glaube mir.\n");
  AddDetail( ({ "wolke" , "wolken" }) ,
    "Es wird wohl bald regnen.\n");
  AddDetail("sonne" ,
    "Sie ist hinter den Wolken verborgen.\n");
  AddDetail( "weg" ,
    "Dein Weg fuehrt Dich die Gasse entlang durch das Armenviertel.\n");
  AddDetail( "haeuser" ,
    "Die Haeuser sind hier ebenso heruntergekommen wie anderswo in dem "
   +"Armenviertel auch. Die Tuer zu einem Haus sieht etwas demoliert aus.\n");
  AddDetail( "haus" ,
    "Hm, wer wohl in dem Haus wohnt?\n");
  AddDetail( "tuer" ,
    "Es sieht so aus, als ob mal jemand versucht hat, die Tuer aufzubrechen. "
   +"Vor der Tuer auf dem Boden liegt eine alte Fussmatte.\n");
  AddDetail( ({ "teil" , "gasse" , "stelle" })  ,
    "In diesem Teil der Gasse stehen die schaebigen Haeuser besonders dicht "
   +"beieinander, weshalb sie hier auch recht schmal und finster ist.\n");
  AddDetail("boden" ,
    "Der Boden hier in der Gasse wurde mit Steinen gepflastert.\n");
  AddDetail( ({ "pflastersteine" , "steine" }) ,
    "Die Pflastersteine wurden hier nicht sehr sorgfaeltig verlegt. "
   +"Zwischen den einzelnen Steinen klaffen grosse Luecken.\n");
  AddDetail( ({ "luecke" , "luecken" }) ,
    "Du schaust in eine der Luecken, findest aber nichts.\n");
  AddDetail("himmel" ,
    "Ein paar Wolken verdecken die Sonne.\n");
  AddDetail( ({ "wolke" , "wolken" }) ,
    "Es wird wohl bald regnen.\n");
  AddDetail("sonne" ,
    "Sie ist hinter den Wolken verborgen.\n");
  AddDetail( ({ "matte" , "fussmatte" }) ,
    "Die Fussmatte ist schon ziemlich alt und zerfetzt.\n");
  AddDetail( ({ "unter fussmatte" , "unter matte" }) ,
    "Du muesstest Die Fussmatte erstmal anheben, um das tun zu koennen.\n");

  AddSmell( DEFAULT_SMELL , "Es riecht hier nach billigem Schnaps.\n");
  AddSmell( ({ "schnaps" , "alkohol" , "gestank" }) ,
            "Der Gestank kommt aus den umliegenden Haeusern.\n");
  AddSound( DEFAULT_SOUND , "Kinderschreie dringen aus einigen Haeusern.\n");
  AddSound( ({"schreie" , "kinderschreie" ,"kinder" }) , 
               "Entweder spielen sie wild oder sie werden verkloppt. "
              +"Du kannst es nicht genau heraushoeren.\n");

  AddItem(NPC "zklruepel" , REFRESH_REMOVE,([P_AGGRESSIVE:0]));

  AddCmd( ({ "hebe" , "heb" }), "heben");
  AddCmd( ({ "schliess" , "schliesse" , "oeffne" }) , "oeffnen");

  AddExit( "westen", ROOM "room_C-07" );
  AddExit( "osten", ROOM "room_E-07" );
} 

heben( str )
{
notify_fail( "Was moechtest Du denn anheben?\n" );
if( str == "matte an" || str == "fussmatte an" || str == "matte hoch" || str == "fussmatte hoch" )
	{
         object ob;
         if (ob=deep_present(("\nzakorschluessel"), this_player()))
         {
          write(BS("Du hebst Die Fussmatte an, schaust darunter und "
                  +"stellst fest, dass sich dort nichts befindet.\n"));
         }
         else
         {
           clone_object(OBJ "zschluessel" )->move(this_player(), M_NOCHECK);
           write(BS("Du hebst Die Fussmatte an, schaust darunter und "
                   +"findest einen kleinen Schluessel, den Du sofort "
                   +"einsteckst.\n"));
         }
        say(this_player()->name(WER,2)+" fummelt an einer Haustuer herum.\n");
        return 1;
        }      
return 0;	 
}

oeffnen( str )
{
notify_fail( "Was moechtest Du denn oeffnen?\n" );
if( str == "tuer mit schluessel" || str == "mit kleinen schluessel" || str == "tuer auf" )
{
   object ob;
   if (ob=deep_present(("\nzakorschluessel"), this_player()))
    {
      write(BS("Du oeffnest die Tuer und betrittst das Haus des Oberruepels.\n"));
      this_player()->move(ROOM "orhaus" , M_GO , "" ,
          "geht in das Haus und schliesst die Tuer hinter sich" , "kommt herein");
    }
    else
      write(BS("Tja, haettest Du einen passenden Schluessel, ginge das wohl.\n"));
   return 1;
} 
if( str == "tuer" )
{
 write(BS("Die Tuer ist verschlossen. Du versuchst, sie aufzubrechen, "
         +"schaffst es aber nicht. Jetzt weisst Du wenigstens, warum sie "
         +"so demoliert aussieht. Vor Dir haben es wohl auch schon viele "
         +"probiert.\n"));
 return 1;
}     
return 0;	 
}

