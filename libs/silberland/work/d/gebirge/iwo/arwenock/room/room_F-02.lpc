
#include "../def.h"

inherit STDROOM;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
// #include "files.h"

#define WIZNAME "iwo"

int axt_weg = 0;

string wizfun();

create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Ausstellungsraum");
  
  SetProp(P_INT_LONG,
      "An der Wand siehst Du einen Mithrilschild neben dem ein "
      "kleines silbernes Schild befestigt ist. Daneben "
      "haengt eine riesige Berserkeraxt vor der Du schon beim "
      "blossen hinsehn Angst kriegst. Neben der Axt "
      "ist ein kleines goldenes Schild an der Wand "
      "festgenagelt.");

  AddDetail( ({ "angst" }),
      "Du zitterst fast so viel Angst hast Du.");
      
      
  AddDetail( ({ "wand", "waende" }),
      "An der Wand haengen ein Schild und eine Axt. Ahja.. "
      "und kleine Schilder.");
      
  AddDetail( ({ "schilder" }),
      "Du kannst sie sicher lesen.");
      
  AddDetail( ({ "Mithrilschild", "schild" }),
      "Vielleicht steht ja auf dem kleinen silbernen "
      "Schild mehr darueber.");
      
  AddDetail( ({ "silbernes schild", "goldenes schild"}),
      "Versuchs doch mal mit lesen!");
      
  AddReadDetail( ({ "silbernes schild" }),
      "+---------------------------------+\n"
      "|  Federverzierter Mithrilschild  |\n"
      "|         des Kaempfers           |\n"
      "|                                 |\n"
      "| Magische Kraefte machen  diesen |\n"
      "| seltenen  Schild zu  einem sehr |\n"
      "| begehrten  Objekt.  Die Ursache |\n"
      "| fuer  seine  magischen   Eigen- |\n"
      "| ist leider nicht  bekannt, aber |\n"
      "| der Sage nach  hat ein Zwergen- |\n"
      "| magier   namens  'Angrox' seine |\n"
      "| Finger im Spiel.                |\n"
      "+---------------------------------+\n");

  AddReadDetail( ({ "schild" }),
      "Meinst Du das silberne oder das goldene Schild?");

  AddReadDetail( ({ "goldenes schild" }),
      "+----------------------------------+\n"
      "|            Berserkeraxt          |\n"
      "|                                  |\n"
      "| Diese  Waffe,  die  bereits  der |\n"
      "| maechtige   Berserker  'Kronang' |\n"
      "| gefuehrt   hat,  wurde  uns  von |\n"
      "| einer Magierin  namens 'Feyaria' |\n"
      "| zur  Verfuegung   gestellt.  Sie |\n"
      "| stammt   aus    ihrer  magischen |\n"
      "| Werkstatt   und  ist  von  uner- |\n"
      "| messlichem Wert.                 |\n"
      "+----------------------------------+\n");

  AddSpecialDetail( ({ "axt", "berserkeraxt" }), "axtfkt");

  AddExit( "westen", ROOM "room_E-02" );

  AddCmd( ({ "nimm", "nehme", "nehm" }), "tryit");
  AddCmd( ({ "stemm", "stemme" }), "getit");

}



int tryit(string str)
{
  notify_fail("Was willst Du nehmen?\n");
  if (!str || (strstr(str, "schild")== -1 && strstr(str, "axt")== -1)) return 0;
  
  if (strstr(str, "schild") != -1)
    {
      tell_object(TP, BS("Du zerrst wie ein Verrueckter an dem "
                         "Schild, bekommst ihn jedoch nicht ab "
			 "von der Wand."));
      tell_room(ME, BS(TP->Name(WER) + " zerrt wie ein Verrueckter "
                       "an dem Schild."), ({ TP }));
		     
      return 1;
    }
  
  if (strstr(str, "axt") != -1)
    {
      tell_object(TP, BS("Du ziehst an der Axt, bemerkst aber schnell, "
                         "dass Du sie so nicht runterkriegen wirst."
			 "vielleicht kannst Du sie ja mit einem "
			 "Hilfsmittel runterstemmen?"));
			 
      tell_room(ME, BS(TP->Name(WER) + " zerrt vergeblich an der Axt"),
                ({ TP }));
      
      return 1;
    }
    
  return 0;
}


int getit (string str)
{
  string what,with;
  object ob;
  object axe;

  notify_fail("Was willst Du runterstemmen?\n");
  if (!str) return 0;
  
  notify_fail("Was willst Du womit runterstemmen?\n");
  if (sscanf(str, "%s mit %s herunter",what,with) != 2 &&
      sscanf(str, "%s mit %s runter",what,with) != 2) return 0;
      
  notify_fail("Das kannst Du nicht runterstemmen!\n");
  if (what != "axt" && what != "berserkeraxt") return 0;
  
  notify_fail("Welche Axt? Du siehst keine!\n");
  if (axt_weg) return 0;
  
  switch(with)
    {
      case "schwert": ob = present("schwert", TP); break;
      case "axt": ob = present("axt", TP); break;
      case "stock": ob = present("stock", TP); break;
      default: notify_fail("Damit wird das wohl nichts!\n"); return 0;
    }
  
  notify_fail("Sowas hast Du doch garnicht!\n");
  if (!ob) return 0;
  
  tell_object(TP, BS("Geschickt setzt Du " + ob->name(WEN) + " an und "
                     "reisst die Axt mit einem kurzen Ruck aus der "
		     "Verankerung."));
		     
  tell_room(ME, BS(TP->Name(WER) + " setzt " + ob->name(WEN) + " geschickt "
                   "ab und bricht die Axt aus der Verankerung."), ({ TP }));
	
  axt_weg = 1;

  axe = clone_object(WEAPON "fakeaxt");
  if(axe->move(TP, M_GET) == ME_TOO_HEAVY)
    {
      tell_room(ME, "Die Axt faellt zu Boden.");
      ob->move(ME, M_SILENT + M_NOCHECK);
    }		   
  
  return 1;
}


string axtfkt()
{
  if (axt_weg) return BS("Oh, Du hast Dich wohl getaeuscht. Da "
                         "haengt doch keine Axt. Vermutlich hat "
			 "sie jemand gestohlen.");
  return BS("Eine bombastische megasupergeile Axt. Auf dem "
            "goldenen Schild steht sicher mehr darueber.");
}
