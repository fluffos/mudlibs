#define WIZNAME "iwo"

#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
// #include "files.h"


string killfunc()
{
  SetProp(P_KILL_NAME, "Eine Scriptfalle");
  TP->die();
  return "\nDU WURDEST GEWARNT!\n";
}


create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst direkt vor dem Postamt von Arwenock. Nach Norden "
    "kannst Du es betreten und Briefe verschicken oder Deine Post "
    "lesen. Nach Westen bringt Dich dieser Weg erst zum Laden, "
    "und dann weiter bis zum Hauptplatz. Nach Osten kommst Du weiter "
    "zum Ostweg, der die Nord-Sued-Verbindung bildet.");

  AddDetail( ({ "briefe", "brief" }),
    "Um Deine Briefe zu lesen, musst Du das Gebaeude wohl oder uebel "
    "betreten.");

  AddDetail( ({ "gebaeude" }),
    "Das Postamt ist ein schlichtes gemauertes Haus mit kleinen, "
    "verglasten Fenster.");
    
  AddDetail( ({"haus"}),
    "Es ist nicht sonderlich gross, aber eigentlich haettest Du auch "
    "gerne mal eines.");
    
  AddDetail( ({ "fenster", "innere", "inneres" }),
    "Du versuchst durch ein Fenster ins Innere zu kucken, kannst aber "
    "leider nichts erkennen.");

  AddDetail( ({ "platz", "hauptplatz" }),
    "Du kannst den Platz von hier aus nicht erkennen, aber dieser Weg "
    "wird Dich dort sicherlich hinfuehren.");
    
  AddDetail( ({ "laden" }),
    "Der Laden ist ein kleines Stueck weiter westlich.");
    
  AddDetail( ({ "stueck" }),
    "Ein klitzeklitzekleines :-)");
    
  AddDetail( ({ "ostweg" }),
    "Eigentlich ist der Ostweg ja eher ein Gasse. Das aendert aber "
    "nichts daran, dass er Ostweg heisst.");
    
  AddDetail( ({ "gasse" }),
    "Ja, Gasse. Schoenes Wort.");
    
  AddDetail( ({"wort"}),
    "Na, Du kleiner FP-Jaeger ;-)");
    
  AddDetail( ({"jaeger"}),
    "\n*** Achtung, das naechste Detail wird Dich toeten!! ***\n");  

  AddDetail( ({"detail"}), #'killfunc);

  AddDetail( ({"post", "postamt"}),
    "Das Gebaeude, welches Du im Norden betreten kannst, ist das lokale "
    "Postamt.");
    
  AddDetail( ({"verbindung"}),
    "Ueber diese kannst Du von ganz im Sueden bis ganz in den Norden der "
    "Stadt gelangen - oder umgekehrt.");
    

  AddExit( "osten",  ROOM "room_G-05" );
  AddExit( "westen", ROOM "room_E-05" );
  AddExit( "norden", ROOM "room_F-06" ); 

}
