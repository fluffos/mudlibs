
#include "../def.h"

inherit STDWEG;

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst mitten auf einem relativ breiten Weg der quer "
    "durch die Stadt fuehrt. Auf Grund des grossen Gedraenges "
    "stoesst und rempelt Dich ab und zu jemand an. "
    "Irgendetwas interessantes scheint im Sueden zu sein, "
    "zumindest zieht es staendig Deinen Blick in diese "
    "Richtung. Eventuell solltest Du der Sache nachgehen.");

  AddDetail( ({ "platz", "weg", "wege" }),
    "Ja da ist einer und Du stehst sogar mitten auf ihm. "
    "Vor Deinen Fuessen liegt Etwas. ");
    
  AddDetail( ({ "etwas" }),
    "Ein kleiner Kiesel faellt Dir besonders auf. ");

  AddDetail( ({ "kiesel", "kieselstein" }),
    "Der kleine graue Kiesel hat eine komische Oberflaeche.  ");

  AddDetail( ({ "oberflaeche" }),
    "Es sieht fast aus als haette er Haare. ");

  AddDetail( ({ "haare", "haar" }),
    "Du versuchst den Kiesel hochzuheben. Gerade als Du ihn "
    "umdrehen willst bemerkst du, dass es sich um ein kleines, "
    "suesses Maeuschen handelt, dass sofort aus deiner Hand "
    "springt und davonlaeuft. ");

  AddDetail( ({ "maus", "maeuschen" }),
    "Das Maeuschen is so schnell verschwunden, dass Du gar nicht "
    "bemerkt hast, wo es genau hingelaufen ist. ");

  AddDetail( ({ "hand" }),
    "Du drehst sie von einer Seite zur anderen und stellst fest, "
    "dass du ein schoener Schmutzfink bist. ");

  AddDetail( ({ "seite", "hinterseite", "vorderseite", "hinter", "vorder" }),
    "Eine Hinter- und eine Vorderseite. "
    "Aber beide sehen nicht unbedingt sauber aus. ");

  AddDetail( ({ "schmutzfink", "fink" }),
    "Genau als ein solcher fuehlst Du Dich. ");

  AddDetail( ({ "ostweg" }),
    "Es ist erstaunlich aber wahr - Der Ostweg liegt im Osten. ");
    
  AddDetail( ({ "quer" }),
    "Na von einem Ende zum Anderen der Stadt. "
    "Irgendwie kommst du bei dem Wort 'quer' ins Gruebeln. ");
    
  AddDetail( ({ "gruebeln", "wort" }),
    "Es erinnert Dich irgendwie an einen Magier. ");

  AddDetail( ({ "magier" }),
    "Querolin! ");   
 
  AddDetail( ({ "querolin", "quero" }),
    "Ja genau der wars! ");
    
  AddDetail( ({ "sueden", "sache", "richtung", "sachen" }),
    "Da solltest Du dich unbedingt einmal genauer umschauen. "
    "Sicherlich befindet sich etwas sehr interessantes dort! ");
    
  AddDetail( ({ "blick" }),
    "Staendig starrst Du hin. ");
    
  AddDetail( ({ "stadt" }),
    "Hmm. Bei genauer Betrachtung stellst Du fest: Es ist eine. "
    "Viele wundervolle Haeuser und stattliche Wege. ");
    
  AddDetail( ({ "gedraenge", "grund", "gedraenges" }),
    " Ein Haendler ist dir auf deine Fuesse getreten. \n"
    "Du rufst: aaaaaauuuuuaaaaahhhhhhhh. ");

  AddDetail( ({ "haendler" }),
    "Du bist dir fast sicher, dass es kein Haendler sondern ein "
    "Taschendieb war. ");

  AddDetail( ({ "taschendieb", "dieb" }),
    "Leider hast du ihn aus den Augen verloren. "
    "Schau besser nach ob du noch alles bei dir traegst. ");

  AddDetail( ({ "augen", "auge" }),
    "In dem grossen Gedraenge kannst du ihn nicht mehr entdecken.  ");
  
  AddDetail( ({ "irgendetwas", "interessant", "interessantes" }),
    "Was koennte das wohl sein! Du bist wirklich neugierig. ");

  AddDetail( ({ "betrachtung" }),
    "Es ist wirklich eine sehr schoene Stadt mit vielen Haeusern. ");

  AddDetail( ({ "haeuser", "haus", "haeusern" }),
    "Haeuser. Wie jedes andere in dieser Stadt auch. "
    "Besonders gefallen Dir die Schindeldaecher. ");

  AddDetail( ({ "schindeldaecher", "daecher", "schindeln", "dach" }),
    "Die Daecher sind mit Schindeln eingedeckt. Es sind viele rote "
    "und braune zu sehen, ab und zu bemerkst Du ein schwarzes. "
    "Bei den meisten handelt es sich um Holzschindeln. ");

  AddDetail( ({ "holz", "holzschindel", "holzschindeln" }),
    "Du stellst fest, dass es sich bei den Schindeln um sehr gute "
    "Handwerksarbeit handelt. Das Holz stammt von den grossen  "
    "Eichen im Silberwald. ");

  AddDetail( ({ "handwerksarbeit", "arbeit", "handwerk" }),
    "Jawoll. Die sind von bester Qualitaet. ");

  AddDetail( ({ "qualitaet" }),
    "Diese Schindeln sind wirklich hoch qualitativ. ");

  AddDetail( ({ "eichen", "eiche" }),
    "Im Silberwald wachsen wirklich gross davon. Sie eignen sich "
    "hervorragend fuer alles was aus Holz gemacht wird. ");

  AddDetail( ({ "silberwald", "wald" }),
    "Viele interessante Sachen kann man im Silberwald entdecken. "
    "Man muss sie nur suchen... ");

  AddSound(DEFAULT_SOUND, "Von Stille kann hier keine Rede sein. \n");

  AddSound( ({ "stille", "still" } ),
    "Still ist es absolut nicht hier. Man koennte eher von lautem "
    "Geplapper unt Geplaenkel sprechen. ");

  AddSound( ({ "geplapper", "geplaenkel"}),
    "Genaues kannst du leider nicht erlauschen. ");

  AddSound( ({ "rede" }),
    "Davon kann wirklich keine sein. ");

  AddSmell(DEFAULT_SMELL, "Du schnappst einen eigenartigen Geruch auf. \n");

  AddSmell( ({"geruch", "eigenartig", "eigenartigen"}),
    "Es riecht irgendwie nach Essen. ");

  AddSmell( ({"essen" }),
    "Entdecken kannst du allerdings nicht. Du hast Dich wohl doch "
    "getaeuscht. ");

  AddExit( "osten",  ROOM "room_H-03" );
  AddExit( "westen", ROOM "room_F-03" );
  AddExit( "sueden", ROOM "room_G-02" );

}
