
inherit "std/room";

#pragma strong_types

#include <wizlevels.h>
#include <properties.h>
#include <ansi.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

#include "../../def.h"

void create()
{
  if (is_clone(TO)) return;
  ::create();
  seteuid(getuid(TO));

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_NO_TPORT, NO_TPORT);

  SetProp(P_ENVIRONMENT, ([ ENV_TERRAIN: TT_CAVE,
                            ENV_TEMPERATURE: 25 ]));

  SetProp(P_INT_SHORT, "Tief in einem Berg");
  SetProp(P_INT_LONG, "Hier im Fels sieht es irgendwie ueberall "
    "gleich aus. Dunkler, stellenweise von Russ geschwaerzter "
    "Fels ueber Dir, neben Dir - ja sogar unter Dir. Die Luft "
    "riecht und schmeckt irgendwie abgestanden. Es ist ekelhaft "
    "warm und gelegentlich streifen Dich irgendwelche Dinge. Der "
    "felsige Untergrund laedt nicht gerade ein ein Nickerchen zu "
    "machen und irgemdwie fuehlst Du Dich beobachtet. Es scheint, als "
    "haette der Berg hier Augen und Ohren.");

  AddDetail( ({ "russ" }),
    "Der Russ an den Waenden und der Decke stammt wohl von Fackeln "
    "und Lampen.");
  AddDetail( ({ "fels" }),
    "Der Fels rundum Dich ist scharfkantig und kalt. Von gemuetlich weit weg.");
  AddDetail( ({ "luft" }),
    "Riecht ekelerregend.");
  AddDetail( ({ "dinge" }),
    "Du moechtest garnicht wissen welcke ekligen Dinge sich hier "
    "herumtreiben.");
  AddDetail( ({ "untergrund", "boden" }),
    "Der Boden hier besteht wie alles aus Fels. Hie und da liegt "
    "etwas Staub herum.");
  AddDetail( ({ "staub" }),
    "Du kannst nichts daran erkennen was Dich interessieren wuerde.");
  AddDetail( ({ "berg" }),
    "Du befindest Dich hier tief im Berg. Alles was Dich umgibt ist "
    "Teil von ihm.");
  AddDetail( ({ "augen" }),
    "Du fuehlst Dich beobachtet.");
  AddDetail( ({ "ohren" }),
    "Du fuehlst Dich belauscht.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht voellig aus Fels. Sie wirkt etwas geschwaerzt. "
    "Manche Stellen sehen aus als wuerde sich jeden Moment ein "
    "Felsbrocken loesen.");
  AddDetail( ({ "felsbrocken", "brocken" }),
    "Teile des Gesteins.");
  AddDetail( ({ "gestein", "gesteins" }),
    "Der Fels, der Dich umgibt.");
  AddDetail( ({ "stellen" }),
    "Als wuerde sich gleich ein Felsbrocken loesen.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus Fels und sind stellenweise extrem "
    "scharfkantig. Manchmal sind sogar Blutflecken zu sehen deren "
    "Ursprung Du garnicht ergruenden moechtest.");
  AddDetail( ({ "blutflecken", "flecken" }),
    "Die Flecken sind eingetrocknet und schon beinahe schwarz.");
  AddDetail( ({"ursprung"}),
    "Den moechtest Du garnicht ergruenden.");



  AddExit("westen", CAVEPATH+"/room/connect02");
  AddExit("oben", APATH+"/room/room_G-02");
}


void reset()
{
  if (AMASTER->EventActive()) return;
  ::reset();
}   

