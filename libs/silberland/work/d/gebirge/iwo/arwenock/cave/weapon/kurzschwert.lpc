inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein verrottetes Kurzschwert");
  SetProp(P_LONG,
    "Dieses Kurzschwert hat eine kurze, im laufe der Jahre stark "
    "verwitterte Klinge. Sie ist dreckig und teilweise fehlen "
    "Stuecke davon.");
  SetProp(P_NAME, "Kurzschwert");
  SetProp(P_NAME_ADJ, "verrottet");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert","kurzschwert" }));
 
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 110);
  SetProp(P_WC_FIX, 30);
  SetProp(P_WC_BONUS,
    (["\narkens":250]));
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 200); 
  SetProp(P_SIZE, 50);
  Damage(100+random(200));
}

