
void print_map(string pos)
{
  int x;
  int y;
  int i;
  string curr;
  string chars, exit;
  string *charmap, *exits;
  chars = "abcdefghijklmnopqrstuvwxyz";

  charmap = allocate(53);

  for (y=0;y<sizeof(charmap);y++)
    charmap[y]="                                                    ";

  for (y=52;y>=0;y=y-2)
    {
      for (x=0;x<52;x=x+2)
        {
          curr = sprintf("%s%02d", chars[x/2..x/2], y/2);
          if (member(map, curr))
            {
              if (curr==pos) charmap[y][x..x] = "@";
              else charmap[y][x..x] = "o";
              
              exits = m_indices(map[curr,0]);

              for (i=0;i<sizeof(exits);i++)
                {
                  switch(implode(explode(implode(explode(exits[i], "ob"), ""), "unt"), ""))
                    {
                      case "norden":
                        if (charmap[y+1][x..x]==" ")
                          charmap[y+1][x..x]="|";
                        else if (charmap[y+1][x..x]!="|")
                          charmap[y+1][x..x]="+";
                        break;
                      case "nordosten":
                        if (charmap[y+1][x+1..x+1]==" ")
                          charmap[y+1][x+1..x+1]="/";
                        else  if (charmap[y+1][x+1..x+1]!="/")
                          charmap[y+1][x+1..x+1]="X";
                        break;
                      case "osten":
                        if (charmap[y][x+1..x+1]==" ")
                          charmap[y][x+1..x+1]="-";
                        else if (charmap[y][x+1..x+1]!="-")
                          charmap[y][x+1..x+1]="+";
                        break;
                      case "suedosten":
                        if (charmap[y-1][x+1..x+1]==" ")
                          charmap[y-1][x+1..x+1]="\\";
                        else if (charmap[y-1][x+1..x+1]!="\\")
                          charmap[y-1][x+1..x+1]="X";
                        break;
                      case "sueden":
                        if (charmap[y-1][x..x]==" ")
                          charmap[y-1][x..x]="|";
                        else if (charmap[y-1][x..x]!="|")
                          charmap[y-1][x..x]="+";
                        break;
                      case "suedwesten":
                        if (charmap[y-1][x-1..x-1]==" ")
                          charmap[y-1][x-1..x-1]="/";
                        else if (charmap[y-1][x-1..x-1]!="/")
                          charmap[y-1][x-1..x-1]="X";
                        break;
                      case "westen":
                        if (charmap[y][x-1..x-1]==" ")
                          charmap[y][x-1..x-1]="-";
                        else if (charmap[y][x-1..x-1]!="-")
                          charmap[y][x-1..x-1]="+";
                        break;
                      case "nordwesten":
                        if (charmap[y+1][x-1..x-1]==" ")
                          charmap[y+1][x-1..x-1]="\\";
                        else if (charmap[y+1][x-1..x-1]!="\\")
                          charmap[y+1][x-1..x-1]="X";
                        break;
                      default:
                        tell_object(TP, sprintf("MAP ERROR: %s (%O)\n", curr, exits));
                    };
                  
                }
            }
        }
    }
    


  for (y=26;y>=0;y--)
    {
      tell_object(TP, charmap[y]+"\n");
    }

}
