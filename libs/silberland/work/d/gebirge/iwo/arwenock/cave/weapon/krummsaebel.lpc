inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein alter Krummsaebel");
  SetProp(P_LONG,
    "Dieser alte Krummsaebel besitzt furchteinfloessende Zacken. "
    "In Verbindung mit der gebogenen Klinge ist er eine "
    "ernstzunehmende Waffe.");
  SetProp(P_NAME, "Krummsaebel");
  SetProp(P_NAME_ADJ, "alt");
  SetProp(P_GENDER, MALE);
  AddId( ({"krummsaebel", "saebel"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 125);
  SetProp(P_WC_FIX, 35);
  SetProp(P_WC_BONUS,
    (["\narkens":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_RIP}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 80);
  SetProp(P_QUALITY_DECAY, 115);
  Damage(100+random(200));

}

