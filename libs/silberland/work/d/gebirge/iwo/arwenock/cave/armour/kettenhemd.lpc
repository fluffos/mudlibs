
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId (({"kettenhemd","hemd"}));  
  AddAdjective( ({"rostiges", "rostig"}) );
  SetProp (P_SHORT, "Ein blutiges Kettenhemd");
  SetProp (P_LONG, BS(
                  "An diesem rostigen Kettenhemd klebt noch das Blut "
                  "des Zwerges dem es wohl abgenommen wurde.\n"));
  SetProp (P_NAME, "Kettenhemd");
  SetProp (P_NAME_ADJ, "blutig");
  SetProp (P_GENDER, NEUTER);  
  SetProp (P_WEIGHT, 1550);  
  SetProp (P_VALUE, 100);   
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 12);
  SetProp (P_DAMAGED, 14+random(100));
  SetProp (P_MATERIAL, ([MAT_STEEL:80, MAT_MISC_METAL:20])); 
}

