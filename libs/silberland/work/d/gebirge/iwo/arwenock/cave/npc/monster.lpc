#define WIZNAME "iwo"

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <mnpc.h>

inherit "std/mnpc";

void create() {

  object ob;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein monster");
  SetProp(P_LONG,
    "Diese Gestalt gehoert zu den uebelsten Typen in dieser Stadt."
    "Kaum siehst Du Dich nicht vor, klaut er Dir das Geld aus der "
    "Tasche. Du solltest ihm wohl aus dem Weg gehen.");
  SetProp(P_NAME, "monster");
  SetProp(P_GENDER, MALE);


  create_default_npc(25);


  AddId( ({ "monster" }));


  SetProp(P_HANDS, ({" mit seinen rauhen Haenden",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 195);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);


  TO->move(CROOM "n07", M_NOCHECK);
  SetProp(P_MNPC_DEFAULTROOM, CROOM "n07");
  SetProp(P_MNPC_AREA, CROOM);
  SetProp(P_MNPC_WAIT, ({ 5, 5, 5 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD + MOV_INDOORS + MOV_BACKWARDS + MOV_SPECIAL);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht weiter");

}
