inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>
#include <moredef.h>


void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein rostiges Breitschwert");
  SetProp(P_NAME_ADJ, "rostig");
  SetProp(P_LONG,  
    "Die Klinge dieses Schwertes ist verrostet und ganze Stuecke "
    "des Metalls fehlen an den Schneiden. Der Griff ist umwickelt "
    "mit blutverschmiertem Stoff.");
  SetProp(P_NAME, "Breitschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"breitschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 30);
  SetProp(P_WC_BONUS,
    (["\narkens":250]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL :100]) );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 400);
  SetProp(P_SIZE, 95);
  SetProp(P_QUALITY_DECAY, 60);
  //SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10]) ); 
  Damage(100+random(400));
}

int HitFunc(object enemy)
{
  if (random(100)<3)
    {
      enemy->AddPoison(1);
      tell_object(enemy, BS("Der rostige Stahl des Breitschwertes dringt tief in Dein Fleisch ein."));
    }

  return 0;
}
