#pragma strong_types

#define DEBUG 1
#define DB(x) if (find_player("iwo")) tell_object(find_player("iwo"), x);
#include <defines.h>
#include <moredef.h>

#include "../../def.h"

#include CAVEMAP
#include "mapfun.lpc"

mixed File2Object(string file);

private nosave mapping objects = ([]);
private nosave string mypath;
private nosave string last_cloned_object;


void create()
{
  if (is_clone(efun::this_object())) destruct();

  seteuid(getuid(this_object()));

  mypath = 
    efun::implode(
      efun::explode(file_name(this_object()), "/")[0..<2], "/"
    );

}


void clear_dead_objects()
{
  string *files;
  int i;
  
  files = m_indices(objects);
  
  for (i=0;i<sizeof(files);i++)
    {
      if (objects[files[i],0] == ({ 0 }))
        m_delete(objects, files[i]);
    }
}



// This is for the master
mixed compile_object(string file)
{
  object ob;

  if(file[<2..] == ".lpc") file = file[0..<3];

  if (!member(map, file)) return 0;

  // Trash NULL objects
  clear_dead_objects();

  call_other(mypath+"/std_room", "???", 0);

  if (ob = clone_object(mypath+"/std_room"))
    {
      objects[file,0] = ob;
      last_cloned_object = file;
    }

  ob->Customize();

  return ob;
}


mixed CustomizeObject()
{
  object ob;
  string *path;
  string file;
  int i;
  string *exits;

  file = last_cloned_object;
  exits = m_indices(map[file,0]);

  for (i=0;i<sizeof(exits);i++)
    {
      PO->AddExit(exits[i], mypath+"/"+map[file,0][exits[i],0]);
    }


  return last_cloned_object;
}



// Return all my objects
mixed * QueryObjects()
{
  return m_values(objects) - ({ 0 });
}


mixed File2Object(string file)
{
  file = lowerstring(file);
  if (!member(objects, file)) return 0;
  return objects[file,0];
}



// Final cleanup
int remove()
{
  string *files;
  object ob;
  int i;

  files = m_indices(objects);

  for (i=0;i<sizeof(files);i++)
      if (objectp(ob = objects[files[i],0]))
        {
          DB(sprintf("Removing %O\n", ob));
          ob->remove();
          if (objectp(ob)) ob->destruct();
	  if (objectp(ob)) DB("Nochimmer da!!\n")
        }

  return 1;
}

