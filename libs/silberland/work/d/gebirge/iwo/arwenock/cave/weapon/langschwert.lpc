inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein rostiges Langschwert");
  SetProp(P_LONG,  
    "Waere die ehemals scharfe Klinge dieses Schwertes nicht "
    "so stark mitgenommen, waere dieses Schwert eine gefaehrliche "
    "Waffe. Aufgrund der Laenge kann man mit der Spitze der Klinge "
    "den Gegner gefaehrlich verletzen." );
  SetProp(P_NAME, "Langschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"langschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 50);
  SetProp(P_WC_BONUS,
    (["\narkens":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL :95, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 105);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:8]) );
  Damage(100+random(200)); 
  
}

