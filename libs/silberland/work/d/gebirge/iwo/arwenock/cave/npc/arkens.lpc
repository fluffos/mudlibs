  SetProp(P_ATTRIBUTES, 
            ([ A_INT: 7, A_STR: 30, A_DEX: 30, A_CON: 30 ]));

  SetProp(P_MAX_HP, 800);
  SetProp(P_MAX_SP, 800);
  SetProp(P_HP, QueryProp(P_MAX_HP));
  SetProp(P_SP, QueryProp(P_MAX_SP));

  SetProp(P_HANDS, ({ " mit seinen Klauen", 600, DT_RIP })); 
  SetProp(P_BODY, 100);
  SetProp(P_XP, QueryProp(P_MAX_HP)*QueryProp(P_HANDS)[1]*5);
  SetProp(P_RACE, "Arkens");
  SetProp(P_SIZE, 160);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -5);
  SetProp(P_WIMPY, 0);
  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT,"stapft");
  SetProp(P_MMSGIN, "tritt aus dem Schatten");
  SetProp(P_MMSGOUT, "laeuft weg");

  // WEAPON
