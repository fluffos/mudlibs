      ob->move(ME, M_NOCHECK);
      ob->wield_me();
    }

  // Helmet
  if (random(3))
    {
      switch (random(5))
        {
          case 0: 
            ob = clone_object("/p/armour/helm/eisenhelm"); 
            break;
          case 1:
            ob = clone_object("/p/armour/helm/lederhelm");
            break;
          case 2:
            ob = clone_object("/p/armour/helm/titanhelm");
            break;
          case 3:
            ob = clone_object("/p/armour/helm/kampfhelm");
            break;
          case 4:
            ob = clone_object("/p/armour/helm/kettenhaube");
            break;
            
        }
      ob->move(ME, M_NOCHECK);
      ob->Damage(14+random(100));
      ob->DoWear();
    }


  // Armour
  if (random(3))
    {
      switch (random(5))
        {
          case 0..1: 
            ob = clone_object("/d/gebirge/iwo/arwenock/cave/armour/kettenhemd"); 
            break;
          case 2:
            ob = clone_object("/p/armour/armour/lederruestung");
            break;
          case 3:
            ob = clone_object("/p/armour/armour/brustpanzer");
            break;
          case 4:
            ob = clone_object("/p/armour/armour/eisenpanzer");
            break;
            
        }
      ob->move(ME, M_NOCHECK);
      ob->Damage(14+random(100));
      ob->DoWear();
    }


  // Gloves
  if (random(3))
    {
      switch (random(4))
        {
          case 0: 
            ob = clone_object("/p/armour/gloves/lederhandschuhe"); 
            break;
          case 1: 
            ob = clone_object("/p/armour/gloves/panzerhandschuhe"); 
            break;
          case 2:
            ob = clone_object("/p/armour/gloves/kettenhandschuhe");
            break;
          case 3:
            ob = clone_object("/p/armour/gloves/panzerhandschuhe");
            break;
        }
      ob->move(ME, M_NOCHECK);
      ob->Damage(14+random(100));
      ob->DoWear();
    }


  // Boots
  if (random(3))
    {
      switch (random(4))
        {
          case 0: 
            ob = clone_object("/p/armour/boots/eisenstiefel"); 
            break;
          case 1: 
            ob = clone_object("/p/armour/boots/lederstiefel"); 
            break;
          case 2:
            ob = clone_object("/p/armour/boots/kampfstiefel");
            break;
          case 3:
            ob = clone_object("/p/armour/boots/fellstiefel");
            break;
        }
      ob->move(ME, M_NOCHECK);
      ob->Damage(14+random(100));
      ob->DoWear();
    }

  // Trousers
  if (random(3))
    {
      switch (random(4))
        {
          case 0: 
            ob = clone_object("/p/armour/trousers/kettenhose"); 
            break;
          case 1: 
            ob = clone_object("/p/armour/trousers/lendenschurz"); 
            break;
          case 2:
            ob = clone_object("/p/armour/trousers/fellhose");
            break;
          case 3:
            ob = clone_object("/p/armour/trousers/lederhose");
            break;
        }
      ob->move(ME, M_NOCHECK);
      ob->Damage(14+random(100));
