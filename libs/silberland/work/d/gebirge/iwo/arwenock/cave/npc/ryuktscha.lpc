#define WIZNAME "iwo"

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <mnpc.h>

inherit "std/mnpc";

void create() {

  object ob;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ryu'ktscha");
  SetProp(P_LONG,
    "Dir ekelt beim Anblick dieses Wesens. Sein langlicher Kopf ist "
    "stark behaart und scharfe Zaehne ragen aus dem grossen Maul. "
    "Sabber tropft aus den Mundwinkeln. Die vier langen muskuloesen "
    "Beine sind mit scharfen Krallen bestueckt mit denen Du besser "
    "nicht bekanntschaft machst. Am besten verhaeltst Du Dich ganz "
    "ruhig und bewegst Dich nicht.");
  SetProp(P_NAME, "Ryu'ktscha");
  SetProp(P_GENDER, MALE);

  set_living_name("ryuktscha");
  enable_commands();

  create_default_npc(25);


  AddId( ({ "ryu", "ktscha", "ryu'ktscha" }));


  SetProp(P_HANDS, ({" mit seinen furchterregenden Klauen",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 195);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ryu'ktscha will das nicht.\n" }) );


  SetProp(P_MNPC_DEFAULTROOM, CROOM "n07");
  SetProp(P_MNPC_AREA, CROOM);
  SetProp(P_MNPC_WAIT, ({ 5, 10, 5 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD + MOV_INDOORS + MOV_BACKWARDS + MOV_SPECIAL);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht weiter");

  SetProp(P_SPELLRATE, 50);

AddSpell(8,400,
         "Ryu'ktscha rammt Dir seine Klauen in den Leib.\n",
         "Ryu'ktscha rammt @WEN seine Klauen in den Leib.\n",
                 ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]) );                
AddSpell(2,800,
         "Ryu'ktscha beisst Dich und versucht ein Stueck Fleisch aus Dir zu reissen.\n",
         "Ryu'ktscha beisst @WEN und versucht ein Stueck Fleisch aus @WESSEN Koerper zu reissen.\n",
                 ({DT_RIP}), ([SP_SHOW_DAMAGE:1]) );                


}
