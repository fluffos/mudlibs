inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"


#define WIZNAME "andyl"
  
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Orkenspalter");
  SetProp(P_LONG,
	  "Der Orkenspalter ist eine maechtige zweischneidige Axt welche "
	  +"auf einer Seite gezackt ist. Sie macht sicher betraechtlichen "
	  +"Schaden und benoetigt auch einiges an Kraft um sie fuehren zu "
	  +"koennen.\n");
  SetProp(P_NAME, "Orkenspalter");
  AddId( ({"axt","spalter","orkenspalter" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_WC, 200);
  SetProp(P_WC_FIXFACTOR, 0);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEIGHT, 4000);  
  SetProp(P_VALUE, 3000); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE,DT_SLASH);
  SetProp(P_NR_HANDS, 2);
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 18]));
  SetProp(P_INFO, BS("Diese Axt ist der Schrecken aller Orks, Goblins und Kobolde."));
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );
  SetHitFunc(this_object());
  SetProp(P_WC_BONUS, ([ "\nbronawar" : 130 ]));   
  seteuid(getuid(this_object()));
}

int HitFunc(object enemy)
{
  if ( member(({"ork", "goblin", "kobold"}),
	      lower_case(enemy->QueryProp(P_RACE)))!=-1 )
    {
      if (random(100)>=80)
	{
	  write(
		"  Du spaltest "+enemy->Name(WEM)+" beinahe in zwei Haelften.\n");
	  return (200+random(200));
	}
      return  random(50);
    }
  else return(0);
}





