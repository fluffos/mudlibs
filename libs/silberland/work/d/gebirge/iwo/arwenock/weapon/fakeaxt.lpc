#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <wizlevels.h>

#define COST 100

/*  Rubin:       feuerrot, DT_FIRE , Zwergenmine (angrox)
    Aquamarin:   wasserblau, DT_WATER, Feenschloss (trogor)
    Topas:       sonnengelb, DT_AIR, Dschungel (dante)
    Smaragd:     giftgruen, DT_POISON, Dschungel (dante)
    Saphir:      eisblau, DT_COLD, Dschungel (dante)
    Opal:        magisch in allen Farben schillernd, DT_MAGIC, Dschungel (dante)
    Lapislazuli: aetzend gruen, DT_ACID, Dschungel (dante)
    Onyx:        schrecklich schwarz, DT_TERROR, ??? (???)
    Perle:       berauschend schoen, DT_SOUND, Korallenriff (feyaria)
    Bernstein:   leuchtend gelb, DT_LIGHT, Kristallwald (sargola)
    Granat:      dunkelrot, DT_LIGHTNIG, ??? (???)
    Zirkon:      braun, DT_ELECTIRC, ??? (???)
    Diamant:     durchsichtig, DT_EXPLOSION, Dschungel (dante)
*/

#define RUBIN 1
#define AQUAMARIN 2
#define TOPAS 3
#define SMARAGD 4
#define SAPHIR 5
#define OPAL 6
#define LAPISLAZULI 7
#define ONYX 8
#define PERLE 9
#define BERNSTEIN 10
#define GRANAT 11
#define ZIRKON 12
#define DIAMANT 13


string gem_name;
int edelstein;
string *dt;
int fake;

create()
{
  if (!is_clone(TO) )  return;

  ::create();
  dt=({DT_SLASH, DT_FIRE, DT_WATER, DT_AIR, DT_POISON, DT_COLD,
       DT_MAGIC, DT_ACID, DT_TERROR, DT_SOUND, DT_LIGHT, DT_LIGHTNING,
       DT_ELECTRIC, DT_EXPLOSION});

  SetProp(P_SHORT, "Eine Berserkeraxt");
  SetProp(P_LONG, BS( 
    "Das ist die Axt eines Berserkers. Sie hat einen langen Holzstiel und "
    "ein grosses, doppelschneidiges Axtblatt. Am Ende des Holzstiels "
    "befindet sich unterhalb des Griffes eine kleine Einbuchtung.") );
  SetProp(P_INFO, BS(
    "Diese Axt koennen nur Berserker verwenden.") );
  SetProp(P_NAME, "Berserkeraxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"berserkeraxt", "axt", "baxt", "\nberserkeraxt"}) );
  AddDetail( ({"stiel", "holzstiel"}),
    "Der Holzstiel ist ueber einen Meter lang und hat einen ledernen Griff "
    "am unteren Ende. Dort befindet sich auch eine kleine Einbuchtung. Am "
    "oberen Ende ist das grosse Axblatt angebracht.");
  AddDetail( ({"blatt", "axtblatt"}),
    "Das Axtblatt hat zwei grosse, scharfe Schneiden und ist aus einem "
    "sehr hartem Stahl geschmiedet.");
  AddSpecialDetail( ({"einbuchtung"}), "einbucht");

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 275);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS, (["BERSERKER": 200]) );
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_RIP}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:60, MAT_ADAMANT:40]) )  ;
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 29000);
  // Viel zu teuer um verkauft zu werden ;)
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  // cleared (public readable)
  // SetProp(P_WIELD_RESTRICTIONS, ([]));

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  AddCmd( ({"reinsteck", "reinstecke"}), "stecken");

}

int WieldFunc(object waffe, int silent)
{
  if( TP->id("BERSERKER") ) return 1; 
  if( TP->QueryProp(P_GUILD) == "berserker" )
  {
    if( !silent )
      write("Ein Gefuehl der Macht durchdringt Dich.\n");
    return 1;
  }
  if( !silent )
    write("Du musst schon ein Berserker sein, um diese Axt verwenden zu "
          "koennen.\n");
  return 0;
}

int HitFunc( object enemy )
{
  // removed due to public access
  int l;
  if (!fake)
    {
      SetProp(P_WC, 10);
      SetProp(P_WC_FIX, 0);
      SetProp(P_WC_BONUS, (["BERSERKER": 0]) );
      SetProp(P_LONG, TO->QueryProp(P_LONG) + "Scheinbar ist irgendwas nicht in "
              "Ordnung mit der Axt.");
      SetProp(P_CURSED, 1);
      fake = 1;
    }
  return 0;
}


string einbucht()
{
  if( edelstein )
    return "In der kleinen Einbuchtung befindet sich "+gem_name+".\n"; 
  else
    return BS("Die Einbuchtung ist so klein, dass man nur einen kleinen "
              "Edelstein dort reinstecken koennte.");
}

int stecken(string str)
{
  string was;
  object ob;
  notify_fail("Was willst Du wo hinein stecken?\n");
  if( !str) return 0;
  if( sscanf(str, "%s in einbuchtung",was)!=1 )
  was=str;
  {
    if( ob=present(was,TP) )
    {
      if( ob->QueryMaterialGroup(MATGROUP_JEWEL)==100 )
      {
        if(!edelstein)
        {
          if( ob->id("rubin") )       edelstein=RUBIN;
          if( ob->id("aquamarin") )   edelstein=AQUAMARIN;
          if( ob->id("topas") )       edelstein=TOPAS;
          if( ob->id("smagard") )     edelstein=SMARAGD;
          if( ob->id("saphir") )      edelstein=SAPHIR;
          if( ob->id("opal") )        edelstein=OPAL;
          if( ob->id("lapislazuli") ) edelstein=LAPISLAZULI;
          if( ob->id("onyx") )        edelstein=ONYX;
          if( ob->id("perle") )       edelstein=PERLE;
          if( ob->id("bernstein") )   edelstein=BERNSTEIN;
          if( ob->id("granat") )      edelstein=GRANAT;
          if( ob->id("zirkon") )      edelstein=ZIRKON;
          if( ob->id("diamant") )     edelstein=DIAMANT;
          if(!edelstein)
          {
            write("Der Edelstein passt nicht!\n");
            return 1;
          }
//          SetProp(P_DAM_TYPE, ({DT_SLASH, DT_RIP})+({dt[edelstein]}) );
//          SetProp(P_DAM_TYPE, ({dt[edelstein]}) );
          write("Du steckst "+ob->name(WEN)+" in die Einbuchtung hinein.\n");
          gem_name=ob->name(WER);
          ob->AddAmount(-1);
          return 1;
        }
        else
          notify_fail("Da steckt schon ein Edelstein in der Einbuchtung.\n");
      }
      else
        notify_fail( CAP(ob->name(WER))+" ist doch gar kein Edelstein!\n");
    }
    else 
      notify_fail(CAP(was)+"? Sowas hast Du doch gar nicht!\n");
  }
  return 0;
}

