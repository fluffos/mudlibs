inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include <new_skills.h>
#include <material.h>
#include <wizlevels.h>

#define ABS(x) (x>0?x:-x)

#define KATANAROOM "/d/gebirge/iwo/arwenock/room/room_D-02.lpc"
  
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Drachenkopf Katana");
  SetProp(P_LONG,
        "Das Drachenkopf Katana ist ein Schwert mit einer langen, "+
        "gebogenen Klinge. Das Metall wurde zweihundert mal gefaltet und "
	"das Ende des kunstvoll verzierten Griffes zeigt einen "
	"Drachenkopf.");
  SetProp(P_NAME, "Katana");
  AddId( ({"schwert","katana","drachenkopf" }));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WC, 250);
  SetProp(P_WC_FIX, 30);
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_WEIGHT, 1500);  
  SetProp(P_VALUE, 120000); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:90, MAT_IVORY:10]));
  SetProp(P_DAM_TYPE,DT_SLASH);
  SetProp(P_NR_HANDS, 2);
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 10,A_DEX:10]));
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_UNWIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_INFO,break_string(
   "Besonders in etwa gleich grosse Lebewesen fuerchten die Schlaege dieses Schwertes.",78));
  SetHitFunc(this_object());
  seteuid(getuid(this_object()));

  AddDetail( ({ "klinge" }),
    "Das Material der Klinge wurde zweihundert mal gefaltet. Die Klinge ist "
    "wie bei einem typischen Katana leicht nach oben gebogen und "
    "verleiht dem Schwert eine besonders gute Fuehrung beim Abtrennen "
    "von Koerperteilen dadurch.");

  AddDetail( ({ "griff", "drachenkopf" }),
    "Der Griff besteht vollstaendig aus Elfenbein und lliegt nachezu "
    "perfekt in der Hand. Das Ende des Griffes ziert ein kunstvoll "
    "gefertigter Drachenkopf.");
    
}


void tell_iwo(string str)
{
  if (find_player("iwo")) tell_object(find_player("iwo"),
                                      break_string(str, 78, "KATANA: "));
  return;
}


int WieldFunc(object weapon, int silent)
{
  if(TP->QueryProp(P_TMP_DEFEND_HOOK))
    {
      tell_object(TP, BS("Irgendwas stoert Deine Bewegungsfreiheit. "
                         "So kannst Du keine Attacken parieren!"));
    }
  TP->SetProp(P_TMP_DEFEND_HOOK, ({ 999999999, TO, "defend_func" }));
  return 1;
}


int UnwieldFunc(object weapon, int silent)
{
  TP->SetProp(P_TMP_DEFEND_HOOK, 0);
  return 1;
}

mixed defend_func(int dam, mixed dam_type, mixed spell, object enemy)
{
  object *armours;
  object weapon;
  int effective_armours;
  int i;
  
  // Totes klump defended nicht
  if (!living(PO)) 
      return ({ dam, dam_type, spell, enemy });

  tell_iwo(PO->Name());
  
  // Physischer schaden?
  if (!sizeof(filter_array(dam_type,PHYSICAL_DAMAGE_TYPES)))
      return ({ dam, dam_type, spell, enemy });
      
  // Katana gezueckt?
  weapon = PO->QueryProp(P_WEAPON);
  if (!weapon || !weapon->id("katana"))
    {
      // Kann theoretisch nicht passiern, aber sicher ist sicher
      PO->SetProp(P_TMP_DEFEND_HOOK, 0);
      return ({ dam, dam_type, spell, enemy });
    } 
  
  // Das sollte 'verfehlt' abdecken...
  armours = PO->QueryProp(P_ARMOURS);
  effective_armours = 0;
  for (i = 0; i < sizeof(armours); i++)
    {
      if (armours[i]->QueryProp(P_AC)) effective_armours++;
    }
  if (effective_armours * 5 > dam)
      return ({ dam, dam_type, spell, enemy });
      
   
  // Chance den Schlag abzuwehren
  if (random(3) != 1)
      return ({ dam, dam_type, spell, enemy });

  //
  // Ok, wir ham einen Schlag abzuwehren
  //
  
  tell_object(PO, BS("Das Katana leuchtet silbrig auf."));
  
  // Ich glaub das geht nicht bei Waffen, drum catch()
  TO->TakeFlaw( ({ DT_BLUDGEON }) );
  
  dam = 0;
  
  tell_object(PO, BS("Du wehrst die Attacke mit "
                     "dem Katana ab."));
  tell_object(enemy, BS(PO->Name(WER) + " wehrt Deine "
              "Attacke mit dem Katana ab."));
	      
  tell_room(ENV(PO), BS(TP->Name(WER) + " wehrt die Attacke mit "
                        "dem Katana ab."), ({ PO, enemy }));
  
  
  return ({ dam, dam_type, spell, enemy });
  
}


int HitFunc(object enemy)
{
    int esize;
    int tpsize;
    int sizemin;
    int sizemax;
    int tpstr;
    int tpdex;
    int estr;
    int edex;
    int dexmin;
    object weapon;
    object fighter;

    if (!fighter = environment(ME)) return 0;

    esize   = enemy->QueryProp(P_SIZE);
    tpsize  = fighter->QueryProp(P_SIZE);
    sizemin = (int) (tpsize - (tpsize * 0.5));
    sizemax = (int) (tpsize + (tpsize * 1.7));
    tpstr   = fighter->QueryAttribute(A_STR);
    tpdex   = fighter->QueryAttribute(A_DEX);
    estr    = enemy->QueryAttribute(A_STR);
    edex    = enemy->QueryAttribute(A_DEX);
    dexmin  = edex;
    
    if ((esize > (int) sizemin) && (esize < (int) sizemax) 
         && tpdex >= dexmin)
      {
        if ((random(100)>=90))
          {
            if (weapon = enemy->QueryProp(P_WEAPON))
              {
	  
                tell_object(fighter, BS("Du versuchst " + enemy->name(WEN) 
                                        + " zu entwaffnen."));
                tell_room(environment(fighter), BS(fighter->Name(WER) + " versucht "
                                              + enemy->name(WEN) + " zu entwaffnen."),
                          ({ fighter,enemy }));
                tell_object(enemy, BS(fighter->Name(WER) + " versucht Dich zu entwaffnen."));

                if ((random(100 - tpdex) >= 50) && (estr < tpstr))
                  {
                    tell_room(environment(fighter), BS("Die Waffe von " 
                                                       + enemy->name(WEM) 
                                                       + " fliegt in hohem Bogen zu Boden."),
                              ({ enemy }));
                    tell_object(enemy, BS("Deine Waffe fliegt in hohem Bogen zu Boden."));
                    
                    weapon->move(environment(enemy), M_NOCHECK + M_SILENT);
                    
                    return random(50);
                  }
                else 
                  {
                    tell_object(fighter, BS(enemy->Name(WER) + " trifft Dich ungedeckt."));
                    tell_room(environment(fighter), BS(enemy->Name(WER) + " trifft " 
                                                       + fighter->name(WEN) + " ungedeckt"),
                              ({ fighter, enemy }));
                    tell_object(enemy, BS("Du triffst " + fighter->name(WEN) + " ungedeckt."));
                    SetProp(P_KILL_NAME, enemy->Name(WER));
                    fighter->do_damage(10 + random(20));					    
                    return 0;
                  }
              }
            else
              {
                //if (enemy->QueryProp(P_HP) > 
                //    enemy->QueryProp(P_MAX_HP)/4) return 0;
                tell_object(fighter, BS("Du trittst " + enemy->name(WEN) 
                                        + " zu Boden und schlaegst ihm den Kopf ab."));
                tell_room(environment(fighter), BS(fighter->Name(WER) + " tritt " 
                                                   + enemy->name(WEN) + " zu Boden und "
                                                   + "schlaegt " + enemy->QueryPronoun(WEM) 
                                                   + " den Kopf ab."), 
                          ({ fighter,enemy }));
                tell_object(enemy, BS(fighter->Name(WER) + " tritt Dich zu Boden und "
                                      + "schlaegt Dir den Kopf ab."));

                enemy->SetProp(P_HP, 0);

                return random(50);
              }
          }
        return  random(50);
      }
}


int move(mixed dest, int method)
{

  object carrier;


  tell_iwo("Move called. Destination:" + file_name(dest) + " Method: " + (string) method
           + " Environment: " + (string) environment(ME));

  // return ::move(dest, method);

  if ((carrier = environment(ME)) && (interactive(environment(ME)) && !IS_ARCH(dest)))
    {

      tell_iwo("Zerstoere Katana.");

      tell_object(carrier, BS("Als Du " + TO->name(WEN) 
                              + " ablegst bildet sich ein merkwuerdiger "
                              + "magischer Schimmer um die Waffe und sie verschwindet vor "
                              + "Deinen Augen."));
      tell_room(environment(carrier), BS("Als " + carrier->Name(WER) + " " +TO->name(WEN) 
                                         + " ablegt "
                                         + "bildet sich ein merkwuerdiger magischer Schimmer "
                                         + "um die Waffe und sie verschwindet vor "
                                         + "Deinen Augen."),
                ({ carrier }));

      call_out("me_remove", 2);
      KATANAROOM->wiederda();
      return 0;

    }

  return ::move(dest, method);

 

}

int me_remove()
{
 return remove();
}

void remove()
{
  KATANAROOM->wiederda();
  ::remove();
}
