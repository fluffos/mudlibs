inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"


#define WIZNAME "iwo"
  
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Mob");
  SetProp(P_LONG,
    "Igitt, dieses Teil sieht einfach scheusslich aus. Die zahlreichen "
    "Federn leuchten in allen moeglichen Farben, und der ellenlange "
    "Stiel ist in giftigem Gruen gehalten.");


  SetProp(P_NAME, "Mob");
  AddId( ({"mob" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_WC, 60);
  SetProp(P_WEIGHT, 700);  
  SetProp(P_VALUE, 120); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_DAM_TYPE,DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );

  AddDetail( ({ "federn" }),
    "Du ahst keine Ahnung welche Federn das sein koennten.");
  AddDetail( ({ "farben" }),
    "Alle moeglichen halt.");
  AddDetail( ({ "stiel" }),
    "Der Stiel ist etwa so lang wie ein Zwergenarm und giftgruen.");

}


