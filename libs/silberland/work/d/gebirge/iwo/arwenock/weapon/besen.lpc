inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"


#define WIZNAME "iwo"
  
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Besen");
  SetProp(P_LONG,
    "Der Besen hat einen langen Stiel aus Holz, und an einem "
    "Ende eine Buerste, die wie es scheint mit Rosshaar bestueckt "
    "ist.");

  SetProp(P_NAME, "Besen");
  AddId( ({"besen" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_WC, 100);
  SetProp(P_WEIGHT, 1000);  
  SetProp(P_VALUE, 300); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_DAM_TYPE,DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );

  AddDetail( ({ "stiel" }),
    "Der Stiel ist lang, rund und aus Holz - und liegt erstaunlich "
    "gut in der Hand.");
  AddDetail( ({ "buerste" }),
    "Eigentlich nicht mehr, als ein Stueck Holz, dass einerseits an "
    "einem Stiel befestigt ist, und andererseits Rosshaare traegt.");
  AddDetail( ({ "rosshaare" }),
    "So scheint es jedenfalls.");

}


