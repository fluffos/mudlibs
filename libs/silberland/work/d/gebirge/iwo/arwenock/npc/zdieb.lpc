/*        
**  Meisterdieb vergibt Quest an Nekros, Delfen, ... (dunkle Seite)
**
**  Zaknafein, Mai 2001
*/

#include "../def.h"
inherit STDNPC;
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>

#define WIZNAME "zaknafein"
#define ARWENOCKQUEST "name"
#define ARWENOCKQUESTLOG "/log/quests/name"

void init()
{
  ::init();
  if(interactive(this_player())) call_out("reaktion",2);
} 

create()
{
  return;

  if (!is_clone(this_object())) return;

  ::create();       

  
  SetProp(P_SHORT, "Kashi der Meisterdieb");
  SetProp(P_LONG, "Kashi scheint hier etwas verloren zum zu stehen. "
    "Nicht, dass er den Eindruck macht, als waere er ein besonders "
    "Angenehmer Zeitgenosse, denkst Du trotzdem darueber nach, was "
    "das bedeuten koennte.");
  SetProp(P_NAME, "kashi");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  create_default_npc(35);
  SetProp(P_ALIGN, -600); 
  SetProp(P_SIZE, 209);  
  SetProp(P_BODY, 600);
  SetProp(P_HANDS, ({" mit seinen gewaltigen Faeusten", 400, DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.2,
      DT_HOLY:      0.0, DT_UNHOLY:    -0.2, DT_MAGIC:  0.3 ]) );
  SetProp(P_WIMPY, 0);
  AddId( ({ "NOWIMPY" , "dieb" , "meisterdieb" , "kashi" }) );

  AddCmd( ({ "biete" , "biet" }), "bieten");

/*
  seteuid(getuid(this_object()));

  clone_object(ARMOUR "zkampfhose" )->move(this_object());
  clone_object(ARMOUR "zachselhemd" )->move(this_object());
  clone_object("/p/armour/lederstiefel" )->move(this_object());

  command("ziehe alles an");
*/

  SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC, 30);

  AddSpell(1,500, 
	   "\n",
	   "@WEN.\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,600,
	   "\n",
	   "\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddInfo (DEFAULT_INFO, ({ "sagt: Ach wenn mir nur jemand helfen koennte!" }));

  AddInfo("hilfe", "fragt: Du wuerdest mir wirklich Deine Hilfe anbieten?");
}

bieten( str )
{
notify_fail( "Wem moechtest Du was anbieten?\n" );
if( str == "dieb hilfe an" || str == "hilfe an" || str == "meisterdieb hilfe an" || str == "kashi hilfe an")
	{
           object ob;

           if (ob=present(("\nzakschlange"), this_player()))
               {
                 write(BS("Der Meisterdieb lacht: Du hilfst mir doch schon, Du Depp!\n"));
                 return 1;
               }

           if (ob=present(("\nzakmaus"), this_player()))
               {
                 if(ob->queryspielstand()==0)       // Spieler muss noch Hilfe anbieten!
			{
                 	  ob->setspielstand();
	                  write(break_string("Gut, Deine erste Aufgabe wird es sein, mir den "
                            "Schuldschein zu bringen, den Quax von mir hat. "
                            "Ich schulde ihm eine nicht geringe Summe. Eile und "
                            "und bring ihn mir!" ,78,"Der Meisterdieb erklaert: "));
                          return 1;
			}
                 else
			{
                          write(BS("Der Meisterdieb lacht: Du hilfst mir doch schon, Du Depp!\n"));
			  return 1;			  
			}
               }

 	   if(this_player()->QueryProp(P_GUILD)=="paladine")
	       {
                write(BS("Niemals wuerdest diesem Dieb helfen! Geh' und hilf dem Gesetz!\n"));
		return 1;
	       }

	 clone_object(OBJ "zschlange" )->move(this_player(), M_NOCHECK);
	 write(break_string("Gut, Deine erste Aufgabe wird es sein, mir den "
                            "Schuldschein zu bringen, den Quax von mir hat. "
                            "Ich schulde ihm eine nicht geringe Summe. Nimm "
                            "diese Schlange mit. Sie wird mir berichten, wie "
                            "Du Dich angestellt hast!" ,78,"Der Meisterdieb erklaert: "));
         write("Der Meisterdieb gibt Dir eine kleine Schlange.\n");
         return 1;
        }      
return 0;	 
}

reaktion()
{
object ob;
object obj;
 
if(environment(this_player())!=environment(this_object())) return;

 if (ob=present(("\narwqi"), this_player()))
  {

// 1. Aufgabe (Schuldschein von Quax besorgt) geloest?

   if(ob->queryspielstand()==1)
    {
      if(obj=present(("\nzakschein"), this_player()))
       {
         write(BS("Der Meisterdieb meint: Ah, sehr gut, her mit dem Schuldschein!\n"));
	 write("Du gibst Kashi den Schuldschein.\n");
         obj->remove();
	 ob->setspielstand();
       }
      else
       write("Der Meisterdieb bruellt: Wo ist der Schuldschein, "+this_player()->name(WER,2)+"?!?!\n");	
      return;
    } 


   if(ob->queryspielstand()==5)
    {
      if (!this_player()->QueryQuest(ARWENOCKQUEST)) 
       {
          if( this_player()->GiveQuest(ARWENOCKQUEST) == 1)
            {
             write_file (ARWENOCKQUESTLOG,
             sprintf ("%s  %s hat die Quest bestanden!\n",
             dtime(time()), capitalize(this_player()->query_real_name())));
            }
          else 
            {
             write_file (ARWENOCKQUESTLOG,
             sprintf ("%s: Fehler bei %s!\n",
             dtime(time()), capitalize(this_player()->query_real_name())));
            }
       }
    } 

  }
 else
 write(BS("Der Meisterdieb meint: "+this_player()->name(WER,2)+", was willst Du denn hier?\n"));
      
return;
}

