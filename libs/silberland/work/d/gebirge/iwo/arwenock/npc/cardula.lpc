void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Cardula die Kassierin");
  SetProp(P_LONG,
    "Cardula ist der hiesige Museumskassier. Ihr wirst Du wohl ein bisschen "
    "Geld geben muessen, wenn Du das Museum betreten willst. Sie ist eine "
    "nette, rundliche Hobbitfrau, die immer ein Grinsen auf den Lippen "
    "hat.");
  SetProp(P_NAME, "Cardula");
  SetProp(P_GENDER, FEMALE);


  create_default_npc(15);


  AddId( ({ "cardula", "kassiererin", "kassierin", "hobbit" }));


  SetProp(P_HANDS, ({" mit ihren kleinen Haenden",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Cardula sagt: Danke, aber was soll ich damit?\n" }) );

  AddCmd( ({ "kauf", "kaufe" }), "ekarte");

  enable_commands();

  AddInfo("hirn", "Besonders schlau bin ich ja nicht..", "seufzt: ");
  AddInfo("museum", "Wir veranstalten hier diverse Ausstellungen alter Gegenstaende." ,  "antwortet: ");
  AddInfo("del", "Der macht sich immer lustig ueber mich.", "schluchzt: ");
  AddInfo( ({ "ausstellungen" }),
    "Derzeit residiert hier die Ausstellung 'Vitae Fin'.", "antwortet: ");
  AddInfo( ({ "vitae", "fin" }),
    "Del meint, ich waere nicht sonderlich schlau...", "antwortet: ");
  AddInfo( ({ "ausstellung" }),
    "Hier haengt ein Plakat der aktuellen Ausstellung.", "sagt: ");
  AddInfo( ({ "waffen", "waffe" }),
    "Da fuerchte ich mich immer ganz viel!", "sagt: ");
  AddInfo( ({ "ruestung", "ruestungen" }),
    "Ach, damit kenne ich mich garnicht aus. Ich bin ja viel "
    "zu klein um damit etwas anzufangen.", "sagt: ");
  AddInfo( ({ "alter" }),
    "Ich bin natuerlich zwanzig!", "grummelt: ");
  AddInfo( ({ "gegenstand", "gegenstaende" }),
    "Kauf Dir doch einfach eine Karte und sieh sie Dir an?", "sagt: ");
  AddInfo( ({ "karte", "karten", "eintrittskarte", "eintrittskarten" }),
    "Ich verkaufe welche!", "sagt: ");
/*
  AddInfo( ({ "arwenock" }),
    "Ja, ich wohne in dieser Stadt.", "sagt: ");
  AddInfo( ({ "stadt" }),
    "Ich habe leider keine Zeit sie Dir zu zeigen, aber vielleicht "
    "kann Dir das Blumenmaedchen helfen.", "sagt: ");
  AddInfo( ({ "blumenmaedchen", "maedchen" }),
    "Ich kenne sie nicht besonders gut, aber sie kennt sich wohl "
    "etwas aus hier.", "sagt: ");
  AddInfo( ({ "zeit" }),
    "Fuer mich ist wohl Mahlzeit!", "sagt: ");
  AddInfo( ({ "mahlzeit" }),
    "Ich haett sooo gern ein Leberkaessemmerl!", "schwaermt: ");
  AddInfo( ({ "leberkaessemmerl", "semmerl" }),
    "Vielleicht gibts drueben am Markt welche?", "gruebelt: ");
  AddInfo( ({ "markt" }),
    "Ich denke heute ist Markttag, hier vergisst man die Zeit "
    "ziemlich schnell.");
  AddInfo( ({ "markttag" }),
    "Der Tag an dem Markt ist.");
*/
  clone_object("/p/armour/trousers/rock_kurz")->move(ME, M_NOCHECK);
  clone_object("/p/armour/armour/bluse")->move(ME, M_NOCHECK);
  clone_object("/p/armour/helm/hut")->move(ME, M_NOCHECK);
  command_me("trage alles");

  if (find_player("iwo"))
    tell_object(find_player("iwo"),
      break_string("Repariere mich!", 78, "Cardula teilt Dir mit: "));
}


int ekarte(string str)
{
  object ob;
  
  if (!str || strstr(str, "karte") == -1)
    {
      command_me(sprintf("sag Was willst Du denn kaufen, %s?",
                  TP->Name(WER)));
      return 1;
    }
    
  
		 
  if (TP->QueryMoney() < 120)
    {
      command_me("sag Die Eintrittskarte kostet 120 Muenzen. Soviel hast Du aber nicht!");
      return 1;
    }
  
  TP->AddMoney(-120);
  
  tell_object(TP, BS("Du gibst Cardula 120 Muenzen."));
  tell_room(ENV(TP), BS(TP->Name(WER) + " kauft eine Eintrittskarte."),
            ({ TP }));
  ob = clone_object(OBJ "musekarte");
  if(ob->move(TP, M_GET) != 1) {
    command_me("sag Leider kannst du die Karte gar nicht tragen! Hier hast du dein Geld zurueck.");
    ob->remove(1);
    TP->AddMoney(120);
  }
  command_me("sag Danke!");

  return 1;
 
}

int checkentrance(object player)
{
  if (!present("\nmusekarte", player))
    {
      command_me(sprintf("sag Ohne Eintrittskarte kann ich Dich nicht reinlassen, %s!",
                 TP->Name(WER)));
      return 0;
    }
  return 1;
}
