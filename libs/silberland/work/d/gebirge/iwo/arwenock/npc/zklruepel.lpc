/*        
**                      Ein kleiner Ruepel 
**  (Gibt Hinweise, wie man mit dem Oberruepel einen Streit anfaengt.)
**
**                    Zaknafein, Februar 2000
**
*/
#include "../def.h"
inherit STDNPC;
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>

#define WIZNAME "zaknafein"

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Ein kleiner Ruepel");
  SetProp(P_LONG, "Dieser kleine niedliche Junge will einmal ein grosser "
                 +"Oberruepel werden. Naja, da muss er wohl noch ein wenig "
                 +"wachsen... Egal, jedenfalls ist er unglaublich schmutzig "
                 +"und schon ziemlich frech fuer sein Alter. Er kann Dir "
                 +"sicher weiterhelfen, wenn Du erfahren moechtest, wie man "
                 +"einen Streit beginnt.");
  SetProp(P_NAME, "Ruepel");
  AddAdjective( ({ "klein" , "kleinen" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Mensch");
  create_default_npc(15);
  SetProp(P_ALIGN, -200); 
  SetProp(P_SIZE, 136);  
  SetProp(P_BODY, 150);
  SetProp(P_HANDS, ({" mit blossen Haenden", 100, DT_BLUDGEON}) );
  SetProp(P_NOATTACK, "ist zu niedlich. Du willst ihm nichts tun."); // erstmal nicht angreifbar
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT, ({REJECT_GIVE, "Der kleine Ruepel meint: "
                         +"Nein, das ist nur was fuer kleine Kinder.\n"}));  
  AddId( ({ "NOWIMPY" , "ruepel" , "junge" }) );
  seteuid(getuid(this_object()));

/*
  clone_object(ARMOUR(""))->move(this_object());
  clone_object(ARMOUR(""))->move(this_object());
  clone_object(ARMOUR(""))->move(this_object());
  clone_object(ARMOUR(""))->move(this_object());
  command("ziehe alles an");
*/

   SetChats(1, ({
  "Der kleine Ruepel versteckt seine Spielsachen vor Dir.\n",
  "Der kleine Ruepel sagt: Ich will mal ein Oberruepel werden!\n",
  "Der kleine Ruepel will Dich bestehlen, was ihm aber kaum gelingt.\n"
  }) );

  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n" );
 
  SetProp(P_DEFAULT_INFO,"schaut Dich nur frech an.\n");

  AddInfo("zaknafein",
  "kichert: Zaknafein ist der groesste Ruepel ueberhaupt!\n");
  AddInfo("arwenock",
  "Wenn ich erstmal erwachsen bin, werde ich der groesste Ruepel "
 +"von ganz Arwenock sein.\n" , "traeumt: ");
  AddInfo("streit",
  "Ha, Du willst wissen, wie man einen Streit beginnt? Gut, spitze "
  "Deine Lauscher! Am besten beginnst Du, indem Du Dein Gegenueber "
 +"erstmal anstarrst. Beisst er an, so sagt er bestimmt 'Schau mich "
 +"nicht so bloede an, Freundchen!'. Haha, so, dann antwortest Du 'Ich bin "
 +"nicht Dein Freund, Penner!' Hui, und dann geht es los...\n","ereifert sich: ");
  AddInfo("oberruepel",
  "erklaert Dir: Der Oberruepel wohnt hier in dem kleinen Haus.\n");
  AddInfo("haus",
  "Ja, der Oberruepel wohnt in dem Haus hier. Du kommst aber nur rein, "
 +"wenn Du einen Schluessel hast.\n" , "erklaert: ");
  AddInfo("schluessel",
  "Soweit ich weiss, hat er ihn hier irgendwo versteckt...\n" , "erzaehlt: ");
  AddInfo("ruepel",
  "Haha, wir Ruepel sind echt fies und gemein!\n" , "sagt: ");

  AddDetail( ({ "spielsachen" , "sachen" }) ,
    "Seine Spielsachen versteckt der kleine Ruepel vor Dir. "
   +"Schliesslich will er ruepelhaft und boese wirken. Da machen sich "
   +"Spielsachen nicht so gut...\n" );
  AddDetail( "schmutz"  ,
    "Bah, der kleine Ruepel ist echt schmutzig und stinken tut er auch.\n" );
  AddDetail("alter" ,
    "Du schaetzt, dass er ungefaehr 11 Jahre alt ist.\n" );
  AddDetail("streit" ,
    "Sehen kannst Du den bestimmt nicht, aber der kleine Ruepel "
   +"erzaehlt Dir bestimmt gerne was darueber.\n" );
}