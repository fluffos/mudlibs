/*        
**                 Das Blumenmaedchen in Arwenock
**      (Hilft man ihr, so zeigt sie dem Spieler ein Sehertor.)
**
**                    Zaknafein, Februar 2000
**
*/

#include "../def.h"
inherit STDNPC;
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#define WIZNAME "zaknafein"
#define TP this_player()

void init()
{
  ::init();
  if(interactive(this_player())) call_out("reaktion",2);
} 

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Ein Blumenmaedchen");
  SetProp(P_LONG, "Das Blumenmaedchen ist wirklich suess. Es steht hinter "
                 +"ihrem Blumenstand und stellt fleissig Blumenstraeusse "
                 +"zusammen, die einen wunderbaren Duft verbeiten. Sie "
                 +"traegt ein huebsches, buntes Kleid und schaut Dich mit "
                 +"ihren grossen Augen aufmerksam und froehlich an. Aber "
                 +"was ist das? Sie hat ein blaues Auge. Wer hat dem armen "
                 +"Kind das bloss angetan? Du musst sie unbedigt danach "
                 +"fragen!");
  SetProp(P_NAME, "Blumenmaedchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Mensch");
  create_default_npc(10);
  SetProp(P_ALIGN, 600); 
  SetProp(P_SIZE, 158);  
  SetProp(P_BODY, 300);
  SetProp(P_HANDS, ({" mit blossen Haenden", 250, DT_BLUDGEON}) );
  SetProp(P_NOATTACK, "versteckt sich hinter ihrem Blumenstand."); // erstmal nicht angreifbar
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.3, DT_COLD:      0.3, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.2,
      DT_HOLY:      0.0, DT_UNHOLY:    0.3, DT_MAGIC:  0.0 ]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT, ({REJECT_GIVE, "Das Maedchen sagt: Danke, aber das brauche ich nicht.\n"}));  
  AddId( ({ "NOWIMPY" , "maedchen" , "blumenmaedchen" }) );
  seteuid(getuid(this_object()));

/*
  clone_object(ARMOUR(""))->move(this_object());
  clone_object(ARMOUR(""))->move(this_object());
  clone_object(ARMOUR(""))->move(this_object());
  clone_object(ARMOUR(""))->move(this_object());
  command("ziehe alles an");
*/

  SetProp(P_SPELLRATE,30);
  SetProp(P_NOMAGIC, 5);

/*
   Erstmal keine Spells fuer das Blumenmaedchen. Man kann es ja eh 
   vorerst nicht angreifen. 

  AddSpell(1,300, 
	   "\n",
	   "\n",
           DT_,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
	   "\n",
	   "\n",
           DT_,([SP_SHOW_DAMAGE:1]));
*/

  SetChats(2, ({
  "Das Blumenmaedchen schneidet ein paar Blumen zurecht.\n",
  "Das Blumenmaedchen stellt einen Blumenstrauss zusammen.\n",
  "Das Blumenmaedchen reibt sich ihr blaues Auge.\n"
  }) );

  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n" );
 
  SetProp(P_DEFAULT_INFO,"schaut Dich fragend an.\n");

  AddInfo("zaknafein",
  "sagt stolz: Zaknafein ist ein guter Freund von mir.\n");
  AddInfo("arwenock",
  "sagt: Eine schoene Stadt! Findest Du nicht?\n");
  AddInfo( ({ "blaues auge" , "auge" , "blauem Auge" }) ,
  "weint: Wuahhahaha, der Oberruepel hat mir das angetan.\n");
  AddInfo( ({ "ruepel" , "oberruepel" }) ,
  "Der Oberruepel treibt sich im Nordwesten der Stadt herum. "
 +"Leider muss ich immer an ihm vorbei, wenn ich zur Arbeit gehe. "
 +"Er aergert mich staendig und macht sich ueber mich lustig. "
 +"Heute hat er mir sogar ein blaues Auge verpasst! Er ist ja so "
 +"gemein! Magst Du mir helfen? <biete maedchen hilfe an>\n", "erklaert weinerlich: ");
  AddInfo("hilfe",
  "deutet auf ihr blaues Auge und faengt an zu weinen.\n");
  AddInfo("arbeit",
  "sagt: Ich arbeite hier und verkaufe Blumen.\n");
  AddInfo( ({ "blumen" , "blumenstrauss" , "strauss" }) ,
  "Ich kann Dir einen schoenen Blumenstrauss verkaufen. Er kostet nur "
 +"1000 Muenzen. <kaufe blumen>\n" , "sagt froehlich: ");
  AddInfo( ({"nordwesten" , "stadt" }) ,
  "erklaert: Im Nordwesten der Stadt wohnen die armen Leute.\n");
  AddInfo("leute",
  "sagt traurig: Arme Leute wie ich wohnen dort, aber auch Ruepel.\n");
  AddInfo("streit",
  "Frage mal den kleinen Ruepel, der sich in der Naehe des Oberruepels "
 +"rumtreibt. Der kennt sich bestimmt bestens damit aus, wie man einen "
 +"Streit anfaengt.\n","schlaegt vor: ");


  AddDetail( ({ "auge" , "blaue auge"  , "blaues auge" }) ,
    "Wer hat dem armen Maedchen bloss ein blaues Auge verpasst? "
   +"Am besten ist es,  Du fragst sie gleich mal danach. Vielleicht "
   +"kannst Du ihr ja helfen.\n" );
  AddDetail("kleid" ,
    "Das Kleid ist wirklich huebsch, aber Dir steht es bestimmt nicht.\n" );


  AddCmd( ({ "biete" , "biet" }) , "bieten");
  AddCmd( ({ "kauf" , "kaufe" }) , "kaufen");

}

kaufen( str )
{
notify_fail( "Was moechtest Du kaufen?\n" );
if( str == "blumen" || str == "blumenstrauss" ||str == "strauss" )
	{
           if((this_player()->QueryMoney())>=1000) 
           {
           write(BS("Das Blumenmaedchen verkauft Dir einen wunderschoenen Blumenstrauss.\n"));
           tell_room(environment(TP), "Das Bumenmaedchen verkauft "
           +capitalize(TP->query_real_name())+" einen wunderschoenen Blumenstrauss.\n", ({ TP }));
           this_player()->AddMoney(-1000);
           clone_object(OBJ "strauss")->move(this_player(), M_NOCHECK);
           return 1;
           }
           else
           {
           write(BS("Das Blumenmaedchen sagt: Du hast leider nicht genug Geld...\n"));
           return 1;
           }
        }      
return 0;	 
}

bieten( str )
{
notify_fail( "Wem moechtest Du was anbieten?\n" );
if( str == "maedchen hilfe an" || str == "blumenmaedchen hilfe an" ||str == "hilfe an" )
	{
           object ob;
           if(query_wiz_level(this_player()) <1)
           {
            write(BS("Das Blumenmaedchen bedauert: Es tut mir leid, aber Du hast noch \n"));
            write(BS("Das Blumenmaedchen bedauert: nicht genug Erfahrung, um mir zu helfen.\n"));
            return 1;
           }
           if (ob=present(("\nzakstitem"), this_player()))
                  write("Das Bluemenmaedchen kichert: Du hilfst mir doch "
                       +"schon.\n");    
           else
                  {
                  clone_object(OBJ "zakstitem" )->move(this_player(), M_NOCHECK);
                  write("Das Blumenmaedchen freut sich: Das ist sehr "
                       +"lieb von Dir.\n");
                  write("Das Blumenmaedchen umarmt Dich herzlich und sagt:\n");
                  write(BS("Zunaechst musst Du einen Streit mit dem Oberruepel "
                          +"anfangen und ihn dann ordentlich verpruegeln. "
                          +"Ich weiss leider nicht, wie man einen Streit anfaengt. "
                          +"Du musst mal den kleinen Ruepel fragen. Der kennt sich "
                          +"bestens damit aus. Wenn Du ihn verpruegelt hast, dann "
                          +"komme einfach wieder.\n"));
                  }
             
           return 1;
        }      
return 0;	 
}

reaktion()
{
object ob; 
if(environment(this_player())!=environment(this_object())) return;

 if (ob=present(("\nzakstitem"), this_player()))
  {
    if(ob->queryoberruepel()==1)
     {
       write(BS("Das Blumenmaedchen sagt gluecklich: Ich danke Dir, "
                +this_player()->name(WER,2)+".\n"));
       write("Das Blumenmaedchen umarmt Dich froehlich und meint dann:\n");
       write(BS("So, weil Du mir geholfen hast, verrate ich Dir ein "
               +"Geheimnis...\n"));
       if ("/obj/sehertormaster"->DiscoverDoor(ROOM "room_E-04"))
        { 
          write(BS("Das Blumenmaedchen zeigt Dir ein Sehertor, das hier "
                  +"versteckt ist.\n")); 
       
          write_file( "/d/gebirge/iwo/arwenock/log/sehertor", ctime()+": "
                  +capitalize(getuid(this_player()))
                  +" hat das Sehertor in Arwenock gefunden.\n");
          if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
               break_string(this_player()->name(WER,2)
                      +" hat gerade das Sehertor in Arwenock gefunden!", 78, 
                       "Das Blumenmaedchen teilt Dir mit: "));
        
        }
        else
        {
          write("Naja, Du kennst ja das Geheimnis hier schon, oder?\n");
        }
       ob->remove();   
       return;
     }
    else
     { 
       write(BS("Das Blumenmaedchen sagt traurig: "
               +this_player()->name(WER,2)
               +", Du hast ja den Oberruepel \n"));
       write(BS("Das Blumenmaedchen sagt traurig: noch immer nicht verpruegelt.\n"));
       return;
     }
  }      
  return;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "ruft: Du bist ein Ruepel, "+this_player()->name(WER, 2),
        "ruft: Du bist ein Ruepel, "+this_player()->name(WER, 2));
      break;
    case "aergerlich":
      call_out("react", 0, "seufzt", "seufzt");
      break;
    case "traurig":
      call_out("react", 0, "troestet Dich",
	       "troestet, "+this_player()->name(WEN, 2));
      break;
    case "albern":
      call_out("react", 0, "kichert",
	       "kichert");
      break;
    case "neutral":
      call_out("react", 0, "schaut Dich aufmerksam an", "schaut "+this_player()->name(WEN)+" aufmerksam an");
      break;
    case "intim":
      call_out("react", 0, "gibt Dir eine harte Ohrfeige",
                   "gibt "+this_player()->name(WEM)+" eine harte Ohrfeige");
      break;
    case "froh":
      call_out("react", 0, "grinst Dich an",
             "grinst "+this_player()->name(WEN)+" an");
      break;
    case "aengstlich":
      call_out("react", 0, "klopft Dir ermutigend auf die Schulter",
             "klopft "+this_player()->name(WEM)+" ermutigend auf die Schulter");
      break;
    case "frech":
      call_out("react", 0, "schaut Dich traurig an", "schaut "+this_player()->name(WEN)+" traurig an");
      break;
    case "nett":
      call_out("react", 0, "knuddelt Dich froehlich", "knuddelt "+this_player()->name(WEN));
      break;
  }
}

void react(string victim, string others)
{
  if (present(this_player(), environment(this_object()))) 
  {
    tell_object(this_player(), break_string(Name(WER, 1) + " "+victim+".", 74));
    tell_room(environment(this_object()), break_string(Name(WER, 1)+" "+others+".", 74), ({this_player(),this_object()}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
