#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

inherit STDNPC;

#define WIZNAME "andyl"

int sauer=0;

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"wache", "stadtwache", "bronawar", "waechter", "stadtwaechter", "hauptmann", "wachtel", "zwerg", "\nbronawar", "zwergenveteran", "veteran"}) );
  SetProp (P_ARTICLE, 0);
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Bronawar");
  SetProp (P_SHORT, "Bronawar, Hauptmann der Stadtwache");
  SetProp (P_LONG, "Bronawar ist ein staemmiger Zwergenveteran der bereits "
	   +"als Schlachtenwueter unzaehlige Kaempfe bestritten hat. Hier "
	   +"in Arwenock bekleidet er den Rang eines Hauptmanns und ist "
	   +"hauptverantwortlich fuer die Sicherheit der Stadt. Er hat eine "
	   +"lange Narbe ueber die rechte Gesichtshaelfte und traegt eine "
	   +"metallene schwarze Augenklappe ueber dem rechten Auge. Sein "
	   +"Arme strotzen vor Muskeln und er hat eine immerzu argwoehnische "
	   +"Miene aufgesetzt. Sein langer schwarzer Bart wirkt sehr gepflegt "
	   +"und sein Haupthaar hat er zu zwei Zoepfen geflochten.\n");
  SetProp (P_ALIGN, 100);
  create_default_npc(36);
  SetProp (P_SIZE, 125);
  SetProp (P_RACE, "Zwerg");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit blossen Haenden", 400, DT_BLUDGEON}) );
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );
  set_living_name("bronawar");
 
  SetProp (P_MURDER_MSG,
	   "ARGH, das werd ich Dir heimzahlen, %s!");
  SetProp (P_KILL_MSG, 
	   "HARHAR, leg Dich nie mit einem ehemaligen Schlaechtenwueter an.\n");

  CLONEME("/p/armour/trousers/kettenhose");
  CLONEME("/p/armour/boots/lederstiefel");
  CLONEME(ARMOUR"arwenockpanzer");
  CLONEME(ARMOUR"hoernerhelm");
  CLONEME(ARMOUR"augenklappe");
  CLONEME("p/armour/belt/guertel.lpc");
  command ("trage alles");
  CLONEME(WEAPON"orkenspalter");
  command ("zuecke orkenspalter");

  SetChats(2, ({
    "Bronawar brummt etwas Unverstaendliches in seinen Bart.\n",
      "Bronawar brummt etwas von gutem Bier in Felonia.\n",
      "Bronawar schaerft seinen Orkenspalter.\n",
      "Bronawar rueckt seine Augenklappe zurecht.\n",
      "Bronawar mustert Dich argwoehnisch von oben bis unten.\n",
      }) );
  
  SetProp(P_SPELLRATE,16);

  AddSpell(10,250, 
	   "Bronawar tritt Dir hart gegen das Schienbein.\n",
	   "Bronawar tritt @WEN hart gegen das Schienbein..\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(8,300, 
	   "Bronawar hackt wuetend auf Dich ein.\n",
	   "Bronawar hackt wuetend auf @WEN ein.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(4,350, 
	   "Bronawar setzt zu einem heftigen Schlag mit seiner Axt an.\n",
	   "Bronawar setzt zu einem heftigen Schlag mit seiner Axt an.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(3,400, 
	   "Bronawar laesst wutentbrannt seine Axt nach vorne sausen.\n",
	   "Bronawar laesst wutentbrannt seine Axt nach vorne sausen.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(2,500, 
	   "Bronawar senkt seinen Kopf und rammt Dir seinen Helm in die Brust.\n",
	   "Bronawar senkt seinen Kopf und rammt @WEM seinen Helm in die Brust.\n",
	   DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(1,600, 
	   "Bronawar laesst mit extremster Wildheit den Orkenspalter auf Dich herabsausen.\n",
	   "Bronawar laesst mit extremster Wildheit den Orkenspalter auf @WEN herabsausen.\n",
	   DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(6, ({
    "Bronawar ruft: Das war ein grosser Fehler von Dir!\n",
      "Bronawar ruft: Stirb Du elendes Stueck Dreck!\n",
      "Bronawar stoesst Dir seinen Ellenbogen in die Rippen.\n",
      "Bronawar schreit: Ich werde Dich wie einen Wurm zerquetschen!\n", 
      "Bronawar stiert Dich boese an.\n"}) );
  
  SetProp (P_DIE_MSG, " schreit noch einmal *RACHE!* und stirbt mit einem Fluch auf den Lippen.\n");
  SetProp (P_DEFAULT_INFO, "brummelt etwas Unverstaendliches in seinen Bart.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
			  "Bronawar brummt: \"Das kann ich nicht gebrauchen.\"\n" }) );

   AddInfo(({"schlachtenwueter"}),
	  "Das sind furchtlose, brutale, erbarmungslose Zwergenkrieger.\n", "brummt: ");
   AddInfo(({"zwergenkrieger", "krieger"}),
	   "Die besten Zwergenkrieger sind die Schlachtenwueter. "
	   +"Ich war einst so einer.\n", "brummt: ");
   AddInfo(("orkenspalter"),
	   "Mit meinem Orkenspalter besiege ich jeden Gegner.\n", "brummt: ");
   AddInfo(("gegner"),
	   "Meine zukuenftigen Gegner tun mir jetzt schon leid.\n", "brummt: ");
   AddInfo(({"helm", "hoernerhelm"}),
	   "Der Hoernerhelm stammt noch aus meiner Zeit als Schlachtenwueter.\n", "brummt: ");
   AddInfo(("hauptmann"),
	   "Ich bin der Hauptmann der Stadtwache.\n", "brummt: ");
   AddInfo(({"stadtwache", "wache"}),
	   "Die Stadtwache beschuetzt die Stadt.\n", "brummt: ");
   AddInfo(({"stadt", "arwenock"}),
	   "Arwenock ist eine sehr schoene Stadt.\n", "brummt: ");
   AddInfo(({"augenklappe", "klappe"}),
	   "Die Augenklappe trage ich seit einer Begegnung mit einem "
	   +"Unterweltdaemon.\n", "brummt: ");
   AddInfo(({"begegnung", "unterweltdaemon", "daemon"}),
	   "Der Daemon hat die Begegnung mit mir nicht ueberlebt.\n", "brummt boese grinsend: ");
   AddInfo(("narbe"),
	   "Das ist nur ein Kratzer.\n", "brummt: ");   
   AddInfo(("andyl"),
	   "Das ist sicher dieser ueble Stoerenfried der andauernd Krach macht.\n", "brummt: ");
   AddInfo(({"protheg", "iwo", "zaknafein", "querolin", "creative", "angrox"}),
	   "Das ist sicher so ein Magierseicherl.\n", "brummt: ");
   AddInfo(({"magier", "seicherl", "magierseicherl"}),
	   "Die sorgen immer nur fuer Aerger.\n", "brummt");
   AddInfo(({"tor", "stadttor", "haupttor"}),
	   "Ich und Turanis bewachen das Haupttor von Arwenock.\n", "brummt: ");
   AddInfo(({"turanis", "partner"}),
	   "Turanis ist mein elfischer Partner.\n", "brummt: ");
   AddInfo(("arwenockpanzer"),
	   "Ein ziemlich guter Panzer.\n", "brummt: ");
   AddInfo(("bronawar"),
	   "Bronawar ist mein Name.\n", "brummt: ");
   AddInfo(("bier"),
	   "Das beste Bier gibt es in Felonia.\n", "brummt: ");
   AddInfo(("felonia"),
	   "Dort gibt es mit Abstand das beste Bier.\n", "brummt: ");
}

init()
{
  ::init();
  if (TP && TP->id("turanis")) AddDefender(TP);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
    {
    case "fies":
      call_out("react", 0, "sieht Dich finster an",
	       "sieht "+TP->name(WEN)+" finster an an");	
      break;
    case "aergerlich":
      call_out("react", 0, "wird ploetzlich wutrot", "wird ploetzlich wutrot");
      break;
    case "frech":
      call_out("react", 0, "stiert Dich boese an", "stiert "+TP->name(WEN)+" an");
      break;
    default :
      call_out("react", 0, "sieht Dich schief an", "sieht "+TP->name(WEN)+" schief an");
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  object ob;

  if(QueryProp(P_HP) < 200 && objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, enemy))) {
    ob->BronawarKilled(TO);
    return 0;
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}