/*        
**                         Oberruepel
**
**    (Er muss verpruegelt werden, wenn man das Sehertor bekommen will.        
**     Wie man das anstellt, erfaehrt man vom kleinen Ruepel.)   
**    
**                   Zaknafein, Februar 2000
*/

#include "../def.h"
inherit STDNPC;
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#define WIZNAME "zaknafein"

int angestarrt=0;

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Der Oberruepel");
  SetProp(P_LONG, "Das ist er also, der Oberruepel, der kleine Maedchen "
                 +"verhaut und das ganze Stadtviertel terrorisiert. Er "
                 +"wirkt aufgrund seiner Groesse und seiner maechtigen "
                 +"Faeuste recht bedrohlich. Ob es eine gute Idee ist, "
                 +"mit ihm einen Streit anzufangen?");
  SetProp(P_NAME, "Oberruepel");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Mensch");
  create_default_npc(35);
  SetProp(P_ALIGN, -600); 
  SetProp(P_SIZE, 209);  
  SetProp(P_BODY, 300);
  SetProp(P_HANDS, ({" mit seinen gewaltigen Faeusten", 400, DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.2,
      DT_HOLY:      0.0, DT_UNHOLY:    -0.2, DT_MAGIC:  0.3 ]) );
  SetProp(P_WIMPY, 0);
  AddId( ({ "NOWIMPY" , "ruepel" , "oberruepel" }) );

  AddCmd( ({ "starre" , "starr" }), "starren");
  AddCmd( ({ "antworte" , "antwort" }), "antworten");

  seteuid(getuid(this_object()));

  clone_object(ARMOUR "zkampfhose" )->move(this_object());
  clone_object(ARMOUR "zachselhemd" )->move(this_object());
  clone_object("/p/armour/boots/lederstiefel" )->move(this_object());

  command("ziehe alles an");


  SetProp(P_NOMAGIC, 30);

  AddSpell(1,500, 
	   "Der Ruepel rammt Dich.\n",
	   "Der Ruepel rammt @WEN.\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,600,
	   "Der Ruepel schlaegt Dir seine Faust ins Gesicht.\n",
	   "Der Ruepelschlaegt @WEM die Faust ins Gesicht.\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
  "Der Oberruepel ext eine Flasche Bier.\n",
  "Der Oberruepel ruepelt wild herum.\n",
  "Ein wirklich ekelhafter Geruch geht vom Ruepel aus.\n",
  }) );

  SetProp( P_DIE_MSG, 
      " ruepelt noch ein letztes mal.\n" );
 
  SetProp(P_DEFAULT_INFO, ({ "fragt: Willst Du einen Streit anfangen, haeh?\n",
                             "sagt: Ich kann Dich nicht ab!",
                             "grummelt: Du nervst gewaltig!" }) );

 
  AddInfo("zaknafein",
  "Zaknafein is auch nur son doofer Mag.\n","sagt laessig: ");
  AddInfo("streit",
  "Suchst Du Streit, haeh? Pass' bloss auf!\n","stubst Dich und sagt: ");
   AddInfo("arwenock",
  "Hehe, ich hab hier alles im Griff!\n","gibt an: ");
   AddInfo( ({ "maedchen" , "blumenmaedchen" }) ,
  "Das Maedchen ist so frech. Ich musste ihr heute erstmal ein blaues "
 +"Auge verpassen.\n","laestert: ");
   AddInfo("ruepel",
  "Wir Ruepel sorgen hier fuer Ruhe und Ordnung. Auf unsere Weise... "
 +"Muahaha!\n","prahlt: ");
  

  AddDetail( ({ "faust" , "faeuste"  }) ,
    "Die Faeuste sind echt riesig. Wenn die in Deinem Gesicht landen...\n" );
  AddDetail( "groesse"  ,
    "Mit einem Massband koenntest Du genau feststellen, wie gross er ist.\n" );
  AddDetail( "gesicht"  ,
    "In dieses Gesicht moechtest Du am liebsten reinschlagen.\n" );
}

starren( str )
{
notify_fail( "Wen moechtest Du anstarren?\n" );
if( str == "oberruepel an" || str == "ruepel an"  )
	{
           object ob;
           object obj;
           if (obj=present(("\nzakauge"), this_player()))
               {
                 write(BS("Der Ruepel sagt: Du hast schon ein blaues Auge. "
                         +"Was willst Du mehr? Hehe!\n"));
                 return 1;
               }
           if (ob=present(("\nzakstitem"), this_player()))
              {
               write(BS("Der Oberruepel schaut Dich wuetend an und grummelt:\n"));
               write(BS("Schau' mich nicht so bloede an, Freundchen!\n"));  
               angestarrt=1;  
               return 1;
              }
         write(BS("Der Oberruepel beachtet Dich gar nicht.\n")); 
         return 1;
        }      
return 0;	 
}

antworten( str )
{
notify_fail( "Was moechtest Du antworten?\n" );
 if (!str || (strstr(str, "freund")==-1 || strstr(str,
 "penner")== -1)) return 0;
  else
	{
           object ob;
           if (ob=present(("\nzakstitem"), this_player()))
              {
               if(angestarrt==1)
                 {
                   this_player()->Set(P_PARALYZED ,([
                     PARALYZE_TIME:1,PARALYZE_MSG:"Nein, Du pruegelst Dich gerade.\n",
                     PARALYZE_MSG_OTHER:"",PARALYZE_END:"",PARALYZE_END_OTHER:""]) );
                   write(BS("Mit rasender Wut kommt der Oberruepel auf "
                           +"Dich zu, packt Dich am Kragen und "
                           +"schlaegt Dir mit seiner gewaltigen Faust "
                           +"direkt aufs Auge.\n"));
                   write("\n");
                   clone_object(OBJ "zauge" )->move(this_player(), M_NOCHECK); 
                   angestarrt=0;
                   ob->setoberruepel();
                   say(this_player()->name(WER,2)+" faengt ein wilde Schlaegerei "
                                                 +"mit dem Oberruepel an.\n" , this_player());
                   call_out(("seq1"),7);
                   return 1;
                 }
                 else
                 {
                   write("Der Oberruepel schaut Dich nur fragend an.\n");
                   return 1;
                 }
              }
           else
              {
               write(BS("Der Oberruepel beachtet Dich gar nicht.\n")); 
               return 1;
              }

        }      
return 0;	 
}

void seq1()
{
  write(BS("Du fliegst quer durch den Raum, bis eine Wand Deinen Flug auf "
           +"unsanfte Weise stoppt. Du siehst lauter lustige Sternchen.\n"));
  write("\n");
  call_out(("seq2"), 6);
}

void seq2()
{
  write(BS("Langsam rappelst Du Dich auf. Du knurrst. Du krempelst Deine "
           +"Aermel hoch und stuerzt Dich auf den Ruepel.\n"));
  write("\n");
  call_out(("seq3"), 6);
}

void seq3()
{
  write(BS("Eine wilde Schlaegerei faengt an. Nach einiger Zeit keucht "
           +"der Ruepel:\n"));
  write(BS("Okay, Du hast gewonnen.\n"));
  write(BS("Du bruellst: Wenn Du nochmal das Maedchen anfaesst, komme ich wieder!\n\n"));
  write(BS("Jetzt solltest Du aber schnell gehen, bevor der Ruepel wieder fit "
          +"wird."));
  this_player()->Set(P_PARALYZED, 0);
}
