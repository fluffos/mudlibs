/*
//
//  Gorwan der Haendler
//  Iwo@SL
//
*/

#define WIZNAME "iwo"

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <npc.h>

inherit STDNPC;

//#include "./master.h"


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Gorwan der Haendler");
  SetProp(P_LONG,
    "Gorwan ist ein staemmiger Mann mittleren Alters. Du solltest Dich "
    "wohl besser nicht anlegen mit ihm, da Du ganz leicht den Kuerzeren "
    "ziehen koenntest.");
  SetProp(P_NAME, "Gorwan");
  SetProp(P_GENDER, MALE);


  create_default_npc(20);


  AddId( ({ "gorwan", "haendler", "mensch", "mann" }));


  SetProp(P_HANDS, ({" mit seinen rauhen Haenden",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 195);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Gorwan sagt: Willst Du mir das Verkaufen?\n" }) );


  AddDetail( ({ "alter", "alters" }),
    "Er wird wohl um die 40 sein.");
    
  AddDetail( ({"kuerzerer", "kuerzeren"}),
    "Den hast wohl Du ;-)");

}
