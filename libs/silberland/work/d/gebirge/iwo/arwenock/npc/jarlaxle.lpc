/*
//
//  Jarlaxle der Dieb
//  Iwo@SL
//
*/

#define WIZNAME "iwo"

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <mnpc.h>
#include "/gilden/waldlaeufer/ranger_tasks.h"

inherit STDMNPC;


void create() {

  object ob;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Jarlaxle der Dieb");
  SetProp(P_LONG,
    "Diese Gestalt gehoert zu den uebelsten Typen in dieser Stadt."
    "Kaum siehst Du Dich nicht vor, klaut er Dir das Geld aus der "
    "Tasche. Du solltest ihm wohl aus dem Weg gehen.");
  SetProp(P_NAME, "Jarlaxle");
  SetProp(P_GENDER, MALE);


  create_default_npc(20);


  AddId( ({ "jarlaxle", "dieb", "delf", "elf", "dunkelelf" }));


  SetProp(P_HANDS, ({" mit seinen rauhen Haenden",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 195);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Jarlaxle sagt: Verschwinde!\n" }) );


  TO->move(ROOM "room_E-05", M_NOCHECK);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room_E-05");
  SetProp(P_MNPC_AREA, ROOM);
  SetProp(P_MNPC_WAIT, ({ 5, 5, 5 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_SPECIAL);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht weiter");

  clone_object("/p/weapon/sword/langschwert")->move(ME, M_NOCHECK);
  command_me("zuecke schwert");
  
  clone_object("/d/ebene/obj/ruestung/schw_umhang")->move(ME, M_NOCHECK);
  clone_object(ARMOUR "stiefel")->move(ME, M_NOCHECK);
  clone_object(ARMOUR "hose")->move(ME, M_NOCHECK);
  
  command_me("trage alles");

}

public void detect_ranger(object ob) {
  ob->JarlaxleDetected();
}


void init()
{

  object player;
  object boerse;
  object geld, ob;

  if(objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, TP))) {
    call_out("detect_ranger", 0, ob);
  }


  if (!player=find_player(getuid(PO)))
    {
      ::init();
      return;
    }      
 
  if (random(20) == 3)
    {
      tell_object(player, TO->Name(WER) + " rempelt Dich unsanft.\n");
      tell_room(ENV(player), TO->Name(WER) + " rempelt " +
                player->Name(WEN) + " unsanft.\n", ({ player }));

      //TO->AddMoney(+ player->QueryMoney());
      //player->AddMoney(- player->QueryMoney());
 
      if (geld=present("muenzen", player))
        geld->move(TO, M_NOCHECK);

    }


  ::init();

}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  object ob;

  if(QueryProp(P_HP) < 200 && objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, enemy))) {
    ob->JarlaxleKilled(TO);
    return 0;
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}
