#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit STDNPC;

#define WIZNAME "andyl"

create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ( ({"wache", "stadtwache", "turanis", "waechter", "stadtwaechter", "wachtel", "elf", "Schwertexperte"}));
  SetProp (P_ARTICLE, 0);
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Turanis");
  SetProp (P_SHORT, "Turanis, der Stadtwaechter");
  SetProp (P_LONG, "Turanis ist ein hochgewachsener Elf, der ein "
	   +"langjaehriger Angehoeriger der Stadtwache von Arwenock ist. Er "
	   +"hat langes schwarzes Haar, welches er zu einem Pferdeschwanz "
	   +"zusammengebunden hat. Fuer einen Elf hat er auch ueberaus starke "
	   +"Muskeln und grosse aufmerksame Augen. Man sieht ihm auch an, dass "
	   +"er ein erfahrener Kaempfer ist. Er sieht ansonsten eigentlich sehr "
	   +"freundlich aus.\n");
  SetProp (P_ALIGN, 400);
  create_default_npc(28);
  SetProp (P_SIZE, 210);
  SetProp (P_RACE, "Elf");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit blossen Haenden", 280, DT_BLUDGEON}) );
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );
  set_living_name("turanis");
  SetProp (P_MURDER_MSG,
	   "Oh nein, %s war zu stark fuer mich.");
  SetProp (P_KILL_MSG, 
	   "Keiner attackiert ungestraft die Stadtwache von Arwenock!\n");
  CLONEME("/p/armour/shield/eisenschild");
  CLONEME("/p/armour/boots/lederstiefel");
  CLONEME("/p/armour/gloves/lederhandschuhe");
  CLONEME("/p/armour/helm/lederhelm");
  CLONEME("/p/armour/cloak/umhang");
  CLONEME(ARMOUR"arwenockpanzer");
  command ("trage alles");
  CLONEME("/p/weapon/sword/langschwert");
  command ("zuecke langschwert");

   SetChats(2, ({
     "Turanis mustert Dich aufmerksam.\n",
       "Turanis versucht Bronawar etwas aufzuheitern.\n",
       "Turanis meint: Arwenock ist doch eine schoene Stadt.\n",
       "Turanis meint: Stoerenfriede werden in Arwenock nicht geduldet.\n",
       "Turanis rueckt seinen Umhang zurecht.\n",
      }) );

  SetProp(P_SPELLRATE,20);

  AddSpell(8,200, 
	   "Turanis laesst sein Schwert auf Dich herunterfahren.\n",
	   "Turanis laesst sein Schwert auf @WEN herunterfahren.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(7,250, 
	   "Turanis attackiert Dich mit einem gekonnten Querhieb.\n",
	   "Turanis attackiert @WEN mit einem gekonnten Querhieb.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(3,300, 
	   "Turanis wirbelt wild mit seinem Schwert auf Dich zu.\n",
	   "Turanis wirbelt wild mit seinem Schwert auf @WEN zu.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(1,400, 
	   "Turanis greift Dich mit einem gefaehrlichen Dreifachschlag an.\n",
	   "Turanis greift @WEN mit einem gefaehrlichen Dreifachschkag an.\n",
	   DT_SLASH, ([SP_SHOW_DAMAGE:1]) );  

  SetAttackChats(6, ({
    "Turanis meint: Das war wohl ein schwerer Fehler mein Freund!\n",
      "Turanis verflucht Dich.\n",
      "Turanis deutet eine Finte an.\n",
      "Turanis wechselt seine Kampfposition.\n",
      "Turanis ueberrascht Dich mit einer Attacke.\n",
      "Turanis nimmt eine Verteidigungsposition ein.\n"}) );

  SetProp (P_DIE_MSG, " erhebt sein Schwert noch einmal und bricht zusammen.\n");
  SetProp (P_DEFAULT_INFO, "meint: Davon weiss ich nichts.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
			  "Turanis meint: \"Das brauchst Du sicher mehr als ich.\"\n" }) );

  AddInfo(({"schlachtenwueter", "orkenspalter", "augenklappe"}),
	   "Darueber fragst Du am besten Bronawar.\n", "meint: ");
  AddInfo(("hauptmann"),
	  "Bronawar ist der Hauptmann der Stadtwache.\n", "sagt: ");
  AddInfo(({"stadtwache", "wache"}),
	  "Die Stadtwache beschuetzt die Stadt.\n", "sagt: ");
  AddInfo(({"stadt", "arwenock"}),
	  "Arwenock ist eine sehr schoene Stadt.\n", "meint: ");
  AddInfo(("andyl"),
	  "Ein uebler Stoerenfried, der nur andauernd Krach macht. Sei froh "
	  +"wenn Du dem nicht begegnest.\n", "meint: ");
  AddInfo(({"protheg", "iwo", "zaknafein", "querolin", "creative", "angrox"}),
	  "Das ist sicher so ein Magierseicherl.\n", "meint: ");
  AddInfo(({"magier", "seicherl", "magierseicherl"}),
	  "Die sorgen immer nur fuer Aerger.\n", "meint: ");
  AddInfo(({"tor", "stadttor", "haupttor"}),
	  "Ich und Hauptmann Bronawar bewachen das Haupttor von Arwenock.\n", "meint: ");
  AddInfo(({"bronawar", "partner"}),
	  "Bronawar ist mein zwergischer Partner und gleichzeitig Hauptmann "
	  +"der Stadtwache.\n", "sagt: ");
  AddInfo(("arwenockpanzer"),
	  "Ein ungewoehnlich guter Panzer. Es gibt ihn nur in Arwemock.\n", "meint: ");
  AddInfo(("turanis"),
	  "Turanis ist mein Name.\n", "sagt: ");
  AddInfo(("stoerenfriede"),
	  "Stoerenfriede dulden wir in Arwenock nicht.\n", "meint: ");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
    {
    case "fies":
      call_out("react", 0, "sieht Dich veraergert an",
	       "sieht "+TP->name(WEN)+" veraergert an");
      break;
    case "aergerlich":
      call_out("react", 0, "verzieht zornig seinen Mund", "verzieht zornig seinen Mund");
      break;
    case "frech":
      call_out("react", 0, "gibt Dir einen Klaps auf den Hinterkopf", "gibt "+TP->name(WEM)+" einen "
	       +"Klaps auf den Hinterkopf");
      break;
    default :
      call_out("react", 0, "versucht Dich zu ignorieren", "versucht "+TP->name(WEN)+" zu ignorieren");
    }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
    {
      tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void InformDefend(object enemy)
{
  Kill(enemy);
}

init()
{
  ::init();
  if (TP && TP->id("bronawar")) AddDefender(TP);
}

