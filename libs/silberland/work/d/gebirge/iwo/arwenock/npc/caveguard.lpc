
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

void create() {
  object ob;
  object def;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein riesiger Stadtwaechter");
  SetProp(P_LONG,
    "Die Wache ist ein Riesiger gut trainierter Troll. Sie passt auf, dass "
    "keiner was stiehlt hier. Du solltest Dich wohl besser nicht anlegen "
    "mit ihr.");
  SetProp(P_NAME, "Stadtwaechter");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "riesig");
  AddId(({"\ncaveguard", "waechter", "stadtwaechter", "troll", "NOWIMPY"}));

  create_default_npc(27);
  SetProp(P_HANDS, ({" mit seinen starken Haenden",
    QueryProp(P_HANDS)[1]+300,DT_BLUDGEON}));
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 340+random(40));
  SetProp(P_ALIGN, 000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:      -0.7, DT_WATER:  -0.7, DT_AIR:    -0.7, 
      DT_LIGHTNING: -0.8, DT_EXPLOSION:  0.1, DT_SOUND:  -0.8, DT_LIGHT:  -0.7,
      DT_ELECTRIC:  -0.7, DT_ACID:      -0.8, DT_POISON: -0.7, DT_TERROR: -0.7,
      DT_HOLY:      -0.9, DT_UNHOLY:    -0.9, DT_MAGIC:  -0.9, ]) );
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "kommt an und beginnt seinen Dienst");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG,  " faellt laut krachend zu Boden.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Stadtwaechter will @WEN nicht.\n" }) );

  SetProp(P_SPELLRATE,90);
  
  AddSpell(3,200,
    "Der riesige Stadtwaechter haut mit voller Wucht zu.\n",
    "Der riesige Stadtwaechter haut mit voller Wucht auf @WEN.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    "Der riesige Stadtwaechter trifft Dich mit dem Beil am Kopf.\n",
    "Der riesige Stadtwaechter trifft @WEN mit dem Beil am Kopf.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1000,
    "Der riesige Stadtwaechter versucht Dich zu spalten.\n",
    "Der riesige Stadtwaechter versucht @WEN zu spalten.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  if(random(2) >= 1)
  AddDefaultSpell(1,200,DS_PARALYZE,
    "Du bist benommen von der Wucht der Schlaege.\n",
    "@WER ist benommen von der Wucht der Schlaege.\n");



  SUID;
  // CLONEME( "/p/weapon/streitaxt" );
  ob=clone_object( "/p/weapon/axe/kriegsbeil.lpc" );
  if(ob) {
    ob->SetProp(P_WC_BONUS, ([ "\ncaveguard": 100 ]) );
    ob->move(ME,M_NOCHECK);
  }
  command("zuecke beil");
  CLONEME( "/d/gebirge/speedy/trollager/armour/schwtrollruestung" );
  CLONEME( "/p/armour/helm/lederhelm" );
  command("trage alles");

  ME->move(CAVEPATH+"/room/connect02", M_NOCHECK);
  
  if (!present("\ncavemasterguard", ENV(ME)))
    {
      ob = clone_object(APATH+"/obj/arkenskey");
      ob->move(ME, M_NOCHECK);
      AddId("\ncavemasterguard");
    }

}


void InformDefend(object enemy)
{
  Kill(enemy);
}


int _query_wimpy() { return 0; }

void init()
{
  ::init();
  if(PO && PO->id("\ncaveguard")) AddDefender(TP);
}
