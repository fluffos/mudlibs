/*        
**                            Ruepel
**
**    
**                   Zaknafein, Maerz 2000
*/

#include "../def.h"
inherit STDNPC;
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>

#define WIZNAME "zaknafein"

#define ART ({ "betrunkener","stinkender","prolliger","aggressiver" })
int i;

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  i=random(sizeof(ART));
  SetProp( P_LOG_FILE, "report/" WIZNAME ".rep" );
  SetProp(P_SHORT, "Ein "+ART[i]+" Ruepel");
  SetProp(P_LONG, "Der "+ART[i][0..<2]+" Ruepel gehoert zweifellos einer asozialen "
                 +"Randgruppe an. Den ganzen Tag lungert er hier herum, saeuft und "
                 +"poebelt jeden an, der hier vorbeikommt. Er ist wirklich ein sehr "
                 +"unangenehmer Zeitgenosse. Deine Faust moechte unbedingt in sein "
                 +"Gesicht.");
  SetProp(P_NAME, "Ruepel");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Mensch");
  create_default_npc(20+2*i);
  SetProp(P_ALIGN, -100-random(100)); 
  SetProp(P_SIZE, 170+i*random(10)); 
  SetProp(P_AGGRESSIVE, 0.0 + 0.05*i); 
  SetProp(P_HANDS, ({" mit seinen Faeusten", 250+100*i, DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.2,
      DT_HOLY:      -0.2, DT_UNHOLY:    0.0, DT_MAGIC:  0.3 ]) );
  SetProp(P_WIMPY, 0);
  AddId( ({ "ruepel" , "\nzruepel" }) );
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Ruepel sagt grinsend: Hehe, das behalt' ich mal.\n" }) );

  seteuid(getuid(this_object()));

  clone_object("/p/armour/boots/lederstiefel" )->move(this_object());
  clone_object("/p/armour/trousers/lederhose" )->move(this_object());
  clone_object("/p/armour/armour/hemd" )->move(this_object());
  if (random(5)<3) clone_object("/p/armour/gloves/lederhandschuhe")->move(this_object());
  if (random(5)<3) clone_object("/p/armour/cloak/umhang")->move(this_object());

  command("ziehe alles an");


  SetProp(P_SPELLRATE, 40);
  SetProp(P_NOMAGIC, 20);

  AddSpell(1,300+100*i, 
	   "Der "+ART[i][0..<2]+" Ruepel rammt Dich.\n",
	   "Der "+ART[i][0..<2]+" Ruepel rammt @WEN.\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200+150*i,
	   "Der "+ART[i][0..<2]+" Ruepel schlaegt Dir seine Faust ins Gesicht.\n",
	   "Der "+ART[i][0..<2]+" Ruepel schlaegt @WEM die Faust ins Gesicht.\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der "+ART[i][0..<2]+" Ruepel laestert ueber Dich.\n",
    "Der "+ART[i][0..<2]+" Ruepel ruelpst Dich an.\n",
    "Der "+ART[i][0..<2]+" Ruepel poebelt herum.\n" }));
    

  SetProp( P_DIE_MSG, 
      " ruepelt noch ein letztes mal.\n" );
 
  SetProp(P_DEFAULT_INFO, ({ "fragt: Willst was auf die Fresse? Haeh?\n",
                             "sagt: Du stinkst!",
                             "sagt: Bloede Sau, verpiss' Dich bloss!" }) );

 
  AddInfo("zaknafein",
  "Zaknafein is auch nur son doofer Mag.\n","sagt laessig: ");
  AddInfo("oberruepel",
  "Der wohnt hier irgendwo... ","erklaert: ");
   AddInfo("arwenock",
  "Hehe, wir haben hier alles im Griff!\n","gibt an: ");
   AddInfo( ({ "maedchen" , "blumenmaedchen" }) ,
  "Das Blumenmaedchen ist doch ne Schlampe!\n","laestert: ");
   AddInfo("ruepel",
  "Wir Ruepel sorgen hier fuer Ruhe und Ordnung. Auf unsere Weise... "
 +"Muahaha!\n","prahlt: ");
  

  AddDetail( ({ "gruppe" , "randgruppe"  }) ,
    "Naja, asozial halt...\n" );
  AddDetail( "faust"  ,
    "Hm, damit kann er Dir sehr wehtun.\n" );

  // XP setzen mit 500 bonus weils so boese kerle sind ;-) --iwo
  SetProp(P_XP, QueryProp(P_MAX_HP)*QueryProp(P_HANDS)[1]*5 + 500);


}
/*
varargs mixed _query_aggressive(mixed arg)
{
  object pl;

  if (!objectp((pl = this_player())) || !interactive(pl)) return 0;

  if (!IS_SEER(pl)) return 0;

  return 0.0 + 0.05*i;
}
*/

void Attack (object enemy)
{
  if (!IsEnemy(enemy) && interactive(enemy) && !IS_SEER(enemy))
    return;

  ::Attack(enemy);
}
