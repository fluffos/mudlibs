/*        
**      Quax, Wirt des Gasthofes in Arwenock (harter Gegner: level 45, fiese Spells!)
**
**             
**        
**      Zaknafein, Mai 2001
*/

#include "../def.h"

// inherit STDNPC;

inherit "std/npc";

inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>

#define WIZNAME "zaknafein"
#define BS(x) break_string(x, 78)

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Quax, der Wirt");
  SetProp(P_LONG,
      "Quax ist ein kleiner, staemmiger Zwerg. Er ist der Wirt dieses Gasthofes. "
      "Seine rote Nase verraet Dir, dass er sich gerne bei der Arbeit "
      "ein Glaeschen Wein genehmigt. Er soll ein grosser Weinkenner sein " 
      "und ueber einen gut sortierten Weinkeller verfuegen. Er nimmt seine Arbeit " 
      "aber sehr ernst. Fleissig putzt er die Theke und bedient freundlich seine "
      "Kundschaft.");
  SetProp(P_NAME, "Quax");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

  SetProp(P_RACE, "Zwerg");
  create_default_npc(30);
  SetProp(P_ALIGN, random(450)); 
  SetProp(P_SIZE, 129);  
  SetProp(P_HANDS, 
      ({" mit einer zerbrochenen Flasche", QueryProp(P_HANDS)[1], DT_PIERCE}) );
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_WATER:   0.3, DT_EXPLOSION: 0.1, 
      DT_POISON:    -0.4, DT_TERROR: -0.2, DT_MAGIC:  0.2 ]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT, ({REJECT_KEEP, "Der Wirt sagt: Danke, cooles Trinkgeld!\n"}));
  AddId( ({ "NOWIMPY" , "\nzwirt" , "quax" , "wirt" , "zwerg"  }) );

  seteuid(getuid(this_object()));
  clone_object("/p/armour/cloak/schuerze")->move(this_object());
  clone_object("/p/armour/trousers/hose")->move(this_object());
  clone_object("/p/armour/armour/hemd")->move(this_object());
  if (random(5)<2) clone_object("/p/armour/helm/mithrilhelm")->move(this_object());
  command("ziehe alles an");

  SetProp(P_SPELLRATE,50);
  SetProp(P_NOMAGIC, 25);

  AddSpell(1,700, 
	   "Quax rammt Dir seinen Kopf in den Magen.\n",
	   "Quax rammt @WEM seinen Kopf in den Magen.\n",
           DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,800,
	   "Quax zertruemmert eine Flasche auf Deinem Kopf.\n",
	   "Quax zertruemmert @WEM mit einer Flasche den Schaedel.\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,"","",DT_TERROR,"heilenspell");  // natuerlich heilt er sich selbst 
  AddSpell(1,1,"","",DT_AIR,"sattspell");     // jo, tanken ist dann wohl erstmal nicht...  

  SetChats(1, ({
        "Quax putzt die Theke.\n",
        "Ein Mann bestellt einen Kartoffelauflauf.\n",
        "Quax geht kurz in die Kueche und kommt dann mit einem Auflauf zurueck.\n",
        "Quax fragt Dich: Was darf ich Dir bringen?\n"
        }) );

  SetProp( P_DIE_MSG, 
      " schaut unglaeubig auf seine Wunden und stirbt kopfschuettelnd.\n" );
 
  SetProp(P_DEFAULT_INFO, ({ "fragt: Willst Du nicht was trinken?\n",
                             "fragt: Wie gefaellt Dir meine Tochter?",
                             "stoehnt: Du kannst Fragen stellen..." }) );

  AddInfo( "zaknafein" ,
      "Zaknafein ist mein bester Kunde.\n","sagt stolz: ");
  AddInfo( ({ "gasthof" , "hof" }) ,
      "Dieser Gasthof ist mein ganzer Stolz. Gefaellt es Dir hier?\n","sagt: ");
  AddInfo( "kneipe"  ,
      "erklaert: Gehe einfach nach Sueden. Dort findest Du sie.\n" );
  AddInfo( ({ "tochter" , "taenzerin" }) ,
      "Ja, das ist meine Tochter. Sie ist mein ganzer Stolz.\n","sagt stolz: ");
  AddInfo( ({ "wein" , "weine" }) ,
      "Ich besitze einen grossen Weinkeller. Ich habe sogar sehr seltene Weine "
      "aus Derlim.\n","sagt: ");
  AddInfo( ({ "keller" , "weinkeller" }) ,
      "Nur ich darf den betreten.\n","sagt: ");
  AddInfo( ({ "derlim" , "weinberg" }) ,
      "Die Hobbits stellen hervorragende Weine her. Wenn Du mich darum "
      "bittest, hole ich mal eine Flasche hoch.\n","sagt froehlich: ");
  AddInfo("kasse"  ,
      "Lass' ja die Finger von meiner Kasse!\n","warnt Dich: ");

  AddCmd( "bitte", "bitten");

}
void heilenspell(object enemy, int damage, mixed dam_type) 
{
  say("Quax trinkt mal eben einen Kurzen und sieht danach gestaerkt aus.\n"); 
  heal_self(10+random(100));
}

void sattspell(object enemy, int damage, mixed dam_type) 
{

  tell_object(enemy,
      "Quax stopft Dir Sand in den Mund. Du bekommst kaum noch Luft.\n");
  tell_room(environment(enemy), 
      "Quax stopft "+capitalize(enemy->Name())+" Sand in den Mund.\n", ({ enemy }));
  enemy->SetProp(P_FOOD, enemy->QueryProp(P_MAX_FOOD)); 
  enemy->SetProp(P_DRINK, enemy->QueryProp(P_MAX_DRINK)); 
}

int bitten( string str )
{
  notify_fail( "Wen moechtest Du um was bitten?\n" );
  if( str == "quax um wein" || str == "um wein" || str == "wirt um wein")
  {
    object ob;

    if (ob=present(("\narwqi"), this_player()))
    {
      tell_room(environment(this_object()), 
          "Quax unterhaelt sich mit "+capitalize(this_player()->Name())+" ueber Wein.\n", ({this_player() }));
      write("Quax sagt: Gut, ich schaue mal schnell nach.\n");
      this_object()->move(ROOM "zwkeller", M_GO , "" , "eilt in den Weinkeller" , "kommt an");
      call_out(("zurueck"),20);
    } 
    else
    {
      write("Quax sagt: Ich muss mich leider erst um meine Gaeste kuemmern.\n");
    }
    return 1;
  }
  return 0;	 
}

void zurueck()
{
  this_object()->move(ROOM "zgasthof", M_GO , "" , "geht rauf" , "kehrt zurueck"); 
  write("Quax sagt traurig: Es tut mir leid, aber ich habe keinen Wein aus Derlim mehr.\n");
  write("Quax seufzt und kuemmert sich wieder um seine anderen Gaeste.\n");  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "sagt erbost: Lass' das gefaelligst, "+this_player()->name(WER, 2),
        "sagt erbost: Lass' das gefaelligst, "+this_player()->name(WER, 2));
      break;
    case "aergerlich":
      call_out("react", 0, "beachtet Dich gar nicht", "beachtet "+this_player()->name(WER, 2)+" gar nicht");
      break;
    case "traurig":
      call_out("react", 0, "troestet Dich",
	       "troestet "+this_player()->name(WER, 2));
      break;
    case "albern":
      call_out("react", 0, "kichert",
	       "kichert");
      break;
    case "neutral":
      call_out("react", 0, "schaut Dich freundlich an", "schaut "+this_player()->name(WEN)+" freundlich an");
      break;
    case "intim":
      call_out("react", 0, "fragt: Spinnst Du?",
                   "fragt: Spinnst Du, "+this_player()->name(WEM));
      break;
    case "froh":
      call_out("react", 0, "laechelt Dich froehlich an",
             "laechelt "+this_player()->name(WEN)+" froehlich an");
      break;
    case "aengstlich":
      call_out("react", 0, "macht sich ueber Dich lustig",
             "macht sich ueber "+this_player()->name(WEN)+" lustig");
      break;
    case "frech":
      call_out("react", 0, "schaut Dich boese an", "schaut "+this_player()->name(WEN)+" boese an");
      break;
    case "nett":
      call_out("react", 0, "knuddelt Dich", "knuddelt "+this_player()->name(WER));
      break;
  }
}

void react(string victim, string others)
{
  if (present(this_player(), environment(this_object()))) 
  {
    tell_object(this_player(), break_string(Name(WER, 1) + " "+victim+".", 74));
    tell_room(environment(this_object()), 
        break_string(Name(WER, 1)+" "+others+".", 74), ({this_player(),this_object()}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
