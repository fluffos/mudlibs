
/*
//
//  StandardNPC fuer Arwenock
//  Iwo@SL
//
*/

#include "../def.h"

inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <mnpc.h>

#define MY_NAME "StandardMNPC"
#define MY_SHORTINT "Ein StandardMNPC"
#define MY_GENDER NEUTER
#define MY_ID "npc"



void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, MY_SHORTINT);
  SetProp(P_LONG,
    "Vor Dir steht der beste Baecker der Zwergenstadt. Die leckersten "
    "Backwaren wie Kipferln, Salzstangen,... werden von seinen "
    "geschickten Haenden gemacht.");
  SetProp(P_NAME, MY_NAME);
  SetProp(P_GENDER, MY_GENDER);

  AddId( ({ MY_ID }));
  AddAdjective( ({"alt", "alten", "alter"}) );
  
  create_default_npc(20);

  SetProp(P_HANDS, ({" mit den Haenden",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 185);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);

  SetProp( P_REJECT, ({ REJECT_GIVE,
     MY_NAME + " sagt: Vielen Dank. Aber ich brauche @WEN nicht.\n" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "room_C-04");
  SetProp(P_MNPC_AREA, ROOM);
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS | MOV_MOVES | MOV_INDOORS);

  if (!IS_BLUE(TO)) AMASTER->AddNpc(TO);

}


// Master benachrichtigen beim Tod (Feind)
void die(int poisondeath)
{
  AMASTER->PlayerKilledNpc(TO, getuid(TP));
  if (find_player("iwo")) tell_object(find_player("iwo"), sprintf("Kill: %s, MASTER: %s\n", getuid(TP),
                                           AMASTER));
  return ::die(poisondeath);
}


// Master benachtrichtigen, wenn ich den Player zerfetz 
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  AMASTER->NpcKilledPlayer(getuid(TP));
  return;
}


// Jeden reset beim master anmelden
void reset()
{
  if (!IS_BLUE(TO)) AMASTER->AddNpc(TO);
  ::reset();
}
