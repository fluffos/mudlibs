// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;

  call_out("reaction", 0, TP, 
	   "sieht Dich kurz verwundert an und nimmt einen Schluck aus einer Flasche.\n",
	   "sieht @WEN kurz verwundert an und nimmt einen Schluck aus einer Flasche.\n");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

catch_tell(string str)
{
  string who,whom;
  object ag;
  int ret;

  if(this_object()->InFight()) return;
  
  str=lower_case(str);
  
  if(sscanf(str, "%s sagt: buergermeister bitte begnadige %s",who,whom)==2)
    {
      if(ag=find_player(who))
	if(ENV(ag)==ENV(TO))
	  {
	    if(TP->QueryMoney()<KOSTEN)
	      return say("Der Buergermeister meint: 'Komm mit meeehr Geld schurueg!\n"+
			 "Der Buergermeister meint: Eine Begnadigung goschdet "+KOSTEN+
			 " Muentschen'\n");
	    whom=implode(explode(whom,"\n"),"");
	    whom=implode(explode(whom," "),"");
	    ret=ROOM "zelle"->Release(whom);
	    switch(ret)
	      {
	      case 2: say("Der Buergermeister meint: "+CAP(whom)+" isch irkendwie net da!\n");
		break;
	      case 1: say("Der Buergermeister meint: "+CAP(whom)+" wurde ausch der Schelle "+
			  "entlaschen!\n");
	      ag->AddMoney(-KOSTEN);
	      tell_object(ag,
			  BS("Du bezahlst das Geld und grummelst etwas ueber den Wucherpreis, "+
			     "doch dafuer ist nun "+CAP(whom)+" gerettet und Du "+
			     (ag->QueryProp(P_GENDER)==FEMALE ? "die Heldin":"der Held")+
			     " des Tages!\n"));
	      write_file(ALOG "begnadigungen", ctime()+" - "+CAP(whom)+" von "+CAP(who)+
			 " begnadigt.\n");
	      break;
	      default: say("Der Burgermeister meint: Aba "+CAP(whom)+" isch irkendwie "+
			   "net in der Schelle!\n");
	      }
	  }
    }
}
