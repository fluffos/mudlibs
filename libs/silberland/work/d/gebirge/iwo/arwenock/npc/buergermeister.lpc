inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

#define WIZNAME "protheg"
#define KOSTEN 5799
#define DB(x) if (find_player(WIZNAME)) tell_object(find_player(WIZNAME),(x)) 

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Buergermeister von Arwenock");
  SetProp(P_LONG,
	  "Der Buergermeister von Arwenock duerfte seine Besten Zeiten schon hinter "+
	  "sich gebracht haben. Heute ist er gerade noch zum Unterschreiben zu gebrauchen. "+
	  "Sein Tisch ist voller Flaschen, die er mittlerweile schon fast alle ausgetrunken "+
	  "hat. Einmal abesehen von seiner immensen Alkoholfahne ist er ein netter alter "+
	  "Kautz.\n");
  SetProp(P_NAME, ({"Buergermeister",
		      "Buergermeisters von Arwenock",
		      "Buergermeister",
		      "Buergermeister von Arwenock"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"buergermeister", "hobbit", "NOWIMPY"}));

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinem giftigen Atem",QueryProp(P_HANDS)[1]+100,DT_POISON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_FIRE:      0.1, DT_COLD:     -0.2, DT_WATER:  0.2, DT_AIR:    0.0, 
	  DT_LIGHTNING:   0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
	  DT_ELECTRIC:    0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
	  DT_HOLY:       -0.2, DT_UNHOLY:    0.0, DT_MAGIC: -0.2, DT_STONE:  0.0,
	  DT_MIND:       -0.9]) );
  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "wankt herein");
  SetProp(P_MSGOUT, "wankt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kippt vom Hocker und stirbt.\n");
  SetProp(P_KILL_MSG, "*ruelps*lall*ruelps*");

  AddInfo(DEFAULT_INFO, "murmelt irgendwas daher und ruelpst.\n");
  
  AddInfo(({"schegretaerin","sekretaerin","frau"}),
	  "Jo, desch isch meine 'hick' Schegretaerin, ischsi nichd allerliebschd?\n",
	  "lallt: ");
  AddInfo(({"begnadigung"}),
	  "Jo, desch gehd gaantsch einfasch! Schag einfach 'buergermeister bitte "+
	  "begnadige <sonundso>'\n",
	  "meint: ");
  AddInfo("arwenock",
	  "Jo, i bin da Buergemaischda von dem Arwenock hia.\n",
	  "lallt: ");
  AddInfo(({"kischdn","kisten"}),
	  "Dasch schind wichtige Dokumende! Scheid unsch damalsch dasch Kellearschiv "+
	  "einkeschduertscht ischt, mueschn wir die Kischdn alle hia lagean.\n",
	  "plaudert: ");
  AddInfo(({"buergemaischda","buergermeister"}),
	  "fasst sich stolz an die Brust und meint: Desch bin i!\n","");
  AddInfo(({"dokumende","dokumente"}),
	  "Desch derf i Dir nichd schagn!\n",
	  "fluestert: ");
  AddInfo(({"kellearschiv","kellerarchiv"}),
	  "Wir haben frueher immer unschere Dokumende im grooschen Kellearschiv "+
	  "geschammelld, aber scheid dasch einkeschduertscht ischt, schdehd allesch "+
	  "hier oben rum!\n",
	  "plaudert: ");
  AddInfo("hilfe",
	  "Wasch fuer Hilfe brauchschdn? Scholl isch edwa Jemanden begnadign?\n",
	  "fragt: ");
  AddInfo(({"flaschn","flaschen"}),
	  "Ischab hier alle Flaschn von allem Alloohol wasch gibd im Schilbealand.\n",
	  "lallt: ");
  AddInfo(({"alkohol","alloohol","liebste","liabschde"}),
	  "Jo, der Alloohol isch mei Liabschde, weil de schauf i dauernd.\n",
	  "seufzt: ");
  AddInfo(({"silberland","schilbealand"}),
	  "Jo, wir schind hier im Schilbealand, goe?!\n",
	  "meint: ");

  SetProp(P_LOG_INFO, "arwenock_buergermeister");

  SetProp(P_REJECT, 
	  ({ REJECT_DROP, "Der Buergermeister lallt: Wasch scholl i denn damid?\n"}));

  SetProp(P_SPELLRATE, 20);
  AddSpell(5,700,
	   "Der Buergermeister zueckt eine Fackel.\n"+
	   "Der Buergermeister haucht Dir eine grosse Flammenlanze entgegen!\n"+
	   "Der Buergermeister steckt eine Fackel weg.\n",
	   "Der Buergermeister zueckt eine Fackel.\n"+
	   "Der Buergermeister haucht @WEM eine grosse Flammenlanze entgegen!\n"+
	   "Der Buergermeister steckt eine Fackel weg.\n",
	   DT_FIRE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, 
	({"Der Buergermeister lallt etwas vor sich hin.\n",
	    "Der Buergermeister faellt aus dem Sessel und klettert sofort wieder rein.\n",
	    "Ein leises Klirren zwischen den Flaschen verraet den Buergermeister.\n",
	    "Der Buergermeister groehlt: 'Proooschd Alder!'\n",
	    "'BOOEEEEEEERRRP' erklingt es und der Raum fuellt sich mit Alkoholgeruch.\n"}) );
  SetAttackChats(5, 
	 ({"Der Buergermeister faellt auf den Boden, steht aber sofort wieder auf.\n",
	     "Der Buergermeister trinkt noch schnell ein Schluckerl aus einer Flasche.\n"}));

}
