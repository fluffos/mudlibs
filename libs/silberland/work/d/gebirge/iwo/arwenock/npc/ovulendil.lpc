/*
//
//  Ovulendil, der EierNPC
//  Iwo@SL
//
*/

#define WIZNAME "iwo"

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <mnpc.h>

#define EGG_COSTS 550

inherit STDMNPC;

//#include "./master.h"


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ovulendil sucht sich vergeblich selbst");
  SetProp(P_LONG,
    "Ovulendil ist ein stattlicher Elf fortgeschrittenen Alters. "
    "Er macht eigentlich weniger einen gefaehrlichen Eindruck, als "
    "dass er eil Gelehrter zu sein scheint.");
  SetProp(P_NAME, "Ovulendil");
  SetProp(P_GENDER, MALE);


  create_default_npc(23);

  AddLibrary("/p/service/iwo/lib/gilden.lib", 30);
  AddLibrary("/p/service/iwo/lib/rassen.lib", 30);
  AddLibrary("/p/service/iwo/lib/regionen.lib", 30);
  AddLibrary("/p/service/iwo/lib/gebirge.lib", 30);
  AddLibrary("/p/service/iwo/lib/gilden.lib", 30);

  AddId( ({ "ovulendil" }));


  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 223);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ARTICLE, 0);

  clone_object("/p/armour/boots/sandalen.lpc")->move(ME);
  clone_object("/p/armour/trousers/hose.lpc")->move(ME);
  clone_object("/p/armour/cloak/umhang.lpc")->move(ME);
  clone_object("/p/armour/armour/hemd.lpc")->move(ME);
  clone_object("/p/armour/armour/weste.lpc")->move(ME);
  clone_object("/p/armour/helm/hut.lpc")->move(ME);

  command_me("trage alles");

  SetProp(P_MNPC_AREA, ROOM);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room_D-04");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_OUTDOORS);
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }));

  SetProp(P_MSGIN, "schlendert herein");
  SetProp(P_MSGOUT, "schlendert gemuetlich");
  SetProp(P_MMSGIN, "kommt zerstreut an");
  SetProp(P_MMSGOUT, "wandelt zerstreut weiter");

}

void restart_move()
{
  call_out("wandern", 20 + random(20));
  return;
}

void give_notify(object ob)
{
  while (remove_call_out("wandern") != -1);

  if (!ob->id("morphei"))
    {
      give_obj(ob, TP);
      return restart_move();
    }

  if (TP->QueryMoney() < EGG_COSTS)
    {
      command_me(sprintf("sag Tut mir leid, das kostet Dich %d Muenzen, soviel hast Du jedoch nicht.", EGG_COSTS));
      give_obj(ob, TP);
      if (getuid(TP) != "iwo")
        return restart_move();
    }

  tell_room(ENV(ME), BS(ME->Name(WER) + " rueckt seine Brille etwas "
    + "zurecht, und nimmt " + ob->name(WEN) 
    + " genauer in Augenschein."));

  TP->AddMoney(-EGG_COSTS);

  call_out("identify", 5, ob);   


 
  return;
}


void identify(object ob)
{
  string region;
  string *domains;

  region = ob->GetRegion();

  domains = "/secure/master"->get_domains();

  if (member(domains, region)==-1)
    region = "- aehm.... oeh... nein, ich kann mich "
           + "nicht mehr erinnern, tut mir leid";

  command_me(sprintf("sag Ahja, %s. So eines habe ich schon einmal "
                     "gesehen, wenn ich mich nicht irre, dann war das "
                     "in der Region %s.",
                     ob->name(WER), CAP(region)));

  tell_object(TP, BS("Du gibts " + ME->name(WEM) + sprintf(" %d Muenzen.", EGG_COSTS)));

  give_obj(ob, TP);

  return restart_move();
}

