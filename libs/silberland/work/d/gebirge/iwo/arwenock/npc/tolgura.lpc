/*
**      Tolgura, Wirtin de Kneipe in Arwenock
**
**      Zaknafein, Mai 2001
*/

#include "../def.h"

// inherit STDNPC;

inherit "std/npc";

inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

#define WIZNAME "zaknafein"
#define BS(x) break_string(x, 78)

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Tolgura, die Wirtin");
  SetProp(P_LONG, "Hinter der Theke steht eine grosse, kraeftige Frau, die "
         "mit einem engen Lederoberteil und einer Lederhose bekleidet ist "
         "sie sieht sehr kraeftig aus, und auf einem ihrer Oberarme kannst "
         "Du eine Taetowierung erkennen. Die Haare hat sie zu zwei wild "
         "aussehenden Zoepfen geflochten. ");
  SetProp(P_NAME, "Tolgura");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);

  SetProp(P_RACE, "Mensch");
  create_default_npc(25);
  SetProp(P_ALIGN, 630);
  SetProp(P_SIZE, 176);
  SetProp(P_HANDS, 
      ({" mit einer zerbrochenen Flasche", QueryProp(P_HANDS)[1], DT_PIERCE}) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.2, DT_COLD:   -0.2, DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, 
      DT_ELECTRIC:  0.1, DT_POISON: -0.2, DT_TERROR:   -0.2, DT_MAGIC:  -0.2 ]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT, ({REJECT_KEEP, "Die Wirtin sagt: Danke fuer das Trinkgeld!\n"}));
  AddId( ({ "NOWIMPY" , "tolgura" , "wirtin" , "mensch" , "\ntolgura" }) );

  seteuid(getuid(this_object()));
  clone_object("/p/armour/trousers/lederhose")->move(this_object());
  clone_object("/p/armour/boots/lederstiefel")->move(this_object());
  clone_object("/p/armour/cloak/lederschuerze")->move(this_object());
  if (random(5)<2) clone_object("/p/armour/ring/ring")->move(this_object());
  command("ziehe alles an");

  SetProp(P_SPELLRATE,50);
  SetProp(P_NOMAGIC, 20);

  AddSpell(1,500,
	   "Tolgura wirft einen riesigen Feuerball auf Dich.\n",
	   "Tolgura wirft einen riesigen Feuerball auf @WEN.\n",
           DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,700,
	   "Tolgura zertruemmert eine Flasche auf Deinem Kopf.\n",
	   "Tolgura zertruemmert @WEM mit einer Flasche den Schaedel.\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,"","",DT_TERROR,"heilenspell");  // natuerlich heilt er sich selbst
  AddSpell(1,1,"","",DT_AIR,"sattspell"); // jo, tanken ist dann wohl erstmal nicht...

  SetChats(1, ({
  "Tolgura putzt die Theke.\n",
  "Ein Mann bestellt einen Kartoffelauflauf.\n",
  "Tolgura geht kurz in die Kueche und kommt dann mit einem Auflauf zurueck.\n",
  "Tolgura fragt Dich: Was darf ich Dir bringen?\n"
  }) );

  SetProp( P_DIE_MSG,
      " schaut unglaeubig auf seine Wunden und stirbt kopfschuettelnd.\n" );

  SetProp(P_DEFAULT_INFO, ({ "fragt: Willst Du nicht was trinken?\n",
                             "fragt: Wie gefaellt Dir meine Tochter?",
                             "stoehnt: Du kannst Fragen stellen..." }) );

  AddInfo( "zaknafein" ,
      "Zaknafein ist mein bester Kunde.\n","sagt stolz: ");
  AddInfo( ({ "gasthof" , "hof" }) ,
      "Dieser Gasthof ist mein ganzer Stolz. Gefaellt es Dir hier?\n","sagt: ");
  AddInfo( "kneipe"  ,
      "erklaert: Ja, das hier ist wirklich eine Kneipe!\n" );
  AddInfo( ({ "tochter" }) ,
      "Meine Tochter verkauft Blumen in der Naehe. Sie ist mein ganzer "
      "Stolz.\n","sagt stolz: ");
  AddInfo("kasse"  ,
      "Lass' ja die Finger von meiner Kasse!\n","warnt Dich: ");
  AddInfo( ({ "bauch" }),
      "He! Der geht Dich wohl nichts an!\n", "tadelt Dich: ");

//  AddCmd( "bitte", "bitten");

}
void heilenspell(object enemy, int damage, mixed dam_type)
{
  say("Tolgura trinkt mal eben einen Kurzen und sieht danach gestaerkt aus.\n");
  heal_self(10+random(100));
}

void sattspell(object enemy, int damage, mixed dam_type)
{

  tell_object(enemy,
      BS("Tolgura stopft Dir Sand in den Mund. Du bekommst kaum noch Luft.\n"));
  tell_room(environment(enemy), 
      "Tolgura stopft "+capitalize(enemy->Name())+" Sand in den Mund.\n", ({ enemy }));
  enemy->SetProp(P_FOOD, enemy->QueryProp(P_MAX_FOOD));
  enemy->SetProp(P_DRINK, enemy->QueryProp(P_MAX_DRINK));
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe)
  {
    case "fies":
      call_out("react", 0, "sagt erbost: Lass' das gefaelligst, "+this_player()->name(WER, 2),
        "sagt erbost: Lass' das gefaelligst, "+this_player()->name(WER, 2));
      break;
    case "aergerlich":
      call_out("react", 0, "beachtet Dich gar nicht", "beachtet "+this_player()->name(WER, 2)+" gar nicht");
      break;
    case "traurig":
      call_out("react", 0, "troestet Dich",
	       "troestet "+this_player()->name(WER, 2));
      break;
    case "albern":
      call_out("react", 0, "kichert",
	       "kichert");
      break;
    case "neutral":
      call_out("react", 0, "schaut Dich freundlich an", "schaut "+this_player()->name(WEN)+" freundlich an");
      break;
    case "intim":
      call_out("react", 0, "fragt: Spinnst Du?",
                   "fragt: Spinnst Du, "+this_player()->name(WEM));
      break;
    case "froh":
      call_out("react", 0, "laechelt Dich froehlich an",
             "laechelt "+this_player()->name(WEN)+" froehlich an");
      break;
    case "aengstlich":
      call_out("react", 0, "macht sich ueber Dich lustig",
             "macht sich ueber "+this_player()->name(WEN)+" lustig");
      break;
    case "frech":
      call_out("react", 0, "schaut Dich boese an", "schaut "+this_player()->name(WEN)+" boese an");
      break;
    case "nett":
      call_out("react", 0, "knuddelt Dich", "knuddelt "+this_player()->name(WER));
      break;
  }
}

void react(string victim, string others)
{
  if (present(this_player(), environment(this_object())))
  {
    tell_object(this_player(), break_string(Name(WER, 1) + " "+victim+".", 74));
    tell_room(environment(this_object()), 
        break_string(Name(WER, 1)+" "+others+".", 74), ({this_player(),this_object()}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
