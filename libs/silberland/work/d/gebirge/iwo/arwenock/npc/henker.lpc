#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <npc.h>

inherit STDNPC;

#define WIZNAME "protheg"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Henker von Arwenock");
  SetProp(P_LONG,
	  "Ein staemmiger Mensch mit allem, was so ein Henker braucht. Eine "+
	  "blutbesudelte Kutte, blutbesudelte Sandalen eine schwarze Kapuze "+
	  "auf dem Kopf und das Folterwerkzeug in einem Rucksack am Ruecken.\n");
  SetProp(P_NAME, "Henker");
  SetProp(P_GENDER, MALE);

  create_default_npc(20);

  AddId(({"henker"}));

  SetProp(P_HANDS, ({" mit seinem Folterwerkzeug",200,DT_PIERCE}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "ist hier fuer das Hinrichten zustaendig!\n");
  
  SetProp(P_REJECT,
	  ({ REJECT_GIVE, "Der Henker meint: 'Ich bin nicht bestechlich!'\n"}));
}
