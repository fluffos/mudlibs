
#include "../def.h"
#include "../tangram.h"

mapping questers;

create()
{
  if (is_clone(TO))
    TO->remove();
  questers=([]);
}

dump_questers()
{
  printf("%O\n", questers);
}

register_quester(string q)
{
  questers+=([q:0]);
}

set_quester_tile(string q, int tile_no)
{
  if (!member(questers, q))
    return;
  questers[q]|=Q_INDICES[tile_no];
}

object gimme_tile(string quester)
{
  int *q, *q2, tiles_found, i, tile_type, new_tile, tile_idx;
  object o;
  
  if (!member(questers, quester))
    return 0;
  q=Q_INDICES;
  q2=({});
  tiles_found=questers[quester];
  for (i=sizeof(q)-1; i>=0; i--)
    if (!(tiles_found&q[i]))
      q2+=({q[i]});
  // printf("%O\n", q2);
  if (sizeof(q2)==0)
    return 0;
  o=clone_object(APATH+"obj/tile");
  new_tile=q2[random(sizeof(q2))];
  tile_idx=member(q, new_tile);
  tile_type=Q_TILES[tile_idx];
  o->customize(tile_idx, tile_type);
  printf("%d, %d: %d\n", new_tile, tile_idx, tile_type);
  questers[quester]|=new_tile;
  //hack
  o->move(find_player("creative"));
  return o;
}

mixed *query_tile(int type, int heading)
{
  if (!member(questers, getuid(TI)))
    return TILES[T_TYPE_X][0];
  return TILES[Q_TILES[type]][heading];
}

