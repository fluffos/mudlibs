/////////////////////////////////////////////


// Einen NPC zum Master hinzufuegen
int AddNpc(object npc)
{
  if(!member(m_npcs, npc))
    m_npcs += ([npc]);
  return 1;
}


// Einen NPC ausm Master loeschen und DEFCON pruefen
int DelNpc(object npc)
{
  if(member(m_npcs, npc))
    m_npcs -= ([npc]);
  
  //CeckDefcon();
  
  return 1;
}


// Ein spieler hat einen NPC gekillt
int PlayerKilledNpc(object npc, string player)
{
  int tmpk;
  
  //tell_object(find_player("iwo"), sprintf("MasterKill: %s\n", player));
  
  if (!member(m_npckills, player))
    m_npckills += ([player: 1]);
    
  else
    {
      tmpk = m_npckills[player, 0];
      m_npckills += ([player: tmpk+1]);
    }
    
  // NPC ausm master loeschen
  DelNpc(npc);    
  
  saveme();
    
  return 1;
}


// Ein NPC hat einen Spieler gekilled
int NpcKilledPlayer(string player)
{
  int tmpk;
  
  if (!member(m_deaths, player))
    m_deaths += ([player: 1]);
    
  else
    {
      tmpk = m_deaths[player, 0];
      m_deaths += ([player: tmpk+1]);
    }
    
  saveme();
    
  return 1;
}

int NukeArkens(int x)
{
  if (x)
    nuke_arkens = 1;
  else
    nuke_arkens = 0;

  return nuke_arkens;
}


string name()
{
  return name;
}

void UnRegisterArkens(object npc)
{
  arkens -= ({ npc });
}


void RegisterArkens(object npc)
{
  if (member(arkens, npc)<0) arkens += ({ npc });
  if (nuke_arkens) PO->remove();
}


int QueryArkens()
{
  return sizeof(arkens);
}


void reset()
{
  arkens -= ({ 0 });
  if (sizeof(arkens)<EVENT_ARKENS)
    {
      Debug(sprintf("Reset. Cloning %d Arkens.", EVENT_ARKENS-sizeof(arkens)));
      //CloneArkens(EVENT_ARKENS-sizeof(arkens));
    }

  //SetDefcon(0);
  saveme();
}
