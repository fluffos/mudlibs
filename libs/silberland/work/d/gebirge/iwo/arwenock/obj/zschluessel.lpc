/*
**       Schluessel fuer das Haus des Oberruepels
**       
**               Zaknafein, Februar 2000
**
*/

inherit "/std/thing";

#include <thing.h>
#include <properties.h>
#include <language.h>
#define WIZNAME "zaknafein"

create()
{
  if (!is_clone(this_object()))
     return;
 ::create();


  SetProp(P_SHORT, "Ein kleiner Schluessel");
  SetProp(P_LONG, "Dies ist der Schluessel zum Haus des Oberruepels.\n");
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "schluessel" , "\nzakorschluessel" }) );
  AddAdjective( ({ "klein" , "kleiner" , "kleinem" , "kleinen" }) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_IRON);

}
