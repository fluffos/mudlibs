/*
**  Questitem fuer Paladine, Elfen... (gute Seite)
** 
**  Zaknafein, Mai 2001
**
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>

int spielstand=0; // auf 0 setzen !

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Eine Maus");
  SetProp(P_LONG, "Eine kleine weisse Maus. Sie hoert und sieht alles. Ob sie jedoch vor Gericht "
		 +"einen guten Zeugen abgibt, ist mehr als fraglich.\n");
  SetProp(P_NAME, "Maus");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "maus" , "\nzakmaus" , "\narwqi" }) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, MAT_MISC_LIVING);
  SetProp(P_NODROP, "Nein, Nein, Du musst die Maus schon behalten.\n");
  SetProp(P_NEVERDROP, 1);

}

queryspielstand()
{
return spielstand;
}

setspielstand()
{
spielstand = spielstand +1;
if (spielstand==3) spielstand = 0;
return;
}

