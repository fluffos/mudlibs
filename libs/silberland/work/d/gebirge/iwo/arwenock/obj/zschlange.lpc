/*
**
**  Questitem (Schlange fuer Nekromanten, Dunkelelfen, ...)
** 
**  Zaknafein Mai 2001
**
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>


int spielstand=1;    // auf 1 setzen !!!

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Eine Schlange");
  SetProp(P_LONG, "Eine kleine Schlange. Sie hoert und sieht alles.\n");
  SetProp(P_NAME, "Schlange");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "schlange" , "\nzakschlange" , "\narwqi"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, MAT_MISC_LIVING);
  SetProp(P_NODROP, "Nein, Nein, Du musst die Schlange schon behalten.\n");
  SetProp(P_NEVERDROP, 1);

}

queryspielstand()
{
return spielstand;
}

setspielstand()
{
spielstand = spielstand +1;
if (spielstand==3) spielstand = 0;
return;
}
