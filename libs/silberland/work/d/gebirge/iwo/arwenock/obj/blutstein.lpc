// Steinobjekt zum steinigen PROtheG@Sl 27.02.2000
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

#define WIZNAME "protheg"

create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein blutbefleckter Stein");
  SetProp(P_LONG, 
	  "In Deinen Haenden haelst Du einen menschenfaustgrossen Stein, der "+
	  "offenbar zu Steinigungen verwendet wird. Da solche Steine wohl nicht "+
	  "sehr haeufig vorkommen, werden sie wiederverwendet. Daher kommen wohl"+
	  " die ganzen eingetrockneten Blutflecken auf dem Stein. Man kann damit"+
	  " einen bestimmten Koerperteil des Geaechteten anvisieren und dann "+
	  "werfen...\n");
  SetProp(P_INFO,
	  "Ein Stein ist ein Stein ist ein Stein ist ein Stein ist ein Stein!\n");
  SetProp(P_NAME, "Stein");
  SetProp(P_NAME_ADJ, "blutig");
  SetProp(P_GENDER, MALE);
  AddId(({"stein","\nsteinigt_ihn!"}));
  SetProp(P_MATERIAL, ([MAT_GRANITE]));
  SetProp(P_WEIGHT, 500); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Auf jemanden werfen, nicht wegwerfen!!\n");
  SetProp(P_NEVERDROP, 1);
}
