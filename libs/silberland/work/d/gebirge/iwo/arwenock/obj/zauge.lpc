/*      ein blaues Auge 
**
**  Zaknafein, Februrar 2000
*/

#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>

#define WIZNAME "zaknafein"

int i=0;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("\nzakauge");
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, "blaues Auge");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_MATERIAL, MAT_MISC);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);

  catch("/players/iwo/tools/cl/clm"->cl());
}

reset()
{
  ::reset();

if(i>4)
 {
  write("Deinem Auge geht es wieder besser.\n");
  this_object()->remove();
 } 
else
 {
  write("Dein blaues Auge schmerzt heftig.\n");
  i = i + 1;
 }

}

string extra_look()
{
if (environment()->QueryProp(P_GENDER)==2)
 return  BS("Sie hat ein blaues Auge. Mit wem sie sich wohl gepruegelt hat?\n");
else
 return  BS("Er hat ein blaues Auge. Mit wem er sich wohl gepruegelt hat?\n");
}
