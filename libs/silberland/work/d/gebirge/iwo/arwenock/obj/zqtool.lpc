/*
**  Tool fuer die Arwenock-Quest
** 
**  Zaknafein Mai 2001
**
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Tool fuer die Arwenock-Quest");
  SetProp(P_LONG, "Anleitung:\n"
		 +"setz(e) <spielername>    :    Spielstand setzen \n"
		 +"spielstand <spielername> :    Spielstand abfragen\n"
		 +"seite <spielername>      :    Auf welcher Seite steht der Spieler?\n"
		 +"Der Spielstand gibt die Anzahl der erfuellten Aufgaben an.\n");
  SetProp(P_NAME, "Tool");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "tool" , "\narwtool" }) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);
  SetProp(P_MATERIAL, MAT_SHADOW);
  SetProp(P_NODROP, "Destructe das Tool lieber, wenn Du es nicht mehr brauchst.\n");
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({ "setz" , "setze" }) , "setzen" );

  AddCmd( "spielstand", "abfragen");

  AddCmd( "seite", "seite");

}

setzen( str )
{
string spieler;
object ob;

notify_fail( "Spieler nicht gefunden!\n" );

if (str==0) return 0;
sscanf(str, "%s", spieler);

if(find_player(spieler))
{
	{
	   if (ob=present(("\narwqi"), find_player(spieler)))
    		{
		 ob->setspielstand();
	         write("Spielstand auf "+ob->queryspielstand()+" gesetzt.\n");
        	}
           else
		{
		write("Diese(r) Spieler(in) hat kein Questitem!\n");
		} 

           return 1;
        }
}
return 0;	 
}


abfragen( str )
{
string spieler;
object ob;

notify_fail( "Spieler nicht gefunden!\n" );

if (str==0) return 0;
sscanf(str, "%s", spieler);

if(find_player(spieler))
	{

  	   if (ob=present(("\narwqi"), find_player(spieler)))
    		{
		 write("Variable Spielstand: "+ob->queryspielstand()+"\n");
        	}
           else
		{
		write("Diese(r) Spieler(in) hat kein Questitem!\n");
		} 
           return 1;
        }
return 0;	 
}

seite( str )
{
string spieler;
object ob;

notify_fail( "Spieler nicht gefunden!\n" );

if (str==0) return 0;
sscanf(str, "%s", spieler);

if(find_player(spieler))
	{

  	   if (ob=present(("\narwqi"), find_player(spieler)))
    		{
		 if (ob=present(("\nzakmaus"), find_player(spieler)))
		 write("Der/Die Spieler(in) kaempft fuer die helle Seite.\n");
		 else
		 write("Der/Die Spieler(in) kaempft fuer die dunkle Seite.\n");
        	}
           else
		{
		write("Diese(r) Spieler(in) hat kein Questitem!\n");
		} 
           return 1;
        }
return 0;	 
}
