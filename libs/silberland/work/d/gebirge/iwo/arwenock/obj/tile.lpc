#include <properties.h>
#include <material.h>
#include "../def.h"

#define WIZNAME "creative"

inherit "std/thing";

int tile, heading;

create()
{
  if (!is_clone(TO))
    return;
  ::create();
  
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  AddId("teil");
  AddCmd(({"dreh", "drehe"}), "turn_tile");
}

int customize(int tile_idx)
{
  tile=tile_idx;
  switch(tile) {
    case 0..4: SetProp(P_NAME, "Gebaeudeteil"); break;
    case 5..8: SetProp(P_NAME, "Wiesenteil"); break;
    case 9..12: SetProp(P_NAME, "Parkteil");
  }
  SetProp(P_SHORT, "Ein "+QueryProp(P_NAME));
  AddId(lower_case(QueryProp(P_NAME)));
  heading=random(4);
}

dump()
{
  printf("tile_type: %d\n", tile);
}

string long()
{
  string ret, *t_str;
  int i, s;
  
  ret=BS("Das ist ein "+QueryProp(P_NAME)+" fuer Dein Planungsbrett. Du kannst"
        +" es drehen oder fix fertig einsetzen. Es sieht derzeit so aus:");
  ret+="\n";
  t_str=TMASTER->query_tile(tile, heading);
  s=sizeof(t_str);
  for (i=0; i<s; i++)
    ret+="    "+t_str[i]+"\n";
  return ret+"\n";
}

turn_tile(str)
{
  notify_fail("Was willst Du drehen?\n");
  if (!str || (str!="teil" && str!=lower_case(QueryProp(P_NAME))))
    return 0;
  heading++;
  heading%=4;
  write("Du drehst das "+QueryProp(P_NAME)+" um 90 Grad nach links.\n");
  return 1;
}

query_heading()
{
  return heading;
}

query_tile_idx()
{
  return tile;
}

