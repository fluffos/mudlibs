/*
**                      unsichtbars Item 
**  bekommt man vom Blumenmaedchen, wenn man ihr Hilfe anbietet 
**   
**                 Zaknafein, Februar 2000
*/

inherit "std/thing";
#include <properties.h>
#include <language.h>
#define WIZNAME "zaknafein"

int oberruepelweg=0;


void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId("\nzakstitem");
SetProp(P_SHORT, 0);
SetProp(P_NAME, "Item fuer das Sehertor in Arwenock");
SetProp(P_GENDER, NEUTER);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_WEIGHT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_VALUE, 0);

}

queryoberruepel()
{
return oberruepelweg;
}

setoberruepel()
{
oberruepelweg=1;
return;
}


move(dest,meth) 
{
  mixed res;
  while (remove_call_out("try_remove")!=-1) ;
  res=::move(dest,meth);
  if (!environment() || !living(environment()))
    call_out("try_remove",30);
  return res;
}

try_remove() {
  if (!environment() || !living(environment())) 
    {
      remove();
    }
}

