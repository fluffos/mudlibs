inherit "std/thing";
 

#include <defines.h>
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <ansi.h>

#include "../def.h"


void create()
{
  string str;

  if (IS_BLUE(ME)) return;
  ::create();

  AddId(({"schluessel", "\narkenskey"}));

  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);

  SetProp(P_NAME, "Schluessel");
  SetProp(P_SHORT, "Ein eisener Schluessel");;

  SetProp(P_LONG,
    "Der Schluessel besteht vollstaendig aus Eisen. Auf der Seite "
    "ist 'Stadtwache Arwenock' eingraviert.");


  SetProp(P_NOBUY, 1);


}



