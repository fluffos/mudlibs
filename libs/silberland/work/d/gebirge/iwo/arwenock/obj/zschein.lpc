/*
**  Schuldschein, gehoert zur Arwenock-Quest - muss dem Dieb gebracht werden
** 
**  Zaknafein, Mai 2001
**
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>

int spielstand=0; // auf 0 setzen !

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Ein Schuldschein");
  SetProp(P_LONG, "Wenn man diesem Schuldschein glauben darf, schuldet ... Quax 12000 Muenzen.\n");
  SetProp(P_NAME, "Schuldschein");
  SetProp(P_GENDER, MALE);
  AddId( ({ "schuldschein" , "\nzakschein" , "schein" }) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 12000);
  SetProp(P_MATERIAL, MAT_MISC_LIVING);
  SetProp(P_NODROP, "Solltest Du den Schuldschein nicht einer bestimmten Person bringen?\n");
  SetProp(P_NEVERDROP, 1);

}
