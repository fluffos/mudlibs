#include "../def.h"

inherit "std/thing";

#define WIZNAME "protheg"
#include <properties.h>
#include <moving.h>
#include <language.h>

string kill_grund;

create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Handschellen");
  SetProp(P_LONG,
	  "Eiserne Handschellen, offenbar hat der Traeger etwas schlimmes angestellt!.");
  SetProp(P_NAME, "handschellen");
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nhandschellen", "handschellen"}));
  
  SetProp(P_MATERIAL, ([MAT_IRON:100]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  catch("/players/iwo/tools/cl/clm"->cl());
}

void BecomesNetAlive(object spieler)
{
  if(ENV(TO) || ENV(TO)==find_object(ROOM "zelle"))
    {
      spieler->move(ROOM "zelle", M_NOCHECK);
    }
}

Grund(string str)
{
  kill_grund=str;
}

QueryWhy()
{
  return kill_grund;
}
