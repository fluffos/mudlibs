inherit "std/food";

#include <properties.h>
#include <food.h>
#include <language.h>
#include "../def.h"

#define WIZNAME "protheg"

int alter;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  switch(random(4))
    {
    case 0: 
      SetProp(P_SHORT, "Ein kleiner Hering");
      SetProp(P_LONG,
	      "Ein kleiner, unscheinbarer Hering. Er sieht noch recht frisch aus\n");
      SetProp(P_NAME, "Hering");
      SetProp(P_NAME_ADJ, "klein");
      AddId(({"fisch","hering"}));
      SetProp(P_WEIGHT, 60);
      SetProp(P_VALUE, 10);
      SetProp(P_GENDER, MALE);
      SetProp(P_FOOD_INFO, ([F_HEAL : ({10, 5}), F_SOAK : 3]));
      break;

    case 1:
      SetProp(P_SHORT, "Eine kleine Makrele");
      SetProp(P_LONG,
	      "Eine kleine Makrele. Du freust Dich schon darauf sie zu essen.\n");
      SetProp(P_NAME, "Makrele");
      SetProp(P_NAME_ADJ, "klein");
      AddId(({"fisch","makrele"}));
      SetProp(P_WEIGHT, 70);
      SetProp(P_VALUE, 12);
      SetProp(P_GENDER, FEMALE);
      SetProp(P_FOOD_INFO, ([F_HEAL : ({11, 5}), F_SOAK : 3]));
      break;

    case 2:
      SetProp(P_SHORT, "Ein Schwertfisch");
      SetProp(P_LONG,
	      "Ein mittelgrosser Schwertfisch, noch sieht er geniessbar aus.\n");
      SetProp(P_NAME, "Schwertfisch");
      SetProp(P_NAME_ADJ, "mittelgross");
      AddId(({"fisch","schwertfisch"}));
      SetProp(P_WEIGHT, 150);
      SetProp(P_VALUE, 120);
      SetProp(P_GENDER, MALE);
      SetProp(P_FOOD_INFO, ([F_HEAL : ({24, 15}), F_SOAK : 12]));
      break;

    case 3:
      SetProp(P_SHORT, "Ein Thunfischstueck");
      SetProp(P_LONG,
	      "Ein recht grosses Thunfischstueck, iss es bevor es die Fliegen tun!\n");
      SetProp(P_NAME, "Thunfischstueck");
      SetProp(P_NAME_ADJ, "gross");
      AddId(({"fisch","thunfischstueck"}));
      SetProp(P_WEIGHT, 250);
      SetProp(P_VALUE, 200);
      SetProp(P_GENDER, NEUTER);
      SetProp(P_FOOD_INFO, ([F_HEAL : ({35, 25}), F_SOAK : 20]));
      break;
    }
  alter=0;
}

reset()
{
  object pl;

  ::reset();

  alter++;

  if(alter>5)
    if(pl=ENV(TO))
      if(interactive(pl))
	{
	  tell_object(pl,
		      TO->Name()+" ist entgueltig verfault und Du wirfst ihn weg!\n");
	  call_out("remove",0);
	}
}

void BeimEssen()
{
  write("Du hebst "+TO->name(WEN)+" hoch und stopfst "+TO->QueryPronoun(WEN)+
	" Dir auf einmal in den Mund.\n");
  say(this_player()->name()+" stopft sich "+TO->name(WEN)+" in den Mund.\n");
}
