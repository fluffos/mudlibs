/*
 *
 *  Eintrittskarte fuers Museum in arwenock
 *
 *  Iwo@SL
 *
 *
 */

inherit "std/thing";
 

#include <defines.h>
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <ansi.h>

#include "../def.h"


void create()
{
  string str;

  if (!IS_CLONE(ME)) return;
  ::create();

  AddId(({"karte", "eintrittskarte", "\nmusekarte"}));

  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, NEUTER);

  SetProp(P_NAME, "Eintrittskarte");
  SetProp(P_SHORT, "Eine Eintrittskarte");

  SetProp(P_LONG,
    "Mit dieser Karte kannst Du das Museum in Arwenock betreten."
    " Diese Karte ist nicht uebertragbar und darf nicht weiterverkauft "
    "werden.");


  SetProp(P_VALUE, 120);

}


void reset()
  {
    if(ENV(ME) && interactive(ENV(ME)))
      {
        tell_object(ENV(ME), BS("Huch! Jetzt hast Du glatt Deine "
	                        "Eintrittskarte verloren."));
      }
    else
      {
        write("Der Wind weht die Eintrittskarte weg.\n");
      }
    remove();
    
    ::reset();
  }