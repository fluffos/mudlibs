#pragma strong_types
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
inherit "/std/thing";

string der_text;
string from;
int sent;
int notiert;
//V 1.2 Blumentrauss von Hactar fuer das Blumenmaedchen.
//Created: April 2000
//Last Modified: January 2003
//Fixed:
//
// - Now uses unparsed args
// - Changed to strong_types
// - Improved notier to check for actual message
// - item locked after "schenke"
// - name from saved
// - zettelchen changed
void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Blumenstrauss");
  AddId(({"strauss","blumenstrauss"}));
  SetProp(P_NAME, "Blumenstrauss");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 1000);
  SetProp(P_WEIGHT, 90);
  SetProp(P_MATERIAL, MAT_MISC_PLANT);
	AddCmd( ({"schenke", "schenk"}), "schenk" );
	AddCmd( ({"notier", "notiere"}), "notier" );
	AddCmd( ({"rieche", "riech"}), "riech" );
	AddCmd( ({"lies", "lese"}), "lesen");
	AddSpecialDetail("zettelchen", "zettelfunktion");
	AddDetail("blueten", "Wunderschoene bunte Blueten die Dich in allen Farben des Regenbogens anstrahlen.\n");
	AddDetail("regenbogen", "Na du weisst schon, das bunte Ding am Himmel.\n");
	AddDetail("blaetter", "Sie strahlen in einem saftigen Gruen. Das Blumenmaedchen hat diese Blumen wohl gut gepflegt.\n");
	AddDetail("blumenmaedchen", "Das Blumenmaedchen hat diesen Blumenstrauss zusammen gestellt.\n");
	AddDetail("schleife", "Die Schleife gibt ein magisches blaues Schimmern von sich. Vermutlich ist da Feenmagie im Spiel.\n");
	der_text = "Alles Gute!";
	sent = 0;
	notiert = 0;
	call_out("timetodie", 1820);

}

string zettelfunktion()
{
	if (sent == 0)
	{
		return BS("Am Blumenstrauss haengt ein kleines Zettelchen auf dem Du mit notiere <text> eine Nachricht notieren koenntest.");
	} else
	{
		return BS("Am Blumenstrauss haengt ein goldenes Zettelchen mit einer Nachricht fuer Dich. Du kannst das Zettelchen lesen.");
	}
}
string _query_long()
{
	if (sent == 0)
	{
	return BS("Ein Blumenstrauss, den Du vom Blumenmaedchen oder geschenkt bekommen hast. "
	+ "Die Blueten sind frisch und perfekt geformt. Die Blaetter strahlen in einem saftigem"
	+ " Gruen. Er ist bunt durch die vielen Blueten und riecht gut. Er ist durch eine schoene blaue "
	+ "Schleife zusammen gebunden, von der ein magisches Schimmern ausgeht. "
	+ "An ihm haengt ein Zettelchen, das Du untersuchen"
	+ " solltest. Der Blumenstrauss waere wunderbar dazu geeignet ihn Jemandem zu schenken. Syntax: schenke <name>\n");
	} else
	{
	return BS("Ein Blumenstrauss, den Du vom Blumenmaedchen oder geschenkt bekommen hast. "
	+ "Die Blueten sind frisch und perfekt geformt. Die Blaetter strahlen in einem saftigem"
	+ " Gruen. Er ist bunt durch die vielen Blueten und riecht gut. Er ist durch eine schoene blaue "
	+ "Schleife zusammen gebunden, von der ein magisches Schimmern ausgeht. "
	+ "An ihm haengt ein Zettelchen, das Du untersuchen"
	+ " solltest. Ein wunderbares Geschenk! Du hast ihn von "+ from + " bekommen.\n");
	}
}
void timetodie()
{
	tell_object(environment(this_object()), "Der Blumenstrauss ist verwelkt.\n");
	this_object()->remove();
}
int riech( string str )
{
	if ((str == "strauss") || (str == "blumenstrauss") || (str == "blumen"))
	{
		write(BS("Du riechst an dem Blumenstrauss. Ach der riecht gut! Du geniesst den Geruch und fuehlst Dich wie im siebten Himmel.\n"));
		say(BS(this_player()->Name(WER,2) + " riecht an einem Blumenstrauss und sieht danach viel entspannter aus.\n"));
		return 1;
	}
	return 0;
}

int schenk( string str) 
{
	if(sent == 1)
	{
		write("Du wuerdest es wohl nicht wagen ein Geschenk weiter zu verschenken?\n");
		return 1;
	}
      if(find_player(str))
      {
		    object ob;
			ob= find_player(str);
            this_object()->move(ob, M_NOCHECK);
			write("Ok, der Blumenstrauss wurde verschickt.\n");
			from = this_player()->Name();
			sent = 1;
			tell_object(ob,this_player()->Name(WER)+" hat Dir grad einen Blumenstrauss geschenkt!\n");
			return 1;
      }
      else
      {
      write(break_string("Spieler wurde nicht gefunden... Syntax: schenk <name>\n",76));
      return 1;
    }
	return 0;
}

int notier(string str )
{
	if (strlen(str) < 1)
	{
		write("Was willst du den auf dem Blumenstrausszettelchen notieren? Syntax: notiere <text>.\n");
		return 1;
	}
	if (sent == 1)
	{
		write("Dieser Blumenstrauss wurde bereits verschenkt, Du kannst nichts weiteres notieren.\n");
		return 1;
	}
	write("Ok, dein Text wurde auf dem Zettelchen des Blumenstrausses aufgeschrieben.\n");
	der_text = this_player()->_unparsed_args();
	return 1;
}

int lesen(string str )
{
	if (str == "zettelchen")
	{
		write(break_string("Auf dem Blumenstrausszettelchen steht: " + der_text+ "\n",76));
		return 1;
	}
	return 0;
}