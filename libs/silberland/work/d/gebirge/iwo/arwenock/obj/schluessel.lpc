/*
 *
 *  Kleines Tool fuer die Stadt Arwenock
 *
 *  Iwo@SL
 *
 *
 */

inherit "std/thing";
 

#include <defines.h>
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <ansi.h>

#include "../def.h"

#define PROGGERS ({ "protheg", "angrox", "creative", "andyl", "zaknafein", \
                    "iwo", "querolin"})


nosave object owner;

void create()
{
  string str;

  if (IS_BLUE(ME)) return;
  ::create();
  owner = PL;

  AddId(({"schluessel", "atool"}));

  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);

  str=capitalize(((str=getuid(this_player()))[<1]=='s'||str[<1]=='x'||
        str[<1]=='z')?str+="'":str+="s");
  SetProp(P_NAME, str+" Schluessel zur Stadt Arwenock");
  SetProp(P_SHORT, str+" Schluessel zur Stadt Arwenock");

  SetProp(P_LONG,
    "Dieser Schluessel wird den Ehrenbuergern der Stadt Arwenock "
    "verliehen. Er ist eine grosse Auszeichnung und sollte gut "
    "aufbewahrt werden. Hilfe gibts mit 'ahelp'.");


  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Lass das lieber nicht wo rumliegen.\n");
  SetProp(P_NOBUY, 1);


  AddCmd( ({"ahilfe", "ahelp"}), "ahilfe");
  AddCmd( ({"adef", "adefcon"}), "adef");
  AddCmd( ({"aalert", "aalarm"}), "aalert");

  call_out("env_check",0);
}

void ttp(string str)
{
  tell_object(TP, break_string(str, 78, "Atool: "));
}




int ahilfe(string str)
{
  
  if (str)
    {
      switch(str)
        {
	case "ahilfe": ttp("Das waere wohl Unsinn.");
	               break;
        default: ttp("Gibts noch nicht.");
	
        }
	
    return 1;
    }
  else
    {
    // HELP
    ttp(" adef [<status>]              Stadt-Status anzeigen oder setzen.");
    ttp(" aalert                       Alarmruf der Stadtwache ausloesen.");
    // ttp(" adoor <torname> [<status>]   Zustand eines Tores anzeigen oder setzen.");
    // ttp(" aaddnpc <npc>                NPC zum Master hinzufuegen.");
    // ttp(" adelnpc <npc>                NPC vom Master loeschen.");
    // ttp(" aenemy                       Stadt-Feinde anzeigen.");
    // ttp(" akills [<spieler>]           Anzahl der Kills der NPCs anzeigen.");
    // ttp(" adeaths [<spieler>]          Anzahl der Tode eines Spielers anzeigen.");
    
    return 1;
    }

  return 1;  

}


int adef(int astats)
{


  if(astats)
    {
      switch((int)astats)
        {
          case 0:  ttp("Setze Status auf 'Normal' (0)");
                   AMASTER->SetDefcon(0);
	           break;
          case 1:  ttp("Setze Status auf 'Warnung' (1)");
                   AMASTER->SetDefcon(1);
	           break;
          case 2:  ttp("Setze Status auf 'Alarm' (2)");
                   AMASTER->SetDefcon(2);
                   break;
          default: ttp("Unbekannter Status.");
                   ttp("Moegliche Werte:  0 ( Normal  )");
	           ttp("                  1 ( Warnung )");
                   ttp("                  2 ( Alarm   )");
                   break;
	}
      return 1;
    }
    

  astats = AMASTER->QueryDefcon();

  
  switch(astats)
    {
      case 0:  ttp("Status auf 'Normal' (0)");
	       break;
      case 1:  ttp("Status auf 'Warnung' (1)");
	       break;
      case 2:  ttp("Status auf 'Alarm' (2)");
               break;
      default: ttp("Unbekannter Status.");
               ttp("Moegliche Werte:  0 ( Normal  )");
	       ttp("                  1 ( Warnung )");
               ttp("                  2 ( Alarm   )");
               break;
    }

  return 1;

	      
}




int aalert()
{
  AMASTER->SendDefconAlert();
  return 1;
}


int adoor(string torname, string st)
{
  int stats;

  stats = (int) st;

  
}




varargs int move(mixed dest, int method)
{
  if (dest != owner) return ME_CANT_BE_DROPPED;
  else return ::move(dest, method);
}

void env_check()
{
  if (!environment()) return destruct(this_object());
}

void init()
{
  object ob;
  if( !IS_WIZARD(ob=environment(this_object()))
      && (member(PROGGERS, getuid(ob)) == -1) )
    call_out("remove",0);
  ::init();
}

int _query_autoloadobj() { return 1; }


