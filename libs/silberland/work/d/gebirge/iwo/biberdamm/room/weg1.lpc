
#include <properties.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Wald");

  SetProp(P_INT_LONG,
    "Hier im Wald herrscht angenehme Stille. "
    "Die Baeume spenden wohltuenden Schatten, "
    "und der munter plaetschernde Bach gibt "
    "sein Bestes, um der Stimmung gerecht zu "
    "werden. Ueberall am Boden, zwischen dem "
    "niederen Gehoelz, liegen verwelte Blaetter "
    "und abgestorbene Aeste.");

  AddDetail( ({ "wald" }),
    "Die vielen Baeume hier, sind ein "
    "untruegliches Zeichen dafuer, dass Du Dich "
    "im Wald befindest.");
  AddDetail( ({ "zeichen" }),
    "Ein in einen Baum eingeritztes Zeichen "
    "weist darauf hin, dass im Osten ein "
    "Weg zu sein scheint.");
  AddDetail( ({ "weg" }),
    "Du bist zu weit weg, um ihn von hier aus "
    "zu sehen.");
  AddDetail( ({ "baum", "baeume", "baeumen" }),
    "Baeume gibt es hier viele, aber einer "
    "scheint ein Zeichen zu tragen.");
  AddDetail( ({ "schatten" }),
    "Hier, weit unterhalb der Baumkronen, "
    "herrscht hauptsaechlich Schatten.");
  AddDetail( ({ "baumkronen", "kronen", "dach", "blaetterdach" }),
    "Die Baumkronen bilden ein dichtes "
    "Dach aus blaettern.");
  AddDetail( ({ "bach" }),
    "Der kleine Bach aus frischen Quellwasser "
    "plaetschert munter weiter nach Westen.");
  AddDetail( ({ "quellwasser", "wasser" }),
    "Das Wasser ist kristall klar.");
  AddDetail( ({ "stimmung" }),
    "Hier scheint alles irgendwie zusammen zu "
    "passen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist uebersaet mit verwelkten Blaettern "
    "und abgestorbenen Aesten.");
  AddDetail( ({ "blaetter", "aeste", "blaettern", "aesten" }),
    "Die gibt es sowohl tot amm Boden, als auch lebendig an "
    "den Baeumen."); 
  AddDetail( ({ "bestes" }),
    "Angestrengt plaetschert er durch die Gegend.");
  AddDetail( ({ "gegend" }), 
    "Schau Dich doch einfach um!");
  AddDetail( ({ "gehoelz" }),
    "Das bodennahe Gehoelz laesst den Wald dicht erscheinen, "
    "obwohl er licht genug ist, um Dir den weiteren Weg "
    "nach Westen zu erlauben.");
  AddDetail( ({ "westen" }),
    "Im Westen scheint sich der Wald zu lichten.");
  AddDetail( ({ "himmel" }),
    "Durch das dichte Blaetterdach kannst Du den "
    "Himmel kaum erkennen.");

  AddSound(DEFAULT_SOUND, "Angenehm still. Nur das Plaetschern "
    "des Baches ist zu hoeren.");

  AddExit("osten", "./anschluss.lpc");
  AddExit("westen", "./ufer1.lpc");

  SetProp(P_HIDE_EXITS, ({ "osten", "westen" }));

}
