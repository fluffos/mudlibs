
#include <properties.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Ufer eines Teiches");

  SetProp(P_INT_LONG,
    "Du befindest Dich auf einem Biberdamm am Ufer eines "
    "Teiches. Die fest verflochtenen Aeste und Zweige scheinen "
    "Dein Gewicht locker zu tragen. Ostlich von Dir befindet "
    "sich der Teich, an dessen Ufer Du entlang gewandert bist.");

  AddDetail( ({ "biberdamm", "damm" }),
    "Der massive Damm aus Aesten und Zweigen dient den Bibern "
    "wohl als Nest und Wohnhoehle.");
  AddDetail( ({ "aeste", "aesten", "zweige", "zweigen" }),
    "Die Aeste und Zweige stammen wohl von den Baeumen aus "
    "dem umliegenden Wald.");
  AddDetail( ({ "baeume", "wald", "baeumen" }),
    "Hier am Damm wachsen keine Baeume.");
  AddDetail( ({ "gewicht" }),
    "Davon hast Du ja nicht gerade zu wenig ;-)");
  AddDetail( ({ "teich", "teiches" }),
    "Der doch recht grosse Teich laedt lediglich ein, eine "
    "Runde zu schwimmen.");
  AddDetail( ({ "runde" }),
    "Schwimm doch eine!");
  AddDetail( ({ "biber", "bibern" }),
    "Es sind wohl gerade keine Biber da.");
  AddDetail( ({ "nest" }),
    "Ein Nest, in dem sie ihre Jungen aufziehen."),
  AddDetail( ({ "junge", "jungen" }),
    "Die wirst Du wahrscheinlich nie sehen.");
  AddDetail( ({ "wohnhoehle", "hoehle" }),
    "Dort verbringen die Biber ihre Zeit, wenn sie nicht "
    "gerade fischen und Baeume faellen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus fest verflochtenen Aesten und Zweigen.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist himmelblau.");
  AddDetail( ({ "ufer" }),
    "Entlang des Ufers bist Du wohl hier her gekommen.");


  AddExit("norden", "./damm1.lpc");
  AddExit("suedosten", "./ufer4.lpc"); 
}

