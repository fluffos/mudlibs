
#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

#define ANSCHLUSS "/d/gebirge/iwo/weg/room/04-10.lpc"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Wald");

  SetProp(P_INT_LONG,
    "Du bist hier etwas abseits des Weges im "
    "Wald. Oestlich von Dir befindet sich der Weg, "
    "waehrend westlich von Dir, entlang des kleinen "
    "Quellbaches das gehoelz weiterhin durchdringbar "
    "scheint.");

  AddDetail( ({ "weg", "weges" }),
    "Der Weg befindet sich westlich von Dir. Wenn "
    "Du das Gehoelz verlaesst, befindest Du Dich "
    "auf ihm.");
  AddDetail( ({ "wald" }),
    "Der Wald ist hier nicht so dicht wie sonst in "
    "der Umgebung.");
  AddDetail( ({ "umgebung" }),
    "In Deiner Umgebung finden sich hauptsaechlich "
    "Baeume, sowie einige andere, kleinere Gewaechse.");
  AddDetail( ({ "gewaechse" }),
    "Sie bilden das bodennahe Gehoelz.");
  AddDetail( ({ "baeume", "baeumen" }),
    "Die Baeume hier haben kaum Aeste in Bodennaehe, "
    "so dass ein Erklimmen unmoeglich ist.");
  AddDetail( ({ "erklimmen" }),
    "Die Aeste sind zu weit oben, um sie erreichen "
    "zu koennen.");
  AddDetail( ({ "aeste" }),
    "Die Aeste sind hoch droben an den Baeumen.");
  AddDetail( ({ "bodennaehe" }),
    "Da befindest Du Dich, sowie diverses Gehoelz.");
  AddDetail( ({ "gehoelz" }),
    "Das Gehoelz besteht hauptsaechlich aus jungen "
    "Baeumen, sowie ein paar Straeuchern und etwas "
    "Farn.");
  AddDetail( ({ "straeucher", "straeuchern" }),
    "Du kennst eigentlich keine davon, jedoch kennst "
    "Du deren Dornen sehr wohl.");
  AddDetail( ({ "dornen" }),
    "Die Dornen wirken aeusserst unangenehm, und scheinen "
    "regelrecht danach zu lechzen, Dich zu stechen.");
  AddDetail( ({ "farn" }),
    "Die grossen, faecherartigen Blaetter sonnen sich "
    "im schwachen Licht, welches durch das Blaetterdach "
    "dringt.");
  AddDetail( ({ "blaetterdach" }),
    "Das Blaetterdach ist ziemlich dicht, und bietet nur "
    "wenige Luecken, durch die Licht bis zum Boden "
    "dringen kann.");
  AddDetail( ({ "luecken", "licht" }),
    "Durch die Luecken im Blaetterdach dringt Licht bis "
    "zum Boden herunter.");
  AddDetail( ({ "blaetter" }),
    "Die Blaetter gibt es hier eigentich an allen Pflanzen.");
  AddDetail( ({ "pflanzen" }),
    "Sie Dich doch einfach um!");
  AddDetail( ({ "boden" }),
    "Am Boden liegen ein paar verwelkte Blaetter, und "
    "abgebrochene Aeste. Dazwischen plaetschert munter "
    "der kleine Quellbach, um nach Westen zu verschwinden.");
  AddDetail( ({ "quellbach", "wasser", "quellbaches" }),
    "Das kristallklare Wasser des Quellbaches fliesst "
    "unaufhaltsam nach Westen.");
  AddDetail( ({ "westen" }),
    "Geh doch einfach hin!");
  AddDetail( ({ "himmel" }),
    "Der Himmel wird fast vollstaendig vom dichten "
    "Blaetterdach abgeschirmt.");

  AddSound(DEFAULT_SOUND, "Du hoerst das leise Plaetschern des "
    "Baches.");
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");

  AddExit("westen", "../room/weg1.lpc");
  SetProp(P_HIDE_EXITS, ({ "westen" }));

  AddCmd( ({ "verlass", "verlasse" }), "do_leave");  
}


int do_leave(string what)
{
  notify_fail("Was moechtest Du verlassen?\n");
  if (member(({"wald", "gehoelz", "dickicht", "holz"}), what)==-1)
   return 0;

  tell_room(ME, BS(TP->Name(WER) 
    + " verlaesst das Gehoelz."), ({ TP }));

  tell_object(TP, BS("Du verlaesst das Gehoelz."));

  TP->move(ANSCHLUSS, M_GO + M_NOCHECK);

  return 1;
}
