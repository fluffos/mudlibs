
#include <properties.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Ufer eines Teiches");

  SetProp(P_INT_LONG,
    "Du befindest Dich auf einem kleinen Pfad, der "
    "entlang des Ufers des Teiches fuehrt. Abseits "
    "des Weges liegt dichter, undurchdringlicher "
    "Wald. ");
  AddDetail( ({ "pfad" }),
    "Der kleine Pfad fuehrt um den Teich herum.");
  AddDetail( ({ "ufer", "ufers" }),
    "Das Ufer ist mit kleinen, runden Steinen uebersaet.");
  AddDetail( ({ "steine", "steinen", "stein" }),
    "Die Steine sind klein und rund. Sie stammen wohl aus "
    "einem Bach.");
  AddDetail( ({ "bach" }),
    "Bach siehst Du hier keinen.");
  AddDetail( ({ "teich", "teiches" }),
    "Der Teich hat eine stattliche Groesse. Seine Oberflaeche "
    "ist ruhig und spiegelt das Firmament wieder.");
  AddDetail( ({ "groesse" }),
    "Stattlich halt.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche ist voellig ruhig.");
  AddDetail( ({ "firmament", "himmel" }),
    "Der Himmel ist strahlend blau, und beinahe wolkenlos.");
  AddDetail( ({ "weg", "weges" }),
    "Der Weg fuehrt Dich wohl rund um den Teich.");
  AddDetail( ({ "wald" }),
    "Der Wald ist hier undurchdringlich.");
  AddDetail( ({ "baeume" }),
    "Die vielen Baeume hier bilden einen Wald.");
  AddDetail( ({ "baum" }),
    "Du bist absolut begeistert. Du hast tatsaechlich "
    "im Wald einen Baum gefunden!");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus fesgetretener Erde.");
  AddDetail( ({ "erde" }),
    "Sie ist schoen braun. Ist wohl ziemlich lange in "
    "der Sonne gelegen.");
  AddDetail( ({ "sonne" }),
    "Die Sonne wird gerade von einer Wolke verdeckt.");
  AddDetail( ({ "wolke" }),
    "Na eigentlich ist der Himmel doch wolkenlos.. also "
    "ist die Sonne wohl einfach grad nicht da.");

  AddExit( "osten", "./ufer2.lpc");
  AddExit( "suedwesten", "./damm1.lpc");
}
