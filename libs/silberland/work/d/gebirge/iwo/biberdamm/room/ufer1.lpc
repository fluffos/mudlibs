
#include <defines.h>
#include <moredef.h>
#include <properties.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT,
    "Am Ufer eines Teiches");

  SetProp(P_INT_LONG,
    "Hier bildet der sonst recht dichte Wald eine "
    "etwas groessere Lichtung. Ein kleiner, relativ "
    "ausgetretener Pfad, fuehrt entlang des Ufers "
    "eines kleines Teiches. Hier endet auch der kleine "
    "Bach, und verbindet sich mit dem Wasser des "
    "Teichs.");

  AddDetail( ({ "wald", "stelle" }),
    "An dieser Stelle scheit der Wald etwas weniger "
    "dicht.");
  AddDetail( ({ "gehoelz" }),
    "Das Gehoelz sind niedere, kleinere Pflanzen.");
  AddDetail( ({ "pflanzen" }),
    "Kleine Baeume und Farne.");
  AddDetail( ({ "baeume" }),
    "Baeume gibt es hier viele. Einer traegt "
    "einen Pfeil nach Osten.");
  AddDetail( ({ "pfeil" }),
    "Der Pfeil ist in die Rinde eines Baumes "
    "geschnitzt, und zeigt nach Osten.");  
  AddDetail( ({ "farne" }),
    "Diverse Farne sonnen sich im spaerlichen "
    "Licht.");
  AddDetail( ({ "licht" }),
    "Hier auf der Lichtung gibt es mehr davon, als "
    "im uebrigen Wald.");
  AddDetail( ({ "pfad" }),
    "Der kleine Pfad scheint von Tieren zu stammen.");
  AddDetail( ({ "tiere", "tieren", "tier" }),
    "Schau Dich doch einfach um!");
  AddDetail( ({ "ufer", "ufers" }),
    "Das Ufer des kleinen Teiches ist mit "
    "kleinen Steinen gesaet.");
  AddDetail( ({ "steine", "stein" }),
    "Die Stein sind ziemlich rund, und stammen "
    "von dem kleinen Bach, der hier in den Teich "
    "muendet.");
  AddDetail( ({ "bach", "baches" }),
    "Der Bach kommt oestlich aus dem Wald, und muendet "
    "hier in den Teich.");
  AddDetail( ({ "teich" }),
    "Das Wasser des Teiches ist absulut klar. Kaum eine "
    "Welle regt sich auf der spiegelnden Oberflaeche.");
  AddDetail( ({ "welle", "wellen" }),
    "Nur hie und da durchbricht ein kleines Tier die "
    "sonst ruhige Oberflaeche, und schlaegt dabei Wellen.");
  AddDetail( ({ "oberflaeche", "flaeche" }),
    "Die Oberflaeche spiegelt den Himmel und Teile des "
    "Waldes.");
  AddDetail( ({ "grund" }),
    "Die Oberflaeche spiegelt zu sehr.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht hier aus fester Erde.");
  AddDetail( ({ "erde" }),
    "Du kannst kleine Spuren erkennen.");
  AddDetail( ({ "spuren" }),
    "Leider hast Du sie zertrampelt, als Du hier "
    "angekommen bist.");
  AddDetail( ({ "wasser" }),
    "Das Wasser ist kristall klar.");
  AddDetail( ({ "lichtung" }),
    "Die Lichtung hier ist nicht gerade klein, und "
    "beherbergt einen stattlichen Teich.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist strahlend blau.");

  SetProp(P_HIDE_EXITS, ({ "osten" }));

  AddExit( ({ "osten" }), "./weg1.lpc");
  AddExit( ({ "nordwesten" }), "./ufer2.lpc");
  //AddExit( ({ "suedwesten" }), ",/ufer1.lpc");

}

