
#include <properties.h>
#include <defines.h>
#include <moredef.h>

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Uter eines Teiches");

  SetProp(P_INT_LONG,
    "Du stehst auf einem kleinen Biberdamm. Westlich von Dir "
    "fliesst durch einen kleinen Durchlass im Damm etwas Wasser "
    "weiter und bildet neuerlich einen Bach, waehrend westlich "
    "von Dir die stille Oberflaeche des aufgestauten Teiches "
    "liegt.");

  AddDetail( ({ "biberdamm", "damm" }),
    "Die Biber haben hier Zweige, Aeste und Blaetter fein saeuberlich "
    "in einander verkeilt, so dass sie einen nahezu "
    "wasserundurchlaessigen Damm bilden.");
  AddDetail( ({ "zweige", "aeste", "blaetter", "aesten", "zweigen" }),
    "Die Aeste, Zweige und Blaetter stammen wohl von den "
    "umliegenden Baeumen.");
  AddDetail( ({ "baeume", "baeumen" }),
    "Baeume siehst Du hier am Damm keine, ausser vielleicht ein "
    "paar Teile davon im Biberdamm.");
  AddDetail( ({ "teile" }),
    "Teile von Baeumen halt.");
  AddDetail( ({ "durchlass" }),
    "Der Durchlass ist gerade so gross, dass soviel Wasser "
    "raus fliesst, wie an einer anderen Stelle rein.");
  AddDetail( ({ "wasser" }),
    "Das Wasser ist kristallklar.");
  AddDetail( ({ "bach" }),
    "Der Bach ist nicht besonders breit, und verliert sich irgendwo "
    "im Westen.");
  AddDetail( ({ "biber" }),
    "Es ist wohl gerade kein Biber da.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus verflochtenen Aesten und Zweigen.");
  AddDetail( ({ "stelle" }),
    "An einer anderen Stelle halt.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist auch hier strahlend blau und beinahe wolkenlos.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche ist seelenruhig.");
  AddDetail( ({ "teich", "teiches" }),
    "Der Teich stattlicher Groesse entstand wohl dadurch, dass "
    "ein paar schlaue Biber einen Damm gebaut haben, in dem "
    "sie wohl ihr Nest haben.");
  AddDetail( ({ "nest" }),
    "Der hiesige Damm ist wohl das Nest der Biber.");
  AddDetail( ({ "groesse" }),
    "Recht passabel. Sicher gross genug, um eine Runde darin "
    "zu schwimmen.");
  AddDetail( ({ "runde" }),
    "Schwimm halt einfach eine!");


  AddExit("nordosten", "./ufer3.lpc");
  AddExit("sueden", "./damm2.lpc");
}
