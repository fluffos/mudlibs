
#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

#define OPPOSITE "/d/gebirge/iwo/biberdamm/room/ufer4.lpc"

inherit "std/room";

mapping stoned = ([]);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Ufer eines Teiches");

  SetProp(P_INT_LONG,
    "Du befindest Dich am Ufer eines Teiches. "
    "Der kleine Pfad auf dem Du Dich befindest "
    "fuehrt einerseits entlang des Ufers, waehrend "
    "er auf der anderen Seite an den Wald grenzt.");

  AddDetail( ({ "ufer", "ufers" }),
    "Das Ufer ist mit Steinchen gesaeumt.");
  AddDetail( ({ "steinchen" }),
    "Die Steinchen sind kugelrund. Nur ein Stein "
    "ist vollkommen flach.");
  AddDetail( ({ "stein" }),
    "Den kann man sicher wunderbar werfen.");
  AddDetail( ({ "pfad", "boden" }),
    "Der Pfad besteht aus fester Erde.");
  AddDetail( ({ "erde" }),
    "Die Erde hier ist braun und fest.");
  AddDetail( ({ "teich", "teiches" }),
    "Das klare Wasser des Teiches spiegelt "
    "die Umgebung wieder.");
  AddDetail( ({ "umgebung" }),
    "Schau Dich doch einfach um!");
  AddDetail( ({ "wasser" }),
    "Das Wasser ist vollkommen klar, und absolut "
    "ruhig.");
  AddDetail( ({ "seite" }),
    "Auf einer Seite befindet sich der Teich, auf "
    "der anderen Wald.");
  AddDetail( ({ "wald" }),
    "Die Baeume stehen hier viel zu dicht, um in "
    "den Wald zu gehen.");
  AddDetail( ({ "baum", "baeume" }),
    "Die Baeume bilden hier eine Lichtung.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist strahlend blau.");
  AddDetail( ({ "lichtung" }),
    "Die Lichtung bietet reichlich Platz fuer den "
    "Teich, und den ihn umgebenden Pfad."); 
  AddDetail( ({ "platz" }),
    "Davon gibt es huer reichlich.");

  AddCmd( ({ "werf", "werfe", "wirf" }), "do_throw");

  AddExit("suedosten", "./ufer1.lpc");
  AddExit("westen", "./ufer3.lpc");

}

int f_living(object lv)
{
  return living(lv);
}
 

int do_throw(string what)
{
  object *livings;
  int lc;

  notify_fail("Was willst Du werfen?\n");
  if (what != "stein") return 0;

  if (member(stoned, TP))
    {
      tell_object(TP, BS("Einen weiteren Stein "
        "moechtest Du jetzt nicht werfen."));
      return 1;
    }

  stoned += ([ TP ]);

  tell_room(ME, BS(TP->Name(WER) + " wirft gekonnt "
    "einen Stein, der huepfend die Wasserflaeche "
    "ueberquert."), ({ TP }));
  tell_object(TP, BS("Gekonnt wirfst Du den Stein "
    "so, dass er huepfend die Wasseroberflaeche "
    "ueberquert."));

  call_other(OPPOSITE, "???");

  livings = filter_array(all_inventory(find_object(OPPOSITE)), "f_living");

  lc = sizeof(livings);

  if (lc <= 0) return 1;

  SetProp(P_KILL_NAME, "Ein Stein von " + TP->Name(WEM));

  lc = random(lc); // Zufaellig eines der livings waehlen

  tell_room(ME, BS("Ein lauter Schrei dringt vom anderen Ufer des Teiches."));
  tell_room(OPPOSITE, BS("Ein Stein ueberquert huepfend den Teich, und "
    "trifft " + livings[lc]->name(WEN) + " am Kopf."), ({ livings[lc] }));

  tell_object(livings[lc], BS("Ein Stein ueberquert huepfend den Teich "
    "und trifft Dich am Kopf."));

  livings[lc]->do_damage(5);

  tell_object(livings[lc], BS("Du fluchst lautstark, und wirfst den Stein "
    "mit voller Kraft zurueck."));

  tell_room(OPPOSITE, BS(livings[lc]->Name(WER) + " wirft den Stein "
    "lautstark fluchend zurueck."), ({ livings[lc] }));

  tell_room(ME, BS("Der Stein kommt in hohem Bogen zurueck, und trifft "
    + TP->name(WEN) + " am Kopf."), ({ TP }));

  tell_object(TP, BS("Der Stein kommt in hohem Bogen zurueck und trifft "
    "Dich am Kopf."));
  TP->do_damage(5+random(5));

  tell_room(OPPOSITE, BS("Ein lauter Schrei schallt vom anderen "
    "Ufer des Teiches."));

  return 1;
}


void reset()
{
  stoned = ([]);
  ::reset();
}
