#include <combat.h>
#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>
#include <mnpc.h>

inherit "std/mnpc";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  create_default_npc(10);

  AddId(({ "schweinebiene", "biene" }));

  SetProp(P_NAME, "Schweinebiene");
  SetProp(P_SHORT, "Eine Schweinebiene");
  SetProp(P_LONG,
    "Die Schweinebiene hat einen saftig gruenen, dicken "
    "Bauch, an dessen Unterseite vier kraeftige blaue "
    "Stummelfuesschen regungslos baumeln. Viel zu kleine "
    "Fluegelchen halten das skurrile Wesen mehr oder "
    "weniger in der Luft, waehrend ein haariger Ringelschwanz "
    "das Gleichgewicht zu der knolligen rosa Ruesselnase "
    "haaelt. Ein riesiger, zahnloser Mund durchschneidet "
    "die massigen Bartstoppel mit breitem Grinsen. "
    "Zwei fette, schwarze Fluegen haengen weit bis in die "
    "riesigen nach oben gerichteten Kulleraugen herein, und "
    "verleihen dem Tier ein leicht duemmliches Aussehen.");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 200000);
  SetProp(P_HANDS, ({ " mit ihren Fuehlern", 100, DT_BLUDGEON }));
  SetProp(P_ALIGN, 100);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Schweinebiene");
  SetProp(P_ARTICLE, 1);

  SetProp(P_MSGIN, "stuermt gemuetlich herein");
  SetProp(P_MSGOUT, "huepft fliegend");
  SetProp(P_MMSGIN, "faellt vom Boden");
  SetProp(P_MMSGOUT, "taucht im Nichts auf"); 
 
  SetProp(P_REJECT, REJECT_DROP);
  SetChats(5, 
    ({ ME->Name(WER) + " flattert seelenruhig aufgeregt umher.\n" }),
    ({ ME->Name(WER) + " summt eine duemmliche Melodie.\n" }),
    ({ ME->Name(WER) + " schnuppert neben einer Blune.\n" }));

  SetAttackChats(30,
    ({ ME->Name(WER) + " sticht Dich mit ihrem Ruessel.\n" }),
    ({ ME->Name(WER) + " quietscht vergnuegt.\n" }),
    ({ ME->Name(WER) + " wackelt mit ihrem Ringelschwanz.\n" }));

  SetProp(P_MNPC_AREA, "/d/gebirge/iwo/normal/");
  SetProp(P_MNPC_FLAGS, MOV_MOVES);
  SetProp(P_MNPC_WAIT, 20);
  
  AddInfo(DEFAULT_INFO, "glotzt Dich duemmlich an.\n");
 
}
