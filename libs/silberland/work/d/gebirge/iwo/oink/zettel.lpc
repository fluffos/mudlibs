
// Es ist ein Ding, also inhereiten wir das einfach mal :)
inherit "/std/thing";

// Wer wird denn da falsche Typen deklarieren?;)
#pragma strict_types

// a bisserl was brauchma
#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <config.h>
#include <ansi.h>
#include <userinfo.h>
#include <exploration.h>
#include <wizlevels.h>


// Im Speicher pack ichs net...
#define TXTFILE "/p/service/iwo/group/doc/zettel.txt"


void create()
{
  ::create();
  seteuid(getuid());
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Zettel");
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 1);
  SetProp(P_LONG, "Darauf steht etwas geschrieben.\n");
  SetProp(P_READ_MSG, "\n@@read_list@@\n");
  AddId(({"zettel"}));
}

string read_list()
{

  TP->More(read_file(TXTFILE));

  return BS(" ");
}

