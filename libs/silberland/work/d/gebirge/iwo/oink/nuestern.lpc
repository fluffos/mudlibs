inherit "std/room";

#include <properties.h>
#include <wizlevels.h>
#include <mnpc.h>
#include <moving.h>
#include <language.h>
#include <attributes.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h> 

object ob; 


void create()
{

  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "An einem seltsamen Ort");
  SetProp( P_INT_LONG,
      "Du befindest Dich in den Nuestern des getupften Drachen. "
      "Der Drache ist so unglaublich gross, dass leicht mehrere "
      "Leute Platz haben hier. An den Waenden, die Dich umgeben "
      "kannst Du einige Ablagerungen erkennen.\n");


  SetProp(P_INDOORS,1);

  AddDetail( ({"nuestern", "nase"}),
       "Die Nuestern sind praktisch die Nase des Drachen. Du "
       "befindest Dich mitten darin.");
  AddDetail( ({"drache"}),
       "Du siehst den Drachen nicht, da Du ja in ihm bist.");
  AddDetail( ({ "leute", "platz", "personen" }),
       "Mehrere Personen koennen es sich hier herinnen bequem machen.");
  AddDetail( ({ "waende", "innenseite", "wand" }),
       "Eigentlich sind es keine richtigen Waende, sondern die "
       "Innenseite von der Nase. Ein Nasenhaar steht zwischen "
       "den Ablagerungen rum. Einige Ablagerungen fallen Dir auf. "
       "Ausserdem scheint in einer der Waende ein Loch zu sein.");
  AddDetail( ({ "ablagerungen" }),
       "Eine ist besonders auffaellig.");
  AddDetail( ({ "loch" }),
       "Ein kleines Loch ist zu sehen. Vielleicht kannst Du Dich durchzwaengen?");
  AddDetail( ({ "ablagerung"}),
       "Das Gewebe rund um die Ablagerung ist ganz rot. Es "
       "scheint entzunden zu sein.\n"
       "Vielleicht solltest Du den Drachen davon befreien?");
  AddDetail( ({ "gewebe" }),
       "Es muss sehr weh tun.");
  AddDetail( ({ "haar", "nasenhaar"}),
       "Du koenntest ja mal dran zupfen?");
  AddDetail( ({ "decke" }),
       "An der Decke kannst Du eine Oeffnung sehen.");
  AddDetail( ({ "oeffnung" }),
       "Die Oeffnung scheint Dich weiter nach oben zu bringen. Vielleicht kannst Du rauf klettern?");


  AddCmd("befreie", "befreie");
  AddCmd("schabe", "schabe");
  AddCmd( ({"zupf", "zupfe"}), "zupfe"); 
  AddCmd( ({"zwaenge", "zwaeng"}), "zwaenge"); 
  AddCmd( ({"kletter", "klettere"}), "klettere"); 
}

befreie(string str)
    {
    write ("Hmm. So scheint das nicht zu gehen. Vielleicht kannst "
         "Du Sie abschaben?\n");
    return 1;
    }


int IsPopel(object ob)
{
  return ob->id("drachenpopel");
}


object *my_deep_inventory(object ob)
{
  object *myinv;
  object *deepinv;
  int i;

  //tell_object(find_player("iwo"), sprintf("%O\n", ob));

  myinv = all_inventory(ob);

  deepinv = myinv;

  for (i=0; i < sizeof(myinv); i++)
    deepinv += my_deep_inventory(myinv[i]);

  return deepinv; 
  
}


schabe(string str)
    {
    object *popels;


    if (str != "ablagerung von wand" && str != "ablagerung von wand ab" && str != "ablagerung von gewebe ab" && str != "ablagerung von gewebe"  ) 
        {
        write("Was willst du von WO abschaben?\n");
        return 1;
        }

    if(!present("schaufel",TP)) 
        {
        write("Aber Du hast ja garnichts zum Abschaben dabei!\n");
        return 1;
        }
    if(!present("drachenpopel",TP))
        {
        //popels = filter_array(deep_inventory(TP), "IsPopel");

//        popels = ({ filter_array(deep_inventory(), "IsPopel") });
        popels = filter_array(my_deep_inventory(ME), "IsPopel");

        if (find_player("iwo"))
          tell_object(find_player("iwo"), break_string(
            sprintf("Popel: %d (%O)", sizeof(popels), TP),
              78, "OINK: "));

        if (sizeof(popels) >= 5)
          {
            write("Dir ekelt viel zu sehr.\n");
            return 1;
          }

        write("Du schabst mit der Schaufel die Ablagerung ab, und steckst sie ein.\n");
        ob = clone_object("/d/gebirge/iwo/oink/popel");
        if (ob->move(TP) == ME_TOO_HEAVY)
            {
            write ("Der Popel ist Dir zu schwer.\n");
            ob->remove();
            }
            else
            {
                say (capitalize(TPN)+" scheint etwas gefunden zu haben.\n", TP);
            }
         }
         else write("Du kannst leider nichtsmehr abschaben.\n");   

    return 1;
    }



zupfe(string str)
    {

    if (str != "an nasenhaar" && str != "an haar" ) 
        {
        write("WORAN willst zu zupfen?\n");
        return 1;
        }

        SetProp(P_KILL_NAME, "Ein Feuerstoss des getupften Drachen");
        write("Der Drache blaest Dich mit einem Feuerstoss wieder heraus.\n");
        say(TP->Name() + " wird von dem Drachen mit einem Feuerstoss wieder herausbefoerdert.\n"); 
        this_player()->move(environment(find_living("oink")), M_NOCHECK);
        if(present("drachenpopel",TP))
            { 
            call_other("/d/gebirge/iwo/oink/drachi", "has_done", TP->Name());
            write("Oink ruft: " + TP->Name() + " hat mich von meiner Qual erloest !\n");
            }
        TP->do_damage(50);

    return 1;
    }


int zwaenge(string str)
    {
    if (!stringp(str) || str=="")
        {
        write("WO willst Du Dich reinzwaengen?\n");
        return 1;
        }
    if (str=="in loch"||str=="durch loch"||str=="in loch rein")
        {
        write("\nDu plumpst durch die Speiseroehre in den Magen.\n\n");
        tell_room(ENV(TP),  PL->Name() + " veschwindet.\n",  ({TP}));

        TP->move("/d/gebirge/iwo/oink/magen", M_NOCHECK + M_SILENT);

        }
     else
        {
        write("WO willst Du Dich reinzwaengen?\n");
        return 1;
        }
     return 1;
     } 


int klettere(string str)
    {
    if (!stringp(str) || str=="")
        {
        write("WOHIN willst Du klettern?\n");
        return 1;
        }
    if (str=="rauf"||str=="in oeffnung"||str=="durch oeffnung"||str=="nach oben")
        {
        write("\nKletterst durch Die Oeffnung nach oben.\n\n");
        tell_room(ENV(TP),  PL->Name() + " veschwindet nach oben.\n",  ({TP}));

        TP->move("/d/gebirge/iwo/oink/augen", M_NOCHECK + M_SILENT);

        }
     else
        {
        write("WOHIN willst Du klettern?\n");
        return 1;
        }
     return 1;
     } 

