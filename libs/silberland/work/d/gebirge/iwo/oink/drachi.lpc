/*
 DEFAULT ROOM: /d/gebirge/iwo/oink/hoehle.c
*/

#pragma strong_types

inherit "/std/mnpc";

#include <properties.h>
#include <wizlevels.h>  
#include <mnpc.h>
#include <moving.h>
#include <language.h>
#include <attributes.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>

#define GOBJ "/p/service/iwo/group/obj/gobj.lpc"
#define HELP "/d/gebirge/iwo/oink/zettel.lpc"

object spieler=0;

void CloneCheck();

void create ()
    {
    if (!is_clone(TO)) return; 
    ::create();

    create_default_npc(100);

    enable_commands();

    AddId( ({ "drachi", "iwodrachi", "drache", "oink" }) );

    set_living_name("drachi");


    SetProp(P_NAME, "Oink");
    SetProp(P_MSGIN, "kommt an.\nDu zitterst am ganzen Leib");
    SetProp(P_MSGOUT, "geht#.\nDir faellt ein Stein vom Herzen");
    SetProp(P_MMSGOUT, "verschwindet vor Deinen Augen");
    SetProp(P_GENDER, MALE );
    SetProp(P_RACE, "Drache");
    SetProp(P_MAX_HANDS, 6);
    SetProp(P_TEMPERATURE_RANGE, ([0:-10, 1:50]));

    SetProp(P_HANDS, ({" mit seinen Klauen", 1000, DT_RIP }) );
    SetProp(P_BODY, 1000);
    SetProp(P_XP, 0);
    SetProp(P_TRANSPARENT, 0);
    SetProp(P_WEIGHT, 8000000);
    SetProp(P_SIZE, 100000);

    SetProp(P_SHORT, "Oink der getupfte Drache");
    SetProp(P_NAME_ADJ, "getupft");
    AddAdjective( ({"lila", "gruen"}) );
    SetProp(P_ALIGN, 800);
    SetProp(P_RESISTANCE_STRENGTHS, ([DT_UNHOLY:-1]) );

    SetProp(P_NOATTACK, "lacht sich fast tot.");

    /* ab in den startraum */
    TO->move("/d/gebirge/iwo/oink/hoehle.lpc", M_NOCHECK);

    /* und dann gemma :) */
    SetProp(P_MNPC_DEFAULTROOM, "/d/gebirge/iwo/oink/hoehle.lpc");
    SetProp(P_MNPC_AREA, "/" );
    SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
//    SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS + MOV_SPECIAL);
    /* backwards raus, damit er mehr rumkommt */
    SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_SPECIAL);
    
    SetChats(3, ({
             "Der Drache sabbert auf den Boden.\n",
             "Der Drache pustet Dir ins Ohr.\n",
             "Der Drache schleckt Dich ab.\n",
             "Der Drache knuddelt Dich.\n",
             "Der Drache faucht Dich an. Du bekommst eine Gaensehaut.\n",
             "Der Drache blaest heisse Luft aus den Nuestern. Der Luftdruck weht Dich fast um.\n",
             "Der Drache speit einen gewaltigen Feuerstrahl gen Himmel.\n",
             "Der Drache knabbert zaertlich an Deinem Ohr.\n",
             "Der Drache pustet Dir zaertlich aus den Nuestern in den Nacken.\n",
             "Ein wohliges Gefuehl ueberkommt Dich in der Gegenwart des Drachen.\n"
                           }) );



    SetProp(P_LONG,
      "Du erschauderst vor Ehrfurcht, als Dir der riesige Drache "
      "in die Augen blickt und Dampf aus seinen Nuestern blaest. "
      "Er ist ueber und ueber mit Schuppen bedeckt, welche die meisten "
      "Zauber und den meisten physischen Schaden abwehren. Seine "
      "Klauen sind so gross wie ein Kurzschwert und so scharf, dass "
      "sie alles zerreissen koennen, was in ihre Naehe kommt. Sein "
      "Schwanz laeuft in eine gefaehrliche Hornspitze aus, die schon "
      "so manchen Helden, der sich zuviel zutraute, in zwei Haelften "
      "geteilt hat.");


    AddDetail( ({ "ehrfurcht", "furcht" }),
      "Du kniest zitternd nieder vor dem Drachen.");
    AddDetail( ({ "augen", "auge" }),
      "Sie funkeln, dass Du davonlaufen moechtest vor Angst.");
    AddDetail( ({ "dampf", "weg", "feuer" }),
      "Der Drache kann wohl Feuer spucken. Du solltest ihm aus dem Weg gehen.");
    AddDetail( ({ "schuppen", "drachenschuppen", "verlangen" }),
      "Ein unglaubliches Verlangen nach Drachenschuppen ueberkommt Dich.");
    AddDetail( ({ "zauber", "zaubern" }),
      "Er kann allen Zaubern widerstehen.");
    AddDetail( ({ "schaden" }),
      "Der Schaden, den er Dir zufuegen koennte ist enorm.");
    AddDetail( ({ "klauen" }),
      "Die Klauen sind riesig und unglaublich scharf.");
    AddDetail( ({ "kurzschwert", "schwert" }),
      "Ein Schwert.");
    AddDetail( ({ "naehe" }),
      "In der Naehe des Drachen fuerchtest Du Dich.");
    AddDetail( ({ "schwanz" }),
      "Pfui!");
    AddDetail( ({ "hornspitze" }),
      "Die Hornspitze floesst Dir enorme Furcht ein.");
    AddDetail( ({ "helden", "held" }),
      "Du bist keiner von ihnen.");
    AddDetail( ({ "haelften", "haelfte" }),
      "Vielleicht liegen ja noch welche rum?");
    AddDetail( ({ "nuestern", "nuester" }),
      "Die Nuestern sind so gross, dass Du reinklettern koenntest.");
    AddDetail( ({ "after", "arschloch", "arsch" }),
      "Das After ist das Ausscheidungsorgan des Drachen.");
    AddDetail( ({ "ausscheidungsorgan", "organ" }),
      "So genau moechtest Du das eigentlich garnicht wissen.");


    AddCmd( ({"klettere", "kletter"}), "klettere");
    AddCmd( ({"krieche", "kriech", "zwaenge", "zwaeng" }), "krieche");

    CloneCheck();   

}


int klettere(string str)
    {
    if (!stringp(str) || str=="") 
        {
        write("WOHIN willst Du klettern?\n");
        return 1;
        }
    if (str=="in nuestern")
        {
        this_player()->move("/d/gebirge/iwo/oink/nuestern", M_GO, "in Die riesigen Nuestern des Drachens."); 

        /*
        SetProp(P_KILL_NAME, "Die Nuestern des getupften Drachen\n");
        TP->do_damage(50);
        write("Der Drache blaest Dich mit einem Feuerstoss wieder heraus.\n");
        say(TP->Name() + " wird von dem Drachen mit einem Feuerstoss wieder herausbefoerdert.\n");
        */
        }
     else
        {
        write("WOHIN willst Du klettern?\n");
        return 1;
        }
     return 1;
     }


int krieche(string str)
    {
    if (!stringp(str) || str=="") 
        {
        write("WOHIN willst Du kriechen?\n");
        return 1;
        }
    if (str=="in after"||str=="in arsch"||str=="in ausscheidungsorgan")
        {
        tell_object(TP, "Das ist ein Drache, nicht Dein Chef.\n");
        tell_room(ENV(TP),  PL->Name() + " versucht dem Drachen in den Arsch zu kriechen. Dir graust.\n",  ({TP}));

        write_file("/d/gebirge/iwo/oink/arsch.log",
            ctime()+": "+TP->Name(WER)+" hat gerade "+
            "versucht " +name(WEM)+ " in den Arsch zu kriechen.\n");

        }
     else
        {
        write("WOHIN willst Du kriechen?\n");
        return 1;
        }
     return 1;
     }





void die(int poisondeath)
{
  object item;
  write_file("/log/drachen",
     ctime()+": "+this_player()->Name(WER)+" killt "+
     name(WEN)+"\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/log/drachen",
    ctime()+": "+Name(WER)+" hat gerade "+
    player->name(WEN)+ " umgebracht.\n");
}



void remove_me()
{
   object player;
   if(objectp(spieler) && (player=find_player(getuid(spieler))||
      player=find_netdead(getuid(spieler))))
     player->RemovePursuer(ME);
     SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_SPECIAL);
}

void destruct_me()
{
   say("Der Drache schrumpft und klettert in Iwo's Hosentasche.\n");
   ME->remove();
}


void verfolge(object spieler)
{
  string name;
  name=spieler->QueryProp(P_NAME);
  spieler->AddPursuer(ME);
  SetProp(P_MNPC_FLAGS, "");

  ME->move(environment(spieler), M_GO);

  return;
}





void parse2_tell(string str)
{
  string wer, wer2, was, was2;
//  if(objectp(spieler) && spieler!=TP) return;

  if (sscanf(str, "%s sagt: %s %s\n", wer, wer2, was)==3)
   {


    if (wer2!="drachi" && wer2!="drache") return;
    if (was=="komm")
        {
        if (!(spieler=find_player(lower_case(wer))))
            {
            write("Der Spieler ist nicht da!\n");
            return;
            }
            verfolge(spieler);
        }
        if(objectp(spieler) && sscanf(str, "Ploetzlich weicht alles Leben aus %s.\n", wer)==1)
            {
            if(lower_case(wer)==getuid(spieler))
                {
                call_out("remove_me", 0);
                return;
                }
            }
        }
    if (was=="geh")
        {
        call_out("remove_me", 0);
        return;
        }

    if (was=="schrumpf")
        {
        if (wer != "Iwo" && wer != "jemand")
            {
            say("Der blaest heisse Luft aus den Nuestern.\n");
            return;
            }

        say ("Der Drache schnaubt traurig.\n");
        call_out("remove_me",0);
        call_out("desruct_me",0);
        }

    if ((sscanf(str, "%s ruft: %s %s %s\n", wer, wer2, was, was2)==4)
          && (wer2 == "drachi" && was == "bei" && was2 == "fuss"))
        {
        if (!(spieler=find_player(lower_case(wer))))
            {
            write("Der Spieler ist nicht da!\n");
            return;
            }
        else
            {
            verfolge(spieler);
            }
        }

    return;
}


void reset()
{
  ::reset();
  if (!IS_CLONE(TO)) return;
  if(!objectp(spieler)|| !find_player(getuid(spieler)))
    call_out("remove_me",0);
  CloneCheck();
}


void CloneCheck()
{
  string lstr;

  if (find_living("oink") != ME)
    {
      if (find_player("iwo")) 
        tell_object(find_player("iwo"), BS("OINK: Removing clone"));
      lstr = sprintf("%s CLONE DESTRUCT %O", ctime(), ENV(ME));
      if (PO) lstr += sprintf(" PO: %O", PO);
     
      write_file("/d/gebirge/iwo/oink/oink.log", BS(lstr));

      call_out("remove",0);      
    }
}


void init()
{
 ::init();
 if(objectp(spieler) && !find_player(getuid(spieler)))
     call_out("remove_me", 0);
} 


nosave void teile_mit(string msg, object pl) {
  pl->Message(break_string(msg,78,"Oink der getupfte Drache faucht Dir zu: "), MSGFLAG_TELL);
  return;
}



void catch_tell(string str)
{
  string wer, was, *dir, txt;
  object env, pl;
  int cost;
  if(sscanf(str, "%s teilt Dir mit: %s\n", wer, was)==2) {
    if(strstr(lower_case(was), "wo bist du")==-1)
      return ;
    env=ENV(ME);
    if(!interactive(PO)) return;
    PO->do_damage(10+random(5));
    if(!random(100)) {
      teile_mit("Ich sag Dir nicht wo ich bin! *schmoll*", PO);
      return;
    }
    if(!env) {
      teile_mit("Ich weiss nicht wo ich bin. Hier ist irgendwie nichts!",PO);
      return ;
    }
    dir=explode(file_name(env), "/");
    if(dir[0]=="d") {
      teile_mit(sprintf("Ich bin in der Region %s! Ihr nennt den Ort hier "
           "\"%s\".",
            CAP(dir[1]), env->QueryProp(P_INT_SHORT)),PO);
    }
    else if(dir[0]=="players")
      teile_mit("Ich weiss nicht wo ich bin, aber ich bin mir sicher, dass "
          +CAP(dir[1])+" daran schuld ist.",pl);
    else if(dir[0]=="gilden") {
      switch(dir[1]) {
        case "druidenzirkel":
          txt="Ich bin bei den maechtigen Druiden. Hier ist's toll, da bleib "
            "ich! Ich frag mich nur, warum Anvar seine Haende so komisch "
            "bewegt und auf mich deutet?";
          break;
        case "abenteurer":
          txt="Ich bin in einer der Abenteurergilden.";
          break;
        case "berserker":
          txt="Melde gehorsamst: Bin bei Kronang! Werde ihn spalten! *HACK*";
          break;
        case "paladine":
          txt="Bin auf der Paladinburg! Werde mich zu Ayla begeben und "
            "etwas fuer mein Seelenheil opfern. Solltest Du auch tun!";
          break;
        case "zechpreller":
          txt="Jo ich wasch ah net <HICKS> wo isch gerarade bin! SCHECHUS "
            "SCHENK EIN! HEUTE *RUELPS* MACH MA BLAU!";
          break;
        default:
          txt="Ich bin in irgendeiner schwindligen Gilde! Holt mich raus!";
      }
      teile_mit(txt, PO);
    }
    else
      teile_mit("Ich weiss nicht genau wo ich bin ...",PO);
  }
  parse2_tell(str);
  return ;
}


void has_done(string werdenn)
   {
   object ob, zettel, pl;
   
   pl = find_player(lowerstring(werdenn));
   
 
   if (present("\ngobj", pl)) return;
   
   domainshout("Der getupfte Drache ruft: " + werdenn + " hat mich von meiner Qual erloest !\n");

   ob = clone_object(GOBJ);
   zettel = clone_object(HELP);

   ob->move(pl, M_NOCHECK);
   zettel->move(pl, M_NOCHECK);

   tell_object(pl, BS("Der Drache holt tief Luft und blaest Dir einen "
     "Feuerstoss mitten ins Gesicht."));
   tell_room(environment(pl), BS("Der Drache holt tief Luft und blaest "+
     TP->name(WEM) + " einen Feuerstoss mitten ins Gesicht."), ({ pl }));
   tell_object(pl, BS("Ein sengender Schmerz durchfaehrt Dich. Du "
     "greifst Dir ans linke Auge und schreist vor Schmerz."));
   pl->AddHp(-random(20));
   tell_room(environment(pl), BS(TP->Name(WER) + " fasst sich ans linke Auge und "
     "schreit vor Schmerz."), ({ pl }));

   write_file("/d/gebirge/iwo/oink/oink.log",
     sprintf("%s %s Gruppenfunktion hinzugefuegt.\n", ctime(), werdenn));
    
   if (find_player("iwo"))
     tell_object(find_player("iwo"), BS("OINK: Gruppenfkt. fuer " + werdenn));
       
   tell_object(pl, BS("Ein Zettel flattert Dir zu."));
   
   return;
   }

