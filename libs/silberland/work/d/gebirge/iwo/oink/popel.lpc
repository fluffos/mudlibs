inherit "std/food";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <moredef.h>
#include <defines.h>
#include <food.h>

#define NR_MELDUNGEN 16
#define MELDUNGEN \
  ({ \
     "eine Giraffe", \
     "einen Elefanten", \
     "etwas Unidentifizierbares", \
     "ein Nilpferd", \
     "einen Mini-Drachen", \
     "ein Abbild von Dir", \
     "einen Angrox", \
     "ein Wildschwein", \
     "einen Laubfrosch", \
     "einen Fraggle", \
     "einen Baeren", \
     "einen Adler", \
     "eine Wuestenspringmaus", \
     "eine Schale", \
     "einen Hut", \
     "etwas Sinnloses", \
     "", \
  })


create()
{
  if (!IS_CLONE(TO)) return;
  ::create();
 
  SetProp( P_SHORT, "Ein Drachenpopel" );
  SetProp( P_LONG, "Das ist ein ganz besonders dicker Drachenpopel.\n" );
  AddId( ({ "drachenpopel", "ablagerung", "popel" }) );
  SetProp( P_NAME, "Drachenpopel" );
  SetProp( P_GENDER, MALE );
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);

  SetProp(P_FOOD_INFO, ([F_HEAL : ({30, 10}), F_SOAK : 2, F_POISON : 1,
        F_MSG:"Du verzehrst den Drachenpopel. Dir ekelt.\n",
        F_MSG_ROOM:"isst einen Drachenpopel. Du wendest Dich angewidert ab.\n"]));


        AddCmd(({"knete","knete", "forme"}),"kneten");
        AddCmd(({"schnippe", "schnip", "schnipp"}),"schnippen");
        AddCmd(({"schnalz", "schnelle", "schnalze", "schnell"}),"schnalzen");
}

essen( str )
{
  if( !str || !id(str) ) return 0;
  say( PL->name(WER) +
         " ruft mit verstopftem Mund: BOAH, IST DAS EKLIG!\n"
  );
  write( "Du rufst: BOAH, IST DAS EKLIG!\n" );
  destruct( this_object() );
  return 1;
} 


int kneten(string str)
    {
    string ausgabe;
    ausgabe = MELDUNGEN[random(NR_MELDUNGEN-1)];
    notify_fail ("Was willst Du kneten ?\n");
    if ( !str ) return 0;
    if ( member( ({"popel"}),str) !=-1 )
        {
        write("Du formst " + ausgabe + " aus einem Popel.\n");
        say (""+TP->Name()+" formt " + ausgabe + " aus einem Popel.\n");
        return 1;
        }
    return 0;
    }

int schnippen(string str)
    {
    string ausgabe;
    notify_fail ("Was willst Du schnippen ?\n");
    if ( !str ) return 0;
    if ( member( ({"popel"}),str) !=-1 )
        {
        write("Du schnippst den Popel senkrecht in die Luft und faengst ihn wieder.\n");
        say (""+TP->Name()+" schnippt einen Popel senkrecht in die Luft und faengt ihn wieder.\n");
        return 1;
        }
    return 0;
    }


schnalzen( str )
{
  string wen, mitwas;
  if (!str) return 0;
  if( sscanf( str, "%s mit %s", wen, mitwas )==2 ) return schnalz_exec( wen, mitwas );
  return 0;
}

schnalz_exec( wen, mitwas )
{
  object target, look;

  if( !(target = present(wen,environment(PL))) || !living(target) )
  {
    write( "Es gibt hier niemanden, der "+capitalize(wen)+" heisst.\n" );
    return 1;
  }



  tell_object(TP, "Du ziehst den Popel in die Laenge und zielst " +
        "auf " +target->name(WEM,1) + ".\n" +
        "Du laesst das hintere Ende des Popels los und " +
        "es schnellt nach Vorne.\n" +
        "Der Popel trifft " + target->name(WEM,1) + " mitten " +
        "ins Gesicht. Wie grauslig!\n");
  tell_room(ENV(TP),  PL->Name() + " zieht einen Popel in die Laenge und " +
       "zielt auf " +target->name(WEM,1) + ".\n" +
       PL->Name() + " laesst das hintere Ende des Popels " +
       "los und es schnellt nach Vorne.\n" +
       "Der Popel trifft " +target->name(WEM,1) + " mitten " +
       "ins Gesicht. Wie grauslig!\n", ({TP, target}));
  tell_object( target,  PL->Name() + " zieht einen Popel in die Laenge und " +
       "zielt auf Dich.\n" +
       PL->Name() + " laesst das hintere Ende des Popels " +
       "los und es schnellt nach Vorne.\n" +
       "Der Popel trifft Dich mitten " +
       "ins Gesicht. Wie grauslig!\n");
       
  return 1;
} 
