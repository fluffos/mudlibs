inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <moving.h>

int dauer;
int dam;
object owner;
void do_stinkihaufi();
string *haufiadj=({"stinkend", "grausig", "fluessig", "fest", "schwarz", 
    "braun", "hellbraun", "halbfest", "dampfend", "klein", "gross", 
    "rauchend", "schirch"});

create()
{
  if (!is_clone(ME)) return;
  ::create();
  dauer=0;
  dam=20+random(10);
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  AddId (({"\nhaufigenerator"}));
  SetProp(P_KILL_NAME, "Durchfall");
  SetProp(P_KILL_MSG, "Durchfaeller wird man klug!");
  set_next_reset(600);
  owner=0;
}

init() {
  ::init();
}


void reset() {
  if(!MENV || !query_once_interactive(MENV) ||
      !ENV(MENV))
  {
    remove();
    return;
  }
  do_stinkihaufi();
  dam-=5;
  if(dam<1) {
    tell_object(ENV(ME), "Dein Durchfall laesst nach.\n");
    remove();
  }
  set_next_reset(600);
  return;
}

void do_stinkihaufi() {
  object ob;
  string adj;
  if(!MENV || !query_once_interactive(MENV)) {
    remove();
    return;
  }
  ob=clone_object("/d/ebene/lamuerte/own/obj/haufi");
  ob->SetProp(P_SHORT, "Ein Haufi von "+MENV->name());
  adj=haufiadj[random(sizeof(haufiadj))];
  ob->SetProp(P_SHORT, "Ein "+adj+"es Haufi von "+MENV->name());
  ob->SetProp(P_NAME_ADJ, adj);
  ob->move(ENV(MENV), M_NOCHECK);
  tell_room(ENV(MENV), BS(sprintf("%s kann sich nicht beherrschen und "
          "macht ein %ses Haufi.", MENV->Name(), adj)), ({MENV}));
  tell_object(MENV, BS("Dein Durchfall laesst Dich ein "+adj+"es Haufi machen!"));
  catch(MENV->do_damage(dam+random(dam)));
}

int more_haufi(int x) {
  tell_object(ENV(ME), "Dein Durchfall wird staerker!\n");
  dam+=x;
  if(dam > 100) dam=100;
  return 1;
}
