inherit "std/room";

#include <properties.h>
#include <wizlevels.h>
#include <mnpc.h>
#include <moving.h>
#include <language.h>
#include <attributes.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h> 

object ob; 


void create()
{

  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "An einem seltsamen Ort");
  SetProp( P_INT_LONG,
      "Du befindest Dich im Magen des getupften Drachen. "
      "Magensaeure befindet sich ueberall und versucht Dich "
      "zu zersetzen. Du moechtest schnell raus hier.\n"
      "Es kommt Dir vor, als koenntest Du am Grund des Magens "
      "etwas erkennen."); 


  SetProp(P_KILL_NAME, "Magensaeure");
  SetProp(P_INDOORS,1);

  AddRoomMessage( ({ "\nDie Magensaeure zersetzt Dich.\n" }),
                        15, "my_do_damage" );


  AddDetail( ({"drache", "drachen"}),
       "Du siehst den Drachen nicht, da Du ja in ihm bist.");
  AddDetail( ({"grund", "etwas", "boden", "ausgang", "oeffnung"}),
       "Unter Dir befindet sich die untere Oeffnung des Magens.\n"
       "Vielleicht kannst Du Dich in den Darm zwaengen?");
  AddDetail( ({"darm", "verdauungstrakt", "trakt"}),
       "Der Darm ist der Verdauungstrakt des Drachen.");
  AddDetail( ({"magen"}),
       "Im Magen zersetzt der Drachen seine Nahrung.");
  AddDetail( ({"nahrung"}),
       "Das bist anscheinend Du moemtan.");
  AddDetail( ({"saeure", "magensaeure"}),
       "Sie ist ziemlich aetzend. Du solltest von hier verschwinden.");

  AddCmd( ({"zwaenge", "zwaeng"}), "zwaenge"); 
}


zwaenge(string str)
    {

    if (str != "in darm" && str != "in oeffnung" && str != "durch oeffnung"
        && str != "in trakt" && str != "in verdauungstrakt") 
        {
        write("WO moechtest Du Dich reinzwaengen?\n");
        return 1;
        }

        tell_object(TP, "\nDu zwaengst Dich in die Gedaerme und plumpst beim After raus.\n\n");
        tell_room(ENV(TP),  PL->Name() + " geht unter und verschwindet.\n",  ({TP})); 

        if(present("drachenpopel",TP))
            { 
            call_other(find_living("oink"), "has_done", TP->Name());
            write("Oink ruft: " + TP->Name() + " hat mich von meiner Qual erloest !\n\n");
            }
        this_player()->move(environment(find_living("oink")), M_NOCHECK + M_SILENT);
        tell_room(ENV(TP),  PL->Name() + " zwaengt sich aus dem After des Drachens.\n",  ({TP})); 

    return 1;
    }

void my_do_damage()
    {
    TP->do_damage(10);
    return;
    }

