inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <defines.h>
#include <moredef.h>


mapping zahler = ([]);

create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "In einer Hoehle");
  SetProp (P_INT_LONG, "Du befindest Dich in einer riesigen Hoehle. "
    "Die Abdruecke am Boden lassen erkennen, dass hier ein riesiges "
    "Tier hausen muss. Hie und da faellt ein Wassertropfen "
    "von der Decke auf den Boden. Nahe der Wand am Boden befindet "
    "sich eine kleine Plattform.");

  AddDetail("hoehle", "Du stehst mitten in der dunklen Hoehle.\n");
  AddDetail( ({"abdruecke" }),
    "Sie scheinen von einem sehr grossen Tier zu stammen.");
  AddDetail( ({"boden"}),
    "Er ist uebersaet mit Abdruecken, in denen sich Wasser gesammelt hat.");
  AddDetail( ({"tier"}),
    "Du bist nicht sicher, ob Du ihm begegnen solltest.");
  AddDetail( ({"wassertropfen", "tropfen"}),
    "Sie fallen von der Decke zum Boden.");
  AddDetail( ({"wasser"}),
    "Kleine Pfuetzen in riesigen Abdruecken.");
  AddDetail( ({"pfuetzen"}),
    "Scheinbar kommt das Wasser von der Decke.");
  AddDetail( ({"decke"}),
    "Sie ist so weit oben, dass Du sie kaum erkennen kannst.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind schroff und verkarstet. An einer der Waende erkennst "
    "Du einen merkwuerdigen Schlitz.");
  AddDetail( ({"schlitz"}),
    "Hmmm... vielleicht kann man da ja was reinwerfen?");
  AddDetail( ({"plattform"}),
    "Ob man sich da wohl draufstellen kann?");

  AddExit("raus", "/d/gebirge/eros/room/berg_w12");
//  AddExit("beammeup", "/d/huegelland/iwo/plattform/room/room_a05");

  AddCmd( ({ "steige", "stelle", "steig", "stell" }), "stellen");
  AddCmd( ({ "wirf", "werfe" }), "werfen");

  AddItem("/d/gebirge/iwo/oink/drachi", REFRESH_DESTRUCT);

}                                        



int stellen (string str)
{
  notify_fail("WO willst Du dich hinstellen?\n");
  if (!str) return 0;

  if (str != "auf plattform") return 0;

  tell_object(TP, BS("Du stellst Dich auf die kleine Plattform."));
  tell_room(ME, BS(TP->Name(WER) + " stellt sich auf eine kleine Plattform."),
            ({ TP }));

  if (!member(zahler, getuid(TP)) 
      && getuid(TP) != "teiresias" 
      && getuid(TP) != "iwo"
      && TP->QueryProp(P_MARRIED) != "teiresias"
      && TP->QueryProp(P_MARRIED) != "iwo")
    {
      tell_object(TP, BS("Nachdem nichts passiert, steigst Du enttaeuscht " +
                         "wieder herunter."));
      tell_room(ME, BS(TP->Name(WER) + " steigt enttaeuscht wieder herunter."),
                ({ TP }));
      return 1;
    }

  if (zahler[getuid(TP), 0] < TP->QueryProp(P_LEVEL)
      && getuid(TP) != "teiresias" 
      && getuid(TP) != "iwo"
      && TP->QueryProp(P_MARRIED) != "teiresias"
      && TP->QueryProp(P_MARRIED) != "iwo")
    {
      tell_object(TP, BS("Scheinbar war das nicht genug. Seufzend steigst Du " +
                         "wieder herunter."));
      tell_room(ME, BS(TP->Name(WER) + " steigt seufzend wieder "
                       "herunter."), ({ TP }));
     
      return 1;
    }


  return TP->move("/d/gebirge/iwo/seherhaus/seherhaus", 
                  M_GO, 0, "verschwindet spurlos", 
                  "kommt herein");
  
  zahler -= ([getuid(TP)]);

  return 1;
}
  

int werfen(string str)
{
  int menge;
  object rumpelkammer;

  rumpelkammer = find_object("/d/gebirge/iwo/seherhaus/rumpelkammer");

  notify_fail("WIEVIEL von WAS moechtest Du WOHIN werfen?\n");
  if (!str) return 0;

  if (sscanf(str, "%d muenzen in schlitz", menge) != 1) return 0;

  notify_fail("Soviele Muenzen hast Du aber garnicht!\n");
  if (TP->QueryMoney() < menge) return 0;
  else 
    {
      TP->AddMoney(-menge);
//      rumpelkammer->AddMoney(menge);

    }
    

  zahler[getuid(TP), 0] += menge;

  tell_object(TP, BS("Du wirfst " + menge + " Muenzen in den Schlitz."));

  if (zahler[getuid(TP), 0] >= TP->QueryProp(P_LEVEL))
    tell_object(TP, BS("Ein leises *klick* ist unter der Plattform "
                       "zu hoeren."));
  tell_room(ME, BS(TP->Name(WER) + " fummelt an einem Schlitz herum."), ({ TP }));

  save_object("/d/gebirge/iwo/oink/testsav");

  return 1;
}
