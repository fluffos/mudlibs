inherit "std/room";

#include <properties.h>
#include <wizlevels.h>
#include <mnpc.h>
#include <moving.h>
#include <language.h>
#include <attributes.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h> 

object ob; 


void create()
{

  ::create();

  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "An einem seltsamen Ort");
  SetProp( P_INT_LONG,
      "Du befindest Dich in einem Raum hinter den Augen des "
      "Drachens. Wenn Du durch sie blickst, kannst Du sehen, "
      "was sich ausserhalb befindet.");


  SetProp(P_INDOORS,1);


  AddDetail( ({"drache", "drachen"}),
       "Du siehst den Drachen nicht, da Du ja in ihm bist.");
  AddDetail( ({"boden", "ausgang", "oeffnung"}),
       "Unter Dir befindet eine Oeffnung.\n");
  AddDetail( ({"auge", "augen"}),
       "Du kannst duch die Augen blicken.");
  AddDetail( ({"oeffnung" }),
       "Du kannst durch sie runter klettern.");

  AddCmd( ({"blicke", "blick"}), "blicke"); 
  AddCmd( ({"klettere", "kletter"}), "klettern");
}


klettern(string str)
    {

    if (str != "runter" && str != "in oeffnung" && str != "durch oeffnung") 
        {
        write("WO moechtest Du hin klettern?\n");
        return 1;
        }

        tell_object(TP, "\nDu kletterst durch Die Oeffnung.\n\n");
        tell_room(ENV(TP),  PL->Name() + " verschwindet nach unten.\n",  ({TP})); 

        this_player()->move("/d/gebirge/iwo/oink/nuestern", M_NOCHECK + M_SILENT);

        tell_room(ENV(TP),  PL->Name() + " faellt von der Decke.\n",  ({TP})); 

    return 1;
    }




blicke(string str)
    {

    if (str != "durch auge" && str != "durch augen") 
        {
        write("WODURCH moechtest Du blicken?\n");
        return 1;
        }

        tell_object(TP, "\nDu blickst durch die Augen nach draussen.\n\n");
        tell_room(ENV(TP),  PL->Name() + " blickt durch die Augen nach draussen.\n",  ({TP})); 

        tell_object(TP, "\nAusserhalb siehst Du:\n");

        tell_object( TP, environment(find_living("oink"))->int_long(find_living("oink")) || "" );


    return 1;
    }

