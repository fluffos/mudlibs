
inherit "std/thing" ;

#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
	::create();
	SetProp(P_WEIGHT, 25);
	SetProp(P_VALUE, 0);
	SetProp(P_GENDER, FEMALE );
	AddId("eichel");
	SetProp(P_NAME, "Eichel");
	SetProp(P_SHORT, "Eine Eichel");
	SetProp(P_LONG, "Die Eichel ist klein, braun und fuer ihre "
	  "Groesse ziemlich schwer. Sie eignet sich sicher vorzueglich als "
	  "Geschoss");
	  
	AddCmd( ({ "wirf", "werfe", "schiess", "schiesse" }),
	  "throw_it");
}

int throw_it(string str)
{
  string what, whom;
  object target;
  string succ_str;
  int dam, success;
  
  if (ENV(ME) != TP) return 0;
  
  notify_fail("Was willst Du nach wem werfen?\n");
  if (!str) return 0;
  
  notify_fail("Nach wem willst Du die Eichel werfen?\n");
  if (sscanf(str, "%s nach %s", what, whom) != 2 || what != "eichel")
    return 0;
    
  notify_fail("Sowas siehst Du hier nicht!\n");
  if (!target = present(whom, ENV(TP))) return 0;
  
  notify_fail("Du wirst Dir doch nicht selber die Eichel nachwerfen?\n");
  if (target = TP) return 0;
  
  tell_object(TP, BS("Du holst weit aus, und wirst die Eichel nach "
    + target->name(WEM) + "."));
    
  tell_object(target, BS(TP->Name(WER) + " holt aus und wirft eine "
    "Eichel nach Dir."));
    
  tell_room(ENV(TP), BS(TP->Name(WER) + " holt aus und wirft eine "
    "Eichel nach " + target->name(WEN) + "."), ({ TP, target }));
    
  if ((success = random(50)) > TP->QueryAttribute(A_DEX))
    {
      tell_room(ENV(TP), BS("Die Eichel verfehlt " + target->name(WEN)
        + " um Haaresbreite."), ({ target }));
      tell_object(target, BS("Die Eichel verfehlt Dich um Haaresbreite."));
      ME->move(ENV(target), M_NOCHECK + M_SILENT);
      return 1;
    }  
  
  if (success > 10)
    {
      dam = 3;
      succ_str = "";
    }
  else if (success > 5)
    {
      dam = 5;
      succ_str = "hart ";
    }
  else
    {
      dam = 10;
      succ_str = "sehr hart ";
    }
        
  tell_object(target, BS("Die Eichel trifft Dich " + succ_str
    + "am Kopf."));

  tell_room(ENV(TP), BS("Die Eichel trifft " + target->name(WEN)
    + " " + succ_str + "am Kopf."), ({ target}));
    
  if (query_once_interactive(target))
    target->AddHp(-dam);
  else
    target->do_damage(dam);
    
  ME->move(ENV(target), M_NOCHECK + M_SILENT);

  return 1;
}

