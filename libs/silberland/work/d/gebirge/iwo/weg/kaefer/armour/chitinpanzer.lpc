inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"panzer", "chitinpanzer"}));
  SetProp (P_SHORT, "Ein riesiger Chitinpanzer");
  SetProp (P_LONG, 
          "Das Tier welches diesen Panzer einmal getragen hat, "
	  "muss so gross wie ein Haus gewesen sein. Es ist wohl "
	  "besser ihm nicht zu begegnen... Du wuerdest wohl "
	  "den kuerzeren ziehen wenn es Dir nicht wohlgesonnen "
	  "ist."); 
  SetProp (P_NAME, "Chitinpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 300000);
  SetProp (P_VALUE, 24000);
  SetProp (P_MATERIAL, ([MAT_CHITIN:100]));
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp (P_AC, 20);

  SetProp (P_WEAR_RESTRICTIONS, ([
    SR_INCLUDE_RACE: "Kaefer", P_SIZE: 500, SR_MAX_SIZE: 700 ]));
}
