inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "In einer Ritze im Felsboden");
  
  SetProp(P_INT_LONG, "Du fuehlst Dich ziemlich verloren so klein "
    "in der grossen Welt. Selbst eine Ameise koennte Dich bei derer "
    "Groesse irrtuemlich zertreten. Es waere wohl angebracht vorsichtig "
    "zu sein. Nach osten gaehnt eine tiefe Schlucht und versperrt "
    "Dir den weiteren Weg.");
  AddDetail(({"schlucht","haarriss","riss"}), "Wahrscheinlich ist das in Wirklichkeit "
    "ein Haarriss im Boden den Du ohne Vergroesserungsglas garnicht "
    "sehen koenntest aber in Deinem derzeitigen Zustand stellt er "
    "fuer Dich ein beinahe unueberwindliches Hindernis dar.");
  AddDetail(({"hindernis"}), "Ein Grashalm spannt sich von einer "
    "Seite der Schlucht zur anderen. Er koennte Dir eventuell als "
    "Bruecke dienen.");
  AddDetail(({"grashalm","halm","bruecke"}), "Die natuerliche Bruecke "
    "wirkt nicht besonders stabil, jedoch sollte sie Dein Gewicht alleine "
    "locker tragen koennen. Trotzdem sollet sie nur einer nach dem Anderen "
    "ueberqueren.");

  AddExit("westen", "/d/gebirge/iwo/weg/kaefer/kaeferraum.lpc");
  AddExit("osten", "/d/gebirge/iwo/weg/kaefer/bruecke01.lpc");
  SetProp(P_HIDE_EXITS, ({"osten"}));
}


