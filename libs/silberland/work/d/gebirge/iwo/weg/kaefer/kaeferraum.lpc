inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "In einer Ritze im Felsboden");
  
  SetProp(P_INT_LONG, "Erschrocken stellst Du fest, dass Du zwar noch immer "
    "dort bist, wo Du noch vor einem Moment gestanden hast - jedoch hat "
    "sich Deine Umgebung stark veraendert. Alles ist nun gigantisch gross, "
    "und die Baeume welche gerade noch Deine Umgebung zierten sind nicht mehr "
    "zu sehen. Das Steinchen welches vorhin noch vor Deinen Fuessen gelegen "
    "hat thront nun monstroes vor Dir und hat die Groesse eines Berges.");

  AddItem("/d/gebirge/iwo/weg/kaefer/kaefer.lpc", REFRESH_DESTRUCT);    

  AddExit("osten", "/d/gebirge/iwo/weg/kaefer/room001.lpc");
}


