inherit "std/weapon";

#include <properties.h>     // Properties definieren 
#include <defines.h>
#include <moredef.h>
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
  AddId (({"greifer", "kiefer", "geweih"}));       // IDs
  SetProp(P_SHORT, "Ein Paar Riesige Greifer");    //Kurzbeschreibung
  SetProp(P_LONG, BS(
               "Die riesigen Greifer sehen fast aus wie ein Geweih. "
	       "Das Tier welches sie zierten muss mindestens so gross "
	       "wie ein Drache gewesen sein. Die scharfen Kanten und "
	       "Zacken koennen dem Gegner empfindliche Wunden "
	       "versetzen.")); 
             

  SetProp (P_NAME, "Greifer");
  SetProp (P_NAME_ADJ, "riesig"); 
  SetProp (P_GENDER, FEMALE);  
  SetProp (P_VALUE, 20000); 
  SetProp (P_WEIGHT, 150000); 
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, ({DT_PIERCE, DT_SQUEEZE, DT_RIP, DT_TERROR})); 
  SetProp (P_NOBUY, 1);
  SetProp (P_WC, 222);
  SetProp (P_WC_FIXFACTOR, 0.1);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, ([MAT_CHITIN:100]));
  SetProp (P_WIELD_RESTRICTIONS, ([P_SIZE: 300]));
  SetProp (P_WC_BONUS, (["NPC":50]));
  SetProp (P_HIT_FUNC, this_object());
}

int HitFunc(object enemy)
{
  if (interactive(TP)) TP->do_exhaust(1,1);
  return 0;
}

