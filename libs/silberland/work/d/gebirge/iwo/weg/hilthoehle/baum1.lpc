inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_INT_SHORT, "In einem Hiltinuempfelnest");
  
  SetProp(P_INT_LONG, "Du bist blind.");

  AddExit("unten", "/d/gebirge/iwo/weg/00-00");

}

