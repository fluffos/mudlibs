#pragma strong_types

#include <properties.h>

inherit "/std/room";


void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Hier, kaum ein paar Schritte abseits von dem Weg durch den "
    "dichten Wald, lichten sich die Baeume ploetzlich, und eine "
    "kleine freie Flaeche breitet sich vor Dir aus. "
    "In der Mitte dieser kleinen Lichtung brennt gemuetlich ein "
    "kleines Lagerfeuer vor sich hin.");

  AddDetail("weg",
    "Der Weg ist nur ein paar Schritte weg von hier.");

  AddDetail("wald",
    "Der ansonsten recht dichte Wald, ist hier an dieser Stelle "
    "licht, und bietet Platz fuer das gemuetliche Lagerfeuer.");

  AddDetail("flaeche",
    "Die Flaeche hier ist frei von Baeumen.");

  AddDetail("baeume",
    "Die Baeume, die diese Lichtung saeumen, scheinen ziemlich alt "
    "zu sein.");

  AddDetail("schritte",
    "Nur wenige wuerdest Du benoetigen, um zurueck auf den Weg zu "
    "kommen.");

  AddDetail("mitte",
    "In der Mitte der kleinen Lichtung brennt ein kleines Lagerfeuer.");

  AddDetail(({ "lagerfeuer", "feuer", }),
    "Genaehrt von den Aesten der Aeonen alten Baeumen aus der "
    "Umgebung lodert und knistert es gemuetlich vor sich hin. "
    "Es scheint ein kleinwenig gruenlich zu brennen.");

  AddDetail("aeonen",
    "Du starrst gespannt in die Gegend, und wartest ab.");

  AddDetail("aeste",
    "Einige der ansonsten an den Baeumen angewachsenen Aeste knistern "
    "im Lagerfeuer vor sich hin.");

  AddDetail("gegend",
    "Du siehst Dich um.");

  AddDetail("umgebung",
    "Alles in Allem wirkt die Umgebung recht heimelig.");

  AddDetail("himmel",
    "Zwischen den dicken Aesten der Baeume kannst Du ein klein wenig "
    "Himmel sehen.");

  AddDetail("stelle",
    "An dieser Stelle lodert ein kleines Lagerfeuer inmitten der "
    "Lichtung.");
 
  AddDetail("platz",
    "Platz gibt es hier genuegend."); 

  AddDetail("boden",
    "Der Boden hier ist bedeckt von den ueblichen abgefallenen "
    "Aesten und Blaettern von den hiesigen Baeumen.");

  AddSound(DEFAULT_SOUND,
    "Das Lagerfeuer kistert beruhigend vor sich hin.");

  AddSmell(DEFAULT_SMELL,
    "Es duftet angenehm nach frisch angebranntem Holz.");
}

