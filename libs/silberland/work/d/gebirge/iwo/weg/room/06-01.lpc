inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Schritt fuer Schritt stapfst Du durch die "
    "Untiefen des Waldes auf der Suche nach wasauchimmer Du zu finden "
    "erhoffst. Die Baeume sind Deine Begleiter, der Wind Deine Musik "
    "und das Rascheln der Blaetter unterstuetzt fast planlos wirkend "
    "das rhytmische Knacksen der brechenden Zweige unter Deinen "
    "Schritten.");
    
  AddDetail( ({ "untiefen" }),
    "Der Wald ist nicht sonderlich tief hier. Sonst gaebs wohl auch "
    "keinen Weg.");
  AddDetail( ({ "wald","waeldchen" }),
    "Ein angenehm luftiges Waeldchen ziert Deine Umgebung."); 

  AddDetail( ({"umgebung" }),
    "Das, was Dich umgibt.");
  AddDetail( ({ "suche" }),
    "Was Du wohl suchst hier?");
  AddDetail( ({ "baeume", "baum" }),
    "Die zahlreichen Baeume hier bilden einen Wald.");
  AddDetail( ({ "begleiter" }),
    "Die Baeume hier begleiten Dich auf Deinem Weg.");
  AddDetail( ({ "wind" }),
    "Der Wind rauscht kraftvoll durch den Wald.");
  AddDetail( ({ "blaetter" }),
    "Die Blaetter rascheln getrieben vom Wind.");
  AddDetail( ({ "zweige","schritten" }),
    "Bei jedem Deiner Schritte brechen ein paar kleine Zweige unter Deiner "
    "Last.");
  AddDetail( ({ "boden" }),
    "Blaetter und abgebrochene Zweige bedecken den steinigen Boden.");
  AddDetail( ({ "himmel" }),
    "Die Blaetter verwehren Dir jeglichen Blick auf den Himmel.");
  AddDetail( ({ "weg" }),
    "Der Weg bringt Dich wohl von hier noch dort.. oder umgekehrt.");
  AddDetail( ({ "steine" }),
    "Die liegen hier herum.");

  AddSound(({ DEFAULT_SOUND }), 
    "*KNACKS* *RAUSCH* *KNACKSKNACKS* *RAUSCH*");
      

  AddExit("nordwesten", BASE "05-02");
  AddExit("osten", BASE "07-01");
  

}
