inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
 
  SetProp(P_INT_LONG, "Hier scheint sich der Wald zu lichten - so, als "
    "ob ein Ende nicht weit sei. Die Baeume recken ihre Aeste gen "
    "Sonnenlicht und berieseln den Pfad mit Blaettern.");
 
  AddDetail( ({ "wald" }),
    "Der Wald duerfte ziemlich alt sein.");
  AddDetail( ({ "ende" }),
    "Nordoestlich scheint sich der Wald zu lichten.");
  AddDetail( ({ "baeume" }),
    "Die Baeume bilden hier einen Wald. Dir faellt jedoch "
    "keiner besonders auf.");
  AddDetail( ({ "aeste", "ast" }),
    "Die Baeume haben viele Aeste.");
  AddDetail( ({ "sonnenlicht", "licht", "himmel" }),
    "Das Sonnenlicht wird hier beinahe vollstaendig von den "
    "zahlreichen Blaettern abgeschirmt.");
  AddDetail( ({ "blaetter", "blaettern" }),
    "Auf fast jedem Ast sind Blaetter.");
  AddDetail( ({ "boden", "pfad" }),
    "Die abgefallenen Blaetter bedecken den Boden vollstaendig.");


  AddExit("nordosten", BASE "07-15");
  AddExit("sueden", BASE "06-13");
  

}
