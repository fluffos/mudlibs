inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Der Weg macht hier eine kleine Biegung und nach Norden "
    "steigt er etwas an. Die maechtigen Baeume die den Wegesrand zieren, "
    "scheinen seit Jahrhunderten ungestoert wachsen koennen zu haben. "
    "Das Einzige was die natuerliche Umgebung unterbricht ist der Weg "
    "auf dem Du Dich befindest.");
    
  AddDetail( ({ "weg" }),
    "Der ausgetrampelte Pfad ist lang und steinig.");
  AddDetail( ({ "pfad" }),
    "Fuer einen Pfad ist der Weg zu gut befestigt.");
  AddDetail( ({ "biegung" }),
    "Du solltest sie entlang gehen, sonst wirst Du nicht viel sehen.");
  AddDetail( ({ "norden" }),
    "Nach Norden steigt der Weg leicht an.");
  AddDetail( ({ "baeume", "baum" }),
    "Die Baeume scheinen uralt zu sein. Niemand hat wohl jemals an sie "
    "Hand angelegt. Genau deshalb sind sie wohl so praechtig gediehen.");
  AddDetail( ({ "hand" }),
    "Keine wurde angelegt.");
  AddDetail( ({ "wegesrand", "rand" }),
    "Unzaehlige Baeume saeumen den Wegesrand.");
  AddDetail( ({ "umgebung" }),
    "Die Umgebung scheint etwas waldig und etwas gebirgig. Nennen wir's "
    "einfach 'Gebirgswald'.");
  AddDetail( ({ "gebirgswald" }),
    "Ein Wald im Gebirge.");
  AddDetail( ({ "wald" }),
    "Viele Baeume ergeben einen Wald.");
  AddDetail( ({ "gebirge" }),
    "So nennt sich der felsige Teil des Silberlandes in dem Du gerade "
    "herumstreifst.");
  AddDetail( ({ "silberland" }),
    "Schau Dich halt etwas um!");
  AddDetail( ({ "teil" }),
    "Ja, Teil.");
  AddDetail( ({ "boden" }),
    "Der steinige Boden ist mit Laub bedeckt.");
  AddDetail( ({ "laub" }),
    "Abgefallene Blaetter.");
  AddDetail( ({ "blaetter" }),
    "Wenn sie am Boden liegen nennt man sie 'Laub'.");
  AddDetail( ({ "himmel" }),
    "Die Blaetter verhindern, dass Du den Himmel siehst.");

  AddSound(DEFAULT_SOUND, "Nur die Blaetter rauschen etwas.");
  AddSmell(DEFAULT_SMELL, "Es riecht nach Wald.");
  
    
  AddCmd( ({ "lege", "leg" }), "handon");

  AddExit("nordoben", BASE "05-03");
  AddExit("suedosten", BASE "06-01");
  

}

int handon(string what)
{
  notify_fail("Was willst Du wo anlegen?\n");
  if (!what || what == "") return 0;
  
  notify_fail("Daran kannst Du nix anlegen!\n");
  if (what != "hand an baum" &&
     what != "hand an baeume") return 0;
     
  tell_object(TP, BS("Du legst Hand an einen der Baeume an."));
  tell_room(ENV(TP), BS("Ein Ast schwingt wie von Geisterhand "
                        "bewegt und trifft " + TP->name(WEN) + " am Kopf."),
			({ TP }));
  tell_object(TP, BS("Ein Ast schwingt wie von Geisterhand bewegt und trifft "
    "Dich am Kopf."));

  TP->do_damage(10);
  tell_object(TP, BS("Nun weisst Du warum keiner Hand anlegt."));
  return 1;
}
