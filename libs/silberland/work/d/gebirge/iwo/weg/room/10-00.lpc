inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Obwohl der steinige Boden unter Deinen Fuessen "
    "nicht besonders einladend wirkt, findest Du ausreichend Halt "
    "und anhand der abgerundeten Kanten des Felsgrundes laesst sich "
    "erahnen, dass der Weg haeufig benutzt wird. Noerdlich von Dir "
    "thront erhaben die Burg Sturmfels auf dem gleichnamigen Teil "
    "des Gebirgsmassives. Die andere Seite flankiert ein Abgrund "
    "der - waeren da nicht einige Baeume - einen phantastischen "
    "Ausblick ermoeglichen wuerde.");

  AddDetail( ({"boden","untergrund"}), "Der Boden besteht aus massivem Fels "
    "- so wie der Grossteil des Gebirges.");

  AddDetail( ({ "gebirge", "gebiet" }),
    "Gebirge nennt sich das Gebiet in dem Du Dich befindest.");
  AddDetail( ({ "grossteil" }),
    "Ich glaub kaum, dass Du das sehen kannst!");
 
  AddDetail( ({"fuesse"}), "Deine Fuesse schmerzen etwas vom laufen "
    "auf dem harten Untergrund.");
  AddDetail( ({"halt"}), "Du findest mehr als genug Halt um Dich "
    "zuegig fortbewegen zu koennen. Sogar laufen ginge problemlos.");
  AddDetail( ({"kanten"}), "Die Kanten sind von den zahlreichen Stiefel "
    "die sie im Laufe der Jahre zu spueren bekommen haben glatt "
    "geschliffen, jedoch keineswegs rutschig.");
  AddDetail( ({"felsgrund"}), "Der vormals scharfkantige Felsgrund "
    "bietet Dir einen bequemen Weg um das Gebirge zu durchstreifen.");
  AddDetail( ({"weg","trasse"}), "Der Weg besteht aus einer mehrere "
    "Meter breiten Trasse welche gegebenenfalls sogar genug Platz fuer "
    "einen Pferdewagen oder Ochsenkarren bieten wuerde.");
  AddDetail( ({"wagen", "pferdewagen"}), "Der Pferdewagen verkehrt "
    "zwischen Midas, Derlim und Elessar.");
  AddDetail( ({"karren","ochsenkarren"}), "Momentan siehst Du keinen "
    "- aber es ist gut zu wissen, dass notfalls einer fahren koennte hier.");
  AddDetail( ({"midas","derlim","elessar"}), "Leider verwehren Dir die "
    "Baeume den Ausblick auf diese Orte.");
  AddDetail( ({"burg","paladine"}), "Maechtig ueberragt die Burg Sturmfels die nahe "
    "Umgebung. Sie ist die Heimat der ehrwuerdigen Paladine. Vielleicht "
    "kannst Du hier dem einen oder anderen begegnen, oder bist sogar "
    "einer aus ihren Reihen.");
  AddDetail( ({"sturmfels","gebirgsmassiv","massiv","gipfel"}), "Der hoechst "
    "Punkt hier nennt sich 'Sturmfels'. Der Ursprung des 'Sturm'es ist "
    "unbekannt, aber es wird davon geredet, dass die heftigen Windboen "
    "dem Gipfel den Namen gegeben haben.");
  AddDetail( ({"seite", "seiten"}), "Es gibt immer mehrere.");
  AddDetail( ({"abgrund"}),
    "Suedlich erstreckt sich ein Abgrund richtung Silberwald. Ein paar "
    "Baeume zieren ihn, und sorgen dafuer, dass Du nicht ins Tal siehst.");
  AddDetail( ({"tal"}), "Sowas siehst Du da nicht! (Nona, da sind Baeume "
    "im Weg ;)");
  AddDetail( ({"silberwald"}), "Der Silberwald ziert den Suedhang des "
    "Gebirgsmassivs.");
  AddDetail( ({"wald"}), "Da stehst Du - und siehchst kan Bam ;)");
  AddDetail( ({"bam", "baum"}), "Ein Hiltinuempfel springt von Ast zu Ast.");
  AddDetail( ({"bum"}), "Bam");
  AddDetail( ({"suedhang"}), "Erstaunt blickst Du nach Sueden und siehst, "
    "dass er tatsaechlich nicht im Norden ist.");
  AddDetail( ({"himmel"}), "Die Luft ist schon etwas duenn hier heroben, "
    "aber da sie hier so wunderbar frisch ist, hast Du trotzdem keine "
    "Probleme beim Atmen. Ein paar Sonnenstrahlen blinzeln durch das "
    "Blaetterdach und waermen Dir das Gesicht. Falls Du ein Dunkelelf bist, "
    "feuts Dich jetzt an :-)");
  AddDetail( ({"luft"}), "Du nimmst zwei Lungen voll.");
  AddDetail( ({"lungen"}), "Siehst nicht - wie auch.. dann waerst ja "
    "offen und tot. Wiffzack ;)");
  AddDetail( ({"baeume"}), "Der Wald hier heroben wirkt so richtig gesund. "
    "So, als haette er noch nie etwas von saurem Regen oder Schwermetallen "
    "gehoert... Aber wahrscheinlich ist das auch so, denn soetwas gibts "
    "im Silberland nicht.");
  AddDetail( ({ "silberland" }),
    "Schau Dich g'scheit um, wennst keine Ahnung hast, was das ist!");
  AddDetail( ({ "ahnung" }),
    "Siehst Du nicht. *seufz*");
  AddDetail( ({ "schwermetalle", "metalle" }),
    "Die kannst Du nicht sehen. Waer auch ziemlich "
    "gefaehrlich, wenn diese so gross waeren und vom Himmel fielen.");
  AddDetail(({"regen"}), "'Sauer macht lustig', sagte der Wald und lachte "
    "sich tot.");
  AddDetail( ({"hiltinuempfel", "nuempfel"}), "Behende springt es "
    "von Ast zu Ast. Vielleicht solltest Du ihm nachspringen?");    
  AddDetail( ({"ast", "aeste"}), "Hier im SilberLand ist es ueblich, "
    "dass Baeume Aeste haben.");
  AddDetail( ({"fels", "felsen"}), "Ueberall wo nicht gerade ein bisschen "
    "Humus ist auf dem gleich Baeume und sonstige Pflanzen gedeihen, "
    "besteht die Landschaft in Deiner Umgebung aus kahlem, kalten Fels.");
  AddDetail( ({ "pflanzen" }),
    "Baeume sind Pflanzen.");
  AddDetail( ({ "aeonen" }),
    "Du versuchst 'Aeonen' zu sehen. Umsonst.");


  AddDetail( ({"landschaft", "umgebung"}), QueryProp(P_INT_LONG));
  AddDetail( ({"humus"}), "Hie und da hat sich welcher in den Ritzen "
    "im Fels eingenistet und bietet dort einen naehrhaften Untergrund "
    "fuer diverse Viehzeugs und Pflanzen.");
  AddDetail( ({"viehzeug", "viehzeugs"}), "Ein Hirschkaefer fuehlt sich "
    "Durch Deine Anwesenheit bedroht, und zeigt Dir angriffslustig sein "
    "Moechtegerngeweih.");
  AddDetail( ({ "anwesenheit" }),
    "Siechste nicht.");
  AddDetail( ({ "moechtegerngeweih", "geweih" }),
    "Viel zu klein um wirklich als solches bezeichnet zu werden.");
  
  AddDetail( ({"hirschkaefer", "kaefer"}), "Als Du den Kaefer naeher "
    "betrachtest kommt Dir irgendetwas aeusserst Merkwuerdig vor. Vorallem "
    "scheint mit seinen Augen etwas faul zu sein.");
  AddDetail(({"ausblick"}), "Der Ausblick wird Dir leider durch ein paar "
    "Baeume verwehrt.");
  AddDetail(({"blaetterdach", "dach", "blaetter"}), "Das Blaetterdach "
    "welches durch die umliegenden Baeume entsteht verhindert, dass Dich "
    "die Sonnenstrahlen direkt treffen.");
  AddDetail(({"strahlen", "sonnenstrahlen"}), "Die Sonnenstrahlen schaffen "
    "es kaum durch das Blaetterdach bis zum Boden vorzudringen.");
  AddDetail(({"ritzen"}), "Verfaulende Blaetter und was sich sonst noch "
    "so angesammelt hat im laufe der Aeonen bilden einen naehrstoffreichen "
    "Boden fuer Pflanzen und Tiere.");
  AddDetail(({"tiere"}), "Du wirst sicher noch einigen begegnen. Der "
    "Silberwald lebt.");
  AddSpecialDetail( ({"augen", "auge"}), "MagicEye");    

  AddExit( ({ "osten" }), "/d/gebirge/impulz/paladinweg/room/weg_4");
  AddExit( ({ "westen" }), BASE "09-00.lpc"); 

  AddCmd( ({"spring", "springe", "huepf", "huepfe"}), "HiltiJump");

  AddRoomMessage( ({""}), 30, "HiltiSound");

  AddSound( DEFAULT_SOUND, "Irgendwas scheint im Wald zu sein.\n");

  AddItem(BASE+"../npc/walker", REFRESH_DESTRUCT);
}

int HiltiJump(string str)
{
  notify_fail(BS("Irgendwie hast Du grad keine Lust dazu. Vielleicht spaeter."));
  return 0;

  notify_fail("Wer wie wo was wie willst Du springen?\n");
  if (!str || (str!="nuempfel nach" && str !="hiltinuempfel nach"
      && str!="von ast zu ast")) return 0;

  tell_room(ME, BS("Du traust Deinen Augen nicht, als " + TP->name(WER) +
    " Anlauf nimmt und sich ins Geaest schwingt. Du siehst noch wie " +
    TP->QueryPronoun() + " zum naechsten Ast hechtet " +
    "und dann im Blaetterdach verschwindet."), ({ TP }));

  tell_object(TP, BS("Du nimmst etwas Anlauf und hechtest elegant auf den "
    "naechsten Ast. Er knackst etwas unter Deiner Last, scheint aber Dein "
    "Gewicht locker zu tragen. Ein Stueck vor Dir siehst Du das "
    "Hiltinuempfel zum naechsten Ast segeln. Neugierig springst Du "
    "hinterher."));
  
  TP->move(BASE "hilthoehle/baum1", M_SILENT+M_NOCHECK);  
        
  return 1;
}


void HiltiSound()
{
  if (random(10)<6)
    tell_room(ME, "Ueber Dir knackst etwas.\n");
  return;
}


string MagicEye()
{
  return BS("Der Kaefer wendet sich desinteressiert ab. Vielleicht ein anderes Mal.");

  TP->SetProp(P_PARALYZED, ([
    PARALYZE_TIME: 30,
    PARALYZE_MSG: "",
    PARALYZE_MSG_OTHER: "",
    PARALYZE_END: "",
    PARALYZE_END_OTHER: ""]));
 
  call_out("Eye2", 2);
  
  return BS("Als Du dem Kaefer tief in die Augen blickst ueberkommt Dich ein "
            "merkwuerdiges gefuehl.");
}

void Eye2()
{
  tell_object(TP, BS("Ploetzlich kommt es Dir vor, als wuerde sich die "
    "Umgebung veraendern. Alles driftet weit weg von Dir."));
  tell_room(ME, BS(TP->Name(WEM) + " scheint es nicht gut zu gehen. " +
    TP->QueryPronoun() + " taumelt etwas und wirkt abwesend."), ({ TP }));
  call_out("Eye3", 2);
}


void Eye3()
{
  tell_object(TP, BS("Auf einmal beginnt sich alles zu drehen. Das Bild vor "
    "Deinen Augen verzerrt sich, und alles scheint zu wachsen."));
  tell_room(ME, BS("Ploetzlich schrumpft " + TP->name(WER) + " zusammen und "
    "verschwindet aus Deinem Blickfeld."), ({ TP }));
  call_out("Eye4", 2);
}


void Eye4()
{
  TP->SetProp(P_PARALYZED, 0);
  TP->move("/d/gebirge/iwo/weg/kaefer/kaeferraum", M_SILENT + M_NOCHECK);
}
