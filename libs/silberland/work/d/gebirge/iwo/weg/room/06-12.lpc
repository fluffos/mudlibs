inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Hier im Wald herrscht eine angenehme Stille, "
    "und die Luft ist so gut und rein wie selten wo. Die Blaetter "
    "der unzaehligen Baeume wogen sanft im Wind, und der Widerhall "
    "Deiner Schritte geleitet Dich in monotonen Takt des Weges.");
    
  AddDetail( ({ "wald", "baeume", "baum" }),
    "Ein Baum hier, einer da. Scheinbar voellig ohne Ordnung wachsen "
    "die Baeume hier so, wie die Natur ihnen es gebietet.");
  AddDetail( ({ "ordnung", "gesetze" }),
    "Die Natur hat ihre eigene Ordnung und ihre Gesetze sind "
    "unergruendlich.");
  AddDetail( ({ "natur" }),
    "Die maechtigste Wesenheit im Multiversum.");
  AddDetail( ({ "multiversum" }),
    "Davon hast Du keine Ahnung.");
  AddDetail( ({ "ahnung" }),
    "Keine.");
  AddDetail( ({ "luft" }),
    "Die kannst Du natuerlich nicht sehen.");
  AddDetail( ({ "blaetter", "blatt", "blaettern" }),
    "Ja, viele Blaetter. Unglaublich!");
  AddDetail( ({ "wind" }),
    "Der Wind laesst die Blaetter sanft wogen.");
  AddDetail( ({ "widerhall" }),
    "Tapps, tapps, tapps.");
  AddDetail( ({ "schritte", "schritt" }),
    "Ja, Deine eigenen Schritte!");
  AddDetail( ({ "takt" }),
    "Links, rechts, links, rechts...");
  AddDetail( ({ "weg", "weges" }),
    "Der Weg fuehrt Dich von hier nach dort.");
  AddDetail( ({ "boden" }),
    "Der Boden ist durchwegs mit Blaettern bedeckt.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist hier kaum zu sehen.");
  AddDetail( ({ "stille" }),
    "Du kannst die Stille regelrecht fuehlen.");
  AddSound( DEFAULT_SOUND,
    "Die Stille ist echt angenehm!");


 
  AddDetail( ({ "wald" }),
    "Baeume."); 

  AddExit("norden", BASE "06-13");
  AddExit("suedwesten", BASE "05-11");
  

}
