inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "An einem Waldrand");
  
  SetProp(P_INT_LONG, "Hier befindest Du Dich im Saum zwischen Wald "
    "und Wiesen. Ueberall wuchern zwischen den vereinzelten Baeumen "
    "die verschiedensten Straeucher und Graeser. Oestlich von Dir "
    "erhebt sich eine Stadt, waehrend westlich der Wald liegt.");
  
  AddDetail( ({ "saum" }),
    "Der Saum hier ist weder Wald, noch Wiese.");
  AddDetail( ({ "wald" }),
    "Der eigentliche Wald liegt westlich von Dir.");
  AddDetail( ({ "wiese", "wiesen", "grasland" }),
    "Oestlich von Dir liegt Grasland.");
  AddDetail( ({ "baeume", "baeumen" }),
    "Hier stehen die Baeume nicht so dicht. Du bist auch nicht "
    "wirklich im Wald.");
  AddDetail( ({ "straeucher" }),
    "Die meisten sind stachelig, einige sind saftig gruen.");
  AddDetail( ({ "graeser" }),
    "Die Graeser hier sehen recht gesund aus und stehen voll "
    "im Saft.");
  AddDetail( ({ "saft" }),
    "Der macht die Graeser gruen :-)");
  AddDetail( ({ "stadt" }),
    "Geh doch einfach naeher ran!");
 
  AddDetail( ({ "boden" }),
    "Ein paar Blaetter liegen hier am Boden.");
  AddDetail( ({ "blaetter" }),
    "Die interessieren Dich grad nicht besonders.");

  AddDetail( ({ "himmel" }),
    "Hie und da schimmert der blaue Himmel durch.");


  AddExit("osten", "/d/gebirge/iwo/arwenock/room/room_A-04");
  AddExit("westen", BASE "07-15");
  

}
