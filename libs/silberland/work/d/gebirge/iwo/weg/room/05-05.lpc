inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Der Weg fuehrt Dich weiter nach Norden oder Sueden. "
    "Beinahe waerst Du auf dem felsigen Untergrund "
    "der nur von ein paar Blaettern bedeckt ist umgeboeckelt. Hie und da "
    "zwitschert irgendwo zwischen den Baeumen ein Voegelchen und wenn "
    "der Wind gerade zufaellig die Blaetter richtig bewegt, kannst Du "
    "sogar den einen oder andern Sonnenstrahl erhaschen.");

  AddDetail( ({ "norden", "sueden" }),
    "Das sind Richtungskommandos, die kannst Du eingeben.");
  AddDetail( ({ "untergrund", "grund" }),
    "Der steinige Untergrund bereitet Dir kaum Muehe.");
  AddDetail( ({ "blaetter", "futzerl" }),
    "Blaetter sind kleine gruene Futzerl die auf Bauemen wachsen und "
    "gelegentlich runterfallen um am Boden braun zu werden.");
  AddDetail( ({ "baeume" }),
    "Massive Baeume umgeben Dich.");
  AddDetail( ({ "voegelchen" }),
    "Du kannst leider keines sehen. Dein Magen knurrt.");
  AddDetail( ({ "wind" }),
    "Der Wind laesst die Blaetter leise rauschen.");
  AddDetail( ({ "sonnenstrahl" }),
    "Jetzt gerade siehst Du keinen.");
  AddDetail( ({ "himmel" }),
    "Waeren da nicht soviele Blaetter, koenntest Du ihn sehen.");
  AddDetail( ({ "boden" }),
    "Blaetter bedecken den Boden.");

  AddDetail( ({ "weg" }),
    "Der Weg ist breit genug um einem Wagen Platz zu bieten. ");
  AddDetail( ({ "wagen" }),
    "Wenn keinr hier ist, siehst Du keinen.");


  AddSound(DEFAULT_SOUND, "Die Blaetter rascheln leise im Wind.");
  AddSmell(DEFAULT_SMELL, "Es duftet nach Wald.");

  AddExit("norden", BASE "05-06");
  AddExit("sueden", BASE "05-04");
  

}
