inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Weiter und weiter treibt Dich Dein Weg durch "
    "den Wald. Zuviele Wanderer trampeln ueber diesen Pfad, als dass "
    "Du das Glueck haettest einen der scheuen Waldbewohner dieser "
    "Gegend zu Gesicht zu bekommen.");
    
  AddDetail( ({ "weg", "pfad", "weges" }),
    "Ausgetrampelt und hart wie Stein schlaengelt sich der Pfad "
    "duch den Gebirgswald.");
  AddDetail( ({ "stein", "gestein", "steine" }),
    "Hie und da aeugelt das Gestein des Gebirges durch die zarte "
    "Blaetterdecke des Weges.");
  AddDetail( ({ "gebirge", "gebirges" }),
    "Beinahe koenntest Du hier vergessen, dass Du Dich eigentlich "
    "im Gebirge befindest.");
  AddDetail( ({ "blaetterdecke", "blaetter", "boden", "waldboden",
    "blaettern" }),
    "Der Waldboden ist spaerlich mit Blaettern bedeckt.");
  AddDetail( ({ "wanderer", "wanderern" }),
    "Gelegentlich gegnen einem hier Wanderer.");
  AddDetail( ({ "glueck" }),
    "Wenn Du glaubst hier Dein Glueck zu finden, dann hast Du Dich "
    "wohl getaeuscht.");
  AddDetail( ({ "waldbewohner", "bewohner" }),
    "Die scheinen wohl alle von den Wanderern verscheucht zu werden.");
  AddDetail( ({ "gegend" }),
    "Du siehst Dir die Gegend an, kannst aber ausser Baeumen nicht "
    "viel entdecken.");
  AddDetail( ({ "baeume", "baeumen" }),
    "So viele sind davon da - ein regelrechter Wald.");
  AddDetail( ({ "baum", "blatt", "aeste", "ast"}),
    "Unmengen davon gibt es hier davon.");
  AddDetail( ({ "gesicht" }),
    "Ein paar Blaetter, Steine und Aeste formen ein kleines Gesicht "
    "am Boden.");
  AddDetail( ({ "wald", "gebirgswald" }),
    "'Sauer macht lustig', sagte der Wald und lachte sich tot.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist hier kaum zu sehen.");


  AddExit("nordosten", BASE "06-12");
  AddExit("suedwesten", BASE "04-10");
  

}
