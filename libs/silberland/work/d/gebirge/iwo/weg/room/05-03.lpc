inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Nach Norden und Sueden ist der Weg nun etwas "
    "abschuessig. Von hier hast Du eine gute Aussicht ueber die "
    "felsige Gegend die Dich umgibt. Wie die Spur eines Messers "
    "schneidet sich der Weg durch den Gebirgswald und bereitet Dir "
    "einen bequemen Pfad.");
    
  AddDetail( ({ "norden" }),
    "Der Weg fuehrt weiter nach Norden.");
  AddDetail( ({ "sueden" }),
    "Der Weg fuehrt nicht nur nach Norden, sondern auch nach Sueden.");
  AddDetail( ({ "weg", "pfad" }),
    "Der Weg ist ein breiter, ausgetrampelter Pfad. Heisst das Du "
    "bist ein Trampel?");
  AddDetail( ({ "trampel" }),
    "Trampelpfad - Nur fuer Kamele.");
  AddDetail( ({ "kamele", "kamel" }),
    "Du tastest Dich nach Hoeckern ab.");
  AddDetail( ({ "aussicht", "umgebung" }),
    "Du laesst Deinen Blick ueber die Umgebung schweifen - findest "
    "aber nichts ausser einer wunderschoenen, idyllischen Gebirgslandschaft.");
  AddDetail( ({ "gebirgslandschaft", "landschaft" }),
    "Sie umgibt Dich ringsum - Du brauchst nur die Augen offen zu halten.");
  AddDetail( ({ "gegend" }),
    "Die Gegend bildet eine wunderschoene Landschaft.");
  AddDetail( ({ "spur" }),
    "Der Weg sieht wie eine Spur aus.");
  AddDetail( ({ "gebirgswald", "wald" }),
    "Ein malerischer Gebirgswald umgibt Dich.");
  AddDetail( ({ "boden" }),
    "Der felsige Boden ist mit Blaettern bedeckt.");
  AddDetail( ({ "blaetter"}),
    "Die Blaetter sind wohl von den Baeumen gefallen.");
  AddDetail( ({ "baeume" }),
    "Die Baeume rund um Dich ergeben einen Wald.");
  AddDetail( ({ "blaetter" }),
    "Die wachsen auf Baeumen.");
  AddDetail( ({ "himmel" }),
    "Die zahlreichen Blaetter auf den Baeumen schirmen "
    "Deinen Blick zum Himmel ab.");
    
    
  AddExit("nordunten", BASE "05-04");
  AddExit("suedunten", BASE "05-02");
  
  AddItem(BASE+"../npc/walker", REFRESH_DESTRUCT);
}
