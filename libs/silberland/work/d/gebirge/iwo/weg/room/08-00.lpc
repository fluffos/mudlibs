inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Leise rascheln die Blaetter begleitet vom "
    "Knirschen kleiner Steinchen unter der Last Deiner Schritte. "
    "Das sanfte Rauschen des Windes wie er sich durch die Baeume "
    "schlaengelt wirkt sehr beruhigend auf Dich. Kaum kannst Du "
    "die Paladinburg sehen, aber sicher werden Gildenangehoerige "
    "hier durch die Waelder streifen.");

  AddDetail( ({"blaetter"}),
    "Abgefallene Blaetter bedecken den Boden.");
  AddDetail( ({"boden"}),
    "Am Boden siehst du hauptsaechlich Blaetter und Steine.");
  AddDetail( ({"steine", "steinchen"}),
    "Im Laufe der Zeit sind sie von den Felsen abgebrochen - durch "
    "Erosion oder abgetreten von einem Wanderer.");
  AddDetail( ({"felsen", "wegrand", "rand"}),
    "Kleine Felsen zieren den Wegrand.");
  AddDetail( ({"rauschen", "wind"}),
    "Du hoerst den Wind rauschen...");
  AddSound( ({ DEFAULT_SOUND, "rauschen", "wind"}),
    "Sanft rauscht der Wind als er sich auf seinem Weg durchs "
    "Gebirge durch die Aeste der zahlreichen Baeume schlaengelt.");
  AddSound( ({ "knirschen"}),
    "Leise knirscht es wenn die Steinchen aneinander scheuern.");
  AddDetail( ({"baeume"}),
    "Stolz flankieren sie den Weg und trotzen der Zeit.");
  AddDetail( ({"weg"}),
    "Der Weg bring Dich von hier nach dort.");
  AddDetail( ({"paladinburg", "burg"}),
    "Die Burg liegt knapp ausserhalb Deines Blickfeldes.");
  AddDetail( ({"gildenangehoerige", "angehoerige"}),
    "Hier im Wald..");
  AddDetail( ({"waelder", "wald"}), 
    "Zahlreiche Baeume bilden einen Wald.");
  AddDetail( ({ "himmel" }),
    "Die vielen Blaetter der Baeume verwehren Dir den Blick "
    "zum Himmel.");

  

  AddExit("nordwesten", BASE "07-01");
  AddExit("osten", BASE "09-00");
  
  AddItem(BASE+"../npc/walker", REFRESH_DESTRUCT);
}
