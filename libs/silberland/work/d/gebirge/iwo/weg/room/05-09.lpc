inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

    
void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "In einer Sackgasse");
  
  SetProp(P_INT_LONG, "Hier endet ploetzlich der eben noch so schoen "
    "erscheinende Pfad in einer Sackgasse. Vor Dir befindet sich "
    "nurmehr eine Steilwand und ein paar Felsen. Ein Aufstieg "
    "scheint an der kantigen Wand kaum moeglich zu sein, also siehts "
    "wohl so aus, als waerst Du hier ans Ende geraten."
    );

  AddDetail( ({"pfad"}),
   "Der Pfad schlaengelt sich durch die Baeume hindurch. Er scheint "
   "ziemlich ausgetreten zu sein, jedoch kann es ohne weiteres sein, "
   "dass er von einem Tier stammt.");
  AddDetail( ({"baeume"}),
   "Die Baeume sind hier wie beinahe ueberall im Gebirge maechtig "
   "und erscheinen Dir uralt zu sein.");
  AddDetail( ({"gebirge"}),
   "Als Du den Silberwald in noerdlicher Richtung verlassen hast, "
   "bist Du ins Gebirge gelangt.");
  AddDetail( ({"silberwald"}),
   "Natuerlich kannst Du den Silberwald von hier aus nichtmehr "
   "sehen.");
  AddDetail( ({"richtung"}),
   "In noerdlicher.");
  AddDetail( ({"sackgasse", "gasse"}),
   "Hier scheint es nicht so, als wuerdest Du noch weiter vorwaerts "
   "kommen.");
  AddDetail( ({"steilwand", "wand", "felswand"}),
   "Die Felswand ist enorm steil und kantig so dass ein Emporklettern "
   "unmoeglich ist.");
  AddDetail( ({"felsen", "findlinge"}),
   "Ein paar Findlinge, die wohl im Laufe der Zeiten von oberhalb der "
   "Felswand heruntergefallen sind, zieren die Umgebung. Tiefe "
   "Furchen zieren ihre Oberflaeche, die wohl beim Absturz und "
   "Aufschlagen auf die Felswand dabei entstanden sind.");
  AddDetail( ({"furchen"}),
   "Manche der Furchen sind mehrere Zentimeter tief, und ihre "
   "Kanten sehen aus, als waeren sie durch heftige Schlaege mit einem "
   "harten Gegenstand entstanden.");
  AddDetail( ({ "gegenstand","gegenstaende"}),
   "Gegenstaende siehst Du viele.");
  AddDetail( ({"kanten"}),
   "Die Kanten in der zerfurchten Oberflaeche sind hart und scharf.");
  AddSpecialDetail( ({"oberflaeche"}), "init_dragon");

  AddDetail( ({ "umgebung" }), QueryProp(P_INT_LONG));
  AddDetail( ({"ende"}),
   "Das des Weges natuerlich.");
   
    
  AddDetail( ({ "aeste","ast" }),
    "Die schweren Aeste neigen sich von beiden Seiten ueber den "
    "Weg und treffen sich in der Mitte.");
  AddDetail( ({"seiten", "seite"}),
    "Es gibt immer zwei davon.");
  AddDetail( ({"mitte"}),
    "Einfach Mitte halt.");
  AddDetail( ({ "kopf" }),
    "Die Aeste sind weit genug weg, dass Du Dir den Kopf nicht daran "
    "stossen kannst.");
  AddDetail( ({"gewoelbe"}),
    "Wie das Dach eines Tunnels biegen sich die schweren Aeste "
    "ueber den Weg.");
  AddDetail( ({"tunnel"}),
    "Ein Tunnel ist sowas wie ein Rohr durch etwas.");
  AddDetail( ({"rohr"}),
    "Du weisst sicher was ein Rohr ist.");
  AddDetail( ({"dach"}),
    "Das Dach hier besteht voellig aus Blaettern.");
  AddDetail( ({"blaetter"}),
    "Die Blaetter wachsen aus den Aesten.");
  AddDetail( ({"himmel"}),
    "Dein Blick zum Himmel wird von den zahlreichen Blaettern "
    "abgeschirmt.");
  AddDetail( ({"blick"}),
    "Du schaust.");
  AddDetail( ({"pfad"}),
    "Der Pfad biegt nach Osten ab.");
  AddDetail( ({"osten"}),
    "Dahin fuehrt der kleine Pfad, der sich von dem Weg auf dem "
    "Du Dich befindest abzweigt.");
  AddDetail( ({"boden"}),
    "Der Boden hier ist - wie nicht anders zu erwarten im Gebirge - "
    "felsig und mit Blaettern die von den umliegenden Baeumen kommen "
    "bedeckt.");
  AddDetail( ({"gebirge"}),
    "Alles was Dich umgibt gehoert dazu.");
  AddDetail( ({"baeume"}),
    "Zahlreiche davon saeumen den Weg.");  
  AddDetail( ({"weg"}),
    "Der Weg ist hier ziemlich breit und scheint haeufig "
    "begangen zu sein.");

  AddExit("norden", BASE "04-10");
  AddExit("sueden", BASE "04-08");
  AddExit("osten", BASE "05-09");
  
  AddItem(BASE+"/npc/steindrache", REFRESH_DESTRUCT);
}

string init_dragon()
{
  object ob;

  if (!ob = present("\nsteindrache", ME)
    || !ob->QueryProp(P_INVIS)) return "";


  TP->SetProp(P_PARALYZED,
   ([ PARALYZE_TIME: 999, 
      PARALYZE_MSG: "",
      PARALYZE_MSG_OTHER: "",
      PARALYZE_END: "",
      PARALYZE_END_OTHER: ""]));

  tell_object(TP, BS("Voller Bewunderung betrachtest Du die "
    "Oberflaeche des Felsens."));

  call_out("seq", 2);

  return "";
}


void seq()
{
  tell_object(TP, BS("Ein seltsames Gefuehl ueberkommt Dich als "
    "Du die Oberflaeche des Felsen betrachtest."));
  call_out("seq2", 4);
}

void seq2()
{
  tell_object(TP, BS("Wie eine eiskalte Hand kriecht es Deinen "
    "Ruecken hoch."));
  call_out("seq3", 4);
}

void seq3()
{
  tell_object(TP, BS("Dein Blut brennt sich wie Lava durch "
    "Deine Adern."));
  call_out("seq4", 4);
}

void seq4()
{
  tell_object(TP, BS("All Deine aufgestaute Wut, alle Deine "
    "Aggressionen scheinen sich zu einem gewaltigen Ausbruch zu "
    "sammeln."));
  tell_room(ME, BS(TP->Name(WER) + " scheint zu zittern."), ({TP}));
  call_out("seq5", 4);
}

void seq5()
{
  object w;
  string str;
  if (w = TP->QueryProp(P_WEAPON))
    {
      if (w->QueryProp(P_GENDER)== FEMALE) str = "Deine";
      else str="Dein";
      tell_object(TP, BS("Du nimmst " + str + " " +
        w->QueryProp(P_NAME) + " fester in die Hand."));
      if (TP->QueryProp(P_GENDER)== FEMALE)
        w->QueryProp(P_GENDER)== FEMALE?str="ihre":str="ihr";
      else
        w->QueryProp(P_GENDER)== FEMALE?str="seine":str="sein";
       tell_room(ME, BS(TP->Name(WER) + " nimmt " + str + " " +
         w->QueryProp(P_NAME) + " fester in die Hand."), ({TP}));
    }
  else
    {
      tell_object(TP, BS("Du ballst Deine Hand zur Faust."));
      tell_room(ME, BS(TP->Name(WER) + " ballt " + 
        TP->QueryPossPronoun(FEMALE, WEN) + " Hand zu einer Faust."),
        ({TP}));
    }

  call_out("seq6", 4);
}

void seq6()
{
  object w;
  string str;
  if (w = TP->QueryProp(P_WEAPON))
    {
      if (w->QueryProp(P_GENDER)== FEMALE) str = "Deiner";
      else str="Deinem";
      tell_object(TP, BS("Du holst mit " + str + " " +
        w->QueryProp(P_NAME) + " weit aus."));
      if (TP->QueryProp(P_GENDER)== FEMALE)
        w->QueryProp(P_GENDER)== FEMALE?str="ihre":str="ihr";
      else
        w->QueryProp(P_GENDER)== FEMALE?str="seiner":str="seinem";
       tell_room(ME, BS(TP->Name(WER) + " holt mit " + str + " " +
         w->QueryProp(P_NAME) + " weit aus."), ({TP}));
    }
  else
    {
      tell_object(TP, BS("Du holst mit Deiner Faust weit aus."));
      tell_room(ME, BS(TP->Name(WER) + " holt mit " + 
        TP->QueryPossPronoun(FEMALE, WESSEN) + " Faust weit aus."),
        ({TP}));
    }

  call_out("seq7", 6);
  
}

void seq7()
{
  object w;
  string str;
  if (w = TP->QueryProp(P_WEAPON))
    {
      if (w->QueryProp(P_GENDER)== FEMALE) str = "Deiner";
      else str="Deinem";
      tell_object(TP, BS("Mit einem gewaltigen Hieb schlaegst Du mit "+
        str + " " + w->QueryProp(P_NAME) + " auf den Fels."));
      if (TP->QueryProp(P_GENDER)== FEMALE)
        w->QueryProp(P_GENDER)== FEMALE?str="ihrer":str="ihrem";
      else
        w->QueryProp(P_GENDER)== FEMALE?str="seiner":str="seinem";
       tell_room(ME, BS(TP->Name(WER) + " schlaegt mit einem "
         "gewaltigen Hieb auf einen Felsen."), ({TP}));
    }
  else
    {
      tell_object(TP, BS("Mit einem gewaltigen Hieb schlaegst Du mit der geballten Faust auf den Felsen."));
      tell_room(ME, BS(TP->Name(WER) + " schlaegt mit einem gewaltigen Hieb auf einen Felsen."), ({TP}));
    }

  tell_room(ME, BS("Steinsplitter rieseln zu Boden."));

  call_out("seq8", 10);
  
}

void seq8()
{
  tell_room(ME, BS("Ploetzlich oeffnen sich dem Felsen zwei riesige wie blaue Diamanten schimmernde Augen."));
  call_out("seq9", 4);
}

void seq9()
{
  tell_room(ME, BS("Die Erde bebt als Bewegung in die Felsen geraet und sich ein gigantischer Drache langsam erhebt."));
  call_out("seq10", 4);
}

void seq10()
{
  tell_room(ME, BS("Schnell gehst Du einen Schritt zur Seite um nicht von herunterfallenden faustgrossen Felsbrocken getroffen zu werden."));
  call_out("seq11", 6);
}

void seq11()
{
  object ob;

  if (!ob = present("\nsteindrache", ME)) return;


  tell_room(ME, BS("Eine gewaltige Staubwolke fegt ueber Deinen "
    + "Kopf hinweg als der gewaltige Drache mit der Kraft "
    + "eines Orkans einen Lufstoss aus seinen Nuestern blaest."));

  ob->startup();
  TP->SetProp(P_PARALYZED, 0);
}

