inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

string eicheldetail();
string racebirds();

int eichel_dropped;

void create()
{
  if (IS_CLONE(TO)) return;

  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");

  SetProp(P_INT_LONG, _query_int_long());
  AddDetail( ({ "voegel" }),
    "Irgendwo hoch oben in den Wipfeln der Baeume tummeln sie sich. "
    "So, wie sich die kleinen Waldbewohner von einem Ast zum anderen "
    "schwingen, koennte man sie bei ungenauer Betrachtung fast fuer "
    "winzige Aeffchen halten.");
  AddDetail( ({ "bach" }),
    "Der Bach schein irgendwo neben den Weg durchs Unterholz zu "
    "fuehren.");
  AddDetail( ({ "weg", "pfad" }),
    "Du befindest Dich auf einem kleinen Weg durchs Gebirge.");
  AddDetail( ({ "gebirge" }),
    "So nennt sich diese Region hier.");
  AddDetail( ({ "region" }),
    "Die Region in der Du Dich befindest nennt sich 'Gebirge'.");
  AddDetail( ({ "unterholz" }),
    "Neben dem Weg liegen abgebrochene Aeste und Zweige sowie "
    "Blaetter, die im Laufe der Zeit von den Baeumen gefallen sind.");
  AddDetail( ({ "aeste", "aesten" }),
    "Bis zu armdicke Aeste sind teilweise durch Wind, aber vorwiegend "
    "gezeichnet von der Zeit von den Baeumen abgebrochen und zu "
    "Boden gefallen.");
  AddDetail( ({ "zweige" }),
    "Zweige, die Jungform von Aesten, liegen ueberall im Wald herum "
    "und sorgen verfaulender Weise fuer neuen Nachwuchs in "
    "Bodennaehe.");
  AddDetail( ({ "blaetter", "blaettern" }),
    "Wie ein natuerlicher Teppich ist beinahe der ganze Waldboden von "
    "braeunlichen Blaettern bedeckt. An einer Stelle zwischend den "
    "Blaettern kannst Du etwas Wasser durchschimmern sehen.");
  AddDetail( ({ "stelle" }), 
    "Als Du Dir die Stelle etwas genauer ansiehst, kannst Du das "
    "kleine Rinnsal erkennen, welches Du vorhin gehoert hast.");
  AddDetail( ({ "rinnsal"  }),
    "Das Wasser ist kristallklar, sicherlich kannst Du gefahrlos einen "
    "Schluck aus dem Rinnsal trinken.");
  AddDetail( ({ "wasser", "quellwasser" }),
    "Das Wasser scheint irgendwo nahe dem Boden zu fliessen.");
  AddDetail( ({ "schluck" }),
    "Du koenntest wohl einen Trinken.");
  AddDetail( ({ "ungeziefer" }),
    "Irgendetwas hartes, das gut in der Hand liegt und gute "
    "flugeigenschaften hat waer net.");
  AddDetail( ({ "hand" }),
    "Eine Nuss oder etwas aehnliches wuerde sich dafuer gut eignen - "
    "nur etwas schnittiger geformt.");
    

  AddDetail( ({ "wipfel", "wipfeln" }),
    #'eicheldetail);
    
  AddDetail( ({ "wind" }),
    "Der Wind rauscht gemaechlich durch die Baeume.");
  AddDetail( ({ "baeume", "baeumen" }),
    "Rund um Dich bilden die Baeume einen Wald.");
  AddDetail( ({ "wald" }),
    "Der Wald besteht hier erstaunlicher Weise aus Baeumen. Pfoah!");
  AddDetail( ({ "teppich" }),
    "Die Blaetter am Boden bilden einen regelrechten Teppich.");
  AddDetail( ({"boden", "waldboden", "waldbodens" }),
    "Inmitten des mit Blaettern bedecken Waldbodens wandelst Du auf "
    "einem kleinen Pfad.");
  AddDetail( ({ "aeffchen" }),
    "Nein, keine Aeffchen. Dafuer befindest Du Dich in der falschen "
    "Region.");
  AddDetail( ({ "blatt" }),
    "Ein Blatt segelt seelenruhig zu Boden.");
  AddDetail( ({ "ast" }),
    "Freudenstahlend betrachtest Du die maechtigen Aeste ueber Dir.");
  AddDetail( ({ "himmel" }),
    "Wie ueber Dir scheint der blaue Himmel stellenweise durch das "
    "dichte Blaetterdach.");
  AddDetail( ({ "blaetterdach", "dach" }),
    "Das Blaetterdach ist ein dichtes Werk aus Blaettern. Faszinierend!");
  AddDetail( ({ "werk" }),
    "Die Blaetter greifen beinahe nahtlos inneinander.");
  
  AddDetail( ({ "betrachtung", "bodennaehe", "engelsschwingen", 
    "erfrischung", "jungform", "kraft", "laufe", "nachwuchs",
    "naehe", "nuss", "trinken", "waldbewohner", "wanderschaft", "Weise",
    "zeit" }),
    "Das interessiert Dich gerade nicht wirklich.");

  AddCmd( ({ "trink", "trinke" }), "trinkfun");

  AddExit("nordosten", BASE "05-11");
  AddExit("sueden", BASE "04-09");


}


int trinkfun(string str)
{
  int drink;
  
  notify_fail("Woraus moechtest Du was trinken?\n");
  if (!str && str != "schluck aus rinnsal" && str != "schluck aus quelle")
    return 0;
  notify_fail("Soviel kannst Du jetzt nicht trinken!\n");
  if ((drink = TP->QueryProp(P_DRINK))<TP->QueryProp(P_MAX_DRINK))
    TP->SetProp(P_DRINK, drink+20);
  else return 0;
  tell_object(TP, BS("Du trinkst einen herzhaften Schluck Quellwasser "
    "und fuehlst Dich gleich viel erfrischter und erholter."));
  TP->AddHp(5);
  TP->AddSp(5);
  TP->do_exhaust(-5);
  tell_room(ENV(TP), BS(TP->Name(WER) + " beugt sich runter und scheint "
    "etwas zu trinken."), ({ TP }));
  return 1;
}


string eicheldetail()
{         
  if (!eichel_dropped)
    {
      tell_object(TP, BS("Als Du nach oben blickst, siehst Du etwas kleines "
        "braunes mit rasender Geschwindigkeit auf Dich zu sausen. "
        "Gerade als Du realisierst, dass Du ausweichen solltest, "
        "trifft Dich etwas hart am Kopf. *PLONK*"));
      SetProp(P_KILL_NAME, "Eine Eichel im Sturzflug");
      TP->do_damage(3);
      return BS("Du reibst Dir den Kopf.");
    }
}


string racebirds()
{  
  if (TP && TP->QueryProp(P_ALIGN)>=0)
    return "Der Gesang stimmt Dich frohmuetig.";
  return "Am liebsten wuerdest Du das Ungeziefer von den Baeumen schiessen.";
}
                      
                      
string _query_int_long()
{
  string txt;
  txt = sprintf("Froehlich zwitschern ein paar Voegel ueber Dir "
    "in den Baeumen. %s Hie und da gleitet ein Blatt wie "
    "auf Engelsschwingen gen Boden. Irgendwo in der Naehe hoerst Du "
    "leise einen Bach plaetschern. Durstig, wie Du nach Deiner "
    "Wanderschaft bist, koennte Dir ein Schluck kuehles Quellwasser "
    "Kraft und Erfrischung schenken.", racebirds());
    
  return BS(txt);
    
}

