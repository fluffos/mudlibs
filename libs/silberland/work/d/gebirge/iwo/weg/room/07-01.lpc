inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Beeindruckt von der Schoenheit der Landschaft die "
    "Dich umgibt schreitest Du weiter Deines Weges. Wo auch immer Dich "
    "Deine  Fuesse hintragen - die Wanderung durch die erfrischende "
    "Waldluft ueber Stock und Stein tut Koerper und Seele sicherlich wohl.");

  AddDetail( ({ "schoenheit" }),
    "Die Schoenheit des Waldes ist schon beeindruckend!");
  AddDetail( ({ "wald" }),
    "Er umgibt Dich von allen Seiten.");
  AddDetail( ({ "landschaft" }),
    "Eine malerische Waldlandschaft aus Baeumen und sonstigen Pflanzen.");
  AddDetail( ({ "pflanzen" }),
    "Naja Pflanzen halt - Du kennst auch nicht alle.");
  AddDetail( ({ "weg" }),
    "Du beschreitest Deinen Weg durchs Gebirge.");
  AddDetail( ({"gebirge"}),
    "Dazu gehoert alles hier.");
  AddDetail( ({"waldluft"}),
    "Kann man nicht sehen, fuehlen aber...");
  AddSmell( ({ DEFAULT_SMELL, "waldluft", "luft" }),
    "Die Luft hier riecht frisch und rein.");
  AddDetail( ({ "stock", "ast", "stoecke" }),
    "Hie und da liegt ein abgebrochener Ast auf dem Boden.");
  AddDetail( ({ "stein", "steine", "untergrund" }),
    "Kleine Steine sorgen fuer einen abwechslungsreichen Untergrund.");
  AddDetail( ({ "koerper" }), "Sieh Dich doch an!");
  AddDetail( ({ "seele" }),
    "Du solltest in Dich gehen um sie zu erforschen.");  
  AddDetail( ({ "weg", "pfad" }),
    "Ein breiter Pfad durch die tiefen Waelder des Gebirges.");
  AddDetail( ({ "waelder", "wald" }),
    "Du bist mitten drinnen.");
  AddDetail( ({ "baeume", "baeume" }),
    "Maechtige Baeume bilden den Wald hier.");
  AddDetail( ({ "boden" }),
    "Stoecke und Steine liegen am Boden.");
  AddDetail( ({ "himmel" }),
    "Du kannst ihn nicht erblicken durch die Baeume.");
  

  AddExit("westen", BASE "06-01");
  AddExit("suedosten", BASE "08-00");
  AddExit("suedwesten", "/d/gebirge/torian/luminor/room/wald1");

}

