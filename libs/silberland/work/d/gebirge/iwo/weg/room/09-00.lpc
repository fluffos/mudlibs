inherit "std/room";

#include "/d/gebirge/gebirge.h"
#include "defines.h"
#include "properties.h"
#include "moredef.h"
#include <room.h>

#include "def.h"

void create()
{
  if (IS_CLONE(TO)) return;
  
  ::create();

  SetProp(P_LIGHT, 1);

  SetProp(P_INT_SHORT, "Unterm Fels");
  
  SetProp(P_INT_LONG, "Der ausgelatschte Weg scheint recht haeufig "
   "begangen zu sein. Die malerische Umgebung aus Fels und Baum "
   "verleiht Deiner Wanderung einen Beigeschmack von Waldspaziergang. "
   "Weiter noerdlich von Dir baut sich die Burg Sturmfels vor Dir auf "
   "wo die glorreichen Paladine ueber diesen Teil des Gebirges "
   "herrschen.");

  AddDetail( ({"weg", "boden"}), 
   "Der steinige Boden bietet festen Halt und "
   "solange man nicht ueber irgendwelche Wurzeln stolpert eine "
   "recht sichere Basis fuer eine Wanderung durchs Gebirge.");
  AddDetail( ({"umgebung"}),
   "Du blickst Dich um und siehst Baeume, Felsen und sonstiges "
   "Waldzeugs.");
  AddDetail( ({"Waldzeugs"}),
   "Eigentlich nichts nennenswertes - Hier und dort steht ein "
   "Baeumchen rum, das eine oder andere Voeglein zwitschert und "
   "der Sonnenschein kitzelt Deine Nase.");
  AddDetail( ({"baum", "baeumchen", "baeume"}),
   "Die Baeume hier sehen wohl schon seit Anbeginn der Zeit so aus "
   "hier."); 
  AddDetail( ({"fels", "felsen","burg","hochebene"}),
   "Die vielen Felsen und das oft sehr zugige Klima gaben der nahen "
   "Hochebene und der gleichnamigen Burg ihren Namen: Sturmfels.");
  AddDetail( ({"wanderung"}),
   "Das sieht man nicht - das tut man.");
  AddDetail( ({"zeit"}),
   "Kann man nicht untersuchen.");
  AddDetail( ({"gebirge"}),
   "So nennt sich die Region in der Du Dich befindest.");
  AddDetail( ({"wurzeln"}),
   "Na gottseidank sind hier grad keine, sonst koenntest Du stuerzen "
   "und Dich boese verletzen.");
  AddDetail( ({"voeglein"}),
   "Irgendwo weit oben siehst Du eines rumflattern.");
  AddDetail( ({"sonnenschein", "schein"}),
   "Frech kitzelt er Deine Nase.");
  AddDetail( ({"himmel"}),
   "Das Bisschen Himmel das Du siehst ist aufgrund der Sonne zu "
   "hell als das Du was erkennen koenntest.");
  AddDetail( ({"sonne"}),
   "Du wendest Deinen Blick ab.");
  AddDetail( ({"blick"}),
   "Durch-");
   
  

  AddExit("westen", BASE "08-00");
  AddExit("osten", BASE "10-00");
  

}
