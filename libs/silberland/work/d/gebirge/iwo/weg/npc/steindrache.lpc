inherit "std/npc";

#include <defines.h>
#include <moving.h>
#include <combat.h>
#include <moredef.h>
#include <properties.h>
#include <new_skills.h>

#include "/p/service/iwo/group/group.h"

#pragma strong_types

#define BSA(x, y) break_string(x, 78, y)

string enter();

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_INVIS, 1);
  SetProp(P_FRIEND, 1);

  AddId(({ "\nsteindrache"}));

  SetProp(P_NAME, "Steindrache");
  SetProp(P_NAME_ADJ, "gewaltig");
  SetProp(P_GENDER, MALE);

  SetProp(P_SHORT, "Ein gewaltiger Steindrache");

  SetProp(P_LONG, "Die Haut des riesigen Drachen ist zerfurcht und "
    "gefaerbt wie die umliegenden Felsen. Haette er sich nicht bewegt "
    "haettest Du ihn niemals gefunden. Sein langer Schwanz kann Dir "
    "wuchtige Schlaege versetzen. Wie Blaue Diamanten strahlen "
    "seine grossen Augen. Dieses Wesen muss schon sehr alt sein und "
    "die Aura von Weisheit die ihn umgibt laesst Dich ehrfurchtsvoll "
    "den Kopf senken.");

  create_default_npc(30);

  SetProp(P_SIZE, 2000);

  SetProp(P_BODY, 800);

  SetProp(P_MAX_HP, 2000);
  SetProp(P_MAX_SP, 1000);

  SetProp(P_HP, 2000);
  SetProp(P_SP, 1000);

  SetProp(P_ALIGN, 300);

  SetProp(P_HANDS, ({ " mit seinen riesigen Klauen", 500, DT_BLUDGEON }));
  SetProp(P_RACE, "Drache");
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_TEMPERATURE_RANGE, ([0:-10, 1:50]));
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_FIRE      :-0.8,    DT_COLD      :-0.7,
        DT_WATER     :-0.6,    DT_AIR       :-0.4,
        DT_LIGHTNING :-0.5,    DT_EXPLOSION :-0.5,
        DT_SOUND     :-0.5,    DT_LIGHT     :-0.5,
        DT_ELECTRIC  :-0.5,    DT_ACID      :-0.7,
        DT_POISON    :-1.0,    DT_TERROR    :-0.9,
        DT_MAGIC     :-0.8,    DT_HOLY      :-0.7,
        DT_UNHOLY    :-0.7]));                              

  SetProp(P_SPELLRATE, 30);

  AddSpell(9,1000,
    "Der Drache verpasst Dir einen Schlag mit dem Schwanz.\n",
    "Der Drache verpasst @WEN eine Schlag mit dem Schwanz.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_KILL_NAME, "Zensiert");

  enable_commands();

  AddInfo( ({ "hilfe", "helfen" }),
    "lacht.\n"
    + "sagt: Du glaubst ich brauche Hilfe? Laecherlich! "
       +"sagt: Aber ich bin mir nicht sicher, ob Du nicht "
       + "sagt: welche brauchst!", "");
  AddInfo( ({ "arwenock" }),
    "Oh Arwenock... "
    "Arwenock war immer eine friedliche Stadt. Hauptsaechlich "
    "Haendler tummelten sich in ihr um Freunde zu treffen, "
    "zu plaudern und auch das eine oder andere Geschaeft "
    "abzuwickeln. Die verschiedensten Rassen trafen sich an "
    "diesem Ort um ohne Gewalt Erfahrungen und Schaetze "
    "auszutauschen.", "sagt: ");

  AddInfo( ({ "stadt" }),
    "Unweit von hier befindet sich eine grosse Stadt. In der "
    "gemeinesamen Sprache heisst sie 'Arwenock'.", "sagt: ");

  AddInfo( ({ "sprache" }),
    "Jede Rasse hat ihre eigene Sprache. Kaum wird diese noch "
    "verwendet, da es seit langer Zeit eine gemeinsame gibt, "
    "die besonders bei den Haendlern sehr beliebt ist.", "sagt: ");

  AddInfo( ({ "haendler", "handel" }),
    "Nirgends wird mehr gehandelt als im Staedtchen Arwenock. "
    "Alle Rassen und Gilden treffen sich dort um ihre Geschaefte "
    "abzuwickeln.", "sagt: ");

  AddInfo( ({ "berg" }),
    "Der Berg hier birgt ein schreckliches Geheimnis.", "sagt: ");
  AddInfo( ({ "geheimnis" }),
    "Tiefe Stollen durchziehen den Berg hier. Dunkle, boesartige "
    "Gestalten hausen dort.", "sagt: ");
  AddInfo( ({ "stollen" }),
    "Ich bewache den Eingang zu den Stollen damit keines dieser "
    "Geschoepfe des Boesen raus kann.", "sagt: ");
  AddInfo( ({ "eingang" }),
    "Nichts darf diesen Eingang passieren. Vielleicht wird eines "
    "tages eine Gruppe von Helden diese Plage von unserer Welt "
    "tilgen. Bis dahin gewaehre ich keinen Einlass.", "sagt: ");
  AddInfo( ({ "helfer", "gruppe" }),
    "Findet euch und formiert euch zum Kampf! Ohne Gruppenarbeit "
    "seid ihr zu erbaermlich.", "sagt: ");
  AddInfo( ({ "einlass" }), #'enter, "sagt: ");
    


  
}


string enter()
{
  string grp;

  // Ist der Fragende in einer Gruppe?
  if (!grp = GROUPMASTER->GroupAffiliation(TP))
    return ("Als Einzelkaempfer wirst Du hier nicht "
          +"weit kommen, " + TP->name(WER) + ". Finde "
          +"Helfer und kehre wieder.");

  // Weniger als 4 ist einfach zu gefaehrlich
  if (GROUPMASTER->NumMembers(grp)<4)
    return ("Ihr seid zu wenige! Sucht weitere Helfer!");

  // Unter einem durchscnittslevel von 30 ist es sinnlos
  if (GROUPMASTER->GroupAvgLvl(grp)<30)
    return ("Ihr seid zu schwach! So werdet ihr niemals "
          +"ueberleben koennen!");

  // Alle Bedingungen scheinen erfuellt, sie duerfen rein

  call_out("enter_group", 6, grp);


  return ("Na gut. Wie ich sehe seid ihr gut vorbereitet. "
         +"Ich werde euch Einlass gewaehren. Seid gewarnt: "
         +"Ueberall lauern Gefahren. Moegen die Goetter euch "
         +"beschuetzen!");
  
}


void enter_group(string grp)
{
  string *members;
  string *moved;
  int i;
  object ob;
  string otherstr;

  tell_room(ENV(ME), sprintf("Group: %s\n", grp));

  if (!grp || grp=="" || !GROUPMASTER->IsGroup(grp)) return 0;

  tell_room(ENV(ME), sprintf("Members: %O\n", grp, GROUPMASTER->GroupMembers(grp)));
  if (!members = GROUPMASTER->GroupMembers(grp)) return 0;

  moved = ({});


  for (i=0; i<sizeof(members); i++)
    {
      if (!ob = find_player(members[i])) continue;

      tell_room(ENV(ME), sprintf("PL:%s ENV:%O ME:%O\n", ob->name(), ENV(ob), ME));

      if (environment(ob) == ENV(ME))
        {
          moved += ({ ob->name(WEN) });
          tell_object(ob, BS("Der Drache macht platz und laesst "
            "Dich in die Hoehle."));

          ob->move("/d/gebirge/iwo/arwenock/cave/room/a08", 
            M_SILENT + M_NOCHECK);

        }

    }

  otherstr = "Der Drache macht platz und laesst ";

  otherstr += implode(moved, ", ");

  otherstr += " in die Hoehle.";

  tell_room(ME, BS(otherstr));
}



void startup()
{
  AddId( ({ "drache", "steindrache" }));
  SetProp(P_INVIS, 0);
  SetProp(P_FRIEND, 0);
  tell_room(ENV(ME), BS("Die Donnernde Stimme des Drachen erhebt "
    "sich und treibt Dir Angst in die Knochen."));
  tell_room(ENV(ME), BSA("Was wollt ihr sterbliche?", "Der gewaltige Steindrache sagt: "));
}


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object w;
  if (w = enemy->QueryProp(P_WEAPON))
    w->TakeFlaw(100);
  return ::Defend(dam, dam_type, spell, enemy);
}
