#define REVERSE 1


#define TARGET_TROLL "trollager"
#define TARGET_PALADIN "sturmfels"
#define TARGET_HAENDLER "midas"

#define TYPES ({ "paladin", "troll" })
#define RACES ({ "mensch", "zwerg", "troll", "elf", "hobbit" })


#define ROUTE 1
#define PATH 0
#define DST 1

#define LIBDB "/p/service/iwo/lib/db/db"

