#define P_WALKER_PATH "walker_path"
#define P_WALKER_POS "walker_pos"
#define P_WALKER_NOWALK "walker_nowalk"
#define P_WALKER_WAIT "walker_wait"
#define P_WALKER_CHATS "walker_chats"
#define P_WALKER_CHATFREQ "walker_chatfreq"

