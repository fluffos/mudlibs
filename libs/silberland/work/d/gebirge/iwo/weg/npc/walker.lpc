string *ReversePath(string *path)
{
  string *rpath;
  int i;
  
  DB("ReversePath");
  
  rpath = ({});
  
  for (i=sizeof(path); i>0; i--)
    rpath += ({ path[i-1] });
    
  return rpath;
}
*/

mixed *SearchRoute(string src, string dst, int depth, string *steps)
{
  mixed *myroute;
  mixed *froute;
  string *srcs;
  string *dsts;
  int i,j, found;
  
  froute = ({});
  srcs = ({});
  dsts = ({});
  
  if (depth>10) return 0;
  
  // Direct route forward
  if (member(ways, src) && member(ways[src, DST], dst))
      return ways[src, DST][dst];

/*
  // Direct route reverse
  if (member(ways, dst) && member(ways[dst, DST], src))
      return ReversePath(ways[dst, DST][src]);
*/      
  dsts = m_indices(ways[src, DST]);

  dsts -= ({ src });
  dsts -= steps;
  
   for (i=0; i < sizeof(dsts); i++)
    {
      froute = SearchRoute(dsts[i], dst, depth+1, steps + ({ dsts[i] }));
      if (sizeof(froute)>0)
        {
	  myroute = GetRoute(src, dsts[i]);
	  return myroute + froute;
	}
    }

  return ({});
}


string *GetRoute(string src, string dst)
{
  string *path;
  string *tpath;
  int i;
  string *a_h;
  int found;
  string *dsts;

  path  = ({});
  tpath = ({});
  

  // Direct route forward
  if (member(ways, src) && member(ways[src, DST], dst))
      return ways[src, DST][dst];

  // Cached?
  if (member(cache, sprintf("%s-%s", src, dst)))
    {
      path = ({ "sag Aah, den Weg kenn ich" }) + cache[sprintf("%s-%s", src, dst), 0];
      return path;
    }


/*
  // Direct route reverse
  if (member(ways, dst) && member(ways[dst, DST], src))
      return ReversePath(ways[dst, DST][src]);  
*/
  // Looks bad, now check if src and dst exit
  if (member(stations, src)<0) return ({ "sag Start existiert nicht" });
  if (member(stations, dst)<0) return ({ "sag Ziel existiert nicht" });
  
  
  // Now tree search... this is very, VERY expensive!!!
  dsts = m_indices(ways[src, DST]);
  
  // Now for each destination test all destinations
  for (i=0;i<sizeof(dsts);i++)
    {
      path = SearchRoute(dsts[i], dst, 0, ({ src, dsts[i] }));
      if (sizeof(path)>0) 
        {
	  tpath = ways[src, DST][dsts[i]];
	  break;
	}
    }
  
  //path = SearchRoute(src, dst, 0);

  if (!sizeof(path)>0) return ({ "sag Keine Route!" });

  path += ({ "sag Ah, endlich da!" });

  cache += ([ sprintf("%s-%s", src, dst): tpath + path ]);

  //DB(sprintf("%O \n\n tpath: %O", path, tpath));
  
  return tpath + path;
}

int wandern()
{
  Walk();
  return 1;
}


void StartMnpc()
{
  string *hp;
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_SPECIAL + MOV_MOVES);
  SetProp(P_MNPC_WAIT, random(20)+5);
  hp = explode(file_name(ENV(ME)), "/");
  hp -= ({ hp[sizeof(hp)-1] });
  SetProp(P_MNPC_AREA, sprintf("/%s", implode(hp, "/")));
  SetProp(P_WALKER_WALKS, 0);
  SetProp(P_MNPC_DEFAULTROOM, file_name(ENV(ME)));
  SetProp(P_WALKER_NOWALK, 1);
  call_out("StopNowalk", 30);
  return (void) ::wandern();
}


void Walk()
{
  int index;
  string cmd;
  string *path;
  string *hp;
  string *dsts;
  string mypos;

  while (remove_call_out("Walk") != -1);


  if (pointerp(QueryProp(P_WALKER_CHATS)) 
    && random(100)>=QueryProp(P_WALKER_CHATFREQ))
    command_me(sprintf("sag %s", 
      QueryProp(P_WALKER_CHATS)[random(sizeof(QueryProp(P_WALKER_CHATS)))]));

  if (QueryProp(P_WALKER_WALKS) == 0)
    {
      if (QueryProp(P_WALKER_NOWALK)==0)
        {
          if (member(known_rooms, file_name(ENV(ME))))
            {
              SetProp(P_MNPC_FLAGS, 0);
              mypos = known_rooms[file_name(ENV(ME)),0];
              dsts = fqdsts - ({ mypos });
              return (void) MakeMeWalk(mypos, dsts[random(sizeof(dsts))]);
            }
        }
     if (!(QueryProp(P_MNPC_FLAGS) & MOV_MOVES))
       StartMnpc(); 

     return (void) ::wandern();
    }

  
  index = SetProp(P_WALKER_POS, QueryProp(P_WALKER_POS)+1)-1;
  
  path = QueryProp(P_WALKER_PATH);
  
  if (index >= sizeof(path))
    return (void) StartMnpc();

  cmd = path[index];     
  
  if (!command_me(cmd))
    {
      command_me("sag Ui, da hats was. I hab mi verrrent...");
      return (void) StartMnpc();
    }

  call_out("Walk", QueryProp(P_WALKER_WAIT)
                   + random(QueryProp(P_WALKER_WAIT)));
}


void MakeMeWalk(string src, string dst)
{
  string *path;
  string *walkcmds;

  path = GetRoute(src, dst);

  SetProp(P_WALKER_WALKS, 1);
  SetProp(P_WALKER_PATH, path);
  SetProp(P_WALKER_POS, 0);    

  Walk();
}


void Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int elev;

  elev = enemy->QueryProp(P_LEVEL);

  if (elev < 15 && QueryProp(P_LEVEL)>elev+5)
  {
    tell_object(enemy, BS(TO->Name(WER) + 
      " laesst sich von Dir nicht aus der Ruhe bringen."));

    tell_room(ENV(ME), BS(TO->Name(WER) + " laesst sich von " +
      enemy->name(WEM) + " nicht aus der Ruhe bringen."), ({ enemy }));

    enemy->StopHuntFor(ME, 1);
    ME->StopHuntFor(enemy, 1);
    return;
  }
  if (QueryProp(P_WALKER_TYPE)=="paladin")
    catch("/gilden/paladine/master/npcmaster"->AddFeind(enemy));
  return (void) ::Defend(dam, dam_type, spell, enemy);   
}


void init()
{
  int pala_enemy;

  ::init();
  if (TP && TP->id("walker"))
    if (TP->QueryProp(P_WALKER_TYPE) == QueryProp(P_WALKER_TYPE))
       AddDefender(TP);
  if (TP && QueryProp(P_WALKER_TYPE) == "paladin")
    {
      catch(pala_enemy = 
        "/gilden/paladine/master/npcmaster"->IsPaladinEnemy(TP));
      if (pala_enemy) Kill(TP);
    }

}


void InformDefend(object enemy)
{
  int elev;
  elev = enemy->QueryProp(P_LEVEL);
  if (elev < 15 && QueryProp(P_LEVEL)>elev+5) return;
  Kill(enemy);
}


void StopNowalk()
{
  SetProp(P_WALKER_NOWALK, 0);
}
