#include "../def.h"

inherit "std/thing";

int remainingResets, countdown;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Hydramutterblut");
  SetProp(P_INVIS, 1);

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Blut der Hydramutter");
  SetProp(P_GENDER, NEUTER);
  AddId("\nhydramutterblut");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_BLOOD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  countdown = 1;
}

public void Activate() {
    if(!living(ENV(TO))) {
        remove();
        return;
    }

    remainingResets = 10;
    ENV(TO)->AddResistanceModifier(([DT_ACID: -0.5, DT_POISON: -0.5]));
    SetProp(P_X_MAX_HEALTH_MOD,([P_HP:5,P_SP:5]));
    SetProp(P_X_HEALTH_MOD,([P_HP:5,P_SP:5]));
    ENV(TO)->UpdateAttributes();
}

public void reset() {
    ::reset();

    if(!is_clone(TO)) return;

    if(!living(ENV(TO))) {
        remove();
        return;
    }

    if(!countdown) return; // nur bei eingeloggtem spieler runterzaehlen

    if(--remainingResets>0) {
        tell_object(ENV(TO), BS("Die Wirkung des Bluts der Hydramutter wird schwaecher."));
    } else {
        tell_object(ENV(TO), BS("Das Blut der Hydramutter loest sich auf. Du fuehlst dich wieder normal."));
        remove();
    }
}

public void BecomesNetAlive(object spieler) {
    if(spieler == ENV(TO)) {
        countdown = 1;
    }
    return;
}

public void BecomesNetDead(object spieler) {
    if(spieler == ENV(TO)) {
        countdown = 0;
    }
    return;
}

public string extra_look() {
    return Name(WER)+" ist vom Blut der Hydramutter ueberzogen, das Blasen auf der Haut wirft.\n";
}

public int remove(int silent) {
    SetProp(P_X_HEALTH_MOD, 0);
    SetProp(P_X_MAX_HEALTH_MOD, 0);
    ENV(TO)->UpdateAttributes();
    return ::remove(silent);
}
