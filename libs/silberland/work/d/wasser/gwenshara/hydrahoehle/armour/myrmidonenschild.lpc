#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein antiker Myrmidonenschild");
  SetProp(P_LONG,
    "Dieser Bronzeschild ist mit einer uralten Patina versehen. Er zeigt die "
    "abgetrennten Koepfe einer Hydra. Frueher wurden solche Schilde von den "
    "Koenigen auf Hypros in die Schlacht gegen die vielkoepfigen Monster "
    "gefuehrt.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Myrmidonenschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "bronzeschild", "myrmidonenschild"}) );

  SetProp(P_NAME_ADJ, "uralt" );
  AddAdjective( ({"uralten","uralter","uraltem","uraltes","uralte"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_BRONCE );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 17);
  SetProp(P_QUALITY_DECAY, ([0: 30, DT_ACID: 0]));
;
  SetProp(P_DEFEND_FUNC, TO );

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES + ([DT_ACID: 1]) );

  SetProp(P_INFO, BS("Dieser Schild wurde fuer den Kampf gegen Hydren entwickelt.") );
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
    if(enemy->QueryProp(P_RACE) == "Hydra") return random(20);
    return 0;
}
