#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Ein enger Kanal, durch den ein heulender Wind weht, erstreckt sich durch "
    "die Hoehle. Der beissende Geruch von Saeure begleitet den Wind, der die "
    "Umgebung noch unwirklicher erscheinen laesst. Die schmalen Waende verstaerken "
    "das Heulen des Windes, und das laute Zischen des saeurehaltigen Dampfes macht "
    "die Enge des Kanals bedrohlich.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

AddDetail(({ "boden" }),
"Der Boden des Kanals ist schmal und uneben, bedeckt mit einer rutschigen Substanz.");

AddDetail(({ "dampfes" }),
"Saeurehaltiger Dampf zischt laut durch den Kanal und verursacht einen beissenden Geruch in der Luft.");

AddDetail(({ "enge" }),
"Die Enge des Kanals verstaerkt das laute Zischen des saeurehaltigen Dampfes und erzeugt eine bedrohliche Atmosphaere.");

AddDetail(({ "geruch" }),
"Ein beissender Geruch von Saeure begleitet den heulenden Wind im Kanal, durchdringt die Luft und verstaerkt das Unwohlsein.");

AddDetail(({ "heulen" }),
"Ein heulender Wind durchzieht den engen Kanal, verstaerkt durch die schmalen Waende, die das Geraeusch reflektieren.");

AddDetail(({ "himmel" }),
"Der Himmel ist nicht sichtbar in diesem engen Kanal, nur der beissende Geruch von Saeure und das laute Zischen des Dampfes erfuellen die Luft.");

AddDetail(({ "hoehle" }),
"Die Hoehle wird von einem engen Kanal durchzogen, in dem der beissende Geruch von Saeure und das laute Zischen des Dampfes praesent sind.");

AddDetail(({ "kanal" }),
"Ein enger Kanal erstreckt sich durch die Hoehle, begleitet von einem heulenden Wind und dem lauten Zischen von saeurehaltigem Dampf.");

AddDetail(({ "saeure" }),
"Der beissende Geruch von Saeure haengt schwer in der Luft des Kanals und verursacht Unwohlsein.");

AddDetail(({ "umgebung" }),
"Die Umgebung im engen Kanal wird von den schmalen Waenden, dem heulenden Wind und dem beissenden Geruch von Saeure gepraegt.");

AddDetail(({ "waende", "wand" }),
"Die schmalen Waende des Kanals verstaerken das heulende Geraeusch des Winds und geben dem Zischen des saeurehaltigen Dampfes eine bedrohliche Note.");

AddDetail(({ "wind" }),
"Ein heulender Wind weht durch den engen Kanal, und sein Geraeusch wird von den schmalen Waenden reflektiert.");

AddDetail(({ "zischen" }),
"Das laute Zischen des saeurehaltigen Dampfes erfuellt den Kanal und traegt zur bedrohlichen Atmosphaere bei.");

AddDetail(({ "atmosphaere" }),
"Die Atmosphaere im engen Kanal ist von bedrohlichem Unwohlsein gepraegt, begleitet vom beissenden Geruch von Saeure.");

AddDetail(({ "dampf" }),
"Saeurehaltiger Dampf zischt laut durch den Kanal und traegt zur bedrohlichen Atmosphaere bei.");

AddDetail(({ "decke" }),
"Die Decke des Kanals ist nicht sichtbar, versteckt hinter saeurehaltigem Dampf und der Dunkelheit des engen Raums.");

AddDetail(({ "geraeusch" }),
"Das laute Zischen des saeurehaltigen Dampfes und das heulende Geraeusch des Winds erfuellen den engen Kanal.");

AddDetail(({ "luft" }),
"Die Luft im engen Kanal ist mit dem beissenden Geruch von Saeure gesaettigt, was ein Gefuehl des Unwohlseins verstaerkt.");

AddDetail(({ "note" }),
"Die Luft traegt eine bedrohliche Note, begleitet vom beissenden Geruch von Saeure, der die Sinne beeintraechtigt.");

AddDetail(({ "substanz" }),
"Der Boden des Kanals ist bedeckt mit einer rutschigen Substanz, die das Gehen erschwert.");

AddDetail(({ "unwohlsein" }),
"Ein allgegenwaertiges Gefuehl des Unwohlseins durchdringt die Luft im engen Kanal, verstaerkt durch den beissenden Geruch von Saeure.");

AddDetail(({ "dunkelheit", "licht" }),
"Die Dunkelheit im engen Kanal ist nahezu undurchdringlich, nur vom fahlen Licht der Hoehle beleuchtet.");

AddDetail(({ "gefuehl" }),
"Ein beklemmendes Gefuehl durchzieht die Luft im engen Kanal, verstaerkt durch den beissenden Geruch von Saeure.");

AddDetail(({ "gehen" }),
"Das Gehen im engen Kanal gestaltet sich schwierig aufgrund des unebenen Bodens und der rutschigen Substanz.");

AddDetail(({ "raums", "raum" }),
"Der enge Raum des Kanals ist erfuellt von bedrohlicher Dunkelheit, dem heulenden Wind und dem lauten Zischen von saeurehaltigem Dampf.");

AddDetail(({ "sinne" }),
"Die Sinne werden im engen Kanal von der Dunkelheit, dem beissenden Geruch von Saeure und den unheimlichen Geraeuschen beansprucht.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordwesten", ROOM "h_6" );
  AddExit( "suedosten", ROOM "j_8");

  AddItem( ({NPC "hydra_klein", NPC "hydra_mittel", NPC "hydra_gross"}), REFRESH_DESTRUCT);
}

