#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein Schrein der Monstermutter");
  SetProp(P_INT_LONG,
    "Ein uraltes Relikt vergangener Tage der Insel thront vor dir in der duesteren "
    "Hoehle: ein Schrein, der der gefuerchteten Mutter der Monster gewidmet ist. "
    "Die Waende tragen die Zeichen der Zeit in Form verwitterter Glyphen und "
    "zerfallener Ikonen, die die einstige Pracht des Schreins verdeutlichen. Ein "
    "fahler Schein umgibt den Altar, gemeisselt aus glattem, schwarzem Gestein, das "
    "von den Jahrhunderten gezeichnet ist. Stille herrscht waehrend der Schrein "
    "als ehrwuerdiges Relikt die Legenden und Schrecken laengst vergangener Zeiten "
    "in der duesteren Hoehle bewahrt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail(({ "altar" }),
  "Der Altar ist aus glattem, schwarzem Gestein gemeisselt und von einem fahlen Schein umgeben.");

  AddDetail(({ "boden", "schlamm" }),
  "Der Boden besteht aus schwarzem Schlamm, der von saeurehaltigen Daempfen durchzogen ist.");

  AddDetail(({ "form" }),
  "Die Formen der verwitterten Glyphen und zerfallenen Ikonen erzaehlen von vergangenen Tagen.");

  AddDetail(({ "gestein" }),
  "Das Gestein des Altars ist glatt und schwarz, gezeichnet von den Jahrhunderten der Existenz.");

  AddDetail(({ "glyphen" }),
  "Die Glyphen auf den Waenden sind verwittert, tragen aber die Spuren alter Schriftzeichen.");

  AddDetail(({ "hoehle" }),
  "Die Hoehle ist weitlaeufig und von duesterer Atmosphaere erfuellt, als ob sie die Schatten der Vergangenheit bewahrt.");

  AddDetail(({ "ikonen" }),
  "Die Ikonen sind zerfallen und tragen Spuren einstiger Pracht, die nun vergaenglich erscheint.");

  AddDetail(({ "insel" }),
  "Die Zeichen auf den Waenden erzaehlen von der Geschichte der Insel, eingraviert in das Gestein.");

  AddDetail(({ "jahrhunderten" }),
  "Die Jahrhunderte haben ihre Spuren auf dem Altar hinterlassen, der die Zeit ueberdauert hat.");

  AddDetail(({ "legenden" }),
  "Die Legenden sind in den Glyphen und Ikonen verewigt, stille Zeugen vergangener Tage.");

  AddDetail(({ "monster", "mutter" }),
  "Die Mutter der Monster wird in den Symbolen des Schreins verehrt, ihre Praesenz spuerbar im Raum.");

  AddDetail(({ "pracht" }),
  "Die einstige Pracht des Schreins ist verblasst, aber die Erinnerung daran lebt in den Glyphen weiter.");

  AddDetail(({ "relikt" }),
  "Der Schrein ist ein uraltes Relikt vergangener Tage, ein ehrwuerdiges Zeugnis vergangener Mysterien.");

  AddDetail(({ "schein" }),
  "Ein fahler Schein umgibt den Altar, als ob er von einer geheimnisvollen Energie durchdrungen waere.");

  AddDetail(({ "schrecken" }),
  "Die Schrecken vergangener Zeiten scheinen in den Schatten des Schreins gefangen zu sein.");

  AddDetail(({ "schrein" }),
  "Der Schrein steht majestaetisch im Raum, der Mutter der Monster gewidmet, ein Ort der dunklen Verehrung.");

  AddDetail(({ "tage" }),
  "Die Zeichen der vergangenen Tage sind in den verwitterten Glyphen und zerfallenen Ikonen eingraviert.");

  AddDetail(({ "waende" }),
  "Die Waende tragen die Zeichen der Zeit, bedeckt mit verwitterten Glyphen und Spuren vergangener Geschichten.");

  AddDetail(({ "zeichen" }),
  "Die Zeichen auf den Waenden erzaehlen von den Mysterien der Vergangenheit, in das Gestein eingraviert.");

  AddDetail(({ "zeit" }),
  "Die Zeit hat ihre Spuren auf dem Altar hinterlassen, der die Geschichten der Vergangenheit bewahrt.");

  AddDetail(({ "atmosphaere" }),
  "Die Atmosphaere in der Hoehle ist duester und von einer unheilvollen Energie durchzogen.");

AddDetail(({ "daempfen" }),
  "Saeurehaltige Daempfe durchziehen den Raum, verleihen der Umgebung eine zusaetzliche bedrohliche Note.");

AddDetail(({ "decke" }),
  "Die Decke der Hoehle ist hoch und von schimmernden Felsformationen gepraegt.");

AddDetail(({ "energie" }),
  "Eine geheimnisvolle Energie scheint den Altar zu umgeben und verleiht dem Raum eine besondere Aura.");

AddDetail(({ "erinnerung" }),
  "Die Erinnerung an vergangene Tage lebt in den verwitterten Glyphen und zerfallenen Ikonen fort.");

AddDetail(({ "existenz" }),
  "Die Existenz des Schreins ist ein Zeugnis fuer laengst vergangene Mysterien und Rituale.");

AddDetail(({ "geschichte" }),
  "Die Geschichte der Insel ist in den Schriftzeichen auf den Waenden eingraviert.");

AddDetail(({ "jahrhunderte" }),
  "Die Jahrhunderte haben ihre Spuren auf dem Altar und den Waenden hinterlassen.");

AddDetail(({ "mysterien" }),
  "Die Mysterien vergangener Zeiten scheinen in jedem Symbol des Schreins verborgen zu sein.");

AddDetail(({ "ort" }),
  "Der Schrein ist ein unheiliger Ort der dunklen Verehrung.");

AddDetail(({ "praesenz" }),
  "Die Praesenz der Mutter der Monster ist spuerbar, durchdringt den Raum mit einer duesteren Aura.");

AddDetail(({ "raum" }),
  "Der Raum ist weitlaeufig und erfuellt von duesterer Atmosphaere, als wuerde er die Schatten der Vergangenheit bewahren.");

AddDetail(({ "schatten" }),
  "Die Schatten des Schreins nehmen jeden Winkel des Raumes ein, als wuerden sie die Dunkelheit selbst umarmen.");

AddDetail(({ "schriftzeichen" }),
  "Die Schriftzeichen auf den Waenden erzaehlen eine geheimnisvolle Geschichte, in alten Sprachen verfasst.");

AddDetail(({ "spuren" }),
  "Spuren vergangener Tage sind in jedem Detail des Schreins praesent.");

AddDetail(({ "symbolen" }),
  "Die Symbole des Schreins sind geheimnisvoll und tragen die Last vergangener Verehrung.");

AddDetail(({ "verehrung" }),
  "Der Schrein ist ein Ort der dunklen Verehrung, in dem die Mutter der Monster huldigt wird.");

AddDetail(({ "vergangenheit" }),
  "Die Vergangenheit ist lebendig in den verwitterten Glyphen und den Symbolen des Schreins.");

AddDetail(({ "wand" }),
  "Die Waende der Hoehle sind mit verwitterten Glyphen bedeckt, Zeugnisse vergangener Ereignisse.");

AddDetail(({ "zeugen" }),
  "Die Zeugen vergangener Tage sind in den Symbolen und Schriftzeichen des Schreins gegenwaertig.");

AddDetail(({ "zeugnis" }),
  "Der Schrein selbst ist ein eindrucksvolles Zeugnis fuer die dunklen Mysterien und Rituale.");

  AddDetail(({ "aura" }),
    "Eine duestere Aura durchdringt den Raum, als ob die Mutter der Monster selbst ihre Praesenz in jedem Winkel manifestiert.");

  AddDetail(({ "daempfe" }),
    "Saeurehaltige Daempfe durchziehen den Raum und verleihen der Umgebung eine zusaetzliche bedrohliche Note.");

  AddDetail(({ "detail" }),
    "Jedes Detail des Schreins traegt die Spuren der Zeit und der dunklen Verehrung.");

  AddDetail(({ "dunkelheit" }),
    "Die Dunkelheit herrscht in der Hoehle, nur durchbrochen vom fahlen Schein um den Altar.");

  AddDetail(({ "ereignisse" }),
    "Die Waende zeugen von vergangenen Ereignissen, eingraviert in verwitterten Glyphen.");

  AddDetail(({ "felsformationen" }),
    "Schimmernde Felsformationen ragen hoch ueber dir, verleihen dem Raum eine majestaetische Struktur.");

  AddDetail(({ "last" }),
    "Die Last vergangener Verehrung liegt schwer in der Atmosphaere, eingefangen in den Symbolen des Schreins.");

  AddDetail(({ "note" }),
    "Die Luft ist erfuellt von einer bedrohlichen Note, als ob die Dunkelheit selbst in jedem Atemzug praesent waere.");

  AddDetail(({ "rituale" }),
    "Die Rituale vergangener Zeiten sind in den Symbolen des Schreins eingraviert, als stumme Zeugen der dunklen Praktiken.");

  AddDetail(({ "sprachen" }),
    "Die Schriftzeichen auf den Waenden sind in alten Sprachen verfasst, die nur wenige verstehen.");

  AddDetail(({ "symbol" }),
    "Jedes Symbol auf dem Altar traegt eine besondere Bedeutung, verbunden mit der Mutter der Monster.");

  AddDetail(({ "symbole" }),
    "Die Symbole des Schreins sind geheimnisvoll und tragen die Last vergangener Verehrung.");

  AddDetail(({ "umgebung" }),
    "Die Umgebung der Hoehle ist von duesterer Atmosphaere erfuellt, als wuerde sie die Schatten der Vergangenheit bewahren.");

  AddDetail(({ "winkel" }),
    "Die Schatten nehmen jeden Winkel des Raumes ein, als wuerden sie die Dunkelheit selbst umarmen.");

  AddDetail(({ "zeugnisse" }),
    "Die Zeugnisse vergangener Tage sind in jedem Detail des Schreins praesent, stumm die Mysterien bewahrend.");

  AddDetail(({ "atemzug" }),
    "Jeder Atemzug in der Hoehle scheint von der duesteren Atmosphaere der Umgebung durchdrungen zu sein.");

  AddDetail(({ "bedeutung" }),
    "Jedes Symbol auf dem Altar traegt eine tiefgreifende Bedeutung, verbunden mit der Mutter der Monster.");

  AddDetail(({ "luft" }),
    "Die Luft in der Hoehle ist von einer bedrohlichen Note erfuellt, als ob die Dunkelheit selbst in jedem Atemzug praesent waere.");

  AddDetail(({ "praktiken" }),
    "Die dunklen Praktiken vergangener Zeiten sind in den Symbolen des Schreins eingraviert, als stumme Zeugen der duesteren Rituale.");

  AddDetail(({ "struktur" }),
    "Die majestaetische Struktur der Felsformationen ueber dir verleiht dem Raum eine imposante und geheimnisvolle Atmosphaere.");


//--Ausgaenge--------------------------------------------------------------
  AddExit( "nordwesten", ROOM "l_5" );  
  
  AddItem(NPC "fendezech", REFRESH_DESTRUCT);

  AddCmd("bete|bet", "cmd_beten");
  AddCmd("bete|bet&an|bei&alatar|schrein", "cmd_beten", "Wo willst du beten?");
}

public int cmd_beten() {
  write(BS("Du kniest nieder und betest zur Mutter der Monster. Ein kalter Schauer laeuft dir den Ruecken hinab."));
  say(BS(TPN+" betet zur Mutter der Monster. Unheimlich..."));
  TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-random(10));
  TP->AddHp(-5);
  return 1;
}

public void init() {
  ::init();

  if(TP->QueryProp(P_GUILD) == "waldlaeufer" && objectp(present(RANGER_TASK_SCHUPPE2, TP))) {
    call_out("ranger_quest", 0, TP, 0);
  }

  return;
}

public void ranger_quest(object who, int step) {
  object ob;
  if(!objectp(who)) return;
  if(!present(who)) return;
  if(!objectp(ob=present("\nhydrahoehle_priester"))) {
    ob = clone_object(NPC "fendezech");
    ob->move(TO, M_GO);
  }

  switch(step) {
    case 0: 
    
      tell_room(TO, BS("Eine verhuellte Gestalt tritt aus den Schatten und verneigt sich kurz for Fendezech. Sie scheinen dich nicht bemerkt zu haben."));
      break;
    case 1: tell_room(TO, BS("Vorsichtig drueckst du dich in die Schatten und beobachtest weiter.")); break;
    case 2: tell_room(TO, BS("Die verhuellte Gestalt fragt: Ist es bereit, oh maechtiger Diener der Mutter aller Monster?\n")); break;
    case 3: tell_room(TO, BS("Fendezech nickt und wispert: Wie versprochen, mein Herr!")); break;
    case 4: tell_room(TO, BS("Fendezech humpelt zum Altar und oeffnet eine verborgene Platte.")); break;
    case 5: tell_room(TO, BS("Als er sich wieder umdreht hat er eine widerliche, sich windende Made von der groesse eines Kleinkindes in der Hand.")); break;
    case 6: tell_room(TO, BS("Die verhuellte Gestalt nickt zufrieden.")); break;
    case 7: tell_room(TO, BS("Die verhuellte Gestalt sagt: Sehr gut. Der Meister wird zufrieden sein.")); break;
    case 8: tell_room(TO, BS("Der Verkrueppelte ueberreicht der Gestalt die Made. Ploetzlich trittst du auf einen losten Stein und das Geraeusch hallt durch die Hoehle!")); break;
    case 9: tell_room(TO, BS("Fendezech ruft: He da! Wer ist da? Komm heraus und stell dich!")); break;
    case 10: tell_room(TO, BS("Die vermummte Gestalt erblickt dich und flucht: Einer von Raziels Spionen! Schnell!")); break;
    case 11: tell_room(TO, BS("Schnell laeuft die Gestalt auf dich zu und verpasst dir einen Fusstritt. Du faellst zu Boden!")); break;
    case 12: tell_room(TO, BS("Als die Gestalt ueber dich steigt kannst du ein vernarbtes Gesicht darunter erkennen. Das wirst du dir merken!")); 
             tell_object(who, BS("Du solltest rasch zu Raziel zurueckkehren und ihm berichten!"));
             call_other("/gilden/waldlaeufer/master/master", "SetTask",  getuid(TP), 4);
             present(RANGER_TASK_SCHUPPE2, who)->remove();
             break;
    default:
          tell_object(who, BS("Fendezech nimmt seinen Speer in die Hand und stuerzt sich heulend auf dich."));
          tell_room(TO, BS("Fendezech kreischt: NIEMAND KANN UNS AUFHALTEN! DIE LETZTE KREATUR WIRD KOMMEN!!!"));
          ob->Kill(who);
          return;
          break;
  }

  call_out("ranger_quest", 4, who, ++step);
}
