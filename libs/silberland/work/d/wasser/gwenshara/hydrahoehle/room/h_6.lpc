#include "../def.h"
#include <lightsource.h>

inherit "std/room";

int bigboy;

void create() {
  ::create();
  bigboy = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Die Hoehle oeffnet sich zu einer tiefen Schlucht, erfuellt von saeurehaltigem "
    "Dampf. Haengende Wurzeln baumeln von der Decke, und der bodenlose Abgrund "
    "erzeugt ein Gefuehl von beklemmender Unbekanntheit in der kalten Dunkelheit. "
    "Das Echo deiner Schritte wird von den steilen Waenden reflektiert, und die "
    "tiefen Rufe von Monstern hallen in der schattenhaften Schlucht wider.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "abgrund" }),
    "Du starrst in endlose Schwaerze und Dunkelheit. Irgendetwas bewegt sich "
    "dort unten. Wenn du dort unten nur fuer etwas Licht sorgen koenntest, "
    "dann koenntest du erkennen was das ist.");

  AddDetail( ({"licht"}),
    "Eine Fackel oder sowas ware wohl passend.");

  AddDetail( ({"fackel"}),
    "Die muesste jetzt nur da unten und nicht hier sein.");

    AddDetail(({ "boden" }),
    "Der Boden der Hoehle ist hier uneben und fuehrt zu einem bodenlosen Abgrund.");

  AddDetail(({ "dampf" }),
    "Saeurehaltiger Dampf erfuellt die Hoehle, und sein beissender Geruch haengt in der Luft.");

  AddDetail(({ "decke" }),
    "Haengende Wurzeln baumeln von der Decke und vermitteln ein Gefuehl von beklemmender Unbekanntheit.");

  AddDetail(({ "dunkelheit" }),
    "Die kalte Dunkelheit der Schlucht laesst nur das Echo deiner Schritte erahnen.");

  AddDetail(({ "echo" }),
    "Das Echo deiner Schritte wird von den steilen Waenden der Schlucht reflektiert.");

  AddDetail(({ "gefuehl" }),
    "Das Gefuehl von beklemmender Unbekanntheit erfasst dich in der kalten Dunkelheit der Schlucht.");

  AddDetail(({ "himmel" }),
    "Der Himmel ist nicht sichtbar in dieser tiefen Schlucht, nur endlose Dunkelheit erstreckt sich ueber dir.");

  AddDetail(({ "hoehle" }),
    "Die Hoehle oeffnet sich zu einer tiefen Schlucht, gefuellt mit saeurehaltigem Dampf und geheimnisvoller Dunkelheit.");

  AddDetail(({ "monstern" }),
    "Die tiefen Rufe von Monstern hallen in der schattenhaften Schlucht wider, und etwas Grosses lauert in der Dunkelheit.");

  AddDetail(({ "rufe" }),
    "Die tiefen Rufe von Monstern hallen in der schattenhaften Schlucht wider, verursachen eine unheimliche Atmosphaere.");

  AddDetail(({ "schlucht" }),
    "Die Schlucht erstreckt sich tief unter dir, mit einem bodenlosen Abgrund, der in endlose Dunkelheit fuehrt.");

  AddDetail(({ "schritte" }),
    "Das Echo deiner Schritte durchdringt die Stille und verstaerkt das Gefuehl der Beklemmung in der Dunkelheit.");

  AddDetail(({ "schwaerze" }),
    "Du starrst in endlose Schwaerze und Dunkelheit, in der etwas zu lauern scheint.");

  AddDetail(({ "unbekanntheit" }),
    "Das Dunkel der Schlucht verbreitet ein Gefuehl der Unbekanntheit und des Unbehagens.");

  AddDetail(({ "waenden" }),
    "Die steilen Waende der Schlucht reflektieren das Echo deiner Schritte und verstaerken die duestere Atmosphaere.");

  AddDetail(({ "wurzeln" }),
    "Haengende Wurzeln baumeln von der Decke und tragen zur geheimnisvollen Atmosphaere der Schlucht bei.");

    AddDetail(({ "atmosphaere" }),
    "Die Atmosphaere in der Schlucht ist von unheimlicher Beklemmung durchzogen, waehrend der saeurehaltige Dampf die Luft erfuellt.");

  AddDetail(({ "beklemmung" }),
    "Eine beklemmende Atmosphaere liegt in der Schlucht, verstaerkt durch die Dunkelheit und das Echo deiner Schritte.");

  AddDetail(({ "dunkel" }),
    "Die Dunkelheit der Schlucht ist nahezu undurchdringlich, nur vom fahlen Licht der Hoehle erleuchtet.");

  AddDetail(({ "geruch" }),
    "Ein beissender Geruch von Saeure erfuellt die Luft in der Schlucht, verleiht der Atmosphaere eine unangenehme Note.");

  AddDetail(({ "grosses" }),
    "Etwas SEHR Grosses bewegt sich in der Dunkelheit des bodenlosen Abgrunds, lauernd auf den naechsten Moment.");

  AddDetail(({ "luft" }),
    "Die Luft in der Schlucht ist mit saeurehaltigem Dampf gesaettigt, und ihr beissender Geruch vermischt sich mit der Dunkelheit.");

  AddDetail(({ "stille" }),
    "Eine unheimliche Stille liegt in der Schlucht, nur unterbrochen vom leisen Echo deiner Schritte und dem Rufen der Monster.");

  AddDetail(({ "unbehagens" }),
    "Ein Gefuehl des Unbehagens breitet sich in der Dunkelheit der Schlucht aus, verstaerkt durch die beklemmende Atmosphaere.");

  AddDetail(({ "waende", "wand" }),
    "Die steilen Waende der Schlucht reflektieren das Echo deiner Schritte und verstaerken die duestere Atmosphaere der Umgebung.");

    AddDetail(({ "moment" }),
    "Ein kurzer Moment der Stille und Unsicherheit tritt ein, als die brennende Fackel in die Schlucht geworfen wird.");

  AddDetail(({ "monster" }),
    "Monsterhafte Wesen lauern in der Dunkelheit der Schlucht, ihre tiefen Rufe erzeugen eine unheimliche Atmosphaere.");

  AddDetail(({ "note" }),
    "Die Luft in der Schlucht traegt eine beklemmende Note, waehrend der beissende Geruch von Saeure deine Sinne erfuellt.");

  AddDetail(({ "saeure" }),
    "Der beissende Geruch von Saeure erfuellt die Luft in der Schlucht, und saeurehaltiger Dampf haengt in der Umgebung.");

  AddDetail(({ "sehr" }),
    "Etwas SEHR Grosses bewegt sich in der Dunkelheit des bodenlosen Abgrunds, lauernd auf den naechsten Moment.");

  AddDetail(({ "umgebung" }),
    "Die Umgebung in der Schlucht wird von der Dunkelheit, dem beissenden Geruch von Saeure und dem Echo deiner Schritte gepraegt.");

    AddDetail(({ "sinne" }),
    "Deine Sinne werden von der Dunkelheit, dem beissenden Geruch von Saeure und den tiefen Rufen der Monster in der Schlucht beansprucht.");

  AddDetail(({ "unsicherheit" }),
    "Ein Gefuehl der Unsicherheit durchzieht die Luft in der Schlucht, waehrend du in die Schwaerze des bodenlosen Abgrunds blickst.");

  AddDetail(({ "wesen" }),
    "Monsterhafte Wesen lauern in der Dunkelheit der Schlucht, ihre tiefen Rufe erzeugen eine unheimliche Atmosphaere.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordosten", ROOM "i_5" );
  AddExit( "suedosten", ROOM "i_7");

  AddCmd("wirf|werfe&fackel&in|nach&abgrund|schlucht|unten|runter", "cmd_werfen", "Was willst du wohin werfen?\n");
}

public int cmd_werfen() {
  object fackel;

  if(!objectp(fackel=present("fackel", TP))) {
    write("Du hast gar keine Fackel dabei.\n");
    return -1;
  }

  if(!fackel->QueryProp(P_LIGHTED)) {
    write(BS("Du wirfst die Fackel in die Schlucht. Es bleibt dunkel. Vielleicht haettest du sie anzuenden sollen?"));
    say(BS(TPN+" wirft eine Fackel in die Schlucht."));
    return -1;
  }

  write(BS("Du wirst die brennende Fackel in die Schlucht. Einen Moment kannst du da unten etwas SEHR grosses sehen..."));
  say(BS(TPN+" wirft eine brennende Fackel in den Abgrund und macht erschrocken ein paar Schritte zurueck..."));
  fackel->remove(1);
  call_out("here_comes_the_bigboy", 4);
  return 1;
}

public void here_comes_the_bigboy() {
  object ob;
  if(!bigboy) return;

  tell_room(TO, BS("Mit einem lauten Bruellen und Fauchen schiessen zehn riesige Hydrakoefpfe aus dem abgrund hervor. "
                   "Ein drachenartiger Leib schiebt sich nach! Diese Hydra ist riesig!!"));
  ob = clone_object(NPC "hydrant");
  ob->move(TO, M_GO);
  bigboy = 0;
  return;
}

public void reset() {
  ::reset();
  bigboy = 1;
}
