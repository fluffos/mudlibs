#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein Bergpfad auf Hypros");
  SetProp(P_INT_LONG,
    "Der Pfad wird steiniger, waehrend er sich auf den schroffen Berg "
    "hinaufwindet. Karge Felsbrocken ersetzen den goldenen Sand, und die "
    "Luft wird duenn. Krumme Kiefern klammern sich an die Haenge, waehrend der "
    "Pfad in scharfen Kurven emporfuehrt. Wilde Blumen trotzen der rauen "
    "Umgebung. Vor dir eroeffnen sich Ausblicke auf majestaetische Gipfel und das Meer.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

AddDetail(({ "ausblicke" }),
"Vor dir eroeffnen sich atemberaubende Ausblicke auf majestaetische Berggipfel und das endlose Meer.");

AddDetail(({ "berg" }),
"Der schroffe Berg erhebt sich majestaetisch, waehrend der Pfad sich in scharfen Kurven emporwindet.");

AddDetail(({ "blumen" }),
"Wilde Blumen trotzen tapfer der rauen Bergumgebung und setzen farbliche Akzente entlang des steinigen Pfads.");

AddDetail(({ "boden" }),
"Der Boden wird steiniger, ersetzt den goldenen Sand durch karge Felsbrocken, waehrend der Pfad bergauf fuehrt.");

AddDetail(({ "felsbrocken" }),
"Karge Felsbrocken praegen den steinigen Pfad und verleihen der Berglandschaft ein raues Erscheinungsbild.");

AddDetail(({ "gipfel" }),
"Majestaetische Berggipfel ragen hoch in den Himmel und bilden eine beeindruckende Kulisse entlang des Bergpfads.");

AddDetail(({ "haenge" }),
"Krumme Kiefern klammern sich an die steilen Bergabhaenge und verleihen der Landschaft eine malerische Note.");

AddDetail(({ "himmel" }),
"Der Himmel ueber den Berggipfeln ist klar, waehrend die duennere Luft die Umgebung mit einer besonderen Klarheit durchdringt.");

AddDetail(({ "kiefern" }),
"Krumme Kiefern begleiten den Pfad, ihre Aeste wiegen sich im Wind und verleihen der Berglandschaft eine charakteristische Silhouette.");

AddDetail(({ "kurven" }),
"Der Pfad windet sich in scharfen Kurven den Berg hinauf, und jeder Abschnitt enthuellt neue Perspektiven auf die Berglandschaft.");

AddDetail(({ "luft" }),
"Die Luft wird duenn, waehrend der Pfad hoeher in die Berge fuehrt, und verleiht der Umgebung eine besondere Frische.");

AddDetail(({ "meer" }),
"Blick auf das endlose Meer erstreckt sich vor dir, und die Weite des Ozeans bildet einen faszinierenden Kontrast zur Berglandschaft.");

AddDetail(({ "pfad" }),
"Der steinige Pfad fuehrt steil den Berg hinauf, seine Beschaffenheit wird zunehmend anspruchsvoller.");

AddDetail(({ "sand" }),
"Der goldene Sand weicht kargen Felsbrocken, waehrend der Pfad sich weiter in die Berglandschaft windet.");

AddDetail(({ "umgebung" }),
"Die Bergumgebung zeigt sich in ihrer vollen Pracht, gepraegt von steilen Haengen, wilden Blumen und majestaetischen Gipfeln.");

//--Details----------------------------------------------------------------

AddDetail(({ "abschnitt" }),
"Jeder Abschnitt des Bergpfads offenbart neue Facetten der Berglandschaft, von steilen Aufstiegen bis zu malerischen Kurven.");

AddDetail(({ "aeste" }),
"Die Aeste der krummen Kiefern wiegen sich im Wind und setzen natuerliche Akzente entlang des Bergpfads.");

AddDetail(({ "akzente" }),
"Die Berglandschaft ist gepraegt von natuerlichen Akzenten, von wilden Blumen bis zu den krummen Aesten der Kiefern.");

AddDetail(({ "bergabhaenge" }),
"Steile Bergabhaenge begleiten den Pfad und verleihen der Umgebung eine imposante Dimension.");

AddDetail(({ "berggipfel" }),
"Majestaetische Berggipfel ragen hoch in den Himmel und bilden eine beeindruckende Kulisse entlang des Bergpfads.");

AddDetail(({ "berglandschaft" }),
"Die Berglandschaft erstreckt sich in ihrer vollen Pracht, von steilen Haengen bis zu imposanten Berggipfeln.");

AddDetail(({ "bergpfads" }),
"Der Bergpfad fuehrt in scharfen Kurven den Berg hinauf, wobei jeder Abschnitt neue Perspektiven auf die Umgebung eroeffnet.");

AddDetail(({ "bergumgebung" }),
"Die Bergumgebung zeigt sich von ihrer besten Seite, gepraegt von kargen Felsbrocken, wilden Blumen und majestaetischen Berggipfeln.");

AddDetail(({ "beschaffenheit" }),
"Die Beschaffenheit des Pfads wird anspruchsvoller, wenn sich der Boden von goldenem Sand zu kargen Felsbrocken wandelt.");

AddDetail(({ "erscheinungsbild" }),
"Das Erscheinungsbild der Berglandschaft ist beeindruckend, mit malerischen Kurven, majestaetischen Gipfeln und wilden Blumen.");

AddDetail(({ "frische" }),
"Die Bergluft verleiht der Umgebung eine erfrischende Frische, waehrend du den steilen Pfad hinaufgehst.");

AddDetail(({ "klarheit" }),
"Die Klarheit der Bergluft durchdringt die Umgebung, waehrend der Himmel ueber den Berggipfeln klar und ungetruebt ist.");

AddDetail(({ "kontrast" }),
"Der Kontrast zwischen der majestaetischen Berglandschaft und dem endlosen Ozean in der Ferne ist faszinierend.");

AddDetail(({ "kulisse" }),
"Die Berglandschaft bildet eine eindrucksvolle Kulisse, waehrend du den Pfad bergauf wanderst.");

AddDetail(({ "landschaft" }),
"Die Landschaft entfaltet ihre Schoenheit entlang des Bergpfads, mit steilen Haengen, wilden Blumen und majestaetischen Gipfeln.");

AddDetail(({ "note" }),
"Jeder Abschnitt des Bergpfads hinterlaesst eine besondere Note in der Erinnerung, von steilen Aufstiegen bis zu malerischen Aussichten.");

AddDetail(({ "ozeans" }),
"Der Blick auf das endlose Meer in der Ferne verleiht der Berglandschaft eine zusaetzliche Dimension.");

AddDetail(({ "perspektiven" }),
"Die wechselnden Perspektiven entlang des Bergpfads bieten immer neue Blicke auf die Berglandschaft und den Ozean.");

AddDetail(({ "pracht" }),
"Die Pracht der Berglandschaft zeigt sich in jedem Detail, von wilden Blumen bis zu majestaetischen Berggipfeln.");

AddDetail(({ "silhouette" }),
"Die Silhouette der Berglandschaft, gepraegt von krummen Kiefern und steilen Berggipfeln, zeichnet sich vor dem Himmel ab.");

AddDetail(({ "weite" }),
"Die Weite der Berglandschaft erstreckt sich vor dir, waehrend der Bergpfad sich durch die majestaetischen Gipfel windet.");

AddDetail(({ "wind" }),
"Der Wind streicht sanft ueber die Berglandschaft und traegt dazu bei, die Atmosphaere entlang des Bergpfads zu gestalten.");

//--Details----------------------------------------------------------------

AddDetail(({ "atmosphaere" }),
"Die Atmosphaere entlang des Bergpfads ist gepraegt von Frische und Klarheit, waehrend der Wind sanft durch die Kiefern weht.");

AddDetail(({ "aufstiegen", "aufstiege" }),
"Die Herausforderungen bei steilen Aufstiegen verleihen dem Bergpfad eine besondere Dimension.");

AddDetail(({ "aussichten" }),
"Die Aussichten entlang des Bergpfads sind atemberaubend, mit majestaetischen Gipfeln und dem endlosen Ozean in der Ferne.");

AddDetail(({ "bergluft" }),
"Die Bergluft ist duenn und erfrischend, waehrend du den Pfad in hoehere Regionen wanderst.");

AddDetail(({ "bergpfad" }),
"Der Bergpfad erstreckt sich steil den Berg hinauf, durch scharfe Kurven und vorbei an malerischen Aussichtspunkten.");

AddDetail(({ "blick" }),
"Der Blick entlang des Bergpfads offenbart eine vielfaeltige Landschaft, gepraegt von majestaetischen Gipfeln und dem Ozean.");

AddDetail(({ "blicke" }),
"Die wechselnden Blicke entlang des Bergpfads bieten immer neue Perspektiven auf die Berglandschaft und den Ozean.");

AddDetail(({ "detail" }),
"Jedes Detail entlang des Bergpfads hinterlaesst einen Eindruck, von wilden Blumen bis zu majestaetischen Berggipfeln.");

AddDetail(({ "dimension" }),
"Die Berglandschaft erlangt durch steile Aufstiege und beeindruckende Ausblicke eine zusaetzliche Dimension.");

AddDetail(({ "erinnerung" }),
"Jeder Abschnitt des Bergpfads hinterlaesst eine bleibende Erinnerung, von herausfordernden Aufstiegen bis zu malerischen Aussichten.");

AddDetail(({ "facetten" }),
"Die Berglandschaft zeigt sich in zahlreichen Facetten, von steilen Haengen bis zu majestaetischen Berggipfeln.");

AddDetail(({ "ferne" }),
"In der Ferne erstreckt sich der endlose Ozean, der die Berglandschaft mit einer faszinierenden Weite verbindet.");

AddDetail(({ "ozean" }),
"Der Ozean in der Ferne bildet eine eindrucksvolle Kulisse und verleiht der Berglandschaft eine zusaetzliche Dimension.");

AddDetail(({ "schoenheit" }),
"Die Schoenheit der Berglandschaft entfaltet sich entlang des Pfads, von wilden Blumen bis zu majestaetischen Berggipfeln.");

AddDetail(({ "seite" }),
"Jede Seite des Bergpfads offenbart neue Facetten der Berglandschaft und erzeugt eine beeindruckende Kulisse.");



//--Ausgaenge--------------------------------------------------------------

  AddExit( "nordosten", ROOM "k_1" );
  AddExit( "sueden", ROOM "j_3" );

}

