#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Ein schmaler Pfad windet sich durch eine glibberige Engstelle, in der "
    "Waende vor Feuchtigkeit zu tropfen scheinen. Der Geruch von Moder und "
    "Saeure liegt in der Luft, waehrend sich die Umgebung durch das Gleiten "
    "der Schatten lebendig anfuehlt. Die schmale Passage wird von unsichtbaren "
    "Augen beobachtet, und das Wispern der Luft verraet eine unbestimmte Gefahr.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

AddDetail(({ "augen" }),
"Unsichtbare Augen scheinen die schmale Passage aufmerksam zu beobachten.");

AddDetail(({ "boden" }),
"Der Boden ist glibberig, waehrend sich der Pfad durch die Hoehle schlaengelt.");

AddDetail(({ "decke" }),
"Die Decke der Hoehle tropft vor Feuchtigkeit, als ob sie lebendig waere.");

AddDetail(({ "engstelle" }),
"Die Engstelle des schmalen Pfads erzeugt ein beklemmendes Gefuehl.");

AddDetail(({ "feuchtigkeit" }),
"Feuchtigkeit tropft von den Waenden, die Umgebung mit einer klammen Atmosphaere fuellend.");

AddDetail(({ "gefahr" }),
"Ein unbestimmtes Gefuehl der Gefahr liegt in der Luft, als ob die Hoehle ihre eigenen Bedrohungen birgt.");

AddDetail(({ "geruch" }),
"Ein intensiver Geruch von Moder und Saeure durchdringt die Luft in der Hoehle.");

AddDetail(({ "gleiten" }),
"Die Schatten gleiten durch die Umgebung, verleihen der Hoehle eine lebendige, unheimliche Atmosphaere.");

AddDetail(({ "luft" }),
"Das Wispern der Luft verraet eine unbestimmte Gefahr, die in der Dunkelheit lauert.");

AddDetail(({ "moder" }),
"Ein modriger Geruch haengt in der Luft, und die Feuchtigkeit verstaerkt das Gefuehl des Verfalls.");

AddDetail(({ "passage" }),
"Die schmale Passage fuehrt dich durch die duestere Hoehle, umgeben von schattenhaften Geheimnissen.");

AddDetail(({ "pfad" }),
"Der schmale Pfad windet sich durch die Hoehle, fuehrt dich tiefer in die Unbekannten.");

AddDetail(({ "saeure" }),
"Der stechende Geruch von Saeure durchdringt die Luft, ein Zeichen der gefaehrlichen Umgebung.");

AddDetail(({ "schatten" }),
"Die Schatten in der Hoehle nehmen eine unheimliche Form an, als ob sie ein Eigenleben fuehren.");

AddDetail(({ "umgebung" }),
"Die Umgebung der Hoehle scheint lebendig zu sein, von unsichtbaren Kraeften bewegt.");

AddDetail(({ "waende" }),
"Die Waende der Hoehle sind feucht, tropfen vor Feuchtigkeit und umgeben den Pfad in der Dunkelheit.");

AddDetail(({ "wand" }),
"Die Wand der Engstelle scheint lebendig zu sein, als ob sie den Pfad aufmerksam beobachtet.");

AddDetail(({ "wispern" }),
"Das Wispern der Luft erfuellt die Hoehle und kuendigt eine unbestimmte Gefahr an.");

AddDetail(({ "atmosphaere" }),
"Die Atmosphaere in der Hoehle ist von duesteren Geheimnissen und unbestimmten Bedrohungen durchzogen.");

AddDetail(({ "bedrohungen" }),
"Unbestimmte Bedrohungen scheinen in der Dunkelheit der Hoehle zu lauern.");

AddDetail(({ "dunkelheit", "verborgenen" }),
"Die Dunkelheit in der Hoehle ist undurchdringlich, verleiht dem Raum eine geheimnisvolle Aura.");

AddDetail(({ "eigenleben" }),
"Die Schatten in der Hoehle nehmen eine unheimliche Form an, als haetten sie ein Eigenleben.");

AddDetail(({ "form" }),
"Die Form der Hoehle und ihrer engen Passagen verleiht dem Raum eine bedrohliche Ausstrahlung.");

AddDetail(({ "gefuehl" }),
"Ein beklemmendes Gefuehl durchdringt die Hoehle, als ob die Dunkelheit ihre eigenen Regeln haette.");

AddDetail(({ "geheimnissen" }),
"Die Hoehle ist erfuellt von schattenhaften Geheimnissen, die in den Winkeln lauern.");

AddDetail(({ "hoehle" }),
"Die Hoehle offenbart ihre duestere Schoenheit, waehrend der Pfad durch die Unbekannten fuehrt.");

AddDetail(({ "kraeften" }),
"Unsichtbare Kraefte scheinen die Umgebung der Hoehle zu beeinflussen, waehrend sie lebendig wirkt.");

AddDetail(({ "unbekannten" }),
"Der Pfad fuehrt dich tiefer in die Unbekannten der Hoehle, wo Schatten und Geheimnisse lauern.");

AddDetail(({ "verfalls" }),
"Der Geruch von Moder und Saeure verstaerkt das Gefuehl des Verfalls, das in der Hoehle haengt.");

AddDetail(({ "zeichen" }),
"Die Zeichen in der Hoehle erzaehlen von vergangenen Mysterien und dunklen Ritualen, die hier stattgefunden haben.");

AddDetail(({ "aura" }),
"Die Aura in der Hoehle ist von duesteren Geheimnissen und einer unheilvollen Ausstrahlung durchzogen.");

AddDetail(({ "ausstrahlung" }),
"Die Hoehle hat eine unheilvolle Ausstrahlung, als ob sie die Dunkelheit selbst verkoerpern wuerde.");

AddDetail(({ "geheimnissen" }),
"Die Hoehle huetet schattenhafte Geheimnisse, die in den dunklen Ecken und Winkeln lauern.");

AddDetail(({ "kraefte" }),
"Unsichtbare Kraefte scheinen die Umgebung der Hoehle zu beeinflussen, waehrend sie lebendig wirkt.");

AddDetail(({ "mysterien" }),
"Die Hoehle birgt Mysterien vergangener Tage, die in den Schatten verborgen sind.");

AddDetail(({ "raum" }),
"Der Raum in der Hoehle ist von einer duesteren Atmosphaere erfuellt, als ob er selbst lebendig waere.");

AddDetail(({ "regeln" }),
"Die Dunkelheit in der Hoehle folgt ihren eigenen Regeln, die nur von den Schatten verstanden werden.");

AddDetail(({ "ritualen" }),
"Die Waende der Hoehle tragen Spuren vergangener Rituale, die in den Schatten verblasst sind.");

AddDetail(({ "schoenheit" }),
"Die duestere Schoenheit der Hoehle offenbart sich in den schattenhaften Formen und geheimnisvollen Ecken.");

AddDetail(({ "winkeln" }),
"Die dunklen Winkel der Hoehle bergen unbekannte Geheimnisse, die darauf warten, entdeckt zu werden.");

AddDetail(({ "ecken" }),
"Die dunklen Ecken der Hoehle bergen schattenhafte Geheimnisse, die im Verborgenen lauern.");

AddDetail(({ "geheimnisse" }),
"Die Hoehle ist erfuellt von schattenhaften Geheimnissen, die in den Winkeln und Ecken lauern.");

AddDetail(({ "rituale" }),
"Die Hoehle traegt Spuren vergangener Rituale, die in den Schatten verblasst sind.");

AddDetail(({ "spuren", "zeugen" }),
"Spuren vergangener Tage sind in den Waenden der Hoehle eingraviert, stille Zeugen der Vergangenheit.");

AddDetail(({ "tage" }),
"Die Hoehle traegt die Zeichen vergangener Tage, eingraviert in ihre dunklen Waende.");

AddDetail(({ "winkel" }),
"Die dunklen Winkel der Hoehle bergen schattenhafte Geheimnisse, die darauf warten, entdeckt zu werden.");

AddDetail( ({"vergangenheit"}),
  "Die ist schon vergangen.");

  
//--Ausgaenge--------------------------------------------------------------
AddExit( "suedosten", ([
  EX_DEST  : ROOM "m_6",
  EXG_ID   : "\nschleimhydra",
  EXG_PLMSG: "Die schleimige Hydra windet sich dir in den Weg.\n",
  EXG_RMMSG: "Die schleimige Hydra verspeert @wem@ den Weg nach Suedosten.\n" ]) );
  AddExit( "westen", ROOM "k_5");

  AddItem(NPC "schleim_hydra", REFRESH_DESTRUCT);
}

