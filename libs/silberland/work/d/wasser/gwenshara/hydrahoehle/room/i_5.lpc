#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Die Decke ist mit Tropfsteinen uebersaet, von denen gelegentlich Tropfen "
    "saeurehaltigen Wassers herabfallen. Die Truebheit der Pfuetzen wird von den "
    "Schatten der glitschigen Waende gespielt, und die Kaelte der Hoehle dringt "
    "in die Knochen. Das leise Tropfen wird von einem fernen Grollen begleitet, "
    "als wuerde die Hoehle selbst atmen.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

AddDetail(({ "boden" }),
"Der Boden der Hoehle ist mit glitschigem Schlick bedeckt, der sich kalt und unangenehm unter deinen Fuessen anfuehlt.");

AddDetail(({ "decke" }),
"Die Decke der Hoehle ist mit Tropfsteinen uebersaet, von denen gelegentlich saure Tropfen herabfallen.");

AddDetail(({ "grollen" }),
"Ein fernes Grollen durchdringt die Hoehle, als ob sie selbst atmen wuerde, und verleiht der Umgebung eine beunruhigende Aura.");

AddDetail(({ "hoehle" }),
"Die Hoehle erstreckt sich vor dir, von glitschigen Waenden begrenzt, und birgt dunkle Geheimnisse in ihrem Inneren.");

AddDetail(({ "kaelte" }),
"Die Kaelte der Hoehle dringt in die Knochen, verstaerkt durch den kalten Hauch der umgebenden Luft.");

AddDetail(({ "knochen" }),
"Die Kaelte der Hoehle scheint bis in die Knochen zu dringen, hinterlaesst ein unangenehmes Gefuehl.");

AddDetail(({ "pfuetzen" }),
"Truebe Pfuetzen auf dem Hoehlenboden spiegeln das matte Licht wider und verleihen der Umgebung eine duestere Note.");

AddDetail(({ "schatten" }),
"Die Schatten der glitschigen Waende spielen mit der Truebheit der Pfuetzen, waehrend sie das gesamte Hoehlenambiente durchziehen.");

AddDetail(({ "tropfen" }),
"Leise Tropfen saurehaltigen Wassers fallen von den Tropfsteinen, erzeugen ein gleichmaessiges Plaetschern in der Stille der Hoehle.");

AddDetail(({ "tropfsteinen" }),
"Die Decke ist mit Tropfsteinen uebersaet, die wie glitzernde Juwelen im fahlen Licht der Hoehle glaenzen.");

AddDetail(({ "truebheit" }),
"Die Truebheit der Pfuetzen auf dem Boden reflektiert das gedaempfte Licht und verleiht der Hoehle eine mystische Atmosphaere.");

AddDetail(({ "waende", "wand" }),
"Die glitschigen Waende der Hoehle erstrecken sich hoch und eng, als wuerden sie Geheimnisse bewahren.");

AddDetail(({ "atmosphaere" }),
"Die Atmosphaere in der Hoehle ist von einer mysterioesen Spannung durchzogen, waehrend die glitschigen Waende ihre Geheimnisse bewahren.");

AddDetail(({ "aura" }),
"Eine Aura des Unbekannten haengt in der Hoehle, verstaerkt durch das fahle Licht und die Schatten der glitschigen Waende.");

AddDetail(({ "fuessen" }),
"Der glitschige Boden klebt an deinen Fuessen, erschwert jeden Schritt in dieser duesteren Umgebung.");

AddDetail(({ "gefuehl" }),
"Ein unangenehmes Gefuehl durchdringt das Innere der Hoehle, verstaerkt durch die Kaelte und die feuchte Luft.");

AddDetail(({ "geheimnisse" }),
"Die Hoehle birgt dunkle Geheimnisse, die in den glitschigen Schatten der Waende verborgen sind.");

AddDetail(({ "hauch" }),
"Ein kalter Hauch von Luft durchzieht die Hoehle, laesst eine unheimliche Stille in der duesteren Umgebung zurueck.");

AddDetail(({ "hoehlenambiente" }),
"Das Hoehlenambiente ist von glitschigen Waenden, Tropfsteinen und einem leisen Plaetschern von Wasser gepraegt.");

AddDetail(({ "hoehlenboden" }),
"Der Hoehlenboden ist mit glitschigem Schlick bedeckt, der sich kalt und klebrig unter deinen Schritten anfuehlt.");

AddDetail(({ "inneren" }),
"Das dunkle Inneren der Hoehle wirkt geheimnisvoll und beunruhigend, waehrend es von den Schatten der Waende verschluckt wird.");

AddDetail(({ "juwelen" }),
"Die Tropfsteine an der Decke glaenzen wie funkelnde Juwelen, beleuchtet vom fahlen Licht der Hoehle.");

AddDetail(({ "licht" }),
"Das fahle Licht enthuellt die glitschigen Waende und Tropfsteine, verleiht der Hoehle eine gespenstische Atmosphaere.");

AddDetail(({ "luft" }),
"Die Luft in der Hoehle ist kalt und von einem leichten Hauch erfuellt, waehrend sie die duestere Umgebung durchdringt.");

AddDetail(({ "note" }),
"Die Hoehle verstroemt eine duestere Note, begleitet von einem leisen Plaetschern von Wasser und einem fernen Grollen.");

AddDetail(({ "plaetschern" }),
"Ein leises Plaetschern von Wasser erfuellt die Hoehle, waehrend sich Pfuetzen auf dem Boden bilden.");

AddDetail(({ "schlick" }),
"Der glitschige Schlick auf dem Hoehlenboden klebt an deinen Schuhen und hinterlaesst eine unangenehme Spur.");

AddDetail(({ "stille" }),
"Eine unheimliche Stille liegt in der Hoehle, nur unterbrochen vom leisen Plaetschern und dem fernen Grollen.");

AddDetail(({ "umgebung" }),
"Die duestere Umgebung der Hoehle wird von glitschigen Waenden, Tropfsteinen und einem kalten Hauch gepraegt.");

AddDetail(({ "wassers", "wasser" }),
"Saeurehaltiges Wasser tropft von den Tropfsteinen, bildet kleine Pfuetzen auf dem Hoehlenboden.");

AddDetail(({ "inneren" }),
"Das dunkle Innere der Hoehle wirkt geheimnisvoll und beunruhigend, waehrend es von den Schatten der Waende verschluckt wird.");

AddDetail(({ "schritt" }),
"Jeder Schritt auf dem klebrigen Hoehlenboden erzeugt ein schmatzendes Geraeusch, das die Stille durchbricht.");

AddDetail(({ "schuhen" }),
"Der glitschige Schlick auf dem Hoehlenboden haftet an deinen Schuhen und hinterlaesst eine unangenehme Spur.");

AddDetail(({ "spannung" }),
"Die Spannung in der Hoehle liegt in der Luft, verstaerkt durch das fahle Licht, die glitschigen Waende und das leise Plaetschern.");

AddDetail(({ "spur" }),
"Eine Spur klebrigen Schlicks bleibt an deinen Schuhen haften, waehrend du durch das Innere der Hoehle gehst.");

AddDetail(({ "tropfsteine" }),
"Die Tropfsteine an der Decke glaenzen wie funkelnde Juwelen, beleuchtet vom fahlen Licht der Hoehle.");

AddDetail(({ "unbekannten" }),
"Die Hoehle verbirgt Geheimnisse des Unbekannten, die in den Schatten der glitschigen Waende lauern.");

AddDetail(({ "geraeusch" }),
"Das schmatzende Geraeusch deiner Schritte auf dem klebrigen Hoehlenboden durchbricht die Stille.");

AddDetail(({ "innere" }),
"Das dunkle Innere der Hoehle wirkt geheimnisvoll und beunruhigend, waehrend es von den Schatten der Waende verschluckt wird.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", ROOM "j_5" );
  AddExit( "suedwesten", ROOM "h_6");

  AddItem( ({NPC "hydra_klein", NPC "hydra_mittel", NPC "hydra_gross"}), REFRESH_DESTRUCT);
}

