#include "../def.h"

inherit "std/room";

int hypnoHydra;

void create()
{
  ::create();

  hypnoHydra = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Diese verborgene Nische in der Hoehlenwand dient den Hydren als Ruheplatz. "
    "Die Dunkelheit hier ist undurchdringlich, und das leise Tropfen von "
    "saeurehaltigem Wasser ist das einzige hoerbare Geraeusch. Die Nische scheint ein "
    "vergessener Ort der Stille zu sein.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden in der Nische ist mit glitschigem Schlamm bedeckt, auf dem das leise Tropfen von saeurehaltigem Wasser kaum zu hoeren ist.");

  AddDetail( ({ "decke" }),
    "Die Decke der Nische verschwindet im Dunkel der Hoehle, unerreichbar und undurchdringlich.");

  AddDetail( ({ "dunkelheit" }),
    "Die Dunkelheit in der Nische ist undurchdringlich und laesst kaum etwas erkennen.");

  AddDetail( ({ "geraeusch" }),
    "Das leise Tropfen von saeurehaltigem Wasser ist das einzige hoerbare Geraeusch in der stillen Nische.");

  AddDetail( ({ "hoehlenwand", "wand" }),
    "Die glitschige Hoehlenwand bildet den begrenzten Raum der Nische.");

  AddDetail( ({ "hydren" }),
    "Im Dunkeln sind die schattenhaften Umrisse von ruhenden Hydren zu erkennen, die diesen abgelegenen Ort als Ruheplatz nutzen.");

  AddDetail( ({ "niche" }),
    "Die verborgene Nische scheint vergessen, ein geheimer Ort der Stille und Ruhe inmitten der Hoehle.");

  AddDetail( ({ "ort" }),
    "Dieser abgelegene Ort in der Hoehle strahlt eine besondere Aura der Stille und Ruhe aus.");

  AddDetail( ({ "ruheplatz" }),
    "Die Nische dient den Hydren als Ruheplatz, versteckt und abgeschieden vom Rest der Hoehle.");

  AddDetail( ({ "stille" }),
    "Die Stille in der Nische ist fast greifbar, nur das leise Tropfen von saeurehaltigem Wasser durchbricht sie.");

  AddDetail( ({ "tropfen", "wasser" }),
    "Saeurehaltiges Wasser tropft leise von der Decke auf den Boden, bildet kleine Pfuetzen und verstaerkt die Atmosphaere der Nische.");

  AddDetail( ({ "waende" }),
    "Die glitschigen Waende der Nische schliessen den Raum ein und verbergen die Ruheplaetze der Hydren.");

  AddDetail( ({ "wand" }),
    "Die glitschige Wand begrenzt die Nische und gibt den schlafenden Hydren Schutz vor neugierigen Blicken.");

  AddDetail( ({ "wasser" }),
    "Kleine Pfuetzen saeurehaltigen Wassers sammeln sich auf dem Boden der Nische, gebildet durch das leise Tropfen von der Decke.");

    AddDetail( ({ "atmosphaere" }),
    "Die Atmosphaere in der Nische ist von Stille und Ruhe durchzogen, ein abgeschiedener Ort inmitten der Hoehle.");

  AddDetail( ({ "aura" }),
    "Eine besondere Aura der Stille und Ruhe umgibt diesen vergessenen Ort in der Hoehle.");

  AddDetail( ({ "blicken" }),
    "Blicke von ruhenden Hydren begegnen einem im Dunkeln, waehrend sie diesen geheimen Ruheplatz nutzen.");

  AddDetail( ({ "dunkel" }),
    "Die Dunkelheit in der Nische verstaerkt die Atmosphaere der Stille und Ruhe.");

  AddDetail( ({ "hoehle" }),
    "Die Hoehle umgibt diesen abgelegenen Raum, in dem die Hydren Ruhe finden.");

  AddDetail( ({ "nische", "rueckzugsort" }),
    "Die Nische bietet den Hydren einen versteckten und abgeschiedenen Raum als Ruheplatz.");

  AddDetail( ({ "pfuetzen" }),
    "Kleine Pfuetzen saeurehaltigen Wassers bilden sich auf dem glitschigen Boden der Nische.");

  AddDetail( ({ "raum" }),
    "Dieser begrenzte Raum in der Hoehle strahlt eine besondere Stille und Ruhe aus.");

  AddDetail( ({ "rest" }),
    "Der Rest der Hoehle ist von hier aus nicht einsehbar, was diesen Ort besonders abgeschieden macht.");

  AddDetail( ({ "ruhe" }),
    "Die Ruhe in der Nische ist fast greifbar und bildet einen Kontrast zur Hektik der Hoehle.");

  AddDetail( ({ "ruheplaetze" }),
    "Die glitschigen Waende bieten den Hydren bequeme Ruheplaetze, waehrend sie diesen verborgenen Ort nutzen.");

  AddDetail( ({ "schlamm" }),
    "Glitschiger, schwarzer Schlamm bedeckt den Boden der Nische, ein Zeichen der Aktivitaet der Hydren.");

  AddDetail( ({ "schutz" }),
    "Die glitschige Wand bietet den ruhenden Hydren Schutz vor neugierigen Blicken und stoert ihre wohlverdiente Ruhe nicht.");

  AddDetail( ({ "umrisse" }),
    "Die schattenhaften Umrisse der ruhenden Hydren zeichnen sich im Dunkeln ab, waehrend sie diesen geheimen Platz nutzen.");

    AddDetail( ({ "aktivitaet" }),
    "Trotz der allgemeinen Ruhe in der Nische spiegelt der glitschige Schlamm auf dem Boden die vergangene Aktivitaet der Hydren wider.");

  AddDetail( ({ "hektik" }),
    "Die Hektik und Aktivitaet der Hoehle scheinen in dieser Nische vergessen, die von einer beinahe ungestoerten Ruhe gepraegt ist.");

  AddDetail( ({ "kontrast" }),
    "Der Kontrast zwischen der ruhigen Nische und der hektischen Aktivitaet der Hoehle verstaerkt das besondere Gefuehl der Abgeschiedenheit.");

  AddDetail( ({ "platz" }),
    "Der begrenzte Platz in der Nische wird von den ruhenden Hydren effektiv genutzt, um ungestoert zu schlafen.");

  AddDetail( ({ "zeichen" }),
    "Der schwarze Schlamm auf dem Boden ist ein Zeichen der vergangenen Aktivitaet der Hydren, die diesen Ort als Ruheplatz nutzen.");

  AddDetail( ({ "abgeschiedenheit" }),
    "Die Abgeschiedenheit dieser Nische vermittelt ein Gefuehl von Ruhe und Sicherheit, fernab der Hektik der umgebenden Hoehle.");

  AddDetail( ({ "gefuehl" }),
    "In dieser abgeschiedenen Nische empfindest du ein Gefuehl der Ruhe und Geborgenheit, als waere dies ein geschuetzter Ort vor der Aussenwelt.");

  AddDetail( ({ "aussenwelt" }),
    "Die Aussenwelt erscheint weit entfernt, waehrend du dich in dieser abgeschiedenen Nische befindest.");

  AddDetail( ({ "geborgenheit", "sicherheit" }),
    "Die Nische strahlt Geborgenheit und Sicherheit aus, als waere sie ein geschuetzter Rueckzugsort vor den Gefahren der Hoehle und der Aussenwelt.");

  AddDetail( ({"gefahr", "gefahren"}),
    "Die Aussenwelt ist voller gefahren. Hier bist du geschuetzt. Hier kannst du dich ausruhen.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "j_8" );

  AddCmd("ruhe|ruh&aus|dich aus", "cmd_ausruhen", "Willst du dich ausruhen?");
}

public int cmd_ausruhen() {
  write(BS("Du setzt dich einen Moment, um dich in der Geborgenheit dieser Hoehle auszuruhen..."));
  say(BS(TPN+" setzt sich erschoepft hin."));

  if(hypnoHydra) {
    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME: 20,
      PARALYZE_MSG: "Aus irgendinem Grund willst du dich gar nicht bewegen...\n",
      PARALYZE_END: "Der Bann faellt von dir ab und du kannst dich wieder bewegen!\n"
    ]));
    call_out("hypno_hydra_seq", 0, TP, 0);
    hypnoHydra = 0;
  }

  return 1;
}

public void hypno_hydra_seq(object who, int step) {
  object hydra;

  if(!objectp(who)) {
    hypnoHydra = 1;
    return;
  }

  switch(step) {
    case 0: tell_object(who, BS("Du sinkst in eine sanfte Trance...")); break;
    case 1: tell_object(who, BS("Irgendetwas warmes und schuppiges wickelt sich um dich. Aber es ist dir egal. Alles wird gut.")); break;
    case 2: tell_object(who, BS("Immer enger wickelt sich die wohlige Waerme der Monstermutter um dich.")); break;
    case 3: tell_object(who, BS("Ploetzlich bekommst du keine Luft! Eine schlangenartige Hydra hat dich hypnotisiert und wollte dich zerquetschen!")); break;
    default: 
      who->SetProp(P_PARALYZED, 0); 
      hydra = clone_object(NPC "hypno_hydra");
      if(hydra->move(TO, M_NOCHECK|M_SILENT) != 1) {
        destruct(hydra);
        return; break;
      }
      hydra->Kill(who);
      return; break;
  }

  call_out("hypno_hydra_seq", 5, who, ++step);
  return;
}
