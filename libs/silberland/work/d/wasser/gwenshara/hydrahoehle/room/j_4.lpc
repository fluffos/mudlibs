#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Eine Felsspalte auf Hypros");
  SetProp(P_INT_LONG,
    "Der Pfad endet abrupt an einer tiefen Felsspalte, aus der aetzender Dampf "
    "aufsteigt. Der stechende Geruch und das zischende Geraeusch verstaerken die "
    "bedrohliche Atmosphaere. Gruenliche Ablagerungen haben sich auf den Felsen "
    "rundherum abzesetzt.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "spalte", "felsspalte" }),
    "Die Felsspalte liegt abrupt am Ende des Pfads. In ihr ist es stockdunkel "
    "und immer wieder wallen giftige Daempfe aus ihr in einem gruenlichen "
    "Nebel hervor. Knapp unter der Kante der Felsspalte wurde ein metallener "
    "Ring eingeschlagen.");
  
  AddDetail( ({"ring", "metallring"}),
    "Der Metallring glaenzt oelig. Offenbar wurde er hier eingeschlagen, um "
    "ein Seil daran zu binden, mit dem man sich dann in die Tiefe abseilen kann.");

  //--Details----------------------------------------------------------------

AddDetail(({ "ablage", "ablagerungen" }),
"Gruenliche Ablagerungen haben sich auf den Felsen rundherum abgesetzt, als ob die Daempfe aus der Felsspalte hier ihre Spuren hinterlassen.");

AddDetail(({ "atmosphaere" }),
"Die Atmosphaere an der Felsspalte ist bedrohlich und gespannt, gepraegt von zischenden Geraeuschen und stechendem Geruch.");

AddDetail(({ "boden" }),
"Der steinige Boden des Bergpfads fuehrt bis zur Kante der Felsspalte, wo er abrupt endet.");

AddDetail(({ "daempfe" }),
"Giftige Daempfe wallen immer wieder aus der tiefen Felsspalte hervor und verleihen der Umgebung einen unangenehmen Duft.");

AddDetail(({ "dampf" }),
"Aetzender Dampf steigt aus der Felsspalte auf und mischt sich mit den giftigen Daempfen, waehrend er in den Himmel aufsteigt.");

AddDetail(({ "ende" }),
"Der Bergpfad endet abrupt an der Kante der tiefen Felsspalte.");

AddDetail(({ "felsen" }),
"Die Felsen rund um die Felsspalte sind von gruenlichen Ablagerungen bedeckt, die deutliche Spuren des aufsteigenden Dampfes zeigen.");

AddDetail(({ "geraeusch" }),
"Das zischende Geraeusch aus der Felsspalte wirkt bedrohlich und begleitet die gespannte Atmosphaere an diesem Ort.");

AddDetail(({ "geruch" }),
"Der stechende Geruch der giftigen Daempfe erfuellt die Luft und verleiht der Umgebung eine unangenehme Note.");

AddDetail(({ "himmel" }),
"Der Himmel ueber der Felsspalte zeigt sich in verschiedenen Blau- und Grautoenen, waehrend er von den aufsteigenden Daempfen durchzogen wird.");

AddDetail(({ "kante" }),
"Die Kante der Felsspalte bildet einen markanten Abschluss des Bergpfads, und unter ihr wurde ein metallener Ring eingeschlagen.");

AddDetail(({ "nebel" }),
"Ein gruenlicher Nebel steigt aus der Felsspalte hervor und verhuellt Teile der Umgebung in undurchsichtige Wolken.");

AddDetail(({ "pfad" }),
"Der steinige Pfad fuehrt bis zur Kante der Felsspalte, wo er abrupt endet und den Blick in die Tiefe freigibt.");

AddDetail(({ "seil" }),
"Ein festes Seil liegt bereit, um sich sicher in die dunkle Tiefe der Felsspalte abzuseilen.");

AddDetail(({ "tiefe" }),
"Die dunkle Tiefe der Felsspalte liegt vor dir, und der metallene Ring an der Kante bietet die Moeglichkeit des Abseilens.");

//--Zusätzliche Details----------------------------------------------------

AddDetail(({ "abschluss" }),
"Die Felsspalte bildet den Abschluss des Bergpfads, und der steile Abgrund unterstreicht den Endpunkt des sich windenden Pfads.");

AddDetail(({ "abseilens" }),
"Der metallene Ring an der Kante der Felsspalte bietet die Moeglichkeit des sicheren Abseilens in die Tiefe.");

AddDetail(({ "bergpfad" }),
"Der Bergpfad fuehrt bis zur Kante der Felsspalte und endet hier abrupt, wo sich der Blick in die Tiefe eroeffnet.");

AddDetail(({ "bergpfads" }),
"Der steinige Untergrund des Bergpfads kontrastiert mit der tiefen Felsspalte am Ende des Pfads.");

AddDetail(({ "blau" }),
"Der Himmel ueber der Felsspalte zeigt sich in verschiedenen Blau- und Grautoenen, waehrend er von den aufsteigenden Daempfen durchzogen wird.");

AddDetail(({ "blick" }),
"Von der Kante der Felsspalte aus eroeffnet sich ein weiter Blick in die dunkle Tiefe und die Umgebung des Bergpfads.");

AddDetail(({ "duft" }),
"Der Duft der Umgebung ist gepraegt von den stechenden Geruechen der giftigen Daempfe, die aus der Felsspalte aufsteigen.");

AddDetail(({ "grautoenen" }),
"Der Himmel ueber der Felsspalte zeigt eine Vielfalt von Grautoenen, die von den aufsteigenden Daempfen durchzogen werden.");

AddDetail(({ "luft" }),
"Die Bergluft an der Felsspalte ist duenn und erfuellt mit den zischenden Geraeuschen und stechenden Geruechen.");

AddDetail(({ "moeglichkeit" }),
"Der metallene Ring an der Kante der Felsspalte bietet die Moeglichkeit, sich sicher in die Tiefe abzuseilen.");

AddDetail(({ "note" }),
"Die Umgebung der Felsspalte hinterlaesst eine bedrohliche Note, gepraegt von den stechenden Geruechen und giftigen Daempfen.");

AddDetail(({ "ort" }),
"Die Felsspalte markiert einen markanten Ort am Ende des Bergpfads, der in die Tiefe fuehrt.");

AddDetail(({ "spuren" }),
"Die Spuren der giftigen Daempfe sind auf den Felsen rund um die Felsspalte sichtbar und zeugen von ihrer aetzenden Wirkung.");

AddDetail(({ "teile" }),
"Teile der Umgebung sind vom gruenlichen Nebel, der aus der Felsspalte aufsteigt, verhuellt und in undurchsichtige Wolken gehuellt.");

AddDetail(({ "umgebung" }),
"Die Umgebung der Felsspalte zeigt sich in einem kontrastreichen Bild aus steinigem Pfad, giftigen Daempfen und bedrohlicher Atmosphaere.");

AddDetail(({ "wolken" }),
"Dichte Wolken aus gruenlichem Nebel steigen aus der Felsspalte empor und verleihen der Umgebung eine geheimnisvolle Aura.");

//--Zusätzliche Details----------------------------------------------------

AddDetail(({ "abgrund" }),
"Der steile Abgrund unterhalb der Felsspalte zeugt von der tiefen Tiefe, die sich unter dem Bergpfad erstreckt.");

AddDetail(({ "aura" }),
"Die Aura der Felsspalte wird von den aufsteigenden giftigen Daempfen und dem zischenden Geraeusch gepraegt.");

AddDetail(({ "bergluft" }),
"Die Bergluft an der Felsspalte ist duenn und erfuellt mit den zischenden Geraeuschen und stechenden Geruechen.");

AddDetail(({ "bild" }),
"Das Bild, das sich von der Kante der Felsspalte bietet, zeigt eine Szenerie aus steinigem Pfad, giftigen Daempfen und dem tiefen Abgrund.");

AddDetail(({ "endpunkt" }),
"Die Felsspalte markiert den Endpunkt des Bergpfads, wo sich der Blick in die dunkle Tiefe und die Umgebung eroeffnet.");

AddDetail(({ "geruechen" }),
"Die Umgebung ist erfuellt von stechenden Geruechen, die von den aufsteigenden giftigen Daempfen herruehren.");

AddDetail(({ "untergrund" }),
"Der steinige Untergrund des Bergpfads kontrastiert mit der tiefen Felsspalte am Ende des Pfads.");

AddDetail(({ "vielfalt" }),
"Die Vielfalt der Umgebung zeigt sich in verschiedenen Elementen wie dem steinigen Pfad, den giftigen Daempfen und dem tiefen Abgrund.");

AddDetail(({ "wirkung" }),
"Die Wirkung der Felsspalte wird durch die bedrohliche Atmosphaere, die von den aufsteigenden Daempfen ausgeht, verstärkt.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "j_3" );

  AddCmd("binde|bind&seil|kletterseil&an&ring|metallring", "cmd_binden", "Was willst du woran binden?");
  AddCmd(({"seile", "seil"}), "cmd_abseilen");
}

public int cmd_binden() {
  object seil;
  if(!objectp(seil=present("seil", TP))) {
    write(BS("Du hast gar kein Seil bei dir!"));
    return -1;
  }

  write(BS("Mit einem einfachen Knoten kannst du dich hier gut abseilen."));
  return 1;
}

public int cmd_abseilen(string str) {
  notify_fail("Wohin willst du dich abseilen?\n");
  if(!str || str == "") return 0;
  if(str != "ab" && str != "in felsspalte ab" && str != "dich in die felsspalte ab" &&
     str != "in spalte ab" && str != "in die tife ab") return 0;

  if(!objectp(present("seil", TP))) {
    write(BS("Aber du hast gar kein Seil bei dir!"));
    return -1;
  }

  write(BS("Mit einem raschen Knoten windest du das Seil um den Metallring und seilst dich hinab in die dunkle Tiefe."));
  say(BS(TPN+" seilt sich in die dunkle Tiefe der Felsspalte ab."));

  TP->move(ROOM "j_5", M_GO);
  return 1;
}

