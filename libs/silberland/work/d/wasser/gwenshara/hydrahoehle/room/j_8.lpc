#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Schmale Spalten in den Waenden leuchten schwach und markieren den Weg durch "
    "die Hoehle. Die glitschige Oberflaeche reflektiert das matte Licht, waehrend "
    "der saeureartige Dampf eine gespenstische Aura verleiht. Die Spalten sind "
    "wie schimmernde Pfade durch die Dunkelheit, und die rutschigen Waende lassen "
    "erahnen, dass jede Bewegung Vorsicht erfordert.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "aura" }),
    "Die Hoehle ist von einer gespenstischen Aura erfuellt, verstaerkt durch den saeureartigen Dampf.");

  AddDetail( ({ "bewegung" }),
    "Die rutschigen Waende lassen erahnen, dass jede Bewegung Vorsicht erfordert.");

  AddDetail( ({ "boden" }),
    "Der Boden der Hoehle ist glitschig und reflektiert das matte Licht.");

  AddDetail( ({ "dampf" }),
    "Saeureartiger Dampf durchzieht die Hoehle, verleiht ihr eine unheilvolle Atmosphaere.");

  AddDetail( ({ "decke" }),
    "Schmale Spalten in den Waenden leuchten schwach und werfen ein mattes Licht auf die Decke.");

  AddDetail( ({ "dunkelheit" }),
    "Die Dunkelheit wird von den schwach leuchtenden Spalten in den Waenden durchbrochen.");

  AddDetail( ({ "hoehle" }),
    "Die Hoehle erstreckt sich vor dir, markiert von den schwach leuchtenden Spalten.");

  AddDetail( ({ "licht" }),
    "Das matte Licht wird von den glitschigen Waenden reflektiert.");

  AddDetail( ({ "oberflaeche" }),
    "Die glitschige Oberflaeche des Bodens reflektiert das Licht und verstaerkt den gespenstischen Eindruck.");

  AddDetail( ({ "pfade" }),
    "Die Spalten in den Waenden wirken wie schimmernde Pfade durch die Dunkelheit.");

  AddDetail( ({ "spalten" }),
    "Schmale Spalten in den Waenden leuchten schwach und markieren den Weg durch die Hoehle.");

  AddDetail( ({ "vorsicht" }),
    "Die rutschigen Waende lassen erahnen, dass jede Bewegung Vorsicht erfordert.");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende der Hoehle sind glitschig, durchzogen von schwach leuchtenden Spalten.");

  AddDetail( ({ "weg" }),
    "Die schimmernden Pfade in den Spalten wirken wie ein Weg durch die Dunkelheit.");

  AddDetail( ({ "atmosphaere" }),
    "Die Atmosphaere in der Hoehle ist duester und gespenstisch, verstaerkt durch den saeureartigen Dampf.");

  AddDetail( ({ "eindruck" }),
    "Der Eindruck der Hoehle ist gepraegt von glitschigen Waenden, schwach leuchtenden Spalten und dem saeureartigen Dampf.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "sueden", ROOM "j_9" );
  AddExit( "nordosten", ROOM "k_7");
  AddExit( "nordwesten", ROOM "i_7");
}


