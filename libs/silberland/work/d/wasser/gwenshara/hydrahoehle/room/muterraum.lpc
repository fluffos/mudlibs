#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Brutstaette der Hydramutter");
  SetProp(P_INT_LONG,
    "Du betrittst die Brutstaette der maechtigen Hydramutter, eine riesige Hoehle, "
    "die als Brutort fuer die monstroesen Nachkommen dient. Der Boden besteht "
    "aus schwarzem Schlamm, der von saeurehaltigen Daempfen durchzogen ist, waehrend "
    "die Waende von glatten, schuppigen Rueckstaenden bedeckt sind. Die Luft ist "
    "erfuellt von einem charakteristischen Geruch nach Brut und Unheil. Dunkle "
    "Nischen entlang der Hoehlenwand dienen als Brutplaetze, in denen die frischen "
    "Eier in durchsichtigen Membranen warten.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "boden", "schlamm" }),
  "Der Boden der Brutstaette besteht aus schwarzem Schlamm, durchzogen von saeurehaltigen Daempfen.");

  AddDetail( ({ "brut", "brutort" }),
  "Die Brutstaette dient als Ort fuer die Entwicklung und Aufzucht der monstroesen Nachkommen der Hydramutter.");

  AddDetail( ({ "brutplaetze", "nischen" }),
  "Dunkle Nischen entlang der Hoehlenwand dienen als Brutplaetze, in denen die frischen Eier in durchsichtigen Membranen warten.");

  AddDetail( ({ "brutstaette" }),
  "Die Hoehle ist die Brutstaette der maechtigen Hydramutter, ein Ort, an dem ihre monstroesen Nachkommen heranwachsen.");

  AddDetail( ({ "daempfen", "luft" }),
  "Die Luft in der Brutstaette ist erfuellt von einem charakteristischen Geruch nach Brut und Unheil, waehrend saeurehaltige Daempfe durchziehen.");

  AddDetail( ({ "decke", "hoehlenwand", "waende", "wand" }),
  "Die Waende der Brutstaette sind glatt und von schuppigen Rueckstaenden bedeckt.");

  AddDetail( ({ "eier", "membranen", "nachkommen" }),
  "In den dunklen Nischen warten frische Eier in durchsichtigen Membranen auf ihre weitere Entwicklung.");

  AddDetail( ({ "geruch", "unheil" }),
  "Ein charakteristischer Geruch nach Brut und Unheil liegt in der Luft der Brutstaette.");

  AddDetail( ({ "hydramutter" }),
  "Die Hydramutter, eine maechtige Kreatur, bewohnt die Brutstaette und ueberwacht die Entwicklung ihrer Nachkommen.");

  AddDetail( ({ "aufzucht" }),
  "In der Brutstaette erfolgt die Aufzucht der monstroesen Nachkommen der Hydramutter.");

AddDetail( ({ "entwicklung" }),
  "Die Brutstaette dient als Ort fuer die Entwicklung der frischen Eier zu den monstroesen Nachkommen der Hydramutter.");

AddDetail( ({ "hoehle" }),
  "Die Hoehle der Hydramutter erstreckt sich als Brutstaette und Wohnort der Kreatur.");

AddDetail( ({ "kreatur" }),
  "Die Hydramutter, eine maechtige und gefaehrliche Kreatur, bewohnt die Brutstaette.");

AddDetail( ({ "ort" }),
  "Die Brutstaette ist ein bedeutender Ort fuer die Fortpflanzung und Entwicklung der Hydramutter-Nachkommen.");

AddDetail( ({ "rueckstaenden" }),
  "Die glatten Waende der Brutstaette sind von schuppigen Rueckstaenden bedeckt.");

  AddDetail( ({ "daempfe" }),
    "Saeurehaltige Daempfe durchziehen die Brutstaette, ein Nebenprodukt der Fortpflanzung und Entwicklung der Hydramutter-Nachkommen.");

  AddDetail( ({ "fortpflanzung" }),
    "Die Brutstaette ist der Ort, an dem die Hydramutter ihre Eier legt und fuer die Fortpflanzung ihrer monstroesen Nachkommen sorgt.");

  AddDetail( ({ "wohnort" }),
    "Die Hoehle der Hydramutter dient nicht nur als Brutstaette, sondern auch als Wohnort fuer die gefaehrliche Kreatur.");

AddDetail( ({ "nebenprodukt", "zeichen" }),
"Die saeurehaltigen Daempfe sind ein Nebenprodukt der des Bruetens der Hydramutter, ein Zeichen fuer die lebhafte Entwicklung der Nachkommen.");

 AddDetail( ({"bruetens", "brueten"}),
  "In dieser Hoehle bruetet die Hydramutter.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "oben", ROOM "j_7" );

  AddItem( NPC "hydramutter", REFRESH_DESTRUCT);
}
