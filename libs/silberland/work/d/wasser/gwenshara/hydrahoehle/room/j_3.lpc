#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein Bergpfad auf Hypros");
  SetProp(P_INT_LONG,
    "Der Pfad verliert seine Steigung und schlaengelt sich trostlos zwischen "
    "schroffen Felsen hindurch. Der Boden ist karg und von groben Felsbrocken "
    "uebersaet, waehrend der Himmel von den unnachgiebigen Bergspitzen dominiert wird. "
    "Kein Hauch von Pflanzenleben ist zu erkennen, und die karge Umgebung verleiht "
    "dem Pfad eine unwirtliche Atmosphaere. Ein beunruhigendes Schweigen haengt in der Luft");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

AddDetail(({ "atmosphaere" }),
"Die Atmosphaere entlang des trostlosen Bergpfads ist von Unwirtlichkeit und einem beunruhigenden Schweigen durchdrungen.");

AddDetail(({ "bergspitzen" }),
"Die unnachgiebigen Bergspitzen dominieren den Himmel und verleihen der Umgebung eine majestaetische, aber duestere Praesenz.");

AddDetail(({ "boden" }),
"Der Boden des Pfads ist karg und von groben Felsbrocken uebersaet, ein trostloses Bild inmitten der schroffen Landschaft.");

AddDetail(({ "felsbrocken" }),
"Grosse Felsbrocken liegen verstreut auf dem Pfad, zeugen von der rauen Natur der bergigen Umgebung.");

AddDetail(({ "felsen" }),
"Die schroffen Felsen ragen entlang des Pfads empor, ihre kahlen Oberflaechen verstaerken die Unwirtlichkeit der Umgebung.");

AddDetail(({ "hauch" }),
"Kein Hauch von Pflanzenleben ist zu erkennen, und die karge Umgebung verstaerkt das Gefuehl der Einsamkeit.");

AddDetail(({ "himmel" }),
"Der Himmel wird von den unnachgiebigen Bergspitzen dominiert, die eine majestaetische Kulisse fuer den Pfad bilden.");

AddDetail(({ "luft" }),
"Die Luft entlang des Bergpfads ist duenn und erfuellt mit einem beunruhigenden Schweigen.");

AddDetail(({ "pfad", "bergpfad", "weg", "wegen" }),
"Der Pfad verliert seine Steigung und schlaengelt sich trostlos zwischen schroffen Felsen hindurch.");

AddDetail(({ "pflanzenleben" }),
"Kein Hauch von Pflanzenleben ist entlang des kargen Pfads zu erkennen, die Umgebung ist leblos und oede.");

AddDetail(({ "schweigen" }),
"Ein beunruhigendes Schweigen haftet in der Luft, verstaerkt die Einsamkeit und Unwirtlichkeit des Bergpfads.");

AddDetail(({ "steigung" }),
"Die Steigung des Pfads laesst nach, waehrend er sich zwischen den schroffen Felsen hindurchschlaengelt.");

AddDetail(({ "umgebung" }),
"Die karge Umgebung des Bergpfads verleiht dem Pfad eine unwirtliche Atmosphaere, gepraegt von schroffen Felsen und kargem Boden.");

AddDetail(({ "bergpfads" }),
"Der Bergpfad windet sich trostlos zwischen den schroffen Felsen hindurch, eine Herausforderung inmitten der unwirtlichen Landschaft.");

AddDetail(({ "bild" }),
"Das Bild entlang des Bergpfads ist gepraegt von kargem Boden, schroffen Felsen und einer duesteren Kulisse, die Einsamkeit vermittelt.");

AddDetail(({ "einsamkeit" }),
"Die Einsamkeit des Bergpfads ist greifbar, verstaerkt durch das beunruhigende Schweigen und die leblose Umgebung.");

AddDetail(({ "gefuehl" }),
"Ein Gefuehl der Unwirtlichkeit und Einsamkeit begleitet dich entlang des Bergpfads, waehrend die schroffe Natur ihre Praesenz zeigt.");

AddDetail(({ "kulisse" }),
"Die majestaetischen Bergspitzen bilden eine duestere Kulisse entlang des Pfads, die von einer unwirtlichen Atmosphaere gepraegt ist.");

AddDetail(({ "landschaft" }),
"Die schroffe Landschaft entlang des Bergpfads zeigt die raue Natur und Unwirtlichkeit dieser abgelegenen Gegend.");

AddDetail(({ "natur" }),
"Die karge Natur entlang des Bergpfads offenbart eine leblose Umgebung, in der Pflanzenleben und Farben fehlen.");

AddDetail(({ "oberflaechen" }),
"Die kahlen Oberflaechen der schroffen Felsen und groben Felsbrocken praegen das Erscheinungsbild des Bergpfads.");

AddDetail(({ "praesenz" }),
"Die majestaetischen Bergspitzen verleihen dem Bergpfad eine eindrucksvolle Praesenz, die von Unwirtlichkeit gepraegt ist.");

AddDetail(({ "unwirtlichkeit" }),
"Die Unwirtlichkeit des Bergpfads zeigt sich in der leblosen Umgebung, dem kargen Boden und den schroffen Felsen.");

AddDetail(({ "erscheinungsbild" }),
"Das Erscheinungsbild des Bergpfads wird von kahlen Oberflaechen, groben Felsbrocken und der duesteren Kulisse der Bergspitzen gepraegt.");

AddDetail(({ "farben" }),
"Farben fehlen entlang des Bergpfads, die Landschaft ist gepraegt von gedeckten Toenen, die die Einsamkeit und Unwirtlichkeit verstaerken.");

AddDetail(({ "gef" }),
"Die Gefahr und Herausforderung des Bergpfads sind in der schroffen Gegend spuerbar, waehrend er sich durch die unwirtliche Umgebung schlaengelt.");

AddDetail(({ "gegend" }),
"Die Gegend entlang des Bergpfads zeigt sich von ihrer rauen Seite, gepraegt von schroffen Felsen und einer leblosen Natur.");

AddDetail(({ "herausforderung" }),
"Der Bergpfad ist eine Herausforderung, die von steinigen Wegen, kargem Boden und der duesteren Atmosphaere der Gegend gepraegt ist.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ROOM "j_2" );
  AddExit( "sueden", ROOM "j_4" );

  AddItem(NPC "ziege", REFRESH_DESTRUCT);

}

