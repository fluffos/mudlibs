#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Ein glitschiger Abhang fuehrt tiefer in die Hoehle hinab. Der kalte Wind "
    "pfeift durch die Hoehlengaenge, waehrend leuchtende Flechten an den Waenden "
    "eine gespenstische Atmosphaere schaffen. Jeder Schritt auf dem glatten "
    "Pfad ist eine Herausforderung, und das Echo fremdartiger Schreie durchdringt "
    "die feuchte Kaelte.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

AddDetail(({ "abhang" }),
"Der glitschige Abhang fuehrt dich tiefer in die dunklen Tiefen der Hoehle hinab.");

AddDetail(({ "atmosphaere" }),
"Leuchtende Flechten an den Waenden schaffen eine gespenstische Atmosphaere in der Hoehle.");

AddDetail(({ "boden" }),
"Der Boden des glitschigen Pfads ist eine staendige Herausforderung, mit jedem Schritt droht das Ausrutschen.");

AddDetail(({ "decke" }),
"Die Decke der Hoehle ist von schimmernden Flechten bedeckt, die ein mysterioeses Licht abgeben.");

AddDetail(({ "echo" }),
"Das Echo fremdartiger Schreie durchdringt die feuchte Kaelte, verleiht der Hoehle eine unheimliche Akustik.");

AddDetail(({ "flechten" }),
"Leuchtende Flechten an den Waenden verleihen der Hoehle ein gespenstisches Leuchten.");

AddDetail(({ "herausforderung" }),
"Jeder Schritt auf dem glatten Pfad stellt eine Herausforderung dar, das Gleichgewicht zu halten.");

AddDetail(({ "hoehle" }),
"Die Hoehle erstreckt sich vor dir, dunkel und voller Geheimnisse, waehrend der glitschige Pfad hinabfuehrt.");

AddDetail(({ "hoehlengaenge" }),
"Die Hoehlengaenge winden sich tief in die Eingeweide der Hoehle, unerforscht und geheimnisvoll.");

AddDetail(({ "kaelte" }),
"Die feuchte Kaelte durchdringt die Hoehle, waehrend der kalte Wind durch die Gaenge pfeift.");

AddDetail(({ "pfad" }),
"Der glitschige Pfad windet sich gefaehrlich den Abhang hinab, eine rutschige Herausforderung.");

AddDetail(({ "schreie" }),
"Fremdartige Schreie hallen durch die Hoehle, verleihen der Umgebung eine gespenstische Aura.");

AddDetail(({ "schritt" }),
"Jeder Schritt auf dem glatten Pfad erfordert Vorsicht, um nicht auszurutschen.");

AddDetail(({ "waende", "wand" }),
"Die Waende der Hoehle sind von leuchtenden Flechten bedeckt, die das Innere mit ihrem gespenstischen Licht erhellen.");

AddDetail(({ "wind" }),
"Der kalte Wind pfeift durch die Hoehlengaenge, traegt fremdartige Geraeusche und Kaelte mit sich.");

AddDetail(({ "akustik" }),
"Die Akustik in der Hoehle verstaerkt das Echo der fremdartigen Schreie, die durch die Tiefen hallen.");

AddDetail(({ "aura" }),
"Die Aura der Hoehle ist durchtraenkt von geheimnisvoller Kaelte und dem gespenstischen Leuchten der Flechten.");

AddDetail(({ "ausrutschen" }),
"Das Risiko des Ausrutschens auf dem glitschigen Pfad erhoeht die Spannung in der Hoehle.");

AddDetail(({ "eingeweide" }),
"Die Hoehle erstreckt sich wie die Eingeweide des Berges, tief und unerforscht.");

AddDetail(({ "gaenge" }),
"Die Hoehlengaenge winden sich durch die Dunkelheit, ihre Geheimnisse und Schatten verborgen.");

AddDetail(({ "geheimnisse" }),
"Die Hoehle bewahrt ihre tiefsten Geheimnisse in den dunklen Ecken und Winkeln.");

AddDetail(({ "geraeusche" }),
"Fremdartige Geraeusche erfuellen die Umgebung, als ob die Hoehle selbst sprechen wuerde.");

AddDetail(({ "gleichgewicht" }),
"Das Gleichgewicht zu halten auf dem glatten Pfad erfordert staendige Vorsicht.");

AddDetail(({ "innere" }),
"Das Innere der Hoehle ist von duesterer Schoenheit und schattenhaften Formen gepraegt.");

AddDetail(({ "leuchten" }),
"Das gespenstische Leuchten der Flechten erhellt das Innere der Hoehle, enthuellt aber auch ihre duesteren Ecken.");

AddDetail(({ "licht" }),
"Das Licht der leuchtenden Flechten taucht die Hoehle in ein mysterioeses Gluehen.");

AddDetail(({ "tiefen" }),
"Die Tiefen der Hoehle bergen unbekannte Gefahren und verborgene Schaetze.");

AddDetail(({ "umgebung" }),
"Die Umgebung der Hoehle ist von gespenstischer Kaelte und duesterer Atmosphaere durchdrungen.");

AddDetail(({ "vorsicht" }),
"Vorsicht ist geboten, waehrend du dich durch die duesteren Gaenge der Hoehle bewegst.");

AddDetail(({ "berges" }),
"Die Hoehle erstreckt sich tief in die Eingeweide des Berges, offenbart seine dunklen Geheimnisse.");

AddDetail(({ "dunkelheit" }),
"Die Dunkelheit der Hoehle ist undurchdringlich, nur vom gespenstischen Leuchten der Flechten erhellt.");

AddDetail(({ "ecken" }),
"Die dunklen Ecken der Hoehle bergen schattenhafte Geheimnisse, die darauf warten, entdeckt zu werden.");

AddDetail(({ "formen", "gestalt", "gestalten" }),
"Schattenhafte Formen zeichnen sich an den Waenden der Hoehle ab, verleihen ihr eine geheimnisvolle Gestalt.");

AddDetail(({ "gefahren" }),
"Die Tiefen der Hoehle bergen unbekannte Gefahren, die in der Dunkelheit lauern.");

AddDetail(({ "gluehen" }),
"Das gespenstische Leuchten der Flechten verleiht der Hoehle ein mysterioeses Gluehen.");

AddDetail(({ "risiko" }),
"Das Risiko des Ausrutschens auf dem glatten Pfad erhoeht die Spannung in der Hoehle.");

AddDetail(({ "schaetze" }),
"Die Dunkelheit der Hoehle birgt moeglicherweise verborgene Schaetze, die im Gluehen der Flechten verborgen sind.");

AddDetail(({ "schatten" }),
"Die Hoehle wird von schattenhaften Gestalten und dunklen Schatten durchzogen.");

AddDetail(({ "schoenheit" }),
"Die duestere Schoenheit der Hoehle offenbart sich in den schattenhaften Formen und geheimnisvollen Ecken.");

AddDetail(({ "spannung", "luft" }),
"Die Spannung in der Hoehle liegt in der Luft, waehrend unbekannte Gefahren und Geheimnisse darauf warten, entdeckt zu werden.");

AddDetail(({ "winkeln", "winkel" }),
"Die dunklen Winkel der Hoehle bergen schattenhafte Geheimnisse, die darauf warten, entdeckt zu werden.");

//--Ausgaenge--------------------------------------------------------------
  AddExit( "osten", ROOM "l_5" );
  AddExit( "westen", ROOM "j_5");
}

