#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Ein Bergpfad auf Hypros");
  SetProp(P_INT_LONG,
    "Du stehst am Anfang eines schmalen Bergpfads, der sich sanft den Huegel "
    "hinaufwindet. Der Boden ist von goldenem Sand bedeckt, gesaeumt von"
    "wilden Oleanderbueschen und duftenden Zypressen. Zwei imposante Statuen von "
    "Kriegern flankieren den Eingang des Pfads, ihre steinernen Augen scheinen "
    "ueber das azurblaue Meer zu wachen. Vor dir erhebt sich majestaetisch das Tor "
    "von Hypros. Der Pfad fuehrt dich tiefer in die Berge der Insel.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_MOUNTAIN]) );

//--Details----------------------------------------------------------------

  //--Details----------------------------------------------------------------

AddDetail(({ "anfang" }),
"Du stehst am Anfang eines schmalen Bergpfads, der sich sanft den Huegel hinaufwindet.");

AddDetail(({ "augen" }),
"Die steinernen Augen der imposanten Kriegerstatuen scheinen ueber das azurblaue Meer zu wachen.");

AddDetail(({ "berge" }),
"Die majestaetischen Berge der Insel erstrecken sich in der Ferne, umrahmt vom klaren Himmel.");

AddDetail(({ "bergpfads" }),
"Der Bergpfad fuehrt dich sanft den Huegel hinauf und tiefer in die Berge der Insel.");

AddDetail(({ "boden" }),
"Der goldene Sand bedeckt den Boden des Bergpfads und verleiht der Umgebung eine warme Ausstrahlung.");

AddDetail(({ "eingang" }),
"Der Eingang des Pfads wird von zwei imposanten Statuen von Kriegern flankiert, die den Weg bewachen.");

AddDetail(({ "himmel" }),
"Der Himmel ueber den Bergen strahlt in klarem Blau, waehrend die Sonne ihre Strahlen auf die Insel sendet.");

AddDetail(({ "huegel" }),
"Der Bergpfad windet sich sanft den Huegel hinauf, umgeben von wilden Oleanderbueschen und duftenden Zypressen.");

AddDetail(({ "hypros" }),
"Hypros, die bezaubernde Insel, erhebt sich majestaetisch vor dir, waehrend der Bergpfad dich tiefer in ihre Berge fuehrt.");

AddDetail(({ "insel" }),
"Die Insel Hypros erstreckt sich in ihrer Schoenheit vor dir, umgeben vom azurblauen Meer.");

AddDetail(({ "kriegern" }),
"Die imposanten Statuen von Kriegern bewachen den Eingang des Bergpfads mit ernsten Gesichtern und steinernen Waffen.");

AddDetail(({ "meer" }),
"Das azurblaue Meer erstreckt sich vor der Insel, und die Wellen tanzen im sanften Rhythmus an den Ufern.");

AddDetail(({ "oleanderbueschen" }),
"Wilde Oleanderbueschen saeumen den Bergpfad, ihre Blueten verleihen der Umgebung eine bunte Note.");

AddDetail(({ "pfad" }),
"Der Bergpfad fuehrt dich tiefer in die Berge der Insel, umgeben von natuerlicher Schoenheit und klarem Himmel.");

AddDetail(({ "pfads" }),
"Die Umgebung des Bergpfads besteht aus wilden Oleanderbueschen, duftenden Zypressen und goldenem Sand.");

AddDetail(({ "sand" }),
"Der goldene Sand bedeckt den Boden des Bergpfads und glaenzt in der Sonne.");

AddDetail(({ "statuen", "kriegerstatuen" }),
"Die imposanten Statuen von Kriegern flankieren den Eingang des Bergpfads, ihre steinernen Figuren beeindrucken jeden Besucher.");

AddDetail(({ "tor" }),
"Das majestaetische Tor von Hypros erhebt sich vor dir, waehrend der Bergpfad dich tiefer in die Berge fuehrt.");

AddDetail(({ "zypressen" }),
"Duftende Zypressen rahmen den Bergpfad ein und verleihen der Umgebung eine angenehme Atmosphaere.");

//--Details----------------------------------------------------------------

AddDetail(({ "atmosphaere" }),
"Die Atmosphaere am Bergpfad ist von Ruhe und natuerlicher Schoenheit gepraegt, waehrend die Berge majestaetisch in der Ferne aufragen.");

AddDetail(({ "ausstrahlung" }),
"Die Ausstrahlung der Umgebung am Bergpfad vermittelt ein Gefuehl von Frieden und Erhabenheit.");

AddDetail(({ "bergpfad" }),
"Der Bergpfad erstreckt sich vor dir, bereit, von Besuchern erkundet zu werden, waehrend er sich den Huegel hinaufwindet.");

AddDetail(({ "besucher" }),
"Besucher koennen den Bergpfad erkunden und die natuerliche Schoenheit der Umgebung geniessen.");

AddDetail(({ "blau" }),
"Der Himmel ueber den Bergen strahlt in klarem Blau, waehrend die Sonne ihre Strahlen auf die Insel sendet.");

AddDetail(({ "blueten" }),
"Die Blueten der wilden Oleanderbueschen verleihen dem Bergpfad eine bunte Note und verbreiten einen angenehmen Duft.");

AddDetail(({ "ferne" }),
"In der Ferne ragen majestaetische Berggipfel empor, waehrend der Bergpfad dich tiefer in die Berge fuehrt.");

AddDetail(({ "figuren" }),
"Die steinernen Figuren der Kriegerstatuen haben ernste Gesichter und strahlen eine gewisse Wuerde aus.");

AddDetail(({ "gesichtern" }),
"Die Gesichter der Kriegerstatuen wirken ernst und bewacht, als wuerden sie ueber den Bergpfad wachen.");

AddDetail(({ "note" }),
"Die Umgebung des Bergpfads hinterlaesst einen bleibenden Eindruck, gepraegt von natuerlicher Schoenheit und Ruhe.");

AddDetail(({ "rhythmus" }),
"Die Wellen tanzen im sanften Rhythmus an den Ufern, waehrend der Bergpfad sich durch die Berglandschaft schlengelt.");

AddDetail(({ "schoenheit" }),
"Die natuerliche Schoenheit am Bergpfad wird durch die blauen Himmel, die wilden Oleanderbuesche und majestaetischen Berge unterstrichen.");

AddDetail(({ "sonne" }),
"Die Sonne sendet ihre warmen Strahlen auf die Insel, waehrend du den Bergpfad erkundest.");

AddDetail(({ "strahlen" }),
"Die Strahlen der Sonne durchdringen die klare Luft und tauchen die Umgebung am Bergpfad in ein warmes Licht.");

AddDetail(({ "ufern" }),
"Die Wellen tanzen im sanften Rhythmus an den Ufern, und der Bergpfad fuehrt dich tiefer in die beeindruckende Berglandschaft.");

AddDetail(({ "umgebung" }),
"Die Umgebung am Bergpfad zeigt sich in ihrer vollen Pracht, gepraegt von wilden Oleanderbueschen, majestaetischen Bergen und blauem Himmel.");

AddDetail(({ "waffen" }),
"Die steinernen Waffen der Kriegerstatuen verleihen den Figuren eine martialische Ausstrahlung.");

AddDetail(({ "weg" }),
"Der Bergpfad schlengelt sich als sanfter Weg den Huegel hinauf, um Besuchern einen angenehmen Aufstieg zu bieten.");

AddDetail(({ "wellen" }),
"Die Wellen tanzen im sanften Rhythmus an den Ufern, waehrend der Bergpfad sich durch die beeindruckende Berglandschaft zieht.");
    
//--Details----------------------------------------------------------------

AddDetail(({ "aufstieg" }),
"Der Aufstieg des Bergpfads fuehrt dich sanft den Huegel hinauf, waehrend du die Berglandschaft erkundest.");

AddDetail(({ "berggipfel" }),
"Die majestaetischen Berggipfel erheben sich in der Ferne und bilden eine beeindruckende Kulisse entlang des Bergpfads.");

AddDetail(({ "berglandschaft" }),
"Die Berglandschaft um den Pfad herum erstreckt sich in ihrer ganzen Pracht, gepraegt von wilden Oleanderbueschen und majestaetischen Bergen.");

AddDetail(({ "duft" }),
"Der Duft der bluetenden Oleanderbuesche begleitet dich entlang des Bergpfads und verleiht der Umgebung eine angenehme Note.");

AddDetail(({ "eindruck" }),
"Der Eindruck der Berglandschaft und des Bergpfads hinterlaesst einen bleibenden Eindruck von Erhabenheit und natuerlicher Schoenheit.");

AddDetail(({ "erhabenheit" }),
"Die Erhabenheit der Berglandschaft und des klaren Himmels vermitteln ein Gefuehl von Majestaet und Frieden.");

AddDetail(({ "frieden" }),
"Die Atmosphaere am Bergpfad strahlt Frieden aus, waehrend du dich dem Aufstieg hingibst.");

AddDetail(({ "gefuehl" }),
"Das Gefuehl der Ruhe und Erhabenheit begleitet dich entlang des Bergpfads, waehrend du die Berglandschaft erkundest.");

AddDetail(({ "gesichter" }),
"Die Gesichter der Kriegerstatuen wirken ernst und bewacht, als wuerden sie die Umgebung des Bergpfads beschuetzen.");

AddDetail(({ "licht" }),
"Das Licht der Sonne durchflutet die Umgebung und taucht die Berglandschaft in ein warmes, goldenes Licht.");

AddDetail(({ "luft", "bergluft" }),
"Die frische Bergluft begleitet dich waehrend des Aufstiegs, und du spuerst, wie du die klare Luft einatmest.");

AddDetail(({ "oleanderbuesche" }),
"Die wilden Oleanderbuesche entlang des Bergpfads bluhen in lebendigen Farben und verleihen der Umgebung eine bunte Pracht.");

AddDetail(({ "pracht" }),
"Die Pracht der Berglandschaft zeigt sich in den bluetenden Oleanderbueschen, majestaetischen Bergen und klarem Himmel.");

AddDetail(({ "ruhe" }),
"Die Ruhe am Bergpfad wird nur vom sanften Rauschen der Blaetter und dem Gesang der Voegel durchbrochen.");

AddDetail(({ "wuerde" }),
"Die steinernen Figuren der Kriegerstatuen strahlen eine gewisse Wuerde und Kraft aus, waehrend sie den Eingang des Bergpfads flankieren.");

//--Details----------------------------------------------------------------

AddDetail(({ "blaetter" }),
"Die Blaetter der Oleanderbuesche und Zypressen bewegen sich im sanften Bergwind und erzeugen ein beruhigendes Rauschen.");

AddDetail(({ "farben" }),
"Die lebendigen Farben der bluetenden Oleanderbuesche verleihen der Berglandschaft eine bunte und malerische Atmosphaere.");

AddDetail(({ "gesang" }),
"Der melodische Gesang der Voegel begleitet dich entlang des Bergpfads und verleiht der Umgebung eine harmonische Kulisse.");

AddDetail(({ "kraft" }),
"Die steinernen Figuren der Kriegerstatuen strahlen eine gewisse Wuerde und Kraft aus, waehrend sie den Eingang des Bergpfads flankieren.");

AddDetail(({ "kulisse" }),
"Die Berglandschaft bildet eine beeindruckende Kulisse, gepraegt von majestaetischen Bergen, bluetenden Oleanderbueschen und klarem Himmel.");

AddDetail(({ "majestaet" }),
"Die Majestaet der Berggipfel und der klare Himmel vermitteln ein erhabenes Gefuehl, waehrend du den Bergpfad erklimmst.");

AddDetail(({ "rauschen" }),
"Das sanfte Rauschen der Blaetter und das leise Rauschen des Windes erfuellen die Umgebung mit einer beruhigenden Ruhe.");

AddDetail(({ "voegel" }),
"Die Voegel singen ihre melodischen Lieder und tragen dazu bei, die Berglandschaft mit Leben zu fuellen.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "norden", ANSCHLUSS_HYPROS );
  AddExit( "suedwesten", ROOM "j_2");
}

