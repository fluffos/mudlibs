#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Durch einen schmalen Spalt betrittst du eine duestere Hoehle, in der der "
    "Boden von einer schleimigen Substanz bedeckt ist. Saeureartiger Dampf "
    "durchzieht die Luft, waehrend kriechende Schatten im fahlen Licht erscheinen. "
    "Der unheilvolle Geruch von Verderben vermischt sich mit der feuchten Kaelte, "
    "und der Pfad scheint von unsichtbaren Praesenzen bevoelkert zu sein. Durch "
    "ein schmales Loch an der Decke kannst du wieder hinaus klettern.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------
AddDetail(({ "boden" }),
"Der Boden der Hoehle ist von einer schleimigen Substanz bedeckt, die bei jedem Schritt nachgibt.");

AddDetail(({ "dampf" }),
"Saeureartiger Dampf durchzieht die Luft, verleiht der Hoehle eine bedrohliche Atmosphaere.");

AddDetail(({ "decke" }),
"Die Decke der Hoehle ist von einem schmalen Loch durchbrochen, durch das du wieder nach oben klettern kannst.");

AddDetail(({ "geruch" }),
"Ein unheilvoller Geruch von Verderben vermischt sich mit der feuchten Kaelte in der Hoehle.");

AddDetail(({ "hoehle" }),
"Du betrittst eine duestere Hoehle, in der kriechende Schatten im fahlen Licht erscheinen.");

AddDetail(({ "kaelte" }),
"Die feuchte Kaelte der Hoehle dringt bis auf die Haut, verstaerkt den unheilvollen Eindruck.");

AddDetail(({ "licht" }),
"Das fahle Licht enthuellt kriechende Schatten und die schleimige Substanz auf dem Hoehlenboden.");

AddDetail(({ "loch" }),
"Durch ein schmales Loch in der Decke kannst du wieder hinaus klettern, um der Hoehle zu entkommen.");

AddDetail(({ "luft" }),
"Die Luft in der Hoehle ist mit saeureartigem Dampf gesaettigt, was das Atmen erschwert.");

AddDetail(({ "pfad" }),
"Der Pfad durch die Hoehle scheint von unsichtbaren Praesenzen bevolkert zu sein, die im Dunkeln lauern.");

AddDetail(({ "praesenzen" }),
"Unsichtbare Praesenzen scheinen den Pfad zu umgeben, und ihre Anwesenheit verstaerkt das Unbehagen.");

AddDetail(({ "schatten" }),
"Kriechende Schatten bewegen sich im fahlen Licht, fuegen der Hoehle eine zusaetzliche unheimliche Dimension hinzu.");

AddDetail(({ "spalt" }),
"Durch einen schmalen Spalt hast du Zugang zu dieser duesteren Hoehle.");

AddDetail(({ "substanz" }),
"Der Boden ist mit einer schleimigen Substanz bedeckt, die bei Beruehrung klebrig wirkt.");

AddDetail(({ "verderben" }),
"Der unheilvolle Geruch von Verderben haengt in der Luft und verstaerkt die duestere Atmosphaere der Hoehle.");

AddDetail(({ "waende", "wand" }),
"Die Waende der Hoehle scheinen von den schleimigen Spuren vergangener Reisender gezeichnet zu sein.");

AddDetail(({ "anwesenheit" }),
"Die Anwesenheit unsichtbarer Praesenzen verstaerkt das Unbehagen, waehrend du die Hoehle erkundest.");

AddDetail(({ "atmen" }),
"Das Atmen wird erschwert durch die mit saeureartigem Dampf gesaettigte Luft in der Hoehle.");

AddDetail(({ "atmosphaere" }),
"Die Atmosphaere in der Hoehle ist von duesteren Schatten und unheilvoller Spannung durchzogen.");

AddDetail(({ "beruehrung" }),
"Die Beruehrung des Hoehlenbodens fuehlt sich klebrig an, als ob er nach jedem Schritt an deinen Schuhen haften bleibt.");

AddDetail(({ "dimension" }),
"Die kriechenden Schatten fuegen der Hoehle eine zusaetzliche unheimliche Dimension hinzu.");

AddDetail(({ "dunkeln", "dunkel" }),
"Im Dunkeln der Hoehle bewegen sich kriechende Schatten, die durch das fahle Licht enthuellt werden.");

AddDetail(({ "eindruck" }),
"Der Eindruck von Verderben und Unbehagen verstaerkt sich, je weiter du in die Hoehle vordringst.");

AddDetail(({ "haut" }),
"Die feuchte Kaelte der Hoehle dringt bis auf die Haut, verleiht der Umgebung eine zusaetzliche Schaerfe.");

AddDetail(({ "hoehlenboden" }),
"Der Hoehlenboden ist mit einer schleimigen Substanz bedeckt, die bei jedem Schritt nachgibt.");

AddDetail(({ "reisender" }),
"Die Waende der Hoehle tragen die Spuren vergangener Reisender, die sich durch diesen duesteren Ort gewagt haben.");

AddDetail(({ "schritt" }),
"Jeder Schritt auf dem klebrigen Hoehlenboden erzeugt ein schmatzendes Geraeusch, das die Stille durchbricht.");

AddDetail(({ "spuren" }),
"Die Waende der Hoehle tragen die Spuren vergangener Reisender, die sich hier durch das Dunkel bewegt haben.");

AddDetail(({ "unbehagen" }),
"Das Unbehagen waechst mit jeder weiteren Stufe, waehrend du tiefer in die duestere Hoehle vordringst.");

AddDetail(({ "zugang" }),
"Der Zugang zur Hoehle erfolgt durch einen schmalen Spalt, der den Eindruck erweckt, als ob er sich widerwillig oeffnet.");

AddDetail(({ "geraeusch" }),
"Das schmatzende Geraeusch deiner Schritte auf dem klebrigen Hoehlenboden durchbricht die Stille.");

AddDetail(({ "ort" }),
"Dieser duestere Ort, von schleimigem Boden und unheilvollem Dampf erfuellt, birgt Geheimnisse und Gefahren.");

AddDetail(({ "schaerfe" }),
"Die feuchte Kaelte verleiht der Umgebung eine zusaetzliche Schaerfe, die das Unbehagen verstaerkt.");

AddDetail(({ "schuhen", "schuhe", "schritt" }),
"Der klebrige Hoehlenboden haftet an deinen Schuhen, erschwert jeden Schritt in dieser feindseligen Umgebung.");

AddDetail(({ "spannung" }),
"Die Spannung in der Hoehle liegt in der Luft, verstaerkt durch die duestere Atmosphaere und unheimlichen Geraeusche.");

AddDetail(({ "stille" }),
"Die Stille der Hoehle wird nur durchbrochen durch das schmatzende Geraeusch deiner Schritte.");

AddDetail(({ "stufe" }),
"Mit jeder Stufe, die du tiefer in die Hoehle gehst, waechst das Unbehagen und die Gefahr.");

AddDetail(({ "umgebung" }),
"Die Umgebung dieser Hoehle ist duester und von unheimlicher Spannung durchdrungen.");


//--Ausgaenge--------------------------------------------------------------
  AddExit( "osten", ROOM "k_5" );
  AddExit( "westen", ROOM "i_5");

  AddCmd("kletter|klettere&rauf|nach oben|oben|durch spalte|durch felsspalte|raus", "cmd_klettern", "Wohin willst du klettern?");
}

public int cmd_klettern() {
  write(BS("Du kletterst durch die Felsspalte nach oben."));
  say(BS(TPN+" klettert durch die Felsspalte nach oben."));
  TP->move(ROOM "j_4", M_GO);
  return 1;
}

