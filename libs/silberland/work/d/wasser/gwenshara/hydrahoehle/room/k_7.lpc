#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Ein unterirdischer See liegt in einer abgelegenen Ecke der Hoehle, wo sein "
    "Glanz von den glitschigen Waenden reflektiert wird. Womoeglich nutzen die Hydren "
    "das Wasser, um ihre Beute zu ueberraschen. Ein ekelhafter Geruch liegt in "
    "der Luft.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

AddDetail( ({ "beute" }),
"Es scheint, als wuerde der unterirdische See von den Hydren genutzt, um ihre Beute zu ueberraschen.");

AddDetail( ({ "boden" }),
"Der Boden der Hoehle ist von feuchtem, rutschigem Schlamm bedeckt.");

AddDetail( ({ "decke" }),
"Die Decke der Hoehle ist von glitschigen Waenden bedeckt, die den Glanz des unterirdischen Sees reflektieren.");

AddDetail( ({ "ecke" }),
"Der unterirdische See liegt in einer abgelegenen Ecke der Hoehle.");

AddDetail( ({ "geruch" }),
"Ein ekelhafter Geruch liegt in der Luft der Hoehle.");

AddDetail( ({ "glanz" }),
"Der Glanz des unterirdischen Sees wird von den glitschigen Waenden reflektiert.");

AddDetail( ({ "hoehle" }),
"Die Hoehle erstreckt sich um den unterirdischen See herum.");

AddDetail( ({ "hydren" }),
"Es ist moeglich, dass die Hydren diesen unterirdischen See nutzen.");

AddDetail( ({ "luft" }),
"Die Luft in der Hoehle ist erfuellt von einem ekelhaften Geruch.");

AddDetail( ({ "see" }),
"Der unterirdische See glaenzt in der abgelegenen Ecke der Hoehle.");

AddDetail( ({ "waende", "wand" }),
"Die Waende der Hoehle sind glitschig und reflektieren den Glanz des unterirdischen Sees.");

AddDetail( ({ "wasser" }),
"Es ist schwer zu sagen, wie tief und mysterioes das Wasser des unterirdischen Sees ist. Es sieht sehr klar und rein aus.");

AddDetail( ({ "schlamm" }),
"Der Boden der Hoehle ist von feuchtem, rutschigem Schlamm bedeckt.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "suedwesten", ROOM "j_8" );
  AddExit( "westen", ROOM "j_7");

  AddCmd("trink|trinke&wasser|aus see|wasser aus see", "cmd_trinken", "Was willst du trinken?");

  AddItem( ({NPC "hydra_klein", NPC "hydra_mittel", NPC "hydra_gross"}), REFRESH_DESTRUCT);
}

public int cmd_trinken() {
  if(!TP->drink_drink(10, 0, 1)) {
    write("Du bist so voll, dass du nichts mehr trinken kannst.\n");
    return -1;
  }

  TP->AddHp(random(20));
  TP->AddSp(random(20));
  TP->AddPoison(-1);

  write(BS("Du nimmst einen Schluck des klaren Wassers aus dem See und fuehlst dich viel erfrischter!"));
  say(BS(TPN+" nimmst einen Schluck des klaren Wassers aus dem See und sieht viel erfrischter aus."));
  return 1;
}