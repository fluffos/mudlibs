#include "../def.h"

inherit "std/room";

int brokenEggs;

void create()
{
  ::create();
  brokenEggs = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In der Hoehle der Hydren");
  SetProp(P_INT_LONG,
    "Die Bruthoehle der Hydren offenbar eine duestere Kammer tief in der Hoehle. "
    "Der Boden ist von glitschigem, schwarzem Schlamm bedeckt, durchzogen von "
    "saeurehaltigen Daempfen. Feucht schimmernde, schuppige Rueckstaende ueberziehen "
    "die Waende, die als Brutplaetze dienen. In dunklen Nischen liegen Eier in "
    "durchsichtigen Membranen, waehrend ein dumpfes Grollen den Boden zum Zittern "
    "bringt. Weit hinten in der Hoehle erkennst du ein dunkles Loch im Boden.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "loch" }),
    "Aus dem Loch im Boden kommt immer wieder ein rhytmisches Fauchen und "
    "Zischen. Als waeren dort tausende Schlangen. Ein spitzer Felsen "
    "direkt daneben erlaubt es dir dich abzuseilen.");

  //--Details----------------------------------------------------------------

  AddDetail( ({ "boden" }),
    "Der Boden ist mit glitschigem, schwarzem Schlamm bedeckt, durchzogen von saeurehaltigen Daempfen.");

  AddDetail( ({ "bruthoehle" }),
    "Die Bruthoehle offenbart eine duestere Kammer tief in der Hoehle.");

  AddDetail( ({ "brutplaetze" }),
    "Feucht schimmernde, schuppige Rueckstaende ueberziehen die Waende und dienen als Brutplaetze.");

  AddDetail( ({ "daempfen" }),
    "Die Hoehle ist durchzogen von saeurehaltigen Daempfen, die die Luft schwer machen.");

  AddDetail( ({ "eier" }),
    "In dunklen Nischen liegen Eier in durchsichtigen Membranen.");

  AddDetail( ({ "fauchen" }),
    "Aus dem Loch im Boden kommt immer wieder ein rhythmisches Fauchen und Zischen, als waeren dort tausende Schlangen.");

  AddDetail( ({ "felsen" }),
    "Ein spitzer Felsen direkt neben dem Loch erlaubt es dir, dich abzuseilen.");

  AddDetail( ({ "grollen" }),
    "Ein dumpfes Grollen erklingt und bringt den Boden zum Zittern.");

  AddDetail( ({ "hoehle" }),
    "Die duestere Kammer ist die Bruthoehle der Hydren.");

  AddDetail( ({ "hydren" }),
    "Die Hydren sind hier nicht sichtbar, aber ihre Anwesenheit ist durch die duestere Atmosphaere spuerbar.");

  AddDetail( ({ "kammer" }),
    "Die duestere Kammer erstreckt sich tief in der Hoehle.");

  AddDetail( ({ "membranen" }),
    "Die Eier werden durch durchsichtige Membranen geschuetzt, damit sie nicht "
    "einfach so zerschlagen werden.");

  AddDetail( ({ "nischen" }),
    "Dunkle Nischen enthalten die Eier in durchsichtigen Membranen.");

  AddDetail( ({ "rueckstaende" }),
    "Feucht schimmernde, schuppige Rueckstaende ueberziehen die Waende und dienen als Brutplaetze.");

  AddDetail( ({ "schlamm" }),
    "Der Boden ist mit glitschigem, schwarzem Schlamm bedeckt.");

  AddDetail( ({ "schlangen" }),
    "Das rhythmische Fauchen und Zischen aus dem Loch im Boden erweckt den Eindruck von tausenden Schlangen.");

  AddDetail( ({ "waende" }),
    "Die Waende der Hoehle sind mit feucht schimmernden, schuppigen Rueckstaenden ueberzogen.");

  AddDetail( ({ "zischen" }),
    "Aus dem Loch im Boden kommt immer wieder ein rhythmisches Fauchen und Zischen, als waeren dort tausende Schlangen.");

  AddDetail( ({ "zittern" }),
    "Ein dumpfes Grollen erklingt und bringt den Boden zum Zittern.");

  AddDetail( ({ "anwesenheit" }),
    "Die Anwesenheit der Hydren ist spuerbar, obwohl sie gerade nicht sichtbar sind.");

  AddDetail( ({ "atmosphaere" }),
    "Die duestere Kammer verbreitet eine bedrohliche Atmosphaere.");

  AddDetail( ({ "decke" }),
    "Die Decke der Hoehle ist kaum sichtbar, da die duestere Kammer von schuppigen Rueckstaenden bedeckt ist.");

  AddDetail( ({ "eindruck" }),
    "Der Eindruck, den die Bruthoehle hinterlaesst, ist duester und bedrohlich.");

  AddDetail( ({ "luft" }),
    "Die Luft in der Hoehle ist schwer und mit saeurehaltigen Daempfen durchzogen.");

  AddDetail( ({ "wand", "waende" }),
    "Die Waende der duesteren Kammer sind mit feucht schimmernden, schuppigen Rueckstaenden ueberzogen.");


//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", ROOM "k_7" );

  AddCmd(({"seile", "seil"}), "cmd_abseilen");
  AddCmd("zerschlage|zerschlag&ei|eier|hydraeier|hydreneier|hydraei|hydrenei", "cmd_zerschlagen", "Was willst du zerschlagen?");

  AddItem( ({NPC "hydra_klein", NPC "hydra_mittel", NPC "hydra_gross"}), REFRESH_DESTRUCT);
  AddItem( ({NPC "hydra_klein", NPC "hydra_mittel", NPC "hydra_gross"}), REFRESH_DESTRUCT);
}

public int cmd_abseilen(string str) {
  object ob;

  notify_fail("Wohin willst du dich abseilen?\n");
  if(!str || str == "") return 0;
  if(str != "ab" && str != "in loch ab" && str != "dich in das loch ab" &&
     str != "ins loch ab" ) return 0;

  if(!objectp(present("seil", TP))) {
    write(BS("Aber du hast gar kein Seil bei dir!"));
    return -1;
  }

  if(objectp(ob=present("hydra"))) {
    write(BS(ob->Name(WER, 1)+" stellt sich dir in den Weg!"));
    say(BS(ob->Name(WER, 1)+" stellt sich "+TP->name(WEM, 1)+" in den Weg!"));
    return -1;
  }

  write(BS("Mit einem raschen Knoten windest du das Seil um den spitzen Felsen und seilst dich hinab in die dunkle Tiefe."));
  say(BS(TPN+" seilt sich in die dunkle Tiefe des Lochs im Boden ab."));

  TP->move(ROOM "muterraum", M_GO);
  return 1;
}

public int cmd_zerschlagen() {
  object baby;
  int i;

  if(brokenEggs) {
    write(BS("Jemand hat bereits alle Eier zerstoert."));
    return -1;
  }

  if(objectp(baby=present("hydra"))) {
    write(BS(baby->Name(WER, 1)+" faucht auf und stuerzt sich auf dich, um die Brut zu verteidigen!"));
    say(BS(baby->Name(WER, 1)+" faucht auf und stuert sich auf "+TP->name(WEN, 1)+" um die Brut zu verteidigen!"));
    baby->Kill(TP);
    return -1;
  }

  write(BS("Du trittst und schlaegst so lange auf den Eiern herum bis alle zerstoert sind. Gut so! "
           "Jezt verbreiten sich diese Kreaturen nicht weiter!"));
  say(BS(TPN+" zertritt einige der Hydreneier in den Nischen."));

  for(i=0; i<random(5); ++i) {
    baby = clone_object(NPC "hydra_baby");
    
    if(baby->move(TO, M_TPORT) != 1) {
      destruct(baby);
      continue;
    }

    baby->Kill(TP);
  }

  brokenEggs = 1;

  return 1;
}

public void reset() {
  ::reset();
  brokenEggs = 1;
}
