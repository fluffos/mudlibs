#include "../def.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein gewaltiger Hydrant");
  SetProp(P_LONG,
    "Der Hydrant ist die maennliche Form der Hydra. Denkst du zumindest. "
    "Egal, dieses Ungetuem vor dir ist gewaltig gross und zehn geiferende, "
    "drachenartige Koepfe beissen nach dir!");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hydrant");
  SetProp(P_GENDER, MALE);
  AddId(({"hydrant"}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(30+random(5));

  SetProp(P_HANDS, ({" mit seinen zehn Koepfen",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP, DT_ACID})
                    }) );

  SetProp(P_RACE, "Hydra");
  SetProp(P_SIZE, QueryProp(P_LEVEL)*200);
  SetProp(P_WEIGHT, QueryProp(P_LEVEL)*10000+random(50000));
  SetProp(P_ALIGN, -random(1000));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:     -0.2, DT_WATER:       0.1,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.1, DT_LIGHT:     0.3, DT_ELECTRIC:   -0.3,
       DT_ACID:     -0.5, DT_POISON:   -0.5, DT_TERROR:     -0.5,
       DT_HOLY:      0.1, DT_UNHOLY:   -0.2, DT_MAGIC:      -0.1,
       DT_MIND:      0.1, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1,
       DT_PIERCE:   -0.1, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.1,
       DT_RIP:      -0.1,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "j_9");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " kann gar nicht sprechen.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 25);

  AddSpell(3, 400,
    Name(WER, 1) + " beisst dich.\n",
    Name(WER, 1) + " beist @WEN.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));


  AddSpell(3, 400,
    Name(WER, 1) + " speit Saeure ueber dich.\n",
    Name(WER, 1) + " speit Saeure ueber @WEN.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 400, DS_MASS_DAMAGE,
    Name(WER, 1)+ " speit eine aetzende Saeurewolke um sich.\n",
    Name(WER, 1)+ " speit eine aetzende Saeurewolke um sich.\n",
    DT_ACID);

  AddSpell(2, 500,
    Name(WER, 1)+" speit aus einem seiner Koepfe einen Wasserstrahl auf dich!\n",
    Name(WER, 1)+" speit aus einem seiner Koepfe einen Wasserstrahl auf @WEN!\n",
    DT_WATER, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(1, 300, DS_MASS_POISON,
    Name(WER, 1)+" beisst dich mit seinen Giftzaehnen.\n",
    Name(WER, 1)+" beisst @WEN mit seinen Giftzaehnen.\n");

  AddDefaultSpell(1, 1, DS_BLIND,
    Name(WER, 1)+" spuckt dir Saeure ins Aug!\n",
    Name(WER, 1)+" spuckt @WEM Saeure ins Aug!\n");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
