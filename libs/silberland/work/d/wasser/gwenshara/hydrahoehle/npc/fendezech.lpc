#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Fendezech der Verkrueppelte");
  SetProp(P_LONG,
    "Fendezech ist eine bemitleidenswerte Kreatur. Er ist ein Mensch, doch "
    "das ist kaum erkennbar. Sein Ruecken ist zu einem Buckel verkruemmt, "
    "seine linke Hand verdreht und verkeummert und sein Gesicht eine mit "
    "Wucherungen und Tumoren uebersaeaete Fratze. Stummelige Zaehne ragen aus "
    "seinem schiefen Mund. Nur wenige Bueschel von Haar und Bart haenge an "
    "ihm herab. Dennoch scheint er unglaublich kraeftig zu sein. Mit seinen "
    "kleinen und verwachsenen gelblichen Augen blickt er dich listig an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fendezech");
  SetProp(P_GENDER, MALE);
  AddId(({"fendezech", "krueppel", "verkrueppelter", "\nhydrahoehle_priester", "Speerkaempfer"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("fendezech");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(22);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 145);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:     -0.2, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.1, DT_LIGHT:     0.2, DT_ELECTRIC:    0.0,
       DT_ACID:     -0.5, DT_POISON:   -0.5, DT_TERROR:     -0.5,
       DT_HOLY:      0.3, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.1,
       DT_MIND:      0.1, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "humpelt herein");
  SetProp(P_MSGOUT, "humpelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt mit einem gequaelten Aufschrei zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Die Mutter der Monster wird mich wieder holen!");
  SetProp(P_KILL_MSG, "Beuge dich der Mutter der Monstren!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " hat keine Ahnung.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddInfo( ({"monster","mutter"}),
    "Die Mutter gebiert die Monstren! Sie schenkt jenen, die keinen Platz haben "
    "ein zuhause. Sie gibt uns Kraft! Eines Tages wird sie alles verschlingen!",
    "sagt: ");

  AddInfo( ({"hydra","hydras","hydren"}),
    "Die Hydren sind die Kinder der Mutter. Sie hat die ersten geboren und die "
    "letzten leben in dieses Hoehlen.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddSpell(3, 350,
    "Fendezech beruehrt dich und Geschwuere breiten sich auf deiner Haut aus.\n",
    "Fendezech beruehrt @WEN und Geschwuere breiten sich auf der Haut aus.\n",
     DT_POISON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 400,
    "Fendezech schleudert einen finsteren Blitz auf dich.\n",
    "Fendezech schleudert einen finstren Blitz auf @WEN.\n",
    DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(1, 200, DS_POISON,
    Name(WER,1) + " kratzt dich mit seinen giftigen Naegeln!\n",
    Name(WER,1) + " kratzt @WEN mit seinen giftigen Naegeln!\n" );

  AddDefaultSpell(1, 1, DS_SLOW,
    Name(WER,1) + " laesst deine Arme und Beine verkrueppeln!\n",
    Name(WER,1) + " verkrueppelt @WESSEN Arme und Beine mit einem Blick!\n" );

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( "/p/weapon/spear/angriffsspeer" );
  command("zuecke speer");

  CLONEME("/p/armour/armour/brustpanzer");
  CLONEME("/p/armour/cloak/umhang");
  CLONEME(ARMOUR "myrmidonenschild");
  command("trage alles");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
