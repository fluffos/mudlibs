#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine schleimige, zweikoefpige Hydra");
  SetProp(P_LONG,
    "Diese Hydra ist richtig ekelhaft. Aus ihrem drachenhaften Koerper wachsen "
    "zwar nur zwei Koepfe und allgemein ist sie eher klein. Doch ihr ganzer "
    "Koerper ist mit glitschigem Schleim ueberzogen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hydra");
  SetProp(P_GENDER, FEMALE);
  AddId(({"hydra", "\nschleimhydra"}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10+random(8));

  SetProp(P_HANDS, ({" mit ihren schleimigen Koepfen",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP, DT_ACID})
                    }) );

  SetProp(P_RACE, "Hydra");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 175000);
  SetProp(P_ALIGN, -random(1000));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:     -0.2, DT_WATER:       0.1,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.1, DT_LIGHT:     0.3, DT_ELECTRIC:   -0.3,
       DT_ACID:     -0.5, DT_POISON:   -0.5, DT_TERROR:     -0.5,
       DT_HOLY:      0.1, DT_UNHOLY:   -0.2, DT_MAGIC:      -0.1,
       DT_MIND:      0.1, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1,
       DT_PIERCE:   -0.1, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.1,
       DT_RIP:      -0.1,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " kann gar nicht sprechen.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 20);

  AddSpell(3, 300,
    Name(WER, 1) + " beisst dich.\n",
    Name(WER, 1) + " beist @WEN.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));

  
  AddSpell(3, 300,
    Name(WER, 1) + " speit Saeure ueber dich.\n",
    Name(WER, 1) + " speit Saeure ueber @WEN.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
