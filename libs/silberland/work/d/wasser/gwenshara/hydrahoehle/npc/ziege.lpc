#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Bergziege");
  SetProp(P_LONG,
    "Diese zottelige Bergziege lebt hier. Sie frisst genuessliche die kahlen "
    "Aeste der Kiefern und scheint ein recht simples Leben zu bevorzugen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Bergziege");
  SetProp(P_GENDER, FEMALE);
  AddId(({"ziege", "bergziege"}));
  SetProp(P_ARTICLE, 1);
  AddClass(({CL_ANIMAL}));

//--Eigenschaften----------------------------------------------------------

  create_default_npc(13);

  SetProp(P_HANDS, ({" mit ihren Hoernern",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE, DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Ziege");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 15000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM "k_1", ROOM "j_2", ROOM, "j_3", ROOM "j_4"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "j_9");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " kann gar nicht sprechen.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
