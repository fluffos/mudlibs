#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Hydramutter");
  SetProp(P_LONG,
    "Die Hydramutter ist der Ursprung aller Hydren. Sie ist gigantisch gross "
    "und hat mindestens zwoelf Koepfe, wobei du das gar nicht so genau sagen "
    "kannst. Ihr Leib ist drachenartig und von dicken, gruenlichen Schuppen "
    "ueberzigen. Um sie herum wabert Saeuredampf. Ihre Augen funkeln dich "
    "boesartig an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hydramutter");
  SetProp(P_GENDER, FEMALE);
  AddId(({"hydra", "mutter", "hydramutter"}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(50);

  SetProp(P_HANDS, ({" mit ihren unzaehligen Koepfen",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP, DT_ACID})
                    }) );

  SetProp(P_RACE, "Hydra");
  SetProp(P_SIZE, 750);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 20);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:     -0.5, DT_WATER:       0.1,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.5,
       DT_SOUND:     0.1, DT_LIGHT:     0.3, DT_ELECTRIC:   -0.3,
       DT_ACID:     -0.8, DT_POISON:   -0.8, DT_TERROR:     -0.8,
       DT_HOLY:      0.2, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.1,
       DT_MIND:      0.0, DT_SLASH:    -0.2, DT_BLUDGEON:   -0.2,
       DT_PIERCE:   -0.2, DT_SQUEEZE:  -0.2, DT_WHIP:       -0.2,
       DT_RIP:      -0.2,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " bruellt dich nur laut an.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 40);

  AddSpell(3, 600,
    Name(WER, 1) + " beisst dich mit ihrem elften Kopf.\n",
    Name(WER, 1) + " beist @WEN mit ihrem elfen Kopf.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));


  AddSpell(3, 666,
    Name(WER, 1) + " hebt ihren ersten Kopf und speit Saeure ueber dich.\n",
    Name(WER, 1) + " hebt ihren ersten Kopf speit Saeure ueber @WEN.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 666,
    Name(WER, 1) + " hebt ihren zweiten Kopf und speit einen Flammenstrahl nach dir.\n",
    Name(WER, 1) + " hebt ihren zweiten Kopf speit einen Flammenstrahl nach @WEM.\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 666,
    Name(WER, 1) + " hebt ihren dritten Kopf und speit einen Wasserstrahl nach dir.\n",
    Name(WER, 1) + " hebt ihren dritten Kopf speit einen Wasserstrahl nach @WEM.\n",
      DT_WATER, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 666,
    Name(WER, 1) + " hebt ihren vierten Kopf und speit einen Blitz nach dir.\n",
    Name(WER, 1) + " hebt ihren vierten Kopf speit einen Blitz nach @WEM.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 666,
    Name(WER, 1) + " hebt ihren fuenften Kopf und speit einen Eisstrahl nach dir.\n",
    Name(WER, 1) + " hebt ihren fuenften Kopf speit einen Eisstrahl nach @WEM.\n",
      DT_COLD, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 500, DS_MASS_DAMAGE,
    Name(WER, 1)+ " speit eine aetzende Saeurewolke aus ihrem sechsten Kopf um sich.\n",
    Name(WER, 1)+ " speit eine aetzende Saeurewolke aus ihrem sechsten Kopf um sich.\n",
    DT_ACID);

  AddDefaultSpell(2, 300, DS_MASS_POISON,
    Name(WER, 1)+" wuergt Gift aus ihrem siebten Kopf hervor, dass ueber dich regnet.\n",
    Name(WER, 1)+" wuergt Gift aus ihrem siebten Kopf hervor, dass ueber dich regnet.\n");

  AddDefaultSpell(2, 1, DS_BLIND,
    Name(WER, 1)+" spuckt dir aus ihrem neuten Kopf Saeure ins Auge!\n",
    Name(WER, 1)+" spuckt @WEM aus ihrem neuten Kopf Saeure ins Auge!\n");

  AddDefaultSpell(2, 1, DS_PARALYZE,
    Name(WER, 1)+" blickt dich mit ihrem achten Kopf an und hypnotisiert dich!\n",
    Name(WER, 1)+" blickt @WEN mit ihrem achten Kopf an und hypnotisiert dich!\n");

  AddSpell(3, 666,
    Name(WER, 1) + " wickelt ihren zehnten Kopf um dich und zerquetscht dich.\n",
    Name(WER, 1) + " wickelt ihren zehnten Kopf um dich und zerquetscht dich.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_MASS_FEAR,
    Name(WER, 1)+" reckt ihren zwoelften Kopf nach oben und Furcht ueberkommt euch!\n",
    Name(WER, 1)+" reckt ihren zwoelften Kopf nach oben und Furcht ueberkommt euch!\n");
}

public void Attack(object enemy) {
  ModifySkillAttribute(TO, SA_SPEED, 400, 30); // vier angriffe pro runde
  ::Attack(enemy);
  return;
}

void die(int poisondeath)
{
  object blut, killer, ob;

  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  killer = QueryProp(P_KILLER || TP);
  if(objectp(killer)) {

    if(!objectp(blut=present("\nhydramutterblut"))) {
      blut = clone_object(OBJ "mutterblut");
      if(blut->move(killer, M_NOCHECK) != 1) {
        destruct(blut);
        ::die(poisondeath);
        return;
      }
    }

    blut->Activate();
    tell_object(killer, BS("Als die Hydramutter kreischend verendet regnet ihr Blut ueber dich und wirft auf "
                           "deiner Haut blasen. Ihre Kraft und ihr Schutz vor Saeure und Gift gehen auf dich ueber!"));
    tell_room(ENV(TO), BS("Als die Hydramutter kreischend verendet regnet ihr Blut ueber "+killer->name(WEN, 1)+"."), ({killer}));
  }

  domainshout(killer->Name(WER, 1)+" hat die Hydramutter bezwungen und wird als Held von Hypros gefeiert!\n", "/d/wasser/*", 1);
  if(killer->QueryProp(P_GENDER) == MALE) killer->SetProp(P_TITLE, "der Hydratoeter, Held von Hypros");
  else if(killer->QueryProp(P_GENDER) == FEMALE) killer->SetProp(P_TITLE, "die Hydratoeterin, Heldin von Hypros");
  else killer->SetProp(P_TITLE, "das Hydratoeter, Held von Hypros");

  killer = TP || QueryProp(P_KILLER);
  if(objectp(killer->QueryOwner())) killer = killer->QueryOwner();
  if(objectp(ob = present(RANGER_TASK_COURIER, killer))) {
    ob->SetTeil(4);
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
