#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Hauptplatz");
  SetProp (P_INT_LONG,
    "Du stehst nun am Hauptplatz des Dorfes. Rund um Dich erblickst Du "+
    "viele Haeuser, die schmuck und adrett nebeneinander stehen. Im "+
    "Osten fuehrt ein Weg wieder aus dem Dorf hinaus zum Pier und zum "+
    "Wald. Nach Westen fuehrt ein Pfad weiter. Im Norden steht ein "+
    "kleines Haus, an dem ein Schild befestigt ist. Auch auf dem Haus im "+
    "Sueden haengt eine Tafel. In der Mitte des Hauptplatzes ragt ein "+
    "Bildstock empor. Als Du ihn siehst, setzt sich vor Deinem geistigen "+
    "Auge ein Bild fest.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"hauptplatz", "mitte"}),
    "Am Hauptplatz steht in der Mitte auf einem kleinen Huegel ein "+
    "Bildstock. Rings um Dich sind viele Haeuser.");
  AddDetail ( ({"bildstock"}),
    "Er ist aus Stein und steht auf einem kleinen Huegel. An der Innenwand "+
    "sind Bilder befestigt. Davor steht eine Statue.");
  AddDetail ( ({"stein"}),
    "Gewoehnlicher Stein.");
  AddDetail ( ({"huegel"}),
    "Der Huegel ist aus Erde. Auf ihm steht der Bildstock.");
  AddDetail ( ({"innenwand"}),
    "An der Innenwand haengen Bilder.");
  AddDetail ( ({"bilder", "abbildungen"}),
    "Es sind Abbildungen der Goetter.");
  AddDetail ( ({"pestur", "schutzpatron", "statue"}),
    "Die Statue ist der heilige Pestur, der Schutzpatron der Fischer.");
  AddDetail ( ({"fischer"}),
    "Die Fischer leben in diesem Dorf.");
  AddDetail ( ({"ost", "osten", "weg"}),
    "Der Weg im Osten fuehrt aus dem Dorf hinaus zum Pier und zum Wald.");
  AddDetail ( ({"pier", "wald"}),
    "Der Pier und der Wald liegen weiter oestlich.");
  AddDetail ( ({"erde"}),
    "Gewoehnliche Erde, mehr nicht!");
  AddDetail ( ({"meer", "naehe"}),
    "Das Meer ist jetzt schon sehr nah. Weit und blau breitet es sich "+
    "suedlich von Dir aus.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Das Fischerdorf macht einen netten Eindruck auf Dich.");
  AddDetail ( ({"eindruck"}),
    "Die Ordnung und die Haeuser sehen sehr nett aus, sie gefallen Dir "+
    "gut.");
  AddDetail ( ({"ordnung"}),
    "Alles hier sieht sauber und gepflegt aus.");
  AddDetail ( ({"himmel", "sonne"}),
    "Am blauen Himmel ueber Dir glaenzt die goldene Sonne.");
  AddDetail ( ({"fischerhaeuser", "haeuser"}),
    "Die Haeuser stehen auf Pfaehlen. Kleine Leitern fuehren hinauf. Sie "+
    "sehen sehr ordentlich aus, was man an den Fenstern besonders gut "+
    "erkennt.");
  AddDetail ( ({"pfaehle", "pfahl"}),
    "Die Pfaehle sind ein notwendiger Schutz fuer die Bewohner der Haeuser "+
    "in der Naehe des Meeres. An den Pfaehlen siehst du gruenen Bewuchs.");
  AddDetail ( ({"bewuchs", "moos"}),
    "Es ist Moos, das nach und nach auf den Pfaehlen zu wuchern begann.");
  AddDetail ( ({"schutz"}),
    "Als Schutz vor Springfluten und Ueberschwemmungen sind die Pfaehle "+
    "gedacht.");
  AddDetail ( ({"fenster"}),
    "Du siehst in den Fenstern bunte Vorhaenge, die die Haeuser gemuetlich "+
    "erscheinen lassen. Die Menschen hier scheinen sie wohl liebevoll und "+
    "fleissig zu pflegen.");
  AddDetail ( ({"farben", "vorhaenge", "vorhang"}),
    "In jedem Fenster haengt ein Vorhang anderer Farbe.");
  AddDetail ( ({"bewohner", "fischer", "menschen", "leute"}),
    "Die Fischer sind ehrliche, fleissige Leute, die auch sehr hilfsbereit "+
    "und gastfreundlich sind.");
  AddDetail ( ({"leiter", "leitern"}),
    "Ueber diese Leitern kommt man in die Haeuser.");
  AddDetail ( ({"norden", "sueden"}),
    "Hier faellt Dir ein Haus auf.");
  AddDetail ( ({"haus", "laden", "fischersladen"}),
    "Das Haus im Norden scheint ein Fischersladen zu sein. Ueber der Tuer "+
    "ist ein Schild angebracht. Das Haus im Sueden hingegen faellt Dir "+
    "durch seinen besonders sauberen, weissen Anstrich auf. Neben der Tuer "+
    "haengt eine kleine Tafel.");
  AddDetail ( ({"anstrich", "farbe"}),
    "Der Anstrich von Kilians Haus strahlt Dich in hellem Weiss an.");
  AddDetail ( ({"weiss"}),
    "Weisser als weiss, etwa so wie ein Handelsreisender Dir letztens die "+
    "Wirkung seines Waschmittels, das er von einer fernen Reise mitgebracht "+
    "hat, anpreisen wollte.");
  AddDetail ( ({"handelsreisenden", "handelsreisender", "megakerls",
                "reise", "senil", "waschmittel",
                "wirkung"}),
    "Zum Glueck bist Du da nicht drauf reingefallen und verwendest als "+
    "Waschmittel weiterhin Senil Megakerls.");
  AddDetail ( ({"tuer"}),
    "Durch die Tuer gelangt man ins Haus.");
  AddDetail ( ({"schild"}),
    "Du kannst es lesen.");
  AddDetail ( ({"tafel"}),
    "Du kannst sie lesen.");
  AddReadDetail ( ({"schild"}),
    "Auf dem Schild steht: FISCHERLADEN");
  AddReadDetail ( ({"tafel"}),
    "Auf der Tafel steht: KILIANS HAUS");
  AddDetail ( ({"kilian", "matrose"}),
    "Kilian ist ein alter Matrose, der hier seinen Lebensabend verbringt.");
  AddDetail ( ({"lebensabend"}),
    "Kilian ist schon sehr alt und ruht sich nun aus.");
  AddDetail ( ({"auge"}),
    "Vor Deinem geistigen Auge erscheint ein Bild.");
  AddDetail ( ({"bild"}),
    "Du siehst die Fischer vor diesem Bildstock knien, um fuer eine gute "+
    "Fahrt zu bitten. Ob ihnen die Goetter wohl gnaedig sind?");
  AddDetail ( ({"goetter", "gnade"}),
    "Auf die Gnade der Goetter sind wir wohl alle angewiesen.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus festgetrampelter Erde.");
  AddDetail ( ({"pfad"}),
    "Der Pfad, der nach Westen fuehrt, teilt sich dort in zwei Wege auf.");
  AddDetail ( ({"wege"}),
    "Einer fuehrt zu einer Wiese, ein anderer zum Meer.");
  AddDetail ( ({"wiese"}),
    "Du musst schon selber hingehen, wenn Du mehr davon sehen willst.");
  AddDetail ( ({"fahrt"}),
    "Die Fahrt aufs Meer natuerlich.");
  AddDetail ( ({"glueck"}),
      ([ 0: "Glueck muss man haben!\n",
         "mensch": "Glueck muss der Mensch haben!\n",
         "zwerg": "Glueck muss der Zwerg haben!\n",
         "hobbit": "Glueck muss der Hobbit haben!\n",
         "elf": "Glueck muss der Elf haben!\n" ]) );
  AddDetail ( ({"springfluten", "ueberschwemmungen"}),
    "Davon gibt es hier in Meeresnaehe genug, weshalb die Bewohner des "+
    "Dorfes ihre Haeuser mit Pfaehlen davor schuetzen.");
  AddDetail ( ({"meeresnaehe"}),
    "Wenn Du nur weit genug nach Sueden gehst, platscht Du mitten rein.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", ROOM("hauptstr_o"));
  AddExit ("westen", ROOM("hauptstr_w"));
  AddExit ("norden", ROOM("laden"));
  AddExit ("sueden", ROOM("kilianhaus"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"bete"}), "bete");
}

int bete (string str)
{
  write ("Du kniest kurz vor der Statue nieder "
      "und haeltst eine kurze Andacht.\n");
  say (CAP_TPN+" kniet vor der Statue nieder "
      "und haelt eine kurze Andacht.\n");
  return 1;
}
