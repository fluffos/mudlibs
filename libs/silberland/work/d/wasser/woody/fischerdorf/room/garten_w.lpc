#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

#define ANZ_BEEREN 3
int beeren;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Du befindest Dich jetzt im westlichen Teil des Gartens. Hier wachsen "+
    "einige Straeucher. Weiter im Sueden wachsen noch mehr Buesche. Im "+
    "Norden und Osten siehst du jede Menge Baeume.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "gras"}),
    "Gruen schimmert das Gras unter Dir.");
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"nord", "norden", "ost", 
                "osten"}),
    "Im Norden und Osten siehst Du weit entfernt einige Buesche und "+
    "Baeume.");
  AddDetail ( ({"baeume", "buesche"}),
    "Um mehr zu erkennen, musst Du naeher hingehen.");
  AddDetail ( ({"menge"}),
    "Wenn Du willst, kannst Du ja die Baeume zaehlen! Aber was soll das "+
    "schon?");
  AddDetail ( ({"sued", "sueden"}),
    "Im Sueden wachsen einige Buesche.");
  AddDetail ( ({"straeucher"}),
    "Auf diesen Straeuchern haengen viele Beeren.");
  AddDetail ( ({"beeren", "hinsehen"}),
    "Beim genaueren Hinsehen erkennst Du, dass es Himbeeren sind.");
  AddDetail ( ({"himbeeren"}),
    "Himmlisch rote Himmel- aeh, Himbeeren....\n"+
    "Rot und saftig, Dir laeuft das Wasser im Munde zusammen!\n");
  AddDetail ( ({"mund", "wasser"}),
    "Das ist doch nur eine Redewendung.");
  AddDetail ( ({"redewendung"}),
    "So nennt man die Entfremdung eines Wortes durch missbraeuchliche "+
    "Verwendung. Naja, trifft vielleicht nicht immer zu. Aber immer oefter.");
  AddDetail ( ({"entfremdung", "verwendung", "wort"}),
    "Ich bin nur ein Garten, ich weiss das nicht.");
  AddDetail ( ({"garten", "teil", "ende"}),
    "Du wanderst den Garten am westlichen Ende entlang.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("garten_sw"));
  AddExit ("suedosten", ROOM("garten_s"));
  AddExit ("osten", ROOM("garten_zentrum"));
  AddExit ("norden", ROOM("garten_nw"));
  AddExit ("nordosten", ROOM("garten_n"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"pfluecke", "pflueck"}), "pfluecke");
  AddCmd ( ({"iss"}), "iss");
  beeren=ANZ_BEEREN;
}

void reset()
{
  ::reset();
  beeren=ANZ_BEEREN;
}

int pfluecke (string str)
{
  object ob;
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  notify_fail ("So etwas kannst Du hier nicht pfluecken!\n");
  if (str!="himbeeren" && str!="himbeere") return 0;
  if (beeren) {
    write("Du pflueckst Dir eine leuchtend rote Himbeere von dem Strauch.\n");
    say (CAP_TPN+" pflueckt eine leuchtend rote Himbeere.\n");
    CLONETP(OBJ("himbeere"), ob);
    beeren--;
  } else
    write(bs("Leider hat das schon jemand vor Dir gemacht, Du siehst "
        "nur noch einen leeren Strauch, als Du genauer hinblickst..."));
  return 1;
}

int iss (string str)
{
  notify_fail("Was willst Du essen?\n");
  if (!str) return 0;
  notify_fail("Das kannst Du hier nicht essen.\n");
  if (str!="himbeere" && str!="himbeeren") return 0;
  notify_fail("Du solltest die Himbeeren vorher pfluecken.\n");
  return 0;
}
