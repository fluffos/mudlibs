#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

#define MAXW 5000

inherit "std/room";
mapping darf;
int marillen;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_KILL_NAME, "Ein Sturz vom Baum");
  SetProp (P_INT_SHORT, "Auf einem Marillenbaum");
  SetProp (P_INT_LONG,
    "Du stehst auf den duennen, bruechigen Aesten des Marillenbaums und "+
    "blickst auf den Garten und die Leiter unter Dir, ueber die Du hier "+
    "hochgekommen bist, hinab. An einigen Zweigen haengen noch ein paar "+
    "Marillen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"aeste", "ast"}),
    "Der Ast, auf dem Du stehst, scheint nicht viel Gewicht tragen zu "+
    "koennen.");
  AddDetail ( ({"gewicht"}),
    "Du solltest nicht allzuviel bei Dir haben, wenn Du laenger hier "+
    "verweilen willst.");
  AddDetail ( ({"garten", "osten", "sueden"}),
    "Der Garten unter Dir erstreckt sich nach Osten und Sueden hin.");
  AddDetail ( ({"baum", "marillenbaum"}),
    "Du stehst auf einigen seiner Aeste.");
  AddDetail ( ({"leiter"}),
    "Ueber die Leiter, die unter Dir am Baum lehnt, bist Du hier "+
    "hochgekommen.");
  AddDetail ( ({"zweig", "zweige"}),
    "An einigen Zweigen haengen noch ein paar Marillen. Du koenntest "+
    "versuchen, sie pfluecken.");
  AddSpecialDetail ( ({"marille", "marillen"}),
    "d_marille");
  AddDetail ( ({"marille", "marillen"}),
    "Rund um Dich haengen sie ueberall.");
  AddDetail ( ({"himmel","sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"boden"}),
    "Der Boden ist tief unter Dir. Pass bloss auf, dass Du nicht "+
    "runterfaellst!");
  // DETAILS END

  // EXITS START
  AddExit ("unten", ROOM("marillenbaum_u"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"pfluecke", "pflueck"}), "pfluecke");

  darf=([]);
  marillen=2+random(2);

}

int nichtda(object ob)
{
  if (!ob) return 1;
  return ENV(ob) != ME;
}

reset()
{
  mapping f;
  ::reset();
  if (!marillen) {
    tell_room(ME, "Du hoerst die Marillen wachsen.\n");
    marillen=2+random(2);
  }
  if (sizeof(f=filter_mapping(darf,"nichtda")))
    darf -= f;
}

void init()
{
  object *anw;

  ::init();
  darf -= ([ TP ]);
  anw=all_inventory(ME);
  anw=filter_array(anw, #'interactive);
  if (interactive(TP))
  {
    if (sizeof(anw) > 1)
      call_out("runter", 0);
    else if (!IS_WIZARD(TP) &&
        (TP->QueryProp(P_TOTAL_WEIGHT)-TP->QueryProp(P_WEIGHT) >= MAXW))
      call_out("flieg", 1);
    else
      call_out("ok", 2+random(3));
  }
}

runter()
{
  if (TPENV!=ME) return;
  write("Du merkst, dass schon jemand auf dem Baum stehst, sodass "
      "fuer Dich leider\nkein Platz mehr ist. Du kehrst daher um.\n");
  TP->move(ROOM("marillenbaum_u"), M_GO,
      "runter", "klettert", "kommt heruntergeklettert");
}

flieg()
{
  if (TPENV!=ME) return;
  write(bs("Oweh... Du merkst, dass Du wohl mitsamt Deiner Ausruestung "
      "zu schwer fuer den Baum bist... Der Ast, auf dem Du Halt gefunden "
      "hast, bricht, Du faellst..."));
  TP->move(ROOM("marillenbaum_u"), M_GO,
      "vom Baum", "faellt", "faellt vom Baum");
  TP->do_damage(20+random(20), ME);
}

ok()
{
  if (TPENV!=ME) return;
  write ("Der Ast scheint Dich zu halten.\n");
  darf += ([ TP ]);
}

int pfluecke (string str)
{
  object ob;
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  if (!member( ([ "marille", "marillen", "frucht", "fruechte" ]), str ))
    return 0;
  if (!member(darf, TP))
    write (bs("Lass Dir doch erst einmal etwas Zeit, bis Du Dir sicher "
        "bist, dass Dich der Ast haelt!"));
  else if (!marillen || random(3))
    write (bs("Du pflueckst eine Marille, stellst aber fest, dass sie "
        "verfault ist, und wirfst sie wieder weg.\n"));
  else {
    write ("Du pflueckst eine saftige Marille.\n");
    say (CAP_TPN+" pflueckt eine saftige Marille.\n");
    CLONETP(OBJ("marille"), ob);
    marillen--;
  }
  return 1;
}
