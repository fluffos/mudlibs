#include <properties.h>
#include <moving.h>
#include "files.h"
#include "../../hausquest.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

int blumen;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Wiese");
  SetProp (P_INT_LONG,
    "Du stehst mitten im satten Gruen der Wiese. Rund um Dich hunderte "+
    "von Pflanzen und kleinen Tieren. Es ist wunderschoen hier. Du "+
    "fuehlst Dich sehr wohl. Im Norden siehst Du ein kleines Tor und "+
    "viele Baeume und Straeucher.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"gruen"}),
    "Ein schoeneres, intensiveres Gruen kannst Du Dir nicht vorstellen.");
  AddDetail ( ({"weg"}),
    "Der Weg ist kaum erkennbar. Nur die zerdrueckten Pflanzen lassen "+
    "darauf schliessen.");
  AddDetail ( ({"boden"}),
    "Der Boden ist uebersaet mit Pflanzen, Tieren und Gruen.");
  AddDetail ( ({"himmel"}),
    "Am blauen Himmel steht hoch ueber Dir die Sonne. Auch einige Voegel "+
    "siehst Du vergnuegt herumfliegen.");
  AddDetail ( ({"sonne"}),
    "Die Sonne taucht die Wiese in einen strahlenden Glanz.");
  AddDetail ( ({"glanz"}),
    "Naja, sie glaenzt eigentlich nicht wirklich, sie strahlt vielmehr.");
  AddDetail ( ({"voegel"}),
    "Die Voegel sind nah der Wiese, weil sie hier genug Nahrung finden.");
  AddDetail ( ({"nahrung"}),
    "Die Voegel fressen die kleinen Tiere, derer es hier viele gibt.");
  AddDetail ( ({"wiese"}),
    "Du stehst mitten drin.");
  AddDetail ( ({"pflanzen"}),
    "Du siehst Gras und viele verschiedene Blumen.");
  AddDetail ( ({"gras"}),
    "Ganz gewoehnliches, gruenes Gras.");
  AddDetail ( ({"blume", "blumen"}),
    "Du siehst Gaensebluemchen, roten und weissen Klee, Hahnenfuss, "+
    "Loewenzahn und Margeriten. Du koenntest einen schoenen Strauss "+
    "zusammenstellen.");
  AddDetail ( ({"blumenstrauss", "strauss"}),
    "Ein Strauss Blumen bereitet jedem Freude. Er macht sich auch gut in "+
    "einer Vase im Haus.");
  AddDetail ( ({"freude"}),
    "Bereite Dir doch eine Freude!");
  AddDetail ( ({"tiere", "tierchen"}),
    "Viele kleine Tiere krabbeln hier herum. Ameisen, Regenwuermer, Kaefer "+
    "und igitt... auch Spinnen. Du siehst auch Schmetterlinge und Bienen "+
    "herumflattern. Die Bienen fliegen emsig von Bluete zu Bluete.");
  AddDetail ( ({"ameisen", "bienen", "kaefer", 
                "regenwuermer", "schmetterlinge", "spinnen"}),
    "All die kleinen Tierchen fuehlen sich in der Wiese sehr wohl.");
  AddDetail ( ({"bestandteile", "blaetter", "bluete", 
                "bluetenblaetter", "bluetenkopf", "stengel"}),
    "Eine Blume hat viele Bestandteile: eine Bluete mit Bluetenblaettern "+
    "und all das auf einem Stengel, und viele Blaetter.");
  AddDetail ( ({"haus", "naehe"}),
    "Du siehst hier in der Naehe kein Haus.");
  AddDetail ( ({"vase"}),
    "Einen Strauss stellt man am besten in eine Vase.");
  AddDetail ( ({"gaensebluemchen"}),
    "Auf einem gruenen Stengel sitzt ein bunter Bluetenkopf. In der Mitte "+
    "gelb, dann weisse Bluetenblaetter, die aussen zartrosa verfaerbt sind.");
  AddDetail ( ({"klee"}),
    "Sowohl roter als auch weisser Klee waechst auf der Wiese. Da die "+
    "Stengel aber zu kurz sind, eignet sich der Klee wohl kaum fuer einen "+
    "Strauss.");
  AddDetail ( ({"hahnenfuss"}),
    "Eine schoene Pflanze. An dem langen, gruenen Stengel sitzen "+
    "zahlreiche kleine, gelbe Blueten.");
  AddDetail ( ({"loewenzahn"}),
    "Der Loewenzahn ist hier am meisten vertreten. Man sieht neben dem "+
    "intensiven Gruen der Graeser und der Loewenzahnblaetter auch sehr viel "+
    "Gelb der Loewenzahnblueten. Unkraut vermehrt sich nunmal am "+
    "schnellsten.");
  AddDetail ( ({"unkraut"}),
    "...vergeht nicht!");
  AddDetail ( ({"margeriten"}),
    "Margeriten wuerden auch gut zu einem Strauss passen mit ihrem langen "+
    "Stengel und dem wunderschoenen, grossen, weissen Bluetenkopf.");
  AddDetail ( ({"gartentor", "tor"}),
    "Das Tor im Norden fuehrt in einen Garten, in dem viele Baeume und "+
    "Straeucher stehen.");
  AddDetail ( ({"baeume", "garten", "straeucher"}),
    "Von hier kannst Du leider nicht viel erkennen. Geh doch naeher ran.");
  AddDetail ( ({"graeser", "kuriositaet"}),
    "Eine grammatikalische Kuriositaet: Das Gras besteht aus Graesern...");
  AddDetail ( ({"loewenzahnblaetter", "loewenzahnblueten"}),
    "Sie bilden die vielen gelben Flecken inmitten des weiten Gruens der "+
    "Wiese.");
  AddDetail ( ({"gelb"}),
    "Das Gelb strahlt fast so hell wie die Sonne.");
  AddDetail ( ({"flecken"}),
    "Die gelben Flecken im Gruen der Wiese werden durch Loewenzahn "+
    "gebildet.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht alles irgendwie so frisch hier.");
  AddSmell ( ({"blume", "blumen", "duft"}),
    "Du saugst den herrlichen Duft der Blumen ein - Aaaaaaaaah!");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("wiesenweg"));
  AddExit ("norden", ROOM("garten_sw"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"pfluecke", "pflueck"}), "pfluecke");
  blumen=3;
}

reset()
{
  ::reset();
  if (!blumen) tell_room(ME, "Du hoerst das Gras wachsen.\n");
  blumen=3;
}

int pfluecke (string str)
{
  object qo,ob;
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  notify_fail ("Das kannst Du nicht pfluecken!\n");
  if (str!="blume" && str!="blumen" &&
      str!="blumenstrauss" && str!="strauss") return 0;
  else if (present(BLUMEN_ID,TP))
    write ("Aber Du hast doch schon einen Blumenstrauss!\n");
  else if ((qo=present(QO_ID,TP)) && qo->TestFlag(F_FINDET_BLUMEN)) {
    ob=CLONEOB(QDIR("blumenstrauss"));
    ob->move(TP, M_NOCHECK);
    ob->SetOwner(TP);
    qo->ClearFlag(F_FINDET_BLUMEN);
    write ("Du pflueckst ein paar Blumen und stellst Dir einen "
        "schoenen Strauss zusammen.\n");
    say (CAP_TPN+" pflueckt ein paar Blumen und stellt einen schoenen "
        "Strauss zusammen.\n");
  }
  else if (!blumen)
    write ("Im Moment kannst Du hier nichts mehr pfluecken.\n");
  else {
    write ("Du pflueckst eine der vielen Blumen.\n");
    say (CAP_TPN+" pflueckt eine Blume.\n");
    CLONETP(OBJ("blume"), ob);
    blumen--;
  }
  return 1;
}
