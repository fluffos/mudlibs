#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "Auf einem Landweg");
  SetProp (P_INT_LONG,
    "Du stehst auf einem breiten Landweg. Im Osten liegt eine Bruecke, "+
    "die ueber einen rauschenden Fluss weiter zu einem Waldweg fuehrt. "+
    "Weiter suedlich breitet sich das blaue Meer aus, in das ein Pier "+
    "hineinreicht. Am Ufer des Meeres erblickst Du ein kleines Dorf.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"landweg", "weg"}),
    "Der aus festgetrampelter Erde bestehende Weg fuehrt Dich von der "+
    "Bruecke hinunter zum Dorf und zum Pier. Ob hier wohl schon viele "+
    "Wanderer entlang gekommen sind...?");
  AddDetail ( ({"waldweg"}),
    "Der beginnt jenseits der Bruecke.");
  AddDetail ( ({"erde"}),
    "Ganz gewoehnliche, festgetrampelte Erde, nichts Besonderes, oder was "+
    "hast Du denn erwartet?");
  AddDetail ( ({"wanderer"}),
    "Du bist einer. Viele scheinen schon vor Dir hier entlang gegangen zu "+
    "sein.");
  AddDetail ( ({"boden"}),
    "Am Boden unter Deinen Fuessen siehst Du einen Weg, der links und "+
    "rechts von etwas Gras eingesaeumt ist.");
  AddDetail ( ({"fuesse"}),
    "Solltest Du Dir dringend mal wieder waschen!");
  AddDetail ( ({"gras"}),
    "Das gruene Gras saeumt den ockerfarbenen Weg ein. Ein schoenes Bild!");
  AddDetail ( ({"bild"}),
    "Wenn Du Pinsel und Farbe dabei haettest, wuerdest Du diesen Anblick "+
    "festhalten.");
  AddDetail ( ({"farbe", "pinsel"}),
    "Leider hast Du Pinsel und Farbe nicht dabei.");
  AddDetail ( ({"anblick"}),
    "Ein brauner Faden durch gruene Landschaft bis hinunter zum Meer.");
  AddDetail ( ({"faden"}),
    "Gemeint ist hier natuerlich der Weg. Nichts uebrig fuer poetischen "+
    "Ueberschwang?");
  AddDetail ( ({"ueberschwang"}),
    "Fuer poetischen Ueberschwang hast Du wohl nichts uebrig... schade! "+
    ":-(");
  AddDetail ( ({"landschaft"}),
    "Sie umgibt Dich, wo Du auch hingehst.");
  AddDetail ( ({"bruecke", "holzbruecke"}),
    "Diese Bruecke bringt Dich einerseits zurueck in den Wald, "+
    "andererseits runter zum Meer. Wenn Du nach Osten gehst, stehst Du auf "+
    "ihr.");
  AddDetail ( ({"osten"}),
    "Im Osten liegt die Holzbruecke.");
  AddDetail ( ({"holz"}),
    "Die Bruecke besteht aus gewoehnlichem Holz.");
  AddDetail ( ({"meer"}),
    "Weit und blau breitet es sich in der Ferne aus.");
  AddDetail ( ({"ferne"}),
    "\"Wozu in die Ferne schweifen, sieh, das Gute liegt so nah!\" - Das "+
    "ist hier wohl nicht angebracht, wenn die Ferne das Meer bietet.");
  AddDetail ( ({"gute"}),
    "Es sollte nah liegen, doch hier findest Du es nicht! Suche ruhig "+
    "weiter!");
  AddDetail ( ({"pier"}),
    "Der Pier liegt im Sueden und reicht weit ins Meer hinein.");
  AddDetail ( ({"sueden"}),
    "Im Sueden siehst Du einerseits den Pier und andererseits das kleine "+
    "Dorf.");
  AddDetail ( ({"ufer"}),
    "Am Ufer des Meeres siehst Du ein kleines Dorf.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Es handelt sich um ein kleines Fischerdorf, das am Ufer des Meeres "+
    "liegt. Um es besser zu erforschen, musst Du naeher rangehen und dem "+
    "Weg nach Sueden folgen.");
  AddDetail ( ({"wald"}),
    "Um in den Wald zu gelangen, musst Du die Bruecke im Osten ueberqueren.");
  AddDetail ( ({"himmel"}),
    "Ueber Dir strahlend blauer Himmel.");
  AddDetail ( ({"sonne"}),
    "Die Sonne strahlt Dich an wie in ihren besten Tagen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst nur das Rauschen des Flusses im Osten.");
  AddSound ( ({"rauschen"}),
    "Es klingt wie das Radio nach Sendeschluss.");
  AddSound ( ({"sendeschluss"}),
    "Es rauscht.");
  AddSound ( ({"radio"}),
    "In dieser Welt wurde das noch nicht erfunden.");
  AddSound ( ({"welt"}),
    "Der ganzen Welt lauschen? Das waere doch reinste Sinnueberflutung!");
  AddSound ( ({"sinnueberflutung"}),
    "Was Du fuer Sachen hoerst... seltsam.");
  AddSound ( ({"sachen"}),
    "Du lauscht gaaaaaaaanz angestrengt - hoerst aber nur das Rauschen.");
  AddSound ( ({"fluss"}),
    "Du vernimmst vor allem sein Rauschen.");
  AddDetail ( ({"fluss"}),
    "Der Fluss ist bereits recht stattlich. Rauschend stuerzt er sich dem "+
    "Meer im Sueden entgegen.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", ROOM("bruecke"));
  AddExit ("suedwesten", ROOM("weg2"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
