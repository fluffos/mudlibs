#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  
  //Properties:
  SetProp(P_INT_SHORT, "Ein enger Tunnel");
  SetProp(P_INT_LONG, 
    "Du befindest Dich noch immer im engen Tunnel. Licht stroemt auf "
    "magische Art und Weise aus den Waenden und laesst den gesamten Tunnel "
    "in einem blaeulichen Licht erstrahlen. Direkt ueber Dir befindet sich "
    "der Stein, den Du einfach wegdruecken kannst, sobald Du hier rauswillst. "
    "Nach unten kannst Du gar nicht schauen, da Du mit deinem Koerper den "
    "gesamten Tunnel ausfuellst. Scheinbar rutscht Du genau aus diesem "
    "Grund nicht nach unten. An der Wand kannst Du ein Loch erkennen.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );
  
  //Details:
  AddDetail("tunnel",
    "In dem befindest Du Dich doch gerade!");
  AddDetail("licht",
    "Das Licht scheint magisch zu sein, denn es kommt einfach aus Waenden.");
  AddDetail("boden",
    "Der Blick dorthin ist leider nicht frei!"),
  AddDetail("decke",
    "Ueber Dir befindet sich ein Stein, keine Decke."),
  AddDetail(({"waende", "waenden"}),
    "Aus den Waenden erstrahlt ein blaeuliches Licht. Eine Wand faellt Dir "
    "besonders auf."),
  AddDetail("wand",
    "Die Wand faellt Dir auf, denn in ihr befindet sich ein Loch.");
  AddDetail("loch",
    "Das Loch liegt im Norden. Geh also einfach nach Norden.");
  AddDetail("stein",
    "Du brauchst den Stein nur wegzudruecken, um hier rauszukommen.");
  AddDetail("koerper",
    "Dein Koerper fuellt den gesamten Tunnel aus, so dass du nicht nach unten "
    "sehen, aber auch nicht rutschen kannst.");
  AddDetail(({"art", "weise"}),
    "Das Licht erstrahlt den gesamten Tunnel.");  
  AddDetail("norden",
    "Du weisst nicht, was sich hinter dem Loch verbirgt - geh einfach nach "
    "Norden!");

  //Smells:  
  AddSmell(DEFAULT_SMELL,
    "Es riecht hier etwas modrig, sonst faellt Dir nichts auf.");

  //Sounds:  
  AddSound(DEFAULT_SOUND,
    "Es ist kaum ein Ton wahrzunehmen. Ganz leise hoert man jedoch "
    "das Wasser.");
  AddSound("ton",
    "Kaum einer ist wahrzunehmen!");
  AddSound("wasser",
    "Ganz entfernt kann man sogar hier noch das Wasser hoeren.");

  AddCmd("drueck|druecke&stein&weg", "cmd_raus",
         "Willst Du den Stein wegdruecken?|WEG druecken!");

  AddExit ("norden", ([ EX_FUNC: "ex_norden" ]) );
}


int cmd_raus(string str)
{
  write(BS(
    "Du drueckst den Stein mit aller Kraft weg und kletterst nach oben. "));
  TP->move("/d/wasser/woody/fischerdorf/room/strandweg2", M_NOCHECK);
  return 1;
}

int ex_norden(string str)
{
  write(BS(
    "Du willst nach Norden gehen, steckst aber leider fest. So "
    "interessant ist es aber wohl doch nicht, Du willst lieber hier raus!"));
  return 1;
}
