#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

#define ANZ_BEEREN 5
int beeren;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_KILL_NAME, "Eine spitze Erfahrung");
  SetProp (P_INT_LONG,
    "Du befindest Dich im Sueden des weiten, grossen Gartens. Hier "+
    "wachsen einige Straeucher. Im Norden siehst Du einige Baeume. Im "+
    "Osten siehst Du auch einige Buesche. Im Suedwesten erkennst Du die "+
    "Wiese, ueber die Du hierher gelangt bist.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "gras"}),
    "Gruen schimmert das Gras unter Dir.");
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"nord", "norden"}),
    "Im Norden siehst Du weit entfernt einige Baeume.");
  AddDetail ( ({"baeume", "buesche"}),
    "Um mehr zu erkennen, musst Du naeher hingehen.");
  AddDetail ( ({"ost", "osten"}),
    "Im Osten sind auch einige Buesche.");
  AddDetail ( ({"suedwesten", "wiese"}),
    "Im Suedwesten siehst Du noch die gruene Wiese.");
  AddDetail ( ({"straeucher", "strauch"}),
    "An den Straeuchern sind lange Stacheln und einige Beeren.");
  AddDetail ( ({"stacheln"}),
    "Du solltest aufpassen, sie sehen spitz aus.");
  AddDetail ( ({"beeren"}),
    "Beeren und Stacheln ergibt Stachelbeeren.");
  AddDetail ( ({"stachelbeeren"}),
    "Richtig erraten! Jetzt erkennst Du die blassgruenen Stachelbeeren "+
    "wieder. Du erinnerst Dich auch an ihren koestlichen Geschmack.");
  AddDetail ( ({"geschmack"}),
    "Oh ja, Stachelbeeren schmecken koestlichst.");
  AddDetail ( ({"garten", "sueden"}),
    "Hier bist Du im Sueden des auch sonst ueberall sonnigen Gartens.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("garten_sw"));
  AddExit ("osten", ROOM("garten_so"));
  AddExit ("nordwesten", ROOM("garten_w"));
  AddExit ("norden", ROOM("garten_zentrum"));
  AddExit ("nordosten", ROOM("garten_o"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"pfluecke", "pflueck"}), "pfluecke");
  beeren=ANZ_BEEREN;
}

void reset()
{
  ::reset();
  beeren=ANZ_BEEREN;
}

int pfluecke (string str)
{
  object ob;
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  notify_fail ("So etwas kannst Du hier nicht pfluecken!\n");
  if (str!="stachelbeeren" && str!="stachelbeere") return 0;
  if (!random(4)) {
    write(bs("Beim Versuch, eine Stachelbeere zu pfluecken, stichst Du "
        "Dich ungeschickterweise am Finger - AUTSCH!!! Das tat weh!!"));
    say(CAP_TPN+" sticht sich an den Straeuchern.\n");
    TP->do_damage(2+random(2));
  }
  else if (beeren) {
    write("Du pflueckst Dir eine leckere Stachelbeere von dem Strauch.\n");
    say (CAP_TPN+" pflueckt eine leckere Stachelbeere.\n");
    CLONETP(OBJ("stachelbeere"), ob);
    beeren--;
  } else
    write(bs("Leider hat das schon jemand vor Dir gemacht, Du siehst "
        "nur noch einen leeren Strauch, als Du genauer hinblickst..."));
  return 1;
}
