#include <properties.h>
#include <moving.h>
#include "files.h"
#include "../../hausquest.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Hauptstrasse, oestliches Ende");
  SetProp (P_INT_LONG,
    "Du stehst am oestlichen Ende der Hauptstrasse des Dorfes. Im "+
    "Suedosten siehst Du den Weg, der zum Pier und zum Wald fuehrt. Im "+
    "Westen siehst Du den Hauptplatz. Rundum erblickst Du viele Haeuser, "+
    "deren Bauweise und Aussehen Dir neu sind. In einer langen Gasse im "+
    "Nordosten faellt Dir ein Haus auf.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"ende", "hauptstrasse"}),
    "Du stehst am oestlichen Ende der Hauptstrasse, die wohl jedes Dorf "+
    "hat.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Das Fischerdorf macht einen netten Eindruck auf Dich.");
  AddDetail ( ({"eindruck"}),
    "Die Ordnung und die Haeuser sehen sehr nett aus, sie gefallen Dir "+
    "gut.");
  AddDetail ( ({"boden", "weg"}),
    "Der Weg besteht aus festgetrampelter Erde und fuehrt nach Osten zum "+
    "Pier und zum Wald.");
  AddDetail ( ({"pier", "wald"}),
    "Der Pier und der Wald liegen weiter oestlich.");
  AddDetail ( ({"erde"}),
    "Was soll man schon ueber Erde viel erzaehlen?");
  AddDetail ( ({"hauptplatz", "westen", "platz"}),
    "Im Westen liegt der Hauptplatz, wo auch ein Bildstock emporragt.");
  AddDetail ( ({"bildstock"}),
    "Der Bildstock steht am Hauptplatz, um mehr zu erkennen, musst Du "+
    "schon hingehen.");
  AddDetail ( ({"gasse", "nordosten"}),
    "Nach Nordosten fuehrt eine lange Gasse, in der Dir ein Haus besonders "+
    "auffaellt.");
  AddSpecialDetail ( ({"haus"}), "d_haus");
  AddDetail ( ({"aussehen"}),
    "Die Haeuser vermitteln einen netten Eindruck. Ob das nur ist, weil "+
    "sie so ordentlich sind, oder weil sie so einfach sind, oder ob beides "+
    "zutrifft, das kannst Du nicht beurteilen!");
  AddDetail ( ({"himmel", "sonne"}),
    "Am blauen Himmel ueber Dir glaenzt die goldene Sonne.");
  AddDetail ( ({"bauweise", "haeuser"}),
    "Die Haeuser stehen auf Pfaehlen. Kleine Leitern fuehren hinauf. Sie "+
    "sehen sehr ordentlich aus, was man an den Fenstern besonders gut "+
    "erkennt.");
  AddDetail ( ({"pfaehle", "pfahl"}),
    "Die Pfaehle sind ein notwendiger Schutz fuer die Bewohner der Haeuser "+
    "in der Naehe des Meeres. An den Pfaehlen siehst du gruenen Bewuchs.");
  AddDetail ( ({"meer", "naehe"}),
    "Das Meer ist jetzt schon sehr nah. Weit und blau breitet es sich "+
    "suedlich von Dir aus.");
  AddDetail ( ({"bewuchs", "moos"}),
    "Es ist Moos, das nach und nach auf den Pfaehlen zu wuchern begann.");
  AddDetail ( ({"schutz"}),
    "Als Schutz vor Springfluten und Ueberschwemmungen sind die Pfaehle "+
    "gedacht.");
  AddDetail ( ({"fenster"}),
    "Du siehst in den Fenstern bunte Vorhaenge, die die Haeuser gemuetlich "+
    "erscheinen lassen. Die Menschen hier scheinen sie wohl liebevoll und "+
    "fleissig zu pflegen.");
  AddDetail ( ({"farbe", "farben", "vorhaenge", "vorhang"}),
    "In jedem Fenster haengt ein Vorhang anderer Farbe.");
  AddDetail ( ({"bewohner", "fischer", "leute", 
                "menschen"}),
    "Die Fischer sind ehrliche, fleissige Leute, die auch sehr hilfsbereit "+
    "und gastfreundlich sind.");
  AddDetail ( ({"ordnung"}),
    "Im Gegensatz zu Dir nimmt es bei dem Haus im Nordosten wohl jemand "+
    "nicht so ganz genau mit dieser...");
  AddDetail ( ({"gegensatz"}),
    "Schau doch einfach mal hin!");
  AddDetail ( ({"leiter", "leitern"}),
    "Ueber diese Leitern kommt man in die Haeuser.");
  AddDetail ( ({"springfluten", "ueberschwemmungen"}),
    "Davon gibt es hier in Meeresnaehe genug, weshalb die Bewohner des "+
    "Dorfes ihre Haeuser mit Pfaehlen davor schuetzen.");
  AddDetail ( ({"meeresnaehe"}),
    "Wenn Du nur weit genug nach Sueden gehst, platscht Du mitten rein.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("hauptplatz"));
  AddExit ("suedosten", ROOM("weg6"));
  AddSpecialExit ("nordosten", "nordosten");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

nordosten()
{
  if (!query_once_interactive(TP) || TP->QueryQuest(HAUSQUEST))
    return TP->move(QDIR("vhausu"), M_GO, "nach Nordosten");
  else
    return TP->move(QDIR("vhausu:"+getuid(TP)), M_GO, "nach Nordosten");
}

string d_haus()
{
  if (TP->QueryQuest(HAUSQUEST))
    return break_string(
      "Du kannst Dich noch gut an dieses Haus erinnern - dass es so gut "
      "erhalten wirkt, ist schliesslich Deiner tatkraeftigen Hilfe zu "
      "verdanken!", 78);
  else
    return break_string(
      "Dieses Haus faellt Dir besonders auf, weil es sich von den anderen "
      "deutlich unterscheidet. Hier scheint es jemand mit der Ordnung nicht "
      "so genau zu nehmen. Vielleicht solltest Du Dir das Haus naeher "
      "ansehen?", 78);
}
