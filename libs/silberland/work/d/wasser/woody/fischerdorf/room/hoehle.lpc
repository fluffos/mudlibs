#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

#define GNADENFRIST 20  // Sekunden


inherit "std/room";

mapping kenntbeutel = ([ ]);
int gnade = 0;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:22]));
  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG,
    "Du stehst in einer kleinen Hoehle. Der Boden ist etwas nass. "+
    "Vereinzelt siehst Du kleinere Gegenstaende am Boden liegen. In der "+
    "Hoehle ist es angenehm kuehl. Einige groessere Felsbrocken sind auch "+
    "zu sehen. Sie laden Dich zu einer kleinen Rast in der angenehmen "+
    "Kuehle ein. Nach Osten geht es wieder hinaus an den Strand.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({"hoehle"}),
    "Du fragst Dich, wie diese Hoehle wohl entstanden sei?");
  AddDetail( ({"boden"}),
    "Der Boden ist nass und glitschig. Es ist Vorsicht geraten.");
  AddDetail( ({"vorsicht"}),
    "Du solltest nicht nur darauf achten, nicht hinzufallen, sondern auch "+
    "auf den Wasserstand.");
  AddDetail( ({"wasser", "wasserstand"}),
    "Wenn die Flut kommt, steht die kleine Hoehle unter Wasser.");
  AddDetail( ({"ebbe", "flut", "gezeiten"}),
    "Ebbe und Flut sind die Gezeiten.");
  AddDetail( ({"gegenstaende", "muscheln", "schnecken", 
                "seetang", "tang"}),
    "Die Gegenstaende, die am Boden liegen, laesst die Flut immer wieder "+
    "zurueck. Muscheln, Seetang, kleinere Schnecken. Nichts Wertvolles!");
  AddDetail( ({"wand","waende"}),
    "Die Waende bestehen aus Fels.");
  AddDetail( ({"felsbrocken", "fels", "brocken"}),
    "Vielleicht solltest Du Dich ein klein wenig hinsetzen und Dir Ruhe "+
    "goennen!");
  AddDetail( ({"rast", "ruhe"}),
    "Ohja, Ruhe und Rast koennen nie schaden.");
  AddDetail( ({"ost", "osten", "strand"}),
    "Nach Osten geht es wieder hinaus an den Strand.");
  AddDetail( ({"waende"}),
    "Auch die Waende sind feucht.");
  AddDetail( ({"feuchtigkeit"}),
    "Pass bloss auf, dass Du nicht ausrutscht!");
  AddDetail( ({"decke"}),
    "Schwarz erscheint sie ueber Dir.");
  AddDetail( ({"meer","naehe"}),
    "Das Meer ist ganz in Deiner Naehe!");
  AddSmell( ({ DEFAULT_SMELL, "luft", "meerluft" }),
    "Du atmest die Luft ein und spuerst foermlich die Naehe des Meeres.");
  AddDetail( ({"wertvolles"}),
    "Wenn Du Wertvolles suchst, bist Du hier eindeutig falsch.");
  AddDetail( ({"kuehle"}),
    "Richtiggehend angenehm!");
  AddSpecialDetail( ({"stoffbeutel","beutel"}),
    "det_beutel");
  // DETAILS END

  // EXITS START
  AddExit ("raus",
      ([
         EX_DEST:       ROOM("strand"),
         EX_TESTFUNC:   "darf_raus"
      ]) );
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"sitz", "setze"}), "sitz");
}

void reset()
{
  ::reset();
  kenntbeutel = ([ ]);
}

int sitz(string str)
{
  notify_fail ("Worauf willst Du Dich setzen?\n");
  if (!str) return 0;
  if (member(({"auf brocken", "auf felsbrocken", "auf fels"}), str) == -1)
    return 0;
  write(bs("Du setzt Dich auf einen der Felsbrocken, stehst aber gleich "
    "wieder auf, weil Du bemerkst, dass der Fels ziemlich nass ist. "
    "Dabei faellt Dir ein kleiner, zerfetzter Stoffbeutel auf, der "
    "in einer schmalen Ritze zwischen zwei Felsbrocken feststeckt."));
  say(bs(CAP_TPN+" setzt sich kurz auf einen Felsbrocken, steht aber "
    "sofort wieder auf.\n"));
  kenntbeutel[getuid(TP)] = 1;
  return 1;
}


int darf_raus(string richtung)
{
  if ((ROOM("strand"))->query_flut() && !gnade)
  {
    write("Du kannst die Hoehle bei Flut nicht verlassen, "
          "da der Ausgang ueberflutet ist.\n");
    return 0;
  }
  return 1;
}

void flutebbe(int flut)
{
  if (flut)
  {
    gnade = 1;
    call_out( "Message", 2,
        "Dies ist Deine letzte Chance, die Hoehle zu verlassen!\n"
        "Solltest Du noch laenger zoegern, musst Du wieder bis zur Ebbe warten.\n",
        MSGFLAG_VISUAL );
    call_out("keinegnade", GNADENFRIST);
  }
}

void keinegnade()
{
  Message("Ohje, Du hast zu lange gezoegert, nun haelt Dich die Flut hier gefangen.\n", MSGFLAG_VISUAL);
  gnade = 0;
}

string det_beutel()
{
  if (!kenntbeutel[getuid(TP)])
    return "Wo siehst Du denn hier einen Beutel?\n";

  if (TP->FindPotion(BS("Du nimmst den Stoffbeutel an Dich und entdeckst "
          "darin ein kleines Flaeschchen, das Du sofort austrinkst. Oh, "
          "es scheint sich um einen Zaubertrank gehandelt zu haben! "
          "Du spuerst ein eigenartiges Kribbeln im Bauch...")))
  {
    Message( TP->Name() + " findet ein kleines Flaeschchen, das " +
        TP->QueryPronoun() + " sofort austrinkt.\n",
        MSGFLAG_VISUAL | MSGFLAG_NO_TP );
    return "";
  }

  return BS("Du nimmst den Stoffbeutel an Dich und durchsuchst ihn, "
    "leider ist er leer.\nEnttaeuscht wirfst Du ihn wieder fort.");
}
