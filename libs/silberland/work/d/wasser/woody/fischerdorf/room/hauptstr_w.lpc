#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Hauptstrasse, westliches Ende");
  SetProp (P_INT_LONG,
    "Du stehst am westlichen Ende der Hauptstrasse des Fischerdorfes. Im "+
    "Suedwesten siehst Du einen Weg, der Richtung Meer fuehrt. Vom Sueden "+
    "her weht Dir Fischgeruch entgegen. Nach Nordwesten fuehrt ein Weg "+
    "ins Ungewisse. Du erkennst nur eine gruene Flaeche. Nach Osten "+
    "gelangst Du zum Hauptplatz. Rundum sind viele Haeuser.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus festgetrampelter Erde.");
  AddDetail ( ({"erde"}),
    "Gewoehnliche Erde, mehr nicht!");
  AddDetail ( ({"ende", "hauptstrasse"}),
    "Du stehst am westlichen Ende der Hauptstrasse, die wohl jedes Dorf "+
    "hat.");
  AddDetail ( ({"nordwesten", "suedwesten", "weg"}),
    "Der Weg fuehrt nach Nordwesten ins Ungewisse und nach Suedwesten zum "+
    "Meer.");
  AddDetail ( ({"meer"}),
    "Das Meer ist jetzt schon sehr nah. Weit und blau breitet es sich "+
    "suedlich von Dir aus.");
  AddDetail ( ({"ungewisse"}),
    "Nunja, mehr als eine gruene Flaeche kannst Du nicht erkennen. Da kann "+
    "man dann schon ruhig sagen, dass der Weg ins Ungewisse fuehrt.");
  AddDetail ( ({"flaeche"}),
    "Sie ist gruen. Du tippst auf eine Wiese, aber um mehr zu wissen, "+
    "musst Du naeher gehen.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Das Fischerdorf macht einen netten Eindruck auf Dich.");
  AddDetail ( ({"eindruck", "ordnung"}),
    "Die Ordnung und die Haeuser sehen sehr nett aus, sie gefallen Dir "+
    "gut.");
  AddDetail ( ({"halle", "sueden"}),
    "Im Sueden steht eine grosse Halle, aus der Dir Fischgeruch entgegen "+
    "weht. Es ist auch ein Schild darauf angebracht.");
  AddDetail ( ({"schild"}),
    "Du kannst es lesen.");
  AddReadDetail ( ({"schild"}),
    "Auf dem Schild steht: MARKTHALLE");
  AddDetail ( ({"fischgeruch"}),
    "Den kannst Du nicht sehen, rieche mal, oder geh dem Fischgeruch nach.");
  AddDetail ( ({"hauptplatz", "osten"}),
    "Im Osten liegt der Hauptplatz, wo auch ein Bildstock emporragt.");
  AddDetail ( ({"bildstock"}),
    "Der Bildstock steht am Hauptplatz, um mehr zu erkennen, musst Du "+
    "schon hingehen.");
  AddDetail ( ({"himmel", "sonne"}),
    "Am blauen Himmel ueber Dir glaenzt die goldene Sonne.");
  AddDetail ( ({"fischerhaeuser", "haeuser"}),
    "Die Haeuser stehen auf Pfaehlen. Kleine Leitern fuehren hinauf. Sie "+
    "sehen sehr ordentlich aus, was man an den Fenstern besonders gut "+
    "erkennt.");
  AddDetail ( ({"pfaehle", "pfahl"}),
    "Die Pfaehle sind ein notwendiger Schutz fuer die Bewohner der Haeuser "+
    "in der Naehe des Meeres. An den Pfaehlen siehst du gruenen Bewuchs.");
  AddDetail ( ({"bewuchs", "moos"}),
    "Es ist Moos, das nach und nach auf den Pfaehlen zu wuchern begann.");
  AddDetail ( ({"schutz"}),
    "Als Schutz vor Springfluten und Ueberschwemmungen sind die Pfaehle "+
    "gedacht.");
  AddDetail ( ({"fenster"}),
    "Du siehst in den Fenstern bunte Vorhaenge, die die Haeuser gemuetlich "+
    "erscheinen lassen. Die Menschen hier scheinen sie wohl liebevoll und "+
    "fleissig zu pflegen.");
  AddDetail ( ({"farbe", "farben", "vorhaenge", "vorhang"}),
    "In jedem Fenster haengt ein Vorhang anderer Farbe.");
  AddDetail ( ({"bewohner", "fischer", "menschen", "leute"}),
    "Die Fischer sind ehrliche, fleissige Leute, die auch sehr hilfsbereit "+
    "und gastfreundlich sind.");
  AddDetail ( ({"leiter", "leitern"}),
    "Ueber diese Leitern kommt man in die Haeuser.");
  AddDetail ( ({"springfluten", "ueberschwemmungen"}),
    "Davon gibt es hier in Meeresnaehe genug, weshalb die Bewohner des "+
    "Dorfes ihre Haeuser mit Pfaehlen davor schuetzen.");
  AddDetail ( ({"meeresnaehe", "naehe"}),
    "Wenn Du nur weit genug nach Sueden gehst, platscht Du mitten rein.");
  AddDetail ( ({"wiese"}),
    "Geh doch einfach hin!");
  AddSmell ( ({DEFAULT_SMELL, "fischgeruch", "geruch"}),
    "Aus dem Sueden weht Dir intensiver Fischgeruch entgegen.");
  AddDetail ( ({"fisch", "fische"}),
    "Ob etwa Fische den Fischgeruch verursachen?");
  AddSmell ( ({"fisch", "fische"}),
    "Noch ist der Geruch ertraeglich. Was wohl passiert, wenn Du ihm "+
    "folgst?");
  // DETAILS END

  // EXITS START
  AddExit ("osten", ROOM("hauptplatz"));
  AddExit ("sueden", ROOM("markthalle"));
  AddExit ("nordwesten", ROOM("wiesenweg"));
  AddExit ("suedwesten", ROOM("strandweg1"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
