#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Markthalle");
  SetProp (P_INT_LONG,
    "Du stehst in einer riesigen Markthalle. Wo Du auch hinsiehst, "+
    "ueberall Fisch, Fisch und nochmals Fisch. In langen Reihen stehen "+
    "einfache Holztische da, auf denen der Fang der Fischer zum Verkauf "+
    "angeboten wird. Zwischendurch siehst Du immer wieder kleine "+
    "Taefelchen. Am Boden kannst Du ab und zu schwarze Wesen "+
    "vorbeihuschen sehen. Der Fischgeruch ist beinahe unertraeglich.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "erdboden"}),
    "Du stehst auf einem stark ausgetrampelten Erdboden.");
  AddDetail ( ({"erde"}),
    "Dunkle, ausgetrampelte Erde.");
  AddDetail ( ({"halle", "markthalle"}),
    "Die Markthalle ist nicht nur fuer den Verkauf der Fische gedacht, "+
    "sondern auch als Lager.");
  AddDetail ( ({"lager"}),
    "Die Fischer brauchen ein Lager, wo sie ihre Fische aufbewahren "+
    "koennen. Denn wer will schon die Beute zu Hause lagern?");
  AddDetail ( ({"fisch", "fische", "kraken"}),
    "Wo Du auch hinsiehst, immer nur Fisch. Kleine Fische, grosse Fische, "+
    "auch einige Tintenfische und Kraken sind dabei.");
  AddDetail ( ({"delikatesse", "tintenfische", "tintenfischringe"}),
    "Eine Delikatesse, gebackene Tintenfischringe. Dir laeuft das Wasser "+
    "im Mund zusammen.");
  AddDetail ( ({"mund", "redewendung", "wasser"}),
    "Wasser im Mund zusammenlaufen, das ist doch bloss eine Redewendung...");
  AddDetail ( ({"reihe", "reihen"}),
    "Die Tische stehen fein saeuberlich hintereinander. Du siehst vier "+
    "lange Reihen von Tischen, die sich ueber die ganze Halle erstrecken.");
  AddDetail ( ({"holztische", "tische"}),
    "Es sind schlichte Tische. Da nur Fische darauf dargeboten werden, "+
    "sind sie hier gut genug.");
  AddDetail ( ({"fang"}),
    "Die Fischer bringen tagtaeglich reiche Beute von ihren Fahrten "+
    "hierher.");
  AddDetail ( ({"beute"}),
    "Die Beute der Fischer sind typischerweise Fische, alte Stiefel werden "+
    "in der Regel nur von Amateuranglern erbeutet.");
  AddDetail ( ({"stiefel"}),
    "Stiefel werden hier nirgends zum Verkauf angeboten. Du solltest Dein "+
    "Glueck woanders versuchen, wenn es das ist, was Du suchst!");
  AddDetail ( ({"amateurangler"}),
    "Bist Du vielleicht einer?");
  AddDetail ( ({"fahrten"}),
    "Fruehmorgens, wenn es noch kuehl ist, fahren die Fischer hinaus aufs "+
    "weite Meer.");
  AddDetail ( ({"meer"}),
    "Hier drinnen wirst Du es nicht finden, da musst Du schon raus gehen.");
  AddDetail ( ({"fischer"}),
    "Sie laufen hier drinnen geschaeftig hin und her. Es ist wohl besser, "+
    "sie nicht anzusprechen.");
  AddDetail ( ({"verkauf"}),
    "Ja, Du kannst hier auch Fische kaufen. Ganz unter uns: Hier ist es "+
    "sogar guenstiger, denn die Fische sind noch ganz frisch.");
  AddDetail ( ({"taefelchen"}),
    "Auf den Taefelchen stehen die Preise angeschrieben.");
  AddDetail ( ({"preise"}),
    "Von 100 bis 1000 Muenzen sind fast alle Preise vertreten...");
  AddReadDetail ( ({"preise", "taefelchen"}),
    "Von 100 bis 1000 Muenzen sind fast alle Preise vertreten...");
  AddDetail ( ({"decke", "holzdecke"}),
    "Eine gewoehnliche Holzdecke.");
  AddDetail ( ({"holz"}),
    "Die Tische, Waende und die Decke sind aus Holz.");
  AddDetail ( ({"waende"}),
    "Auch die Waende sind aus Holz.");
  AddDetail ( ({"hinsehen", "wesen"}),
    "Beim genaueren Hinsehen erkennst Du, dass es kleine, schwarze Katzen "+
    "sind.");
  AddDetail ( ({"katzen"}),
    "Jaja, wo Fische sind, sind Katzen nicht weit, was den Fischern aber "+
    "gar nicht recht ist. Sie fressen die Fische, die von den Tischen "+
    "fallen, manchmal stibitzen sie aber auch die guten.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht hier stark nach Fisch. Kein Wunder, Du stehst ja auch in "+
    "der Markthalle...");
  AddSmell ( ({"fisch", "fische"}),
    "Sehr fischig! Du haeltst Dir die Nase zu.");
  AddDetail ( ({"nase"}),
    "Mit ihr nimmst Du Gerueche wahr. Aber im Moment scheint es Dir so, "+
    "als gaebe es auf der ganzen Welt nur einen Geruch: den nach Fisch.");
  AddDetail ( ({"welt"}),
    "Die Welt ist draussen, und Du bist drinnen. Ist das nicht ungerecht?");
  // DETAILS END

  // EXITS START
  AddExit ("norden", ROOM("hauptstr_w"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"streichel", "streichle"}), "streichel");
}

int streichel (string str)
{
  if (!str) return 0;
  if ((str=="katze") || (str=="katzen")) {
    write ("Du versuchst, eine der Katzen zu streicheln, doch sie sind "
           "einfach zu scheu...\n");
    return 1;
  }
  return 0;
}
