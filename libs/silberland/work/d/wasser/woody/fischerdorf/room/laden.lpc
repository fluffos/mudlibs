#include <properties.h>
#include <moving.h>
#include <laden.h>
#include "files.h"
#include "../../hausquest.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/laden";

int etwas;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "In einem Laden");
  SetProp (P_INT_LONG, "\t"+bs(
    "Du betrittst einen kleinen Laden. Nur langsam gewoehnen sich Deine "+
    "Augen an das etwas schummrige Licht hier herinnen, denn Fenster hat "+
    "der Laden offenbar keine. Aber trotzdem ist es hier keineswegs "+
    "schmutzig, die Besitzerin scheint grossen Wert auf ein einigermassen "+
    "gepflegtes Geschaeft zu legen.")+"@@l_frau@@");
  // ROOM DESCRIPTION END
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp (P_SHOPKEEPER_ID, "fischersfrau");
  SetProp (P_SHOPKEEPER_NAME, "die Fischersfrau");
  SetProp (P_SHOPKEEPER_GENDER, FEMALE);

  // DETAILS START
  AddDetail ( ({"plaudern", "zeit"}),
    "Zum Plaudern hat diese Frau immer Zeit.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind weiss gestrichen. An den Waenden sind Regale "+
    "angebracht. Die Nordwand faellt Dir besonders auf.");
  AddDetail ( ({"nordwand"}),
    "Die Nordwand scheint besonders unregelmaessig zu sein, ein paar "
    "dunklere 'Spalten', die irgendeinen Umriss zu bilden scheinen, "
    "fallen Dir auf.");
  AddDetail ( ({"spalten","umriss"}),
    "Du kannst in diesem Licht nichts Naeheres erkennen. Vielleicht weiss "
    "aber die Ladenbesitzerin etwas darueber? Frag sie doch mal!");
  AddDetail ( ({"regal", "regale"}),
    "In den Regalen liegen diverse Gegenstaende, die man kaufen kann.");
  AddDetail ( ({"angebot", "ding", "dinge", 
                "gegenstaende", "gegenstand"}),
    "Wenn Du das Angebot des Ladens sehen willst, tippe einfach 'zeige' !");
  AddDetail ( ({"laden", "geschaeft", "raum"}),
    "Du stehst mittendrin!");
  AddDetail ( ({"licht"}),
    "Das Licht ist ziemlich schummrig hier. Liegt wohl auch daran, dass Du "+
    "nirgends Fenster erkennen kannst... ganz einfach, weil es keine gibt!");
  AddDetail ( ({"fenster"}),
    "Nochmal: Es gibt hier herinnen keine Fenster!");
  AddSpecialDetail ( ({"besitzerin", "frau", "fischersfrau"}),
    "d_besitzerin");
  AddDetail ( ({"boden"}),
    "Du stehst darauf, zu Deiner Verwunderung ist da kaum Schmutz zu sehen.");
  AddDetail ( ({"verwunderung"}),
    "Mal sie Dir gefaelligst selber aus!");
  AddDetail ( ({"schmutz"}),
    "Naja. Wenn Du GANZ genau hinschaust, kannst Du natuerlich schon ein "+
    "bisschen Staub erkennen, aber viel ist es wirklich nicht.");
  AddDetail ( ({"staub", "spuren"}),
    "Als Du den nur in Spuren vorhandenen Staub am Boden naeher "+
    "betrachtest, faellt Dir ein schwaches, silbriges Glitzern auf.");
  AddDetail ( ({"silber"}),
    "Nein, Silber ist es nicht. Viel zu wertvoll fuer diesen Laden!");
  AddDetail ( ({"glitzern"}),
    "Du betrachtest fasziniert das Glitzern und wunderst Dich, wie etwas "+
    "bei diesem schummrigen Licht ueberhaupt glitzern kann. Was ist es "+
    "bloss? Vielleicht solltest Du am Boden kriechen, um dieses Etwas "+
    "naeher zu erkennen.");
  AddSpecialDetail ( ({"etwas"}),
    "d_etwas");
  AddDetail ( ({"decke"}),
    "Die Decke ist zwar weiss gestrichen, macht den Raum aber auch nicht "+
    "heller.");
  AddDetail ( ({"augen"}),
    "Du reibst Dir etwas die Augen, um mehr zu erkennen, aber das "+
    "schummrige Licht macht es Dir etwas schwer.");
  AddDetail ( ({"tisch", "verkaufstisch"}),
    "Ein gewoehnlicher Verkaufstisch, nichts Besonderes.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("hauptplatz"));
  // EXITS END

  // ITEMS START
  AddItem (QDIR("fischersfrau"), REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd ( ({"betrete", "betritt"}), "betrete" );

  SetStorageRoom (ROOM("ladenlager"));

  AddCmd ("nimm", "nimm");
}

string l_frau()
{
  if (present("fischersfrau"))
    return bs("Hinter dem Verkaufstisch steht eine kleine, rundliche "
      "Fischersfrau.");
  else
    return bs("Sie scheint aber im Moment nicht anwesend zu sein.");
}

string d_besitzerin()
{
  if (present("fischersfrau"))
    return bs("Hinter dem Verkaufstisch steht eine kleine, rundliche "
      "Fischersfrau, ganz offensichtlich die Besitzerin des Ladens.");
  else
    return bs("Sie scheint im Moment nicht anwesend zu sein. Schade, "
      "wo sie doch angeblich so gerne plaudert...");
}

string d_etwas()
{
  if (present("etwas", TP))
    return
      "Du hast es eigentlich schon bei Dir. Schau es Dir mal genauer an!\n";
  if (etwas >= 3)
    return bs("Du betrachtest Etwas genauer und stellst fest, dass "
      "es leider doch nichts war, oder aber schon jemand anderer vor "
      "Dir mitgenommen haben muss.");
  return "Du koenntest es ja mal nehmen.\n";
}

int nimm(string str)
{
  if (!str || str != "etwas") return 0;
  if (present("etwas", TP))
    write ("Aber Du hast doch schon Etwas!\n");
  else if (etwas >= 3)
    write ("Ohjeh, da war schon jemand schneller als Du!\n");
  else {
    write ("Du nimmst Etwas.\n");
    say (CAP_TPN+" nimmt Etwas.\n");
    etwas++;
    clone_object(OBJ("etwas"))->move(this_player(), M_NOCHECK);
  }
  return 1;
}

void reset()
{
  ::reset();
  etwas=0;
}

int betrete(string str)
{
  if (str!="hinterhof" && str!="hof")
    return notify_fail("Was willst Du betreten?\n"), 0;
  return TP->move(ROOM("hinterhof"), M_GO, "in den Hinterhof");
}
