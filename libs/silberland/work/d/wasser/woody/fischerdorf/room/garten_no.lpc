#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

int aepfel;
#define ANZ_AEPFEL 4;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Du bist nun am nordoestlichen Eck des Gartens angelangt. Rings um "+
    "Dich stehen einige Apfelbaeume. Im Westen und Sueden siehst Du auch "+
    "verschiedene andere Baumsorten.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"apfelbaeume"}),
    "Die findet man wohl in jedem Garten! Es haengen viele Fruechte daran.");
  AddDetail ( ({"apfelbaum"}),
    "Vor Dir steht zum Beispiel einer.");
  AddDetail ( ({"eck","ecke","ausdruck"}),
    "Naja, Eck ist natuerlich ein bloeder Ausdruck in einem Garten, "
    "aber... ach egal. ;-)");
  AddDetail ( ({"garten"}),
    "Zweifelsohne ist das ein Garten!");
  AddDetail ( ({"fruechte"}),
    "Als Du die Aepfel siehst, vernimmst Du eine innere Stimme, die ruft: "+
    "\"Ach schuettel mich, schuettel mich, die Aepfel sind alle "+
    "miteinander reif!\" Oder ist Dir dieses Zitat von wo anders bekannt?");
  AddDetail ( ({"stimme", "zitat"}),
    "Es war wohl doch keine innere Stimme. Das ist doch ein Zitat aus Frau "+
    "Holle. Die Gebrueder Grimm moegen den geistigen Diebstahl verzeihen!");
  AddDetail ( ({"diebstahl"}),
    "Ach, nennen wir's doch einfach nur Zitat.");
  AddDetail ( ({"zitat"}),
    "Es gibt noch ganz andere Zitate!");
  AddDetail ( ({"zitate"}),
    "Frag mal den alten Goetz!");
  AddDetail ( ({"goetz"}),
    "Wenn Du den nicht kennst, frag auf -a ;-)");
  AddDetail ( ({"frau holle", "frau", "holle",
        "gebrueder", "grimm", "maerchen"}),
    "\"Frau Holle\" ist ein Maerchen der Gebrueder Grimm.");
  AddDetail ( ({"aepfel"}),
    "Du wuerdest die Aepfel ja gerne pfluecken, doch Du erreichst sie "+
    "nicht. Sie sind zu hoch oben!");
  AddDetail ( ({"boden"}),
    "Am Boden liegen keine Aepfel herum. Vermutlich werden sie immer gleich "
    "eingesammelt, wenn sie runterfallen, sind sie ja schliesslich eine "
    "wahre Koestlichkeit.");
  AddDetail ( ({"koestlichkeit"}),
    "Ja, die Aepfel am Baum sehen wahrlich koestlich aus.");
  AddDetail ( ({"baum", "baeume", "baumsorten", "westen", "sueden"}),
    "Neben den Apfelbaeumen rings um Dich stehen im Westen und Sueden "
    "noch weitere Baeume, Du musst naeher hingehen, um mehr zu sehen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("garten_n"));
  AddExit ("suedwesten", ROOM("garten_zentrum"));
  AddExit ("sueden", ROOM("garten_o"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"schuettel", "schuettle"}), "schuettel");
  aepfel=ANZ_AEPFEL;
}

void reset()
{
  ::reset();
  aepfel=ANZ_AEPFEL;
}

int schuettel (string str)
{
  notify_fail ("Was willst Du schuetteln?\n");
  if (!str) return 0;
  if (str!="baum" && str!="apfelbaum") return 0;
  write ("\nDu schuettelst an einem der Apfelbaeume...\n\n\n");
  say (CAP_TPN+" schuettelt an einem Apfelbaum.\n");
  while (remove_call_out("aua") != -1) /* continue */ ;
  call_out("aua", 3, TP);
  return 1;
}

void aua(object pl)
{
  object ob;
  if (!pl || (ENV(pl) != ME)) return;

  // Moeglichkeit 1: Nix gibts.
  if ((aepfel < 1) || random(4) ||
      deep_present("apfel",pl) || present("apfel",ME))
  {
    write("Ein paar Blaetter fallen ab. Sonst passiert nichts.\n");
    Message("Ein paar Blaetter fallen vom Baum.\n",
        MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    return;
  }
  // Moeglichkeit 2: Apfel faellt ... Dir auf den Kopf.
  if (!random(3))
  {
    write ("\nPloetzlich faellt ein Apfel herab und Dir direkt auf den Kopf!\n"
        "Aaaauuuuaaaaa!!!!\n"
        "Du bueckst Dich und steckst ihn grummelnd ein.\n");
    Message("Ein herabfallender Apfel trifft " + pl->name(WEN) + " am Kopf!\n",
        MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    CLONETP(OBJ("apfel"), ob);
    SetProp(P_KILL_NAME, "Ein herabfallender Apfel");
    pl->do_damage(3);
    SetProp(P_KILL_NAME, 0);
  }
  // Moeglichkeit 3: Apfel faellt zu Boden.
  else
  {
    write ("\nPloetzlich faellt ein Apfel herab. Du steckst ihn sofort ein.\n");
    Message("Ein Apfel faellt vom Baum.\n" +
        pl->Name(WER) + " steckt ihn sofort ein.\n",
        MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    CLONETP(OBJ("apfel"), ob);
  }
  aepfel--;
}

