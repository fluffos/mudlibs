#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

#define ANZ_BEEREN 2
int beeren;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Du stehst nun im noerdlichen Teil des Gartens. Rings um Dich stehen "+
    "viele Zwetschkenbaeume. Wohin Du auch blickst, nach Sueden, Westen "+
    "oder Osten, ueberall siehst Du nur Baeume. Im Sueden erblickst du "+
    "aber auch einige Straeucher.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"baeume", "osten", "sueden", 
                "westen"}),
    "Weiter im Westen, Sueden und Osten stehen andere Baeume. Geh doch "+
    "hin!");
  AddDetail ( ({"straeucher"}),
    "Die Straeucher sind weiter im Sueden.");
  AddDetail ( ({"zwetschkenbaeume","zwetschkenbaum"}),
    "Die Zwetschkenbaeume sind ueber und ueber mit Fruechten geschmueckt.");
  AddDetail ( ({"fruechte", "pflaumen", "zwetschken"}),
    "Blaue Fruechte. Ob Zwetschken oder Pflaumen wollen wir uns hier nicht "+
    "streiten! Vielleicht kannst Du ja ein paar der koestlichen Fruechte "+
    "pfluecken. Nur welche sollst Du nehmen, gruene oder blaue?");
  AddDetail ( ({"boden", "gras"}),
    "Nur gruenes Gras findet sich am Boden. Die abgefallenen Fruechte hat "+
    "wohl jemand eingesammelt!");
  AddDetail ( ({"garten", "teil"}),
    "Du stehst hier im Norden des Gartens.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("garten_nw"));
  AddExit ("suedwesten", ROOM("garten_w"));
  AddExit ("sueden", ROOM("garten_zentrum"));
  AddExit ("suedosten", ROOM("garten_o"));
  AddExit ("osten", ROOM("garten_no"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"pfluecke", "pflueck"}), "pfluecke");
  beeren=ANZ_BEEREN;
}

void reset()
{
  ::reset();
  beeren=ANZ_BEEREN;
}

int pfluecke (string str)
{
  object ob;
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  notify_fail ("So etwas kannst Du hier nicht pfluecken!\n");
  if (str!="zwetschke" && str!="pflaume" && str!="frucht") return 0;
  if (beeren) {
    write("Du pflueckst Dir eine der blauen Zwetschke vom Baum.\n");
    say (CAP_TPN+" pflueckt eine blaue Zwetschke.\n");
    CLONETP(OBJ("zwetschke"), ob);
    beeren--;
  } else
    write(bs("Leider hat das schon jemand vor Dir gemacht, Du erreichst "
        "nur noch die abgegrasten Aeste, die anderen sind zuweit weg..."));
  return 1;
}
