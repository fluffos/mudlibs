#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Nun stehst Du im Zentrum des Obstgartens. Noerdlich und oestlich "+
    "bist Du von Baeumen umgeben. Im Sueden und Westen wachsen "+
    "Straeucher. Hier findest Du Nussbaeume.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"mitte", "zentrum"}),
    "Du stehst nun in der Mitte des Gartens. Von hier aus kannst Du in "+
    "alle Himmelsrichtungen weitergehen.");
  AddDetail ( ({"himmelsrichtungen", "richtungen"}),
    "Norden, Sueden, Osten, Westen, daheim ist's doch am Besten!");
  AddDetail ( ({"obstgarten", "garten"}),
    "Viele Fruechte sind hier vertreten.");
  AddDetail ( ({"fruechte"}),
    "Viele wachsen im Garten. Hier sind es Nuesse!");
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"nuesse"}),
    "Runde, braune Nuesse. Sie wachsen auf den hohen Nussbaeumen. Auch am "+
    "Boden liegen einige herum.");
  AddDetail ( ({"nussbaeume", "nussbaum"}),
    "Die Nussbaeume findest Du gleich hier! Vielleicht kannst Du ja einen "
    "von ihnen schuetteln?");
  AddDetail ( ({"boden", "gras"}),
    "Zwischen dem gruenen Gras liegen viele Nuesse!");
  AddDetail ( ({"baeume", "norden", "osten"}),
    "Weiter im Norden und Osten stehen andere Baeume. Geh doch hin!");
  AddDetail ( ({"straeucher", "sueden", "westen"}),
    "Sie wachsen im Sueden und Westen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("garten_w"));
  AddExit ("suedwesten", ROOM("garten_sw"));
  AddExit ("sueden", ROOM("garten_s"));
  AddExit ("suedosten", ROOM("garten_so"));
  AddExit ("osten", ROOM("garten_o"));
  AddExit ("nordwesten", ROOM("garten_nw"));
  AddExit ("norden", ROOM("garten_n"));
  AddExit ("nordosten", ROOM("garten_no"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"schuettel", "schuettle"}), "schuettel");
}

int schuettel (string str)
{
  notify_fail ("Was willst Du schuetteln?\n");
  if (!str) return 0;
  if (str!="baum" && str!="nussbaum") return 0;
  write ("\nDu schuettelst an einem der Nussbaeume...\n\n\n");
  say (CAP_TPN+" schuettelt an einem Nussbaum.\n");
  call_out("aua", 3);
  return 1;
}

void aua()
{
  if (!TP || (ENV(TP)!=ME)) return;
  write ("\n...und wirst von einer herabfallenden Nuss getroffen! AUA!!\n");
  say (CAP_TPN+" wird von einer herabfallenden Nuss getroffen!\n"
      "Das muss weh getan haben... "+CAP(TP->QueryPronoun())+
      " reibt sich den Kopf.\n");
}

