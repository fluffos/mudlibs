#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

#define ANZ_BIRNEN 3
int birnen;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Du befindest Dich nun im oestlichen Teil des weiten Gartens. Rings "+
    "um Dich stehen viele Birnbaeume. Am Boden liegen einige Fruechte umher. "+
    "Im Norden siehst Du verschiedene andere Baeume, im Sueden einige "+
    "Straeucher.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"garten", "teil"}),
    "Du stehst hier im oestlichen Teil des Gartens.");
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"baeume", "norden", "westen"}),
    "Weiter im Norden und Westen stehen andere Baeume. Geh doch hin!");
  AddDetail ( ({"straeucher", "sueden"}),
    "Die Straeucher wachsen im Sueden.");
  AddDetail ( ({"birnbaeume"}),
    "Baeume mit Birnen dran werden wohl Birnbaeume sein. An den Aesten "+
    "haengen viele Fruechte.");
  AddDetail ( ({"aeste", "ast"}),
    "An den braunen Aesten haengen viele gelbe Fruechte.");
  AddDetail ( ({"fruechte"}),
    "Sowohl am Boden als auch an den Birnbaeumen siehst Du Birnen. Einige "+
    "sind noch gruen und unausgereift. Viele lachen Dir aber schon goldig "+
    "gelb entgegen.");
  AddDetail ( ({"birnen"}),
    "Birnen sind die Fruechte der Birnbaeume.");
  AddDetail ( ({"boden"}),
    "Einige Fruechte liegen am Boden herum, sonst siehst Du nur das gruene "+
    "Gras.");
  AddDetail ( ({"gras"}),
    "Es wuchert am Boden unter Dir.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("garten_zentrum"));
  AddExit ("sueden", ROOM("garten_so"));
  AddExit ("suedwesten", ROOM("garten_s"));
  AddExit ("nordwesten", ROOM("garten_n"));
  AddExit ("norden", ROOM("garten_no"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"pfluecke", "pflueck"}), "pfluecke");
  birnen = ANZ_BIRNEN;
}

void reset()
{
  ::reset();
  birnen = ANZ_BIRNEN;
}

int pfluecke (string str)
{
  object ob;
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  notify_fail ("So etwas kannst Du hier nicht pfluecken!\n");
  if (str!="birne" && str!="birnen") return 0;
  if (birnen) {
    write("Du pflueckst Dir eine saftige Birne vom Baum.\n");
    say (CAP_TPN+" pflueckt eine saftige Birne.\n");
    CLONETP(OBJ("birne"), ob);
    birnen--;
  } else
    write(bs("Leider hat das schon jemand vor Dir gemacht, Du erreichst "
        "nur noch leere Aeste, die, die noch Fruechte tragen, sind "
        "leider ausserhalb Deiner Reichweite..."));
  return 1;
}

