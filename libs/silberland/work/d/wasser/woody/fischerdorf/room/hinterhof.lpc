#include <properties.h>
#include <moving.h>
#include "files.h"
#include "../../hausquest.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "In einem Hinterhof");
  SetProp (P_INT_LONG,
    "Du stehst im Hof hinter dem Laden. Der Hof ist mit Holzlatten "
    "eingezaeunt, damit keiner von aussen hier herein kann. Der einzige "
    "Durchgang hierher scheint der Laden zu sein, der Weg, den auch Du "
    "genommen hast. An der Hauswand des Ladens steht eine kleine Holzbank, "
    "sonst faellt Dir auf den ersten Blick nichts weiter auf.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"blick"}),
    "Auf den zweiten Blick erkennst Du irgendetwas in der Mitte des Hofes.");
  AddDetail ( ({"hinterhof", "hof"}),
    "In diesem Hof stehst Du gerade.");
  AddDetail ( ({"durchgang", "laden"}),
    "Durch den Laden bist Du hierher gekommen.");
  AddDetail ( ({"holzlatten", "latten"}),
    "Sie schuetzen den Hinterhof. Du fragst Dich nach dem Grund dieser "+
    "Schutzvorrichtung.");
  AddDetail ( ({"hauswand", "wand"}),
    "Du siehst die Hauswand des Ladens, an der eine Bank aufgestellt "+
    "wurde.");
  AddDetail ( ({"bank", "holzbank"}),
    "Eine kleine Bank, auf der sich die Ladenbesitzerin vermutlich an "+
    "sonnigen Tagen in der Mittagspause ein wenig ausruht, Du kannst nichts "+
    "Besonderes an ihr erkennen. Neben der Bank steht ein kleiner Behaelter.");
  AddDetail ( ({"behaelter", "abfallbehaelter"}),
    "Es ist ein kleiner Abfallbehaelter, der es einem zum Beispiel "
    "ermoeglicht, verschiedene Gefaesse zu entleeren. Er scheint aber "
    "trotz seiner geringen Groesse alles aufnehmen zu koennen.");
  AddDetail ( ({"groesse"}),
    "Der Abfallbehaelter ist zwar aeusserlich eher klein, scheint aber "
    "trotzdem endlos aufnahmefaehig zu sein.");
  AddDetail ( ({"gefaesse"}),
    "Eimer und Vasen etwa.\n");
  AddDetail ( ({"eimer", "vase", "vasen"}),
    "Hast Du denn sowas?\n");
  AddDetail ( ({"besitzerin", "ladenbesitzerin"}),
    "Sie ist bestimmt im Laden!");
  AddDetail ( ({"ladne"}),
    "Typo! Du meinst bestimmt Laden! *grins*");
  AddDetail ( ({"tag", "tage"}),
    "Auch heute ist ein sonniger Tag.");
  AddDetail ( ({"mittagspause", "pause", "zeit"}),
    "Du hast keine Zeit, um eine Pause zu machen, daher kannst Du Dich "+
    "auch nicht auf die Bank setzen. Schau Dich lieber um!");
  AddDetail ( ({"besonderes"}),
    "Nichts!");
  AddDetail ( ({"nichts"}),
    "Besonderes!");
  AddDetail ( ({"grund"}),
    "Der Grund fuer diese Schutzvorrichtung wird Dir klar, wenn du das "+
    "Loch in der Mitte des Hinterhofes genauer ansiehst.");
  AddDetail ( ({"loch", "mitte", "schutzvorrichtung"}),
    "In der Mitte des Hinterhofes ist ein Loch, aber kein gewoehnliches "
    "Loch. Bei naeherer Betrachtung stellst Du fest, dass es sich hierbei "
    "um eine Art Brunnen zu handeln scheint! Und das kostbare Wasser gilt "
    "es vor Boesewichten zu schuetzen.");
  AddDetail ( ({"boesewichte", "brunnen", "wasser", "trinkwasser"}),
    "Das Wasser aus dem Brunnen ist das Trinkwasser und auch das Wasser "+
    "zum Kochen, Waschen und Putzen, denn das Meerwasser ist dafuer nicht "+
    "geeignet. Damit aber keiner das Wasser verschmutzen kann, kommt man "+
    "nur durch den Laden hierher.");
  AddDetail ( ({"kochen", "putzen", "waschen"}),
    "HIER musst Du nichts von alledem machen, aber vielleicht woanders...");
  AddDetail ( ({"waende"}),
    "Die einzige Wand, die Du hier siehst, ist die des Ladens.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus festgetrampelter Erde.");
  AddDetail ( ({"erde"}),
    "Auch hier ist es ganz gewoehnliche Erde.");
  AddDetail ( ({"himmel", "sonne"}),
    "Ueber Dir der strahlend blaue Himmel mit der goldenen Sonne.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("laden"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"befuelle", "befuell", "fuelle", "fuell"}), "fuelle");
  AddCmd ( ({"entleere", "leere"}), "entleere");
  AddCmd ( ({"trink", "trinke"}), "trinke");
}

int fuelle (string str)
{
  string s1,s2;
  object ob;

  notify_fail ("Was willst Du womit fuellen?\n");
  if (!str) return 0;
  if (sscanf(str, "%s mit %s", s1, s2)!=2)
    if (sscanf(str, "%s in %s", s2, s1)!=2)
      return 0;
  notify_fail ("Das kannst Du hier nicht befuellen!\n");
  if (s1!="eimer" && s1!="kuebel" && s1!="vase") return 0;

  notify_fail (CAP(s1)+"? Sowas hast Du doch gar nicht dabei!\n");
  if (s1=="vase") {
    if (!ob=present(VASE_ID,TP)) return 0;
  }
  else if (!ob=present(EIMER_ID,TP)) return 0;

  notify_fail (CAP(s2)+" findest Du hier nirgends.\n");
  if (s2!="wasser") return 0;

  switch (ob->QueryProp(P_CONTAINS))
  {
    case CONTAINS_WATER:
      write ("Aber "+ob->name(WER,1)+
          " ist doch schon mit Wasser gefuellt!\n");
      break;
    case CONTAINS_COLOR:
      write ("Aber "+ob->name(WER,1)+
          " ist noch randvoll mit Farbe gefuellt!\n");
      break;
    case CONTAINS_FLOWERS:
      write ("Du erneuerst das Blumenwasser in "+ob->name(WEM,1)+".\n");
      say (CAP_TPN+" erneuert das Blumenwasser in "+ob->name(WEM)+".\n");
      break;
    case CONTAINS_COLOR_R:
      write (bs("Du fuellst "+ob->name(WEN,1)+" mit Wasser und spuelst "+
          ob->QueryPronoun(WEN)+" gruendlich aus. Die Farbreste sind "
          "nun restlos beseitigt!"));
      ob->SetProp(P_CONTAINS, CONTAINS_NOTHING);
      break;
    default:
      write ("Du fuellst "+ob->name(WEN,1)+" sorgfaeltig mit Wasser.\n");
      say (CAP_TPN+" fuellt "+ob->name(WEN)+" sorgfaeltig mit Wasser.\n");
      ob->SetProp(P_CONTAINS, CONTAINS_WATER);
  }
  return 1;
}

int entleere (string str)
{
  object ob;
  notify_fail ("Was willst Du entleeren?\n");
  if (!str) return 0;
  if (str!="eimer" && str!="kuebel" && str!="vase") return 0;
  notify_fail (CAP(str)+"? Sowas hast Du doch gar nicht dabei!\n");
  if (str=="vase") {
    if (!ob=present(VASE_ID,TP)) return 0;
  }
  else if (!ob=present(EIMER_ID,TP)) return 0;
  switch (ob->QueryProp(P_CONTAINS))
  {
    case CONTAINS_WATER:
      write ("Du leerst das Wasser vorsichtig in den Brunnen zurueck.\n");
      say (CAP_TPN+" entleert "+ob->name(WEN)+".\n");
      ob->SetProp(P_CONTAINS, CONTAINS_NOTHING);
      break;
    case CONTAINS_COLOR:
      write (bs("Du leerst die Farbe vorsichtig in den Abfallbehaelter. "
          "Zurueck bleiben noch jede Menge Farbreste."));
      say (CAP_TPN+" entleert "+ob->name(WEN)+".\n");
      ob->SetProp(P_CONTAINS, CONTAINS_COLOR_R);
      break;
    default:
      write ("Du kannst "+ob->name(WEN,1)+" nicht entleeren!\n");
  }
  return 1;
}

mapping heilung = ([ ]);

int trinke(string str)
{
  int hp;

  notify_fail ("Was willst Du trinken?\n");
  if (!str) return 0;
  notify_fail (capitalize(str) + " kannst Du hier nicht trinken.\n");
  if (str!="wasser" && str!="trinkwasser" && str!="aus brunnen") return 0;

  if (TP->drink_soft(6))
  {
    hp = time() - heilung[getuid(TP)];
    heilung[getuid(TP)] = time();
    hp = 3 + hp / 120;          // alle 2 Minuten +1 LP mehr Heilung
    if (hp > 20) hp = 20;       // aber nie mehr als 20 !

    // Meldung
    write(
        "Du nimmst einen Schluck reinsten Wassers aus dem Brunnen.\n"
        "Aaaaah, das tut erfrischend gut!\n" );
    Message(
        TP->Name() + " trinkt einen Schluck Wasser aus dem Brunnen.\n" +
        capitalize(TP->QueryPronoun(WER)) + " wirkt sehr erfrischt.\n",
        MSGFLAG_VISUAL | MSGFLAG_NO_TP );

    // Heilung
    TP->heal_self(hp);
  }
  return 1;
}
