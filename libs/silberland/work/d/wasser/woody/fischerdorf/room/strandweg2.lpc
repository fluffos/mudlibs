#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Strandweg");
  SetProp (P_INT_LONG,
    "Du gehst auf dem Strandweg, der vom Dorf runter zur Kueste fuehrt. "+
    "Zur Erde mischen sich immer mehr auch Sand und kleine Steine. Man "+
    "merkt, dass der Strand nicht mehr weit ist. Auch der salzige Geruch "+
    "des Meeres steigt schon in Deine Nase. Am Himmel siehst Du ein paar "+
    "Voegel kreisen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"strandweg", "weg"}),
    "Der Weg fuehrt vom Dorf zum Strand. Wie Du gehen die Fischer "+
    "fruehmorgens immer diesen Weg entlang.");
  AddDetail ( ({"fischer"}),
    "Die Fischer gehen sehr frueh vom Dorf runter zum Strand.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Im Norden siehst Du noch das Dorf.");
  AddDetail ( ({"kueste"}),
    "Ein Fischerdorf muss am Meer liegen, sonst haetten die Fischer einen "+
    "weiten Weg.");
  AddDetail ( ({"meer"}),
    "Weit und blau breitet sich das Meer im Sueden aus.");
  AddDetail ( ({"boden", "erde"}),
    "Der Boden besteht aus Erde. Doch immer mehr mischen sich Sand und "+
    "Steine dazu. Auch die Pflanzen am Wegrand liegen unter einer kleinen "+
    "Sandschicht.");
  AddDetail ( ({"pflanzen"}),
    "Hartnaeckig finden die Pflanzen den Weg durch die Sandschicht zur "+
    "Sonne hin.");
  AddDetail ( ({"sandschicht"}),
    "Etwas Sand liegt auf den Pflanzen, die den Weg einrahmen.");
  AddDetail ( ({"himmel", "sonne"}),
    "Hoch ueber Dir steht die Sonne im blauen Himmel.");
  AddDetail ( ({"voegel"}),
    "Die Voegel begleiten kreischend Deinen Weg. Du erkennst, dass es "+
    "Moewen sind.");
  AddDetail ( ({"moewen"}),
    "Die Moewen findet man immer in der Naehe des Meeres.");
  AddDetail ( ({"geruch"}),
    "Vielleicht solltest Du besser riechen?");
  AddDetail ( ({"sand", "steine", "steinchen"}),
    "Der Sand und die kleinen Steinchen lassen die Naehe des Meeres "+
    "erkennen. Ein Stein ist besonders auffaellig.");
  AddDetail ( ({"naehe"}),
    "Nun ist das Meer nicht mehr weit.");
  AddDetail ( ({"nase"}),
    "Das ist der kleine Huegel in Deinem Gesicht!");
  AddDetail ( ({"huegel"}),
    "Der kleine Huegel in Deinem Gesicht ist Deine Nase.");
  AddDetail ( ({"gesicht"}),
    "Nur nicht Dein Gesicht verlieren! ;-)");
  AddDetail ( ({"strand"}),
    "Um zum Strand zu gelangen, musst Du dem Weg weiter folgen.");
  AddDetail ( ({"wegrand"}),
    "Am Wegrand erkennst Du unter einer kleinen Sandschicht ein paar "+
    "Pflanzen.");
    
  AddDetail("stein",
    "Dieser Stein faellt Dir auf, da er besonders gross ist. An der Dir "
    "zugewandten Seite hat der Stein eine kleine Ritze.");
  AddDetail("ritze",
    "Vielleicht kann man dort hineinfassen und somit den Stein anheben?");
  
  AddSmell ( ({DEFAULT_SMELL, "meer"}),
    "Es riecht hier ein wenig salzig, nach Meer eben.");
  AddSound ( ({DEFAULT_SOUND, "meer", "rauschen"}),
    "Du hoerst das leise Rauschen des Meeres.");
  // DETAILS END
  
  AddCmd("fasse|fass&in&ritz|ritze", "cmd_stein",
         "Willst Du IN etwas fassen?|Fass einfach in die Ritze!");

  // EXITS START
  AddExit ("osten", ROOM("strandweg1"));
  AddExit ("suedwesten", ROOM("strand"));
  AddExit ("suedosten", "/d/wasser/kia/nachtfahrer/room/fischerdorf");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

int cmd_stein(string str)
{
  write(BS(
    "Du greifst in die Ritze und hebst den Stein mit aller Kraft nach oben. "
    "Ein Tunnel wird sichtbar und Du springst hinein. Ueber Dir schliesst "
    "sich der Eingang wieder!"));
  Message(BS(TPN+" fuchtelt mit den Haenden an einem Stein rum und ist "
                 "ploetzlich verschwunden!"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TP->move("/d/wasser/woody/fischerdorf/room/stein", M_NOCHECK);
  return 1;
}