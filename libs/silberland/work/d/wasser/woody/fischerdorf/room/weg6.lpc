#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf einem Dorfweg");
  SetProp (P_INT_LONG,
    "Der kleine, erdige Seitenweg fuehrt nach Nordwesten zum Dorf und "+
    "nach Osten zu einer Weggabelung. Er wird links und rechts von Gras "+
    "eingesaeumt. Die Sonne laesst gnaedig ihre Strahlen spielen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "seitenweg", "weg", 
                "wege"}),
    "Der Weg besteht aus festgetrampelter Erde. Auch er scheint viel "+
    "benutzt zu sein.");
  AddDetail ( ({"erde"}),
    "Sie ist hart, Spuren sind kaum mehr zu erkennen.");
  AddDetail ( ({"spur", "spuren"}),
    "Es sind zuviele Spuren ueberlagert, Du kannst keine mehr deutlich "+
    "erkennen.");
  AddDetail ( ({"himmel"}),
    "Am blauen Himmel ueber Dir ergiesst die Sonne ihre Strahlen.");
  AddDetail ( ({"sonne", "strahl", "strahlen"}),
    "Die Sonne schickt ihre besten Strahlen aus und macht es angenehm "+
    "warm.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Es ist ein kleines Fischerdorf. Vielleicht solltest Du naeher "+
    "hingehen, um mehr erkennen zu koennen.");
  AddDetail ( ({"ost", "osten"}),
    "Im Osten siehst Du eine Weggabelung.");
  AddDetail ( ({"weggabelung"}),
    "Zwei Wege trennen sich. Du denkst ein wenig wehmuetig zurueck, wie "+
    "oft sich in Deinen Leben schon Wege getrennt haben.");
  AddDetail ( ({"leben"}),
    "Normalerweise hat jeder, ausser Katzen, ein Leben. Goetternseidank "+
    "ist das hier nicht so.");
  AddDetail ( ({"katzen"}),
    "Kleine, kuschelige Katzen haben bekanntlich neun Leben.");
  AddDetail ( ({"graeser", "gras"}),
    "Gruenes Gras saeumt den braunen Weg ein. Schoen anzusehen!");
  // DETAILS END

  // EXITS START
  AddExit ("nordwesten", ROOM("hauptstr_o"));
  AddExit ("osten", ROOM("weg5"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
