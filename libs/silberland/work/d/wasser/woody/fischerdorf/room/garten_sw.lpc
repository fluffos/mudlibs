#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

#define ANZ_BEEREN 3
int beeren;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Vor Deinen Augen breitet sich der Garten aus. Suedlich von Dir "+
    "siehst Du das Gartentor und die Wiese. In Norden und Osten siehst Du "+
    "weit entfernt verschiedene Baeume und auch einige Straeucher. Hier "+
    "am Boden entdeckst Du auch Gewaechse.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"gartentor", "sueden", "wiese"}),
    "Die Wiese und das Gartentor befinden sich im Sueden.");
  AddDetail ( ({"garten"}),
    "Du stehst nun im Garten.");
  AddDetail ( ({"augen", "augenfarbe"}),
    "Blau, gruen, grau oder braun, welche ist Deine Augenfarbe?");
  AddDetail ( ({"norden", "osten"}),
    "Du siehst im Norden und Osten Straeucher und Baeume.");
  AddDetail ( ({"baeumer", "straeuche"}),
    "Um mehr zu erkennen, musst Du naeher hingehen.");
  AddDetail ( ({"boden", "gras"}),
    "Gruenes Gras, dazwischen aber rote Gewaechse.");
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"gewaechse"}),
    "Irgendwie kommen Dir diese roten Fruechte bekannt vor.");
  AddDetail ( ({"erdbeeren", "fruechte"}),
    "Erdbeeren sind es! Lecker! Ob du sie wohl essen kannst?");
  AddDetail ( ({"essen"}),
    "Du solltest die Erdbeeren vorher pfluecken.");
  AddDetail ( ({"baeume", "straeucher"}),
    "Du solltest naeher rangehen, um etwas erkennen zu koennen.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("wiese"));
  AddExit ("osten", ROOM("garten_s"));
  AddExit ("norden", ROOM("garten_w"));
  AddExit ("nordosten", ROOM("garten_zentrum"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"iss"}), "iss");
  AddCmd ( ({"pfluecke", "pflueck"}), "pfluecke");
  beeren=ANZ_BEEREN;
}

void reset()
{
  ::reset();
  beeren=ANZ_BEEREN;
}

int pfluecke (string str)
{
  object ob;
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  notify_fail ("So etwas kannst Du hier nicht pfluecken!\n");
  if (str!="erdbeeren" && str!="erdbeere") return 0;
  if (beeren) {
    write("Du pflueckst Dir eine saftige Erdbeere von dem Strauch.\n");
    say (CAP_TPN+" pflueckt eine saftige Erdbeere.\n");
    CLONETP(OBJ("erdbeere"), ob);
    beeren--;
  } else
    write(bs("Leider hat das schon jemand vor Dir gemacht, Du siehst "
        "nur noch einen leeren Strauch, als Du genauer hinblickst..."));
  return 1;
}

int iss (string str)
{
  notify_fail("Was willst Du essen?\n");
  if (!str) return 0;
  notify_fail("Das kannst Du hier nicht essen.\n");
  if (str!="erdbeeren" && str!="erdbeere") return 0;
  notify_fail("Du solltest die Erdbeeren vorher pfluecken.\n");
  return 0;
}
