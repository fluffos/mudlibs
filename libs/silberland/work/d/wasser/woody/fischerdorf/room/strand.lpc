#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

#define MAX_PHASE       3
#define PHASENDAUER     400

string *flut_text = ({
    ({
        "Das Wasser zieht sich immer mehr zurueck und legt den Strand immer mehr frei.\n",
        "Der Meeresspiegel ist an seinem Tiefpunkt angelangt.\n"
            "Du erreichst nun trockenen Fusses alle Wege, die sich Dir erschliessen.\n",
        "Das Wasser beginnt sich langsam wieder zurueckzuziehen, die Flut laesst nach.\n",
    }),
    ({
        "Das Wasser steigt immer weiter an, die Flut naehert sich ihrem Hoehepunkt.\n",
        "Das Meer umspuelt sanft und kribbelnd Deine Fuesse.\n"
            "Die Flut hat nun ihren Hoechststand erreicht.\n",
        "Das Wasser beginnt sich langsam wieder zurueckzuziehen, die Flut laesst nach.\n",
    }) });

int flut = 1;           // Default: Flut
int phase = 2;          // Phase
int gezeitenwechsel = 0;


void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "Strand");
  SetProp (P_INT_LONG,
    "Nun bist Du am Strand angekommen. Es ist kein reiner Sandstrand, "
    "nein auch kleinere Steine liegen herum, also nicht gerade der ideale "
    "Ort zum Baden. Am Ufer liegen einige Ruderboote. Mit ihnen fahren "
    "die Fischer fruehmorgens zur Arbeit. Von den Booten schweift Dein "
    "Blick aufs Meer hinaus. Schier unendlich weit breitet es sich vor "
    "Deinen Augen aus. Im Westen erblickst Du in den Klippen ein Loch. Im "
    "Nordosten kommst Du wieder ins Dorf zurueck.\n@@desc_flut@@\n");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sandstrand", "strand"}),
    "Es ist kein reiner Sandstrand. Doch das tut seiner Schoenheit keinen "+
    "Abbruch.");
  AddDetail ( ({"abbruch", "schoenheit"}),
    "Trotz der Steine darin ist der Strand wunderschoen.");
  AddDetail ( ({"sand", "steine"}),
    "Feinkoerniger Sand, aber auch kleine Steine bilden das Ufer des "+
    "Meeres.");
  AddDetail ( ({"ufer"}),
    "Am Ufer liegen einige Ruderboote.");
  AddDetail ( ({"ausruhen", "baden", "entspannen", 
                "schwimmen"}),
    "Schwimmen kannst Du natuerlich schon, wenn Du unbedingt willst, aber "+
    "zum Ausruhen und Entspannen ist der Strand wohl nicht geeignet.");
  AddDetail ( ({"boote", "ruderboote"}),
    "Es sind einfache Boote aus Holz. Damit verdienen die Fischer ihr "+
    "taeglich Brot.");
  AddDetail ( ({"holz"}),
    "Ganz gewoehnliches Holz.");
  AddDetail ( ({"brot"}),
    "Auch Fischer brauchen Brot.");
  AddDetail ( ({"fischer"}),
    "Die Fischer sind jetzt im Dorf.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Von hier aus ist das Dorf kaum mehr zu sehen.");
  AddDetail ( ({"arbeit"}),
    "Die Arbeit der Fischer ist schon aus dem Namen zu erkennen.");
  AddDetail ( ({"name"}),
    "Fischer fischen, ist doch klar!");
  AddDetail ( ({"anblick", "blick"}),
    "Das Meer in seinen schimmernden Blautoenen ist ein Anblick fuer "+
    "Goetter.");
  AddDetail ( ({"blau", "blautoene"}),
    "Das Meer ist nicht einheitlich blau, die Sonne und die Wellen zaubern "+
    "viele Nuancen hinein.");
  AddDetail ( ({"goetter"}),
    "Auch gewoehnliche Sterbliche geniessen den Anblick. Er ist nicht nur "+
    "den Goettern vorbehalten, deren Macht aber ueberall spuerbar ist.");
  AddDetail ( ({"gegenteil", "sterbliche"}),
    "Sterbliche sind wohl das Gegenteil von Goettern.");
  AddDetail ( ({"macht"}),
    "Ja, die Goetter haben uneingeschraenkte Macht ueber uns, die sie aber "+
    "nicht hinterhaeltig ausnuetzen! Goetternseidank!");
  AddDetail ( ({"meer"}),
    "Schier unendlich weit breitet sich das Meer vor Deinen Augen aus. So "+
    "weit, so schoen. Du kannst Dich kaum satt sehen.");
  AddDetail ( ({"himmel"}),
    "Das Blau des Meeres geht in das Blau des Himmels ueber.");
  AddDetail ( ({"sonne", "wellen"}),
    "Die Wellen und die Sonne zaubern herrliche Nuancen ins Blau des "+
    "Meeres.");
  AddDetail ( ({"klippen"}),
    "Steil ragen die Klippen im Westen gen Himmel. In den Klippen gaehnt "+
    "ein schwarzes Loch.");
  AddDetail ( ({"eingang", "loch"}),
    "Das Loch ist der Eingang zu einer Hoehle. Du kannst offenbar durch "+
    "das Loch hineinklettern. Darueber ist eine Tafel angebracht.");
  AddDetail ( ({"hoehle"}),
    "Von hier aus siehst Du davon nur ein kleines, finsteres Loch. Um mehr "+
    "zu erkennen, musst Du Dich wohl oder uebel ins Ungewisse wagen...");
  AddDetail ( ({"ungewisse", "ungewisses"}),
    "Du weisst es noch nicht...");
  AddDetail ( ({"tafel"}),
    "Du kannst sie lesen.");
  AddReadDetail ( ({"tafel"}),
    "Auf der Tafel steht: Vorsicht bei Flut!");
  AddDetail ( ({"ebbe", "flut", "gezeiten"}),
    "Die Fischer kennen sich bestimmt gut mit Ebbe und Flut, den Gezeiten "+
    "aus. Auch Du solltest sie beachten, sie werden einem schnell zum "+
    "Verhaengnis.");
  AddDetail ( ({"verhaengnis"}),
    "Du solltest Dich gut in acht nehmen!");
  AddDetail ( ({"wasser", "wellen"}),
    "Wild schlaegt das Wasser des Meeres hohe Wellen.");
  AddDetail ( ({"boden"}),
    "Der Boden unter Dir wird durch Sand und kleine Steine gebildet.");
  AddSmell ( ({DEFAULT_SMELL, "luft", "meerluft"}),
    "Du atmest die Luft ein und spuerst foermlich die Naehe des Meeres.");
  AddDetail ( ({"nuancen"}),
    "Hellblau, dunkelblau, marinblau, tuerkisblau, ...");
  AddDetail ( ({"dunkelblau", "hellblau", "marinblau", 
                "tuerkisblau"}),
    "Alles irgendwie blau halt. (I'm blue, dabadee, dabadoo...)");
  AddDetail ( ({"ort"}),
    "Den idealen Ort musst Du demzufolge woanders suchen. Es sei denn, Du "+
    "bist bescheiden und genuegsam. Aber wer ist das schon?");
  AddDetail ( ({"auge", "augen"}),
    "Zwei Augen in Deinem Gesicht folgen den Wellen des Meeres.");
  AddDetail ( ({"gesicht"}),
    "Sei nicht so eitel. Wen interessiert hier schon Dein Gesicht?");
  AddDetail ( ({"naehe"}),
    "Das Meer liegt genau vor Dir.");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("strandweg2"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"kletter", "klettere"}), "kletter");

  call_out( "flutebbe", 10 );
}

int kletter (string str)
{
  notify_fail ("Wo willst Du durchklettern?\n");
  if (!str) return 0;
  if ((str!="durch loch") && (str!="in hoehle") && (str!="in loch") &&
      (str!="durch loch in hoehle") && (str!="loch")) return 0;

  if (flut)
  {
    write("Bist Du lebensmuede?! Waehrend der Flut kannst Du Dich doch nicht\n"
        "in die kleine Hoehle wagen, das waere viel zu gefaehrlich!\n");
    return 1;
  }

  write ("Du machst Dich ganz klein und kletterst durch das Loch.\n");
  TP->move(ROOM("hoehle"), M_GO,
           "durch ein Loch", "klettert", "kommt hereingeklettert");
  return 1;
}

string desc_flut()
{
  if (flut)
    return "Im Moment ist gerade Flut, das Wasser umstroemt Deine Fuesse.";
  else
    return "Derzeit herrscht Ebbe vor, welche eine kleine Hoehle freilegt.";
}

void flutebbe()
{
  if (++phase >= MAX_PHASE)     // 0..2
  {
    flut = !flut;
    phase = 0;
    gezeitenwechsel = time();
    call_other( ROOM("hoehle"), "flutebbe", flut );
  }
  Message( flut_text[flut][phase], MSGFLAG_VISUAL );
  call_other( ROOM("hoehle"), "Message", flut_text[flut][phase], MSGFLAG_VISUAL );
  call_out( "flutebbe", PHASENDAUER );
}

int query_flut()
{
  return flut;
}
