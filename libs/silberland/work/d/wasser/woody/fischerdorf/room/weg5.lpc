#include <properties.h>
#include <moving.h>
#include "files.h"
#include "/d/wasser/anschluss.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "Weg vor dem Pier");
  SetProp (P_INT_LONG,
    "Hier kannst Du dem Weg in sechs verschiedene Richtungen folgen. Nach "
    "Nordosten geht es ueber einen Landweg weiter Richtung Wald, Du kannst "
    "ihm aber auch nach Osten ins Ungewisse folgen. Weiter im Westen "
    "gelangst Du wohl ins Dorfinnere. Nach Sueden hin kannst Du den "
    "Pier betreten, an der Schiffe auf ihrem Weg in aller Herren "
    "Laender anlegen, auch eine Hafenkneipe kannst Du erkennen. Im "
    "Suedwesten und im Suedosten kann man den Strand betreten. Ein "
    "kleiner Wegweiser steht in der Mitte der Kreuzung etwas verloren "
    "umher.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({"strand"}),
     "Der Strand ist noch zu weit weg, da musst Du schon nach Suedwesten oder "
     "Suedosten gehen.");
  AddDetail ( ({"weg"}),
    "Hier trennt sich der Weg, nun musst Du Dich entscheiden, was Du "+
    "weiter erkunden willst!");
  AddDetail ( ({"boden"}),
    "Der Boden besteht auch hier aus festgetrampelter Erde.");
  AddDetail ( ({"erde"}),
    "Die Erde ist so festgestampft, weil viele Wesen hier vorbeikommen.");
  AddDetail ( ({"wesen"}),
    "Menschen, Hobbits, Elfen und Zwerge, die vom Pier rauf zur Stadt "+
    "wollen, oder auch die Bewohner des nahe gelegenen Dorfes.");
  AddDetail ( ({"elfen", "hobbits", "menschen", 
                "zwerge"}),
    "All diese Arten sind hier vertreten.");
  AddDetail ( ({"arten"}),
    "Menschen, Hobbits, Elfen oder Zwerge (Ach ja, die Reihenfolge sagt "+
    "natuerlich absolut nichts ueber Rang oder Stellung einer Rasse aus).");
  AddDetail ( ({"reihenfolge"}),
    "Sie ist willkuerlich gewaehlt, Beschwerden sind beim Vogel Rok "+
    "vorzubringen.");
  AddDetail ( ({"rang", "stellung"}),
    "Die Reihenfolge der Nennung sagt nichts darueber aus!");
  AddDetail ( ({"nennung"}),
    "Die Nennung der Arten ist gemeint.");
  AddDetail ( ({"bewohner", "fischer"}),
    "Die Bewohner des Dorfes sind einfache Fischer.");
  AddDetail ( ({"himmel"}),
    "Er strahlt himmlisch blau ueber Dir.");
  AddDetail ( ({"richtung", "richtungen"}),
    "Hier kannst du grob zwischen vier verschiedenen waehlen. "
    "Wenn man den Strand nicht mitzaehlt.");
  AddDetail ( ({"nordosten"}),
    "Nach Nordosten geht es auf dem Landweg weiter ueber eine Bruecke zum "+
    "Wald und in die Stadt.");
  AddDetail ( ({"stadt"}),
    "Sie liegt in weiter Ferne.");
  AddDetail ( ({"wald"}),
    "Um in den Wald zu gelangen, musst du dem Weg nach Nordosten folgen.");
  AddDetail ( ({"westen"}),
    "Im Westen liegt in weiterer Folge das Dorf.");
  AddDetail ( ({"sueden"}),
    "Im Sueden kannst Du den Pier betreten und per Schiff verreisen.");
  AddSpecialDetail ( ({"osten"}), "d_osten" );
  AddDetail ( ({"folge"}),
    "Was wollt ihr bloss immer... Auf alles habe selbst ich nicht Antwort!");
  AddDetail ( ({"antwort"}),
    "*verzweifel* nicht schon wieder... ;-)");
  AddDetail ( ({"fischerdorf", "dorf"}),
    "Es liegt im Westen.");
  AddDetail ( ({"landweg"}),
    "Er fuehrt weiter nach Nordosten auf den Wald zu.");
  AddDetail ( ({"ferne"}),
    "Sogar noch weiter.");
  AddDetail ( ({"pier"}),
    "Am Pier legen die Schiffe an, die Dich in weiter entfernte Laender "+
    "bringen koennen. Ausserdem kannst Du eine Art Hafenkneipe, als "+
    "Wartehalle getarnt erkennen.");
  AddDetail ( ({"schiff", "schiffe"}),
    "Immer wieder legen sie am Pier an.");
  AddDetail ( ({"laender"}),
    "Es gibt weit mehr Laender als das, auf dem Du Dich befindest.");
  AddDetail ( ({"herr", "herren"}),
    "Jemand fluestert Dir zu: Dieses Wort wurde nur als Teil einer "+
    "Redewendung verwendet und ist nicht weiter untersuchenswert...");
  AddDetail ( ({"hafenkneipe"}),
    "Getarnt ist sie als Wartehalle.");
  AddDetail ( ({"wartehalle", "halle"}),
    "Waehrend die Reisenden dort auf ihre Schiffe warten, koennen sie sich "+
    "hier noch einmal mit einem Happen fuer die Reise staerken oder sich "+
    "von den Strapazen derselbigen erholen.");
  AddDetail ( ({"happen"}),
    "Ein Happen Essen.");
  AddDetail ( ({"essen"}),
    "Schau doch mal in der Wartehalle vorbei, was es dort so alles gibt!");
  AddDetail ( ({"reise"}),
    "Hast Du eine vor Dir?");
  AddDetail ( ({"reisende", "reisender"}),
    "Bist Du eine(r)?");
  AddDetail ( ({"strapazen"}),
    "Hast Du etwa welche hinter Dir?");
  AddReadDetail ( ({"wegweiser"}),
  "\n ,----------------------------------.\n"+
    " |              Silberwald, Midas,  |\n"+
    " |            Gebirge, Huegelland   |\n"+
    " | Fischer-       /                 |\n"+
    " |    dorf   ----+----  Knarkh      |\n"+
    " |               |                  |\n"+
    " |              Pier                |\n"+
    " |         (Schiffverkehr)          |\n"+
    " `--------------.    ,--------------'\n"+
    "                |    |\n\n");
  AddDetail ( ({"wegweiser"}),
    "Du kannst ihn lesen.\n");
  AddDetail ( ({"kreuzung", "mitte"}),
    "Du stehst mitten auf der Kreuzung. Ausser den Wegen, die in alle "+
    "moeglichen Richtungen fuehren, kannst Du noch einen Wegweiser "+
    "erkennen.");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("weg4"));
  AddExit ("sueden", "/d/wasser/lupus/pier/room/steg01");
  AddExit ("westen", ROOM("weg6"));
  AddExit ("osten", FISCHERDORF_KNARKHWEG);
  AddExit ("suedosten", FISCHERDORF_ALRIK);
  AddExit ("suedwesten", FISCHERDORF_RIDU);
  // EXITS END

  // ITEMS START
  // ITEMS END

}

string d_osten()
{
  return "Der Weg nach Osten fuehrt ins Ungewisse." +
    (TP ? " Ja, auch Dich, " + TP->name(WEN) + "!" : "") + "\n";
}
