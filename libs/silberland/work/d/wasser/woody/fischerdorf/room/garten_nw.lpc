#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Rings um Dich stehen viele Marillenbaeume. Einer faellt Dir "+
    "besonders auf. Weiter im Osten stehen noch mehr Baeume. Im Sueden "+
    "befinden sich einige Straeucher.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"baeume", "norden", "osten"}),
    "Weiter im Norden und Osten stehen andere Baeume. Geh doch hin!");
  AddDetail ( ({"straeucher", "sueden"}),
    "Die Straeucher wachsen weiter suedlich. Du musst hingehen, wenn Du "+
    "mehr sehen willst.");
  AddDetail ( ({"boden", "gras"}),
    "Im gruenen Gras am Boden liegen einige verfaulte Fruechte.");
  AddDetail ( ({"marillenbaeume"}),
    "An den Marillenbaeumen haengen viele Fruechte. Ein Baum unterscheidet "+
    "sich von den anderen.");
  AddDetail ( ({"fruechte"}),
    "Marillen, was sonst sollte auf Marillenbaeumen wachsen als orangerote "+
    "Marillen?");
  AddDetail ( ({"marillen"}),
    "Marillen haengen an den Baeumen, einige liegen verfault im Gras.");
  AddDetail ( ({"baum", "marillenbaum"}),
    "Auch dieser Baum ist ein Marillenbaum, nur die Zweige sind etwas "+
    "anders.");
  AddDetail ( ({"zweige"}),
    "Warum haengen an diesen Zweigen kaum Fruechte? An dieser Seite siehst "+
    "Du nichts Besonderes, vielleicht solltest Du Dir die andere Seite "+
    "ansehen?");
  AddDetail ( ({"seite"}),
    "Fast alles hat zwei Seiten, oder mehr!");
  AddDetail ( ({"andere seite"}),
    "Ja, der Baum hat auch eine andere Seite. Vielleicht solltest Du da "+
    "einfach hingehen?");
  AddDetail ( ({"garten", "obstgarten", "eck", "ecke"}),
    "Du befindest Dich hier im nordwestlichen Eck des Obstgartens.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", ROOM("garten_w"));
  AddExit ("suedosten", ROOM("garten_zentrum"));
  AddExit ("osten", ROOM("garten_n"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"geh", "gehe"}), "geh");
}

int geh (string str)
{
  notify_fail ("Wohin willst Du gehen?\n");
  if (!str) return 0;
  if ((str!="auf andere seite") && (str!="zu anderer seite") &&
      (str!="zur anderen seite") && (str!="zu der anderen seite") &&
      (str!="hinter baum") && (str!="hinter stamm"))
    return 0;
  TP->move(ROOM("marillenbaum_u"), M_GO, "auf die andere Seite des Baums");
  return 1;
}
