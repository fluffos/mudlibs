#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Du stehst auf der Rueckseite des Marillenbaums. Jetzt verstehst Du, "+
    "warum die Zweige auf dem Baum so leer sind. Hier steht eine Leiter "+
    "und eine Kiste rum.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "gras"}),
    "Am Boden waechst gruenes Gras. Neben dem Baum steht eine Kiste.");
  AddDetail ( ({"baum"}),
    "Es ist ein Marillenbaum.");
  AddDetail ( ({"leiter"}),
    "Eine lange Leiter lehnt am Baum. Die braucht man, um an die Marillen "+
    "zu gelangen.");
  AddDetail ( ({"marillenbaum"}),
    "Ein Baum, auf dem Marillen wachsen.");
  AddDetail ( ({"marillen"}),
    "Sie haengen am Baum und liegen in der Kiste. Daraus kann man gute "+
    "Kuchen backen oder sie einfach so essen.");
  AddDetail ( ({"kiste"}),
    "In der Kiste sind viele Marillen.");
  AddDetail ( ({"kuchen"}),
    "Einen leckeren Kuchen hast Du schon lang nicht mehr gegessen.");
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"baeume"}),
    "Im Garten stehen noch viele andere Baeume.");
  AddDetail ( ({"garten", "obstgarten"}),
    "Du befindest Dich hinter einem Marillenbaum in einem grossen "+
    "Obstgarten.");
  AddDetail ( ({"rueckseite"}),
    "Merkwuerdig findest Du es schon, dass ein Baum eine Vorder- und eine "+
    "Rueckseite hat, aber Du entschliesst Dich, es nicht weiter zu "+
    "hinterfragen.");
  AddDetail ( ({"vorderseite"}),
    "Dahin kannst Du natuerlich auch wieder zurueck.");
  AddDetail ( ({"zweig", "zweige"}),
    "Sie sind leer, vermutlich wurden sie abgepflueckt.");
  // DETAILS END

  // EXITS START
  AddExit ("zurueck", ROOM("garten_nw"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"kletter", "klettere"}), "kletter");
  AddCmd ( ({"nimm"}), "nimm");
}

int kletter (string str)
{
  notify_fail ("Wohin willst Du klettern?\n");
  if (!str) return 0;
  if (member(({"hoch","rauf","baum","auf baum","leiter"}),str)==-1) return 0;
  TP->move(ROOM("marillenbaum_o"), M_GO,
      "auf einen Baum", "klettert", "kommt heraufgeklettert");
  return 1;
}

int nimm(string str)
{
  if (!str) return 0;
  if (str=="marillen" || str=="marillen aus kiste" || str=="kiste" ||
      str=="marille" || str=="marille aus kiste" || str=="alles aus kiste") {
    write (bs("Pflueck Dir gefaelligst Deine eigenen!"));
    return 1;
  }
  else return 0;
}
