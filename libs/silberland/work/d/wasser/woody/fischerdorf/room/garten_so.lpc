#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

#define ANZ_BEEREN 3
int beeren;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG,
    "Du stehst jetzt im suedoestlichen Eck des Gartens. Hier wachsen "+
    "einige Straeucher. Im Norden und Westen siehst Du Buesche und "+
    "Baeume. Vielleicht solltest Du naeher rangehen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "gras"}),
    "Gruen schimmert das Gras unter Dir.");
  AddDetail ( ({"himmel", "sonne"}),
    "Im blauen Himmel steht hoch die goldene Sonne.");
  AddDetail ( ({"nord", "norden", "west", 
                "westen"}),
    "Im Norden und Westen siehst Du weit entfernt einige Buesche und "+
    "Baeume.");
  AddDetail ( ({"baeume", "buesche"}),
    "Um mehr zu erkennen, musst Du naeher hingehen.");
  AddDetail ( ({"johannisbeeren", "ribisel", "trauben"}),
    "Es sind Johannisbeeren, auch Ribisel genannt. Die weissen sind noch "+
    "nicht ausgereift. Viele der Trauben sind aber schon reif und strahlen "+
    "Dir rot einerseits, schwarz andererseits entgegen.");
  AddDetail ( ({"straeucher","strauch"}),
    "An einigen dieser Straeucher haengen rote Trauben, an manchen "+
    "schwarze. Zwischendurch siehst Du auch einige weisse und blassrote.");
  AddDetail ( ({"eck", "ecke", "garten"}),
    "Du hast die suedoestliche Ecke des doch recht grossen Gartens "+
    "erreicht.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", ROOM("garten_s"));
  AddExit ("nordwesten", ROOM("garten_zentrum"));
  AddExit ("norden", ROOM("garten_o"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"pfluecke", "pflueck"}), "pfluecke");
  beeren=ANZ_BEEREN;
}

void reset()
{
  ::reset();
  beeren=ANZ_BEEREN;
}

int pfluecke (string str)
{
  object ob;
  notify_fail ("Was willst Du pfluecken?\n");
  if (!str) return 0;
  notify_fail ("So etwas kannst Du hier nicht pfluecken!\n");
  if (str!="traube" && str!="johannisbeere" && str!="ribisel") return 0;
  if (beeren) {
    write("Du pflueckst Dir eine der Ribiselbeeren von dem Strauch.\n");
    say (CAP_TPN+" pflueckt eine Ribisel.\n");
    CLONETP(OBJ("ribisel"), ob);
    beeren--;
  } else
    write(bs("Leider hat das schon jemand vor Dir gemacht, Du siehst "
        "nur noch einen leeren Strauch, als Du genauer hinblickst..."));
  return 1;
}
