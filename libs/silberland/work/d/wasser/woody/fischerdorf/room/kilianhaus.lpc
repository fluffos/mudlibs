#include <properties.h>
#include <moving.h>
#include "files.h"
#include "../../hausquest.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "Kilians Haus");
  SetProp (P_INT_LONG,
    "Du befindest Dich ganz offensichtlich im Haus eines alten Seebaeren. "
    "In einer Ecke haengt eine Haengematte. Rundherum an den Waenden "
    "viele Regale mit teils sonderbaren Gegenstaenden. Die Waende sind "
    "ausserdem noch mit einigen Zeichnungen geschmueckt. In der Mitte des "
    "Raumes steht ein einfacher Holztisch. Um den Tisch verteilt stehen "
    "vier Sessel, auf einem sitzt Kilian fuer gewoehnlich immer selbst. "
    "Auf dem Tisch stehen eine Flasche Wein und einige Glaeser. Auf dem "
    "Boden liegt ein bunter Teppich. In der hintersten Ecke steht eine "
    "alte Truhe. Durchs Fenster kann man hinaus aufs weite Meer blicken.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"haus", "raum"}),
    "Du stehst mitten drin.");
  AddDetail ( ({"seebaer", "kilian"}),
    "Jaja, Kilian ist alt, aber viel herumgekommen.");
  AddDetail ( ({"ecke", "besonderes"}),
    "Fast jede Ecke weist etwas Besonderes auf.");
  AddDetail ( ({"haengematte", "matte"}),
    "Glaubst Du, ein alter Seebaer schlaeft in einem gewoehnlichen Bett?");
  AddDetail ( ({"bett"}),
    "Bett siehst Du hier keins, nur die Haengematte, in der Kilian "
    "fuer gewoehnlich schlaeft.");
  AddDetail ( ({"wand", "waende"}),
    "Vier in hellem Weiss gestrichene Waende umgeben Dich.");
  AddDetail ( ({"weiss"}),
    "Wie aussen auch sind die Waende hier herinnen in einer merkwuerdig "
    "hellen und sauberen weissen Farbe gestrichen.");
  AddDetail ( ({"farbe"}),
    "Vielleicht solltest Du Dich mit Kilian darueber unterhalten?");
  AddDetail ( ({"decke"}),
    "Vorhanden, ueber deinem Kopf.");
  AddDetail ( ({"kopf"}),
    "Vorhanden, zwischen Deinen Schultern.");
  AddDetail ( ({"schultern"}),
    "Kommst Du Dir nicht albern vor?");
  AddDetail ( ({"waende"}),
    "An den Waenden sind Zeichnungen und Regale befestigt.");
  AddDetail ( ({"zeichnungen"}),
    "Es scheinen Zeichnungen von fernen Laendern zu sein, die Kilian "+
    "bereiste. Im unteren Eck stehen ein paar Worte.");
  AddDetail ( ({"laender"}),
    "Frag nicht, er war in sehr vielen.");
  AddDetail ( ({"eck"}),
    "Im untersten Eck der Zeichnungen stehen ein paar Worte.");
  AddDetail ( ({"worte"}),
    "Versuch sie mal zu lesen!");
  AddReadDetail ( ({"worte"}),
    "Du liest, dass Kilian die Zeichnungen selbst angefertigt hat.");
  AddDetail ( ({"regale"}),
    "Auf den Regalen befinden sich sonderbare Gegenstaende.");
  AddDetail ( ({"gegenstaende"}),
    "Du siehst ein seltsames Flaeschchen, Muscheln, Steine, vertrocknete "+
    "Blaetter und einiges mehr. Von jeder Reise hat Kilian etwas "+
    "mitgenommen.");
  AddDetail ( ({"reise", "reisen"}),
    "Kilian ist weit herumgekommen in seinem Leben.");
  AddDetail ( ({"flaeschchen"}),
    "In dem Flaeschchen befindet sich ein kleines, geschnitztes "+
    "Holzschiff.");
  AddDetail ( ({"holzschiff", "miramar", "nachbildung", 
                "schiff"}),
    "Es ist die Nachbildung von Kilians erstem Schiff, auf dem er diente, "+
    "die \"Miramar\".");
  AddDetail ( ({"farben", "muscheln"}),
    "Muscheln in allen Farben. Eine faellt Dir besonders auf.");
  AddDetail ( ({"muschel"}),
    "Du betrachtest die Muschel genauer und entdeckst eine Perle, die Du "+
    "aber lieber nicht mitnimmst.");
  AddDetail ( ({"perle"}),
    "Auf diese Perle ist Kilian besonders stolz. Du solltest sie lieber "+
    "hierlassen. Sie ist sowieso unverkaeuflich.");
  AddDetail ( ({"steine"}),
    "Bunte Steine, nichts Besonderes dabei, leider!");
  AddDetail ( ({"blaetter"}),
    "Irgendwie kommen Dir diese Blaetter bekannt vor. Du ueberlegst und "+
    "hast eine Idee.");
  AddDetail ( ({"idee", "teeblaetter"}),
    "Richtig, es sind Teeblaetter!");
  AddDetail ( ({"mitte", "holztisch", "tisch"}),
    "In der Mitte des Raumes steht ein einfacher Holztisch. Auf dem Tisch "
    "stehen eine Flasche Wein und ein paar Glaeser, um ihn herum vier "
    "Sessel.");
  AddDetail ( ({"sessel", "stuhl", "stuehle"}),
    "Ganz einfache Sessel aus Holz, nichts Besonderes.");
  AddDetail ( ({"holz"}),
    "Schlichtes, stabiles Holz, nichts Besonderes.");
  AddDetail ( ({"flasche", "wein"}),
    "Es ist eine Flasche Wein. Sie ist noch fast voll.");
  AddSpecialDetail ( ({"glaeschen", "glaeser"}), "d_glaeser");
  AddDetail ( ({"seemannsgarn"}),
    "Du wirst doch wohl wissen, was Seemannsgarn ist?");
  AddDetail ( ({"boden"}),
    "Auf dem Boden aus knarrenden Holzdielen liegt ein bunter Teppich.");
  AddDetail ( ({"holzdielen", "dielen"}),
    "Gewoehnliche Holzdielen, sie knarren unter Deinem Schritt.");
  AddDetail ( ({"schritt"}),
    "Du machst fuer gewoehnlich einen nach dem anderen.");
  AddDetail ( ({"faden", "teppich", "faeden"}),
    "Der Teppich ist aus bunten Faeden gewebt. Auch ihn hat Kilian "+
    "mitgebracht.");
  AddDetail ( ({"truhe"}),
    "Die Truhe entspricht Kilians schlichtem Leben. Was wohl darin sein "+
    "wird?");
  AddDetail ( ({"leben"}),
    "Kilian lebt schlicht und einfach.");
  AddDetail ( ({"anblick", "blick", "fenster"}),
    "Du hast einen herrlichen Blick aufs Meer. Ohne den Anblick des Meeres "+
    "koennte Kilian wohl nicht leben.");
  AddDetail ( ({"farbenspiel", "fluten", "meer", 
                "weite", "wogen"}),
    "Die wogenden Fluten, das staendige Farbenspiel, die schier unendliche "+
    "Weite des Meeres. Langsam verstehst Du, warum es Kilian so oft hinaus "+
    "zog.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", ROOM("hauptplatz"));
  // EXITS END

  // ITEMS START
  AddItem (QDIR("kilian"), REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd ("oeffne", "oeffne");

}

int oeffne(string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if (str!="truhe") return 0;
  write (bs("Du bist zu schwach, um die schwere Kiste zu oeffnen, das "
      "kann wohl nur Kilian selbst."));
  return 1;
}

string d_glaeser()
{
  if (present("kilian"))
    return break_string(
      "Einige Glaeser stehen auf dem Tisch. Es sieht richtig einladend aus. "
      "Auch Kilian blinzelt Dir aufmunternd zu. Ob er wohl bei einem "
      "Glaeschen Wein ein bisschen Seemannsgarn spinnen wird?", 78);
  else if (present("leiche"))
    return break_string(
      "Einige Glaeser stehen auf dem Tisch. Es sieht richtig einladend aus. "
      "Nur die Leiche, die da am Boden rumliegt, stoert ein wenig.", 78);
  else
    return break_string(
      "Einige Glaeser stehen auf dem Tisch. Es sieht richtig einladend aus. "
      "Schade, dass Kilian im Moment nicht da ist - er ist ein trinkfester "
      "Mann, der viel zu erzaehlen hat.", 78);
}
