#include <properties.h>
#include <moving.h>
#include "files.h"
#include "../../hausquest.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Wiesenweg");
  SetProp (P_INT_LONG,
    "Der Weg fuehrt aus dem Dorf hinaus hin zu einer grossen, gruenen "+
    "Flaeche. Es ist hier sehr friedlich und ruhig. Du geniesst die "+
    "Stimmung. Am Rande liegen ein paar groessere Steinbloecke.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "weg"}),
    "Hier ist der Weg anscheinend zu Ende. Du stehst vor einer grossen "+
    "gruenen Flaeche.");
  AddDetail ( ({"ende"}),
    "Aus ist aus!");
  AddDetail ( ({"flaeche", "wiese"}),
    "Vor Deinen Augen breitet sich Richtung Norden eine grosse, gruene "
    "Flaeche aus. Dein Verdacht bestaetigt sich. Es ist eine wunderschoene "
    "Wiese. Hier bluehen viele verschiedene Pflanzen. Ob man sie betreten "
    "kann?");
  AddDetail ( ({"verdacht"}),
    "Dein Verdacht hat sich bestaetigt.");
  AddDetail ( ({"frieden", "ruhe", "stimmung"}),
    "Ruhe und Frieden hast Du dringend noetig, und die findest Du hier.");
  AddDetail ( ({"blumen", "graeser", "pflanzen"}),
    "Du siehst viele verschiedene Graeser und Blumen in den schoensten "
    "Farben der Natur, hauptsaechlich am suedlichen Rand der Wiese.");
  AddDetail ( ({"rand", "suedrand", "suedlichen rand", "suedlicher rand"}),
    "Am suedlichen Rand (der Wiese noerdlich von Dir) sind die Graeser ein "
    "wenig geknickt. Ob das eine bestimmte Bedeutung hat?");
  AddDetail ( ({"bedeutung"}),
    "Du betrachtest die Graeser etwas naeher, und auf einmal schaerft sich "
    "Dein Blick fuer das Wesentliche. Du erkennst, dass es doch einen "
    "Trampelpfad in die Wiese gibt. Geh einfach weiter nach Norden, auch "
    "wenn Du den Weg nicht sehen kannst, es ist einer!");
  AddDetail ( ({"blick", "wesentliches"}),
    "Das Wesentliche ist fuer die Augen oft unsichtbar.");
  AddDetail ( ({"augen"}),
    "Deine beiden Augen sehen auch nicht immer sofort alles.");
  AddDetail ( ({"trampelpfad"}),
    "Hier gibt es einen Trampelpfad in die Wiese.");
  AddDetail ( ({"bloecke", "steinbloecke", "block", "steinblock"}),
    "Die Steinbloecke laden ein, sich hinzusetzen und darauf auszuruhen.");
  AddDetail ( ({"dorf"}),
    "Wenn Du ins Dorf willst, musst Du zurueck nach Suedosten.");
  AddDetail ( ({"himmel", "sonne"}),
    "Am blauen Himmel ueber Dir glaenzt die goldene Sonne.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht alles irgendwie so frisch hier.");
  AddDetail ( ({"farbe","farben"}),
    "Sie alle aufzuzaehlen waere vermutlich ein bisschen muehsam, aber aus "+
    "Deinem Farblehreunterricht weisst Du noch, dass es circa 16,7 "+
    "Millionen verschiedene sind.");
  AddDetail ( ({"farblehreunterricht"}),
    "Du hast auf einmal ganz bunte Visionen...");
  AddDetail ( ({"visionen"}),
    "Rot, Gruen, Blau, alles dreht sich um Dich.");
  AddDetail ( ({"rot","gruen","blau"}),
    "Warum ausgerechnet diese drei Farben...?");
  AddDetail ( ({"millionen","zahlen"}),
      ([ "zwerg" : "Dir als Zwerg wird bei so hohen Zahlen schwindlig... aber "
                   "wenn Du das in Geld haettest... waer schon was, oder?",
         0       : "Du haettest gerne fuer jede Farbe eine Muenze."
      ]) );
  AddDetail ( ({"geld","muenze"}),
    "\"Wenn ich einmal reich waer...\"");
  AddDetail ( ({"zwerg"}),
      ([ "zwerg" : "Du bist doch einer, oder?",
         0       : "Wo siehst Du hier einen Zwerg?"
      ]) );
  AddDetail ( ({"natur"}),
    "Du kannst sie hier in vollen Zuegen geniessen.");
  AddDetail ( ({"zuege"}),
    "Aber eigentlich hasst Du volle Zuege. Da kriegt man nie einen Platz.");
  AddDetail ( ({"platz"}),
    "Du platzt ja direkt vor Neugier!");
  AddDetail ( ({"neugier"}),
    "Neugier kann manchmal toedlich sein!");
  AddDetail ( ({"gras", "grashalm", "halm"}),
    "Als Du die Graeser genau betrachtest, kommst Du drauf, dass sie aus "+
    "einzelnen Grashalmen bestehen! Faszinierend.");
  // DETAILS END

  // EXITS START
  AddExit ("suedosten", ROOM("hauptstr_w"));
  AddExit ("norden", ROOM("wiese"));
  AddExit ("westen", "/d/huegelland/zordan/fischerweg/room/b3b8");
  // EXITS END
  SetProp (P_HIDE_EXITS, ({"norden"}) );

  // ITEMS START
  AddItem (QDIR("verian"), REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd ( ({"betritt", "betrete"}), "betritt");
  AddCmd ( ({"sitz", "setze"}), "sitz");
}

int sitz (string str)
{
  notify_fail ("Worauf willst Du Dich setzen?\n");
  if (!str) return 0;
  if (member(({"auf bloecke", "auf steinbloecke",
               "auf stein", "auf steine",
               "auf block", "auf steinblock"}), str) == -1) return 0;
  write (bs("Du setzt Dich auf einen der Steinbloecke und ruhst Dich ein "
    "wenig aus. Nach einiger Zeit wird Dir das dann aber doch zu dumm und "
    "Du stehst wieder auf, schliesslich gibt es auf dieser Welt noch viel "
    "fuer Dich zu sehen!"));
  say (bs(CAP_TPN+" setzt sich kurz auf einen Stein und ruht sich ein "
    "wenig aus."));
  return 1;
}

int betritt (string str)
{
  notify_fail ("Was willst Du betreten?\n");
  if (!str) return 0;
  if (str!="wiese" && str!="flaeche") return 0;
  write(bs("Hmm. Ja, vielleicht kann man die Wiese ja wirklich betreten, "
      "andererseits willst Du nicht einfach alles niedertrampeln. Du "
      "solltest Dich vielleicht vorher hier ein bisschen genauer "
      "umsehen!"));
  return 1;
}
