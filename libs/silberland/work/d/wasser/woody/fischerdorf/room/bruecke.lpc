#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "Auf einer Bruecke");
  SetProp (P_INT_LONG,
    "Du stehst auf einer stabilen, breiten Holzbruecke, die Dich sicher "+
    "ueber den kleinen Fluss traegt, der den Waldweg schon eine ganze "+
    "Weile begleitet hat. Weiter im Westen kannst Du ein kleines "+
    "Fischerdorf am Ufer des in der strahlenden Sonne glitzernden Meeres "+
    "entdecken, das sich weit nach Sueden hin scheinbar bis in die "+
    "Unendlichkeit erstreckt, waehrend nach Nordosten ein kleiner Weg in "+
    "den Silberwald hineinfuehrt, der sich gross und maechtig im Norden "+
    "erhebt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"sonne"}),
    "Die Sonne strahlt Dich an wie in ihren besten Tagen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ueber Dir ist tiefblau, keine einzige Wolke ist zu sehen.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Das Fischerdorf liegt weiter im Westen, mehr erkennst Du wohl, wenn "+
    "Du einfach hingehst...");
  AddDetail ( ({"pfad", "waldpfad", "waldweg", "weg"}),
    "Der Waldpfad weiter im Osten fuehrt in den beruehmten Silberwald "+
    "hinein, der sich weithin nach Norden vor Dir erhebt.");
  AddDetail ( ({"silberwald", "wald"}),
    "Noerdlich von Dir erstreckt sich der Silberwald in seiner "+
    "unglaublichen Groesse und Schoenheit, allerdings ist er nur zum Teil "+
    "durch Pfade erschlossen...");
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere ist unbeschreiblich und wird daher auch hier nicht "+
    "beschrieben...");
  AddDetail ( ({"boden", "beine"}),
    "Du stehst mit beiden Beinen fest auf dem Boden, in diesem Fall auf "
    "einer breiten, sehr stabil wirkenden Holzbruecke.");
  AddDetail ( ({"bruecke", "holzbruecke"}),
    "Die breite Holzbruecke wurde offenbar von zwergischen Handwerkern "
    "geschaffen, denn sie macht einen sehr stabilen und sauber gefertigten "
    "Eindruck. Du fuehlst Dich jedenfalls sehr sicher, waehrend der "
    "kleine Fluss unter Dir doch eher unbeeindruckt weiter zum Meer "
    "hinab rauscht.");
  AddDetail ( ({"handwerker"}),
    "Sie selbst kannst Du nicht sehen, sehr wohl jedoch ihr Werk, die "+
    "stabile Holzbruecke, auf der Du Dich gerade befindest.");
  AddDetail ( ({"handwerk", "werk"}),
    "Noch einmal betrachtest Du die Bruecke pruefend.\n"
    "Du denkst . o O ( Die Zwerge verstehen ihr Handwerk wirklich! )\n");
  AddDetail ( ({"fluss"}),
    "Der kleine Fluss rauscht unter der Bruecke hindurch weiter hinab zum "+
    "Ufer, wo er ins weite, blaue Meer muendet.");
  AddDetail ( ({"ufer"}),
    "Ufer nennt man jenen Teil des Landes, an dem das Meer beginnt.");
  AddDetail ( ({"meer"}),
    "Das blaue Meer erstreckt sich suedlich vor Dir in schier unendliche "+
    "Weite.");
  AddDetail ( ({"weite"}),
    "Immer noch schier unendlich.");
  AddDetail ( ({"pfade"}),
    "Einer dieser Pfade beginnt oestlich von hier.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst nur das laute Rauschen des Flusses unter Dir.");
  AddSound ( ({"fluss", "rauschen"}),
    "Der Fluss rauscht hier ziemlich laut, obgleich nicht ohrenbetaeubend. "+
    "Vielleicht klingt es etwas westlicher ein wenig angenehmer?");
  // DETAILS END

  // EXITS START
  AddExit ("osten", SILBERWALD("room/room_c19"));
  AddExit ("westen", ROOM("weg1"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
