#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/fischerdorf/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "Auf einem Landweg");
  SetProp (P_INT_LONG,
    "Der Weg fuehrt unbeirrbar weiter Richtung Meer einerseits, Richtung "+
    "Wald andererseits. Das Bild, das sich vor Deinen Augen ausbreitet, "+
    "vermittelt Dir die schoensten Eindruecke.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "landweg", "weg"}),
    "Der breite Landweg besteht aus festgetrampelter Erde. Er fuehrt "+
    "Richtung Meer und zum Wald.");
  AddDetail ( ({"erde"}),
    "Ganz gewoehnliche, festgetrampelte Erde, nichts besonderes, oder was "+
    "hast Du denn erwartet?");
  AddDetail ( ({"richtung"}),
    "Du kannst entweder in den Wald oder aber zum Meer.");
  AddDetail ( ({"meer"}),
    "Weit und blau breitet es sich in der Ferne aus.");
  AddDetail ( ({"wald"}),
    "Um in den Wald zu gelangen, musst Du die Bruecke im Nordosten "+
    "ueberqueren.");
  AddDetail ( ({"bruecke"}),
    "Die ist weiter im Nordosten. Wenn Du ein Brueckenexperte bist oder "
    "einfach nur mehr ueber diese eine Bruecke erfahren willst, musst "
    "Du wohl oder uebel naeher ran.");
  AddDetail ( ({"brueckenexperte"}),
    "Bist Du einer? *anerkennendpfeif*");
  AddDetail ( ({"bild"}),
    "Die Unberuehrtheit der Natur, die Ruhe und die Stille, es geht Dir "+
    "sehr zu Herzen.");
  AddDetail ( ({"ruhe","stille"}),
    "Sehr angenehm ist sie.");
  AddDetail ( ({"unberuehrtheit"}),
    "Hier hat noch keiner eingegriffen und die Schoenheit der Natur "+
    "zerstoert.");
  AddDetail ( ({"natur", "schoenheit"}),
    "Die Schoenheit der Natur umgibt Dich. Saftig gruenes Gras, ein "+
    "strahlend blauer Himmel, was will man mehr?");
  AddDetail ( ({"herz"}),
    "Jeder hat ein Herz, auch wenn manche das nicht glauben wollen, sei es "
    "in Elfen-, Hobbit-, Menschen- oder Zwergenbrust. Von den anderen Rassen "
    "weiss man es nicht so genau...");
  AddDetail ( ({"elfenbrust"}),
    "Schmeckt fast so gut wie Entenbrust.");
  AddDetail ( ({"entenbrust"}),
    "Aber nur fast!");
  AddDetail ( ({"hobbitbrust"}),
    "Haarige Sache.");
  AddDetail ( ({"brust","menschenbrust"}),
    "Ganz normale Brust halt.");
  AddDetail ( ({"zwergenbrust"}),
    "Hart und zaeh wie alles an Zwergen. ;)");
  AddDetail ( ({"zwerg","zwerge"}),
    "Hart und zaeh. :)");
  AddDetail ( ({"elf","elfen"}),
    "Weich und trotzdem knoechern. =)");
  AddDetail ( ({"hobbit","hobbits"}),
    "Mampfende Wollknaeuel. ;)");
  AddDetail ( ({"wollknaeuel"}),
    "...werden manchmal auch Hobbits genannt.");
  AddDetail ( ({"mensch","menschen"}),
    "Durchschnittswesen in jeder Hinsicht.");
  AddDetail ( ({"durchschnittswesen"}),
    "Menschen, oder was meinst Du?");
  AddDetail ( ({"rassen"}),
    "Probier mal 'hilfe rassen' !");
  AddDetail ( ({"hinsicht"}),
    "In jeder.");
  AddDetail ( ({"gras"}),
    "Gruen und saftig siehst Du es bluehen.");
  AddDetail ( ({"himmel"}),
    "Heute erstrahlt er in schoenstem Blau.");
  AddDetail ( ({"blau"}),
    "Blau ist blau, was soll es denn sonst sein?");
  AddDetail ( ({"ferne"}),
    "Du blickst vertraeumt in die Ferne.");
  AddDetail ( ({"augen"}),
    "Zwei davon hast Du, sie sind sehr nuetzlich...");
  AddDetail ( ({"eindruecke"}),
    "Du bist tief beeindruckt und ergriffen...");
  AddSound ( ({DEFAULT_SOUND}),
    "Du glaubst, das leise Rauschen des Meeres vernehmen zu koennen.");
  AddSound ( ({"meer", "rauschen"}),
    "Das Meer rauscht aus der Ferne beruhigend und leise vor sich hin.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht hier ganz leicht nach Fisch.");
  AddSmell ( ({"fisch"}),
    "Der Geruch ist kaum wahrnehmbar.");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", ROOM("weg1"));
  AddExit ("suedwesten", ROOM("weg3"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
