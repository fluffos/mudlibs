int access_rights(string name, string file, int readflag, int def, string fun)
{
  string *s;
  int n;

#define DEBUG
#undef DEBUG
#ifdef DEBUG
  if (find_player("woody") && find_player("woody")->QueryProp("debug"))
    tell_object(find_player("woody"),
        sprintf(" * wasser/woody::access_rights: %O - %O - %O - %O - %O\n",
          name,file,readflag,def,fun));
#endif

  // Lesezugriff ?
  if (readflag) {
    if (name=="anatol") return 1;
    if (name=="hiri") return 1;
    return def;
  }
  if ( (file == "fischerdorf/room/weg4.lpc") && (name == "malar") )
    return 1;

  return 0;
}

