/*
 * Eine Blume, Woody
 * Randommaessig, fuer Wiese...
 *
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

#define BDEF ({ \
    ({ "gaensebluemchen", "Ein Gaensebluemchen", \
       "Es ist ein einfaches Gaensebluemchen.", NEUTER }), \
    ({ "hahnenfuss", "Ein Hahnenfuss", \
       "Der Hahnenfuss ist eine schoene Pflanze mit gelben Blueten.", MALE }), \
    ({ "margerite", "Eine Margerite", \
       "Die Margerite hat einen langen Stengel und einen schoenen weissen Bluetenkopf.", FEMALE }), \
    ({ "loewenzahn", "Ein Loewenzahn", \
       "Eigentlich ist es ja Unkraut, aber irgendwie sieht der Loewenzahn ganz nett aus.", MALE }) })

create()
{
  int n;
  if (!is_clone(this_object())) return;
  ::create();
 
  n=random(sizeof(BDEF));
  AddId ( ({ "blume", BDEF[n][0] }) );
  SetProp (P_SHORT, BDEF[n][1]);
  SetProp (P_LONG, BDEF[n][2]);
  SetProp (P_NAME, explode(BDEF[n][1], " ")[<1]);
  SetProp (P_GENDER, BDEF[n][3]);
  SetProp (P_WEIGHT, 30+random(20));
  SetProp (P_VALUE, random(10));
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_PLANT);
}
