/*
** Ein Apfel
** 1996-03-04, Woody@SL
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Apfel");
  SetProp (P_LONG, "Ein leckerer, ueberreifer Apfel. Bestimmt nahrhaft!\n");
  SetProp (P_NAME, "Apfel");
  SetProp (P_GENDER, MALE);
  AddId("apfel");
  AddId("\nobst");
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 80);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:5+random(3), F_SOAK:3,
                          F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du verspeist den Apfel genuesslich.\n");
  say (CAP_TPN+" verspeist genuesslich einen Apfel.\n");
  return ::BeimEssen();
}
