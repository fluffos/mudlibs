/*
** Eine Ribisel
** September 97, Woody
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  if (random(2)) {
    SetProp (P_SHORT, "Eine rote Ribisel");
    SetProp(P_NAME_ADJ, "rot");
    AddAdjective( ({"rote"}) );
    SetProp (P_LONG,
        "Eine rote Ribisel, auch Johannisbeere genannt. Lecker...");
  }
  else
  {
    SetProp (P_SHORT, "Eine schwarze Ribisel");
    SetProp(P_NAME_ADJ, "schwarz");
    AddAdjective( ({"schwarze"}) );
    SetProp (P_LONG,
        "Eine schwarze Ribisel, auch Johannisbeere genannt. Lecker...");
  }
  SetProp (P_NAME, "Ribiselbeere");
  SetProp (P_GENDER, FEMALE);
  AddId( ({"ribisel","johannisbeere","beere"}) );
  AddId("\nobst");
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 10+random(10));
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:random(2), F_SOAK:random(2),
           F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du verzehrst die Ribiselbeere und verziehst das Gesicht - "
      "leicht saeuerlich!\n");
  say (CAP_TPN+
      " verzieht leicht das Gesicht, als "+TP->QueryPronoun(WER)+
      " eine Ribiselbeere isst.\n");
  return ::BeimEssen();
}
