/*
** Eine Stachelbeere
** September 97, Woody
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Stachelbeere");
  SetProp (P_LONG, "Eine blassgruene Stachelbeere. "
      "Soll ja lecker schmecken, kein bisschen nach Igel!");
  SetProp (P_NAME, "Stachelbeere");
  SetProp (P_GENDER, FEMALE);
  AddId( ({"stachelbeere","beere"}) );
  AddId("\nobst");
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 20+random(10));
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:1+random(2), F_SOAK:1,
           F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du verspeist die leckere Stachelbeere, ohne Dich zu stechen.\n");
  say (bs(CAP_TPN+" verspeist eine Stachelbeere und scheint sich dabei "
      "nicht einmal gestochen zu haben!"));
  return ::BeimEssen();
}
