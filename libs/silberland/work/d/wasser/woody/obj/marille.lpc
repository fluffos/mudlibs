/*
** Eine Marille
** 25.2.97, Woody
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Marille");
  SetProp (P_LONG, "Eine saftige Marille. Sie ist sicher sehr lecker.");
  SetProp (P_NAME, "Marille");
  SetProp (P_GENDER, FEMALE);
  AddId("marille");
  AddId("\nobst");
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 50+random(25));
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:5+random(5), F_SOAK:1,
           F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du verzehrst genuesslich eine Marille.\n");
  say (CAP_TPN+" verzehrt genuesslich eine Marille.\n");
  return ::BeimEssen();
}
