/*
** Eine Erdbeere
** September 97, Woody
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Erdbeere");
  SetProp (P_LONG, "Eine leckere Erdbeere. "
      "Dir rinnt das Wasser im Mund zusammen...");
  SetProp (P_NAME, "Erdbeere");
  SetProp (P_GENDER, FEMALE);
  AddId( ({"erdbeere","beere"}) );
  AddId("\nobst");
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 20+random(10));
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:1+random(2), F_SOAK:1,
           F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du verzehrst genuesslich eine Erdbeere.\n");
  say (CAP_TPN+" verzehrt genuesslich eine Erdbeere.\n");
  return ::BeimEssen();
}
