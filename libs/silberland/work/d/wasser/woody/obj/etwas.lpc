/*
** Etwas
** ---
** 1997-02-12  Woody  Release
** 1997-03-16  Woody  remove/reset bugs der Blueprint raus
*/

inherit "std/thing";

#include <properties.h>
#include "../files.h"

int nachgedacht;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Etwas");
  SetProp (P_LONG, "Etwas seltsames. Was kann man bloss damit machen?\n");
  SetProp (P_NAME, "Etwas");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_ARTICLE, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 0);
  SetProp (P_NOSELL, "Nein, verkaufen kannst Du es nicht.\n");
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MATERIAL, MAT_MISC_SOLID);
  SetProp (P_INFO, bs(
    "Etwas ist etwas Seltsames, offenbar auch etwas Besonderes. Und "
    "wenn Du nachdenkst, faellt Dir bestimmt ein, was Du damit "
    "machen koenntest..."));
  AddId (({"etwas", "was"}));
}

init()
{
  ::init();
  if (environment()==this_player()) {
    add_action ("nein", "iss");
    add_action ("nein", "trink");
    add_action ("nein", "trinke");
    add_action ("denk", "denk");
    add_action ("denk", "denke");
    add_action ("zerleg", "zerleg");
    add_action ("zerleg", "zerlege");
  }
}

nein(string str)
{
  if (!id(str)) return 0;
  write ("Nein, denk doch mal nach, das kannst Du mit Etwas nicht machen!\n");
  return 1;
}

denk(string str)
{
  if (str && (str != "nach") && (str != "drueber nach")) return 0;
  write ("Du denkst nach... und kommst auf die Idee, Etwas zu zerlegen.\n");
  nachgedacht++;
  return 1;
}

zerleg(string str)
{
  if (!id(str)) return 0;
  if (!nachgedacht)
    return write("Bevor man was tut, sollte man drueber nachdenken!\n"), 1;
  write ("Du zerlegst Etwas in seine Bestandteile.\n");
  call_out ("remove", 5);
  return 1;
}

remove(int flag)
{
  if (flag || !is_clone(ME)) return ::remove();
  if (!(TP && (TP==MENV) && TP->FindPotion(bs(
      "Etwas verschwindet. Dafuer ueberkommt Dich etwas anderes, "
      "naemlich ein seltsames Gefuehl... als ob irgendwas Grossartiges "
      "passieren wuerde...")+"\n")))
    write ("Etwas verschwindet. Du bist erleichtert.\n");
  return ::remove();
}

reset()
{
  ::reset();
  if (!is_clone(ME)) return;
  if (!MENV || !query_once_interactive(MENV)) remove(1);
}

