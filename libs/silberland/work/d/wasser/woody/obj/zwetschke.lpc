/*
** Eine Zwetschke
** September 97, Woody
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Zwetschke");
  SetProp (P_LONG, "Eine blaue Zwetschke, sie scheint reif zu sein.\n");
  SetProp (P_NAME, "Zwetschke");
  SetProp (P_GENDER, FEMALE);
  AddId( ({"zwetschke","pflaume"}) );
  AddId("\nobst");
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 40+random(10));
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:2+random(2), F_SOAK:1,
           F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du verzehrst genuesslich eine Zwetschke.\n");
  say (CAP_TPN+" verzehrt genuesslich eine Zwetschke.\n");
  return ::BeimEssen();
}

