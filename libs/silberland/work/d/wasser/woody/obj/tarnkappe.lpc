/*
** Tarnkappe (unsichtbar :))
** ---
** (w) 1997-02-22  Woody
** 27.01.99  Woody  P_QUALITY_DECAY auf 0 gesetzt
**
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"kappe", "tarnkappe", "\ntarnkappe"}));
  SetProp (P_SHORT, 0);
  SetProp (P_LONG, "Du siehst keine Tarnkappe.\n");
  SetProp (P_NAME, "Tarnkappe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 500);
  SetProp (P_MAGIC, 1);
  SetProp (P_NOBUY, 1);
  SetProp (P_INFO,
      "Die Tarnkappe ist unsichtbar, Du bist es leider nicht...\n");

  SetProp (P_QUALITY_DECAY, 0);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);  // siehe sys/combat.h
  SetProp (P_AC, 8);

  SetProp (P_MATERIAL, MAT_AIR);
}
