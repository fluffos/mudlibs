/*
** Eine Himbeere
** September 97, Woody
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

int wurm=0;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  if (random(100) < 25) wurm=1;
  SetProp (P_SHORT, "Eine Himbeere");
  SetProp (P_LONG, "Eine leuchtend rote Himbeere. Mmmmmmh... nur "
      "was Wuermer angeht, sollte man vorsichtig sein, die verstecken "
      "sich gerne in Himbeeren.");
  SetProp (P_NAME, "Himbeere");
  SetProp (P_GENDER, FEMALE);
  AddId( ({"himbeere","beere"}) );
  AddId("\nobst");
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 20+random(10));
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  if (wurm) {
    SetProp (P_INFO,
        "VORSICHT !!! In dieser Himbeere ist offenbar ein Wurm!\n");
    SetProp (P_FOOD_INFO, ([F_HEAL:-5+random(3), F_SOAK:3,
             F_ALCOHOL:0, F_POISON:0]));
  } else {
    SetProp (P_FOOD_INFO, ([F_HEAL:3+random(2), F_SOAK:1,
             F_ALCOHOL:0, F_POISON:0]));
  }
}

BeimEssen()
{
  if (wurm) {
    write (bs("Du verzehrst genuesslich eine Himbeere... aber was ist das? "
        "das schmeckt seltsam... IGITT !! Du hast einen Wurm erwischt! "
        "Schnell spuckst Du die Reste wieder aus..."));
    say (CAP_TPN+
        " verzehrt eine Himbeere - und spuckt sie auf einmal wieder aus!\n");
  } else {
    write ("Du verzehrst genuesslich eine Himbeere. War das gut!\n");
    say (CAP_TPN+" verzehrt genuesslich eine Himbeere.\n");
  }
  return ::BeimEssen();
}
