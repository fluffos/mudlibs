/*
 * Eine Vase, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

#define ROOM(x) FISCHERDORF("room/"+x)

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ( ({ "vase", VASE_ID }) );
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Eine Vase");
  SetProp (P_LONG,
    "Ein wunderschoene Vase, die wohl von Zwergenhand gefertigt wurde.\n"
    "Sie ist sorgfaeltig mit einem Linienmuster bemalt worden.\n"
    "@@content@@\n");
  SetProp (P_NAME, "Vase");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 500);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_INFO, "In eine Vase kann man Blumen reingeben.\n");
  SetProp (P_MATERIAL, MAT_CERAMIC);
  Set (P_CONTAINS, CONTAINS_NOTHING);
  Set (P_CONTAINS, PROTECTED, F_MODE_AS);
  AddDetail ( ({"linienmuster","muster","linien"}), 
    "Die Linien folgen einem sehr einfachen, aber schoenen Muster.\n");
  AddCmd (({"gib", "steck", "stecke", "lege", "leg"}), "gib");
  AddCmd ( ({"befuell","befuelle","fuell","fuelle"}), "fuelle" );
}

string _set_contains(string what)
{
  if (getuid(previous_object(1))==getuid()) Set(P_CONTAINS, what);
  return Query(P_CONTAINS);
}

string content()
{
  switch (QueryProp(P_CONTAINS))
  {
    case CONTAINS_NOTHING: return "Sie ist momentan leer.";
    case CONTAINS_WATER: return "Sie ist mit klarem Wasser gefuellt.";
    case CONTAINS_FLOWERS: return "Sie enthaelt einen bunten Blumenstrauss.";
    default: return "Du hast keine Ahnung, womit sie gefuellt ist.";
  }
}

int gib(string str)
{
  string s1,s2;
  object ob;
  notify_fail ("WAS willst Du WO reingeben?\n");
  if (!str) return 0;
  if (sscanf(str, "%s in %s", s1, s2) != 2) return 0;
  if (s2[<5..]==" rein") s2=s2[0..<6];
  if (s2[<7..]==" hinein") s2=s2[0..<8];
  if (id(s2) && member(({"blume","blumen","blumenstrauss","strauss"}),s1)!=-1)
  {
    if (QueryProp(P_CONTAINS)==CONTAINS_FLOWERS)
      write ("Aber da sind doch schon wunderschoene Blumen in der Vase!\n");
    else if (!ob=present(BLUMEN_ID,TP))
      write ("Aber Du hast noch gar keinen passenden Blumenstrauss!\n");
    else if (QueryProp(P_CONTAINS)!=CONTAINS_WATER)
      write (bs("Du solltest die Vase erstmal mit etwas Wasser fuellen, "
        "sonst wird Dein Blumenstrauss nicht allzulange leben..."));
    else {
      write ("Du steckst Deinen Blumenstrauss in die Vase.\n");
      say (CAP_TPN+" steckt einen Blumenstrauss in eine Vase.\n");
      ob->remove();
      SetProp (P_CONTAINS, CONTAINS_FLOWERS);
      SetProp (P_SHORT, "Eine Vase mit einem Blumenstrauss");
      SetProp (P_INFO, "Die Vase koennte man auf einen Tisch stellen.\n");
      AddDetail ( ({"blumen","blumenstrauss"}),
        "Der Blumenstrauss in der Vase blueht bunt in den "
        "praechtigsten Farben.");
      SetProp (P_SMELL, "Der Blumenstrauss in der Vase duftet herrlich.\n");
    }
    return 1;
  }
  else return 0;
}

int fuelle(string str)
{
  object e;
  string was,womit;

  if (!TP || !(e=ENV(TP))) return 0;
  if (file_name(e) == ROOM("hinterhof")) return 0; // erledigt alles der Raum
  notify_fail ("WAS willst Du WOMIT fuellen?\n");
  if (!str) return 0;
  if (sscanf(str, "%s mit %s", was, womit) != 2) return 0;
  notify_fail ("Das kannst Du nicht fuellen.\n");
  if (!id(was)) return 0;
  if (womit != "wasser")
    write("Damit kannst Du die Vase hier nicht fuellen.\n");
  else if ((QueryProp(P_CONTAINS)==CONTAINS_FLOWERS) ||
      (QueryProp(P_CONTAINS)==CONTAINS_WATER))
    write("Aber da ist doch schon genug Wasser in der Vase!\n"), 1;
  else if (member(e->QueryProp(P_DETAILS), "meer") &&
           member(e->QueryProp(P_DETAILS), "wasser"))
  {
    write (
      bs("Als Du ueberlegst, wozu Du das Wasser ueberhaupt brauchst, wird "
         "Dir ploetzlich sonnenklar, dass das salzige Meerwasser das letzte "
         "ist, was Du fuer Dein Unternehmen brauchen kannst. Du verwirfst "
         "den Gedanken daher schnell wieder. Vielleicht solltest Du Dich "
         "nach Suesswasser umsehen?"));
  }
  else
    write("Damit kannst Du die Vase hier nicht fuellen.\n");
  return 1;
}

