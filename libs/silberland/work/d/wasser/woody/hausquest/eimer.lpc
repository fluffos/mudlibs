/*
 * Ein Eimer, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"

#define ROOM(x) FISCHERDORF("room/"+x)

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ( ({ "eimer", EIMER_ID }) );
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Ein @@gefuellt@@ Eimer");
  SetProp (P_LONG,
    "Ein weisser Eimer, den man mit allem moeglichen fuellen kann.\n"
    "Sicher kannst Du fuer ihn Verwendung finden.\n@@content@@\n");
  SetProp (P_NAME, "Eimer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 500);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_INFO,
    "Einen Eimer kann man zum Beispiel mit Wasser oder Farbe fuellen...\n");
  SetProp (P_MATERIAL, MAT_IRON);
  Set (P_CONTAINS, CONTAINS_NOTHING);
  Set (P_CONTAINS, PROTECTED, F_MODE_AS);
  AddCmd ( ({"befuell","befuelle","fuell","fuelle"}), "fuelle" );
}

string gefuellt()
{
  switch (QueryProp(P_CONTAINS))
  {
    case CONTAINS_NOTHING: return "leerer";
    case CONTAINS_WATER: return "mit Wasser gefuellter";
    case CONTAINS_COLOR: return "mit weisser Farbe gefuellter";
    case CONTAINS_COLOR_R: return "von Farbresten durchsetzter";
    default: return "mit etwas Unbekanntem";
  }
}

string _set_contains(string what)
{
  if (getuid(previous_object(1))==getuid()) Set(P_CONTAINS, what);
  return Query(P_CONTAINS);
}

string content()
{
  switch (QueryProp(P_CONTAINS))
  {
    case CONTAINS_NOTHING: return "Er ist momentan leer.";
    case CONTAINS_WATER: return "Er ist mit klarem Wasser gefuellt.";
    case CONTAINS_COLOR: return "Er ist mit weisser Farbe gefuellt.";
    case CONTAINS_COLOR_R: return "Er ist voller Farbreste.";
    default: return "Du hast keine Ahnung, womit er gefuellt ist.";
  }
}

int fuelle(string str)
{
  object e;
  string was,womit;

  if (!TP || !(e=ENV(TP))) return 0;
  if (file_name(e) == ROOM("hinterhof")) return 0; // erledigt alles der Raum
  notify_fail ("WAS willst Du WOMIT fuellen?\n");
  if (!str) return 0;
  if (sscanf(str, "%s mit %s", was, womit) != 2) return 0;
  notify_fail ("Das kannst Du nicht fuellen.\n");
  if (!id(was)) return 0;
  if (womit != "wasser")
    write("Damit kannst Du den Eimer hier nicht fuellen.\n");
  else if (QueryProp(P_CONTAINS)==CONTAINS_WATER)
    write("Aber da ist doch schon genug Wasser im Eimer!\n");
  else if (member(e->QueryProp(P_DETAILS), "meer") &&
           member(e->QueryProp(P_DETAILS), "wasser"))
  {
    write (
      bs("Als Du ueberlegst, wozu Du das Wasser ueberhaupt brauchst, wird "
         "Dir ploetzlich sonnenklar, dass das salzige Meerwasser das letzte "
         "ist, was Du fuer Dein Unternehmen brauchen kannst. Du verwirfst "
         "den Gedanken daher schnell wieder. Vielleicht solltest Du Dich "
         "nach Suesswasser umsehen?"));
  }
  else
    write("Damit kannst Du den Eimer hier nicht fuellen.\n");
  return 1;
}

