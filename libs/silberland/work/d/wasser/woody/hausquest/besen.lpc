/*
** Ein Besen
** ---
*/

inherit "std/thing";

#include <properties.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId (({ "besen", BESEN_ID }));
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Ein Besen");
  SetProp (P_LONG, "Dieser Besen eignet sich prima zum staubkehren.\n");
  SetProp (P_NAME, "Besen");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 300);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_MATERIAL, ([MAT_MISC_WOOD:90,MAT_STRAW:10]) );
}
