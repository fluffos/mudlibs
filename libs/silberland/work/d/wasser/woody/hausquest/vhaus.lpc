#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/hausquest/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:22]));
  SetProp (P_INT_SHORT, "In einem Haus");
  SetProp (P_INT_LONG,
    "Du befindest Dich in einem netten kleinen Haeuschen, das einen sehr "+
    "sauberen und gepflegten Eindruck macht. Die Sonne strahlt durch die "+
    "klaren Fensterscheiben und erleuchtet durch die hellweissen "+
    "Vorhaenge das Hausinnere. Mitten im Raum steht ein grosser Tisch, "+
    "rund um ihn wurden ein paar Stuehle aufgestellt. Auf dem Tisch steht "+
    "eine schoene Vase mit einem duftenden Blumenstrauss. In einer Ecke "+
    "entdeckst Du etwas Geruempel, das aber offenbar hierher gehoert.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"licht", "sonne"}),
    "Die Sonne scheint draussen hell und bringt etwas Licht ins "+
    "Hausinnere.");
  AddDetail ( ({"fenster", "fensterscheiben", "scheiben"}),
    "Die Fenster sind blitzblank geputzt und geschlossen.");
  AddDetail ( ({"vorhaenge", "vorhang"}),
    "Die Vorhaenge bestehen aus einem weissen, leicht glaenzenden Stoff.");
  AddDetail ( ({"stoff"}),
    "Der weisse Stoff der Vorhaenge muss einmal sehr teuer gewesen sein.");
  AddDetail ( ({"haeuschen", "haus", "hausinneres", "raum"}),
    "Du stehst mittendrin.");
  AddDetail ( ({"sessel", "stuehle", "stuhl", 
                "tisch"}),
    "Ein grosser Tisch steht mitten im Raum, um ihn herum wurden einige "+
    "Stuehle plaziert. Auf ihm steht eine Vase mit ein paar wunderschoenen "+
    "Blumen.");
  AddDetail ( ({"vase"}),
    "Die schoene Vase mit den Blumen auf dem Tisch macht sich wirklich "+
    "huebsch. Du erkennst, dass sie aus zwergischer Herstellung stammt, "+
    "niemand sonst kann so sauber gearbeitete Vasen herstellen.");
  AddDetail ( ({"blumen", "blumenstrauss", "strauss"}),
    "Der bunte Blumenstrauss in der Vase ziert den Tisch.");
  AddDetail ( ({"boden"}),
    "Der Boden ist blitzblank, Du kannst kaum ein Staubkoernchen "+
    "entdecken.");
  AddDetail ( ({"decke"}),
    "Auch die Decke ist in weisser Farbe gehalten. Hier hat sie sogar noch "+
    "recht gut gehalten. Nur ab und zu siehst du ein paar schwarze Flecken.");
  AddDetail ( ({"flecken"}),
    "Komisch sehen die schwarzen Flecken auf weisser Farbe aus. Ein Fleck "+
    "ist besonders gross.");
  AddDetail ( ({"fleck"}),
    "Um diesen Fleck ist ein Viereck gezogen, was das wohl fuer eine "+
    "Bedeutung hat?");
  AddDetail ( ({"bedeutung", "falltuer", "falltuere", 
                "griff", "viereck"}),
    "Dieses Viereck koennte eine Falltuere zum Dachboden sein. Der "+
    "schwarze Fleck ist dann wohl der Griff zum Oeffnen. Du erinnerst Dich "+
    "noch, wie Du da oben warst, und verzichtest freiwillig darauf, diese "+
    "Erfahrung ein zweites Mal zu machen.");
  AddDetail ( ({"erfahrung", "heimwerker"}),
    "Seit Du dieses Haus renoviert hast, fuehlst Du Dich zumindest als "+
    "Heimwerker viel erfahrener.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende wurden kuerzlich frisch gestrichen, sie strahlen Dich "+
    "weiss an. An einer der Waende wurde ein Bild aufgehaengt.");
  AddDetail ( ({"bild", "maedchen", "tochter"}),
    "An einer der Waende haengt ein Bild in einem einfachen Holzrahmen, "+
    "das ein kleines Maedchen zeigt, vermutlich Verians Tochter.");
  AddDetail ( ({"verian"}),
    "Ihm gehoert das Haus, in dem Du stehst.");
  AddDetail ( ({"holzrahmen"}),
    "Ein einfacher Holzrahmen, nichts Besonderes.");
  AddDetail ( ({"ecke"}),
    "In der Ecke liegt viel Geruempel.");
  AddDetail ( ({"ecken"}),
    "In einer der Ecken liegt viel Geruempel.");
  AddDetail ( ({"geruempel"}),
    "Du kannst drei schwere Kisten erkennen.");
  AddDetail ( ({"kisten"}),
    "Die drei Kisten in der Ecke sind allesamt verschlossen.");
  AddDetail ( ({"dachboden"}),
    "Da gelangst Du nicht mehr hin.");
  AddDetail ( ({"eindruck"}),
    "Der Eindruck, der sich Dir bietet, ist ein wirklich netter.");
  AddDetail ( ({"farbe"}),
    "Die Farbe an den Waenden und der Decke ist strahlen weiss.");
  AddDetail ( ({"herstellung", "zwerge"}),
    "Ja, nur Zwerge koennen wohl so eine schoene Vase herstellen.");
  AddDetail ( ({"staubkoernchen"}),
    "Du kannst wie gesagt kein einziges entdecken.");
  AddDetail ( ({"kiste"}),
    "Jede der Kisten ist verschlossen.");
  // DETAILS END

  // EXITS START
  AddExit ("raus", ROOM("vhausu"));
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"oeffne", "schliesse", "schliess", "kehr", "kehre",
             "naeh", "naehe", "flick", "flicke", "kletter", "klettere",
             "befestige", "repariere", "reinige", "stell", "stelle",
             "streich", "streiche", "haeng", "haenge"}), "nogo" );

}

int nogo()
{
  write ("Hier kannst Du nichts mehr tun.\n");
  return 1;
}
