/*
 * Nadel und Faden, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ( ({ "nadel", "faden", "nadel und faden", NADELFADEN_ID }) );
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Nadel und Faden");
  SetProp (P_LONG,
    "Eine ganz normale Nadel und ein helles Stueck Faden. Bestimmt kannst "
    "Du damit etwas naehen oder flicken.");
  SetProp (P_NAME, "Nadel und Faden");
  SetProp (P_ARTICLE, 0);
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 20);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_INFO, "Der Faden eignet sich ideal zum Naehen von Vorhaengen.\n");
  SetProp (P_MATERIAL, ([MAT_WOOL:80,MAT_MISC_METAL:20]) );
}
