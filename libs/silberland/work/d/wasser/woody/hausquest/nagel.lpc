/*
 * Ein Nagel (oder mehrere), Woody
 * (fuer Hausquest)
 *
 */

inherit "std/unit";

#include <properties.h>
#include <language.h>
#include "files.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp (P_NAME, ({"Nagel","Naegel"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_LONG, "Mit Naegeln kann man - Hammer vorausgesetzt - "
    "lose Dinge befestigen.");
  SetProp (P_MATERIAL, MAT_IRON);
  AddSingularId ("nagel");
  AddPluralId ("naegel");
  AddId (NAGEL_ID);
  AddId (Q_ITEM_ID);
  SetCoinsPerUnits (0,1);
  SetGramsPerUnits (1,20);
}
