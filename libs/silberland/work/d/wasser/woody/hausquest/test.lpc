#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/hausquest/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Startraum");
  SetProp (P_INT_LONG, "Du befindest Dich unmittelbar vor einigen "
    "Haeusern, von denen Dir eines besonders ins Auge sticht. Vielleicht "
    "solltest Du etwas naeher rangehen, um zu erkennen, was es mit dem "
    "Haus auf sich hat? Geh einfach los...");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddSpecialExit ("los", "los");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

int los()
{
  TP->move(QDIR("vhausu:"+getuid(TP)), M_GO, "weiter");
  return 1;
}
