/*
 * Ein Tuch, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/thing";

#include <properties.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId (({"tuch", "fetzen", TUCH_ID}));
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Ein Tuch");
  SetProp (P_LONG, "Dieses Tuch eignet sich bestimmt gut zum Putzen.\n");
  SetProp (P_NAME, "Tuch");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 20);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_MATERIAL, MAT_CLOTH);
}
