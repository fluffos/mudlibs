/*
 * Ein Bild, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ( ({ "bild", BILD_ID }) );
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Ein Bild");
  SetProp (P_LONG,
    "Das Bild zeigt ein kleines Maedchen, vermutlich Verians Tochter. "
    "Es ist in einen einfachen Holzrahmen eingesetzt, an dessen "
    "Rueckseite ein kleiner Haken angebracht ist, an dem man das "
    "Bild aufhaengen koennte.");
  SetProp (P_NAME, "Bild");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 250);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_MATERIAL, ([ MAT_WOOD:30,MAT_PAPER:70]) );
}
