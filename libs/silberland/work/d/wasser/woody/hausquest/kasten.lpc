/*
 * Ein Kasten, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/container";

#include <properties.h>
#include <container.h>
#include <moving.h>
#include "files.h"

object hammer;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId ( ({ "kasten", "werkzeugkasten", KASTEN_ID }) );
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Ein Kasten");
  SetProp (P_LONG, "Der Kasten sieht aus wie ein Werkzeugkasten.\n");
  SetProp (P_NAME, "Kasten");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 2000);
  SetProp(P_MAX_WEIGHT, 5000);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_NOGET, "Du kannst den Kasten nicht mitnehmen.\n");
  SetProp (P_CNT_STATUS, CNT_STATUS_CLOSED);
  SetProp (P_MATERIAL, MAT_MISC_WOOD);
  hammer=clone_object(QDIR("hammer"));
  hammer->move(ME, M_NOCHECK);
  AddCmd ( "oeffne", "oeffne" );
  AddCmd ( ({"schliess","schliesse"}), "schliesse" );
}

reset()
{
  ::reset();
  if (objectp(hammer)) return;
  hammer=clone_object(QDIR("hammer"));
  hammer->move(ME, M_NOCHECK);
}

int _query_transparent()
{
  return Query(P_CNT_STATUS)==CNT_STATUS_OPEN;
}

int oeffne(string str)
{
  if (!str) return 0;
  if (!id(str)) return 0;
  if (QueryProp(P_CNT_STATUS) == CNT_STATUS_OPEN)
    return write ("Aber "+name(WER)+" ist doch schon offen!\n"), 1;
  write ("Du oeffnest "+name(WEN)+".\n");
  say (CAP_TPN+" oeffnet "+name(WEN)+".\n");
  SetProp (P_CNT_STATUS, CNT_STATUS_OPEN);
  return 1;
}

int schliesse(string str)
{
  if (!str) return 0;
  if (!id(str)) return 0;
  if (QueryProp(P_CNT_STATUS) != CNT_STATUS_OPEN)
    return write ("Aber "+name(WER)+" ist doch gar nicht offen!\n"), 1;
  write ("Du schliesst "+name(WEN)+".\n");
  say (CAP_TPN+" schliesst "+name(WEN)+".\n");
  SetProp (P_CNT_STATUS, CNT_STATUS_CLOSED);
  return 1;
}

