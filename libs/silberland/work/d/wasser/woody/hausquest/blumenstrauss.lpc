/*
 * Ein Blumenstrauss, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "files.h"

object owner;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ( ({ "blumen", "blumenstrauss", "strauss", BLUMEN_ID }) );
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Ein bunter Blumenstrauss");
  SetProp (P_LONG,
    "Du erblickst einen wunderschoenen, bunten Blumenstrauss, der sich "
    "in einer Vase vermutlich noch viel besser machen wuerde. Du solltest "
    "Dich jedoch beeilen, ihn in eine Vase mit Wasser zu bringen, sonst "
    "verwelken die Blumen sicherlich bald!");
  SetProp (P_NAME, "Blumenstrauss");
  SetProp (P_SMELL, "Die Blumen duften wundervoll.\n");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_INFO,
    "Der Blumenstrauss wuerde sich auf einem Tisch sicherlich gut machen.\n");
  SetProp (P_MATERIAL, MAT_PLANT);
  call_out ("verwelken", 600);
}

verwelken()
{
  object qo;
  if (MENV)
  {
    if (ENV(MENV) && living(ENV(MENV))) {
      tell_object (ENV(MENV),
        "Der Blumenstrauss in D"+MENV->name(WEM)+" verwelkt und zerfaellt.\n");
      if (!owner) owner=ENV(MENV);
    }
    else if (living(MENV)) {
      tell_object (MENV, "Der Blumenstrauss verwelkt und zerfaellt.\n");
      if (!owner) owner=MENV;
    }
    else
      tell_room (MENV, "Der Blumenstrauss verwelkt und zerfaellt.\n");
  }
  if (owner && (qo=present(QO_ID,owner)))
    qo->SetFlag(F_FINDET_BLUMEN);
  remove();
}

SetOwner(pl)
{
  owner=pl;
}
