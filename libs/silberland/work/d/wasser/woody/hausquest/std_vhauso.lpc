
/*
** Standard-Objekt fuer virtuellen Compiler fuer verwahrlostes Haus, oben
** ---
** 17 Feb 1997  Woody
*/

inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "files.h"

private object qo;
private nosave int bild, eimer, pinsel;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_INT_LONG,
    "Du bist nun heil und gluecklich auf dem Dachboden angekommen. Hier "
    "oben liegt allerlei herum. Geraete, alte Stuehle, Decken, eine Kiste "
    "und viel Staub. Es ist ziemlich stickig hier oben, wohl weil die Sonne "
    "das Dach im Laufe des Tages ziemlich erwaermt.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:23]));
  SetProp(P_INT_SHORT, "Auf einem Dachboden");

  AddDetail ( ({"dachboden"}),
    "Da befindest Du Dich gerade.");
  AddDetail ( ({"angel", "angelhaken", "haken"}),
    "Angel und Angelhaken sind schon sehr alt, Du laesst sie wohl besser "+
    "hier.");
  AddDetail ( ({"verwendung"}),
    "Ueberleg mal, wofuer Du ihn hier brauchen koenntest!");
  AddDetail ( ({"stuehle", "stuhl"}),
    "Diese Stuehle hier sind kaputt, deswegen sind sie wohl auch hier "+
    "oben.");
  AddDetail ( ({"decken", "stoffdecken"}),
    "Einfache Stoffdecken!");
  AddDetail ( ({"staub"}),
    "Auch hier liegt viel Staub herum.");
  AddDetail ( ({"boden"}),
    "Auf dem Boden liegt viel Staub, wie auf jedem Dachboden, das ist "+
    "nicht weiter tragisch.");
  AddDetail ( ({"decke"}),
    "Nichts Besonderes hier zu sehen.");
  AddDetail ( ({"waende"}),
    "Wo willst Du die am Dachboden herbekommen? Hier ist nur das Dach.");
  AddDetail ( ({"dach"}),
    "Wieso heisst der Dachboden wohl Dachboden?");

  AddSpecialDetail ( ({"geraete"}),
    "d_geraete");
  AddSpecialDetail ( ({"eimer"}),
    "d_eimer");
  AddSpecialDetail ( ({"kiste"}),
    "d_kiste");
  AddSpecialDetail ( ({"pinsel"}),
    "d_pinsel");
  AddSpecialDetail ( ({"bild", "maedchen", "tochter"}),
    "d_bild");

  AddCmd ("nimm", "nimm");
  AddCmd ( ({"kehr", "kehre"}), "kehre" );

  bild=eimer=pinsel=1;

  previous_object()->CustomizeObject();
}

reset()
{
  ::reset();
  bild=eimer=pinsel=1;
}

int FindQuestObject()
{
  if (objectp(qo)) return 1;    // no need to find one...
  if (explode(file_name(ME),":")[<1] == getuid(TP))
    if ((qo=present(QO_ID,TP)) && (getuid(qo)==getuid()))
      return 1;
  return 0;
}

init()
{
  ::init();
  write ("Du kletterst vorsichtig zum Dachboden hoch.\n");
  if (!query_once_interactive(TP)) return;
  if (explode(file_name(ME),":")[<1] != getuid(TP)) return;
  if (!FindQuestObject())
    call_out ("fliegraus", 0);
}

void fliegraus()
{
  if (!present(TP)) return;
  write (
   "\nDoch ploetzlich ueberkommt Dich ein seltsames Gefuehl...\n\n"
   "Eine fremde Macht ergreift Dich und schleudert Dich wieder "
   "hinunter.\n\n\n");
  TP->move(QDIR("vhaus:"+explode(file_name(ME), ":")[<1]), M_GO,
      "", "wird von einer fremden Macht hinuntergeschleudert",
      "wird von einer fremden Macht hereingeschleudert");
}

string d_geraete()
{
  qo->SetFlag(F_F_EIMER);
  return "Du findest eine Angel samt Angelhaken"+
    (eimer ? " und einen Eimer.\n" : ".\n");
}

string d_eimer()
{
  if (!qo->TestFlag(F_F_EIMER))
    return "Ja, hier ist ein Eimer, aber Du musst ihn erst entdecken!\n";
  else if (eimer)
    return bs("Unter anderem findest Du hier auch einen Eimer, in den "
      "man viel reingeben kann. Vielleicht hast Du ja Verwendung dafuer?");
  else
    return bs("Du siehst hier nirgends einen Eimer!\n");
}

string d_kiste()
{
  qo->SetFlag(F_F_PINSEL);
  qo->SetFlag(F_F_BILD);
  return bs("Die Kiste ist offen"+
    (!pinsel && !bild ? " und leer.\n" :
     (pinsel && bild ? ", drinnen liegen ein Pinsel und ein Bild." :
      ", drinnen liegt ein "+(pinsel ? "Pinsel." : "Bild."))));
}

string d_pinsel()
{
  if (!pinsel)
    return "Du siehst hier nirgends einen Pinsel!\n";
  else if (!qo->TestFlag(F_F_PINSEL))
    return "Ja, hier ist ein Pinsel, aber Du musst ihn erst entdecken!\n";
  else
    return "Kannst Du den nicht gut gebrauchen?\n";
}

string d_bild()
{
  if (!bild)
    return "Sowas siehst Du hier nirgends!\n";
  if (!qo->TestFlag(F_F_BILD))
    return "Ja, hier ist ein Bild, aber Du musst es erst entdecken!\n";
  else
    return bs("Es zeigt ein kleines Maedchen. Wohl die Tochter der Bewohner "
      "des Hauses. Du fragst Dich, ob es wohl nicht besser waere, wenn es "
      "unten hinge, statt hier oben zu verstauben?");
}

int nimm(string str)
{
  object ob;
  if (!str) return 0;
  if (str=="eimer") {
    if (!eimer)
      write ("Da ist momentan kein Eimer, den Du nehmen kannst!\n");
    else if (present(EIMER_ID, TP))
      write ("Aber Du hast doch bereits einen Eimer!\n");
    else if (!qo->TestFlag(F_F_EIMER))
      write ("Bevor Du den Eimer nimmst, solltest Du ihn erst entdecken!\n");
    else {
      write ("Du nimmst einen Eimer.\n");
      say (CAP_TPN+" nimmt einen Eimer.\n");
      CLONETPNOCHK(QDIR("eimer"));
      eimer = 0;
    }
    return 1;
  }
  else if (str=="pinsel" || str=="pinsel aus kiste")
  {
    if (!pinsel)
      write ("Da ist momentan kein Pinsel, den Du nehmen kannst!\n");
    else if (present(PINSEL_ID, TP))
      write ("Aber Du hast doch bereits einen Pinsel!\n");
    else if (!qo->TestFlag(F_F_PINSEL))
      write ("Bevor Du den Pinsel nimmst, solltest Du ihn erst entdecken!\n");
    else {
      write ("Du nimmst einen Pinsel.\n");
      say (CAP_TPN+" nimmt einen Pinsel.\n");
      CLONETPNOCHK(QDIR("pinsel"));
      pinsel = 0;
    }
    return 1;
  }
  else if (str=="bild" || str=="bild aus kiste")
  {
    if (!bild)
      write ("Da ist momentan kein Bild, das Du nehmen kannst!\n");
    else if (!qo->TestFlag(F_F_BILD))
      write ("Bevor Du das Bild nimmst, solltest Du es erst entdecken!\n");
    else if (present(BILD_ID, TP) || qo->TestFlag(F_BILD))
      write ("Du benoetigst kein weiteres Bild.\n");
    else {
      write ("Du nimmst ein Bild.\n");
      say (CAP_TPN+" nimmt ein Bild.\n");
      CLONETPNOCHK(QDIR("bild"));
      bild = 0;
    }
    return 1;
  }
  else return 0;
}

int kehre (string str)
{
  object ob;
  notify_fail ("Was willst Du kehren?\n");
  if (!str) return 0;
  if (str!="boden" && str!="staub") return 0;
  if (!ob=present(BESEN_ID, TP))
    write ("Dazu solltest Du einen passenden Besen haben.\n");
  else {
    write ("Du kehrst ein wenig mit Deinem Besen, wirbelst aber "
        "nur noch mehr Staub auf.\n");
    say (CAP_TPN+" wirbelt etwas Staub mit einem Besen auf.\n");
  }
  return 1;
}

