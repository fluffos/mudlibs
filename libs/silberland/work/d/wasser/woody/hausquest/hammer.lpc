/*
 * Ein Hammer, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ( ({ "hammer", HAMMER_ID }) );
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Ein Hammer");
  SetProp (P_LONG,
    "Ein herkoemmlicher Hammer, wie er Jahr fuer Jahr zu verschiedensten "
    "Anlaessen vor allem in Zwergenfamilien verschenkt wird. Damit kannst "
    "Du sicher prima rumhaemmern.");
  SetProp (P_NAME, "Hammer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_INFO, "Am besten funktionieren Haemmer bei Naegeln.\n");
  SetProp (P_MATERIAL, ([MAT_WOOD:35,MAT_IRON:65]) );
}
