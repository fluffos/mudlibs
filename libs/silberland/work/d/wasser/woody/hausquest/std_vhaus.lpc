
/*
** Standard-Objekt fuer virtuellen Compiler fuer verwahrlostes Haus
** ---
** 17 Feb 1997  Woody
** 30 Mar 1997  Woody  Raumtext beim Wandstreichen korrigiert
*/

inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "files.h"

private object qo;

private nosave int fensteroffen, besen, nagel, tuch, leiterrauf;
private nosave int *kisteoffen;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:22]));
  SetProp(P_INT_SHORT, "In einem Haus");

  // Details...

  AddDetail ( ({"haeuschen", "haus", "huette"}),
    "Du stehst mittendrin, schau Dich mal ein wenig um!");
  AddDetail ( ({"einzelheiten", "durcheinander", "rest"}),
    "Sieh Dich doch einfach einmal etwas genauer um!\n");
  AddDetail ( ({"meerwasser", "wasser"}),
    "Meerwasser ist bestimmt nicht zum Putzen geeignet, aber wo kann man "+
    "bloss anderes Wasser herbekommen...?");
  AddDetail ( ({"eimer", "faden", "farbe", 
                "nadel", "pinsel", "putzlappen",
                "hammer", "nagel"}),
    "Das musst Du schon selber suchen!");
  AddDetail ( ({"decke"}),
    "Auch die Decke ist in weisser Farbe gehalten. Hier hat sie sogar noch "+
    "recht gut gehalten. Nur ab und zu siehst du ein paar schwarze Flecken.");
  AddDetail ( ({"flecken"}),
    "Komisch sehen die schwarzen Flecken auf weisser Farbe aus. Ein Fleck "+
    "ist besonders gross.");
  AddDetail ( ({"fleck"}),
    "Um diesen Fleck ist ein Viereck gezogen, was das wohl fuer eine "+
    "Bedeutung hat?");
  AddDetail ( ({"bedeutung", "falltuer", "falltuere", "griff", "viereck"}),
    "Dieses Viereck koennte eine Falltuere zum Dachboden sein. Der "+
    "schwarze Fleck ist dann wohl der Griff zum Oeffnen. Nur wie sollst Du "+
    "dort hinauf gelangen?");
  AddDetail ( ({"dachboden"}),
    "Die Falltuere siehst Du ja, nur wie kannst Du dort hinauf?");
  AddDetail ( ({"anstrich"}),
    "Fuer einen neuen Anstrich benoetigst Du Farbe und Pinsel.");
  AddDetail ( ({"ecke"}),
    "In der Ecke liegt viel Geruempel.");
  AddDetail ( ({"geruempel"}),
    "Hier liegt einiges herum. Du siehst drei schwere Kisten und dahinter "+
    "einen Stiel hervorragen.");
  AddDetail ( ({"toepferei"}),
    "In der Zwergenstadt Felonia soll es eine geben, sagt man.");
  AddDetail ( ({"felonia", "zwergenstadt", "gebirge"}),
    "Die Zwergenstadt Felonia liegt im Gebirge, ein ziemlicher Fussmarsch "
    "von hier, weit in den Norden des Landes...");
  AddDetail ( ({"stoff"}),
    "Der weisse Stoff der Vorhaenge muss einmal sehr teuer gewesen sein.");
  AddDetail ( ({"sonne", "licht"}),
    "Die Sonne scheint draussen hell und bringt etwas Licht ins "
    "Hausinnere.");

  AddDetail ( ({"kistne"}),
    "Kistne? Du meinst sicher Kisten!\n");
  AddDetail ( ({"kiste"}),
    "Welche Kiste? Hier gibt es drei Kisten.");

  AddDetail ( ({"kleider"}),
    "Die Kleider gehoerten wohl den Bewohnern dieses Hauses.");
  AddDetail ( ({"bewohner"}),
    "Sie haben das Haus so zurueckgelassen, wie Du es jetzt siehst.");
  AddDetail ( ({"stoffe"}),
    "Die Bewohner naehen hier ihre Kleider wohl selbst.");

  AddDetail ( ({"kleinkram"}),
    "Zeichnungen, kleine Stifte, Buecher... Kleinkram halt.");
  AddDetail ( ({"zeichnungen"}),
    "Es sind Zeichnungen eines kleinen Kindes.");
  AddDetail ( ({"kind"}),
    "Die Bewohner scheinen also ein Kind gehabt zu haben.");
  AddDetail ( ({"buch", "buecher"}),
    "Du findest ein Tagebuch und eine Bibel.");
  AddDetail ( ({"bibel"}),
    "Eine gewoehnliche, blau eingebundene Bibel, wie sie bei den "
    "Bewohnern des Dorfes sehr verbreitet ist.");
  AddDetail ( ({"tagebuch"}),
    "Komisch, nur leere Seiten, die beschriebenen scheinen herausgerissen "+
    "worden zu sein.");
  AddDetail ( ({"seiten"}),
    "Alle sind leer.");
  AddDetail ( ({"metall", "eisen"}),
    "Vermutlich gewoehnliches Eisen, nichts Besonderes.");

  // Special Details...

  AddSpecialDetail ( ({"staub", "staubkoernchen", "schmutz"}),
    "d_staub");
  AddSpecialDetail ( ({"anblick", "eindruck", "hausinneres", "inneres"}),
    "d_anblick");
  AddSpecialDetail ( ({"fensterladen", "fensterlaeden"}),
    "d_fensterladen");
  AddSpecialDetail ( ({"vorhang", "vorhaenge"}),
    "d_vorhaenge");
  AddSpecialDetail ( ({"fenster", "scheiben", "fensterscheiben"}),
    "d_fenster");
  AddSpecialDetail ( ({"wand", "waende"}),
    "d_waende");
  AddSpecialDetail ( ({"boden"}),
    "d_boden");
  AddSpecialDetail ( ({"stuehle", "stuhl", "tisch"}),
    "d_tisch");
  AddSpecialDetail ( ({"blume", "blumen"}),
    "d_blumen");
  AddSpecialDetail ( ({"scherbe", "scherben", "ueberreste"}),
    "d_scherben");
  AddSpecialDetail ( ({"vase"}),
    "d_vase");
  AddSpecialDetail ( ({"stiel"}),
    "d_stiel");
  AddSpecialDetail ( ({"besen"}),
    "d_besen");
  AddSpecialDetail ( ({"kisten"}),
    "d_kisten");
  AddSpecialDetail ( ({"erste kiste", "kiste 1"}),
    "d_kiste1");
  AddSpecialDetail ( ({"zweite kiste", "kiste 2"}),
    "d_kiste2");
  AddSpecialDetail ( ({"dritte kiste", "kiste 3"}),
    "d_kiste3");
  AddSpecialDetail ( ({"tuch"}),
    "d_tuch");
  AddSpecialDetail ( ({"putzen"}),
    "d_putzen");
  AddSpecialDetail ( ({"stift", "stifte"}),
    "d_stifte");
  AddSpecialDetail ( ({"nagel", "naegel"}),
    "d_nagel");
  AddSpecialDetail ( ({"werkzeugkasten", "kasten"}),
    "d_kasten");
  AddSpecialDetail ( ({"tuer"}),
    "d_tuer");
  AddSpecialDetail ( ({"leiter", "sprossen"}),
    "d_leiter");
  AddSpecialDetail ( ({"bild", "maedchen", "tochter", "holzrahmen"}),
    "d_bild");

  AddCmd ( ({"nimm"}), "nimm" );
  AddCmd ( ({"oeffne"}), "oeffne" );
  AddCmd ( ({"schliesse", "schliess"}), "schliesse" );
  AddCmd ( ({"kehr", "kehre"}), "kehre" );
  AddCmd ( ({"schuettel", "schuettle"}), "schuettel" );
  AddCmd ( ({"naeh", "naehe", "flick", "flicke"}), "naehe" );
  AddCmd ( ({"kletter", "klettere"}), "kletter" );
  AddCmd ( ({"befestige", "repariere"}), "befestige" );
  AddCmd ( ({"putz", "putze", "reinige"}), "putze" );
  AddCmd ( ({"stell", "stelle"}), "stelle" );
  AddCmd ( ({"streich", "streiche"}), "streiche" );
  AddCmd ( ({"haeng", "haenge"}), "haenge" );
  /*
  AddCmd ( ({"", ""}), "" );
  AddCmd ( ({"", ""}), "" );
  */

  AddSpecialExit ("raus", "raus");

  leiterrauf = fensteroffen = 0;
  kisteoffen = ({ 0, 0, 0, 0 });
  nagel=besen=tuch=1;

  previous_object()->CustomizeObject();
}

reset()
{
  nagel=besen=tuch=1;
}

int FindQuestObject()
{
  if (objectp(qo)) return 1;    // no need to find one...
  if (explode(file_name(ME),":")[<1] == getuid(TP))
    if ((qo=present(QO_ID,TP)) && (getuid(qo)==getuid()))
      return 1;
    return 0;
}

init()
{
  ::init();

  write ("Du betrittst vorsichtig das Haus.\n");

  // Erstmal checken, ob es sich hier ueberhaupt um den Clone
  // handelt, der fuer TP 'zustaendig' ist, oder ob es z.B. ein
  // verfolgender Magier (bzw. Haustier o.ae.) ist...
  //
  if (!query_once_interactive(TP)) return;
  if (explode(file_name(ME),":")[<1] != getuid(TP)) return;

  // Ist es tatsaechlich der Spieler, so setzen wir (so
  // vorhanden) qo auf das Questobjekt, andernfalls wird
  // der Spieler zurueck vor das Haus transportiert.
  //
  if (!FindQuestObject())
    call_out ("fliegraus", 0);
  /*
  else
    write ("Willkommen!\n");
  */
}

void fliegraus()
{
  if (!present(TP)) return;
  write (
   "\nDoch ploetzlich ueberkommt Dich ein seltsames Gefuehl...\n\n"
   "Eine fremde Macht ergreift Dich und schleudert Dich ganz "
   "woanders hin.\n\n\n");
  TP->move(QDIR("vhausu:"+explode(file_name(ME), ":")[<1]), M_GO,
      "", "wird von einer fremden Macht hinausgeschleudert",
      "wird von einer fremden Macht hereingeschleudert");
}

int raus(string dir)
{
  if (leiterrauf)
    write (bs("Als Du versuchst, raus zu gelangen, faellt Dir in "
      "letzter Sekunde auf, dass die Leiter ja gar nicht mehr beim "
      "Eingang ist sondern an der Wand unter der Falltuere lehnt."));
  else
    TP->move(QDIR("vhausu:"+explode(file_name(ME), ":")[<1]), M_GO,
      "", "klettert runter", "kommt heruntergeklettert");
  return 1;
}

string _query_int_long()
{
  string str;
  int a,b,c;

  if (!qo)
    if (!FindQuestObject())
      return "Du solltest eigentlich gar nicht hier sein...\n";

  switch (qo->CountFlags())
  {
    case 0..2:
      str="Du stehst mitten in einem Haus das wohl verwahrloster nicht "
          "sein kann... Der Anblick, der sich Dir bietet, ist wirklich "
          "erschreckend.";
      break;
    case 3..6:
      str="Das Haus, in dem Du nun stehst, hat wahrlich schon bessere "
          "Tage gesehen... Obwohl schon ein wenig getan wurde, herrscht "
          "hier immer noch ein regelrechtes Durcheinander.";
      break;
    case (DO_FLAGS+1):
      str="Du stehst in einem netten kleinen Haeuschen, das offenbar "
          "erst kuerzlich renoviert wurde.";
      break;
    default:
      str="Das Haus, in dem Du stehst, macht eigentlich einen ganz netten "
          "Eindruck, waeren da nicht einige kleinere Einzelheiten, die das "
          "Bild ein wenig trueben.";
  }

  if (a=qo->TestFlag(F_GEKEHRT))
    str+=" Der Boden ist einigermassen sauber, ";
  else
    str+=" Der Boden ist ziemlich "+
      (qo->TestFlag(F_SCHERBENWEG) ? "staubig, "
      : "schmutzig, einige Scherben und vertrocknete Blumen liegen "
        "verstreut umher, ");

  b=qo->TestFlag(F_VORH_GEFL);
  c=qo->TestFlag(F_VORH_GESCH);
  if (b)
    str += (a ? "und " : "jedoch ")+"die Vorhaenge sind geflickt "+
      (c ? "und ausgeschuettelt worden." : "worden, aber noch recht staubig.");
  else
    str += (a ? "aber ":"und ")+"die Vorhaenge sind "+
      (c ? "zwar sauber, jedoch loechrig." : "loechrig und voller Staub.");

  a=qo->TestFlag(F_FENSTER_REP);
  b=qo->TestFlag(F_FENSTER_GEP);
  if (a)
    str += (b ? " Die Sonne strahlt durch die wohl erst kuerzlich "
      "geputzten Fenster und erhellt den Rest des Hausinneren ein "
      "wenig." : " Die Fensterscheiben sind so verschmutzt, dass "
      "die Sonne sie kaum durchdringen kann.");
  else
    str += " Ein Fensterladen haengt lose herunter"+
      (b ? ", dafuer sind die Fensterscheiben blitzblank geputzt."
         : " und die Fensterscheiben sind derart verdreckt, dass die "
           "Sonne sie kaum zu durchdringen vermag.");

  a=qo->TestFlag(F_TISCH);
  b=qo->TestFlag(F_STUEHLE);
  if (!a)
    str += " Ein grosser Tisch liegt umgeworfen am Boden, "+
      (b ? "nur die Stuehle um ihn herum wurden bereits wieder aufgestellt."
         : "um ihn herum liegen - ebenfalls nicht mehr aufrecht - "
           "einige Stuehle verteilt.");
  else
    str += " Ein grosser Tisch steht mitten im Raum, "+
      (b ? "einige Stuehle wurden um ihn herum aufgestellt."
         : "um ihn herum liegen einige Stuehle umgeworfen am Boden.");
  if (qo->TestFlag(F_BLUMEN))
    str += " Auf dem Tisch steht eine Vase mit schoenen Blumen.";
  if (qo->TestFlag(F_WAENDE))
    str += " Die Waende strahlen in hellem Weiss, sie bekamen offenbar "
      "vor kurzem einen neuen Anstrich.";
  else
    str += " Die weisse Farbe an den Waenden blaettert bereits "
      "ab, sie sollte wohl einmal erneuert werden.";
  if (qo->TestFlag(F_BILD))
    str += " An einer der Waende haengt ein Bild.";

  str += " In einer der Ecken schliesslich liegt einiges Geruempel rum, das "
    "aber offenbar hierher gehoert.";
  if (qo->CountFlags() < 3)
    str += " Es ist also noch viel fuer Dich zu tun hier!";
  else if (qo->CountFlags() == DO_FLAGS+1)
    str += " Hier wurde ganze Arbeit geleistet, das Haus macht "
      "eigentlich einen bezugsfertigen Eindruck!";

  return bs(str);
}

string d_staub()
{
  int a,b,c;
  string str;
  a=qo->TestFlag (F_GEKEHRT);
  b=qo->TestFlag (F_SCHERBENWEG);
  c=qo->TestFlag (F_VORH_GESCH);
  if (!a)
    str="Zentimeterdick liegt er am Boden rum, jemand sollte vielleicht "
      "einmal kehren..."+
      (b ? "" : " Und unter all dem Staub findest Du zudem noch einige "
      "vertrocknete Blumen und Scherben.")+
      (c ? "" : " Auch die Vorhaenge sind voller Staub, die koennten ruhig "
      "mal ausgeschuettelt werden!");
  else
    str=(c ? "So sehr Du Dich auch anstrengst, Du kannst nirgends mehr "
      "Staub entdecken, hier war irgendjemand offenbar sehr gruendlich."
      : "Die Vorhaenge sind von Staub nur so durchsetzt, man sollte "
      "sie einmal kraeftig ausschuetteln!");
  return bs(str);
}

string d_anblick()
{
  string str;
  switch (qo->CountFlags())
  {
    case 0..2:
      str="Du stehst mitten in einem Haus das wohl verwahrloster nicht "
          "sein kann... Der Anblick, der sich Dir bietet, ist wirklich "
          "erschreckend.";
      break;
    case 3..6:
      str="Das Haus, in dem Du nun stehst, hat wahrlich schon bessere "
          "Tage gesehen... Obwohl schon ein wenig getan wurde, herrscht "
          "hier immer noch ein regelrechtes Durcheinander.";
      break;
    case (DO_FLAGS+1):
      str="Du stehst in einem netten kleinen Haeuschen, das offenbar "
          "erst kuerzlich renoviert wurde.";
      break;
    default:
      str="Das Haus, in dem Du stehst, macht eigentlich einen ganz netten "
          "Eindruck, waeren da nicht einige kleinere Einzelheiten, die das "
          "Bild ein wenig trueben.";
  }
  return bs(str);
}

string d_vorhaenge()
{
  int a,b;
  a=qo->TestFlag(F_VORH_GEFL);
  b=qo->TestFlag(F_VORH_GESCH);
  if (!a && !b)
    return bs("Abgesehen davon, dass die Vorhaenge staubig sind und "
     "ausgeschuettelt gehoerten, sind sie auch noch zerfetzt und loechrig. "
     "Dabei muss der weisse Stoff in des Hauses besten Tagen sehr schmuck "
     "in den Fenstern ausgesehen haben. Wenn Du die doch naehen koenntest...");
  else if (a && b)
    return bs("Die Vorhaenge sind einigermassen sauber, und saemtliche "
     "Loecher sind gestopft worden, viel mehr kannst Du da nicht tun. "
     "Alles in allem ein ganz netter Anblick.");
  else if (a)
    return bs("Die Vorhaenge sind zwar geflickt worden, aber immer noch "
     "ziemlich staubig. Sie sollten einmal kraeftig ausgeschuettelt werden!");
  else
    return bs("Die Vorhaenge sind zwar sauber, aber zerfetzt und loechrig. "
     "Vielleicht sollte man sie einmal naehen...?");
}

string d_fensterladen()
{
  if (qo->TestFlag(F_FENSTER_REP))
    return
      bs("Die Fensterlaeden sind beide intakt, kein Grund zur Klage mehr.");
  else
    return
      bs("Der linke ist noch ordentlich befestigt, der rechte aber "
         "haengt nur lose herab. Wenn Du Hammer und Nagel dabei haettest, "
         "waere das schnell repariert.");
}

string d_fenster()
{
  if (qo->TestFlag(F_FENSTER_GEP))
    return bs("Die Fenster sind blitzblank geputzt und "+
      (fensteroffen ? "weit geoeffnet" : "geschlossen")+".");
  else
    return bs("Die Fenster sind "+
      (fensteroffen ? "weit geoeffnet" : "geschlossen")+
      " und stark verschmutzt, man sollte sie einmal gruendlich putzen!");
}

string d_waende()
{
  if (qo->TestFlag(F_WAENDE))
    return bs("Die Waende wurden kuerzlich frisch gestrichen, sie "
     "strahlen Dich weiss an."+
     (qo->TestFlag(F_BILD)
      ? " An einer der Waende wurde ein Bild aufgehaengt."
      : ""));
  else
    return bs("Die weisse Farbe ist schon groesstenteils abgeblaettert, "
     "die Waende koennten einen neuen Anstrich vertragen.");
}

string d_boden()
{
  int a,b;
  string str;
  a=qo->TestFlag (F_GEKEHRT);
  b=qo->TestFlag (F_SCHERBENWEG);
  if (!a)
    str="Zentimeterdick liegt der Staub am Boden rum, jemand sollte "
      "vielleicht einmal kehren..."+
      (b ? "" : " Und unter all dem Staub findest Du zudem auch noch einige "
      "vertrocknete Blumen und Scherben.");
  else
    str="Der Boden ist relativ sauber, Du kannst nirgends auch nur ein "
      "Staubkoernchen entdecken. Hier war offenbar irgendjemand recht "
      "gruendlich.";
  return bs(str);
}

string d_tisch()
{
  int a,b,c;
  a=qo->TestFlag (F_TISCH);
  b=qo->TestFlag (F_STUEHLE);
  c=qo->TestFlag (F_BLUMEN);
  if (a && b)
    return bs("Ein grosser Tisch steht mitten im Raum, um ihn herum wurden "
     "einige Stuehle plaziert. "+
     (c ? "Auf ihm steht eine Vase mit ein paar wunderschoenen Blumen."
        : "Eine Vase mit Blumen wuerde sich bestimmt gut darauf machen."));
  else if (a)
    return bs("Ein grosser Tisch steht mitten im Raum, um ihn herum "
     "liegen einige Stuehle umgeworfen am Boden. Man sollte sie vielleicht "
     "auch mal aufstellen...");
  else if (b)
    return bs("Ein Tisch liegt umgeworfen am Boden, nur die Stuehle "
     "um ihn herum wurden bereits aufgestellt.");
  else
    return bs("Die Stuehle und der Tisch liegen umgeworfen am Boden. Sie "
     "scheinen noch in Ordnung zu sein, was Du Dir in diesem Haus wohl nicht "
     "erwartet haettest. Jemand sollte sie vielleicht mal aufstellen..."+
     (qo->TestFlag(F_SCHERBENWEG) ? "" : " Zwischen den Stuehlen siehst Du "
     "ausserdem noch einige vertrocknete Blumen und Scherben."));
}

string d_blumen()
{
  string str;
  if (qo->TestFlag(F_BLUMEN))
    str="Die Blumen in der Vase am Tisch sind wunderschoen."+
     (qo->TestFlag(F_SCHERBENWEG)
      ? "" : " Die ausgetrockneten, die am Boden rumliegen, weniger.");
  else if (!qo->TestFlag(F_SCHERBENWEG))
    str="Am Boden liegen zwischen einigen Scherben ein paar "
     "vertrocknete Blumen herum, die offenbar einmal in einer "
     "Vase am Tisch gestanden haben.";
  else
    str="Du kannst nirgends Blumen entdecken!";
  return bs(str);
}

string d_scherben()
{
  if (qo->TestFlag(F_SCHERBENWEG))
    return bs("Du kannst nirgendwo mehr Scherben entdecken!");
  else
    return bs("Auf dem Tisch hat wohl mal eine Vase mit Blumen darin "
     "gestanden. Als der Tisch fiel oder umgeworfen wurde, ging auch "
     "die Vase kaputt.");
}

string d_vase()
{
  if (qo->TestFlag(F_BLUMEN))
    return bs("Die schoene Vase mit den Blumen auf dem Tisch macht sich "
     "wirklich huebsch. Du erkennst, dass sie aus zwergischer Herstellung "
     "stammt, niemand sonst kann so sauber gearbeitete Vasen herstellen.");
  else if (!qo->TestFlag(F_SCHERBENWEG))
    return bs("Du siehst nur noch die Ueberreste von ihr in Form von "
     "Scherben...");
  else if (qo->TestFlag(F_TISCH))
    return
      bs("Eine Vase mit Blumen wuerde sich auf dem Tisch wohl gut machen.");
  else
    return bs("Wenn der Tisch wieder stuende, wuerde eine Vase mit Blumen "
      "gut darauf aussehen. Doch wo sollst Du sie hernehmen? Geruechten "
      "zufolge soll es in Felonia eine Toepferei geben, vielleicht solltest "
      "Du ja dort Dein Glueck versuchen?");
}

string d_stiel()
{
  qo->SetFlag (F_F_BESEN);
  if (besen)
    return "Es ist ein Besen, der hinter den drei Kisten liegt.\n";
  else
    return "Du schaust genauer hin und stellst fest, "
           "dass Du Dich getaeuscht hast.\n";
}

string d_besen()
{
  if (besen)
    if (qo->TestFlag(F_F_BESEN))
      return "Damit kann man sicher prima staubkehren.\n";
    else
      return "Ja, hier ist ein Besen, aber Du hast ihn noch nicht entdeckt.\n";
  else
    return "Den hat schon jemand vor Dir mitgenommen.\n";
}

int nimm (string str)
{
  object ob;
  if (!str) return 0;
  if (str=="besen") {
    if (!qo->TestFlag(F_F_BESEN))
      write ("Du solltest den Besen erst einmal entdecken!\n");
    else if (besen && !present(BESEN_ID, TP)) {
      write ("Du nimmst einen Besen.\n");
      say (CAP_TPN+" nimmt einen Besen.\n");
      CLONETPNOCHK(QDIR("besen"));
      besen = 0;
    } else
      write ("Da ist momentan kein Besen, den Du nehmen kannst!\n");
    return 1;
  }
  else if (str=="tuch" || str=="tuch aus kiste" ||
           str=="tuch aus kiste 1" || str=="tuch aus erster kiste") {
    if (!qo->TestFlag(F_F_TUCH))
      write ("Du solltest das Tuch erst einmal entdecken!\n");
    else if (tuch && kisteoffen[1] && !present(TUCH_ID, TP)) {
      write ("Du nimmst ein Tuch.\n");
      say (CAP_TPN+" nimmt ein Tuch.\n");
      CLONETPNOCHK(QDIR("tuch"));
      tuch = 0;
    } else
      write ("Da ist momentan kein Tuch, das Du nehmen kannst!\n");
    return 1;
  }
  else if (str=="kasten" || str=="kasten aus kiste" ||
           str=="kasten aus kiste 2" || str=="kasten aus zweiter kiste") {
    if (!(ob=present(KASTEN_ID)) && kisteoffen[2]) {
      write("Du nimmst einen Kasten und stellst ihn vor Dir auf den Boden.\n");
      say(CAP_TPN+" nimmt einen Kasten und stellt ihn auf den Boden.\n");
      CLONEME(QDIR("kasten"));
    } else if (ob)
      // write ("Aber der Kasten steht doch schon vor Dir auf dem Boden!\n");
      return 0;
    else
      write ("Da ist kein Kasten, den Du nehmen koenntest.\n");
    return 1;
  }
  else if (str=="nagel" || str=="nagel aus kiste" ||
           str=="nagel aus kiste 2" || str=="nagel aus zweiter kiste" ||
           str=="naegel" || str=="naegel aus kiste" ||
           str=="naegel aus kiste 2" || str=="naegel aus zweiter kiste") {
    if (!qo->TestFlag(F_F_NAEGEL))
      write ("Du solltest die Naegel erst einmal entdecken!\n");
    else if (nagel && kisteoffen[3]) {
      write ("Du nimmst ein paar Naegel.\n");
      say (CAP_TPN+" nimmt ein paar Naegel.\n");
      if (ob=present(NAGEL_ID,TP))
        ob->AddAmount(3+random(2));
      else {
        ob=CLONEOB(QDIR("nagel"));
        ob->SetProp(P_AMOUNT, 3+random(2));
        ob->move(TP, M_NOCHECK);
      }
      nagel = 0;
    } else
      write ("Da ist momentan kein Nagel, den Du nehmen kannst!\n");
    return 1;
  }
  else if (str=="leiter") {
    leiterrauf = !leiterrauf;
    if (leiterrauf)
      write (bs("Du ziehst die Leiter beim Eingang hoch und stellst "
        "sie gegen die Wand, zur Falltuere rauf. Jetzt kannst Du zum "
        "Dachboden hochklettern."));
    else
      write (bs("Du nimmst die Leiter und stellst sie wieder zum "
        "Eingang. Jetzt kannst Du wieder gefahrlos rausgehen."));
    return 1;
  }
  else return 0;
}

int oeffne (string str)
{
  int x;
  string s, dummy;
  notify_fail ("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if (str=="fenster") {
    if (fensteroffen) write ("Aber die Fenster sind doch schon geoeffnet!\n");
    else {
      fensteroffen=1;
      write ("Du oeffnest die Fenster.\n");
      say (CAP_TPN+" oeffnet die Fenster.\n");
    }
    return 1;
  }
  else if (str=="kisten") return
    notify_fail("Du kannst immer nur eine Kiste auf einmal oeffnen!\n"), 0;
  else if (str=="kiste") return
    notify_fail("Welche der drei Kisten willst Du oeffnen?\n"), 0;
  else if (sscanf(str, "kiste %d", x)==1) {
    if (x<1) return write ("Das waere ja wohl Unsinn, oder?\n"), 1;
    if (x>3) return write ("Soviele Kisten sind da nicht!\n"), 1;
  }
  else if (sscanf(str, "%s kiste%s", s, dummy)==2) {
    notify_fail("Welche Kiste willst Du oeffnen?\n"), 0;
    if ((x=member(({"erste", "zweite", "dritte"}),s))==-1) return 0;
    x++;
  }
  else
    return 0;
  if (kisteoffen[x])
    write ("Aber Kiste "+x+" ist doch schon offen!\n");
  else {
    write ("Du oeffnest Kiste "+x+".\n");
    say (CAP_TPN+" oeffnet Kiste "+x+".\n");
    kisteoffen[x]=1;
  }
  return 1;
}

int schliesse (string str)
{
  int x;
  string s, dummy;
  notify_fail ("Was willst Du schliessen?\n");
  if (!str) return 0;
  if (str!="fenster") {
    if (str=="kisten") return
      notify_fail("Du kannst immer nur eine Kiste auf einmal schliessen!\n"), 0;
    if (sscanf(str, "kiste %d", x)==1) {
      if (x<1) return write ("Das waere ja wohl Unsinn, oder?\n"), 1;
      if (x>3) return write ("Soviele Kisten sind da nicht!\n"), 1;
    }
    else if (sscanf(str, "%s kiste%s", s, dummy)==2) {
      notify_fail("Welche Kiste willst Du schliessen?\n"), 0;
      if ((x=member(({"erste", "zweite", "dritte"}),s))==-1) return 0;
      x++;
    }
    else
      return 0;
    if (!kisteoffen[x])
      write ("Aber Kiste "+x+" ist doch gar nicht geoeffnet!\n");
    else {
      write ("Du schliesst Kiste "+x+".\n");
      say (CAP_TPN+" schliesst Kiste "+x+".\n");
      kisteoffen[x]=0;
    }
    return 1;
  }
  if (!fensteroffen) write ("Aber die Fenster sind doch schon geschlossen!\n");
  else {
    fensteroffen=0;
    write ("Du schliesst die Fenster.\n");
    say (CAP_TPN+" schliesst die Fenster.\n");
  }
  return 1;
}

int kehre (string str)
{
  object ob;
  notify_fail ("Was willst Du kehren?\n");
  if (!str) return 0;
  if (str!="boden" && str!="staub") return 0;
  if (!ob=present(BESEN_ID, TP))
    write ("Dazu solltest Du einen passenden Besen haben.\n");
  else {
    write ("Du kehrst den Boden mit dem Besen gruendlich auf.\n");
    say (CAP_TPN+" kehrt den Boden mit dem Besen gruendlich auf.\n");
    qo->SetFlag(F_GEKEHRT);
    if (!qo->TestFlag(F_SCHERBENWEG)) {
      qo->SetFlag(F_SCHERBENWEG);
      write("Auch die Scherben und die vertrockneten Blumen kehrst Du weg.\n");
    }
    write ("Anschliessend stellst Du den Besen wieder hinter die Kisten.\n");
    ob->remove();
    besen=1;
  }
  return 1;
}

int schuettel (string str)
{
  if (!str) write ("Willst Du etwas AUSschuetteln oder was?\n");
  else if (str!="vorhang aus" && str!="vorhaenge aus")
    write ("Willst Du etwas AUSschuetteln oder was?\n");
  else {
    if (qo->TestFlag (F_VORH_GESCH))
      write ("Aber die Vorhaenge sind doch schon ausgeschuettelt!\n");
    else {
      qo->SetFlag (F_VORH_GESCH);
      say (CAP_TPN+" schuettelt die Vorhaenge ordentlich aus.\n");
      if (fensteroffen)
        write (bs("Du nimmst die Vorhaenge und schuettelst sie durch "
          "die offenen Fenster ordentlich aus. Nun sind sie nicht "
          "mehr so staubig."));
      else
        if (qo->TestFlag (F_GEKEHRT)) {
          write (bs("Du schuettelst die Vorhaenge ordentlich aus, "
            "aber da Du vergessen hast, vorher die Fenster zu oeffnen, "
            "landet der ganze Staub am Boden, und Du kannst dort von "
            "Neuem kehren!"));
          say ("Dabei landet der ganze Staub erneut am Boden.\n");
          qo->ClearFlag (F_GEKEHRT);
        } else
          write (bs("Du schuettelst die Vorhaenge kraeftig aus und "
            "erstickst fast in dem ganzen Staub. Vielleicht haettest "
            "Du ja vorher die Fenster oeffnen sollen?"));
    }
  }
  return 1;
}

int naehe (string str)
{
  object ob;
  notify_fail ("WAS willst Du naehen?\n");
  if (!str) return 0;
  if (member(({"vorhang","vorhaenge","loecher","stoff"}),str)==-1) return 0;
  if (!ob=present(NADELFADEN_ID, TP))
    write ("Dazu brauchst Du Nadel und passenden Faden.\n");
  else {
    qo->SetFlag (F_VORH_GEFL);
    write (bs("Du nimmst Nadel und Faden und flickst sorgfaeltig die "
      "Loecher in den Vorhaengen. Kaum bist Du damit fertig, loesen "
      "sich Nadel und Faden ploetzlich in Nichts auf."));
    say (CAP_TPN+" flickt sorgfaeltig die Loecher im Vorhang.\n");
    ob->remove();
  }
  return 1;
}

string d_kisten()
{
  return "Du erblickst drei Kisten, die in einer Ecke stehen."+
    "\nDie erste Kiste ist "+(kisteoffen[1]?"offen.":"geschlossen.")+
    "\nDie zweite Kiste ist "+(kisteoffen[2]?"offen.":"geschlossen.")+
    "\nDie dritte Kiste ist "+(kisteoffen[3]?"offen.":"geschlossen.")+
    "\n";
}

string d_kiste1()
{
  if (kisteoffen[1]) {
    qo->SetFlag(F_F_TUCH);
    return bs("Die erste Kiste ist geoeffnet. Sie enthaelt verschiedene "
      "Kleider"+(tuch ? ", Stoffe und ein Tuch." : " und Stoffe."));
  }
  else
    return "Sie ist geschlossen.\n";
}

string d_kiste2()
{
  if (kisteoffen[2])
    return bs("Die zweite Kiste ist geoeffnet. Sie "
      +(present(KASTEN_ID) ? "ist leer." : "enthaelt einen grossen Kasten."));
  else
    return "Sie ist geschlossen.\n";
}

string d_kiste3()
{
  if (kisteoffen[3])
    return bs("Die dritte Kiste ist geoeffnet. Sie enthaelt allen "
      "moeglichen Kleinkram, unter anderem Zeichnungen"+
      (nagel ? ", kleine Stifte" : "")+" und Buecher.");
  else
    return "Sie ist geschlossen.\n";
}

string d_stifte()
{
  if (!kisteoffen[3])
    return bs("Wo siehst Du hier Stifte?\n");
  qo->SetFlag (F_F_NAEGEL);
  if (nagel)
    return bs("Beim naeheren Betrachten erkennst Du, dass es Naegel sind.");
  else
    return bs("Du kannst keine Stifte mehr entdecken.\n");
}

string d_nagel()
{
  if (!qo->TestFlag(F_F_NAEGEL))
    return bs("Naegel? Wo siehst Du hier Naegel???\n");
  else if (!kisteoffen[3])
    return "In geschlossene Kisten kannst nicht mal Du rein schauen!\n";
  else if (nagel)
    return bs("Kleine Naegel, wie man sie zum Befestigen von losen "
      "Gegenstaenden im Hausbau verwenden kann.");
  else
    return bs("Du schaust genauer hin und stellst fest, dass es doch "
      "nur Stifte waren...");
}

string d_tuch()
{
  if (!qo->TestFlag(F_F_TUCH))
    return bs("Ja, irgendwo hier ist ein Tuch, aber das musst Du erst "
      "entdecken!\n");
  else if (!kisteoffen[1])
    return "In geschlossene Kisten kannst nicht mal Du rein schauen!\n";
  else if (tuch)
    return bs("Dieses Tuch wurde wohl zum Putzen verwendet, denn es ist "
      "stellenweise sehr schmutzig. Trotzdem eignet es sich sicherlich "
      "noch immer recht gut fuer total verdreckte Fenster.");
  else
    return "Wo siehst Du hier ein Tuch?\n";
}

string d_putzen()
{
  if (qo->TestFlag(F_F_TUCH) && kisteoffen[1] && tuch)
    return "Mit diesem Tuch koenntest auch Du hier einiges sauber machen.\n";
  else
    return "Ja, Du solltest hier mal so einiges putzen...\n";
}

string d_kasten()
{
  if (present(KASTEN_ID) || kisteoffen[2])
    return "Ein Kasten aus Metall, sieht aus wie ein Werkzeugkasten.\n";
  else
    return "Wo ist hier ein Kasten?\n";
}

string d_tuer()
{
  if (leiterrauf)
    return bs("Durch diese Tuer bist Du hier hereingekommen. Die Leiter, "
      "die hier heraufgefuehrt hat, lehnt jetzt jedoch an der Wand, Du "
      "solltest also jetzt nicht blindlings zur Tuer rausgehen...");
  else
    return bs("Durch diese Tuer bist Du hereingekommen. Du siehst durch "
      "die geoeffnete Tuer auch gerade noch die letzten Sprossen der "
      "Leiter.");
}

string d_leiter()
{
  if (leiterrauf)
    return bs("Die Leiter lehnt an der Wand und fuehrt zur Falltuere, "
      "durch die Du auf den Dachboden klettern kannst. Dafuer fehlt "
      "sie natuerlich jetzt bei der Tuer, Du solltest also nicht "
      "einfach blindlings rausgehen...");
  else
    return bs("Von hier drinnen siehst Du noch die letzten Sprossen "
      "der Leiter, ohne die Du unmoeglich ins Haus gekommen waerst. "
      "Leitern sind ja schliesslich zum Hochklettern da.");
}

string d_bild()
{
  if (qo->TestFlag(F_BILD))
    return bs("An einer der Waende haengt ein Bild in einem einfachen "
      "Holzrahmen, das ein kleines Maedchen zeigt, vermutlich Verians "
      "Tochter.");
  else
    return bs("Hier haengt nirgends ein Bild, aber vielleicht wuerde "
      "sich eines ganz gut machen? Aber es muesste schon ein ganz "
      "bestimmtes sein...\n");
}

int kletter(string str)
{
  notify_fail ("Wohin willst Du klettern?\n");
  if (!str) return 0;
  if (str=="nach unten" || str=="runter") return raus(str);
  if (member( ({"nach oben", "rauf", "hoch", "auf dachboden",
                "durch falltuer", "durch falltuere"}), str)==-1) return 0;
  if (!leiterrauf)
    write (bs("So sehr Du Dich auch anstrengst, Du kannst nicht durch "
      "die Luft nach oben zur Falltuere klettern, Du brauchst schon "
      "etwas Halt... ueberleg mal, wie Du hier reingekommen bist!"));
  else
    TP->move(QDIR("vhauso:"+explode(file_name(ME), ":")[<1]), M_GO,
      "", "klettert hoch", "kommt heraufgeklettert");
  return 1;
}

int befestige(string str)
{
  object ob,hammer;

  notify_fail ("Was willst Du befestigen?\n");
  if (!str) return 0;
  if ((str!="fensterladen") && (str!="fensterlaeden")) return 0;
  if (qo->TestFlag (F_FENSTER_REP))
    write ("Aber die Fensterlaeden sind doch schon repariert!\n");
  else if ((!ob=present(NAGEL_ID, TP)) || (ob->QueryProp(P_AMOUNT) < 2))
    write ("Dazu brauchst Du mindestens zwei Naegel!\n");
  else if (!present(HAMMER_ID, TP))
    if (hammer = present("hammer", TP))
      if (hammer->QueryProp(P_WEIGHT) < 300)
        write(bs("Du versuchst, die Naegel mit " + hammer->name(WEM,1) +
            " in die Wand zu treiben, doch " + hammer->QueryPronoun() +
            " ist viel zu schwach dafuer, Du brauchst wohl einen anderen"
            " Hammer."));
      else if (hammer->QueryProp(P_WEIGHT) >= 1000)
        write(bs("Bist Du wahnsinnig?? " + hammer->Name(WER,1) +
            " ist viel zu schwer und wuerde die Naegel komplett verbiegen! "
            "Such Dir lieber einen geeigneteren Hammer!"));
      else
        write(bs("Du versuchst, die Naegel mit " + hammer->name(WEM,1) +
            " in die Wand zu treiben, doch " + hammer->QueryPronoun() +
            " erscheint irgendwie ungeeignet, staendig haust Du daneben"
            " und triffst Deine eigenen Finger. Du brauchst wohl einen"
            " anderen Hammer."));
    else
      write("Dazu brauchst Du auf alle Faelle einen Hammer!\n");
  else {
    qo->SetFlag (F_FENSTER_REP);
    ob->AddAmount (-2);
    write (bs("Mit dem Hammer und zwei Naegeln befestigst Du den "
      "rechten Fensterladen wieder ordentlich."));
    say (bs(CAP_TPN+" befestigt den rechten Fensterladen ordentlich mit "
      "Hammer und Naegeln.\n"));
  }
  return 1;
}

int putze(string str)
{
  object ob;
  if (stringp(str) && (member(({"fenster", "scheiben", "fensterscheiben",
                                "fensterglas"}), str) != -1))
  {
    if (qo->TestFlag (F_FENSTER_GEP))
      write ("Aber die Fenster sind doch schon geputzt!\n");
    else if (!present(TUCH_ID, TP))
      write ("Dazu brauchst Du auf jeden Fall ein Tuch!\n");
    else if ((!ob=present(EIMER_ID, TP)) ||
             (ob->QueryProp(P_CONTAINS) != CONTAINS_WATER))
      write ("Dazu brauchst Du wohl auch etwas Wasser!\n");
    else {
      qo->SetFlag (F_FENSTER_GEP);
      ob->SetProp (P_CONTAINS, CONTAINS_NOTHING);
      write (bs("Du putzt die Fenster sorgfaeltig und verbrauchst dabei "
        "den ganzen Eimer Wasser."));
      say (CAP_TPN+" putzt sorgfaeltig die Fenster, bis sie glaenzen.\n");
    }
  }
  else
    write ("Was willst Du putzen?\n");
  return 1;
}

int stelle(string str)
{
  string s, dummy;
  object ob;

  notify_fail ("Was willst Du auf- oder wo drauf stellen?\n");
  if (!str) return 0;
  if (sscanf(str, "%s auf%s", s, dummy) != 2) return 0;
  if ((dummy==" tisch") &&
      (member(({"vase","blumen","blumenstrauss"}),s)!=-1))
  {
    if (qo->TestFlag (F_BLUMEN))
      write ("Aber da steht doch schon eine Vase mit Blumen am Tisch!\n");
    else if (!ob=present(VASE_ID,TP))
      write ("Aber Du hast doch gar keine passende Vase!\n");
    else if (ob->QueryProp(P_CONTAINS)!=CONTAINS_FLOWERS)
      write ("Waeren Blumen in der Vase, wuerde das ja auch Sinn machen, "
          "aber so...\n");
    else if (!qo->TestFlag (F_TISCH))
      write ("Vielleicht solltest Du erstmal den Tisch aufstellen?\n");
    else {
      qo->SetFlag(F_BLUMEN);
      ob->remove();
      write("Du stellst die Vase mit den Blumen auf den Tisch.\n");
      say(CAP_TPN+" stellt eine Vase mit Blumen auf den Tisch.\n");
      AddSmell( ({DEFAULT_SMELL,"blume","blumen"}),
          "Die Blumen am Tisch duften herrlich.\n");
    }
    return 1;
  }
  notify_fail ("Das kannst Du nicht aufstellen.\n");
  if (s=="tisch") {
    if (qo->TestFlag(F_TISCH))
      write ("Aber der Tisch steht doch schon!\n");
    else {
      qo->SetFlag(F_TISCH);
      write("Du stellst muehevoll den grossen, schweren Tisch wieder auf.\n");
      say(CAP_TPN+" stellt muehevoll den grossen Tisch wieder auf.\n");
    }
  }
  else if (member(({"stuhl", "stuehle", "sessel", "sesseln"}),s)!=-1) {
    if (qo->TestFlag(F_STUEHLE))
      write ("Aber die Stuehle stehen doch schon!\n");
    else {
      qo->SetFlag(F_STUEHLE);
      write("Du stellst behende die Stuehle wieder auf.\n");
      say(CAP_TPN+" stellt behende die Stuehle wieder auf.\n");
    }
  }
  else if (strstr(s," und ") != -1)
    write ("Schoen langsam, immer eins nach dem anderen, "
           "nicht alles auf einmal!\n");
  else return 0;
  return 1;
}

int streiche(string str)
{
  object ob;
  notify_fail("Was willst Du streichen?\n");
  if (!str) return 0;
  if (str[<3..]==" an") str=str[0..<4];
  if (str[<4..]==" neu") str=str[0..<5];
  if (str[<6..]==" weiss") str=str[0..<7];
  if ((str!="wand") && (str!="waende")) return 0;
  if (qo->TestFlag(F_WAENDE))
    write ("Aber die Waende sind doch schon neu gestrichen!\n");
  else if (!present(PINSEL_ID, TP))
    write ("Dazu benoetigst Du auf jeden Fall einen brauchbaren Pinsel.\n");
  else if ((!ob=present(EIMER_ID, TP)) ||
           (ob->QueryProp(P_CONTAINS) != CONTAINS_COLOR))
    write ("Dafuer benoetigst Du wohl auch etwas Farbe.\n");
  else {
    qo->SetFlag (F_WAENDE);
    ob->SetProp (P_CONTAINS, CONTAINS_NOTHING);
    write (bs("Du streichst die Waende sorgfaeltig und gleichmaessig weiss "
      "und verbrauchst dabei die ganze Farbe aus dem Eimer."));
    say(CAP_TPN+" gibt den Waenden einen neuen Anstrich mit weisser Farbe.\n");
  }
  return 1;
}

int haenge(string str)
{
  object bild,ob;
  notify_fail ("Was willst Du denn aufhaengen?\n");
  if (!str) return 0;
  if (str!="bild auf")
    return notify_fail ("Das kannst Du nicht aufhaengen.\n"), 0;
  if (qo->TestFlag(F_BILD))
    write ("Das Bild haengt bereits an der Wand!\n");
  else if (!qo->TestFlag(F_WAENDE))
    write (bs("Bevor Du hier ein Bild aufhaengst, solltest Du vielleicht "
           "erst einmal die Waende neu streichen... die weisse Farbe "
           "ist an den meisten Stellen bereits abgeblaettert!"));
  else if (!bild=present(BILD_ID, TP))
    write ("Du hast kein Bild, das Du aufhaengen koenntest!\n");
  else if (!(ob=present(NAGEL_ID, TP)) || ob->QueryProp(P_AMOUNT) < 1)
    write ("Du brauchst einen Nagel, um das Bild aufzuhaengen.\n");
  else if (!present(HAMMER_ID, TP))
    write ("Du brauchst einen Hammer, um den Nagel in die Wand schlagen "
           "zu koennen.\n");
  else
  {
    qo->SetFlag(F_BILD);
    ob->AddAmount(-1);
    bild->remove();
    write ("Du schlaegst einen Nagel in die Wand und haengst das "
      "Bild daran auf.\n");
    say (CAP_TPN+" schlaegt einen Nagel in die Wand und haengt ein "
      "Bild daran auf.\n");
  }
  return 1;
}

