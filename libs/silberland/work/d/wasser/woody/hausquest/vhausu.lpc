#include <properties.h>
#include <moving.h>
#include "files.h"

#ifndef ROOM
#define ROOM(x) ("/d/wasser/woody/hausquest/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Vor einem Haus");
  SetProp (P_INT_LONG,
    "Du stehst in einem kleinen Seitenweg inmitten des Fischerdorfes vor "+
    "einem netten kleinen Haeuschen. Eine kleine Leiter fuehrt hinauf zur "+
    "Tuere, die nicht verschlossen zu sein scheint. Neben der Tuere ist "+
    "ein kleines Schild angebracht. Durch die Fenster siehst Du ein paar "+
    "strahlend weisse Vorhaenge, aber mehr kannst Du wohl erst erkennen, "+
    "wenn Du das Haeuschen einfach betrittst.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"seitenweg", "weg"}),
    "Der Weg besteht aus festgetrampelter Erde.");
  AddDetail ( ({"erde"}),
    "Gewoehnliche Erde.");
  AddDetail ( ({"dorf", "fischerdorf", "teil"}),
    "Du befindest Dich im nordoestlichen Teil des Dorfes.");
  AddDetail ( ({"eindruck", "haeuschen", "haus"}),
    "Das Haeuschen macht einen netten, gepflegten Eindruck auf Dich.");
  AddDetail ( ({"leiter"}),
    "Ueber diese Leiter gelangst Du zur Tuere und weiters ins Hausinnere.");
  AddDetail ( ({"holztuer", "holztuere", "tuer", 
                "tuere"}),
    "Eine kleine Holztuer fuehrt ins Innere des Hauses.");
  AddDetail ( ({"schild"}),
    "Du kannst es lesen.");
  AddReadDetail ( ({"schild"}),
    "Auf dem Schild steht: 'Verians Haus'.");
  AddDetail ( ({"fenster", "vorhaenge", "vorhang"}),
    "Die hellweissen Vorhaenge hinter den blankgeputzten Fenstern werden "+
    "durch die strahlende Sonne erleuchtet.");
  AddDetail ( ({"hausinneres", "inneres"}),
    "Mehr kannst Du wohl erkennen, wenn Du reingehst.");
  AddDetail ( ({"sonne"}),
    "Die Sonne strahlt heute wieder besonders hell.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus festgetrampelter Erde.");
  AddDetail ( ({"himmel"}),
    "Am blauen Himmel ueber Dir glaenzt die goldene Sonne.");
  // DETAILS END

  // EXITS START
  AddExit ("haus", "ins Haus#"+ROOM("vhaus"));
  AddExit ("suedwesten", FISCHERDORF("room/hauptstr_o"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}
