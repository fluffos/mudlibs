#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include "files.h"

#define P_VALID_NAME "valid_name"

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, QDIR("") );
  SetProp(P_STD_OBJECT, QDIR("std_vhaus"));
  SetProp(P_VALID_NAME, ({ "vhaus", "vhausu", "vhauso" }) );
}

string Validate(string file)
{
  string path, name, who;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1))
  {
    SetProp(P_STD_OBJECT, QDIR("std_"+name));
    return file;
  }
}

int CustomizeObject()
{
  string name,foo,who;

  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%s",foo,who)!=2)
    return 0;

  if (foo=="vhauso") {
    PO->AddExit("unten", QDIR("vhaus:"+who));
  }

  return 1;
}
