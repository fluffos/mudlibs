/*
 * Ein Pinsel, Woody
 * (fuer Hausquest)
 *
 */

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ( ({ "pinsel", PINSEL_ID }) );
  AddId (Q_ITEM_ID);
  SetProp (P_SHORT, "Ein Pinsel");
  SetProp (P_LONG,
    "Ein einfacher Malerpinsel. Fuer Gemaelde eignet er sich nicht, "
    "aber man kann Waenden damit sicher einen neuen Anstrich verpassen.");
  SetProp (P_NAME, "Pinsel");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 180);
  SetProp (P_VALUE, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_MATERIAL, ([MAT_WOOD:75,MAT_HAIR:25]) );
}
