/*
** Lena, Verians Frau - Woody
** ---
** 19 Feb, 1997  Releaes
** 23 Feb, 2001  P_NO_SCORE -> 1
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <npcmaster.h>

#include "files.h"

create()
{
  object ob;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  AddId ("lena");
  AddId ("\nlena");
  set_living_name("lena");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_NAME, "Lena");
  SetProp (P_ARTICLE, 0);
  SetProp (P_SHORT, "Lena, Verians Frau");
  SetProp (P_LONG, bs("Lena ist die Frau von Verian, dem Fischer. Sie "
      "ist auch schon aelter, und die Zeichen der Zeit sind auch an "
      "ihr nicht spurlos voruebergegangen, sie ist ziemlich schwer"
      "hoerig, es wird also besser sein, wenn Du mit Verian statt "
      "mit ihr sprichst."));
  SetProp (P_SIZE, 160+random(11));
  SetProp (P_ALIGN, 200);
  SetProp (P_LEVEL, 9);
  SetProp (P_MAX_HP, 100);
  SetProp (P_MAX_SP, 100);
  SetProp (P_XP, 0);
  SetProp (P_NO_SCORE, 1);      // keine EKs!
  SetProp (P_NOCORPSE, 1);
  SetProp (P_BODY, 20);
  SetProp (P_HANDS, ({" mit blossen Haenden", 30, DT_BLUDGEON}) );
  SetProp (P_NOATTACK, "schimpft: Lass das!");
  SetProp (P_REJECT,
      ({ REJECT_GIVE, "Lena braucht @WEN nicht.\n" }) );

  SetProp (P_MSGIN, "folgt ihrem Mann");
  SetProp (P_MSGOUT, "folgt ihrem Mann");
  SetProp (P_MMSGIN, "folgt ihrem Mann");
  SetProp (P_MMSGOUT, "folgt ihrem Mann");

  SetProp (P_DEFAULT_INFO, ({
      "verweist auf Verian.\n",
      "beachtet Dich gar nicht.\n",
      "kann Dich leider nicht hoeren.\n",
      "sagt: Haeh? Du musst schon etwas lauter sprechen!\n" }) );

}

