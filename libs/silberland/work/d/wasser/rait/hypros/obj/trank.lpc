#include "../def.h"

inherit "std/food";

#include <food.h>

void create() 
{
  if (!is_clone(this_object())) return;
  ::create( ({"trink", "trinke"}) );

  SetProp(P_SHORT, "Ein Trank");
  SetProp(P_LONG,
    "Du haeltst einen winzigen Trank in Deinen Haenden.");
  SetProp(P_NAME, "Trank");
  SetProp(P_GENDER, MALE);
  AddId("trank");
  SetProp(P_NAME_ADJ, ({"winzig"}) );
  AddAdjective( ({"winzigen","winziger","winzigem","winziges","winzige"}) );

  SetProp(P_MATERIAL, MAT_HEAL );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10,10 }),
         F_SOAK    : 0,
         F_DRINK   : 5,
         F_ALCOHOL : 0,
         F_POISON  : 0,
         F_MSG     : "Du trinkst einen Trank.",
         F_MSG_ROOM: "trinkt einen Trank.",
         F_VERB    : "trinken"      
      ]) );                       
}