inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In einem Laden in Hypros");
  SetProp(P_SHOPKEEPER_ID, "tiros");
  SetProp(P_SHOPKEEPER_NAME, "Tiros");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetStorageRoom(ROOM "lager" );
  
  
///-DETAILS-ANFANG------------------------------------- 

  AddDetail( ({"laden"}),
    "Da befindest Du Dich gerade.");  
    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Holz.");
  
  AddDetail( ({ "holz" }),
    "Buchenholz um es genauer zu sagen.");
    
  AddDetail( ({ "buchenholz" }),
    "Buchenholz findet man meistens in einem Wald.");
    
  AddDetail( ({ "wald" }),
    "Also ich sehe hier keinen Wald.");
    
  AddDetail( ({ "decke", "waende" }),
    "Die Decke und die Waende bestehen aus Stein.");
    
  AddDetail( ({ "stein" }),
    "Um es genauer zu sagen, muesstest Du das einmal studieren.");
    
  AddDetail( ({ "regale", "regal" }),
    "Die Regale sind voll mit Kram, den eigentlich keiner braucht.");
    
  AddDetail( ({ "kram" }),
    "Lauter unnoetiger Kram halt.");
  
  AddDetail( ({ "wand" }),
    "Hier haengen nur einzigartige Waffen.");
    
  AddDetail( ({ "waffen" }),
    "Von Schwerter bis kleine Messer haengen an der Wand.");
    
  AddDetail( ({ "schwerter" }),
    "Viele einzigartige Schwerter haengen an der Wand.");
    
  AddDetail( ({ "messer" }),
    "Messer haengen hier zwar nicht so viele, aber dafuer sind sie auch einzigartig.");
    
  AddDetail( ({ "sammler", "vetischist" }),
    "Das ist Tiros. Es will einfach alles haben. Vor allem ist er auf Waffen scharf.");
   
  AddSound( DEFAULT_SOUND,
    "Du kannst Leute feilschen hoeren.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier hauptsaechlich nach Holz, Stein und nach Metall.");
   
  AddSmell( ({ "holz", "stein", "metall"}),
    "Es riecht irgendwie komisch.");
 
/////-DETAILS-ENDE--------------------------------------
  
  AddItem(NPC "tiros", REFRESH_DESTRUCT);
    AddExit( "sueden", ROOM "room16" );

}

string _query_int_long()

{
  string txt;

  txt = "Du befindest Dich hier in einem kleinen Laden. Der Boden besteht aus Holz, "
        "die Waende und die Decke bestehen aus Stein. An den Waenden stehen viele Regale, "
        "doch an einer Wand haengen nur Waffen. Den Waffen zufolge ist der Ladenbesitzer "
        "ein Sammler oder er ist einfach nur ein Vetischist. Man sollte hier lieber die "
        "Finger von den Waffen und Regalen lassen.\n";



  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist Tiros nicht hier.";
    }
  }

  return BS(txt);
}