#include "../def.h"

inherit "std/room";

#include <properties.h>

int trank_da;

void create()
{
  ::create();
  
  trank_da = 1;
  
  SetProp( P_INT_SHORT, "Das Suedtor von Hypros" );
  SetProp( P_INT_LONG,
    "Du stehst vor einem grossen Tor. Das Tor sieht schon etwas mitgenommen "
    "aus. Das erklaert auch die Gerueste links und rechts neben dem Tor. Hier wird wohl eine "
    "Reparatur stattfinden. Etwas seltsam ist es, dass es hier keine Pflastersteine mehr gibt. "
    "Du fuehlst Dich hier nicht wohl. Vielleicht solltest Du lieber umkehren? \n"
    "Ein Schild wurde hier in den Boden gerammt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "tor" }),
    "Du erkennst ein paar kleine Loecher und sehr viele Kratzer. Es wird aber gerade repariert.");
  
  AddDetail( ({ "loecher" }),
    "Die Loecher sind leider zu klein um durch zu schauen. Aber wenn Du willst, kannst Du es einmal versuchen.");
    
  AddDetail( ({ "kratzer" }),
    "Die Kratzer scheinen von grossen Kreaturen zu stammen.");
  
  AddDetail( ({ "kreaturen" }),
    "Du glaubst, dass es sich um Hydras handelt, da es grosse Kratzer sind.");
  
  AddDetail( ({ "hydra", "hydras" }),
    "Die Hydras sind grosse drachenaehnliche Kreaturen mit einer verschiedenen "
    "Anzahl an Koepfen.");
    
  AddDetail( ({ "gerueste" }),
    "Auf den Geruesten befinden sich derzeit kein Arbeiter. Wo die wohl sind?");
    
  AddDetail( ({ "arbeiter" }),
    "Die meisten Arbeiter sind wohl gerade in der Kneipe einen heben.");
    
  AddDetail( ({ "kneipe" }),
    "Die Kneipe muss hier in der Naehe sein.");
    
  AddDetail( ({ "boden" }),
    "Am Boden stehen viele Werkzeugkoffer, und es liegt auch noch ein kleiner Stapel mit Bretter am Boden. "
    "Die Erde hier ist zwar trocken, aber sieht doch irgendwie feucht aus. In den Boden wurde ein Schild gerammt.");
  
  AddDetail( ({ "pflastersteine" }),
    "Du findest keine.");
  
  AddDetail( ({ "werkzeugkoffer", "koffer" }),
    "Die Werkzeugkoffer sehen recht schwer aus. Das liegt wohl am ganzen Werkzeug, das die Arbeiter benoetigen.");
  
  AddDetail( ({ "werkzeug" }),
    "Was man halt so als Arbeiter braucht.");
  
  AddDetail( ({ "stapel" }),
    "Auf dem Stapel liegen vielleicht gerade mal 10 Bretter.");
    
  AddDetail( ({ "bretter" }),
    "Die Bretter sind alle neu. Keine Loecher und keine Kratzer. Die Bretter werden sicher mit den "
    "alten, die noch im Tor verbaut sind, ausgetauscht.");
    
  AddDetail( ({ "erde" }),
    "Die Erde ist trocken oder auch nicht? Wie koennte man das nur heraus finden?");  

  AddDetail( ({ "himmel" }),
    "Den kannst Du leider nicht erkennen."); 
    
  AddDetail( ({ "schild" }),
    "Du kannst es lesen."); 

  AddReadDetail( ({ "schild" }),
    "\n"
    "ACHTUG!!!,\n"
    "Der Weg fuehrt von hier in die Berge. Dort leben Moster und Hydren. Begehen nur auf eigene "
    "Gefahr!\n"
    "Der Koenig von Hypros");

  AddSound( DEFAULT_SOUND,
    "Du kannst komische Geraeusche hoeren.");
    
  AddSound( ({ "geraeusche" }),
    "Du hast solche Geraeuche noch nie gehoert.");

  AddSmell( DEFAULT_SMELL,
    "Du kannst Schwefel riechen.");

  AddSmell( ({ "schwefel", "schwefelgeruch", "geruch" }),
    "Der Schwefelgeruch ist schon etwas staerker hier.");
    
///---DETAILS-ENDE-------------------------------------------------------------------  
  
  AddCmd( ({ "schau" }), "cmd_loch" );
  AddCmd( ({ "kletter","klettere" }), "cmd_geruest" );
  AddCmd( ({ "oeffne" }), "cmd_koffer" );
  AddCmd( ({ "taste" }), "cmd_erde" );
  AddCmd( ({ "grabe" }), "c_graben" );
  
  AddItem(NPC "buerger", REFRESH_DESTRUCT);
  AddExit( "norden", "nach Norden#" + "./room19" );
  AddExit( "sueden", "/d/wasser/gwenshara/hydrahoehle/room/k_1");

}

int cmd_loch(string str)
{
  notify_fail("Wodurch moechtest Du schauen?\n");
  if(!str || str == "") return 0;
  if(!(str == "durch loecher" ||
       str == "durch loch" )) return 0;

  write(BS("Du schaust durch ein kleines Loch, kannst aber nichts erkennen, da Du alles verschwommen siehst.\n"));
  tell_room(ENV(TP), TPN+" schaut durch ein Loch.\n", ({TP}));
  return 1;
}

int cmd_geruest(string str)
{
  notify_fail("Worauf moechtest Du klettern?\n");
  if(!str || str == "") return 0;
  if(!(str == "auf geruest" )) return 0;

  write(BS("Du versuchst auf ein Geruest zu klettern, schaffst es aber doch nicht.\n"));
  tell_room(ENV(TP), TPN+" will auf ein Geruest klettern, aber @WER schafft es nicht.\n", ({TP}));
  return 1;
}

int cmd_koffer(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(!str || str == "") return 0;
  if(!(str == "werkzeugkoffer" ||
       str == "koffer" )) return 0;

  write(BS("Du oeffnest einen Werkzeugkoffer und siehst:\n"
           "Einen Hammer, eine Saege, viele Naegel und auch Schleifpapier.\n"
           "Nachdem Du nun weisst, was alles im Werkzeugkoffer ist, schliesst Du ihn wieder."));
  tell_room(ENV(TP), TPN+" schaut sich den Werkzeugkoffer genauer an.\n", ({TP}));
  return 1;
}

int cmd_erde(string str)
{
  notify_fail("Was moechtest Du tasten?\n");
  if(!str || str == "") return 0;
  if(!(str == "erde" ||
       str == "boden" )) return 0;

  write(BS("Komisch... Die Oberflaeche des Bodens ist trocken. Doch ein paar "
           "Zentimeter darunter ist die Erde feucht. Vielleicht kannst Du hier ja graben?"));
  tell_room(ENV(TP), TPN+" tastet den Boden ab.\n", ({TP}));
  return 1;
}

  void trank()
  {
   trank_da = 1;
  }
  
  void reset()
  {
   ::reset();
   trank();
  }

  int c_graben(string str)
  {
    notify_fail(BS("Wo moechtest Du graben?"));
    if(!((str == "erde") || 
    	  (str == "in erde") ||
    	  (str == "in boden") ||
    	  (str == "im boden") ||
        (str == "boden")))   
   {
     return 0;
   }
   if(present("trank", ENV(TP)) || (!trank_da))
   {
     write(BS("Du beginnst zu graben. Findest aber nichts."));
     tell_room(ENV(TP), TPN+" grabt in der Erde.\n", ({TP}));
     
     return -1;
    }
    else
    {
      write(BS("Du beginnst zu graben... Huch Du findest etwas und steckst es ein."));
      tell_room(ENV(TP), TPN+" grabt in der Erde und findet etwas.\n", ({TP}));
      trank_da = 0;
      CLONE (OBJ "trank.lpc",TP);
      return 1;
 
  }
 }
 
 //fehlende Details: schwefelgeruch, pflastersteine, werkzeug