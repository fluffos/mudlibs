#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg in Hypros" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem Weg in der Stadt Hypros. Der Boden besteht aus schoenen Pflastersteinen. "
    "Du kannst den Himmel noch immer nicht erkennen, da die Wolken noch immer so dicht sind. "
    "Genau vor Dir steht eine grosse Burg, in der wohl der Koenig hausen muss. Vielleicht kannst "
    "Du mit ihm reden.");
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "hypros", "stadt" }), //alles was zu Hypros gehört
    "Hypros ist eine Stadt, in der Menschen leben. Diese Menschen jagen Hydras.");
  
  AddDetail( ({ "menschen" }),
    "Ja, hier leben auch Menschen.");
    
  AddDetail( ({ "hydras", "kreaturen" }),
    "Die Hydras sind grosse drachenaehnliche Kreaturen mit einer verschiedenen "
    "Anzahl an Koepfen.");

  AddDetail( ({ "weg" }),
    "Hier fuehrt der Weg in 2 Richtungen. Was Dich dort wohl alles erwartet?");
    
  AddDetail( ({ "richtungen" }),
    "Nordwesten und Suedosten.");
  
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus vielen Pflastersteinen. Jeder Pflasterstein hat eine hochwertige "
    "Verzierung.");
  
  AddDetail( ({ "verzierung", "verzierungen" }),
    "Diese Verzierungen sind alle Unikate.");
  
  AddDetail( ({ "pflastersteine", "pflasterstein", "steine" }),
    "Jeder Pflasterstein ist einzigartig auf dieser Welt. Das bedeutet, dass die Pflastersteine "
    "nicht maschinell hergestellt werden, sondern per Hand.");
  
  AddDetail( ({ "himmel" }),
    "Den wuerdest Du wieder mal gerne sehen.");
    
  AddDetail( ({ "wolken" }),
    "Die Wolken sind sehr dicht hier.");
    
  AddDetail( ({ "burg" }),
    "In dieser Burg wohnt der Koenig von Hypros. Die Fenster der Burg sind sehr gross und schoen. "
    "Das Burgtor scheint offen zu sein, um jeden Einlass zu gewaehren.");
    
  AddDetail( ({ "burgtor", "tor" }),
    "Das Tor ist riesengross und besteht aus Holz. Es ist geoeffnet.");
    
  AddDetail( ({ "holz" }),
    "Fast das gesammte Tor wurde aus Holz getischlert.");
  
  AddDetail( ({ "fenster" }),
    "Die Fenster sind circa 5 Meter hoch. Kleine Bilder sind in die Fenster eingearbeitet. Es "
    "schaut so aus, als wuerden die Bilder eine Geschichte erzaehlen.");
  
  AddDetail( ({ "bilder" }),
    "Es sind viele kleine Bilder. Hin und wieder kommen auch etwas groessere Bilder vor. "
    "Man muss schon sagen, dass es wirklich schoene Bilder sind.");
    
  AddDetail( ({ "geschichte" }),
    "Was fuer eine Geschichte es ist, weisst Du nicht, aber sie muss schon etwas Wertvolles sein, "
    "wenn sie in den Fenstern der Burg verewigt worden ist.");

  AddSound( DEFAULT_SOUND,
    "Du kannst noch den Ruf des Meeres hören.");

  AddSmell( DEFAULT_SMELL,
    "Du kannst etwas Schwefel riechen.");

  AddSmell( ({ "schwefel" }),
    "Der Schwefelgeruch ist nicht sehr stark hier.");
    
///---DETAILS-ENDE-------------------------------------------------------------------  

  AddExit( "suedosten", "nach Suedosten#" + "./room6" );
  AddExit( "nordwesten", "nach Nordwesten#" + "./room4" );

}
