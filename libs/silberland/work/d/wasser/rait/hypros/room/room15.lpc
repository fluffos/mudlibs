inherit "std/pub";

#include "../def.h"

#include <pub.h>

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der Kneipe 'Zur aetzenden Hydra'");
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "filenko");
  SetProp(P_PUBKEEPER_NAME, "Filenko");
  SetProp(P_PUBMSG_NOKEEPER, "Filenko ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, 
  BS(
      "Du kaempfst gerade gegen Filenko. Deswegen kann er Dich auch nicht bedienen."
  ));
  
  SetProp(P_PUBMSG_NOINVITE, 
  (
      "Filenko hat gerade keine Zeit fuer neue Kunden.\n"
  ));
  
  SetProp(P_PUBMSG_FIGHTING, "Filenko kaempft gerade.\n");
  
  
/// DETAILS-ANFANG-------------------
  
   AddDetail( ({ "kneipe"  }),
     "Da befindest Du Dich gerade.");
  
   AddDetail( ({ "sesseln", "sessel"  }),
     "Es stehen vier Sesseln um einen Tisch herum. Die aber nur Gaeste benutzen duerfen.");
     
   AddDetail( ({ "tische", "tisch"  }),
     "Die Tische sind sauber und sogar gedeckt.");
     
   AddDetail( ({ "theke"  }),
     "Die Theke strahlt richtig. Obwohl sie den ganzen Tag benutzt wird.");
     
   AddDetail( ({ "staubkorn", "staub"  }),
     "So etwas gibt es hier nicht und wird es nie geben.");
     
   AddDetail( ({ "speisekarte", "karte"  }),
     "Schau sie Dir doch einmal genauer mit \"menue\" an.");
     
   AddDetail( ({ "boden" }),
    "Was soll man da nur sagen? Einfach sauber.");
    
   AddDetail( ({ "decke" }),
    "Auch da gibt es nichts besonderes zu sehen.");
    
   AddDetail( ({ "wand" }),
    "Hier haengt eine Speisekarte.");
  
   AddSound( DEFAULT_SOUND,
     "Die Kneipe ist derzeit nicht gut besucht, deswegen kannst Du fast nichts hoeren.");
    
   AddSmell( DEFAULT_SMELL,
     "Es riecht nach leckeren Speisen und Getraenken.");
   
   AddSmell( ({ "speisen", "getraenken", "speise", "getraenke", "getraenk", }),
     "Wenn Du wissen willst, was Filenko alles anbietet, gib einfach \"menue\" ein.");
   
///---DETAIL-ENDE---------------------

/// MEN�-ANFANG-----------------------

/// Getr�nke--------------------------

   AddDrink("Hydrasaft",  ({"hydrasaft", "saft"}),
            400, 25, 0, 8,
              ({"Filenko bringt Dir ein Glas mit Hydrasaft.\n",
              "&& trinkt genuesslich ein Glas Hydrasaft.\n"}));
              
   AddDrink("Hydrabier",  ({"hydrabier", "bier"}),
            700, 50, 7, 12,
              ({"Filenko zapft Dir einen Krug mit koestlichen Hydrabier.\n",
              "&& trinkt ein koestliches Hydrabier.\n"}));
              
   AddDrink("Hydraschleim",  ({"hydraschleim", "schleim"}),
            750, 60, 12, 15,
              ({"Filenko bringt Dir ein Glas mit gruenem Hydraschleim.\n",
              "&& trinkt ein Glas mit ekeligem Hydraschleim.\n"}));
              
   AddDrink("Hydraschnaps",  ({"hydraschnaps", "schnaps"}),
            900, 80, 15, 20,
              ({"Filenko bringt Dir ein kleines Glas mit Hydraschnaps.\n",
              "&& trinkt mit einen Schluck ein kleines Glas Hydraschnaps aus.\n"}));
              
/// FOOD------------------------------

   AddFood("Hydrasalat", ({"hydrasalat", "salat"}),
           300, 20, 8,
          ({"Filenko bringt Dir einen frischen Hydrasalat!\n"
          +BS("Der Salat schaut sehr frisch aus!"),
            "&& isst einen frischen Hydrasalat!\n"}));

   AddFood("Hydraei", ({"Hydraei", "ei"}),
           500, 30, 12,
          ({"Filenko bringt Dir ein duftendes Hydraei!\n"
          +BS("Das Ei duftet so gut, dass es vor ein paar Minuten gelegt "
              "worden sein muss!"),
            "&& isst ein duftendes Hydraei!\n"}));
            
   AddFood("Hydrasteak", ({"hydrasteak", "steak"}),
           1500, 75, 20,
          ({"Filenko bringt Dir ein saftiges, frisches Hydrasteak!\n"
          +BS("Das Steak ist so zart, dass die Hydra wahrscheinlich "
              "erst vor ein paar Stunden erlegt worden ist!"),
            "&& isst ein saftiges Hydrasteak!\n"}));
            
/// MEN�-ENDE-------------------------

  AddItem(NPC "filenko", REFRESH_DESTRUCT);
  AddExit( "sueden", ROOM "room14" );
  
}

string _query_int_long()
{
   string txt;

   txt = "Du stehst mitten in der Kneipe 'Zur aetzenden Hydra', ueberall stehen Sesseln und Tische herum. "
         "Vor Dir steht eine saubere Theke. Der Kneipenbesitzer achtet wohl auf die Sauberkeit "
         "seiner Kneipe. Du findest nicht mal das kleinste Staubkorn. Hinter der Theke haengt "
         "die Speisekarte, die Du mit \"menue\" lesen kannst.\n";
        
   if(QueryProp(P_PUBKEEPER_ID))
    {
      if(!present(QueryProp(P_PUBKEEPER_ID)))
       {
         txt += "Filenko ist gerade nicht da.";
       }
     else
       {
         txt += "Filenko steht hinter der Theke und wartet darauf Dich zu bedienen.";
       }
    }

  return BS(txt);
}