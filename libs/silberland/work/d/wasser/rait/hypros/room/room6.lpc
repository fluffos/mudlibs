#include "../def.h"

inherit "std/room";
inherit "/std/room/exits";

#include <properties.h>

void create() // Anführer
{
  ::create();

  SetProp( P_INT_SHORT, "Ein grosser Saal" );
  SetProp( P_INT_LONG,
    "Du stehst in einem grossen Saal. Der Boden besteht aus schoenen Marmorplatten. " 
    "An fast allen Waenden haengen grosse Fahnen herunter. Von der Decke haengt ein "
    "extrem grosser Kronleuchter und beleuchtet den ganzen Raum. Am hinteren Ende "
    "des Raumes kannst Du einen Thron und zwei Kerzenstaender erkennen. Hinter dem "
    "Thron siehst Du ein Wappen.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_TOWN]) );

////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "saal" }),
    "Ja, Du stehst in einem Saal.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus schoenen Marmorplatten.");
    
  AddDetail( ({ "marmorplatten", "platten"}),
    "Die Marmorplatten bestehen aus Marmor. Wer haette das gedacht?");
    
  AddDetail( ({ "marmor" }),
    "Marmor ist ein sehr wertvolles Gestein.");
    
  AddDetail( ({ "gestein" }),
    "Marmor ist zum Beispiel ein Gestein.");
    
  AddDetail( ({ "waende", "wand" }),
    "Hier haengen viele Fahnen.");
    
  AddDetail( ({ "fahnen", "fahne" }),
    "Diese Fahnen sind wirklich gross. Die Muster auf den Fahnen schauen komisch aus.");
    
  AddDetail( ({ "muster" }),
    "Die Muster ergeben ueberhaupt keinen Sinn. Das muss ganz moderne Kunst sein.");
    
  AddDetail( ({ "kunst" }),
    "Diese Kunst beherrschen nicht viele Leute.");
    
  AddDetail( ({ "leute" }),
    "Leider kennst Du keine, die diese Kunst beherrschen.");
    
  AddDetail( ({ "decke" }),
    "Ein grosser Kronleuchter haengt von der Decke.");
    
  AddDetail( ({ "kronleuchter", "leuchter" }),
    "Der Kronleuchter beleuchtet den ganzen Raum. Er besteht aus Kristallen und Kerzen.");
    
  AddDetail( ({ "kristalle" }),
    "Die Kristalle leiten das Licht von den Kerzen weiter.");
    
  AddDetail( ({ "kerzen", "kerze" }),
    "Die Kerzen scheinen zu brennen.");
    
  AddDetail( ({ "flammen" }),
    "Die Flammen sind sehr hell.");
    
  AddDetail( ({ "Licht" }),
    "Ohne dem Licht wuerdest Du hier nichts sehen.");
    
  AddDetail( ({ "thron" }),
    "Der Thron wurde aus dem schoensten Buchenholz geschnitzt. Er hat wunderschoene Verzierungen.");
    
  AddDetail( ({ "buchenholz", "holz" }),
    "Das ist das schoenste Buchenholz, das Du je gesehen hast.");
    
  AddDetail( ({ "verzierungen" }),
    "Die Verzierungen zeigen verschiedene Menschen und Tiere.");
    
  AddDetail( ({ "menschen" }),
    "In dieser Stadt leben auch Menschen.");
  
  AddDetail( ({ "stadt", "hypros" }),
    "Hypros ist eine Stadt, in der Menschen leben. Diese Menschen jagen Hydras.");
    
  AddDetail( ({ "hydras", "kreaturen" }),
    "Hydras sind grosse drachenaehnliche Kreaturen.");
    
  AddDetail( ({ "kerzenstaender" }),
    "Die zwei Kerzenstaender stehen links und rechts neben dem Thron.");
    
  AddDetail( ({ "tiere", "tier" }),
    "Hier hast Du noch kein einziges Tier gesehen.");
    
  AddDetail( ({ "wappen" }),
    "Das Wappen stellt einen Ritter dar, der ein Schwert in die Luefte haelt.");
    
  AddDetail( ({ "ritter", "schwert", "luefte" }),
    "Du kannst leider nichts genaueres erkennen.");
    
  AddDetail( ({ "raum" }),
    "Du stehst in einen grossen Saal. Der Boden besteht aus schoenen Marmorplatten. " 
    "An fast allen Waenden haengen grosse Fahnen herunter. Von der Decke haengt ein "
    "extreme grosser Kronleuchter und beleuchtet den ganzen Raum. Am hinteren Ende "
    "des Raumes kannst Du einen Thron und zwei Kerzenstaender erkennen. Hinter dem "
    "Thron siehst Du ein Wappen.\n");
    
  AddSound( DEFAULT_SOUND,
    "Du kannst ein leises Knistern hoeren.");

  AddSound( ({ "knistern" }),
    "Das knistern kommt von den Kerzen.");

  AddSound( ({ "kerze", "kerzen" }),
    "Jetzt weisst Du es endlich, es waren die Flammen der Kerzen.");

  AddSmell( DEFAULT_SMELL,
    "Ein schoener Duft liegt in der Luft.");

  AddSmell( ({ "duft" }),
    "Der Duft kommt von ein paar Kerzen.");

  AddSmell( ({ "kerzen", "kerze" }),
    "Du nimmst einen kraeftigen Zug von den Kerzen. Das riecht einfach gut.");

///---DETAILS-ENDE-------------------------------------------------------------------   

   AddExit( "nordwesten", "nach Nordwesten#" + "./room5" );

  AddItem(NPC "brotaox", REFRESH_DESTRUCT);
  AddItem(NPC "wache", REFRESH_DESTRUCT);
  AddItem(NPC "wache", REFRESH_DESTRUCT);
    
  AddId( "wache" );
  
}
