#include "../def.h"

inherit "std/room";

#include <properties.h>

#define MAX_PERSONEN 1
string *spieler_bank;

int heilung;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg in Hypros" );
  SetProp( P_INT_LONG,
    "Hier ist wohl der beliebteste Ort in der ganzen Stadt. Der Boden ist hier nicht mit  "
    "Pflastersteinen bedeckt, sondern mit kleinem Kies, damit Deine Fuesse etwas entspannen "
    "koennen. Am  Wegrand kannst Du ein riesiges Rosenbeet bewundern. Wenn Du in die Mitte "
    "blickst, kannst Du einen wunderschoenen Brunnen sehen. Um den Brunnen wurden viele "
    "Baenke aufgestellt, somit kann man immer den Brunnen betrachten.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "hypros", "stadt", "ort" }),
    "Hypros ist eine Stadt, in der Menschen leben. Diese Menschen jagen Hydras.");
  
  AddDetail( ({ "menschen" }),
    "Ja, hier leben auch Menschen.");
    
  AddDetail( ({ "hydras", "kreaturen" }),
    "Die Hydras sind grosse drachenaehnliche Kreaturen mit einer verschiedenen "
    "Anzahl an Koepfen.");

  AddDetail( ({ "himmel" }),
    "Du kannst einen kleinen Teil des Himmels erkennen.");
    
  AddDetail( ({ "teil" }),
    "Dieser Einblick ist etwas ganz besonderes hier. Du erkennst sogar einen Teil der Sonne.");
    
  AddDetail( ({ "sonne" }),
    "Der Teil der Sonne ist schoen. So etwas sieht man hier nicht oft.");
    
  AddDetail( ({ "boden" }),
    "Keine Pflastersteine sondern Kies schmueckt hier den Boden.");
    
  AddDetail( ({ "pflastersteine" }),
    "Es sind KEINE da.");
    
  AddDetail( ({ "kies" }),
    "Der Kies dient zur Entspannung der Fuesse.");
  
  AddDetail( ({ "fuesse" }),
    "Du solltest davon zwei haben.");
    
  AddDetail( ({ "brunnen" }),
    "Der Brunnen dient, wie fast alles hier zur Entspannung. Sein leises Plaetschern wirkt sehr entspannent."
    "Eine grosse Figur steht genau in der Mitte des Brunnens.");
    
  AddDetail( ({ "figur" }),
    "Die Figur stellt eine Art Ritter dar. Aus seinem Schwert dringt Wasser aus, "
    "damit der Brunnen nie leer ist.");
    
  AddDetail( ({ "ritter" }),
    "Dieser Ritter schaut nett aus. Aber Du weisst nicht, wer er ist.");
    
  AddDetail( ({ "schwert" }),
    "Aus dem Schwert fliest das Wasser in den Brunnen.");
    
  AddDetail( ({ "wasser" }),
    "Es ist glasklares Wasser.");
    
  AddDetail( ({ "baenke", "bank" }),
    "Die Baenke stehen um den Brunnen herum. Wenn Du willst, kannst Du Platz nehmen.");
  
  AddDetail( ({ "wegrand", "rand"}),
    "Ein riesiges Rosenbeet wurde hier gesetzt.");
  
  AddDetail( ({ "rosenbeet", "beet" }),
    "Das Rosenbeet schaut gepflegt aus. Alle Rosen scheinen zu bluehen.");
    
  AddDetail( ({ "rose", "rosen" }),
    "Die Rosen bluehen und zeigen ihre ganze Pracht.");
 
  AddDetail( ({ "pracht" }),
    "Die Rosen sind einfach bezaubernd.");
 
  AddDetail( ({ "mitte" }),
    "In der Mitte steht eine grosse Figur.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht hier fast Totenstille. Das einzige, was Du hoeren kannst, ist ein Plaetschern.");
    
  AddSound( ({ "totenstille" }),
    "Was heisst das wohl?... Du kannst einfach nichts hoeren!");

  AddSmell( DEFAULT_SMELL,
    "Hier wird der Schwefelgeruch durch den Geruch der Rosen ersetzt.");

  AddSmell( ({ "rosen", "rose" }),
    "Die Rosen riechen so schoen wie nie.");
  
  AddSmell( ({ "schwefel", "schwefelgeruch", "geruch" }),
    "Hier kannst Du den Schwefel nicht mehr riechen.");
    
///---DETAILS-ENDE-------------------------------------------------------------------  

  AddCmd( ({"setz","setze"}), "cmd_setz");
  AddCmd( ({"stehe","steh"}), "cmd_steh");
  AddCmd( ({"trink","trinke"}), "cmd_wasser");
  heilung = 0;
  
  AddItem(NPC "buergerin", REFRESH_DESTRUCT);
  AddExit ("westen", ([ EX_DEST:     ROOM "room10",
                            EX_TESTFUNC: "exit_test" ]) );
                            	
  spieler_bank = ({ });
}

void reset()
{
  if (!is_clone(TO)) return;  
  ::reset();

  heilung = 0;

}

int cmd_wasser(string str)
{
	notify_fail("Was moechtest Du trinken?\n");
	
  if(heilung >= 3) {tell_object(TP,
  BS("Der Brunnen ist leer, komm spaeter wieder.")); return 1;}

  if(!str || str == "") return 0;
  if(!(str == "wasser"))  return 0;

  if(TP->QueryProp(P_MAX_HP) == TP->QueryProp(P_HP))
  {
    tell_object(TP,"Lass das Wasser doch fuer andere Leute im Brunnen.\n");
    return -1;
  }

  tell_object(TP,"Du trinkst das Wasser des Brunnens und fuehlst Dich gleich besser.\n");
  TP->AddHp(20+random(40)); 
  TP->AddSp(25+random(40));              
  heilung++;

  return 1;
}

int exit_test(string dir)
{
  if(!TP)              return 1;
  if(!interactive(TP)) return 1;
  if(member(spieler_bank, getuuid(TP)) == -1) return 1;
  tell_object(TP, BS("Aber Du sitzt doch auf der Bank! Du solltest erst "
                     "aufstehen. "));

  return 0;
}

int cmd_setz(string str)
{
  notify_fail("Worauf moechtest Du Dich setzen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf bank"         ||
       str == "bank"             )) return 0;

  if(member(spieler_bank,getuuid(TP)) != -1)
  {
    tell_object(TP,BS("Aber Du sitzt doch schon!"));
    return -1;
  }
  spieler_bank += ({ getuuid(TP) });
  tell_object(TP,"Du setzt Dich auf die Bank und entspannst Dich.\n");

  TO->Message(TP->Name()+" setzt sich auf die Bank und entspannt sich.\n"
             ,MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

int cmd_steh(string str)
{
  notify_fail("Wovon moechtest Du aufstehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf"           ||
       str == "von bank auf"  )) return 0;

  if(member(spieler_bank,getuuid(TP)) == -1)
  {
    tell_object(TP,"Aber Du sitzt doch gar nicht auf der Bank?\n");
    return -1;
  }
  spieler_bank -= ({ getuuid(TP) });
  tell_object(TP, "Du stehst wieder von der Bank auf.\n");


  TO->Message(BS(TP->Name()+" steht von der Bank auf und es ist wieder ein "
              "Platz frei."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

void BecomesNetDead(object player)
{
  if(member(spieler_bank,getuuid(player)) != -1)
  {
    spieler_bank -= ({ getuuid(player) });

    TO->Message(player->Name()+" nickt ein und faellt von der Bank.\n"
               , MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
	spieler_bank -= ({ getuuid(player) });
}
