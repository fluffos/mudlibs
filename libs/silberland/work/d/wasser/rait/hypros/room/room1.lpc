#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() // Steg
{
  ::create();

  SetProp( P_INT_SHORT, "Der Steg von Hypros" );
  SetProp( P_INT_LONG,
    "Du stehst auf dem Steg von Hypros. Im Norden kannst Du das wunderschoene \n"
    "blaue Meer erblicken. Im Sueden jedoch beginnt die Stadt. Die Sonne kannst \n"
    "Du wegen der vielen Wolken nicht mehr erkennen. Was Dir hier gleich aufgefallen " 
    "ist, ist der komische Geruch. Was Dir hier noch sehr komisch vorkommt, ist "
    "der Boden.\n"
    "Eine Tafel wurde hier an einem Brett angebracht.\n" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "hypros", "stadt" }), //alles was zu Hypros gehört
    "Hypros ist eine Stadt, in der Menschen leben. Diese Menschen jagen Hydras.");
  
  AddDetail( ({ "menschen" }),
    "Ja, hier leben auch Menschen.");
    
  AddDetail( ({ "hydras", "kreaturen" }),
    "Die Hydras sind grosse drachenaehnliche Kreaturen mit einer verschiedenen "
    "Anzahl an Koepfen.");
  
  AddDetail( ({ "weg" }),
    "Ein ganz normaler Weg.");
      
  AddDetail( ({ "steg" }), //alles was zum Steg gehört
    "Der Steg besteht aus Holz."); 
    
  AddDetail( ({ "holz" }),
    "Du schaust etwas genauer auf das Holz und bemerkst, dass es sich um Buchenholz handelt.");
    
  AddDetail( ({ "buchenholz" }),
    "Buchenholz findet man meistens in einem Wald.");
    
  AddDetail( ({ "wald" }),
    "Du kannst hier keinen Wald entdecken.");

  AddDetail( ({ "meer" }), //alles was zum Meer gehört
    "Das Meer ist wunderschoen blau. Du kannst auch ein paar kleine Fische im Wasser erkennen."); 
  
  AddDetail( ({ "wasser" }),
    "Im Wasser kannst Du ein paar kleine Fische erkennen.");  
    
  AddDetail( ({ "fische", "fisch" }),
    "Es handelt sich um Hechte.");  
    
  AddDetail( ({ "hechte", "hecht" }),
    "Der Hecht ist ein Standfisch und haelt sich gerne in Ufernaehe der Fliessgewaesser, Seen und "
    "groesserer Teiche auf. Er muss sich wohl verschwommen haben.");
  
  AddDetail( ({ "standfisch" }),
    "Der Hecht ist zum Beispiel ein Standfisch.");
  
  AddDetail( ({ "ufer" }),
    "Das Ufer schaut sehr schoen aus. Keine Algen und auch kein grober Schmutz.");
    
  AddDetail( ({ "fliessgewaesser" }),
    "Fliessgewaesser sind Baeche, Seen und auch Teiche.");
  
  AddDetail( ({ "sonne" }),
    "Die Sonne erkennst Du wegen der vielen Wolken nicht mehr.");
  
  AddDetail( ({ "wolken" }),
    "Die Wolken sind so dicht, dass Du den Himmel und die Sonne nicht mehr erkennen kannst.");
  
  AddDetail( ({ "himmel" }),
    "Den kannst Du leider nicht erkennen."); 
    
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus hochwertigem Gestein.");
    
  AddDetail( ({ "gestein" }),
    "Es handelt sich eigentich nur um Pflastersteine, die aber aufwendige Verzierungen haben.");
    
  AddDetail( ({ "pflastersteine", "steine" }),
    "Pflastersteine verwendet man meistens, wenn man einen Weg legen will.");
    
  AddDetail( ({ "verzierung", "verzierungen" }),
    "Dieses Handwerk beherrschen nur wenige Leute im Silberland. Bis jetzt hat man noch nicht "
    "herausgefunden, wer diese Verzierungen gemacht hat. Vielleicht bist ja gerade Du derjenige, "
    "der dieses Geheimnis lueftet.");
    
  AddDetail( ({ "handwerk" }),
    "Derjenige, der dieses Handwerk beherrscht, muss jahrelange Uebung hinter sich haben.");
    
  AddDetail( ({ "leute" }),
    "Es koennte jeder sein.");
    
  AddDetail( ({ "geheimnis" }),
    "Wer hat wohl diese Steine verziert?");
    
  AddDetail( ({ "brett" }),
    "Eine Tafel haengt dran.");
  
  AddDetail( ({ "tafel" }),
    "Du kannst sie lesen.");

  AddReadDetail( ({ "tafel" }),
    "Der Kuestensegler kann Dich rund ums Silberland bringen.");

  AddSound( DEFAULT_SOUND,
    "Du kannst den Ruf des Meeres hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Du kannst etwas Schwefel riechen.");

  AddSmell( ({ "schwefel", "schwefelgeruch", "geruch" }),
    "Der Schwefelgeruch ist nicht sehr stark hier.");

///---DETAILS-ENDE-------------------------------------------------------------------    


  AddExit( "sueden", "nach Sueden#" + "./room2" );

}
