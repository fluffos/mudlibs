#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg in Hypros." );
  SetProp( P_INT_LONG,
    "Du stehst auf einem Weg in der Stadt Hypros. Der Boden besteht aus schoenen Pflastersteinen. "
    "Du kannst den Himmel noch immer nicht erkennen, da die Wolken noch immer so dicht sind. "
    "Am Rand des Weges kannst Du die Haeuser der Einwohner erkennen. Viele Menschen "
    "duerften hier nicht mehr leben, da es wenige Haeuser gibt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

////----DETAILS-ANFANG------------------------------------------------------

  AddDetail( ({ "hypros", "stadt" }),
    "Hypros ist eine Stadt, in der Menschen leben. Diese Menschen jagen Hydras.");
  
  AddDetail( ({ "menschen" }),
    "Ja, hier leben auch Menschen.");
    
  AddDetail( ({ "hydras", "kreaturen" }),
    "Die Hydras sind grosse drachenaehnliche Kreaturen mit einer verschiedenen "
    "Anzahl an Koepfen.");
    
  AddDetail( ({ "weg" }),
    "Hier fuehrt der Weg in 2 Richtungen. Was Dich dort wohl "
    "alles erwartet?");
    
  AddDetail( ({ "richtungen" }),
    "Osten und Sueden.");
  
  AddDetail( ({ "wolken" }),
    "Die Wolken sind so dicht, dass Du den Himmel und die Sonne nicht mehr erkennen kannst.");
  
  AddDetail( ({ "himmel" }),
    "Den kannst Du leider nicht erkennen."); 
  
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus vielen Pflastersteinen. Jeder Pflasterstein hat eine hochwertige "
    "Verzierung.");
  
  AddDetail( ({ "verzierung", "verzierungen" }),
    "Diese Verzierungen sind alle Unikate.");
  
  AddDetail( ({ "pflastersteine", "pflasterstein" }),
    "Jeder Pflasterstein ist einzigartig auf dieser Welt. Das bedeutet, dass die Pflastersteine "
    "nicht maschinell hergestellt werden, sondern per Hand.");
  
  AddDetail( ({ "himmel" }),
    "Den wuerdest Du wieder mal gerne sehen.");
    
  AddDetail( ({ "wolken" }),
    "Die Wolken sind sehr dicht hier.");
    
  AddDetail( ({ "rand", "weg" }),
    "Ein paar Haeuser wurden hier erbaut.");
    
  AddDetail( ({ "haeuser" }),
    "Die Haeuser sind nur aus Stein gebaut. Man kann schon sagen, dass die Haeuser schon aelter "
    "sind, da sich schon etwas Moos angesetzt hat.");
    
  AddDetail( ({ "stein", "steine" }),
    "Grosse, schwere Steine. Welche Steine es sind, kannst Du nicht mehr erkennen.");
  
  AddDetail( ({ "moos" }),
    "Da sich schon Moos an den Steinen bildet, kann man schon sagen, dass es alte Haeuser sind.");
  
  AddDetail( ({ "einwohner" }),
    "Viele Einwohner sind schon laengst ausgewandert. Sie wollten hier einfach nicht mehr leben.");

  AddSound( DEFAULT_SOUND,
    "Du kannst ein leises Plaetschern hoeren.");
      
  AddSound( ({ "plaetschern" }),
    "Du glaubst, dass das Plaetschern von Osten kommt.");

  AddSmell( DEFAULT_SMELL,
    "Du kannst etwas Schwefel riechen.");

  AddSmell( ({ "schwefel", "schwefelgeruch", "geruch" }),
    "Der Schwefelgeruch ist nicht sehr stark hier.");
    
///---DETAILS-ENDE-------------------------------------------------------------------  

  AddExit( "osten", "nach Osten#" + "./room10" );
  AddExit( "norden", "nach Norden#" + "./room8" );

}
