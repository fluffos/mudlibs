#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Hydramesser");
  SetProp(P_LONG,
    "Das Hydramesser ist so gross, dass man es schon fast wie ein "
    "Schwert tragen kann. Es besteht aus Eisen und Knochen einer Hydra.\n");
  SetProp(P_INFO, 
     BS("Mit dem Hydramesser veraetzt man seinen Gegner."));
  SetProp(P_NAME, "Hydramesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hydramesser", "messer"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 50 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([ MAT_IRON:40, MAT_BONE:60 ]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 15,
  	                              A_STR: 13,
  	                              SR_SEER: 1]) );
}