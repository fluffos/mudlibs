#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Hydrazahn");
  SetProp(P_LONG,
    "Der Hydrazahn wurde wohl einer Hydra ausgerissen. Man verwendet ihn wie ein Messer." );
  SetProp(P_INFO, 
     BS("Mit dem Hydrazahn veraetzt man seinen Gegner."));
  SetProp(P_NAME, "Hydrazahn");
  SetProp(P_GENDER, MALE);
  AddId( ({"hydrazahn", "zahn"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 70);
  SetProp(P_WC_FIX, 35 );
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_ACID}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) );
}