#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Hydraklinge");
  SetProp(P_LONG,
    "Die Hydraklinge wurde aus Titan geschmiedet, der Griff ist aus Knochen einer Hydra geschnitzt. "
    "Die Klinge wurde in den Rachen einer Hydra gesteckt, um sie noch haerter zu machen. "
    "Diese Waffe ist wohl die maechtigste einhaendige Waffe, die Du je gesehen hast!\n" );
  SetProp(P_INFO, 
    BS("Mit der Hydraklinge veraetzt man seinen Gegner."));
  SetProp(P_NAME, "Hydraklinge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hydraklinge", "klinge", "schwert"}) );

  AddDetail( ({"griff"}),
    "Der Griff wurde aus Knochen von Hydras geschnitzt. Er weisst sehr alte Zeichen auf.");

  AddDetail( ({"zeichen"}),
    "Du kannst diese Zeichen nicht verstehen, aber Du kannst Dir etwas gutes vorstellen.");

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 186);
  SetProp(P_WC_FIX, 60);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_ACID}) );
  SetProp(P_NR_HANDS, 1);
  SetProp( P_MATERIAL, ([ MAT_BONE : 20, MAT_ADAMANT : 80 ]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);

  SetProp(P_WC_BONUS, (["Brotaox": 350]) );
  
  SetProp(P_QUALITY_DECAY, 80);

  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 24,
																	A_STR: 20,
																	SR_SEER: 1]) );
}