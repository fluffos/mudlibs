inherit "std/npc";
inherit "std/npc/spells.lpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Brotaox, der Anfuehrer von Hypros");
  SetProp(P_LONG,
    "Du stehst vor Brotaox, dem Anfuehrer von Hypros.\n"
    "Er ist ein recht stark gebauter, grosser Mensch. Sein Gesicht wird von drei "
    "grossen Narben uebersaet. Er muss schon einige harte Kaempfe bestritten haben. "
    "Durch seine hohe Kampferfahrung wird er kein leichter Gegner fuer Dich sein. ");

////----DETAILS-ANFANG------------------------------------------------------
  
  AddDetail( ({ "gesicht", "narbe", "narben" }),
    "In seinem Gesicht sind drei grosse Narben. Die Narben muss er von einen Kampf mit "
    "einem starken Monster haben.");
  
  AddDetail( ({ "kampf", "kampferfahrung", "erfahrung" }),
    "Brotaox hat schon sehr viele Kaempfe gewonnen. Er wird sicher ein "
    "sehr harter Gegner.");
    
  AddDetail( ({ "monster" }),
    "Wenn man sich die Narben genauer anschaut, kannst Du feststellen, dass "
    "es eine Hydra gewesen sein muss.");
    
  AddDetail( ({ "hydra", "hydras" }),
    "Die Hydras sind grosse drachenaehnliche Kreaturen mit einer verschiedenen "
    "Anzahl an Koepfen.");
    
///---DETAILS-ENDE-------------------------------------------------------------------  
  
  SetProp(P_NAME, "Brotaox");
  SetProp(P_GENDER, MALE);
  AddId(({"brotaox", "anfuehrer"}));

  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  AddClass( ({CL_HUMAN}) );
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -450);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5, T_RANGE_MAX:30]) );
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_ACID:     -0.5, DT_POISON: -0.5]) );

  SetProp(P_MMSGIN, " kommt aus seinem Zimmer heraus");
  SetProp(P_MMSGOUT, " geht wieder in sein Zimmer hinein");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Brotaox");

  AddInfo(DEFAULT_INFO, "will nichts mit Dir zu tun haben.\n");
  
//-------------------------Fragen Anfang-------------------------

  AddInfo( ({"koenig"}), 
     "antwortet: Der Koenig ist nicht zu sprechen!\n" );
     
  AddInfo( ({"hydras", "hydra" }), 
     "antwortet: Die Hydras sind sehr gemeine Kreaturen.\n" );
     
  AddInfo( ({"tor"}), 
     "antwortet: Das Tor wird gerade repariert, da es schon extrem veraltet ist.\n" );
     
  AddInfo( ({"tiros"}), 
     "antwortet: Ach... Ihr duerft Tiros nicht glauben. Er ist einfach nur verrueckt!\n" );
     
  AddInfo( ({"wachen", "wache"}), 
     "antwortet: Die Wachen beschuetzen normalerweise den Koenig. "
     "Da ich aber gerade der wichtigste Mensch bin, beschuetzen sie mich!\n" );
  
//-------------------------Fragen Ende---------------------------

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Brotaox braucht Deine schlechten Sachen nicht.\n" }) );

  SetChats(4, ({
    "Brotaox schaut Dich mit seinem boesen Blick an.\n"
   ,"Brotaox ist heute sehr schlecht gelaunt.\n" }) );
    
  SetAttackChats(20, ({
    "Brotaox sagt: Das war Dein letzter Fehler!\n"}) );

  SUID;
  CLONEME(WEAPON "hydraklinge" );
  command("zuecke klinge");
  
  CLONEME(ARMOUR "hydrapanzer" );
  CLONEME(ARMOUR "hydraschild" );
  CLONEME(ARMOUR "hydrastiefel" );
  command("trage alles");

  AddDefender("wache");
  
  SetProp(P_SPELLRATE,40);

  AddDefaultSpell(1, 1, DS_PARALYZE,
  "Brotaox wirbelt mit seinem Schwert herum. Du fuehlst Dich irgendwie benebelt.\n",
  "Brotaox wirbelt mit seinem Schwert herum. @WER fuehlt sich irgendwie benebelt.\n");
  
  AddSpell(9, 800,
  "Brotaox nimmt seinen Schild fester in die Hand und rammt Dich mit seinem Schild.\n",
  "Brotaox nimmt seinen Schild fester in die Hand und rammt @WEN mit seinem Schild.\n",
  DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]) );
  
}

init()
{ ::init();
  if (TP && TP->id("wache")) AddDefender(TP); }

void InformDefend(object enemy) { Kill(enemy); }