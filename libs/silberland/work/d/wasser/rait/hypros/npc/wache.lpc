inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

#include "/gilden/waldlaeufer/ranger_tasks.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Wache des Anfuehrers");
  SetProp(P_LONG,
    "Diese Wache beschuetzt ihren Anfuehrer. Sie wurde von Brotaox "
    "selbst ausgebildet. Sobald Brotaox angegriffen wird, kommt die "
    "Wache und wird ihn um jeden Preis verteidigen. Die Wache "
    "steht stramm und bewegt sich keinen Millimeter. Man koennte "
    "glatt meinen, dass es sich hierbei um eine Statue handelt, doch sie ist keine.");

////----DETAILS-ANFANG------------------------------------------------------
 
  AddDetail( ({ "brotaox", "anfuehrer" }),
    "Brotaox ist der Anfuehrer von Hypros.");
    
  AddDetail( ({ "hypros", "stadt" }),
    "Hypros ist eine Stadt, in der Menschen leben. Diese Menschen jagen Hydras.");
 
  AddDetail( ({ "hydra", "hydras" }),
    "Die Hydras sind grosse drachenaehnliche Kreaturen mit einer verschiedenen "
    "Anzahl an Koepfen.");
    
  AddDetail( ({ "statue", "statuen" }),
    "Es sind keine Statuen sondern Menschen.");
    
  AddDetail( ({ "menschen", "mensch" }),
  	"Menschen leben im ganzen Silberland.");
  	
  AddDetail( ({ "silberland" }),
 	  "Du befindest Dich im Silberland.");
 	  
///---DETAILS-ENDE-------------------------------------------------------------------  
    
  set_living_name("wache");
  SetProp(P_NAME, "Wache");
  SetProp(P_GENDER, MALE);
  SetProp( P_DEFENDERS, "brotaox", "wache");
  AddId(({"wache"}));

  create_default_npc(30);
  
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  AddClass( ({CL_HUMAN}) );
  
  SetProp(P_SIZE, 185);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, 400);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_DIE_MSG,  " hat versagt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Eine Wache von Brotaox");
  SetProp(P_LOG_INFO, "rait/wache");

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"konzentriert sich auf seinen Anfuehrer.\n"
     ,"steht stramm.\n"}));

//-------------------------Fragen Anfang-------------------------

  AddInfo( ({"koenig"}), 
     "antwortet: Ich beschuetze den Koenig. Nur ist er leider nicht mehr hier.\n" );
     
  AddInfo( ({"brotaox", "anfuehrer"}), 
     "antwortet: Brotoax herrscht derzeit ueber Hypros. Ich werde ihn verteidigen!\n" );

//-------------------------Fragen Ende---------------------------

  SetAttackChats( 3,
    ({"Die Wache sagt: Ich werde nicht versagen!\n"
     ,"Die Wache stellt sich vor Brotaox.\n"}));


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Wache ist nur auf seinen Anfuehrer konzentriert.\n" }) );

  SUID;
  CLONEME("/d/ebene/obj/waffe/kampfschwert" );
  command("zuecke schwert");
  
  CLONEME("/p/armour/shield/stahlschild" );
  command("trage alles");
  
  AddDefender("brotaox");

  AddCmd("zeige|zeig&buerger|buergerin|bewohner&schuppe|hydraschuppe|die schuppe|die hydraschuppe", "cmd_schuppe", "Wem willst du was zeigen?");

}

  init()
     {
       ::init();
       if (TP && TP->id("brotaox")) AddDefender(TP);
     }

  void InformDefend(object enemy)
     {
       Kill(enemy);
     }

     public int cmd_schuppe() {
      if(!present(RANGER_TASK_SCHUPPE2, TP)) return 0;
    
      write(BS("Du zeigst "+name(WEM, 1)+" die Schuppe."));
      say(BS(TPN+" zeigt "+name(WEM, 1)+" eine Schuppe."));
      switch(random(7)) {
        case 0: command_me("sag Oh, das ist definitiv die Schuppe eineer Hydra. Sie hausen normalerweise tief in den Hoehlen der Berge."); break;
        case 1: command_me("sag Ah! Eine Hydraschuppe. Das sind gefaehrliche Bestien. Zum Glueck wurden fast alle ausgerottet."); break;
        case 2: command_me("sag Ohje. Hydren gelten als sehr gefaehrlich und lustig. Diese Schuppe muss aus den Hoehlen in den Bergen stammen."); break;
        case 3: command_me("sag So eine Schuppe habe ich schon lange nicht mehr gesehen. Es heisst, dass in den Bergen ein Krueppel gesehen wurde, der sich dort herumtreibt."); break;
        case 4: command_me("sag Diese Schuppe weit weg von der Insel zu fiden verheisst nichts Gutes. Sie stammt von einer Hydra aus den Hoehlen in den Bergen."); break;
        default: command_me("sag Hmm... Ja, das ist eine Hydraschuppe. Mehr weiss ich aber auch nicht darueber. Die sind doch alle ausgerottet?"); break;
      }
    
      return 1; 
    }