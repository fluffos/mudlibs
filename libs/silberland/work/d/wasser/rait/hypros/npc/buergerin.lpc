inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"
#include <npcmaster.h>

#include "/gilden/waldlaeufer/ranger_tasks.h"

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Buergerin");
  SetProp(P_LONG,
    "Die Buergerin schaut wunderschoen aus. Ihr Koerperbau ist einfach perfekt.");

  SetProp(P_NAME, "Buergerin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5, T_RANGE_MAX:30]) );
  AddId( ({ "buergerin" }) );

  create_default_npc(20+random(5));
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch" );
  AddClass( ({CL_HUMAN}) );
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_LOG_INFO, "rait/buergerin");
  SetProp(P_NO_SCORE, 1);
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Buergerin bedankt sich bei Dir.\n" }) );

  SetProp(P_MNPC_AREA, ({ ROOM "room2", ROOM "room3", ROOM "room4", ROOM "room5",
                          ROOM "room7", ROOM "room8", ROOM "room9", ROOM "room10",
                          ROOM "room11", ROOM "room12", ROOM "room13", ROOM "room14",
                          ROOM "room16", ROOM "room18", ROOM "room19", ROOM "room20" }) );

  SetProp(P_MNPC_WAIT, ({ 15, 20, 20 }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room2");
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS|MOV_MOVES|MOV_INCHAT|MOV_OUTDOORS|MOV_INDOORS);

  AddInfo(DEFAULT_INFO, "beachtet Dich gar nicht.\n" );

//-------------------------Fragen Anfang-------------------------

  AddInfo( ({"koenig"}), 
    "antwortet: Der Koenig scheint krank zu sein.\n" );
  
  AddInfo( ({"brotaox", "anfuehrer"}), 
     "antwortet: Brotaox ist der derzeitige Herrscher von unserer Stadt.\n" );

//-------------------------Fragen Ende---------------------------

  SetAttackChats( 4, ({
    "Die Buergerrin kreischt: Das ist Dein Untergang!\n",}) );

    SUID;
    CLONEME(WEAPON "hydramesser");
    command("zuecke messer");
    CLONEME(ARMOUR "hydraumhang");
    CLONEME(ARMOUR "hydrastiefel");
    command("ziehe alles an");

    AddCmd("zeige|zeig&buerger|buergerin|bewohner&schuppe|hydraschuppe|die schuppe|die hydraschuppe", "cmd_schuppe", "Wem willst du was zeigen?");
}

public int cmd_schuppe() {
  if(!present(RANGER_TASK_SCHUPPE2, TP)) return 0;

  write(BS("Du zeigst "+name(WEM, 1)+" die Schuppe."));
  say(BS(TPN+" zeigt "+name(WEM, 1)+" eine Schuppe."));
  switch(random(7)) {
    case 0: command_me("sag Oh, das ist definitiv die Schuppe eineer Hydra. Sie hausen normalerweise tief in den Hoehlen der Berge."); break;
    case 1: command_me("sag Ah! Eine Hydraschuppe. Das sind gefaehrliche Bestien. Zum Glueck wurden fast alle ausgerottet."); break;
    case 2: command_me("sag Ohje. Hydren gelten als sehr gefaehrlich und lustig. Diese Schuppe muss aus den Hoehlen in den Bergen stammen."); break;
    case 3: command_me("sag So eine Schuppe habe ich schon lange nicht mehr gesehen. Es heisst, dass in den Bergen ein Krueppel gesehen wurde, der sich dort herumtreibt."); break;
    case 4: command_me("sag Diese Schuppe weit weg von der Insel zu fiden verheisst nichts Gutes. Sie stammt von einer Hydra aus den Hoehlen in den Bergen."); break;
    default: command_me("sag Hmm... Ja, das ist eine Hydraschuppe. Mehr weiss ich aber auch nicht darueber. Die sind doch alle ausgerottet?"); break;
  }

  return 1; 
}