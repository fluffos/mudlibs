inherit "std/npc";
inherit "std/npc/spells.lpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tiros, der Ladenbesitzer");
  SetProp(P_LONG,
    "Tiros ist der Besitzer des Ladens in Hypros.\n"
    "Wenn er grade nicht Kunden bedient, verfaellt er in sein groesstes Hobby."
    "Er sammelt Waffen aller Art. Keiner weiss, warum oder weshalb er die Waffen sammelt.");
    
  SetProp(P_NAME, "Tiros");
  set_living_name("tiros");
  SetProp(P_GENDER, MALE);
  AddId(({"tiros", "ladenbesitzer", "besitzer"}));

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  AddClass( ({CL_HUMAN}) );
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, 500);
  SetProp(P_ARTICLE,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_ACID:      -0.5, DT_POISON: -0.5]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "muss leider kurz weg");
  SetProp(P_LOG_INFO, "rait/tiros");

  AddInfo(DEFAULT_INFO, "Kann ich Dir behilflich sein?","fragt Dich: ");

//-------------------------Fragen Anfang-------------------------

  AddInfo( ({"koenig"}), 
     "antwortet: Der Koenig wurde von Brotaox versteckt!\n" );

  AddInfo( ({"brotaox", "anfuehrer"}), 
     "antwortet: Er ist ein Boesewicht! Er will die Herrschaft ueber Hypros.\n" ); 
  
//-------------------------Fragen Ende---------------------------

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Tiros will Deine Sachen nicht haben.\n" }) );

  SetAttackChats(10, ({
    "Tiros schreit: Jetzt werde ich Dich in Fetzen reisen!\n"}) );


  SUID;
  CLONEME(WEAPON "hydrazahn" );
  command("zuecke zahn");

  SetProp(P_SPELLRATE,35);
  
        AddDefaultSpell(2, 100, DS_DISARM,
        "Tiros versucht Deine Waffe zu stehlen, aber er laesst sie fallen!\n",
        "Tiros versucht @WESSEN Waffe zu stehlen, aber er laesst sie fallen!\n");

}
