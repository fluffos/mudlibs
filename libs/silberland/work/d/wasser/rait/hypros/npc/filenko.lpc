inherit "std/npc";
inherit "std/npc/spells.lpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Filenko, der Kneipenbesitzer");
  SetProp(P_LONG,
    "Filenko ist der Kneipenbesitzer von 'Zur aetzenden Hydra'.\n"
    "Er schaut relativ freundlich aus, da er einen Dauergrinser hat."
    "Er wird Dich sehr gerne bedienen, egal was Du bestellst.");
    
  set_living_name("filenko");
  SetProp(P_NAME, "Filenko");
  SetProp(P_GENDER, MALE);
  AddId(({"filenko", "kneipenbesitzer", "besitzer"}));

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  AddClass( ({CL_HUMAN}) );
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, 500);
  SetProp(P_ARTICLE,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_ACID:      -0.5, DT_POISON: -0.5]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "muss leider kurz weg");
  SetProp(P_LOG_INFO, "rait/filenko");

  AddInfo(DEFAULT_INFO, "Was kann ich Dir bringen?","fragt Dich: ");

//-------------------------Fragen Anfang-------------------------

  AddInfo( ({"koenig"}), 
     "antwortet: Von ihm habe ich schon lange nichts mehr gehoert.\n" );
     
  AddInfo( ({"brotaox", "anfuehrer"}), 
     "antwortet: Er ist ein sehr strenger Anfuehrer.\n" );

//-------------------------Fragen Ende---------------------------

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Filenko will Deine Sachen nicht haben.\n" }) );
    
  SetAttackChats(10, ({
    "Filenko sagt: Willst Du nicht lieber etwas zu trinken haben?\n"}) );

  SetProp(P_SPELLRATE,25);

        AddDefaultSpell(10, 500, DS_SLOW,
        "Filenko wirft einen vereisten Krug nach Dir.\n",
        "Filenko wirft einen vereisten Krug nach @WEM.\n");

}
