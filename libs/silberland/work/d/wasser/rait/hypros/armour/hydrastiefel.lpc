#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein paar Hydrastiefel");
  SetProp(P_LONG,
     "Die Hydrastiefel sind etwas ganz besonderes. Sie bestehen aus "
     "reinstem Hydraleder.\n");
  SetProp(P_INFO, 
  "Die Hydrastiefel schuetzen Dich besser vor den veraetzenden Speichel der Hydras.\n" );
  SetProp(P_NAME, "Hydrastiefel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hydrastiefel", "stiefel"}) );
  
    AddDetail( ({"hydraleder", "leder"}),
    "Hydraleder wird aus der Haut der Hydras gewonnen. Das Hydraleder schimmert im "
    "Licht.");
    
  AddDetail( ({"licht"}),
    "Durch das Licht faellt Dir etwas Besonderes auf.");
    
  AddDetail( ({"etwas"}),
    "Etwas Saeure ist noch auf dem Leder zurueck geblieben, das erklaert auch, warum "
    "das Hydraleder schimmert.");
    
  AddDetail( ({"saeure"}),
    "Das muss noch etwas Saeure von der erlegten Hydra sein. Die Saeure ist aber schon "
    "eingetrocknet.");
  
  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([ MAT_LEATHER : 100 ]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_ACID:1]));
  
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) );	
}
