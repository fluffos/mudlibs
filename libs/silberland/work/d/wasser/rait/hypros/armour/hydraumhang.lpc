#include "../def.h"

inherit "std/armour";

void create() 
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Hydraumhang");
  SetProp(P_LONG,
     "Der Hydraumhang ist etwas ganz besonderes. Er besteht aus "
     "reinstem Hydraleder.\n");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Hydraumhang");
  AddId( ({"umhang", "hydraumhang"}) );
  
    AddDetail( ({"hydraleder", "leder"}),
    "Hydraleder wird aus der Haut der Hydras gewonnen. Das Hydraleder schimmert im "
    "Licht.");
    
  AddDetail( ({"licht"}),
    "Durch das Licht faellt Dir etwas Besonderes auf.");
    
  AddDetail( ({"etwas"}),
    "Etwas Saeure ist noch auf dem Leder zurueck geblieben, dass erklaert auch, warum "
    "das Hydraleder schimmert.");
    
  AddDetail( ({"saeure"}),
    "Das muss noch etwas Saeure von der erlegten Hydra sein. Die Saeure ist aber schon "
    "eingetrocknet.");
  
  SetProp(P_INFO,
     "Der Hydraumhang schuetzt Dich besser vor den veraetzenden Speichel der Hydras.\n");
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 6 );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, ([ MAT_LEATHER : 100 ]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_ACID:1]));
  
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) );	
}
