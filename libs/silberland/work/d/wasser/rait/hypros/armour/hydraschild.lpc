#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Hydraschild");
  SetProp(P_LONG,
    "Der Hydraschild ist etwas ganz besonderes. Er besteht aus Adamant und Hydraleder. "
    "Am Rand des Schildes kann man eine Verzierung erkennen. In der Mitte ist eine grosse "
    "Hydra. Der Schild wird im Kampf gegen Hydras einen starken Schutz darstellen.\n" );
  SetProp(P_INFO, 
  BS("Der Hydraschild schuetzt Dich besser vor den veraetzenden Speichel der Hydras."));
  SetProp(P_NAME, "Hydraschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"hydraschild", "schild"}) );
  
    AddDetail( ({"hydraleder", "leder"}),
    "Hydraleder wird aus der Haut der Hydras gewonnen. Das Hydraleder schimmert im "
    "Licht.");
    
  AddDetail( ({"licht"}),
    "Durch das Licht faellt Dir etwas Besonderes auf.");
    
  AddDetail( ({"etwas"}),
    "Etwas Saeure ist noch auf dem Leder zurueck geblieben, das erklaert auch, warum "
    "das Hydraleder schimmert.");
    
  AddDetail( ({"saeure"}),
    "Das muss noch etwas Saeure von der erlegten Hydra sein. Die Saeure ist aber schon "
    "eingetrocknet.");
    
  AddDetail( ({"verzierungen"}),
    "Es handelt sich um viele kleine Symbole. Sie dienen wohl zum Schutz des Traegers.");
    
  AddDetail( ({"symbole"}),
    "Es sind Schutzsymbole. Der Traeger wird durch die Schutzsymbole geschuetzt.");

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 25);
  SetProp(P_MATERIAL, ([ MAT_ADAMANT: 90, MAT_LEATHER: 10 ]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_ACID:1]));
  
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 17,
  	                              A_STR: 15,
  	                              SR_SEER: 1]) );
}
