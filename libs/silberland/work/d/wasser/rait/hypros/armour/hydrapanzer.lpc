#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();
 
  SetProp(P_SHORT, "Ein Hydrapanzer");
  SetProp(P_LONG,
    "Der Hydrapanzer ist etwas ganz besonderes. Er besteht aus Adamant und Hydraleder. "
    "Auf dem Panzer sind viele Verzierungen zu erkennen. Er wurde gemacht, um gegen die "
    "Hydras zu kaempfen.\n" );
  SetProp(P_INFO, 
    BS("Der Hydrapanzer schuetzt Dich besser vor den veraetzenden Speichel der Hydras."));
  SetProp(P_NAME, "Hydrapanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"hydrapanzer", "panzer"}) );
  
  AddDetail( ({"hydraleder", "leder"}),
    "Hydraleder wird aus der Haut der Hydras gewonnen. Das Hydraleder schimmert im "
    "Licht.");
    
  AddDetail( ({"licht"}),
    "Durch das Licht faellt Dir etwas Besonderes auf.");
    
  AddDetail( ({"etwas"}),
    "Etwas Saeure ist noch auf dem Leder zurueck geblieben, das erklaert auch, warum "
    "das Hydraleder schimmert.");
    
  AddDetail( ({"saeure"}),
    "Das muss noch etwas Saeure von der erlegten Hydra sein. Die Saeure ist aber schon "
    "eingetrocknet.");
  
  AddDetail( ({"verzierungen"}),
    "Es handelt sich um viele kleine Symbole. Sie dienen wohl zum Schutz des Traegers.");
    
  AddDetail( ({"symbole"}),
    "Es sind Schutzsymbole. Der Traeger wird durch die Schutzsymbole geschuetzt.");

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 35);
  SetProp(P_MATERIAL, ([ MAT_LEATHER: 30, MAT_ADAMANT:70 ]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+([DT_ACID:1]));
  
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 20,
  	                              SR_SEER: 1]) );
}
