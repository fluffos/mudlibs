inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer Anhoehe" );
  SetProp(P_INT_LONG,
    "Jetzt stehst Du mitten auf der Spitze einer Anhoehe im Westen der "
    "Insel. Der Boden besteht auch hier aus einer Wiese. Im Osten kannst "
    "Du vage eine weitere Anhoehung, ja wenn nicht sogar einen Berg "
    "erkennen! Ansonsten sind direkt westlich von Dir gesehen tiefe "
    "Klippen, die besonders gefaehrlich sind! Unter den Klippen wuerdest "
    "Du dann noch den Strand und das Meer vermuten.");    
  SetProp(P_LIGHT, random(2));
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:7, ENV_TERRAIN:TT_HILL ]) );

  AddDetail( "himmel",
    "Der Himmel ist duester viele Nebelschwaden verdunkeln die Gegend, "
    "doch sie scheinen hier einige Loecher frei zu lassen.");
  AddDetail( ({"nebel" , "nebelschwaden" }), 
    "Normalerweise verdunkeln sie die Gegend vollstaendig, doch auf "
    "dieser Anhoehe kannst Du einige Loecher in den Nebelschwaden "
    "erkennen.");
  AddDetail( "loecher",
    "Ab und zu kannst Du tatsaechlich Loecher in dem sonst so dichten "
    "Nebel erkennen, so dass sich die Sonne ja mal durch diese blicken "
    "lassen koennte!");
  AddDetail( "klippen",
    "Die sind ziemlich tief und Du solltest auf keinen Fall naeher rangehen!");
  AddDetail( "anhoehung",
    "Vielleicht ein Berg?");
  AddDetail( "berg",
    "Um das herauszufinden solltest Du mal die Insel erkunden.");
  AddDetail( "insel",
    "Du befindest Dich mitten auf ihr.");
  AddDetail( "meer", 
    "Das befindet sich westlich vom Strand und hat bestimmt ganz "
    "kaltes Wasser!");
  AddDetail( "wasser",
    "Die Temperatur des Wassers ist bestimmt kalt.");
  AddDetail( "temperatur",
    "BRRR!");
  AddDetail( "gegend",
    "Diese Gegend ist nicht so arg duster wie andere auf dieser Insel.");
  AddDetail( "boden",
    "Die Dir schon gewohnte Wiese ist auch auf dieser Anhoehe verbreitet.");
  AddDetail( "wiese",
    "Das Gras sieht von der Farbe mal abgesehen recht normal aus.");
  AddDetail( "farbe",
    "Ein total verblichener Gruenton.");
  AddDetail( "gruenton",
    "Seltsam.");
  AddDetail( ({"anhoehe"}) ,
  QueryProp(P_INT_LONG));
  AddDetail( "gras",
    "Von der Farbe mal abgesehen sieht das Gras ganz normal aus.");
  AddDetail( "fall",
    "Wag es ja nicht die Klippe runterzuklettern!");
  AddDetail( "norden",
    "Dort befindet sich der andere Teil der Wiese.");
  AddDetail( "teil",
    "Sie hat scheinbar mehrere Teile.");
  AddDetail( "teile",
    "Sie scheinen die Insel zu umhuellen.");
  AddDetail( "westen",
    "Dort sind die Klippen und das Meer kannst Du nur noch erahnen.");
  AddDetail( ({"algen" , "fische" }), 
    "Die befinden sich doch im Meer!");
  AddDetail( "strand",
    "Der befindet sich unterhalb der Klippen.");
  AddDetail( "spitze",
    "Ja, Du befindest Dich tatsaechlich schon auf der Spitze der Anhoehe.");
  AddDetail( "osten",
    "Du vermutest dort einen Berg.");
  AddDetail( "klippe",
    "Irgendetwas faellt Dir an ihr auf.");
  AddDetail( "irgendetwas",
    "Vielleicht ist es ein Loch?");
  AddDetail( "loch",
    "Das kriegst Du am besten raus, indem Du die Klippe runterkletterst!");
  AddDetail( "sonne", 
    "Direkt sehen kannst Du sie ja nicht. Doch wenige ihrer Strahlen kannst "
    "Du inmitten dieser Dunkelheit erkennen.");
  AddDetail( "strahlen",
    "Vielleicht siehst Du sie nur deshalb, weil Du auf dieser Anhoehe etwas "
    "hoeher bist und so den Nebelschwaden entfliehen kannst.");
  AddDetail( "dunkelheit",
    "Sie ummantelt die gesamte Insel! Jedoch scheint sie an dieser Stelle "
    "etwas nachlaessig gewesen zu sein.");
  AddDetail( "stelle",
    "Na auf dieser Anhoehe!");
     
  AddSmell(DEFAULT_SMELL,
    "Hier riechst Du die salzige Meerluft.");
  AddSmell("meerluft",
    "Sie riecht nach Salz.");
  AddSmell( ({"salz", "algen", "fische", "fisch"}),
    "Der typische Meergeruch eben.");
  AddSmell("meergeruch",
    "Der beinhaltet Algen, Salz, Fische und alles, was so kreucht und fleucht.");
  
  AddSound(DEFAULT_SOUND, 
    "Es ist hier totenstill - nur ganz leise kannst du das Meer rauschen hoeren.");
  AddSound("meer",
    "Ganz leise hoerst Du es im Westen rauschen - besonders stark immer dann, "
    "wenn die Wellen brechen.");
  AddSound("wellen",
    "Sobald sie brechen geben sie ein starkes Rauschen von sich.");
  AddSound("rauschen",
    "Es ist so laut, dass du es bis hierher hoeren kannst!");
  
  AddCmd("kletter|klettere&klippe&runter", "cmd_klippe",
         "An was willst Du denn runter klettern?", 
         "Na raufklettern kannst Du von dieser Position aus sicher nicht!");
         
  AddItem(NPC "vana",   REFRESH_DESTRUCT);
  AddItem(NPC "blueti", REFRESH_DESTRUCT);           
  
  
  AddExit("norden",      ROOM "wi1");
  AddExit("nordosten",   ROOM "wi2");
  AddExit("nordunten",   ROOM "wi1");
  AddExit("nordostunten",ROOM "wi2");
  SetProp(P_HIDE_EXITS, ({"norden", "nordosten"}) );

  
 
 }
  
  
  int cmd_klippe(string str)
{
  write(BS(
    "Direkt bei den ersten Kletterbemuehungen findest Du mit Deinen Fuesesen "
    "keinen Halt mehr und rutscht in das Loch, das du schon von oben gesehen "
    "hattest!"));
  write("\n\n");
  TP->move(ROOM "hoehle",M_GO,"die Klippen runter und ist verschwunden",
                              "klettert",
                              "kommt hereingerutscht");
  VANAMASTER->Msg(TPN+" rutscht in die Hoehle");
  return 1;
}   
