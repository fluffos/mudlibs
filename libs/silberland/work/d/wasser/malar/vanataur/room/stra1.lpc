inherit "std/room";


#include "../def.h"

int fackel_da;

void create()
{
  ::create();

  fackel_da = 5;

  SetProp(P_INT_SHORT,"An einem Strandhang.");
  SetProp(P_INT_LONG,
    "Du stehst auf einem schraegen Hang, der den Strand und eine Wiese "
    "verbindet. Der Himmel ist duester und die Sonne kannst Du hinter "
    "den Nebelschwaden noch nicht mal erahnen. Auf dem Boden erkennst "
    "Du einige Muscheln und ab und an kann man einige Grasbueschel und "
    "andere Pflanzen entdecken. Im Sueden zieht sich der Strand noch "
    "ein kleines Stueck weiter und endet dann abrupt, weil einige Klippen "
    "den Weg abbrechen.");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:12, ENV_TERRAIN:TT_PLAIN ]) );

  AddDetail( ({ "muschel", "muscheln" }),
    "Ueberall sind die verschiedensten Muscheln verstreut. Du erinnerst Dich "
    "bei diesem Anblick an Deine Kindheit, in der Du so gerne Muscheln gesammelt hast.");
  AddDetail( ({ "sand", "sandkorn", "sandkoerner" }),
    "Ein wenig oestlich geht der Sand in eine Wiese ueber.");
  AddDetail( "himmel",
    "Der Himmel ist duester und voller Nebelschwaden.");
  AddDetail( ({"nebel" , "nebelschwaden" }), 
    "Die Nebelschwaden verdustern die ganze Gegend.");
  AddDetail( ({"strand"}) ,
  QueryProp(P_INT_LONG));
  AddDetail( "kindheit",
    "In Deiner Kindheit hast Du immer Muscheln gesammelt, wenn Du mal "
    "an einen Strand gekommen bist.");
  AddDetail( "wiese",
    "Die Wiese sieht gar nicht mehr aus wie eine richtige Wiese. Bei einer "
    "Wiese denkt man doch normalerweise an gruenes Gras, strahlende Blumen "
    "und an eine schoen warme Sonne - Du siehst jedoch nur eine dunkle Ebene, "
    "die mal eine Art Wiese gewesen ist.");
  AddDetail( "osten",
    "Dort befindet sich eine Wiese.");
  AddDetail( "pflanzen",
    "Unter anderem nur kleine Grasbueschel.");
  AddDetail( ({ "grasbueschel", "bueschel", "gras" }),
    "Vereinzelt spriessen ein paar von ihnen aus dem Sand hervor. "
    "Ein Grashalm sieht anders als die anderen aus!");
  AddDetail( "grashalm",
    "Seine Spitze ist ganz dunkel.");
  AddDetail( "spitze",
    "Wenn Gras vertrocknet, wird es normalerweise gelb. Diese Spitze "
    "ist aber mit schwarzer Farbe durchflossen! Hier scheint etwas "
    "passiert zu sein, dass es zu schwarzem Gras kommen kann.");
  AddDetail( "farbe",
    "Voellig schwarz.");
  AddDetail( "etwas",
    "Das musst Du wohl erforschen.");
  AddDetail( "boden",
    "Der sandige Boden steigt oestlich und geht in eine Wiese ueber. "
    "Bestimmt schwemmen an diesem Strand einige interessante Dinge an!");
  AddDetail( "anblick",
    "Er weckt in Dir die Erinnerung an Deine Kindheit.");
  AddDetail( "zeiten",
    "Das ist lange her.");
  AddDetail( "hang",
    "Der ist etwas oestlich von Dir.");
  AddDetail( "sonne",
    "Wegen der Nebelschwaden kannst Du sie nicht sehen.");
  AddDetail( "gegend",
    "Alles ist duster!");
  AddDetail( "sueden",
    "Da ist noch ein Stueck Strand.");
  AddDetail( "stueck",
    "Naja nur so lang, bis die Klippen den Weg abschneiden.");
  AddDetail( "weg",
    "Er zieht sich bis zu den Klippen hin.");
  AddDetail( "klippen",
    "Sie brechen den Strandweg im Sueden abrupt ab.");
  AddDetail( ({"blumen","loewenzaehne"}),
    "Gaenseblumen, Loewenzahn usw.");
  AddDetail( "ebene",
    "Sie sieht echt nicht mehr wie eine Wiese aus!");
  AddDetail( "gaenseblumen",
    "Klein und weiss.");
  AddDetail( "loewenzahn",
    "Auch solche kannst Du im Osten nicht erkennen.");
  AddDetail( "strandweg",
    "Der zieht sich im Sueden lang bis zu den Klippen.");
  AddDetail( "art",
    "Was fuer eine kannst Du leider nicht erkennen.");
  AddDetail( "stelle",
    "Stellen zum Schwimmen musst Du Dir selber suchen.");
  AddDetail( "wasser",
    "Sieht kalt aus.");
  AddDetail( "schwimmen",
    "Eine Technik um ueber Wasser bleiben zu koennen.");
  AddDetail( "technik",
    "Ganz einfach zu lernen.");
  AddDetail( ({"erinnerung", "erinnerungen"}),
    "Du erinerst Dich daran, dass Du in Deiner Kindheit gerne Muscheln "
    "gesammelt hast. Das waren noch Zeiten!");
  AddDetail("zeiten",
    "Lang lang ists her.");
  AddDetail("dinge",
    "Vielleicht sollte man einfach im Sand graben?");
  AddDetail("meer",
    "Das Meer befindet sich im Westen.");
  AddDetail("westen",
    "Dort ist das Meer!");
  AddDetail("salzwasser",
    "Eine Menge davon findet sich im Meer wieder!");
  AddDetail("menge",
    "Ja, eine riesige Menge.");
    
  AddSmell(DEFAULT_SMELL, "Es riecht nach Meer.");
  AddSmell( "meer", 
    "Wie Meerwasser eben riecht - salzig.");
  AddSmell( ({"meerwasser","besten"}),
    "Wenn Du es so genau riechen willst, such am Besten eine Stelle, "
    "an der du problemlos ins Wasser kommst.");
  
  AddSound(DEFAULT_SOUND, "Das Meer rauscht leise vor sich hin. Ansonsten "
                          "ist es hier merkwuerdig still.\n");
  AddSound( "meer",
    "Es rauscht leise vor sich hin. ");
    
  AddCmd("grab|grabe&in|im&sand|boden", "cmd_kerzen",
         "Du koenntest tatsaechlich ein mal im Sand graben.");
  //AddCmd("nimm&fackel", "cmd_fackel");

  SetProp(P_HIDE_EXITS, ({"osten"}) );
  
  AddExit("sueden",   ROOM "stra2");
  AddExit("ostoben",  ROOM "wi1");
  AddExit("osten",    ROOM "wi1");
  

  
 
 }
  
int cmd_kerzen(string str)
{
    //Wozu 2 mal fuenf Kerzen?
  if(deep_present("vana_kerzen", TP))
    {
      write(BS(
        "Du beschliesst, nicht noch ein weiteres Mal herumzubuddeln, "
        "da Du eh schon fuenf Kerzen in Deinen Besitz genommen hast."));
      Message(BS(TPN+" streckt kurz die Haende aus und zieht sie "
                     "direkt wieder zurueck."),
                     MSGFLAG_VISUAL|MSGFLAG_NO_TP);  
      VANAMASTER->Msg(TPN+" versucht erneut, Kerzen zu bekommen");
      return -1;
    }
  //Sofern man keine fuenf Kerzen hat und auch die Quest macht -> Kerzen
  if(!deep_present("vana_kerzen", TP) && present("\nvana_quest", TP))
    {
      write(BS(
       "Du graebst wie ein Wilder im Sand herum und stoesst nach ein wenig "
       "Buddeln auf einige haerte Gegenstaende. Du packst sie und ziehst "
       "sie aus dem Sand und steckst sie direkt mal ein..\n"));
     Message(BS(TPN+" wuehlt wie ein Wilder im Sand herum und zieht einige "
                    "versandete Gegenstaende aus dem Sand und steckt sie "
                    "direkt ein."),
                    MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
     CLONE(OBJ "kerzen", TP);
     write_file(LOG "questverlauf", 
       "("+ctime(time())+") "+TPN+" findet fuenf Kerzen.\n");
     VANAMASTER->Msg(TPN+" findet 5 Kerzen");
     return 1;
    }
  //Man hat keine fuenf Kerzen und macht die Quest nicht:
  write("Du graebst wie verrueckt in dem Sand herum, findest jedoch nichts.\n");
  Message(BS(TPN+" wuehlt wie wild im Sand herum, scheint jedoch "
                 "nichts gefunden zu haben und gibt verzweifelt auf."),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP);     
  VANAMASTER->Msg(TPN+" sucht Kerzen ohne QOBJ");
  return -1;
}

