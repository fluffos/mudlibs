inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "An einer Bergwand." );
  SetProp(P_INT_LONG, 
    "Du befindest Dich mitten an der Bergwand. Du traust Dich gar nicht nach "
    "unten zu sehen, denn Du bist schon recht hoch. Du kannst nur hoffen Dein "
    "Ziel bald zu erreichen, denn langsam schwinden Deine Kraefte.");    

  SetProp(P_LIGHT,0);
  SetProp(P_NOMAGIC,100);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_HILL ]) );
}

varargs string GetExits(object viewer)
{
  return 0;
} 

  
void init()
{
  ::init();
  if(TP && interactive(TP)) 
  VANAMASTER->Msg(TPN+" beginnt mit dem Aufstieg");
    call_out("klettern", 0, TP, 1);
}

void klettern(object player, int satz)
{
  string s;
  if(!player)                return;
  if(!interactive(player))   return;
  if(ENV(player) != TO)      return;

  switch(satz)
  {
    case 1:
      s = "Du machst Dich aechzend an den Aufstieg.";
    break;
    case 2:
      s = "Du greifst kraeftig in die Einkerbungen und kletterst an ihnen hoch.";
    break;
    case 3:
      s = "Du kletterst...";
    break;
    case 4:
      s = "... und kletterst ...";
    break;
    case 5:
      s = "Du rutscht ab und haengst nur noch mit einer Hand an der Wand!!";
    break;
    case 6:
      s = "Du findest wieder Halt und ziehst Dich das letzte Stueck hoch. ";
    break;
    default: 
          TP->move(ROOM "berg2", M_GO, "nach oben","klettert",
                             "zieht sich ueber den Rand");
     VANAMASTER->Msg(TPN+" ist nun auf dem Berg");
     TP->do_exhaust(370);
     return;
  }
  s = break_string(s, 78, 1);
  player->Message(s);
  satz = satz + 1;
  call_out("klettern", 4 , player, satz);
}