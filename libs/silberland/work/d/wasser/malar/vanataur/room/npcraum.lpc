inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein NPC-Lagerraum" );
  SetProp(P_INT_LONG, 
    "Hier kommen z.b. Sandwuermer hin, wenn sie ihn die Erde kriechen. Falls "
    "Du hier mal als Spieler auf welche Art und Weise auch immer hinkommen "
    "solltest, bitte den naechsten Magier Deines Vertrauens darum, dass er "
    "Dich doch hier bitte raustranst. Ansonsten tipp einfach <berg>.");  
    AddExit("berg", ROOM "berg2");  

 
}
  
