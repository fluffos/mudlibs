inherit "std/room";


#include "../def.h"

int fisch;

void create()
{
  ::create();
  fisch=1;

  SetProp(P_INT_SHORT, "Im eiskalten Meer" );
  SetProp(P_INT_LONG,
    "Jetzt befindest Du dich mitten im eiskalten Meer. Im Osten siehst Du "
    "den Strand mit der hohen Klippe. Schaumige Wellen schwappen Dir ins "
    "Gesicht und Du prustest das salzige Wasser aus dem Mund. Am liebsten "
    "wuerdest Du Dich jetzt einfach nur noch treiben lassen und hoffen, "
    "dass Du auf diese Weise endlich von dieser Insel wegkommen kannst. "
    "Als Du kurz nach unten schaust, um zu gucken, ob Du noch stehen kannst "
    "entdeckst Du eine Luftblase im Wasser herumirren! Ab und zu bemerkst "
    "Du ein paar glitschige Fische, die an Dir vorbeiglitschen. Auch im Westen "
    "kannst Du leider kein Stueck Land erkennen, an dass Du dich retten "
    "koenntest. Aber ist da am Horizont nicht etwas?");    
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:2, ENV_TERRAIN:TT_WATER ]) );
  AddDetail( ({ "fisch", "fische" }),
    "Manche Leute sollen ja Fische mit blossen Haenden fangen koennen!");
  AddDetail( "himmel",
    "Der Himmel ist duester und voller Nebelschwaden.");
  AddDetail( ({"nebel" , "nebelschwaden" }), 
    "Die Nebelschwaden verdustern die ganze Gegend.");
  AddDetail( "klippe",
    "Um die genauer untersuchen zu koennen, solltest Du am Strand stehen.");
  AddDetail( "strand",
    "Der ist im Osten.");
  AddDetail( "osten",
    "Das ist der Strand mit den Klippen.");
  AddDetail( "klippen",
    "Sehen hoch aus.");
  AddDetail( ({"wellen", "welle" }),
    "Sie schwappen Dir manchmal in den Mund und Du spuckst nur herum.");
  AddDetail( "wasser",
    "Das ist eisig kalt - am besten gehst Du bald wieder raus.");
  AddDetail( ({"grund", "boden" }),
    "Du kannst ihn kaum erkennen.");
  AddDetail( "mund",
    "Du bist nur am spucken. Vielleicht solltest Du ein mal kraeftig alles "
    "Wasser ausspucken, was sich so angesammelt hat.");
  AddDetail( "weise",
    "Die musst Du wohl erst noch rausfinden..");
  AddDetail( "insel",
    "Sie befindet sich im Osten. Zur Zeit kannst Du jedoch nur die grosse "
    "Klippe erkennen, die Du schon eben am Strand gesehen hast.");
  AddDetail( "gesicht",
    "Das ist ganz nass - stoert Dich aber nicht weiter.");
  AddDetail( "zeit",
    "Zur Zeit siehst Du nur die kahle Klippe.");
  AddDetail( "meer",
    "Du befindest Dich mitten im kalten Nass."),
  AddDetail( "nass",
    "Salzwasser.");
  AddDetail( "luftblase",
    "Sie scheint im Wasser herumzuirren. Ihre Huelle schimmert in allen "
    "Regenbogenfarben wie zum Beispiel Rot und Lila.");
  AddDetail( "huelle",
    "Sie schimmert in allen Regenbogenfarben.");
  AddDetail( "beispiel",
    "Eben nur ein Beispiel fuer die ganzen Regenbogenfarben.");
  AddDetail( "rot",
    "Sie glitzert nur selten Rot, das Lila scheint interessanter zu sein!");
  AddDetail( "lila",
    "Wenn die Blase Lila schillert, ist in Dir ein Gefuehl der Waerme - warum "
    "weisst Du auch nicht. Komisch!");
  AddDetail( "gefuehl",
    "Ein sehr schoenes Gefuehl, was Du gerne oefters verspueren wuerdest.");
  AddDetail( "waerme",
    "Waerme ist doch eine tolle Sache.");
  AddDetail( "sache",
    "Vielleicht sollte man ihr mal wortwoertlich auf den Grund gehen und sich "
    "die seltsame Blase anschauen, indem man zu ihr runtertaucht?");
  AddDetail( "regenbogenfarben",
    "Na zum Beispiel Rot und Lila.");
  AddDetail( "blase",
    "Irgendwas scheint an ihr nicht ganz normal zu sein.");
  AddDetail( "haende",
    "Ja mit blossen Haenden! Das muss man sich mal vorstellen.");
  AddDetail( "leute",
    "Vielleicht muss man es ja gar nicht sonderlich lernen, sondern sollte "
    "es einfach ein mal ausprobieren?");
  AddDetail( "gegend",
    "Ja alles ist so dunkel.");
  AddDetail( "westen",
    "Da ist nur das weite Meer und der Horizont.");
  AddDetail( "horizont",
    "Du kannst Etwas am Horizont erkennen.");
  AddDetail( "etwas",
    "Ist es vielleicht ein Schiff?");
  AddDetail( "schiff",
    "Wenn es das wirklich waere, ist es ja vielleicht die Rettung!");
  AddDetail( "rettung",
    "Sie ist so zum greifen nahe! Vielleicht sollte man das Schiff "
    "heranwinken?");
  AddDetail( ({ "stueck", "land" }),  
    "Du siehst leider nur das im Osten. Im Westen kannst Du jedoch nur "
    "das Meer und seinen Horizont sehen.");
  AddDetail( "nase",
    "Sie ist voller Wasser, ab und zu kannst Du jedoch trotzdem was riechen."),
  AddDetail( ({ "ohr", "ohren" }),
    "Die sind voller Wasser, da die Wellen immer gegen sie klatschen!");
  AddDetail("salzwasser",
    "Schmeckt salzig!");
   
  AddSmell(DEFAULT_SMELL,
    "Sofern Du ueberhaupt bei dem Wasser in Deiner Nase etwas riechen kannst, "
    "riecht es hier nach Salz und typischem Meergeruch.");
  AddSmell("salz",
    "Salz riecht nach ... Salz.");
  AddSmell("meergeruch",
    "Algen, Fische und eben alles, was so im Meer ist.");
    
  AddSound(DEFAULT_SOUND,
    "Das Meer rauscht um Dich herum und die Wellen platschen "
    "an Deinem Ohr herum.");
  AddSound("wellen",
    "Sie klatschen an Deine Ohren und das knallt manchmal ganz schoen stark!");
  AddSound("meer",
    "Das rauscht vor sich hin.");  

  AddCmd("schwimm|schwimme&zurueck","cmd_schwimmen",
         "Wohin willst Du denn schwimmen?");
  AddCmd("schwimm|schwimme&nach|zum|ans&osten|ufer", "cmd_schwimmen",
         "Wohin willst Du denn schwimmen?");
  AddCmd("fang|fange&fisch|fische","cmd_fangen",
         "Was willst Du fangen?");
  AddCmd("spuck|spucke&wasser&aus","cmd_spucken",
         "Was willst Du ausspucken?","Willst du das Wasser ausspucken?");
  AddCmd("tauch|tauche&runter|hinunter|unter","cmd_tauchen",
         "Willst du hinunter tauchen?");
  AddCmd("wink|winke&schiff&heran","cmd_winken");
     
         
}
  
void reset()
{
  ::reset();
  fisch=1;
}  
  
int cmd_schwimmen(string str)
{
  write(BS(
    "Du watest pudelnass aus dem eiskalten Wasser."));
  TP->move(ROOM "stra2",M_GO,"an das trockene Land","schwimmt",
    "watet aus dem Wasser herein");
  return 1;
}   

int cmd_fangen(string str)
{
  object ob;
  if (fisch)
  {
    fisch=0;
    write("Du schaffst es in der Tat einen Fisch zu fangen!\n");
    ob = clone_object(OBJ   "fisch");
    if (!ob->move(PL,M_GIVE))
      ob->move(PL,M_GIVE)!=1;
    VANAMASTER->Msg(TPN+" faengt einen Fisch");
    return 1;
  }
  write("Leider entwischt Dir der Fisch!\n");
  VANAMASTER->Msg(TPN+" versucht erneut, einen Fisch zu fangen");
  return 1;
}

int cmd_spucken(int str)
{
	
  write(BS(
    "Du spuckst mehrmals kraeftig aus und fuehlst Dich gleich um einiges besser. "
    "Leider bemerkst Du, dass dein Spucken nicht den gewuenschten Effekt erzielt "
    "und Dir trotz des Spuckens immer wieder neues Wasser in den Mund kommt. Du "
    "beschliesst es einfach sein zu lassen."));
  VANAMASTER->Msg(TPN+" spuckt im Meer herum");
  return 1;
}


int cmd_tauchen(string str)
{
  write(BS(
    "Du holst noch mal tief Luft und tauchst durch das eiskalte Wasser in "
    "Richtung Grund. Ganz ploetzlich siehst Du die Blase schon vor Dir und "
    "Du freust Dich jetzt schon, dass du runtergetaucht bist, denn die Blase "
    "schillert in allen Regenbogenfarben und Du kommst aus dem Staunen gar "
    "nicht mehr heraus. Daher starrst Du wohl eine ganze Zeit auf die schoene "
    "Blase und faellst in eine Art Trance. Du erwachst jedoch aus ihr, als Du "
    "ploetzlich verzweifelt Wasser schluckst, da Du keine Luft mehr in Deinen "
    "Lungen hast. Du tauchst also so schnell es geht nach oben, um Luft zu "
    "kriegen. Endlich bist Du oben und saugst gierig die Luft in Deine Lunge. "
    "Du spuerst jedoch noch immer den Schmerz in Deiner Lunge, die vielleicht "
    "eine recht lange Zeit ohne Sauerstoff hat auskommen muessen!"));
  TP->AddHp(-random(32));
  VANAMASTER->Msg(TPN+" taucht im Meer, LP-Verlust");
  return 1;
}

int cmd_winken(int str)
{
  write(BS(
    "Du winkst verzweifelt das Schiff heran. Du verstehst endlich, dass man "
    "durch die dichten Nebelschwaden, welche die Insel umringen, wohl nicht "
    "gesehen werden kann. Enttaeuscht gibst Du Deinen Plan auf und suchst "
    "weiterhin nach einer anderen Moeglichkeit, von dieser verfluchten Insel "
    "zu kommen."));
  VANAMASTER->Msg(TPN+" versucht das Schiff heranzuwinken");
  return 1;
}