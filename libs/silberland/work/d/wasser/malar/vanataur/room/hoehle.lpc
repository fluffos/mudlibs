inherit "std/room";

#include "../def.h"

string *spieler_moos; 

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer engen Hoehle" );
  SetProp(P_INT_LONG,
    "Hui! Du bist in einer hell erleuchteten Hoehle gelandet! Das "
    "Loch schien wohl nur so etwas wie ein Eingang gewesen zu sein. "
    "Die Hoehle selber ist ziemlich klein und ein paar Bluetenwesen "
    "kauern hier herum. Ein Bluetenwesen faellt Dir jedoch besonders "
    "auf, da es um einiges groesser und allgemein imposanter als die "
    "anderen wirkt. Die Hoehlendecke ist ganz schoen tief, daher "
    "solltest Du auf deinen Kopf aufpassen! Am Ende der Hoehle kannst "
    "Du ein Moosgeflecht erkennen, auf dem ein sehr grosses Wesen "
    "sitzt. Das helle Licht scheint aus einer kleinen Wasserpfuetze "
    "zu kommen!?"); 
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:8, ENV_TERRAIN:TT_CAVE ]) );

  AddDetail( ({"decke" , "hoehlendecke" }), 
    "Sie ist zum einen ziemlich tief, schon allein aus dem Grund sollte "
    "man aufpassen. Ausserdem haben sich wohl im Laufe der Jahrhunderte "
    "einige Stalaktiten gebildet und koennten so Deinem Kopf "
    "gefaehrlich werden!");
  AddDetail( "laufe",
    "Ein sehr langer Weg war es bis hierhin.");
  AddDetail( "weg",
    "Ja.. Sehr lang.");
  AddDetail( ({"wesen" , "bluetenwesen" }), 
    "Scheint gerade keins da zu sein!");
  AddDetail( "boden", 
    "Der Boden besteht scheinbar aus Stein. Im hinteren Teil der Hoehle "
    "bedeckt eine Moosschicht den Boden.");
  AddDetail( "moosschicht",
    "Es scheint ein richtiges Moosgeflecht zu sein!");
  AddDetail( "grund",
    "Na den Grund muss man Dir hoffentlich nicht erlaeutern. Ist doch wohl "
    "klar, dass man starke Kopfschmerzen bekommen koennte, wenn man sich "
    "an den Stalaktiten stossen sollte.");
  AddDetail( "waende",
    "Die sind voellig kahl.");
  AddDetail( "stein",
    "Vielleicht Sandstein?");
  AddDetail( "sandstein",
    "Du kannst die Art des Steins nicht erkennen.");
  AddDetail( ({"art" , "sorten", "arten" }), 
    "Es gibt viele Arten von Steinen - also viele Sorten.");
  AddDetail( "teil",
    "Im hinteren Teil befinden sich die Bluetenwesen auf einem Moosgeflecht. "
    "Im vorderen Teil kannst Du im Boden nur eine Roehre erkennen.");
  AddDetail( "roehre",
    "Es sieht wie ein Ausgang aus.");
  AddDetail( "ausgang",
    "Er fuehrt in einen Tunnel!");
  AddDetail( "tunnel",
    "Du kannst nur erkennen, dass er eine Biegung nach Westen macht.");
  AddDetail( "westen",
    "So siehst Du zwar nur die Wand, vermutest aber dahinter den Strand mit "
    "seinen Klippen.");
  AddDetail( "klippen",
    "Vielleicht befindest Du Dich ja hinter ihnen?");
  AddDetail( "strand",
    "Der muesste sich nach Deine Orientierung im Westen befinden.");
  AddDetail( "orientierung",
    "Die kann auch Fehler aufweisen.");
  AddDetail( "fehler",
    "Du wirst sie schon frueh genug bemerken..");
  AddDetail( "kopfschmerzen",
    "Alle Schmerzen solltest Du vermeiden.");
  AddDetail( "schmerzen",
    "Sie koennten zum Beispiel durch das Zusammenstossen mit den Stalaktiten "
    "hervorgerufen werden.");
  AddDetail( "zusammenstossen",
    "Wenn du es umbedingt ausprobieren willst, stoss doch mal Deinen Kopf "
    "gegen die Stalaktiten!");
  AddDetail( "beispiel",
    "Das war doch nur eines von vielen ;-)");
  AddDetail( "jahrhunderte",
    "Jedenfalls eine sehr lange Zeit!");
  AddDetail( "zeit",
    "Wie lange kannst Du leider nicht einschaetzen. Auf jeden Fall jedoch "
    "ein paar Jahrhunderte.");
  AddDetail( "fall",
    "Auf jeden Fall jedoch ein paar Jahrhunderte.");
  AddDetail( "stalaktiten",
    "Es sind Gesteinskegel, die sich aus der Decke bohren. Sie koennen Dir "
    "nicht wirklich gefaehrlich werden, ausser Du bist wirklich so bloed "
    "und stoesst absichtlich Deinen Kopf an ihnen. ");
  AddDetail( "kopf",
    "Dein Kopf laedt gerade dazu ein, ihn gegen einen Stalaktiten zu stossen!");
  AddDetail( "gesteinskegel",
    "Damit sind die Stalaktiten gemeint!");
  AddDetail( "biegung",
    "Die Biegung verlaeuft nach Westen.");
  AddDetail( "eingang",
    "Du bist sonst immer Nischen oder Ritzen gewoehnt - Ein Loch ist "
    "jedenfalls mal was anderes!");
  AddDetail( ({"ritzen" , "nischen" }), 
    "Du kannst zu Deinem Glueck keine erkennen!");
  AddDetail( "glueck",
    "Unbezahlbar.");
  AddDetail( "wand",
    "Jede Wand hier ist total kahl und oede. Einfach langweilig.");
  AddDetail( ({"hoehle"}) ,
  QueryProp(P_INT_LONG));
  AddDetail( "ende",
    "Im hinteren Teil der Hoehle findet setzen die Waende der Hoehle "
    "ein abruptes Ende.");
  AddDetail( "licht",
    "Seltsamerweise scheint es aus der Pfuetze zu kommen!?");
  AddDetail( "loch",
    "Durch das viele herumrutschen hast Du vergessen, von wo aus Du in "
    "diese Hoehle gerutscht bist. Bis jetzt kannst Du das Loch, durch "
    "das Du wohl reingekommen bist, nicht entdecken.");
  AddDetail( ({"moos" , "moosgeflecht" }), 
    "Auf dem Moos befinden sich die Bluetenwesen, lassen jedoch ein gutes "
    "Stueck des Mooses frei, so dass man sich bestens auf das Moos legen "
    "koennte, was sicherlich sehr entspannend waere.");
  AddDetail( ({"pfuetze" , "wasserpfuetze" }), 
    "Das Licht in dieser Hoehle scheint tatsaechlich aus dem Wasser in der "
    "Pfuetze zu kommen!");
  AddDetail( "wasser",
    "Es ist hell erleuchtet und ist nur ein paar Zentimeter tief. Auf dem "
    "Grund kannst Du jedoch das staerkste Leuchten sehen.");
  AddDetail( "zentimeter",
    "Nicht allzu tief.");
  AddDetail( "grund",
    "Auf ihm scheint Irgendetwas das starke Leuchten zu verursachen.");
  AddDetail( "leuchten",
    "Die Quelle befindet sich scheinbar auf dem Grund der Wasserpfuetze.");
  AddDetail( "quelle",
    "Such sie!");
  AddDetail( "irgendetwas",
    "Es sieht aus wie ein Bluetenkelch!?");
  AddDetail( "bluetenkelch",
    "Er scheint magischer Natur zu sein!");
  AddDetail( "natur",
    "Die Natur spielt auf dieser Insel wirklich verrueckt. Vielleicht ist "
    "ja ein grosses Fragment der vanataurischen Macht in diesen Bluetenkelch "
    "eingegangen, um jedenfalls ein wenig Licht in diese Dunkelheit zu bringen.");
  AddDetail( "insel",
    "Du befindest Dich zu Deiner Verzweiflung auf ihr.");
  AddDetail( "verzweiflung",
    "Die wird schon weggehen..");
  AddDetail( "macht",
    "Sie scheint groesser und maechtiger zu sein, als man so denken koennte.");
  AddDetail( "bluetenkelch",
    "Er scheint von vanataurischer Macht durchflossen zu sein und somit voller "
    "Kraft der Natur; daher leuchtet er wohl so stark! Aus seiner Mitte "
    "leuchtet es am staerksten!");
  AddDetail( "stueck",
    "Am liebsten wuerdest Du Dich einfach eine Weile auf das Moos legen "
    "und so vor Dich hindoesen.");
  AddDetail( "weile",
    "Muss ja nicht lange sein.");
  AddDetail( "dunkelheit",
    "Die Dunkelheit ummantelt die ganze Insel!");
  AddDetail( "fragment",
    "Auch wenn es nur ein kleines Fragment zu sein scheint, reicht es "
    "doch, diese ganze Hoehle mit gleissendem Licht zu erstrahlen.");
  AddDetail("mitte",
    "In der Mitte steckt ein Kristall, der die gesamte Hoehle in gleissendes "
    "Licht taucht!");
  AddDetail("kristall",
    "Vielleicht koennte er Dir noch mal nuetzlich sein! Falls Du ihn Deinen "
    "Besitz bringen willst, muesstest Du einfach nur nach ihm greifen..");
   
  AddSmell(DEFAULT_SMELL,
    "Komisch - es riecht hier so nach Pflanze!");
  AddSmell("pflanze",
    "Entweder die Bluetenwesen oder das Moos!");
  AddSmell("moos",
    "Riecht nach Moos.");
  
  AddSound(DEFAULT_SOUND, 
    "Es ist hier totenstill - nur ganz leise kannst du das Meer rauschen hoeren.");
  AddSound("meer",
    "Ganz leise hoerst Du es aus einer Roehre im Boden rauschen, jedoch nur "
    "ganz leise!");
  AddSound("rauschen",
    "Es ist so laut, dass du es bis hierher hoeren kannst!");
    
  AddCmd( ({"leg","liege","lieg","lege"})  , "cmd_setzen");
  AddCmd( ({"steh","stehe"})               , "cmd_stehen");
  AddCmd( "stoss|stosse&kopf&gegen&stalaktit|stalaktiten", "cmd_stossen",
          "Was willst Du wogegen stossen?",
          "Du willst doch nicht etwa deinen Kopf gegen einen Stalaktiten stossen?",
          "Willst Du ihn etwa gegen einen Stalaktiten stossen?");
  AddCmd( "greif|greife&nach&kristall", "cmd_kristall",
          "Willst Du _nach_ dem Kristall greifen?|",
          "Hier kannst Du hoechtens nach dem Kristall greifen..");
    
  AddItem(NPC "queen", REFRESH_DESTRUCT);  
  AddItem(NPC "vana",  REFRESH_DESTRUCT);
  AddItem(NPC "blueti",REFRESH_DESTRUCT);
  
  AddSpecialExit("unten", "unten");
  
  spieler_moos = ({ });
}

void reset() {
  int i;
  for(i=sizeof(spieler_moos)-1;i>=0;i--) { 
                                           
    if(!present(spieler_moos[i])) {        
      spieler_moos-=({spieler_moos[i]});   
    }                                      
  }
  ::reset();
  return;
}

  
int unten(string dir)
{
  if(member(spieler_moos, getuid(TP)) == -1) 
  {
   write(BS(
     "Du rutscht durch die Roehre im Boden nach unten und landest "
     "dann ganz weich im Sand."));
   return TP->move(ROOM "stra2", M_GO, 0,"huepft in die Roehre",
                                         "faellt herein und landet im Sand");
  }
  write(BS(
    "Aber Du liegst doch noch im Moos! Um hier wegzukommen, solltest Du "
    "schon erst ein mal aufstehen."));
  return 1;
}
int cmd_setzen(string str)
{
  notify_fail("Worauf moechtest Du dich denn legen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf moos"         ||
       str == "auf moosgeflecht"     )) return 0;
  if(member(spieler_moos,getuid(TP)) != -1)
  {
   write(BS("Aber Du liegst doch schon!"));
   return -1; 
  }
  spieler_moos += ({ getuid(TP) });
  write(BS("Du legst Dich mitten auf das bequeme Moos.\n"));
  TO->Message(TP->Name()+" legt sich mit einem Seufzer ins Moos.\n"
             ,MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;


}

int cmd_stehen(string str)
{
  notify_fail("Wovon moechtest Du aufstehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "von moos"           ||
       str == "von moos auf"       ||
       str == "vom moos"           ||
       str == "vom moos auf")) return 0;

  if(member(spieler_moos,getuid(TP)) == -1)
  {
    tell_object(TP,"Aber Du liegst doch gar nicht im Moos!?\n");
    return -1;
  }

  spieler_moos -= ({ getuid(TP) });
  write("Du stehst mit einem Stoehnen vom Moos wieder auf.\n");
  Message(BS(TP->Name()+" steht vom Moosgeflecht auf und siehst nun "
                        "richtig erfrischt aus."), 
                        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

void BecomesNetDead(object player)
{
  if(member(spieler_moos,getuid(player)) != -1)
  {
   spieler_moos -= ({ getuid(player) });
   TO->Message(player->Name()+" nickt ein und rollt vom Moos runter.\n"
               , MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
  spieler_moos -= ({ getuid(player) });
}

int cmd_stossen(string str)
{
  write(BS(
    "Du bist wirklich so bloed und haust Deinen Kopf mit voller Wucht gegen "
    "den naechstbesten Stalaktiten!! Es gibt einen heftigen Knall der lange "
    "wie ein Echo verklingt. Dein Kopf droehnt nun ziemlich heftig!"));
  Message(BS(TP->Name()+" haut seinen Kopf ploetzlich mit voller Wucht gegen "
                        "einen Stalaktiten! Das muss doch wehtun!"),
                        MSGFLAG_VISUAL|MSGFLAG_NO_TP);  
  TP->AddHp(-(10+(random(8))));
  write("Du denkst   . o O (Das war wirklich keine gute Idee!)\n");
  Message(BS(TP->Name()+" denkt   . o O (Das war wirklich keine gute Idee!)"),
                        MSGFLAG_SENSE |MSGFLAG_NO_TP);  
  return 1;
}

int cmd_kristall(string str)
{
  //Wozu 2 Kristalle?
  if(deep_present("vanataurkristall", TP))
    {
      write("Du tauchst mit Deiner Hand in das Wasser, um noch an einen "
            "weiteren Kristall zu kommen. Jedoch spuerst Du sehr ploetzlich "
            "einen starken Schmerz in Deiner Hand, so dass Du diese sehr "
            "schnell zurueckziehst!\n");
      TO->SetProp(P_KILL_NAME, "Reine Gier");
      Message(BS(TPN+" fasst ist mit der Hand ins Wasser und schreit ploetzlich "
                     "vor Schmerz auf!"),
                     MSGFLAG_VISUAL|MSGFLAG_NO_TP);  
      TP->do_damage(25+random(20));
      VANAMASTER->Msg(TPN+" versucht erneurt Kristall zu bekommen, LP-Verlust");
      return -1;
    }
  //Sofern man keinen Kristall hat und auch die Quest macht -> Kristall
  if(!deep_present("vanataurkristall", TP) && present("\nvana_quest", TP))
    {
      write(BS(
       "Du tauchst mit Deiner Hand in das lauwarme Wasser und streichst mit "
       "Deiner Hand an der leuchtenden Bluete vorbei und greifst Direkt in "
       "ihre Mitte und ertastest den Kristall. Mit wenig Kraft ziehst Du "
       "ihn aus dem Bluetenkelch und holst ihn aus dem Wasser."));
     Message(BS(TPN+" fasst ins Wasser uns holt einen undefinierbaren Gegenstand "
                    "heraus und strahlt ueber beide Ohren."),
                    MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
     CLONE(OBJ "kristall", TP);
     write_file(LOG "questverlauf", 
       "("+ctime(time())+") "+TPN+" findet den mag. Kristall.\n");
     VANAMASTER->Msg(TPN+" findet den Kristall");
     return 1;
    }
  //Man hat keinen Kristall aber macht die Quest nicht:
  write("Du willst gerade Deine Hand ausstrecken, da hoerst Du eine leise "
        "Stimme: \n\n 'Schlag Dich erst auf unsere Seite, bevor Du uns "
        "hilfst!'\n\n Etwas verwirrt ziehst Du die Hand zurueck.\n");
  VANAMASTER->Msg(TPN+" versucht Kristall ohne QOBJ zu bekommen");
  return -1;
}