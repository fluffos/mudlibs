inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein flacher Strand" );
  SetProp(P_INT_LONG,
    "Hier hat der Strand ein abruptes Ende. Suedlich und oestlich von Dir "
    "befinden sich Klippen, die ein Weiterkommen unmoeglich machen. Sonst "
    "siehst Du im Westen nur das weite Meer. Durch den Sand schlaengeln sich "
    "kleine Baeche, die aus dem Klippengestein durch den Sand in das Meer "
    "fliessen.");   
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:12, ENV_TERRAIN:TT_PLAIN ]));
  AddDetail( ({ "muschel", "muscheln" }),
    "Vereinzelt liegen ein paar Muscheln herum.");
  AddDetail( ({ "sand", "sandkorn", "sandkoerner" }),
    "Durch den Sand schlaengeln sich kleine Baeche an den Muscheln vorbei.");
  AddDetail( "himmel",
    "Der Himmel ist duester und voller Nebelschwaden.");
  AddDetail( ({"nebel" , "nebelschwaden" }), 
    "Die Nebelschwaden verduestern die ganze Gegend.");
  AddDetail( "baeche",
    "Die Baeche kommen aus dem Klippengestein und fliessen durch den "
    "Sand in das Meer.");
  AddDetail( "klippen",
    "Es befinden sich hohe Klippen im Osten und im Sueden. Die Klippe im "
    "Osten erscheint Dir als ausserst interessant...");
  AddDetail( "gegend",
    "Bisher hast Du noch keine helle Stelle auf der Insel gefunden.");
  AddDetail( "stelle",
    "Eine helle Stelle gibt es bestimmt.");
  AddDetail( ({"meer" , "westen" }),
    "Im Westen von Dir befindet sich das Meer. Sieht kalt aus, aber wer "
    "Lust auf eine Abkuehlung hat, sollte mal schwimmen gehen.");
  AddDetail( "lust",
    "Ueberleg Dir, ob Du Lust auf eine Abkuehlung hast.");
  AddDetail( "abkuehlung",
    "In heissen Sommertagen ist das was feines.");
  AddDetail( "sommertage",
    "Von denen bemerkst Du hier leider nichts.");
  AddDetail( "osten",
    "Dort befinden sich hohe Klippen, genau wie im Sueden.");
  AddDetail( "sueden",
    "Dort befinden sich auch Klippen, aber die sind uninteressant.");
  AddDetail( "klippe",
    "Aus dem Klippengestein fliessen Baeche. Die Klippe ist unueberwindbar! "
    "Aber Etwas faellt Dir am oberen Rand der Klippe auf.");
  AddDetail( ({"gestein" , "klippengestein" }),
    "Aus dem Gestein fliessen kleine Baeche, die sich durch den Sand schlaengeln.");
  AddDetail( "boden",
    "Von den Sandkoernern mal abgesehen finden sich nur noch gelegentlich "
    "kleine Baeche und ausserdem recht viele Steine!");
  AddDetail( "insel",
    "Auf der befindest Du Dich. Sie ist leider voellig von Dunkelheit ummantelt.");
  AddDetail( "dunkelheit",
    "Vielleicht kann man ja was gegen sie unternehmen?");
  AddDetail( "strand", 
    "Der Strand zieht sich von Norden nach Sueden.");
  AddDetail( "norden",
    "Im Norden zieht sich der Strand entlang.");
  AddDetail( ({"ende" , "weiterkommen" }),
    "Der Strand hoert hier auf, weil im Osten sowie im Sueden Klippen sind.");  
  AddDetail( "geruch",
    "Schnupper mal!");
  AddDetail( "etwas",
    "Ja .. Da ist irgendetwas!");
  AddDetail( "irgendetwas",
    "Hm du kannst wegen der Dunkelheit nur ein Loch erkennen.");
  AddDetail( "loch",
    "Vielleicht ein Eingang fuer irgendwas. Aber wenn es ein Eingang sein "
    "kann, kann es natuerlich auch ein Ausgang sein.");
  AddDetail( "eingang",
    "Du bist Dir ziemlich sicher, dass dieses Loch einen Eingang darstellt. "
    "Nur wohin es fuehrt, sei es in eine Hoehle oder sonstwohin, kannst Du "
    "leider nicht erkennen.");
  AddDetail( "hoehle",
    "Wenn es eine waere, muesstest Du es bestimmt irgendwie herauskriegen "
    "koennen!");
  AddDetail( "ausgang",
    "Ein Ausgang scheint es nicht zu sein.. Warum, kannst Du jedoch auch "
    "nicht sagen..");
  AddDetail( "rand",
    "Dort oben beginnt ja schon eine Wiese?!");
  AddDetail( "wiese",
    "Eine richtige Wiese scheint es nicht zu sein, denn das Gras ist ziemlich "
    "dunkelfarbig. Du koenntest Dich natuerlich aufgrund der Dunkelheit leicht "
    "irren.");
  AddDetail( "gras",
    "Es scheint eine dunkle Farbe zu haben!");
  AddDetail( "farbe",
    "Ob nun Schwarz oder Braun kannst Du nicht sagen.");
  AddDetail( "schwarz", 
    "Schwarz wie alles hier - Die Dunkelheit scheint die ganze Insel zu "
    "ummanteln!");
  AddDetail( "braun",
    "Wenn das Gras nur braun waere, muesste es ja hier Herbst sein.");
  AddDetail( "herbst",
    "Das ist eine Jahreszeit.");
  AddDetail( "jahreszeit",
    "Davon gibt es 4.");  
  AddDetail( "wasser",
    "Das Wasser laeuft aus dem Klippengestein in Form von kleinen Baechen "
    "durch den Sand und dann direkt ins Meer.");
  AddDetail( "steine",
    "Gelegentlich liegen ein paar graue Steine herum. Einer faellt Dir "
    "unter den ganzen grauen Steinen jedoch besonders auf!");
  AddDetail( "stein",
    "Er ist nicht so grau wie die anderen, sondern hat viele braune Punkte. "
    "Der Stein sieht sehr interessant aus.. Vielleicht solltest Du ihn "
    "Dir einfach mal greifen?");
  AddDetail( "punkte",
    "Die braunen Punkte machen diesen einen Stein so interessant!");
  
    
  AddSmell(DEFAULT_SMELL, "Es riecht nach Meer.");
  AddSmell( "meer", 
    "Wie Meerwasser eben riecht - salzig.");
  AddSmell( "meerwasser",
    "Wenn Du es so genau riechen willst, geh doch ins Meer pruefe den Geruch.");
    
  AddCmd("schwimm|schwimme&im|in&meer|wasser","cmd_schwimmen",
         "Was willst Du denn genau machen?|Worin willst Du denn schwimmen?|"
         "Willst Du etwa in dem eiskalten Meer schwimmen?");
  AddCmd("greif|greife&stein", "cmd_stein",
         "Willst Du Dir den Stein greifen?");
         
  AddSound(DEFAULT_SOUND, "Das Meer rauscht leise vor sich hin. Ansonsten "
                          "ist es hier merkwuerdig still.\n");
  AddSound( "meer",
    "Es rauscht leise vor sich hin. ");
         

 
 AddExit("norden",   ROOM "stra1");

}
  
  
  
  
int cmd_schwimmen(string str)
{
  write(BS(
    "Du rennst mit einem AAAAH ins eiskalte Wasser!"));
  TP->move(ROOM "meer1",M_GO,"ins eiskalte Wasser","rennt",
    "kommt vom Strand ins Wasser gerannt");
  VANAMASTER->Msg(TPN+" rennt ins Meer");
  return 1;
}   

int cmd_stein(string str)
{
  //Wozu 2 Steine?
  if(deep_present("vana_stein", TP))
    {
      write(BS(
        "Du greifst Dir den Stein, bemerkst aber, dass Du schon einen "
        "solchen im Besitz hast und wirfst ihn kurzerhand wieder weg."));
      Message(BS(TPN+" nimmt einen Stein und wirft ihn direkt wieder weg."),
                     MSGFLAG_VISUAL|MSGFLAG_NO_TP);  
      VANAMASTER->Msg(TPN+" versucht erneut Stein zu erlangen");
      return -1;
    }
  //Sofern man keinen Stein hat und auch die Quest macht ->Stein
  if(!deep_present("vana_stein", TP) && present("\nvana_quest", TP))
    {
      write("Du greifst Dir den Stein und grinst verstohlen.\n");
      Message(BS(TPN+" hebt einen Stein vom Boden auf."),
                    MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
     CLONE(OBJ "stein", TP);
     write_file(LOG "questverlauf", 
       "("+ctime(time())+") "+TPN+" findet den spitzen Stein.\n");
     VANAMASTER->Msg(TPN+" findet den spitzen Stein");
     return 1;
    }
  //Man hat keinen Stein aber macht die Quest nicht:
  write("Du nimmst den Stein an Dich, aber irgendwie sieht er jetzt nicht "
        "mehr sonderlich interessant aus, daher schmeisst Du ihn direkt "
        "wieder weg!\n");
  VANAMASTER->Msg(TPN+" bekommt ohne QOBJ auch keinen Stein");
  return -1;
}
