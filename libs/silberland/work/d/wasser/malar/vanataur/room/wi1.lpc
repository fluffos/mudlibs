//Questraum: Man bekommt die benoetige Magierkappe fuer die Beschwoerung,
//           sofern nicht schon eine im Inventar des Spielers vorhanden ist.
inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Grashuegel" );
  SetProp(P_INT_LONG,
    "Ab hier befindest Du Dich auf einer Art Wiese. Aber diese Wiese kommt "
    "Dir keinesfalls normal vor - Eine normale Wiese wuerde fuer Dich eine "
    "prachtvolle Ebene mit allerlei Blumen und Tieren darstellen - das ist "
    "hier aber leider nicht der Fall. Hier ist zwar ueberall Gras, welches "
    "jedoch auch keineswegs gesund aussieht. Von der Stimmung her kommst Du "
    "Dir vielmehr auf einem Friedhof als auf einer Wiese vor. Links und rechts "
    "vom Hang befindet sich jeweils ein Stein. Im Sueden ist eine Anhoehe "
    "zu sehen.");  
  SetProp(P_LIGHT,0);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:6, ENV_TERRAIN:TT_HILL ]) );

  AddDetail( ({ "blume", "blumen" }),
    "Man kann sie eigentlich gar nicht mehr als richtige Blumen bezeichen - "
    "Sie haben keine Farbe mehr in ihren Stengeln, von den Bluetenblaettern "
    "mal ganz abgesehen.");
  AddDetail( "himmel",
    "Der Himmel ist duester und voller Nebelschwaden.");
  AddDetail( "nebelschwaden",
    "Die Sonne hat keine Chance, nur einen einzigen Sonnenstrahl durch die "
    "dichten Nebelschwaden zu schicken.");
  AddDetail( "tiere",
    "Ab und zu kannst Du ein paar Bluetenwesen erkennen.");
  AddDetail( "fall",
    "Eine normale Wiese ist es in der Tat nicht.");
  AddDetail( ({"wiese"}) ,
  QueryProp(P_INT_LONG));
  AddDetail( "chance",
    "Sie hat leider keine - sonst waer hier bestimmt auch mehr Waerme "
    "vorhanden.");
  AddDetail( "waerme",
    "Leider keine da - *bibber*");
  AddDetail( "art",
    "Es sieht nur aus wie eine Art Wiese - Manchmal truegt jedoch der Schein.");
  AddDetail( "schein",
    "Der Schein kann truegen.");
  AddDetail( "bluetenblaetter",
    "Sie sind heller als hellbraun, was sie sonst im Herbst besitzen.");
  AddDetail( "herbst",
    "Da schillern die Blaetter in den Farben Rot, Gruen, Braun und Orange.");
  AddDetail(({"rot", "gruen", "braun", "orange" }),
    "Wenn Du ueberhaupt eine der Farben erkennst, dann nur einen ganz "
    "verblichenen Farbton.");
  AddDetail( "farbton",
    "Voellig verblichen.");
  AddDetail( "blaetter",
    "Sie sehen herbstlicher als herbstlich aus - total ausgeblichen.");
  AddDetail( "bluetenwesen",
    "Du triffst sie bestimmt - die Bewohner der Insel.");
  AddDetail( "bewohner",
    "Diese Insel wird von Vanataurien, eine Art Bluetenwesen, bewohnt.");
  AddDetail( "vanataurien",
    "Sie werden Dir sicherlich noch ueber den Weg laufen.");
  AddDetail( "insel",
    "Auf der bist Du nun mal gelandet und versuchst jetzt von ihr "
    "wieder wegzukommen - nur duerfte das nicht ganz so leicht sein!");
  AddDetail( "sonnenstrahl",
    "Du kannst leider keinen erkennen.");
  AddDetail( "friedhof",
    "Naja als Friedhof koennte man es schon bezeichnen. Es ist zwar dunkel "
    "und alles nicht so besonders geheuer, aber trotzdem kann man noch immer "
    "erkennen, dass diese Ebene auf jeden Fall mal eine Wiese war.");
  AddDetail( "ebene",
    "Du befindest auf ihr.");
  AddDetail( "boden",
    "Der Boden besteht hauptsaechlich aus dem Rasen, ab und an sind jedoch "
    "noch kleine Auslaeufer des sandigen Strandes zu erkennen.");
  AddDetail( "strand",
    "Der befindet sich im Westen.");
  AddDetail( "westen",
    "Dort befindet sich der Strand und das Meer.");
  AddDetail( "meer",
    "Lausch!");
  AddDetail( "stengel",
    "Sonst sind sie immer gruen - jetzt einfach fast farblos.");
  AddDetail( "farbe",
    "Da ist seltsamerweise keine.");
  AddDetail( "weg",
    "Er ist zwar kaum erkennbar, aber er zieht sich von Westen nach "
    "Osten ueber die Wiese.");
  AddDetail( "osten",
    "Da ist noch ein Stueck Wiese.");
  AddDetail( "stueck",
    "Nicht allzugross.");
  AddDetail( "gras",
    "Das Gras sieht von der Farbe mal abgesehen ganz normal aus.");
  AddDetail( "hang", 
    "Auf ihm zieht befindet sich der Weg vom Strand.");
  AddDetail( "rasen",
    "Er sieht von der Farbe mal abgesehen ganz normal aus.");
  AddDetail( "sonne",
    "Sie dringt mit keinem einzigen Sonnenstrahl zu Dir durch.");
  AddDetail( "auslaeufer",
    "Der Sand zieht sich bis hierhin.");
  AddDetail( "stimmung",
    "Traurig, verlassen, ruhig, friedlich und leblos.");
  AddDetail( "tat",
    "Normal scheint hier bisher nichts zu sein.");
  AddDetail( "stein",
    "Rechts und links von Dir befindet sich jeweils ein Stein. Sie fallen "
    "Dir besonders auf, da sie um einen halben Meter gross sind und daher "
    "ins Auge stechen. Sie sind beide mit seltsamen Zeichen versehen.");
  AddDetail( "auge",
    "Dadurch, dass sie beide so ins Auge stechen, fallen sie besonders auf.");
  AddDetail( "meter",
    "100 cm.");
  AddDetail( "zeichen",
    "Sie scheinen Geschichten aus alter Zeit darzustellen.");
  AddDetail( "zeit",
    "Aus einer aelteren Zeit.");
  AddDetail( "geschichten",
    "Viele Bilder erzaehlen die Geschichten.");
  AddDetail( "bilder",
    "Es sind sehr viele Bilder und sicherlich sind die meisten fuer Dich "
    "uninteressant. Nur ein Bild faellt dir besonders auf!");
  AddDetail( "bild",
    "Es besteht nur aus einem Kreis, der mit gruener Farbe "
    "ausgemalt ist. In seiner Mitte sind ausserdem noch "
    "einige Punkte eingezeichnet.");
  AddDetail( "farbe",
    "Ein kraeftiges Gruen. Vielleicht war diese Insel ja mal voller Farbe "
    "und Leben?");
  AddDetail( "kreis",
    "Es scheint Dir, als ob der Kreis diese Insel darstellt.");
  AddDetail( "mitte",
    "In der Mitte des Bildes ist eine helle Erhebung.");
  AddDetail( "erhebung",
    "Sie ist besonders gekennzeichnet und scheint ein besonderen Platz "
    "dieser Insel darzustellen.");
  AddDetail( "platz",
    "Du musst ihn finden und erforschen!");
  AddDetail( "punkte",
    "Die Punkte scheinen kleine Bluetenwesen darzustellen. Sie sehen alle "
    "sehr lebendig und voller Farbe aus. Sie scheinen in Frieden und Freude "
    "zu leben.");
  AddDetail( "frieden",
    "Vielleicht gab es den hier ja mal.");
  AddDetail( "freude",
    "In aelterer Zeit gab es hier sowas bestimmt; jetzt kannst Du jedoch "
    "nichts mehr davon erkennen.");
  AddDetail( "leben",
    "Viel Leben kannst Du auf dieser Wiese nicht erkennen.");
  AddDetail( "anhoehe",
    "Sie befindet sich weiter suedlich.");
  AddDetail( "sueden",
    "Dort befindet sich nur noch eine Anhoehe.");
  AddDetail( "sand",
    "Vielleicht mal drin graben?");
  
  AddSmell(DEFAULT_SMELL,
    "Der Geruch von Verwesung liegt in der Luft.");
  AddSmell("verwesung",
    "Liegt wohl an der verdoerrten Wiese.");
  AddSmell("luft",
    "Sie riecht nach Verwesung.");
  AddSmell("geruch",
    "Der Geruch von Verwesung verpestet die Luft.");
  
  AddSound(DEFAULT_SOUND,
    "Es ist fast still, nur das Rauschen des Meeres ist leise zu hoeren.");
  AddSound( ({ "rauschen", "meer" }),
    "Du hoerst es leise im Westen rauschen.");
  
  AddItem(NPC "vana",   REFRESH_DESTRUCT);
  AddItem(NPC "vana",   REFRESH_DESTRUCT);
  AddItem(NPC "blueti", REFRESH_DESTRUCT);


  AddExit("westen",   ROOM "stra1");
  AddExit("osten",    ROOM "wi2");
  AddExit("sueden",   ROOM "wi3");
  AddExit("suedoben", ROOM "wi3");
  AddExit("westunten",ROOM "stra1");
  SetProp(P_HIDE_EXITS, ({"westen", "sueden"}) );
  
  AddCmd("grab|grabe&in|im&sand|boden|erde|auslaeufer", "cmd_magierkappe",
         "Grab doch einfach mal im Sand!");
}
  
int cmd_magierkappe(string str)
{
  if(deep_present("magierkappe"))
    {
      write("Du graebst wie wild im Sand herum, findest jedoch nichts.\n");
      Message(BS(TPN+" graebt ploetzlich wie wild im Sand herum, schaut "
                     "danach jedoch nur frustriert in der Gegend herum."),
                     MSGFLAG_VISUAL|MSGFLAG_NO_TP);  
      VANAMASTER->Msg(TPN+" versucht erneut eine Kappe zu bekommen");
      return -1;
    }
  write(BS(
    "Du faengst wie wild an im Sand herumzugraben und nach einiger Zeit "
    "stoesst Du auf einen etwas festeren Gegenstand. Du ziehst ihn "
    "natuerlich sofort aus dem Sand und laesst ihn erstmal auf dem Boden "
    "herumliegen."));
  Message(BS(TPN+" graebt ploetzlich wie wild im Sand herum und zieht auf "
                 "ein mal begeistert einen Gegendstand aus dem Sand."),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
  CLONE("/p/armour/helm/magierkappe", ROOM "wi1");
  write_file(LOG "questverlauf", 
    "("+ctime(time())+") "+TPN+" findet die Magierkappe.\n");
  VANAMASTER->Msg(TPN+" findet die Magierkappe");
  return 1;
}