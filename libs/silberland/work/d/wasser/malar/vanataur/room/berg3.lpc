

inherit "std/room";

#include "../def.h"

int heilung;

void create()
{
  ::create();
  
  heilung=1; //Auf jeden Fall nur _eine_ Heilung pro Reset, da die Heilung
             //den Spieler im Prinzip von _allen_ Sachen heilt!!

  SetProp(P_INT_SHORT, "Auf einem Plateau" );
  SetProp(P_INT_LONG, 
    "Du bist nun in der heiligen Staette der Vanataurien. Das Licht "
    "macht Dir ein wenig zu schaffen, da Du Dich erstmal daran gewoehnen "
    "musst. Die Staette besteht aus vier Saeulen, die ein rundes Dach "
    "halten. An den Waenden kannst Du viele verschiedene Muster erkennen. "
    "Der Boden besteht aus glattem Sandstein und ganz vereinzelt treten "
    "kleine Graeser zwischen den Ritzen hervor. ");
  SetProp(P_LIGHT,2);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:32 , ENV_TERRAIN:TT_PLAIN ]) );
  
  AddDetail( "graeser",
    "Nur vereinzelt treten Graeser zwischen den Ritzen hervor.");
  AddDetail( "plateau",
    "Du befindest Dich auf ihm.");
  AddDetail( "boden",
    "Der Boden besteht aus glatten Sandsteinen, "
    "durch die einige Ritzen verlaufen.");
  AddDetail( "ritzen",
    "Aus den Ritzen spriessen vereinzelt ein paar Graeser.");
  AddDetail( "staette",
    "Die Heiligkeit von solchen Staetten sollte man nicht stoeren!");
  AddDetail( "heiligkeit",
    "Sie scheint in dieser Staette besonders stark zu sein.");
  AddDetail( "saeulen",
    "Sie scheinen das Dach zu stuetzen. Eine Saeule faellt "
    "Dir jedoch besonders auf. ");
  AddDetail( "saeule",
    "Diese Saeule scheint anders als die anderen zu sein. Dir faellt eine "
    "Zeichnung auf. ");
  AddDetail( "zeichnung",
    "Das ist ein Pfeil.");
  AddDetail( "pfeil",
    "Komisch - Er zeigt in Richtung Westen.");
  AddDetail( "westen",
    "Im Westen befindet sich nur eine Wand. Die Westwand.");
  AddDetail( "waende",
    "Im Norden, Westen und im Sueden befindet sich eine Wand. Im Osten sind "
    "jedoch nur zwei Saeulen. In jeder Wand befinden sich einige "	
    "runde Fenster.");
  AddDetail( "westwand",
    "An der Westwand befinden sich viele verschiedene "
    "Zeichnungen und Reliefs.");
  AddDetail( "zeichnungen",
    "Schoene Zeichnungen von der Geschichte Vanataurs und dessen Bewohnern, "
    "den Vanataurien.");
  AddDetail( "reliefs",
    "Sehen recht uninteressant aus. Ein Relief sticht Dir "
    "durch seine Farbe ins Auge.");
  AddDetail( "relief",
    "Es scheint eine Art von Geist darzustellen.");
  AddDetail( "geist",
    "Der Geist hat dunkelblaue Augen und hat ein friedliches Aussehen.");
  AddDetail( "augen",
    "Richtige KNOPFaugen sind das ja!");
  AddDetail( "knopf",
    "Knoepfe sind zum druecken da.");
  AddDetail( "himmel",
    "Um den zu sehen, musst Du wohl wieder nach Osten gehen.");
  AddDetail( "osten",
    "Dort bist auf das Plateau hochgeklettert.");
  AddDetail( "geschichte",
    "Die Zeichnungen erzaehlen von der Geschichte Vanataurs.");
  AddDetail( "bewohner",
    "Das sind die Vanataurien - eine Art Bluetenwesen.");
  AddDetail( "bluetenwesen",
    "Zu denen gehoeren die Vanataurien.");
  AddDetail( "sandstein",
    "Der Boden besteht aus Sandstein, der sich wohl im Laufe der Jahre "
    "angesammelt hat.");
  AddDetail( "jahre",
    "Ja eine lange Zeit.");
  AddDetail( "zeit",
    "Fuer sowas braucht es nun mal lange.");
  AddDetail( "wand",
    "Im Norden, Westen und im Sueden befindet sich eine Wand. Im Osten "
    "sind jedoch nur zwei Saeulen.");
  AddDetail( "licht",
    "Du fragst Dich warum es hier so hell ist, denn zwischen Dir und der "
    "Sonne befindet sich ja noch das Dach. Woher mag das Licht dann wohl "
    "kommen?");
  AddDetail( "sonne",
    "Geh nach Osten, da solltest Du sie sehen.");
  AddDetail( "dach",
    "Das runde Dach wird von vier Saeulen gestuetzt.");
  AddDetail( "farbe",
    "Das Relief hebt sich durch seine hellgelbe Farbe von den anderen ab.");
  AddDetail( "knopfaugen",
    "Der Geist hat dunkelblaue __KNOPF__augen.");
  AddDetail( "fenster",
    "Es sind keine Fenster, wie Du sie Dir jetzt vielleicht vorstellst - es "
    "sind vielmehr einfach nur groessere Loecher in der Wand. An der Suedwand "
    "befindet sich ein besonders grosses Fenster.");
  AddDetail( "loecher",
    "Das sind die Fenster.");
  AddDetail( "suedwand",
    "In der Suedwand befindet sich ein grosses Loch.");
  AddDetail( "loch",
    "Durch das Loch kannst Du eigentlich nur die Wolken von oben sehen. "
    "Vielleicht kann man sich ja herausbeugen?");
  AddDetail( "wolken",
    "Die siehst Du durch ein Fenster. Ausserdem kannst Du sie sehen, wenn "
    "Du nach Osten ueber das Plateau hinweg schaust.");
  AddDetail( "muster",
    "Um die sehen zu koennen, musst Du Dir wohl die Waende genauer anschauen.");
  AddDetail( "aussehen",
    "Der Geist sieht sehr friedlich aus. Aber ein wenig scheint ihn auch "
    "die Angst zu durchfliessen.");
  AddDetail( "angst",
    "Naja den boesen Wolf gibt es auf diesem Plateau wohl nicht.");
  AddDetail( "wolf",
    "Der hat doch die Oma von Rotkaeppchen verschlungen!");
  AddDetail( "rotkaeppchen",
    "Das Maedchen heisst Rotkaeppchen, da sie immer ein "
    "rotes Kaeppchen auf hat.");
  AddDetail( "maedchen",
    "Sie hatte immer ein rotes Kaeppchen auf.");
  AddDetail( "oma",
    "Sie wurde von dem ach so boesen Wolf gefressen.");
  AddDetail( "kaeppchen",
    "Das von Rotkaeppchen war immer rot.");
  AddDetail( "vanataurien",
    "Das sind die Bluetenwesen, die hier leben.");
  AddDetail( "laufe",
    "Ja die Jahre gehen schnell vorueber..");
  AddDetail( "auge",
    "Sehr auffaellig!");
  AddDetail( "geist",
    "Ist es ein Geist oder eben nicht? Das muss man herausfinden.");
  AddDetail( ({"nordwand", "suedwand"}),
    "Eine voellig oede Wand.");
  AddDetail( "decke",
    "Die Decke ist wie die Nordwand total oede und voellig uninteressant!");

  AddSmell(DEFAULT_SMELL,
    "Es riecht hier nach.. nichts! Totale Geruchsneutralitaet!");
  AddSmell( ({"geruchsneutralitaet", "neutralitaet", "geruch"}),
    "Du kannst tatsaechlich keinen spezifischen Geruch in "
    "dieser Neutralitaet feststellen!");
 
  AddSound(DEFAULT_SOUND,
    "Du hoerst den Wind um deine Ohren pfeifen.");
  AddSound("wind",
    "Er fegt ueber die ganze Insel.");
  AddSound("insel",
    "Der Wind fegt ueber die ganze Insel!");
    
    
  AddCmd("drueck|druecke&knopf|auge","cmd_auge",
         "Was willst Du denn druecken?");
  AddCmd("beug|beuge&heraus|raus", "cmd_beugen",
         "Wohin willst Du Dich beugen?");
  
  AddExit("osten", ROOM "berg2");
}

void reset()
{
  ::reset();
  set_next_reset(900); //Alle 15 Minuten Reset!
  heilung=1;
}  
  
int cmd_auge(string str)
{
  if (heilung)
  {
    heilung=0;
    write(BS(
      "Ploetzlich wird es ganz schwummrig im Raum und leuchtener Geist "
      "materialisiert sich. "
      "Der Geist fleht Dich um Gnade an und scheint ziemlich Angst vor Dir "
      "zu haben. Er heilt Dich also von allen Plagen Die Du wie auch immer "
      "angesammelt hast, damit Du ihm ja nichts tust."));
    TP->SetProp(P_BLIND,  0);
    TP->SetProp(P_DEAF,   0);
    TP->SetProp(P_FROG,   0);
    TP->SetProp(P_POISON, 0);
    TP->heal_self(400);
    write("Der Geist hat Dich von allen Plagen befreit und verschwindet.\n");
    write_file(LOG "b3heil.log", 
    sprintf("%s, %O wird von allen Plagen befreit\n",
     dtime(time()), this_player()));
    VANAMASTER->Msg(TPN+" bekommt eine Vollheilung");
    return 1;
  }
  write("Nichts passiert. Vielleicht nachher noch mal probieren?\n");
  return 1;
}

int cmd_beugen(string str)
{
  write(BS(
    "Du beugst Dich aus dem Loch an der Suedwand und guckst direkt nach "
    "oben und schaust leider direkt in die Sonne. Schnell beugst Du Dich "
    "wieder rein."));
  TP->SetProp(P_BLIND,
        ([BLIND_TIME:15,
          BLIND_MSG:"Du siehst nur noch bunte Flecken herumtanzen!\n",
          BLIND_END_MSG:"Endlich sind die bloeden Flecken verschwunden!\n"]));
  write_file(LOG "blind", 
  sprintf("%s, %O erblindet.\n",
   dtime(time()), this_player()));
  VANAMASTER->Msg(TPN+" erblindet in berg3.lpc");
  return 1;
}

