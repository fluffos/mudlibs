inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein steiler Hang" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich hier an einem steilen und sehr hohen Berg. "
    "Auf seiner Spitze kannst Du eine Art Haus erkennen. "  
    "Am Boden siehst Du nur die Dir schon gewohnten farblosen "
    "Blaetter und Graeser. Der Berg selber sieht ziemlich steil "
    "aus und Du kriegst Lust ihn zu erklettern. Noch weisst Du "
    "jedoch kein Hilfsmittel, mit dem das schaffbar waere.");    
  SetProp(P_LIGHT,0);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:6, ENV_TERRAIN:TT_HILL ]) );
  
  AddDetail( ({ "gras", "graeser" }),
    "Die Graeser sind alle fast farblos.");
  AddDetail( "blaetter",
    "Die Blaetter sind wie die Graeser alle fast farblos. Eins scheint Dir "
    "komischerweise ganz anders auszusehen als die anderen Blaetter!");    
  AddDetail( "berg",
    "Der Berg ist recht steil und es duerfte recht schwer sein, irgendwie auf "
    "ihn hochzuklettern. Von dem Berg geht ein schwaches blaues Leuchten aus. "
    "Ganz unten am Berg kannst Du kleine Einkerbungen erkennen.");
  AddDetail( "einkerbungen", 
    "Es sieht so aus, als ob irgendwer schon mal an "
    "den Einkerbungen hochgeklettert ist! ");
  AddDetail( "haus",
    "Es sieht aus wie eine Art Tempel.");
  AddDetail( "tempel",
    "Vielleicht auch nur eine heilige Staette.");
  AddDetail( "staette",
    "Was es nun genau ist, musst Du wohl selbst herausfinden!");
  AddDetail( "art",
    "Vielleicht auch nur eine heilige Staette.");
  AddDetail( "boden", 
    "Am Boden sind nur vereinzelt Graeser und Blaetter zu erkennen.");
  AddDetail( "himmel",
    "Am Himmel kannst Du nur lauter dunkle Wolken erkennen.");
  AddDetail( "westen",
    "Schau Dir doch einfach genauer an, was das ist!");
  AddDetail( "gedanken",
    "Du willst lieber nicht dran denken.");
  AddDetail( "hilfsmittel",
    "Ohne jenes wirst Du da sicherlich nicht raufkommen.");
  AddDetail( "geruch",
    "Riech lieber!");
  AddDetail( "lust",
    "Lust hast Du schon, nur ohne Hilfsmittel wird das sicher nichts!");
  AddDetail( "leuchten",
    "Du kannst Dir das Leuchten nur durch Magie erklaeren, denn wie sollte "
    "sonst ein hauptsaechlich aus Sand bestehender Berg leuchten koennen?");
  AddDetail( "magie",
    "Die Macht dieser Insel ist gewiss sehr gross.");
  AddDetail( "insel",
    "Vanataur ist ihr Name und sie wird normalerweise von "
    "Bluetenwesen bewohnt.");
  AddDetail( "vanataur",
    "So heisst diese Insel, von der Du so gerne weg willst.");
  AddDetail( "name",
    "Der Name der Insel ist Vanataur und die Bewohner der Insel werden deshalb "
    "Vanataurien genannt.");
  AddDetail( "vanataurien",
    "Du hast bestimmt schon eine dieser magischen Bluetenwesen gesehen!");
  AddDetail( "bluetenwesen",
    "Sie bewohnen die Insel.");
  AddDetail( "luft",
    "Schnupper doch mal ein wenig herum.");
  AddDetail( "sand",
    "Aus ihm besteht zu groessten Teilen der Berg sowie der Boden.");
  AddDetail( "blatt",
    "Es ist besonders gross und hat noch ziemlich viel gruene Farbe im "
    "Gegensatz zu den anderen Blaettern.");
  AddDetail( "farbe",
    "Das Gruen ist besonders an der Spitze des Blattes stark.");
  AddDetail( "spitze",
    "Meinst Du die Blattspitze oder die Bergspitze?");
  AddDetail( "blattspitze",
    "Sie sieht ein wenig aus wie ein Pfeil.");
  AddDetail( "pfeil", 
    "Er zeigt ziemlich genau in eine bestimmte Richtung.");
  AddDetail( "richtung",
    "Der Pfeil zeigt in Richtung Berg.");
  AddDetail( "bewohner",
    "Die Bewohner sind Vanataurien, eine Art Bluetenwesen.");
  AddDetail( "macht", 
    "Die Macht der Magie scheint auf dieser Insel ziemlich gross zu sein.");
  AddDetail( "teile",
    "Der gesamte Berg besteht fast nur aus Sand. Eigentlich komisch, dass er "
    "nicht einfach in sich selber zusammenfliesst. Etwas Staerkeres als die "
    "normalen physikalischen Kraefte scheint ihn bestens zusammenzuhalten.");
  AddDetail( "kraefte",
    "Sie scheinen keinen Einfluss auf die Physik des Berges zu nehmen.");
  AddDetail( "physik",
    "Sie wird durch magische Kraefte uebertrumpft!");
  AddDetail( "etwas",
    "Vielleicht Magie? Vielleicht auch etwas anderes, etwas nie dagewesenes.");
  AddDetail( "gegensatz",
    "Er zwar nicht sonderlich gross, aber doch erkennbar.");
  AddDetail( "wolken",
    "Durch die dicken Wolken kommt kein Sonnenstrahl durch.");
  AddDetail( "sonne",
    "Sie ist wahrscheinlich irgendwo hinter den Wolken.");
  AddDetail( "sonnenstrahl",
    "Du siehst leider keinen.");
  AddDetail( "einfluss",
    "Die Physik scheint hier ueberhaupt keine Rolle zu spielen!");
  AddDetail( "gruen",
    "An der Bergspitze ist es am kraeftigsten.");
  AddDetail( "rolle",
    "Die Physik spielt jedenfalls keine.");
  AddDetail( "bergspitze", 
    "Kaum zu erkennen von hier..");
  
  AddSmell(DEFAULT_SMELL,
    "Wenn du sehr genau riechst liegt ein Geruch von Verwesung in der Luft.");
  AddSmell( "verwesung",
    "Du schuettelst Dich bei dem Gedanken.");
  AddSound(DEFAULT_SOUND,
    "Nur ganz leise hoerst den Wind um den Berg rauschen.");
  AddSound( "wind",
    "Ganz leise hoerst Du ihn nur rauschen.");  
    
  AddCmd("kletter|klettere&an&einkerbungen|einkerbung&rauf|hoch","cmd_klettere",
    "Willst Du AN etwas klettern?|Woran willst Du klettern?|"
    "Willst Du an den Einkerbungen HOCHklettern?");

  AddExit("ostunten", ROOM "wi4");
  AddExit("osten",    ROOM "wi4");
  SetProp(P_HIDE_EXITS, ({"osten"}) );
}

int cmd_klettere(string str)
{
  TP->move(ROOM "bergwand",M_GO|M_NO_SHOW,"auf den Berg","klettert",
    "kommt von unten hochgeklettert.");
  VANAMASTER->Msg(TPN+" beginnt zu klettern");
  return 1;
}   

