inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein dunkler Strand");
  SetProp(P_INT_LONG,
    "Sehen kannst Du kaum etwas, denn hier ist ein solch dichter Nebel, "
    "dass man kaum irgendwas sehen kann, beziehungsweise gar nichts. "
    "Du weisst nur, dass Du an einem Strand bist, denn nach Sueden hin "
    "flacht das Gelaende ab und den Sand unter deinen Fuessen kannst "
    "Du bestens spueren. Im Sueden scheint das Meer zu sein, zwar ist "
    "es leise, jedoch hoert man es leise rauschen. Du fuehlst Dich "
    "an diesem dunklen Ort gar nicht wohl, denn Irgendwas liegt in "
    "der Luft...");
    
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:6, ENV_TERRAIN:TT_HILL ]) );

  AddDetail("boden",
    "Du kannst noch nicht ein mal den Boden sehen! Du weisst wohl, "
    "dass er aus Sand bestehen muss, denn das merkt man unter den Fuessen.");
  AddDetail( ({"fuesse", "fuessen"}),
    "Ohne sie wuesstest Du jetzt vielleicht gar nicht, wo Du hier "
    "ueberhaupt bist!");
  AddDetail("gelaende",
    "Du vermutest, dass es sich um einen Strand handelt, der nach Sueden "
    "hin abflacht und ins Meer uebergeht.");
  AddDetail("himmel",
    "Wie willst Du denn den Himmel untersuchen, wenn Du durch den dichten "
    "Nebel noch nicht ein mal den Boden sehen kannst!?");
  AddDetail( ({"luft", "irgendwas"}),
    "Irgendwas scheint in der Luft zu liegen. Du fuehlst Dich hier nicht "
    "besonders wohl und willst daher so bald wie moeglich verschwinden.");
  AddDetail("meer",
    "Dem Rauschen zufolge liegt es im Sueden.");
  AddDetail("sueden",
    "Dort scheint wohl der Strand in das Meer ueberzugehen.");
  AddDetail("rauschen",
    "Dem kann man besser lauschen!");
  AddDetail( ({"nebel", "grunde"}),
    "Er ist hier seltsamerweise so dicht, dass man im Grunde _NICHTS_ "
    "sehen kann!");
  AddDetail("nichts",
    "Ja man sieht einfach nichts.");
  AddDetail("ort",
    "Lange moechtest Du nicht an ihm verweilen.");
  AddDetail( ({"fuss", "sand"}),
    "Ab und zu sackst Du mit einem Fuss in ein Sandloch ein.");
  AddDetail("sandloch",
    "Du musst hier wohl etwas aufpassen wohin Du trittst.");
  AddDetail( ({"strand"}) ,
  QueryProp(P_INT_LONG));
  
  AddSmell(DEFAULT_SMELL,
    "Es riecht nach dem Salz, was aus dem Meer stammt.");
  AddSmell("salz",
    "Es riecht wie ein Salz aus dem Meer.");
  AddSmell("meer",
    "Der Geruch kommt aus Sueden.");
  AddSmell( ({"geruch", "sueden"}),
    "Der Geruch scheint von dem Meer im Sueden zu kommen.");
 
  AddSound(DEFAULT_SOUND,
    "Es ist hier still. Totenstill. Nur ab und zu vernimmst Du das "
    "Rauschen vom Meer.");
  AddSound("rauschen",
    "Das Meer verursacht dieses Rauschen.");
  AddSound("meer",
    "Liegt es im Sueden?");
  AddSound("sueden",
    "Ja aus Sueden kommt das Rauschen. Demnach ist auch das Meer im Sueden.");
  
  AddExit("nordoben",ROOM "wi4");
  AddExit("norden",  ROOM "wi4");
  SetProp(P_HIDE_EXITS, ({"norden"}));
 }
  
