inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem gefaehrlichen Gehege" );
  SetProp(P_INT_LONG,
    "Du bist mitten in einem gefaehrlichen Gehege gelandet! Was "
    "Dir sofort auffaellt, ist dieses Monster, was wohl hier "
    "eingesperrt wurde. Hauptsaechlich im Westen befindet sich "
    "der Zaun, durch den das Gehege abgesperrt wird. Als Dein "
    "Blick sich dem Boden zuwendet, bemerkst Du eine Menge "
    "Vogelkot, der den ganzen Boden bedeckt, einfach ekelhaft! "
    "Die Nebelschwaden sind hier ein bisschen dichter und vom "
    "Himmel ist nichts zu sehen. Durch den dichten Nebel kannst "
    "Du leider keine genaueren Details mehr erkennen.");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,0);
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:7, ENV_TERRAIN:TT_PLAIN ]) );

  AddDetail( ({"gehege"}),
  QueryProp(P_INT_LONG));
  AddDetail( ({"blick", "boden"}),
    "Der gesamte Boden ist von ekelhaften Kot bedeckt!");
  AddDetail( ({"vogelkot", "kot"}),
    "Dieser hier hat eine seltsame Farbe, aber so genau willst Du "
    "es Dir auch gar nicht ansehen.");
  AddDetail("farbe",
    "Du weisst nicht welche Farbe das sein soll - irgendwas Dunkles.");
  AddDetail("himmel",
    "Du kannst ihn hier sowieso nicht sehen, denn hier sind die "
    "Nebelschwaden noch dichter als an anderen Stellen dieser Insel.");
  AddDetail("insel",
    "Naja zur Insel scheint das Gehege unter normalen Umstaenden "
    "nicht zu gehoeren.");
  AddDetail( ({"umstaende", "umstaenden"}),
    "Sie sind keineswegs normal, denn an normalen Tagen ist es hier "
    "sicherlich nicht so dunkel.");
  AddDetail( ({"tage", "tagen"}),
    "Du sehnst Dich nach dieser Zeit.");
  AddDetail("zeit",
    "Ob Vergangenheit oder Zukunft ist ungewiss.");
  AddDetail( ({"vergangenheit", "zukunft"}),
    "Beides scheint weit weg von der Gegenwart zu sein!");
  AddDetail("gegenwart",
    "Zu diesem Zeitpunkt.");
  AddDetail("zeitpunkt",
    "Genau jetzt eben.");
  AddDetail("stellen",
    "Na woanders auf dieser Insel.");
  AddDetail("monster",
    "Es scheint nicht mehr da zu sein. Da kannst Du aber aufatmen!");
  AddDetail( ({"nebel", "nebelschwaden"}),
    "Die Nebelschwaden verdunkeln einfach alles hier! In diesem Gehege "
    "scheinen sie jedoch besonders dicht zu sein.");
  AddDetail("zaun",
    "Du kannst jederzeit ueber ihn zurueckklettern. Du bist froh, dass "
    "er ueberhaupt da ist, denn sonst wuerde dieses Monster hier vielleicht "
    "frei auf der Insel rumlaufen!");
  AddDetail("details",
    "Du kannst in diesem Gehege nur so viel erkennen, wie noetig ist, "
    "um sich hier zu orientieren.");
  AddDetail("nase",
    "Mitten in deinem Gesicht!");
  AddDetail("gesicht",
    "Na der vordere Teil deines Kopfes.");
  AddDetail( ({"teil", "kopfes", "kopf"}),
    "Ja und der befindet sich wiederum auf dem Hals und der wiederum "
    "in der Mitte deiner Schultern usw. und so fort..");
  AddDetail("hals",
    "An dem kannst Du hoechtens riechen ;-)");
  AddDetail("mitte",
    "In der Mitte befindet sich Dein Hals.");
  AddDetail("schultern",
    "Die koennten auch mal eine Massage gebrauchen.");
  AddDetail("massage",
    "Naja bei sich selber kann man das leider schlecht, aber einen "
    "Versuch ist es allemal wert.");
  AddDetail("versuch",
    "Versuch es doch mal!");
  AddDetail("westen",
    "Im Westen befindet sich der Zaun, der das Gehege abgrenzt.");
  AddDetail("menge",
    "Eine ganze Menge an Kot!");
  
  AddSmell(DEFAULT_SMELL,
    "Es riecht hier einfach widerwaertig nach Vogelkot!");
  AddSmell( ({"vogelkot", "kot", "geruch"}),
    "Anstatt den Geruch genauer identifizieren, solltest Du Dir "
    "lieber die Nase zuhalten!");
  AddSmell("hals",
    "Riecht ganz sauber. Du atmest erleichterst auf.");
  
  

  
  AddCmd( ({"kletter","klettere"}) , "cmd_klettern");
  AddCmd("massiere|massier&schultern|schulter", "cmd_massage",
         "Deine Schultern koennten in der Tat eine Massage gebrauchen!");
  AddCmd("halt|halte&nase&zu", "cmd_nase",
         "Was willst Du denn zuhalten?|Na Aufhalten geht ja wohl schlecht.");
  
  AddItem(NPC "vogel", REFRESH_DESTRUCT);
 
  // Einziger Ausgang ist das Klettern ueber den Zaun.
 
}

int cmd_klettern(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "ueber zaun"         ||
       str == "zurueck"  ||
       str == "an Zaun hinauf"             ||
       str == "ueber Zaun rueber"           )) return 0; 
  TP->move(ROOM "grei1",M_GO,"ueber den Zaun zurueck","klettert",
    "kommt ueber den Zaun zurueck geklettert");
  VANAMASTER->Msg(TPN+" klettert aus dem Gehege raus");
  return 1;
} 
  
int cmd_massage(string str)
{
  write(BS(
    "Bei dem laecherlichen Versuch Dich selber zu massieren bekommst Du "
    "glatt einen Krampf in Deinen Armen! Irgendwie fuehlst Du Dich "
    "ein wenig eingeschuechterter als sonst; warum kannst Du jedoch "
    "nicht sagen. Seltsam."));
  TP->SetProp(P_WIMPY, 10+random(26)+TP->QueryProp(P_WIMPY));
  TO->Message(TP->Name()+ BS(" gestikuliert ploetzlich seltsam herum und "
                             "schreit ploetzlich kurz auf.")
                             ,MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  VANAMASTER->Msg(TPN+" massiert sich selber->Plus auf WIMPY");
  return 1;
}

int cmd_nase(string str)
{
  write(BS(
    "Du haelst Dir die Nase ganz fest zu, sodass Du keine Gerueche mehr "
    "wahrnimmst. Du geniesst diesen kurzen Augenblick, in dem Du nicht "
    "von dem widerwaertigen Geruch des Vogelkots gestoert wirst. Nach "
    "einer Zeit wendest Du Dich jedoch wichtigeren Dingen und laesst "
    "Deine Haende wieder von Deiner Nase ab."));
  TO->Message(TP->Name()+ BS(" haelt seine Nase zu und gluckst ganz erfreut."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}