inherit "std/room";

#include "../def.h"

string detail_gehege();


void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine sandige Ebene" );
  SetProp(P_INT_LONG,
    "Ab hier geht die Wiese in ein sandiges Gebiet ueber. Du kannst nur noch "
    "vereinzelt Graeser erkennen. Am Boden kannst Du viele stinknormale "
    "Kieselsteine sehen. Im Osten wurde ein Zaun gezogen, der ein Gehege "
    "zu umgeben scheint. An ihm ist eine Tafel angebracht. ");   
  SetProp(P_LIGHT,0);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:7, ENV_TERRAIN:TT_PLAIN ]) );

  AddDetail( ({ "gras", "graeser", "grashalme", "grashalm", "grasbueschel" }),
    "Die Graeser sind hier in der Tat nur noch sehr vereinzelt zu erkennen.");
  AddDetail( "boden",
    "Hier ist er voller Sand. Nur noch vereinzelte Grashalme sind zu sehen.");    
  AddDetail( ({ "sand", "sandkorn", "sandkoerner" }),
    "Beim Anblick der Sandkoerner errinerst Du Dich an Deine Kindheit. ");
  AddDetail( "kindheit",
    "In Deiner Kindheit hast Du auch oft im Sandkasten gespielt! ");
  AddDetail( "sandkasten",
    "Im Sandkasten hattest Du immer besonders Freude daran, im Sand "
    "herumzubuddeln. ");
  AddDetail( "wiese",
    "Die hoert hier abrupt auf und stattdessen ist hier hauptsaechlich Sand.");
  AddDetail( ({ "stein", "steine", "kieselstein", "kieselsteine" }),  
    "Ganz normale Kieselsteine. Nichts besonderes.");
  AddDetail( ({ "donnervogel", "vogel"}),
    "Er sieht sehr gefaehrlich aus!");
  AddDetail( "ausgaenge",
    "Du kannst keine sehen. Aber Du kommst sicherlich zurueck, wie Du auch "
    "hingekommen bist!");
  AddDetail( "anblick",
    "Bei ihm musst Du komischerweise an Deine Kindheit denken!");
  AddDetail("gegend",
    "Auch diese sandige Ebene ist betroffen.");
  AddDetail("gehege",#'detail_gehege);
  AddDetail( ({"nebel" , "nebelschwaden" }), 
    "Die Nebelschwaden verdustern die ganze Gegend.");
  AddDetail( ({"ebene"}) ,
  QueryProp(P_INT_LONG));
  AddDetail(({"freude"}),
    "Du wuerdest diese Freuden gerne noch mal spueren.");
  AddDetail("zaun",
    "Du koenntest sicherlich ueber den Zaun klettern, ob Du das "
    "jedoch willst, ist eine andere Frage.");
  AddDetail("frage",
    "Die musst Du Dir leider selber beantworten.");
  AddDetail("gebiet",
    "Im Westen ist das Gebiet mehr eine Wiese, hier jedoch nur eine "
    "sandige Ebene.");
  AddDetail("westen",
    "Dort liegt eine Wiese.");
  AddDetail("tafel",
    "Sie scheint Irgendetwas darzustellen.");
  AddDetail("irgendetwas",
    "Vielleicht soll es ja ein Totenkopf sein?!");
  AddDetail(({"totenkopf", "kopf"}),
    "Es scheint wirklich ein Totenkopf zu sein! Steht der nicht "
    "normalerweise fuer Gefahr und den Tod selber?");
  AddDetail("gefahr",
    "Wahrscheinlich ist eine Gefahr innerhalb des Geheges gemeint.");
  AddDetail("tod",
    "Der Tod sagt: KOMM MIT MIR, STERBLICHER! "
    "Du schuettelst Dich.");
  AddDetail(({"mit", "mir", "sterblicher", "worte"}),
    "Diese Worte magst Du lieber nicht vernehmen muessen!");
  AddDetail("himmel",
    "Aufgrund dieser Nebelschwaden kannst Du keinen Himmel und "
    "keine Sonne erkennen.");
  AddDetail("sonne",
    "Die muesste irgendwo oben am Himmel sein.");
  AddDetail( ({"vogelkot", "kot"}),
    "Einfach abartig!");
  AddDetail("tat",
    "Tatsaechlich gibt es nur noch vereinzelte Graeser!");
  AddDetail("nase",
    "Mitten in Deinem Gesicht! Benutz sie doch auch einfach mal.");
  AddDetail("gesicht",
    "Dir faellt nur Deine Nase auf.");
  AddDetail("details",
    "Im Gehege kannst Du kaum auffaellige Details entdecken.");
  AddDetail("blick",
    "Naja Deinen Blickwinkel musst Du schon aendern, um den Boden "
    "innerhalb des Geheges zu sehen.");
  AddDetail("blickwinkel",
    "Versuch in das Gehege zu kommen!");

  AddSmell(DEFAULT_SMELL,
    "Du ruempfst die Nase, als Du herumschnupperst: Es riecht hier "
    "streng nach Vogelkot!");
  AddSmell(({"kot", "vogelkot", "geruch", "vogel"}),
    "Der Geruch kommt wohl von einem Vogel aus dem Gehege im Osten.");
  AddSmell(({"geruch", "vogel", "gestank"}),
    "Der Geruch kommt aus dem Gehege im Osten.");
  AddSmell(({"gehege", "osten"}),
    "Der Vogel in diesem Gehege verursacht diesen Gestank!");
    
  AddSound(DEFAULT_SOUND,
    "Die Stille wird nur ab und zu durch ein Schnaufen gestoert.");
  AddSound("stille",
    "Von dem Schnaufen mal abgesehen, ist es hier absolut still.");
  AddSound("schnaufen",
    "Dieses Schnaufen kommt von Osten!");
  AddSound("osten",
    "Es kommt aus dem Gehege!");
  AddSound("gehege",
    "Ein gewaltiges Monster muss dieses Schnaufen verursachen!");
  AddSound("monster",
    "Das ist zum Glueck im Gehege eingesperrt!");
  AddSound("glueck",
    "Wie willst Du denn dem Glueck lauschen koennen?");
  
  AddCmd( ({ "buddel", "buddele", "buddle", "buddl"}), "cmd_buddeln" );
  AddCmd( "buddel|buddl|buddele|buddle&in|im|sand&herum", "cmd_buddeln",
          "In was moechtest Du herumbuddeln?","Im Sand herumbuddeln?",
          "Als Kind hast Du immer im Sand herumgebuddelt.");
       AddCmd( ({ "kletter", "klettere", "klettre" }), "cmd_klettern" );
       
  AddItem(NPC "kauz", REFRESH_DESTRUCT);  
  AddExit("westen",   ROOM "wi4");
 
}
/*
void reset()
{
  ::reset();
  zettel=1;
}  
*/
string detail_gehege()
{
  object ort;
  string beschreibung;
  call_other(ROOM "grei3", "???", 0);
  ort = find_object ( ROOM "grei3" );
  if (!objectp(ort))
  {
   VANAMASTER->Msg(TPN+" FEHLER in grei1.c bei detail_gehege");
   return "Fehler! Bitte Malar, Archon oder Cirion Bescheid geben!\n";
  }
  write("Du wirfst einen Blick in das gefaehrliche Gehege: \n\n");
  beschreibung = (string)ort->int_long(TP,TP);
  VANAMASTER->Msg(TPN+" wirft einen Blick ins Gehege");
  return beschreibung;
}

int cmd_klettern(string str)
{
  notify_fail("Worueber moechtest Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "ueber zaun"         ||
       str == "auf baum hinueber"  ||
       str == "an Zaun hinauf"             ||
       str == "ueber Zaun rueber"           )) return 0; 
  write("Du bleibst am Zaun haengen und verletzt Dich dabei!\n"); 
  TP->AddHp(-((random(6)+5)));
  TP->move(ROOM "grei3",M_GO,"ueber den Zaun","klettert",
    "kommt ueber den Zaun geklettert");
  VANAMASTER->Msg(TPN+" klettert ins Gehege (LP-Verlust!)");
  return 1;
}                

int cmd_buddeln(string str)
{
  if (deep_present("vanazettel", TP))
    {
      write("Du graebst wie wild im Sand herum, findest jedoch nichts.\n");
      Message(BS(TPN+" graebt ploetzlich wie wild im Sand herum, schaut "
                     "danach jedoch nur frustriert in der Gegend herum."),
                     MSGFLAG_VISUAL|MSGFLAG_NO_TP);  
      VANAMASTER->Msg(TPN+" sucht erneut nach dem Zettel");
      return 1;
    }
  write(BS(
    "Du faengst wie wild an im Sand herumzugraben und nach einiger Zeit "
    "stoesst Du auf einen etwas festeren Gegenstand. Du ziehst ihn "
    "natuerlich sofort aus dem Sand und steckst ihn ein."));
  Message(BS(TPN+" graebt ploetzlich wie wild im Sand herum und zieht auf "
                 "ein mal begeistert einen Gegendstand aus dem Sand."),
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
  CLONE(OBJ "zettel1", TP);
  write_file(LOG "questverlauf", 
    "("+ctime(time())+") "+TPN+" findet den Zettel.\n");
  VANAMASTER->Msg(TPN+" findet den Zettel");
  return 1;
}

