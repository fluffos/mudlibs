inherit "std/room";

#include "../def.h"

string smell_kelch();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Ende einer Wiese" );
  SetProp(P_INT_LONG,
    "Du bist nun am Ende der Wiese angelangt. Hier beginnt sich "
    "allmaehlich das Gras zu lichten und geht mehr und mehr in "
    "ein sandiges Gebiet ueber. Im Osten meinst Du irgendwelche "
    "seltsamen Gehege erkennen zu koennen. Im Westen siehst Du "
    "nun den grossen Berg recht genau. Eine Spitze des Berges "
    "kannst Du jedoch nicht erkennen. Im Sueden siehst Du schon "
    "wieder das Meer sowie einen kleinen Teil des Strandes.");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:8, ENV_TERRAIN:TT_PLAIN ]) );

  AddDetail( "himmel",
    "Der Himmel ist auch hier total dunkel durch den dichten Nebel, der "
    "mit all seinen Nebelschwaden alles hier verdunkelt.");
  AddDetail( ({"nebel" , "nebelschwaden" }), 
    "Die Nebelschwaden geben der Sonne keine Chance.");
  AddDetail( "sonne",
    "Sie muesste irgendwo hinter den Nebelschwaden sein.");
  AddDetail( ({"wiese"}) ,
  QueryProp(P_INT_LONG));
  AddDetail("berg",
    "Er ist so hoch, dass Du seine Spitze nicht erkennen kannst!");
  AddDetail("spitze",
    "Vielleicht ist sie ja hoeher als die Nebelschwaden. Demnach sollte "
    "es da oben ja sogar Licht geben!");
  AddDetail("licht",
    "Hier ist jedenfalls keines.");
  AddDetail("boden",
    "Am Boden siehst Du hauptsaechlich Gras und einige Blumen. Jedoch "
    "geht ab hier das Gras in ein Gebiet mit mehr Sand ueber.");
  AddDetail("sand",
    "Hier kannst Du nur vereinzelt welchen entdecken.");
  AddDetail("blumen",
    "Sie sehen alle normal aus, nur ihre Farbe sieht extrem seltsam aus. "
    "Eine Blume faellt Dir besonders auf.");
  AddDetail("farbe",
    "Voellig Schwarz.");
  AddDetail("blume",
    "Sie ist besonders gross und hat einen seltsam geformten Bluetenkelch.");
  AddDetail("bluetenkelch",
    "Er stroemt einen seltsamen Duft aus.");
  AddDetail(({"duft", "duefte"}),
    "Um den naeher zu identifizieren, musst Du schon Deine Nase gebrauchen.");
  AddDetail("nase",
    "Mit ihr kannst Du alle Duefte erschnuppern.");
  AddDetail("farbe",
    "Die der Blumen ist voellig schwarz.");
  AddDetail("ende",
    "Die Wiese ist deshalb zu Ende, weil das Gebiet hier sandiger wird.");
  AddDetail("gebiet",
    "Es geht hier langsam von der Wiese in ein sandiges Gebiet ueber.");
  AddDetail("gehege",
    "Fuer wen oder was kannst Du nicht sagen. Es muss jedoch ein maechtiges "
    "Monster sein, dass man es extra in ein Gehege sperren muss.");
  AddDetail("monster",
    "Vielleicht ein Vogel?");
  AddDetail("vogel",
    "Vielleicht sind die Voegel ja sogar fuer die Dunkelheit verantwortlich..");
  AddDetail("voegel",
    "Sie muessen gewaltige Maechte haben, wenn sie diese Nebelschwaden "
    "beinflussen koennen!");
  AddDetail("maechte",
    "Du kannst es nicht einschaetzen, aber sie muessen ziemlich gross sein.");
  AddDetail("dunkelheit",
    "Dadurch, dass die Nebelschwaden keinen Sonnenschein durchlassen, ist "
    "hier auch kein Licht.");
  AddDetail(({"sonnenschein", "sonnenstrahl"}),
    "Du siehst jedenfalls keinen.");
  AddDetail("gras",
    "Das ist voellig verblichen. Ist aber nicht weiter interessant.");
  AddDetail("chance",
    "Sie Sonne hat keine Chance nur einen einzigen Sonnenstrahl durch "
    "den Nebel zu schicken.");
  AddDetail("meer",
    "Das Meer befindet sich im Sueden. Jedoch kannst Du davor noch einen "
    "kleinen Strand erkennen.");
  AddDetail(({"teil", "strandes", "strand", "strandteil"}),
    "Der kleine Strandteil vor dem Meer ist wirklich nur ganz klein. Dir "
    "faellt erstmal nur die dunklere Sandfarbe auf, die sich bei den anderen "
    "Strandteilen nicht gezeigt hat.");
  AddDetail(({"strandteilen", "strandteile"}),
    "Die befinden sich irgendwo weiter westlich.");
  AddDetail("sandfarbe",
    "An diesem Strandteil ist der Sand um einiges dunkler als bei "
    "den anderen Dir bekannten Strandteilen.");
  AddDetail("lehre",
    "Moege Dir das eine Lehre sein!");
  AddDetail("hustenanfall",
    "Du hast Dich hoffentlich von ihm erholt.");
  AddDetail("lunge",
    "Sie tut nicht mehr weh.");
  AddDetail("schmerz",
    "Der ist endlich weg.");
  AddDetail("osten",
    "Im Osten ist ein Gehege. Wirf einfach einen Blick darauf.");
  AddDetail("blick",
    "Untersuche das Gehege!");
    
  AddSmell(DEFAULT_SMELL,
    "Dir kriecht der Geruch von Tod und Verwesung in die Nase.");
  AddSmell(({"geruch", "tod", "verwesung"}),
    "Der Geruch scheint vom Boden zu kommen.");
  AddSmell("boden",
    "Der Geruch kommt wohl irgendwo aus dem Gras.");
  AddSmell("gras",
    "Vielleicht von den Blumen?");
  AddSmell("blumen",
    "Der Geruch scheint tatsaechlich von den Blumen zu kommen. Von einer "
    "Blume scheint der Geruch jedoch besonders stark ausgesondert zu werden.");
  AddSmell("blume",
    "Der Geruch kommt aus ihrem Bluetenkelch!");
  AddSmell( ({"bluetenkelch"}), #'smell_kelch);
 
  AddSound(DEFAULT_SOUND,
    "Es ist hier voellig ruhig. Nur leise ist das Meerrauschen zu hoeren.");
  AddSound("meerrauschen",
    "Es kommt von Sueden.");
  AddSound("sueden",
    "Da ist wohl das Meer.");
  AddSound("meer",
    "Es verursacht das schoene Meerrauschen, was du hoeren kannst.");
    
  AddItem(NPC "vana", REFRESH_DESTRUCT);
  AddItem(NPC "vana", REFRESH_DESTRUCT);
  
  SetProp(P_HIDE_EXITS, ({"westen", "sueden"}) );

  
  AddExit("westoben",    ROOM "berg1");
  AddExit("westen",      ROOM "berg1");
  AddExit("suedunten",   ROOM "stra3");
  AddExit("sueden",      ROOM "stra3");
  AddExit("osten",       ROOM "grei1");
  AddExit("nordwesten",  ROOM "wi2");

 
}
  
string smell_kelch()
{
  TO->Message(TP->Name()+" riecht an einer Blume und hustet herum.\n"
             ,MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  TP->AddHp(-1-random(13));
  return(BS(
    "Du riechst tief den Geruch des Bluetenkelches ein. Ploetzlich "
    "bemerkst Du jedoch einen tief einschneidenen Schmerz in deiner "
    "Lunge! Du kriegst einen Hustenanfall und wirst dadurch endlich "
    "den Geruch aus deine Lunge los. Jedoch merkst Du noch immer "
    "ein wenig die Schmerzen und denkst, dass Dir das eine Lehre "
    "gewesen ist."));
  VANAMASTER->Msg(TPN+" riecht an der Blume -> LP-Verlust");
}