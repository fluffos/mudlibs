// 2004-01-05  Malar@SL: Erweiterung der Galeere(+wasser/feyaria/schiffe)

inherit "std/room";

#include "../def.h"

#define GALEERE "/d/wasser/feyaria/schiffe/galeere"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Ausguck" );
  SetProp(P_INT_LONG,
    "Du stehst jetzt mitten in einem Bastkorb. Hier oben ist es "
    "gleich um einiges kuehler, denn Wind saust Dir nur so um "
    "die Ohren! Von hier aus hast Du eine Aussicht ueber das "
    "gesamte Meer und natuerlich auch ueber die Galeere. Der "
    "Bastkorb selber geht Dir ungefaehr bis zur Huefte und Du "
    "kannst Dich daher bequem auf ihn stuetzen und die Aussicht "
    "geniessen!");  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:7+random(4),ENV_TERRAIN:TT_OTHER]));

  AddDetail( "himmel",
    "Du kannst nur einige Wolken erkennen, ansonsten herrscht "
    "ein Superwetter!");
  AddDetail( "insel",
    "Vielleicht verbirgt sich ja in den Nebelschwaden eine "
    "geheimnisvolle Insel? Um das jedoch genauer herauszufinden, "
    "muesstest Du einen Weg finden, dorthin zu gelangen.. Vielleicht "
    "kannst Du ja irgendwo ein Beiboot klar machen.");
  AddDetail( "meer", 
    "Du hast eine weite Aussicht ueber das ganze Meer!");
  AddDetail( "wasser",
    "Die Temperatur des Wassers ist bestimmt kalt.");
  AddDetail( "temperatur",
    "BRRR!");
  AddDetail( "boden",
    "Du bemerkst die Holzplanken unter Deinen Fuessen.");
  AddDetail( ({"korb", "bastkorb"}) ,
  QueryProp(P_INT_LONG));
  AddDetail( "spitze",
    "Der Korb befindet sich an der Spitze vom Mast.");
  AddDetail( "sonne", 
    "Die strahlt hell und warm ueber Dir.");
  AddDetail( "strahlen",
    "Ziemlich hell.");
  AddDetail( ({"algen", "salz", "fische", "alles", "dinge"}),
    "Die Dinge im Meer verursachen diesen salzigen Meergeruch.");
  AddDetail( "aussicht",
    "Die Aussicht ist einfach wahnsinnig! Du kannst das ganze Meer "
    "ueberblicken, jedoch an einer Stelle nicht!");
  AddDetail( "stelle",
    "Von hier aus gesehen nur ein grauer Punkt.");
  AddDetail( "punkt",
    "Wahrscheinlich ist das eine Anhaeufung von Nebelschwaden!");
  AddDetail( ({"anhaeufung","nebel","nebelschwaden"}),
    "Sie verdecken bestimmt etwas Besonderes! Die sehen verdammt "
    "dunkel und dicht aus! Wenn man dort ein mal wirklich landen "
    "sollte, waere eine Lichtquelle sicher nicht schlecht.");
  AddDetail( "etwas",
    "Vielleicht eine Insel?");
  AddDetail( ({"boot", "beiboot"}),
    "Guck doch mal unten.");
  AddDetail( "mast",
    "Der befindet sich unter Dir. An ihm kannst Du jederzeit wieder "
    "runter klettern.");
  AddDetail( ({"fuesse", "fuessen"}),
    "Unter Deinen Fuessen kannst Du die Holzplanken spueren.");
  AddDetail( "wolke",
    "Nur ganz wenige sind zu sehen.");
  AddDetail( ({"wind", "ohren"}),
    "Der Wind pfeift Dir um die Ohren!");
  AddDetail( "galeere",
    "Du befindest Dich ganz oben auf der Galeere!");
  AddDetail( ({"holzplanken", "planken"}),
    "Aus denen besteht der Boden hier.");
  AddDetail( "huefte",
    "Ja, der Korb selber geht Dir ungefaehr bis zur Huefte.");
  AddDetail( "weg",
    "Der geht sicherlich ueber das Wasser!");
  AddDetail( ({"wetter", "superwetter"}),
    "Einfach herrlich.");
  AddDetail("lichtquelle",
    "Eine einfache Fackel oder eine andere Lichtquelle reicht sicher.");
  AddDetail("fackel",
    "Eine Fackel kriegt man doch sicherlich in irgendeinem Laden.");
  AddDetail("laden",
    "Irgendein Laden wird Dir schon eine Fackel verkaufen.");
     
  AddSmell(DEFAULT_SMELL,
    "Hier riechst Du die salzige Meerluft.");
  AddSmell(({"meerluft","luft"}),
    "Sie riecht nach Salz.");
  AddSmell( ({"salz", "algen", "fisch", "fische"}),
    "Der typische Meergeruch eben.");
  AddSmell(({"meergeruch","geruch"}),
    "Der beinhaltet Algen, Salz, Fische und alles, was so kreucht und fleucht.");
  
  
  AddSound(DEFAULT_SOUND, 
    "Das Rauschen der Wellen im Meer rauscht laut von unten herauf.");
  AddSound("meer",
    "Obwohl Du den ganzen Mast hochgeklettert bist, kannst Du das Meer "
    "hier noch sehr laut rauschen hoeren!");
  AddSound("wellen",
    "Sobald sie brechen geben sie ein starkes Rauschen von sich.");
  AddSound("rauschen",
    "Es ist so laut, dass du es bis hierher hoeren kannst!");
  AddSound("wind",
    "Er pfeift Dir nur so um die Ohren!");
  
  AddCmd("kletter|klettere&an&mast&runter|hinunter", "cmd_mast",
         "Willst Du _an_ dem Mast runterklettern?|"
         "An was willst Du denn runter klettern?|"
         "Kletter doch einfach an dem Mast runter!");
         
}
  
  
int cmd_mast(string str)
{
  write(BS(
    "HUI!! Du wolltest eigentlich klettern, aber Deine Kletterei wird zu "
    "einem Rutschen, so dass Du ohne weitere Muehe oder Probleme den ganzen "
    "Mast hinunter rutscht."));
  TP->do_exhaust(120+random(30));
  TP->move(GALEERE,M_GO,
       "den Mast runter",
       "rutscht",
       "kommt am Mast heruntergerutscht");
  return 1;
}   

varargs string GetExits(object viewer)
{
  return "Du kannst jederzeit wieder an dem Mast runterklettern!\n";	
} 