inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Mitten auf einer Wiese" );
  SetProp(P_INT_LONG,
    "Du scheinst jetzt ungefaehr in der Mitte der Wiese zu stehen. Am "
    "meisten faellt Dir jedoch erstmal das schwarze Etwas vor Deinen "
    "Fuessen auf, das seltsam herumglitzert. Im Osten findet die Insel "
    "schon wieder ein Ende, da direkt hinter einer kleinen Steinmauer "
    "das Meer wieder seinem Lauf folgt. Im Sueden kannst Du einen grossen "
    "Berg oder etwas aehnliches erkennen. Von hier aus wirst Du ihn "
    "jedenfalls nicht erreichen koennen. Die Wiese erstreckt sich sonst "
    "noch ueber einen Auslaeufer nach Suedosten. Im Westen kannst Du in "
    "noch einiger Entfernung das weite Meer erkennen.");
  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:7, ENV_TERRAIN:TT_PLAIN ]) );

  AddDetail( "himmel",
    "Der Himmel ist duester und die ganzen Nebelschwaden verdunkeln "
    "deine gesamte Umgebung vollstaendig.");
  AddDetail( ({"nebel" , "nebelschwaden" }), 
    "Sie verdustern alles!");
  AddDetail( "auslaeufer",
    "Nach diesem Auslaeufer scheint die Wiese am Ende zu sein.");
  AddDetail( "ende",
    "Naja sie geht eben in eine andere Art von Gebiet ueber.");
  AddDetail( ({"art" , "gebiet" }), 
    "Eben keine Wiese mehr; vielmehr Sand und Gestein.");
  AddDetail( "sand",
    "Hier kannst Du noch keinen entdecken.");
  AddDetail( "gestein",
    "Meinst Du etwa die Steinmauer?");
  AddDetail( "berg",
    "Wahrscheinlich ist es ein Berg, denn was soll diese Anhoehung sonst "
    "wohl darstellen?");
  AddDetail( "anhoehung",
    "Schau sie Dir doch mal naeher an!");
  AddDetail( "boden",
    "Alles was Du am Boden erkennen kannst, ist Gras und ein undefinierbares "
    "glitzerndes Etwas.");
  AddDetail( "etwas",
    "Es wirft so einen seltsamen Glitzer zurueck!");
  AddDetail( "glitzer",
    "Genau wie Wasser.");
  AddDetail( "wasser",
    "Vielleicht ist dieses Etwas ja ein Gewaesser?");
  AddDetail( "gewaesser",
    "Wenn es wirklich eins waere, muesste es demnach ja ein kleiner See sein.");
  AddDetail( "see",
    "Tatsaechlich! In der Dunkelheit konntest Du es nicht richtig erkennen, "
    "aber bei diesem Wasser scheint es sich tatsaechlich um einen See zu "
    "handeln! Nur faellt Dir die Farbe des Wassers besonders auf.");
  AddDetail( "farbe",
    "Absolut Schwarz.");
  AddDetail( "schwarz",
    "Schwarz wie die Nacht.");
  AddDetail( "nacht",
    "Ob wir gerade Nacht oder Tag haben, kannst Du nicht sagen.");
  AddDetail( "tag",
    "Vielleicht haben wir auch Tag, ja.");
  AddDetail( "dunkelheit",
    "Sie ummantelt die Insel.");
  AddDetail( "insel",
    "Sie ist von der Dunkelheit ummantelt!");
  AddDetail( "wiese",
    "Das Gras sieht sehr seltsam aus.");
  AddDetail( "gras",
    "Es ist total verblichen und sieht keineswegs nach Leben aus.");
  AddDetail( "leben",
    "Vielleicht lebt dieses Gras ja auch gar nicht mehr..");
  AddDetail( "mitte",
    "Grob gesehen befindest Du Dich hier in der Mitte der Wiese.");
  AddDetail(({"mauer", "steinmauer"}),
    "Sie sieht nicht besonders spektakulaer aus, denn sie hat keinerlei "
    "besondere Ritzen oder Fugen. Jedoch kannst Du einige Malereien "
    "entdecken, die um einiges interessanter als alles andere sein duerften.");
  AddDetail(({"fugen", "ritzen"}),
    "Davon hat die Mauer zwar sicherlich genug, sind jedoch eh "
    "alle uninteressant.");
  AddDetail("malereien",
    "Du bist Dir zwar nicht sicher, aber sie scheinen Geschichten "
    "zu erzaehlen.");
  AddDetail("geschichten",
    "Geschichten aus gar nicht mal so alter Zeit.");
  AddDetail("zeit",
    "Das waren noch Zeiten..");
  AddDetail("zeiten",
    "Sie scheinen hier sehr schoen und voller Leben gewesen zu sein.");
  AddDetail(({"fuessen", "fuesse"}),
    "Direkt am Boden.");
  AddDetail("umgebung",
    "Die ganze Wiese wird verdunkelt - wenn nicht sogar die ganze Insel!");
  AddDetail("lauf",
    "Einen richtigen Lauf scheint das Meer hier nicht zu haben. Also keinen "
    "Strom oder dergleichen kannst Du entdecken.");
  AddDetail("strom",
    "Du siehst jedenfalls keinen.");
  AddDetail("westen",
    "Hinter der Wiese kannst Du noch so gerade das grosse Meer erkennen.");
  AddDetail("meer",
    "Es erstreckt sich bis zum Horizont.");
  AddDetail("horizont",
    "Den kannst Du in dieser Dunkelheit auf der Insel nun wirklich "
    "nicht mehr erkennen.");
  AddDetail("entfernung",
    "Das Meer ist von hier aus gesehen ganz schoen weit weg.");
  AddDetail("osten",
    "Weiter im Osten scheint keine Wiese mehr zu sein; sie findet direkt "
    "ein abruptes Ende.");
  

     
  AddSmell(DEFAULT_SMELL,
    "Es riecht hier nach Tod und Faeule.");
  AddSmell(({"tod", "faeule", "gestank", "geruch"}),
    "Der Geruch scheint von der Wiese zu kommen.");
  AddSmell("wiese",
    "Sie verursacht diesen abscheulichen Gestank - wahrscheinlich durch "
    "das seltsame Gras.");
  AddSmell("gras",
    "Das Gras riecht einfach nur abscheulich nach Tod und Faeule.");
  
  AddSound(DEFAULT_SOUND, 
    "Es ist hier voellig still. Aber halt! Du glaubst ganz leise das "
    "Rauschen des Meeres zu vernehmen.");
  AddSound(({"meer", "rauschen", "meeresrauschen"}),
    "Das Meerrauschen kommt aus Westen.");
    
  AddItem(NPC "blueti", REFRESH_DESTRUCT);
  AddItem(NPC "blueti", REFRESH_DESTRUCT);  


  

  
  AddExit("suedwestoben", ROOM "wi3");
  AddExit("suedwesten",   ROOM "wi3");
  AddExit("westen",       ROOM "wi1");
  AddExit("suedosten",    ROOM "wi4");
  SetProp(P_HIDE_EXITS, ({"suedwesten"}) );

  
 
}
  
