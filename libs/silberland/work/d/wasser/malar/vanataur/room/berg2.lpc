int cmd_sand(string str)
{
  write(BS(
    "Du legst Dich fuer einige Sekunden in den Sand, springst dann jedoch "
    "vor Schmerz wieder auf! Der Sand ist so heiss, dass es Dir am "
    "Hintern verdammt heiss geworden ist!"));
  TP->AddHp(-random(20));
  VANAMASTER->Msg(TPN+" legt sich in berg2.c in den Sand und verliert rand. 20LP");
  return 1;
}