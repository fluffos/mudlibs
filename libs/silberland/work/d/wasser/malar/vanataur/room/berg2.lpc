//5.3.04: Erweiterung um cmd_sand; Malar
inherit "std/room";

#include "../def.h"

string worte(string key)
{
  //Wozu 2 mal das Objekt?
  if(deep_present("\nvana_worte", TP))
    {
      VANAMASTER->Msg(TPN+" versucht erneut die Worte zu bekommen");	
      return "Du hast diese Worte bereits fest in dein Hirn gebrannt!\n";
    }
  //Sofern man das "Worteobjekt" nicht hat und auch die Quest macht -> Worte
  if(!deep_present("\nvana_worte", TP) && present("\nvana_quest", TP))
    {
     CLONE(OBJ "worte", TP);
     write_file(LOG "questverlauf", 
       "("+ctime(time())+") "+TPN+" hoert die Worte.\n");
     VANAMASTER->Msg(TPN+" hoert die Worte");
     return "Du hoerst diese magischen Worte und brennst sie fest in Dein Hirn!\n";
    }
  //Man hat kein "Worteobjekt" aber macht die Quest nicht:
  VANAMASTER->Msg(TPN+" hoert die Worte ohne QOBJ");
  return "Du kannst sie nicht verstehen!\n";
}

int nurnpcs(string dir)
{
  if(TP->id("sandwurm")) return TP->move(ROOM "npcraum", M_GO, 0,
                         "verschwindet im Sand", "graebt sich herein");
  else return 0;
}

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Plateau" );
  SetProp(P_INT_LONG, 
    "Hier stehst du auf einem glatten, sandigen Plateau. Viel sehen kannst du "
    "hier nicht, denn Du bist nun ueber den dunklen Wolken, die sich fast bis "
    "zum Horizont erstrecken! Hier oben findest es du es ziemlich oede, denn "
    "hier ist ausser einem seltsamem Tempel im Westen nichts weiter besonderes. "
    "Am Rand des Plateaus fallen Dir deine eigenen Spuren auf, die Du beim "
    "raufklettern verursacht hast. ");
  SetProp(P_LIGHT,2);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:32,ENV_TERRAIN:TT_PLAIN ]) );
  
  AddDetail( ({ "plateau", "graeser" }),
    "Die Graeser sind alle fast farblos.");
  AddDetail( "plateau",
    "Du bist zwar froh endlich oben angekommen zu sein; hattest Dir jedoch "
    "mehr von der ganzen Muehe erhofft. Denn in Deinen Augen siehst Du nichts "
    "wirklich besonderes hier oben. ");
  AddDetail( "einkerbungen", 
    "Es sieht so aus, als ob irgendwer schon mal "
    "mit Hilfe der Einkerbungen auf den Berg "
    "geklettert ist!");
  AddDetail( "tempel",
    "Vielleicht eine heilige Staette?");
  AddDetail( "staette",
    "Was es nun genau ist, musst Du wohl selbst herausfinden!");
  AddDetail( "boden", 
    "Am Boden kannst Du ab und zu Wuermer erkennen, die sich "
    "durch den Sand schlaengeln.");
  AddDetail( "himmel",
    "Ueber Dir die grelle Sonne und unter Dir die "
    "Wolken - das ist doch mal was!");
  AddDetail( "horizont",
    "Am Horizont meinst Du Land erkennen zu koennen!");
  AddDetail( "land",
    "Du weisst nicht, welches Land das sein koennte.");
  AddDetail( "wolken",
    "Es ist echt kein Wunder, dass es auf der ganzen Insel stockduster ist, "
    "da die dunklen Wolken sehr dicht sind.");
  AddDetail( "wunder",
    "Das ist es in der Tat nicht.");
  AddDetail( "sandwuermer",
    "Ein paar Sandwuermer hinterlassen Schlangenlinien im Sand.");
  AddDetail( "wuermer",
    "Ein paar Sandwuermer hinterlassen Schlangenlinien im Sand.");
  AddDetail( "schlangenlinien",
    "Die kommen von den Sandwuermern!");  
  AddDetail( "rand",
    "Dort koenntest Du auch wieder runter klettern.");
  AddDetail( "spuren",
    "Die sind nicht zu uebersehen, denn Du hast Dich schwer getan, Dich "
    "ein letztes Mal ein Stueck hoeher zu ziehen.");
  AddDetail( "insel",
    "Die kannst Du wegen den Wolken nicht sehen.");
  AddDetail( "kletterei",
    "Die hat Dir schwer zu schaffen gemacht!");
  AddDetail( "muehe",
    "Haettest Du sie Dir vielleicht sparen koennen?");
  AddDetail( "stueck",
    "Tja, Du musstest Dich nun mal Stueck fuer Stueck hocharbeiten.");
  AddDetail( "sand",
    "Leg Dich doch in den Sand, um dich zu erholen.");
  AddDetail( "strapazen",
    "Die Kletterei war in der Tat sehr anstrengend.");
  AddDetail( "augen",
    "Vielleicht aendert sich ja Deine Meinung bald.");
  AddDetail( "meinung",
    "Die aendert sich von Zeit zu Zeit.");
  AddDetail( "zeit",
    "Na das ist doch wohl klar.");
  AddDetail( "anstrengung",
    "Du hast Dich wirklich verausgabt.");
  AddDetail( "mal",
    "Da hattest Du es endlich geschafft.");
  AddSpecialDetail( ({ "sonne" }), "sonne" );
  AddDetail("sternchen",
    "Du hast kein besonderes Verlangen sie noch ein mal sehen "
    "zu muessen.");
  AddDetail("verlangen",
    "Du hast keines! Naja falls doch, Du wirst ja wissen, "
    "wie man sich solche Sternchen besorgt.");
  AddDetail("westen",
    "Im Westen ist eine Art Tempel.");
  AddDetail("waerme",
    "Besonders geniesst Du die Waerme auf diesem Plateau. "
    "Im Gegensatz zu den restlichen Teilen der Insel ist "
    "es auf diesem Plateau hell und warm.");
  AddDetail( ({"stellen", "teilen", "teile", "gegensatz"}),
    "Hier ist es hell und warm und an anderen Stellen "
    "der Insel ist es kalt und dunkel!");
  AddDetail("berg",
    "Du befindest Dich mitten auf ihm - auf einem Plateau.");
  AddDetail( ({"hilfe", "hilfsmittel", "rolle"}),
    "Die Einkerbungen scheinen eine Rolle als Hilfsmittel zu "
    "spielen, wenn man auf den Berg klettern will.");
  AddDetail("tat",
    "Ja tatsaechlich.");
  AddDetail("ohren",
    "Lausch doch einfach mal.");
    
  AddSmell(DEFAULT_SMELL,
    "Es riecht hier nach.. nichts! Totale Geruchsneutralitaet!");
  AddSmell( ({"geruchsneutralitaet", "neutralitaet", "geruch"}),
    "Du kannst tatsaechlich keinen spezifischen Geruch in "
    "dieser Neutralitaet feststellen!");
 
  AddSound(DEFAULT_SOUND,
    "Du hoerst den Wind um deine Ohren pfeifen.");
  AddSound("wind",
    "Er fegt ueber die ganze Insel. Ist da nicht noch eine leise Stimme?");
  AddSound("insel",
    "Der Wind fegt ueber die ganze Insel!");
  AddSound("stimme",
    "Die Stimme spricht einige mystische Worte..");
  AddSound("worte",
    "Vielleicht solltest Du einmal den Worten lauschen?");
  AddSound( ({ "worten" }), #'worte );
    
  AddCmd("kletter|klettere&runter|hinunter","cmd_klettern",
    "Wohin willst Du denn klettern?|");
  AddCmd("grab|grabe&in&sand|boden","cmd_graben",
    "Willst Du in etwas graben?|Willst Du etwa im Sand graben?");
  AddCmd("leg|lege|lieg|liege&auf|in&sand", "cmd_sand",
         "In was moechtest Du Dich legen?|"
         "In den Sand?");
  
  AddExit("westen",                    ROOM "berg3");
  /*
  AddExit( "npclagerraum", ([
              EX_DEST:  ROOM "npcraum",    
              EX_TESTFUNC: #'nurnpcs
                                 ]));
  */
  AddSpecialExit("npclagerraum", #'nurnpcs);


  SetProp(P_HIDE_EXITS, ({"npclagerraum"}) );

  AddItem( NPC  "sandwurm", REFRESH_REMOVE);
  AddItem( NPC  "sandwurm", REFRESH_REMOVE);
  AddItem( NPC  "geist",    REFRESH_NONE); //Nicht killbar.
}
  
int cmd_klettern(string str)
{
  write(BS(
    "Stoehnend machst Du Dich wieder an den Abstieg. Du kletterst ueber den "
    "Rand des Plateaus und tastest mit Deinen Fuessen nach den Einkerbungen. "
    "So kletterst Du langsam aber behutsam den Berg wieder hinunter. "
    "Aber ploetzlich verlierst Du den Halt mit der einen Hand und Deine andere "
    "Hand kann Dich trotz Deiner Staerke nicht mehr halten. Du faellst hinab! "
    "WUMMS!!! Langsam blinzelst Du mit den Augen und ueberlegst erst ein mal, "
    "wer Du bist, was Du bist und was Du hier ueberhaupt tust. Langsam erinnerst "
    "Du Dich daran, dass Du auf dieser Insel gelandet bist, von der Du gerne "
    "wegkommen wuerdest. Du stehst also wieder auf, um eine Loesung zu finden. "
    "Erst beim Aufstehen bemerkst Du die starken Kopfschmerzen, die Du dir bei "
    "deiner Bruchlandung zugezogen hast. "));
  write("\n\n");
  TP->do_exhaust(150);
  TP->move(ROOM "berg1",M_GO,"den Berg runter","klettert",
    "faellt vom Himmel");
  return 1;
}   



string sonne(string key)
{
  TP->SetProp(P_BLIND, 15);
  write_file(LOG "blind", 
    sprintf("%s, %O erblindet.\n",
    dtime(time()), this_player()));
  VANAMASTER->Msg(TPN+" erblindet in berg2.lpc");
  return BS("Sie scheint extrem grell und verursacht eine wohlige Waerme "
            "hier oben. Ploetzlich siehst Du nur noch bunte "
            "Flecken herumtanzen!");
}

int cmd_graben(string str)
{
  write(BS(
    "Als Du gerade anfangen willst, Deinen kindlichen Luesten freien "
    "Lauf zu lassen und im Sand zu graben, durchfaehrt Dich ein starker "
    "Schmerz und geht Dir durch Mark und Bein. Da Du nicht unbedingt "
    "auf weitere Schmerzen stehst, laesst Du es erstmal bleiben."));
  TP->AddHp(-10);
  VANAMASTER->Msg(TPN+" verliert 10LP beim Graben in berg2.lpc");
  return 1;
}
