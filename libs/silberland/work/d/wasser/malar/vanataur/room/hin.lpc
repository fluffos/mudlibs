inherit "std/room";

#include "../def.h"

#define VANATAUR "/d/wasser/malar/vanataur/room/stra1"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Beiboot." );
  SetProp(P_INT_LONG, 
    "Du sitzt in einem total engen Beiboot, das Du Dir einfach von der "
    "Galeere entwendet hast. Du ruderst mit zwei Rudern durchs Meer "
    "und hoffst auf etwas zu treffen, was Du richtig schoen erforschen "
    "kannst.");    

  SetProp(P_LIGHT,1);
  SetProp(P_NOMAGIC,100);
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_WATER ]) );
  AddCmd(({"unt","untersuche","schau","untersuche","schaue"}), "cmd_schau");
}

varargs string GetExits(object viewer)
{
  return 0;
} 

  
void init()
{
  ::init();
  if(TP && interactive(TP)) 
  VANAMASTER->Msg(TPN+" rudert nun nach Vanataur");
    call_out("rudern", 0, TP, 1);
}

void rudern(object player, int satz)
{
  string s;
  if(!player)                return;
  if(!interactive(player))   return;
  if(ENV(player) != TO)      return;

  switch(satz)
  {
    case 1:
      s = "Du ruderst kraeftig und kommst ganz gut vorwaerts.";
    break;
    case 2:
      s = "Am Horizont erkennst Du langsam einen grauen Punkt, der immer naeher kommt..";
    break;
    case 3:
      s = "Es sind riesige Nebelschwaden, in denen man gar nichts mehr sieht!";
    break;
    case 4:
      s = "Du faehrst mitten in den tiefen Nebel hinein!";
    break;
    case 5:
      s = "Du froestelst herum, weil der kalte Nebel Dein Gesicht streift.";
    break;
    case 6:
      s = "Du siehst nichts, faehrst jedoch einfach immer weiter und weiter.. ";
    break;
    case 7:
      s = "Ploetzlich sind schwarze Umrisse einer Insel erkennbar!";
    break;
    case 8:
      s = "Du faehrst direkt auf diese schwarze Insel zu..";
    break;
    case 9:
      s = "Gerade als Du einen Sandstrand erkennen kannst knirscht es schon unter dem Boot!";
    break;
    case 10:
      s = "Das Boot wird von dem harten Aufprall in einige Stuecke zerrissen, "
          "die direkt vom Meer verschluckt werden!";
    break;
    case 11:
      s = "Du bist bei dem Aufprall zu Boden gefallen und rappelst "
          "Dich jetzt langsam wieder auf und findest Dich an einem dunklen "
          "Strand wieder!";
    break;
    default: 
     TP->move( VANATAUR, M_GO, 
              "an einen dunklen Sandstrand",
              "faehrt mit einem Beiboot",
              "klettert aus einigen Boottruemmern und blickt sich verwundert um");
     TP->do_exhaust(700);
     write_file(LOG "questverlauf", 
       "("+ctime(time())+") "+TPN+" landet auf Vanataur.\n");
     VANAMASTER->Msg(TPN+" landet auf Vanataur->Minus auf MV");
     call_out("quest", 7); //Juni 2004 by Malar
     //write("AUA!! Du stoesst Dich an einer Fackel, die auf dem Boden liegt!\n");
     return;
  }
  s = break_string(s, 78, 1);
  player->Message(s);
  satz = satz + 1;
  call_out("rudern", 6 , player, satz);
}

int cmd_schau(string str)
{
write(BS(
  "Du bist viel zu sehr mit dem Rudern beschaeftigt, als dass Du jetzt "
  "auch noch herumforschen koenntest!"));
return 1;
}

void quest()     //Juni 2004 by Malar - Vielen war nicht klar, dass man die
{                //                     Quest erst beginnen muss
  TP->Message(break_string(
      "Sei willkommen auf Vanataur, "+TPN+"! Auf Vanataur gibt es zur "
      "Zeit eine Menge Probleme. Wenn Du mir und damit auch den "
      "Bluetenwesen zur Hilfe eilen willst, suche mich auf dem Berg "
      "im oestlichen Teil der Insel auf und ich werde Dich ueber alles "
      "informieren." ,78,
      "Der heilige Bluetengeist teilt Dir mit: "),
      MSGFLAG_SOUND);
  VANAMASTER->Msg(TPN+" erfaehrt den Standort des Bluetengeistes");
}