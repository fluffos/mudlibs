//15.12.2003 Archon: infos

inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
    return;

  ::create();    

  SetProp(P_SHORT, "Eine kleine Blueti");
  SetProp(P_LONG, 
    "Diese kleine Blueti scheint eine noch nicht ausgewachsene Vanataurie "
    "zu sein! Die Blaetter an ihrem Kopf spriessen nur ein bisschen hervor "
    "und die Knospe aus der ihr gesamter Rumpf besteht, ist noch ganz klein "
    "und mit einer gruenen Schutzhuelle umgeben. Ansonsten hat auch sie wie "
    "die ausgewachsenen Vanataurien kleine Wurzeln unter der kleinen Knospe, "
    "die eine Art Beine darstellen. ");
  SetProp(P_NAME, "Blueti");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "blueti", "vanataurie", "bluetenwesen", "wesen" }) );
  SetProp(P_NAME_ADJ, ({ "klein" }));
  AddAdjective( ({ "klein", "kleine", "kleines" }) );
  SetProp(P_KILL_NAME, "Eine Blueti");
  create_default_npc( 15 );
  SetProp(P_BODY, 70);
  SetProp(P_SIZE, 90);
  SetProp(P_HANDS, ({" mit kleinen kraeftigen Wurzeln", 140, DT_WHIP}));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Vanataurie");
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_WIMPY, 40);
  SetProp(P_SPELLRATE, 25);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_DIE_MSG, " verschwindet mit letzter Kraft in der Erde und laesst nur "
                     "eine Wurzel zurueck.\n ");
  SetProp(P_CORPSE_FLAGS, COR_NOSETWEIGHT);                    
  SetProp(P_CORPSE, OBJ "wurzel"); 

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0.1,    DT_BLUDGEON    :0.2,    DT_PIERCE     :0.1,
    DT_SQUEEZE    :0.2,    DT_WHIP        :0.1,    DT_RIP        :0.1,
    DT_FIRE       :0.2,    DT_COLD        :0.1,    DT_WATER      :-0.2,    
    DT_AIR        :-0.2,   DT_LIGHTNING   :-0.4,   DT_EXPLOSION  :0, 
    DT_SOUND      :-0.5,   DT_LIGHT       :-0.4,   DT_ELECTRIC   :0,    
    DT_ACID       :0.3,    DT_POISON      :0.3,    DT_TERROR     :0.5,     
    DT_HOLY       :-0.3,   DT_UNHOLY      :0.4,    DT_MAGIC      :0.2]) ); 
  
  SetProp(P_DEFAULT_INFO, "kann leider nichts hoeren.");

  AddDetail("knospe",
    "Sie ist noch mit einer gruenen Schutzhuelle umgeben.");
  AddDetail("schutzhuelle",
    "Durch diese ist die Blueti noch ein bisschen mehr geschuetzt.");
  AddDetail("wurzeln",
    "Als ausgewachsene Vanataurie kann sie damit sicher kraeftige Schlaege austeilen.");
  AddDetail("kopf",
    "Aehnelt ein wenig einer Kokosnuss!");
  AddDetail("rumpf",
    "Der besteht zum groessten Teil aus der Knospe.");
  AddDetail("blaetter",
    "Die gucken nur ein bisschen oben raus.");



  AddSpell(1,500,
    "Die kleine Blueti bekommt ploetzlich leuchtene Wurzeln!\n"
    "Sie erwischt Dich ploetzlich am Hinterkopf!",
    "Die kleine Blueti trifft @WEN mit leuchtenen Wurzeln.\n",
    DT_HOLY,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,140,
    "Die kleine Blueti springt an Dir hoch und zerkratzt Dir das Gesicht!\n",
    "Der kleine Blueti zerkratzt @WEM das Gesicht.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(4,200,
    "Die kleine Blueti peitscht Dich mit ihren Wurzeln!\n",
    "Die kleine Blueti peitscht @WEN mit ihren Wurzeln.\n",
    DT_WHIP, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(3,160,
    "Die kleine Blueti gibt Dir mit ihrer Knospe eine Kopfnuss!\n",
    "Die kleine Blueti gibt @WEN eine Kopfnuss.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  
              
}
     

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "blueti.kills", 
     sprintf( ctime()+": Blueti bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   }
  return 0;
}

void die(int poisondeath)
{
  write_file(LOG "blueti.deaths",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Blueti.\n");
  ::die(poisondeath);
}




