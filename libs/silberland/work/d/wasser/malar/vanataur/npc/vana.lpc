//15.12.2003 Archon: infos 

inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "Eine Vanataurie");
  SetProp(P_LONG,
    "Diese Vanataurie gehoert zu der Rasse der Bluetenwesen. Sie bewohnen "
    "diese sonst so schoene Insel und leben in Ruhe und Frieden. An ihrem "
    "Kopf spriessen 3 grosse Blaetter hervor. Ihr Rumpf besteht aus einer "
    "grossen braunen Knospe, unter der einige lange und knorrige Wurzeln "
    "hervorgucken, die sie wohl als eine Art Beine verwendet. An einem der "
    "Blaetter befindet sich eine hellleuchtene Frucht!");  
  SetProp(P_NAME, "Vanataurie");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "bluetenwesen", "vanataurie", "wesen" }) );
  SetProp(P_KILL_NAME, "Die Macht Vanataurs");
  create_default_npc( 25 );
  SetProp(P_BODY, 120);
  SetProp(P_HANDS, ({" mit knorrigen Wurzeln", 255, DT_WHIP}));
  SetProp(P_ALIGN, 1000);
  SetProp(P_SIZE, 140);
  SetProp(P_RACE, "Bluetenwesen");
  SetProp(P_MAX_HANDS, 10);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 25);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_DIE_MSG, " loest sich in einem grellen Leuchten auf. Zurueck bleibt "
                     "nur die Frucht, die sie am Kopf getragen hatte.\n");
  SetProp(P_CORPSE_FLAGS, COR_NOSETWEIGHT);                    
  SetProp(P_CORPSE, OBJ "frucht"); 
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0.1,    DT_BLUDGEON    :0.1,     DT_PIERCE     :0.1,
    DT_SQUEEZE    :0,      DT_WHIP        :0.2,     DT_RIP        :0.1,
    DT_FIRE       :0.3,    DT_COLD        :0.1,     DT_WATER      :-0.8,    
    DT_AIR        :-0.2,   DT_LIGHTNING   :-0.5,    DT_EXPLOSION  :0.1, 
    DT_SOUND      :-0.8,   DT_LIGHT       :-0.4,    DT_ELECTRIC   :-0.4,    
    DT_ACID       :0.1,    DT_POISON      :0.2,     DT_TERROR     :0.3,     
    DT_HOLY       :-0.4,   DT_UNHOLY      :0.4,     DT_MAGIC      :0.2]) ); 
  
  SetProp(P_DEFAULT_INFO, "kann leider nichts hoeren.");


  AddDetail("knospe",
    "Die Knospe ist der Rumpf.");
  AddDetail("rumpf",
    "Der besteht aus der grossen Knospe.");
  AddDetail("wurzeln",
    "Vanataurien haben lange, knorrige Wurzeln, mit denen sie harte Schlaege "
    "austeilen koennen.");
  AddDetail("kopf",
    "Aehnelt ein wenig einer Kokosnuss!");
  AddDetail("frucht",
    "Die haengt an einem ihrer Blaetter.");
  AddDetail("blaetter",
    "Die spriessen einfach aus dem Kopf.");


AddSpell(1,500,
  "Die Vanataurie bekommt ploetzlich leuchtene Wurzeln!\n"
  "Sie erwischt Dich ploetzlich am Hinterkopf!\n",
  "Die Vanataurie trifft @WEN mit leuchtenen Wurzeln.\n",
  DT_HOLY,([SP_SHOW_DAMAGE:1]) );
AddDefaultSpell(1,220, DS_BLIND,
  "Die Vanataurie wird von der Macht Vanataurs durchflossen!\n"
  "Ein grelles Licht blendet Dich!\n",
  "Der Vanataurie blendet @WEN mit heiliger Macht.\n");
AddSpell(4,250,
  "Die Vanataurie peitscht Dich mit ihren Wurzeln!\n",
  "Die Vanataurie peitscht @WEN mit ihren Wurzeln.\n",
  DT_WHIP, ([SP_SHOW_DAMAGE:1]) );
AddSpell(3,220,
  "Die Vanataurie gibt Dir mit ihrer Knospe eine Kopfnuss!\n",
  "Die Vanataurie gibt @WEM eine Kopfnuss.\n",
  DT_BLUDGEON,  ([SP_SHOW_DAMAGE:1]) );
}
     
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "vana.kills", 
     sprintf( ctime()+": Vanataurie bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   }
  return 0;
}

void die(int poisondeath)
{
  write_file(LOG "vana.deaths",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Vanataurie.\n");
  ::die(poisondeath);
}



