//15.12.2003 Archon: infos

inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "Eine koenigliche Vanataurie");
  SetProp(P_LONG,
    "Diese Vanataurie ist sicherlich eine Koenigin! An ihrem Kopf "
    "spriessen viel mehr grosse Blaetter als bei den anderen hervor. "
    "Ihr Rumpf besteht aus einer riesigen und sicherlich harten braunen "
    "Knospe, unter der sehr viele lange und knorrige Wurzeln hervorgucken, "
    "die sie wohl als eine Art Beine verwendet. Unterhalb der Blaetter "
    "befindet sich ausserdem eine wunderschoene Bluete!");  
  SetProp(P_NAME, "Vanataurie");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "bluetenwesen", "vanataurie", "koenigin", "wesen" }) );
  SetProp(P_NAME_ADJ, ({ "koeniglich" }));
  AddAdjective( ({ "koeniglich", "koenigliche", "koenigliches" }) );
  SetProp(P_KILL_NAME, "Die regierende Macht Vanataurs");
  create_default_npc( 40 );
  SetProp(P_BODY, 190);
  SetProp(P_HANDS, ({" mit koeniglichen Wurzeln", 380, DT_WHIP}));
  SetProp(P_ALIGN, 1000);
  SetProp(P_SIZE, 170);
  SetProp(P_HEAL, 0);
  SetProp(P_MAX_HANDS, 13+random(6));
  SetProp(P_NOMAGIC, 20);
  SetProp(P_RACE, "Bluetenwesen");
  SetProp(P_SPELLRATE, 60);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_DIE_MSG, " verschwindet in einem grellen Leuchten.\n");
  SetProp(P_NOCORPSE, 1); 

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0.1,    DT_BLUDGEON    :0.2,      DT_PIERCE     :0.1,
    DT_SQUEEZE    :0,      DT_WHIP        :0.2,      DT_RIP        :0.1,
    DT_FIRE       :0.4,    DT_COLD        :0.1,      DT_WATER      :-0.8,    
    DT_AIR        :-0.2,   DT_LIGHTNING   :-0.5,     DT_EXPLOSION  :0.1, 
    DT_SOUND      :-0.8,   DT_LIGHT       :-0.4,     DT_ELECTRIC   :-0.4,    
    DT_ACID       :0.2,    DT_POISON      :0.3,      DT_TERROR     :0.5,     
    DT_HOLY       :-0.4,   DT_UNHOLY      :0.5,      DT_MAGIC      :0.3]) ); 
  
  SetProp(P_DEFAULT_INFO, "kann leider nichts hoeren.");


  AddDetail("knospe",
    "Die Knospe ist der Rumpf.");
  AddDetail("rumpf",
    "Der besteht aus einer riesigen starken Knospe.");
  AddDetail("wurzeln",
    "Diese Koenigin hat sehr viele Wurzeln, mit denen sie sicherlich starke "
    "Schlaege austeilen kann!");
  AddDetail("kopf",
    "Aehnelt ein wenig einer Kokosnuss!");
  AddDetail("frucht",
    "Die haengt an einem ihrer Blaetter.");
  AddDetail("blaetter",
    "Die spriessen einfach aus dem Kopf.");
  AddDetail("bluete",
    "Sie ist wahnsinnig schoen und faengt deinen Blick voellig auf durch "
    "ihre strahlend rote Farbe. ");

AddSpell(1,530,
  "Die Koenigin bekommt ploetzlich leuchtene Wurzeln!\n"
  "Sie erwischt Dich ploetzlich hart am Hinterkopf!\n",
  "Die Koenigin trifft @WEN mit leuchtenen Wurzeln.\n",
  DT_HOLY,([SP_SHOW_DAMAGE:1]) );
AddSpell(2,320,
  "Die Koenigin wird von der Macht Vanataurs durchflossen!\n"
  "Ein grelles Licht blendet Dich!\n",
  "Der Koenigin blendet @WEN mit heiliger Macht.\n",
  DT_LIGHT, ([SP_SHOW_DAMAGE:1]) );
AddSpell(4,270,
  "Die Koenigin peitscht Dich mit ihren Wurzeln!\n",
  "Die Koenigin peitscht @WEN mit ihren Wurzeln.\n",
  DT_WHIP, ([SP_SHOW_DAMAGE:1]) );
AddSpell(3,320,
  "Die Koenigin gibt Dir mit ihrer Knospe eine extrem harte Kopfnuss!\n",
  "Die Koenigin gibt @WEM eine Kopfnuss.\n",
  DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

}
     

void Attack(object enemy)
{
  if (random(100)<20) 
  {
    tell_room(environment(TO),BS(
      "Die Koenigin laesst Nektar aus ihrer groessten Bluete direkt in "
      "ihren Mund tropfen. Sofort scheint der Nektar eine heilende "
      "Wirkung zu haben und die Koenigin sieht ein wenig fitter aus!"));
    TO->AddHp(10+random(35)); //AddHP -> AddHp -+- Danke an Feyaria!
  }
  ::Attack(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "queen.kills", 
     sprintf( ctime()+": Koenigin bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   }
  return 0;
}

void die(int poisondeath)
{
  write_file(LOG "queen.deaths",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Koenigin.\n");
  ::die(poisondeath);
}



