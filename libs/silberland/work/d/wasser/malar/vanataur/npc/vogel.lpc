//15.12.2003 Archon: infos

inherit "std/mnpc";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "Ein Donnervogel");
  SetProp(P_LONG, 
    "Vor Dir liegt ein gewaltiger Donnervogel. Er scheint sich von "
    "einigen Strapazen erholen zu muessen. Auch wenn er sich gerade "
    "auszuruhen scheint, sollte man ihn nicht unterschaetzen, denn "
    "mit seinen kraeftigen Klauen sieht er sehr gefaehrlich aus! Er "
    "strahlt ein seltsames Leuchten aus.");
  SetProp(P_NAME, "Donnervogel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "vogel", "donnervogel", "monster" }) );
  SetProp(P_NAME_ADJ, ({ "gewaltig" }));
  AddAdjective( ({ "gewaltig", "gewaltige", "gewaltiges","gewaltiger" }) );
  SetProp(P_KILL_NAME, "Ein gewaltiger Donnervogel");
  create_default_npc( 30 );
  SetProp(P_BODY, 100);
  SetProp(P_INFO, "Mit seinen Augen scheint etwas nicht ganz normal zu sein.\n");
  SetProp(P_HANDS, ({" mit seinen kraeftigen Klauen", 298, DT_RIP}));
  SetProp(P_ALIGN, 400);
  SetProp(P_LIGHT, 1);
  SetProp(P_RACE, "Vogel");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_SPELLRATE, 25);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0.1,    DT_BLUDGEON    :0.1,    DT_PIERCE     :0.1,
    DT_SQUEEZE    :0,      DT_WHIP        :0.2,    DT_RIP        :0.1,
    DT_FIRE       :0.1,    DT_COLD        :0,      DT_WATER      :0.3,    
    DT_AIR        :-0.2,   DT_LIGHTNING   :-0.1,   DT_EXPLOSION  :-0-1, 
    DT_SOUND      :0,      DT_LIGHT       :-0.1,   DT_ELECTRIC   :-1.0,    
    DT_ACID       :0.1,    DT_POISON      :0.1,    DT_TERROR     :0.3,     
    DT_HOLY       :-0.2,   DT_UNHOLY      :0.3,    DT_MAGIC      :0.1]) ); 
  
  SetProp(P_DEFAULT_INFO, "wuerdigt Dich keines Blickes.");

  AddDetail("klauen",
    "Die sehen sehr gefaehrlich aus!");
  AddDetail("leuchten",
    "Es erleuchtet das gesamte Gehege.");

  AddSpell(1,500,
    "Der Donnervogel schaut Dir kurz in die Augen.\nDu bist hypnotisiert!!\n",
    "Der Donnervogel schaut @WEM kurz in die Augen.\n",
    DT_MIND, "para", ([SP_SHOW_DAMAGE:1]) );
  AddSpell(3,230,
    "Der Donnervogel zerquetscht Dich mit einem Fluegel!\nDu taumelst umher.\n",
    "Der Donnervogel zerquetscht @WEM mit einem Fluegel.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(4,300,
    "Der Donnervogel gibt einen markerschuetternen Urschrei von sich.\n",
    "Der Donnervogel gibt einen markerschuetternen Urschrei von sich.\n",
    DT_SOUND, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,500,
    "Die Fluegel des Donnervogels fangen an zu leuchten!\nDu wirst elekrisiert!\n",
    "Der Donnervogel beruehrt @WEN mit leuchtenen Fluegeln.\n",
    DT_ELECTRIC, ([SP_SHOW_DAMAGE:1]) );

              
}
     
void para(object enemy, int damage, mixed dam_type) 
 {
   enemy->SetProp(P_PARALYZED, 3+random(2));
 }
     


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "vogel.kills", 
     sprintf( ctime()+": Donnervogel bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   }
  return 0;
}

void die(int poisondeath)
{
  write_file(LOG "vogel.deaths", 
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Donnervogel.\n");
  ::die(poisondeath);
}