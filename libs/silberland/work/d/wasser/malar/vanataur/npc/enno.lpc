inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    
  
  SetProp(P_SHORT, "Enno");
  SetProp(P_LONG, 
    "Vor Dir steht ein Forscher, der ziemlich verwirrt aussieht. Er traegt "
    "eine verbogene Brille und einen zerschlissenen Forschermantel. "
    "Ueberhaupt sieht er ziemlich ungepflegt aus. Sein Gesicht ist dreckig "
    "und seine Haare triefen nur von Fett. Seine Augen gucken Dich mit einem "
    "verwirrten Blick an. Du erschauderst. Ihm muss irgendetwas widerfahren "
    "sein!");
  SetProp(P_NAME, "Enno");
  SetProp(P_GENDER, MALE);
  AddId( ({"forscher", "enno"}) );
  AddClass(CL_HUMAN);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  create_default_npc(22+random(2));
  SetProp(P_ALIGN,450); 
  SetProp(P_BODY, 120);
  SetProp(P_SIZE, 165);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_HANDS, ({" mit zitternen Haenden", 230, DT_BLUDGEON}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_REJECT,({ REJECT_DROP, "Enno ist viel zu schwach, um " 
                                   "auch noch etwas tragen zu koennen!\n" }) );
  
  SetProp(P_NOATTACK, "ist schon so schlimm genug zugerichtet!\n");
  SetChats(5, ({
    "Enno guckt Dich verwirrt an.\n",
    "Enno sagt: Irgendwer muss mir einfach Hilfe anbieten!\n",
    "Enno denkt   . o O (Hoffentlich ueberleben die Bluetenwesen!)\n",
    "Enno sagt: Waer ich bloss nicht so feige gewesen und haette geholfen!\n",
    "Enno sagt: Ich werde meine kleinen Vanataurien vermissen..\n",
    "Enno guckt betruebt zu Boden.\n",
    "Enno denkt   . o 0 (Vanataurs Macht darf nicht in seine Haende fallen!)\n",
    "Enno geht verzweifelt im Kreis herum.\n",
    }));
  
  SetProp(P_LOG_INFO, "/malar/enno.log");
  AddInfo(DEFAULT_INFO,({ 
    "sagt: Ich hab nichts anderes als Vanataurs Rettung im Sinn!\n",
    "weiss nicht, wovon Du sprichst.\n",
    "zuckt mit den Schultern.\n",
    "sagt: Frag mich doch mal was anstaendiges!\n",
    "hat keine Kraft, auf solche unwichtigen Dinge zu antworten.\n" }) );
    
}

