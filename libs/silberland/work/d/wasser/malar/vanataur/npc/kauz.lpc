//15.12.2003 Archon: infos

inherit "std/npc";

#include "/std/npc/spells.lpc"
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "Ein komischer Kauz");
  SetProp(P_LONG,
    "Das ist ja in der Tat ein komischer Kauz! Er hat seltsamerweise vier "
    "Arme, mit denen er sicherlich sehr gut kaempfen kann. Ausserdem siehst "
    "du, dass seine Augen den Blick eines Wahnsinnigen haben! Du kannst ihn "
    "sehr schwer einschaetzen, da Du bei ihm einfach nicht weisst, mit wem "
    "Du es da zu tun hast. Vielleicht war er ja frueher ein mal ein Mensch, "
    "jedoch scheint etwas schlimmes mit ihm passiert zu sein, dass er zu "
    "einem solch seltsamen Monster mutiert ist!");
  SetProp(P_NAME, "Kauz");
  SetProp(P_GENDER, MALE);
  SetProp(P_KILL_MSG,"Ich kann eben mehr als du!");
  AddId("kauz");
  AddClass(CL_HUMAN);
  SetProp(P_NAME_ADJ, ({ "komisch" }));
  AddAdjective( ({ "komisch", "komischer", "komisches", "komischen" }) );
  SetProp(P_KILL_NAME, "Ein komischer Kauz");
  create_default_npc( 15 );
  SetProp(P_INFO, "Er beherrscht geheime Kampfkuenste!");
  SetProp(P_BODY, 150);
  SetProp(P_HANDS, ({" mit seinen vier kauzigen Haenden", 300}));
  SetProp(P_ALIGN, 600);
  SetProp(P_RACE, "Mensch");
  SetProp(P_MAX_HANDS, 4); 
  SetProp(P_SPELLRATE, 15);
  SetProp(P_DEFAULT_INFO, "scheint dich komplett zu ignorieren.\n");
  
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.3,     DT_BLUDGEON    :-0.3,      DT_PIERCE     :-0.2,
    DT_SQUEEZE    :-0.3,     DT_WHIP        :0.2,       DT_RIP        :-0.2,
    DT_FIRE       :0.1,      DT_COLD        :0.1,       DT_WATER      :0.2,    
    DT_AIR        :0,        DT_LIGHTNING   :0.1,       DT_EXPLOSION  :0, 
    DT_SOUND      :0.1,      DT_LIGHT       :0.1,       DT_ELECTRIC   :0,    
    DT_ACID       :0.2,      DT_POISON      :0.2,       DT_TERROR     :0.3,     
    DT_HOLY       :-0.2,     DT_UNHOLY      :0.4,       DT_MAGIC      :0.3]) );        

  AddDefaultSpell(1, 60, DS_DISARM, 
    "Der komische Kauz schlaegt Dir geschickt die Waffe aus der Hand!\n",
    "Der Kauz schlaegt @WEM die Waffe aus der Hand!\n" );

  CLONEME(ARMOUR "hose");
  CLONEME(ARMOUR "stiefel");
  command("trage alles");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "kauz.kills", 
     sprintf( ctime()+": Kauz bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   }
  return 0;
}

void die(int poisondeath)
{
  write_file(LOG "kauz.deaths",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Kauz.\n");
  ::die(poisondeath);
}


