//15.12.2003 Archon: infos

inherit "std/mnpc";

#include "../def.h"
#include "/std/npc/spells.lpc"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "Ein Sandwurm");
  SetProp(P_LONG, 
    "Dieser kleine Sandwurm schlaengelt sich wie ein paar andere Wuemer "
    "auch durch den feinen Sand. Der Sandwurm unterscheidet sich von "
    "einem normalen Wurm nur dadurch, dass er um einiges groesser ist. "
    "Ausserdem hat er aussergewoehnlich lange Zaehne, bei denen einem "
    "das Lachen vergehen kann.");
  SetProp(P_NAME, "Sandwurm");
  SetProp(P_GENDER, MALE);
  AddId( ({ "wurm", "sandwurm" }) );
  SetProp(P_KILL_NAME, "Ein Sandwurm");
  create_default_npc( 8 );
  SetProp(P_BODY, 20);
  SetProp(P_INFO, "Seine Zaehne scheinen echt gefaehrlich zu sein!\n");
  SetProp(P_HANDS, ({" mit seinen langen Zaehnen", 50, DT_PIERCE}));
  SetProp(P_ALIGN, 100);
  SetProp(P_SIZE, 25);
  SetProp(P_RACE, "Sandwurm");
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_MSGIN, "schiesst aus dem Boden");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "schiesst aus dem Boden");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_MNPC_AREA, ({ ROOM "berg2", ROOM "npcraum"}) );
  SetProp(P_MNPC_WAIT, ({ random(30)+20, 40, 40 }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "berg2" );
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS + MOV_OUTDOORS + 
                        MOV_MOVES + MOV_INFIGHT + MOV_INDOORS + MOV_MAYLOAD + MOV_CMDS );
  SetProp(P_MNPC_CMDS,
      ({ random(9),"npclagerraum", random(11),"berg",  }) );
  SetProp(P_SPELLRATE, 40);
  SetAttackChats( 4, ({
  	"Der Sandwurm windet sich hilflos im Sand.\n",
  	"Der Sandwurm versucht sich aufzubaeumen.\n",}) );
  SetChats( random(3)+1, ({
    "Ein Sandwurm schlaengelt ein bisschen rum.\n"}) ); 	
  CLONEME(OBJ "zahn");

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0.0,     DT_BLUDGEON    :0.1,     DT_PIERCE     :0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :0.1,     DT_RIP        :0.1,
    DT_FIRE       :0.2,     DT_COLD        :0.1,     DT_WATER      :-0.1,    
    DT_AIR        :0.2,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0.2, 
    DT_SOUND      :-0.4,    DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0.3,     DT_POISON      :0.1,     DT_TERROR     :0.3,     
    DT_HOLY       :0.1,     DT_UNHOLY      :0.2,     DT_MAGIC      :0.3]) ); 
  
  SetProp(P_DEFAULT_INFO, "kann doch gar nichts hoeren!");

  AddDefaultSpell(1, 250, DS_POISON,
         "Der Sandwurm beisst Dich!\nDu schreist vor Schmerz.\n",
         "Der Sandwurm beisst zu.\n" );

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "wurm.kills", 
     sprintf( ctime()+": SANDWURM bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   }
  return 0;
}

void die(int poisondeath)
{
  write_file(LOG "wurm.deaths",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Sandwurm.\n");
  ::die(poisondeath);
}




