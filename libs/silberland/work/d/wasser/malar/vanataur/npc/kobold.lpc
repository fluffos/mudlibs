//15.12.2003 Archon: infos

inherit "std/npc";

#include "../def.h"

//ARCHON: void fehlt!
create()
{
  if (!is_clone(this_object())) return;

  ::create();    
  
  SetProp(P_RACE, "Kobold");
  SetProp(P_SHORT, "Ein dreckiger Hoehlenkobold");
  SetProp(P_LONG, 
    "Dieser dreckige Hoehlenkobold sieht einfach abscheulich aus! Er ist ganz klein, hat "
    "pechschwarze Haare und hat am gesamten Koerper seltsame braune Flecken. Ausserdem hat "
    "er noch extrem scharfe Krallen an den Haenden sowie an den Fuessen. Unterschaetze ihn "
    "daher nicht, denn er kann vielleicht ein starker Gegner sein.");
  SetProp(P_NAME, "Hoehlenkobold");
  SetProp(P_GENDER, MALE);
  AddId("kobold", "hoehlenkobold");
  create_default_npc(12);
  SetProp(P_ALIGN, -250); 
  SetProp(P_BODY, 80);
  SetProp(P_SIZE, 90+random(35));
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", 200, DT_RIP}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_VULNERABILITY, ({ DT_TERROR }));
  SetProp(P_SPELLRATE, 10);
  
  AddSpell(1,60, 
     "Der Hoehlenkobold erwischt dich mit seinen scharfen Krallen.\n",
     "Der Hoehlenkobold erwischt @WEN mit seinen scharfen Krallen.\n" , DT_RIP);

  SetChats(20, ({
    "Der Kobold scharrt in der Erde herum.\n",
    "Der Kobold prueft die Schaerfe seiner Krallen.\n",
    "Der Kobold gluckst.\n",
    "Der Kobold fragt Dich: Was willst Du von mir?\n",
    "Der Kobold lacht irr.\n",
    "Der Kobold sagt: Die Hoehle gehoert mir!\n",
    "Der Kobold kratzt sich seinen haesslichen Ruecken.\n",
    "Der Kobold wirft Erde nach Dir.\n" }) );

  SetAttackChats(30, ({
    "Der Kobold tritt Dir in den Hintern!\n",
    "Der Kobold sagt: Mich wirst Du nie besiegen koennen!\n",
    "Der Kobold sagt: Das war ein grosser Fehler!\n",
    "Der Kobold beisst Dich mit seinen gelben Zaehnen in den Arm.\n" }) );

  SetProp(P_DIE_MSG, " verschwindet mit letzter Kraft in der Erde.\n" );
  SetProp(P_NOCORPSE, 1 );                                     
  SetProp(P_DEFAULT_INFO, "sagt: Was willst Du ueberhaupt hier?\n");
}

