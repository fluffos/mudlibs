    "Ploetzlich kommt "+TPN+" mit dem Fuss gegen eine der Kerzen, so dass "
    "sich das fluessige Wachs ueber den Kristall ergiesst!!!"),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw13", 8);
  return;
}

void beschw13()
{
  ENV(TP)->Message(BS(
    "Der gleissend helle Kristall scheint sich mit dem fluessigen Wachs "
    "zu verbinden! Die Beschwoerung ist wohl voellig misslungen! Man "
    "kann nur hoffen, dass der Blutengeist diesen .. abrupten Abbruch "
    "der Beschwoerung nicht mitbekommen hat!!"),
    MSGFLAG_VISUAL);
  call_out("beschw14", 7);
  return;
}

void beschw14()
{
  ENV(TP)->Message(break_string("Du hast mich leider schwer enttaeuscht, " 
                                +TPN+"!",78, "Der heilige Bluetengeist sagt: "),
                                MSGFLAG_SOUND);
  call_out("beschw15", 6);
  return;
}

void beschw15()
{
  write(BS(
    "Du sagst: Hm.. Was ist eigentlich mit dem Kristall passiert?"));
  ENV(TP)->Message(break_string("Hm.. Was ist eigentlich mit dem Kristall "
                                "passiert?",78, TPN+" sagt: "), 
                                MSGFLAG_SOUND | MSGFLAG_NO_TP);
  call_out("beschw16", 5);
  return;
}

void beschw16()
{
  object ob;
  write(BS(
    "Du nimmst den verschmolzenen Kristall an Dich."));
  ENV(TP)->Message(BS(
    TPN+" nimmt den verschmolzenen Kristall an sich."),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  //__ALLE__ Items wie Heilobjekte, questrelevante Dinge wie Blut oder die Kerzen
  //werden entfernt: 
  while(ob=present("VANAOBJ", TP))
  ob->remove(1);
  write_file(LOG "questverlauf", 
    "("+ctime(time())+") "+TPN+" verliert alle VANAOBJekte.\n");
  VANAMASTER->Msg(TPN+" verliert alle VANAObjekte");
  if(!deep_present("vanataurkristall", TP))
  {
    CLONE(OBJ "belo", TP); //Questbelohnung wird schon mal in den Spieler gepackt
    VANAMASTER->Msg(TPN+" bekommt Questbelohnung");
      write_file(LOG "questverlauf", 
    "("+ctime(time())+") "+TPN+" bekommt Questbelohnung.\n");
  } 

  call_out("beschw17", 5);
  return;
}

void beschw17()
{
  write(BS(
    "Der heilige Bluetengeist schaut Dich sehr erzuernt an und sagt dann:"));
  ENV(TP)->Message(BS(
    "Der heilige Bluetengeist schaut "+TPN+" sehr erzuernt an und sagt "
    "dann :"),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  ENV(TP)->Message(break_string(
    "Du hast den heiligen Kristall entweiht, "+TPN+", dafuer werde ich Dich "
    "von der heiligen Insel Vanataur entfernen muessen!", 78,
    "Der heilige Bluetengeist sagt: "), MSGFLAG_SOUND);
  call_out("beschw18", 6);
  return;
}

void beschw18()
{
  write(BS(
    "Der heilige Bluetengeist nimmt Dir alles, was Du auf Vanataur gefunden "
    "hast, weg und macht anschliessend magische Bewegungen, winkt Dir "
    "noch ein mal zu und schnippt dann mit den schwummernden Fingern - "
    "Dir wird auf ein mal so komisch!!"));
  ENV(TP)->Message(BS(
    "Der heilige Bluetengeist macht magische Bewegungen und deutet "
    "anschliessend auf "+TPN+"! "),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw19", 6);
  return;
}

void beschw19()
{

  write(BS(
    "Ploetzlich findest Du Dich wieder mitten auf dem Festland wieder; "
    "Das war vielleicht mal ein Abenteuer!"));
  //Zufallsauswahl, wo der Spieler hinteleportiert wird:
  switch(random(50))
    {
      case  0..10:
        //Nach Midas auf die Hauptstrasse: (Ebene)
        write_file(LOG "questverlauf", 
          "("+ctime(time())+") "+TPN+"->Midas.\n");
        VANAMASTER->Msg(TPN+"->Midas");          
        TP->move("/d/ebene/Midas/room/room_d5", M_TPORT);
        break;
      case 11..19:
        //Zu den ersten Raeumen des Dschungels: (Dschungel)
        write_file(LOG "questverlauf", 
          "("+ctime(time())+") "+TPN+"->Dschungel.\n");
        VANAMASTER->Msg(TPN+"->Dschungel");
        TP->move("/d/dschungel/dante/weg/room/weg2", M_TPORT);
        break;
      case 20..29:
        //Zur Kreuzung vor Sturmfels im Gebirge: (Gebirge)
        write_file(LOG "questverlauf", 
          "("+ctime(time())+") "+TPN+"->Gebirge.\n");
        VANAMASTER->Msg(TPN+"->Gebirge");
        TP->move("/d/gebirge/impulz/paladinweg/room/weg_4", M_TPORT);
        break;
      case 30..39:
        //Hauptplatz in Derlim: (Huegelland)
        write_file(LOG "questverlauf", 
          "("+ctime(time())+") "+TPN+"->Derlim.\n");
        VANAMASTER->Msg(TPN+"->Derlim");
        TP->move("/d/huegelland/raballion/hobbits/room/hauptplatz", M_TPORT);
        break;
      case 40..49:
        //Nordteil des Kristallwaldes: (Kristallwald)
        write_file(LOG "questverlauf", 
          "("+ctime(time())+") "+TPN+"->Kristallwald.\n");
        VANAMASTER->Msg(TPN+"->Kristallwald");
        TP->move("/d/kristallwald/sargola/dorf/room/0714", M_TPORT);
      default: 
        //Falls es irgendwie buggt, geht es nach Midas: (Ebene)
        write_file(LOG "questverlauf", 
          "("+ctime(time())+") "+TPN+"->Midas(BUG!!).\n");
        VANAMASTER->Msg(TPN+"->Midas, BUG!");
        TP->move("/d/ebene/Midas/room/room_d5", M_TPORT);
        break;
    }
  switch(TP->GiveQuest("Vanataurs dunkle Bedrohung")) 
  {
    case  1:
      //keine Fehler:
      write_file(LOG "questverlauf", 
        "("+ctime(time())+") "+TPN+" hat die Quest.\n");
      write_file("/log/quests/vanataur",
        dtime(time())+" "+TPN+" loest die Quest auf Vanataur.\n");
      VANAMASTER->Msg(TPN+" loest die Quest");
      break;
    case -1:
      //Quest ist bei dem Spieler bereits als geloest gesetzt.
      TP->Message(BS("Das wahr wohl wieder nichts!"));
      VANAMASTER->Msg(TPN+" hatte die Quest bereits");
      break;
    case -2:
      //Eine Quest mit dem Namen 'questname' ist im Questmaster nicht angemeldet
      write_file(LOG "questbugs",
        "("+ctime(time())+") "+TPN+" bekommt keine Quest.(-2)\n");
      VANAMASTER->Msg(TPN+" bekommt keine Quest(-2)");
      TP->Message(BS(
        "Ein Fehler ist beim Vergeben der Quest aufgetreten! Bitte SOFORT "
        "an einen Magier wenden!!"));
      break;
    case -3:
      //Unbefugter Zugriff. Es haben nur der questvergebende Raum
      //    und Erzmagier Zugriff auf diese Funktion.
      write_file(LOG "questbugs",
        "("+ctime(time())+") "+TPN+" bekommt keine Quest.(-3)\n");
      VANAMASTER->Msg(TPN+" bekommt keine Quest(-3)");
      TP->Message(BS(
        "Ein Fehler ist beim Vergeben der Quest aufgetreten! Bitte SOFORT "
        "an einen Magier wenden!!"));
      break;
    case -4:
      //Zugriff auf eine deaktivierte Quest.
      write_file(LOG "questbugs",
        "("+ctime(time())+") "+TPN+" bekommt keine Quest.(-4)\n"); 
      VANAMASTER->Msg(TPN+" bekommt keine Quest(-4)");
      TP->Message(BS(
        "Ein Fehler ist beim Vergeben der Quest aufgetreten! Bitte SOFORT "
        "an einen Magier wenden!!"));     
      break;
    default:
       //unbekanter Fehler!
      write_file(LOG "questbugs",
        "("+ctime(time())+") "+TPN+" bekommt keine Quest. Unbekanter Bug!\n");
      VANAMASTER->Msg(TPN+" bekommt keine Quest. Unbekanner Bug");
      TP->Message(BS(
        "Ein Fehler ist beim Vergeben der Quest aufgetreten! Bitte SOFORT "
        "an einen Magier wenden!!"));
      break;
   }
      

}
	
int hat_quest(string str)
{ 
  //Der Spieler hat bereits die Quest und wird nach Midas getranst:
  if (TP->QueryQuest("Vanataurs dunkle Bedrohung"))
  {
    write("Der Geist schnippt mit den Haenden und ploetzlich bist Du "
          "ganz woanders!\n\n");
    write_file(LOG "questverlauf", 
      "("+ctime(time())+") "+TPN+"->Midas(hat Quest).\n");
    TP->move("/d/ebene/Midas/room/room_d5", M_TPORT);
    VANAMASTER->Msg(TPN+"->Midas(hat bereits die Quest)");
    return 1;
  }
  //Oder man hat hat die Quest nicht und versucht trotzdem den NPC zum
  //Teleport zu zwingen:
  ENV(TO)->Message(break_string(
    "DU willst, dass ich Dich einfach wegteleportiere!? Versuch erstmal, "
    "uns zu helfen, dann sehen wir weiter..",78,
    "Der heilige Bluetengeist sagt: "),
    MSGFLAG_SOUND);
  return -1;
}

int cmd_aura(string str)
{
  write(BS(
    "Die heilige Aura des Geistes durchflutet Deinen Koerper! Ein wohliges "
    "Waermegefuehl breitet sich in Deinem Koerper aus.."));
  return 1;
}

string NewKristall() {
  object ob;
  
  if (!TP->QueryQuest("Vanataurs dunkle Bedrohung"))
  return "Du willst eine Belohnung abstauben, ohne uns geholfen zu haben?";
  if(ob=present("vanataurkristall", TP)) {ob->remove();}
  call_out("GiveKristall",0, TP);
  return "Ein nagelneuer Kristall. Bitte sehr.";
}

void GiveKristall(object pl) {
  object ob;
  write("Der Bluetengeist gibt Dir einen neuen Kristall.\n");
  tell_room(ENV(TP),BS("Der Bluetengeist gibt "+CAP(getuid(TP))+" einen Kristall.\n"),
           ({TP}));
  CLONE(OBJ "belo", TP);
  return;
}