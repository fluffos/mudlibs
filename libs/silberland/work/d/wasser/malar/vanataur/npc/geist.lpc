    "meint: ");
  AddInfo("stein",
    "An den Straenden liegen doch haufenweise welche rum!",
    "sagt: ");
  AddInfo( ({"strand", "straende", "straenden"}),
    "Besonders im suedwesten liegen sehr viele spitze Steine herum!",
