    "sagt: ");
  AddInfo( ({"klippe", "klippen"}),
    "Die ziehen sich am Strand im Westen hoch.",
    "sagt: ");
  AddInfo( ({"strand", "straende"}),
    "Viele Teile der Insel haben direkt am Meer einen kleinen Strand.",
    "raunt: ");
  AddInfo( ({"meer", "wasser"}),
    "Die gesamte Insel ist vom Meer umfasst.",
    "raunt: ");
  AddInfo("teile",
    "Viele Teil der Insel haben direkt Meer einen kleinen Strand.",
    "raunt: ");
  AddInfo("worte",
    "Die magischen Worte musst Du waehrend der Beschwoerung aussprechen! "
    "Durch sie wird die Magie endgueltig neu aufgeladen und ich kann endlich "
