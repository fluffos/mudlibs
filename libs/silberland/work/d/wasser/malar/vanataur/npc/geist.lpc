    TPN+" atmet noch ein mal tief durch um jetzt mit der Beschwoerung der "
        "magischen Kraft von Vanataur zu beginnen!"),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw6", 6);
  return;
}

void beschw6()
{
  object ob6;
