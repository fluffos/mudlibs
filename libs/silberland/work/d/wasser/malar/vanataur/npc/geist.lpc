// 22.01.2004: Quest-NPC fuer die Forscherquest auf Vanataur - Malar

inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "Der heilige Bluetengeist");
  SetProp(P_LONG,
    "Dieser heilige Bluetengeist strahlt eine starke Heiligkeit aus! Er "
    "ist ungefaehr dreieinhalb Meter gross und besteht eigentlich nur aus "
    "einer schwummrigen, blauen Substanz. Sein Gesicht wechselt staendig "
    "die Farbe, was total verwirrend ist! Er sieht leider sehr traurig aus, "
    "denn auch ihm macht sicherlich die Dunkelheit zu schaffen! Der Geist "
    "scheint keineswegs ein normaler Geist zu sein; er scheint vielmehr eine "
    "Art Herr oder Behueter der Insel zu sein.");  
  SetProp(P_NAME, "Bluetengeist");
  SetProp(P_GENDER, MALE);
  AddId(({"bluetengeist","geist","herr","bluetengeistherr", "behueter"}) );
  SetProp(P_NAME_ADJ, ({ "heilig" }));
  AddAdjective( ({ "heilig", "heiliger", "heiliges" }) );
  
  //NPC dient nur zu Questzwecken, daher nicht killbar, sondern nur mit 
  //Informationen bestueckt!
  create_default_npc(45);
  set_living_name("bluetengeist");
  SetProp(P_BODY, 70);
  SetProp(P_ALIGN, 1000);            //Sehr sehr heilig.
  SetProp(P_SIZE, 340+random(20));   //Ca 3,5 Meter hoch
  SetProp(P_MAX_HANDS,0);            //Keine Haende
  SetProp(P_RACE, "Geist");          //Rasse: Geist
  SetProp(P_DIE_MSG, " verschwindet mit einem leisen *POFF*!\n");
  SetProp(P_NOCORPSE, 1);            //Falls gezappt wird -> keine Leiche
  SetProp(P_NOATTACK, "wird kurz unsichtbar und zwingt Dich dadurch "
                      "automatisch zur Aufgabe! Ein Kampf mit ihm "
                      "wuerde sicherlich eh toedlich enden!!");


  AddDetail("heiligkeit",
    "Er ist die Heiligkeit in Person. Du weisst nicht woher Du es weisst, "
    "jedoch strahlt er eine gewisse heilige Aura aus!");
  AddDetail("aura",
    "Du kannst sie foermlich spueren!");
  AddDetail("substanz",
    "Die blaueliche Substanz ist total schwummrig, daher kann man kaum "
    "etwas erkennen. Wenn die Substanz nicht so blau waer, kaemest Du "
    "Dir sicherlich betrunken vor, einfach nur alles so schwummrig zu sehen.");
  AddDetail("kopf",
    "Das Gesicht ist besonders verwirrend!");
  AddDetail("gesicht",
    "Zum einen aendert es staendig die Farbe und zum anderen hat es ganz "
    "traurige Augen. Was dem Geist wohl widerfahren ist?");
  AddDetail("augen",
    "Der Bluetengeist hat sehr traurige Augen. Am besten fragst Du "
    "ihn einfach mal, was ihm auf dem Herzen liegt!");
  AddDetail("farbe",
    "Mal quietschgelb, dann wieder nur ein dunkles Braun und dann schon wieder "
    "direkt ein helles Blau! Das ist echt total verwirrend!");
    
    
  //Falls man einen neuen Kristall braucht:
    AddInfo(({"neuem kristall", "neuer kristall"}), "@@NewKristall@@","sagt: ");
  
    
  //Infos um Vanataur, die Aufgabe, die man bewaeltigen muss etc.
  SetProp(P_LOG_INFO, "/malar/bgeist.log");
  
  AddInfo( ({DEFAULT_INFO, "wohlergehen", "sinn"}),
    "Ich habe lediglich das Wohlergehen Vanataurs im Sinn!",
    "meint: ");
  AddInfo("vanataur",
    "Vanataur ist der Name dieser sonst ein mal so schoen gewesenen Insel.",
    "erklaert: ");
  AddInfo("name",
    "Der Name der Insel lautet Vanataur.",
    "erklaert: ");
  AddInfo("insel",
    "Sie war frueher fruchtbar und hell, jedoch ist die Dunkelheit "
    "hereingebrochen und hat nur Uebel ueber uns hergebracht!",
    "sagt traurig: ");
  AddInfo("dunkelheit",
    "Sie kam mit Rumburak, dem verdammten Zauberer!",
    "schluchzt: ");
  AddInfo( ({"zauberer", "rumburak"}),
    "Er kam eines Tages hierher mit seinen Donnervoegeln um die heilige "
    "Macht und Magie Vanataurs an sich zu reissen!",
    "errinert sich: ");
  AddInfo( ({"donnervogel", "vogel", "voegel", "donnervoegel"}),
    "Die Donnervoegel entsprechen zwar einer heiligen Natur, jedoch sind "
    "sie dem dunklen Herrscher untertan.",
    "erklaert: ");
  AddInfo("natur",
    "Naja von Natur kann man hier auf Vanataur nicht mehr sprechen... "
    "Alles ist verwelkt und abgestorben...",
    "schluchzt: ");
  AddInfo("magie",
    "Die Magie Vanataurs ist sehr sehr maechtig! Schon allein die kleineren "
    "Bluetenwesen strahlen eine sehr starke Magie ab! Wer die gesamte "
    "Kontrolle ueber die Insel erlangt, wird eine extrem starke Macht "
    "besitzen und auf diese Weise viele Lebewesen ins Unheil stuerzen "
    "koennen!",
    "raunt: ");
//  AddInfo( ({"malar", "magier"}),
//    "Dieser maechtige Magier hat vor Urgezeiten mich und damit "
//    "auch dieses Insel - Vanataur vom Namen - erschaffen!",
//    "strahlt: ");
  AddInfo("urgezeiten",
    "Das ist sehr lange her!",
    "meint: ");
  AddInfo("macht",
    "Die Magie Vanataurs ist sehr maechtig! Zur Zeit liegt nur noch ein "
    "Teil der Macht in meinen Haenden. Wenn Rumburak jedoch die gesamte "
    "Macht an sich reissen koennte, indem er alle Vanataurien vernichtet, "
    "wuerde er somit die gesamte heilige Macht Vanataurs besitzen und so "
    "ein riesen Unheil anrichten!", 
    "schluchzt: ");
  AddInfo("unheil",
    "Sobald Rumburak alle Vanataurien getoetet hat bzw getoetet hat lassen, "
    "wird ihm die gesamte Macht Vanataurs gehoeren! Das waere einfach "
    "schrecklich, daher muss etwas dagegen unternommen werden. Ich bin leider "
