    "Loesung... ",
    "raunt: ");
  AddInfo("lauschen",
    "Lausche einfach mal ueberall auf der Insel etwas herum!",
    "sagt: ");
  AddInfo("wind",
    "Also dem Wind lauschen kann man sicherlich hier oben am besten. Auch "
    "wenn zur Zeit kaum irgendein Wind weht.",
    "raunt: ");
  AddInfo("wasser",
    "Wenn Du eine Stelle findest, bei der Du im Meer baden kannst, koenntest "
    "Du sicherlich bestens am Wasser lauschen...",
    "raunt: ");
  AddInfo("stelle",
    "Guck mal beim Strand im Westen!",
    "raunt: ");
  AddInfo("westen",
    "Im Westen befindet sich die heilige Staette der Bluetenwesen.",
    "raunt: ");
  AddInfo("staette", 
    "Schau sie Dir mal naeher an!",
    "raunt: ");
  
    
  SUID;  
  //Kommando zum Hilfeanbieten -> Man bekommt das Questobjekt und muss dann
  //anfangen, die noetigen Dinge fuer die Beschwoerung zu finden.
  AddCmd("biet|biete&geist|bluetengeist&hilfe&an", "cmd_hilfe",
         "Wem moechtest Du denn Deine Hilfe anbieten?|"
         "Moechtest Du Deine Hilfe anbieten?|"
         "Biete doch einfach Deine Hilfe an!");
  //Kommando zum Questbeenden:
  AddCmd("beschwoer|beschwoere&magie", "questende",
         "Was willst Du beschwoeren? Die Magie?");
  AddCmd("verlass|verlasse&insel", "hat_quest",
         "Du willst die Insel verlassen?");
  AddCmd("spuer|spuere&aura", "cmd_aura",
         "Du spuerst die Aura des Bluetengeists..");
  

}
     
//Fuer die Reaktionen auf Emotes von Spielern wichtig:
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}



//Reaktionen auf bestimmte Emotes von Seiten der Spieler:
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe) 
  {
    case "fies":
     call_out("react", 0, "runzelt seine Stirn.\n",0);
      break;
    case "aergerlich":
      call_out("react", 0, "sagt: Bitte hilf mir, "+TPN+"!\n", 0);
      break;
    case "traurig":
      call_out("react", 0, "schluchzt: Meiner Insel geht es so schlecht!\n", 0);
      break;
    case "albern":
      call_out("react", 0, "sagt: Bitte alber hier nicht rum sondern "
                           "hilf mir lieber, "+TPN+"!\n");
      break;
    case "neutral":
      call_out("react", 0, "runzelt seine Stirn.\n", 0);
      break;
    case "intim":
      if ( QueryProp(P_GENDER) != TP->QueryProp(P_GENDER) )
         call_out("react", 0, "fluestert Dir zu: Tut mir ja schrecklich "
                              "leid, aber wir Geister sind bei solchen "
                              "Sachen die nicht die besten Partner.\n", 
                  "fluestert "+TP->name(WEM)+" etwas zu.");
      else
         call_out("react", 0, "sagt: Du entsprichst nicht so ganz meinem "
                              "Geschmack, "+TPN+".");
      break;
    case "froh":
      call_out("react", 0, "schaut Dich hoffnungsvoll an.",
               "schaut "+TP->name(WEN)+" hoffnungsvoll an.");
      break;
    case "aengstlich":
      call_out("react", 0, "meint: Ich habe auch Angst vor dem Unheil, dass "
                           "der Insel und mir droht!\n", 0);
      break;
    case "frech":
      call_out("react", 0, "schnaubt: Treib es lieber nicht zu weit, "+TPN+"!",0);
      break;
    case "nett":
      call_out("react", 0, "nickt Dir traurig zu.",
               "nickt "+TP->name(WEM)+" freundlich zu.");
      break;
  }
}



//Fuer die Reaktionen auf Emotes von Spielern wichtig:
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

//"biete geist hilfe an" --> Man bekommt das Questobjekt und muss sich nun
//die einzelnen Utensilien("frag geist nach liste") fuer die Beschwoerung
//der heiligen Magie von Vanataur beschaffen. Finden sich alle auf der Insel.
int cmd_hilfe(string str)
{
	
  if (TP->QueryQuest("Vanataurs dunkle Bedrohung"))
  {
    ENV(TO)->Message(break_string(
      "Ach Du bist es, "+TPN+"! Ich bin Dir nicht mehr boese. Falls Du also "
      "direkt unsere Insel wieder verlassen willst, tippe einfach "
      "'verlasse insel' ein und ich werde versuchen, Dich auf das Festland "
      "zurueck zu teleportieren! Ansonsten kannst Du es natuerlich noch "
      "ein mal gerne probieren, uns zu helfen!",78,"Der heilige Bluetengeist sagt: "),
      MSGFLAG_SOUND);
    return 1;
  }

  if(!present("\nvana_quest",TP)) //Wenn kein Questobj vorhanden ist, eins clonen:
  {  
    CLONE(OBJ "qobj", TP);
    ENV(TO)->Message(break_string("Wohlan, "+TPN+", mach Dich nun "
                                            "auf die Suche nach den noetigen "
                                            "Dingen und komm erst dann wieder, "
                                            "wenn Du alles hast!", 78, 
                                            "Der heilige Bluetengeist sagt: "),
                                            MSGFLAG_SOUND);
     write_file(LOG "questverlauf", 
       "("+ctime(time())+") "+TPN+" beginnt die Quest.\n");
     VANAMASTER->Msg(TPN+" beginnt die Quest");
     return 1;
  }
  //TP hat bereits das Questobj und braucht daher nicht noch ein weiteres:
  ENV(TO)->Message(break_string("Such nur weiter nach den noetigen Dingen, " 
                                  +TPN+"!",78, "Der heilige Bluetengeist sagt: "),
                                  MSGFLAG_SOUND);
  VANAMASTER->Msg(TPN+" versucht erneut die Quest zu beginnen");

  return 1;
}

//Beschwoerung:
int questende(string str)
{
  object ob1, ob2, ob3, ob4, ob5, ob6, ob7;
  ob1=present("\nvana_worte",     TP); //Die magischen Worte,"lausch Worten" in berg2.c
  ob2=present("vanataurkristall", TP); //Mag. Kristall,"greife nach kristall" in hoehle.c
  ob3=present("vana_kerzen",      TP); //5 Kerzen, "grabe in sand" in stra1.c        
  ob4=present("vana_blut",        TP); //Man schneidet sich am Stein von stra2.c
  ob5=present("papierfackel",     TP); //Bastelt man aus einem der Zettel, die
                                       //man auf der Wiese finden kann
  ob6=present("magierkappe",      TP); //Findet man im Raum wi1.c
  //Spezifische Fehlermeldungen, sofern ein relevantes Objekt nicht vorhanden ist:
  if(!ob1)
  {
    write("Du kennst ja noch nicht ein mal die magischen Worte, "
          "welche Du bei der Beschwoerung aussprechen musst!\n");
    return 1;
  }

  if(!ob2)
  {
    write("Du benoetigst noch den magischen Kristall von Vanataur!\n");
    return 1;
  }
  if(!ob3)
  {
    write("Du benoetigst noch fuenf Kerzen!\n");
    return 1;
  }
  if(!ob4)
  {
    write("Du brauchst noch Blut, um es an die Ecken des Pentagramms "
          "zu spritzen!\n");
    return 1;
  }
  if(!ob5)
  {
    write("Du brauchst noch eine Papierfackel, um die Kerzen waehrend "
          "der Beschwoerung entzuenden zu koennen!\n");
    return 1;
  }
  if(!ob6)
  {
    write("Ohne Magierkappe wird diese Beschwoerung keinesfalls magisch!\n");
    return 1;
  }
  //Alle Objekte im Inventar des Spielers, Anfang der Beschwoerung:
  write(BS("Du faengst mit der heiligen Beschwoerung an..."));
  write_file(LOG "questverlauf", 
    "("+ctime(time())+") "+TPN+" beginnt die Beschwoerung.\n");
  VANAMASTER->Msg(TPN+" beginnt die Beschwoerung");
  call_out("beschw1", 2);
  return 1;
}

void beschw1()
{
  write(BS(
    "Du spritzt das Blut in Form eines Pentagramms auf den sandigen "
    "Boden und bist froh endlich das Blut losgeworden zu sein..."));
  ENV(TP)->Message(BS(
    TPN+" spritzt mit einer roten Substanz ein Pentagramm auf den Boden!"),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw2", 10);
  return;
}

void beschw2()
{
  write(BS(
    "Mit einem kleinen Feuerball zuendest Du eine Papierfackel an."));
  TP->AddSp(-5); //Nur damit es noch besser rueberkommt...
  ENV(TP)->Message(BS(
    TPN+" zuendet eine Papierfackel mit einem kleinen Feuerball an."),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw3", 5);
  return;
}

void beschw3()
{
  write(BS(
    "Du haeltst die lodernde Papierfackel an die einzelnen Dochte der fuenf "
    "Kerzen und mit der Zeit fangen diese dann auch endlich Feuer."));
  ENV(TP)->Message(BS(
    TPN+" bringt mit Hilfe der Papierfackel alle fuenf Kerzen zum Brennen!"),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw4", 9);
  return;
}

void beschw4()
{
  write(BS(
    "Du stellst die fuenf Kerzen einzeln sorgsam an die jeweiligen Ecken "
    "des Pentagramms."));
  ENV(TP)->Message(BS(
    TPN+" stellt jeweils eine der fuenf Kerzen an eine der Ecken des "
         "Pentagramms."),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
