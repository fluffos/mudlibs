    "raunt: ");
  AddInfo( ({"silberland", "welt"}),
    "Das ist diese Welt, in der wir leben.",
    "sagt: ");
  AddInfo("gefahr",
    "Vanataur ist in Gefahr!",
    "schluchzt: ");
  AddInfo("leben",
    "Frueher hatten die Vanataurien und ich ein schoenes Leben, doch eines "
