  ob6->DoWear();
  write("Du rueckst Deine Magierkappe noch ein mal richtig.\n");
  ENV(TP)->Message(BS(
    TPN+" rueckt die Magierkappe noch ein mal richtig."),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);

  call_out("beschw7", 8);
  return;
}

void beschw7()
{
  write(BS(
    "Du nimmst den magischen Kristall in Deine Haende. Du spuerst seine "
    "heilige Macht wahrlich in den Haenden!"));
  ENV(TP)->Message(BS(
    TPN+" betrachtet einen magischen Kristall."),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw8", 6);
  return;
}

void beschw8()
{
  write("Du legst den magischen Kristall in die Mitte des Pentagramms.\n");
  ENV(TP)->Message(BS(
    TPN+" legt den Kristall in die Mitte des Pentagramms."),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw9", 6);
  return;
}

void beschw9()
{
  write(BS(
    "Du holst noch mal tief Luft und erinnerst Dich direkt an die "
    "magischen Worte, die Du vernommen hast ..."));
  ENV(TP)->Message(BS(
    TPN+" holt tief Luft und scheint sich sehr zu konzentrieren ..."),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw10", 7);
  return;
}

void beschw10()
{
  write(BS(
    "Du merkst ploetzlich wie ganz von selbst aus Deinem Mund die magischen "
    "Worte stroemen... Du wiederholst sie immer wieder und sagst sie immer "
    "lauter ... Nein Du rufst sie inzwischen sogar!"));
  ENV(TP)->Message(BS(
    "Ploetzlich murmelt "+TPN+" einige seltsame und magische Worte..."),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw11", 10);
  return;
}

void beschw11()
{
  write(BS(
    "Der Kristall faengt noch heller zu leuchten, als er es schon tut! "
    "Er wird immer heller und heller, Du kannst noch so gerade ueberhaupt "
    "etwas sehen. Die Magie scheint tatsaechlich ihre Wirkung zu tun!"));
  ENV(TP)->Message(BS(
    "Der Kristall faengt an sehr stark zu leuchten! Die Magie scheint "
    "ihre Wirkung zu tun!"),
    MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  call_out("beschw12", 9);
  return;
}

void beschw12()
{
  write(BS(
    "DU KOMMST MIT DEINEM FUSS AN EINE DER KERZEN!!! Die Kerze faellt "
    "um und das gesamte fluessige Wachs schwappt auf den leuchtenden "
    "Kristall!!! Wie konnte Dir das bloss passieren!!"));
