// Comments:  Sendet Messages an die Listener, sobald ein Spieler Aktionen
//            auf der Insel durchfuehrt.
//
//=========================================================================

#include "../def.h"

#include <ansi.h>
#include <properties.h>

string *listener;

void create()
{
  if (is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  listener = ({ });
  
  restore_object(ZONE "master/master");
  

  return;
}

void Msg(string s)
{
  object pl;
  int i;

  write_file(LOG "master.log",ctime()+": "+s+".\n");

  i = sizeof(listener);
  while(i--)
  {
    pl = find_player(listener[i]);

    if(pl && interactive(pl) && IS_WIZARD(pl))
    {
      s = break_string(s+".", 78, "Vanataur: ");
      if(pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_PURPLE+s+ANSI_NORMAL;
      tell_object(pl, s);
    }
  }

}

void AddListener(string uid)
{
  if(IS_DOMAINMEMBER(TI))
  {
    if(member(listener, uid) == -1)
    {
      listener += ({ uid });
      save_object(ZONE "master/master");
      Msg("Neuer Listener: "+CAP(uid));
    }
  }
  else
  {
    Msg(CAP(getuid(TI))+" wollte "+uid+" in der Liste der Listener "
        "hinzufuegen");
  }
}

void RemoveListener(string uid)
{
  if(IS_DOMAINMEMBER(TI) || getuid(TI) == uid)
  {
    if(member(listener, uid) != -1)
    {
      listener -= ({uid});
      save_object(ZONE "master/master");
      Msg("Listener entfernt: "+CAP(uid));
    }
  }
  else
  {
    Msg(CAP(getuid(TI))+" wollte "+uid+" aus der Liste der Listener "
        "entfernen");
  }
}

void Nix()
{
  int i;

  DB(sprintf("TP:%O TI:%O\n",TP, TI));

  for(i=0;i<5;i++)
  {
    DB(sprintf("PO(%d):%O\n", i, previous_object(i)));
  }

}



