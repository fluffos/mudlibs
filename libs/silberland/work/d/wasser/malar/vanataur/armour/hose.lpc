inherit "std/armour";      

#include "../def.h"  

void create()
{
  if(!is_clone(this_object())) return;  
                                         

  ::create();

  SetProp(P_SHORT, "Eine dunkelblaue Hose");
  SetProp(P_LONG,
    "Diese dunkelblaue Hose sieht irgendwie ziemlich simpel aus. Trotzdem "
    "scheint etwas komisches an ihr zu sein, schon allein deshalb, weil "
    "sie ein mal einem komischen Kauz gehoert hat!");

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Hose");
  AddId("hose");
  SetProp(P_NAME_ADJ, ({"dunkelblau"}) );

  AddAdjective(({"dunkelblau","dunkelblaue","dunkelblauen","dunkelblauem",
                 "dunkelblaues"}));

  SetProp(P_INFO,
      "Eine ganz simple und primitive dunkelblaue Hose.\n");
  SetProp(P_WEIGHT, 240+(random(40)));
  SetProp(P_VALUE, 678);
  SetProp(P_MATERIAL, ([ MAT_CLOTH : 100 ]) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC,1+(random(4))); 
  SetProp(P_QUALITY_DECAY, 100+random(60));
  SetProp(P_WEAR_TEXT, ({ "Du schluepfst in die dunkelblaue Hose.\n",
                          " schluepft muehselig in eine dunkelblaue Hose.\n" }) );
  SetProp(P_NOSELL, 1); //wird eh nicht von der Insel verschwinden, aber falls doch..
  SetProp(P_NOBUY, 1);  // s.o.
    

}

