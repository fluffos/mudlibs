inherit "std/armour";      

#include "../def.h"  

void create()
{
  if(!is_clone(this_object())) return;  
                                         
  ::create();

  SetProp(P_SHORT, "Ein Paar gelbe Stiefel");
  SetProp(P_LONG,
    "Das sind ja mal wirklich haessliche Stiefel! Kein Wunder, denn nur "
    "dieser komische Kauz hat sie getragen. Vielleicht findest Du ja "
    "trotzdem Verwendung fuer sie.");

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Stiefel");
  AddId("stiefel");
  SetProp(P_NAME_ADJ, ({"gelb"}) );
  AddAdjective(({"gelb","gelbe","gelben","gelbem","gelbes"}));

  SetProp(P_INFO,(BS(
      "Auch wenn die Stiefel total laecherlich aussehen, moegen sie vielleicht "
      "trotzdem den einen oder anderen Schutz bieten.")));
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 730);
  SetProp(P_MATERIAL, ([ MAT_CLOTH : 100 ]) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC,1+(random(4)));
  SetProp(P_QUALITY_DECAY, 100+random(35));
  SetProp(P_WEAR_TEXT, ({ "Du schaffst es mit ein wenig Kraftaufwand in die engen Stiefel zu schluepfen.\n",
                          " schluepft muehselig in scheinbar zu enge Stiefel.\n" }) );
  SetProp(P_NOSELL, 1); //wird eh nicht von der Insel verschwinden, aber falls doch..

}

