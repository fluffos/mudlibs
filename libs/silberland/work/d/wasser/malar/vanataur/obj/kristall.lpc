inherit "std/thing";

#include "../def.h"



void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Der heilige Kristall");  
  SetProp(P_NAME, "Kristall");
  SetProp(P_NAME_ADJ, "heilig");
  AddId(({"kristall","vanataurkristall","wahrzeichen","VANAOBJ","QUESTOBJ","NODESTRUCT"}));
  AddAdjective( ({ "heilig", "heiligen", "heiliges", "heiliger" }) );
  SetProp(P_WEIGHT, 40);
  SetProp(P_GENDER, MALE);
  SetProp(P_LIGHT, 2); //Ist heftig,kann aber nur auf der Insel benutzt werden.
  SetProp(P_NODROP, "Der magische Kristall scheint noch fuer eine magische "
                    "Beschwoerung wichtig zu sein!\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_LONG,
    "Du blickst auf den heiligen Kristall von Vanataur herab. Von ihm gehen "
    "helle Strahlen aus und er erhellt Deine gesamte Umgebung. Er scheint "
    "ein besonderes Wahrzeichen von dieser heiligen Insel, Vanataur von Namen "
    "zu sein und scheint somit auch eine wichtige Funktion zu erfuellen. ");
  AddDetail("strahlen", 
    "Gleissend hell.");
  AddDetail("funktion", 
    "Vielleicht gibt er ja Vanataur dieses gewaltige magische Kraft?");
  AddDetail("kraft",
    "Vielleicht ist ja die magische Kraft von Vanataur so gross, da dieser "
    "Kristall die Magie noch verstaerkt?");
  AddDetail("magie",
    "Die laesst sich bestimmt mit diesem Kristall beeinflussen!");
  SetProp(P_INFO, "Der Kristall laesst sich sicherlich gut fuer ein gewisse "
                  "Beschwoerung einsetzen!");
  SUID;

}

