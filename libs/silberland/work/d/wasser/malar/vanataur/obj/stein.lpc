inherit "std/thing";

#include "../def.h"



void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Ein spitzer Stein");  
  SetProp(P_NAME, "Stein");
  SetProp(P_NAME_ADJ, "spitz");
  AddId(({"stein","steinchen","vana_stein","QUESTOBJ","NODESTRUCT", "VANAOBJ"}));
  AddAdjective( ({ "spitz", "spitzer", "spitzen", "spitzes" }) );
  SetProp(P_WEIGHT, 30);
  SetProp(P_GENDER, MALE);
  SetProp(P_NODROP, "Den Stein benoetigst Du noch!\n");
  SetProp(P_LONG,
    "Hier hast Du ja ein besonderes spitzes Exemplar in der Hand! Der Stein "
    "ist klein und grau und mit lustigen braunen Flecken gepunktet. Ausserdem "
    "ist er besonders scharf, so dass Du schon aufpassen musst, um Dich nicht "
    "an dem Stein zu schneiden! Falls Du jedoch darauf stehen solltest, "
    "koenntest Du Dich sicherlich jederzeit per 'schneide an stein' an dem "
    "Stein schneiden und auf diese Weise an einige Tropfen Blut kommen!");
  AddDetail("flecken", 
    "Die braunen Flecken sehen lustig aus!");
  AddDetail( ({"tropfen", "blut"}),
    "Mit einigen Tropfen Blut kann man sicherlich etwas tolles anfangen!");
  SetProp(P_INFO, "Der Stein ist sehr scharf, so dass man sich leicht "
                  "an ihm schneiden kann!");
  AddCmd("schneid|schneide&an&stein", "cmd_blut",
         "Wenn Du Dich wirklich schneiden willst, tu es per 'schneide an stein!|"
         "Du kannst Dich tatsaechlich an dem Stein schneiden!");
  SUID;

}

int cmd_blut(string str)
{
  write("Du faehrst mit der scharfen Seite des Steins ueber die Haut Deines "
        "Gesichts und ploetzlich stichst Du in die Haut und ein heftiger "
        "Schmerz durchfaehrt Deinen ganzen Koerper! Natuerlich faengst "
        "Du geschickt die Blutstropfen mit der Hand auf, die von Deinem "
        "Gesicht heruntertropfen. Um Deinen Schmerz ein wenig zu verarbeiten "
        "gibst Du dem scharfen Stein einen kraeftigen Tritt, so dass er weit "
        "weg fliegt! Du fasst Dir mit der Hand ins Gesicht und spuerst nun "
        "die kleine aber pochende Wunde, die der Stein hinterlassen hat.\n");
  TP->do_damage(30+random(20));
  ENV(TP)->Message(BS(
    "Ploetzlich schneidet sich "+TPN+" mit einem scharfen Stein das Gesicht "
    "auf und schreit vor Schmerz!"), MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  CLONE(OBJ "blut", TP);
  write_file(LOG "questverlauf", 
    "("+ctime(time())+") "+TPN+" Stein->Blut.\n");
  VANAMASTER->Msg(TPN+" ritzt sich mit dem Stein");
  TO->remove();
  return 1;
}

