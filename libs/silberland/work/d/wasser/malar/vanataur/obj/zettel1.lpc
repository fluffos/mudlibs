//15.12.2003 Archon: infos

inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();


  SetProp(P_NAME, "Zettel");
  SetProp(P_WEIGHT, 30);
  AddId( ({ "zettel", "VANAOBJ", "vanazettel"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, ({ "vergilbt" }));
  SetProp(P_NODROP, "Aus dem Zettel kann man doch noch etwas tolles basteln!\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_SHORT, "Ein vergilbter Zettel");
  SetProp(P_LONG,
    "Ein voellig vergilbter Zettel. An einigen Stellen ist der Zettel "
    "schon etwas zerfleddert, aber sicher kannst Du ihn trotzdem noch "
    "lesen. Ausserdem koennte man aus diesem Zettel sicherlich eine tolle "
    "Papierfackel basteln, indem man einfach den Zettel per 'bastle papierfackel' "
    "zu einer Papierfackel rollt!");

  AddCmd("les|lies|lese&zettel|tagebucheintrag|eintrag", "cmd_lesen",
         "Was willst Du denn nun lesen?");
  AddCmd("bastel|bastle|bastl&fackel|papierfackel", "cmd_papierfackel",
         "Was willst Du basteln? Eine Papierfackel?");
  SUID;
}
 
int cmd_lesen(string str)
{
  if( id(str) ) 
  {
    write("Du kannst folgende Zeilen problemlos entziffern: \n\n");
    write(BS(
      "Liebes Tagebuch! Diese Insel, auf der ich gelandet bin, "
      "ist so gruen und die Natur so unberuehrt! Inschriften und Malereien "
      "auf der Insel zufolge heisst die Insel Vanataur und demnach ihre "
      "Bewohner Vanataurien. Es sind sehr seltsame Bluetenwesen, die alle "
      "einer heiligen Natur entsprechen. Sie haben mich sehr gastfreundlich "
      "aufgenommen, koennen jedoch nicht sprechen. Ich fuehlte mich bis eben "
      "aeusserst wohl hier, aber dann wurde es ploetzlich ganz .. "));
    write("\nDer restliche Teil ist ab hier abgerissen!\n");
    return 1;
  }
  return 0;
}

int cmd_papierfackel(string str)
{
  write(BS(
    "Mit einigen geschickten Handgriffen rollst Du den vergilbten "
    "Zettel zu einer tollen Papierfackel zusammen, die Du sicherlich "
    "noch ein mal gut gebrauchen werden kannst!\n"));
  ENV(TP)->Message(BS(
      TPN+" rollt einen vergilbten Zettel zu einer tollen Papierfackel "
      "zusammen!"), MSGFLAG_VISUAL | MSGFLAG_NO_TP);
    CLONE("/d/ebene/obj/div/papierfackel", TP);
    write_file(LOG "questverlauf", 
      "("+ctime(time())+") "+TPN+" vergilbter Zettel->Papierfackel.\n");
    TO->remove();
    return 1;
}

