/*
  Das Objekt stellt die drei magischen Worte da, die man gehoert hat
  und sich auch gemerkt hat. Damit man beim Questende rausfinden kann,
  ob der Spieler auch wirklich diese Worte erforscht hat, gibt es 
  eben dieses Objekt. Zwar nicht sonderlich komplex oder sonst was;
  reicht aber vollkommen aus.
  Februar 2004 by Malar@SL
*/
inherit "std/thing";

#include "../def.h"


void create() {
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT,0 );
  SetProp(P_LONG, 0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"QUESTOBJ","\nvana_worte", "VANAOBJ"}) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT,   0);
  SetProp(P_VALUE,    0);
  SetProp(P_NOBUY,    1);
  SetProp(P_NOSELL,   1);
  SetProp(P_NODROP,   1);
  SetProp(P_NEVERDROP,1);
  SUID;
}

