inherit "std/thing";

#include "../def.h"



void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

SetProp(P_NAME, "Sandwurmzahn");
SetProp(P_WEIGHT, 10);
AddId( ({ "zahn", "sandwurmzahn", "VANAOBJ" }) );
SetProp(P_GENDER, MALE);
SetProp(P_SHORT, "Ein Sandwurmzahn");
SetProp(P_LONG,
  "In Deiner Hand haelst Du einen giften Sandwurmzahn. Was Du damit alles "
  "anstellen kannst, musst Du wohl noch herausfinden. Der Zahn ist weiss "
  "und mit einer gruenen Kuppe versehen. Er fuehlt sich echt gut in der "
  "Hand an.");
AddDetail("kuppe", 
  "Die Kuppe ist ganz gruen. Giftgruen!");
SetProp(P_INFO, "Der Sandwurmzahn ist giftig!");

}