inherit "std/thing";
inherit "/std/util/pager";

#include "../def.h"

//17.01.2005 (Malar) Idles-Funktion von Feyarias Teddy wird ab sofort verwendet.
//                   Ab sofort nicht mehr autoloadobj. 



void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Ein Kristall");  
  SetProp(P_NAME, "Kristall");
  AddId(({"kristall","vanataurkristall","wahrzeichen"}));
  SetProp(P_WEIGHT, 30);
  SetProp(P_GENDER, MALE);
  SetProp(P_NODROP, "Den Kristall gibts Du nicht mehr weg!\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1); //Magisch! :)
  // SetProp(P_AUTOLOADOBJ, 1); Questbelohnung, daher nicht mehr!
  SetProp(P_LONG,
    "Der Kristall hat sich wahrlich stark veraendert! Er leuchtet jetzt "
    "nicht mehr wie voher sondern ist nur noch matt roetlich gefaerbt. "
    "In seine Mitte ist jetzt ein Loch geschmolzen, dass sehr interessant "
    "aussieht! Vielleicht sollte man sich etwas mehr mit dem Kristall "
    "auseinandersetzen. ");
  AddDetail("loch", 
    "Das Loch sieht magisch aus!");
  AddDetail("mitte",
    "In seine Mitte ist ein Loch geschmolzen worden.");
  SetProp(P_INFO, "Der Kristall scheint noch immer magische Kraefte zu haben! "
                  "Mit dem Befehl 'idles' kannst Du eine Liste der Idler "
                  "und deren Wegmeldungen sehen.");
  
  AddCmd("idles", "idles");

}
