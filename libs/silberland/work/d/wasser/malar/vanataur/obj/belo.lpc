int idles(string str) 
{
  object *spieler;
  int i,x,t1;
  string zeit, weg, nam, output;

  output = "";
  if (str)
    if (find_player(str))
    {
      x=query_idle(find_player(str));
      t1=x; zeit="";
      if (x>=86400)
        { zeit+=x/86400+"d "; x%=86400; }
      if (x<36000) zeit+="0";
      zeit+=x/3600+":"; x%=3600;
      if (x<600) zeit+="0";
      zeit+=x/60+":"; x%=60;
      if (x<10) zeit+="0";
      zeit+=x+"";
      printf("%-15s %s %s %s", CAP(str), "\t: Idlezeit ", zeit, "\n");
       return 1;
      }

  spieler=sort_array(users(), "idle_sort", this_object());
  for (i=0;i<sizeof(spieler);i++) 
  {
     x=query_idle(spieler[i]);
     if( stringp(weg=spieler[i]->QueryProp(P_AWAY)) )
       weg=weg[0..50];
     else
       weg="";
     nam=CAP(spieler[i]->query_real_name());
     if( spieler[i]->QueryProp(P_INVIS) )
     {
       if( !IS_LEARNER(TP) && !TP->QueryProp(P_TESTPLAYER) )
         continue;
       nam="("+nam+")";
     }
     t1=x; zeit="";
     if (x>=86400)
       { zeit+=x/86400+"d "; x%=86400; }
     if (x<36000) zeit+="0";
     zeit+=x/3600+":"; x%=3600;
     if (x<600) zeit+="0";
     zeit+=x/60+":"; x%=60;
     if (x<10) zeit+="0";
     zeit+=x+"";
     if (t1>60 || weg!="")
       output += sprintf("%-13s Idle: %s %s\n", nam, zeit, weg);
  }
  More (output);
  return 1;
}
