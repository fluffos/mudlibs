//15.12.2003 Archon: infos

inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();


  SetProp(P_NAME, "Zettel");
  SetProp(P_WEIGHT, 30);
  AddId( "zettel", "VANAOBJ");
  SetProp(P_NAME_ADJ, ({ "zerknuellt" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_NODROP, "Aus dem Zettel kann man doch noch etwas tolles basteln!\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_SHORT, "Ein zerknuellter Zettel");
  SetProp(P_LONG,
    "Ein voellig zerknuellter Zettel. An einigen Stellen ist der Zettel "
    "schon etwas zerfleddert, aber sicher kannst Du ihn trotzdem noch "
    "lesen. Ausserdem koennte man aus diesem Zettel sicherlich eine tolle "
    "Papierfackel basteln, indem man einfach den Zettel per 'bastle papierfackel' "
    "zu einer Papierfackel rollt!");

  AddCmd("les|lies|lese&zettel|tagebucheintrag|eintrag", "cmd_lesen",
         "Was willst Du denn nun lesen?");
  AddCmd("bastel|bastle|bastl&fackel|papierfackel", "cmd_papierfackel",
         "Was willst Du basteln? Eine Papierfackel?");
  SUID;
}
 
int cmd_lesen(string str) 
{

  if( id(str) ) 
  {
    write("Du kannst folgende Zeilen problemlos entziffern: \n\n");
    write(BS(
      ".. dunkel und eine schier unermessliche Macht schien sich auf dieser "
      "Insel niederzulassen und alles Schoene zu zerstoeren. Es wurde voellig "
      "dunkel und ich bin froh zu wissen, wo ich mein Boot gelassen habe. "
      "Ausserdem fliegen ueber mir die ganze Zeit seltsame Voegel herum, "
      "vor denen ich eine grosse Angst verspuere. Ich fuehle mich schlecht, "
      "diese lieben Bluetenwesen jetzt alleine zu lassen, aber mein Leben "
      "ist mir nun mal lieb, daher werde ich jetzt versuchen, von dieser "
      "Insel zu fliehen und das Festland zu erreichen. Jetzt muss ich mich "
      "auch sputen, denn ich hoere schon so ein seltsames Schnaufen hinter "
      "meinem Ruecken.. AAAAAH!!"));
    return 1;
  }
  return 0;
}

int cmd_papierfackel(string str)
{
  write("Mit einigen geschickten Handgriffen rollst Du den zerknuellten "
        "Zettel zu einer tollen Papierfackel zusammen, die Du sicherlich "
        "noch ein mal gut gebrauchen werden kannst!\n");
  ENV(TP)->Message(BS(
    TPN+" rollt einen zerknuellten Zettel zu einer tollen Papierfackel "
    "zusammen!"), MSGFLAG_VISUAL | MSGFLAG_NO_TP);
  CLONE("/d/ebene/obj/div/papierfackel", TP);
  write_file(LOG "questverlauf", 
       "("+ctime(time())+") "+TPN+" zerknuellter Zettel->Papierfackel.\n");
  TO->remove();
  return 1;

}

