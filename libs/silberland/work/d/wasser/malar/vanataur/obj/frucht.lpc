//15.12.2003 Archon: infos

inherit "std/food";    

#include <properties.h>
#include <food.h>      
#include "../def.h"


void create()
{
  if (!is_clone(this_object())) return;                             

  ::create();

  AddId( ({ "frucht", "VANAOBJ" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({ "rot" }) );
  AddAdjective( ({ "rot", "rote", "rotes", "rotem" }) );
  SetProp(P_NAME, "Frucht");
  SetProp(P_SHORT, "Eine rote Frucht");
  SetProp(P_LONG,
    "Diese rote Frucht wurde wohl von einer Vanataurie abgeworfen! Sie werden "
    "so lange wie moeglich getragen - wenn moeglich bis zu ihrem Tod - damit "
    "sie einen besonders guten Geschmack bekommen und sehr nahrhaft sind. "); 
  AddDetail("vanataurie", 
    "Du hast sie bestimmt kaltbluetig ermordet!");
  AddDetail("tod",
    "Ja sogar bis zu ihrem Tod tragen sie die Frucht.");
  AddDetail("geschmack",
    "Den musst Du wohl selber beurteilen.");
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);    
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:100]));
  SetProp(P_INFO,
      "Du willst sie Dir nur noch einverleiben, so lecker siehst sie aus!");
  SetProp(P_SMELL,
      "Riecht fruchtig.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 50, 25 }),
         F_SOAK    : 10,         
         F_DRINK   : 5,       
         F_ALCOHOL : 0,         
         F_POISON  : 0,         
         F_MSG     : "Du knabberst erst etwas zaghaft an der roten Frucht herum, "
                     "dann bemerkst Du jedoch den wahnsinnig leckeren Geschmack "
                     "und kannst gar nicht mehr genug davon kriegen! Du schmatzt "
                     "und schluerfst auf ein mal die ganze Frucht in Dich hinein!",
         F_MSG_ROOM: "schmatzt und schluerft eine rote Frucht auf einen Schlag "
                     "in sich hinein!",
         F_VERB    : "essen"   
      ]) );     
   SUID;              
}



void reset()
{
  ::reset();
  remove();
}