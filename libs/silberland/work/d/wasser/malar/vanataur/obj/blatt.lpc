//15.12.2003 Archon: infos

inherit "std/thing";

#include "../def.h"



void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();


  SetProp(P_NAME, "Bluetenblatt");
  SetProp(P_WEIGHT, 10);
  AddId( ({ "bluetenblatt", "blatt" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Ein verwelktes Bluetenblatt");
  SetProp(P_LONG, 
    "Du haelst in deinen Haenden ein laengliches Bluetenblatt. "
    "Du kannst noch Reste der gelben Farbe erkennen. "
    "Ausserdem leuchtet es matt.");
  AddDetail( "farbe" , 
    "Man kann erkennen, dass dieses Blatt mal knallgelb war.");
  SetProp(P_INFO, "Das Bluetenblatt ist magischer Natur!");
  SetProp(P_LIGHT, 1);
}
