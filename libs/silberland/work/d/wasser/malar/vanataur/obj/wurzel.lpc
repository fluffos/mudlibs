//15.12.2003 Archon: infos

inherit "std/food";    

#include <properties.h>
#include <food.h>      
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;                             

  ::create();


  AddId( ({ "wurzel", "VANAOBJ" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, ({ "schmackhaft" }) );
  AddAdjective( ({ "schmackhaft", "schmackhafte", "schmackhaftes" }) );
  SetProp(P_NAME, "Wurzel");
  SetProp(P_SHORT, "Eine schmackhafte Wurzel");
  SetProp(P_LONG,
    "Diese schmackhafte Wurzel ist von einer Vanataurie abgeworfen worden! "
    "Sie ist relativ knorrig und sieht eigentlich recht appetitlich aus.");
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 0);    
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:50, MAT_MISC_WOOD:50]));
  SetProp(P_INFO,
      "Schmackhafte Dinge sollte man nicht verkommen lassen!");
  SetProp(P_SMELL,
      "Riecht nach Pflanze.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 20,15 }),
         F_SOAK    : 8,         
         F_DRINK   : 0,       
         F_ALCOHOL : 0,         
         F_POISON  : 0,         
         F_MSG     : "Du knusperst die schmackhafte Wurzel in Dich hinein.",
         F_MSG_ROOM: "knuspert eine schmackhafte Wurzel. Lecker!",
         F_VERB    : "essen"   
      ]) );                   
   SUID;
}


void reset()
{
  ::reset();
  remove();
}