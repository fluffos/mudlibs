/*
  Extrem simples Questobjekt, auf dass jeder Raum hin prueft, der ein Utensil
  fuer die Beschwoerung herausruecken soll. Die gesamte Abschlusssequenz
  sowie die Pruefungen, ob der Spieler alles hat, was er benoetigt, finden
  sich dann in irgendeiner Form im Questnpc(NPC geist.c).
  Januar 2004 by Malar@SL
*/
inherit "std/thing";

#include "../def.h"


void create() {
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT,0 );
  SetProp(P_LONG, 0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"QUESTOBJ","\nvana_quest", "VANAOBJ"}) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT,   0);
  SetProp(P_VALUE,    0);
  SetProp(P_NOBUY,    1);
  SetProp(P_NOSELL,   1);
  SetProp(P_NODROP,   1);
  SetProp(P_NEVERDROP,1);
  SUID;
}
