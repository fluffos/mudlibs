inherit "std/thing";

#include "../def.h"



void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Eine kleine Blutlache");  
  SetProp(P_NAME, "Blutlache");
  SetProp(P_NAME_ADJ, "klein");
  AddId(({"blut","blutlache","vana_blut","tropfen","VANAOBJ","QUESTOBJ","NODESTRUCT"}));
  AddAdjective( ({ "klein", "kleine", "kleines", "kleines" }) );
  SetProp(P_WEIGHT, 12);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NODROP, "Das Blut willst Du nicht einfach vergiessen!\n");
  SetProp(P_LONG,
    "In Deiner Hand schwappt eine rote, kleine Blutlache herum. Manche wuerden "
    "sich ja davor ekeln oder sogar nicht mal hingucken koennen, aber Du "
    "schaffst das locker! Du weisst zwar nicht, warum Du jetzt das Blut "
    "unbedingt aufbewahren und nicht weggiessen willst, aber eine "
    "Anwendungsmoeglichkeit wird sich Dir sicherlich noch offenbaren..");
  AddDetail("anwendungsmoeglichkeit", 
    "War da nicht irgendwas mit einer heiligen Beschwoerung?");
  AddDetail( "beschwoerung",
    "Geh mal auf den Berg.");
  AddDetail("berg",
    "Du wirst ihn schon wiederfinden.");
  SetProp(P_INFO, "Das Blut findet sicher eine Anwendungsmoeglichkeit bei "
                  "einer gewissen Beschwoerung!");
  SUID;


}

