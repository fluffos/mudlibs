//15.12.2003 Archon: infos

inherit "std/food";    

#include <food.h>      
#include "../def.h"


void create()
{
  if (!is_clone(this_object())) return;                             

  ::create();

  AddId( ({ "fisch", "VANAOBJ" }) );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, ({ "roh" }) );
  AddAdjective( ({ "roh", "rohen", "rohes", "rohem" }) );
  SetProp(P_NAME, "Fisch");
  SetProp(P_SHORT, "Ein roher Fisch");
  SetProp(P_LONG,
    "Diesen dicken, rohen Fisch hast Du im Meer gefangen! Auch wenn er nicht "
    "allzu appetitlich aussieht, koennte er Dich auch roh um einiges staerken.");
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 50);    
  SetProp(P_MATERIAL,
   ([ MAT_MISC_FOOD : 100 ]) );     
  SetProp(P_INFO,
      "Fische sollte man eigentlich abkochen, damit sie alle Keime verlieren!");
  SetProp(P_SMELL,
      "Der Fisch riecht nach einem salzigen Meer.");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 50,25 }),
         F_SOAK    : 15,         
         F_DRINK   : 0,       
         F_ALCOHOL : 0,         
         F_POISON  : 0,         
         F_MSG     : "Du verschlingst den ganzen Fisch einfach roh!",
         F_MSG_ROOM: "isst einen rohen Fisch! Du schuettelst Dich.",
         F_VERB    : "essen"   
      ]) );       
  SUID;            
}

void Eating(object pl)
{
  if(random(100) < 10)
    TP->AddPoison(1);
}
void reset()
{
  ::reset();
  remove();
}