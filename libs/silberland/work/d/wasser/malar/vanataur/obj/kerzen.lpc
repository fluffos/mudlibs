inherit "std/thing";

#include "../def.h"



void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Fuenf Kerzen");  
  SetProp(P_NAME, "Fuenf Kerzen");
  AddId(({"kerzen","kerze","vana_kerzen","QUESTOBJ","VANAOBJ","NODESTRUCT"}));
  SetProp(P_WEIGHT, 120);
  SetProp(P_PLURAL, 5);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NODROP, "Die fuenf Kerzen werden noch fuer eine magische "
                    "Beschwoerung benoetigt!\n");
  SetProp(P_LONG,
    "In Deinen Haenden haelst Du genau fuenf weisse Kerzen, die Du sicherlich "
    "noch gut gebrauchen kannst! Anzuenden kann man diese Kerzen nicht so "
    "einfach, da die einzelnen Dochte sehr schwer zu entzuenden aussehen! "
    "Am besten entzuendet man sie wahrscheinlich mit einer Papierfackel.");
  AddDetail("dochte", 
    "Die sind sicherlich schwer zu entzuenden!");
  AddDetail("papierfackel", 
    "Vielleicht findest Du ja irgendwo eine?");
  SetProp(P_INFO, "Die fuenf Kerzen sind fuer eine besondere Beschwoerung "
                  "wichtig!");
  SUID;

}

