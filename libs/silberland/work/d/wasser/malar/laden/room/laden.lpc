//=========================================================================
//
// File:    laden.c
// Created by Malar@SL (Juni 2004)
//
// Project: Hochzeitsmodenladen
// Comments:  Hauptraum, in dem es einiges zu forschen gibt. Ausserdem
//            kann man fuer Geld Hochzeitskleidung fuer Maenner und Frauen
//            erwerben. Auch andere Accessoires wie Straeusse und Ringe
//            werden erhaeltlich sein. Andere Hinterraeume etc folgen..
//=========================================================================

#include "../def.h"
#include <laden.h>

inherit "std/laden";

void create()
{
  ::create();
  
  //Properties:
  SetProp(P_INT_SHORT, "Yurias Hochzeitsmoden");
  SetProp(P_INT_LONG, 
    "Goldenes Licht dringt durch die Fenster in den Raum, "
    "der gut und gerne ein Koenigssaal haette sein koennen, "
    "wenn nicht links und rechts wunderbare Kleidungsstuecke "
    "an unzaehligen Staendern haengen wuerden. Der breite Gang "
    "ist von einem dunkelblauen weichen Teppich bedeckt, "
    "waehrend die Waende cremeweiss sind. An der Decke ist ein "
    "riesiger, im Licht glitzernder Kronleuchter befestigt worden "
    "und an den Waenden haengen Bilder mit goldenen Rahmen. Am Ende "
    "des Ganges befindet sich eine gepflege Theke, in elfenbeinweiss, "
    "deren Oberflaeche aus Buchenholz ist.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );
  
  SetProp(P_SHOPKEEPER_ID, "yuria");
  SetProp(P_SHOPKEEPER_NAME, "Yuria");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "storage" );
  
  
  
  
  //Details:
  AddDetail("bilder",
    "Die Bilder handeln hauptsaechlich von Hochzeiten, bei denen die "
    "Verlobten natuerlich mit Gewaendern von Yuria ausgestattet wurden.");
  AddDetail("verlobten",
    "Erst verlobt man sich und dann heiratet man. Natuerlich mit Kleidern "
    "von Yuria!");
  AddDetail("yuria",
    "Irgendjemand scheint sie kaltbluetig umgebracht zu haben.");
  AddDetail("irgendjemand",
    "Vielleicht warst Du ja dieser Jemand?");
  AddDetail("jemand",
    "Irgendjemand muss es ja gewesen sein.");
  AddDetail(({"hochzeiten", "hochzeit"}),
    "Fuer Vorbereitungen fuer Hochzeiten bist Du hier genau richtig! In "
    "diesem Laden bekommst Du sicher alle noetigen Utensilien, die man "
    "so fuer eine Hochzeit benoetigt.");
  AddDetail("utensilien",
    "Na Ringe, Kleider, Schuhe und selbstverstaendlich einen Brautstrauss.");
  AddDetail("ringe",
    "Ringe spielen bei einer Hochzeit eine wichtige Rolle.");
  AddDetail("rolle",
    "Die Ringe werden bei einer Hochzeit ausgetauscht, so dass die "
    "gegenseitige Liebe symbolisiert wird.");
  AddDetail("schuhe",
    "Willst Du etwa mit stinknormalen Fellstiefeln auf Deiner Hochzeit "
    "erscheinen?");
  AddDetail( ({"fellstiefeln", "fellstiefel", "platz"}),
    "Fellstiefel sind ganz einfach fehl am Platz bei einer Hochzeit.");
  AddDetail( ({"strauss", "brautstrauss"}),
    "Den Brautstrauss kann die Braut nach einer Hochzeit hinter sich werfen, "
    "wer ihn dann faengt, wird als naechstes heiraten.");
  AddDetail("boden",
    "Der gesamte Boden besteht aus einer grossen Anzahl von Marmorplatten, "
    "die perfekt ausgelegt worden sind. Ein dunkelblauer Teppich bedeckt "
    "ausserdem den Boden.");
  AddDetail(({"platten","marmorplatten"}),
    "Die hellen Marmorplatten zeugen von dem grossen Reichtum der Inhaberin "
    "des Geschaefts - sie sehen jedenfalls recht luxurioes aus.");
  AddDetail("inhaberin",
    "Sie scheint wohl tot zu sein.");
  AddDetail( ({"gewaender", "gewaendern"}),
    "Schau Dir am besten mal die Kleidungsstuecke hier an!");
  AddDetail("vorbereitungen",
    "Die Vorbereitungen fuer eine Hochzeit sollten sehr gut organisiert sein: "
    "Es sollte jedenfalls dafuer gesorgt werden, dass Braeutigam und Braut "
    "angemessen gekleidet sind sowie die Ringe parat haben.");
  AddSpecialDetail(({"braeutigam"}), "det_braeutigam");
  AddDetail(({"holz", "buchenholz"}),
    "Es wurde sicherlich Buchenholz aus dem Silberwald verwendet.");
  AddDetail( ({"wald", "silberwald"}),
    "Der Silberwald befindet sich im Nordwesten von Midas, der Hauptstadt "
    "des Silberlandes.");
  AddDetail(({"silberlandes", "silberland", "land", "silberlands", 
              "landes", "lands"}),
    "Dieses Geschaeft ist nur ein ganz kleiner Teil des Silberlands!");
  AddDetail("teil",
    "Tja, in dem befindest Du Dich wohl gerade.");
  AddDetail("nordwesten",
    "Im Nordwesten von Midas befindet sich der Silberwald.");
  AddDetail("hauptstadt",
    "Die Hauptstadt und somit die beruehmteste Stadt vom Silberland ist Midas.");
  AddDetail("midas",
    "Midas befindet sich noerdlich von hier.");
  AddDetail("geschaeft",
    "Du befindest Dich in einem Hochzeitsmodengeschaeft.");
  AddDetail("hochzeitsmodengeschaeft",
    "Das Geschaeft befindet sich im Besitz von Yuria.");
  AddDetail("besitz",
    "Das Geschaeft befindet sich im Besitz von Yuria.");
  AddDetail("licht",
    "Das Licht strahlt durch die Fenster in das Geschaeft und erhellt "
    "den ganzen Raum mit einem richtig schoenen Leuchten. Alle "
    "Kleidungsstuecke werden richtig gut beleuchtet, so dass man sie "
    "direkt mal naeher inspizieren koennte.");
  AddDetail("leuchten",
    "Einfach wunderschoen!");
  AddDetail("decke", 
    "Die cremeweisse Decke ist recht hoch, so dass der an ihr haengende "
    "Kronleuchter richtig gut zur Geltung kommt.");
  AddDetail( ({"leuchter", "kronleuchter"}),
    "Der Kronleuchter funkelt im Licht, jedoch gibt er kein eigens "
    "erzeugtes Licht von sich, sondern spiegelt vielmehr das Licht, was "
    "durch die Fenster kommt, wieder.");
  AddSpecialDetail("braut", "det_braut");
  AddDetail("geltung",
    "Dadurch, dass die Wand so hoch ist, faellt der Kronleuchter richtig "
    "gut in Dein Blickfeld. Einfach wunderbar.");
  AddDetail("blickfeld",
    "Das ist in Haeusern mit niedrigeren Decken eher eingeschraenkt.");
  AddDetail("decken",
    "Du siehst hier nur eine Decke!");
  AddDetail(({"haeuser", "haeusern"}),
    "Du befindest Dich in einem Haus.");
  AddDetail("haus",
    "In diesem Haus befindet sich Yurias Geschaeft.");
  AddDetail("anzahl",
    "Du koenntest die Anzahl der Marmorplatten schaetzen.");
  AddDetail("reichtum",
    "Yuria verdient sicher recht gut mit ihren Kleidungsstuecken.");
  AddDetail( ({"kleider", "kleidern", "kleidungsstuecke", "stuecke",
               "kleidungsstueck"}),
    "Alle Kleidungsstuecke, die so von Yuria hergestellt werden, wurden "
    "auf den Staendern aufgehaengt. Sie werden schoen durch das Licht "
    "bestrahlt und glitzern in vielen Farben vor sich hin. Falls Du "
    "an einem Kauf interessiert sein solltest, wirf ein mal einen Blick "
    "auf die Tafel.");
  AddDetail("kauf",
    "Schau auf die Tafel!");
  AddDetail("tafel",
    "Viele Buchstaben tuermen sich auf der Tafel, die sich gewiss "
    "alle lesen lassen.");
  AddDetail("stadt",
    "Es gibt ganz schoen viele Staedte im Silberland.");
  AddDetail("staedte",
    "Es gibt so einige Staedte wie beispielsweise Felonia, Elessar, "
    "Dhrkion und eben Midas.");
  AddDetail("felonia",
    "Felonia befindet sich recht versteckt im Gebirge.");
  AddDetail("gebirge",
    "Da wohnen unter anderem Zwerge!");
  AddDetail("zwerge",
    "Kleine Wichte, die man nicht unterschaetzen sollte.");
  AddDetail("wichte",
    "Die Groesse spielt da eigentlich keine Rolle.");
  AddDetail("groesse",
    "Die Zwerge sind ganz schoen klein.");
  AddDetail("rolle",
    "Die Groesse spielt schon mal keine.");
  AddDetail("elessar",
    "Dort wohnen die weisen Elfen.");
  AddDetail("elfen",
    "Das sind grosse, hagere Wesen mit spitzen Ohren.");
  AddDetail("wesen",
    "Sollen recht weise sein.");
  AddDetail("ohren",
    "Die Ohren sind so spitz wie bei einem gewissen Spock.");
  AddDetail("spock",
    "Kenn ich nicht. Du etwa?");
  AddDetail("dhrkion",
    "Diese gefaehrliche Stadt liegt in der dunklen Unterwelt.");
  AddDetail("unterwelt",
    "Die Unterwelt befindet sich eingentlich genau unter Dir. Jedoch "
    "kann es schwer werden, einen Eingang zu finden.");
  AddDetail("eingang",
    "Eingaenge befinden sich weit vertreut im Silberland.");
  AddDetail("eingaenge",
    "Sonderlich schwer zu finden sind sie gar nicht mal.");
  AddDetail("laden",
    "In diesem Laden gibt es Hochzeitsmoden zu kaufen!");
  AddDetail("hochzeitsmoden",
    "Wirf am besten mal einen Blick auf die Tafel.");
  AddDetail("blick",
    "Einer sollte genuegen.");
  AddDetail("kleid",
    "Auch das wirst Du hier sicherlich kaufen koennen.");
  AddDetail("buchstaben",
    "Lies sie doch mal!");
  AddDetail("ende", 
    "Am Ende des Saals befindet sich eine Theke.");
  AddDetail(({"saal","koenigssaal","saals","koenigssaals"}),
    "Der gesamte Laden wirkt auf Dich so gewaltig, dass es wahrlich "
    "ein Koenigssaal haette sein koennen.");
  AddDetail("oberflaeche",
    "Die Oberflaeche besteht aus edlem Buchenholz.");
  AddDetail("fenster",
    "Die Fenster lassen jede Menge an Licht rein.");
  AddDetail("menge",
    "Der ganze Laden ist von dem Licht erleuchtet.");
  AddDetail("gang",
    "Der breite Gang findet sein Ende bei einer Theke.");
  AddDetail("farben",
    "Du erkennst dort sehr, sehr viele Farben.");
  AddDetail("rahmen",
    "Die goldenen Rahmen verleihen dem ganzen hier noch mehr Glanz.");
  AddDetail("glanz",
    "Hier glaenzt fast alles!");
  AddDetail("raum",
    "Es handelt sich um Yurias Hochzeitsmodengeschaeft.");
  AddDetail("teppich",
    "Den Teppich moechte man eigentlich gar nicht betreten - so sauber "
    "ist er!");
  AddDetail(({"wand", "waende", "waenden"}),
    "An den Waenden befinden sich Bilder mit goldenen Rahmen. Auch die "
    "Fenster fallen Dir auf.");
  AddDetail("theke",
    "Ueber die Theke sind sicherlich schon so einige verkaufte Dinge "
    "gegangen. Sie ist vollkommen elfenweiss und mit einer interessanten "
    "Oberflaeche bedeckt.");
  AddDetail("dinge",
    "Hier kann man allerlei Dinge kaufen. Ein Blick auf die Tafel genuegt.");
  AddDetail(({"staender", "staendern"}),
    "Auf den Staendern befinden sich unzaehlige Kleidungsstuecke.");
  AddDetail("verlobte",
    "Verlobte finden in diesem Laden sicherlich einige schoene "
    "Kleidungsstuecke.");
  
  //Smells:  
  AddSmell(DEFAULT_SMELL,
    "In dem Laden riecht es recht neutral - man spuert jedoch, dass man "
    "in einem Wald ist und riecht den typischen Waldgeruch.");
  AddSmell( ({"wald","waldgeruch"}),
    "Es riecht nach Baeumen und Blaettern.");
  AddSmell( ({"baeumen", "baeume", "baum"}),
    "Richtig schoen harzig riechts.");
  AddSmell("blaetter",
    "Du kannst sie gut riechen.");

  //Sounds:  
  AddSound(DEFAULT_SOUND,
    "Es ist sehr leise hier. Es lassen sich nur ab und an Vogellaute "
    "vernehmen. Ganz leise hoert man sogar hier noch das Wasser.");
  AddSound("vogellaute",
    "Sie stammen von den Voegeln im Silberwald.");
  AddSound("voegel",
    "Den Voegeln kannst Du besser draussen lauschen!");
  AddSound( ({"wasser", "rauschen", "meer"}),
    "Das Rauschen des Meeres dringt bis hierher.");
  AddSound( ({"wald", "silber", "silberwald"}),
    "Du hoerst die Voegel des Silberwalds bis hierher.");
    
  AddExit("westen", "/d/wasser/woody/fischerdorf/room/weg4");
  
  AddCmd("schaetz|schaetze&anzahl&der&platten|marmorplatten", "cmd_schaetzen",
         "Was willst Du denn ueberhaupt schaetzen?|"
         "Ach, Du willst die Anzahl der Platten schaetzen?");
  AddCmd("lies&tafel|buchstaben", "cmd_tafel_lesen",
         "Was willst Du denn genau lesen?");
         
         
  //NPCs:
  AddItem(NPC "yuria",    REFRESH_DESTRUCT);
  AddItem(NPC "waechter", REFRESH_DESTRUCT);
         
         
  
         
}


string det_braeutigam(string key)
{
  if (TP->QueryProp(P_GENDER) == 2)
    return "Motivier deinen Braeutigam dir eins dieser luxurioesen Kleider zu kaufen!\n";
  else
    return "Du solltest Deiner Braut ein richtig schoenes Kleid kaufen!\n";
}

string det_braut(string key)
{
  if (TP->QueryProp(P_GENDER) == 2)
    return "Du solltest Deinem Braeutigam einen guten Anzug kaufen!\n";
  else 
    return "Du solltest Deiner Braut ein richtig schoenes Kleid kaufen!\n";
}

int cmd_schaetzen(string str)
{
  write("Du schaetzt die Anzahl der Platten auf ungefaehr 27!");
  return 1;
}

int cmd_tafel_lesen(string str)
{
  TP->More(read_file("/d/wasser/malar/laden/doc/tafel"));
  return 1;
}


do_sell(object ob, int force, no_reg) 
{
  write (BS(
    "Yuria sagt: Es tut mir leid, aber ich verkaufe nur!")); 
    return -1; 
}