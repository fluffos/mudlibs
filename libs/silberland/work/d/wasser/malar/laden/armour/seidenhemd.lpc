#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();


  SetProp(P_SHORT, "Ein weisses Seidenhemd");
  SetProp(P_LONG,
    "Das ist ein weisses Seidenhemd, welches einen Schlitz vom Halsauschnitt "
    "nach unten verlaufen hat. Es wird von einer Kordel zusammengehalten. "
    "Weiters erkennst Du noch weite, bauschige Aermel, die beim Handgelenk "
    "mit Satinbaendern zusammen gerafft wurden.");
  SetProp(P_NAME, "Seidenhemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"seidenhemd", "hemd"}) );

  AddDetail( ({"schlitz"}),
	     "Der Schlitz verlaeuft vom Halsausschnitt nach unten und koennte "
	     "ein wenig von der maennlichen Brust freigeben.");

  AddDetail( ({"halsausschnitt","ausschnitt"}),
	     "Der Halsausschnitt ist sehr weit und enthaelt eine Kordel.");

  AddDetail( ({"kordel"}),
	     "Die Kordel ist dazu da, dass sie das Hemd zusammenhaelt, da es "
	     "ansonsten von der Schulter gleiten wuerde.");

  AddDetail( ({"aermel"}),
	     "Die weiten, bauschigen Aermel werden beim Handgelenk mit einem "
	     "huebschen, weissen Satinband zusammengerafft.");

  AddDetail( ({"satinband","band","satin"}),
	     "Das glaenzende Band flattert bei jeder Bewegung und verleiht dem "
	     "gesamten Hemd eine Eleganz.");

  AddDetail( ({"eleganz"}),
	     "Du vermutest, dass dieses weisse Hemd fuer ganz besondere "
	     "Momente getragen wird.");

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 20);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: MALE]));

  //AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES );
}
