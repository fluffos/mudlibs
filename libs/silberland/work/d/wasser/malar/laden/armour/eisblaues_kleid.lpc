#include "../def.h"

inherit "/std/armour";
				
object traeger;
string old_msgin, old_msgout;

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  AddId (({"kleid", "hochzeitskleid"}));
  SetProp( P_SHORT, "Ein eisblaues Kleid");

  SetProp( P_LONG,
    "Eine geheimnisvolle Aura umgibt dieses Kleid und laesst seine Traegerin "
    "anmutig und elegant erscheinen. Es ist eisblau und legt sich wie "
    "eine zaertliche Umarmung um sie. Hochgeschlossen mit einem kleinen "
    "Stehkragen verlaeuft es sanft enganliegend bis zur Huefte wo es dann in "
    "einem Glockenschnitt verlaeuft. Eine Spur von winzigen Eiskristallen "
    "zieht sich entlang des Kleides und funkelt wie tausend Regenboegen.");


  AddDetail( ({"aura"}),
  "Sie strahlt geheimnisvoll aber freundlich.");

  AddDetail( ({"umarmung"}),
  "Lass Dich mal von jemanden umarmen, dann weisst Du wie es gemeint ist :)");

  AddDetail( ({"stehkragen","kragen"}),
  "Der Kragen macht das Kleid um einiges eleganter. Wenn man genau hinsieht "
  "kann man sehen das er am oberen Rand ebenfalls Eiskristalle hat und an "
  "der linken Seite sogar einen besonders schoenen, der ein bisschen groesser "
  "ist.");

  AddDetail( ({"eiskristall"}),
  "Auch er glitzert trauemerisch im Licht.");

  AddDetail( ({"huefte"}),
  "Die der Traegerin natuerlich! Sie duerfte mit die schoenste Huefte des "
  "ganzen Landes haben!");

  AddDetail( ({"glockenschnitt"}),
  "So wie bei einer Glockenblume, wenn man ihr Koepfchen nach unten haelt. "
  "Seidenzart verlaeuft der Stoff.");

  AddDetail( ({"koepfchen"}),
  "Das der Blume.");

  AddDetail( ({"regenbogen"}),
  "Die Farben erinnern Dich an einen. Sie sind nicht kraeftig, aber klar "
  "zu erkennen. Man koennte sagen sie sind so stark ausgepraegt wie das "
  "Gefuehl wenn man eine Feder vorsichtig ueber Deinen Arm streicht.");

  AddDetail( ({"eiskristalle","eiskristallen"}),
  "Die machen das tolle Funkeln aus.");

  AddDetail( ({"funkeln"}),
  "Das kommt durch die Eiskristalle der legendaeren Eisblume.");

  AddAdjective( ({"eisblau", "eisblaues", "eisblaue"}) );

  SetProp(P_NAME, "Kleid");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([ MAT_SILK : 100 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]));
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:0]) );
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());
}

int WearFunc()
{
  traeger = this_player();
//  old_msgin = traeger->QueryProp(P_MSGIN);
//  traeger->SetProp(P_MSGIN,
//    "kommt an und es scheint, als wenn die Kristalle auf ihrem Kleid singen");
//  old_msgout = traeger->QueryProp(P_MSGOUT);
//  traeger->SetProp(P_MSGOUT,
//    "geht# und die Eiskristalle auf ihrem Kleid funkeln");
  SetProp(P_LONG,
    "Eine geheimnisvolle Aura umgibt dieses Kleid und laesst "
    + capitalize(traeger->name()) +
    "anmutig und elegant erscheinen. Es ist eisblau und legt sich wie "
    "eine zaertliche Umarmung um sie. Hochgeschlossen mit einem kleinen "
    "Stehkragen verlaeuft es sanft enganliegend bis zur Huefte wo es dann "
    "in einem Glockenschnitt verlaeuft. Eine Spur von winzigen Eiskristallen "
    "zieht sich entlang des Kleides und funkelt wie tausend Regenboegen.");
  traeger->Set(P_MSGIN, symbol_function("msgin", TO), F_QUERY_METHOD);
  traeger->Set(P_MSGOUT,symbol_function("msgout",TO), F_QUERY_METHOD);

  return 1;
}

int RemoveFunc()
{
//  traeger->SetProp(P_MSGIN, old_msgin);
//  traeger->SetProp(P_MSGOUT, old_msgout);
  SetProp( P_LONG,
  "Eine geheimnisvolle Aura umgibt dieses Kleid und laesst seine Traegerin "
  "anmutig und elegant erscheinen. Es ist eisblau und legt sich wie "
  "eine zaertliche Umarmung um sie. Hochgeschlossen mit einem kleinen "
  "Stehkragen verlaeuft es sanft enganliegend bis zur Huefte wo es dann "
  "in einem Glockenschnitt verlaeuft. Eine Spur von winzigen Eiskristallen "
  "zieht sich entlang des Kleides und funkelt wie tausend Regenboegen. ");
  
  traeger->Set(P_MSGIN, 0, F_QUERY_METHOD);
  traeger->Set(P_MSGOUT,0, F_QUERY_METHOD);

  return 1;
}

string extra_look()
{
  object ob;
  if (!(ob = this_object()->QueryWorn()))
    return 0;

  return capitalize(ob->QueryPronoun()) + " traegt ein Kleid, "
    "das entstand, als die Sonne den Mond gekuesst hat.\n";
}

string msgin()
{
  return "kommt an und es scheint, als wenn die Kristalle auf ihrem Kleid singen";
}

string msgout()
{
  return "geht# und die Eiskristalle auf ihrem Kleid funkeln";
}



