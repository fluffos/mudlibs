inherit "std/armour";

#include "../def.h"

void create()
{
  ::create();
  SetProp(P_SHORT, "Ein glitzernes Diadem");
  SetProp(P_LONG,
    "Tausend Farben funkeln umher wenn Licht auf die feinen Diamanten des "
    "Diadems trifft. Fast schon zieht es einen hypnotisch in seinen Bann. "
    "Reichlich ist es mit mehreren unterschiedlich grossen Diamanten "
    "geschmueckt. In der Mitte buendelt ein auffaelliger Rubin die "
    "Aufmerksamkeit des Betrachters und kleine unauffaellige Saphirsplitter "
    "scheinen die Mitte von lauter kleinen Diamantblumen zu bilden. ");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 4400);
  SetProp(P_NAME, "Diadem");
  AddId( ({"diadem"}) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_DIAMOND:10,MAT_SILVER:80,MAT_MISC_MAGIC:10]));
  SetProp(P_WEIGHT, 200);

  AddCmd(({"setze","setz"}),"cmdsetze");
  AddCmd(({"_XXXYYY_"}),"anziehen");

}

int cmdsetze(string str) 
{
  string was, wer;
  object ob, player, next;
  int worn;

  worn = 0;

  notify_fail("Wem willst Du was aufsetzen?\n");
  if (!str) return 0;

  // Syntaxcheck
  if( sscanf(str, "%s %s auf", wer, was) == 2 && id(was) )
  {
    player = find_living(wer);
    
    //Spieler ist nicht eingelogt
    if(!player)
    {
      write("Aber "+TP->Name(WER, 1)+" ist doch gar nicht "
      +"anwesend!\n");
      return -1;
    }
    
    //Spieler ist nicht im gleichen Raum
    if(ENV(TP) != ENV(player))
    {
            write("Aber "+player->Name(WER, 1)+" ist doch gar nicht hier!\n");
            return -1;
    }

    for(ob=first_inventory(player);ob;) 
    {
      next=next_inventory(ob);
      if( ob->QueryProp(P_ARMOUR_TYPE) == AT_HELMET &&
ob->QueryProp(P_WORN))
      {
        worn = 1;
        break;
      }
      ob=next;
    }

    if( worn ) 
    {
      write(player->Name(WER, 1) + " traegt schon etwas auf dem Kopf.\n");
      return -1;
    }

    //Helm ist zu schwer
    if(ME_TOO_HEAVY == this_object()->move(player,M_GET|M_SILENT))
    {
      write(BS(player->Name(WER, 1)+" kann den Helm leider "
      +"nicht mehr tragen."));
      return -1;
    }
    else
    {
      write("Du setzt " + player->Name(WER, 1) + " ein Diadem auf.\n");
      say(TPN + " setzt " + player->Name(WER, 1) + " ein Diadem auf.\n",
({TP,player}));
      tell_object(player, TPN + " setzt Dir ein Diadem auf.\n");

      player->command_me("_XXXYYY_");
      return 1;
    }
  }
  return 0;
}

int anziehen(string str)
{
  DoWear(1,0);
  return 1;
}
