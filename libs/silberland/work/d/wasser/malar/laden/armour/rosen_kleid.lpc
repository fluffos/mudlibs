#include "../def.h"

inherit "/std/armour";
				
object traeger;
//string old_msgin, old_msgout;

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  AddId (({"kleid", "brautkleid", "rosenkleid", "MALARKLEID"}));
  SetProp( P_SHORT, "Ein rosenbesticktes Brautkleid");

  SetProp(P_LONG,
  "Wenn man den Stoff durch seine Haende gleiten laesst "
  "koennte man meinen es handle sich um Wasser. Er ist schneeweiss "
  "und wird sicher seiner Traegerin schmeicheln. Das Kleid ist "
  "aermellos und der Rand, knapp ueber der Brust ist mit zartrosa "
  "Rosen bestickt. Der Rock ist leicht ausgestellt. ");

  SetProp( P_NAME, "Kleid");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_WEIGHT, 20); //bisschen mehr waer schon nicht schlecht ;) - is doch aber nur zierde ;)
  SetProp( P_VALUE, 10000); 
  SetProp( P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp( P_AC, 0); //Ist schliesslich nur zur Zierde gedacht. - jupp, vergess ich nur leider gern
  SetProp( P_MATERIAL, MAT_SILK);
  SetProp( P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]));
  SetProp( P_WEAR_FUNC, TO);
  SetProp( P_REMOVE_FUNC, TO);

  AddDetail( ({"stoff"}),
    "Er ist zartfliessend.");
  AddDetail( ({"haende"}),
    "Deine Haende. ");

  AddDetail( ({"rock"}),
  "Er ist leicht ausgestellt und gewaehrt viel Bewegungsfreiheit. ");

}

int WearFunc()
{
    traeger=this_player();
//  old_msgin=traeger-> QueryProp(P_MSGIN);
//  traeger->SetProp(P_MSGIN, "kommt leichtfuessig herein");
//  old_msgout=traeger-> QueryProp(P_MSGOUT);
//  traeger->SetProp(P_MSGOUT, "geht leichtfuessig");
  
  SetProp( P_LONG,
    "Wenn man den Stoff durch seine Haende gleiten laesst "
    "koennte man meinen es handle sich um Wasser. Er ist schneeweiss "
    "und schmeichelt "+capitalize(traeger->name())+". Das Kleid ist "
    "aermellos und der Rand, knapp ueber der Brust ist mit zartrosa "
    "Rosen bestickt. Der Rock ist leicht ausgestellt. ");
  traeger->Set(P_MSGIN, symbol_function("msgin",TO), F_QUERY_METHOD);
  traeger->Set(P_MSGOUT,symbol_function("msgout",TO),F_QUERY_METHOD);
  return 1;
}

int RemoveFunc()
{
//  traeger->SetProp(P_MSGIN, old_msgin);
//  traeger->SetProp(P_MSGOUT, old_msgout);
  SetProp( P_LONG,
    "Wenn man den Stoff durch seine Haende gleiten laesst "
    "koennte man meinen es handle sich um Wasser. Er ist schneeweiss "
    "und wird sicher seiner Traegerin schmeicheln. Das Kleid ist "
    "aermellos und der Rand, knapp ueber der Brust ist mit zartrosa "
    "Rosen bestickt. Der Rock ist leicht ausgestellt. ");
  traeger->Set(P_MSGIN, 0, F_QUERY_METHOD);
  traeger->Set(P_MSGOUT,0, F_QUERY_METHOD);
  return 1;
  
}

string extra_look()
{
  if (this_object()->QueryWorn()!= 0)
  return BS("Sie traegt ein rosenbesticktes Kleid.");
  else 
  return 0;
}

msgin()
{
  return "kommt leichfuessig herein";
}

msgout()
{
  return "geht leichtfuessig";
}


