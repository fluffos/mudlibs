// Comments:  Verkaufsnpc Yuria - Mollige Fee, nicht sonderlich stark
//=========================================================================





inherit "std/npc";

#include "../def.h"
#include <npcmaster.h>

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    
  
  SetProp(P_SHORT, "Yuria");
  SetProp(P_LONG, 
    "Yuria ist die Verkaeuferin in diesem Hochzeitsmodengeschaeft. Sie ist "
    "fuer eine Fee recht klein und hat einen gewaltigen Taillenumfang! Sie "
    "scheint mit ihrem Geschaeft schon so einiges an Geld gemacht zu haben, "
    "denn ihr Auftreten wirkt besonders vornehm und exquisit. Sie hat "
    "borstige rote und besonders lange Haare, die ueber ihren etwas buckeligen "
    "Ruecken fallen.");
  SetProp(P_NAME, "Yuria");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"verkaeuferin", "fee", "yuria", "inhaberin"}) );
  AddClass(CL_FAIRY);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Fee");
  create_default_npc(27+random(2));
  SetProp(P_ALIGN,900); 
  SetProp(P_BODY, 120);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_HANDS, ({" mit ruppigen Feenhaenden", 320, DT_BLUDGEON}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_REJECT,({ REJECT_DROP, "Yuria ist viel zu schwach, um " 
                                   "auch noch etwas tragen zu koennen!\n" }) );
                                   
  SetProp(P_NO_SCORE, 1); //Kein Erstkiller - da Laden-NPC!
                                   

                                   
  AddDetail("haare",
    "Yuria hat rote und borstige Haare. Sie fallen ueber ihren etwas "
    "buckeligen Ruecken. Von hinten sieht das sehr lustig aus!");
  AddDetail("ruecken",
    "Dank ihrer Figur hat Yuria einen etwas buckeligen Ruecken.");
  AddDetail("figur",
    "Yuria ist etwas mollig.");
  AddDetail("taillenumfang",
    "Du wagst Dir gar nicht diese Ausmasse vorzustellen!");
  AddDetail("auftreten",
    "Sie hat wohl viel Geld mit ihrem Geschaeft gemacht. Ihr Auftreten "
    "wirkt besonders vornehm.");  

  SetChats(5, ({
    "Yuria schlendert im Kreis herum.\n",
    "Yuria fragt Dich: Moechtest Du nicht etwas kaufen?\n",
    "Yuria schaut nach dem Rechten.\n",
    "Yuria schaut nach ihren Kleidern.\n",
    "Yuria schaut vertraeumt aus dem Fenster und seufzt.\n"
    }));
  
  SetProp(P_LOG_INFO, "/malar/yuria.log");
  AddInfo(DEFAULT_INFO,({ 
    "sagt: Kauf lieber ein Kleid!\n",
    "weiß nicht, was Du von ihr willst!\n",
    "schaut Dich verwirrt an.\n"
    "gaehnt.\n" }) );
    
  AddInfo(({"laden", "geschaeft", "hochzeitsmodenladen", "hochzeitsmoden",
            "hochzeitsmodengeschaeft", "haus"}),
    "Dieser Laden ist mein ein und alles! Hier verkaufe ich Kleider und "
    "sonstige Hochzeitsmoden!",
    "erklaert: ");
  AddInfo("kleider",
    "Untersuche meine Kleider! Sie haben alle eine erstklassige Qualitaet!",
    "meint: ");
  AddInfo("qualitaet",
    "Die Qualitaet ist einmalig! Ueberzeug Dich am besten selber!",
    "sagt: ");
  AddInfo(({"moden", "hochzeitsmoden"}),
    "Dazu zaehle ich beispielsweise Kleider und sonstige Utensilien.",
    "erklaert: ");
  AddInfo("utensilien",
    "Lass sie Dir per 'zeige' anzeigen!",
    "meint: ");
    
}

void init()
{
 ::init();
 if (TP && TP->id("rausschmeisser")) 
 AddDefender(TP);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "yuria.kills", 
     sprintf( ctime()+": Kauz bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   }
  return 0;
}

void die(int poisondeath)
{
  write_file(LOG "yuria.deaths",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Yuria.\n");
  ::die(poisondeath);
}