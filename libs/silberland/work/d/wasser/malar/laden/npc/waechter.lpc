inherit "std/npc";

#include "../def.h"
#include <npcmaster.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Rausschmeisser ueberprueft Deine Kleidung");
//  SetProp(P_SHORT_FIGHT, "Der Rausschmeisser versucht gerade, %s rauszuwerfen");
  SetProp(P_LONG, BS(
    "Vor Dir steht ein muskuloeser Zwerg, wie man ihn nur selten sehen kann. "
    "Er besteht fast nur aus gewaltigen Muskeln. Weil er so stark ist, hat "
    "er hier den Job des Rausschmeissers uebernommen. Er sorgt dafuer, dass "
    "nur Leute mit korrekter Kleidung den Hochzeitsmodenladen betreten."));
  SetProp(P_NAME, "Rausschmeisser");
  SetProp(P_GENDER, MALE);
  set_living_name("rausschmeisser");
  AddId(({"rausschmeisser", "schmeisser", "\nrausschmeisser", "zwerg"}));

  AddDetail( ({"muskel", "muskeln"}),
    "Dieser Zwerg hat wirklich gewaltige Muskeln.");
  SetProp(P_SMELL, "Der Rausschmeisser riecht nach Aerger.\n");
    
  create_default_npc(24);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Haenden",QueryProp(P_HANDS)[1], DT_BLUDGEON}));
  SetAttribute(A_STR, 66);
  SetProp(P_XP, QueryProp(P_XP)+1200*100); // Bonus fuer Spells
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 132);
  SetProp(P_ALIGN, -50);
  
  SetProp(P_NO_SCORE, 1); //Kein Erstkiller - da Laden-NPC!
  
  SetProp(P_RESISTANCE_STRENGTHS ,([DT_ACID:-0.7,
                                   DT_POISON: -0.6,
                                   DT_COLD: -0.3,
                                   DT_WHIP: -0.2,
                                   DT_TERROR: -0.9,
                                   DT_BLUDGEON: -0.8,
                                   DT_WATER: 0.5]) );
  SetProp(P_NOMAGIC, 15);

  SetProp(P_DIE_MSG,  " wird aus dem Leben rausgeschmissen.\n");
  SetProp(P_KILL_MSG, "Ich schmeisse jeden raus!");

  SetProp(P_DEFAULT_INFO, ({
    "brummelt vor sich hin.\n",
    "knurrt Dich an.\n",
    "beachtet Dich gar nicht.\n",
    "droht: Ich schmeiss Dich hier gleich raus!\n",
    "kratzt sich am Bart.\n",
    "gruebelt ueber Deine komische Frage.\n",
    "sagt: Ich glaub, ich hab mich verhoert! So eine Frechheit!\n"}) );
  
  //AddInfo("feyaria",
  //  "Feyaria hat mich erschaffen.", "sagt: ");
  AddInfo( ({"stiefel", "rausschmiesserstiefel"}),
    "Meine Stiefel sind toll, nicht wahr?", "prahlt: ");
  AddInfo( ({"name", "rausschmeisser", "schmeisser"}),
    "Ich bin der Rausschmeisser.", "sagt: ");
  AddInfo( ({"beruf", "aufgabe", "dienst", "laden", "job",
             "arbeit", "hochzeitsmodenladen"}),
    "Ich arbeite hier im Laden als Rausschmeisser.", "antwortet: ");
  AddInfo( ({"muskel", "muskeln", "kraft","gewalt", "koerperkraft"}),
    "zeigt Dir seine gewaltigen Muskeln.\n");
  AddInfo( ({"kleidung", "bekleidung"}),
    "Du musst korrekt gekleidet sein, wenn Du im Grand Hotel bist.",
    "sagt streng: ");
  AddInfo( ({"ratten", "ratte"}),
    "Ratten? In diesem feinem Haus gibts es keine Ratten! Frechheit!",
    "sagt entruestet: ");
  AddInfo( ({"frechheit"}),
    "Werd bloss nicht frech!", "droht Dir: ");
  AddInfo( ({"bart"}),
    "Wie jeder anstaendige Zwerg habe ich einen grossen Vollbart.", "sagt: ");
  AddInfo( ({"zwerg", "zwerge"}),
    "Zwerge sind die besten!", "prahlt: ");
  AddInfo( ({"yuria"}),
    "Fuer Yuria arbeite ich als Rausschmeisser!", "erklaert Dir: ");
//  AddInfo( ({"menue", "champagner", "ragout", "kaffee", "salat", "bananen",
//             "bananen-salat", "essen", "trinken"}),
//    "Mach doch einfach 'menue'!", "grummelt: ");
  SetProp(P_LOG_INFO,"malar/rausschmeisser.log");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Rausschmeisser steckt Deine Sachen achselzucken ein.\n" }) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_SPELLRATE,1);
  AddSpell(1,1000,
    "Der Rausschmeisser wirft Dich raus.\n",
    "Der Rausschmeisser wirft @WEN raus.\n",
     DT_BLUDGEON,"rauswerfen",([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
    "Der Rausschmeisser fragt Dich: Ist Deine Kleidung wirklich sauber?\n",
    "Der Rausschmeisser begutachtet Deine Kleidung.\n",
    "Der Rausschmeisser kontrolliert Deine Kleidung.\n",
    "Der Rausschmeisser mustert Dich wachsam.\n",
    "Der Rausschmeisser brummelt vor sich hin.\n",
    "Der Rausschmeisser knurrt Dich an.\n",
    "Der Rausschmeisser droht: Ich schmeiss Dich hier gleich raus!\n",
    "Der Rausschmeisser kratzt sich am Bart.\n"}) );

  SetAttackChats(75, ({
    "@@use_stiefel@@",
    "Der Rausschmeisser will Dir einen Stiefeltritt geben.\n",
    "Der Rausschmeisser versucht vergeblich, Dich rauszuschmeissen.\n",
    "Der Rausschmeisser bruellt vor Wut.\n"}) );

  SUID;  // Ausruestung muss natuerlich auch sein
  CLONEME("/d/dschungel/feyaria/tijara/armour/stiefel");
  command("trage alles");

  AddCmd( ({"feuerelementar", "luftelementar", "wasserelementar",
            "eiselementar", "erzelementar", "humuselementar"}), "elementare");
}

string use_stiefel()
{
  object stiefel, en;
  
  if (!stiefel=present("\nrausschmeisserstiefel"))
    return "Der Rausschmeisser murmelt: Wo sind meine Stiefel?\n";
  if (objectp(en=QueryEnemy()))
  {
    stiefel->treten(getuid(en), 1);
    return "Der Rausschmeisser murmelt: Was taete ich ohne meine Stiefel?\n";
  }
  return "";
}

void rauswerfen(object enemy, int damage, mixed dam_type)
{
  if( present(enemy) )
    enemy->move("/d/wasser/woody/fischerdorf/room/weg4", M_GO, 
    "in hohem Bogen hinaus", "fliegt",
      "fliegt schmerzhaft herein");
}

int elementare()
{
  tell_room(MENV, break_string("Belaestige mich nicht mit solchen "
        "Kreaturen, "+ TPN +"!", 78, "Der Rausschmeisser sagt: "));
  rauswerfen(TP,0,0);
  return 1;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  string wie;
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
    case "frech":
    case "intim":
    case "albern":
    case "aergerlich":
      call_out("react",0, "wirft Dich aus dem Laden hinaus.", 
          "wirft "+TP->name(WEN,1)+" aus dem Laden hinaus.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others=victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
    rauswerfen(TP, 0, 0);
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void InformDefend(object enemy)
{
  ENV(TO)->Message(BS(
  "Der Rausschmeisser hilft Yuria im Kampf!!"));
  Kill(enemy);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "waechter.kills", 
     sprintf( ctime()+": Waechter bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   }
  return 0;
}

void die(int poisondeath)
{
  write_file(LOG "waechter.deaths",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
                +" killt Waechter.\n");
  ::die(poisondeath);
}

