//erstellt am 12.03.03 von hiri
inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Kuschelmonsterfell");
  SetProp(P_LONG, 
    "Dieses Kuschelmonsterfell gehoerte einem Kuschelinomonster. Es ist "
    "nicht allzu schwer und hat dunkelbraune Streifen in dem ansonsten "
    "hellbraunen Fell.");
  SetProp(P_INFO, "Dieses Fell scheint etwas besonderes zu sein, "
                  "vielleicht kann man es ja gerben und naehen.");
  SetProp(P_NAME, "Kuschelmonsterfell");
  SetProp(P_GENDER, NEUTER);
  AddId (({"fell","kuschelmonsterfell", "monsterfell", "HIRIFELL", "\nfell_is_gerb_able"}));


  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 450);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5, T_HEAT_PROT:-3]) );
}

