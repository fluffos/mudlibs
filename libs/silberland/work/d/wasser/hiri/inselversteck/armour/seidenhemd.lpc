//erstellt am 06.03.03 von hiri
inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>



void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein durchsichtiges Seidenhemd");
  SetProp(P_LONG, 
    "Das durchsichtige Seidenhemd fuehlt sich an wie eine zweite Haut. "
    "Nuincorion, dem das Hemd gehoert hat, hat bestimmt ein sehr gut "
    "gebauten Koerper.");
    
  SetProp(P_NAME, "Seidenhemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd", "seidenhemd"}) );
  
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_SILK);
  
}


