//erstellt am 05.03.03 von hiri
inherit "std/armour";
inherit "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";

#include <properties.h>
#include <combat.h>

void create()
{
  
  if( !is_clone(this_object()) ) return;
  ::create();

  
  SetProp(P_SHORT, "Ein verfuehrerischer Maennerstring");
  SetProp(P_LONG, 
    "Ein verfuehrerischer blaugruener Maennerstring. Der Maennerstring "
    "besteht aus feinster Seide und schmiegt sich wie eine zweite Haut an "
    "des Mannes Koerper. Die Elfenseide schimmert in einem kraeftigen "
    "blaugruen.");
  SetProp(P_NAME, "Maennerstring");
  SetProp(P_NAME_ADJ, "blaugruen");
  SetProp(P_GENDER, MALE);
  AddId( ({"maennerstring","string"}) );
  AddAdjective( ({"blaugruener", "blaugruen"}) );
  SetProp("underwear_type", "Unterhose");
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
}

  
   
