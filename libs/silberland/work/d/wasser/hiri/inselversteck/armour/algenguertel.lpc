//erstellt am 05.03.03 von hiri 
inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein pflanzlicher Guertel");
  SetProp(P_LONG, 
    "Ein breiter, blaugruener Algenguertel mit einer breiten Schnalle zum "
    "zumachen.");
  SetProp(P_NAME, "Algenguertel");
  SetProp(P_NAME_ADJ, "blaugruen");
  SetProp(P_GENDER, MALE);
  AddId( ({"algenguertel", "guertel"}) );
  AddAdjective( ({"blaugruener", "blaugruenen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:95, MAT_COBALT:5 ]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 380);                                            
}

