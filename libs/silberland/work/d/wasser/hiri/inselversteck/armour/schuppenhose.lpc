//erstellt am 05.03.03 von hiri
inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine geschuppte Hose");
  SetProp(P_LONG, 
    "Eine geschuppte blaugruene Hose. Die Hose ist aus feinen Plaettchen "
    "zusammengesetzt und sieht aus, als ob sie nass waere. Die Plaettchen "
    "sind im Wechsel, blau oder gruen schimmernd. Eigentlich schimmert sie "
    "blaugruen.");
  SetProp(P_NAME, "Schuppenhose");
  SetProp(P_NAME_ADJ, "blaugruen");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schuppenhose", "hose"}) );
  AddAdjective( ({"blaugruen", "blaugruene"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_CHITIN:75, MAT_IVORY:25]) );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 300);
}

  
    
