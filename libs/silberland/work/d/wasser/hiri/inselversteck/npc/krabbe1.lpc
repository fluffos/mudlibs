
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Krabbe");
  SetProp(P_LONG,
    "Die Krabbe hat zwei ziemlich scharfe Scheren, womit sie Dich bestimmt "
    "zwickt, wenn Du sie angreifst. Sie hat einen kleinen Panzer der sich "
    "orangerot faerbt, wenn sie stirbt.");
  SetProp(P_NAME, "Krabbe");
  SetProp(P_GENDER,  FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "krabbe"}));

  create_default_npc(6);
  SetProp(P_HANDS, ({" mit ihren Scheren" , 60, DT_RIP }) );
  SetProp(P_SIZE, 35 );
  SetProp(P_RACE, "Krabbe");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MMSGIN, "krabbelt seitlich rennend herein");
  SetProp(P_MMSGOUT, "krabbelt seitlich weiter und verschwindet");
  SetProp(P_DIE_MSG,  " krabbt in die ewigen Krabbengruende.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wir sehn uns bestimmt wieder!");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Keine Frage, Du bist ein Weichei!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Krabbe will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Die Krabbe klappert mit den Scheren.\n",
    "Die Krabbe erklimmt Dein Bein.\n",
    "Die Krabbe zwickt Dich in Dein Po.\n"}) );
  SetAttackChats(10, ({
    "Die Krabbe stiert Dich boese an und kneift Dich.\n"}) );
}

