//erstellt im januar 04 von hiri
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kuschelmami, eine Kuschelmonsterfrau");
  SetProp(P_LONG,
    "Kuschelmami ist nicht so nett wie ihr Sohn oder ihr Mann. "
    "Sie ist eine wirklich alte Zicke, ohne Frage. "
    "Kuschelmonsterfrauen sind immer groesser als ihre Maenner. "
    "Anders als ihre Kinder haben sie absolut keine Gefuehle. ");
  SetProp(P_NAME, "Kuschelmami");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  
  AddId(({ "kuschelmami", "mami", "HIRIMAMI" }));
  AddId("Peitschenmeister"); 
  create_default_npc(40);
  SetProp(P_HANDS, ({" mit ihren Kuschelhaenden" ,160, DT_RIP }) );
  SetProp(P_SIZE, 190 );
  SetProp(P_RACE, "Kuschelmonsterfrau");
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,50);

  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "zickt herein");
  SetProp(P_MSGOUT, "zickt dich an und verschwindet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " zickt Dich nochmal an und stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste Mal %s, zick ich Dich um.");

  SetProp(P_KILL_NAME, "Kuschelmami");
  SetProp(P_KILL_MSG, "Du hattest keine Chance, Baby!");

  AddInfo(DEFAULT_INFO, "moechte lieber zicken, als von Dir so "
                        "dumme Sachen gefragt zu werden.\n");
  AddInfo("hiri",
    "Wenn es Hiri nicht gaebe, wuerde es mich auch nicht geben.","sagt: ");
  AddInfo( ({"kuschelmami","mami"}),
    "Ich bin Kuschelmami und es gibt fuer mich nichts schoeneres als zicken.",
    "sagt: ");
 AddInfo( ({ "rage"}),
    "Rage ist der liebste Gockel, den es gibt, und der Papi von Hiri.",
    "sagt: ");
  
  SetProp(P_LOG_INFO, "hiri/inselversteck.log");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Kuschelmami will Deine Sachen nicht tragen.\n" }) );

  AddSpell(1,500,
     "Kuschelmami schmettert eine Zickenattacke auf Dich.\n",
     "Kuschelmami zerschmettert @WEM mit einer Zickenattacke.\n");


  SetChats(3, ({
    "Kuschelmami moechte am liebsten mal wieder zicken.\n",
    "Kuschelmami zickt Dich an.\n"}) );
  SetAttackChats(10, ({
    "Kuschelmami zickt Dich beinahe zu Tode.\n",
    "Kuschelmami zerreisst Dich mit der Kraft einer Zicke.\n"}) );



  SUID;
  CLONEME(WEAPON "algenpeitsche" );
  command("zuecke algenpeitsche");
  if (random(100)>80) CLONEME(ARMOUR "monsterfell" );
  command("trage monsterfell");

}




void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Kuschelmami.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Kuschelmami hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}


