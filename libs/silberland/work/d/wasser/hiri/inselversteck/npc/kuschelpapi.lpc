//erstellt im januar 04 von hiri
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kuschelpapi das Kuschelmonster");
  SetProp(P_LONG,
    "Kuschelpapi ist ein sehr sehr freches Kuschelmonster, ganz anders "
    "als sein Sohn. Er hat auch keinerlei Gefuehle und mault eher herum.");
  SetProp(P_NAME, "Kuschelpapi");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  
  AddId(({ "kuschelpapi", "papi", "HIRIPAPI" }));
  AddId("Peitschenmeister"); 
  create_default_npc(35);
  SetProp(P_HANDS, ({" mit seinen Kuschelhaenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 182 );
  SetProp(P_RACE, "Kuschelmonster");
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);

  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "mault herein");
  SetProp(P_MSGOUT, "brummelt was in sein Fell und verschwindet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " mault ein letzes mal und stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste Mal %s, mecker ich solang bis Du von allein umfaellst.");

  SetProp(P_KILL_NAME, "Kuschelpapi");
  SetProp(P_KILL_MSG, "Du hattest keine Chance, Baby!");

  AddInfo(DEFAULT_INFO, "brummelt lieber weiter in sein Fell, als von Dir so "
                        "dumme Sachen gefragt zu werden.\n");
  AddInfo("hiri",
    "Wenn es Hiri nicht gaebe, wuerde es mich auch nicht geben.","sagt: ");
  AddInfo( ({"kuschelpapi","papi"}),
    "Ich bin Kuschelpapi und es gibt fuer mich nichts schoeneres als brummeln.",
    "sagt: ");
  
  AddInfo( ({ "rage"}),
    "Rage ist der liebste Gockel, den es gibt, und der Papi von Hiri.",
    "sagt: ");
  
  SetProp(P_LOG_INFO, "hiri/inselversteck.log");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Kuschelpapi will Deine Sachen nicht tragen.\n" }) );

  AddSpell(1,500,
     "Kuschelpapi schmettert eine Meckerattacke auf Dich.\n",
     "Kuschelpapi zerschmettert @WEM mit einer Meckerattacke.\n");


  SetChats(3, ({
    "Kuschelpapi moechte nur brummeln.\n",
    "Kuschelpapi brummelt Dich an.\n"}) );
  SetAttackChats(10, ({
    "Kuschelpapi brummelt Dich beinahe zu Tode.\n",
    "Kuschelpapi zerreisst Dich mit der Kraft des Brummelns.\n"}) );



  SUID;
  CLONEME(WEAPON "algenpeitsche" );
  command("zuecke algenpeitsche");
  if (random(100)>80) CLONEME(ARMOUR "monsterfell" );
  command("trage monsterfell");

}




void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Kuschelpapi.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Kuschelpapi hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}





