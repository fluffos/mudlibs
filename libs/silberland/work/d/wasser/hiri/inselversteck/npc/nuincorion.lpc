//erstellt im februar 03 von hiri
inherit "std/mnpc";//muss fuer laufenden npc inheritet werdet

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Nuincorion der Suchende");
  SetProp(P_LONG,
    "Dieser Wasserelf sieht recht traurig aus und er murmelt stetig leise "
    "fremdartige Woerter vor sich her, seine Augen sind blaugruen und wirken "
    "trueb, es muss ihn wirklich sehr getroffen haben, dass er seine Familie "
    "nicht wieder finden kann.");
  SetProp(P_NAME, "Nuincorion");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "suchende", "nuincorion", "corion", "nuin", "HIRICORION" }) );
  AddId("Speerkaempfer"); 

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 212 );
  SetProp(P_RACE, "Wasserelf");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt fluesternd herein");
  SetProp(P_MMSGOUT, "fluestert leise vor sich hin und geht seines Weges");
  
  SetProp(P_MNPC_AREA, ( {ROOM "insel", ROOM "insel2", ROOM "insel3",
                          ROOM "insel4",ROOM "insel6", ROOM "insel7",
                          ROOM "inselx",ROOM "insel5", ROOM "insel9",
                          ROOM "steg", ROOM "insel8"}));//sagt dem npc welche raeume er ablaufen darf
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));//sagt dem npc in welchen abstaenden er weiter gehen darf
  SetProp(P_MNPC_DEFAULTROOM, ROOM "insel");//startraum
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);//sagt raeume er darf, sprich, aussen,innen usw 




  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann ertrinkst Du in meinen Traenen!");
  SetProp(P_KILL_NAME, "Nuincorion");
  SetProp(P_KILL_MSG, "Du hattest keine Chance, Baby!");

  AddDetail( ({ "wasserelf", "elf"}),
    "Dieser Wasserelf traegt den wunderschoenen Namen Nuincorion.");
  AddDetail( ({ "woerter"}),
    "Du verstehst nicht was Nuincorion da immer wieder in dieser "
    "fremden Sprache spricht.");
  AddDetail( ({ "sprache"}),
    "Es ist bestimmt die Sprache aus Nuincorions`s Heimat.");
  AddDetail( ({ "heimat"}),
    "So wie es aussieht, weis Nuincorion nicht wie er in "
    "seine Heimat kommen kann.");
  AddDetail( ({ "augen"}),
    "Die Augen von Nuincorion sind blaugruen, aber sie sind trueb, "
    "es ist keine Freude in ihnen zu sehen.");
  AddDetail( ({ "familie"}),
    "Nuincorions ist fuer ihn unauffindbar, es muss hart sein, "
    "die eigene Familie zu verlieren.");
 


  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich aus einem Tropfen Wasser erschaffen.",
		  "sagt: ");

  AddInfo( ({"familie"}),
    "Ich kann sie nicht finden, wo ist nur meine Familie, "
    "was hat Tarabas ihnen angetan.?",
    "sagt: ");
    
  AddInfo( ({"tarabas"}),
    "Ein maechtiger Zauberer, der in den tiefen des Meeres herrscht, "
    "er ist schuld, dass ich hier wandeln muss auf ewiger Suche.",
    "sagt: ");

  AddInfo( ({"zauberer"}),
    "Tarabas ist ein maechtiger Zauberer, er lebt in den tiefen des "
    "Meeres.",
    "sagt: ");
  

  AddInfo( ({"ravenie"}),
    "Ravenie ist eine gute Freundin von mir. Sie lebt hier bei den "
    "Oleanderbueschen.",
    "sagt: ");

  AddInfo( ({"freundin"}),
    "Ravenie ist eine gute Freundin von mir.",
    "sagt: ");
  
  AddInfo( ({"oleanderbueschen","oleander","bueschen","oleanderbuesche"}),
    "In der naehe des Brunnen sind Oleanderbuesche zu finden.",
    "sagt: ");

  AddInfo( ({"brunnen"}),
    "In der naehe des Brunnen, findest Du Oleanderbuesche und auch "
    "meine Freundin Ravenie.",
    "sagt: ");
   

  

  SetProp(P_LOG_INFO, "hiri/inselversteck.log");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Nuincorion will Deine Sachen nicht tragen.\n" }) );
    
  AddSpell(1,500, 
     "Nuincorion schmettert eine Sintflut aus Traenen auf Dich.\n",
     "Nuincorion zerschmettert @WEM mit der Macht der Traurigkeit .\n");



  SetChats(3, ({
    "Nuincorion fluestert leise vor sich hin.\n",
    "Nuincorion fluestert etwas ueber einen boesen Zauberer.\n",
    "Nuincorion spricht immer wieder von seiner verlorenen Familie.\n"}) );
  SetAttackChats(10, ({
    "Nuincorion ueberrollt Dich mit seiner Traurigkeit.\n",
    "Nuincorion zerreisst Dich durch seine Trauer stark.\n"}) );
//nachfolgend wird bestimmt was npc tragen soll(entweder eigenprogrammierte 
//waffen oder ruestungen oder schon vorhandene 
  SUID;
  CLONEME(WEAPON "dreispitz" );
  command("zuecke waffe");
  CLONEME(ARMOUR "algenguertel" );
  CLONEME(ARMOUR "schuppenhose" );
  CLONEME(ARMOUR "maennerstring");
  CLONEME(ARMOUR "seidenhemd");
  command("trage alles");
  command("zuecke dreispitz");
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Nuincorion.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Nuincorion hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

 int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "fluestert leise ein paar verwuenschungen auf Dich.",
        "verwuenscht dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert leise ueber Dich.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schnippt Dir einen Strahl Wasser ins Gesicht.",
        "schnippt einen Wasserstrahl in Dein Gesicht.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich zaertlich zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das ihm das sehr gefaellt.",
        "fluestert das ihm das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Nuincorion getroestet.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}
