
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Liebe Biene Ravenie");
  SetProp(P_LONG,
    "Das ist Ravenie, eine kleine lustige freundliche Biene, sie schwirrt um "
    "die herrlich duftenden Blueten der bunten Blumen und Straeucher. "
    "Aber hab acht, sie kann bestimmt auch mit ihrem Stachel zustechen.");
  SetProp(P_NAME, "Ravenie");
  SetProp(P_GENDER,  FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"biene","ravenie"}));

  create_default_npc(6);
  SetProp(P_HANDS, ({" mit ihrem Stachel" , 50, DT_RIP }) );
  SetProp(P_SIZE, 2 );
  SetProp(P_RACE, "Biene");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MMSGIN, "summt freundlich herein");
  SetProp(P_MMSGOUT, "summt ihr lustiges Lied und fliegt davon");
  SetProp(P_DIE_MSG,  " summt ein letzes mal und flattert in das Reich der Toten Bienen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste mal ist mein Stachel voll Gift!");
  SetProp(P_KILL_NAME, "Ravenie");
  SetProp(P_KILL_MSG, "Du laesst Dich ja sogar von einer Biene killen, MUAHAHA!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich erschaffen.","sagt: ");

  AddInfo( ({"nuincorion","corion"}),
    "Nuincorion ist mein bester Freund, hast Du ihn gesehen?",
    "summt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ravenie will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Die liebe Biene summt.\n",
    "Die Biene summtdisummt um Deinen Kopf.\n"}) );
  SetAttackChats(10, ({
    "Ravenie stoesst ihren Stachel in Deine Nase.\n"}) );
}





