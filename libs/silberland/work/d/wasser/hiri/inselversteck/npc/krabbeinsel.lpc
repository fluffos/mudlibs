
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Krabbe");
  SetProp(P_LONG,
    "Diese Krabbe ist eigentlich nicht besonders gefaehrlich, aber "
    "sie kann boese mit ihren Scheren zwicken. Mit eben diesen Scheren "
    "spielt sie staendig lustige Lieder. Du kannst ja mal der Melodie "
    "ihrer Lieder lauschen.");
  SetProp(P_NAME, "Krabbe");
  SetProp(P_GENDER,  FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "krabbe","HIRIKRABBE"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit ihren Scheren" ,60 , DT_RIP }) );
  SetProp(P_SIZE, 40 );
  SetProp(P_RACE, "Krabbe");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MMSGIN, "erscheint und spielt ein lustiges Lied mit ihren Scheren");
  SetProp(P_MMSGOUT, "spielt ein Lied mit ihren Scheren und verschwindet ");
  SetProp(P_DIE_MSG,  " spielt sich selbst den Todesmarsch und stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "klappert mit den Scheren und faengt an zu weinen, GEMEIN, GEMEIN!");
  SetProp(P_KILL_NAME, "Krabbe");
  SetProp(P_KILL_MSG, "Klappert mit ihren Scheren das Lied vom Tod und grinst Dich an!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich erschaffen.","klappert: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Krabbe will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Die Krabbe schaut Dich komisch an.\n",
    "Die Krabbe klappert vertraeumt eine lustige Melodie.\n"}) );
  SetAttackChats(10, ({
    "Die Krabbe wackelt mit den Beinen und zwickt Dich in Dein Bein.\n"}) );

}

