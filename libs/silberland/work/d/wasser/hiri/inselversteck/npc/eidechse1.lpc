
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Eidechse");
  SetProp(P_LONG,
    "Eine rotgestreifte Eidechse mit kleinen fast lilanen Punkten, "
    "so eine hast Du noch nie gesehn. Sie hat einen messerscharfen Schwanz.");
  SetProp(P_NAME, "Eidechse");
  SetProp(P_GENDER,  FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"eidechse", "echse"}));

  create_default_npc(7);
  SetProp(P_HANDS, ({" mit ihren Beinchen" , 60, DT_RIP }) );
  SetProp(P_SIZE, 35 );
  SetProp(P_RACE, "Echse");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MMSGIN, "flitzt geschwind herein");
  SetProp(P_MMSGOUT, "flitzt hastig von dannen");
  SetProp(P_DIE_MSG,  " flitzt das letzte mal und stirbt einen unwuerdigen Tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Pass up Du, das hast de nit umsonst jemacht!");
  SetProp(P_KILL_NAME, "Killer-NPC");
  SetProp(P_KILL_MSG, "Da lachen ja die Huehner, geh mit Puppen spielen!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Eidechse will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Die Eidechse zuengelt.\n",
    "Die Eidechse beisst Dich mit ihren Zaehnchen.\n"}) );
  SetAttackChats(10, ({
    "Die Eidechse haut Dir mit dem Schwanz gegen Dein Bein.\n"}) );
}

