//erstellt im Februar 03 von hiri
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kuschelino das Kuschelmonster");
  SetProp(P_LONG,
    "Kuschelino ist ein sehr nettes Kuschelmonster, bis auf die Tatsache, "
    "dass es Dich nicht weiter gehen laesst, Er ist im allgemeinen wirklich "
    "sehr lieb, nur wird er zickig wenn Du versuchst an ihm vorbei zu kommen.");
  SetProp(P_NAME, "Kuschelino");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  
  AddId(({ "kuschelino", "lino", "HIRILINO" }));
  AddId("Peitschenkaempfer"); 
  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Kuschelhaenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 162 );
  SetProp(P_RACE, "Kuschelino");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);

  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "kuschelt sich herein");
  SetProp(P_MSGOUT, "kuschelt sich weg");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " kuschelt sich ein letzes mal an Dich und stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste Mal %s, kuschel ich Dich um.");

  SetProp(P_KILL_NAME, "Kuschelino");
  SetProp(P_KILL_MSG, "Du hattest keine Chance, Baby!");

  AddInfo(DEFAULT_INFO, "moechte lieber kuscheln, als von Dir so "
                        "dumme Sachen gefragt zu werden.\n");
  AddInfo("hiri",
    "Wenn es Hiri nicht gaebe, wuerde es mich auch nicht geben.","sagt: ");
  AddInfo( ({"kuschelino","lino"}),
    "Ich bin Kuschelino und es gibt fuer mich nichts schoeneres als kuscheln.",
    "sagt: ");
  AddInfo( ({"familie"}),
    "Ja, meine Familie hat sich hier in der Naehe niedergelassen. "
    "Es ist nicht weit von hier.",
    "sagt: ");
  AddInfo( ({"libella", "bella"}),
    "Mit Libella wuerde ich ueberall hingehen, um zu kuscheln.",
    "schwaermt: ");
  AddInfo( ({ "kuscheln"}),
    "Meine allerliebste Beschaeftigung ist Kuscheln, leider bin ich immer alleine.",
    "seufzt: ");
  AddInfo( ({ "rage"}),
    "Rage ist der liebste Gockel, den es gibt, und der Papi von Hiri.",
    "sagt: ");
  AddInfo( ({ "barriere" }),
    "Die Barriere wirst Du so nicht passieren koennen, aber vielleicht kannst Du "
    "mich ja auch danach fragen und ich helfe Dir. Wenn Du den Weg weiter gehen "
    "moechtest, kannst Du versuchen mich zu toeten, oder Du erweist mir einen "
    "kleinen Gefallen. Wie es Dir gerade beliebt.",
    "sagt: ");
  AddInfo( ({ "gefallen" }),
    "Also, wenn Du aufmerksam warst, weisst Du was ich am liebsten habe und wenn "
    "Du mir kuscheligerweise diesen Gefallen tust , bekommst Du etwas von mir.",
    "sagt: ");
  AddInfo( ({ "weg"}),
    "Der Weg, fuehrt entweder die Klippen herunter oder nach Suedosten. ",
    "sagt: ");
  SetProp(P_LOG_INFO, "hiri/inselversteck.log");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Kuschelino will Deine Sachen nicht tragen.\n" }) );

  AddSpell(1,500,
     "Kuschelino schmettert eine Kuschelattacke auf Dich.\n",
     "Kuschelino zerschmettert @WEM mit einer Kuschelattacke.\n");


  SetChats(3, ({
    "Kuschelino moechte kuscheln.\n",
    "Kuschelino kuschelt Dich.\n"}) );
  SetAttackChats(10, ({
    "Kuschelino kuschelt Dich beinahe zu Tode.\n",
    "Kuschelino zerreisst Dich mit der Kraft des Kuschelns.\n"}) );



  SUID;
  CLONEME(WEAPON "algenpeitsche" );
  command("zuecke algenpeitsche");
  if (random(100)>80) CLONEME(ARMOUR "monsterfell" );
  command("trage monsterfell");

}




void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Kuschelino.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Kuschelino hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}




void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  object perle;

  perle = present("\nHIRIPERLE", TP);
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "nimmt Dich beruhigend in den Arm.",
        TP->Name(WER)+" wird von Kuschelino beruhigend in den Arm genommen.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "knurrt Dich ziemlich wuetend an.",
        "knurrt wuetend.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "lacht laut ueber Dich.",
        "lacht laut auf.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "haut Dich ziemlich unkuschelig zurueck.",
        "haut ziemlich unkuschelig zurueck.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich boese an.",
        "faucht boese zurueck.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich freundlich an.",
        "laechelt freundlich.");
      break;
    case "intim":
    {
      if ( verb == "kuschel" )
      {
        if ( !perle )
        {
          perle = clone_object( OBJ "nabelperle" );
          perle -> move(TP,M_NOCHECK);
          write(
            "Kuschelino ueberreicht Dir, weil Du ihn so lieb kuschelst, "
            "eine kleine Perle.\n" );
          tell_room( ENV(TP),
            TPN+" hat von Kuschelino etwas bekommen.\n", ({ TP }) );
        }
        call_out("reaction", 0, TP,
          "gefaellt es sehr, dass Du ihn kuschelst.",
          "gefaellt, dass er gekuschelt wird.");
        break;
       }
        call_out("reaction", 0, TP,
          "gefaellt es sehr, dass Du ihn kuschelst.",
          "gefaellt, dass er gekuschelt wird.");
        break;
    }
    case "nett":
      call_out("reaction", 0, TP,
        "grunzt leise vor sich hin.",
        "grunzt leise vor sich hin.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "belastet das aber ueberhaupt nicht.",
        "belastet das aber ueberhaupt nicht.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Kuschelino getroestet.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
