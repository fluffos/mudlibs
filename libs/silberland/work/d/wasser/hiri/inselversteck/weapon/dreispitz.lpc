//erstellt am 04.03.03 von hiri
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Dreispitz");
  SetProp(P_LONG,  
    "Der Dreispitz ist ein Speer mit dem Nuincorion wohl Fische faengt, "
    "er ist mit drei spitzen Zacken versehen die oben wie kleine "
    "Speerspitzen aussehen. Der Stiel ist aus einem seltsam blaugruen "
    "schimmernden Holz gemacht und die Zacken leuchten auch in dieser "
    "Farbe. Die Zacken sind aus einem Dir unbekannten Material geschmiedet.");
  SetProp(P_NAME, "Dreispitz");
  SetProp(P_GENDER, MALE);
  AddId( ({"dreispitz"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 200);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":170, "Speermeister":240]) );
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:30, MAT_MISC_TROPICAL_WOOD:70]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 1200);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:5]) );  

  AddDetail( ({"speer"}),
    "Diesen Speer benutzt Nuincorion um Fische zu fangen, aber er wuerde sich "
    "damit auch wehren.");
  AddDetail( ({ "zacken"}),
    "Die Zacken sind aus einem seltenen unbekannten Material und an den Stiel "
    "befestigt. Sie sind auch sehr sehr spitz.");
  AddDetail( ({ "stiel"}),
    "Der Stiel ist recht lang und aus Holz gefertigt.");
  AddDetail( ({ "holz"}),
    "Das Holz schimmert in einem seltsamen blaugruen, aber es muss ein sehr "
    "seltenes Holz sein."); 
  
}

