inherit "std/weapon";

#include "../def.h"
#include <properties.h>

void create()
{
  
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein altes Gebiss");
  SetProp(P_LONG, 
    "Dieses Gebiss ist eklig quittegelb und stinkt.");
  SetProp(P_NAME, "Gebiss");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"gebiss"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_IVORY:100,  ]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 40);                                            
}

