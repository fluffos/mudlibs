//erstellt am 05.03.03 von hiri
inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Algenpeitsche");
  SetProp(P_LONG,
    "Die Peitsche besteht aus festen Algenflechten und der Griff ist aus "
    "Kork und mit einem Oktarin versehen.");
  SetProp(P_NAME, "Algenpeitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"algenpeitsche", "peitsche", "HIRIPEITSCHE"}) );

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 111);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS, (["Peitschenkaempfer":50, "Peitschenexperte":150,
      "Peitschenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_WHIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL :60, MAT_CORK : 20, MAT_OCTARINE :20 ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 700);
  SetProp(P_SIZE, 200);
  SetProp(P_QUALITY_DECAY, 80);
}

