#include "../def.h"

inherit "std/room";

int blume_vorhanden;

void create()
{
::create();

  blume_vorhanden = random(3);

  SetProp( P_INT_SHORT, "Bei einer Huette, die auf der Insel steht." );
  SetProp( P_INT_LONG,
    "Eine kleine Huette steht hier und es sieht doch etwas bewohnter aus "
    "als auf anderen Teilen der Insel. Hinter der Huette stehen vier "
    "Palmen, die die Huette praktisch umgeben. Vor der Huette ist ein "
    "Rasen, auf dem wunderschoene Blumen wachsen. Sand kannst Du hier "
    "kaum finden, nur hinter der Huette, wo die Palmen stehen, "
    "siehst Du etwas Sand.");

SetProp( P_LIGHT, 1 );
SetProp( P_INDOORS, 0);
SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "blumen" }),
    "Du erkennst Veilchen, Orchideen und andere wunderschoene Blumen.");
  AddDetail( ({ "orchideen" }),
    "Die Orchideen leuchten in den schoensten Farben und stroemen einen "
    "feinen Duft aus.");
  AddDetail( ({ "duft" }),
    "Die Orchideen und Veilchen verstroemen diesen herrlichen Duft.");
  AddDetail( ({ "veilchen" }),
    "Die Veilchen leuchten in der Sonne und duften herrlich.");
  AddDetail( ({ "farben" }),
    "Die Farben der Blumen leuchten herrlich.");
  AddDetail( ({ "sonne" }),
    "Die Sonne laesst ihre Strahlen heiss auf die Insel herab scheinen.");
  AddDetail( ({ "strahlen" }),
    "Die Strahlen der Sonne, lassen die Blumen wachsen und gedeihen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit einem Rasen bedeckt und hinter der Huette sieht man "
    "etwas Sand.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist wolkenlos und strahlend blau.");
  AddDetail( ({ "huette" }),
    "Die Huette, die Du hier siehst, ist abgeschlossen und die Tuere ist aus Holzbrettern "
    "gebaut, wie die ganze Huette. An jeder Seite sind grosse Fenster und ein Dach, "
    "das blaugruen schimmert.");
  AddDetail( ({ "tuer", "tuere"}),
    "Du koenntest vielleicht doch mal an der Tuer ruetteln.");
  AddDetail( ({ "dach" }),
    "Das Dach der Huette ist mit Algen bedeckt und schimmert magisch in "
    "der Sonne.");
  AddDetail( ({ "algen" }),
    "Die Algen auf dem Dach der Huette sind magisch zusammengehalten und "
    "kommen aus den Tiefen des Meeres.");
  AddDetail( ({ "tiefen" }),
    "Aus den Tiefen des Meeres sind die Algen auf dem Dach der Huette.");
  AddDetail( ({ "meeres", "meer" }),
    "Aus den Tiefen des Meeres sind die Algen auf dem Dach.");
  AddDetail( ({ "fenster"}),
    "Die Fenster der Huette sind leicht verziert und sehr sauber. Man kann "
    "die feinen Gardinen hinter den Scheiben erkennen.");
  AddDetail( ({ "gardinen"}),
    "Die Gardinen schimmern auch in diesem seltsammen Blaugruen.");
  AddDetail( ({ "blaugruen"}),
    "Blaugruen, schimmern die Gardinen, hinter den Scheiben der Fenster.");
  AddDetail( ({ "scheiben"}),
    "Die Scheiben der Fenster sind sauber geputzt.");
  AddDetail( ({ "holzbrettern", "holzbretter", "brettern", "bretter"}),
    "Aus stabilen Holzbrettern wurde die kleine Huette ordentlich "
    "zusammen gebaut.");
  AddDetail( ({ "seite"}),
    "An jeder Seite der Huette sind grosse Fenster eingebaut.");  
  AddDetail( ({ "insel"}),
    "Wie es scheint, bist Du nun mittig von der Insel.");
  AddDetail( ({"palmen"}),
    "Hinter der Huette stehen vier hohe kraeftige Palmen.");
  AddDetail( ({ "rasen"}),
    "Der Rasen ist direkt vor der Huette niedrig geschnitten, "
    "ansonsten fast kniehoch wie die Blumen.");
  AddDetail( ({ "sand"}),
    "Nur hinter der Huette kannst Du etwas Sand sehen.");  
  AddDetail( ({ "teilen"}),
    "Auf den anderen Teilen der Insel sieht es nicht so bewohnt aus.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst hier nur sehr schwach die Geraeusche des Meeres.");

  AddSound( ({ "geraeusche" }),
    "Die Geraeusche die Du hoerst, stammen bestimmt, von dem "
    "nicht weit entfernten Meer.");
  AddSound( ({ "meer"}),
    "Du kannst das Meer und seine Geraeusche hoeren.");
  AddSmell( DEFAULT_SMELL,
    "Du kannst den Duft der Orchideen und Veilchen riechen.");

  AddSmell( ({ "orchideen" }),
    "Die Orchideen riechen wirklich sehr gut.");
  AddSmell( ({ "veilchen"}),
    "Die Veilchen riechen nicht so stark wie die Orchideen.");

  
    AddItem(NPC "biene", REFRESH_DESTRUCT);

  
    AddExit( "westen", ROOM "inselx" );
    AddExit( "osten", ROOM "insel6" );

  


AddCmd ( ({"pflueck", "pfluecke", "pfluecken"}), "pfluecken");
AddCmd ( ({"ruettel", "ruetteln", "ruettle"}), "ruettel");
}

int ruettel(string str)
{
   notify_fail("Wo moechtest Du dran ruetteln?\n");
   if ( member( ({ "an tuer","an der tuer", "tuer", "an der tuere", "tuere" }),str) != -1) 
  {
    write(BS( "Du nimmst den Knauf der Tuere und ruettelst kraeftig an ihr. "
           "Ploetzlich gibt sie nach und oeffnet sich. Du erschrickst, als "
           "sich vor Dir ein Schatten aufbaut, und voller Erwartung, was er "
           "nun machen wird, bleibst Du stehen."));
    say(BS( TPN+" versucht, die Tuere durch Ruetteln zu oeffnen "
             "und bleibt ploetzlich wie angewurzelt stehen."));
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",10);
    return 1;
  }
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du blickst den Schatten an, der Dich aus boesen Augen anfunkelt "
         "und Dich fragt, was Du hier willst, wartest aber weiter auf das, was "
         "der Schatten noch zu sagen hat."));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (BS( "Als Du dann hoerst, wie der Schatten bruellt: Du Wurm, scher Dich hier "
          "weg, hier kommst Du noch nicht rein, und die Tuer zuschlaegt, stockt Dir "
          "der Atem und Du beschliesst, die Tuere einfach Tuere sein zu lassen."));
          
          
} 
int pfluecken(string str)
{
  object blume;

  notify_fail("Was moechtest Du denn pfluecken?\n");
  
  if ( !blume_vorhanden )
  {
    write( BS(
      "Es sind nur mehr wenige Veilchen da, deshalb siehst Du davon ab, "
      "eines davon zu pfluecken.") );
    return -1;
  }
  if ( member( ({ "veilchen", "blume"}),str) != -1)
  {
    blume = clone_object("/d/huegelland/feyaria/weg/obj/blume");
    blume_vorhanden = 0;
    if ( ME_TOO_HEAVY==blume->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Du Pflueckst die Blume und findest sie wirklich wunderschoen.\n");
      blume->move(TO,M_NOCHECK);
      return 1;
    }
    write( BS(
      "Du hast die Blume gepflueckt und steckst sie Dir ein, vieilleicht schenkst Du sie "
      "jemandem den Du gerne magst.") );
    say(
      TPN+" pflueckt die Blume und steckt sie ein.\n");
    return 1;
  }
}

void reset()
{
  ::reset();

  blume_vorhanden = random(3);
}
