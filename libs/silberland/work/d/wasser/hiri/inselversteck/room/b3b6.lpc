
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int wieselda;

create() {
  ::create();

  wieselda=1;

  SetProp( P_INT_SHORT, "Auf einer Landstrasse" );
  SetProp( P_INT_LONG,
    "Die Landstrasse macht hier eine kleine Biegung von Norden nach Osten. "
    "Im Norden fuehrt sie einen kleinen Huegel hinauf und im Osten fuehrt "
    "sie geradewegs durch die Graslandschaft weiter. Am Wegesrand ist dichtes "
    "Buschwerk zu erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddSpecialDetail( ({ "buschwerk","werk" }),
    "det_buschwerk");

  AddSpecialDetail( ({ "glitzern"}),
    "det_glitzern");

  AddDetail( ({ "boden" }),
    "Auf dem Boden ist irgendwie eine zweite Strasse zu erkennen. Du gruebelst "
    "und siehst tatsaechlich winzige Spuren dort.");

  AddDetail( ({ "spuren","spur" }),
    "Die Spuren scheinen von vielen tausenden von Ameisen zu stammen. Sie "
    "haben ihre Strasse direkt ueber die Landstrasse gelegt. Es wuseln "
    "tausende von ihnen darueber hinweg. Du versuchst sie nicht zu stoeren.");

  AddDetail( ({ "himmel","sonne" }),
    "Die Sonne steht hoch am Himmel.");

  AddDetail( ({ "ameisen","ameise" }),
    "Die Ameisen laufen fleissig ueber die Landstrasse und bilden so ihre "
    "eigene Strasse.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Landstrasse fuehrt hier um eine Biegung herum.");

  AddDetail( ({ "biegung" }),
    "Die Biegung fuehrt die Strasse von Norden nach Osten weiter. Aber sie "
    "ist nicht sehr stark, so dass auch groessere Wagen problemlos passieren "
    "koennen.");

  AddDetail( ({ "wagen" }),
    "Derzeit ist hier kein Wagen unterwegs. So hast Du genug Platz.");

  AddDetail( ({ "platz" }),
    "Der Platz ist wirklich mehr als ausreichend.");

  AddDetail( ({ "huegel" }),
    "Im Norden kannst Du einen kleinen Huegel erkennen. Die Strasse scheint "
    "direkt ueber den Huegel zu fuehren.");

  AddDetail( ({ "gras" }),
    "Das Gras waechst ueberall um Dich herum.");

  AddDetail( ({ "graslandschaft","landschaft" }),
    "Die Landschaft um Dich herum aendert sich nur wenig. Bis auf den Huegel "
    "im Norden sieht es ueberall gleich aus.");

  AddDetail( ({ "wegesrand","rand","strassenrand" }),
    "Der Wegesrand ist durch viele grosse Steine stark von der Strasse "
    "getrennt worden. Ein grosses Buschwerk ist im Sueden abseits der "
    "Strasse.");

  AddDetail( ({ "steine","stein" }),
    "Die grossen Steine wurden nicht geschlagen, sondern einfach nur an den "
    "Wegesrand gelegt um die Strasse zu begrenzen.");

  AddDetail( ({ "tiere","tier" }),
    "So direkt sehen kannst Du keine Tiere.");

  AddSound( DEFAULT_SOUND,
    "Es raschelt im Buschwerk ziemlich stark.");

  AddSound( ({"buschwerk","rascheln"}) ,
    "Aus dem Buschwerk ist lautes Rascheln zu hoeren. Sicher verstecken "
    "sich dort ein paar Tiere.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Gras.");

  AddSmell( "gras",
    "Das Gras riecht sehr frisch!");

  AddExit( "nordwesten", "./b2b5" );
  AddExit( "osten",      "./b3b7" );

  AddCmd( ({ "scheuch","scheuche" }), "scheuchfkt" );
  AddCmd(  ({ "zwaeng", "zwaenge" }), "zwaenge"  );
}

string det_buschwerk()
{
  if (wieselda)
    return break_string(
      "Im Buschwerk scheint sich etwas zu verstecken. Vielleicht kannst "
      "Du es aufscheuchen?");
  else
    return break_string(
      "Durch das Buschwerk kannst Du hin und wieder ein seltsames "
      "Glitzern erkennen.");
}

string det_glitzern()
{
  if (!wieselda)
  {
    return break_string(
      "Das Glitzern siehst Du ab und zu durch das Buschwerk und vielleicht "
      "kann man sich ja durchzwaengen.");
  }
  return 0;
}

reset() {
  ::reset();
  if(!present("\n_wiesel",ME)) wieselda=1;
}

int scheuchfkt(string str) {
  object ob;
  notify_fail("Was willst Du aufscheuchen?\n");
  if(str != "etwas" && str != "etwas auf" && str != "es" && str != "es auf" &&
     str != "buschwerk" && str != "buschwerk auf" && str != "tier" &&
     str != "tier auf")
    return 0;
  if(wieselda != 1) {
    write(BS(
      "Wie ein Wilder fuchtelst Du in dem Buschwerk herum. Doch Du schaffst "
      "es irgendwie nicht, etwas aufzuscheuchen."));
    say(BS(
      CAP_TPN+" fuchtelt wie wild in dem Buschwerk herum und gibt dann "
      "enttaeuscht auf."));
    return 1;
  }
  wieselda=0;
  write(BS(
    "Du fuchtelst wie wild in dem Buschwerk herum. Auf einmal schiesst ein "
    "kleines Wiesel hervor und Du siehst auch kurz etwas hinter dem Buschwerk "
    "glitzern."));
  say(BS(
    CAP_TPN+" scheucht ein kleines Tier aus dem Buschwerk hervor."));
  ob=clone_object( NPC "wiesel" );
  if(ob) {
    ob->move(ME,M_GO);
    ob->Kill(TP);
  }
  return 1;
}

int zwaenge(string str)
{
  notify_fail( "Wo moechtest Du Dich durchzwaengen?\n" );

  if( str == "durch buschwerk" || str == " durch das buschwerk" )
  {
    if( wieselda || present("\n_wiesel",ENV(TP)) )
    {
      write(BS("Das Wiesel hindert Dich daran, Dich durch das Buschwerk zu "
           "zwaengen."));
      say(BS(
        CAP_TPN+" versucht durch das Buschwerk zu kommen aber wird "
        "durch das Wiesel aufgehalten."));
      return 1;
    }
    write(BS("Du zwaengst Dich durch das Buschwerk.\n"));
    TP->move("/d/wasser/hiri/inselversteck/room/stueck",
             M_GO, "sich durch das Buschwerk",
             "zwaengt",
             "zwaengt sich durch das Buschwerk herein");
    return 1;
  }
  return 0;
}
