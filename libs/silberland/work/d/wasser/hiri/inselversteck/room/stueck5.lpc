#include "../def.h"

inherit "std/room";



void create()
{
::create();

  SetProp( P_INT_SHORT, "An einem einsamen Strand" );
  SetProp( P_INT_LONG,
    "Nun bist Du endlich an einem wunderschoenen Strand angelangt. Du sieht im "
    "Sand kleine Muscheln liegen und das Wasser umspuelt den Strand seicht. Du "
    "kannst nun auch erkennen, was Dich so erstaunt hat. Eine Bruecke fuehrt ueber "
    "das Meer zu einer Insel. Weiters kannst Du noch ein Stueck Klippenfelsen "
    "in noerdlicher Richtung sehen.");
         
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  
    
  AddDetail( ({ "boden"}),
    "Du sieht haufenweise Sand, wie es an einem Strand eigentlich ueblich ist.");
  AddDetail( ({ "bruecke"}),
    "Die Bruecke scheint aus zwei Haelften zu bestehen.");
  AddDetail( ({ "haelften", "haelfte"}),
    "Die beiden Haelften der Bruecke sind eigentlich identisch.");
  AddDetail( ({ "himmel"}),
    "Der Himmel ist durch nichts getruebt und die Sonne erhitzt den Sand und auch "
    "Dich.");
  AddDetail( ({ "sonne"}),
    "Hier wird es durch die Sonne immer heisser, Abkuehlung koenntest Du aber im "
    "Meer finden.");
  AddDetail( ({ "abkuehlung"}),
    "Wenn Du Dir Abkuehlung verschaffen moechtest geh einfach schwimmen, na, was haelst Du davon?");
  AddDetail( ({ "insel"}),
    "Um auf die Insel zu kommen, musst Du ueber die Bruecke gehen.");
  AddDetail( ({ "meer"}),
    "Das Wasser wird durch die Wellen von dem offenen Meer ueber den Sand gespuehlt.");
  AddDetail( ({ "wellen", "welle"}),
    "Wellen werden hier sanft auf den Strand gespuelt und verlaufen im Sand, es "
    "hoert sich einfach gut an.");  
  AddDetail( ({ "muscheln", "muschel"}),
    "Ueberall am Strand liegen kleine und etwas groessere Muscheln herum. "
    "Sie sind aber nicht weiter interessant, also laesst Du sie liegen.");
  AddDetail( ({ "sand"}),
    "Der Sand ist feinkoernig und glitzert in der Sonne.");
  AddDetail( ({ "strand"}),
    "Es ist einfach zu schoen hier an diesem Strand.");
  AddDetail( ({ "wasser"}),
    "In dem Sand versickert das Wasser oder fliesst wieder zurueck in das Meer.");
  AddDetail( ({"klippenfelsen", "felsen"}),
    "Du siehst in noerdlicher Richtung das Ende der Klippenfelsen. Ein Loch "
    "kannst Du dort auch erkennen. ");
  AddDetail( ({"loch"}),
    "Du kannst bestimmt durch das Loch hindurch schluepfen.");
  AddDetail( ({"ende"}),
    "Am noerdlichen Ende der Klippenfelsen, kannst Du ein Loch erkennen.");
  AddDetail( ({"stueck"}),
    "Noerdlich kannst Du ein paar schroffe Klippenfelsen erkennen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst, wie die Wellen ueber den Sand gespuelt werden.");  
  AddSound( ({ "wellen" }),
    "Es hoert sich toll an, wenn die Wellen ueber den Sand spuelen.");
  AddSmell( DEFAULT_SMELL,
    "Du riechst das Meer und wirst irgendwie ganz ruhig.");
  AddSmell( ({ "meer" }),
    "Das Meer riecht einfach herrlich, hier koenntest Du es aushalten.");
  

  AddExit( "nordoben", ROOM "stueck4" );
  AddExit( "sueden", ROOM "bruecke" );


   AddCmd( ({"schwimm", "schwimme" }), "schwimmen" );
   AddCmd( ({"schluepfe","schluepf"}), "schluepfen"); 
}


int schluepfen(string str)
{  
   notify_fail( "Wo moechtest Du denn durch schluepfen?\n" );
   if( str == "durch loch" || str == "durch das loch" )    
  {  
     write(BS("Du schluepfst durch das Loch.\n"));
     TP->move(ROOM "hoehle", M_GO, "schluepft durch das Loch", "schluepft",
     "kommt durch das Loch geschluepft");
     return 1;
  }
  return 0;

}

int IsWaffe(object was) 
{ 
  if (was->QueryProp(P_WIELDED)) return 1; 
  return 0; 
}

void ablegen(object was)
{
  if (objectp(was)) was->DoUnwield(1);
}

int schwimmen(string str)
{
  mixed waffe;
  notify_fail("Wo moechtest Du schwimmen?\n");
  if ( member( ({ "wasser", "meer", "in meer", "in wasser" }),str) != -1) 
  {
    PL->command_me("ziehe alles aus");
    map_array(filter_array(all_inventory(PL),#'IsWaffe),#'ablegen);
    
    write( BS( "Du ziehst Dich aus, wirfst Deine Sachen wahllos weg und steckst Deine Waffe zurueck, nur um "
               "schnell Abkuehlung durch das Wasser zu bekommen."));
    say( TPN+" springt voellig nackt in das Wasser um endlich Abkuehlung zu finden.\n");
    return 1;
  }
}  

