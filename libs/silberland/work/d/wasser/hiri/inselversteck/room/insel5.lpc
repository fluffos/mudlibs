//fertig am 02.03.2003 von Hiri


#include "../def.h"

inherit "std/room";

void create()
{
::create();

  SetProp( P_INT_SHORT, "An einem feuchten Strand" );
  SetProp( P_INT_LONG,
    "An diesem Strandstueck ist es nicht ganz so trocken und der Sand "
    "ist sehr feucht. Dir faellt auf, dass hier auch viel mehr Gras waechst "
    "und auch ein paar Buesche stehen hier herum. In einem der Buesche "
    "flattert eine alte Zeltplane , wenn ein leichter Wind ueber die Insel weht.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist hier feuchter und der Sand wirkt matschig.");
  AddDetail( ({ "buesche", "busch"}),
    "Die Busche, die hier stehen, sind wohl als Oleander zu benennen, "
    "die Blueten sind blassrosa und die Blaetter sind gruen und ledrig. "
    "In einem der Buesche haengt eine alte Zeltplane.");
  AddDetail( ({ "blaetter"}),
    "Die Blaetter der Buesche fuehlen sich ledrig an.");
  AddDetail( ({ "blueten", "bluete"}),
    "Blassrosa leuchten die Blueten der Buesche und verstroemen "
    "einen lieblichen Duft.");
  AddDetail( ({"duft"}),
    "Der Duft von dem Oleander ist einfach herrlich lieblich, Du kannst  ja mal riechen.");
  AddDetail( ({"oleander"}),
    "Fuer den Oleander ist hier der ideale Platz, um wachsen zu koennen.");
  AddDetail( ({"platz"}),
    "Der ideale Platz fuer den Oleander, ist feucht und sonnig.");
  AddDetail( ({ "zeltplane", "plane"}),
    "Die Zeltplane muss schon lange in den Bueschen haengen, sie ist "
    "zerfetzt, aber Du kannst deutlich einen Schriftzug an erkennen.");
  AddDetail( ({ "schriftzug", "schrift" }),
    "Der Schriftzug laesst Dich erkennen, wem das Zelt gehoerte.");
  AddDetail( ({ "zelt" }),
    "Das Zelt ist laut Schriftzug.....vielleicht solltest Du den "
    "Schriftzug mal lesen.");
  AddDetail( ({ "dieb" }),
    "Du weisst doch, wo man einen Dieb findet.");
  AddDetail( ({ "vogelfreier", "freier","vogelfreien" }),
    "Die Vogelfreien lassen wohl ueberall ihren Muell liegen.");
  AddDetail( ({ "muell" }),
    "Hier ist nur das zerfetzte Zelt als Muell zu bezeichnen.");
  AddDetail( ({ "gras" }),
    "Aus dem Gras wird hier schon ein kleiner Rasen.");
  AddDetail( ({ "rasen" }),
    "Der Rasen ist hier nicht sonderlich gross.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und wolkenlos.");
  AddDetail( ({ "insel" }),
    "Die Insel hoert hier noch lange nicht auf.");
  AddDetail( ({ "sand" }),
    "Der Sand ist feucht und matschig, ideal fuer den Oleander. Das Meer und "
    "dessen Wasser befeuchten hier den Sand stetig.");
  AddDetail( ({ "wasser"}),
    "Das Wasser wird mit den Wellen auf den Sand gespuelt.");
  AddDetail( ({ "wellen", "welle"}),
    "Die Wellen sind nicht besonders kraeftig, aber es reicht um den Sand zu "
    "befeuchten.");
  AddDetail( ({ "meer"}),
    "Das Meer glitzert und sieht richtig erfrischend aus, schwimmen solltest Du "
    "hier aber nicht.");
  AddDetail( ({ "strandstueck", "strand" }),
    "Du stehst gerade auf einem Strandstueck der Insel.");
  AddDetail( ({ "wind"}),
    "Gerade ist kein Wind zu bemerken.");
  AddDetail( ({ "nase"}),
    "Mit Deiner Nase kannst Du bestimmt etwas riechen, also rieche doch mal.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst hier nur sehr schwach die Geraeusche des Meeres.");
  AddSound( ({ "geraeusche" }),
    "Die Geraeusche die Du hoerst, stammen bestimmt, von dem "
    "nicht weit entfernten Meer.");
  AddSound( ({ "meer"}),
    "Du kannst das Meer und seine Geraeusche hoeren.");
  
  AddSmell( DEFAULT_SMELL,
    "Man kann den Duft des Oleander deutlich riechen, seine Blueten verstroehmen "
    "diesen herrlichen Duft.");

  AddSmell( ({ "duft" }),
    "Der Duft haengt kraeftig in Deiner Nase und ist wirklich sehr lieblich.");
  AddSmell( ({ "blueten" }),  
    "Du riechst an einer der Blueten und Dir steigt ein wunderbarer Duft in "
    "Deine Nase.");
  AddReadDetail(({"schriftzug","schrift"}),
    "Du liest den Schriftzug und dort steht, dass dieses Zelt den "
    "Dieben und Vogelfreien gehoert hat." );


   
    AddExit( "osten", ROOM "inselx" );
    AddExit( "nordosten", ROOM "insel3" );
    AddExit( "suedosten", ROOM "insel9" );

      

}


