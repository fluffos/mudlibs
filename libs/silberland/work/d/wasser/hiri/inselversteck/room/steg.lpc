//erstellt am 09.02.2003 von hiri



#include "../def.h"

inherit "std/room";



void create()
{
::create();


  SetProp( P_INT_SHORT, "Auf einem kleinen Steg" );
  SetProp( P_INT_LONG,
    "Du bist wohl an dem Ende der Insel angelangt, denn Du stehst auf einem "
    "Steg, der etwa sechs Meter weit in das Meer hinein reicht. Links und "
    "rechts von dem Steg liegen kleine Boote, die Du aber nicht betreten "
    "kannst. Oder doch? Ein Boot faellt Dir besonders auf, es sieht aus wie "
    "ein Schwan und ist weiss wie Schnee. ");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist hier der Steg und folglich aus Holz gebaut.");
  AddDetail( ({ "holz" }),
    "Der Steg ist aus Holz gebaut, lange Holzbretter aus Palmenstaemmen.");
  AddDetail( ({ "holzbretter", "bretter"}),
    "Die Holzbretter sind fein zusammen gebaut und ergeben den Steg.");
  AddDetail( ({ "palmenstaemmen", "staemmen"}),
    "Aus Palmenstaemmen, die sehr stabil sind, und die Holzbretter fuer "
    "den Steg bilden.");
  AddDetail( ({ "boot" }),
    "Das Boot, das aussieht wie ein Schwan, faellt Dir besonders auf. Die "
    "anderen Boote sind nicht besonders schoen. Du kannst an dem Boot eine "
    "Beschriftung erkennen die Du lesen kannst.");
  AddDetail( ({ "beschriftung"}),
    "Wenn Du die Beschriftung liest, wirst Du bestimmt mehr wissen als jetzt.");
  AddDetail( ({ "ende" }),
    "Du stehst auf einem Steg und das ist wohl das Ende der Insel.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und reicht bis zum Horizont.");
  AddDetail( ({ "horizont" }),
    "Haettest Du ein Fernglas, koenntest Du vielleicht erkennen, was am "
    "Horizont ist.");
  AddDetail( ({ "fernglas" }),
    "Mit einem Fernglas koenntest Du bestimmt erkennen was am Horizont ist.");
  AddDetail( ({ "insel" }),
    "Hier endet die Insel und Du kannst auf das weite Meer hinaus schauen.");
  AddDetail( ({ "meer" }),
    "Das Meer umspuelt den Steg mit seinen seichten Wellen und Du kannst es auch "
    "riechen und hoeren.");
  AddDetail( ({ "wellen" }),
    "Die Wellen schlagen seicht gegen den Steg.");
  AddDetail( ({ "meter" }),
    "Sechs Meter weit reicht der Steg in das Meer hinein.");
  AddDetail( ({ "schnee"}),
    "Hier siehst Du zwar keinen Schnee aber ein Boot was weiss "
    "wie Schnee ist.");
  AddDetail( ({ "schwan"}),
    "Das weisse Boot sieht aus wie ein grosser Schwan.");
  AddDetail( ({ "steg"}),
    "An dem Steg sind vier Boote fest gemacht und eines sieht aus wie ein Schwan.");
  AddSound( DEFAULT_SOUND,
    "Du kannst hoeren wie das Meer seine Wellen gegen den kleinen Steg schlaegt. "
    "Es hoert sich beruhigend und sanft an. Ausserdem kannst Du leise ein immer "
    "wiederkehrendes Schwappen hoeren, dass stammt bestimmt von den Booten.");  
  AddSound( ({ "wellen"}),
    "Du hoerst wie leise die Wellen gegen den Steg geschlagen werden.");
  AddSound( ({ "schwappen"}),
    "Wenn die Wellen gegen die Boote prallen entsteht dieses schwappende geblubber.");
  AddReadDetail(({"beschriftung","schrift"}),
    "Du liest die Beschriftung und dort steht, das dieses Boot noch nicht fertig gebaut ist "
    "und man noch nicht damit fahren kann, schade, es waere bestimmt schoen damit "
    "auf das Meer zu rudern." );

//   AddItem( "/players/hiri/neptun/transporter/schwanenboot/", REFRESH_DESTRUCT, 1);

    
  AddExit( "westen", ROOM "insel9" );
  AddExit( "osten", ROOM "insel8" );
  

}
