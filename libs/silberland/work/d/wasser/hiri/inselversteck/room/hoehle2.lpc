//erstellt am 07.01.2004 von hiri



#include "../def.h"

inherit "std/room";



void create()
{
::create();

  SetProp( P_INT_SHORT, "In einer tiefen Hoehle" );
  SetProp( P_INT_LONG,
    "Dieser Teil der Hoehle ist erst vor kurzem ausgehoehlt worden, man sieht es "
    "an den frischen abschuerfungen im Gestein. Ueberall liegen heraus geklopfte Steine. "
    "Ein Kuschelmonster richtet sich hier wohl gerade haeuslich ein. Auf dem Boden "
    "liegen Algenblaetter. Sie bilden eine Matratze. Ein paar Kruege stehen an "
    "einer der Waende. Besonders einladend sieht es hier nicht aus.");
         
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"teil"}),
    "In diesem Teil der Hoehle wird noch kraeftig gearbeitet.");
  AddDetail( ({"hoehle"}),
    "Diese Hoehle dient dem Kuschelmonster als Bleibe.");
  AddDetail( ({"bleibe"}),
    "Die Hoehle, ist die Bleibe der Kuschelmonster.");
  AddDetail( ({"kuschelmonster", "monster"}),
    "Die Kuschelmonster, sind gerade dabei sich haeuslich zu einzurichten.");
  AddDetail( ({"gestein"}),
    "Es hat bestimmt eine ganze Weile gedauert bis die Kuschelmonster die "
    "Hoehle ausgebaut hatten.");
  AddDetail( ({"weile"}),
    "Eine ganze Weile werden die Kuschelmonster hier gearbeitet haben.");
  AddDetail( ({"steine"}),
    "Die Steine sind aus dem Gestein gehauen worden, damit eine Hoehle entsteht.");
  AddDetail( ({"boden"}),
    "Auf dem Boden liegen einige Steine und eine Matratze aus Algenblaettern. "
    "An einer Wand der Hoehle stehen auch ein paar Kruege.");
  AddDetail( ({"matratze"}),
    "Die Matratze ist aus Algenblaettern geknuepft und bietet dem Kuschelmonster "
    "eine Schlafgelegenheit.");
  AddDetail( ({"schlafgelegenheit"}),
    "Die Matratze dient dem Kuschelmonster als Schlafgelegenheit.");
  AddDetail( ({"algenblaetter", "blaetter"}),
    "Die Algenblaetter, hat das Kuschelmonster moeglicherweise am Strand "
    "vor der Hoehle gesammelt.");
  AddDetail( ({"strand"}),
    "Du bist vom Strand aus in die Hoehle geschluepft.");
  AddDetail( ({"decke"}),
    "Die Decke ebenfalls aus hartem Gestein."),
  AddDetail( ({"kruege"}),
    "Die Kruege stehen ordendlich am Boden, direkt an einer Wand.");
  AddDetail( ({"waende","wand"}),
    "Waende und Wand ist eigentlich nicht richtig, aber wie sollte man "
    "es sonst beschreiben.*g*");
 
  AddSound( DEFAULT_SOUND,    
    "Aus dem Gang, hoerst Du leise ein paar Geraeusche.");  
  AddSound( ({ "geraeusche" }),
    "Die Geraeusche kommen aus dem hinteren Teil der Hoehle und "
    "sind recht leise.");
  AddSound( ({ "gang"}),
    "Nur leise sind einige Geraeusche zu hoeren.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Tier, nach nassem Fell.");
  AddSmell( ({ "tier" }),
    "Ja, es riecht so gar stark nach Tier.");
  AddSmell( ({ "fell" }),
    "Nasses Fell, baeh, ist ja eklig. Aber das Kuschelmonster arbeitet "
    "schwer, ist wohl normal.");

  
   AddItem(NPC "kuschelpapi", REFRESH_DESTRUCT);   
   
   AddExit( "sueden", ROOM "hoehle" );
   AddExit( "nordunten", ROOM "hoehle3" );
}

