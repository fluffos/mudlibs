#include "../def.h"

inherit "std/room";

//int fackel_vorhanden;

void create()
{
::create();

//fackel_vorhanden = random(1);


  SetProp( P_INT_SHORT, "Bei einem Brunnen, der Insel" );
  SetProp( P_INT_LONG,
    "Dir faellt hier ein kleiner Brunnen auf, der bestimmt zu der "
    "kleinen Huette gehoert. Der Besitzer wird hier Wasser holen, um damit "
    "kochen zu koennen. Ein Weg ist hier mit kleinen Steinen umrandet "
    "und teilt so den Rasen in zwei Haelften. Ein grosses *WARNSCHILD* "
    "wurde hier aufgestellt, und es ist zwingend noetig es zu lesen. ");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "besitzer" }),
    "Der Besitzer der Huette holt hier an dem Brunnen bestimmt sein Trinkwasser.");
  AddDetail( ({ "trinkwasser", "wasser"}),
    "Der Brunnen gibt dem Besitzer bestimmt gutes Trinkwasser.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht hier aus Gras und Kieselsteinen.");
  AddDetail( ({ "gras" }),
    "Der Rasen besteht aus Gras.");
  
//Eine Stelle sieht aber etwas "
//    "unfoermig aus.");
//  AddDetail( ({"stelle"}),
//    "Vielleicht kannst Du an der Stelle einmal im Gras wuehlen?.");
  AddDetail( ({ "kieselsteinen", "kieselstein", "kieselsteine", "steinen", "steine"}),
    "Der Weg ist mit vielen kleinen Kieselsteinen bedeckt und von blaugruenen "
    "Steinen umrandet.");
  AddDetail( ({ "brunnen" }),
    "Das Wasser aus dem Brunnen ist sicherlich erfrischend. An einer Vorrichtung "
    "haengt ein Seil in den Brunnen hinein.");
  AddDetail( ({ "vorrichtung"}),
    "Eine Vorrichtung, wie man sie an vielen Brunnen findet, um einen Eimer zu befestigen "
    "und Wasser aus dem Brunnen zu holen.");
  AddDetail( ({ "seil"}),
    "Wenn Du nach dem Seil greifst, kannst Du ja vielleicht einen Eimer herauf ziehen.");
  AddDetail( ({ "eimer"}),
    "Um an den Eimer zu kommen musst, Du schon nach dem Seil greifen.");
  AddDetail( ({ "haelften" }),
    "Der Rasen wird durch einen Weg in zwei Haelften geteilt.");
  AddDetail( ({ "himmel" }),
    "Am Himmel siehst Du Moewen fliegen und nicht eine Wolke ist zu sehen.");
  AddDetail( ({ "moewen" }),
    "Die Moewen fliegen hoch am Himmel, um jeden Moment in das Meer zu stuerzen.");
  AddDetail( ({ "moment"}),
    "Es sieht so aus, als ob in jedem Moment eine der Moewen, vom Himmel "
    "in das Meer stuerzt, um sich einen Fisch zu fangen.");
  AddDetail( ({ "fisch" }),
    "Einen Fisch oder mehrere fangen sich die Moewen, um satt zu werden.");
  AddDetail( ({ "meer"}),
    "Die Insel ist umgeben von dem Meer, ganz natuerlich, meinst Du nicht?");
  AddDetail( ({ "insel"}),
    "Du stehst an einem fruchtbareren Teil der Insel.");
  AddDetail( ({ "teil"}),
    "Damit ist bestimmt dieser Teil der Insel gemeint.");
  AddDetail( ({ "wolke" }),
    "Die Wolke wirst Du hier nicht finden.");
  AddDetail( ({ "huette" }),
    "Die Huette siehst Du von hier aus zwar, aber um genaueres "
    "erkennen zu koennen, musst Du naeher ran gehen.");
  AddDetail( ({ "rasen" }),
    "Hier ist der Rasen gleichmaessig kurz gehalten.");
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt von der Huette zu dem Brunnen und ist von etwas "
    "groesseren Steinen umrandet und mit feinen Kieselsteinen bedeckt.");
  AddDetail( ({"warnschild"}),
    "Du solltest es lesen. Es koennte Dein Leben retten.");
  AddDetail( ({"leben"}),
    "Wenn Dir Dein Leben lieb ist, lies das Warnschild.");
   AddDetail( ({ "luft"}),
    "Die Luft riecht nach Meer und ist richtig erfrischend.");
  AddDetail( ({ "nase"}),
    "Mit deiner Nase kannst Du riechen, versuch es einmal."); 

 AddSound( DEFAULT_SOUND,
    "Man kann hier die Wellen hoeren und das leise Rieseln, wenn die Wellen "
    "ueber den Sand gespuelt werden. Aus dem Brunnen kommen manchmal seltsame "
    "Geraeusche.");
  AddSound( ({"geraeusche"}),
    "Die Geraeusche die aus dem Brunnen kommen, kannst Du nicht einordnen.");
  AddSound( ({"brunnen"}),
    "Die Geraeusche aus dem Brunnen kannst Du nicht einordnen.");
  AddSound( ({ "rieseln" }),
    "Wenn die Wellen ueber den Sand gespuelt werden, hoert man ein Rieseln.");
  AddSound( ({ "wellen" }),
    "Du hoerst, wie die Wellen sanft ueber den Sand gespuelt werden.");
  AddSound( ({ "sand"}),
    "Du kannst hoeren, wie der Sand leicht gegeneinander reibt, waehrend "
    "die Wellen ueber ihn hinweg gespuelt werden.");
  AddSmell( DEFAULT_SMELL,
    "Du ziehst die Luft durch Deine Nase und kannst das Meer riechen.");
  AddSmell( ({ "meer" }),
    "Die Luft, die Du durch Deine Nase atmest, riecht nach dem Meer "
    "und wirkt erfrischend auf Dich.");

  AddReadDetail( ({"warnschild"}),
		"\n    ~*Betrete den Brunnen erst ab Spielerstufe 25*~  \n"
                "  \n"
                "\n  ~*Bist Du kleiner, solltest Du Dir der Gefahren,*~ \n"
		"  \n"
		"\n     ~*die Dich dort erwarten, bewusst sein.*~  \n"
		"  \n" 
		"\n    ~*Ein Lichtspender waere auch von Vorteil.*~  \n"
		"  \n"
		"\n~*Ein Besuch bei Gevatter Tod ist nicht auszuschliessen.*~   \n"
		"  \n");



  
  AddExit( "westen", ROOM "insel7" );
  AddExit( "osten", ROOM "insel4" );
//alles was jetzt kommt ist funktion greife seil und callout plus paralyzed, erklaert hat ichs dir soweit
//wenn du aber noch fragen hast bitte schoen melden :) und du musst natuerlich ein detail haben damit es geht  
AddCmd( ({"greif", "greife" }), "greifen" );
//AddCmd( ({"durchwuehle" "wuehl", "wuehle" }), "wuehlen" );


}
int greifen(string str)
{
 notify_fail("Was moechtest Du greifen?\n");

 if(!str || str == "") return 0;
 if(!(str=="seil"||
      str=="nach seil"))     
 return 0;
 write(BS( "Du versuchst nach dem Seil zu greifen, das an der Vorrichtung "
           "befestigt ist, um an den Eimer zu kommen verlierst aber das "
           "Gleichgewicht.\n"));
    say( TPN+" greift nach dem Seil am Brunnen und faellt hinein.\n");

 TP->move( "/d/wasser/hasibaerchi/brunnen/room/brunnen_1", M_GO, "faellt");


 return 1;
}

