#include "../def.h"

inherit "std/room";
int flasche_zahl;//musst du unbedingt angeben sonst funtzt ueberhauptnix, genau wie flasche_zahl=1


void create()
{
::create();

  flasche_zahl=1;

  SetProp( P_INT_SHORT, "An einem alten Lagerfeuer" );
  SetProp( P_INT_LONG,
    "Hier sieht es schon wieder etwas rauher aus und ueberall liegen "
    "Flaschen und alte Holzstuecke herum, irgendwie schon seltsam, dass die "
    "Sachen hier alle herum liegen, wo doch bei der Huette und dem "
    "Brunnen alles so sauber ist. Hier sind wohl, vor urlanger Zeit, mal "
    "eine oder mehrere Partys mit Lagerfeuer gefeiert worden. ");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist ueber und ueber mit Sand bedeckt.");
  AddDetail( ({ "sand" }),
    "Der Sand ist fein und Du bemerkst ihn kaum beim Gehen.");
  AddDetail( ({ "gehen" }),
    "Weil der Sand so fein ist, bemerkt man in beim Gehen nicht.");
  AddDetail( ({ "brunnen" }),
    "Westlich von hier ist der kleine Brunnen.");
  AddDetail( ({ "flaschen" }),
    "Also eigendlich kann man das nicht mehr Flaschen nennen, "
    "die Flaschen sind total kaputt, man muss aufpassen, dass man nicht "
    "in eine der kaputten Flaschen tritt. Dir faellt aber doch an einer Flasche "
    "etwas auf, sie ist, bis auf ein kleines Loch, noch recht gut erhalten.");
  AddSpecialDetail( ({ "flasche" }),"detailflasche");//ist zugehoerig zu dem cmd, ohne das ging es in diesem fall nicht
  AddDetail( ({ "loch"}),
    "In der Flasche ist ein kleines Loch, ansonsten ist die Flasche noch gut "
    "erhalten.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und keine Wolke verdunkelt die Sonne.");
  AddDetail( ({"wolke"}),
    "Nicht eine Wolke ist am Himmel zu erkennen.");
  AddDetail( ({"sonne"}),
    "Die Sonne scheint herunter und wird von keiner Wolke verdunkelt.");
  AddDetail( ({ "holzstuecke","stuecke" }),
    "Die Holzstuecke sind teilweise verkohlt und schon richtig alt, "
    "aber man erkennt noch, wofuer sie benutzt worden sind." );
  AddDetail( ({ "huette" }),
    "Westlich von hier ist wohl irgendwo eine Huette.");
  AddDetail( ({ "lagerfeuer", "feuer" }),
    "Vor langer Zeit wird hier ein Lagerfeuer angezuendet worden sein. "
    "Man kann noch den Spiess erkennen auf dem wohl Fische gebraten wurden. "
    "Es ist hier bestimmt immer heiss her gegangen.");
  AddDetail( ({ "partys" }),
    "Auf den Partys war bestimmt immer viel los, wer da wohl gefeiert hat? "
    "Es liegen ueberall noch Reste herum, alte verkohlte Holzstuecke, ein "
    "paar alte Kleider die herumflattern und zerfetzt sind.");
  AddDetail( ({ "sachen" }),
    "Die Sachen, die hier so rumliegen, stammen von den Partys, die hier "
    "gefeiert wurden.");
  AddDetail( ({ "zeit" }),
    "Hier konnte die Zeit nicht verbergen, was hier einst geschehen ist.");
  AddDetail( ({ "fische", "fisch"}),
    "Die Fische wurden hier wahrscheinlich bei den Partys massenhaft verzehrt, "
    "ein paar Reste der Fische liegen noch herum, dauert das wirklich solange "
    "bis Reste verrotten?");
  AddDetail( ({ "spiess"}),
    "Der Spiess hat wohl dazu gedient, die Fische zu braten, ob sie geschmeckt haben?");
  AddDetail( ({ "kleider"}),
    "Alte vergammelte und zerfetzte Kleider liegen hier herum, wie kann man nur so "
    "viel Unrat herum liegen lassen.");
  AddDetail( ({ "unrat"}),
    "Wer diesen Unrat hier liegen gelassen hat kennt wohl keine Ordnung.");
  AddDetail( ({ "reste"}),
    "Die Reste dieser Partys liegen hier ueberall herum, das sieht wirklich nicht schoen aus.");
  AddDetail( ({ "ordnung"}),
    "Also hier hat wohl Niemand, nicht das Geringste fuer Ordnung uebrig gehabt."); 
  AddDetail( ({"niemand"}),
    "Niemand hatte hier was fuer Ordnung ueberig.");
  AddDetail( ({"geringste"}),
    "Fuer Ordnung hatte wohl Niemand das Geringste uebrig.");
   AddDetail( ({ "luft"}),
    "Die Luft riecht nach Meer und ist richtig erfrischend.");
  AddDetail( ({ "nase"}),
    "Mit deiner Nase kannst Du riechen, versuch es einmal."); 






  
  AddSound( DEFAULT_SOUND,
    "Man kann hier die Wellen hoeren und das leise Rieseln, wenn die Wellen "
    "ueber den Sand gespuelt werden.");
  AddSound( ({ "rieseln" }),
    "Wenn die Wellen ueber den Sand gespuelt werden, hoert man ein Rieseln.");
  AddSound( ({ "wellen" }),
    "Du hoerst, wie die Wellen sanft ueber den Sand gespuelt werden.");
  AddSound( ({ "sand"}),
    "Du kannst hoeren, wie der Sand leicht gegeneinander reibt, waehrend "
    "die Wellen ueber ihn hinweg gespuelt werden.");
  AddSmell( DEFAULT_SMELL,
    "Du ziehst die Luft durch Deine Nase und kannst das Meer riechen.");
  AddSmell( ({ "meer" }),
    "Die Luft, die Du durch Deine Nase atmest, riecht nach dem Meer "
    "und wirkt erfrischend auf Dich."); 
  


  AddExit( "suedwesten", ROOM "insel8" );
  AddExit( "nordwesten", ROOM "insel2" );
  AddExit( "westen", ROOM "insel6" );

  AddCmd( ({"grab", "grabe" }), "graben" );//hier muesstest du natuerlich bei dir fasse oder greife machen 
}

void reset()
{
  ::reset();
  flasche_zahl=1;//sagt wieviele flaschen es gibt um sie nehmen zu koennen(also im prinzip deine frage wie mans macht)
}

string detailflasche()
{
 if(flasche_zahl==1)
 {return(BS("Die Flasche ist fast ganz geblieben und in ihr schimmert etwas "
           "Glaenzendes. Sie ist halb im Sand vergraben."));}//ist die beschreibung unt flasche(im raum)
  return(BS("Du musst Dich getaeuscht haben, alle Flaschen, die noch hier "
           "sind, sind komplett uninteressant."));//wrenn jemand die flasche irgendwann vor dir genommen hat 
}



int graben(string str)
{
  object alteflasche;
  notify_fail( "Was moechtest Du ausgraben?\n" );//wenn du falsche syntax benutzt wird das ausgegeben
  if ( member( ({ "flasche aus", "flasche aus sand",
                  "flasche aus sand aus" }), str ) != -1 )//das sind die moeglichkeiten womit du sie ausgraben kannst, 
//also syntax
   {
     if( flasche_zahl < 1 )
     {
        write("Du wuehlst im Sand, aber diese Flasche laesst sich "
              "nicht ausgraben.\n");//zeigt das grade keine da ist
        say(sprintf("%s graebt im Sand.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("HIRIFLASCHE",TP) )
      {
      write("Da Du bereits eine Flasche hast, brauchst Du nicht "
      +"mehr graben.\n" );//wenn man flasche im inv hat, bekommt man keine mehr
      say(sprintf("%s spielt mit dem Gedanken, sich eine Flaschen"
      +"sammlung zuzulegen.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {alteflasche = clone_object( OBJ "alteflasche");
        if ( ME_TOO_HEAVY == alteflasche->move(TP,M_GET|M_SILENT) )//gehoert zum zu schwer werden wenn sie ins inv geclont
//werden soll
          {
          write(
          "Die Flasche wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s graebt im Sand, scheint aber vom Gepaeck "
          "behindert zu werden.\n", TP->Name(WER))));//wenn man zu schwer beladen ist kann man die flasche nicht mehr tragen
          alteflasche -> remove();
          return 1;
          }
          else
          {
          write("Du wuehlst im Sand und graebst die Flasche aus, "
                "die Du sofort einsteckst.\n");//das siehst man selbst
          say(sprintf("%s graebt im Sand und steckt etwas ein.\n",//das sieht ein anderer spieler
          TP->Name(WER)));
          flasche_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
