#include "../def.h"

inherit "std/room";



void create()
{
::create();

 
  SetProp( P_INT_SHORT, "Auf einer geteilten Bruecke" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer breiten Bruecke, die ueber das Meer fuehrt. " 
    "Sie ist aus einem seltsamen blaugruen schimmernden Holz gefertigt. "
    "Die Bruecke ist breit und hat ein stabiles Gelaender, das mit "
    "Eisen beschlagen worden ist. Die Bruecke steht auf starken Holzpfaehlen. "
    "Wenn Du nach Norden gehst, kommst Du zurueck zu dem Strand. Im "
    "Suedwesten siehst Du ein Rondell.");

SetProp( P_LIGHT, 1 );
SetProp( P_INDOORS, 0);
SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


  AddDetail( ({ "boden" }),
    "Der Boden der Bruecke besteht aus Holzplanken." );
  AddDetail( ({ "holzplanken", "planken" }),
    "Die Holzplanken sind aus sehr starken Palmenstaemmen gefertigt." );
  AddDetail( ({ "palmenstaemme", "staemme" }),  
    "Die Palmenstaemme stammen bestimmt von der Insel." );
  AddDetail( ({ "insel" }),
    "Von hier aus kannst Du nicht viel von der Insel erkennen." );
  AddDetail( ({ "bruecke" }),
    "Hier stehst Du auf dem ersten Teil der Bruecke." );
  AddDetail( ({ "teil" }),
    "Der erste Teil der Bruecke, auf dem Du gerade draufstehst." ); 
  AddDetail( ({ "eisen" }),
    "Das Eisen ist als Beschlag auf dem Gelaender angebracht." );
  AddDetail( ({ "beschlag" }),
    "Der Beschlag ist aus Eisen." );
  AddDetail( ({ "gelaender" }),
    "Das Gelaender ist aus Holz und mit Eisen beschlagen." );
  AddDetail( ({ "himmel" }),
    "Der Himmel erstrahlt in seinem schoensten Blau." );
  AddDetail( ({ "blau"}),
    "Ja, richtig, der Himmel ist blau.");  
  AddDetail( ({ "holz"}),
    "Das Holz des Gelaenders ist aus Palmenstaemmen wie die Holzplanken auch."); 
  AddDetail( ({ "holzpfaehlen", "holzpfaehle", "pfaehle"}),
    "Auf den Holzpfaehlen ist die Bruecke gebaut worden.");
  AddDetail( ({ "meer"}),
    "Die Bruecke geht ueber das Meer zu einer Insel. Es riecht ueberall "
    "nach Meer.");
  AddDetail( ({ "rondell"}),
    "Wenn Du weiter gehst, kommst Du zu dem Rondell.");
  AddDetail( ({ "strand"}),
    "Wenn Du zurueck schaust, kannst Du noch den Strand sehen."); 
  AddSound( DEFAULT_SOUND,    
    "Du kannst hoeren, wie die Wellen gegen die Holzpfaehle der Bruecke "
    "schlagen."); 
  AddSound( ({ "wellen" }),
    "Du hoerst das leise Rauschen der Wellen, wenn sie gegen die Holzpfaehle "
    "getrieben werden."); 
  AddSound( ({ "rauschen"}),
    "Du hoerst das Rauschen der Wellen.");
  AddSmell( DEFAULT_SMELL,    "Das Meer riecht typisch nach Salz.");
  AddSmell( ({ "salz" }),
    "Du riechst das Salz, was es im Meer massig gibt.");


  AddExit( "norden", ROOM "stueck5" );
  AddExit( "suedwesten", ROOM "rondell" );

}



