#include "../def.h"

#include <properties.h>
#include <language.h>

inherit "std/room";

int schluckanzahl;

void create()
{
::create();

  schluckanzahl = 5;

  SetProp( P_INT_SHORT, "An einem Bach" );
  SetProp( P_INT_LONG,
    "Du bist durch den Bach gegangen und siehst auch hier noch die Duene und die "
    "Klippen, die jetzt direkt neben Dir sind. Die Quelle von dem Bach kannst Du "
    "jetzt sehr gut erkennen, aber erreichen kannst Du sie noch nicht, weil sie erst "
    "weiter oben aus den Klippen entspringt. Dir faellt auf den Klippen noch "
    "eine Nische auf und es scheint einen Weg dort hinauf zu geben. Hier erhellt "
    "die Sonne gerade nicht so sehr, wahrscheinlich nimmt die Klippenreihe ihr "
    "etwas die Kraft." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );
  

  AddDetail( ({ "bach"}),
    "Du stehst nun auf der anderen Seite von dem kleinen Bach, viel anders sieht "
    "er von hier aus auch nicht aus, aber Du kannst seine Quelle in den Klippen "
    "erkennen.");
  AddDetail( ({ "seite"}),
    "Von dieser Seite des Baches kannst Du bestimmt wieder zurueck gehen.");
  AddDetail( ({ "duene"}),
    "Auch hier siehst Du Riedgraeser und Buesche auf der Duene wachsen und kleine "
    "Krabben und Eidechsen kannst Du hier auch beobachten. Ueber die Duene wirst "
    "Du hier auch nicht gehen koennen. Du kannst hier nicht auf die Duene gelangen.");
  AddDetail( ({ "quelle"}),
    "Die Quelle des Baches entspringt in den Klippen, etwas weiter rechts davon ist "
    "die Nische.Das Quellwasser plaetschert klar und seicht als kleiner "
    "Wasserfall von den Klippen.");
  AddDetail( ({ "boden"}),
    "Der Boden besteht hier, nahe an den Klippen, aus einem Lehmerdegemisch, "
    "weiter zur Duene hin wird der Boden immer sandiger.");
  AddDetail( ({ "lehmerdegemisch", "lehm", "gemisch"}),
    "In dem Lehmerdegemisch kannst Du Spuren erkennen.");
  AddDetail( ({ "spuren"}),
    "Die Spuren fuehren zu dem kleinen Wasserfall, sie enden direkt neben diesem "
    "und vor den Klippen.");
  AddDetail( ({ "sonne"}),
    "Hier scheint die Sonne nicht mit ihrer vollen Kraft, um Licht spenden zu koennen.");
  AddDetail( ({ "kraft"}),
    "Die Sonne kann hier ihre Kraft nicht unter Beweis stellen.");
  AddDetail( ( { "beweis"}),
    "Muss die Sonne eigentlich ueberhaupt irgendeinen Beweis ihrer Kraft abgeben?");
  AddDetail( ({ "licht"}),
    "Das Licht kommt von der Sonne, ganz natuerlich also.");
  AddDetail( ({ "weg"}),
    "Du solltest vielleicht nach einer Moeglichkeit suchen, zu ihm zu kommen. "
    "Wo er wohl hinfuehren mag?");
  AddDetail( ({ "klippen", "klippenreihe", "klippe"}),
    "Du schaust Dir die Klippen der Klippenreihe genauer an und siehst seltsame "
    "Abschuerfungen und kleine Spalten." );
  AddDetail( ({ "abschuerfungen", "moeglichkeit"}),
    "Die Abschuerfungen sind gewiss von vielen Fuessen, die die Klippen erklommen "
    "haben und koennten auch Dir, eine Moeglichkeit bieten herauf zu kommen.");
  AddDetail( ({ "fuessen", "fuesse"}),
    "Versuch doch mal, ob Du mit deinen Fuessen auch auf die Klippen klettern "
    "kannst. Die Spalten koennten gewiss guten Halt geben.");
  AddDetail( ({ "spalten"}),
    "Wenn Du versuchen solltest hinauf zu klettern, geben sie Dir bestimmt guten Halt.");
  AddDetail( ({ "halt"}),
    "Wenn Du versuchen solltest auf die Klippen zu klettern, wirst Du, durch die Spalten "
    "Halt finden um hinauf zu kommen.");
  AddDetail( ({ "nische"}),
    "Du wirst von hier aus bestimmt nicht mehr erkennen koennen.");
  AddDetail( ({ "himmel"}),
    "Keine Wolke ist an dem Himmel zu sehen, Du fuehlst Dich hier richtig wohl.");
  AddDetail( ({ "wolke", "wolken"}),
    "Nein, Du siehst nicht einmal eine, so klar ist der Himmel.");
  AddDetail( ({ "wasserfall"}),
    "Der Wasserfall plaetschert von den Klippen herunter und das Plaetschern "
    "stroemt eine herrliche Ruhe aus.");
  AddDetail( ({ "quellwasser", "wasser"}),
    "Da das Quellwasser so schoen klar ist, koenntest Du ja mal ein wenig davon trinken.");
  AddDetail( ({ "ruhe"}),
    "Ruhe, ja Du geniesst sie sehr, Du lauschst den Geraeuschen der Natur.");
  AddDetail( ({ "buesche"}),
    "Die Buesche, die Du hier auf der Duene siehst, haben auch ihr Blaetter in "
    "diesem seltsamen blaugruenen Farbton.");
  AddDetail( ({ "blaetter"}),
    "Die Blaetter mit diesem blaugruenen Farbton sind wirklich seltsam.");
  AddDetail( ({ "farbton", "farbe"}),
    "Der Farbton sieht aus, als ob die Blaetter nicht hier her gehoeren wuerden.");
  AddDetail( ({ "riedgraeser", "graeser"}),
    "Die Riedgraeser stehen hier dichter und man kann die Krabben und Eidechsen "
    "hier nicht mehr so leicht beobachten.");
  AddDetail( ({ "eidechsen"}),
    "Hier siehst Du kleine Eidechsen wild hin und her flitzen.");
  AddDetail( ({ "krabben"}),
    "Die Krabben sind rot und laufen wie fuer Krabben ueblich seitlich.");
  AddDetail( ({ "geraeusche"}),
    "Die Geraeusche, die Du hier hoeren kannst sind vielfaltig, lausch doch mal.");
  AddDetail( ({ "natur"}),
    "Die Natur ist hier einfach schoen und beruhigend.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Plaetschern von dem Wasserfall und mehrere andere Geraeusche. "
    "Du glaubst das Meer zu hoeren und Moewengeschrei.");
  AddSound( ({ "plaetschern"}),
    "Das Plaetschern stammt von dem Wasserfall.");
  AddSound( ({ "meer"}),
    "Du hoerst tatsaechlich das Meer rauschen, soweit kann es nicht sein, "
    "aber wie kommst du dort hin.");
  AddSound( ({ "moewengeschrei", "geschrei", "moewen"}),
    "Du siehst zwar keine, aber Du kannst das Moewengeschrei hoeren.");
  AddSound( ({ "geraeusche", "geraeuschen"}),
    "Lausch den verschiedenen Geraeuschen doch mal.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Lehm und auch das wohl nicht mehr weit entfernte Meer "
    "kannst Du hier riechen.");
  AddSmell( ({ "meer"}),
    "Das Meer mit seinem natuerlichen Geruch kannst Du hier riechen."); 
  AddSmell( ({ "lehm"}),
    "Der Lehm hat diesen feuchten erdigen Geruch."); 
  AddSmell( ({ "geruch"}),
    "Eben der Geruch von dem Meer und dem Lehm.");

  AddItem(NPC "eidechse1", REFRESH_DESTRUCT);
 AddItem(NPC "krabbe1", REFRESH_DESTRUCT);

  
  AddCmd(  ({ "geh", "gehe" }), "gehen"  ); //sagt, mit welchem verb da ne funktion kommt
  AddCmd( ({"kletter","klettere","klettre","steig","steige"}), "klettern");
  AddCmd( ({"trink", "trinke" }), "trinken" );//auf klippe klettern zu stueck3


}
int trinken(string str)
{
   notify_fail("Was moechtest Du denn trinken?\n");
   if ( member( ({ "wasser","quellwasser" }),str) != -1) 
  { 
    write(BS( "Du trinkst Wasser aus der Quelle und fuehlst Dich erfrischt."));
    say(BS( TPN+" nimmt einen Schluck aus der Quelle und sieht erfrischt aus."));
    if ( schluckanzahl )
    {
      TP -> drink_soft(1);
      TP -> heal_self(5+random(10));
      schluckanzahl--;
    }
    return 1;
  }
}


int gehen(string str)
{
   notify_fail("Wodurch moechtest Du denn gehen?\n" );
   if( str == "durch bach" || str == "durch den bach" )
  {
     write(BS("Du krempelst Deine Hosenbeine hoch und gehst durch "
     "den Bach.\n"));
     TP->move(ROOM "stueck", M_GO, "durch den Bach", "geht",
     "kommt durch den Bach hereingelaufen");
     return 1;  
  }
  return 0;
}


int klettern(string str)
{  
   notify_fail( "Wo moechtest Du denn rauf klettern?\n" );
   if( str == "auf klippe" || str == "auf die klippe" )    
  {  
     write(BS("Du kletterst auf die Klippe.\n"));
     TP->move(ROOM "stueck3", M_GO, "auf die Klippe", "klettert",
     "kommt die Klippe heraufgeklettert");
     return 1;
  }
  return 0;
}

void reset()
{
  ::reset();

  schluckanzahl = 5;
}
