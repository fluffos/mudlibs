//erstellt am 08.02.2003 von hiri



#include "../def.h"

inherit "std/room";


void create()
{
::create();

  SetProp( P_INT_SHORT, "Auf einer Insel" );
  SetProp( P_INT_LONG,
    "Du bleibst wie angewurzelt stehen, als Du dieses Stueck der Insel "
    "erreichst. Vor Dir siehst Du eine wunderschoen gebaute Sandburg "
    "stehen und bewunderst die Feinheiten derer. Zwei Palmen wachsen "
    "hier und bedecken die Sandburg mit etwas Schatten. An den Palmen "
    "haengen weit oben Kokosnuesse, die bestimmt lecker schmecken wuerden. "
    "Ein paar Grasbueschel siehst Du hier auch, viele sind es aber nicht.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Der Boden besteht hier aus Sand, wie sollte es anders sein.");
  AddDetail( ({ "sand" }),
    "Du gehst auf dem Sand.");
  AddDetail( ({ "feinheiten" }),
    "Die Feinheiten der Sandburg sind wirklich sehr gut zu erkennen.");
  AddDetail( ({ "grasbueschel", "gras", "bueschel" }),
    "Es stehen nur sehr wenige Grasbueschel hier, vielleicht gibt es auf "
    "dem Inselinneren mehr davon.");
  AddDetail( ({ "inselinneren","inselinneres" }),
    "Im Inselinneren gibt es vielleicht mehr Grasbueschel als hier.");
  AddDetail( ({ "himmel" }),
    "Am Himmel siehst Du nicht eine Wolke, die darauf schliessen lassen "
    "koennte, dass es Regen gibt." );
  AddDetail( ({ "regen" }),
    "Regen? Hier hat es bestimmt schon lange nicht mehr geregnet.");
  AddDetail( ({ "wolke" }),
    "Nicht eine Wolke kannst Du am Himmel sehen, da die Sonne kraeftig scheint.");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint kraeftig vom Himmel herunter.");
  AddDetail( ({ "insel" }),
    "Du stehst auf der Insel und betrachtest die Sandburg.");
  AddDetail( ({ "kokosnuesse", "nuesse" }),
    "Die Kokosnuesse haengen zu weit oben, da kommst Du nicht ran.");
  AddDetail( ({ "palme","palmen" }),
    "Genau zwei Palmen stehen hier und spenden etwas Schatten.");
  AddDetail( ({ "sandburg", "burg" }),
    "Die Sandburg sieht fast aus wie ein Bildnis von der Burg "
    "Sturmfels, aber eben nur fast. Sie hat sogar einen Wassergraben "
    "und vier Tuerme. Ein kleines Tor kannst Du auch erkennen und eine "
    "Haengebruecke.");
  AddDetail( ({ "bildnis" }),
    "Man koennte meinen, die Sandburg waere ein Bildnis von Sturmfels.");
  AddDetail( ({ "haengebruecke", "bruecke"}),
    "Die Haengebruecke ist aus kleinen Holzstueckchen gebaut und hat ein "
    "Seilgeflecht, wo man sich fest halten koennte, wenn es eine grosse waere.");
  AddDetail( ({ "holzstueckchen", "holz", "stueckchen"}),
    "Die kleinen Holzstueckchen sind fein saeuberlich zusammen gebunden "
    "und bilden die Haengebruecke.");
  AddDetail( ({ "seilgeflecht", "seil", "geflecht"}),
    "Das Seilgeflecht ist aus blaugruenen Algen geflochten und ist sehr fest.");
  AddDetail( ({ "algen"}),
    "Die Algen sind wohl tief unten aus dem Meer, ob sie angeschwemmt wurden?");
  AddDetail( ({ "meer"}),
    "Hier kannst Du auch direkt auf das Meer schauen.");
  AddDetail( ({ "sturmfels"}),
    "Als Paladin wird Dir Sturmfels ganz gewiss nichts Neues sein, "
    "andernfalls hast Du aber bestimmt schon etwas darueber gehoert.");
  AddDetail( ({ "neues"}),
    "Wenn Du Neues erfahren moechtest, ist dies nicht, der geignete Platz dafuer.");
  AddDetail( ({ "platz"}),
    "Bist Du ein Hund, der auf Platz hoert?");
  AddDetail( ({ "hund"}),
    "Platz, Du Hund.");
  AddDetail( ({ "paladin"}),
    "Willst Du jetzt wirklich sagen, Du weisst nicht, was ein Paladin ist?");
  AddDetail( ({ "tor"}),
    "Das Tor ist auch aus Holzstueckchen gebaut und man kann es sogar oeffnen.");
  AddDetail( ({ "tuerme","turm" }),
    "Es sind vier Tuerme an den Ecken der Sandburg gebaut, auf jedem der "
    "Tuerme weht eine kleine Fahne.");
  AddDetail( ({ "fahne"}),
    "Die Fahne, die auf jedem der vier Tuerme gleich aussieht, ist aus "
    "blaugruenen Algenblaettern und einem Holzstueckchen gemacht.");
  AddDetail( ({ "algenblaettern", "blaettern", "blaetter"}),
    "Die Algenblaetter sind blaugruen und haengen momentan an den "
    "Holzstueckchen herunter.");
  AddDetail( ({ "algenblaetter", "blaetter"}),
    "Die Algenblaetter haengen an den Holzstueckchen herab.");
  AddDetail( ({ "ecken"}),
    "Vier Ecken sind es, wie auch vier Tuerme.");
  AddDetail( ({ "wassergraben", "graben"}),
    "Der Wassergraben geht um die Sandburg herum und ist mit Wasser gefuellt.");
  AddDetail( ({ "wasser"}),
    "Das Wasser wird aus dem Meer hierher abgeleitet.");
  AddDetail( ({ "schatten"}),
    "Der Schatten faellt von den beiden Palmen her auf die Sandburg herab.");
  AddDetail( ({ "stueck"}),
    "Auf diesem Stueck der Insel findest Du etwas Abkuehlung durch den Schatten.");
  AddDetail( ({ "abkuehlung" }),
    "Abkuehlung findest Du hier durch den Schatten und es tut sehr gut.");
    

   AddExit( "suedwesten", "/d/wasser/hiri/inselversteck/room/insel5.lpc" );
   AddExit( "nordosten",  "/d/wasser/hiri/inselversteck/room/insel.lpc" );

  AddItem(  "/d/wasser/hiri/sandburg/npc/tagino.lpc", REFRESH_DESTRUCT); 


  AddCmd( ({"betrete", "betret"}), "betreten" );
}


int betreten(string str)
{
   notify_fail("Was moechtest Du betreten?\n");
   if ( member( ({ "haengebruecke", "bruecke" }),str) != -1) 
   {
     if (!TP->QueryProp(P_FROG)) 
     {
       write("Du bist viel zu gross fuer die Bruecke!\n");
       say(TPN+" will die Bruecke betreten, scheint aber zu gross zu sein.\n");
       return 1;
     }
     write("Du betrittst die Bruecke.\n");
     TP->move("/d/wasser/hiri/sandburg/room/haengebruecke.lpc", M_GO, "auf die Bruecke", "huepft", 
      "huepft herein");
     return 1;
    }
}
