//erstellt am 08.02.2003 von hiri



#include "../def.h"

inherit "std/room";

int krabbeda;
object resetkrabbe;

void create()
{
::create();

krabbeda=1;



  SetProp( P_INT_SHORT, "Auf einer Insel" );
  SetProp( P_INT_LONG,
    "Du bist ein Stueckchen weiter auf die Insel gegangen und siehst, "
    "dass die Palmen etwas dichter werden und auch mehr Grashalme und "
    "Grasbuesche wachsen. Du sieht auch hier im Sand kleine Muscheln "
    "liegen und es huschen ein paar Krabben ueber den Sand zu einigen "
    "Felsbloecken, die etwas groesser sind und aus dem Wasser herausragen."
    "Wenn Du nach Norden hin, auf das Meer schaust, faellt Dir eine sehr "
    "grosse Schildkroete auf. Scheinbar wohnt jemand auf dieser "
    "Riesenschildkroete.");

SetProp( P_LIGHT, 1 );
SetProp( P_INDOORS, 0);
SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );



  AddDetail( ({ "boden" }),
    "Der Boden besteht auch hier wieder aus Sand, wie sollte es anders sein.");
  AddDetail( ({ "felsbloecken", "bloecke" }),
    "Auf diesen Felsbloecken siehst Du auch noch Krabben krabbeln, aber Du "
    "kannst hier nicht auf diese hinauf, nur ein Schimmern unter den "
    "Felsbloecken faellt Dir auf.");
  AddDetail( ({ "schimmern", "schimmer"}),
    "Du beugst Dich hinunter, um das Schimmern genauer zu betrachten, in "
    "dem Moment, als Du Dich vorbeugst, schwappt eine Welle heran und Du "
    "bist nass bis auf die Haut.");
  AddDetail( ({ "haut"}),
    "Deine Haut ist jetzt nass und wenn Du nicht so neugierig gewesen "
    "waerest, waere Dir das nicht passiert.");
  AddDetail( ({ "moment"}),
    "Fuer einen Moment wirst Du ziemlich wuetend, aber dann lachst Du selbst.");
  AddDetail( ({ "welle"}),
    "Auf die Welle haettest Du vorher achten sollen."); 
  AddDetail( ({ "grasbuesche", "buesche" }),
    "Die Grasbuesche werden hier schon immer haeufiger, vielleicht gibt es "
    "ja auf der Insel noch eine kleine Wiese.");
  AddDetail( ({ "wiese" }),
    "Da hier schon mehrere Grasbuesche zu sehen sind, koennte ja eine "
    "Wiese hier auf der Insel zu finden sein.");
  AddDetail( ({ "grashalme", "halme" }),
    "Die Grashalme bilden hier die wenigen Grasbuesche.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist strahlend blau und ein paar Moewen kreisen dort oben, "
    "vielleicht kannst Du sie ja hoeren. Die Sonne scheint hell vom Himmel herunter." );
  AddDetail( ({ "sonne"}),
    "Die Sonne scheint vom Himmel herunter.");
  AddDetail( ({ "moewen", "moewe" }),
    "Die Moewen machen wirklich viel Laerm am Himmel.");
  AddDetail( ({ "laerm" }),
    "Der Laerm, den die Moewen machen, ist fuerchterlich.");
  AddDetail( ({ "insel" }),
    "Die ganze Insel hast Du noch nicht gesehen, geh doch mal weiter.");
  AddDetail( ({ "krabben", "krabbe" }),
    "Die Krabben huschen schnell unter den Felsbloecken hervor und wieder "
    "zurueck. Man hoert eine lustige Melodie, die die Krabben mit ihren "
    "Scheren erzeugen.");
  AddDetail( ({"melodie"}),
    "Du koenntest der Melodie ja einmal beachtung schenken und ihr lauschen.");
  AddDetail( ({"scheren","schere"}),
    "Die Krabben spielen eine lustige Melodie mit ihren Scheren.");
  AddDetail( ({ "muscheln", "muschel" }),
    "Hier liegen nicht ganz soviele Muscheln im Sand herum." );
  AddDetail( ({ "palmen", "palme" }),
    "Die Palmen haeufen sich mehr und mehr." );
  AddDetail( ({ "sand"}),
    "Der Sand schimmert in der Hitze.");
  AddDetail( ({ "hitze"}),
    "Die Hitze macht Dir doch etwas zu schaffen.");
  AddDetail( ({ "stueckchen", "stueck"}),
    "Du bist ein Stueckchen weiter auf die Insel gegangen.");
  AddDetail( ({ "wasser"}),
    "Du kannst hier Wasser sehen so weit das Auge reicht.");
  AddDetail( ({ "auge"}),
    "Dein Auge erfasst die Insel, alles kannst Du aber nicht deutlich erkennen.");
  AddDetail( ({ "ohren", "ohr"}),
    "Mit Deinen Ohren kannst Du bestimmt etwas hoeren.");
  AddDetail( ({ "duft"}),
    "Den Duft von dem Meer kannst auch Du erriechen, wenn Du es nur "
    "versucht."); 


  AddSpecialDetail( ({ "melodie","krabbe"}),"detailMelodie" );
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst hier, wie die Wellen an den Felsbloecken hoch klatschen und "
    "die Moewen mit ihrem Laerm. Wenn Du der Melodie der Krabben lauschen "
    "moechtest, dann gib: lausch melodie ein.");
  AddSound( ({ "wellen" }),
    "Du hoerst wie die Wellen an den Felsbloecken gebrochen werden.");
  AddSound( ({ "moewen", "moewe"}),
    "Die Moewen kreischen sehr laut, am liebsten wuerdest Du Dir Deine "
    "Ohren zuhalten.");
  AddSmell( DEFAULT_SMELL,
    "Hier kannst Du nicht viel riechen, ausser das Meer mit seinem typischen Duft.");
  AddSmell( ({ "meer" }),
    "Faellt Dir gerade ein, wie das Meer riecht?");
  AddDetail( ({ "schildkroete", "riesenschildkroete", "kroete"}),
    "Im Norden, kannst Du eine sehr grosse Schildkroete erkennen.");
  
//  AddItem(NPC "krabbeinsel", REFRESH_DESTRUCT);
  
  AddExit( "suedosten", ROOM "insel4" );
  AddExit( "nordwesten", ROOM "insel" );
  
  AddCmd( ({"lausch","lausche","lauschen"})    , "cmd_lauschen");
  
}
string detailMelodie()
{
  if (!present("HIRIKRABBE",TO))
    return(BS("Du lauschst der Melodie der Krabbe und bist "
	   "davon fasziniert.\n"));
  return("Da ist nichts zu hoeren, Du bist enttaeuscht....\n");
}
void reset()
{
  ::reset();
  krabbeda=1;
  resetkrabbe=present("HIRIKRABBE",TO); 
  
}

int cmd_lauschen(string str)
{
  object krabbe;
  notify_fail ("Wem moechtest Du lauschen?\n");

  if(!str || str == "") return 0;
  
  if(!(str == "melodie" ||
       str=="krabbe" 
      )) 
	  return 0;
  if (present("HIRIKRABBE",TO) || !krabbeda)

  {
    write(BS("Du hast der Krabbe ja gelauscht, sie ist jetzt des singens Muede."));
    return -1;
  }
  write(BS("Du lauschst gespannt der Melodie der Krabben und "
	   "erkennst die Melodie. KlippKlapp KlippKlapp..... "
           "Es klappert die Muehle am rauschenden Bach. "
	   "KlippKlapp.....KlippKlapp.\n"));
  krabbe=0;
  krabbe = clone_object ("/d/wasser/hiri/inselversteck/npc/krabbeinsel.lpc" );
  krabbe->move(TO,M_GO|M_NOCHECK,"klappert davon.");
  return 1;
}

