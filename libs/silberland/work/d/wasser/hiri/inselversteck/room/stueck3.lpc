//erstellt am 29.01.2003

#include "../def.h"
inherit "std/room";

int linoda;

object resetlino;
object resetpeitsche;
object resetfell;

void create()
{
::create();
  linoda=1;


  SetProp( P_INT_SHORT, "Auf einer Klippe" );
  SetProp( P_INT_LONG,
    "Du bist die Klippen hinauf geklettert und stehst nun direkt neben der "
    "Quelle des Baches. Die Nische, die Du von unten aus schon erkennen "
    "konntest, siehst Du nun genau, und hier beginnt ein Weg in Richtung ueber "
    "die Klippen. Du bemerkst in der Nische eine Bewegung. Von hier oben "
    "kannst Du nach unten auf die Duene, und den Bach schauen. Du siehst "
    "neben der Nische ein kleines Schild, worauf eine Schrift zu sehen ist.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"bach"}),
    "Der Bach entspringt hier oben und ein Wasserfall faellt die Klippen "
    "hinunter und man kann das leise plaetschern hoeren.");
  AddDetail( ({ "wasserfall"}),
    "Der Wasserfall plaetschert leise die Klippen herunter.");
  AddDetail( ({"bewegung"}),
    "In der Nische bemerkst Du eine Bewegung, aber du weisst nicht was das "
    "gewesen sein koennte.");
  AddDetail( ({"boden"}),
    "Der Boden ist hier ziemlich felsig, ganz normal fuer Klippen.");
  AddDetail( ({"duene"}),
    "Von hier schaust Du auf die Duene, aber alles erkennen was auf "
    "ihr steht kannst Du von hier aus nicht.");
  AddDetail( ({"himmel"}),
    "Der Himmel ist wolkenlos, folglich siehst Du nicht eine Wolke und Moewen "
    "kreisen stetig am Himmel.");
  AddDetail( ({ "moewen"}),
    "Man sieht die Moewen am Himmel ihre Kreise ziehen, aber man kann auch "
    "ihr Geschrei hoeren.");
  AddDetail( ({ "kreise"}),
    "Die Moewen, ziehen am Himmel stetig ihre Kreise.");
  AddDetail( ({ "geschrei"}),
    "Das Geschrei der Moewen dringt an Dein Ohr.");
  AddDetail( ({ "ohr"}),
    "Lausch doch mal mit Deinem Ohr, wer weiss, was Du alles hoeren kannst.");
  AddDetail( ({ "wolkenlos", "wolke"}),
    "Wolkenlos, wirklich ohne die kleinste Wolke, sieht der Himmel einfach genial aus.");
  AddDetail( ({ "klippen", "klippe"}),
    "Du kannst hier oben auf der Klippe nun den Weg, der ueber die "
    "Klippen fuehrt, genauer erkennen.");
  AddDetail( ({"wasser","wasserfall"}),
    "Das Wasser, von dem Wasserfall hat einen sehr frischen Geruch.");
  AddSpecialDetail( ({ "etwas"}),"detailEtwas" );
  AddSpecialDetail( ({"nische"}),"detailNische" );
  AddDetail( ({ "quelle"}),
    "Du stehst direkt neben der Quelle des kleinen Baches.");
  AddDetail( ({ "plaetschern"}),
    "Du kannst das Plaetschern auch hoeren.");
  AddDetail( ({ "schild"}),
    "Auf dem Schild ist mit kritzeliger Schrift etwas eingeritzt.");
  AddDetail( ({ "schrift"}),
    "Man kann die Schrift bestimmt lesen.");
  AddDetail ( ({"teil", "unterer teil"}),
    "Du muesstest Dich hinunterbeugen, um es zu entziffern.");
  AddDetail( ({ "weg"}),
    "Der Weg fuehrt nach Suedostunten weiter die Klippen hinunter. Du "
    "versuchst genauer zu erkennen, was dort ist, aber irgendwie sieht "
    "alles so verschwommen aus, woran das wohl liegt?");
  AddDetail( ({ "suedostunten"}),
    "Nach Suedostunten koenntest Du gehen, wenn nicht.....");
  AddDetail( ({ "geruch"}),
    "Den Geruch solltest Du schon riechen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Plaetschern von dem Wasserfall und das Geschrei der "
    "Moewen.");
  AddSound( ({ "wasserfall" }),
    "Das Plaetschern dringt leise an Dein Ohr und kommt von dem Wasserfall.");
  AddSound( ({ "plaetschern"}),
    "Das Plaetschern ist wirklich beruhigend.");  
  AddSound( ({ "geschrei"}),
    "Das Geschrei der Moewen kann man nicht ueberhoeren.");
  AddSmell( DEFAULT_SMELL,
    "Du riechst das Meer und den Geruch von frischem Wasser.");
  AddSmell( ({ "meer" }),
    "Der typische Geruch, den das Meer eben abgibt.");
  AddSmell( ({ "wasser"}),
    "Das Wasser riecht richtig frisch.");




  AddCmd( ({"kletter","klettere","klettre","steig","steige"}), "klettern");
  //runterkettern zu stueck2

   AddCmd( ({"lies", "lese" }), "lesen" );//auf klippe klettern zu stueck3
  AddCmd( "beuge", "beugen" );


  AddSpecialExit( "suedostunten", "go_suedostunten" );

}//Create Ende

string detailEtwas()
{
  if (!present("HIRILINO",TO))
    return("Dieses Etwas scheint sich in der Nische zu bewegen.\n");
  return("Du musst Dich wohl getaeuscht haben, denn in der Nische ist "
         "nichts.\n");
}

string detailNische()
{
  if (!present("HIRILINO",TO))
    return("In der Nische versteckt sich Etwas. Ob Du es da heraus locken kannst?\n");
  return("In der Nische ist nichts. Was Du da wieder gesehn hast. Kauf Dir mal eine Brille.\n");
}

void reset()
{
  ::reset();
  linoda=1;
  resetlino=present("HIRILINO",TO); 

  
  if(resetlino)
  {
    resetpeitsche = present ("HIRIPEITSCHE", resetlino);
    resetfell = present ("HIRIFELL", resetlino);
    
    if(resetpeitsche)
      resetpeitsche->remove();
    if(resetfell)
      resetfell->remove();
    resetlino->remove();
  }
}

int beugen (string str)
{
  object lino;
  notify_fail ("Was moechtest Du machen?\n");

  if(!str || str == "") return 0;
  if(!(str == "runter"         ||
       str == "hinunter"  )) return 0;
  if (present("HIRILINO",TO) || !linoda)

  {
    write(BS("Die Schrift ist leider nicht mehr lesbar."));
    return -1;
  }
  write(BS("Die Schrift ist leider nicht mehr lesbar, aber waehrend Du "
        "Dich ueber das Schild gebeugt hast, ist hinter Deinem Ruecken "
        "etwas neugierig aus der Nische gekrochen."));
  linoda=0;
  lino = clone_object ( NPC "kuschelino");
  lino->move(TO,M_GO|M_NOCHECK,"gekrochen",
              "kriecht","kriecht herein");
  return 1;
}

int lesen(string str)
{
   notify_fail("Was moechtest Du denn lesen?\n");
   if ( member( ({ "schrift", "schild" }),str) != -1)
  {
    write( BS("Du betrachtest die Schrift und liest: Wenn Du mich des Weges fragst, "
           "wirst Du mich erkennen, als Monster werd ich vor Dir stehen. "
           "                                                           "
           "Am unteren Teil ist noch etwas ziemlich klein eingeritzt..."));
    say( TPN+" betrachtet die Schrift und alle Farbe weicht aus dem Gesicht.");
    return 1;
}
}


int klettern(string str)
{
  notify_fail( "Wohin moechtest Du denn klettern?\n" );

  if( str == "runter" || str == "nach unten" )
    {//dann passiert:
    write(BS("Du kletterst von der Klippe runter.\n"));
    TP->move(ROOM "stueck2", M_GO, "von der Klippe", "klettert",
    "kommt die Klippe heruntergeklettert");
    return 1;
  }
  return 0;
}

int go_suedostunten(string dir)
{
  object perle;
  perle = present("\nHIRIPERLE",TP);

  if(!(present("kuschelino", TO)))
  {
    write( BS( "Eine unsichtbare Barriere haelt Dich davon ab, nach "
	       "Suedostunten zu gehen.") );
    say("Eine unsichtbare Barriere haelt "+TP->Name(WEN)+" davon ab, "
      "nach Suedostunten zu gehen.\n");
    return -1;
  }
  if (perle && perle -> perlegesteckt() )
  {
    write( BS( "Nachdem Du Dir die Perle in den Nabel gesteckt hast, "
      "laesst Dich Kuschelino vorbei.") );
    say( "Kuschelino laesst "+TP->Name(WEN)+" passieren.\n" );
    TP->move(ROOM "stueck4", M_GO, "nach Suedostunten");
    return 1;
  }
  write("Kuschelino laesst Dich nicht vorbei.\n");
  say("Kuschelino will "+TP->name(WEN)+" nicht vorbeilassen.\n");
  return -1;
}
