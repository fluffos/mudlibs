//erstellt am 31.01.2003 von hiri

#include "../def.h"

inherit "std/room";


#include <moving.h> //brauchst fuer M_GO

#define SITZGELEGENHEIT(wer) (member(sitzgelegenheit, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )
        
string *sitzgelegenheit=({});
void create()
{
::create();


  SetProp( P_INT_SHORT, "In einem Rondell" );
  SetProp( P_INT_LONG,
    "Das Rondell ist aus Bambusstaemmen gebaut und hat ein Dach aus "
    "Palmenblaettern. "
    "Es hat halbhohe Waende, Du kannst in jede Richtung aus dem "
    "Rondell herausschauen. "
    "An den Bambusstaemmen siehst Du Bilder haengen und es gibt in "
    "der Mitte des Rondells eine kleine runde Sitzgelegenheit. "
    "Wenn Du nach Suedosten schaust, kannst Du eine Insel erkennen, "
    "die durch eine weitere Bruecke zu erreichen ist.");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "bambusstaemmen", "bambusstaemme", "bambus", "staemme" }),
    "Die Bambusstaemme sind mit geflochtenen Seilen stabil zusammen gebunden."); 
  AddDetail( ({ "seilen", "seile", "seil"}),
    "Die Seile sind gut an den Bambusstaemmen verknotet.");
  AddDetail( ({ "bilder" }),
    "Die Bilder an den Bambusstaemmen zeigen verschiedene Szenen.");
  AddDetail( ({ "szenen" }),
    "Die Szenen stellen Meerjungfrauen und eine alte Stadt dar.");
  AddDetail( ({ "meerjungfrauen", "frauen", "stadt" }),
    "Die Meerjungfrauen stammen wohl aus dieser alten Stadt, wo sie sein "
    "soll, kannst Du Dir nicht denken.");
  AddDetail( ({ "boden" }),
    "Der Boden ist auch aus Bambusstaemmen.");
  AddDetail( ({ "bruecke" }),
    "Vor und hinter Dir siehst Du die Bruecke.");
  AddDetail( ({ "dach" }),
    "Aus Palmenblaettern wurde ein Dach fuer das Rondell gebaut.");
  AddDetail( ({ "himmel" }),
    "Himmel? Man kann ihn durch das Dach nicht sehen."); 
  AddDetail( ({ "insel" }),
    "Geh noch ein klein wenig weiter und Du bist auf der Insel.");
  AddDetail( ({ "mitte" }),
    "In der Mitte des Rondells siehst Du eine kleine Sitzgelegenheit.");
  AddDetail( ({ "palmenblaettern", "palmenblaetter", "blaetter" }),
    "Die Palmenblaetter sind wahrscheinlich von den Holzpfaehlen der Bruecke "
    "gewesen.");
  AddDetail( ({ "holzpfaehle", "pfaehle" }),
    "Holzpfaehle wirst Du erst an der Bruecke begutachten koennen." );
  AddDetail( ({ "rondell"}),
    "Das Rondell teilt die Bruecke.");
  AddDetail( ({ "sitzgelegenheit", "gelegenheit"}),
    "Die Sitzgelegenheit ist nur klein aber man kann sich gut darauf ausruhen.");
  AddDetail( ({ "waende"}),
    "Es sind halbhohe Waende aus denen Du heraus schauen kannst.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Wasser des Meeres gegen die Holzpfaehle schlagen "
    "und ein leises knarren und rascheln wenn Wind ueber das Dach fegt.");

  AddSound( ({ "wasser", "meeres" }),
    "Du hoerst ein Gurgeln wenn das Wasser des Meeres die Holzpfaehle "
    "umspuelt.");
  AddSound( ({ "gurgeln"}),
    "Wenn das Wasser gegen die Holzpfaehle schlaegt, entsteht ein leises Gurgeln, "
    "das sich sehr lustig anhoert.");
  AddSound( ({ "wind"}),
    "Wenn einmal Wind da ist, kannst Du ihn leise, ueber das Dach pfeifen hoeren.");
  AddSmell( DEFAULT_SMELL,
    "Hier kann man leicht den Geruch der nassen Holzpfaehle der Bruecke wahrnehmen "
    "und den typischen Geruch des Meeres.");

  AddSmell( ({ "geruch" }),
    "Du kannst den Geruch der nassen Holzpfaehle riechen, ein wenig modrig riecht es. "
    "Aber Du kannst auch den typischen Geruch des Meeres riechen.");
 


  AddExit( "suedosten", ROOM "bruecke1" );
  AddExit( "nordosten", ROOM "bruecke" );


  AddSpecialDetail( ({ "sitzgelegenheit", "gelegenheit" }), "sitzgelegenheit");

  AddCmd( ({ "setze", "setz", "sitze", "sitz" }), "cmd_sitdown");
  AddCmd( ({ "stehe", "steh" }), "cmd_getup");
  AddCmd( ({ "suedosten", "so", "goto", "home", "nordosten", "no" }), "cmd_firststandup");

}
int cmd_sitdown(string str)

{
  notify_fail(BS("Wohin moechtest Du Dich setzen?"));
  if(!(str == "auf sitzgelegenheit" || str == "auf die sitzgelegenheit "))
  {
    return 0;
  }
  if(SITZGELEGENHEIT(TP))
  {
    write(BS("Aber Du sitzt doch schon auf der Sitzgelegenheit!"));
    return 1;
  }
  if(sizeof(sitzgelegenheit)>=6)
  {
    write(BS("Leider sitzen schon zuviele auf der Sitzgelegenheit."));
    return 1;
  }
  write (BS("Du setzt Dich auf die Sitzgelegenheit um Dich auszuruhen.\n"));
  tell_room(ENV(TP), TPN+" setzt sich auf die Sitzgelegenheit.\n", ({TP}));
  sitzgelegenheit += ({ capitalize(getuid(TP)) });
  return 1;
}

int cmd_firststandup(string str)
{
  if(SITZGELEGENHEIT(TP))
  {
     write("Du solltest vorher besser aufstehen!\n");
     return 1;
  }
}

int cmd_getup(string str)
{
   notify_fail(BS("Willst Du etwa aufstehen?"));
   if(str == "auf")
   {
     if(SITZGELEGENHEIT(TP))
     {
       write(BS("Du stehst von der Sitzgelegenheit auf."));
       tell_room(ENV(TP), TPN+" steht von der Sitzgelegenheit auf.\n", ({TP}));
       sitzgelegenheit -= ({ capitalize(getuid(TP)) });
       return 1;
     }
  }      
  else 0;
}

void BecomesNetDead(object spieler)
{
  if(SITZGELEGENHEIT(spieler))
  sitzgelegenheit -= ({ capitalize(getuid(spieler)) });
}

string sitzgelegenheit()
{
  string sitzgelegenheitinfo;
  if(SITZGELEGENHEIT(TP))
  {
     sitzgelegenheitinfo =
     "Du sitzt auf einer runden Sitzgelegenheit. "+
     "Du kannst die Bilder so gut anschauen und kannst ueber die "
     "halbhohen Waende auf das Meer schauen.";
  }
  else
  {
     sitzgelegenheitinfo =
     "Die Sitzgelegenheit ist rund und bietet fuer sechs Personen "
     "platz. Du koenntest Dich auf die Sitzgelegenheit setzen, um "
     "Dich auszuruhen.";
  if(sizeof(sitzgelegenheit)==1 )
     sitzgelegenheitinfo += " Im Moment sitzt " + sitzgelegenheit[0] + " auf der "
     		   "Sitzgelegenheit.";
    
  if(sizeof(sitzgelegenheit)>1 )
     sitzgelegenheitinfo += " Im Moment sitzen " + MyCountUp(sitzgelegenheit) + " auf der "
     		   "Sitzgelegenheit.";
  }
  return break_string(sitzgelegenheitinfo, 78);
}


