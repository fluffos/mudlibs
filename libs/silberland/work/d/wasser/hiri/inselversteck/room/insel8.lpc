#include "../def.h"

inherit "std/room";



void create()
{
::create();


  SetProp( P_INT_SHORT, "Auf einer Insel" );
  SetProp( P_INT_LONG,
    "Es wird wieder heisser und auch das Gras nimmt wieder ab, aber nun "
    "weicht der Sand einigen Felsen, die hier aus dem Boden herausragen. "
    "Man kann aber noch an den Felsen vorbei gehen. Auf den Felsen, sind "
    "Zeichnungen, die denen auf dem Brueckengelaender gleichen eingeritzt. "
    "Krabben laufen hier herum und auf und in dem Sand liegen ein paar "
    "Muscheln und einige groessere Steine herum.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist sandig, aber auch steinig, wo die Felsen sind.");
  AddDetail( ({ "felsen" }),
    "Die Felsen ragen etwa einen Meter aus dem Boden heraus.");
  AddDetail( ({ "gras" }),
    "Du siehst fast kein Gras mehr, da es hier viel zu heiss ist.");
  AddDetail( ({ "himmel" }),
    "Auch hier ist der Himmel klar.");
  AddDetail( ({ "muscheln", "muschel" }),
    "Ein paar Muscheln liegen hier im Sand, vielleicht kann man "
    "ja eine umdrehen.");
  AddDetail( ({ "sand" }),
    "Der Sand ist hier irgendwie blaugruen am schimmern.");
  AddDetail( ({ "meter" }),
    "Etwa einen Meter ragen die Felsen aus dem Boden heraus.");
  AddDetail( ({ "brueckengelaender", "gelaender"}),
    "Auf dem Brueckengelaender der Bruecke die Du ueberqueren "
    "musstest, um hierher zu gelangen ist ein Eisenbeschlag befestigt.");
  AddDetail( ({ "eisenbeschlag", "beschlag"}),
    "Auf diesem Eisenbeschlag sind aehnliche Zeichnungen wie hier "
    "auf den Felsen.");
  AddDetail( ({ "bruecke"}),
    "Wenn die Bruecke nicht gebaut worden waere, koenntest Du nich so "
    "einfach auf die Insel gelangen.");
  AddDetail( ({ "insel"}),
    "Du stehst gerade auf der Insel, hast Du das wirklich nicht "
    "bemerkt????");
  AddDetail( ({ "steine"}),
    "Hier liegen vereinzelt ein paar Steine herum, wenn man Stein davon "
    "werfen wuerde, wuerde dieser bestimmt einen schoenen Platscher im Wasser "
    "erzeugen.");
  AddDetail( ({ "platscher"}),
    "Wirf doch einfach einen Stein, dann wirst Du Dein Platscher schon sehen.");
  AddDetail( ({ "stein"}),
    "Du kannst ja mal versuchen einen der Steine in das Meer zu werfen.");
  AddDetail( ({ "meer"}),
    "Das Meer umgibt die Insel, naja, es waere ja auch sonst keine Insel.");
  AddDetail( ({ "wasser"}),
    "Wasser kannst Du rundum die Insel sehen, aber auch in dem Brunnen, der "
    "hier auf der Insel ist, wirst Du Wasser finden.");
  AddDetail( ({ "brunnen"}),
    "Der Brunnen ist nicht hier, da musst Du ein bisschen weiter zurueck laufen.");
  AddDetail( ({ "zeichnungen"}),
    "Die Zeichnungen sind aehnlich derer, die auf dem Eisenbeschlag der Bruecke zu "
    "finden sind.");
  




  
  AddItem(NPC "krabbe1", REFRESH_DESTRUCT);
  AddItem(NPC "krabbeinsel", REFRESH_DESTRUCT);
  
  AddExit( "nordosten", ROOM "insel4" );
  AddExit( "westen", ROOM "steg" );


AddCmd( ({"dreh", "drehe" }), "drehen" );
AddCmd( ({"werfe", "wirf", "werf", "werfen" }), "werfen" );

}
int drehen(string str)
{
   notify_fail("Was moechtest Du umdrehen?\n");
   if ( member( ({ "muschel", "muschel um" }),str) != -1) 
  {
    write( "Du drehst eine Muschel um, findest aber nichts.\n");
    say( TPN+" dreht eine Muschel um, findet aber nichts.\n");
    return 1;
  }
}
int werfen(string str)
{
   notify_fail("Was moechtest Du werfen?\n");
   if ( member( ({ "stein", "den stein", "stein in meer" }),str) != -1) 
  {
    write(BS ( "Du wirfst den Stein und er macht einen dicken Platscher, "
	       "das Wasser spritzt hoch hinauf und dabei wird ein Fisch "
	       "aus dem Wasser geworfen den Du toedlich getroffen hast. "
	       "Schaem Dich."));
	       
	       
/*Er bricht etwas schwabbeliges aus, was Du "
	       "sofort einsteckst."));
  clone_object("/d/wasser/hiri/maske/obj/popel.lpc")->move(TP, M_NOCHECK);*/
    say( TPN+" wirft den Stein und das Wasser spritzt durch den Platscher hoch.\n");
    return 1;
  }

}  

