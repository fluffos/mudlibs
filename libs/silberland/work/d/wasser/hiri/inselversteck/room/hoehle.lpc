#include "../def.h"

inherit "std/room";



void create()
{
::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du bist in diese Hoehle geschluepft und erkennst hier so gut wie nichts. "
    "Nur eine Haufen mit Felsbrocken und kleineren Steinen liegen hier herum. "
    "Man muss gehoerig aufpassen um nicht hinzufallen. An den Waenden sind noch "
    "einige Zeichnungen. Mehr kannst Du so nicht erkennen. Es ist hier angenehm "
    "kuehl. Nach Norden fuehrt ein Gang.");
         
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden"}),
    "Der Boden ist hier genau wie die Decke und die Waende aus Stein.");
  AddDetail( ({ "hoehle"}),
    "Du kannst ausser Felsbrocken und ein paar Steinen die auf einem "
    "Haufen liegen, nicht viel erkennen.");
  AddDetail( ({ "haufen"}),
    "Der Haufen ist scheinbar von irgendwem aufgeschichtet worden. "
    "Aber er ist nicht weiter interessant.");
  AddDetail( ({ "felsbrocken", "brocken"}),
    "Die Felsbrocken sind mittelgross aber nicht weiter ernennenswert.");
  AddDetail( ({ "steinen", "steine"}),
    "Auch die Steine haben keine Bedeutung.");
  AddDetail( ({ "waenden", "waende", "wand"}),
    "An den Waenden sind einige Zeichnungen. An einer Wand siehst Du das "
    "Loch, wo Du durchgeschluepft bist, an einer anderen siehst Du einen Gang."); 
  AddDetail( ({"gang"}),
    "Du solltest einfach den Gang weiter gehen um herauszufinden was dort ist.");
  AddDetail( ({ "zeichnungen"}),
    "Du kannst nicht alle Zeichnungen genau erkennen, aber eine Zeichnung "
    "ist noch perfekt erhalten.");
  AddDetail( ({ "zeichnung"}),
    "Auf der Zeichnung sind drei Kuschelmonster abgebildet. Es handelt sich "
    "wohl um eine Familie.");
  AddDetail( ({ "sand"}),
    "Hier und da siehst Du auf dem Boden etwas Sand.");  
  AddDetail( ({ "familie"}),
    "Die Kuschelmonster auf der Zeichnung bilden eine Familie.");
  AddDetail( ({ "kuschelmonster", "monster"}),
    "Kuschelmonster sind eigendlich friedliche Monster, aber es gibt auch "
    "ausnahmen.");
  AddDetail( ({"stein"}),
    "Boden, Waende und Decke sind aus hartem Stein.");
  AddDetail( ({ "decke"}),
    "Auch die Decke ist aus Stein.");
  AddDetail( ({ "loch"}),
    "Durch dieses Loch bist Du hereingeschluepft, genauso kommst Du wieder "
    "heraus, es sei denn Du stirbst.");
  AddDetail( ({"bedeutung"}),
    "Die Steine haben keine weitere Bedeutung. Zumindest nicht fuer Dich.");

  AddSound( DEFAULT_SOUND,    
    "Aus dem Gang, hoerst Du leise ein paar Geraeusche.");  
  AddSound( ({ "geraeusche" }),
    "Die Geraeusche kommen aus dem Gang und sind recht leise.");
  AddSound( ({ ""}),
    ".");
  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Tier, nach nassem Fell.");
  AddSmell( ({ "tier" }),
    "Ja, es riecht so gar stark nach Tier.");
  AddSmell( ({ "fell" }),
    "Nasses Fell, baeh, ist ja eklig.");
  
  
//   AddExit( "nordwestoben", ROOM "stueck3" );
   AddExit( "norden", ROOM "hoehle2" );
   AddCmd( ({"schluepfe","schluepf"}), "schluepfen"); 
}


int schluepfen(string str)
{  
   notify_fail( "Wo moechtest Du denn durch schluepfen?\n" );
   if( str == "durch loch" || str == "durch das loch" )    
  {  
     write(BS("Du schluepfst durch das Loch.\n"));
     TP->move(ROOM "stueck5", M_GO, "schluepft durch das Loch", "schluepft",
     "kommt durch das Loch geschluepft");
     return 1;
  }
  return 0;
}

