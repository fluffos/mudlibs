//erstellt am 31.01.2003 von hiri



#include "../def.h"

inherit "std/room";



void create()
{
::create();


  SetProp( P_INT_SHORT, "Auf einer Insel" );
  SetProp( P_INT_LONG,
    "Ploetzlich stehst Du auf einem Weg, der links und rechts mit weissen "
    "gleichmaessigen Steinen umrandet ist. Der Weg ist mit Kieselsteinen "
    "bedeckt und zu beiden Seiten siehst Du Blumen und Buesche wachsen. "
    "Der Weg fuehrt zu einer kleinen Huette, die Du aber noch nicht "
    "genau betrachten kannst.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "blumen", "blume"}),
    "Viele verschiedene Blumen wachsen hier und verstroemen einen "
    "lieblichen Duft.");
  AddDetail( ({ "bluete", "blueten"}),
    "Die Blueten geben Nektar fuer die Insekten und damit eine gute Nahrung ab.");
  AddDetail( ({ "duft"}),
    "Ein herrlicher lieblicher Duft wird von den Blumen verstroehmt, riech "
    "doch mal.");
  AddDetail( ({ "insekt", "insekten"}),
    "Du sieht einige Insekten an den Blueten, sie sammeln fleissig Nektar.");
  AddDetail( ({ "nektar"}),
    "Den Nektar nehmen die Insekten als Nahrung auf.");
  AddDetail( ({ "nahrung"}),
    "Die Insekten nehmen den Nektar der Blueten als Nahrung auf.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus lauter kleinen Kieselsteinen.");
  AddDetail ( ({ "buesche", "busch"}),
    "Buesche des Oleanders stehen hier in allen Farben und sind ordendlich "
    "zurecht geschnitten.");
  AddDetail ( ({ "farben", "farbe"}),
    "Die Farben des Oleander sind vielfaeltig und leuchten kraeftig.");
  AddDetail ( ({ "oleander"}),
    "Der Oleander wetteifert mit den Blumen in allen moeglichen Farben.");
  AddDetail ( ({ "himmel"}),
    "Der Himmel ist hier auch nicht anders als vorher.");
  AddDetail ( ({ "huette"}),
    "Viel von der Huette kannst Du noch nicht erkennen.");
  AddDetail( ({ "kieselsteinen", "kiesel", "kieselsteine"}),
    "Der Weg wurde mit Kieselsteinen bestreut, damit man besser darauf "
    "gehen kann.");
  AddDetail( ({ "seiten"}),
    "Zu beiden Seiten wachsen Blumen und Buesche.");    
  AddDetail( ({ "steinen", "steine"}),
    "Der Weg wurde zu beiden Seiten mit weissen Steinen markiert.");
  AddDetail( ({ "weg"}),
    "Der weg fuehrt zu der kleinen Huette und ist mit Kieselsteinen "
    "bestreut worden.");
  AddSound( DEFAULT_SOUND,
    "Du kannst die Kieselsteine knirschen hoeren, wenn Du diese beruehrst. "
    "Da hier viele Blumen und Buesche sind, hoerst Du auch Insekten summen.");
  AddSound( ({ "insekten" }),
    "Die Insekten brummen und summen hier sehr laut.");
  AddSound( ({ "kieselsteine", "steine"}),
    "Die Kieselsteine knirschen leise, wenn du auf ihnen gehst.");
  AddSmell( DEFAULT_SMELL,
    "Der liebliche Duft der Blumen und Buesche dringt in Deine Nase.");
  AddSmell( ({ "blumen", "blume" }),
    "Die Blumen riechen herrlich und lieblich.");
  AddSmell( ({ "buesche", "busch"}),
    "Die Buesche verstroemen einen lieblich suesslichen Geruch.");
  AddSmell( ({ "nase"}),
    "Mit Deiner Nase kannst Du den Geruch der Blumen und Buesche riechen.");
  AddSmell( ({ "geruch"}),
    "Versuch mal, den Geruch mit Deiner Nase zu erkennen."); 
  AddSmell( ({ "blumen", "blume"}),
    "Du riechst an einer der Blumen und findest den Duft genial.");
  AddSmell( ({ "bluete", "blueten"}),
    "Du schnupperst an einer Bluete und bist begeistert als du den Duft riechst.");
  AddExit( "westen", ROOM "insel5" );
  AddExit( "osten", ROOM "insel7" );
  

}



