#include "../def.h"

inherit "std/room";



void create()
{
::create();

  SetProp( P_INT_SHORT, "In einer tiefen Hoehle" );
  SetProp( P_INT_LONG,
    "Hier macht sich die Kuschelmonsterfrau eine behagliche Stube. Es sieht "
    "aber auch hier noch sehr wuest aus. Ueberall Steine und von der Decke "
    "tropft hier und da mal ein Wassertropfen. Auch hier liegt auf dem "
    "Boden eine Matratze aus Algenblaettern. Kleine Nischen sind in den "
    "Waenden. In der Mitte der Hoehle stehen Kruege herum.");
         
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "kuschelmonsterfrau", "monsterfrau","kuschelmonster"}),
    "Die Kuschelmonsterfrau ist gerade dabei ihre Stube herzurichten.");
  AddDetail( ({"stube"}),
    "Fuer die Kuschelmonsterfrau ist diese Hoehle eine gemutliche Stube.");
  AddDetail( ({"steine"}),
    "Die Steine werden bestimmt noch aus der Stube heraus geraeumt.");
  AddDetail( ({"decke"}),
    "Von der Decke tropft ab und zu einmal ein Wassertropfen.");
  AddDetail( ({"wassertropfen", "tropfen"}),
    "Ab und zu tropft ein Wassertropfen von der Decke.");
  AddDetail( ({"boden"}),
    "Auf dem Boden liegt eine Matratze aus Algenblaettern.");
  AddDetail( ({"matratze"}),
    "Die Matratze dient der Kuschelmonsterfrau als Schlafgelegenheit.");
  AddDetail( ({"algenblaettern","algenblaetter","blaetter"}),
    "Die Algenblaetter lagen am Strand und die Kuschelmonsterfrau "
    "hat sich eine Matratze daraus geknuepft.");
  AddDetail( ({"schlafgelegenheit"}),
    "Die Matratze dient der Kuschelmonsterfrau als Schlafgelegenheit.");
  AddDetail( ({"strand"}),
    "Vom Strand her, gelangt man in die Hoehle.");
  AddDetail( ({"hoehle"}),
    "Die Hoehle wird gerade zur Stube gemacht.");
  AddDetail( ({"kruege"}),
    "Die Kruege stehen in der Mitte der Hoehle.");
  AddDetail( ({"mitte"}),
    "Die Mitte der Stube ist gemeint.");
  AddDetail( ({"nischen"}),
    "In den kleinen Nischen stehen kleine Statuen.");
  AddDetail( ({"statuen"}),
    "Drei kleine Statuen, sie sehen aus wie Kuschelmonster.");
  AddDetail( ({"waende","wand"}),
    "In einer Wand sind die kleinen Nischen. Waende kann man es sowieso nicht "
    "wirklich nennen.");

  
  AddSound( DEFAULT_SOUND,    
    "Aus dem Gang, hoerst Du leise ein paar Geraeusche und hier hoerst Du "
    "ab und zu ein blobb,blobb. Wassertropfen sind das.");  
  AddSound( ({ "geraeusche" }),
    "Die Geraeusche kommen aus dem Gang und sind recht leise.");
  AddSound( ({ "wassertropfen","tropfen"}),
    "Ab und zu faellt ein Wassertropfen mit einem blobb,blobb von der Decke.");
  AddSound( ({ "gang"}),
    "Nur leise sind einige Geraeusche zu hoeren.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Tier, nach nassem Fell.");
  AddSmell( ({ "tier" }),
    "Ja, es riecht so gar stark nach Tier.");
  AddSmell( ({ "fell" }),
    "Nasses Fell, baeh, ist ja eklig. Aber die Kuschelmonsterfrau "
    "ist schwer am arbeiten. Voellig normal.");
		 
  AddItem(NPC "kuschelmami", REFRESH_DESTRUCT); 
 
//   AddExit( "sueden", ROOM "hoehle3" );
   AddExit( "osten", ROOM "hoehle4" ); 
   AddExit( "sueden", ROOM "hoehle5a" ); 
}

