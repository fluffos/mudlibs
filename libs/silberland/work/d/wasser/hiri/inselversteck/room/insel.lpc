//erstellt am 31.01.2003 von hiri



#include "../def.h"

inherit "std/room";



void create()
{
::create();


  SetProp( P_INT_SHORT, "Auf einer Insel" );
  SetProp( P_INT_LONG,
    "Du hast nun die Insel erreicht, die wohl nicht oft betreten wird. "
    "Am Strand gibt es nicht viel zu sehen, ausser schimmernden Sand und "
    "hier und da ein paar trockene Grashalme. In dem Sand liegen kleine "
    "Muscheln und der Strand wird seicht von Wellen umspuelt. Die Sonne "
    "brennt hier wirklich sehr auf Deinen Kopf. "
    "Was fuer eine Hitze! Wenn Du weiter auf die Insel schaust, siehst Du "
    "Palmen und einiges mehr. Vor Dir liegt ein grosser Baumstamm. Woher "
    "kommt der ploetzlich?");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );



  AddDetail( ({"baumstamm","stamm"}),
    "Ueber diesen Baumstamm kannst Du nicht gelangen, Du kannst nur nach "
    "Suedosten oder Nordwesten den Weg weiter gehen.");
  AddDetail( ({"weg"}),
    "Der Weg direkt zur Inselmitte ist durch einen dicken Baumstamm versperrt.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus lauter kleinen Sandkoernern.");
  AddDetail( ({ "sandkoernern", "koernern", "koerner", "sandkoerner" }),
    "Die kleinen, feinen Sandkoerner spuerst Du durch Deine Schuhe nicht.");
  AddDetail( ({ "schuhe"}),
    "Durch Deine Schuhe kannst Du die feinen Sandkoerner nicht deutlich "
    "fuehlen.");
  AddDetail( ({ "grashalme", "halme" }),
    "Die Grashalme sind durch die Hitze sehr vertrocknet.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist strahlend blau und die Sonne scheint von ihm herab.");
  AddDetail( ({ "hitze" }),
    "Die Hitze wird hier immer staerker.");
  AddDetail( ({ "insel","inselmitte" }),
    "Hier beginnt die Insel und erstreckt sich in suedliche Richtung "
    "weiter in das Meer.");
  AddDetail( ({ "meer" }),    
    "Wie es eigentlich ueblich ist, kannst Du auch hier damit rechnen, "
    "dass die Insel von dem Meer umgeben ist.");
  AddDetail( ({ "kopf" }),
    "Auch wenn Du auf Deinem Kopf einen Helm traegst, schuetzt er Dich "
    "nicht vor der Hitze.");
  AddDetail( ({ "helm" }),
    "Der Helm schuetzt Dich betimmt im Kampf, aber vor der Hitze nicht.");
  AddDetail( ({ "kampf" }),
    "Also, Du musst hier ja nicht unbedingt kaempfen, oder?");
  AddDetail( ({ "muscheln", "muschel" }),
    "Hier und da liegen ein paar Muscheln herum, sie sind aber nicht so "
    "interessant.");
  AddDetail( ({ "palmen" }),
    "Hier, wo die Insel beginnt, stehen nur vereinzelt ein paar Palmen herum.");
  AddDetail( ({ "sand" }),
    "Der Sand ist ziemlich feinkoernig und sehr stark durch die Sonne erwaermt.");
  AddDetail( ({ "sonne" }),
    "Die Sonne steht hoch am Himmel und verbreitet eine ziemliche Hitze.");
  AddDetail( ({ "strand"}),
    "Der Strand wirkt sehr einladend, ob es ueberall auf der Insel so ist?");
  AddDetail( ({ "wellen"}),
    "Wellen werden hier immer wieder an den Strand gespuelt und treiben "
    "immer mehr Muscheln und andere Dinge an den Strand.");
  AddDetail( ({ "dinge"}),
    "Die Dinge, die an den Strand gespuelt werden, treiben sonst im "
    "offenen Meer herum.");
  AddDetail( ({ "luft"}),
    "Die Luft riecht nach Meer und ist richtig erfrischend.");
  AddDetail( ({ "nase"}),
    "Mit deiner Nase kannst Du riechen, versuch es einmal."); 
  AddSound( DEFAULT_SOUND,
    "Man kann hier die Wellen hoeren und das leise Rieseln, wenn die Wellen "
    "ueber den Sand gespuelt werden.");
  AddSound( ({ "rieseln" }),
    "Wenn die Wellen ueber den Sand gespuelt werden, hoert man ein Rieseln.");
  AddSound( ({ "wellen" }),
    "Du hoerst, wie die Wellen sanft ueber den Sand gespuelt werden.");
  AddSound( ({ "sand"}),
    "Du kannst hoeren, wie der Sand leicht gegeneinander reibt, waehrend "
    "die Wellen ueber ihn hinweg gespuelt werden.");
  AddSmell( DEFAULT_SMELL,
    "Du ziehst die Luft durch Deine Nase und kannst das Meer riechen.");
  AddSmell( ({ "meer" }),
    "Die Luft, die Du durch Deine Nase atmest, riecht nach dem Meer "
    "und wirkt erfrischend auf Dich.");
  
  AddItem(NPC "nuincorion", REFRESH_DESTRUCT); //hier wird bestimmt das der npc hier im startraum auch anfaengt 
  //das ist auch so wenn du einen einfachen npc hast, der reset ist durch inherit std/npc automatisch 
  //also dein geprogter npc wird in den raum eingefuegt.

//  AddExit( "suedwesten", ROOM "insel3" );
  AddExit( "suedosten", ROOM "insel2" );
  AddExit( "nordwesten", ROOM "bruecke1" );

}



