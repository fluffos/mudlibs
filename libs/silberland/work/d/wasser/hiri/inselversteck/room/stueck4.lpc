#include "../def.h"

inherit "std/room";



void create()
{
::create();

  SetProp( P_INT_SHORT, "Auf einem kleinen Stueck Weg" );
  SetProp( P_INT_LONG,
    "Du gehst den Weg von der Klippe weiter runter und siehst nun, was Dir vorher "
    "verborgen geblieben war, durch die Duene und die Klippen konntest Du den "
    "Strand, der sich vor Dir erstreckt, nicht ausmachen. Du kannst weiters das "
    "Meer und noch etwas das Dich sehr erstaunt, erkennen. Leider kannst Du aber "
    "nicht genau bestimmen, was es ist, dafuer solltest Du den Weg weiter zum "
    "Strand herunter gehen. Es faengt an, immer heisser zu werden. ");
         
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden"}),
    "Der Boden ist hier nicht mehr so feucht, durch die aufkommende Hitze trocknet "
    "er aus.");
  AddDetail( ({ "hitze"}),
    "Die Hitze laesst Dich anfangen zu schwitzen.");
  AddDetail( ({ "duene"}),
    "Du schaust hier direkt auf die Duene und kannst sie betreten.");
  AddDetail( ({ "seite"}),
    "Auf der anderen Seite der Duene siehst Du das Meer.");
  AddDetail( ({ "himmel"}),
    "Auch hier siehst Du natuerlich einen wolkenlosen Himmel, kann ja auch nicht "
    "moeglich sein, dass sich auf dem kurzen Stueck Weg der Himmel veraendert. "
    "Die Sonne scheint erbarmungslos herunter. Vielleicht kann man sich am Strand "
    "eine Abkuehlung verschaffen.");
  AddDetail( ({"sonne"}),
    "Die Sonne scheint erbarmungslos herunter. Vielleicht kann man sich am Strand "
    "eine Abkuehlung verschaffen.");
  AddDetail( ({"abkuehlung","kuehlung"}),
    "Am Strand wirst Du Dir vielleicht eine Abkuehlung verschaffen koennen.");
  AddDetail( ({ "stueck"}),
    "Du gehst auf einem kleinen Stueck Weg, der weiter zu dem Strand fuehrt."); 
  AddDetail( ({"klippe"}),
    "Die Klippe flacht hier immer weiter ab und fuehrt zu einem Strand.");
  AddDetail( ({ "meer"}),
    "Du hoerst das Rauschen des Meeres immer deutlicher.");
  AddDetail( ({ "rauschen"}),
    "Man hoert hier das Rauschen der Wellen, wenn sie ueber den Sand gespuelt "
    "werden, und Du kannst das Meer auch riechen.");
  AddDetail( ({ "sand"}),
    "Hier und da siehst Du hier auf dem Weg schon ein wenig Sand.");  
  AddDetail( ({ "wellen"}),
    "Die Wellen werden seicht auf den Sand gespuelt, noch kannst Du sie nur von "
    "weitem bewundern.");
  AddDetail( ({ "strand"}),
    "Den Strand hast Du bald erreicht.");
  AddDetail( ({"weg"}),
    "Der Weg ist schmal und fuehrt Dich von hier aus zum Strand.");
  

  AddSound( DEFAULT_SOUND,    
    "Du hoerst das Rauschen der heranrollenden Wellen und auch hier hoerst Du "
    "natuerlich die Moewen kreischen. Ab und zu kann man das Bloeken eines "
    "Schafes hoeren.");  
  AddSound( ({"bloeken"}),
    "Irgendwie seltsam, hier das Bloeken eines Schafes zu hoeren. Findest Du "
    "nicht? Was das wohl zu bedeuten hat.?");
  AddSound( ({"schafes","schaf"}),
    "Du hoerst ab und zu ein Schaf bloeken, was Dir sehr seltsam vorkommt.");
  AddSound( ({ "rauschen" }),
    "Das Rauschen der Wellen ist angenehm ruhig.");
  AddSound( ({"wellen"}),
    "Du kannst die heranrollenden Wellen und ihr angenehmes Rauschen "
    "von hier aus hoeren.");
  AddSound( ({ "moewen", "moewe"}),
    "Die Moewen kannst Du hier sehr laut kreischen hoeren.");
  AddSmell( DEFAULT_SMELL,
    "Du kannst hier das Meer riechen und freust Dich schon, sehr bald "
    "am Strand zu sein.");
  AddSmell( ({ "meer" }),
    "Es riecht wunderbar nach dem Meer.");
  
  
   AddExit( "nordwestoben", ROOM "stueck3" );
   AddExit( "suedunten", ROOM "stueck5" );
   AddCmd( ({"betrete" }), "betreten" );
} 


int betreten(string str)
{
   notify_fail("Was moechtest Du betreten?\n");
   if ( member( ({ "duene", "die duene" }),str) != -1) 
  {
    write(BS( "Du setzt den ersten Fuss in Richtung Duene, "
           "als Dir ein kleines Schaf entgegenspringt. Es "
           "laeuft um Dich herum und bleibt hinter Dir stehen. "
	   "Du bist zu verdutzt um noch etwas zutun."));
    say( TPN+" schaut ziemlich bloede aus der Waesche.");

    if ( find_call_out("fall1") == -1 )
      call_out("fall1",4);
    return 1;
  }
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du schaust Dir das Schaf ueber die Schulter an, "
            "es sieht aus wie eine Wolke, was Dich sehr wundert" ));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",6);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  
  write (BS( "Ploetzlich holt das Schaf mit seinen Beinchen aus und "
         "tritt Dir in Deinen Hintern, Du fliegst auf die Duene.") );

  TP->move("/d/luft/hicks/wolkenstadt/room/duene.lpc", M_GO|M_NOCHECK|M_SILENT);
  tell_object(TP,BS(
    "Du landest unsanft auf der Duene. Mit dem Gesicht zuerst "
    "und schluckst Sand."));
  TP->AddHp(-10);
  tell_room(ENV(TP),BS(
    TP->Name()+" faellt unsanft mit dem Gesicht in den Sand."),({TP}));
}
