//erstellt am 25.01.2003 von hiri

#include "../def.h"

inherit "std/room";

void create()
{
 ::create();

  SetProp( P_INT_SHORT, "An einem Strandaehnlichen Landstueck" );
  SetProp( P_INT_LONG,
    "Du stehst ploetzlich auf der anderen Seite des Buschwerkes und schaust "
    "Dich verwundert um und siehst in geraumer Entfernung eine hohe Duene, ueber "
    "die Du aber nicht klettern kannst. Links und rechts von Dir, siehst Du "
    "etwas hoehere Klippen, die dieses Landstueck eingrenzen. Weiters siehst Du "
    "auch einen kleinen Bach, vor dem Du nun stehst, die Quelle ist wohl "
    "innerhalb der linken Klippenreihe und der Bach schlaengelt sich in Richtung "
    "der Duene. Er wird schon etwas breiter und kurz vor der Duene versickert der "
    "Bach dort. Die Sonne wirft ihr helles Licht ueber das Landstueck, das einem "
    "Strand aehnlich ist.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );
  AddDetail( ({ "boden"}),
    "Der Boden besteht hier aus Erde und zur Duene hin wird er immer sandiger.");
  AddDetail( ({ "erde"}),
    "Die Erde ist ein wenig feucht, was wohl daher kommt, dass der Bach hier "
    "entlanglaeuft.");
  AddDetail( ({ "duene" }),
    "Du siehst, dass auf der Duene einige Riedgraeser und Buesche wachsen. "
    "Betreten kann man die Duene aber nicht.");
  AddDetail( ({ "riedgraeser", "graeser"}),
    "Zwischen den Riedgraesern siehst Du ein paar Eidechsen und Krabben.");
  AddDetail( ({ "buesche" }),
    "Die Buesche haben kleine gruene Blaetter und sind sehr dornig.");
  AddDetail( ({ "blaetter" }),
    "Die Blaetter leuchten in einem seltsamen blaugruenen Farbton.");
  AddDetail( ({ "farbton"}),
    "Der Farbton der Blaetter sieht aus, als ob das Meer darin schimmern wuerde.");
  AddDetail( ({ "meer"}),
    "Das Meer scheint wirklich nicht weit weg zu sein. Du glaubst sogar, "
    "es riechen zu koennen.");
  AddDetail( ({ "bach" }),
    "Der Bach ist nicht besonders breit. Das Wasser ist klar und sauber, "
    "Du hoerst leises plaetschern.");
  AddDetail( ({ "wasser"}),
    "Das Wasser plaetschert leise vor sich hin. Es ist nicht tief, "
    "vielleicht kannst Du ja durch gehen.");
  AddDetail( ({ "geraeuschen", "geraeusche"}),
    "Die Geraeusche kommen eindeutig von dem Bach.");
  AddDetail( ({ "lauschen"}),
    "Ja, vielleicht solltest Du mal Lauschen.");
  AddDetail( ({ "buschwerk" }),
    "Durch das Buschwerk bist Du hergekommen, ob Du wohl auch so zurueck "
    "kommst?");
  AddDetail( ({ "krabben", "krabbe"}),
    "Die Krabbe sitzt auf der Duene und schaut Dich mit lustigen Augen an.");
  AddDetail( ({ "augen"}),
    "Die Augen der Krabben stehen etwas aus dem Panzer hervor und sind schwarz.");
  AddDetail( ({ "panzer"}),
    "Der Panzer dieser Krabbe ist schwarz, wenn sie stirbt wird der Panzer "
    "roetlich.");
  AddDetail( ({ "eidechsen", "echse", "eidechse"}),
    "Die Eidechse huscht auf der Duene herum.");
  AddDetail( ({"entfernung"}),
    "Die Entfernung zu der Duene ist ungefaehr vier Meter, rauf klettern kannst "
    "Du nicht.");
  AddDetail( ({ "meter"}),
    "Die vier Meter zu der Duene waeren sicherlich schnell ueberwunden, aber "
    "auf die Duene kannst Du nicht klettern.");
  AddDetail( ({ "himmel"}),
    "Du siehst ein paar Moewen am Himmel und nicht eine Wolke zieht vorrueber.");
  AddDetail( ({ "moewen", "moewe"}),
    "Die Moewen fliegen hoch oben am Himmel.");
  AddDetail( ({ "wolke", "wolken"}),
    "Du siehst nicht eine einzige Wolke am Himmel.");
  AddDetail( ({ "klippenreihe", "klippen","reihe"}),
    "Die Klippen bilden links und rechts von Dir eine Klippenreihe.");
  AddDetail( ({ "landstueck", "land", "stueck"}),
    "Dieses Landstueck ist einem Strand sehr aehnlich.");
  AddDetail( ({ "licht"}),
    "Der Sonne Licht, hier nicht erlischt.");
  AddDetail( ({ "quelle"}),
    "Die Quelle siehst Du von hier aus nicht deutlich genug.");
  AddDetail( ({ "seite"}),
    "Ob es auf der anderen Seite des Baches mehr zu sehen gibt?");
  AddDetail( ({ "sonne"}),
    "Die Sonne steht schon hoch am Himmel.");
  AddDetail( ({ "strand"}),
    "Nuja, eigendlich kann man es nicht als Strand bezeichnen!");
  AddSound( DEFAULT_SOUND,
    "Das leise Plaetschern, was Du hoerst, stammt wohl von dem Wasser des "
    "Baches, ausserdem kannst Du auch noch etwas hoeren, was sich wie das "
    "Meer anhoert. Moewen schreien am Himmel. Die Geraeusche sind ja eindeutig. "
    "Lausch doch mal!");
  AddSound( ({ "plaetschern"}),
    "Das Plaetschern wird von dem Bach herkommen.");
  AddSound( ({ "wasser"}),
    "Eigentlich typische Geraeusche, die das Wasser da von sich gibt.");
  AddSound( ({ "baches", "bach"}),
    "Die Geraeusche des Baches hoeren sich auch nicht anders an, als wenn Du "
    "dem Wasser lauschst.");
  AddSound( ({ "meer"}),
    "Ja, es scheint wirklich da zu sein, das Meer. Seltsam, das Meer muss "
    "ziemlich nah sein.");
  AddSound( ({ "moewen" }),
    "Die Moewen kreischen hoch oben am Himmel, wie sie es ja immer tun.");
  AddSmell( DEFAULT_SMELL,
    "Du riechst die feuchte Erde und das Buschwerk und ganz schwach das Meer.");
  AddSmell( ({ "meer"}),
    "Du kannst das Meer sehr schwach riechen.");
  AddSmell( ({ "erde" }),
    "Du riechst die feuchte Erde.");
  AddSmell( ({ "buschwerk", "busch" }),
    "Das Buschwerk riecht sehr stark.");
  AddCmd(  ({ "geh", "gehe" }), "gehen"  );
  AddCmd(  ({ "zwaeng", "zwaenge" }), "zwaenge"  );
  


  AddItem(NPC "krabbe", REFRESH_DESTRUCT);
  AddItem(NPC "eidechse", REFRESH_DESTRUCT);


} // Ende Create

int gehen(string str)
{
  notify_fail( "Wodurch moechtest Du denn gehen?\n" );
  if( str == "durch bach" || str == "durch den bach" )
  {
    write(BS("Du krempelst Deine Hosenbeine hoch und gehst durch "
    "den Bach.\n"));
    TP->move(ROOM "stueck2", M_GO, "durch den Bach", "geht",
    "kommt durch den Bach hereingelaufen");
    return 1;
  }
  return 0;
}



int zwaenge(string str)
{
  notify_fail( "Wo moechtest Du Dich durchzwaengen?\n" );

  if( str == "durch buschwerk" || str == " durch das buschwerk" )
    {//dann passiert:
    write(BS("Du zwaengst Dich durch das Buschwerk.\n"));
    TP->move( "/d/huegelland/zordan/fischerweg/room/b3b6", M_GO, "sich durch das Buschwerk", "zwaengt",
    "zwaengt sich durch das Buschwerk herein");
    return 1;
  }
  return 0;
}
