//erstellt am 31.01.2003 von hiri

#include "../def.h"

inherit "std/room";


void create()
{
::create();

  SetProp( P_INT_SHORT, "Auf einer geteilten Bruecke" );
  SetProp( P_INT_LONG,
    "Du stehst jetzt auf dem zweiten Teil der Bruecke und kannst "
    "die Insel deutlich vor Dir sehen und siehst den weissen Sand in "
    "der Hitze schimmern. Die Bruecke sieht dem ersten Teil recht aehnlich, "
    "nur der Eisenbeschlag auf dem Gelaender ist hier und da verziert.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Auch hier besteht der Boden aus Holzplanken.");
  AddDetail( ({ "holzplanken", "planken"}),
    "Die Holzplanken sind aus Palmenholz gemacht.");
  AddDetail( ({ "palmenholz", "palmen", "holz"}),
    "Das Palmenholz stammt von der Insel."); 
  AddDetail( ({ "bruecke"}),
    "Die Bruecke ist der Weg zur Insel und zurueck.");
  AddDetail( ({ "weg"}),
    "Die Bruecke bildet den Weg.");
  AddDetail( ({ "eisenbeschlag", "eisen", "beschlag" }),
    "Der Eisenbeschlag ist an dem Gelaender befestigt und hat seltsame Verzierungen.");
  AddDetail( ({ "verzierungen"}),
    "Die Verzierungen sehen aus wie kleine Abbilder und kleine fremde Schriftzeichen.");
  AddDetail( ({ "abbilder"}),
    "Es sind kleine, fein gearbeitete Abbilder von Meerjungfrauen, wunderschoen anzusehen. "
    "Findest Du nicht?");
  AddDetail( ({ "schriftzeichen"}),
    "Die Schriftzeichen sind nur sehr schwer erkennbar, wenn Du an dem Eisenbeschlag "
    "reiben wuerdest, koenntest Du sie ja vielleicht entziffern.");
  AddDetail( ({ "gelaender" }),
    "Das Gelaender ist auch aus Palmenholz, wie sollte es anders sein?");
  AddDetail( ({ "himmel" }),
    "Du kannst auch hier nichts Besonderes am Himmel sehen. "
    "Die Sonne steht aber hoch am Himmel.");
  AddDetail( ({ "sonne"}),
    "Die Sonne verursacht die fast unertraegliche Hitze.");
  AddDetail( ({ "hitze" }),
    "Die Hitze nimmt immer mehr zu, je naeher Du zu der Insel kommst.");
  AddDetail( ({ "insel" }),
    "Es ist nicht mehr weit bis zu der Insel.");
  AddDetail( ({ "sand" }),
    "Den Sand kannst Du von hier schon erkennen.");
  AddDetail( ({ "teil" }),
    "Nun stehst Du auf dem zweiten Teil der Bruecke.");
  AddDetail( ({ "meerjungfrauen", "frauen" }),
    "Die Meerjungfrauen sehen ein wenig wie Elfen aus.");
  AddDetail( ({ "elfen" }),
    "Also, Elfen muessten Dir ja bekannt sein, oder?");
   AddDetail( ({ "holzpfaehlen", "holzpfaehle", "pfaehle"}),
    "Auf den Holzpfaehlen ist die Bruecke gebaut worden.");
  AddDetail( ({ "meer"}),
    "Die Bruecke geht ueber das Meer zu einer Insel. Es riecht ueberall "
    "nach Meer.");

  AddSound( DEFAULT_SOUND,    
    "Du kannst hoeren, wie die Wellen gegen die Holzpfaehle der Bruecke "
    "schlagen."); 
  AddSound( ({ "wellen" }),
    "Du hoerst das leise Rauschen der Wellen, wenn sie gegen die Holzpfaehle "
    "getrieben werden."); 
  AddSound( ({ "rauschen"}),
    "Du hoerst das Rauschen der Wellen.");
  AddSmell( DEFAULT_SMELL,    "Das Meer riecht typisch nach Salz.");
  AddSmell( ({ "salz" }),
    "Du riechst das Salz, was es im Meer massig gibt.");
  
  
  AddExit( "suedosten", ROOM "insel" );
  AddExit( "nordwesten", ROOM "rondell" );

  AddCmd( ({"rubbel", "rubble", "reibe", "reib" }), "rubbel" );
}

int rubbel(string str)
{
   notify_fail("Was moechtest Du rubbeln?\n");
   if ( member( ({ "eisenbeschlag", "beschlag", "den eisenbeschlag", "den beschlag" }),str) != -1) 
  {
    write(BS ( "Du rubbelst an dem Eisenbeschlag und die Schriftzeichen werden deutlicher, "
           "Du kannst sie nun genau erkennen, aber es ist eine Dir fremde Sprache. "));
    say( TPN+" rubbelt an dem Eisenbeschlag und scheint nun mehr erfahren zu haben. ");
    return 1;
  }
} 
