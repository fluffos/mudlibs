#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

nosave int perle_in_nabel;


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  
  perle_in_nabel = 0;
  SetProp(P_SHORT, "Ein kleines Holztor");
  SetProp(P_LONG,
    "Das kleine Holztor was Du hier siehst, gehoert zu der Sandburg. "
    "Es ist richtig fein gearbeitet und es oeffnet sich auf beiden Seiten." );
  SetProp(P_INFO, "Wenn Du Dich tief herunter beugst kannst Du das kleine, "
    "Holztor oeffnen.");
  SetProp(P_NAME, "Holztor");
  SetProp(P_GENDER, MALE);
  AddId( ({ "holztor", "tor", "\nHIRITOR" }) );

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  
  AddCmd(  ({ "oeffne", "oeffnen", "oeffnest" }));  
}
int oeffnen(string str)  
{
  notify_fail( "Was moechtest Du mit dem Holztor machen?\n" );  
  if ( member( ({ "oeffnen" }),str) != -1)
  {
    write("Willst Du das Holztor vielleicht oeffnen?\n");
    return-1;
