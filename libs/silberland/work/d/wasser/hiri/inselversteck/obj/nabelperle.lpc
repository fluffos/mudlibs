#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

nosave int perle_in_nabel;


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  
  perle_in_nabel = 0;
  SetProp(P_SHORT, "Kuschelino`s Nabelperle");
  SetProp(P_LONG,
    "Die Nabelperle von Kuschelino, sie schimmert in einem blaugruenen Farbton "
    "und scheint in sich wabern und magisch zu schimmern." );
  SetProp(P_INFO, "Wenn Du die Perle, die Du von Kuschelino bekommen hast, "
    "in Deinen Bauchnabel steckst, laesst Kuschelino Dich vorbei.");
  SetProp(P_NAME, "Nabelperle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "perle", "nabelperle", "\nHIRIPERLE" }) );

  SetProp(P_MATERIAL, MAT_PEARL );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  
  AddCmd(  ({ "steck", "stecke" }), "stecken");  
}
int stecken(string str)  
{
  notify_fail( "Wohin moechtest Du die Perle stecken?\n" );  
  if ( member( ({ "in bauchnabel","in nabel","in bauch" }),str) != -1)
  {
    write("Willst Du etwa die Perle in deinen Bauchnabel stecken?\n");
    return-1;
  }
  if ( member( ({ "nabelperle in bauchnabel","perle in nabel","perle in bauch",
                  "nabelperle in bauch","nabelperle in nabel",
                  "perle in bauchnabel" }),str) != -1)
  {
    if ( !perle_in_nabel)
    {
      write("Du steckst Dir die Nabelperle in Deinen Bauchnabel.\n");
      say(TPN+" steckt sich eine Perle in "
      +(TP->QueryPossPronoun(MALE,WEN,SINGULAR))+" Bauch.\n"); 
      perle_in_nabel = 1;
  SetProp(P_SHORT, "Kuschelino`s Nabelperle (im Nabel steckend)");
  SetProp(P_LONG,
    "Die Nabelperle von Kuschelino, sie schimmert in einem blaugruenen Farbton "
    "und scheint in sich zu wabern und magisch zu schimmern. Sie steckt " 
    "nun in Deinem Bauchnabel."); 
    SetProp(P_NODROP, "Deine Perle steckt doch im Bauchnabel fest!\n" );
    return 1;
    }   
    write("Du hast die Perle bereits in Deinen Bauchnabel gesteckt!\n");
    return -1;
  }
}
perlegesteckt()
{
  return perle_in_nabel;
}  

void reset()
{
  ::reset();
  write("Deine Perle zerbroeselt ploetzlich, weil ihr Deine Koerperwaerme "
  "zu viel war.\n");
  remove();

}