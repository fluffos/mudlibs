#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alte Flasche");
  SetProp(P_LONG,
    "Diese Flasche hat die Zeit doch recht gut ueberdauert, ausser einem kleinen "
    "Loch ist sie noch fast vollstaendig erhalten." );
  SetProp(P_INFO, "Die Flasche besteht aus Glas und im Inneren schimmert Etwas.");
  SetProp(P_NAME, "Flasche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "flasche", "HIRIFLASCHE"}) );

  SetProp(P_MATERIAL,  ([MAT_GLASS : 100 ]) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp (P_NOSELL, 1);

     AddDetail( ({ "loch" }),
       "Ein kleines Loch ist in der Flasche, nur im Inneren kannst Du noch Etwas erkennen.");
     AddDetail( ({ "etwas"}),
       "An das Etwas kommst Du wahrscheinlich nur, wenn Du die Flasche zerbrichst.");


  AddCmd ( ({"zerbrich", "zerbreche", "zerbrech","zerschlag", "zerschlage"}), "zerbrich");

}
int zerbrich(string str)
{
  object perle;

  notify_fail("Was moechtest Du denn zerbrechen?\n");
  if ( member( ({ "flasche"}),str) != -1)
  {
    perle = clone_object("/obj/pearls/riffperle");
    if ( ME_TOO_HEAVY==perle->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Leider rollt Dir die Perle beim Zerbrechen der Flasche auf den "
        "Boden.\n");
      perle->move(TO,M_NOCHECK);
remove(1);


      return 1;
    }
    write(
      "Du zerbrichst die Flasche und eine kleine weisse Perle faellt heraus "
      "und von der Flasche bleiben nur noch kleine Scherben uebrig.\n");
    say(
      TPN+" zerbricht die Flasche und findet Etwas.\n");
remove(1);
    return 1;

}

}
