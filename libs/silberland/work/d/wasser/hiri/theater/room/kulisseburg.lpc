#include "../def.h"

inherit "std/room";



void create()
{
::create();


  SetProp( P_INT_SHORT, "Auf einer Insel" );
  SetProp( P_INT_LONG,
    "Hier ist weiter nichts besonderes zu sehen, ausser Sand, aber was ist "
    "das? Da hat jemand aus Sand einen Drachen geformt. Auf dem Drachen "
    "flitzt vorwitzig eine Krabbe herum. Sonst kannst Du weiter nichts "
    "besonderes erkennen. Ein paar duerre Grashalme stehen einsam herum "
    "und ein paar Muscheln siehst Du noch.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist hier nur aus Sand.");
  AddDetail( ({ "drachen", "drache" }),
    "Aus Sand hat hier jemand einen Drachen gebaut und er ist vier Meter lang, "
    "der Drache ist sogar farbig, blaugruen eingefaerbt. Vorne sieht der Drache "
    "fast aus wie ein Pferd und der Koerper sieht eben aus wie eine geschuppte "
    "Schlange.");
  AddDetail( ({ "koerper" }),
    "Der Koerper des Drachen sieht aus wie eine lange Schlange.");
  AddDetail( ({ "meter" }),
    "Der Drache aus Sand ist vier Meter lang.");
  AddDetail( ({ "pferd" }),
    "Der Drache sieht vorne aus wie ein Pferd.");
  AddDetail( ({ "schlange" }),
    "Der Koerper des Drachen sieht aus wie eine Schlange, aber auf dem Ruecken "
    "hat er eine Schuppenreihe.");
  AddDetail( ({ "ruecken" }),
    "Der Ruecken des Drachen hat eine Schuppenreihe.");
  AddDetail( ({ "schuppenreihe", "schuppen" }),
    "Die Schuppenreihe ist auch aus Sand geformt, vielleicht kann man sie "
    "beruehren.");
  AddDetail( ({ "grashalme", "halme" }),
    "Die Grashalme sind ziemlich vertrocknet.");
  AddDetail( ({ "himmel" }),
    "Der Himmel ist klar und nicht eine Wolke ist zusehen.");
  AddDetail( ({ "wolke" }),
    "An dem Himmel siehst Du keine einzige Wolke.");
  AddDetail( ({ "krabbe" }),
    "Die Krabbe krabbelt auf dem Drache herum.");
  AddDetail( ({ "muscheln"}),
    "In dem Sand kannst Du ein paar Muscheln erkennen.");
  AddDetail( ({ "sand"}),
    "Der Sand ist ziemlich heiss und ein Drache wurde aus ihm geformt. "
    "Die Wellen kommen nicht bis an den Drachen heran, ist wohl auch "
    "so, sonst waere der Drache schnell zerstoert.");
  AddDetail( ({ "wellen", "welle"}),
    "Die Wellen, werden aus dem offenen Meer hier nur leicht ueber den "
    "Sand gespuelt.");
  AddDetail( ({ "meer"}),
    "Die Insel, liegt ihr schon recht weit im grossen Meer, hier ist es "
    "wirklich schoen anzusehen.");
  AddDetail( ({ "insel"}),
    "Du bist fast ueber die ganze Insel gelaufen, was Dich wohl jetzt "
    "noch erwartet? Du weist es nicht.");
  

  
  AddItem(NPC "krabbeinsel", REFRESH_DESTRUCT);
//  AddItem(NPC "ixub", REFRESH_DESTRUCT);
  
  AddExit( "nordwesten", ROOM "insel5" );
  AddExit( "osten", ROOM "steg" );
}
