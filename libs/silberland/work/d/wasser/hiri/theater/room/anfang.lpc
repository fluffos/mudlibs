#include "../def.h"

inherit "std/room";



void create()
{
::create();


  SetProp( P_INT_SHORT, "RPG Treffpunkt" );
  SetProp( P_INT_LONG,
    "Dieser Raum ist dazu da, Kulissen zu erstellen. Damit man sich "
    "waerend des Rollenspieles, in die jeweilige Umgebung hinein "
    "versetzen kann. Du kannst zwischen den Kulissen waehlen und mit "
    "erzeuge kulisse-name- eine Kulisse erzeugen und wirs sofort in diesen "
    "gebracht. Eine Liste mit den Kullisennamen erhaelst du mit Liste. ");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist hier nur aus Sand.");
  AddDetail( ({ "drachen", "drache" }),
    "Aus Sand hat hier jemand einen Drachen gebaut und er ist vier Meter lang, "
    "der Drache ist sogar farbig, blaugruen eingefaerbt. Vorne sieht der Drache "
    "fast aus wie ein Pferd und der Koerper sieht eben aus wie eine geschuppte "
    "Schlange.");
 

 
  

  
//  AddItem(NPC "krabbeinsel", REFRESH_DESTRUCT);
//  AddItem(NPC "ixub", REFRESH_DESTRUCT);
  
//  AddExit( "nordwesten", ROOM "insel5" );
//  AddExit( "osten", ROOM "steg" );

AddCmd( ({"erzeuge" }), "erzeugen" );


}
int erzeugen  (string str)
{
   notify_fail("Was moechtest Du erzeugen?\n");
   if ( member( ({ "kulisse" }),str) != -1) 
  {
    write(BS( " Du erzeugst einen raum mit der Kulisse von "
           "Burg Sturmfels."));
    say( TPN+" Erzeugt eine Kulisse.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",4);
    return 1;
  }
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du schaust gebannt zu als ein neuer Ausgang entsteht und "
	    "die von dir gewuenschte Kulisse entsteht." ));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (BS( " Du kannst es kaum erwarten den Raum zu betreten.") );
  TP->move( ROOM "kulisseburg", M_GO, "geht in einen anderen Raum.");

  
}

