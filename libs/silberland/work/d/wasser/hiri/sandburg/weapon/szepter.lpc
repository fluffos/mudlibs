
inherit "std/weapon";
#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
//#include <class.h>


void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Szepter");
  SetProp(P_LONG,
    "Dieses Szepter scheint es in sich zu haben. Auf den ersten Blick kannst "
    "Du kaum erkennen wozu es gut sein soll. Es ist guelden und hat einen "
    "Diamantbesetzten Griff. An dem oberen Ende sieht es seltsam aus. Vielleicht "
    "ist dort ein gefaehrliches, unheimliches Geheimnis verborgen.");
  SetProp(P_INFO, "Dieses Szepter ist etwas besonderes. Wenn Du es im Kampf benutzt, "
    "bilden sich magische, unsichtbare Peitschenstraenge aus dem Szepter. Eine geistliche, "
    "unheimliche Macht scheint sich auf dieses Szepter uebertragen zu haben.");
  SetProp(P_NAME, "Szepter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"szepter", "peitsche"}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 140+random(10));
  SetProp(P_WC_FIX, 40);
  SetProp( P_QUALITY_DECAY, 250 );
  SetProp(P_WC_BONUS,
    (["Peitschenkaempfer":50, "Peitschenexperte":150, "Peitschenmeister":250]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_INVIS: 60, MAT_DIAMOND:20, MAT_GHOST:20]) );
  SetProp(P_WEIGHT, 1400);
  SetProp(P_VALUE, 1200);
  SetProp(P_SIZE, 85);
  SetProp(P_HIT_FUNC, this_object());
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:12,
                     SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD,([P_HP:5,P_SP:-1]));
   

  AddDetail( ({"szepter"}),
    "Du siehst einfach nichts, aber es koennte etwas "
    "an dem Szepter sein.");
  AddDetail( ({"blick"}),
    "Dein Blick bleibt fasziniert an dem Szepter haengen.");
  AddDetail( ({"griff","diamanten"}),
    "Der Griff des Szepters ist mit Diamanten besetzt.");
  AddDetail( ({"ende"}),
    "Ob ein Geheimnis am oberen Ende verborgen ist?");
  AddDetail( ({"geheimnis"}),
    "Vielleicht solltest Du das Szepter genauer betrachten, "
    "um mehr ueber es zu erfahren.");
}


int HitFunc(object enemy)
  
  {
 
    switch(random(20))
    {    
      case 1 .. 3 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_COLD})); break;
      case 4 .. 7 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_LIGHTNING})); break;
      case 8 .. 10 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_MIND})); break;
      case 11 .. 13 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_AIR})); break;
      case 14 .. 16 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_ELECTRIC})); break;
      case 17 .. 18 :
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_TERROR})); break;
      case 19 .. 20:
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_LIGHT})); break;
    {	
      if(!random(6))
           break;
// default: break;
       default : SetProp(P_DAM_TYPE, ({DT_SLASH})); break;
                 enemy->SetProp(P_DISABLE_ATTACK, 5);
    }          
  }
    		     
 if(enemy->QueryProp(P_GUILD)=="paladine") // auf paladine hau ma mal aerger drauf!
    return 10+random(50);
 if(QueryProp(P_WIELDED)->QueryProp(P_GUILD) == "paladine") 
  {
 if(!random(5))
  {
 QueryProp(P_WIELDED)->Message(BS("Eine verfluchte Kaelte zehrt an Deinen Kraeften!")+"\n"+
                               BS("Auf dieser Klinge muss ein uralter Fluch lasten!"));
 QueryProp(P_WIELDED)->do_damage(1+random(4));
    }
  }
 return 0;   /* ansonsten keinen zusaetzlichen Schaden anrichten */
}

