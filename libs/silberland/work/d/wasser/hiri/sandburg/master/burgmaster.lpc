//Master Sandburg @hiri

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>


object *geist;
object *geistfeinde;

void create()
{
  if (is_clone(TO))
  {
    destruct(TO);
    return;
  }

  geist = ({});
  geistfeinde = ({});
  
  seteuid(getuid(TO));
  return;
}

//GEISTMASTER
add_geist()
{
  geist += ({ PO });
}
ruf_um_hilfe(object spieler)
{
  if ( member(geistfeinde,spieler) == -1 )
    geistfeinde += ({ spieler });
}
remove_geist()
{
  geist -= ({ PO });
}
int IsGeistfeind(object enemy)
{
  if ( member(geistfeinde,enemy) != -1 )
    return 1;
  else
    return 0;
}
void Sieg(object player)
{
  geistfeinde -= ({ player });
}
//ENDGEISTMASTER


void reset()
{
  geistfeinde = ({});
  
  return;
}
