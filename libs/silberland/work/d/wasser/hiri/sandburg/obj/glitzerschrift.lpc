//Hicks - 26.5.2004

#include "../def.h"

inherit "std/thing";

object owner;
string farbe;
string text1;
string text2;

void create()
{
  
  
  
  if (!is_clone(TO)) return;
  ::create();
  
  farbe=({"weisse","gelbe","orangene","rote","rosafarbene","lilafarbene",
	    "blaue","tuerkise","gruene","goldene","silberne","schwarze",
	    "braune"})[random(13)];
  
  
  text1=({"IST EINFACH SPITZE!",
	    "IST SOOO TOLL!",
	    "IST ZUM KNUTSCHEN!",
	    "IST ZUM KNUDDELN!",
	    "HAT EINEN SUESSEN POPO!",
	    "IST JA SOOO SUESS!",
	    "FINDET DICH KNUFFIG!",
	    "KANN WIRKLICH TOLL METZELN!",
	    "KANN WIRKLICH TOLL FORSCHEN!",
	    "IST EIN ASS!",
	    "IST UNWIDERSTEHLICH!",
	    "FOR MUDGOTT!",
	    "FOR PRESIDENT!",
	    "IST ECHT COOL!"})[random(14)];
  
  text2=({"DU BIST EINFACH SPITZE!",
	    "DU BIST SOOO TOLL!",
	    "DU BIST ZUM KNUTSCHEN!",
	    "DU BIST ZUM KNUDDELN!",
	    "DU HAST EINEN SUESSEN POPO!",
	    "DU BIST JA SOOO SUESS!",
	    "DU BIST DICH KNUFFIG!",
	    "DU KANNST WIRKLICH TOLL METZELN!",
	    "DU KANNST WIRKLICH TOLL FORSCHEN!",
	    "DU BIST EIN ASS!",
	    "DU BIST UNWIDERSTEHLICH!"})[random(11)];
  
  SetProp(P_SHORT, "Eine "+farbe+" Glitzerschrift");
  //  SetProp(P_LONG,"Da steht: "+owner->Name()+" "+text1+" in "+farbe+"n Lettern.");
  SetProp(P_INFO, "Sie ist magisch und war wohl eine Ueberraschung.");
  SetProp(P_NAME, "Glitzerschrift");
  SetProp(P_GENDER, NEUTER);
  AddId( ({farbe,farbe+" glitzerschrift",farbe+" schrift",farbe+" glitzer",
	     "glitzerschrift","schrift","glitzer"}));
  
  SetProp(P_MATERIAL, ([MAT_MAGIC: 100]));
  SetProp(P_WEIGHT, 1);
  SetProp(P_NOGET, 1);
  
  
  
  call_out("kill", 300);
}

void kill()	
{
  if(MENV)
    {
      tell_room(ENV(TO),BS("Die "+farbe+" Glitzerschrift verblasst immer "
			   "mehr und verschwindet vollkommen."));
    }
  
  remove();
}

void reset()
{
  ::reset();
  remove();
}

void SetMyOwner (object theowner)
{
  owner=theowner;
}

string _query_long()
{
  
  if(objectp(owner))
    return "Da steht in "+farbe+"n Lettern: "+upperstring(owner->Name())+" "+text1+"!!\n";
  
  else
    
    return "Da steht in "+farbe+"n Lettern: "+text2+"!!\n";
}
