//Hicks - 26.5.2004

#include "../def.h"
#include <properties.h>
#include <food.h>

inherit "std/food";

void create()
{
  string farbe;
  
  if (!is_clone(TO)) return;
  ::create();
  
  farbe=({"weisse","gelbe","orangene","rote","rosafarbene","lilafarbene",
	    "blaue","tuerkise","gruene","goldene","silberne","schwarze",
	    "braune"})[random(13)];
  
  SetProp(P_SHORT, "Eine "+farbe+" Papierverpackung");
  SetProp(P_LONG, "Das duerfte die "+farbe+" Papierverpackung eines ausgepackten "
	  "Ueberraschungseies sein.");
  SetProp(P_INFO, "Sie duerfte aus Esspapier bestehen.");
  SetProp(P_NAME, "Papierverpackung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({farbe,farbe+" papierverpackung",farbe+" papier",farbe+" verpackung",
	     "papierverpackung","papier","verpackung"}));
  
  SetProp(P_MATERIAL, ([MAT_PAPER: 100]));
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 15);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_FOOD_STATE, F_BAKED);
  SetProp(P_FOOD_INFO, ([F_HEAL     : ({ 2,0}),
			 F_SOAK     : 1,
			 F_VERB     : "essen",
  			 F_MSG      : "Du beisst von der "+farbe+"n Papierverpackung ab und "
			 "sie schmeckt wirklich lecker. Schon steckst Du den Rest "
			 "in den Mund.",
    			 F_MSG_ROOM : "kaut auf einer "+farbe+"n Papierverpackung herum.",
  			 F_VERB     : "essen"]));
  
  start_decay(43200, 7200);
  
  AddDetail( ({"ueberraschungseies","ei","ueberraschungsei"}),
	     "Jemand duerfte ein Ueberraschungsei ausgepackt haben und die "
	     "papiernerne Verpackung weggeschmissen haben.");
  
  AddDetail( ({"jemand"}),
	     "Dieser Jemand weiss wohl nicht, wie man diese Verpackung am "
	     "besten zu entsorgen hat. So ein Umweltverschmutzer!");
  
  AddDetail( ({"umweltverschmutzer","verschmutzer"}),
	     "Leider weisst Du nicht, wer das ist.");

}
