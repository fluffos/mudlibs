//Hicks - 26.5.2004

#include "../def.h"
#include <properties.h>
#include <food.h>

inherit "std/food";

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein paar Schokoladestueckchen");
  SetProp(P_LONG, "Du haelst die Schokoladestueckchen Deines zerbrochenen "
	  "Ueberraschungseies in der Hand.");
  SetProp(P_INFO, "Sie schmelzen im Mund und nicht in der Hand.");
  SetProp(P_NAME, "Schokoladestueckchen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"schokolade","schokostueckchen","schokoladestueckchen",
	     "stueckchen","schoko","\nHICKSEI"}));
  
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD: 100]));
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_FOOD_STATE, F_COOKED);
  SetProp(P_FOOD_INFO, ([F_HEAL     : ({ 0,25+random(25)}),
			 F_SOAK     : 10,
			 F_VERB     : "essen",
  			 F_MSG      : "Du steckst Dir die Stueckchen in den "
			 "Mund und laesst sie auf der Zunge zergehen. "
			 "Mhhhhhh! Lecker!",
    			 F_MSG_ROOM : "steckt sich Schokoladestueckcehn in "
			 "den Mund und laesst sie auf der Zunge zergehen.",
  			 F_VERB     : "essen"]));
  
  start_decay(43200, 7200);
  
  AddDetail( ({"ueberraschungseies","ei","ueberraschungsei"}),
	     "Das hast Du ist schon ausgepackt und auseinander gebrochen. "
	     "Jetzt hast Du nur noch die Schokoladestueckchen in der Hand.");
  
  AddDetail( ({"hand"}),
	     "Du haelst die Stueckchen gerade in Deiner Hand. Hoffentlich "
	     "schmelzen sie nicht!");
  
}

void init() 
{
  ::init();
  
  if(MENV)
    if(interactive(MENV))
      if(present("\nHICKSEI 2", MENV))
	{
	  tell_object(MENV, "Da Du ja schon eine Ueberraschung hast, wirfst Du "
			  "sie wieder auf den Boden.\n");
	  
	  move(ENV(MENV), M_NOCHECK);
	}
}
