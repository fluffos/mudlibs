//Hicks - 26.5.2004

#include "../def.h"

inherit "std/thing";

int verpackung=0;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Ueberraschungsei");
  SetProp(P_LONG,"Das ist ein kleines, magisches Ueberraschungsei, das sicher viel "
	  "Schokolade und eine tolle Ueberraschung enthaelt. Es ist "
	  "noch eingepackt.");
  SetProp(P_INFO, "Du koenntest es auspacken und dann auseinander brechen. Es "
	  "enthaelt sicher eine magische Ueberraschung.");
  SetProp(P_NAME, "Ueberraschungsei");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"ueberraschungsei","ue-ei","ueei","ei","\nHICKSEI"}));
  
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD: 100]));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);
  
  AddDetail( ({"schokolade"}),
	     "Dir rinnt das Wasser im Mund zusammen.");
  
  AddDetail( ({"wasser"}),
	     "*sabber*");
  
  AddDetail( ({"mund"}),
	     "Dein Mund ist schon ganz nass.");
  
  AddDetail( ({"ueberraschung"}),
	     "Du musst das Ei schon auspacken und auseinander brechen, um die "
	     "Ueberraschung zu sehen.");
  
  AddCmd( ({"packe","pack","wickle","wickel"}), "cmd_auspacken");
  AddCmd( ({"breche","brich","brech"}), "cmd_brechen");
  AddCmd( ({"iss","esse","ess"}), "cmd_essen");
  
}
int cmd_brechen(string str)
{
  object stueckchen;
  object glitzer;
  notify_fail("Was willst Du auf oder auseinander brechen?\n");
  if(!(str=="ueberraschungsei auf"||
	str=="ei auf"||
	str=="ueei auf"||
	str=="ue-ei auf"||
	str=="ueberraschungsei auseinander"||
	str=="ei auseinander"||
	str=="ueei auseinander"||
	str=="ue-ei auseinander"||
	str=="ueberraschungsei entzwei"||
	str=="ei entzwei"||
	str=="ueei entzwei"||
	str=="ue-ei entzwei"))
	  return 0;
    
    
    if(verpackung!=1)
      {
	write(BS("Du kannst es noch nicht auseinander brechen, wenn das "
		 "Ueberraschungsei noch eingepackt ist."));
	return -1;
      } 
    else 
      {
	move(ENV(TP), M_NOCHECK);
	stueckchen=clone_object(OBJ "stueckchen");
	if (ME_TOO_HEAVY==stueckchen->move(TP,M_GET|M_SILENT))
	  {
	    write(BS("Du brichst das Ueberraschungsei auseinander und haeltst die "
		     "Schokostueckchen in der Hand. Ploetzlich wird dir die Schokolade zu "
		     "schwer."));
	    stueckchen->move(ENV(TP),M_NOCHECK);
	    remove(1);
	  }
        write(BS("Du brichst das Ueberraschungsei auseinander und ploetzlich "
		 "sprueht ein bunter Glitter aus dem Ei. Eine Glitzerschrift "
		 "bildet sich in grossen Lettern mitten im Raum. So eine "
		 "Ueberraschung!!!"));
	say(BS(TPN+" zerbricht das Ueberraschungsei und ploetzlich sprueht ein "
	       "bunter Glitter aus dem Ei. Eine Glitzerschrift bildet sich "
	       "in grossen Lettern mitten im Raum. So eine Ueberraschung!!!"));
	
	glitzer=clone_object(OBJ"glitzerschrift");
	glitzer->SetMyOwner(TP);
	glitzer->move(ENV(TP));
	remove(1);
	return 1;
	
      }
  return 1;
}

int cmd_auspacken(string str)
{
  object eiver;
  notify_fail("Was willst Du auspacken?\n");
  
  if(!(str=="ueberraschungsei aus"||
	str=="ei aus"||
	str=="ueei aus"||
	str=="ue-ei aus"))
	  return 0;
    
  if(verpackung!=1)
    {
      eiver=clone_object(OBJ"ueeiver");
      write(BS("Du wickelst vorsichtig das Papier von der Schokolade und "
	       "wirfst die Verpackung zu Boden."));
      
      say(BS(TPN+" wickelt ein Ueberraschungsei aus und wirft die "
	     "Papierverpackung zu Boden."));
      eiver->move(ENV(TP));
      
      verpackung=1;
      
    }
  else
    {
      write(BS("Du hast doch schon laengst das Papier von dem "
	       "Ueberraschungsei gewickelt."));
      
    }
  SetProp(P_SHORT, "Ein ausgepacktes Ueberraschungsei");
  SetProp(P_INFO, "Das Ei kannst Du jetzt auseinander brechen.");
  SetProp(P_LONG, "Das ist ein kleines Ueberraschungsei, das sicher viel "
	  "Schokolade und eine tolle Ueberraschung enthaelt. Es ist "
	  "schon ausgepackt.");
  SetProp(P_WEIGHT, 45);
  SetProp(P_VALUE, 35);
  SetProp(P_NOBUY, 1);
  
  return 1;
}

int cmd_essen(string str)
{
  if(id(str))
  notify_fail("Das Ueberraschungsei kannst Du so noch nicht essen.\n");
  
  return 0;
}

void init() 
{
  ::init();
  
  call_out("immer_nur_eines", 1);
}
  
void immer_nur_eines()
{
  if(MENV)
    if(interactive(MENV))
      if(present("\nHICKSEI 2", MENV))
	{
	  tell_object(MENV, "Da Du ja schon eine Ueberraschung hast, wirfst Du "
		      "sie wieder auf den Boden.\n");
	  
	  move(ENV(MENV), M_NOCHECK);
	}
}
