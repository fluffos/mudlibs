//Sandburg


inherit "std/npc";

#include "../def.h"
#include <class.h>
#include <properties.h>
#include <combat.h>
#define BURGMASTER "/d/wasser/hiri/sandburg/master/burgmaster"




void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fea Ehtele, die Wirtin");
  SetProp(P_LONG, "Ehtele ist eine wunderschoene Frau mit langen, weissen Haaren. "
      "Ihre klaren, dunkelgrauen Augen fesseln Dich. Sie ist nur sehr durchscheinend "
      "und es scheint Dir als waere sie ein Geist. Sie wirkt mysterioes und "
      "freundlich zugleich.");

  SetProp(P_NAME, "Fea Ehtele");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));
//-------------------------------------------------------------------------
// Die ID "roglar" muss gesetzt werden, da er als P_PUBKEEPER_ID in der
// Kneipe (kneipe_120.c) gesetzt ist.
//-------------------------------------------------------------------------
  AddId( ({"ehtele","fea ehtele","geist","wirtin"}) );
  set_living_name("geist");
  
  AddClass(({CL_FLYING, CL_UNDEAD}));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 160);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
//  SetProp(P_LOG, "hiri/burg.log"); 
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "fuegt sich zusammen aus dem Nichts.");
  SetProp(P_MMSGOUT, "zerfliesst in der Luft.");

  AddInfo(DEFAULT_INFO, "Was darf es sein? Ein Schnaps?","fragt Dich: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );


  BURGMASTER -> add_geist();

}

void init()
{
  ::init();

 if ( BURGMASTER -> IsGeistfeind(TP) ) Kill(TP);

 
}


//masterbeginn

 


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  BURGMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\ngeist") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\ngeist") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  BURGMASTER -> remove_geist(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) BURGMASTER -> Sieg(player);
}  



