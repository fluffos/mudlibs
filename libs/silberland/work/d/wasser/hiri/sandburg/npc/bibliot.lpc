
#include "../def.h"

#include <ansi.h>

#define BEZ1 "weiser"
#define BEZ2 "geist"

inherit NPC "std_ghost";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, CAP(BEZ1)+" "+CAP(BEZ2)+ " der Bibliothekar");

  SetProp(P_NAME, "Colindo "+CAP(BEZ1)+" "+CAP(BEZ2));
  SetProp(P_GENDER, MALE);
  AddId( ({"colindo"
          ,BEZ1, BEZ2, BEZ1+" "+BEZ2
          ,"bibliothekar"
          ,"HIRICOLINDO"
          ,NOGLOBALATTACK
          }) );

  SetProp(P_ARTICLE, 0);

  create_default_ghost(20);

  SetProp(P_AGGRESSIVE,0);


  SetProp(P_MURDER_MSG, "Es wird ein furchtbares Ende mit Dir nehmen, %s...");

  AddInfo(DEFAULT_INFO, "murmelt etwas unverstaendliches.\n");

  AddInfo( ({"hiri"}), "Hiri hat mich erschaffen.","sagt: ");

  AddInfo( ({"mulash"}),
    ". "
    ". "
    " "
    ".",
    "sagt: ");

  SUID;
}

void cmdunt(object pl)
{
  string s;

  s = BS("Das untersuchen von "+name(WER)+" hat Dich Kraft gekostet. "
         "Denn "+name(WER)+" mag es gar nicht, wenn jemand unerlaubt "
	 "seine Geheimnisse erforschen moechte. ");

  if(pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
  tell_object(pl, "\n"+s);

  pl->AddHp(-10);
  pl->AddSp(-10);

  AddHp(10);
  AddSp(10);
}

string _query_long()
{

  if(TP && TI && interactive(TP) && interactive(TI) && TP == TI)
  {
    call_out("cmdunt", 0, TP);
  }

  return BS("Celindo ist ein sehr alter Weiser Geist und kann "
            "sehr viel ueber das Silberland wiedergeben. "
            "Er kam einst hierher um eine Lebensaufgabe zu finden."
	    "Die hat er hier in dieser schoenen Bibliothek gefunden.
	    ");
}
