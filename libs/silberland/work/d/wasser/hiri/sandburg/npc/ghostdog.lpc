inherit "std/npc";
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#define BURGMASTER "/d/wasser/hiri/sandburg/master/burgmaster"



void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Der Gul");
  SetProp(P_LONG,
    "Der Gul ist ein Geisterhund und er sitzt in dem Zwinger. "
    "Er knurrt Dich boese an und es waere besser den Zwinger "
    "nicht zu oeffnen.");

  SetProp(P_NAME, "Gul");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:80]));

  AddId(({"gul", "geisterhund","hund", "HIRIDOG" }));
  set_living_name("geist");
  AddClass(CL_UNDEAD);
  SetProp(P_RACE, "Hund");

  create_default_npc(25);

  SetProp(P_DEFAULT_INFO, "knurrt Dich boese an.\n");
  SetProp(P_AGGRESSIVE, 0.9);
  SetProp(P_HANDS, ({" mit seinem scharfen Gebiss", QueryProp(P_HANDS)[1], DT_RIP }) );

  SetProp(P_ALIGN, -600);
  SetProp(P_SIZE, 140);
  SetProp(P_WIMPY, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" zerreist @WEN in kleine Haeppchen.\n" }) );

  
 

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "streunt nach#");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "springt davon");

  SetProp(P_DIE_MSG,  " jault noch einmal auf.\n");
  SetProp(P_KILL_NAME, "Ein Gul");
  SetProp(P_KILL_MSG, "Frisches Fleisch und klebriges Blut fuer mich!");

  SetAttackChats(20,
    ({BS(Name(WER,1)+" knurrt Dich an.")
     ,BS(Name(WER,1)+" springt Dir an die Kehle.")
     ,BS(Name(WER,1)+" lechzt nach Blut.")
     ,BS(Name(WER,1)+" zielt auf Deine Kehle.")
     ,BS(Name(WER,1)+" wirft Dich um.")
     ,BS(Name(WER,1)+" sabbert Dich mit Schleim an.")
     })
  );

  AddSpell(9,400,
    Name(WER,1)+" beisst Dir in Dein Bein.\n",
    Name(WER,1)+" beisst @WEN ins Bein.\n",
    ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );

//  SetProp(P_LOG, "hiri/burg.log"); 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Gul will Deine Sachen nicht tragen.\n" }) );
 


/*  SUID;
  CLONEME(WEAPON "dreispitz" );
  command("zuecke waffe");
  CLONEME(ARMOUR "algenguertel" );
  CLONEME(ARMOUR "schuppenhose" );
  CLONEME(ARMOUR "maennerstring");
  CLONEME(ARMOUR "seidenhemd");
  command("trage alles");*/



 BURGMASTER -> add_geist();

}

void init()
{
  ::init();

 if ( BURGMASTER -> IsGeistfeind(TP) ) Kill(TP);

 
}
//masterbeginn

 


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  BURGMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\ngeist") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\ngeist") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  BURGMASTER -> remove_geist(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) BURGMASTER -> Sieg(player);
}  




