inherit "/p/std/npc/nekro_npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include "../def.h"

create()
{
  object cash;
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG, "Vor Dir steht ein vollkommen fleischloses Skelett. Seine "
      "Knochen sehen schon recht muerbe aus, einige sind schon gesplittert. "
      "Nichtsdesdotrotz wirken seine Knochenkrallen sehr gefaehrlich. Der "
      "Schaedel scheint irgendwie zu grinsen.");
      
  SetProp(P_NAME,"Skelett");
  AddId(({ "skelett" }));
  AddClass(CL_SKELETON);
  create_default_npc(13+random(7));

  SetProp(P_GENDER, NEUTER);
  SetProp(P_RACE, "Skelett");
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_BODY, 150);
  SetProp(P_HANDS, ({" mit Knochenkrallen", 200, ({DT_RIP})}));
  SetProp(P_ALIGN, -800);
  SetProp(P_SIZE, 180+random(30));
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20, T_RANGE_MAX: 20]) );
  SetProp(P_RESISTANCE, ({DT_COLD, DT_POISON, DT_RIP, DT_FIRE, DT_PIERCE,
        DT_UNHOLY}));
  SetProp(P_NOCORPSE, 1);

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(100));
  cash->move(ME);
 

  SetProp( P_REJECT, ({ REJECT_DROP, "Das Skelett laesst es fallen.\n" }) );
  SetProp( P_DIE_MSG, " zerfaellt zu Staub.\n");
  SetProp( P_KILL_MSG, ({"scheint irgendwie zu grinsen",MSG_EMOTE}));
//  SetProp(P_LOG, "hiri/burg.log"); 


  
  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MMSGIN, "klappert herein");
  SetProp(P_MMSGOUT, "klappert hinaus");
  SetProp(P_MSGOUT, "klappert");
  SetProp(P_SPELLRATE, 30);
  AddSpell(1,500,
	" Das Skelett rammt seine Knochenfinger in Dich hinein.\n",
	" Das Skelett rammt seine Knochenfinger in @WEN hinein.\n");

  SetProp(P_MNPC_AREA,( {ROOM "zinne", ROOM "kerker"}));
  SetProp(P_MNPC_WAIT, ({ 15, 40, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "kerker" );
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + 
      MOV_BACKWARDS);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([
      DT_SLASH:      0.2, DT_BLUDGEON:   0.1, DT_PIERCE:  0.4, DT_SQUEEZE: 0.4, 
      DT_WHIP:       0.3, DT_RIP:        0.3,
      DT_FIRE:       0.2, DT_COLD:       -0.20, DT_WATER:  0.2, DT_AIR:    0.1, 
      DT_LIGHTNING:  0.3, DT_EXPLOSION:  0.1, DT_SOUND:   0.5, DT_LIGHT:   -0.1,
      DT_ELECTRIC:   0.3, DT_ACID:       0.0, DT_POISON:  0.3, DT_TERROR: 1.0,
      DT_HOLY:       0.3, DT_UNHOLY:     0.4, DT_MAGIC:   0.7 ]) ); 

 
}

void die(int poisondeath) {
  write_file(LOG "burg.log",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Skelett.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "burg.log",
      ctime()+": Skelett hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

