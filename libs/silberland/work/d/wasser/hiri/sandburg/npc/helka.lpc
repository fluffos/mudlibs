//erstellt von hiri maerz04

inherit "std/npc";


#include "../def.h"
#include <class.h>
#include <properties.h>
#include <combat.h>
#define BURGMASTER "/d/wasser/hiri/sandburg/master/burgmaster"


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Helka, der Totengraeber");
  SetProp(P_LONG,
    "Helka fuehrt diesen Laden in dem man nur Urnen kaufen "
    "kann. An den Waenden stehe Glasvitrienen. Einige "
    "Urnen kann man dort betrachten.");

  SetProp(P_NAME, "Helka");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));
//-------------------------------------------------------------------------
// Die ID "tora" muss gesetzt werden, da sie als P_SHOPKEEPER_ID im Laden
// (laden_110.c) gesetzt ist.
//-------------------------------------------------------------------------
  AddId( ({"helka","totengraeber","geist"}) );
  set_living_name("geist");
  AddClass(CL_UNDEAD); // siehe /sys/class.h

  create_default_npc(35);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Geist");
  SetProp( P_SIZE, 80+random(30) );
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_WIMPY, 0);

//-------------------------------------------------------------------------
// NPC hat einen Namen, daher kein unbestimmter Artikel verwenden
//-------------------------------------------------------------------------
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");
//  SetProp(P_LOG, "hiri/burg.log"); 
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([
      DT_SLASH:      0.2, DT_BLUDGEON:   0.1, DT_PIERCE:  0.4, DT_SQUEEZE: 0.4, 
      DT_WHIP:       0.3, DT_RIP:        0.3,
      DT_FIRE:       0.2, DT_COLD:       0.20, DT_WATER:  0.2, DT_AIR:    0.1, 
      DT_LIGHTNING:  0.3, DT_EXPLOSION:  0.1, DT_SOUND:   0.5, DT_LIGHT:   -0.1,
      DT_ELECTRIC:   0.3, DT_ACID:       0.0, DT_POISON:  0.3, DT_TERROR: 1.0,
      DT_HOLY:       0.3, DT_UNHOLY:     0.4, DT_MAGIC:   0.7 ]) ); 
 

  AddInfo(DEFAULT_INFO, "Moechten sie eine Urne kaufen?","fragt Dich: ");
  

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );

 BURGMASTER -> add_geist();

}

void init()
{
  ::init();

 if ( BURGMASTER -> IsGeistfeind(TP) ) Kill(TP);

 
}


//masterbeginn

 


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  BURGMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\ngeist") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\ngeist") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  BURGMASTER -> remove_geist(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) BURGMASTER -> Sieg(player);
}  


