//erstellt im januar 04 von hiri
inherit "std/npc";
inherit "/std/player/moneyhandler";
inherit "/std/npc/spells.lpc";


#include "../def.h"
#include <class.h>
#include <properties.h>
#include <combat.h>



#define BURGMASTER "/d/wasser/hiri/sandburg/master/burgmaster"




void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Mulash der Geisterkoenig");
  SetProp(P_LONG,
    "Das ist Mulash, der Koenig der Geister. Er haelt einen durchsichtigen "
    "Szepter in seiner linken Hand. Er hat einen freundlichen Gesichtsausdruck, "
    "aber er ist ein Meister der Taeuschung. Ihn zu reizen ist sicher nicht "
    "klug. Mulash traegt eine ebenso durchsichtige Robe und einen blau "
    "schimmernd und wallenden Umhang mit weisser Borte. Seine Krone ist aus "
    "purem Gold und mit Diamanten besetzt. Aber ebenso durchsichtig wie all "
    "seine anderen Kleider. Seine Schuhe sind auch aus Gold und mit duennen "
    "schwarzen Zeichen bemalt.");
  SetProp(P_NAME, "Mulash");
  SetProp(P_GENDER, MALE);
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20, T_RANGE_MAX: 20]) );
  AddId( ({ "mulash", "geist", "geisterkoenig", "koenig","HIRIGEIST" }) );
  set_living_name("geist");
  AddClass(CL_UNDEAD);
  
  create_default_npc(40);
  SetProp(P_HANDS, ({" mit durchsichtigen Haenden" ,180, DT_RIP }) );
  SetProp( P_SIZE, 90+random(30) );
  SetProp(P_RACE, "Geist");
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-2);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,60);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_MSGIN, "kommt herein geschwebt.");
  SetProp(P_MSGOUT, "schwebt davon");
  SetProp(P_MMSGIN, "kommt schwebend herein");
  SetProp(P_MMSGOUT, "schwebt davon.");
  
  SetProp(P_DIE_MSG,  " schwebt auf immer davon.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Werde komme wieder %s, dann werde ich raechen mich!");
  SetProp(P_KILL_NAME, "Mulash");
  SetProp(P_KILL_MSG, "Was willst Du noch?");
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([
      DT_SLASH:      0.2, DT_BLUDGEON:   0.1, DT_PIERCE:  0.4, DT_SQUEEZE: 0.4, 
      DT_WHIP:       0.3, DT_RIP:        0.3,
      DT_FIRE:       0.2, DT_COLD:       0.0, DT_WATER:  0.2, DT_AIR:    0.1, 
      DT_LIGHTNING:  0.3, DT_EXPLOSION:  0.1, DT_SOUND:   0.5, DT_LIGHT:   -0.1,
      DT_ELECTRIC:   0.3, DT_ACID:       0.0, DT_POISON:  0.3, DT_TERROR: 1.0,
      DT_HOLY:       0.3, DT_UNHOLY:     0.4, DT_MAGIC:   0.7 ]) ); 
 

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich erschaffen.","sagt: ");
  
  
//  SetProp(P_LOG, "hiri/burg.log"); 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Mulash laesst Deine Sachen angewidert fallen.\n" }) );

  SUID;
  CLONEME(WEAPON "szepter" );
  command("zuecke szepter");
 
  CLONEME(ARMOUR "abwehr" );
//  CLONEME(ARMOUR "schuppenhose" );
//  CLONEME(ARMOUR "maennerstring");
//  CLONEME(ARMOUR "seidenhemd");
  command("trage abwehr");
  

   AddSpell(2,500,
    "Mulash taeuscht Dich hinterhaeltig!\n",
    "Mulash taeuscht @WEN !\n",
     ({DT_MIND,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
    "Mulash umhuellt Dich mit geistlicher Kraft!\n",
    "Mulash umhuellt @WEN mit geistlicher Kraft!\n",
     ({DT_TERROR,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(3,800,
              "Mulash laesst Eis auf Dich niederprassseln.\n",
              "Mulash laesst Eis auf @WEN niederprasseln.\n",
              ({DT_COLD,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
     AddSpell(2,1,
    "Mulash laesst alles knistern!\n",
    "Mulash laesst @WEN ein wenig knistern!\n",
     ({DT_LIGHT,DT_MAGIC}),([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1, 1, DS_DISARM, "Deine Waffe verlaesst Dich enttaeuscht.\n",
                  "@WER wurde von Mulash seiner Waffe beraubt.\n"); 

 SetChats(3,
    ({Name(WER,1)+" fragt: Was willst Du im Reich der Geister?\n"
     })
  );

  SetAttackChats(10,
    ({Name(WER,1)+" heult: So gehts nihichttt.\n"
     })
  );

 

  BURGMASTER -> add_geist();


  
  
}
void init()
{
  ::init();

 if ( BURGMASTER -> IsGeistfeind(TP) ) Kill(TP);

 if(TP && interactive(TP)) call_out("init_hallo",0,TP);
}



//masterbeginn

 


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  BURGMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\ngeist") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\ngeist") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  BURGMASTER -> remove_geist(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) BURGMASTER -> Sieg(player);
}
