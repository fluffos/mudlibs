inherit "std/mnpc";
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include <mnpc.h>
#include "../def.h"
#define BURGMASTER "/d/wasser/hiri/sandburg/master/burgmaster"



void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein scheinbar sehr niedliches Haeschen");
  SetProp(P_LONG,
    "Mit süssen putzigen braunen Augen schaut dich das Haeschen "
    "sowas von lieb und treu an. Du glaubst es einfach kuscheln "
    "zu muessen. Aber ob das so eine gute Idee ist? Bei genauem "
    "betrachten, fallen dir scharfe spitze Zaehnchen auf.");

  SetProp(P_NAME, "Haeschen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:80]));

  AddId(({"haeschen", "hiriyanta","nekrohaeschen", "nekro","NOWIMPY", "HIRIHAESCHEN" }));
  set_living_name("nekro");
  AddClass(CL_UNDEAD);
  SetProp(P_RACE, "Nekrofellhase");

  create_default_npc(25);

  SetProp(P_DEFAULT_INFO, "knurrt Dich boese an.\n");
  SetProp(P_AGGRESSIVE, 0.9);
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnchen", QueryProp(P_HANDS)[1], DT_RIP }) );

  SetProp(P_ALIGN, -600);
  SetProp(P_SIZE, 100);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS,([ DT_MAGIC     :  -0.6,
                                    DT_HOLY      :   0.6,
                                    DT_UNHOLY    :  -0.9,
                                    DT_POISON    :  -1.0,
                                    DT_SOUND     :  -1.0,
                                    DT_TERROR    :  -0.8,
                                    DT_LIGHT     :  -1.0 ]));

  // SetProp(P_GUILD, "nekromanten");
 //  SetProp(P_GUILD_LEVEL, 15);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" haengt @WEN am Hals und saugt Blut.\n" }) );

  
 

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "hoppelt nach#");
  SetProp(P_MMSGIN, "hoppelt herein");
  SetProp(P_MMSGOUT, "hoppelt davon");

  SetProp(P_DIE_MSG,  " spuckt dich an und stirbt.\n");
  SetProp(P_KILL_NAME, "Ein Nekrofellhaeschen");
  SetProp(P_KILL_MSG, "Frisches klebriges Spielerblut fuer mich!");

  SetAttackChats(20,
    ({BS(Name(WER,1)+" knurrt Dich an.")
     ,BS(Name(WER,1)+" springt Dir an die Kehle.")
     ,BS(Name(WER,1)+" lechzt nach Blut.")
     ,BS(Name(WER,1)+" zielt auf Deine Kehle.")
     ,BS(Name(WER,1)+" wirft Dich um.")
     ,BS(Name(WER,1)+" sabbert Dich mit Saeure an.")
     })
  );

  AddSpell(9,400,
    Name(WER,1)+" beisst sich in deinem Hals fest.\n",
    Name(WER,1)+" beisst sich bei @WEN im Hals fest.\n",
    ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );

//  SetProp(P_LOG, "hiri/burg.log"); 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Haeschen mag dein Schrott nicht haben.\n" }) );
 


/*  SUID;
  CLONEME(WEAPON "dreispitz" );
  command("zuecke waffe");
  CLONEME(ARMOUR "algenguertel" );
  CLONEME(ARMOUR "schuppenhose" );
  CLONEME(ARMOUR "maennerstring");
  CLONEME(ARMOUR "seidenhemd");
  command("trage alles");*/



 BURGMASTER -> add_nekro();

}

void init()
{
  ::init();

 if ( BURGMASTER -> IsNekrofeind(TP) ) Kill(TP);

 
}
//masterbeginn

 


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  BURGMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\nnekro") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert etwas und hoppelt davon",
	  "kommt rasch herein gehoppelt" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\nnekro") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  BURGMASTER -> remove_nekro(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) BURGMASTER -> Sieg(player);
}  





