//erstellt im januar 04 von hiri
inherit "std/npc";
inherit "/std/player/moneyhandler";


#include "../def.h"
#include <class.h>
#include <properties.h>
#include <combat.h>
#define BURGMASTER "/d/wasser/hiri/sandburg/master/burgmaster"



string *spieler_frosch;


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Serian der Burgwaechter");
  SetProp(P_LONG,
    "Dieser Geist haelt eine Laterne in der durchsichtigen Hand und hat einen "
    "grossen Schluesselbund an seiner Hose haengen. Er traegt ein Hemd auf dem "
    "ein Frosch abgebildet ist. Irgendwie sieht er auch ein wenig einem Frosch "
    "aehnlich in seiner Geistergestalt.");
  SetProp(P_NAME, "Serian");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "waechter", "geist", "serian", "HIRIGEIST" }) );
  set_living_name("geist");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit durchsichtigen Haenden" ,150, DT_RIP }) );
  SetProp( P_SIZE, 80+random(30) ); 
  SetProp(P_RACE, "Geist");
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,3);
   AddClass(CL_UNDEAD);
  SetProp(P_MSGIN, "kommt herein geschwebt.");
  SetProp(P_MSGOUT, "schwebt davon");
  SetProp(P_MMSGIN, "kommt schwebend herein");
  SetProp(P_MMSGOUT, "schwebt davon.");
  
  SetProp(P_DIE_MSG,  " schwebt auf immer davon.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Werde komme wieder %s, dann werde ich raechen mich!");
  SetProp(P_KILL_NAME, "Serian");
  SetProp(P_KILL_MSG, "Was willst Du noch?");

 

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich erschaffen.","sagt: ");
  AddInfo("bruecke", "Wenn Du ueber die Bruecke moechtest, solltest Du aber kleiner sein. "
                     "Die groesse eines Frosches waere ideal.", "sagt: ");
  AddInfo("frosch", "Ich kann Dich verfroschen wenn Du magst.", "sagt: ");
//  SetProp(P_LOG, "hiri/burg.log"); 

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Serian laesst Deine Sachen angewidert fallen.\n" }) );


  
    
  AddSpell(1,500, 
     "Serian umhuellt Dich mit geistlicher Kraft.\n",
     "Serian umhuellt @WEM mit geistlicher Kraft.\n");

 SetChats(3,
    ({Name(WER,1)+" fragt: Willst Du wieder zur Insel zurueck?\n"
     })
  );

  SetAttackChats(10,
    ({Name(WER,1)+" heult: So gehts nihichttt.\n"
     })
  );

  
  AddCmd( ({"verfrosch","verfrosche"})      , "cmd_verfroschen");
  AddCmd( ({"entfrosch","entfrosche"})      , "cmd_entfroschen");


  BURGMASTER -> add_geist();
  
  spieler_frosch = ({ });
}

void init()
{
  ::init();


 if ( BURGMASTER -> IsGeistfeind(TP) ) Kill(TP);
  
 if(TP && interactive(TP)) call_out("init_hallo",0,TP);
}

void init_hallo(object player)
{
  if(!player)                return;
  if(!interactive(player))   return;
  if(ENV(player) != ENV(TO)) return;

  tell_room(ENV(TO),break_string(
    "Hallo "+TP->name()+", wenn ich Dich verfroschen soll, so sage \"verfrosche mich\", "
    "und wenn ich Dich entfroschen soll, so sage \"entfrosche mich\."

    ,78,Name(WER,1)+" sagt: ",1));
}
void reset()
{
  ::reset();

  

  spieler_frosch = ({ }); 
}  
int cmd_verfroschen(string str)
{
  notify_fail("Wen moechtest Du verfroschen?\n");

  if(!str || str == "") return 0;
  if(!(str == "mich" )) return 0;

if(TP->QueryProp(P_FROG))
  {
    tell_object(TP,"Du bist doch bereits ein Frosch!\n");
    return -1;
  }
if(member(spieler_frosch,getuuid(TP)) != -1)
  {
    tell_object(TP,"Du kannst Dich im nicht schon wieder verfroschen.\n");
    return -1;
  }

TP->SetProp(P_FROG, 1); 
  spieler_frosch += ({ getuuid(TP) }); 

  tell_object(TP,"Du fuehlst gruen. Ja so gruen...\n");

  return 1;
}
int cmd_entfroschen(string str)
{
  notify_fail("Wen moechtest Du entfroschen?\n");

  if(!str || str == "") return 0;
  if(!(str == "mich" )) return 0;

if(TP->QueryMoney() < 500) 
  {
    tell_object(TP,"Du hast nicht genug Geld dabei.\n");
    return -1;
  }

  TP->SetProp(P_FROG, 0);           
  TP->AddMoney(-500);               

 "p/daemon/zentralbank"->PayIn(500, 100);

  tell_object(TP,"Du wirst groesser und immer groesser.\n");
  return 1;
}
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  BURGMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  exits = environment()->QueryProp(P_EXITS);
  ausgaenge = m_indices(exits);
  for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
  {
    if ( !objectp(enemy) ) return;
    raum2 = explode(exits[ausgaenge[i]], "#" );
    raum = raum2[sizeof(raum2)-1];
    for ( ob=first_inventory(raum); ob; ob=next_inventory(ob) )
      if ( living(ob) && !query_once_interactive(ob) &&
           ob->id("\ngeist") )
      {
	raum = file_name(ENV(TP));
	ob -> move(raum ,M_TPORT, 0,
          "hoert ein Heulen aus der Ferne und laeuft davon",
	  "kommt rasch herein gelaufen" );
        if ( enemy )
          ob -> Kill(enemy);
        return ::Attack(enemy);
      }
  }
  if (!objectp(enemy)) return;
  for ( ob=first_inventory(environment()); ob; ob=next_inventory(ob) )
    if ( living(ob) && !query_once_interactive(ob) &&
         ob->id("\ngeist") )
      ob -> Kill(enemy);
  return ::Attack(enemy);
}

int remove(int arg)
{
  BURGMASTER -> remove_geist(TO);
  return ::remove(arg);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) BURGMASTER -> Sieg(player);
}  


 

