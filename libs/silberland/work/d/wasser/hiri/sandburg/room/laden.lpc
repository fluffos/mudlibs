inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, -1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:0]));
  SetProp(P_INT_SHORT,"In einem kleinen Laden");
  SetProp(P_SHOPKEEPER_ID, "sanatoria");
  SetProp(P_SHOPKEEPER_NAME, "Sanatoria");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetStorageRoom( "/d/wasser/hiri/sandburg/room/sandlager.lpc" );

  AddDetail( ({"laden"}),
    "Du bist im Laden der Sandburg angelangt. Sanatoria ist die "
    "Ladenbesitzerin und huetet ihr Sortiment genauestens. "
    "Stoerenfriede kann sie nicht leiden und wird sehr schnell "
    "ihrem Namen gerecht. Eine Theke steht mittig.");
  AddDetail( ({"decke"}),
    "An der Decke ist nichts zu sehen. Nichtmal eine Lampe.");
  AddDetail( ({"lampe"}),
    "An der Decke haengt mal keine.");
  AddDetail( ({"waende"}),
    "An zwei, der Waende, sind Regale angebracht. In der anderen "
    "Wand ist die Tuere eingelassen worden. An der anderen haengt "
    "eine Tafel.");
  AddDetail( ({"wand"}),
    "In einer Wand wurde eine Tuere eingelassen, durch diese kannst "
    "Du auch schemenhaft den Burghof erkennen. An der anderen Wand "
    "haengt eine Tafel.");
  AddDetail( ({"tuere"}),
    "Durch die Tuere kannst Du jederzeit herein und heraus gehen."); 
  AddDetail( ({"tafel"}),
    "Du kannst die Tafel lesen");
  AddDetail( ({"boden"}),
    "Auch hier schimmert der Boden seltsam und man kann durchschauen. "
    "Erkennen kannst Du aber nichts.");
  AddDetail( ({"namen"}),
    "Sanatoria wird ihrem Namen recht schnell gerecht, wenn sie auf "
    "Stoerenfriede stoesst.");
  AddDetail( ({"sanatoria"}),
    "Sanatoria ist die Ladenbesitzerin.");
  AddDetail( ({"ladenbesitzerin","besitzerin"}),
    "Die Ladenbesitzerin traegt den Namen Sanatoria.");
  AddDetail( ({"stoerenfriede"}),
    "Wenn Sanatoria auf Stoerenfriede trifft, wird sie ungemuedlich.");
  AddDetail( ({"sortiment"}),
    "Sanatoria huettet ihr Sortiment aeusserst genau.");
  AddDetail( ({"regale","regalen","regal"}),
    "In den Regalen liegt das Sortiment ordendlich gestapelt.");
  AddDetail( ({"sandburg","burg"}),
    "Du bist im Laden der Sandburg und dieser gehoert Sanatoria.");
  AddDetail( ({"burghof"}),
    "Du kannst durch die Wand, in der die Tuere eingelassen ist, "
    "auf den Burghof schauen.");
  AddDetail( ({"theke"}),
    "In der Theke bewahrt Sanatoria besonders wertvolles "
    "Sortiment auf.");
  AddDetail( ({"ohr"}),
    "Mit Deinem Ohr kannst Du hoeren. Versuch es mal.");
  AddDetail( ({"fea","fenda","hisie"}),
    "Diese Worte, Fea, Fenda , Hisie kannst Du nicht verstehen.");
  AddDetail( ({"mulash"}),
    "Mulash.....wer kann das sein? Versuch es herauszufinden.");
  AddDetail( ({"koerper"}),
    "Wenn Du der Armee der Untoten gewahr wirst, erzittert Dein ganzer Koerper.");
  AddDetail( ({"untote"}),
    "Wenn DU mehr ueber Untote erfahren moechtest, solltest Du einmal zu Xarfai gehen.");
  AddDetail( ({"xarfai"}),
    "Xarfai ist das Gildenoberhaupt der Nekromanten.");
  AddDetail( ({"gildenoberhaupt","oberhaupt"}),
    "Das Gildenoberhaupt der Nekromanten ist Xarfai.");
  AddDetail( ({"nekromanten"}),
    "Die Nekromanten wissen sehr genau was Untote sind.");
  AddDetail( ({"armee"}),
    "Die Armee der Untoten schwebt von Zeit zu Zeit durch die Burg und "
    "treibt ihr Unwesen.");
  AddDetail( ({"unwesen"}),
    "Die Armee der Untoten treibt hier ihr Unwesen.");
  AddDetail( ({"buchstaben"}),
    "Worte bestehen aus mehreren Buchstaben.");
  AddDetail( ({"worte"}),
    "Worte kann man lesen und sie bestehen aus aneinander gereihten "
    "Buchstaben");
  AddDetail( ({"zeit"}),
    "Von Zeit zu Zeit, treibt die Armee der Untoten ihr Unwesen."); 

  AddReadDetail( ({"tafel"}),
    "Verfuegbare Befehle: \n"
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"
    "<kaufe> nummer    oder\n"
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"
    "                  Haendler dafuer bezahlt.\n"
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

   AddRoomMessage( ({"Die Armee der Untoten erscheint und schwebt durch Dich hindurch.\n",
      "Dir wird schrecklich kalt und Du zitterst am ganzen Koerper.\n",
      "Du hoerst ueberall Geraschel und leise Stimmen.\n"
      "Du hoerst unbekannte Laute an Dein Ohr dringen.\n"
      "Hisie, Hisie fana Fenda.\n"
      "Dagrodi dacil Fea Mulash.\n"}),30,"func");
 
  AddSound( DEFAULT_SOUND,
    "Das Geraschel und die Stimmen die ab und an zu hoeren sind "
    "lassen Dich erzittern. Manchmal fluestern die Stimmen etwas "
    "in einer Dir unbekannten Sprache.");
  AddSound( ({ "geraschel"}),
    "Wenn die Armee der Untoten erscheint vernimmst Du dieses Geraschel.");
  AddSound( ({ "stimmen"}),
    "Die Stimmen fluestern stetig in einer Dir fremden Sprache.");
  AddSound( ({ "sprache"}),
    "Du hoerst leise die Stimmen der Untoten in einer fremden Sprache.");
  AddSound( ({"laute"}),
    "Die Laute dringen ploetzlich an Dein Ohr. Verstehen kannst Du sie nicht");
  
  AddSmell( DEFAULT_SMELL,
    "Du kannst hier absolut nichts riechen. Ausser eventuell Deine "
    "eigenen Gerueche.");
  AddSmell( ({ "gerueche"}),
    "Das sind Deine eigenen Gerueche. Hier kannst Du ansonsten garnichts riechen."); 

  
    

  AddExit("suedwesten",  ROOM "burghof");

  AddItem( NPC "sanatoria", REFRESH_DESTRUCT);
}


string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier in einem kleinen Laden. Unzaehlige Regale "
        "stehen herum. Du siehst eine kleine Tafel an einer Wand. ";



  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist momentan gerade niemand hier.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}
