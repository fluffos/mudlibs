#include "../def.h"

inherit "std/room";

#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();

  SetProp( P_INT_SHORT, "Ein dunkler Kerker" );
  SetProp( P_INT_LONG,
    "Hoppla, wo bist Du hier hingeraten? Es scheint ein Kerker zu sein, "
    "aus dem wohl nicht viele entkommen konnten. Oder tut das Skelett sein "
    "uebriges? Auf dem Boden liegen Knochen und Totenkoepfe herum. Ein ganzes "
    "Zwergenskelett ist an eine Wand genagelt. Der Kerker ist durch eine schwere "
    "Eisentuere abgeschlossen. An der Decke ist kaum etwas zu erkennen. "
    "In der Mitte des Kerkers steht ein alter Holztisch und ein Stuhl.");
  SetProp( P_LIGHT, -1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_HOUSE]) );
 
  AddDetail( ({ "wand"}),
    "Du kannst auch hier ueberall durch die jeweilige Wand schauen. "
    "An der suedlichen Wand ist ein Zwergenskelett genagelt. Durch die "
    "anderen Waende siehst Du die Raeume, die dort zu sein scheinen, "
    "seltsam verdreht.");
  AddDetail( ({"waende"}),
    "Die Waende sind auch hier durchsichtig und Du kannst durch einen "
    "Schleier Raeume erkennen.");
  AddDetail( ({"raeume"}),
    "Die Raeume kannst Du durch diesen magischen Schleier nicht erkennen.");
  AddDetail( ({"schleier"}),
    "Dieser magische Schleier laesst es nicht zu, das Du die anderen Raeume "
    "deutlich erkennen kannst.");    
  AddDetail( ({ "eisentuere", "tuere","tuer"}),
    "Die Eisentuere faellt Dir auf weil sie auf dem Kopf steht. Die "
    "Luke zum durchreichen von Speisen und Getraenken ist in der Naehe "
    "des Bodens und das Schluesselloch ist verkehrt herum.");
  AddDetail( ({ "schluesselloch", "loch"}),
    "Du kannst ja mal durch das Schluesselloch hindurch gucken.");
  AddDetail( ({"kopf"}),
    "Die Eisentuere steht auf dem Kopf, also falsch herum. Was soll "
    "das? Wieso baut man eine Eisentuere falsch herum ein?");
  AddDetail( ({"luke"}),
    "Eine Luke, wo man die Speisen und Getraenke, fuer Gefangene "
    "durchreichen kann.");
  AddDetail( ({"speisen"}),
    "Die Speisen werden durch die Luke gereicht. Es duerfte sich aber "
    "nur um Wasser und Brot handeln.");
  AddDetail( ({"getraenke"}),
    "Getraenke kann man eigendlich nicht sagen, ausser Wasser wird man "
    "nichts an Getraenken bekommen.");
  AddDetail( ({"naehe"}),
    "In der Naehe des Bodens ist die Luke fuer Speisen und Getraenke.");
  AddDetail( ({"brot"}),
    "Es ist schon ziemlich lange her das hier Brot gereicht wurde. "
    "Zumindest sieht das Brot auf dem Teller nicht mehr sehr "
    "appetitlich aus.");
  AddDetail( ({"gefangene","gefangenen"}),
    "Entweder gab es hier schon lange keine Gefangenen mehr oder es hat sich "
    "Jemand genuesslich daran gelabt.");
  AddDetail( ({"jemand"}),
    "Dieser Jemand ist wohl das Skelett was Dich hier angegriffen hat.");
  AddDetail( ({"skelett"}),
    "Das Skelett hat Dich sicher nicht freundlich gegruesst als Du in den "
    "Kerker gekommen bist");
  AddDetail( ({"teller"}),
    "Ein Teller mit einem alten vergammelten Brot steht auf dem Holztisch.");
  AddDetail( ({"holztisch","tisch"}),
    "Auf dem Holztisch steht ein Teller mit einem alten Brot und eine Flasche "
    "Wasser steht ebenfalls darauf.");
  AddDetail( ({"flasche"}),
    "Welche Flasche meinst Du. Entscheide Dich mal. Es gibt eine Wasserflasche "
    "und eine Weinflasche.");
  AddDetail( ({"weinflasche"}),
    "Das Zwergenskelett haelt die Weinflasche in seiner Hand. Es wird sie Dir "
    "nicht geben");
  AddDetail( ({"wasserflasche"}),
    "Die Wasserflasche steht auf dem Tisch. Das Wasser sieht schon eklig aus. "
    "Du laesst die Wasserflasche daher lieber stehen.");
  AddDetail( ({"wein"}),
    "Der Wein in dieser Flasche scheint niemals zu versiegen, obwohl man ihn "
    "durch das Zwergenskelett sickern sieht. Du koenntest versuchen den Wein "
    "mit Deinem Mund aufzufangen.");
  AddDetail( ({"mund"}),
    "Da Dir das Wasser im Mund zusammenlaeuft, als Du den Wein sieht, solltest "
    "Du versuchen ihn mit Deinem Mund aufzufangen.");
  AddDetail( ({"wasser"}),
    "Die Flasche ist halbvoll mit Wasser gefuellt. Sie steht auf dem Holztisch.");
  AddDetail( ({"hand"}),
    "Das Zwergenskelett haelt in einer knochigen Hand die Flasche mit Wein.");
  AddDetail( ({"boden"}),
    "Auf dem Boden liegen Totenkoepfe und einzelne Knochen herum. Kein sehr "
    "ermutigender Anblick.");
  AddDetail( ({"anblick"}),
    "Der Anblick der Totenkoepfe und Knochen ermutigt Dich nicht sonderlich.");
  AddDetail( ({"totenkoepfe","koepfe"}),
    "Die Totenkoepfe haben eine recht erschreckende Wirkung. Sie schweben ab "
    "und an vom Boden hoch an die Decke und wieder herunter.");
  AddDetail( ({"knochen"}),
    "Die Knochen liegen einfach ueber den Boden verteilt und haben sind "
    "nicht weiter von Interesse.");
  AddDetail( ({"wirkung"}),
    "Die Totenkoepfe haben eine erschreckende Wirkung auf Dich.");
  AddDetail( ({"interesse"}),
    "Die Knochen sind nicht weiter von Interesse.");
  AddDetail( ({"decke"}),
    "Von der Decke haengt ein Seil herunter. Du kannst auch durch den "
    "Schleier erkennen das dort oben noch etwas ist. Vielleicht kannst "
    "Du ja mit dem Seil etwas machen.");
  AddDetail( ({"seil"}),
    "Du koenntest versuchen an dem Seil nach oben zu gelangen.");
  AddDetail( ({"kerker","kerkers"}),
    "Du bist in einem Kerker gelandet und von dem Skelett unsanft "
    "begruesst worden. Da Du noch lebst, warst Du wohl staerker "
    "als das Skelett. Nun solltest Du Dir einen Weg heraus suchen.");
  AddDetail( ({"weg"}),
    "Den Weg aus dem Kerker musst Du schon selbst herausfinden.");
  AddDetail( ({"mitte"}),
    "In der Mitte des Kerkers, steht ein Holztisch und ein Stuhl.");
  AddDetail( ({"stuhl"}),
    "Auf diesen Stuhl solltest Du Dich nicht mehr setzen. Er bricht "
    "schon bei der geringsten Last zusammen.");
  AddDetail( ({"last"}),
    "Du bist fuer den Stuhl sicherlich eine untragbare Last.");
  AddDetail( ({"zwergenskelett","zwergenskelettes"}),
    "Das Zwergenskelett ist an der suedlichen Wand angenagelt. Es "
    "jammert staendig und trinkt immer wieder aus einer Flasche. "
    "Der Wein sickert durch seine Oeffnungen ohne Wirkung hindurch.");
  AddDetail( ({"oeffnungen","oeffnung"}),
    "Die Oeffnungen des Zwergenskelettes, sind die Zwischenraeume, "
    "der Rippen und sonstige Oeffnungen.");
  AddDetail( ({"zwischenraeume"}),
    "Die Zwischenraeume sind die Oeffnungen des Zwergenskelettes. Aus ihnen "
    "tropft der Wein, wenn es trinkt");
  AddDetail( ({"rippen"}),
    "Die Rippen des Zwergenskelettes stellen einen Teil des anatomischen "
    "Aufbaues dar.");
  AddDetail( ({"teil"}),
    "Die Rippen sind ein Teil des anatomischen Aufbaues.");
  AddDetail( ({"aufbau","aufbaues"}),

     "---------------------------------------------\n"
    "I                                            I\n"
    "I                  .-.  \)                    I\n"
    "I                 (o.o) ,|                   I\n"
    "I                  (m)  ()                   I\n"
    "I                  ='=//                       I\n"
    "I                 //=T=   ()                 I\n"
    "I                _\` === //\\                  I\n"
    "I                 /\ (0V0)  `\                 I\n"
    "I                      \\    '==              I\n"
    "I                       ()                   I\n"
    "I                       //                   I\n"
    "I                      '/                    I\n"
    "I                      '==                   I\n"
    "I						   I\n"
    "I                                            I\n"
    "I    Dies ist der Aufbau eines Skelettes.    I\n");    
  AddDetail( ({"spieler"}),
    "Du bist ein Spieler und das Zwergenskelett beschwert sich, weil "
    "ab und an ein paar Spieler durch es hindurch fallen.");
  AddDetail( ({"zaehne"}),
    "Das Zwergenskelett setzt sich oeftermal die Flasche an die Zaehne "
    "um sich einen Schluck Wein zu genehmigen.");
  AddDetail( ({"schluck"}),
    "Das Zwergenskelett goennt sich oftmals einen Schluck Wein.");
  AddDetail( ({"i","t","dies"}),
    "Das ist total unwichtig.");
  AddDetail( ({"plaetschern"}),
    "Das Plaetschern kann man sicher besser lauschen.");

   AddSound( DEFAULT_SOUND,
    "Du hoerst ein Plaetschert waerend das Skelett trinkt. "
    "Ausserdem kannst Du noch das geklapper des Skelettes "
    "hoeren, wenn es sich bewegt.");

  AddSound( ({ "plaetschert" }),
    "Dadurch das das Skelett trinkt wird ein Plaetschern erzeugt.");
  AddSound( ({ "skelett" }),
    "Das Skelett klappert wenn es sich bewegt.");  
  
 AddSmell( DEFAULT_SMELL,
    "Du riechst nicht besonders viel. Aber ein Geruch nach Verwesung "
    "liegt in der Luft.");

  AddSmell( ({ "luft" }),
    "Ein Geruch der Verwesung liegt in der Luft und beisst Dir "
    "regelrecht in die Nase.");
  AddSmell( ({ "nase"}),
    "Mit Deiner Nase erfasst Du die Gerueche.");
  AddSmell( ({ "verwesung"}),
    "Du kannst einen ekligen Geruch der Verwesung wahrnehmen.");
  AddSmell( ({"geruch","gerueche"}),
    "Mit Deiner Nase kannst Du die Gerueche wahrnehmen.");


  


 AddRoomMessage( ({"Du hoerst wie das Zwergenskelett vor sich hin brabbelt.\n",
      "Immer diese Spieler die durch mich hindurch hereingefallen kommen!!!\n",
      "Das Zwergenskelett setzt eine Flasche an die Zaehne und nimmt einen Schluck.\n"
      "Du hoerst ein Plaetschern als das Zwergenskelett Wein trinkt.\n"}),30,"func");
  
 
  AddCmd(  ({ "fang", "fange", "fangen" }), "fangen"  );
  AddCmd(  ({ "guck", "gucke", "gucken" }), "gucken"  );
  AddCmd(  ({ "gelang", "gelange", "gelangen" }), "gelangen"  );

  AddItem( NPC "nskelett", REFRESH_DESTRUCT);

  
 // Ende Create

}
int gucken(string str)
{
   notify_fail("Durch was willst Du gucken?\n");

 if(!str || str == "") return 0;
 if(!(str=="durch schluesselloch durch"||
       str=="durch schluesselloch hindurch"||
       str=="durch schluesselloch"))       
       return 0;

 write(BS("Du guckst durch das Schluesselloch und kurz kannst Du einen Raum erkennen "
	  "der verkehrt herum ist. Die Wache die vor der Eisentuere steht siehst Du an "
	  "an der Decke laufen. Als Du gerade noch einen Blick riskieren willst sticht "
	  "Dir ploetzlich Jemand durch das Schluesselloch in Dein Auge.\n"));

 say(TPN+" haelt sich ein Auge zu und wimmert.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",4);
    return 1;
  
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  TP->SetProp(P_BLIND, 60);  
  write(BS( "Als Du den Stich im Auge spuerst haelst Du Dir Deine Augen zu "
         "und wimmerst vor Schmerz." ));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write (BS( "Du hoerst eine Stimme die sagt: Na Du blindes Huhn.") );

}

int gelangen(string str)
{
 notify_fail("Wohin willst Du gelangen?\n");

 if(!str || str == "") return 0;
 if(!(str=="mit seil nach oben"||
      str=="an seil nach oben"||
      str=="mit dem seil nach oben"))     
 return 0;
 

 write(BS("Du hangelst Dich an dem Seil nach oben und "
	  "fragst Dich wie Du durch die Decke gelangen sollst. "
	  "Du siehst, je naeher Du der Decke kommst, das dort ueber "
	  "Dir ein Brunnen zu sein scheint. In Dir wird eine "
	  "truegerische Hoffnung geweckt, dass dort Normalitaet herrscht.\n"));

 say(TPN+" klettert an dem Seil nach oben.\n");

 TP->move( ROOM "burghof", M_GO, "klettert");


 return 1;
}

int fangen(string str)
{
 notify_fail("Willst Du vielleicht den Wein mit Deinem Mund auffangen?\n");

 if(!str || str == "") return 0;
 if(!(str=="wein mit mund auf"||
      str=="wein mit mund"))     
 return 0;
 

 write(BS("Obwohl es Dir zu wider ist versucht Du den Wein, "
	  "der aus dem Zwergenskelett rinnt, mit Deinem "
	  "Mund aufzufangen. Als es Dir gelingt bemerkst Du, "
	  "dass Du einen Schwips bekommen hast.\n"));
 TP->SetProp(P_ALCOHOL, 60);  
 say(TPN+" versucht den Wein mit dem Mund aufzufangen.\n");
 


 return 1;
}
