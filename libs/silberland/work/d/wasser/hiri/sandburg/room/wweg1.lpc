#include "../def.h"

inherit "std/room";

#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();

  SetProp( P_INT_SHORT, "Auf einem Wachweg" );
  SetProp( P_INT_LONG,
    "Du gehst auf einem Wachweg und Du kannst die Insel und das Meer "
    "sehen, wenn Du durch eines der Loecher in der Aussenmauer schaust. "
    "Oestlich von Dir ist einer der vier Tuerme. Ein Schild haengt "
    "ueber der Tuer. Nach Westen geht es zu dem Erker und dem Burghof "
    "zurueck. Du kannst aber noch den Wachweg nach Westen weiter gehen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_PLAIN]) );
 
  AddDetail( ({ "wachweg","weg"}),
    "Dieser Wachweg ist nur ein ein kleiner Teil des gesammten Wachweges. "
    "Durch eines der Loecher hast Du einen Ausblick auf das Meer.");
  AddDetail( ({ "ausblick"}),
    "Der Ausblick ist berauschend, vorallem weil Dir die Insel riesig vorkommt."
    "Es ist seltsam da Du Deine normale groesse hast und die Burg Dir auch "
    "gross und maechtig vorkommt.");
  AddDetail( ({"teil"}),
    "Hier ist nur ein kleiner Teil des ganzen Wachweges.");
  AddDetail( ({ "insel"}),
    "Die Insel kommt Dir sehr gross vor und Du kannst es Dir nicht erklaeren "
    "wodurch das alles so ist.");
  AddDetail( ({"meer","meeres"}),
    "Das Meer ist von hier aus zu sehen und auch zu hoeren.");
  AddDetail( ({"aussenmauer","mauer"}),
    "In die Aussenmauer sind mehrere Loecher gelassen.");
  AddDetail( ({"loecher"}),
    "Die Loecher in der Aussenmauer ermoeglichen einen Ausblick auf "
    "die Insel");
  AddDetail( ({"boden"}),
    "Der Boden ist aus Sandgestein und knirscht unter Deinen Fuessen.");
  AddDetail( ({"sandgestein","gestein"}),
    "Aus Sandgestein wurde der Boden gefertigt. Leise knirscht es unter "
    "Deinen Fuessen. Du kannst durch den Boden hindurch sehen und es "
    "scheint als ob Du Dich selbst in einem Spiegel siehst.");
  AddDetail( ({"fuessen"}),
    "Durch das Sandgestein knirscht es leise unter Deinen Fuessen.");
  AddDetail( ({"spiegel"}),
    "Es scheint, als ob Du Dich im Boden, in einem Spiegel betrachtest. "
    "Seltsam, aber hier ist alles durchsichtig und Du denkst Dir das eine "
    "grosse unheimliche Macht seine Finger im Spiel hat.");
  AddDetail( ({"macht"}),
    "Eine unheimliche Macht hat diese Sandburg so veraendert das Du Dir kaum "
    "erklaeren kannst was hier passiert.");
  AddDetail( ({"finger"}),
    "Du hast zehn Finger aber hier hat eine andere Macht ihre Finger im Spiel.");
  AddDetail( ({"spiel"}),
    "Eine unheimliche Macht hat ihre Finger im Spiel und Du kannst Dir dies hier "
    "kaum erklaeren.");
  AddDetail( ({"burghof"}),
    "Wenn Du nach Westen gehst kommst Du zurueck zu dem Burghof.");
  AddDetail( ({"sandburg","burg"}),
    "Du befindest Dich auf einem Wachweg der unheimlichen Sandburg.");
 AddDetail( ({"koerper"}),
    "Wenn Du der Armee der Untoten gewahr wirst, erzittert Dein ganzer Koerper.");
  AddDetail( ({"untote"}),
    "Wenn DU mehr ueber Untote erfahren moechtest, solltest Du einmal zu Xarfai gehen.");
  AddDetail( ({"xarfai"}),
    "Xarfai ist das Gildenoberhaupt der Nekromanten.");
  AddDetail( ({"gildenoberhaupt","oberhaupt"}),
    "Das Gildenoberhaupt der Nekromanten ist Xarfai.");
  AddDetail( ({"nekromanten"}),
    "Die Nekromanten wissen sehr genau was Untote sind.");
  AddDetail( ({"ohr"}),
    "Mit Deinem Ohr kannst Du hoeren. Versuch es mal.");
  AddDetail( ({"fea","fenda","hisie"}),
    "Diese Worte, Fea, Fenda , Hisie kannst Du nicht verstehen.");
  AddDetail( ({"mulash"}),
    "Mulash.....wer kann das sein? Versuch es herauszufinden.");
  AddDetail( ({"armee"}),
    "Die Armee der Untoten schwebt von Zeit zu Zeit durch die Burg und "
    "treibt ihr Unwesen.");
  AddDetail( ({"unwesen"}),
    "Die Armee der Untoten treibt hier ihr Unwesen.");
  AddDetail( ({"geraschel"}),
    "Wenn die Armee der Untoten ihr Unwesen treibt kann man Geraschel und "
    "Stimmen hoeren.");
  AddDetail( ({"stimmen"}),
    "Die Stimmen und das Geraschel sind eigendlich immer zu hoeren. Auch wenn "
    "die Armee der Untoten gerade nicht da ist.");
  AddDetail( ({"zeit"}),
    "Von Zeit zu Zeit treibt die Armee der Untoten ihr Unwesen in der Burg.");
  AddDetail( ({"worte"}),
    "Diese Worte sind Dir fremd und Du wirst sie niemals verstehen koennen.");
  AddDetail( ({"himmel"}),
    "Hier kannst Du den Himmel nur undeutlich erkennen, was unerklaerlich ist, "
    "da Du die Insel ja sehr gut erkennen kannst.");
  AddDetail( ({"tuer"}),
    "Die Tuer fuehrt in den einen der vier Tuerme der Sandburg. Ein "
    "Schild haengt ueber der Tuer. Du kannst leider nicht bis zu der Tuere "
    "gehen, ein Zwinger verhindert das vorbeigehen.");
  AddDetail( ({"erker"}),
    "Wenn Du nach Westen gehst, kommst Du zu dem Erker zurueck.");
  AddDetail( ({"zwinger"}),
    "Der Zwinger sieht recht unstabil aus. In ihm sitzt ein grosser Hund. "
    "Hoffendlich bricht der nicht mal aus.");
  AddDetail( ({"hund"}),
    "Dieser Hund ist unheimlich und doch faszinierend zugleich. Er liegt "
    "fast friedlich in seinem Zwinger und kaut genuesslich auf einem "
    "Knochen herum. Doch bei genauerem hinsehen erkennst Du, dass dieser "
    "Hund durchsichtig ist. Also wird er auch ein Geist sein. Geisterhund... "
    "Dir wird kaelter als Dir jetzt schon ist.");
  AddDetail( ({"knochen"}),
    "Der Knochen sieht recht gross aus. Was aber unrelevant ist. Moeglicherweise "
    "kaut der Hund ja bald auf Deinen Knochen herum? Wenn Du mutig bist, kannst "
    "Du den Hund ja mal besuchen.");
  AddDetail( ({"geist","geisterhund"}),
    "Dadurch das der Hund durchsichtig ist, wird es wohl ein Geist sein.");
  AddDetail( ({"tuerme","turm"}),
    "Die Tuer fuehrt in den suedoestlichen der vier Tuerme. Aber man kann momentan "
    "die Tuer nicht erreichen.");
  AddDetail( ({"schild"}),
    "Du kannst das Schild nicht richtig lesen. Nur noch weniges ist erkennbar.");
  AddReadDetail( ({"schild"}),
		"\n    ~*To en rae er*~  \n"
                "  \n"
                "\n  ~*S  rg  u d Ur  n*~  \n");





  AddRoomMessage( ({"Die Armee der Untoten erscheint und schwebt durch Dich hindurch.\n",
      "Dir wird schrecklich kalt und Du zitterst am ganzen Koerper.\n",
      "Du hoerst ueberall Geraschel und leise Stimmen.\n"
      "Du hoerst unbekannte Laute an Dein Ohr dringen.\n"
      "Hisie, Hisie fana Fenda.\n"
      "Dagrodi dacil Fea Mulash.\n"}),30,"func");
 
  AddSound( DEFAULT_SOUND,
    "Das Geraschel und die Stimmen die ab und an zu hoeren sind "
    "lassen Dich erzittern. Manchmal fluestern die Stimmen etwas "
    "in einer Dir unbekannten Sprache. Weit entfernt kannst Du leise "
    "das Meer hoeren.");
  AddSound( ({ "geraschel"}),
    "Wenn die Armee der Untoten erscheint vernimmst Du dieses Geraschel.");
  AddSound( ({ "stimmen"}),
    "Die Stimmen fluestern stetig in einer Dir fremden Sprache.");
  AddSound( ({ "sprache"}),
    "Du hoerst leise die Stimmen der Untoten in einer fremden Sprache.");
  AddSound( ({"laute"}),
    "Die Laute dringen ploetzlich an Dein Ohr. Verstehen kannst Du sie nicht");
  AddSound( ({"meer"}),
    "Du kannst das Meer leise hoeren und wuenschst Dich von hier fort.");
  
  AddSmell( DEFAULT_SMELL,
    "Du kannst hier schwach den Geruch des Meeres wahrnehmen.");
  AddSmell( ({ "geruch"}),
    "Du kannst schwach den Geruch des Meeres wahrnehmen.");

  
    AddCmd(  ({ "besuch", "besuche","besuchen" }), "besuchen"  );
//  AddCmd(  ({ "zwaeng", "zwaenge" }), "zwaenge"  );
  

//  AddItem(NPC "krabbe", REFRESH_DESTRUCT);
//  AddItem(NPC "eidechse", REFRESH_DESTRUCT);
    



  
//  AddExit( "osten",  ROOM "zwinger" );
  AddExit( "westen",  ROOM "zinne" );

// Ende Create
}

int besuchen(string str)
{
 notify_fail("Wen willst Du denn besuchen?\n");

 if(!str || str == "") return 0;
 if(!(str=="hund"||
      str=="geisterhund"))     
 return 0;
 

 write(BS("Du nimmst all Deinen Mut zusammen und machst Dich daran "
	  "die Tuer des Zwingers zu oeffnen. Der Hund schaut Dir interessiert "
	  "zu. Es scheint das er auf frisches Fleisch hofft und Du haelst "
	  "inne. Doch dann denkst Du: Hach dummer Hund vor Dir fuercht ich mich "
	  "nicht. Du gehst durch die bereits geoeffnete Tuere und stehst dem "
	  "Hund nun direkt gegenueber. Die Zwingertuer faellt hinter Dir zu.\n"));

 say(TPN+" geht mutig in den Zwinger.\n");

 TP->move( ROOM "wweg2", M_GO, "betritt den Zwinger");


 return 1;
}
