inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <combat.h>
#include <bank.h>
#include "../def.h"

#define VGL_PREIS 500
#define LAGER  "/d/wasser/hiri/sandburg/room/repastore.lpc"
#define WEBS(x) break_string(x, 78, "Die Waffenexpertin sagt: ", 1)

create()
{
  ::create();
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Haus der Reparatur");
  SetProp(P_INT_LONG, 
    "Du stehst in einem kleinen Haus, es ist das Haus einer Waffenexpertin. "
    "Die Waffenexpertin hat sehr viel Wissen und ist Fachlich sehr begabt. "
    "Du kannst hier auch Ruestungen und Waffen kaufen oder Du laesst Dir, "
    "Deine Waffen und Ruestungen reparieren, was Dich aber etwas kosten "
    "wird. Dienstleistung ist eben nicht umsonst. An der Wand haengt "
    "eine Tafel mit den Angeboten der Waffenexpertin.");
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_HOUSE]) );
  AddDetail (({"haus"}),
    "Du stehst in dem Haus der Waffenexpertin, das Haus ist nicht "
    "besonders gross, ein Durchgang fuehrt in ein Hinterzimmer.");
  AddDetail( ({"hinterzimmer","zimmer"}),
    "Zu diesem Hinterzimmer hast Du keinen Zutritt.");
  AddDetail( ({"zutritt"}),
    "Nur die Waffenexpertin hat Zutritt zu dem Hinterzimmer.");
  AddDetail( ({"durchgang"}),
    "Der Durchgang fuehrt in das Hinterzimmer.");
  AddDetail( ({"teppich"}),
    "Der Teppich ist schlicht und uninteressant.");
  AddDetail( ({"kronleuchter","leuchter"}),
    "Der Kronleuchter ist auch uninteressant.");
  AddDetail (({"waffenexpertin"}),
    "Sie steht vor Dir und laechelt Dich freundlich an.");
  AddDetail (({"waffen", "ruestungen"}), 
    "Wenn Du <zeige> eingibst, wird Dir die Waffenexpertin, ihre "
    "Waren zeigen.");
  AddDetail( ({"fachlich"}),
    "Die Waffenexpertin ist Fachlich sehr begabt.");
  AddDetail( ({"wissen"}),
    "Die Waffenexpertin ueberzeugt mit hervoragendem Wissen. ");
  AddDetail( ({"angeboten","angebote"}),
    "Die Angebote kannst Du auf der Tafel lesen.");
  AddDetail ("boden",
    "Du stehst auf dem Boden, der mit einem Teppich ausgelegt worden "
    "ist.");
  AddDetail ("decke",
    "Die Decke ist ueber Dir. An ihr haengt ein Kronleuchter.");
  AddDetail( ({"waren","ware"}),
    "Die Waren kannst Du Dir mit <zeige> anschauen.");
  AddDetail (({"tafel","informationstafel"}),
    "Eine Tafel mit Preisen. Du kannst sie lesen."); 
  AddDetail( ({"preisen","preise","preis"}),
    "Die Preise kannst Du auf der Tafel lesen.");
  AddDetail( ({"waende"}),
    "Auch hier kannst Du durch die Waende durchsehen und wage "
    "erahnen was vor dem Haus ist. An einer Wand haengt eine Tafel."); 
  AddDetail( ({"wand"}),
    "An einer Wand haengt eine Tafel. Du kannst sie lesen.");
  AddReadDetail (({"tafel","informationstafel"}),
    ",----------------------------------------------------------.\n"+
    "|  NEU !!                                                  |\n"+
    "|                                                          |\n"+
    "|  Wir sagen Dir fuer den laecherlichen Betrag von "+
    sprintf("%-7s |\n",to_string(VGL_PREIS))+
    "|  Muenzen, was Deine Waffe oder Ruestung so wert ist,     |\n"+
    "|  verglichen mit einer anderen.                           |\n"+
    "|                                                          |\n"+
    "|    Syntax: vergleiche <x> mit <y>                        |\n"+
    "|                                                          |\n"+
    "|  Ausserdem verfuegen wir ueber ein ausgewaehltes Sorti-  |\n"+
    "|  ment an herausragenden Waffen und Ruestungen! Tippe     |\n"+
    "|  <zeige>, um es zu sehen.                                |\n"+
    "|                                                          |\n"+
    "|  Und jetzt ganz neu: Der Reparatur-Service!!!  Wir       |\n"+
    "|  bringen Deine beschaedigte Ausruestung wieder auf       |\n"+
    "|  Vordermann! Da das eine schwierige Arbeit ist, muessen  |\n"+
    "|  wir auch einen hohen Preis verlangen. Tippe einfach     |\n"+
    "|  'repariere <x>', und wir sagen Dir dann, was es kosten  |\n"+
    "|  wird und nehmen den Auftrag gerne an, wenn Du einver-   |\n"+
    "|  standen bist.                                           |\n"+
    "|                                                          |\n"+
    "`----------------------------------------------------------'\n");

  AddCmd(({"vergleiche", "vergleich"}), "compare");
  AddCmd(({"repariere", "reparier"}), "repair");
  SetStorageRoom(LAGER);
  SetBuyFact(6);
  AddExit("suedosten", ROOM "burghof");
}

sell()
{
  notify_fail("Tut mir leid, wir kaufen nichts an!\n");
  return 0;
}
force_sell() { return sell(); }
evaluate() { return sell(); }

compare(str)
{
  object ob1, ob2, lager;
  string str1, str2, str3;
  notify_fail("Was willst Du womit vergleichen?\n");
  if (!str || !stringp(str)) return 0;
  if (sscanf( str, "%s mit %s", str1, str2) != 2) return 0;

  catch(call_other(LAGER, "???"));
  lager=find_object(LAGER);

  if (!lager) {
    write(WEBS("Tut mir leid, ich habe im Moment keine Zeit, ich muss "
        "erst mein Lager in Ordnung bringen, irgendetwas stimmt dort "
        "naemlich nicht..."));
    return 1;
  }

  if (sscanf(str1, "%s in laden", str3)) ob1=present(str3, lager);
  else if (!ob1 = present(str1, TP)) ob1 = present(str1, lager);

  if (sscanf(str2, "%s in laden", str3)) ob2=present(str3, lager);
  else if (!ob2 = present(str2, TP)) ob2 = present(str2, lager);

  if (!ob1 || !ob2) {
    write(WEBS("Wenn Du eine Einschaetzung haben willst, so solltest Du "
        "doch etwas angeben, was Du auch hast!"));
    return 1;
  }

  if (environment(ob1)==lager) {
    write(WEBS("Klar. Ich koennte "+ob1->name(WEN,1)+" schon mit "+
        ob2->name(WEM,1)+" vergleichen, aber die Arbeit lohnt sich "
        "wirklich nicht. Glaub mir, meine Waren sind allesamt von "
        "hervorragender Qualitaet!"));
    return 1;
  }
  if (environment(ob2)==lager) {
    write(WEBS("Klar. Ich koennte "+ob2->name(WEN,1)+" schon mit "+
        ob1->name(WEM,1)+" vergleichen, aber die Arbeit lohnt sich "
        "wirklich nicht. Glaub mir, meine Waren sind allesamt von "
        "hervorragender Qualitaet!"));
    return 1;
  }
  if (ob1==ob2)
  {
    write (BS("Der Waffenexpertin ist es zu bloed, "+ob1->name(WEN,1)+
      " mit sich selbst zu vergleichen. Sie drueckt "+ob1->QueryPronoun(WEN)+
      " Dir daher alles wieder in die Hand."));
    return 1;
  }
  // Wenn der Spieler kein Magier ist kostet es halt was
  if (!IS_LEARNER(TP))
  {
    if (TP->QueryMoney() < VGL_PREIS)
    {
      write(WEBS("Das kostet "+VGL_PREIS+
            " Muenzen, und soviel hast Du nicht!\n"));
      return 1;
    }
  }
  if (ob1->QueryProp(P_WEAPON_TYPE) && ob2->QueryProp(P_WEAPON_TYPE))
  {
    write (BS(
      "Die Waffenexpertin nimmt "+ob1->name(WEN, 1)+" und "+
      ob2->name(WEN, 1)+" und vergleicht beide eingehend miteinander. "+
      "Schliesslich gibt Sie Dir folgende Beurteilung:")+"\n");

    if (ob1->QueryProp(P_WEAPON_TYPE) != ob2->QueryProp(P_WEAPON_TYPE))
    {
      write(WEBS(ob1->Name(WER,1)+" und "+ob2->name(WER,1)+" sind zwei "
        "grundverschiedene Waffen, daher nicht wirklich 1:1 "
        "vergleichbar! Ich werde Dir aber eine ungefaehre Schaetzung "
        "geben, womit Du mehr gegen Deine Gegner ausrichten wirst.")+"\n");
    }
    write (BS (comp_quality(ob1, ob2, 1) + "."));
  }
  else if (ob1->QueryProp(P_ARMOUR_TYPE) && ob2->QueryProp(P_ARMOUR_TYPE))
  {
    write (BS(
      "Die Waffenexpertin nimmt "+ob1->name(WEN, 1)+" und "+
      ob2->name(WEN, 1)+" und vergleicht beide eingehend miteinander. "+
      "Schliesslich gibt Sie Dir folgende Beurteilung:")+"\n");

    if (ob1->QueryProp(P_ARMOUR_TYPE) != ob2->QueryProp(P_ARMOUR_TYPE))
    {
      write(WEBS(ob1->Name(WER,1)+" und "+ob2->name(WER,1)+" sind zwei "
        "verschiedene Arten von Ruestung, daher nicht wirklich 1:1 "
        "vergleichbar! Ich werde Dir aber eine ungefaehre Schaetzung "
        "geben, was Dich effektiver vor Angriffen schuetzt.")+"\n");
    }
    write (BS (comp_quality(ob1, ob2, 2) + "."));
  }
  else if ((ob1->QueryProp(P_ARMOUR_TYPE) && ob2->QueryProp(P_WEAPON_TYPE)) ||
           (ob2->QueryProp(P_ARMOUR_TYPE) && ob1->QueryProp(P_WEAPON_TYPE)))
  {
    write (WEBS("Eine Waffe mit einer Ruestung zu vergleichen "
          "macht irgendwie wenig Sinn, findest Du nicht auch?"));
    return 1;
  }
  else
  {
    write (WEBS("Ich kenne mich nur mit Waffen und Ruestungen "+
      "aus, nicht aber mit dem Zeug, das Du da bei Dir hast!"));
    return 1;
  }
  write ( BS(comp_weight(ob1, ob2) + "."));
  if (!IS_LEARNER(TP))
  {
    TP->AddMoney(-VGL_PREIS);
    ZENTRALBANK->PayIn(VGL_PREIS);
    write ("\n"+BS("Die Waffenexpertin haelt ihre Hand auf, und Du bezahlst "+
      "widerwillig die "+VGL_PREIS+" Muenzen. Insgeheim denkst Du Dir, was "+
      "fuer ein Wucher das doch ist, bist aber doch froh, etwas erfahren "+
      "zu haben.\n"));
  } else {
    write("\n"+WEBS("Immer wieder schoen, wenn mal ein Magier vorbeischaut! "
        "Komm doch oefter mal hierher!")+"\n");
  }
  return 1;
}

string comp_quality(object ob1, object ob2, int typ)
{
  int wert1, wert2, diff, h1, h2;
  string name1, name2, name1ist;

  name1 = capitalize(ob1->name(WER, 1));
  name2 = ob2->name(WER, 1);
  if (typ == 1)
  {
    wert1 = ob1->QueryProp(P_WC);
    wert2 = ob2->QueryProp(P_WC);
    h1 = ob1->QueryProp(P_NR_HANDS);
    h2 = ob2->QueryProp(P_NR_HANDS);
    write (BS(name1 + " ist ein "+(h1==1?"Einh":(h1==2?"Zweih":h1+"-H"))+
      "aender, " + name2 +
      (h1==h2?" auch":" ein "+
       (h2==1?"Einh":(h2==2?"Zweih":h2+"-H"))+
       "aender")+".\n"));
    h1 = ob1->QueryProp(P_WC_FIX);
    h2 = ob2->QueryProp(P_WC_FIX);
    if (h1 > h2)
      write(name1+" liegt besser in der Hand als "+name2+".\n");
    else if (h1 < h2)
      write(name1+" liegt schlechter in der Hand als "+name2+".\n");
    else
      write(name1+" und "+name2+" liegen etwa gleich gut in der Hand.\n");
  }
  else
  {
    wert1 = ob1->QueryProp(P_AC);
    wert2 = ob2->QueryProp(P_AC);
  }
  diff = wert1 - wert2;
  if (IS_LEARNING(TP))
  {
    write("  Typ = " + typ + ", d.h. " +
         (typ==1 ? "Waffen" : "Ruestungs") + "vergleich.\n");
    write("  Hands1: " + h1 + "\n");
    write("  Hands2: " + h2 + "\n");
    write("  Wert1: " + wert1 + "\n");
    write("  Wert2: " + wert2 + "\n");
    write("  Wertdifferenz: " + diff + "\n");
  }

  if (ob1->IsPlural())
    name1ist=name1+" sind ";
  else
    name1ist=name1+" ist ";

  if (diff > 2*wert2)
    return name1 + (ob1->IsPlural() ? " lassen " : " laesst ") + name2 +
           " richtig mickrig aussehen";
  if (diff > wert2)     return name1ist+"viel besser als "+name2;
  if (diff > wert2/5)   return name1ist+"besser als "+name2;
  if (diff > wert2/10)  return name1ist+"etwas besser als "+name2;
  if (-diff > 2*wert1)
    return name1 + (ob1->IsPlural() ? " wirken " : " wirkt ") +
           "mickrig neben "+ob2->name(WEM,1);
  if (-diff > wert1)    return name1ist+"viel schlechter als " + name2;
  if (-diff > wert1/5)  return name1ist+"schlechter als " + name2;
  if (-diff > wert1/10) return name1ist+"etwas schlechter als " + name2;
  return (name1 + " und " + name2 + " sind etwa gleich gut");
}

string comp_weight(object ob1, object ob2)
{
  string name1, name2, name1ist;
  int wert1, wert2, diff;

  name1 = ob1->Name(WER, 1);
  name2 = ob2->name(WER, 1);
  wert1 = ob1->QueryProp(P_WEIGHT);
  wert2 = ob2->QueryProp(P_WEIGHT);
  diff = wert1 - wert2;
  if (IS_LEARNER(TP) && TP->QueryProp(P_WANTS_TO_LEARN))
  {
    write("  Gewicht1: " + wert1 + "\n");
    write("  Gewicht2: " + wert2 + "\n"); 
    write("  Gewichtsdifferenz: " + diff + "\n");
  }

  if (ob1->IsPlural())
    name1ist=name1+" sind ";
  else
    name1ist=name1+" ist ";

  if (diff > wert2*3/2)  return name1ist + "viel schwerer als " + name2;
  if (diff > wert2/3)    return name1ist + "schwerer als " + name2;
  if (diff > wert2/6)    return name1ist + "etwas schwerer als " + name2;
  if (-diff > wert1*3/2) return name1ist + "viel leichter als " + name2;
  if (-diff > wert1/3)   return name1ist + "leichter als " + name2;
  if (-diff > wert1/6)   return name1ist + "etwas leichter als " + name2;
  return (name1 + " und " + name2 + " sind etwa gleich schwer");
}

int repair(string str)
{
  object ob;
  int dam, wert, maxwert, damrest, preis, damrest_pct;

  notify_fail("Was willst Du reparieren lassen?\n");
  if (!str || !stringp(str)) return 0;
  if (!ob=present(str,TP)) {
    write(WEBS("So etwas hast Du ja gar nicht dabei!\n"));
    return 1;
  }
  dam = ob->QueryProp(P_DAMAGED);
  if (ob->QueryProp(P_WEAPON_TYPE)) {
    write(WEBS("Aha, eine Waffe willst Du also reparieren lassen! "+
        "Na mal sehen, was sich da noch machen laesst..."));
    wert=ob->QueryProp(P_WC);
    damrest_pct=5+random(3);
    preis=50;   // Multiplikator
  }
  else if (ob->QueryProp(P_ARMOUR_TYPE)) {
    write(WEBS("Aha, eine Ruestung willst Du also reparieren lassen! "+
        "Na mal sehen, was sich da noch machen laesst..."));
    wert=ob->QueryProp(P_AC);
    damrest_pct=8+random(2);
    preis=200;  // Multiplikator
  }
  else {
    write(WEBS("Ich kenne mich nur mit Waffen und Ruestungen "
        "aus, nicht aber mit dem Zeug, das Du da bei Dir hast!"));
    return 1;
  }
  write("Die Waffenexpertin prueft "+ob->name(WEN,1)+" eingehend.\n");
  maxwert = wert + dam;
  damrest = (maxwert * damrest_pct) / 100;
  if (damrest<1) damrest=1;
  if (dam <= damrest) {
    write(WEBS("Hmmm, die Schaeden an "+ob->name(WEM,1)+" sind minimal, "
        "da kann ich auch nichts mehr weiter tun!"));
    return 1;
  }
  preis=preis*(dam-damrest);
  write(WEBS("Die Reparatur "+ob->name(WESSEN,1)+" wuerde Dich "+
      preis+" Muenzen kosten."));
  write("Willst Du sie durchfuehren lassen? (ja/nein) -> ");
  input_to("repair2", 0, ob, dam, dam-damrest, preis, time());
  return 1;
}

void repair2(string str, object ob, int dam, int damrep, int preis, int zeit)
{
  if (!TP) return;
  if (environment(TP) != ME) {  // Spieler mit !bla rausgegangen...?
    write("Dazu ist es jetzt zu spaet!\n");
    return;
  }
  if (time() > (zeit+15))       // 15 Sekunden Zeit
  {
    write(WEBS("Du hast Dir zuviel Zeit gelassen! Ueberlege es Dir "
        "noch einmal... mein Angebot bleibt natuerlich bestehen!"));
    return;
  }
  if ((str!="ja") && (str!="j")) {
    write(WEBS("Na gut, wie Du meinst. Viel Spass noch damit!"));
    return;
  }
  if (!ob) {
    write(WEBS("Nanu, wo ist denn der fragliche Gegenstand "
        "so ploetzlich hinverschwunden??"));
    return;
  }
  if (environment(ob) != TP) {
    write(WEBS("Nanu, wo "+(ob->IsPlural() ? "sind" : "ist")+" denn "+
          ob->name(WER,1)+" so ploetzlich hinverschwunden??"));
    return;
  }
  if (dam != ob->QueryProp(P_DAMAGED)) {
    write(WEBS("Huch, irgendwas stimmt da nicht, "+ob->name(WER,1)+
          (ob->IsPlural() ? " sind" : " ist")+
          (dam > ob->QueryProp(P_DAMAGED) ?
                    " ja gar nicht mehr so arg" :
                    " ploetzlich viel schlimmer")+
          " beschaedigt! Nein, das ist mir zu unheimlich,"
          " da lasse ich lieber die Finger davon!"));
    return;
  }
  if (TP->QueryMoney() < preis) {
    write(WEBS("Das Problem ist nur, dass Du "+preis+" Muenzen "
        "gar nicht dabeihast! Das beste ist, Du holst Dir etwas "
        "Geld von der Bank oder pumpst Dir etwas..."));
    return;
  }
  TP->AddMoney(-preis);
  ZENTRALBANK->PayIn(preis);
  ob->Damage(-damrep);
  write(BS("Die Waffenexpertin nimmt Dir "+preis+" Muenzen ab und beginnt "
      "mit der Reparatur "+ob->name(WESSEN,1)+". Kurze Zeit spaeter ist "
      "sie fertig und drueckt "+ob->QueryPronoun(WEN)+" Dir in wesentlich "
      "besserem Zustand als zuvor in die Hand."));
}


