//erstellt am 25.01.2003 von hiri

#include "../def.h"

inherit "std/room";
#include <room/doors.h>
#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();

  SetProp( P_INT_SHORT, "Vor einer Sandburg" );
  SetProp( P_INT_LONG,
    "Du bist ueber die kleine Haengebruecke gehuepft und stehst nun "
    "so klein wie Du bist, vor einem nicht gerade kleinen Tor. Seltsam, "
    "wie kann das sein? Die Burg scheint riesig und ein ebenso riesig "
    "erscheinender Waechter haelt hier Wache. Auf dem Boden siehst Du Sand, "
    "was ja nicht verwunderlich ist. Unter der Haengebruecke fliesst der "
    "Burggraben durch. Klitzekleine Fische schwimmen in dem Graben umher.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );
 
  AddDetail( ({ "tor"}),
    "Das Tor ist aus kleinen Holzstueckchen gefertigt und laesst sich mit "
    "dem Torgriff der aus einem Metallring besteht, sicher leicht oeffnen.");
  AddDetail( ({ "torgriff", "griff"}),
    "Der Torgriff besteht aus einem Metallriegel.");
  AddDetail( ({ "metallriegel", "riegel"}),
    "Der Metallriegel ist schon ziemlich verrostet.");
  AddDetail( ({"haengebruecke", "bruecke"}),
    "Du bist als Frosch von der Haengebruecke gekommen, ob Du allerdings , "
    "so weiter kommst......................? Aber Du kannst als Frosch die "
    "Haengebruecke wieder betreten.");
  AddDetail( ({"sand"}),
    "Der Sand unter Deinen Fuessen ist samtig und feingekoernt.");
  AddDetail( ({"holzstueckchen", "stueckchen"}),
    "Die Holzstueckchen, aus dem das Tor gebaut wurde, sehen recht "
    "stabil aus");
  AddDetail( ({"boden"}),
    "Der Boden ist hier mit sehr viel Sand bedeckt. Ein paar trockene "
    "Grashalme stehen hier und da.");
  AddDetail( ({"gras","grashalme","halme"}),
    "Diese Grashalme sind recht duerr und nur spaerlich vorhanden.");
  AddDetail( ({"burg"}),
    "Die Burg erscheint Dir riesig, was nicht alleine daran liegt "
    "das Du ein Frosch bist. Auch in Deiner normalen Gestalt ist "
    "die Burg groesser geworden. Eine magische Macht scheint es "
    "zu bewirken.");
  AddDetail( ({"frosch"}),
    "Du bist als Frosch ueber die Haengebruecke gehuepft. Hast Du "
    "Serian schon um entfroschung gebeten? Nicht? Na dann wird es "
    "Zeit. Du kommst hier als Frosch nicht weiter....");
  AddDetail( ({"hilfe"}),
    "Mit Hilfe des Riegels kann man das Tor oeffnen.");
  AddDetail( ({"serian"}),
    "Serian ist der Torwaechter, er passt auf das man nicht so einfach "
    "die Haengebruecke oder die Burg betritt.");
  AddDetail( ({"torwaechter","waechter"}),
    "Der Torwaechter Serian bewacht die Haengebruecke und das Tor.");
  AddDetail( ({"wache"}),
    "Der Torwaechter ist die hiesige Wache.");
  AddDetail( ({"fuessen","fuesse"}),
    "Du stehst mit Deinen Fuessen auf samtig weichem Sand.");
  AddDetail( ({"zeit"}),
    "Wenn Du Dich noch nicht in Deine normale Gestalt verwandeln "
    "hast lassen wird es Zeit das zutun.");
  AddDetail( ({"gestalt"}),
    "Was Du in Deiner normalen Gestalt darstellst duerfte Dir wohl "
    "selbst bekannt sein.");
  AddDetail( ({"macht"}),
    "Eine sehr starke negative magische Macht geht von der Burg aus."
    "Daher ist sie auch ploetzlich groesser als es auf den ersten Blick "
    "erscheinen mag.");
  AddDetail( ({"blick"}),
    "Der erste Blick scheint oft truegerisch.");
  AddDetail( ({"holzlatten","latten"}),
    "Das Tor ist aus Holzlatten gefertigt und sieht recht stabil aus.");
  AddDetail( ({"himmel"}),
    "Der Himmel ist wolkenlos ausser ein paar Moewen sieht man in weiter "
    "ferne nur einen Heissluftballon.");
  AddDetail( ({"heissluftballon","ballon"}),
    "Das ist wohl der Heissluftballon der zwischen Tijara und Arakeen "
    "hin und herpendelt.");
  AddDetail( ({"arakeen","tijara"}),
    "Tijara und Arakeen sind Staedte des Silberlandes und Landestellen "
    "fuer den Heissluftballon.");
  AddDetail( ({"staedte"}),
    "Im Silberland gibt es mehrere Staedte. Arakeen und Tijara sind "
    "welche davon."),
  AddDetail( ({"silberland"}),
    "Du spielst gerade im Silberland.");
  AddDetail( ({"landestellen"}),
    "Die Landestellen fue den Heissluftballon sind in Tijara und Arakeen.");
  AddDetail( ({"moewen"}),
    "Hoch am Himmel kreisen Moewen und greischen sehr laut.");
  AddDetail( ({"fische"}),
    "In dem Burggraben schwimmen lauter klitzekleine Fische umher.");
  AddDetail( ({"burggraben","graben"}),
    "Der Burggraben geht um die Burg herum und in seinem Wasser ihm "
    "schwimmen lauter klitzekleine Fische herum.");
  AddDetail( ({"wasser"}),
    "Leise hoert man das Wasser des Burggraben fliessen.");
  AddDetail( ({"holz"}),
    "Das Tor und die Haengebruecke sind aus Holz.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst die Moewen am Himmel kreischen und leise hoert man das "
    "Wasser des Burggraben fliessen.");
  AddSound( ({ "wasser"}),
    "Man hoert leise das Wasser im Burggraben fliessen.");
  AddSound( ({ "moewen" }),
    "Die Moewen kreischen hoch oben am Himmel, wie sie es ja immer tun.");
  AddSmell( DEFAULT_SMELL,
    "Du riechst das Holz der Haengebruecke und etwas salzig riecht es auch hier. "
    "Das Meer gibt sicherlich diesen salzigen Duft ab.");
  AddSmell( ({ "meer"}),
    "Du kannst das Meer sehr schwach riechen.");
  AddSmell( ({ "duft" }),
    "Du kannst diesen salzigen Duft dem Meer zuordnen.");
  





   
   


 AddItem( "/d/wasser/hiri/sandburg/npc/serian.lpc", REFRESH_DESTRUCT);


 
 

 NewDoor( "osten", "/d/wasser/hiri/sandburg/room/weg.lpc", ({"tor", "holztor" }),
       ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
        D_NAME, "Holztor",
        D_GENDER, FEMALE,
        D_SHORT, "Im Osten befindet sich ein %ses Holztor. ",
        D_LONG, "Ein aus kleinen Holzlatten gemachtes Tor. "
                "Dir kommt es riesig vor, was daher ruehrt, "
		"das Du klitzeklein geworden bist. "
                "Man kann es mit Hilfe eines Riegels oeffnen "
		"und auch wieder schliessen. ",
        D_MSGS, ({ "hinaus", "geht wieder", "kommt herein" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und das Tor oeffnet sich. Waehrend Du es Oeffnens, "
		      "bemerkst Du, dass das Holztor immer groesser wird, "
		      "so das Du mit Deiner groesse bequem hindurchgehen kannst. ",
                      "Mit lautem Knarren schiebt %s den Riegel beiseite. ",
                      " wird mit lautem Knarren von aussen geoeffnet. " }),
       D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du das Tor. ",
                       "Mit einem lauten Rumms schliesst %s das Tor. ",
                       " wird mit lautem Knarren von aussen geschlossen. " }),           
	D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. ",
              D_TESTFUNC, "tor_testfunc",
	      D_OPENTESTFUNC, "tor_testfunc" }) );


 AddCmd( ({"betrete", "betret"}), "betreten" );	      
}
int betreten(string str)
{
   notify_fail("Was moechtest Du betreten?\n");
   if ( member( ({ "haengebruecke", "bruecke" }),str) != -1) 
   {
     if (!TP->QueryProp(P_FROG)) 
     {
       write("Du bist viel zu gross fuer die Bruecke!\n");
       say(TPN+" will die Bruecke betreten, scheint aber zu gross zu sein.\n");
       return 1;
     }
     write("Du betrittst die Bruecke.\n");
     TP->move("/d/wasser/hiri/sandburg/room/haengebruecke.lpc", M_GO, "auf die Bruecke", "huepft", 
      "huepft herein");
     return 1;
    }
}

int tor_testfunc()
{
  if (TP->QueryProp(P_FROG))
  {
    write("Als Frosch hast Du nichts in der Burg verloren!\n");
    return 1;
  }
  return 0;
}
