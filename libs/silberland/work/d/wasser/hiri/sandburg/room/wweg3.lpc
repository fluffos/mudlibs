#include "../def.h"

inherit "std/room";

#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();

  SetProp( P_INT_SHORT, "Auf dem Wachweg" );
  SetProp( P_INT_LONG,
    "Du gehst auf dem Wachweg und kannst von hier aus nicht ueber die "
    "Bruestung der Aussenmauer sehen. Doch kannst Du auf den Burghof schauen, "
    "da zur Burgmitte hin, nur ein Holzgelaender als Schutz dient.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_PLAIN]) );
 
  AddDetail( ({ "wachweg","weg"}),
    "Du gehst hier auf dem Wachweg. Er ist aus massivem Holz gefertigt und "
    "die Holzbohlen knarren unter Deinen Fuessen.");
  AddDetail( ({"holzbohlen","bohlen"}),
    "Die Holzbohlen bilden den Wachweg und sind aus sehr massivem Holz "
    "hergestellt worden.");
  AddDetail( ({"holz"}),
    "Die Holzbohlen sind aus massivem Holz gefertigt und Sawer, wird sie "
    "bearbeitet haben.");
  AddDetail( ({"sawer"}),
    "Sawer ist der Tischler, er ist bei den Holzfaellern ansaessig und "
    "hat dort seine kleine Tischlerei.");
  AddDetail( ({"tischler"}),
    "Der Tischler heisst Sawer.");
  AddDetail( ({"holzfaeller","faeller"}),
    "Die Holzfaeller beliefern Sawer mit Holz.");
  AddDetail( ({"tischlerei"}),
    "Sawer besitzt eine Tischlerei um solche Holzbohlen fuer Wachwege zu "
    "fertigen.");
  AddDetail( ({"holzgelaender","gelaender"}),
    "Das Holzgelaender, ist auch aus dem selben massivem Holz gemacht, "
    "wie die Holzbohlen des Wachweges.");
  AddDetail( ({"schutz"}),
    "Das Holzgelaender bietet Dir Schutz. So kannst Du nicht in den "
    "Burghof fallen.");
  AddDetail( ({ "bruestung"}),
    "Du kannst nicht ueber die Bruestung der Aussenmauer schauen. Sie  "
    "ist einfach zu hoch.");
  AddDetail( ({ "aussenmauer","mauer"}),
    "Du schaust auf die Aussenmauer und erschrickst etwas. Du kannst die Insel "
    "und das Meer durch einen Schimmer erkennen. Du denkst Dir: So kann ich ja "
    "doch sehen was Ausserhalb vor sich geht!");
  AddDetail( ({"ausserhalb"}),
    "Durch die Aussenmauer kannst Du erkennen was dort vor sich geht. "
    "Du kannst auch eine kleine Huette und einen Brunnen erkennen. "
    "Seltsamerweise kannst Du auch den kleinen Steg am Ende der Insel "
    "erkennen.");
  AddDetail( ({"huette"}),
    "Die Huette ist wie Du sicherlich weist nicht begehbar, vielleicht "
    "aendert sich das ja noch.....!");
  AddDetail( ({"steg"}),
    "Der kleine Steg am Ende der Insel ist seltsamerweise von hier aus "
    "auch zu erkennen.");
  AddDetail( ({"ende"}),
    "Am Ende dieser Insel ist ein kleiner Steg.");
  AddDetail( ({"insel"}),
    "Du bist auf der Insel. Aber in dieser seltsamen Sandburg.");
  AddDetail( ({"brunnen"}),
    "Welchen Brunnen meinst Du? Den Inselbrunnen oder den Burgbrunnen? ");
  AddDetail( ({"inselbrunnen"}),
    "Den Inselbrunnen kannst Du durch die Aussenmauer sehen, es kommt "
    "Dir so vor, als ob sich dort etwas bewegt.");
  AddDetail( ({"burgbrunnen"}),
    "Den Burgbrunnen hast Du sicherlich schon genauer angeschaut.");
  AddDetail( ({"schimmer"}),
    "Du kannst ueberall diesen Schimmer erkennen, der Dir hier in der "
    "Sandburg, ja schon oft aufgefallen ist."); 
  AddDetail( ({"meer","meeres"}),
    "Du siehst das Meer durch die Mauer, aber leider nur sehr undeutlich. "
    "Aber man kann es auch hoeren und riechen.");
  AddDetail( ({"boden"}),
    "Der Boden ist aus starken Holzbohlen gefertigt und geben Dir eine gute "
    "moeglichkeit ueber den Wachweg zu laufen.");
  AddDetail( ({"fuessen"}),
    "Die Holzbohlen geben Dir halt und knarren leise unter Deinen Fuessen.");
  AddDetail( ({"spiegel"}),
    "Es scheint, als ob Du Dich im Boden, in einem Spiegel betrachtest. "
    "Seltsam, aber hier ist alles durchsichtig und Du denkst Dir das eine "
    "grosse unheimliche Macht seine Finger im Spiel hat.");
  AddDetail( ({"macht"}),
    "Eine unheimliche Macht hat diese Sandburg so veraendert das Du Dir kaum "
    "erklaeren kannst was hier passiert.");
  AddDetail( ({"finger"}),
    "Du hast zehn Finger aber hier hat eine andere Macht ihre Finger im Spiel.");
  AddDetail( ({"spiel"}),
    "Eine unheimliche Macht hat ihre Finger im Spiel und Du kannst Dir dies hier "
    "kaum erklaeren.");
  AddDetail( ({"burghof"}),
    "Du kannst ueber das Holzgelaender auf den Burghof der Sandburg schauen "
    "und siehst dort den zerstoerten Brunnen und das Tor.");
  AddDetail( ({"tor"}),
    "Du kannst das Tor der Sandburg von hier aus sehen. Um durch zu gehen "
    "solltest Du aber den Wachweg wieder verlassen.");
  AddDetail( ({"burgmitte","mitte"}),
    "In der Burgmitte kannst Du den zerfallen Brunnen erkennen.");
  AddDetail( ({"sandburg","burg"}),
    "Du gehst auf dem Wachweg der unheimlichen Sandburg.");
 AddDetail( ({"koerper"}),
    "Wenn Du der Armee der Untoten gewahr wirst, erzittert Dein ganzer Koerper.");
  AddDetail( ({"untote"}),
    "Wenn DU mehr ueber Untote erfahren moechtest, solltest Du einmal zu Xarfai gehen.");
  AddDetail( ({"xarfai"}),
    "Xarfai ist das Gildenoberhaupt der Nekromanten.");
  AddDetail( ({"gildenoberhaupt","oberhaupt"}),
    "Das Gildenoberhaupt der Nekromanten ist Xarfai.");
  AddDetail( ({"nekromanten"}),
    "Die Nekromanten wissen sehr genau was Untote sind.");
  AddDetail( ({"ohr"}),
    "Mit Deinem Ohr kannst Du hoeren. Versuch es mal.");
  AddDetail( ({"fea","fenda","hisie"}),
    "Diese Worte, Fea, Fenda , Hisie kannst Du nicht verstehen.");
  AddDetail( ({"mulash"}),
    "Mulash.....wer kann das sein? Versuch es herauszufinden.");
  AddDetail( ({"armee"}),
    "Die Armee der Untoten schwebt von Zeit zu Zeit durch die Burg und "
    "treibt ihr Unwesen.");
  AddDetail( ({"unwesen"}),
    "Die Armee der Untoten treibt hier ihr Unwesen.");
  AddDetail( ({"geraschel"}),
    "Wenn die Armee der Untoten ihr Unwesen treibt kann man Geraschel und "
    "Stimmen hoeren.");
  AddDetail( ({"stimmen"}),
    "Die Stimmen und das Geraschel sind eigendlich immer zu hoeren. Auch wenn "
    "die Armee der Untoten gerade nicht da ist.");
  AddDetail( ({"zeit"}),
    "Von Zeit zu Zeit treibt die Armee der Untoten ihr Unwesen in der Burg.");
  AddDetail( ({"worte"}),
    "Diese Worte sind Dir fremd und Du wirst sie niemals verstehen koennen.");
  AddDetail( ({"himmel"}),
    "Hier kannst Du den Himmel nur undeutlich erkennen, was unerklaerlich ist, "
    "da Du die Insel ja sehr gut erkennen kannst.");
 




  AddRoomMessage( ({"Die Armee der Untoten erscheint und schwebt durch Dich hindurch.\n",
      "Dir wird schrecklich kalt und Du zitterst am ganzen Koerper.\n",
      "Du hoerst ueberall Geraschel und leise Stimmen.\n"
      "Du hoerst unbekannte Laute an Dein Ohr dringen.\n"
      "Hisie, Hisie fana Fenda.\n"
      "Dagrodi dacil Fea Mulash.\n"}),30,"func");
 
  AddSound( DEFAULT_SOUND,
    "Das Geraschel und die Stimmen die ab und an zu hoeren sind "
    "lassen Dich erzittern. Manchmal fluestern die Stimmen etwas "
    "in einer Dir unbekannten Sprache. Weit entfernt kannst Du leise "
    "das Meer hoeren. Und unter Deinen Fuessen knarren die Holzbohlen.");
  AddSound( ({ "geraschel"}),
    "Wenn die Armee der Untoten erscheint vernimmst Du dieses Geraschel.");
  AddSound( ({ "stimmen"}),
    "Die Stimmen fluestern stetig in einer Dir fremden Sprache.");
  AddSound( ({ "sprache"}),
    "Du hoerst leise die Stimmen der Untoten in einer fremden Sprache.");
  AddSound( ({"laute"}),
    "Die Laute dringen ploetzlich an Dein Ohr. Verstehen kannst Du sie nicht");
  AddSound( ({"meer"}),
    "Du kannst das Meer leise hoeren und wuenschst Dich von hier fort.");
  AddSound( ({"fuessen"}),
    "Du hoerst leises knarren unter Deinen Fuessen. "); 
  AddSmell( DEFAULT_SMELL,
    "Du kannst hier schwach den Geruch des Meeres wahrnehmen.");
  AddSmell( ({ "geruch"}),
    "Du kannst schwach den Geruch des Meeres wahrnehmen.");

  
//  AddCmd(  ({ "zieh", "ziehe" }), "ziehen"  );
//  AddCmd(  ({ "zwaeng", "zwaenge" }), "zwaenge"  );
  //sagt, mit welchem verb da ne funktion kommt


//  AddItem(NPC "krabbe", REFRESH_DESTRUCT);
//  AddItem(NPC "eidechse", REFRESH_DESTRUCT);
    



  
  AddExit( "osten",  ROOM "zinne" );
  AddExit( "westen",  ROOM "wweg4" );

// Ende Create
}
