#include "../def.h"

inherit "std/room";

#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();

  SetProp( P_INT_SHORT, "In einem Zwinger" );
  SetProp( P_INT_LONG,
    "Du stehst jetzt in dem Zwinger. Auge und Auge mit dem Hund. "
    "Du zitterst etwas und kannst ausser den Knochen und dem Hund nicht "
    "wirklich viel sehen. Du siehst nach Osten durch die Gitterstaebe "
    "auf den Turm. Nach Westen blickst Du auf den Wachweg.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_PLAIN]) );
 
  AddDetail( ({ "zwinger","zwingers"}),
    "Du befindest Dich nun im Zwinger. Auge in Auge mit dem Hund.");
  AddDetail( ({ "auge"}),
    "Auge in Auge stehst Du mit dem Hund.");
  AddDetail( ({ "knochen"}),
    "Ob von Dir mehr als Knochen ueberig bleibt ist ungewiss.");
  AddDetail( ({"gitterstaebe","staebe"}),
    "Die Gitterstaebe ind Dein einzigster Ausweg. Renn oder fliehe durch "
    "sie, wenn Dir Dein Leben lieb ist.");
  AddDetail( ({"turm"}),
    "Du siehst den Turm aber kannst ihn nicht erreichen.");
  AddDetail( ({"wachweg","weg"}),
    "Du kommst auf den Wachweg zurueck in dem Du durch die Gitterstaebe "
    "fliehst oder rennst.");
  AddDetail( ({"koerper"}),
    "Wenn Du der Armee der Untoten gewahr wirst, erzittert Dein ganzer Koerper.");
  AddDetail( ({"untote"}),
    "Wenn DU mehr ueber Untote erfahren moechtest, solltest Du einmal zu Xarfai gehen.");
  AddDetail( ({"xarfai"}),
    "Xarfai ist das Gildenoberhaupt der Nekromanten.");
  AddDetail( ({"gildenoberhaupt","oberhaupt"}),
    "Das Gildenoberhaupt der Nekromanten ist Xarfai.");
  AddDetail( ({"nekromanten"}),
    "Die Nekromanten wissen sehr genau was Untote sind.");
  AddDetail( ({"ohr"}),
    "Mit Deinem Ohr kannst Du hoeren. Versuch es mal.");
  AddDetail( ({"fea","fenda","hisie"}),
    "Diese Worte, Fea, Fenda , Hisie kannst Du nicht verstehen.");
  AddDetail( ({"mulash"}),
    "Mulash.....wer kann das sein? Versuch es herauszufinden.");
  AddDetail( ({"armee"}),
    "Die Armee der Untoten schwebt von Zeit zu Zeit durch die Burg und "
    "treibt ihr Unwesen.");
  AddDetail( ({"unwesen"}),
    "Die Armee der Untoten treibt hier ihr Unwesen.");
  AddDetail( ({"geraschel"}),
    "Wenn die Armee der Untoten ihr Unwesen treibt kann man Geraschel und "
    "Stimmen hoeren.");
  AddDetail( ({"stimmen"}),
    "Die Stimmen und das Geraschel sind eigendlich immer zu hoeren. Auch wenn "
    "die Armee der Untoten gerade nicht da ist.");
  AddDetail( ({"zeit"}),
    "Von Zeit zu Zeit treibt die Armee der Untoten ihr Unwesen in der Burg.");
  AddDetail( ({"worte"}),
    "Diese Worte sind Dir fremd und Du wirst sie niemals verstehen koennen.");
  AddDetail( ({"himmel"}),
    "Hier kannst Du den Himmel nur undeutlich erkennen, da Du durch die "
    "unsichtbare Decke des Zwingers schaust.");
  AddDetail( ({"sandburg","burg"}),
    "Du befindest Dich im Zwinger der unheimlichen Sandburg.");
  AddDetail( ({"decke"}),
    "Die Decke des Zwingers ist ueber Dir und durchsichtig.");
  AddDetail( ({"hund","geisterhund"}),
    "Du stehst dem Hund, Auge in Auge gegenueber.");
  AddDetail( ({"ausweg"}),
    "Der einzigste Ausweg hier heraus ist durch die Gitterstaebe "
    "zu rennen oder zu fliehen.");
  AddDetail( ({"leben"}),
    "Wenn Du kannst und Dir Dein Leben lieb ist, renn oder flieh.");
  AddDetail( ({"boden"}),
    "Auch der Boden ist durchsichtig, erkennen kannst Du aber nichts. "
    "Es ist dunkel dort unten.");

 




  AddRoomMessage( ({"Die Armee der Untoten erscheint und schwebt durch Dich hindurch.\n",
      "Dir wird schrecklich kalt und Du zitterst am ganzen Koerper.\n",
      "Du hoerst ueberall Geraschel und leise Stimmen.\n"
      "Du hoerst unbekannte Laute an Dein Ohr dringen.\n"
      "Hisie, Hisie fana Fenda.\n"
      "Dagrodi dacil Fea Mulash.\n"}),30,"func");
 
  AddSound( DEFAULT_SOUND,
    "Das Geraschel und die Stimmen die ab und an zu hoeren sind "
    "lassen Dich erzittern. Manchmal fluestern die Stimmen etwas "
    "in einer Dir unbekannten Sprache. Weit entfernt kannst Du leise "
    "das Meer hoeren.");
  AddSound( ({ "geraschel"}),
    "Wenn die Armee der Untoten erscheint vernimmst Du dieses Geraschel.");
  AddSound( ({ "stimmen"}),
    "Die Stimmen fluestern stetig in einer Dir fremden Sprache.");
  AddSound( ({ "sprache"}),
    "Du hoerst leise die Stimmen der Untoten in einer fremden Sprache.");
  AddSound( ({"laute"}),
    "Die Laute dringen ploetzlich an Dein Ohr. Verstehen kannst Du sie nicht");
  AddSound( ({"meer"}),
    "Du kannst das Meer leise hoeren und wuenschst Dich von hier fort.");
  
  AddSmell( DEFAULT_SMELL,
    "Du kannst hier schwach den Geruch des Meeres wahrnehmen.");
  AddSmell( ({ "geruch"}),
    "Du kannst schwach den Geruch des Meeres wahrnehmen.");

  
  AddCmd(  ({ "flieh", "fliehe" }), "fliehen"  );
  AddCmd(  ({ "renn", "renne" }), "rennen"  );
  //sagt, mit welchem verb da ne funktion kommt


  AddItem(NPC "ghostdog", REFRESH_DESTRUCT);
//  AddItem(NPC "eidechse", REFRESH_DESTRUCT);
    



  
//  AddExit( "osten",  ROOM "unsichtbar" );
//  AddExit( "westen",  ROOM "wweg1" );

// Ende Create
}
int fliehen(string str)
{
 notify_fail("Wodurch willst Du fliehen?\n");

 if(!str || str == "") return 0;
 if(!(str=="durch gitterstaebe"||
      str=="durch staebe"))     
 return 0;
 

 write(BS("Du fliehst schnell durch die Gitterstaebe. Sie Bersten auseinander "
	  "und Du faellst auf den Wachweg.\n"));
 TP->AddHp(-50); 
 say(TPN+" faellt aus dem Zwinger und wimmert.\n");

 TP->move( ROOM "wweg1", M_GO, "flieht");


 return 1;
}
int rennen(string str)
{
 notify_fail("Wodurch willst Du rennen?\n");

 if(!str || str == "") return 0;
 if(!(str=="durch gitterstaebe"||
      str=="durch staebe"))     
 return 0;
 

 write(BS("Du rennst nach Osten und bemerkst zuspaet das Dich gaehnende "
	  "Leere erwartet. Leider faellst Du schon in die Tiefe. "
	  "WAS WAR DAS? Ploetzlich kommt ein Geist heran geschwebt. "
	  "Manifiziert sich in eine Reale Gestalt. Eine Fee. Sie faengt "
	  "Dich auf und traegt Dich hinfort.\n"));
 
 say(TPN+" faellt aus dem Zwinger und wimmert.\n");

 TP->move( "/d/wasser/hiri/inselversteck/room/insel.lpc", M_GO, "rennt");


 return 1;
}

