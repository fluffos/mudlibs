#include "../def.h"

inherit "std/room";

#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();

  SetProp( P_INT_SHORT, "Auf einer Haengebruecke" );
  SetProp( P_INT_LONG,
    "Du gehst gerade ueber die Haengebruecke, die Dir jetzt nicht mehr klein. "
    "sondern ganz normal vorkommt. Woran das liegt? Schau Dich mal an. Ganz "
    "klein bist Du geworden. Unter Dir fliesst der Burggraben. Er ist mit "
    "klarem, kuehlen Wasser gefuellt. Nach Osten hin kommst Du zu der kleinen "
    "Sandburg. Naja, jetzt ist auch die Sandburg in der richtigen Groesse. "
    "Nach Westen kommst Du wieder auf die Insel.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );
 
  AddDetail( ({ "haengebruecke", "bruecke"}),
    "Die Haengebruecke ist aus kleinen Holzstueckchen gefertigt und hat ein "
    "Seilgeflecht an dem man sich festhalten kann.");
  AddDetail( ({ "holzstueckchen", "holz", "stueckchen"}),
    "Die Haengebruecke besteht aus Holzstueckchen, die Dir aber jetzt "
    "gross genug erscheinen um darueber zu gehen.");
  AddDetail( ({ "seilgeflecht", "geflecht"}),
    "Das Seilgeflecht ist an den Seiten der Bruecke befestigt und man "
    "kann sich daran festhalten.");
  AddDetail( ({ "seiten"}),
    "An beiden Seiten der Haengebruecke kann man sich an dem "
    "Seilgeflecht festhalten.");    
  AddDetail( ({ "sandburg", "burg" }),
    "Die Sandburg sieht fast aus wie ein Bildnis von der Burg Sturmfels, "
    "aber eben nur fast, sie hat sogar einen Wassergraben und vier Tuerme. "
    "Ein kleines Tor kannst Du auch erkennen und eine Haengebruecke.");
  AddDetail( ({ "bildnis" }),
    "Man koennte meinen, die Sandburg waere ein Bildnis von Sturmfels.");
  AddDetail( ({ "sturmfels"}),
    "Als Paladin wird Dir Sturmfels ganz gewiss bekannt sein, "
    "andernfalls hast Du aber bestimmt schon etwas darueber gehoert.");
  AddDetail( ({ "paladin"}),
    "Willst Du jetzt wirklich sagen, Du weisst nicht, was ein Paladin ist?");
  AddDetail( ({ "tuerme","turm" }),
    "Es sind vier Tuerme an den Ecken der Sandburg gebaut, auf jedem der "
    "Tuerme weht eine kleine Fahne.");
  AddDetail( ({ "fahne"}),
    "Die Fahne, die auf jedem der vier Tuerme gleich aussieht, ist aus "
    "blaugruenen Algenblaettern und einem Holzstueckchen gemacht.");
  AddDetail( ({ "algenblaettern", "blaettern", "blaetter"}),
    "Die Algenblaetter sind blaugruen und haengen momentan an den "
    "Holzstueckchen herunter.");
  AddDetail( ({ "algenblaetter", "blaetter"}),
    "Die Algenblaetter haengen an den Holzstueckchen herab.");
  AddDetail( ({ "ecken"}),
    "Vier Ecken sind es, wie auch vier Tuerme.");
  AddDetail( ({ "burggraben"}),
    "Der Burggraben ist ein Wassergraben der um die Sandburg herum fuehrt.");
  AddDetail( ({ "wassergraben", "graben"}),
    "Der Wassergraben fuehrt um die Sandburg herum und ist mit Wasser "
    "gefuellt");
  AddDetail( ({ "wasser"}),
    "Das Wasser wird aus dem Meer hierher abgeleitet."); 
  AddDetail( ({ "meer"}),
    "Da Du ja so klein geworden bist, kommt Dir das Meer riesig vor.");
  AddDetail( ({ "boden"}),
    "Die Haengebruecke bildet hier den Boden.");
  AddDetail( ({ "groesse"}),
    "Die Groesse der Haengebruecke und der Sandburg scheint nun "
    "genau richtig zu sein.");
  AddDetail( ({ "himmel"}),
    "Der Himmel ist sehr sehr hoch oben. Du kannst garnichts an "
    "ihm erkennen.");
  AddDetail( ({ "insel"}),
    "Wenn Du nach Westen gehst, betrittst Du die Insel wieder.");
  AddDetail( ({ "westen"}),
    "Nach Westen kannst Du wieder zurueck zur Insel gehen.");
  AddDetail( ({ "tor"}),
    "Im Osten siehst Du das Tor der Sandburg.");
  AddDetail( ({ "osten"}),
    "Wenn Du nach Osten gehst, stehst Du direkt vor dem Tor der "
    "Sandburg.");
//  AddCmd(  ({ "zieh", "ziehe" }), "ziehen"  );
//  AddCmd(  ({ "zwaeng", "zwaenge" }), "zwaenge"  );
  //sagt, mit welchem verb da ne funktion kommt


//  AddItem(NPC "krabbe", REFRESH_DESTRUCT);
//  AddItem(NPC "eidechse", REFRESH_DESTRUCT);
    

  AddExit( "osten",  "/d/wasser/hiri/sandburg/room/burg1.lpc" );
  AddExit( "westen", "/d/wasser/hiri/inselversteck/room/insel3.lpc" );
 // Ende Create


}
