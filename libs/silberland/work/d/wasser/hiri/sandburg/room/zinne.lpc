//erstellt am 12.11.2003 von hiri

#include "../def.h"

inherit "std/room";

#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();

  SetProp( P_INT_SHORT, "Auf einem Erker" );
  SetProp( P_INT_LONG,
    "Hier ist ein kleiner Erker und Du kannst die Insel und das Meer "
    "sehen. Westlich von Dir fuehrt ein Wachweg zu einem der vier "
    "Tuerme. Oestlich fuehrt ebenso ein Wachweg zu einem Turm und "
    "nach Nordunten kannst Du wieder zu dem Burghof gelangen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_PLAIN]) );
 
  AddDetail( ({ "erker"}),
    "Dieser Erker ist nicht sehr gross, aber man kann hier einen Ausblick "
    "auf die Insel geniessen.");
  AddDetail( ({ "ausblick"}),
    "Der Ausblick ist berauschend, vorallem weil Dir die Insel riesig vorkommt. "
    "Es ist seltsam da Du Deine normale groesse hast und die Burg Dir auch "
    "gross und maechtig vorkommt.");
  AddDetail( ({ "insel"}),
    "Die Insel kommt Dir sehr gross vor und Du kannst es Dir nicht erklaeren "
    "wodurch das alles so ist.");
  AddDetail( ({"meer","meeres"}),
    "Das Meer ist von hier aus zu sehen und auch zu hoeren.");
  AddDetail( ({"boden"}),
    "Der Boden ist aus Sandgestein und knirscht unter Deinen Fuessen.");
  AddDetail( ({"sandgestein","gestein"}),
    "Aus Sandgestein wurde der Boden gefertigt. Leise knirscht es unter "
    "Deinen Fuessen. Du kannst durch den Boden hindurch sehen und es "
    "scheint als ob Du Dich selbst in einem Spiegel siehst.");
  AddDetail( ({"fuessen"}),
    "Durch das Sandgestein knirscht es leise unter Deinen Fuessen.");
  AddDetail( ({"spiegel"}),
    "Es scheint, als ob Du Dich im Boden, in einem Spiegel betrachtest. "
    "Seltsam, aber hier ist alles durchsichtig und Du denkst Dir das eine "
    "grosse unheimliche Macht seine Finger im Spiel hat.");
  AddDetail( ({"macht"}),
    "Eine unheimliche Macht hat diese Sandburg so veraendert das Du Dir kaum "
    "erklaeren kannst was hier passiert.");
  AddDetail( ({"finger"}),
    "Du hast zehn Finger aber hier hat eine andere Macht ihre Finger im Spiel.");
  AddDetail( ({"spiel"}),
    "Eine unheimliche Macht hat ihre Finger im Spiel und Du kannst Dir dies hier "
    "kaum erklaeren.");
  AddDetail( ({"burghof"}),
    "Wenn Du nach Westunten die Treppe herunter gehst kommst Du zurueck "
    "zu dem Burghof.");
  AddDetail( ({"treppe","nordunten"}),
    "Du kannst nach Nordunten die Treppe herunter gehen.");
  AddDetail( ({"wachweg","weg"}),
    "Du kannst in suedlicher und noerdlicher Richtung den Wachweg "
    "entlang gehen.");
  AddDetail( ({"sandburg","burg"}),
    "Du befindest Dich auf einem Erker der unheimlichen Sandburg.");
 AddDetail( ({"koerper"}),
    "Wenn Du der Armee der Untoten gewahr wirst, erzittert Dein ganzer Koerper.");
  AddDetail( ({"untote"}),
    "Wenn DU mehr ueber Untote erfahren moechtest, solltest Du einmal zu Xarfai gehen.");
  AddDetail( ({"xarfai"}),
    "Xarfai ist das Gildenoberhaupt der Nekromanten.");
  AddDetail( ({"gildenoberhaupt","oberhaupt"}),
    "Das Gildenoberhaupt der Nekromanten ist Xarfai.");
  AddDetail( ({"nekromanten"}),
    "Die Nekromanten wissen sehr genau was Untote sind.");
  AddDetail( ({"ohr"}),
    "Mit Deinem Ohr kannst Du hoeren. Versuch es mal.");
  AddDetail( ({"fea","fenda","hisie"}),
    "Diese Worte, Fea, Fenda , Hisie kannst Du nicht verstehen.");
  AddDetail( ({"mulash"}),
    "Mulash.....wer kann das sein? Versuch es herauszufinden.");
  AddDetail( ({"armee"}),
    "Die Armee der Untoten schwebt von Zeit zu Zeit durch die Burg und "
    "treibt ihr Unwesen.");
  AddDetail( ({"unwesen"}),
    "Die Armee der Untoten treibt hier ihr Unwesen.");
  AddDetail( ({"geraschel"}),
    "Wenn die Armee der Untoten ihr Unwesen treibt kann man Geraschel und "
    "Stimmen hoeren.");
  AddDetail( ({"stimmen"}),
    "Die Stimmen und das Geraschel sind eigendlich immer zu hoeren. Auch wenn "
    "die Armee der Untoten gerade nicht da ist.");
  AddDetail( ({"zeit"}),
    "Von Zeit zu Zeit treibt die Armee der Untoten ihr Unwesen in der Burg.");
  AddDetail( ({"worte"}),
    "Diese Worte sind Dir fremd und Du wirst sie niemals verstehen koennen.");
  AddDetail( ({"himmel"}),
    "Hier kannst Du den Himmel nur undeutlich erkennen, was unerklaerlich "
    "ist, da Du die Insel ja sehr gut erkennen kannst.");
  AddDetail( ({"tuerme","turm"}),
    "Du kannst nach Westen und nach Osten zu einem der vier "
    "Tuerme gelangen.");
  AddDetail( ({"richtung"}),
    "In westlicher und oestlicher Richtung, kannst Du den "
    "Wachweg entlang gehen.");




  AddRoomMessage( ({
      "Die Armee der Untoten erscheint und schwebt durch Dich hindurch.\n",
      "Dir wird schrecklich kalt und Du zitterst am ganzen Koerper.\n",
      "Du hoerst ueberall Geraschel und leise Stimmen.\n"
      "Du hoerst unbekannte Laute an Dein Ohr dringen.\n"
      "Hisie, Hisie fana Fenda.\n"
      "Dagrodi dacil Fea Mulash.\n"}),30,"func");
 
  AddSound( DEFAULT_SOUND,
    "Das Geraschel und die Stimmen die ab und an zu hoeren sind "
    "lassen Dich erzittern. Manchmal fluestern die Stimmen etwas "
    "in einer Dir unbekannten Sprache. Weit entfernt kannst Du leise "
    "das Meer hoeren.");
  AddSound( ({ "geraschel"}),
    "Wenn die Armee der Untoten erscheint vernimmst Du dieses Geraschel.");
  AddSound( ({ "stimmen"}),
    "Die Stimmen fluestern stetig in einer Dir fremden Sprache.");
  AddSound( ({ "sprache"}),
    "Du hoerst leise die Stimmen der Untoten in einer fremden Sprache.");
  AddSound( ({"laute"}),
    "Die Laute dringen ploetzlich an Dein Ohr. Verstehen kannst Du sie nicht");
  AddSound( ({"meer"}),
    "Du kannst das Meer leise hoeren und wuenschst Dich von hier fort.");
  
  AddSmell( DEFAULT_SMELL,
    "Du kannst hier schwach den Geruch des Meeres wahrnehmen.");
  AddSmell( ({ "geruch"}),
    "Du kannst schwach den Geruch des Meeres wahrnehmen.");

  



  AddItem(NPC "egladil", REFRESH_DESTRUCT);
    



  AddExit( "nordunten",  ROOM "weg3" );
  AddExit( "osten",  ROOM "wweg1" );
  AddExit( "westen",  ROOM "wweg3" );

// Ende Create
}
