#include "../def.h"

inherit "std/room";
#include <room/doors.h>
#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();



  SetProp( P_INT_SHORT, "Auf einem Burgweg" );
  SetProp( P_INT_LONG,
    "Du bist durch das Holztor gegangen und befindest Dich jetzt auf einem "
    "Weg. Er fuehrt nach Osten und endet in dem Burghof. Du bist sehr, "
    "erstaunt da Du bemerkst das die Sandburg ploetzlich nicht mehr klein ist. "
    "Sondern riesig und unheimlich ist. Es liegt viel Sand auf dem Boden und es "
    "knirscht unter Deinen Fuessen. Obwohl Du alles deutlich siehst, ist es "
    "verschwommen und irgendwie sieht es aus als ob alles von einem dunkelgrauen "
    "Nebel umgeben ist.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_TOWN]) );
 
  AddDetail( ({ "tor", "holztor"}),
    "Das Tor ist aus kleinen Holzstueckchen gefertigt und laesst sich mit "
    "dem Torgriff der aus einem Metallring besteht, sicher leicht oeffnen.");
  AddDetail( ({ "torgriff", "griff"}),
    "Der Torgriff besteht aus einem Metallring.");
  AddDetail( ({ "metallring", "ring"}),
    "Der Metallring ist ziemlich verrostet.");
  AddDetail( ({"boden"}),
    "Der Boden ist durchsichtig und man kann etwas verschwommen einen Raum "
    "darunter erkennen. Leider kannst Du Dir aber nicht erklaeren was dort "
    "sein koennte.");
  AddDetail( ({"raum"}),
    "Unter Dir scheint ein Raum zu sein. Aber Du kannst nicht deutlich "
    "erkennen was dort ist.");
  AddDetail( ({"holzstueckchen","stueckchen"}),
    "Das Tor ist aus Holzstueckchen gemacht, aber auch hier sieht es durchsichtig aus. "
    "Du siehst Serian auf der anderen Seite, zwar nur undeutlich und wie durch einen "
    "Nebel. Aber Du weist ja auch was dort ist. Daher kannst Du ihn besser erkennen.");
  AddDetail( ({"holzlatten","latten"}),
    "Die Holzstueckchen kann man eher als Holzlatten bezeichnen.");
  AddDetail( ({"worte"}),
    "Worte kann man lesen und sie bestehen aus aneinander gereihten "
    "Buchstaben");
  AddDetail( ({"buchstaben"}),
    "Worte bestehen aus mehreren Buchstaben.");
  AddDetail( ({"zeit"}),
    "Von Zeit zu Zeit spuerst Du wie die Armee der Untoten "
    "durch Dich hindurch zieht und Du anfaengst zu Zittern.");
  AddDetail( ({"zittern"}),
    "Wenn Du die Armee der Untoten spuerst, wird es Dir kalt, und "
    "Du bekommst auch Angst. Dadurch faengst Du an zu Zittern.");
  AddDetail( ({"burg","sandburg"}),
    "Du stehst auf einem Weg der Burg. Er fuehrt von dem Holztor, "
    "nach Osten, zu dem Burghof dieser seltsamen Burg. Von aussen sieht sie "
    "so klein aus und hier bist Du in einer grossen Burg. Ueberall kann "
    "man hindurchsehen. Dir wird Angst und Bange.....................");
  AddDetail( ({"angst"}),
    "Deine Angst koennte berechtigt sein, aber schau Dich erst weiter um.");
  AddDetail( ({"bange"}),
    "Wenn einem Bange ist hat man Angst. Aber schau Dich erstmal weiter um.");
  AddDetail( ({"burghof"}),
    "Du kannst nach Osten gehen um zu dem Burghof zu gelangen.");
  AddDetail( ({"insel"}),
    "Durch das Holztor, die Burgmauer, sprich ringsumher kannst Du ausserhalb "
    "schemenhaft die Insel erkennen. ");
  AddDetail( ({"burgmauer"}),
    "Die Burgmauer, ist genauso durchsichtig wie alles andere hier auch.");
  AddDetail( ({"armee"}),
    "Die Armee der Untoten schwebt von Zeit zu Zeit durch die Burg und "
    "treibt ihr Unwesen.");
  AddDetail( ({"unwesen"}),
    "Die Armee der Untoten treibt hier ihr Unwesen.");
  AddDetail( ({"geraschel"}),
    "Wenn die Armee der Untoten ihr Unwesen treibt kann man Geraschel und "
    "Stimmen hoeren.");
  AddDetail( ({"stimmen"}),
    "Die Stimmen und das Geraschel sind eigendlich immer zu hoeren. Auch wenn "
    "die Armee der Untoten gerade nicht da ist.");
  AddDetail( ({"wand","waende"}),
    "Richtige Waende gibt es hier nicht. Nur das Holztor und die Burgmauer.");
  AddDetail( ({"himmel"}),
    "Unerklaerlicherweise kannst Du ihn hier nicht besonders gut erkennen.");
  AddDetail( ({"hilfe"}),
    "Mit Hilfe eines Riegels, kannst Du das Holztor oeffnen.");
  AddDetail( ({"seite"}),
    "Durch das Holztor kannst Du auf der anderen Seite, Serian erkennen.");
  AddDetail( ({"serian"}),
    "Serian passt auf der anderen Seite des Holztores auf. das niemand "
    "ungewollt in die Sandburg eintritt.");
  AddDetail( ({"riegels","riegel"}),
    "Mit Hilfe des Riegels kannst Du das Holztor im Westen oeffnen.");
  AddDetail( ({"sand"}),
    "Auf dem Boden liegt recht viel Sand. Aber auch der Sand ist durchsichtig.");
  AddDetail( ({"fuessen","fuesse","fuss"}),
    "Unter Deinen Fuessen knirscht der Sand. Man hoert es bei jedem Schritt.");
  AddDetail( ({"schritt","schritte","knirschen"}),
    "Bei jedem Deiner Schritte, hoerst Du den Sand unter Deinen Fuessen knirschen.");
  AddDetail( ({"weg","wege"}),
    "Der Weg fuehrt von dem Holztor aus nach Osten.");
  AddDetail( ({"nebel"}),
    "Es erscheint Dir so als ob ueberall Nebel waere, aber es ist die "
    "Durchsichtigkeit, die Dich das glauben laesst.");
  AddDetail( ({"durchsichtigkeit"}),
    "Da alles hier durch die Durchsichtigkeit getruebt ist, glaubst Du ueberall "
    "Nebel zu sehen.");
  AddDetail( ({"koerper"}),
    "Wenn Du der Armee der Untoten gewahr wirst, erzittert Dein ganzer Koerper.");
  AddDetail( ({"untote"}),
    "Wenn DU mehr ueber Untote erfahren moechtest, solltest Du einmal zu Xarfai gehen.");
  AddDetail( ({"xarfai"}),
    "Xarfai ist das Gildenoberhaupt der Nekromanten.");
  AddDetail( ({"gildenoberhaupt","oberhaupt"}),
    "Das Gildenoberhaupt der Nekromanten ist Xarfai.");
  AddDetail( ({"nekromanten"}),
    "Die Nekromanten wissen sehr genau was Untote sind.");
  AddDetail( ({"ohr"}),
    "Mit Deinem Ohr kannst Du hoeren. Versuch es mal.");
  AddDetail( ({"fea","fenda","hisie"}),
    "Diese Worte, Fea, Fenda , Hisie kannst Du nicht verstehen.");
  AddDetail( ({"mulash"}),
    "Mulash.....wer kann das sein? Versuch es herauszufinden.");
 
		  
  AddRoomMessage( ({"Die Armee der Untoten erscheint und schwebt durch Dich hindurch.\n",
      "Dir wird schrecklich kalt und Du zitterst am ganzen Koerper.\n",
      "Du hoerst ueberall Geraschel und leise Stimmen.\n"
      "Du hoerst unbekannte Laute an Dein Ohr dringen.\n"
      "Hisie, Hisie fana Fenda.\n"
      "Dagrodi dacil Fea Mulash.\n"}),30,"func");
 
  AddSound( DEFAULT_SOUND,
    "Das Geraschel und die Stimmen die ab und an zu hoeren sind "
    "lassen Dich erzittern. Manchmal fluestern die Stimmen etwas "
    "in einer Dir unbekannten Sprache. Ausserdem kannst Du ein "
    "Knirschen hoeren, es wird durch Deine Schritte erzeugt.");
  AddSound( ({ "geraschel"}),
    "Wenn die Armee der Untoten erscheint vernimmst Du dieses Geraschel.");
  AddSound( ({ "stimmen"}),
    "Die Stimmen fluestern stetig in einer Dir fremden Sprache.");
  AddSound( ({ "sprache"}),
    "Du hoerst leise die Stimmen der Untoten in einer fremden Sprache.");
  AddSound( ({"laute"}),
    "Die Laute dringen ploetzlich an Dein Ohr. Verstehen kannst Du sie nicht");
  AddSound( ({"knirschen","schritte"}),
    "Du hoerst das Knirschen, welches bei jedem Deiner Schritte auf dem Sand "
    "erzeugt wird.");
  AddSmell( DEFAULT_SMELL,
    "Du kannst hier absolut nichts riechen. Ausser eventuell Deine "
    "eigenen Gerueche.");
  AddSmell( ({ "gerueche"}),
    "Das sind Deine eigenen Gerueche. Hier kannst Du ansonsten garnichts riechen.");
     
//AddCmd( ({"ziehe","zieh","ziehen" }), "ziehen" ); 

//AddExit( "sueden",  ROOM "halle" );
  AddExit( "osten",   ROOM "weg1" );
//AddExit( "norden",  ROOM "laden" );
//AddExit( "suedwesten",  ROOM "repahaus" );
//  AddExit( "nordosten",  ROOM "biblio" );   
    
//    AddItem( NPC "mirasa", REFRESH_DESTRUCT);
//  AddItem(NPC "", REFRESH_DESTRUCT);
    

 // Ende Create
 NewDoor( "westen", ROOM "burg1", ({"tor", "holztor" }),
       ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
        D_NAME, "Holztor",
        D_GENDER, FEMALE,
        D_SHORT, "Im Westen befindet sich ein %ses Holztor. ",
        D_LONG, "Ein aus kleinen Holzlatten gemachtes Tor. "
                "Man kann es mit Hilfe eines Riegels oeffnen "
		"und auch wieder schliessen. ",
        D_MSGS, ({ "hinaus", "geht wieder", "kommt herein" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und das Tor oeffnet sich. ",
                      "Mit lautem Knarren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),           
	D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen." }) );

 


  
     }

