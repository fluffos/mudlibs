  SetProp( P_INT_LONG,
    "Deine Schritte fuehren Dich in den Thronsaal. Das Schimmern, das "
    "schon ausserhalb Deine Aufmerksamkeit immer wieder auf sich gezogen "
    "hat ist hier nicht verebbt. Ein Seitenblick, der Klarheit ueber den "
    "Raum schaffen soll laesst Dich aufschrecken. Durch die Wand hindurch "
    "erfasst Du problemlos den Innenhof der Burg. Wie im Traum kannst Du "
    "einen Brunnen erkennen. Menschen, Elfen, Feen, Oger und auch Trolle "
    "gehen dort ihres Weges.");
  SetProp( P_LIGHT, -1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_HOUSE]) );
 
  AddDetail( ({ "schritte"}),
    "Deine Schritte hoert man als ob Du ueber festen Marmorboden gehen "
    "wuerdest. Dennoch scheinst Du zu schweben.");
  AddDetail( ({ "marmorboden","boden"}),
    "Der Marmorboden auf dem Du gerade stehst, gibt Geraeusche wieder "
    "wenn Du darueber laeufst, obwohl Du zu schweben scheinst.");
  AddDetail( ({ "geraeusche", "geraeusch"}),
    "Da solltest Du mal lauschen.");
  AddDetail( ({"thronsaal","saal"}),
    "Der Thronsaal ist geheimnisvoll und alles schimmert seltsam. "
    "Von der Decke haengt ein Kronleuchter aus purem Gold. Ein "
    "grosser Thron steht vor einer Wand. Hinter ihm ist ein Kamin "
