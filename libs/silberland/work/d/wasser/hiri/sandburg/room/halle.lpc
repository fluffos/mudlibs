  AddDetail( ({"halterungen"}),
    "In den Halterungen sind genau zwoelf Kerzen gesteckt.");
  AddDetail( ({"kerzen","kerze"}),
    "Die zwoelf gueldenen Kerzen stecken in den dafuer "
