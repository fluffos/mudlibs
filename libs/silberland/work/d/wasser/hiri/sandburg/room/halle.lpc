#include "../def.h"

inherit "std/room";

#include <defines.h>
#include <properties.h>
#include <moving.h>

#define AN 1
#define AUS 0


int goldklumpen_vorhanden;

int diamant_vorhanden;

int feuer;

int mulashda;

object resetmulash;

void create()
{
 ::create();

 feuer = AN;
 
 mulashda=1;

 diamant_vorhanden = random(3);

 goldklumpen_vorhanden = random(3);

 
 
