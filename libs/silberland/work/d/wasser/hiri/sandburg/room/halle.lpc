  AddDetail( ({"region","regionen"}),
    "Folgende Regionen gibt es im Silberland: "
    "Ebene, Gebirge, Seher, Unterwelt, " 
    "Dschungel, Huegelland, Kristallwald, "
    "Wasser, Wueste, Polar, PK, Event, "
    "Wahnsinn.");
  AddDetail( ({"Ebene", "Gebirge", "Seher", "Unterwelt", "Dschungel",
