    "laufen sehen.");
  AddDetail( ({"rassen","rasse"}),
    "In der hiesigen Bibliothek kannst Du mehr ueber die Rassen im "
    "Silberland erfahren.");
  AddDetail( ({"bibliothek"}),
    "Die Bibliothek kannst Du von dem Burghof aus erreichen.");
  AddDetail( ({"kamin","kamin's"}),
    "Der Kamin ist hinter dem grossen Thron in die Wand gebaut worden. "
    "Er hat eine Umrandung aus schwarzem Marmor. Eine Feuerstelle im "
    "Kamin weckt Dein Interesse.");
  AddDetail( ({"feuerstelle","stelle"}),
    "Die Feuerstelle ist seltsam, sie verstroehmt keine Hitze. Ob man das "
    "Feuer entzuenden und loeschen kann?.");
  AddDetail( ({"hitze"}),
    "Trotz des Kamin's kann man hier nicht von grosser Hitze sprechen.");
  AddDetail( ({"klarheit"}),
    "Der Seitenblick von Dir verschafft Dir erschreckende Klarheit.");
  AddDetail( ({"seitenblick","blick"}),
    "Du dachtest durch diesen Seitenblick, Klarheit ueber diesen Raum "
    "zu erhalten. Stattdessen, erkennst Du, dass Du durch die Waende "
    "nach draussen schauen kannst.");
  AddDetail( ({"raum"}),
    "Dieser Raum ist ein Thronsaal, wie Du sicher bemerkt hast. Fuer wen "
    "er wohl dienlich ist?");
  AddDetail( ({"schimmern"}),
    "Dieses seltsame Schimmern was Dir ausserhalb schon aufgefallen ist, "
    "ist hier nicht verebbt und Du bist sehr verwundert, da Du es Dir "
    "nicht erklaeren kannst.");
  AddDetail( ({"traum","traeume"}),
    "Du kommst Dir vor wie in einem Traum. Aber hier koennte es schlimmer "
    "sein, wie in einem Deiner schlimmsten Traeume.");
  AddDetail( ({"interesse"}),
    "Die Feuerstelle im Kamin erweckt Dein Interesse.");
  AddDetail( ({"marmor"}),
    "Der Kamin hat eine Umrandung aus schwarzem Marmor.");
  AddDetail( ({"umrandung"}),
    "Die Umrandung des Kamin's ist aus schwarzem Marmor und man kann auf "
    "ihr, auch einiges abstellen. Es stehen auf dem kleinen Sims, ueber dem "
    "Kamin, mehrere Dinge.");
  AddDetail( ({"weges"}),
    "Die verschiedensten Rassen gehen ausserhalb ihres Weges.");
  AddDetail( ({"waende","wand"}),
    "An den Waenden stehen mehrere Schraenke und Glasvitrienen.");
  AddDetail( ({"schraenke","schrank"}),
    "Die Schraenke sind aus schwarzem Holz. Oeffnen kann man sie nicht, "
    "da sie abgeschlossen sind.");
  AddDetail( ({"holz"}),
    "Die Schraenke und die Glasvitrienen sind aus schwarzem Holz.");
  AddDetail( ({"glasvitrienen","vitrienen","vitriene"}),
    "Die Glasvitrienen sind aus schwarzem Holz und man kann durch ihre "
    "Scheiben nichts erkennen. Ausserdem sind sie auch abgeschlossen.");
  AddDetail( ({"scheiben","scheibe"}),
    "Die Scheiben in den Glasvitrienen lassen Dich nicht erkennen was "
    "darinne ist.");
  AddDetail( ({"sims"}),
    "Ueber dem Sims des Kamin's, stehen einige kleine, goldenen Vasen.");
  AddDetail( ({"vasen"}),
    "Die Vasen sind golden und eine Vase faellt Dir besonders auf.");
  AddDetail( ({"vase"}),
    "Du schaust Dir die Vase an und beruehrst sie kurz, sie wackelt etwas "
    "und Du hoerst ein klirren darin. Vielleicht solltest Du sie mal herum "
    "drehen?");
  AddDetail( ({"goldplaettchen","plaettchen"}),
    "An dem Thron sind lauter Goldplaettchen befestigt. Waere hier mehr Licht "
    "saehe es sicher hervorragend aus.");
  AddDetail( ({"fall"}),
    "In diesem Fall muesste das Feuer an sein. Um die Geraeusche zu hoeren.");
  AddDetail( ({"verwesung"}),
    "Du kannst den Geruch der Verwesung sicher besser mit Deiner "
    "Nase ausmachen.");
  AddDetail( ({"geruch","gerueche"}),
    "Geruch sollte man mit der Nase erriechen, meinst Du nicht?");
  AddDetail( ({"geraeusche"}),
    "Lausch mal mit Deinen Ohren nach den Geraeuschen.");
  AddDetail( ({"ohren","ohr"}),
    "Damit kannst Du hoeren oder lauschen.");
  AddDetail( ({"waerme","warm"}),
    "Geister moegen die Waerme nicht besonders, deshalb wirst Du hier kaum "
    "waerme spueren koennen.");
  
  AddSound( DEFAULT_SOUND,
    "Du kannst Deine Schritte hoeren und einige andere Geraeusche,"
    "die Dich manchesmal beunruhigen.");

  AddSound( ({ "geraeusche" }),
    "Die Geraeusche die Du hier hoerst, kommen von dem Marmorboden, "
    "wenn Du darueber laeufst. Auch kannst Du wenn das Feuer an ist, "
    "ein leises Brasseln hoeren.");
  AddSound( ({ "brasseln" }),
    "Das Brasseln kommt aus dem Kamin. Gesetzt den Fall das Feuer "
    "ist gerade an.");  
  AddSound( ({"schritte"}),
    "Du kannst Deine Schritte auf dem Marmorboden hoeren, obwohl Du "
    "zu schweben scheinst.");
  
 AddSmell( DEFAULT_SMELL,
    "Du riechst nicht besonders viel. Aber ein Geruch nach Verwesung "
    "liegt in der Luft.");

  AddSmell( ({ "luft" }),
    "Ein Geruch der Verwesung liegt in der Luft und beisst Dir "
    "regelrecht in die Nase.");
  AddSmell( ({ "nase"}),
    "Mit Deiner Nase erfasst Du die Gerueche.");
  AddSmell( ({ "verwesung"}),
    "Du kannst einen ekligen Geruch der Verwesung wahrnehmen.");
  AddSmell( ({"geruch","gerueche"}),
    "Mit Deiner Nase kannst Du die Gerueche wahrnehmen.");
    
  

  
  
  
  
  AddSpecialDetail( ({"feuer","kaminfeuer"}), "detail_feuer");
  AddSpecialDetail( ({ "gestalt"}),"detailGestalt" );
  



  AddCmd( ({"beruehre", "beruehren"})  , "cmd_beruehren"); 
  AddCmd( ({"loesche","loesch"})      , "cmd_loeschen");
  AddCmd( ({"zuend","zuende"})        , "cmd_zuenden");
  AddCmd( ({"zerre","zerr"})        , "cmd_zerren");
  AddCmd( ({"dreh","drehe"})        , "cmd_drehen");
  

  
//  AddItem(NPC "eidechse", REFRESH_DESTRUCT);
    

  AddExit( "sueden",  ROOM "burghof" );
 // Ende Create
}

string detail_feuer(string str)
{
  string s;

  if(feuer == AN)
  {
    s = "Die Flammen lodern und es brasselt im Kamin. "
        "Nur, das es statt waermer zu werden noch kaelter "
	"geworden ist????? Geister moegen keine Waerme!";
  }
  else
  {
    s = "Das Kaminfeuer glueht in einem dunkelrot. ";
  }

 return BS(s);
}

int cmd_loeschen(string str)
{
  notify_fail("Was moechtest Du denn loeschen?\n"); 

  if(!str || str == "") return 0; 

  if(!(str == "feuer"           ||            
       str == "kaminfeuer"       
           )) return 0; 

 if(feuer == AUS)
  {
    tell_object(TP,"Das Feuer ist doch aus! Was machst Du da wieder?\n");
    
    return -1; 
  }
 
 tell_object(TP,BS("Du versuchst das Feuer mit Deinen Fuessen auszutreten. "
	        "Es gelingt Dir auch, aber ploetzlich, sind Deine Fuesse "
	        "eiskalt."));
                TP->AddHp(-20);
		
TO->Message(BS(TP->Name()+" versucht mit den Fuessen das Feuer zu loeschen."
              ), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

feuer = AUS;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

return 1; 
}

int cmd_zuenden(string str)
{


  notify_fail("Was genau moechtest Du anzuenden?\n");

  if(!str || str == "") return 0;
  if(!(str == "feuer"         ||
       str == "kaminfeuer"    ||
       str == "feuer an"      ||
       str == "kaminfeuer an" ||     
       str == "entzuende feuer" ||
       str == "entzuende kaminfeuer"  
      )) return 0;

  
 if(feuer == AN)
  {
    tell_object(TP,"Das Feuer brennt. Das war nicht mehr noetig!\n");

    return -1; 
  }

 tell_object(TP,BS("Du holst tief Luft und pustest in die Feuerstelle. "
		"Das Feuer entzuendet sich. Aber es wird nicht waermer. "
		"Es scheint ein kaltes Feuer zu sein. Denn die Temperatur "
		"sinkt. "));

  TO->Message(BS(TP->Name()+" holt tief Luft um das Feuer anzuzuenden. "
                              ), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

 feuer = AN;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 2, ENV_TERRAIN: TT_HOUSE]) );

  return 1;
}


 
string detailGestalt()
{
  if (!present("HIRIGEIST",TO))
    return(BS("Diese Gestalt scheint ein maechtiges Wesen zu sein. "
	   "Deine Neugierde treibt Dich dazu, sie beruehren "
	   "zu wollen.\n"));
  return("Du musst Dich wohl getaeuscht haben, hier ist keine Gestalt "
	 "die Du beruehren koenntest.\n");
}
void reset()
{
  ::reset();
  mulashda=1;
  resetmulash=present("HIRIGEIST",TO); 
  diamant_vorhanden = random(3);
  goldklumpen_vorhanden = random(3);
}

int cmd_beruehren(string str)
{
  object mulash;
  notify_fail ("Was moechtest Du beruehren?\n");

  if(!str || str == "") return 0;
  
  if(!(str == "gestalt"  )) return 0;
  if (present("HIRIGEIST",TO) || !mulashda)

  {
    write(BS("Du kannst gerade nichts erkennen."));
    return -1;
  }
  write(BS("Du beruehrst die Gestalt und voellig unerwartet hebt "
	   "sie sich aus dem Thron ab und sitzt nun darauf. "
           "Du erschauerst bei dem Anblick und wuenschst Deine "
	   "Neugier besser kontrollieren zu koennen.\n"));
  mulashda=0;
  mulash = clone_object ("/d/wasser/hiri/sandburg/npc/ghostking.lpc" );
  mulash->move(TO,M_GO|M_NOCHECK,"schwebt");
  return 1;
}

int cmd_zerren(string str)
{
  object diamant;

  notify_fail("An was moechtest Du zerren?\n");
  
  if ( !diamant_vorhanden )
  {
    write( BS(
      "Es ist kein Diamant mehr da, den Du aus dem Thron heraus zerren "
      "koenntest.") );
    return -1;
  }
  if ( member( ({ "diamant", "an diamant", "an dem diamant"}),str) != -1)
  {
    diamant = clone_object("/obj/gems/diamant");
    diamant_vorhanden = 0;
    if ( ME_TOO_HEAVY==diamant->move(TP,M_GET|M_SILENT) )
    {
      write(BS(
        "Du schaust Dich verlegen um und zerrst schnell den "
	"Diamant aus dem Thron.\n") );
      diamant->move(TO,M_NOCHECK);
      return 1;
    }
    write( BS(
      "Du hast den Diamant unerlaubt aus dem Thron gezerrt und hoffst "
      "das es niemand gesehen hat.") );
    say(
      TPN+" zerrt am Thron herum und steckt heimlich Etwas ein.\n");
    return 1;
  }
} 

int cmd_drehen(string str)
{
  object goldklumpen;

  notify_fail("Was moechtest Du umdrehen?\n");
  
  if ( !goldklumpen_vorhanden )
  {
    write( 
      "Es ist nichts in der Vase. Was Du wieder gehoert hast!\n" );
    return -1;
  }
  if ( member( ({ "vase", "vase herum", "vase um"}),str) != -1)
  {
    goldklumpen = clone_object("/p/std/skills/jewelry/obj/gold");
    goldklumpen_vorhanden = 0;
    if ( ME_TOO_HEAVY==goldklumpen->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Du drehst die Vase um und findest einen kuehlen Gegenstand.\n" );
      goldklumpen->move(TO,M_NOCHECK);
      return 1;
    }
    write(BS(
      "Dir rollt Etwas in die Hand und Du steckst den kuehlen Gegenstand "
      "schnell ein.") );
    say(
      TPN+" dreht die Vase herum und steckt Etwas weg.\n");
    return 1;
  }
 }



