  AddDetail( ({"mud","user","dungeons"}),
    "Multi-User-Dungeons.");
  AddDetail( ({"gefahren"}),
    "Toedliche Gefahren, hat das Mud fuer alle Spieler.");
  AddDetail( ({"spieler"}),
    "Bist Du kein Spieler???");
  AddDetail( ({"gebiete"}),
    "Gebiete oder auch Regionen genannt. Du bist gerade in "
