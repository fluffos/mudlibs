  AddDrink("Hoellenfeuer", ({"hoellenfeuer","hoelle","feuer"}),
	   666, 3, 13, 12,
           ({"Fea Ehtele bringt Dir ein Glas brennendes etwas.\n"
	       +BS("Dir wird heiss und Du glaubst zu verbrennen. Du schwitzt "
