string _query_int_long()
{
  string txt;
  
  txt = "Das hier ist wirklich eine UnSichtBar. Du erkennst Sandbaenke, aber "
    "keine Tische und keine Theke, obwohl sich darauf Glaeser, Kerzen und "
    "Menuekarten befinden. Es ist so, als wuerden sie in der Luft schweben. "
    "Der runde Raum besteht aus Sand und ist mit Spinnweben verhangen. Die "
    "suedwestliche Wand scheint durchsichtig zu sein und zeigt einen "
    "Ausblick auf das Meer bei Nacht.";
  
  if(QueryProp(P_PUBKEEPER_ID))
    {
      if(!present(QueryProp(P_PUBKEEPER_ID)))
	{
	  txt += "Im Moment scheint die Wirtin abwesend zu sein.";
	}
      else
	{
	  txt += " Die Wirtin empfaengt Dich freudestrahlend.";
	}
    }
  
  return BS(txt);
}

int cmd_wischen(string str)     
{
  
  notify_fail("Was willst Du womit wischen?\n");
  
  if(!(str=="theke mit wischtuch"||
       str=="theke mit tuch"||
       str=="tisch mit tuch"||
       str=="tisch mit wischtuch"||
       str=="theke mit wischtuch ab"||
       str=="theke mit tuch ab"||
       str=="tisch mit tuch ab"||
       str=="tisch mit wischtuch ab")) 
    
    return 0;
  
  {
    write(BS("Du schnappst Dir dieses Wischtuch und wischt in der Luft "
	     "horizontal herum. Das Wasser tropft herunter. Huch! Da befand "
	     "sich doch keine Wischflaeche. Verstohlen schupfst Du das Tuch "
	     "zurueck auf die Theke."));
    say(BS(TPN+" wischt mit einem Tuch in der Luft. Das sieht doch ziemlich "
	   "lustig aus, als wuerde "+TPN+" ein Trockenschwimmtraining "
	   "absolvieren."));
  }
  return 1;
}

int cmd_schlecken(string str)     
{
  
  notify_fail("Woran willst Du entlang schlecken?\n");
  
  if(!(str=="an wand"||
       str=="an wand entlang"||
       str=="wand"||
       str=="die wand"||
       str=="an der wand entlang")) 
    
    return 0;
  
  {
    write(BS("Du schleckst voller Neugier an der transparenten Ausblickswand "
	     "entlang. Igitt!!! Das ist kein Glas und eindeutig Sand. Du spuckst "
	     "und spuckst. Das Knirschen des Sandes bleibt. Manchmal wird auch "
	     "Neugierde bestraft."));
    say(BS(TPN+" schleckt an der Aussichtswand entlang und scheint den "
	   "geschluckten Sand auszuspucken."));
  }
  return 1;
}

int cmd_spinnweben(string str)     
{
  
  notify_fail("Die Decke ist zuweit oben, als dass Du rankommst.\n");
}
void reset()
{                                                                                           
  ::reset();
  ueberraschungszahl=1;
}

string detailueberraschung()
{ 
  object ueei;
  if(ueberraschungszahl<1)
    {
      write("Ein Zauberer erscheint in einer Rauchwolke vor Dir. Er zaubert "
	    "aus seinem\nZylinder ein Haeschen, das flink davon hoppelt. \n"
	    "Schon verpufft der Zauberer wieder und ist verschwunden.\n"
	    "das Haeschen auch.\n");
      say(sprintf("%s wuenscht sich eine Ueberraschung.\n"
		  "Ein Zauberer erscheint in einer Rauchwolke vor Dir. Er zaubert "
		  "aus seinem\nZylinder ein Haeschen, das flink davon hoppelt. \n"
		  "Schon verpufft der Zauberer wieder und ist verschwunden.\n"
		  "das Haeschen auch.\n", TP->Name(WER)));
      return "";
    }
  if(deep_present("\nHICKSEI",TP))
    {
      return("Du hast ja schon eine Ueberraschung.\n");
    }
  else
    {
      ueei=clone_object(OBJ"ueei"); 
      if (ueei->move(TP,M_GET)==ME_TOO_HEAVY) 
	
	{
          write("Die Ueberraschung wuerde Dir zu schwer werden.\n");
          say(BS(sprintf("%s wuenscht sich was, aber scheint kraftlos zu sein.\n", TP->Name(WER))));
          ueei -> remove();
          return "";
	}
      else
	{
	  
	  write("Ein Zauberer erscheint ploetzlich in einer Rauchwolke vor Dir.\n"
		"Er zieht seinen Zylinder aus und zueckt seinen Zauberstab.\n");
	  say(sprintf("Ein Zauberer erscheint ploetzlich in einer Rauchwolke vor "+TPN+".\n"
		      "Er zieht seinen Zylinder aus und zueckt seinen Zauberstab.\n", TP->Name(WER)));
	  TP->SetProp(P_PARALYZED,([
				   PARALYZE_TIME: 14,
				   PARALYZE_MSG: "Dir steht Dein Unterkiefer offen und "
				                 "Du folgst gebannt dem Zauberer.\n",
				   PARALYZE_END: "Du atmest tief ein und bist beeindruckt.\n"]));
	  call_out("fall1",7,TP);
	  ueberraschungszahl--;
	  return "";
	}
    }
   
  
  return "";
}

void fall1(object pl)
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS("Er schwingt mit seinem Zauberstab hin und her und ruft: SIMSALABIM!"));
  say(BS("Der Zauberer schwingt mit seinem Zauberstab hin und her und ruft: SIMSALABIM!"));
  call_out("fall2",6,pl);
}
void fall2(object pl)
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS("Der Zauberer klopft auf seinen Zylinder und zieht ein "
	   "Ueberraschungsei heraus, das er Dir freudestrahlend ueberreicht."));
  say(BS("Der Zauberer klopft auf seinen Zylinder und zieht ein "
	 "Ueberraschungsei heraus, das er "+TPN+" freudestrahlend ueberreicht."));
  call_out("fall3",7,pl);
}
void fall3(object pl)
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS("Waehrend Du Dich, ueber Dein Ueberraschungsei freust, "
	   "verschwindet der Zauberer mit einem Knall und ist verschwunden."));
  say(BS("Der Zauberer verschwindet mit einem Knall im Nichts."));
  
  TP->SetProp(P_PARALYZED, 0);
}

int cmd_sitzen(string str)
     
{
  notify_fail(BS("Worauf willst Du Dich setzen?"));
  if(!(str == "auf sandbank"||
       str == "auf bank"||
       str == "nieder"||
       str == "hin"))
    {
      return 0;
    }
  if(SANDBANK(TP))
    {
      write(BS("Du sitzt doch schon auf der Sandbank!"));
      return 1;
    }
  if(sizeof(sandbank)>=2)
    {
      write(BS("Es ist kein Platz mehr auf der Sandbank."));
      return 1;
    }
  write(BS("Du setzt Dich auf die Sandbank. Vielleicht moechtest Du jetzt "
	   "etwas bestellen?"));
  tell_room(ENV(TP), TPN+" setzt sich auf eine Sandbank.\n", ({TP}));
  sandbank += ({ capitalize(getuid(TP)) });
  return 1;
}

int cmd_richtung(string str)
{
  if(SANDBANK(TP))
    {
      write(BS("Du solltest vorher aufstehen."));
      return 1;
    }
}

int cmd_aufstehen(string str)
{
  notify_fail(BS("Du willst AUFstehen?\n"));
  if(str == "auf")
    {
      if(SANDBANK(TP))
	{
	  write(BS("Du ueberlegst, ob Du nicht doch noch etwas bestellen moechtest, "
		   "aber Du stehst lieber auf. Schliesslich hast Du noch etwas zu tun."));
	  tell_room(ENV(TP), TPN+" erhebt sich von der Sandbank.\n", ({TP}));
	  sandbank -= ({ capitalize(getuid(TP)) });
	  return 1;
	}
    }      
  return 0;
}

void BecomesNetDead(object spieler)
{
  if(SANDBANK(spieler))
    sandbank -= ({ capitalize(getuid(spieler)) });
  
}

string sandbank()
{
  string sandbankinfo;
  if(SANDBANK(TP))
    {
      sandbankinfo =
	"Du sitzt auf einer Sandbank. "+
	"Ja, die Poelsterchen versprechen ihre Bequemlichkeit. "
	"Wirklich gemuetlich fuer schoene Stunden.";
    }
  else
    {
      sandbankinfo =
	"Sie wirken sehr bequem und einladend. Selbst die Poelsterchen "
	"auf den Baenken wirken flauschig weich. Hie und da ueberziehen "
	"Spinnweben die Baenke.";
      if(sizeof(sandbank)==1 )
	sandbankinfo += " Du siehst gerade " + sandbank[0] + " auf der "
	  "Sandbank sitzen.";
      
      if(sizeof(sandbank)>1 )
	sandbankinfo += " Im Moment sitzen " + MyCountUp(sandbank) + " auf der "
	  "Sandbank beisammen.";
    }
  return break_string(sandbankinfo, 78);
}

string poelsterchen()
{
  string poelstercheninfo;
  if(SANDBANK(TP))
    {
      poelstercheninfo =
	"Du kuschelst Dich mit Deinem Popo in das kuschelig weiche "
	"Poelsterchen hinein.";
    }
  else
    {
      poelstercheninfo =
	"Am liebsten wuerdest Du Dich auf die Sandbank setzen wollen.";
    }
  return break_string(poelstercheninfo, 78);
}
