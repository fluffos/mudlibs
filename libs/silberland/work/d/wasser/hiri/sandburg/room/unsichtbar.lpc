//Hicks - 26.5.2004

inherit "std/pub";

#include "../def.h"
#include <pub.h>

#define SANDBANK(wer) (member(sandbank, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )

string *sandbank=({});
string *poelsterchen=({});


int ueberraschungszahl=1;

void create()
{
  ::create();
  
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In der 'UnSichtBar'");
  
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "ehtele");
  SetProp(P_PUBKEEPER_NAME, "Fea Ehtele");
  SetProp(P_PUBMSG_NOKEEPER, "Fea Ehtele ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS("Sie wird Dich nicht bedienen, weil Du sie "
			       "gerade attackierst."));
  SetProp(P_PUBMSG_NOINVITE, BS("Fea Ehtele bemerkt Dich nicht."));
  SetProp(P_PUBMSG_FIGHTING, "Fea Ehtele kaempft gerade.\n");
  
  

  AddFood("Trockener Lebkuchen", ({"trockener lebkuchen","lebkuchen","kuchen"}),
          34,30,10,
           ({"Fea Ehtele bringt Dir laechelnd ein grosses Lebkuchenherz. "
	      +BS("Du beisst voller Freude von dem Herzen... und brichst Dir "
	      "fast alle Zaehne aus. OH MANN, IST DAS HART!!!"),
	      "&& kaut auf einem staubtrockenen Lebkuchenherz herum und flucht.\n"}));

  AddFood("Radieschen-Cocktail", ({"radieschencocktail","radieschen-cocktail",
	  "radieschen","cocktail"}),
          51,10,4,
           ({"Ehtele serviert Dir einen Radieschen-Cocktail mit Essig und Oel.\n"
	      +BS("Du probierst den Cocktail, der vorzueglich schmeckt."),
	      "&& verspeist einen Radieschen-Cocktail.\n"}));

  AddFood("Sandpudding", ({"sandpudding","sand","pudding"}),
          79,14,6,
           ({"Ehtele bringt dir einen Sandpudding als kleines Desert. "
	      +BS("Du knirschst und krachst beim Kauen. Du spuckst nur noch Sand..."),
	      "&& knirscht und kracht beim Sandpudding essen.\n"}));
  
  AddFood("Eiskaltes Haendchen", ({"eiskaltes haendchen","haendchen"}),
          188,19,6,
           ({"Fea Ehtele bringt Dir eine eiskalte Hand, die huebsch auf einem\n"
	     "Teller garniert wurde. Die Hand bewegt sich.\n"
	      +BS("Du genierst Dich nicht und beisst skrupellos in einen Finger. "
	       "Die Hand schreit vor Schmerzen als Du sie verspeist."),
	      "&& knabbert auf einem eiskalten Haendchen, welches vor\n"
	      "Schmerzen schreit.\n"}));
  
  AddFood("Herzschrittmacher", ({"herzschrittmacher","schrittmacher","herz"}),
           369,30,10,
           ({"Ehtele kommt mit einem Operationsbesteck und einem Herzschrittmacher.\n"
	      +BS("Sie schneidet Dir die Brust auf und pflanzt Dir den Schrittmacher ein. "
	      "Du fuehlst richtig, wie Du neue Kraft erhaelst."),
	      "&& wird von Ethele ein neuer Herzschrittmacher eingepflanzt.\n"}));
  
  AddDrink("Lebenswasser", ({"lebenswasser","leben","wasser"}),
	   19, 10, 0, 3,
           ({"Die Wirtin bringt Dir ein Glas kristallklares Lebenswasser.\n"
	       +BS("Du leerst das Glas in einem Zug und fuehlst Dich "
	       "sichtlich erfrischt."),
	       "&& bestellt ein Glas Lebenswasser und trinkt es leer.\n"}));

  AddDrink("Totenumtrunk", ({"totenumtrunk","umtrunk","trunk"}),
	   69, 12, 0, 4,
           ({"Ehtele serviert Dir ein Glas mit schwimmenden Geistern.\n"
	       +BS("Dir ekelt es, aber Du trinkst es tapfer mit geschlossenen Augen. "
	       "Dir gruselt es."),
	       "&& scheint einen Totenumtrunk nicht wirklich zu geniessen.\n"}));
  
  AddDrink("Schlummertrank", ({"schlummertrank","schlummer","trank"}),
	   99, 2, 4, 5,
           ({"Fea Ehtele haelt Dir ein dunkel, brodelndes Gebraeu unter die Nase.\n"
	       +BS("Du haelst Dir die Nase zu und kippst es hinunter. "
