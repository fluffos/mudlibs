#include "../def.h"

inherit "std/room";
#include <room/doors.h>
#include <defines.h>
#include <properties.h>
#include <moving.h>



void create()
{
 ::create();
 


  SetProp( P_INT_SHORT, "In einem Burghof" );
  SetProp( P_INT_LONG,
    "Du bist ueber die Wege von dem Holztor gegangen und ploetzlich findest "
    "Du Dich in einem Burghof wieder. Du staunst nicht schlecht als Du "
    "feststellst das Du auf einmal in einer sehr grossen Burg bist. Wie kann "
    "das nur sein? Hier im Burghof siehst Du einen Brunnen und auf dem Boden "
    "liegt ziemlich viel Sand. Obwohl Du alles deutlich siehst, ist es "
    "verschwommen und irgendwie sieht es aus als ob alles von einem "
    "dunkelgrauen Nebel umgeben ist. Nach Nordosten kannst Du einen Laden "
    "betreten und nach Norden scheint es in eine Halle zu gehen. Nach "
    "Sueden fuehrt ein Weg zu einer Treppe und im Nordwesten steht ein kleines "
    "Haus. Ein Schild ist daran angebracht. Im Suedosten kannst "
    "Du ein Gebaeude mit einem Rundschild erkennen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_TOWN]) );
 
  
  AddDetail( ({"boden"}),
    "Der Boden ist durchsichtig und man kann etwas verschwommen einen Raum "
    "darunter erkennen. Irgendetwas laeuft dort unten umher. Dein Interesse "
    "ist geweckt und Du moechtest wissen was dort ist.");
  AddDetail( ({"interesse"}),
    "Dein Interesse ist scheinbar geweckt. Wenn Du weiter forschst, kommst "
    "Du sicher darauf, wie man in diesen Raum unter Dir gelangt.");
  AddDetail( ({"raum"}),
    "Den Raum unter Dir kannst Du nur wage erkennen, aber Dir faellt auf dem "
    "Boden ein Eisenring auf.");
  AddDetail( ({"eisenring", "ring"}),
    "Ein verrosteter Eisenring ist in den Boden gearbeitet, auch er ist durchsichtig. "
    "Aber Du koenntest ja einmal daran ziehen.");
  AddDetail( ({"brunnen"}),
    "Brunnen kann man dieses zerfallene Gebilde wohl kaum noch nennen. Die Vorrichtung "
    "liegt auf dem Boden und ebenfalls ein abgerissenes Seil. Ein heraus gebrochener "
    "Stein faellt Dir auf.");
  AddDetail( ({"gebilde"}),
    "Dieses Gebilde war vor langer Zeit ein Brunnen.");
  AddDetail( ({"vorrichtung"}),
    "Auf dem Boden liegt eine zerbrochene Vorrichtung, man konnte damit in frueheren "
    "Zeiten, Wasser aus dem Brunnen holen.");
  AddDetail( ({"seil"}),
    "Ein zerrissenes unbrauchbares Seil liegt auf dem Boden. An ihm ist noch ein "
    "kleineres Seil geknotet. Daran war bestimmt der Eimer befestigt.");
  AddDetail( ({"stein"}),
    "Ein groesserer Stein, der aus dem Brunnen herausgebrochen ist, an ihm ist eine "
    "Metallplatte befestigt.");
  AddDetail( ({"metallplatte", "platte"}),
    "In die Metallplatte ist etwas eingraviert. Du kannst die Schrift lesen.");
  AddDetail( ({"schrift"}),
    "Schrift, bestehend aus Buchstaben, die ein oder mehrere Worte umfassen. "
    "Vielleicht liest Du die Schrift einfach mal?");
  AddDetail( ({"zeit"}),
    "Vor langer Zeit, muss der Brunnen noch intakt gewesen sein. Jetzt ist er "
    "voellig zerstoert.");
  AddDetail( ({"eimer"}),
    "Mit dem Eimer, der moeglicherweise in dem Brunnen liegt, konnte man vor  "
    "langer Zeit, sicher Wasser nach oben ziehen.");
  AddDetail( ({"wasser"}),
    "Aus diesem Brunnen wirst Du sicher kein Wasser mehr schoepfen koennen."
    "Du schaust in den Brunnen und Dir kommt der Gedanke, ein Steinchen hinunter "
    "zu werfen.");
  AddDetail( ({"steinchen"}),
    "Ueberall liegen hier kleine Steinchen herum, wirf einen in den Brunnen, "
    "wenn Du willst.");
  AddDetail( ({"buchstaben"}),
    "Worte bestehen aus mehreren Buchstaben.");
  AddDetail( ({"worte"}),
    "Worte kann man lesen und sie bestehen aus aneinander gereihten "
    "Buchstaben");
  AddDetail( ({"burg","sandburg"}),
    "Du stehst in dem Burghof dieser seltsamen Burg. Von aussen sieht sie "
    "so klein aus und hier bist Du in einer grossen Burg. Ueberall kann "
    "man hindurchsehen. Dir wird Angst und Bange.....................");
  AddDetail( ({"angst"}),
    "Deine Angst koennte berechtigt sein, aber schau Dich erst weiter um.");
  AddDetail( ({"bange"}),
    "Wenn einem Bange ist hat man Angst. Aber schau Dich erstmal weiter um.");
  AddDetail( ({"burghof"}),
    "Du stehst gerade im Burghof und ueberlegst wohl ob Du weiter gehen "
    "sollst oder besser wieder zurueck auf die Insel gehst.");
  AddDetail( ({"insel","holztor","tor"}),
    "Durch das Holztor, die Burgmauer, sprich ringsumher kannst Du ausserhalb "
    "schemenhaft die Insel erkennen. Aber dazu solltest Du schon naeher "
    "heran gehen.");
  AddDetail( ({"burgmauer"}),
    "Die Burgmauer, ist genauso durchsichtig wie alles andere hier auch.");
  AddDetail( ({"armee"}),
    "Die Armee der Untoten schwebt von Zeit zu Zeit durch die Burg und "
    "treibt ihr Unwesen.");
  AddDetail( ({"unwesen"}),
    "Die Armee der Untoten treibt hier ihr Unwesen.");
  AddDetail( ({"geraschel"}),
    "Wenn die Armee der Untoten ihr Unwesen treibt kann man Geraschel und "
    "Stimmen hoeren.");
  AddDetail( ({"stimmen"}),
    "Die Stimmen und das Geraschel sind eigendlich immer zu hoeren. Auch wenn "
    "die Armee der Untoten gerade nicht da ist.");
  AddDetail( ({"halle"}),
    "Du kannst die Halle betreten wenn Du nach Norden gehst. Du kannst auch durch "
    "die Wand der Halle durchschauen und erkennst das es ein Thronsaal ist. ");
  AddDetail( ({"thronsaal"}),
    "Die Halle sieht von hier aus wie ein grosser Thronsaal.");
  AddDetail( ({"wand"}),
    "Du kannst durch die Wand in den Thronsaal schauen.");
  AddDetail( ({"haus"}),
    "Nach Nordwesten kommst Du in ein Haus. Ein Schild ist dort angebracht.");
  AddDetail( ({"waffenexpertin","expertin"}),
    "Das Haus der Waffenexpertin ist im Nordwesten.");
  AddDetail( ({"schild"}),
    "Du kannst es lesen.");
  AddDetail( ({"himmel"}),
    "Unerklaerlicherweise kannst Du ihn hier nicht besonders gut erkennen.");
  AddDetail( ({"erker"}),
    "Weiter im Sueden kannst Du eine Treppe erkennen. Sie Scheint zu einem Erker "
    "zu fuehren, der einmal als Schiessscharte gedient hat.");
  AddDetail( ({"schiessscharte"}),
    "Die Schiessscharte im Sueden kann man auch als Erker bezeichnen. "
    "Um genaueres zu sehen musst Du aber schon hingehen.");
  AddDetail( ({"laden"}),
    "Nach Nordosten hin kannst Du einen Laden betreten.");
  AddDetail( ({"sand"}),
    "Auf dem Boden liegt recht viel Sand. Aber auch der Sand ist durchsichtig.");
  AddDetail( ({"nebel"}),
    "Es erscheint Dir so als ob ueberall Nebel waere, aber es ist die "
    "Durchsichtigkeit, die Dich das glauben laesst.");
  AddDetail( ({"durchsichtigkeit"}),
    "Da alles hier durch die Durchsichtigkeit getruebt ist, glaubst Du ueberall "
    "Nebel zu sehen.");
  AddDetail( ({"koerper"}),
    "Wenn Du der Armee der Untoten gewahr wirst, erzittert Dein ganzer Koerper.");
  AddDetail( ({"untote"}),
    "Wenn DU mehr ueber Untote erfahren moechtest, solltest Du einmal zu Xarfai gehen.");
  AddDetail( ({"xarfai"}),
    "Xarfai ist das Gildenoberhaupt der Nekromanten.");
  AddDetail( ({"gildenoberhaupt","oberhaupt"}),
    "Das Gildenoberhaupt der Nekromanten ist Xarfai.");
  AddDetail( ({"nekromanten"}),
    "Die Nekromanten wissen sehr genau was Untote sind.");
  AddDetail( ({"ohr"}),
    "Mit Deinem Ohr kannst Du hoeren. Versuch es mal.");
  AddDetail( ({"fea","fenda","hisie"}),
    "Diese Worte, Fea, Fenda , Hisie kannst Du nicht verstehen.");
  AddDetail( ({"mulash"}),
    "Mulash.....wer kann das sein? Versuch es herauszufinden.");
  AddDetail( ({"treppe"}),
    "Die Treppe kannst Du im Sueden schon sehen. Du kannst sie erreichen "
    "wenn Du dem Weg nach Sueden folgst.");
  AddDetail( ({"sueden"}),
    "Nach Sueden kannst Du ueber einen Weg zu der Treppe gelangen.");
  AddDetail( ({"gebaeude"}),
    "Das Gebaeude im Suedosten ist recht gross und an ihm ist ein "
    "Rundschild befestigt.");
  AddDetail( ({"weg","wege"}),
    "Es fuehren Wege nach Westen und Sueden.");
  AddDetail( ({"rundschild"}),
    "Du kannst es lesen.");
		  
  AddReadDetail( ({"schild"}),
		"\n   ~*Das Haus der Waffenexpertin*~  \n"
                "  \n"
                "\n   ~*Trete ein und sei Willkommen*~  \n");

  AddReadDetail( ({"schrift"}),
		"\n~Dieser Brunnen wird in kuerze wieder repariert.~ \n"
                "  \n"
                "\n      ~Er ist an Gwenshara vermietet.~        \n");

  AddReadDetail( ({"rundschild"}),
		"\n     ~*Das Haus des Wissen's*~  \n"
                "  \n"
                "\n          ~*Bibliothek*~     \n"
		"  \n"
		"\n           *geschlossen*    \n");


  AddRoomMessage( ({"Die Armee der Untoten erscheint und schwebt durch Dich hindurch.\n",
      "Dir wird schrecklich kalt und Du zitterst am ganzen Koerper.\n",
      "Du hoerst ueberall Geraschel und leise Stimmen.\n"
      "Du hoerst unbekannte Laute an Dein Ohr dringen.\n"
      "Hisie, Hisie fana Fenda.\n"
      "Dagrodi dacil Fea Mulash.\n"}),30,"func");
 
  AddSound( DEFAULT_SOUND,
    "Das Geraschel und die Stimmen die ab und an zu hoeren sind "
    "lassen Dich erzittern. Manchmal fluestern die Stimmen etwas "
    "in einer Dir unbekannten Sprache.");
  AddSound( ({ "geraschel"}),
    "Wenn die Armee der Untoten erscheint vernimmst Du dieses Geraschel.");
  AddSound( ({ "stimmen"}),
    "Die Stimmen fluestern stetig in einer Dir fremden Sprache.");
  AddSound( ({ "sprache"}),
    "Du hoerst leise die Stimmen der Untoten in einer fremden Sprache.");
  AddSound( ({"laute"}),
    "Die Laute dringen ploetzlich an Dein Ohr. Verstehen kannst Du sie nicht");
  
  AddSmell( DEFAULT_SMELL,
    "Du kannst hier absolut nichts riechen. Ausser eventuell Deine "
    "eigenen Gerueche.");
  AddSmell( ({ "gerueche"}),
    "Das sind Deine eigenen Gerueche. Hier kannst Du ansonsten garnichts riechen.");
     
  AddCmd( ({"ziehe","zieh","ziehen" }), "ziehen" ); 
 AddCmd( ({"wirf","werf","werfe" }), "werfen" ); 

  AddExit( "norden",  ROOM "halle" );
  AddExit( "sueden",   ROOM "weg2" );
  AddExit( "nordosten",  ROOM "laden" );
  AddExit( "nordwesten",  ROOM "repahaus" );
  AddExit( "westen",  ROOM "weg1" );   
    
    AddItem( NPC "mirasa", REFRESH_DESTRUCT);
//  AddItem(NPC "", REFRESH_DESTRUCT);
    

 // Ende Create
}

int ziehen(string str)
{
 notify_fail("An was willst Du ziehen?\n");

 if(!str || str == "") return 0;
 if(!(str == "eisenring" ||
      str == "an eisenring" )) return 0;
 

 write(BS("Du ziehst an dem Eisenring und bemerkst wie Du ploetzlich "
	  "durch den durchsichtigen Boden gezogen wirst. "
	  "DU wuenschst Dir niemals diesen Eisenring gesehen zu haben. "
	  "Was wird Dich blos dort unten erwarten?\n"));

 say(TPN+" wird ploetzlich in den durchsichtigen Boden gezogen und "
	 "zappelt wild mit den Armen und Beinen.\n");
 domainshout( TPN+" ruft Hilfe, Waende umschliessen mich, Ich bin verloren.\n","^/d/wasser/hiri/sandburg/",1);

 TP->move( ROOM "kerker", M_GO, "faellt");


 return 1;

}

int werfen(string str)
{
   
   notify_fail("Was moechtest Du werfen?\n");
   if ( member( ({ "steinchen", "ein steinchen", "das steinchen" }),str) != -1) 
  {
    write(BS( "Du nimmst eines der kleinen Steinchen und wirfst es in den "
           "zerfallenen Brunnen. Du wartest darauf das Du hoerst wie das "
           "Steinchen aufschlaegt. Ploetzlich entsteht ein Geist vor Dir. "
	   "Er sieht aus wie Gwenshara und spricht:\n"
	   "TZTZ; kannst Du nicht Lesen? Ich arbeite gerade dort unten, "
	   "und Du wirfst MIR Steinchen auf den Kopf? Das gehoert bestraft."));
            
    say( TPN+" wirft ein Steinchen in den Brunnen.\n");
    TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 14,
                PARALYZE_MSG: "Du bist so geschockt und regungslos.\n",
                PARALYZE_END: "Scheinbar, ist dieser Geist verschwunden, "
                              "Du kannst Dich wieder bewegen. Aber da stimmt "
			      "mit Dir was nicht. Du wirkst betrunken.\n"
                              ]) );
    TP->SetProp(P_ALCOHOL, 60);
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",4);
    return 1;
  }
 }
void fall1()
{

  
  write(BS( "Du starrst unglaeubig auf den Geist Gwensharas und "
         "kannst Dich nicht mehr bewegen.\n"));
 
  

}


