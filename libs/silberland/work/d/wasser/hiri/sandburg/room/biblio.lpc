

#include "../def.h"

#include <defines.h>
#include <properties.h>
#include <moving.h>
inherit "std/room";
void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Bibliothek");
  SetProp(P_INT_LONG,
    ".");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );





  AddDetail( ({ "bibliothek"}),
                ". ");
  
  
//  AddItem(NPC "", REFRESH_DESTRUCT);    
  
//  AddCmd( ({"nehme", "nimm" }), "nehme" );
  
  
  AddExit( "suedwesten",  ROOM "burghof" );
}

