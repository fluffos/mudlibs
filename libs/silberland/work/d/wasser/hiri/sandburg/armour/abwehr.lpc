/* erstellt von hiri am 4.7.04 */



inherit "std/armour";
#include "../def.h"
#include <new_skills.h>
#include <properties.h>
#include <combat.h>

nosave int idler;

void create()
  {
  if(!is_clone(TO)) return; 
  ::create();

 

  SetProp(P_SHORT, "Eine blaue schimmernde Robe");
  SetProp(P_LONG,
    "Du siehst eine blaue Robe die mit seltsamen Zeichen besetzt "
    "ist und einen goldenen Saum hat. Eine weit herunter haengende "
    "Kapuze schliest am Kragen an. Die Aermel sind weit geschnitten "
    "und ebenfalls mit goldenem Saum besetzt." );
  SetProp(P_INFO, "Die Robe ist ein besonderer Schutz gegen Magie." );
  SetProp(P_NAME, "Robe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"robe"}) );
  SetProp(P_NAME_ADJ, "blau schimmernd");
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([ MAT_SHADOW:14, MAT_OBSIDIAN:33,MAT_GOLD:1,MAT_MAGIC:2,MAT_GHOST:50 ]) );
  SetProp(P_WEIGHT, 340);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 180);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_MAGIC:2]));
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:15,
                                 SR_INCLUDE_GUILD:
                                 (["druiden",
                                   "dunkelelfen",
			           "nekromanten"])
				 ]));
                                 
  SetProp(P_INFO, BS("Die Robe scheint Licht auf magische Weise zu absorbieren, "
       "und bringt auf diese Weise, dem Traeger Vor- und Nachteile."));
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:6,T_HEAT_PROT:-4 ]) );

  AddDetail(({"zeichen"}),
    "Diese Zeichen sind Dir gaenzlich unbekannt, von ihnen geht "
    "etwas unheimliches aus.");
  AddDetail(({"aermel"}),
    "Die Aermel der Robe sind an der Armrueckseite laenger und gehen "
    "spitz nach unten. Am Aermelende ist ein goldener Saum.");
  AddDetail(({"kapuze"}),
    "An die Robe ist eine Lange Kapuze genaeht. Auch sie hat diese "
    "Zeichen aufgenaeht und einen goldenen Saum. Die Kapuze verdeckt "
    "Dein Gesicht.");
  AddDetail(({"gesicht"}),
    "Dein Geischt verschwindet unter der Kapuze der Robe.");
  AddDetail(({"robe"}),
    "Die Robe ist aus einem sehr guten Stoff, sie hat "
    "dadurch einige Vorteile.");
  AddDetail(({"stoff"}),
    "Die Robe ist aus einem feinen, warmhaltenden Stoff "
    "gefertigt.");
  AddDetail(({"vorteile"}),
    "Die Vorteile der Robe wirst Du bei ihrem gebrauch "
    "erkennen, einer davon ist aber moeglicherweise "
    "ein Schutz vor der Kaelte.");
  AddDetail(({"schutz"}),
    "Finde doch heraus welchen Schutz Dir die Robe bieten "
    "kann.");
  AddDetail(({"kaelte"}),
    "In der Burg, wo Du diese Robe bekommen hast, waert eine "
    "ziemliche Kaelte.");
  
  }

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int prot,f,l;
  prot = 0;

  if(random(10) > 3) return 0;                 
  if(!enemy) return 0;


  if (enemy->QueryProp(P_RACE) == "Geist")

 {
    tell_object(QueryProp(P_WORN),
      "Mulash laesst Dich seine Macht und Rache spueren.\n");
    prot -= random(3);
  }
  else if ((f=(member(dtyp, DT_MAGIC) >= 0)) ||
           (l=(member(dtyp, DT_LIGHT) >= 0)))
  {
    
    prot = 4 + random(6);
    tell_object (QueryProp (P_WORN),
        "Deine Robe haelt ein wenig von "+
        (f ? "der Magie" : "dem Licht")+" ab.\n");
  }
  return prot;
     
  }

private nosave void EsWird(object pl, string was)
{
  mixed u;
  int i;

  if (!objectp(pl)) return;
  u=all_inventory(environment(pl));
  u=filter_array(u,#'living);
  for (i=sizeof(u)-1; i>=0; i--)
    if (!u[i]->CannotSee(1))
      tell_object(u[i], "Es wird ein wenig "+was+".\n");
}

nosave void SetMyLight(object pl, int x)
{
  if (!pl) x=0;         
  SetProp(P_LIGHT, x);
  if (x<0) EsWird(pl,"dunkler"); else EsWird(pl,"heller");
}

int WearFunc(object ruest, int silent)
{

  while (remove_call_out("SetMyLight") != -1) ;
  if (this_player()->is_class_member(CL_NIGHTVISION))
    call_out("SetMyLight", 2, this_player(), -3);
  else
    call_out("SetMyLight", 2, this_player(), -1);
  idler = 0;
  return 1;

if(member(({"druiden","nekromanten","dunkelelfen"}), TP->QueryProp(P_GUILD))==-1) 
{ 
write(BS("Zu Dumm aber auch, bist wohl in der Falschen Gilde. Da Du weder "
	 "den Nekromanten, Druiden oder Dunkelelfen angehoerst, "
	 "wirst Du diese Robe niemals tragen koennen :P!")); 
return 0;
}
}

int RemoveFunc(object ruest, int silent)
{
  while (remove_call_out("SetMyLight") != -1) /* continue */ ;
  call_out("SetMyLight", 2, this_player(), 0);
  if (idler && !silent)
    tell_object(this_player(),
        "Die blaue schimmernde Robe gibt wieder etwas dunkle Energie ab.\n");
  idler = 0;
  return 1;
}

void reset()
{
  object pl;
  ::reset();
  if(!is_clone(TO)) return;
  if (!objectp(pl=QueryProp(P_WORN)))
  SetProp(P_LIGHT, 0);                
  else if (!idler && interactive(pl) && query_idle(pl) > 600)   
  {
    idler++;
    tell_object(pl, "Die Robe verliert durch Deine Passivitaet an dunkler Energie.\n");
    call_out("SetMyLight", 2, this_player(), 0);
  }
}

