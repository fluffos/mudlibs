//erstellt von Hiri am 1.2.07
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tekla, die Spinne");
  SetProp(P_LONG,
    "Hier siehst Du die kleine Spinne Tekla. Sie haengt hier in ihrem "
    "Netz und ist ganz traurig, weil sie ihre Geige verloren hat. Sie "
    "kann einem wirklich leid tun.");
  SetProp(P_NAME, "Tekla");
  SetProp(P_GENDER,  FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"tekla","spinne", "HIRIIXUB"}));

  create_default_npc(6);
  SetProp(P_SIZE, 2 );
  SetProp(P_RACE, "Spinne");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_MMSGIN, "krabbelt traurig an ihrem Faden herein");
  SetProp(P_MMSGOUT, "krabbelt traurig an ihrem Faden davon");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_NOATTACK, "sagt: bitte bring mir schnell meine Geige wieder.");
  SetProp(P_LOG_INFO, "hiri/inselversteck.log");
  AddInfo(DEFAULT_INFO, "jammert immerzu ihrer Geige nach.\n");
  AddInfo("hiri", "Iluminati Hiri ist einfach nur boese.","sagt traurig: ");

  AddInfo( ({"ixub","drachenfrau"}),
    "Grummel, wenn Ixub nicht hergestampft waere, haette ich "
    "meine Geige noch.",
    "sagt traurig: ");

  AddInfo( ({"geige","bogen"}),
    "Meine Geige ist mir verloren gegangen als diese Drachenfrau "
    "hier her gestampft ist. Dafuer ist mir ein komisches Ding "
    "ins Netz geflogen. Wenn Du mir meine Geige findest, mir sie "
    "wieder bringst und gibst, bekommst Du das Ding.",
    "jammert traurig: ");

  AddInfo( ({"ding","popel"}),
    "Dieses Ding das mir in mein Netz geflogen ist, ist ekelig "
    "und stinkt. Es schwabbelt so seltsam. Es koennte ein Popel "
    "sein. Es scheint fuer die Drachenfrau sehr wichtig zu sein. "
    "Bring mir meine Geige bitte und ich gebe Dir das Ding.",
    "sagt traurig: ");

   SetProp( P_REJECT, ({ REJECT_DROP,
    "Tekla will Deine Sachen nicht tragen.\n" }) );

   AddCmd("gib|gebe&geige", "geben",
         "Was willst Du wem geben? Tekla die Geige?");


 
}

int geben(string str)
{
  object popel;
  object geige;
  if(!present("geige", TP))
  {
  write(BS("Tekla sagt: Du hast ja meine Geige garnicht.\n"));
 
  return -1;
  }
  geige = present("geige", TP); // bzw die andere eindeutige id halt
 
  { 
  write(BS("Tekla jubelt: Meine Geige und mein Bogen, vielen Dank. "
           "Sie spielt ein Lied auf ihrer Geige um zu testen ob "
           "alles stimmt und wirft Dir geschwind den Popel zu um "
	   "dann weiter zu spielen.\n"));
  if (present("geige",TP))
  present("geige",TP)->remove();
  popel=clone_object("/d/wasser/hiri/maske/obj/popel.lpc")->move(TP, M_NOCHECK);
  }
//  else
  {
  write(BS("Tekla sagt: Das Ding oder Popel, was immer es ist, "
           "hast Du jetzt. Verschwinde und lass mich spielen.\n"));
  }
return 1;
}




