//erstellt im Februar 03 von hiri
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ixub, die Drachenfrau");
  SetProp(P_LONG,
    "Ixub ist eine ziemlich alte Drachenmenschenfrau mit schrecklichen gelben ekligen "
    "Pickeln im Gesicht, sie wuerde wahrscheinlich nichtmal mit einer kneifzange angefasst. "
    "Ihr gelbes, ekliges Gebiss sitzt lose in ihrem Mund und sie ist einfach nur eklig.");
  SetProp(P_NAME, "Ixub");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "ixub", "drachenfrau", "frau", "HIRIIXUB" }));

  create_default_npc(35);
  SetProp(P_HANDS, ({" mit ihren Knochenhaenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 180 );
  SetProp(P_RACE, "Drachenmensch");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);
  SetProp(P_NOATTACK, "schaut Dich wuetend an und lispelt: Hilf mir lieber.");
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "klappert aus einer anderen Dimension herein");
  SetProp(P_MSGOUT, "klappert sich in eine andere Dimension");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  /*SetProp(P_MNPC_AREA, ( {ROOM "insel", ROOM "insel2", ROOM "insel3",
                          ROOM "insel4",ROOM "insel6", ROOM "insel7",
                          ROOM "inselx",ROOM "insel5", ROOM "insel9",
                          ROOM "steg", ROOM "insel8"}));
  SetProp(P_MNPC_WAIT, ({ 20, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "insel9");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);*/

  AddInfo(DEFAULT_INFO, "moechte Popelsuppe fuer ihren Teint.\n");
  
  AddInfo("hiri",
    "Illuminati Hiri ift eine bofhafte Reinkarnation Lufiferf.","lispelt: ");
  AddInfo( ({"foenheitfmafke","mafke"}),
    "Wo ist meine Foenheitfmafke nur hin? Wenn mir doch nur jemand eine "
    "Foenheitfmafke machen koennte. Ich wuerde auch das Refept verraten "
    "wenn mir Jemand helfen wuerde.",
    "lispelt: ");
  AddInfo( ({"rezept"}),
    "Fuer die Foenheitfmafke braucht man ein Refept, wenn Du mir Deine Hilfe "
    "anbieteft koennen wir noch einmal ueber das Refept reden. Frag mich "
    "erftmal nach Hilfe.",
    "lispelt: ");
  AddInfo( ({ "hilfe"}),
    "Jaaaaaaa Du koennteft mir wirklich helfen. Ich bin noch fo fwach "
    "auf den Beinen und kann nur langfam laufen. Die Reife hat mir fo ftark "
    "fugefetft, daff ich fogar meine Foenheit verloren habe und auffehe "
    "wie eine Alte. Wenn Du mir helfen moechteft meine foenheitfmafke "
    "herfuftellen waere ich fehr gluecklich. Biete mir einfach Hilfe an. ",
    "seufzt lispelnd: ");
  
  SetProp(P_LOG_INFO, "hiri/inselversteck.log");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ixub will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Ixub lispelt, wie bekomme ich nur meine Foenheitfmafke, wiefo hilft mir niemand.\n",
    "Ixub lispelt undeutlich.\n"}) );
  


  SUID;
  CLONEME(WEAPON "ixubgebiss" );
  command("zuecke waffe");
  
  //Kommando zum Hilfeanbieten -> Man bekommt das Questobjekt und muss dann
  //anfangen, die noetigen Dinge fuer die maske zu finden.
  AddCmd("biet|biete&ixub|drachenfrau&hilfe&an", "cmd_hilfe",
         "Wem moechtest Du denn Deine Hilfe anbieten?|"
         "Moechtest Du Deine Hilfe anbieten?|"
         "Biete doch einfach Deine Hilfe an!");
  //Kommando zum Questbeenden:
  AddCmd("misch|mische&schoenheitsmaske", "questende",
         "Was willst Du mischen? Eine Schoenheitsmaske?");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "nimmt Dich beruhigend in den Arm.",
        TP->Name(WER)+" wird von Ixub beruhigend in den Arm genommen.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "knurrt Dich ziemlich wuetend an.",
        "knurrt wuetend.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "lacht laut ueber Dich.",
        "lacht laut auf.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
      "haut Dich ziemlich schnell mit ihrem Gebiss.",
      "haut mit ihrem Gebiss zu.");
       TP->AddHp(-20);
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich boese an.",
        "faucht boese zurueck.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich freundlich an.",
        "laechelt freundlich.");
      break;
    case "intim":
     
        call_out("reaction", 0, TP,
          "kuschelt Dich strahlend.",
          "findet es schoen gekuschelt zu werden.");
        break;
      
    case "nett":
      call_out("reaction", 0, TP,
        "grunzt leise vor sich hin.",
        "grunzt leise vor sich hin.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "belastet das aber ueberhaupt nicht.",
        "belastet das aber ueberhaupt nicht.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


int cmd_hilfe(string str)
{

  if(!present("\nmaske_quest",TP)) //Wenn kein Questobj vorhanden ist, eins clonen:
  {  
    CLONE(OBJ "msobj", TP);
    ENV(TO)->Message(break_string("Alfo, "+TPN+", fuche bitte die "
                                            "Futaten fuer meine Mafke. "
                                            "Wenn Du alles fufammen haft, "
                                            "mach bitte die Mafke fertig "
					    "und gib fie mir dann! Achja, "
					    "Hier ift noch daf Refept." , 78, 
                                            "Ixub liespelt: "),
                                            MSGFLAG_SOUND);
  clone_object("/d/wasser/hiri/maske/obj/iobj.lpc")->move(TP, M_NOCHECK);
     return 1;
  }
  //TP hat bereits das Questobj und braucht daher nicht noch ein weiteres:
  ENV(TO)->Message(break_string("Willft Du daf if verfrumpel? Bring mir meine "
			        "Foenheitfmafke. Du hilft mir doch fon " 
                                  +TPN+"!",78, "Ixub lispelt wuetend: "),
                                  MSGFLAG_SOUND);
  return 1;
}
