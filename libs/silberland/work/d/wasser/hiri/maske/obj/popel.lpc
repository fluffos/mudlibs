inherit "std/thing";

#include "../def.h"


string *popels = ({"eklig", "gruen", "gelb", "schwarz", "orangen",
                   "schwabbelig", "feurig", "eisig", "violett", "rosa"});

void create()
{
  if(!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_NAME, "Popel");
  SetProp(P_NAME_ADJ, popels[random(sizeof(popels))]);
  SetProp(P_GENDER, MALE);
  
  SetProp(P_SHORT, Name(WER, 0));
  SetProp(P_LONG, Name(WEN, 1)+" brauchst Du fuer die Schoenheitsmaske. "
    "Ohne ihn wird das Rezept nicht den gewuenschten Erfolg haben.");

  AddId(({"popel", QueryProp(P_NAME_ADJ)[0]+" popel", "\nmaske_popel",
    "QUESTOBJ", "\nMASKEOBJ", "NODESTRUCT"}));

  SetProp(P_INFO, "Lies das Rezept noch mal genau durch. Du wirst "
                  "den Popel brauchen.");

//Too much
  SetProp(P_WEIGHT, 40);
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NODROP, "Den brauchst Du doch noch!\n");
  
  AddDetail("schoenheitsmaske","maske",
    "Die Schoenheitsmaske gibt Ixub ihr altes Aussehen wieder.");
  AddDetail("rezept", 
    "Das sollst Du zusammen mischen. Ohne das Rezept gibt es keine "
    "Schoenheitsmaske fuer Ixub.");
  AddDetail("erfolg",
    "Erfolg wird Ixub nur haben, wenn Du alles richtig machst."); 
}


































