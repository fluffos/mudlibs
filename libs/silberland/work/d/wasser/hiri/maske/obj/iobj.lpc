// ACHTUNG: feuerstelle muss hier raus, hat der spieler nicht im inv, muss
//extra abgefragt werden. fackel ist nur zum testen drin, spaeter rausnehmen.
//die strings "ekliger popel" usw muessen genau so dann als id im popel
//gesetzt sein 
string *questnamen = ({"fackel","eklig popel", "gruen popel",
  "gelb popel", "schwarz popel", "orangen popel",
  "schwabbelig popel", "feurig popel", "eisig popel",
  "violett popel", "rosa popel", "eimer", "wasser", "salbei",
  "feuerstein", "topfhelm", "holz", "feuerstelle", "thymian"});

nosave int gefunden, gemischt, failed;
nosave string schoenheitsmaske;

void create() 
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Rezept fuer eine Schoenheitsmaske");
  SetProp(P_LONG,
	     "Du brauchst fuer die Schoenheitsmaske: "
	     "Zehn Popel. Je einen ekligen, gruenen, "
	     "gelben, schwarzen, orangenen, schwabbeligen, "
	     "feurigen, eisigen, violetten und einen rosanen. "
	     "Einen Topfhelm der Dir als Topf dient. "
	     "Einen Feuerstein. "
	     "Etwas Holz fuer das Feuer. "
	     "Einen Eimer um Wasser zu besorgen. "
	     "Wasser um die Popel zu kochen. "
	     "Etwas Thymian und Salbei."
	     "Wenn Du das alles hast, kannst Du die "
	     "Schoenheitsmaske an der Feuerstelle mischen.");

  SetProp(P_NAME, "Rezept");
  SetProp(P_GENDER, NEUTER);

  AddId(({"rezept", "\nmaskequestrz",
          "\nmaske_quest","QUESTOBJ", "NODESTRUCT"}));


//Solche Materialien fuer ein Rezept?? Stahl und Eisen?
  SetProp(P_MATERIAL, ([MAT_WOOD:10,MAT_STEEL:70,MAT_IRON:20]));

//Yara 0?  
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL,1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
//  dauer=4;


//  SUID;

//  schoenheitsmaske=lower_case(QUESTNAMEN[random(sizeof(QUESTNAMEN))]);
//  failed=0;

// Nur zum testen, spaeter raus!
  AddCmd("test", "testQuestObjects");
}


//----------------------------------------------------------------------------

//test, ob spieler alles hat:
int testQuestObjects() {
  string *tmpqn, *tmpids;
  object *tmpobj;
  object ob;
  tmpqn = questnamen;
  tmpids = ({});
  tmpobj = ({});

  for(ob=first_inventory(TP); ob; ob=next_inventory(ob)) {
    if(sizeof(tmpids = tmpqn & (ob->QueryProp(P_IDS) || ({})))) {
      tmpqn -= ({tmpids[0]});
      tmpobj += ({ob});
      if(!sizeof(tmpqn)) break;
    }
  }

  if(!sizeof(tmpqn)) {
    write("Alles gefunden!\n");
    return 1;
  }

  write(sprintf("Nicht alles gefunden. Gefunden: %O\n", tmpobj));
  return -1;
}
