#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/thing";

//#define QUESTNAMEN \
//({"ekliger", "gruener", "gelber", "schwarzer", "oranger", "schwabbeliger", \
//  "feuriger", "eisiger", "violetter", "rosaner", "eimer", "wasser",
