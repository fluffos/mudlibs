//erstellt von Hiri am 29.01.07



inherit "std/thing";

#include "../def.h"



void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Eine winzige Geige mit Bogen");  
  SetProp(P_NAME, "Geige");
  AddId(({"geige","maske_geige","QUESTOBJ","MASKEOBJ","NODESTRUCT"}));
  SetProp(P_WEIGHT, 120);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 2);
  SetProp(P_NODROP, "Die kleine Geige solltest Du nicht wegwerfen "
                    "sondern jemandem zum spielen bringen!\n");
  SetProp(P_LONG,
    "Diese kleine Geige laesst sich sogar spielen. Jemand scheint sie "
    "verloren zu haben. Vielleicht solltest Du sie zurueckbringen. "
    "Such einfach nach einem krabbeligen achtbeinigem Wesen! ");
  AddDetail("wesen", 
    "Das haelt sich bestimmt hier irgendwo auf der Insel auf!");
  AddDetail("insel", 
    "Du bist auf einer Insel und solltest sie genau untersuchen?");
  SetProp(P_INFO, "Die Geige kannst Du vielleicht gegen etwas eintauschen "
                  "wenn Du sie dem Wesen zurueck bringst?");

}
