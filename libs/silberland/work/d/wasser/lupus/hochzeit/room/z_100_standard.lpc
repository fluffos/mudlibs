inherit "/d/wasser/lupus/hochzeit/room/hz_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "../hochzeit.h"

create()
{
	::create();

   SetProp( P_INT_SHORT, "Das Standesamt der Region Wasser" );
   SetProp( P_INT_LONG,
	    BS("Hier, im Turmzimmer der Pier ist das Standesamt der Region "
	       + "Wasser untergebracht. Abgesehen von der Stelle, wo an "
	       + "einer Seite des achteckigen Zimmers die Treppe "
	       + "herauffuehrt, bestehen alle Waende dieses Zimmers aus "
	       + "Glasfenstern. So ist dieser Raum staendig von der Sonne "
	       + "durchflutet.\n"
	       + "Moebliert ist der Raum allerdings nur spaerlich: Der "
	       + "Schreibtisch, an dem der Standesbeamte fleissig seine "
	       + "Arbeit verrichtet und der Stuhl, auf dem er dabei sitzt "
	       + "sind die einzigen Moebel.\n" ));
   
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 1 );
   SetProp( P_NO_TPORT, NO_TPORT );
   SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE:22]));

   AddSpecialDetail( ({ "raum", "zimmer", "turmzimmer", "standesamt" }),
		     "Hier" );
   AddDetail( "pier",
	     BS("Du befindest Dich seit einer Weile auf und in ihr. Schau "
		+ "Dich am besten einfach um.\n" ) );
   AddDetail( ({ "region", "wasser", "champagner" }),
	      BS("Wasser! Oder was glaubst Du, aus was Champagner "
		 + "groesstenteils besteht?\n"));
   
   AddCmd( "goto", "nogo" );

   AddExit( "unten", HZROOM("empfang") );

   AddItem( HZNPC("stbeamter"), REFRESH_DESTRUCT );
   
}

//Hier wird goto abgefangen.

int nogo()
{
   if( !IS_WIZARD( TP ) )
   {
   	write("Wie Bitte?\n");
   	return 1;
   }
   else 
   {
   	write(BS("Jemand raunt Dir zu: Es waere nicht hoeflich, diesen "
   	+ "Raum so ploetzlich zu verlassen.") );
   	return 1;
   }
}

Hier()
{
  return( this_object()->QueryProp(P_INT_LONG) );
}

init()
{
   ::init();
   
   //Hier wird abgefragt, ob der Eintretende ueberhaupt "persona grata" ist.
   if( call_other( HZM, "ist_er_stoerer", this_player() ) != 0)
   {
   	write("Du hast hier nix zu suchen!\n");
   	this_player()->move( HZAUS, M_GO | M_NO_SHOW, "nach unten",
   	"fluechtest hektisch", "flieht panisch" );
   	return 0;
   }
   //Hier werden Gaeste angemeldet.
   call_other( HZM, "neuer_gast", TP );
   return 1;
}

exit()
{
   ::exit();
   
   //Hier werden Gaeste wieder ausgetragen.
   call_other( HZM, "alter_gast", this_player() );
   return 1;
}

