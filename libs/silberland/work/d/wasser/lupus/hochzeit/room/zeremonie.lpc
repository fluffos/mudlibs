inherit "/d/wasser/lupus/hochzeit/room/hz_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "../hochzeit.h"

create()
{
	::create();

   SetProp( P_INT_SHORT, "Hochzeitsraum" );
   SetProp( P_INT_LONG, "In diesem Raum finden Hochzeiten statt.\n"
   );
   
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_NO_TPORT, NO_TPORT );
   
   AddCmd( "goto" , "nogo" );

   AddExit( "unten", HZROOM("empfang") );

}

//Hier wird goto abgefangen.

int nogo()
{
   if( !IS_WIZARD( TP ) )
   {
   	write("Wie Bitte?\n");
   	return 1;
   }
   else 
   {
   	write(BS("Jemand raunt Dir zu: Es waere nicht hoeflich, diesen "
   	+ "Raum so ploetzlich zu verlassen.") );
   	return 1;
   }
}


init()
{
   ::init();
   
   //Hier wird abgefragt, ob der Eintretende ueberhaupt "persona grata" ist.
   if( call_other( HZM, "ist_er_stoerer", this_player() ) != 0)
   {
   	write("Du hast hier nix zu suchen!\n");
   	this_player()->move( HZAUS, M_GO | M_NO_SHOW, "nach unten",
   	"fluechtest hektisch", "flieht panisch" );
   	return 0;
   }
   //Hier werden Gaeste angemeldet.
   call_other( HZM, "neuer_gast", this_player() );
   return 1;
}

exit()
{
   ::exit();
   
   //Hier werden Gaeste wieder ausgetragen.
   call_other( HZM, "alter_gast", this_player() );
   say( "this_player() ist: " + to_string(TP) +"\n" );
   return 1;
}

