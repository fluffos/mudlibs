//
// $Date: 1998/06/10 18:12:43 $
/* $Revision: 1.1.1.1 $
 * $Log: empfang.c,v $
 * Revision 1.1.1.1  1998/06/10 18:12:43  lupus
 * Lichtlevel fuer Dunkelelfen auf 1 gesetzt.
 *
 * Revision 1.1  1997/11/21 11:36:16  uzs0ec
 * Initial revision
 * 
 *
 *      Anzahl der Details:
 *      Normal:         13
 *      Read:           00
 *      Sounds:         01
 *      Smells:         02
 *      Befehle:        00
 *
 */

inherit "/d/wasser/lupus/hochzeit/room/hz_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../hochzeit.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Ein Empfangsraum" );
  SetProp( P_INT_LONG, 
	   BS("Du stehst in einem sonnendurchfluteten Empfangsraum. Auch hier "
	      + "sind wie ueberall auf der Pier die Holzwaende weiss "
	      + "gestrichen. Im Raum verteilt stehen einige Sessel, in denen "
	      + "man es sich sicher sehr gut gemuetlich machen kann, falls "
	      + "man mal auf jemanden warten muss.\n"
	      + "An einer Seite des Raumes befindet sich eine Empfangstheke. "
	      + "Eine Treppe fuehrt weiter nach oben."));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE:22]));
  
  
  AddDetail( "sonne",
	     BS("Du kannst die Sonne zwar im Augenblick nicht sehen weil das "
		+ "Dach und das oberste Stockwerk der Pier im Weg sind, bist "
		+ "Dir aber trotzdem sicher, dass sie sich irgendwo da "
		+ "draussen rumtreibt."));
  AddDetail( ({ "dach", "decke" }),
	     BS("Die Decke ist abgesehen von dem Lampen, die von ihr "
		+ "herunterhaengen und der Treppe, die durch sie hindurch "
		+ "fuehrt ziemlich ereignislos."));
  AddDetail( ({ "lampe", "lampen" }),
	     BS("Sie sorgen dafuer, dass es in diesem sowieso schon "
		+ "sonnendurchfluteten Raum immer sehr hell bleibt."));
  AddSpecialDetail( ({ "raum", "empfangsraum" }), "Hier" );

// Angefuegt am 26.9.1997
  AddDetail( "pier",
	     BS("Du befindest Dich seit einer Weile auf und in ihr. Schau "
		+ "Dich am besten einfach um.\n" ) );
  AddDetail( ({ "wand", "waende", "holzwand", "holzwaende" }),
	     BS("Die Waende sind, wie ueberall auf der Pier, aus Holz "
		+ "und mit weisser Farbe angestrichen. Hier und da sind "
		+ "Bilder aufgehaengt.\n") );
  AddDetail( "bilder",
	     BS("Die Bilder stellen allesamt glueckliche Brautpaare dar.\n"));
  AddDetail( ({ "brautpaar", "brautpaare", "paar", "paare" }),
	     BS("Boah sind die gluecklich!\n" ));
  AddDetail( "sessel",
	     BS("Die Sessel sehen sehr gemuetlich aus.\n" ));
  AddDetail( ({ "empfangstheke", "theke", "seite" }),
	     BS("Die Theke ist aus hellem Fichtenholz. Auf ihr liegt das "
		+ "Hochzeitsverzeichnis.\n" ));
  AddDetail( ({ "holz", "fichtenholz" }),
	     BS("Das Helle Fichtenholz, aus dem die Empfangstheke hergestellt "
		+ "wurde passt hervorragend in diesen hellen Raum.\n") );
  AddDetail( "treppe",
	     BS("Sie fuehrt nach oben.\n" ));
  AddDetail( "boden",
	     BS("Der Boden ist ausserordentlich sauber.\n" ));
  AddSound( DEFAULT_SOUND,
	    BS("Du hoerst von draussen leise das Geraeusch sich an den "
	       + "Pfeilern der Pier brechender Wellen.\n" ));
  AddSmell( DEFAULT_SMELL,
	    BS("Es riecht hier nach Holz und Moebeln. Nichts, was Du nicht "
	       + "erwartet haettest.\n" ));

  // Neu am 30.09.1997;

  AddDetail( "farbe"
	   "Es gibt viele Farben, aber die Waende sind nur in einer "
	   + "gestrichen: Weiss." );
  
  AddExit( "unten", PIER("room/plattform-m") );   
  AddExit( "oben", HZROOM("z_100_standard") );
  
  AddItem(HZNPC("andrea"), REFRESH_DESTRUCT);
  AddItem(HZOBJ("hzbuch"), REFRESH_DESTRUCT);
}

Hier()
{
  return( this_object()->QueryProp(P_INT_LONG) );
}


init()
{
  ::init();
  
  if( call_other( HZM, "ist_er_stoerer", this_player() ) != 0)
    {
      write("Du hoerst eine Stimme, die Dich anbruellt: UNRUHESTIFTER HABEN "
	    + "HIER NICHT ZU SUCHEN!!\n");
      this_player()->move( HZAUS, M_GO | M_NO_SHOW, "nach unten", 
			   "kommt herein, erschrickt und fluechtest hektisch",
			   "flieht panisch" );
      return 0;
    }
  
}
