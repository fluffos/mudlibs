inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../hochzeit.h"

string braut, braeutigam, tzeuge, *beteiligte;
object brautobj, braeutigamobj, tzeugeobj;
create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Standesbeamter");
  SetProp(P_LONG, "Der Standesbeamte der Region Wasser.\n");
  SetProp(P_NAME, ({ "Standesbeamter", "Standesbeamten", "Standesbeamten",
		       "Standesbeamten" }));
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  AddId( ({ "beamter", "standesbeamter", "beamten", 
	      "standesbeamten", "immel" }) );
  create_default_npc( 20 );
  SetProp(P_BODY, 55);
  SetProp(P_HANDS, ({" mit seinen Haenden", 55}));
  SetProp(P_ALIGN, 100);
  SetProp(P_RACE, "Mensch");
  SetProp(P_XP, 10000);
  braut = "", braeutigam = "", tzeuge = "";
  
  AddCmd( "unterschreib", "Unterschrift", 1 );
  AddCmd( "beende", "HZ_ende" );
}

int variablen_setzer()
{
  braut = call_other(HZM, "die_beteiligten", 0);
  brautobj = find_player( lower_case( braut ) );
  braeutigam = call_other(HZM, "die_beteiligten", 2);
  braeutigamobj = find_player( lower_case( braeutigam ) );
  tzeuge = call_other(HZM, "die_beteiligten", 4);
  tzeugeobj = find_player( lower_case( tzeuge ) );
  return 1;
}

//
// Rueckgabewerte:
// 8: Alle fehlen.
// 7: Braut und Braeutigam fehlen.
// 6: Braut und Trauzeuge fehlen.
// 5: Braeutigam und Trauzeuge fehlen.
// 4: Braut fehlt.
// 3: Braeutigam fehlt.
// 2: Trauzeuge fehlt.
// 1: Keine fehlt.
//
int wer_da()
{
  int bf, bm, tz;
  
  // Erst abfragen
       if( member_array(find_player(lower_case(braut)), 
			call_other(HZM,"die_gaeste")) == -1 )
	 bf = 0;
       else bf = 1;
  if( member_array(find_player(lower_case(braeutigam)), 
		   call_other(HZM,"die_gaeste")) == -1 )
    bm = 0;
  else bm = 1;
  if( member_array(find_player(lower_case(tzeuge)), 
		   call_other(HZM,"die_gaeste")) == -1 )
    tz = 0;
  else tz = 1;
  // Dann Ergebnis ausspucken.
       if( call_other(HZM,"gaeste_liste") == 0 || 
	   call_other(HZM,"gaeste_liste") == "" ) return 8;
  if( bf == 0 && bm == 0 && tz == 0 ) return 8;
  if( bf == 0 && bm == 0 && tz == 1 ) return 7;
  if( bf == 0 && bm == 1 && tz == 0 ) return 6;
  if( bf == 1 && bm == 0 && tz == 0 ) return 5;
  if( bf == 0 && bm == 1 && tz == 1 ) return 4;
  if( bf == 1 && bm == 0 && tz == 1 ) return 3;   
  if( bf == 1 && bm == 1 && tz == 0 ) return 2;
  if( bf == 1 && bm == 1 && tz == 1 ) return 1;
  return 0;
}

jetzt_gehts_lohos()
{
  int werda;

  variablen_setzer();  
  werda = wer_da();
  if( werda == 9 )
    {
      tell_room( HZROOM("z_100_standard"), 
		 "HUCH!\n" );
      call_out( "jetzt_gehts_lohos", 15 );
      return 0;
      
    }
  if( werda == 8 )
    {
      tell_room( HZROOM("z_100_standard"), 
		 "Der Beamte schaut erst auf die Uhr, murmelt etwas ueber "
		 + "Puenktlichkeit\n" );
      call_out( "jetzt_gehts_lohos", 15 );
      return 0;
    }
  else if( werda == 7 )
    {
      tell_room( HZROOM("z_100_standard"),
		 "Der Beamte nickt dem Trauzeugen zu, sucht aber weiter nach "
		 + "dem Brautpaar.\n" );
      call_out( "jetzt_gehts_lohos", 15 );
      return 0;
    }
  else if( werda == 6)
    {
      tell_room( HZROOM("z_100_standard"),
		 "Der Beamte nickt dem Braeutigam zu, wartet aber noch auf "
		 + "die Braut und den Trauzeugen.\n" );
      call_out( "jetzt_gehts_lohos", 15 );
      return 0;
    }
  else if( werda == 5)
    {
      tell_room( HZROOM("z_100_standard"),
		 "Der Beamte laechelt die Braut an, wartet aber noch auf den "
		 + "Braeutigam und den Trauzeugen.\n" );
      call_out( "jetzt_gehts_lohos", 15 );
      return 0;
    }
  else if( werda == 4)
    {
      tell_room( HZROOM("z_100_standard"),
		 "Der Beamte nickt Braeutigam und Trauzeuge zu, wartet aber "
		 + "noch auf die Braut.\n" );
      call_out( "jetzt_gehts_lohos", 15 );
      return 0;
    }
  else if( werda == 3)
    {
      tell_room( HZROOM("z_100_standard"),
		 "Der Beamte nickt Braut und Trauzeuge zu, wartet aber noch "
		 + "auf den Braeutigam.\n" );
      call_out( "jetzt_gehts_lohos", 15 );
      return 0;
    }
  else if( werda == 2)
    {
      tell_room( HZROOM("z_100_standard"),
		 "Der Beamte laechelt das Brautpaar an, wartet aber noch auf "
		 + "den Trauzeugen.\n" );
      call_out( "jetzt_gehts_lohos", 15 );
      return 0;
    }
  else if( werda == 1)
    {
      tell_room( HZROOM("z_100_standard"),
		 "Der Beamte schaut auf und sagt: Ah, sehr gut. Da wir ja "
		 + "jetzt alle versammelt\n"
		 +"Der Beamte schaut auf und sagt: sind koennen wir ja "
		 + "beginnen.\n"
		 );
      call_other( HZM, "wo_sind_wir", 102 );
      return call_out( "std01", 5);
    }
  return 0;
}

std01()
{
  tell_room( HZROOM("z_100_standard"),
	     BS("Der Standesbeamte verkuendet:\n"
	     "Wir haben uns heute hier versammelt, um die Hochzeit von " 
	     + braut + " und " + braeutigam + " zu feiern.\n"
	     + "An das Brautpaar und den Trauzeugen gewandt faehrt er fort:\n"
	     + "Ich werde Sie jetzt nacheinander fragen, ob Sie gewillt sind, "
	     + "den jeweils anderen zu ehelichen. Sollten sie noch Bedenken "
	     + "haben, so koennen Sie diese Zeremonie jederzeit mit 'beende "
	     + "hochzeit' abbrechen.\n"
	     + "Wenn Sie beide mit ja geantwortet haben, muss noch der "
	     + "Trauzeuge mit seiner Unterschrift die Richtigkeit der "
	     + "Zeremonie beurkunden. Dann erklaere ich Sie fuer verheiratet "
	     + "und ueberreiche Ihnen jeweils eine Ausfertigung des "
	     + "Trauscheines.\n")
	     );
  return call_out( "std02", 7);
}

std02()
{
  call_other( HZM, "wo_sind_wir", 103 );
  tell_object( brautobj,
       	      BS("Der Standesbeamte schaut Dich ernst an und fragt Dich:\n" 
	      + "Wollen Sie, " + braut + ", den hier anwesenden " + braeutigam
	      + " zu ihrem rechtmaessig angetrauten Ehemann nehmen, so "
	      + "antworten Sie laut und vernehmlich mit 'ja'.\n")
	      );
  tell_room( HZROOM("z_100_standard"),
	     BS("Der Standesbeamte schaut " + braut + " ernst an und fragt "
	     + "sie: \n"
	     + "Wollen Sie, " + braut + ", den hier anwesenden " + braeutigam
	     + " zu ihrem rechtmaessig angetrauten Ehemann nehmen, so "
	     + "antworten Sie laut und vernehmlich mit 'ja'.\n"),
	     ({ find_player( lower_case(braut) ) })
	     );
  return 1;
}

std03()
{
  call_other( HZM, "wo_sind_wir", 104 );
  tell_object( braeutigamobj,
	      BS("Der Standesbeamte schaut Dich ernst an und fragt Dich:\n" 
	      + "Wollen Sie, " + braeutigam + ", die hier anwesende " + braut
	      + " zu ihrer rechtmaessig angetrauten Ehefrau nehmen, so "
	      + "antworten Sie laut und vernehmlich mit 'ja'.\n")
	      );
  tell_room( HZROOM("z_100_standard"),
	     BS("Der Standesbeamte schaut " + braeutigam + " ernst an und "
		"fragt ihn: \n"
	      "Wollen Sie, " + braeutigam + ", die hier anwesende " + braut +
	      " zu ihrer rechtmaessig angetrauten Ehefrau nehmen, so "
	      "antworten Sie laut und vernehmlich mit 'ja'.\n"),
	     ({ find_player( lower_case(braeutigam) ) })
	     );
  return 1;
}


std04()
{
  call_other( HZM, "wo_sind_wir", 105 );
  tell_room( HZROOM("z_100_standard"),
	     BS("Der Standesbeamte wendet sich an " + tzeuge + " und bittet "
	     + tzeugeobj->QueryPronoun( WEN) + ", den ordnungsgemaessen "
	      "Ablauf der Hochzeit durch " 
	     + tzeugeobj->QueryPossPronoun( FEMALE, WEN, SINGULAR ) 
	     + " Unterschrift zu bezeugen.\n")
	     );
  tell_object( tzeugeobj,
	       BS("Der Standesbeamte wendet sich an Dich und bittet Dich, den "
	        "ordnungsgemaessen Ablauf der Hochezeit durch Deine "
	        "Unterschrift auf dem Trauschein zu bezeugen. Er belehrt "
	        "Dich dabei darueber, dass eine Luege hierbei schwerwiegende "
	        "Folgen haben koennte und dass die Syntax 'unterschreibe "
	        "trauschein' sei.\n")
	       );
  return 1;
}

std05()
{
  call_other( HZM, "wo_sind_wir", 110 );
  brautobj->SetMarried(braeutigam+" ("+dtime()+")");
  braeutigamobj->SetMarried(braut+" ("+dtime()+")");
  tell_room( HZROOM("z_100_standard"),
	     BS("Der Standesbeamte raeuspert sich und verkuendet dann, dass "
	     + braut + " und " + braeutigam + " nun verheiratet sind.\n"
	     "Laechelnd fordert er das Paar auf, sich zu kuessen.\n"),
	     ({ brautobj, braeutigamobj })
	     );
  tell_object( brautobj,
	       "Der Standesbeamte erklaert euch fuer verheiratet.\n"
	       "Laechelnd fordert er euch auf, euch zu kuessen.\n"
	       );
  tell_object( braeutigamobj,
	       "Der Standesbeamte erklaert euch fuer verheiratet.\n"
	       "Laechelnd fordert er euch auf, euch zu kuessen.\n"
	       );
  domainshout( 
      BS("Ueber der Pier steigt eine Rakete auf. Als sie explodiert faerbt "
        "sich der Himmel fuer einen Moment rotgolden. Vor diesem "
        "Hintergund erscheinen ploetzlich in zierlicher Schrift "
        "zwei Namen: " + braut + " und " + braeutigam +
        ". Offensichtlich haben die beiden sich gerade das Ja-Wort "
        "gegeben.\n" ),
       ({"wasser", "ebene", "huegelland", "kristallwald",
         "gebirge", "wueste", "seher"}) );
  call_out( "std06", 10 );
  return 1;
}

std06()
{
object schein1, schein2;

  call_other( HZM, "wo_sind_wir", 120 );
  say( BS("Der Standesbeamte setzt ebenfalls seine Unterschrift unter den "
      "Trauschein, schaut ihn kurz sehr konzentriert an und haelt "
      "ploetzlich zwei identische Exemplare in der Hand.\n"
      "Davon uebergibt er jeweils einen an " + braut + " und "
      + braeutigam + ".\n")
     );
  schein1=clone_object( HZOBJ("trauschein"));
  schein1->move(brautobj);
  schein1->SetProp( P_AUTOLOADOBJ, ([ "partner": lower_case(braeutigam),
				     "datum": time(),
				     "zeuge": lower_case(tzeuge) ]) );
  schein2=clone_object( HZOBJ("trauschein"));
  schein2->move( braeutigamobj );
  schein2->SetProp( P_AUTOLOADOBJ, ([ "partner": lower_case(braut),
				     "datum": time(),
				     "zeuge": lower_case(tzeuge) ]) );
  call_out( "std07", 5 );
  return 1;
}

std07()
{
  string eintragung, tag, datum, rest, zeit;
  
  call_other( HZM, "wo_sind_wir", 111 );
  zeit = dtime(time());
  sscanf(zeit, "%s,%s,%s",tag,datum,rest);
  say( BS("Der Standesbeamte konzentriert sich einen Moment und erklaert "
	  + "dann, dass das Brautpaar nun auch offiziell ins "
	  + "Hochzeitsverzeichnis eingetragen wurde.\n") );
  eintragung = ( "Am " + tag + ", " + datum + " haben " + braut + " und " 
		 + braeutigam + " im Standesamt geheiratet.\n" );
  write_file( HZVERZ, eintragung );
  call_out( "std08", 10 );
  return 1;
}

std08()
{
  call_other( HZM, "wo_sind_wir", 199 );
  say( BS("Der Standesbeamte erklaert, dass die Zeremonie jetzt beendet ist, "
       + "aber alle Anwesenden gerne eingeladen sind, noch ein Weilchen "
       + "hier zu bleiben und zu feiern.\n") );
  call_other( HZM, "beende_hochzeit", "\nHochzeiter" );
  return 1;
}


Unterschrift( string str )
{
  notify_fail( "Der Beamte fragt Dich: Was genau willst Du unterschreiben?" );
  if( !str ) return 0;
  if( str != "trauschein" && str != "urkunde" ) return 0;

  notify_fail( "Der Beamte schaut Dich stirnrunzelnd an und fragt: "
	       + "Was hast Du damit zu tun?\n" );
  if( TP != tzeugeobj ) return 0;

  notify_fail( "Der Beamte sagt: Pssst, nicht jetzt!\n" );
  if( call_other( HZM, "wo_sind_wir", -1 ) != 105 ) return 0;
  write( BS("Du setzt schwungvoll Deine Unterschrift unter das Dokument, das "
	 + "der Standesbeamte Dir vorlegt.\n") );
  say( BS(tzeuge + " setzt schwungvoll " 
       + tzeugeobj->QueryPossPronoun( FEMALE, WEN, SINGULAR )
       + " Unterschrift unter das Dokument, das der Beamte "
       + tzeugeobj->QueryPronoun( WEM ) + " vorlegt.\n"),
       tzeugeobj );
  call_out( "std05", 5 );
  return 1;

}

catch_tell( string str )
{
  string who, what;
  
  
  if( !str ) return ::catch_tell(str);
  if( call_other( HZM, "wo_sind_wir", -1 ) < 100 ) return ::catch_tell(str);
  
  variablen_setzer();  // nur ausfuehren, wenn auch wirklich eine hochzeit ist [Feyaria]
  // Frage an die Braut.
       if( call_other( HZM, "wo_sind_wir", -1 ) == 103 )
	 {
	   if( sscanf( str, "%s antwortet Dir: %s\n", who, what ) == 2 )
	     {
	       if( TP == brautobj )
		 {
		   if( lower_case(what) != "ja" && lower_case(what) != "ja!" )
		     {
		       write( BS("Huch, nicht? Vielleicht hast Du Dich ja nur "
				 + "geirrt. Also frag ich einfach "
				 + "nochmal...\n" ));
		       return call_out( "std02", 2 );
		     }
		   write( "Der Beamte nickt Dir zufrieden zu.\n" );
		   say( "Der Beamte nickt " + braut + " zufrieden zu.\n",
			brautobj );
		   return call_out( "std03", 5 );
		 }
	       else
		 {
		   write( BS("Der Beamte schaut Dich boese an.\n") );
		   return;
		 }
	     }
	 }
  // Frage an den Braeutigam.
       if( call_other( HZM, "wo_sind_wir", -1 ) == 104 )
	 {
	   if( sscanf( str, "%s antwortet Dir: %s\n", who, what ) == 2 )
	     {
	       if( TP == braeutigamobj )
		 {
		   if( lower_case(what) != "ja" && lower_case(what) != "ja!" )
		     {
		       write( BS("Huch, nicht? Vielleicht hast Du Dich ja nur "
				 + "geirrt. Also frag ich einfach "
				 + "nochmal...\n" ));
		       return call_out( "std03", 2 );
		     }
		   write( "Der Beamte nickt Dir zufrieden zu.\n" );
		   say( "Der Beamte nickt " + braeutigam + " zufrieden zu.\n",
			braeutigamobj );
		   return call_out( "std04", 5 );
		 }
	     }
	   else
	     {
	      write( BS("Der Beamte schaut Dich boese an.\n") );
	      return;
	     }
	 }
  
  return ::catch_tell(str);              
}

int HZ_ende( string str )
{
string what;
int why;

 if( sscanf( str, "%s", what ) != 1 || what != "hochzeit" )
   {
     say( "Der Standesbeamte spricht kurz mit " + TPNAM + ".\n", TP );
     write( 
	   "Der Beamte fragt Dich: Wollen Sie eine Hochzeit abbrechen? Dann "
	   + "probieren Sie es\n"
	   + "Der Beamte fragt Dich: doch mal mit 'beende hochzeit'.\n"
	   );
     return 1;
   }
 else
   {
     why = call_other( HZM, "beende_hochzeit", TPNAM );
     
     if( why == 1)
       {
	 say( "Der Standesbeamte nickt und sieht dabei etwas betruebt aus.\n",
	      TP );
	 write( "Der Standesbeamte nickt und sagt: OK, die Hochzeit ist "
		+ "storniert.\n" );
	 this_object()->StopHuntingMode();
	 return 1;
       }
     else if( why == 2 )
       {
	 say( "Der Standesbeamte schaut " + TPNAM + " etwas verwundert an.\n",
	      TP );
	 write( "Der Standesbeamte schaut Dich verwundert an.\n"
      		+ "Der Standesbeamte sagt: Aber es ist doch gar keine "
		+ "Hochzeit geplant.\n"
		);
	 return 1;
       }
     else if( why == 3 )
       {
	 say( "Der Standesbeamte faehrt " + TPNAM + " boese an.\n", TP );
	 write( "Der Standesbeamte schnautzt Dich an: Was geht Dich denn "
		+ "diese Hochzeit an?\n" );
	 return 1;
       }
     return 1;
   }
}

int aufhoeren()
{
  while (remove_call_out("jetzt_gehts_lohos") != -1);
  while (remove_call_out("std01") != -1);
  while (remove_call_out("std02") != -1);
  while (remove_call_out("std03") != -1);
  while (remove_call_out("std04") != -1);
  while (remove_call_out("std05") != -1);
  return 1;
}

void reset()
{
  ::reset();
  if(!is_clone(this_object())) return;

  TO->StopHuntingMode();
  call_other( HZM, "keine_stoerer_mehr");
  return;
}
