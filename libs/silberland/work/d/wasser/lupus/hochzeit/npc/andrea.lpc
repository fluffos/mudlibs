inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../hochzeit.h"

string frage_nach_trauschein();

int welche_hz, i;

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Andrea");
  SetProp(P_LONG, "Die Empfangsdame Andrea.\n");
  SetProp(P_NAME, "Andrea");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "dame", "empfangsdame", "andrea" }) );
  create_default_npc( 50 );
  SetProp(P_BODY, 100);
  SetProp(P_HANDS, ({" mit ihren Haenden", 55}));
  SetProp(P_ALIGN, 300);
  SetProp(P_RACE, "Mensch");
  SetProp(P_XP, 0);
  SetProp(P_ARTICLE, 0);
  seteuid(getuid(this_object()));
  set_living_name( "andrea" );

  AddInfo( ({ "hochzeit", "heirat", "heiraten", "hilfe", "information",
		"informationen" }),
	   "@@HZInfo@@",
	   "sagt: " );
  AddInfo( ({ "zeremonie", "zeremonien" }),
	   "Es gibt folgende Zeremonien:\n" + zeremonien(),
	   "antwortet: " );
  AddInfo( ({ "1", "standesamt", "standesamtlich", "zeremonie 1",
		"standesamtlicher hochzeit" }),
	   "Die standesamtliche Zeremonie ist eine schlichte Hochzeit. "
	   + "Es gibt "
	   + "eine Braut, einen Braeutigam und einen Trauzeugen. Sie findet "
	   + "gleich hier, in der Dachstube der Pier statt.",
	   "antwortet: " );

  // Zusaetzliche Infos vom 30.09.1997;

  AddInfo( ({ "empfang", "arbeitsplatz" }),
	   "Hier bin ich und hier bleibe ich. Und ab und zu arbeite ich hier "
	   + "auch.",
	   "antwortet laechelnd: " );
  AddInfo( "lupus",
	   "Das ist mein Chef. Wenn was schief geht kannst Du es ihm in "
	   + "die Schuhe schieben. Obwohl, wenn ichs mir recht ueberlege "
	   + "laeuft er meistens barfuss rum...",
	   "antwortet: " );
  AddInfo( "name",
	   "Mein name ist Andrea.",
	   "antwortet: " );
  AddInfo( "andrea",
	   "Das ist mein Name.",
	   "schaut Dich geduldig an und sagt: " );
  AddInfo( "pier",
	   "Die Pier ist ein schoener Arbeitsplatz.",
	   "antwortet: " );

  // Zusaetzliche Infos vom 22.02.1998

  AddInfo( "arbeit",
	   "Ich bin dafuer Zustaendig, diejenigen, die heiraten wollen "
	   + "mit den notwendigen Informationen zu versorgen.",
	   "antwortet: ");
  AddInfo( "angaben",
	   "Damit ich alles organisiern kann muss ich verschiedenes wissen. "
	   + "Vor allem natuerlich, wer ueberhaupt das glueckliche Paar ist.",
	   "antwortet: ");

  // Zusaetzliche Infos vom 16.10.2003 (Cirion)

  AddInfo( ({"trauschein"}), #'frage_nach_trauschein, "sagt: ");
  
  // Zusaetzliche Infos vom 21.06.2004 (Malar)
  
  AddInfo( ({"zeuge", "trauzeuge", "zeugin", "trauzeugin"}),
    "Ich bin mit jedem Trauzeugen einverstanden!",
    "erklaert: ");

  SetProp(P_LOG_INFO, "lupus.andrea");

  // Besondere Kampffaehigkeiten der Empfangsdame;

  SetAttackChats( 99, ({ "@@schmeiss_feind_raus@@" }) );

  AddCmd( ({ "bestell", "bestelle" }), "AUF_Bestell" );
  AddCmd( "beende", "HZ_ende" );
  AddCmd( CMD_GEBEN, "gib_mir");

  // noattack, 5.11.2004 Feyaria
  SetProp(P_NOATTACK, "laesst sich nicht von Dir bei der Hochzeitsfeier stoeren.");
}

//Hier werden erstmal Feinde so behandelt wie es sich gehoert.
string schmeiss_feind_raus()
{
  object feind;

  feind = QueryEnemy();
  if( !feind ) feind = TP;
  if( feind )
    {
      tell_object( feind, "Die Empfangsdame schmeisst Dich raus.\n" );
      tell_room( environment(TO), "Die Empgangsdame schmeisst jemanden "
		 + "raus.\n" );
      feind->StopHuntingMode(this_object());
      this_object()->StopHuntingMode(feind);
      this_object()->heal_self(100);
      feind->move( HZAUS, M_TPORT | M_SILENT );
      call_other( HZOBJ("secure/hzmaster"), "neuerstoerer", feind );
      return "";
    }
  return "";
}

//Hier werden Fragen nach dem Trauschein beantwortet
string frage_nach_trauschein()
{
  return "Der Trauschein ist das Dokument, welches die geschlossene "
         "Ehe bezeugt.";

  if (!this_player())
  {
    return "Der Trauschein ist das Dokument, welches die geschlossene "
           "Ehe bezeugt.";
  }
  else if (present("\ntrauschein", this_player()))
  {
    if (!this_player()->QueryProp(P_MARRIED))
      return "";
  }

}

int gib_mir(string str)
{
  string wem, was;
  mapping info;
  object schein;

  if (!str || sscanf(str, "%s %s", wem, was) != 2)
    return 0;

  if (!id(wem))
    return 0;

  schein = present(was, this_player());
  if (objectp(schein) && schein->id("\ntrauschein"))
  {
    tell_object(this_player(), break_string(
      "Du gibst Andrea Deinen Trauschein. Sie schaut ihn, schaut dann Dich "
      "an und beginnt in ihrem Hochzeitsverzeichnis zu blaettern..."));
    tell_room(environment(), break_string(
      this_player()->Name()+" gibt Andrea einen Trauschein. Sie beginnt in "
      "ihrem Hochzeitsverzeichnis zu blaettern..."), ({this_player()}));
    if ( (info = schein->QueryProp(P_AUTOLOADOBJ))
      && this_player()->QueryProp(P_MARRIED)
      && (info["partner"] == this_player()->QueryProp(P_MARRIED)) )
    {
      tell_room(environment(), break_string(
          "Ah, hier ist es. Mit dem Trauschein ist doch alles in Ordnung!",
          78, "Andrea sagt: "));
      tell_object(this_player(), break_string(
        "Andrea gibt Dir Deinen Trauschein zurueck."));
      tell_room(environment(), break_string(
        "Andrea gibt "+this_player()->name(WEM)+" "+
        this_player()->QueryPossPronoun(MALE, WESSEN, SINGULAR)+
        " Trauschein zurueck."), ({this_player()}));
    }
    else
    {
      tell_room(environment(), break_string(
          "Der Trauschein ist wohl nicht mehr gueltig. Ich werde ihn "
          "entsorgen.", 78, "Andrea sagt: ")+
        break_string(
          "Andrea zerreisst den Trauschein und laesst die Schnipsel "
          "verschwinden."));
      schein->remove(1);
    }
    return 1;
  }
  return 0;
}

//
//Hier geht es mit der Hochzeit so richtig los!
//


string zeremonien()
{
  return( "1. Standesamtliche Hochzeit\n");
}

string HZInfo( string str )
{
  object ob;

  if( present( "HZZettel", TP ) )
    return("Sie haben schon einen Zettel, auf dem alle wichtigen "
	   + "Informationen ueber das Heiraten enthalten sind. Wenn "
	   + "Sie allerdings mehr ueber eine einzelne Zeremonie oder "
	   + "die Voraussetzungen, die Sie als Trauzeuge mitbringen "
	   + "muessen wissen wollen, frage sie mich ruhig." );
  ob=clone_object(HZOBJ("zettel"));
  ob->move(TP, M_NOCHECK );
  write("Andrea gibt Dir einen Zettel.\n");
  return "Auf diesem Zettel stehen die wichtigsten Informationen ueber die "
    + "Hochzeit. Wenn Sie weitere Fragen haben fragen Sie ruhig.";
}


int HZ_ende( string str )
{
  string what;
  int why;

  notify_fail("Was willst Du beenden?\n");  // Bugfix Feyaria
  if(!str) return 0;                        // sonst buggt das sscanf

  if( sscanf( str, "%s", what ) != 1 || what != "hochzeit" )
  {
    say( "Andrea spricht kurz mit " + TPNAM + ".\n", TP );
    write(
        "Andrea fragt Dich: Wollen Sie eine Hochzeit abbrechen? Dann "
        + "probieren Sie es\n"
        + "Andrea fragt Dich: doch mal mit 'beende hochzeit'.\n"
        );
    return 1;
  }
  else
  {
    why = call_other( HZM, "beende_hochzeit", TPNAM );

    if( why == 1)
    {
      say( "Andrea nickt und sieht dabei etwas betruebt aus.\n", TP );
      write( "Andrea nickt und sagt: OK, die Hochzeit ist storniert.\n" );
      this_object()->StopHuntingMode();
      return 1;
    }
    else if( why == 2 )
    {
      say( "Andrea schaut " + TPNAM + " etwas verwundert an.\n", TP );
      write( "Andrea schaut Dich verwundert an.\n"
          + "Andrea sagt: Aber es ist doch gar keine Hochzeit geplant.\n"
          );
      return 1;
    }
    else if( why == 3 )
    {
      say( "Andrea faehrt " + TPNAM + " boese an.\n", TP );
      write( "Andrea schnautzt Dich an: Was geht Dich denn diese Hochzeit "
          + "an?\n" );
      return 1;
    }
    return 1;
  }
}

int AUF_Bestell( string str)
{
if( !str )
  {
    write( "Die Empfangsdame fragt Dich: Was willst Du denn "
		 + "bestellen?\n" );
    return 1;
  }
  if( lower_case(str) != "aufgebot" )
    {
      write( "Die Empfangsdame antwortet: Versuchen Sie es doch mal "
	  + "mit 'bestelle aufgebot'.\n");
     return 1;
    }
  if( (call_other(HZM, "ist_hochzeit")) == 1 )
    {
      write( "Die Empfangsdame antwortet: Es laeuft leider schon eine "
	     + "andere Hochzeit.\n" );
      return 1;
    }
  if( call_other( HZM, "der_besteller", "" ) == TPNAM )
    {
      write( "Die Empfangsdame antwortet: Jaja, ich habe ja schon "
	     + "mitgekriegt, dass sie ein\n"
	     + "Die Empfangsdame antwortet: Aufgebot bestellen wollen."
	     + " Beantworten Sie doch\n"
	     + "Die Empfangsdame antwortet: einfach meine Frage.\n" );
      return 1;
    }
  if( call_other( HZM, "der_besteller", "" ) != "" &&
      call_other( HZM, "der_besteller", "" ) != TPNAM )
    {
      write( "Die Empfangsdame antwortet: Es tut mir leid, aber "
	     + call_other( HZM, "der_besteller", "" ) + " ist vor "
	     + "Ihnen \n"
	     + "Die Empfangsdame antwortet: dran.\n" );
      return 1;
    }
  call_other( HZM, "der_besteller", TPNAM );
  call_out( "warten_auf_godot", 300 );
  say( "Die Empfangsdame schaut auf, als " +
       call_other( HZM, "der_besteller", "" ) + " sie anspricht. Sie "
       +"laechelt\n"
       + TPPRO(WEN) + " an und fragt " + TPPRO(WEN) + " dann etwas, was Du "
       +"nicht genau verstehen kannst.\n",
       TP
       );
  write( "Die Empfangsdame laechelt Dich an.\n");
  write( "Die Empfangsdame sagt: Hallo! Mein Name ist Andrea. Rufen Sie mich "
	 + "ruhig beim\n"
	 + "Die Empfangsdame sagt: Vornamen, das machen hier alle.\n"
	 + "Andrea sagt: Damit ich die Hochzeit in die Wege leiten kann muss "
	 + "ich Sie um\n"
	 + "Andrea sagt: ein paar Angaben bitten. Beantworten Sie mir die "
	 + "folgenden\n"
	 + "Andrea sagt: Fragen jeweils mit der Syntax 'antworte andrea xyz'."
	 + " Mit 'beende\n"
	 + "Andrea sagt: hochzeit' koennen Sie jederzeit abbrechen.\n"
	 + "Andrea sagt: Die Hochzeit kann in verschiedenen Stilrichtungen "
	 + "durchgefuehrt\n"
	 + "Andrea sagt: werden. Welche davon wuenschen Sie? (Der "
	 + "Einfachheit halber sagst\n"
	 + "Andrea sagt: Du mir am besten nur die Nummer)\n"
	 + zeremonien() );
  call_other( HZM, "wo_sind_wir", 1 );
  return 1;
}

int gez()
{
  int i, amount;
  object *objs, obj;

  if( call_other( HZM, "welcher_hz_typ", -1 ) == 100 )
    {
      write( "Andrea sagt: Eine Hochzeit im Standesamt ist fuer uns leider "
	     + "immer mit Kosten\n"
	     + "Andrea sagt: verbunden. Deswegen sehen wir uns "
	     + "gezwungen, von Ihnen eine\n"
	     + "Andrea sagt: Gebuehr in Hoehe von 100 Muenzen zu verlangen.\n"
	     );
      say( BS("Andrea erklaert " + TPNAM + " etwas. So, wie " + TPNAM + " das "
	   + "Gesicht verzieht, nimmst Du an, dass es sich um Geld dreht.\n"),
	   TP );

      //Wieviel Geld hat der Mensch ueberhaupt?
	  for ( i = sizeof((objs = deep_inventory(TP)))-1, amount = 0; i >= 0; i-- )
	    if ( objs[i]->id("geld") )
	      amount += objs[i]->QueryProp(P_AMOUNT);

//  Und die entsprechenden Reaktionen.
      if( amount == 0 )
	{
	  write( "Andrea sagt: Es tut mir leid, aber Sie sind leider Pleite\n"
		 + "Andrea sagt: Wenn Sie die Gebuehren nicht zahlen koennen "
		 + "kann ich die\n"
		 + "Andrea sagt: Hochzeit leider nicht einleiten.\n" );
	  say( "Andrea schuettelt wimmelt " + TPNAM + " ab und wendet sich "
	       + "wieder ihren Buechern zu.\n",
	       TP );
	  call_other( HZM, "beende_hochzeit", "\nHochzeiter" );
	  return 1;
	}
      else if( amount < 100 )
	{
	  write( "Andrea sagt: Verzeihung, aber Sie haben leider nur "
		 + to_string(amount) + " Muenzen. Die Gebuehr\n"
		 + "Andrea sagt: fuer die standesamtliche Hochzeit betraegt "
		 + "jedoch 100 Muenzen.\n"
		 + "Andrea sagt: Bitte kommen Sie wieder, wenn Sie die "
		 + "erforderliche Summe\n"
		 + "Andrea sagt: zusammen haben.\n"
		 );
	  say( "Andrea verabschiedet sich von  " + TPNAM + " ab und wendet "
	       + "sich wieder ihren Buechern zu.\n",
	       TP );
	  call_other( HZM, "beende_hochzeit", "\nHochzeiter" );
	  return 1;
	}
      else
	{
	  write( "Andrea haelt die Hand auf, als Du ihr die 100 Muenzen "
		 + "gibst.\n" );
	  TP->AddMoney( -100 );
	  say( TPNAM + " drueckt Andrea ein paar Muenzen in die Hand.\n",
	       TP );
	  say( BS("Andrea steht auf und verkuendet laut, dass "
	       + call_other( HZM, "die_beteiligten", 0 ) + " und "
	       + call_other( HZM, "die_beteiligten", 2 )
	       + " heiraten wollen.\n"
	       + "Dann drueckt sie auf einen kleinen Knopf und du hoerst vom "
	       + "Dach her ein lautes Zischen.\n" ));
	  domainshout( BS("Aus der Richtung in der Du die Pier des Fischerdorfes "
		    + "vermutest siehst Du eine Rakete auf einem hellen "
		    + "Feuerstrahl aufsteigen. Als sie mit einem Knall "
		    + "explodiert kannst Du an einem Schauer aus blauen und "
		    + "weissen Sternen erkennen, dass die Hochzeit, die die "
		    + "Rakete ankuendigt, in der Pier selber stattfinden "
		    + "soll.\n"
		    + "Irgendetwas sagt Dir, dass sich die ganze Geschichte "
		    + "wohl um " + call_other( HZM, "die_beteiligten", 0 )
		    + " und " + call_other( HZM, "die_beteiligten", 2 )
		    + " dreht.\n" ),
              ({"wasser", "ebene", "huegelland", "kristallwald", 
                "gebirge", "wueste", "seher"})
		 );
	  call_other( HZM, "neue_hochzeit", 1 );
	  call_other(HZNPC("stbeamter"), "jetzt_gehts_lohos");
	  call_other(HZM, "wo_sind_wir", 101);
	  return 1;
	}
    }

return 1;
}

warten_auf_godot()
{
  if( call_other( HZM, "ist_hochzeit" ) == 0 )
    {
      this_object()->StopHuntingMode();
      call_other( HZM, "beende_hochzeit", "\nHochzeiter" );
      say( "Die Empfangsdame schuettelt aergerlich den Kopf und schimpft "
	     + "ueber Leute, die Ihr die Zeit stehlen.\n" );
      return 1;
    }
}

catch_tell( str )
{
  string who, what;

  if( !str || !TP )
    return ::catch_tell(str);
  if( TP->QueryGuest())
    return ::catch_tell(str);
  if( sscanf( str, "%s antwortet Dir: %s\n", who, what ) == 2 &&
      who == call_other( HZM, "der_besteller", "" ) )
  {
    //
    // HIER LAUFEN DIE ABFRAGEN UEBER PARTNER ETC. AB
    //

    // Erste Frage: Welche Hochzeit soll ausgewaehlt werden?
    if( (call_other(HZM, "wo_sind_wir", -1 )) == 1 )
  	{
	    if( what == "1" || lower_case(what) == "standesamtlich" )
	    {
	      call_other(HZM, "welcher_hz_typ", 100 );
	      say( "Die Empfangsdame sagt etwas zu " +
		      call_other( HZM, "der_besteller", "" ) + ".\n", ({ TP }) );
	      write( "Andrea antwortet: Eine gute Wahl, " +
		      call_other( HZM, "der_besteller", "" )
		      + ". Sie bekommen also "
		      + "eine\n"
		      + "Andrea antwortet: standesamtliche Trauung.\n" );
	      write( "Andrea fragt Dich: Und wer soll die glueckliche Braut "
		      + "sein?\n" );
	      call_other(HZM, "wo_sind_wir", 2);
	      return ::catch_tell(str);
	    }
	    else
	    {
	      say( "Die Empfangsdame schuettelt den Kopf und fragt " +
		      call_other( HZM, "der_besteller", "" ) + " etwas.\n", TP );
	      write( "Andrea schuettelt den Kopf.\n"
		      + "Andrea sagt: Eine solche Hochzeitszeremonie befindet "
		      + "sich derzeit nicht im\n"
		      + "Andrea sagt: Angebot. Aber wenn Sie sowas haben "
		      + "wollen schreiben Sie doch einen\n"
		      + "Andrea sagt: Brief an Lupus. Der ist dafuer "
		      + "zustaendig.\n"
		      + "Andrea sagt: Suchem Sie sich bitte eine existierende "
		      + "Zeremonie aus. Hier ist\n"
		      + "Andrea sagt: nochmal die Liste:\n"
		      + zeremonien()
		      );
	      return ::catch_tell(str);
	    }
	  }
    // Wer ist die Braut?
    else if( (call_other(HZM, "wo_sind_wir", -1 )) == 2 )
	  {
	    if( !find_player(lower_case(what)) ||
	      (find_player(lower_case(what))->QueryProp(P_INVIS)) > 0 )
	    {
	      say( "Die Empfangsdame schaut in ein Buch, schuettelt den Kopf "
		   + "und fragt " + call_other( HZM, "der_besteller", "" )
		   + " etwas.\n", TP );
	      write( "Andrea sucht etwas in einem grossen Buch. Als sie "
		     + "erfolglos bleibt schaut sie\n"
		     + "Dich an.\n"
		     + "Andrea sagt: Eine Spielerin namens " + what
		     + " kann ich nicht finden. Aber \n"
		     + "Andrea sagt: vielleicht hatte ich mich ja verhoert? "
		     + "Kannst Du den Namen nochmal\n"
		     + "Andrea sagt: buchstabieren?\n"
		     );
	      return ::catch_tell(str);
	    }
	    else if( find_player(lower_case(what))->QueryProp(P_GENDER) < 2 )
	    {
	      say( "Die Empfangsdame schuettelt missbilligend den Kopf und "
		   + "sagt etwas zu " + call_other( HZM, "der_besteller", "" )
		   + ".\n",
		   TP );
	      write( "Andrea schuettelt missbilligend den Kopf.\n"
		     + "Andrea sagt: Das Wort 'die' in 'die Braut' weisst auf "
		     + "weibliches Geschlecht\n"
		     + "Andrea sagt: hin. Also wen meinst Du wirklich?\n"
		     );
	      return ::catch_tell(str);
	    }
	    else if( find_player(lower_case(what))->QueryProp(P_LEVEL) < 6 )
	    {
	      say( "Die Empfangsdame schuettelt bedauernd den Kopf und "
		   + "spricht kurz mit "
		   + call_other( HZM, "der_besteller", "" ) + ".\n",
		   TP );
              write(break_string(
                "Es tut mir leid, aber die Braut muss mindestens den "
                "Spielerlevel 6 erreicht haben. Schliesslich ist eine "
                "gewisse Reife meiner Meinung nach eine Voraussetzung "
                "fuer eine Ehe.", 78 ,"Andrea sagt: "));
                //Spielerlevel 6 erforderlich(21.06.2004 by Malar)
	    }
	    else if( find_player(lower_case(what))->QueryProp( P_MARRIED ) != 0 )
	    {
	      say( "Die Empfangsdame schuettelt missbilligend den Kopf und "
		   + "sagt etwas zu " + TPNAM + ".\n", TP );
	      write( BS("Andrea schuettelt SEHR missbillgend den Kopf und "
			+ "fragt Dich, was denn der momentane Ehemann von "
			+ what + " dazu sagt.\n")
		     + "Andrea fragt Dich nochmal nach dem Namen der Braut.\n"
		     );
	      return ::catch_tell(str);
	    }
	    else if( find_player(lower_case(what)) )
	    {
	      call_other(HZM, "wer_beteiligt", capitalize( what ) );
	      say( "Die Empfangsdame nickt zufrieden und fragt " +
		   call_other( HZM, "der_besteller", "" ) + " wieder etwas.\n",
		   TP );
	      write(  "Andrea nickt und fragt: Gut. Und wer ist der "
		      + "Braeutigam?\n" );
	      call_other(HZM, "wo_sind_wir", 4);
	      return ::catch_tell(str);
	    }
	  }
    // Und wer ist der Braeutigam?
    else if( (call_other(HZM, "wo_sind_wir", -1 )) == 4 )
	  {
	    if( !find_player(lower_case(what)) ||
	      (find_player(lower_case(what))->QueryProp(P_INVIS)) > 0 )
	    {
	      say( "Die Empfangsdame schaut in ein Buch, schuettelt den Kopf "
		   + "und fragt " + call_other( HZM, "der_besteller", "" )
		   + " etwas.\n",
		   TP );
	      write( "Andrea sucht etwas in einem grossen Buch. Als sie "
		     + "erfolglos bleibt schaut sie\n"
		     + "Dich an.\n"
		     + "Andrea sagt: Einen Spieler namens " + what
		     + " kann ich nicht finden. Aber \n"
		     + "Andrea sagt: vielleicht hatte ich mich ja verhoert? "
		     + "Kannst Du den Namen nochmal\n"
		     + "Andrea sagt: buchstabieren?\n"
		     );
	      return ::catch_tell(str);
	    }
	    else if( find_player(lower_case(what))->QueryProp(P_GENDER) != 1 )
	    {
	      say( "Die Empfangsdame schuettelt missbilligend den Kopf und "
		   + "sagt etwas zu " + call_other( HZM, "der_besteller", "" )
		   + ".\n",
		   TP );
	      write( "Andrea schuettelt missbilligend den Kopf.\n"
		     + "Andrea sagt: Das Wort 'der' in 'der Braeutigam' "
		     + "weisst auf maennliches\n"
		     + "Andrea sagt: Geschlecht hin. Also wen meinst Du "
		     + "wirklich?\n"
		     );
	      return ::catch_tell(str);
	    }
	    else if( find_player(lower_case(what))->QueryProp( P_MARRIED ) != 0 )
	    {
	      say( "Die Empfangsdame schuettelt missbilligend den Kopf und "
		   + "sagt etwas zu " + TPNAM + ".\n", TP );
	      write( BS("Andrea schuettelt SEHR missbillgend den Kopf und "
			+ "fragt Dich, was denn die momentane Ehefrau von "
			+ what + " dazu sagt.\n")
		     + "Andrea fragt Dich noch einmal nach dem Namen des "
		     + "Braeutigams.\n" );
	      return ::catch_tell(str);
	    }
	    else if( find_player(lower_case(what))->QueryProp(P_LEVEL) < 6 )
	    {
	      say( "Die Empfangsdame schuettelt bedauernd den Kopf und "
		   + "spricht kurz mit "
		   + call_other( HZM, "der_besteller", "" ) + ".\n",
		   TP );
              write(break_string(
                "Es tut mir leid, aber der Braeutigam muss mindestens den "
                "Spielerlevel 6 erreicht haben. Schliesslich ist eine "
                "gewisse Reife meiner Meinung nach eine Voraussetzung "
                "fuer eine Ehe.", 78 ,"Andrea sagt: "));
                //Spielerlevel 6 erforderlich(21.06.2004 by Malar)
	    }
	    else if( find_player(lower_case(what)) )
	    {
	      call_other(HZM, "wer_beteiligt", capitalize( what ) );
	      say( "Die Empfangsdame nickt zufrieden und fragt " + TPNAM
		   + " wieder etwas.\n",
		   TP );
	      write(  "Andrea nickt und fragt: Auch gut. Und wer soll der "
		      + "Trauzeuge sein?\n" );
	      call_other(HZM, "wo_sind_wir", 6);
	      return ::catch_tell(str);
	    }
	  }
    // Hier kommt der Trauzeuge...
    else if( (call_other(HZM, "wo_sind_wir", -1 )) == 6 )
	  {
	    if( !find_player(lower_case(what)) ||
	      (find_player(lower_case(what))->QueryProp(P_INVIS)) > 0 )
	    {
	      say( "Die Empfangsdame schaut in ein Buch, schuettelt den Kopf "
		   + "und fragt " + call_other( HZM, "der_besteller", "" )
		   + " etwas.\n",
		   TP );
	      write( "Andrea sucht etwas in einem grossen Buch. Als sie "
		     + "erfolglos bleibt schaut sie Dich an.\n"
		     + "Andrea sagt: Einen Spieler namens " + what
		     + " kann ich nicht finden. Aber \n"
		     + "Andrea sagt: vielleicht hatte ich mich ja verhoert? "
		     + "Kannst Du den Namen nochmal\n"
		     + "Andrea sagt: buchstabieren?\n"
		     );
	      return ::catch_tell(str);
	    }
	    /////////////////////////////////////////
	    //Keine Levelabfrage mehr beim Zeugen!!//
	    /////////////////////////////////////////
	    
	    else if( what == call_other( HZM, "die_beteiligten", 0 ) ||
		           what == call_other( HZM, "die_beteiligten", 2 ))
	    {
	      say( "Die Empfangsdame schuettelt bedauernd den Kopf und "
		   + "spricht kurz mit "
		   + call_other( HZM, "der_besteller", "" ) + ".\n",
		   TP );
	      write( "Andrea sagt: Es tut mir leid, aber der Trauzeuge darf "
		     + "weder die Braut, noch\n"
		     "Andrea sagt: der Braeutigam sein.\n"
		    );
	    }

	    else if( find_player(lower_case(what)) )
	    {
	      call_other(HZM, "wer_beteiligt", capitalize( what ) );
	      say( "Wieder nickt die Empfangsdame zufrieden.\n", TP );
	      write( "Andrea nickt Dir zu und sagt: OK, dann habe ich alle "
		     + "erforderlichen Daten.\n"
		     + "Andrea sagt: Eine kleine Formalitaet ist da "
		     + "allerdings noch, bevor wir\n"
		     + "Andrea sagt: Anfangen koennen.\n");
	      call_out( "gez", 5 );
	      return ::catch_tell(str);
	    }
	  }
  }
  return ::catch_tell(str);
}

void reset()
{
  ::reset();
  if(!is_clone(this_object())) return;

  TO->StopHuntingMode();
  call_other( HZM, "keine_stoerer_mehr");
  return;
}
