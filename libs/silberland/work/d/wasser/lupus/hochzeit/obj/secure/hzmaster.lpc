// Master-Objekt fuer die Hochzeit

#include <properties.h>
#include <wizlevels.h>
#include <defines.h>
#include <language.h>
#include "../../hochzeit.h"

object *stoerer, *gast;
string *beteiligte, besteller;
int hochzeit_im_gange, frage, hz_typ, *bb_antwort, i;


void create()
{
   seteuid( getuid ( this_object() ) );

// Initialisierung von ein paar Variablen:
   
   beteiligte = ({ "", "", "", "", "", "" });
   besteller = "";
   frage = 0;
   gast=({});
   
   
}

//
// Hier geht es um den Beginn einer neuen Hochzeitszeremonie
//


int ist_hochzeit()
{
   if( !hochzeit_im_gange ) return 0;
   else if( hochzeit_im_gange == 0 ) return 0;
   else return 1;
}


int neue_hochzeit( string *arr )
{
// Returncodes:
//	0 = Es laeuft bereits eine andere Hochzeit
//	1 = Alles OK
//

   if( hochzeit_im_gange == 1 ) return 0;
   
   hochzeit_im_gange = 1;
   return 1;
}

   

// 
// Ab hier geht es darum, die "Stoerer" zu verwalten.
//

neuerstoerer( object angreifer)
{
   if( !stoerer ) stoerer = ({ angreifer });
   if( stoerer ) 
   {
   	if( member_array( angreifer, stoerer ) == -1)
   	{
   		stoerer = stoerer + ({ angreifer });
   	}
   }
   return 1;
}

werstoert()
{
   return stoerer;
}

int ist_er_stoerer( object eintreter)
{
   if( !stoerer ) return 0;
   if( stoerer == 0 ) return 0;
   if( stoerer )
     {
       if( member_array( eintreter, stoerer ) == -1 )
	 return 0;
     }
   return 1;
}

int keine_stoerer_mehr()
{
  stoerer = 0;
  return 1;
}

//Hier geht die Gaesteverwaltung los.

int neuer_gast( object neuzugang )
{
   if( sizeof(gast) == 0 )
   {
   	gast = ({ neuzugang });
   }
   else if( sizeof(gast) > 0 )
   {
   	gast = gast + ({ neuzugang });
   }
   return 1;
}

int alter_gast( object exitus )
{
   if( sizeof(gast) == 0 ) return 0;
   else if( sizeof(gast) > 0 ) gast = gast - ({ exitus });
   return 1;
}

string gaeste_liste()
{
string gliste;

   i=0;
   gliste="";
   if(sizeof(gast)>0)
   {
   while( i<= (sizeof( gast )-1) )
   {
   	gliste = gliste + to_string( gast[i] );
   	i++;
   }
   }
      
   return gliste;
}

die_gaeste()
{
   return gast;
}

int wo_sind_wir( int j )
{
   if( j == -1)
   	return frage;
   else
   {
   	frage = j;
  	return frage;
  }
}

int welcher_hz_typ( int j )
{
   if( j == -1 ) return hz_typ;
   else hz_typ = j;
   return hz_typ;
}

string wer_beteiligt( string str )
{
string alle;

   i = 0;
   alle = "";
   if( !str )
   {
   	while( i <= 5 ) 
   	{
   	alle = alle + beteiligte[i];
   	i = i + 1;
   	}
   	return alle;
   }
   else if( wo_sind_wir( -1 ) == 2 )
   {
   	beteiligte[0] = str;
   	return "";
   }
   else if( wo_sind_wir( -1 ) == 4 )
   {
   	beteiligte[2] = str;
   	return "";
   }
   else if( wo_sind_wir( -1 ) == 6 )
   {
   	beteiligte[4] = str;
   	return "";
   }
}

die_beteiligten( int j )
{
   return beteiligte[j];
}

string der_besteller( string str )
{
   if( str == "" )
   	return besteller;
   else	besteller = str;
   return besteller;
}

//
// Wenn die Hochzeit doch nicht stattfinden soll....
//
// Returncodes:
// 1: Alles OK, Hochzeit storniert.
// 2: Es laeuft gar keine Hochzeit.
// 3: Der Stornierende darf nicht stornieren.
// 
// 
int beende_hochzeit( string wer )
{
   if( wo_sind_wir( -1 ) == 0 )
   	return 2;
   if( member_array( wer, beteiligte ) == -1 && wer != der_besteller("") 
   	&& wer != "\nHochzeiter" && lower_case(wer) != "lupus" )
   	return 3;
   else 
   {
   	if( welcher_hz_typ( -1 ) == 100 )
   	{
   		call_other( HZNPC("stbeamter"), "aufhoeren" );
   	}
   	wo_sind_wir( 0 );
   	beteiligte = ({ "", "", "", "", "", "" });
   	besteller = "";
   	frage = 0;
   	hochzeit_im_gange = 0;
	stoerer = 0;
   }
   return 1;
}
