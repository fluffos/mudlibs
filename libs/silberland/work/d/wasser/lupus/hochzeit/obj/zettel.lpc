inherit "std/thing";

#include <properties.h>
#include <defines.h>
#include "../hochzeit.h"

create()
{
  if(IS_BLUE(ME)) return;
  ::create();
  SetProp(P_SHORT, "Ein Zettel mit Infos zum Heiraten");
  SetProp(P_LONG,
    "Du haeltst einen grossen Zettel in Deinen Haenden, den Du mit\n"+
    "'lies zettel' lesen kannst.\n");
  SetProp(P_NAME,"Zettel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 1);
  SetProp(P_NOBUY, 1);
  AddId(({ "zettel", "HZZettel" }));
  AddCmd(({ "lies", "lese", "les" }), "lies");
}

lies(str)
{
  notify_fail("Was willst Du lesen ? Syntax: lies <etwas>.\n");
  if (!str) return 0;
  if (!id(str)) return 0;
  say(capitalize(PL->name()) + " liest einen Zettel.\n", PL);
  PL->More( read_file( HZOBJ("zettel.txt") ) );
  return 1;
}

reset()
{
  if(IS_BLUE(ME)) return;
  if(!environment(ME)) return remove();
  if(!interactive(environment(ME)))
  {
    if(IS_BLUE(environment(ME)))
      tell_room(environment(ME), 
      BS("Ein Zettel weint, weil er nicht beachtet wird, ein paar "
       "Traenen aus Salzsaeure und loest sich in ihnen auf."));
    return remove();
  }
  return 1;
}
