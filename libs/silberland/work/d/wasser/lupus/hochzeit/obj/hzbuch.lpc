inherit "std/thing";

#include <properties.h>
#include <defines.h>
#include "../hochzeit.h"

create()
{
  if( !is_clone(this_object())) return;
  ::create();
  seteuid(getuid());
  
  SetProp(P_SHORT, "Das offizielle Heiratsverzeichnis");
  SetProp(P_LONG,
    "In diesem Buch sind alle Hochzeiten verzeichnet, die bisher "
    "von Andrea, der Empfangsdame organisiert wurden.\n"
    "Mit 'lies buch' kannst Du es lesen.");
  SetProp(P_NAME, "Heiratsverzeichnis");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Andrea haut Dir maechtig auf die Finger, als Du "
    "versuchst, ihr Heiratsverzeichnis zu klauen.\n" );
 
  AddId( ({ "heiratsverzeichnis", "verzeichnis", "buch" }) );

  AddCmd(({ "lies", "lese", "les" }), "lies");

}

int lies(string str)
{
  notify_fail("Was willst Du lesen ? Syntax: lies <etwas>.\n");
  if (!str) return 0;
  if (!id(str)) return 0;
  say(capitalize( TPNAM ) + " liest im Heiratsverzeichnis.\n", PL);
  PL->More(read_file(HZOBJ("secure/HZBUCH")));
  return 1;
}

