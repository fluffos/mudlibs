#include "../turan_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "" }),
    BS("")
    );

  AddReadDetail( ({ "" }),
    BS("")
    );

  AddSound( DEFAULT_SOUND,
    BS("")
    );

  AddSound( ({ "" }),
    BS("")
    );

  AddSmell( DEFAULT_SMELL,
    BS("")
    );

  AddSmell( ({ "" }),
    BS("")
    );

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "tue" }), "command" );

  //  AddItem( "item" , REFRESH_DESTRUCT);

  AddExit( "norden", TURROOM("turan-6-0") );
  AddExit( "osten", TURROOM("turan-4-1") );
  AddExit( "sueden", TURROOM("turan-2-0") );
}

command(string str )
{
  notify_fail( "Was willst Du tun?\n" );
  if( str == "tuer" )
  {
    write("Du tust etwas.\n");
    say( TPNAM+" tut etwas.\n");
    return 1;
  }
  return 0;
}
