// Am suedlichen Stadttor.
//
// Erstellt am:          14.02.1999
// Zuletzt geaendert am: 16.03.1999
//

#pragma strong_types

#include <properties.h>
#include <language.h>
#include "../turan_def.h"

inherit TURROOM("turan_outd_std");

void create() {
  ::create();

  SetProp( P_INT_SHORT, "Am suedlichen Stadttor" );
  SetProp( P_INT_LONG,
	   BS("Innerhalb der Stadtmauern tobt das Leben. Ueberall sind "
	      + "Vertreter aller Rassen dabei, Einkaeufe zu taetigen, Waren "
	      + "von hier nach dort zu bringen oder einfach nur eilig von "
	      + "einem Ort zum anderen zu hetzen.\n"
	      + "Das Ambiente fuer all dies Treiben ist ein grossatige Stadt. "
	      + "Alle Gebaeude sind aus dem gleichen Stein gebaut, so dass "
	      + "der Eindruck entsteht, dass die ganze Stadt als ein einziges "
	      + "Projekt geplant und gebaut wurde.\n"
	      + "Von dem kleinen Platz hier am suedlichen Stadttor fuehren "
	      + "drei Strassen in die Stadt. An ihrem Kreuzungspunkt steht "
	      + "ein kleiner Brunnen.")
	   );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "silberland", "welt" }),
	     BS("Ist diese Welt nicht schoen?")
	     );
  AddDetail( ({ "brunnen", "angelegenheit" }),
	     BS("Der Brunnen ist eine achteckige, filigrane Angelegenheit. "
		+ "An den Seiten des Brunnens befinden sich acht "
		+ "Reliefbilder, welche die acht Rassen des Silberlandes "
		+ "darstellen. Dazwischen fliessen acht kleine Wasserstroeme "
		+ "in ein Becken, aus dem die erschoepften Zugtiere, die "
		+ "hier zum Strassenverkehr gehoeren, trinken koennen.")
	     );
  AddDetail( ({ "reliefbilder", "bilder", "bild", "reliefbild", "rassen" }),
	     BS("Die acht grossen Rassen des Silberlandes - Menschen, Elfen, "
		+ "Dunkelelfen, Trolle, Zwerge, Feen, Hobbits und Oger - "
		+ "sind hier dargestellt.")
	     );
  AddDetail( ({ "menschen" }),
	     BS("Das Bild einer gluecklichen Familie erinnert Dich zwar "
		+ "nicht an die Menschen, wie Du sie hier aus dem "
		+ "Silberland kennst, aber vielleicht gibt es solche Leute ja "
		+ "in Turan.")
	     );
  AddDetail( ({ "elfen", "gespraech" }),
	     BS("Am Brunnen sind die grossen Wesen mit den spitzen Ohren im "
		+ "Gespraech dargestellt.")
	     );
  AddDetail( ({ "dunkelelfen" }),
	     BS("Das Reliefbild der Dunkelelfen stellt einen einzelnen, sehr "
		+ "vornehm wirkenden Dunkelelfen dar.")
	     );
  AddDetail( ({ "zwerge", "trolle", "saufgelage", "oger" }),
	     BS("Auf diesem Bild ist ein froehliches Saufgelage zu sehen.")
	     );
  AddDetail( ({ "feen", "flugkuenste" }),
	     BS("Auf dem Relief sind die kleinen Wesen dargestellt, wie sie "
		+ "ihre rudimentaeren Flugkuenste ausprobieren.")
	     );
  AddDetail( ({ "hobbits", "kreis", "gruppe" }),
	     BS("Hier ist eine Gruppe von Hobbits dargestellt, die im Kreis "
		+ "um einen alten Hobbit sitzen, der ihnen anscheinend eine "
		+ "Geschichte erzaehlt.")
	     );
  AddDetail( ({ "ohren" }),
	     BS("Deine eigenen Ohren kannst Du nicht sehen und bei anderen "
		+ "Leuten nachzuschauen, ob ihre Ohren auch sauber sind "
		+ "kommt Dir ein bissel albern vor.")
	     );
  AddDetail( ({ "familie" }),
	     BS("Das Reliefbild, das die Menschen drstellt zeigt eine "
		+ "Familie.")
	     );
  AddDetail( ({ "ambiente", "stadt", "anlage", "fassaden" }),
	     BS("Diese Stadt wurde von jemand geschaffen, der sowohl ueber "
		+ "viel Geld als auch viel Macht verfuegte. Denn nur so "
		+ "konnte eine solch einheitliche Architektur flaechendeckend "
		+ "durchgesetzt werden. Alle Haeuser haben die gleiche "
		+ "Hoehe und gleichfarbige Fassaden, was den Eindruck "
		+ "entstehen laesst, die ganze Stadt sei aus einem einzigen "
		+ "Guss.")
	     );
  AddDetail( ({ "geld" }),
	     BS("Ohne Geld kann man eine solche Anlage nicht realisieren.")
	     );
  AddDetail( ({ "macht" }),
	     BS("Ohne Macht ueber andere kann man eine solche Anlage nicht "
		+ "in einer solch reinen Form realisieren.")
	     );
  AddDetail( ({ "form", "widersprueche" }),
	     BS("Alle Gebaeude sind hier einheitlich. Kriegt man sowas hin, "
		+ "wenn man sich um die Widersprueche jedes Kraemers "
		+ "kuemmern muss?")
	     );
  AddDetail( ({ "haendler", "kraemer" }),
	     BS("An den Waenden der Haeuser stehen die kleinen Buden vieler "
		+ "Haendler, die der vorbeistroemenden Menge das Geld aus der "
		+ "Tasche ziehen wollen.")
	     );
  AddDetail( ({ "buden", "kraemerbuden", "staende", "dach" }),
	     BS("Die Kraemerbuden sind kleine Staende mit Stoffbahnen als "
		+ "Dach.")
	     );
  AddDetail( ({ "architektur" }),
	     BS("Die Architektur der Haeuser Turans ist erstaunlich "
		+ "einheitlich. Wohin man auch blickt sieht man die gleichen "
		+ "Fassaden.")
	     );
  AddDetail( ({ "leben", "wesen", "strassenverkehr", "verkehr", "leute" }),
	     BS("Menschen, Zwerge, Elfen, Hobbits, sogar Trolle, Feen  und "
		+ "Oger bevoelkern die Strassen Turans. Nach den vielen "
		+ "fliegenden Haendlern zu urteilen floriert der Handel.")
	     );
  AddDetail( ({ "menschen" }),
	     BS("Menschen, wie man sie ueberall im SilberLand herumlaufen.")
	     );
  AddDetail( ({ "zwerge" }),
	     BS("Durch ihre geringe Groesse fallen sie weniger auf, aber sie "
		+ "sind da.")
	     );
  AddDetail( ({ "groesse", "stolz" }),
	     BS("Zwerge sind zwar klein, aber ihr Stolz reicht fuer ein Wesen "
		+ "der doppelten Groesse.")
	     );
  AddDetail( ({ "elfen" }),
	     BS("Grossgewachsene Elfen schlendern durch die Strassen und "
		+ "hinterlassen den Eindruck, ueber allem zu stehen.")
	     );
  AddDetail( ({ "stadtmauer", "stadtmauer" }),
	     BS("Die maechtige Stadtmauer Turans erstreckt sich von Osten "
		+ "nach Westen. Du bist froh, dass Du sie nicht erstuermen "
		+ "musst, um aus Turan heraus zu gelangen. Du kannst naemlich "
		+ "einfach das Suedtor Turans verwenden, vor dem Du grade "
		+ "stehst.")
	     );
  AddDetail( ({ "tor", "stadttor", "suedtor" }),
	     BS("Das Suedtor steht zum Hafen Turans hin offen.")
	     );
  AddDetail( ({ "hafen" }),
	     BS("Der Hafen liegt suedlich der Stadtmauern von Turan.")
	     );
  AddDetail( ({ "gebaeude", "haeuser" }),
	     BS("Die Haeuser, die Du von hier aus sehen kannst, sind "
		+ "allesamt aus dem gleichen hellen Stein gebaut. Die "
		+ "Gebaeude hier am Platz sind alle eingeschossig, aber "
		+ "tiefer in der Stadt kannst Du zwei hohe Tuerme "
		+ "und noch dahinter ein maechtiges Gebaeude sehen.")
	     );
  AddDetail( ({ "stein", "sandstein" }),
	     BS("Alle Gebaeude der Stadt scheinen aus dem gleichen, hellen "
		+ "Sandstein gebaut zu sein, was ihr eigentlich eine "
		+ "freundliche Grundstimmung geben sollte. Tatsaechlich wirkt "
		+ "Turan aber eher verschlossen, was zweifellos daran liegt, "
		+ "dass die Haeuser hier nur sehr wenige und ziemlich kleine "
		+ "Fenster haben.")
	     );
  AddDetail( ({ "fenster" }),
	     BS("Fenster siehst Du nur sehr wenige. Das Haus im Nordosten "
		+ "dieses Platzes scheint ueberhaupt keine Fenster zu haben. "
		+ "Dafuer siehst Du dort ueber der Tuer ein Relief.")
	     );
  AddDetail( ({ "relief", "drache" }),
	     BS("Das Relief stellt einen Drachen dar.")
	     );
  AddSound( ({ DEFAULT_SOUND, "menge" }),
    BS("Du bist von einer Wolke aus Gespraechen, Lachen, Raederknirschen und "
       + "Hundegebell umgeben.")
    );
  AddSound( ({ "wolke" }),
    BS("Eine der hervorragendsten Eigenschaften von Wolken ist es, lautlos zu "
       + "sein. Deswegen kannst Du auch keine Wolke hoeren. Du bist bloss von "
       + "einer Wolke aus Geraeuschen umgeben.")
    );
  AddSound( ({ "gespraeche", "gemurmel" }),
	     BS("Nur Fetzen der Gespraeche, die in Deiner Naehe gefuehrt "
		+ "werden, dringen an Dein Ohr:\n"
		+ "´...sind schon wieder teurer geworden...´\n"
		+ "´Hast Du schon...´\n"
		+ "´KOMM HER DU ROTZLOEFFEL!´")
	     );
  AddDetail( ({ "rotzloeffel" }),
	     BS("Amuesiert schaust Du zu, wie ein aelterer Mann einem Jungen "
		+ "hinterherschimpft, der zu seinem Glueck schon einen "
		+ "uneinholbaren Vorsprung hat.")
	     );
  AddSound( ({ "lachen" }),
	     BS("Von irgendwoher aus der Menge hoerst Du lautes Lachen, das "
		+ "aber schnell wieder im allgemeinen Gemurmel untergeht.")
	     );
  AddDetail( ({ "raederknirschen", "knirschen" }),
	     BS("Die mit Waren beladenen Karren knirschen auf "
		+ "unverwechselbare Weise, als sie an Dir vorueberrollen.")
	     );
  AddDetail( ({ "hundegebell", "gebell", "hunde" }),
	     BS("Ueber das allgemeine Gemurmel hoerst Du immer wieder das "
		+ "Bellen von Hunden.")
	     );



  AddDetail( 
	    ({ 
    "geschichte", "glueck", "eindruck", "grundstimmung", "guss", "hoehe", "name"
      }),
	     BS("So etwas kannst Du nicht sehen!")
	     );
  
  AddSmell( DEFAULT_SMELL,
    BS("")
    );

  AddSmell( ({ "" }),
    BS("")
    );

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "tue" }), "command" );

  AddExit( "norden", TURROOM("turan-2-6") );
  AddExit( "osten", TURROOM("turan-0-8") );
  AddExit( "westen", TURROOM("turan-0-4") );
  AddExit( "sueden", TUR_SUED );

  NewDoor( "nordosten", TURROOM("drache-1-7"), ({ "eingangstuer", "tuer" }),
	   ({ 
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_OP,
	       D_LONG, BS("Diese Tuer bringt Dich, wenn sie nicht "
			  + "verschlossen ist, in den ´Gruenen Drachen´. "
			  + "Zum Glueck fuer alle trinkfreudigen "
			  + "Zeitgenossen wird man diese Tuer nur aeusserst "
			  + "selten verschlossen finden."),
	       D_SHORT, "Die Tuer des ´Gruenen Drachen´. (%s)"
	       })
	   );
}

int command(string str )
{
  notify_fail( "Was willst Du tun?\n" );
  if( str == "tuer" )
  {
    write("Du tust etwas.\n");
    say( TPNAM+" tut etwas.\n");
    return 1;
  }
  return 0;
}
