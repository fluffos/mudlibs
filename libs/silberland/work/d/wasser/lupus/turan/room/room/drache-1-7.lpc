// Die Kneipe "Der gruene Drache " in Turan.
//
// Erstellt am:          14.02.1999
// Zuletzt geaendert am: 21.02.1999
//
// Details laut /players/zordan/npc/tester: 123
//

#pragma strong_types

inherit "std/pub";

#include <properties.h>
#include <language.h>
#include "../turan_def.h"

string LetztesDetail, VorLetztesDetail;

void create() 
{
  ::create();
  
  SetProp( P_INT_SHORT, "Im gruenen Drachen" );
  SetProp( P_INT_LONG,
	   BS("Der Eingangstuer gegenueber befindet sich an Kopfseite des "
	      + "Schankraums eine Theke. Hinter ihr stehen in Regalen "
	      + "Flaschen in allen vorstellbaren Formen und Farben. Der Rest "
	      + "des Raumes ist mit einfachen Holztischen und Baenken "
	      + "ausgestattet. Eigentlich waere dies eine Kneipe wie "
	      + "hunderttausend andere auch, wenn da nicht der Drache waere, "
	      + "der ihr den Namen gegeben hat.")
	   );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  
  AddSpecialDetail( "holz", "holz_gucker" );
  AddDetail( ({ "eichenbretter" }),
	     BS("Die Tuer ist aus stabilen Eichenbrettern gezimmert und haelt "
		+ "es schon mal aus, wenn bei einer Pruegelei jemand "
		+ "gegen sie geworfen wird.")
	     );
  AddDetail( ({ "strasse", "westwand" }),
	     BS("Die Westwand des Schankraumes liegt zur Strasse hin. Dort "
		+ "befindet sich auch die Eingangstuer, durch die Du den "
		+ "Drachen verlassen kannst - wenn Du noch nicht zu "
		+ "betrunken bist jedenfalls.")
	     );
  AddDetail( ({ "theke" }),
	     BS("Die Theke ist in einem Etablissement wie diesem primaer dazu "
		+ "da, Leute wie Dich davon abzuhalten, Dich selber an den "
		+ "gut sortierten Getraenkevorraeten zu bedienen. Ob Holz "
		+ "dafuer stabil genug ist?")
	     );
  AddDetail( ({ "ansturm", "troll-kegeclub", "kegelclub" }),
	     BS("So was siehst Du hier nicht. ZUM GLUECK!")
	     );
  AddDetail( ({ "kopfseite", "ostwand", "getraenkevorraete", 
		  "getraenkevorrat" }),
	     BS("An der Kopfseite des Raumes befindet sich hinter der Theke "
		+ "ein grosser Teil des Getraenkevorrats des Drachen. Neben "
		+ "zwei grossen Faessern stehen dort in Regalen viele "
		+ "Flaschen und Karaffen. Und ueber allem trohnt der Drache "
		+ "selbst.")
	     );
  AddDetail( ({ "faesser" }),
	     BS("Bei den Faessern handelt es sich um ein Wein- und ein "
		+ "Bierfass.")
	     );
  AddDetail( ({ "fass" }),
	     BS("Du siehst ein Weinfass und ein Bierfass. Welches willst Du "
		+ "genauer Untersuchen?")
	     );
  AddDetail( ({ "weinfass", "rotweinfass" }),
	     BS("Vor dem Fass hat sich eine kleine, rote Pfuetze gebildet. "
		+ "Du schliesst messerscharf, dass das Fass Rotwein "
		+ "enthaelt.")
	     );
  AddDetail( ({ "rotwein", "pfuetze", "weinpfuetze", "wein" }),
	     BS("In einer kleinen Pfuetze vor dem Rotweinfass haben sich "
		+ "bei zapfen verlorene Tropfen Rotwein gesammelt. Du bist "
		+ "aber sicher, dass man es hier nicht gerne saehe, wenn Du "
		+ "die Pfuetze auflecktest. Und ausserdem: So durstig bist "
		+ "Du auch wieder nicht.")
	     );
  AddDetail( ({ "tropfen" }),
	     BS("Gerade als Du zum Weinfass schaust faellt ein roter Tropfen "
		+ "vom Zapfhahn in die kleine Weinpfuetze am Fussboden.")
	     );
  AddDetail( ({ "zapfhahn", "hahn" }),
	     BS("Du diesen Hahn fliesst die koestliche Fluessigkeit. Ach "
		+ "ginge es Deiner Kehle nur genauso!")
	     );
  AddDetail( ({ "bierfass" }),
	     BS("Den Inhalt des Bierfasses erkennst Du leicht an dem grossen "
		+ "Schriftzug auf der Vorderseite.")
	     );
  AddDetail( ({ "inhalt" }),
	     BS("Du kannst zwar aus dem Schriftzug auf dem Bierfass auf "
		+ "dessen Inhalt schliessen, das heisst aber noch lange "
		+ "nicht, dass Du ihn auch sehen kannst. Durchsichtiges Holz "
		+ "hat naemlich meines Wissens nach die Natur noch nicht "
		+ "hervorgebracht.")
	     );
  AddDetail( ({ "natur" }),
	     BS("Wenn Du Natur sehen willst, solltest Du vielleicht nicht "
		+ "mitten in einer Stadt danach suchen.")
	     );
  AddDetail( ({ "vorderseite", "schriftzug" }),
	     BS("An der Vorderseite des Bierfasses befindet sich ueber dem "
		+ "Zapfhahn eine grosser Schriftzug, den Du lesen kannst.")
	     );
  AddReadDetail( ({ "schriftzug" }),
		 BS("Drachenbraeu - das Bier der Biere")
		 );
  AddDetail( ({ "fluessigkeit" }),
	     BS("Fluessigkeiten gibt es hier genug fuer den, der sie mit "
		+ "klingender Muenze bezahlen kann.")
	     );
  AddDetail( ({ "regal", "regale" }),
	     BS("In einigen Regalen an der Ostwand des Drachen stehen viele "
		+ "Flaschen und Karaffen, deren Anblick allein schon einen "
		+ "angenehmen Abend verspricht.")
	     );
  AddDetail( ({ "flaschen", "farben", "formen", "karaffen", "flaeschchen" }),
	     BS("Hier gibt es Flaschen in allen Farben und Formen. Du siehst "
		+ "bauchige, dunkelgruene Flaschen neben zierlichen, weissen "
		+ "Flaeschchen, in denen eine gelbe Fluessigkeit zu sehen "
		+ "ist. Daneben siehst Du prachtvolle Karaffen, deren Inhalt "
		+ "Du nur erraten kannst.")
	     );
  AddDetail( ({ "drache", "tier" }),
	     BS("Der Drache funkelt Dich mit dunkelroten Augen an. Du "
		+ "erwiderst seinen Blick mit jener Laessigkeit, die Du Dir "
		+ "im Laufe Deiner Abenteuer gegenueber bedrohlichen "
		+ "Gegenstaenden in Kneipen angewoehnt hast. Die Flaschen "
		+ "in den Regalen sind hier allerdings tatsaechlich "
		+ "gefaehrlicher als der Drache. Der ist naemlich nur eine "
		+ "Holzschnitzerei, die sich unter der Decke um den ganzen "
		+ "Raum herum zieht.")
	     );
  AddDetail( ({ "augen" }),
	     BS("Die Augen des Drachen leuchten. Du koenntest schwoeren, dass "
		+ "in ihnen der Funke des Lebens spielt. Aber wie sollte das "
		+ "moeglich sein? Der Drache ist ja nicht echt und die Augen "
		+ "sind nur rote Glasstuecke. Aber seltsam ist es schon.")
	     );
  AddDetail( ({ "funke", "leben", "glasstuecke" }),
	     BS("Du hast den Eindruck, das der Drache Dich mit sehr "
		+ "lebendigen Augen anstarrt, obwohl Du weisst, dass das "
		+ "nicht moeglich ist.")
	     );
  AddDetail( ({ "holzschnitzerei", "werk", "handwerkskunst", "relief" }),
	     BS("Der geschnitze Drache ist wirklich ein beeindruckendes Werk "
		+ "turannischer Handwerkskunst. Der aus einem gruenen Holz "
		+ "geschnitze Drache windet sich unterhalb der Decke einmal "
		+ "um den ganzen Raum. Dabei wirkt er so echt, dass man "
		+ "meinen koennte, er waere dort oben nur fuer eine kurze "
		+ "Zeit eingeschlafen. An einer Stelle ist das wunderbare "
		+ "Tier sogar reliefartig ausgestaltet und windet sich um "
		+ "einen Deckenbalken.")
	     );
  AddDetail( ({ "stelle" }),
	     BS("Dort, wo der Drache sich um den Dachbalken wickelt, kannst "
		+ "Du einen kleinen, schwarzen Punkt erkennen.")
	     );
  AddDetail( ({ "decke", "dach", "hoehe", "zwischendecke" }),
	     BS("Zwischen dem Schankraum und dem spitzgiebligen Dach des "
		+ "Wirtshauses ist keine Zwischendecke eingezogen. "
		+ "Stattdessen halten dicke Holzbalken die Waende auseinander "
		+ "und das Dach in der Hoehe.")
	     );
  AddDetail( ({ "balken", "deckenbalken", "holzbalken", "dachbalken" }),
	     BS("Die Balken halten den ´Gruenen Drachen´ zusammen. Vielleicht "
		+ "wird dadurch, dass sich der Drache einmal um einen der "
		+ "Balken gewickelt hat ja der Dank fuer diesen Dienst "
		+ "symbolisiert? Naja, vielleicht auch nicht. Vielleicht gibt "
		+ "Dir ja der kleine schwarze Punkt, der Dir just an dieser "
		+ "Stelle an der sonst so perfekten, gruenen ´Haut´ des "
		+ "Drachen Aufschluss darueber.")
	     );
  AddDetail( ({ "haut" }),
	     BS("Die Haut des Drachen ist natuerlich gar keine richtige Haut, "
		+ "sondern nur kunstvoll geschnitztes Holz.")
	     );
  AddDetail( ({ "punkt", "loch", "oeffnung" }),
	     BS("Du schaust genauer hin. Ja, da wo der Drache sich um den "
		+ "Dachbalken windet ist an seiner Unterseite ein kleines, "
		+ "schwarzes Loch. und es riecht etwas streng.")
	     );
  AddDetail( ({ "unterseite", "bauch" }),
	     BS("Der Drache hat natuerlich auch eine Unterseite. Zu sehen ist "
		+ "sie aber nur da, wo der Drache reliefartig aus der Wand "
		+ "hervortritt. Am Bauch des Drachen ist ein kleines Loch.")
	     );
  AddSmell( ({ "loch", "punkt", "oeffnung" }),
	     BS("Kaum zu glauben aber wahr. Ueber den Zweck dieser Oeffnung "
		+ "bestehen keine Zweifel mehr. DA wuerde sicher niemand "
		+ "etwas wichtiges verstecken.")
	     );
  AddDetail( ({ "schankraum", "raum", "kneipe", "umgebung", "wirtshaus" }),
	   BS("An der Kopfseite des Schankraums befindet sich die Theke. Der "
	      + "Rest des Raumes ist mit einfachen Holztischen und Baenken "
	      + "ausgestattet. Eigentlich waere dies eine Kneipe wie "
	      + "hunderttausend andere auch, wenn da nicht der Drache waere, "
	      + "der ihr den Namen gegeben hat.")
	     );
  AddDetail( ({ "holztische", "tische" }),
	     BS("Die Tische sind sehr einfach, aber dafuer auch sehr stabil "
		+ "gebaut. Alles in allem siehst Du hier Tische, an denen "
		+ "Du unbesorgt Deinen Rausch ausschlafen kannst, ohne dass "
		+ "die Tischplatte unter Deinem schweren Kopf zusammenbricht.")
	     );
  AddDetail( ({ "tischplatte" }),
	     BS("Die Tischplatten sind sauber. Groesstenteils jedenfalls.")
	     );
  AddDetail( ({ "kopf" }),
	     BS("Deinen Kopf kannst Du nur sehen, wenn Du in einen Spiegel "
		+ "oder etwas vergleichbares schaust.")
	     );
  AddDetail( ({ "kehle" }),
	     BS("Deine Kehle kannst Du nur sehen, wenn Du in einen Spiegel "
		+ "oder etwas vergleichbares schaust.")
	     );
  AddDetail( ({ "baenke" }),
	     BS("Die Baenke zeigen Dir, dass sich der ´Gruene Drache´ nicht "
		+ "als ein Restaurant der gehobenen Klasse versteht. "
		+ "Vielmehr will es dem einfachen Mann (und natuerlich der "
		+ "einfachen Frau) von der Strasse, dem mueden Arbeitnehmer, "
		+ "dem erschoepften Abenteurer eine Umgebung bieten, in der "
		+ "er gemuetlich sein abendliches Bier trinken oder auch "
		+ "mal mit seinen Freunden feiern kann.")
	     );
  AddDetail( ({ "restaurant", "etablissement" }),
	     BS("So koennte man den ´Gruenen Drachen´ zwar auch bezeichnen, "
		+ "Kneipe ist aber eigentlich der bessere Ausdruck.")
	     );
  AddDetail( ({ "mann", "frau", "arbeitnehmer", "abenteurer" }),
	     BS("Wenn Du jemanden anschauen magst, benutz doch bitte den "
		+ "Namen.")
	     );
  AddDetail( ({ "freunde" }),
	     BS("Wer Deine Freunde sind, musst Du schon selber wissen.")
	     );
  AddDetail( ({ "bier" }),
	     BS("Einige der Gaeste des ´Drachen´ haben ein Bier vor sich "
		+ "stehen.")
	     );
  AddDetail( ({ "gaeste", "leute" }),
	     BS("An einigen Tischen sitzen Gaeste, die gemuetlich etwas "
		+ "trinken und sich nicht um Dich kuemmern.")
	     );
  AddDetail( ({ "boden", "fussboden" }),
	     BS("Der Fussboden des ´Drachen´ ist erstaunlich sauber. Entweder "
		+ "benehmen sich die Gaeste hier gut, oder die Putzkolonne "
		+ "nimmt ihre Arbeit sehr gewissenhaft wahr.")
	     );
  AddDetail( ({ "putzkolonne" }),
	     BS("So etwas siehst Du hier selbstverstaendlich nicht! In "
		+ "welcher Kneipe wird denn geputzt, waehrend Gaeste "
		+ "anwesend sind?")
	     );
  AddDetail( ({ "dinge", "gegenstaende", "ding", "gegenstand" }),
	     BS("In dieser Kneipe gibt es so viele Gegenstaende, da musst Du "
		+ "Dich schon etwas genauer ausdruecken.")
	     );
  AddDetail( ({ "rest", "hauptsachen" }),
	     BS("Gib Dich nicht mit Resten ab, schau Dir die Hauptsachen an!")
	     );
  AddDetail( ({ "stadt", "turan" }),
	     BS("Du befindest Dich gerade in der wudnerbaren Stadt Turan.")
	     );
  AddSpecialDetail( ({ "zeit"}),
		    "zeitansage"
	     );
  AddDetail( ({ "waende", "wand" }),
	     BS("Die Waende sind groesstenteils schlicht gehalten. Nur knapp "
		+ "unter der Decke befindet sich an allen vier Waenden das "
		+ "Relief eines gruenen Drachen.")
	     );
  

  

  // Test-Blocker.
  AddDetail( ({ "abend", "anblick", "anfaenger", "abenteuer", "blick", "laessigkeit", "lauf", "muenze", "teil", "untersuchen", "zustand", "eindruck", "gruenen", "zweifel", "aufschluss", "ausdruck", "namen", "arbeit", "dank", "dienst", "wissen", "klasse", "rausch"
		  }),
	     BS("Das ist unsichtbar, deshalb siehst Du es auch nicht.")
	     );
  
  
  
  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "errate", "rate" }), "was_ist_in_der_flasche" );
  AddCmd( ({ "greife", "greif" }), "greif_in_widerliches_loch" );

  AddExit( "norden", LUPUS("workroom") );
  AddExit( "osten", TURROOM("drache-1-8") );
  NewDoor( "suedwesten", TURROOM("turan-0-6"), 
	   ({ "eingangstuer", "tuer", "ausgang" }),
	   ({ 
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_OP,
	       D_LONG, BS("Die Eingangstuer ist schmucklos aber praktisch. Im "
			  + "geschlossenen Zustand verwehrt ihr stabiles Holz "
			  + "den Ausgang zur Strasse. Die Wirtin des Drachen "
			  + "sieht es aber gerne, wenn Gaeste von draussen "
			  + "hereinkommen und so ist die Eingangstuer selten "
			  + "verschlossen."),
	       D_SHORT, "Die Eingangstuer. (%s)"
	       })
	   );
}

string zeitansage()
{
  return( dtime(time())+"\n" );
}

int was_ist_in_der_flasche(string str)
{
  string* inhalte;
  string poss_inhalt;

  inhalte = ({ 
    "Bier", "Wein", "Wasser", "Arsen", "Pferdepisse", 
    "das Blut bei Vollmond um Mitternacht gemeuchelter Jungfrauen",
    "Eau de Cologne", "Raki", "Kaffee", "Ameisensaeure"
  });
  poss_inhalt = inhalte[random((sizeof(inhalte)))];

  notify_fail( "Was willst Du erraten?\n" );
  if( str == "inhalt" )
    {
      write(
	    BS("Du ueberlegst einen Moment und raetst dann "+poss_inhalt
	       + ". Du hast aber keine Ahnung, ob das auch stimmt.")
	    );
      return 1;
    }
  return 0;
}

int greif_in_widerliches_loch(string str)
{
  notify_fail("Wo willst Du reingreifen?\n");
  if( !str ) return 0;
  notify_fail("Da kannst Du nicht reingreifen.\n");
  if( member_array( str,  
		    ({ "loch", "oeffnung", "in loch", "in oeffnung" }) 
		    ) == -1 ) return 0;
  else
    {
      write( BS("Du greifst in das kleine, ekelhaft stinkende Loch. "
		+ "Natuerlich ist nix drin. Hatte ich doch eh gesagt, oder? "
		+ "Spieler sind ja sooooooo widerliche Typen! ;)")
	     );
      return 1;
    }
}

string holz_gucker()
{
  if( VorLetztesDetail == "tuer" )
    {
      return(
	BS("Die Tuer ist aus stabilen Eichenbrettern gezimmert und haelt "
	   + "es schon mal aus, wenn bei einer Pruegelei jemand "
	   + "gegen sie geworfen wird.")
	);
    }
  if( member_array( VorLetztesDetail, ({ "holzschnitzerei", "werk", "handwerkskunst" })) != -1 )
    {
     return(BS("Dieses Gruene Holz gibt es sonst nirgends im SilberLand. Es "
	       + "muss wohl von einer einheimischen Pflanze stammen.")
	    );
    }
  if( member_array( VorLetztesDetail, ({ "theke" })) != -1 )
    {
     return(BS("Die Theke ist aus einem sehr harten Holz, dass auch den "
	       + "Ansturm eines Troll-Kegelclubs aushalten kann.")
	    );
    }
  if( member_array( VorLetztesDetail, ({ "haut", "drache" })) != -1 )
    {
     return(BS("Die Haut des Drachen ist so kunstvoll aus einem gruenen Holz "
	       + "geschnitzt, dass Dir das Tier beinahe lebendig zu sein "
	       + "scheint.")
	    );
    }
  return(BS("Hier gibts es viele Dinge aus Holz. Schau Dir erstmal einen "
	 + "Gegenstand an und dann kannst Du das jeweilige Holz untersuchen.")
	 );
}

varargs string GetDetail(mixed key, mixed race)
{
  if( stringp(key)==1 )
    {
      VorLetztesDetail = LetztesDetail;
      LetztesDetail = key;
      return ::GetDetail( key, race );
    }
  else
    {
      VorLetztesDetail = LetztesDetail;
      LetztesDetail="";
      return ::GetDetail( key, race );
    }
}
