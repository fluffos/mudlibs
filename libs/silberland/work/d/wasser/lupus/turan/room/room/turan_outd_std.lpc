// Am suedlichen Stadttor.
//
// Erstellt am:          14.02.1999
// Zuletzt geaendert am: 16.03.1999
//

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../turan_def.h"

void create() {
  ::create();

  SetProp( P_INT_SHORT, "Turan - der Standardraum." );
  SetProp( P_INT_LONG,
	   BS("Ein Standardraum in Turan.")
	   );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "turan" }),
	     BS("Du hast wohl laut gedacht. Jedenfalls sagt Dir ein Hobbit "
		+ "der gerade an Dir vorbeilaeuft, dass Turan der Name der "
		+ "Stadt ist, in der Du Dich gerade befindest.")
	     );
  AddDetail( ({ "hobbit" }),
	     BS("Er ist schon wieder um die naechste Ecke verschwunden.")
	     );
  AddDetail( ({ "ecke", "ecken" }),
	     BS("Hier gibt es viele Ecken, die Du nicht alle untersuchen "
		+ "magst.")
	     );
  AddSound( ({ DEFAULT_SOUND }),
    BS("Ueberall um Dich herum hoerst Du die typischen Geraeusche einer "
       + "geschaeftigen Stadt.")
    );
  AddSmell( DEFAULT_SMELL,
    BS("Es riecht nach Stadt.")
    );
 
}
