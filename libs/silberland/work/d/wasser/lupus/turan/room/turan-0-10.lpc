#include "../turan_def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "" }),
    BS("")
    );

  AddReadDetail( ({ "" }),
    BS("")
    );

  AddSound( DEFAULT_SOUND,
    BS("")
    );

  AddSound( ({ "" }),
    BS("")
    );

  AddSmell( DEFAULT_SMELL,
    BS("")
    );

  AddSmell( ({ "" }),
    BS("")
    );

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "tue" }), "command" );

  //  AddItem( "item" , REFRESH_DESTRUCT);

  AddExit( "osten", TURROOM("turan-0-12") );
  AddExit( "westen", TURROOM("turan-0-8") );

  NewDoor( "nordwesten", TURROOM("drache-1-9"), ({ "tor", "hoftor" }),
	   ({ 
	     D_FLAGS, DOOR_CLOSED | DOOR_RESET_OP,
	       D_LONG, BS("Bei dem Tor handelt es sich vermutlich um den "
			  + "Lieferanteneingang des ´Gruenen Drachen.´"),
	       D_SHORT, "Ein grosses, hoelzernes Tor. (%s)",
	       D_NAME, "Tor",
	       D_GENDER, NEUTER
	       })
	   );

}

command(string str )
{
  notify_fail( "Was willst Du tun?\n" );
  if( str == "tuer" )
  {
    write("Du tust etwas.\n");
    say( TPNAM+" tut etwas.\n");
    return 1;
  }
  return 0;
}
