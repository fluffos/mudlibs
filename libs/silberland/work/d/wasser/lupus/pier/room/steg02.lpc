inherit "/d/wasser/lupus/pier/room/stdpier_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../pier.h"


create()
{
   ::create();

   SetProp(P_INT_SHORT, "Auf der Pier" );
   SetProp(P_INT_LONG,
     "Die Holzlatten unter Deinen Fuessen schwingen kaum merklich im "
     "Rhythmus Deiner Schritte mit, als Du den langen Steg der Pier "
     "entlanggehst. Ein leichter Suedostwind traegt den Duft des Meeres "
     "an Deine Nase und unter Dir hoerst Du das Geraeusch der sich an "
     "den Pfeilern der Pier brechenden Wellen.\n"
     "Wenn Dir nicht gerade der Sinn danach steht, Dich ueber das "
     "Gelaender ins Meer zu stuerzen, dann kannst Du entweder nach "
     "Norden zum festen Land zurueck oder nach Sueden zu der Plattform, "
     "die das Ende der Pier bildet, weitergehen.");

   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN: TT_PLAIN ]) );


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Du hoerst das Geraeusch der gegen die Pfeiler der Pier krachenden "
    "Wellen.");

  AddSound( ({ "geraeusch" }),
    "Du hoerst die Wellen gegen die Pfeiler krachen. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Die Luft riecht intensiv nach Meer. Ausserdem liegt der nicht "
    "unangenehme Duft von Pfeifentabak in der Luft.");

  AddSmell( ({ "luft" }),
    "Hier riechts nach Meer!");

  AddSmell( ({ "meer" }),
    "Das Meer riecht salzig. ");

  AddSmell( ({ "duft" }),
    "Es riecht hier nach Pfeifentabak. ");


// DETAILBEGINN

   AddDetail( ({ "wind", "suedostwind" }),
     "Der Wind weht von Suedosten.");

   AddDetail( ({ "nase" }),
     "Die Hoeflichkeit gebietet es, ueber Deine Nase zu schweigen.");
   
   AddDetail( ({ "hoeflichkeit" }),
     "Wenn Dir meine Hoeflichkeit nicht passt, dann beschwer Dich doch beim "
     "zustaendigen Regionsmagier. ");

   AddDetail( ({ "regionsmagier", "magier" }),
     "Ja, irgendwelche Probleme mit meinen Raeumen?");

   AddDetail( ({ "probleme", "problem" }),
     "Ich wusste doch, dass Du keine hast.");

   AddDetail( ({ "sinn", "sinne" }),
     "Du hast 5 Sinne. Wohin die Dir grade stehen, kannst Du wohl nur "
     "selber wissen.");

   AddDetail( ({ "pfeiler", "blick" }),
     "Der Blick auf die Pfeiler der Pier wird durch den Boden "
     "versperrt.");

   AddSpecialDetail( "wellen", "wellenschauer" );
   
   AddDetail( ({ "gelaender" }),
     "Das, wie die ganze Pier, aus weiss gestrichenem Holz bestehende "
     "Gelaender hat sicher schon viele Wesen vor einem Sturz ins Meer "
     "bewahrt.");

   AddDetail( ({ "sturz", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaahhhhhplatsch" }),
     "Sowas in Richtung 'AAAAAAAAAAaaaaaaaaaaaaaaaaaaaahhhhhPLATSCH!!!'");
  
   AddDetail( ({ "holz" }),
     "Die ganze Pier besteht aus Holz, dass mit weisser Farbe "
     "angestrichen wurde.");

   AddDetail( ({ "farbe" }),
     "Die Pier ist weiss gestrichen.");

   AddDetail( ({ "moment" }),
     "Grade ist wieder einer vorbei.");

   AddDetail( ({ "wesen", "palette" }),
     "Naja, Du weisst schon...die ganze Palette halt.");

   AddDetail( ({ "land" }),
     "Das feste Land faengt nur wenige Meter noerdlich von hier an.");

   AddDetail( ({ "meer" }),
     "Das Meer liegt rechts und links der Pier. Es ist blau.");

   AddDetail( ({ "luft" }),
    "Die siehst Du nicht nur hier nicht.");

   AddDetail( ({ "pier" }),
     "Eine Pier ist ein Schiffsanleger.");

   AddDetail( ({ "schiffsanleger", "schiffanleger", "anleger", "stelle" }),
     "Nachdem Du einige Minuten lang angestrengt nachgedacht hast kommt "
     "Dir der Gedanke, dass ein Schiffsanleger eine Stelle sein koennte, "
     "an der Schiffe anlegen.\n"
     "Stolz ueber diese Erkenntnis klopfst Du Dir selbst auf die "
     "Schulter.");

   AddDetail( ({ "gedanke" }),
     "Ab und zu hast Du sowas. Erschreckend, nicht wahr?");

   AddDetail( ({ "erkenntnis" }),
     "Du bist stolz auf sie.");

   AddDetail( ({ "schulter" }),
     "Da Du Dir eben auf selbige geklopft hast, wirst Du ja wohl auch "
     "wissen, was sie ist.");

  AddDetail( ({ "schiff", "schiffe" }),
    "Auch wenn das hier ein Schiffsanleger ist, siehst Du hier im "
    "Moment keine Schiffe. Du haeltst es fuer wahrscheinlich, dass "
    "diese nur im Bereich der Abschlussplattform anlegen.");

   AddDetail( ({ "plattform", "abschlussplattform", "steg" }),
     "Der lange Steg endet ein Stueck weiter suedlich in einer "
     "grossen, achteckigen Plattform.");

   AddDetail( ({ "stueck" }),
     "Sei doch nicht so genau!");

   AddDetail( ({ "bereich" }),
     "Der Bereich der Plattform ist nicht deckungsgleich mit dem "
     "des Steges, in dem Du Dich gerade befindest.");

   AddDetail( ({ "boden", "holzlatten", "latten" }),
     "Der Boden der Pier besteht aus langen Holzlatten. Keine davon "
     "sieht aus, als ob sie locker waere.");

   AddSpecialDetail( "latte" ,"lattendruecker");

   AddDetail( ({ "fuss", "fuesse" }),
     "Du bist erleichtert, als Du Deine Fuesse am unteren Ende Deiner "
     "Beine wiederfindest.");

   AddDetail( ({ "bein", "beine" }),
     "Deine Beine stehen fest auf Deinen Fuessen.");

   AddDetail( ({ "ende" }),
     "Alles hat ein Ende.");

   AddDetail( ({ "rhythmus", "schritte", "schritt" }),
     "Deine Schritte bestimmen den Rhythmus.");




   AddExit( "norden", PROOM("steg01") );
   AddExit( "sueden", PROOM("plattform-n") );

   AddItem( PNPC("angler"), REFRESH_DESTRUCT );

   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

}

lattendruecker()
{
  TP->reduce_hit_point(3);
  say(
      BS(TPNAM +" kniet sich ploetzlich hin und faengt an, auf das Ende jeder "
      "einzelnen Latte zu druecken. Nach einer ganzen Weile steht "
      + TPPRO + " enttaeuscht wieder auf.")
     );
  return
      BS("Du kriechst eine Weile auf dem Boden rum und drueckst "
         "testhalber auf jede einzelne Latte. (Hab ich erwaehnt, dass es "
         "eine ganze Menge sind?) Viele Latten und drei Spreissel (Autsch!) "
         "spaeter stehst Du wieder auf, ohne dass Du eine lose Latte "
         "gefunden haettest.\n"
         "Fluchend ziehst Du die Spreissel aus dem Finger und wirfst "
         "ihn ins Meer.");
}

wellenschauer()
{
   if(TP->QueryProp(P_RACE)=="Zwerg") 
     return 
     BS("Du siehst mehr Wellen, als Du zaehlen kannst. OK, das heisst "
        "nicht viel, Du kannst ja nicht weiter als bis 5 zaehlen, aber "
        "es sind trotzdem eine Menge.");

   if(TP->QueryProp(P_RACE)=="Elf") 
     return 
     BS("Du siehst irrsinnig viele Wellen. Du zaehlst schnell durch und "
        "kommst auf insgesamt " + random(500000));

   if(TP->QueryProp(P_RACE)=="Mensch") 
     return 
     BS("Du siehst mehr Wellen, als Du zaehlen kannst...was bei einem "
        "ganzen Meer eigentlich kein Wunder ist.");
   else 
     return "Du siehst mehr Wellen, als Du zaehlen kannst.\n";

}
