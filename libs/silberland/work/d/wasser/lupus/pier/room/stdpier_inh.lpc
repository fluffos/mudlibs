

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../pier.h"

create()
{
  ::create();

   SetProp( P_INT_SHORT, "Auf der Pier" );
   SetProp( P_INT_LONG,
     "Noch'n Pier?");

   AddDetail( ({ "meter", "m", "urmeter" }),
     "Meter [gr.] s, Einheitenzeichen m, im SilberLand gesetzliche "
     "Einheit der Laenge. Genau festgelegt wurde das M. durch das in "
     "einer der unteren Schubladen von Lupus' Schreibtisch aufbewahrte "
     "Urmeter, einen Stab aus einer Platin-Iridium-Legierung. Seit 1 "
     "nach Woodys Geburt ist das M. definiert als das 1650763,73fache der "
     "Wellenlaenge der Orangelinie des Kryptonisotops 86.");
 
   AddDetail( ({ "kryptonisotop", "legierung", "orangelinie", "platin", 
     "wellenlaenge", "iridium", "wellenlaenge", "einheitenzeichen", 
     "einheit", "laenge", "schubladen", "schreibtisch", "stab", "geburt" }),
     "Na was mag das wohl sein? Denk doch mal ein kleines bisschen mit.");
   
   AddDetail( ({ "morgengrauen", "mg", "anderland", "al" }),
     "Sowas siehst Du hier nicht und wirst Du auch niemals sehen.");
   
   AddDetail( ({ "silberland", "sl", "welt" }),
     "Das SilberLand ist Deine Welt.");

   AddDetail( ({ "woody" }),
     "Woody ist Gott.");

   AddDetail( ({ "gott" }),
     "Gott ist Woody. Und Dusty ist sowieso goettlich.");

   AddDetail( ({ "dusty" }),
     "Auch wenn sie einem manchmal schon einn bisserl angestaubt "
     "vorkommt wird wohl niemand bestreiten, dass sie echt goettlich "
     "ist.");


// Angefuegt am 23.5.1997

   AddDetail( ({ "himmel" }),
     "Der Himmel ist so blau, dass es Dir furchtbar uebel ginge, wenn "
     "Du genauso waerst.");
   
   
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );


// Angeln von Feyaria

   AddCmd( ({"angle", "angel", "angl"}), "angeln");

}

int angeln(string str)
{
    if(present("angel",this_player()))
          notify_fail("Leider faengst Du nichts.\n");
      return 0;
}


