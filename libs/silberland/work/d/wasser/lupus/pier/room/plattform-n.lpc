inherit "/d/wasser/lupus/pier/room/stdpier_inh";

#include <properties.h>
#include <language.h>
#include "../pier.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT, "Auf der Pier" );
   SetProp(P_INT_LONG,
     "Hier geht der lange Steg, der die Verbindung zum Festland "
     "darstellt, in die achteckige Plattform ueber, die die Pier "
     "abschliesst.\n"
     "Die Mitte der Plattform wird von einem Haus eingenommen, "
     "ueber dessen Eingangstuer ein Schild haengt.");

   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


// DETAILBEGINN

   AddDetail( ({ "steg" }),
     "Der Steg fuehrt in Richtung Norden zum Ufer.");

   AddDetail( ({ "ufer", "festland" }),
     "Das Ufer sieht voellig unerforscht aus.");

   AddDetail( ({ "plattform" }),
     "Den Abschluss der Pier bildet hier eine grosse Plattform, in "
     "deren Mitte ein Haus steht, an dessen Tuer ein Schild haengt.\n"
     "Nach Suedwesten und Suedosten kannst Du um das Haus herumgehen.");
   
   AddDetail( ({ "pier" }),
     "Du stehst momentan auf ihr.");

   AddDetail( ({ "haus", "holz" }),
     "Das Haus ist - wie die gesamte Pier - aus Holz gebaut und mit "
     "weisser Farbe gestrichen. Ueber der Eingangstuer haengt ein "
     "Schild.");

   AddDetail( ({ "tuer", "eingangstuer" }),
     "Die Tuer ist geoffnet und laedt zum Betreten des Hauses ein.");

   AddDetail( ({ "schild" }),
     "Auf dem Schild ist - im Stil der von Pfeilen durchbohrten Herzen "
     "- ein von einer Harpune durchbohrter Fisch zu sehen. Darunter "
     "steht der Name 'Zum vom Pech verfolgten Fisch, der zu unserem "
     "Glueck sehr gut schmeckt'. Der Besitzer dieses Lokals scheint "
     "einen seltsamen Sinn fuer Humor zu haben.");

   AddReadDetail( ({ "schild" }),
     "Auf dem Schild steht 'Zum vom Pech verfolgten Fisch, der zu "
     "unserem Glueck sehr gut schmeckt'.\n"
     "Darueber siehst Du eine Zeichnung.");

   AddDetail( ({ "zeichnung" }),
     "Die Zeichnung stellt einen von einer Harpune durchbohrten Fisch "
     "dar. Die Komposition der Zeichnung erinnert Dich irgendwie an "
     "ein Herz, das von Amors Pfeil durchbohrt wurde.");

   AddDetail( ({ "fisch" }),
     "Der Fisch sieht ziemlich tot aus.");

   AddDetail( ({ "harpune" }),
     "Die Harpune sieht scharf, toedlich und ziemlich gemein aus.");


// Angefuegt am 24.5.1997

   AddDetail( ({ "boden", "planken", "holzplanken", "planke", "holzplanke" }),
     "Der Boden besteht aus langen Holzplanken.");

   AddDetail( ({ "farbe" }),
     "Die Farbe, in der das Haus gestrichen ist, nennt man im "
     "Allgemeinen 'weiss'");


// Angefuegt am 22.02.1998

   AddDetail( ({ "meer" }),
     "Das Meer ist ueberall. Du siehst es zu beiden Seiten der "
     "Pier und Du kannst es unter Dir gegen die Pfeiler der "
     "Pier rauschen hoeren.");


   AddExit( "norden", PROOM("steg02") );
   AddExit( "suedosten", PROOM("plattform-o") );
   AddExit( "sueden", PROOM("plattform-m") );
   AddExit( "suedwesten", PROOM("plattform-w") );

   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );

}
