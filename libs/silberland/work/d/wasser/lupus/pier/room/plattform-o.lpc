/* 	Ostseite der Pier
**	Zuletzt bearbeitet: 25.11.2004 - Clementine
**	
**	Anzahl der Details:
**	Normal:		05
**	Read:		01
**	Sounds:		00
**	Smells:		00
**	Befehle:	00
**
*/

inherit "/d/wasser/lupus/pier/room/stdpier_inh";

#include <properties.h>
#include <language.h>
#include "../pier.h"
#include "/d/wasser/feyaria/schiffe.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf der Pier" );
  SetProp(P_INT_LONG,
    "Hier an der Ostseite der Pier befindet sich einer ihrer "
    "Schiffsanlegeplaetze. Am Gelaender, das unvorsichtige "
    "Abenteurer vor einem Sturz ins Wasser bewahren soll, ist "
    "eine Tafel angebracht, die ueber die hier ankommenden und "
    "abfahrenden Schiffe Auskunft gibt.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


// SOUNDS

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Glucksen von Wasser unter der Pier.");
 
  AddSound( ({ "glucksen" }),
    "*glucks* *glucks");

  AddSound( ({ "pier" }),
    "Unter der Pier gluckst das Wasser. ");

  AddSound( ({ "wasser" }),
    "Du hoerst das Wasser glucksen. ");

// SMELLS

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht nach Salz.");

  AddSmell( ({ "luft" }),
    "Die Luft riecht hier salzig. ");

  AddSmell( ({ "salz", "geruch", "salzgeruch" }),
    "Tief atmest Du den Salzgeruch ein.");


// DETAILS

  AddDetail( ({ "pier" }),
    "Du stehst auf ihr.");

  AddDetail( ({ "schiffsanlegeplaetze", "schiffsanlegeplatz", 
                "anlegeplatz", "anlegeplaetze", "anlegestellen" }),
    "Hier an der Ostseite der Pier befindet sich eine der drei "
    "Anlegestellen der Pier. Eine Tafel gibt ueber die hier "
    "ankommenden und abfahrenden Schiffe Auskunft.");

  AddDetail( ({ "tafel", "auskuenfte", "auskunft" }),
    "Du kannst die Auskuenfte auf der Tafel lesen.");

  AddReadDetail( ({ "auskuenfte", "auskunf", "tafel" }),
    "Hier landet das Segelboot, das Liebende dem Paradies "
    "noch naeher bringt. Ausserdem kommt ab und zu hier "
    "mal die schwere Galeere her, um Passagiere mit in "
    "die heisse Wueste zu nehmen. Und neuerdings liegt "
    "hier auch ein schneller Katamaran, der nach Edynia "
    "segelt." );


  // Angefuegt am 24.5.1997

  AddDetail( ({ "gelaender" }),
    "Das Gelaender umgibt die gesamte Plattform und bewahrt unter "
    "anderem Dich davor, ins Wasser zu fallen.");

  AddDetail( ({ "buchstaben" }),
    "Du strengst Dich nochmal richtig an und erkennst folgende "
    "Buchstaben: zwei W, elf E, zwei G, sechs N, drei T, vier "
    "C, fuenf H, sechs I, vier S, vier R, drei K, zwei M, ein "
    "O, ein A, zwei F und ein V.");

  // Neue Details vom 21.1.1999

  AddDetail( ({ "boden", "bohlen", "holzbohlen" }),
    "Der Boden der Pier besteht aus langen Holzbohlen.");

  AddDetail( ({ "meer" }),
    "Das Meer erstreckt sich von der Kueste im Norden bis zum "
    "Horizont.");
 
  AddDetail( ({ "kueste", "kuestenstreifen" }),
    "Der dunkle Kuestenstreifen im Norden uebt keine Anziehung "
    "auf Dich aus. Warum auch, wenn das ganze Meer offen vor "
    "Dir liegt und Schiffe darauf warten, Dich in ferne "
    "Laender zu tragen?" );

  AddDetail( ({ "abenteurer", "gilden", "angehoerige" }),
    "Abenteurer im Sinne dieses Details sind auch Angehoerige "
    "aller anderen Gilden.");

  AddDetail( ({ "schiff", "schiffe" }),
    "Von der Pier koennen Dich Schiffe zu allen Haefen des "  
    "SilberLands tragen.");

  AddDetail( ({ "plattform", "ostseite", "pier" }),
    "Hier an der Ostseite der Pier befindet sich einer ihrer "
    "Schiffsanlegeplaetze. Am Gelaender, das unvorsichtige "
    "Abenteurer vor einem Sturz ins Wasser bewahren soll, ist "
    "eine Tafel angebracht, die ueber die hier ankommenden und "
    "abfahrenden Schiffe Auskunft gibt.");

  AddDetail( ({ "haefen", "hafen" }),
    "Der einzige Hafen, den Du im Moment siehst ist derjenige, "
    "auf dem Du gerade stehst.");

  AddDetail( ({ "wasser" }),
    "Wenn Du Wasser suchst: Im Meer wimmelt es geradezu davon.");

// Neue Details vom 25.11.2004 - Clementine

  AddDetail( ({ "holz" }),
    "Die Holzbohlen des Bodens bestehen natuerlich aus Holz. Allerdings "
    "kannst Du leider nicht erkennen, welches es genau ist. "); 



  AddExit( "nordwesten", PROOM ("plattform-n") );
  AddExit( "suedwesten", PROOM ("plattform-s") );

  AddItem( MAU ("obj/segelboot"), REFRESH_DESTRUCT, 1 );
  AddItem( GALEERE, REFRESH_REMOVE, 1);
  AddItem( KATAMARAN, REFRESH_REMOVE, 1);

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

}
