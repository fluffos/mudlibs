inherit "/d/wasser/lupus/pier/room/stdpier_inh";

#include <properties.h>
#include <language.h>
#include "../pier.h"
#include "/d/wasser/feyaria/schiffe.h"


create()
{
   ::create();

   SetProp( P_INT_SHORT, "Auf der Pier" );
   SetProp( P_INT_LONG,
     "Die Westseite der Plattform bietet einen herrlichen Ausblick "
     "auf Meer und Kueste. Am Gelaender, das die Plattform begrenzt, "
     "ist eine Tafel mit einem Schiffsfahrplan angebracht.");

   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


// SOUNDS

  AddSound(DEFAULT_SOUND, 
    "Du hoerst die Wellen leise gegen die Pier schlagen. ");

  AddSound( ({ "wellen", "welle" }),
    "Die Wellen schlagen leise gegen die Pier.");


// DETAILBEGINN


   AddDetail( ({ "schiffsfahrplan", "fahrplan", "plan" }),
     "Du kannst ihn lesen.");

   AddDetail( ({ "tafel", "fahrplantafel" }),
     "Du kannst sie lesen.");

   AddReadDetail( ({ "schiffsfahrplan", "fahrplan", "plan", "tafel" }),
     "   /------------------------------------------\\\n"
     "   |                                          |\n"
     "   |              SCHIFFSVERKEHR              |\n"
     "   |   ====================================   |\n"
     "   |                                          |\n"
     "   |    Walfaenger: nach Smoersky             |\n"
     "   |                                          |\n"
     "   |    Handelskogge: nach Derlim             |\n"
     "   |                                          |\n"
     "   |    Kuestensegler: Einmal rund ums        |\n"
     "   |                   Silberland             |\n"
     "   |                                          |\n"
     "   |                                          |\n"
     "   |                                          |\n"
     "   |                                          |\n"
     "   \\------------------------------------------/\n");


   AddDetail( ({ "holzplattform", "plattform" }),
     "Du stehst an der westlichen Seite der achteckigen Holzplattform, "
     "an der sich die eigentlichen Schiffsanlegestellen der Pier "
     "befinden.");

   AddDetail( ({ "anlegestellen", "schiffsanlegestellen" }),
     "Die Pier hat drei Schiffsanlegestellen. Eine an der Ost-, eine "
     "an der Sued-, und diese hier an der Westseite.");

   AddDetail( ({ "pier" }),
     "Nachdem Du so lange darauf rumgelaufen bist, solltest Du langsam "
     "'ne Vorstellung davon haben, was eine Pier ist.");

   AddDetail( ({ "vorstellung" }),
     "Stell Dir einfach vor, was das ist. Dann weisst Du es.");

   AddDetail( ({ "seite", "seiten" }),
     "Alles hat (mindestens) zwei Seiten.");

   AddDetail( ({ "raum" }),
     "Allgemeine Schutzverletzung im Modul "
     "/d/wasser/room/pier/plattform-w.c\n\n"
     "data overflow\n\n"
     "Du siehst einen Fehler im Raum-Zeit-Gefuege.");

   AddDetail( ({ "schutzverletzung", "modul", "RZG", "raum-zeit-gefuege", 
     "eingabe" }),
     "Eingabe nicht verstaendlich. Bitte spezifizieren Sie.");

   AddDetail( ({ "gelaender" }),
     "Das Gelaender fuehrt, abgesehen von den Zugaengen zu den "
     "Schiffen und dem Steg zum Festland, um die ganze Pier herum.");

   AddDetail( ({ "steg" }),
     "Der Steg fuehrt von der Nordseite der Plattform aus zur Kueste. ");

   AddDetail ( ({ "westseite" }),
     "Die Westseite ist die Seite der Pier, an der Du Dich gerade "
     "befindest.");

   AddDetail( ({ "zugang", "zugaenge", "luecke", "stelle" }),
     "An einer Stelle hat das Gelaender eine etwa zwei Meter breite "
     "Luecke. Durch diese Luecke kann man leicht auf ein hier angelegtes "
     "Schiff kommen.");

   AddDetail( ({ "schiff", "schiffe" }),
     "Wenn Du mehr ueber die hier anlegenden Schiffe wissen willst, "
     "solltest Du den Fahrplan lesen.");
   
   AddDetail( ({ "kueste", "festland", "beschaffenheit" }),
     "Zwar siehst Du von hier das Festland, kannst zu seiner "
     "Beschaffenheit aber weiter nichts sagen, da es bisher noch "
     "niemand beschrieben hat. Das einzige Detail, das Dir auffaellt "
     "sind die Daecher einer Stadt.");
   
  AddDetail( ({ "daecher", "stadt", "detail" }),
    "Ueber dem...naja...dem Unbeschreibbaren siehst Du die Daecher "
    "einer Stadt. Von einem der Daecher reflektiert irgendetwas das "
    "Licht.");
   
  AddDetail( ({ "dach", "licht", "reflexion" }),
    "Auf einem der Daecher scheint irgendetwas das Licht zu "
    "reflektieren. Du drehst Dich um und bemerkst jetzt, dass die "
    "Reflektion einen kleinen Lichtpunkt auf der Fahrplantafel "
    "erzeugt.");
  
  AddSpecialDetail( ({ "lichtpunkt", "punkt"}), "lichtpunkter" );
  
  AddDetail( ({ "nordseite" }),
    "Die Nordseite der Pier ist die Seite der Pier, die nach Norden "
    "zeigt.");
   
  AddDetail( ({ "meer" }),
    "Das Meer ist gross, blau und einfach wunderschoen.");
    
  AddDetail( ({ "ausblick" }),
    "Der Ausblick ist atemberaubend. Vor Dir breitet sich das Meer "
    "entlang der undefinierten Kueste bis zum Horizont aus.");
   
  AddDetail( ({ "horizont" }),
    "Hinter dem Horizont gehts weiter, weiter als man glaubt.");


// Angefuegt am 24.5.1997

  AddDetail( ({ "boden", "planken", "holzplanken", "planke", "holzplanke" }),
    "Der Boden besteht aus langen Holzplanken.");


// Neue Details 25.11.2004 - Clementine 

  AddDetail( ({ "reflektion", "reflektionen" }),
    "Die Reflektion erzeugt einen kleinen Lichtpunkt auf der Fahrplantafel.");

  AddDetail( ({ "wellen", "welle" }),
    "Das Meer schlaegt immer wieder einige Wellen, die dann leise gegen "
    "die Pier schlagen.");

  AddDetail( ({ "ostseite" }),
    "Die Ostseite liegt natuerlich im Osten!");

  AddDetail( ({ "osten" }),
    "Geh doch einmal hin, und schau Dir das an!");

  AddDetail( ({ "suedseite" }),
    "Zur Suedseite kommst Du indem Du einfac 'so' tippst :)");


  AddItem( WALFAENGER, REFRESH_REMOVE, 1);
  AddItem( HANDELSKOGGE, REFRESH_REMOVE, 1);   
  AddItem( KUESTENSEGLER, REFRESH_DESTRUCT, 1);

  AddExit( "nordosten", PROOM("plattform-n") );
  AddExit( "suedosten", PROOM("plattform-s") );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );


}

string lichtpunkter()
{
   if (this_player()->FindPotion(
      BS("Du beugst Dich vor, um festzustellen, auf welchen Punkt auf "
      "dem Schild der Lichtstrahl faellt. Dabei haeltst Du dummerweise "
      "fuer einen Augenblick Deinen Kopf in den Lichtstrahl. Ploetzlich "
      "spuerst Du einen Stich in Deinem Gehirn. Irgendwas scheint sich "
      "in Dir zu veraendern...")))
   return "";
   else
   return(
      BS("Du untersuchst den Lichtpunkt sehr genau. Leider scheint "
      "er wirklich nur ein einfacher Lichtpunkt zu sein."));

}

