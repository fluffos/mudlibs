// SilberLand MUDlib
//
// Die Suedseite der Pier.
// zuletzt bearbeitet: 25.11.2004 - Clementine
//

inherit "/d/wasser/lupus/pier/room/stdpier_inh";

#include <properties.h>
#include <language.h>
#include "../pier.h"
#include "/d/wasser/feyaria/schiffe.h"


create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf der Pier" );
  SetProp(P_INT_LONG,
    "Du stehst am aeussersten Ende der Pier. Suedlich von Dir "
    "breitet sich das Meer bis zum Horizont aus.\n"
    "Am Gelaender der Pier ist eine Tafel befestigt, an der Du "
    "Dich ueber die hier an- und ablegenden Schiffe informieren "
    "kannst.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );


// SOUNDS

  AddSound( DEFAULT_SOUND, 
    "Du hoerst das Glucksen von Wasser unter der Pier.");

  AddSound( ({ "wasser", "glucksen" }),
    "Das Wasser gluckst unter der Pier. ");

  AddSound( ({ "pier" }),
    "Unter der Pier gluckst das Wasser.");


// SMELLS

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht nach Salz.");

  AddSmell( ({ "luft", "salz" }),
    "Die Luft riecht salzig. ");
  

// DETAILBEGINN

  AddDetail( ({ "pier" }),
    "Du stehst drauf.");

  AddDetail( ({ "meer" }),
    "Das Meer, das wie ein sich staendig veraendernder Teppich vor "
    "Dir ausgebreitet liegt, uebt eine beruhigende Wirkung auf Dich "
    "aus.");
  
  AddDetail( ({ "horizont" }),
    "Hinter dem Horizont gehts weiter, weiter als man glaubt.");
  
  AddDetail( ({ "gelaender" }),
    "Das Gelaender soll verhindern, dass jemand aus Versehen ins "
    "Meer stuerzt.");
  
  AddDetail( ({ "tafel" }),
    "Du kannst sie lesen.");
  
  AddReadDetail( ({ "tafel" }),
    "   /------------------------------------------\\\n"
    "   |                                          |\n"
    "   |              SCHIFFSVERKEHR              |\n"
    "   |   ====================================   |\n"
    "   |                                          |\n"
    "   |    Karavelle : von Midas-Hafen-West      |\n"
    "   |                in die Stadt Tijara       |\n"
    "   |                                          |\n"
    "   |    Handelsschiff: zu allen groesseren    |\n"
    "   |        Haefen: Tijara                    |\n"
    "   |                Hobbingen / Derlim        |\n"
    "   |                Felseninsel               |\n"
    "   |                Smoersky                  |\n"
    "   |                                          |\n"
    "   |                                          |\n"
    "   \\------------------------------------------/\n");


// Neue Details vom 21.1.1999

  AddDetail( ({ "ende"}),
    "Tja, hier ist wirklich Schluss mit der Pier. Suedlich von "
    "hier ist nur noch das Gelaender und dahinter das "
    "tiefe, blaue Meer.");


// Neue Details vom 25.11.2004 - Clementine

  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "wasser" }),
    "Du bist foermlich von Wasser umgeben, schliesslich ist "
    "ja hier das Meer.");

  AddDetail( ({ "boden" }),
    "Der Boden der Pier besteht aus alten Holzplanken. ");

  AddDetail( ({ "planken", "planke", "holzplanken", "planken" }),
    "Der Boden unter Dir besteht aus ihnen. ");

  AddDetail( ({ "holz" }),
    "Aus welchem Holz man die Planken einst hergestellt hat, laesst sich "
    "heute leider nicht mehr erkennen. Allerdings bist Du Dir sicher, "
    "dass es schon ziemlich alt sein muss. ");

  AddDetail( ({ "teppich" }),
    "Das Meer ist wirklich toll anzusehen. ");

  AddDetail( ({ "welle", "wellen" }),
    "Die Wellen des Meeres bewegen sich auf und ab. ");

  AddDetail( ({ "schluss" }),
    "Hier gehts nicht mehr weiter. ");

  AddDetail( ({ "versehen" }),
    "Das Gelaender wurde hier errichtet, damit niemand aus Versehen ins "
    "Meer plumpst und ertrinkt. ");

  AddDetail( ({ "schiffe", "schiff" }),
    "An der Tafel kannst Du Dich ueber die hier anlegenden oder auch "
    "ablegenden Schiffe informieren. ");


  AddItem( KARAVELLE, REFRESH_REMOVE, 1);
  AddItem( HANDELSSCHIFF, REFRESH_REMOVE, 1);      

  AddExit( "nordosten", PROOM("plattform-o") );
  AddExit( "nordwesten", PROOM("plattform-w") );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );

}
