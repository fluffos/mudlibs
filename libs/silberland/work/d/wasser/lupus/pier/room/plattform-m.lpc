inherit "/std/pub";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "../pier.h"


create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Warte-Lounge" );
  SetProp(P_INT_LONG,
   "Du befindest Dich im Inneren einer mehr oder weniger "
   "(eigentlich eher weniger) gemuetlichen Wartehalle. Die "
   "Waende sind allesamt weiss gestrichen, machen aber den "
   "Eindruck, dass diese Streich-Aktion schon eine ganze Weile "
   "her ist und mal wiederholt werden sollte.\n"
   "Im ganzen Raum verteilt stehen Baenke, auf denen sich "
   "wartende Reisende niederlassen koennen. Im Sueden der Halle "
   "ist eine kleine Bar, an der Du Dir etwas zu trinken oder "
   "einen kleinen Snack kaufen kannst. Nach allen anderen "
   "Seiten bieten grosse Fensterfronten einen herrlichen "
   "Ausblick auf das Meer, das im warmen Sommerlicht ruhig "
   "daliegt.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN: TT_HOUSE ]) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );


// SMELLS

  AddSmell(DEFAULT_SMELL, "Es duftet hier herrlich nach frischem "
    "Kaffee und leckeren Spaghetti. ");

  AddSmell( ({ "kaffee" }),
    "Das riecht aber herrlich! Ein Kaffee wuerde Dir jetzt auch gut tun. ");

  AddSmell( ({ "spaghetti" }),
    "Du faengst zu sabbern an. ");


// DETAILBEGINN 

  AddDetail( ({ "sommerlicht", "licht" }),
    "Die Sonne ist heute nicht geizig und badet die Aussenwelt in "
    "warmen Licht.");

  AddDetail( ({ "sonne" }),
    "Von hier drinnen kannst Du sie nicht sehen, da sie zu hoch "
    "steht. Aber auch ohne sie unmittelbar zu sehen, hast Du "
    "keine Zweifel, dass sie ueber Dir am Himmel steht.");

  AddDetail( ({ "aussenwelt", "welt" }),
    "Durch die Tuer im Norden kannst Du die Aussenwelt betreten.");

  AddDetail( ({ "tuer" }),
    "Durch die Tuer an der Nordseite des Raumes kannst Du den "
    "Wartesaal verlassen.");

  AddDetail( ({ "norden" }),
    "Also wenn Du nicht weisst, was Norden ist, dann frage ich "
    "mich doch ernsthaft, wie Du hierhergekommen bist...");
  
  AddDetail( ({ "sueden" }),
    "Also wenn Du nicht weisst, was Sueden ist, dann frage ich "
    "mich doch ernsthaft, wie Du hierhergekommen bist...");
  
  AddDetail( ({ "osten" }),
    "Also wenn Du nicht weisst, was Osten ist, dann frage ich "
    "mich doch ernsthaft, wie Du hierhergekommen bist...");
  
  AddDetail( ({ "nordseite", "nordwand", "eingang", "ausgang" }),
    "In der Nordwand der Wartehalle befindet sich ihr einziger "
    "Ein- und Ausgang.");
  
  AddDetail( ({ "meer", "ozean" }),
    "Das Meer erstreckt sich nach Sueden und Osten bis zum "
    "Horizont. Hier und dort kannst Du, fast schon im Dunst "
    "verschwimmend, einige kleine Inseln erkennen.");

  AddDetail( ({ "inseln", "insel" }),
    "Leider ist es zu dunstig, um genaueres erkennen zu koennen.");

  AddDetail( ({ "dunst", "horizont" }),
    "Der Horizont verschwimmt im Dunst.");

  AddDetail( ({ "wartesaal", "raum", "wartehalle", "halle", "saal" }),
    QueryProp(P_INT_LONG) );  

  AddDetail( ({ "ausblick", "blick" }),
    "Von hier aus hast Du einen herrlichen Blick auf das Meer.");

  AddDetail( ({ "wand", "waende" }),
    "Die Waende dieses Raumes sind aus weiss lackiertem Holz "
    "gezimmert worden. Damit der Raum nicht zu dunkel wird, "
    "hat man klugerweise auch ausreichend Fenster eingebaut.");

  AddDetail( ({ "glasfenster", "fenster"}),
    "Die Fenster sind eigentlich mehr als ausreichend. Sie sind "
    "beeindruckend gross und sauber. Durch sie hindurch kannst "
    "Du den herrlichen Anblick des Meeres geniessen.");

  AddDetail( "decke",
    "Die Decke besteht aus Holz und ist ziemlich langweilig.");

  AddDetail( ({ "grundbaustoff", "holz" }),
   "Holz bildet den Grundbaustoff der Pier. Deswegen siehst Du es, "
   "egal wohin du schaust: In den Fensterrahmen, dem Fussboden, der "
   "Decke, einfach ueberall.");

  AddDetail( ({ "boden", "fussboden" }),
    "Der Boden besteht aus Holzplanken.");

  AddDetail( ({ "holzplanken", "planken" }),
    "Die Planken sind ordentlich verfugt, so dass keine Ritzen "
    "oder Spalten zu erkennen sind.");
 
  AddDetail( ({ "fensterrahmen", "rahmen" }),
    "Die Fenster sind von Fensterrahmen eingefasst. Irgendwie "
    "ueberrascht Dich das nicht weiter.");

  AddDetail( ({ "pier", "landungssteg" }),
    "Du stehst hier in der Mitte der Plattform, die das Ende der "
    "Pier bildet.");

  AddDetail( ({ "plattform" }),
    "Am Ende des langen Landungsstegs befindet sich hier, wo Du "
    "stehst, eine grosse Plattform. Zusammen nennt man das "
    "Ganze eine Pier.");

  AddDetail( ({ "ganze" }),
    "Bist Du noch ganz dicht?");
 
  AddDetail( ({ "streichaktion", "streich-aktion", "aktion" }),
    "Du wirfst noch mal Deinen Kennerblick auf die Waende "
    "und entscheidest, dass die Anwesenheit eines Malers hier "
    "mal wieder dringend erforderlich waere.");

  AddDetail( ({ "anwesenheit" }),
    "Leider ist hier keine Anwesenheit eines Malers "
    "festzustellen.");


// Angefuegt am 24.5.1997

   AddDetail( ({ "bank", "baenke" }),
     "Die Baenke, die hier stehen sehen zwar nicht grade "
     "gemuetlich aus, aber man wird sich beim Warten wohl "
     "immerhin nicht den Hintern wundsitzen.");

  AddDetail( ({ "bar" }),
    "Eine Standard-Wartehallen-Bar mit dem Standard-Wartehallen"
    "-Angebot.");


// Angefuegt am 19.11.1997

  AddDetail( ({ "angebot" }),
    "Ueber das Angebot kannst Du Dich mit dem Befehl 'menue' "
    "informieren.");

  AddDetail( ({ "himmel" }),
    "Du hast auch keine ernsthaften Zweifel daran, dass der "
    "Himmel, an dem sich die Sonne rumtreibt, irgendwo ueber "
    "Dir ist." );

  AddDetail( ({ "hintern" }),
    "Du fuehlst kurz nach und stellst erleichtert fest, dass er "
    "noch da ist, wo Du ihn hingesteckt hast.");


// Neue Details 25.11.2004 - Clementine

  AddDetail( ({ "fensterfront", "fensterfronten", "front", "fronten" }),
    "Die grossen Fensterfronten bieten Dir einen idealen Ausblick auf das "
    "Meer.");

  AddDetail( ({ "anblick" }),
    "Du bist ganz fasziniert von der Schoenheit des Meeres. ");

  AddDetail( ({ "schoenheit" }),
    "Das Meer sieht wirklich beeindruckend aus. ");


// GETRAENKE UND SPEISEN

  AddDrink("Silenus Tafelwasser", ({ "wasser", "tafelwasser" }),10,5,0,3,
    ({ "Du bekommst Dein 'Silenus Tafelwasser' (TM), trinkst es aus "
       "und denkst: 'Silenus, the god of tablewaters'",
       "&& bekommt ein Glas Wasser und leert es in einem Zug."
    }) );
  
  AddDrink( "Apfelsaft", ({ "asaft", "a-saft", "apfelsaft" }), 15,5,0,2,
    ({ "Du bestellst einen Apfelsaft und trinkst ihn genuesslich "
       "aus.",
       "der Kellner bringt && einen Apfelsaft, den &1 genuesslich austrinkt."
    }) );

   AddDrink( "Kaffee", "kaffee", 45,5,0,1,
     ({ "Der Kaffee, den der Kellner vor Dir absetzt, verstroemt "
        "einen angenehmen Duft so dass Du nicht lange zoegerst, "
        "bevor Du die Tasse austrinkst.",
        "Der Kellner setzt eine Tasse mit duftendem Kaffee vor && "
        "ab, den &1 mit geschlossenen Augen austrinkt."
     }) );

   AddDrink( "Grog", ({ "grog" }), 225,29,9,1,
     ({ "Du bestellst einen Becher Grog und singst beim Trinken ein "
        "Seemannslied.",
        "&& trinkt einen Becher Grog und singt ein Seemannslied dazu."
     }) );

   AddFood( "Belegtes Broetchen", "broetchen", 19,({9,7}),5,
     ({ "Du schlingst ein Broetchen hinunter, dessen Trockenheit selbst "
        "einen ausgewachsenen Wuestenmagier in Erstaunen versetzen wuerde.",
        "&& beisst mit dem Geraeusch brechender Knochen in ein "
        "offensichtlich etwas trockenes Broetchen."
     }) );

   AddFood( "Spaghetti Nostromo", "spaghetti", 725,50,15,
     ({ "Du schlingst die Spaghetti hinunter und spuerst ploetzlich "
        "ein seltsames Ziehen in der Magengegend.",
        "&& schlingt &# Spaghetti Nostromo hinunter und guckt "
        "ploetzlich etwas seltsam."
     }) );



   AddExit( "oben", "/d/wasser/lupus/hochzeit/room/empfang" );
   AddExit( "norden", PROOM("plattform-n") );


}

int GotoHochzeit()
{
  if(IS_WIZARD(this_player()))
    {
      write( "Du gehst durch einen Ausgang, den niemand sonst sehen kann.\n");
      say( TPNAM + " geht durch einen unsichtbaren Ausgang.\n");
      return (PL->move( PIER_HZ, M_TPORT | M_SILENT ) >= 0);
    }
  write("Du siehst hier keinen Ausgang, der in diese Richtung fuehrt.\n");
  return 1;
}
