

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../pier.h"

create()
{
   if (!is_clone(this_object()))
      return;
   ::create();

   SetProp(P_SHORT, "Eine Kapitaensmuetze");
   SetProp(P_LONG, 
     "Das ist eine Standard-Kapitaensmuetze aus weissem Stoff mit "
     "einem kurzen, schwarzen Schirm an der Vorderseite.");
   SetProp(P_NAME, "Kapitaensmuetze");
   SetProp(P_GENDER, FEMALE);
   AddId( ({ "muetze", "kapitaensmuetze" }) );
   SetProp(P_WEIGHT, 500);
   SetProp(P_VALUE, 200);

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_CLOTH);

  AddDetail( ({ "stoff" }),
    "Der Stoff ist weiss. ");

  AddDetail( ({ "schirm", "vorderseite" }),
    "Die Muetze hat an der Vorderseite einen schwarazen Schirm. ");

}


