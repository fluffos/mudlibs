inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../pier.h"


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Ein Schild vom 22.5.1997 <<<< !NEU!");
  SetProp(P_LONG,
        BS("Auf dem Schild steht:\n"
        + "Lupus wrote:\n\n"
        + ">> !!!!ACHTUNG!!!!\n"
        + ">>\n"
        + ">> Viel Spass bei weiteren Entdeckungen, Lupus am 23.5.1996\n\n\n"
        + "Und nur um Euch zu zeigen, dass Magier niemals ein Jahr lang "
        + "idlen wuerden, gebe ich hier mit zu erkennen, dass ich wieder da "
        + "bin.\n"
        + "Grosse Aenderungen gibbet bisher noch nicht, nur eine interne "
        + "Kleinigkeit. Ich werde mich aber in den naechsten Tagen "
        + "hinsetzen und die umfangreichen Rep-Files abarbeiten.\n\n"
        + "Also weiterhin viel Spass! Lupus am 22.5.1997\n\n\n"
        + "PS.: Falls Ihr Euch mal verirrt: Austria ist fuenfter Stock.\n")
  );
  SetProp(P_NAME, "Schild");
  SetProp(P_GENDER, NEUTER);
  AddId("schild");
  SetProp(P_WEIGHT, 50000000);
  SetProp(P_VALUE, 200);
  SetProp(P_NOGET,1);
  
  AddCmd( "lies", "lies_schild");  

}

lies_schild()
{
   write(
        BS("Auf dem Schild steht:\n"
        + "Lupus wrote:\n\n"
        + ">> !!!!ACHTUNG!!!!\n"
        + ">>\n"
        + ">> Viel Spass bei weiteren Entdeckungen, Lupus am 23.5.1996\n\n\n"
        + "Und nur um Euch zu zeigen, dass Magier niemals ein Jahr lang "
        + "idlen wuerden, gebe ich hier mit zu erkennen, dass ich wieder da "
        + "bin.\n"
        + "Grosse Aenderungen gibbet bisher noch nicht, nur eine interne "
        + "Kleinigkeit. Ich werde mich aber in den naechsten Tagen "
        + "hinsetzen und die umfangreichen Rep-Files abarbeiten.\n\n"
        + "Also weiterhin viel Spass! Lupus am 22.5.1997\n\n\n"
        + "PS.: Falls Ihr Euch mal verirrt: Austria ist fuenfter Stock.\n")
   );
   return 1;
}

