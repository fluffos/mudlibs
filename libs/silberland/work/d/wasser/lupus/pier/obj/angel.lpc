inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_SHORT, "Eine Angel");
  
   SetProp(P_LONG, 
	   "Die Angel ist biegsam aber dennoch stabil. Der Haken am Ende "
	      + "der Angelschnur macht einen ziemlich spitzen Eindruck.") ;
   SetProp(P_NAME, "Angel");
   SetProp(P_GENDER, FEMALE);
   AddId("angel");
   AddId("Angel");
   SetProp(P_VALUE, 300);
   SetProp(P_WEIGHT, 990);
   SetProp(P_WEAPON_TYPE, WT_SPEAR);
   SetProp(P_DAM_TYPE, DT_PIERCE);
   SetProp(P_WC, 100);
   SetProp(P_WC_FIXFACTOR, 0.1);
   SetProp(P_NR_HANDS, 2);
   SetProp(P_MATERIAL, ([MAT_MISC_WOOD:85, MAT_SILK:10, MAT_IRON:5])); 
                         
   AddDetail( ({ "haken", "angelkahen" }),
	   "Der Haken sieht sehr spitz aus, was Dich dazu bewegt, "
		 "darauf zu verzichten, ihn an Deinem Finger "
		 "auszuprobieren.");
   AddDetail( ({ "schnur", "angelschnur" }),
	   "Die Schnur verbindet die Angel mit dem Haken.");
   
}
