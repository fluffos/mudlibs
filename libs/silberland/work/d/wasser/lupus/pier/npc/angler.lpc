
// Zuletzt geaendert am 26.11.2004 - Clementine

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include "../pier.h"

create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Angler");
  SetProp(P_LONG, 
    "Der Angler ist, das erkennst Du auf den ersten Blick, ein "
    "ehemaliger Schiffskapitaen. In den vielen Falten in seinem "
    "Gesicht duerfte sich der Staub saemtlicher Kuesten dieser "
    "Welt gesammelt haben. Aus seinem Mund ragt eine Pfeife, die "
    "einen starken, aber nicht unangenehmen Geruch verstroemt." );
  SetProp(P_NAME, "Angler");
  SetProp(P_GENDER, MALE);
  AddId( ({ "angler", "kapitaen", "Angler" }) );
  create_default_npc(10);
  SetProp(P_ALIGN, 100);
  SetProp(P_BODY, 70);
  SetProp(P_HANDS, ({" mit seiner Pfeife", 70}) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE, ({ DT_WATER }));
  SetProp(P_VULNERABILITY, ({ DT_ELECTRIC }));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 165+random(20) );
  SetProp(P_XP,50000);
  
  seteuid(getuid(this_object()));
  
  clone_object("/p/weapon/spear/angel")->move(this_object());
  command("zuecke angel");
  clone_object(POBJ("muetze"))->move(this_object());
  command("ziehe muetze an");
  

// INFOS

  SetProp(P_DEFAULT_INFO, "brummelt irgendwas Unverstaendliches.\n");

  AddInfo( ({ "see", "meer", "ozean" }),
	   "seufzt und hat ploetzlich einen vetraeumten Blick in den Augen.\n"
	   );

  AddInfo( ({ "lupus" }),
	   "Das ist ein feiner Bursche. Ich hab ihm viel zu verdanken.",
	   "sagt: " );

  AddInfo( ({ "woody" }),
	   "Hmmm, den kenn ich nicht persoenlich. Aber der Name klingt "
	   "gut. Wenn er so ist wie er heisst, dann hat er wenigstens "
	   "keine Probleme mit sinkenden Schiffen.",
	   "sagt: " );

  AddInfo( ({ "fisch", "fische" }),
	   "sagt: Heute wollen sie mal wieder gar nicht beissen.\n" );

  AddInfo( ({ "angel" }),
	   "Jaaa, das ist schon eine tolle Angel. Nichts kann mich von "
	   "ihr trennen.",
	   "sagt: " );

  AddInfo( ({ "angeln", "fischen" }),
	   "Ach, seit ich nicht mehr zur See fahre ist Angeln der einzige "
	   "Zeitvertreib, der mir noch bleibt.",
	   "sagt: " );

  AddInfo( ({ "wasser" }),
	   "sagt: Wasser ist Leben. Besonders mein Leben.\n" );

  AddInfo( ({ "pfeife" }),
	   "nimmt einen tiefen Zug aus seiner Pfeife und grinst Dich an.\n"
	   "Der Angler sagt: Es ist ungesund...aber gut.\n" );

  AddInfo( ({ "aufgabe" }),
   	   "Ja, wir alle suchen nach einer Aufgabe im Leben, nicht wahr?\n"
	   );

  AddInfo( ({ "hilfe", "helfen" }),
	   "Mir hat im Leben auch keiner geholfen. Also hilf Dir selbst.",
	   "grummelt und sagt: " );
 
  AddInfo( ({ "leben" }),
	   "sagt: Mein Leben war zu lang, um es Dir jetzt zu erzaehlen.\n" );
  
  AddInfo( ({ "koeder", "wurm", "wuermer" }),
	   "sagt: Meine Koeder sind ein Geheimnis.\n" );
  
  AddInfo( ({ "zaubertrank" }),
	   "Zaubertrank? Ist das sowas wie ein Donnergurgler oder "
	   "Melee Island Grog?",
	   "gruebelt: " );

  AddInfo( ({ "anglerlatein", "latein" }),
	   "Oeh, meinst du sowas wie 'Pisces meus amicae sunt'?",
	   "sagt: " );

  AddInfo( ({ "sex" }),
	   "Wenn Du so fragst geh ich mal davon aus, dass ich mehr davon "
	   "habe als Du.",
	   "sagt: " );
  
// Ergaenzt am 27.5.97
       
  AddInfo( ({ "alrik" }),
	   "Alrik? Kuemmer Dich besser nicht um diesen Traeumer. "
	   "Oder warte, noch besser Du kuemmerst Dich um ihn und "
	   "sagst Ihm, er soll endlich zugeben, dass er nicht "
	   "gewinnen kann und mir meinen Gewinn auszahlen!",
	   "sagt: " );

  AddInfo( ({ "gewinn", "wette" }),
	   "Das ist eine Sache zwischen Alrik und mir.",
	   "sagt: " );

  AddInfo( ({ "traeumer" }),
	   "Geh doch zu Alrik und frag ihn mal nach unserer Wette, wenn Du "
	   "mir nicht glaubst!",
	   "wuetet: " );
  
// Ergaenzt am 28.5.97
       
 AddInfo( ({ "geheimnis" }),
           "Geheimnis, das: Sache, die man niemandem erzaehlt, der "
	   "@@PWER@@ heisst.",
	   "belehrt Dich: " );

  AddInfo( ({ "hafen", "pier" }),
	   "Diese Pier ist der Hafen von Midas. Die Schiffe legen weiter "
	   "vorne an.",
	   "sagt: " );

  AddInfo( ({ "muetze", "kapitaensmuetze" }),
	   "So eine Muetze kann man sich nur durch lange Jahre Arbeit auf See "
	   "verdienen.",
	   "verkuendet stolz: " );

  AddInfo( ({ "schiff", "schiffe", "handelsschiff", "karavelle", "schiffen" }),
	   "Die Schiffe legen weiter vorn an der Pier an. Welche es genau "
	   "sind steht auf den Auskunftstafeln.",
	   "sagt: " );

  AddInfo( ({ "midas" }),
	   "Midas ist eine grosse Stadt, die nordoestlich von hier liegt. Ich "
	   "mag sie nicht besonders. Ich mag ueberhaupt keine Staedte. Zu "
	   "eng.",
	   "sagt: " );

  AddInfo( ({ "stadt", "staedte" }),
	   "Ich mag keine Staedte. Midas nicht, und andere auch nicht.",
	   "grummelt: " );

  AddInfo( ({ "wetter", "einstellung" }),
	   "Es gibt kein schlechtes Wetter. Nur 'ne falsche Einstellung.",
	   "sagt: " );

  AddInfo( ({ "beissen" }),
	   "Fische sind halt bloed und stinken.",
	   "grummelt: " );

  AddInfo( ({ "angrox", "stahldorn" }),
	   "Ist das nicht einer von diesem Magierhaufen, der immer an einem "
	   + "rumbasteln will?",
	   "beaeugt Dich misstrauisch und fragt: " );

  AddInfo( ({ "hai", "silberhai" }),
	   "Haie gibts viele, Silberhaie keine.",
	   "fragt: " );

  AddInfo( ({ "quest", "queste", "quests" }),
	   "Die einzige Quest von der ich weiss, wird Dir nicht helfen. Und "
	   "Alrik wird sie auch nie beenden.",
	   "grumpft: " );

  AddInfo( ({ "pilz", "pilze" }),
	   "Landrattenfrass.",
	   "sagt veraechtlich: " );

  AddInfo( ({ "dusty", "goettin" }),
	   "Ich bete jeden Abend zu Ihr.",
	   "verkuendet ehrfurchtsvoll: " );

  AddInfo( ({ "wind" }),
	   "Der Wind ist wichtig fuer die Schiffe.",
	   "sagt: " );

  AddInfo( ({ "boot", "boote" }),
	   "Wenn Du die Schiffe meinst: Die legen weiter vorne and er Pier "
	   "an.",
	   "sagt: " );

  AddInfo( ({ "wellen", "wellchen" }),
	   "Das hier sind doch keine Wellen! Allensfalls Wellchen!",
	   "lacht: " );

  AddInfo( ({ "fang" }),
	   "Haelt sich in Grenzen. Danke der Nachfrage.",
	   "seufzt: " );

  AddInfo( ({ "name", "namen" }),
	   "Die Treovarden aus Hueppeldideldoe nennen mich "
	   "Herolakoranglerides, aber Du kannst mich auch kurz "
	   "'Angler' nennen.",
	   "sagt: " );


// Angefuegt am 29.5.1997   

  AddInfo( ({ "tabak" }),
	   "Sorry, ich kann leider nichts davon abgeben. Hab selber "
	   "kaum noch was...",
	   "lehnt bedauernd ab und sagt: " );

  AddInfo( ({ "kapitaen" }),
	   "Ich war jahrelang Kapitaen auf allen Meeren des SilberLands.",
	   "sagt: " );

  AddInfo( ({ "zaubern" }),
	   "Kann ich nicht.",
	   "sagt: " );

  AddInfo( ({ "alter" }),
	   "Das geht Dich wohl nichts an.",
	   "sagt: " );
  

// Angefuegt am 2.7.97
       
  AddInfo( ({ "haus", "schluessel", "tuch", "eimer", "naehzeug", "obst",
	"verian", "lena", "garten", "treovarn", 
	"kilian", "naegel", "fenster" }),
	   "Mit den Leuten im Dorf hab ich nix am Hut.",
	   "sagt: " );

  AddInfo( ({ "semira" }),
	   "@@semiraner@@",
	   "sagt: " );

  AddInfo( ({ "creative" }),
	   "@@creativer@@",
	   "sagt: " );

// Angefuegt am 27.9.97

  AddInfo( ({ "gruende" }),
	   "Ach, hoer mir mit DEM Bloedsinn auf.",
	   "grummelt: " );

  AddInfo( ({ "dem" }),
	   "Aha, ein kleiner Scripter, wie?",
	   "grinst: " );

  AddInfo( ({ "dorf", "fischerdorf" }),
	   "Das Fischerdorf liegt irgendwo in der Richtung.",
	   "wedelt mit den Armen nach Nordwesten und sagt: " );

  AddInfo( ({ "segelboot" }),
	   "Hab ich nicht und brauch ich auch nicht.",
	   "sagt: " );

  AddInfo( ({ "arbeit" }),
	   "Ich hab in meinem Leben genug gearbeitet. Also lass mich damit "
	   "gefaelligst in Frieden!",
	   "faehrt Dich an: " );

  AddInfo( ({ "was is mit dir" }),
	   "Nix!",
	   "sagt: " );
  
  
  
  
  
  
  SetProp( P_REJECT, ({ REJECT_GIVE, 
  BS("Der Angler lacht freundlich und sagt: Ne lass "
     "ma, ich hab schon alles was ich brauche.")}) );

}

string PWER()
{
  string PName;
  
  PName = this_player()->name();
  
  return PName;
}

string semiraner()
{
  if( this_player()->name() == "Semira" ) return "Hi Du! Ich wuerd ja gern "
	 "auch mal mit Dir in die Sauna "
	 "gehen, aber Lupus hat mich "
	 "leider nicht zu 'nem "
	 "moving-NPC gemacht. :(";
  return "Semira ist ein schnuckeliges Maedel, findest Du nicht?";
}

string creativer()
{
  if( this_player()->name() == "Creative" ) return "Gruesse Semira von mir. "
	 "*seufz*";
  return "Frag lieber nicht. Er hat mir Semira vor der Nase weggeschnappt. :(";
}


