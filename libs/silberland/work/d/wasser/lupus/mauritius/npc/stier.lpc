// SilberLand MUDlib
//
// Ein NPC der Insel Mauritius.
//
// ueberarbeitet: 22.11.2001 Clementine@SL


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../mau.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Stier");
  SetProp(P_LONG, 
	 "Der Stier ist gross und herrlich von Gestalt, mit schwellenden "
	 "Muskeln am Halse und vollen Wammen am Bug; seine Hoerner sind "
	 "zierlich und klein, wie von Haenden gedrechselt, und "
	 "durchsichtiger als reine Juwelen; goldgelb ist die Farbe "
	 "seines Leibes, nur auf der Stirne schimmert ein "
	 "silberweisses Mal, dem gekruemmten Horne des wachsenden "
	 "Mondes aehnlich; blaeuliche, von Verlangen funkelnde Augen "
	 "rollen in seinem Kopf.");
  SetProp(P_NAME, "Stier");
  SetProp(P_GENDER, MALE);
  AddId( ({ "stier", "zeus" }) );
  create_default_npc( 12 );
  SetProp(P_HANDS, ({" mit seinen Hoernern", 150, DT_PIERCE}));
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Stier");
  SetProp(P_WEIGHT, 300000 );
  SetProp(P_SIZE, 170 );

  SetProp(P_DIE_MSG, " bricht in einer Wolke aus Staub zusammen.\n");
  SetProp(P_DEFAULT_INFO, "schnaubt Dich an.\n" );

  set_living_name("stier");

  seteuid(getuid(this_object()));
  
  clone_object( MAUOBJ("rechenschieber"))->move(this_object());
}

