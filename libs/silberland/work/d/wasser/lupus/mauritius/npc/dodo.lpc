// SilberLand MUDlib
//
// Ein NPC der Insel Mauritius.
//
// $Date$
/* $Revision$
 * $Log$
 */


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include <moving.h>
#include <combat.h>
#include "../mau.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Dodo");
  SetProp(P_LONG, 
	 "Der grosse, muerrische Vogel blickt Dich an, und Du blickst "
	 "den grossen, muerrischen Vogel an. Du blickst den grossen, "
	 "muerrischen Vogel an, als waere er das ungewoehnlichste, "
	 "was Du in Deinem ganzem Leben zu Gesicht bekommen hast, und "
	 "der Vogel blickt Dich an, als wolle er mal sehen, ob Du "
	 "seinen Schnabel auch nur im entferntesten komisch findest." );	 
  SetProp(P_NAME, "Dodo");
  SetProp(P_GENDER, MALE);
  AddId( ({ "dodo" }) );
  create_default_npc(2);
  SetProp(P_HANDS, ({ " mit seinem Schnabel", QueryProp(P_HANDS)[1],
          DT_PIERCE }) );
  SetProp(P_ALIGN, 10);
  SetProp(P_RACE, "Dodo");
  SetProp(P_WEIGHT, 1500 );
  SetProp(P_SIZE, 65 );

  SetProp(P_MNPC_AREA, ({ MAUROOM ("rwald"), MAUROOM ("wald") }));
  SetProp(P_MNPC_WAIT, ({ 120, 60, random(60)}) );
  SetProp(P_MNPC_FLAGS, 
	   MOV_BACKWARDS+MOV_OUTDOORS+MOV_MOVES+MOV_INFIGHT );
  SetProp(P_MNPC_DEFAULTROOM, MAUROOM ("rwald") );
  SetProp(P_MSGOUT,
	   "macht eine langsame, watschelnde Kehrtwendung und latscht, "
	   "als wolle er mal sehen, ob Du den kleinen Puschel aus "
	   "krausen Federn, der oben an seiner Rueckseite hervorlugt, "
	   "auch nur entfernt komisch findest" );
  SetProp(P_MSGIN, "watschelt muerrisch herein" );
  SetProp(P_MMSGOUT,
	   "macht eine langsame, watschelnde Kehrtwendung und latscht, "
	   "als wolle er mal sehen, ob Du den kleinen Puschel aus "
	   "krausen Federn, der oben an seiner Rueckseite hervorlugt, "
	   "auch nur entfernt komisch findest" );
  SetProp(P_MMSGIN, "watschelt muerrisch herein" );
  SetProp(P_DIE_MSG, " schaut Dich vorwurfsvoll an als wolle er fragen "
	 "ob Du vor hast, seine Art auszurotten.\n");
  
  AddDetail( ({ "schnabel" }),
    "Der Schnabel des Dodo ist gross, rot und albern." );

  AddDetail( ({ "puschel" }),
    "Das Puschel aus krausen Federn, das keck aus der Rueckseite "
    "des Dodo ragt verstaerkt den albernen Eindruck, den "
    "der Vogel auf Dich macht." );

  AddCmd( ({ "lach", "lache" }), "dodo_lacher" );
  AddCmd( ({ "fuetter", "fuettere" }), "dodo_fuettern" );

}

int dodo_lacher()
{
  write(BS("Der Dodo schaut Dich boese an, weil er offensichtlich davon "
	       "ausgeht, dass Du ueber ihn gelacht hat und pickt Dir mit "
	       "seinem Schnabel heftig ins Bein.") );
  say(BS("Der Dodo, der " + TP->name(WESSEN,1) + " Lachen offensichtlich auf "
	     "sich bezogen hat, pickt " + TPPRO(WEN) + " einmal kurz und "
	     "schmerzvoll ins Bein.") );
  TP->reduce_hit_point(3);
  return 1;
}

int dodo_fuettern(string str)
{
 if( str != "dodo mit nuss"          && 
     str != "dodo mit nuesse"        && 
     str != "dodo mit kalvariennuss" ) 
 {
   notify_fail("Womit willst Du den Dodo fuettern?\n");  
   return 0;
  }
 else
 {
  object ob;
  if(ob=present("\nKalvariennuss", TP)) 
  { 
   write(BS("Vorsichtig haeltst Du dem Vogel die Nuss hin, der sich "
	       "vorbeugt und sie Dir rasch aus der Hand pickt. Und weil "
	       "Du die Hand nicht rechtzeitig wieder einziehst, schlaegt "
	       "der Vogel sie mit seinem Schnabel veraergert zur Seite.\n"
	       "Sobald Du Dich wieder auf eine respektvolle Entfernung "
	       "zurueckgezogen hast, reckt der Vogel seinen Hals in die "
	       "Hoehe, schliesst seine grossen, gelben Augen und gurgelt "
		   "grazioes, als er die Nuss den Hals hinab in seinen "
	       "Kropf schuettelt.\n"
	       "Danach wirkt er wenigstens teilweise zufriedengestellt. "
	       "Waehrend vorher ein muerrischer Dodo war, ist er jetzt "
	       "zumindest ein satter muerrischer Dodo, was wahrscheinlich "
	       "ungefaehr alles ist, was er sich aus diesem Leben "
		   "erhoffen darf.") );
  say(CTPN + " fuettert den Dodo.\n"
	         "Danach wirkt dieser wenigstens teilweise "
	         "zufriedengestellt. Waehrend vorher ein muerrischer Dodo "
	         "war, ist er jetzt zumindest ein satter muerrischer Dodo, "
	         "was wahrscheinlich ungefaehr alles ist, was er sich aus "
	         "diesem Leben erhoffen darf.\n");
 
  ob->remove(1);
  return 1;
 }
}
}

