// SilberLand MUDlib
//
// Ein Schmetterling
//
// $Date$
/* $Revision$
 * $Log$
 */


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "../mau.h"

create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Schmetterling");
  SetProp(P_LONG, 
	  BS("Dieser Schmetterling ist fuer einen Regenwald-Schmetterling "
	     + "zwar nur von durchschnittlicher Groesse, das heisst nicht "
	     + "groesser als Dein Handteller, dafuer aber um so bunter "
	     + "und zerbrechlicher. Fast fuerchtest Du, er koennte von einem "
	     + "Regentropfen getroffen und so voellig vernichtet werden.\n"
	     + "Die Fluegel des Schmetterling sind in allen Farben des "
	     + "Regenbogens gezeichnet und zeigen verwirrende Muster." )
	  );
  SetProp(P_NAME, "Schmetterling");
  SetProp(P_GENDER, MALE);
  AddId("schmetterling");
  create_default_npc( 1 );
  SetProp( P_BODY, 10 );
  SetProp(P_DISABLE_ATTACK, 1 );
  SetProp( P_HANDS, ({" mit seinen Fluegeln",30,"bludgeon"}) );
  SetProp( P_MAX_HANDS, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Schmetterling");
  SetProp(P_XP, 0);
  SetProp( P_SIZE, 7 );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20,T_RANGE_MAX:35]) );
  SetProp( P_DEFAULT_INFO, "flattert nervoes durch die Gegend.\n" );
  SetProp( P_MSGIN, "flattert herein" );
  SetProp( P_MSGOUT, "flattert" );
  SetProp( P_MMSGIN, "flattert herein" );
  SetProp( P_MMSGOUT, "flattert nach" );
  
  SetProp( P_MNPC_AREA, "/d/wasser/lupus/" );
  SetProp( P_MNPC_FLAGS,
	   MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES+MOV_SPECIAL );
  SetProp( P_MNPC_WAIT, ({40, 30, random(20)}) );
  SetProp( P_MNPC_DEFAULTROOM, MAUROOM("rwald") );
  
  AddDetail( "fluegel",
	     BS("Die Fluegel sind ausserordentlich filigran und "
		+ "ausserordentlich bunt gemustert.")
	     );
  AddDetail( "muster",
	     BS("Als Du das Muster genauer betrachtest stellst Du fest, dass "
		+ "die Farbkleckser und Kraeusel Buchstaben bilden. Du kannst "
		+ "das Muster lesen!")
	     );
  AddReadDetail( "muster",
		 BS("Auf den Fluegeln des Schmetterlings steht:\n"
		    + "Region Wasser: Wir bringen Farbe in Ihr Leben.")
		 );
  
}
