// SilberLand MUDlib
//
// Eine Eidechse der Insel Mauritius.
//
// $Date$
/* $Revision$
 * $Log$
 */


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_SHORT, "Eine winzige Eidechse");
  SetProp(P_LONG, 
	  BS("Die Eidechse ist so winzig, dass man, wenn man nach "
	     + "getaner Arbeit nach Hause kommt, sich die Schuhe auszieht "
	     + "und diesen ekligen rot-gruenen Matsch darunter findet, "
	     + "womoeglich nichteinmal mehr daran erinnern kann, ein "
	     + "Exemplar dieser Gattung heimtueckisch ermordert zu haben.\n"
	     + "Diese spezielle Eidechse jedoch hat es sich auf einem Stein "
	     + "gemuetlich gemacht, so dass man sich wenigstens erinnert, "
	     + "sich den Fuss an einem Stein gestossen zu haben, wenn man "
	     + "sie schon so nutzlos meuchelt.\n"
	     + "Auf dem Stein fuehlt sie sich anscheinend sehr wohl, was man "
	     + "daran erkennt, dass sie voellig bewegungslos dasitzt und nur "
	     + "ab und zu, wenn man wieder Sonnenstrahl durchbricht, ein "
	     + "wenig glitzert.")
	  );
  SetProp(P_NAME, "Eidechse");
  SetProp(P_GENDER, FEMALE);
  AddId("eidechse");
  create_default_npc( 1 );
  SetProp( P_BODY, 15 );
  SetProp(P_DISABLE_ATTACK);
  SetProp(P_HANDS, ({" mit kleinen, spitzen Zaehnen",30,"bludgeon"}) );
  SetProp( P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Eidechse");
  SetProp( P_SIZE, 11 );
  SetProp(P_XP, 10);
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:24,T_RANGE_MAX:40]) );
  SetProp( P_DEFAULT_INFO, "sitzt reglos da.\n" );
  
}
