inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "../mau.h"

create()
{
  ::create();
  
  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht nach Regen.");

  AddSound( DEFAULT_SOUND,
	"Du hoerst viele undefinierbare Geraeusche.");
 

  AddDetail( ({ "meter", "m", "urmeter" }),
	"Meter [gr.] s, Einheitenzeichen m, im SilberLand gesetzliche "
	"Einheit der Laenge. Genau festgelegt wurde das M. durch "
	"das in einer der unteren Schubladen von Lupus' "
	"Schreibtisch aufbewahrte Urmeter, einen Stab aus einer "
	"Platin-Iridium-Legierung. Seit 1 nach Woodys Geburt ist "
	"das M. definiert als das 1650763,73fache der Wellenlaenge "
	"der Orangelinie des Kryptonisotops 86.");

  AddDetail( ({ "kryptonisotop", "legierung", "orangelinie", "platin",
		  "wellenlaenge", "iridium", "wellenlaenge",
		  "einheitenzeichen", "einheit", "laenge", "schubladen",
		  "schreibtisch", "stab", "geburt" }),
	"Na was mag das wohl sein? Denk doch mal ein kleines "
	"bisschen mit.");

  AddDetail( ({ "morgengrauen", "mg", "anderland", "al" }),
	"Sowas siehst Du hier nicht und wirst Du auch niemals sehen.");

  AddDetail( ({ "silberland", "sl", "welt" }),
	"Das SilberLand ist Deine Welt.");

  AddDetail( "woody",
	"Woody ist Gott.");

  AddDetail( "gott",
	"Gott ist Woody. Und Dusty ist sowieso goettlich.");

  AddDetail( "dusty",
	"Auch wenn sie einem manchmal schon einn bisserl angestaubt "
    "vorkommt wird wohl niemand bestreiten, dass sie echt "
	"goettlich ist.");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  
}

