inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../mau.h"


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Ein Ding");
  SetProp(P_LONG,
        BS("Ein Ding")
  );
  SetProp(P_NAME, "Ding");
  SetProp(P_GENDER, NEUTER);
  AddId("ding");
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  
}
