// inherit "/d/wasser/lupus/mauritius/room/_inh";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Nix" );
  SetProp( P_INT_LONG, "Auch Nix\n"
	   );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );
  
}
