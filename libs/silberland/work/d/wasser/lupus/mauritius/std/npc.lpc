// SilberLand MUDlib
//
// Ein NPC der Insel Mauritius.
//
// $Date$
/* $Revision$
 * $Log$
 */


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_SHORT, "Kurz");
  SetProp(P_LONG, "Lang.\n");
  SetProp(P_NAME, "Name");
  SetProp(P_GENDER, NEUTER);
  AddId("npc");
  create_default_npc( 10 );
  SetProp( P_BODY, 50 );
  SetProp(P_HANDS, ({" mit seinen Haenden", 55}));
  SetProp( P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Rasse");
  SetProp( P_SIZE, 175 );
  SetProp(P_XP, 1000);
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20,T_RANGE_MAX:25]) );
  SetProp( P_DEFAULT_INFO, "sagt: Haeh?\n" );
  SetProp( P_MSGIN, "kommt rein" );
  SetProp( P_MSGOUT, "geht%s" );
  SetProp( P_MMSGIN, "kommt herein" );
  SetProp( P_MMSGOUT, "verschwindet" );
  SetProp( P_MURDER_MSG, "aua!" );
  SetProp( P_KILL_MSG, "aua2!" );
  
  
}
