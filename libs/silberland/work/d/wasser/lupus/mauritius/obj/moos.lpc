inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../mau.h"


create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  
  SetProp(P_SHORT, "Moos");
  SetProp(P_LONG,
    "Das Moos ist wunderbar weich und flauschig. Ausserdem "
    "ist es von einem herrlichen, satten, strahlenden Gruen. "
    "Da moechte man sich doch fast dran ankuscheln. ");
  SetProp(P_NAME, "Moos" );
  SetProp(P_GENDER, NEUTER);
  AddId("moos");
  SetProp(P_WEIGHT, 17);
  SetProp(P_VALUE, 0);
  
  AddCmd( "kuschel", "kuschler" );

}

int kuschler(string str)
{
  if( str == "moos" )
    {
      say(CTPN + " kuschelt ein bisschen mit einem Stueck Moos herum.\n");
      write( "Du kuschelst Dich an das Moos an.\n" );
      return 1;
    }
}

