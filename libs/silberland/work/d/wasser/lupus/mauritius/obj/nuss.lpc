inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../mau.h"


create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Eine Nuss");
  SetProp(P_LONG,
	"Die Nuss ist braun, dick und sieht lecker aus.");
  SetProp(P_NAME, "Nuss");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "nuss", "\nKalvariennuss" }) );
  SetProp(P_WEIGHT, 16);
  SetProp(P_VALUE, 0);

  AddCmd( "iss", "esser" );

}

int esser(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if( str == "nuss" )
  {
    write(BS("Du steckst die Nuss in den Mund, beisst darauf und zuckst "
	       "zusammen. Diese Nuss war ziemlich hart. Als Du sie "
	       "allerdings erfolgreich geknackt hast entschaedigt der "
	       "Geschmack fuer die erlittenen Schmerzen.") );
    say(CTPN + " isst eine Nuss.\n");
    remove();
    return 1;
  }
  return 0;
}

