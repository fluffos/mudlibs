inherit "std/transport";

#include "/mail/post.h"
#include <config.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moving.h>
#include "../mau.h"


create()
{
  object dummy;
  ::create();
  
  // Raumbeschreibungen:
    
    SetProp(P_NAME, "Sandburg");
    SetProp(P_NOGET, 1);
    SetProp(P_LIGHT, 1);
    SetProp(P_TRANSPARENT, 1);
    
    AddId( ({ "burg", "sandburg" }) );
    SetProp(P_GENDER, FEMALE );
    SetProp(P_MAX_PASSENGERS, 2);
    
    SetProp(P_SHORT, "Eine grosse Sandburg" );
    SetProp(P_INT_SHORT, "In einer grossen Sandburg" );
    SetProp(P_INT_LONG,
	   "Hier im inneren der Sandburg ist es so richtig gemuetlich. "
	   "Der Boden besteht aus feinem, weissen Sand, der sich unter "
	   "Dir so richtig schoen weich anfuehlt. Die Waende sind "
	   "mit Stoffbahnen bedeckt, so dass Dir nicht andauernd Sand "
	   "in den Nacken rieselt. Die Decke besteht allerdings nur "
	   "aus Sand, der allerdings auf irgendeine Weise fixiert ist, "
	   "so dass er auch an der Decke bleibt. Er ist erstaunlich "
	   "duenn, so dass das Sonnenlicht - wenn auch gedaempft - "
	   "das Innere der Burg erhellt.\n"
	   "Durch den Eingang kannst Du das Meer dabei beobachten, "
	   "wie es sich mit dem Strand spielt. Der Eingang selber sieht "
	   "von hier aus unspektakulaer aus, aber irgendwas sagt Dir, "
	   "dass das von draussen ganz anders ausschaut.");
    SetProp(P_LONG,
	   "Als Du naeher hinschaust bist Du gebuehrend beeindruckt. Die "
	   "Sandburg ist an die zwei Meter hoch! Sie scheint ausserdem "
	   "vollstaendig mit Muscheln verkleidet zu sein, bis auf "
	   "die Stelle, an der sie ein grosses Loch hat.\n"
	   "Ganz oben auf den hoechsten Punkt hat jemand einen roten "
	   "Wimpel gesteckt.");
    SetProp(P_ENTERMSG,
	     ({ "kriecht in die Sandburg",
			"kommt durch den Eingang gekrochen" }) );
    SetProp(P_LEAVEMSG,
	     ({	"kriecht nach draussen",
		    "kommt aus der Sandburg gekrochen" }) );
    SetProp(P_ENTERFAIL,
	     ({ "Du willst in die Sandburg kriechen, laesst es aber "
		    "bleiben, als Du bemerktst,\n"
		    "dass sie schon voll genug ist",
		  BS(TPNAM + " will hereinkriechen, laesst es aber "
		    "angesichts der Tatsache, dass die Sandburg mit euch "
		    "zwei schon voll genug ist doch sein.") }) );    
    
    AddCmd( ({ "betritt", "betrete", "kriech", "krieche" }), "betreter" );
    AddCmd( ({ "raus", "verlasse"}), "verlasser" );
    AddCmd( ({ "schau", "unt", "untersuche" }), "untersucher" );
    
    
    AddRoute( MAUROOM ("strand24"), 600, 0);
    Start();
   
}


init()
{
  ::init();
  if( (sizeof(all_inventory(this_object()) & users()))>2 )
    {
      if(IS_WIZARD(TP) )
	{
	  TP->move(TP->QueryProp(P_LAST_COMMAND_ENV), M_TPORT | M_SILENT
		   | M_NO_SHOW);
	  write( BS("Verbluefft stehst Du wieder da, wo Du hergekommen bist. "
		        "Da will wohl jemand so ernsthaft nicht gestoert "
		        "werden, dass selbst Deine Magie versagt.") );
	}
      else
	{
	  TP->move(environment(this_object()), M_TPORT | M_SILENT | M_NO_SHOW);
	  write(BS("Du hast grad versucht, Dich in eine Sandburg zu "
		     "teleportieren. Kurz vor erreichen Deines Ziels hast Du "
		     "allerdings ploetzlich die Konzentration verloren und an "
		     "was ganz anderes gedacht, was den unangenehmen Effekt "
		     "hatte dass Du Dein Ziel um ein paar Meter verfehlt "
		     "hast und jetzt an einem schoenen Strand stehst.") );
	}
      tell_room( this_object(), 
		 BS(TPNAM + " wollt grade hier herein, hat sich dann aber "
		       "doch eines besseren besonnen.") );
    }
}

betreter(str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str == "burg" || str == "sandburg" || str=="in burg" || 
      str=="in sandburg" )
    return Enter();
}

verlasser(str)
{
  return Leave();
}

int untersucher(string str)
{
  string str1, wasdenn;
  
  if( !str ) return 0;
  if( sscanf(str, "%s an", str1) == 1 ) wasdenn=str1;
  else 
    {
      if( sscanf(str, "%s", str1) == 1 ) wasdenn=str1;
    }
  /*
    // Details, die nur ausserhalb der Sandburg sichtbar sind.
  */
  if( environment(TP)!=this_object() )
    {
      if( wasdenn=="wimpel" )
	{
	  write(BS("Der kleine Wimpel flattert froehlich im Wind."));
	  return 1;
	}
      else if(wasdenn=="muscheln")
	{
	  write(BS("Jemand hat sich die Muehe gemacht, Muscheln um die "
		    "gesamte Sandburg herum zu legen. An einer Stelle "
		    "bilden sie einen Schriftzug.")
		);
	  return 1;
	}
      if( wasdenn=="wimpel" )
	{
	  write(BS("Die Worte: 'My home ist my castle.' bringen dich zum "
		     "Schmunzeln.")
		);
	  return 1;
	}
      if( wasdenn=="schriftzug" )
	{
	  write(BS("Die Worte: 'My home ist my castle.' bringen dich zum "
		     "Schmunzeln.")
		);
	  return 1;
	}
      if( wasdenn=="loch" )
	{
	  write(BS("Was auf den ersten Blick nur aussieht, wie ein Loch "
		    "in der Sandburg ist in Wirklichkeit ein Eingang. Ein "
		    "Eingang, bei dem sich anscheinend jemand viel "
		    "Muehe gegeben hat. "
		    "Trotzdem ist es ein Eingang, durch den Du kriechen "
		    "kannst.")
		);
	  return 1;
	}
      if( wasdenn=="eingang" )
	{
	  write(BS("Dir bleibt die Spucke weg. Da hat aber jemand viel Spass "
		    "daran gehabt, einen huebschen Eingang herzustellen. "
		    "Der Eingang, flankiert von zwei schlanken und "
		    "nuechternen Saeulen, erscheint von weiterm wie ein "
		    "einziger grosser Bogen; beim Naeherkommen siehst Du "
		    "jedoch, dass hinter den Saeulen zwei maechtige "
		    "Gewaende beginnen, die, ueberwoelbt von weiteren und "
		    "vielfaeltigen Boegen, eine tiefe Vorhalle bilden und "
		    "den Blick wie ins Innere einer Hoehle zum eigentlichen "
		    "Portal leiten, das im Halbdunkel erkennbar wird. "
		    "Beherrscht von einem maechtigen Tympanon, einem "
		    "halbkreisfoermigen Giebelfeld voller Figuren, das rechts "
		    "und links auf zwei Torpfosten ruhte und in der Mitte "
		    "auf einem behauenen Pfeiler, der den Eingang in zwei "
		    "Oeffnungen teilt, ist es bewehrt mit Tuerfluegeln aus "
		    "metallbeschlagenem Eichenholz. Da die Sonne momentan "
		    "fast senkrecht ueber Dir steht, faellt das Licht "
		    "schraeg auf die Fassade, ohne das Tympanon zu erhellen. "
		    "So kommt es, dass Du, sobald Du Deinen Kopf zwischen "
		    "den Eingangssaeulen durchsteckst, Dich mit ihm im "
		    "Schatten eines fast waldartigen Gewoelbes befindest, "
		    "geformt aus Arkaden, die sich auf kleinen, die "
		    "Seitenwaende der Vorhalle stuetzenden Saeulen erheben. "
		    "Und kaum dass Deine Augen sich an das Dunkel gewoehnt "
		    "haben, trifft Dich wie ein Schlag die Rede des "
		    "bebilderten Sandes, die den Augen und der Phantasie "
		    "eines jeden verstaendlich ist (denn pictura est "
		    "laicorum liturae), und stuerzt Dich tief in eine "
		    "Vision. ")
		);
	  return 1;
	}
      if( wasdenn=="vision" )
	{
	  write(BS("Du siehst einen Thron, der gesetzt ist in den Himmel, "
		    "und auf dem Thron sitzt Einer, und Der Da Sitzt, ist "
		    "streng und erhaben anzusehen, die weitgeoffneten Augen "
		    "blicken funkelnd auf eine, ans Ende ihrer Tage gelangten "
		    "Menschheit. Praechtige Locken und ein majestaetischer "
		    "Bart umrahmen sein Antlitz und fallen auf seine Brust "
		    "gleich den Wassern eines Stromes in lauter "
		    "ebenmaessigen und symetrischen Wellen. Die Krone auf "
		    "seinem Haupte ist reich mit Gemmen und Edelsteinen "
		    "geschmueckt, das herrliche Purpurgewand, durchwoben mit "
		    "goldenen Litzen und Spitzen, umhuellt in weiten Falten "
		    "seine Gestalt. Mit der linken haelt auf dem Knie ein "
		    "versiegeltes Buch, die Rechte hebt er zu einer Geste, "
		    "von der Du nicht sagend kannst, ob sie segnend ist oder "
		    "drohend. Sein Antlitz leuchtet in der blenden "
		    "Schoenheit eines kreuzfoermigen und blumengeschmueckten "
		    "Heiligenscheins, und ein Regenbogen ist um den Thron, "
		    "anzusehen gleich einem Smaragd. Und vor dem Thron, zu "
		    "den Fuessen des, Der Da Sitzt, ist ein glaesernes Meer "
		    "wie aus Kristall, und um den Sitzenden, um seinen Thron "
		    "und darueber, siehst Du vier schreckliche Tiere - "
		    "schrecklich fuer Dich, der Du sie hingerissen "
		    "betrachtest, aber lieblich und suess fuer den "
		    "Sitzenden, dessen Lob sie singend ohn' Unterlass.\n"
		    "Genaugenommen kann man nicht von allen vier Tieren "
		    "sagen, dass sie schrecklich anzusehen sind, denn schoen "
		    "und edel erscheint Dir jenes in Menschengestalt, das "
		    "links von Dir (also zur Rechten des Sitzenden) ein Buch "
		    "in der Hand haelt. Aber erschaudern macht Dich auf der "
		    "anderen Seite ein Adler mit weitaufgerissenem Schnabel "
		    "und maechtigen Klauen, die borstigen Federn als "
		    "Schuppenpanzer gestaltet, die Schwingen wie zum Fluge "
		    "gebreitet. Und zu Fuessen des Sitzenden, unter den "
		    "beiden ersten Tieren, siehst Du einen Loewen und einen "
		    "Stier, beide halten ein Buch in ihren Pranken und "
		    "Hufen, beide haben den Koerper abgewandt vom Throne, "
		    "aber den Kopf zu ihm hin, als drehten sie gerade "
		    "Schulter und Hals in wildem Ungestuem, die Flanken "
		    "bebend, die tierischen Glieder zuckend, die Rachen "
		    "geoffnet, die Schwaenze gewunden wie Schlangen und "
		    "endend in kleinen zuengelnden Flammen. Beide waren "
		    "gefluegelt, beide gekroent mit Heiligenscheinen, und "
		    "waren trotz ihres furchtbaren Anblicks keine Geschoepfe "
		    "der Hoelle, sondern solche des Himmels, und wenn sie "
		    "mir schrecklich erschienen, so weil sie bruellten in "
		    "Anbetung dessen, der da kommen wird, zu richten die "
		    "Lebenden und die Toten. "
		    "Er, Der Da Sitzt, wendet Dir seinen Blick zu und sagt: "
		    "'Die Idee fuer diese Raeume stammt von Adson.'")
		   );
	  return 1;
	}
    }
  if( environment(TP)==this_object() )
    {
      if( wasdenn=="boden")
	{
	  write(BS("Der Boden besteht aus feinem, weissem Sand."));
	  return 1;
	}
      if( wasdenn=="sand")
	{
	  write(BS("Du laesst etwas von dem Sand durch Deine Finger rieseln "
		    "und geniesst es.")
		);
	  return 1;
	}
      if( wasdenn=="wand" || wasdenn=="waende" )
	{
	  write(BS("Die Waende sind mit Stoffbahnen behangen, damit man nicht "
		    "den Sand abschabt, wenn man sich dagegen lehnt. Waere "
		    "ja auch nicht angenehm, wenn einem dauernd Sand in die "
		    "Ruestung rieselt. Sowas kann irrsinnig jucken.")
		);
	  return 1;
	}
      if( wasdenn=="stoffbahnen" || wasdenn=="bahnen" || wasdenn=="stoff" )
	{
	  write(BS("Die Waende sind mit Bahnen aus gemustertem Stoff "
		    "behangen, die - zusammen mit dem sanften Licht - eine "
		    "gemuetliche Athmosphaere schaffen.")
		);
	  return 1;
	}
      if( wasdenn=="licht" )
	{
	  write(BS("Das Licht, das durch die Sanddecke gefiltert wird, hat "
		    "einen warmen, gelborangen Farbton und wirkt sehr "
		    "gemuetlich.")
		);
	  return 1;
	}
      if( wasdenn=="decke" )
	{
	  write(BS("Die Decke besteht aus einer sehr duennen und deshalb "
		    "lichtdurchlaessigen Sandschicht.")
		);
	  return 1;
	}
      if( wasdenn=="eingang" )
	{
	  write(BS("Durch den Eingang kannst Du das Meer sehen. Der Eingang "
		    "selber wirkt von dieser Seite aus weit weniger "
		    "spektakulaer als von draussen.")
		);
	  return 1;
	}
      if( wasdenn=="meer" || wasdenn=="strand" )
	{
	  write(BS("Durch den Eingang kannst Du das Meer sehen, wie es "
		 "immer gleich und doch jedesmal anders seine Wellen "
		 "den Strand hinaufschickt um sich anschliessend "
		 "wieder zurueckzuziehen.")
		);
	  return 1;
	}
    }
  return 0;
}


