
inherit "std/transport";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_NAME, "Segelboot" );
  AddId( ({ "boot", "segelboot" }) );
  SetProp( P_GENDER, NEUTER );
  SetProp( P_INT_SHORT, "Auf einem Segelboot." );
  SetProp( P_INT_LONG,
	 "Du sitzt in einem kleinen Segelboot, das von einer leichten "
	 "Brise getrieben, sanft ueber das Meer gleitet.");
  SetProp(P_SHORT, "Ein Segelboot" );
  SetProp(P_LONG,
	 "Ein kleines Segelboot.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  
  AddDetail( ({ "boot", "segelboot" }),
	"Das Boot ist nur ein ganz einfaches Modell. Es hat keine "
	"Kajuete oder so etwas. Nur ein Segel. Und das reicht.");

  AddDetail( ({ "kajuete" }),
	"Es gibt immer noch keine.");

  AddDetail( ({ "modell" }),
	"Es ist schon mehr als ein Modell. Aber ein grosses Boot ist "
	"es nicht.");

  AddDetail( ({ "segel" }),
	"An einem Mast haengt ein dreieckiges, weisses Segel.");

  AddDetail( ({ "mast", "stange" }),
	"Der Mast ist eine lange, hoelzerne Stange, die am Boden des "
    "Bootes befestigt ist.");

  AddDetail( ({ "boden" }),
	"Der Boden des Bootes ist wasserdicht. Du schickst dafuer ein "
    "kleines Dankgebet an Woody.");

  AddDetail( ({ "meer" }),
	"Das Meer erstreckt sich bis zum Horizont.");

  AddDetail( ({ "horizont" }),
	"Hinter dem Horizont gehts weiter. Weiter als Du glaubst.");



  /*** Meldungen, die Transporter geben koennen ***/
  
  SetProp( P_DEPARTMSG, 
	   ({ "Das Segelboot segelt los.\n", 
		"Das Segelboot legt ab und faehrt davon.\n"}) );
 
  SetProp( P_ARRIVEMSG, 
	   ({ "Das Segelboot legt @@QueryArrived@@ an.\n",
		"Ein kleines Segelboot legt an.\n" }) );

  SetProp( P_ENTERMSG, 
	   ({ "sitzt jetzt mit im Boot",
		"klettert in das Segelboot" }) );

  SetProp( P_LEAVEMSG, 
	   ({ "steigt aus dem Boot",
		"kletter aus dem Segelboot heraus" }) );

  SetProp( P_LEAVEFAIL, 
	   "Da Du sehr wasserscheu bist bleibst Du doch im Boot");

  SetProp( P_ENTERFAIL, "Es passen nur 3 Passagiere ins Boot" );

  SetProp( P_MAX_PASSENGERS, 3 );

  /* Verben */
  AddCmd( ({ "betritt", "betrete" }), "Enter" );
  AddCmd( ({ "verlasse" }), "Leave" );
  AddCmd( ({ "steig", "steige", "kletter", "klettere" }), "steige" );

  /* Kurs */
  AddRoute( PIER("room/plattform-o"), 15, 20, "an der Pier",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddMsg( "Das Segelboot rauscht bei frischem Wind nach Suedosten.\n", 10 );
  AddMsg( "Am Horizont sind Wolken zu sehen.\n", 10 );
  AddMsg( "Vor Dir taucht eine verregnete Insel aus dem Meer auf.\n", 10 );
  AddRoute( MAUROOM("strand03"), 15, 20, "am Strand einer Insel",
         ({"mauritius","insel"}), "nach Mauritius" );
  AddMsg( "Das Boot segelt nach Nordwesten.\n", 10 );
  AddMsg( "Die Pier taucht vor dem Bug auf.\n", 10 );
  Start();

}

int steige(string str)
{
  string arg, arg2;
  
  if(!str) return 0;  // Bugfix Feyaria
  if (sscanf( str, "in %s", arg ) > 0 && id(explode(arg," ")[0]))
    return Enter();
  if (sscanf( str, "aus %s", arg ) > 0 && id(explode(arg, " ")[0]))
    return Leave();
}


void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
       if (interactive(this_player()))
	 {
	   catch(call_other(PIER("room/plattform-o"), "???"));
	   catch(call_other(MAUROOM("strand03"), "???"));
	 }
}


