/*
**      Zuletzt geaendert am 21.01.1999
**
**      Anzahl der Details:
**      Normal:         10
**      Special:        00
**      Read:           00
**      Sounds:         04
**      Smells:         03
**      Befehle:        00
**      Ausgaenge:      02
**
** ueberarbeitet: 22.11.2001 Clementine@SL
*/

#include <properties.h>
#include <language.h>
#include "../mau.h"

inherit MAUROOM("str_inh");

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "An einem Sandstrand" );
  SetProp( P_INT_LONG,
     "Als Du Dich umschaust, faengst Du sofort damit an, im Kopf die "
	 "passende Flagge fuer diese Insel zu entwerfen: Ein gruener "
	 "Balken, ein weisser und zwei blaue (oder ein blauer, der "
	 "doppelt so dick ist wie die beiden anderen) und ein "
	 "gelber Punkt. Der gruene Balken steht fuer den dichten "
	 "Dschungel, in den der Strand uebergeht, welcher wiederum "
	 "durch den weissen Streifen symbolisiert wird und dessen "
	 "weisser Sand hier und da und hin und wieder vom Meer, "
	 "symbolisiert durch den blauen Balken Nr. 1 (oder die haelfte "
	 "des doppelt so dicken blauen Streifens), ueberspuelt wird. "
	 "Das Meer erstreckt sich bis zum Horizont, was Du daran "
	 "erkennst, dass Du ihn nicht erkennst weil das Meer scheinbar "
	 "nahtlos in den Himmel uebergeht, der durch den blauen "
	 "Balken Nr. 2 (oder die andere Haelfte des doppelt so dicken "
	 "blauen Streifens) versinnbildlicht wird. Der gelbe Punkt, "
	 "oder vielmehr seine Entsprechung in der Realitaet, ist "
	 "zwar gelb, kann jedoch guten Gewissens nicht als klein "
	 "bezeichnet werden, da es sich bei ihm schliesslich um eine "
	 "ausgewachsene Sonne handelt.");

  AddSound( DEFAULT_SOUND,
	"Du schliesst die Augen und nimmst fuer einen Moment die "
	"Welt nur durch Deine Ohren war. Du hoerst das Rauschen "
	"des Meeres, das etwas leisere Rauschen des Windes in den "
	"Wipfeln der Baeume und die leisen Schreie weit entfernter "
	"Seevoegel.");

  AddSmell( ({ DEFAULT_SMELL, "gerueche" }),
	"Du schliesst die Augen und konzentrierst Dich auf das, was "
	"Deine Nase Dir ueber Deine Umgebung mitteilt. "
	"Der Geruch des salzigen Meeres ueberlagert alle anderen, "
	"hier moeglicherweise vorhandenen Gerueche. Nur ab und zu "
	"meinst Du, ganz schwach den Geruch von Pflanzen "
	"wahrnehmen zu koennen.");

  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE:25]));  

  AddSound( ({ "meer", "rauschen" }),
	"Das Meer rauscht sanft gegen den Strand und wirkt "
	"irrsinnig beruhigend.");

  AddSound( ({ "wind", "baeume", "wipfel" }),
    "Das Rauschen des Windes in den Baeumen laesst Dich jeden "
	"Gedanken an Arbeit vergessen. Oder wenn schon nicht "
	"vergessen, dann wenigstens unbelastet ignorieren.");

  AddSound( ({ "voegel", "seevoegel", "schreie" }),
	"Die sporadischen Schreie von Seevoegeln dringen von so weit "
	"weg an Dein Ohr, dass Du sie mit den Augen nicht einmal "
	"ausmachen kannst.");

  AddSmell( ({ "meer" }),
	"Das Meer riecht ausgesprochen salzig.");

  AddSmell( ({ "pflanzen", "pflanze", "blume", "blumen", "geruch", "urwald",
		 "verursacher" }),
	"Du nimmst ganz schwach einen suessen, pflanzlichen Geruch "
	"wahr, der, welch Ueberraschung, aus der Richtung des "
	"Urwalds kommt. Du vermutest als Verursacher irgendeine "
	"dieser tropischen Blumen.");

  AddDetail( ({ "insel", "groesse" }),
	"Du stehst am Strand einer Insel, deren Groesse Du nicht "
    "richtig abschaetzen kannst, weil der hohe Dschungel Dir "
    "einen weiteren Blick versperrt.");

  AddDetail( ({ "flagge" }),
	"Die Flagge, die Du im Geiste entwirfst kannst Du auch nur "
    "in selbigem sehen.");

  AddDetail( ({ "dschungel", "blick", "wald", "urwald" }),
	"Der Dschungel ist sehr gruen und sehr dicht. Letzteres "
    "findest Du etwas laestig, weil das bedeutet, dass Du "
    "hier nicht in ihn reinkommen kannst.");

  AddDetail( ({ "balken", "streifen" }),
	"Du stellst Dir einen weissen, einen gruenen und zwei blaue "
	"vor.");

  AddDetail( ({ "punkt", "fleck", "sonne", "entsprechung" }),
	"Die Sonne ist ein blendender, grellgelber Fleck am Himmel, "
	"der eine angenehme Waerme spendet.");

  AddDetail( ({ "waerme" }),
	"Es ist hier am Strand angenehm warm.");

  AddDetail( ({ "himmel" }),
	"Der Himmel ist blau.\n"
    "Damit ist das wesentlich zwar schon gesagt, aber man darf "
	"das nicht zu geringschaetzig sehen. Dieser Himmel ist "
	"richtig blau. Ein so tiefes, wunderbares Azurblau, dass "
	"Du Dir am liebsten mit der Schere ein Stueck daraus "
	"herausschneiden wuerdest, um Dir daraus Kleider zu naehen. "
	"Angesichts der Tatsache, dass es um Deine naeherischen "
	"Faehigkeiten nicht so wahnsinnig rosig bestellt ist, "
	"setzt Du den Wunsch nicht in die Tat um. "
	"Ploetzlich faellt Dir etwas komisches auf. Der Himmel ist "
	"naemlich nur ueber dem Meer blau. Ueber dem Wald ist er "
    "grau! Igitt! Das passt doch ueberhaupt nicht in Dein "
	"Farbkonzept. Du beschliesst, diese Graeulichkeit zu "
	"ignorieren.");

  AddDetail( ({ "sand", "strand", "boden" }),
	"Der Sand am Strand ist weiss und so feinkoernig, dass es "
	"sicher nicht einfach waere, hier eine Sandburg zu bauen.");

  AddDetail( ({ "horizont" }),
	"Du kannst ihn kaum erkennen, weil Himmel und Meer beinahe "
	"das gleiche Blau haben.");

  AddDetail( ({ "meer" }),
	"Das Meer ist eine riesige Flaeche aus leicht "
    "unterschiedlichen Blautoenen, die sich gegen den Himmel "
	"fast ueberhaupt nicht abhebt.");

  // Neue Details vom 23.11.1998

  AddDetail( ({ "kopf", "ort" }),
	"Er sollte fest auf Deinen Schultern sitzen.");

  AddDetail( ({ "schultern" }),
	"Deine Schultern halten Deinen Kopf am passenden Ort fest.");

  AddDetail( ({ "sandburg" }),
	"Der Sand ist hier einfach zu fein. Es duerfte hier beinahe "
	"unmoeglich sein, eine Sandburg zu bauen.");

  AddDetail( ({ "blau", "azurblau" }),
	"Dieses blau ist so....blau! Wirklich beeindruckend.");

  AddDetail( ({ "kleider", "spiegel" }),
	"Schade, dass Du keine Spiegel dabei hast. Deine Kleider "
	"sind doch so schoen.");

  AddDetail( ({ "realitaet", "krempel" }),
	"Das ist sicher irgendsoein unnuetzer, neumodischer Krempel.");

  AddDetail( ({ "gewissen" }),
	"Entweder hast Du eines oder Du musst nicht wissen, was es "
    "ist.");


  AddExit( "nordosten", MAUROOM("strand11") );
  AddExit( "sueden", MAUROOM("strand03") );

  

}


