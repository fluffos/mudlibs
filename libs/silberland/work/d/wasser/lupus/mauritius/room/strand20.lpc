// SilberLand MUDlib
//
// /d/wasser/lupus/mauritius/room/strand20.c
//
// Am Strand von Mauritius. (Noerdlicher Urwaldeingang)
//
/*
 *      Zuletzt geaendert am 24.01.1999
**
**      Anzahl der Details:
**      Normal:         14
**      Special:        00
**      Read:           00
**      Sounds:         02
**      Smells:         02
**      Befehle:        01
**	Ausgaenge:	03
**
*/

inherit "/d/wasser/lupus/mauritius/room/str_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Am Strand" );
  SetProp( P_INT_LONG,
	"Hier macht der blendendweisse Sandstrand einen Knick von "
	"Suedwesten nach Suedosten, woraus Du messerscharf "
	"schliesst, dass Du grade an der Nordspitze der Insel stehst. "
	"Logischerweise befindet sich hier auch die Nordspitze des "
	"Urwalds, der das gesamte Inselinnere bedeckt. Die letzten "
	"Auslaeufer des Waldes bildet eine Gruppe von sieben "
	"Palmen. Zwischen ihnen fuehrt ein Weg in Innere der Insel.");
	
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );

  AddSound( DEFAULT_SOUND,
	"Um die Nordspitze der Insel rauscht laut und vernehmlich "
	"das Meer.");
  
  AddSound( "meer",
	"Um die Nordspitze der Insel rauscht laut und vernehmlich "
	"das Meer.");
	    
  AddSmell( DEFAULT_SMELL,
	"Der Geruch des Meeres ist das einzige, was Deine Nase "
	"erschnuppert.");
	    
  AddSmell( "meer",
	"Das Meer riecht ausgesprochen salzig.");
	    
  AddDetail( ({ "sandstrand", "strand" }),
	"Der Sandstrand erstreckt sich von hier aus nach Suedwesten "
	"und nach Suedosten. Wie auf der ganzen Insel besteht er "
	"aus feinstem, weissen Sand.");
	    
  AddDetail( "sand",
	"Der Sand ist weich und weiss. Und das, obwohl er nicht mit "
	"Weichspueler sondern nur mit einfachem Meerwasser "
	"gewaschen wird.");
	     
  AddDetail( "meer",
	"Du stellst fest, dass das Meer heute schon wieder voller "
    "Wasser ist. Voller Meerwasser um genau zu sein.");

  AddDetail( ({ "meerwasser", "wasser" }),
	"Du kannst es trinken.");
	    
  AddDetail( "weg",
	"Naja, ein breiter, bequemer oder gar ausgetretener Weg ist "
	"das nicht gerade, zugegeben. Aber es ist ein Weg in den "
	"Dschungel. Und so wie der Strand bis hier aussah koennte "
	"es sogar der einzige sein.");
	     
  AddDetail( ({ "urwald", "dschungel" }),
	"Der Urwald endet an dieser Stelle in eine Gruppe von Palmen. "
	"Weiter suedlich wird er dann immer dichter und "
	"geheimnisvoller. Vielleicht solltest Du ihn Dir einmal "
	"naeher anschauen?");
	     
  AddDetail( ({ "palmen", "gruppe" }),
	"Die sieben Palmen, die hier stehen, haben allesamt acht "
	"grosse, weit ausladende Blaetter. Ob das wohl eine "
	"tiefere Bedeutung hat?\n"
	"Von der Palme, die dem Meer am naechsten steht haengt "
	"eine Schaukel herab.");
	     
  AddDetail( ({ "schaukel"}),
	"Bei dieser Schaukel handelt es sich um ein einfaches Brett, "
	"das an zwei Seilen befestigt ist, die von der Palme "
	"runterhaengen. Apropos Palme: Auf dieser Palme scheint "
	"jemand ein Baumhaus gebaut zu haben. Ausserdem faellt Dir "
	"auf, dass am Fuss der Palme eine kleine Sitzbank steht.");
	     
  AddDetail( ({ "brett", "schaukelbrett" }),
	"Brett halt. Wie das Brett vor Deinem Kopf, das Du wohl haben "
	"musst, wenn Du nicht weisst was ein Brett ist.");
	     
  AddDetail( ({ "seil", "seile" }),
	"Die beiden Seile, die das Schaukelbrett halten sind "
	"irgendwie in der Krone der Palme verankert. Wie es "
	"aussieht befindet sich dort oben ein Baumhaus.");
	     
  AddDetail( ({ "bank", "sitzbank" }),
	"Am Fuss der Palme steht eine niedliche kleine Sitzbank aus "
	"weissen Marmor, der allerdings unter einer Last von "
	"Blueten kaum zu sehen ist.");
	    
  AddDetail( ({ "marmor" }),
	"Es handelt sich dabei um wunderschoenen, weissen Marmor.");
	     
  AddDetail( ({ "blueten" }),
    "Die Bank ist mit roten, weissen und rosanen Blueten "
	"uebersaeht. Da hier keine Blumen wachsen muss wohl jemand "
	"absichtlich Blueten ueber die Bank gestreut haben.");

  AddDetail( ({ "palme", "baum" }),
	"Die noerdlichste Palme unterscheidet sich dadurch von den "
    "anderen, dass an ihr eine Schaukel haengt.");
	     
  AddDetail( ({ "krone", "baumkrone"}),
	"In die Baumkrone hat wohl jemand ein Baumhaus gebaut.");
	     
  AddDetail( ({ "baumhaus", "haus"}),
	"Tatsaechlich, ueber Dir in der Krone der noerdlichsten "
	"der sieben Palmen befindet sich ein Baumhaus. Das ist "
	"erstaunlich, denn eigentlich sieht der Baum nicht so aus, "
	"als koennte er das Gewicht eines Baumhauses dieser "
	"Groesse stuetzen. Vielleicht solltest Du mal auf die "
	"Palme klettern und Dir das naeher ansehen.");
	     
  AddDetail( ({ "blaetter", "palmenblaetter" }),
	"Die Palmenblaetter sind breit, gruen und elend lang.");
	     
  AddDetail( ({ "spitze", "nordspitze", "insel", "inselspitze" }),
	"Du stellst Dich an den Punkt an dem die Insel zum Meer "
	"wird und breitest die Arme weit aus. Du fuehlst Dich wie "
	"die Gallionsfigur eines maechtigen Schiffes.\n"
	"Irgendwie bringst Du es fertig, den ploetzlichen Drang, "
	"'I'm king of the world!' zu bruellen, zu unterdruecken.");
	     
  AddDetail( ({ "boden", "waldboden" }),
	"Der Boden geht am Waldrand vom weichen Sand des Strandes "
    "in lockeren Waldboden ueber.");
	     
  AddDetail( ({ "inneres", "inselinneres", "innere", "inselinnere" }),
	"Das Innere der Insel ist von dichtem Dschungel bedeckt.");
  
  AddDetail( "waldrand",
	"Der Waldrand ist eine gruene Mauer, die Du nur auf dem Weg, "
	"der zwischen den Palmen hindurchfuehrt durchdringen "
	"kannst.");
	


  AddCmd( ({ "trink", "trinke" }), "trinker" );
  AddCmd( ({ "kletter", "klettere", "steige", "steig", 
	       "besteige", "besteig" }), "palmen_kletter" );
  
  AddExit( "suedwesten", MAUROOM("strand11") );
  AddSpecialExit( "suedosten", "gehe_hin" );
  AddExit( "sueden", MAUROOM("wald00") );

}

int trinker()
{
  write(BS("Du trinkst einen Schluck Meerwasser.\n"
	     "Du hast Dich geirrt. Man kann dieses Wasser doch nicht "
	     "trinken. *baeh*") );
  return 1;
}

int gehe_hin()
{
  write(BS("Du willst nach Suedosten gehen, stellst aber nach ein paar "
	    "Metern fest, dass der Strand von einem Drachen bewacht wird. "
	    "Du stellst auch fest, dass Du mindestens 300 starke Seher "
	    "braeuchtest, um diesen Drachen zu besiegen. Da so viele Leute "
	    "nicht gleichzeitig eingeloggt sein koennen gibst Du kampflos "
	    "auf und kehrst um.") );
    return 1;
}

int palmen_kletter( string str )
{
  string wohin;

  notify_fail( BS("Wohin willst Du denn klettern?") );
  if( !str ) return 0;
  else if( sscanf( str, "auf %s", wohin )==1 
	   && ( lower_case(wohin)=="palme" || lower_case(wohin)=="baum" ) )
    {
      write(BS("Du kletterst geschickt den Stamm der Palme hoch und "
		"erreichst den Boden des Baumhauses. Verdutzt haeltst Du "
		"inne. Das Ding ist riesig! Dieser Baum kann dieses "
		"Baumhaus...nein, diese Baumvilla! unmoeglich tragen. "
		"Als Du durch ein grosses Loch im Boden des Hauses "
		"ins Innere kletterst, begreifst Du ploetzlich, warum "
		"dieses Baumhaus hier trotz seiner Unmoeglichkeit "
		"existiert: Auf einem kleinen Schild an der Unterseite "
		"steht geschrieben: 'Lupus, Regionsmagier von Woodys "
		"Gnaden'.\n"
		"Laechelnd ziehst Du Dich hoch und schaust Dich um.") );
	     
      TP->move( MAUROOM("workroom"), M_GO, "auf eine Palme",
		"klettert",
		"Kommt herein" );
      return 1;
    }
}
