inherit "/d/wasser/lupus/mauritius/room/str_inh";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "An einem Sandstrand" );
  SetProp( P_INT_LONG,
    "Du stehst am Strand einer tropischen Insel. Dein Blick "
    "schweift den langen Sandstrand entlang, beruehrt den Wald, "
    "der Dir den Blick weiter ins Inselinnere verbirgt, und "
    "bleibt endlich an dem unendlichen blauen Meer haengen, in "
    "das ein kurzer Steg hineinreicht.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );

  AddSound( ({ DEFAULT_SOUND, "insel" }),
    "Du hoerst nur die Geraeusche einer menschenleeren Insel: "
    "Meeresrauschen, den Wind in den Baumwipfeln und Geraeusche, "
    "die von Tieren zu stammen scheinen.");

  AddSmell(DEFAULT_SMELL,
    "Du riechst hier nur das salzige Meer.");

  AddSound( ({ "meer", "meeresrauschen" }),
    "Das Meer rauscht leise, wenn sich eine Welle auf dem Strand "
    "auslaeuft und etwas lauter, wenn sich eine Welle am Steg "
    "bricht.");

  AddSound( ({ "welle" }),
    "Eine Welle an sich ist ziemlich lautlos. Erst wenn sie bricht "
    "faengt sie an zu rauschen. Da es allerdings auf einem Meer "
    "ziemlich viele Wellen und an einem Strand ziemlich viele "
    "Gruende zum Brechen gibt (jedenfalls fuer Wellen) rauscht "
    "es hier ziemlich regelmaessig.");

  AddSound( ({ "wind", "windrauschen" }),
    "Der Wind erzeugt, wenn er die Baumwipfel streift ein "
    "Rauschen, das zwar leiser, dafuer aber stetiger ist, als "
    "das des Meeres.");

  AddSound( ({ "rauschen" }),
    "Du hoerst hier zwei verschiedene Arten des Rauschens: Das "
    "Rauschen des Meeres und das Rauschen des Windes.");

  AddSound( ({ "geraeusche", "tiere" }),
    "Aus der Richtung des Waldes dringen die Geraeusche von Tieren "
    "an Dein Ohr. Sie klingen allerdings so, als ob die Tiere "
    "weit entfernt waeren.");

  AddSmell( ({ "meer" }),
    "Das Meer ueberlagert mit seinem salzigen Atem jeden anderen "
    "Geruch.");

  AddSpecialDetail( "insel", "inselschauer" );

  AddDetail( ({ "sandstrand", "strand" }),
    "Der Strand ist hier recht breit und so weiss, wie man sich "
    "das nur wuenschen kann.");

  AddDetail( ({ "sand" }),
    "Der Sandstrand besteht aus reinstem, weissen Sand.");

  AddDetail( ({ "wald", "vegetation" }),
    "Der Wald ist eine gruene Mauer, die das Inselinnere vom "
    "Strand abschottet. Nirgends kannst Du eine Luecke in der "
    "dichten Vegetation entdecken.");

  AddDetail( ({ "mauer" }),
    "Auch wenn der Ausdruck Mauer eher symbolisch gemeint war ist "
    "der Wald hier doch so dicht, dass Du ebensowenig durch ihn "
    "hindurchkommen kannst wie Du das bei einer Mauer "
    "koenntest.");

  AddDetail( ({ "innere", "inneres", "inselinnere", "inselinneres" }),
    "Das Inselinnere bleibt Dir wegen des sichtbegrenzenden "
    "Waldes verborgen.");

  AddDetail( ({ "meer" }),
    "Das Meer, ueber das Du die Insel erreicht hast, scheint den "
    "Himmel darueber wiederzuspiegeln und ihm in der Auswahl "
    "der schoensten Blautoene Konkurrenz zu machen.");

  AddDetail( ({ "steg" }),
    "Der Steg ist vielleicht 15 Meter lang und sehr einfach "
    "gebaut. Nur ein paar Planken, die auf ein Geruest aus "
    "dicken Holzbohlen genagelt wurden.");

  AddDetail( ({ "planken" }),
    "Die Planken sind durch Naegel mit dem Unterbau verbunden und "
    "voellig uninteressant.");

  AddDetail( ({ "naegel", "koepfe" }),
    "Da die Naegel in die Planken genagelt sind kannst Du nur "
    "ihre Koepfe sehen. So langweilig wie die sind kannst Du "
    "auf den Rest von ihnen gut verzichten.");

  AddDetail( ({ "geruest", "bohlen", "holzbohlen", "unterbau" }),
    "Den Unterbau des Stegs bilden einige in den Boden des hier "
    "noch ziemlich flachen Meeres gerammte Holzbohlen.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht ganz aus feinem Sand. Wie das an einem "
    "Sandstrand halt so ist.");

  AddDetail( ({ "meeresboden" }),
    "Der Meeresboden ist durch das kristallklare Wasser gut zu "
    "erkennen. Was Du erkennst ist Sand. Dieser helle "
    "Untergrund ist es wohl, der dafuer sorgt, dass das Meer "
    "so herrlich blau ist.");

// Neue details vom 16.11.98 Merke: wenn die Hausarbeit vorbeit ist geht 
// alles leichter. :)

  AddDetail( ({ "ausdruck" }), 
    "Der Ausdruck Ausdruck kommt Dir irgendwie bekannt vor.");

  AddDetail( ({ "luecke" }),
    "Wenn Du nicht weisst, was eine Luecke ist, hast Du eine "
    "in Deiner Bildung.");

  AddDetail( ({ "bildung" }),
    "Wenn Du auch nicht weisst, was Bildung ist, scheint die "
    "Luecke (siehe dort) noch groesser zu sein, als es zuerst "
    "moeglich zu sein schien.");

  AddDetail( ({ "ohr" }),
    "Du hast Dich wohl in letzter Zeit nicht oft aufs Ohr "
    "gehauen. Sonst wuesstest Du naemlich, was das ist.");

  AddDetail( ({ "zeit" }),
    "Ja, was ist Zeit? Heute sind wir wieder sehr philosophisch, "
    "nicht wahr?");

  AddDetail( ({ "baumwipfel", "wipfel" }),
    "Die Baumwipfel sind die gruenen Dinger an den braunen "
    "Dingern.");

// Am 17.11 gehts weiter mit den Details. Hat gestern einfach zu lange 
// gedauert, /d/wasser zu ftpen. (Wer ausser mir wird das hier 
// ueberhaupt jemals lesen?
// hehe, ich :) lg cleme ;)


  AddDetail( ({ "dinger", "ding"}),
    "Na so Dinger halt. Du weisst schon.");

  AddDetail( ({ "himmel" }),
    "Ueber dem Meer ist der Himmel wolkenlos und strahlt in "
    "herrlichstem Blau. Ganz anders sieht die Sache ueber dem "
    "Inselinneren aus. Dort haengen dunkle Regenwolken. Die "
    "Grenze zwischen den beiden Wettergebieten scheint direkt "
    "ueber dem Strand zu verlaufen.");

  AddDetail( ({ "wettergebeiete", "gebiete", "wettergebieten", "wetter" }),
    "Ueber dem Meer herrscht eitel Sonnenschein, ueber dem Wald "
    "regnet es.");

  AddDetail( ({ "blick" }),
    "Der Blick auf das Meer und den Strand entlang ist Dir nicht "
    "verwehrt. Nur das Inselinnere kannst Du wegen des "
    "hohen und dichten Waldes nicht sehen.");

  AddDetail( ({ "blau", "himmelblau", "meerblau" }),
    "Der Himmel ist Himmelblau, das Meer mehr Meerblau.");

  AddDetail( ({ "sache", "sachen", "gesetz", "gegenstand", "gegenstaende",
    "sinn"}),
    "Sachen im Sinne des Gesetzes sind nur koerperliche "
    "Gegenstaende.");

  AddDetail( ({ "regenwolken", "wolken" }),
    "Die Regenwolken scheinen nur darauf zu warten, dass Du "
    "ihnen so nahe kommst, dass sie Dich bis auf die Haut "
    "durchnaessen koennen.");

  AddDetail( ({ "haut" }),
    "Du betrachtest fuer einen Moment Deine nackte Haut.");

  AddDetail( ({ "moment" }),
    "Grade ist wieder einer vorbei.");

  AddDetail( ({ "grenze" }),
    "Es ist wirklich seltsam: Die Grenze zwischen dem guten und "
    "dem schlechten Wetter verlaeuft genau ueber dem Strand.");


// Neue Details vom 1.12.2004 - Clementine

  AddDetail( ({ "holz" }),
    "Die Holzbohlen bestehen natuerlich aus Holz. Du "
    "nimmst an, dass es direkt von der Insel stammt. ");

  AddDetail( ({ "blautoene", "toene" }),
    "Sie sind wunderschoen!");

  AddDetail( ({ "konkurrenz" }),
    "Das Meer macht dem Himmel hier wirklich Konkurrenz. ");

  AddDetail( ({ "wasser" }),
    "Das Meer scheint hier schier unendlich zu sein. ");


  AddExit( "norden", MAUROOM("strand02") ); 
  AddExit( "osten", MAUROOM("strand13") ); 


}

string inselschauer()
{
   if(TP->QueryProp(P_RACE)=="Zwerg") 
   	return BS("Naja, im Prinzip kannst Du von hier aus gar nicht erkennen, "
		  "ob Du hier auf einer Insel oder einer zu einem "
		  "vollstaendigen Kontinent gehoerigen Halbinsel stehst. Da "
		  "Du aber sehr selbstbewusst bist gehst Du einfach mal "
		  "davon aus, dass Du recht hast, wenn Du davon ausgehst, "
		  "dass dies hier eine Insel ist.");
   if(TP->QueryProp(P_RACE)=="Elf" || TP->QueryProp(P_RACE)=="Fee" ) 
   	return BS("Zugegeben, von hier aus hast Du keine Moeglichkeit, zu "
		  "ueberpruefen, ob das hier eine Insel ist oder nicht. "
		  "Zum Glueck bist Du aber nicht auf den Kopf gefallen und "
		  "hast waehrend der Ueberfahrt aufgepasst. Und vom Meer "
		  "aus konntest Du deutlich sehen, dass dies hier nur eine "
		  "Insel ist.");
   if(TP->QueryProp(P_RACE)=="Mensch") 
   	return 
   	BS("Oeh, naja, Du hattest eigentlich gedacht, das hier waere ne "
	   "Insel, aber jetzt, wo Du so drueber nachdenkst...gesehen hast "
	   "Du es ja nicht direkt. Verdammt, wenn Du nur auf dem Segelboot "
	   "besser aufgepasst haettest, von da aus haette man es sicher "
	   "erkennen koennen. Naja, Du wirst wohl mit der Arbeitshypothese "
	   "leben muessen, dass dies hier eine Insel ist.");
   if(TP->QueryProp(P_RACE)=="Hobbit") 
   	return 
   	BS("Jo, das hier ist eine Insel. Ein Stueck Land mit Wasser "
	   "drumherum. Denkst Du jedenfalls.");
   else 
     return BS("Du stehst am Strand einer tropischen Insel. Dein Blick "
	       "schweift den langen Sandstrand entlang, beruehrt den Wald, "
	       "der Dir den Blick weiter ins Inselinnere verbirgt, und "
	       "bleibt endlich an dem unendlichen blauen Meer haengen, in "
	       "das ein kurzer Steg hineinreicht.");
   
}

init()
{
  ::init();
  call_other(MAUROOM("strand24"), "???");
  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}


