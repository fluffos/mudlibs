// SilberLand MUDlib
//
// /d/wasser/lupus/mauritius/room/strand11.c
//
// Am Strand von Mauritius.
//
/*
**      Zuletzt geaendert am 21.01.1999
**
**      Anzahl der Details:
**      Normal:         07
**      Special:        00
**      Read:           03
**      Sounds:         00
**      Smells:         02
**      Befehle:        00
**	Ausgaenge:	02
**
*/

inherit "/d/wasser/lupus/mauritius/room/str_inh";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Am Strand" );
  SetProp( P_INT_LONG,
    "Wie ein langer, weisser Pinselstrich zieht sich der "
    "Sandstrand von der Stelle, wo er im Nordosten hinter einer "
    "Palmengruppe aus Deiner Sicht verschwindet bis zu Deinen "
    "Fuessen (die uebrigens mal wieder gewaschen gehoeren). "
    "Eingerahmt wird er von dem sich majestaetisch bis zum "
    "Horizont erstreckenden Meer auf der einen und dem in allen "
    "Abstufungen der Farbe gruen schillernden Urwald auf der "
    "anderen Seite.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );


// SMELLS


  AddSmell( DEFAULT_SMELL,
    "Du riechst nur das salzige Meer.");

  AddSmell( ({ "meer" }),
    "Das Meer riecht ausgesprochen salzig. ");


// SOUNDS


  AddSound(DEFAULT_SOUND,
    "Das Rauschen des Meeres uebertoent alle anderen moeglicherweise "
    "vorhandenen Geraeusche. ");

  AddSound( ({ "meer", "rauschen" }),
    "Das Rauschen des Meeres ist hier so laut, dass Du nichts "
    "anderes hoerst. Oder natuerlich ist alles andere so leise, "
    "dass Du nur das Meer hoeren kannst.");

  AddSound( ({ "geraeusch", "alles", "andere" }),
    "Du hoerst nichts ausser dem Meer.");

  AddSound( ({ "ruf" }),
    "Der Urwald ruft nicht wirklich. Das war mehr im uebertragenen Sinn "
    "gemeint. ");


// DETAILBEGINN 


  AddDetail( ({ "palmengruppe", "palmen", "gruppe" }),
    "Die Palmengruppe ist zu weit weg, um genaueres erkennen zu "
    "koennen.");

  AddDetail( ({ "pinselstrich", "strich" }),
    "Du siehst hier keinen Pinselstrich.\n"
    "Du stellst Dir bloss einen vor.");

  AddDetail( ({ "strand", "sandstrand", "linie" }),
    "Der Strand ist eine lange, weisse Linie aus feinstem Sand.");

  AddDetail( ({ "sand" }),
    "Du hebst eine Handvoll Sand auf. Er beginnt Dir sofort "
    "zwischen den Fingern hindurch zu rinnen. Kurze Zeit "
    "spaeter schaust Du nur noch auf Deine leere Hand.");

  AddDetail( ({ "meer" }),
    "Das Meer schillert in allen Abstufungen von Blau.");

  AddDetail( ({ "horizont", "grenze" }),
    "Der Horizont bildet die Grenze zwischen dem blauen Meer "
    "und dem ebenfalls blauen Himmel.");

  AddDetail( ({ "urwald", "wald" }),
    "Der Urwald ist irrsinnig gruen und irrsinnig dicht. Er sieht "
    "sehr geheimnisvoll aus, was Dich unwiderstehlich "
    "anzieht, aber auch sehr dicht, was Dich davon ueberzeugt, "
    "ihm, dem Ruf des Urwalds doch noch ein Weilchen zu "
    "widerstehen.");


// Neue Details vom 23.11.1998

  AddDetail( ({ "finger" }),
    "Du bewunderst fuer einen Augenblick die elegante "
    "Linienfuehrung Deiner Hand.");

  AddDetail( ({ "zeit" }),
    "Du zaehlst langsam von eins bis zehn. Zeit ist vergangen.");

  AddDetail( ({ "stelle", "biegung" }),
    "Noerdoestlich von Dir verschwindet der Strand an einer "
    "Stelle, die durch eine Gruppe von Palmen markiert ist, "
    "hinter einer Biegung.");

  AddDetail( ({ "fuesse", "zeh" }),
    "Du begruesst freundlich Deinen grossen Zeh.");

  AddDetail( ({ "himmel" }),
    "Auch hier herrscht am Himmel die Trennung zwischen Land und "
    "Meer. Ueber dem Meer ist keine einzige Wolke zu sehen, "
    "ueber dem Wald nichts anderes.");

  AddDetail( ({ "land" }),
    "Unter Land ist hier der Strand und der Urwald zu verstehen.");

  AddDetail( ({ "wolke", "wolken" }),
    "Wolken ueber dem Meer gibt es nicht. Die draengen sich "
    "naemlich alle ueber dem Urwald zusammen.");


// Neue Details vom 1.12.2004 - Clementine

  
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus feinstem weissen Sand. ");

  AddDetail( ({ "abstufungen" }),
    "Der Urwald leuchtet wirklich in allen moeglichen Gruentoenen. ");

  AddDetail( ({ "gruentoene", "gruenton", "farbe" }),
    "Es sind soviele verschiedene Gruentoene, dass Du erst gar nicht "
    "anfaengst sie alle zu zaehlen. ");

  AddDetail( ({ "seite" }),
    "Der Strand ist auf der einen Seite vom Meer, und auf der anderen "
    "vom Urwald eingerahmt. ");


  AddExit( "nordosten", MAUROOM("strand20") );
  AddExit( "suedwesten", MAUROOM("strand02") );


}


