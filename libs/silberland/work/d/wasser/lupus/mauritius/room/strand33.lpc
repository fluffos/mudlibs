/*
**      Zuletzt geaendert am 21.01.1999
**
**      Anzahl der Details:
**      Normal:         06
**      Special:        00
**      Read:           00
**      Sounds:         01
**      Smells:         02
**      Befehle:        00
**	Ausgaenge:	03
**
*/

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../mau.h"

inherit MAUROOM("str_inh");

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Am Strand" );
  SetProp( P_INT_LONG,
	"Es ist warm, die Sonne scheint. Du entspannst Dich und "
	"schliesst die Augen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );
  
  AddSound( ({ DEFAULT_SOUND, "insel" }),
	"Du kannst verschiedene Dinge rauschen hoeren.");
	   
  AddSound( ({ "dinge", "ding", "rauschen", "arten", }),
	"Du kannst zwei Arten von Rauschen unterscheiden. Das eine, "
	"suedlich und oestlich von Dir, klingt nach grossen "
	"Mengen von Wasser, die auf ein Hindernis prallen. Das "
	"andere kommt eher aus nordwestlicher Richtung und "
	"kommt mehr von oben.");
	     
  AddSound( ({ "mengen", "wasser", "meer", "wasserrauschen" }),
	"Na logisch. Du bist hier auf einer Insel. Also muss das "
	"Wasserrauschen das Meer sein.");
	     
  AddSound( ({ "hindernis", "ufer" }),
	"Als Hindernis fuer Wasser kannst Du Dir am ehesten ein Ufer "
	"vorstellen.");
	     
  AddSound( ({ "andere", "anderes", "oben" }),
	"Du hoerst genau hin und erkennst schnell, dass Du hoerst, "
	"wie der Wind die Blaetter eine Waldes gegeneinander "
	"reibt.");
	     
  AddSound( ({ "wind" }),
	"Den Wind selber kannst Du nicht hoeren.");
	     
  AddSound( ({ "blaetter" }),
	"Die Blaetter rauschen wunderbar sanft. Bloss genau im "
	"Norden scheint eine Luecke im Rauschen zu sein.");

  AddSound( ({ "norden", "luecke", "stelle" }),
	"Im Norden scheinen an einer Stelle keine Baeume zu stehen. "
	"Was das wohl bedeuten mag?");
	     
  AddSmell( ({ DEFAULT_SMELL, "luft" }),
	"Du kannst Salz und Pflanzen riechen.");

  AddSmell( ({ "salz" }),
	"Soviel Salz in der Luft! Wo kann das herkommen?");

  AddSmell( ({ "pflanzen", "baeume", "blumen" }),
	"Im Norden kannst Du den Geruch von verschiedenen Baeumen, "
	"Blumen und anderen Pflanzen riechen. Aus suedwestlicher "
	"Richtung erreicht Dich noch ganz schwach ein Geruch.");
	    
  AddSmell( ({ "geruch" }),
	"Du bist zu weit weg.");
	   

  AddCmd( ({ "schau", "untersuche" }), "nix_schau" );
  
  AddCmd( "norden", "norden" ); 
  AddCmd( "nordosten", "gehe_hin" ); 
  AddCmd( "suedwesten", "suedwesten" ); 
  
}

int gehe_hin()
{
  write(BS("Du willst nach Nordosten gehen, stellst aber nach ein paar "
	    "Metern fest, dass der Strand von einem Drachen bewacht wird. "
	    "Du stellst auch fest, dass Du mindestens 300 starke Seher "
	    "braeuchtest, um diesen Drachen zu besiegen. Da so viele Leute "
	    "nicht gleichzeitig eingeloggt sein koennen gibst Du kampflos "
	    "auf und kehrst um.") );
    return 1;
}

int norden()
{
  return TP->move( MAUROOM("wald11"), M_GO, 0, "geht", "kommt an");
}

int suedwesten()
{
  return TP->move( MAUROOM("strand24"), M_GO, 0, "geht", "kommt an");
}

int nix_schau()
{
  write(BS("Du hast die Augen zu. Da kannst Du nichts sehen. Und aufmachen "
	    "magst Du Deine Augen auch grade nicht.") );

  return 1;
}

