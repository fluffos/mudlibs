// SilberLand MUDlib
//
// /d/wasser/lupus/mauritius/strand24.c
//
// Am Strand bei der Sandburg.
//
/*
**      Zuletzt geaendert am 21.01.1999
**
**      Anzahl der Details:
**      Normal:         12
**      Special:        00
**      Read:           00
**      Sounds:         04
**      Smells:         02
**      Befehle:        00
**	Ausgaenge:	02
**
*/


inherit "/d/wasser/lupus/mauritius/room/str_inh";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Am Strand" );
  SetProp( P_INT_LONG,
	"Du stehst hier an der suedlichsten Stelle der Insel. Dem "
	"Strand ist hier anscheinend ein Riff vorgelagert, so dass "
	"das Wasser voellig ruhig ist. Die Tatsache, dass der "
	"Strand hier auch sehr breit ist, hat anscheinend jemand "
	"genutzt, um eine Sandburg zu bauen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );

  AddSound( DEFAULT_SOUND,
	"Es ist hier ausgesprochen ruhig. Da dem Ufer ein Riff "
	"vorgelagert ist, dringt das Geraeusch der Brandung nur noch "
	"schwach an Deine Ohren und der laue Wind in den Wipfeln "
	"der Baeume macht auch nicht gerade einen Hoellenlaerm.");

  AddSound( ({ "meer", "getoese", "brandung", "geraeusch" }),
	"Ein Stueck vor der Kueste bricht sich die Brandung an einem "
	"Riff. Das Getoese, das sie dabei sicher veranstaltet, ist "
	"hier am Strand nur noch sehr leise.");

  AddSound( ({ "wind", "baeume", "rauschen" }),
	"Der Wind in den Baeumen erzeugt ein leises aber stetiges "
	"Rauschen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach dem Salz des Meeres.");

  AddSmell( ({ "salz", "meer" }),
	"Das Meer riecht salzig.");
	    
  AddDetail( ({ "strand", "kueste", "ufer", "boden" }),
	"Der Strand ist hier recht breit und - wie ueberall auf der "
	"Insel - aus wunderbar weichem, weissen Sand. Obwohl der "
    "Sand hier eigentlich zu fein dafuer zu sein scheint, hat "
	"es jemand fertiggebracht, hier eine Sandburg zu bauen.");

  AddDetail( "riff",
	"Der Insel ist an ihrer Suedspitze (an der Du Dich grade "
	"befindest) offenbar ein Riff vorgelagert. Du kannst von "
	"hier aus sehen, wie sich die Brandung daran bricht.");

  AddDetail( ({ "wasser", "meer" }),
	"Das Meer ist weiter draussen, hinter dem Riff, dunkelblau. "
	"Da wo es gegen das Riff trifft schmaeumt es weiss und "
	"hier, zwischen Strand und Riff ist es hellblau.");

  AddDetail( "sand",
	"Der Sand ist weiss und weich und ausserdem teilweise in "
	"eine Sandburg eingebaut worden.");

  // Neues vom 17.11.1998

  AddDetail( ({ "stelle", "insel", "wanderung", "weg", "punkt",
		  "suedspitze" }),
	"Wenn Dein Weg Dich gen Sueden fuehrt, dann solltest Du "
	"Dir ein Schiff suchen. Hier ist naemlich der "
	"suedlichste Punkt der Insel und damit fuer eine "
	"Wanderung Schluss.");

  AddDetail( ({ "sueden" }),
	"Das Gegenteil von Norden.");

  AddDetail( ({ "norden" }),
	"Ach Gott, Du musst aber auch wirklich jedes Detail "
	"anschauen...");

  AddDetail( ({ "detail" }),
	"Jetzt ist aber langsam gut, ja? :)");

  AddDetail( ({ "brandung" }),
	"Ein Stueck vor der Kueste bricht sich die Brandung an einem "
	"Riff. Das Getoese, das sie dabei sicher veranstaltet, ist "
	"hier am Strand nur noch sehr leise.");
	
  // Neues vom 18.11.1998

  AddSound( ({ "hoellernlaerm", "laerm" }),
    "Sowas hoerst Du hier nicht.");

  AddDetail( ({ "himmel" }),
	"Du schaust nach oben und siehst in einen strahlend... "
	"Moment. Du schaust in einen Himmel, der teils "
	"strahlend blau, teils aber auch regengrau ist. "
	"Ueber dem Wald faengt ein Gebiet mit dunklen "
	"Wolken an.");
	     
  AddDetail( ({ "wolken"}),
	"Diese Wolken sehen sehr nieder- und regentraechtig aus.");
	     
  AddDetail( ({ "wald", "wipfel" }),
    "Der Wald bildet weiter noerdlich die natuerliche Grenze des "
	"Strandes.");


  AddItem( MAUOBJ("sandburg"), REFRESH_DESTRUCT, 1);

  AddExit( "nordwesten", MAUROOM("strand13") );
  AddExit( "nordosten", MAUROOM("strand33") );
  
}

