#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "/players/lupus/.defines.h"

void create()
{
  string WIZNAME;
  
  ::create();
  WIZNAME = capitalize(getuid(this_object()));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Der Lebensraum vom Lupus" );
  SetProp(P_INDOORS,1);
  SetProp( P_INT_LONG, 
	   BS("Das hier soll das Arbeitszimmer eines Magiers sein?\n"
	      + "Am einem  Fenster zur See hin ist ein Bett aufgestellt, das "
	      + "sehr weich ausgestattet ist, mit Kissen auf beiden Seiten "
	      + "und einer darueber ausgebreiteten weissen Decke.\n"
	      + "Am Kopfende ist eine Opferbank angebracht, darueber ist ein "
	      + "schmaler Sims. In einer Ecke des Raumes steht eine "
	      + "Staffelei, neben der eine Malerpalette liegt. Nicht weit "
	      + "davon hat man eine runde Matte auf den Fussboden gelegt und "
	      + "ein Kissen darauf. Ausserdem findet sich hier auch ein "
	      + "Tischchen fuer Wuerfelspiele und eines fuer andere Spiele.")
	      );
  AddDetail( ({ "sims", "grasbueschel" }),
	     BS("Auf dem schmalen Sims ueber der Opferbank liegen einige "
		+ "Grasbueschel.")
	     );
  AddDetail( ({ "opferbank" }),
	     BS("Auf der Opferbank stehen Salbentiegel, Kraenze, ein Gefaess "
		+ "mit gekochtem Reis, eine Schale mit Parfuem, Rinde vom "
		+ "Zitronenbaum und Betelnuesse.\n"
		+ "Anscheinend nehmen auch die Magier ihre Pflichten "
		+ "gegenueber den Goettern ernst.")
	     );
  AddDetail( ({ "salbentiegel", "tiegel", "salben" }),
	     BS("Auf der Opferbank stehen einige Tiegel mit verschiedenen "
		+ "wohlriechenden Salben.")
	     );
  AddDetail( ({ "kraenze" }),
	     BS("Auf der Opferbank liegen zwei aus frischen Blumen "
		+ "geflochtene Kraenze.")
	     );
  AddDetail( ({ "gefaess", "reis", "schale" }),
	     BS("In einer Schale auf der Opferbank findest Du etwas gekochten "
		+ "Reis. Obwohl Du Hunger hast verzichtest Du aus Respekt "
		+ "vor den Goettern darauf, den Reis zu essen.")
	     );
  AddDetail( ({ "parfuem", "parfum" }),
	     BS("Das Parfum hat eine hellblaue Farbe.")
	     );
  AddDetail( ({ "rinde" }),
	     BS("Die Rinde des Zitronenbaums verstroemt einen angenehmen "
		+ "Duft.")
	     );
  AddDetail( ({ "betelnuesse", "nuesse" }),
	     BS("Das die Betelnuesse eine Opfergabe fuer die Goetter sind, "
		+ "laesst Du sie liegen.")
	     );
  AddDetail( ({ "bett" }),
	     BS("Das Bett sieht ungeheuer weich aus...und ausserdem so, als "
		+ "wuerde es haeufig benutzt. Die ueber das Bett gebreitete "
		+ "Decke ist ziemlich verkrumpelt. Defintiv wird dieses Bett "
		+ "ziemlich haeufig benutzt.\n"
		+ "Am Fuss des Bettes steht ein Spucknapf.")
	     );
  AddDetail( ({ "decke"}),
	     BS("Die Decke, die ueber das Bett gebreitet ist verbirgt im "
		+ "Moment zwar lediglich das Bettlaken und die Matratze, Du "
		+ "bist Dir aber sicher, dass sie hin und wieder auch "
		+ "wesentlich interessantere...Dinge...verbirgt.")
	     );
  AddDetail( ({ "kissen" }),
	     BS("Am Kopf- und am Fussende des Bettes liegen einige grosse, "
		+ "seidene Kissen. So verbeult wie sie aussehen werden sie "
		+ "wohl des oefteren zu Kissenschlachten herangezogen.")
	     );
  AddDetail( ({ "spucknapf" }),
	     BS("Der Spucknapf am Fussende des Bettes ist Gott sei Dank leer.")
	     );
  AddDetail( ({ "fenster"}),
	     BS("Durch das Fenster hat man einen wunderbaren Ausblick auf das "
		+ "tiefblaue Meer. Ein herrlicher Ort zum Traeumen.\n"
		+ "Du glaubst, von draussen den Gesang von Voegeln zu hoeren.")
	     );
  AddDetail( ({ "meer" }),
	     BS("Das Meer ist tiefblau und glitzert im Sonnenlicht.")
	     );
  AddDetail( ({ "sonnenlicht", "sonne" }),
	     BS("Dieser Ort wird von der Sonne verwoehnt. Wahrscheinlich will "
		+ "Lupus das so haben.")
	     );
  AddDetail( ({ "magier", "erbauer" }),
	     BS("Magier sind die Erbauer dieser Welt. Du bist Dir voellig "
		+ "sicher, dass in diesem Raum Lupus lebt (auch wenn Du nicht "
		+ "weisst, woher Du das weisst). So wie das hier aussieht, "
		+ "kann er ja wohl noch nicht allzuviel von dieser Welt "
		+ "erbaut haben. Das sieht eher nach nem Raum zum Faulenzen "
		+ "aus, als nach nem Arbeitszimmer.")
	     );
  AddDetail( ({ "welt" }),
	     BS("Wo Du auch hinschaust, ueberall ist Welt.")
	     );
  AddDetail( ({ "faulenzen" }),
	     BS("Du schaust Dich noch einmal um. Ja, dieser Raum ist wirklich "
		+ "klasse zum faulenzen. Man koennte meinen, die Erfahrung "
		+ "von Jahrhunderten sei in die Ausstattung dieses Zimmers "
		+ "eingeflossen.")
	     );
  
  
  
  AddExit("unten", "/d/wasser/lupus/mauritius/room/strand20");
  // AddExit("norden", "/players/lupus/room/balkon");
}

void init()
{
  ::init();
  
  TELLL(TPNAM+" hat grade Deinen Workroom betreten!\n");
}
