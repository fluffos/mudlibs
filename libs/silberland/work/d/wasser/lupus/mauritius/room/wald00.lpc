inherit "/d/wasser/lupus/mauritius/room/wald_inh";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Im Regenwald" );
  SetProp( P_INT_LONG,
	 "Du glaubst Du stehst im Wald.\n"
	 "Das Ungewoehnliche daran ist, dass Du mit diesem "
	 "Glauben ausnahmsweise einmal voellig richtig liegst. Um "
	 "Dich herum stehen diverse braune bis gruene oder beides "
	 "Gebilde, die Du dank jahrelanger Erfahrung als Baum "
	 "identifizieren kannst. Zwischen Ihnen hindurch schlaengeln "
	 "sich immer wieder Regentropfen, die zweifellos nur "
	 "eines im Sinn haben: Dich zu durchnaessen. "
	 "Noerdlich von Dir kannst Du zwischen den Baeumen hindurch "
	 "das Meer sehen, waehrend der Wald in der anderen Richtung "
	 "eher dichter zu werden scheint.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );


  AddDetail( ({ "meer" }),
    "Zwischen den Baeumen im Norden siehst Du das Meer, das "
    "anscheinend in der prallen Sonne liegt.");

  AddDetail( ({ "boden", "waldboden" }),
    "Ein typischer Waldboden. ");
  
  AddExit( "norden", MAUROOM("strand20") );
  AddExit( "suedosten", MAUROOM("wald11") );
  AddExit( "sueden", MAUROOM("wald01") );

}

