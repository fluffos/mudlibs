inherit "/d/wasser/lupus/mauritius/room/wald_inh";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Im Regenwald" );
  SetProp( P_INT_LONG,
	"Der Regenwald umgibt Dich wie eine gruen-braune Decke. Dein "
	"Problem damit ist, dass Du die Farbkombination gruen-braun "
	"in Bezug auf Dein Outfit als hoffnungslos altmodisch "
	"empfindest. Fuer den Fall jedoch, dass die Baeume um "
	"Dich herum nachtragend sind und es ploetzlich anfangen "
	"koennte, statt weichen Wasser auch harte Aeste zu regnen, "
	"beschliesst Du, Deine Meinung ueber sie fuer Dich zu "
	"behalten und wirfst lieber zwischen ihnen hindurch nach "
	"Sueden einen Blick auf das Meer, das da in einem "
	"wuerdevollen Blau zu sehen ist. Nach Westen blickst Du "
	"nicht, weil dort der Wald dichter zu werden scheint.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );

  AddDetail( ({ "wasser" }),
    "Das Wasser hier hat einen sehr niedrigen Haertegrad.");

  AddDetail( ({ "meer" }),
    "Von hier aus siehst Du das Meer in suedlicher und "
    "suedwestlicher Richtung im Sonnenschein liegen.");

  AddDetail( ({ "outfit" }),
    "Du bedauerst es, keinen Spiegel mitgebracht zu haben.");

  AddDetail( ({ "boden", "waldboden" }),
    "Ein typischer Waldboden, wie man ihn ueberall findet. ");

  AddDetail( ({ "decke" }),
    "Wie eine Decke umgibt Dich der Regenwald. ");
 
  AddDetail( ({ "problem" }),
    "Mit der Farbkombination hast Du wirklich ein ziemliches Problem. ");

  AddDetail( ({ "farbkombination", "kombination" }),
    "Gruen-braun!");


 

  AddExit( "norden", MAUROOM("wald00") );
  AddExit( "westen", MAUROOM("rwald") );
  
}

