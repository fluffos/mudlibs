// SilberLand MUDlib
//
// Ein Regenwaldraum in Mauritius.
//
// $Date$
/* $Revision$
 * $Log$
 *
 *      Anzahl der Details:
 *      Normal:         00
 *      Read:           00
 *      Sounds:         00
 *      Smells:         00
 *      Befehle:        00
 *
 */

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Nix" );
  SetProp( P_INT_LONG, "Auch Nix\n"
	   );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );

  AddDetail( ({ "sonne" }),
    "Die Sonne schaut hier nur ab und zu zwischen den Wolken "
    "durch, ist aber den groessten Teil der Zeit vollauf "
    "damit beschaeftigt, dem Meer einen Sonnenbrand zu "
    "verschaffen. Bislang uebrigens ohne Erfolg.");

  AddDetail( ({ "kalvarienbaum", "kalvarienbaeume" }),
    "Da der Verfasser diesen Baum auch nur aus einem Buch geklaut "
    "hat und dieses Buch ein unbebilderter Roman war und das "
    "Lexikon des Verfasser auch nichts zu seiner Erleuchtung "
    "beitrug hast Du leider ueberhaupt keine Vorstellung "
    "davon, wie ein Kalvarienbaum aussieht. Du erkennst aber "
    "einen, wenn Du davor stehst.");

  AddDetail( ({ "baeume", "gebilde" }),
    "Du kannst mindestens 13 Arten von Baeumen unterscheiden, "
    "jedoch nur eine davon identifizieren: Die Kalvarienbaeume. "
    "Dieser Baum traegt ueblicherweise naemlich Nuesse, was "
    "fuer Dich als Geniesser der Esskultur eine sehr "
    "wesentliche Eigenschaft ist. Momentan kannst Du allerdings "
    "keine Nuesse entdecken.");

  AddDetail( ({ "nuss", "nuesse" }),
    "Du kannst weder an den Baeumen noch auf dem Boden Nuesse "
    "finden. Vielleicht hat sie schon jemand vor Dir entdeckt "
    "und schmackhaft gefunden?");

  AddDetail( ({ "pflanzen" }),
    "Ueber dem ganzen Krempel, der hier am Boden und teilweise "
    "auch auf den Baeumen waechst kannst Du leider nur sagen, "
    "dass er - meistens jedenfalls - gruen ist.");

  AddDetail( ({ "krempel" }),
    "Tja, Du kennst Dich wirklich nicht besonders gut aus. ");

  AddDetail( ({ "regen", "tropfen", "regentropfen" }),
    "Der Regenwald nimmt seinen Namen offensichtlich sehr ernst. "
    "Als Dir wieder ein dicker, schwerer Tropfen in den "
    "Nacken platscht kommst Du zu dem Schluss, dass der "
    "Regenwald die ganze Sache doch mal etwas lockerer sehen "
    "koennte und mal ein bisschen unter die Sonnenbank "
    "gehen koennte. Leider sprichst Du nicht waeldisch, was "
    "einer der drei Gruende dafuer ist, dass Du dem Wald "
    "diese Idee nicht naeher bringen kannst.");

  AddDetail( ({ "gruende" }),
    "Die beiden anderen Gruende lassen sich nur in waeldisch "
    "ausdruecken, das Du (Grund 1) nicht verstehst.");

  AddDetail( ({ "wald", "regenwald" }),
    "Dieser Regenwald besteht, wie uebrigens viele seiner Art, "
    "groesstenteils aus Baeumen und anderen Pflanzen.");


// Neue Details vom 2.12.2004 - Clementine

  AddDetail( ({ "wolken" }),
    "Wolken stehen hier wirklich genug am Himmel. ");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist ganz hoch ueber Dir, und somit fuer Dich nicht "
    "zu erreichen. ");

  AddDetail( ({ "baum" }),
    "Hier gibt es unzaehlig viele Baeume. Meinst Du einen bestimmten?!");


  AddSound(DEFAULT_SOUND, "Du lauscht dem Wald und fuehlst Dich entspannt.");

  AddSound( ({ "wald" }),
    "Klingt einfach toll!");


  
}


