// SilberLand MUDlib
//
// Der Europa-Raum.
//
// ueberarbeitet: 22.11.2001 Clementine@SL


inherit "/d/wasser/lupus/mauritius/room/mau_inh";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Auf einer zum Meer offenen Lichtung im Wald" );
  SetProp( P_INT_LONG,
	 "Du befindest Dich auf einer Meereswiese, die voll der "
	 "buntesten Blumen steht. Nach Sueden hin faellt die Wiese zum "
	 "Strand hin sanft ab, waehrend sie auf allen anderen Seiten "
	 "vom dichten Wald umgeben ist.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25 ]) );

  AddSmell( ({ DEFAULT_SMELL, "luft" }),
	 "Die vielen Blumen auf der Wiese fuellen die Luft.");

  AddDetail( ({ "meereswiese", "wiese" }),
	"Du befindest Dich auf einer Meereswiese, die voll der "
	"buntesten Blumen steht. Nach Sueden hin faellt die Wiese zum "
	"Strand hin sanft ab, waehrend sie auf allen anderen Seiten "
	"vom dichten Wald umgeben ist.");

  AddDetail( ({ "blumen" }),
	"Du Wiese ist geradezu mit Blumen uebersaeht. Du siehst "
	"Narzissen, Hyazinthen, Veilchen, Quendel, Krokusse und "
	"Rosen.");

  AddDetail( ({ "narzissen" }),
	"Du bewunderst die glaenzenden Narzissen.");

  AddDetail( ({ "hyazinthen" }),
	"Die Blumen stroemen Balsam aus.");

  AddDetail( ({ "balsam" }),
	"Den kannst Du besser riechen.");

  AddSmell( ({ "balsam", "hyazinthe" }),
	"Du labst dich am erlesenen Duft der Hyazinthen.");

  AddDetail( ({ "meer" }),
	"Es liegt suedlich von Dir faul in der Sonne.");

  AddDetail( ({ "veilchen" }),
	"Die Veilchen verstroemen einen sanfteren Duft als die "
	"Hyazinthen.");

  AddSmell( ({ "duft", "veilchen" }),
	"Du saugst den sanften Duft in Deine Nase.");

  AddDetail( ({ "quendel"}),
	"Der Quendel verstroemt einen wuerzigen Geruch.");

  AddSmell( ({ "quendel" }),
	"Der Quendel verstroemt einen wuerzigen Geruch.");

  AddDetail( ({ "krokus", "krokusse" }),
	"Die Krokusse leuchten golden in der Sonne.");

  AddDetail( ({ "strand" }),
	"Der Strand liegt suedlich von Dir in der prallen Sonne.");

  AddDetail( ({ "sonne", "himmel", "bahnen" }),
	"Hoch am Himmel zieht die Sonne gemaechlich ihre Bahnen.");

  AddDetail( ({ "boden" }),
	"Der Boden ist mit duftenden Blumen geradezu uebersaeht.");

  AddDetail( ({ "rosen" }),
	"Die Rosen strahlen dich rot an.");

  AddDetail( ({ "wald", "seiten" }),
	"Der Wald umgibt auf drei Seiten diese Wiese.");


  AddItem( MAUNPC("stier"), REFRESH_DESTRUCT );
  
  AddExit( "nordwesten", MAUROOM("wald00") );
  AddExit( "sueden", MAUROOM("strand33") );
  
}


