inherit "/d/wasser/lupus/mauritius/room/mau_inh";

#include <properties.h>
#include <language.h>
#include "../mau.h"

int nusz, mooz;

create()
{
  ::create();
  
  nusz=2; mooz=5;
  
  SetProp( P_INT_SHORT, "Tief im Regenwald" );
  SetProp( P_INT_LONG,
	   "Hier, tief im Regenwald tut es das, was es im Regenwald "
	   "normalerweise tut, naemlich regnen. Daher der Name.\n"
	   "Ebenfalls regenwaldtypisch sind die diversen Baeume, die "
	   "um Dich herum wachsen und gedeihen. Zwischen den Baeumen "
	   "kannst Du einen Blick auf das Meer erhaschen.");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE:25]));
  

//DETAILBEGINN

  AddDetail( ({ "regenwald", "wald" }),
    "Ein Regenwald ist ein immergruener Wald in ganzjaehrig "
    "feuchten Gebieten der Tropen, der Subtropen und der "
    "frostfreien Aussertropen.");

  AddDetail( ({ "tropen" }),
    "Die Tropen sind eine Zone gleichmaessigen, heissen Klimas, "
    "in dem es keine Jahreszeiten, dafuer aber meist starke "
    "Temperaturschwankungen zwischen Tag und und Nacht gibt. "
    "Du schaetzst zwar, dass Du Dich hier in den Tropen "
    "befindest, da es hier aber keinen Unterschied zwischen "
    "Tag und Nacht gibt, gibt es auch keine "
    "Temperaturschwankungen. ");

  AddDetail( ({ "subtropen" }),
    "Die Subtropen sind weniger tropisch als die Tropen.");

  AddDetail( ({ "aussertropen" }),
    "Die Aussertropen sind weniger tropisch als die Subtropen "
    "und die Tropen.");

  AddDetail( ({ "klima" }),
    "a) Durchschnittlicher Wetterverlauf in einem laengeren "
    "Zeitabschnitt in einer bestimmten Gegend.\n"
    "b) Oesterreichischer Politiker.");

  AddDetail( ({ "politiker" }),
    "Sowas brauchen wir hier nicht.");

  AddDetail( ({ "regen", "dauerregen" }),
    "Es ist ein sanfter Dauerregen. Er bildet einen feinen, "
    "tropfenden Nebel, durch den gelegentlich ein Strahl des "
    "Sonnenlichts bricht, gedaempft wird und sich weiter auf "
    "die nasse Rinde eines Kalvariensbaums zubewegt, auf der er "
    "sich schliesslich niederlaesst und funkelt. Manchmal tut "
    "er das direkt neben einem Schmetterling oder einer "
    "winzigen, reglosen, schimmernden Eidechse, und dann ist "
    "die Wirkung fast nicht auszuhalten.");

  AddDetail( ({ "nebel" }),
    "Der Nebel daempft das Sonnenlicht und gibt der Szenerie eine "
    "gewisse Ruhe.");

  AddDetail( ({ "licht", "sonnenlicht", "strahl", "sonnenstrahl" }),
    "Hin und wieder lassen Wolken und Blaetterdach einige "
    "Sonnenstrahlen durch, die sich dann ihren Weg durch den "
    "Nebel bahnen.");

  AddDetail( ({ "wolken" }),
    "Sie sind gross und grau und geben ausser einer grossen "
    "Menge Regen wenig von sich.");

  AddDetail( ({ "wirkung" }),
    "Sowas sieht man nicht, sowas spuert man.");

  AddDetail( ({ "baeume", "regenwaldbaum", "baum" }),
    "Wie es sich fuer einen Regenwald, der etwas auf sich haelt, "
    "gehoert, stehen hier ueberall Baeume. Sie beginnen in "
    "einem Gewirr von Wurzeln, das sich durch das Erdreich "
    "knaeult, von Moos bewachsen und Insekten bevoelkert ist. "
    "Weiter oben, an den maechtigen Staemmen, deren Rinde "
    "mit Absicht knorrig ist, damit man ihnen sofort "
    "staunend ansehen kann, dass sie wirklich alt sein muessen, "
    "bevoelkern die Insekten gutgelaunt weiter. Noch weiter "
    "oben bilden die Baeume ein hohes, gruenes Blaetterdach. "
    "Von hier unten kannst Du nicht sagen, ob auch da oben "
    "noch Insekten voelkern, haeltst dies aber fuer recht "
    "wahrscheinlich.");

  AddDetail( ({ "rinde" }),
    "Die Rinde der Baeume ist so knorrig, wie man das von einem "
    "alten Regenwaldbaum erwartet.");

  AddDetail( ({ "blaetterdach", "dach" }),
    "Durch das Blaetterdach kommt, abgesehen von einem "
    "vereinzelten Sonnenstrahl oder abgerissen Blatt, nur "
    "Regen.");

  AddDetail( ({ "blatt", "blaetter" }),
    "Die Blaetter, die am Boden liegen sind durchweicht. Die "
    "Blaetter, die noch an Baeumen haengen sind lediglich "
    "nass. ");

  AddDetail( ({ "insekten" }),
    "Da die Insekten nicht so aussehen, als ob sie Dir etwas "
    "zu leide tun wollten, beschliesst Du, dies auf "
    "Gegenseitigkeit beruhen zu lassen und kuemmerst Dich nicht "
    "weiter um sie.");

  AddDetail( ({ "boden", "waldboden" }),
    "Der Waldboden ist mit durchweichten Blaettern und Nadeln "
    "bedeckt. Gewirre von Wurzeln knaeulen sich durch das "
    "Erdreich. Moss waechst auf ihnen, Insekten krabbeln."
    "Dazwischen liegen einige Nuesse.");

  AddDetail( ({ "nadel", "nadeln" }),
    "Die Nadeln stammen von herumstehenden Nadelbaeumen.");

  AddDetail( ({ "nadelbaum", "nadelbaeume" }),
    "Zwar sind die meisten Baeume hier beblaettert, darunter "
    "befinden sich jedoch auch einige Nadelbaeume.");

  AddDetail( ({ "wurzel", "wurzeln" }),
    "Die Wurzeln der Baeume befinden sich teilweise ueber "
    "der Erde und sehen aus wie Grate in einem Gebirgsmassiv.");

  AddDetail( ({ "grate" }),
    "Das sind sie natuerlich nicht.");

  AddDetail( ({ "erdreich", "erde", "unterlage" }),
    "Die Erde bildet die etwas rutschige, schlammige Unterlage "
    "fuer den Regenwald.");

  AddDetail( ({ "kalvarienbaum" }),
    "Du hast zwar keinen Schimmer, wie ein Kalvarienbaum "
    "aussieht, aber auf beinahe magische Weise weisst Du, "
    "dass die Nuesse, die am Boden liegen, von solchen "
    "Baeumen stammen. Daraus wiederum schliesst Du "
    "messerscharf, dass um Dich herum einige Kalvarienbaeume "
    "stehen muessen.");

  AddDetail( ({ "nuss", "nuesse" }),
    "Die Nuesse, die am Boden liegen, stammen von den "
    "Kalvarienbaeumen, die hier wachsen. Sie sehen sehr lecker "
    "aus.");

  AddDetail( ({ "moos" }),
    "Diese Moos sieht irrsinnig flauschig aus. Und vor allem ist "
    "es so intensiv gruen! Dieses Moos gehoert zu den Dingen, "
    "die Du unbedingt besitzen willst.");

  AddDetail( ({ "meer" }),
    "Zwischen den Baeumen kannst Du das Meer erkennen, ueber "
    "das Du diese Insel erreicht hast.");

  AddDetail( ({ "stamm", "staemme", "baumstaemme", "baumstamm" }),
    "Die Baumstaemme verbinden ihr Wurzelwerk mit der Krone. "
    "Aus Gruenden, die nur ihnen bekannt sind treiben sich "
    "auf den Staemmen unzaehlige Insekten herum.");

  AddDetail( ({ "strauch", "dornenstrauch" }),
    "Er sieht dornig und insgesamt unangenehm aus. Du "
    "beschliesst, Dich von ihm fernzuhalten.");

  AddDetail( ({ "blumen", "blume" }),
    "Die Blumen hier verstroemen einen herrlichen Duft. ");

//DETAILENDE


//SOUNDS

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Windes in den Baumwipfeln, das "
    "Trippeln der Pfoten kleiner Tiere im Dickicht, die Du "
    "nicht sehen kannst und ueber alledem das Prasseln des "
    "Regens auf Blaettern und Boden.");

  AddSound( ({ "wind", "rauschen" }),
    "Der Wind spielt zusammen mit den Baumwipfeln sein ewiges "
    "Duett.");

  AddSound( ({ "trippeln", "tiere" }),
    "Viele kleine Tiere scheinen sich in diesem Wald zu bewegen. "
    "Aufgrund der dichten Vegetation kannst Du sie jedoch leider "
    "nicht sehen.");

  AddSound( ({ "regen", "prasseln", "rieseln" }),
    "Mit Geraeuschen wie Plitsch, Platsch oder auch einfach einem "
    "leisen Rieseln begiebt sich der Regen, manchmal fuer einen "
    "Moment auf einem Blatt, von dem er eine schoene Aussicht "
    "geniessen, kann verweilend, vom Himmel auf die Erde.");


//SMELLS

  AddSmell( ({ DEFAULT_SMELL, "luft" }),
    "Die Luft ist voller Gerueche - dem zarten Duft von Blumen "
    "und der heftigen Wuerze der durchweichten Nadeln und "
    "Blaetter, mit denen der Waldboden bedeckt ist.");

  AddSmell( ({ "blumen", "duft" }),
    "Die Blumen verbreiten mit ihren Duftstoffen einen Hauch "
    "von Exotik. Es liesse sich trefflich darueber diskutieren, "
    "ob dies auch wirklich noetig ist, da dieser Ort, der ja "
    "schliesslich ein Regenwald ist, sowieso schon exotisch "
    "ist. Andererseits waere er ohne den speziellen Duft "
    "vielleicht gar nicht exotisch - Regenwald hin oder her. "
    "Da Du diese philosphischen Fragen nicht beantworten kannst, "
    "berauschst Du Dich lieber weiter am Duft der Blumen.");

  AddSmell( ({ "wuerze", "nadeln", "blaetter" }),
    "Die Nadeln und Blaetter, die sich von ihren ehemaligen "
    "Baeumen getrennt haben und nun langsam am Boden verrotten "
    "verstroemen denn wuerzigen, sehr angenehmen Duft, fuer den "
    "man im Body Shop sehr viel Geld bezahlen muss.");

  AddCmd( ({ "nimm", "nehme" }), "c_nehmen" );

  AddItem( MAUNPC("dodo"), REFRESH_DESTRUCT );
  AddItem( MAUNPC("schmetterling"), REFRESH_DESTRUCT );
  AddItem( MAUNPC("eidechse"), REFRESH_DESTRUCT );



  AddExit( "osten", MAUROOM("wald01") );
  /*  NewDoor( "tuer",
	   MAUROOM("wohnzimmer"),
	   "tuer",
	   ({ 
	     D_SHORT, "Eine schlichte, weisse Tuer. (%s)",
	       D_LONG,
	       BS("Auf einem Flecken im Wald, auf einem leeren Stueck nassem "
		  + "Boden, zwischen ein paar sich reckenden Baeumen steht "
		  + "lautlos und ohne irgendwelchen Wirbel eine schlichte, "
		  + "weisse Tuer."),
	       D_NAME, "schlichte, weisse Tuer",
	       D_MSGS, "durch die Tuer"
	       })
	   );
  */
}

void reset()
{
  ::reset();
  if(!is_clone(this_object())) return;

  nusz=2; mooz=5;
  return;
}

int c_nehmen( string str)
{
  if( str != "moos"   &&
      str != "nuss"    )
    {
      notify_fail("Was willst Du nehmen?\n" );
      return 0;
    }
  if( str == "moos" )
    {
      if( mooz<1 )
	{
	  write(BS("Da wo Du herankommen koenntest ist leider schon alles Moos "
		    "abgekratzt worden." ));
	  return 1;
	}
      else
	{
	  write(BS( "Du kratzt Dir etwas Moos von einem Baum ab." ));
	  say( TPNAM + " kratzt etwas Moos vom einem Baum ab und steckt es "
	       + "ein.\n");
	  clone_object(MAUOBJ("moos"))->move(TP);
	  mooz--;
	  return 1;
	}
    }
  if( ( str == "nuss" || str == "nuesse" ) )
    {
      if( nusz<1 )
	{
	  write(BS("Die einzige Nuss, die Du noch finden kannst, liegt "
		   "in einem Dornenstrauch. Du beschliesst, dass Dir "
		   "eine lumpige Nuss keine Kratzer in Deiner Hand "
		   "wert ist."));
	  return 1;
	}
      else
	{
	  write(BS("Du hebst eine Nuss auf." ));
	  say( TPNAM + " hebt eine Nuss vom Boden auf.\n" );
	  clone_object(MAUOBJ("nuss"))->move(TP);
	  nusz--;
          return 1;
	}
    }
}

