//
// /d/wasser/lupus/mauritius/strand13.c
//
// Am Strand von Mauritius.
//
/*
**      Zuletzt geaendert am 17.11.1998
**
**      Anzahl der Details:
**      Normal:         15
**      Special:        02
**      Read:           00
**      Sounds:         02
**      Smells:         03
**      Befehle:        00
**	Ausgaenge:	02
**
*/

inherit "/d/wasser/lupus/mauritius/room/str_inh";

#include <properties.h>
#include <language.h>
#include "../mau.h"

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Am Strand" );
  SetProp( P_INT_LONG,
    "Du siehst einen scheinbar endlosen Sandstrand. Du spuerst den "
    "feuchten Sand unter Deinen Fuessen. Das Meer glitzert und "
    "schimmert seltsam gruenlich. Die Wellen rollen gemaechlich "
    "ans Ufer.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE : 25, 
    ENV_TERRAIN : TT_DESERT ]) );


// SOUNDS

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das Rauschen des Meeres.");

  AddSound( ({ "meer", "rauschen" }),
    "RRRRRRAAAAAUUUUUUUUUUUSSSSSCCCHHHHHHHHHHHHHHHHHHHHHHHhhhhhh"
    "hhhhhhhhhhhhhhhh");


// SOUNDS

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier salzig. Kommt sicher vom Meer.");

  AddSmell( ({ "meer", "geruch" }),
    "Jo, das Meer ist am salzigen Geruch schuld.");

  AddSmell( ({ "luft" }),
    "Die Luft riecht ein wenig nach Regen. Das ist seltsam, da der "
    "Himmel ueber dem Meer doch wolkenlos ist.");

  AddDetail( ({ "wellen" }),
    "Hier am Ufer laufen die Wellen nur noch sanft aus, aber "
    "weiter draussen kannst Du hier und da eine Schaumkrone "
    "sehen.");

  AddDetail( ({ "strand", "sandstrand", "ufer" }),
    "Der Strand ist hier sehr flach und wird fast bist zum Wald "
    "von Wellen ueberspuelt.");

  AddDetail( ({ "sand", "flaeche", "weiss" }),
    "Der Sand ist eine Flaeche aus strahlendem Weiss, die nur "
    "ab und zu von Muscheln oder ein bischen Seetang "
    "unterbrochen wird. An der Wasserlinie siehst Du Spuren.");

  AddDetail( ({ "muscheln" }),
    "Viele Muscheln liegen im weissen Sand, grosse und kleinere, "
    "weisse und graue. Du erinnerst Dich ploetzlich, wie gern "
    "Du als Kind immer Muscheln gesammelt hast.\n"
    "Eine besonders grosse Muschel sticht Dir ins Auge. So "
    "eine grosse Muschel hast Du noch nie gefunden. Vielleicht "
    "solltest Du sie dir etwas genauer anschauen.\n");

  AddDetail( ({ "muschel", "schale", "schneckenhaus", "zwiebeltuermchen" }),
    "Du hebst die Muschel auf und bestaunst sie. Sie fuehlt sich "
    "in Deinen Haenden weich und glatt an. Ihre Schale ist "
    "ganz weiss und ihre gedrechselte Form erinnert Dich an "
    "ein Schneckenhaus, vielleicht auch an verschlungenes "
    "Zwiebeltuermchen. Als Du sie an Dein Ohr haelst, hoerst "
    "Du ein entferntes Rauschen, dass in Dir eine seltsame "
    "Sehnsucht weckt.\n"
    "Da Du nicht willst, das andere auf die Muschel verzichten "
    "muessen legst Du sie wieder in den Sand.");

  AddDetail( ({ "seetang", "tang" }),
    "Der Seetang sieht aus wie das Haar eine Meerjungfrau. Er "
    "ist einfach nur gruen und Du fragst Dich unwillkuerlich, "
    "was an einer Meerjungfrau verfuehrerisch sein kann, die "
    "sowas kaemmt.");

  AddDetail( ({ "spuren", "wasserlinie" }),
    "Du siehst Handabdruecke im Sand. Das Meer hat sie beinahe "
    "hinweggespuelt. Daneben hat jemand eine Liebesbotschaft "
    "in den Sand geschrieben. Schade, dass auch sie alsbald "
    "dem Vergessen anheimfallen wird.");

  AddDetail( ({ "botschaft", "liebesbotschaft", "worte" }),
    "Du hast Schwierigkeiten, die Worte zu entziffern. Da steht "
    "irgendwas von '..... i.h l.ebe Di..'. Mehr kannst "
    "Du nicht entziffern..");

  AddDetail( ({ "handabdruecke", "abdruecke" }),
    "Vielleicht hat hier jemand Handstand geuebt.");

  AddDetail( ({ "meer" }),
    "Die seltsame gruenliche Farbe muss vom Lichteinfall "
    "herruehren. Normalerweise sieht das Meer so nur aus, wenn "
    "Regen in der Luft liegt, aber das Meer liegt vor Dir im "
    "strahlenden Sonnenschein.");

  AddDetail( ({ "schaumkrone", "schaumkronen" }),
    "Schaumkronen sind nur weiter draussen auf dem Meer zu sehen.");

// Neue Details am 17.11.98

  AddDetail( ({ "wald", "urwald", "inselinnere", "inselinneres" }),
    "Das Inselinnere wird von einem dichten und unglaublich "
    "gruenen Urwald eingenommen.");

  AddSpecialDetail( ({ "meerjungfrau" }), "meerjungfrauen" );

  AddDetail( ({ "vergessen" }),
    "Aeh, hab vergessen, was das bedeutet.");

  AddSpecialDetail( ({ "fuss", "fuesse", "fuessen" }), "fuss_guck" );

  AddDetail( ({ "himmel" }),
    "Du schaust nach oben und siehst in einen strahlend... "
    "Moment. Du schaust in einen Himmel, der teils "
    "strahlend blau, teils aber auch regengrau ist. "
    "Ueber dem Wald faengt ein Gebiet mit dunklen "
    "Wolken an.");

  AddDetail( ({ "wolken" }),
    "Diese Wolken sehen sehr nieder- und regentraechtig aus.");

// NEUE DETAILS CLEMENTINE

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus feinem Sand. ");

  AddExit( "westen", MAUROOM("strand03") );
  AddExit( "suedosten", MAUROOM("strand24") );

}

string meerjungfrauen()
{
   if(TP->QueryProp(P_GENDER)=="MALE") 
   	return BS("Meerjungfrauen sind diese heissen Maedels mit "
		  "Fischschwanz und Muschelbikini. So einer wuerdest "
		  "Du wahrscheinlich gerne mal begegnen.");
   if(TP->QueryProp(P_GENDER)=="FEMALE" ) 
   	return BS("Pfff, Meerjungfrauen! So ein Firlefanz ist was fuer "
		  "Maenner. Dann lieber ein schicker Neptun...");
   else 
     return BS("Meerjungfrauen sind diese Maedels mit Fischschwanz und "
	       "gruenen Haaren.");
   
}

string fussguck()
{
   if(TP->QueryProp(P_RACE)=="Zwerg") 
   	return BS("Das Wasser spuelt ueber die grossen Dinger, mit denen "
		  "Du in Bodennaehe aufhoerst.");
   if(TP->QueryProp(P_RACE)=="Elf") 
   	return BS("Iiiiiih, Du wirst ja ganz nass! Schnell entfernst Du "
		  "Dich vom Wasser.");
   if(TP->QueryProp(P_RACE)=="Troll") 
   	return BS("Fuesse gut. Fuesse Dich tragen ueberall hin.");
   if(TP->QueryProp(P_RACE)=="Fee") 
   	return BS("Das Wasser ueberspuelt nicht nur Deine Fuesse sondern "
		  "reicht Dir bis an die Knie. Manchmal wuenschtst Du "
		  "Dir, Deine Fluegel waeren funktionsfaehiger.");
   else 
     return BS("Ganz normale Fuesse. Etwas nass, aber ansonsten normal.");
   
}


