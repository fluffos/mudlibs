kerbentafel.c

P_NOGET koennte evtl ein netter text stehen, wie "Was willst Du denn mit 
einer Holztafel?" ...

Id Holztafel gehoert noch

bei AddReadDetail auch alle ids verwenden bitte

bei string tafel kannst du dir die halbe funktion sparen, da es dafuer
bereits einen befehl gibt (ausserdem hast du ein \n vergessen nach jeder 
zeile.

string tafel()
{
  string txt, s, *npc, *kerben;
  int i, j, rest, count, npc_length;
  npc=call_other(KERBENMASTER, "QueryNpc");
  kerben=call_other(KERBENMASTER, "QueryKerben");
  txt="";
  s="";

  for(i=0; i<sizeof(npc) && i<sizeof(kerben); i++)
  {
    for(j=0; j<sizeof(kerben); j+=10)
      if(kerben[i]<j) 
        count = j;
    txt+=sprintf("%45-'.'s%d\n", CAP(npc[i]), kerben[i])
  }

//NPC zu schreiben sieht haesslich aus, schreibe da lieber "Gegner"
  return " Gegner                        getoetete Spieler\n"+
	 "------------------------------------------------\n"+
	 txt+"\n";
}

