

inherit "std/weapon";

#include "../def.h"
             


void create()
{

  if (!is_clone(this_object()))
    return;

  ::create();   /* WICHTIG!!! */
		
  SetProp(P_SHORT, "Ein Zertruemmerer");
  SetProp(P_LONG,  
    "Der Zertruemmerer ist ein maechtige Waffe, die nur von sehr starken und "
    "erfahrenen Kaempfern gefuehrt wird. Auf einem silbernen Stiel mit "
    "vielen Verzierungen sitzt ein gewaltiger Hammerkopf. Sicherlich kann "
    "man mit einem einzigen Hieb dieser Waffe seinem Gegner den "
    "Schaedel zertruemmern.");
  SetProp(P_NAME, "Zertruemmerer");
  SetProp(P_GENDER, MALE);
  AddId( ({"zertruemmerer", "hammer"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 262);
  SetProp(P_WC_FIX, 12);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":70, "Keulenexperte":130, "Keulenmeister":220]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL :30, MAT_SILVER: 70]) );
  SetProp(P_WEIGHT, 6000);
  SetProp(P_VALUE, 2200);
  SetProp(P_SIZE, 115);
  SetProp(P_QUALITY_DECAY, 130);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:24, P_LEVEL:22]) );

  AddDetail( "stiel", "Die Verzierungen glitzern silbrig.\n" );
  AddDetail( "verzierungen", "Sie zeugen von der Macht dieser Waffe.\n" );
  AddDetail( "waffe", "Eine gewaltige Waffe, eines starken Kaempfers wuerdig.\n" );
  AddDetail( "hammerkopf", "Einfach nur gewaltig.\n" );
  AddDetail( "kaempfer", "So einer bist Du!\n" );
  AddDetail( "macht", "Mit dieser Waffe wirst Du unbesiegbar sein!\n" );   
}

