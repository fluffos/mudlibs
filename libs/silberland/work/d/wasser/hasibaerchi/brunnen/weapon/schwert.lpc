

inherit "std/weapon";

#include "../def.h"
             


void create()
{

  if (!is_clone(this_object()))
    return;

  ::create();   /* WICHTIG!!! */

  AddId("schwert");
 
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Rosenschwert");
  SetProp(P_SHORT, "Ein Rosenschwert");
  SetProp(P_LONG,
    "Dies ist das Schwert eines Kaempfers der Schwarzen Rose. Seine Klinge "
    "ist scharf und das Gewicht des Schwertes verleiht dem Traeger sicher "
    "die noetige Wucht fuer harte Schlaege.\n" );
  SetProp(P_VALUE, 650);
  SetProp(P_MATERIAL, ([ MAT_METAL : 100 ]  ) );
  SetProp(P_WEIGHT, 1199);
  SetProp(P_SIZE, 100);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 16, A_STR: 14] ) ); 
  SetProp(P_DAM_TYPE, DT_SLASH);     
  SetProp(P_WC, 202);
  SetProp(P_WC_FIX, 20);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WC_BONUS, (["page":250,"knappe":290,"ritter":350]));

  AddDetail( "klinge", "Wirklich aeusserst scharf!\n" );
  
}

