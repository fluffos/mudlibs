

inherit "std/weapon";

#include "../def.h"
             


void create()
{

  if (!is_clone(this_object()))
    return;

  ::create();   /* WICHTIG!!! */

  SetProp (P_SHORT, "Eine Sturmaxt");
  SetProp (P_LONG,
    "Die Sturmaxt ist eine der schoensten Aexte des ganzen Silberlands. "
    "Ihr Eichenholzstiel ist mit Lederriemen umwickelt. Um das Axtblatt "
    "scheinen von Zeit zu Zeit kleine Blitze zu zucken.");
  SetProp (P_NAME, "Sturmaxt");
  SetProp (P_GENDER, FEMALE);
  AddId (({"axt", "sturmaxt"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 250);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":130, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH,DT_AIR}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, 
    ([MAT_MITHRIL:65, MAT_OAK:30, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 2800);
  SetProp(P_VALUE, 3100);
  SetProp(P_SIZE, 100);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:25, A_DEX: 22]) );
  
  AddDetail( ({"axtblatt", "blatt", "mithrilaxtblatt", "mithril"}),
    "Das Axtblatt der Sturmaxt besteht aus feinstem magischen "
    "Mithril.");
  AddDetail( ({"lederriemen", "riemen","stiel", "eichenholzstiel"}),
    "Der Stiel ist mit schwarzen Lederriemen umwickelt.");
  AddDetail( ({ "blitz", "blitze" }),
    "Die Axt sieht wirklich sehr gefaehrlich aus.");
}
