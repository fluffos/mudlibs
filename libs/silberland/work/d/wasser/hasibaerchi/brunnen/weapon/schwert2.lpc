

inherit "std/weapon";

#include "../def.h"
             


void create()
{

  if (!is_clone(this_object()))
    return;

  ::create();   /* WICHTIG!!! */

  AddId("schwert");
  AddId("ritterschwert");
  AddId("todesschwert");
  AddId("todesritterschwert");
 
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Todesritterschwert");
  SetProp(P_SHORT, "Ein Todesritterschwert");
  SetProp(P_LONG,
    "Dies ist das Schwert des Anfuehrers der Schwarzen Rose. Seine Klinge "
    "ist extrem scharf und das Gewicht des Schwertes verleiht dem Traeger sicher "
    "die noetige Wucht fuer harte Schlaege. Es wird kaum eine bessere Waffe in "
    "der Welt geben.\n" );
  SetProp(P_VALUE, 4450);
  SetProp(P_MATERIAL, ([ MAT_METAL : 100 ]  ) );
  SetProp(P_WEIGHT, 2499);
  SetProp(P_SIZE, 110);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 25, A_STR: 32] ) ); 
  SetProp(P_DAM_TYPE, ({DT_UNHOLY, DT_SLASH}));
  SetProp(P_WC, 272);
  SetProp(P_WC_FIX, 40);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WC_BONUS, (["soth":750]));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_ITEMD, ({"laesst Dich zu einem Todesritter mutieren",
		     "trinkt das Blut Deiner Feinde"}));

  call_other( "/p/daemon/itemd/functions/hitfuncvampire", "???");
  SetProp(P_HIT_FUNC, find_object("/p/daemon/itemd/functions/hitfuncvampire"));

  
  AddDetail( "klinge", "Wirklich aeusserst scharf!\n" );
  
}

