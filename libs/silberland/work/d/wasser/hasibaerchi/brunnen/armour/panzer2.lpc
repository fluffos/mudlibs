
inherit "std/armour";           

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  AddId("panzer");
  AddId("ruestung");
  AddId("stahlpanzer");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Stahlpanzer");
  SetProp(P_SHORT, "Ein schwerer Stahlpanzer");
  SetProp(P_LONG, 
      "Das ist eine Ruestung, die aus schwerem Stahl besteht. "
      "Sie schimmert leicht, und auf der Brust ist eine schwarze "
      "Rose abgebildet.\n" );
  SetProp(P_INFO,
      "Die Ruestung wurde von einem Meisterschmied geschaffen.\n"
     +"Du verspuerst ausserdem leicht die Schwingungen von Magie.\n" );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 650);
  SetProp(P_MATERIAL, ([ MAT_METAL : 75, MAT_MISC_MAGIC: 25 ]  ) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 33);
  SetProp(P_QUALITY_DECAY, 110); 
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Du legst den schweren Stahlpanzer an.\n",
                          " legt einen schweren Stahlpanzer an.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du schnallst den schweren Stahlpanzer ab.\n",
                            " schnallt einen schweren Stahlpanzer ab.\n" }) );
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:1,T_HEAT_PROT:-3 ]) );



}

