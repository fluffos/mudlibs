
inherit "std/armour";           

#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"
#include "/gilden/berserker/berserker_extern.h"
#include "/gilden/paladine/paladin_extern.h"
#include "/gilden/druidenzirkel/druiden_extern.h"
#include "/gilden/zechpreller/zechpreller_extern.h"

#include "/p/daemon/itemd/itemd.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  AddId("emblem");
  AddId("abzeichen");
  AddId("amulett");
  AddId(DRUID_ALLOWED_METAL_ITEM); 

  

  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Rosenemblem der Macht");
  SetProp(P_SHORT, "Ein schwarzes Rosenemblem der Macht");
  SetProp(P_LONG, 
      "Das ist ein Emblem mit dem Zeichen der Rose in seinem Herzen. "
      "Die Blaetter der Rose schimmern durch die Macht der Magie, die "
      "durch dieses Emblem fliesst.\n" );
  SetProp(P_NAME_ADJ, "schwarz");
  AddAdjective( ({"schwarz", "schwarzes", "schwarzem", "schwarzen"}));
  SetProp(P_INFO,
      "Dieses Emblem verbessert die Zaubersprueche aller Gilden.\n"
     +"Du verspuerst ausserdem die Macht der Magie die in diesem Emblem innewohnt.\n" );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 2150);
  SetProp(P_MAGIC, 1);
  SetProp(P_MATERIAL, ([ MAT_ADAMANT : 75, MAT_IRIDIUM : 20, MAT_BLOOD : 5 ]  ) );
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_BERSERKER_BONUS, (["all":1]) );
  SetProp(P_PALADIN_SPELLCOST, 1);
  SetProp(P_ITEMD_ELEMENTAL_VALUE, 1);
  SetProp(P_NEKRO_SPELLCOST, 1);
  SetProp(P_NEKRO_BONUS, (["all":1]) );
  SetProp(P_ZECHPRELLER_SPELLCOST, 1 );
  SetProp(P_ZECHPRELLER_BONUS, (["all": 1]));
  SetProp(P_ZECHPRELLER_REDUCE_ALC, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Das Emblem verbindet sich mit Deinem Koerper.\n",
                          " steckt ein Emblem an.\n" }) );
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:0,T_HEAT_PROT:0 ]) );

  AddDetail( ({"rose", "zeichen"}),
    "Einige Blaetter zieren dieses Zeichen.");
  AddDetail( ({"herz", "herzen"}),
    "Genau dort ist die Rose.");
  AddDetail( ({ "blatt", "blaetter" }),
    "Die Blaetter leuchten durch die Kraft der Magie.");
  AddDetail( ({ "macht", "magie", "kraft" }),
    "Niemand wird Dich mit diesem Emblem besiegen koennen!");



}

