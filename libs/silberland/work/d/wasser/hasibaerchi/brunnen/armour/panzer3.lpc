
inherit "std/armour";           

#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"
#include "/p/daemon/itemd/itemd.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  AddId("panzer");
  AddId("ruestung");
  AddId("stahlpanzer");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Todesritterpanzer");
  SetProp(P_SHORT, "Ein schwerer Todesritterpanzer");
  SetProp(P_LONG, 
      "Das ist eine Ruestung, die aus schwerem Stahl besteht. "
      "Sie schimmert leicht, und auf der Brust ist eine schwarze "
      "Rose abgebildet.\n" );
  SetProp(P_INFO,
      "Die Ruestung wurde von einem Meisterschmied geschaffen.\n"
     +"Du verspuerst ausserdem leicht die Schwingungen von Magie.\n" );
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 2650);
  SetProp(P_MAGIC, 1);
  SetProp(P_MATERIAL, ([ MAT_STEEL : 75, MAT_MISC_MAGIC: 25 ]  ) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX: 25, A_STR: 25, SR_GOOD: -600] ) ); 
  SetProp(P_AC, 39);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_ITEMD, ({ "erleichtert unheilige Anrufungen", 
		      "verstaerkt die dunklen Maechte der Nekromanten"})); 
  SetProp(P_NEKRO_SPELLCOST, 5);
  SetProp(P_NEKRO_BONUS, (["all":5]) );
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Du legst den schweren Todesritterpanzer an.\n",
                          " legt einen schweren Todesritterpanzer an.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du schnallst den schweren Todesritterpanzer ab.\n",
                            " schnallt einen schweren Todesritterpanzer ab.\n" }) );
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:1,T_HEAT_PROT:-4 ]) );

  AddDetail( ({"brust"}),
    "Genau dort ist das Zeichen der schwarzen Rose abgebildet.");
  AddDetail( ({"stahl"}),
    "Du bist Dir sicher, dass keine andere Ruestung im Silberland besser schuetzen "
    "kann als dieser Stahl.");
  AddDetail( ({ "rose", "zeichen" }),
    "Dieses Zeichen wird Dir die Kraft geben das Gute zu vernichten.");
  AddDetail( ({ "kraft" }),
    "Niemand wird Dich mit diesem Panzer besiegen koennen!");



}

