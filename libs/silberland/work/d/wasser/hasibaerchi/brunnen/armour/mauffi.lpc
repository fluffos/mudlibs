
inherit "std/armour";           

#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"
#include "/gilden/berserker/berserker_extern.h"
#include "/gilden/paladine/paladin_extern.h"
#include "/gilden/druidenzirkel/druiden_extern.h"
#include "/gilden/zechpreller/zechpreller_extern.h"
#include "/p/daemon/itemd/itemd.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  AddId( ({"emblem","rosenemblem"}));
  AddId("abzeichen");
  AddId("amulett");
  AddId(DRUID_ALLOWED_METAL_ITEM); 

  

  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Rosenemblem der Erinnerung");
  SetProp(P_SHORT, "Ein weisses Rosenemblem der Erinnerung");
  SetProp(P_LONG, 
      "Das ist ein Emblem mit dem Zeichen der Rose in seinem Herzen. "
      "Die Blaetter der Rose schimmern durch die Macht der Magie, die "
      "durch dieses Emblem fliesst. Der weisse Edelstein in Zentrum "
      "des Emblems strahlt in herrlicher Pracht.\n" );
  SetProp(P_NAME_ADJ, "weiss");
  AddAdjective( ({"weiss", "weisses", "weissem", "weissen"}));
  SetProp(P_INFO,
      "Dieses Emblem wurde Dir von einem ganz besonderen Menschen gegeben.\n"
     +"Du verspuerst ausserdem die Macht der Freundschaft die in diesem Emblem innewohnt.\n" );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_MATERIAL, ([ MAT_ADAMANT : 75, MAT_IRIDIUM : 20, MAT_BLOOD : 5 ]  ) );
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 1);
  
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Das Emblem verbindet sich mit Deinem Koerper.\n",
                          " steckt ein Emblem an.\n" }) );
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:0,T_HEAT_PROT:0 ]) );

  AddDetail( ({"rose", "zeichen", "rosenemblem", "erinnerung", "freundschaft"}),
    "Einige Blaetter zieren dieses Zeichen.");
  AddDetail( ({"herz", "herzen"}),
    "Genau dort ist die Rose.");
  AddDetail( ({ "blatt", "blaetter" }),
    "Die Blaetter leuchten durch die Kraft der Magie.");
  AddDetail( ({ "macht", "magie", "kraft", "freundschaft" }),
    "Nie wirst Du diesen besonderen Menschen vergessen koennen!");
  AddDetail( ({ "menschen", "mensch" }),
    "Zidane ist es! Er hat sogar Dir zu Ehren eine Widmung einritzen "
    "lassen.");
  AddDetail( ({"zidane"}),
    "Ein besonderer Mensch, genau wie Du.");
  AddDetail( ({ "widmung" }),
    "Wenn Du das liest, weisst Du das jemand an Dich denkt.");
  AddDetail( ({ "dich", "du", "aradia" }),
    "Aradia.");
  AddDetail( ({"edelstein", "zentrum", "pracht" }),
    "Dieser wunderschoene Edelstein ist so schoen wie Du.");



}

