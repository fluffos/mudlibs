
inherit "std/armour";           

#include "../def.h"
            
void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  AddId("amulett");
  AddId("\nkapaneus");

  
  
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Amulett");
  SetProp(P_SHORT, "Ein mystisches Amulett");
  SetProp(P_LONG, 
      "Das ist ein wunderschoenes Amulett. Irgendwie scheint "
      "eine maechtige, magische Aura von ihm auszugehen. Das Material "
      "aus dem das Amulett besteht scheint aus einem seltenen Kristall "
      "zu bestehen.\n" );
  SetProp(P_INFO,
     "Dieses Amulett ist mit Sicherheit einzigartig. Du bist Dir sicher,"
     "dass Dich dieses Amulett mehr als gut beschuetzen wird. Ganz egal "
     "ob vor Schlaegen, Magie oder Umwelteinfluessen.\n" );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 1500);
  SetProp(P_MAGIC, 1);
  SetProp(P_MATERIAL, ([ MAT_MISC : 50, MAT_LEATHER : 10, MAT_MISC_MAGIC: 40 ]  ) );
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 130);
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT: 16 ]) ); 
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES+MAGICAL_DAMAGE_TYPES);
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Du legst das mystische Amulett an.\n",
                          " legt ein mystisches Amulett an.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du nimmst das mystische Amulett ab.\n",
                            " nimmt ein mystisches Amulett ab.\n" }) );
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:1,T_HEAT_PROT:1 ]) );



}

