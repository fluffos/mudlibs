#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzstaebchen");
  SetProp(P_LONG,
    "Ein ganz normales Holzstaebchen." );
  SetProp(P_NAME, "Holzstaebchen");
  SetProp(P_INFO, "Das kannst Du sicherlich als Loeffel verwenden.");
  SetProp(P_GENDER, NEUTER);
  AddId(({"holzstaebchen","\nstaebchen"}));

  AddDetail( ({"loeffel"}),
	    "Damit kann man doch etwas essen.");

  SetProp(P_MATERIAL, MAT_MISC_WOOD ); 
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
}

