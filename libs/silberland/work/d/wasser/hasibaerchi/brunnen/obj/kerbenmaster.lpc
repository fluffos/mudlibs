#include "../def.h"
#include <ansi.h>
#include <properties.h>

mapping kerbholz=([ ]);
void create() 
{
  if (!is_clone(TO)) return;
  restore_object(LOG "kerbholz");
}

int AddKerbe(string npc)
{
  if(!strlen(npc)) return 0;

  /*Security!!!*/
  if(!PO) return 0;
  if(strstr(file_name(PO), NPC "ring_npc") != 0) return 0;
  
  if(!member(kerbholz, npc))
  {
    kerbholz+=([npc:1]);
    return 1;
  }

  kerbholz[npc]++;
  return 1;
}

string *QueryNpc()
{
  return m_indices(kerbholz);
}

string *QueryKerben()
{
  return m_values(kerbholz);
}

/* Zum haendischen sichern und neu laden der Werte (fuer Notfaelle) */
void SaveValues()
{
  save_object(LOG "kerbholz");
}

void RestoreValues()
{
  restore_object(LOG "kerbolz");
}
