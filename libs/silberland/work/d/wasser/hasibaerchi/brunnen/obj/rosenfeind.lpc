#include "../def.h"

inherit "std/thing";


void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Rosenfeind!" );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"\n_rosenfeind"}));

  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NOSELL, 1);
      

}

void reset()
{
  ::reset();
  remove();
}

