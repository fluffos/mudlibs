#include "../def.h"

inherit "std/thing";

string tafel();

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Tafel mit Kerben");
  SetProp(P_LONG,
    "Auf dieser Tafel sind die Kerben der NPC aufgelistet.\n" 
    "Mit <lies kerbentafel> kannst Du die Tafel lesen."
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kerbentafel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tafel","kerbentafel","holztafel"}));

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 999);
  SetProp(P_SIZE, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOGET, "Was willst Du denn mit einer Holztafel?\n");

  AddReadDetail( ({"kerbentafel","tafel","holztafel"}), #'tafel);
  
}

string tafel()
{
  string txt, s, *npc, *kerben;
  int i, j, rest, count, npc_length;
  npc=call_other(KERBENMASTER, "QueryNpc");
  kerben=call_other(KERBENMASTER, "QueryKerben");
  txt="";
  s="";

  for(i=0; i<sizeof(npc) && i<sizeof(kerben); i++)
  {
    for(j=0; j<sizeof(kerben); j+=10)
      if(kerben[i]<j) 
        count = j;
    txt+=sprintf("%45-'.'s%d\n", CAP(npc[i]), kerben[i]);
  }

  return "  Gegner                       getoetete Spieler\n"+
	 "------------------------------------------------\n"+
	 txt+"\n";
}
