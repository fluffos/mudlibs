#include "../def.h"

#include <properties.h>

int room;
void TellRoom();

void create() 
{
  if (!is_clone(TO)) return;
  TellRoom();
}

void TellRoom()
{
  room=random(3)+1;
}

int QueryRoom()
{
  return room;
}

int CompareRooms(int here)
{
  return !(room != here);
}

void SetRoom(int q)
{
  room=q;
}

void reset()
{
  TellRoom();
}
