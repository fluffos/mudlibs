			  , DT_HOLY: -1.0, DT_UNHOLY: 0.3, DT_LIGHT: -1.0])); 
  npc->SetProp(P_SPELLRATE, 30);
  npc->AddSpell(1, 999,
		"Der Erzengel schiesst einen Todespfeil auf Dich ab!\n",
