#include <properties.h>
#include  <npcmaster.h>
string *rad1=({"seicherl", "woodysch", "jungfraeulich", "mittelmaessig", "pow-wow-eh"});
string *rad2=({"weich", "hart", "dunkel", "hell", "lieb", "fies"});

void create() 
{
  if (!is_clone(TO)) return;
}

private int hasibersi(object pl)
{
  object npc;
  npc=clone_object(NPC "ring_npc");

  /* Einstellungen */
  npc->create_default_npc(40);
  npc->SetProp(P_HANDS, ({" mit seiner Axt an",600,DT_SLASH}));
  npc->SetProp(P_NAME, "Hasibersi");
  npc->SetProp(P_GENDER, NEUTER);
  npc->SetProp(P_SHORT, "Das Hasibersi");
  npc->SetProp(P_LONG, "Vor Dir steht ein zwei Meter grosses zweibeiniges Haeschen. "
		       "Auf seinem Kopf traegt es ein rotes Stirnband und in seinen "
		       "Haenden ruht eine gewaltige Axt. Sein weiches Fell ist ueberall "
		       "mit Blut seiner Feinde bedeckt.");
  npc->AddId( ({"hasibersi", "hasi"}) );
  npc->SetProp(P_ARTICLE, 0);
  npc->SetProp(P_BODY, 120);
  npc->ModifySkillAttribute(this_object(),
        SA_SPEED, 300, 3600);
  npc->SetProp(P_SPELLRATE, 25);
  npc->SetProp(P_RESISTANCE_STRENGTHS ,([DT_SLASH: -0.4, DT_BLUDGEON: -0.4
			  , DT_PIERCE: -0.4, DT_SQUEEZE: -0.4, DT_WHIP: -0.4
			  , DT_RIP: -0.4, DT_FIRE: -0.2, DT_WATER: -0.2
			  , DT_AIR: -0.2, DT_COLD: -0.2, DT_TERROR: -0.2])); 
  npc->AddSpell(1, 999,
		"Das Hasibersi schmettert Dich zu Boden!\n",
		"Das Hasibersi schmettert @WEN zu Boden!\n",
		({DT_EXPLOSION}), ([SP_SHOW_DAMAGE:1]));
  npc->AddSpell(1,500,
		"Das Hasibersi bruellt Dich an!\n",
		"Das Hasibersi bruellt @WEN an!\n",
		({DT_SOUND}), ([SP_SHOW_DAMAGE:1]));
  npc->move(ENV(pl), M_NOCHECK);
  npc->Kill(pl);

  return 1;
}

private int eisengolem(object pl)
{
  object npc;
  npc=clone_object(NPC "ring_npc");

  /* Einstellungen */
  npc->create_default_npc(40);
  npc->SetProp(P_HANDS, ({" mit seinen eisernen Haenden an",700,DT_BLUDGEON}));
  npc->SetProp(P_RACE, "Golem");    
  npc->SetProp(P_NAME, "Eisengolem");
  npc->SetProp(P_SHORT, "Ein Eisengolem");
  npc->SetProp(P_LONG, "Vor Dir steht ein zwei Meter grosser eiserner Gigant. "
		       "Niemand wird ihn besiegen koennen.");
  npc->AddId(({"eisengolem", "golem"}));
  npc->SetProp(P_ARTICLE, 1);
  npc->SetProp(P_BODY, 150);
  npc->ModifySkillAttribute(this_object(),
        SA_SPEED, 200, 3600);
  npc->SetProp(P_RESISTANCE_STRENGTHS ,([DT_SLASH: -0.7, DT_BLUDGEON: -0.4
			  , DT_PIERCE: -0.4, DT_SQUEEZE: -0.9, DT_WHIP: -0.8
			  , DT_RIP: -0.6, DT_FIRE: -0.4, DT_WATER: -0.4
			  , DT_AIR: -0.4, DT_COLD: -0.6, DT_TERROR: -1.0
			  , DT_MIND: -1.0, DT_LIGHTNING: -0.8, DT_ELECTRIC: -0.8
			  , DT_ACID: 0.4, DT_LIGHT: -1.0])); 
  npc->SetProp(P_SPELLRATE, 25);
  npc->AddSpell(1, 999,
		"Der Eisengolem schmettert seine Haende zusammen!\n",
		"Der Eisengolem schmettert @WEN zu Boden!\n",
		({DT_EXPLOSION}), ([SP_SHOW_DAMAGE:1]));
  npc->AddSpell(1,600,
		"Der Eisengolem schiesst einen Lavastrahl auf Dich!\n",
		"Der Eisengolem schiesst einen Lavastrahl auf @WEN!\n",
		({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));
  npc->move(ENV(pl), M_NOCHECK);
  npc->Kill(pl);

  return 1;
}
