int TestEinstellung(string einst, int rad)
{
  string *rad1, *rad2;
  rad1=({"seicherl", "woodysch", "jungfraeulich", "mittelmaessig", "pow-wow-eh"});
  rad2=({"weich", "hart", "dunkel", "hell", "lieb", "fies"});
  if(rad == 1)
  {
    return member(rad1, einst)+1;
  }
  if(rad == 2)
  {
    return member(rad2, einst)+1;
  }
  return -1;
}


int Case(string rad1, string rad2, object pl)
{
  if(rad1=="woodysch" && rad2=="weich")
  {
    return hasibersi(pl);
  }
  if(rad1=="woodysch" && rad2=="hart")
  {
    return eisengolem(pl);
  }
  if(rad1=="woodysch" && rad2=="hell")
  {
    return erzengel(pl);
  }
  if(rad1=="woodysch" && rad2=="dunkel")
  {
    return nichts(pl);
  }
  if(rad1=="woodysch" && rad2=="fies")
  {
    return todesritter(pl);
  }
  if(rad1=="woodysch" && rad2=="lieb")
  {
    return amazone(pl);
  }
  if(rad1=="pow-wow-eh" && rad2=="weich")
  {
    return riesenknuddel(pl);
  }
  if(rad1=="pow-wow-eh" && rad2=="hart")
  {
    return riesenfaust(pl);
  }
  if(rad1=="pow-wow-eh" && rad2=="hell")
  {
    return effreti(pl);
  }
  if(rad1=="pow-wow-eh" && rad2=="dunkel")
  {
    return todesschatten(pl);
  }
  if(rad1=="pow-wow-eh" && rad2=="fies")
  {
    return cardela(pl);
  }
  if(rad1=="pow-wow-eh" && rad2=="lieb")
  {
    return altmagier(pl);
  }
  if(rad1=="mittelmaessig" && rad2=="weich")
  {
    return riesenschwamm(pl);
  }
  if(rad1=="mittelmaessig" && rad2=="hart")
  {
    return knochengolem(pl);
  }
  if(rad1=="mittelmaessig" && rad2=="hell")
  {
    return flammenschwert(pl);
  }
  if(rad1=="mittelmaessig" && rad2=="dunkel")
  {
    return dunkelschrecken(pl);
  }
  if(rad1=="mittelmaessig" && rad2=="fies")
  {
    return wuerger(pl);
  }
  if(rad1=="mittelmaessig" && rad2=="lieb")
  {
    return schockotroll(pl);
  }
  if(rad1=="jungfraeulich" && rad2=="weich")
  {
    return pandabaer(pl);
  }
  if(rad1=="jungfraeulich" && rad2=="hart")
  {
    return streitkolben(pl);
  }
  if(rad1=="jungfraeulich" && rad2=="hell")
  {
    return wichtel(pl);
  }
  if(rad1=="jungfraeulich" && rad2=="dunkel")
  {
    return tiefengnom(pl);
  }
  if(rad1=="jungfraeulich" && rad2=="fies")
  {
    return gnoll(pl);
  }
  if(rad1=="jungfraeulich" && rad2=="lieb")
  {
    return vanilleeis(pl);
  }
  if(rad1=="seicherl" && rad2=="weich")
  {
    return pelzkugerl(pl);
  }
  if(rad1=="seicherl" && rad2=="hart")
  {
    return oktaeder(pl);
  }
  if(rad1=="seicherl" && rad2=="hell")
  {
    return lichtkugerl(pl);
  }
  if(rad1=="seicherl" && rad2=="dunkel")
  {
    return tintenkleks(pl);
  }
  if(rad1=="seicherl" && rad2=="fies")
  {
    return zwickgnom(pl);
  }
  if(rad1=="seicherl" && rad2=="lieb")
  {
    return maedchen(pl);
  }
  else
    write_file(LOG "ring.log", ANSI_RED"Error: "+CAP(pl->name())+" stellt Rad 1 auf "
	       +rad1+" und Rad 2 auf "+rad2+" dafuer ist kein Monster deklariert!!!"ANSI_NORMAL);

  return 0;
}
