  npc->SetProp(P_GENDER, FEMALE);
  npc->SetProp(P_SHORT, "Cardela die vierarmige Daemonin");
  npc->SetProp(P_LONG, "Vor Dir steht Cardela die vierarmige Daemonin. "
		       "Ihre langen Krallen sind auesserst scharf und "
