// Ein Ritter
inherit "std/npc/spells";
inherit "std/mnpc";

#include "../def.h"

void create() {
	
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Ritter der Schwarzen Rose");
  SetProp(P_LONG, BS(
    "Dieser Ritter der schwarzen Rose hat einen hohen Rang "
    "der Ritterschaft inne. Mit Sicherheit ist er ein guter "
    "Kaempfer, den Du nicht unterschaetzen solltest."));
  SetProp(P_NAME, "Ritter");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"ritter"}));
  AddClass(CL_HUMAN);
 
   create_default_npc(30+random(5));
  SetProp(P_HANDS, ({" mit seinen Haenden an",330,DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -950);
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,([ P_GUILD:(["paladine":1])]));
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
 
    SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5,  DT_COLD:     -0.5,  DT_WATER: -0.5,  DT_AIR:   -0.5, 
      DT_LIGHTNING: -0.1,  DT_EXPLOSION: -0.4,  DT_SOUND:  -0.5,  DT_LIGHT: -0.7,
      DT_ELECTRIC:  -0.1,  DT_ACID:      -0.3,  DT_POISON: -0.6,  DT_TERROR: -0.9,
      DT_HOLY:      0.2,  DT_UNHOLY:    -1.0,  DT_MAGIC:  -0.4,  DT_MIND:   -0.4,
      DT_SLASH:     -0.4,  DT_BLUDGEON:   -0.2,  DT_PIERCE:  -0.2, DT_SQUEEZE:  -0.4, 
      DT_WHIP:      -0.2,  DT_RIP:        -0.4]));
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "tritt aus einem Tor");
  SetProp(P_MMSGOUT, "salutiert und verschwindet");

  SetProp(P_MNPC_AREA, ({ ROOM "brunnen_7", ROOM "brunnen_8", ROOM "brunnen_11"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "brunnen_8");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Niemand wiedersetzt sich dem Orden der Schwarzen Rose.");
  SetProp(P_MURDER_MSG, "Ich werde zurueckkehren und mich an %s raechen.");
  
  AddInfo(DEFAULT_INFO, "wuerdigt Dich keines Blickes.\n");
  
  AddInfo( ({"ritter", "page", "knappe"}), 
	  "Wir sind bestimmt zu herrschen.\n","sagt: ");
  AddInfo( ({"rose", "orden" }),
	  "Unser Orden wird alle Paladine ausrotten, und keine verschonen.\n","sagt: ");
  AddInfo( ({ "drache", "dapdi" }),
	  "Diese feige Kreatur haben wir in einen Schrank gesperrt.\n","sagt: ");
  AddInfo( ({"schwert", "panzer", "ruestung"}),
	  "Damit bekaempfen wir Paladine wo wir sie treffen.\n","sagt: ");

   
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Page reagiert nicht auf Deinen Bestechungsversuch.\n" }) );

  SetChats(8, ({
          
        "Der Ritter salutiert.\n",
	"Der Ritter schaerft seine Klinge.\n",
	"Der Ritter betrachtet Dich eingehend.\n",
	"Der Ritter murmelt etwas unverstaendliches.\n",
	"Der Ritter studiert jede Deiner Bewegungen.\n",
        "Der Ritter zeigt mit dem Finger auf Dich und laechelt daemonisch.\n"}));
  
  SetAttackChats(10, ({
    "Der Ritter schlitzt Dir den Bauch auf.\n",
    "Der Ritter macht eine Finte.\n",
    "Der Ritter konzentriert sich auf Deinen Oberkoerper.\n"
    "Der Ritter konzentriert sich auf Deine Beine.\n"}));

// ----- Spells Anfang -----

  SetProp(P_SPELLRATE, 75);

  AddSpell(3, 650, "Der Ritter schleudert Dir einen Strahl dunkler Energie entgegen.\n",
		   "Der Ritter schleudert @WEM einen dunklen Strahl entgegen.\n",
           ({DT_COLD,DT_UNHOLY}),([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 780, "Die Ritter grillt Dein Hirn mit mentalen Kraeften.\n",
		   "Die Ritter konzentriert sich auf @WEN.\n",
           ({DT_UNHOLY, DT_MIND}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 350, DS_FEAR, "Der Ritter reckt Dir die linke Hand entegen und Du bekommst Angst.\n",
                                   "Der Ritter reckt @WEM die linke Hand entgegen.\n" );

// ----- Spells Ende -----
  
  SUID;
  CLONEME(WEAPON "schwert" );
  command("zuecke schwert");
  CLONEME(ARMOUR "panzer2" );
  command("trage alles");  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "belegt Dich mit einem Fluch.",
	 "belegt "+TP->Name(WEN)+" mit einem Fluch.");
      break; 

    case "aergerlich":
      call_out("react", 0, "spuckt Dich an.",
        "spuckt "+TP->Name(WEM)+" an.");
    break;

    case "frech":
      call_out("react", 0, "zeigt Dir einen Vogel",
        "zeigt "+TP->Name(WEM)+" einen Vogel.");
    break;

    case "nett":
      call_out("react", 0, "spuckt Dich an.",
        " spuckt "+TP->Name(WEM)+" an.");
    break;

    case "froh":
      call_out("react", 0, "ist erleichtert.",
        "ist erleichtert.");
    break;

  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

