// Ein Terminatorzwerg
inherit "std/npc/spells";
inherit "std/mnpc";

#include "../def.h"

void create() {
	
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Terminatorzwerg");
  SetProp(P_LONG, BS(
    "Dieser Zwerg hasst alle Zwerge, und hat es sich zur "
    "Aufgabe gemacht alle Zwerge und Paladine zu "
    "vernichten. Gerade deshalb ist er mit Sicherheit ein "
    "guter Kaempfer, den Du nicht unterschaetzen solltest."));
  SetProp(P_NAME, "Terminatorzwerg");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"zwerg"}));
  AddClass(CL_DWARF);
 
   create_default_npc(25+random(5));
  SetProp(P_HANDS, ({" mit seinen Haenden an",225,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 55000);
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,([ P_GUILD:(["paladine":1]), P_RACE:(["zwerg":1])]));
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
 
    SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3,  DT_COLD:     -0.3,  DT_WATER: 0.2,  DT_AIR:   -0.3, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: -0.2,  DT_SOUND:  -0.3,  DT_LIGHT: -0.5,
      DT_ELECTRIC:  0.0,  DT_ACID:      -0.1,  DT_POISON: -0.6,  DT_TERROR: -0.7,
      DT_HOLY:      0.0,  DT_UNHOLY:    -0.4,  DT_MAGIC:  -0.4,  DT_MIND:   -0.2,
      DT_SLASH:     -0.2,  DT_BLUDGEON:   -0.2,  DT_PIERCE:  -0.2, DT_SQUEEZE:  -0.2, 
      DT_WHIP:      0.0,  DT_RIP:        0.0]));
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "tritt aus einem Tor");
  SetProp(P_MMSGOUT, "salutiert und verschwindet");

  SetProp(P_MNPC_AREA, ({ ROOM "brunnen_7", ROOM "brunnen_8", ROOM "brunnen_11"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "brunnen_11");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Tot allen Zwergen und ihren Freunden.");
  SetProp(P_MURDER_MSG, "Ich werde zurueckkehren und mich an %s raechen.");
  
  AddInfo(DEFAULT_INFO, "wuerdigt Dich keines Blickes.\n");
  
  AddInfo( ({"ritter", "page"}), 
	  "Die Ritter sind bestimmt zu herrschen.\n","sagt: ");
  AddInfo( ({"rose", "orden" }),
	  "Der Orden wird alle Paladine ausrotten, und keine verschonen.\n","sagt: ");
  AddInfo( ({ "drache", "dapdi" }),
	  "Diese feige Kreatur wurde in einen Schrank gesperrt.\n","sagt: ");
  AddInfo( ({"schwert", "panzer", "ruestung"}),
	  "Damit bekaempfen wir Paladine wo wir sie treffen.\n","sagt: ");
  AddInfo( ({ "zwerg", "zwerge"}),
	  "Zwerge muessen vernichtet werden, alle!\n","sagt: ");

   
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Terminatorzwerg reagiert nicht auf Deinen Bestechungsversuch.\n" }) );

  SetChats(15, ({
          
        "Der Terminatorzwerg grinst daemonisch.\n",
	"Der Terminatorzwerg prueft seinen Zertruemmerer.\n",
	"Der Terminatorzwerg betrachtet Dich eingehend.\n",
	"Der Terminatorzwerg murmelt etwas zwergisches.\n",
	"Der Terminatorzwerg studiert jede Deiner Bewegungen.\n",
        "Der Terminatorzwerg zeigt mit dem Finger auf Dich und laechelt daemonisch.\n"}));
  
  SetAttackChats(10, ({
    "Der Terminatorzwerg zertruemmert Dir den Schaedel.\n",
    "Der Terminatorzwerg macht eine Finte.\n",
    "Der Terminatorzwerg konzentriert sich auf Deinen Oberkoerper.\n"
    "Der Terminatorzwerg zertruemmert Deine Beine.\n"}));

// ----- Spells Anfang -----

  SetProp(P_SPELLRATE, 25);

  AddSpell(3, 450, "Der Terminatorzwerg spuckt Dich an.\n",
		   "Der Terminatorzwerg spuckt @WEM an.\n",
           ({DT_ACID,}),([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 520, "Die Terminatorzwerg grillt Dein Hirn mit mentalen Kraeften.\n",
		   "Die Terminatorzwerg konzentriert sich auf @WEN.\n",
           ({DT_MIND}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 150, DS_FEAR, "Der Terminatorzwerg reckt Dir die linke Faust entegen und Du bekommst Angst.\n",
                                   "Der Terminatorzwerg reckt @WEM die linke Faust entgegen.\n" );

// ----- Spells Ende -----
  
  SUID;
  CLONEME(WEAPON "zertruemmerer" );
  command("zuecke zertruemmerer");
  clone_object("/p/armour/gloves/kettenhandschuhe")->move(this_object());
  clone_object("/p/armour/boots/kampfstiefel")->move(this_object());
  clone_object("/p/armour/helm/titanhelm")->move(this_object());
  clone_object("/p/armour/trousers/kettenhose")->move(this_object());
  clone_object("/p/armour/armour/titanpanzer")->move(this_object());


  command("trage alles");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "belegt Dich mit einem Fluch.",
	 "belegt "+TP->Name(WEN)+" mit einem Fluch.");
      break; 

    case "aergerlich":
      call_out("react", 0, "spuckt Dich an.",
        "spuckt "+TP->Name(WEM)+" an.");
    break;

    case "frech":
      call_out("react", 0, "zeigt Dir einen Vogel",
        "zeigt "+TP->Name(WEM)+" einen Vogel.");
    break;

    case "nett":
      call_out("react", 0, "spuckt Dich an.",
        " spuckt "+TP->Name(WEM)+" an.");
    break;

    case "froh":
      call_out("react", 0, "ist erleichtert.",
        "ist erleichtert.");
    break;

  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

