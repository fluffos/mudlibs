#include "../def.h"

inherit "/std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Ring-NPC");
  SetProp(P_LONG,
    "Das hier steht hoffentlich nicht da!"
  );

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ring-NPC");
  SetProp(P_GENDER, MALE);
  AddId(({"\nhasibaerchi_ring_npc","NOWIMPY"}));
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------
  SetProp(P_HANDS, ({" mit seinen Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })
  );

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
 

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will Deine Sachen nicht tragen.\n" }) );


//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if(!call_other(ROOM "brunnen_6", "RingFighter", enemy))
  {
    tell_object(enemy, Name(WER, 1)+" ist nicht Dein Gegner!\n");
    StopHuntFor(enemy, 1);
    enemy->StopHuntFor(TO, 1);
    return 0;	    
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}


void init()
{
  ::init();
  if(call_other(ROOM "brunnen_6", "RingFighter", TP))
    Kill(TP);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(killer == TO)
  {
    KERBENMASTER->AddKerbe(Name(WER, 1));
    write_file(LOG "ring.log", ctime()+": "+CAP(getuid(victim))+" wird von "+Name(WER, 1)+
               " umgebracht.\n");
  }
}

void die(int poisondeath)  
{
  write_file(LOG "npc.kills",
      ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")
      +" killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}


void Attack(object enemy)
{
  if(!call_other(ROOM "brunnen_6", "RingFighter", enemy))
  {
    tell_object(enemy, Name(WER, 1)+" laesst von Dir ab!\n");
    tell_object(ENV(enemy),Name(WER, 1)+" laesst von "+CAP(enemy->name())+" ab.\n");
    StopHuntFor(enemy, 1);
    enemy->StopHuntFor(TO, 1);
    return;
  }
  ::Attack(enemy);
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  say(Name(WER, 1)+" loest sich auf.\n");
  remove();
}
