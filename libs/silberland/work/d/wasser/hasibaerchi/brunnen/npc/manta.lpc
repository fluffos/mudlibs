
inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Manta");
  SetProp(P_LONG,
    "Der elegante Manta trachtet Dir nach Deinem Leben. Mit seinen maechtigen "
    "Schwingen wirkt es fast so als fliege er durch das Wasser. Sein langer "
    "Schwanz ist eine toedlich Waffe, mit der Du Dich besser nicht anlegen "
    "solltest.");
  SetProp(P_NAME, "Manta");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:35]));
  AddId(({"manta"}));

  create_default_npc(18+random(5));
  SetProp(P_HANDS, ({" mit seinem giftigen Schwanz",195,DT_PIERCE}));
  SetProp(P_RACE, "Fisch");
  SetProp(P_SIZE, 370+random(40));
  SetProp(P_WEIGHT, 66000+random(30));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0,  DT_COLD:      0.5,  DT_WATER:  -1.0, DT_AIR:    -0.3, 
      DT_LIGHTNING: -1.0,  DT_EXPLOSION: -1.0, DT_SOUND:  -0.4,  DT_LIGHT:  0.3,
      DT_ELECTRIC:  -1.0,  DT_ACID:      -1.0,  DT_POISON: -1.0,  DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC: 0.0,   DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein.");
  SetProp(P_MMSGOUT, "schwimmt weg");

  SetProp(P_DIE_MSG,  " schwebt auf den Grund.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_KILL_MSG, "Du schmeckst aber lecker!!");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Manta kann Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE, 40);

  AddDefaultSpell(2, 4, DS_POISON, "Du spuerst wie Gift in Dich dringt.\n",
                  "@WER wird blasser.\n");
  AddSpell(4, 510, "Eine heisse Wasserwelle trifft Dich.\n",
                  "Die Haut von @WEM brutzelt.\n",({DT_WATER,DT_FIRE}),([SP_SHOW_DAMAGE:1]) );
  AddSpell(3, 750, "Der Manta schleudert Dir einen Blitz entgegen.\n",
                  "Der Manta schleudert @WEM einen Blitz entgegen\n",({DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]) );

}
