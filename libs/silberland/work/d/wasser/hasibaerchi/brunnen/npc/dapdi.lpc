inherit "std/npc";

#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Dapdi der Taschendrache");
  SetProp(P_LONG,
    "Dapdi ist ein kleiner, suesser Taschendrache. Er ist circa fuenfundzwanzig "
    "cm gross und hat kleine, suesse schwarze Knopfaugen, die er hinter einer "
    "Lesebrille versteckt. Du musst ihn gerade aus dem Schlaf gerissen haben, "
    "da er noch eine kleine Schlafhaube auf seinem Kopf traegt.");
  SetProp(P_NAME, "Dapdi");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({ "taschendrache", "dapdi" }));

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Minikrallen" ,200, DT_RIP }) );
  SetProp(P_SIZE, 25 );
  SetProp(P_RACE, "Drache");
  SetProp(P_ALIGN, 450);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);

  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt weg");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " schnieft noch ein letztes Mal.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste Mal %s, hack ich Dich um.");

  SetProp(P_KILL_NAME, "Dapdi");
  SetProp(P_KILL_MSG, "Du hattest keine Chance, Baby!");
  SetProp(P_NOATTACK, "wehrt Deinen Angriff mit einem Augenzwinkern ab.\n");

  AddInfo(DEFAULT_INFO, "hat darauf keine Antwort fuer Dich. Frag "
		        "ihn nach etwas anderem.\n");

  AddDetail( ({ "schlafhaube", "haube", "muetze" }),
    "Eine echt suesse Muetze hat der Dapdi da.");
  AddDetail( ({ "knopfaugen", "augen" }),
    "Einfach nur putzig.");
  AddDetail( ({ "lesebrille", "brille" }),
    "Die braucht Dapdi sicher zum lesen, wahrscheinlich sind seine Augen "
    "nicht mehr so gut wie frueher.");
  AddDetail( ({ "kette" }),
    "Da ist ja wirklich eine kleine Kette um seinen Hals.");
  AddDetail( ({ "hals" }),
    "Sehr schlank und zierlich, aber irgendwie doch sehr kraeftig.");
  AddDetail( ({ "kopf" }),
    "Einfach niedlich.");
  AddDetail( ({ "schlaf" }),
    "Dapdi reibt sich die Augen.");
  
  AddInfo( ({"hiri", "hasibaerchi"}),
    "Wenn es Hiri nicht gaebe, gaebe es Hasibaerchi nicht, und dann wuerde es "
    "mich auch nicht geben.",
    "sagt: ");
  AddInfo( ({"taschendrache","dapdi", "vater"}),
    "Ich bin Dapdi, der Taschendrache. Jetzt staunst Du gell!",
    "protzt: ");
  AddInfo( ({ "schloss", "zahlenschloss" }),
    "Ach Du meinst das Zahlenschloss im Altarraum? Ja, das kenne ich.",
    "sagt: ");
  AddInfo( ({ "altarraum" }),
    "Dort ist es sehr gefaehrlich.",
    "fluestert: ");
  AddInfo( ({ "geheimzahl", "kombination" }),
    "Achja die Kombination. Weisst Du das ist so eine Sache.",
    "sagt: ");
  AddInfo( ({ "sache" }),
    "Die Sache ist gar nicht so einfach. Um die richtige Kombination "
    "zu erfahren musst Du erst ein Raetsel loesen.",
    "sagt: ");
  AddInfo( ({ "raetsel" }),
    "Dort wo das Dasein einsam, Weisheit.",
    "sagt: ");
  AddInfo( ({ "weisheit", "dasein"}),
    "Mehr kann ich Dir nicht helfen.",
    "sagt enttaeuscht: ");
  AddInfo( ({ "anzahl" }),
    "Das hat schon Spietato versucht, leider hat es nicht geklappt.",
    "sagt traurig: ");
  AddInfo( ({ "spietato" }),
    "Einfach schlau. Sie ist wirklich sehr schlau",
    "schwaermt: ");  
  AddInfo( ({"drache", "drachen"}),
    "Das sind meine grossen Cousins, wie elegant die fliegen koennen.",
    "schwaermt: ");
  AddInfo( ({"aroobah", "meisterforscherin"}),
    "Aroobah sagte immer, man muesse das Endergebnis verdoppeln um hier rauszukommen "
    "und dann noch 1 abziehen.",
    "kichert: ");
  AddInfo( ({ "ausgang"}),
    "Klar weiss ich wie Du hier rauskommst. Du brauchst nur die magische Zahl "
    "dafuer.",
    "sagt: ");
  AddInfo( ({ "zahl", "geheimnis", "mystische zahl", "magische zahl"}),
    "Pscht. Ich werde Dir das Geheimnis der magischen Zahl verraten. Hier in "
    "meiner Wohnung sind ueberall Zahlen versteckt. Du musst sie alle finden, "
    "und danach die geraden Zahlen addieren und die ungeraden Zahlen "
    "subtrahieren. Wenn Du dann die Zahl hast musst Du sie ganz leise sagen, "
    "und zwar genau so wie ich jetzt mit Dir rede.",
    "fluestert: ");
  AddInfo( ({ "zahlen" }),
    "Die sind hier alle gut versteckt, also mach Dich daran alle zu finden.",
    "sagt: ");
  AddInfo( ({ "clumsy", "kumpel", "glueck" }),
    "Ach Clumsy, mein alter kleiner Kumpel. Mann hatten wir frueher viel Spass. "
    "Wenn ich mich recht erinnere, wurde er ja auch als Gott verehrt. Nicht "
    "schlecht fuer einen kleinen Hobbit, gell.",
    "sagt: ");
  AddInfo( ({ "gott" }),
    "Kaum zu glauben aber so ist das Leben. Erst Hobbit, dann Gott, und am "
    "Ende landest Du in der Vergessenheit.",
    "sagt: ");
  AddInfo( ({ "spass" }),
    "Ja das war bevor ich hier eingesperrt wurde. Diese bloeden Ritter. Am "
    "liebsten wuerde ich ihnen mal eine auf die Muetze geben, aber mein Glaube "
    "verbietet mir jede Art von Gewalt.",
    "sagt: ");
  AddInfo( ({ "glaube", "gewalt" }),
    "Wie ich bereits sagte verbietet mir mein Glaube jede Art von Gewalt. "
    "So sollte ja auch jeder Priester sein, auch wenn es ihm nicht leicht faellt.",
    "sagt: ");
  AddInfo( ({ "priester" }),
    "Jup, diese Kette hier zeigt, dass ich Priester bin.",
    "sagt: ");
  AddInfo( ({ "kette" }),
    "Die habe ich persoenlich von Kapaneus bekommen.",
    "sagt: ");
  AddInfo( ({ "kapaneus" }),
    "Zu Kapaneus bete ich, er gibt mir Kraft. Solltest Du einmal verzweifeln, "
    "suche einen Ort wo man beten kann, und richte Deine Stimme zu Kapaneus. "
    "Er wird Dir helfen.",
    "sagt: ");
  AddInfo( ({ "muetze", "schlafmuetze" }),
    "Ich finde meine Schlafmuetze auch sehr huebsch. Steht mir richtig gut.",
    "sagt: ");
  AddInfo( ({ "ritter"}),
    "Die haben meine Soehne getoetet und mich hier eingesperrt! ",
    "flucht: ");
  AddInfo( ({ "hilfe" }),
    "Klar kann ich Dir helfen.",
    "sagt: ");
  AddInfo( ({ "zimmer", "schrank", "wohnung" }),
    "Hier wohne ich. Leider schon viel zu lange.",
    "sagt: ");
  AddInfo( ({ "wissen" }),
    "Oh ja, ich weis ne Menge, musst nur die richtigen Fragen stellen.",
    "sagt: ");
  AddInfo( ({ "fragen" }),
    "Das waere doch fuer einen Helden wie Dich viel zu leicht. Da hilft auch "
    "kein betteln, Du musst schon selber die richtigen Fragen stellen.",
    "sagt: ");
  AddInfo( ({ "familie", "erinnerungen" }),
    "Oh meine arme Frau, meine armen Kinder. Sie muessen ohne ihren Vater "
    "leben. So ganz allein ohne meine Sorge. Hoffentlich geht es ihnen "
    "gut. Ich bin schon richtig verzweifelt.",
    "schnieft: ");
  AddInfo( ({ "sorge" }),
    "Hoffentlich wird fuer meine Familie gut gesorgt.",
    "sagt: ");
  AddInfo( ({ "kinder", "kind" }),
    "Meine kleinen Kinder, meine suessen Toechter, meine stolzen Soehne!",
    "weint: ");
  AddInfo( ({ "soehne" }),
    "Meine armen Soehne! Diese verfluchten Ritter haben mir meine Soehne "
    "genommen! Sie haben meine beiden Soehne getoetet als sie mich geholt "
    "haben, dabei wollten meine Soehne mir nur zur Seite stehen! Ich kann "
    "sie aufgrund meines Glaubens nicht bekaempfen, aber ich verfluche diese "
    "Ritter bis in alle Ewigkeit!",
    "schreit: ");
  AddInfo( ({ "ewigkeit" }),
    "So lange ich lebe, werde ich ihnen niemals verzeihen.",
    "schreit: ");
  AddInfo( ({ "seite" }),
    "Meine Soehne haben gekaempft, diese jungen Narren. Dabei schafft Gewalt "
    "nur noch mehr Leid.",
    "schnieft: ");
  AddInfo( ({ "narr", "narren" }),
    "Gewalt verursacht nur neue Gewalt. Meine armen Soehne haben diese "
    "Erkenntnis mit ihrem Leben bezahlen muessen.",
    "sagt: ");
  AddInfo( ({ "erkenntnis" }),
    "Gar grausam kann das Leben sein.",
    "schnieft: ");
  AddInfo( ({ "leben" }),
    "Warum toeteten sie nur meine Soehne und nahmen mich gefangen? Mein "
    "Leben haetten sie nehmen koennen, aber meine Soehne ..... Warum nur?",
    "fragt: ");
  AddInfo( ({ "leid" }),
    "Mein Glaube wird mir helfen darueber hinwegzukommen, aber wie meine "
    "geliebte Frau darueber hinwegkommen wird weiss ich nicht. Ich hoffe "
    "sie schafft es irgendwie ihr Leid zu ertragen.",
    "sagt: "); 
  AddInfo( ({ "toechter", "tochter" }),
    "Oh ja, meinen lieben Toechter. Ich vermisse sie so sehr, die schlimme "
    "Kleinlalo, die huebsche Lalo und auch die schlaue Wifflalo.",
    "schnieft: ");
  AddInfo( ({ "wifflalo" }),
    "Sie ist die schlaueste meiner Toechter. Sie hat den Drachenschlautest "
    "schon im zarten Alter von zehn Jahren mit Auszeichnung bestanden.",
    "prahlt: ");
  AddInfo( ({ "drachenschlautest", "test", "schlautest"}),
    "Der ist megaschwer! Sie hat sogar mehr Punkte gemacht als ich. Ahaem, "
    "ich wollte sagen, mehr Punkte gemacht als ich damals, als ich so jung war.",
    "huestelt: ");
  AddInfo( ({ "punkte" }),
    "Ja, mit Punkten wird der Test bewertet, je mehr Punkte desto besser. Sie "
    "hatte hundertvierzig Punkte und ich dreiundneunzig. Ahaem, ich meine "
    "natuerlich damals.",
    "huestelt: ");
  AddInfo( ({ "alter", "jahre" }),
    "Sie war damals noch wirklich jung.",
    "sagt: ");
  AddInfo( ({ "auszeichnung" }),
    "Meine Frau und ich, wir waren damals so stolz auf unsere Wifflalo. Die "
    "Auszeichnung hat sie sich auch wirklich verdient.",
    "sagt: ");
  AddInfo( ({ "lalo", "huebscher lalo" }),
    "Sie ist die huebscheste meiner Toechter. Wenn sie gross ist, wird sie "
    "sicher ein Drachenmodel werden.",
    "prahlt: ");
  AddInfo( ({ "drachenmodel", "model", "drachenmodell", "modell" }),
    "Oh ja, sie wird dann sicher auch die neueste Drachenmode praesentieren. "
    "Sie ist einfach geboren fuer den Laufsteg.",
    "prahlt: ");
  AddInfo( ({ "drachenmode", "mode" }),
    "Darin wird sie sicher noch huebscher sein!",
    "prahlt: ");
  AddInfo( ({ "laufsteg", "steg" }),
    "Ich seh sie schon vor mir, elegant ueber den Laufsteg fliegen.",
    "schwaermt: ");
  AddInfo( ({ "kleinlalo", "schlimme kleinlalo" }),
    "Sie ist die juengste meiner Toechter. Sie ist noch so jung, dass sie "
    "noch die Eierschale am Kopf hatte, als ich sie das letzte Mal sah. Sie "
    "ist ein so aufgewecktes Kind, ich vermisse sie so sehr.",
    "weint: ");
  AddInfo( ({ "eierschale", "schale" }),
    "Die war noch ganz rosa knackig frisch.",
    "jammert: ");
  AddInfo( ({ "kopf" }),
    "Sie kommt ganz klar nach ihrer Mutter, meiner geliebten Frau.",
    "sagt: ");
  AddInfo( ({ "frau", "lalobe", "mutter" }),
    "Meine Frau Lalobe ist die schoenste Drachendame auf der Welt. Sie hat "
    "so eine suesse Schnauze, engelsgleiche Augen und erst ihre Schuppen .... ",
    "schwaermt: ");
  AddInfo( ({ "welt" }),
    "Darueber weiss ich leider nicht sehr viel. Erzaehl mir doch was darueber.",
    "sagt: ");
  AddInfo( ({ "drachendame", "dame" }),
    "Koennte ich doch nur zu ihr!",
    "weint: ");
  AddInfo( ({ "schnauze" }),
    "Nie wieder werde ich diese schoenste aller Schnauzen kuessen koennen!",
    "heult: ");
  AddInfo( ({ "schuppen" }),
    "Ihre Schuppen waren so weich und zart, sie zu streicheln war ein Genuss "
    "sondergleichen.",
    "schwaermt: ");
  AddInfo( ({ "genuss" }),
    "Wie schoen es war.",
    "seufzt: ");
  AddInfo( ({ "augen" }),
    "Wie ich mich nach ihren traumhaften Augen sehne.",
    "traeumelt: ");
  AddInfo( ({ "brunnen" }),
    "Eigentlich ist es nur der Hintereingang fuer die Ritter.",
    "sagt: ");
  AddInfo( ({ "eingang" }),
    "Wo der richtige Eingang ist, weiss ich nicht. Ich kenne nur den "
    "Hintereingang.",
    "sagt: ");
  AddInfo( ({ "hintereingang" }),
    "Jup genau.",
    "sagt: ");
  AddInfo( ({ "bild", "bilder" }),
    "Ich male gerne, vorallem so huebsche Motive wie Dich.",
    "sagt: ");
  AddInfo( ({ "motive", "motiv" }),
    "Also ich finde Dich sehr, nun ja, sehr interessant zu zeichnen. Du "
    "bist eine Herausforderung fuer einen Kuenstler wie mich.",
    "sagt: ");
  AddInfo( ({ "naar" }),
    "Sprich diesen Namen niemals aus. Wenn du wirklich tapfer bist, rufe "
    "diesen Namen dort wo das Nichts herrscht. Doch sei gewarnt, von dort "
    "gibt es kein Entkommen, den sein Diener wird versuchen Dich zu "
    "vernichten.",
    "fluestert: ");
  AddInfo( ({ "diener", "soth", "lord" }),
    "Soth, Lord Soth.",
    "fluestert: ");
  AddInfo( ({ "entkommen" }),
    "Bete, bete zu den wahren Goettern, nur so wirst Du entkommen koennen.",
    "sagt: ");
  AddInfo( ({ "goetter" }),
    "Die wirst Du sicher kennen.",
    "sagt: ");
  AddInfo( ({ "pyramide" }),
    "Oh du hast sie also gefunden. Ich habe gehofft, dass sie niemals "
    "gefunden wird. Aber da Du jetzt von ihr weisst, nun ja. Also "
    "was willst Du wissen?",
    "fragt Dich: ");
  AddInfo( ({ "uebersetzung", "rune", "runen", }),
    "Ja die Runen enthalten eine Nachricht, oder besser gesagt eine "
    "Warnung. Aber wenn Du willst, dass ich dir was uebersetze, frage "
    "mich einfach nach dem Wort das ich Dir uebersetzen soll.",
    "sagt: ");
  AddInfo( ({ "warnung" }),
    "Nicht umsonst habe ich die Runen erschaffen. Ich wollte Leben "
    "retten.",
    "sagt: ");
  AddInfo( ({ "abcdefghijklmnopqrstuvwxyz"}),
    "Oh, dass willst Du wissen. Na gut, aber sage dann nicht ich "
    "haette Dich nicht gewarnt. Das Wort bedeutet in Deiner Sprache, "
    "Sommerswerd.",
    "sagt: ");
  AddInfo( ({ "sommerswerd" }),
    "Ja genau das musst du wenn Du vor dem Portal schwebst sagen.",
    "sagt: ");
  AddInfo( ({ "herausforderung" }),
    "Du bist einfach ein tolles Motiv.",
    "sagt sehr ueberzeugend: ");
  AddInfo( ({ "kuenstler" }),
    "Sind wir das auf gewisse Weise nicht alle?",
    "fragt Dich: ");
  AddInfo( ({ "weise" }),
    "Findest Du nicht?",
    "fragt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Dapdi will Deine Sachen nicht tragen, weil sie ihm zu schwer sind.\n" }) );

  SetChats(15,({
           "Dapdi schnieft.\n",
           "Dapdi schwaermt in Erinnerungen.\n",
           "Dapdi sagt: Koennte ich doch nur hier raus.\n",
	   "Dapdi malt ein kleines Bild von Dir.\n",
	   "Dapdi schluchzt: Nie werde ich meine Familie wieder sehen.\n",
           "Dapdi fliegt eine Runde um Dich herum.\n",
           "Dapdi sagt: Ich weiss, ich weiss, was Du nicht weisst.\n"}));


}  
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "faucht Dich boese an.", "faucht " +
        TP->Name(WEN) + " boese an.");
        this_player()->AddHp(-45);
      break; 

    case "aergerlich":
      call_out("react", 0, "sieht Dich finster an.",
        "sieht " + TP->Name(WEM) +
        " finster an.");
    break;

    case "frech":
      call_out("react", 0, "knurrt boese.",
        "knurrt boese.");
    break;

    case "nett":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    case "froh":
      call_out("react", 0, "knuddelt Dich.",
        "knuddelt "+TP->Name(WEN)+".");
    break;

    default:
      call_out("react", 0, "grinst Dich an.",
        "grinst "+TP->Name(WEN)+" an.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);

}


