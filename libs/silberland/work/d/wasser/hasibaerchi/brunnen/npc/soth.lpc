// Lord Soth
inherit "std/mnpc";
inherit "std/npc/spells";


#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

void create() {
	
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Lord Soth");
  SetProp(P_LONG, BS(
    "Dieser gewaltige Ritter der schwarzen Rose ist der Anfuehrer der "
    "Ritterschaft. Seine rotgluehenden Augen trachten Dir "
    "nach Deinem Leben. Seine schwarze Plattenruestung strahlt "
    "nur so von daemonischer Macht."));
  SetProp(P_NAME, "Lord Soth");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:40]));
  AddId(({"soth", "lord soth"}));
   
   create_default_npc(48);
  SetProp(P_HANDS, ({" mit seinen Haenden an",500,DT_BLUDGEON}));
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 210);
  SetProp(P_BODY, 175);
  SetProp(P_WEIGHT, 135000);
  SetProp(P_ALIGN, -999);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_MAX_HANDS, 2);
  
  SetProp(P_HEAL, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
 
    SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.7,  DT_COLD:     -1,  DT_WATER: -0.7,  DT_AIR:   -0.7, 
      DT_LIGHTNING: -0.5,  DT_EXPLOSION: -0.7,  DT_SOUND:  -0.7,  DT_LIGHT: 0.4,
      DT_ELECTRIC:  -0.8,  DT_ACID:      -0.7,  DT_POISON: -1,  DT_TERROR: -1,
      DT_HOLY:      0.5,  DT_UNHOLY:    -1.0,  DT_MAGIC:  -0.8,  DT_MIND:   -1,
      DT_SLASH:     -0.6,  DT_BLUDGEON:   0.1,  DT_PIERCE:  -0.6, DT_SQUEEZE:  -0.6, 
      DT_WHIP:      -0.7,  DT_RIP:        -0.4]));
  SetProp(P_NOMAGIC,70);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "tritt aus einem Tor");
  SetProp(P_MMSGOUT, "salutiert und verschwindet");
  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Niemand widersetzt sich Mir.");
  SetProp(P_MURDER_MSG, "Ich werde zurueckkehren und mich an %s raechen.");
  
  AddInfo(DEFAULT_INFO, "wuerdigt Dich keines Blickes.\n");
  
     
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Lord Soth reagiert nicht auf Deinen Bestechungsversuch.\n" }) );

    
  SetAttackChats(10, ({
    "Lord Soth schlitzt Dir den Bauch auf.\n",
    "Lord Soth macht eine Finte.\n",
    "Lord Soth schneidet Dir Deinen Bauch auf.\n",
    "Lord Soth konzentriert sich auf Deinen Oberkoerper.\n"
    "Lord Soth konzentriert sich auf Deine Beine.\n"}));

// ----- Spells Anfang -----

  SetProp(P_SPELLRATE, 85);

  AddSpell(5, 1350, "Lord Soth schleudert Dir einen Strahl dunkler Energie entgegen.\n",
		   "Lord Soth schleudert @WEM einen dunklen Strahl entgegen.\n",
           ({DT_COLD,DT_UNHOLY}),([SP_SHOW_DAMAGE:1]) );

  AddSpell(4, 1250, "Lord Soth schleudert Dir ein magisches Geschoss entgegen.\n",
		   "Lord Soth schleudert @WEM ein magisches Geschoss entgegen.\n",
           ({DT_MAGIC,DT_UNHOLY}),([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 1850, "Lord Soth grillt Dein Hirn mit mentalen Kraeften.\n",
		   "Lord Soth konzentriert sich auf @WEN.\n",
           ({DT_UNHOLY, DT_MIND}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 750, DS_FEAR, "Lord Soth reckt Dir die linke Hand entegen und Du bekommst Angst.\n",
                                   "Lord Soth reckt @WEM die linke Hand entgegen.\n" );

  AddDefaultSpell(3, 1350, DS_MASS_DAMAGE, "Lord Soth schleudert Dir einen Feuerball entgegen.\n",
		   "Lord Soth schleudert @WEM einen Feuerball entgegen.\n",
           ({DT_FIRE,DT_UNHOLY}),([SP_SHOW_DAMAGE:1]) );

// ----- Spells Ende -----
  
  SUID;
  CLONEME(WEAPON "schwert2" );
  command("zuecke schwert");
  CLONEME(ARMOUR "panzer3" );
  command("trage alles");  
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "belegt Dich mit einem Fluch.",
	 "belegt "+TP->Name(WEN)+" mit einem Fluch.");
      break; 

    case "aergerlich":
      call_out("react", 0, "spuckt Dich an.",
        "spuckt "+TP->Name(WEM)+" an.");
    break;

    case "frech":
      call_out("react", 0, "zeigt Dir einen Vogel",
        "zeigt "+TP->Name(WEM)+" einen Vogel.");
    break;

    case "nett":
      call_out("react", 0, "spuckt Dich an.",
        " spuckt "+TP->Name(WEM)+" an.");
    break;

    case "froh":
      call_out("react", 0, "ist erleichtert.",
        "ist erleichtert.");
    break;

  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

public varargs void die(int pd) {
  object killer;

  killer = QueryProp(P_KILLER) || TP;

  if(objectp(killer)) {
    if(killer->id("\nranger_pet")) {
      killer = killer->QueryOwner();
    }

    if(killer->QueryProp(P_GUILD) == "waldlaeufeer" && !RANGER_CHECK_TASK(killer, 17)) {
      killer->Message("Raziel teilt Dir mit: Sehr gut! Lass uns sehen was wir ueber unsere Feinde gelernt haben.", MSGFLAG_TELL);
      RANGER_SET_TASK(killer, 17);
    }
  }
  ::die(pd);
}

