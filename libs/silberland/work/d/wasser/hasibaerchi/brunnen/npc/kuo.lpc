
inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kuo-Toa");
  SetProp(P_LONG,
    "Der schuppige Kuo-Toa trachtet Dir nach Deinem Leben. Er ist etwas kleiner "
    "als ein Mensch und hat eine schuppige Haut. Durch seine runde Koerperform "
    "gleicht er sehr stark einer Kroete auf zwei Beinen. Mit seinen Fischaugen "
    "verfolgt er jede Deiner Bewegungen.");
  SetProp(P_NAME, "Kuo-Toa");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:35]));
  AddId(({"kuo-toa", "kuo", "toa"}));

  create_default_npc(17+random(5));
  SetProp(P_HANDS, ({" mit seinen schuppigen Haenden",185,DT_BLUDGEON}));
  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 140+random(20));
  SetProp(P_WEIGHT, 42000+random(100));
  SetProp(P_ALIGN, -35);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0,  DT_COLD:      0.5,  DT_WATER:  -1.0, DT_AIR:    -0.3, 
      DT_LIGHTNING: -1.0,  DT_EXPLOSION: -1.0, DT_SOUND:  0.0,  DT_LIGHT:  0.3,
      DT_ELECTRIC:  -1.0,  DT_ACID:      -1.0,  DT_POISON: -1.0,  DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC: 0.0,   DT_MIND:   0.0]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,18);

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein.");
  SetProp(P_MMSGOUT, "schwimmt weg");

  SetProp(P_DIE_MSG,  " schwebt auf den Grund.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_KILL_MSG, "Du hast mich gestoert, jetzt bezahlst Du dafuer!!");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kuo-Toa kann Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE, 40);

  AddDefaultSpell(2, 3, DS_POISON, "Du spuerst wie Gift in Dich dringt.\n",
                  "@WER wird blasser.\n");
  AddSpell(4, 500, "Du spuerst wie Wasser Deine Lungen fuellt.\n",
                  "@WER hustet schwarzes Wasser.\n",({DT_WATER}),([SP_SHOW_DAMAGE:1]) );
  AddSpell(3, 750, "Der Kuo-Toa schleudert Dir einen Blitz entgegen.\n",
                  "Der Kuo-Toa schleudert @WEM einen Blitz entgegen\n",({DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]) );

}
