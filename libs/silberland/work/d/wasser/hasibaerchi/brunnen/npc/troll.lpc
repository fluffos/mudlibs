inherit "/p/std/npc/berserker_npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include "../def.h"




void create()
{
  if (!is_clone(this_object())) return;
  ::create();       
  SetProp(P_SHORT, "Ein Kampftroll");
  SetProp(P_LONG, 
  "Du siehst einen riesigen Troll vor Dir. Er ist mehr als doppelt so gross\n"+
  "wie Du. Er sieht nicht gerade freundlich aus, besser Du verschwindest hier.\n");
  SetProp(P_NAME, "Kampftroll");
  SetProp(P_GENDER, MALE);
  AddId(({"troll","kampftroll", "Axtkaempfer"}));
  create_default_berserker(36, 7);
  SetProp(P_ATTRIBUTES,(["int":17,"str":50,"con":47,"dex":42]));
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS,({" mit seinen grossen Klauen",420, DT_BLUDGEON}));
  SetProp(P_RACE, "Troll");
  SetProp(P_FOOD, 0); 
  SetProp(P_SIZE, 320+random(100) );
  SetProp(P_BODY, 75);
  SetProp(P_KILL_NAME, "Ein schraecklicher Kampftroll");
  SetProp(P_KILL_MSG, "hat seine Axt geschwungen.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0]) );
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.3,  DT_COLD:     -0.1,  DT_WATER: -0.1,  DT_AIR:   -0.1, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.1,  DT_SOUND:  -0.3,  DT_LIGHT: -0.7,
      DT_ELECTRIC:  0.0,  DT_ACID:      -0.1,  DT_POISON: -0.4,  DT_TERROR: -0.7,
      DT_HOLY:      0.0,  DT_UNHOLY:    -0.2,  DT_MAGIC:  -0.2,  DT_MIND:   0.0,
      DT_SLASH:     -0.2,  DT_BLUDGEON:   0.0,  DT_PIERCE:  0.0, DT_SQUEEZE:  -0.2, 
      DT_WHIP:      -0.2,  DT_RIP:        -0.2]));
  SetProp(P_NOMAGIC,15);

 
  seteuid(getuid(this_object()));
  
  clone_object("/p/armour/gloves/kettenhandschuhe")->move(this_object());
  clone_object("/p/armour/boots/kampfstiefel")->move(this_object());
  clone_object("/p/armour/helm/titanhelm")->move(this_object());
  clone_object("/p/armour/trousers/kettenhose")->move(this_object());

  command("trage alles");

  if( random(4) )
    clone_object("/p/weapon/axe/stabaxt")->move(this_object());
  else
     CLONEME(WEAPON "sturmaxt" );
  command ("zuecke axt");


 
  SetChats(8, ({
          
        "Der Kampftroll schnauft.\n",
	"Der Kampftroll schaerft seine Klinge.\n",
	"Der Kampftroll betrachtet Dich eingehend.\n",
	"Der Kampftroll brummt etwas Unverstaendliches.\n",
	"Der Kampftroll studiert jede Deiner Bewegungen.\n",
        "Der Kampftroll zeigt mit dem Finger auf Dich und bekommt Hunger.\n"}));
  
  SetAttackChats(10, ({
    "Der Kampftroll schlitzt Dir den Bauch auf.\n",
    "Der Kampftroll macht einen Moerderschlag.\n",
    "Der Kampftroll konzentriert sich auf Deinen Oberkoerper.\n"
    "Der Kampftroll konzentriert sich auf Deine Beine.\n"}));

  SetProp(P_SPELLRATE, 20);
  AddSpell(4,740,
    " Der Kampftroll atomisiert Dich im Kampfrausch.\n",
    " Der Kampftroll atomisiert @WEN.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(1, 200, DS_PARALYZE,
    " Der Kampftroll zertruemmert Deinen Kopf. Du kannst Dich nicht bewegen.\n",
    " Der Kampftroll zertruemmert @WESSEN Kopf. @WER kann sich nicht bewegen.\n",
    2);


}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "belegt Dich mit einem Fluch.",
	 "belegt "+TP->Name(WEN)+" mit einem Fluch.");
      break; 

    case "aergerlich":
      call_out("react", 0, "spuckt Dich an.",
        "spuckt "+TP->Name(WEM)+" an.");
    break;

    case "frech":
      call_out("react", 0, "zeigt Dir einen Vogel",
        "zeigt "+TP->Name(WEM)+" einen Vogel.");
    break;

    case "nett":
      call_out("react", 0, "spuckt Dich an.",
        " spuckt "+TP->Name(WEM)+" an.");
    break;

    case "froh":
      call_out("react", 0, "ist erleichtert.",
        "ist erleichtert.");
    break;

  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


