
inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Assel");
  SetProp(P_LONG,
    "Diese kleine Assel hast Du leider aus ihrem Schlaf gerissen. "
    "Irgendwie scheint sie Dir dies sehr uebel zu nehmen. Mit ihren "
    "Fuehlern scheint sie immer genau zu wissen, wo Du Dich befindest.");
  SetProp(P_NAME, "Assel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"assel"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit ihren Fuehlern",90,DT_POISON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 2+random(3));
  SetProp(P_WEIGHT, 30+random(10));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.5,  DT_COLD:      0.5,  DT_WATER:  -0.5, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0,  DT_LIGHT:  0.1,
      DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC: 0.0,   DT_MIND:   -1.0]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,2);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt herein.");
  SetProp(P_MMSGOUT, "krabbelt weg");

  SetProp(P_DIE_MSG,  " faellt in die Tiefe.\n");
  SetProp(P_NOCORPSE, 1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Assel kann Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE, 25);

  AddDefaultSpell(1, 2, DS_POISON, "Du spuerst wie Gift in Dich dringt.\n",
                  "@WER wird blasser.\n");

}
