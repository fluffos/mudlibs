
inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Qualle");
  SetProp(P_LONG,
    "Die Qualle trachtet Dir nach Deinem Leben. Sie hat lange Fangarme "
    "mit denen sie Dich leicht zerquetschen kann. Wie ein Engel des "
    "Todes gleitet sie durch das Wasser. Bald wirst auch Du eines ihrer "
    "Opfer sein.");
  SetProp(P_NAME, "Qualle");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:35]));
  AddId(({"qualle"}));

  create_default_npc(15+random(5));
  SetProp(P_HANDS, ({" mit ihren Tentakeln an",168,DT_WHIP}));
  SetProp(P_RACE, "Gelee");
  SetProp(P_SIZE, 220+random(30));
  SetProp(P_WEIGHT, 16000+random(15));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2+random(10));
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0,  DT_COLD:      0.5,  DT_WATER:  -1.0, DT_AIR:    -0.3, 
      DT_LIGHTNING: -1.0,  DT_EXPLOSION: -1.0, DT_SOUND:  -0.4,  DT_LIGHT:  0.3,
      DT_ELECTRIC:  -1.0,  DT_ACID:      -1.0,  DT_POISON: -1.0,  DT_TERROR: 0.0,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC: 0.0,   DT_MIND:   -1.0]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,10);
  SetProp(P_SPELLRATE, 40);
  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein.");
  SetProp(P_MMSGOUT, "schwimmt weg");

  SetProp(P_DIE_MSG,  " schwebt auf den Grund.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_KILL_MSG, "Blubb Blubb Blubb!!");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Qualle kann Deine Sachen nicht tragen.\n" }) );

  

  AddDefaultSpell(1, 5, DS_POISON, "Du spuerst wie Gift in Dich dringt.\n",
                  "@WER wird blasser.\n");
  AddSpell(4, 490, "Die Qualle streift Deinen Koerper.\n",
                  "Die Qualle streift den Koerper von @WEM.\n"
		  ,({DT_ACID}),([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(2, 1, DS_PARALYZE,
      "Die Quaelle zerquetscht Dich mit ihren Tentakeln und Du kannst Dich "
      "nicht mehr bewegen!\n",
      "@WER beginnt rot anzulaufen!\n", 2);


  
}


