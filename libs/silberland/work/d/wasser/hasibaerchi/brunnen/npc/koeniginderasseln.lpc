
inherit "std/npc";
inherit "std/npc/spells";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Koenigin der Asseln");
  SetProp(P_LONG,
    "Die Koenigen der Asseln trachtet Dir nach Deinem Leben. Lauf solange Du "
    "noch kannst! Wieso auch nur hast Du ihren Bau betreten. Geh bevor Du zu "
    "einer Mahlzeit verarbeitet wirst.");
  SetProp(P_NAME, "Koenigin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"koenigin"}));

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit ihren Fuehlern",255,DT_POISON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 45+random(7));
  SetProp(P_WEIGHT, 10000+random(12));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.3,  DT_COLD:      0.3,  DT_WATER:  -0.7, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0,  DT_EXPLOSION: 0.0, DT_SOUND:  0.0,  DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.0,  DT_ACID:      -0.7,  DT_POISON: 0.0,  DT_TERROR:-0.3,
      DT_HOLY:      0.0,  DT_UNHOLY:    0.0,  DT_MAGIC: 0.0,   DT_MIND:   -1.0]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,2);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt herein.");
  SetProp(P_MMSGOUT, "krabbelt weg");

  SetProp(P_DIE_MSG,  " zerbroeselt zu Staub.\n");
  SetProp(P_NOCORPSE, 1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Koenigin der Asseln kann Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE, 45);

  AddDefaultSpell(1, 3, DS_POISON, "Du spuerst wie Gift in Dich dringt.\n",
                  "@WER wird blasser.\n");

}

public void die(int poisondeath) {
  object killer;
  killer = QueryProp(P_KILLER) || TP;
  if(!objectp(killer)) return;

  if(killer->QueryProp(P_GUILD) == "bardengilde" && killer->QuerySkill("klarster lebenssaft da quillt") == 0) {
    LearnBardSpell(killer,
                  "klarster lebenssaft da quillt", 
                  "Solange du diese Melodie spielst wird das Blut deiner Zuhoerer gereinigt.",
                  "spiele 'klarster lebenssaft da quillt'");
  }
  ::die(poisondeath);
  return;
}
