#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

int anz=4;

void create()
{
::create();

  SetProp( P_INT_SHORT, "In einem Brunnen" );
  SetProp( P_INT_LONG,
   "Du stehst immer noch auf einer rostigen Leiter. Woody sei Dank! "
   "Das Licht hier ist bereits sehr schwach, sodass Du kaum Deine "
   "Hand vor Augen sehen kannst. Je weiter Du nach unten kommst "
   "desto kaelter wird es, ganz so als ob dort unten der eisige "
   "Tod auf Dich lauert um Dich in seine Arme aufzunehmen. Wie wird "
   "das enden?");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist irgendwo in der Tiefe des Brunnenschachts zu finden.");
  AddDetail( ({ "leiter" }),
    "Du stehst auf der Leiter. Alleine die rostigen Sprossen trennen Dich vor "
    "einem Absturz in die Tiefe.");
  AddDetail( ({ "du", "dir", "dich", "deine", "dein" }),
    "Tja, Du bist Du! Du hast eine Nase, Augen, Ohren und noch "
    "vieles mehr.");
  AddDetail( ({ "augen", "auge", "nase", "ohren", "ohr", "knie" }),
    "Du kontrollierst Deinen Koerper, zaehlst Deine Koerperteile durch und "
    "stellst erleichtert fest, dass alles noch an seinem richtigen "
    "Platz ist.");
  AddDetail( ({ "koerper", "koerperteile", "platz", "leib" }),
    "Alles dort wo es hingehoert! Zumindest Deiner Meinung nach.");
  AddDetail( ({ "meinung" }),
    "Deine Meinung ist gefragt.");
  AddDetail( ({ "tiefe" }),
    "Du hast das Gefuehl am Abgrund in die Unendlichkeit zu stehen. Deine "
    "Knie beginnen zu zittern.");
  AddDetail( ({ "gefuehl", "gefuehle" }),
    "Tja Gefuehle. Liebe, Hass, Zorn, Freude, und viele mehr.");
  AddDetail( ({ "hass", "zorn" }),
    "Negative Gefuehle eben!");
  AddDetail( ({ "freude" }),
     "Ein sehr positives Gefuehl.");		  
  AddDetail( ({ "liebe" }),
    "Nicht mit Sex zu verwechseln.");
  AddDetail( ({ "sex", "silberland" }),
    "Du erwartest doch nicht im ernst, dass ich Dir das genauer beschreibe!");
  AddDetail( ({ "abgrund" }),
    "Ob dort unten Dein Ende auf Dich wartet?");
  AddDetail( ({ "ende" }),
    "Es wird kommen, und wenn Du nicht vorsichtig bist, kommt es schneller "
    "als Dir lieb ist. Willst Du es beschleunigen? Dann wirf eine Muenze in "  
    "den Abgrund.");
  AddDetail( ({ "muenze"}),
    "Du hast bestimmt eine Muenze bei Dir, wirf sie doch einfach in "
    "den Brunnen.");
  AddDetail( ({ "unendlichkeit" }),
    "Das Silberland, unendliche Weiten, dies sind die Abenteuer des ......");
  AddDetail( ({ "weiten", "weite" }),
    "Die Weiten des Silberlandes.");
  AddDetail( ({ "abenteuer" }),
    "Auch Quests genannt. Davon gibt es viele im Silberland.");
  AddDetail( ({ "quests", "quests"}),
    "Auch Abenteuer genannt.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus kleinen, grauen Steinbloecken.");
  AddDetail( ({ "brunnen", "brunnenschacht", "schacht"}),
    "Viele Steinbloecke fuellen den Brunnenschacht aus."); 	  
  AddDetail( ({ "steinbloecke", "steinblock", "block","bloecke", "steinbloecken"}),
    "Bei naeherer Betrachtung entdeckst Du Rillen, die mit Fugenmasse "
    "ausgefuellt sind.");
  AddDetail( ({ "betrachtung"}),
    "Zusaetzlich erkennst Du, dass die Waende feucht sind.");
  AddDetail( ({ "rillen"}),
    "Die Rillen sind mit Fugenmasse gefuellt.");
  AddDetail( ({ "fugenmasse", "masse"}),
    "Die Fugenmasse ist total schimmelig. Ekel steigt in Dir empor. Eine "
    "Fuge faellt Dir besonders auf.");
  AddDetail( ({ "ekel", "fortsaetze", "fuesse"}),
    "Einfach nur waeh!");
  AddDetail( ({ "fuge", "fugen"}),
    "Hier fehlt etwas Fugenmasse. Du koenntest versuchen den angrenzenden "
    "Stein zu lockern.");
  AddDetail( ({ "stein"}),
    "Versuch den Stein zu lockern, wenn Du Dich traust!");
  AddDetail( ({ "angst" }),
    "Die Angst steigt Dir Deine Knochen empor. Du zitterts am ganzen Leib.");
  AddDetail( ({ "knochen"}),
    "Davon hast Du genau 183 in Deinem Koerper. Pass auf das Du Dir "
    "keine brichst!");
  AddDetail( ({ "himmel", "decke"}),
    "Von dort oben dringt Licht in den Brunnen.");
  AddDetail( ({ "licht"}),
    "Noch kannst Du genug sehen, wer weiss wie es weiter unten aussehen "
    "wird. ");
  AddDetail( ({ "feuchtigkeit"}),
    "Sie liegt einfach auf allem was hier zu finden ist.");
  AddDetail( ({ "finger"}),
    "Davon hast Du zehn. Aber auch zehn Zehen hast Du.");
  AddDetail( ({ "zehen"}),
    "Die wurmartigen Fortsaetze an Deinen Fuessen.");
  AddDetail( ({ "absturz"}),
    "Sicher nicht angenehm. IIIIIIUUUUUUUUUU!!! *BUMM*");
  AddDetail( ({ "bumm"}),
    "Wenn Du so weitermachst, ist Dir der Tod sicher.");
  AddDetail( ({ "luft"}),
    "Die Luft hier drinnen ist feucht und abgestanden.");
  AddDetail( ({ "sprossen", "sprosse" }),
    "Die Sprossen sind rostig, pass ja auf, dass Du nicht durchbrichst.");
  AddDetail( ({ "rost" }),
    "Das ist jetzt ein Forscherpunkt fuer Dich!");
  AddDetail( ({ "forscherpunkt", "punkt" }),
    "Jetzt uebertreib aber nicht! Andererseits wer nicht forscht, wird "
    "enttaeuscht.");
  AddDetail( ({ "woody" }),
    "Woody ist ein Gott, um genau zu sein ein Gott in Gestalt eines Zwerges. "
    "Sehr huebsch ist er nicht, dafuer riecht er sehr gut. Warum er sich "
    "diese Gestalt ausgesucht hat weiss keiner. Wer versteht schon die "
    "Wege der Goetter?");
  AddDetail( ({ "gott", "goetter" }),
    "So wie Dusty, Cleany, Stinky, Spicy, Clumsy, Dirty und Veggy.");
  AddDetail( ({ "dusty" }),
    "Ein Gott so wie Woody eben, nur huebscher!");
  AddDetail( ({ "cleany", "stinky", "dirty", "veggy", "freshy", "spicy" }),
    "Das ist einer der vergessenen Goetter des Silberlandes.");
  AddDetail( ({ "clumsy" }),
    "Das war oder ist der Gott des Gluecks.");
  AddDetail( ({ "glueck" }),
    "Vielleicht ist Dir das Glueck auch einmal hold, solltest Du aber mehr "
    "ueber den Gott des Gluecks wissen wollen solltest Du seinen schuppigen "
    "Begleiter fragen.");
  AddDetail( ({ "begleiter" }),
    "Der ist leider nicht hier, aber vielleicht findest Du ihn irgendwann "
    "einmal.");
  AddDetail( ({ "gestalt" }),
    "Ich liebe Dich! Mich reizt Deine schoene Gestalt, und bist Du nicht "
    "willig, so brauch ich Gewalt!");
  AddDetail( ({ "gewalt" }),
    "Davon gibt es leider sehr viel im Silberland.");
  AddDetail( ({ "zwerg", "zwerge" }),
    "Eine der vielen Rassen im Silberland.");
  AddDetail( ({ "rasse", "rassen" }),
    "Du zaehlst geistig alle Rassen des Silberlandes durch, und stellst "
    "beruhigt fest, dass Du keine vergessen hast.");
  AddDetail( ({ "weg", "wege" }),
    "Vor Dir liegt noch ein langer Weg. Ob Du diesen Weg ueberleben wirst, "
    "steht in den Sternen.");
  AddDetail( ({ "stern", "sterne" }),
    "Sterne kannst Du von hier keine mehr sehen.");
  AddDetail( ({ "dank"}),
    "Kein Forscherpunkt fuer Dich, aber vielleicht spaeter.");
  AddDetail( ({ "hand", "haende", "arm", "arme" }),
    "Hand und Arm bilden genauso eine Einheit, wie Haende und Arme.");
  AddDetail( ({ "einheit"}),
    "Freunde bilden oft eine Einheit. Hoffentlich hast Du viele Freunde.");
  AddDetail( ({ "freund", "freunde"}),
    "Hole Dir ein paar Freunde, bevor es zu spaet dafuer ist!");
  AddDetail( ({ "tod" }),
    "Willst Du den Tod wirklich untersuchen? Dann mach nur weiter so, und "
    "schon bald wirst Du bei ihm sein!");
  AddDetail( ({ "nische" }),
    "Du koenntest in die Nische schluepfen, wenn Du Dich traust.");

    
 
  AddSmell( DEFAULT_SMELL,
    "Der Geruch von Tod und Verwesung liegt in der Luft." );
  AddSmell( ({ "geruch"}),
    "Es riecht feucht und mufflig.");
  AddSmell( ({ "tod"}),
    "Er ist naeher als Du denkst.");
  AddSmell( ({ "verwesung"}),
    "Es riecht ecklig, der Tod scheint hier alles zu beherrschen.");
  AddSmell( ({ "luft"}),
    "Wie gesagt, Tod und Verwesung. Obwohl da noch Etwas ist.");
  AddSmell( ({ "etwas"}),
    "Es riecht nach frischem Wasser. Woher das kommt?");
  AddSmell( ({ "woody", "gott" }),
    "So kann wirklich nur ein Gott riechen. So animalisch, so erotisch, "
    "einfach zwergisch. Frisch, saftig und woodysch.");
  AddSmell( ({ "wasser"}),
    "Es kommt aus der Nische.");
  AddSmell( ({ "nische"}),
    "Nicht riechen, untersuchen!");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Pfeifen." );
  AddSound( ({ "pfeifen"}),
    "Es hoert sich an wie der Atem des Todes.");
  AddSound( ({ "atem"}),
    "Du lauscht dem Tod.");
  AddSound( ({ "tod", "todes"}),
    "Der Tod ist immer noch leise."); 

    

AddCmd( ({"kletter", "klettere" }), "cmd_ausgang" );
AddCmd( ({"wirf", "werfe"}), "cmd_wurf" );
AddCmd( ({"locker", "lockere"}), "cmd_stein" );
AddCmd( ({"schluepfe", "schluepfen", "schluepf"}), "cmd_nische" );

}
int cmd_ausgang(string str){
 notify_fail("Wohin willst Du klettern?\n");

 if(!str || str == "") return 0;
 if(!(str == "runter" ||
      str == "unten" ||
      str == "auf" ||
      str == "rauf" ||
      str == "nach oben" ||
      str == "nach unten" )) return 0;
 
 if( str == "runter" || str == "nach unten" || str == "unten"){
 TP->move(ROOM "brunnen_3", M_GO, "nach unten", "klettert");
	       

 return 1;
} 

 if( str == "rauf" || str == "auf" || str == "nach oben"){
 TP->move(ROOM "brunnen_1", M_GO, "nach oben", "klettert");
	       

 return 1;
}
}
	 
int cmd_wurf(string str){
    notify_fail("Was willst Du wohin werfen?\n");

 if(!str || str == "") return 0;
 if(!(str == "muenze in schacht" ||
      str == "muenze nach unten" ||
      str == "muenze runter" ||
      str == "muenze in brunnen" ||
      str == "muenze in abgrund" ||
      str == "muenze hinunter" )) return 0;

 if(TP->QueryMoney()<1)
	 return write (BS("Du hast ja gar keine Muenze!")), 1;

 write(BS("Du wirfst eine Muenze in den Schacht hinunter. Nach einiger Zeit\n"
	  "hoerst du ein leises Ping. Ein Stueck ist es noch bis unten.\n"));
 
 say(BS(TPN+" wirft eine Muenze in den Schacht, wartet einen Moment und\n"
	    "verzieht das Gesicht.\n"));

 TP->AddMoney(-1);
 "p/daemon/zentralbank"->PayIn(1, 100);

 return 1;
}

int cmd_nische(string str){
    notify_fail("Wohin willst Du schluepfen?\n");

  if(!str || str == "") return 0;
  if(!(str == "in nische" ||
       str == "durch nische" )) return 0;

  TP->move(ROOM "brunnen_4", M_GO, "hinein", "schluepft");
	

  return 1;

}  			  
int cmd_stein(string str){
    object assel;
    notify_fail("Was willst du lockern?\n");

    if(!str || str == "") return 0;
    if(!(str == "stein")) return 0;

    write (BS("Du lockerst den Stein.\n"));
    say(BS(TPN+" macht sich an der Mauer zu schaffen.\n"));

    if(anz>0){

	    assel = clone_object(NPC "assel");
	    assel->move(ENV(TP), M_NOCHECK);
	    anz--;
    }
 return 1;
}

void reset(){
	::reset();
	anz=4;
}
