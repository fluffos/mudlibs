#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

int anz=3;

void create()
{
::create();

  SetProp( P_INT_SHORT, "In einem Brunnen" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer rostigen Leiter. Von oben dringt Licht in "
    "die Tiefe des Brunnenschachts hinunter. Ganz verkrampft halten "
    "Deine Finger die Sprossen der Leiter fest. Die Feuchtigkeit "
    "liegt hier nicht nur in der Luft, sondern sie legt sich auch auf " 
    "alles was hier im Brunnen ist. Die Leiter ist hier, die Waende " 
    "sind hier, Du bist hier und einiges, das Du nicht siehst ist hier, " 
    "und genau das bereitet Dir Angst.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist irgendwo in der Tiefe des Brunnenschachts zu finden.");
  AddDetail( ({ "leiter" }),
    "Du stehst auf der Leiter. Alleine die rostigen Sprossen trennen "
    "Dich vor einem Absturz in die Tiefe. Du kannst sie rauf und runter "
    "klettern.");
  AddDetail( ({ "du", "dir", "dich", "dein", "deine" }),
    "Tja, Du bist Du! Du hast eine Nase, Augen, Ohren und noch vieles mehr.");
  AddDetail( ({ "augen", "auge", "nase", "ohren", "ohr", "knie" }),
    "Du kontrollierst Deinen Koerper, zaehlst Deine Koerperteile durch und "
    "stellst erleichtert fest, dass alles noch an seinem richtigen Platz ist.");
  AddDetail( ({ "koerper", "koerperteile", "platz", "leib" }),
    "Alles dort wo es hingehoert! Zumindest Deiner Meinung nach.");
  AddDetail( ({ "meinung" }),
    "Deine Meinung ist gefragt.");
  AddDetail( ({ "tiefe" }),
    "Du hast das Gefuehl am Abgrund in die Unendlichkeit zu stehen. Deine Knie "
    "beginnen zu zittern.");
  AddDetail( ({ "gefuehl", "gefuehle" }),
    "Tja Gefuehle. Liebe, Hass, Zorn, Freude, und viele mehr.");
  AddDetail( ({ "hass", "zorn" }),
    "Negative Gefuehle eben!");
  AddDetail( ({ "freude" }),
     "Ein sehr positives Gefuehl.");		  
  AddDetail( ({ "liebe" }),
    "Nicht mit Sex zu verwechseln.");
  AddDetail( ({ "sex", "silberland" }),
    "Du erwartest doch nicht im ernst, dass ich Dir das genauer beschreibe!");
  AddDetail( ({ "abgrund" }),
    "Ob dort unten Dein Ende auf Dich wartet?");
  AddDetail( ({ "ende" }),
    "Es wird kommen, und wenn Du nicht vorsichtig bist, kommt es schneller als "
    "Dir lieb ist. Willst Du es beschleunigen? Dann wirf eine Muenze in "  
    "den Abgrund.");
  AddDetail( ({ "muenze"}),
    "Du hast bestimmt eine Muenze bei Dir, wirf sie doch einfach in "
    "den Brunnen.");
  AddDetail( ({ "unendlichkeit" }),
    "Das Silberland, unendliche Weiten, dies sind die Abenteuer des ......");
  AddDetail( ({ "weiten", "weite" }),
    "Die Weiten des Silberlandes.");
  AddDetail( ({ "abenteuer" }),
    "Auch Quests genannt. Davon gibt es viele im Silberland.");
  AddDetail( ({ "quests", "quests"}),
    "Auch Abenteuer genannt.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus kleinen, grauen Steinbloecken.");
  AddDetail( ({ "brunnen", "brunnenschacht", "schacht"}),
    "Viele Steinbloecke fuellen den Brunnenschacht aus."); 	  
  AddDetail( ({ "steinbloecke", "steinblock", "block","bloecke", "steinbloecken"}),
    "Bei naeherer Betrachtung entdeckst Du Rillen, die mit Fugenmasse "
    "ausgefuellt sind.");
  AddDetail( ({ "betrachtung"}),
    "Zusaetzlich erkennst Du, dass die Waende feucht sind.");
  AddDetail( ({ "rillen"}),
    "Die Rillen sind mit Fugenmasse gefuellt.");
  AddDetail( ({ "fugenmasse", "masse"}),
    "Die Fugenmasse ist total schimmelig. Ekel steigt in Dir empor. Eine Fuge "
    "faellt Dir besonders auf.");
  AddDetail( ({ "ekel", "fortsaetze", "fuesse"}),
    "Einfach nur waeh!");
  AddDetail( ({ "fuge", "fugen"}),
    "Hier fehlt etwas Fugenmasse. Du koenntest versuchen den angrenzenden "
    "Stein zu lockern.");
  AddDetail( ({ "stein"}),
    "Versuch den Stein zu lockern, wenn Du Dich traust!");
  AddDetail( ({ "angst" }),
    "Die Angst steigt Dir Deine Knochen empor. Du zitterst am ganzen Leib.");
  AddDetail( ({ "knochen"}),
    "Davon hast Du genau 183 in Deinem Koerper. Pass auf das Du Dir keine "
    "brichst!");
  AddDetail( ({ "himmel", "decke"}),
    "Von dort oben dringt Licht in den Brunnen. Und ein Seil haengt herab.");
  AddDetail( ({ "seil"}),
    "Es baumelt ober Dir hin und her.");
  AddDetail( ({ "licht"}),
    "Noch kannst Du genug sehen, wer weiss wie es weiter unten aussehen wird. ");
  AddDetail( ({ "feuchtigkeit"}),
    "Sie liegt einfach auf allem was hier zu finden ist.");
  AddDetail( ({ "finger"}),
    "Davon hast Du zehn. Aber auch zehn Zehen hast Du.");
  AddDetail( ({ "zehen"}),
    "Die wurmartigen Fortsaetze an Deinen Fuessen.");
  AddDetail( ({ "absturz"}),
    "Sicher nicht angenehm. IIIIIIUUUUUUUUUU!!! *BUMM*");
  AddDetail( ({ "bumm"}),
    "Wenn Du so weitermachst, ist Dir der Tod sicher.");
  AddDetail( ({ "luft"}),
    "Die Luft hier drinnen ist feucht und abgestanden.");
  AddDetail( ({ "sprossen", "sprosse" }),
    "Die Sprossen sind rostig, pass ja auf, dass Du nicht durchbrichst.");
  AddDetail( ({ "rost" }),
    "Das ist jetzt ein Forscherpunkt fuer Dich!");
  AddDetail( ({ "forscherpunkt", "punkt" }),
    "Jetzt uebertreib aber nicht!");
  AddDetail( ({ "tod" }),
    "Er wartet bereits auf Dich!");
 
  AddSmell( DEFAULT_SMELL,
    "Der Geruch von Tod und Verwesung liegt in der Luft." );
  AddSmell( ({ "geruch"}),
    "Es riecht feucht und mufflig.");
  AddSmell( ({ "tod"}),
    "Er ist naeher als Du denkst.");
  AddSmell( ({ "verwesung"}),
    "Es riecht eklig, der Tod scheint hier alles zu beherrschen.");
  AddSmell( ({ "luft"}),
    "Wie gesagt, Tod und Verwesung.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Pfeifen." );
  AddSound( ({ "pfeifen"}),
    "Es hoert sich an wie der Atem des Todes.");
  AddSound( ({ "atem"}),
    "Du lauschst dem Tod.");
  AddSound( ({ "tod", "todes"}),
    "Der Tod ist immer leise!"); 

   

AddCmd( ({"kletter", "klettere" }), "cmd_ausgang" );
AddCmd( ({"wirf", "werfe"}), "cmd_wurf" );
AddCmd( ({"locker", "lockere"}), "cmd_stein" );

}
int cmd_ausgang(string str){
 notify_fail("Wohin willst Du klettern?\n");

 if(!str || str == "") return 0;
 if(!(str == "runter" ||
      str == "unten" ||
      str == "auf" ||
      str == "rauf" ||
      str == "nach oben" ||
      str == "nach unten" )) return 0;
 
 if( str == "runter" || str == "nach unten" || str == "unten"){
 TP->move(ROOM "brunnen_2", M_GO, "nach unten", "klettert");
	       

 return 1;
} 

 if( str == "rauf" || str == "auf" || str == "nach oben"){
 write(BS( "Gerade, als Du dabei bist die Leiter hinaufzuklettern, spuerst Du "
	  "ploetzlich eine Hand, die sich mit starkem Griff um Deinen Knoechel "
	  "schliesst."));
     TP->SetProp(P_PARALYZED, 30);
     if ( find_call_out("fall1") == -1)
       call_out("fall1",10);
     return 1;
  
}
}
void fall1()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write(BS("\"So einfach wie Du hier herein gekommen bist, kommst Du hier "
	 "nicht mehr heraus!\", hoerst Du eine kraeftige Stimme sagen."));
   if ( find_call_out("fall2") == -1)
     call_out("fall2",7);
}
void fall2()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Und dann spuerst Du schon einen harten Schlag in Deinem Genick, "
	  "der Dich fast in Ohnmacht fallen laesst. Noch halb bei Bewusstsein "
	  "merkst Du, wie Du irgendwo hin getragen und dann unsanft "
	  "auf den Boden geknallt wirst."));
   if ( find_call_out("fall3") == -1)
     call_out("fall3",12);
}
void fall3()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("In der Ferne hoerst Du noch das finstere Lachen der Gestalt die "
	  "Dich getragen hat. Ein Ritter, mit dem Wappen der Schwarzen Rose."));
     
 TP->SetProp(P_PARALYZED, 0);		   
 TP->move(ROOM "brunnen_13", M_GO, "nach oben", "klettert");
 
}
int cmd_wurf(string str){
    notify_fail("Was willst Du wohin werfen?\n");

 if(!str || str == "") return 0;
 if(!(str == "muenze in schacht" ||
      str == "muenze nach unten" ||
      str == "muenze runter" ||
      str == "muenze in brunnen" ||
      str == "muenze in abgrund" ||
      str == "muenze hinunter" )) return 0;

 if(TP->QueryMoney()<1)
	 return write (BS("Du hast ja gar keine Muenze!")), 1;

 write(BS("Du wirfst eine Muenze in den Schacht hinunter. Nach langer Zeit\n"
	  "hoerst du ein leises Ping. Mann, gehts da tief hinunter.\n"));
 
 say(BS(TPN+" wirft eine Muenze in den Schacht, wartet einen Moment und\n"
	    "verzieht das Gesicht.\n"));

 TP->AddMoney(-1);
 "p/daemon/zentralbank"->PayIn(1, 100);

 return 1;
}

int cmd_stein(string str){
    object assel;
    notify_fail("Was willst du lockern?\n");

    if(!str || str == "") return 0;
    if(!(str == "stein")) return 0;

    write (BS("Du lockerst den Stein.\n"));
    say(BS(TPN+" macht sich an der Mauer zu schaffen.\n"));

    if(anz>0){
    
    assel = clone_object(NPC "assel");

    assel->move(ENV(TP), M_NOCHECK);
    anz--;

    }
    

 return 1;
}


void reset(){
	::reset();
	anz=3;
}

