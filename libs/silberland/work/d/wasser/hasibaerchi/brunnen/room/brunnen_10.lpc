//erstellt von hasibaerchi 



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "Am Ende" );
  SetProp( P_INT_LONG,
  "Du schwebst im Nichts.");
  

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -25, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Netter Versuch, aber wo Nichts ist, kannst Du auch Nichts untersuchen.");
  AddDetail( ({ "wand", "waende" }),
    "Auch Waende findest Du hier nicht, hier gibt es nur Nichts.");
  AddDetail( ({ "decke" }),
    "Wo Nichts ist, kannst Du auch Nichts untersuchen.");
  AddDetail( ({ "nichts" }),
    "Du untersuchst Nichts, und entdeckst auch Nichts, so weit Dein Auge "
    "reicht nur Nichts, welch eine Ueberraschung.");
  AddDetail( ({ "ueberraschung" }),
    "Hast Du etwas anderes erhofft?");
  AddDetail( ({ "versuch" }),
    "Ein sinnloser Versuch, aber er hilft Dir auch nicht weiter.");
  AddDetail( ({ "auge" }),
    "Nur Nichts, und das ueberall.");
  AddDetail( ({ "idee" }),
    "Vielleicht koennen Dir Deine Sinne weiterhelfen Deine Umgebung "
    "zu erkunden.");
  AddDetail( ({ "sinne" }),
    "Du kannst sehen, riechen, lauschen, schmecken und tasten.");
  AddDetail( ({ "umgebung" }),
    "Nichts, ueberall nur Nichts.");
  AddDetail( ({ "ton" }),
    "Lauschen waere nicht schlecht, ausser Du willst hier weiter im "
    "Nichts schweben.");
  AddDetail( ({ "etwas" }),
    "Ah ein Stein. Was macht denn ein Stein hier im Nichts?");
  AddDetail( ({ "stein" }),
    "Einen Stein kann man werfen.");
  AddDetail( ({ "wollfaden", "faden" }),
    "Wenn hier in diesem Nichts ein Ding versteckt waere, dann koenntest Du an dem "
    "einen Faden anbinden. Dann kaemst Du vielleicht hier raus.");
  AddDetail( ({ "ding" }),
    "Wo kann das bloss sein?");
  AddDetail( ({ "kopf" }),
    "Dein Kopf ist dort wo er immer ist.");
  AddDetail( ({ "plan" }),
    "Du hast einen genialen Plan entwickelt. Jetzt musst Du nur "
    "noch den Faden um Deine Huefte wickeln und dann kann es los "
    "gehen.");
  AddDetail( ({ "huefte" }),
    "Um die solltest Du einen Faden wickeln, wenn Du es noch nicht "
    "getan hast.");
  AddDetail( ({ "bola" }),
    "Jetzt schiesse die Bola mit all deiner Kraft!");
  AddDetail( ({ "weisheit" }),
    "Suchst Du etwa Weisheit?");
  AddDetail( ({ "gerechtigkeit", "leid" }),
    "Das wirst Du hier nicht finden.");
  
    
  AddSmell( DEFAULT_SMELL,
    "Du riechst nur Deinen eigenen Angstschweiss." );
  AddSmell( ({ "angstschweiss", "schweiss"}),
    "Nicht sehr angenehm, Du stinkst!");
  AddSmell( ({ "umgebung" }),
    "Du riechst nur Deinen eigenen Angstschweiss.");
  AddSmell( ({ "nichts" }),
    "Du riechts Nichts, hast Du etwas anderes erwartet?");
  
  
  AddSound( DEFAULT_SOUND,
    "Stille." );
  AddSound( ({ "stille"}),
    "Die Stille laedt zum spirituellen Meditieren ein.");
  AddSound( ({ "umgebung" }),
    "Nichts, Du hoerst keinen Ton.");
  AddSound( ({ "ton" }),
    "Nichts.");
  AddSound( ({ "nichts" }),
    "Du lauscht dem Nichts, und hoerst das Nichts, Nichts sagen.");
  AddSound( ({ "idee" }),
    "Untersuchen hilft immer.");
  
 
  
AddCmd( ({"erkunde", "erkunden" }), "cmd_erkunde" );
AddCmd( ({"meditiere", "meditieren" }), "cmd_medi" );
AddCmd( ({"taste", "ertaste", "tasten"}), "cmd_taste" );
AddCmd( ({"schmeck", "schmecke", "schmecken" }), "cmd_schmeck" );
AddCmd( ({"wirf", "werfe", "schmeisse", "schmeiss" }), "cmd_stein" );
AddCmd( ({"bind", "binde" }), "cmd_faden" );
AddCmd( ({"wickle", "wickeln", "wickel" }), "cmd_huefte" );
AddCmd( ({"schiess", "schiesse", "schiessen" }), "cmd_bola" );
AddCmd( ({"rufe", "ruf" }), "cmd_soth" );
AddCmd( ({"such", "suche" }), "cmd_such" );

}

int cmd_such(string str){
 notify_fail("Was suchst Du?\n");
 if(!str || str == "")  return 0;
 if(!(str == "weisheit" )) return 0;

 write(BS("Dort wo Gerechtigkeit, Leid.\n"));

  return 1;
}

int cmd_soth(string str){
 notify_fail("Was willst Du rufen?\n");
 if(!str || str == "")  return 0;
 if(!(str == "naar" )) return 0;

 write("Du nimmst Deinen ganzen Mut zusammen, und machst Dich auf "
       "den Kampf Deines Lebens bereit.\n");

 TP->move(ROOM "brunnen_18", M_GO, "ins andere Reich");

 return 1;
}

int cmd_medi(string str){
 notify_fail("Wie willst Du meditieren?\n");
 if(!str || str == "")  return 0;
 if(!(str == "spirituell" )) return 0;

 write("Du gehst in Dich, und langsam kommt Dir eine Idee.\n");

 return 1;

}

int cmd_erkunde(string str){
 notify_fail("Was willst Du erkunden?\n");

 if(!str || str == "")  return 0;
 if(!(str == "umgebung" ||
      str == "die umgebung" )) return 0;

  write(BS("Du erkundest die Umgebung und kommst zu dem Schluss, dass "
	"Dir nur Deine Sinne weiterhelfen koennen.\n"));

 
   return 1;

}
  
int cmd_taste(string str){
 notify_fail("Was willst Du ertasten?\n");

 if(!str || str == "") return 0;
 if(!(str == "umgebung" ||
      str == "die umgebung" )) return 0;

 write(BS("Du tastest in Deiner Umgebung umher und findest leider "
	  "Nichts, Nichts und wieder Nichts. Aber hoppla, was war "
	  "denn das? Du hast gerade Etwas gespuert.\n"));

	 
  return 1;      
}



int cmd_schmeck(string str){
 notify_fail("Was willst Du schmecken?\n");

 if(!str || str == "") return 0;
 if(!(str == "umgebung" ||
      str == "die umgebung" )) return 0;

 write(BS("Du versucht Deine Umgebung zu schmecken. Welch sinnloses "
	  "Unterfangen! Doch manchmal sind schon die grossartigsten Ideen "
	  "in der groessten Verzweiflung geboren worden. Und genau das ist jetzt "
	  "Dir passiert. Als Du so herumschmeckst, hast Du auf einmal einen "
	  "staubigen Wollfaden im Mund. Ob der Dir helfen kann?\n"));

 
 return 1;

}

int cmd_stein(string str){
 notify_fail("Was willst Du werfen?\n");	
 if(!str || str == "") return 0;
 if(!(str == "stein" ||
       str == "stein weg" )) return 0;

 write(BS("Das waere keine gute Idee. Du hast Dich gerade gefreut den Stein "
	  "gefunden zu haben und jetzt willst Du ihn gleich wieder "
	  "loswerden? Nach ein bisschen denken laesst Du diese Idee "
	  "wieder fallen.\n"));


  
  return 1;

 
 
} 
int cmd_faden(string str){
 notify_fail("Was willst Du woran anbinden?\n");

 if(!str || str == "") return 0;
 if(!(str == "faden an stein" ||
      str == "faden an stein an" ||
      str == "faden um stein" ||
      str == "wollfaden an stein an" ||
      str == "wollfaden um stein" ||
      str == "wollfaden an stein" )) return 0;
 

 write(BS("Du bindest den Faden an den Stein. Wie durch einen "
	  "Geistesblitz formt sich in Deinem Kopf ein genialer Plan.\n"));


 return 1;

}
int cmd_huefte(string str){
 notify_fail("Was willst Du worum wickeln?\n");

 if(!str || str == "") return 0;
 if(!(str == "faden um huefte" ||
      str == "faden um huefte herum" ||
      str == "wollfaden um huefte" ||
      str == "wollfaden um huefte herum" )) return 0;
 

 write(BS("Perfekt. Jetzt hast Du eine kleine Bola. Gratulation!\n"));


 return 1;

}
int cmd_bola(string str){
 notify_fail("Was willst Du wie schiessen?\n");

 if(!str || str == "") return 0;
 if(!(str == "bola mit aller kraft" ||
      str == "bola mit all meiner kraft" )) return 0;
 

 write(BS("Du schiesst die Bola mit all Deiner Kraft in die Weite des "
	  "Nichts und wirst von ihr mitgezogen. Wo magst Du nur "
	  "ankommen?\n"));
 TP->move(ROOM "brunnen_4", M_GO, "einfach weg" );


 return 1;

}
