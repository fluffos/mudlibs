//erstellt von hasibaerchi 3. raum



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

int anz=5;

void create()
{
::create();

  SetProp( P_INT_SHORT, "In einem Brunnen" );
  SetProp( P_INT_LONG,
   "Da bist Du nun, auf einer rostigen Leiter stehend. Was mach ich nur hier "
   "schiesst es Dir durch deinen Kopf? Von oben dringt kein Licht mehr zu Dir, "
   "unter Dir die nachtschwarze Tiefe, aus der Dir eisige Kaelte entgegen "
   "stroemt, um Dich herum nur Stein und Deine Finger werden schon langsam "
   "taub vor Kaelte. Ist es hier nicht wunderschoen? Es war wirklich eine "
   "gute Idee hier hinunter zu klettern.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist irgendwo in der Tiefe des Brunnenschachts zu finden.");
  AddDetail( ({ "leiter" }),
    "Du stehst auf der Leiter. Alleine die rostigen Sprossen trennen "
    "Dich vor einem Absturz in die Tiefe.");
  AddDetail( ({ "du", "dir", "dich", "deine", "dein" }),
    "Tja, Du bist Du! Du hast eine Nase, Augen, Ohren und noch vieles mehr.");
  AddDetail( ({ "augen", "auge", "nase", "ohren", "ohr", "knie" }),
    "Du kontrollierst Deinen Koerper, zaehlst Deine Koerperteile durch und "
    "stellst erleichtert fest, dass alles noch an seinem richtigen Platz ist.");
  AddDetail( ({ "koerper", "koerperteile", "platz", "leib" }),
    "Alles dort wo es hingehoert! Zumindest Deiner Meinung nach.");
  AddDetail( ({ "meinung" }),
    "Deine Meinung ist gefragt.");
  AddDetail( ({ "tiefe" }),
    "Du hast das Gefuehl am Abgrund in die Unendlichkeit zu stehen. Deine Knie "
    "beginnen zu zittern. Eisige Kaelte stroemt Dir entgegen.");
  AddDetail( ({ "gefuehl", "gefuehle" }),
    "Tja Gefuehle. Liebe, Hass, Zorn, Freude, und viele mehr.");
  AddDetail( ({ "hass", "zorn" }),
    "Negative Gefuehle eben!");
  AddDetail( ({ "freude" }),
     "Ein sehr positives Gefuehl.");		  
  AddDetail( ({ "liebe" }),
    "Nicht mit Sex zu verwechseln.");
  AddDetail( ({ "sex", "silberland" }),
    "Du erwartest doch nicht im ernst, dass ich Dir das genauer beschreibe!");
  AddDetail( ({ "abgrund" }),
    "Ob dort unten Dein Ende auf Dich wartet?");
  AddDetail( ({ "ende" }),
    "Es wird kommen, und wenn Du nicht vorsichtig bist, kommt es schneller als "
    "Dir lieb ist. Willst Du es beschleunigen? Dann wirf eine Muenze in "  
    "den Abgrund.");
  AddDetail( ({ "muenze"}),
    "Du hast bestimmt eine Muenze bei Dir, wirf sie doch einfach in "
    "den Brunnen.");
  AddDetail( ({ "unendlichkeit" }),
    "Das Silberland, unendliche Weiten, dies sind die Abenteuer des ......");
  AddDetail( ({ "weiten", "weite" }),
    "Die Weiten des Silberlandes.");
  AddDetail( ({ "abenteuer" }),
    "Auch Quests genannt. Davon gibt es viele im Silberland.");
  AddDetail( ({ "quests", "quests"}),
    "Auch Abenteuer genannt.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus kleinen, grauen Steinbloecken.");
  AddDetail( ({ "brunnen", "brunnenschacht", "schacht"}),
    "Viele Steinbloecke fuellen den Brunnenschacht aus."); 	  
  AddDetail( ({ "steinbloecke", "steinblock", "block","bloecke", "steinbloecken"}),
    "Bei naeherer Betrachtung entdeckst Du Rillen, die mit Fugenmasse "
    "ausgefuellt sind.");
  AddDetail( ({ "betrachtung"}),
    "Zusaetzlich erkennst Du, dass die Waende feucht sind.");
  AddDetail( ({ "rillen"}),
    "Die Rillen sind mit Fugenmasse gefuellt.");
  AddDetail( ({ "fugenmasse", "masse"}),
    "Die Fugenmasse ist total schimmelig. Ekel steigt in Dir empor. Eine Fuge "
    "faellt Dir besonders auf.");
  AddDetail( ({ "ekel", "fortsaetze", "fuesse"}),
    "Einfach nur waeh!");
  AddDetail( ({ "fuge", "fugen"}),
    "Hier fehlt etwas Fugenmasse. Du koenntest versuchen den angrenzenden "
    "Stein zu lockern.");
  AddDetail( ({ "stein"}),
    "Versuch den Stein zu lockern, wenn Du Dich traust!");
  AddDetail( ({ "angst" }),
    "Die Angst steigt Dir deine Knochen empor. Du zitterts am ganzen Leib.");
  AddDetail( ({ "knochen"}),
    "Davon hast Du genau 183 in Deinem Koerper. Pass auf das Du Dir "
    "keine brichst!");
  AddDetail( ({ "himmel", "decke"}),
    "Von dort oben dringt kein Licht mehr in den Brunnen. Finster ist es hier.");
  AddDetail( ({ "licht"}),
    "Nur mit einer Lichtquelle kannst Du genug sehen. Ausser Du bist ein "
    "Dunkelelf, aber Du weisst sicher welcher Rasse Du angehoerst. Wer weiss, "
    "wie es weiter unten aussehen wird? ");
  AddDetail( ({ "feuchtigkeit"}),
    "Sie liegt einfach auf allem was hier zu finden ist.");
  AddDetail( ({ "finger"}),
    "Davon hast Du zehn. Aber auch zehn Zehen hast Du.");
  AddDetail( ({ "zehen"}),
    "Die wurmartigen Fortsaetze an Deinen Fuessen.");
  AddDetail( ({ "absturz"}),
    "Sicher nicht angenehm. IIIIIIUUUUUUUUUU!!! *BUMM*");
  AddDetail( ({ "bumm"}),
    "Wenn Du so weitermachst, ist Dir der Tod sicher.");
  AddDetail( ({ "luft"}),
    "Die Luft hier drinnen ist feucht und abgestanden.");
  AddDetail( ({ "sprossen", "sprosse" }),
    "Die Sprossen sind schon sehr rostig. Ob sie Dich noch tragen koennen? "
    "Pass ja auf, dass Du nicht durchbrichst!");
  AddDetail( ({ "rost" }),
    "Das ist jetzt ein Forscherpunkt fuer Dich!");
  AddDetail( ({ "forscherpunkt", "punkt" }),
    "Jetzt uebertreib aber nicht! Andererseits wer nicht forscht, "
    "wird enttaeuscht.");
  AddDetail( ({ "dunkelelf", "dunkelelfen", "fee", "feen", "oger" }),
    "Eine der vielen Rassen im Silberland.");
  AddDetail( ({ "rasse", "rassen" }),
    "Du zaehlst geistig alle Rassen des Silberlandes durch, und stellst "
    "beruhigt fest, dass Du keine vergessen hast.");
  AddDetail( ({ "tod" }),
    "Willst Du den Tod wirklich untersuchen? Dann mach nur weiter so, und "
    "schon bald wirst Du bei ihm sein!");
  AddDetail( ({ "lichtquelle", "lichtquellen" }),
    "Davon gibt es mehrere im Silberland, angefangen von Fackeln ueber "
    "Lichtitems.");
  AddDetail( ({ "lichtitem", "lichtitems" }),
    "Die gibt es bei Lux, der Fee, in Tijara.");
  AddDetail( ({ "lux" }),
    "Eine kleine suesse Fee, aber trotzdem wird sie Dir ein Lichtitem nicht "
    "ohne Kampf abtreten.");
  AddDetail( ({ "kampf"}),
    "Du willst wirklich den Kampf untersuchen und erforschen? Na dann dringe "
    "nur weiter in die Tiefe vor. Du wirst schon sehen was Du davon hast.");
  AddDetail( ({ "tijara"}),
    "Eine der vielen Staedte im Silberland, sie befindet sich nahe dem "
    "Dschungel.");
  AddDetail( ({ "stadt", "staedte" }),
    "Wie gesagt, davon gibt es sehr viele.");
  AddDetail( ({ "dschungel" }),
    "Dort ist es sehr heiss, Du solltest dort auf jeden Fall Badekleidung "
    "mitnehmen.");
  AddDetail( ({ "fall", "faelle" }),
    "Davon gibt es vier, aber aufzaehlen kannst Du diese schon selbst!");
  AddDetail( ({ "badekleidung"}),
    "Du singst: Pack die Badehose ein, nimm Dein kleines Schwesterlein ......");
  AddDetail( ({ "pack"}),
    "Nur Hauptwoerter sind zum Untersuchen da!");
  AddDetail ( ({ "hauptwoerter", "hauptwort" }),
     "Nicht scripten!");
  AddDetail( ({ "badehose" }),
     "Eine Badehose ist eine Badekleidung, logisch oder?");
  AddDetail( ({ "schwesterlein", "schwester" }),
     "Hast du eine Schwester?");
  AddDetail( ({ "fackel", "fackeln" }),
     "Auch davon gibt es mehrere im Silberland. Geh Dir eine in Tijara kaufen.");
  AddDetail( ({ "kopf" }),
     "Der gehoert zu Deinem Koerper, nur leider nutzen viele Helden ihren Kopf "
     "viel zu selten.");
  AddDetail( ({ "held", "helden" }),
     "Du bist einer der Helden die es gewagt haben in den Brunnen einzudringen. "
     "Bravo! Allerdings weisst Du nicht, ob das eine gute Idee war.");
  AddDetail( ({ "idee", "ideen" }),
     "Du reibst mit dem Finger unter Deiner Nase, und ploetzlich hast du eine "
     "Idee. Forschen hilft Dir immer weiter!");
  AddDetail( ({ "kaelte" }),
     "Es ist bereits schon so kalt, dass Dein Atem vor Kaelte dampft.");
  AddDetail( ({ "atem" }),
     "Da wird ja ein Oger neidisch, Dein Atem stinkt! Waeh! Zaehneputzen "
     "waere nicht schlecht!"); 
  
 
  AddSmell( DEFAULT_SMELL,
    "Der Geruch von Tod und Verwesung liegt in der Luft." );
  AddSmell( ({ "geruch"}),
    "Es riecht feucht und mufflig.");
  AddSmell( ({ "tod"}),
    "Er ist naeher als Du denkst.");
  AddSmell( ({ "verwesung"}),
    "Es riecht eklig, der Tod scheint hier alles zu beherrschen.");
  AddSmell( ({ "luft"}),
    "Wie gesagt, Tod und Verwesung.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Pfeifen." );
  AddSound( ({ "pfeifen"}),
    "Es hoert sich an wie der Atem des Todes.");
  AddSound( ({ "atem"}),
    "Du lauscht dem Tod.");
  AddSound( ({ "tod", "todes"}),
    "ICH WARTE AUF DICH STERBLICHER, SCHON BALD WIRST DU BEI MIR SEIN."); 

    

AddCmd( ({"kletter", "klettere" }), "cmd_ausgang" );
AddCmd( ({"wirf", "werfe"}), "cmd_wurf" );
AddCmd( ({"locker", "lockere"}), "cmd_stein" );
AddCmd( ({"spring", "springe"}), "cmd_sprung" );
AddCmd( ({"steige", "steig"}), "cmd_steige" );


}
int cmd_steige(string str){
 notify_fail("Worueber willst Du steigen?\n");

 if(!str || str == "") return 0;
 if(!(str == "drueber" ||
      str == "ueber sprosse" ||
      str == "runter" ||
      str == "nach unten" ||
      str == "ueber sprossen" )) return 0;

  TP->move(ROOM "brunnen_5", M_GO, "nach unten", "steigt");

  return 1;
}

int cmd_sprung(string str){
 notify_fail("Wohin willst Du springen?\n");

 if(!str || str == "") return 0;
 if(!(str == "runter" ||
      str == "unten" ||
      str == "nach unten" ||
      str == "in tiefe" ||
      str == "in die tiefe" )) return 0;

  write("Du nimmst Deinen ganzen Mut zusammen und stuerzt Dich\n"
	"in die Tiefe. Leider bleibst Du an der Leiter haengen\n"
	"und knallst mit voller Wucht gegen die Mauer. Hoffentlich\n"
	"hat das niemand gesehen! Vielleicht ist es doch besser,\n"
	"wenn Du ueber die Sprosse steigst.\n");

  say(TPN+" versucht nach unten zu springen, und bleibt an der\n"
	  "Leiter haengen. Woody sei Dank bist Du nicht schadenfroh,\n"
	  "sonst muesstest Du laut auflachen.\n");
  this_player()->AddHp(-25);

  return 1;
}
 
int cmd_ausgang(string str){
 notify_fail("Wohin willst Du klettern?\n");

 if(!str || str == "") return 0;
 if(!(str == "runter" ||
      str == "unten" ||
      str == "auf" ||
      str == "rauf" ||
      str == "nach oben" ||
      str == "nach unten" )) return 0;
 
 if( str == "runter" || str == "nach unten" || str == "unten"){
 write("Du brichst durch eine rostige Sprosse durch, schaffst es\n"
       "aber gerade noch Dich festzuhalten. Vielleicht ist es doch\n"
       "besser, wenn Du in die Tiefe springst.\n");

 say(TPN+" versucht nach unten zu klettern, und verletzt sich dabei\n"
	 "schwer. Das wird einen blauen Fleck geben.\n");
 this_player()->AddHp(-15);
	       

 return 1;
} 

 if( str == "rauf" || str == "auf" || str == "nach oben"){
 TP->move(ROOM "brunnen_2", M_GO, "nach oben", "klettert");
	       

 return 1;
}
}
	 
int cmd_wurf(string str){
    notify_fail("Was willst Du wohin werfen?\n");

 if(!str || str == "") return 0;
 if(!(str == "muenze in schacht" ||
      str == "muenze nach unten" ||
      str == "muenze runter" ||
      str == "muenze in brunnen" ||
      str == "muenze in abgrund" ||
      str == "muenze hinunter" )) return 0;

 if(TP->QueryMoney()<1)
	 return write (BS("Du hast ja gar keine Muenze!")), 1;

 write(BS("Du wirfst eine Muenze in den Schacht hinunter. Nach kurzer Zeit\n"
	  "hoerst du ein leises Ping. Tief geht es da nicht mehr hinunter!\n"));
 
 say(BS(TPN+" wirft eine Muenze in den Schacht, wartet einen Moment und\n"
	    "verzieht das Gesicht.\n"));

 TP->AddMoney(-1);
 "p/daemon/zentralbank"->PayIn(1, 100);

 return 1;
}
		  
int cmd_stein(string str){
    object assel;
    notify_fail("Was willst du lockern?\n");

    if(!str || str == "") return 0;
    if(!(str == "stein")) return 0;

    write (BS("Du lockerst den Stein.\n"));
    say(BS(TPN+" macht sich an der Mauer zu schaffen.\n"));

    if(anz>0){

   	assel = clone_object(NPC "assel");

   	assel->move(ENV(TP), M_NOCHECK);
	anz--;

  }

 return 1;
}

void reset(){
	::reset();
	anz=5;
}
