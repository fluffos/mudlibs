#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "Ein Vorzimmer" );
  SetProp( P_INT_LONG,
   "Du stehst in einer Art Vorzimmer. Im Gegensatz zu Deinen bisherigen "
   "Erfahrungen ist es hier angenehm. Kein Wasser, keine Feuchtigkeit und "
   "auch kein Abgrund unter Dir. Trotzdem hast Du schon angenehmere "
   "Plaetzchen gesehen. Ob hier etwas zu finden ist?");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Auf dem Boden stehst Du, und es gibt keine Ueberraschungen fuer Dich. "
    "Hattest Du etwas anderes erwartet?");
  AddDetail( ({ "ueberraschung", "ueberraschungen" }),
    "Wie gesagt, hier gibt es keine fuer Dich.");
  AddDetail( ({ "art" }),
    "Hier ist nicht die Kunst gemeint!");
  AddDetail( ({ "kunst" }),
    "Dachtest Du wirklich hier Kunst zu finden? Na, Du musst ja ein "
    "Traeumer sein.");
  AddDetail( ({ "traeumer" }),
    "Du solltest so schnell wie moeglich wieder in die Realitaet zurueckkehren, "
    "sonst koennte es fuer Dich schlecht enden.");
  AddDetail( ({ "realitaet", "vision" }),
    "Du sitzt vor einem Computer und tippselst auf einer Tastatur herum. ");
  AddDetail( ({ "computer", "tastatur" }),
    "War dies etwa eine Vision von einer weit entfernten Welt, die noch nie "
    "ein Held zuvor gesehen hat?");
  AddDetail( ({ "welt" }),
    "Tipp einfach die heiligen Worte, schlafe ein, und schon bist Du dort.");
  AddDetail( ({ "wort", "worte" }),
    "Am Anfang war das Wort.");
  AddDetail( ({ "anfang" }),
    "1996.");
  AddDetail( ({ "1996" }),
    "Da wurde das Silberland gegruendet.");
  AddDetail( ({ "silberland" }),
    "Darin befindest Du Dich!");
  AddDetail( ({ "held", "helden" }),
    "Das musst Du sein, sonst waerest Du nicht hier, oder?");
  AddDetail( ({ "vorzimmer", "plaetzchen", "zimmer" }),
    "Ein ganz normales Zimmer mit Boden, Waenden und auch einer Decke.");
  AddDetail( ({ "decke" }),
    "Hast Du etwa mit einer Ueberraschung gerechnet?");
  AddDetail( ({ "waende", "waenden" }),
    "Davon gibt es vier. In jede Richtung eine.");
  AddDetail( ({ "wand" }),
    "Welche der vier Waende meinst Du?");
  AddDetail( ({ "richtungen", "richtung" }),
    "Norden, Osten, Sueden und Westen.");
  AddDetail( ({ "norden", "osten", "sueden", "westen" }),
    "Richtungen eben.");
  AddDetail( ({ "suedwand", "ostwand" }),
    "Diese Wand besteht nur aus Steinen.");
  AddDetail( ({ "steine", "steinen" }),
    "Ganz normale Steine, ohne jeglicher Ueberraschung.");
  AddDetail( ({ "nordwand" }),
    "Von der kannst Du leider nichts erkennen, weil dieser bloede Schrank im "
    "Weg steht. Wer hat denn dieses bloede Ding hier her gestellt?");
  AddDetail( ({ "ding", "dinge", "babykram" }),
    "Das Ding, die Dinge. Findest Du nicht, dass dies Babykram ist?");
  AddDetail( ({ "weg" }),
    "Keiner am Boden zu finden.");
  AddDetail( ({ "schrank" }),
    "Ein ganz normaler Schrank mit einer Tuer, zumindest scheint es so.");
  AddDetail( ({ "tuer" }),
    "Die Tuer steht offen und tiefe Dunkelheit stroemt Dir entgegen.");
  AddDetail( ({ "dunkelheit" }),
    "Die Dunkelheit wirkt sehr bedrohlich auf Dich, bedrohlicher als "
    "das Nichts.");
  AddDetail( ({ "nichts" }),
    "Du beginnst zu zittern, Deine Angst scheint Dich zu uebermannen.");
  AddDetail( ({ "angst" }),
    "Wenn Du ein richtiger Held waerst, wuerdest Du Dich der Angst stellen "
    "und in das Nichts greifen. Dies ist jedoch nur fuer die tapfersten "
    "Helden ratsam. Sag nicht, Du wurdest nicht gewarnt!");
  AddDetail( ({ "westwand" }),
    "Du untersuchst die Wand, und entdeckst, abgesehen von den vielen "
    "Steinen, einen komisch aussehenden Stein.");
  AddDetail( ({ "stein" }),
    "Warum komisch? Naja, aus dem Grund, weil sich im diesem Stein ein "
    "kleines Loch befindet. Es ist gerade gross genug, um einen Finger hinein "
    "stecken zu koennen.");
  AddDetail( ({ "finger" }),
    "Und schon ist er ab!");
  AddDetail( ({ "loch" }),
    "Gross genug um einen Finger hinein stecken zu koennen.");
  AddDetail( ({ "gegensatz" }),
    "Du untersuchst wirklich alles, oder?");
  AddDetail( ({ "erfahrungen" }),
    "Von denen musst Du schon einige gesammelt haben. Du bist ein Held!");
  AddDetail( ({ "wasser" }),
    "Keines da!");
  AddDetail( ({ "feuchtigkeit" }),
    "Auch nicht da! Das macht es ziemlich trocken hier.");
  AddDetail( ({ "abgrund" }),
    "Du bist richtig froh, dass hier kein Abgrund mehr ist.");
  AddDetail( ({ "du", "dich", "dir", "deinen" }),
    "Das bist Du.");

  

  AddSmell( DEFAULT_SMELL,
    "Irgendwie ist hier kein Geruch zu riechen." );
  AddSmell( ({ "geruch"}),
    "Du riechst nix Besonderes.");
  AddSmell( ({ "besonderes" }),
    "Nix bedeutet, dass es hier nix zum riechen gibt!");
 
  AddSound( DEFAULT_SOUND,
    "Hier gibt es keine Geraeusche." );
  AddSound( ({ "geraeusche"}),
    "Keine zu hoeren!");
  

  
  AddExit( "suedosten", ROOM "brunnen_8" ); 

  
AddCmd( ({"betrete", "betritt" }), "cmd_ausgang" );
AddCmd( ({"greif", "greife" }), "cmd_schrank" );
AddCmd( ({"stecke", "steck" }), "cmd_tuer" );

}

int cmd_schrank(string str){
 notify_fail("Wo willst Du hinein greifen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "in nichts hinein" ||
      str == "in nichts" ||
      str == "ins nichts hinein" ||
      str == "ins nichts rein" ||
      str == "ins nichts")) return 0;

 write("Schmerz durchfaehrt Dich. Das war keine gute Idee. Solltest Du\n"
       "jedoch ganz tapfer sein, dann stell Dich Deinen schlimmsten\n"
       "Albtraeumen und betrete das Nichts.\n");

 say(TPN+" kruemmt sich vor Schmerzen.\n");
 this_player()->AddHp(-45);

 return 1;

}

int cmd_tuer(string str){
 notify_fail("Was willst Du wohin stecken?\n");

 if(!str || str == "") return 0;
 if(!(str == "finger in loch" ||
      str == "finger rein" ||
      str == "finger in loch rein" ||
      str == "finger in loch hinein" ||
      str == "finger hinein" )) return 0;

 write("Du steckst Deinen Finger ins Loch, und fuehlst Schmerz.\n");
       
 say(TPN+" schreit vor Schmerz.\n");
 this_player()->AddHp(-10);
 TP->move(ROOM "brunnen_5", M_GO, "auf Reisen");

 return 1;
 
} 
int cmd_ausgang(string str){
 notify_fail("Was willst Du betreten?\n");

 if(!str || str == "") return 0;
 if(!(str == "nichts" ||
      str == "schrank" )) return 0;
     
 
 TP->move(ROOM "brunnen_9", M_GO, "ins andere Reich");
	       

 return 1;
}

	 

