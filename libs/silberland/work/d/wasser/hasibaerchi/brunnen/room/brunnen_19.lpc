//erstellt von hasibaerchi zelle 

#include "../def.h"
inherit "std/room";
inherit "std/player/moneyhandler";



void create()
{
::create();
 
  SetProp( P_INT_SHORT, "In einer Zelle");
  SetProp( P_INT_LONG,
  "Na, wo bist Du den hier gelandet? Das ist ja eine Zelle! Wie wirst Du "
  "hier nur rauskommen? Einfach wird es sicher nicht werden.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Steine, Steine nichts als Steine.");
  AddDetail( ({ "wand", "waende" }),
    "Nur ein Haufen Steine und keine Tuer die in die Freiheit fuehrt.");
  AddDetail( ({ "stein", "steine" }),
    "Hart und rau.");
  AddDetail( ({ "haufen" }),
    "Einfach viele Steine.");
  AddDetail( ({ "freiheit" }),
    "Freiheit suchst Du, aber die wirst Du nur ausserhalb der Zelle "
    "erhalten.");
  AddDetail( ({ "zelle" }),
    "Ja, das ist eine Zelle! Wie Du hier nur rauskommen wirst? "
    "Einfach wird es sicher nicht werden.");
  AddDetail( ({ "decke" }),
    "Irgendetwas scheint in der Decke zu sein.");
  AddDetail( ({ "irgendetwas" }),
    "Es sieht wie eine Falltuer aus.");
  AddDetail( ({ "tuer" }),
    "Hier ist keine Tuer.");
  AddDetail( ({ "falltuer" }),
    "Na, was kann man mit einer Falltuer machen?");
  AddDetail( ({ "ecke", "ecken" }),
    "Du untersuchst die Ecken und entdeckst wirklich in einer Ecke ein "
    "Haeufchen Stroh. Das ist sicher fuer die Notdurft gedacht.");
  AddDetail( ({ "notdurft" }),
    "Du kannst Dir das ganz gut auch ohne detailierte Beschreibung "
    "vorstellen, glaub mir!");
  AddDetail( ({ "beschreibung" }),
    "Wie genau haettest Du es gern?");
  AddDetail( ({ "stroh", "haeufchen" }),
    "Nichts weiter als normales Stroh.");
    
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach verfaulten Eiern." );
  AddSmell( ({ "eier", "eiern", "geruch"}),
    "Es stinkt bestialisch! Der Geruch kommt hier irgendwo aus der Zelle.");
  AddSmell( ({ "zelle" }),
    "Es riecht wirklich grauslich hier.");
  
  
  AddSound( DEFAULT_SOUND,
    "Plopp." );
  AddSound( ({ "plopp"}),
    "Das war nur Dein Angstschweiss der zu Boden tropft.");
  AddSound( ({ "angstschweiss" }),
    "Ganz leise tropft der Angstschweiss zu Boden.");
  AddSound( ({ "boden" }),
    "Der Boden ist und bleibt stumm.");
  
  
AddItem(NPC "troll",  REFRESH_DESTRUCT);
 
  
AddCmd( ({"oeffne" }), "cmd_oeffne" );
AddCmd( ({"breche", "brech", "brich"}), "cmd_breche" );



}

int cmd_oeffne(string str){
 notify_fail("Was willst Du oeffnen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "falltuer" ||
      str == "falltuere" ||
      str == "die falltuere" ||
      str == "die falltuer" )) return 0;

  write(BS("Du versucht die Falltuer zu oeffnen, aber irgendwie "
	   "scheint sie zu klemmen.\n"));
 
  say(TPN+" streckt sich.\n");
 
   return 1;

}
  
int cmd_breche(string str){
 notify_fail("Was willst Du aufbrechen?\n");

 if(!str || str == "") return 0;
 if(!(str == "falltuer" ||
      str == "die falltuer" ||
      str == "die falltuere" ||
      str == "falltuere" ||
      str == "falltuere auf" ||
      str == "falltuer auf" ||
      str == "die falltuer auf" ||
      str == "die falltuere auf" )) return 0;

 write(BS("Du nimmst Deine ganze Kraft zusammen und versuchst die Falltuer "
	  "aufzubrechen. Und tatsaechlich schaffst Du es.\n"));

 say(TPN+" streckt sich.\n");
 TP->move( "/d/wasser/hasibaerchi/brunnen/room/brunnen_8.lpc", M_GO, "raus", "klettert");
 
 return 1;      
}


