#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "Am Grund eines Brunnens" );
  SetProp( P_INT_LONG,
   "Du stehst am Grund des Brunnens. Deine Fuesse stehen bis zu Deinen "
   "Knoecheln im Wasser. Irgendwie ist hier eine sehr drueckende Stimmung " 
   "zu spueren. Du bist hier nicht allein. Irgendwas lauert hier unten "
   "auf Dich. Vielleicht solltest Du doch wieder nach oben klettern, bevor "
   "es zu spaet fuer Dich ist.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Auf dem Boden stehst Du, jedoch ist das Wasser viel zu schmutzig um etwas "
    "vom Boden erkennen zu koennen.");
  AddDetail( ({ "grund" }),
    "Hier endet der Brunnen also. Naja, hier ist es genau so, wie Du es "
    "Dir immer vorgestellt hast. Finster, schmutzig und furchteinfloessend. "
    "Ein toller Ort!");
  AddDetail( ({ "ort" }),
    "Was erwartest Du von diesem Ort? Schaetze, Macht, oder doch nur blanken "
    "Horror? Was auch immer Du suchst, Du wirst es finden, und in Dein nasses, "
    "kaltes Grab mitnehmen.");
  AddDetail( ({ "schatz", "schaetze"}),
    "Wenn man den Geschichten glauben mag, soll hier unten irgendwo das "
    "Versteck des groessten Schatzes des Silberlandes sein.");
  AddDetail( ({ "versteck" }),
    "Um das zu finden bist Du ja hier! Doch sei gewarnt, viele Schatzsucher, "
    "die vor Dir hier waren, kamen nie wieder an das Tageslicht zurueck.");
  AddDetail( ({ "tageslicht" }),
    "Ob Du es jemals wiedersehen wirst?");
  AddDetail( ({ "schatzsucher" }),
    "Deine Vorgaenger, jetzt tote Vorgaenger, bald gehoerst Du zu ihrer "
    "Gemeinschaft.");
  AddDetail( ({ "gemeinschaft" }),
    "Die Gemeinschaft der Toten.");
  AddDetail( ({ "vorgaenger" }),
    "Wenn Du Glueck hast, kannst Du ihre Ueberreste hier unten finden.");
  AddDetail( ({ "ueberreste" }),
    "Bei der Vorstellung an die Ueberreste Deiner Vorgaenger wird Dir "
    "sicher uebel werden. Dein Magen wird es Dir sicher danken.");
  AddDetail( ({ "vorstellung" }),
    "Nicht untersuchen! Stelle Dir einfach die Ueberreste vor, wenn Dir "
    "schlecht werden soll!");
  AddDetail( ({ "magen" }),
    "Du solltest Deinem Magen besser mal lauschen.");
  AddDetail( ({ "macht" }),
    "Tja, auch Macht kannst Du hier finden, so viel Macht sogar, um Dir "
    "alle Deine Traeume verwirklichen zu koennen. Du musst nur lange "
    "genug am Leben bleiben. Und das, ist keine leichte Aufgabe.");
  AddDetail( ({ "aufgabe" }),
     "Nur etwas fuer einen richtigen Held.");
  AddDetail( ({ "traum", "traeume" }),
    "Vielleicht sind Deine Traeume alles was Dir hier unten geblieben ist, denn "
    "mehr gibt es fuer Dich hier nicht, ausser dem Tod.");
  AddDetail( ({ "tod" }),
    "Der Tod wartet bereits hier auf Dich, und bald bist Du in seiner Gewalt.");
  AddDetail( ({ "gewalt" }),
    "Gewalt koennte hier unten vielleicht nuetzlich sein.");
  AddDetail( ({ "leben" }),
    "Dein Leben haengt im Moment an einem seidenen Faden.");
  AddDetail( ({ "moment" }),
    "Wuusch, und vorbei!");
  AddDetail( ({ "faden" }),
    "Schnippschnapp Faden ab! Oder doch nicht? Willst Du vielleicht den "
    "Faden Deines eigenen Lebens abschneiden? Nur zu, schneide ihn nur "
    "ab, wenn Du mutig bist. Sag aber nicht, Du wurdest nicht gewarnt!");
  AddDetail( ({ "horror" }),
    "Du kommst dem Horror schon naeher, bald wirst Du ihn gefunden haben und "
    "dann, gnade Dir Woody.");
  AddDetail( ({ "woody", "woodyhand" }),
    "Du kennst Woody nicht? Echt eine Schande, oder kennst Du ihn "
    "vielleicht doch?");
  AddDetail( ({ "schande" }),
    "Was hast Du jetzt erwartet zu finden? Etwa einen Schatz?");
  AddDetail( ({ "grab" }),
    "Ein nasses Grab wirst Du hier sicher finden wenn Du nicht vorsichtig "
    "bist. Du hoffst nur, dass es nicht Dein eigenes Grab sein wird.");
  AddDetail( ({ "geschichten" }),
    "Oder sollte man sagen Geruechte? Auf jeden Fall gibt es hier Reichtum "
    "und unermesslichen Ruhm zu finden.");
  AddDetail( ({ "reichtum", "ruhm" }),
    "Reichtum und auch Ruhm koennen Dir gehoeren, wenn Du tapfer bist.");
  AddDetail( ({ "geruechte", "geruechten" }),
    "Geruechten zufolge soll es hier gar finstere Kreaturen geben, die nur "
    "darauf warten Dich in das Reich der Toten zu schicken.");
  AddDetail( ({ "kreaturen", "monster" }),
    "Noch hast Du diese Kreaturen nicht gefunden, doch wenn Du weiter suchst, "
    "wirst Du sie auch finden. Ob dies jedoch gut enden wird, wagst Du "
    "zu bezweifeln.");
  AddDetail( ({ "reich", "toten" }),
    "Dort ist es finster kalt und hoffnungslos. Kein angenehmes Plaetzchen!");
  AddDetail( ({ "plaetzchen" }),
    "Du kannst Dir das Plaetzchen lebhaft vorstellen, warst Du etwa schon "
    "mal dort?");
  AddDetail( ({ "silberland" }),
    "Es wurde Dir schon weiter oben nicht beschrieben, warum sollte es jetzt "
    "anders sein?");
  AddDetail( ({ "fuesse", "fuss" }),
    "Die sind bis zu Deinen Knoecheln im Wasser. Mehr kannst Du leider nicht "
    "erkennen, da das Wasser viel zu schmutzig dafuer ist. Oder ist da "
    "noch Etwas?");
  AddDetail( ({ "etwas" }),
    "Wie eklig das sind Leichenteile von Asseln!");
  AddDetail( ({ "leichenteile", "assel", "asseln" }),
    "Einfach nur eklig!");
  AddDetail( ({ "knoechel", "knoecheln" }),
    "Wie gesagt, du stehst bis zu Deinen Knoecheln im Wasser. Du hoffst nur, "
    "dass in dieser dreckigen Bruehe keine Gefahr auf Dich lauert.");
  AddDetail( ({ "bruehe" }),
    "Genau da drinnen stehst Du, wie eklig!");
  AddDetail( ({ "gefahr" }),
    "Die Gefahr lauert foermlich hier unten auf Dich, Du bist dem Tod schon "
    "sehr nah.");
  AddDetail( ({ "stimmung" }),
    "Die Stimmung hier unten erdrueckt Dich fast. Deine Lungen schmerzen "
    "vor Anstrengung um Dir Atem zu schenken. Lang wirst Du diesem "
    "Druck nicht standhalten koennen. Oder ist es nur Deine Angst, die "
    "Dich zu ueberkommen droht?");
  AddDetail( ({ "lunge", "lungen" }),
    "Deine Lungen arbeiten hier nur unter groesster Anstrengung. Du "
    "solltest Dich auf keinen Fall auf einen Kampf einlassen, sonst bist "
    "Du einer Herzattacke sehr nahe und das, wuerde den Kreaturen hier "
    "unten den ganzen Spass nehmen. Und das willst Du doch nicht, oder?");
  AddDetail( ({ "anstrengung" }),
    "Halte Dich ein bisschen zurueck, Deine Lungen werden es Dir danken!");
  AddDetail( ({ "atem", "geruch", "verwesung" }),
    "Riechen waere nicht schlecht, andererseits vielleicht wird Dir dann "
    "schlecht.");
  AddDetail( ({ "druck" }),
    "Er scheint Dich langsam aber doch fertig zu machen. Vielleicht ist es "
    "doch besser wieder umzukehren. Im Anfaengerpark ist es sicher nicht so "
    "gefaehrlich, oh Du grosser Held.");
  AddDetail( ({ "held", "helden" }),
    "Du meinst doch nicht etwa Dich damit? Zeig Deinen Mut doch mal "
    "im Kampf.");
  AddDetail( ({ "mut" }),
    "Hast Du denn genug Mut, Dich den Kreaturen hier unten zu stellen?");
  AddDetail( ({ "anfaengerpark" }),
    "Dort gehen die richtigen Helden hin, vorallem solche Seicherln wie Du.");
  AddDetail( ({ "seicherl", "seicherln" }),
    "Du Du und nochmal Du!");
  AddDetail( ({ "angst" }),
    "Sogar Deine Fuesse zittern! Du bist mir vielleicht ein Held! Pass bloss "
    "auf, dass Du keine Herzattacke bekommst!");
  AddDetail( ({ "fall", "faelle" }),
    "Ups, jetzt bist Du hingefallen. Wieso untersuchst Du das auch?");
  AddDetail( ({ "kampf", "kaempfe", "zweikampf", "zweikaempfe" }),
    "Kaempfe findest Du weiter oben, aber auch weiter im Westen. Die Monster "
    "warten schon.");
  AddDetail( ({ "westen" }),
    "Das ist eine Himmelsrichtung, oder hast Du etwas anderes erwartet?");
  AddDetail( ({ "himmelsrichtung" }),
    "Davon gibt es einige, Westen ist zum Beispiel eine davon.");
  AddDetail( ({ "beispiel" }),
    "Osten zum Beispiel.");
  AddDetail( ({ "osten" }),
    "Das ist eine Himmelsrichtung. Wenn Osten vor Dir liegt, liegt Westen "
    "hinter Dir. Logisch oder?");
  AddDetail( ({ "herzattacke" }),
    "Auch Infarkt genannt.");
  AddDetail( ({ "infarkt" }),
    "Oh mein Woody, Dein Herz schlaegt nicht mehr! Rufe sofort, Ich "
    "brauche einen Arzt, oder Du bist tot. Du hast zehn Sekunden!");
  AddDetail( ({ "herz", "arzt", "sekunden", "ich" }),
    "Deine Zeit laeuft, Du hast noch fuenf Sekunden!");
  AddDetail( ({ "zeit" }),
    "Deine Zeit ist um!");
  AddDetail( ({ "spass" }),
    "Nicht mit einem Witz zu verwechseln.");
  AddDetail( ({ "witz" }),
    "Geht ein Barde im Gaffodorf spazieren .....");
  AddDetail( ({ "barde", "gaffodorf" }),
    "Na, Du bist mir ja ein Held!");
  AddDetail( ({ "decke", "himmel" }),
    "Von dort oben bist Du hergekommen. Der Mann der vom Himmel fiel. "
    "Oder bist Du etwa weiblich?");
  AddDetail( ({ "mann", "film" }),
    "Ein toller Film. David Bowie war genial.");
  AddDetail( ({ "david", "bowie" }),
    "Geruechten zufolge ein toller Mann. Was hat dies allerdings mit dem "
    "Silberland zu tun?");
  AddDetail( ({ "wasser" }),
    "Abgestandenes schmutziges Wasser, einfach nur eklig. Ob man das "
    "trinken kann?");
  AddDetail( ({ "brunnen" }),
    "Da stehst Du nun bis zu Deinen Knoecheln im Wasser am Grund des Brunnens. "
    "Dir ist kalt und Du zitterst. Die Waende sind feucht und glitschig, "
    "genauso wie die Leiter auf der Du heruntergekommen bist.");
  AddDetail( ({ "leiter" }),
    "Ein Glueck fuer Dich, dass die Leiter nicht hochgezogen werden kann, "
    "sonst haettest Du sicherlich ein Problem.");
  AddDetail( ({ "glueck" }),
    "Du hast wirklich Glueck noch am Leben zu sein. Hey macht Dich das -noch- "
    "etwa nervoes?");
  AddDetail( ({ "problem" }),
    "Du wuerdest ein schoenes nasses Grab hier unten finden. Waere dies "
    "denn ein Problem fuer Dich?");
  AddDetail( ({ "wand", "waende" }),
    "An den Waenden siehst Du eigentlich nur Steine, Steine und nochmal "
    "Steine.");
  AddDetail( ({ "stein", "steine" }),
    "Nur ganz normale Steine. Relativ viele davon haben allerdings Kratzer.");
  AddDetail( ({ "kratzer" }),
    "Die Kratzer scheinen ein Muster zu ergeben.");
  AddDetail( ({ "muster" }),
    "Du koenntest es doch einfach betrachten.");
  AddDetail( ({ "bild", "ayla", "schattengrund" }),
    "Vor Dir steht ein bildschoene Frau mittleren Alters. Ihre heilige "
    "Ausstrahlung stellt allerdings ihr Aussehen bei Weitem in den Schatten. "
    "Du bist fast der Meinung eine hell leuchtende Aura umgibt sie. Ihr langes "
    "Haar, ihr wohlgeformter Koerper und ihr gutmuetiges Gesicht taeuschen "
    "aber auch nicht ueber ihre absolut erstklassige Kondition und "
    "Kampferfahrung, vor allem gegen das Boese, hinweg.");
  AddDetail( ({ "aura" }),
    "Diese Aura kannst Du eigentlich gar nicht sehen, aber Du kannst sie sogar um "
    "Dich herum spueren.");
  AddDetail( ({ "alter" }),
    "Angeblich ist diese Frau unsterblich.");
  AddDetail( ({ "frau" }),
    "Eine beeindruckende Frau, wie war doch gleich ihr Name, achja Ayla. Wer "
    "koennte es denn sonst sein?");
  AddDetail( ({ "name" }),
    "Ayla von Schattengrund. Moege sie den Tod finden. Ups, was denkst "
    "Du da?");
  AddDetail( ({ "ausstrahlung" }),
    "Eine gewaltige heilige Ausstrahlung, Dir dreht sich der Magen um bei "
    "so viel Ausstrahlung.");
  AddDetail( ({ "aussehen" }),
    "Eine sehr attraktive Frau, mit ihren langen dunklen Haaren, ihrem "
    "perfekten Koerper, da kann schon manches Herz brechen.");
  AddDetail( ({ "weitem" }),
    "Einfach sinnlos was Du da untersuchst!");
  AddDetail( ({ "schatten" }),
    "Die Schatten des Todes greifen bereits nach Dir. Bald bist Du im Reich "
    "der Toten.");
  AddDetail( ({ "meinung" }),
    "Deine Meinung zaehlt, auch hier im Brunnen.");
  AddDetail( ({ "haar", "haare" }),
    "Ihre seidigen dunklen langen Haare gleiten wie von Woodyhand an ihrem "
    "makellosen Koerper entlang. Beginnend von ihrem Kopf, den ein "
    "Loewenhelm schmueckt, ueber ihre katzenhaften Schultern, ueber ihren "
    "muskuloesen Ruecken, bis zu ihrem knackigen Hintern. Was fuer "
    "eine Frau!");
  AddDetail( ({ "koerper", "hintern" }),
    "Schaem Dich, so an einem Bild herumzutasten! Geh gefaelligst zu Ayla "
    "persoenlich und lass dieses Bild in Ruhe!");
  AddDetail( ({ "ruhe" }),
    "Ruhe wirst Du im Reich der Toten schon finden.");
  AddDetail( ({ "gesicht" }),
    "Von dem Gesicht kannst Du leider kaum etwas erkennen, da der Loewenhelm "
    "fast das ganze Gesicht schuetzt.");
  AddDetail( ({ "kopf" }),
    "Auf dem Kopf traegt Ayla von Schattengrund den Loewenhelm.");
  AddDetail( ({ "kondition" }),
    "Geruechten zufolge soll diese Frau unermuedlich sein.");
  AddDetail( ({ "kampferfahrung" }),
    "Niemand hat mehr Kampferfahrung als Ayla von Schattengrund. Dies mag "
    "auch erklaeren, warum sie noch nie in einem Zweikampf besiegt worden ist.");
  AddDetail( ({ "boese" }),
    "Das Boese ist immer und ueberall!");
  AddDetail( ({ "schultern" }),
    "Mit ihren Schultern muss Ayla das ganze Gewicht ihrer Ruestung tragen. "
    "Sicher nicht sehr angenehm.");
  AddDetail( ({ "gewicht", "ruestung" }),
    "Du bist Dir ganz sicher, dass diese Ruestung verdammt schwer sein muss.");
  AddDetail( ({ "ruecken" }),
    "Ihren Ruecken kannst Du leider auf diesem Bild nicht sehen, aber "
    "ihr Bauch tuts auch.");
  AddDetail( ({ "bauch" }),
    "Daran kann nicht einmal Woody etwas aussetzen. Einfach perfekt!");
  AddDetail( ({ "helm", "loewenhelm" }),
    "Ein prachtvoller Helm. Er schuetzt den gesamten Kopf und auch das Gesicht. "
    "Sogar ihre Nase wird von dem Loewenhelm geschuetzt.");
  AddDetail( ({ "nase" }),
    "Du kannst die Nase unter dem Helm fast nicht erkennen, genauso wie "
    "ihre Augen.");
  AddDetail( ({ "augen" }),
    "Auch wenn Du ihre braunen Augen kaum erkennen kannst, scheinen diese "
    "doch durch ihr gelbliches Glitzern bis in Deine Seele blicken zu"
    "koennen.");
  AddDetail( ({ "seele" }),
    "Bald wird Deine Seele im Reich der Toten sein!");
  AddDetail( ({ "glitzern" }),
    "Ein gelbliches Glitzern? Wo kommt den das her? Als Du das Glitzern naeher "
    "betrachtest stellst Du fest, Du kannst es kaum glauben, dass es von einem "
    "gelblich eitrigen Pickel stammt, der Ayla mitten im Gesicht wuchert.");
  AddDetail( ({ "pickel" }),
    "Ein gewaltiger Pickel ragt Dir entgegen. Voll mit Eiter der richtig zu "
    "brodeln scheint. Wie haesslich!");
  AddDetail( ({ "eiter" }),
    "Es scheint sich eher um Saeure zu handeln so wie das brodelt. Pass bloss "
    "auf, sonst waechst Dir auch noch ein riesiger Pickel im Gesicht!");
  AddDetail( ({ "saeure" }),
    "Sehr giftig, sehr schmerzhaft und sehr toedlich. Hoffentlich kommst Du nie "
    "mit dem Eiter in Kontakt.");
  AddDetail( ({ "kontakt" }),
    "Sag nicht Du wurdest nicht gewarnt! Andererseits Du weisst sicher was man mit "
    "einem Pickel machen kann, nicht wahr?");
  AddDetail( ({ "pfeifen" }),
    "Versuchs mit lauschen.");
  
    
 
  AddSmell( DEFAULT_SMELL,
    "Der Geruch von Tod und Verwesung liegt in der Luft." );
  AddSmell( ({ "geruch"}),
    "Es riecht feucht und mufflig.");
  AddSmell( ({ "tod"}),
    "Er ist naeher als Du denkst.");
  AddSmell( ({ "verwesung"}),
    "Es riecht eklig, der Tod scheint hier alles zu beherrschen.");
  AddSmell( ({ "luft"}),
    "Wie gesagt, Tod und Verwesung.");
  AddSmell( ({ "atem" }),
    "Du stinkst! Jetzt weisst Du endlich woher dieser Geruch von Verwesung "
    "kommt.");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Pfeifen." );
  AddSound( ({ "pfeifen"}),
    "Es hoert sich an wie der Atem des Todes.");
  AddSound( ({ "atem"}),
    "Du lauscht dem Tod.");
  AddSound( ({ "tod", "todes"}),
    "ICH WARTE AUF DICH STERBLICHER, SCHON BALD WIRST DU BEI MIR SEIN.");
  AddSound( ({ "magen" }),
    "Das hoert sich gar nicht gut an. Es grummelt und blubbert, sogar ein leises "
    "Pfeifen vermagst Du zu hoeren.");

  
  AddExit( "westen", ROOM "brunnen_6" ); 

  
AddCmd( ({"kletter", "klettere" }), "cmd_ausgang" );
AddCmd( ({"trink", "trinke" }), "cmd_wasser" );
AddCmd( ({"schneid", "schneide", "durchschneide", "durchschneid" }), "cmd_faden" );
AddCmd( ({"betrachte" }), "cmd_bild" );
AddCmd( ({"drueck", "druecke", "quetsche", "quetsch" }), "cmd_pickel" );


}

int cmd_wasser(string str){
 notify_fail("Was willst Du trinken?\n");

 if(!str || str == "")  return 0;
 if(!(str == "wasser" ||
      str == "bruehe" )) return 0;

 write("Du nimmst einen kraeftigen Schluck von dem Wasser und\n"
       "fuehlst Dich danach so richtig mies.\n");

 say(TPN+" nimmt einen kraeftigen Schluck und laeuft gruen an.\n");
 this_player()->AddHp(-15);

 return 1;

}

int cmd_faden(string str){
 notify_fail("Was willst Du durchschneiden?\n");

 if(!str || str == "") return 0;
 if(!(str == "faden" ||
      str == "faden ab" ||
      str == "lebensfaden ab" ||
      str == "lebensfaden durch" ||      
      str == "faden durch" )) return 0;

 write("Du nimmst Deinen ganzen Mut zusammen und schneidest Deinen\n"
       "Lebensfaden durch.\n");

  call_out("player_die", 1);	
    
 
  return 1;      
}

  
player_die()
{
  if(!TP)
    return;
  write(BS(" "));
  TP->SetProp(P_KILLER, TO);
  SetProp(P_KILL_NAME, "Zu viel Mut");
  TP->SetProp(P_GHOST, 1);
  TP->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW|M_SILENT);
  TP->SetProp(P_KILLER, 1);
   
 say(TPN+" macht eine scherenartige Bewegung und faellt regungslos zu Boden.\n");

}

int cmd_bild(string str){
 notify_fail("Was willst Du betrachten?\n");

 if(!str || str == "") return 0;
 if(!(str == "muster" )) return 0;

 write("Du betrachtest das Muster und stellst fest, dass es sich nicht nur\n"
       "um ein Muster, sondern sogar um ein Bild handelt, welches Du sofort\n"
       "untersuchen solltest.\n");

 say(TPN+" starrt auf die Wand.\n");

 return 1;

}

int cmd_pickel(string str){
 notify_fail("Was willst Du ausdruecken?\n");

 if(!str || str == "") return 0;
 if(!(str == "pickel" ||
      str == "pickel aus" ||
      str == "pickel auf" )) return 0;

 write("Du ueberwindest Deinen Ekel und drueckst den eitrigen Pickel aus.\n"
       "Sofort bist Du voll mit saeureartigen Eiter bedeckt, und\n"
       "Schmerz durchzuckt Deinen ganzen Koerper.\n");

 say(TPN+" schreit vor Schmerzen auf, und ist verschwunden.\n");
 this_player()->AddHp(-30);
 TP->move(ROOM "brunnen_7", M_GO, "einfach weg");

 return 1;
 
} 
int cmd_ausgang(string str){
 notify_fail("Wohin willst Du klettern?\n");

 if(!str || str == "") return 0;
 if(!(str == "auf" ||
      str == "rauf" ||
      str == "nach oben" )) return 0;
 


 if( str == "rauf" || str == "auf" || str == "nach oben"){
 TP->move(ROOM "brunnen_3", M_GO, "nach oben", "klettert");
	       

 return 1;
}
}
	 

