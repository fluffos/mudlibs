#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

int anz=3;


#include <ansi.h>

#define BOXRING(wer) (member(boxring, capitalize(getuid(wer)))!=-1)
#define MyCountUp(arg) (sizeof(arg) > 1 ? \
        implode(arg[0..<2], ", ") + " und " + arg[<1] : \
        (sizeof(arg) == 0 ? "niemand" : arg[0]) )
        
string *boxring=({});
string rad1, rad2;
string detail_raeder();

int anwendungen;

void create()
{
::create();

  anwendungen = 2;
  rad1        = "seicherl";
  rad2        = "hell";

  SetProp( P_INT_SHORT, "In einer Trainingshalle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer grossen Trainingshalle. Am Boden siehst Du "
    "ein paar schlammige Fussspuren, und die Waende sind vollkommen mit "
    "Fackelhaltern besetzt. In der Mitte des Raumes befindet sich ein grosser "
    "Boxring. Um den Boxring sind einige Einrichtungsgegenstaende und "
    "Geraete verteilt. Alles in allem, hier herrscht kaum Ordnung.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festem Stein. Schlammige Fussspuren zeigen, dass "		
    "hier vor nicht all zu langer Zeit ein Mensch gewesen sein muss. Weiters "
    "liegen hier ueberall verschiedene Geraete herum." );
  AddSpecialDetail( ({ "boxring","ring" }),"boxring");
  AddDetail( ({ "narr"}),
    "Haettest Du einen Spiegel, der Narr wuerde Dich anlachen.");
  AddDetail( ({ "spiegel" }),
    "Schau genau!");
  AddDetail( ({ "decke" }),
    "Genau wie der Boden besteht die Decke aus Stein.");
  AddDetail( ( { "stein" }),
    "Fester stabiler Stein. Ganz duenne Fugen sind die einzige Abwechslung "
    "die Du hier finden kannst.");
  AddDetail( ( { "fussspuren" }),
    "Du bist Dir ganz sicher. Sie stammen auf jeden Fall von einem Menschen.");
  AddDetail( ( { "zeit" }),
    "Es kann noch nicht lange her sein. Vielleicht ist noch jemand da?");
  AddDetail( ({ "mensch", "menschen", "fall" }),
    "Ohne jeden Zweifel, es war ein Mensch!");
  AddDetail( ({ "zweifel" }),
    "Kein Zweifel, es war ein Mensch. Du schaetzt, dass er so circa zwei Meter "
    "gross gewesen sein muss.");
  AddDetail( ({ "meter" }),
    "Ziemlich gross. Vielleicht auch eine Nummer zu gross fuer Dich?");
  AddDetail( ( { "nummer" }),
    "Das wird sich noch weisen.");
  AddDetail( ({ "fugen","fuge" }),
    "Nein, hier ist kein Zaubertrank versteckt! Hier nicht, aber ganz sicher "
    "woanders!");
  AddDetail( ({ "zaubertrank" }),
    "Wie oft willst Du es noch hoeren? Hier ist kein Zaubertrank!");
  AddDetail( ({ "abwechslung" }),
    "Stein, Fuge, Stein, Fuge, Stein, Fuge, Stein und nochmals Fuge. Tolle "
    "Abwechslung, findest Du nicht?");
  AddDetail( ({ "trainingshalle", "halle", "raum", "raumes" }),
    "Es ist wirklich eine sehr grosse Halle. Ueberall liegen verschiedene "
    "Geraete herum, und um die Ordnung steht es hier auch nicht wirklich gut.");
  AddDetail( ({ "wand", "waende" }),
    "An den Waenden sind ueberall Fackelhalter, die die Halle im gruenen "
    "Licht erleuchten lassen. Eigentlich sind es die Fackeln, die in den "
    "Fackelhaltern stecken. Aber wer will denn hier, an diesem Ort, schon so "
    "genau sein?");
  AddDetail( ({ "ort" }),
    "Du stehst immer noch in einer Trainingshalle. Hast Du etwas anderes "
    "erwartet?");
  AddDetail( ({ "licht" }),
    "Das gruene Licht erleuchtet fast die gesamte Halle. Nur an einer Stelle "
    "an der Wand sind keine Fackelhalter angebracht.");
  AddDetail( ({ "fackelhalter", "halterung", "halterungen", "fackelhaltern" }),
    "Die Fackelhalter schmuecken fast die gesamte Wand. In den Halterungen "
    "stecken die Fackeln, die die Halle ausleuchten.");
  AddDetail( ({ "fackel", "fackeln" }),
    "Die Fackeln sorgen hier fuer die Beleuchtung in der Halle.");
  AddDetail( ({"beleuchtung" }),
    "Die Halle erstrahlt in einem unheimlichen, gruenen Licht. Alles wirkt "
    "hier sehr gespenstisch.");
  AddDetail( ({ "stelle" }),
    "An dieser Stelle der Wand sind wirklich keine Fackelhalter. Vielmehr ist "
    "hier eine Sprossenwand befestigt.");
  AddDetail( ({ "sprossenwand" }),
    "Die Sprossenwand ist fix an der Wand befestigt und sieht sehr stabil "
    "aus. Sicher kann man gut auf der Sprossenwand herumklettern.");
  AddDetail( ({ "sprossen", "sprosse" }),
    "Die Sprossen geben Dir perfekten Halt. Irgendwie hast Du Lust an "
    "einer Sprosse entlang zu streicheln.");
  AddDetail( ({ "halt" }),
    "Einfach perfekt.");
  AddDetail( ({ "lust" }),
    "Wenn Du Lust hast, mache es!");
  AddDetail( ({ "folterkammer", "gliedmasse", "gliedmassen"}),
    "Das ist nur eine Vision! Die kannst Du nicht weiter untersuchen!");
  AddDetail( ({ "leib", "fleisch", "mann"}),
    "Wie willst Du eine Vision untersuchen?");
  AddDetail( ({ "knochen" }),
    "Die Sprossen sind wirklich aus Knochen von Paladinen. Wer kann denn fuer "
    "so eine abscheuliche Tat verantwortlich sein?");
  AddDetail( ({"paladin", "paladine", "paladinen" }),
    "Die Paladine scheinen hier nicht wirklich beliebt zu sein.");
  AddDetail( ({ "tat" }),
    "Zum Glueck hattest Du nur eine Vision von dieser abscheulichen Tat. "
    "Manch Paladin hatte nicht so viel Glueck.");
  AddDetail( ({ "glueck" }),
    "Du hattest es, der Paladin nicht. So spielt das Leben.");
  AddDetail( ({ "leben" }),
    "Pass auf, dass Du es noch ein wenig behaeltst.");
  AddDetail( ({ "mitte" }),
    "Ja, genau dort steht der Boxring.");
  AddDetail( ({ "geraete" }),
    "Da gibt es doch einige davon. Rechts neben dem Schrank siehst Du "
    "einen Sandsack haengen und gleich daneben liegen ein paar "
    "Springschnuere. Gegenueber des Eingangs steht eine menschengrosse "
    "Strohpuppe, neben der einige Gewichtstangen am Boden liegen. Und um "
    "alles abzurunden, steht noch ein Punchingball im Raum.");
  AddDetail( ({ "gewichtstangen", "gewichtstange" }),
    "Du widmest Dich den Gewichtstangen und stellst fest, dass es wirklich "
    "verschiedene davon gibt. Jede der Gewichtstangen ist mit einem eigenen "
    "unterschiedlich schweren Gewicht bestueckt.");
  AddDetail( ({ "gewicht", "gewichte" }),
    "Die Gewichte sind an beiden Enden jeder Gewichtstange befestigt. "
    "Irgendwie ist das Aussehen der Gewichte seltsam.");
  AddDetail( ({ "enden" }),
    "Dort sind die Gewichte befestigt.");
  AddDetail( ({ "aussehen" }),
    "Bei Dusty! Du siehst, dass die Gewichte nichts anderes als Schaedel "
    "sind.");
  AddDetail( ({ "schaedel" }),
    "Du siehst Schaedel von Feen, Hobbits, Zwergen, Elfen, Menschen und "
    "Trollen. Aber warum gibt es keine Schaedel von Ogern oder Dunkelelfen?");
  AddDetail( ({ "oger", "ogerschaedel", "ogern" }),
    "Jetzt wird Dir klar warum hier keine Ogerschaedel zu finden sind. "
    "Oger stellen keine Paladine!");
  AddDetail( ({ "dunkelelfen", "dunkelelfe", "dunkelelfenschaedel" }),
    "Jetzt wird Dir klar warum hier keine Dunkelelfenschaedel zu finden sind. "
    "Dunkelelfen stellen keine Paladine!");		  
  AddDetail( ({ "troll", "trolle", "trollschaedel", "trollenschaedel",}),
    "Das ist ganz sicher die schwerste Gewichtstange. Wenn Du willst, "
    "kannst Du versuchen die Trollstange hochzuheben.");		  
  AddDetail( ({ "mensch", "menschen", "menschschaedel", "menschenschaedel" }),
    "Das ist ganz sicher eine schwere Gewichtstange. Wenn Du willst, "
    "kannst Du versuchen die Menschenstange hochzuheben.");		  
  AddDetail( ({ "elf", "elfen", "elfschaedel", "elfenschaedel" }),
    "Das ist ganz sicher eine mittelschwere Gewichtstange. Wenn Du willst, "
    "kannst Du versuchen die Elfenstange hochzuheben.");
  AddDetail( ({ "zwerg", "zwerge", "zwergschaedel", "zwergenschaedel" }),
    "Das ist ganz sicher eine mittelschwere Gewichtstange. Wenn Du willst, "
    "kannst Du versuchen die Zwergenstange hochzuheben.");
  AddDetail( ({ "hobbit", "hobbits", "hobbitschadel", "hobbitsschaedel" }),
    "Das ist ganz sicher eine leichte Gewichtstange. Wenn Du willst, "
    "kannst Du versuchen die Hobbitstange hochzuheben.");		  
  AddDetail( ({ "feen", "feenschaedel", "feeschaedel" }),
    "Das ist ganz sicher die leichteste aller Gewichtstangen. Wenn Du willst, "
    "kannst Du versuchen die Feenstange hochzuheben.");
  AddDetail( ({ "feenstange", "hobbitstange", "zwergenstange"}),
    "Sieht nicht sehr schwer aus! Hebe sie nur hoch wenn Du kannst.");
  AddDetail( ({ "elfenstange", "menschenstange", "trollstange"}),
    "Die sieht schon ein bisschen schwerer aus. Versuch sie hochzuheben!");
  AddDetail( ({ "punchingball", "ball" }),
    "Ein ganz normaler Punchingball, nur die Klingen die aus ihm herausragen "
    "machen Dich ein wenig nervoes. Auf den Punchingball schlagen kannst "
    "Du aber trotzdem.");
  AddDetail( ({ "klingen" }),
    "Die sehen verdammt scharf aus. Du beschliesst vorsichtig zu sein.");
  AddDetail( ({ "strohpuppe" }),
    "Komisch, diese Strohpuppe sieht doch tatsaechlich wie Ayla aus. "
    "Sie eignet sich bestimmt gut dafuer um auf sie einzustechen.");
  AddDetail( ({ "springschnuere"}),
    "Du widmest Dich den Springschnueren, beschliesst aber nach einigen "
    "Sekunden Dich doch auf eine einzige Springschnur zu konzentrieren.");
  AddDetail( ({ "sekunde", "sekunden" }),
    "Schon vorbei.");
  AddDetail( ({ "springschnur" }),
    "Irgendwie sieht diese Springschnur sehr glitschig aus. Vielleicht "
    "solltest Du sie einmal beruehren.");
  AddDetail( ({ "duenndarm" }),
    "Du wirfst den Duenndarm angewiedert weg.");
  AddDetail( ({ "hand" }),
    "Deine Hand fuehlt sich irgendwie fremd an. Nachdem was Du gerade darin "
    "gehalten hast ist das verstaendlich.");
  AddDetail( ({ "eingeweide" }),
    "Die liegen hier am Boden rum, welch Perversion!");
  AddDetail( ({ "perversion" }),
    "Anders kann man das auch nicht nennen!");
  AddDetail( ({ "sandsack" }),
    "Der Sandsack haengt hier einfach so herum. Das einzige, das Dir daran "
    "wirklich auffaellt, ist seine Rueckseite.");
  AddDetail( ({ "rueckseite" }),
    "Du drehst den Sandsack herum und studierst die Rueckseite. Da ist ja "
    "tatsaechlich ein Gesicht aufgemalt worden.");
  AddDetail( ({ "gesicht" }),
    "Sieht nicht nur aus wie Ayla, ist Ayla. Man kann bestimmt ganz toll "
    "auf den Sandsack boxen.");
  AddDetail( ({ "ayla" }),
    "Die maechtigste Streiterin des Guten.");
  AddDetail( ({ "streiterin" }),
    "Keiner ist ihr ueberlegen, zumindest keiner den Du kennst! Noch nicht "
    "kennst!");
  AddDetail( ({ "gute", "guten" }),
    "Dafuer kaempft Ayla.");
  AddDetail( ({ "eingang", "eingangs" }),
    "Von dort bist Du hereingekommen. Er ist gleichzeitig der Ausgang und "
    "fuehrt Dich gen Osten.");
  AddDetail( ({ "ausgang" }),
    "Eingang oder Ausgang? Ist das wirklich wichtig fuer Dich?");
  AddDetail( ({ "osten", "westen", "norden", "sueden" }),
    "Egal ob Norden, Osten, Sueden oder Westen, tote Seher sind die besten!");
  AddDetail( ({ "seher" }),
    "Willst Du auch einer der besten sein? Dann steige in den Boxring!");
  AddDetail( ({ "einrichtungsgegenstaende"}),
    "Davon gibt es hier einige. Neben dem Boxring ist ein Schrank. In "
    "einer Ecke des Raumes steht ein komisch aussehender Topf. Im Raum "
    "verstreut stehen auch noch einige Sachen. Alles in allem, ein heilloses "
    "Durcheinander.");
  AddDetail( ({ "ecke" }),
    "Dort steht ein Topf.");
  AddDetail( ({ "topf" }),
    "Eigentlich ist es gar kein Topf. Deiner Meinung nach handelt es sich "
    "ganz sicher um einen Spucknapf.");
  AddDetail( ({"meinung" }),
    "Ist Dir denn eine andere Meinung wichtig?");
  AddDetail( ({ "spucknapf" }),
    "Hat Dich der Spucknapf gerade angesehen? Nein, das kann gar nicht "
    "sein. Die Augen, die der Spucknapf hat, enthuellen, dass sie zu einem "
    "bereits leicht verfaulten Kopf gehoeren. Der verfaulte Kopf, den Du "
    "fuer einen Spucknapf gehalten hast, kann micht mehr schauen.");
  AddDetail( ({ "augen" }),
    "Leblose kalte Augen. Sie scheinen Dir bis in Deine Seele blicken zu "
    "koennen.");
  AddDetail( ({ "seele" }),
    "Bete, dass Du noch eine hast!");
  AddDetail( ({ "kopf" }),
    "Du untersuchst den verfaulten Kopf und kannst zwei Details entdecken, die "
    "Dir etwas sonderbar vorkommen.");
  AddDetail( ({ "detail", "details"}),
    "Erstens traegt der Kopf immer noch einen Helm. Und zweitens, steht der "
    "Mund des Kopfes weit offen, so als ob er schreien wollte.");
  AddDetail( ({ "mund" }),
    "Zu Deinem grossen Entsetzen, musst Du feststellen, dass Deine erste "
    "Annahme doch richtig war. Der Kopf ist tatsaechlich ein Spucknapf, "
    "nur spuckt man anscheinend in den geoeffneten Mund hinein. Wer kann "
    "denn nur so abscheulich brutal und daemonisch sein?");
  AddDetail( ({ "entsetzen" }),
    "Dein Herz schlaegt wie wild.");
  AddDetail( ({ "herz" }),
    "Noch schlaegt es!");
  AddDetail( ({ "annahme" }),
    "Dir waere es lieber gewesen, wenn Du Dich geirrt haettest.");
  AddDetail( ({ "helm" }),
    "Ein schwer beschaedigter Helm, ueber dem quer ein Spruch gemeiselt ist.");
  AddDetail( ({ "spruch" }),
    "Du liest: Dusty ist ueberall."); 
  AddDetail( ({ "schrank" }),
    "Eigentlich ist es gar kein Schrank, sonder eher ein Spind.");
  AddDetail( ({ "spind"}),
    "In dem geoeffneten Spind siehst Du einen verfaulten Kadaver.");
  AddDetail( ({ "kadaver" }),
    "Du betrachtest den leblosen Kadaver und langsam kommt Dir deine "
    "letzte Mahlzeit nach oben. Das einzige, durch den man diesen Kadaver "
    "noch identifizieren kann, ist der Waffenrock, den der Kadaver noch "
    "traegt.");
  AddDetail( ({ "mahlzeit" }),
    "Du denkst lieber nicht daran, sonst musst Du Dich wirklich noch "
    "uebergeben.");
  AddDetail( ({ "waffenrock" }),
    "Der Waffenrock ist in einem sehr schlechten Zustand. Nur die Inschrift "
    "auf ihm scheint dem Verfall zu trotzen.");
  AddDetail( ({ "zustand" }),
    "Bald wird nur noch Staub von ihm uebrig sein.");
  AddDetail( ({ "staub" }),
    "Staub zu Staub.");
  AddDetail( ({ "inschrift" }),
    "Du liest die Inschrift: Fuer Dusty bis in den Tod.");
  AddDetail( ({ "dusty", "tod" }),
    "Tja, Dusty und der Tod scheinen hier unten ein und das selbe zu bedeuten.");
  AddDetail( ({ "verfall" }),
    "Nur der Waffenrock scheint sich noch gegen den Verfall zu wehren.");
  AddDetail( ({ "sachen" }),
    "Du ueberfliegst die Sachen die es hier zu sehen gibt, und erkennst, "
    "dass hier kaum interessante Sachen zu finden sind. Du beschliesst "
    "daraufhin, Dich auf die anderen Einrichtungsgegenstaende zu konzentrieren.");
  AddDetail( ({ "durcheinander" }),
    "Wirklich ein heilloses Durcheinander. Hier herrscht wirklich keine "
    "Ordnung.");
  AddDetail( ({ "ordnung" }),
    "Wo Du auch hinblickst, ueberall nur Chaos.");
  AddDetail( ({ "chaos"}),
    "Chaos, Chaos, Chaos. Ueberall nur heilloses Durcheinander.");
  AddDetail( ({ "maschine" }),
    "Die Maschine hat irgendetwas animalisches an sich. Du kannst zwei Raeder "
    "und einen Hebel an der Maschine erkennen. Neben der Maschine kannst Du eine "
    "Anleitung erkennen.");
  AddDetail( ({ "anleitung" }),
    "Wie waere es mit lesen?");
  AddDetail( ({ "hebel" }),
    "Den Hebel kannst Du sicher ziehen!");
  AddDetail( ({ "raeder", "rad" }), #'detail_raeder);
  
 
  AddSmell( DEFAULT_SMELL,
    "Der Geruch von Blut und Schweiss liegt in der Luft." );
  AddSmell( ({ "geruch"}),
    "Es riecht eigenartig, irgendwie nach Angst.");
  AddSmell( ({ "angst" }),
    "Langsam ueberkommt Dich auch dieses Gefuehl der Angst.");
  AddSmell( ({ "gefuehl" }),
    "Wie willst Du das riechen?");
  AddSmell( ({ "luft" }),
     "Du riechst frisches Blut.");
  AddSmell( ({ "blut" }),
    "Es riecht wirklich nach frischem Blut.");
  AddSmell( ({ "schweiss" }),
    "Es stinkt!");
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur den Wind." );
  AddSound( ({ "wind"}),
    "Flieh Du Narr, solange Du noch kannst!");
  AddSound( ({ "narr" }),
    "Du redest eine bischen mit Dir selbst, und kommst Dir dabei sehr "
    "laecherlich vor.");
  
  
  AddExit( "osten",([EX_DEST:  ROOM "brunnen_5", EX_TESTFUNC: "cmd_richtung"]) );

  AddItem(OBJ "kerbentafel", REFRESH_REMOVE); 

  
  AddCmd( ({"kletter", "klettere" }), "cmd_wand" );
  AddCmd( ({"streichel", "streichle" }), "cmd_sprosse" );
  AddCmd( ({"box", "boxe" }), "cmd_sack" );
  AddCmd( ({"beruehr", "beruehre" }), "cmd_schnur" );
  AddCmd( ({"stech", "stich", "steche" }), "cmd_puppe" );
  AddCmd( ({"schlag", "schlage" }), "cmd_ball" );
  AddCmd( ({"hebe", "heb" }), "cmd_stange" );
  AddCmd( ({"spuck", "spucke" }), "cmd_topf" );
  AddCmd( ({"steig","steige", "betrete" }), "cmd_steig");
  AddCmd( ({"verlasse" }), "cmd_verlasse");
  AddCmd( ({"goto","home"}), "cmd_richtung");
  AddCmd( ({"lies", "lese"}), "cmd_anleitung");
  AddCmd( ({"dreh","drehe"}), "cmd_raeder");
  AddCmd( ({"zieh","ziehe"}), "cmd_hebel");

}

string detail_raeder()
{
  return "Da siehst Du zwei davon. Beide kann man drehen.\n"+
         "Das erste Rad steht auf \""+rad1+"\" und das zweite auf \""+rad2+"\".\n";
}

int cmd_anleitung(string str){
 notify_fail("Was willst Du lesen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "anleitung" ||
      str == "die anleitung" )) return 0;

 write(BS("Du liest die Anleitung und verstehst die Botschaft ohne Probleme. "
	  "Mit Hilfe der Raeder kannst Du einen Gegner waehlen, welcher sobald "
	  "Du den Hebel ziehst, im Boxring erscheint und sich Dir zum Kampf "
	  "stellt. Mit dem ersten Rad waehlst Du die Staerke des Gegners und "
	  "mit dem zweiten Rad waehlst Du die Art des Monsters aus. Folgende "
	  "Einstellungen gibt es:\n"));
 
 write("\n+---------------------------------------+\n"
       "|       Rad 1        |      Rad 2       |\n"
       "+---------------------------------------+\n"
       "|     seicherl       |      weich       |\n"
       "|   jungfraeulich    |      hart        |\n"
       "|   mittelmaessig    |      hell        |\n"
       "|    pow-wow-eh      |     dunkel       |\n"
       "|     woodysch       |      lieb        |\n"
       "|                    |      fies        |\n"
       "+---------------------------------------+\n");

 say(TPN+" studiert etwas.\n");
 
 return 1;
}

int cmd_sprosse(string str){
 notify_fail("An was willst Du entlang streicheln?\n");

 if(!str || str == "")  return 0;
 if(!(str == "an sprosse entlang" )) return 0;

 write(BS("Du streichelst an der Sprosse entlang, und ploetzlich stehst "
          "Du in einer Folterkammer, in der gerade ein Paladin gequaelt "
          "wird. Du siehst wie ihm gerade seine Gliedmassen bei lebendigem "
          "Leibe ausgerissen werden und sein Fleisch von den Knochen abgetrennt "
          "wird. Mit diesen Knochen wird dann von einem Mann eine "
          "schoene Sprossenwand gebaut. Genau die Sprossenwand, an der "
          "Du gerade herumturnst.\n"));

 say(TPN+" beginnt zu schlucken.\n");
 
 return 1;

}

int cmd_sack(string str){
 notify_fail("Auf was willst Du boxen?\n");

 if(!str || str == "") return 0;
 if(!(str == "auf sandsack" ||
      str == "auf sack" ||
      str == "auf den sack" ||
      str == "auf den sandsack" )) return 0;

 write(BS("Du nimmst Deine ganze Kraft und boxt mit voller Hingabe auf den Sandsack. "
	  "Mit tiefer Befriedigung stellst Du fest, dass das Gesicht auf dem "
	  "Sandsack einen schmerzverzehrten Ausdruck angenommen hat. Ayla weint! "
	  "Einen Applaus dem Ayla-Bezwinger!\n"));

 say(TPN+" boxt wie wild auf einen Sandsack.\n");
 TP->command_me("ruf Ich habe Ayla geschlagen und die kleine Memme weint!");
 return 1;

}

int cmd_schnur(string str){
 notify_fail("Was willst Du beruehren?\n");

 if(!str || str == "") return 0;
 if(!(str == "schnur" ||
      str == "die schnur" ||
      str == "die springschnur" ||
      str == "springschnur")) return 0;

 write(BS("Du beruehrst die Springschnur. Ploetzlich stehst Du in einer "
	  "Folterkammer in der gerade ein Paladin gequaelt wird. Du siehst, "
	  "wie ihm gerade seine Eingeweide bei lebendigem Leibe "
	  "herausgerissen werden, und sein Duenndarm fein saeuberlich "
	  "gereinigt wird. Dieser Duenndarm wird dann von einem Mann in eine "
          "Trainingshalle gebracht. Genau in die Trainingshalle, in der "
          "Du gerade stehst, mit dem Duenndarm eines Paladins in der Hand.\n"));

 say(TPN+" laeuft gruen an.\n");
 TP->command_me("ruf Ich halte die Eingeweide eines Paladins in meiner Hand! Helft mir!");
 
 return 1;

}

int cmd_puppe(string str){
 notify_fail("Auf was willst Du einstechen?\n");

 if(!str || str == "") return 0;
 if(!(str == "ayla" ||
      str == "auf ayla" ||
      str == "auf ayla ein" ||
      str == "auf puppe" ||
      str == "auf puppe ein" ||
      str == "auf strohpuppe" ||
      str == "auf strohpuppe ein" ||
      str == "puppe" ||
      str == "strohpuppe" )) return 0;

 write(BS("Mit grosser Begeisterung stichst Du wie wild auf die "
	  "Strohpuppe ein. Es macht richtig Spass auf Ayla einzustechen. "
	  "Tod der kleinen feigen Ayla!\n"));

 say(TPN+" sticht wie wild auf die Strohpuppe ein und lacht wie verrueckt.\n");
 TP->command_me("ruf Ich steche auf Ayla ein, und die feige Gurke kann sich nicht "
		"einmal wehren! Hahaha!");

 return 1;
 
} 
int cmd_wand(string str){
 notify_fail("Worauf willst Du herumklettern?\n");

 if(!str || str == "") return 0;
 if(!(str == "auf sprossenwand herum" ||
      str == "an sprossenwand herum" )) return 0;
 
write(BS("Du spuckst Dir zweimal in die Haende und beginnst an der "
         "Sprossenwand herumzuklettern. Wie herrlich ist es an dieser "
         "schoenen Sprossenwand zu turnen. Die Sprossen geben Dir den "
         "noetigen Halt und vermitteln Dir ein sicheres Gefuehl.\n"));

say(TPN+" turnt an einer Sprossenwand herum.\n");
	       

 return 1;
}

int cmd_ball(string str){
 notify_fail("Auf was willst Du schlagen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "punchingball" ||
      str == "ball" ||
      str == "auf punchingball" ||
      str == "auf den ball" ||
      str == "auf den punchingball" ||
      str == "auf ball" )) return 0;

 write(BS("Du holst mit Deiner ganzen Kraft aus und verpasst dem "
	  "Punchingball einen kraeftigen Schlag. Zufrieden siehst Du "
	  "wie der Punchingball sich von Dir wegbewegt, und dann mit "
	  "einer Klinge voran auf Dich zu! Oh Oh! Du schreist vor "
	  "Schmerz.\n"));

 say(TPN+" tobt sich am Punchingball aus, und schreit vor Schmerzen.\n");
 this_player()->AddHp(-27);
 TP->command_me("ruf Ich bin so ein ungeschickter Idiot! Kann mich bitte wer treten!");
 
 return 1;

}
	 
int cmd_stange(string str){
 string welche;
 notify_fail(BS("Welche Stange willst Du hochheben? Die Feenstange, die Hobbitstange, "
	        "die Zwergenstange, die Elfenstange, die Menschenstange oder die "
	        "Trollstange?\n"));
 
 if(!str) return 0; 
 welche="";
 if(sscanf(str, "%sstange hoch", welche) != 1) return 0;

 switch(welche)
 {
   case "feen": if(TP->QueryAttribute(A_STR)>5)
	        {
		  write("Du spannst Deine Muskeln an und hebst die Feenstange hoch.\n");
		  say(TPN+" hebt mit Leichtigkeit die Feenstange in die Hoehe.\n");
		  return 1;
		}
                  write(BS("Du kleines Seicherl bist einfach zu schwach fuer eine laecherliche "
		      "Feenstange!\n"));
                  say(BS(TPN+" bemueht sich sehr die Feenstange hochzuheben, ist aber viel zu "
		      "schwach dafuer. Welch ein Schwaechling!\n"));
		return -1;
                break;

   case "hobbit": if(TP->QueryAttribute(A_STR)>10)
	        {
		  write("Du spannst Deine Muskeln an und hebst die Hobbitstange hoch.\n");
		  say(TPN+" hebt mit Leichtigkeit die Hobbitstange in die Hoehe.\n");
		  return 1;
		}
                  write(BS("Du kleines Seicherl bist einfach zu schwach fuer eine laecherliche "
		      "Hobbitstange!\n"));
                  say(BS(TPN+" bemueht sich sehr die Hobbitstange hochzuheben, ist aber viel zu "
		      "schwach dafuer. Welch ein Schwaechling!\n"));
		return -1;
                break;

   case "zwergen": if(TP->QueryAttribute(A_STR)>15)
	        {
		  write("Du spannst Deine Muskeln an und hebst die Zwergenstange hoch.\n");
		  say(TPN+" hebt mit Leichtigkeit die Zwergenstange in die Hoehe.\n");
		  return 1;
		}
                  write(BS("Du kleines Seicherl bist einfach zu schwach fuer eine laecherliche "
		      "Zwergenstange!\n"));
                  say(BS(TPN+" bemueht sich sehr die Zwergenstange hochzuheben, ist aber viel zu "
		      "schwach dafuer. Welch ein Schwaechling!\n"));
		return -1;
                break;

   case "elfen": if(TP->QueryAttribute(A_STR)>20)
	        {
		  write("Du spannst Deine Muskeln an und hebst die Elfenstange hoch.\n");
		  say(TPN+" hebt mit Leichtigkeit die Elfenstange in die Hoehe.\n");
		  return 1;
		}
                  write(BS("Du kleines Seicherl bist einfach zu schwach fuer eine laecherliche "
		      "Elfenstange!\n"));
                  say(BS(TPN+" bemueht sich sehr die Elfenstange hochzuheben, ist aber viel zu "
		      "schwach dafuer. Welch ein Schwaechling!\n"));
		return -1;
                break;

   case "menschen": if(TP->QueryAttribute(A_STR)>25)
	        {
		  write("Du spannst Deine Muskeln an und hebst die Menschenstange hoch.\n");
		  say(TPN+" hebt mit Leichtigkeit die Menschenstange in die Hoehe.\n");
		  return 1;
		}
                  write(BS("Du kleines Seicherl bist einfach zu schwach fuer eine laecherliche "
		      "Menschenstange!\n"));
                  say(BS(TPN+" bemueht sich sehr die Menschenstange hochzuheben, ist aber viel zu "
		      "schwach dafuer. Welch ein Schwaechling!\n"));
		return -1;
                break;

   case "troll": if(TP->QueryAttribute(A_STR)>30)
	        {
		  write("Du spannst Deine Muskeln an und hebst die Trollstange hoch.\n");
		  say(TPN+" hebt mit Leichtigkeit die Trollstange in die Hoehe.\n");
		  return 1;
		}
                  write(BS("Du kleines Seicherl bist einfach zu schwach fuer eine laecherliche "
		      "Trollstange!\n"));
                  say(BS(TPN+" bemueht sich sehr die Trollstange hochzuheben, ist aber viel zu "
		      "schwach dafuer. Welch ein Schwaechling!\n"));
		return -1;
                break;

  default: write("Eine "+CAP(welche)+"stange gibt es nicht.\n");
	   return -1;
	   break;


 }
 return 1;

}

int cmd_topf(string str){
int old_align;
 notify_fail("In was wilst Du spucken?\n");

 if(!str || str == "")  return 0;
 if(!(str == "in mund" ||
      str == "in mund hinein" ||
      str == "in kopf" ||
      str == "in kopf hinein" ||
      str == "in topf" ||
      str == "in topf hinein" ||
      str == "in napf" ||
      str == "in napf hinein" ||
      str == "in spucknapf" ||
      str == "in spucknapf hinein" )) return 0;

 write(BS("Du sammelst Deine Spucke und spuckst mit voller Hingabe "
	  "in den Mund hinein. Was fuer ein herrliches Gefuehl dem "
	  "Toten so eine grosse Ehre angedeien zu lassen!\n"));

 say(TPN+" spuckt wild um sich.\n");
 
 if( anwendungen )
  {
     old_align=TP->QueryProp(P_ALIGN);
     if(old_align > -1000)
     {
     TP->SetProp(P_ALIGN, old_align-50);
     anwendungen--;
     }
  }
 return 1;

}
int cmd_steig(string str)

{
  notify_fail(BS("Willst Du etwa in den Boxring steigen oder ihn betreten?"));
  if(!(str == "in boxring"||
       str == "boxring" ||
       str == "ring" ||
       str == "in boxring hinein"||
       str == "in ring"||
       str == "in ring hinein"))
  {
    return 0;
  }
  if(BOXRING(TP))
  {
    write(BS("Du stehst ja schon im Boxring!"));
    return 1;
  }
  if(sizeof(boxring)>=1)
  {
    write(BS("Es darf nur einer im Boxring sein."));
    return 1;
  }
  write(BS("Du nimmst Deinen Mut zusammen und steigst in den "
	   "Boxring.\n"));
  tell_room(ENV(TP), TPN+" steigt in den Boxring.\n", ({TP}));
  boxring += ({ capitalize(getuid(TP)) });
  catch(present("\nhasibaerchi_ring_npc")->Kill(TP));
  return 1;
}

int cmd_richtung(string str)
{
  if(BOXRING(TP))
  {
     write(BS("Du stehst ja noch im Boxring, wie willst Du dann den Raum verlassen?\n"));
     return 0;
  }
  return 1;
}

int cmd_verlasse(string str)
{
   notify_fail(BS("Was willst Du verlassen?"));
   if(str == "boxring" ||
      str == "den boxring" ||
      str == "ring" ||
      str == "den ring")
   {
     if(BOXRING(TP))
     {
       write(BS("Du verlaesst den Boxring und stehst jetzt wieder ausserhalb."));
       tell_room(ENV(TP), TPN+" steigt aus dem Boxring.\n", ({TP}));
       boxring -= ({ capitalize(getuid(TP)) });
       return 1;
     }
  }      
  else 0;
}

void BecomesNetDead(object spieler)
{
  if(BOXRING(spieler))
  boxring -= ({ capitalize(getuid(spieler)) });
}

string boxring()
{
  string boxringinfo;
  if(BOXRING(TP))
  {
     boxringinfo =
     "Du stehst in einem Boxring. "+
     "Komisch, hier steht doch tatsaechlich eine Maschine! Du kannst sicher "
     "ganz leicht den Boxring wieder verlassen.";
  }
  else
  {
     boxringinfo =
     "Der steht in der Mitte des Raumes. Du kannst sicher ganz einfach in den "
     "Boxring steigen.";
  if(sizeof(boxring)==1 )
     boxringinfo += " Du siehst gerade " + boxring[0] + " in dem "
     		   "Boxring stehen.";
    
  //if(sizeof(boxring)>1 )
  //   boxringinfo += " Im Moment  " + MyCountUp(parkbank) + " auf der "
  //   		   "Parkbank zusammen.";
  }
  return break_string(boxringinfo, 78);
}

int cmd_raeder(string str)
{
  int num;
  string einst;
  einst="";
  notify_fail("Welches Rad willst Du denn worauf drehen?\n");
  if(!str) return 0;
  if(sscanf(str, "rad %d auf %s", num, einst) != 2) return 0;

  notify_fail("Du bist doch gar nicht im Ring.\n");
  if(!BOXRING(TP)) return 0;
  
  notify_fail("Die Einstellung "+CAP(einst)+" gibt es nicht.\n");
  if(!call_other(NPCM, "TestEinstellung", einst, num))  return 0;

  if(num == 1)
  {
    write("Du drehst das erste Rad auf "+einst+".\n");
    rad1=einst;
    return 1;
  }
  else if(num == 2)
  {
    write("Du drehst das zweite Rad auf "+einst+".\n");
    rad2=einst;
    return 1;
  }
  else
  {
    write("So ein Rad gibt es hier nicht.\n");
    return -1;
  }
}

int cmd_hebel(string str)
{
  notify_fail("Woran moechtest Du ziehen?\n");
  if(!str) return 0;
  if(!(str == "an hebel" ||
       str == "hebel"    )) return 0;
  notify_fail("Du bist doch gar nicht im Ring.\n");
  if(!BOXRING(TP)) return 0;
  if(anz<=0){
     write("Die magische Matrix des Rings ist im Moment ueberlastet.\n");
     return -1;
  }
  write("Du ziehst den Hebel...\n");
  say(TPN+" zieht den Hebel...\n");
  call_other(NPCM, "Case", rad1, rad2, TP);
  anz--;
 
  return 1;
}

/* Zum testen ob 'wer' im Boxring ist */
int RingFighter(object wer)
{
  if(BOXRING(wer)) return 1;
  return 0;
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(member(boxring, getuid(victim)))
  {
    say("Die Leiche von "+victim->name()+" faellt aus dem Ring.\n");
    boxring-=({capitalize(getuid(victim))});
  }
}

void reset ()

{
  ::reset ();

  if(sizeof(boxring))
   if (!present(boxring[0]))
    boxring=({});
    anz=3;
}
