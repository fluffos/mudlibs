//erstellt von hasibaerchi 12. raum



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "An der Spitze einer Pyramide" );
  SetProp( P_INT_LONG,
   "Du stehst auf der Spitze der Pyramide. Von hier oben hast Du einen "
   "wunderbaren Ueberblick ueber die gesamte Hoehle. Decke und Waende der "
   "Hoehle sind von hier oben gut zu erkennen. Genauso gut ist der See, der "
   "hier in seinen ganzen Pracht vor dir liegt, zu erkennen. Hier an der "
   "Spitze der Pyramide gibt es drei Statuen, die Deine Aufmerksamkeit auf "
   "sich lenken.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Du meinst sicher das Material, aus dem die Pyramide ist.");
  AddDetail( ({ "hoehle" }),
    "Einfach gewaltig diese Hoehle. Hier muessen wirklich die Goetter "
    "ihre Macht eingesetzt haben, um so ein Wunder zu schaffen.");
  AddDetail( ({ "goetter" }),
    "Nur sie allein haetten die Macht dazu.");
  AddDetail( ({ "wunder" }),
    "Hier fuehlst Du Dich klein und unbedeutend. Ob die Goetter das bezweckt "
    "haben?"); 
  AddDetail( ({ "macht" }),
    "Nie wird ein Sterblicher so eine Macht innehaben koennen. Niemals!");
  AddDetail( ({ "sterblicher" }),
    "Jemand wie Du ist gemeint.");
  AddDetail( ({ "ueberblick", "ausblick" }),
    "Du kannst wirklich die gesamte Hoehle erkennen, nur leider "
    "entdeckst Du keinen Ausgang.");
  AddDetail( ({ "ausgang" }),
     "Vielleicht ist er ueber der Decke der Hoehle.");
  AddDetail( ({ "wasser", "see" }),
    "Herrlich blau ist das Wasser. Du hast so richtig das Beduerfnis "
    "ins Wasser zu springen.");
  AddDetail( ({ "beduerfnis" }),
    "Na los, spring doch!");
  AddDetail( ({ "pracht" }),
    "Einfach wunderschoen anzusehen.");
  AddDetail( ({ "decke" }),
    "Auch die Decke besteht aus Fels. Ganz weit oben kannst Du das Loch "
    "erkennen, durch das Du hier herunter gekommen bist.");
  AddDetail( ({ "loch" }),
    "Dort kommst Du nie wieder hin. Du wirst hier unten verhungern "
    "muessen. Echt schade um Dich.");
  AddDetail( ({ "fels" }),
    "Einfacher grauer Fels. Mehr kannst Du von hier aus nicht darueber "
    "sagen.");
  AddDetail( ({ "statuen" }),
    "Du erkennst drei Statuen, die Statue eines Mannes, die Statue einer "
    "Frau und die Statue eines Kindes.");
  AddDetail( ({ "statue", "standbild" }),
    "Welche der drei Statuen meinst Du?");
  AddDetail( ({ "mannes", "mann" }),
    "Das linke Standbild stellt einen kraeftig gebauten, baertigen Mann "
    "dar. Er haelt in einer Hand eine Waage und in der anderen einen Blitz.");
  AddDetail( ({ "waage" }),
    "Die Waage ist ganz sicher ein Symbol fuer Gerechtigkeit.");
  AddDetail( ({ "symbol" }),
    "Ganz richtig, ein Symbol.");
  AddDetail( ({ "gerechtigkeit" }),
    "Vielleicht kann Dir Gerechtigkeit hier weiter helfen.");
  AddDetail( ({ "bart" }),
    "Irgendwie laed Dich der Bart ein ihn zu kraulen.");
  AddDetail( ({ "blitz" }),
    "Ein maechtiger Blitz. Du bist froh, dass er nicht auf Dich zufliegt, wobei "
    "Du trotzdem das Gefuehl hast, dass der Blitz auf Dich zeigt.");
  AddDetail( ({ "gefuehl" }),
    "Es ist nur so ein Gefuehl, aber um ganz sicher zu gehen, solltest Du "
    "vielleicht beiseite treten.");
  AddDetail( ({ "stelle" }),
    "Sind das dort etwa Umrisse?");
  AddDetail( ({ "umrisse" }),
    "Das kann nur eines bedeuten, die Umrisse gehoeren zu einer "
    "Geheimtuer.");
  AddDetail( ({ "geheimtuer", "tuer" }),
    "Na, was kann man mit einer Tuer machen?");
  AddDetail( ({ "mechanismus" }),
    "Irgendwie kann man diesen Mechanismus sicher oeffnen. Aber nur wie?");
  AddDetail( ({ "hand", "haende" }),
    "Davon gibt es hier mehrere.");
  AddDetail( ({ "frau" }),
    "Das rechte Standbild zeigt eine wunderschoene Frau, die in ihren "
    "Haenden eine Weizenaehre und ein Schwert haelt.");
  AddDetail( ({ "weizenaehre" }),
    "Dies symbolisiert sicher den Ackerbau oder die Ernte.");
  AddDetail( ({ "ackerbau", "ernte" }),
    "Sicher ist dies fuer Bauern sehr wichtig, nur hast Du keinen blassen "
    "Schimmer hast, wo hier unten Bauern sein sollen. Hier ist nur Wasser, "
    "Wasser und nochmals Wasser.");
  AddDetail( ({ "bauern", "bauer" }),
    "Wo soll man hier unten nur etwas anbauen koennen?");
  AddDetail( ({ "schimmer" }),
    "Den hast Du wirklich nicht!");
  AddDetail( ({ "schwert" }),
    "Anders als die Weizenaehre, die nach oben zeigt, haelt die Frau das "
    "Schwert mit der Schwertspitze nach unten.");
  AddDetail( ({ "schwertspitze" }),
    "Warum das so ist, ist Dir schleierhaft. Es wird aber sicher eine "
    "bestimmte Bedeutung haben.");
  AddDetail( ({ "bedeutung" }),
    "Du gruebelst ueber die Bedeutung, die das Schwert haben kann, ein wenig "
    "nach. Du kommst aber zu keinem Ergebnis.");
  AddDetail( ({ "ergebnis" }),
    "Vielleicht hilft Dir die Inschrift auf der Schwertklinge weiter!");
  AddDetail( ({ "schwertklinge", "klinge" }),
    "Jetzt wo Du die Schwertklinge naeher betrachtest, faellt Dir auf, dass "
    "die Klinge eine ungewoehnliche Farbe hat.");
  AddDetail( ({ "farbe" }),
    "Es ist die Farbe der Sonne.");
  AddDetail( ({ "sonne" }),
    "Das ist sicher nur symbolisch zu verstehen.");
  AddDetail( ({ "inschrift" }),
    "Leider verstehst Du die Sprache nicht! Vielleicht kann Dir jemand "
    "helfen, die Inschrift zu uebersetzen. Wo nur dieser Jemand ist?");
  AddDetail( ({ "sprache" }),
    "Diese Sprache muss sehr alt sein. Es muesste schon jemand sehr alt "
    "sein, um diese Sprache lesen zu koennen.");
  AddDetail( ({ "jemand" }),
    "Wer koennte denn so alt sein, um so eine alte Sprache uebersetzen?");
  AddDetail( ({ "kind", "kindes" }),
    "Die mittlere Statue hat die Gestalt eines gefluegelten Kindes. Um "
    "dessen Leib winden sich zwei Schlangen. In der einen Hand haelt das "
    "Kind einen Stab und in der anderen Hand ein paar Muenzen.");
  AddDetail( ({ "gestalt" }),
    "Du bist Dir ganz sicher, das ist ein Kind.");
  AddDetail( ({ "stab", "zauberstab" }),
    "Das ist sicher ein Zauberstab.");
  AddDetail( ({ "muenzen" }),
    "Die sind ein fixer Teil der Statue. Also, nix mit stehlen!");
  AddDetail( ({ "teil" }),
    "Sie gehoeren einfach zur Statue. Und aus!");
  AddDetail( ({ "schlangen" }),
    "Die Schlangen sind sicher ein Symbol.");
  AddDetail( ({ "symbol" }),
    "Ein Symbol fuer Schlaeue, Intelligenz und Gerissenheit.");
  AddDetail( ({ "schlaeue"}),
    "Wer schlau ist, lebt laenger.");
  AddDetail( ({ "intelligenz" }),
    "Aehm, ... gruebel. Nix fuer Dich.");
  AddDetail( ({ "gerissenheit" }),
    "Tja, nicht jeder ist gerissen. Bist Du es?");
  AddDetail( ({ "leib", "koerper" }),
    "Einen gesunden runden Koerper hat das Kind. Seine Fluegel verleihen "
    "ihm eine gewisse Eleganz.");
  AddDetail( ({ "eleganz" }),
    "Wie wunderbar, einfach schoen.");
  AddDetail( ({ "fluegel" }),
    "Du beneidest das Kind um seine maechtigen Fluegel. Sie lassen es "
    "sogar groesser erscheinen als die beiden anderen Statuen.");
  AddDetail( ({ "wand", "waende" }),
    "Du erkennst, dass die Waende aus grauem Fels bestehen. Mehr kannst "
    "Du nicht erkennen, da Du zu weit weg bist. Vielleicht kann man "
    "irgendwie naeher an die Waende herankommen?");
  AddDetail( ({ "spitze" }),
    "Du stehst ganz oben, hoeher geht es nun wirklich nicht mehr. "
    "Der Ausblick war auf jeden Fall die Muehe wert.");
  AddDetail( ({ "aufmerksamkeit" }),
    "Die Statuen faszinieren Dich. Wirst Du ihr Geheimnis lueften koennen?");
  AddDetail( ({ "geheimnis" }),
    "Wie wirst Du das nur loesen?");
  AddDetail( ({ "fall", "muehe" }),
    "Ohne Zweifel, war der Aufstieg die Muehe wert.");
  AddDetail( ({ "zweifel" }),
    "Du bist Dir da ganz sicher.");
  AddDetail( ({ "aufstieg" }),
    "So anstrengend war er doch auch nicht.");
  AddDetail( ({ "stufenpyramide", "pyramide" }),
    "Ein beeindruckendes Bauwerk. Wer auch immer diese Pyramide vor "
    "Urzeiten gebaut haben mag, muss ueber riesiges Wissen verfuegt "
    "haben.");
  AddDetail( ({ "wissen" }),
    "Dieses Wissen haettest Du gern, Deine Macht wuerde dadurch gigantisch "
    "sein. Niemand koennte Dich besiegen.");
  AddDetail( ({ "macht" }),
    "Bald wird sie Dein sein, wenn Du lange genug am Leben bleibst.");
  AddDetail( ({ "lebe" }),
    "Noch lebst Du.");
  AddDetail( ({ "urzeiten" }),
    "Es ist verdammt lange her. Du hast nur keine Ahnung wie lange die "
    "Pyramide schon hier existiert.");
  AddDetail( ({ "ahnung" }),
    "Wirklich keine.");
  AddDetail( ({ "bauwerk" }),
    "Wirklich beeindruckend. Du kommst aus dem Staunen nicht mehr heraus.");
  AddDetail( ({ "staunen" }),
    "Die Pyramide ist einfach unbeschreiblich.");
  AddDetail( ({ "material" }),
    "Das Material ist auf jedenfall steinhart. Wie sollte es denn auch "
    "sonst sein? Schliesslich ist es Stein.");
  AddDetail( ({ "stein" }),
    "Einfach pechschwarzer Stein, glatt und hart.");
  AddDetail( ({ "leid" }),
    "Suchst Du etwa Leid?");
  AddDetail( ({ "koenigin", "tod"}),
    "Das findest Du nicht hier.");
  AddDetail( ({ "leben"}),
    "Marighella meint immer, dass das Leben so wunderbar ist.");
  AddDetail( ({ "marighella" }),
    "Tja, schau Dir lieber das Bauwerk an!");
  
 
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischem Salzwasser." );
  AddSmell( ({ "salzwasser"}),
    "Es muss das Meer sein.");
  AddSmell( ({ "meer" }),
    "Das kann nur bedeuten das der See einen Zugang zum "
    "Meer haben muss.");
  AddSmell( ({ "see" }),
    "Herrlich angenehm.");
  AddSmell( ({ "zugang" }),
    "Wie willst Du das riechen?");
 
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Rauschen." );
  AddSound( ({ "rauschen"}),
    "Es sind sicher die Wellen, die gegen die Pyramide schwappen.");
  AddSound( ({ "wellen" }),
    "Schwapp!");
  AddSound( ({ "pyramide" }),
    "Net wirklich.");
  
    
  AddExit( "runter", ROOM "brunnen_12" );
  
  
AddCmd( ({"springe", "springe" }), "cmd_wasser" );
AddCmd( ({"kraul", "kraule" }), "cmd_bart" );
AddCmd( ({"tritt", "trete" }), "cmd_seite" );
AddCmd( ({"oeffne" }), "cmd_tuer" );
AddCmd( ({"such", "suche" }), "cmd_leid" );

}

int cmd_leid(string str){
 notify_fail("Was suchst Du?\n");

 if(!str || str == "")  return 0;
 if(!(str == "leid" ||
      str == "das leid" )) return 0;

 write("Dort wo die Koenigin, Tod.\n");

 return 1;

}

int cmd_wasser(string str){
 notify_fail("Wohin willst Du springen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "in wasser" ||
      str == "in see" )) return 0;

 write("Du nimmst Anlauf und hechtest in die Fluten.\n");

 say(TPN+" springt in den See.\n");
 TP->move(ROOM "brunnen_16", M_GO, "in den Fluten");
 return 1;

}

int cmd_tuer(string str){
 notify_fail("Was willst Du oeffnen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "tuer" ||
      str == "die tuer" ||
      str == "mechanismus" ||
      str == "den mechanismus" ||
      str == "die geheimtuer" ||
      str == "geheimtuer" )) return 0;

 write(BS("Du versuchst die Geheimtuer zu oeffnen, schaffst es aber nicht. "
	  "Irgendwie scheint der Mechanismus der Geheimtuer so nicht zu "
	  "oeffnen zu sein.\n"));

 say(TPN+" begutachtet die Pyramide.\n");
 return 1;

}

int cmd_bart(string str){
 notify_fail("Was willst Du kraulen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "bart" ||
      str == "den bart" )) return 0;

 write(BS("Du beginnst den Bart der Statue zu kraulen, und hast sofort "
	  "das Gefuehl irgendetwas richtiges gemacht zu haben.\n"));

 say(TPN+" betastet eine Statue.\n");
 return 1;

}

int cmd_seite(string str){
 notify_fail("Wohin willst Du treten?\n");

 if(!str || str == "")  return 0;
 if(!(str == "beiseite" ||
      str == "zur seite" ||
      str == "auf die seite" )) return 0;

 write(BS("Du trittst beiseite und stellst voller Erleichterung fest, dass "
	  "der Blitz wirklich nicht auf Dich zeigt, sondern auf eine bestimmte "
	  "Stelle der Pyramide.\n"));

 say(TPN+" huepft herum.\n");
 return 1;

}
