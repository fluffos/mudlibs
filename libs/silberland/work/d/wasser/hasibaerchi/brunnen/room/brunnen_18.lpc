//erstellt von hasibaerchi 



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "Im Raum des Todes" );
  SetProp( P_INT_LONG,
  "Du stehst hier in einem Raum wo es keinen Ausgang gibt. Der Boden "
  "ist schwarz, wie auch die Waende. Es gibt hier nur einen Thron.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -35, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Nur schwarz.");
  AddDetail( ({ "wand", "waende" }),
    "Auch die Waende sind einfach nur schwarz. Bis auf den Thron gibt es "
    "keine Einrichtungsgegenstaende hier. Ansonsten ist der Raum leer.");
  AddDetail( ({ "decke" }),
    "Auch die Decke ist einfach nur schwarz.");
  AddDetail( ({ "einrichtungsgegenstaende" }),
    "Bis auf den Thron sind keine vorhanden.");
  AddDetail( ({ "raum" }),
    "Hier ist ein guter Raum um zu sterben.");
  AddDetail( ({ "ausgang", "ausgaenge" }),
    "Es gibt keine!");
  AddDetail( ({ "thron" }),
    "Ein schwarzen Thron, welcher nicht fuer Dich bestimmt ist.");
  AddDetail( ({ "kirche" }),
    "Was macht man in einer Kirche?"); 
  
    
  AddSmell( DEFAULT_SMELL,
    "Du riechst nur Deinen eigenen Angstschweiss und den Tod." );
  AddSmell( ({ "angstschweiss", "schweiss"}),
    "Nicht sehr angenehm, Du stinkst!");
  AddSmell( ({ "tod" }),
    "Bald wirst Du ihn finden.");
  
  
  AddSound( DEFAULT_SOUND,
    "Stille." );
  AddSound( ({ "stille"}),
    "Todesstille. Wie in einer Kirche.");
  AddSound( ({ "kirche" }),
    "Stille.");
  

  
  AddItem(NPC "soth",  REFRESH_DESTRUCT);

  

AddCmd( ({"bete" }), "cmd_soth" );


}

int cmd_soth(string str){
 notify_fail("Zu wem willst Du beten?\n");
 if(!str || str == "")  return 0;
 if(!(str == "zu dusty" ||
      str == "zu woody" ||
      str == "zu kapaneus" )) return 0;

  if( str == "zu dusty"){
 TP->move("/gilden/paladine", M_GO, "ins andere Reich");
	       

 return 1;
} 

 if( str == "zu woody"){
 TP->move("/gilden/abenteurer", M_GO, "ins andere Reich");
	       

 return 1;
} 

 if( str == "zu kapaneus"){
 TP->move(ROOM "brunnen_9", M_GO, "ins andere Reich");
	       

 return 1;
}
}


