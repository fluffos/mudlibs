//erstellt von hasibaerchi pyramide



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "In der Mitte einer Pyramide" );
  SetProp( P_INT_LONG,
   "Du schwebst in der Mitte einer gewaltigen Pyramide. Du hast keine "
   "Ahnung wie oder warum Du hier schweben kannst, es ist einfach nur ein "
   "unbeschreibliches Gefuehl. Normalerweise muesste es hier drinnen "
   "ganz finster sein, aber die Runen die hier alle Waende der Pyramide "
   "verzieren leuchten in einem goldenen Licht und reflektieren sich in "
   "einem ovalen Portal, das neben Dir zu schweben scheint.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Auch auf dem Boden, der sicher mehr als hundert Meter unter Dir ist, "
    "siehst Du Runen leuchten. Wer die Runen hier alle angebracht hat, und "
    "vorallem warum kannst Du nicht sagen? Es bleibt ein Geheimnis.");
  AddDetail( ({"wand", "waende" }),
    "Runen so weit Dein Auge reicht. Du musst richtig aufpassen, dass "
    "Dir nicht schwindlig wird.");
  AddDetail( ({ "portal" }),
    "Es schwebt neben Dir. Du kannst sicher ohne Probleme versuchen durch "
    "das Portal zu schweben, ob dies aber eine gute Idee ist, wagst Du "
    "zu bezweifeln.");
  AddDetail( ({ "rune", "runen" }),
    "Die ganze Pyramide ist mit Runen verziert. Eine gewaltiges Kunstwerk "
    "wurde hier geschaffen. Dir wird es immer ein Raetsel bleiben wie "
    "die Runen hier eingemeiselt wurden.");
  AddDetail( ({ "raetsel" }),
    "Um das Raetsel zu loesen, musst Du Dich sicher etwas mit den Runen "
    "beschaeftigen. Aber halt! Was ist das? Dir war so als ob ein Teil "
    "der Runen ein Bild darstellen.");
  AddDetail( ({ "teil" }),
    "Ja genau, da wird wiklich ein Bild dargestellt!");
  AddDetail( ({ "bild" }),
    "Wenn es nicht so klar waere muesstest Du grinsen. Das Bild stellt "
    "einen kleinen suessen Drachen dar der die Runen eingraviert.");
  AddDetail( ({ "drache" }),
    "Vielleicht kann er Dir helfen.");
  AddDetail( ({ "kunstwerk" }),
    "Wirklich einmalig, so etwas gibt es im ganzen Silberland sicher nicht "
    "noch einmal.");
  AddDetail( ({ "silberland" }),
    "Da bist Du Dir ganz sicher, einfach einmalig.");
  AddDetail( ({ "probleme" }),
    "Es geht sicher ganz leicht. Aber nachdem Du ja an Deinem Leben "
    "haengst, solltest Du vielleicht doch noch ein bischen warten.");
  AddDetail( ({ "leben" }),
    "Wirf es nicht leichtfertig weg, Du hast nur ein Leben!");
  AddDetail( ({ "idee" }),
    "Sicher ist nur, dass Du den Tod finden wirst, wenn Du so "
    "weiter machst.");
  AddDetail( ({ "tod" }),
    "Den kennst Du schon ziemlich gut, gut genug wie Du meinst.");
  AddDetail( ({ "pyramide" }),
    "Sie ist wirklich gewaltig. Wer auch immer die Pyramide geschaffen "
    "hat, muss ueber gewaltiges Wissen verfuegt haben.");
  AddDetail( ({ "wissen" }),
    "Wie koennte man an dieses Wissen kommen?");
  AddDetail( ({ "auge" }),
    "Dein Auge reicht wirklich weit, und ueberall nur Runen, Runen und "
    "nochmals Runen.");
  AddDetail( ({ "decke" }),
    "Auch auf der Decke, die sicher mehr als hundert Meter ober Dir ist, "
    "siehst Du Runen leuchten. Wer die Runen hier alle angebracht hat, und "
    "vorallem warum kannst Du nicht sagen? Es bleibt ein Geheimnis.");
  AddDetail( ({ "mitte" }),
    "Zentrum waere das bessere Wort. Recht und links von Dir Runen, ober "
    "und unter Dir auch Runen, ueberall Runen. Runen Runen und nochmals Runen.");
  AddDetail( ({ "wort" }),
    "Ob Zentrum oder Mitte, Du verstehst auf jeden Fall was gemeint ist.");
  AddDetail( ({ "fall" }),
    "Ganz sicher sogar, da gibt es gar keinen Zweifel.");
  AddDetail( ({ "zweifel" }),
    "Aber gar keinen!");
  AddDetail( ({ "zentrum" }),
    "Genau hier im Zentrum der Pyramide schwebst Du.");
  AddDetail( ({ "meter"}),
    "Ja, hier geht es ganz schoen weit hinunter.");
  AddDetail( ({ "Ahnung" }),
    "Die hast Du wirklich nicht! Vielleicht waere es besser wenn Du einfach "
    "hier verschwindest. Aber nur wie?");
  AddDetail( ({"gefuehl" }),
    "Es ist einfach unbeschreiblich. Du fuehlst Dich wie ein junger Gott. "
    "Mitten in einem Tempel aus Licht, dessen Macht Dich durchstroemt, und "
    "niemand ist hier um an Deiner Macht zu ruetteln.");
  AddDetail( ({"licht" }),
    "Verdammt hell einfach, voller Macht und Glanz.");
  AddDetail( ({ "glanz" }),
    "Sehr hell!");
  AddDetail( ({ "tempel" }),
    "Du bist Dir ganz sicher nicht in einem Tempel zu sein, aber das Gefuehl "
    "ist trotzdem noch in Dir. Was ist aber der Grund der Existenz dieser "
    "Pyramide? Wirst Du es jemals herausfinden?");
  AddDetail( ({ "existenz" }),
    "Vielleicht erfaehrst Du den Grund wenn Du Dich ein wenig mit den Runen "
    "befasst.");
  AddDetail( ({ "grund" }),
    "Die Runen helfen Dir sicher dabei.");
  AddDetail( ({ "macht" }),
    "Ein wahnsinnig gutes Gefuehl. Es durchdringt Dich umgibt Dich, es laesst "
    "Dich wachsen, es laesst Dich eins werden mit Dir selbst.");
  AddDetail( ({ "gott", "woody" }),
    "Es ist zwar ein bischen blasphemisch aber du fuehlst Dich wirklich wie "
    "ein junger Gott. Lass dies blos Woody nicht wissen.");
  AddDetail( ({ "einsamkeit"}),
    "Es ist so, als ob hier seit Ewigkeiten kein Lebender mehr war.");
  AddDetail( ({ "ewigkeiten" }),
    "Das ist wirklich verdammt lange her!");
  AddDetail( ({ "lebender" }),
    "Sicher auch kein Toter.");
  AddDetail( ({ "toter" }),
    "Ganz sicher sogar!");
  AddDetail( ({ "geheimnis" }),
    "Welches es zu loesen gilt.");
  AddDetail( ({ "kauderwaelsch", "abcdefghijklmnopqrstuvwxyz" }),
    "Vielleicht kann dieses Kauderwaelsch wirklich jemand uebersetzen.");
  AddDetail( ({ "koerper" }),
    "Alles noch dran, zwar schwerelos aber dran.");
  AddDetail( ({ "nachricht" }),
    "Du untersuchtst die Nachricht, und stellst fest, dass es dir "
    "sicher leichter fallen wird die Nachricht zu entschluesseln, "
    "wenn du sie liest.");
 
 
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Einsamkeit und Leere." );
  AddSmell( ({ "einsamkeit"}),
    "Wie willst Du das riechen?");
  AddSmell( ({"leere" }),
    "Du riechst nur Deinen eigenen Angstschweiss.");
  AddSmell( ({ "angstschweiss", "schweiss" }),
    "Langsam beginnst Du gruen anzulaufen, so herrlich riecht Dein Koerper.");
  AddSmell( ({ "koerper" }),
    "Pfui!");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das Pochen Deines Herzens." );
  AddSound( ({ "pochen", "herz", "herzen"}),
    "Poch poch, poch poch. Es schlaegt!");
  
     
    
AddCmd( ({"schweb", "schwebe" }), "cmd_portal" );
AddCmd( ({"beschaeftig", "beschaeftige" }), "cmd_rune" );
AddCmd( ({"lese", "lies" }), "cmd_nachricht" );
AddCmd( ({"sag", "sprich", "sage" }), "cmd_dark" );

}

int cmd_dark(string str){
 notify_fail("Was willst Du sagen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "sommerswerd" )) return 0;

 write(BS("Mit ein bischen Angst in Deiner Stimme sprichst Du "
	  "das Wort Sommerswerd, und merkst sofort einen gewaltigen "
	  "Luftzug der Dich ins Portal zu ziehen scheint. Du hast keine "
	  "Chance Dich dem gewaltigen Ziehen zu wehren und ergibts "
	  "Dich Deinem Schicksal.\n"));

 say(TPN+" wird durch das Portal gezogen.\n");
 TP->move(ROOM "dark_1", M_GO, "durch das Portal");
 return 1;
}

int cmd_portal(string str){
 notify_fail("Wodurch willst Du schweben?\n");

 if(!str || str == "")  return 0;
 if(!(str == "in portal" ||
      str == "durch portal" ||
      str == "durchs portal" ||
      str == "durch portal hindurch" ||
      str == "durch das portal" )) return 0;

 write(BS("Du schwebst auf das Portal zu, und merkst, dass die "
       "Runen zu leuchten beginnen. Als Du durch das Portal schwebst "
       "siehst Du nur ein weisses Licht und fuehlst graesslcihen "
       "Schmerz.\n"));

 say(TPN+" schwebt mit schmerzverzehrtem Gesicht durch das Portal.\n");
 this_player()->AddHp(-95);
 TP->move(ROOM "brunnen_13", M_GO, "durch das Portal");
 return 1;

}

int cmd_rune(string str){
 notify_fail("Mit was willst Du Dich beschaeftigen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "runen" ||
      str == "mit den runen" ||
      str == "mich mit runen" ||
      str == "mich mit den runen" ||
      str == "mit runen" )) return 0;

 write(BS("Du beschaeftigs eingehend mit den Runen und kannst "
	  "tatsaechlich eine Nachricht ausmachen.\n"));

 say(TPN+" schaut auf die Waende.\n");
 return 1;

}

int cmd_nachricht(string str){
 notify_fail("Was willst du lesen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "nachricht" ||
      str == "die nachricht" )) return 0;

 write(BS("Du tapferer Narr, der mehr Mut als Verstand haben muss um dieses "
	  "Portal betreten zu wollen. Wisse dies, dass Dich auf der anderen Seite "
	  "der Tod erwarten wird. Lasse ab von Deinem Vorhaben! Wirf Dein "
	  "Leben nicht sinnlos weg. Solltest Du doch so verwegen sein und "
	  "durch das Portal wollen, so sprich ....... Ab hier macht der Text "
	  "keinen Sinn mehr. Es siehst nur mehr aus wie, abcdefghijklmnopqrstuvwxyz "
	  "aus. Vielleicht kann jemand dieses Kauderwaelsch uebersetzen!\n"));

 say(TPN+" denkt.\n");
 return 1;

}
