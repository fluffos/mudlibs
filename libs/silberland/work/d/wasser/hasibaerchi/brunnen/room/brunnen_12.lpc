//erstellt von hasibaerchi 12. raum



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "Am Fuss einer Pyramide" );
  SetProp( P_INT_LONG,
   "Vor Dir ragt eine Stufenpyramide, mit fuenf stufenweise abgesetzten "
   "Etagen, empor. Die Stufen haben zirka eine Hoehe von sechs Metern und "
   "an der Spitze der Pyramide kannst Du drei Statuen erkennen. An einer "
   "Seite der Pyramide fuehrt eine Rampe bis zur Spitze hinauf. Rund um "
   "die Pyramide herum ist nur Wasser.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Du meinst sicher das Material aus dem die Pyramide besteht.");
  AddDetail( ({ "stufenpyramide", "pyramide" }),
    "Ein beeindruckendes Bauwerk. Wer auch immer diese Pyramide vor "
    "Urzeiten gebaut haben mag, muss ueber grosses Wissen verfuegt "
    "haben.");
  AddDetail( ({ "wissen" }),
    "Dieses Wissen haettest Du gerne. Deine Macht wuerde dadurch gigantisch "
    "sein. Niemand koennte Dich besiegen.");
  AddDetail( ({ "macht" }),
    "Bald wird sie Dein sein, wenn Du lange genug am Leben bleibst.");
  AddDetail( ({ "leben" }),
    "Noch lebst Du.");
  AddDetail( ({ "urzeiten" }),
    "Es ist verdammt lange her. Du hast nur keine Ahnung, wie lange die "
    "Pyramide schon hier existiert.");
  AddDetail( ({ "ahnung" }),
    "Wirklich keine.");
  AddDetail( ({ "seite" }),
    "Dort ist eine Rampe.");
  AddDetail( ({ "bauwerk" }),
    "Wirklich beeindruckend. Du kommst aus dem Staunen nicht mehr heraus.");
  AddDetail( ({ "staunen" }),
    "Die Pyramide ist einfach unbeschreiblich.");
  AddDetail( ({ "material" }),
    "Das Material ist auf jeden Fall steinhart. Wie sollte es denn auch "
    "sonst sein? Schliesslich ist es Stein.");
  AddDetail( ({ "fall", "faelle" }),
    "Davon gibt es vier Faelle.");
  AddDetail( ({ "stein" }),
    "Einfach pechschwarzer Stein. Glatt und hart.");
  AddDetail( ({ "etagen", "etage" }),
    "Wie gesagt, es sind fuenf!");
  AddDetail( ({ "stufen", "stufe" }),
    "Die sind einfach zu gross, um ueber sie nach oben zu kommen.");
  AddDetail( ({ "hoehe" }),
    "Einfach zu hoch fuer Dich.");
  AddDetail( ({ "meter", "metern" }),
    "Um auf einen Meter zu kommen, nehme man zwei Feen und stecke sie "
    "zusammen.");
  AddDetail( ({ "fee", "feen" }),
    "Zwei ergeben einen Meter.");
  AddDetail( ({ "spitze" }),
    "An der Spitze der Pyramide kannst Du drei Statuen erkennen.");
  AddDetail( ({ "statuen" }),
    "Genau kannst Du sie nicht erkennen. Vielleicht waere es besser auf "
    "die Spitze der Pyramide zu steigen.");
  AddDetail( ({ "decke" }),
    "Du kannst die Decke der Hoehle nicht erkennen, da diese in viel zu "
    "grosser Hoehe liegt.");
  AddDetail( ({ "hoehe" }),
    "Sehr hoch!");
  AddDetail( ({ "hoehle" }),
    "Sie ist gigantisch. Du kannst weder Decke noch Waende erkennen.");
  AddDetail( ({ "wand", "waende" }),
    "Sie sind viel zu weit weg um sie zu erkennen, aber irgendwie kannst "
    "du sicher naeher an die Waende kommen.");
  AddDetail( ({ "rampe" }),
    "Auch die Rampe ist aus dem schwarzen Stein. Auf ihr kannst Du nach oben "
    "gelangen.");
  AddDetail( ({ "wasser", "salzwasser" }),
    "Der See umgibt die ganze Pyramide. Kleine Wellen kraeuseln sich an der "
    "Oberflaeche.");
  AddDetail ( ({ "see" }),
     "Wunderschoenes blaues Wasser.");
  AddDetail( ({ "wellen" }),
    "Einfach wunderschoen die Wellen so zu beobachten. Eigentlich solltest Du "
    "ein bisschen baden gehen und das Wasser so richtig geniesen.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche glitzert in wunderschoenen Farben.");
  AddDetail( ({ "meer" }),
    "Hier ist es nicht.");
  AddDetail( ({ "farben" }),
    "Einfach nur schoen."); 
  AddDetail( ({ "zugang" }),
    "Wo auch immer er ist, hier ist er nicht!"); 
  
 
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischem Salzwasser." );
  AddSmell( ({ "salzwasser"}),
    "Es muss das Meer sein.");
  AddSmell( ({ "meer" }),
    "Das kann nur bedeuten das der See einen Zugang zum "
    "Meer haben muss.");
  AddSmell( ({ "see" }),
    "Herrlich angenehm.");
  AddSmell( ({ "zugang" }),
    "Wie willst Du das riechen?");
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Rauschen." );
  AddSound( ({ "rauschen"}),
    "Es sind sicher die Wellen, die gegen die Pyramide schwappen.");
  AddSound( ({ "wellen" }),
    "Schwapp!");
  AddSound( ({ "pyramide" }),
    "Net wirklich.");
    
  AddExit( "rauf", ROOM "brunnen_14" );
  
  
AddCmd( ({"bade", "bad", "schwimm", "schwimme" }), "cmd_wasser" );

}

int cmd_wasser(string str){
 notify_fail("Wo willst Du baden?\n");

 if(!str || str == "")  return 0;
 if(!(str == "in wasser" ||
      str == "in see" )) return 0;

 write("Du nimmst Anlauf und hechtest in die Fluten.\n");

 say(TPN+" springt in den See.\n");
 TP->move(ROOM "brunnen_15", M_GO, "in den Fluten");
 return 1;

}


