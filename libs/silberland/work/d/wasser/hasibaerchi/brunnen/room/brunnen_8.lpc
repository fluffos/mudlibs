#include "../def.h"
#include <properties.h>

inherit "std/room";
inherit "std/player/moneyhandler";

int schluckanzahl;
int anwendungen;
int anzahl;

void create()
{
::create();

  schluckanzahl = 3;
  anwendungen = 2;
  anzahl = 1;

  SetProp( P_INT_SHORT, "In einem Rittersaal" );
  SetProp( P_INT_LONG,
  "Du findest Dich in einem prunkvollen Rittersaal wieder. Ein blutroter "
  "Teppich fuehrt ein paar flache Stufen zu einem Altar hinauf. Vor dem Altar "
  "steht eine kleine Statue. Links und rechts stehen vor den Waenden mehrere "
  "Ritterruestungen in einer Reihe. Schwere Vorhaenge mit arkanen Symbolen "
  "wehen sanft im unangenehmen Wind. Du spuerst in jedem Koerperteil eine "
  "starke diabolische Praesenz. Du bist Dir ziemlich sicher, dass Du im "
  "Herzen dessen bist, das Deinen Koerper zum zittern bringt. Es herrscht eine "
  "unheilvolle Ruhe im ganzen Saal.");
  

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Auf dem steinernen Boden liegt ein blutroter Teppich.");
  AddDetail( ({ "praesenz" }),
    "Irgendetwas lauert hier auf Dich. Hoffentlich endet Deine Suche "
    "nicht hier.");
  AddDetail( ({ "suche" }),
    "Was auch immer Du suchst, hoffentlich bist Du Dir Deines Risikos bewusst.");
  AddDetail( ({ "risiko", "risikos" }),
    "Das Risiko ist bei einer Suche, wie dieser, immer da.");
  AddDetail( ({ "rittersaal", "saal" }),
    "Sieh Dich nur genau um. Wer weiss, wie lange Du noch Gelegenheit "
    "dazu hast.");
  AddDetail( ({ "teppich" }),
    "Der Teppich fuehrt ueber ein paar flache Stufen zum Altar hinauf. Du bist "
    "Dir sicher, dass er nicht von vielen Wesen benutzt wurde. Vielleicht sieht "
    "er deswegen fast wie neu aus. Oder liegt es vielleicht an der blutroten "
    "Farbe?");
  AddDetail( ({ "farbe" }),
    "Ein blutroter Teppich, wie vornehm. Du hoffst nur, dass die Farbe nicht "
    "von Deinen Vorgaengern stammt. Der Teppich laedt Dich zum huldigen "
    "ein, wobei Du hier Niemandem speziellen huldigen willst.");
  AddDetail( ({ "niemandem", "niemand" }),
    "Huldige einfach nur den Goettern!");
  AddDetail( ({ "goetter", "goettern" }),
    "Huldige ihnen!");
  AddDetail( ({ "vorgaengern", "vorgaenger" }),
    "Du glaubst nicht, dass schon jemand vor Dir hier war.");
  AddDetail( ({ "stufe", "stufen" }),
    "Ziemlich flache Stufen fuehren zu einem Altar hinauf. Sie sind einige "
    "Meter breit, aber auch ziemlich tief. Man kann dadurch sehr direkt "
    "zum Altar hinaufgehen.");
  AddDetail( ({ "gelegenheit" }),
    "Viel Zeit hast Du nicht mehr! Schon bald wir Dein Ende kommen!");
  AddDetail( ({ "zeit" }),
    "Bald wird auch diese um sein. Sieh zu, dass Du von hier wegkommst.");
  AddDetail( ({ "ende" }),
    "Dein Ende wird kommen. Und wenn Du Dich nicht vorsiehst, viel schneller "
    "als Du denkst.");
  AddDetail( ({ "meter" }),
    "Du kannst einen Meter schwer abschaetzen. Stell es Dir aber so vor, "
    "dass es zirka die Distanz ist, die Dich im Moment von Deinem "
    "Ende trennt.");
  AddDetail( ({ "ruhe" }),
    "Seltsam, man kann die Ruhe hier sogar auf der Haut spueren. Richtig "
    "unheimlich!");
  AddDetail( ({ "haut" }),
    "Deine Haut fuehlt sich eisig an.");
  AddDetail( ({ "vorhaenge" }),
    "Ein paar Vorhaenge haengen an den Waenden. Sie enthalten arkane Symbole "
    "und wehen im Wind.");
  AddDetail( ({ "symbole", "form" }),
    "Die Symbole stellen die Dunkelheit in jeder nur denkbaren Form dar.");
  AddDetail( ({ "distanz" }),
    "Sehr gross ist sie nicht, aber Du troestest Dich mit dem Gedanken, dass "
    "es wenigstens ein schmerzvolles Ende fuer Dich geben wird.");
  AddDetail( ({ "moment" }),
    "Ein kurzer Moment der Unachtsamkeit und schon ist es um Dich "
    "geschehen.");
  AddDetail( ({ "unachtsamkeit", "gedanken" }),
    "Konzentriere Dich! Oder willst Du Deinen letzten Atemzug aushauchen?");
  AddDetail( ({ "atemzug" }),
    "Schoen, dass Du noch atmen kannst, noch ..... ");
  AddDetail( ({ "wesen" }),
    "Tja, hier gibt es einige Wesen. Sei Dir aber versichert, dass keines der "
    "hier lebenden Wesen Dir freundlich gesinnt ist.");
  AddDetail( ({ "altar" }),
    "Ein unaussprechbar kalter Altar steht im oberen Teil des Rittersaales. "
    "Auf seiner Oberseite steht ein kleines Abbild und mehrere Kerzen. Links "
    "neben dem Altar befindet sich eine Opferstelle und direkt vor dem Altar "
    "wurde eine kleine Statue plaziert. Anscheinend ist der Weg zum Altar frei.");
  AddDetail( ({ "vorderseite" }),
    "Nur schwarzer Stein ist zu sehen.");
  AddDetail( ({ "stein" }),
    "Einfach nur schwarz!");
  AddDetail( ({ "rueckseite", "hinterseite" }),
    "Du betrachtest die Hinterseite des Altars und entdeckt tatsaechlich "
    "eine Falltuer.");
  AddDetail( ({ "falltuer" }),
    "An der Falltuer ist ein Schloss befestigt.");
  AddDetail( ({ "schloss" }),
    "Ein Zahlenschloss sogar!");
  AddDetail( ({ "zahlenschloss" }),
    "Das Zahlenschloss wirst Du nur mit der richtigen Zahl aufbekommen.");
  AddDetail( ({ "zahl", "geheimzahl" }),
    "Du kennst die Geheimzahl nicht, wuerdest Du sie kennen, koenntest Du "
    "das Zahlenrad auf diese Zahl stellen. Aber ohne dieser Kombination "
    "sieht es schlecht aus." );
  AddDetail( ({"kombination" }),
    "Das waere doch viel zu einfach gewesen, oder?");
  AddDetail( ({ "zahlenrad" }),
    "Auf welche Zahl wirst Du es stellen?");
  AddDetail( ({ "oberseite" }),
    "Auf der Oberseite steht ein kleines Abbild und mehrere Kerzen.");
  AddDetail( ({ "unterseite" }),
    "Wie willst Du das untersuchen?"); 
  AddDetail( ({ "opferstelle" }),
    "Eigentlich ist es eine Schale die auf einem Sockel thront.");
  AddDetail( ({ "sockel" }),
    "Diabolische Symbole zieren den Sockel. Zum Glueck verstehst Du ihre "
    "Bedeutung nicht.");
  AddDetail( ({ "schale" }),
    "In der Schale ist eine rote Fluessigkeit. Was das wohl sein kann?");
  AddDetail( ({ "fluessigkeit" }),
    "Was koennte das bloss sein?");
  AddDetail( ({ "blut" }),
    "Es koennte aber auch Himbeersaft sein. Koste mal.");
  AddDetail( ({ "himbeersaft" }),
    "Es koennte aber auch Blut sein. Vielleicht solltest Du mal kosten.");
  AddDetail( ({ "bedeutung" }),
    "Irgendwie bist Du sehr froh darueber, dass Du die genaue Bedeutung der "
    "Symbole nicht verstehst.");
  AddDetail( ({ "glueck" }),
    "Das kannst Du brauchen.");
  AddDetail( ({ "teil" }),
    "Es gibt einen oberen und einen unteren Teil. Beide kannst Du sehen.");
  AddDetail( ({ "weg" }),
    "Anscheinend ist der Weg zum Altar wirklich frei.");
  AddDetail( ({ "statue", "ritter" }),
    "Die Statue zeigt einen alten und blutruenstigen Ritter. In seinen Haenden "
    "liegt ein schwarzer Totenschaedel und ein schwarzer Dolch.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind mit vielen kleinen Ornamenten verziert. In einer "
    "langen Reihe stehen Ritterruestungen davor. Ein paar Vorhaenge "
    "wehen im Wind.");
  AddDetail( ({ "reihe" }),
    "Die Ritterruestungen reichen vom Eingang bis zu den Stufen des Altar "
    "hin.");
  AddDetail( ({ "eingang" }),
    "Von dort bist Du hereingekommen."); 
  AddDetail( ({ "ornamente", "ornamenten" }),
    "Unzaehlbar viele Ornamente verzieren die Waende. Sie verleihen dem Saal eine "
    "wirklich duestere Ausstrahlung.");
  AddDetail( ({ "ausstrahlung" }),
    "Einfach diabolisch, richtig zum fuerchten.");
  AddDetail( ({ "haende" }),
    "Dolch und Totenschaedel werden von steinernen Fingern festgehalten.");
  AddDetail( ({ "finger" }),
    "Die Finger unklammern den Dolch und den Totenschaedel.");
  AddDetail( ({ "totenschaedel" }),
    "Seine leeren Augenhoehlen scheinen Dich anzustarren, und Angst "
    "erfuellt Dein Herz. Lebt er oder, besser gesagt, es etwa noch?");
  AddDetail( ({ "augenhoehlen" }),
    "Sie scheinen Dir bis auf den Grund Deiner Seele zu blicken.");
  AddDetail( ({ "grund" }),
    "Angst steigt in Dir auf.");
  AddDetail( ({ "seele" }),
    "Noch ist sie frei, wobei sich das schnell aendern kann. Und das darfst "
    "und wirst Du sehr bald selbst erfahren.");
  AddDetail( ({ "dolch" }),
    "Ein schwarzer langer Dolch mit einer scharfen Klinge. Doch irgendetwas "
    "scheint mit dem Arm zu sein, der den Dolch haelt.");
  AddDetail( ({ "klinge" }),
    "Wie scharf die Klinge ist, kannst Du ganz einfach testen, wenn "
    "Du willst.");
  AddDetail( ({ "arm" }),
    "Du koenntest den Arm einfach mal nach unten ziehen.");
  AddDetail( ({ "ritterruestungen", "ruestungen" }),
    "Viele veschiedene Ritterruestungen wurden hier aufgestellt. Sie wurden "
    "im Laufe der Zeit gesammelt, und zeigen deutlich die Staerke und Macht "
    "der Dunkelheit. Eines haben alle Ruestungen gemein, das Zeichen der "
    "schwarzen Rose.");
  AddDetail( ({ "rose" }),
    "Das muss das Zeichen der Ritterschaft sein, die hier lebt und der "
    "Dunkelheit huldigt.");
  AddDetail( ({ "ritterschaft" }),
    "Die Ritterschaft der schwarzen Rose. Hoffentlich begegnest Du nie einem "
    "der Ritter der schwarzen Rose.");
  AddDetail( ({ "dunkelheit" }),
    "Anders kannst Du sie nicht beschreiben. Dunkelheit trifft es einfach "
    "am besten.");
  AddDetail( ({ "staerke" }),
    "Es grenzt an Unbesiegbarkeit.");
  AddDetail( ({ "unbesiegbarkeit" }),
    "Ob Du derjenige bist, der das aendern kann, wagst Du zu bezweifeln.");
  AddDetail( ({ "macht" }),
    "Darum geht es der Dunkelheit. Um Macht, um die reine absolute Macht.");
  AddDetail( ({ "zeichen" }),
    "Das Zeichen der schwarzen Rose.");
  AddDetail( ({ "decke" }),
    "Die Decke ist wirklich sehr weit oben. An ihr haengt ein "
    "grosser Kronleuchter.");
  AddDetail( ({ "kronleuchter" }),
    "Der schwarze Kronleuchter ist wahrhaftig riesig und erhellt diesen Saal. "
    "Wohl auch, wenn Feinde ihn betreten.");
  AddDetail( ({ "feinde" }),
    "Auch Du gehoerst dazu.");
  AddDetail( ({ "abbild" }),
    "Das Abbild zeigt die Goettin Dusty, wie sie einen Paladin segnet, der "
    "gleich darauf unter graesslichen Schmerzen sein Ende findet.");
  AddDetail( ({ "schmerzen" }),
    "Die Schmerzen muessen wirklich unertraeglich gewesen sein. Was fuer ein "
    "gerechtes Ende fuer einen Paladin.");
  AddDetail( ({ "paladin" }),
    "Du willst sicher nicht so enden, also bete hier ja nicht zu Dusty."); 
  AddDetail( ({ "kerzen" }),
    "Die Kerzen auf dem Altar sind schwarz und flackern im Wind.");
  AddDetail( ({ "wind" }),
    "Woher er kommt, kannst Du nicht feststellen. Seine unnatuerliche Kaelte "
    "laesst Dich jedoch am ganzen Koerper zittern.");
  AddDetail( ({ "kaelte" }),
    "Einfach unnatuerlich und unheimlich.");
  AddDetail( ({ "koerper", "koerperteil" }),
    "Noch ist Dein Koerper in einem Stueck.");
  AddDetail( ({ "stueck" }),
    "Ein Stueck, zwei Stueck, drei Stueck ..... so kann das noch "
    "ewig weitergehen.");
  AddDetail( ({ "dusty", "goettin" }),
    "Irgendwie hast Du Dir Dusty immer anders vorgestellt.");
  AddDetail( ({ "laufe" }),
    "Das reicht von dem Zeitpunkt an, wo der Untergang des Silberlandes begann.");
  AddDetail( ({ "untergang" }),
    "Du spuerst, der Untergang naht.");
  AddDetail( ({ "zeitpunkt" }),
    "Genaueres ist Dir ueber diesen Zeitpunkt leider nicht bekannt.");
  AddDetail( ({ "silberland" }),
    "Was hast Du denn gedacht, wo Du Dich befindest?");
  AddDetail( ({ "angst" }),
    "Die Angst bringt Dein Herz zum rasen, Kaelte breitet sich in Deinem "
    "Koerper aus.");
  AddDetail( ({ "herz" }),
    "Es haemmert ungewoehnlich schnell.");
  AddDetail( ({ "atmosphaere" }),
    "Die Atmosphaere hier ist wahnsinnig gespannt.");
  AddDetail( ({ "kind" }),
    "Du kannst das Kind nicht finden!");
    
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Weihrauch und abgestandener Luft." );
  AddSmell( ({ "luft"}),
    "Der abgestandene Geruch scheint von den Ritterruestungen auszugehen.");
  AddSmell( ({ "geruch" }),
    "Einfach mufflig.");
  AddSmell( ({ "ritterruestungen" }),
    "Du bist Dir ganz sicher, der Geruch kommt von ihnen.");
  AddSmell( ({ "weihrauch" }),
    "Der Weihrauch verleiht diesem Saal eine gewisse Atmosphaere.");
  AddSmell( ({ "atmosphaere" }),
    "Was erwartest Du jetzt riechen zu koennen?");
  AddSmell( ({ "saal" }),
    "Es riecht nach Weihrauch und abgestandener Luft.");
  
  
  AddSound( DEFAULT_SOUND,
    "Es herrscht eine unangenehme Ruhe im ganzen Saal. Ganz leise "
    "kann man den Wind hoeren." );
  AddSound( ({ "wind"}),
    "Es hoert sich fast so an, als ob hier jemand fluestert.");
  AddSound( ({ "fluestern" }),
    "Es war doch nur der Wind.");
  AddSound( ({ "ruhe" }),
    "Stille, nichts weiter.");
  AddSound( ({ "stille" }),
    "Sie gleicht dem Tod.");
  AddSound( ({ "tod" }),
    "Nur Stille, Stille und nochmals Stille.");
  AddSound( ({ "saal" }),
    "Du lauscht den Geraeuschen im Saal, und kannst nur den Wind hoeren.");
  AddSound( ({ "geraeusche", "geraeuschen" }),
    "Der Wind, der Wind das himmlische Kind.");
  AddSound( ({ "kind" }),
    "Du kannst das Kind nicht hoeren.");
  AddSound( ({ "schluerfen" }),
    "Rolle den Teppich zur Seite und Du wirst mehr erfahren.");
  AddSound( ({ "teppich", "seite" }),
    "Das nuetzt Dir nichts.");
 

  
  AddExit( "nordwesten", ROOM "brunnen_7" ); 
  AddExit( "hinten", ROOM "brunnen_11" );

  AddItem(NPC "page",  REFRESH_DESTRUCT);
  AddItem(NPC "knappe",  REFRESH_DESTRUCT);
  AddItem(NPC "ritter",  REFRESH_DESTRUCT);
  
  
AddCmd( ({"kosten", "koste" }), "cmd_himbeersaft" );
AddCmd( ({"kosten", "koste" }), "cmd_blut" );
AddCmd( ({"huldig", "huldige" }), "cmd_huldige" );
AddCmd( ({"teste", "test" }), "cmd_klinge" );
AddCmd( ({"zieh", "ziehe", "ziehen" }), "cmd_arm" );
AddCmd( ({"rolle", "rolle" }), "cmd_ausgang" );
AddCmd( ({"bete", "beten" }), "cmd_beten" );
AddCmd( ({"bete", "beten" }), "cmd_woody" );
AddCmd( ({"bete", "beten" }), "cmd_clumsy" );
AddCmd( ({"bete", "beten" }), "cmd_veggy" );
AddCmd( ({"bete", "beten" }), "cmd_spicy" );
AddCmd( ({"bete", "beten" }), "cmd_cleany" );
AddCmd( ({"bete", "beten" }), "cmd_stinky" );
AddCmd( ({"bete", "beten" }), "cmd_kapaneus" );
AddCmd( ({"bete", "beten" }), "cmd_dirty" );
AddCmd( ({"bete", "beten" }), "cmd_freshy" );
AddCmd( ({"stell", "stelle"}), "cmd_rad" );


}

int cmd_rad(string str){
 notify_fail("Auf welche Zahl willst Du das Rad stellen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "rad auf 75" ||
      str == "rad auf zahl 75" ||
      str == "schloss auf 75" ||
      str == "zahlenschloss auf 75" ||
      str == "schloss auf die zahl 75" ||
      str == "zahlenschloss auf die zahl 75" ||
      str == "rad auf die zahl 75" ||
      str == "zahl auf 75" ||
      str == "zahl auf die zahl 75" ||
      str == "zahlenrad auf 75" ||
      str == "zahlenrad auf zahl 75" ||
      str == "zahlenrad auf die zahl 75")) 

  {
   write(BS("Irgendwie war das die falsche Zahl, Autsch!"));
   say(TPN+" schreit laut auf.\n");
   TP->AddPoison(9);
   TP->AddHp(-75);
   return 1;
      }
	
 write(BS("Du drehst das Zahlenrad auf die Zahl 75 und kletterst "
	  "durch die Falltuer in die Tiefe.\n"));

 say(TPN+" spielt an irgendwas herum.\n");
 TP->move(ROOM "brunnen_19", M_GO, "weg", "klettert");

 return 1;
}

int cmd_blut(string str){
 notify_fail("Was willst Du kosten?\n");

 if(!str || str == "")  return 0;
 if(!(str == "blut" )) return 0;

 write("Du nimmst einen kraeftigen Schluck von dem Blut und "
       "fuehlst danach Deine Kraft schwinden.\n");

 say(TPN+" nimmt einen kraeftigen Schluck und krampft sich zusammen.\n");
 TP->AddPoison(5);

 return 1;

}

int cmd_himbeersaft(string str){
 notify_fail("Was willst Du kosten?\n");

 if(!str || str == "")  return 0;
 if ( member( ({ "himbeersaft" }),str) != -1) 

  write("Du nimmst einen kraeftigen Schluck von dem Himbeersaft und\n"
       "fuehlst danach neue Kraft in Deinen Koerper fliessen.\n");

 say(TPN+" nimmt einen kraeftigen Schluck und sieht gestaerkt aus.\n");
 
 if ( schluckanzahl )
    {
      TP -> drink_soft(1);
      TP -> heal_self(35+random(25));
      schluckanzahl--;
    }
 
   return 1;

}
  
int cmd_huldige(string str){
 notify_fail("Wem willst Du huldigen?\n");

 if(!str || str == "") return 0;
 if(!(str == "goetter" ||
      str == "goettern" ||
      str == "gott" ||
      str == "cleany" ||
      str == "stinky" ||
      str == "spicy" ||
      str == "dirty" ||
      str == "veggy" ||
      str == "dusty" ||
      str == "woody" ||      
      str == "clumsy" )) return 0;

 write("Du kniest Dich auf den blutroten Teppich und huldigst den Goettern.\n"
       "Langsam nimmt der Teppich Dein Blut auf und Du verstaerkst dadurch\n"
       "die rote Farbe des Teppichs. Ploetzlich hoerst Du ein Schluerfen.\n");

 say(TPN+" kniet sich auf den Teppich.\n");
 this_player()->AddHp(-35);

	 
  return 1;      
}

int cmd_klinge(string str){
 notify_fail("Was willst Du testen?\n");

 if(!str || str == "") return 0;
 if(!(str == "klinge" ||
      str == "dolch" )) return 0;

 write("Du faehrst mit Deiner Hand ueber die Klinge des Dolches.\n"
       "Ein paar Tropfen Blut gleiten die Klinge entlang und tropfen\n"
       "auf den Teppich hinunter. Zu Deinem Entsetzen saugt der\n"
       "Teppich Dein Blut auf.\n");

 say(TPN+" schneidet sich in die Hand.\n");
 this_player()->AddHp(-7);


 return 1;

}

int cmd_arm(string str){
int old_align;
  notify_fail("Was willst Du wie herunterziehen?\n");	
  if(!str || str == "") return 0;
  if(!(str == "arm einfach mal runter" ||
       str == "arm einfach mal hinunter" ||
       str == "arm einfach mal herunter" ||
       str == "arm einfach mal nach unten" ||
       str == "arm einfach runter"   ||
       str == "arm einfach hinunter" ||
       str == "arm einfach herunter" ||
       str == "arm einfach nach unten" ||
       str == "arm nach unten" ||
       str == "arm runter" )) return 0;

 write("Mit all Deiner Kraft ziehst Du den Arm nach unten. Du\n"
       "fuehlst sogleich die Kraft der Dunkelheit in Dich eindringen.\n"
       "Was fuer ein herrliches Gefuehl.\n");

 say(TPN+" wird von der Macht der Dunkelheit durchdrungen.\n");
 
 if( anwendungen )
  {
     old_align=TP->QueryProp(P_ALIGN);
     if(old_align > -1000)
     {
     TP->SetProp(P_ALIGN, old_align-50);
     anwendungen--;
     }
  }
 return 1;

}
int cmd_ausgang(string str){
 notify_fail("Was willst Du wegrollen?\n");

 if(!str || str == "") return 0;
 if(!(str == "teppich" ||
      str == "teppich weg" ||
      str == "teppich auf die seite" ||
      str == "teppich zur seite" )) return 0;
 

 write(BS("Du rollst den blutroten Teppich zur Seite und entdeckst voller "
	  "Freude darunter eine Falltuer. Ploetzlich beginnt der Teppich Dich "
	  "zu umschlingen, und Dein Blut aus Deinem Koerper zu saugen. "
	  "Du bist von der Reaktion des Teppichs so ueberrascht, dass Du "
	  "keine Chance hast Dich zu wehren. Es war sicher keine gute Idee "
	  "auf dem Teppich zu huldigen, aber dafuer ist es jetzt zu spaet. "
	  "Die Finsternis empfaengt Dich.\n"));

 say(TPN+" wird von dem blutroten Teppich gefressen.\n");
 
 TP->move(ROOM "brunnen_10", M_GO, "ins andere Reich");
	       

 return 1;

}
int cmd_beten(string str){
 notify_fail("Zu wem willst Du beten?\n");

 if(!str || str == "") return 0;
 if(!(str == "zu dusty" )) return 0;

 write(BS("Du betest zur Goettin Dusty und sofort durchfaehrt Dich "
	  "schrecklicher Schmerz.\n"));

 say(TPN+" scheint zu Dusty zu beten.\n");
 this_player()->AddHp(-75);
 TP->AddPoison(5);
	 
  return 1;      
}

int cmd_woody(string str){
 notify_fail("Zu wem willst Du beten?\n");

 if(!str || str == "") return 0;
 if(!(str == "zu woody" )) return 0;

 write(BS("Du betest zu Woody und sofort fuehlst Du Dich "
	  "sehr gesaettig, und hast ein angenehmes Gefuehl im Bauch.\n"));

 say(TPN+" scheint zu Woody zu beten.\n");
 TP->SetProp(P_FOOD, TP->QueryProp(P_MAX_FOOD));
 
	 
  return 1;      
}
int cmd_clumsy(string str){
 notify_fail("Zu wem willst Du beten?\n");

 if(!str || str == "") return 0;
 if(!(str == "zu clumsy" )) return 0;

 write(BS("Du betest zu Clumsy dem Gott des Gluecks und sofort fuehlst Du "
	  "Dich gluecklicher.\n"));

 say(TPN+" scheint zu einem unbekannten Gott zu beten.\n");

	 
  return 1;      
}
int cmd_cleany(string str){
 notify_fail("Zu wem willst Du beten?\n");

 if(!str || str == "") return 0;
 if(!(str == "zu cleany" )) return 0;

 write(BS("Du betest zu Cleany dem Gott der Sauberkeit und sofort fuehlst Du "
	  "Dich von innen heraus gereinigt.\n"));

 say(TPN+" scheint zu einem unbekannten Gott zu beten.\n");

	 
  return 1;      
}
