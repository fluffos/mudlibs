int cmd_kapaneus(string str){
 object kapaneus;
 notify_fail("Zu wem willst Du beten?\n");

 if(!str || str == "") return 0;
 if(!(str == "zu kapaneus" )) return 0;

 if(find_call_out("amulett")<0)
    call_out("amulett", 604800); //nach einer woche

  if(anzahl<1)
  {
    write(BS("Du betest zu Kapaneus dem aeltesten Wesen des Silberlandes und sofort "
  	     "fuehlst Du Dich weise und erleuchtet.\n"));
    say(BS(TPN+" scheint zu einem unbekannten Gott zu beten und sieht nun viel "
	   "weiser aus.\n"));
    return -1;
  }
  if ( present("\nkapaneus",TP) )
  {
    write(BS("Du betest zu Kapaneus dem aeltesten Wesen des Silberlandes und sofort "
	     "fuehlst Du Dich weise und erleuchtet.\n"));
    say(BS(TPN+" scheint zu einem unbekannten Gott zu beten und sieht nun viel "
	       "weiser aus.\n"));
    return -1;
  }
  else
  {
    kapaneus = clone_object(ARMOUR "kapaneus");
    if ( ME_TOO_HEAVY == kapaneus->move(TP,M_GET|M_SILENT) )
    {
      write(BS("Dir faellt ein Amulett zu Boden.\n"));
      kapaneus->remove();
      return 1;
    }
    else
    {
      write(BS("Du betest zu Kapaneus dem aeltesten Wesen des Silberlandes und sofort "
               "fuehlst Du Dich weise und erleuchtet.\n"));
      say(BS(TPN+" scheint zu einem unbekannten Gott zu beten und sieht nun viel "
   	         "weiser aus.\n"));
      anzahl--;
      return 1;
    }
  }
     return 0;
}

void amulett(){anzahl=1;}
