//erstellt von hasibaerchi zelle 

#include "../def.h"
inherit "std/room";
inherit "std/player/moneyhandler";

int anzahl=3;

void create()
{
::create();
 
  SetProp( P_INT_SHORT, "In einer Zelle");
  SetProp( P_INT_LONG,
  "Na, wo bist Du den hier gelandet? Das ist ja eine Zelle! Wie wirst Du "
  "hier nur rauskommen? Einfach wird es sicher nicht werden.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Steine, Steine nichts als Steine.");
  AddDetail( ({ "wand", "waende" }),
    "Nur ein Haufen Steine und eine Tuer die in die Freiheit fuehrt.");
  AddDetail( ({ "stein", "steine" }),
    "Hart und rau.");
  AddDetail( ({ "haufen" }),
    "Einfach viele Steine.");
  AddDetail( ({ "freiheit" }),
    "Freiheit suchst Du, aber die wirst Du nur ausserhalb der Zelle "
    "erhalten.");
  AddDetail( ({ "zelle" }),
    "Ja, das ist eine Zelle! Wie Du hier nur rauskommen wirst? "
    "Einfach wird es sicher nicht werden.");
  AddDetail( ({ "decke" }),
    "Irgendetwas scheint in der Decke zu stecken.");
  AddDetail( ({ "irgendetwas" }),
    "Du kannst es nicht erreichen! Vielleicht solltest Du Dich danach "
    "strecken.");
  AddDetail( ({ "tuer" }),
    "Eine schwere Eisentuer mit Gitterstaeben.");
  AddDetail( ({ "eisentuer" }),
    "Na, was kann man mit einer Tuer machen?");
  AddDetail( ({ "gitterstaebe", "gitterstaeben", "staebe" }),
    "Du koenntest versuchen die Gitterstaebe aufzubiegen.");
  AddDetail( ({ "gewalt" }),
    "Na, aufbrechen!");
  AddDetail( ({ "ecke", "ecken" }),
    "Du untersuchst die Ecken und entdeckst wirklich in einer Ecke ein "
    "Haeufchen Stroh. Das ist sicher fuer die Notdurft gedacht.");
  AddDetail( ({ "notdurft" }),
    "Du kannst Dir das ganz gut auch ohne detailierte Beschreibung "
    "vorstellen, glaub mir!");
  AddDetail( ({ "beschreibung" }),
    "Wie genau haettest Du es gern?");
  AddDetail( ({ "stroh", "haeufchen" }),
    "Wenn es Dir nicht so grausen wuerde, dann koenntest Du ja das Stroh "
    "durchwuehlen.");
  AddDetail( ({ "teller" }),
    "Da klebt ja noch Deine Henkersmahlzeit am Teller!");
  AddDetail( ({ "henkersmahlzeit" }),
    "Du koenntest es mit essen probieren. Oder traust Du Dich nicht?");
  AddDetail( ({ "gerippe" }),
    "Das muss derjenige sein, der vor Dir hier in der Zelle war.");
  
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach verfaulten Eiern." );
  AddSmell( ({ "eier", "eiern", "geruch"}),
    "Es stinkt bestialisch! Der Geruch kommt hier irgendwo aus der Zelle.");
  AddSmell( ({ "zelle" }),
    "Es riecht wirklich grauslich hier.");
  
  
  AddSound( DEFAULT_SOUND,
    "Plopp." );
  AddSound( ({ "plopp"}),
    "Das war nur Dein Angstschweiss der zu Boden tropft.");
  AddSound( ({ "angstschweiss" }),
    "Ganz leise tropft der Angstschweiss zu Boden.");
  AddSound( ({ "boden" }),
    "Der Boden ist und bleibt stumm.");
  
 
  
AddCmd( ({"oeffne" }), "cmd_oeffne" );
AddCmd( ({"streck", "strecke" }), "cmd_streck" );
AddCmd( ({"breche", "brech", "brich"}), "cmd_breche" );
AddCmd( ({"bieg", "biege" }), "cmd_gitter" );
AddCmd( ({"wuehl", "wuehle", "durchwuehle" }), "cmd_stroh" );
AddCmd( ({"esse", "iss", "essen" }), "cmd_essen" );
AddCmd( ({"lass", "lasse" }), "cmd_schas" );

}

void reset()
	
{
  ::reset();
  anzahl=3;
}

int cmd_streck(string str){
 object staebchen;

 notify_fail("Nach was willst Du Dich strecken?\n");
 if(!str || str == "")  return 0;
 if(!(str == "nach irgendetwas" ||
      str == "nach irgendwas" ||
      str == "mich nach irgendetwas")) return 0;

 {
      if(anzahl<1)
     {

 write(BS("Du streckst Dich zur Decke und kannst dort nichts "
	  "erkennen, wahrscheinlich war jemand schneller als Du.\n"));

 say(TPN+" untersucht die Decke.\n");
  return -1;
     }
     if (present("\nstaebchen",TP))
     {
  write(BS("Du streckst Dich zur Decke und kannst ein Holzstaebchen "
	  "erkennen, das Du aber nicht nimmst, da Du schon ein Staebchen hast.\n"));
  say(BS(TPN+" untersucht die Decke.\n"));
       return -1;
     }
     else
     {
       {
          staebchen=clone_object(OBJ "staebchen");
          if ( ME_TOO_HEAVY == staebchen->move(TP,M_GET|M_SILENT) )
          {
  write(BS("Dir faellt ein Staebchen zu Boden.\n"));
 
            staebchen->remove();
            return 1;
          }
          else
          {
  write(BS("Du streckst Dich zur Decke und kannst ein Holzstaebchen "
	  "erkennen, das Du sofort an Dich nimmst.\n"));
  say(BS(TPN+" untersucht die Decke.\n"));
            anzahl--;
            return 1;
          }
       }
     }
     return 0;
   }
   return 0;
}

int cmd_oeffne(string str){
 notify_fail("Was willst Du oeffnen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "tuer auf" ||
      str == "tuere auf" ||
      str == "die tuere auf" ||
      str == "die eisentuere auf" ||
      str == "eisentuere auf" ||
      str == "eisentuer auf" ||
      str == "die eisentuer auf" ||
      str == "die tuer auf" )) return 0;

  write(BS("Du versucht ganz einfach die Tuer zu oeffnen, doch leider "
	   "ist sie verschlossen. Trotzdem war das ein Versuch wert. "
	   "Vielleicht bringt Gewalt mehr?\n"));
 
  say(TPN+" arbeitet an der Tuer.\n");
 
   return 1;

}
  
int cmd_breche(string str){
 notify_fail("Was willst Du aufbrechen?\n");

 if(!str || str == "") return 0;
 if(!(str == "tuer" ||
      str == "tuere" ||
      str == "die tuere" ||
      str == "die eisentuere" ||
      str == "eisentuere" ||
      str == "eisentuer" ||
      str == "die eisentuer" ||
      str == "die tuer" )) return 0;

 write(BS("Du nimmst Deine ganze Kraft zusammen und versuchst die Tuer "
	  "aufzubrechen. Autsch! Leider ist die Tuer stabiler als Du "
	  "dachtest.\n"));

 say(TPN+" laeuft gegen die Tuer.\n");
 this_player()->AddHp(-12);
 
 return 1;      
}



int cmd_gitter(string str){
 notify_fail("Was willst Du aufbiegen?\n");

 if(!str || str == "") return 0;
 if(!(str == "gitter" ||
      str == "gitter auf" ||
      str == "gitterstaebe auf" ||
      str == "die gitter" ||
      str == "die gitter auf" ||
      str == "die gitterstaebe auf" ||
      str == "die gitterstaebe" ||
      str == "gitterstaebe" )) return 0;

 write(BS("Du versucht die Gitterstaebe aufzubiegen, jedoch ohne "
	  "Erfolg. Anscheinend bist Du nicht kraeftig genug.\n"));

 say(TPN+" macht sich an den Gitterstaeben zu schaffen.\n");
 
 return 1;

}

int cmd_stroh(string str){
 notify_fail("Was willst Du durchwuehlen?\n");	
 if(!str || str == "") return 0;
 if(!(str == "stroh" ||
      str == "haeufchen" )) return 0;

 write(BS("Huch, Du findest tatsaechlich einen Teller, den ein Gerippe festhaelt!\n"));

 say(TPN+" wuehlt herum.\n");
  
 return 1;
 
} 
int cmd_essen(string str){
 
 notify_fail("Was willst Du womit essen?\n");

 if(!str || str == "") return 0;
 if(!(str == "mahlzeit" ||
      str == "mahlzeit mit staebchen" ||
      str == "mahlzeit mit holzstaebchen"||
      str == "henkersmahlzeit" ||
      str == "henkersmahlzeit mit staebchen" ||
      str == "henkersmahlzeit mit holzstaebchen" )) return 0;
 

 if( str == "mahlzeit mit staebchen" ||
     str == "mahlzeit mit holzstaebchen" ||
     str == "henkersmahlzeit mit staebchen" ||
     str == "henkersmahlzeit mit holzstaebchen"){
    
  if(!present("\nstaebchen", TP)){
	  
  write(BS("Du hast ja gar keines. Wie willst Du dann ohne Staebchen essen?\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }
  write(BS("Du nimmst das Holzstaebchen und beginnst zu futtern. Obwohl "
	  "es nicht sehr lecker aussieht, staerkt es Dich. Leider "
	  "hast Du nun zu viel Luft im Bauch. Aua, wie das drueckt. "
	  "Vielleicht waere es nicht schlecht eine Furz fahren zu "
	  "lassen.\n"));
 
  say(TPN+" futtert.\n");
  if (!present("\nunsichtbar",TP)) //Hab das da mal reingemacht. Malar :)
    {
       CLONE(OBJ "unsichtbar",TP);
    }
  return 1;
 }
 if( str == "mahlzeit" ||
     str == "henkersmahlzeit"){
 
 write(BS("Mit den Haenden? Niemals, Du Ferkel! Selbst hier in der "
	  "Zelle hast Du Stil genug, kein Schwein zu sein.\n"));

 say(TPN+" benimmt sich wie ein Schwein.\n");
 return 1;
 }
}

int cmd_schas(string str){
 notify_fail("Was willst Du fahren lassen?\n");

 if(!str || str == "") return 0;
 if(!(str == "furz" ||
      str == "furz fahren" ||
      str == "einen furz" ||
      str == "einen furz fahren" )) return 0;
 
 
 if (present("\nunsichtbar",TP)){
	     
 write(BS("Du holst tief Luft und laesst einen gewaltigen Furz fahren. "
       "Oh Woody, wie der stinkt! Der Geruch von faulen Eiern steigt "
       "Dir in die Nase. Ploetzlich hoerst Du ein jammern, und ein Geist "
       "erhebt sich von dem Gerippe. Er haelt sich ein Taschentuch "
       "vor Mund und Nase und bruellt:\"Wie es hier stinkt, Du Ferkel! "
       "Wir haben hier einen ordentlicher Kerker und dulden keine "
       "Stinker wie Dich!\""));

 say(TPN+" macht irgendetwas und wird daraufhin von einem "
	 "Geist durch die Wand getragen.\n");

 TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 200,
                PARALYZE_MSG: "Du bist vor Schreck wie versteinert.\n",
                PARALYZE_MSG_OTHER: "%s ist steif wie ein Brett.\n"]));  
   
   call_out("fall1",15);
 present("\nunsichtbar",TP)->remove(1);
 return 1;
 }

 write(BS("Du kannst ja gar keinen fahren lassen, wenn Du gar nichts im Bauch "
       "hast, das blaeht."));

 return 1;
}

void fall1()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write(BS("\"Raus hier aus meinem Wohnzimmer!\", mit diesen Worten packt "
	 "Dich der Geist am Nacken. Sofort wird Dein Koerper durscheinend "
	 "wie der eines Geistes und der Geist schleift Dich geradewegs auf "
	 "die Mauer zu. Er dringt mit Dir in die Mauer ein. Ab diesem Moment "
	 "schwinden Dir Deine Sinne, weil Du nur mehr Mauern vor Augen hast."));

   call_out("fall2",15);
}
void fall2()
{
   if (!objectp(TP)) return;
   if (ENV(TP)!=TO ) return;
   write (BS("Als Du wieder zu Sinnen kommst merkst Du, dass Du Dich in "
	  "einem Kerker befindest. Wenigstens hast Du Deinen Koerper wieder. "
	  "Ganz leise hoerst Du noch eine Stimme sagen: \"Immer diese "
	  "Stinker unter den Lebenden.\""));

 TP->SetProp(P_PARALYZED, 0);
 TP->command_me("ruf Ich sage jetzt lieber nicht was ich gemacht habe.");
 TP->move( "/d/wasser/hiri/sandburg/room/kerker.lpc", M_GO, "raus", "schwebt");
}

