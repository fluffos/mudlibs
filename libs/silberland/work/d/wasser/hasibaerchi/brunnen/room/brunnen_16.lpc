//erstellt von hasibaerchi 15. raum



#include "../def.h"
#define HERE 0

inherit "std/room";
inherit "std/player/moneyhandler";

int anz=2;

void create()
{
::create();

  SetProp( P_INT_SHORT, "In einem See" );
  SetProp( P_INT_LONG,
   "Du schwimmst in einem herrlich warmen See. Die Ausmasse des Sees sind "
   "wirklich gigantisch. Waere das Schwimmen nicht so anstrengend, koenntest "
   "Du es sicher besser geniessen. Hoffentlich gibt es hier keine Wesen, die "
   "Dir gefaehrlich werden koennen.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]) );

  AddDetail( ({ "boden" }),
    "Du meinst sicher den Grund des Sees.");
  AddDetail( ({ "see" }),
    "Der See erstrahlt in einem azurblau. Du siehst die Spiegelung der "
    "Pyramide und das Wasser wiegt leicht hin und her.");
  AddDetail( ({ "spiegelung" }),
    "Einfach bezaubernd schoen.");
  AddDetail( ({ "decke" }),
    "Die Decke ist sehr weit ober Dir. Details kannst Du keine ausmachen.");
  AddDetail( ({ "details" }),
    "Wie schon gesagt, Du siehst keine!");
  AddDetail( ({ "wasser" }),
    "Das Wasser umgibt die gesamte Pyramide. Vielleicht kannst Du um die "
    "Pyramide schwimmen.");
  AddDetail( ({ "pyramide" }),
    "Von der Pyramide bist Du hierher gesprungen, sicher kannst Du auch wieder "
    "zurueck auf die Pyramide klettern.");
  AddDetail( ({ "grund" }),
    "Den kannst Du von hier nicht erkennen. dazu muesstest Du schon nach "
    "unten tauchen.");
  AddDetail( ({ "ausmasse" }),
    "Einfach riesig, genau wie die Hoehle selbst.");
  AddDetail( ({ "hoehle" }),
    "Du bist immer noch davon fasziniert.");
  AddDetail( ({ "schwimmen" }),
    "Du schwimmst wie ein Fisch im Wasser.");
  AddDetail( ({ "fisch" }),
    "Komisch, bis jetzt hast Du noch keine gesehen. Wo die nur alle sind?");
  AddDetail( ({ "wesen" }),
    "Langsam kommt Dir ein mulmiges Gefuehl auf.");
  AddDetail( ({ "gefuehl" }),
    "Nur so ein komisches Gefuehl. Dir kommen Bilder des bisherigen "
    "Lebens, das Du gefuehrt hast, in den Sinn. Was das bedeuten mag?");
  AddDetail( ({ "bild", "bilder" }),
    "Alle stammen aus Deinem bisherigen Leben. Ob es bald enden wird?");
  AddDetail( ({ "leben", "lebens" }),
    "Es ist viel zu kurz, also sei tapfer und stelle Dich den hier lauernden "
    "Wesen!");
  AddDetail( ({ "sinn" }),
    "Du willst den Sinn des Lebens wissen? Probiers mal mit: Always look on "
    "the bright side of life!");
  AddDetail( ({ "wand", "waende" }),
    "Du schwimmst zu den Waenden und tastest diese ab. Leider findest Du nur "
    "kalten nackten Fels. Irgendwie hattest Du Dir mehr erwartet "
    "beziehungsweise erhofft.");
  AddDetail( ({ "fels" }),
    "Nur Fels, Fels und nochmals Fels. Wenn hier wenigstens ein Zeichen oder "
    "etwas anderes waere.");
  AddDetail( ({ "zeichen" }),
    "Hier gibt es kein Zeichen oder etwas aehnliches! Nur diese bloede Rune "
    "die hier eingeritzt wurde. Eine Rune? Eine Rune!!! Woher kommt die Rune "
    "denn auf einmal her? Vorher war die Rune noch nicht da. Wie mysterioes.");
  AddDetail( ({ "rune" }),
    "Du verstehst die Bedeutung der Rune nicht. Wahrscheinlich reichen Deine "
    "arkanen Kuenste nicht dafuer aus.");
  AddDetail( ({ "bedeutung" }),
    "Die Bedeutung der Rune bleibt Dir verborgen.");
  AddDetail( ({ "kuenste", "kunst" }),
    "Vielleicht bist Du einfach auch nur zu jung um die Bedeutung zu verstehen.");
  AddDetail( ({ "loch", "ausgang" }),
    "Du schaffst es sicher in das Loch vorzudringen.");
   
 
  AddSmell( DEFAULT_SMELL,
    "Es riecht sehr salzig hier. Das ist sicher das Meerwasser." );
  AddSmell( ({ "wasser", "meerwasser" }),
    "Es riecht sehr salzig.");
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein Plantschen." );
  AddSound( ({ "plantschen"}),
    "Das bist nur Du, beim schwimmen.");

  AddRoomMessage(({ "Du plantscht ein bisschen im Wasser herum.\n",
		   "Du fuehlst Dich im warmen Wasser so richtig wohl.\n",
		   "Du schwimmst etwas im Kreis herum.\n"}),30);
  
  
  
  
AddCmd( ({"tauche", "tauch" }), "cmd_ausgang" );
AddCmd( ({"schwimm", "schwimme" }), "cmd_wasser" );
AddCmd( ({"kletter", "klettere" }), "cmd_pyramide" );
AddCmd( ({"dringe", "dring" }), "cmd_loch" );

}

int cmd_wasser(string str){
 notify_fail("Wohin willst Du schwimmen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "um pyramide" ||
      str == "an pyramide vorbei" ||
      str == "um pyramide herum" )) return 0;

 write(BS("Du machst ein paar Tempi und schwimmst um die "
	  "Pyramide herum.\n"));

 say(TPN+" schwimmt ein bisschen herum.\n");
TP->move(ROOM "brunnen_16a", M_GO|M_SILENT);

 return 1;

}

int cmd_pyramide(string str){
 notify_fail("Worauf willst Du klettern?\n");

 if(!str || str == "") return 0;
 if(!(str == "pyramide" ||
      str == "auf pyramide" )) return 0;

 write(BS("Du nimmst Deine ganze Kraft zusammen und kletterst "
	  "auf die Pyramide.\n"));

 say(TPN+" steigt aus dem Wasser.\n");
 TP->move(ROOM "brunnen_12", M_GO|M_SILENT);

 return 1;

 
} 
int cmd_ausgang(string str){
 notify_fail("Wohin willst Du tauchen?\n");

 if(!str || str == "") return 0;
 if(!(str == "nach unten" ||
      str == "runter" ||
      str == "hinunter" ||
      str == "unten" )) return 0;
 
  write(BS("Du holst tief Luft und tauchst in die Tiefe. Ein beeindruckender "
	   "Anblick bietet sich Dir an. Den Grund kannst Du zwar nicht erkennen, "
	   "dazu ist der Grund zu tief, aber Du erkennst, dass die Pyramide "
	   "bis ganz hinunter gehen muss. Wie gross die die Pyramide ist "
	   "kannst Du Dir gar nicht vorstellen, so gewaltig gross ist sie. "
	   "Weiters faellt Dir noch ein Loch in der Hoehlenwand auf, aus dem "
	   "Wasser zu stroemen scheint. Vielleicht ein Ausgang!, denkst Du Dir. "
	   "Doch gerade in diesem Augenblick geht Dir die Luft aus und Du musst "
	   "wieder auftauchen.\n"));

  say(TPN+" verschwindet im See und erscheint einen Augenblick spaeter wieder.\n");
	       

 return 1;
}
int cmd_loch(string str){
 object manta;
 notify_fail("Wohin willst Du vordringen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "in loch" ||
      str == "in loch vor" ||
      str == "in loch ein" )) return 0;

 write(BS("Du holst tief Luft und tauchst in das Loch.\n"));

 say(TPN+" taucht unter.\n");

 if(EXTMASTER->QueryRoom()==HERE){
	 write("Du tauchst durch die Hoehle. ");
	 TP->move(ROOM "brunnen_17", M_GO);
	 return 1;
 }

 if(anz>0){

	    manta = clone_object(NPC "manta");
	    manta->move(ENV(TP), M_NOCHECK);
	    anz--;
    }
 return 1;
}

void reset(){
	::reset();
	anz=2;
}

	 

