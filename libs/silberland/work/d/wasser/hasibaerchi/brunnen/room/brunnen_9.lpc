//erstellt von hasibaerchi schrankwelt



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "In einem Schrank" );
  SetProp( P_INT_LONG,
   "Du stehst in einem geschlossenen Schrank, der bis oben hin mit vielen "
   "Sachen angeraeumt ist. Du hast jedoch das Gefuehl Dich eher in einem "
   "Zimmer zu befinden, als in einem Schrank. Nur der Bewohner dieses "
   "Zimmers muesste schon sehr klein sein. Ob Dir der Bewohner helfen kann?");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Auf dem Boden stehst Du, genauer gesagt stehst Du auf einem Teppich.");
  AddDetail( ({ "teppich" }),
    "Eigentlich ist es ja gar kein Teppich, sondern eine Wolfspfote.");
  AddDetail( ({ "wolfspfote", "pfote" }),
    "Eine schoene weiche Wolfspfote mit der Zahl 8.");
  AddDetail( ({ "zahl", "zahlen" }),
    "Zahlen kann man zusammenzaehlen und abziehen.");
  AddDetail( ({ "schrank" }),
    "Wie kommst Du nur hier raus?");
  AddDetail( ({ "sachen" }),
    "Dafuer muesstest Du Dich hier im Schrank ein bissl besser umschaun.");
  AddDetail( ({ "gefuehl" }),
    "Dein Gefuehl taeuscht Dich nicht. Du bist wirklich in einem Zimmer.");
  AddDetail( ({ "bewohner" }),
    "Ist er nicht da?");
  AddDetail( ({ "zimmer" }),
    "Du siehst Dich ein etwas im Zimmer um und entdeckst ein Bett, einen "
    "Tisch, eine Dusche, einen Kasten, einen Kleiderstaender und eine "
    "Kommode. Ganz schoen viele Sachen fuer so ein kleines Zimmer.");
  AddDetail( ({ "tisch" }),
    "Du meinst sicher das Marmeladeglas, oder? Auf dem Marmeladeglas "
    "liegt ein Mikadospiel. Neben dem Marmeladeglas stehen eine Couch, "
    "ein Doppelsessel und ein einfacher Sessel.");
  AddDetail( ({ "sessel" }),
    "Du bist Dir sicher das der Sessel eigentlich ein Filzhut ist.");
  AddDetail( ({ "filzhut" }),
    "Der Filzhut hat eine grosse 11 eingenaeht.");
  AddDetail( ({ "doppelsessel" }),
    "Huch, das ist ja ein BH.");
  AddDetail( ({ "bh" }),
    "Die siehst die Zahl 2, irgendwie logisch oder?");
  AddDetail( ({ "mikadospiel" }),
    "Genauer gesagt sind es Zahnstocher.");
  AddDetail( ({ "zahnstocher" }),
    "Die Zahnstocher ergeben ein Muster.");
  AddDetail( ({ "muster" }),
    "Das Muster ergibt die Zahl 95."); 
  AddDetail( ({ "couch" }),
    "Die Couch ist eigentlich eine knuddelige Schmusedecke.");
  AddDetail( ({ "schmusedecke" }),
    "Ganz weich ist die Schmusedecke, aber ganz weich. Nur die "
    "Zahl 3 stoert Dich.");
  AddDetail( ({ "marmeladeglas", "glas" }),
    "Auf dem Glas siehst du ein Etikett.");
  AddDetail( ({ "etikett"}),
    "Du kannst es lesen.");
  AddDetail( ({ "kleiderstaender" }),
    "Genauer gesagt ist es eine grosse Wurzel, ein Beutel haengt auf "
    "der Wurzel.");
  AddDetail( ({ "wurzel" }),
    "Die Zahl 474 ist auf der Wurzel zu sehen.");
  AddDetail( ({ "beutel" }),
    "Als Du genauer hinsiehst stellst Du fest, dass es sich um eine "
    "Zwergenkapuze handelt.");
  AddDetail( ({ "zwergenkapuze" }),
    "Es ist eine schwarze Zwergenkapuze. In die Zwergenkapuze wurde "
    "die Zahl 31 eingenaeht.");
  AddDetail( ({ "dusche" }),
    "Eigentlich ist die Dusche eine Giesskanne. Zusaetzlich siehst Du "
    "noch eine Badewanne.");
  AddDetail( ({ "giesskanne" }),
    "Eine putzige kleine Giesskanne mit der Zahl 193.");
  AddDetail( ({ "badewanne" }),
    "Die Badewanne ist eigentlich ein Helm.");
  AddDetail( ({ "helm" }),
    "Ein robuster Helm, der sich sicher perfekt als Badewanne "
    "eignet. Du siehst die Zahl 7 eingraviert, und weiters liegt noch "
    "eine Badebuerste im Helm.");
  AddDetail( ({ "badebuerste" }),
    "Du bist Dir sicher, dass es eine Zahnbuerste ist.");
  AddDetail( ({ "zahnbuerste" }),
    "Die Zahnbuerste hat viele Borsten.");
  AddDetail( ({ "borsten" }),
    "Es sind genau 13, eine mystische Zahl gell?");
  AddDetail( ({ "kasten" }),
    "Als Du den Kasten naeher betrachtest, stellst Du fest, dass es sich "
    "um einen Geschenkkarton handelt.");
  AddDetail( ({ "geschenkkarton" }),
    "Ein stabiler Geschenkkarton mit der Zahl 73 eingeritzt. Du koenntest "
    "ihn sicher oeffnen.");
  AddDetail( ({ "goldklumpen" }),
    "Wow! Ein riesiger Goldklumpen, mit der Zahl 988, herrlich!");
  AddDetail( ({ "kommode" }),
    "Eigentlich ist die Kommode ein Edelsteinkaestchen.");
  AddDetail( ({ "edelsteinkaestchen" }),
    "Ein schoenes Edelsteinkaestchen mit der Zahl 23 und einer kleinen "
    "Schublade.");
  AddDetail( ({ "schublade" }),
    "Die koenntest Du aufziehen.");
  AddDetail( ({ "bett" }),
    "Auf dem Bett, dass eigentlich ein Topflappen ist, siehst du noch eine "
    "Bettdecke und ein Kopfpolster.");
  AddDetail( ({ "topflappen" }),
    "Ein sehr bequemer Topflappen mit der Zahl 342.");
  AddDetail( ({ "bettdecke" }),
    "Genauer gesagt ist es keine Bettdecke, sonder ein Halstuch.");
  AddDetail( ({ "halstuch" }),
    "Ein schoenes Halstuch, perfekt zum kuscheln geeignet, mit der "
    "Zahl 17.");
  AddDetail( ({ "kopfpolster" }),
    "Als Du Dir den Kopfpolster genauer ansiehst stellst Du fest, dass es "
    "sich um ein Feenkraut handelt.");
  AddDetail( ({ "feenkraut" }),
    "Ein schoenes weiches Feenkraut mit der Zahl 31.");
  AddDetail( ({ "waende" }),
    "Da haengen ja einige Sachen an der Wand.");
  AddDetail( ({ "wand" }),
    "Du siehst ein Bild, ein Alphorn, einen Wandspiegel, einige "
    "Fackelhalter samt Fackeln und einen Kamin.");
  AddDetail( ({ "kamin" }),
    "Eingentlich ist nur der Zierbogen fuer Dich interessant.");
  AddDetail( ({ "zierbogen" }),
    "Prinzipiell ist es ein Hufeisen, das nahe der Ecke im Zimmer steht.");
  AddDetail( ({ "hufeisen" }),
    "Ein hartes Hufeisen in das die Zahl 536 eingeritzt wurde.");
  AddDetail( ({ "fackelhalter" }),
    "Nur einfache Ringe.");
  AddDetail( ({ "ringe" }),
    "Du zaehlst die Ringe durch und siehst genau 9.");
  AddDetail( ({ "fackeln", "fackel" }),
    "Die Fackeln sind schoene robuste Aeste.");
  AddDetail( ({ "aeste" }),
    "An einem Ast faellt Dir etwas auf.");
  AddDetail( ({ "ast" }),
    "Es ist die Zahl 322.");
  AddDetail( ({ "wandspiegel" }),
    "Das ist der Handspiegel von Fippsi der Maus!");
  AddDetail( ({ "fippsi", "maus" }),
    "Die kennst Du sicher.");
  AddDetail( ({ "handspiegel" }),
    "Du siehst in den Handspiegel und siehst Dein eigenes Spiegelbild.");
  AddDetail( ({ "spiegelbild" }),
    "Oh, Du hast ja etwas auf der Stirn.");
  AddDetail( ({ "stirn" }),
    "Du siehst eine ganz grosse 1.");
  AddDetail( ({ "alphorn" }),
    "Hm, eigentlich ist es nur eine kleine Pfeife.");
  AddDetail( ({ "pfeife" }),
    "Vielleicht kann man auf der Pfeife spielen!");
  AddDetail( ({ "bild" }),
    "Eigentlich ist es kein Bild, sondern der beruehmte "
    "Verarsch-Button.");
  AddDetail( ({ "verarsch-button", "button" }),
    "Den Button koenntest Du umdrehen.");
  AddDetail( ({ "decke" }),
    "Tatsaechlich da haengt ja wirklich eine Haengematte an der Decke.");
  AddDetail( ({ "haengematte" }),
    "Genauer gesagt ist es ein Netz, dass mit einem Nagel an der Decke befestigt ist.");
  AddDetail( ({ "nagel" }),
    "Auf dem Nagel sind komische Zeichen eingeritzt worden.");
  AddDetail( ({ "zeichen" }),
    "Dieses Detail ist der Meisterforscherin Aroobah gewidmet.");
  AddDetail( ({ "aroobah", "meisterforscherin" }),
    "Vielleicht solltest Du mal Dapdi danach fragen.");
  AddDetail( ({ "netz", "fischernetz" }),
    "Ein robustes Fischernetz mit der Zahl 686.");
  AddDetail( ({ "ecke", "ecken" }),
    "Huch, da steht ja ein Ohrensessel in einer Ecke.");
  AddDetail( ({ "ohrensessel" }),
    "Eigentlich ist es kein Ohrensessel sondern ein Teddy.");
  AddDetail( ({ "teddy" }),
    "Ein suesser knuddeliger Teddy mit der Zahl 129.");
  AddDetail( ({ "parfumflaeschchen" }),
    "Wenn man ganz genau sein will, ist es eher eine Phiole.");
  AddDetail( ({ "phiole" }),
    "Eine glaeserne Phiole mit der Zahl 126.");
  AddDetail( ({ "apfelstrudel" }),
    "Tatsaechlich entdeckst Du einen angebissenen Apfelstrudel, in "
    "welchem ein Kerzchen steckt.");
  AddDetail( ({ "kerzchen" }),
    "Tja was kann man mit einem Kerzchen machen?");
  AddDetail( ({ "rauch" }),
    "Als Du den Rauch so betrachtest, entdeckst du tatsaechlich "
    "ein Wort im Rauch.");
  AddDetail( ({ "wort", "naar" }),
    "Naar.");
  

  

  AddSmell( DEFAULT_SMELL,
    "Irgendwie riecht es hier sehr suesslich." );
  
 
  AddSound( DEFAULT_SOUND,
    "Hier gibt es keine Geraeusche." );
  AddSound( ({ "geraeusche"}),
    "Keine zu hoeren!");
   
 AddItem(NPC "dapdi", REFRESH_DESTRUCT);
  
AddCmd( ({"zieh", "ziehe" }), "cmd_lade" );
AddCmd( ({"oeffne" }), "cmd_karton" );
AddCmd( ({"dreh", "drehe" }), "cmd_button" );
AddCmd( ({"spiel", "spiele" }), "cmd_pfeife" );
AddCmd( ({"lies", "lese" }), "cmd_etikett" );
AddCmd( ({"fluester", "fluestere" }), "cmd_ausgang" );
AddCmd( ({"zuend", "zuende" }), "cmd_kerze" );	



}

int cmd_kerze(string str){
 notify_fail("Was willst Du anzuenden?\n");

 if(!str || str == "")  return 0;
 if(!(str == "kerzchen an" ||
      str == "das kerzchen an")) return 0;

 write(BS("Du zuendest das kleine Kerzchen an. Es beginnt "
	  "leicht zu rauchen aber das stoert Dich nicht weiter.\n"));

 say(TPN+" macht etwas ganz geheimes.\n");

 return 1;
}

int cmd_ausgang(string str){
 notify_fail("Was willst Du fluestern?\n");

 if(!str || str == "")  return 0;
 if(!(str == "die zahl 5865" ||
      str == "5865")) 
      {
   write(BS("Irgendwie war das die falsche Zahl, quak!"));
   say(TPN+" wird ganz gruen.\n");
   TP->SetProp(P_FROG,1);
   return 1;
      }
	
 write(BS("Du fluesterst die magische Zahl und verschwindest "
	  "aus der Welt des Taschendrachen.\n"));

 say(TPN+" fluestert etwas.\n");
 TP->move(ROOM "brunnen_7", M_GO, "raus", "fliegt");

 return 1;
}

int cmd_etikett(string str){
 notify_fail("Was willst Du lesen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "etikett" ||
      str == "das etikett")) return 0;

 write(BS("Du studierst das Etikett und kannst neben vielem "
	  "unnoetigen Blabla die Zahl 66 ausmachen.\n"));

 say(TPN+" studiert etwas.\n");

 return 1;
}

int cmd_pfeife(string str){
 notify_fail("Auf was willst Du spielen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "pfeife" ||
      str == "auf pfeife")) return 0;

 write(BS("Du spielst eine liebliche Melodie auf der Pfeife und "
	  "vernimmst die Zahl 43 dabei.\n"));

 say(TPN+" spielt auf einem Instrument.\n");

 return 1;

}

int cmd_karton(string str){
 notify_fail("Was willst Du oeffnen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "geschenkkarton")) return 0;

 write(BS("Du oeffnest den Geschenkkarton und entdeckst darin einen "
	  "schoenen glaenzenden Goldklumpen.\n"));

 say(TPN+" macht am Kasten rum.\n");

 return 1;



}

int cmd_button(string str){
 notify_fail("Was willst Du umdrehen?\n");

 if(!str || str == "") return 0;
 if(!(str == "button" ||
      str == "button um" ||
      str == "verarsch-button" ||
      str == "verarschn-button um" )) return 0;

 write(BS("Du drehst den Button um, und entdeckst auf dessen Rueckseite "
	  "die Zahl 62.\n"));
       
 say(TPN+" untersucht was an der Wand.\n");
 

 return 1;
 
} 
int cmd_lade(string str){
 notify_fail("Was willst Du aufziehen?\n");

 if(!str || str == "") return 0;
 if(!(str == "schublade" ||
      str == "schublade auf" )) return 0;
     
 
 write(BS("Du ziehst die Schublade der Kommode auf und entdeckst in der "
	  "Schublade ein Parfumflaeschchen.\n"));

  say(TPN+" wuehlt irgendwo herum.\n");

 return 1;
}

	 

