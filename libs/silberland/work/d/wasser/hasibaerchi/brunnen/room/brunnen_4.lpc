//erstellt von hasibaerchi, nische 



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

int assel=1;
int anz=1;

void create()
{
::create();

  SetProp( P_INT_SHORT, "In einer Nische" );
  SetProp( P_INT_LONG,
    "Du kniest in einer kleine Hoehle, die gerade gross genug fuer Dich "
    "ist. Der Boden ist schroff und kleine scharfe Spitzen ragen aus den "
    "Waenden empor. Hoffentlich schneidest Du Dich nicht daran! Obwohl Du "
    "nicht mehr ueber einem Abgrund haengst, fuehlst Du Dich nicht sicher "
    "hier. Irgendetwas scheint hier auf Dich zu lauern.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Auch aus dem Boden ragen scharfe Spitzen empor.");
  AddDetail( ({ "hoehle", "raum"}),
    "Hier befindest Du Dich. Kein sehr angenehmes Plaetzchen, aber immerhin "
    "noch besser als auf der Leiter zu haengen.");
  AddDetail( ({ "plaetzchen" }),
    "Nicht die Plaetzchen zum essen, sondern der Ort hier! Bist Du Dir "
    "sicher kein Oger zu sein?");
  AddDetail( ({ "ort" }),
    "Eben hier, in einer kleinen Nische.");
  AddDetail( ({ "nische" }),
    "Bis hierher bist Du gekommen, hoffentlich findest Du den Rueckweg noch.");
  AddDetail( ({ "rueckweg" }),
    "Der wird Dich genau zum Abgrund zurueck fuehren. Tja so ist das "
    "Heldenleben eben.");
  AddDetail( ({ "heldenleben" }),
    "Lustig ist das Heldenleben Feyaria ...... !");
  AddDetail( ({ "feyaria" }),
    "Feyaria ist die Mutter aller Berserker, aber sie ist leider nicht hier "
    "um Dir zu helfen.");
  AddDetail( ({ "mutter" }),
    "Du hast sicher auch eine Mutter.");
  AddDetail( ({ "berserker" }),
    "Die maechtigste aller Gilden!");
  AddDetail( ({ "gilden", "gilde" }),
    "Tipp einfach mal, hilfe berserker, dann siehst Du schon wo es richtig "
    "brutal zugeht.");
  AddDetail( ({ "spitze", "spitzen" }),
    "Die Spitzen sehen sehr scharf aus und daher auch sehr gefaehrlich. Also "
    "pass gut auf Dich auf! Sonst liegen nur noch kleine Steinchen am "
    "Boden rum.");
  AddDetail( ({ "steine", "steinchen"}),
    "Diese liegen hier ohne sichtliche Ordnung auf dem Boden.");
  AddDetail( ({ "ordnung"}),
    "Jetzt wo Du es genauer betrachtest, siehst Du doch eine Ordnung in den "
    "Steinen. Wer hat die bloss so geordnet? Allerdings, stoert ein kleiner "
    "Stein diese Ordnung.");
  AddDetail( ({ "stein"}),
    "Um die Ordnung der Steine wieder herzustellen, muesstest Du schon den "
    "Stein wegrollen.");
  AddDetail( ({ "loch"}),
    "Ein uebler Geruch steigt Dir in die Nase. Vielleicht ist es doch besser "
    "wenn Du zuerst eine Muenze in das Loch wirfst, nur zur Sicherheit "
    "natuerlich.");
  AddDetail( ({ "geruch"}),
    "Das kannst Du nicht untersuchen, nur riechen!");
  AddDetail( ({ "nase"}),
    "Genau mit der Nase kannst Du riechen, oder hast Du irgendwo noch eine "
    "Nase versteckt?");
  AddDetail( ({ "wand", "waende"}),
    "Ganz scharfe Spitzen ragen aus den Waenden hervor, genau wie auf "
    "dem Boden.");
  AddDetail( ({ "decke"}),
    "Du untersuchst die Decke und kannst neben den Spitzen kaum Etwas "
    "entdecken.");
  AddDetail( ({ "etwas"}),
    "Sieht wie eine Inschrift aus.");
  AddDetail( ({ "inschrift"}),
    "Die Inschrift besteht aus mehreren Worten und ergibt somit eine "
    "Nachricht.");
  AddDetail( ({ "wort", "woerter", "worte"}),
    "Richtig, Woerter ergeben diese geheime Nachricht!");
  AddDetail( ({ "nachricht"}),
    "Du enzifferst die Nachricht: Braindyl wird kommen!");
  AddDetail( ({ "braindyl"}),
    "Wer auch immer dieser Braindyl sein mag, er scheint ein ganz fieses "
    "Wesen zu sein. Du glaubst sogar Braindyl etwas fluestern zu hoeren.");
  AddDetail( ({ "wesen"}),
    "Du willst Dir gar nicht vorstellen wie dieser Braindyl aussieht, sicher "
    "ganz scheusslich.");
  AddDetail( ({ "abgrund"}),
    "Der befindet sich westlich von Dir. Hier hast Du festen Boden unter "
    "Deinen Fuessen. Irgendwie bist Du sehr froh darueber.");
  AddDetail( ({ "fuss", "fuesse"}),
    "Sehr schmutzig, und irgendwie riechen sie auch sehr streng.");
  AddDetail( ({ "magen"}),
    "Dort grummelt es gewaltigt, vielleicht bist Du krank?");
  AddDetail( ({ "du", "dir", "dich", "deine", "dein" }),
    "Tja, Du bist Du! Du hast eine Nase, Augen, Ohren und noch "
    "vieles mehr.");
  AddDetail( ({ "augen", "auge", "ohren", "ohr", "knie" }),
    "Du kontrollierst Deinen Koerper, zaehlst Deine Koerperteile durch und "
    "stellst erleichtert fest, dass alles noch an seinem richtigen "
    "Platz ist.");
  AddDetail( ({ "koerper", "koerperteile", "platz", "leib" }),
    "Alles dort wo es hingehoert! Zumindest Deiner Meinung nach.");
  AddDetail( ({ "meinung" }),
    "Deine Meinung ist gefragt.");
  AddDetail( ({ "oger" }),
    "Die fressen den ganzen Tag lang diese Oger.");
  AddDetail( ({ "tag" }),
    "Der Tag hat 24 Stunden.");
  AddDetail( ({ "stunden", "stunde"}),
    "Tja, genau so viele hat ein Tag.");
  AddDetail( ({ "leiter"}),
    "Auf der Leiter haengst Du zum Glueck nicht. Sehr erleichtert atmest "
    "Du tief durch.");
  AddDetail( ({ "glueck"}),
    "Du wirst hier Dein ganzes Glueck brauchen, wenn Du ueberleben willst.");
  AddDetail( ({ "tod" }),
    "Wer suchet, der findet. Sag nicht, Du wurdest nicht gewarnt!");
   
    
 
  AddSmell( DEFAULT_SMELL,
    "Der Geruch von Tod und Verwesung liegt in der Luft.");
  AddSmell( ({ "geruch", "luft"}),
    "Es riecht feucht und mufflig. Ob dies von Deinen Fuessen kommt?");
  AddSmell( ({ "tod"}),
    "Er ist schon sehr nahe!");
  AddSmell( ({ "verwesung"}),
    "Das bringt uns wieder zu Deinen Fuessen.");
  AddSmell( ({ "fuesse", "fuss"}),
    "Du hast es so gewollt! Deine Fuesse riechen nach Schimmelkaese, "
    "faulen Eiern und sonstigem grauslichem Zeug. Einfach eklig!");
  AddSmell( ({ "schimmelkaese", "kaese"}),
    "Langsam faengt Dein Magen an zu revoltieren.");
  AddSmell( ({ "magen"}),
    "Deinen Magen kannst Du nicht riechen!");
  AddSmell( ({ "eier", "ei"}),
    "Wie gesagt der Geruch kommt von Deinen Fuessen, und ist wirklich "
    "nicht angenehm.");
  AddSmell( ({ "zeug"}),
    "Du beschliesst das lieber nicht zu tun.");
 

  AddSound( DEFAULT_SOUND,
    "Du hoerst nichts, nur die Stille ist hier zu hoeren." );
  AddSound( ({ "stille"}),
    "Nur Dein Atem durchdringt die Stille, und doch hoerst Du "
    "noch etwas.");
  AddSound( ({ "braindyl"}),
    "Ich werde kommen, und die Mudherrschaft an mich reissen!!!!!!");
  AddSound( ({ "atem"}),
    "Sehr unregelmaessig kommt Dein Atem aus Deinem Koerper. Ob das "
    "an Deinem Herz liegt?");
  AddSound( ({ "herz"}),
    "Noch schlaegt es, nicht ganz regelmaessig, aber immerhin.");

  AddExit( "zurueck", ROOM "brunnen_2" );   

  
AddCmd( ({"greif", "greife"}), "cmd_loch" );
AddCmd( ({"wirf", "werfe"}), "cmd_wurf" );
AddCmd( ({"roll", "rolle"}), "cmd_stein" );
AddCmd( ({"such", "suche"}), "cmd_tod" );

}

int cmd_tod(string str){
    notify_fail("Was suchst Du?\n");

    if(!str || str == "") return 0;
    if(!(str == "tod" ||
	 str == "den tod" )) return 0;
      
    write (BS("Du suchst den Tod, doch finden wirst Du ihn nicht. Vielmehr "
	      "findest Du einen Traum, eine Vision eines alten Mannes. Lausche, "
	      "meinen Worten Du Wanderer und Du wirst Dein Ziel finden. Ich habe "
	      "viele Kinder. Eine meiner Toechter hat genauso viele Schwestern wie "
	      "Brueder, doch jeder meiner Soehne hat doppelt so viele Schwestern "
	      "wie Brueder. Sag mir Wanderer, wie viele Kinder habe ich. Dies ist "
	      "die erste Zahl der Kombination die Du suchst, fuer die zweite "
	      "Zahl nimm die Anzahl der Kinder von Dapdi und Du wirst finden "
	      "was Du suchst.\n"));
 

   
  return 1;

}


int cmd_wurf(string str){
    notify_fail("Was willst Du wohin werfen?\n");

 if(!str || str == "") return 0;
 if(!(str == "muenze in loch" ||
      str == "muenze nach unten" ||
      str == "muenze runter" ||
      str == "muenze hinunter" )) return 0;

 if(TP->QueryMoney()<1)
	 return write (BS("Du hast ja gar keine Muenze!")), 1;

 write(BS("Du wirfst eine Muenze in das Loch hinunter. Nach kurzer Zeit\n"
	  "hoerst du ein leises Plomp. Irgendwas raschelt dort unten.\n"
	  "Vielleicht solltest Du mal in das Loch greifen.\n"));
 
 say(BS(TPN+" wirft eine Muenze in das Loch, wartet einen Moment und\n"
	    "scheint etwas gehoert zu haben.\n"));

 TP->AddMoney(-1);
 "p/daemon/zentralbank"->PayIn(1, 100);

 return 1;
}

int cmd_stein(string str){
    notify_fail("Was willst Du wegrollen?\n");

    if(!str || str == "") return 0;
    if(!(str == "stein" ||
	 str == "stein weg" )) return 0;

    if(anz==0){
	    
    write ("Der Stein ist bereits weggerollt worden.\n");
    return -1;
    }
    write (BS("Du rollst den Stein auf die Seite und entdeckst darunter ein Loch.\n"));
    say(BS(TPN+" scheint irgendwas am Boden zu arbeiten.\n"));

    anz=0;
  return 1;

}

int cmd_loch(string str){
    object koeniginderasseln;
    notify_fail("Wohin willst Du greifen?\n");

    if(!str || str == "") return 0;
    if(!(str == "in loch" ||
	 str == "hinein" )) return 0; 

    if(anz==1){
	    
    write ("Der Stein liegt ja noch auf dem Loch!\n");
    return -1;
    }

    write (BS("Du greifst in das Loch.\n"));
    say(BS(TPN+" scheint etwas gefunden zu haben.\n"));
    this_player()->AddHp(-25);
    
    if(assel){
    
	   koeniginderasseln = clone_object(NPC "koeniginderasseln");
	   koeniginderasseln->move(ENV(TP), M_NOCHECK);
	   assel--;
    }
    else
	    write (BS("Leider findest du nichts in dem Loch. Schau spaeter\n"
		      "noch mal vorbei.\n"));

 return 1;

}

void reset(){
	::reset();
        assel=1;
	anz=1;
}

