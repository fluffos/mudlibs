//erstellt von hasibaerchi 11. raum



#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "Auf einem Balkon" );
  SetProp( P_INT_LONG,
   "Du stehst auf einem kleinen Balkon, von dem Du in eine riesige Hoehle "
   "blickst. Bei den Ausmassen dieser Hoehle fuehlst Du Dich wie eine "
   "Ameise. Was fuer natuerliche Wunder es doch gibt. Oder ist die Hoehle "
   "vielleicht gar nicht natuerlichen Ursprungs?");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Der Boden des Balkons besteht aus schwarzem Marmor.");
  AddDetail( ({ "marmor" }),
    "Ein schwarzer kostbarer Stein. Keine einzige Fuge verunziert diesen Boden.");
  AddDetail( ({ "stein" }),
    "Ein einzelner glatter Stein aus purem Marmor.");
  AddDetail( ({ "fuge" }),
    "Keine einzige Fuge. Beeindruckend, sehr beeindruckend.");
  AddDetail( ({ "ameise" }),
    "Du fuehlst Dich ganz klein und das ist ganz normal bei so "
    "einer gewaltigen Hoehle.");
  AddDetail( ({ "decke" }),
    "Nur nackter Fels, so weit das Auge reicht.");
  AddDetail( ({ "auge" }),
    "Wie gesagt, nur kalter nackter Fels.");
  AddDetail( ({ "hoehle" }),
    "Eine gewaltige Hoehle mit riesigen Ausmassen. Decke und Waende kannst "
    "Du zwar erkennen, aber wo der Grund der Hoehle sein soll, kannst Du "
    "nicht sagen. Der Abgrund, der sich unter dem Balkon auftut, ist zu "
    "tief.");
  AddDetail( ({ "waende" }),
    "Sie bestehen aus nacktem Fels und sind zu weit fuer Dich entfernt. Nur "
    "die Wand, nahe des Balkons, ist fuer Dich erreichbar.");
  AddDetail( ({ "wand" }),
    "Du koenntest versuchen an der Wand entlang zu klettern. Doch sei "
    "vorsichtig, die Wand ist sehr glitschig.");
  AddDetail( ({ "fels" }),
    "Harter nackter Fels. Nicht mehr, aber auch nicht weniger.");
  AddDetail( ({ "wunder" }),
    "Du singst: A Wunder, a Wunder, es is a Wunder gschehn...!");
  AddDetail( ({ "ausmasse", "ausmassen" }),
    "Einfach gigantisch.");
  AddDetail( ({ "grund" }),
    "Du beugst Dich ueber das Gelaender des Balkons und starrst in die "
    "unendliche Tiefe des Abgrunds. Ein gewaltiger Graben tut sich unter "
    "dem Balkon auf. Irgendwo in der Tiefe des Grabens kannst Du ein "
    "Glitzern erkennen.");
  AddDetail( ({ "glitzern", "tiefe" }),
    "Es sieht so aus, als ob sich Irgendetwas da unten spiegeln wuerde.");
  AddDetail( ({ "irgendetwas" }),
    "Was auch immer es ist, es wird von einer Wasseroberflaeche gespiegelt.");
  AddDetail( ({ "wasseroberflaeche", "oberflaeche" }),
    "Es kann sich nur um einen See handeln.");
  AddDetail( ({ "see" }),
    "Ein unterirdischer See.");
  AddDetail( ({ "graben", "abgrund" }),
    "Es geht gewaltig in die Tiefe. Selbstverstaendlich koennte man sich "
    "in den Graben stuerzen, nur muesste man dazu erstens sehr mutig "
    "sein. Und zweitens duerftest Du nicht zu sehr am Leben haengen. Ausser "
    "natuerlich Dein Name waere John Sheridan.");
  AddDetail( ({"mut"}),
    "Tja, mutig sind nur grosse Helden, Helden wie Eidan!");
  AddDetail( ({ "eidan", "held", "helden" }),
    "Einfach mutig, einfach Eidan!");
  AddDetail( ({ "leben" }),
    "Du haengst aber sicher daran und mutig bist Du auch nicht. Also, "
    "lass es lieber sein!");
  AddDetail( ({ "john", "sheridan" }),
    "Diese Geschichte wuerde zu weit fuehren. Sieh es aber einfach als "
    "einen zusaetzlichen Hinweis.");
  AddDetail( ({ "name", "namen" }),
    "Ja, Du hast auch einen Namen.");
  AddDetail( ({ "hinweis", "hinweise" }),
    "Mehr Hinweise wirst Du hier nicht mehr finden.");
  AddDetail( ({ "geschichte" }),
    "Die soll spaeter einmal erzaehlt werden.");
  AddDetail( ({ "ursprung", "ursprungs" }),
    "Das wird fuer immer ein Geheimnis bleiben.");
  AddDetail( ({ "geheimnis" }),
    "Ein Geheimnis kann gelueftet werden, aber nicht hier und nicht "
    "jetzt.");
  AddDetail( ({ "balkon" }),
    "Auf dem stehst Du. Er ist das einzige, das Dich vor dem Abgrund "
    "bewahrt.");
  AddDetail( ({ "gelaender" }),
    "Das Gelaender schuetzt Dich davor, nicht in die Tiefe zu stuerzen. Es "
   "besteht aus gar komischen Bestandteilen.");
  AddDetail( ({ "bestandteile", "bestandteilen" }),
    "Du siehst einige Frauen mit nacktem Oberkoerper und gar eigenartigen "
    "Haaren.");
  AddDetail( ({ "haare" }),
    "Die Haare bilden die Haltestange des Gelaenders. Du bemerkst jedoch "
    "erst jetzt, dass sich die Haare zu bewegen scheinen.");
  AddDetail( ({ "haltestange" }),
    "Oh nein, die Haltestange besteht aus lauter lebenden Schlangen.");
  AddDetail( ({ "schlangen" }),
    "Das kann nur eines bedeuten. Medusen!");
  AddDetail( ({ "medusen", "medusa", "kreatur" }),
    "Eine Medusa ist eine Kreatur mit dem Koerper einer Frau und "
    "gar giftigem Haar.");
  AddDetail( ({ "haar" }),
    "Giftig.");
  AddDetail( ({ "koerper", "frau" }),
    "Richtig, der Koerper einer Frau!");
  AddDetail( ({ "oberkoerper" }),
    "Auf dem nackten Oberkoerper gibt es viele Details zu untersuchen.");
  AddDetail( ({ "details", "detail" }),
    "Selber forschen hilft.");
  AddDetail( ({ "antwort", "freund", "wind" }),
    "Lauschen!");
  AddDetail( ({ "ruecken" }),
    "Auch ein Ruecken kann entzuecken.");
  AddDetail( ({ "bauch", "bauches" }),
    "Aber ein Bauch tuts auch, vorallem wenn Die Mitte so erotisch ist.");
  AddDetail( ({ "mitte" }),
    "Hm, was koennte in der Mitte des Bauches sein?");
  AddDetail( ({ "schultern" }),
    "Wunderschoene elegante Schultern und ein zarter Hals ziert diese.");
  AddDetail( ({" brueste", "brust" }),
    "Typisch! Jetzt kommt sicher der Spruch: Ich forsche ja nur. Wenn es nach "
    "Cherub ginge, koennte man sicher daran knabbern oder reinkneifen.");
  AddDetail( ({ "cherub" }),
    "Befrage Cherub mal nach Bruesten!");
  AddDetail( ({ "spruch" }),
    "Typisch!");
  AddDetail( ({ "nase" }),
    "Die Nase sitzt genau zwischen den schoenen Augen der Medusa. Doch ist da "
    "ein Kruemmel auf der Nase?");
  AddDetail( ({ "kruemmel"}),
    "Vielleicht ist es ja eine geheime Botschaft!");
  AddDetail( ({ "botschaft", "larifari" }),
    "Diese Botschaft ist Larifari gewidmet. Danke fuer das fleissige Typo "
    "melden.");
  AddDetail( ({ "typo" }),
    "Du musst wissen, was Du zu tun hast.");
  AddDetail( ({ "nabel", "bauchnabel" }),
    "Irgendwie laedt Dich der Nabel ein ein bischen darin zu bohren.");
  AddDetail( ({ "huefte", "hueften" }),
    "Sehr weiblich.");
  AddDetail( ({ "hals" }),
    "Sehr zierlich. Auf dem Hals thront ein Kopf. Was denn sonst?.");
  AddDetail( ({ "kopf" }),
    "Du betrachtest den Kopf eingehender und bleibst bei den Augen "
    "der Medusa haengen.");
  AddDetail( ({ "augen" }),
    "Wunderschoene Augen. Du kannst sie natuerlich noch naeher betrachten, "
    "wobei ihre Schoenheit von ihren Lippen in den Schatten gestellt wird.");
  AddDetail( ({ "schatten" }),
    "Schatten gibt es hier genug.");
  AddDetail( ({ "lippe", "lippen", "mund" }),
    "Rote Lippen soll man kuessen.");
  AddDetail( ({ "schoenheit" }),
    "Unvergaengliche Schoenheit.");
  AddDetail( ({ "fontaene" }),
    "Ein Fontaene schiesst in die Tiefe. Wenn Du willst, kannst Du auf "
    "ihr hinunter reiten.");
	  
    
 
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier sehr salzig." );
  AddSmell( ({ "salz" }),
    "Es riecht hier tatsaechlich nach Salz.");
 
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur den Wind." );
  AddSound( ({ "Wind"}),
    "Die Antwort mein Freund .......");
  AddSound( ({ "antwort", "freund" }),
    "...... im Wind.");

  AddItem(NPC "zwerg", REFRESH_DESTRUCT);
  
  
   AddExit( "vorne", ROOM "brunnen_8" ); 
  
AddCmd( ({"kletter", "klettere" }), "cmd_wand" );
AddCmd( ({"bohr", "bohre" }), "cmd_nabel" );
AddCmd( ({"stuerze", "stuerz" }), "cmd_sprung" );
AddCmd( ({"betrachte" }), "cmd_bild" );
AddCmd( ({"kuesse", "kuessen" }), "cmd_lippen" );
AddCmd( ({"reite", "reit" }), "cmd_font" );
AddCmd( ({"kneife", "kneif" }), "cmd_busen" );
AddCmd( ({"knabbere", "knabber" }), "cmd_knab" );



}

int cmd_knab(string str){
 notify_fail("Woran willst Du knabbern?\n");

 if(!str || str == "")  return 0;
 if(!(str == "an brust" ||
      str == "an bruesten" ||
      str == "an der brust" ||
      str == "an den bruesten" )) return 0;

 write(BS("Du nimmst Deine Beisserchen und knabberst so richtig an "
	  "einer Brust herum. Langsam wirst Du so richtig wuschig!\n"));

 say(TPN+" benimmt sich wie ein Ferkel.\n");
 
 return 1;
}

int cmd_busen(string str){
 notify_fail("Wo willst Du hinein kneifen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "in brust" ||
      str == "in brueste" ||
      str == "in brust hinein" ||
      str == "in brust rein" ||
      str == "in brueste hinein" ||
      str == "in brueste rein" ||
      str == "in brust tief hinein" )) return 0;

 write(BS("Du nimmst Deine Finger und kneifst so richtig an "
	  "einer Brust herum. Wie unfein von Dir!\n"));

 say(TPN+" benimmt sich wie ein Ferkel.\n");
 
 return 1;


}

int cmd_nabel(string str){
 notify_fail("Worin willst Du bohren?\n");

 if(!str || str == "")  return 0;
 if(!(str == "im nabel" ||
      str == "in nabel" )) return 0;

 write(BS("Du nimmst Deinen Zeigefinger und bohrst so richtig im "
	  "Nabel herum. Wie unfein!\n"));

 say(TPN+" benimmt sich wie ein Ferkel.\n");
 
 return 1;

}

int cmd_sprung(string str){
 notify_fail("Wohin willst Du stuerzen?\n");

 if(!str || str == "") return 0;
 if(!(str == "in graben" ||
      str == "in tiefe" ||
      str == "in loch" ||
      str == "in abgrund" ||
      str == "in den graben" ||      
      str == "in die tiefe" )) return 0;

 write(BS("Du nimmst Deinen ganzen Mut zusammen und stuerzt Dich mit "
	  "einem lauten BANZAI in die Tiefe.\n"));

  call_out("player_die", 1);	
    
 
  return 1;      
}

  
player_die()
{
  if(!TP)
    return;
  write(BS(""));
  TP->SetProp(P_KILLER, TO);
  SetProp(P_KILL_NAME, "eine saubloede Mutprobe");
  TP->SetProp(P_GHOST, 1);
  TP->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW|M_SILENT);
  TP->SetProp(P_KILLER, 1);
   
 say(TPN+" stuerzt sich in die Tiefe.\n");
 

}

int cmd_bild(string str){
 notify_fail("Was willst Du naeher betrachten?\n");

 if(!str || str == "") return 0;
 if(!(str == "augen naeher" ||
      str == "augen" )) return 0;

 write(BS("Du betrachtest die Augen und bist von ihnen sofort "
	  "fasziniert. So fasziniert, dass Du gar nicht richtig merkst, "
	  "dass Du langsam versteinert wirst.\n"));

 say(TPN+" erstarrt langsam zu Stein.\n");
 TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 14,
                PARALYZE_MSG: "Du bist gerade zu Stein geworden und kannst nichts tun.\n", 
                PARALYZE_END: "Als Du zu Dir kommst, broeckeln Steine von deinem "
                              "Koerper ab. Du bist richtig froh darueber!\n"
                              ]) );	
    return 1;
  }


int cmd_lippen(string str){
 notify_fail("Was willst Du kuessen?\n");

 if(!str || str == "") return 0;
 if(!(str == "lippen" ||
      str == "rote lippen" )) return 0;

 write(BS("Du ueberwindest Deinen Ekel und drueckst Deine Lippen auf "
	  "die Lippen der Medusa. Ein ungutes Gefuehl ueberkommt Dich "
	  "und Du musst unwillkuerlich Deine Angst herunter schlucken. "
	  "Ploetzlich dreht sich der Kopf der Medusa und aus dem "
	  "geoeffneten Mund schiesst eine Fontaene in die Tiefe.\n"));

 say(TPN+" benimmt sich unanstaendig.\n");
 TP->AddPoison(2);

 return 1;
 
} 
int cmd_wand(string str){
 notify_fail("Wohin willst Du klettern?\n");

 if(!str || str == "") return 0;
 if(!(str == "auf wand" ||
      str == "wand" ||
      str == "an wand" ||
      str == "an wand entlang" ||
      str == "wand entlang" )) return 0;
 

write(BS("Du entschliesst Dich an der Hoehlenwand entlang zu klettern. Du "
	 "erkennst dann aber doch, dass die Waende viel zu glitschig sind. "
	 "Dein Ueberlebensinstinkt ist einfach staerker und somit laesst "
	 "Du das Ganze sein.\n"));

 say(TPN+" versucht an der Wand entlang zu klettern.\n");

 return 1;
}
int cmd_font(string str){
 notify_fail("Auf was willst Du hinunter reiten?\n");

 if(!str || str == "")  return 0;
 if(!(str == "auf fontaene runter" ||
      str == "auf fontaene hinunter" )) return 0;

 write(BS("Du spingst in den Strahl und reitest gekonnt auf dem "
	  "Wasser in die Tiefe. Was fuer ein herrliches Gefuehl, "
	  "jedoch haettest Du vorher ueber Deine Landung nachdenken "
	  "sollen. Tja, dafuer ist es jetzt zu spaet! PLATSCH!\n"));

 say(TPN+" stuerzt in die Tiefe.\n");
 this_player()->AddHp(-80);

TP->move(ROOM "brunnen_12", M_GO, "ins Reich des Todes");
 
 return 1;

}
	 

