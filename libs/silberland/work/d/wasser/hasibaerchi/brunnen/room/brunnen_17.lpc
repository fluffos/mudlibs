
#include "../def.h"

inherit "std/room";
inherit "std/player/moneyhandler";

void create()
{
::create();

  SetProp( P_INT_SHORT, "In einem Ozean" );
  SetProp( P_INT_LONG,
   "Du schwimmst im Ozean. Weit und breit kein Festland oder Insel zu sehen. "
   "Du bist allein, und keiner kann Dir helfen. Hoffentlich geht Dir nicht "
   "bald Deine Kraft aus, sonst wirst Du Dich auf dem Grund des Meeres "
   "wieder finden, als Fischfutter!\n");

  SetProp( P_LIGHT, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_WATER]) );

  AddDetail( ({ "boden" }),
    "Du meinst sicher den Grund des Meeres.");
  AddDetail( ({ "grund" }),
    "So mitten im Ozean ist der Grund sicher tief unter Dir. Besser Du "
    "bleibst hier an der Oberflaeche.");
  AddDetail( ({ "oberflaeche" }),
    "Du schwimmst auf dem Ozean. Mehr gibt es da nicht zu beschreiben.");
  AddDetail( ({ "ozean" }),
    "Der Ozean erstrahlt im tiefsten blau. Kleine Wellen treiben Dich hin "
    "und her und erfordern Deine ganze Kraft nicht abzutreiben.");
  AddDetail( ({ "wellen" }),
    "Zu Deinem Glueck sind sie wirklich nur sehr klein.");
  AddDetail( ({ "glueck" }),
    "Noch ist es Dir hold. Du bist wirklich sehr froh darueber.");
  AddDetail( ({ "insel", "festland" }),
    "Tja, die Insel ist weit und breit nicht zu sehen. Echt schade, jetzt "
    "wird Dir nichts anderes ueber bleiben als heldenhaft zu ertrinken.");
  AddDetail( ({ "fischfutter" }),
    "Du solltest wirklich aufpassen. Es gibt genug Wesen, die gerne an "
    "Deinem Kadaver laben wuerden.");
  AddDetail( ({ "kadaver" }),
    "Du beginnst zu wuergen.");
  AddDetail( ({ "kraft" }),
    "Lang wird Deine Kraft nicht mehr reichen. Beeile Dich Festland zu finden.");
  AddDetail( ({ "wesen" }),
    "Mit Deiner lebhaften Fantasie kannst Du Dir einiges vorstellen.");
  AddDetail( ({ "fantasie" }),
    "Du beginnst zu zittern.");
  AddDetail( ({ "himmel" }),
    "Vom Himmel brennt die Sonne herunter und verbrennt Deine Haut.");
  AddDetail( ({ "haut" }),
    "Deine Haut ist bereits feuerrot! Mach etwas dagegen!");
  AddDetail( ({ "sonne"}),
    "Sie brennt auf Dich herab. Kaum eine der Wolken, die am Himmel sind, "
    "schuetzt Dich vor den heissen Strahlen.");
  AddDetail( ({ "strahlen" }),
    "Die Strahlen sorgen dafuer, dass Deine Haut schon fast zu gluehen "
    "beginnt.");
  AddDetail( ({ "wolken" }),
    "Die Wolken sind am Himmel und geben Dir nur wenig Schutz vor der "
    "brennenden Sonne.");
  AddDetail( ({ "schutz" }),
    "Viel ist es nicht. Oder hast Du etwa mehr von einfachen kleinen Wolken "
    "erwartet, die den Himmel und den Horizont bedecken?");
  AddDetail( ({ "horizont" }),
    "Da ist ja wirklich eine Formation am Horizont! Ob das die Insel ist?");
  AddDetail( ({ "formation" }),
    "Nur nicht die Hoffnung aufgeben. Schwimm weiter solange Deine Kraft noch "
    "reicht.");
  AddDetail( ({ "meer", "meeres" }),
    "Meer oder Ozean? Beides aendert nichts an Deiner Situation.");
  AddDetail( ({ "situation" }),
    "Du findest Deine Situation ziemlich feucht und nass.");
  AddDetail( ({ "hoffnung" }),
    "Wenn Du Dich wirklich an diesen Strohhalm klammern willst, dann schwimm "
    "doch einfach auf die Formation zu. Du wirst schon sehen, was Dir dann "
    "passieren wird.");
  AddDetail( ({ "strohhalm" }),
    "Du bist Deines Schicksals Schmied!");
  AddDetail( ({ "schicksal", "schicksals" }),
    "Dein Schicksal ist es sicher, hier auf dem Ozean zu ertrinken.");
  AddDetail( ({ "schmied" }),
    "Noch hast Du Dein Schicksal in Deiner Hand.");
  AddDetail( ({ "hand" }),
    "Noch!");
  AddDetail( ({ "dich", "deines", "dir" }),
    "Dafuer solltest Du eigentlich gezapt werden!");
  AddDetail( ({ "wasser", "meerwasser" }),
    "Sehr nass, irgendwie typisch fuer Wasser.");
   
  
 
  AddSmell( DEFAULT_SMELL,
    "Es riecht sehr salzig hier. Das ist sicher das Meerwasser." );
  AddSmell( ({ "wasser", "meerwasser" }),
    "Es riecht sehr salzig.");
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst leises Kreischen. Ganz weit, ganz leise." );
  AddSound( ({ "kreischen"}),
    "Du bist sicher, dass das Kreischen von Moewen stammen muss.");
  AddSound( ({ "moewen" }),
    "Du kannst sie hoeren, aber nicht sehen. Weit kann das Festland "
    "nicht weg sein.");
  AddSound( ({ "festland" }),
    "Bissl weit weg, meinst Du nicht?");
  
  
  
AddCmd( ({"tauche", "tauch" }), "cmd_ausgang" );
AddCmd( ({"schwimme", "schwimme" }), "cmd_wasser" );

}

int cmd_wasser(string str){
 notify_fail("Worauf willst Du zuschwimmen?\n");

 if(!str || str == "")  return 0;
 if(!(str == "auf formation zu" )) return 0;

 write(BS("Du hoffst auf ein Wunder und schwimmst auf die Formation zu. "
	  "Und tatsaechlich ist Dir das Glueck hold. Du erreichst wirklich das "
	  "Festland. Erleichtert beginnst Du den Sand des Strandes zu kuessen.\n"));

 say(TPN+" schwimmt einfach weg.\n");
 TP->move( "/d/wasser/hiri/inselversteck/room/insel4.lpc", M_GO, "verschwindet");

 return 1;

 
} 
int cmd_ausgang(string str){
 notify_fail("Wohin willst Du tauchen?\n");

 if(!str || str == "") return 0;
 if(!(str == "nach unten" ||
      str == "zum grund" ||
      str == "runter" ||
      str == "hinunter" ||
      str == "unten" )) return 0;
 
  write(BS("Trotz der Unlogik dieses Unterfangens, holst Du tief Luft und tauchst "
	   "in die Tiefe. Hast Du erwartet etwas zu finden, ausser Deinen Tod? "
	   "Wenn ja, wirst Du enttaeuscht werden! Du beginnst langsam Wasser zu "
	   "schlucken. Doch wie durch ein Wunder schaffst Du es tatsaechlich doch "
	   "noch rechtzeitig aufzutauchen.\n"));

  say(BS(TPN+" taucht nach unten und taucht nach langer Zeit mit gruenem Gesicht "
	     "wieder auf.\n"));
  this_player()->AddHp(-28);
	       

 return 1;
}


	 

