
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Im Hoehlensystem");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:19, ENV_TERRAIN:TT_CAVE]));

  AddExit("nordosten", ROOM("c5_2"));
  AddExit("westen", ROOM("a6_2"));
  AddExit("sueden", ROOM("b7_2"));
}


