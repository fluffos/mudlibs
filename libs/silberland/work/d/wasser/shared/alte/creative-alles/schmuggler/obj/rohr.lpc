
#include "../files.h"
#include <thing.h>
#include <language.h>
#include <properties.h>
#include <material.h>
#include <moving.h>

inherit "/std/thing";

string last_env;

create() {
  if (!is_clone(this_object()))
    return;

  ::create();

  AddId("fernrohr");
  AddId("rohr");
  AddId("\nschmugglerfernrohr");
  SetProp(P_SHORT, "Dein magisches Fernrohr");
  SetProp(P_LONG, BS("Das ist Dein magisches Fernrohr. Es befoerdert Dich zu Deinen eigenen Phantasien."
                    +" Benuetze das Kommando 'hupf in gatsch' bzw. 'hupf retour'... Das Fernrohr merkt"
                    +" sich Deinen letzten Aufenthaltsort. Falls Du Unfug treibst, so wird das Fernrohr"
                    +" eingezogen! mit 'hupf heim' kommst Du in fehlerhaften Faellen an einen sicheren"
                    +" Ort zurueck."));

  SetProp(P_NAME, "Fernrohr");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, ([MAT_GOLD, 100]));

  AddCmd("hupf", "move_me");
  last_env = "";
}

move_me(str) {

  notify_fail("Wohin willst Du hupfen?\n");
  if (!str)
    return 0;
  if (str == "")
    return 0;
  if (member(GHOSTWRITERS, getuid(TP)) == -1) {
    write("Du darfst das nicht!\n");
    call_out("remove", 1);
    return 1;
  }
    if (TP->InFight()) {
    write("Du kannst jetzt nicht fluechten.\n");
    return 1;
  }
  if (str == "in gatsch") {
    last_env = file_name(ENV(TP));
    TP->move(STARTROOM, M_TPORT);
    return 1;
  }
  if (str == "retour") {
    if (last_env == "") {
      write("Du bist hier aufgewacht! Du kannst nicht retour gehen...\n");
      return 1;
    }
    TP->move(last_env, M_TPORT);
    last_env = "";
    return 1;
  }
  if (str == "heim") {
    if (last_env != "") {
      write("Hupf lieber retour! So wird das nix.\n");
      return 1;
    }
    TP->move("/d/ebene/creative/silberwald/room/vorraum_cadrim", M_TPORT);
    return 1;
  }
  return 0;
}

