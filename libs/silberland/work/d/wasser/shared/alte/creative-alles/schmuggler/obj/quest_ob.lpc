inherit "std/thing";

#include "../files.h"
#include <thing.h>
#include <language.h>
#include <properties.h>
#include <wizlevels.h>
#include <moving.h>

#define CODE_SILBEN ({ "al", "bin", "aer", "en", "dil", "che", "mist" })

// Besitzer
private string owner;

// Codewort
private string code;

// Reihenfolge der Edelsteine
private mapping gems;

// Queststatus
private int quest_state;

create()
{
  if (!is_clone(TO))
    return;
  
  ::create();
  
  owner = getuid();
  code = "";
  gems = ([ ]);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Questobjekt");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE,0);
  SetProp(P_NODROP,1);
  SetProp(P_AUTOLOADOBJ,1);
  SetProp(P_NEVERDROP,1);
  AddId( SCHMUGGLER_QUESTOB );
  roll_params();
}

mixed _query_autoloadobj()
{
  return ({ code, gems, owner });  
}

void _set_autoloadobj(mixed a)
{
  if (pointerp(a) && sizeof(a)==3)
  {
    owner = a[0];
    code = a[1];
    gems = a[2];
  }
}

int check(mixed po) {
  string prev;

  if (!TIPO)
    return 0;
  if (IS_ARCH(TI))
    return 1;
  if (stringp(po) && po == "")
    return 1;
  prev = explode(file_name(PO), "#")[0];
  if (stringp(po) && prev == po)
    return 1;
  if (objectp(po) && member(po, prev) != -1)
    return 1;
  return 0;
}

int set_owner(string o) {
  if (check(NPC("schmugglerjunge")))
    owner = o;
}

void roll_params() {
  string *syllables, *gems, *gem_rooms;
  int i, j;

  syllables = CODE_SILBEN;
  gems = SCHMUGGLER_GEMS;
  gem_rooms = SCHMUGGLER_GEM_ROOMS;

  for ( i = random(3) + 2; i >= 0; i-- ) {
    j = random( sizeof( syllables ) );
    code += syllables[j];
    syllables -= ({ syllables[j] });
  }
}

string query_code() {
  if (check(""))
    return code;
  return "";
}

mapping query_gems() {
  if (check(SCHMUGGLER_GEM_ROOMS))
    return gems;
  return ([ ]);
}

string query_gem() {
  if (!check(SCHMUGGLER_GEM_ROOMS))
    return "";
  return gems[file_name(PO)];
}

int query_state(int state) {
  if (check(""))
    return quest_state & state;
  return -1;
}

void set_state(int state) {
  if ( check("") && (query_state(state) ) == 0)
    quest_state |= state;
}

void proceed_to_letter(string s) {
  if (find_call_out("proceed_to_letter2") == -1)
    call_out("proceed_to_letter2", 4, s);
}

void proceed_to_letter2(string s) {
  object env;

  env = ENV(TO);
  if (env)
    tell_object(env, s);
}

string query_owner() {
  if (check(""))
    return owner;
  return "";
}

