inherit "std/container";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <material.h>
#include <vt100.h>
#include "../files.h"
#include "/p/daemon/skillmaster/skillmaster.h"


create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein kleiner Murmelbeutel");
  SetProp(P_LONG, BS(
          "Dieser kleine Murmelbeutel dient dazu, ein paar Murmeln aufzunehmen, damit"
         +" man damit Murmel spielen kann. Er besteht komplett aus Leder und hat"
         +" am oberen Rand ein kleines Lederbaendchen angenaeht, so dass man den Beutel"
         +" auch verschliessen kann."));
  SetProp(P_NAME, "Murmelbeutel");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 5000);
  SetProp(P_MATERIAL, MAT_LEATHER);
  AddId( ({ SCHMUGGLER_MURMELBEUTEL, "beutel", "murmelbeutel" }) );
  AddCmd(({"schnippe", "schnipp", "schnippse", "schnipps"}), "flip");
  AddCmd(({"murmelspielregeln", "msr"}), "rules");
  AddCmd(({"murmelspielliste", "msl"}), "game_list");
}

int _query_value() {
  return SCHMUGGLER_WARE_WERT;
}

string _query_info() {
  string s, c_long, c_short, c_attr, c_normal;

  switch (TP->QueryProp(P_TTY)) {
    case "ansi":
      c_long=VT_TA_B+VT_CYAN;
      c_short=VT_TA_B+VT_YELLOW;
      c_attr=VT_GREEN;
      c_normal=VT_TA_AO;
      break;
    case "vt100":
      c_long=VT_TA_B;
      c_short=VT_TA_B;
      c_attr="";
      c_normal=VT_TA_AO;
      break;
    default:
      c_long=c_short=c_attr=c_normal="";
  }
  s="Mit diesem Beutel kannst Du Murmel spielen. Eine Uebersicht ueber die\n"
   +"moeglichen Spiele erhaeltst Du mit\n"
   +" <"+c_long+"murmelspielliste"+c_normal+"> / <"+c_short+"msl"+c_normal+">,\n"
   +"die Regeln zu den Spielen erhaeltst Du mit\n"
   +" <"+c_long+"murmelspielregeln"+c_normal+" "+c_attr+"#"+c_normal+"> / <"+c_short+"msr"+c_normal+" "+c_attr+"#"+c_normal+">\n"
   +"Um zu spielen, musst Du den Beutel mit Murmeln gefuellt haben,\n"
   +"die Murmeln bewegst Du, indem Du sie mit den Fingern schnippst.\n";
  return s;
}

varargs int PreventInsert(object o) {
  if (!o->id(SCHMUGGLER_MURMEL))
    return 1;
  return ::PreventInsert(o);
}

int obtain_flipping_skill(object pl) {
  int start_skill, maxskill, maxunlearn;
  int dex;

  dex = pl->QueryAttribute(A_DEX);

  start_skill=1000 + ((random(3)+2) * (dex*10));
  maxskill=10000; maxunlearn=4000;
  call_other(SKILLMASTER, "???");
  SKILLMASTER->AddSkill(pl, SK_FLIPPING, start_skill, maxskill,
      maxunlearn, SK_FLIPPING_NAME);
  return 1;
}

flip(string str) {
  object e;
  string args;
  int success, dex;

  if (!str)
    return 0;
  if (str=="")
    return 0;
  if (sscanf(str, "murmel %s", args)!=1)
    return 0;
  e=ENV(TO);
  if (!e->id("Spieler")) {
    write("Du musst den Beutel schon bei Dir haben!\n");
    return 1;
  }
  if (!present(SCHMUGGLER_MURMEL, TO)) {
    write("Du musst mindestens eine Murmel im Beutel haben!\n");
    return 1;
  }
  call_other(SKILLMASTER, "???");
  if (interactive(TP) && (SKILLMASTER->QuerySkill(TP, SK_FLIPPING)==-1))
    obtain_flipping_skill();
  success = SKILLMASTER->UseSkill(TP, SK_FLIPPING);
  dex = TP->QueryAttribute(A_DEX);
  if (success > 0) {
  }
  else {
  }
  return 1;
}

game_list(string str) {
  string s;

  s="\nFolgende Spiele kannst Du derzeit spielen:\n"
   +"------------------------------------------\n";
  write(s);
  return 1;
}

rules(string str) {
}

