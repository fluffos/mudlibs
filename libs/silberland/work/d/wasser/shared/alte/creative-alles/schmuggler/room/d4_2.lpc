
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Im Hoehlensystem");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:19, ENV_TERRAIN:TT_CAVE]));

  AddExit("osten", ROOM("e4_2"));
  AddExit("suedwesten", ROOM("c5_2"));
  AddExit("sueden", ROOM("d5_2"));
  AddExit("norden", ROOM("d3_2"));
}


