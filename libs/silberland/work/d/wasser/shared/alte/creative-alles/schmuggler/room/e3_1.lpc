
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Sandstrand");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:24, ENV_TERRAIN:TT_PLAIN]));

  AddExit("norden", ROOM("e2_1"));
  AddExit("suedosten", ROOM("f4_1"));
}


