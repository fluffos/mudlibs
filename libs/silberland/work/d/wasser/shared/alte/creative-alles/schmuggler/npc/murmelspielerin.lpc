#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

inherit "std/npc";

int in_game;

create()
{
  if (!is_clone(this_object())) return;
  seteuid(getuid(this_object()));

  ::create();

  SetProp(P_SHORT, "Canica, das Schmugglermaedchen");
  SetProp(P_LONG, BS(
          "Das Schmugglermaedchen laechelt Dich aus froehlichen Augen an. Sie"
         +" ist fuer ihr Alter schon recht gross und wirkt trotzdem sehr zierlich."
         +" Ihre langen dunkelbraunen Haare haengen ihr bis zum Ellbogen hinab,"
         +" und ihr schlichtes Gewand laesst die Haare noch besser zur Geltung kommen."));

  SetProp(P_WEIGHT, 41000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Canica");
  SetProp(P_GENDER, FEMALE);
  AddId(({"maedchen", "schmugglermaedchen", "canica"}));
  create_default_npc(16);
  SetProp(P_ALIGN, -40);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_SPELLRATE, 20);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 150);
  SetProp(P_DEFAULT_INFO, ({
          "sagt: Davon habe ich noch nie etwas gehoert.\n",
          "blickt beschaemt auf den Boden.\n",
          "fragt Dich: Woher soll ich denn das herkriegen?\n" }));
  SetProp(P_HANDS, ({" mit geschickten wendigen Fingern", 30, DT_BLUDGEON}));
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Das Schmugglermaedchen sagt: Das kann ich doch nicht brauchen...\n" }));

  AddInfo(({"murmeln", "murmel"}),
          "Ich spiele am  liebsten den ganzen Tag lang mit Murmeln. Moechtest Du denn auch einmal"
         +" mit mir spielen? Du kannst mich einfach nach Murmelspiel fragen, dann koennen wir es ja mal"
         +" versuchen...", "sagt: ");
  AddInfo("murmelspiel", "@@game@@");

  SetChats(2, ({
           "Canica sagt: Wenn doch jemand mit mir Murmel spielen wuerde...\n",
           "Canica blickt betruebt zu Boden.\n",
           "Canica fragt Dich: Moechtest Du mit mir Murmel spielen?\n"
           }));
 
  clone_object("/d/dschungel/feyaria/tijara/armour/kleidchen")->move(TO);
  clone_object("/p/armour/boots/sandalen")->move(TO);

  command_me("ziehe alles an");
  in_game=0;
}

game() {
  object ob, qo;
  int i;
  string who, ware, dest, *waren;

  who = getuid(TP);
  if ( (qo = deep_present(SCHMUGGLER_QUESTOB, TP)) && (qo->query_owner() == who) 
      && (qo->query_state(SCHMUGGLER_MURMEL_GESPIELT) ) ) {
    return "sagt: Du hast doch schon einen Auftrag von mir angenommen, fuehre den doch mal aus!\n";
  }
  return "laechelt Dich freundlich an.\n";
}

