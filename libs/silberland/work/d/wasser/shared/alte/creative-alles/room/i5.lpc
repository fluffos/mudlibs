inherit "/std/room";

#include <room.h>
#include <properties.h>
#include <moving.h>
#include "../sys/sea.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Riff");
  SetProp(P_INT_LONG, "Du befindest Dich mitten im Riff.\n");
  SetProp(P_LIGHT, 1);
 
  AddSpecialExit("osten", "ov_1");
  AddSpecialExit("westen", "ov_2");
}

ov_1()
{
  object des;

  des=OV_MSTR->init_new_player(this_player(), 26, 70);
  this_player()->move(des, M_GO, "nach Osten", "nimmt sich ein Boot und paddelt", "paddelt herein");
  return 1;
}

ov_2()
{
  object des;

  des=OV_MSTR->init_new_player(this_player(), 24, 70);
  this_player()->move(des, M_GO, "nach Westen", "nimmt sich ein Boot und paddelt", "paddelt herein");
  return 1;
}

