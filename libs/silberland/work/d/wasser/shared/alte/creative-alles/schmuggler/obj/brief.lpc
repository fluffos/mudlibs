inherit "std/thing";

#include <wizlevels.h>
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <material.h>
#include "../files.h"

string sender;

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();

  sender = "einem Unbekannten (?)";
  SetProp(P_SHORT, "Ein versiegelter Brief");
  SetProp(P_LONG, BS(
          "Ein versiegelter Brief, den Du von " + sender + " erhalten hast."
         +" Darin stehen vermutliche vertrauliche Informationen. Du vermutest, dass"
         +" es sich um eine neue Bestellung handeln koennte."));
  SetProp(P_NAME, "Brief");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 35);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, "Den Brief solltest Du schoen seinem Empfaenger zustellen!\n");
  SetProp(P_NEVERDROP, "Den Brief solltest Du schoen seinem Empfaenger zustellen!\n");
  SetProp(P_MATERIAL, MAT_PAPER);
  AddId( ({ SCHMUGGLER_BRIEF, "brief" }) );
  AddAdjective("versiegelt");
}

int set_sender(string s) {
  if (!TIPO)
    return 0;
  if (IS_ARCH(TI) || member(SCHMUGGLER_WARE_ABNEHMER, file_name(PO)) != -1) {
    sender = s;
    return 1;
  }
  return 0;
}

