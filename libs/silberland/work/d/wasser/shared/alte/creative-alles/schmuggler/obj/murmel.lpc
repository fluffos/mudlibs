inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <material.h>
#include "../files.h"

#define COLORS ({ "blaeulich", "gruenlich", "roetlich",  "gelblich", "violett" })
#define ATTRS ({ "durchsichtig", "schillernd", "gestreift", "gemustert", "milchig" })

string color, attr;
int size;

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Eine Murmel");
  SetProp(P_NAME, "Murmel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "");
  SetProp(P_NOSELL);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_GLASS);
  AddId( ({ SCHMUGGLER_MURMEL, "murmel" }) );

  color = COLORS[random(sizeof(COLORS))];
  attr = ATTRS[random(sizeof(ATTRS))];
  size = 14 + random(3);
  
  AddAdjective(({color, color+"e"}));
  AddAdjective(({attr, attr+"e"}));
}

long() {
  return BS(
      "Diese "+color+" "+attr+"e Murmel besteht aus Glas und hat einen Durchmesser von circa "+size
     +" Millimetern. Mit ihr kannst Du Murmel spielen, dazu musst Du sie natuerlich werfen.");
}

into_bag(object bag) {
  int ret;

  ret=::move(bag, M_PUT);
  if (ret==1) {
    write("Du steckst die Murmel in den Murmelbeutel.\n");
    say(TPN+" steckt eine Murmel in einen Murmelbeutel.\n");
  }
}

varargs int move(mixed dest, int method) {
  object b;

  if (dest && ( method & M_GET || method & M_GIVE ) && dest->id("Spieler")) {
    if ( b = (present(SCHMUGGLER_MURMELBEUTEL, dest)) ) {
      into_bag(b);
      return ME_CANT_BE_TAKEN;
    }
    write("Du hast keinen Murmelbeutel dabei!\n");
    return ME_CANT_BE_TAKEN;
  }
  return ::move(dest, method);
}


