inherit "/std/room";

#include <room.h>
#include <properties.h>
#include <moving.h>
#include "../sys/sea.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Wald-Insel");
  SetProp(P_INT_LONG, "Du befindest Dich auf der Wald-Insel (Nr. 6).\n");
  SetProp(P_LIGHT, 1);
 
  AddSpecialExit("osten", "ov_1");
}

ov_1()
{
  object des;

  des=OV_MSTR->init_new_player(this_player(), 74, 95);
  this_player()->move(des, M_GO, "nach Osten", "nimmt sich ein Boot und paddelt", "paddelt herein");
  return 1;
}

