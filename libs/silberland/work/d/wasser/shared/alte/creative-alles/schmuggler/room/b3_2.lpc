
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Felshang");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_MOUNTAIN]));

  AddExit("sueden", ROOM("b4_2"));
  AddCmd(({"kletter", "klettere"}), "down");
}

down(string str) {
  notify_fail("Wohin moechtest Du klettern?\n");
  if (!str)
    return 0;
  if (str == "")
    return 0;
  if ( member( ({ "runter", "hinunter", "hinab", "abwaerts" }), str ) == -1)
    return 0;
  write("Du kletterst geschickt die Felswand hinab.\n");
  TP->move(ROOM("b3_1"), M_GO, "", "klettert geschickt die Felswand hinab",
      "klettert geschickt von oben herab");
  return 1;
}



