inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein exotisches Milchkaennchen mit Eselsmilch");
  SetProp(P_LONG, BS(
          "Dieses Milchkaennchen ist randvoll mit exquisiter exotischer Eselsmilch."
         +" Das Kaennchen ist aus Metall und hat einen verschliessbaren Deckel, damit"
         +" der Inhalt wohlbehalten an seinen Empfaenger gebracht werden kann."
         +" Die Herkunft der Eselsmilch ist Dir schleierhaft, jedoch scheint es sich"
         +" um ein sehr wertvolles Naturprodukt zu handeln."));
  SetProp(P_NAME, "Milchkaennchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, SCHMUGGLER_WARE_WERT);
  SetProp(P_MATERIAL, MAT_BRASS);
  AddId( ({ SCHMUGGLER_MILCH, "milchkaennchen", "kaennchen" }) );
  AddAdjective("exotisches");
}

varargs move(mixed dest, int method) {
  object qo;
  string s;

  if (dest && dest == MIDAS_LAGER) {
    qo = present(SCHMUGGLER_QUESTOB, TP);
    if (qo) {
      s = break_string(
          "Ich habe das Kaennchen extra fuer Albin bereitgelegt. Du solltest nun schleunigst"
          +" zu ihm gehen und ihm das geheime Codewort, das Du von dem Schmugglerjungen"
          +" erhalten hast, fluestern!", 78, "Landar teilt Dir mit: ");
      qo->proceed_to_letter(s);
      qo->set_state(SCHMUGGLER_WARE_VERKAUFT);
    }
  }
  return ::move(dest, method);
}

