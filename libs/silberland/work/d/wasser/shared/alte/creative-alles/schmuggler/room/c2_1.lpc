
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Sandstrand");
  SetProp(P_INT_LONG, BS(
          "Du gehst den kleinen Strand entlang und drueckst Dich eng an die Klippen um so"
         +" gut wie moeglich mit den Schatten zu verschmelzen. Hier ist der Sandstreifen"
         +" nicht mehr ganz so breit. Der Mond spiegelt sich im Meer und verursacht ein"
         +" eigenartiges Funkeln und Glitzern, das liegt wohl auch an der etwas aufgewuehlten"
         +" See. Richtig unheimlich wie unruhig das Meer im Moment ist. Ein paar Schritte"
         +" weiter weg von Dir siehst Du etwas im Sand liegen."));
  AddDetail(({"boden", "sand"}), BS(
            "Der Sand ist hier sehr feinkoernig und daempft jeden Deiner Schritte. Nicht weit"
           +" von Dir siehst Du etwas im Sand liegen, es sieht aus wie ein kleiner Haufen."));
  AddDetail("schritte", BS(
            "Du bist froh, dass der Sand Deine Schritte daempft, denn falls hier jemand ist"
           +" wird er Dich nicht hoeren koennen."));
  AddDetail("haufen", BS(
            "Du atmest noch einmal tief ein und gehst gebueckt zu dem Haufen, um ihn Dir naeher"
           +" anzusehen. Es handelt sich dabei um die Reste eines Lagerfeuers. Anscheinend ist die"
           +" Insel doch nicht so verlassen wie Du zuerst angenommen hast."));
  AddDetail("reste", BS(
            "Nur noch ein Haufen verkohlter Reste sind davon uebrig."));
  AddDetail(({"feuer", "lagerfeuer"}), BS(
            "Die Reste eines erst kuerzlich angezuendeten Lagerfeuers beweisen deutlich, dass"
           +" hier noch jemand ausser Dir hier war - oder ist."));
  AddDetail(({"see", "meer"}), BS(
            "Das Meer wird vom Wind aufgepeitscht, hohe Wellen naehern sich dem Strand,"
           +" ueberschlagen sich dort mit lautem Tosen und Du musst aufpassen dass Du"
           +" nicht nass wirst."));
  AddDetail("wellen", BS(
            "Die Wellen sind unterschiedlich hoch und darum unberechenbar. Pass auf dass Du"
           +" nicht nasse Fuesse kriegst."));
  AddDetail("fuesse", BS(
            "Nasse Fuesse (wie Du sicher weisst) sind alles andere als gesund. Man holt sich"
           +" dann leicht einen Schnupfen."));
  AddDetail("schnupfen", BS(
            "Hatschiiiii! Es faengt schon an."));
  AddDetail("tosen", BS(
            "Du solltest dem Tosen einmal genauer lauschen."));
  AddDetail("wind", BS(
            "Der Wind peitscht die Wellen hoch und weht Dir den Sand ins Gesicht, zerrt an Deinen"
           +" Kleidern und macht es Dir unmoeglich, auf verdaechtige Geraeusche acht zu geben."));
  AddDetail("gesicht", BS(
            "Du verzerrst Dein Gesicht, um es so gut wie moeglich vor dem Wind zu schuetzen."));
  AddDetail("kleider", BS(
            "Der Sand kriecht in jede noch so kleine Ritze Deiner Kleider und ploetzlich juckt"
           +" es Dich ueberall. Du fluchst wild und presst Dich enger an die Klippen, die Dich"
           +" jedoch kaum vor dem Wind schuetzen."));
  AddDetail("klippen", BS(
            "Eng an die Klippen gepresst wanderst Du den Strand entlang. In ihrem Schatten bist"
           +" Du kaum zu sehen, was Dir sehr gelegen kommt. Fast senkrecht ragen sie in den Himmel,"
           +" und Du denkst nicht einmal daran, hier hochzuklettern."));
  AddDetail("insel", BS(
            "Du kannst noch nicht abschlaetzen wie gross diese Insel ist, geschweige denn ob sie"
           +" unbewohnt ist oder nicht. Dazu muesstest Du Dich noch genauer umsehen."));
  AddDetail("mond", BS(
            "Der Mond ist fast voll und sieht so aus als wuerde er grinsen. Du grinst zurueck."));
  AddDetail(({"glitzern", "funkeln"}), BS(
            "Der Mond verbreitet ein wenig Licht welches vom Meer reflektiert wird. Es sieht so aus"
           +" als wuerde es funkeln und glitzern."));
  AddDetail("licht", BS(
            "Ausser dem Licht des Mondes ist es hier sehr dunkel. Das kommt Dir ganz gelegen,"
           +" so kannst Du zwar nicht viel sehen, aber falls jemand kommen sollte, bist Du"
           +" jederzeit in der Lage, unbemerkt in den Schatten verschwinden."));
  AddDetail("lage", BS(
            "Du bist jederzeit in der Lage dazu, in den Schatten zu verschwinden."));
  AddDetail("schatten", BS(
            "Das Licht des Mondes wirft bizarre Schatten, die es anderen unmoeglich machen sollte"
           +" Dich zu entdecken."));
  AddDetail("himmel", BS(
            "Der Himmel ist fast schwarz und voller Wolken. Nicht einmal der starke Wind vermag"
           +" es, diese zu verblasen. Nur der Mond ist deutlich sichtbar."));
  AddDetail("wolken", BS(
            "Duenne, hohe Wolken. Du kennst Dich mit dem Wetter zwar nicht aus, weisst aber"
           +" doch dass das nichts gutes verheisst."));
  AddDetail("wetter", BS(
            "Eigentlich hast Du keine Ahnung vom Wetter, aber diese Wolken verheissen sicher"
           +" nichts gutes."));
  AddDetail("ritze", BS(
            "Der Sand dringt in jede Ritze Deiner Kleidung und macht Dich wahnsinnig. Ueberall"
           +" beginnt es Dich zu jucken."));
  AddDetail("moment", BS(
            "Momentan ist das Meer richtig unruhig. Dir wird mulmig zumute."));
  AddDetail(({"streifen", "strand", "sandstreifen"}), BS(
            "Du befindest Dich auf dem Sandstreifen einer kleinen Insel, jedoch ist der"
           +" Sandstreifen schon so schmal dass Du Dich eng an die Klippen presst um nicht"
           +" ins Meer zu fallen."));
  AddDetail("ahnung", BS(
            "Du gruebelst nach, doch Du hast echt keine Ahnung."));
  AddDetail(({"seite", "luv"}), BS(
            "Du befindest Dich auf der windzugewandten Seite der Insel. In der Fachsprache nennt"
           +" man diese Seite auch Luv."));
  AddDetail(({"sprache", "fachsprache"}), BS(
            "In der Fachsprache nennt man die windzugewandte Seite auch 'Luv'."));
  AddDetail("ohren", BS(
            "Gottseidank, es sind noch beide Ohren da!"));
  AddDetail("gefahr", BS(
            "Ganz schoen gefaehrlich ist es hier. Pass auf dass Du nicht ins Meer faellst!"));
  AddDetail(({"naehe", "ufernaehe"}), BS(
            "Ein Strand befindet sich meist in Ufernaehe, sonst hiesse er ja nicht so"));
  AddDetail("nase", BS(
            "Du tastest Dich ab und stellst fest, dass Deine Nase noch da ist. Sei froh, denn"
           +" Du brauchst sie ja noch zum riechen."));
  AddSpecialDetail("kleidung", "gwand");

  AddSound(({"geraeusche", DEFAULT_SOUND}), BS(
           "Das Heulen des Windes und das Tosen der Wellen sind so laut, dass Du sonst nichts hoeren"
          +" kannst."));
  AddSound("tosen", BS(
           "Der Wind peitscht die Wellen auf sodass sie in Ufernaehe mit lautem Tosen brechen."
          +" Am liebsten wuerdest Du Dir ja die Ohren zuhalten, aber dann laeufst Du Gefahr ins"
          +" Meer zu plumpsen."));

  AddSound("heulen", BS(
           "Du befindest Dich auf der windzugewandten Seite der Insel, und der Wind kann hier"
          +" ungebremst wueten. Sonst hoerst Du nur noch das Tosen der Wellen, und selbst wenn da"
          +" noch andere Geraeusche waeren, koenntest Du sie nicht hoeren. Dazu ist das Heulen zu"
          +" laut."));

  AddSmell(DEFAULT_SMELL, BS(
           "Du haeltst Deine Nase in den Wind und schnupperst. Es riecht hier irgendwie verkohlt."
          +" Woher dieser Geruch nur stammt?"));
  AddSmell(({"feuer", "lagerfeuer", "geruch"}), BS(
           "Der Geruch duerfte von dem abgebrannten Lagerfeuer stammen."));

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:24, ENV_TERRAIN:TT_PLAIN]));

  AddExit("suedwesten", ROOM("b3_1"));
  AddExit("nordosten", ROOM("d1_1"));
  AddCmd(({"kletter", "klettere"}), "up");
}

up(string s) {
  notify_fail("Wohin moechtest Du klettern?\n");
  if (!s)
    return 0;
  if (s == "")
    return 0;
  if (! (s == "hoch" || s == "rauf") )
    return 0;
  write(BS(
        "Du kannst hier nicht hochklettern, dazu sind die Klippen viel zu zerklueftet. Vielleicht"
       +" gelingt es Dir etwas weiter suedwestlich."));
  return 1;
}

string armour_name(object o) {
  return o->name(WEN);
}

string gwand() {
  string ret, *armour;
  int i;

  armour = map_array(TP->QueryProp(P_ARMOURS), #'armour_name);
  ret = "Du traegst "+armour[0];
  for (i = sizeof(armour)-1; i>=1; i--) {
    ret += ", " + armour[i];
  }
  ret += ".";
  return BS(ret);
}

