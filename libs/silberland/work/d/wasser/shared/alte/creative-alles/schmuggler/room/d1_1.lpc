
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Sandstrand, Bootsanlegeplatz");
  SetProp(P_INT_LONG, BS(
        "Du stehst auf einem breiten Stueck Sandstrand einer verlassenen Insel,"
       +" zumindest kannst Du von hier aus keine Menschenseele entdecken. Hier"
       +" herrscht Daemmerlicht, und Deine Augen brauchen eine Weile bis sie sich an"
       +" die Dunkelheit gewoehnen. Trotzdem traust Du Dich kein Licht anzumachen."
       +" Die Insel scheint sehr felsig zu sein, denn dunkle Klippen heben sich"
       +" gegen den Nachthimmel ab. Der Sandstreifen wird zu beiden Seiten immer"
       +" schmaeler und verliert sich hinter Dir im Meer."));

  AddDetail("sand", BS(
            "Du laesst den Sand durch Deine Finger rieseln. Er ist noch warm, da er das"
           +" Sonnenlicht tangsueber speichert."));
  AddDetail(({"streifen", "sandstreifen"}), BS(
            "Der Sandstreifen wird zu beiden Seiten immer schmaeler."));
  AddDetail("seiten", BS(
            "Mit den beiden Seiten ist Suedwesten und Suedosten gemeint."));
  AddDetail("suedwesten", BS(
            "Richtung Suedwesten wird es etwas felsiger."));
  AddDetail("suedosten", BS(
            "Richtung Suedosten bleibt der Sandstrand schoen feinkoernig."));
  AddDetail(({"seele", "menschenseele"}), BS(
            "Unheimlich ruhig ist es hier. Anscheinend bist Du auf dieser Insel ganz allein."));
  AddDetail("insel", BS(
            "Die Insel ist Dir nicht ganz geheuer. Dir schroffen Klippen haben etwas"
           +" bedrohliches an sich, und in dem Daemmerlicht findest Du Dich nur schwer zurecht."));
  AddDetail(({"daemmerlicht", "licht"}), BS(
            "Du siehst hier zwar niemanden, traust Dich aber trotzdem kein Licht anzumachen."
           +" Irgendwie fuehlst Du Dich unwohl, als wuerde Dich wer beobachten."));
  AddDetail(({"felsen", "klippen"}), BS(
            "Die Klippen sieht man als schwarzen Schatten, der sich gegen den Nachthimmel"
           +" abhebt. Ihre zerklueftete Form kann man nur erahnen."));
  AddDetail("form", BS(
            "Die zerklueftete Form kommt sicher vom Wind, den Du oben auf den Klippen deutlich"
           +" heulen hoerst."));
  AddDetail("meer", BS(
            "Das Meer ist hier ueberraschend ruhig, aber weisse Gischt kroent die sich"
           +" brechenden Wellen. Trotz der Dunkelheit, die hier herrscht, funkelt und"
           +" glitzert es. Du bist froh darueber, ein Boot zu haben und nicht schwimmen"
           +" zu muessen."));
  AddDetail(({"nachthimmel", "himmel"}), BS(
            "Am Himmel tuermen sich hohe, duenne Wolken auf. Kein einziger Stern ist zu sehen,"
           +" nur der Mond verbreitet ein bisschen Licht."));
  AddDetail("mond", BS(
            "Der Mond ist fast voll und spiegelt sich im Meer wieder."));
  AddDetail("augen", BS(
            "Deine Augen sind helles Licht gewoehnt und Du brauchst eine"
           +" Weile, bis Du Dich in der Dunkelheit zurechtfindest."));
  AddDetail("weile", BS(
            "Du kannst nicht genau sagen, wie lange es dauert, denn hier auf dieser"
           +" Insel verlierst Du jedes Zeitgefuehl."));
  AddDetail(({"gefuehl", "zeitgefuehl"}), BS(
            "Du bist innerlich sehr angespannt und weisst darum nicht einmal, wie lange Du schon"
           +" auf der Insel bist. Es kommt Dir wie eine Ewigkeit vor, aber"
           +" wahrscheinlich bildest Du Dir das nur ein."));
  AddDetail("boden", BS(
            "Feinkoerniger Sand bedeckt den Boden. Du kannst Dir vorstellen, dass das tagsueber"
           +" richtig idyllisch ausschaut, aber momentan wuerdest Du am liebsten wieder umkehren."));
  AddDetail("boot", BS(
            "Ein kleines Boot wie Deines kann hier problemlos anlegen, aber"
           +" groessere Schiffe muessten sich wohl einen anderen Platz suchen."));
  AddDetail("platz", BS(
            "Vielleicht gibt es auf der Insel ja anderswo einen Platz, wo"
           +" groessere Schiffe anlegen koennen, hier jedenfalls nicht."));
  AddDetail("brechen", BS(
            "Die Wellen rollen auf den Strand zu und brechen dann, wobei"
           +" die Gischt hoch in die Luft spritzt."));
  AddDetail("luft", BS(
            "Die Luft riecht hier ganz anderes als am Festland, und sie scheint voller kleinster"
           +" Wassertropfen zu sein. Wenn du noch laenger hier stehen bleibst"
           +" wirst Du bald ganz durchnaesst sein."));
  AddDetail(({"tropfen", "wassertropfen"}), BS(
            "Kleinste Wassertropfen wirbeln durch die Luft und bedecken Deine Haut mit"
           +" einer Salzkruste."));
  AddDetail("haut", BS(
            "Du leckst an Deiner Haut und stellst fest, dass sie salzig schmeckt, wahrscheinlich"
           +" von den Wassertropfen die hier ueberall herumwirbeln."));
  AddDetail("dunkelheit", BS(
            "Hier ist es ziemlich dunkel, nur der Mond spendet ein wenig Licht."));
  AddDetail("ewigkeit", BS(
            "Es kommt Dir vot als waer es eine Ewigkeit aus, seitdem Du mit dem Boot"
           +" hier gelandet ist. Aber ganz so lang wirds schon nicht gewesen sein."));
  AddDetail(({"land", "festland"}), BS(
            "Am liebsten wuerdest Du so schnell wie moeglich wieder zurueck zum Festland rudern."));
  AddDetail("gischt", BS(
            "Schaeumende Gischt bedeckt die Wellen die auf den Strand zurollen" 
           +" und wird hoch in die Luft geschleudert wenn sie brechen."));
  AddDetail("wolken", BS(
            "Die Wolken tuermen sich auf und verheissen nichts gutes. Du kennst Dich bei"
           +" sowas zwar nicht aus, aber Du koenntest Dir gut vorstellen dass bald ein Sturm kommt."));
  AddDetail("sturm", BS(
            "Der wuerde Dein kleines Boot einfach wegwehen, also beeil Dich mal lieber."));
  AddDetail("wellen", BS(
            "Die Wellen sind nicht hoch, das kommt Dir sehr gelegen. Schliesslich willst Du nicht"
           +" seekrank werden. Trotzdem verursachen sie lautes Tosen."));
  AddDetail("ruhe", BS(
            "Manche Leute waeren heilfroh, so eine Ruhe geniessen zu koennen, aber Dir"
           +" behagt das gar nicht."));
  AddDetail("leute", BS(
            "Du gehoerst definitiv nicht dazu."));
  AddDetail("salat", BS(
            "Du fragst Dich, wie man etwas essen kann was so riecht. Du bist Dir sicher, dass"
           +" Du so etwas nie anruehren wuerdest!"));
  AddDetail(({"sandstrand", "strand"}), BS(
            "Der Strand besteht aus Sand, vermischt mit ein paar Felsbrocken. Weiter ostlich"
           +" wird er dann immer felsiger. Vor Dir tuermen sich hohe Klippen auf."));
  AddDetail(({"brocken", "felsbrocken"}), BS(
            "Die sind wohl von den Klippen runtergefallen. Du kannst nur hoffen, dass Dir"
           +" kein solcher Brocken auf den Kopf faellt."));
  AddDetail("schatten", BS(
            "Das Licht des Mondes wirft unheimliche Schatten. Die Felsen scheinen sich zu bewegen."));
  AddDetail("stern", BS(
            "Kein einziger Stern ist zu sehen, an dem Du Dich orientieren koenntest. Du wirst Dich"
           +" auf ein Gefuehl verlassen muessen."));
  AddDetail("gefuehl", BS(
            "Dein Gefuehl sagt Dir, dass Du nicht allein bist, obwohl Du niemanden sehen kannst. Du"
           +" beschliesst, besonders aufmerksam zu sein, um schnell fluechten zu koennen, falls das"
           +" erforderlich sein sollte."));
  AddDetail("salzkruste", BS(
            "Wenn Salzwasser auf der Haut trocknet bildet sich eine Salzkruste. Das ist nicht"
           +" gefaehrlich, aber dennoch unangenehm. Mit Suesswasser kann man sie wieder"
           +" abwaschen."));
  AddDetail("haut", BS(
            "Wenn sich darauf eine Salzkruste bildet dann ziept das unangenehm."));
  AddDetail(({"wasser", "salzwasser"}), BS(
            "Daran mangelt es hier nicht, denn das Meer ist voll davon."));
  AddDetail("suesswasser", BS(
            "Leider findest Du hier kein Suesswasser, um eine Salzkruste wegzuwaschen, aber wenn Du"
           +" schnell bist wird das auch gar nicht notwendig sein."));
  AddDetail(({"nachzaehlen", "finger"}), BS(
            "Du verknotest Deine Finger beim Nachzaehlen ob noch alle Finger da sind. Aua!!!"));
  AddDetail("kopf", BS(
            "Wenn Du nickst, merkst Du gleich ob Dein Kopf noch da ist."));


  AddSmell(DEFAULT_SMELL, BS(
           "Der aufdringliche Geruch von Salzwasser liegt in der Luft, ausserdem"
          +" riecht es hier irgendwie nach Seetang."));
  AddSmell(({"wasser", "salzwasser", "geruch"}), BS(
           "Beim Brechen der Wellen spritzt die Gischt hoch, darum kannst Du"
          +" das Salzwasser ganz deutlich riechen."));
  AddSmell(({"tang", "seetang"}), BS(
           "Irgendwo hast Du einmal gelesen, aus Seetang koenne man Salat"
           +" machen. Du schuettelst Dich. Etwas, was so riecht, wuerdest Du niemals"
           +" essen."));

  AddSound(DEFAULT_SOUND, BS(
           "Eine unangenehme Ruhe herrscht hier. Du schauderst. Nur das Tosen der"
           +" Wellen und der Wind, der um die Klippen heult, sind zu hoeren."));
  AddSound(({"rauschen", "tosen"}), BS(
           "Obwohl es hier unten fast windstill ist, hoert sich das Rauschen"
           +" der Wellen wie ein Tosen an, wahrscheinlich weil sonst nicht viel zu"
           +" hoeren ist."));
  AddSound("wind", BS(
           "Der Wind heult um die Klippen, aber hier unten ist es fast"
           +" windstill. Irgendwie unheimlich."));

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:24, ENV_TERRAIN:TT_PLAIN]));

  AddExit("suedwesten", ROOM("c2_1"));
  AddExit("suedosten", ROOM("e2_1"));

  AddCmd(({"ruehr", "ruehre"}), "touch");
}


touch(str) {
  notify_fail("Was willst Du anruehren?\n");
  if (!str)
    return 0;
  if (str == "")
    return 0;
  if (str != "salat an")
    return 0;

  write(BS("Du knabberst vorsichtig an dem Seetang und staunst. Mit Dressing und"
          +" Gewuerzen waere er nicht einmal so schlecht."));
  say(BS(TPN + " fischt ein Stueck Seetang aus dem Meer und steckt es in den Mund. Dir wird schlecht."));
  call_out("wuerg", 1, TP);
  return 1;
}

wuerg(object o) {
  tell_room(TO, "Du beginnst zu wuergen.\n", ({ o }));
}

