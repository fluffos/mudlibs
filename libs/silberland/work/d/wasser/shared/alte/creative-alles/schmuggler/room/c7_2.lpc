
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Klippenpfad");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_MOUNTAIN]));

  AddExit("nordosten", ROOM("d6_2"));
  AddExit("westen", ROOM("b7_2"));
}


