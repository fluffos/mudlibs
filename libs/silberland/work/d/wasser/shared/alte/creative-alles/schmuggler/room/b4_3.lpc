
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Felshang");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:26, ENV_TERRAIN:TT_MOUNTAIN]));

  AddExit("sueden", ROOM("b5_3"));
  AddExit("unten", ROOM("b4_2"));
}


