#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

inherit "std/npc";

private string ware_ausgegeben;

create()
{
  if (!is_clone(this_object())) return;
  seteuid(getuid(this_object()));

  ::create();

  SetProp(P_SHORT, "Toob Immug, der Schmugglerjunge");
  SetProp(P_LONG, BS(
          "Der Schmugglerjunge hat ein ziemlich freches Gesicht. Aus kleinen"
         +" ebenso frechen Augen mustert er Dich argwoehnisch. Sein Gewand ist"
         +" zwar einfach aber nicht schaebig."));

  SetProp(P_WEIGHT, 49000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Toob Immug");
  SetProp(P_GENDER, MALE);
  AddId(({"toob", "schmugglerjunge", "junge"}));
  create_default_npc(16);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_SPELLRATE, 20);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 155);
  SetProp(P_DEFAULT_INFO, ({
          "sagt: Davon habe ich noch nie etwas gehoert.\n",
          "blickt beschaemt auf den Boden.\n",
          "fragt Dich: Woher soll ich denn das herkriegen?\n" }));
  SetProp(P_HANDS, ({" mit geschickten wendigen Fingern", 30, DT_BLUDGEON}));
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Der Schmugglerjunge sagt: Dafuer habe ich keinen Platz mehr!\n" }));

  AddInfo(({"ware", "hehlerware"}),
          "Ich haette hier noch eine dringende Lieferung!", "sagt: ");
  AddInfo("lieferung",
          "Ich muesste noch dringend etwas zustellen... hmm, wie soll ich das nur schaffen?",
          "fragt Dich: ");
  AddInfo("hilfe",
          "Du willst mir wirklich helfen? Nun gut, dann solltest Du etwas ueber die Zustellung"
         +" wissen...", "sagt: ");
  AddInfo("schmuggler",
          "Pst, darueber kann ich Dir nix verraten! Das ist streng geheim...",
          "fluestert Dir zu: ");
  AddInfo("waren",
          "Wir transportieren Unmengen an Waren ueber den ganzen Kontinent und schleichen"
         +" uns an der Exekutive vorbei", "sagt: ");
  AddInfo("kontinent",
          "Wir beziehen unsere Waren von ueberall!", "erklaert: ");
  AddInfo(({"obrigkeit", "exekutive"}),
          "Nunja, erwischt werden duerfen wir nicht. Schliesslich gilt es auf den Transport"
         +" von Waren einiges an Gold an die Obrigkeit abzufuehren.", "sagt: ");
  AddInfo(({"schmugglerinsel", "insel"}),
          "Wenn man hier in der Naehe vom Strand mit einem Boot wegfaehrt,"
         +" so gelangt man recht schnell zur Schmugglerinsel.", "meint: ");
  AddInfo(({"boote", "boot"}),
          "Fuer mich persoenlich sind Schlauchboote die praktischten, da man ihnen"
         +" im Bedarfsfall die Luft auslassen kann. Danach laesst es sich dann ganz klein zusammenfalten",
          "sagt: ");
  AddInfo("zustellung", "@@deliver@@");

  SetChats(4, ({
           "Toob Immug sagt: Wie soll ich nur die Hehlerware zustellen!\n",
           "Toob Immug sagt: Wenn mir doch jemand helfen koennte...\n",
           "Toob Immug sagt: Verdammt, die neuen Bestellungen sind schon eingetroffen und ich kann nicht weg!\n",
           "Toob Immug sagt: Wie soll ich nur in der kurzen Zeit die Ware zustellen?\n",
           "Toob Immug sagt: Mist, wenn ich nur hier wegkoennte...\n",
           "Toob Immug seufzt.\n",
           "Toob Immug jammert verzweifelt herum.\n",
           "Toob Immug arglt verzweifelt vor sich hin.\n"
           }));
 
//  SetProp(P_VULNERABILITY, ({ DT_POISON }));
//  SetProp(P_RESISTANCE, ({ DT_FIRE, DT_ACID, DT_ELECTRIC, DT_AIR, DT_WATER }));

  clone_object("/p/armour/trousers/hose")->move(TO);
  clone_object("/p/armour/armour/hemd")->move(TO);
  clone_object("/p/armour/boots/sandalen")->move(TO);

  command_me("ziehe alles an");
  ware_ausgegeben = "";
}

reset() {
  ware_ausgegeben = "";
  ::reset();
}

deliver() {
  object ob, qo;
  int i;
  string who, ware, dest, *waren;

  who = getuid(TP);
  if ( (qo = deep_present(SCHMUGGLER_QUESTOB, TP)) && (qo->query_owner() == who) ) {
    return "sagt: Du hast doch schon einen Auftrag von mir angenommen, fuehre den doch mal aus!\n";
  }
  if (ware_ausgegeben != "") {
    return "sagt: Ich habe schon "+ CAP(ware_ausgegeben) +" mit einer Zustellung beauftragt, Du musst"
          +" warten bis eine neue Lieferung eintrifft!\n";
  }
  // Questobjekt clonen
  qo = clone_object(OBJ("quest_ob"));
  qo->move(TP, M_NOCHECK);
  qo->set_owner(getuid(TP));
  // Ware clonen
  waren = SCHMUGGLER_WARE;
  i = random(sizeof(waren));
  ware = waren[i];
  waren -= ({ ware });
  // Ranadrion kauft nix von Zwergen *seufz*
  if (TP->QueryProp(P_RACE) == "Zwerg" && ware == OBJ("buch")) {
    command("sag Hoppla, Du bist ja Zwerg, da kannst Du in Elessar ja nichts verkaufen!");
    command("emote grinst.");
    i = random(sizeof(waren));
    ware = waren[i];
  }
  switch(ware) {
    case OBJ("kaennchen"): dest = "Albin"; break;
    case OBJ("elixier"): dest = "Alchemist"; break;
    case OBJ("buch"): dest = "Aerendil"; break;
    default: dest = "Hugo";
  }
  ob = clone_object(ware);
  ob->move(TO);
  ware_ausgegeben = who;
  command("gib "+ob->QueryProp(P_IDS)[0]+" an "+who);
  tell_object(TP, break_string(
              "So, hier hast Du nun "+ob->name(WEN)+"... Du solltest es schleunigst zu seinem"
             +" Empfaenger bringen! Jedoch habe ich mit "+dest+" ausgemacht, dass ihr euch"
             +" aus Sicherheitsgruenden nicht direkt treffen sollt! Deshalb habe ich mit "
             +" ihm vereinbart, dass Du in seiner Naehe die Ware einfach im Laden verkaufst,"
             +" den Rest macht "+dest+" dann mit dem zustaendigen Haendler aus. Ausserdem"
             +" brauchst Du noch das geheime Codewort, mit dem "+dest+" erkennen kann, dass"
             +" fuer ihn neue Ware eingetroffen ist. Das Codewort lautet '"+qo->query_code()+"'.",
             78, "Toob Immug fluestert Dir zu: "));
  return "laechelt zufrieden.\n";
}

