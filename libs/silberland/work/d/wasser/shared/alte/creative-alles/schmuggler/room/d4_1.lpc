
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Im Lagerraum der Schmuggler");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INDOORS, 1);

  AddExit("sueden", ROOM("d5_1"));
  AddExit("osten", ROOM("e4_1"));
  AddExit("norden", ROOM("d3_1"));
  AddExit("westen", ROOM("c4_1"));
  AddExit("unten", ROOM("d4_0"));
}


