inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein spezielles Kraeuterelixier");
  SetProp(P_LONG, BS(
          "In diesem kleinen verschlossenen Flaeschchen erkennst Du ein aeusserst"
         +" spezielles Kraeuterelixier. Du betrachtest die darin schwimmenden Kraeuter"
         +" genauer, aber Du kannst Dir unter keinen Umstaenden vorstellen um welche"
         +" Kraeuter es sich hier handeln koennte. Vermutlich waere das Elixier in den"
         +" richtigen Haenden ein aeusserst wertvoller Schatz."));
  SetProp(P_NAME, "Kraeuterelixier");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 600);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, SCHMUGGLER_WARE_WERT);
  SetProp(P_MATERIAL, MAT_GLASS);
  AddId( ({ SCHMUGGLER_ELIXIER, "elixier", "kraeuterelixier" }) );
  AddAdjective("spezielles");
}

varargs move(mixed dest, int method) {
  object qo;
  string s;

  if (dest && dest == DERLIM_LAGER) {
    qo = present(SCHMUGGLER_QUESTOB, TP);
    if (qo) {
      s = break_string(
          "Ich habe das Elixier extra fuer den Alchemisten bereitgelegt. Du solltest nun schleunigst"
          +" zu ihm gehen und ihm das geheime Codewort, das Du von dem Schmugglerjungen"
          +" erhalten hast, fluestern!", 78, "Dodo Stolzfuss teilt Dir mit: ");
      qo->proceed_to_letter(s);
      qo->set_state(SCHMUGGLER_WARE_VERKAUFT);
    }
  }
  return ::move(dest, method);
}

