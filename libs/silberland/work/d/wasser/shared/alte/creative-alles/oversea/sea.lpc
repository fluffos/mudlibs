inherit "/std/room.lpc";

#include <room.h>
#include "../files.h"
#include "../sys/vt100.h"
#include "../sys/sea.h"
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "");

  AddSpecialExit("norden", "north");
  AddSpecialExit("osten", "east");
  AddSpecialExit("westen", "west");
  AddSpecialExit("sueden", "south");
}

int my_x, my_y;

set_xy(int x, int y)
{
  my_x=x; my_y=y;
}

query_x() { return my_x; }

query_y() { return my_y; }

init()
{
  ::init();

  OV_MSTR->init_new_player(this_player(), my_x, my_y);
}

/* exit()
{
  ::exit();

  if (IS_LEARNER(this_player()) && this_player()->QueryProp(P_WANTS_TO_LEARN))
    OV_MSTR->remove_player(this_player());
} */

int north()
{
  return OV_MSTR->move_north(this_player());
}

int south()
{
  return OV_MSTR->move_south(this_player());
}

int west()
{
  return OV_MSTR->move_west(this_player());
}

int east()
{
  return OV_MSTR->move_east(this_player());
}

string int_short(mixed vi, mixed vp, int f)
{
  // if (vi==find_player("creative"))
    // printf("%d\n", get_eval_cost());
  return OV_MSTR->query_surround(vi)+::int_short(vi, vp, f);
}

string int_long(mixed vi, mixed vp, int f)
{
  return OV_MSTR->query_surround(vi)
  +OV_MSTR->query_long(vi)+::int_long(vi, vp, f);
}

