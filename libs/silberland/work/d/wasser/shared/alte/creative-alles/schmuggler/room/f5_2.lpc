
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Klippenpfad");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25, ENV_TERRAIN:TT_MOUNTAIN]));

  AddExit("westen", ROOM("e5_2"));
  AddExit("nordwesten", ROOM("e4_2"));
  AddExit("norden", ROOM("f4_2"));
}


