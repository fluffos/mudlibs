inherit "/std/room";

#include <room.h>
#include <properties.h>
#include <moving.h>
#include "../sys/sea.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Insel-Archipel");
  SetProp(P_INT_LONG, "Du befindest Dich auf dem Insel-Archipel (Nr. 9).\n");
  SetProp(P_LIGHT, 1);
 
  AddSpecialExit("sueden", "ov_1");
}

ov_1()
{
  object des;

  des=OV_MSTR->init_new_player(this_player(), 15, 115);
  this_player()->move(des, M_GO, "nach Sueden", "nimmt sich ein Boot und paddelt", "paddelt herein");
  return 1;
}

