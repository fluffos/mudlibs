inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <material.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Ein merkwuerdiges Buch mit Schriftzeichen");
  SetProp(P_LONG, BS(
          "Auf diesem Buch kannst Du nur lauter eigenartige Schriftzeichen erkennen."
         +" Vermutlich koennte ein belesener Mann mit den Schriftzeichen viel mehr"
         +" anfangen als Du, denn Du denkst Dir nur welch huebsche Strickmuster"
         +" man aus den Schriftzeichen machen koennte. In den richtigen Haenden waere"
         +" das Buch sicher ein wertvoller Schatz."));
  SetProp(P_NAME, "Buch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 700);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, SCHMUGGLER_WARE_WERT);
  SetProp(P_MATERIAL, MAT_PAPER);
  AddId( ({ SCHMUGGLER_BUCH, "buch" }) );
  AddAdjective("merkwuerdiges");
}

varargs move(mixed dest, int method) {
  object qo;
  string s;

  if (dest && dest == ELESSAR_LAGER) {
    qo = present(SCHMUGGLER_QUESTOB, TP);
    if (qo) {
      s = break_string(
          "Ich habe das Kaennchen extra fuer Aerendil bereitgelegt. Du solltest nun schleunigst"
          +" zu ihm gehen und ihm das geheime Codewort, das Du von dem Schmugglerjungen"
          +" erhalten hast, fluestern!", 78, "Ranadrion teilt Dir mit: ");
      qo->proceed_to_letter(s);
      qo->set_state(SCHMUGGLER_WARE_VERKAUFT);
    }
  }
  return ::move(dest, method);
}

