
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Am Sandstrand");
  SetProp(P_INT_LONG, BS(
        "Du stehst vor einer zerkluefteten Felswand, die viele Risse und Spalten"
        +" aufweist. Der Strand hat sich zu einem schmalen Streifen verengt, und obwohl Du"
        +" eng an die Klippe gepresst dastehst, kommen Dir die Wellen gefaehrlich nahe."
        +" Grosse Felsbloecke bedecken den Boden und lassen Dich immer wieder stolpern, denn"
        +" im spaerlichen Licht des Mondes kannst du nicht viel erkennen."));
  AddDetail(({"wand", "felswand"}), BS(
            "Du stehst vor einer zerkluefteten Felswand mit vielen Rissen und Spalten."
           +" Als geuebter Kletterer kommst Du immerhin auch hinauf."));
  AddDetail(({"risse"}), BS(
            "Viele Rissen befinden sich in der Felswand, sie ermoeglichen Dir einen"
           +" Aufstieg. Probier doch einmal hinaufzuklettern!"));
  AddDetail(({"spalten"}), BS(
            "Mithilfe der Spalten in der Felswand kannst Du sehr bequem aufsteigen. Du koenntest"
           +" versuchen, hinaufzuklettern."));
  AddDetail("himmel", BS(
            "Der Himmel wirkt duester ueber Dir. Er ist dunkel und bedrohlich, so wie Du"
           +" ihn noch nicht gesehen hast."));
  AddDetail("boden", BS(
            "Du stehst vor der Felswand, auf einem winzigschmalen Sandstreifen. Eng gepresst"
           +" an die Felsen stehst Du nun da und wartest auf Dein Schicksal."));
  AddDetail("schicksal", BS(
            "Dein Schicksal wird schon noch kommen!"));
  AddDetail("kletterer", BS(
            "Der letzte Kletterer der hier das Abenteuer gewagt hat duerfte wohl klaeglich"
           +" verendet sein. Du siehst noch seine Ueberreste im Fels haengen."));
  AddDetail("wellen", BS(
            "Die Wellen des Meeres sind Dir gefaehrlich nahe. Du presst Dich eng an den Felsen,"
           +" um nicht Opfer des Meeres zu werden."));
  AddDetail("licht", BS(
            "Im spaerlichen Licht des Mondes kannst Du nicht viel erkennen."));
  AddDetail(({"bloecke", "felsbloecke", "fels"}), BS(
            "Rund um Dich befinden sich grosse Felsbloecke. Du findest es muehsam, den Weg zwischen"
           +" den Felsbloecken zu finden."));
  AddDetail("abenteuer", BS(
            "So manches Abenteuer hast Du schon bestanden, mach jetzt ja nicht schlapp!"));
  AddDetail("meer", BS(
            "Das Meer sieht sehr unruhig aus. Wenn Du bloss nicht hineinfielest!"));
  AddDetail("abenteuer", BS(
            "So manches Abenteuer hast Du schon bestanden, mach jetzt ja nicht schlapp!"));
  AddDetail("meer", BS(
            "Das Meer sieht sehr unruhig aus. Wenn Du bloss nicht hineinfielest!"));
  AddDetail("aufstieg", BS(
            "Um aufzusteigen musst Du schon nach oben gehen!"));
  AddDetail("opfer", BS(
            "Pass bloss auf, dass Du nicht Opfer des Meeres wirst!"));
  AddDetail("mond", BS(
            "Im spaerlichen Mond kannst Du leider nicht viel erkennen..."));
  AddDetail(({"pfad", "weg"}), BS(
            "Ein schmaler Weg fuehrt von hier in Richtung Gipfel."));
  AddDetail("gipfel", BS(
            "Der Gipfel befindet sich weiter oberhalb von Dir."));
  AddDetail(({"sandstrand", "strand"}), BS(
            "Du befindest Dich gerade noch am Sandstrand, auch wenn die Gegend hier etwas felsiger"
           +" zu werden scheint."));
  AddDetail(({"streifen", "sandstreifen"}), BS(
            "Der Sandstreifen ist hier schon ziemlich schmal geworden, so dass Du froh bist Dich an"
           +" die schroffen Felsen pressen zu koennen, an denen noch ein Stueckchen Weg zu erkennen"
           +" sein scheint."));
  AddDetail("himmel", BS(
            "Der Himmel ist vor Wolken arg zerfurcht und zerpfluegt. Du kannst gar nicht viel erkennen,"
           +" ausser dass der Mond gerade am vollwerden zu sein scheint."));
  AddDetail("wolken", BS(
            "Die Wolken werfen einen bedrohlichen Schatten auf den Sand und lassen Dich erschaudern."
           +" Vielleicht erinnern Dich die Formen sogar an bestimmte Sachen !?"));
  AddDetail(({"schatten", "sachen"}), BS(
            "Die Schatten der Formen erinnern Dich an exotische Tiere, die Du schon mal gesehen haben"
           +" musst, sonst wuesstest Du nichts davon..."));
  AddDetail("tiere", BS(
            "Selbst exotische Tiere findest Du im Silberland weit verstreut."));
  AddDetail("formen", BS(
            "Die Formen der Schatten erinnern Dich an bestimmte Sachen."));
  AddDetail("sand", BS(
            "Du pruefst den Rieselgrad des Sandes durch Deine Finger. Du wirkst zufrieden."));
  AddDetail(({"rieselgrad", "grad"}), BS(
            "Du laesst den Sand durch Deine Finger rieseln und wirkst sehr zufrieden."));
  AddDetail("gegend", BS(
            "Du laesst Deinen Blick kurz ueber die Gegend schweifen und stellst fest, dass es hier"
           +" ziemlich unheimlich auszusehen scheint."));
  AddDetail("blick", BS(
            "Du legst den irren Blick auf und grinst schelmisch."));
  AddDetail("stueckchen", BS(
            "An den Felsen, an die Du Dich anpresst, scheint noch ein Stueckchen Weg zu sein, und damit"
           +" auch Gelaende, wo generell Leute sich aufhalten koennen!"));
  AddDetail(({"ausfluegler", "leute"}), BS(
            "Leute? Ausflueglre? Keine hier, oder?"));
  AddDetail("gelaende", BS(
            "In diesem Gelaende bist Du vor Ausflueglern sicher..."));
  AddDetail("klippe", BS(
            "Du befindest Dich gerade eng an die Klippe gepresst auf der Insel, deren Namen Du noch nicht"
           +" herausgefunden hast. Du solltest Deinen Pfad auch nicht verlassen, sonst faellst Du noch"
           +" ins Meer!"));
  AddDetail("insel", BS(
            "Du befindest Dich gerade auf einer Insel mittem im Meer. Auf was Du wohl fuer Gedanken"
           +" kommst, wenn Du Dich fragst wo Du bist?!"));
  AddDetail("gedanken", BS(
            "Du denkst kurz nach und bemerkst, dass Du Dich auf einer Insel mittem im Meer befindest."));
  AddDetail("name", BS(
            "Du meinst den Namen der Insel? Ich glaube Du solltest hier zuerst einen Bewohner danach fragen."));
  AddDetail("bewohner", BS(
            "Nach den Spuren die Du schon gefunden hast zu urteilen bist Du nicht allein hier auf der Insel!"));
  AddDetail(({"reste", "ueberreste"}), BS(
            "Der letzte Abenteurer, der es versucht hat, hier auf den Gipfel zu kommen, ist wohl recht"
           +" flott gescheitert. Du bekommst Mitleid mit dem armen Kerl."));
  AddDetail(({"abenteurer", "kerl"}), BS(
            "Der armer Kerl! Zuerst klettert er so weit nach oben dann verhungert er einfach..."));
  AddDetail("mitleid", BS(
            "Du fuehlst Mitleid und wuerdest das Unglueck am liebsten ungeschehen machen."));
  AddDetail(({"geschichte", "unglueck"}), BS(
            "Echt traurig die ganze Geschichte, aber es nimmt nun mal alles seinen Lauf der Dinge."));
  AddDetail(({"lauf", "dinge"}), BS(
            "Alles geht hier seinen gewohnten Lauf der Dinge."));
  AddDetail("spuren", BS(
            "Du untersuchst die Spuren genauer. Ausser Deinen eigenen sind leider keine zu sehen!"));
  AddDetail("finger", BS(
            "Du spuerst, wie der Sand durch Deine Finger rieselt und bist zufrieden."));
  AddDetail("silberland", BS( 
            "Im Silberland bist Du doch ein wenig zuhause, oder?"));

  AddSmell(DEFAULT_SMELL, BS(
           ""));

  AddSound(DEFAULT_SOUND, BS(
           ""));

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:24, ENV_TERRAIN:TT_HILL]));

  AddExit("nordosten", ROOM("c2_1"));
  AddCmd(({"kletter", "klettere"}), "up");
}

up(string str) {
  notify_fail("Wohin moechtest Du klettern?\n");
  if (!str)
    return 0;
  if (str == "")
    return 0;
  if ( member( ({ "hoch", "hinauf", "rauf", "aufwaerts" }), str ) == -1)
    return 0;
  write("Du kletterst geschickt die Felswand hinauf.\n");
  TP->move(ROOM("b3_2"), M_GO, "", "klettert geschickt die Felswand hinauf",
           "klettert geschickt von unten herauf");
  return 1;
}




