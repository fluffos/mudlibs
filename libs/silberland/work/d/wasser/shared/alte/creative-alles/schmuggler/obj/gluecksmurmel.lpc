inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <material.h>
#include "../files.h"

#define COLORS ({ "blaeulich", "gruenlich", "roetlich",  "gelblich", "violett" })
#define ATTRS ({ "durchsichtig", "schillernd", "gestreift", "gemustert", "milchig" })

string owner;

string color, attr;
int size;

create()
{
  if (!is_clone(this_object()))
    return;

  ::create();
  SetProp(P_SHORT, "Deine Gluecksmurmel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_GLASS);
  AddId( ({ SCHMUGGLER_MURMEL, "murmel" }) );

  color = COLORS[random(sizeof(COLORS))];
  attr = ATTRS[random(sizeof(ATTRS))];
  size = 15 + random(4);
  
  AddAdjective(({color, color+"e"}));
  AddAdjective(({attr, attr+"e"}));
}

long() {
  return BS(
      "Diese "+color+" "+attr+"e Murmel besteht aus Glas und hat einen Durchmesser von circa "+size
     +" Millimetern. Mit ihr kannst Du Murmel spielen, dazu musst Du sie natuerlich werfen.");
}

name() {
  return CAP(owner)+"'s Gluecksmurmel";
}

