
#include "../files.h"
inherit "std/room";

#include <moving.h>
#include <language.h>
#include <properties.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "Im Weinkeller der Schmuggler");
  SetProp(P_INT_LONG, "");

  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:14, ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INDOORS, 1);

  AddExit("oben", ROOM("d4_1"));
}


