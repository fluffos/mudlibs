#include "../def.h"
inherit ROOM "inh_kueste";

int kaefercounter;

create()
{
  ::create();

  SetProp(P_INT_LONG, BS(QueryProp(P_INT_LONG)+
            "Neben dem Weg waechst etwas Moos."));
  AddDetail(({"moos"}),
    "Das Moos sieht interessant aus, vielleicht solltest Du es durchsuchen.");

  AddCmd(({"durchsuche","durchsuch"}),"fktdurchsuchen");
    kaefercounter=1;

/* Ausgaenge */
  AddExit("nordosten", ROOM "k09.lpc");
  AddExit("suedwesten", ROOM "k11.lpc");
}

int fktdurchsuchen(string str)
{
  object ob;
  notify_fail("Was willst Du durchsuchen?\n");
  if(!str) return 0;
  if(str=="moos"){
    if(kaefercounter){
      ob=clone_object(NPC"eiskaefer");
      write(BS("Du durchsuchst das Moos und erschrickst ploetzlich."));
      say(BS(TPN+" durchsucht das Moos auf dem Boden."));
      if(ob) ob->move(ME,M_GO);
      kaefercounter=0;
      return 1;
    }
    else{
      write(BS("Du durchsuchst das Moos, findest aber nichts."));
      say(BS(TPN+" durchsucht das Moos auf dem Boden."));
      return 1;
    }
  }
  else return 0;    
}

reset() 
{
  ::reset();
  if(!present("EISKAEFER",ME)) kaefercounter=1;
}