inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Eiszapfen");
  SetProp(P_LONG,
    "Ein schoener, grosser Eiszapfen wie man ihn nur in sehr "
    "kalten Gebieten finden kann. Wenn Du ihn zu lange mit Dir rumtraegst "
    "wird er wohl schmelzen." );
//  SetProp(P_INFO, "");
  SetProp(P_NAME, "Eiszapfen");
  SetProp(P_GENDER, MALE);
  AddId(({"eiszapfen","zapfen","EISZAPFEN"}));

  SetProp(P_MATERIAL, MAT_ICE );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
}

reset() 
{
  ::reset();
  if (!is_clone(TO)) return;
  if(environment())
    tell_object(environment(TO), 
      "Der Eiszapfen schmilzt durch Deine Koerperwaerme.\n");
  TO->remove();
}