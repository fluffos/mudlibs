#include "../def.h"
inherit ROOM "inh_kueste";

int eiszapfencounter;

create()
{
  ::create();

  SetProp(P_INT_LONG, BS(QueryProp(P_INT_LONG)+
            "Von einem Felsen haengen ein paar Eiszapfen."));
  AddDetail(({"eiszapfen","zapfen"}),
    "Einige Eiszapfen haengen von einem Felsen. Du koenntest vielleicht "
    "einen davon abbrechen.");

  AddCmd(({"breche","brech","brich"}),"fktabbrechen");
    eiszapfencounter=1;

/* Ausgaenge */
  AddExit("suedosten", ROOM "k19.lpc");
  AddExit("westen", ROOM "k21.lpc");
}

int fktabbrechen(string str)
{
  object ob;
  notify_fail("Was willst Du abbrechen?\n");
  if(!str) return 0;
  if(str=="eiszapfen ab" ||
     str=="zapfen ab"){
    if(eiszapfencounter){
      ob=clone_object(OBJ"eiszapfen");
      write(BS("Du brichst einen grossen Eiszapfen ab."));
      say(BS(TPN+" bricht einen grossen Eiszapfen ab."));
      if ( ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT) )
      {
        tell_object(TP,
          "Leider ist Dir der Eiszapfen zu schwer und Du laesst ihn auf den "
          "Boden fallen, wo er zerbricht.\n");
        ob->remove();
        return 1;
      }
      eiszapfencounter=0;
      return 1;
    }
    else{
      write(BS("Die Eiszapfen sind noch zu klein und wuerden sofort schmelzen."));
      say(BS(TPN+" betrachtet die Eiszapfen naeher."));
      return 1;
    }
  }
  else return 0;
}

reset() 
{
  ::reset();
  eiszapfencounter=1;
}