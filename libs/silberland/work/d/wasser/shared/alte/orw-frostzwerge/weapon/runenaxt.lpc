inherit "std/weapon";

#include <properties.h>    
#include <combat.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine runenverzierte Kriegsaxt");
  SetProp (P_LONG,
    "Die Kriegsaxt besteht aus einem langen Holzstock, auf dem am oberen "
    "Ende ein mit Zwergenrunen verziertes Mithrilaxtblatt eingesetzt ist, "
    "das silbrigblau schimmert. Sie wurde von den besten Schmieden der "
    "Frostzwerge bearbeitet. Der Stiel ist mit Lederriemen umwickelt, "
    "damit sie gut in der Hand des Kaempfers liegt.");
  SetProp (P_NAME, "Kriegsaxt");
  SetProp (P_NAME_ADJ, "runenverziert");
  SetProp (P_GENDER, FEMALE);
  AddAdjective(({"runenverzierte","verzierte","runenverziert","verziert"}));
  AddId (({"axt", "kriegsaxt"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 160);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":130, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:45, MAT_OAK:50, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 2500);
  SetProp(P_SIZE, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:15, A_DEX: 15, P_LEVEL: 15]) );

  AddDetail( ({"axtblatt", "blatt", "mithrilaxtblatt", "mithril"}),
    "Das Axtblatt der Kriegsaxt besteht aus feinstem runenverzierten "
    "Mithril.");
  AddDetail( ({"lederriemen", "riemen","stiel"}),
    "Der Stiel ist mit einem schwarzen Lederriemen umwickelt.");
  AddSpecialDetail( ({"runen", "zwergenrunen"}),"detail_runen");
}

string detail_runen()
{
  if(TP->QueryProp(P_RACE)=="Zwerg")
    return BS("Die Runen sind in Altzwergisch geschrieben. Vom grossen Krieg "
           "der Elfen gegen die Zwerge ist da die Rede, von grossen "
           "Heldentaten, Ruhm und Ehre.\n");
  else
    return BS("Leider kannst Du die Runen nicht entziffern, sie sind in "
           "Altzwergisch geschrieben.\n");
}