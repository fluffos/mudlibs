inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"
#include "../include/kueste.h"

void insertprop(string str);
string *details;

//#define DEBUG 1
#ifdef DEBUG
int rekursion;
#endif

create() 
{
  int i,nr, j;
  string lang,str, *newdet;
  mapping map;
 
  ::create();
  lang="";
  details=({ });

  SetProp(P_INT_SHORT, DET_SHORT[random(sizeof(DET_SHORT))+1] );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,    // auch bei der Temp. ein wenig random
    ([ENV_TEMPERATURE: (-10)-random(3), ENV_TERRAIN: TT_ARCTIC]) );

  for(i=1;i<=6;i++) 
  {
    switch(i) 
    {
      case 1: map=DET_LANG1; break;
      case 2: map=DET_LANG2; break;
      case 3: map=DET_LANG3; break;
      case 4: map=DET_LANG4; break;
      case 5: map=DET_LANG5; break;
      case 6: map=DET_LANG6; break;
    }
    nr=random(sizeof(m_indices(map)))+1;
    lang+=map[nr,0];
    if(sizeof(newdet=map[nr, 1]))
      for(j=sizeof(newdet)-1;j>=0;j--)
        if ((str=newdet[j]) != "")
          insertprop(str);
  }

  SetProp(P_INT_LONG, lang);
}

void insertprop(string str) {
  string str2,temp;
  string *newdet;
  mapping map;
  int nr,i;
#ifdef DEBUG
  rekursion++;
#endif
  if (member(details,str) != -1) return;
  if (str == "") return;
  map=DET_ALL1;
  if (!(map[str,0])) {
    map=DET_ALL2;
    if (!(map[str,0])) {
      map=DET_ALL3;
      if (!(map[str,0])) {
        map=DET_ALL4;
        if (!(map[str,0])) {
          map=DET_ALL5;
          if (!(map[str,0])) {
            map=DET_ALL6;
            if (!(map[str,0])) {
              map=DET_ALL7;
              if (!(map[str,0])) {
                return;
              }
            }
          }
        }
      }
    }
  }
  nr=random(map[str,0]);
  details+=({ str });
#ifdef DEBUG
  write( sprintf("%O\n",details));
  write(" Rekursion: "+rekursion+"\n");
#endif 
  AddDetail( str , map[str,1+nr*2] );
  if(sizeof(newdet=map[str, nr*2+2]))
    for(i=sizeof(newdet)-1;i>=0;i--)
      if ((str2=newdet[i]) != "") insertprop(str2);
}

