inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schneebaer");
  SetProp(P_LONG,
    "Vor Dir steht ein riesiger Schneebaer. Sein weisses Fell tarnt "
    "ihn trotzt seiner Groesse ziemlich gut, sodass man ihn von Weitem "
    "nicht gut ihm Schnee erkennen kann. Riesige Pranken und spitze "
    "grosse Zaehne, machen ihn zu einem gefuerchteten Gegner.");
  SetProp(P_NAME, "Schneebaer");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));
  AddId(({"schneebaer", "baer", "SCHNEEBAER"}));
  set_living_name("schneebaer");

  create_default_npc(28);
  SetProp(P_HANDS, ({
    " mit seinen Pranken",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Baer");
  SetProp(P_SIZE, 270+random(10));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:     -0.3, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "raum1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);


  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(({"orw","magier","schoepfer"}), 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schneebaer will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,400,
    "Der Schneebaer zerfetzt Dir das Gesicht.\n",
    "Der Schneebaer zerfetzt @WEM das Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,600,
    "Der Schneebaer zerquetscht Dich unter seinem Gewicht.\n",
    "Der Schneebaer zerquetscht @WEN unter seinem Gewicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Schneebaer schnueffelt herum.\n",
    "Der Schneebaer bruellt furchteregend.\n",
    "Der Schneebaer fletscht seine Zaehne.\n",
    "Der Schneebaer brummt Dich an.\n"}) );
  SetAttackChats(5, ({
    "Der Schneebaer wirft Dich mit einem Schlag zu Boden.\n"}) );

  SUID;
  
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  CLONEME(ARMOUR "schneebaerenfell");
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt den Schneebaeren.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Der Schneebaer hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "fletscht gierig seine Zaehne.",
        "fletscht gierig seine Zaehne.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "baeumt sich vor Dir auf.",
        "baeumt sich vor @WEM auf.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "funkelt Dich boese an.",
        "funkelt @WEN boese an.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "bruellt laut.",
        "bruellt laut.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "holt weit mit seiner Pranke aus.",
        "holt weit mit seiner Pranke aus.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "reisst sein riesiges Maul auf.", 
        "reisst sein riesiges Maul auf.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "schuettelt sein Fell.",
        "schuettelt sein Fell.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet @WEN gar nicht.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "kratzt sich.",
        "kratzt sich.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "scharrt im Schnee herum.",
        "scharrt im Schnee herum.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
