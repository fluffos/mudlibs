inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Pinguin");
  SetProp(P_LONG,
    "Der Pinguin ist am Bauch weiss und am Ruecken schwarz, "
    "somit ist er bestens dem Leben im Wasser angepasst. Pinguine "
    "sind in der Regel auch gute Kletterer in den vereisten Haengen. "
    "Er watschelt lustig in der Gegend herum.");
  SetProp(P_NAME, "Pinguin");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));
  AddId(({"pinguin", "tier", "PINGUIN"}));
  set_living_name("pinguin");

  create_default_npc(5+random(3));
  SetProp(P_HANDS, ({
    " mit seinem Schnabel",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Pinguin");
  SetProp(P_SIZE, 45+random(5));
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, QueryProp(P_MAX_HP)/5);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.3, DT_COLD:     -0.6, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.3, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "watschelt herein");
  SetProp(P_MSGOUT, "watschelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM "k") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "k45");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);


  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(({"orw","magier","schoepfer"}), 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Pinguin kann Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,10);
  AddSpell(1,200,
    "Der Pinguin piekst Dich ins Bein.\n",
    "Der Pinguin piekst @WEN ins Bein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Pinguin guckt Dich lieb an.\n",
    "Der Pinguin knuddelt Dich.\n",
    "Der Pinguin schaut sich hier um.\n",
    "Der Pinguin rutscht im Schnee aus.\n"}) );
  SetAttackChats(10, ({
    "Der Pinguin schuettelt sich.\n"}) );

  SUID;
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt den Pinguin.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Der Pinguin hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "guckt Dich komisch an.",
        "guckt "+TPN+" komisch an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "zittert.",
        "zittert.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schuettelt sich.",
        "schuettelt sich.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "fuerchtet sich.",
        "fuerchtet sich.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "versucht sich zu verstecken.",
        "versucht sich zu verstecken.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "freut sich.", 
        "freut sich.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "versucht zu fluechten.",
        "versucht zu fluechten.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "reibt sich an Deinem Bein.",
        "reibt sich an @WESSEN Bein.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "huepft um Dich herum.",
        "huepft um @WEN herum.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "knuddelt Dich aufmunternd.",
        "knuddelt @WEN aufmunternd.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
