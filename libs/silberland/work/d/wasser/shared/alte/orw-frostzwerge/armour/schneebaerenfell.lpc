inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Schneebaerenfell");
  SetProp(P_LONG,  
    "Das ist das Fell eines riesigen Schneebaers. Es scheint gut vor "
    "Kaelte zu schuetzen, und hat eine schoene strahlendweisse Farbe." );
  SetProp(P_NAME, "Schneebaerenfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "baerenfell", "schneebaerenfell"}) );
  SetProp(P_INFO, 
    "Du kannst das Schneebaerenfell als Umhang benutzten. Sicher ist es sehr "
    "warm.\n" );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 1800 );
  SetProp(P_VALUE, 800 );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:6, T_HEAT_PROT:-3]) );
  SetProp(P_WORN_TEXT, "umgehaengt");
  SetProp(P_WEAR_TEXT, ({"Du haengst Dir das Schneebaerenfell um.\n",
                         " haengt sich ein Schneebaerenfell um.\n"}) );
}

