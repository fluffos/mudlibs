/* 
** Eine winzige Eishoehle                         2001-08-09 Orw@Silberland
*/


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

int koboldcounter;
int geputzt;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Tief in einer winzigen Eishoehle" );
  SetProp(P_INT_LONG,
   "Du befindest Dich tiefer in der kleinen Eishoehle. Das Licht des "
   "Eingangs erreicht diesen Teil nicht mehr, weshalb es stockdunkel "
   "ist. Hier reichen die Eiszapfen schon bis zum Boden und koennten "
   "schon eher als Eissaeulen bezeichnet werden. Hinter einer dieser "
   "Saeulen befindet sich eine mit Moos bewachsene Stelle auf dem "
   "Boden.");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_CAVE]));

/* Detailbeschreibungen */

  AddDetail( ({"hoehle", "raum", "eishoehle"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"eiszapfen", "zapfen"}),
	 "Von der Decke haengen viele Eiszapfen, von denen manche so lang "
	 "sind, dass sie den Boden beruehren und dadurch Eissaeulen bilden.");
  AddDetail( ({"eingang"}),
	 "Kein Licht dringt mehr vom Eingang in diesen Teil der Hoehle.");
  AddDetail( ({"licht"}),
	 "Das Licht vom Eingang kommt nicht bis hier hin.");
  AddDetail( ({"teil"}),
	 "Dieser Teil der Hoehle war frueher vielleicht mal der Schlafplatz "
	 "fuer einen Baeren.");
  AddDetail( ({"baer", "baeren"}),
	 "Falls hier mal ein Baer war, ist er jetzt sicher fort.");
  AddDetail( ({"moos"}),
	 "Eine Stelle am Boden ist mit Moos ueberwuchert.");
  AddDetail( ({"eiskristall","eiskristalle","kristall","kristalle"}),
	 "Die ganzen Waende sind damit uebersaeht.");
  AddDetail( ({"waende", "wand"}),
	 "Die Waende sind mit vielen Eiskristallen ueberzogen. Leider "
	 "glitzern diese hier nicht, da das Licht des Eingangs fehlt.");
  AddDetail( ({"stelle"}),
	 "Diese mit Moos ueberwucherte Stelle sieht aus wie ein Schlafplatz.");
  AddDetail( ({"schlafplatz","platz"}),
	 "Du bist Dir sicher, es ist bestimmt einer.");
  AddDetail( ({"steine","stein"}),
	 "Der ganze Boden ist mit spitzen Steinen gepflastert.");
  AddDetail( ({"boden"}),
	 "Der Boden ist mit Eis und spitzen Steinen bedeckt.");
  AddDetail( ({"kaelte"}),
	 "Seeeeeeeehr kalt!");
  AddDetail( ({"decke"}),
	 "Die Decke ist ziemlich niedrig. Einige Eiszapfen haengen "
	 "bis zum Boden und bilden Saeulen.");
  AddDetail( ({"eis"}),
	 "Alles hier ist mit Eiskristallen ueberzogen und von der Decke "
	 "haengen lange Eiszapfen die mit dem Boden zu Eissaeulen "
	 "verwachsen sind.");
  AddSpecialDetail( ({"eissaeulen","saeulen"}),"DetailSaeulen"); 
  AddSpecialDetail( ({"eissaeule","saeule"}),"DetailSaeule");
  AddSpecialDetail( ({"etwas"}),"DetailEtwas");

/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Hier ist es friedlich still.");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Ausser kalter Polarluft kannst Du hier nichts riechen.");
  AddSmell( ({"polarluft","luft"}),
         "Erfrischend kalt!");

/* Definition der Funktionen */

  AddCmd( ({"putze", "putz"}), "fktputzen");
    geputzt=0;
  AddCmd( ({"taue", "tau"}), "fktauftauen");
    koboldcounter=0;

/* Ausgaenge */

  AddExit( "nordoben", ROOM"eishoehle1");
  AddExit( "norden",   ROOM"eishoehle1");
  SetProp( P_HIDE_EXITS, ({"norden"}));
}

string DetailSaeulen(){
  if(koboldcounter){
    return BS(
      "Teilweise sind die Eissaeulen meterdick." );
  }
  return BS(
    "Teilweise sind die Eissaeulen meterdick. Eine der Saeulen "
    "erscheint Dir etwas trueb." );
}

string DetailSaeule(){
  if(koboldcounter){
    return BS(
      "Teilweise sind die Eissaeulen meterdick." );
  }
  return BS(
    "Wenn Du sie mit Deinem Aermel sauberputzt siehst Du vielleicht "
    "mehr." );
}

string DetailEtwas(){
  if(geputzt && !koboldcounter){
    return BS(
      "Es starrt Dich an. Vielleicht lebt es noch! Du solltest versuchen "
      "das Eis aufzutauen." );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

int fktputzen(string str)
{
  object ob;
  notify_fail("Was willst Du Womit sauberputzen?\n");
  if(!str) return 0;
  if(str=="eissaeule mit aermel sauber" ||
     str=="saeule mit aermel sauber"){
    if(!geputzt){
      write(BS("Du putzt die Saeule mit Deinem Aermel sauber und erschrickst "
               "fuerchterlich als Dich Etwas aus der Saeule anstarrt."));
      say(BS(TPN+" erschrickt fuerchterlich."));
      geputzt=1;
      return 1;
    }
    else{
      write(BS("Die Saeule ist schon geputzt worden."));
      say(BS(TPN+" gruebelt eine Weile vor sich hin."));
      return 1;
    }
  }
  else return 0;
}

int fktauftauen(string str)
{
  object ob;
  object fackel;
  notify_fail("Was willst Du auftauen?\n");
  if(!str) return 0;
  if(str=="eis auf" ||
     str=="eissaeule auf" ||
     str=="saeule auf"){
    if(!koboldcounter){
      if(fackel=present("fackel",TP)){
      	if(fackel->_query_lighted()){
      	  ob=clone_object(NPC"garbak");
          write(BS("Du haeltst die brennende Fackel lange an die Eissaeule "
                   "und schaust zu wie das Eis schmilzt. Endlich hast Du es "
                   "geschafft und der Gefangene kommt zum Vorschein."));
          say(BS(TPN+" haelt eine Fackel an eine Eissaeule."));
          ob->move(ME, M_GO);
          koboldcounter=1;
          return 1;
        }
        else{
          write(BS("Zuende Deine Fackel doch erstmal an."));
          return 1;
        }
      }
      else{
        write(BS("Du benoetigst eine Fackel um das Eis aufzutauen."));
        return 1;
      }
    }
    else{
      write(BS("Das Eis ist schon aufgetaut worden."));
      say(BS(TPN+" gruebelt eine Weile vor sich hin."));
      return 1;
    }
  }
  else return 0;
}

reset() 
{
  object ob;
  ::reset();
  if(ob=present("EISHOEHLENGARBAK",TO)){
    tell_room(TO, "Der Kobold verwandelt sich wieder in eine Eissaeule.\n");
    ob->remove();    
  }
  koboldcounter=0;
  geputzt=0;
}