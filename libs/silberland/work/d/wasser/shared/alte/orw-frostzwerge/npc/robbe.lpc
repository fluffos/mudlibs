inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Robbe");
  SetProp(P_LONG,
    "Die Robbe hat einen stromlinienfoermigen Koerper und verkuerzte "
    "Gliedmassen. Ihr Fusssohlen werden beim Schwimmen aneinander gelegt "
    "und dienen als Hauptantrieb. Eine dicke Fettschicht unter ihrem "
    "Fell dient zur Isolation gegen die Kaelte.");
  SetProp(P_NAME, "Robbe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));
  AddId(({"robbe", "ROBBE"}));
  set_living_name("robbe");

  create_default_npc(12);
  SetProp(P_HANDS, ({
    " mit ihren kleinen Zaehnchen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Robbe");
  SetProp(P_SIZE, 110+random(10));
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:     -0.3, DT_WATER: -0.3, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "robbt herein");
  SetProp(P_MSGOUT, "robbt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM "k1") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "k15");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);


  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(({"orw","magier","schoepfer"}), 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Robbe will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,15);
  AddSpell(1,300,
    "Die Robbe beisst Dir in den Fuss.\n",
    "Die Robbe beisst @WEM in den Fuss.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Die Robbe gibt lustige Laute von sich.\n",
    "Die Robbe schaut muede herum.\n",
    "Die Robbe reibt sich an Deinem Bein.\n",
    "Die Robbe legt sich faul in den Schnee.\n"}) );
  SetAttackChats(5, ({
    "Die Robbe rollt herum.\n"}) );

  SUID;
  
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  CLONEME(ARMOUR "robbenfell");
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt eine Robbe.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Eine Robbe hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
    call_out("reaction", 0, TP, 
      "quitscht lustig.",
      "quitscht lustig.");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
