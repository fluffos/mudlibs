inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Eiskaefer");
  SetProp(P_LONG,
    "Ein kleiner Eiskaefer krabbelt lustig im Schnee herum. Er hat einen "
    "blaeulich schimmernden Panzer und lustige kleine Zangen zur "
    "Nahrungsaufnahme. Mit seinen Beinchen buddelt er im Schnee.");
  SetProp(P_NAME, "Eiskaefer");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));
  AddId(({"eiskaefer", "kaefer", "EISKAEFER"}));
  set_living_name("eiskaefer");

  create_default_npc(1+random(3));
  SetProp(P_HANDS, ({
    " mit seinen kleinen Zangen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Kaefer");
  SetProp(P_SIZE, 3+random(5));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:     -0.3, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN,  "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "k28");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);


  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(({"orw","magier","schoepfer"}), 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Eiskaefer kann Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,15);
  AddSpell(1,80,
    "Der Eiskaefer zwickt Dich in den grossen Zeh.\n",
    "Der Eiskaefer zwickt @WEN in den grossen Zeh.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Eiskaefer krabbelt an Deinem Bein hoch.\n",
    "Der Eiskaefer knabbert an Deiner Ausruestung.\n",
    "Der Eiskaefer buddelt im Schnee.\n",
    "Der Eiskaefer versucht vor Dir zu fliehen.\n"}) );
  SetAttackChats(5, ({
    "Der Eiskaefer fuerchtet sich.\n"}) );

  SUID;
  
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt einen Eiskaefer.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Eiskaefer hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
    call_out("reaction", 0, TP, 
      "fuerchtet scih vor Dir.",
      "fuerchtet sich vor @WEM.");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
