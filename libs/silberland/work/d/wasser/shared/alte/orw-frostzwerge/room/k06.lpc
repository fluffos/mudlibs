#include "../def.h"
inherit ROOM "inh_kueste";

create()
{
  ::create();

  SetProp(P_INT_LONG, BS(QueryProp(P_INT_LONG)+
            "Neben dem Weg liegt ein hohler Baumstamm."));

  AddDetail(({"baumstamm","stamm"}),
    "Ein umgestuerzter hohler Baumstamm liegt neben dem Weg. Du koenntest "
    "Dich mal draufsetzen um ein wenig zu rasten.");

  AddCmd(({"setze","setz","sitze","sitz"}),"fktsetzen");

/* Ausgaenge */
  AddExit("nordosten", ROOM "k05.lpc");
  AddExit("sueden", ROOM "k07.lpc");
  
}


int fktsetzen(string str)
{
  notify_fail("Worauf moechtest Du Dich setzen?\n");
  if(!str) return 0;
  if(str == "auf baumstamm" ||
     str == "auf stamm"	    ||
     str == "auf baum")
  {
    if (TP->QueryProp(P_RESTING)){
      write("Aber Du rastest Dich doch schon aus!\n");
      return 1;
    }
    if (QueryProp(P_GHOST)){
      write("Als Geist kannst Du nicht rasten oder Ruhe finden!\n");
      return 1;
    }
    if (time() < TP->QueryProp(P_LAST_AWAKE_TIME) + 300){
      write("Du hast Dich doch vor kurzem erst ausgeruht.\n");
      return 1;
    }
    write(BS("Du setzt Dich auf den hohlen Baumstamm und machst es "
             "Dir gemuetlich."));
    say(BS(TPN+" setzt sich gemuetlich auf einen Baumstamm und schliesst "
        "die Augen."));
    TP->command_me("raste");
    return 1;
  }
  return 0;
}

