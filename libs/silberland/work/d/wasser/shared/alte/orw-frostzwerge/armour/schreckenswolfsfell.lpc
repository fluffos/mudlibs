inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include "../def.h"

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Schreckenswolfsfell");
  SetProp(P_LONG,  
    "In Deinen Haenden haeltst Du ein Schreckenswolfsfell. Es ist grau, "
    "nicht besonders huebsch und weist an einigen Stelle grosse Narben "
    "auf. Eine unheilige Aura scheint es zu umgeben." );
  SetProp(P_NAME, "Schreckenswolfsfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "wolfsfell", "schreckenswolfsfell"}) );
  SetProp(P_INFO, 
    "Du kannst das Schreckenswolfsfell als Umhang benutzten. Sicher ist es "
    "besonders warm.\n" );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_PELT:80,MAT_MISC_UNHOLY:20]) );
  SetProp(P_WEIGHT, 1500 );
  SetProp(P_VALUE, 900 );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:7, T_HEAT_PROT:-3]) );
  SetProp(P_WORN_TEXT, "umgehaengt");
  SetProp(P_WEAR_TEXT, ({"Du haengst Dir das Schreckenswolfsfell um.\n",
                         " haengt sich ein Schreckenswolfsfell um.\n"}) );
  SetProp(P_DAM_PROTECTION, 
      QueryProp(P_DAM_PROTECTION)+([DT_HOLY:1]) );
  
  SetProp(P_DEFEND_FUNC, ME);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if ((member(dam_type, DT_HOLY) != -1))
  {
    if(!random(2))
      tell_object (QueryProp(P_WORN), 
        "Die unheilige Aura des Schreckenswolfsfells schwaecht den Schaden ab.\n");
  }
  return 0;
}