inherit "std/weapon";

#include <properties.h>    
#include <combat.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine Donneraxt");
  SetProp (P_LONG,
    "Die Donneraxt ist eine der schoensten Aexte des ganzen Silberlands. "
    "Ihr Eichenholzstiel ist mit Lederriemen umwickelt. Um das Axtblatt "
    "scheinen von Zeit zu Zeit kleine Blitze zu zucken. Sie gehoerte "
    "einst einem Koenig der Zwerge und wurde vom Donnergott selbst "
    "gesegnet.");
  SetProp (P_NAME, "Donneraxt");
  SetProp (P_GENDER, FEMALE);
  AddId (({"axt", "donneraxt"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 250);
  SetProp(P_WC_FIX, 17);
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":130, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH,DT_LIGHTNING,DT_SOUND}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, 
    ([MAT_MITHRIL:45, MAT_OAK:45, MAT_LEATHER:5, MAT_LIGHTNING:5]) );
  SetProp(P_WEIGHT, 4500);
  SetProp(P_VALUE, 4000);
  SetProp(P_SIZE, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:22, A_DEX: 22, P_LEVEL: 30]) );
  
  AddDetail( ({"axtblatt", "blatt", "mithrilaxtblatt", "mithril"}),
    "Das Axtblatt der Donneraxt besteht aus feinstem magischen "
    "Mithril.");
  AddDetail( ({"lederriemen", "riemen","stiel"}),
    "Der Stiel ist mit schwarzen Lederriemen umwickelt.");
}

