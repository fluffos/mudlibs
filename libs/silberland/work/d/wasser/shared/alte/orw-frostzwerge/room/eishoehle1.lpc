/* 
** Eine winzige Eishoehle                         2001-08-09 Orw@Silberland
*/


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

int kristallcounter;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer winzigen Eishoehle" );
  SetProp(P_INT_LONG,
   "Du befindest Dich in einer winzigen Hoehle, von deren Decke lange "
   "Eiszapfen haengen. Durch den Eingang stroemt Licht herein und taucht "
   "die ganze Hoehle in ein unwirkliches Glitzern. Die Waende sind mit "
   "vielen kleinen Eiskristallen ueberzogen und bestehen aus hartem grauen "
   "Felsgestein. Harte spitze Steine bilden den Boden und machen diesen Ort, "
   "trotz seiner Schoenheit, ziemlich ungastlich.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_CAVE]));

/* Detailbeschreibungen */

  AddDetail( ({"hoehle", "raum", "ort"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"eiszapfen", "zapfen"}),
	 "Von der Decke haengen viele Eiszapfen, von denen manche so lang "
	 "sind, dass sie fast den Boden beruehren.");
  AddDetail( ({"eingang"}),
	 "Durch den Eingang stroemt etwas Licht herein und taucht die ganze "
	 "Hoehle in ein wunderschoenes Glitzern.");
  AddDetail( ({"licht"}),
	 "Das Licht wird durch die Eiskristalle und Eiszapfen reflektiert "
	 "und dadurch glitzert die Hoehle so schoen.");
  AddDetail( ({"glitzern", "glitzer"}),
	 "Das Glitzern hat eine fast hypnotische Wirkung auf Dich. Es ist "
	 "einfach wunderschoen.");
  AddDetail( ({"wirkung", "hypnotische wirkung"}),
	 "Du schaust lieber schnell weg, bevor es Dich noch ganz in seinen "
	 "Bann zieht.");
  AddDetail( ({"bann"}),
	 "Oh, das waer jetzt fast ein Blick zuviel gewesen.");
  AddDetail( ({"eiskristall","eiskristalle","kristall","kristalle"}),
	 "Noch nie zuvor hast Du so grosse huebsche Eiskristalle gesehen. "
	 "Die ganzen Waende sind damit uebersaeht.");
  AddSpecialDetail( ({"blick"}),          "DetailBlick"); 
  AddSpecialDetail( ({"form"}),           "DetailForm");
  AddSpecialDetail( ({"kanten", "kante"}),"DetailKanten");
  AddSpecialDetail( ({"bergkristall"}),   "DetailKristall");
  AddDetail( ({"waende", "wand"}),
	 "Die Waende sind mit vielen Eiskristallen ueberzogen, sie glitzern "
	 "in allen Farben.");
  AddDetail( ({"farben", "farbe"}),
	 "Es sind zu viele, um sie zu zaehlen...");
  AddDetail( ({"felsgestein","gestein","fels"}),
	 "Extrem hartes Gestein.");
  AddDetail( ({"steine","stein"}),
	 "Der ganze Boden ist mit spitzen Steinen gepflastert.");
  AddDetail( ({"boden"}),
	 "Der Boden ist mit Eis und spitzen Steinen bedeckt.");
  AddDetail( ({"schoenheit"}),
	 "Ein wirklich wunderbarer Ort, trotz der Kaelte.");
  AddDetail( ({"kaelte"}),
	 "Seeeeeeeehr kalt!");
  AddDetail( ({"decke"}),
	 "Die Decke ist ziemlich niedrig. Einige Eiszapfen haengen fast "
	 "bis zum Boden.");
  AddDetail( ({"eis"}),
	 "Alles hier ist mit Eiskristallen ueberzogen und von der Decke "
	 "haengen lange Eiszapfen.");

/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Hier ist es friedlich still.");


/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Ausser kalter Polarluft kannst Du hier nichts riechen.");
  AddSmell( ({"polarluft","luft"}),
         "Erfrischend kalt!");

/* Definition der Funktionen */

  AddCmd( ({"breche", "brich", "brech"}), "fktabbrechen");
    kristallcounter=1;

/* Ausgaenge */

  AddExit("nordwestoben",ROOM"k33");
  AddExit("nordwesten",ROOM"k33");
  AddExit("suedunten", ROOM"eishoehle2");
  AddExit("sueden",    ROOM"eishoehle2");
  SetProp( P_HIDE_EXITS, ({"sueden","nordwesten"}));
}

string DetailBlick(){
  if (kristallcounter){
    return BS(
      "Dein Blick wandert durch die Hoehle und bleibt an einem "
      "grossen Eiskristall mit einer seltsamen Form haengen." );
  }
  return BS(
    "Dein Blick wandert durch die Hoehle." );
}

string DetailForm(){
  if (kristallcounter){
    return BS(
      "Der Kristall ist sehr lang und hat fuenf Kanten." );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

string DetailKanten(){
  if (kristallcounter){
    return BS(
      "Als Du die Kanten genauer betrachtest, bist Du Dir sicher das "
      "dieser Kristall kein Eiskristall ist. Es scheint ein Bergkristall "
      "zu sein.");
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

string DetailKristall(){
  if (kristallcounter){
    return BS(
      "Du willst ihn umbedingt haben, ob man ihn vielleicht abbrechen kann?");
  }
  return BS(
    "Falls hier mal ein Bergkristall war, hat ihn schon jemand genommen." );
}

int fktabbrechen(string str)
{
  object ob;
  notify_fail("Was willst Du abbrechen?\n");
  if(!str) return 0;
  if(str=="eiszapfen ab" ||
     str=="zapfen ab"){
    write(BS("Die Eiszapfen hier sind so wunderschoen. Du laesst sie "
             "lieber stehen."));
    return 1;
  }
  if(str=="kristall ab" ||
     str=="bergkristall ab"){
    if(kristallcounter){
      ob=clone_object("/obj/gems/bergkristall");
      write(BS("Du brichst den schoenen Bergkristall ab."));
      say(BS(TPN+" bricht einen schoenen Bergkristall ab."));
      if ( ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT) )
      {
        tell_object(TP,
          "Leider ist Dir der Bergkristall zu schwer und Du laesst ihn auf den "
          "Boden fallen, wo er zwischen den spitzen Steinen verschwindet.\n");
        ob->remove();
        return 1;
      }
      kristallcounter=0;
      return 1;
    }
    else{
      write(BS("Leider ist hier kein Bergkristall mehr."));
      say(BS(TPN+" macht sich an der Wand zu schaffen."));
      return 1;
    }
  }
  else return 0;
}

reset() 
{
  ::reset();
  kristallcounter=1;
}