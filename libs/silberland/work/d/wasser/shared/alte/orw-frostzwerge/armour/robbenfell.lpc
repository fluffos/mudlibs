inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Robbenfell");
  SetProp(P_LONG,  
    "Das ist das Fell einer Robbe. Es hat mal eine Robbe vor "
    "Kaelte geschuetzt, vielleicht schuetzt es ja nun Dich." );
  SetProp(P_NAME, "Robbenfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "robbenfell"}) );
  SetProp(P_INFO, 
    "Du kannst das Robbenfell als Umhang benutzten. Sicher ist es sehr "
    "warm.\n" );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 1500 );
  SetProp(P_VALUE, 700 );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5, T_HEAT_PROT:-2]) );
  SetProp(P_WORN_TEXT, "umgehaengt");
  SetProp(P_WEAR_TEXT, ({"Du haengst Dir das Robbenfell um.\n",
                         " haengt sich ein Robbenfell um.\n"}) );
}

