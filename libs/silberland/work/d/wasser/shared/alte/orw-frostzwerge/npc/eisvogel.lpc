inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Eisvogel");
  SetProp(P_LONG,
    "Vor Dir ist ein sehr huebscher Eisvogel. Sein Gefieder zeigt "
    "einen blaeulich glaenzenden Schimmer. Solche Voegel sieht "
    "man ziemlich selten, Du hast wirklich Glueck hier einen "
    "anzutreffen.");
  SetProp(P_NAME, "Eisvogel");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));
  AddId(({"eisvogel", "vogel", "EISVOGEL"}));
  set_living_name("eisvogel");

  create_default_npc(3+random(4));
  SetProp(P_HANDS, ({
    " mit seinem Schnabel",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 8+random(2));
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, QueryProp(P_MAX_HP)/5);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.3, DT_COLD:     -0.6, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.3, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "k01");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);


  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(({"orw","magier","schoepfer"}), 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Eisvogel kann Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,10);
  AddSpell(1,200,
    "Der Eisvogel piekst Dich ins Bein.\n",
    "Der Eisvogel piekst @WEN ins Bein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Eisvogel macht einen Salto in der Luft.\n",
    "Der Eisvogel zeigt Dir seine Flugkuenste.\n",
    "Der Eisvogel fliegt einmal rund um Dich.\n",
    "Der Eisvogel macht eine dreifache Spirale in der Luft.\n"}) );
  SetAttackChats(10, ({
    "Der Eisvogel flattert erschrocken herum.\n"}) );

  SUID;
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt den Eisvogel.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Der Eisvogel hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "zwitschert ein Liedchen.",
        "zwitschert ein Liedchen.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "flattert aufgeregt.",
        "flattert aufgeregt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "fliegt lustig um Dich herum.",
        "fliegt lustig um Dich herum.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "fuerchtet sich.",
        "fuerchtet sich.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "versucht sich zu verstecken.",
        "versucht sich zu verstecken.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "fliegt weit in die Wolken und kommt im Sturzflug zurueck.", 
        "fliegt weit in die Wolken und kommt im Sturzflug zurueck.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "zwitschert eine schoene Melodie.",
        "zwitschert eine schoene Melodie.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "setzt sich kurz auf Deine Schulter.",
        "setzt sich kurz auf @WESSEN Schulter.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "setzt sich kurz auf Deinen Kopf.",
        "setzt sich kurz auf @WESSEN Kopf.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "zwitschert aufmunternd.",
        "zwitschert aufmunternd.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
