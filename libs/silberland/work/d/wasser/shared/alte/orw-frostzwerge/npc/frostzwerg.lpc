inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../include/eigenschaft.h"  // Defines der Eigenschaften
#include "../include/npcdef.h"       // Defines der Chats, DefaultInfos usw.
#include "../def.h"

// Um unterschiedliche Frostzwerge zu machen...
int r;
string lang;

// Fuer die Reactions...
string *veraergert1;
string *veraergert2;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  // Eine der vielen Eigenschaften wird per random ausgewaehlt
  // Sie wirkt sich auf fast jede Property aus
  r=random(sizeof(eigenschaften))+1; 
  
  veraergert1=({});
  veraergert2=({});

  SetProp(P_SHORT, "Ein "+ADJ(r)+"er Frostzwerg");
  SetProp(P_NAME, "Frostzwerg");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, ADJ(r));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-30,T_RANGE_MAX:30]));
  AddId(({"frostzwerg", "zwerg", "FROSTZWERG"}));
  AddAdjective(({ADJ(r),ADJ(r)+"en",ADJ(r)+"er"}));
  set_living_name("frostzwerg");

  create_default_npc(15+ZLVL(r));
  
  SetProp(P_HANDS, ({
    " "+SHANDS(r),QueryProp(P_HANDS)[1]+ZHANDS(r),DAMTYP(r)}));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+ZHPS(r));
  SetProp(P_BODY, QueryProp(P_BODY)+ZBODY(r));
  SetProp(P_XP, QueryProp(P_XP)+ZXPS(r)*100); 
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110+random(11)+ZSIZE(r));
  SetProp(P_ALIGN, 0+ZALIGN(r));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,AGGR(r));
  
  if(WIMP(r)){
    SetProp(P_WIMPY, (QueryProp(P_MAX_HP)/100)*WIMP(r));
  }
  if(WIMP(r)){
    SetProp(P_WIMPY, WIMP(r));
  }
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.3, DT_COLD:     -0.6, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.3, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  
  SetAttackChats(10, FZATTACKCHATS);
  
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, ADJ(r)+"er Frostzwerg");
  SetProp(P_KILL_MSG, "Du hattest keine Chance!");

  SetProp(P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" bedankt sich artig.\n" }) );

  AddInfo(DEFAULT_INFO, FZSTDINFOS);
  AddLibrary(LIB "allgemein.lib",1,1);


  SetProp(P_SPELLRATE,SPRATE(r));
  SetProp(P_NOMAGIC, NOMAG(r));

  AddSpell(1,QueryProp(P_LEVEL)*10,
    "Der "+ADJ(r)+"e Frostzwerg rammt Dir seinen Kopf in den Bauch.\n",
    "Der "+ADJ(r)+"e Frostzwerg rammt @WEM seinen Kopf in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,QueryProp(P_LEVEL)*10,
    "Der "+ADJ(r)+"e Frostzwerg schlaegt "+SHANDS(r)+" auf Dich ein.\n",
    "Der "+ADJ(r)+"e Frostzwerg schlaegt "+SHANDS(r)+" auf @WEN ein.\n",
    DAMTYP(r),([SP_SHOW_DAMAGE:1]));
  if(ZLVL(r)>5)
    AddSpell(1,QueryProp(P_LEVEL)*15,
      "Der "+ADJ(r)+" Frostzwerg beisst Dir in die Hand.\n",
      "Der "+ADJ(r)+" Frostzwerg beisst @WEM in die Hand.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  if(ZLVL(r)>10)
    AddSpell(1,QueryProp(P_LEVEL)*15,
      "Der "+ADJ(r)+" Frostzwerg rast auf Dich zu.\n",
      "Der "+ADJ(r)+" Frostzwerg rast auf @WEN zu.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  if(SPRATE(r)>10)
    AddSpell(1,QueryProp(P_LEVEL)*15,
      "Der "+ADJ(r)+" Frostzwerg belegt Dich mit einem frostigen Fluch.\n",
      "Der "+ADJ(r)+" Frostzwerg belegt @WEN mit einem frostigen Fluch.\n",
      ({DT_COLD,DT_TERROR}),([SP_SHOW_DAMAGE:1]));

  SUID;

  if(random(100)<30)
    CLONEME("/p/armour/gloves/faeustlinge");
    
  switch(RSTW(r)){
    case 0:
      if(random(100)<60)
        CLONEME("/p/armour/trousers/hose");
      break;
    case 1:
      if(random(100)<60)
        CLONEME("/p/armour/trousers/fellhose");
      if(random(100)<40)
        CLONEME("/p/armour/boots/fellstiefel");
      if(random(100)<50)
        CLONEME("/p/armour/cloak/fellumhang");
      if(random(100)<60)
        CLONEME("/p/armour/helm/pudelmuetze");
      if(random(100)<30)
        CLONEME("/p/armour/armour/lederruestung");
      break;
    case 2:
      if(random(100)<70)
        CLONEME("/p/armour/trousers/fellhose");
      if(random(100)<70)
        CLONEME("/p/armour/boots/fellstiefel");
      if(random(100)<70)
        CLONEME("/p/armour/cloak/fellumhang");
      if(random(100)<60)
        CLONEME("/p/armour/helm/wollmuetze");
      if(random(100)<50)
        CLONEME("/p/armour/armour/lederpanzer");
      break;
    case 3:
      if(random(100)<80)
        CLONEME("/p/armour/trousers/fellhose");
      if(random(100)<80)
        CLONEME("/p/armour/boots/lederstiefel");
      if(random(100)<80)
        CLONEME("/p/armour/cloak/fellumhang");
      if(random(100)<60)
        CLONEME("/p/armour/helm/kampfhelm");
      if(random(100)<60)
        CLONEME("/p/armour/armour/kettenpanzer");
      break;
    case 4:
      if(random(100)<80)
        CLONEME("/p/armour/trousers/lederbeinschienen");
      if(random(100)<85)
        CLONEME("/p/armour/boots/kampfstiefel");
      if(random(100)<70)
        CLONEME("/p/armour/cloak/baerenfell");
      if(random(100)<20)
        CLONEME("/p/armour/ring/ring");
      if(random(100)<60)
        CLONEME("/p/armour/helm/kettenhaube");
      if(random(100)<60)
        CLONEME("/p/armour/armour/titanpanzer");
      break;
    case 5:
      if(random(100)<80)
        CLONEME("/p/armour/trousers/kettenhose");
      if(random(100)<95)
        CLONEME("/p/armour/boots/kampfstiefel");
      if(random(100)<90)
        CLONEME("/p/armour/cloak/umhang");
      if(random(100)<40)
        CLONEME("/p/armour/ring/ring");
      if(random(100)<80)
        CLONEME("/p/armour/helm/kettenhaube");
      if(random(100)<60)
        CLONEME("/p/armour/armour/plattenpanzer");
      break;
  }
  call_out("set_zwerg",0);
}

// Hier wird der Zwerg an seinen Startraum angepasst:
// Zwerge die Indoors geclont werden sollen sich auch nur Indoors
// fortbewegen - umgekehrt genauso...
// Das P_LONG ergibt sich aus den Fertigkeiten des Zwergs -
// definiert in ../include/eigenschaft.h
void set_zwerg(){
  lang="";
  if(ZSIZE(r)>5)
    lang+="Er ist ziemlich gross fuer seine Rasse. ";
  if(ZSIZE(r)<(-5))
    lang+="Er ist ziemlich klein fuer seine Rasse. ";
  if(ZALIGN(r)>=100)
    lang+="Laechelnd guckt er Dich mit strahlenden Augen an. ";
  if(ZALIGN(r)<=(-100))
    lang+="Aus boese funkelnden Augen guckt er Dich an. ";
  if(WIMP(r))
    lang+="Irgendwie kommt er Dir ein bischen feige vor. ";
  if(!WIMP(r))
    lang+="Er scheint bereit, seine Stadt mit all seiner Kraft zu "
          "verteidigen. ";
  if(ZHANDS(r)>=10)
    lang+="Mit wilder Entschlossenheit ballt er seine Faeuste. ";
  if(ZHANDS(r)<=(-10))
    lang+="Seine Armmuskeln wirken schwach gegenueber anderen Zwergen. ";
  if(ZLVL(r)>=10)
    lang+="Ein Kampf gegen ihn scheint haerter zu sein, als gegen "
          "die meisten anderen seiner Rasse. ";
  if(SPRATE(r)>10)
    lang+="Der "+ADJ(r)+"e Frostzwerg hat so manchen Trick drauf. "
          "Nimm Dich lieber vor ihm in acht. ";
  if(AGGR(r))
    lang+="Etwas an ihm gefaellt Dir gar nicht, er scheint aggressiv "
          "zu sein. ";
  if(ZBODY(r)>=10)
    lang+="Fuer so einen kleinen Kerl sieht er ziemlich robust aus. ";
  if(ZBODY(r)<=(-10))
    lang+="Sein Koerper scheint lang nicht so gestaehlt zu sein, als es "
          "ansonsten bei Frostzwergen ueblich ist. ";
  if(!MENV->QueryProp(P_INDOORS))
    lang+="Er befindet sich gerade auf der Jagd nach Eistrollen, oder "
          "wilden Tieren. ";
  if(MENV->QueryProp(P_INDOORS))
    lang+="Er schlendert durch die Gaenge seiner Stadt. ";

  SetProp(P_LONG, "Vor Dir steht ein "+ADJ(r)+"er Frostzwerg. "+lang);
  SetProp(P_MNPC_DEFAULTROOM, file_name(MENV));

  SUID;
  // Zwerg laeuft in der Stadt rum - nur zu 50% eine Waffe und
  // an innen angepasste MSGIN, MSGOUT und MNPC_FLAGS
  // Andere Chats in der Stadt als draussen auf der Insel
  if(MENV->QueryProp(P_INDOORS)){
    SetProp(P_MSGIN, "kommt herein");
    SetProp(P_MSGOUT, "geht");
    SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
    SetChats(2, FZCHATSINDOOR);
    if(random(100)<50){
    switch(RSTW(r)){
      case 0:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/axe/steinbeil");
            CLONEME("/p/armour/shield/lederschild");
            break;
          case 1:
            CLONEME("/p/weapon/axe/steinbeil");
            break;
        }
      break;
      case 1:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/axe/handbeil");
            CLONEME("/p/armour/shield/holzschild");
            break;
          case 1:
            CLONEME("/p/weapon/chain/dreschflegel");
            break;
        }
      break;
      case 2:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/axe/handaxt");
            CLONEME("/p/armour/shield/holzschild");
            break;
          case 1:
            CLONEME("/p/weapon/club/vorschlaghammer");
            break;
        }
      break;
      case 3:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/club/kampfhammer"); 
            CLONEME("/p/armour/shield/eisenschild");
            break;
          case 1:
            CLONEME("/p/weapon/axe/obsidianaxt"); // selbst gemachte Axt?
            break;
        }
      break;
      case 4:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/club/kampfhammer");
            CLONEME("/p/armour/shield/stahlschild");
            break;
          case 1:
            CLONEME("/p/weapon/axe/obsidianaxt");
            break;
        }
      break;
      case 5:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/axe/kriegsbeil"); 
            CLONEME("/p/armour/shield/titanschild");
            break;
          case 1:
            CLONEME("/p/weapon/club/streithammer"); // selbst gemachte Axt?
            break;
        }
      break;
    }
    }
    if(random(100)<10)
      CLONEME("/d/gebirge/eros/obj/beutel");    
  }
  // Zwerg laeuft auf der Insel rum (Jagd) - immer eine Waffe und
  // an aussen angepasste MSGIN, MSGOUT und MNPC_FLAGS
  // Andere Chats bei der Jagd als drinnen in der Zwergenstadt
  else {
    SetProp(P_MSGIN, "stapft durch den Schnee herein");
    SetProp(P_MSGOUT, "stapft durch den Schnee");
    SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
    SetChats(2, FZCHATSOUTDOOR);
    switch(RSTW(r)){
      case 0:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/axe/steinbeil");
            CLONEME("/p/armour/shield/lederschild");
            break;
          case 1:
            CLONEME("/p/weapon/axe/steinbeil");
            break;
        }
      break;
      case 1:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/axe/handbeil");
            CLONEME("/p/armour/shield/holzschild");
            break;
          case 1:
            CLONEME("/p/weapon/chain/dreschflegel");
            break;
        }
      break;
      case 2:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/axe/handaxt");
            CLONEME("/p/armour/shield/holzschild");
            break;
          case 1:
            CLONEME("/p/weapon/club/vorschlaghammer");
            break;
        }
      break;
      case 3:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/club/kampfhammer"); 
            CLONEME("/p/armour/shield/eisenschild");
            break;
          case 1:
            CLONEME("/p/weapon/axe/obsidianaxt"); // selbst gemachte Axt?
            break;
        }
      break;
      case 4:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/club/kampfhammer");
            CLONEME("/p/armour/shield/stahlschild");
            break;
          case 1:
            CLONEME("/p/weapon/axe/obsidianaxt");
            break;
        }
      break;
      case 5:
        switch(random(2)){
          case 0:
            CLONEME("/p/weapon/axe/kriegsbeil"); 
            CLONEME("/p/armour/shield/titanschild");
            break;
          case 1:
            CLONEME("/p/weapon/club/streithammer"); // selbst gemachte Axt?
            break;
        }
      break;
    }
    if(random(100)<50)
      CLONEME("/d/gebirge/eros/obj/beutel");    
  }
  command("trage alles");
  if(present("axt",TO))
    command("zuecke axt");
  if(present("hammer",TO))
    command("zuecke hammer");
  if(present("flegel",TO))
    command("zuecke flegel");  
  if(random(100)<10)
    TO->AddMoney(20+random(20));
  if(random(100)< 5)
    "/obj/gemmaster"->DistributeGem(1,2,1,1);
  if(present("beutel",TO))
    TO->command_me("stecke alles ausser behaltenes in beutel");
}

// Wenn der Frostzwerg einen Edelstein bekommt...
void give_notify(object ob){
  if(ob->id("edelstein")){
    say(Name(WER,1)+"sagt: Wow, danke "+TPN+"!!!\n"+
        Name(WER,1)+"sagt: Ich liebe Edelsteine!\n");
    if(present("beutel",TO))
      TO->command_me("stecke "+ob->QueryProp(P_IDS)[0]+" in beutel");
    return;
  }
  else {
    ::give_notify(ob);
  }
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt den "+ADJ(r)+"en Frostzwerg.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp){
  if(killer == ME)
    write_file(LOG "npc.deads",
      sprintf(ctime()+": Ein "+ADJ(r)+"er Frostzwerg hat gerade "+
        CAP(getuid(player))+" umgebracht. - "
        "%d LVL %d XPs\n",player->QueryProp(P_LEVEL),lostexp));
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "grinst: Keine Angst! Ich bin ja bei Dir!",
        "grinst: Keine Angst, "+TPN+"! Ich bin ja bei Dir!");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "gnurrt: Pff, bloedel hier nicht rum!",
        "gnurrt: Pff, bloedel hier nicht rum, "+TPN+"!");
      break;
    case "fies":
      if ( member(veraergert1,getuid(TP)) != -1 )
      	call_out( "reaction_angriff", 0, TP,
      	  "hat genug von Deinen Frechheiten und greift Dich an.",
      	  "hat genug von "+TP->name(WESSEN)+" Frechheiten und greift "+
      	  TP->QueryPronoun(WEN)+" an." );
      else 
        call_out( "reaction", 0, TP,
          "warnt Dich: Mach das nicht noch einmal!",
          "warnt "+TPN+": Mach das nicht noch einmal!" );
        veraergert1 += ({ getuid(TP) });  
      break;
    case "frech":
      if ( member(veraergert2,getuid(TP)) != -1 )
      	call_out( "reaction_schlag", 0, TP,
      	  "gibt Dir eine schallende Ohrfeige.",
      	  "gibt "+TPN+" eine schallende Ohrfeige." );
      else 
        call_out( "reaction", 0, TP,
          "warnt Dich: Hoer auf mit dem Bloedsinn!",
          "warnt "+TPN+": Hoer auf mit dem Bloedsinn!" );
        veraergert2 += ({ getuid(TP) });  
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "grinst Dich an.", 
        "grinst "+TPN+" an.");
      break;
    case "intim":
      if(TP->QueryProp(P_GENDER)==FEMALE)
        call_out("reaction", 0, TP,
          "erroetet: Oh, "+TPN+" mein Herzchen!",
          "erroetet: Oh, "+TPN+" mein Herzchen!");
      else 
        call_out( "reaction", 0, TP,
          "arglt: Hau bloss ab!",
          "arglt: Hau bloss ab, "+TPN+"!" );
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "grummelt: Hmpf, stehst Du gern im Weg?",
        "grummelt "+TPN+" an: Hmpf, stehst Du gern im Weg?");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich grummelnd.",
        "troestet Dich grummelnd.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

// Der Spieler war zu fies...
void reaction_angriff(object ob, string macher, string andere)
{
  if ( present(ob, ENV(TO)) )
  {
    tell_object( ob, BS(Name(WER, 1)+" "+macher) );
    tell_room( ENV(TO), BS(Name(WER, 1)+" "+andere), ({ ob }) );
  }	
  veraergert1 -= ({ getuid(TP) }); 
  Kill(TP);
}

// Der Spieler war zu frech...
void reaction_schlag(object ob, string macher, string andere)
{
  if ( present(ob, ENV(TO)) )
  {
    tell_object( ob, BS(Name(WER, 1)+" "+macher) );
    tell_room( ENV(TO), BS(Name(WER, 1)+" "+andere), ({ ob }) );
  }	
  veraergert2 -= ({ getuid(TP) }); 
  TP->do_damage(5)+random(5);
}
