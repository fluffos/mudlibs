inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schreckenswolf");
  SetProp(P_LONG,
    "Der Schreckenswolf hat ein graues, durch viele Kaempfe zernarbtes "
    "Fell. Seine Augen funkeln rot und aus seinem Maul tropft noch das Blut "
    "seiner letzten Opfer. Er schleicht um Dich herum und jagt Dir "
    "ordentlich Angst ein.");
  SetProp(P_NAME, "Schreckenswolf");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:20]));
  AddId(({"schreckenswolf", "wolf", "SCHRECKENSWOLF"}));
  set_living_name("schreckenswolf");

  create_default_npc(25);
  SetProp(P_HANDS, ({
    " mit gefletschten Zaehnen",QueryProp(P_HANDS)[1],({DT_TERROR,DT_RIP})}));
  SetProp(P_RACE, "Wolf");
  SetProp(P_SIZE, 140+random(10));
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:     -0.3, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR:-0.5,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "raum1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);


  AddInfo(DEFAULT_INFO, "knurrt Dich boese an.\n");
  AddInfo(({"orw","magier","schoepfer"}), 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schreckenswolf will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,500,
    "Der Schreckenswolf zerkratzt Dir das Gesicht.\n",
    "Der Schreckenswolf zerkratzt @WEM das Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,700,
    "Der Schreckenswolf beisst Dir in die Kehle.\n",
    "Der Schreckenswolf beisst @WEM in die Kehle.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Schreckenswolf schnueffelt herum.\n",
    "Der Schreckenswolf heult furchteregend.\n",
    "Der Schreckenswolf fletscht seine Zaehne.\n",
    "Der Schreckenswolf knurrt Dich boese an.\n"}) );
  SetAttackChats(5, ({
    "Der Schreckenswolf wird ganz rasend.\n"}) );

  SUID;
  
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  CLONEME(ARMOUR "schreckenswolfsfell");
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt einen Schreckenswolf.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ein Schreckenswolf hat gerade "+
      CAP(getuid(player))+" umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "fletscht gierig seine Zaehne.",
        "fletscht gierig seine Zaehne.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "heult das Dir das Blut in den Adern gefriert.",
        "heult das @WEM das Blut in den Adern gefriert.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "funkelt Dich boese an.",
        "funkelt @WEN boese an.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "knurrt Dich boese an.",
        "knurrt @WEN boese an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "wetzt schon mal seine Klauen.",
        "wetzt schon mal seine Klauen.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "knurrt wild.", 
        "knurrt wild.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "schuettelt sein Fell.",
        "schuettelt sein Fell.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "beachtet Dich gar nicht.",
        "beachtet @WEN gar nicht.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "kratzt sich.",
        "kratzt sich.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "scharrt im Schnee herum.",
        "scharrt im Schnee herum.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
