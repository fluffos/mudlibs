inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Winterwolfsfell");
  SetProp(P_LONG,  
    "In Deinen Haenden haeltst Du das wunderschoene weisse Fell eines "
    "Winterwolfs. Da der Winterwolf in sehr kalten Gebieten beheimatet "
    "ist scheint dieses Fell sehr gut vor Kaelte zu schuetzen." );
  SetProp(P_NAME, "Winterwolfsfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "wolfsfell", "winterwolfsfell"}) );
  SetProp(P_INFO, 
    "Du kannst das Winterwolfsfell als Umhang benutzten. Sicher ist es "
    "besonders warm.\n" );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 1500 );
  SetProp(P_VALUE, 900 );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:7, T_HEAT_PROT:-3]) );
  SetProp(P_WORN_TEXT, "umgehaengt");
  SetProp(P_WEAR_TEXT, ({"Du haengst Dir das Winterwolfsfell um.\n",
                         " haengt sich ein Winterwolfsfell um.\n"}) );
}

