/* 
** Der Kuestenweg                                 2001-07-09 Orw@Silberland
*/

#include "../def.h"
inherit ROOM "inh_kueste";

int gegraben;

create()
{
  ::create();
  
  SetProp(P_INT_LONG, BS(QueryProp(P_INT_LONG)+
            "Neben dem Weg ist ein grosser Schneehaufen und dahinter "
            "befindet sich eine steile Felswand."));
  AddDetail(({"schneehaufen","haufen"}),
    "Ein wirklich riesiger Schneehaufen. Ob sich darunter Etwas verbirgt?");
  AddDetail(({"etwas"}),
    "Hm... Du koenntest ja versuchen hier zu graben.");
  AddDetail(({"felswand","wand"}),
    "Eine riesige steile Felswand ragt hinter dem Schneehaufen auf.");
  AddSpecialDetail( ({"hoehle"}),   "DetailHoehle");
  AddSpecialDetail( ({"eingang"}),  "DetailHoehle");
    
  AddCmd(({"grabe","grab"}),"fktgraben");
    gegraben=0;

/* Ausgaenge */
  AddExit("westen", ROOM "k32.lpc");
  AddExit("nordosten", ROOM "k34.lpc");
}

string DetailHoehle()
{
  if(gegraben)
    return BS("Hier wurde ein Eingang zu einer Hoehle nach Suedostunten "
              "freigelegt.");
  else
    return BS("Sowas siehst Du da nicht!");
}

int fktgraben(string str)
{
  notify_fail("In was moechtest Du graben?\n");
  if(!str) return 0;
  
  if(str=="in schneehaufen" ||
     str=="im schneehaufen" ||
     str=="in haufen"       ||
     str=="im haufen");
    if(gegraben){
      write(BS("Hier wurde schon gegraben, deswegen gehts auch nach "
               "Suedostunten."));
      return 1;
    }     
    if(present("schaufel",TP)){
      write(BS("Du beginnst zu graben..."));
      say(BS(TPN+" beginnt zu graben."));
      TP->SetProp(P_PARALYZED,
      ([PARALYZE_TIME:4,
        PARALYZE_MSG:"Aber Du graebst doch gerade!\n",
        PARALYZE_MSG_OTHER:"",
        PARALYZE_END:"",
        PARALYZE_END_OTHER:""]));
      call_out("storygraben1",3);
      return 1;
    }
    else{
      write(BS("Du brauchst eine Schaufel um hier zu graben."));
      return 1;
    }
}

int storygraben1()
{
  write("Du graebst und graebst und graebst...\n");
  say(TPN+" graebt und graebt und graebt...\n",TP);
  call_out("storygraben2",3);
  return 1;  
}

int storygraben2()
{
  if(present("schneeschaufel",TP)){
    write(BS("Endlich... Unter dem Schneehaufen scheint ein Eingang zu einer "
             "Hoehle zu sein."));
    say(TPN+" legt einen Eingang in eine Hoehle frei.\n",TP);
    AddExit("suedostunten", ROOM"eishoehle1");
    AddExit("suedosten",    ROOM"eishoehle1");
    SetProp( P_HIDE_EXITS, ({"suedosten"}));
    gegraben=1;
    return 1;
  }
  else{
    write(BS("Enttaeuscht gibst Du auf. Du brauchst anscheinend eine "
             "fuer den Schnee geeignetere Schaufel."));
    say(TPN+" gibt enttaeuscht auf.\n",TP);    
    return 1;
  }
  return 1;  
}

reset() 
{
  ::reset();
  RemoveExit(({"suedostunten","suedosten"}));
  gegraben=0;
}