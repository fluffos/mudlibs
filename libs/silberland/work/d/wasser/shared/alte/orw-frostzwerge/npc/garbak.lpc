inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"
#include "../include/npcdef.h"
#include "../include/npcinits.h"



void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Garbak, der Eiskobold");
  SetProp(P_LONG,
    "Vor Dir steht ein kleiner Kobold. Er hat buschige Augenbrauen und "
    "von seiner Nasenspitze haengen kleine Eiszapfen. Obwohl er so klein "
    "ist, bist Du Dir sicher, dass es keine gute Idee waere ihn anzugreifen. "
    "Von ihm scheint eine ungeheure magische Kraft auszugehen. Seine Ohren "
    "stehen weit ab und auch ansonsten sieht dieser bibbernde kleine Kerl "
    "ziemlich witzig aus.");
  SetProp(P_NAME, "Garbak");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-30,T_RANGE_MAX:30]));
  AddId(({"garbak", "eiskobold", "kobold","EISHOEHLENGARBAK","NOWIMPY"}));
  set_living_name("garbak");

  create_default_npc(30);
  SetProp(P_HANDS, 
    ({" mit seinen Klauen",QueryProp(P_HANDS)[1],
    ({DT_RIP,DT_TERROR})}));
  SetProp(P_XP, QueryProp(P_XP)+10000*100); // Bonus fuer Spells
  SetProp(P_RACE, "Kobold");
  SetProp(P_SIZE, 35);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,20);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:     -1.0, DT_WATER: -1.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,30);

  SetProp(P_MSGIN, "faellt bibbernd aus der Eissaeule");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "faellt bibbernd aus der Eissaeule");
  SetProp(P_MMSGOUT, "verwandelt sich in eine Eissaeule");

  SetProp(P_DIE_MSG,  " zerbricht in tausend Eissplitter.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MURDER_MSG, "Aus Eis bin ich entstanden und zu Eis werde ich wieder!");
  SetProp(P_KILL_NAME, "Garbak");
  SetProp(P_KILL_MSG, "Unterschaetze nie die Macht von Kaelte!");

  AddInfo(DEFAULT_INFO, FZSTDINFOS);
  AddInfo("orw", 
    "Orw ist mein Schoepfer. Er kommt mich oft besuchen.","sagt: ");
/*
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
*/

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Garbak will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddDefaultSpell(2,800, DS_SLOW, 
    "Garbak hypnotisiert Dich mit eisigem Blick.\n",
    "Garbak hypnotisiert @WEN mit eisigem Blick.\n" );
  AddDefaultSpell(1,800, DS_DEAF, 
    "Garbak stoesst einen schrillen Schrei aus, der Eis spalten koennte.\n",
    "Garbak stoesst einen schrillen Schrei aus, der Eis spalten koennte.\n" );
  AddDefaultSpell(2,800, DS_ANTIMAGIC, 
    "Garbak beraubt Dich durch einen Astralwirbel Deiner Magiekuenste.\n",
    "Garbak beraubt @WEN durch einen Astralwirbel @WESSEN Magiekuensten.\n" );
  AddSpell(1,700+random(300),
    "Garbak blaest Dir seinen kalten Atem ins Gesicht.\n",
    "Garbak blaest @WEM seinen kalten Atem ins Gesicht.\n",
    ({DT_COLD,DT_AIR}),([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 1,
    "Garbak beschwoert die elementaren Kraefte der Kaelte.\n"
    "Garbak reibt seine Klauen aneinander...\n",
    "Garbak beschwoert die elementaren Kraefte der Kaelte.\n"
    "Garbak reibt seine Klauen aneinander...\n",
    DT_MAGIC, "spell_hands");
  AddSpell(2, 1,
    "Garbak beschwoert die elementaren Kraefte der Kaelte.\n"
    "Garbak murmelt eine magische Formel...\n",
    "Garbak beschwoert die elementaren Kraefte der Kaelte.\n"
    "Garbak murmelt eine magische Formel...\n",
    DT_MAGIC, "spell_schutz");

  SetChats(3, ({
    "Garbak zieht eine Augenbraue hoch.\n",
    "Garbak schuettelt sich ein paar Eiszapfen aus den Haaren.\n"}) );
  SetAttackChats(10, ({
    "Garbak wird blau und bekommt einen eisigen Blick.\n"}) );

  SUID;
}

void spell_hands(object enemy, int damage, mixed dam_type)
{
  tell_room(environment(),
  BS("...und Garbaks Klauen blitzen eisig auf."));
  SetProp(P_HANDS,({" mit elementaren Eisklauen", 650, 
                  ({DT_COLD,DT_RIP,DT_TERROR})}) );
  SetProp(P_SPELLRATE, 0);
  call_out("end_hands",random(10)+6);
}

void end_hands()
{
  tell_room(environment(),
  BS("Garbaks Klauen werden wieder normal."));
  SetProp(P_HANDS, ({" mit seinen Klauen", 300, ({DT_RIP,DT_TERROR})}) );
  SetProp(P_SPELLRATE, 50);
}

void spell_schutz(object enemy, int damage, mixed dam_type)
{
  tell_room(environment(),
  BS("...und um Garbak bildet sich ein Kraftfeld aus Eis."));
  SetProp(P_BODY, QueryProp(P_BODY)+800);
  SetProp(P_SPELLRATE, 0);
  call_out("end_schutz",random(13)+6);
}

void end_schutz()
{
  tell_room(environment(),
  BS("Das Kraftfeld um Garbak loest sich wieder auf."));
  SetProp(P_BODY, QueryProp(P_BODY)-800);
  SetProp(P_SPELLRATE, 50);
}

init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}

void hallo()
{
  int i;
  string *racetext;
  if(MENV!=ENV(TP)) return;
  switch(TP->QueryProp(P_RACE)){
    case "Mensch":
      racetext = HALLO_MENSCH;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;
    case "Elf":
      racetext = HALLO_ELF;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;    
    case "Zwerg":
      racetext = HALLO_ZWERG;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;    
    case "Hobbit":
      racetext = HALLO_HOBBIT;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;    
    case "Fee":
      racetext = HALLO_FEE;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;    
    case "Dunkelelf":
      racetext = HALLO_DUNKELELF;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;    
    case "Troll":
      racetext = HALLO_TROLL;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;    
    case "Oger":
      racetext = HALLO_OGER;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;    
    default:
      racetext = HALLO_DEFAULT;
      command_me("sage "+racetext[random(sizeof(racetext))]);
      break;
  }	
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Garbak den Eistroll.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Garbak hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "umarmt dich schuetzend.",
        "umarmt "+TPN+" schuetzend.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "seufzt.",
        "seufzt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schaut Dich grimmig an.",
        "schaut "+TPN+" grimmig an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "guckt Dich mit boese funkelnden Augen an.",
        "guckt "+TPN+" mit boese funkelnden Augen an.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "kichert froehlich.", 
        "kichert froehlich.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "erroetet.",
        "erroetet.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich.",
        "knuddelt "+TPN+".");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TPN+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
