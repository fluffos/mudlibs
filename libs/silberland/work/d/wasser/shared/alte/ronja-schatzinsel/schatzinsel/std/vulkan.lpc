#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Rande eines erloschenen Vulkans" );
  SetProp(P_INT_LONG,
    "Am Rande eines erloschenen Vulkans."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_MOUNTAIN]) );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "exit_aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}

