inherit "/p/service/iwo/access/ac_client.lpc";

//              Gebiet        Verwalter
#define AREAS (["atoll":      ({"angel"}),\
                "aquarendi":  ({"hiri","gwenshara"})])

#define DEBUG(x) if (find_player("cirion")) tell_object(find_player("cirion"),x+"\n");

int access_rights(string euid, string file, int readflag, int def)
{
  int retval;
  string * files;

  retval = ::access_rights(euid, file, readflag, def);
  if (!retval && !readflag)
  {
    files = explode(file,"/");

    if(-1 != member(AREAS[files[0]], euid))
    {
      retval = 1;
    }
    else if (files[2] == euid)
    {
        retval = 1;
    }
  }
  return retval;
}
