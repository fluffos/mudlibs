  SetProp (P_INT_SHORT, "Auf der Weststrasse Earosts");
  SetProp (P_INT_LONG, "]");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("nordwesten", "./rmlj");
  AddExit ("suedosten", "./rmjl");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
