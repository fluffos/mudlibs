#include "../earost.h"
#include WHOME"/gems/gems.h"

inherit WROOM"/wroom";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23]));
  SetProp (P_INT_SHORT, "Fanaris Schmiede");
  SetProp (P_INT_LONG, "");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddWaterExit ("norden", ROOM"/rmon");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
