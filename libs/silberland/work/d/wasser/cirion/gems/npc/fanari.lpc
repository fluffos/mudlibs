//Fanari, die Schmiedin von Earost

#include "../gems.h"
#include "/d/wasser/cirion/npcm/npcm.h"

inherit STDNPC;

nosave private int circle=0;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fanari, die Juwelenschmiedin");
  SetProp(P_LONG,
    "Fanari ist eine schlanke, hochgewachsene Frau, die ungewoehnlich "
    "kraeftig fuer eine <Race> ist. Sie hat dunkelblaue Haare und ebensolche "
    "Augen, die zwar freundlich, aber doch entschlossen blicken.\n"
    "Fanari traegt eine eher praktische Arbeitrobe und hat einen "
    "schweren Schmiedehammer in der Hand.");
  SetProp(P_NAME, "Fanari");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"fanari", "schmiedin"}));
  set_living_name("fanari");

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  //SetProp(P_XP, QueryProp(P_XP)+y*100);
  SetProp(P_RACE, EAROST_RACE);
  SetProp(P_SIZE, 198);
  SetProp(P_ALIGN, 350);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_COLD:      -0.2, DT_WATER:  -0.8, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: -0.2, DT_SOUND:  0.0, DT_LIGHT:  -0.2,
      DT_ELECTRIC:  0.2, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      -0.3, DT_UNHOLY:    0.2, DT_MAGIC:  -0.2 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " sinkt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO,({ 
    "sagt: Tut mir leid, darueber weiss ich nichts.\n",
    "sagt: Schau vielleicht mal in der Bibliothek danach.",
    "zuckt unwissend mit den Schultern.",
    "zieht eine Augenbraue hoch.",
    "weiss scheinbar keine Antwort."}));
  AddInfo("cirion", "Cirion ist mein Schoepfer.","sagt: ");

  AddInfo( ({"fanari","name"}),
    "Meine Name ist Fanari. Das bedeutet soviel wie ...",
    "sagt: ");
  AddInfo(({"menge"}),
    "Du meinst sicher die Menge Edelsteine, die ich zum Fertigen einer "
    "Edelsteinruestung benoetige. Nun, dass ist sehr unterschiedlich, es "
    "haengt vom gewuenschten Rustungstyp und von der Qualitaet der Ruestung "
    "ab.",
    "sagt: ");
  AddInfo(({"ruestungstyp","typ"}),
    "Ich kann aus Edelsteinen sechs unterschiedliche Ruestungstypen machen: "
    "Panzer, Helme, Schilde, Handschuhe, Armschienen und Beinschienen.",
    "");
  AddInfo(({"qualitaet","qualitaetsstufe","stufe"}),
    "Ich kann Ruestungen in unterschiedlichen Qualitaetsstufen fertigen. "
    "Je hoeher die Qualitaet ist, desto besser schuetzt die Ruestung, "
    "allerdings hat hoehere Qualitaet auch ihren Preis, bin ich doch viel "
    "laenger damit beschaeftigt.",
    "erklaert: ");
  AddInfo(({""}),
    "",
    "");
  AddInfo(({""}),
    "",
    "");

  AddCmd(({"frag"}),"frag_fun");

  SetProp(P_LOG_INFO, "cirion/earost/fanari");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Fanari moechte Deine Sachen nicht tragen.\n" }) );

/*
  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));
*/
  SetChats(3, ({
    "Fanari schaut Dich erwartungsvoll an.\n",
    "Fanari schaut Dich fragend an.\n",
    "Fanari bearbeitet hingebungsvoll einen Diamantpanzer.\n",
    "Fanari bearbeitet hingebungsvoll einen Saphirhandschuh.\n",
    "Fanari bearbeitet hingebungsvoll einen Rubinschild.\n",
    "Fanari bearbeitet hingebungsvoll eine Smaragdbeinschiene.\n",
    "Fanari bearbeitet hingebungsvoll eine Opalarmschiene.\n",
    "Fanari bearbeitet hingebungsvoll einen Topashelm.\n",
    "Fanari bearbeitet hingebungsvoll einen Bergkristallpanzer.\n",
    "Fanari bearbeitet hingebungsvoll einen Granatschild.\n",
    "Fanari wirft einige Edelsteine in ihre Esse.\n",
    "Fanari giesst eine gluehende Fluessigkeit in eine Form.\n",
    "Fanari betrachtet eingehend eine Ruestung.\n"}) );
  /*
  SetAttackChats(10, ({
    ".\n"}) );
  */
  SUID;
  CLONEME(GEM_WEAPON"/schmiedehammer" );
  command("zuecke hammer");
  CLONEME(GEM_ARMOUR"/arbeitsrobe" );
  command("trage alles");
}

init()
{
  ::init();
  if (circle || (LADEN->sizeof_unfinished()>1))
    SetNextAction(random(20)+20,({"ContinueArmour"}));
  else
    SetNextAction(random(20)+20,({"NormalAction",0}));  
}

reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  if ((!circle)&&(!sizeof(filter_array(all_inventory(MENV),#'query_once_interactive))))
    DeActivate();
}

int frag_fun(string str)
{
  string what,arm,prot;	

  arm="";
  if (!str)
    return 0;
  if (sscanf(str,"fanari nach %s",str)!=1)
    return 0;
  if (-1==member(m_indices(GEMSTAT)+
                ({"perle","rubine","diamanten","smaragde",
                  "amethysten","zirkone","granate","topase",
                  "bergkristalle","turmaline","aquamarine","lapislazulis",
                  "opale","bernsteine","saphire","onyxe","edelsteine"}),str))
  {                  
  if (sscanf(str,"%spanzer",what))
    arm="panzer";
  else if (sscanf(str,"%shelm",what))
    arm="helm";
  else if (sscanf(str,"%sbeinschiene",what))
    arm="beinschienen";
  else if (sscanf(str,"%sbeinschienen",what))
    arm="beinschienen";
  else if (sscanf(str,"%sarmschiene",what))
    arm="armschienen";
  else if (sscanf(str,"%sarmschienen",what))
    arm="armschienen";
  else if (sscanf(str,"%shandschuh",what))
    arm="handschuhe";
  else if (sscanf(str,"%shandschuhe",what))
    arm="handschuhe";
  else if (sscanf(str,"%sschild",what))
    arm="schilde";
  if (""==arm)
    return 0;
  }
  else what=str;
  what=LOWER(what);
  switch (what)
  {
    case "diamant":
    case "diamanten":
      prot="Explosionen";
      break;
    case "rubin":
    case "rubine":
      prot="Feuer";
      break;
    case "saphir":
    case "saphire":
      prot="Kaelte";
      break;
    case "aquamarin":
    case "aquamarine":
      prot="Wasser";
      break;
    case "topas":
    case "topase":
      prot="Luft";
      break;
    case "bernstein":
    case "bernsteine":
      prot="Licht";
      break;
    case "granat":
    case "granate":
      prot="Gewitter";
      break;
    case "smaragd":
    case "smaragde":
      prot="Gift";
      break;
    case "opal":
    case "opale":
      prot="Magie";
      break;
    case "lapislazuli":
    case "lapislazulis":
      prot="Saeure";
      break;
    case "onyx":
    case "onyxe":
      prot="Angst und Schrecken";
      break;
    case "perle":
    case "perlen":
      prot="Laerm";
      break;
    case "bergkristall":
    case "bergkristalle":
      prot="das Boese";
      break;
    case "turmalin":
    case "turmaline":
      prot="das Gute";
      break;
    case "amethyst":
    case "amethyste":
      prot="";
      break;
    case "zirkon":
    case "zirkone":
      prot="Elektrizitaet";
      break;
    case "edelstein":
    case "edelsteine":
    default:
      prot="";
      break;
  }  
  tell_room(MENV,BS(TP->Name()+" fragt Fanari nach "+CAP(str)+"."),({TP}));
  tell_object(TP,BS("Du fragst Fanari nach "+CAP(str)+"."));
  if (prot!="")
  {
    if (prot=="Laerm")
      command_me("sag Perlen schuetzen besonders gut gegen Laerm.");
    else
      command_me("sag Der "+CAP(what)+" schuetzt besonders gut gegen "+prot+".");
  }
  if (""!=arm)
  command_me("sag "+CAP(arm)+" kann ich aus jedem beliebigen Edelstein "
    "fertigen. Ich brauche dazu nur eine bestimmte Menge dieses Edelsteins, "
    "und es kostet Dich auch eine Kleinigkeit.");
  return 1;
}

void die(int poisondeath) {
  write_log(GEM_LOG"/fanari.kills",
    dtime(time())+": "+CAP(getuid(PL))+" killt Fanari.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_log(GEM_LOG"/fanari.deads",
      dtime(time())+": Der Fanari hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

int _query_wimpy() { return 0; }

ContinueAmour()
{
  call_out("MakeArmour",4,circle);
}

MakeArmour(int circle_it)
{
  int wait;
  mapping unfinished_map;
  string gemtype; //Dummy fuer define, is ned schoen aber zu spaet
	
  gemtype="edelstein";
  circle=circle_it;
  if (!LADEN->sizeof_unfinished())
  {
    SetNextAction(20+random(20),({"NormalAction",0}));
    return;
  }
  unfinished_map=LADEN->get_next_unfinished();
  switch (circle)
  {
    case 0:
      if (file_name(MENV)==SCHMIEDE)
      {
        command("schwimme nach norden");
      }
      if (file_name(MENV)!=LADEN)
      {
        return;
      }
      tell_room(MENV,BS(
        "Fanari sieht sich um als wuerde sie etwas erwarten, scheint es "
        "aber nicht zu finden."));
      command("zuck");
      tell_room(MENV,BS(
        "Sie geht zum Schrank an der Suedwand des Raumes und oeffnet die "
        "Schublade mit der Aufschrift: "+CAP(unfinished_map["owner"])+". "
        "Sie nimmt einen grossen Beutel heraus und schliesst die Schublade wieder "
        "sorgfaeltig."));
      circle++;
      wait=6;
      break;
    case 1:
      if (file_name(MENV)==LADEN)
        command("schwimme nach sueden");
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari oeffnet den Schmelzofen und zieht den Tiegel heraus."));
      circle++;
      wait=6;
      break;
    case 2:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari oeffnet ihren Beutel, und schuettet eine Menge "
        +CAP(GEMSTAT[unfinished_map["gemtype"]]["plural"])+
        " in den Tiegel. Sie schiebt ihn wieder in den Ofen und "
        "schliesst denselben."));
      circle++;
      wait=4;
      break;
    case 3:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari stellt den Ofen auf maximale Hitze und nickt dann zufrieden."));
      circle++;
      wait=10;
      break;
    case 4:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      switch (random(5))
      {
        case 0:
            command("sag Nun denn.");  
          break;
        case 1:
            command("sag Also, dann mal los.");  
          break;
        case 2:
            command("sag So, jetzt gehts los.");  
          break;
        case 3:
            command("sag Und nun...");  
          break;
        case 4:
            command("sag Hm, dann mal los.");  
          break;
      }
      circle++;
      wait=4;
      break;
    case 5:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari nimmt aus einem der Regale eine schwere, metallene Form "
        "fuer "+CAP(ARMSTAT[unfinished_map["at"]]["name"])+" und legt sie auf die "
        "grosse Arbeitsbank."));
      circle++;
      wait=6;
      break;
    case 6:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari nimmt ihre Werkzeuge und beginnt die Gussform anzupassen."));
      SetChats(3,({
        "Fanari ruht sich ein wenig aus.\n"
       ,"Fanari schaut zu Dir auf.\n"
       ,"Fanari arbeitet an einer Gussform.\n"
       ,"Fanari werkt ziemlich angestrengt an einer Gussform.\n"
       ,"Fanari holt sich ein seltsames Werkzeug aus einem der Regale.\n"
       ,"Fanari blickt zufrieden auf die Gussform.\n"}));
      Activate();
      SetNextAction(2400/LADEN->sizeof_unfinished()+random(100),
        ({"ContinueArmour"}));
      circle++;
      return;
      break;
    case 7:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      SetChats(0,({}));
      tell_room(MENV,BS(
        "Fanari hat die Arbeiten an der Gussform scheinbar abgeschlossen und "
        "legt sie vor den Ofen auf ein Gestell."));
      circle++;
      wait=6;
      break;
    case 8:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Vorsichtig oeffnet sie dann die Ofentuer. Ein Welle der Hitze kommt "
        "Euch entgegen. Im Ofen herrscht wirklich hoechste Glut."));
      circle++;
      wait=8;
      break;
    case 9:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari wartet kurz, dann zieht sie den Tiegel aus dem Ofen heraus. "
        "Im Tiegel ist eine fast durchscheinende aber gluehende Fluessigkeit, "
        "die in allen Regenbogenfarben schillert."));
      circle++;
      wait=8;
      break;
    case 10:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Mittels eines kleinen Rads an der Seite des Tiegels kippt Fanari ihn "
        "vorsichtig nach vorne, so dass die gluehende Fluessigkeit langsam "
        "in die darunter stehende Gussform laeuft. Dabei schillert und glitzert "
        "sie wie verrueckt."));
      circle++;
      wait=8;
      break;
    case 11:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Schliesslich ist die gesamte Fluessigkeit in die Form geflossen. "
        "Die Hitze im Ofen hat sich veraendessen scheinbar schon deutlich "
        "verringert. Vorsichtig schiebt Fanari den Tiegel zurueck in den "
        "Ofen."));
      circle++;
      wait=6;
      break;
    case 12:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      command("sag So, das muss erst einmal gruendlich auskuehlen.");
      circle++;
      wait=6;
      break;
    case 13:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      command("schwimme nach norden");
      SetNextAction(900/LADEN->sizeof_unfinished()+random(50),
        ({"ContinueArmour"}));
      circle++;
      return;
      break;
    case 14:
      if (file_name(MENV)==LADEN)
        command("schwimme nach sueden");
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari begutachtet die Gussform, die vor dem Ofen steht. Der Inhalt "
        "der Form ist bereits ausgekuehlt."));
      circle++;
      wait=6;
      break;
    case 15:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Vorsichtig nimmt Fanari die Gussform auseinander und ihren Inhalt "
        "heraus. Es ist ein "+ARMSTAT[unfinished_map["at"]]["name_presay"]+
        CAP(unfinished_map["gemtype"])+ARMSTAT[unfinished_map["at"]]["name"]+"."));
      circle++;
      wait=6;
      break;
    case 16:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      command("sag So, fast fertig.");
      circle++;
      wait=6;
      break;
    case 17:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari legt die Ruestung vorsichtig auf ihre Esse. Die Esse faengt "
        "daraufhin an hell zu brennen, und schnell erwaermt die die Ruestung "
        "wieder."));
      circle++;
      wait=12;
      break;
    case 18:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Nach kurzer Zeit glueht sie wieder, allerdings wird sie jetzt nicht "
        "mehr fluessig. Mit einer schweren Zange hebt Fanari die Ruestung "
        "auf ihren Amboss."));
      circle++;
      wait=8;
      break;
    case 19:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Dann beginnt sie, sie mit ihrem Hammer zu bearbeiten und ihr den "
        "letzten Schliff zu geben."));
      circle++;
      wait=12;
      break;
    case 20:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari entfernt die letzten Unebenheiten von der Ruestung."));
      circle++;
      wait=10;
      break;
    case 21:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari holt sich einige Werkzeuge aus dem Regal und beginnt, die "
        "Ruestung zu verzieren. Schnell entsteht ein herrliches Muster."));
      circle++;
      wait=10;
      break;
    case 22:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Dann wird die Ruestung wieder zu kalt, und Fanari muss sie erneut "
        "in die Esse legen."));
      circle++;
      wait=12;
      break;
    case 23:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Schliesslich nimmt sie sie wieder heraus und arbeitet weiter."));
      circle++;
      wait=8;
      break;
    case 24:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari ist mit den Verzierungen fertig, nun fehlt nur noch "
        "das Zeichen von "+CAP(unfinished_map["owner"])+"."));
      circle++;
      wait=8;
      break;
    case 25:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Fanari legt letzte Hand an die Ruestung."));
      circle++;
      wait=8;
      break;
    case 26:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      tell_room(MENV,BS(
        "Schliesslich ist Fanari fertig. Zufrieden steht sie auf, haelt die "
        "Ruestung ins Licht und betrachtet ihr Werk."));
      circle++;
      wait=6;
      break;
    case 27:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      command("sag So, das ist fertig. Mal sehen, ob ich noch mehr Arbeit "
      "habe.");
      circle++;
      wait=6;
      break;
    case 28:
      if (file_name(MENV)!=SCHMIEDE)
        return;
      command("schwimme nach norden");
      circle++;
      wait=6;
      break;
    case 29:
      if (file_name(MENV)!=LADEN)
        return;
      tell_room(MENV,BS(
        "Fanari befestigt die fertige Ruestung an einem eigens dafuer "
        "gefertigten Staender. Dann schaut sie sich nach weiterer Arbeit "
        "um."));
      LADEN->ArmourDone();
      circle=0;
      SetNextAction(20+random(20),
        ({"NormalAction",0}));
      return;
      break;
  }
  call_out("MakeArmour",wait,circle);
/*
  SetChats(7,({
    "Fanari "
   ,""
   ,""
   ,""
   ,""
   ,""}))
*/
}

NormalAction(int cyc)
{
  switch (cyc)
  {
    case 0..4:
      if (file_name(MENV)==LADEN)
        command("schwimme nach sueden");
      else if (MENV==SCHMIEDE)
        command("schwimme nach norden");
      SetNextAction(20+random(20),
        ({"NormalAction",random(6)}));      	
      break;
    case 5:  
        SetNextAction(20+random(20),
          ({"ContinueArmour"}));      	
      break;  
  }
}

