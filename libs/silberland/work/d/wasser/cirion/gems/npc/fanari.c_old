//Fanari, die Schmiedin von Earost

#include "../gems.h"

inherit "/players/cirion/npc/npc";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fanari, die Juwelenchmiedin");
  SetProp(P_LONG,
    "Fanari ist eine schlanke, hochgewachsene Frau, die ungewoehnlich "
    "kraeftig fuer eine <Race> ist. Sie hat dunkelblaue Haare und ebensolche "
    "Augen, die zwar freundlich, aber doch entschlossen blicken.\n"
    "Fanari traegt eine eher praktische Arbeitrobe und hat einen "
    "schweren Schmiedehammer in der Hand.");
  SetProp(P_NAME, "Fanari");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"fanari", "schmiedin"}));
  set_living_name("fanari");

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  //SetProp(P_XP, QueryProp(P_XP)+y*100);
  SetProp(P_RACE, "<Race>");
  SetProp(P_SIZE, 198);
  SetProp(P_ALIGN, 350);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_COLD:      -0.2, DT_WATER:  -0.8, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: -0.2, DT_SOUND:  0.0, DT_LIGHT:  -0.2,
      DT_ELECTRIC:  0.2, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      -0.3, DT_UNHOLY:    0.2, DT_MAGIC:  -0.2 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " sinkt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO,({ 
    "sagt: Tut mir leid, darueber weiss ich nichts.\n",
    "sagt: Schau vielleicht mal in der Bibliothek danach.",
    "zuckt unwissend mit den Schultern.",
    "zieht eine Augenbraue hoch.",
    "weiss scheinbar keine Antwort."}));
  AddInfo("cirion", "Cirion ist mein Schoepfer.","sagt: ");

  AddInfo( ({"fanari","name"}),
    "Meine Name ist Fanari. Das bedeutet soviel wie ...",
    "sagt: ");
  AddInfo(({"menge"}),
    "Du meinst sicher die Menge Edelsteine, die ich zum Fertigen einer "
    "Edelsteinruestung benoetige. Nun, dass ist sehr unterschiedlich, es "
    "haengt vom gewuenschten Rustungstyp und von der Qualitaet der Ruestung "
    "ab.",
    "sagt: ");
  AddInfo(({"ruestungstyp","typ"}),
    "Ich kann aus Edelsteinen sechs unterschiedliche Ruestungstypen machen: "
    "Panzer, Helme, Schilde, Handschuhe, Armschienen und Beinschienen.",
    "");
  AddInfo(({"qualitaet","qualitaetsstufe","stufe"}),
    "Ich kann Ruestungen in unterschiedlichen Qualitaetsstufen fertigen. "
    "Je hoeher die Qualitaet ist, desto besser schuetzt die Ruestung, "
    "allerdings hat hoehere Qualitaet auch ihren Preis, bin ich doch viel "
    "laenger damit beschaeftigt.",
    "erklaert: ");
  AddInfo(({""}),
    "",
    "");
  AddInfo(({""}),
    "",
    "");

  AddCmd(({"frag"}),"frag_fun");

  SetProp(P_LOG_INFO, "cirion/earost/fanari");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Fanari moechte Deine Sachen nicht tragen.\n" }) );

/*
  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));
*/
  SetChats(3, ({
    "Fanari schaut Dich erwartungsvoll an.\n",
    "Fanari schaut Dich fragend an.\n",
    "Fanari bearbeitet hingebungsvoll einen Diamantpanzer.\n",
    "Fanari bearbeitet hingebungsvoll einen Saphirhandschuh.\n",
    "Fanari bearbeitet hingebungsvoll einen Rubinschild.\n",
    "Fanari bearbeitet hingebungsvoll eine Smaragdbeinschiene.\n",
    "Fanari bearbeitet hingebungsvoll eine Opalarmschiene.\n",
    "Fanari bearbeitet hingebungsvoll einen Topashelm.\n",
    "Fanari bearbeitet hingebungsvoll einen Bergkristallpanzer.\n",
    "Fanari bearbeitet hingebungsvoll einen Granatschild.\n",
    "Fanari wirft einige Edelsteine in ihre Esse.\n",
    "Fanari giesst eine gluehende Fluessigkeit in eine Form.\n",
    "Fanari betrachtet eingehend eine Ruestung.\n",}) );
  /*
  SetAttackChats(10, ({
    ".\n"}) );
  */
  SUID;
  CLONEME(WEAPON"/schmiedehammer" );
  command("zuecke hammer");
  CLONEME(ARMOUR"/arbeitsrobe" );
  command("trage alles");
}

int frag_fun(string str)
{
  string what,arm,prot;	

  arm="";
  if (!str)
    return 0;
  if (sscanf(str,"fanari nach %s",str)!=1)
    return 0;
  if (-1==member(m_indices(GEMSTAT)+
                ({"perle","rubine","diamanten","smaragde",
                  "amethysten","zirkone","granate","topase",
                  "bergkristalle","turmaline","aquamarine","lapislazulis",
                  "opale","bernsteine","saphire","onyxe","edelsteine"}),str))
  {                  
  if (sscanf(str,"%spanzer",what))
    arm="panzer";
  else if (sscanf(str,"%shelm",what))
    arm="helm";
  else if (sscanf(str,"%sbeinschiene",what))
    arm="beinschienen";
  else if (sscanf(str,"%sbeinschienen",what))
    arm="beinschienen";
  else if (sscanf(str,"%sarmschiene",what))
    arm="armschienen";
  else if (sscanf(str,"%sarmschienen",what))
    arm="armschienen";
  else if (sscanf(str,"%shandschuh",what))
    arm="handschuhe";
  else if (sscanf(str,"%shandschuhe",what))
    arm="handschuhe";
  else if (sscanf(str,"%sschild",what))
    arm="schilde";
  if (""==arm)
    return 0;
  }
  else what=str;
  what=LOWER(what);
  switch (what)
  {
    case "diamant":
    case "diamanten":
      prot="Explosionen";
      break;
    case "rubin":
    case "rubine":
      prot="Feuer";
      break;
    case "saphir":
    case "saphire":
      prot="Kaelte";
      break;
    case "aquamarin":
    case "aquamarine":
      prot="Wasser";
      break;
    case "topas":
    case "topase":
      prot="Luft";
      break;
    case "bernstein":
    case "bernsteine":
      prot="Licht";
      break;
    case "granat":
    case "granate":
      prot="Gewitter";
      break;
    case "smaragd":
    case "smaragde":
      prot="Gift";
      break;
    case "opal":
    case "opale":
      prot="Magie";
      break;
    case "lapislazuli":
    case "lapislazulis":
      prot="Saeure";
      break;
    case "onyx":
    case "onyxe":
      prot="Angst und Schrecken";
      break;
    case "perle":
    case "perlen":
      prot="Laerm";
      break;
    case "bergkristall":
    case "bergkristalle":
      prot="das Boese";
      break;
    case "turmalin":
    case "turmaline":
      prot="das Gute";
      break;
    case "amethyst":
    case "amethyste":
      prot="";
      break;
    case "zirkon":
    case "zirkone":
      prot="Elektrizitaet";
      break;
    case "edelstein":
    case "edelsteine":
    default:
      prot="";
      break;
  }  
  tell_room(MENV,BS(TP->Name()+" fragt Fanari nach "+CAP(str)+"."),({TP}));
  tell_object(TP,BS("Du fragst Fanari nach "+CAP(str)+"."));
  if (prot!="")
  {
    if (prot=="Laerm")
      command_me("sag Perlen schuetzen besonders gut gegen Laerm.");
    else
      command_me("sag Der "+CAP(what)+" schuetzt besonders gut gegen "+prot+".");
  }
  if (""!=arm)
  command_me("sag "+CAP(arm)+" kann ich aus jedem beliebigen Edelstein "
    "fertigen. Ich brauche dazu nur eine bestimmte Menge dieses Edelsteins, "
    "und es kostet Dich auch eine Kleinigkeit.");
  return 1;
}
