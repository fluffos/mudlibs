#include "../gems.h"

inherit "std/weapon";

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein seltsamer Schmiedehammer");
  SetProp(P_LONG,
    "Das ist ein ziemlich seltsamer Schmiedehammer, denn sowohl ein Stiel "
    "als auch sein Kopf sind aus einem Dir unbekannten, schwarzen Mineral "
    "geformt. Zudem hat der Hammer auch eine seltsame Form, der Griff ist "
    "leicht geschwungen, und der Kopf merkwuerdig abgerundet. Allerdings "
    "liegt der Hammer hervorragend in der Hand und ist sicherlich eine "
    "formidable Waffe." );
  SetProp(P_INFO, "Der Hammer ist sicherlich magisch, er wird zum Formen "
    "kristalliner Stoffe gebraucht.");
  SetProp(P_NAME, "Fanaris Schmiedehammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"hammer", "schmiedehammer"}) );

  SetProp(P_ARTICLE,0);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 150);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_MISC_MINERAL );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 6500);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_WC_FIX, 80 );
  
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["fanari":200 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:12,A_STR:10,A_INT:12]) );
}

loose_control()
{
  object wielder;
	
  wielder=QueryProp(P_WIELDED);
  if (!wielder) return;
  tell_room(ENV(wielder),BS(
    "Der Schmiedehammer entgleitet endgueltig "+wielder->Name(WESSEN)+
    " Haenden und faellt zu Boden."),({wielder}));
  tell_object(wielder,BS(
    "Der Schmiedehammer entgleitet endgueltig Deinen Haenden und faellt "
    "zu Boden."));
  DoUnwield(1);
  move(ENV(TP),M_NOCHECK|M_SILENT);
}

int HitFunc( object enemy ) {
  object wielder;
  string wucht;
  int dam;
  
  wielder=QueryProp(P_WIELDED);	
  if (!random(40)||(!random(20)&&(wielder->Name()=="Fanari")))
  {
    switch (random(10))
    {
      case 0..3:wucht="grosser";
            dam=2+random(2);
        break;
      case 4..6:wucht="extremer";
            dam=4+random(4);
        break;
      case 7..8:wucht="gewaltiger";
            dam=6+random(6);
        break;
      case 9:wucht="vernichtender";
            dam=10+random(10);
        break;
    }
    tell_object(wielder,BS(
      "Der Schmiedehammer scheint dunkel aufzuleuchten, um dann mit "
      +wucht+" Wucht auf Deinen Gegner niederzufahren."));
    tell_room(ENV(wielder),BS(
      "Der Schmiedehammer in "+wielder->Name(WESSEN)+" Haenden scheint "
      "dunkel aufzuleuchten, um dann mit "+wucht+" Wucht auf "+
      enemy->Name(WEN)+" niederzufahren."),({wielder,enemy}));
    tell_object(enemy,BS(
      "Der Schmiedehammer in "+wielder->Name(WESSEN)+" Haenden scheint "
      "dunkel aufzuleuchten, um dann mit "+wucht+" Wucht auf Dich "
      "niederzufahren."));
    return dam;
  }
  else if (((90-wielder->QueryAttribute(A_DEX)) >random(2000) )
         &&(wielder->Name()!="Fanari"))
  {
    switch (random(10))
    {
      case 0..3:
        tell_object(wielder,BS(
          "Der Schmiedehammer entgleitet beinahe Deinen Haenden."));
        tell_room(ENV(wielder),BS(
          "Der Schmiedehammer scheint beinahe "+wielder->Name(WESSEN)+
          "Haenden zu entgleiten."),({wielder}));
        dam=-4-random(4);
        break;
      case 4..6:
        tell_object(wielder,BS(
          "Der Schmiedehammer entgleitet nahezu Deinen Haenden."));
        tell_room(ENV(wielder),BS(
          "Der Schmiedehammer scheint nahezu "+wielder->Name(WESSEN)+
          "Haenden zu entgleiten."),({wielder}));
        dam=-8-random(8);
        break;
      case 7..8:
        tell_object(wielder,BS(
          "Nur mit aeusserster Muehe kannst Du den Schmiedehammer halten."));
        tell_room(ENV(wielder),BS(
          "Nur mit aeusserster Muehe scheint "+wielder->Name(WESSEN)+
          "den Schmiedehammer halten zu koennen."),({wielder}));
        dam=-16-random(16);
        break;
      case 9:
        tell_object(wielder,BS(
          "Du verlierst die Kontrolle ueber den Schmiedehammer."));
        tell_room(ENV(wielder),BS(
          wielder->Name()+" scheint die Kontrolle ueber den Schmiedehammer "
          "zu verlieren."),({wielder}));
        call_out("loose_control",2);
        dam=-32-random(32);
        break;
    }
    return dam;
  }
  return 0;
}
