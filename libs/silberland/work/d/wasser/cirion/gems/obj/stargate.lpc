#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../gems.h"

inherit "/std/thing";
inherit "/players/cirion/service/fun"; 

string uid,gemtype,othergate;

create()
{
  if (!is_clone(this_object()) ) 
    return;
  ::create();
        
  SetProp(P_INFO,"Das Tor scheint wohl magisch zu sein. Vielleicht "
    "kann man es betreten?");
  AddDetail(({"rand","band","runenband","runen"}),
    "Die schmalen, glitzernden Runen sehen fast wie kleine Sterne aus.");
  AddReadDetail(({"rune","runen","runenband","band"}),
    "Leider kannst Du die Runen nicht entziffern.");
  SetProp(P_NOGET,"Das Portal laesst sich nicht aufheben.\n");
  SetProp(P_NAME,"Sternentor");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_MATERIAL,MAT_MAGIC);

  AddCmd("betrete","cmdEnter");
  AddId("gate");
}

SetGate(string suid,string sgemtype,string gate)
{
  uid=suid;
  gemtype=sgemtype;
  othergate=gate;
  SetProp(P_SHORT,"Ein "+GEMCOLORS[gemtype]+" schimmerndes Sternentor");
  SetProp(P_LONG,
    "Du siehst ein "+GEMCOLORS[gemtype]+" schimmerndes, durchscheinendes "
    "Portal von annaehernd 5 Metern Hoehe. Sein Rand wird von einem "
    "schmalen Runenband gebildet, welches sich in einem hohen Bogen "
    "ueber Dich woelbt und schwach zu leuchten scheint. ");
  AddId(({"tor","portal","sternentor","sternenportal","sterntor"
         ,"sternportal",gemtype+"tor",gemtype+"portal",GATEID+uid}));
}

string short()
{
  if (this_player() && getuid(this_player())==uid)
    return ::short();
}

string long()
{
  if (this_player() && getuid(this_player())==uid)
    return ::long(); 
}

int cmdEnter(string str)
{
  int cost;

  if (this_player() && getuid(this_player())!=uid)
    return 0;

  notify_fail("Was moechtest Du betreten?\n");
  if (!id(str))
    return 0;

  tell_room(environment(this_player()),break_string(
    this_player()->Name()+" macht einen halben Schritt und verschwindet "
    "dann lautlos in einem kurzen "+GEMCOLORS[gemtype]+"en Aufblitzen.")
    ,({this_player()}));  
  this_player()->move(othergate,M_GO|M_SILENT|M_NO_SHOW);
  tell_room(environment(this_player()),break_string(
    this_player()->Name()+" erscheint ploetzlich in einem lautlosen, "
    +GEMCOLORS[gemtype]+"en Aufblitzen. "
    +this_player()->QueryProp(P_GENDER)==2?"Sie":"Er"+" scheint ziemlich "
    "desorientiert zu sein."),({this_player()}));
  cost=GATEMASTER->Cost(this_player());
  if (!cost)
  {
    tell_object(this_player(),break_string(
      "Du schreitest durch das Sternentor. Ploetzlich tauchst Du in einen "
      "Farbenstrudel ein, die Umwelt verschwimmt. Ein starkes "
      "Schwindelgefuehl breitet sich in Dir aus, dann trittst Du wieder "
      "auf festen Boden."));
  }
  else
  {    
    tell_object(this_player(),break_string(
      "Du schreitest durch das Sternentor. Ploetzlich tauchst Du in einen "
      "Farbenstrudel ein, die Umwelt verschwimmt. Ein starkes "
      "Schwindelgefuehl breitet sich in Dir aus, dann trittst Du wieder "
      "auf festen Boden. Du spuerst, wie das Portal Dir Energie entzieht..."));
    ReduceSpHp(cost,this_player(),1);
  }
  if (!this_player())
    return 1;
  this_player()->SetProp(P_PARALYZED,
                   ([PARALYZE_TIME:FIXED_PARALYZE+random(RANDOM_PARALYZE)
		    ,PARALYZE_MSG:"Du bis voellig desorientiert und zu "
		                  "schwach, um Dich zu bewegen.\n"
		    ,PARALYZE_MSG_OTHER:"%s scheint voellig desorientiert"
		                        "zu sein.\n"
		    ,PARALYZE_END:"Endlich verschwindet Dein "
		                  "Schwindelgefuehl.\n"
	            ,PARALYZE_END_OTHER:"%s scheint es wieder besser "
		                        "zu gehen.\n"]));
  return 1;
}

remove()
{
  GATEMASTER->DelayRenewGate(uid,file_name(environment()));
  ::remove(); 
}

void Appear()
{
  object pl;
        
  if (pl=present(uid,environment()))
    tell_object(pl,break_string(
      "Ein schwacher, "+GEMCOLORS[gemtype]+"er Schimmer wird in der Luft "
      "sichtbar. Langsam formt sich daraus ein riesiges, sanft schimmerndes "
      "Tor."));
   return;
}
