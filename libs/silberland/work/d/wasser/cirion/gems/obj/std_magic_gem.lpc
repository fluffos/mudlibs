/*************************************************
**                                              **
** Ein magischer Edelstein                      **
**                                              **
** (c) 2000 by Cirion@Silberland,               **
** unter Verwendung der Standardedelsteine      **
**                                              **
** Dieser Edelstein kann verschiedene magische  **
** Formen der normalen Edelsteine annehmen.     **
** Diese haben dann verschiedene besondere      **
** Verwendungszwecke.                           **
**                                              **
*************************************************/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "/d/wasser/cirion/gems/gems.h"
#include "/p/daemon/itemd/itemd.h"

nosave string gemtype;
nosave int gemsize;
nosave int gemmagic;
  
create()
{
  if (!is_clone(this_object()) ) 
    return;

  ::create();

  SetProp(P_INFO,  
    "Diesem Edelstein scheinen besondere magische Kraefte innezuwohnen.");
  SetProp(P_GENDER, MALE);

  SetProp(P_NOBUY, 1);
  set_gemtype("edelstein",1,20);
}

int QueryGemSize()
{
  return gemsize;
}

string QueryGemType()
{
  return gemtype;
}

int QueryGemMagic()
{
  return gemmagic;
}

varargs void set_gemtype(string type,int magic,int size)
{
  string pl_end,pre,size_txt;

  SetProp(P_IDS,({}));
  SetProp(P_ADJECTIVES,({}));
  RemoveAdjective();
  if (!member(GEMSTAT,type))
    gemtype=(m_indices(GEMSTAT)-({"edelstein","perlen"}))
              [random(sizeof(m_indices(GEMSTAT)-({"edelstein","perlen"})))];
  else
    gemtype=type;
  if (!intp(magic) || magic<1 || magic>2)
    gemmagic=1+random(2);
  else
    gemmagic=magic;
  if (!intp(size) || size<20 || size>100)
    gemsize=20+(((random(80)+1)*(random(80)+1))/80);
  else 
    gemsize=size;
  SetProp(P_MATERIAL,([GEMSTAT[gemtype]["material"]:100,MAT_MAGIC:100]));
  SetProp(P_WEIGHT,(int)gemsize/2.0);
  SetProp(P_VALUE,250*gemsize);
 
  switch(gemsize)
  {
    case 0..20:
      size_txt="winzig klein";
    case 21..40:
      size_txt="sehr klein";
      break;
    case 41..60:
      size_txt="klein";
      break;
    case 61..80:
      size_txt="gross";
      break;
    case 81..100:
      size_txt="sehr gross";
      break;
   }

  switch(gemmagic)
  {
    case 1:
      pre="Stern";
      AddId(STARGEMID);
      SetProp(P_LONG,
        "Dies ist ein "+size_txt+"er, wunderschoener, glitzernder, perfekt "
        "geschliffener Stern"+gemtype+". Als Du genauer hinsiehst, "
        "erkennst Du, dass sich in seinem Inneren eine hauchzarte, "
        "schillernde Sternstruktur befindet.");
     break;
    case 2:
      pre="Feuer";
      AddId(FIREGEMID);
      SetProp(P_LONG,
        "Dies ist ein "+size_txt+"er, wunderschoener, perfekt geschliffener "
        "Feuer"+gemtype+". Selbst in Dunkelheit scheint in ihm ein "
        "durchdringendes Feuer zu brennen.");
      break;
  }

  SetProp(P_NAME_ADJ,size_txt);
  SetProp(P_NAME,pre+gemtype);
  SetProp(P_SHORT,"Ein "+size_txt+"er "+pre+gemtype);

  AddId(({"Ding",lower_case(pre)+gemtype,gemtype,MGEMID,"stein"
         ,"gem","edelstein",lower_case(pre)+"edelstein"}));
  AddAdjective(({size_txt,size_txt+"en"}));
}

int IsSocketItem() 
{ 
  return SOC_M_JEWEL; 
}

mixed _set_autoloadobj(mixed data)
{ 
  set_gemtype(data[0],data[1],data[2]);
  
  return data;
}

mixed _query_autoloadobj()
{
  return ({gemtype, gemmagic, gemsize});
}