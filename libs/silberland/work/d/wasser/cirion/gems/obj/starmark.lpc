#include <moving.h>
#include <properties.h>
#include "../gems.h"

inherit "/std/thing";

string uid,gemtype;
object pyramid;

create()
{
  if (!is_clone(this_object()) ) 
    return;
  ::create();
        
  SetProp(P_INFO,"Offensichtlich ist der Stern magischer Natur.");
  SetProp(P_NOGET,"Der Stern ist nicht materiell.\n");
  SetProp(P_NAME,"Stern");
  SetProp(P_GENDER,MALE);
  SetProp(P_MATERIAL,MAT_MAGIC);
}

SetMark(string suid,string sgemtype,object py)
{
  pyramid=py;
  uid=suid;
  gemtype=sgemtype;
  SetProp(P_SHORT,"Ein "+GEMCOLORS[gemtype]+" schimmernder Stern");
  SetProp(P_LONG,
    "Du siehst einen "+GEMCOLORS[gemtype]+" schimmernden, durchscheinenden "
    "Stern, welcher in ungefaehr 3 Metern Hoehe ueber dem Boden schwebt.");
  AddId(({"stern"}));
}

string short()
{
  if (this_player() && getuid(this_player())==uid)
    return ::short();
}

string long()
{
  if (this_player() && getuid(this_player())==uid)
    return ::long(); 
}

void Appear()
{
  object pl;
        
  if (pl=present(uid,environment()))
    tell_object(pl,break_string(
      "Ein schwacher, "+GEMCOLORS[gemtype]+"er Schimmer wird in der Luft "
      "sichtbar. Langsam formt sich daraus ein  sanft schimmernder Stern, "
      "welcher in 3 Metern Hoehe ueber dem Boden schwebt."));
   return;
}

void Disappear()
{
  object pl;
        
  if (pl=present(uid,environment()))
    tell_object(pl,break_string(
      "Der Stern in der Luft beginnt zu verblassen und verschwindet dann "
      "voellig."));
  call_out("remove",0);
  return;
}

remove()
{ 
  if (objectp(pyramid))
    pyramid->RemoveMark(this_object());
  ::remove();
}