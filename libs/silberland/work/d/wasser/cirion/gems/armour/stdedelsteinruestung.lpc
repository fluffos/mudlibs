inherit "std/armour";

#include "../gems.h"

nosave string gemtype="edelstein";
nosave int power=1;
nosave int charge=0;

nosave string owner="";
nosave int gender=NEUTER;

nosave int autoload_time = 30;

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_ARMOUR_TYPE,AT_MISC);
  SetProp(P_AC,0);
  SetProp(P_NOBUY,1);
  SetProp(P_QUALITY_DECAY,200);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_DEFEND_FUNC, TO );
  SetProp(P_WEAR_FUNC, TO );
  AddId(({"edelsteinruestung"}));
}   

deb()
{
  DBME(Name()+" - Charge: "+charge);
}

string long()
{
  string text;
  int acf;
  
  acf=QueryProp(P_AC);
  text=QueryProp(P_LONG);
  if (charge>acf*DECHARGE/7*6)
      text+=CAP(QueryArticle(0,1))+QueryProp(P_NAME)+" strahlt hell.\n";
  else if (charge>acf*DECHARGE/7*5)
      text+=CAP(QueryArticle(0,1))+QueryProp(P_NAME)+" strahlt schon fast.\n";
  else if (charge>acf*DECHARGE/7*4)
      text+=CAP(QueryArticle(0,1))+QueryProp(P_NAME)+" glitzert und glaenzt stark.\n";
  else if (charge>acf*DECHARGE/7*3)
      text+=CAP(QueryArticle(0,1))+QueryProp(P_NAME)+" schimmert und glitzert.\n";
  else if (charge>acf*DECHARGE/7*2)
      text+=CAP(QueryArticle(0,1))+QueryProp(P_NAME)+" schimmert.\n";
  else if (charge>acf*DECHARGE/7)
    text+=CAP(QueryArticle(0,1))+QueryProp(P_NAME)+" scheint ein wenig zu schimmern.\n";
  return text;
}

int WearFunc(object me)
{
  if (QueryProp(P_ARMOUR_TYPE)==AT_ARMOUR)
    if (TP->QueryProp(P_GENDER)!=gender)
    {
      write("Diese Ruestung ist fuer das andere Geschlecht gefertigt.\n");
      return 0;
    }
  return 1;
}

varargs int Error(string errmsg,object po,int flag)
{
  object bugger;

  if (!po)
    po=PO;  	
  bugger=find_player(getuid(po));
  errmsg="Error in "+file_name()+" (uid "+getuid()+") by "+
         CAP(getuid(po))+":\n"+errmsg+"\n";
  if (!(flag&NODB))
  {
    flag-=NODB;
    if (find_player(KEEPER))
      tell_object(find_player(KEEPER),errmsg);
  }
  if (!(flag&NOLOG))
  {
    flag-=NOLOG;
    write_file(GEM_ERRLOG,errmsg+"\n("+dtime(time())+")\n");
  }
  if (!(flag&NOBUGGER))
    if (bugger)
    {
      if (IS_WIZARD(bugger))
        tell_object(bugger,errmsg);
      else
        tell_object(bugger,BS(
          "Bug in "+Name(WEM)+". Bitte "+CAP(KEEPER)+" oder einen Erzmagier "
          "benachrichtigen."));
    }
  return 0;
}


varargs int DoWear(int silent, int all) {
  int ret;
  object ob;
  ret = ::DoWear (silent, all);
  if (objectp(ob=QueryProp(P_WORN))) {
    //handle it
  } 
  return ret;
}

varargs int DoUnwear(int silent) {
  int ret;
  object ob;
  ob=QueryProp(P_WORN);
  ret = ::DoUnwear (silent);
  if (!QueryProp(P_WORN)) {
    //handle it
  }
  return ret;
}                     
                           

int DefendFunc(string *dtype, mixed spell, object enemy) 
{
  int addcharge;
  object wielder;
  
  if (random(100)>95)
  {
    if ((charge+random(QueryProp(P_AC)*DECHARGE/10*4)>QueryProp(P_AC)*DECHARGE)
     ||(charge+QueryProp(P_AC)*DECHARGE/10>QueryProp(P_AC)*DECHARGE))
    {
      wielder=QueryProp(P_WORN);
      tell_room(ENV(wielder),BS(
        CAP(QueryArticle(0,1))+QueryProp(P_NAME)+" von "+wielder->Name()+" leuchtet "
        "ploetzlich hell auf, und ein gleissender Blitz magischer Energie "
        "entlaedt sich auf "+enemy->name(WEN))+".",({wielder,enemy}));
      tell_object(wielder,BS(
        (QueryProp(P_GENDER)==FEMALE?"Deine ":"Dein ")+QueryProp(P_NAME)+" leuchtet "
        "ploetzlich hell auf, und ein gleissender Blitz magischer Energie "
        "entlaedt sich auf "+enemy->name(WEN)+"."));
      tell_object(enemy,BS(
        CAP(QueryArticle(0,1))+QueryProp(P_NAME)+" von "+wielder->Name()+" leuchtet "
        "ploetzlich hell auf, und ein gleissender Blitz magischer Energie "
        "entlaedt sich auf Dich."));
      enemy->do_damage(charge/30+random(charge/30));
      charge=0;
    }
  }  
  if (-1!=member(dtype,GEMSTAT[gemtype]["dam_type"]))
  {
    addcharge=random(to_int(QueryProp(P_AC)*(GEMSTAT[gemtype]["defend_factor"]-1)*(power/4)*DEFEND_FACTOR));
    charge+=addcharge;
    return addcharge;
  }                               
  else return 0;
}

int SetPower(int pow)
{
  if ((-1>pow)||(pow>5))	
    return Error("Argument 1 (power) to SetPower out of range [0..5]",PO);
  power=pow;
  return 1;
}

int SetArmourtype(string type)
{
  if (!type)
    return Error("Missing argument 1 (armourtype) to SetArmourtype",PO);
  else if (-1==member(m_indices(ARMSTAT),type))
    return Error("Invalid argument 1 (armourtype) to SetArmourtype",PO);
  else if (type==AT_MISC)  
    return Error("Invalid armour class AT_MISC",PO);
  RemoveId("Misc");
  SetProp(P_ARMOUR_TYPE,type);
  SetProp(P_AC,VALID_ARMOUR_CLASS[type]*to_int((0.5+0.5*power/5)*AC_FACTOR));
  return 1;
}

int SetGemtype(string type) {
  if (!type)
    return Error("Missing argument 1 (gemtype) to SetGemtype",PO);
  if (-1==member(m_indices(GEMSTAT),type))
    return Error("Invalid argument 1 (gemtype) to SetGemtype",PO);
  gemtype=type;
  AddId(gemtype+"ruestung");
  SetProp(P_MATERIAL,GEMSTAT[gemtype]["material"]);
  SetProp(P_INFO,GEMSTAT[gemtype]["info"]);
  return 1;
}

Update()
{
  string at;
  
  at=QueryProp(P_ARMOUR_TYPE);
  SetProp(P_WEIGHT,ARMSTAT[at]["weight"]);
  SetProp(P_GENDER,ARMSTAT[at]["gender"]);
  SetProp(P_VALUE,QueryProp(P_AC)*100*(1+(power/5)));
  SetProp(P_NAME,ARMSTAT[at]["name_presay"]+CAP(gemtype)+ARMSTAT[at]["name"]);
  SetProp(P_SHORT,ARMSTAT[at]["short"]);
  SetProp(P_LONG,ARMSTAT[at]["long"]);
  SetProp(P_LONG,ARMSTAT[at]["long"]+
    "das Zeichen von "+((owner=="")?"Fanari, der Schmiedin":CAP(owner))+
    " dar.");
  SetProp(P_WEAR_TEXT,({"Du ziehst "+name(WEN,1)+" an.\n",
                       " zieht "+name(WEN,0)+" an.\n"}));
  SetProp(P_UNWEAR_TEXT,({"Du ziehst "+name(WEN,1)+" aus.\n",
                          " zieht "+name(WEN,0)+" aus.\n"}));
  AddId(({ARMSTAT[at]["name"],gemtype+ARMSTAT[at]["name"]}));  
}

int Customize(string type,int pow,string armourtype)
{
  int retval;
  retval=SetGemtype(type);
  if (retval)
    retval=SetPower(pow);
  if (retval)
    retval=SetArmourtype(armourtype);
  if (retval)
    Update();
  return retval;
}

int SetOwner(string name) 
{
  object pl;
  
  if (!stringp(name))
    return Error("Wrong argument type (name) to SetOwner",PO);
  pl=find_living(name);
  if (!pl)
    return Error("Player "+CAP(name)+" not found in SetOwner",PO);
  owner=name;
  gender=pl->QueryProp(P_GENDER);
  return 1;
}
