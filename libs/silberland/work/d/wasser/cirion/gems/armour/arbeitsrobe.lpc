#include "../gems.h"

inherit "std/armour";

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Arbeitsrobe");
  SetProp(P_LONG,
    "Das ist eine Arbeitsrobe aus blauer Baumwolle. Sie hat keine besonderen "
    "Verzierungen, dafuer ist sie mit Leder verstaerkt, so dass man "
    "sich beim Arbeiten nicht so leicht verletzen kann." );
  SetProp(P_NAME, "Arbeitsrobe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"robe","arbeitsrobe"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 25);
  SetProp(P_MATERIAL, ([ MAT_COTTON:80, MAT_LEATHER:20 ]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 140);

  AddProp(P_DAM_PROTECTION, ([DT_FIRE:1]) );
}