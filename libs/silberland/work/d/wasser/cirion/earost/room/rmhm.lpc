#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/earost/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Auf einer Allee unter Wasser");
  SetProp (P_INT_LONG,
    "Du stehst auf einer breiten Allee die hier geradewegs von Sueden "+
    "nach Norden fuehrt. Der Weg ist mit hellen, sechseckigen "+
    "Steinplatten geflastert, am Rand ist ein breites Band mit "+
    "wunderschoenen Ornamenten eingelegt. Rechts und links des Weges sind "+
    "Beete mit wunderschoenen Wasserblumen angelegt, und eine lange Reihe "+
    "von dunkelgruenen Baeumen erstreckt sich zu beiden Seiten parallel "+
    "zum Weg. Im Norden kannst Du riesige Tore ausmachen, die in eine "+
    "grosse, aus dunkelgrauem Stein bestehende Felssaeule hineinzufuehren "+
    "scheinen. Im Sueden erstreckt sich die Allee bis sie in einem "+
    "dunklen Wald verschwindet. Nach Osten fuehrt ein etwas schmalerer "+
    "Weg zwischen Blumen und Baeumen hindurch auf eine Art Platz zu.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./rmim");
  AddExit ("osten", "/d/wasser/cirion/seepferde/room/earost_rmhn");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
