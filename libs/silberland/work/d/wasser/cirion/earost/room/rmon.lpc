#include "../earost.h"
#include WHOME"/gems/gems.h"

#define SAVEFILE GEM_SAVE"/_armours"

inherit WROOM"/wroom";

private mixed *finished_armours=({});
private mixed *unfinished_armours=({});

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23]));
  SetProp (P_INT_SHORT, "Fanaris Laden");
  SetProp (P_INT_LONG, 
   "Du stehst in einem fuer die hiesigen Verhaeltnisse ziemlich kleinen "
   "Laden. Gegenueber der Eingangstuer, vor der Westwand steht ein breiter "
   "Tresen. Dahinter ist ein schmaler Regal mit einigen Buechern und "
   "Papieren. Links vom Tresen fuehrt eine Tuer nach Sueden. An der Suedwand "
   "des Raumes ist ein Schrank mit einer ganzen Menge Schubladen. An der "
   "Nordwand stehen einige seltsame Gerueste, die Fast wie Kleiderstaender "
   "aussehen. In der Ostwand, rechts und links der Tuere sind zwei breite "
   "Fenster, davor stehen grosse Blumentoepfe. Beleuchtet wird der Raum "
   "von einem kristallenen Leuchter, der von der Decke haengt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"eingang", "eingangstuer"}),
    "Eine grosse, zweiflueglige Tuer aus einem hellen Holz, welche nach "+
    "draussen auf den Hauptgang von Earost fuehrt. <fun_open?>");
  AddDetail ( ({"tuer", "tuere"}),
    "Meinst du die Eingangstuer oder die Suedtuer?");
  AddDetail ( ({"schmiedetuer", "schmiedetuere", "suedtuer", 
                "suedtuere"}),
    "Die Tuer in der Suedwand des Raumes ist aus dem gleichen Holz wie die "+
    "Eingangtuer, aber sie ist viel kleiner und auch nicht zweiflueglig. "+
    "Sie scheint in eine Art Werkstatt zu fuehren.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("osten", ROOM"/rmoo");
  AddWaterExit ("sueden", ROOM"/rmnn");
  // EXITS END

  // ITEMS START
  AddItem(FANARI,REFRESH_DESTRUCT);
  // ITEMS END
  restore_object("SAVEFILE");
  if (sizeof(unfinished_armours))
    if (present(FANARI))
      FANARI->MakeArmour(0);
}

mapping get_next_unfinished()
{
  if (sizeof(unfinished_armours))
    return unfinished_armours[0];
  return 0;
}

int sizeof_unfinished()
{
  return sizeof(unfinished_armours);
}

int ArmourDone()
{
  if (sizeof(unfinished_armours))
  {
    finished_armours+=({unfinished_armours[0]});
    unfinished_armours=unfinished_armours[1..<1];
  }
  if (sizeof(unfinished_armours))
    return 0;
  return 1;
}
