  SetProp (P_INT_SHORT, "Hinterzimmer von Ealissa");
  SetProp (P_INT_LONG, "]");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", "./rmkn");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
