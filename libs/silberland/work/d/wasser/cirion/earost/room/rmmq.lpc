#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/earost/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:0]));
  SetProp (P_INT_SHORT, "Auf dem Ostplatz Earosts");
  SetProp (P_INT_LONG, "]");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", "./rmlp");
  AddExit ("nordwesten", "./rmnp");

  // EXITS END

  // ITEMS START
  // ITEMS END

}
