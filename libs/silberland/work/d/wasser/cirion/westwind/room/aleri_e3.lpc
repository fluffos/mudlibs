#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/westwind/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23]));
  SetProp (P_INT_SHORT, "An einem breiten weissen Sandstrand");
  SetProp (P_INT_LONG,
    "Du stehst an der Suedkueste einer kleinen Insel auf einem breiten, "+
    "weissen Sandstrand, der sich von hier aus nach Nordwesten und nach "+
    "Osten erstreckt. Im Sueden kannst Du nur die unendliche Ferne des "+
    "weiten Meeres erkennen, waehrend sich im Norden gleich am Strand "+
    "eine hohe, mit eigenartigen rankenbildenden Pflanzen bewachsene "+
    "Felswand erhebt. Die Sonne scheint warm herab, und nur vereinzelte "+
    "Woelkchen trueben den ansonsten wunderbar azurblauen Himmel. Immer "+
    "wieder erkennst Du Seevoegel, die am Strand nach Nahrung suchen, "+
    "ueber die Insel hinwegfliegen oder im dichten Bewuchs der Felswand "+
    "Ihre Nester errichten.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"kueste", "suedkueste"}),
    "Dies scheint die Suedkueste einer kleinen Insel zu sein. Sie "+
    "erstreckt sich von hier aus weiter nach Nordenwesten und nach Osten. "+
    "Im Sueden liegt nur das weite, azurblaue Meer.");
  AddDetail ( ({"insel"}),
    "Du stehst auf einer kleinen Insel, die hier einen wunderbaren weissen "+
    "Sandstrand hat und nach Norden hin steil ansteigt.");
  AddDetail ( ({"sandstrand", "strand"}),
    "Die Suedkueste der Insel wird von einem breiten, weissen Sandstrand "+
    "gebildet, welcher in der Sonne glitzert. Nach Norden hin wird der "+
    "Strand von einer steilen Felswand begrenzt, welche grossteils mit "+
    "dichten, gruenen Pflanzen bewachsen ist.");
  AddDetail ( ({"ferne", "horizont"}),
    "Das weite Meer erstreckt sich bis in die Ferne zum Horizont, wo der "+
    "Himmel ins Meer ueberzugehen scheint.");
  AddDetail ( ({"meer"}),
    "Das Meer ist hier azurblau und erstreckt sich nach Sueden, Westen und "+
    "Osten bis zum Horizont. Langsam faellt der Meeresgrund nach Sueden hin "+
    "ab, es ist sicher eine ideale Stelle zum Baden. Sanfte Wogen rollen "+
    "vom Meer heran und verlaufen sich am Strand. Etwas weiter von der "+
    "Insel entfernt brechen sich groessere Wellen in der Brandung.");
  AddDetail ( ({"felswand", "klippe", "wand"}),
    "Eine hohe Klippe erhebt sich noerdlich vom Strand. Sicher wurde das "+
    "Felsgestein in langen Jahrhunderten vom Meer abgetragen bis sich so "+
    "eine senkrechte Felswand bilden konnte. Sie ist sicher 25 Meter hoch, "+
    "und an vielen Stellen von dichten, gruenen Pflanzen bewachsen, welche "+
    "Ranken gebildet haben, die bis zum Strand herabhaengen und grosse "+
    "Teile der Felswand verdecken.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./aleri_d3");
  SetProp(P_HIDE_EXITS,({"norden"}));
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddRoomMessage(({
   "Ein kleier Vogel huepft auf der Suche nach Futte ueber den Strand.\n",
   "Ein kleiner Schwarm Seevoegel zieht ueber Dir seine Kreise.\n",
   "Einer der Seevoegel fliegt mit einem Wurm im Schnabel vom Strand "
   "zu einem\nNest im Bewuchs der Felswand.\n",
   "Ein Vogel kommt von der Felswand auf den Strand herabgeflogen.\n",
   "Ein grosser Seevogel macht draussen ueber der Brandung Jagd auf Fische.\n",
   "Ein Seevogel kommt vom Inneren der Insel zum Strand geflogen.\n",
   "Ein Seevogel fliegt vom Strand aufs Meer hinaus.\n",
   "Draussen auf dem Meer schwimmt eine Herde Delphine vorueber.\n",
   "Weit draussen auf dem Meer erkennst Du die Wasserfontaene eines Wals.\n",
   "Ein kleines Nagetier laeuft an den Felsen entlang und verschwindet "
   "zwischen\ndem Bewuchs.\n"}),25);
}
