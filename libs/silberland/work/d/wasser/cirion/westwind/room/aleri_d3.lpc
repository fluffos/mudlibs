#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/westwind/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:9]));
  SetProp (P_INT_SHORT, "In einer dunklen Hoehle");
  SetProp (P_INT_LONG,
    "Ein dunkler Felsgang erstreckt sich von hier aus nach Nordosten, wo "+
    "er einen leichten Linksknick macht und in der Dunkelheit "+
    "verschwindet. Von dort fliesst ein schmales Rinnsal von Wasser in "+
    "Richtung Sueden. Dort kannst Du noch schwach das Sonnenlicht "+
    "erkennen, doch der Bewuchs verschliesst den Eingang der Hoehle fast "+
    "vollstaendig. Einige Meter ueber Dir erkennst Du die Hoehlendecke, "+
    "die nach Nordosten hin noch weiter anzusteigen scheint.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"hoehlenwaende", "hoehlenwand", "waende", 
                "wand"}),
    "Die Hoehlenwaende sind aus dunklem, schroffen Felsgestein.");
  AddDetail ( ({"decke","hoehlendecke"}),
    "Die Decke der Hoehle ist einige Meter ueber Dir und scheint nach "+
    "Nordosten hin noch weiter anzusteigen. Sie besteht aus schroffem, "+
    "dunklen Felsgestein, welches voellig unbearbeitet ist.");
  AddDetail ( ({"boden", "hoehlenboden"}),
    "Der Hoehlenboden besteht aus dem gleichen schroffen Felsgestein wie "+
    "Waende und Decke. Ein schmales Rinnsal von Wasser kommt aus der Hoehle "+
    "und fliesst weiter nach Sueden. Daneben erkennst eine Menge Kratzer "+
    "und Schrammen, die in den Boden gerissen wurden.");
  AddDetail ( ({"licht", "sonnenlicht"}),
    "Ein wenig Sonnenlicht kannst Du im Sueden durch den Bewuchs noch "+
    "erkennen.");
  AddDetail ( ({"rinnsal", "wasser"}),
    "Ein schmales Rinnsal von Wasser kommt aus der Dunkelheit der Hoehle "+
    "geflossen und rinnt weiter nach Sueden.");
  AddDetail ( ({"biegung", "knick", "linksknick"}),
    "s Im Nordosten scheint die Hoehle einen leichten Knick nach links zu "+
    "machen und etwas mehr Richtung Norden zu verlaufen.");
  AddDetail ( ({"eingang","hoehleneingang"}),
    "Der Eingang der Hoehle im Sueden ist fast voellig durch den Bewuchs "+
    "von dichten, gruenen Ranken verdeckt. Nur ein kleines bisschen "+
    "Sonnenlicht blitzt hier und dort dazwischen durch.");
  AddDetail ( ({"bewuchs", "pflanzen", "ranken"}),
    "Der Bewuchs des Hoehleneingangs besteht aus dichten, gruenen Pflanzen "+
    "welche lange Ranken gebildet haben, die bis zum Boden herabhaengen und "+
    "somit den gesamten Eingang verdecken.");
  AddDetail ( ({"dunkel", "dunkelheit"}),
    "Der Gang verschwindet nach Norden in der Dunkelheit.");
  AddDetail ( ({"gang", "hoehle","hoehlengang","felsgang"}),
    "Der Gang erstreckt sich von Sueden nach Nordosten.");
  AddDetail ( ({"kratzer", "schrammen"}),
    "Die Schrammen und Kratzer im Boden scheinen nicht natuerlichen "+
    "Ursprungs zu sein. Offensichtlich hat sie ein sehr grosses Wesen "+
    "erzeugt.");
  AddDetail ( ({"drache", "wesen","drachen"}),
    "Bei dem Wesen koennte es sich beispielsweise um einen Drachen "+
    "gehandelt haben.");
  AddDetail ( ({"fels", "felsen", "felsgestein", 
                "gestein"}),
    "Die Hoehle besteht aus dunklem, schroffem Felsgestein.");
  AddDetail ( ({"menge"}),
    "Sehr viele Kratzer.");
  AddDetail ( ({"meter", "zwergenlaenge"}),
    "Ein Meter ist fast eine ganze Zwergenlaenge.");
  AddDetail ( ({"ursprung"}),
    "mpad Der Ursprung der Kratzer und Schrammen scheint ein sehr grosses "+
    "Wesen gewesen zu sein.");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", "./aleri_c4");
  AddExit ("sueden", "./aleri_e3");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
