#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/westwind/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:8]));
  SetProp (P_INT_SHORT, "In einer dunklen, feuchten Hoehle");
  SetProp (P_INT_LONG, 
    "Du stehst inmitten einer dunklen, feuchten Hoehle. Weit ueber Dir "
    "spannt sich eine schroffe Felsdecke, von der immer wieder Wasser "
    "herabtropft, welches sich am Boden in Pfuetzen sammelt. Nach Norden "
    "und Nordwesten scheint sich die Hoehle zu erweitern, waehrend nach "
    "Suedwesten ein dunkler Gang zu fuehren scheint.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"pfuetze", "pfuetzen", "tropfen", 
                "wasser", "wassertropfen"}),
    "Immer wieder fallen Wassertropfen von der Decke herab und bilden am "+
    "Boden grosse Pfuetzen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Angestrengt lauschst Du...schliesslich meinst Du aus dem Norden die "+
    "Geraeusche von einem grossen Wesen zu hoeren. Besser, Du bist "+
    "vorsichtig.");
  AddSound ( ({"geraeusch", "geraeusche", "lebewesen", 
                "wesen"}),
    "Ja, ganz sicher, im Norden befindet sich irgendwo ein ziemlich "+
    "grosses Lebewesen, welches stampfende Geraeusche von sich gibt.");
  AddSmell ( ({DEFAULT_SMELL, "exkrement", "exkremente","geruch"}),
    "Du bemerkst einen Geruch von Exkrementen, der Dir gar nicht geheuer "+
    "ist.");
  AddDetail ( ({"decke", "felsdecke", "hoehlendecke"}),
    "Eine schroffe Felsdecke spannt sich weit ueber Dir. Immer wieder "+
    "fallen von oben Wassertropfen herab, die sich am Boden in Pfuetzen "+
    "sammeln.");
  AddDetail ( ({"hoehle"}),
    "Dunkel und feucht ist es in dieser Hoehle, und sie ist so gross, dass "+
    "auch ein Drache bequem hier hineinpassen wuerde. Boden, Waende und "+
    "Decke bestehen aus schroffem Felsgestein. Nach Norden und Nordwesten "+
    "hin erweitert sich die Hoehle in die Dunkelheit hinein.");
  AddDetail ( ({"drache"}),
    "Du kannst im Moment keinen sehen, aber das heisst ja nicht, dass in "+
    "dieser Hoehle keiner lebt.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende der Hoehle sind aus schroffem, dunklen Felsgestein. Es "+
    "sieht nicht so aus, als waere die Hoehle kuenstlich in den Fels "+
    "getrieben worden.");
  AddDetail ( ({"dunkel", "dunkelheit"}),
    "In der Dunkelheit, die sich nach Norden ausstreckt, kannst Du nichts "+
    "erkennen. Wer weiss, welche Gefahren dort lauern moegen.");
  AddDetail ( ({"gefahr", "gefahren"}),
    "Die kannst Du nun wirklich nicht mit Deinen Augen wahrnehmen.");
  AddDetail ( ({"gang"}),
    "Ein grosser, dunkler Gang fuehrt nach Suedwesten zurueck ins Freie.");
  AddDetail ( ({"freie", "freies"}),
    "Das Freie kannst Du von hier aus nicht sehen, aber von dort bist Du "+
    "gekommen.");
  AddDetail ( ({"boden"}),
    "Auch der Boden besteht aus dem dunklen, schroffen Felsgestein. Am "+
    "Boden haben sich grosse Pfuetzen gebildet, in die immer wieder Wasser "+
    "von der Decke tropft. Zwischen den Pfuetzen kannst Du grosse Kratzer "+
    "und Schrammen im Felsgestein erkenne, die nicht natuerlichen Ursprungs "+
    "zu sein scheinen.");
  AddDetail ( ({"kratzer", "schrammen"}),
    "Die Schrammen und Kratzer am Boden scheinen nicht natuerlichen "+
    "Ursprungs zu sein, vielmehr koennten sie von einem grossen Tier "+
    "stammen, welches in der Hoehle haust.");
  AddDetail ( ({"tier"}),
    "Du kannst keines sehen, aber es koennte durchaus ein Drache gewesen "+
    "sein, der diese Spuren hinterlassen hat.");
  AddDetail ( ({"spuren"}),
    "Die Kratzer und Schrammen am Boden sind damit gemeint.");
  AddDetail ( ({"ursprung"}),
    "Den Ursprung der Kratzer kannst Du im Moment nicht sehen, aber es "+
    "koennte durchaus ein Drache gewesen sein, der sie in den Boden "+
    "gekratzt hat.");
  AddDetail ( ({"fels", "felsen", "felsgestein", 
                "gestein"}),
    "Dunkles, schroffes Felsgestein bildet Decke, Waende und Boden dieser "+
    "Hoehle. Es scheint niemals kuenstlich bearbeitet worden zu sein.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./aleri_b4");
  AddExit ("nordwesten", "./aleri_b3");
  AddExit ("suedwesten", "./aleri_d3");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
