#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/westwind/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:8]));
  SetProp (P_INT_SHORT, "In einer dunklen, feuchten Hoehle");
  SetProp (P_INT_LONG,
    "Du stehst inmitten einer dunklen, feuchten Hoehle, deren Waende "+
    "rundum fast schwarz sind. Haushoch ueber Dir spannt sich eine "+
    "schroffe Hoehlendecke, von der immer wieder Wasser herabtropft. Am "+
    "Boden haben sich schon einige grosse Pfuetzen gebildet, die etwas "+
    "oelig schimmern. Nach Westen und Sueden erstreckt sich die "+
    "Hoehle weiter.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"waende","wand"}),
    "Die Waende sind aus dunklem, schroffen Felsen, der vor Feuchtigkeit "+
    "glitzert. An verschiedenen Stellen kommen kleine Rinnsale die Waende "+
    "heruntergelaufen. An einigen Stellen kannst du ein metallisches "+
    "Glitzern erkennen.");
  AddDetail ( ({"decke", "hoehlendecke"}),
    "Die schroffe Hoehlendecke verschwindet haushoch ueber Dir im Dunkeln.");
  AddDetail ( ({"himmel"}),
    "Den Himmel kannst Du hier nicht sehen.");
  AddDetail ( ({"boden", "hoehlenboden"}),
    "Der Hoehlenboden ist unregelmaessig und weist an vielen Stellen tiefe "+
    "Furchen und Kratzer auf, in denen sich grosse, oelig schillernde "+
    "Wasserpfuetzen gesammelt haben.");
  AddDetail ( ({"wasser"}),
    "Das Wasser tropft von der Decke, laeuft in duennen Rinnsalen die "+
    "Waende herab und bildet am Boden grosse, oelig schimmernde Pfuetzen.");
  AddDetail ( ({"rinnsal", "rinnsale", "stelle", 
                "stellen"}),
    "uhr uhr An mehreren Stellen laeuft Wasser in duennen Rinnsalen die "+
    "Waende herab.");
  AddDetail ( ({"hoehle"}),
    "Die Hoehle erstreckt sich von hier aus weiter nach Westen und "+
    "Sueden.");
  AddDetail ( ({"feuchtigkeit"}),
    "Die Feuchtigkeit scheint von oben zu kommen, aber mittlerweile hat "+
    "sie hier alles durchdringen.");
  AddDetail ( ({"glitzern", "metalladern"}),
    "Das Glitzern kommt von duennen Metalladern, die die Waende zu "+
    "durchziehen scheinen. Es scheint sich aber eher um minderwertiges "+
    "Metall zu handeln.");
  AddDetail ( ({"metall"}),
    "Du kannst nicht genau erkennen, um welches Metall es sich handelt.");
  AddDetail ( ({"fels", "felsen", "felsgestein"}),
    "Die ganze Hoehle ist aus schroffem, dunklen Felsgestein.");
  AddDetail ( ({"pfuetzen", "wasserpfuetzen"}),
    "Grosse pfuetzen haben sich am Boden der Hoehle gebildet. Das Wasser "+
    "fliesst ein wenig nach Sueden ab.");
  AddDetail ( ({"furchen", "kratzer"}),
    "Die Kratzer und Furchen sehen nicht so aus, als waeren sie "+
    "natuerlichen Ursprungs. Vielmehr wuerdest Du vermuten, dass sie von "+
    "einem riesigen Tier verursacht wurden.");
  AddDetail ( ({"tier"}),
    "Du kannst im Moment kein Tier sehen.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "./aleri_b3");
  AddExit ("sueden", "./aleri_c4");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
