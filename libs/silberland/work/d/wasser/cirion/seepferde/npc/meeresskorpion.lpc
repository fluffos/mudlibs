inherit "std/mnpc";

#include "../seepferde.h"
#include <mnpc.h>

#define COLOR ({"weiss","gelb","rot","braun","schwarz"})
#define ALIGN ({300,0,-200,-400,-800})

nosave int align;

create()
{

  if (!is_clone(this_object())) return;
  align=random(8);
  switch (align)
  {
    case 0..2:
      break;
    case 3..10:align=1;
      break;
    case 11..12:align=2;
      break;
    case 13:align=3;
      break;
    case 14:align=4;
      break;
    default:align=0;
      break;
  }
  ::create();
  
  SetProp(P_SHORT, "Ein "+COLOR[align]+"er Meeresskorpion");
  SetProp(P_LONG, 
    "Das ist ein kleiner, "+COLOR[align]+"er Meeresskorpion. Er hat 6 Beine "
    "und einen langen Schwanz mit einem gefaehrlich aussehenden Stachel am Ende.");
  SetProp(P_NAME, "Meeresskorpion");
  SetProp(P_NAME_ADJ,COLOR[align]);
  SetProp(P_GENDER, MALE);
  AddId(({"skorpion","meeresskorpion"}));
  AddAdjective(({COLOR[align]+"er",COLOR[align]+"en"}));
  create_default_npc(8+align*2);
  SetProp(P_ALIGN, ALIGN[align]);
  SetProp(P_HANDS, ({" mit seinem spitzen Stachel",QueryProp(P_HANDS)[1],DT_PIERCE}) );
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RACE,"skorpion");
  SetProp(P_SIZE,32);
  SetProp(P_HEAL,0-align);
  SetProp(P_AGGRESSIVE,(align>2?1:0));

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "graebt sich ein");
  SetProp(P_MMSGOUT, "graebt sich aus dem Boden und kriecht hervor");
  
  SetChats(3, ({
  "Der "+COLOR[align]+"e Meereskorpion krabbelt in eine kleine Spalte.\n",
  "Der "+COLOR[align]+"e Meereskorpion versteckt sich unter einigen Wasserpflanzen.\n",
  "Der "+COLOR[align]+"e Meereskorpion schneidet mit ihren Scheren ein grosses Blatt einer Wasserpflanze ab.\n",
  "Der "+COLOR[align]+"e Meereskorpion bleibt still stehen und bewegt nur langsam ihre Fuehler.\n",
  "Der "+COLOR[align]+"e Meereskorpion krabbelt herum.\n",
  "Der "+COLOR[align]+"e Meereskorpion verkriecht sich.\n",
  "Der "+COLOR[align]+"e Meereskorpion schnappt sich einen kleinen Fisch und vertilgt ihn.\n"
  }) );

  //Moving NPC
  SetProp (P_MNPC_AREA,({ROOM+"/riffd3-1",ROOM+"/riffe4-1",ROOM+"/riffe5-1"}));
  SetProp (P_MNPC_WAIT, ({ 20+random(10) }));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS + MOV_SPECIAL);

  SetProp( P_DIE_MSG, " zuckt und liegt dann still.\n" );

  SetProp( P_NOCORPSE, 0 );
 
  SetProp(P_DEFAULT_INFO,"kann wohl nicht sprechen.\n");

  SetProp (P_REJECT,({ REJECT_DROP, "Der Skorpion kann nichts nehmen.\n" }) );  
}

reset()
{
  if ((align>0)&&(align<4))
  {
    align++;
    tell_room(MENV,BS(
      "Der kleine, "+COLOR[align-1]+"e Meeresskorpion nimmt langsam eine "
      +COLOR[align]+"e Farbe an."));
    SetProp(P_SHORT, "Ein "+COLOR[align]+"er Meeresskorpion");
    SetProp(P_NAME_ADJ,COLOR[align]);
    SetProp(P_LONG, 
      "Das ist ein kleiner, "+COLOR[align]+"er Meeresskorpion. Er hat 6 Beine "
      "und einen langen Schwanz mit einem gefaehrlich aussehenden Stachel am Ende.");
    RemoveAdjective(({COLOR[align-1]+"er",COLOR[align-1]+"en"}));
    AddAdjective(({COLOR[align]+"er",COLOR[align]+"en"}));
    create_default_npc(8+align*2);
    SetProp(P_ALIGN, ALIGN[align]);
    SetProp(P_HEAL,0-align);
    SetProp(P_AGGRESSIVE,(align>1?1:0));
  }
}