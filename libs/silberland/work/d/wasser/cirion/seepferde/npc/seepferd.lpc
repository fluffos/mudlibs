inherit "/std/room/description";
inherit "/std/npc";

#include "../seepferde.h"
#include "room.h"

nosave int size;
nosave string location;
nosave string sequences;

void create()
{
  if (!is_clone(TO)) return;

  npc::create();
        
  size=random(10);
  AddId(({"seepferd",SEEPFERDID}));
  set_living_name("seepferd");
  create_default_npc(15+size);
  SetProp(P_HANDS,({" mit seinem starken Gebiss",220,DT_RIP}));
  SetProp(P_NAME,"Seepferd");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_WEIGHT, 650K+size*10K+random(10K) );
  SetProp(P_MAX_WEIGHT, 400K+size*10K );
  SetProp(P_VALUE, 100K+size*2K+random(2K) );
  SetProp(P_NOQUIT,1);
  SetProp(P_NOREST,1);
  SetProp(P_RACE,"Seepferd");
  SetProp(P_INDOORS,0);
  SetProp(P_SIZE,320+size*5+random(5));
  SetProp(P_NO_TPORT,NO_TPORT);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_UNDERWATER])); 
  SetProp(P_SHORT,"Ein grosses, schlankes Seepferd");
  SetProp(P_LONG,
    "Ein grosses, schlankes Seepferd schwimmt hier im Wasser. Es hat eine "
    "dunkelgruen bis blaeuliche Haut und ist ein wenig anders geformt als "
    "andere Seepferdchen, die Du bereits kennst, so dass man hervorragend "
    "darauf reiten kann. Das Seepferd scheint einen "
    "freundlichen Gesichtsausdruck zu haben, soweit Du das bei einem "
    "solchen, aussergewoehnlichen Tier sagen kannst. Es schaut sich aufmerksam "
    "mit seinen grossen, voellig schwarzen Augen um, als wuerde es auf "
    "etwas oder jemanden warten.");
  SetProp(P_INT_LONG,
    "Du sitzt auf dem Ruecken eines grossen, dunkelgruen-blaeulichen "
    "Seepferds. Dem Seepferd scheint Dein Gewicht nichts auszumachen.");
  SetProp(P_INT_SHORT,"Auf dem Ruecken eines Seepferds");
  SetProp(P_MSGIN,"schwimmt elegant herein");
  SetProp(P_MSGOUT,"schwimmt elegant");
  SetProp(P_MMSGIN,"schwimmt elegant herein");
  SetProp(P_MMSGOUT,"schwimmt elegant davon");

  SetProp(P_DIE_MSG," stirbt und beginnt zum Boden zu sinken.");
  SetProp(P_NOCORPSE, 0 );
  AddDetail(({"haut"}),
    "Die Haut des Seepferds scheint recht glatt zu sein und hat eine "
    "dunkelgruene bis blaeuliche Faerbung.");
  AddDetail(({"faerbung","flecken"}),
    "Die Faerbung ist recht unregelmaessig, so dass das Seepferd hellere "
    "und dunklerer, blaeulichere und gruenlichere Flecken hat.");
  AddDetail(({"seepferdchen"}),
    "Es gibt auch kleine Seepferdchen, die nicht viel groesser als einige "
    "Fingerlaengen werden. Doch dieses hier ist anders, es ist groesser und "
    "hat einen aufmerksamen Blick, dass Du fast meinst, es koennte genau "
    "so klug sein wie Du.");
  AddDetail(({"fingerlaengen","finger","fingerlaenge","laenge"}),
    "Eine Fingerlaenge ist die Laenge eines Fingers.");
  AddDetail(({"blick","gesichtsausdruck","ausdruck"}),
    "Das Seepferd hat einen aufmerksamen, klugen und wie Dir scheint auch recht "
    "freundlichen Blick.");
  AddDetail(({"tier"}),
    "Dies scheint ein wirklich aussergewoehnliches Tier zu sein.");
  AddDetail(({"augen","auge"}),
    "Das Seepferd hat voellig schwarze Augen, die wie zwei unendlich tiefe "
    "Seen scheinen. Es blickt Dich aufmerksam an.");
  AddDetail(({"seen"}),
    "Fast wie unendlich tiefe Seen scheinen die Augen des Seepferds.");
}

start_travel(string dest)
{
  tell_room(TO,BS("Das Seepferd scheint zu nicken, Du drueckst Dich etwas "
    "fester an es, und schon geht es los."));
  tell_room(MENV,BS("Das Seepferd scheint zu nicken, dann schwimmt es los."));
  travel(dest);
  return;
}

wrong_location(object player)
{
  tell_object(player,BS("Das Seepferd schaut, als habe es das nicht "
                        "ganz verstanden."));
}

already_here(object player)
{
  tell_object(player,BS("Das Seepferd schaut Dich an, als haettest Du "
                     "gerade etwas sehr unsinniges gedacht."));
}

already_traveling(object player)
{
  tell_object(player,BS("Das Seepferd laesst sich nicht davon stoeren."));
}

int command_seahorse(string str)
{
  if (ENV(TP)!=TO)
  {
    return 0;
  }
  if ((-1!=find_call_out("call_event"))||(-1!=find_call_out("start_travel")))
  {
    call_out("already_traveling",0,TP);
    return 0;
  }
  if (-1==member(m_indices(LOCATIONS),str))
  {
    call_out("wrong_location",0,TP);
    return 0;                             
  }
  else if(LOCATIONS[str]==file_name(MENV))
  {
    call_out("already_here",0,TP);
    return 0;                               
  }
  call_out("start_travel",0,str);
  return 0;
}

remove()
{
  ::remove();
}

string GetDetail(mixed key, mixed race)
{
  if (key=="umgebung") return(MENV->int_long(TP,ME,TP->QueryProp(P_SHORTINV)? 0 : 2));
  if (key=="seepferd") return(QueryProp(P_LONG));
  return (::GetDetail(key,race)||MENV->GetDetail(key,race));
}

init()
{
  ::init();

  SetProp (P_ENVIRONMENT,MENV->QueryProp(P_ENVIRONMENT));
  add_action("cmdmount","kletter");
  add_action("cmdmount","klettere");
  add_action("command_seahorse","denk");
  add_action("command_seahorse","denke");
}

die(int poisondeath)
{
  object ob;
  
  if (!DOCKED)
  {
    return;
  }
  if (1<sizeof(filter_array(all_inventory(TO), #'living)))
    tell_room(MENV,BS("Die Reiter des Seepferds rutschen herunter."));
  else if (0<sizeof(filter_array(all_inventory(TO), #'living)))
    tell_room(MENV,BS("Der Reiter des Seepferds rutscht herunter."));
  tell_room(TO,BS("Du rutschtst vom Seepferd herunter."));
  for (ob=first_inventory(TO);ob;ob=next_inventory(TO))
    ob->move(MENV,M_NOCHECK|M_SILENT);
  ::die();
  return;
}

varargs int move(mixed dest, int method,string dir, string textout, string textin)
{
  return npc::move(dest, method,dir,textout,textin);
}

varargs string long()
{
  string descr;
  object *reiter;
  int i,hpnt,max_hpnt;
  descr=QueryProp(P_LONG);

  descr+= capitalize(QueryPronoun());
  hpnt = QueryProp( P_HP );
  max_hpnt = QueryProp( P_MAX_HP );
  if (hpnt < max_hpnt/10) 
    descr += " steht auf der Schwelle des Todes.\n";
  else if (hpnt < max_hpnt/5) 
    descr += " braucht dringend einen Arzt.\n";
  else if (hpnt < max_hpnt*3/10) 
    descr += " ist in keiner guten Verfassung.\n";
  else if (hpnt < max_hpnt*4/10) 
    descr += " wankt bereits bedenklich.\n";
  else if (hpnt < max_hpnt/2) 
    descr += " macht einen mitgenommenen Eindruck.\n";
  else if (hpnt < max_hpnt*6/10) 
    descr += " sieht nicht mehr taufrisch aus.\n";
  else if (hpnt < max_hpnt*7/10) 
    descr += " ist leicht angeschlagen.\n";
  else if (hpnt < max_hpnt*8/10) 
    descr += " fuehlte sich heute schon besser.\n";
  else if (hpnt < max_hpnt*9/10) 
    descr += " ist schon etwas geschwaecht.\n";
  else
    descr += " ist absolut fit.\n";
  reiter=filter_array(all_inventory(TO), #'query_once_interactive);
  if (1==sizeof(reiter))
  {
    descr+=sprintf("Auf ihm sitzt %s.\n",reiter[0]->Name());
  }
  else if (1<sizeof(reiter))
  {
    descr+=sprintf("Auf ihm sitzen %s und %s.\n",
                   reiter[0]->Name(),reiter[1]->Name());
  }
  return descr;
}

string int_long(mixed viewer,mixed viewpoint, int shortflag)
{
  string descr, inv_descr;
  object* inv;
  int mlev;

  descr="";
  if( IS_LEARNER(viewer) && (mlev=viewer->QueryProp( P_WANTS_TO_LEARN )) )
    descr+=wiz_header(viewer)+"\n";
  descr += process_string(QueryProp(P_INT_LONG)||"");
  inv_descr = (string) make_invlist(viewer, all_inventory(ME)
                                    -filter_array(all_inventory(TO), #'living),
                                    shortflag);
  if (DOCKED)
    descr+="Es scheint auf Deine Anweisungen zu warten.\n";
  else 
    descr+="Es rast durch das Wasser nur so dahin.\n";
  descr+="Die Umgebung ist '"+MENV->QueryProp(P_INT_SHORT)+"'.\n";
  inv=filter_array(all_inventory(ME),#'living)-({viewer});
  if (sizeof(inv)>0)
  {
    if (viewer==inv[0])
      descr+="Hinter Dir sitzt "+inv[1]->name()+".\n";
    else
      descr+="Vor Dir sitzt "+inv[0]->name()+".\n";
  }
  if ( inv_descr != "" )
    descr += "Hier liegt seltsamerweise noch:\n"+inv_descr;
  
  return descr;

}

int cmdmount(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (TO==ENV(TP))
  { 
    if (-1==member((ARGAB),str))
      return 0;
    else
    {
      notify_fail(BS("Du moechtest nicht wirklich waehrend des rasenden "
        "Rittes abspringen\n"));
      if (DOCKED)
      {
        tell_object(TP,"Du gleitest geschickt vom Ruecken des Seepferdes.\n");
        TP->move(MENV, M_GO|M_SILENT,"vom Pferderuecken",
               "klettert","klettert vom Seepferd herab");
        return 1;
      }
      return 0;
    }
  }
  else if (MENV==ENV(TP))
  {
    if (-1==member((ARGAUF),str))
      return 0;
    else
    {
      if (1<sizeof(filter_array(all_inventory(TO), #'living)))
      {
        tell_room(TO,BS(
          TP->Name()+" naehert sich dem Seepferd, doch diese schlaegt nur "
          "einmal mit dem Schwanz und gewinnt so wieder Abstand. Scheinbar "
          "moechte es nicht mehr als zwei Reiter tragen."));
        tell_room(ENV(TP),BS(
          TP->Name()+" naehert sich dem Seepferd, doch diese schlaegt nur "
          "einmal mit dem Schwanz und gewinnt so wieder Abstand. Scheinbar "
          "moechte es nicht mehr als zwei Reiter tragen."),({TP}));
        tell_object(TP,BS(
         "Du naeherst Dich dem Seepferd, doch es schlaegt nur einmal mit dem "
         "Schwanz und gewinnt so genug Abstand zu Dir. Scheinbar moechte es "
         "nicht mehr als zwei Reiter tragen."));
        return 1;
      }
      if (IsEnemy(TP))
      {
        tell_room(TO,BS(
          TP->Name()+" versucht das Seepferd mitten im Kampf zu besteigen. "
          "Das laesst es natuerlich nicht mit sich machen, und beisst "
          +TP->Name(WEN)+" kraeftig."));
        tell_room(ENV(TP),BS(
          TP->Name()+" versucht das Seepferd mitten im Kampf zu besteigen. "
          "Das laesst es natuerlich nicht mit sich machen, und beisst "
          +TP->Name(WEN)+" kraeftig."),({TP}));
        tell_object(TP,BS(
          "Was? Du willst das Seepferd mitten im Kampf besteigen? Das laesst "
          "es natuerlich nicht mit sich machen, statt dessen beisst es "
          "Dich einmal kraeftig."));  
        TP->do_damage(20+random(10)); 
        return 1;
      }
      if (-1==MayAddWeight(TP->QueryProp(P_WEIGHT)))
      {
        tell_room(TO,BS(
          TP->Name()+" naehert sich dem Seepferd, doch diese schlaegt nur "
          "einmal mit dem Schwanz und gewinnt so wieder Abstand. Scheinbar "
          "ist "+TPP(WER)+" ihm zu schwer."));
        tell_room(ENV(TP),BS(
          TP->Name()+" naehert sich dem Seepferd, doch diese schlaegt nur "
          "einmal mit dem Schwanz und gewinnt so wieder Abstand. Scheinbar "
          "ist "+TPP(WER)+" ihm zu schwer."),({TP}));
        tell_object(TP,BS(
         "Du naeherst Dich dem Seepferd, doch es schlaegt nur einmal mit dem "
         "Schwanz und gewinnt so genug Abstand zu Dir. Scheinbar bist Du ihm "
         "zu schwer."));
        return 1;
      }
      tell_object(TP,BS(
        "Vorsichtig naeherst Du Dich dem Seepferd. Als es keine Anstalten "
        "macht wegzuschwimmen oder Dich anzugreifen, schwingst Du Dich mit einem "
        "grossen Satz auf seinen Ruecken."));
      tell_room(ENV(TP),BS(
        TP->Name()+" naehert sich vorsichtig dem Seepferd und schwingt sich "
        "dann auf dessen Ruecken."),({TP}));
      tell_room(ME,BS(
        TP->Name()+" schwingt sich zu Dir auf das Seepferd."));
      if (TP->move(TO, M_GO|M_SILENT))
        return 1;
      tell_object(TP,BS(
        "...und rutschst auf der anderen Seite wieder hinab. Hm. Was hast "
        "Du jetzt wohl falsch gemacht?"));
      tell_room(ENV(TP),BS(
        "...und rutscht gleich wieder auf der anderen Seite herunter. Was "
        "sollte das bloss fuer ein Kunststueck sein?"),({TP}));
      tell_room(ME,BS(
        "...und rutscht gleich wieder auf der anderen Seite herunter. Was "
        "sollte das bloss fuer ein Kunststueck sein?"));
      return 0;
    }               
  }
  return 0;
}

varargs int PreventInsert(object ob) 
{
  if (!query_once_interactive(ob))
  {
    write("Du kannst auf dem Seepferd nichts ablegen.\n");
    return 1;
  }
  return ::PreventInsert(ob);
}

travel(string dest)
{
  string sequence,filename;
  
  filename=SEQ"/"+FILE_NAMES[file_name(MENV)]+dest+".seq";
  if ((DOCKED)&&(0<file_size(filename)))
    sequence=read_file(filename);
  else
    sequence=read_file(SEQ"/home"+dest+".seq");
  call_out("call_event",2,sequence);  
  return;
}

call_event(string sequence)
{
  string event,args,line,dummy;
  int time,prob;
  
  do
  {
    if (1>sscanf(sequence,"%s\n%s",line,sequence))
    {  
      if (""==sequence)
        return;
      line=sequence;
      sequence="";
    }
    line=explode(line,"#")[0];
  }
  while (4!=sscanf(line,"%d:%d:%s %s",time,prob,event,args));
  if (2!=sscanf(args,"<%s>%s",args,dummy))
  { 
    do
    {
      if(1>sscanf(sequence,"%s\n%s",line,sequence))
        return;
      args+=explode(line,"#")[0];
    }  
    while (2!=sscanf(args,"<%s>%s",args,dummy));
  }
  if (random(100)<prob)
    events(event,args);
  call_out("call_event",time,sequence);
  return;
}

events(string event,mixed args)
{
  switch (event)
  {
    case CHANGEROOM:
        changeroom(args);
      break;
    case CHANGETEMP:
        changetemp(args);
      break;
    case MESSAGE:
      message(args);
      break;
    case SPECIALEVENT:
      specialevent(args);
      break;
    /*case "":
      break;
    case "":
      break;*/
    default:
      break;
  }
}

specialevent(string event)
{
  switch (event)
  {
    case "":
      //funcall
      break;
    default:
      message("Nix besonderes passiert. Das ist schon etwas seltsam, "
              "vielleicht benachrichtigst Du einmal Cirion.");
      break;
  }
}

changeroom(string dest)
{
  string dummy;
  
  if (sscanf(dest,"/%s",dummy)==1)
  {
    TO->move(dest,M_NOCHECK|M_SILENT);
    tell_room(dest,BS(
      "Ein grosses, gruenblaues Seepferd kommt elegant hereingeschwommen."));
  }
  else
  {
    TO->move(ROOM"/"+dest,M_NOCHECK|M_SILENT);
    tell_room(ROOM"/"+dest,BS(
      "Ein grosses, gruenblaues Seepferd kommt elegant hereingeschwommen."));
  }
  return;
}

changetemp(string args)
{
  int temp;
  
  temp=to_int(args);
  if (!intp(temp)) return;
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:temp]));
  switch (temp)
  {
    case -50..-25:
      message("Es wird so kalt, dass Dir beinah auf der Stelle alle "
              "Gliedmassen einfrieren.");
      break;              
    case -24..-10:
      message("Es wird verdammt kalt, Du kannst Dir kaum vorstellen, noch "
              "sehr lange in dieser Kaelte zu sein.");
      break;
    case -9..-2:
      message("Es wird empfindlich kalt, als das Seepferd durch eine seltsame, "
              "unterseeische Stroemung schwimmt.");
      break;
    case -1..5:
      message("Das Wasser um Dich herum wird ziemlich kalt.");
      break;
    case 6..12:
      message("Das Wasser wird recht kuehl, das ist auf Dauer sicher nicht "
              "angenehm.");
      break;
    case 13..20:
      message("Das Wasser wird lauwarm und angenehm.");
      break;
    case 21..30:
      message("Das Seepferd muss in eine tropische Stroemung geschwommen sein, "
              "denn das Wasser um Dich herum ist herrlich warm.");
      break;
    case 31..50:
      message("Das Wasser um Dich herum wird so warm, dass es kaum noch "
              "auszuhalten ist.");
      break;
    default:
      message("Das Wasser nimmt eine sehr ungewoehliche Temperatur an.");
      break;
  }
}

message(string msg)
{  
  if (msg=="random")
    msg=RANDOM_MESSAGES[random(sizeof(RANDOM_MESSAGES))];
  if (msg=="env")
  {
    string env;
    sscanf(file_name(MENV),"/d/wasser/cirion/seepferde/room/%s",env);
    msg=ENV_MESSAGES[env][random(sizeof(ENV_MESSAGES[env]))];
  }
  tell_room(TO,break_string("\n"+msg,78,0,BS_LEAVE_MY_LFS));
  return;
}