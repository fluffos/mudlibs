#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/seepferde/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Ein Unterwasserfelsspalte");
  SetProp (P_INT_LONG,
    "Das Seepferd schwimmt durch eine schmale Felsspalte mit steilen, "
    "hohen Waenden. Es ist fast stockdunkel hier, Du kannst kaum etwas "
    "erkennen, weder den Boden der Spalte noch den oberen Rand der "
    "Felswaende. Das einzige was Du siehst, ist ab und zu ein Tiefseefisch "
    "und ganz oben in der Hoehe ein wenig Helligkeit.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("raus", "./riffd3-1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
