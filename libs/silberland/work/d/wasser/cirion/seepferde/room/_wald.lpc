#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/seepferde/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Ein Unterwasserwald");
  SetProp (P_INT_LONG,
    "Der Ritt fuehrt mitten durch einen dunklen Unterwasserwald. "+
    "Gruenblaue Baeume rasen an Dir vorbei, dazwischen siehst Du immer "+
    "wieder andere Wasserpflanzen. Einige der Pflanzen bluehen. Hier im "+
    "Wald leben auch die verschiedensten Fische und andere Wassertiere. "+
    "Doch die meisten sind scheu, und kommen Dir und Deinem Reittier "+
    "nicht zu nahe.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("raus", "./riffd3-1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
