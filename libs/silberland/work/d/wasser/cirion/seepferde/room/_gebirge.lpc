#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/seepferde/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Ein Unterwassergebirge");
  SetProp (P_INT_LONG,
    "Das Seepferd schwimmt durch ein riesiges Unterwassergebirge. Links "
    "und rechts von Dir erheben sich hohe Berge, teils mit selsamen "
    "Wasserpflanzen bewachsen und teils kahl, immer wieder siehst Du "
    "einzelne, grosse Fische oder ganze Fischschwaerme, die hier unten "
    "leben.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("raus", "./riffd3-1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
