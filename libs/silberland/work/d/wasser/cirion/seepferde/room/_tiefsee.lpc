#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/seepferde/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Tiefes Meer");
  SetProp (P_INT_LONG,
    "Rund um Dich herum siehst Du nur tiefblaues Meer, soweit Dein Auge "
    "reicht. Nach oben hin wird es etwas heller, nach unten hin immer "
    "dunkler bis hin zu tiefem Schwarz.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail("schwarz","Dort unten ist es einfach stockdunkel.");
  AddDetail("meer","Das ist ueberall um Dich herum.");
  AddDetail ( ({"himmel"}),
    "Den Himmel kannst Du von hier aus nicht sehen, ueber Dir ist nur "+
    "Wasser. Allerdings wird es nach oben hin etwas heller, denn in dieser "+
    "Richtung muss ja die Wasseroberflaeche liegen.");
  AddDetail ( ({"meerwasser", "wasser"}),
    "Das Meerwasser ist ueberall um Dich herum. Tiefblau erstreckt es sich "+
    "in alle Richtungen, nur nach unten hin wird es schwarz, und nach oben "+
    "hin bloss ein wenig heller.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Oberflaeche muss wohl irgendwo da oben sein, erkennen kannst Du "+
    "allerdings nur, dass es nach oben hin etwas heller wird.");
  AddDetail ( ({"auge"}),
    "Ja, sowas hast Du tatsaechlich.");
  AddDetail ( ({"boden"}),
    "Als Du nach unten schaust, siehst Du nicht mehr als absolute "+
    "Dunkelheit. Der Boden ist nicht zu erkennen.");
  AddDetail ( ({"dunkelheit"}),
    "Es ist so dunkel in der Tiefe, dass das Wasser voellig Schwarz "+
    "erscheint.");
  AddDetail ( ({"tiefe"}),
    "Du wirst Dich sicher in einiger Tiefe befinden, aber unter Dir geht "+
    "es noch wesentlich tiefer hinab, so dass Du den Boden nicht erkennen "+
    "kannst.");
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  // ITEMS END

}
