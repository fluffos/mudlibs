#include "../seepferde.h"

inherit WROOM"/wroom";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Ein Wachraum unter Wasser");
  SetProp (P_INT_LONG,
    "Du findest Dich in einem zwar recht pragmatisch aber doch elegant "+
    "eingerichteten Wachraum wieder. An der dem Eingang "+
    "gegenueberliegenden Ostwand befindet sich etwas, dass wie ein Ofen "+
    "aussieht und daneben einige Schraenke, an der Suedwand steht ein "+
    "Tisch, waehrend in der Nord- und Westwand Fensteroeffnungen "+
    "eingelassen sind. Neben der Tueroeffnung steht an der Westwand noch "+
    "ein Waffenstaender, der allerdings leer ist.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Der Boden ist mit sechseckigen, dunkelblauen Steinplatten belegt, die "+
    "fugenlos aneinanderstossen.");
  AddDetail ( ({"decke"}),
    "Die Decke besteht aus einfachem Felsgestein, ist allerdings voellig "+
    "glatt geschliffen und weist keinerlei Unebenheit auf.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende bestehen, wie die Decke aus einfachem grauen Felsgestein. "+
    "Rund um den Raum ist allerdings ungefaehr auf halber Hoehe ein sanft "+
    "blaeulich schimmerndes Runenband in das Gestein eingelegt, welches "+
    "fuer Licht hier drinnen sorgt. An der Ost- und Suedwand stehen "+
    "verschiedene Moebel.");
  AddDetail ( ({"felsgestein", "gestein"}),
    "Die Waende und die Decke bestehen aus einfachem, grauen Felsgestein, "+
    "welches so glatt poliert ist, dass man keine einzige Unebenheit daran "+
    "erkennen kann.");
  AddDetail ( ({"unebenheit", "unebenheiten"}),
    "Du kannst weder an den Waenden noch an der Decke eine Unebenheit "+
    "erkennen.");
  AddDetail ( ({"suedwand"}),
    "An der Suedwand steht ein steinerner Tisch.");
  AddDetail ( ({"ostwand"}),
    "An der Ostwand ist etwas, das wie ein Ofen aussieht, daneben stehen "+
    "einige Schraenke.");
  AddDetail ( ({"nordwand"}),
    "Die Nordwand ist bis auf zwei recht grosse Fenster kahl.");
  AddDetail ( ({"westwand"}),
    "In der Mitte der Westwand ist eine ungefaehr zweieinhalb Meter hohe "+
    "Tueroeffnung, daneben steht ein leerer Waffenstaender. Rechts und "+
    "links der Tuer sind zwei kleinere Fenster.");
  AddDetail ( ({"eingang", "tuer", "tueroeffnung"}),
    "In der westwand befindet sich die etwa zweieinhalb Meter hohe "+
    "Tueroeffnung, durch die Du auch hereingekommen bist. Von aussen sieht "+
    "sie fast aus, wie eine natuerlich entstandene Hoehle, von innen aber "+
    "ist sie so exakt gearbeitet, dass sie unmoeglich natuerlichen "+
    "Ursprungs sein kann.");
  AddDetail ( ({"ursprung"}),
    "Dieser Raum ist sicher nicht natuerlichen Ursprungs, vielmehr ist er "+
    "das Ergebnis harter und praeziser, kunstfertiger Arbeit.");
  AddDetail ( ({"arbeit", "ergebnis"}),
    "Ja, um zu einem solchen Ergebnis zu kommen, bedarf es schon harter "+
    "Arbeit.");
  AddDetail ( ({"oeffnung", "oeffnungen"}),
    "Welche Oeffnung meinst Du, die Tuer- oder die Fensteroeffnungen?");
  AddDetail ( ({"fenster", "fensteroeffnung", "fensteroeffnungen"}),
    "Die Fensteroeffnungen in der Westwand sind recht klein, allerdings "+
    "hat man durch die Fenster in der Nordwand einen fantastischen Ausblick "+
    "auf das offene Meer.");
  AddDetail ( ({"hoehe"}),
    "Das Runenband befindet sich etwa auf halber Hoehe des Raumes.");
  AddDetail ( ({"bezeichnung", "hoehle"}),
    "Naja, eigentlich ist Hoehle eine falsche Bezeichnung fuer diesen Raum.");
  AddDetail ( ({"runenband"}),
    "Das Runenband verlaeuft rund um den Raum etwa auf halber Hoehe der "+
    "Waende. Es scheint aus einem blaeulich leuchtenden Metall zu sein, und "+
    "sorgt im ganzen Raum fuer ein angenehmes, blaues Licht.");
  AddDetail ( ({"licht"}),
    "Ein sanftes, blaues Licht erhellt den ganzen Raum.");
  AddDetail ( ({"ofen","steinofen"}),
    "An der Ostwand steht so etwas aehnliches wie ein grosser Steinofen. "+
    "Allerdings kannst Du weder ein Feuer noch sonst eine Waermequelle "+
    "ausmachen, trotzdem strahlt der Ofen eine angenehme Waerme ab.");
  AddDetail ( ({"feuer"}),
    "Du kannst am oder im Ofen kein Feuer erkennen, was nicht weiter "+
    "verwunderlich ist, schliesslich befindet sich alles hier im Wasser. "+
    "Was allerdings wohl verwunderlich ist, ist dass der Ofen trotzdem eine "+
    "angenehme Waerme abstrahlt.");
  AddDetail ( ({"waermequelle"}),
    "Du kannst weder ein Feuer noch eine andere Waermequelle am Ofen "+
    "entdecken. Trotzdem strahlt er eine angenehme Waerme ab.");
  AddDetail ( ({"waerme"}),
    "Hier drinnen ist es wesentlich waermer als draussen, denn der Ofen "+
    "heizt den Raum auf seltsame Weise auf.");
  AddDetail ( ({"weise"}),
    "Du kannst nicht erkennen, wie der Ofen funktioniert.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("westen", ROOM"/riffd3-1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
