#include "../seepferde.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Ein kleiner Platz unter Wasser");
  SetProp (P_INT_LONG,
    "Hier ist ein kleiner Platz, der idyllisch zwischen Baeumen im Westen "+
    "und Wiesen im Osten liegt. Im Nordosten liegt ein kleines Haus, "+
    "waehrend nach Westen ein schmaler Weg zwischen den Baeumen durch auf "+
    "eine breite Allee fuehrt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist hier nicht zu sehen, dafuer bist Du viel zu tief unter "+
    "Wasser. Statt dessen kannst Du erkennen, dass es nach oben hin immer "+
    "heller wird.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist ueberall um Dich herum. Es ist hier recht hell, "+
    "dennoch wird es in kurzer Entfernung deutlich dunkler. Von oben faellt "+
    "das Licht durch das Wasser herab.");
  AddDetail ( ({"licht"}),
    "Das Licht kommt von oben, von der nicht sichtbaren Wasseroberflaeche "+
    "herab.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche kannst Du von hier unten nicht erkennen, nur "+
    "die Helligkeit, die von dort oben kommt.");
  AddDetail ( ({"helligkeit"}),
    "Die Helligkeit kommt von oben, von der Wasseroberflaeche.");
  AddDetail ( ({"entfernung"}),
    "Du kannst nicht allzu weit sehen, vielleicht einige hundert Meter, "+
    "dann wird es immer dunkler.");
  AddDetail ( ({"meter", "schritt"}),
    "Ein Meter, das ist ungefaehr ein Schritt.");
  AddDetail ( ({"boden", "platz"}),
    "Der Boden hier ist ein kleiner Platz, der mit weissen, sechseckigen "+
    "Steinplatten geflastert ist. Der Rand des Platzes ist rundum mit "+
    "wundervollen Ornamenten verziert, und ein kleiner gepflasterter Weg "+
    "fuehrt weiter nach Westen.");
  AddDetail ( ({"weg"}),
    "Der Weg, welcher nach Westen fuehrt, ist mit den gleichen "+
    "sechseckigen Platten belegt, wie der ganze Platz, und auch er hat am "+
    "Rand ein Band mit wundervollen Ornamenten.");
  AddDetail ( ({"wiesen"}),
    "Weite Wiesen aus Seegras erstrecken sich nach Osten und Sueden bis "+
    "zum Wald. Dazwischen wachsen die unterschiedlichsten Blumen und auch "+
    "andere Wasserpflanzen.");
  AddDetail ( ({"bluete", "blueten", "blume", 
                "blumen"}),
    "Viele unterschiedliche Blumen mit wunderschoenen, bunten Bluten "+
    "wachsen ueberall auf der Wiese.");
  AddDetail ( ({"gras", "seegras"}),
    "Das Seegras ist eine Wasserpflanze, die dem Gras ueber Wasser sehr "+
    "aehnlich ist.");
  AddDetail ( ({"platten", "steinplatten"}),
    "Sechseckige, weisse Steinplatten bilden diesen kleinen Platz hier. "+
    "Sie haben eine voellig glatte Oberflaeche und sind do exakt gefertigt, "+
    "dass zwischen ihnen keine einzige Ritze zu sehen ist.");
  AddDetail ( ({"fuge", "fugen", "ritze", 
                "ritzen"}),
    "Du kannst weder Ritzen noch Fugen zwischen den Steinplatten erkennen.");
  AddDetail ( ({"band", "rand"}),
    "Am Rand des Platzes und der Wege ist ein schmales Band mit "+
    "wundervollen, blauen, gruenen und silbernen Ornamenten eingelegt.");
  AddDetail ( ({"wald"}),
    "Weiter im Sueden kannst du einen Wald von Wasserpflanzen erkennen.");
  AddDetail ( ({"haus"}),
    "Das Haus im Nordosten liegt ein wenig geschuetzt zwischen "+
    "verschiedenen Wasserpflanzen.");
  AddDetail ( ({"allee"}),
    "Im Westen scheint eine Allee zu sein, dort fuehrt ein kleiner Weg "+
    "hin.");
  AddDetail ( ({"ornamente", "ornamenten"}),
    "Wunderschoene, gruene, blaue und Silberne Ornamente sind in den Rand "+
    "des Platzes und des Weges eingelegt. Sie scheinen aus einem silbrigen "+
    "Metall und aus Kristall zu sein, und sie strahlen ein sanftes, "+
    "gruenlichblaues Licht aus.");
  AddDetail ( ({"metall"}),
    "Ein seltsames, silbriges Metall, welches ein klein wenig zu leuchten "+
    "scheint.");
  AddDetail ( ({"kristall"}),
    "Ein harter, glasaehnlicher Kristall. Aus ihm sind grosse Teile der "+
    "Ornamente auf dem Boden gefertigt, und er schimmert ein wenig.");
  AddDetail ( ({"teile"}),
    "Die farbigen Teile der Ornamente sind aus diesem seltsamen Kristall.");
  AddDetail ( ({"pflanze", "pflanzen", "wasserpflanze", 
                "wasserpflanzen"}),
    "Hier unten wachsen die unterschiedlichsten Wasserpflanzen: Grosse, "+
    "baumaehnliche, Seegraeser, buschaehnliche und auch Blumen.");
  AddDetail ( ({"baeume", "baum"}),
    "Baeume siehst Du im Sueden im Wald, im Westen an der Allee und im "+
    "Nordosten, rund um das Haus.");
  // DETAILS END

  // EXITS START
  AddExit ("westen", "/d/wasser/cirion/earost/room/rmhm");
  AddExit ("nordosten", "/d/wasser/cirion/seepferde/room/earost_rmio");
  // EXITS END

  // ITEMS START
  AddItem(SEEPFERD,REFRESH_NONE);
  AddItem(SEEPFERD,REFRESH_NONE);
  // ITEMS END

}

new_horse()
{
  if ((find_object(LOOP))&&(present(SEEPFERDID,find_object(LOOP))))
  {
    present(SEEPFERDID,find_object(LOOP))->move(TO,M_GO|M_NOCHECK);
  }
  else
  {
    clone_object(SEEPFERD)->move(TO,M_GO|M_NOCHECK);
  }
  return;
}

ident(object ob)
{
  return ob->id(SEEPFERDID);
}

init()
{
  object *seepferde;
  int i;
  
  ::init();
  seepferde=filter_array(all_inventory(TO), #'ident);
  if (sizeof(seepferde)<2)
  {
    if (-1==find_call_out("new_horse"))
      call_out("new_horse",random(40)+40);
  }
  if (sizeof(seepferde)>4)
  {
    for (i=sizeof(seepferde)-1;i>0;i--)
    {
      if (0==sizeof(filter_array(all_inventory(seepferde[i]), #'living)))
      {
        seepferde[i]->move(LOOP,M_GO|M_NOCHECK);
        i=0;
      }
    }
  }
}
