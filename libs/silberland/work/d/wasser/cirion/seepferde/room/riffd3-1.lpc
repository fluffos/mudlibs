#include "../seepferde.h"

inherit WROOM"/wroom";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "An einem Futterplatz unter Wasser");
  SetProp (P_INT_LONG,
    "Hier endet der Weg an einer Art grosser Futterkrippe. Nach Norden "+
    "hin faellt der Meeresgrund steil ab und verschwindet bald im Dunkel "+
    "der Tiefe, im Osten ist ein grosser Felsen zu den, in den ein "+
    "kleiner Hoehleneingang fuehrt. Nach Suedosten geht der schmale Weg "+
    "zurueck zum Korallenriff.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist von hier unten nicht zu sehen, nur die "+
    "Wasseroberflaeche einige Meter ueber Dir.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche liegt einige Meter ueber Dir. Kuehles blaues "+
    "Licht faellt von dort herab und taucht die ganze Umgebung in eine "+
    "seltsame Atmosphaere.");
  AddDetail ( ({"futterkrippe", "gebilde", "krippe"}),
    "Das Gebilde, welches neben dem grossen Felsen steht, scheint aus "+
    "einer seltsamen Art Holz zu sein und aehnelt wirklich einer "+
    "Futterkrippe. Es ist mit grasaehnlichen Wasserpflanzen gefuellt.");
  AddDetail ( ({"boden", "grund", "meeresboden",
                "meeresgrund"}),
    "Der Bewuchs des Meeresbodens wird weniger, je tiefer Du kommst. "+
    "Ausserdem geht der Boden immer mehr von Korallen zu Felsen und Sand "+
    "ueber.");
  AddDetail ( ({"felsbrocken"}),
    "Im Osten liegt ein mehr als mannshoher Felsbrocken, in den ein "+
    "kleiner Hoehleneingang fuehrt. Als Du genauer hinsiehst, kannst Du "+
    "auch zwei Fenster erkennen, fast scheint es so, als wuerde in dem "+
    "Felsbrocken jemand wohnen.");
  AddDetail ( ({"atmosphaere", "licht"}),
    "Das Licht, welches von der Wasseroberflaeche herabfaellt ist kuehl "+
    "und blauelich und taucht die ganze Umgebung in eine seltsam "+
    "unwirkliche Atmosphaere.");
  AddDetail ( ({"umgebung"}),
    "Die gante Umgebung ist mit seltsamen Wasserpflanzen bewachsen und "+
    "wird vom Licht in eine seltsam unwirkliche Atmosphaere getaucht.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Obwohl spaerlicher als im flacheren Wasser, ist die Umgebung doch "+
    "reichlich mit seltsamen Wasserpflanzen bewachsen.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Korallenriff erhebt sich suedlich von hier bis fast zur "+
    "Wasseroberflaeche hinauf.");
  AddDetail ( ({"bewuchs"}),
    "Der Bewuchs ist zwar spaerlicher als weiter oben, aber es sind immer "+
    "noch viele Wasserpflanzen zu sehen.");
  AddDetail ( ({"holz"}),
    "Eine seltsame Art Holz, es scheint unter Wasser gewachsen zu sein.");
  AddDetail ( ({"felsen", "sand"}),
    "Der Boden wird immer felsiger, und zwischen den Felsen liegt immer "+
    "mehr Sand.");
  AddDetail ( ({"wasser"}),
    "Da Wasser rund um Dich herum scheint blaeulich gefaerbt zu sein. Es "+
    "wird immer kuehler, je tiefer man kommt.");
  AddDetail ( ({"weg"}),
    "Der Weg endet hier an der Futterkrippe. Nach Suedosten steigt er zum "+
    "Riff hin an.");
  AddDetail ( ({"dunkel", "tiefe"}),
    "Der Meeresgrund verschwindet im Norden schnell im Dunkel der Tiefe. "+
    "Es scheint hier ziemlich steil nach unten zu gehen, daher scheint es "+
    "nicht sehr sinnvoll, dort hinunterzutauchen.");
  AddDetail ( ({"eingang", "hoehleneingang"}),
    "Der Eingang fuehrt ins Innere des Felsens, welcher bewohnt zu sein "+
    "scheint.");
  AddDetail ( ({"fenster"}),
    "Zwei kleine Fenster zieren den Felsbrocken. Sicherlich ist da drinnen "+
    "eine Wohnung, allerdings keine sehr grosse.");
  AddDetail ( ({"inneres", "wohnung"}),
    "Um das zu untersuchen, wirst Du schon nach drinnen gehen muessen.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("suedostoben", ROOM"/riffe4-1");
  AddHiddenWaterExit ("suedosten", "nach Suedostoben#"ROOM"/riffe4-1");
  AddWaterExit ("osten", ROOM"/riffd4-1");
  // EXITS END

  // ITEMS START
//  AddItem(SEEPFERD,REFRESH_NONE);
  AddItem(NPC"/meeresskorpion",REFRESH_DESTRUCT);
  // ITEMS END

}
