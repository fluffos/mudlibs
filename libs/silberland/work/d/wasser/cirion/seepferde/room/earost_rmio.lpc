#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/seepferde/npc/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "Vor einem kleinen Haus unter Wasser");
  SetProp (P_INT_LONG,
    "uhr Der schmale Weg fuehrt genau auf ein kleines Haus zu. Scheinbar "+
    "sind hier auch die Stallungen der Seepferde, denn seitlich fuehrt "+
    "ein grosses Tor in den Suedfluegel des Hauses. Rund um das Haus "+
    "wachsen die verschiedensten Wasserpflanzen und Baeume.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("suedwesten", "/d/wasser/cirion/seepferde/room/earost_rmhn");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
