#include "../seepferde.h"

inherit WROOM"/wroom";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf einem Weg unter Wasser");
  SetProp (P_INT_LONG,
    "Der Weg macht hier einen leichte Biegung nach Nordwesten. Rechts und "+
    "links des Weges wachsen grosse Wasserpflanzen. Dazwischen leben die "+
    "unterschiedlichsten Tiere. Das etwas schummrige, blaeuliche Licht "+
    "von der Wasseroberflaeche taucht die ganze Gegend in eine seltsame "+
    "Atmosphaere. Noerdlich von hier kannst Du eine Erhebung auf dem "+
    "Meeresgrund erkennen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist hier nicht zu sehen, man kann ihn hoechstens aufgrund "+
    "der blauen Farbe der Wasseroberflaeche erahnen.");
  AddDetail ( ({"farbe"}),
    "Von hier unten sieht die Wasseroberflaeche hellblau aus.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche ist wegen der vom offenen Meer heranrollenden "+
    "Wellen recht unruhig. Blaeuliches Licht faellt von ihr herab und "+
    "taucht die ganze Umgebung in eine seltsame Atmosphaere.");
  AddDetail ( ({"atmosphaere", "licht"}),
    "uhr Das blaeuliche Licht, welches von der Wasseroberflaeche "+
    "herabfaellt, taucht die ganze Umgebung in eine seltsame Atmosphaere.");
  AddDetail ( ({"welle", "wellen"}),
    "Immer wieder rollen an der Wasseroberflaeche grosse Wellen auf das "+
    "Riff zu und brechen sich daran. Hier unten ist davon allerdings wenig "+
    "zu spueren.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Riff erstreckt sich wie eine grosse Mauer von Ost nach West, so "+
    "weit Du sehen kannst.");
  AddDetail ( ({"mauer"}),
    "Naja, eigentlich ist der Vergleich mit der Mauer schon etwas weit "+
    "hergeholt, denn das Riff ist sehr unregelmaessig geformt. Aber es ist "+
    "so unueberwindlich wie eine Mauer.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist ziemlich klar und scheint tiefblau zu sein, was wohl "+
    "am Licht hier unten liegt. Je tiefer man kommt, desto kaelter wird es.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Auf dem Meeresboden wachsen die verschiedensten Wasserpflanzen, die "+
    "sich leicht in der Stroemung wiegen. Ein schmaler, weniger bewachsener "+
    "Weg scheint nach Nordwesten in die Tiefe zu fuehren.");
  AddDetail ( ({"biegung", "weg"}),
    "Der schmale Weg macht hier eine leichte Biegung und fuehrt weiter "+
    "nach Nordwesten in die Tiefe.");
  AddDetail ( ({"stroemung"}),
    "Eine leichte Stroemung verlaeuft hier von West nach Ost.");
  AddDetail ( ({"umgebung"}),
    "Die Umgebung ist in ein seltsames blaeuliches Licht getaucht.");
  AddDetail ( ({"meer"}),
    "Das Meer erstreckt sich weit nach Norden.");
  AddDetail ( ({"erhebung", "felsen"}),
    "Noerdlich von hier ist eine mehr als mannshohe Erhebung zu erkennen, "+
    "es koennte sich wohl um einen grossen Felsen handeln.");
  AddDetail ( ({"lebensraum", "tier", "tiere"}),
    "Zwischen den Wasserpflanzen tummeln sich die verschiedensten Tiere: "+
    "Fische, Krabben, Seesterne und auch andere Tiere haben hier ihren "+
    "Lebensraum.");
  AddDetail ( ({"fisch", "fische"}),
    "Hier schwimmen die unterschiedlichsten Fische herum.");
  AddDetail ( ({"krabbe", "krabben", "seestern", 
                "seesterne"}),
    "Auch Krabben und Seesterne leben hier zwischen den Wasserpflanzen.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Grosse, seltsame Wasserpflanzen wachsen hier ueberall auf dem Boden. "+
    "Nur auf dem Weg ist der Bewuchs etwas weniger. Zwischen den Pflanzen "+
    "leben die verschiedensten Tiere.");
  AddDetail ( ({"bewuchs"}),
    "Der Bewuchs ist auf dem Weg am spaerlichsten.");
  AddDetail ( ({"gegend"}),
    "-> umgebung");
  AddDetail ( ({"tiefe"}),
    "In der Tiefe wird es immer dunkler.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("ostoben", ROOM"/riffe5-1");
  AddHiddenWaterExit("osten","nach Ostoben#"ROOM"/riffe5-1");
  AddWaterExit ("nordwestunten", ROOM"/riffd3-1");
  AddHiddenWaterExit ("nordwesten", "nach Nordwestoben#"ROOM"/riffd3-1");
  // EXITS END

  // ITEMS START
  AddItem(NPC"/meeresskorpion",REFRESH_DESTRUCT);
  // ITEMS END

}
