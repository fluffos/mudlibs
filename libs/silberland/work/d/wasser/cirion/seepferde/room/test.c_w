#include "../seepferde.h"

inherit WROOM"/wroom"

/* MP-HEADER - DO NOT MODIFY ANYTHING BEFORE THE #include STATEMENTS!!
** riffe5.c  [created using mpen v0.93 (16 Feb 97)]
** Letzte Aenderung: Don, 27. Mai 1999, 15:15:49 von Cirion
** ---
** 27. Mai 1999  Raum von Cirion angelegt. [mp]
** 27. Mai 1999  neue(s) Detail(s) von Cirion. [mp]
** 27. Mai 1999  Ausgang 'unten' angeschlossen von Cirion. [mp]
** ---
** details: 39, read det: 0, special det: 0, sounds: 2, smells: 0, exits: 2.
*/


#ifndef ROOM
#define ROOM(x) ("/d/wasser/cirion/seepferdchen/room/"+x)
#endif

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du schwimmst hier im nach Westen immer tiefer werdenden Wasser "+
    "noerdlich des Korallenriffs. Weit von Ost nach West erstreckt sich "+
    "das Riff, waehrend im Norden das weite, offene Meer liegt. Immer "+
    "wieder rollen von dort grosse Wellen heran und brechen sich am Riff.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist strahlend blau, weit und breit ist kein Woelkchen zu "+
    "sehen. Die Sonne scheint warm und kraeftig herab und laesst die "+
    "Wasseroberflaeche glitzern.");
  AddDetail ( ({"sonne", "sonnenstrahlen", "strahlen"}),
    "Die Sonnenstrahlen fallen auf die Wasseroberflaeche und lassen sie "+
    "glitzern, und auf Deiner Haut erzeugen sie ein warmes, angenehmes "+
    "Gefuehl.");
  AddDetail ( ({"haut"}),
    "Deine haut fuehlt sich in der Sonne angenehm warm an.");
  AddDetail ( ({"gefuehl"}),
    "Das Gefuehl, das die Sonnenstrahlen auf Deiner Haut hinterlassen ist "+
    "warm und angenehm.");
  AddDetail ( ({"woelkchen", "wolke", "wolken"}),
    "Weit und breit ist keine einzige Wolke zu sehen.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Der Meeresboden sinkt nach Westen hin leicht ab, es sieht fast so "+
    "aus, als wuerde hier ein Weg in die Tiefe fuehren. Unten schwimmen "+
    "einige Fische und auch andere Meeresbewohner zwischen den "+
    "Wasserpflanzen herum.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche glitzert silbirg im Licht der Sonne.");
  AddDetail ( ({"licht"}),
    "Das Licht glitzert silbirg auf der Wasseroberflaeche.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Die Wasserpflanzen auf dem Grund des Riffs scheinen fast eine Art weg "+
    "zu umsaeumen, der nach Westen hin in die Tiefe fuehrt.");
  AddDetail ( ({"bewohner", "fische", "meeresbewohner"}),
    "Fisch, Krabben, Seesterne und andere Meeresbewohner leben unten am "+
    "Grund des Riffes zwischen den Pflanzen.");
  AddDetail ( ({"krabbe", "krabben", "seestern", 
                "seesterne"}),
    "Auich Seesterne und Krabben leben hier am Riff.");
  AddDetail ( ({"wasser"}),
    "Das Wasser hier ist dunkelblau, klar, und weder besonders kalt noch "+
    "besonders warm.");
  AddDetail ( ({"welle", "wellen"}),
    "Welle um Welle rollt vom offenen Meer heran und bricht sich am Riff "+
    "mit einem lauten Rauschen.");
  AddSound ( ({DEFAULT_SOUND, "rauschen"}),
    "Ein lautet Rauschen erfuellt Deine Ohren, aber es ist nicht "+
    "unangenehm, eher beruhigend, obwohl es doch die Macht der Natur und "+
    "des Meeres in sich traegt.");
  AddDetail ( ({"ohr", "ohren"}),
    "Du hast davon wahrscheinlich zwei.");
  AddDetail ( ({"horizont", "meer"}),
    "Das weite, offene Meer erstreckt sich bis zum Horizont, wo es mit dem "+
    "blauen Himmel zu verschmilzen scheint.");
  AddDetail ( ({"macht", "natur", "naturmacht"}),
    "Die Macht der Natur ist in den heranrollenden Wellen deutlich zu "+
    "spueren.");
  AddDetail ( ({"riff"}),
    "Das Riff erstreckt sich weit von Ost nach West.");
  AddDetail ( ({"korallenriff"}),
    "");
  AddDetail ( ({"tiefe", "weg"}),
    "Der Weg ist bloss dadurch gekennzeichnet, dass auf ihm weniger "+
    "Pflanzen wachsen. Er scheint nach Westen in der Tiefe zu verschwinden, "+
    "wohin er fuehrt, kannst Du nicht erkennen.");
  // DETAILS END

  // EXITS START
  AddExit ("osten", "/d/wasser/cirion/riff/room/riff15");
  AddExit ("unten", "/d/wasser/cirion/seepferde/room/riffe5-1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
