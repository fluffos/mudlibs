#include "../seepferde.h"

inherit WROOM"/wroom";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:16]));
  SetProp (P_INT_SHORT, "Auf einem Weg unter Wasser");
  SetProp (P_INT_LONG,
    "Ein schmaler Weg, gesaeumt von Wasserpflanzen fuehrt hier nach "+
    "Westen in die Tiefe und nach Osten zur Wasseroberflaeche. Rundherum "+
    "schwimmen die verschiedensten Meeresbewohner wie Fische, Krabben und "+
    "Seesterne.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist nur am blauen Schimmern der Wasseroberflaeche zu "+
    "erkennen.");
  AddDetail ( ({"schimmern"}),
    "Die Wasseroberflaeche schimmert blaeulich.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche wird von grossen Wellen beherrscht und "+
    "schimmert blaeulich.");
  AddDetail ( ({"welle", "wellen"}),
    "Die Wellen rollen vom offenen Meer heran.");
  AddDetail ( ({"meer"}),
    "Nach Norden hin oeffnet sich das offene Meer. Nach einigen Hundert "+
    "Metern kann man trotz des klaren Wassers nichts mehr erkennen.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist kuehl, aber sehr klar, und ziemlich salzig.");
  AddDetail ( ({"weg"}),
    "Der Weg fuehrt nach Westen weiter in die Dunkelheit der Tiefe. Auch "+
    "auf dem Weg wachsen einige kleine Pflanzen, allerdings die meisten "+
    "wachsen rechts und links davon.");
  AddDetail ( ({"dunkelheit", "tiefe"}),
    "In der Tiefe des Meeres ist wegen der Dunkelheit nichts zu erkennen.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Der Meeresgrund ist bewachsen mit verschiedensten Wasserpflanzen und "+
    "bevoelkert von verschiedensten Meeresbewohnern.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Viele Wasserpflanzen wachsen hier und wiegen sich sanft in der "+
    "Stroemung. Sie haben die absonderlichsten Formen, und einige von ihnen "+
    "haben auch schoene bunte Blueten.");
  AddDetail ( ({"stroemung"}),
    "Eine sanfte Stroemung verlaeuft hier unter der Oberflaeche von West "+
    "nach Ost.");
  AddDetail ( ({"bluete", "blueten"}),
    "Grosse, bunte Blueten. Sie sehen ein wenig anders aus, als die "+
    "Blueten ueber Wasser, aber vielleicht moechtest Du trotzdem eine "+
    "pfluecken.");
  AddDetail ( ({"bewohner", "meeresbewohner"}),
    "Hier unten zwischen den Pflanzen leben die verschiedensten "+
    "Meeresbewohner wie Fische, Seesterne und Krabben.");
  AddDetail ( ({"fisch", "fische"}),
    "Die unterschiedlichsten Fische tummeln sich hier im Wasser, farbige, "+
    "schwarze, einige mit seltsamen Fuehlern oder grossen Augen, andere mit "+
    "messeraehnlichen Flossen, wieder andere sind rund wie kleine Kugeln.");
  AddDetail ( ({"fuehler"}),
    "Seltsame, lange Fuehler.");
  AddDetail ( ({"auge", "augen"}),
    "Diese Fische haben ungewoehnlich grosse Augen.");
  AddDetail ( ({"flosse", "flossen"}),
    "Flossen haben alle Fische, aber einige haben besondere, "+
    "messeraehnliche Flossen.");
  AddDetail ( ({"kugel", "kugeln"}),
    "Die sehen wirklich aus wie kleine runde Kugeln.");
  AddDetail ( ({"seestern", "seesterne"}),
    "Zwischen den Pflanzen liegen auch einige Seesterne.");
  AddDetail ( ({"krabbe", "krabben", "krebs", 
                "krebse"}),
    "Auch Krabben und Krebse machen hier den Meeresgrund unsicher.");
  // DETAILS END

  // EXITS START
  AddDiveExit ("oben", "/d/wasser/cirion/seepferde/room/riffe5");
  AddWaterExit ("westunten", ROOM"/riffe4-1");
  AddHiddenWaterExit ("westen", "nach Westunten#"ROOM"/riffe4-1");
  // EXITS END

  // ITEMS START
  AddItem(NPC"/meeresskorpion",REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd ( ({"pflueck_fun", "pflueck", "pfluecke"}), "pflueck_fun");
}

int pflueck_fun (string str)
{
  notify_fail ("Was willst Du machen?\n");
  if (!str) return 0;
  // ...
  return 1;
}
