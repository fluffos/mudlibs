#include "../npcm.h"

inherit "/std/npc";
inherit SERVICE"/fun";

nosave int npc_status;
nosave mixed *next_action;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein NPC");
  SetProp(P_LONG,
    "Das ist ein einfacher NPC ohne irgendwelche Besonderheiten.");
  SetProp(P_NAME, "NPC");
  SetProp(P_GENDER, MALE);
  npc_status=0;
  next_action=({});
  NPCM->AddNPC();
}

QueryNextAction()
{
  if (sizeof(next_action))
    return next_action[0];
  return "";
}

SetNextAction(int time,mixed *action)
{
  next_action=action;
  NPCM->AddToQueue(time);
}

NextAction()
{
  switch (sizeof(next_action))
  {
    case 5:
      call_out(next_action[0],0,next_action[1],next_action[2],next_action[3],next_action[4]);
      break;
    case 4:
      call_out(next_action[0],0,next_action[1],next_action[2],next_action[3]);
      break;
    case 3:
      call_out(next_action[0],0,next_action[1],next_action[2]);
      break;
    case 2:
      call_out(next_action[0],0,next_action[1]);
      break;
    case 1:
      call_out(next_action[0],0);
      break;
    case 0:
    default:
      break;
  }
}

Register()
{
  npc_status|=(NPCM_REGISTERED);
  NPCM->AddNPC();
}

Activate()
{
  npc_status|=(NPCM_ACTIVE+NPCM_REGISTERED);
  NPCM->ActivateNPC(1);
}

DeActivate()
{
  npc_status-=(npc_status&(NPCM_ACTIVE));
  npc_status|=(NPCM_REGISTERED);
  NPCM->ActivateNPC(0);
}

UnRegister()
{
  npc_status-=(npc_status&(NPCM_ACTIVE+NPCM_REGISTERED));
  NPCM->RemoveNPC();
}

remove()
{
  if (npc_status&NPCM_REGISTERED)
    NPCM->RemoveNPC();
  ::remove();
}

int Active()
{
  return (npc_status&NPCM_ACTIVE);
}