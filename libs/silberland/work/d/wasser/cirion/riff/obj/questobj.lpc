inherit "std/thing";

#include "/d/wasser/cirion/riff/riff.h"

private int align;
/*
Align=0: Tabar is ein verkappter Nekromant.
Align=1: Tabar is wirklich der Suchende.
*/

private int steps;
/*
steps -2:Quest misslungen, noch zwei resets bis neuanfang
steps -1:Quest misslungen, noch ein reset bis neuanfang
steps 0: Quest begonnen.
steps 1: Quest fertig, Warten auf den Ueberfall
*/
private int logbuch;
private int amulett;

object tabar,enemy;

create()
{
  if (!is_clone(TO)) return;

  ::create();

  steps=0;
  logbuch=0;
  amulett=0;
  if (present(TABARID,environment(TP)))
  {
    tabar=present(TABARID,environment(TP));
    align=tabar->QueryAlign();
  }
  else if (PO||IS_WIZARD(PO))
    align=0;
  else
  {
    remove();
    if (TO)
    destruct(TO);
  }
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Questobjekt");
  SetProp(P_GENDER, 1);
  SetProp(P_ARTICLE,0);
  SetProp(P_NODROP,1);
  SetProp(P_AUTOLOADOBJ,1);
  SetProp(P_NEVERDROP,1);
  AddId(({"\nciritabarquestob"}));
}

mixed _query_autoloadobj()
{
  return ({align, steps, logbuch, amulett});
}

void _set_autoloadobj(mixed a)
{
  if (pointerp(a) && sizeof(a)==4)
  {
    align = a[0];
    steps = a[1];
    logbuch = a[2];
    amulett = a[3];
  }
}

SetVars(int a,int b,int c,int d)
{
  align=a;
  steps=b;
  logbuch=c;
  amulett=d;
}

QueryVars(string player)
{
  if (find_player(player))
  tell_object(find_player(player),
    "Variablen des Riffquestitems:\n\n"
    "Align   : "+align+"\n"
    "Steps   : "+steps+"\n"
    "Logbuch : "+logbuch+"\n"
    "Amulett : "+amulett+"\n");
}

int setsteps(int str)
{
  steps=str;
  return 1;
}

int QueryAmulett()
{
  return amulett;
}

int QueryLogbuch()
{
  return logbuch;
}

int GetAmulett()
{
  amulett=1;
  return 1;
}

int ReadLogbuch()
{
  logbuch=1;
  return 1;
}

reset()
{
  if (0>steps) steps++;

  //Revenge :)
  if (steps>0)
    steps++;

  if (steps>5)
  {
    remove();
  }
  ::reset();
}

int Querysteps()
{
  return steps;
}

int QueryAlign()
{
  return align;
}

SetEnemy(object ob)
{
  enemy=ob;
}

int tabar_give_amulett()
{
  tabar=present(TABARID,environment(TP));
  present("\ncirinekromantenamulett")->SetProp(P_NODROP,0);
  if (steps==0)
  {
    if (align==0)
    {
      if ((TP->QueryProp(P_GUILD)=="nekromanten"))
      {
      	write(BS("Du holst das Paladinamulett heraus, um es Tabar feierlich "
      	         "zu ueberreichen, als ploetzlich ein anderer, hochgewachsener "
      	         "Mann in einer schimmernden Ruestung "
      	         "hereinstuermt. Eine sichtbare Aura des Heiligen geht von "
      	         "ihm aus, und als er sieht, dass Du Tabar gerade das Amulett "
      	         "ueberreichen willst ruft er: \"Nein, das werde ich nicht "
      	         "zulassen!\", zieht sein maechtiges Schwert, und ist mit einem "
      	         "Satz bei Dir, um Dich anzugreifen."));
      	clone_object(NPC"/paladin")->move(environment(TP),M_NOCHECK);
      	present("haldin",ENV(TP))->Kill(TP);
        present("\ncirinekromantenamulett")->SetProp(P_NODROP,1);
      	return 1;
      }
      else
      {
      	write(BS("Als Du das Nekromantenamulett herausholst, laesst Tabar ein "
      	         "haessliches Lachen ertoenen, reisst es Dir aus der Hand "
      	         "und ruft: \"Nun ist die Macht mein!\" Damit dreht er sich um "
      	         "und haut gemein kichernd ab."));
      	present("\ncirinekromantenamulett",TP)->remove();
      	write(BS("Langsam wird Dir klar, dass Du die ganze Sache "
      	         "wohl ziemlich verhauen hast. Wie konntest Du "
      	         "bloss so dumm sein, einem Diener des Boesen "
      	         "einen derartigen Gegenstand zu ueberlassen??"
      	         "Es duerfte einige Zeit dauern, bis Du eine "
      	         "neue Chance erhaeltst."));
      	tabar->move(ROOM"/leerraum",M_NOCHECK|M_SILENT);
      	steps=-2;
      	return 1;
      }
    }
    if (align==1)
    {
      if (TP->QueryProp(P_GUILD)=="nekromanten")
      {
      	write(BS("Du nimmst das Paladinamulett heraus und ueberreichst es "
      	         "Tabar. Dieser bedankt sich mit einem freundlichen Laecheln "
      	         "fuer Deine Hilfe und schreitet von dannen."));
      	present("\ncirinekromantenamulett",TP)->remove();
      	write(BS("Langsam wird Dir klar, dass Du die ganze Sache "
      	         "wohl ziemlich verhauen hast. Wie konntest Du "
      	         "bloss so dumm sein, einem Diener des Guten "
      	         "das Werkzeug zur Zerstoerung der Nekromanten"
      	         "zu ueberlassen?? Es duerfte einige Zeit dauern, "
      	         "bis Du eine neue Chance erhaeltst."));
      	tabar->move(ROOM"/leerraum",M_NOCHECK|M_SILENT);
      	steps=-2;
      	return 1;
      }
      else
      {
      	write(BS("Du holst das Nekromantenamulett heraus, um es Tabar feierlich "
      	         "zu ueberreichen, als ploetzlich ein anderer, dunkelhaeutiger "
      	         "Mann hereinstuermt. Eine dunkle Aura geht von "
      	         "ihm aus, und als er sieht, dass Du Tabar gerade das Amulett "
      	         "ueberreichen willst ruft er: \"Nein, das Amulett gehoert uns "
      	         "Nekromanten!\", zieht eine schwere Keule, und ist mit einem "
      	         "Satz bei Dir, um Dich anzugreifen."));
      	clone_object(NPC"/nekromant")->move(environment(TP),M_NOCHECK);
      	present("gurnuk",ENV(TP))->Kill(TP);
        present("\ncirinekromantenamulett")->SetProp(P_NODROP,1);
      	return 1;
      }
    }
  }
  present("\ncirinekromantenamulett")->SetProp(P_NODROP,1);
  return 0;
}

int QuestDone(object player)
{
  player->GiveQuest(RIFFQUESTNAME);
  write_file("/log/quests/amulett",dtime(time())+" "+player->Name()+" hat die Quest bestanden\n");
  write_file(RIFFQUESTLOGFILE,player->Name()+" hat die Quest bestanden am "+dtime(time())+"\n");
  return 1;
}

int QuestEnde2(object enemy,object player)
{
  string enemyname;

  enemyname=enemy->Name();
  if ("nekromanten"==player->QueryProp(P_GUILD))
  {
    if (align==0)
    {
      if (enemyname=="Haldin")
      {
        tell_object(player,BS(
          "Dann drehst Du Dich zu Tabar um, um ihm wirklich das Amulett zu "
          "ueberreichen. Er reisst es Dir fast aus der Hand, brummt ein "
          "knappes: \"Du hast Deine Pflicht erfuellt.\" und verschwindet zur "
          "Tuer hinaus."));
        if (present("\ncirinekromantenamulett",player))
        {
          present("\ncirinekromantenamulett",player)->DoUnwear(1);
          present("\ncirinekromantenamulett",player)->remove();
        }
        present(TABARID,ENV(MENV))->move(ROOM"/leerraum",M_NOCHECK|M_SILENT);
        if (present("\ncirilogbuch",player))
          present("\ncirilogbuch",player)->zerfallen();
        if (IS_WIZARD(player)) tell_object(player,"Quest geschafft.\n");
        steps=1;
        QuestDone(player);
        //Quest geschafft!!!!
      }
      else
      {
        tell_object(player,BS(
          "Langsam wird Dir klar, dass das gerade ziemlich dumm war. Wie "
          "konntest Du nur einen Deiner Mitnekromanten angreifen? Deine naechste "
          "Chance wird wohl einiges auf sich warten lassen."));
        steps=-2;
        //Quest nicht geschafft.
      }
    }
    else
    {
    tell_object(player,BS(
      "Zufrieden, den laecherlichen Diener des Guten vertrieben zu haben, "
      "wendest Du Dich vom Fenster ab, als Du ploetzlich bemerkst, dass das "
      "Amulett verschwunden ist. Dieser elende Kerl muss es Dir in einem "
      "hektischen Augenblick des Kampfes entwendet haben! Du fluchst "
      "ungehemmt. Naja, jetzt kannst Du es auch nicht mehr aendern, Du hast "
      "Dein moeglichstes getan."));
    if (present("\ncirinekromantenamulett",player))
    {
      present("\ncirinekromantenamulett",player)->DoUnwear(1);
      present("\ncirinekromantenamulett",player)->remove();
    }
    if (present("\ncirilogbuch",player))
      present("\ncirilogbuch",player)->zerfallen();
    if (IS_WIZARD(player)) tell_object(player,"Quest geschafft.\n");
    steps=1;
    QuestDone(player);
    //Quest geschafft!!!!
    }
  }
  else
  {
    if (align==1)
    {
      if (enemyname=="Gur'nuk")
      {
        tell_object(player,BS(
          "Dann drehst Du Dich zu Tabar um, um ihm wirklich das Amulett zu "
          "ueberreichen. Dieser bedankt sich mit einem freundlichen Laecheln "
          "und schreitet von dannen."));
        if (present("\ncirinekromantenamulett",player))
        {
          present("\ncirinekromantenamulett",player)->DoUnwear(1);
          present("\ncirinekromantenamulett",player)->remove();
        }
        present(TABARID,ENV(MENV))->move(ROOM"/leerraum",M_NOCHECK|M_SILENT);
        if (present("\ncirilogbuch",player))
          present("\ncirilogbuch",player)->zerfallen();
        if (IS_WIZARD(player)) tell_object(player,"Quest geschafft.\n");
        steps=1;
        QuestDone(player);
        //Quest geschafft!!!!
      }
      else
      {
        tell_object(player,BS(
          "Langsam wird Dir klar, dass das gerade ziemlich dumm war. Wie "
          "konntest Du nur einen Diener des Guten angreifen? Deine naechste "
          "Chance wird wohl einiges auf sich warten lassen."));
        steps=-2;
      //Quest nicht geschafft.
      }
    }
    else
    {
    tell_object(player,BS(
      "Zufrieden, den elenden Diener des Boesen vertrieben zu haben, "
      "wendest Du Dich vom Fenster ab, als Du ploetzlich bemerkst, dass das "
      "Amulett verschwunden ist. Dieser elende Kerl muss es Dir in einem "
      "hektischen Augenblick des Kampfes entwendet haben! Du fluchst "
      "ungehemmt. Naja, jetzt kannst Du es auch nicht mehr aendern, Du hast "
      "Dein moeglichstes getan."));
    if (present("\ncirinekromantenamulett",player))
    {
      present("\ncirinekromantenamulett",player)->DoUnwear(1);
      present("\ncirinekromantenamulett",player)->remove();
    }
    if (present("\ncirilogbuch",player))
      present("\ncirilogbuch",player)->zerfallen();
    if (IS_WIZARD(player)) tell_object(player,"Quest geschafft.\n");
    steps=1;
    QuestDone(player);
    //Quest geschafft!!!!
    }
  }
  return 1;
}

int QuestEnde(int poisondeath)
{
  object player;
  string enemyname;

  player=MENV;
  /*
  if (!query_once_interactive(player))
    return 0;*/
  if (!enemy)
  {
    enemy=present("tabar",ENV(TP));
    if (!TP->IsEnemy(enemy)) enemy=0;
    if (!enemy)
    {
      enemy=present("haldin",ENV(TP));
      if (!TP->IsEnemy(enemy)) enemy=0;
      if (!enemy)
      {
        enemy=present("gurnuk",ENV(TP));
        if (!TP->IsEnemy(enemy)) enemy=0;
        if (!enemy)
        {
          DBME("Bug in Riffquestobjekt: enemy nicht gesetzt.\n");
          tell_object(player,"Bug!! Bitte Cirion oder einen Erzmagier benachrichtigen.\n");
          return 1;
        }
      }
    }
  }
  enemyname=enemy->Name();
  tell_object(player,BS(
    "Dein letzter Schlag haette "+enemyname+" beinahe getoetet. "
    "Mit einem Mal scheint ihn die Angst zu packen, und er stuerzt "
    "zum Fenster."));
  tell_object(player,BS(
    "\"Wir treffen uns wieder!\" ruft er noch, dann springt er durchs "
    "Fenster hinunter auf den Platz und verschwindet in einer der Gassen."));
  enemy->move(ROOM"/leerraum",M_NOCHECK|M_SILENT);
  ENV(MENV)->RemoveCmd(({"u","unten"}));
  ENV(MENV)->AddExit (("unten"),"zur Tuer hinaus und die Treppe hinunter#/d/dschungel/feyaria/tijara/room/hotel_c6");
  tell_object(player,BS(
    "Du trittst ans Fenster und schaust ihm nach."));
  call_out("QuestEnde2",4,enemy,player);
  return 1;
}
