inherit "std/thing";

//#include "../def.h"
#include "/d/wasser/cirion/riff/riff.h"

#include <properties.h>
#include <moving.h>

nosave int used;

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  used=0;
  SetProp(P_SHORT, "Ein Landkarte");
  SetProp(P_NAME,"Landkarte");
  SetProp(P_LONG,BS( 
    "Dies ist eine Landkarte. Eigentlich eine sehr seltsame Landkarte, denn "
    "es ist gar nichts darauf zu sehen."));
  SetProp(P_INFO, 
    "Diese Landkarte ist moeglicherweise in der Zukunft einmal der Wegweiser "
    "zu einem Geheimnis." );
  SetProp(P_GENDER, FEMALE);
  AddId( ({"landkarte", "karte"}) );

  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE,30);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_PAPER);

}