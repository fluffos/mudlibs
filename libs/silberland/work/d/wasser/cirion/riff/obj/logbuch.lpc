inherit "std/thing";

#include "/d/wasser/cirion/riff/riff.h"
#include <ansi.h>

private int align;
private int offen;

int zerfallen();

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  offen=0;
  SetProp(P_SHORT, "Ein Buch in einer Lederumhuellung");
  SetProp(P_NAME,"Logbuch");
  SetProp(P_LONG,BS( 
    "Das ist ein kleines Buch, in eine wasserdichte Lederhuelle "
    "eingepackt, welche es vor Schaeden schuetzt."));
  SetProp(P_INFO, 
    "Das Logbuch enthaelt sicher einige Informationen zur Reise des "
    "am Riff gesunkenen Schiffes, der Schwanenschwinge." );
  SetProp(P_GENDER, NEUTER);
  AddId( ({"umhuellung", "huelle","buch","logbuch","\ncirilogbuch"}) );

  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE,20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_MATERIAL, ([MAT_PAPER:85,MAT_LEATHER:15]));

  align=present("\nciritabarquestob",TP)->QueryAlign();
  
  AddDetail(({"huelle","umhuellung","lederhuelle"}),
    "Das Buch ist von einer wasserdichten Lederhuelle umgeben.");
  AddCmd(({"lies","lese"}),"lies_buch");
  AddCmd(("oeffne"),"oeffne_huelle");
}

mixed _query_autoloadobj()
{
  return ({align, offen});  
}

void _set_autoloadobj(mixed a)
{
  if (pointerp(a) && sizeof(a)==2)
  {
    align = a[0];
    offen = a[1];
  }
}

int oeffne_huelle(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if(-1==member(({"huelle",
                 "lederhuelle",
                 "buchhuelle",
                 "lederumhuellung",
                 "umhuellung"}),str))
    return 0;             
  if (offen==1)
    write(BS(
      "Die Lederhuelle ist doch schon offen."));
  else if (ENV(TP)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == (TT_UNDERWATER||TT_WATER))
  {
    write(BS(
      "Hier im Wasser solltest Du die Huelle lieber nicht oeffnen."));
  }
  else
  {
    write(BS(
      "Du nimmst das Logbuch vorsichtig aus seiner Lederhuelle. Sie scheint "
      "doch nicht vollstaendig dicht gewesen zu sein, denn das Buch sieht "
      "schon sehr mitgenommen aus. Vorne auf dem Buch steht in grossen "
      "silbernen Lettern: "));
    write("\n");
    write(BS(ANSI_BOLD+"                \"Logbuch der Schwanenschwinge\""+
      ANSI_NORMAL+"."));
    write("\n");
    offen=1;
  }
  return 1;
}

int lies_buch(string str)
{
  object questob;	
  
  notify_fail("Was moechtest Du lesen?\n");
  if (-1!=member(({"buch","logbuch"}),str)) 
  {
    if (offen==0) 
    {
      write("Dazu musst Du schon die Lederhuelle oeffnen, die das Buch umgibt.\n");
      return 1;
    }
    write(BS(
      "Du schlaegst das Buch auf. Viele der Seiten sind unleserlich, und "
      "auf den meisten anderen stehen seltsame Kurseintragungen oder "
      "uninteressante Berichte ueber die Reisen des Schiffes."));
    write(BS(
      "Schliesslich kommst Du zu einer interessanteren Stelle, "
      "an der der Kapitaen des Schiffes berichtet, wie die Heldengruppe an "
      "Bord der Schwanenschwinge kam:"));
    write("\n");
    write(BS(
      "....haben wir eine Gruppe entschlossener Maenner an Bord genommen, die "
      "einen verfluchten Gegenstand zur Burg der Paladine bringen wollen. "
      "Natuerlich helfen wir ihnen gerne. Der Anfuehrer der Gruppe erzaehlte "
      "mir etwas von einem Verfolger, der...."));
    write("\n");
    write(BS(
      "Der nachfolgende Text ist zu unleserlich, um ihn zu entziffern. Doch "
      "einige Absaetze spaeter heisst es:"));
    write("\n");
    if (align==0)
    {
      write(BS(
        "....berichteten, er sei in Wahrheit gar kein Diener des Guten...."));
    }
    else
    {
      write(BS(
        "....berichteten, er habe sich von der Richtigkeit der Dinge ueberzeugt, "
        "und ihnen dann seinen Segen fuer das Gelingen ihrer Mission ...."));
    }
    write("\n");
    write(BS(
      "Die Eintragungen ins Logbuch enden mit einem Eintrag, der besagt, dass "
      "die Schwanenschwinge an einem Tag mit hervorragendem Wetter und klarer, "
      "weiter Sicht in See gestochen ist, um gen Midas zu segeln."));
    if (questob=present("\nciritabarquestob",TP))
      questob->ReadLogbuch();
    return 1;
  }
  return 0;
}

int zerfallen()
{
  call_out("zerfallen_ende",1800);
  return 1;	
}

zerfallen_ende()
{
  tell_object(MENV,BS(
    "Das Logbuch loest sich aufgrund seiner Alters in seine "
    "Bestandteile auf."));
  TO->remove();
  if (TO) destruct(TO);
}
