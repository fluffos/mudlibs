//Die Leuchtteile eines Silberfisches...

inherit "std/thing";

#include "/d/wasser/cirion/riff/riff.h"

#include <properties.h>
#include <moving.h>

#define SP_USE 20
#define BURNTIME 350+random(50)

nosave int used;

void create()
{
  if( !is_clone(TO)) return;
  ::create();

  used=0;
  SetProp(P_SHORT, "Ein Silberfischherz");
  SetProp(P_LONG,BS( 
     "Das ist das Herz eines Silberfisches. Im Gegensatz zu anderen Herzen "
     "ist dieses beim Abbleben des Fisches versteinert, so dass es jetzt "
     "aussieht, wie ein silberfarbener Kristall."));
  SetProp(P_NAME, "Silberfischherz");
  SetProp(P_INFO, "Das Silberfischherz ist das Organ des Silberfisches, welches leuchtet."
    " Daher kann man es mit ein wenig Magie zum Leuchten bringen (Syntax: leuchte)." );
  SetProp(P_GENDER, NEUTER);
  AddId( ({"herz", "silberfischherz"}) );

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 0);
  SetProp(P_MATERIAL, MAT_CRYSTAL);

  AddCmd(({"leuchte"}),"leuchte");
}

int leuchte()
{
  if ((QueryProp(P_LIGHT)==0)&&(TP->QueryProp(P_SP)>=SP_USE)&&(used==0)&&(ENV(TO)==TP))
  {
    SetProp(P_LIGHT,2);
    SetProp(P_SHORT,"Ein Silberfischherz (leuchtend)");
    SetProp(P_VALUE,50);
    write("Das Silberfischherz entzieht Dir etwas magische Energie und beginnt dann\n"
          "hell zu leuchten.\n");
    say("Das Silberfischherz in "+TP->Name()+"s Haenden beginnt hell zu leuchten.\n",TP);
    TP->AddSp(-SP_USE);
    call_out("verdunkeln",BURNTIME);
    used=1;
    return 1;
  }
  else if (QueryProp(P_LIGHT)!=0)
  {
    write("Das Herz leuchtet doch schon.\n");
    return 1;
  } 	
  else if (TP->QueryProp(P_SP)<SP_USE)
  {
    write("Du hast nicht genuegend Magie, um das Herz zum Leuchten zu bringen.\n");
    return 1;	
  }
  else if (used==1)
  {
    write("Es scheint so, als haette das Herz seine Leuchtkraft verloren.\n");
    return 1;	
  }
  else if (ENV(TO)!=TP)
  {
    write("Dazu muesstest Du das Herz erst einmal haben.\n");
    return 1;	
  }
  return 0;
}

verdunkeln()
{
  write("Das Herz verliert langsam seine Leuchtkraft.\n");
  SetProp(P_LIGHT,1);
  SetProp(P_SHORT, "Ein Silberfischherz (gluehend)");
  call_out("verloeschen",BURNTIME);	
  return;
}

verloeschen()
{
  write("Das Silberfischherz verloescht.\n");
  SetProp(P_LIGHT,0);
  SetProp(P_SHORT,"Ein Silberfischherz");	
  SetProp(P_INFO,"Das Herz scheint seine Kraefte verloren zu haben.");
  call_out("zerbroeseln",BURNTIME);
  return;
}

zerbroeseln()
{
  write(BS("Das Silberfischherz scheint seine Konsistenz verloren "
           "zu haben und zerbroeselt zu feinem Staub."));
  SetProp(P_SHORT,"Staub");
  SetProp(P_LONG,"Das ist bloss ein wenig silberner Staub.");
  SetProp(P_INFO,"Ein klein wenig Magie ist noch an dem Staub zu spueren.");
  SetProp(P_NAME,"Silberstaub");
  SetProp(P_GENDER,MALE);
  SetProp(P_VALUE,0);
  call_out("aufloesen",BURNTIME);
  AddId("staub");
  return;
}

aufloesen()
{
  write("Der Staub loest sich vollstaendig auf.\n");
  TO->remove();
  if(TO) TO->destruct();
  return;
}
