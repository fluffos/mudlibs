inherit "std/thing";

#include "/d/wasser/cirion/riff/riff.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein kleiner Silberschluessel");
  SetProp (P_LONG, BS(
               "Das ist ein kleiner, filigraner Silberschluessel."));
  SetProp (P_NAME, "Silberschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_SILVER);
  SetProp (P_AUTOLOADOBJ,1);
  AddId (({"schluessel", "silberschluessel","\nciriskey"}));
}

string QueryDoorKey()
{
  return "FakeKey:FakeKey";
}