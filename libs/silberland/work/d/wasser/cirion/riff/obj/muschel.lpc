#include "/d/wasser/cirion/riff/riff.h"
#include <food.h>

inherit "std/thing";

int perle;
int offen;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  perle=random(2);
  offen=0;
  
  AddId(({"muschel"}));
  SetProp(P_SHORT, "Eine Muschel");
  SetProp(P_LONG, 
    "Das ist eine kleine Muschel. Vielleicht ist im Inneren ja "
    "eine Perle versteckt?");
  SetProp(P_NAME, "Muschel");
  SetProp(P_INFO,"Manchmal kann man in Muscheln Perlen finden.");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL,([MAT_MISC_FOOD:100]));
}

init()
{
  add_action("essen","iss");
  add_action("oeffnen","oeffne");	
  ::init();
}

essen(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if (str!="muschel" && str!="inhalt") return 0;
  if (offen==0)
  {
    write("Dazu musst Du sie schon oeffnen.\n");
    return 1;
  }
  write ("Du isst die Muschel. Hmmm, die ist lecker!\n"
         "Die leere Schale wirfst Du weg.\n");
  TP->AddHp(10);
  remove();
  return 1;
}

oeffnen(string str)
{
  notify_fail("Was moechtest Du denn oeffnen?\n");
  if (str!="muschel") return 0;
  if(offen==1)
  {
    write(BS("Die Muschel ist doch schon offen."));
    return 1;	
  }	
  write(BS("Du oeffnest die Muschel."));
  offen=1;
  if (perle==1)
  {
    write(BS("Als Du hineinschaust, findest Du eine Perle! Du nimmst "
             "die Perle heraus und steckst sie ein.\n"));
    SetProp(P_WEIGHT,45);
    "/obj/pearlmaster"->DistributePearl(1,0,0,0,"riffperle")->move(TP,M_GET);
  }
  SetProp(P_LONG,
    "Das ist eine kleine Muschel. Jemand hat sie geoeffnet, man kann "
    "Ihren Inhalt essen.");
  return 1;
}