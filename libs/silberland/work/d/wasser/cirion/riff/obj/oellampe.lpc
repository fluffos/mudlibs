inherit "std/thing";

#include "/d/wasser/cirion/riff/riff.h"

private int content;
private int open;

int GetContent();
int SetContent(int i);

create()
{
  if (!is_clone(this_object()))
     return;

  ::create(); 
  open=0;
  content=1;
  SetProp(P_SHORT, "Eine zerbrochene Oellampe");
  SetProp(P_LONG, 
    "Dies war einst eine recht schoene Oellampe, mit einem glaesernen Windschutz "
    "und kunstvollen Verzierungen. Allerdings ist das Glas zerbrochen, und die "
    "Lampe somit nicht mehr brauchbar. An der Seite ist ein kleiner Schraubdeckel "
    "angebracht.");
  SetProp(P_NAME, "Oellampe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"oellampe","lampe","\ncirilampe"}));
  AddAdjective("zerbrochene");
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 750);
  SetProp(P_MATERIAL,([MAT_BRONCE:100]));
  AddDetail(({"windschutz","glas"}),
    "Einst hatte diese Lampe einen schoenen Windschutz aus Glas, der die Flamme "
    "vor dem ausgehen schuetzte. Inzwischen ist er jedoch zerbrochen.");
  AddDetail(({"verzierungen","verzierung"}),
    "Die Verzierungen sehen wirklich huebsch aus, auch wenn die Lampe durch die "
    "lange Zeit hier unten etwas gelitten hat.");
  AddDetail(({"deckel","schraubdeckel"}),
    "Den Deckel kann man leicht abdrehen, und durch die entstehende Oeffnung wurde "
    "wohl frueher Oel in die Lampe gegeben.");
  AddDetail(({"oel"}),
    "Es scheint sich noch etwas Oel in der Lampe zu befinden. Vielleicht kannst "
    "Du damit etwas oelen?");
  AddDetail(({"flamme"}),
    "In dieser Lampe wird wohl nie mehr eine Flamme leuchten.");  
}

init()
{
  ::init();
  add_action("oeffne","oeffne");
  add_action("oeffne","dreh");
  add_action("oeffne","drehe");
}

int GetContent()
{
  return content;	
}

int GetOpen()
{
  return open;
}

int oeffne(string str)
{
  if (query_verb()=="oeffne")
  {
    notify_fail("Was moechtest Du denn oeffnen?\n");
    if (-1==member(({"lampe",
                     "oellampe",
                     "deckel",
                     "schraubdeckel"}),str))
      return 0;
  }
  else 
  {
    notify_fail("Was moechtest Du denn drehen?\n");
    if (-1==member(({"deckel",
                     "deckel ab",
                     "schraubdeckel",
                     "schraubdeckel ab",
                     "deckel auf",
                     "schraubdeckel auf"}),str))
      return 0;
  }
  if (open==1)        
  {
    write(BS(
      "Die Lampe ist doch schon offen."));
    return 1;
  }  
  if(ENV(TP)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN] == (TT_UNDERWATER||TT_WATER))
  {
    write(BS(
      "Hier im Wasser soltest Du das besser nicht versuchen.\n"));
    return 1;
  }
   write(BS(
     "Du schraubst den kleinen Deckel von der Lampe. Drinnen scheint "
     "sich noch etwas Oel zu befinden."));
   open=1;
  SetProp(P_LONG, 
    "Dies war einst eine recht schoene Oellampe, mit einem glaesernen Windschutz "
    "und kunstvollen Verzierungen. Allerdings ist das Glas zerbrochen, und die "
    "Lampe somit nicht mehr brauchbar. Der Schraubdeckel an der Seite ist geoeffnet.");
  AddDetail(({"deckel","schraubdeckel"}),
    "Der Deckel an der Seite der Lampe ist geoeffnet.");
  return 1;
}

int SetContent(int i)
{
  switch (i)
  {
    case 0:
      AddDetail(({"oel"}),
        "Da ist kein Oel mehr drin.");
      break;
    case 1:  
      AddDetail(({"oel"}),
        "Es scheint sich noch etwas Oel in der Lampe zu befinden.");
      break;	
  }
  content=i;
  return 1;	
}