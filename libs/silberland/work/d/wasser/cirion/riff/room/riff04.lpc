#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
	
  ::create();

  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du tauchst im Wasser suedlich des grossen Korallenriffs. Das Wasser "
    "ist herrlich warm, und Du geniesst die wunderbare Umgebung. Rund um Dich "
    "herum siehst Du nun diese herrlichen Farben, und Du kannst hier jetzt auch "
    "den Meeresgrund besser erkennen. Ueberall schwimmen kleine Fische herum, "
    "und das Riff ist bewachsen mit allerlei Wasserpflanzen, die sich in der "
    "sanften Stroemung hin und her bewegen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"meer", "wasser"}),
    "Das Wasser hier hat genau die richtige Temperatur zum Baden. Rund um "+
    "Dich herum leuchtet es in den verschiedensten Farben, und nach oben "+
    "hin kannst Du die Wasseroberflaeche sehen.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche ist wenige Meter ueber Dir, und darueber kannst "+
    "Du verschwommen den Himmel und die strahlende Sonne sehen, die das "+
    "Wasser hier so angenehm erwaermt.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Du schwimmst genau ueber dem Riff. Von hier kannst Du sehen, dass das "+
    "Riff keinesfalls eine kompakte Masse ist, sondern aus unzaehligen "+
    "kleinen Meereslebewesen, den Korallen, besteht, und dass es hier unten "+
    "die eigenartigsten Formen gebildet hat.");
  AddDetail ( ({"masse"}),
    "Das Riff ist keinesfalls eine kompakte Masse, sondern vielmehr aus "+
    "vielen winzigen Teilen aufgebaut.");
  AddDetail ( ({"umgebung"}),
    "Die Umgebung ist wirklich wunderschoen. Rund um Dich herum leuchtet "+
    "das Wasser in der schillerndsten Farben, und ueberall schwimmen kleine "+
    "Fische und Fischschwaerme. Der Anblick zieht Dich voellig in seinen "+
    "Bann.");
  AddDetail ( ({"farben"}),
    "Jetzt kannst Du endlich erkennen, woher diese wunderbaren Farben "+
    "kommen: Es sind Schwaerme von kleinen, buntschillernden Fischen, die "+
    "hier ueberall zwischen dem Riff herumschwimmen. Sie sind wirklich "+
    "wunderschoen anzuschauen, und Du erinnerst Dich, dass Du schon einmal "+
    "von diesen Regenbogenfischen gehoert hast, Du hast es allerdings immer "+
    "fuer eine Legende gehalten.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist von hier unten nur an dem verschwommenen Blau zu "+
    "sehen, das sich an der Wasseroberflaeche bricht.");
  AddDetail ( ({"sonne"}),
    "Du kannst die Sonne zwar von hier unten noch sehen, doch ihre "+
    "Strahlen spuerst Du nicht mehr, und auch geblendet wirst Du nicht mehr "+
    "so stark. Dennoch ist es hier unten sehr hell, und Du brauchst "+
    "wahrhaftig keine Lichtquelle.");
  AddDetail ( ({"fische"}),
    "Hier schwimmen wirklich die verschiedensten tropischen Fische in "+
    "allen nur denkbaren Formen und Farben. Die allermeisten hast Du noch "+
    "nie zuvor gesehen, und so kannst Du Dich am Anblick der Fische kaum "+
    "sattsehen.");
  AddDetail ( ({"fischschwaerme"}),
    "Als Du genauer hinsiehst, stellst Du fest, das genau diese "+
    "Fischschwaerme die wunderbaren Farben um Dich herum erzeugen. Es sind "+
    "naemlich Hunderte von kleinen, buntschillernden Regenbogenfischen.");
  AddDetail ( ({"regenbogenfisch", "regenbogenfische"}),
    "Die Regenbogenfische schillern in den verschiedensten Farben, so dass "+
    "man garnicht sagen kann, welche Farbe ein einzelner von ihnen hat. Es "+
    "scheint fast so, als haetten sie eine magische Aura um sich herum.");
  AddDetail ( ({"anblick", "bann"}),
    "Der Anblick ist wirklich wunderschoen und haelt Dich fest in seinem "+
    "Bann.");
  AddDetail ( ({"boden", "meeresgrund","meeresboden","grund"}),
    "Man kann hier eigentlich kaum von einem Boden sprechen. Von oben mag "+
    "es so aussehen, aber hier kann man erkennen, dass der Boden aus "+
    "Korallen besteht und mit unzaehligen Spalten und Rissen versehen ist.");
  AddDetail ( ({"form", "formen", "risse", 
                "rissen", "spalte", "spalten","riss"}),
    "Die Korallen haben dem Riff die sonderbarsten Formen gegeben. Hier "+
    "siehst Du Saeulen, dort scheinen kleine Durchgaenge oder Hoehlen zu "+
    "sein, und ueberall sind Risse und Spalten zu sehen. Immer wieder "+
    "siehst Du in den Hohlraeumen Fische oder andere Meereslebewesen, die "+
    "da ihr Dasein fristen.");
  AddDetail ( ({"saeulen"}),
    "Die Saeulen bestehen aus Korallen.");
  AddDetail ( ({"durchgaenge", "hoehlen", "hohlraeume","hohlraum","durchgang"}),
    "Alle Hohlraeume und Durchgaenge die Du sehen kannst, sind zu klein um "+
    "hindurch oder hinein zu passen. Schade, in manchen haettest Du Dich "+
    "gerne naeher umgesehen.");
  AddDetail ( ({"legende"}),
    "Der Legende ueber die Regenbogenfische nach sind es wunderschoene "+
    "Fische, die magisch sind und die Magie an ihre Umgebung abgeben. Die "+
    "Schoenheit kannst Du bestaetigen, und wie weit es mit der Magie her "+
    "ist? Du kannst es ja einmal ausprobieren, eine magische Aura scheinen "+
    "die Fische jedenfalls zu haben.");
  AddDetail ( ({"aura"}),
    "Die magische Aura um der Regenbogenfische ist beinahe fuehlbar. Die "+
    "ist dort am staerksten, wo die meisten Fische in einem Schwarm "+
    "schwimmen. Dort scheint das Wasser um sie herum beinahe zu leuchten.");
  AddDetail ( ({"pflanzen", "wasserpflanzen","pflanze","wasserpflanze"}),
    "Die Wasserpflanzen bedecken grosse Teile des Riffs. Sie wachsen hier "+
    "in den unterschiedlichsten Formen und Farben, und manchmal siehst Du "+
    "kleine Fische oder andere Meereslebewesen, die sie anknabbern oder "+
    "sich in ihnen verstecken.");
  AddDetail ( ({"meereslebewesen","lebewesen"}),
    "Es gibt hier ausser Fische auch noch viele andere Meereslebewesen: "+
    "Einige bunte Quallen, Krebse und Seesterne gehoeren dazu.");
  AddDetail ( ({"quallen"}),
    "Es gibt hier einige Quallen in den verschiedensten Farben. Sie "+
    "schwimmen langsam und traege im Riff umher.");
  AddDetail ( ({"seesterne"}),
    "Es gibt hier wirkliche einige schoene Exemplare von Seesternen, auch "+
    "wenn sie nicht so haeufig sind, wie andere Riffbewohner.");
  AddDetail ( ({"krebse"}),
    "Die Krebse krabbeln ueberall auf dem Boden herum. Ein Krebs krabbelt "+
    "Dir beinah ueber den dicken Zeh.");
  AddDetail ( ({"krebs"}),
    "Der Krebs krabbelt weiter unter das grosse Blatt einer Wasserpflanze, "+
    "die Du noch nie gesehen hast.");
  AddDetail ( ({"wasserpflanze"}),
    "Es handelt sich um eine recht grosse Wasserpflanze mit ebenso grossen "+
    "Blaettern, die grosse Teile des Riffs verdecken. Darunter scheinen "+
    "sich einige Krebse zu verstecken.");
  AddDetail ( ({"blaetter"}),
    "Die Wasserpflanze hat wirklich riesige Blaetter, unter denen sich "+
    "einiges Getier verstecken kann.");
  AddDetail ( ({"blatt"}),
    "Du untersuchst das Blatt, unter das der Krebs gekrochen ist. Hmm, "+
    "viel kannst Du nicht erkennen, aber vielleicht kannst Du ja das Blatt "+
    "herumdrehen?");
  AddDetail ( ({"schoenheit"}),
    "Die Schoenheit dieses Anblicks ist wirklich selten.");
  AddDetail ( ({"koralle", "korallen"}),
    "Die Korallen sind kleine Meereslebewesen, die aufeinander wachsen und "+
    "beim Tod ihr Kalk-Skelett zuruecklassen. Daraus baut sich ueber "+
    "tausenden von Jahren dieses Riff auf.");
  AddDetail ( ({"stroemung"}),
    "Die Stroemung ist hier wirklich sehr sanft und wiegt nur leicht die "+
    "Wasserpflanzen hin und her.");
  AddDetail ( ({"eingang", "hoehleneingang","hoehle"}),
    "Unter dem grossen Blatt liegt versteckt der Eingang zu einer Hoehle, "+
    "die tiefer ins Riff zu fuehren scheint.");
  // DETAILS END

  // ITEMS START
  // ITEMS END

  AddItem(NPC+"/regenbogenfische", REFRESH_DESTRUCT);
  
  AddCmd ( ({"drehe", "dreh", "wende"}), "drehe_blatt");
  
  AddWaterExit("westen",ROOM"/riff06");
  AddWaterExit("osten",ROOM"/riff05");
  AddHiddenWaterExit("nordunten","#nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("norden","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("in hoehle","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("in riff","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("in eingang","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("in hoehleneingang","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("in das riff","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("in die hoehle","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("in den eingang","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddHiddenWaterExit("in den hoehleneingang","nach Nordunten in eine Hoehle#"ROOM"/riff07");
  AddDiveExit("oben",ROOM"/riff01");
  
}


int drehe_blatt (string str)
{
  notify_fail ("Was moechtest Du drehen?\n");
  if (!str) return 0;
  if (str=="blatt"||str=="blatt herum"||str=="blatt um")
  {
  	write("Du drehst das Blatt herum....doch von dem Krebs ist nichts mehr\n"+
  	      "zu sehen. Dafuer siehst Du einen verborgenen Hoehleneingang, Der\n"+
  	      "geradewegs in des Riff hineinfuehrt. Du koenntest hineinschwimmen.\n");
  }
  return 1;
}
