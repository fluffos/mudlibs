#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

nosave int dreizack;

void create()
{
  ::create();
  dreizack=1;
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Im Mannschaftsraum");
  SetProp (P_INT_LONG,
    "Dies hier ist wohl der Mannschaftsschlafraum. Hier haengen noch "+
    "zwischen einigen Balken Haengematten, die meisten sind jedoch "+
    "bereits verfault. An den Waenden stehen einige Kisten, welche wohl "+
    "die Habseligkeiten der Schiffsbesatzungen enthalten. Die Seeleute "+
    "scheinen im Schlaf vom Sinken des Schiffes ueberrascht worden zu "+
    "sein, denn hier liegen sehr viele Skelette am Boden. Nach hinten "+
    "scheint eine kleine Tuer in einen weiteren Raum zu fuehren, und eine "+
    "schmale Treppe fuehrt nach oben.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Der Boden besteht, wie fast alles andere in diesem Schiff, aus einem "+
    "hellen, fast weissen Holz. Eigentlich sieht er hier genauso aus, wie "+
    "in den anderen Raeumen auch, allerdings ist ein fast mannsgrosses Loch "+
    "in die Schiffswand gerissen, durch das man den Grund des Riffes sehen "+
    "kann.");
  AddDetail ( ({"loch", "oeffnung"}),
    "Die Oeffnung ist fast mannsgross, und laesst einen Blick auf den "+
    "Grund des Riffes zu. An den Raendern des Loches kann man sehen, dass "+
    "die Bordwaende des Schiffes viel dicker sind, als die anderen Waende "+
    "hier. Fast scheint es so, als waere das Loch viel zu gross, um durch "
    "die Kollision mit dem Riff zustande gekommen zu sein.");
  AddDetail ( ({"kollision", "zusammenstoss"}),
    "Der Zusammenstoss mit dem Riff scheint wirklich ein sehr starker "+
    "gewesen zu sein, sonst haette diese dicke Schiffswand nicht in einer "+
    "derartigen Weise brechen koennen. Vor allem ist das Loch an der Seite "+
    "des Schiffes, was darauf hinzuweisen scheint, dass das Schiff "+
    "seitwaerts getrieben ist.");
  AddDetail ( ({"raender", "rand"}),
    "Die Raender des Loches zeigen deutlich, dass das fehlende Stueck des "+
    "Schiffsrumpfes nach innen gedrueckt worden sein muss. Allerdings sind "+
    "bei weitem nicht solch lange Splitter und Bruchstueck entstanden, wie "+
    "Du das erwarten wuerdest. Es sieht teilweise sogar so aus, als waere "+
    "das Loch recht sauber herausgetrennt worden.");
  AddDetail ( ({"gerippe", "seeleute", "skelette"}),
    "Von den Seeleuten sind nicht viel mehr als leere Gerippe uebrig, die "+
    "teilweise noch wiederstandsfaehigere Kleidung wie Kettenhemden tragen. "+
    "Sie liegen ueber den ganzen Raum verstreut.");
  AddDetail ( ({"kleidung"}),
    "Das meiste der Kleidung der Seeleute ist wohl schon verrottet, nur "+
    "wiederstandsfaehigere Dinge wie die Kettenhemden sind noch da.");
  AddDetail ( ({"kettenhemd", "kettenhemden"}),
    "Die Kettenhemden, die manche der Skelette tragen, sind auch schon in "+
    "einem traurigen Zustand, da voellig verrostet. Als Du ein wenig "+
    "darueber nachdenkst, verwundert Dich schon, dass die Seeleute "+
    "Kettenhemden getragen haben, schliesslich bist Du bisher davon "+
    "ausgegangen, dass sie im Schlaf ertrunken sind.");
  AddDetail ( ({"dinge"}),
    "Hier liegen viele Dinge herum, die Kettenhemden sind nur einige "+
    "davon.");
  AddDetail ( ({"balken"}),
    "Die Balken stehen hier in regelmaessigen Abstaenden senkrecht vom "+
    "Boden zur Decke, sie stuetzen das Zwischendeck und auch die hoeheren "+
    "Teile des Schiffes und verleihen dem Rumpf seine Festigkeit.");
  AddDetail ( ({"mannschaftsraum", "mannschaftsschlafraum", "raum"}),
    "Dies hier ist wohl der Mannschaftsschlafraum. Hier haengen noch "+
    "zwischen einigen Balken Haengematten, die meisten sind jedoch "+
    "bereits verfault. An den Waenden stehen einige Kisten, welche wohl "+
    "die Habseligkeiten der Schiffsbesatzungen enthalten. Die Seeleute "+
    "scheinen im Schlaf vom Sinken des Schiffes ueberrascht worden zu "+
    "sein, denn hier liegen sehr viele Skelette am Boden. Nach hinten "+
    "scheint eine kleine Tuer in einen weiteren Raum zu fuehren, und eine "+
    "schmale Treppe fuehrt nach oben.");
  AddDetail ( ({"abstaende", "abstand"}),
    "Der Abstand zwischen den einzelnen Balken betraegt jeweils ungefaehr "+
    "zweieinhalb Meter.");
  AddDetail ( ({"decke", "zwischendeck"}),
    "Das Zwischendeck bildet die Decke dieses Raumes, und von hier unten "+
    "kannst Du auch die Querstreben sehen, die es stuetzen.");
  AddDetail ( ({"querstreben"}),
    "Die Querstreben stuetzen das Zwischendeck und erhoehen die "+
    "Stabilitaet des ganzen Rumpfes, da sie von rechts nach links quer "+
    "durch das ganze Schiff gehen.");
  AddDetail ( ({"rumpf"}),
    "Der Rumpf des Schiffes besteht aus der Schiffswand, die verhindert, "+
    "dass Wasser in das Schiff eindringt.");
  AddDetail ( ({"festigkeit", "stabilitaet"}),
    "Die enorme Festigkeit des Schiffrumpfes ruehrt nicht nur von der "+
    "hohen Qualitaet des verwendeten Holzes her, sondern auch von den "+
    "Querstreben und den Balken, die das gesamte Schiff durchziehen.");
  AddDetail ( ({"holz"}),
    "Es handelt sich wohl um ein ausserordentlich hartes Holz, aus dem "+
    "hier fast alles gefertigt ist. Wenn du ganz genau hinschaust, kannst "+
    "Du eine feine Maserung erkennen.");
  AddDetail ( ({"maserung"}),
    "Die feine hellgraue Maserung ist nur sehr schwach zu erkennen.");
  AddDetail ( ({"haengematte", "haengematten", "schlafstaette"}),
    "Die Haengematten sind quer zwischen den Balken hier unten gespannt. "+
    "Sie bildeten wohl die Schlafstaette der Seeleute.");
  AddDetail ( ({"bordwaende", "bordwand", "schiffswand", 
                "waende", "wand"}),
    "Die Waende sind natuerlich auch aus Holz hier, und entlang der "+
    "Waende stehen Kisten, die wohl die Habseligkeiten der Seeleute "+
    "enthalten.");
  AddDetail ( ({"tuer"}),
    "Die Tuer ist geschlossen, allerdings ist nur ein einfacher Holzgriff "+
    "daran, ein Schloss ist nicht zu sehen.");
  AddDetail ( ({"griff", "holzgriff"}),
    "Ein einfacher Griff, mit dem man die Tuer sehr wahrscheinlich "+
    "oeffnen kann.");
  AddDetail ( ({"schloss"}),
    "Ein Schloss ist gerade _nicht_ zu sehen. (Was die Leute nicht alles "+
    "untersuchen wollen)");
  AddDetail ( ({"treppe"}),
    "Die schmale Treppe fuehrt wohl offensichtlich zurueck nach oben.");
  AddDetail ( ({"kisten"}),
    "Die Kisten sind unverschlossen, offenbar hatten die Seeleute "+
    "Vertrauen zueinander. In den Kisten finden sich die Habseligkeiten der "+
    "Seeleute.");
  AddDetail ( ({"habseligkeiten"}),
    "Die Habseligkeiten der Seeleute sind inzwischen laengst verrotet und "+
    "unbrauchbar.");
  AddDetail ( ({"grund", "meeresgrund", "riff"}),
    "Durch das Loch im Boden kannst Du den Grund des Riffes sehen. Er "+
    "sieht hier nicht anders aus, als sonst, es sind einige Spalten zu "+
    "sehen und auch einige kleine Fische, die lustig hin und her schwimmen.");
  AddDetail ( ({"spalten"}),
    "Die Spalten hier sind nicht besonders gross, sie scheinen der "+
    "Lebensraum fuer eine grosse Anzahl von kleinen Fischen und anderen "+
    "Lebewesen zu sein. In einer Spalte kannst Du ein Glitzern erkennen.");
  AddDetail ( ({"spalte"}),
    "Als Du genauer hinschaust, stellst Du fest, dass in der Spalte wohl "+
    "eine silbrig glitzernde Metallstange zu liegen scheint. Vielleicht "+
    "kannst Du sie herausnehmen.");
  AddDetail ( ({"fisch", "fische", "lebewesen", 
                "meereslebewesen"}),
    "Dort unten in den Spalten sind viele kleine Fische und andere "+
    "Lebewesen zu sehen.");
  AddDetail ( ({"bruckstueck", "brueckstuecke", "splitter"}),
    "Es sind eigentlich kaum Bruchstuecke oder Splitter zu sehen, im "+
    "Gegenteil, teilweise sieht es fast so aus, als waere das Loch sauber "+
    "aus der Schiffswand herausgetrennt worden.");
  AddDetail ( ({"meer", "meerwasser", "wasser"}),
    "Das Meerwasser ist ueberall um Dich herum.");
  AddDetail ( ({"metallstange", "stange"}),
    "Von hier kannst Du nicht viel erkennen. Es scheint sich um eine "+
    "einfache Metallstange zu handeln, die an einigen Stellen bereits "+
    "verrostet ist. Um sie genauer zu betrachten, wirst Du sie wohl nehmen "+
    "muessen.");
  AddDetail ( ({"qualitaet"}),
    "Dieses seltsame, weisse Holz ist wirklich von einer "+
    "aussergewoehnlichen Qualitaet.");
  AddDetail ( ({"knochen", "knochenhand"}),
    "Tatsaechlich liegen noch mehr Knochen unten in der Spalte. Es scheint "+
    "sich wohl um ein ganzen Skelett zu handeln, welches die Moraene Stueck "+
    "fuer Stueck hier hereingetragen hat. Als Du die Knochen genauer "+
    "untersuchst, stellst Du zu Deinem Erstaunen fest, dass es sich zwar um "+
    "ein menschenaehnliches Skelett handelt, allerdings schien dieses Wesen "+
    "statt Beinen einen Fischschwanz gehabt zu haben.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("oben", "nach Oben#"+ROOM+"/hauptraum");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"oeffne"}), "oeffne");
  AddCmd ( ({"nimm"}), "nimm");
}

reset()
{
  ::reset();
  dreizack=1;
  AddDetail ( ({"spalten"}),
    "Die Spalten hier sind nicht besonders gross, sie scheinen der "+
    "Lebensraum fuer eine grosse Anzahl von kleinen Fischen und anderen "+
    "Lebewesen zu sein. In einer Spalte kannst Du ein Glitzern erkennen.");
  AddDetail ( ({"spalte"}),
    "Als Du genauer hinschaust, stellst Du fest, dass in der Spalte wohl "+
    "eine silbrig glitzernde Metallstange zu liegen scheint. Vielleicht "+
    "kannst Du sie herausnehmen.");
  AddDetail ( ({"metallstange", "stange"}),
    "Von hier kannst Du nicht viel erkennen. Es scheint sich um eine "+
    "einfache Metallstange zu handeln, die an einigen Stellen bereits "+
    "verrostet ist. Um sie genauer zu betrachten, wirst Du sie wohl nehmen "+
    "muessen.");
}

int nimm (string str)
{
  object ob;
  
  notify_fail ("Was willst Du nehmen?\n");
  if (-1==member(({"stange","metallstange"}),str)) return 0;
  if (dreizack==0)
    return 0;
  ob=clone_object(WEAPON"/rdreizack");
  notify_fail("Das ist zu schwer fuer Dich.\n");
  if (ME_TOO_HEAVY==ob->move(TP,M_GET))
    return 0;
  write(BS("Du nimmst die Stange und ...oh, es handelt sich um einen "
           "rostigen alten Dreizack!"));
  dreizack=0;
  AddDetail ( ({"spalten"}),
    "Die Spalten hier sind nicht besonders gross, sie scheinen der "+
    "Lebensraum fuer eine grosse Anzahl von kleinen Fischen und anderen "+
    "Lebewesen zu sein.");
  AddDetail ( ({"spalte"}),
    "Die Spalte ist leer.");
  RemoveDetail ( ({"metallstange", "stange"}));
  return 1;
}

int oeffne (string str)
{
  object kuhfuss;
	
  notify_fail ("Was willst Du oeffnen?\n");
  if (-1==member(({"tuer",
                   "tuere",
                   "tuer mit kuhfuss",
                   "tuere mit kuhfuss",
                   "tuer mit brecheisen",
                   "tuere mit brecheisen"
                }),str)) return 0;
  kuhfuss=present("\cirikuhfuss",TP);                
  if (-1!=member(({"tuer","tuere"}),str))
  {
    write(BS(
      "Du versuchst die Tuer oeffnen, doch sie klemmt irgenwie. "
      "Du ziehst etwas kraeftiger, und schliesslich reisst Du mit voller "
      "Kraft an der Tuer, doch sie bewegt sich keinen Millimeter. Sie "
      "ist durch das Wasser hier unten einfach zu aufgequollen. Aber mit "
      "einem geeignetem Werkzeug kannst Du sie vielleicht oeffnen."));    
  }
  if (-1!=member(({"tuer mit kuhfuss",
                   "tuer mit brecheisen",
                   "tuere mit brecheisen",
                   "tuere mit kuhfuss"}),str))
  {
    if (!present("\cirikuhfuss",TP))
    {
      write(BS("Du hast doch gar keinen Kuhfuss."));
    }
    else if (!(kuhfuss->QueryProp(P_WIELDED)==TP))
    {
      write(BS("Du musst den Kuhfuss schon in die Haende nehmen."));	
    }
    else
    {
      write(BS(
        "Du hebelst mit dem Kuhfuss an der Tuere herum, und tatsaechlich, "
        "mit einem Kraftakt gelingt es Dir, die Tuere zu oeffnen. Schnell "
        "schwimmst Du hindurch und schliesst sie wieder hinter Dir."));
      TP->move(ROOM"/vorratsraum",M_GO|M_NOCHECK,"",
               "oeffnet irgendwie die Tuer und schwimmt hindurch","schwimmt herein");      	
    }
  }
  return 1;
}
