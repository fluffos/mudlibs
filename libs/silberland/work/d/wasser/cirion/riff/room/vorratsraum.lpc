#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

int lege(string str);
int schliess();

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Ein Vorratsraum");
  SetProp (P_INT_LONG,
    "Dies hier scheint der Vorratsraum des Schiffes gewesen zu sein. Er ist "+
    "recht klein und seine Waende sind mit Regalen vollgestopft. Ueberall liegen "+
    "Saecke und Kisten herum, waehrend in den Regalen unterschiedliche, mehr oder "
    "weniger unidentifizierbare Dinge liegen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"raum", "vorratsraum"}),
    QueryProp(P_INT_LONG));
  AddDetail ( ({"waende", "wand"}),
    "An den Waenden des Raumes sind rundum Regale befestigt, nur in der "+
    "Wand zum Mannschaftsraum hin ist eine kleine Tuer.");
  AddDetail ( ({"mannschaftsraum"}),
    "Der liegt von hier aus gesehen vorne.");
  AddDetail ( ({"tuer", "tuere"}),
    "Eine kleine Tuer, die zum Mannschaftsraum fuehrt.");
  AddDetail ( ({"inhalt", "sack", "saecke"}),
    "Der Inhalt der Saecke ist wohl schon seit laengerer Zeit nicht mehr "+
    "zu gebrauchen, es scheint sich um verderbliche Nahrungsmittel "+
    "gehandelt zu haben.");
  AddDetail ( ({"kisten"}),
    "In den Kisten waren wohl einmal Nahrungsmittel eingelagert, jetzt "
    "sind sie zu einer undefinierbaren Masse verkommen.");
  AddDetail ( ({"dinge", "masse", "nahrungsmittel"}),
    "Die Nahrungsmittel sind absolut vergammelt, da ist nichts mehr zu "+
    "machen.");
  AddDetail ( ({"regal", "regale"}),
    "In den Regalen befanden sich wohl einst Nahrungsmittel, die "+
    "allerdings jetzt nicht mehr zu gebrauchen sind.");
  AddDetail ( ({"decke", "zwischendeck"}),
    "Die Decke des Raumes wird durch das Zwischendeck gebildet, welches "+
    "das ganze Schiff durchzieht.");
  AddDetail ( ({"schiff", "schiffswrack", "wrack"}),
    "Du befindest Dich mitten darin.");
  AddDetail ( ({"boden"}),
    "Der Boden des Schiffes besteht aus dem gleichen, fast weissen Holz "+
    "wie fast alles hier. Allerdings sind in diesem Raum die Ritzen "+
    "zwischen den Brettern etwas breiter, und an einer Stelle kannst Du ein "+
    "kleines, rundes Loch sehen, gerade gross genug, um zwei Finger "+
    "hindurchzustecken.");
  AddDetail ( ({"holz"}),
    "Es ist ein fast weissen, scheinbar sehr wiederstandsfaehiges Holz, "+
    "aus dem fast alles hier gefertigt ist. Als Du genauer hinschaust, "+
    "kannst Du eine ganz feine Maserung erkennen.");
  AddDetail ( ({"maserung"}),
    "Als Du genau hinsiehst, kannst Du eine sehr feine, hellgrauen "+
    "Maserung erkennen.");
  AddDetail ( ({"loch", "stelle","brett"}),
    "In einem der Bretter im Boden kannst Du ein kleines Loch erkennen, "+
    "gerade ausreichend, um zwei Finger hindurchzustecken. Wie es scheint, "+
    "kann man das Brett damit anheben.");
  AddDetail("finger",
    "Davon hast Du normalerweise zehn.");
  AddDetail ( ({"bretter", "ritzen"}),
    "In diesem Raum scheinen die Bretter am Boden ein wenig weniger "+
    "sorgfaeltig verlegt worden zu sein, als im Rest des Schiffes. "+
    "Allerdings ist auch hier der Boden stabil.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("vorne", ROOM+"/mannschaftsraum");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"hebe","heb"}), "hebe");
}

reset()
{
  schliess();
  ::reset();	
}

int hebe (string str)
{
  notify_fail ("Was moechtest Du anheben?\n");
  if (!str) return 0;
  if (-1!=member(({"platte an","brett an","bretter an"}),str))
  {
    write(BS("Vorsichtig hebst Du das Brett mit dem Loch an und legst es beiseite. "
             "Darunter kommt ein Hohlraum zum Vorschein."));
    AddDetail ( ({"boden"}),
    "Der Boden des Schiffes besteht aus dem gleichen, fast weissen Holz "+
    "wie fast alles hier. Allerdings sind in diesem Raum die Ritzen "+
    "zwischen den Brettern etwas breiter. Eins der Bretter ist herausgenommen "+
    "und liegt neben kleinen Hohlraum, der darunter versteckt war.");
    AddDetail(({"hohlraum"}),
      "Unter den Bodenbrettern befindet sich ein Hohlraum, der sich scheinbar "
      "durch das ganze Schiff zieht. Etwas Sand liegt hier unten drin.");
    AddDetail(({"sand"}),
      "Der Sand war wahrscheinlich einmal dazu gedacht, eindringende Feuchtigkeit "
      "aufzunehmen. Angesichts der Tatsache, dass das Schiff gesunken ist, ist das "
      "allerdings nicht mehr der Fall. Als Du genauer hinsiehst, entdeckst Du eine "
      "Erhebung im Sand.");
    AddDetail(({"feuchtigkeit"}),
      "Das, was jetzt hier unten herrscht, ist mehr als nur ein bisschen Feuchtigkeit.");
    AddDetail(({"erhebung"}),
      "Es scheint so, als waere da im Sand etwas versteckt.");
    AddCmd(({"such","suche","durchsuch","durchsuche","durchwuehl","durchwuehle"}),"suche");
    AddCmd(({"leg","lege"}),"lege");
    RemoveCmd(({"hebe","heb"}));
    return 1;
  }
  return 0;
}

int suche(string str)
{
  object questob;	

  notify_fail("Wo moechtest Du suchen?\n");
  if(!str) return 0;
  if (-1!=member(({"sand","in sand"}),str))
  {
    if (!questob=present("\nciritabarquestob",TP))
    {
      write(BS(
        "Du wuehlst im Sand, und bist Dir eigentlich sicher, dass hier "
        "etwas versteckt sein muesste. Aber Du findest nichts. Vielleicht "
        "kommst Du spaeter noch einmal wieder."));
    }
    else if (!present("\ncirinekromantenamulett",TP))
    {
      write(BS("Du wuehlst im Sand und findest schliesslich ein schweres Amulett, "
               "welches Du sofort an Dich nimmst."));
      if (TP->QueryProp(P_GUILD)=="Nekromanten")
        clone_object(ARMOUR"/pamulett")->move(TP,M_NOCHECK);
      else
        clone_object(ARMOUR"/namulett")->move(TP,M_NOCHECK);
      questob->GetAmulett();
    }
    else
    {
      write("Du wuehlst im Sand, kannst jedoch nichts finden.\n");	
    }
    lege("brett auf hohlraum");
    return 1;
  }
  return 0;
}

int lege(string str)
{
  notify_fail("Was moechtest Du wohin legen?\n");
  if (!str) return 0;
  if (-1!=member(({"brett auf hohlraum","platte auf hohlraum","brett in hohlraum",
  "platte in hohlraum"}),str))
  {
    write(BS("Du legst die Platte wieder ueber den Hohlraum."));
    schliess();
    return 1;
  }
  return 0;	
}

int schliess()
{
  RemoveCmd(({"leg","lege","such","suche","durchsuch","durchsuche","durchwuehl","durchwuehle"}));
  RemoveDetail(({"hohlraum","sand","feuchtigkeit","erhebung"}));
  AddDetail ( ({"boden"}),
    "Der Boden des Schiffes besteht aus dem gleichen, fast weissen Holz "+
    "wie fast alles hier. Allerdings sind in diesem Raum die Ritzen "+
    "zwischen den Brettern etwas breiter, und an einer Stelle kannst Du ein "+
    "kleines, rundes Loch sehen, gerade gross genug, um zwei Finger "+
    "hindurchzustecken.");	
  AddCmd ( ({"hebe","heb"}), "hebe");
  return 1;	
}