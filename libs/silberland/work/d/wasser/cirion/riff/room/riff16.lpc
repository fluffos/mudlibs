#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Suedlich des Korallenriffs");
  SetProp (P_INT_LONG,
    "Du schwimmst hier im weniger tiefen Wasser ueber dem Riff. Immer "+
    "wieder rollen hier grosse Wellen heran, so dass es schon recht "+
    "anstrengend ist, sich ueber Wasser zu halten. Die Wellen brechen sich "+
    "suedlich von hier am Riff. Im Norden liegt das offene Meer, das im "+
    "Licht der strahlenden Sonne silbrig glaenzt. Im Suedosten scheint sich "+
    "eine Art kleine Bucht im Riff zu oeffnen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist tiefblau und keine Wolke ist zu sehen. Dafuer scheint "+
    "die Sonne umso waermer herab.");
  AddDetail ( ({"wolke", "wolken"}),
    "Es ist weit und breit keine Wolke zu sehen.");
  AddDetail ( ({"sonne"}),
    "Die Sonne steht hoch am Himmel und laesst das Wasser rundherum "+
    "silbrig glaenzen und glitzern.");
  AddDetail ( ({"licht"}),
    "Das Licht der Sonne laesst das Wasser glitzern.");
  AddDetail ( ({"welle", "wellen"}),
    "Grosse Wellen rollen vom offenen Meer heran und brechen sich suedlich "+
    "von hier am Riff.");
  AddDetail ( ({"riff"}),
    "Das Riff erstreckt sich weit nach Osten und nach Westen.");
  AddDetail ( ({"bucht"}),
    "Eine schmale Passage oeffnet sich nach Suedosten, dort scheint eine "+
    "kleine Bucht zu liegen.");
  AddDetail ( ({"passage"}),
    "Die Passage ist recht schmal und fuehrt nach Suedosten.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Der Meeresboden ist hier nicht sehr tief, allerdings scheint er nach "+
    "Norden hin recht abrupt abzufallen.");
  AddDetail ( ({"meer"}),
    "Im Norden erstreckt sich das offene Meer bis zum Horizont, es glaenzt "+
    "silbrig im Licht der Sonne.");
  AddDetail ( ({"horizont"}),
    "Am Horizont scheinen Himmel und Meer ineinander ueberzugehen.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist klar und man kann bis zum Grund des Meeres hinabsehen.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("suedosten", ROOM+"/riff17");
  AddWaterExit ("westen",ROOM+"/riff15");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
