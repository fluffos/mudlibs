#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du bist jetzt schon ein Stueck am Riff entlang nach Westen "+
    "geschwommen, doch ein Ende ist nicht abzusehen. Die Bucht ist "+
    "inzwischen schon Deinem Blickfeld entschwunden, da die Kueste hier "+
    "einen Knick nach Westen macht.  Doch das Riff hat nichts von seiner "+
    "Schoenheit eingebuesst, immer noch leuchtet das Wasser rund um Dich "+
    "herum, und Du siehst im Norden die Wogen, die sich am Riff "+
    "brechen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"blickfeld", "bucht", "knick"}),
    "Da die Kueste hier eine Knick macht, kannst Du die Bucht nicht mehr "+
    "erkennen. Sie muss irgendwo im Suedosten jenseits des Strandes liegen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist herrlich blau, und die Sonne scheint warm, schon fast "+
    "unangenehm auf Dich herab. Da Du jedoch im Wasser schwimmst, macht Dir "+
    "das gar nichts aus.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Der Meeresboden ist einige Meter unter Dir, dort schwimmen die "+
    "verschiedensten Lebewesen. Um genaueres erkennen zu koennen, muesstest "+
    "Du schon hinuntertauchen.");
  AddDetail ( ({"lebewesen"}),
    "Die meisten Lebewesen schwimmen unten am Boden des Riffs. Von hier "+
    "kannst Du nichts genaueres erkennen.");
  AddDetail ( ({"kueste", "strand","westkueste","sandstrand"}),
    "Direkt suedlich von Dir erstreckt sich an der Kueste der wunderbare, "+
    "weisse Sandstrand von Tijaras Westkueste. Dahinter beginnt der "+
    "Dschungel.");
  AddDetail ( ({"dschungel"}),
    "Um Dir den Dschungel anzuschauen, solltest Du wohl besser wieder an "+
    "Land gehen.");
  AddDetail ( ({"land"}),
    "Um da hin zu gelangen, musst Du wohl wieder zurueck in die Bucht "+
    "schwimmen.");
  AddDetail ( ({"meer", "meerwasser", "wasser"}),
    "Das Wasser hier ist voellig klar und ziemlich ruhig, da das Riff im "+
    "Norden die grossen Wogen, die vom offenen Meer kommen, abfaengt.");
  AddDetail ( ({"wellen", "wogen"}),
    "Riesige Wellen kommen vom offenen Meer herangerollt und brechen sich "+
    "noerdlich des Riffs. Deswegen ist es einfach selbstmoerderisch, ueber "+
    "das Riff klettern zu wollen.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Korallenriff erstreckt sich von weit im Westen bis weit in den "+
    "Osten. Ausserdem schuetzt es die Kueste vor den rauhen Einfluessen des "+
    "offenen Meeres.");
  AddDetail ( ({"sonne"}),
    "Sie brennt heiss herunter, aber da Du im Wasser bist, macht Dir das "+
    "nicht viel aus.");
  AddDetail ( ({"dschungelstadt", "stadt", "tijara"}),
    "Die grosse Dschungelstadt Tijara muss irgendwo im Osten liegen, sie "+
    "ist jedenfalls nicht zu sehen.");
  AddDetail ( ({"schoenheit"}),
    "Die Schoenheit des Riffes und der Farben um Dich herum ist wirklich "+
    "ueberwaeltigend.");
  AddDetail ( ({"farbe", "farben"}),
    "Die Farben um Dich herum scheinen wohl von unten aus dem Wasser zu "+
    "kommen. Um die genauer zu untersuchen, muss man schon tauchen.");
  AddSmell(({DEFAULT_SMELL,"luft","meeresluft"}),
    "Du atmest tief ein und riechst die salzige Meeresluft.");  
  AddSound(({DEFAULT_SOUND}),
    "Bis auf das leise Plaetschern des Wassers ist es hier ruhig. Weit aus "
    "dem Norden hoert man das Rauschen der Brandung.");
  AddSound(({"plaetschern","wasser","wellen"}),
    "Leise plaetschern die Wellen vor sich hin.");
  AddSound(({"rauschen","brandung"}),
    "Das Rauschen der Brandung dringt leise an Dein Ohr.");
  // DETAILS END

  // ITEMS START
  // ITEMS END

  AddWaterExit("osten",ROOM+"/riff01");
  AddDiveExit("unten",ROOM+"/riff06");
}
