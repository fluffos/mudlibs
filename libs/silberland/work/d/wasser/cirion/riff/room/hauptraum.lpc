#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");


void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Im Schiffswrack");
  SetProp (P_INT_LONG,
    "Dies scheint wohl einmal eine Art grosser Aufenthaltsraum fuer die "+
    "gesamte Schiffsbesatzung gewesen zu sein. Ueberall liegen die "+
    "Ueberreste von Schiffsmoebeln und anderen Einrichtungsgegenstaenden "+
    "herum, teilweise schon in einem ziemlich verrotteten Zustand. Zu "+
    "beiden Seiten und nach vorne sind hier Bullaugen, durch die man das "+
    "Riff sehen kann. Im hinteren Teil des Raumes scheint einmal eine "+
    "Kueche gewesen zu sein. Mehrere Durchgaenge fuehren in andere Teile "+
    "des Schiffes. ");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"raum","aufenthaltsraum"}),
    "Dies scheint wohl einmal eine Art grosser Aufenthaltsraum fuer die "+
    "gesamte Schiffsbesatzung gewesen zu sein. Ueberall liegen die "+
    "Ueberreste von Schiffsmoebeln und anderen Einrichtungsgegenstaenden "+
    "herum, teilweise schon in einem ziemlich verrotteten Zustand. Zu "+
    "beiden Seiten und nach vorne sind hier Bullaugen, durch die man das "+
    "Riff sehen kann. Im hinteren Teil des Raumes scheint einmal eine "+
    "Kueche gewesen zu sein. Mehrere Durchgaenge fuehren in andere Teile "+
    "des Schiffes. ");
  
  AddDetail ( ({"besatzung", "schiffsbesatzung","leute","seeleute"}),
    "Die Besatzung dieses Schiffes wird sicher 15 Leute gehabt haben, wenn "+
    "das Schiff groessere Seereisen gemacht hat, auch wenn es im Normalfall "+
    "mit weniger Leuten gesteuert werden konnte. Bisher hast Du noch keine "+
    "Ueberreste der Besatzung gefunden, allerdings kannst Du nicht sagen, "+
    "ob von ihr nach all der Zeit ueberhaupt noch etwas uebrig geblieben "+
    "waere.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht hier aus den gleichen fast weissen Holzbohlen, aus "+
    "denen praktisch das gesamte Schiff bestanden hat. Es scheint ein sehr "+
    "hartes und wiederstandsfaehiges Holz zu sein, da es von seiner "+
    "Stabilitaet noch so gut wie gar nichts eingebuesst hat. Dabei liegt "+
    "das Schiff sicher schon mehrere Jahre hier auf dem Meeresboden. An der "+
    "linken Seite (der Backbordseite) des Schiffes ist eine Oeffnung im "+
    "Boden, dort scheint eine schmale Treppe nach unten zu fuehren.");
  AddDetail ( ({"durchgaenge", "gaenge","gang","durchgang"}),
    "Du siehst drei Durchgaenge: Eine Tuer fuehrt nach vorne, in den "+
    "Bugraum des Schiffes, eine nach hinten ins Heck. Des weiteren faellt "+
    "Dir eine Oeffnung im Boden auf, durch die man in den untern Teil des "+
    "Schiffes gelangen kann.");
  AddDetail ( ({"treppe"}),
    "Die schmale Treppe fuehrt durch ein Loch im Boden nach unten.");
  AddDetail ( ({"bugraum"}),
    "Der Bugraum befindet sich, wie der Name schon sagt, im Bug des "+
    "Schiffes. Du musst schon nach dort schwimmen, wenn Du ihn "
    "naeher betrachten moechtest.");
  AddDetail ( ({"bug","spitze"}),
    "Der Bug ist der vordere Teil eines Schiffes, seine Spitze.");
  AddDetail ( ({"reisen", "seereisen"}),
    "Das Schiff scheint allem Anschein nach voll hochseetauglich gewesen "+
    "zu sein, daher ist davon auszugehen, dass es lange Seereisen ueber "+
    "alle Meere des Silberlandes hinter sich hat.");
  AddDetail("meere",
    "Das Schiff scheint wirklich schon ueber alle Meere des Silberlandes "
    "gesegelt zu sein.");  
  AddDetail ( ({"bohlen", "holzbohlen"}),
    "Die Bohlen, aus denen das gesamte Schiff zu bestehen scheint, sind "+
    "aus einem sonderbaren, besonders harten und wiederstandsfaehigen Holz, "+
    "das fast ganz weiss ist. Eine Maserung ist kaum zu erkennen.");
  AddDetail ( ({"holz", "maserung"}),
    "Das Holz ist fast ganz weiss, nur sehr schwach kann man eine feine, "+
    "graue Maserung erkennen.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Durch die Bullaugen kannst Du draussen das Korallenriff erkennen. Um es "+
    "genauer zu betrachten, wirst Du das Wrack wohl wieder verlassen "+
    "muessen.");
  AddDetail ( ({"loch", "oeffnung"}),
    "Eine einfache, rechteckige Oeffnung an der Backbordseite des Raumes.");
  AddDetail ( ({"kueche"}),
    "Im hinteren Teil des Raumes scheint sich einmal eine Kueche befunden "+
    "zu haben. Eine Art Herd und mehrere Schraenke sind hier zu sehen, "+
    "allerdings ist ihr Zustand nur mehr recht jaemmerlich.");
  AddDetail ( ({"herd", "kochstelle","kohlenofen"}),
    "Es handelt sich um eine recht seltsame Kochstelle, eine Art "+
    "Kohlenofen aus Metall, auf dem man Toepfe erwaermen konnte. Allerdings "+
    "ist die Oberflaeche des Herdes von einer Art Zaun umgeben.");
  AddDetail ( ({"gitter", "zaun"}),
    "Es ist ein Gitter, welches Toepfe bei starkem Seegang vor dem "+
    "Herunterfallen bewahrte.");
  AddDetail ( ({"bullauge","bullaugen"}),
    "Die Bullaugen sind in der oberen Haelfte des Raumes und erlauben einen "+
    "Blick auf das Deck des Schiffswracks. Leider sind sie schon recht "+
    "gruen von den Algen hier unten, so dass die Aussicht getruebt ist.");
  AddDetail ( ({"heck"}),
    "Da Heck ist der hintere Teil des Schiffes.");
  AddDetail ( ({"schiff", "schiffswrack", "wrack","segler"}),
    "Du befindest Dich im Aufenthaltsraum innerhalb des Schiffswracks. Es "+
    "war sicher einstmals ein stolzer Segler, bevor er sein Ende zwischen "+
    "den scharfen Kanten des Riffes gefunden hat.");
  AddDetail("kanten",
    "Die Kanten kannst Du von hier drinnen nicht sehen.");
  AddDetail ( ({"silberland"}),
    "Das Silberland - so nennt sich die wunderschoene Welt, in der Du Dich "+
    "momentan befindest.");
  AddDetail ( ({"metall"}),
    "Der Herd besteht aus Metall, kein Eisen allerdings, da er nicht "+
    "rostet.");
  AddDetail ( ({"oberflaeche","meeresoberflaeche"}),
    "Die Meeresoberflaeche befindet sich sicher mehr als fuenf Meter ueber "+
    "Dir - und ist von hier aus weder zu sehen noch zu erreichen.");
  AddDetail ( ({"backbordseite", "backbord", "steuerbord", 
                "steuerbordseite","seite","seiten"}),
    "Die Backbordseite ist die linke Seite eines Schiffes, die "+
    "Steuerbordseite die rechte.");
  AddDetail ( ({"bordwand", "decke", "schiffswand", 
                "waende", "wand"}),
    "Sowohl Waende als auch Decke dieses Raumes bestehen aus diesem "+
    "eigentlich sehr schoenen, weissen Holz. In die Waende sind seitlich "+
    "Bullaugen eingelassen, durch die man nach draussen blicken kann.");
  AddDetail ( ({"algen"}),
    "Die Algen bedecken Teile der Bullaugen und erschweren so den Blick nach"+
    " draussen. Allerdings sind sie sicher eine gute Nahrung fuer manch "+
    "kleinen Fisch.");
  AddDetail ( ({"deck"}),
    "Deck nennt man die Oberflaeche eines Schiffes. Das Deck dieses Wracks "+
    "ist von hier drinnen schlecht zu sehen, es bildet die Decke dieses "+
    "Raumes.");
  AddDetail ( ({"eisen"}),
    "Das Metall ist Eisen bloss aehnlich, daher rostet es auch nicht.");
  AddDetail ( ({"besteck", "geschirr", "kochtoepfe", 
                "kochtopf", "toepfe", "topf"}),
    "Kochtoepfe, Geschirr und Besteck haben sich wohl beim Sinken des "+
    "Schiffes quer ueber den ganzen Boden verteilt.");
  AddDetail ( ({"stabilitaet", "zeit", "zustand"}),
    "Trotz der langen Zeit, die das Schiff nun schon hier unten liegen "+
    "mag, ist sein Zustand noch relativ gut und die Stabilitaet des Holzes "+
    "beeindruckend.");
  AddDetail ( ({"fisch", "fische", "meereslebewesen","lebewesen"}),
    "Natuerlich haben sich inzwischen einige kleine Fische und auch andere "+
    "Meereslebewesen einen Lebensraum hier erobert.");
  AddDetail ( ({"einrichtungsgegenstaende", "moebel", "schiffsmoebel","einrichtungsgegenstand","gegenstand","gegenstaende"}),
    "Hier steht ein grosser Tisch, mehrere Stuehle, und an den Waenden des "+
    "Raumes sind auch mehrere Schraenke angebracht.");
  AddDetail ( ({"tisch"}),
    "Ein grosser, runder Tisch, an dem die Seeleute sicher alle zusammen "+
    "die Mahlzeiten eingenommen haben und an dem sie abends feiern und "+
    "trinken konnten.");
  AddDetail ( ({"stuehle", "stuhl"}),
    "Hier liegen einige Stuehle herum, genug sicher fuer die gesamte "+
    "Besatzung des Schiffes. Die Polster sind mittlerweile fast voellig "+
    "verrottet, aber sonst sehen die Stuehle noch recht gut aus.");
  AddDetail ( ({"tuer", "tueren"}),
    "Eine Tuer fuehrt nach vorne, in Richtung Bug, durch die andere kann "
    "man in den Heckraum schauen.");
  AddDetail ( ({"heckraum"}),
    "Das scheint der Raum des Kapitaens gewesen zu sein, doch mehr kannst "+
    "Du von hier nicht erkennen.");
  AddDetail ( ({"ueberrest", "ueberreste"}),
    "Die Ueberreste sind fuer ihren mehrjaehrigen Aufenthalt hier unten "+
    "noch in relativ gutem Zustand.");
  AddDetail ( ({"polster"}),
    "Von den Polstern ist so gut wie nichts mehr uebrig.");
  AddDetail ( ({"schraenke", "schrank"}),
    "In den Schraenken finden sich alle moeglichen Gegenstaende, die die "+
    "Schiffsbesatzung im Alltag gebraucht hat.");
  AddDetail("alltag",
    "Stell Dir den Alltag auf einem Segelschiff einfach mal vor.");
  AddDetail ( ({"blick"}),
    "Vom Deck ist nur ein kleiner Teil zu sehen, von draussen kannst Du es "+
    "sicher besser sehen.");
  AddDetail ( ({"aussicht"}),
    "Du kannst ein wenig das Riff sehen, aber durch die Algen ist die "+
    "Aussicht getruebt.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("nach draussen", "nach draussen#"ROOM"/riff20");
  AddWaterExit ("vorne", ROOM+"/lagerraum");
  AddWaterExit ("unten", ROOM+"/mannschaftsraum");
  AddWaterExit ("hinten", ROOM+"/kapitaensraum");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
