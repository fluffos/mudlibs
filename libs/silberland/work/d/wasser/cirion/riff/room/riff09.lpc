#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit WROOM"/wroom";

int muschel;

void create()
{
  ::create();
  
  muschel=1;
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:22,ENV_TERRAIN:TT_UNDERWATER,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,
    "Hier ist es nun schon richtig hell, und man kann nach oben auftauchen. Allerdings "
    "ist Flora und Fauna hier spaerlicher als am uebrigen Riff. Nach "
    "Osten geht es wieder die Hoehle hinunter.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"flora", "pflanzen", "wasserpflanzen","pflanzenwelt"}),
    "Die Flora, das heisst die Pflanzenwelt ist hier eher spaerlich, es "+
    "wachsen nur einige kleine Pflanzen auf dem Boden oder an den Waenden.");
  AddDetail ( ({"fauna", "tier", "tiere", 
                "tierwelt"}),
    "Die Fauna, das heisst die Tierwelt, ist hier spaerlicher als an "+
    "anderen Stellen des Riffs.");
  AddDetail ( ({"waende"}),
    "Die Waende sind hier genauso zerklueftet wie im restlichen Riff auch. "+
    "Die Suedwand sieht allerdings etwas seltsam aus.");
  AddDetail ( ({"wand"}),
    "Die Waende sind hier genauso zerklueftet wie im restlichen Riff "+
    "auch...moechtest Du vielleicht eine spezielle Wand untersuchen?");
  AddDetail ( ({"suedwand"}),
    "In der Tat, die Suedwand ist ein wenig anders als die anderen Waende, "+
    "denn hier zieht sich ein ziemliche tiefer Spalt quer von rechts nach "+
    "links durch die Wand.");
  AddDetail ( ({"spalt","spalte"}),
    "Du schaust genauer in den Spalt hinein. Irgendeine seltsame Form "+
    "kannst Du ziemlich tief drinnen erkennen, aber was es ist...");
  AddDetail ( ({"form"}),
    "Die Form ist nicht sonderlich gross, vielleicht 10 Zentimeter. Sie "+
    "sieht fast aus...nein, es ist eine Muschel.");
  AddDetail ( ({"muschel"}),
    "Eine kleine Muschel, die liegt ziemlich tief da hinten in dem Spalt. "+
    "Mit blossen Haenden kommst Du da nicht dran. Vielleicht brauchst Du "+
    "irgendein Werkzeug?");
  AddDetail ( ({"haende", "haenden", "hand"}),
    "Nein, mit der Hand kommst Du wirklich nicht so tief in die Spalte "+
    "hinein.");
  AddDetail ( ({"werkzeug"}),
    "Ja, Du brauchst wohl ein laengliches Werkzeug, um nach der Muschel zu "+
    "stochern oder zu angeln.");
  AddDetail ( ({"stelle", "stellen"}),
    "Naja, zum Beispiel suedlich des Riffs.");
  AddDetail ( ({"decke"}),
    "Eine Decke gibt es hier nicht, ueber Dir ist die Wasseroberflaeche, "+
    "und von dort scheint das Licht herunter.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche","wasserflaeche"}),
    "Die Wasseroberflaeche ist nur einige Meter ueber Dir, und wird von "+
    "leichten Wellen gekraeuselt. Je nach dem, von wo Du schaust, sieht sie "+
    "fast aus wie ein Spiegel, der das Licht reflektiert.");
  AddDetail ( ({"licht", "schimmern"}),
    "Das Licht faellt von der Wasserflaeche herab und taucht die Hoehle in "+
    "ein silbriges Schimmern.");
  AddDetail ( ({"boden"}),
    "Der Boden faellt hier nach osten hin ein wenig ab, scheint so, als "+
    "wuerde es da nach unten gehen.");
  AddDetail ( ({"wellen"}),
    "Die Wasseroberflaeche wird von kleinen Wellen gekraeuselt, die das "+
    "Licht brechen und so seltsame Reflexe erzeugen.");
  AddDetail ( ({"reflex", "reflexe", "spiegel"}),
    "Das Licht wird an der Wasseroberflaeche gebrochen und reflektiert, "+
    "dadurch entstehen seltsame Reflexe.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Riff ist ueberall um Dich herum.");
  AddDetail ( ({"hoehle"}),
    "Die Hoehle fuehrt durch das Riff und scheint wohl mehrere Ausgaenge "+
    "zu haben.");
  AddDetail ( ({"ausgang"}),
    "Ein Ausgang ist wohl scheinbar ueber Dir.");
  AddDetail ( ({"ausgaenge"}),
    "Ein Ausgang ist wohl ueber Dir, und ein zweiter fuehrt nach Sueden "+
    "aus dem Riff heraus. Ob es wohl noch mehr Ausgaenge gibt?");
  // DETAILS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"stocher", "stocher", "stochere", "angel", "angle", "angele"}), "stocher");
  // EXITS START
  AddWaterExit ("osten",ROOM"/riff08");
  AddDiveExit ("oben",ROOM"/riff10");
  // EXITS END
}

reset()
{
  AddDetail ( ({"spalt","spalte"}),
    "Du schaust genauer in den Spalt hinein. Irgendeine seltsame Form "+
    "kannst Du ziemlich tief drinnen erkennen, aber was es ist...");
  AddDetail ( ({"form"}),
    "Die Form ist nicht sonderlich gross, vielleicht 10 Zentimeter. Sie "+
    "sieht fast aus...nein, es ist eine Muschel.");
  AddDetail ( ({"muschel"}),
    "Eine kleine Muschel, die liegt ziemlich tief da hinten in dem Spalt. "+
    "Mit blossen Haenden kommst Du da nicht dran. Vielleicht brauchst Du "+
    "irgendein Werkzeug?");

  muschel=1;
  ::reset();	
}

int stocher (string str)
{
  object ob,musch;
  notify_fail ("Wo mochtest Du stochern oder angeln?\n");
  if (-1==member(({"in spalt","in spalte","nach muschel","muschel"}),str)) return 0;
  ob=present("angel",TP);
  if (!ob) ob=present("Waffe",TP);
  if (!ob)
  {
    write("Du hast doch gar nichts zum stochern oder angeln.\n");
    return 1;
  }
  if (0==muschel)
  {
    write(BS("Du stocherst, findest aber nichts."));
    return 1;	
  }
  else
  {
    write(BS(
//      "Du stocherst mit "+ob->QueryArticle(2,1)+ob->QueryProp(P_NAME)+" in der Spalte und "
//      Also das ist pfusch, warum gibts die funktion name() ? - Feyaria
      "Du stocherst mit " + ob->name(WEM,1) + " in der Spalte und "
      "es gelingt Dir, eine kleine Muschel herauszubekommen."));
    muschel=0;
    musch=clone_object(OBJ+"/muschel");
    if(ME_TOO_MUCH==musch->move(TP,M_GET))
    {
      write("Du kannst die Muschel nicht mehr tragen und laesst sie fallen.\n");
      musch->move(ENV(TP),M_NOCHECK);
    }
    else
      write("Du nimmst die Muschel.\n");
    AddDetail ( ({"spalt","spalte"}),
      "Du schaust genauer in den Spalt hinein. Er scheint leer zu sein.");
    RemoveDetail(({"form","muschel"}));
  }
  return 1;
}
