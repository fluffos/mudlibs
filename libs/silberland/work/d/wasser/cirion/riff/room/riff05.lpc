#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du tauchst jetzt im Wasser knapp ueber dem Korallenriff. Die "+
    "herrlich bunten Farben sind jetzt ueberall um Dich herum, und Du "+
    "kannst jetzt auch Fische und Wasserpflanzen erkennen, die hier in "+
    "Huelle und Fuelle wachsen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Den Meeresboden bildet hier das Korallenriff. Es erstreckt sich von "+
    "weit im Westen bis weit in den Osten, so weit, dass Du das Ende nicht "+
    "sehen kannst. Doch das Riff ist nicht massiv, und so kannst Du unter "+
    "Dir zahllose Spalten und Hohlraeume sehen, die den Lebensraum vieler "+
    "Meeresbewohner bilden.");
  AddDetail ( ({"farbe", "farben"}),
    "Die bunten Farben ueberall um Dich herum stammen von riesigen "+
    "Schwaermen kleiner Fische, die ueberall um Dich herum schwimmen.");
  AddDetail ( ({"hohlraeume", "hohlraum", "spalte", 
                "spalten"}),
    "Ueber die vielen Jahre ist das Riff nicht ueberall gleichmaessig "+
    "gewachsen, daher sind ueberall kleine oder groessere Spalten oder "+
    "Hohlraeume, die den verschiedensten Meeresbewohnern als Lebensraum "+
    "dienen.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Riff ist unter Dir, es erstreckt sich bis weit nach Osten und "+
    "Westen, und im Norden bildet es eine Art natuerlicher Barriere.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Hier wachsen die verschiedensten Wasserpflanzen. Einige sehen fast "+
    "aus, wie kleine Buesche, wie Graeser, und viele sind so exotisch, dass "+
    "man sie nur schwer mit Dir bekannten Pflanzen vergleichen kann.");
  AddDetail ( ({"busch", "buesche", "graeser", 
                "gras"}),
    "Ja, die Pflanzen sehen teils so aehnlich aus, aber es sind sicher "+
    "keine Graeser oder Buesche.");
  AddDetail ( ({"barriere"}),
    "Das Riff versperrt wie eine Barriere den natuerlichen Weg noch Norden "+
    "aufs offene Meer hinaus. Wegen der hohen Wellen, die mit ungeheurer "+
    "Wucht von Norden auf das Riff einschlagen, ist es auch nicht ratsam, "+
    "ueber das Riff hinueberzuklettern.");
  AddDetail ( ({"bewohner", "meeresbewohner"}),
    "Hier leben alle moeglichen Arten von kleinen und groesseren "+
    "Meeresbewohnern.");
  AddDetail ( ({"himmel"}),
    "Den Himmel kannst Du von hier unten nur als eine verschwommene, blaue "+
    "Flaeche wahrnehmen.");
  AddDetail ( ({"wellen", "wucht"}),
    "Die Wellen schlagen mit grosser Wucht von Norden auf das Riff ein, "+
    "doch dieses haelt ihnen stand und schuetzt so die Bucht suedoestlich "+
    "von hier vor wiedrigen Einfluessen.");
  AddDetail ( ({"lebensraum", "nahrung", "schutz"}),
    "Die Spalten und Hohlraeume bilden den Lebensraum fuer viele kleine "+
    "Tierarten, die dort Nahrung und Schutz finden.");
  AddDetail ( ({"meer", "meerwasser", "wasser"}),
    "Das Meerwasser ist hier herrlich warm, so dass es total angenehm ist, "+
    "hier zu tauchen.");
  AddDetail ( ({"wellen", "wucht"}),
    "Von hier unten kannst Du die Wellen leider nicht sehen, dazu "+
    "muesstest Du schon wieder auftauchen.");
  // DETAILS END

  // ITEMS START
  // ITEMS END
  
  AddItem(NPC+"/regenbogenfische", REFRESH_DESTRUCT);
  
  AddWaterExit("westen",ROOM"/riff04");
  AddDiveExit("oben",ROOM"/riff02");
 
}
