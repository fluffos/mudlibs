#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Die Bucht scheint hier zu Ende zu sein, und das Rauschen der sich "+
    "brechenden Wellen im Norden ist etwas leiser geworden. Die Sonne "+
    "scheint warm herab und bringt die Wasseroberflaeche zum Glitzern. "+
    "Nur wenige Meter unter Dir liegt der Bug des Schiffswracks auf dem "+
    "Grund des Riffs. Einige Fische scheinen dort zu schwimmen, und es "+
    "ist merklich dunkler als hier oben an der Wasseroberflaeche.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddSound ( ({DEFAULT_SOUND, "rauschen"}),
    "Du hoerst immer noch das Rauschen aus dem Norden.");
  AddDetail ( ({"bucht"}),
    "Die Bucht ist annaehernd kreisrund und hat nur eine schmale Passage "+
    "nach Nordwesten aufs Meer hinaus.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist strahlend blau, kein Woelkchen ist zu sehen. Dafuer "+
    "scheint die Sonne umso waermer herab.");
  AddDetail ( ({"sonne","sonnenstrahlen","strahlen"}),
    "Die Sonnenstrahlen erwaermen das Wasser und glitzern auf der "+
    "Wasseroberflaeche.");
  AddDetail ( ({"woelkchen", "wolke", "wolken"}),
    "Es sind keine Wolken am Himmel zu sehen.");
  AddDetail ( ({"passage"}),
    "Eine recht schmale Passage, die aufs Meer hinausfuehrt.");
  AddDetail ( ({"bug", "spitze"}),
    "Der Bug ist die vordere Spitze des schlanken Schiffswracks, das hier "+
    "auf dem Meeresgrund liegt.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Auf dem Meeresgrund liegt das Wrack eines schlanken Seglers, bei dem "+
    "offenbar der Mast abgebrochen ist.");
  AddDetail ( ({"mast"}),
    "Der Mast ist knapp unter der Wasseroberflaeche abgebrochen.");
  AddDetail ( ({"glitzern"}),
    "Es ist ein fast magisches Glitzern, welches die Sonne auf der "+
    "Wasseroberflaeche hervorruft.");
  AddDetail ( ({"schiffswrack", "segler", "wrack"}),
    "Das Wrack unter Dir war sicher einst ein stolzer Segler, bis es ein "+
    "Ende am Grund des Riffes gefunden hat.");
  AddDetail ( ({"welle", "wellen"}),
    "Grosse Wellen brechen sich noerdlich von Dir am Riff, was ein lautet "+
    "Rauschen verursacht. Die Wellen schwappen auch immer wieder bis hier.");
  AddDetail ( ({"meer"}),
    "Noerdlich der Bucht liegt das offene Meer, das sich bis zum Horizont "+
    "und wahrscheinlich auch weit darueber hinaus erstreckt.");
  AddDetail ( ({"horizont"}),
    "Fern am Horizont scheint es fast, als waere das Silberland dort zu "+
    "Ende.");
  AddDetail ( ({"silberland"}),
    "Du befindest Dich mittendrin, also wirst Du es ja wohl auch kennen, oder?");
  AddDetail ( ({"ende"}),
    "Hier scheint das suedliche Ende der beinah kreisrunden Bucht zu sein.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Rund um Dich herum und auch unter Dir liegt das Korallenriff. Es "+
    "erstreckt sich weit von Osten nach Westen.");
  AddDetail ( ({"fische"}),
    "Von hier oben kannst Du von den Fischen nicht sehr viel sehen.");
  AddDetail ( ({"wasser"}),
    "Das Wasser hat hier eine wunderbare, tiefblaue Faerbung und ist "+
    "kristallklar.");
  AddDetail ( ({"faerbung"}),
    "Die tiefblaue Faerbung ist wirklich wunderbar.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche ist wegen der Wellen, die vom Meer hier "+
    "hereinkommen recht unruhig, und die Sonne malt glitzernde Reflexe auf "+
    "die Wellen.");
  AddDetail ( ({"lichtreflexe", "reflexe"}),
    "Die Lichtreflexe glitzern wunderschoen.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("norden", ROOM"/riff17");
  AddDiveExit ("unten",ROOM"/riff19");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
