#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Noerdlich des Korallenriffs");
  SetProp (P_INT_LONG,
    "Endlich tauchst Du noerdlich des Riffs auf. Hier kommen immer wieder "+
    "grosse Wellen herangerollt, die sich dann im Sueden am Riff brechen. "+
    "Der Geraeuschpegel hier ist ohrenbetaeubend, aber das Schauspiel ist "+
    "wunderschoen. Du kannst von hier aus weit auf das offene Meer "+
    "hinausschauen, und es ist auch wieder ein wenig waermer, da die "+
    "Sonne scheint.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"geraeuschpegel"}),
    "Vielleicht solltest Du mal lauschen?");
  AddSound ( ({DEFAULT_SOUND, "geraeusch", "geraeuschpegel", 
                "lied"}),
    "Laut und ohrenbetaeubend ist hier das Lied des Meeres, mit dem grosse "+
    "Wellen sich am Riff brechen, und doch ist es ein angenehmes Geraeusch.");
  AddDetail ( ({"himmel"}),
    "Tiefblau ist der Himmel, und kein Woelkchen ist zu sehen, nur die "+
    "warme Sonne, die aufs Wasser herabscheint.");
  AddDetail ( ({"sonne", "sonnenstrahlen", "strahlen"}),
    "Die Sonne wirft ihre warmen Strahlen auf die Wasseroberflaeche herab "+
    "und bringt sie zum glitzern.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche ist unruhig, da immer wieder aufs neue grosse "+
    "Wellen vom offenen Meer heranrollen.");
  AddDetail ( ({"woelkchen", "wolke", "wolken"}),
    "Es ist weit und breit kein Woelkchen zu sehen.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Der Meeresboden sinkt unter Dir leicht nach Osten ab, es scheint so, "+
    "als koennte man dort unter einen Vorsprung des Riffes tauchen. Nach "+
    "Norden hin sinkt der Meeresboden immer schneller ab und verschwindet "+
    "bald im Dunkel der Tiefe.");
  AddDetail ( ({"dunkel", "tiefe"}),
    "In der Tiefe des Meeres ist es sehr dunkel.");
  AddDetail ( ({"auslaeufer", "schauspiel", "welle", 
                "wellen"}),
    "Immer wieder rollen grosse Wellen heran, brechen sich und ihre "+
    "Auslaeufer spuelen ueber das Riff hinweg.");
  AddDetail ( ({"vorsprung"}),
    "Um den genauer untersuchen zu koennen, wirst Du wohl hinabtauchen "+
    "muessen.");
  AddDetail ( ({"meer"}),
    "Nach Norden hin erstreckt sich bis weit ueber den Horizont hinaus das "+
    "offene Meer. Grosse Wellen rollen von dort heran und brechen sich am "+
    "Riff.");
  AddDetail ( ({"horizont"}),
    "Am Horizont scheint es so, als wuerde Meer und Himmel sich beruehren.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist zwar kuehl, aber es ist klar und man kann bis zum "+
    "Grund hinuntersehen.");
  AddDetail(({"riff","korallenriff"}),
    "Das Riff erstreckt sich weit von West nach Ost, und die Wellen vom "
    "offenen Meer brechen sich daran.");
  // DETAILS END

  // EXITS START
  AddWaterExit("osten",ROOM+"/riff16");
  AddWaterExit("ostunten",ROOM+"/riff14");
  //Hier gehts zukuenftig weiter in die Tiefe, zu den Seepferdchen-Transportern
  //AddWaterExit ("westen", "/d/wasser/cirion/seepferdchen/room/riffe5");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
