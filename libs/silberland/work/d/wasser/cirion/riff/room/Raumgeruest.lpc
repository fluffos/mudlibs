/* Raumgeruest */

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
	::create();

	SetProp( P_INT_SHORT, "" );
	SetProp( P_INT_LONG,([0:
		"Du schwimmst noerdlich einer kleinen Bucht im Meer. Obwohl es hier schon recht tief ist, kannst Du immer noch den Meeresgrund erkennen. \n"
	+	"\n"
	                     ,"tritone",
	        "\n"
	+	"\n"	        
	        );
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 3 );

	SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER,]);

	AddDetail( ({ "", "" }),
		"\n"
	+	"\n"
	);
	AddDetail( ({ "", "", }),
		"\n"
	);
	AddDetail( "",
		"\n"
	);
	AddDetail( "" ,
		"\n"
	+	"\n"
	);

	AddCmd( ({ "cmd", "", "",
		"", "" }), "fkt" );
	AddExit( "ausg", "path" );
}

fkt( str )
{
	notify_fail( "Arg fehlt" );
	if( str == "arg1" )
	{
		write( "\n" );
		return 1;
	}
	if ( str == "arg2a" || str == "arg2b" )
	{
		write( "\n" );
		return 1;
	}
	if ( query_verb() == "verb" &&
		( str == "arg3a" || str == "arg3b" ) )
	{
		write(
			"\n"
		);
		say(
			this_player()->name(WER,2)+"\n"
		);
		return 1;
	}
	return 0;
}
