#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  SetProp(P_OBEN,"/riff15");
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Noerdlich des Korallenriffs");
  SetProp (P_INT_LONG,
    "Hier steigt das Riff unter Dir ein wenig an, und auch der Ueberhang "+
    "ueber Dir zieht sich zurueck. Rundherum siehst Du viele verschiedene "+
    "Fische, die hier ihren Lebensraum haben. Das Riff erstreckt sich wie "+
    "eine gewaltige Mauer, welche die Bucht schuetzt, nach West und Ost. "+
    "Im Norden ist das offene Meer, Du kannst einige Hundert Meter weit "+
    "sehen und erkennst, dass der Meeresboden hier stark abfaellt und "+
    "bald im Dunkel verschwindet.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Hier ist der Meeresboden noch fast waagerecht, doch nach Norden hin "+
    "faellt er immer steiler ab und verschwindet bald im Dunkel der Tiefe.");
  AddDetail ( ({"bucht"}),
    "Die Bucht liegt suedlich des Riffs, aber sehen kannst Du von ihr "+
    "nichts.");
  AddDetail ( ({"mauer"}),
    "Wie eine gewaltige, aber auch sehr unregelmaessige Mauer erstreckt "+
    "sich das Riff hier von Ost nach West und schuetzt die Bucht und auch "+
    "die Kueste vor den Gewalten des offenen Meeres.");
  AddDetail ( ({"gewalt", "gewalten"}),
    "Im Moment ist das Meer bis auf die hohen Wellen sehr ruhig, aber "+
    "wehe, wenn einer der gewaltigen tropischen Stuerme aufzieht...");
  AddDetail ( ({"stuerme", "sturm"}),
    "Die tropischen Gegenden sind bekannt fuer die gewaltigen tropischen "+
    "Stuerme, die hier von Zeit zu Zeit wueten.");
  AddDetail ( ({"welle", "wellen"}),
    "Die Wasseroberflaeche noerdlich von Dir wird von grossen Wellen "+
    "gekraeuselt, allerdings ist davon hier unten nicht sehr viel zu "+
    "spueren.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche noerdlich von Dir wird von grossen Wellen "+
    "gekraeuselt.");
  AddDetail ( ({"gegend", "gegenden", "tropen"}),
    "Die Gegend hier nennt man Tropen.");
  AddDetail ( ({"dunkel", "dunkelheit"}),
    "In der Tiefe des Meeres herrscht absolute Dunkelheit.");
  AddDetail ( ({"meer"}),
    "Das offene Meer beginnt hier, es erstreckt sich bis weit nach Norden. "+
    "Allerdings kannst Du nicht ganz so weit sehen, da das Wasser nicht "+
    "voellig klar ist.");
  AddDetail ( ({"tiefe"}),
    "Der Meeresboden verschwindet nach Norden hin schon recht bald in der "+
    "Tiefe.");
  AddDetail ( ({"kueste"}),
    "Die Kueste liegt suedlich des Riffs.");
  AddDetail ( ({"himmel"}),
    "Den Himmel kann man nur am blaeulichen Farbton ueber der "+
    "Wasseroberflaeche erkennen.");
  AddDetail ( ({"farbton"}),
    "Ein tiefes blau.");
  AddDetail ( ({"arten", "fisch", "fische", 
                "lebewesen", "meereslebewesen"}),
    "Alle moeglichen Arten von Fischen und anderen Meereslebewesen "+
    "schwimmen hier herum.");
  AddDetail ( ({"lebensraum"}),
    "Hier ist ein optimaler Lebensraum fuer unzaehlige Lebewesen.");
  AddDetail ( ({"ueberhang"}),
    "Das Riff hat hier einen leichten Ueberhang gebildet, welcher sich "+
    "genau ueber Dich nach Norden woelbt.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Korallenriff erstreckt sich weit von Ost nach West.");
  AddDetail ( ({"wasser"}),
    "Das Wasser hier ist tiefblau, aber wenn man nach Norden schaut, kann "+
    "man bemerken, dass es nicht voellig klar ist, sondern ein wenig "+
    "getruebt.");
  // DETAILS END

  // EXITS START
  AddWaterExit("osten",ROOM"/riff13");
  AddHiddenWaterExit("westen",ROOM+"/riff15");
  AddWaterExit("westoben",ROOM+"/riff15");
  // EXITS END

  // ITEMS START
  AddItem(NPC+"/krabbe", REFRESH_DESTRUCT);
  // ITEMS END

}
