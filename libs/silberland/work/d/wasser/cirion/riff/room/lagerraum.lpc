#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

object *this_reset;
object *last_reset;
int ring;

void create()
{
  ::create();
  this_reset=last_reset=({});
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Ein Lagerraum");
  SetProp (P_INT_LONG,
    "Dies hier scheint der Lagerraum des Schiffes gewesen zu sein. "+
    "Ueberall stehen Kisten und Ballen herum, die sich teilweise schon "+
    "fast aufgeloest haben. Die Decke des Raumes ist eingebrochen, so "+
    "dass man nach oben hinausschwimmen kann. Durch das Loch sieht man "+
    "oben die Wasseroberflaeche.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"deck", "decke"}),
    "Das Deck des Schiffes bildet die Decke dieses Raumes. Der Zahn der "+
    "Zeit hat vor dem Deck nicht haltgemacht, und so ist hier ein Loch, "+
    "gross genug, hindurch und nach draussen zu schwimmen.");
  AddDetail ( ({"lagerraum", "raum"}),
    "Dies hier scheint der Lagerraum des Schiffes gewesen zu sein. "+
    "Ueberall stehen Kisten und Ballen herum, die sich teilweise schon "+
    "fast aufgeloest haben. Die Decke des Raumes ist eingebrochen, so "+
    "dass man noch oben hinausschwimmen kann. Durch das Loch sieht man "+
    "oben die Wasseroberflaeche.");
  AddDetail ( ({"boden"}),
    "Der Boden dieses Raumes besteht, wie fast alles an diesem Schiff, aus "+
    "einem fast weissen Holz von erstaunlicher Widerstandfaehigkeit.");
  AddDetail ( ({"ballen", "fracht", "kisten", 
                "ladung"}),
    "Offensichtlich handelt es sich bei den vielen Kisten und Ballen hier "+
    "um die Ladung des Schiffes. Die moeglichst platzsparend verstaute "+
    "Fracht macht den Raum unuebersichtlich, und obwohl der Grossteil der "+
    "Ladung keinen guten Eindruck mehr macht, kann man doch nicht sagen, ob "+
    "nicht das ein oder andere brauchbare Stueck darunter ist.");
  AddDetail ( ({"grossteil"}),
    "Die allermeisten Ballen sind schon halb verrottet, und in so gut wie "+
    "jede Kiste wird das salzige Meerwasser eingedrungen sein, welches so "+
    "gut wie jede Ware unbrauchbar machen kann. Du entdeckst jedoch eine "
    "kleine Kiste ganz vorne am Bug, welche wesentlich stabiler aussieht, "
    "als die Uebrigen.");
  AddDetail ( ({"kiste","kleine kiste"}),
    "Eine kleine Kiste steht ganz vorne am Bug. Sie ist aus einem hellen, "
    "offensichtlich ziemlich wasserresistenten Holz, so dass sie bisher "
    "vom Wasser kaum angegriffen wurde. Vielleicht kannst Du sie oeffnen?");  
  AddDetail ( ({"loch", "oeffnung"}),
    "Eine mehr oder minder grosse Oeffnung ziert die Decke dieses Raumes. "+
    "Durch sie hindurch kann man sowohl schwimmen als auch die "+
    "Wasseroberflaeche betrachten. Es scheint so, als waer dieser Teil der "+
    "Decke durch die lange Zeit hier unten einfach morsch geworden und "+
    "eingebrochen.");
  AddDetail ( ({"holz"}),
    "Dieses fast weisse Holz scheint eine einzigartige "+
    "Widerstandsfaehigkeit zu besitzen, die sowohl der Faeulnis als auch "+
    "hohen Kraeften standhaelt. Wenn man ganz genau hinsieht, kann man im "+
    "Holz eine feine, graue Maserung erkennen.");
  AddDetail ( ({"widerstandsfaehigkeit"}),
    "Du hast ein solch widerstandsfaehiges Holz noch nie gesehen, es "+
    "scheint einigen Wert zu haben, insbesondere fuer den Schiffbau.");
  AddDetail ( ({"wand"}),
    "Welche Wand moechtest Du betrachten?");
  AddDetail ( ({"waende"}),
    "An Back- und Steuerbordwand sind Haken und Oesen angebracht, um die "+
    "Ladung sicher zu verstauen. Anders als in den anderen Schiffsraeumen "+
    "scheint es hier keine Fenster oder Bullaugen zu geben. In die Bugwand "+
    "scheinen zwei kleine Tueren eingelassen zu sein, waehrend in der "+
    "Heckwand ein Durchgang in den mittleren Teil des Schiffes eingelassen "+
    "ist.");
  AddDetail ( ({"tuer"}),
    "Die Tuer in der Rueckwand des Raumes scheint in den mittleren Teil "+
    "des Schiffes zu fuehren.");
  AddDetail ( ({"tueren"}),
    "Die zwei kleinen Tueren in der Bugwand scheinen einen Hohlraum zu "+
    "verschliessen, der sich im Bug des Schiffes befindet.");
  AddDetail ( ({"heckwand","schraenke","schrank"}),
    "An der Heckwand sind einige kleinere Schraenke befestigt, in denen "+
    "sich im wesentlichen Werkzeug und Reparaturmaterial fuer den "+
    "Schiffszimmermann zu befinden scheint.");
  AddDetail ( ({"material", "reparaturmaterial"}),
    "Hier finden sich sowohl Holzstuecke in unterschiedlichen Groessen und "+
    "Formen als auch Duebel, Naegel und Schrauben, die zum Reparieren eines "+
    "beschaedigten Schiffes unabdingbar sind.");
  AddDetail ( ({"werkzeug", "werkzeuge"}),
    "Die Werkzeuge sind alle schon recht verrostet und laengst nicht mehr "+
    "in dem Zustand, wie andere Teile des Wracks das noch sind. Ihnen sieht "+
    "man ihr Alter an. Es finden sich unter anderem Haemmer, Zangen, Saegen "+
    "und Brecheisen hier.");
  AddDetail ( ({"bullauge", "bullaugen", "fenster"}),
    "In diesem Raum gibt es keine Fenster oder Bullaugen. Wozu auch, es "+
    "ist schliesslich ein Lager- und kein Aufenthaltsraum.");
  AddDetail ( ({"haken", "oese", "oesen"}),
    "Die Haken und Oesen dienen zum Vertaeuen der Ladung unter Deck, so "+
    "dass sie bei kraeftigem Seegang nicht kreuz und quer durcheinander "+
    "purzelt.");
  AddDetail ( ({"bugwand"}),
    "Die Bugwand dieses Raumes verschliesst den Bugraum. Dieser scheint "+
    "durch zwei kleine, in die Wand eingelassene Tueren erreichbar.");
  AddDetail ( ({"bugraum", "hohlraum"}),
    "Es handelt sich dabei wohl um den Raum, der sich im vordersten Bug "+
    "des Schiffes befindet, und durch Tueren von hier aus erreichbar ist.");
  AddDetail ( ({"schraenke", "schrank"}),
    "Die Schraenke bestehen hier aus groeberen Brettern, als die Moebel in "+
    "den anderen Raeumen. Sie enthalten mehrere tiefe Faecher, aus denen "+
    "das Werkzeug nicht herausfallen kann.");
  AddDetail ( ({"haemmer", "hammer", "zange", 
                "zangen","saege","saegen"}),
    "Die Werkzeuge sind alt und verrostet, man kann sie eigentlich nicht "+
    "mehr recht brauchen.");
  AddDetail ( ({"brecheisen"}),
    "Das ist ein grosses Brecheisen, das einem Kuhfuss aehnelt, weil es "+
    "eine leicht gespaltene Spitze hat.");
  AddDetail ( ({"kuhfuss"}),
    "Ein grosses Brecheisen.");
  AddDetail ( ({"schiffszimmermann", "zimmermann"}),
    "Auf jedem Schiff sollte es wohl mindestens einen Zimmermann geben, "+
    "der kleinere oder groessere Reparaturen durchfuehren kann.");
  AddDetail ( ({"brett", "bretter"}),
    "Auch die Bretter hier sind aus diesem seltsamen Holz.");
  AddDetail ( ({"meer", "meerwasser", "wasser"}),
    "Das Wasser ist ueberall um Dich herum. Es ist sehr wahrscheinlich "+
    "auch der Grund fuer den recht schlechten Zustand von einigen Dingen "+
    "hier unten.");
  AddDetail ( ({"bug"}),
    "Der Bug ist die Spitze des Schiffes.");
  AddDetail ( ({"backbord", "steuerbord"}),
    "Backbord ist die linke Seite eines Schiffes, Steuerbord seine "+
    "rechte.");
  AddDetail ( ({"holzstuecke", "planken"}),
    "Bei den Holzstuecken sind sowohl gerade Bretter und Balken als auch "+
    "gebogene Planken.");
  AddDetail ( ({"duebel", "naegel", "schrauben"}),
    "Duebel, Naegel und Schrauben findest Du einige in den Schraenken "+
    "hier. Allerdings sind die meisten Naegel und Schrauben recht verrostet "+
    "und somit unbrauchbar, wohingegen die Duebel, da aus Holz, "+
    "aufgequollen sind.");
  AddDetail ( ({"durchgang"}),
    "Der Durchgang in der Heckwand fuehrt wohl in den mittleren Teil des "+
    "Schiffes.");
  AddDetail ( ({"faecher"}),
    "Das sind tiefe Faecher, in denen Werkzeug und Material liegt, damit "+
    "es bei Seegang nicht herausfallen kann.");
  AddDetail ( ({"faeulnis", "kraefte"}),
    "Sowohl Faeulnis als auch hohe Kraefte scheinen diesem Holz so "+
    "schnell nichts anhaben zu koennen.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche befindet sich etwa 5 Meter ueber Dir, und Du "+
    "kannst sie bloss durch das Loch in der Decke sehn. Ein wenig Licht "+
    "faellt von dort oben herein, aber zum sehen wuerde es kaum ausreichen.");
  AddDetail ( ({"licht", "sehen"}),
    "Das bisschen Licht, das von oben hereinfaellt, wuerde zum Sehen kaum "+
    "ausreichen.");
  AddDetail ( ({"verfallserscheinungen", "zustand"}),
    "Der Zustand des Wrackes an sich ist noch sehr gut, wenn man bedenkt, "+
    "dass es schon einige Jahre hier unten liegen muss. Einzig das Loch in "+
    "der Decke zeugt von Verfallserscheinungen. Die Ladung des Schiffes, "+
    "die sich in diesem Raum befunden hat, ist allerdings deutlich "+
    "angegriffener, um nicht zu sagen voellig nutzlos.");
  AddDetail ( ({"moebel"}),
    "Hier sind bloss die Schraenke an der Heckwand der Raumes.");
  AddDetail ( ({"heck"}),
    "Das Heck ist der hintere Teil des Schiffes.");
  AddDetail ( ({"backbordwand", "steuerbordwand"}),
    "An dieser Wand sind einige Haken und Oesen befestigt, mit welchen "+
    "wiederum die Ladung gehalten wird.");
  AddDetail ( ({"maserung"}),
    "Es ist eine ganz feine, fast silbrig graue Maserung, die das Holz "+
    "durchzieht.");
  AddDetail ( ({"schiff", "schiffswrack", "wrack"}),
    "Du befindest Dich wohl offensichtlich im Lagerraum des "+
    "Schiffswracks.");
  AddDetail ( ({"eindruck"}),
    "Die Ladung war wohl nicht so widerstandsfaehig wie das Holz, aus "+
    "dem das Schiff gefertigt ist, daher ist sie grossteils voellig "+
    "unbrauchbar geworden.");
  AddDetail(({"seil","seile","segel"}),
    "Die Segel und Seile, die vorne im Bugraum liegen, sind alle schon "
    "halb verrottet und unbrauchbar.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("hinten", "nach Hinten#"+ROOM+"/hauptraum");
  AddHiddenWaterExit("nach draussen","nach draussen#"ROOM"/riff19");
  AddHiddenWaterExit("in loch","nach draussen#"ROOM"/riff19");
  AddHiddenWaterExit("durch loch","nach draussen#"ROOM"/riff19");
  AddHiddenWaterExit("in oeffnung","nach draussen#"ROOM"/riff19");
  AddHiddenWaterExit("durch oeffnung","nach draussen#"ROOM"/riff19");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"nehme","nehm", "nimm"}), "nehmen");
  AddCmd ( ({"oeffne"}),"oeffnen");
}

reset()
{
  ::reset();
  last_reset=this_reset;
  this_reset=({});
  ring--;
  if(ring<0) ring=0;
}

int oeffnen(string str)
{
  object ob;
  
  notify_fail("Was moechtest Du denn oeffnen?\n");

  if ((str=="tuer")||(str=="tuere"))
  {
    write(BS("Die Tuer nach hinten ist doch schon offen."));
  }
  else if ("tueren"==str)
  {
    write(BS(
      "Die Tueren klemmen ein wenig, scheinbar sind sie durch die lange Zeit "
      "hier unter Wasser etwas aufgequollen, aber schliesslich bekommst Du "
      "sie auf. Etwas enttaeuscht blickst Du in den Bugraum, denn ausser "
      "alten, halb verrotteten Seilen und Segeln findest Du hier nichts."));
  }
  else if (str=="kiste" || str=="kleine kiste")
  {
    call_other("/players/cirion/projekte/eringmaster",
               "find_elemental_ring",TP,"wasser");
    if (ring)
    {
      write(BS(
        "Die kleine Kiste laesst sich wirklich hervorragend oeffnen. Sie "
        "ist jedoch bis auf einige halb verottete Kissen und Tuecher "
        "voellig leer."));
      tell_room(ME,BS(
        CAP_TPN+" oeffnet eine kleine Kiste am Bug und durchwuehlt sie."),
        ({TP}));
    }
    else
    {
      write(BS(
        "Die kleine Kiste laesst sich wirklich hervorragend oeffnen. In Ihr "
        "findest Du, eingepackt in einige halb verottete Kissen und Tuecher, "
        "einen kleinen blauen Ring welcher vollstaendig aus Wasser zu "
        "bestehen scheint. Du steckst ihn sofort ein."));
      tell_room(ME,BS(
        CAP_TPN+" oeffnet eine kleine Kiste am Bug, durchwuehlt sie, und "
        "scheint dabei etwas gefunden zu haben, was "+TP->QueryPronoun()+" einsteckt."),
        ({TP}));
      ob=clone_object("/gilden/druidenzirkel/armour/elementarring");
      ob->set_ring_element("wasser");
      ob->move(TP, M_NOCHECK);
      ring+=2;
    }
  }
  else
    return 0;
  return 1;
}

int nehmen (string str)
{
  notify_fail ("Was moechtest Du nehmen?\n");
  if (-1==member(({"kuhfuss","brecheisen"}),str)) return 0;
  if ((-1==member(this_reset,TP))&&(-1==member(last_reset,TP)))
  {
    clone_object(WEAPON"/kuhfuss")->move(TP,M_NOCHECK);
    write(BS("Du nimmst den Kuhfuss aus dem Schrank.\n"));
    this_reset+=({TP});
  }
  else
  {
    write("Die uebrigen Brecheisen sind alt und verrostet.\n");
  }
  return 1;
}
