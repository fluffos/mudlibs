/* Leerraum zum aufraeumen */

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,
    "Dies ist ein voellig unintressanter und leerer Raum, der lediglich "
    "dazu dient, die nicht mehr benoetigten Tabare im Spiel aufzunehmen, "
    "damit sie nicht aufwendig zerstoert werden muessen, sondern durch die "
    "Standardmechanismen entsorgt werden.");
}

reset()
{
  int i;
  object *inv;
  ::reset();
  inv=all_inventory();
  for(i=sizeof(inv);i-->0;)
  {
    inv[i]->remove();
    if (inv[i]) destruct(inv[i]);
  }
  inv=all_inventory();
  for(i=sizeof(inv);i-->0;)
  {
    inv[i]->remove();
    if (inv[i]) destruct(inv[i]);
  }
}

varargs int PreventInsert(object ob)
{
  if (query_once_interactive(ob))
    return 0;
  return ::PreventInsert(ob);
}