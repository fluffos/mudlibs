#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:24,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du befindest Dich in einer kleinen Oeffnung an der Oberseite des "+
    "Korallenriffs. Hier scheint die Sonne wieder auf Dich herab, und das "+
    "Wasser ist wieder wohlig warm. Rund um Dich herum kannst Du die "+
    "Oberflaeche des Riffs sehen, das an einigen Stellen aus dem Wasser "+
    "ragt. Gar nicht weit von hier im Norden brechen sich riesige Wellen "+
    "vom offenen Meer am Riff, und ihre Auslaeufer schwappen immer wieder "+
    "bis hier und spuelen ueber die Hoehlenoeffnung hinweg. Das Wasser im "+
    "Sueden scheint in verschiedenen Farben zu leuchten, um dich herum "+
    "ist es jedoch kristallklar und blau.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist herrlich blau, kein einziges Woelkchen ist zu sehen, "+
    "und auch die Sicht ist gut.");
  AddDetail ( ({"woelkchen", "wolke", "wolken"}),
    "Wolken kannst bis zum Horizont keine sehen, dafuer scheint die Sonne, "+
    "als waere es das letzte Mal.");
  AddDetail ( ({"sonne"}),
    "Heiss scheint die Sonne herab, aber Dir macht das nichts aus, "+
    "schliesslich schwimmst Du im Wasser.");
  AddDetail ( ({"ende", "hoehle", "hoehlenoeffnung","unterwasserhoehle", 
                "oeffnung"}),
    "Du schwimmst wohl am oberen Ende einer Unterwasserhoehle, die in das "+
    "Riff hineinfuehrt.");
  AddDetail ( ({"horizont", "luft", "sicht"}),
    "Die Luft ist so klar und die Sicht so gut, dass Du bis zum Horizont "+
    "sehen kannst. Im Norden siehst Du nur das offene Meer, im Westen geht "+
    "es weit den Strand entlang, im Osten kannst Du in der Ferne einige "+
    "Haeuser, ja eine Stadt sehen, nur im Sueden wird Dein Blick durch den "+
    "Dschungel begrenzt.");
  AddDetail ( ({"bucht", "dschungel", "kueste", 
                "palmen", "sandstrand", "strand", 
                "sueden"}),
    "Suedlich des Riffs siehst Du eine kleine Bucht, dann folgt ein "+
    "wunderbarer weisser Sandstrand mit einigen Palmen, und dahinter "+
    "beginnt der undurchdringliche Dschungel.");
  AddDetail ( ({"ferne", "haeuser", "hafenstadt", 
                "osten", "stadt", "tijara"}),
    "Bei der Stadt in der Ferne muss es sich wohl um Tijara, die "+
    "Hafenstadt des Dschungels handeln.");
  AddDetail ( ({"farben"}),
    "Das Wasser suedlich des Riffs leuchtet in den verschiedensten Farben. "+
    "Wenn Du Dir das anschauen moechtest, solltest Du wohl mal da hin "+
    "schwimmen.");
  AddDetail ( ({"wasser"}),
    "Das Wasser um Dich herum ist kristallklar, so dass Du bis auf den "+
    "Grund des Riffs schauen kannst. Suedlich des Riffs leuchtet das Wasser "+
    "in den verschiedensten Farben, und im Norden sieht es tiefblau aus.");
  AddDetail ( ({"meer", "norden"}),
    "Im Norden ist das offene Meer. Tiefblau erstreckt es sich bis zum "+
    "fernen Horizont. Die grossen Wellen, die von draussen herein kommen, "+
    "brechen sich am Nordende des Riffs.");
  AddDetail ( ({"auslaeufer", "nordende", "wellen"}),
    "Grosse Wellen vom offenen Meer brechen immer wieder ueber das "+
    "Nordende des Riffs herein, und ihre Auslaeufer schwappen auch immer "+
    "wieder ueber diese Oeffnung hinweg. Doch das Riff schuetzt die Bucht "+
    "und das Festland vor den Auswirkungen der Wellen.");
  AddDetail ( ({"festland"}),
    "Das Festland liegt im Sueden, dort ist der Dschungel.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Du kannst bis unten zum Grund der Hoehle hinabsehen. Dort macht die "+
    "Hoehle einen Knick nach Osten.");
  AddDetail ( ({"knick"}),
    "Ein Knick nach Osten.");
  AddDetail ( ({"oberflaeche"}),
    "Meinst Du die Wasseroberflaeche oder die Riffoberflaeche?");
  AddDetail ( ({"wasseroberflaeche"}),
    "Die Wasseroberflaeche ist hier ziemlich unruhig, denn immer wieder "+
    "spuelen grosse Wellen vom Norden her ueber das Riff.");
  AddDetail ( ({"riffoberflaeche"}),
    "Eigentlich sieht man die Oberflaeche des Riffs gerade nicht, da sie "+
    "einige Zentimeter unterhalb der Wasseroberflaeche liegt. Allerdings "+
    "scheint sie ziemlich zerklueftet zu sein, und wegen der grossen Wellen "+
    "waere es auch viel zu gefaehrlich, darueber zu klettern.");
  AddDetail ( ({"blick"}),
    "Er wird nur im Sueden vom Dschungel beschraenkt, in allen anderen "+
    "Richtungen kannst Du bis zum Horizont sehen.");
  AddDetail ( ({"oberseite", "seite"}),
    "Das ist die Seite, die oben liegt.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Riff ist ueberall um Dich herum, Du schwimmst mittendrin.");
  AddSmell(({DEFAULT_SMELL,"luft","meeresluft"}),
    "Du atmest tief ein und riechst die salzige Meeresluft.");
  AddSound(({DEFAULT_SOUND,"rauschen","wellen"}),
    "Du hoerst von Norden das gewaltige Rauschen der sich brechenden Wellen.");  
  // DETAILS END

  // ITEMS START
  // ITEMS END

  // EXITS START
  AddDiveExit ("unten",ROOM"/riff09");
  // EXITS END
}
