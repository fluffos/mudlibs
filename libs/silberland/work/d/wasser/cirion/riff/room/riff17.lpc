#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Als Du in die Bucht hineinschwimmst, glaubst Du Deinen Augen nicht "+
    "zu trauen: Geschuetzt vom Riff rundherum liegt hier knapp unter der "+
    "Wasseroberflaeche ein grosses Schiffswrack. Da der Mast abgebrochen "+
    "zu sein scheint, ist von dem Wrack aus groesserer Entfernung nichts "+
    "zu sehen. Die Wassertemperatur ist hier auch wieder etwas hoeher, da "+
    "es ein wenig ruhiger ist, als im Norden. Das Rauschen der Wellen, "+
    "die sich hier am Riff brechen, ist wirklich ohrenbetaeubend, und doch "+
    "fuehlst Du Dich hier geschuetzt. Das Wrack erstreckt sich noch weiter "+
    "nach Sueden.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Der Himmel ist strahlend blau, kein Woelkchen ist zu sehen. Dafuer "+
    "scheint die Sonne umso waermer auf das Silberland herab.");
  AddDetail ( ({"silberland"}),
    "Du befindest Dich mittendrin, also wirst Du ja wohl wissen, was das "+
    "Silberland ist, oder?");
  AddDetail ( ({"sonne"}),
    "Die hellen Strahlen der Sonne erwaermen das Wasser und bringen es zum "+
    "Glitzern.");
  AddDetail ( ({"glitzern"}),
    "Es sind die Sonnenstrahlen, die auf dem Wasser glitzern und "+
    "reflektiert werden.");
  AddDetail ( ({"sonnenstrahlen", "strahlen"}),
    "Sie sind schoen hell und warm.");
  AddDetail ( ({"woelkchen", "wolke", "wolken"}),
    "Es ist keine Wolke zu sehen.");
  AddDetail ( ({"mast"}),
    "Der Mast des Schiffswrack ist kurz unterhalb der Wasseroberflaeche "+
    "abgebrochen, so dass man von weiter weg nichts von dem Schiff erkennen "+
    "kann.");
  AddDetail ( ({"schiff", "schiffswrack", "wrack"}),
    "Es scheint das Wrack eines hellen, schlanken Schiffes zu sein, "+
    "welches hier auf dem Grund des Riffes liegt. Wenn Du Dir das genauer "+
    "ansehen moechtest, wirst Du schon hinabtauchen muessen.");
  AddDetail ( ({"bucht"}),
    "Eine kleine, fast kreisrunde Bucht liegt hier tief in das Riff "+
    "eingeschnitten. Rundum liegt das gewaltige Korallenriff, und nach "+
    "Norden kannst Du durch eine schmale Passage wieder herausschwimmen.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Auf dem Grund dieser Bucht hier liegt das Wrack eines Schiffes.");
  AddDetail ( ({"passage"}),
    "Die Passage ist recht schmal und fuehrt genaugenommen nach "+
    "Nordwesten.");
  AddDetail ( ({"rauschen"}),
    "Vielleicht solltest Du Dir das mal anhoeren.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst ein ohrenbetaeubendes Rauschen.");
  AddSound ( ({"rauschen"}),
    "Mit einem ohrenbetaeubenden Rauschen brechen die Wellen im Norden "+
    "ueber das Riff herein.");
  AddDetail ( ({"welle", "wellen"}),
    "Grosse Wellen vom offenen Meer rollen vom Norden heran und brechen "+
    "sich hier am Riff.");
  AddDetail ( ({"temperatur", "wassertemperatur"}),
    "Die Temperatur ist etwas angenehmer als im offenen Meer.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Korallenriff erstreckt sich weit von Ost nach West.");
  AddDetail ( ({"wasser"}),
    "Das Wasser hat hier eine tiefblaue Faerbung, und ist so klar, dass "+
    "man bis auf den Grund der Bucht schauen kann.");
  AddDetail ( ({"faerbung", "farbe"}),
    "Eine wirklich herrliche, tiefblaue Farbe.");
  AddDetail ( ({"meer"}),
    "Noch Norden hin erstreckt sich das offene Meer bis weit zum Horizont "+
    "und glitzert in der strahlenden Sonne.");
  AddDetail ( ({"horizont"}),
    "Am Horizont scheint es beinahe so, als wuerden Himmel und Meer sich "+
    "beruehren.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche ist hier noch ziemlich unruhig wegen der "+
    "Wellen, die sich hier brechen, aber im Sueden ist sie schon glatter.");
  // DETAILS END

  // EXITS START
  AddWaterExit ("sueden", ROOM"/riff18");
  AddWaterExit ("nordwesten", ROOM"/riff16");
  AddDiveExit ("unten",ROOM"/riff20");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
