#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,
    "Die Hoehle oeffnet sich hier nach Norden hin ins offene Meer. Eine "+
    "kuehle Stroemung kommt hier herein, und laesst die Wasserpflanzen "+
    "schwanken. Hier beginnnt sich sowohl Flora als auch Fauna etwas zu "+
    "veraendern und an die kuehlere Umgebung anzupassen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "decke", "waende", 
                "wand"}),
    "Sowohl Boden und Decke als auch Waende bestehen hier nur aus "+
    "Korallen, die eine sehr unregelmaessige Oberflaeche geschaffen haben. "+
    "An den Waenden und auf dem Boden wachsen auch einige Wasserpflanzen, "+
    "die sich leicht in der Stroemung wiegen.");
  AddDetail ( ({"hoehle"}),
    "Die Hoehle zieht sich quer durch das ganze Riff, sie beginnt im "+
    "Sueden in der Bucht von Tijara und scheint hier nach norden ins offene "+
    "Meer zu fuehren.");
  AddDetail ( ({"tijara"}),
    "Tijara kannst Du von hier aus sicher nicht sehen.");
  AddDetail ( ({"bucht"}),
    "Die Bucht liegt suedlich des Riffs, aber von hier aus ist sie sicher "+
    "nicht sichtbar.");
  AddDetail ( ({"stroemung"}),
    "Die kuehle Stroemung scheint vom offenen Meer zu kommen.");
  AddDetail ( ({"umgebung"}),
    "Die Umgebung ist das Riff.");
  AddDetail ( ({"korallen"}),
    "Die Korallen sind winzige Lebewesen, die alle aufeinander wachsen und "+
    "so dieses Riff gebildet haben.");
  AddDetail ( ({"lebewesen"}),
    "Ausser den Korallen sind hier natuerlich auch noch viele andere "+
    "Lebewesen: Wasserpflanzen, Fische und Krebse, und auch einige, die Du "+
    "noch nie zuvor gesehen hast.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Riff ist riesengross, allerdings kannst Du von hier drinnen nicht "+
    "sehr viel davon sehen.");
  AddDetail ( ({"wasseroberflaeche"}),
    "Die Wasseroberflaeche kannst Du von hier aus nicht sehen.");
  AddDetail ( ({"meer"}),
    "Vor Dir im Norden liegt das weite, offene Meer. Dunkelblau leuchtet "+
    "es fast, und je tiefer man schaut, desto dunkler wird es. Der "+
    "Meeresgrund faellt vor dem Riff rasch steil ab, und viel tiefer "+
    "solltest Du Dich wegen des Drucks auch nicht begeben.");
  AddDetail ( ({"drucks"}),
    "Drucks? Heisst das nicht 'Druck'?");
  AddDetail ( ({"druck", "wasserdruck"}),
    "Der Wasserdruck wird staerker, ja tiefer man kommt. Hier ist es noch "+
    "auszuhalten, aber wenn viel tiefer koenntest Du wohl nicht tauchen.");
  AddDetail ( ({"grund", "meeresgrund"}),
    "Der Meeresgrund ist bewachsen mit allerlei Pflanzen, aber er "+
    "verschwindet nach wenigen Metern vor Dir in der Tiefe und somit aus "+
    "Deiner Sicht.");
  AddDetail ( ({"dunkelheit", "sicht", "tiefe"}),
    "Deine Sicht wird durch die Dunkelheit in der Tiefe eingeschraenkt.");
  AddDetail ( ({"flora", "pflanzen", "wasserpflanzen"}),
    "Hier wachsen die unterschiedlichsten Wasserpflanzen, und fast alle von "+
    "ihnen sind Dir voellig unbekannt. Trotzdem sind sie wunderschoen.");
  AddDetail ( ({"fauna", "fische", "krebse"}),
    "Hier leben die unterschiedlichsten Fische und  schwimmen zwischen den "+
    "Wasserpflanzen umher, und auch Krebse, die am Boden herumkrabbeln oder "+
    "sich vor Dir verstecken.");
  AddDetail ( ({"oberflaeche"}),
    "Die Oberflaeche von Waenden, Decke und Boden ist sehr unregelmaessig, "+
    "ja fast zerklueftet.");
  // DETAILS END

  // ITEMS START
  // ITEMS END

  // EXITS START
  AddWaterExit ("westunten",ROOM+"/riff11");
  AddHiddenWaterExit ("nach westen","nach Westunten#"+ROOM+"/riff11");
  AddWaterExit ("nordosten",ROOM+"/riff13");
  // EXITS END
}
