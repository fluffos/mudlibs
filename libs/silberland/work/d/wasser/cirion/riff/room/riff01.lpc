#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");


void create()
{
 ::create();
   	
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du schwimmst in den blauen Wogen des Meeres noerdlich der Bucht von\n"+
    "Tijara. Direkt vor Dir siehst Du ein riesiges Korallenriff, dessen\n"+
    "Schoenheit jede Beschreibung uebertrifft, die Du je vernommen hast.\n"
    "Das Wasser rundherum leuchtet in den verschiedensten Farben.\n"+ 
    "Das Riff erstreckt sich so weit Du sehen kannst nach Westen. Im Osten\n"+
    "kannst Du in der Ferne den Hafen von Tijara erkennen.\n");
    // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail(({"regenbogen"}),
    "Du siehst hier keinen Regenbogen, nur die Farben, die in ihm vorkommen.");
  AddDetail(({"farbe","farben","farbenpracht"}),
    "Das Wasser hier leuchtet in allen Farben des Regenbogens. Du kannst "
    "allerdings nicht erkennen, woher diese sagenhafte Farbenpracht kommt.");
  AddDetail(({"schoenheit","beschreibung"}),
    "Die Schoenheit des Korallenriffes uebertrifft wirklich jede Beschreibung. "
    "Das Wasser hier leuchtet in den verschiedensten Farben, und im Norden "
    "brechen sich grosse Wellen am Riff.");
  AddDetail (({"milliarde","milliarden","abermilliarden"}),
    "Das sind eine ganze Menge.");
  AddDetail("menge","Viele halt.");
  AddDetail ( ({"bucht"}),
    "Die Bucht liegt suedlich von Dir. Sie wird von allen Seiten von einem "+
    "wunderschoenen weissen Sandstrand eingefasst, nur in Deine Richtung "+
    "ist sie geoeffnet. Das Wasser in der Bucht ist so klar, dass Du "+
    "problemlos den Meeresgrund unter Dir sehen kannst. Suedlich der Bucht "+
    "beginnt der undurchdringliche Dschungel.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Direkt vor Dir im Norden liegt das Korallenriff. Es besteht aus "+
    "Milliarden und Abermilliarden winziger Korallen. Noerdlich des Riffs "+
    "siehst Du das offene Meer, von dort brechen sich immer wieder grosse "+
    "Wellen am Riff, so dass ein Erklettern des Riffs unmoeglich ist.\n"+
    "Du kannst Dir gut vorstellen, dass das Riff Lebensraum fuer "+
    "unzaehlige Tiere und Pflanzen bietet, doch hier, ueber der "+
    "Wasseroberflaeche, ist davon nichts zu sehen.");
  AddDetail ( ({"wasser","oberflaeche","wasseroberflaeche"}),
    "Das Wasser hier ist herrlich warm und kristallklar, so dass Du bis "+
    "zum Meeresgrund hinuntersehen kannst. Vielleicht sind dort unten "+
    "Fische?");
  AddDetail ( ({"fische", "pflanzen", "tiere","lebewesen","meereslebewesen"}),
    "Du kannst am Grund des Meeres, auf dem Korallenriff, viele "+
    "verschiedene Tiere und Pflanzen sehen, aber leider erkennst Du von "+
    "hier oben nichts genaueres.");
  AddSmell ( ({DEFAULT_SMELL,"luft","geruch"}),
    "Du atmest tief ein. Frisch riecht die Luft, und stark salzig.");
  AddSound ( ({DEFAULT_SOUND, "meer", "rauschen"}),
    "Du hoerst das laute Rauschen der Wellen, die sich noerdlich des Riffs "+
    "brechen. Wenn man sich dort befindet, muss es ohrenbetaeubend sein.");
  AddDetail ( ({"stadt", "tijara","ferne"}),
    "Die Stadt Tijara liegt oestlich von hier in der Ferne. Du kannst nur "
    "schemenhaft ihren Hafen erkennen.");
  AddDetail ( ({"hafen"}),
    "Der Hafen liegt oestlich von hier und ist nur schemenhaft zu "+
    "erkennen.");
  AddDetail ( ({"korallen"}),
    "Die Korallen sind eigentlich winzige Meereslebewesen, die aufeinander "+
    "wachsen und somit in Hunderten von Jahren dieses Riff gebildet haben.");
  AddDetail ( ({"dschungel", "kueste", "sand", 
                "strand", "ufer","sandstrand"}),
    "Um da etwas genaueres erkennen zu koennen, musst Du schon naeher "+
    "heranschwimmen.");
  AddDetail ( ({"boden", "grund", "meereboden", 
                "meeresgrund"}),
    "Der Meeresgrund hier wird auch vom Korallenriff gebildet, welches "+
    "sich unter Wasser noch ein Stueck weiter nach Sueden erstreckt. Du "+
    "kannst dort unten einige Tiere und Pflanzen erkennen.");
  AddDetail (({"stueck"}),
    "Das Riff erstreckt sich noch einige Meter nach Sueden.");
  AddDetail ( ({"wellen","wogen","welle","woge"}),
    "Die Wellen brechen sich noerdlich von hier am Riff.");
  AddDetail ( ({"meer","see"}),
    "Hier ist das Meer ruhig und warm. Doch noerdlich des Riffs beginnt "+
    "die offene See mit ihren grossen Wellen. Dort ist es sicher viel "+
    "unangenehmer und gefaehrlicher als hier.");
  AddDetail ( ({"himmel", "woelkchen"}),
    "Am azurblauen Himmel ist weit und breit nicht das kleinste Woelkchen "+
    "zu sehen. Dafuer kommt es Dir vor, als scheine die Sonne hier mit "+
    "vermehrter Intensitaet.");
  AddDetail ( ({"sonne"}),
    "Dir kommt es so vor, als brenne die Sonne hier mit vermehrter "+
    "Intensitaet herunter. Doch das macht Dir nichts aus, denn das so "+
    "erwaermte Wasser hat genau die richtige Temperatur zum Baden.");
  AddDetail("baden",
    "Das tust Du gerade.");
  AddDetail ( ({"hitze", "temperatur", "waerme"}),
    "Obwohl die Lufttemperatur recht hoch ist, ist es hier im Wasser doch "+
    "sehr angenehm, genau richtig zum Baden.");
  AddDetail ( ({"lebensraum"}),
    "Das Riff ist sicher Lebensraum fuer Hunderte von Tieren und Pflanzen. "+
    "Doch von hier kannst Du kaum welche erkennen.");
  AddDetail ( ({"lufttemperatur"}),
    "Die Lufttemperatur ist sicher ziemlich hoch hier, da Du allerdings im "+
    "Wasser schwimmst, macht Dir das nicht viel aus, im Gegenteil, es ist "+
    "herrlich angenehm.");
  AddSmell(({DEFAULT_SMELL,"luft","meeresluft"}),
    "Du atmest tief ein und riechst die salzige Meeresluft.");  
  AddSound(({DEFAULT_SOUND}),
    "Bis auf das leise Plaetschern des Wassers ist es hier ruhig. Weit aus "
    "dem Norden hoert man das Rauschen der Brandung.");
  AddSound(({"plaetschern","wasser","wellen"}),
    "Leise plaetschern die Wellen vor sich hin.");
  AddSound(({"rauschen","brandung"}),
    "Das Rauschen der Brandung dringt leise an Dein Ohr.");
  // DETAILS END

  // EXITS START
   // EXITS END

  // ITEMS START
  // ITEMS END

  //BEGIN AddCmd
  //END AddCmd 
  
  AddWaterExit("sueden","/d/dschungel/feyaria/kueste/room/bucht");
  AddWaterExit("westen",ROOM+"/riff03");
  AddWaterExit("osten",ROOM+"/riff02");
  AddDiveExit("unten",ROOM+"/riff04");
}
