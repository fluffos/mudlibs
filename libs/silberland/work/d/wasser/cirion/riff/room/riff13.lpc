#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:18,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Noerdlich des Korallenriffs");
  SetProp (P_INT_LONG,
    "Du schwimmst jetzt fast schon im offenen Meer. Hier ist es deutlich "+
    "kaelter als suedlich des Riffs, und es leben hier auch ganz andere "+
    "Pflanzen und Tiere. Direkt ueber Dir ist noch ein Ueberhang des "+
    "Riffs, daher kannst Du hier noch nicht auftauchen. Ebensowenig "+
    "moechtest Du nach Norden ins offene Meer hinausschwimmen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Den Himmel kannst Du von hier unten nicht sehen, dafuer befindet sich "+
    "ueber Dir ein Ueberhang, den das Riff hier gebildet hat.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Hier ist der Boden noch fast waagerecht, aber nach Norden hin faellt "+
    "das Riff steil ab und der Meeresgrund verschwindet im Dunkel der "+
    "Tiefe.");
  AddDetail ( ({"tiefe","meerestiefe"}),
    "Hier betraegt die Tiefe vielleicht 5 Meter, doch nach norden hin "+
    "faellt der Meeresboden steil ab. Dort unten solltest Du aufgrund des "+
    "hohen Druckes ohne Schutz besser nicht tauchen.");
  AddDetail ( ({"druck"}),
    "Der Druck ist hier noch zu ertragen, aber in zunehmender Tiefe wird "+
    "er sicher unertraeglich.");
  AddDetail ( ({"ueberhang"}),
    "Das Riff ist hier zu einer Art Ueberhang gewachsen, so dass Du dich "+
    "auf einer Art Gang befindest, der nur nach norden hin geoeffnet ist.");
  AddDetail ( ({"gang"}),
    "Naja, es ist kein wirklicher Gang, was hier von West nach Ost "+
    "verlaeuft, aber es wirkt fast so.");
  AddDetail ( ({"meer"}),
    "Nach Norden hin oeffnet sich das weite Meer. Dunkelblau erstreckt es "+
    "sich vor Dir, bis Dein Blick das Wasser nicht mehr durchdringen kann.");
  AddDetail ( ({"wasser"}),
    "Du tauchst mittendrin. Rund um Dich herum ist das Wasser sauber und "+
    "klar, wenn auch salzig. Allerdings hat es doch eine gewisse Truebung, "+
    "so dass man nicht ganz so weit sehen kann, wie an der Luft.");
  AddDetail ( ({"truebung"}),
    "Sie ist eigentlich nicht zu sehen, man erkennt sie nur daran, dass "+
    "man nicht ganz so weit schauen kann.");
  AddDetail ( ({"dunkel"}),
    "In zunehmender Meerestiefe wird es immer dunkler, da das Licht das "+
    "Wasser nicht mehr durchdringen kann.");
  AddDetail ( ({"luft"}),
    "Wenn Du Luft holen moechtest, musst Du schon auftauchen, aber hier "+
    "geht das wegen des Ueberhangs ueber Dir nicht.");
  AddDetail ( ({"licht"}),
    "Das Licht faellt durch die Wasseroberflaeche und durchdringd das "+
    "ganze Meer bis zu einer gewissen Tiefe.");
  AddDetail ( ({"blick"}),
    "Dein Blick reicht einige hundert Meter weit hier unter Wasser.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Hier siehst Du die Wasseroberflaeche nicht, wegen des Ueberhangs "+
    "ueber Dir. Allerdings kannst Du sie im Norden erkennen.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Hier wachsen die merkwuerdigsten Wasserpflanzen, von denen Du die "+
    "meisten noch nie gesehen hast. Die Pflanzen sind auch ganz anders als "+
    "die in suedlich des Riffs, wohl wegen des kuehleren Wassers und der "+
    "staerkeren Stroemungen hier.");
  AddDetail ( ({"stroemung", "stroemungen"}),
    "Hier am offenen Meer sind die Stroemungen natuerlich staerker als "+
    "suedlich des Riffs.");
  AddDetail ( ({"schutz"}),
    "Dir faellt kein Schutz ein, der Dich vor dem Druck in der Tiefe "+
    "schuetzen koennte.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Du schwimmst direkt an der Nordseite des Riffes, das sich weit von "+
    "Westen nach Osten erstreckt.");
  AddDetail ( ({"nordseite", "suedseite"}),
    "Die Nordseite des Riffes ist hier, und sie ist etwas kuehler und "+
    "rauher als die Suedseite.");
  AddDetail ( ({"bewohner", "meeresbewohner", "tier", 
                "tiere"}),
    "Auch hier schwimmen die unterschiedlichsten Meeresbewohner herum.");
  // DETAILS END
  AddItem(NPC+"/krabbe", REFRESH_DESTRUCT);
  // EXITS START
  AddWaterExit ("suedwesten", "nach Suedwesten#"+ROOM+"/riff12");
  AddWaterExit ("westen", "nach Westen#"+ROOM+"/riff14");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
