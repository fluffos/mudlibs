#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21]));
  SetProp (P_INT_SHORT, "Am Schiffswrack");
  SetProp (P_INT_LONG,
    "Du schwimmst jetzt knapp ueber dem Deck des versunkenen Schiffes. Es "+
    "muss einst ein wunderschoenes, schlankes Schiff gewesen sein, aus "+
    "fast weissem Holz. Doch nun liegt es schon seit Jahren hier unten "+
    "und verfault langsam aber sicher. Mittschiffs ist ein kleiner Aufbau "+
    "zu sehen, wohl eine Kajuete. Weiter im Sueden liegt der Bug des "+
    "Schiffes.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail(({"deck","schiffsdeck"}),
    "Das Deck des Schiffes besteht aus dicken weissen Holzbohlen. Es scheint "
    "dafuer, dass es schon lange hier unten liegen muss, noch in einem relativ "
    "guten Zustand zu sein.");
  AddDetail(({"schiff","wrack","schiffswrack","segler"}),
    "Dieses Schiffswrack war einst sicher ein stolzer Segler, der die weiten "
    "Meere des Silberlandes durchpfluegte.");
  AddDetail(({"holz"}),
    "Das gesamte Schiff besteht aus einem hellen, fast weissen Holz. Als Du genauer "
    "hinsiehst, kannst Du eine feine, hellgraue Maserung erkennen.");
  AddDetail(({"maserung","auge"}),
    "Die Maserung ist wirklich sehr fein und mit blossem Auge kaum zu erkennen.");
  AddDetail(({"aufbau","kajuete"}),
    "Die Kajuete hat nach hinten eine offene Tuer, an den Seiten sind einige "
    "Bullaugen zu erkennen. Genau in der Mitte des Dachs der Kajuete steht "
    "der Mast des Schiffes.");
  AddDetail(({"tuer"}),
    "Die Tuer fuehrt ins Innere des Schiffes.");
  AddDetail(({"innere","inneres"}),
    "Davon kannst Du von hier draussen nicht viel sehen. Aber Du "
    "kannst vielleicht hineinschwimmen.");
  AddDetail(({"dach","kajuetendach"}),
    "Das Dach der Kajuete besteht aus dem selben Holz, wie der Rest des Schiffes "
    "auch. In der Mitte des Daches steht der Mast des Schiffes.");
  AddDetail(({"bullauge","bullaugen"}),
    "Durch die Bullaugen kann man aus dem Schiffsinneren herausschauen.");
  AddDetail(({"mast"}),
    "Der Mast des Schiffes war ziemlich dick, und er muss auch sicher 15 "
    "oder 20 Meter hoch gewesen sein. Allerdings ist er in ungefaehr zwei Metern Hoehe "
    "ueber dem Kajuetendach abgebrochen.");
  AddDetail(({"holzbohlen","bohlen"}),
    "Die Bohlen sind fast 20 Zentimeter dick und aus dem selben stabilen Holz "
    "wie der Rest des Schiffes auch.");
  AddDetail(({"sueden","bug"}),
    "Suedlich von hier siehst Du den Bug des Schiffes. Dort scheint auch ein grosses Loch "
    "im Schiffsdeck zu sein.");
  AddDetail(({"loch"}),
    "Von hier kannst Du das nicht erkennen.");
  AddDetail ( ({"meer", "meerwasser", "wasser"}),
    "Das Meerwasser ist ueberall um Dich herum, und es ist ziemlich salzig. "+
    "Ausserdem ist es hier auch kaelter als suedlich des Riffs.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Korallenriff bildet hier eine kleine Bucht, in welcher das "+
    "Schiffswrack liegt.");
  AddDetail ( ({"bucht"}),
    "Die Bucht ist nicht sonderlich gross, vielleicht dreissig Meter in "+
    "der Laenge und nicht einmal halb so breit.");
  AddDetail ( ({"laenge"}),
    "Die Bucht ist dreissig Meter lang.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Du siehst vom Meeresgrund hier nicht sehr viel, da da das "+
    "Schiffswrack liegt.");
  AddDetail ( ({"himmel"}),
    "Du kannst den Himmel ueber der Wasseroberflaeche sehen. Von dort oben "+
    "faellt ein blaeulicher Lichtschein herab.");
  AddDetail ( ({"licht", "lichtschein", "schein"}),
    "Blaeuliches Licht faellt von oben durch die Wasseroberflaeche herab "+
    "und taucht alles in eine seltsame Atmosphaere.");
  AddDetail ( ({"meeresoberflaeche", "oberflaeche", "wasseroberflaeche"}),
    "Die Meeresoberflaeche liegt etwa fuenf Meter ueber Dir und wird von "+
    "einigen Wellen gekraeuselt.");
  AddDetail ( ({"wellen"}),
    "Die Wellen kommen aus dem Norden und kraeuseln die Wasseroberflaeche.");
  AddDetail ( ({"seite", "seiten"}),
    "An den Seiten des Aufbaus sind Bullaugen angebracht.");
  AddDetail ( ({"zustand"}),
    "Obwohl das Schiff sicher schon seit Jahren hier unten liegt, ist es "+
    "noch in einem vergleichsweise guten Zustand.");
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere wirkt ein wenig unwirklich, dafuer aber umso "+
    "schoener.");
  // DETAILS END

  // EXITS START
  AddHiddenWaterExit ("rein", "in das Wrack#"ROOM"/hauptraum");
  AddHiddenWaterExit ("nach drinnen", "in das Wrack#"ROOM"/hauptraum");
  AddHiddenWaterExit ("in wrack", "in das Wrack#"ROOM"/hauptraum");
  AddHiddenWaterExit ("nach innen","in das Wrack"ROOM"/hauptraum");
  AddHiddenWaterExit ("in das wrack","in das Wrack"ROOM"/hauptraum");
  AddHiddenWaterExit ("ins wrack","in das Wrack"ROOM"/hauptraum");
  AddHiddenWaterExit ("in inneres","in das Wrack"ROOM"/hauptraum");
  AddHiddenWaterExit ("ins innere","in das Wrack"ROOM"/hauptraum");
  AddHiddenWaterExit ("in tuer","in das Wrack"ROOM"/hauptraum");
  AddHiddenWaterExit ("durch tuer","in das Wrack"ROOM"/hauptraum");
  AddHiddenWaterExit ("in kajuete","in das Wrack"ROOM"/hauptraum");
  AddWaterExit ("sueden",ROOM"/riff19");
  AddDiveExit ("oben",ROOM"/riff17");
  
  // EXITS END

  // ITEMS START
  // ITEMS END

}
