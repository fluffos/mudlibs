#include "/d/wasser/cirion/riff/riff.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Tabars Hotelzimmer");
  SetProp (P_INT_LONG, 
    "Du stehst in einem Hotelzimmer der mittleren Preisklasse, wie es "
    "scheint. Das Zimmer ist durchschnittlich moebliert, mit einem "
    "grossen, bequem aussehenden Bett, einem Kleiderschrank, einem Sofa "
    "und einem kleinen Tisch. Allerdings sind hier gar keine persoenlichen "
    "Gegenstaende zu sehen.");
  SetProp(P_NO_TPORT,NO_TPORT);
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"raum","hotelzimmer","zimmer"}),
    "Du stehst in einem Hotelzimmer der mittleren Preisklasse, wie es "
    "scheint. Das Zimmer ist durchschnittlich moebiliert, mit einem "
    "grossen, bequem aussehenden Bett, einem Kleiderschrank, einem Sofa "
    "und einem kleinen Tisch. Allerdings sind hier gar keine persoenlichen "
    "Gegenstaende zu sehen.");
  AddDetail ( ({"boden"}),
    "Der Boden des Raumes ist mit einem hellen Parkett belegt, darauf "+
    "liegen verschiedene Teppiche.");
  AddDetail ( ({"parkett"}),
    "Das sieht fast wie Buche aus. Allerdings bist Du nicht ganz sicher.");
  AddDetail ( ({"buche", "maserung", "punkt", 
                "punkte"}),
    "Buche ist ein helles Holz, mit einer Maserung voller kleiner Punkte.");
  AddDetail ( ({"decke"}),
    "Die Decke ist auch holzverkleidet, und es haengt ein Kerzenleuchter "+
    "von ihr herab.");
  AddDetail ( ({"kerze", "kerzen", "kerzenleuchter", 
                "leuchter"}),
    "Das ist ein Kerzenleuchter mit 6 Kerzen. Die Kerzen sind allerdings "+
    "nicht an, da es auch so hell genug hier drinnen ist.");
  AddDetail ( ({"bett"}),
    "Es ist ein recht grosses, bequem aussehendes Bett mit mehreren Kissen "+
    "und Decken. Nachts hat man es hier sicher nicht kalt.");
  AddDetail ( ({"decken", "kissen"}),
    "Die Kissen und Decken sehen weich und knuddelig aus. Am liebsten "+
    "wuerdest Du Dich sofort hineinwerfen, aber es ist ja nicht Dein Bett.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind mit einige Bilder verziert, allerdings nichts "+
    "besonderes. In der Nordwand ist ein Fenster, durch welches Du den "+
    "Hauptplatz von Tijara sehen kannst, im Sueden ist eine Tuer, die auf "+
    "den Flur fuehrt.");
  AddDetail ( ({"bilder"}),
    "Die Bilder stellen verschiedene Dschungellandschaften und -tiere dar, "+
    "allerdings ist es keine besonders aufregende Kunst. Nur ein Bild "+
    "erregt Deine Aufmerksamkeit.");
  AddDetail ( ({"aufmerksamkeit"}),
    "Deine Aufmerksamkeit wird von einem Bild erregt, welches an der Wand "+
    "haengt.");
  AddDetail ( ({"bild", "echsenwesen", "wesen"}),
    "Das Bild zeigt ein riesengrosses, furchterregendes, schwarzgruenes "+
    "Echsenwesen. Unten steht ganz klein 'Dante'.");
  AddDetail ( ({"dante", "kuenstler"}),
    "Das scheint wohl der Kuenstler zu sein, der dieses Bild geschaffen "+
    "hat.");
  AddDetail ( ({"baeume", "dschungellandschaften", "straeucher", 
                "tiere"}),
    "Auf den Bilder sind bloss Baeume, Straeucher und Tiere zu sehen.");
  AddDetail ( ({"fenster"}),
    "Ein recht kleines Fenster, damit die Hitze nicht hereinkommt. Durch "+
    "das Fenster kannst Du auf den Hauptplatz von Tijara hinabschauen.");
  AddDetail ( ({"flur", "treppe"}),
    "Auf dem Flur fuehrt eine Treppe nach unten.");
  AddDetail ( ({"hauptplatz", "platz"}),
    "Durch das Fenster siehst Du den grossen, runden Hauptplatz von "+
    "Tijara. In der Mitte des Platzes ist ein grosser Springbrunnen, und "+
    "rundherum stehen Haeuser.");
  AddDetail ( ({"brunnen", "haeuser", "haus", 
                "mitte", "springbrunnen"}),
    "Von hier oben kannst Du das nicht so genau erkennen.");
  AddDetail ( ({"gegenstaende", "gegenstand", "note"}),
    "Hier sind gar keine Gegenstaende, die dem Raum eine persoenliche Note "+
    "verleihen wuerden.");
  AddDetail ( ({"hitze"}),
    "Hier drinnen ist es angenehm, aber draussen ist es sicher ziemlich "+
    "warm.");
  AddDetail ( ({"holz","buchenholz"}),
    "Es scheint sich wohl um Buchenholz zu handeln. Eigentlich seltsam, es "+
    "muss recht teuer gewesen sein, da es hier unten im Dschungel kaum "+
    "vorkommt.");
  AddDetail ( ({"dschungel", "tijara","stadt"}),
    "Du befindest Dich hier in Tijara, der groessten Stadt im Dschungel.");
  AddDetail ( ({"teppich", "teppiche"}),
    "Die Teppiche sind handgeknuepft und flauschig und angenehm unter den "+
    "Fuessen.");
  AddDetail ( ({"tuer", "tuere"}),
    "Die Tuere fuehrt wohl nach draussen auf den Flur.");
  AddDetail ( ({"kleiderschrank", "schrank"}),
    "Darin kann man seine Kleider aufbewahren.");
  AddDetail ( ({"kleider"}),
    "Die scheinen wohl im Inneren des Schrankes zu sein.");
  AddDetail ( ({"nordwand"}),
    "Die Nordwand faellt durch das Fenster auf, welches in sie eingebaut "+
    "ist.");
  AddDetail ( ({"sitzgelegenheit", "sofa"}),
    "Das Sofa ist eine bequeme Sitzgelegenheit.");
  AddDetail ( ({"tisch"}),
    "Das ist ein kleiner Tisch, der vor dem Sofa steht.");
  AddSound ( ({DEFAULT_SOUND}),
    "Hier ist es recht ruhig.");
  // DETAILS END

  // EXITS START
  AddExit (("unten"),"zur Tuer hinaus und die Treppe hinunter#/d/dschungel/feyaria/tijara/room/hotel_c6");
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd("oeffne","cmd_open");
  previous_object()->CustomizeObject();
}

int cmd_open(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");
  if (str!="schrank" && str!="kleiderschrank")
    return 0;
  write(break_string(
    "Du oeffnest den Kleiderschrank, dieser ist jedoch bis auf einige "
    "Kleiderbuegel leer, so dass Du ihn enttaeuscht wieder schliesst."));
  return 1;
}

int fliehe_unten()
{
  write(BS(
    "Was begonnen wurde, muss auch zu Ende gefuehrt werden. Du kannst "
    "jetzt nicht fliehen."));	
  return 1;
}

tell()
{
  tell_room(TO,BS(
    "Scheinbar ist Tabar im Moment nicht da. Vielleicht kommst Du spaeter "
    "noch einmal, und ueberpruefst in der Zwischenzeit, ob Du nicht "
    "irgendetwas uebersehen hast."));
}

init()
{
  object questob;
  
  if (file_name()==ROOM"/tabar_vc")
    TP->move(ROOM"/tabar_vc:"+getuid(TP),M_TPORT|M_NOCHECK|M_SILENT);
  ::init();
  
  if (TP&&query_once_interactive(TP))
  {
    if (!present(TABARID))
    {
      if (0==TP->QueryQuest(RIFFQUESTNAME))
        clone_object(NPC"/tabar")->move(TO,M_NOCHECK|M_SILENT);
    }
    if ((questob=present(QUESTOBID,TP))&&(present(TABARID)))
    {
      if (0!=questob->Querysteps())
      {
        present(TABARID)->move(ROOM"/leerraum",M_NOCHECK|M_SILENT);
      }
      else if ((0==questob->QueryAmulett())||(0==questob->QueryLogbuch()))
      {
        present(TABARID)->move(ROOM"/leerraum",M_NOCHECK|M_SILENT);
        call_out("tell",0);
      }
    }
  }
}
