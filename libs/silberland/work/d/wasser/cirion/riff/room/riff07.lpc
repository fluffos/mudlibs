#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  SetProp(P_OBEN,"/riff08");
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_UNDERWATER,ENV_WATER:10]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,
    "Du schimmst tiefer in die Hoehle hinein. Hier drinnen wird es schon "+
    "merklich kuehler, da das Wasser sich kaum bewegt und die Sonne nicht "+
    "hereinscheint.  Diese Hoehle ist ganz anders als alle Hoehlen, die "+
    "Du bisher gesehen hast, da Waende und Boden vollstaendig aus "+
    "Korallen bestehen. Hier und da wachsen einige Wasserpflanzen, und "+
    "auch Fische leben hier.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"hoehle"}),
    "Die gesamte Hoehle besteht nur aus Korallen, die hier einen "+
    "natuerlichen Hohlraum entstehen lassen haben. Die Waende sind nicht "+
    "glatt, sondern weisen die gleichen Spalten und Hohlraeume auf, die "+
    "auch draussen am Riff zu sehen waren. In diesen Spalten schwimmen "+
    "kleine Fische oder wachsen Wasserpflanzen, die Du zuvor noch nie "+
    "gesehen hast. Nach Norden fuehrt die Hoehle weiter in die Dunkelheit.");
  AddDetail ( ({"wasser"}),
    "Das Wasser wird hier drinnen merklich kuehler, wenn auch nicht "+
    "unangenehm. Das kommt wohl daher, dass hier kein einziger Sonnenstrahl "+
    "hereinfaellt, und sich das Wasser auch so gut wie gar nicht bewegt. Nur "+
    "eine ganz leichte Stroemung nach Suedoben ist zu spueren.");
  AddDetail ( ({"suedoben"}),
    "Die Hoehle scheint schon nach Suedoben zu fuehren, aber dort endet "+
    "der Weg vor dem riesigen Blatt einer Wasserpflanze.");
  AddDetail ( ({"stroemung"}),
    "Die Stroemung scheint von Norden aus der Tiefe der Hoehle zu kommen, "+
    "und stroemt in Richtung Suedoben. Hmm, Du meinst zu spueren, dass die "+
    "Stroemung kaelter ist als das umliegende Wasser. Woher das wohl kommen "+
    "mag?");
  AddDetail ( ({"boden", "grund", "hoehlenboden", 
                "hoehlengrund","waende","wand","decke"}),
    "Der Boden hier besteht wie auch die Waende und die Decke komplett "+
    "aus Korallen. Hier und da liegen einige Steine herum, und auf den "+
    "Korallen wachsen die verschiedensten Wasserpflanzen. Der Boden ist "+
    "auch zerklueftet, wie die Waende, doch das macht Dir nichts, da Du ja "+
    "eh darueber schwimmst.");
  AddDetail ( ({"blatt"}),
    "Es handelt sich um das riesige Blatt einer Wasserpflanze, das hier "+
    "den Weg versperrt. Es scheint nicht besonders dick zu sein, also "+
    "koenntest Du einfach versuchen, hindurch zu schwimmen.");
  AddDetail ( ({"korallen"}),
    "Die Korallen sind winzige Meereslebewesen, die aufeinander wachsen "+
    "und beim Absterben ihr kalkhaltiges Skelett zuruecklassen. In "+
    "Jahrtausenden entsteht daraus ein solch wundervoller Ort wie dieser.");
  AddDetail ( ({"absterben", "skelett", "skelette", 
                "sterben"}),
    "Die Korallen haben nur eine sehr begrenzte Lebensdauer. Sie wachsen "+
    "aufeinander, und wenn sie absterben, lassen sie diese kleinen Skelette "+
    "zurueck, die das gesamte Riff bilden. Trotzdem dauert es mehrere "+
    "tausend Jahre, bis ein solch riesiges Riff entstanden ist.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Du schimmst in einer Hoehle, die mitten durch das Riff zu fuehren "+
    "scheint. Die Waende, der Boden und die Decke bestehen hier nur aus "+
    "Korallen, abgesehen von einigen Wasserpflanzen, die hier wachsen.");
  AddDetail ( ({"sonne", "sonnenstrahl", "sonnenstrahlen", 
                "strahl", "strahlen"}),
    "Die Sonne scheint hier nicht herein, Du glaubst fast, dass noch nie "+
    "ein Sonnenstrahl diesen Ort gefunden hat. Aus diesem Grund wachsen "+
    "hier wohl auch diese merkwuerdigen Wasserpflanzen, von denen Du noch "+
    "nie zuvor gehoert hast.");
  AddDetail ( ({"stein", "steine"}),
    "Hier liegen nur einige wenige Steine auf dem Boden.");
  AddDetail ( ({"dunkelheit"}),
    "Die Sonne kann hier nicht herein scheinen, daher ist es ziemlich "+
    "dunkel hier unten. Weiter oben kannst Du einen ganz schwachen "+
    "Lichtschimmer ausmachen.");
  AddDetail ( ({"hoehle"}),
    "Die Hoehle ist hier nur etwa zwei Meter hoch.");
  AddDetail ( ({"hohlraeume", "spalten","hohlraum"}),
    "Hier sind eine ganze Menge Spalten, groessere und kleinere. Eine "+
    "Spalte ist besonders gross.");
  AddDetail ( ({"spalte","spalt"}),
    "Die Spalte ist so gross, dass Du bequem hineinkriechen koenntest.");
  AddDetail ( ({"lebensdauer"}),
    "Ja, die Korallen leben bestenfalls einige Jahre lang, dann sterben "+
    "sie ab.");
  AddDetail ( ({"licht", "lichtschimmer"}),
    "Der Lichtschimmer kommt von weit oben, mehr kannst Du nicht erkennen.");
  AddDetail ( ({"lebewesen", "meereslebewesen", "wesen"}),
    "Hier sind viele, meist kleine Lebewesen zu sehen: Seesterne, Krebse, "+
    "Fische und natuerlich auch Wasserpflanzen.");
  AddDetail ( ({"tiefe"}),
    "Du wuerdest schaetzen, dass Du hier allerhoechstens zehn Meter unter "+
    "dem Meeresspiegel bist. Das drueckt schon ziemlich auf die Ohren, "+
    "tiefer solltest Du nicht unbedingt tauchen.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche ist von hier aus nicht mehr zu sehen.");
  AddDetail ( ({"fische"}),
    "Hier sind nicht so wundervoll bunte Fische wie draussen in der Bucht, "+
    "dafuer sind hier ganz viele verschiedene Arten, die die seltsamsten "+
    "Formen haben.");
  AddDetail ( ({"arten", "formen"}),
    "Du siehst kleine dicke und lange schlanke, blaue, gruene und graue "+
    "Fische, aber auch ab und zu gelbe und rote. Manche haben kleine und "+
    "manche grosse Flossen, und manche haben ganz seltsame, naja, Du "+
    "wuerdest sagen Schnurrbarthaare.");
  AddDetail ( ({"krebs", "krebse"}),
    "Die Krebse kriechen im Boden hin und her, und verschwinden auch ab "+
    "und zu in einer der vielen Spalten hier.");
  AddDetail ( ({"seesterne"}),
    "Die Seesterne sind etwas seltener, Du siehst ihrer nur zwei oder "+
    "drei. Viele der anderen Tiere scheinen sich vor ihnen zu fuerchten. "+
    "Das wird wohl daran liegen, dass Seesterne Raubtiere sind.");
  AddDetail ( ({"flossen", "schnurrbarthaare"}),
    "Die Fische unterscheiden sich nicht nur durch ihre Form, sondern auch "+
    "durch ihre Flossen und diese seltsamen Schnurrbarthaare.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Hier wachsen einige Wasserpflanzen, die bis auf die grossen Blaetter "+
    "im Sueden allesamt recht blass wirken. Das tut ihrer Schoenheit jedoch "+
    "keinen Abbruch.");
  AddDetail ( ({"blaetter"}),
    "Eigentlich ist es nur ein riesiges Blatt, welches Du im Sueden "+
    "erkennen kannst.");
  // DETAILS END

 
  // ITEMS START
  // ITEMS END

  AddCmd ( ({"krieche_spalte", "kriech", "krieche"}), "krieche_spalte");
  // EXITS START
  AddWaterExit ("oben",ROOM+"/riff08");
  AddHiddenWaterExit ("nach norden","in eine Spalte#"+ROOM+"/riff11");
  AddHiddenWaterExit ("sueden","nach suedoben aus der Hoehle#"ROOM+"/riff04");
  AddHiddenWaterExit ("suedoben","nach suedoben aus der Hoehle#"ROOM+"/riff04");
  AddHiddenWaterExit ("durch blatt","nach suedoben aus der Hoehle#"ROOM+"/riff04");
  AddHiddenWaterExit ("durch das blatt","nach suedoben aus der Hoehle#"ROOM+"/riff04");
  
  // EXITS END

}

int krieche_spalte (string str)
{
  notify_fail ("Wohin moechtest Du kriechen?\n");
  if (!str) return 0;
  if (0<=member(({"in spalte","durch spalte"}),str))
  {
    write(BS("Als Du in die Spalte kriechst, siehst Du, das sie sich nach Norden "+
          "in einen weiteren Raum oeffnet."));
    say(BS(TP->QueryProp(P_NAME)+" kriecht in eine Spalte."));
    return 1;
  }
  return 0;
}
