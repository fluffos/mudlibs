#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_UNDERWATER,ENV_WATER:10]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,
    "Die Hoehle macht hier einen Knick nach Osten, und die Temperatur ist "+
    "noch ein wenig gesunken. Vielleicht, weil hier die Stroemung etwas "+
    "staerker wird. Auch hier sind die Waende mit Wasserpflanzen "+
    "bewachsen, die sich leicht in der Stroemung wiegen. Dazwischen "+
    "schwimmen Fische und andere Meerestiere herum.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"hoehle","hohlraum"}),
    "Die gesamte Hoehle besteht nur aus Korallen, die hier einen "+
    "natuerlichen Hohlraum entstehen lassen haben. Die Waende sind nicht "+
    "glatt, sondern weisen die gleichen Spalten und Hohlraeume auf, die "+
    "auch draussen am Riff zu sehen waren. In diesen Spalten schwimmen "+
    "kleine Fische oder wachsen Wasserpflanzen, die Du zuvor noch nie "+
    "gesehen hast.");
  AddDetail ( ({"wasser"}),
    "Das Wasser hier drinnen ist kuehl, wenn auch nicht unangenehm. "
    "Das kommt wohl daher, dass hier kein einziger Sonnenstrahl "+
    "hereinfaellt, und sich das Wasser auch so gut wie garnicht bewegt. Nur "+
    "eine ganz leichte Stroemung ist zu spueren.");
  AddDetail ( ({"boden", "grund", "hoehlenboden", 
                "hoehlengrund","waende","wand","decke"}),
    "Der Boden hier besteht wie auch die Waende und die Decke komplett "+
    "aus Korallen. Hier und da liegen einige Steine herum, und auf den "+
    "Korallen wachsen die verschiedensten Wasserpflanzen. Der Boden ist "+
    "auch zerklueftet, wie die Waende, doch das macht Dir nichts, da Du ja "+
    "eh darueber schwimmst.");
  AddDetail ( ({"korallen"}),
    "Die Korallen sind winzige Meereslebewesen, die aufeinander wachsen "+
    "und beim Absterben ihr kalkhaltiges Skelett zuruecklassen. In "+
    "Jahrtausenden entsteht daraus ein solch wundervoller Ort wie dieser.");
  AddDetail ( ({"absterben", "skelett", "skelette", 
                "sterben"}),
    "Die Korallen haben nur eine sehr begrenzte Lebensdauer. Sie wachsen "+
    "aufeinander, und wenn sie absterben, lassen sie diese kleinen Skelette "+
    "zurueck, die das gesamte Riff bilden. Trotzdem dauert es mehrere "+
    "tausend Jahre, bis ein solch riesiges Riff entstanden ist.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Du schimmst in einer Hoehle, die mitten durch das Riff zu fuehren "+
    "scheint. Die Waende, der Boden und die Decke bestehen hier nur aus "+
    "Korallen, abgesehen von einigen Wasserpflanzen, die hier wachsen.");
  AddDetail ( ({"stein", "steine"}),
    "Hier liegen nur einige wenige Steine auf dem Boden.");
  AddDetail ( ({"hoehe"}),
    "Die Hoehle ist hier nur etwa zwei Meter hoch.");
   AddDetail ( ({"tiefe"}),
    "Du wuerdest schaetzen, dass Du hier allerhoechstens zehn Meter unter "+
    "dem Meeresspiegel bist. Das drueckt schon ziemlich auf die Ohren, "+
    "tiefer solltest Du nicht unbedingt tauchen.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche ist von hier aus nicht mehr zu sehen.");

  AddDetail ( ({"meeresbewohner", "meereslebewesen", "meerestiere","lebewesen","tiere"}),
    "Hier leben die verschiedensten Meeresbewohner: Kleine Krebse und "+
    "Krabben, die in den Spalten ihre Verstecke haben, die "+
    "unterschiedlichsten Fische und auch Seesterne, Muscheln und andere "+
    "merkwuerdige Meereslebewesen.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Die Pflanzen wachsen vor allem auf dem Boden und in den Spalten in "+
    "den Waenden der Hoehle. Du kennst keine dieser Pflanzen, aber einige "+
    "errinnern Dich an die Pflanzen ausserhalb des Wassers, waehrend andere "+
    "bizarre und merkwuerdige, nichtsdestotrotz aber schoene Formen haben.");
  AddDetail ( ({"formen"}),
    "Die Formen sind total unterschiedlich.");
  AddDetail ( ({"versteck", "verstecke"}),
    "In diesen Verstecken leben viele kleine Tiere.");
  AddDetail ( ({"spalte", "spalten","spalt"}),
    "In den Spalten leben die verschiedensten Lebewesen.");
  AddDetail ( ({"fische"}),
    "Hier leben die verschiedensten Fische, allerdings koenntest Du keinen "+
    "von ihnen benennen.");
  AddDetail ( ({"krabbe", "krebse","krabben"}),
    "Die Krabben und Krebse verstecken sich in den Spalten, die hier "+
    "ueberall sind.");
  AddDetail ( ({"knick"}),
    "Sie biegt einfach in Richtung ostoben ab.");
  AddDetail ( ({"muscheln"}),
    "Es sind meist kleine Muscheln, und Du glaubst nicht, dass Du darin "+
    "Perlen finden kannst. Aber irgendwo wird es sicher Muscheln mit Perlen "+
    "geben.");
  AddDetail ( ({"perle", "perlen"}),
    "Du weisst sicher, was Perlen sind.");
  AddDetail ( ({"seesterne","seestern"}),
    "Die Seesterne sind wohl eher traege, sie bewegen sich kaum.");
  AddDetail ( ({"stroemung"}),
    "Die Stroemung scheint aus dem Osten zu kommen.");
  AddDetail ( ({"temperatur"}),
    "Die Temperatur ist nicht besonders hoch, aber ausreichend zum "+
    "schwimmen.");
  AddDetail ( ({"hohlraeume"}),
    "Wahrscheinlich meinst Du die vielen Spalten, die hier in den Waenden, "+
    "der Decke und dem Boden sind.");
  AddDetail ( ({"sonnenstrahl"}),
    "Hier ist sicher noch nie ein Sonnenstrahl hineingelangt.");
  // DETAILS END

  // ITEMS START
  AddItem(NPC+"/silberfisch", REFRESH_DESTRUCT);
  // ITEMS END

  // EXITS START
  AddWaterExit ("sueden",ROOM+"/riff07");
  AddHiddenWaterExit("osten",ROOM+"/riff12");
  AddWaterExit ("ostoben",ROOM+"/riff12");
  // EXITS END
}
