#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit WROOM+"/wroom";

void create()
{
 ::create();
 
  SetProp(P_UNTEN,ROOM+"/riff1");
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du schwimmst im Wasser noerdlich der Bucht von Tijara. Direkt vor "+
    "Dir siehst Du ein riesiges Korallenriff, das sich so weit Du sehen "+
    "kannst nach Westen erstreckt. Nach Osten kannst Du in der Ferne den "+
    "Hafen von Tijara erkennen.\n");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"bucht"}),
    "Die Bucht liegt suedlich von Dir. Sie wird von allen Seiten von einem "+
    "wunderschoenen weissen Sandstrand eingefasst, nur in Deine Richtung "+
    "ist sie geoeffnet.Das Wasser in der Buchht ist so klar, dass Du "+
    "problemlos den Meeresgrund unter Dir sehen kannst. Suedlich der Bucht "+
    "beginnt der undurhdringliche Dschungel.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Direkt vor Dir im Norden liegt das Korallenriff. Es besteht aus "+
    "Milliarden und Abermilliarden winziger Korallen. Noerdlich des Riffs "+
    "siehst Du das offene Meer, von dort brechen sich immer wieder grosse "+
    "Wellen am Riff, so dass ein Erklettern des Riffs unmoeglich ist.\n"+
    "Du koenntest Dir gut vorstellen, dass das Riff Lebensraum fuer "+
    "unzaehlige Tiere und Pflanzen bietet, doch hier, ueber der "+
    "Wasseroberflaeche, ist davon nichts zu sehen.");
  AddDetail ( ({"wasser"}),
    "Das Wasser hier ist herrlich warm und kristallklar, so dass Du bis "+
    "yum Meeresgrund hinuntersehen kannst. Vielleicht sind dort unten "+
    "Fische?");
  AddDetail ( ({"fische", "pflanzen", "tiere"}),
    "Du kannst am Grund des Meeres, auf dem Korallenriff viele "+
    "verschiedene Tiere und Pflanzen sehen, aber leider erkennst Du von "+
    "hier oben nichts genaueres.");
  AddSmell ( ({DEFAULT_SMELL,"luft","geruch"}),
    "Du atmest tief ein. Frisch riecht die Luft, und stark salzig.");
  AddSound ( ({DEFAULT_SOUND, "meer", "rauschen"}),
    "Du hoerst das laute Rauschen der Wellen, die sich noerdlich des Riffs "+
    "brechen. Wenn man sich dort befindet, muss es ohrenbetaeubend sein.");
  AddDetail ( ({"stadt", "tijara"}),
    "Die Stadt Tijara liegt oestlich von hier. Du kannst nur schemenhaft "+
    "ihren Hafen erkennen.");
  AddDetail ( ({"hafen"}),
    "Der Hafen liegt oestlich von hier und ist nur schemenhaft yu "+
    "erkennen.");
  AddDetail ( ({"korallen"}),
    "Die Korallen sind eigentlich winzige Meereslebewesen, die aufeinander "+
    "wachsen und somit in Hunderten von Jahren dieses Riff gebildet haben.");
  AddDetail ( ({"dschungel", "kueste", "sand", 
                "strand", "ufer"}),
    "um da etwas genaueres erkennen zu koennen, musst Du schon naeher "+
    "heranschwimmen.");
  AddDetail ( ({"boden", "grund", "meereboden", 
                "meeresgrund"}),
    "Der Meeresgrund hier wird auch vom Korallenriff gebildet, welches "+
    "sich unter Wasser noch ein Stueck weiter nach Sueden erstreckt. Du "+
    "kannst dort unten einige Tiere und Pflanzen erkennen.");
  AddDetail ( ({"wellen"}),
    "Die Wellen brechen sich noerdlich von hier am Riff.");
  AddDetail ( ({"meer"}),
    "Hier ist das Meer ruhig und warm. Doch noerdlich des Riffs beginnt "+
    "die offene See mit ihren grossen Wellen. Dort ist es sicher viel "+
    "unangenehmer und gefaehrlicher als hier.");
  // DETAILS END

  // EXITS START
  AddWaterExit("sueden",ROOM+"/riff1");
  AddWaterExit("in wrack","in das Wrack#"+ROOM+"/riff1");
  AddWaterExit("westen",ROOM+"/riff1");
  AddWaterExit("norden",ROOM+"/riff1");
  AddWaterExit("osten",ROOM+"/riff1");
  AddWaterExit("unten",ROOM+"/riff1");
  // EXITS END

  // ITEMS START
  // ITEMS END

  //BEGIN AddCmd
  //END AddCmd 
}
