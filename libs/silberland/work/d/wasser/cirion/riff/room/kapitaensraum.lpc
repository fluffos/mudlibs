#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

nosave int schublade;

int schliess_schublade();
int schublade_zu();

void create()
{
  ::create();
  schublade=0;
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Im Raum des Kapitaens");
  SetProp (P_INT_LONG,
    "Dieser recht geraeumige Raum scheint das Quartier des Kapitaens "+
    "gewesen zu sein. Ein grosses, wenn auch vergammeltes Bett, ein "+
    "grosser Tisch und mehrere Schraenke an den Waenden bilden das "+
    "Mobiliar, dem Kapitaen ging es hier wirklich nicht schlecht. In den "+
    "Waenden sind mehrere Bullaugen, durch welche man das Riff sehen "+
    "kann, und am Boden dieses Raumes liegen drei Skelette.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail (({"raum","quartier"}),
    "Dieser recht geraeumige Raum scheint das Quartier des Kapitaens "+
    "gewesen zu sein. Ein grosses, wenn auch vergammeltes Bett, ein "+
    "grosser Tisch und mehrere Schraenke an den Waenden bilden das "+
    "Mobiliar, dem Kapitaen ging es hier wirklich nicht schlecht. In den "+
    "Waenden sind mehrere Bullaugen, durch welche man das Riff sehen "+
    "kann, und am Boden dieses Raumes liegen drei Skelette.");
  AddDetail ( ({"bett"}),
    "Das Bett war sicher einmal sehr gemuetlich, es ist breit genug fuer "+
    "zwei Leute, und eine grosse, dicke Decke liegt daran. Leider hat das "+
    "Bett die lange Zeit hier unten nicht sehr gut uberstanden, so dass es "+
    "jetzt in einem recht erbaermlichen Zustand ist.");
  AddDetail ( ({"boden", "bohlen", "holzbohlen"}),
    "Der Boden besteht aus den gleichen Holzbohlen, wie der Rest des "+
    "Schiffes auch. Es scheint sich um ein besonders stabiles und "+
    "widerstandsfestes Holz zu handeln, sonst waere es laengst nicht mehr "+
    "in so einem guten Zustand.");
  AddDetail ( ({"knochen", "skelett", "skelette"}),
    "Es scheint sich um die sterblichen Ueberreste des Kapitaens und zwei "+
    "weiterer Seeleute zu handeln, die beim Untergang des Schiffes hier ihr "+
    "feuchtes Grab gefunden haben. Entweder hat sie das Sinken voellig "+
    "ueberrascht, oder es waren ausserst mutige Leute, die ohne Furcht dem "+
    "Tod ins Auge gesehen haben, denn sie scheinen nicht versucht zu haben, "+
    "das sinkende Schiff zu verlassen.");
  AddDetail ( ({"kartentisch", "schreibtisch", "tisch"}),
    "Das scheint der Schreib- und Kartentisch des Kapitaens gewesen zu "+
    "sein. Er ist recht gross, so dass man bequem daran arbeiten konnte, "+
    "und besteht aus dem gleichen hellen Holz, wie alles andere hier auch. "+
    "In die eine Seite des Tisches ist eine Glasplatte eingelassen.");
  AddDetail ( ({"glas", "glasplatte", "platte"}),
    "Die Platte, die in die Oberflaeche des Tisches eingelassen ist, ist "+
    "ungefaehr 50 mal 50 cm gross, und scheint aus Glas oder einem "+
    "aehnlichen, kristallinen Material zu sein. Du fragst Dich, welchen "+
    "Sinn sie haben koennte. Als Du sie vorsichtig mit der Hand beruehrst, "+
    "beginnt die gesamte Platte sanft zu leuchten. Das ist sicher recht "+
    "praktisch, wenn man im Dunklen mit einer Seekarte arbeiten muss.");
  AddDetail ( ({"schraenke"}),
    "In den Schraenken befinden sich sicher die privaten Dinge des "+
    "Kapitaens, Du kannst allerdings auch einige alte Seekarten sehen, die "+
    "aufgerollt in einem der Schraenke liegen.");
  AddSpecialDetail("schrank","detSchrank");
  AddSpecialDetail ( ({"roehre", "rohr"}),"detRohr");
  AddDetail ( ({"mobiliar", "moebel"}),
    "Das Mobiliar diesen Raumes ist fast komplett aus dem gleichen, fast "+
    "weissen Holz, wie der Rest des Schiffes. Es besteht aus einem Bett, "+
    "drei Stuehlen, einem grossen Tisch, mehreren Schraenken sowie einem "+
    "kleinen Nachttischchen.");
  AddDetail(({"stuhl","stuehle"}),
    "Einer der Stuehle steht hinter dem Tisch, die andren beiden davor.");
  AddDetail ( ({"decke", "waende", "wand","heckwand","steuerbordwand","backbordwand"}),
    "Auch Waende und Decke sind aus weissem Holz, und in einem relativ "+
    "guten Zustand, bedenkt man, dass das Schiff sicher schon mehrere Jahre "+
    "hier auf dem Meeresgrund verweilt.");
  AddDetail ( ({"bullauge", "bullaugen"}),
    "Mehrere Bullaugen sind entlang der Backbord- Steuerbord- und Heckwand "+
    "angebracht. Durch sie konnte man frueher waehrend der Seereisen sicher "+
    "schoen die Umgebung unter Wasser betrachten. Jetzt sieht man durch die "+
    "Bullaugen das Riff, welches das gesamte Wrack umgibt.");
  AddDetail ( ({"riff", "umgebung"}),
    "Das Riff umgibt das gesamte Wrack, wenn Du es naeher betrachten "+
    "willst, solltest Du das Wrack schon verlassen.");
  AddDetail ( ({"schublade","schubladen","lade","laden"}),
    "Die Schubladen sind verschlossen.");
  AddDetail("kupfer",
    "Das Kupfer, einstmals rotglaenzend, ist inzwischen gruen angelaufen.");
  AddDetail ( ({"meer", "wasser","meerwasser"}),
    "Das Wasser ist hier ueberall um Dich herum.");
  AddDetail ( ({"bettdecke", "kissen","decken","zerfallen"}),
    "Die Kissen und die Bettdecke waren sicherlich einmal sehr bequem, "+
    "doch jetzt sind sie kurz vor dem Zerfallen.");
  AddDetail ( ({"seite"}),
    "In die linke Seite des Schreibtischs ist eine Glasplatte eingelassen.");
  AddDetail ( ({"schiff", "wrack"}),
    "Das wohl einst stolze Schiff ist nicht mehr als ein Wrack, welches "+
    "hier auf dem Meeresgrund liegt.");
  AddSpecialDetail ( ({"kappe", "kappen"}),"detKappe");
  AddDetail ( ({"oberflaeche"}),
    "Die Oberflaeche des Tisches war einmal glatt poliert, und die "+
    "Glasplatte fuegt sich nahtlos in die Oberflaeche ein.");
  AddDetail ( ({"kapitaen", "leute"}),
    "Der Kapitaen und seine Leute scheinen wohl hier das Zeitliche gesegnet "+
    "zu haben.");
  AddDetail ( ({"zustand"}),
    "Wenn man bedenkt, dass das Wrack schon seit Jahren hier unten liegt, "+
    "ist sein Zustand relativ gut.");
  AddDetail ( ({"ueberrest", "ueberreste","seeleute"}),
    "Die Ueberreste der Seeleute bestehen aus kaum mehr als ihren "+
    "Skeletten, die Kleidung ist so gut wie verschwunden. Kein besonders "+
    "schoener Anblick.");
  AddDetail ( ({"backbord", "steuerbord"}),
    "Steuerbord ist die rechte Seite eines Schiffes, Backbord seine linke.");
  AddDetail ( ({"holz", "maserung"}),
    "Fast alles hier im Raum besteht aus diesem hellen, fast weissen Holz, "+
    "welches von einer feinen, grauen Maserung durchzogen wird. Das Holz "+
    "scheint ausserst widerstandsfaehig gegen Umwelteinfluesse und auch "+
    "physikalische Gewalt zu sein.");
  AddDetail(({"ritze","ritzen"}),
    "Als Du ganz genau hinsiehst, erkennst Du, dass sich vor dem Nachttischchen "
    "eine kleine Ritze im Boden gebildet hat.");
  AddSpecialDetail(({"bett","nachttischchen","nachttisch","lampe",
                     "oellampe"}),"detailsLampe");
  AddSpecialDetail ( ({"karte", "karten", "seekarte", 
                "seekarten","stapel"}),"detailsRohr");
  // DETAILS END

  // EXITS START
  AddWaterExit ("vorne", "nach Vorne#"+ROOM+"/hauptraum");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd ( ({"nimm","nehm","nehme"}), "nimm");
  AddCmd ( ({"oeffne","schliesse","schliess"}),"oeffne_schublade");
}

string detailsLampe(string key)
{
  if (deep_present("\ncirilampe",TP) || present("\ncirilampe",TO))
  {
    switch (key)
    {
      case "bett":
        return break_string(
          "Das Bett des Kapitaens waere sicher gross genug fuer zwei Leute, "
          "und es ist voll von Kissen und Decken, die jetzt allerdings "
          "keinen sehr gemuetlichen Eindruck mehr machen. Neben dem Bett "
          "steht seitlich ein kleines Nachttischchen mit mehreren Schubladen.");
        break;  
      case "nachttischchen":
      case "nachttisch":
        return break_string(
          "Ein kleines, hoelzernes Nachttischchen mit drei Schubladen.");
        break;  
      case "lampe":
      case "oellampe":
        return 0;
        break;  
    }
  }
  else
  {
    switch (key)
    {
      case "bett":
        return break_string(
          "Das Bett des Kapitaens waere sicher gross genug fuer zwei Leute, "
          "und es ist voll von Kissen und Decken, die jetzt allerdings "
          "keinen sehr gemuetlichen Eindruck mehr machen. Neben dem Bett "
          "steht seitlich ein kleines Nachttischchen mit mehreren Schubladen, "
          "und darauf liegt eine umgefallene Oellampe.");
        break;  
      case "nachttischchen":
      case "nachttisch":
        return break_string(
          "Ein kleines, hoelzernes Nachttischchen mit drei Schubladen, auf "
          "dem eine alte Oellampe liegt.");
        break;  
      case "lampe":
      case "oellampe":
        return break_string(
          "Die Oellampe besteht offenbar aus Kupfer, welches inzwischen "
          "gruen angelaufen ist. Hier unten ist das auch keine Wunder. "
          "Leider scheint die Lampe umgefallen zu sein, und dabei ist das "
          "Glas zerbrochen. Ansonsten scheint sie noch voellig in Ordnung "
          "zu sein.");
        break;  
    }
  }
}

string detailsRohr(string key)
{
  if (deep_present("\nciristahlrohr",TP) || present("\nciristahlrohr",TO))
  {
    switch (key)
    {
      case "karte":
      case "karten":
      case "seekarte":
      case "seekarten":
      case "stapel":
        return break_string(
          "In einem der Schraenke liegt ein ganzer Stapel fein saeuberlich "
          "aufgerollter Seekarten. Leider sind auch sie nicht gegen den "
          "Einfluss des Wassers gefeit, so dass sie nunmehr voellig nutzlos "
          "sind.");
        break;  
    }
  }
  else
  {
    switch (key)
    {
      case "karte":
      case "karten":
      case "seekarte":
      case "seekarten":
      case "stapel":
        return break_string(
          "In einem der Schraenke liegt ein ganzer Stapel fein saeuberlich "
          "aufgerollter Seekarten. Leider sind auch sie nicht gegen den "
          "Einfluss des Wassers gefeit, so dass sie nunmehr voellig nutzlos "
          "sind. Zwischen den Karten liegt ein seltsames metallenes Rohr.");
        break;
    }
  }
}

string detKappe()
{
  if (deep_present("\nciristahlrohr",TP))
    return 0;
  return break_string(
    "Um das naeher zu begutachten, solltest Du das Rohr wohl in die Hand "+
    "nehmen.");
}

string detRohr()
{
  if (deep_present("\nciristahlrohr",TP))
    return 0;
  return break_string(
    "Das Rohr hat einen Durchmesser von ungefaehr 5 Zentimetern und ist an "+
    "beiden Enden mit einer Metallkappe versehen, so dass kein Wasser ins "+
    "Innere gelangen kann.");
}


string detSchrank()
{
  if (deep_present("\nciristahlrohr",TP))
    return break_string(
      "In diesem Schrank liegen einige aufgerollte Seekarten, die inzwischen "
      "wahrscheinlich nicht mehr brauchbar sind.");
  return break_string(
    "In diesem Schrank liegen einige aufgerollte Seekarten, die inzwischen "
    "wahrscheinlich nicht mehr brauchbar sind. Dazwischen siehst Du ein "
    "seltsames metallenes Rohr.");
}

init()
{
  schublade_zu();	
  ::init();
}

int schublade_zu()
{
  schublade=0;
  RemoveDetail(({"inhalt","kram"}));
  RemoveCmd(({"durchsuche", "durchwuehle", "suche"}));
  AddDetail ( ({"schublade","schubladen"}),
    "Die Schubladen sind verschlossen.");
  return 1;
}

int schliess_schublade()
{
  write(BS("Du schliesst die Schubladen wieder, mit einem leisen *klick* "
           "rastet das Schloss ein."));
  schublade_zu();
  return 1;	
}

int oeffne_schublade(string str)
{
  int oeffnen;	

  oeffnen=0;
  if (query_verb()=="oeffne")
  {
    notify_fail("Was moechtest Du oeffnen?\n");
    if (-1!=member(({"schublade","schubladen","nachttisch","nachttischchen",
                     "schublade mit silberschluessel",
                     "schubladen mit silberschluessel",
                     "schublade mit schluessel",
                     "schubladen mit schluessel",
                     "nachttisch mit schluessel",
                     "nachttisch mit silberschluessel",
                     "nachttischchen mit schluessel",
                     "nachttischchen mit silberschluessel"
                     }),str))
    {
      oeffnen=1;
    }
    else
      return 0;
  }
  else
  {
    notify_fail("Was moechtest Du aufschliessen?\n");
    if (-1!=member(({"schublade auf","schubladen auf","nachttisch auf","nachttischen auf"}),str))
    {
      oeffnen=1;
    }
    else if (-1!=member(({"schublade","schubladen","nachttisch","nachttischen"}),str))
    {
      if (schublade==0)
      {
      	write(BS("Die Schubladen sind doch schon zu."));
      	return 1;
      }
      schliess_schublade();
      return 1;
    }
    else
      return 0;
  }
  if (schublade==1)
  {
    write(BS("Die Schubladen sind doch schon offen."));
    return 1;
  }
  if (0==present("\nciriskey",TP))
  {
    write(BS("Die Schubladen sind abgeschlossen, Du brauchst wohl einen "
             "Schluessel, um sie zu oeffnen."));
    return 1;
  }
  else 
  {
    write(BS("Du oeffnest die Schubladen mit dem kleinen Silberschluessel."));
      AddDetail ( ({"schublade", "schubladen"}),
       "Die Schubladen klemmen ein wenig, doch als Du sie schliesslich "+
       "aufbekommen hast, musst Du feststellen, dass der Inhalt grossteils aus "+
       "seltsam verquollenem und verfaultem Kram besteht. Ob da noch etwas "+
       "Brauchbares drin zu finden ist?");
      AddDetail ( ({"inhalt","kram"}), 
       "Der Inhalt scheint wohl aus persoenlichen Dingen des Kapitaens "+
       "bestanden zu haben, nun ist er absolut nutzlos. Oder ist da doch noch "+
       "etwas nuetzliches zu finden?");
      AddCmd ( ({"durchsuche", "durchwuehle", "suche"}), "durchsuche");
      schublade=1;
      present("\nciriskey",TP)->remove();
      write(BS(
        "Du moechtest den Schluessel wieder abziehen, doch er entgleitet "
        "Dir und rutscht in eine Ritze am Boden."));
      return 1;
  } 	
}

int durchsuche (string str)
{
  notify_fail("Wo moechtest Du suchen?\n");
  if(!str) return 0;
  if (-1!=member(({"schublade","schubladen","in schublade","in schubladen",
      "nachttischchen","in nachttischchen","nachttisch","in nachttisch"}),str))
  {
    if (!present("\nciritabarquestob",TP))
    {
      write(BS("Du durchwuehlst saemtliche Schubladen, und Du bist auch ziemlich "
               "sicher, dass unter all dem Kram etwas wichtiges versteckt ist, "
               "doch leider hast Du keine Ahnung, was das sein koennte."));
    }
    else if (!present("\ncirilogbuch",TP))
    {
      write(BS("Du wuehlst in den Schubladen, und schliesslich findest Du "
               "ein kleines Buch in einer ledernen Huelle."));
      clone_object(OBJ"/logbuch")->move(TP,M_NOCHECK);	
    }
    else
    {
      write(BS("Ausser dem Buch kannst Du nichts mehr finden."));	
    }
    return 1;
  }
  return 0;
}

int nimm (string str)
{
  notify_fail ("Was moechtest Du nehmen?\n");
  if (-1!=member(({"rohr","stahlrohr"}),str))
  {
    notify_fail("So etwas siehst Du da nicht.\n");	
    if (deep_present("\nciristahlrohr",TO))
    {
     return 0;
    }
    write("Du nimmst das Stahlrohr aus dem Schrank.\n");
    clone_object(OBJ"/rohr")->move(TP,M_NOCHECK);
    return 1;
  }
  else if (-1!=member(({"lampe","oellampe"}),str))
  {
    notify_fail("So etwas siehst Du da nicht.\n");	
    if (deep_present("\ncirilampe",TO))
    {
     return 0;
    }
    write("Du nimmst die Lampe vom Nachttischchen.\n");
    clone_object(OBJ"/oellampe")->move(TP,M_NOCHECK);
    return 1;
  }
  else return 0;
}
