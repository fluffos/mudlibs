#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  SetProp(P_OBEN,"/riff09");
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_UNDERWATER,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "In einer Unterwasserhoehle");
  SetProp (P_INT_LONG,
    "Die Hoehle macht hier einen Knick nach Westen. Von dort kannst "+
    "Du ein wenig Licht hereinscheinen sehen, allerdings reicht es nicht "+
    "aus, um die Hoehle wirklich zu beleuchten. Die Waende sind hier ein "+
    "wenig poroeser als weiter unten, so dass hier auch mehr Pflanzen "+
    "wachsen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Die Hoehle keinen Boden, nach unten geht es einige "+
    "Meter in die Tiefe.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende bestehen nur aus Korallen, ueberall sind kleine Spalten "+
    "und Hohlraeume zu sehen. Da die Waende hier poroeser sind als weiter "
    "unten, wachsen hier auch mehr Pflanzen.");
  AddDetail ( ({"hohlraeume", "hohlraum", "lebensraum", 
                "spalte", "spalten"}),
    "Die Spalten und Hohlraeume sind der Lebensraum der verschiedensten "+
    "Tiere, allerdings ist hier in der Hoehle die Artenvielfalt viel "+
    "geringer als draussen.");
  AddDetail ( ({"artenvielfalt"}),
    "Hier leben hauptsaechlich Tiere, die Dunkelheit oder wenig Licht "+
    "moegen.");
  AddDetail ( ({"dunkelheit","dunkel"}),
    "Tatsaechlich, hier drinnen ist es relativ dunkel.");
  AddDetail ( ({"licht", "sonne"}),
    "Vom Westen scheint ein wenig Licht herab. Fast scheint es, als "+
    "waere da ein Ausgang.");
  AddDetail ( ({"korallen"}),
    "Daraus besteht das gesamte Riff. Die Korallen sind kleine Lebewesen, "+
    "die, wenn sie sterben, ihr Skelett zuruecklassen und so in vielen Jahren "+
    "das gesamte Riff gebildet haben.");
  AddDetail ( ({"hoehle"}),
    "Die Hoehle scheint wohl nach westoben zu fuehren. Aber wenn sie das "+
    "wirklich tut, kommt sie genau in der Mitte des Riffs aus, und nicht "+
    "auf der anderen Seite.");
  AddDetail ( ({"ausgang"}),
    "Ein Ausgang aus dieser Hoehle scheint im Westen zu sein.");
  AddDetail ( ({"mitte"}),
    "Ja, Du wuerdest schaetzen, dass der Ausgang mittig des Riffs "+
    "herauskommt.");
  AddDetail ( ({"landseite", "meerseite", "seite"}),
    "Auf der einen Seite des Riffs ist das Festland, auf der anderen das "+
    "offene Meer.");
  AddDetail ( ({"festland"}),
    "Das Festland kennst Du doch sicher.");
  AddDetail ( ({"lebewesen", "tiere"}),
    "Hier leben einige Tiere, kleine Fische, Krabben, Seesterne und "+
    "aehnliches.");
  AddDetail ( ({"meer", "meerwasser", "wasser"}),
    "Das Wasser ist hier ziemlich ruhig, und auch schon recht kuehl. Von "+
    "oben faellt ein wenig Licht herein, dadurch sieht das Wasser ein wenig "+
    "raetselhaft aus.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Fast die ganzen Waende sind hier mit Wasserpflanzen bewachsen, welche "+
    "in den Spalten und Poren des Riffs Halt gefunden haben. Ihre Blaetter "+
    "haengen an den Waenden herab, und dazwischen sind immer wieder kleine "+
    "weisse Blueten zu sehen.");
  AddDetail ( ({"pore", "poren"}),
    "Das Korallenriff ist ziemlich poroes, und in diesen Poren wachsen "+
    "einige Pflanzen.");
  AddDetail ( ({"seestern", "seesterne"}),
    "Eben hast Du noch einen gesehen, doch es scheint, als haette Deine "+
    "Anwesenheit ihn erschreckt und verjagt.");
  AddDetail ( ({"krabbe", "krabben", "krebs", 
                "krebs"}),
    "Auch Krebse und Krabben leben hier in den Spalten und Hohlraeumen. "+
    "Sie scheinen sich jedesmal zu verstecken, wenn etwas naeherkommt, das "+
    "groesser ist als sie selbst.");
  AddDetail ( ({"fische"}),
    "Ausser den Silberfischen leben hier noch andere kleine Fischarten, "+
    "die teils in den unterschiedlichsten Farben schillern. Keiner von "+
    "ihnen strahlt allerdings ein solches Licht aus, wie der Silberfisch.");
  AddDetail ( ({"bluete", "blueten"}),
    "Es sind kleine, kaum fingernagelgrosse, weisse, sternfoermige "+
    "Blueten. Sie sehen zwar ein wenig seltsam aus, aber keineswegs weniger "+
    "schoen als Blueten von Pflanzen, die ueber Wasser wachsen.");
  AddDetail ( ({"farbe", "farben"}),
    "Die Fische haben die unterschiedlichsten Farben. Sie sind allerdings "+
    "nicht mit der Farbenvielfalt der Regenbogenfische vergleichbar.");
  AddDetail ( ({"farbenvielfalt", "regenbogenfisch", "regenbogenfische"}),
    "Von den Regenbogenfischen kannst Du hier drinnen keinen einzigen "+
    "erkennen. Es scheint fast, als wuerden sie die Sonne lieben und nicht "+
    "hier ins Dunkel schwimmen wollen.");
  AddDetail ( ({"tiefe"}),
    "Naja, sehr tief ist es auch wieder nicht. ungefaehr 5 Meter, wuerdest "+
    "Du schaetzen.");
  AddDetail ( ({"fischarten"}),
    "Du kannst einige verschiedene Fischarten entdecken. Allerdings hast "+
    "Du die meisten von ihnen noch nie gesehen.");
  AddDetail ( ({"blaetter", "blatt"}),
    "Das sind laengliche, dunkelgruene Blaetter, die an der Wand "+
    "herunterhaengen.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Korallenriff ist uebrall um Dich herum, es hat dies Hoehle hier "+
    "gebildet.");
  AddDetail ( ({"knick"}),
    "Die Hoehle knickt hier nach Westen ab, und dort scheint irgendwo ein "+
    "Ausgang nach oben zu sein.");
  AddDetail ( ({"halt"}),
    "Die Wurzeln der Pflanzen finden prima Halt in den Poren und Spalten "+
    "in den Waenden.");
  AddDetail ( ({"decke"}),
    "Auch die Decke ist zerklueftet und von Spalten durchzogen. Allerdings "+
    "wachsen dort keine Pflanzen.");
  // DETAILS END

  // ITEMS START
  AddItem(NPC+"/silberfisch", REFRESH_DESTRUCT);
  // ITEMS END

  // EXITS START
  AddWaterExit ("unten",ROOM+"/riff07");
  AddWaterExit ("westen",ROOM+"/riff09");
  // EXITS END
}
