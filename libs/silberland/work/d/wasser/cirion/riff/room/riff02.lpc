#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");


void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 2);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du schwimmst in den blauen Weiten des Meeres nordoestlich der Bucht "+
    "von Tijara. Direkt vor Dir siehst Du das sagenumwobene "+
    "Korallenriff, das sich so weit Du sehen kannst nach Westen "+
    "erstreckt. Im Osten kannst Du in der Ferne den Hafen von Tijara "+
    "erkennen. Das Wasser um Dich herum leuchtet in allen nur denkbaren "+
    "Farben, und es ist herrlich warm zum Baden.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"meer", "weiten"}),
    "Das Meer erstreckt sich nach Norden hin bis zum Horizont und wie Du "+
    "weisst, auch noch weit darueber hinaus. Rund um Dich herum sind die "+
    "Wellen nicht so hoch, doch noerdlich am Riff brechen sich gefaehrliche "+
    "Wogen, die vom offenen Meer kommen.");
  AddDetail ( ({"horizont"}),
    "Am Horizont scheint es, als wuerden Himmel und Meer aneinander "+
    "stossen.");
  AddDetail ( ({"bucht"}),
    "Die Bucht liegt nun suedwestlich von Dir. Sie wird eingefasst von "+
    "weissen Sandstraenden, und noch weiter suedlich ist de dichte "+
    "Dschungel zu erkennen.");
  AddDetail ( ({"dschungel", "sand", "sandstraende", 
                "sandstrand", "straende", "strand"}),
    "Um etwas genauers erkennen zu koennen, musst Du wohl etwas naeher "+
    "heranschwimmen.");
  AddDetail ( ({"farben"}),
    "Die Farben scheinen tatsaechlich direkt aus dem Wasser zu kommen. "+
    "Doch leider kannst Du von hier oben aus nicht erkennen, woher genau "+
    "sie stammen.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist herrlich warm und leuchtet in den verschiedensten "+
    "Farben. Es macht richtig Spass, hier zu schwimmen.");
  AddDetail("spass","Hmmmm. Spass kann man nicht sehen.");
  AddDetail ( ({"wellen", "wogen"}),
    "Die Wellen sind hier nicht sehr hoch, doch noerdlich des Riffs "+
    "brechen sich die grossen Wogen vom offenen Meer.");
  AddDetail ( ({"ferne", "hafen", "tijara"}),
    "Der Hafen von Tijara liegt oestlich von hier und ist in der Ferne "+
    "geradenoch zu erkennen. Von dort aus fahren Schiffe zu Inseln und "+
    "andere Kontinenten.");
  AddDetail ( ({"baden"}),
    "Das tust Du gerade.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist azurblau und voellig wolkenlos. Die Sonne steht sehr "+
    "hoch und erwaermt das Wasser, so dass es hier sehr angenehm ist.");
  AddDetail ( ({"sonne"}),
    "Die Sonne steht hoch am Himmel und scheint auf Dich herab. Ausserhalb "+
    "des Wassers muss es sehr heiss sein, doch hier fuehlst Du Dich nur "+
    "wohl.");
  AddDetail ( ({"korallenriff", "riff"}),
    "Das Riff erstreckt sich weit von Westen nach Osten. Es ist sicher "+
    "Lebensraum fuer unzaehlige Tier- und Pflanzenarten, die Du noch nie "+
    "zuvor gesehen hast. Doch hier ueber der Wasseroberflaeche ist davon "+
    "wenig zu sehen. Im Norden des Riffs kannst Du sehen, wie sich riesige "+
    "Wellen brechen und ueber das Riff spuelen. Deswegen ist es viel zu "+
    "gefaehrlich, ueber das Riff zu klettern.");
  AddDetail ( ({"pflanze", "pflanzen", "pflanzenarten", 
                "tier", "tierarten", "tiere"}),
    "Hier ueber Wasser kannst Du weder Tiere noch Pflanzen sehen, doch "+
    "unterhalb der Wasseroberflaeche ist das Riff wahrscheinlich ein "+
    "riesiger Lebensraum fuer alle Arten von Lebewesen.");
  AddDetail ( ({"wasseroberflaeche"}),
    "Die glatte Wasseroberflaeche wird nur von einigen kleinen Wellen "+
    "gestoert.");
  AddDetail ( ({"insel", "inseln", "kontinent", 
                "kontinente"}),
    "Von hier aus kannst Du weder Inseln, noch andere Kontinente "+
    "entdecken.");
  AddDetail ( ({"lebensraum"}),
    "Sicher ist das Riff Lebensraum fuer viele Tiere und Pflanzen, die "+
    "wirst Du allerdings schwerlich ueber der Wasseroberflaeche finden.");
  AddDetail ( ({"schiff", "schiffe"}),
    "Schiffe sind momentan nicht zu sehen.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Unter der Wasseroberflaeche erkennst Du den Meeresboden, der von "+
    "Rissen und Spalten durchzogen wird. Dort unten finden sich sicher auch "+
    "die Bewohner des Riffes.");
  AddDetail ( ({"bewohner", "lebewesen"}),
    "Du koenntest Dir vorstellen, dass die unterschiedlichsten Lebewesen "+
    "das Riff bevoelkern: Fische, Krabben, Muscheln und aehnliche Tiere.");
  AddDetail ( ({"fisch", "fische", "krabbe", 
                "krabben", "muschel", "muscheln"}),
    "Diese Lebewesen findest Du sicher nur unter der Wasseroberflaeche.");
  AddDetail ( ({"riss", "risse", "spalte", 
                "spalten"}),
    "Der Grund des Riffs ist mit Rissen und Spalten uebersaeht.");
  AddSmell(({DEFAULT_SMELL,"luft","meeresluft"}),
    "Du atmest tief ein und riechst die salzige Meeresluft.");  
  AddSound(({DEFAULT_SOUND}),
    "Bis auf das leise Plaetschern des Wassers ist es hier ruhig. Weit aus "
    "dem Norden hoert man das Rauschen der Brandung.");
  AddSound(({"plaetschern","wasser","wellen"}),
    "Leise plaetschern die Wellen vor sich hin.");
  AddSound(({"rauschen","brandung"}),
    "Das Rauschen der Brandung dringt leise an Dein Ohr.");
  // DETAILS END

  // ITEMS START
  // ITEMS END
  
  AddWaterExit("westen",ROOM+"/riff01");
  AddWaterExit("suedwesten","/d/dschungel/feyaria/kueste/room/bucht");
  AddDiveExit("unten",ROOM"/riff05");
  
}
