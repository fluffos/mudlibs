#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();
  
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:23,ENV_WATER:5]));
  SetProp (P_INT_SHORT, "Am Korallenriff");
  SetProp (P_INT_LONG,
    "Du tauchst im Wasser suedlich des grossen Korallenriffs. Schon "+
    "direkt unter Dir faengt es an, und erstreckt sich weit nach Westen "+
    "und nach Osten. Rundherum leuchtet das Wasser in den verschiedensten "+
    "Farben, und Du kannst viele Fische und Wasserpflanzen sehen, die "+
    "hier wohl heimisch sind.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "grund", "korallenriff", 
                "meeresboden", "meeresgrund", "riff"}),
    "Der Meeresboden wird hier gebildet durch das Korallenriff. Aber das "+
    "Riff ist nicht kompakt, durch die vielen Jahre des Wachstums gibt es "+
    "hier unzaehlige Spalten und Hohlraeume, die die verschiedensten "+
    "Meereslebewesen beherbergen.");
  AddDetail ( ({"hohlraeume", "hohlraum", "spalte", 
                "spalten"}),
    "In den Spalten leben die verschiedensten Meereslebewesen: Krebs und "+
    "Krabben, Fische, aber auch Wasserpflanzen und seltsame Zwitterwesen "+
    "wie die Seeanemone.");
  AddDetail ( ({"seeanemone", "zwitterwesen"}),
    "Ist die Seeanemone nun eine Pflanze, oder ein Tier? Sie steht immer "+
    "nur an einem Ort, und kann sich nicht fortbewegen, aber sie frisst "+
    "andere kleine Lebewesen, als waere sie ein Tier.");
  AddDetail ( ({"farbe", "farben"}),
    "Die ganzen bunten Farben hier stammen von den riesigen Schwaermen "+
    "kleiner Regenbogenfische, die hier leben.");
  AddDetail ( ({"fische", "krabbe", "krabben", 
                "krebs", "krebse", "lebewesen", 
                "meereslebewesen"}),
    "Die unterschiedlichsten Lebewesen haben einen Lebensraum in den "+
    "Spalten des Riffs und zwischen seinen Pflanzen gefunden. Hier finden "+
    "sie Nahrung im Ueberfluss und Schutz vor anderen raeuberischen "+
    "Meeresbewohnern.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist von hier aus kaum zu sehen, schliesslich ist er ueber "+
    "der Wasseroberflaeche. Von dort faellt ein blaeuliches Licht herunter "+
    "und taucht das ganze Riff in eine unwirklich erscheinende Atmosphaere.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche liegt vielleicht 5 Meter ueber Dir.");
  AddDetail ( ({"atmosphaere", "licht"}),
    "Das blaeuliche Licht, welches von der Oberflaeche herunterfaellt, "+
    "taucht das ganze Riff in eine seltsam unwirklich scheinende "+
    "Atmosphaere.");
  AddDetail ( ({"lebensraum", "nahrung", "schutz"}),
    "Fuer die meisten, nicht raeuberischen Meeresbewohner ist Nahrung und "+
    "Schutz das wichtigste fuer einen geeigneten Lebensraum. Und das finden "+
    "sie hier im Riff.");
  AddDetail ( ({"pflanzen", "wasserpflanzen"}),
    "Hier wachsen auch die verschiedensten Wasserpflanzen. Seegraeser, die "+
    "fast wie richtige Graeser ueber Wasser aussehen, Algenbuesche und auch "+
    "andere, Dir unbekannte Pflanzen mit grossen Blaettern und leuchtenden, "+
    "bluetenaehnlichen Kelchen.");
  AddDetail ( ({"algenbuesche", "algenbusch", "buesche", 
                "busch"}),
    "Die Algenbuesche sind undurchdringliche, kleine Buesche, bei denen "+
    "man gar nicht genau sagen kann, wie sie gewachsen sind.");
  AddDetail ( ({"bueschel", "graeser", "gras", 
                "seegraeser", "seegras"}),
    "Die Seegraeser sehen aus wie kleine Bueschel normalen Grases.");
  AddDetail ( ({"blaetter", "blatt"}),
    "Die Blaetter dieser seltsamen Pflanzen sind lang, fast 50 Zentimeter, "+
    "und ziemlich schmal. An der Unterseite kleben seltsame kleine Pocken.");
  AddDetail ( ({"pocken", "unterseite"}),
    "Bei den Pocken scheint es sich auch um kleine Lebewesen zu handeln, "+
    "die in einer Art Symbiose mit der Pflanze leben.");
  AddDetail ( ({"meer", "meerwasser", "wasser"}),
    "Das Wasser ist ueberall um Dich herum und herrlich warm. Es ist "+
    "wirklich ein schoener Ort zum baden und entspannen.");
  AddDetail ( ({"bluete", "blueten", "kelch", 
                "kelche"}),
    "Es scheint sich wirklich um Blueten zu handeln. Du fragst Dich, wie "+
    "sie wohl befruchtet werden.");
  AddDetail ( ({"symbiose"}),
    "Ein Zusammenleben in einem Zustand der gegenseitigen Abhaengigkeit.");
  AddDetail ( ({"abhaengigkeit"}),
    "Das heisst wohl, dass der Eine etwas vom Andren braucht und "+
    "umgekehrt.");
  // DETAILS END

  // ITEMS START
  // ITEMS END

  AddItem(NPC+"/regenbogenfische", REFRESH_DESTRUCT);
  
  AddWaterExit("osten",ROOM+"/riff04");
  AddDiveExit("oben",ROOM"/riff03");
}
