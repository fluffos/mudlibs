#include <properties.h>
#include <moving.h>

#include "/d/wasser/cirion/riff/riff.h"

inherit (WROOM"/wroom");

void create()
{
  ::create();
  
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21]));
  SetProp (P_INT_SHORT, "Am Schiffswrack");
  SetProp (P_INT_LONG,
    "Du tauchst jetzt ueber dem Bug des Schiffswracks. Es muss einst ein "
    "stolzer Segler gewesen sein, aus fast weissem Holz, von beinahe 25 "
    "Metern Laenge. Nun liegt es sicher schon seit mehreren Jahren hier "
    "unten, knapp unter der Wasseroberflaeche. An vielen Stellen ist das "
    "Holz morsch geworden, und durch ein Loch im Schiffsdeck kann man in "
    "das Innere des Schiffes schwimmen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche liegt etwa 5 Meter ueber Dir, sie wird von "+
    "Wellen gekraeuselt. Von dort oben faellt ein blaeuliches Licht "+
    "herunter, und taucht den ganzen Ort in eine etwas unwirkliche "+
    "Atmosphaere.");
  AddDetail ( ({"atmosphaere"}),
    "Ein wenig unwirklich macht sie das Phantastische dieses Ortes aus.");
  AddDetail ( ({"phantastische", "phantastisches"}),
    "Es scheint ein wirklich phantastischer, fast uebernatuerlich schoener "+
    "Ort zu sein.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist von hier nicht zu sehn, bloss das seltsam blaeuliche "+
    "Licht, welches von oben herabfaellt.");
  AddDetail ( ({"licht"}),
    "Das Licht wird an der Wasseroberflaeche gebrochen, dann faellt es "+
    "blaeulich und seltsam mystisch wirkend herab und legt sich ueber das "+
    "Wrack und das ganze Riff.");
  AddDetail ( ({"schiff", "schiffswrack", "segler", 
                "wrack","segelschiff"}),
    "Einst ein stolzer Segler, ist das Schiff nun nicht viel mehr als ein "+
    "Wrack, wenn auch in einem erstaunlich guten Zustand. Nur ein Loch im "+
    "Schiffsdeck und am Algenbewuchs kann man erkennen, dass das Schiff "+
    "schon lange hier unten liegen muss.");
  AddDetail ( ({"algen", "algenbewuchs", "bewuchs"}),
    "An vielen Stellen ist das weisse Holz des Schiffes von gruenen Algen "+
    "bewachsen, die darauf hindeuten, dass es schon lange hier unten liegen "+
    "muss.");
  AddDetail ( ({"innere", "inneres","schiffsinnere","schiffsinneres"}),
    "Das Innere des Schiffes ist von hier aus schlecht sichtbar, da es "+
    "dort drinnen ziemlich dunkel ist. Aber Du kannst sicher "+
    "hineinschwimmen.");
  AddDetail ( ({"deck", "schiffsdeck"}),
    "Das Schiffsdeck besteht aus dicken Planken eines hellen, fast weissen "+
    "Holzes. Allerdings ist hier ein grosses Loch im Deck, durch welches "+
    "man in das Innere gelangen kann.");
  AddDetail ( ({"laenge"}),
    "Das Schiffswrack ist ungefaehr 25 Meter lang.");
  AddDetail ( ({"bug", "spitze"}),
    "Der Bug ist die vordere Spitze des Schiffes. Bei dem Wrack unter Dir "+
    "ist er schlank und elegant geformt, Du kannst Dir richtig vorstellen, "+
    "wie das Schiff einst durch die Wellen gepfluegt hat.");
  AddDetail ( ({"zustand"}),
    "Der Zustand des Wracks kann nur als vergleichsweise hervorragend "+
    "beschrieben werden, wenn man bedenkt, dass es schon seit mehreren "+
    "Jahren hier unten liegen muss.");
  AddDetail ( ({"loch"}),
    "Das ist ein grosses Loch im Schiffsdeck, welches ins Schiffsinnere "+
    "fuehrt.");
  AddDetail ( ({"wellen"}),
    "Die Wellen an der Wasseroberflaeche kommen vom offenen Meer her.");
  AddDetail ( ({"meer"}),
    "Das offene Meer liegt im Norden, allerdings kannst Du es von hier aus "+
    "nicht sehen.");
  AddDetail ( ({"boden", "grund", "meeresboden", 
                "meeresgrund"}),
    "Auf dem Meeresgrund liegt das Wrack eines grossen Segelschiffes.");
  AddDetail ( ({"stellen"}),
    "Diese Stellen sind mit Algen bewachsen und sehen daher eher gruen als "+
    "weiss aus.");
  AddDetail ( ({"planken"}),
    "Die dicken Planken sehen wirklich stabil aus, Du fragst Dich, wie "+
    "wohl dieses grosse Loch hier entstehen konnte.");
  AddDetail ( ({"holz"}),
    "Ein fast weisses, stabiles Holz mit einer feinen hellgrauen Maserung.");
  AddDetail ( ({"auge", "maserung"}),
    "Die Maserung ist mit blossem Auge kaum zu erkennen.");
  AddDetail ( ({"korallenriff", "riff", "umgebung"}),
    "Die Umgebung des Schiffswracks ist das Korallenriff, dass wohl hier "+
    "eine kleine Bucht bildet.");
  AddDetail ( ({"bucht"}),
    "Die Bucht kommt vom norden, dem offenen Meer, und ist direkt vor dem "+
    "Schiff zu Ende.");
  // DETAILS END

  // EXITS START
  
  // EXITS END

  // ITEMS START
  // ITEMS END
  
  AddWaterExit("norden",ROOM"/riff20");
  AddHiddenWaterExit("rein","in das Wrack#"ROOM"/lagerraum");
  AddHiddenWaterExit("nach drinnen","in das Wrack#"ROOM"/lagerraum");
  AddHiddenWaterExit("in wrack","in das Wrack#"ROOM"/lagerraum");
  AddHiddenWaterExit("in das wrack","in das Wrack#"ROOM"/lagerraum");
  AddHiddenWaterExit("ins wrack","in das Wrack#"ROOM"/lagerraum");
  AddHiddenWaterExit("in inneres","in das Wrack#"ROOM"/lagerraum");
  AddHiddenWaterExit("ins innnere","in das Wrack#"ROOM"/lagerraum");
  AddHiddenWaterExit("in loch","in das Wrack#"ROOM"/lagerraum");
  AddHiddenWaterExit("durch loch","in das Wrack#"ROOM"/lagerraum");
  AddDiveExit("oben",ROOM"/riff18");

}
