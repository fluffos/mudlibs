inherit "std/npc";

#include "/d/wasser/cirion/riff/riff.h"
#include "/secure/npcmaster.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Haldin, der Paladin");
  SetProp(P_LONG,
    "Vor Dir steht ein breitschultriger Mann in einer schimmernden Ruestung. "
    "In der Hand haelt er ein gewaltiges Schwert, und um seine Schultern "
    "traegt er einen Umhang. Sein Gesichtsaudruck ist ernst und doch "
    "auf eine seltsame Art barmherzig.");
  SetProp(P_NAME, "Haldin");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE);
  AddId(({"haldin","paladin"}));
  create_default_npc(18);
  SetProp(P_ALIGN, 900);
  SetProp(P_RACE,"Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_RESISTANCE, ({DT_HOLY }));
  SetProp(P_VULNERABILITY, ({DT_UNHOLY }));
  SetProp(P_NO_SCORE, 1);

  seteuid(getuid(TO));

  clone_object("/d/ebene/obj/waffe/silberschwert.lpc")->move(TO);
  command("zuecke schwert");
  clone_object("/p/armour/armour/plattenpanzer.lpc")->move(TO);
  clone_object("/p/armour/trousers/hose.lpc")->move(TO);
  clone_object("/d/wasser/stahldorn/outlaw/obj/stief.lpc")->move(TO);
  clone_object("/p/armour/belt/guertel.lpc")->move(TO);
  clone_object("/p/armour/cloak/umhang.lpc")->move(TO);
  command("ziehe alles an");

  SetAttackChats(30, ({
  "Haldin schaut Dich mitleidig an.\n",
  }) );

  SetProp( P_DIE_MSG, " kann im letzten Augenblick fliehen.\n" );

  SetProp( P_NOCORPSE, 1 );

  SetProp(P_DEFAULT_INFO,"sagt: Keine Ahnung, von was Du redest.\n");

  SetProp( P_REJECT, ({ REJECT_DROP, "Das brauche ich nicht.\n" }) );
}

init()
{
  int lvl;
  ::init();

  lvl=TP->QueryProp(P_LEVEL);
  if (lvl<10) lvl=10;
  if (lvl>25) lvl=25;
  create_default_npc(lvl);
}

int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  if (present(QUESTOBID,enemy))
  {
    MENV->RemoveExit("unten");
    MENV->AddCmd(({"u","unten"}),"fliehe_unten");
  }
  if (TO->QueryProp(P_HP)<dam+20)
  {
    if (query_once_interactive(enemy))
    {
      if (present(QUESTOBID,enemy))
      {
        present(QUESTOBID,enemy)->QuestEnde();
        return 1;
      }
    }
    else
      dam=0;
  }
  return ::Defend(dam,dam_type,spell,enemy);
}

void Attack(object enemy)
{
  if (present(QUESTOBID,enemy)&&query_once_interactive(enemy))
  {
    present(QUESTOBID,enemy)->SetEnemy(TO);
    enemy->SetProp(P_TMP_DIE_HOOK,({time()+10,present(QUESTOBID,enemy),"QuestEnde",TO,enemy}));
  }

  ::Attack(enemy);
}