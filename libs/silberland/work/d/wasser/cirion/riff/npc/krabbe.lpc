inherit "std/mnpc";

#include "/d/wasser/cirion/riff/riff.h"
#include <mnpc.h>

create()
{

  if (!is_clone(this_object())) return;

  ::create();
  
  SetProp(P_SHORT, "Eine grosse Krabbe");
  SetProp(P_LONG, "Das ist eine grosse, fast 50 Zentimeter lange Krabbe mit sechs Beinen "
                  "und zwei gefaehrlich aussehenden Scheren. Sie kriecht von Spalte zu "
                  "Spalte und scheint alles in allem nicht sehr aggressiv zu sein. "
                  "Allerdings hat sie einen harten Panzer, der sie vor allem Unbill "
                  "schuetzt.");
  SetProp(P_NAME, "Krabbe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"krabbe","grosse krabbe","riesenkrabbe"}));
  create_default_npc(8,250);
  SetProp(P_ALIGN, 0);
  SetProp(P_BODY, 80);
  SetProp(P_HANDS, ({" mit ihren beiden grossen Scheren", 120}) );
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RACE,"krabbe");
  SetProp(P_SIZE,48);
  SetProp(P_HEAL,5);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "kommt aus einer Spalte gekrabbelt");
  SetProp(P_MMSGOUT, "krabbelt in eine Spalte");

  AddDetail(({"beine","bein"}),
    "Die Krabbe hat sechs Beine, auf denen sie herumkrabbelt. Seltsamerweise "
    "bewegt sie sich dabei nur seitwaerts.");
  AddDetail(({"schere","scheren"}),
    "Die beiden grossen Scheren der Krabbe sehen wirklich gefaehrlich aus. Du "
    "solltest aufpassen, dass Du ihnen nicht zu nahe kommst.");
  AddDetail(({"panzer","koerper"}),
    "Der Panzer der Krabbe bedeckt ihren ganzen Koerper und schuetzt sie "
    "vor feindlichen Angriffen. Aber wer sollte schon einer Krabbe etwas "
    "zuleide tun?");    
  
  SetChats(3, ({
  "Die Krabbe krabbelt in eine kleine Spalte.\n",
  "Die Krabbe versteckt sich unter einigen Wasserpflanzen.\n",
  "Die Krabbe schneidet mit ihren Scheren ein grosses Blatt einer Wasserpflanze ab.\n",
  "Die Krabbe bleibt still stehen und bewegt nur langsam ihre Fuehler.\n",
  "Die Krabbe krabbelt herum.\n",
  "Die Krabbe verkriecht sich.\n",
  "Die Krabbe schnappt sich einen kleinen Fisch und vertilgt ihn.\n"
  }) );

  //Moving NPC
  SetProp (P_MNPC_AREA,({ROOM+"/riff12",ROOM+"/riff13",ROOM+"/riff14"}));
  SetProp (P_MNPC_WAIT, ({ 20+random(10) }));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS + MOV_SPECIAL);

  SetProp( P_DIE_MSG, " zerbricht in zwei Teile.\n" );

  SetProp( P_NOCORPSE, 0 );
 
  SetProp(P_DEFAULT_INFO,"kann wohl nicht sprechen.\n");

  SetProp (P_REJECT,({ REJECT_DROP, "Die Krabbe kann nichts nehmen.\n" }) );  
}