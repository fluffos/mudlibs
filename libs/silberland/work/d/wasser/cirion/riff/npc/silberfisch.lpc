inherit "std/mnpc";

#include "/d/wasser/cirion/riff/riff.h"

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include <mnpc.h>

create()
{

  if (!is_clone(this_object())) return;

  ::create();
  
  SetProp(P_SHORT, "Silberfisch");
  SetProp(P_ARTICLE,"Ein");
  SetProp(P_LIGHT, 1);
  SetProp(P_LONG, "Der Silberfisch ist ein kleiner, schlanker Fisch, der seltsamerweise ein\n"+
                  "angenehmes, silbriges Licht ausstrahlt.\n");
  SetProp(P_NAME, "Silberfisch");
  SetProp(P_GENDER, MALE);
  AddId("silberfisch");
  AddId("fisch");
  create_default_npc(5);
  SetProp(P_ALIGN, 0);
  SetProp(P_BODY, 25);
  SetProp(P_HANDS, ({" mit seinen kleinen Zaehnchen", 25}) );
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RACE,"fisch");
  SetProp(P_SIZE,25);
  SetProp(P_HEAL,5);
  SetProp(P_RESISTANCE, ({ DT_WATER })); 
  SetProp(P_VULNERABILITY, ({ DT_COLD }));

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "kommt aus einer Spalte geschwommen");
  SetProp(P_MMSGOUT, "verschwindet in einer Spalte");
  
  //Moving NPC
  SetProp (P_MNPC_AREA,({ROOM+"/riff07",ROOM+"/riff08",ROOM+"/riff09",ROOM+"/riff10",ROOM+"/riff11",ROOM+"/riff12"}));
  SetProp (P_MNPC_WAIT, ({ 20+random(10) }));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS + MOV_SPECIAL);


  
  SetChats(3, ({
  "Der Silberfisch schwimmt im Kreis herum.\n",
  "Der Silberfisch leuchtet kurz hell auf.\n",
  "Der Silberfisch knabbert an einer Wasserpflanze.\n",
  "Der Silberfisch scheint Dich anzuschauen.\n",
  "Das Leuchten des Silberfischs wird ein wenig schwaecher\n",
  "Das Leuchten des Silberfischs nimmt ein wenig zu.\n",
  "Der Silberfisch laesst einige Luftblaeschen nach oben steigen.\n",
  "Der Silberfisch schwimmt ganz ruhig auf der Stelle.\n"
  }) );

  SetProp( P_DIE_MSG, " treibt mit dem Bauch nach oben.\n" );

  SetProp( P_NOCORPSE, 0 );
 
  SetProp(P_DEFAULT_INFO,"kann wohl nicht sprechen.\n");

  SetProp (P_REJECT,({ REJECT_DROP, "Der Silberfisch kann nichts nehmen.\n" }) );
  
  seteuid(getuid(TO));
  clone_object(OBJ"/sfherz")->move(TO);

}