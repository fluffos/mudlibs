inherit "std/npc";

#include "/d/wasser/cirion/riff/riff.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();      

  SetProp(P_SHORT, "Haldin, der Paladin");
  SetProp(P_LONG, 
    "Vor Dir steht ein breitschultriger Mann in einer schimmernden Ruestung. "
    "In der Hand haelt er ein gewaltiges Schwert, und um seine Schultern "
    "traegt er einen Umhang. Sein Gesichtsaudruck ist ernst und doch"
    "auf eine seltsame Art barmherzig.");
  SetProp(P_NAME, "Haldin");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE);
  AddId(({"haldin","paladin"}));
  create_default_npc(18);
  SetProp(P_ALIGN, 900);
  SetProp(P_RACE,"Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_RESISTANCE, ({DT_HOLY }));
  SetProp(P_VULNERABILITY, ({DT_UNHOLY })); 

  seteuid(getuid(TO));

  clone_object("/d/ebene/obj/waffe/silberschwert.lpc")->move(TO);
  command("zuecke schwert");
  clone_object("/p/armour/plattenpanzer.lpc")->move(TO);
  clone_object("/p/armour/hose.lpc")->move(TO);
  clone_object("/d/wasser/stahldorn/outlaw/obj/stief.lpc")->move(TO);
  clone_object("/p/armour/guertel.lpc")->move(TO);
  clone_object("/p/armour/umhang.lpc")->move(TO);
  command("ziehe alles an");
 
  SetAttackChats(30, ({
  "Haldin schaut Dich mitleidig an.\n",
  "Haldin macht eine geschickte Finte.\n",
  "Haldin schreit: \"Verfluchtes Nekromantenpack!\"\n",
  "Haldin holt weit aus.\n",
  "Haldin macht einen Ausfallschritt.\n",
  "Haldin duckt sich geschickt unter Deiner Attacke weg.\n",
  "Haldin ruft: \"Fuer Dusty!\"\n"}) );

  SetProp( P_DIE_MSG, " stirbt den Heldentod.\n" );

  SetProp( P_NOCORPSE, 0 );
 
  SetProp(P_DEFAULT_INFO,"sagt: Keine Ahnung, von was Du redest.\n");

  SetProp( P_REJECT, ({ REJECT_DROP, "Das brauche ich nicht.\n" }) );
}

init()
{
  int lvl;
  ::init();
	
  lvl=TP->QueryProp(P_LEVEL);
  create_default_npc(lvl+2);	
}

die(int poisondeath)
{
  
}