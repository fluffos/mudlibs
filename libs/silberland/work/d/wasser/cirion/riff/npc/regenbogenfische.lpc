inherit "std/npc";

#include "/d/wasser/cirion/riff/riff.h"

int fmagie;

create()
{

  if (!is_clone(this_object())) return;

  ::create();
  
  fmagie=random(5)+1;
  SetProp(P_SHORT, "Ein Regenbogenfischschwarm");
  SetProp(P_LONG, BS(
     "Ein ganzer Schwarm dieser eigenartigen Regenbogenfische. Sie sind wunderschoen bunt "
     "und schillern in den verschiedensten Farben. Sie scheinen Dich gar nicht zu bemerken und "
     "schwimmen so dicht an Dir vorbei, dass Du sie anfassen koenntest.\n"));
  SetProp(P_NAME, "Regenbogenfischschwarm");
  SetProp(P_GENDER, MALE);
  AddId(({"regenbogenfisch","fisch","fische",
    "schwarm","schwaerme","regenbogenfischschwarm","fischschwarm","regenbogenfische"}));
  create_default_npc(1);
  SetProp(P_ALIGN, 150);
  SetProp(P_BODY, 10);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RACE,"fisch");
  SetProp(P_SIZE,3);
  SetProp(P_HEAL,0);
  SetProp(P_RESISTANCE, ({ DT_WATER })); 
  SetProp(P_VULNERABILITY, ({ DT_COLD }));
  SetProp(P_NOATTACK, "ist viel zu schnell, um ihn anzugreifen.");

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "kommt aus einer Spalte geschwommen");
  SetProp(P_MMSGOUT, "verschwindet in einer Spalte");

  //AddDetail();
  
  SetChats(4, ({
  "Die Regenbogenfische leuchten ploetzlich alle gruen auf.\n",
  "Die Regenbogenfische leuchten ploetzlich alle gelb auf.\n",
  "Die Regenbogenfische leuchten ploetzlich alle blau auf.\n",
  "Die Regenbogenfische leuchten ploetzlich alle rot auf.\n",
  "Die Regenbogenfische leuchten ploetzlich alle orange auf.\n",
  "Die Regenbogenfische leuchten ploetzlich alle violett auf.\n",
  "Die Regenbogenfische schwimmen kreuz und quer durcheinander.\n",
  "Die Regenbogenfische schwimmen unter Dir durch.\n",
  "Die Regenbogenfische scheinen im Wasser eine Art Tanz aufzufuehren.\n",
  "Die Regenbogenfische schwimmen um Dich herum.\n"
  }) );

  SetProp( P_DIE_MSG, " wird ploetzlich ganz schwarz und leblos.\n" );

  SetProp( P_NOCORPSE, 1);
 
  SetProp(P_DEFAULT_INFO,"kann wohl nicht sprechen.\n");

  SetProp (P_REJECT,({ REJECT_DROP, "Der Fischschwarm kann nichts nehmen.\n" }) );
  
  AddCmd(({"fass","fasse","beruehre"}),"aufladen");
}

int aufladen(string str)
{
  notify_fail("Was moechtest Du beruehren?\n");
  if (!str) return 0;

  if (member(({"schwarm","fische","fischschwarm","fisch","regenbogenfisch","regenbogenfische"}),str));
  {
    if (fmagie!=0)
    {
      fmagie--;
      TP->AddSp(6+random(10));
      tell_object(TP,BS("Du faehrst leicht mit der Hand durch den Fischschwarm. Die Fische scheinen ein "
               "bisschen an Farbe zu verlieren, nur um gleich darauf wieder normal zu leuchten. "
               "Ein leichtes Kribbeln zieht durch deinen Arm."));
      tell_room(MENV,BS(TP->Name()+" faehrt mit der Hand durch den Fischschwarm. Die Fische scheinen ein "
               "bisschen an Farbe zu verlieren, nur um gleich darauf wieder normal zu leuchten."
             ),({TP}));
      return 1;
    }
    else
    {
      tell_object(TP,"Du bewegst Deine Hand durch den Fischschwarm, doch nichts passiert.\n");
      tell_room(MENV,TP->Name()+"bewegt seine Hand durch den Fischschwarm.\n",({TP}));
      return 1;
    }
  }
  return 0;
}

reset()
{
fmagie=random(5)+1;

::reset();
	
return;
}