inherit "std/npc";

#include "/d/wasser/cirion/riff/riff.h"

private int align; // siehe Questitem

int QueryAlign();
object questob;

create()
{
  if (!is_clone(this_object())) return;
  if (questob=present(QUESTOBID,TP))
  {
    align=questob->QueryAlign();
  }
  else
  {
    align=random(2);
  }
  ::create();      

  SetProp(P_LONG, 
    "Du siehst einen kleinen Mann mittleren Alters vor dir, der in eine weite "
    "dunkelgraue Robe gekleidet ist. Er schaut sich aufmerksam, fast misstrauisch "
    "um, als wuerde er auf jemanden warten.");
  SetProp(P_NAME, "Tabar");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_ALIGN, align?900:-900);
  SetProp(P_RACE,"Mensch");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE, ({ align?DT_HOLY:DT_UNHOLY }));
  SetProp(P_VULNERABILITY, ({ align?DT_UNHOLY:DT_HOLY })); 
  create_paladin();
  seteuid(getuid(TO));

  clone_object("/d/ebene/ronja/feenquest/armour/dgew.lpc")->move(TO);
  clone_object("/p/armour/hose.lpc")->move(TO);
  clone_object("/d/wasser/stahldorn/outlaw/obj/stief.lpc")->move(TO);
  clone_object("/p/armour/guertel.lpc")->move(TO);
  clone_object("/p/armour/weste.lpc")->move(TO);
  clone_object("p/weapon/langschwert.lpc")->move(TO);
  command("ziehe alles an");
  command("zueck langschwert");

  
  SetProp( P_DIE_MSG, " kann im letzten Augenblick fliehen.\n" );

  SetProp( P_NOCORPSE, 1 );
 
  SetProp(P_DEFAULT_INFO,"sagt: Darueber weiss ich nichts.\n");
  AddInfo(({"tabar"}),
          "Tabar, das bin ich. Das weisst Du doch.","sagt: ");
  AddInfo(({"cirion"}),
          "Cirion ist mein Erschaffer!",
          "sagt: ");

  AddCmd("hilf","quest_beginn");
  AddCmd("gib","give_object");

}

init()
{
  int lvl;

  if (environment()->file_name()==ROOM"/tabar_vc")
    TP->move(ROOM"/tabar_vc:"+getuid(TP),M_TPORT|M_NOCHECK|M_SILENT);
	
  lvl=TP->QueryProp(P_LEVEL);
  create_default_npc(lvl);	
  if ("nekromanten"==TP->QueryProp(P_GUILD)) 
    create_nekromant();
  else
    create_paladin();
  ::init();
}

create_nekromant()
{
  SetProp(P_SHORT, "Tabar, der Nekromant");	
  AddId(({"tabar","nekromant",TABARID}));
  SetChats(4, ({
    "Tabar schaut sich nervoes um.\n",
    "Tabar schaut Dich durchdringend an, wendet dann aber seinen Blick ab.\n",
    "Tabar brummelt einen Fluch.\n",
    "Tabar grummelt etwas Unverstaendliches.\n",
    "Tabar murmelt etwas von 'Paladin' und 'Feinde', doch Du verstehst es nicht ganz.\n",
    "Tabar schaut Dich auffordernd an.\n",
    "Tabar schaut Dich boese an.\n",
  }) );

  SetAttackChats(30, ({
  "Tabar lacht Dich aus.\n",
  "Tabar ruft: Fliehe, wenn Dir Dein Leben lieb ist!\n",
  "Tabar ruft: Das Boese wird triumphieren!\n",
  "Tabar schlaegt nach Deinem Waffenarm.\n",
  "Tabar versucht Dich zu entwaffnen.\n",
  "Tabar macht eine geschickte Finte.\n",
  "Tabar sagt: Du kannst doch nicht gewinnen.\n"
  }) );
  AddInfo(({"hilfe","hilf"}),
          "Es wird aber auch langsam Zeit, dass Du auf die Idee kommst, mir zu"
          "helfen. Also, ich habe eine ganz einfache Aufgabe fuer Dich.",
          "grummelt: ");
  AddInfo("aufgabe",
          "Einst haben die verfluchten Paladine ein maechtiges magisches Artefakt "
          "geschaffen, das Paladinamulett, "
          "um uns, die Nekromanten, ein fuer alle mal zu vernichten. "
          "Doch gluecklicherweise haben einige clevere Nekromanten es geschafft, "
          "das Amulett zu stehlen, und sie bestiegen ein Schiff, um zurueckzukehren "
          "in die Unterwelt und den verfluchten Gegenstand zu zerstoeren. "
          "Das Schiff aber sank, hier vor der Kueste Tijaras. Nun ist es an Dir, "
          "das Amulett zu bergen und mir zu bringen, auf dass ich es zerstoeren "
          "kann. Du willst mir helfen, also tipp schon <hilf tabar>!",
          "zischt: ");
  AddInfo(({"kueste"}),
          "Ich wette, das Schiff ist vor der Westkueste Tijaras gesunken.",
          "sagt: ");
  AddInfo(({"schiff","wrack","schiffswrack"}),
          "Das Schiff, auf dem das Amulett transportiert wurde, ist vor der "
          "Kueste von Tijara gesunken, ich nehme an, am Riff westlich von Tijara. "
          "Dort wirst Du das Wrack zuerst suchen.",
          "befiehlt: ");
  AddInfo(({"amulett","paladinamulett","artefakt"}),
          "Das Paladinamulett ist ein maechtiges Artefakt, von den Paladinen "
          "geschaffen und dem Guten geweiht. Wer es besitzt, kann damit die "
          "Nekromanten ein fuer alle mal besiegen, daher muss es vernichtet werden!",
          "schreit: ");
  AddInfo(({"riff","korallenriff"}),
          "Dort am Riff wird das Schiff sicher liegen. Du musst hinuntertauchen "
          "um es zu finden, und das solltest Du lieber schnell machen, wenn Dir "
          "Dein Leben lieb ist!"
          "funkelt Dich an: ");
  AddInfo(({"paladin","paladine","feind","feinde"}),
          "Die Paladine sind unsere Feinde, sie muessen vernichtet werden!");
}

create_paladin()
{
  RemoveId("nekromant");
  SetProp(P_SHORT, "Tabar, der Suchende");
  AddId(({"tabar","suchender",TABARID}));
  SetChats(4, ({
    "Tabar schaut sich unruhig um.\n",
    "Tabar schaut Dich fragend an, wendet dann aber seinen Blick ab.\n",
    "Tabar murmelt etwas Unverstaendliches.\n",
    "Tabar seufzt niedergeschlagen.\n",
    "Tabar murmelt etwas von 'Schatten' und 'Bedrohung', doch Du verstehst es nicht ganz.\n",
    "Tabar schaut sich hilfesuchend um.\n",
    "Tabar schaut dich durchdringend an.\n",
  }) );

  SetAttackChats(30, ({
  "Tabar greift Dich mit dem Mut der Rechtschaffenen an.\n",
  "Tabar ruft: Fuer Dusty!\n",
  "Tabar ruft: Das Gute wird siegen!\n",
  "Tabar macht eine geschickte Finte.\n",
  "Tabar holt aus und schlaegt nach Deinem Waffenarm.\n",
  "Tabar versucht Dich zu entwaffnen.\n",
  "Tabar sagt: Du kannst doch nicht gewinnen.\n"
  }) );
  AddInfo(({"hilfe","hilf"}),
          "Du moechtest mir helfen? So wisse denn, ich habe eine gefaehrliche "
          "Aufgabe auf mich geladen, und auch fuer Dich wird es gefaehrlich "
          "sein, mir zu helfen. Ueberdenke es gut, und wenn Du Dich entschieden "
          "hast, komme zu mir.",
          "sagt: ");
  AddInfo("aufgabe",
          "Einst hat ein maechtiger Nekromant, der verfluchte Sha'nakra, ein "
          "maechtiges magisches Artefakt geschaffen, das Nekromantenamulett. "
          "Mit seiner Hilfe ist es einem Diener des Boesen moeglich, die "
          "niederen Daemonen der Hoelle ins Silberland hinaufzubeschwoeren. "
          "Zum Glueck konnte Sha'nakra das Amulett von einer Gruppe beherzter "
          "Helden entwendet werden, und sie bestiegen ein Schiff, um das "
          "Amulett zu den Paladinen zu bringen, auf dass diese es vernichten "
          "mochten. Doch das Schiff kam nie an, es sank hier vor der Kueste "
          "Tijaras.\nNun ist es an mir, das Amulett zu bergen und zu "
          "vernichten. Willst Du mir wirklich dabei behilflich sein? "
          "(Syntax: hilf tabar)",
          "sagt: ");
  AddInfo(({"kueste"}),
          "Ich denke, das Schiff ist vor der Westkueste Tijaras gesunken.",
          "sagt: ");
  AddInfo(({"schiff","wrack","schiffswrack"}),
          "Das Schiff, auf dem das Amulett transportiert wurde, ist vor der "
          "Kueste von Tijara gesunken, ich nehme an, am Riff westlich von Tijara. "
          "Dort solltest Du das Wrack zuerst suchen.",
          "sagt: ");
  AddInfo(({"amulett","nekromantenamulett","artefakt"}),
          "Das Nekromantenamulett ist ein maechtiges Artefakt, von Sha'nakra "
          "geschaffen und dem Boesen geweiht. Wer es besitzt, kann damit die "
          "Daemonen der Hoelle heraufbeschwoeren, daher muss es vernichtet werden!",
          "sagt: ");
  AddInfo(({"riff","korallenriff"}),
          "Dort am Riff wird das Schiff sicher liegen. Du musst hinuntertauchen "
          "um es zu finden, also ist es sicher nicht einfach. Doch ich bin "
          "zuversichtlich, dass Du es schaffen wirst.",
          "sagt: ");
  AddInfo(({"daemon","daemonen"}),
          "Daemonen leben in verschiedenen Existenzebenen, es sind machtvolle, "
          "unendlich boese Kreaturen, die nur Tod und Zerstoerung im Sinn haben. "
          "Die schlimmsten unter ihnen sind diejenigen, die direkt aus der Hoelle "
          "stammen.",
          "sagt: ");
  AddInfo(({"existenzebenen","ebenen","welten"}),
          "Darueber weiss ich nicht viel, nur dass es so etwas wie andere Welten sind.",
          "sagt: ");
  AddInfo(({"nekromant","sha'nakra","shanakra"}),
          "Sha'nakra gilt als einer der maechtigsten Nekromanten des Silberlandes. "
          "Seit ihm das Nekromantenamulett gestohlen wurde, ward er nicht mehr "
          "gesehen, Legenden besagen allerdings, dass er in den Tiefen der Unterwelt "
          "Zuflucht gesucht hat.",
          "sagt: ");
  AddInfo(({"unterwelt"}),
          "Die Unterwelt ist ein grosses Hoehlensystem, welches unter dem ganzen "
          "Silberland liegt. Dort hausen die Kreaturen des Boesen, es ist ein "
          "schlechter Ort.",
          "sagt: ");
  AddInfo(({"schatten","bedrohung"}),
          "Ein Schatten liegt ueber dem Silberland, denn ein boeses Amulett "
          "bedroht uns alle.",
          "sagt: ");
  AddInfo(({"silberland"})
          ,"Wir muessen das Silberland schuetzen, so gut wir koennen.",
          "sagt: ");
  AddInfo(({"vernichtung"}),
          "Das Amulett muss vernichtet werden! Und das koennen nur die "
          "Paladine, daher muss ich es zu ihnen bringen.",
          "sagt: ");
}

int give_object(string str)
{ 
  if (present("\ncirinekromantenamulett",TP))
  {
    if (-1!=member(({"amulett tabar",
                     "amulett an tabar",
                     "tabar amulett",
                     "tabar das amulett",
                     "nekromantenamulett tabar",
                     "nekromantenamulett an tabar",
                     "tabar nekromantenamulett",
                     "tabar das nekromantenamulett",
                     "paladinamulett tabar",
                     "paladinamulett an tabar",
                     "tabar paladinamulett",
                     "tabar das paladinamulett"
                     }),str))
      return present(QUESTOBID,TP)->tabar_give_amulett();	
  }
  return 0;
}

give_notify(object ob)
{
  if (!ob->id("\ncirinekromantenamulett"))
  {
    command("sag Das kann ich nicht brauchen.");
    write("Tabar gibt Dir "+ob->Name()+" zurueck.\n");
    ob->move(TP,M_NOCHECK);	
  }	
}

int QueryAlign()
{
  return align;	
}

int quest_beginn(string str)
{
  notify_fail("Wem moechtest Du helfen?");
  if (str!="tabar") return 0;
  if (present(QUESTOBID,TP))
  {
    if (align==1)
    {
      command("sag Du hilfst mir doch bereits! Nun beeil Dich aber ein wenig!");
      write("Tabar schaut Dich streng an.\n");
    }
    else
    {
      command("sag Was stehst Du noch hier und glotzt mich an? Los, mach Dich an die Arbeit!");
      write("Tabar funkelt Dich boese an.\n");	
    }
    return 1;	
  }
  clone_object(OBJ"/questobj")->move(TP,M_NOCHECK);
  write_file(RIFFQUESTLOGFILE,TP->Name()+" beginnt die Quest am "+dtime(time())+"\n");
  if (align==1)
  {
    command("sag Du moechtest mir also wirklich helfen. Nun gut, Deine Aufgabe "
            "soll es sein, das verfluchte Amulett zu finden und mir zu bringen, "
            "auf dass ich es ein fuer alle Mal vernichten kann.");
    write ("Tabar nickt Dir zu.\n");
    command("sag Ich werde hier sein und auf Dich warten.");
  }
  else
  {
    command("sag Na endlich hast Du Dich entschieden. Jetzt mach, dass Du das "
            "verfluchte Amulett findest, aber beeil Dich ein bisschen!");
    write("Tabar sieht Dich befehlend an.\n");
    command("sag Los, ich warte nicht gerne!");            	
  }
  return 1;
}

die()
{
  MENV->RemoveCmd(({"u","unten"}));
  MENV->AddExit (("unten"),"zur Tuer hinaus und die Treppe hinunter#/d/dschungel/feyaria/tijara/room/hotel_c6");

  ::die();
}

int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  if (present(QUESTOBID,enemy))
  {
    MENV->RemoveExit("unten");
    MENV->AddCmd(({"u","unten"}),"fliehe_unten");
  }
  if (TO->QueryProp(P_HP)<dam+20)
  {  
    if (query_once_interactive(enemy))
    {
      if (present(QUESTOBID,enemy))
      {
        present(QUESTOBID,enemy)->QuestEnde();
        return 1;
      }
    }
    else 
      dam=0;
  }
  return ::Defend(dam,dam_type,spell,enemy);
}

void Attack(object enemy)
{
  if (present(QUESTOBID,enemy)&&query_once_interactive(enemy))
  {
    present(QUESTOBID,enemy)->SetEnemy(TO);
    enemy->SetProp(P_TMP_DIE_HOOK,({time()+10,present(QUESTOBID,enemy),"QuestEnde"}));
  }

  ::Attack(enemy);	
}