inherit "std/armour";

#include "/d/wasser/cirion/riff/riff.h"

string info_fun();

create()
{
  if (!is_clone(TO)) return;
  
  ::create();
  
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NODROP,1);
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 3);
  SetProp(P_MAGIC,25);
  SetProp(P_WEIGHT,300);
  SetProp(P_VALUE,15000);
  SetProp(P_SHORT, "Das Paladinamulett");
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_LONG, 
    "Das ist ein schweres, silbernes  Amulett mit einem dunkelblauen Wasserstein "
    "in der Mitte. Rund um den Stein, der von innen heraus zu gluehen scheint, "
    "sind seltsame, elegant aussehende Runen in das Amulett graviert. Eine "
    "fast koerperlich spuerbare Aura des Guten geht davon aus.");
  SetProp(P_NAME, "Paladinamulett");
  SetProp(P_INFO,
    "Mit diesem Amulett scheint man boese Wesenheiten bekaempfen "
    "zu koennen. (und ganz nebenbei scheint hier ein Bug vorzuliegen, "
    "wende Dich doch bitte mal an Cirion.)");
  AddId(({"\ncirinekromantenamulett","amulett","paladinamulett"}));
  SetProp(P_MATERIAL, ([MAT_SILVER:92, MAT_STONE:8, MAT_MAGIC:100]) );
  AddDetail(({"wasserstein","stein","edelstein"}),
    "Der Wasserstein ist ein dunkelblauer Edelstein, der in einem hellen "
    "Feuer von innen heraus zu brennen scheint.");
  AddDetail(({"feuer"}),
    "Es scheint guten Ursprungs zu sein und ist ganz eindeutig magisch.");  
  AddDetail(({"rune","runen","schriftzeichen","zeichen"}),
    "Es sind sehr seltsame, ineinander verschlungene Schriftzeichen, die "
    "sehr elegant gefertigt sind. Sicher binden diese Runen "
    "irgendeine seltsame Magie.");
  AddDetail(({"aura","gute","gutes","magie"}),
    "Die magische Aura des Guten ist fast koerperlich spuerbar und sehr stark.");  	
}

string _query_info()
{ 
  string inform;
  inform=BS("Mit diesem Amulett scheint man maechtige Wesenheiten beschwoeren zu koennen.");
  if (TP->QueryProp(P_GUILD)=="paladine")
    inform+=" Dies ist ein Artefakt des Boesen! Es muss vernichtet werden!";
  else if (TP->QueryProp(P_GUILD)=="druidenzirkel")
    inform+=" In diesem Artefakt stecken daemonische Kraefte, die die Balance "
            "der Elemente zerstoeren koennten. Es muss vernichtet werden!";
  else if (TP->QueryProp(P_GUILD)=="nekromanten")
    inform+="Dies ist ein Artefakt des Guten! Es muss vernichtet werden!";
  else
    inform+="Dieses Artefakt koennte dem Boesen eine grosse Hilfe sein, Du solltest "
            "wohl besser dafuer sorgen, dass es ihm nicht in die Finger faellt.";
  return inform;
}