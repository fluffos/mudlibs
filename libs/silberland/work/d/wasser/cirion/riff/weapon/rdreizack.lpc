inherit "std/weapon";

#include "/d/wasser/cirion/riff/riff.h"

create()
{
  if (!is_clone(this_object()))
     return;

  ::create(); 
  
  SetProp(P_SHORT, "Dreizack");
  SetProp(P_NAME_ADJ,"rostig");
  SetProp(P_LONG, 
    "Dies ist ein ziemlich rostiger Dreizack, er ist in einem so schlechten Zustand, "
    "dass alles reparieren vergebene Liebesmueh waere. Allerdings hat er sicher "
    "schon einmal bessere Tage gesehn, und war einst eine recht ansehnliche Waffe.");
  SetProp(P_NAME, "Dreizack");
  SetProp(P_GENDER, MALE);
  AddId("dreizack");
  SetProp(P_VALUE, 300);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 135);
  SetProp(P_WC_FIXFACTOR,0.2);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,MAT_IRON);
}

int Damage(int i)
{return 0;}

TakeFlaw(mixed m)
{return;}

mixed dam_desc()
{
  return "schrottreifen";
}