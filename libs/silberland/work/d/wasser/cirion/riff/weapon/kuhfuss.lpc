inherit "std/weapon";

#include "/d/wasser/cirion/riff/riff.h"

nosave int pause;

create()
{
  if (!is_clone(this_object()))
     return;

  ::create(); 
  
  pause=time();
  SetProp(P_SHORT, "Kuhfuss");
  SetProp(P_ARTICLE,"Ein");
  SetProp(P_LONG, 
    "Dies ist ein Kuhfuss, ein recht grosses Brecheisen, dessen Ende ein wenig "
    "gespalten ist, so dass es wie ein Kuhfuss ausschaut.");
  SetProp(P_NAME, "Kuhfuss");
  SetProp(P_GENDER, MALE);
  AddId(({"\cirikuhfuss","kuhfuss","brecheisen","werkzeug"}));
  SetProp(P_VALUE, 800);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_INFO,"Du kannst mit dem Kuhfuss unter Deinen Feinden wueten. "
                 "(Syntax: wuete)");
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 80);
  SetProp(P_WC_FIXFACTOR,0.3);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_STEEL:100]));
  SetProp(P_HIT_FUNC,TO);
//  AddCommand("wuete","wuete");    -- changed by Crea
  AddCmd("wuete","wuete");
}

int HitFunc(object enemy)
{
  if (pause>time())
    return 100;
  return 0;
}

wuete_ende()
{
  write(BS("Deine Kraft laesst nach, Du hast Dich beim Wueten ziemlich "
           "verausgabt."));
  say(BS(TP->Name()+" scheint sich beim Wueten ziemlich verausgabt zu haben."));
  TP->AddHp(-10);
  SetProp(P_WC_FIX,30);
  return;
}

int wuete()
{
  notify_fail(BS("Dazu solltest Du Dich schon im Kampf befinden."));
  if (TP->InFight()==0)
    return 0;	
  notify_fail("Naja, staendig kannst Du das auch nicht machen.\n");
  if (pause>time())
    return 0;	
  notify_fail("Du solltest den Kuhfuss dazu schon in die Hand nehmen.\n");  
  if (QueryProp(P_WIELDED)!=TP ) 
    return 0;
  notify_fail("Du bist schon zu schwach dazu.\n");
  if (TP->QueryProp(P_HP) < 10) 
    return 0;
  notify_fail("Nicht alles auf einmal!\n");
  if (TP->QueryProp(P_ATTACK_BUSY))
    return 0;
  //Nu aber! :)
  write(BS("Du packst den Kuhfuss fester mit beiden Haenden und beginnst "
           "wie ein Wilder unter Deinen Feinden zu wueten."));
  say(BS(TP->Name()+" packt den Kuhfuss fester mit beiden Haenden und ein "
                   "faengt an wie ein Wilder unter seinen Feinden zu "
                   "wueten."));
  TP->SetProp(P_ATTACK_BUSY, 1);
  SetProp(P_WC_FIX,50);
  pause=time()+300;
  call_out("wuete_ende",30);
  return 1;
}
