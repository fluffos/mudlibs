#include "/d/wasser/cirion/riff/riff.h"

inherit "/d/wasser/cirion/weapon/kstab.lpc";

create()
{
  if (!is_clone(this_object()))
     return;

  ::create(); 
  
  SetProp(P_SHORT, "Ein schwarzer Kampfstab");
  SetProp(P_LONG, 
    "Das ist ein Kampfstab aus einem schwarzen Holz, mit silbern eingelegten "
    "Runen darauf. Er ist ungefaehr 2 Meter lang und scheint eine formidable "
    "Waffe abzugeben.");
  SetProp(P_NAME, "Kampfstab");
  SetProp(P_GENDER, MALE);
  AddId("kampfstab");
  SetProp(P_VALUE, 1700);
  SetProp(P_WEIGHT, 1400);
  SetProp(P_WC, 175);
  SetProp(P_WC_FIXFACTOR,0.5);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_EBONY:95,MAT_SILVER:5]));
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:12, A_DEX:12, A_INT:10]) );
  
  AddDetail(({"holz","ebenholz"}),
    "Es scheint sich wohl um Ebenholz zu handeln, jedenfalls ist es ziemliche "
    "hart.");
  AddDetail(({"rune","runen"}),
    "Fremdartige Runen in einer Dir unbekannten Sprache. Sie sind "
    "kunstvoll eingelegt und machen wohl auch den Wert dieser Waffe aus.");
  AddDetail(({"sprache"}),
    "Nein, Du kennst sie wirklich nicht.");
  AddDetail(({"wert"}),
    "Der ist sicher nicht zu unterschaetzen.");
}
