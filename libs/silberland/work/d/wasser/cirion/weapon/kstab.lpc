inherit "std/weapon";

#include "/d/wasser/cirion/water.h"

create()
{
  if (!is_clone(this_object()))
     return;

  ::create(); 
  
  SetProp(P_SHORT, "Ein Kampfstab");
  SetProp(P_LONG, 
    "Ein simpler hoelzerner Kampfstab.");
  SetProp(P_NAME, "kampfstab");
  SetProp(P_GENDER, MALE);
  AddId(({"kampfstab","\ncimy\nkampfstab","stab"}));
  SetProp(P_VALUE, 300);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 150);
  SetProp(P_WC_FIXFACTOR,0.3);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_MISC_WOOD:100]));
}
