#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "./def.h"
#include <combat.h>
#include <moving.h>

void create()
{
  ::create();
  

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Eingang zur Arena in Neutijara" );
  SetProp( P_INT_LONG, break_string("Du stehst in noerdlichen Teil der Eingangshalle, "+
           "vor dem Kampfplatz der Arena in Neutijara. Sie ist in diesem Teil nicht ueberdacht, sodass man gen Himmel blicken kann. "+
           "Die stadienartig - ovale Form des Kampfplatzes laesst sich von hier aus schon erahnen. "+
           "Richtung Sueden befindet sich der Ausgang der Arena und "+
           "nach Nordunten hin kann man den Kampfplatz der Arena durch einen magischen Torbogen betreten. "+
           "Im Westen und Norden siehst Du Treppen die zur hoeher gelegenen Tribuene fuehren, sowie eine Treppe nach unten ins Restaurant der Arena.",78)); 
  
  SetProp(P_INDOORS,0);
  
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_TOWN]) );
  
  AddDetail( "kampfplatz",
             "Auf dem Kampfplatz werden Duelle ausgetragen." );
  AddDetail( ({ "torbogen","bogen", "nordunten" }),
                "Dieser Torbogen laesst niemanden ohne Registrierung auf den Kampfplatz.\n" );
  AddDetail( ({ "boden", "fussboden", "holzboden" }),
	     "Ein einfacher Holzboden.\n" );
  AddDetail( ({ "holz" }),
             "Scheint stabiles Steineichenholz zu sein.\n" );
  AddDetail( ({ "holz","steineichenholz" }),
             "Steineichenholz ist bekannt fuer seine Stabilitaet.\n" );
  AddDetail( ({ "stabilitaet" }),
             "Das haelt einiges aus.\n" );
  AddDetail( ({ "tribuene","tribuenen" }),
	     "Die Tribuenen kannst Du ueber die Treppen im Norden und Westen erreichen.\n" );
  AddDetail( ({ "wand", "waende" }),
             "Du findest hier keine Waende, dafuer zwei Treppen auf die Tribuene, einen Durchgang zum Kampfplatz und eine Treppe is Restaurant.\n" );
  AddDetail( ({ "decke" }),
             "Dieser Teil der Eingangshalle ist nicht ueberdacht und steht somit quasi frei.\n" );
  AddDetail( ({ "himmel" }),
             "Scheinbar strahlt die Sonne ihr Licht heute besonders eifrig auf die Erde.\n" );
  AddDetail( ({ "licht","lichtverhaeltnisse" }),
             "Die Lichtverhaeltnisse sind hervorragend, Du wirst sicher alles von einem Duell in der Arena mitbekommen.\n" );
  AddDetail( ({ "arena","arenen","gebaeude" }),
             "Eine Arena ist ein Platz auf dem Duelle ausgetragen werden.\n" );
  AddDetail( ({ "duell","duelle" }),
             "Darueber fragst Du am besten einen Vertreter der Arenaleitung aus.\n" );
  AddDetail( ({ "arenaleitung", "vertreter" }),
             "Versuch es einmal im suedlichen Teil der Eingangshalle.\n" );
  AddDetail( ({ "platz" }),
             "In diesem Fall ist es ein stadienartig - oval angelegter Platz.\n" );
  AddDetail( ({ "fall" }),
             "Du siehst hier nur eine Arena, aber vielleicht gibt es ja noch mehrere, von denen Du noch nichts weisst.\n" );
  AddDetail( ({ "treppe","treppen" }),
             "Eine Treppe fuehrt in den Keller, zum Restaurant der Arena, und ueber die beiden anderen kannst Du die Tribuenen erreichen.\n" );
  AddDetail( ({ "restaurant", "keller" }),
             "Das Restaurant der Arena hat einen wirklich exzellenten Ruf.\n" );
  AddDetail( "ruf",
             "Du solltest wirklich einmal dort essen!\n" ); 
  AddDetail( "erde",
             "Wuerde es im Dschungel nicht so haeufig regnen, wuerde die Erde sicherlich ausgetrocknet sein.\n" );
  AddDetail( ({ "form", "stadion" }),
             "Die Arena hat die ovale Form eines Stadions.\n" );
  AddDetail( ({ "ausgang", "richtung", "sueden" }),
             "Zum Ausgang geht es Richtung Sueden.\n" );
  AddDetail( ({ "sonne", "hitze" }),
             "Die gluehende Sonne verursacht unsaegliche Hitze, Du schwitzt schon ganz schoen.\n" ); 
  AddDetail( "dschungel",
             "Um in den Dschungel zu kommen, musst Du den Weg nach Sueden nehmen.\n" );
  AddDetail( "weg",
             "Dieser Weg ist jedoch sehr gefaehrlich! Nimm Dich in acht!\n" );
  AddDetail( ({ "eingangshalle", "halle", "teil" }),
             "Du befindetst Dich im noerdlichen Teil der Eingangshalle.\n" );
  AddDetail( ({ "registrierung", "buero", "arenaverwaltung" }),
             "Das Buero der Arenaverwaltung, in dem Du Dich und einen Partner, fuer ein Duell registrieren kannst, liegt im Suedwesten.\n" );
  AddDetail( "partner",
             "Den musst Du Dir selber suchen.\n" );
  AddDetail( ({ "neutijara", "stadtteil" }),
             "Neutijara ist der neueste Stadtteil der Stadt Tijara.\n" );
  AddDetail( ({ "tijara", "hauptstadt", "stadt" }),
             "Tijara ist die Hauptstadt der Region Dschungel.\n" );
  AddDetail( ({"region", "regionen" }),
             "Es gibt viele Regionen im Silberland, die Region Dschungel ist eine davon und viele meinen nicht zu unrecht es sei die liberalste und freiste von allen.\n" );
  AddDetail( ({ "silberland", "land" }),
             "Dieses Land ist als Silberland bekannt - oh das reimt sich ja!\n" );
             
  AddSmell( DEFAULT_SMELL,
            "Angenehme Duefte dringen von unten her an Deine Nase.\n" );
            
  AddSmell( "duefte",
            "Das wird wohl vom Restaurant her kommen.\n" );
            
  AddSmell( "restaurant",
            "Schau am besten mal runter.\n" );
            
  AddSmell( "nase",
            "Deine Nase riecht NICHT, damit kannst Du etwas riechen!\n" );
     
  AddSound( DEFAULT_SOUND,
            "Du kannst das Klirren von Waffen hoeren.\n" );
            
  AddSound( ({"waffen", "klirren"}),
            "Wird wohl vom Kampfplatz her kommen.\n" );
            
  AddSound( "waffe",
            "Du kannst nicht feststellen, um welche Waffe es sich handelt.\n" );
            
  AddSound( "kampfplatz",
            "Da musst Du wohl noch naeher ran um mehr zu hoeren.\n" ); 

  AddExit("nordunten",([ EX_DEST : PKROOM "battle_field_o",
                         EX_MSG  : "durch den Torbogen, die Treppe noerdliche hinunter, in den Ostteil der Arena",
                         EX_TESTFUNC : "prevent_enter"]) );

  AddExit("sueden",([ EX_DEST : ROOM "suedteil",
                      EX_MSG  : "nach Sueden, in den suedlichen Teil der Eingangshalle"]) );

  AddExit("westoben",([ EX_DEST : ROOM "tribuene_so",
                        EX_MSG  : "nach Westoben, auf die suedoestliche Seite der Tribuene",
                        EX_TESTFUNC : "check_entrance"]) );

  AddExit("nordoben",([ EX_DEST : ROOM "tribuene_o",
                        EX_MSG  : "nach Nordoben, auf die oestliche Seite der Tribuene",
                        EX_TESTFUNC : "check_entrance"]) );

  AddExit("unten",([ EX_DEST :  ROOM "taverne",
                     EX_MSG  : "die Treppe hinunter, in die Taverne"]) );

  AddItem(NPC "collector", REFRESH_DESTRUCT, 1);
}

// Funktion zum Pruefen der Eintrittskarte
int check_entrance()
{
   object orden, guardian, karte;
   // Ohne den NPC auch keine Eintrittskarten ...
   if (!objectp(guardian = find_object (NPC "collector")))
   {
      tell_object(this_player(), "Da der Kartenabreisser nicht da ist, brauchst Du auch keine Eintrittskarte.\n");
      return 1;
   }
   // Collector scheint nicht hier zu sein ...
   if (!present(guardian, this_object()))
   {
       // Collector ist grade verhindert ...
       tell_object(this_player(), "Da der Kartenabreisser beschaeftigt ist, brauchst Du auch keine Eintrittskarte.\n");
       return 1;
   }
   else
   {
      // Nun sehen wir mal ob unser Spieler eine Karte hat ...
      if (objectp(karte = present("eintrittskarte", this_player())))
         {
           // Oh brav! Der Spieler hat eine Karte!
           tell_room(this_object(), guardian->name(WER) + " sagt: In Ordnung "+this_player()->name(WER)+"! Ihr duerft auf die Tribuene!\n");
           tell_room(this_object(), guardian->name(WER) + " nimmt "+this_player()->name(WER)+" die Eintrittskarte ab.\n", ({this_player()}));
           tell_object (this_player(), guardian->name(WER) + " nimmt Dir die Eintrittskarte ab.\n");
           karte->remove();
           return 1;
         }
      else
         {
            // Ohje! Der Spieler hat keine Karte gekauft!
            // Ist der Gast unsichtbar?
            if (this_player()->QueryProp(P_INVIS))
               return 1;
            else
            {
               tell_room( this_object(), guardian->name(WER) + " sagt: Halt "+this_player()->name(WER)+"! Ihr benoetigt eine Eintrittskarte fuer die Tribuene!\n");
               return 0;
            }
         }
      }
   return 1;
}   

// Seit dem letzten Update kann man nicht mehr von selbst in die Arena!
int prevent_enter()
{
  if (IS_LEARNER(this_player()))
     return 1;

  write (break_string("Im Torbogen manifestiert sich ein gleissend blaues Energiefeld, "+
        "welches Dich zurueckhaelt! Du kannst die Arena nicht auf diese Weise betreten!",78));

  tell_room (this_object(), break_string(this_player()->name(WER, 1)+" versucht die Arena zu betreten, "+
           "doch wird von einem gleissend blauem Energiefeld, welches sich im Torbogen manifestiert, "+
           "zurueckgehalten!",78), ({this_player()}));

  return 0;
}
