#include <language.h>
#include <ansi.h>
#include "./def.h"
#include "../../lib/unique_npc/headers/unique_npc.h"

inherit "std/npc/sequencer";
inherit NPC "arena_race_specs";
inherit LIB_UNIQUE "classes/unique_npc";

create()
{
  if (!is_clone(this_object()))
    return;
    
  arena_race_specs::create();
  unique_npc::create();
  ::create();
  SetProp(P_UNIQUE_RACE_PROBABILITY, ({ ({"Mensch",100}), ({"Elf",30}), 
                          ({"Zwerg",30}), ({"Hobbit",30}) }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_ARTICLE, 0);
  create_default_unique_npc( 30, 50, 0, NPC "arena_names", NPC "arena_surnames" );
  AddId(lower_case(QueryProp(P_NAME)));
  AddId(distinguish_gender("waechter", "waechterin"));
  AddId("Axtexperte");
  SetProp(P_SHORT, 
  QueryProp(P_NAME) + distinguish_gender(" der Waechter", " die Waechterin"));
  SetProp(P_LONG,  get_long("Vor Dir steht "+QueryProp(P_NAME)+", der Waechter der Arena. ",
                       "Vor Dir steht "+QueryProp(P_NAME)+", die Waechterin der Arena. ") );

  SetProp( P_ALIGN, get_between (0, 100) );
  SetProp(P_MAX_HANDS, 2);
  seteuid(getuid(this_object()));
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_DIE_MSG, " stirbt mit dem Ausdruck der Niederlage auf dem Gesicht.\n" );
  SetProp( P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Es war ein grosser Fehler mich herauszufordern, %s!");
  SetProp(P_MURDER_MSG, "Nicht schlecht, das haette ich Euch nicht zugetraut!");
  SetProp(P_DEFAULT_INFO, "sagt: Da fragt Ihr am besten jemanden vom Arenapersonal.\n");
  SetChats(2, ({
    name()+" mustert Dich genau.\n",
    name()+" blickt Dich pruefend an.\n",
    name()+" sagt: Die Duelle in der Arena sind hart!\n",
    name()+" fragt: Seid Ihr Zuseher oder Teilnehmer?\n",
    name()+" sagt: Macht mir ja keinen Aerger!\n"}) );
    
  SetAttackChats(5, ({
    name()+" sagt: Verschwindet!\n",
    name()+" sagt: In der Arena traut Ihr Euch wohl nicht?\n",
    name()+" sagt: Ihr seid ein Feigling!\n" }) );

// Spezielle Informationen, die der NPC selbst beantwortet:
  AddInfo( "neutijara",
    "Neutijara ist ein Stadtteil von Tijara, der Hauptstadt der Region Dschungel.\n", "sagt: " 
  );
  AddInfo( ({ "hauptstadt", "tijara", "stadt" }),
    "Tijara ist eine maechtige und schoene Stadt, einer Hauptstadt wuerdig!\n", "sagt: "
  );
  AddInfo( ({ "region", "dschungel" }),
    "sagt: Tijara liegt in der Region Dschungel.\n" 
  );
  AddInfo( "arena",
    "In dieser Arena koennt Ihr einen Gegner zum ehrenvollen Duell registrieren.\n",
    "sagt: "
  );
  AddInfo( "gegner",
    "Den muesst Ihr Euch selbst waehlen.\n" , "sagt: "
  );
  AddInfo( ({ "duell", "duelle", "kaempfe" }),
    "In der Arena koennt Ihr Euch und einen Partner fuer das ehrenvolle Duell registrieren. "+
    "Die Duelle folgen fixen Regeln, welche Ihr unbedingt beachten solltet. "+
    "Fuer weitere Informationen fragt Ihr am besten einen Vertreter der Arenaleitung.\n", "sagt: "
  );
  AddInfo( "regeln",
    "Dazu lest Ihr Euch an besten die Anleitung zum ehrenvollen Duell durch und fragt das Personal der Arena. "+
    "Ihr koennt diese Seiten mit 'hilfe duell' lesen.\n", "sagt: "
  );
  AddInfo( ({"personal", "arenapersonal"}),
    "Betretet einfach die Arena und geht nach Westen.\n", "sagt: "
  );

  SetProp (P_SPELLRATE, 30);
  
  // Rammen:
  AddSpell(5, 1000,
           name()+" rammt Dich mit dem Kopf.\n",
           name()+" rammt @WEN mit dem Kopf.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
  
  // Spalthieb:
  AddSpell(3, 1200,
           name()+" holt zu einem Spalthieb aus und laesst die "+
                  "Axt auf Dich niedersausen.\n",
           name()+" holt zu einem Spalthieb aus und laesst die "+
                  "Axt auf @WEN niedersausen.\n",
          ({DT_SLASH}), ([SP_SHOW_DAMAGE:1]) );
          
  // Blinde Wut:
  AddSpell(2, 1500,
           name()+" laesst die Axt in blinder Wut auf Dich niedersausen.\n",
           name()+" laesst die Axt in blinder Wut auf @WEN niedersausen.\n",
          ({DT_SLASH}), ([SP_SHOW_DAMAGE:1]) );

  clone_object ("/p/armour/helm/titanhelm")->move (this_object(), M_GET);
  clone_object ("/p/armour/armour/eisenpanzer")->move (this_object(), M_GET);
  clone_object ("/p/armour/gloves/titanhandschuhe")->move (this_object(), M_GET);  
  clone_object ("/p/armour/boots/kampfstiefel")->move (this_object(), M_GET);
  command_me("trage alles");

  clone_object ("/p/weapon/axe/stabaxt")->move (this_object(), M_GET);
  command_me("zuecke axt");
}

// Begruesungsroutine
void greet_player(mixed people)
{
   int i;
   string msg;
   
   // Niemand zum gruessen? Dann raus!
   if (!sizeof(people))
      return;
      
   msg = "Seid gegruesst "; 
   
   if (pointerp(people))
   for (i = 0; i < sizeof(people); i++)
   {
      if ( i == (sizeof(people) - 2) )
      {
         msg += people[i]->name()+" und ";
      }
      else 
      {
      	if ( i == (sizeof(people) - 1) )
            msg += people[i]->name()+"!\n";
        else
            msg += people[i]->name()+", ";
      }
   }
   say (break_string ( msg + "Mein Name ist "+name()+
       ", ich sorge fuer Ruhe und Ordnung in dieser Arena. "+
       "Wenn Ihr Euch zu benehmen wisst, sollten wir gut miteinander auskommen. "+
       "Andernfalls koennte es durchaus sein, dass Ihr es bitter bereuht! "+
       "Fuer genaue Informationen zur Arena oder zu den Duellen, "+
       "wendet Euch am besten an das Arenapersonal. Ich wuensche Euch einen angenehmen "+
       "und interessanten Aufenthalt!", 78, name()+" sagt: ", 1) );
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe) 
  {
    case "fies":
      if ( random (2) )
        call_out("react", 0, "sagt: Ihr spielt mit Eurem Leben, "+TPN+"!");
      else
        call_out("angriff",0);
      break;
    case "aergerlich":
      call_out("react", 0, "sagt: Haltet Euren Aerger von der Arena fern, "+TPN+"!");
      break;
    case "traurig":
      call_out("react", 0, "sagt: Ach, das wird schon wieder, "+TPN+"!");
      break;
    case "albern":
      call_out("react", 0, "laechelt gutmuetig.");
      break;
    case "neutral":
      call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEM)+" zu.");
      break;
    case "intim":
      if ( QueryProp(P_GENDER) != TP->QueryProp(P_GENDER) )
         call_out("react", 0, "flirtet mir Dir.", 
                  "flirtet mit "+TP->name(WEM)+".");
      else
         call_out("react", 0, "meint Ihr seid nicht mein Geschmack, "+TPN+".");
      break;
    case "froh":
      call_out("react", 0, "nickt Dir zu.",
             "nickt "+TP->name(WEM)+" zu.");
      break;
    case "aengstlich":
      call_out("react", 0, "meint: Angst ist dazu da ueberwunden zu werden!");
      break;
    case "frech":
      call_out("react", 0, "meint: Treibt es nicht zu weit, "+TPN+"!");
      break;
    case "nett":
      call_out("react", 0, "nickt Dir freundlich zu.", "nickt "+TP->name(WEM)+" freundlich zu.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" schreit: Das wird Euch noch leid tun!\n");
    Kill(TP);
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
