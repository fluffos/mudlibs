#include <properties.h>
#include <combat.h>

inherit "/std/armour";

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Seidenhemd");
  SetProp(P_LONG, 
    "Dieses Hemd aus feinster, bluetenweisser Seide traegt man "+
    "nur zu besonderen Anlaessen. Man sollte deshalb achtgeben "+
    "dass man es nicht beschaedigt oder beschmutzt, "+
    "denn es waere doch wirklich schade um dieses schoene Hemd, oder?");
    
  SetProp(P_NAME, "Seidenhemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd", "seidenhemdhemd"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 750);
  
  AddDetail( ({"seide"}),
    "Die Seide ist sehr weich und geschmeidig, so etwas wuerdest Du am "+
    "liebsten immer tragen.");
}

