inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine schwarze Seidenhose");
  SetProp(P_LONG, 
    "Eine schwarze Hose aus reiner Seide, wie man sie nur zu besonderen "+
    "Anlaessen traegt." );
  SetProp(P_NAME, "Seidenhose");
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "seidenhose"}) );
  AddAdjective( ({"schwarze"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_SILK:100]) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 800);
}

