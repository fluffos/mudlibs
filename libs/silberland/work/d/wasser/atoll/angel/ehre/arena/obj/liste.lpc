inherit "std/thing";

#include <properties.h>
#include <language.h>

int board, wahl;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  seteuid(getuid());
  SetProp(P_SHORT, "Eine lange Liste");
  SetProp(P_LONG,
	"Du siehst eine Liste mit Informationen zu den Arenakaempfen.");
  SetProp(P_NAME,"Liste");
  AddId("liste");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT,90000);
  SetProp(P_NOGET, "Diese Liste kannst Du nicht einfach mitgehen lassen!");
  AddCmd(({"lies","lese"}), "lies");

}

lies(str)
{
  string was;
  notify_fail("Was willst Du lesen ? Syntax: lies <etwas>.\n");
  if(!str) return 0;
  if(sscanf(str,"%s",was)!=1) return 0;
  if (!id(str)) return 0;
  say(this_player()->name() + " sieht sich eine Liste genauer an.\n", this_player());
  write("Welchen Teil der Liste moechtest Du lesen?\n");
  write("------------------------------------------\n");
  write("1 ... Das Rangsystem der Arena\n");
  write("2 ... Duelle bis zur Bewusstlosigkeit\n");
  write("3 ... Duelle der Ehre bis zur Bewusstlosigkeit\n");
  write("4 ... Duelle auf Leben und Tod\n");
  write("5 ... Duelle der Ehre auf Leben und Tod\n");
  write("0 ... Doch lieber nichts\n\n");
  write("Deine Wahl: ");
  input_to ("list_info");
  return 1;
}

list_info(string args) 
{
  wahl = to_int(args);
  switch (wahl)
  {
     case 0: return;
     case 1: this_player()->More(read_file("/d/dschungel/angel/arena/ranking/system.txt")); break;
     case 2: write("Ranking fuer das Duell bis zur Bewusstlosigkeit:\n------------------------------------------------\n"+
                   "  Nr.:  Name:           gew.:  verl.:  Punkte:  Rang:\n");
             this_player()->More(read_file("/d/dschungel/angel/arena/ranking/status_duel.txt")); break;
     case 3: write("Ranking fuer das Duell der Ehre bis zur Bewusstlosigkeit:\n---------------------------------------------------------\n"+
                   "  Nr.:  Name:           gew.:  verl.:  Punkte:  Rang:\n");
             this_player()->More(read_file("/d/dschungel/angel/arena/ranking/status_honour.txt")); break;
     case 4: write("Ranking fuer das Duell auf Leben und Tod:\n------------------------------------------\n"+
                   "  Nr.:  Name:           gew.:  verl.:  Punkte:  Rang:\n");
             this_player()->More(read_file("/d/dschungel/angel/arena/ranking/status_death.txt")); break;
     case 5: write("Ranking fuer das Duell der Ehre auf Leben und Tod:\n--------------------------------------------------\n"+
                   "  Nr.:  Name:           gew.:  verl.:  Punkte:  Rang:\n");
             this_player()->More(read_file("/d/dschungel/angel/arena/ranking/status_death_honour.txt")); break;
  }
  return;
}

