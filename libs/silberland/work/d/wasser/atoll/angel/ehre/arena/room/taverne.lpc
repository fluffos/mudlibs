#pragma strong_types

inherit "std/pub";

#include "./def.h"
#include <pub.h>

nosave object challenger, partner, pot_partner;
nosave int challenge_time;

void wood_reply()
{
   if(environment(this_player())==this_object())
   {
     write ("Tic! Toc! \nDas scheint ja wirklich echtes TicToc "+
       "Holz zu sein! Du bist tief beeindruckt.\n");
     tell_room(this_object(), BS(this_player()->name()+ 
       " scheint angestrengt an der Wand zu horchen und nickt "+
       "dann verbluefft mit dem Kopf."), ({this_player()}) );
   }
}

string tictoc()
{
   call_out("wood_reply", 3);
   return "Da Du es nicht glauben kannst bringst Du Dein Ohr nahe zur "+
     "Wand und klopfst leicht aufs Holz ...\n";
}

void seq_six()
{
  write ( BS("Dein Gewissen kommentiert: Vielleicht solltest Du zur "+
    "Abwechslung mal weniger trinken und frueher ins Bett! "+
    "Du halluzinierst ja schon!") );
}

void seq_five()
{
  call_out("seq_six", 4);
  write (BS("Du willst das ganze einfach auf Deine Einbildung "+
    "schieben und den Vorfall vergessen.\n"));
}

void seq_four()
{
  call_out("seq_five", 3);
  write ("Vorsichtig spaehst Du nochmals auf Dein Handgelenk ... "+
    "findest aber keine Uhr!\n");
}

void seq_three()
{
  call_out("seq_four", 3);
  write ("Du denkst . o O ( Moment! Hab ich denn ueberhaupt eine Uhr? )\n" );
}

void seq_two()
{
  call_out("seq_three", 3);
  write("Du denkst . o O ( Oh schon so spaet! )\n" );
}

void seq_one()
{
  call_out("seq_two", 3);
  write ("Es ist: "+dtime()+".\n");
}

string query_time()
{
  call_out ("seq_one", 2);
  return "Du blickst auf Die Armbanduhr auf Deinem Handgelenk und siehst:\n";  
}

void create()
{
  object npc;
  string frucht;
  ::create();
  
  npc = AddItem(NPC "barman", REFRESH_DESTRUCT, 1);
  
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "barman");
  SetProp(P_PUBKEEPER_NAME, npc->name());
  SetProp(P_PUBKEEPER_GENDER, npc->QueryProp(P_GENDER));
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Restaurant der Arena in Neutijara." );

  SetProp(P_INDOORS,1);
  
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) ); 

  AddDrink("Bier", "bier", 35, 8, 1, 4,
          ({ "Du trinkst Dein Bier in einem Zug aus.",
            "&& leert in einem Zug ein Bierglas." }) );
  AddDrink("Rotwein", ({"wein","rotwein"}), 120, 18, 4, 4,
          ({ "Mhhhhhhm! Dieser Wein ist etwas besonderes!",
            "&& trinkt bedaechtig ein Glas besten Rotweins." }) );
  AddDrink("Met", ({"met","honigwein"}), 280, 28, 9, 1,
          ({ "Der honigsuesse Met ist ein wahrer Hochgenuss.",
            "&& geniesst ein Glas besten Met." }) );
  frucht=({"Orangen", "Mandarinen", "Apfel", "Birnen", "Zitronen"})[random(5)];
  AddDrink(frucht+"saft", ({"saft",lower_case(frucht)+"saft"}), 90, ({18,12}), 0, 6,
          ({ "Nach dem Glas frisch gepresstem "+frucht+"saft fuehlst Du Dich "
           "angenehm erfrischt.",
            "&& sieht nach dem Glas Orangensaft sichtlich erfrischt aus." }) );
  frucht=({"Papaya", "Ananas", "Mandastromo", "Bananen", "Kokosnuss"})[random(5)];
  AddDrink(frucht+"milchshake", ({"milch","milchshake", lower_case(frucht)+"milchshake"}),
      390, 35, 0, 11,
          ({ "Du geniesst Deinen koestlichen "+frucht+"milchshake, "
             "der aus "+frucht+" und frischer Ziegenmilch zubereitet ist.",
            "&& findet den "+frucht+"milchshake offenbar koestlich." }) );

  AddFood("belegter Fladen", "fladen", 30, 7, 5,
         ({ "Du hast den mit Gemuese belegten Fladen schnell verspeist.",
            "&& ist in null komma nix mit der Fladen fertig." }) );
  AddFood("Gemueseeintopf à la chef", ({"eintopf","gemueseeintopf"}), 150, 18, 7,
         ({ "Du loeffelst den unerwartet wohlschmeckenden Eintopf.",
            "&& scheint vom Gemueseeintopf angenehm ueberascht zu sein." }) );
  AddFood("geduenstetes Sauerkraut", ({"kraut","sauerkraut"}), 290, ({25,38,3}), 12,
         ({ "Du schaufelst das Sauerkraut regelrecht in Dich rein.",
            "&& hat das Sauerkraut schnell gegessen." }) );
  AddFood("garniertes Seelachsfilet", ({"filet","lachsfilet","lachs","seelachsfilet"}), 1200, 90, 27,
         ({ "Du geniesst das koestliche Seelachsfilet in vollen Zuegen.",
            "&& verspeist das Seelachsfilet mit Genuss." }) );


  AddDetail( ({ "restaurant", "lokal", "lokale" }),
             "Dies ist eines der feinsten Lokale, die Du jemals besucht hast.\n");
  AddDetail( ({ "boden", "fussboden", "holzboden" }),
	     "Der Holzboden besteht aus wertvollem TicToc-Holz!\n" );
  AddDetail( ({ "holz", "tictoc", "tictocholz" }),
             #'tictoc );
  AddDetail( ({ "wand","waende" }),
	     "An den Waenden sind Bilder und etliche, exotisch anmutende, Waffen und Ruestungen befestigt.\n" );
  AddDetail( ({ "decke" }),
             "Wie Boden und Waende besteht auch die Decke aus TicToc Holz. In ihrer Mitte haengt ein Kristallluester, der angenehm warmes Licht im Raum verbreitet.\n" );
  AddDetail( ({ "arena","arenen" }),
             "Da gehst Du am besten wieder die Treppe nach oben.\n" );
  AddDetail( "treppe",
             "Ueber diese Treppe geht es hoch zur Eingangshalle.\n" );
  AddDetail( ({ "eingangshalle", "halle" }),
             "Och bleib doch noch ein Weilchen hier und geniesse das Leben!\n" );
  AddDetail( "leben",
             "Wer weiss wie lange Du das noch geniessen kannst.\n" );
  AddDetail( "weilchen",
             "Wenn Du nichts wirklich wichtiges zu tun hast, dann goenne Dir ein wenig Entspannung.\n" );
  AddDetail( ({ "entspannung", "ruhe" }),
             "Entspannung braucht jeder einmal, auch eine gewisse Magierin die sich hier gerade ueberarbeitet.\n" );
  AddDetail( "magierin",
             "Sie weiss genau, dass sie etwas Ruhe und Entspannung braucht, aber sie will ja nicht hoeren und unbedingt fertig arbeiten - *seufz*.\n" );
  AddDetail( "zeit",
             #'query_time );
  AddDetail( ({ "kristallluester", "luester", "kristall", "licht", "mitte" }),
             "In der Mitte der Decke haengt ein maechtiger Kristallluester. In seinen unzaehligen Kristallen bricht sich das Licht der Kerzen und erzeugt so eine angenehm warme Atmosphaere.\n" );
  AddDetail( ({ "kerzen", "atmosphaere" }),
             "Richtig romantisch! Wie schoen waer es doch einmal mit der Person die Du liebst einmal hier zu Abend zu essen!\n" );
  AddDetail( "abend",
             "Irgendwie sind die Abende immer am romantischsten, Du kannst Dir aber nicht erklaeren warum.\n" );
  AddDetail( ({ "dienst", "personen" }),
             "Es scheint so, als wuerden sich mehrere Personen den Dienst im Restaurant teilen.\n" );
  AddDetail( "gaeste",
             "Sieh Dich genauer um, vielleicht kennst Du ja jemanden.\n" );
  AddDetail( ({ "einrichtung", "samt", "angst", "reiz", "comfort", "stuehle" }),
             "Die Einrichtung sieht schrecklich teuer aus, Du hast fast Angst etwas schmutzig "+
             "zu machen, aber der Reiz Dich richtig in den flauschigen Samt der Stuehle zu kuscheln "+
             "obsiegt doch und Du geniesst fuer ein paar Minuten den seltenen Comfort.\n");
  AddDetail( "minuten",
             "Leider hast Du nicht ewig Zeit.\n" );
  AddDetail( "raum",
             "Ein exquisites Restaurant.\n" );
  AddDetail( "person",
             "Wen Du liebst, das weisst Du wahrscheinlich selbst am besten.\n" );
  AddDetail( ({ "silberbesteck", "besteck" }),
             "Echtes Silberbesteck, damit isst man bei Deinem Lebenswandel nicht alle Tage!\n");
  AddDetail( "lebenswandel",
             "Du gefaehrdest Dich viel zu oft und viel zu sehr!\n" );
  AddDetail( "tage",
             "Wie oft hast Du schon mit solchem Besteck gegessen?\n" );
  AddDetail( ({ "ruestungen", "waffen", "gegenstaende", "ausdruck" }),
             "Exotisch ist dafuer wohl der passende Ausdruck.\n");
  AddDetail( "tische",
             "Die Tische wurden fein saeuberlich und offensichtlich mit viel Liebe gedeckt.\n" );
  AddDetail( "liebe",
             "Ohne Liebe kann man nicht lange existieren.\n" );
  AddDetail( ({ "speisen", "getraenke", "appetit", "menue", "speisekarte" }),
             "Sieh Dir doch einmal das Menue an! Du findest sicher etwas worauf Du Appetit hast.\n" );
  AddDetail( "bilder",
             "Die Bilder zeigen vermutlich verschiedene Szenen aus Abenteuern.\n");
  AddDetail( ({ "szenen", "abenteuer" }),
             "Der Maler muss eine bluehende Phantasie gehabt haben, oder die hier abgebildeten Leute sind oder waren echte Helden!\n" );
  AddDetail( ({ "phantasie", "helden", "heldentum", "leute", "maler" }),
             "Egal, ob nun Phantasie oder echtes Heldentum, diese Bilder inspirieren Dich.\n");
  AddDetail( ({ "neutijara", "stadtteil", "name" }),
             "Der Name dieses Stadtteils ist Neutijara.\n" );
             
  AddSmell( DEFAULT_SMELL,
            "Angenehme Duefte liegen in der Luft.\n" );
            
  AddSmell( "duefte",
            "Das werden wohl die koestlichen Speisen sein.\n" );
            
  AddSmell( "speisen",
            "Schone Deine Nase und schau in die Speisekarte.\n" );
            
  AddSmell( "luft",
            "Hmmmmm riecht das guut! Du bekommst richtigen Appetit!\n" );
     
  AddSound( DEFAULT_SOUND,
            "Leises Gemurmel von den Nebentischen dringt an Dein Ohr.\n" );
   
  AddSound( ({ "ohr", "ohren" }),
            "Du lauscht angestrengt mit Deinen Ohren, ob Du nicht von ihnen selbst einen Laut vernimmst.\n" );
            
  AddSound( "laut",
            "Nun, was hast Du an Deinen eigenen Ohren zu hoeren erwartet?" );
            
  AddSound( ({"gemurmel", "nebentische", "nebentisch"}),
            "Leider zu undeutlich, als dass Du etwas verstehen koenntest.\n" );
            
  AddSound( "kampfplatz",
            "Da musst Du wohl noch naeher ran um mehr zu hoeren.\n" );              
  AddExit("oben",([ EX_DEST : ROOM "nordteil",
                    EX_MSG  : "die Treppe nach oben in die Eingangshalle",]) );
}

void reset()
{
  object npc;
  ::reset();
  
  npc = find_object (NPC "barman");
  if (objectp(npc))
  {
     SetProp(P_PUBKEEPER_NAME, npc->name());
     SetProp(P_PUBKEEPER_GENDER, npc->QueryProp(P_GENDER));   
  }
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
   object waiter;
   waiter = present("barman", this_object());
  
   if(objectp(waiter))
   SetProp(P_INT_LONG, "Du befindest Dich im Restaurant der Arena "+
                       "in Neutijara. Die Einrichtung in diesem Restaurant kann man ohne zu uebertreiben als nobel bezeichnen. "+
                       "Die Stuehle sind mit weichem Samt ueberzogen, die Tische sind mit Silberbesteck gedeckt und "+
                       "die Waende sind mit allerlei schmucken Gegenstaenden verziert. "+
                       "Zur Zeit hat "+waiter->name()+" Dienst und versorgt die hungrigen und durstigen Gaeste mit "+
                       "verschiedensten Speisen und Getraenken. Mit der Treppe kommt man wieder nach oben, in die Eingangshalle.\n" );
   else
   SetProp(P_INT_LONG, "Du befindest Dich im Restaurant der Arena "+
                       "in Neutijara. Die Einrichtung in diesem Restaurant kann man ohne zu uebertreiben als nobel bezeichnen. "+
                       "Die Stuehle sind mit weichem Samt ueberzogen, die Tische sind mit Silberbesteck gedeckt und "+
                       "die Waende sind mit allerlei schmucken Gegenstaenden verziert. "+
                       "Leider ist im Augenblick kein Personal anwesend, darum kannst Du auch nichts bestellen. "+
                       "Mit der Treppe kommt man wieder nach oben, in die Eingangshalle.\n" );

   return  ::int_long(viewer, viewpoint, shortflag);
}
