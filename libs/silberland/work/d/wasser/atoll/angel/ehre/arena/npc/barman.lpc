#include <language.h>
#include <ansi.h>
#include "./def.h"
#include "../../lib/unique_npc/headers/unique_npc.h"

inherit "std/npc/sequencer";
inherit NPC "arena_race_specs";
inherit LIB "unique_npc/classes/unique_npc";

create()
{
  if (is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }
    
  arena_race_specs::create();
  unique_npc::create();
  ::create(); 

  SetProp(P_UNIQUE_RACE_PROBABILITY, ({ ({"Mensch",100}), ({"Elf",30}), 
                      ({"Zwerg",30}), ({"Hobbit",30}), }) );
  SetProp(P_ARTICLE, 0); 
  create_unique_family( 45, 60, 25, 50, 0, NPC "arena_names", NPC "arena_surnames" );
  AddId(lower_case(QueryProp(P_NAME)));
  AddId(distinguish_gender("wirt", "wirtin"));
  AddId("barman");
  SetProp(P_SHORT, QueryProp(P_NAME) + 
          distinguish_gender(" der Wirt", " die Wirtin"));

  SetProp(P_LONG,  get_long("Vor Dir steht "+QueryProp(P_NAME)+
                            ", der Wirt der Taverne. ", 
                            "Vor Dir steht "+QueryProp(P_NAME)+
                            ", die Wirtin der Taverne. ") );
  set_details ("/d/dschungel/angel/lib/unique_npc/load_lib/details", 1);
  SetProp( P_ALIGN, get_between ( 100, 300 ) );
  SetProp(P_MAX_HANDS, 2);
  seteuid(getuid(this_object()));
  SetProp(P_MAX_HANDS, 2);  
  SetProp( P_DIE_MSG, " faellt unter die Theke.\n" );
  SetProp( P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Lasst gefaelligst die Wirtsleut' in Frieden!");
  SetProp(P_MURDER_MSG, "In Ordnung %s, Ihr habt mich besiegt, aber IHR "+
                        "schliesst nun das Gasthaus ab!");
  SetProp(P_DEFAULT_INFO,"sagt: Da fragt Ihr am besten einen Vertreter "+
                         "der Arenaleitung!\n");
  SetChats(2, ({
    name()+" blickt Dich erwartungsvoll an.\n",
    name()+" fragt: Werter Gast, darf ich Euch etwas bringen?\n",
    name()+" sagt: Der Seelachs ist delikat!\n",
    name()+" fragt: Ein Glaeschen feinsten Met gefaellig?\n",
    name()+" reinigt vorsichtig einige Glaeser und stellt sie auf die Theke.\n" }) );
    
  SetAttackChats(5, ({
    name()+" sagt: So lasst mich doch in Ruhe arbeiten!\n",
    name()+" sagt: Dies ist das Restaurant, nicht der Kampfplatz!\n",
    name()+" sagt: Warum hegt Ihr Groll gegen mich?\n" }) );
            
  // Spezielle Informationen, die der NPC selbst beantwortet:   
  AddInfo( "hilfe",
    "Wenn Ihr hungrig oder durstig seid, dann seid Ihr hier an der Richtigen "+
    "Stelle, werter Gast!", "sagt: " 
  );
  AddInfo("arena",
    "In dieser Arena koennt Ihr einen Gegner zum ehrenvollen "+
    "Duell herausfordern.\n", "sagt: "
  );
  AddInfo( "tribuene",
    "Mit einer Eintrittskarte duerft Ihr die Tribuene der Arena betreten. Moechtet "+
    "Ihr die Duelle genauer beobachten, so empfiehlt es sich, ein "+
    "Fernglas zu erwerben.","sagt: " 
  ); 
  AddInfo( ({"eingangshalle", "kartenabreisser" }),
    "Einfach die Treppe hoch.\n", "sagt: "
  );
  AddInfo( ({ "buero", "arenaverwaltung" }),
    "Das Buero der Arenaverwaltung befindet sich im Suedosten der Eingangshalle.\n", "sagt: " 
  ); 
  AddInfo( "restaurant",
    "Sehr Euch gerne um werter Gast! Solltet Ihr Euch dann entschliessen zu bleiben, "
    "so waehlet bitte aus unserem Menue.\n", "sagt: "
  );
  AddInfo( "menue",
    "Mit dem Befehl <menue> koennt Ihr selbiges lesen.\n", "sagt: "
  );
  
  // Spezielle Informationen, bei denen der Spieler weitergeleitet wird:
  AddInfo(({"ticket", "tickets", "eintrittskarte", "karte"}),
    "Da fragt Ihr am besten einen Kartenabreisser!\n", "sagt: "
  );
  AddInfo(({"registrierung", "registrieren", "bestaetigung", "bestaetigen"}),
    "Dazu wendet Ihr Euch am besten an die Arenaleitung oder die Arenaverwaltung.\n", 
    "sagt: "
  );
  AddInfo( ({ "fernglas", "fernglaeser" }),
    "Dazu wendet Ihr Euch am besten an die Arenaverwaltung.\n", "sagt: "
  );

  SetProp (P_SPELLRATE, 40);
  
  // Schlag der Ehre:
  AddSpell(5, 500,
           name()+" zieht Dir mit einer Weinflasche eins ueber.\n",
           name()+" zieht @WEM mit einer Weinflasche eins ueber.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
          
  // Furioses Topfwerfen:
  AddSpell(3, 800,
           name()+" wirft einen schweren Topf nach Dir.\n",
           name()+" wirft einen schweren Topf @WEM.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
  
  // Bierfass als Waffe - Aua!
  AddSpell(2, 1000,
           name()+" zerbricht ein Bierfass auf Deinem Kopf.\n",
           name()+" zerbricht ein Bierfass auf @WESSEN Kopf.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

  if (QueryProp(P_GENDER) == 1)
  {
     clone_object (ARMOUR "seidenhose")->move (this_object(), M_GET);
     clone_object (ARMOUR "seidenhemd")->move (this_object(), M_GET);
     clone_object (ARMOUR "lederschuhe_fein")->move (this_object(), M_GET);
  }
  else
  {
     clone_object (ARMOUR "seidenrock")->move (this_object(), M_GET);
     clone_object ("/p/armour/armour/bluse")->move (this_object(), M_GET);
     clone_object ("/p/armour/boots/seidenschuhe")->move (this_object(), M_GET);
  }
  
  clone_object ("/p/armour/schuerze")->move (this_object(), M_GET);
  
  command_me("trage alles");
}

void die(int poisondeath) 
{
  mixed farben;
  object orden;
  orden = present("DuellItem", QueryProp(P_KILLER)||TP);
  if (objectp(orden))
  {
     switch (TP->QueryProp(P_TTY))
     {
       case "ansi": farben=({ANSI_BG_RED+ANSI_BOLD, ANSI_NORMAL}); break;
       case "vt100": farben=({ANSI_BOLD, ANSI_NORMAL}); break;
       default: farben=({"",""}); break;
     }
     tell_object(QueryProp(P_KILLER)||TP, sprintf("\n\n%sDiese Schandtat hat Dich Deine Ehre "+
                                          "gekostet!%s\n\n\n", farben[0], farben[1]) );
     orden->remove();
  }
  ::die(poisondeath);
}

// Begruesungsroutine
void greet_player(mixed people)
{
   int i;
   string msg;
   
   // Niemand zum gruessen? Dann raus!
   if (!sizeof(people))
      return;
      
   msg = "Seid gegruesst "; 
   
   if (pointerp(people))
   for (i = 0; i < sizeof(people); i++)
   {
      if ( i == (sizeof(people) - 2) )
      {
         msg += people[i]->name()+" und ";
      }
      else 
      {
      	if ( i == (sizeof(people) - 1) )
            msg += people[i]->name()+"!\n";
        else
            msg += people[i]->name()+", ";
      }
   }
   say (break_string ( msg + "Mein Name ist "+name()+
       ", ich habe gerade Dienst in unserem feinen Restaurant. "+
       "Wie kann ich Euch weiterhelfen?", 78, name()+" sagt: ", 1) );
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "blickt Dich wuetend an.", 
               "blickt "+TP->name(WEN)+" wuetend an.");
      break;
    case "aergerlich":
      call_out("react", 0, "meint: Nehmt es nur nicht zu schwer, "+TPN+"!",0);
      break;
    case "traurig":
      call_out("react", 0, "meint: Kommt, "+TPN+", nehmt eine Erfrischung zu Euch!");
      break;
    case "albern":
      call_out("react", 0, "beginnt zu schmunzeln.",0);
      break;
    case "neutral":
      call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+" an.");
      break;
    case "intim":
      if ( QueryProp(P_GENDER) != TP->QueryProp(P_GENDER) )
         call_out("react", 0, "zwinkert Dir zu.", 
                  "zwinkert "+TP->name(WEM)+" zu.");
      else
         call_out("react", 0, "scheint sich nicht fuer Dich zu interessieren.",
                  "scheint sich nicht fuer "+TP->name(WEN)+" zu interessieren.");
      break;
    case "froh":
      call_out("react", 0, "freut sich mit Dir.",
             "freut such mit "+TP->name(WEM)+".");
      break;
    case "aengstlich":
      call_out("react", 0, "meint: Das uebersteht Ihr sicher, "+TPN+".");
      break;
    case "frech":
      call_out("react", 0, "grinst Dich schelmisch an.", 
               "grinst "+TP->name(WEN)+" schelmisch an.");
      break;
    case "nett":
      call_out("react", 0, "nickt Dir freundlich zu.", "nickt "+TP->name(WEM)+" freundlich zu.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
