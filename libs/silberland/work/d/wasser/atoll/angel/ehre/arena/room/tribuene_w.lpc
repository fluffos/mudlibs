#pragma strong_types

inherit "std/room";

#include "./def.h"

// Laesst Spieler auf den Kampfplatz schreien
int shout_battle(string args)
{
  object server;
  
  args = this_player()->_unparsed_args();
  
  catch(call_other(PKOBJ "coordinator", "???", 0));
  server = find_object(PKOBJ "coordinator");
  if (!objectp(server))
     return 0;
   
  if (stringp(args))
  {
     write ("Du bruellst: "+args+"\n");
     args = this_player()->name()+" bruellt: "+args+"\n";
     tell_room(this_object(), args, ({this_player()}) );
     server->transmit_shout(args);
  }
     
  return 1;
}

// Funktion zum Festhalten von Gegnern
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, this_object(), "freeze_in_place"}) );
}

// Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Du solltest Dich erst erheben!\n";
}


// Unterscheiden wir mal die Rassen:
string distinguish_race()
{
   switch (this_player()->QueryProp(P_RACE) )
   {
      case "Troll": return BS("Diese Baumstaemme! Das ist ja wie bei Dir daheim im Wohnzimmer! Vielleicht setzt Du Dich ja mal hin?\n");
      case "Oger": return BS("Diese Steinbloecke sehen aber auch zu einladend aus! Moechtest Du Dich nicht setzen?\n");
      default : return BS ("Diese Sitzmoeglichkeiten sagen Dir nicht wirklich zu. Schau Dich doch noch weiter um!\n");
   }
   
}

// Funktion zum Setzten:
int do_sit_down( string args )
{
  mixed res;
  
  // Pruefung ob evtl. ein MOVE_HOOK gesetzt ist.
  if (res=this_player()->QueryProp(P_TMP_MOVE_HOOK))
  {
    if ( pointerp(res) && sizeof(res) >= 3
         && intp(res[0]) && time() < res[0]
         && objectp(res[1]) && stringp(res[2]) )
       {
         // In diesem Fall sitzen wir gerade:
         if (res[1] == this_object())
         {
            notify_fail("Du sitzt doch schon!\n");
            return 0; 
         }
         else
         {
            notify_fail("Irgendwie kannst Du Dich derzeit nicht bewegen!\n");
            return 0; 
         }
       }
  }
   switch (this_player()->QueryProp(P_RACE) )
   {
      case "Troll": {
      	              write (BS("Du laesst Dich geraeuschvoll auf einem Baumstamm nieder und entspannst Dich.\n"));
      	              tell_room(this_object(), this_player()->name()+" laesst sich geraeuschvoll auf einem Baumstamm nieder.\n", ({this_player()}));
      	              paralyze (1800, this_player());
      	              return 1;
      	            }
      case "Oger": {
      	               write (BS("Du palzierst Dich auf einem der Steinbloecke und fuehlst Dich zufrieden.\n"));
      	               tell_room(this_object(), this_player()->name()+" plaziert sich zufrieden auf einem der Steinbloecke.\n", ({this_player()}));
      	               paralyze (1800, this_player());
      	               return 1;      	               
      	             }
      default : {
      	          write (BS ("Das ist Dir ganz einfach zu unbequem. Du entscheidest Dich dafuer stehen zu bleiben.\n"));
      	          return 1;
      	        }
   }
}

// Funktion zum Aufstehen:
int do_get_up( string args )
{
   string test;
   mixed res;
      
  notify_fail("Aber Du sitzt Doch noch garnicht!\n");
  // Pruefung ob evtl. ein MOVE_HOOK gesetzt ist.
  if (res=this_player()->QueryProp(P_TMP_MOVE_HOOK))
  {
    if ( pointerp(res) && sizeof(res) >= 3
         && intp(res[0]) && time() < res[0]
         && objectp(res[1]) && stringp(res[2]) )
       {
         // In diesem Fall sitzen wir gerade:
         if (res[1] == this_object())
         {
            write("Du erhebst Dich wieder von Deinem Sitzplatz.\n");
            tell_room(this_object(), this_player()->name()+" erhebt sich wieder vom Sitzplatz.\n", ({this_player()}));
            this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
            return 1; 
         }
         else 
            return 0; 
       }
  }
  return 0;
}

// Zufaellige Meldungen
string zuschauer()
{
  mixed messages;
  
  messages = ({ "Setz doch mal Deine Magie ein Du Versager!!!\n", "Jetzt streng Dich doch mal an!!!\n", "Lass Ihn leben!!! Lass Ihn leben!!!\n", "Buuuuuuh!!!\n", "Nieder mit ihm!!!\n", "Unfair!!! Dieser Schlag war REGELWIDRIG!!!\n" });
  return messages[random(sizeof(messages)-1)]; 
}

void AddNPC ()
{
  AddItem(NPC "arena_visitor", REFRESH_DESTRUCT);
}

void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Westlicher Teil der Arenatribuene in Neutijara");
  SetProp( P_INT_LONG, break_string("Du stehst auf der westlichen Tribuene der Arena. "+
           "Von hier aus kannst Du die Kaempfe, auf dem weiter unten gelegenen Kampfplatz, beobachten. "+
           "Ein komplexes Spiegelsystem ermoeglicht, dass man von jedem Ort der Tribuene aus alle Vorkommnisse auf der Kampfflaeche beobachten kann. "+
           "Damit man nicht die ganze Zeit stehen muss, gibt es, wie auch in den anderen Teilen der Tribuene, "+
           "zweckdienliche Sitzmoeglichkeiten. In hier sind es riesenhafte Steinbloecke und Baumstaemme.",78)); // Trolle & Oger

  SetProp(P_INDOORS,0);

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 31, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "teil", "abschnitt" }),
             "Dies ist der westliche Teil der Tribuene.\n" );
  AddDetail( ({ "teilen", "teils" }),
             "Dein Gewissen fluestert Dir zu: Untersuche solchen Bloetsinn "+
             "besser nicht anderswo! Die Magierin hier ist viel zu liebevoll "+
             "um Dir etwas anzutun, aber dies gilt nicht fuer einige ihrer Kollegen ...\n" );
  AddDetail( "bloetsinn",
             "Sowas untersucht man einfach nicht.\n" );
  AddDetail( "magierin",
             "Rate mal wer damit gemeint ist.\n" );
  AddDetail( ({ "kollegen", "namen" }),
             "Wir wollen keine Namen nennen.\n");
  AddDetail( ({ "angel", "bingo", "gewinner" }),
             "Bingo! Hundert Punkte fuer den Gewinner!\n");
  AddDetail( "gewissen",
             "Ja sowas hast auch Du noch.\n" );
  AddDetail( "zeit",
             "Denk mal nach, was machst Du mit Deiner Zeit?\n" );
  AddDetail( ({ "spiegel", "spiegelsystem", "system" }),
             "Eine wirklich geniale Erfindung findest Du.\n" );
  AddDetail( "vorkommnisse",
             "Von denen entgeht Dir keines!\n");
  AddDetail( "erfindung",
             "Nicht gerade von Dir, aber trotzdem gut.\n" );
  AddDetail( "ort",
             "Du findest ein solches System wirklich sinnvoll.\n");
  AddDetail( ({ "baumstaemme", "staemme", "mammutbaeume", "mammutbaum" }),
             "Wahrlich riesige Staemme von Mammutbaeumen, die hier den Trollen als Sitzgelegenheit dienen sollen.\n" );
  AddDetail( ({ "trolle", "kreaturen" }),
             "Trolle sind riesenhafte Kreaturen, sogar groesser als Oger.\n" );
  AddDetail( ({ "oger", "riesen" }),
             "Oger sind als menschenfressende Riesen verschrien.\n" );
  AddDetail( "steinbloecke",
             "Diese Steinbloecke sollen wahrscheinlich einladend auf Oger wirken.\n" );
  AddDetail( ({ "sitzgelegenheit", "sitzgelegenheiten", "sitzmoeglichkeiten", "teile" }),
             "Es scheint so als wolle man den Gaesten ihren Aufenthalt so angenehm wie moeglich machen.\n");
  AddDetail( ({ "gaeste", "beispiel" }),
             "Du zum Beispiel!\n" );
  AddDetail( "aufenthalt",
             "Sowas ist doch wirklich nett oder?\n" );
  AddDetail( ({ "boden", "fussboden", "holzboden" }),
	     "Der Boden dieses Teils der Arena besteht aus Laerchenholz.\n" );
  AddDetail( ({ "holz", "laerchenholz" }),
             "Du bist Dir dabei ziemlich sicher, da dieses Holz die typische Charakteristik von Laerchenholz besitzt.\n" );
  AddDetail( ({ "charakteristik","farbe" }),
             "Laerchenholz ist relativ dunkel und hat extrem hohe Stabilitaet.\n" );
  AddDetail( ({ "stabilitaet", "festigkeit", "abriebfestigkeit", "eigenschaften", "festigkeitseigenschaften" }),
             "Laerchenholz besitzt - und da spricht der Experte in Dir - die besten Festigkeitseigenschaften "+
             "unter den Nadelhoelzern sowie auch extrem hohe Abriebfestigkeit, was man leicht daran erkennen kann, dass der Boden beinahe keine Abnuetzungserscheinungen zeigt.\n" );
  AddDetail( "nadelhoelzer",
             "Du wirst sicher noch mehrern auf der Tribuene begegnen, wenn Du Dich etwas umsiehst.\n" );
  AddDetail( "experte",
             "Ob Du ein wirklicher Experte bist lassen wir einmal dahin gestellt.\n" );
  AddDetail( ({ "abnuetzungserscheinungen","abnuetzung", "spuren" }),
             "Du findest keine erwaehnenswerten Spuren der Abnuetzung am Boden.\n" );
  AddDetail( ({ "tribuene", "tribuenen", "innenwand", "innenwaende" }),
	     "Die Innenwaende der Tribuene bestehen in diesem Teil der Tribuene, wie der Boden, aus Laerchenholz.\n" );
  AddDetail( ({ "wand","waende" }),
             "Meinst Du die Aussenwand oder die Innenwaende?\n");
  AddDetail( "aussenwand",
             "Die Aussenwand dieses Abschnittes besteht - nimmst Du mal an - aus Eschenholz.\n" );
  AddDetail( "eschenholz",
             "Eschenholz besitzt, verglichen mit Laerchenholz schlechtere Festigkeitseigenschaften, "+
             "jedoch verglichen mit den restlichen, auf der Tribuene verwendeten Hoelzern, durchaus gute Eigenschaften.\n" );
  AddDetail( ({ "decke", "suche" }),
             "Du blickst nach oben und suchst eine Decke. Du findest zwar keine, aber beschliesst sie Dir einfach in deiner Phantasie entstehen zu lassen.\n" );
  AddDetail( ({ "himmel", "hitze" }),
             "Die gluehend heisse Sonne erzeugt ueberall sengende Hitze.\n" );
  AddDetail( "phantasie",
             "In Deiner Phantasie gibt es alle moeglichen Dinge, von denen nur Du alleine weisst.\n" );
  AddDetail( "dinge",
             "Darueber weisst Du selbst am besten Bescheid.\n" );
  AddDetail( "sonne",
             "Du fragst Dich, ob sich die Sonne da mal verausgabt und ausbrennt, wenn sie so weitermacht...\n" );
  AddDetail( ({ "arena", "arenen", "gebaeude" }),
             "Eine Arena ist ein Platz auf dem ehrenvolle Duelle ausgefochten werden.\n" );
  AddDetail( ({ "duell", "duelle","kaempfe" }),
             "Sieh einfach einigen zu, vielleicht verstehst Du sie dann besser.\n" );
  AddDetail( ({ "platz","kampfplatz", "kampfflaeche" }),
             "Die Kampfflaeche dieser Arena weist eine ovale Form auf.\n" );
  AddDetail( "form",
             "Oval kann man sich am besten als einen etwas gedruecken Kreis vorstellen.\n");
  AddDetail( ({ "kreis", "vorstellungskraft" }),
             "Dafuer reicht Deine Vorstellungskraft hoffentlich aus.\n" );

  AddSmell( DEFAULT_SMELL,
            "Hier riecht es nach frischer Luft.\n" );
            
  AddSmell( "luft",
            "Ein wenig Luft tut Dir bei dieser Hitze gut.\n" );
     
  AddSound( DEFAULT_SOUND,
            "Du kannst immer wieder Zuschauer hoeren, die etwas auf die Kampfflaeche bruellen.\n" );   

  AddSound( "zuschauer",
            #'zuschauer );   

  AddExit("suedosten", ([EX_DEST : ROOM "tribuene_sw"]) );
  AddExit("nordosten", ([EX_DEST : ROOM "tribuene_nw"]) );
  
  AddCmd ( ({"bruelle", "bruell" }), "shout_battle");
  AddCmd ( ({"setze", "setz", "sitz" }), "do_sit_down");
  AddCmd ( "erhebe", "do_get_up");
 
  call_out ("AddNPC", 0);
}
