inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein feines Paar Lederschuhe");
  SetProp(P_LONG,
    "Ein feines, schwarzes Paar Lederschuhe, die sich auch "+
    "hervorragend zum Tanzen eignen.");
  SetProp(P_NAME, "Lederschuhe");
  SetProp(P_NAME_ADJ, "fein", "schwarz");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId(({"schuhe", "lederschuhe"}));
  AddAdjective( ({"feine", "schwarze"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 450);
  SetProp(P_VALUE, 350);
}
