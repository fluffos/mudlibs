#include <language.h>
#include <ansi.h>
#include "./def.h"
#include "../../lib/unique_npc/headers/unique_npc.h"

inherit "std/npc/sequencer";
inherit NPC "arena_race_specs";
inherit LIB "unique_npc/classes/unique_npc";

create()
{

  if (is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }
    
  arena_race_specs::create();
  unique_npc::create();
  ::create();

  SetProp(P_UNIQUE_RACE_PROBABILITY, ({ ({"Mensch",100}), ({"Elf",30}), 
                      ({"Zwerg",30}), ({"Hobbit",30}), }) );
  SetProp(P_ARTICLE, 0);
  create_unique_family( 50, 60, 20, 50, 0, NPC "arena_names", NPC "arena_surnames" );
  AddId(lower_case(QueryProp(P_NAME)));
  AddId(distinguish_gender("abreisser", "abreisserin"));
  SetProp(P_SHORT, QueryProp(P_NAME) + 
  distinguish_gender(" der Kartenabreisser", " die Kartenabreisserin"));
  SetProp(P_LONG,  get_long("Vor Dir steht "+QueryProp(P_NAME)+
                            ", der Kartenabreisser der Arena. ",
                            "Vor Dir steht "+QueryProp(P_NAME)+
                            ", die Kartenabreisserinn der Arena. ") );

  set_details ("/d/dschungel/angel/lib/unique_npc/load_lib/details", 1);
  SetProp(P_ALIGN, get_between(100, 300) );
  SetProp(P_MAX_HANDS, 2);
  seteuid(getuid(this_object()));
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_DIE_MSG, " verschwindet in einem Berg Eintrittskarten.\n" );
  SetProp( P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Eine Eintrittskarte waere billiger gewesen ...");
  SetProp(P_MURDER_MSG, "Wartet es nur ab %s, ein weiteres Mal gewinnt Ihr nicht!");
  SetProp(P_DEFAULT_INFO,"sagt: Da fragt Ihr am besten einen Vertreter "+
                         "der Arenaleitung!\n");
  SetChats(2, ({
    name()+" nickt Dir zu.\n",
    name()+" fragt: Wollt Ihr den Kaempfen in der Arena beiwohnen?\n",
    name()+" sagt: Mit einer Eintrittskarte duerft Ihr auf die Tribuene.\n",
    name()+" fragt: Habt Ihr schon selbst ein Duell ausgefochten?\n",
    name()+" zaehlt die Eintrittskarten durch.\n" }) );
    
  SetAttackChats(5, ({
    name()+" sagt: Gebt lieber auf ihr habt keine Chance!\n",
    name()+" sagt: Ich werde Euch Manieren beibringen!\n",
    name()+" sagt: Tobt Euch doch in der Arena aus!\n" }) );
                     
  // Spezielle Informationen, die der NPC selbst beantwortet:                         
  AddInfo( "hilfe",
    "Wenn Ihr die Tribuene betreten wollt, braucht Ihr nur eine Eintrittskarte "
    "im Buero der Arenaverwaltung zu kaufen. Ich werde sie Euch abnehmen, sobald "
    "Ihr die Tribuene betreten moechtet, somit ist ausgeschlossen, dass Ihr "
    "es Euch doch noch einmal anders ueberlegt, nachdem Ihr mir das Ticket gegeben "
    "habt.", "sagt: " 
  );
  AddInfo("arena",
    "In dieser Arena koennt Ihr einen Gegner zum ehrenvollen "+
    "Duell herausfordern.\n", "sagt: "
  );
  AddInfo( "ehre",
    "Da fragt Ihr am besten einen Vertreter der Arenaleitung!\n", "sagt: "
  );
  AddInfo( "tribuene",
    "Mit einer Eintrittskarte duerft Ihr die Tribuene der Arena betreten. Moechtet "+
    "Ihr die Duelle genauer beobachten, so empfiehlt es sich, ein "+
    "Fernglas zu erwerben.","sagt: " 
  ); 
  AddInfo(({"registrierung", "registrieren", "bestaetigung", "bestaetigen"}),
    "Dazu wendet Ihr Euch am besten an die Arenaleitung oder die Arenaverwaltung.\n", 
    "sagt: "
  );
  AddInfo( ({ "fernglas", "fernglaeser" }),
    "Dazu wendet Ihr Euch am besten an die Arenaverwaltung.\n", "sagt: "
  );
  AddInfo(({"ticket", "tickets", "eintrittskarte", "karte", "zugang"}),
    "Mit einer Eintrittskarte, duerft Ihr auf die Tribuene. Kaufen kann man sie im "+
    "Buero der Arenaverwaltung.\n", "sagt: " 
  );
  AddInfo( ({ "buero", "arenaverwaltung" }),
    "Das Buero der Arenaverwaltung befindet sich im Suedwesten der Eingangshalle.\n", "sagt: "
  );
  AddInfo( "eingangshalle",
    "Die erstreckt sich von hier nach Sueden.\n", "sagt: "
  );
  
  SetProp (P_SPELLRATE, 30);
  
  // Fester Tritt!
  AddSpell(6, 350,
           name()+" tritt mit aller Kraft nach Dir.\n",
           name()+" tritt mit aller Kraft nach @WEM.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
          
  // Ellbogen!
  AddSpell(3, 600,
           name()+" rammt Dir seinen Ellbogen in die Magengrube.\n",
           name()+" rammt @WEM seinen Ellbogen in die Magengrube.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
  
  // Und die Treppe ... Aua!
  AddSpell(1, 1000,
           name()+" wirft Dich auf die Treppe und springt Dir ins Kreuz.\n",
           name()+" wirft @WEN auf die Treppe und springt @WEM ins Kreuz.\n",
          ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

  if (QueryProp(P_GENDER) == 1)
  {
     clone_object (ARMOUR "seidenhose")->move (this_object(), M_GET);
     clone_object (ARMOUR "seidenhemd")->move (this_object(), M_GET);
     clone_object (ARMOUR "lederschuhe_fein")->move (this_object(), M_GET);
  }
  else
  {
     clone_object (ARMOUR "seidenrock")->move (this_object(), M_GET);
     clone_object ("/p/armour/armour/bluse")->move (this_object(), M_GET);
     clone_object ("/p/armour/boots/seidenschuhe")->move (this_object(), M_GET);
  }
  // Mit dem Orden der Bewaehrung kann man diesen NPC NICHT herausfordern! 
  // (Der Orden ist also 100%ige Zierde)
  // Sobald der Orden der Ehre fuer Spieler zugaenglich ist, kann man 
  // den Orden hier auch gegen einen Orden der Ehre austauschen.
  clone_object (LIB_DUELL "obj/orden_bew");
  command_me("trage alles");
}

void die(int poisondeath) 
{
  mixed farben;
  object orden;
  orden = present("DuellItem", QueryProp(P_KILLER)||TP);
  if (objectp(orden))
  {
     switch (TP->QueryProp(P_TTY))
     {
       case "ansi": farben=({ANSI_BG_RED+ANSI_BOLD, ANSI_NORMAL}); break;
       case "vt100": farben=({ANSI_BOLD, ANSI_NORMAL}); break;
       default: farben=({"",""}); break;
     }
     tell_object(QueryProp(P_KILLER)||TP, sprintf("\n\n%sDiese Schandtat hat Dich Deine Ehre "+
                                          "gekostet!%s\n\n\n", farben[0], farben[1]) );
     orden->remove();
  }
  ::die(poisondeath);
}

// Begruesungsroutine
void greet_player(mixed people)
{
   int i;
   string msg;
   
   // Niemand zum gruessen? Dann raus!
   if (!sizeof(people))
      return;
      
   msg = "Seid gegruesst "; 
   
   if (pointerp(people))
   for (i = 0; i < sizeof(people); i++)
   {
      if ( i == (sizeof(people) - 2) )
      {
         msg += people[i]->name()+" und ";
      }
      else 
      {
      	if ( i == (sizeof(people) - 1) )
            msg += people[i]->name()+"!\n";
        else
            msg += people[i]->name()+", ";
      }
   }
   say (break_string ( msg + "Mein Name ist "+name()+
       ", ich bin fuer den Zugang zur Tribuene zustaendig. "+
       "Wie kann ich Euch weiterhelfen?", 78, name()+" sagt: ", 1) );
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "sagt: Treibt es nicht zu weit!");
      break;
    case "aergerlich":
      call_out("react", 0, "fragt: Welche Laus ist Euch denn ueber die "+
               "Leber gelaufen, "+TPN+"?",0);
      break;
    case "traurig":
      call_out("react", 0, "umarmt Dich troestend.", 
               "umarmt "+TP->name(WEN)+" troestend.");
      break;
    case "albern":
      call_out("react", 0, "kichert albern.",0);
      break;
    case "neutral":
      call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+" an.");
      break;
    case "intim":
      if ( QueryProp(P_GENDER) != TP->QueryProp(P_GENDER) )
         call_out("react", 0, "kuesst Dich zaertlich.", 
                  "kuesst "+TP->name(WEN)+" zaertlich.");
      else
         call_out("react", 0, "umarmt Dich freundschaftlich.", 
                  "umarmt "+TP->name(WEN)+" freundschaftlich.");
      break;
    case "froh":
      call_out("react", 0, "freut sich mit Dir.",
               "freut such mit "+TP->name(WEM)+".");
      break;
    case "aengstlich":
      call_out("react", 0, "baut Dein Selbstbewusstsein mit ermutigenden Worten auf.",
               "baut "+TP->name(WESSEN)+" Selbstbewusstsein mit ermutigenden Worten auf.");
      break;
    case "frech":
      call_out("react", 0, "schneidet Dir eine Grimasse und lacht.", 
               "schneidet "+TP->name(WEM)+" eine Grimasse und lacht.");
      break;
    case "nett":
      call_out("react", 0, "nickt Dir freundlich zu.", "nickt "+TP->name(WEM)+" freundlich zu.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
