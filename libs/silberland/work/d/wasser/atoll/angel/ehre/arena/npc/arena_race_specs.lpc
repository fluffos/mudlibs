void fairy_specs ()
{
  mixed hands;
  // Groesse und Gewicht stellen wir mit einer zufaelligen Abweichung von
  // +/- 20 % vom Durchschnitt fest:

  SetProp(P_UNIQUE_AVERAGE_SIZE, 65);
  SetProp(P_SIZE, get_variation(QueryProp(P_UNIQUE_AVERAGE_SIZE), 20));
  SetProp(P_UNIQUE_AVERAGE_WEIGHT, 20000);
  SetProp(P_WEIGHT, get_variation(QueryProp(P_UNIQUE_AVERAGE_WEIGHT), 20));

  SetProp(P_UNIQUE_RACE_DECLINATIONS, ({ ({}), ({"Fee","Fee","Fee","Fee"}) }) );
  
  SetProp(P_UNIQUE_SURNAME_POLICY, 0);
  SetProp(P_MAX_FOOD, 70);
  SetProp(P_MAX_DRINK, 70);
  SetProp(P_MAX_ALCOHOL, 70);
  SetProp(P_FOOD_DELAY, 8);
  SetProp(P_DRINK_DELAY, 8);
  SetProp(P_ALCOHOL_DELAY, 3);
  SetProp(P_MSGOUT,"flattert");
  SetProp(P_MMSGIN,"erscheint ploetzlich");
  SetProp(P_MMSGOUT,"ist ploetzlich verschwunden");
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_AIR   : -0.3,
         DT_MAGIC : -0.2,
         DT_HOLY  : -0.4,
         DT_UNHOLY:  0.5,
         DT_TERROR:  0.5 ]) );
         
  hands  = QueryProp(P_HANDS);
  hands[0] = " mit Feenmagie";
  SetProp(P_HANDS, hands );
}

