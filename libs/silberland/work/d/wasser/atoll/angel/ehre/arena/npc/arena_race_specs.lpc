void default_specs ()
{
  // Groesse und Gewicht stellen wir mit einer zufaelligen Abweichung von
  // +/- 20 % vom Durchschnitt fest:

  SetProp(P_UNIQUE_AVERAGE_SIZE, 175);
  SetProp(P_SIZE, get_variation(QueryProp(P_UNIQUE_AVERAGE_SIZE), 20));
  SetProp(P_UNIQUE_AVERAGE_WEIGHT, 75000);
  SetProp(P_WEIGHT, get_variation(QueryProp(P_UNIQUE_AVERAGE_WEIGHT), 20));

  SetProp(P_UNIQUE_RACE_DECLINATIONS, ({ ({"Wesen","Wesens","Wesen","Wesen"}),
                                         ({"Wesen","Wesens","Wesen","Wesen"}) }) );
  SetProp(P_UNIQUE_SURNAME_POLICY, 0);
  SetProp(P_MAX_FOOD, 100);
  SetProp(P_MAX_DRINK, 100);
  SetProp(P_MAX_ALCOHOL, 100);
  SetProp(P_FOOD_DELAY, 10);
  SetProp(P_DRINK_DELAY, 10);
  SetProp(P_ALCOHOL_DELAY, 4);
}


// Wir setzen hier mal die Werte fuer unsere NPC-Rassen.
// Es koennen ohne weiters neue Rassenspecs hinzugefuegt werden.
void set_race_specs(string race)
{
   switch (race)
   {
     case "Zwerg"     : dwarf_specs();  return;
     case "Elf"       : elf_specs();    return;
     case "Mensch"    : human_specs();  return;
     case "Hobbit"    : hobbit_specs(); return;
     case "Fee"       : fairy_specs();  return;
     default : default_specs(); return; 
   }     
}

