             "Ein einfacher Ausschnitt in der Wand dient als Fenster, welches man bei Bedarf mit Jalousien etwas verdunkeln kann.\n" );
  AddDetail( "jalousien",
             "Damit verdunkelt man einen Raum.\n" );
  AddDetail( "licht",
             "Das Fenster laesst genuegend Licht zum Arbeiten herein.\n" );
  AddDetail( ({ "arbeit", "arbeiten" }),
             "Die Beamten der Arenaverwaltung arbeiten hier.\n" );
  AddDetail( ({ "buero", "raum" }),
             "Ein gepflegtes und ordentliches Buero.\n" );
  AddDetail( "dschungel",
             "Tijara ist eine Stadt im Dschungel.\n" );
  AddDetail( "bedarf",
             "Du denkst es ist jetzt nicht noetig den Raum zu verdunkeln.\n" );
  AddDetail( ({ "schreibtisch", "tisch", "arbeitsplatz" }),
