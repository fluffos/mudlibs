#pragma strong_types

inherit "std/laden";

#include <properties.h>
#include "./def.h"
#include <moving.h>
#include <laden.h>
#include "/sys/new_skills.h"
#include LIB_DUELL "headers/duell.h"

nosave object challenger, partner, pot_partner;
nosave int challenge_time;

// Prueft ob ein Item eine illegale ID hat:
int verify_item (object ob)
{
   int i;
   for (i = 0; i <  sizeof( P_ILLEGAL_ITEMS ); i++)
       if ( ob->id( P_ILLEGAL_ITEMS[i] ) )
          return 1;
}

int enter_cabin(string dir)
{
  return this_player()->move(ROOM "item_storage:"+getuid(this_player()), M_GO, 0,
                    "betritt die Kabine", "verlaesst die Kabine");
}

void create()
{
  object npc;
  
  ::create();
  
  npc = AddItem(NPC "vendor", REFRESH_DESTRUCT, 1);
  
  // Laden-Konstanten:
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "vendor");
  SetProp(P_SHOPKEEPER_NAME, npc->QueryProp(P_NAME));
  SetProp(P_SHOPKEEPER_GENDER, npc->QueryProp(P_GENDER));
  catch(call_other(ROOM "arena_store", "???"));
  SetStorageRoom(ROOM "arena_store");


  AddFixedObject(OBJ "spyglass");
  AddFixedObject(OBJ "eintritt");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Im Buero der Arena in Neutijara." );

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_TOWN]) );
