inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "def.h"

inherit "/d/dschungel/angel/lib/generic/classes/algorithms.lpc";

int board, choice;
mixed teilnehmer;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  seteuid(getuid());
  SetProp(P_SHORT, "Eine riesiges Turnierbrett");
  SetProp(P_LONG,
	"Auf diesem Turnierbrett sind alle Informationen ueber kommende Turniere zu lesen.");
  SetProp(P_NAME,"Turnierbrett");
  AddId(({"brett", "turnierbrett"}));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT,90000);
  SetProp(P_NOGET, "Diess Brett ist groesser als Du selbst!");
  AddCmd(({"lies","lese"}), "lies");
  AddCmd("anmeldung", "sign_on");

}

lies(str)
{
  string was;
  notify_fail("Was willst Du lesen ? Syntax: lies <etwas>.\n");
  if(!str) return 0;
  if(sscanf(str,"%s",was)!=1) return 0;
  if (!id(str)) return 0;
  say(this_player()->name() + " sieht sich das Turnierbrett genauer an.\n", this_player());
  this_player()->More(read_file("/d/dschungel/angel/arena/ranking/turnier_brett.txt"));
  board = -1;
  input_to("tafel_action");
  return 1;
}

void choose_mode (string args)
{
  string filename;	
  choice = to_int(args);
  switch (choice)
  {
     case 0: return;
     case 1: filename = "/d/dschungel/angel/arena/ranking/anmeldung.txt"; break;
     case 2: filename = "/d/dschungel/angel/arena/ranking/anmeldung_ehre.txt"; break;
     case 3: filename = "/d/dschungel/angel/arena/ranking/anmeldung_tod.txt"; break;
     case 4: filename = "/d/dschungel/angel/arena/ranking/anmeldung_tod_ehre.txt"; break;
  }   
  teilnehmer = explode (read_file(filename), "\r\n");
  
  if(IS_LEARNER(this_player()))
  {
     write("Dieses Turnier ist nur fuer Spieler!!!\n");
     return;
  }
  
  if (is_element(teilnehmer, capitalize(getuid(this_player()))))
  {
     write("Du bist doch bereits angemeldet!\n");
     return;
  }
  else 
  {
     if (this_player()->QueryMoney() < 30000)
     {
        write("Du hast nicht genug Geld erreichbar! Moeglicherweise hast Du es in einem Beutel.\n");
        return;
     }
     else
     {
     	this_player()->AddMoney(-30000);
        write_file ( filename, capitalize(getuid(this_player()))+"\r\n" );
        write("Du bezahlst die Gebuehr und bist nun zum Turnier angemeldet!\n");
     }
  } 
}

void sign_on()
{
   write("\nFuer welche Disziplin moechtest Du Dich anmelden?\n");
   write("-------------------------------------------------\n");
   write("1 ... zur Disziplin \"Bis zur Bewusstlosigkeit\"\n");
   write("2 ... zur Disziplin \"Der Ehre\"\n");
   write("3 ... zur Disziplin \"Auf Leben und Tod\"\n");
   write("4 ... zur Disziplin \"Der Ehre Auf Leben und Tod\"\n");
   write("0 ... doch lieber nicht anmelden\n\n");
   write("-------------------------------------------------\n");
   write("Diese Anmeldung kostet Dich 30.000 Muenzen!\n");
   write("-------------------------------------------------\n");
   write("Deine Wahl: ");
   input_to("choose_mode");
}

void menu (string liste)
{
   if(board != 1)
   {
      write("Folgende Spieler habe sich fuer diese Disziplin angemeldet:\n");
      write("-----------------------------------------------------------\n");
      this_player()->More(liste);
   }
   else
   {
      write("Die Arenaleitung verlautbart:\n");
      write("-----------------------------\n\n");
      this_player()->More(liste);
      write("Moegen die Besseren gewinnen!\n");
   }
   
}

tafel_action(string args) 
{
  int wahl;
  wahl = to_int(args);
  board = wahl;
  switch (wahl)
  {
     case 0: return;
     case 1: menu(read_file("/d/dschungel/angel/arena/ranking/turnier.txt")); break;
     case 2: menu(read_file("/d/dschungel/angel/arena/ranking/anmeldung.txt")); break;
     case 3: menu(read_file("/d/dschungel/angel/arena/ranking/anmeldung_ehre.txt")); break;
     case 4: menu(read_file("/d/dschungel/angel/arena/ranking/anmeldung_tod.txt")); break;
     case 5: menu(read_file("/d/dschungel/angel/arena/ranking/anmeldung_tod_ehre.txt")); break;
     case 6: sign_on(); break;
  }

  return;
}

