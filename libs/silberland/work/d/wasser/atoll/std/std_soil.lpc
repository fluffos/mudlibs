/*
Diese Klasse steuert den Lebensrythmus, sowie den Lebenszyklus von Pflanzen
kollektiv fuer alle zugaenglichen Pflanzen im Raum als unsichtbares Master
Objekt. Die Pflanze wird nun nicht jeden Reset gecloned und steht zur Ernte
verfuegbar, sondern muss sich ueber laengere Zeit entwickeln und durchlaeuft
dabei verschiedenste Stadien wie z.B. Setzlingsstaduim oder Bluehtezeit.
Jede Pflanze hat dem Terrain gemaess gewisse Entwicklungschancen. Die Ver-
breitung erfolgt durch Tiere, Wind, Menschen usw. die Samen muessen also
auf geeignete Weise ausgebracht werden, damit sich wieder neue Pflanzen ent-
wickeln koennen. Je nach dem wann man die Pflanze erntet erhaelt der Spieler
dann einen clone dessen was er geerntet hat, reisst er z.B. den Rosenstock
komplett ab, so wird ein passendes Exemplar fuer ihn gecloned und die Steu-
erung fuer den Stock aus dem Master entfernt. Manche Pflanzen reagieren
sensibel auf das ausreissen wie z.B. unser Rosenstock, andere Pflanzen
stoehrt das wenig, und sie werden nach gegebener Zeit einfach wieder nach-
wachsen.

Auf unserem Boden koennen grundsaetzlich alle Pflanzen und Pilze, welche
std_plant geerbt haben wachsen - nach ihren in der jeweiligen Pflanze fest-
gelegten Richtlinien.

Dieses Master Object sollte von jedem Raum in dem sich Pflanzen entwickeln
sollen via AddItem hinzugefuegt werden.
*/

inherit I_THING;

// INCLUDES
#include <properties.h>
#include "/d/wolfen/sys/std_soil.h"

// GLOBALS
mixed   plants;
mapping statistics;


// Reset is the core-part of the life_cyle:
void reset()
{
   ::reset();
}

string long ()
{
  return plant_info();
}

void create()
{
  ::create();

  SetProp(P_SHORT, "");
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Boden");
  SetProp(P_NOGET, "Soetwas ist hier nicht!\n");
  plants = ({}); // ({ ({ BP, life_periode, resets left (downto 0), harvest_status }) })
  statistics = ([ TREE: 0,
                  BUSH: 0,
                  WHEED: 0,
                  FLOWER: 0,
                  HERB: 0,
                  MUSHROOM: 0,
                  MOSS: 0,
                  ALGA: 0 ]);

  AddDetail ( "pflanze", "Welche Pflanze moechtest Du Dir ansehen?" );

  AddId ( "pflanzen" );

}

string plant_info ()
{
   if (!sizeof(plants))
      return ("Du kannst hier keine Pflanzen entdecken.\n");
}

object get_bp ( string path )
{
   object ob;

   if ( !stringp (path) )
      return 0;

   call_other ( path, "???", 0);

   ob = find_object (path);

   return ob;
}

varargs int add_plant ( string bp, int lp )
{
   ob p_bp;  // plant blue-print

   p_bp = get_bp (bp);

   // Check ob es die Pflanze auch wirklich gibt:
   if ( !objectp (p_bp) )
      return 0;

   plants += ({ ({ bp, lp, p_bp->QueryProp(P_PLANT_LIFECYCLE)[bp, 1], 0 }) });
   return 1;
}
