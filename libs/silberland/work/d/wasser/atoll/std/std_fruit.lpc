inherit "std/food.lpc";

// INCLUDES
#include "../sys/oekosystem.h"

// Globals
mapping herbalists;  // Array der Spieler fuer die die Pflanze bekannt ist ([ "name": zeit, erfolg ])


void create()
{
  ::create();

  herbalists = ([]);

  SetProp (P_SHORT, "Eine gewoehnliche Frucht");
  SetProp (P_UNIDENTIFIED_SHORT, "Eine unbekannte Frucht");
  SetProp (P_LONG, "Du siehst eine Frucht");
  SetProp (P_UNIDENTIFIED_LONG, "Du siehst eine unbekannte Frucht");
  SetProp (P_NAME, "Frucht");
  SetProp (P_UNIDENTIFIED_NAME, "Frucht" );
  SetProp (P_PLURAL, "Fruechte");
  SetProp (P_UNIDENTIFIED_PLURAL, "Fruechte");
  SetProp (P_ADJECTIVES, ({ "gewoehnlich" }) );
  SetProp (P_UNIDENTIFIED_NAME_ADJ, ({ "unbekannt" }) );
  SetProp (P_ARTICLE, 1);
  SetProp (P_UNIDENTIFIED_ARTICLE, 1);
  SetProp (P_GENDER, FEMALE);
  SetProp (P_UNIDENTIFIED_GENDER, FEMALE);
  SetProp (P_ID_SKILL, "pflanzenkunde");
  SetProp (P_LORE_DIFFICULTY, 0);
}

string short ()
{
   string sh;

   // Wird die Funktion von einem Nichtspieler-Objekt benoetigt
   // gib das identifizierte short zurueck:
   if ( !objectp(this_player()) )
	  if (stringp(sh=funcall(QueryProp( P_SHORT ))) && sh!="")
         return break_string(sh+".",78,0,1);
      else
         return 0;

   if ( member (herbalists, this_player()->query_real_name()) && herbalists[this_player()->query_real_name(), 1] )
   {
	  if (stringp(sh=funcall(QueryProp( P_SHORT ))) && sh!="")
         return break_string(sh+".",78,0,1);
   }
   else
   {
	  if (stringp(sh=funcall(QueryProp(P_UNIDENTIFIED_SHORT))) && sh!="")
         return break_string(sh+".",78,0,1);
   }
}

varargs string name(int casus, int demon)
{
   string result;

   if ( QueryProp(P_ARTICLE) )
      result = QueryArticle(casus, demon) + QueryProp(P_UNIDENTIFIED_NAME);
   else
      result = QueryProp(P_UNIDENTIFIED_NAME);
      
   if ( !stringp (result) )
      return "irgendwas";
   else
      return result;
}

string long ()
{
   if ( herbalists[this_player()->query_real_name()] < time() )
   {
	  if (this_player()->TestTalent ( QueryProp(P_ID_SKILL), negate(QueryProp(P_LORE_DIFFICULTY)) ) <= 0)
	     herbalists += ([ this_player()->query_real_name(): time() + 3600; 0]);
	  else
	     herbalists += ([ this_player()->query_real_name(): time() + 3600; 1]);
   }

   if ( member (herbalists, this_player()->query_real_name()) && herbalists[this_player()->query_real_name(), 1] )
   {
      return QueryProp(P_LONG)[0..<2] + ".\n";
   }
   else
   {
      return QueryProp(P_UNIDENTIFIED_LONG) + ".\n";
   }
}

void set_herbalists ( mapping m )
{
   herbalists = m;
}

mapping get_herbalists ()
{
   return herbalists;
}