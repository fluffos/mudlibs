inherit "/std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <sequencer.h>
#include <combat.h>

// Defines:
#define TO this_object()
#define TP this_player()
#define P_TAMING_LEVEL "taming level"
#define P_IS_RIDEABLE "is ridable"
#define P_IS_TAMEABLE "is tameable"
#define P_RIDING_DIFFICULTY "riding difficulty"


// Globals:
int     loyality;  // Wie loyal ist unser Tierchen seinem Meister gegenueber?
mapping owners;    // Wem gehoert das Tier?


int test_loyality ();


void reset ()
{
  ::reset();
  
}

int follow ( object who )
{
   if ( !pointerp( who->QueryProp(P_PURSUERS)) ||  member ( who->QueryProp(P_PURSUERS), TO ) == -1 )
   {   
      who->AddPursuer( TO );
      SetProp(P_MSGOUT, "trottet "+who->name(WEM)+" nach");
      return 1;
   }
   return 0;
}

int stop_following ( object who )
{
   if ( member ( who->QueryProp(P_PURSUERS), TO ) != -1 )
   {
      who->RemovePursuer( TO );
      return 1;
   }
   return 0;
}


create()
{
  if (!is_clone(this_object())) return;
  ::create();    

  SetProp(P_SHORT, "Ein Reittier");
  SetProp(P_LONG, "Ein gewoehnliches Reittier, welches man mit etwas Uebung sicher reiten koennte.");

  SetProp(P_NAME, "Reittier");
  SetProp(P_PLURAL,"Reittiere");
  SetProp(P_ARTICLE,1);
  SetProp(P_GENDER, MALE);
  AddId( "reittier" );
  SetProp(P_SIZE,140);
  SetProp(P_WEIGHT,90000);
  SetProp(P_EYECOLOR,"schwarz");
  SetProp(P_HAIRCOLOR,"dunkelgrau");
  SetProp(P_RACE, "Reittier");
  SetProp(P_HP, QueryProp(P_MAX_HP) );
  SetProp(P_MSGIN,"trottet herein");
  SetProp(P_REJECT,({REJECT_DROP,"Das Reittier will nicht noch mehr tragen.\n"}));
  SetProp(P_TAMING_LEVEL, 1);
  SetProp(P_RIDING_DIFFICULTY, 0);
  

  AddInfo(DEFAULT_INFO, ":schaut $Den(@@Wer@@) schief an und schnaubt.");
  
  AddCmd ( ({"fuehre|fuehr&reittier"}), "" );
  AddCmd ( ({"steige|steig&auf&reittier", "besteige&reittier"}), "");
  AddCmd ( ({"mache"}), "friend");
}

int test_loyality ( object player )
{
   if ( !member ( owners, player->query_real_name() ) )
   
}

int PreventFollow(object dest)
{
   if ( TO->IsUnconscious() )
      return 1;
      
   if ( strstr (file_name (dest), "/d/") == -1 && strstr (file_name (dest), "+") == -1)
   {
      return 1;
   }
}

int remove ()
{
  say(capitalize(TO->name())+" reisst sich los und gallopiert davon.\n");
  return ::remove();
}