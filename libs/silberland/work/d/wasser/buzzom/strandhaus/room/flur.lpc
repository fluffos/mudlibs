//by buzzom and eldar
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include <wizlevels.h>
#include "../def.h"

int i;

create()
{

  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "In einem Empfangssaal" );
  SetProp( P_INT_LONG,
   "Du stehst in dem kleinem Empfangssaal des Strandhauses. Es ist schoen hell "
   "und warm hier. In der Mitte des Raumes befindet sich ein kleiner Brunnen. "
   "Ueber Dir ist eine schoene Kuppel angebracht, durch die angenehm warmesLicht "
   "in die Wohnung stroemt. Auf dem Boden stehen einige Pflanzen, von denen sich "
   "wohliger Geruch in dem Strandhaus verbreitet. Von hier aus kannst Du in die "
   "verschiedenen Raeume gelangen. Allerdings kannst Du auch einfach hier "
   "verweilen und Deine Seele baumeln lassen. "
   "Dir gegenueber, am anderen Ende des Saales, fuehrt eine Treppe nach oben. "
   );
   
   SetProp(P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]));


  AddSmell(DEFAULT_SMELL,
   "Es duftet angenehm frisch nach Blumen und Fruechten.\n"
   );
  AddSmell( ({ "geruch" }),
   "Mmmmh ... riecht das lecker hier. Du riechst einige Fruechte und Blumen.\n"
   );
  AddDetail( ({ "saal", "empfangssaal", "haus", "strandhaus", "raum", 
"wohnung" }),
   "Du befindest Dich gerade in ihm.\n" 
   );
  AddDetail( ({ "mitte" }),
   "Genau die Mitte.\n" 
   );
  AddDetail( ({ "brunnen" }),
   "Der Brunnen schmueckt das Haus ein wenig und gibt ihm einen mediteranen Flair. "
   );
  AddDetail( ({ "flair" }),
   "Ohne den Brunnen waere es nur halb so schoen hier. " 
   );
  AddDetail( ({ "licht" }),
   "Durch die Kuppel kommt viel Licht herein. " 
   );
  AddDetail( ({ "raeume" }),
   "Schau sie Dir doch mal genauer an. Vielleicht findest Du ja etwas Wichtiges."
   );
  AddDetail( ({ "wichtiges" }),
   "Ein Portal zum Beispiel... " 
   );
  AddDetail( ({ "wichtges" }),
   "Naja, hier kann so allerhand versteckt sein... " 
   );
  AddDetail( ({ "seele" }),
   "Deine Seele macht Deine Persoenlichkeit aus. Hier kannst Du ihr etwas Ruhe goennen."
   );
  AddDetail( ({ "ruhe" }),
   "Ruhe kannst Du hier sicher finden. " 
   );
   AddDetail( ({ "ende" }),
   "Da drueben, auf der anderen Seite des Saales. " 
   );
   AddDetail( ({ "magie" }),
   "Hast Du noch nie etwas von Magie gehoert? " 
   );
   AddDetail( ({ "himmel" }),
   "Nur schwach kannst Du den Himmel durch die Kuppel erkennen. " 
   );
  AddDetail( ({ "wand", "waende" }),
   "Die Waende sind aus Bambusholz gefertigt. In die westliche Wand ist "
   "eine alte Tuer eingelassen. " 
   );
   AddDetail( ({ "bambusholz", "holz" }),
   "Poliertes Bambusholz ergeben die Waende des Hauses. " 
   );
  AddDetail( ({ "kuppel" }),
   "Die Kuppel ist zwar durchsichtig, aber dennoch scheint sie nicht aus Glas "
   "zu bestehen. Sie scheint eher durch eine Art Magie enstanden zu sein und diese "
   "Magie haelt diese Kuppel immer noch aufrecht. "
   "Was fuer ein Meisterwerk, Du kannst sogar den Himmel von hier aus sehen.\n"
   );
  AddDetail( ({ "art" }),
   "Es ist definitiv Magie.\n" 
   );
  AddDetail( ({ "decke" }),
   "An der Decke befindet sich die grosse Kuppel.\n" 
   );
  AddDetail( ({ "glas" }),
   "Die Kuppel ist nicht aus Glas.\n" 
   );
  AddDetail( ({ "meisterwerk", "werke"}),
   "Hier muss ein Meister am Werke gewesen sein.\n" 
   );
  AddDetail( ({ "pflanzen" }), 
   "Es sind irgendwie komische Pflanzen, sie stehen in einer Ecke und scheinen "
   "unentwegt zu rascheln.\n" 
   );
   AddDetail( ({ "ecke" }), 
   "In der Ecke stehen komische Pflanzen.\n" 
   );
  AddDetail( ({ "boden" }),
   "Der ganze Boden ist mit Bambusmatten bedeckt. Einige Pflanzen stehen darauf.\n"
   );
  AddDetail( ({ "bambusmatten" , "matten" }),
   "Wenn man ueber die Matten geht, gibt das ein schoenes Gefuehl an den Fuessen. "
   "Angenehm entspannend, wie alles hier im Haus, schliesslich soll man sich hier "
   "von den Strapazen eines langen Metzeltages erholen. Barfuss und ohne Sorgen "
   "laesst es sich schon leben.\n" 
   );
  AddDetail( ({ "rascheln" }),
   "Durch den leichten Meereswind erzeugen die Pflanzen ein leises Rascheln. " 
   );
  AddDetail( ({ "gefuehl" }),
   "Ein schoenes Gefuehl. " 
   );
  AddDetail( ({ "strapazen" }),
   "Ein guter Metzeltag kann ganz schoen stressig sein. " 
   );
  AddDetail( ({ "treppe" }),
   "Die Treppe ist momentan kaputt. Hoffentlich repariert sie bald jemand. " 
   );
  AddDetail( ({ "westen" }),
   "Im Westen des Raumes ist eine alte Tuer. " ); 
   
  AddSpecialDetail(({"tuer"}),"tfunc");
  
  AddSound( DEFAULT_SOUND,
    "Nur die Brandung des Meeres ist etwas zu hoeren. ");

   
  AddItem("/d/wasser/buzzom/strandhaus/npc/krabbe" , REFRESH_DESTRUCT);
  

  
  AddSpecialExit( "westen","ofunc");
  AddExit( "nordosten", "./yeza2.lpc" );
  AddExit( "raus", "/d/wasser/dante/zinsel/room/isle_04.lpc" );

  
  AddCmd( ({ "oben" }) , "treppe_oben" );
  AddCmd("oeffne","aufunc");
}

tfunc()
 {if (i==0)
   {write("Die westliche Tuer ist fest verschlossen. "+
    "Normalerweise oeffnet man Tueren... \n");
    return "";
   }

  if (i!=0)
   {write("Die Tuer ist offen.\n");
    return "";
   }
  write ("error in Door, contact BUZZOM!!");
  return "";
  }

aufunc(str)
{object ob;


 if (!str)
 {notify_fail("So nicht!\n");
  return 0;
 }
 
 if (str=="tuer")
  {if (!IS_WIZARD(TP) && !ob=present("\bonekey",this_player()))
    {write ("Du brauchst den richtigen Schluessel um die Tuer zu oeffnen.\n");
     return 1;
    }

    write("Du steckst den Schuessel ins Schloss, sperrst auf und oeffnest\n"+
          "die Tuer.\n");
    say(this_player()->QueryProp(P_NAME)+" oeffnet eine Tuer.\n"); 
//    if (!IS_WIZARD(TP)) ob->remove();   schluessel wird doch behalten 6.6.2001
    i=1;
    WRITELOG(TPUID+" oeffnet die Tuer mit dem Schluessel");
    return 1;
  }
 
  notify_fail("Was willst Du denn oeffnen?\n");
 return 0;
}

ofunc()
 {if (i==0)
  {
   write("BOING. Du knallst mit Deinem Kopf gegen die geschlossene Tuer!\n");
   this_player()->reduce_hit_point(5);
   return 1;
   }

   
this_player()->move("/d/wasser/buzzom/strandhaus/room/abstell.lpc",M_GO,"durch die Tuere");
   return 1;
 }


treppe_oben ( str )
{
	notify_fail("Wohin willst Du? ");
	
	{
		write("Die Treppe ist momentan kaputt. Hoffentlich repariert sie bald jemand.\n");
		
		return 1;
	}
	return 0;
}

