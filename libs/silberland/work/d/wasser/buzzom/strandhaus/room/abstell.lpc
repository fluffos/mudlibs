/*

der raum ist von buzzom

hier steht das teleporttor
eingefuegt von dante 21.11.2000
*/



inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"


void create()
{

  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "In einem Abstellraum" );
  SetProp( P_INT_LONG,
   "Ueberall hier liegt Geruempel und altes Zeugs herum. Ordnung scheint hier "
   "wohl ein Fremdwort gewesen zu sein. An den Waenden stehen einige Regale "
   "und Schraenke. Auf dem Boden befinden sich Kisten, Truhen und alte Vasen. Staub "
   "hat sich ueber die Jahre auf allen Dingen niedergelassen. In den Ecken der "
   "Waende sind grosse Spinnenweben. Spinnen erkennst Du allerdings keine mehr. "
   );
   
   SetProp(P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]));
     
  AddSmell(DEFAULT_SMELL,
   "Es riecht hier ziemlich muffig. "
   );
  
  AddDetail( ({ "abstellraum", "raum", "haus" }),
   "Du befindest Dich gerade in ihm.\n" 
   );
  AddDetail( ({ "geruempel" }),
   "Du findest nur ein paar Gartenstuehle und Tische. Alles andere ist nur alter Krempel. " 
   );
  AddDetail( ({ "zeugs", "krempel", "dinge", "dingen" }),
   "Ein paar Bilder und Vasen liegen dort noch herum. " 
   );
  AddDetail( ({ "stuehle", "gartenstuehle", "stuhl"}),
   "Die Stuehle sind aus Bambus. " 
   );
  AddDetail( ({ "bambus" }),
   "Ein Grossteil dieses Hauses ist aus Bambus. " 
   );
   AddDetail( ({ "grossteil" }),
   "Ca. 70%. " 
   );
  AddDetail( ({ "tische", "tisch"}),
   "Die Tische sind aus Bambus und sehen schon ziemlich klapprig aus. " 
   );
  AddDetail( ({ "bilder", "bild" }),
   "Auf einem Bild siehst Du Buzzom im Kampf mit dem Balrog. " 
   );
  AddDetail( ({ "vasen", "vase" }),
   "Diese Vasen wurden wohl frueher zum Transport von Wasser genutzt. " 
   );
  AddDetail( ({ "wasser" }),
   "Du kannst kein Wasser in den Vasen erkennen. Es ist sicherlich verdunstet. " 
   );
  AddDetail( ({ "decke", "besonderes" }),
   "Da ist nichts Besonderes zu erkennen. " 
   );
  AddDetail( ({ "ordnung" }),
   "Danach sieht es hier sicher nicht aus. " 
   );
  AddDetail( ({ "fremdwort" }),
   "Konglomerat ist zum Beispiel ein Fremdwort. " 
   );
   AddDetail( ({ "wand", "waende" }),
   "An den Bambuswaenden stehen einige Schraenke und Regale. " 
   );
   AddDetail( ({ "regale", "schraenke", "regal", "schrank" }),
   "Alte Buecher und Pergamentrollen sind dort gelagert. " 
   );
   AddDetail( ({ "buecher" }),
   "Die Buecher sind sehr alt. Beim Beruehren wuerden sie zerbroeseln. " 
   );
   AddDetail( ({ "rollen", "schriftrollen", "pergament", "pergamentrollen", "pergamentrolle" }),
   "Lange vergilbte Pergemantrollen sind dort gelagert. Eine Rolle faellt Dir aber "
   "besonders auf. "
   );
   AddDetail( ({ "rolle" }),
   "Das ist ja gar keine Pergamentrolle sondern eine Art Hebel. Wozu der wohl gut ist? " 
   );
   AddDetail( ({ "hebel" }),
   "Dieser Hebel war durch die Rollen gut getarnt. Dank Deiner Spuernase hast Du ihn "
   "aber trotzdem gefunden. " 
   );
   AddDetail( ({ "nase", "spuernase" }),
   "Stimmt, Du hast keine Spuernase sondern eine Kartoffelnase. " 
   );
  AddDetail( ({ "kartoffelnase" }),
   "Sie sitz genau zwischen Deinen Augen. " 
   );
  AddDetail( ({ "boden" }),
   "Auf dem staubigen Boden liegt das meiste Geruempel. " 
   );
  AddDetail( ({ "kisten", "kiste", "truhen", "truhe" }),
   "Du oeffnest einige Kisten und Truhen. Leider sind sie alle leer. " 
   );
  AddDetail( ({ "staub" }),
   "Der Staub liegt hier wohl schon seit mehreren Jahren. " 
   );
  AddDetail( ({ "jahr", "jahre" }),
   "Mindestens zwoelf! " 
   );
  AddDetail( ({ "ecke", "ecken" }),
   "Du kannst grosse Spinnenweben in den Ecken erkennen. " 
   );
  AddDetail( ({ "weben", "spinnenweben" }), 
   "Iiihh, hoffentlich verhederst Du Dich nicht darin. "
   );
  AddDetail( ({ "spinnen", "spinne" }),
   "Die Spinnen haben sich sicher schon ein ordentlicheres Zuhause gesucht. "
   );
  
  
  AddSound( DEFAULT_SOUND,
    "Wenn Du keine Koerpergeraeusche machst ist es hier sehr ruhig. ");


  AddItem("/obj/sehertor", REFRESH_NONE);
  SetProp(P_TPORT_COST_IN, 1);
  
  AddCmd(({"ziehe", "zieh"}), "hebel_ziehen");
}

int hebel_ziehen(string str)
{
  notify_fail("Woran willst Du ziehen?\n");
  if(!str) return 0;
  if(str!="hebel" && str!="an hebel") return 0;
  write("Du ziehst am Hebel und ploetzlich bewegt sich der Schrank.\n"
        "Hinter ihm wird ein Durchgang sichtbar. Schnell springst Du hindurch.\n");
  TP->move("/d/wasser/buzzom/strandhaus/room/flur.lpc", M_GO, "nach Osten" );
  return 1;
}

_query_tport_cost_out()
{
  
  if(TP && TP->QueryProp("last_comic_heal_time")+300 > time() )
  {
    return 300 + TP->QueryProp("last_comic_heal_time") - time();
  }
  else
    return 1;
}
