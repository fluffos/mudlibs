//by buzzom and yeza
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include <moving.h>

create()
{
	::create();
	SetProp(P_INT_SHORT, "Yezas Sommerzimmer");
	SetProp(P_INT_LONG,
	 BS("In diesem Raum scheint Yeza zu idlen, wenn sie in "
	 "Strandstimmung ist. Zwischen zwei Waenden ist eine grosse "
	 "Haengematte gespannt, daneben steht ein kleiner Tisch, auf "
	 "dem ein Buch und eine Tasse mit Tee auf Yeza warten. Der "
	 "Boden ist mit Strandmatten ausgelegt, zwischen denen sich "
	 "Strandsand und Muscheln angesammelt haben. Zwei grosse "
	 "Fenster ermoeglichen einen direkten Blick auf das Meer. "
	 "Eine Wendeltreppe fuehrt nach unten.")
	 );
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS, 1 );
        SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]));
   
	AddDetail( ({"raum","zimmer"}),
	 BS("In diesem schlichten Raum kann man bestimmt schoen "
	 "die Seele baumeln lassen. Nach Norden kann man direkt auf "
	 "das Meer blicken. Die salzige Seeluft weht leicht durch das "
	 "Zimmer, und in der Ferne hoert man leise das Geschrei der "
	 "Moewen. Neben der schlichten weissen Haengematte steht ein "
	 "kleines Tischchen, auf dem noch ein paar Dinge von Yeza "
	 "liegen.")
	 );
	AddDetail("seele",
	 "Rabenschwarz."
	 );
	AddDetail( ({"meer","wasser"}),
	 BS("Blaugruen leuchtet das Meer im Sonnenlicht. Der leichte "
	 "Wind spuelt sanft ein paar Wellen an den weissen Strand, der "
	 "mit Muscheln uebersaeht ist.")
	 );
	AddDetail( ({"sonne","sonnenlicht","licht"}),
	 BS("Die Sonne bringt das Meer so richtig zum Leuchten. Hier "
	 "im Zimmer bist Du zum Glueck ein wenig vor ihr geschuetzt, so "
	 "dass Du beruhigt auch ein wenig laenger hier idlen kannst, "
	 "einen Sonnenstich zu bekommen.")
	 );
	AddDetail("leuchten",
	 "Das Meer leuchtet in der Sonne."
	 );
	AddDetail("glueck",
	 BS("Ein Glueck, dass Du hier bist und nicht in irgendeinem "
	 "Schlammloch steckst oder so.")
	 );
	AddDetail( ({"loch","schlammloch"}),
	 "Da gibts ein schoenes bei Tijara..."
	 );
	AddDetail("tijara",
	 "Tijara liegt gar nicht weit entfernt von hier."
	 );
	AddDetail( ({"stich","sonnenstich"}),
	 "Hier bist Du sicher davor."
	 );
	AddDetail( ({"wind","seeluft","luft","brise"}),
	 BS("Ein leichter Wind sorgt fuer eine kuehle Brise "
	 "in diesem Raum. Die Seeluft schmeckt etwas salzig.")
	 );
	AddDetail("wellen",
	 BS("Die Wellen rauschen leise, wenn sie vom Wind an den "
	 "Strand gespuelt werden. Die weissen Schaumkronen leuchten "
	 "im Sonnenlicht.")
	 );
	AddDetail("schaumkronen",
	 "Weiss leuchten sie in der Sonne."
	 );
	AddDetail("strand",
	 BS("Der Strand hat alles was dazugehoert: Weissen feinen "
	 "Strandsand, kleine weisse Muscheln, kreischende Moewen und "
	 "im Hintergrund ein traumhaft blaues Meer.")
	 );
	AddDetail( ({"strand","sandstrand"}),
	 "Richtig schoener feiner Sand."
	 );
	AddDetail( ({"muscheln","muschel"}),
	 "Kleine feine weisse Muscheln."
	 );
	AddDetail( ({"moewe","moewen"}),
	 "Kreischend fliegen die Moewen am Strand umher."
	 );
	AddDetail("ferne",
	 "Du fuehlst Dich fern von Stress und Alltag."
	 );
	AddDetail( ({"stress","alltag"}),
	 "Hier kannst Du alles vergessen."
	 );
	AddDetail("haengematte",
	 BS("Eine grosse, weisse, gemuetlich aussehende Haengematte. "
	 "Genau richtig zum Idlen.")
	 );
	AddDetail("tischchen",
	 BS("Neben der Haengematte steht ein kleines Tischchen. "
	 "Im Moment befinden sich darauf ein dickes Buch und eine "
	 "dicke rote Tasse mit Tee.")
	 );
	AddDetail("moment",
	 "Mooooment."
	 );
	AddDetail("buch",
	 BS("'Der Medicus' steht in dicken Buchstaben vorne drauf.")
	 );
	AddDetail("buchstaben",
	 "abcdefg, das ist das ganze ABC.."
	 );
	AddDetail("tasse",
	 BS("Eine dicke rote Tasse mit Tee steht dort. Du bekommst "
	 "Durst.")
	 );
	AddDetail("durst",
	 "Du wirst doch Yeza nicht den Tee wegtrinken!?"
	 );
	AddDetail("tee",
	 "Mhhhm, riecht gut."
	 );
	AddDetail("dinge",
	 "Ein Buch und eine Tasse."
	 );
	AddDetail("boden",
	 BS("Der Boden ist mit leichten Strandmatten ausgelegt, "
	 "zwischen denen sich Muscheln und Strandsand angesammelt "
	 "haben.")
	 );
	AddDetail("decke",
	 "Die Decke ist schlicht und weiss."
	 );
	AddDetail( ({"waende","wand"}),
	 BS("Die Waende sind einfach und weiss. Zwischen zwei "
	 "von ihnen ist eine Haengematte aufgespannt.")
	 );
	AddDetail("fenster",
	 BS("Durch zwei grosse offene Fenster kannst Du direkt "
	 "auf das Meer blicken.")
	 );
	AddDetail("blick",
	 BS("Dein Blick schweift ueber das Meer und Du fuehlst "
	 "Dich einfach nur wohl.")
	 );
	AddDetail( ({"wendeltreppe","treppe"}),
	 "Eine kleine Wendeltreppe fuehrt nach unten."
	 );
	AddSpecialExit("unten", "rausfkt");
	AddExit( "suedwesten", "./flur.lpc" );
}

int rausfkt(string dir)
{
	return this_player()->move("/d/wasser/buzzom/strandhaus/room/yeza.lpc", M_GO, 0,
	"geht die Wendeltreppe herunter", "kommt die Wendeltreppe hinuntergeklettert");
	
	return 0;
}
