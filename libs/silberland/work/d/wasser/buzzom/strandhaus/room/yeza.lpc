//by buzzom and yeza
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"
#include <moving.h>

create()
{
	::create();
	SetProp(P_INT_SHORT, "Yezas Aquarium");
	SetProp(P_INT_LONG, 
	BS("In diesen kleinen Raum zieht sich Yeza wohl zurueck, "
	"wenn sie allein sein moechte. Eine riesige Glaswand trennt "
	"den Raum im Norden vom Meer, ein paar einzelne Sonnenstrahlen "
	"dringen durch das Wasser ins Zimmer. Kleine Fische und "
	"Quallen tummeln sich im Meer, hin und wieder siehst du weiter "
	"draussen einen Hai seine Runden ziehen. Die Waende sind in "
	"einem ruhigen Blau gestrichen, getrocknete Rosen, ein kleines "
	"Regal und ein paar Bilder sind dort aufgehaengt. Unmengen von "
	"Kerzen sind im ganzen Zimmer verteilt. Ein Korbsessel steht "
	"vor einem kleinen Schreibtisch, auf dem Briefe und andere "
	"Papiere gestapelt sind. Eine kleine Wendeltreppe fuehrt wieder "
	"nach oben.")
	);
	SetProp(P_LIGHT, 1);
	SetProp(P_INDOORS, 1 );
        SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]));
	
	AddDetail( ({"raum","zimmer"}),
	  "Der Raum strahlt Ruhe und Kraft aus."
	 );
	AddDetail( ({"ruhe","kraft"}),
	  "Du schliesst Deine Augen und atmest tief durch."
	 );
	AddDetail( ({"glas","glaswand","wand"}),
	BS("Eine grosse Glaswand trennt den Raum vom Meer. Fasziniert "
	 "betrachtest Du die Unterwasserwelt. Kleine Krabben verstecken "
	 "sich im sandigen Meeresboden, Fische und Quallen scheinen "
	 "durch das Wasser zu schweben. Einzelne Sonnenstrahlen brechen "
	 "sich im Wasser. Kein Laut dringt von aussen herein.")
	 );
	AddDetail( ({"meer","wasser"}),
	 BS("Blaugruen leuchtet das Meer im Sonnenlicht. Fische und Quallen "
	 "tummeln sich im Wasser. Kleine Muscheln liegen am Meeresboden "
	 "verstreut. Am liebsten wuerdest Du hineintauchen in diese "
	 "Wunderwelt.")
	 );
	AddDetail( ({"strahlen","sonnenstrahlen","sonne","sonnenlicht","licht"}),
	BS("Einzelne Sonnenstrahlen scheinen von aussen durch das "
	 "Wasser ins Zimmer herein, die vielen Kerzen tauchen den Raum "
	 "zusaetzlich in ein sanftes beruhigendes Licht.")
	 );
	AddDetail( ({"unterwasserwelt","welt","wunderwelt"}),
	BS("Fasziniert betrachtest Du diese fremde schoene Welt unter "
	 "Wasser.")
	 );
	AddDetail( ({"fisch","fische"}),
	  "Unzaehlige kleine Fische tummeln sich im Wasser."
	 );
	AddDetail( ({"qualle","quallen"}),
	 "Still schweben die Quallen durch das Wasser."
	 );
	AddDetail( ({"krabbe","krabben"}),
	 "Kleine Krabben verstecken sich im Meeresboden."
	 );
	AddDetail( ({"muschel","muscheln"}),
	 BS("Der Meeresboden ist uebersaeht mit weissen Muscheln, "
	 "die im Sonnenlicht leuchten.")
	 );
	
	AddDetail("hai",
	 BS("Ein majestaetischer Hai zieht weiter draussen seine "
	  "Runden im Meer. Dichter an den Strand scheint er jedoch "
	  "nicht zu kommen, so dass man hier wohl beruhigt baden kann.")
	 );
	AddDetail("meeresboden",
	 "Weisser Sand bedeckt den Meeresboden."
	 );
	AddDetail("sand",
	 "Der Sand leuchtet weiss im Sonnenlicht."
	 );
	AddDetail( ({"kerze","kerzen","kerzenschein","schein"}),
	 BS("Unzaehlige Kerzen stehen im Raum verteilt herum. Ihr "
	 "sanftes Licht verzaubert Dich und laesst Dich alle Sorgen "
	 "und den Alltag vergessen.")
	 );   
	AddDetail( ({"alltag","sorgen"}),
	 "Vergiss Alltag und Sorgen, hier zaehlen sie nicht."
	 );
	AddDetail("strand",
	 "Yeza scheint den Strand und das Meer ueber alles zu lieben."
	 );
	AddDetail( ({"yeza","sternzeichen"}),
	 "Das Yezas Sternzeichen Fisch ist, ist unschwer zu merken."
	 );
	AddDetail("augen",
	 "Deine Augen leuchten im Kerzenschein."
	 );
	AddDetail( ({"wand","waende"}),
	 BS("Die Waende sind in einem ruhigen dunklen Blauton gestrichen. "
	 "Getrocknete Rosen sind ueberall befestigt. Neben einem "
	 "kleinen Regal haengen ausserdem ein paar Bilder.")
	 );
	AddDetail( ({"blau","blauton","farbe","lieblingsfarbe"}),
	 "Blau scheint Yezas Lieblingsfarbe zu sein."
	 );
	AddDetail( ({"rose","rosen"}),
	 BS("Getrocknete Rosen haengen an den Waenden. Von wem Yeza "
	 "die wohl immer bekommt?")
	 );
	AddDetail("regal",
	 BS("Ein kleines Regal haengt an einer Wand. Verschiedene kleine "
	 "Gegenstaende liegen darin.")
	 );
	AddDetail( ({"gegenstaende","andenken"}),
	 BS("Im Regal scheint Yeza persoenliche Gegenstaende und Andenken "
	 "aufzubewahren. Ein Gegenstand aus Knochen faellt Dir auf. ")
	 );
	AddDetail( ({"gegenstand", "schluessel"}),
	 BS("Das scheint eine Art mystischer Schluessel aus Knochen zu sein. "
	 "Sei aber vorsichtig! Manchmal loesen solche Dinge beim Entwenden "
	 "geheime Mechanismen aus. ")
	 );
	AddDetail("neugier",
	 "Sei nicht so neugierig!"
	 );
	AddDetail( ({"bilder","bild"}),
	 BS("Du erkennst neben Roc, Sennah, Buzzom und Eldar "
	 "auch Selena und Trebor auf den Bildern.")
	 );
	AddDetail( ({"korbsessel","sessel"}),
	 BS("Ein gemuetlicher schlichter Korbsessel steht vor dem "
	 "kleinen Schreibtisch. ")
	 );
	AddDetail( ({"tisch","schreibtisch"}),
	 BS("Ein kleiner Schreibtisch steht an einer Wand. Unmengen "
	 "von Papieren sind darauf aufgestapelt. Die Schubladen sind "
	 "verschlossen.")
	 );
	AddDetail( ({"laden","lade", "schublade", "schubladen"}),
	 BS("Sie sind verschlossen. ")
	 );
	AddDetail( ({"post","unmengen","papiere","papier","brief","briefe"}),
	 BS("Unmengen von Papieren und Briefen liegen auf dem "
	 "Schreibtisch. Yeza scheint gerne Post zu kriegen und zu "
	 "schreiben. ")
	 );
	AddDetail( ({"treppe","wendeltreppe"}),
	 "Eine kleine Wendeltreppe, die nach oben fuehrt."
	 );
	AddDetail("boden",
	 BS("Ein gemuetlicher dunkelblauer Teppich bedeckt den Boden.")
	 );
	AddDetail("teppich",
	 BS("Der Teppich leuchtet in einem dunklen Blau. Er ist weich "
	 "und gemuetlich und haelt Deine Fuesse warm.")
	 );
	AddDetail( ({"fuesse","zehen"}),
	 "Du bohrst genuesslich Deine Zehen in den Teppich."
	 );
	AddDetail("decke",
	 BS("Eine schlichte Decke ohne Verzierungen. Sie ist genau "
	 "wie die Waende dunkelblau gestrichen.")
	 );
	AddDetail("verzierungen",
	 "Du kannst keine erkennen."
	 );
	AddSound(DEFAULT_SOUND, 
	 BS("Kein Laut dringt von aussen ins Zimmer hinein. Du "
	 "geniesst die Stille und Ruhe.")
	 );
	
	AddItem("/d/wasser/buzzom/strandhaus/npc/krabbe2" , REFRESH_DESTRUCT);
	
	
	AddCmd( ({"nimm","nehme"})        , "nimm_schluessel");
	
	AddSpecialExit("oben", "rausfkt");
	
}

int nimm_schluessel(string str)
{
  object schluessel;

  notify_fail("Was willst du woraus nehmen?\n");

  if(-1 == member(({"schluessel aus regal", "gegenstand aus regal", "schluessel"}),str))
  {
    return 0;
  }
  
  
  if(deep_present("\", TP)) 
  {
  TELLPLAYER("Du kannst doch nicht einfach alles von Yeza's Sachen mitnehmen.\n");
  return 1;
  }
  
  
  TELLPLAYER(BS("Du nimmst den Schluessel und steckst ihn ein. "));
  {
   if(!schluessel=clone_object("/d/wasser/buzzom/strandhaus/obj/bonekey.lpc"))
    {
      TELLPLAYER("Es bugt!!! Magier Buzzom verstaendigen\n");
      return 0;
    }

    
    {
    	 schluessel->move(this_player(), M_NOCHECK);
    }
  
    {
         write("PLOETZLICH ZIEHT SICH DER TEPPICH BEISEITE. "
               "EINE FALLTUER GEHT AUF UND DU RAUSCHST IN DIE "
               "TIEFE.\n");
        TP->move("/d/wasser/dante/zinsel/room/kneipe1.lpc", M_GO, "durch eine Falltuer in die Tiefe" );
    }  
  
  
  }
  
  return 1;
}

int rausfkt(string dir)
{
	return this_player()->move("/d/wasser/buzzom/strandhaus/room/yeza2.lpc", M_GO, 0,
	"geht die Wendeltreppe nach oben", "kommt von unten hinauf");
	
	return 0;
}