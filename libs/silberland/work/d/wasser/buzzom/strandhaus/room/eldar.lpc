//by buzzom and eldar
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include <wizlevels.h>
#include "../def.h"

void create()
{

  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Eldar's kleines Labor" );
  SetProp( P_INT_LONG,
    "Du hast Eldar's kleinen Arbeitsraum betreten. Um Dich herum sieht es "
    "aus, wie es in einem kleinen Labor auszusehen hat, ein Tisch mit "
    "Apparaturen, ein riesengrosses Buecherregal und allerlei Krimskrams. "
    "Der ganze Raum ist in Spinnweben gehuellt. Aber das ist nicht das "
    "einzige, denn weiter hinten kannst Du noch zwischen den Spinnweben "
    "eine Couch erkennen. " 
     );
    
    SetProp(P_INDOORS, 1 );
    SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]));

  AddDetail( ({ "regal" , "buecherregal" }),
    "An der Wand steht ein riesiges Buecherregal mit einer Menge alter Schinken.\n"
   +"Zwischen den Buechern stehen vereinzelt einige Glaeser und auch Schaedel\n"
   +"sind noch zu entdecken.\n"  
     );
  AddDetail( ({ "glaeser" }),
    "In den Glaesern sind verschiedene Dinge zu sehen : in einem Glas sieht man\n"
   +"eingelegte Haende, in einem anderen einen Fuss und in wieder einem anderem\n"
   +"sieht man einem Kopf schwimmen.\n"  
     );
  AddDetail( ({ "kopf" }),
    "Leider siehst Du den Kopf nur von hinten. Vielleicht sollte man das Glas\n"
   +"einfach mal drehen ?\n"  
     );
  AddDetail( ({ "haende" }),
    "Sie sind rot und behaart. Auf dem Glas steht ausserdem noch ein kleines\n"
   +"Schild mit der Inschrift : \n"
   +"Balrog, 19. Jan. - unfreiwillig hergegeben, musste Gewalt anwenden.\n" 
     );
  AddDetail( ({ "buecher" , "schinken" }),
    "Die Buecher sind in das Regal einsortiert. Du kannst eine Menge davon sehen.\n"
   +"Diese Sammlung scheint Eldars gesamtes Wissen zu enthalten.\n"  
     );
  AddDetail( ({ "fuss" }),
    "Igitt ... von wem auch immer dieser Fuss stammt, dieser Jemand muss froh\n"
   +"sein, ihn losgeworden zu sein. Denn dieser Fuss ist ganz schwarz ... \n"
   +"Eindeutig Raucherbein.\n"  
     );
  AddDetail( ({ "jemand" }),
    "Dieser einbeinige Jemand ist gerade nicht hier.\n" 
     );
  AddDetail( ({ "raucherbein" , "bein" }),
    "Also Dein Bein kann es nicht sein, denn Du stehst immer noch sicher auf\n"
   +"Deinen beiden Fuessen.\n"
     );
  AddDetail( ({ "tisch" }),
    "Auf dem Tisch sind verschiedene Apparaturen zu einer Art Experiment aufgebaut\n"
   +"worden. Du kannst Schlaeuche und einige kleine und grosse Behaelter darin\n"
   +"ausmachen. Besser Du fasst die Apparaturen nicht an sonst, passiert noch etwas\n"
   +"unglaublich schlimmes.\n"  
     );
  AddDetail( ({ "apparaturen", "apparatur" }),
    "Besser Du fasst die Apparaturen nicht an sonst, passiert noch etwas\n"
   +"unglaublich schlimmes.\n" 
     );
  AddDetail( ({ "schlaeuche" }),
    "Schlaeuche, die man zum experimentieren braucht.\n" 
     );
  AddDetail( ({ "behaelter" }),
    "Das sind Behaelter fuer chemische Substanzen.\n" 
     );
   AddDetail( ({ "substanzen" }),
    "Haettest Du besser in Chemie aufgepasst, koenntest Du sie jetzt identifizieren.\n" 
     );
   AddDetail( ({ "chemie" }),
    "Hier stimmt die Chemie.\n" 
     );
  AddDetail( ({ "krimskrams" , "boden" }),
    "Auf dem Boden liegen allerlei Zettel verstreut herum. Es sieht so aus, als\n"
   +"wenn sie ein Buch bilden.\n"  
     );
  AddDetail( ({ "zettel" }),
    "Sammel sie doch ein, vielleicht kannst Du dann das Buch lesen.\n" 
     );
  AddDetail( ({ "glas" }),
    "Was willst Du denn an dem Glas untersuchen ?\n" 
     );
  AddDetail( ({ "experiment" }),
    "Du schaust Dir das Experiment genauer an. Es ist ein Wirrwarr aus Schlaeuchen\n"
   +"und verschiedenen kleinen Behaeltern. Du kannst aber keine Struktur darin\n"
   +"erkennen, wofuer auch immer es genutzt wird, es muss sehr wichtig und\n"
   +"bedeutend sein.\n"
     );
  AddDetail( ({ "schaedel" , "orkschaedel" }),
    "Ein ziemlich anmutiger Orkschaedel.\n" 
     );
  AddDetail( ({ "waende" }),
    "Die Waende sind mit schwarzen Flecken geradezu ueberzogen und ueberall\n"
   +"haengen Spinnweben herum. Welche Wand willst Du genauer untersuchen ?\n"  
     );
  AddDetail( ({ "ostwand" }),
    "An der Ostwand siehst Du einen Wandschrank und daneben ein paar Kleiderhaken.\n" 
     );
  AddDetail( ({ "wandschrank" , "schrank" }),
    "Was da wohl drin sein mag ?\n" 
     );
  AddDetail( ({ "kleiderhaken" }),
    "An den Kleiderhaken haengen einige Sachen.\n" 
     );
  AddDetail( ({ "sachen" }),
    "Wow es sind Drachensachen.\n" 
     );
  AddDetail( ({ "drachensachen" }),
    "Als Du Dir die Drachensachen genauer anschaust, musst Du enttaeuscht\n"
   +"feststellen, dass sie an der Wand festgenagelt sind.\n" 
     );
  AddDetail( ({ "nordwand" }),
    "Dort ist der Ausgang zu finden.\n" 
     );
  AddDetail( ({ "westwand" }),
    "Ein grosses Regal nimmt die gesamte Westwand ein.\n" 
     );
  AddDetail( ({ "tapete" }),
    "Ein grosses Muster ist an der Tapete zu erkennen.\n" 
     );
  AddDetail( ({ "muster" }),
    "Schwarze Flecken an den Waenden ergeben ein komisches Muster.\n" 
     );
  AddDetail( ({ "flecke", "fleck" }),
    "Die Flecken sind tief schwarz.\n" 
     );
  AddDetail( ({ "ecke" , "ecken" }),
    "Da ist wirklich nichts Interessantes drin versteckt.\n" 
     );
  AddDetail( ({ "interessantes" }),
    "Nichts.\n" 
     );
  AddDetail( ({ "nichts" }),
    "Der Witz mit dem Nichts ist ja nun schon mehr als ausgelutscht, oder ?\n" 
     );
  AddDetail( ({ "witz" }),
    "Ha Ha ...\n" 
     );
  AddDetail( ({ "decke" }),
    "An der Decke haengt ein riesiger Kronleuchter mit einer Unmenge Kerzen dran.\n" 
     );
  AddDetail( ({ "leuchter" , "kronleuchter" }),
    "Einer von der Sorte, der Leute erschlaegt, wenn er runterfaellt, aber das\n"
   +"wird zum Glueck nie geschehen.\n" 
     );
  AddDetail( ({ "couch" }),
    "Auf ihr legt sich Eldar immer hin, wenn er vom Forschen und Metzeln muede\n"
   +"geworden ist. Sie ist allerdings nur dazu geeignet um sich hinzulegen, darauf\n"
   +"herumspringen kann man bestimmt nicht.\n"  
     );
  AddDetail( ({ "suedwand" }),
    "Ebenso wie an der Westwand befindet sich dort das grosse Regal.\n" 
     );
  AddDetail( ({ "ausgang" }),
    "Er fuehrt, wie der Name schon sagt, nach draussen.\n" 
     );
  AddDetail( ({ "flecken" }),
    "Zeugen von vergangenen, nicht gerade von Erfolg gekroenten Experimenten.\n" 
     );
  AddDetail( ({ "unmenge" , "kerzen" }),
    "Es sind 7.\n" 
     );
  AddDetail( ({ "spinnweben" }),
    "Sie haengen an den Waenden und geben dem Raum ein etwas gruseliges Aussehen.\n" 
     );
  AddDetail( ({ "forschen" }),
    "Das machst Du gerade.\n" 
     );
  AddDetail( ({ "metzeln" }),
    "Hier gibt es garantiert nichts zu metzeln.\n" 
     );

  AddCmd( "fasse" , "fasse_etwas_an" );
  AddCmd( "drehe" , "drehe_etwas" );
  AddCmd( "zaehle" , "zaehle_etwas" );
  AddCmd( ({ "sammel" , "sammle" }) , "sammel_etwas" );
  AddCmd( ({ "liege" , "lieg" }) , "auf_couch_liegen" );
  AddCmd( ({ "springe" , "spring" }) , "auf_couch_springen" );
  AddExit( "norden", "./flur.lpc" );
}
fasse_etwas_an ( str )
{
	notify_fail("Was willst du denn anfassen ?\n");
	if ( str == "apparaturen an" )
	{
		write("Als du die Apparaturen anfaesst faellt dir ein Glas um. Schnell stellst du es\n");
		write("zwar wieder hin, aber nicht schnell genug ...\n");
		write("Der Wandschrank oeffnet sich und hinaus kommt ein Besen.\n");
		write("\n");
		write("Der Besen sagt : Du Frevler, beruehre nie wieder die Werke meines Meisters !\n");
		write("\n");
		write("Mit diesen Worten befoerdert er dich galant vor die Tuer.\n");
		TP->move("/d/wasser/buzzom/strandhaus/room/flur.lpc", M_GO,"das Labor","verlaesst","kommt herein");
		return 1;
	}
	return 0;
}
drehe_etwas ( str )
{
	notify_fail("Was willst du drehen ?\n");
	if ( str == "glas" )
	{
		write("Du drehst das Glas um und ploetzlich spricht der Kopf zu dir ...\n");
		write("\n");
		write("Der Kopf sagt : Dreh mich sofort wieder zurueck, ich will das schoene Muster\n");
		write("Der Kopf sagt : der Tapete wieder betrachten.\n");
		write("\n");
		write("Erschrocken drehst du das Glas wieder zurueck.\n");
		return 1;
	}
	return 0;
}
zaehle_etwas ( str )
{
	notify_fail("Was willst du denn zaehlen ?\n");
	if ( str == "buecher" )
	{
		write("Du beginnst die Buecher zu zaehlen ...\n");
		write("Eins ... Zwei ... Drei ...\n");
		write("\n");
		write("Als du schliesslich bei 600 angekommen bist, verhaspelst du dich, hast aber\n");
		write("keine Lust nochmal anzufangen.\n");
		return 1;
	}
	return 0;
}
sammel_etwas ( str )
{
	notify_fail("Was willst du einsammeln ?");
	if ( str == "zettel ein" )
	{
		write("Du sammelst alle Zettel ein und sortierst sie.\n");
		write("\n");
		write("Als du mit Sortieren fertig bist, kannst du erkennen, dass dies eine\n");
		write("Versuchsanleitung ist.\n");
		write("Der Titel lautet : 'Ein Tag im Leben einer Kaffemaschine - Dr. Hag\n");
		write("\n");
		write("Als du ein bisschen darin herumblaetterst hoerst du ploetzlich ein Knarren\n");
		write("hinter dir. Du drehst dich um und vor Schreck wirfst du wieder alle Zettel\n");
		write("weg ... da war doch nichts.\n");
		return 1;
	}
	return 0;
}
auf_couch_liegen ( str )
{
	notify_fail("Auf was willst du liegen ?\n");
	if ( str == "auf couch" )
	{
		write("Du legst dich langsam auf die Couch und ruhst ein bisschen ...\n");
		write("Ist das schoen erholsam.\n");
		say(this_player()->name(WER,2)+"legt sich auf die Couch.\n");
		return 1;
	}
	return 0;
}
auf_couch_springen ( str )
{
	notify_fail("Auf was willst du springen ?\n");
	if ( str == "auf couch" )
	{
		write("Du nimmst sehr viel Anlauf und springst mit aller Wucht auf die Couch.\n");
		write("\n");
		write("... BOING ...\n");
		write("\n");
		write("Doch leider war es wohl zu viel Anlauf, denn du landest\n");
		write(" ... KLATSCH ... an der Wand.\n");
		say(this_player()->name(WER,2)+"nimmt Anlauf und springt mit voller Wucht von der Couch an die Wand.\n");
		return 1;
	}
	return 0;
}