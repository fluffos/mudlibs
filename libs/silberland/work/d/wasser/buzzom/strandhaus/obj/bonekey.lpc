inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Knochenschluessel");
  SetProp(P_LONG, 
   "Ein kleiner mystischer Knochenschluessel von der Zombieinsel. ");

  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_MATERIAL,([MAT_BONE:100]));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schluessel");
  
  AddId( ({"\bonekey","schluessel","knochenschluessel"}));
 
  seteuid(getuid());
  

}


