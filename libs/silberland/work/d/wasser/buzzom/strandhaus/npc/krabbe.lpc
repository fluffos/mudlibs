*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
// #include "../def.h"

create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();     
  
  SetProp (P_SHORT, "Eine Riesenkrabbe");
  SetProp(P_LONG,
    "Diese Riesenkrabbe ist ueber einen Meter gross. Anscheinend hat sie sich "
    "hierher verlaufen. Mit ihren sechs langen Beinen wirkt sie sehr bedrohlich. "
    "Ihre feurigen Augen haben Dich genau fixiert. Eine kleine Bewegung und "
    "Du wirst Ihr naechstes Opfer sein. Der rote Schimmer Ihres Panzers laesst "
    "Dich erschaudern. Vielleicht solltes Du hier lieber schnell verschwinden."
  );
  SetProp (P_NAME, "Riesenkrabbe");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Krabbe");
  AddId(({"riesenkrabbe", "krabbe"}));
  create_default_npc (18);
  
  SetProp(P_BODY, 50);
  SetProp(P_SIZE, 150);
  SetProp(P_HANDS, ({" mit ihrem Kiefer", 150}));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_DIE_MSG, " faellt mit einem fuerchterlichen Schrei zu Boden.\n");

 //Ruestung
 clone_object("/d/wasser/buzzom/strandhaus/armour/krapanz")->move(this_object());
  command("trage panzer");
}
