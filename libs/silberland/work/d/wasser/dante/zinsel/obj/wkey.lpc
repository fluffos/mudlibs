//dante sl 99

inherit "std/thing";
//inherit "std/room/doors";

#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <thing.h>
//#include <doors.h>


string col;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

col="blau";


  SetProp(P_SHORT,"Ein "+col+"er Schluessel");
  SetProp(P_LONG,BS(
  "Dieser "+col+"e Schluessel wurde einst von einem Unwesen aus den "
  "Tiefen der Zombieinsel bewacht. Nun hast Du ihn. Welches Tor er "
  "wohl sperren mag..."));

  AddId(({"schluessel", "KEY"+col+""}));
  AddAdjective( ({col, col+"er", col+"en", col+"em"}) );

  SetProp(P_NAME,"Schluessel");
  SetProp(P_NAME_ADJ,col);
  SetProp(P_VALUE, 1000);
  SetProp(P_WEIGHT, 30);

  SetProp(P_GENDER,MALE);
  SetProp(P_MATERIAL,([MAT_STEEL:100]));
}

string QueryDoorKey()  {
	
	return
("/d/wasser/dante/zinsel/room/w2")+":"+("/d/wasser/dante/zinsel/room/w3");
}

	
