//dante sl 99
//heilt zvirus

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

int da=3;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Ein gruener Stachel");
  SetProp(P_LONG, BS(
        "Der Stachel leuchtet grellgruen und ist enorm Spitz. Von seiner "
        "Spitze tropft eine gelbe Fluessigkeit. Er stammt von der Insel "
        "der Zombies."));

  AD(({"spitze"}),
      "Die Spitze ist sehr spitz. Gelbe Fluessigkeit tropft herunter.");


  ASD(({"fluessigkeit","fluessigkeiten"}), "show");

  AddId( ({"ZOMBIE_HEAL","stachel"}) );
  SetProp(P_NAME,"Stachel");
  SP(P_NAME_ADJ, "gruen");
  SetProp(P_GENDER,MALE);
  SP(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
  SetProp(P_WEIGHT,10);
  SP(P_VALUE, 10000);
  SP(P_INFO, BS(
        "Der Stachel kann Dich vom Zombievirus heilen! syntax <antidot>! Aber "
        "verwende es nur wenn Du wirklich schon schwer erkrankt bist!!! "
        "Wenn Du sehen willst wieviele Anwendungen noch da sind, untersuche "
        "Fluessigkeit!"));

  ACD(({"antidot"}), "heilen");
}


string show()  {
  if(da==0)  {
    write(BS(
          "Die Fluessigkeit scheint vertrocknet zu sein! Helfen kann sie "
          "Dir so nicht mehr!"));
    return ""; 
  }

  return BS(
      "Du kannst Dich mit dem Stachel noch "+da+" mal heilen!");
}

int heilen()  {
  object ob;
  ob=present("DANTE_ZOMBIE_VIRUS", TP);

  if(da==0)  {
    write(BS(
          "Dein Stachel zerfaellt in Deinen Haenden zu staub!"));
    remove();
    return 1;
  }		
  if(!ob)  {	
    write(BS(
          "Du stichst Dir mit dem Stachel direkt ins Herz! Fluessigkeit gelangt "
          "in Deinen Koerper und vergiftet Dich schwer! Du warst nicht erkrankt!!!"));
    TP->AddPoison(5);
    da--;
    say(BS(
          CAP_TPN+" sticht sich einen Stachel direkt ins Herz!"));

    return 1; 
  }

  if(ob)
  {
    say(BS(
          CAP_TPN+" sticht sich einen Stachel direkt ins Herz!"));
    write(BS(
          "Du stichst Dir den Stachel mitten ins Herz. Fluessigkeit dringt "
          "in Dich ein! Es zischt und blubbert in Dir. Deine Haut "
          "remutiert. Es sticht ueberall, doch Du bist geheilt!!!"));

    ob->remove();da--;
    if(ob) {
      ob->destruct();  
    }
    return 1; 
  }
  return 0; 
}

