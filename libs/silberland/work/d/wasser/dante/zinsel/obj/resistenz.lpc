
inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

int i=1;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  
  AddId(({"\nRESISTENZ_PLANTDRAGON", "RPD"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}



reset()
{
  ::reset();
  if(i==10+random(10))
    {
    
    if(!is_clone(TO) ) return;
    if(!environment(TO))  return;
    
    if(interactive(environment(TO)) ) {
     tell_object(environment(TO),
     "Der Schutz Deines Saeuremantels verschwindet.\n");
    TO->remove();
    } 
}
  else
    i++;
}

