//dante sl 99

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Ein rostiger Hebel");
  SetProp(P_LONG, BS(
  "Der Hebel sieht schon sehr verrostet aus. Wozu er wohl dient..."));
  AddId( ({"hebel", "\nhebel", "ZOMBIE_HEBEL"}) );
  SetProp(P_NAME,"Hebel");
  SP(P_NAME_ADJ, "rostig");
  SetProp(P_GENDER,MALE);
  SP(P_INFO, "Der Hebel hat sicher Sinn!");
  SP(P_MATERIAL, ([MAT_IRON: 100 ]));
  SetProp(P_WEIGHT,20);
}