
inherit "std/thing";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

int dosis;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

 dosis =5+random(5);

  SetProp(P_SHORT, "Die Larve eines Saeureschleimers( Anwendungen: "+dosis+" )");
  SetProp(P_LONG, BS(
  "Das ist die Larve eines Saeureschleimers. Dieser Kaefer kommt nur in "
  "ganz bestimmten Regionen des Silberlandes vor. Sie enthaelt Stoffe, "
  "die angeblich gegen ganz bestimmte Saeureattacken helfen. "
   "Verwende sie aber nur, wenn Du bereits mit Saeure uebergossen wurdest. "
  "Du kannst sie mit "
  "< reibe larve auf koerper > verwenden. Dir ekelt bei dieser Vorstellung.")); 
    SetProp(P_INFO, "Diese Larve kann sehr hilfreich sein! Vor allem gegen einen "
    "bestimmten Drachen!!!\n");
    
  SetProp(P_NAME, "Larve");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([ MAT_HORN:10,  MAT_ANIMAL:90 ]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  AddId(({"larve"}));
 AddCmd(({"reibe","reib"}), "heal");
}
   
   heal(string str)
   {
   object m;
   notify_fail("Was willst Du hier wo reiben?\n");
   if (!str) return 0;
   
       if (member(({"larve auf koerper"}),str)!=-1)
           {
           if ((!dosis) )
              {
              write("Du reibst die Larve auf Dir hin und her. Aber nichts passiert.\n");
              return 1;
              }
              
              if( (dosis) && (deep_present("saeuretot", TP)))
              
              {
                 write("Du reibst die Larve hin und her und fuehlst Dich erleichtert.\n");
                 dosis--;
                 say(BS(
                 CAP_TPN+" reibt sich den ganzen Koerper mit einer ekligen Kaeferlarve ein!"));
                 
                 
                 SetProp(P_SHORT, "Die Larve eines Saeureschleimers ( Anwendungen: "+dosis+" )");
                 m=deep_present("saeuretot", TP);
                 m->remove(1);
                 
                 return 1;
               }
               
            if( (dosis) && (!present("saeuretot", TP)))
            {
              say(BS(
                 CAP_TPN+" reibt sich den ganzen Koerper mit einer ekligen Kaeferlarve ein!"));
            write("Du reibst die Larve hin und her, obwohl Du nicht mit Schleim ueberzogen bist.\n");
            TP->AddPoison(3);
            dosis--;
            
           SetProp(P_SHORT, "Die Larve eines Saeureschleimers ( Anwendungen: "+dosis+" )");
            return 1;
            }



           return 0;
           }   
       
       return 0;
       }
             
                  