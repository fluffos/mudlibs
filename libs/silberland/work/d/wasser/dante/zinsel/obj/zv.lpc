/*

 das ding bereitet mir uns nur sorgen

*/

inherit "std/thing";
#include <properties.h>
#include <moving.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <defines.h>

#define EN environment(TO)->name

#define T1 90+random(60) //zeit der normalen callouts
#define T2 90+random(60) //zeit der stdcall_outs

object pla=0;
object raum;

string old_extralook;
string old_presay;




setze_alte_werte()  {

  if(!environment(TO))  {
    remove();  }

  if(!query_once_interactive(environment(TO)))  { remove();  }

  if(pla!=0)  {
    pla->SP(P_PRESAY, old_presay);
    pla->SP(P_EXTRA_LOOK, old_extralook);

    remove(); 
  }

}


int check_remove() {
  if(!ENV(ME) || !query_once_interactive(ENV(ME))) 
    return remove(),1;
  return 0;
}

init()  {
::init();

if(!is_clone(TO)) { call_out("remove", 0);  }


if(environment(TO)->id("zombie") ) { remove(); }

if(present("ZV 2", MENV) || !query_once_interactive(MENV) )
    call_out("remove",0);

 }



BecomesNetDead(object player)  {

setze_alte_werte();
 
  
  }	
	




reset() {
	::reset();
if(!environment(TO))  { remove();  return;}


if(!query_once_interactive(environment(TO)))  {
	call_out("remove", 1);  
	     return;}
	}
		


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SP(P_MAGIC, 1);
   SP(P_NEVERDROP, 1);
  SP(P_KILL_NAME, "Der Zombievirus");
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT, 0);
  AddId  (({"DANTE_ZOMBIE_VIRUS", "ZV"}), "Krankheit");
  call_out("z1", T1);
  //SP(P_AUTOLOADOBJ, 1);

ACD("zombieattacke", "gag");


}




mixed _query_autoloadobj()
{
  return ({ old_presay, old_extralook });
}

void _set_autoloadobj(mixed arg)
{
  if (sizeof(arg) > 1)
  {
    old_presay=arg[0];
    old_extralook=arg[1];
  }
}





int gag (string str)  {
  object virus;
  object opfer;
  NF("Wen willst Du attackieren!\n");
  if(!str) return 0;
 
 opfer=present(str, environment(TP));

//if( opfer->name()==TP->name() )  {
if( opfer==TP )  { // ueber name() zu gehn ist unsicher (Frosch etc.), 
                   // getuid() waer besser, aber direkter objektvergleich
                   // geht auch (Cirion)
  write(BS(
  "Brutal beisst Du Dich selbst, Du Psychopath!"));
  say(BS(
  CAP_TPN+" schaut Dich irr an und beisst sich dann selbst in die Hand! Ein Psychopath!"));
  return 1; }
  
 
 if(!opfer)  
  {
 write(BS(
 "Aber "+CAP(str)+" ist doch nicht hier!"));
 return 1;  }
 
 
 
 
if(!living(opfer))  {
  write(BS(
  "Nein, "+opfer->name(WER)+" laesst sich von Dir nicht beissen!"));
  return 1; 
  }
  
 if(opfer->QP(P_GHOST))  {
   write(BS(
   "Du kannst einen Geist schlecht beissen!"));
   return 1; }
    
  if(TP->QueryGuest()) {
 	write(BS(
 	"Du kannst Gaeste nicht einfach so beissen!"));
 	return 1;  }
 
 	   
  

if( (living(opfer)) && (!query_once_interactive(opfer)))  {
  
 write(BS(
  "Brutal schlaegst Du Deine faulen Stummel in "+opfer->name(WESSEN)+" Koerper! "
  "Ja das ist lecker! Frisches Fleisch! Du bist so gerne ein Zombie!!! "
  "Hehe, "+opfer->name(WER)+" zuckt zusammen und sieht recht erschrocken drein!"));
 
  
  say(BS(
  "Ein Zombie namens "+CAP_TPN+" springt "+opfer->name(WEN)+" an und "
  "schlaegt "+TP->QueryPossPronoun(FEMALE, WEN, PLURAL)+" faulen Zaehne in "
  "den Hals von "+opfer->name(WEM)+"!!! Aber "+opfer->name(WEM)+" ist das voellig egal!!"), ({opfer, TP}));
opfer->Kill(TP);

return 1; }


if(deep_present("ZV", opfer))  {
 
  write(BS(
  "Aber "+opfer->name(WER)+" ist doch auch schon am Zombievirus erkrankt!"));

  write(BS(
  "Brutal schlaegst Du trotzdem Deine faulen Stummel in "+opfer->name(WESSEN)+" Koerper! "
  "Waeh ist das eklig. Faules stinkendes Fleisch! Aber Euch Zombies gefaellt das ja!!!"));
  
  say(BS(
  "Ein Zombie namens "+CAP_TPN+" springt "+opfer->name(WEN)+" an und "
  "schlaegt "+TP->QueryPossPronoun(FEMALE, WEN, PLURAL)+" faulen Zaehne in "
  "den Hals von "+opfer->name(WEM)+"!!! Aber "+opfer->name(WEM)+" ist das voellig egal!!"), ({opfer, TP}));
  
 tell_object(opfer, BS(   
 "Ein Zombie namens "+CAP_TPN+" springt Dich an und "
    " schlaegt "+TP->QueryPossPronoun(FEMALE, WEN, PLURAL)+" faulen Zaehne in Deinen Hals!!! "  
  "Aber Dir Zombie gefaellt das ja sogar!!!"));                 
 
 
  return 1; }
 
 
 
 
 if(opfer && interactive(opfer))  {
 
 
 if(query_idle(opfer) > 0 )  {
 	
 	write(BS(
 	""+opfer->name(WER)+" ist gerade idle! Das waere hoechst unfair!"));
 	tell_object(opfer, BS(   
 	CAP_TPN+" wollte Dich mit dem Zombievirus infizieren!"));
 	return 1; }
 	
 
 
 virus=CLONEOB("d/wasser/dante/zinsel/obj/zv");
 virus->move(opfer, M_NOCHECK);

  write(BS(
  "Brutal schlaegst Du Deine faulen Stummel in "+opfer->name(WESSEN)+" Koerper! "
  "Ja das ist lecker! Frisches Fleisch! Du bist so gerne ein Zombie!!! "
   ""+opfer->name(WER)+" zuckt zusammen und sieht recht erschrocken drein!"));   
  
   
  say(BS(
  "Ein Zombie namens "+CAP_TPN+" springt "+opfer->name(WEN)+" an und "
  "schlaegt "+TP->QueryPossPronoun(FEMALE, WEN, PLURAL)+" faulen Zaehne in "
  "den Hals von "+opfer->name(WEM)+"!!! " 
  ""+opfer->name(WEM)+" bruellt laut vor Schmerzen auf!"), ({opfer, TP}));
  
  
  
  
  
  domainshout(BS("Ein Zombie namens "+CAP_TPN+" hat soeben "+opfer->name(WEN)+" infiziert!"));
  
  
 tell_object(opfer, BS(   
 "Ein Zombie namens "+CAP_TPN+" springt Dich an und "
    " schlaegt "+TP->QueryPossPronoun(FEMALE, WEN, PLURAL)+" faulen Zaehne in Deinen Hals!!! "  
  "Erschrocken zuckst Du zusammen!!! Was das wohl zu bedeuten hat?!"));                 
  opfer->AddPoison(random(2));//nur mehr zufaellig
 
 
  return 1; }

if(!interactive(opfer))  {
	write(BS(
"Du kannst doch Netztote nicht einfach so beissen und infizieren!!!"));
return 1;  }
	




return 0;}
 






z1()  {
  
if (check_remove())
  return;

pla=environment(TO);
raum=environment(pla);


old_presay=pla->Query(P_PRESAY);     // gefixed [Hotaru, 24.06.02]
old_extralook=pla->QP(P_EXTRA_LOOK);


 tell_object(pla, 
  "Irgendwie fuehlst Du Dich nicht gut. Was koennte das sein?!\n");

  tell_room(raum,
  EN(WER)+" fuehlt sich irgendwie nicht gut. Was hat "+EN(WER)+" bloss?\n",
  ({pla}));
  
  call_out("z2", T1);
}



 z2()  {
 
 if (check_remove())
   return;
   raum=environment(pla);
 tell_object(pla, BS(
 "Es kribbelt und juckt Dich unter der Haut. Du kratzt Dich!!!"));
    tell_room(raum, BS(
  EN(WER)+" kratzt sich bis "+EN(WER)+" blutet. Irgendetwas stimmt da nicht!"),
  ({pla}));
  
  call_out("z3", T1);
}

 z3()  {
 
 if (check_remove())
   return;
   raum=environment(pla);
 tell_object(pla, BS(
"WAHHHH!!! Unter Deiner Haut scheint sich etwas zu bewegen. "
"Ein Wurm? Eine Schlange? Du geraetst in Panik!")); 

 tell_room(raum, BS(
  EN(WER)+" starrt wie gebannt auf "+EN(WESSEN)+" Hand. "
  "Irgendetwas scheint da zu sein. Scheinbar passiert etwas Geheimnissvolles "
  "mit "+EN(WER)+"!"),
  ({pla}));
  call_out("z4", T1);
}

 z4()  {
 
 if (check_remove())
   return;
   raum=environment(pla);
tell_object(pla, BS(
"PLOPP!!! Ploetzlich entstehen Beulen auf Deinen Armen und Beinen!!!"
" Was ist nur mit Dir los?! Was hast Du nur?! Musst Du sterben?!"));
 tell_room(raum, BS(
  EN(WER)+" hat ploetzlich ueberall Beulen, die furchtbar stinken!!!"),
  ({pla}));
  call_out("z5", T1);
}



 z5()  {
 
 if (check_remove())
   return;
   raum=environment(pla);
tell_object(pla, BS(
"Deine Haut scheint sich zu verfaerben. Sie wird schwarz und grau. "
"Teilweise schrumpft sie ein, teilweise wird sie alt und trocken. "
"Du siehst bereits ekelerregend aus! Was veraendert Dich nur so!"));

 tell_room(raum, BS(
  EN(WER)+" schreit verzweifelt auf. Die Haut von "+EN(WEM)+" "
  "scheint zunehmends zu verfaulen. Ueberall Beulen und Risse. "
  "Irgendwie scheint "+EN(WER)+" sich zu veraendern. Ekelerregend!"),
  ({pla}));

    call_out("z6", T1);
}





z6()  {
 
 if (check_remove())
   return;
   raum=environment(pla);
tell_object(pla, BS(  
"Deine Gesichtshaut zerrt und zieht irgendwie. Du scheinst irgendwie "
"zu mutieren. In Deinem Bauch bewegt sich etwas. Dir wird uebel und "
"Du musst Dich uebergeben. Scheinbar hast Du irgendeine seltsame "
"Krankheit, die Dich zu entstellen beginnt!"));

 tell_room(raum, BS(
  EN(WER)+" schaut Dich an und Du erschrickst! "+EN(WESSEN)+" Gesicht "
  "ist schrecklich entstellt. Ueberall Beulen und faules Gewebe. "
  "WAEH!!! "+EN(WER)+" greift sich an den Bauch und uebergibt sich dann!"
  "Irgendwie scheint es als ob "+EN(WER)+" mutiert. Nur warum? Und "
  "was soll daraus entstehen?!"),
  ({pla}));
  
    call_out("z7", T1);
}

z7()  {
 
 if (check_remove())
   return;
   raum=environment(pla);
  domainshout(BSA(
    "Hilfe! Ich verfaule! Was ist nur mit mir los?! Ich mutiere zu einem Zombie!",
  EN(WER)+" ruft verzweifelt: "));

tell_object(pla, BS(
"Dein Kopf scheint sich auch schon zu verformen. Deine Haut "
"scheint nur mehr faules Fleisch zu sein! Voellig verzweifelt "
"rufst Du laut um Hilfe!"));

 tell_room(raum, BS(
  EN(WER)+" greift sich an den Kopf, und der Kopf "
  "scheint sich zu verformen. Beulen ueberall! "+EN(WER)+" sieht "
  "nun schon sehr veraendert aus! "+EN(WER)+" sieht, hmm, "+EN(WER)+", "
  "sieht fast wie ein...NEIN! Das kann und darf nicht sein!!! "
  "Die Haut von "+EN(WER)+" sieht voellig verfault aus. Eklig!"),
  ({pla}));

   call_out("z8", T1);
}

z8()  {
 
 if (check_remove())
   return;
   
  raum=environment(pla);
tell_object(pla, BS(
"PLOPPP!!! PLOPP!!! Und wieder wachsen Beulen aus Deiner Haut heraus! "
"Sie stinken furchtbar und scheinen zu eitern! Das stinkende Sekret "
"rinnt an Dir herunter und verbrennt Deine Haut. Und nun kommt Dir eine "
"schreckliche Ahnung! Koennte Deine Erkrankung etwas mit Deinem "
"Aufenthalt auf der Zombieinsel zu tun haben?!"));

 tell_room(raum, BS(
  "PLOPPP!!! PLOPPP!!! Beulen wachsen aus "+EN(WESSEN)+" Haut "
  "heraus! Sie stinken furchtbar und scheinen zu eitern! Das stinkende "
  "Sekret rinnt an der Haut von "+EN(WER)+" herunter. WAEHHHH!!!! "
  "Was fuer eine boesartige Krankheit hat "+EN(WER)+" wohl?! Irgendwie "
  "erinnert Dich das ganze an einen Zombie?!"),
  ({pla}));
    call_out("z9", T1);   }

z9()  {
 
 if (check_remove())
   return;
   
raum=environment(pla);
tell_object(pla, BS(
"Deine Haut verfault weiter und Du hast Angst vor Dir selbst. "
"Selbstmord waere eine Loesung?! Aber was passiert nur mit Dir?!"
" Irgendwie steigt die traurige Gewissheit in Dir auf, dass Du "
"den beruechtigten, verfluchten Zombievirus in Dir hast! PLOPPP!!!"
" Diesmal waechst eine Beule genau aus Deiner Nase heraus! "
"Deine Finger werden immer fetter und unfoermiger! Du bist bereits "
"eine ekelerregende Kreatur!"));

 tell_room(raum, BS(
  EN(WER)+" verfault langsam! Beulen wachsen aus "+EN(WESSEN)+" "
  "Nase heraus. Vor Dir steht eine ekelerregende, verfluchte Kreatur "
  "die frueher einmal "+EN(WER)+" war! Mit Grausen wendest Du Dich ab "
  "und kotzt! Die Finger von "+EN(WER)+" werden unfoermig und verwachsen "
  "irgendwie. WAEHHHHH!!!"),
  ({pla}));
    call_out("z10", T1);
}


z10()   {
 
 if (check_remove())
   return;
   raum=environment(pla);
tell_object(pla, BS(
   "Du bist Dir nun sicher. Es kann nur der verfluchte Zombievirus "
   "sein! Was sonst koennte Dich so entstellen! Du bekommst Angst "
   "vor dem was nun passieren wird. Deine Gedanken werden sich Deinem "
   "ekligen Aeusseren anpassen und Du wirst gnadenlos Deine "
   "ehemaligen Mitspieler angreifen! Bis in den Tod!!!"));

 tell_room(raum, BS(
   EN(WER)+" ist am verfluchten Zombievirus erkrankt. "+EN(WER)+" wird nun "
   "immer weiter mutieren, bis zum totalen Zombie! Die Gedanken "
   "mutieren mit und so wird "+EN(WER)+" zu einer boesartigen "
   "Mordmaschine werden, die sich gnadenlos auf Dich stuerzen wird! "
   "Du solltest besser das Weite suchen oder "+EN(WER)+" sofort toeten!"),
   ({pla}));
   call_out("z11", T1);
}

z11()  {
 
 if (check_remove())
   return;
   raum=environment(pla);
tell_object(pla, BS(
  "Deine Krankheit hat nun bereits ein sehr kritisches Stadium "
  "erreicht. Bald wirst Du zerfallen und Dich nicht mehr "
  "kontrollieren koennen!!!"));
  
 tell_room(raum, BS(
  EN(WER)+" ist nun schon schwer am Zombievirus erkrankt! "
  "Nun kann keiner "+EN(WER)+" mehr retten! Bete!!!"),
  ({pla}));
  call_out("repeat", T1);
  }
  
  
  
  
repeat()  {
	object ob, en;
     object sto;
     int i;
      object *inv;
	
	
 
 if (check_remove())
   return;
   
	raum=environment(pla);
if((pla->QueryProp(P_PRESAY)!=("Ein Zombie namens"))  ||
  (pla->QueryProp(P_EXTRA_LOOK)!=(" ist zu einem verfaulten, ekligen Zombie mutiert!")))          
  
  {	
pla->SP(P_PRESAY, "Ein Zombie namens");
pla->SP(P_EXTRA_LOOK, BS(
EN(WER)+" ist zu einem verfaulten, ekligen Zombie mutiert!"));

//pla->SP(P_ALIGN, -1000);
      }


switch(random(21))  {
 if (check_remove())
   return;
tell_object(pla, BS(
"Du hast grosse Lust Irgendetwas oder Irgendjemanden anzufallen!!! <syntax: zombieattacke name>"));
	
case 0:
 if (check_remove())
   return;	
tell_object(pla, BS(
   "AHHHH!!! Irgendetwas in Deinem Hirn "
  "befiehlt Dir Dich selbst zu verletzen!!! AUAAA!!! Du stichst "
  "Dir in Deine eigene Hand!"));
  pla->do_damage(10);
  
tell_room(raum, BS(
  "Ein Zombie namens "+EN(WER)+" sticht sich bruellend in die eigene Hand!!!"),
  ({pla}));
  break;
 
 
 
 case 1:
  if (check_remove())
   return;
 ob=clone_object("/d/wasser/dante/zinsel/obj/zobj");
 ob->SP(P_SHORT, "Ein Teil von "+pla->name(WESSEN)+" Hand"); 
 ob->SP(P_NAME, "Teil von "+pla->name(WESSEN)+" Hand");
 ob->AddId(({"hand","teil"}));
 ob->SP(P_NAME_ADJ, "halbverfault");
 ob->SP(P_GENDER, MALE);
 ob->SP(P_LONG, BS("Das ist ein Teil der ehemaligen Hand von "+EN(WEM)+"! "
 "Sie stinkt gewaltig. Wuermer kriechen bereits in ihr herum. "+EN(WER)+" ist "
 "an einem Zombievirus erkrankt und verfault nun langsam und mutiert "
 "zu einem Zombie."));
 ob->move(raum, M_NOCHECK);
tell_object(pla, BS(
 "Deine Hand zuckt und juckt ploetzlich sehr stark. Ploetzlich reisst "
 "es Dich herum und ein kleiner Teil Deiner Hand faellt ab. WAEHH!!!"));
 pla->do_damage(10);
 

tell_room(raum, BS(
 "Ein Zombie namens "+EN(WER)+" zuckt ploetzlich zusammen und schreit laut auf! Dann siehst "
 "Du wie ein kleiner Teil von "+pla->name(WESSEN)+" Hand zu Boden faellt! WAEHH!!!"),
 ({pla}));
 break;
 
 case 2:
  if (check_remove())
   return;
  ob=clone_object("/d/wasser/dante/zinsel/obj/zobj");
 ob->SP(P_SHORT, "Ein Teil von "+pla->name(WESSEN)+" Ohr"); 
 ob->SP(P_NAME, "Teil von "+pla->name(WESSEN)+" Ohr");
 ob->AddId(({"ohr","teil"}));
 ob->SP(P_NAME_ADJ, "halbverwest");
 ob->SP(P_GENDER, NEUTER);
 ob->SP(P_LONG, BS("Du siehst hier einen Teil von "+pla->name(WESSEN)+" Ohr! "
 "Es scheint wohl abgefault zu sein, so halbverwest wie es aussieht. "
 "Hmm, der gesuendeste scheint "+EN(WER)+" ja nicht zu sein! Irgendwie scheint "+EN(WER)+" ein Zombie zu sein!"));

 ob->move(raum, M_NOCHECK);
tell_object(pla, BS( 
"AHHH!!! Dein Ohr beginnt zu pulsieren!!! Irgendetwas scheint darin "
"zu sein! Wie irr reisst Du daran herum! RSCHHHH!!! Schon liegt ein "
"Teil davon am Boden!"));

 pla->do_damage(10);
 
tell_room(raum, BS(
"Ein Zombie namens "+EN(WER)+" reisst wie irr an "+pla->QueryPossPronoun(NEUTER, WEM, SINGULAR)+" Ohr herum! RSCHH!!! "
"Schon liegt ein Teil des verfaulten Ohres am Boden!! WAEHHH!!!"),
({pla}));
 break;
 
 
 case 3:
  if (check_remove())
   return;
  ob=clone_object("/d/wasser/dante/zinsel/obj/zobj");
 ob->SP(P_SHORT, "Ein Hautfetzen von "+pla->name(WEM)+""); 
 ob->SP(P_NAME, "Hautfetzen von "+pla->name(WEM)+"");
 ob->AddId(({"hautfetzen","fetzen","haut"}));
 ob->SP(P_GENDER, MALE);
 ob->SP(P_NAME_ADJ, "stinkend");
 ob->SP(P_LONG, BS("Das ist ein Fetzen aus der Haut von "+EN(WEM)+"! "
 "Er stinkt und scheint schon halbverfault zu sein. Wie kommt "
 "der bloss hier her?!  Hat es was mit der Zombieinsel zu tun?"));
 ob->move(raum, M_NOCHECK);
 
tell_object(pla, BS(
"PLOPPP! PLOPP!! Wieder schiessen Eiterbeulen aus Deiner Haut! Teile "
"Deiner halbverwesten Haut loesen sich und fliegen zu Boden!"));
 pla->do_damage(10);
 
tell_room(raum, BS(
"PLOPP!!! PLOPP!! Ploetzlich schiessen Eiterbeulen aus "+EN(WESSEN)+""
" Haut! Ein Zombie namens "+EN(WER)+" schaut entsetzt und Du bemerkst wie sich Teile "
"der Haut von dem Zombie, frueher bekannt als "+EN(WER)+", abloesen und zu Boden fallen!"),
({pla}));
 break;
 
 
 case 4:
  if (check_remove())
   return;
  ob=clone_object("/d/wasser/dante/zinsel/obj/zobj");
 ob->SP(P_SHORT, "Ein Teil von "+pla->name(WESSEN)+" Nase"); 
 ob->SP(P_NAME, "Teil von "+pla->name(WESSEN)+" Nase");
 ob->AddId(({"nase","teil"}));
 ob->SP(P_GENDER, NEUTER);
 ob->SP(P_NAME_ADJ, "nekrotisch");
 
 ob->SP(P_LONG, BS("IGITT!! Das ist ein Teil der verfaulten, abgestorbenen Nase von "
""+EN(WEM)+"! Faules Gewebe, das eklig anzusehen ist, lacht Dich an! Irgendwie zomboes!")); 
 ob->move(raum, M_GO);

tell_object(pla, BS(
"Der Druck in Deinem Hirn nimmt zu! Irgendeine Stimme befiehlt Dir "
"Dir Deine faule, eklige Nase anzuschneiden!!!! AHHHHHHH! Schon "
"liegt ein Teil davon am Boden!"));
 pla->do_damage(10);
 
tell_room(raum, BS(
"Ein Zombie namens "+EN(WER)+" reisst wie irr an "+pla->QueryPossPronoun(FEMALE, WEM, SINGULAR)+" Nase herum! "
"Dann nimmt "+pla->QueryPronoun(WER)+", der Zombie, allen Mut zusammen und schneidet sich einen Teil davon ab!"),
({pla}));

 break;
 

 
 case 5:
  if (check_remove())
   return;
  ob=clone_object("/d/wasser/dante/zinsel/obj/zobj");
 ob->SP(P_SHORT, "Ein Haarbueschel von "+pla->name(WEM)+""); 
 ob->SP(P_NAME, "Haarbueschel von "+pla->name(WEM)+"");
 ob->AddId(({"haar","bueschel","haare","haarbueschel"}));
 ob->SP(P_GENDER, NEUTER);
 ob->SP(P_NAME_ADJ, "eitrig");
 
 ob->SP(P_LONG, BS(
"WAEHH! Du hast gerade ein eitriges Haarbueschel von "+pla->name(WEM)+""
" in der Hand! Es muss "+pla->QueryPronoun(WEM)+" wohl vom "
" Kopf gefallen sein!"));
 ob->move(environment(pla), M_GO);
 
 tell_object(pla, BS(
"Dein Kopf brummt und die Schmerzen sind unertraeglich! Irgendetwas "
"pulsiert brutalst darin! Verzweifelt reisst Du Dir ein Haarbueschel aus!"));
 pla->do_damage(10);
 
tell_room(raum, BS(
"Ein Zombie namens "+EN(WER)+" reisst wie irr an "+pla->QueryPossPronoun(MALE, WEM, PLURAL)+" Haaren herum! "
"Dann nimmt "+pla->QueryPronoun(WER)+", der Zombie, allen Mut zusammen und reisst sich ein Haarbueschel aus! "
"Du solltest Dich wohl besser von "+EN(WER)+" fern halten!"), 
({pla}));
 break;


 
 case 6..12:
 if (check_remove())
   return;
tell_object(pla, BS(
"Mordgierig schaust Du Dich in Deiner Umgebung um! Dein Zombiewesen "
"wuerde ja so gerne einen Spieler umbringen! Aber..."));

tell_room(raum, BS(
"Ein Zombie namens "+EN(WER)+" schaut Dich mordgierig an! Scheinbar wuerde"
" "+pla->QueryPronoun(WER)+" Dich gerne umbringen! Hau lieber ab!!!"),
({pla}));

if(!environment(TO))  {
	call_out("remove", 0);
  return;}
	
             inv=all_inventory(environment(pla));
             
             if(!sizeof(inv))  { 
             	 tell_object(pla, BS(
             	 "Verflucht! Kein anderer Spieler in Deiner Naehe!!!"));
             	return;  }
             
             
              for(i=sizeof(inv)-1;i>=0;i--) if(interactive(inv[i]))  {
             
             if(getuid(inv[i])!= getuid(pla) )  {
             
             tell_object(pla, BS(
             "Du schlaegst "+inv[i]->name(WEM)+" voll ins Gesicht und "
             "lachst dann irr auf!"));
             
             tell_object(inv[i], BS(
     "Ein Zombie names "+EN(WER)+" schlaegt Dir voll ins Gesicht und "
     "lacht sich dann tot! AUA! Verschwinde lieber!!!"));
      inv[i]->do_damage(10+random(10)) ;
            }
                                                                }


 break;
 
  
 case 13..14:
  if (check_remove())
   return;
 tell_object(pla, BS(
 "Es sticht ploetzlich stark in Deinem Auge! AHHH!!! Das ist nicht "
 "auszuhalten! Du rammst Dir Deine Daumen in die Augen!!! AHHHHHHHH"));
 pla->SP(P_BLIND, random(5));



 tell_room(raum, BS(
 "Ein Zombie namens "+EN(WER)+" bruellt vor Schmerzen laut auf und rammt sich beide Daumen "
 "brutal in die eigenen Augen!! AHHHHHH!!!"),
 ({pla}));
 break;




 
 case 15..16:
  if (check_remove())
   return;
 tell_object(pla, BS(
 "Der Druck in Deinem Kopf wird immer staerker. WAHHH!!! Verzweifelt "
 "schleuderst Du alles was Du besitzt weit von Dir!"));
 
 pla->command("wirf alles weg");
 
 tell_room(raum, BS(
 "Ein Zombie namens "+EN(WER)+" bruellt vor Schmerzen laut auf und wirft alles was "+pla->QueryPronoun(WER)+""
 " besitzt weit weg!"),
 ({pla}));
 break;
 
case 17..18:
 if (check_remove())
   return;
tell_object(pla, BS(
"AHHH! Du verzweifelst schoen langsam! Du wirst nun sicher zu einem "
"Zombie mutieren und Deine Mitspieler werden Dich zu Tode "
"hetzen und schliesslich brutal erschlagen! Verzeifelt bruellst "
"Du laut auf!"));

if(!random(5)) {
domainshout(BS(""+CAP(getuid(pla))+" ruft verzeifelt: AHHH!!! Ich mutiere zu einem Zombie!"));
}


tell_room(raum, BS(
"Ein Zombie namens "+EN(WER)+" bruellt verzweifelt laut auf und fault weiter!"));
break; 
 
 
 case 19:
	 if (check_remove())
   return;
tell_object(pla, BS(
   "AHHHH!!! Irgendetwas in Deinem Hirn "
  "befiehlt Dir Dich selbst zu verletzen!!! AUAAA!!! Du stichst "
  "Dir in Deinen eigenen Fuss!"));
  pla->do_damage(10);
  
tell_room(raum, BS(
  "Ein Zombie namens "+EN(WER)+" sticht sich bruellend in den eigenen Fuss!!!"),
  ({pla}));
  break;
 
 case 20:
	 if (check_remove())
   return;
tell_object(pla, BS(
   "AHHHH!!! Irgendetwas in Deinem Hirn "
  "befiehlt Dir Dich selbst zu verletzen!!! AUAAA!!! Du stichst "
  "Dir in Deinen eigenen Bauch!"));
  pla->do_damage(10);
  
tell_room(raum, BS(
  "Ein Zombie namens "+EN(WER)+" sticht sich bruellend in den eigenen Bauch!!!"),
  ({pla}));
  break;
 
 
 
  default:
   if (check_remove())
   return;
tell_object(pla, BS(

   "AHHHH!!! Irgendetwas in Deinem Hirn "
  "befiehlt Dir Dich selbst zu verletzen!!! AUAAA!!! Du stichst "
  "Dir in Deine eigene Hand!"));
  pla->do_damage(10);
  tell_room(raum, BS("Ein Zombie namens "+EN(WER)+" sticht sich bruellend in die eigene Hand!!!"));
}
 if (check_remove())
   return;
call_out("repeat", T2);
}


void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
  if(victim == ENV(ME)) {
    call_out("remove", 0);
  }
  return ;
}
