//dante sl 99


inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein morsches Holzbein");
  SetProp(P_LONG,BS(
"Dieses Holzbein gehoerte einst dem einbeinigen Geisterkapitaen. "
"Es besteht aus morschem Holz, trotzdem gefaellt es Dir aber. "
"Ob es Dir passt?"));
   SP(P_NAME_ADJ, "morsch");
  SP(P_MAGIC, 1);
  SetProp(P_VALUE,3000);
  SetProp(P_WEIGHT,100);
  SP(P_NOBUY, 1);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Holzbein");
  SetProp(P_MATERIAL, ([MAT_OAK:50, MAT_MISC_MAGIC:50]));
  SetProp(P_INFO, BS(
 "Du kannst das Bein ja einmal anprobieren..."));  
  AddId(({"holzbein","bein"}));
ACD(({"probiere","probier"}), "check");
}

int check(string str)  {
	NF("Was willst Du anprobieren?!\n");

if(str=="bein an"||str=="holzbein an")  {
	write(BS(
	"Du probierst das Holzbein an!"));
	
	  if(TP->FindPotion())  {
write("\nDas Holzbein verwandelt sich in einen Zaubertrank! WOW\n");
           remove();
          return 1; }
   
   else {
   	
   write(BS(
  "Das Holzbein leuchtet hell auf und ist dann auf einmal weg."));
   
    if(TP->QP(P_POISON))  {
    	write(BS(
    "Deine Vergiftung ist verschwunden!"));
    TP->AddPoison(-4-random(7));	
    remove(); 
    return 1; }
    
   else {
   	
   write(BS(
   "Waerest Du vergiftet gewesen, haette Dich das Holzbein geheilt."));
   remove();
   return 1; }
   return 0; }
  return 0; }
    return 0; }
    