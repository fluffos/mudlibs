inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <thing.h>

string wer="";
int wieviele=0;

create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Ein sagenhafter Knochen");
  SetProp(P_LONG, BS(
"Das ist einer der sagenhaften Knochen die angeblich von einem der Zombiegoetzen "
"stammen. Es ist das Erkennungszeichen aller Zombiejaeger. Er wird bei der "
"Aufnahmezeremonie persoenlich erschaffen und verliehen. Wenn er nicht genau auf "
"Dich abgestimmt ist, ist er fuer Dich nichts wert. Dieser Knochen gehoerte einst "
"einem "+wer+". Er weist "+wieviele+" Kerben auf!"));

AD(({"kerben","kerbe"}), 
"Die Kerben zeigen an wieviele Zombies der urspruengliche Besitzer erschlagen hat!");



  AddId(({"zombiegoetzenknochen", "zombieknochen","goetzenknochen",
  "ZGK","knochen"}));
  SetProp(P_NAME,"Zombiegoetzenknochen");
  SP(P_NAME_ADJ, "sagenhaft");
  SetProp(P_GENDER,MALE);
  SP(P_VALUE, 1000);
  SP(P_WEIGHT, 20);
  SP(P_MAGIC, 1);
  SetProp(P_MATERIAL,([MAT_BONE:90, MAT_MISC_MAGIC: 10]));
}


set_owner(wer, wieviele)  { 
	 SetProp(P_LONG, BS(
"Das ist einer der sagenhaften Knochen die angeblich von einem der Zombiegoetzen "
"stammen. Es ist das Erkennungszeichen aller Zombiejaeger. Er wird bei der "
"Aufnahmezeremonie persoenlich erschaffen und verliehen. Wenn er nicht genau auf "
"Dich abgestimmt ist, ist er fuer Dich nichts wert. Dieser Knochen gehoerte einst "
"einem "+wer+". Er weist "+wieviele+" Kerben auf!"));

}


