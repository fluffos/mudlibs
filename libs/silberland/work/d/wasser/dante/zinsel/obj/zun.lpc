
inherit "std/food";
#include <properties.h>
#include <food.h>
#include "/players/dante/myowndefine.h"

int s, w, f, z, x;
string *zubereitung;
string *spezial;
string *was;
string *farbe;

void create()
{
  if (!is_clone(ME)) return;
  ::create();


  zubereitung=({
      "gebraten","gekocht","roh","tranchiert","frittiert",
      "gebacken","gegrillt","geduenstet","halbroh"});

  spezial=({
      "(am Spiess)","(gerollt)", "(klein gehackt)","(passiert)",
      "(gewuerfelt)","(in Streifen)", "(in einem Stueck)", 
      "(im Senfteig)",
      "(zweigeteilt)","(viergeteilt)","(zerquetscht) (im Bierteig)"});

  was=({
      "Hauskatzenzunge","Perserkatzenzunge","Siamkatzenzunge","Jungkatzenzunge",
      "Babykatzenzunge"});
  farbe=({
      "braun","weiss","schwarz","grau","semmelfarben","rot",
      "gefleckt","gestreift","gepunktet","getigert"});


  s=random(sizeof(spezial));
  w=random(sizeof(was));
  f=random(sizeof(farbe));
  z=random(sizeof(zubereitung));

  SetProp(P_SHORT, "Eine "+zubereitung[z]+"e, "+farbe[f]+"e "+was[w]+" "+spezial[s]+"");
  SetProp(P_LONG, BS(
        "Das ist eine "+zubereitung[z]+"e, "+farbe[f]+"e "+was[w]+" "+spezial[s]+"! "
        "AHHHH! Eine leckere Katzenzunge. Die Zungen werden den Katzen bei lebendigem "
        "Leib von Zombies herausgerissen und dann tief unter der Insel zubereitet! "
        "Lecker , lecker! Greif zu!"));


  SetProp(P_NAME, was[w] );
  SetProp(P_NAME_ADJ, zubereitung[z]);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"katzenzunge", "zunge", lower_case(was[w])}) );
  AddAdjective( ({zubereitung[z]+"e", zubereitung[z]}) );
  AddId("PB_PERMISSION");


  SetProp(P_VALUE,  30);
  SetProp(P_WEIGHT, 10);
  SetProp(P_NOBUY, 0);
  SetProp(P_MATERIAL, ([MAT_FOOD:100]));
  x=1+random(3);
  SetProp(P_FOOD_INFO, ([F_HEAL: (7+x), F_SOAK: (2+x/2), F_ALCOHOL: 0, F_POISON:0]));
}

BeimEssen()
{
  write ( BS(
        "Du frisst die "+zubereitung[z]+"e, "+farbe[f]+"e "+was[w]+" "+spezial[s]+" mit" 
        " lautem Schmatzen auf!"));
  say (BS(
        CAP_TPN+" verspeisst eine "+zubereitung[z]+"e, "+farbe[f]+"e "+was[w]+" "+spezial[s]+" "
        " mit lautem Schmatzen auf und will mehr davon!"));

  return ::BeimEssen();
}
