
//dante sl 99

inherit "std/unit";

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <wizlevels.h>

#define LOG   "/d/wasser/dante/zinsel/save/tropfen"

 object ob;

void _set_autoloadobj( mixed args )
{
  if (pointerp(args))
        args=args[0];
         if (stringp(args))
          sscanf(args,"%d",args);
           if (!intp(args))
              args=0;
      SetProp(P_AMOUNT,args);
}                      



                      
int _query_autoloadobj()

{     
  return (int) QueryProp(P_AMOUNT);
        }
                           
void create()
{
   
  if (!is_clone(this_object()))
    return;
   
  ::create();

    ob=previous_object();
    write_file(LOG, 
      dtime(time())+": Clonen der Tropfen "
      +"von "+CAP(getuid(ob))+" anzahl: "+TO->QP(P_AMOUNT)+"\n");

  SetProp(P_NAME, ({"Zombiegoetzenblutstropfen"}));
  SetProp(P_NAME_ADJ, "bunt");
  
  SetProp(P_SHORT,"Zombiegoetzenblutstropfen");
  SetProp(P_MATERIAL, ([ MAT_BLOOD: 50, MAT_MISC_MAGIC:50 ]) );
  AddSingularId(({ "zombiegoetzenblutstropfen",
  "tropfen","blutstropfen","goetzenblutstropfen",
  "zombiegoetzenblutstropfen","DANTE_ZOMBIE_BLUT"}));
  
  AddPluralId(({"tropfen",
  "zombiegoetzenblutstropfen",
  "blutstropfen","goetzenblutstropfen","zombiegoetzenblutstropfen",
  "DANTE_ZOMBIE_BLUT"}));
  
 SP(P_LONG, BS(
 "Das ist einer der sagenumwobenen Zombiegoetzenblutstropfen! Er schillert "
 "bunt und irgendwie scheint er zu pulsieren. Er stammt von einem "
 "der brutalen Goetzen der Zombies, die ihn mit einem dunklen Kult auf"
 " der Zombieinsel huldigen. "
"Wer ihn sich geholt hat, muss ein wahrer Held sein!"));

 SP(P_INFO,BS(
 "Der Tropfen Blut hat die Magie sich mit anderen Tropfen "
 "zu vereinigen und grosses zu bilden! Doch nur "
 "ein wahrer Meister und Kenner der Zombiekulte kann dieses "
 "Wunder vollbringen und angeblich soll es auch nicht ganz ungefaehrlich sein "
 "diese magischen Objekte zu verwenden!"));
 
  SetProp(P_GENDER,MALE);
  SetCoinsPerUnits(1000,1); //halbiert nun
  SetGramsPerUnits(1,1);
 
}


   
