
inherit "std/thing";
inherit "std/npc";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <language.h>
//#include <npc.h>
#include "/players/dante/myowndefine.h"


	


create()
{
  if (!is_clone(this_object())) return;
  ::create();
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);

  SetProp(P_SHORT,"Ein magischer, eitriger Heulsusen-Regionsmagierinnen-Kadaver");
  SetProp(P_LONG, BS(
"Das ist ein magischer Kadaver. Er ist eitrig und stellt eine heulende, jammernde "
"Regionsmagierin dar. Er stinkt auch ein wenig. Irgendwie kommt Dir vor, als jammere "
"er noch immer. Was er wohl kann?"));

SP(P_INFO, "Heulsuse doch...bei der Koenigin der laecherlichen Feen...\n");

  AddId( ({"kadaver"}) );
  SetProp(P_NAME,"Heulsusenkadaver");
  SP(P_NAME_ADJ, ({"magisch", "eitrig"}));
  SetProp(P_GENDER,MALE);
  SP(P_MATERIAL, ([MAT_MISC_DEAD:50 , MAT_MISC_MAGIC:50]));
  SetProp(P_WEIGHT,5);
  SP(P_VALUE, 100);

 ACD(({"heulsuse"}), "transform_the_wichtel");
}

int transform_the_wichtel()  {
	object ob;
	ob=present("feenkoenigin", environment(TP));
if(!ob)  {	
write(BS(
"Du heulsust wie eine echte Regionsmagierin, aber nichts passiert..."));
say(BS(
CAP_TPN+" heulsust herum..."));

return 1; }

if(ob)
 {
	write(BS(
"Du heulsust wie eine echte Regionsmagierin und ploetzlich springt die laecherliche Feenkoenigin "
"wie irr vor Dir herum und wirft sich auf den Boden! WUMMMMM!!! Nebel, Staub , Laerm. "
"Und dann ist sie ploetzlich etwas anders...Aber sieh besser selbst..."));

say(BS(CAP_TPN+" heulsust wie eine echte Regionsmagierin herum und plotzlich springt "
"die laecherliche Feenkoenigin "
"wie irr vor Dir herum und wirft sich auf den Boden! WUMMMMM!!! Nebel, Staub , Laerm. "
"Und dann ist sie ploetzlich etwas anders...Aber sieh besser selbst..."));

ob->SP(P_NAME, "Zombiefeenkoenigin");
ob->SetProp (P_SHORT, "Die mutierte, eiternde Zombiefeenkoenigin");
ob->  SetProp (P_LONG,BS(
  "Die Zombiefeenkoenigin bereitet sich gerade auf das grosse "
  "Feenfressen vor. Jeden Monat bei Vollmond massakriert sie alle Feen "
  "und ihre Kadaver werden dann zu Zombiefeen. Wie ekelhaft. "
  "Sie ist etwas haesslicher als andere Zombies und wird von den "
  "echten Zombies auf der Zombieinsel nur verlacht."));

ob->SetChats(4, ({
  }) );

 SetChats(4, ({
"Die Zombiefeenkoenigin weint und jammert.\n",
"Die Zombiefeenkoenigin stinkt erbaermlich.\n",
"Die Zombiefeenkoenigin eitert herum. PFUI!\n",
"Die Zombiefeenkoenigin sagt: Dante ist der Meister!\n",
"Die Zombiefeenkoenigin kniet vor Dir nieder und jammert.\n",
"Die Zombiefeenkoenigin sagt: Ich komme nie wieder! NIE MEHR!\n"
  }) );

write("\n"
 "Der Kadaver explodiert.\n");
 
call_out("remove", 1);
return 1; }
return 0; }
				
