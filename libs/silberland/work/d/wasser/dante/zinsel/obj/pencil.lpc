inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
   
  SetProp (P_SHORT, "Ein Bleistift");
  SetProp (P_NAME, "Bleistift");

  SetProp (P_LONG,BS(
   "Mit diesem Bleistift verwirklichte einst ein Comiczeichner " 
   "seine Traeume. Doch auch er wusste den Bleistift wegen seiner harten Spitze als Waffe einzusetzen."));


   SetProp(P_GENDER, MALE);
  AddId (({"stift","bleistift"}));

SetProp(P_VALUE, 600);
   SetProp(P_WEIGHT, 50);
   SetProp(P_WEAPON_TYPE, WT_KNIFE);
   SetProp(P_DAM_TYPE, DT_PIERCE);
   SetProp(P_WC, 50);
   SetProp(P_WC_BONUS, (["comiczeichner":150]) );
   SetProp(P_NR_HANDS, 1);
   SetProp(P_MATERIAL,([MAT_STEEL:100]));
}
