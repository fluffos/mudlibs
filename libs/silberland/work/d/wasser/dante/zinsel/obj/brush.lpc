inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <weapon.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Pinsel");
  SetProp(P_LONG,"Mit diesem Pinsel verwirklichte einst ein Comiczeichner "
      "seine Traeume, aber auch er wusste den Pinsel als Waffe einzusetzen.");
  AddId(({"pinsel","pinsel eines Comiczeichners"}));
  SetProp(P_NAME,"Pinsel eines Comiczeichners");
  SetProp(P_GENDER, MALE);

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WC, 50);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_MATERIAL, ([MAT_OAK:100]));
}
