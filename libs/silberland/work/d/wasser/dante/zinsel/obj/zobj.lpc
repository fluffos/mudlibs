inherit "std/food";
#include <properties.h>
#include <moving.h>
#include <food.h>
#include <language.h>
#include "/players/dante/myowndefine.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SP(P_MAGIC, 1);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT, 10);
  AddId  (({"ZOMBIE_OBJ"}));
  SP(P_MATERIAL, ([MAT_MISC_DEAD:100]));
 SetProp(P_FOOD_INFO, ([F_HEAL: 5, F_SOAK: 1, F_ALCOHOL: 0,F_POISON: 0]));

}
	

BeimEssen()  {
write(BS(
"Du verschlingst einen "+QueryProp(P_NAME)+" mit einem Bissen!!! WAEHHH!!! Das war sicher nicht gesund!"));
say(BS(CAP_TPN+" verschlingt einen "+QueryProp(P_NAME)+" mit einem Bissen und schaut dann angeekelt drein!"));
return::BeimEssen();   }
	
	
reset()  {
	::reset();
	write(QueryProp(P_SHORT)+" zerfault gaenzlich...\n");	
	remove();
	}