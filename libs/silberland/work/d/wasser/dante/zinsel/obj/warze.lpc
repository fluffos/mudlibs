
#include "/players/dante/myowndefine.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

int try=15;

int aus;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine ekelige Warze");
  SetProp(P_LONG, BS( 
"Eine eklige Warze! Pfui! Wenn Du besonders ekelig bist, kannst Du sie ja "
"an einem Lebewesen reiben."));
  SetProp(P_NAME, "Warze");
  SP(P_NAME_ADJ, "ekelig");
  SetProp(P_GENDER, FEMALE);
  AddId(({"warze","\nwarze"}));
SP(P_KILL_NAME, "Eine ekelige Warze von der Zombieinsel");

  SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_SKIN:90]));
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 300+random(200));
  SetProp(P_NOBUY, 1);

  AddCmd(({"reibe","reib"}),"make_gnom");
}

int make_gnom(string str)  {
	string wer;
	object opfer, klon;
	NF("Woran willst Du die Warze reiben?!\n");
	if(!str) return 0;
	
	if(sscanf(str, "warze an %s",wer )!=1)  {
		return 0; }

      opfer=present(wer, environment(TP));
      
      
      
      
      if(!opfer)  {
      	write(BS(
      	"Leider ist "+CAP(wer)+" nicht in Deiner Naehe!"));
      	return 1; }
      		
/*       if(IS_WIZARD(opfer))  {
	tell_object(opfer,
	CAP_TPN+" wollte eine magische Warze an Dir reiben.\n");
	write(BS(
	"NEIN! "+opfer->name()+" ist zu maechtig!"));
	return 1;  }
*/
	
	
	if(TP->QP(P_SP) < 10 )  {
		write(BS(
		"Deine Magie ist zu schwach."));
		return 1; }
		
	
	if(try <= 0 )  {
	write(BS("Du musst Dich gedulden! Die Warzenmagie ist leer."));
		return 1;  }
	
	
	if(interactive(opfer) && getuid(opfer)==getuid(TP) )  {
		write(BS(
		"WAEH! So ekelhaft bist nicht einmal Du!"));
		return 1; }
		
	
	
if(try > 0 ) {
	aus++;
	try--;
	TP->AddSp(-5-random(6));
   write(BS(
	"Du reibst die magische Warze an "+opfer->name(WEM)+"!\n"));
	tell_object(opfer,
	CAP_TPN+" reibt eine magische Warze an Dir.\n");
	tell_room(environment(opfer),
	CAP_TPN+" reibt eine magische Warze an "+opfer->name(WEM)+"!\n",
	 ({opfer, TP}));
	
	
     switch(random(10))  {
	case 0..3:
      write(BS(
      "Leider passiert nichts."));
      tell_room(environment(opfer),
      "Es passiert nichts. "+TPN+" versagt.\n", ({TP}));
	break;
	case 4..5:
      write(BS(
      "Aus der Warze spritzt etwas Fluessigkeit, aber leider auf Dich. "
      "AHHH! Das brennt!"));
      TP->do_damage(10);
      tell_room(environment(opfer),
      CAP_TPN+" wird von Fluessigkeit, die aus der Warze spritzt getroffen.\n",
      ({TP}));	
      
	break;
	case 6..9:
	tell_room(environment(opfer),
	opfer->Name(WER)+" windet sich merkwuerdig.\nPloetzlich zischt es "
	"und Nebel entsteht.\nAus dem Nebel tritt eine Gestalt hervor.\n",
	({opfer}));
	tell_object(opfer,
	"Aus der Warze spritzt eine Fluessigkeit auf Dich. AUA!\nEs zischt und "
	"Nebel entsteht.\nAus dem Nebel entsteht eine Gestalt.\n");
	
	
	klon=clone_object("/d/wasser/dante/zinsel/npc/wgnom");
	
	klon->SP(P_NAME, opfer->name(RAW)+"-Warzengnom");
	klon->SP(P_SHORT, "Ein "+CAP(opfer->name(RAW))+"-Warzengnom");
	klon->SP(P_LONG, BS(
	"Vor Dir siehst Du eine wirklich ekelhafte Gestalt. Einen "
	"Warzengnom. Er stinkt furchtbar und ist ueber und ueber mit "
	"Warzen bedeckt. Trotzdem sieht er aber "+opfer->name(WEM)+" "
	"noch immer erstaunlich aehnlich."));
       klon->AddId( ""+lower_case(opfer->name(RAW))+"warzengnom",
                     ""+lower_case(opfer->name(RAW))+"-warzengnom");
                     klon->move(environment(TP), M_SILENT|M_NOCHECK);
                     
      	if(aus > 100 ) {
		write(BS(
		"Die Warze verfault."));
	remove(); }                     
       break;	
	
	default:
	  write(BS(
      "Leider passiert nichts."));
      tell_room(environment(opfer),
      "Es passiert nichts. "+TPN+" versagt.\n");
        }
      return 1;
      }
return 0; }








reset()  {
	::reset();
	try=10;
	
	}





string _query_info()  {
	
	if(try <=0 )  {
	return BS(
	"Du musst Dich gedulden! Die Warzenmagie ist leer.");
	}	
else
return BS(
         "Du hast noch "+try+" Versuch(e).");
                   }