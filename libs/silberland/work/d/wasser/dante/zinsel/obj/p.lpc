//dante sl 2000
//pakt mit dem teufel

inherit "std/thing";
#include <properties.h>
#include <moving.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <combat.h>

#define TIME 180

object ob;
int count=0;
int boese=1;

init() {
	::init();
if(!living(environment(TO)))  {
	remove();  }}
		


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SP(P_MAGIC, 1);
   SP(P_NEVERDROP, 1);
  SP(P_KILL_NAME, "Ein Pakt mit dem Teufel");
  SetProp(P_SHORT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT, 0);
  AddId  (({"TEUFEL_SEELE", "TS"}));

ACD(({"teufelspakt"}), "check");
ACD("test123", "test");
}

int test()  {

int i;	
string *w;
w=TO->QueryProp(P_IDS);	

write(""+boese+" boese\n"+count+" count\n");

for(i=0; i<sizeof(w);i++)  {
	
	write(""+w[i]+"\n"); }
return 1;
}


mixed _query_autoloadobj()
{
  return ({count, boese ,QueryProp(P_IDS) });
}
void _set_autoloadobj(mixed arg)
{
  if (sizeof(arg) > 1)
  {
    count=arg[0];
    boese=arg[1];
    AddId(arg[2]);
  }
}




 check()  {
 
if(boese==1)  {
  
  TP->SP(P_ALIGN, -500-(random(500)) );


  write(BS(
  "Du erneuerst Deinen Pakt mit dem Teufel und fuehlst wie die Macht des "
  "Boesen in Dir hochsteigt!"));

  tell_room(environment(TP),
  CAP_TPN+" erneuert den Pakt mit dem Teufel!\n", ({TP}));
  boese=0;

  return 1; }
    

    if(boese!=1)   {

    write(BSA(
    "Die Zeit ist noch nicht reif, etwas Geduld mein satanischer Freund!",
    "Der Teufel teilt Dir mit: "));
    
       return 1; } 
    return 1;}



reset()  
{
  ::reset();

if(!is_clone(TO))   { return;  }


  if(!environment(TO) || !interactive(environment(TO)))  
  {
    return;
  }

  boese=1;
  count++;
   
  if(count==1)   
  {
  if(!environment(TO) || !interactive(environment(TO)))  
  {
    return;

  }

tell_object(environment(TO),
"Ploetzlich erscheint ein Teufel vor Dir und sagt:\n");
    tell_object(environment(TO), BS(
      "Heil dem Boesen, "+environment(TO)->name(WER)+", es wird nun Zeit, dass Du zu mir kommst "
      "und mir huldigst! Du hast noch etwas Zeit, doch solltest Du daran "
      "denken, auch Deinen Teil des Handels beizutragen! Denk daran! Mir "
      "kannst Du nicht entkommen!"));
tell_object(environment(TO),
"Dann verschwindet der Teufel mit Knall und Schwefelrauch.\n");


   return;
  }

  if(count>1)  
  { //das nur zur sicherheit
tell_object(environment(TO),
"Ploetzlich erscheint ein Teufel vor Dir und sagt:\n");

    tell_object(environment(TO),BS(
      "Ich habe Dich gewarnt! Du aber wolltest nicht gehorchen! Nun eile, Du "
      "hast genau noch 3 Minuten um zu mir zu kommen und mir zu huldigen! Danach "
      "kenne ich keine Gnade mehr!"));
tell_object(environment(TO),
"Dann verschwindet der Teufel mit Knall und Schwefelrauch.\n");

    call_out("rache", TIME);
    AddId("rache");
  }        
}  
  
rache()  
{
  object ob;
  count=0;
  
      if(count!=0)  return;

  if(environment(TO)!=this_player())  
  {
  say(BS("1"));	
  write(BS("1"));
    return;
  }  
  
  if(!environment(TO) || !interactive(environment(TO))) 
  { 
  	write(BS("2")); say(BS("2"));
    return;
  }
  
  if(!TO->id("rache"))  
  { write(BS("3"));
  	 say(BS("3"));
    return; 
  }
  
  tell_object(environment(TO),
"Ploetzlich erscheint ein Teufel vor Dir und sagt:\n");
  
  tell_object(environment(TO), BS(        
    "Ich fordere meinen Teil des Paktes ein! Deine teuflische Seele wird "
    "Dich nun in den Tod hetzen! Alles ist zu spaet fuer Dich!!! Lass Dir "
    "das eine Lehre sein!"));
    
  tell_object(environment(TO),
"Dann verschwindet der Teufel mit Knall und Schwefelrauch.\n");
   
  
  
  ob=CLONEOB(ZN"tseele");

  ob->SP(P_NAME,  "Seele von "+CAP(getuid(TP))+"");
  ob->SP(P_NAME_ADJ, "teuflisch");
  ob->SP(P_ARTICLE, 1);
 
 
  ob->SP(P_GENDER, FEMALE);

  ob->SP(P_SHORT, "Die teuflische Seele von "+CAP(getuid(TP))+"");
  ob->SP(P_LONG, BS("Das ist die teuflische Seele von "+CAP(getuid(TP))+", denn "
    ""+TP->QueryPronoun(WER)+" hat sich nicht an einen Pakt mit "
    "dem Teufel gehalten und wird nun so bestraft! Mit dem Teufel spielt "
    "man eben nicht! Lass Dir das eine Lehre sein!"));

  ob->SP(P_ATTRIBUTES, TP->QP(P_ATTRIBUTES));
  ob->SP(P_LEVEL, TP->QP(P_LEVEL));
  //ob->SP(P_TOTAL_WC, TP->QP(P_TOTAL_WC)*2);
  
  ob->SP(P_BODY, TP->QP(P_LEVEL)*2);
  ob->SP(P_MAX_HP, TP->QP(P_MAX_HP)*2);
  ob->SP(P_TOTAL_AC, TP->QP(P_TOTAL_AC)*2);
  ob->move(environment(TP), M_TPORT,M_NOCHECK);
  ob->SP(P_ARTICLE, 1);
 RemoveId("rache"); 

  TP->AddPursuer(ob);

  ob->Kill(TP);
  return;
}
  
  
    
   gehuldigt()   {
   count=0;
  
   if(TO->id("rache"))  {
   RemoveId("rache"); 
           }
     }
   



