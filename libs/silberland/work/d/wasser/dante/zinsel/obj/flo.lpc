//dante sl 99

inherit "std/food";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <food.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Eine lange Haifischflosse");
  SetProp(P_LONG, BS(
        "Du hast eine Haifischflosse aus den Gewaessern rund um die Zombieinsel "
        "in Haenden. Man kann sie entweder essen, oder einfach verkaufen."));

  AddId( ({"flosse", "haiflosse", "haifischflosse", "PB_PERMISSION"}) );
  SetProp(P_NAME,"Haifischflosse");
  SetProp(P_NAME_ADJ, "lang");
  AddAdjective( ({"lang", "lange"}) );
  SetProp(P_GENDER,FEMALE);

  SetProp(P_MATERIAL, ([MAT_MISC_DEAD: 100 ]));
  SetProp(P_WEIGHT,40+random(40));
  SetProp(P_FOOD_INFO, ([ F_HEAL:10, F_POISON:0, F_SOAK:4, F_ALCOHOL:0]));
  SetProp(P_VALUE, 700);
}

BeimEssen()  
{
  write(BS(
        "Du verschlingst die ganze Flosse mit einem Bissen."));
  say(BS(
        CAP_TPN+" verschlingt eine Haifischflosse."));
  return::BeimEssen(); 
}

