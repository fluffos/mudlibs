//dante &nostromo sl 97 99

inherit "std/food";
#include <food.h>
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>

#define textlist ({ "Jemand oder etwas scheint hier nach verfaulten Eiern zu riechen.\n", \
 "Du haeltst Dir die Nase zu, um den Gestank nicht zu riechen.\n", \
 "Der Gestank von Eiern haelt sich penetrant in der Luft.\n", \
 "Es scheint als stinke es nach faulen Eiern.\n", \
 "Du musst Dich beinah uebergeben, als Du den Geruch von faulen Eiern wahrnimmst.\n", \
 "Es stinkt erbaermlich.\n", \
 "Du ueberlegst, ob Du nicht etwas gegen den widerlichen Gestank unternehmen solltest.\n", \
 "Igitt, dieser Gestank !! Einfach unertraeglich !!\n" \
                 });
 string *text;
 string str;
 string cstr;  

init()
{
  ::init();
  add_action("throw_it","wirf"); 
  add_action("ww", "ww");
}

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  text=textlist;
  SetProp(P_SHORT,"Ein Ei");
  SetProp(P_LONG,"Ein stinkendes, halbverfaultes Ei.\n");
  AddId(({"ei","faules ei","\nei"}));
  SetProp(P_NAME,"Ei");
  SetProp(P_NAME_ADJ, "verfault", "stinkendes", "faules");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_WEIGHT,20);
  SetProp(P_VALUE, 111);
  SetProp(P_MATERIAL,MAT_FOOD);
  SetProp(P_INFO, ("Es handelt sich hierbei um ein Ei, dass eindeutig seine besten Zeiten schon\n" 
  		   "hinter sich hat. Als Nahrung ist es nicht empfehlenswert.\n" 
  		   "Es koennte durchaus eine Magenverstimmung oder schlimmeres hervorrufen!\n"));
  SetProp(P_FOOD_INFO, ([F_HEAL: -10, F_SOAK: 5, F_ALCOHOL: 0, F_POISON:1]));		   
  SetProp(P_SMELL, ("Ein widerlicher Gestank stroemt von diesem Ei aus. Er steigt einem sofort in die Nase, und setzt sich dort fest.\n"));

  call_out("faulen",30+random(30));
}  

void faulen() 
{
  string thistext;
  thistext = text [ random(sizeof(text)) ];
  if(living(environment()))
    tell_object(environment(), thistext);
  else
    tell_room(environment(), thistext);
  call_out("faulen",5+random(5)); 
}

