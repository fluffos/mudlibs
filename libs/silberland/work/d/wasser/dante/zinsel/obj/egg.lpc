remove()
 {
   while (remove_call_out("faulen") != -1);
   return ::remove();
 }

*/

BeimEssen()
{
  write ("Du isst das stinkende Ei und bist Dir nicht sicher, ob das das richtige war.\n");
  say (TPN+" verspeisst das Ei unter graesslichen Gesichtsverrenkungen.\n");
  return ::BeimEssen();
}

ww(str)
{
  if (str)
    return throw_it("Ei nach "+str);
  else
  {
    object *all, *liv;
    int i;

    all=all_inventory(environment(this_player()));
    for (i=0; i<sizeof(all); i++)
      if (query_once_interactive(all[i]))
        if (!liv)
	  liv = ({all[i]});
        else
          liv = liv+({all[i]});
    i = random(sizeof(liv));
    return throw_it("Ei nach "+lower_case(liv[i]->query_real_name()));
  }
}

throw_it(str)
{
  int treffer;
  string victim_name,werfer_name;
  string victim_string,werfer_string;
  string was,at,wen;
  int fehler;
  object victim;

  if (!str) return 0;
  fehler = 0;
  if (sscanf(str,"%s %s %s",was,at,wen) != 3)
    fehler = 1;
  if (!id(was) || at != "nach")
    fehler = 1;
  if (fehler)
  { notify_fail("Zum Werfen: wirf Ei nach <spielername>\n");
    return 0;
  }
  victim = find_living(wen);
  if (!victim || !present(victim,environment(this_player())))
    { write("Der Gestank des Eies macht Dich anscheinend schon ganz dusselig, denn beim genaueren Umsehen erkennst Du, dass dieser Spieler gar nicht anwesend ist.\n");                                
      return 1;                                                                 
    }                                                                           
  victim_name = capitalize(victim->query_real_name());
  werfer_name = capitalize(this_player()->query_real_name());
  treffer = random(5);
  write("Du schmeisst ein verfaultes Ei nach " + victim_name +".\n");
  say(werfer_name + " wirft ein verfaultes Ei nach " + victim_name + ".\n");
  if (treffer==0)
  {
    werfer_string = "Das Ei fliegt an " + victim_name + " vorbei.\n";
    victim_string = werfer_name + " trifft Dich nicht.\n";
    this_object()->move(environment(this_player()));
  }
  if (treffer==1)
  {
    werfer_string = "Das Ei zerbricht an " + victim_name + "'s Koerper und besudelt die gesamte Kleidung.\n";
    victim_string = "Das Ei zerbricht an Deinem Koerper, und der Ei-inhalt verteilt sich af Deiner Kleidung.\n";
  }
  if (treffer==2)
  {
    werfer_string = "KLATSCH! Du triffst " + victim_name + " mitten ins Gesicht.\n";
    victim_string = "KLATSCH! Das Ei trifft Dich mitten im Gesicht!\n";
  }
  if (treffer==3)
  {
    werfer_string = "PATSCH! Das Ei trifft " + victim_name + "'s Nase mit voller Wucht - igitt!.\n";
    victim_string = "PATSCH! Das Ei fliegt mit voller Wucht gegen Deine Nase - igitt!.\n";
  }
  if (treffer==4)
  {
    werfer_string = victim_name + " versucht zu schreien, und kriegt dabei das Ei mitten in den Mund - waeh!.\n";
    victim_string = "Du versuchst zu schreien, und kriegst das Ei dabei mitten in den Mund - waeh!.\n";
  }
  write(werfer_string);
  tell_object(victim,victim_string);
  if (treffer) this_object()->move(victim);
  return 1;
}

reset()
{
  object ob;
  ob=MENV;
  if (ob && !interactive(ob))
  {
    if (ob->QueryProp(P_EXITS))
      tell_room (ob, "Das Ei zerfaellt.\n");
    remove();
  }
}
