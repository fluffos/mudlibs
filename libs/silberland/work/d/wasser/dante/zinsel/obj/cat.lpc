//eat the kat!

inherit "std/food";
#include <properties.h>
#include <food.h>
#include "/players/dante/myowndefine.h"

int s, w, f, z, x;
string *zubereitung;
string *spezial;
string *was;
string *farbe;



void create()
{
  if (!is_clone(ME)) return;
  ::create();


  zubereitung=({
      "gebraten","gekocht","roh","tranchiert","frittiert",
      "gebacken","gegrillt","geduenstet","halbroh"});

  spezial=({
      "(am Spiess)","(gerollt)", "(klein gehackt)","(passiert)",
      "(gewuerfelt)","(in Streifen)", "(in einem Stueck)", 
      "(im Senfteig)",
      "(zweigeteilt)","(viergeteilt)","(zerquetscht) (im Bierteig)"});

  was=({
      "Hauskatze","Perserkatze","Siamkatze","Riesenkatze","Wildkatze",
      "Wasserkatze","Dschungelkatze", "Babykatze","Schmusekatze"});
  farbe=({
      "braun","weiss","schwarz","grau","semmelfarben","rot",
      "gefleckt","gestreift","gepunktet","getigert"});


  s=random(sizeof(spezial));
  w=random(sizeof(was));
  f=random(sizeof(farbe));
  z=random(sizeof(zubereitung));

  SetProp(P_SHORT, "Eine "+zubereitung[z]+"e, "+farbe[f]+"e "+was[w]+" "+spezial[s]+"");
  SetProp(P_LONG, BS(
        "Das ist eine "+zubereitung[z]+"e, "+farbe[f]+"e "+was[w]+" "+spezial[s]+"! "
        "Eine wahre Spezialitaet! Ein Genuss! Dante bereitet sie mit grosser "
        "Freude zu! ISS SIE! Er faengt Katzen ein und ersaeuft sie dann in einem "
        "Tuempel im Dschungel! Dann schleppt er die stinkenden Kadaver in eine seiner "
        "Hoehlen tief unter der Zombieinsel und macht so leckeres daraus! Angeblich "
        "ist die geheime Zutat Zombieschleim..."));



  SetProp(P_NAME, was[w] );
  SetProp(P_NAME_ADJ, zubereitung[z]);
  SetProp(P_GENDER, FEMALE);
  AddId (({"katze", lower_case(was[w]) }));
  AddAdjective( ({zubereitung[z]+"e", zubereitung[z]}) );
  AddId("PB_PERMISSION");

  SetProp(P_INFO, BS(
        "HMMM!!!! Lecker!!! Diese Katze hat Dante zubereitet! ISS SIE!!!! SCHMATZ!"));

  SetProp(P_VALUE,  50);
  SetProp(P_WEIGHT, 100);
  SetProp(P_NOBUY, 0);
  SetProp(P_MATERIAL, ([MAT_FOOD:100]));
  x=1+random(6);
  SetProp(P_FOOD_INFO, ([F_HEAL: (7+x), F_SOAK: (2+x/2), F_ALCOHOL: 0, F_POISON:0]));
}

BeimEssen()
{
  write ( BS(
        "Du frisst die "+zubereitung[z]+"e, "+farbe[f]+"e "+was[w]+" "+spezial[s]+" mit" 
        " lautem Schmatzen auf!"));
  say (BS(
        CAP_TPN+" verspeisst eine "+zubereitung[z]+"e, "+farbe[f]+"e "+was[w]+" "+spezial[s]+" "
        " mit lautem Schmatzen auf und will mehr davon!"));

  return ::BeimEssen();
}
