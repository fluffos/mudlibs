//dante sl 99
/*
eine karte der zombieinsel.....


*/


inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Eine alte, verblichene Karte");
  SetProp(P_LONG, BS(
"Du hast eine alte, verblichene Karte der Zombieinsel in Deinen "
"Haenden. Sie hat insgesamt 4 Blaetter. Du kannst die einzelnen "
"Blaetter mit <blatt 1, blatt 2, blatt 3, blatt 4> ansehen. Irgendwie fuehlt "
"sich die Karte seltsam an. WAEH!!!! Erst nun bemerkst Du, dass sie "
"aus der Haut eines Zombies hergestellt wurde. Mit <legende> "
"bekommst Du eine Erklaerung der Zeichen. Diese Karte kann "
"Dir sicher etwas helfen, trotzdem ist sie sicher nicht vollstaendig "
"und verraet Dir die Geheimnisse der Insel."));

AD(({"blatt","blaetter"}),
"Es sind 4 an der Zahl. Welches willst Du denn betrachten?!");
  AddId( ({"ZOMBIE_KARTE","karte"}) );
  SetProp(P_NAME,"Karte");
  SP(P_NAME_ADJ, ({"alt","verblichen"}));
  SetProp(P_GENDER,FEMALE);
  SP(P_MATERIAL, ([MAT_MISC_DEAD:100]));
  SetProp(P_WEIGHT,5);
  SP(P_VALUE, 2000);
  SP(P_MAGIC, 1);
SP(P_INFO, BS(
"Die Karte kann Dir sicher gute Dienste leisten."));
 ACD(({"blatt"}), "show_blatt");

ACD("legende", "show_legende");
}

int show_legende()  {
   write("\n"
   " x   Normaler Raum unter der Insel.\n"
   " o   Normaler Raum an der Oberflaeche.\n"
   " s   Steg.\n"
   " V   Strandvilla.\n"
   " D   Hier lebt der Zombiedrache.\n"
   " l   Raum mit Aufzug zu einer Nebeninsel/Saeulengaenge.\n"
   " L   Raum mit Aufzug zur Hauptinsel/Saeulengaenge.\n"
   " *   Durchgang durch Tor versperrt.\n"
   " o   Raum der nach oben fuehrt.\n"
   " u   Raum der nach unten fuehrt.\n");
   return 1; }
   

int show_blatt(string str)  {
   NF("Welches Blatt willst Du sehen?!\n");
   if(!str) return 0;
   
   
   if(str=="4")  {
   write(BS(
   "Hmm, das vierte Blatt der Karte sieht sehr seltsam aus. Irgendwie immateriell! "
   "Ein Bild ensteht in Deinem Kopf. Es scheint einen Weg von der Kneipe von "
   "Zerfallos nach Westen zu geben. Einen Weg voller Saeure und dann durch "
   "einen Saeurefall nach unten zu den Nekromanten! Du siehst einen Saeuredrachen!"
   " Das Bild verschwindet wieder. Seltsam!"));
   
   say(BS(
   CAP_TPN+" scheint eine Vision zu haben!"));
  
   
   return 1; }
   
   
   if(str=="2") {
   	write("Du siehst Dir das zweite Blatt der Karte an:\n\n"
   "+-------------------------------------------------------+\n"
   "|                                                       |\n"
   "|                          l                            |\n"
   "|                          *                            |\n"
   "|                          x                            |\n"
   "|                          |                            |\n"
   "|                          x                            |\n"
   "|                          |                            |\n"
   "|              l * x - x - L - x - x * l                |\n"
   "|                          |                            |\n"
   "|                          x                            |\n"
   "|                          |                            |\n"
   "|                          x                            |\n"
   "|                          *                            |\n"
   "|                          l                            |\n"
   "|                                                       |\n"
   "+-------------------------------------------------------+\n");
   say(BS(
   CAP_TPN+" schaut sich eine Karte der Zombieinsel an."));
   return 1; }
   
   if(str=="3")  {
   write(
   "Du siehst Dir das dritte Blatt der Karte an:\n\n"
   "+-------------------------------------------------------+\n"
   "|                                                       |\n"
   "|               x                       x               |\n"
   "|                 \\                   /                 |\n"
   "|                   x               x                   |\n"
   "|                     \\           /                     |\n"
   "|                       x       x                       |\n"
   "|                         \\   /                         |\n"
   "|                           Lu                          |\n"
   "|                         /    \\                        |\n"
   "|                       x       x                       |\n"  
   "|                     /           \\                     |\n"
   "|                   x               x                   |\n"
   "|                 /                   \\                 |\n"
   "|               x                       D               |\n"   
   "|                                                       |\n"
   "+-------------------------------------------------------+\n");
   
    say(BS(
   CAP_TPN+" schaut sich eine Karte der Zombieinsel an."));
   return 1; }  
  
  if(str=="1")   {
  	   say(BS(
   CAP_TPN+" schaut sich eine Karte der Zombieinsel an."));
  write("Du schaust Dir das erste Blatt genau an:\n\n"
  "+-------------------------------------------------------+\n"
  "|                                                       |\n"  
  "|                         l                             |\n"
  "|                                                       |\n"  
  "|                         V                             |\n"  
  "|                         |                             |\n"
  "|                         o                             |\n"  
  "|                       /   \\                           |\n"  
  "|                      o     o                          |\n"  
  "|      l               |  L  |             l            |\n"  
  "|                      o     o                          |\n"  
  "|                       \\   /                           |\n"
  "|                         o                             |\n"  
  "|                         |                             |\n"
  "|                         s                             |\n"  
  "|                                                       |\n"  
  "|                                                       |\n"  
  "|                                                       |\n"  
  "|                                                       |\n"  
  "|                         l                             |\n"  
  "|                                                       |\n"   
  "+-------------------------------------------------------+\n");   
   return 1; }
  return 0;  }
   
      	