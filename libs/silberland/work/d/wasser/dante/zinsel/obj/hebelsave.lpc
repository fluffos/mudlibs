//dante sl 99
//ein obj das fuerze zerstoert

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Ein magischer Trichter");
  SetProp(P_LONG, BS(
"Du hast einen der beruehmten magischen Trichter in Haenden. Eigentlich "
"sieht er wie ein normaler Trichter aus, aber am engen Ende ist "
"hier eine Kugel angebracht. Mit ihm kann man stinkende Fuerze "
"einsaugen. < syntax: frischluft >."));

AD(({"ende", "kugel"}),
"Die Kugel dient dazu die Fuerze aufzunehmen!");

  AddId( ({"magischer trichter", "trichter"}) );
  SetProp(P_NAME,"Trichter");
  SP(P_NAME_ADJ, "magisch");
  SetProp(P_GENDER,MALE);
  SP(P_MATERIAL, ([MAT_IRON: 50 , MAT_MIS_MAGIC:50]));
  SetProp(P_WEIGHT,30);
  SP(P_VALUE, 2000);

 ACD(({"frischluft"}), "air");
}

int air()  {
	object ob;
	ob=present("_furz_", environment(TP));
if(ob)  {	
write(BS(
"Aber hier ist die Luft doch gar nicht verpestet. Zumindest nicht "
"durch einen Furz!"));
return 1; }

if(ob)
 {
	write(BS(
"Du positionierst den Trichter und dann beginnt der Trichter "
"ploetzlich zu surren und einen Unterdruck zu erzeugen und dann "
"macht es SCHWOPPPPP und die Luft ist wieder rein!"));
say(BS(
CAP_TPN+" positioniert einen magischen Trichter. Es beginnt zu surren und "
"dann ist die Luft endlich wieder rein! Bedanke Dich bei "+TPN+", oder "
"hast Du es etwas gerne wenn es nach Fuerzen stinkt?!"));
	ob->remove();
	if(ob) {
		ob->destruct();  }
return 1; }
return 0; }
				
