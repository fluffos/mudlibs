//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#define ZEIT 20+random(10)

string farbe;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  switch (random(24))
  {
    case 0..2 : farbe = "gelb"; break;
    case 3..5 : farbe = "blau"; break;
    case 6..8 : farbe = "schwarz"; break;
    case 9..11 : farbe = "gruen"; break;
    case 12..14: farbe = "weiss"; break;
    case 15..17: farbe = "orang"; break;
    case 18..20: farbe = "tuerkis"; break;
    case 21..23: farbe = "grau" ; break;
  }


  SetProp (P_SHORT, "Ein "+farbe+"es Zombieamulett");
  SetProp (P_LONG,BS(
"Dieses "+farbe+"e Zombieamulett sieht eigentlich recht langweilig "
"aus. Weder Schmuck noch Ornamente. Aber irgendwas stimmt damit "
"nicht. Du siehst einen eingravierten kleinen Schaedel."));

AD("schaedel",
"Der Schaedel kann Dir helfen das Amulett wieder auszuziehen. "
"Untersuche einfach die Augen des Schaedels.");

ASD(({"auge","augen"}), "weg");



  SP(P_NAME_ADJ, ""+farbe+"");
  SetProp (P_NAME, "Zombieamulett");
  SetProp (P_GENDER, NEUTER);
  AddId (({"amulett","zombieamulett"}));
  SetProp (P_WEIGHT, 110);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 1500);
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 2+random(4));
  SetProp(P_MATERIAL, ([MAT_BONE:50, MAT_MISC_DEAD:50]));
SP(P_CURSED, BS(
"Das "+farbe+"e Zombieamulett lacht Dich aus!"));

SP(P_INFO, BS("Zieh es besser nicht an!"));  
SP(P_WEAR_FUNC, TO);
SP(P_KILL_NAME, "Ein verfluchtes Zombieamulett");

}


string weg()  {
	
	if(TP->QP(P_SP)<25)  {
return BS(
"Deine Magie ist zu schwach!");
  }


if(!QueryWorn())  {
return BS(	"Aber das Amulett wird ja gar nicht getragen!");
	}

	
write(BS(
"Du siehst die Augen genau an!"));
 TP->AddSP(-25);
 
 
if(!random(10))  {

SP(P_CURSED, 0);
write(BS(
"Die Augen blitzen auf und zwingen Dich dazu, dass Amulett auszuziehen!"));
TP->command_me("ziehe amulett aus");

SP(P_CURSED, BS(
"Das "+farbe+"e Zombieamulett lacht Dich aus!"));


 return "";
 
 
 
 }
 
 return BS(
 "Leider passiert nichts! Ausser, dass Deine Magie weniger wird...");

 
       }
 				



remove()  {
::remove();
	if(find_call_out("auaamulett")!=-1){
		remove_call_out("auaamulett"); }}


init()  {
	::init();
		if(find_call_out("auaamulett")!=-1)
		{
		remove_call_out("auaamulett"); }}

		

	 
   WearFunc(object ruest, int silent)  {
   	call_out("auaamulett", ZEIT);
   	
   	return 1; }
   	
   	
   auaamulett()  {
   	if(!QueryWorn())  { return ; }
   	if(environment(TO)!=TP)  { return; }
   	
   	say(BS(
   	"Das Zombieamulett von "+TPN+" sticht "
   	"in "+TP->name(WESSEN)+" Hals!"));
   	write("Das Amulett sticht Dir in den Hals!\n");
   	TP->do_damage(10+random(10));
   	call_out("auaamulett", ZEIT); }
