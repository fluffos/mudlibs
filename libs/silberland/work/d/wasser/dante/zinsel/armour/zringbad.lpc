//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();






  SetProp (P_SHORT, "Ein schwarzer Zombiering");
  SetProp (P_LONG,BS(
"Dieser Zombiering besteht aus schwarzem Stahl, der zu gluehen "
"scheint! Er ist schlicht gearbeitet, weist keinerlei Ornamente "
"auf, kann Dir aber sicher gute Dienste leisten!")); 

  AddId(({"ring","zombiering"}));
  SP(P_NAME_ADJ, "schwarz");
  SetProp (P_NAME, "Zombiering");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 300);
  SetProp (P_ARMOUR_TYPE, AT_RING);
  SetProp (P_AC, 1);
  
  SetProp(P_MATERIAL, ([MAT_STEEL:10,MAT_SHADOW: 40, MAT_MISC_MAGIC:50]));
SP(P_DEFEND_FUNC, TO);
SP(P_CURSED, 1);

}
 
DefendFunc(dtype,enemy) {
	object pl;
	pl=environment(TO);

 	tell_object(pl,
 "Der Zombiering zieht den Angriff auf Dich und verdoppelt so die Wirkung!!!\n");
 tell_room(environment(pl),
 "Der Zombiering von "+pl->name(WEM)+" verletzt "+pl->name(WEN)+" hart!\n", ({pl}));
 return -random(30);   }
 
 
 
 		
