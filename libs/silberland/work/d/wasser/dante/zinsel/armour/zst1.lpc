//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Paar leichte Zombiestiefel");
  SetProp (P_LONG,BS(
        "Diese Zombiestiefel wurden wohl irgendwann von einem unseligen "
        "Zombie gefertigt. Sie stammen von der Zombieinsel und bestehen "
        "aus der Haut eines Erzmagiers."));

  AD("haut",
      "Guter Zombie!");
  AD(({"erzmagier","magier"}),
      "Wem fehlt wohl ein Stueck Haut?! Frag am besten nach?!");


  SP(P_NAME_ADJ, "leicht");
  SetProp (P_NAME, "Paar Zombiestiefel");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, NEUTER);
  AddId (({"stiefel","zombiestiefel"}));
  SetProp (P_WEIGHT, 900);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 500);
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_SKIN:50, MAT_MISC_DEAD:50]));
  SetProp(P_NEKRO_SPELLCOST, 1);

}
