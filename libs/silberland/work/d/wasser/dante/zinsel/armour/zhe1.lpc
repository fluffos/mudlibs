//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp (P_SHORT, "Ein leichter Zombiehelm");
  SetProp (P_LONG,BS(
        "Dieser leichte Zombiehelm stammt von der beruechtigten Zombieinsel. "
        "Er hat die Form eines Totenschaedels und sein Traeger sieht sicher "
        "sehr furchteinfloessend damit aus!"));


  ASD(({"schaedel","totenschaedel"}), "show");
  SP(P_NAME_ADJ, "leicht");
  SetProp (P_NAME, "Zombiehelm");
  SetProp (P_GENDER, MALE);
  AddId (({"helm","zombiehelm"}));
  SetProp (P_WEIGHT, 900);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 500);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
  SetProp (P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_BONE:50, MAT_MISC_DEAD:50]));
  //SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, SR_GOOD:0, A_INT:18]) );
  SetProp(P_NEKRO_SPELLCOST, 1);

}

string show()  {
  return (BS(
        "Der Schaedel grinst und sagt: Hallo, "+TPN+", wie gehts Dir so! "));
}
