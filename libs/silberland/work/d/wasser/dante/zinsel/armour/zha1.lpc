//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp (P_SHORT, "Ein Paar leichte Zombiehandschuhe");
  SetProp (P_LONG,BS(
        "Die leichten Zombiehandschuhe bestehen aus duennem Leder. Sie "
        "sind zwar leicht, aber wehren Angreifer auch nicht besonders gut ab!"));

  AD("leder",
      "Gutes Hobbitleder!");


  SP(P_NAME_ADJ, "leicht");
  SetProp (P_NAME, "Paar Zombiehandschuhe");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, NEUTER);
  AddId (({"handschuhe","zombiehandschuhe"}));
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 700);
  SetProp (P_ARMOUR_TYPE, AT_GLOVE);
  SetProp (P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_BONE:50, MAT_MISC_DEAD:50]));
  SetProp(P_NEKRO_SPELLCOST, 1);
}
