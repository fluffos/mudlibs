
//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"
#define MAX 111

string *col;
int i;
int zaehler=0;

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  
  SetProp (P_SHORT, "Ein feuerroter Zombiering");
  SetProp (P_LONG,BS(
        "Dieser Zombiering besteht aus feuerrotem Stahl, der zu gluehen "
        "scheint! Er ist schlicht gearbeitet, weist keinerlei Ornamente "
        "auf, kann Dir aber sicher gute Dienste leisten!")); 

  AddId(({"ring","zombiering"}));
  SP(P_NAME_ADJ, "feuerrot");
  SetProp (P_NAME, "Zombiering");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 1500);
  SetProp (P_ARMOUR_TYPE, AT_RING);
  SetProp (P_AC, 3+random(3));
  SetProp(P_MATERIAL, ([MAT_STEEL:30, MAT_SHADOW:20, MAT_MISC_MAGIC:50]));
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );
  SP(P_INFO, BS(
        "Dieser Ring schuetzt Dich vor dem Feuer!"));
  SP(P_DEFEND_FUNC, TO);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_FIRE:1]));
  SetProp(P_NEKRO_SPELLCOST, 1);
}
 
 
 
DefendFunc(dtype,enemy) {
  object pl;
  pl=environment(TO);
  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (sizeof(dtype & ({ DT_FIRE }) ))   {

    if(!random(4))   {
      if(zaehler>MAX)  {
        tell_object(pl,
            "Der Zombiering explodiert mit lautem Knall!\n");
        tell_room(environment(pl),
            "Der Zombiering von "+pl->name(WEM)+" explodiert mit lautem Knall!!\n", ({pl}));
        call_out("remove", 0 ,1);
      }
      tell_object(pl,
          "Der Zombiering zieht etwas Feuer auf sich und schuetzt Dich so!\n");
      tell_room(environment(pl),
          "Der Zombiering von "+pl->name(WEM)+" zieht das Feuer auf sich!\n", ({pl}));
      zaehler++;

      return 10+random(5); 
    } 
  }  
  return 0;
}


void reset()  {
  ::reset();	
  zaehler=zaehler-random(5);

  if(zaehler<0)  {
    zaehler=0;
  }
}

