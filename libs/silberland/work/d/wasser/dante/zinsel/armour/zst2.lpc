//ruestungen fuer die zombieinsel
//dante sl 99

/*
die funcs sind exakt die gleichen wie aus woodys umhang

*/

inherit "std/armour";

#include <class.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp (P_SHORT, "Ein Paar schwere Zombiestiefel");
  SetProp (P_LONG,BS(
        "Diese Zombiestiefel wurden wohl irgendwann von einem unseligen "
        "Zombie gefertigt. Sie bestehen aus der Haut Dantes und sind zusaetzlich "
        "stahlverstaerkt. Der Stahl glaenzt seltsam..."));


  AD("haut",
      "Guter Zombie!");
  AD(({"dante"}),
      "Der war wohl zu frech zu den Zombies.");
  AD("stahl", 
      "Der Stahl der Stiefel glaenzt seltsam hell!");

  SP(P_INFO,BS(
        "Diese Stiefel koennten Dir einiges heller erscheinen lassen!"));


  SP(P_NAME_ADJ, "schwer");
  SetProp (P_NAME, "Paar Zombiestiefel");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, NEUTER);
  AddId (({"stiefel","zombiestiefel"}));
  SetProp (P_WEIGHT, 1200);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 1500);
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 8+random(2));

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ 
      ([DT_TERROR:1, DT_UNHOLY:1]));
  SetProp(P_MATERIAL, ([MAT_SKIN:30,MAT_SHADOW:20, MAT_MISC_DEAD:50]));
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );
  SP(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  SP(P_LIGHT, 0);
  SetProp(P_NEKRO_SPELLCOST, 2);
}



private nosave void EsWird(object pl, string was)
{
  mixed u;
  int i;

  if (!objectp(pl)) return;
  u=all_inventory(environment(pl));
  u=filter_array(u,#'living);
  for (i=sizeof(u)-1; i>=0; i--)
    if (!u[i]->CannotSee(1))
      tell_object(u[i], "Es wird ein wenig "+was+".\n");
}

nosave void SetMyLight(object pl, int x)
{
  if (!pl) x=0;         // Sicherheitsmassnahme...
  SetProp(P_LIGHT, x);
  if (x<0) EsWird(pl,"dunkler"); else EsWird(pl,"heller");
}

int WearFunc(object ruest, int silent)
{
  while (remove_call_out("SetMyLight") != -1) /* continue */ ;
  if (this_player()->is_class_member(CL_NIGHTVISION))
    call_out("SetMyLight", 2, this_player(), -2);
  else
    call_out("SetMyLight", 2, this_player(), -1);
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  while (remove_call_out("SetMyLight") != -1) /* continue */ ;
  call_out("SetMyLight", 2, this_player(), 0);
  return 1;
}

void reset()
{
  ::reset();
  if (!QueryProp(P_WORN)) SetProp(P_LIGHT, 0);  // Sicherheitsmassnahme :)
}

