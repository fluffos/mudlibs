//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp (P_SHORT, "Ein schwerer Zombieumhang");
  SetProp (P_LONG,BS(
        "Dieser schwere Zombieumhang wurde aus einem seltsamen, besonders "
        "gut gehaerteten Leder gefertigt. Zusaetzlich wurde er noch "
        "mit Stahl verstaerkt. Er stammt von der sagenumwobenen Zombieinsel."));

  AD("stahl",
      "Sehr leichtes, aber sehr hartes Stahl!");
  ASD("leder", "show");
  SP(P_NAME_ADJ, "schwer");
  SetProp (P_NAME, "Zombieumhang");
  SetProp (P_GENDER, MALE);
  AddId (({"umhang","zombieumhang"}));
  SetProp (P_WEIGHT, 700);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 1500);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 8+random(2));

  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ 
      ([DT_TERROR:1, DT_UNHOLY:1]));
  SetProp(P_MATERIAL, ([MAT_STEEL:10,MAT_LEATHER:10,MAT_SHADOW:30, MAT_MISC_DEAD:50]));
  SetProp(P_WEAR_RESTRICTIONS, ([ A_INT:13]) );
  SetProp(P_NEKRO_SPELLCOST, 2);

}

string show()  {
  return (BS(
        "Das Leder wurde aus den Opfern der Zombies gemacht. "
        "Herkunft des Leders: "+TP->QueryProp(P_RACE)+"!"));
}
