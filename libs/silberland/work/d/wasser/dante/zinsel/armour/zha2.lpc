//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp (P_SHORT, "Ein Paar gepanzerte Zombiehandschuhe");
  SetProp (P_LONG,BS(
        "Die gepanzerten Zombiehandschuhe sind wohl mitunter das "
        "Beste, was Du jemals gesehen hast. Sie bestehen innen aus weichem "
        "Leder, haben aber aussen eine extrem harte Schale aus Stahl, "
        "die sich trotzdem Dir irgendwie anpassen kann."));
  SP(P_KILL_NAME, "Gepanzerte Zombiehandschuhe");


  AD("leder",
      "Gutes Nashornleder!");
  AD("stahl",
      "Knallhart.");
  AD("schale",
      "Irgendwie komisch.");

  SP(P_NAME_ADJ, "gepanzert");
  SetProp (P_NAME, "Paar Zombiehandschuhe");
  SP(P_ARTICLE, 1);
  SetProp (P_GENDER, NEUTER);
  AddId (({"handschuhe","zombiehandschuhe"}));
  SetProp (P_WEIGHT, 800);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 6300);
  SetProp (P_ARMOUR_TYPE, AT_GLOVE);
  SetProp (P_AC, 9);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_TERROR:1, 
    DT_UNHOLY:1]));
  SetProp(P_MATERIAL, ([MAT_LEATHER:50, MAT_MISC_MAGIC:40, MAT_STEEL:10]));
  // Laut P_LONG besteht es aus leder und stahl (feyaria)
  SetProp(P_WEAR_RESTRICTIONS, 
      ([SR_SEER:1]) );
  SP(P_DEFEND_FUNC, TO);
  
  
  //wichtig fuers duellsystem!!!! solltest du aehnliches machen unbedingt
  //einbauen bzw FRAGEN!!!! dante
  AddId("DuellAllowed");
  
  SP(P_INFO, BS(
  "In diesen Handschuhen haben die Mystagogen all die Boesartigkeit und "
  "Feindseligkeit der Zombieinsel gesteckt. Daher haben sie ein merkwuerdiges "
  "Eigenleben..."));
  
  
}

attack_enemy(enemy) {
  object pl;

  if (!objectp(enemy) || !living(enemy)) return;
  if (enemy->QueryProp(P_NAME)=="Zombiedrache") return;
  //der drache soll ja net von seinen eigenen dingen geschlagen werden
  
  pl=QueryWorn();
  // 1. Check ob die Handschuhe noch getragen werden: (Dante)
  if (!objectp(pl)) return;
  // 2. Check ob der Traeger schon tot ist: (Dante)
  if (query_once_interactive(pl) && !interactive(pl)) return;
  // 3. Check ob Traeger gleich Gegner: (Dante)
  if (enemy==pl) return;
  // 4. Check ob der Gegner tot ist: (Angel)
  if ( interactive(enemy) && (enemy->QueryProp(P_GHOST))  )
     return;
  // 5. Check ob der Gegner sich im gleichen Raum befindet: (Dante)
  if (environment(enemy)!=environment(pl)) return;
  // 6. Check ob der Traeger zum Kampf faehig ist: (Angel)
  if((pl->QueryProp(P_PARALYZED)) ||
     (pl->QueryProp(P_DISABLE_ATTACK)) )
     return;
  // 7. Check ob sich der Traeger mit dem Gegner ueberhaupt noch im Kampf befindet: (Angel)
  if ( !pl->IsEnemy(enemy) )
     return;     
  if (pl->QueryProp(P_NAME)!="Zombiedrache" && random(100)<40) return;
  // 8. Check ob sich der Spieler den Schlag leisten kann: (Dante)
  if (pl->QueryProp(P_SP)<3) return;
  // Ab diesem Punkt kann ruhig zugeschlagen werden: (comm. Angel)
  tell_object(pl,"  Die Zombiehandschuhe versetzen "+
			  enemy->name(WEM)+" einen harten Schlag.\n");
  say("  "+capitalize(pl->name(WESSEN))+
" Zombiehandschuhe versetzen "+enemy->name(WEM)+" einen harten Schlag.\n",
	  ({pl,enemy}));

tell_object(enemy, BS(
 "Die Zombiehandschuhe von "+pl->name(WEM)+" treffen Dich hart am Kopf."));

  pl->AddSp(-1-random(3));
  //enemy->do_damage(9+random(8));
  
  switch(random(2))  {
  	case 0:
     enemy->Defend(50+random(50), DT_BLUDGEON,
      ([SP_SHOW_DAMAGE:1,SP_NAME:"Zombiehandschuhe"]), pl);
       break;
       case 1:
         enemy->Defend(100+random(100), DT_BLUDGEON,
      ([SP_SHOW_DAMAGE:1,SP_NAME:"Zombiehandschuhe"]), pl);
      break;
      default:
        enemy->Defend(100+random(100), DT_BLUDGEON,
      ([SP_SHOW_DAMAGE:1,SP_NAME:"Zombiehandschuhe"]), pl);
      }
       
}


DefendFunc(dtype,enemy) {
  object pl;

  if (!enemy) enemy=TP;
  if (!pointerp(dtype)) dtype=({dtype});
  pl=QueryProp(P_WORN);
  // Immer nur eine Attacke auf einmal (feyaria)
  if(find_call_out("attack_enemy")==-1)     
    call_out("attack_enemy",0,enemy);
  if (objectp(pl) && pl->QueryProp(P_NAME)=="Zombiedrache") return 150;
  if (member(dtype,DT_MAGIC)>=0 ||
	  member(dtype,DT_FIRE)>=0) {
	if (objectp(enemy) && enemy->QueryProp(P_NAME)!="Zombiedrache") return 0;
	return 15+random(10);
  }
  return 0;
}
