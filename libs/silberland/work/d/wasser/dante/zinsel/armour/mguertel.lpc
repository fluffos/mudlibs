//der guertel des mystagogen....dante@sl
//der mystagoge ist alleine eigentlich nicht zu schaffen..bisher immer
//nur von gruppen hoher seher besiegt...10 mal in ueber 1 jahr
//teilweise wurden die werte des mithtrilguertels uebernommen

#include "/players/dante/myowndefine.h"
inherit "std/armour";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#define MAX 3

string *liste;
int wieviel;
int changes=0;
mixed get_type(string wunsch);
string wunsch;
string col="blass";
string art=DT_BLUDGEON;
string was="Gar keine besonderen Angriffe, hoechtens Keulenschlaege und aehnliches";

int uses=0;


create() {
  if( !is_clone(TO) ) return;
  ::create();

liste=({
	"Feuer",
	"Wasser",
	"Kaelte",
	"Luft",
        "Gift",
        "Saeure",
        "Unheiliges",   
        "Heiliges",
        "Magie",
        "Schrecken",
        });
	
	

  SetProp(P_SHORT, "Der "+col+"e Guertel des Mystagogen");
  SetProp(P_LONG,BS(
"Du siehst den beruehmten Guertel des Mystagogen vor Dir. Der ehemalige "
"Besitzer wohnt tief unter der Insel der Zombies und beschaeftigt sich "
"seit vielen, vielen Jahren mit den Kraeften der guten und auch der boesen "
"Magie. Dieser Guertel hier schimmert in "+col+"er Farbe und scheint magische "
"Kraefte zu besitzen. Er besteht aus einem Gemisch aus Seide, Kristall, "
"magischen Kraeften und Adamant."));

AD("gemisch",
"Kunstvoll verwobenene verschiedene Materialien.");
AD(({"material","materialien"}),
"Seide, Kristall, Magie und Adamant.");

AD("seide",
"Duenne Faeden aus glitzernder Seide.");
AD("kristall",
"Einzelne Splitter aus leuchtendem Kristall.");
AD("adamant",
"Ein kostbares, magisches Material.");
AD(({"kraft","kraefte"}),
"Sie koennten Dir helfen.");


AD("farbe",
"Ein kraeftiges "+CAP(col)+"!");

AD("mystagoge",
"Der Mystagoge ist ein wahrer Meister der Magie und der Feind aller "
"Zombies.");
AD("insel",
"Die Insel steckt voller furchtbarer Geheimnisse und ist das Zuhause aller "
"Zombies.");
AD(({"zombie","zombies"}),
"Seit Aeonen treiben sie ihr Unwesen auf der Insel.");
AD("magie",
"Es gibt gute und boese Magie.");


  SetProp(P_NAME, "Mystagogenguertel");
  SP(P_NAME_ADJ, col);
  SP(P_KILL_NAME, "Der Guertel des Mystagogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"mystagogenguertel", "guertel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 5 );
  SetProp(P_MATERIAL, ([ MAT_MAGIC:30, MAT_SILK:10, MAT_CRYSTAL:20,MAT_ADAMANT: 40]) );
  SetProp(P_WEIGHT, 179);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 261);
  SP(P_INFO, BS(
  "Es gibt viele Arten von verschiedenen Mystagogenguerteln. "
  "Sie alle haben spezielle Kraefte. Dieser hier kann Dich "
  "vor folgenden Angriffen sehr gut schuetzen: "+was+"! Du kannst "
  "die Kraefte des Guertels aber auch aendern, mit etwas Glueck! "
  "Doch dazu brauchst Du Perlen und Edelsteine. Du benoetigst immer "
  "Steine/Perlen einer Sorte und je mehr Du davon hast desto eher wird "
  "Dein Wunsch in Erfuellung gehen. Die Steine/Perlen werden sich "
  "jedoch aufloesen und die so freiwerdende Energie kann vielleicht "
  "dazu genutzt werden den Guertel so zu transformieren, wie Du es "
  "Dir wuenscht. <syntax: verwandle anzahl edelsteinname/perlenname in element/schadenstyp>"));
  
  
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, A_INT:18]) );
  
  ACD(({"verwandle","verwandl","verwandeln","verwandel"}), "switch_t");

  }


int switch_t(string str)  {
	string opfstr;
	string styp;
	object opfobj;
	
     NF("Was willst Du in was verwandeln?!\n"
     "<syntax: verwandle anzahl edelsteinname/perlenname in element/schadenstyp>\n");
    if(!str) return 0;
    
    if(sscanf(str, "%d %s in %s", wieviel, opfstr, styp) != 3)  {
             return 0; }

if(changes >= MAX )  {
	write(BS(
	"Leider kannst Du diesen Guertel nicht mehr transformieren!"));
	return 1; }
	
    	
     /*  	write("str: "+str+"\n"
    	      "wieviel: "+wieviel+"\n"
    	      "opfstr: "+opfstr+"\n"
    	      "styp: "+styp+"\n");
   */
   
   opfobj=present(opfstr, TP);
  
   if(!opfobj) {
   	write(BS(
   	"Aber Du hast doch '"+CAP(opfstr)+"' gar nicht!"));
   	return 1; }

if(wieviel <=0 )  {

write(BS(
"Nein, "+wieviel+" geht wirklich nicht!"));
return 1; }

   
   if(!opfobj->IsUnit())  {	
   	write(BS(
   	"Leider kannst Du mit '"+CAP(opfstr)+" hier nichts anfangen!"));
   	return 1; }
   	
   
    if(file_name(opfobj)[0..9]!="/obj/gems/" &&
       file_name(opfobj)[0..11]!="/obj/pearls/")  {
       	
    	write(BS(
   	"Leider kannst Du mit '"+CAP(opfstr)+" hier gar nichts anfangen!"));
   	return 1; }

     if(opfobj->QP(P_AMOUNT) < wieviel  &&
     file_name(opfobj)[0..11]=="/obj/pearls/" ) {
   	write(BS(
   	"Aber hast Du gar nicht "+wieviel+" Perlen vom Typ "+CAP(opfstr)+"!"));
    	  return 1; }
   	
   if(opfobj->QP(P_AMOUNT) < wieviel  &&
     file_name(opfobj)[0..9]=="/obj/gems/" ) {
   	write(BS(
   	"Aber Du hast gar nicht "+wieviel+" Edelsteine vom Typ "+CAP(opfstr)+"!"));
    	  return 1; }

if(member_array(CAP(styp), liste)==-1)  {
	write(BS(
	"Leider kannst Du mit '"+CAP(styp)+"' nichts anfangen!"));
	return 1; }

write(
"\nDu wuenscht Dir inniglich, dass der Guertel Dich gegen "+CAP(styp)+" "
"schuetzen moege! Ein Lichtblitz! Und...\n\n");
say(BS(
CAP_TPN+" murmelt einige Worte und starrt dabei auf einen magischen Guertel!"));

say(BS(
"Plotzlich schiesst ein Lichtblitz direkt aus "+TPN+" heraus."));

if(wieviel == 1 ) {
    write(BS(
    "Ploetzlich loest sich "+wieviel+" "+opfobj->QP(P_NAME)+" auf!"));
    }

 if(wieviel > 1 ) {

  if( file_name(opfobj)[0..9]=="/obj/gems/" ) {
    write(BS(
    "Ploetzlich loesen sich "+wieviel+" Edelsteine vom Typ "+opfobj->QP(P_NAME)+" auf!"));
    }   
  if( file_name(opfobj)[0..11]=="/obj/pearls/" ) {
    write(BS(
    "Ploetzlich loesen sich "+wieviel+" Perlen vom Typ "+opfobj->QP(P_NAME)+" auf!"));
    }      
}    
 
 
 
    get_type(styp);
    
    
    opfobj->AddAmount(-wieviel);
    return 1; }
    	  
//****************************************************************

get_type(string wunsch)  {
	int x, i, zufall;;
        
//	write("wunsch: "+wunsch+"\n");

if(wieviel > 9 ) wieviel=9;
    
    zufall=1+random(10);
     
if(wieviel >= zufall ) {
	 write(BS(
	 "Der Guertel wurde korrekt transformiert! Du hattest Glueck!"));
say(BS(
CAP_TPN+" scheint sich ueber den Guertel sehr zu freuen! Der Guertel muss "
"grosse magische Kraefte haben!"));
//x=liste[wunsch];

for(i=0;i<sizeof(liste);i++ )  {
if(liste[i]==CAP(wunsch)) { x=i; }  

//write("i: "+i+" "+liste[i]+"\n"); 

} }

if(wieviel < zufall) {
write(BS(
"Die Magie wird voellig zufaellig verteilt! Keine Ahnung was mit "
"dem Guertel geschehen ist."));
 x=random(10);
 say(BS(
 CAP_TPN+" schaut unzufrieden auf den Guertel."));
 
 
 if(random(10) > 5 )  {
 	TP->do_damage(10+random(10));
 	write(BS(
 	"Ein harter dumpfer Schlag trifft Dich auf einmal von hinten! "
 	"Muss wohl der Geist des Mystagogen sein..."));
 	say(BS(
 	CAP_TPN+" wird von einem harten unsichtbaren Schlag getroffen! AUA!"));
 	}
 
   }

//write("x: "+x+"  i: "+i+" zufall: "+zufall+"\n");

switch(x)  {
	case 0:
	col="feuerrot";
	art=DT_FIRE;
	was="Feuer";
	break;
	case 1:
	col="meerblau";
	art=DT_WATER;
	was="Wasser";
	break;
        case 2:
	col="eisblau";
	art=DT_COLD;
	was="Kaelte";
	break;
        case 3:
	col="himmelblau";
	art=DT_AIR;
	was="Luft";
	break;
        case 4:
        col="giftgruen";
        art=DT_POISON;
        was="Gift";
        break;
        case 5:
        col="saeuregelb";
        art=DT_ACID;
        was="Saeure";
        break;
        case 6:
        col="schwarz";
        art=DT_UNHOLY;
        was="Unheiliges";   
        break;
        case 7:
        col="leuchtend weiss";
        art=DT_HOLY;
        was="Heiliges";
        break;
        case 8:
        col="kristallweiss";
        art=DT_MAGIC;
        was="Magie";
        break;
        case 9:
        col="hoellenfeuerrot";
        art=DT_TERROR;
        was="Schrecken";
        break;
        default:
        col="kristallweiss";
        art=DT_MAGIC;
        was="Magie";
 
}


changes++;     
TO->create();
}
//*********************************************************************    	      
    	














  int DefendFunc(string *dtyp, mixed spell, object enemy)
     {
       int prot;
       object tp;
       tp=QueryProp(P_WORN);
       
       prot = 0;


  if(tp && interactive(tp) ) {

      if(uses  >   tp->QP(P_LEVEL)*7 ) {
        tell_object(tp, 
        "Dein Mystagogenguertel explodiert ploetzlich!\n");
        tell_room(environment(tp),
         tp->Name(WESSEN,1)+" Mystagogenguertel explodiert ploetzlich!\n",
        ({tp}));
        call_out("remove", 0,1);
        }
      }





       if ( !random(3) && member(dtyp, art) >= 0)   {
         prot = 1+random(4);
         uses++;
   
      
        if(tp && interactive(tp) && enemy && interactive(enemy) ) {
   
        tell_object(enemy,
 tp->Name(WESSEN,1)+" Mystagogenguertel leuchtet "+col+" auf.\n");
         }
        
        if(tp && interactive(tp) && enemy )  {
          tell_object(tp,BS(
        "Dein Mystagogenguertel leuchtet "+col+" auf "
        "und schuetzt Dich besser vor "+enemy->name(WESSEN, 1)+" Angriff.")); 
        }
        
      }      


       return prot;
     }


