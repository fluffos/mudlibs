//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Eine leichte Zombiehose");
  SetProp (P_LONG,BS(
        "Die leichte Zombiehose stammt von der beruechtigten Insel der "
        "Zombies. Sie besteht aus einem dicken, stinkenden Leder!"));

  ASD(({"leder"}), "show");
  SP(P_NAME_ADJ, "leicht");
  SetProp (P_NAME, "Zombiehose");
  SetProp (P_GENDER, FEMALE);
  AddId (({"hose","zombiehose"}));
  SetProp (P_WEIGHT, 900);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 700);
  SetProp (P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp (P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_BONE:50, MAT_MISC_DEAD:50]));
  //SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, SR_GOOD:0, A_INT:18]) );
  SetProp(P_NEKRO_SPELLCOST, 1);  
}

string show()  {
  return (BS(
        "Ein "+TP->QueryProp(P_RACE)+"zombie kichert hinter Dir!"));
}
