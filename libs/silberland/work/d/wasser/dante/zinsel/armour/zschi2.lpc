//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein ovaler, schwerer Zombieschild");
  SetProp (P_LONG,BS(
        "Dieser Zombieschild besteht aus den Plattenknochen verschiedenster "
        "Tiere, die zusaetzlich stahlverstaerkt wurden. Er stammt wohl "
        "von der unseligen Insel der Zombies. Ein kleiner Schaedel ist mitten im Schild "
        "eingelassen. Dies ist die schwere Variante."));


  SP(P_NAME_ADJ, "schwer");
  SetProp (P_NAME, "Zombieschild");
  SetProp (P_GENDER, NEUTER);
  AddId (({"schild","zombieschild"}));
  SetProp (P_WEIGHT, 2500);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 1500);
  SetProp (P_ARMOUR_TYPE, AT_SHIELD);
  SetProp (P_AC, 25+random(5));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ 
      ([DT_TERROR:1, DT_UNHOLY:1]));
  SetProp(P_MATERIAL, ([MAT_BONE:30,MAT_SHADOW:10,MAT_STEEL:10, MAT_MISC_DEAD:50]));
  
  SetProp(P_NEKRO_SPELLCOST, 2);
  ASD("schaedel", "hi");
}

string hi()  {
return (BS(
"Der Schaedel grinst und sagt: Hallo, "+TPN+", wie gehts Dir so! "));
}

