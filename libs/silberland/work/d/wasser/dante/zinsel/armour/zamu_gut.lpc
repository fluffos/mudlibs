//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

string farbe;

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  switch (random(24))
  {
    case 0..2 : farbe = "gelb"; break;
    case 3..5 : farbe = "blau"; break;
    case 6..8 : farbe = "schwarz"; break;
    case 9..11 : farbe = "gruen"; break;
    case 12..14: farbe = "weiss"; break;
    case 15..17: farbe = "orang"; break;
    case 18..20: farbe = "tuerkis"; break;
    case 21..23: farbe = "grau" ; break;
  }


  SetProp (P_SHORT, "Ein "+farbe+"es Zombieamulett");
  SetProp (P_LONG,BS(
        "Dieses "+farbe+"e Zombieamulett sieht eigentlich recht langweilig "
        "aus. Weder Schmuck noch Ornamente. Aber irgendwas stimmt damit "
        "nicht..."));

  SP(P_INFO, "Dieses Amulett ist nicht verflucht!");

  SP(P_NAME_ADJ, ""+farbe+"");
  SetProp (P_NAME, "Zombieamulett");
  SetProp (P_GENDER, NEUTER);
  AddId (({"amulett","zombieamulett"}));
  SetProp (P_WEIGHT, 110);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 1000+random(1000));
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 3+random(3));
  SetProp(P_MATERIAL, ([MAT_BONE:50, MAT_MISC_DEAD:50]));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ 
      ([DT_TERROR:1, DT_UNHOLY:1]));
  SetProp(P_NEKRO_SPELLCOST, 1);
}
