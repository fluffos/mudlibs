//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp (P_SHORT, "Ein schwerer Zombiehelm");
  SetProp (P_LONG,BS(
        "Dieser schwere Zombiehelm stammt von der beruechtigten Zombieinsel. "
        "Er hat die Form eines Totenschaedels und sein Traeger sieht sicher "
        "sehr furchteinfloessend damit aus! Zusaetzlich zum Knochen ist "
        "er noch stahlverstaerkt, was ihn zwar schwerer, aber auch viel "
        "widerstandkraeftiger macht."));

  AD("knochen",
      "Es scheint sich um Schaedelknochen zu handeln.");

  ASD(({"schaedel","totenschaedel"}), "show");
  SP(P_NAME_ADJ, "schwer");
  SetProp (P_NAME, "Zombiehelm");
  SetProp (P_GENDER, MALE);
  AddId (({"helm","zombiehelm"}));
  SetProp (P_WEIGHT, 1200);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 1500);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
  SetProp (P_AC, 12+random(4));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ 
      ([DT_TERROR:1, DT_UNHOLY:1]));  
  SetProp(P_MATERIAL, ([
        MAT_STEEL:20,MAT_BONE:30, MAT_MISC_MAGIC:50]));
  SetProp(P_WEAR_RESTRICTIONS, ([ A_INT:13]) );
  SetProp(P_NEKRO_SPELLCOST, 2);
}

string show()  {
  return (BS(
        "Der Schaedel grinst und sagt: Hallo, "+TPN+", wie gehts Dir so! "));
}
