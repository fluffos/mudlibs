//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp (P_SHORT, "Eine schwere Zombiehose");
  SetProp (P_LONG,BS(
        "Diese schwere Zombiehose stammt von der beruechtigten Insel der "
        "Zombies. Sie besteht aus einem dicken, stinkenden Leder und ist "
        "zusaetzlich noch Stahl verstaerkt. Sie wirkt irgendwie klobig, "
        "ist aber trotzdem sehr gut zu tragen!"));

  AD("stahl",
      "Im Stahl ist eine Inschrift zu erkennen.");
  ARD("inschrift",
      "(C) by ZombieBrothersInternational.");
  AD("inschrift",
      "Lies sie!");

  ASD(({"leder"}), "show");
  SP(P_NAME_ADJ, "schwer");
  SetProp (P_NAME, "Zombiehose");
  SetProp (P_GENDER, FEMALE);
  AddId (({"hose","zombiehose"}));
  SetProp (P_WEIGHT, 1200);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 1000+random(500));
  SetProp (P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp (P_AC, 9);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ 
      ([DT_TERROR:1, DT_UNHOLY:1]));
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:20,MAT_STEEL:30, MAT_MISC_DEAD:50]));
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );
  SetProp(P_NEKRO_SPELLCOST, 2);
}

string show()  {
  return (BS(
        "Ein "+TP->QueryProp(P_RACE)+"zombie kichert hinter Dir!"));
}
