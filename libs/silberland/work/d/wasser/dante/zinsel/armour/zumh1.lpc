//ruestungen fuer die zombieinsel
//dante sl 99

inherit "std/armour";


#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein leichter Zombieumhang");
  SetProp (P_LONG,BS(
        "Schwarzes, gehaertetes Leder machen diesen Umhang zu einem "
        "sehr leichten Schutz. Irgendwie kommt Dir das Leder doch "
        "seltsam vor!"));
  ASD("leder", "show");
  SP(P_NAME_ADJ, "leicht");
  SetProp (P_NAME, "Zombieumhang");
  SetProp (P_GENDER, MALE);
  AddId (({"umhang","zombieumhang"}));
  SetProp (P_WEIGHT, 400);
  SetProp (P_NOBUY, 0);
  SetProp (P_VALUE, 800);
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_LEATHER:50, MAT_MISC_DEAD:50]));
  //SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, SR_GOOD:0, A_INT:18]) );
  SetProp(P_NEKRO_SPELLCOST, 1);
}

string show()  {
  return (BS(
  "Das Leder wurde aus den Opfern der Zombies gemacht. "
  "Herkunft des Leders: "+TP->QueryProp(P_RACE)+"!"));
}
