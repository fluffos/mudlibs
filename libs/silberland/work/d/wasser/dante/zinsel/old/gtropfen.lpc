//dante sl 99

inherit "std/unit";

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>


string col="gruen";
string name="pikleewpi";

void _set_autoloadobj( mixed args )
{
  if (pointerp(args))
        args=args[0];
         if (stringp(args))
          sscanf(args,"%d",args);
           if (!intp(args))
              args=0;
  SetProp(P_AMOUNT,args);
  }
                      
                      
  int _query_autoloadobj()
         {
   return (int) QueryProp(P_AMOUNT);
     }
                           

void create()
{

  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_NAME, "Zombiegoetzen"+col+"blutstropfen");
  SetProp(P_SHORT,"Zombiegoetzen"+col+"blutstropfen");
  SetProp(P_MATERIAL, ([ MAT_BLOOD: 50, MAT_MISC_MAGIC:50 ]) );
  AddSingularId(({""+name+"tropfen", "zombiegoetzen"+col+"blutstropfen",
  "tropfen","blutstropfen","goetzenblutstropfen",""+col+"tropfen",
  "zombiegoetzenblutstropfen","DANTE_ZOMBIE_BLUT"}));
  AddPluralId(({""+name+"tropfen" "tropfen",
  "zombiegoetzen"+col+"blutstropfen",""+col+"tropfen",
  "blutstropfen","goetzenblutstropfen","zombiegoetzenblutstropfen",
  "DANTE_ZOMBIE_BLUT"}));
  
 SP(P_LONG, BS(
 "Das ist einer der sagenumwobenen Zombiegoetzenblutstropfen! Er schillert "
 ""+col+" und irgendwie scheint er zu pulsieren. Er stammt vom "
 " Goetzen "+capitalize(name)+" der Zombies, die ihn mit einem dunklen Kult auf"
 " der Zombieinsel huldigen. "
"Wer ihn sich geholt hat, muss ein wahrer Held sein! Du kannst "
 "den Tropfen auch mit "+capitalize(col)+"tropfen ansprechen."));


 SP(P_INFO,BS(
 "Der Tropfen Blut hat die Magie sich mit anderen Tropfen "
 "zu vereinigen und schreckliche Gegenstaende zu bilden! Doch nur "
 "ein wahrer Meister und Kenner der Zombiekulte kann dieses "
 "Wunder vollbringen und angeblich soll es auch nicht ganz ungefaehrlich sein "
 "diese magischen Objekte zu verwenden!"));
 
  SetProp(P_GENDER,MALE);
  SetCoinsPerUnits(5000,1);
  SetGramsPerUnits(1,1);
 
}
