Defend(int dam, string dtype, mixed spell, object enemy)
{
if(!random(2))  {
tell_object(enemy,
"Der Mystagoge baut eine Schutzaura auf!\n");
tell_object(enemy,
"Der Mystagoge zwingt Dich Dich selbst anzugreifen!!!\n");
enemy->Defend(200+random(100), DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));
tell_room(environment(TO),
""+enemy->name()+" wird von einem grellen Blitz getroffen!\n", ({enemy}));
return ::Defend(0, dtype, spell, enemy);
}
else
return ::Defend(dam, dtype, spell, enemy);
}

	
          
   
     die(arg)
        {	domainshout(
"\nDer Mystagoge loest sich in Luft auf. "+TPN+" hat ihn besiegt!\n");

             write_file("/d/wasser/dante/zinsel/log/mysstirbt",
                  ctime()+": "+CAP(getuid(PL))+" killt den Mystagogen.\n");
            ::die(arg);                                                                                       
                }
  
  
  
  
   void NotifyPlayerDeath(object player, object killer, int lostexp)
       {
        write_file("/d/wasser/dante/zinsel/log/myskillt",
       ctime()+": Der Mystagoge hat "+CAP(getuid(PL))+" umgebracht.\n");
         call_out("nimm_alles", 0);
         }     	
         
         
          nimm_alles()  {
  if(present("leiche", environment(TO)))  {
  command("nimm alles aus leiche");
   } 
     } 