/*

Dieser npc kann aus den blutstropfen der 4 goetzen waffen machen
wobei man immer tropfen aller 4 goetzen braucht...
jeder goetze hat 10 tropfen wobei man 4*10 fuer die waffe braucht
also von jedem goetzen 10 tropfen;

Der Wert fuer die waffe ist sicherlich eine Balancefrage, auch fixfactor
momentan sind die werte SICHER zu gut!!!
nur zu niedrig sollten sie auch nicht sein,
denn 1. ist es SAUSCHWER an die tropfen zu kommen,
und 2. wenn die waffen nicht wirklich EXZELLENT sind, holt sie ja auch keiner
soll ja ne art belohnung sein fuer die "Heldentaten",
man muss sicherlich an die 10-15 npcs umnieten bis man soweit kommt
und auch viele dinge machen..also forschen suchen denken usw
tnx
dante


dante sl 99
*/



inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#define TIME 5+random(5) 


//defines fuer die waffenwerte  ev auch hands hier setzen
//hier absichtlich noch nix drin

#define AXTWC 
#define SCHWERTWC
#define LANZEWC
#define DOLCHWC
#define PEITSCHEWC
#define HAMMERWC
#define STERNWC



#define AXTHA 
#define SCHWERTHA
#define LANZEHA
#define DOLCHHA
#define PEITSCHEHA
#define HAMMERHA
#define STERNHA

#define WARNUNG if(environment(TO)!=environment(TP))  {  tell_object(TP, BSA("Wenn Du meine Klause verlaesst, und ich den Kult vollendet habe, und Du dann nicht hier bist, so sind Deine Blutstropfen vergeudet gewesen! Also komm schnell zurueck!", "Der Mystagoge teilt Dir mit: "));  }


string owner="";
string zwaffe="";

init()  {
	::init();
if(interactive(TP))  {
	call_out("tag", 1);  }}
	
	tag()  {
		if(environment(TP)!=environment(TO))  return;
write(BS(
"Der Mystagoge durchdringt Dich mit einem Blick und nickt Dir freundlich zu."));
}
	
void create()
{
if (!is_clone(TO)) return;

::create();
SetProp(P_SHORT, "Ein uralter Mystagoge");

SP(P_LONG, BS(
"Der Mystagoge ist ein kleines, runzeliges Maennchen, dessen Koerper "
"sich unter der Last vieler Jahre gebeugt hat. Doch ein Blick in "
"seine Augen zeigen Dir, dass er mehr weiss und mehr kann als "
"Du und Deines gleichen zusammen. Sie leuchten rot und scheinen "
"Dich zu durchblicken. Ein Kampf mit ihm wuerde fuer Dich "
"fatal ausgehen. Du solltest ihn auch nach dem Teufel fragen!!!"));

AD(({"augen","auge"}),
"Sie leuchten unheimlich.");
AD("koeper",
"Er ist gebueckt und verdorrt.");

SetProp(P_NAME,"Mystagoge");
SP(P_NAME_ADJ, "uralt");
SetProp(P_GENDER, MALE);
AddId(({"NOWIMPY","mystagoge","priester"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 70]));
create_default_npc(30);
SetProp(P_HANDS, ({" mit seinen magischen Kuensten",500,({DT_MAGIC})}));
SetProp(P_BODY, 100);
SetProp(P_SIZE, 120);
SetProp(P_ALIGN, 1000);

SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:-1.0, DT_BLUDGEON:0.5,
DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:-0.6, DT_RIP:-0.7,
 DT_PIERCE:-0.7,DT_LIGHTNING:-1.0, DT_ELECTRIC:-1.0]));






AI(({"nekromanten","paladine","paladin","nekromant","nekropolis",
"unterwelt","saeurefall"}),
"Der weise Mann spricht nur einmal, also hoere mir gut zu. Fetter Bauch "
"bringt mehr Leute um als das Schwert! Ob Paladin, ob Nekromant, Tand "
"Tand ist alles aus Magier Hand!", "sagt leise: ");


SP(P_INFO, BS(
"Frag ihn doch einfach nach Kult!"));
AI(DEFAULT_INFO,({
	"laechelt nur freundlich.\n",
	"sagt: Die Zeit wird Dir helfen!\n",
	"deutet nur nach oben!\n",
	"sagt: Wer dies fragt, ist die Antwort nicht wert!\n",
	"sagt: Frag lieber Dich selbst!\n",
	"sagt: Nur ein Narr stellt diese Frage!\n",
	"sagt: Der Kult ist alt und so schweigt man besser!\n"}));
	

AI("insel",
"Sie wird da sein, wenn wir nicht mehr da sind.", "sagt: ");
AI(({"kult"}),
"Es gibt derer "
"4 Goetzen, jeder ein anderer mit anderen Reichen. Die "
"Zombies huldigen diesen Goetzen auf 4 kleinen Inseln. Dort "
"steht jeweils ein Altar. Mit dem richtigen Wort wird einer "
"der Goetzen erscheinen. Doch huete Dich! Sie greifen ohne "
"Warnung an! Das Blut der Goetzen ist pure, boese Magie. Ich kann "
"aus diesem Blut Waffen herstellen. Dabei hilft mit diese Statue. "
"Bring mir dir Tropfen, von jeder Sorte mindestens 1 Stueck und frag mich dann, "
"wenn Du sie hast nach der Statue.", "sagt: ");

AI("statue",
"Die Statue habe ich mir selbst erschaffen aus dem Blut der Goetzen. "
"Es ist erstarrt und daher nicht so gefaehrlich. Mit ihrer Hilfe "
"werde ich Dir Waffen erschaffen koennen, besser und gefaehrlicher "
"als es jeder irdische Schmied kann. Wenn Du mehr wissen willst, "
"so frage mich nach Waffen.", "sagt: ");

AI(({"blut","goetzenblut"}),
"Ich benoetige mindestens 10 Tropfen von jedem Goetzen, damit "
"ich eine Waffe erschaffen kann. Das Blut ist sehr gefaehrlich "
"und nur ein Meister im Zombiekult kann damit umgehen. Jeder "
"Goetze hat ein anderes Blut. Man kann es schon an der Farbe "
"erkennen.", "sagt: ");


AI(({"farbe","farben"}),
"Die Farben des Blutes haben boese Kraefte, doch mehr "
"will ich dazu nicht sagen.", "sagt: ");

AI(({"kraft","kraefte"}),
"Die Kraefte des Blutes sind dunkel und wenn Du versuchen "
"wuerdest hier eine Waffe zu erschaffen waere es Dein Tod!", 
"warnt: ");
AI("tod",
"Der Tod lauert hier ueberall.", "sagt: ");
AI(({"goetze","goetzen"}),
"Es gibt derer 4 mit unaussprechlichen Namen. Sie sind der "
"Mittelpunkt des Kultes der Zombies!", "sagt: ");

ARD("tafel",
"+-----------------------------------+\n"
"| Werter Fremder, liebe Fremde!     |\n"
"|                                   |\n"
"| Hier die Auswahl der Waffen:      |\n"
"|                                   |\n"
"| 1. Schwert                        |\n"
"| 2. Axt                            |\n"
"| 3. Lanze                          |\n"
"| 4. Dolch                          |\n"
"| 5. Peitsche                       |\n"
"| 6. Kampfhammer                    |\n"
"| 7. Goetzenstern                   |\n"
"|                                   |\n"
"| Mit <erschaffe waffenname>,       |\n"
"| also z.B.  <erschaffe axt>        |\n"
"| kann ich Dir die gewuenschte      |\n"
"| Waffe erschaffen.                 |\n"
"|                                   |\n"
"+-----------------------------------+\n");


AI(({"goetzenstern","zombiegoetzenstern","stern"}),
"Der Zombiegoetzenstern ist eine hinterhaeltige Waffe! Aber "
"sehr, sehr gut und leicht!", "sagt: ");



AI(({"peitsche","zombiegoetzenpeitsche","goetzenpeitsche"}),
"Die Zombiegoetzenpeitsche surrt toedlich durch die Luft. "
"Viele bevorzugen sie, doch nicht jeder kann sie fuehren!",
"sagt: ");
AI(({"kampfhammer","hammer","zombiekampfhammer","goetzenhammer",
"zombiegoetzenhammer"}),
"Der Kampfhammer schlaegt zu und hinterlaesst gemeinste Wunden. "
"Er zertruemmert alles was man will. Wenn man kann!",
"sagt: ");

AI(({"dolch","zombiegoetzendolch","goetzendolch"}),
"Der Zombiegoetzendolch ist scharf und brutal gut. Deine Gegner "
"werden erzittern!", "sagt: ");


AI(({"lanze","zombiegoetzenlanze","goetzenlanze"}),
"Die Zombiegoetzenlanze ist fuer ihre Laenge sehr leicht und "
"gut zu handhaben. Eine wahrlich meisterhafte Waffe! Doch "
"nicht jedem kann sie dienen.", "sagt: ");

AI(({"axt","zombiegoetzenaxt","goetzenaxt"}),
"Die Goetzenaxt ist eine schreckliche Waffe und macht gewaltigen "
"Schaden. Doch ohne Kraft nuetzt sie Dir nichts.");


AI(({"goetzenschwert","zombiegoetzenschwert","schwert"}),
"Das Zombiegoetzenschwert ist eine leichte und extrem gute Waffe! "
"Doch Du musst schon sehr gut sein um es verwenden zu koennen!");


AI(({"zombies", "zombie"}),
"Die Zombies sind harmlosen Kreaturen, arme Schweine. Sie sind "
"die Sklaven der Goetzen!", "sagt: ");

AI(({"virus","zombievirus"}),
"Tja, eine schlimme Sache, doch es gibt 2 Moeglichkeiten ihn "
"los zu werden. Zerfallos hat ein von mir gebrautes Antidot, "
"und ausserdem gibt es irgendwo unter der Insel bei den Zombies "
"einen Stachel, der eine Fluessigkeit absondert die heilend wirkt.", 
"sagt: ");
AI("antidot",
"Hilft sicher, aber teuer.", "sagt: ");

AI(({"stachel"}),
"Hmm, nicht weit von hier.", "sagt: ");
AI(({"fluessigkeit","fluessigkeiten"}),
"Ich zaubere mit ihnen sehr oft.", "sagt: ");
AI("mystagoge",
"Es gibt sicher mehrere, aber ich kenne nur mich.","sagt: ");
AI("dante",
"Ehrenzombie auf Lebenszeit!", "sagt: ");

AI(({"waffe","waffen"}),
"Die Waffen die ich hier mit Hilfe der Statue erschaffen kann, "
"sind das Beste was man in dieser Welt so kennt. Natuerlich sind "
"sie auch sehr schwer zu bekommen. Du musst 10 Tropfen Blut "
"von jedem der 4 Goetzen haben. Wenn Du eine Waffe haben willst, "
"so frag mich nach 'waffenart'.", "sagt: ");

AI(({"art","waffenart"}),
"Ich kann Dir hier jede mir bekannte Waffe erschaffen, wenn uns "
"der Kult gnaedig ist und wenn Du jeweils 10 Tropfen Blut hast! "
"Aber besser ist, wenn Du einfach diese unsichtbare Tafel liest!",
"sagt: ");



SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,3);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "entsteht aus einer Wolke");
SetProp(P_MSGOUT, "gleitet auf einer Wolke");
SetProp(P_MMSGIN, "taucht ploetzlich aus einer Wolke auf");
SetProp(P_MMSGOUT, "verschwindet im Boden");

SP(P_NOCORPSE, 1);

SP(P_DIE_MSG, "verfluessigt sich und ist auf einmal weg!\n");

SetProp(P_KILL_MSG, "Warum musstest Du mich auch provozieren!!!");
SetProp(P_KILL_NAME, "Ein uralter Mystagoge und seine Kunst");
SetProp(P_MURDER_MSG, "Wie konnten meine Kuenste nur so versagen?! Dante?!!?");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));




SetChats(2,({
"Der Mystagoge sagt: Je dunkler der Kult, desto groesser die Macht!\n",
"Der Mystagoge sagt: 1000 Jahre lebe ich schon hier.\n",
"Der Mystagoge schuettelt eine dunkle Flasche.\n",
"Der Mystagoge sucht ein altes Buch!\n",
"Der Mystagoge sagt: Kennst Du die Goetzen?!\n",
"Der Mystagoge sagt: Der Kult ist uralt!\n",
"Der Mystagoge mischt 3 Fluessigkeiten miteinander.\n",
"Der Mystagoge murmelt eine Formel und flucht dann.\n",
"Der Mystagoge kontrolliert den Altar.\n",
"Der Mystagoge versinkt in Trance.\n",
"Der Mystagoge meditiert.\n",
"Der Mystagoge betet am Altar.\n",
"Der Mystagoge durchdringt Dich mit seinen Blicken.\n",
"Der Mystagoge warnt Dich vor dem Zombievirus.\n"}));

AI(({"zerfallos","daemon","blitzdaemon","zombioid"}),
"Tja, Zerfallos betreibt die Kneipe im Norden. Der Daemon bewacht "
"ihn vor den Zombies!", "sagt: ");
AI("kneipe",
"Naja, kennst Du doch, die von Zerfallos!", "sagt: ");
AI("altar",
"Den Altar brauche ich um Waffen herzustellen.", "sagt: ");
AI("klause",
"Hier lebe, meditiere und zaubere ich!", "sagt: ");

AI("teufel",
"Der Teufel, besser gesagt eine Form von ihm, wohnt hier irgendwo an einem "
"Ort namens Inferno. Man einer ging einen Pakt mit ihm ein!!!", "sagt: ");

AI(({"inferno","pakt"}),
"Im Inferno kannst Du dem Teufel Deine Seele verkaufen! Wenn Du schon einen "
"Pakt mit dem Teufel hast, und diesen beenden willst, so kann nur ich Dir helfen! "
"Aber ich will als Gegenleistung einen magischen Trichter haben!!! Den gibt es hier auf der Insel irgendwo!!! "
"Komm einfach her und gib ihn mir!", "sagt: ");
AI("trichter",
"Ich glaube, der Trichter ist nicht an Land! Was immer das heisst!!! So genug verraten!",
"sagt: ");


ACD(({"erschaffe","erschaff"}), "make_zweapon");

}




void give_notify(object ob)
{
object pakt;
pakt=deep_present("TEUFEL_SEELE", TP);      
if(ob->id("magischer trichter"))  {

write("\n");

if(!pakt)  {
write(BSA(
"Danke fuer den Trichter! Aber Du hast keinen Pakt mit dem Teufel!",
"Der Mystagoge sagt: "));   }


if(pakt)  {
write(BSA(
"Danke fuer den Trichter! Ok, ich bemuehe mich!",
"Der Mystagoge sagt: "));
write("\n");

write(BS(
"Dann nimmt der Mystagoge ein altes Buch und beginnt eine Formel zu lesen. "
"Du verstehst ueberhaupt nichts! Dann zuckt der Mystagoge zusammen und faellt zu Boden! "
"Du hoerst lautes Toben und Bruellen aus der Tiefe! Ein Blitz faehrt in Dich und reisst Dich herum!"
" Der Mystagoge steht auf, hilft Dir auf die Beine und laechelt! Alles ist vorbei!"));
pakt->remove();
  write_file("/d/wasser/dante/zinsel/log/teufel",
    ctime()+": "+CAP(getuid(PL))+" beseitigt den Pakt!!!!!!\n");             
             
if(pakt)  {
pakt->destuct();  }

 } 
  }
 
   else
       ::give_notify(ob);
       }







int make_zweapon(string str)   {
	object blutblau, blutrot, blutgelb, blutgruen;
        object oldblau, oldrot, oldgelb, oldgruen;	
        object zweapon;
	NF(BS(
"Der Mystagoge sagt: Was soll ich Dir denn genau erschaffen?!"));

if(!str)   { return 0; }

if(zwaffe!="")  {
	write(BSA(
	"Momentan arbeite ich gerade an einer Waffe fuer "+capitalize(owner)+"! "
	"Komm etwas spaeter wieder! Dann stehe ich Dir gerne zu Diensten!", 
	"Der Mystagoge sagt: "));
  return 1; }
  
blutblau=deep_present("blautropfen", TP);
blutgelb=deep_present("gelbtropfen", TP);
blutrot=deep_present("rottropfen", TP);
blutgruen=deep_present("gruentropfen", TP);





if(!blutblau)  {
write(BSA(
"Aber "+TPN+", Du hast keine blauen Blutstropfen!",
"Der Mystagoge sagt: "));	
tell_room(environment(TO),
"Der Mystagoge sieht "+TP->name(WEN)+" tief in die Augen!\n", ({TP}));
return 1; }


if(!blutrot)  {
write(BSA(
"Aber "+TPN+", Du hast keine roten Blutstropfen!",
"Der Mystagoge sagt: "));	
tell_room(environment(TO),
"Der Mystagoge sieht "+TP->name(WEN)+" tief in die Augen!\n", ({TP}));
return 1; }



if(!blutgruen)  {
write(BSA(
"Aber "+TPN+", Du hast keine gruenen Blutstropfen!",
"Der Mystagoge sagt: "));	
tell_room(environment(TO),
"Der Mystagoge sieht "+TP->name(WEN)+" tief in die Augen!\n", ({TP}));
return 1; }




if(!blutgelb)  {
write(BSA(
"Aber "+TPN+", Du hast keine gelben Blutstropfen!",
"Der Mystagoge sagt: "));	
tell_room(environment(TO),
"Der Mystagoge sieht "+TP->name(WEN)+" tief in die Augen!\n", ({TP}));
return 1; }



//wenn amount zu wenig...

if(blutblau->QueryProp(P_AMOUNT)<10)  {
	write(BSA(
"Aber "+TPN+", Du hast keine 10 blauen Blutstropfen, sondern "
"nur "+blutblau->QueryProp(P_AMOUNT)+" Tropfen und das ist leider "
"zu wenig um eine Waffe zu erschaffen!", 
"Der Mystagoge sagt: "));
tell_room(environment(TO),
"Der Mystagoge sieht "+TPN+" belehrend an.\n", ({TP}));
return 1; }
	




if(blutrot->QueryProp(P_AMOUNT)<10)  {
	write(BSA(
"Aber "+TPN+", Du hast keine 10 roten Blutstropfen, sondern "
"nur "+blutrot->QueryProp(P_AMOUNT)+" Tropfen und das ist leider "
"zu wenig um eine Waffe zu erschaffen!", 
"Der Mystagoge sagt: "));
tell_room(environment(TO),
"Der Mystagoge sieht "+TPN+" belehrend an.", ({TP}));
return 1; }
	


if(blutgelb->QueryProp(P_AMOUNT)<10)  {
	write(BSA(
"Aber "+TPN+", Du hast keine 10 gelben Blutstropfen, sondern "
"nur "+blutgelb->QueryProp(P_AMOUNT)+" Tropfen und das ist leider "
"zu wenig um eine Waffe zu erschaffen!", 
"Der Mystagoge sagt: "));
tell_room(environment(TO),
"Der Mystagoge sieht "+TPN+" belehrend an.", ({TP}));
return 1; }
	



if(blutgruen->QueryProp(P_AMOUNT)<10)  {
	write(BSA(
"Aber "+TPN+", Du hast keine 10 gruenen Blutstropfen, sondern "
"nur "+blutgruen->QueryProp(P_AMOUNT)+" Tropfen und das ist leider "
"zu wenig um eine Waffe zu erschaffen!", 
"Der Mystagoge sagt: "));
tell_room(environment(TO),
"Der Mystagoge sieht "+TPN+" belehrend an.", ({TP}));
return 1; }

	
if(str=="waffe"||str=="waffen")  {
	write(BSA(
"Ja, mache ich gerne, doch welche Waffe willst Du haben?!",
"Der Mystagoge sagt: "));
	tell_room(environment(TO),
"Der Mystagoge sieht "+TPN+" fragend an.", ({TP}));	
return 1; }
	
	
if(!blutgruen->id("okblut"))  {
     blutgruen->destruct();
  
  write(BSA(
  "Netter Versuch zu betruegen, aber so sicher nicht.",
  "Der Mystagoge sagt: "));
  write_file("/d/wasser/dante/zinsel/log/betrug",
  ctime()+": "+CAP(getuid(PL))+" versucht zu betruegen!!!\n");
  return 1; }
     
	
if(!blutrot->id("okblut"))  {
     blutrot->destruct();
  
  write(BSA(
  "Netter Versuch zu betruegen, aber so sicher nicht.",
  "Der Mystagoge sagt: "));
  write_file("/d/wasser/dante/zinsel/log/betrug",
  ctime()+": "+CAP(getuid(PL))+" versucht zu betruegen!!!\n");
  return 1; }
     	
	
if(!blutblau->id("okblut"))  {
     blutblau->destruct();
  
  write(BSA(
  "Netter Versuch zu betruegen, aber so sicher nicht.",
  "Der Mystagoge sagt: "));
  write_file("/d/wasser/dante/zinsel/log/betrug",
  ctime()+": "+CAP(getuid(PL))+" versucht zu betruegen!!!\n");
  return 1; }
	
if(!blutgelb->id("okblut"))  {
     blutgelb->destruct();
  
  write(BSA(
  "Netter Versuch zu betruegen, aber so sicher nicht.",
  "Der Mystagoge sagt: "));
  write_file("/d/wasser/dante/zinsel/log/betrug",
  ctime()+": "+CAP(getuid(PL))+" versucht zu betruegen!!!\n");
  return 1; }
	
	
if(member(({"schwert","axt","peitsche","kampfhammer",
            "dolch","goetzenstern","lanze"}),str)!=-1)  {

 oldgruen=blutgruen->QueryProp(P_AMOUNT);	
 blutgruen->AddAmount(-10);		
 oldrot=blutrot->QueryProp(P_AMOUNT);	
 blutrot->AddAmount(-10);		
 oldgelb=blutgelb->QueryProp(P_AMOUNT);	
 blutgelb->AddAmount(-10);		
 oldblau=blutblau->QueryProp(P_AMOUNT);	
 blutblau->AddAmount(-10);		
 	
write(BS(
"Der Mystagoge blinzelt kurz und ploetzlich schweben jeweils "
"10 Blutstropfen von Dir zu ihm."));
tell_room(environment(TO),
"Der Mystagoge blinzelt kurz und ploetzlich schweben 40 "
"Blutstropfen von "+TPN+" zum Mystagogen.\n", ({TP}));

	write("\n");


  
write(BSA(
"Nun gut, Dein Wunsch ist "+capitalize(str)+"! So soll es sein "+TPN+"! Der "
"Kult kann toeten, doch auch helfen. Lass uns beginnen. Das Wichtigste ist, "
"dass Du waehrend ich hier arbeite anwesend bist, es wird nicht lange dauern.",
"Der Mystagoge sagt: "));


	tell_room(environment(TO),
"Der Mystagoge sagt: Gut, "+TPN+", ich erschaffe Dir was Du gewuenscht!\n", ({TP}));

zwaffe=""+str+"";
owner=getuid(TP);
call_out("mys1", TIME*2, owner, zwaffe);

return 1;
}


return 0; }
	
	
	
mys1()   {
WARNUNG
 tell_room(environment(TO),
 BS("Der Mystagoge nimmt ein Buch aus einem Regal und beginnt laut in einer Dir "
 "unbekannten Sprache zu lesen. Die Statue beginnt zu pulsieren und "
 "irgendwie scheint es, als lebe sie!"));
call_out("mys2", TIME,owner, zwaffe); 	}
 	
mys2()  {
WARNUNG	
	tell_room(environment(TO),
BS("Der Mystagoge beginnt nun einzelne Blutstropfen in die "
"vier verschiedenen Muender der Statue zu giesen. Die Statue stoehnt "
"und flucht in einer fremden Sprache. Dir wird unheimlich zu Mute!"));
call_out("mys3", TIME, owner, zwaffe);		
}


mys3()   {
	WARNUNG
tell_room(environment(TO),
BS("Der Mystagoge kniet sich vor den Altar und beginnt wie in Trance "
"zu murmeln. Die Statue verformt sich und die vier Gesichter "
"scheinen ploetzlich den Goetzen zu aehneln. Feuer und Rauch "
"quillt aus den vier Muendern und umhuellt den Mystagogen!!!"));	
call_out("mys4", TIME, owner, zwaffe);
}

mys4()   {
WARNUNG
tell_room(environment(TO),
BS(
"Blitze zucken aus den vier Gesichter auf den Mystagogen nieder. "
"Er scheint zu brennen, doch er rezitiert immer weiter in einer "
"uralten Sprache. Die Statue bebt und pulsiert nun wild. "
"Feuer lodert aus den Muendern. Der Hass der Goetzen scheint "
"sich am Mystagogen zu entladen!"));
call_out("mys5", TIME, owner, zwaffe);	
}


mys5()   {
	WARNUNG
tell_room(environment(TO),
BS("WUMMMMMMMMM!!! Ein lauter Knall und ploetzlich ist alles ruhig. "
"Die Statue scheint nicht mehr zu leben, der Mystagoge liegt "
"tot am Boden. Stille. Sollte der Kult der Zombies staerker als "
"die Kunst des Mystagogen gewesen sein und ihn umgebracht haben?!"));
call_out("mys6", TIME, owner, zwaffe);	
}

	
mys6()  {object waffe;
if(environment(TO)!=environment(TP))  {
	tell_object(TP,
BSA("Du wolltest ja nicht hoeren! So sind Deine Blutstropfen vergeudet!",
