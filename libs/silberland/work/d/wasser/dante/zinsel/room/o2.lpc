//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";
#include <mnpc.h>

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;


void create()
{
  ::create();

  farbe="gelb";
  dir="Osten";
  gang_details();


  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Der Saeulengang fuehrt von der oberen Saeulenhalle weg Richtung "+dir+". "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten scheinen direkt um Dich herumzutanzen. "));




  AD("farbe",
      "Hier ist alles in "+farbe+"er Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus.");
  AD(""+dir+"",
      "Im "+dir+" endet der Saeulengang an einem Tor.");
  AD("richtung",
      "Der Saeulengang fuehrt weiter nach "+dir+"! "
      "Doch ist da noch das "+farbe+"e Tor!");

  AD(({"fuss","fuesse"}),
      "Die Fuesse der Statuen bilden die Sockel der Saulen!!! He?! Was ist das?! "
      "Einer der Fuesse hat ungeschnittenen Naegel!");
  AD("naegel",
      "Die Naegel sollte man dringend schneiden!!! Aber wer weiss was dann passiert...");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");

  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");
  SP(P_KILL_NAME, "Die boese Macht der Zombieinsel");

  AIT("/d/wasser/dante/zinsel/npc/zo2", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));

  AE("westen", "./o1");




  NewDoor("osten", ("/d/wasser/dante/zinsel/room/o3"),
      ({"tor"}),
      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
       D_LONG, "Das "+farbe+"e Tor sieht blutverschmiert aus.\n",
       D_GENDER, NEUTER,
       D_SHORT, "Ein "+farbe+"es %ses Tor.\n",
       D_NAME, ""+farbe+"es Tor",
       } ));
  AddRoomMessage(({
        "Die Sockel der Statuen sehen sehr interessant aus!\n",
        "Einer der Sockel scheint sich zu bewegen.\n",
        "Die Spiegel ueber Dir blitzen kurz auf.\n",
        "Du denkst . o O '        '! Was nicht viel ist.\n",
        "Du solltest Dir die Goetzen naeher betrachten.\n",
        "Die Fuesse der Statuen vibrieren.\n"}), 20);



  ACD(({"schneide","schneid"}), "kick");
}

int kick(string str)  {
  NF("Was willst Du schneiden?!\n");
  if(str=="naegel"||str=="nagel")  {
    write(BS(
          "Du versuchst dem Goetzen die Naegel zu schneiden! "
          "Hast Du gedacht der Goetze laesst sich sowas gefallen?! "
          "Ein Blitz zuckt von einem der Spiegel ueber Dir herab, "
          "trifft Dich und Du wirst fortgeschleudert..."));
    say(BS(
          CAP_TPN+" bueckt sich und macht irgendetwas an einem Sockel."));
    TP->do_damage(5);
    TPM("/d/wasser/dante/zinsel/room/knast", M_GO+ M_NO_SHOW,
        "von einem Blitz weggeschleudert", "wird", "kommt hereingeflogen");

    return 1; 
  }

  return 0; 
}

