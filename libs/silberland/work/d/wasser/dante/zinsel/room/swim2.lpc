//dante sl 99
inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"


int hp=5;

void create()
{
  ::create();

  SSH("Mitten im Meer, nahe einer Insel mit Baum");
  SLO(BS("In einiger Entfernung siehst Du das Festland, von dem Du gekommen bist. "
        "Erst von hier kannst Du die wirklichen Ausmasse des Baumes erkennen. Er "
        "ist ja noch groesser als Du gedacht hattest. Viel gibt "
        "es hier sonst nicht zu sehen, naja ausser dem Meer.")); 


  AD("wasser",
      "Das Wasser ist hier voller Haie.");
  AD(({"hai","haie"}),
      "Die Haie sind hier sehr gefaehrlich.");
  AD("himmel",
      "Strahlendblau.");
  AD("boden",
      "Das Meer ist hier sehr tief.");

  AD("meer",
      "Du bist mitten drin.");
  AD("baum",
      "Den sieht man auch.");
  AD("insel",
      "Die liegt im Westen.");
  AD("westen",
      "Dorthin kann man schwimmen.");
  AD("ausmasse",
      "Der Baum ist wirklich sehr gross.");
  AD("land",
      "Das Festland, die Insel, liegt im Westen.");
  AD("festland",
      "Das Festland ist nicht weit von hier.");


  AD("entfernung",
      "In einiger Entfernung ist die Insel, aber ganz nahe ist "
      "eine schwimmende Tankstelle!!!");
  AD("tankstelle",
      "Es ist eine magische Tankstelle. Wie sie aussieht, kann man sich "
      "nicht vorstellen. Man kann hier tanken!!!");



  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]));

  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht und gluckst hier wild.");
  AddSound("meer",
      "Es rauscht hier recht laut.");

  AddCmd (({"schwimme", "schwimm"}), "swim");

  ACD(({"tanke","tank"}), "gut");
  AIT("/d/wasser/dante/zinsel/npc/shark", REFRESH_DESTRUCT,
      ([SP(P_AGGRESSIVE, 1)]));
  AIT("/d/wasser/dante/zinsel/npc/shark", REFRESH_DESTRUCT,
      ([SP(P_AGGRESSIVE, 1)]));
}

void reset() {
  ::reset();
  hp=5;  
}


void init() {
  ::init();
  if(interactive(TP))  { call_out("hallo", 0); }
}

void hallo() {
  if(!TP || environment(TP)!=TO) return ;
  write(BS(
        "Dieser Ort gefaellt Dir gut, auch wenn er gefaehrlich ist! "
        "Schau ihn Dir gut an, es lohnt sich sicher!"));
}


int gut()  {
  if(hp)  {
    say(BS(
          CAP_TPN+" tankt voll auf."));
    write(BS(
          "Du tankst an der magischen Tankstelle!!!"));
    TP->heal_self(50+random(50));
    hp--;
    return 1; 
  }
  if(!hp)  {
    write(BS(
          "Die Tankstelle ist momentan leider geschlossen!"));
    return 1; 
  }
  return 0; 
}			

int swim(string str )
{
  NF("Du schwimmst ein bisschen herum und gelangst immer wieder hier her.\n");

  if(!str)   {
    write(BS(
          "Du schwimmst ein bisschen im Wasser herum."));
    say(BS(
          CAP_TPN+" schwimmt um Dich herum und grinst."));
    return 1; 
  }

  if(member(({"nach westen", "zur insel", "zurueck", "zu insel"}),str)!=-1)  {
    {
      write(BS(
            "Du schwimmst in Richtung der grossen Insel."));
      this_player()->move("/d/wasser/dante/zinsel/room/isle_02", M_GO,
          "davon", "schwimmt", "kommt aus dem Wasser gestiegen");
      return 1;
    }

    return 0; 
  }
  return 0; 
}
