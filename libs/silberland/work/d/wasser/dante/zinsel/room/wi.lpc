//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/i_inh.lpc"
#include <mnpc.h>

string col;
string dir;
string name="ltopiukliht";

int g=1;

void create()
{
  ::create();

insel_details();

col="blau";
dir="osten";

  SetProp( P_INT_SHORT, "Auf einer sehr kleinen Insel" );
  SetProp( P_INT_LONG, BS(
"Du stehst nun hier auf einer kleinen Insel mitten im Meer. Eigentlich "
"ist die Insel ein einziger schroffer Fels. "
"Rund um Dich tost die hier sehr starke Stroemung und ab und zu "
"spritzen Wellen bis zu Dir herauf. "
"In einiger Entfernung kannst Du im "+capitalize(dir)+" die groessere Insel sehen, "
"von der Du durch die Saeulengaenge gekommen bist. Viel kann "
"man hier nicht sehen. Eine grossen, hohle Saeule, in der "
"der Aufzug manchmal anhaelt, das weite grosse Meer und einen "
"seltsamen, "+col+"en Felsquader."));




AD("marmor",
"Der Marmor ist blutverschmiert und man sieht kaum, das er einmal "
""+col+" war.");
AD(({"goetze","goetzen"}),
"Diese Statue stellt den Goetzen Ltopiukliht dar, den "
	"Bewahrer der Faeulniss.");
	
AD("bewahrer",
"Was er genau so tut, weiss keiner mehr.");
AD("faeulniss",
"Zombies verfaulen langsam.");

AD("ltopiukliht",
"Der Bewahrer der Faeulniss, ein stinkender Goetze?!");
	
AD(({"quader","felsquader"}),
"Der Quader besteht hier aus "+col+" Marmor. Er ist ueber und "
"ueber mit Blut besudelt und sieht ekelerregend aus. Das Blut "
"verschmiert eine Inschrift.");
AD("blut",
"Es ist das Blut derer, die auf diesem Altar geopfert wurden.");
AD("inschrift",
"Lies sie.");
ARD("inschrift",
"Murmle Worte mit viel Sinn, bist Du auch demnaechst dahin.");
AD("sinn",
"Welche Worte machen hier Sinn?");
JAEGER2


AD(""+dir+"",
"Dort liegt die groesser der Inseln, die mit dem Steg. Du kannst ja "
"veruschen nach "+capitalize(dir)+" zu schwimmen.");

AIT("/d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT,
([P_MNPC_FLAGS: MOV_INDOORS]));




ACD(({"schwimm","schwimme"}), "swim");

ACD(({"murmel","murmle"}), "come");
}

int come(string str)  {
	object ob;
	NF("Was willst du murmeln?!\n");

if(!str)  {
write(BS(
"Murmeln ist was sehr nettes!"));
 return 1; }
 
if(str=="wort"||str=="worte")  {
	write(BS(
"Du murmelst Worte, aber nichts passiert. So einfach scheint das nicht zu gehen."));
say(BS(
CAP_TPN+" murmelt irgendetwas..."));
return 1; }

if(str==""+name+"")  {
	
	if(present("goetze", TO))  {
	write(BS(
"Die Goetzen gibt es nur als Unikat!"));
 say(BS(CAP_TPN+" murmelt irgendetwas..."));	
 return 1; }
 
 if(g==0)  {
 	write(BS(
 "Du murmelst "+capitalize(name)+", der Altar bebt, doch sonst "
 "passiert nichts!"));
say(BS (CAP_TPN+" murmelt irgendetwas..."));
 return 1; }
 	
if(g==1)  {
	
	 write_file
 ("/d/wasser/dante/zinsel/log/goetze", ctime()+": "+CAP(getuid(TP))+" holt Ltopiuklith!\n");
	write(BS(
	"Du murmelst "+capitalize(name)+", der Altar bebt!!! "
	"Das Wasser scheint sich aufzubaeumen, Wellen schlagen hoch! "
	"Und vor Dir steht ploetzlich "+capitalize(name)+"!!!"));

say(BS(
CAP_TPN+" murmelt etwas Bedrohliches! Der Altar beginnt zu beben, "
"Wellen schlagen hoch und ploetzlich erscheint der Goetze "
""+capitalize(name)+"!!!"));
g=0;	 
 ob=clone_object("/d/wasser/dante/zinsel/npc/lt");
 ob->move(TO, M_GO+M_SILENT);
 return 1; }
 return 0; }
 return 0; }
 
 
 reset()  {
 	::reset();
 	g=1; }
 	
 
 





swim(string str )
 {
NF(BS(
 "Du versuchst im Meer zu schwimmen, doch die Stroemung treibt Dich "
 "sofort wieder an die kleine Insel zurueck."));

if(!str)  { return 0; }
 

if(member(({"nach "+dir+""}),str)!=-1)   {
	
write(BS(
"Du springst ins Wasser und schwimmst nach "+capitalize(dir)+"! "
"Die Stroemung hilft Dir dabei und so kommst Du gut voran!"));
   
this_player()->move("/d/wasser/dante/zinsel/room/wswim", M_GO,
"ins Meer und schwimmt hinaus", "springt", "kommt hier her geschwommen");
        return 1;
    }
return 0; }






