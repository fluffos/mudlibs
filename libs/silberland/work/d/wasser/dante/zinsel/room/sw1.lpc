//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;

int da=4;

void create()
{
  ::create();

farbe="violett";
dir="Suedwesten";
gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
"Der Saeulengang fuehrt von der unteren schwarzen Saeulenhalle weg Richtung "+dir+". "
"Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
"nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
"die in stabilen Haltern an den Waenden angebracht sind, "
"werfen unheimliche Schatten an die Waende und Decke. Die "
"Schatten scheinen direkt um Dich herumzutanzen."));


AD("farbe",
"Hier ist alles in "+farbe+"er Farbe gehalten.");
AD("marmor",
"Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
"sein. Eine unheimliche Kaelte geht von ihm aus.");
AD("kaelte",
"Als Du Dich ueber die Kaelte wunderst, entdeckst Du ein kleines "
"Hebelchen.");
AD("hebelchen",
"Das Hebelchen ist wirklich sehr klein. Was kann man damit wohl tun?!");
AD(""+dir+"",
"Im "+dir+" geht der Gang weiter.");
AD("richtung",
"Der Saeulengang fuehrt weiter nach "+dir+"!");

//

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur Deinen eigenen, schnellen Atem.");
    
  AddSound( ({DEFAULT_SOUND, "atem"}),
    "Schnell, fast panisch.");

AddSmell(({DEFAULT_SMELL,
"Es riecht nach Zombies."}));
AddSmell(({"zombie","zombies"}),
"Zombies stinken extrem.");


AE("nordosten", "./z2");
AE("suedwesten", "./sw2");
ACD(({"zieh","ziehe","druecke","drueck"}), "get_zt");

AddItem("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT);

AddItem("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT);

JAEGER2

}



int get_zt(string str)  {
	NF("Was willst Du ziehen?!\n");
if(member(({"hebelchen","am hebelchen", "an hebelchen", "hebelchen runter"}), str)!=-1)  {
	
	write(BS(
"Du ziehst das Hebelchen."));
say(BS(
CAP_TPN+" zieht einen Hebel."));

if(da)  {


	write(BS("Eine Geheimklappe geht auf und Dir faellt ein "
	"Zaubertrank direkt in die Haende. Du trinkst ihn sofort aus!"));
	
	say(BS(
	CAP_TPN+" scheint sich sehr zu freuen!"));
        da--;
      TP->heal_self(30+random(25));
	return 1; }

else {
	write(BS(
	"Nichts passiert."));
	return 1; }
return 0; }
return 0; }


reset()  {
    ::reset();
   da=3+random(3);
  }



