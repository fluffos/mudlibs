//dante sl 99 

inherit "std/room";
#include <moving.h>
#include <player.h>
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <mnpc.h>



create()
{
  ::create();

  SSH("Ein kleiner Pfad auf der Zombieinsel");
  SLO(BS(
        "Du hattest es fast erwartet: wiederum nur der Baum, die "
        "unendlichen Weiten "
        "des Ozeans, und jede Menge Sand. Tja, recht viel wird sich"
        " wohl auch hier "
        "nicht aendern. Aber Du kannst ja mal weitersehen," 
        " vielleicht entdeckst Du "
        "etwas, dass Dir beim ersten Hinsehen gar nicht aufgefallen ist. "
        "Auf jeden Fall entdeckst Du das kleine, steinerne Podest, auf dem "
        "ein seltsames Rohr angebracht ist."));

  AD("podest",
      "Das Podest steht am Boden und scheint aus Stein zu bestehen. Es ist "
      "quadratisch und scheint enorm schwer zu sein.");
  AD("stein",
      "Hmm, steinhart.");
  AD("rohr",
      "Das Rohr ist am Podest mit einer Stange befestigt. Irgendwie "
      "sieht es einem Fernrohr aehnlich.");
  AD("stange",
      "Die Stange haelt das Rohr am Podest.");

  AD("fernrohr",
      "Es ist auch ein Fernrohr. Schau einfach rein! <syntax: rohr >");




  AddDetail( ({ "seite", "seiten" }), 
      "Da und dort." );
  AddDetail( ({ "hinsehen" }), 
      "Schau genau!" );
  AddDetail( ({ "punkt", "beruehrungspunkt" }), 
      "Da treffen sich der Himmel und das Meer." );
  AddDetail( ({ "insel" }), 
      "Du stehst hier im Osten der kleinen Insel. Rundherum nur Wasser und "
      "natuerlich der grosse Baum." );
  AddDetail( ({ "ozean" }), 
      "Der Ozean erstreckt sich hier unendlich weit. Das Meer uebrigens auch." );
  AddDetail( ({ "menge" }), 
      "Hier liegt ueberhaupt recht viel Sand herum. Das hat diese Insel so auf "
      "sich." );
  AddDetail( ({ "fall" }), 
      "Das Podest ist hier. Ganz sicher." );
  AddDetail( ({ "sand" }), 
      "Der Sand ist hier braeunlich und sehr warm." );
  AddDetail( ({ "boden" }), 
      "Der Boden besteht aus Sand." );
  AddDetail( ({ "himmel" }), 
      "Der Himmel ist direkt ueber Dir. WOW!!!" );
  AddDetail( ({ "moegliche" }), 							
      "Du kannst, obwohl die Wassertiefe doch "	
      "stellenweise einige Meter betraegt, die Flora und Fauna so "		
      "genau erkennen.");

  AddDetail( ({ "wasser" }), 							
      "Das Wasser ist kristallklar, sodass Du alles "
      "Moegliche darin erkennen kannst. Hier waere es sicher nett, "
      "wenn man schwimmen ginge.");
  AD("meter",
      "Einige.");
  AD("fauna",
      "Fische beispielsweise.");
  AD(({"fisch","fische"}),
      "Wenn Du sie treffen willst, geh einfach schwimmen.");
  AD("flora",
      "Pflanzen.");
  AD(({"pflanze","pflanzen"}),
      "Angeblich wachsen hier unter dem Wasser viele Pflanzen.");


  AddDetail( ({ "horizont" }), 								
      "Der Horizont bildet den Beruehrungspunkt "	
      "zwischen Himmel und Wasser.");
  AddDetail( ({ "weiten", "weite" }), 							
      "Sie scheinen wie gesagt unendlich." );
  AddDetail( ({ "meer", "meere" }), 							
      "Nach allen Seiten erstrecken sich die "		
      "anscheinend unendlichen Weiten des Meeres bis an den "			
      "Horizont." );

  AddDetail( ({ "rinde" }), 								
      "Sie erscheint nicht ganz regelmaessig. Da und "		
      "dort auftretende Unebenheiten kannst Du bei genauerem "	
      "Hinsehen erkennen."  );
  AddDetail( ({ "blaetter" }), 								
      "Aeh.. Blaetter sollten Dir schon bekannt "	
      "sein, oder ?? Die Blaetter verdecken teilweise die trockene Rinde.");
  AD("baum",
      "Der alte Baum sieht hier etwas gesuender aus. Er traegt sogar "
      "einige Blaetter. Und da sieht man auch ein grosses Loch im Stamm!");

  AD(({"unebenheit","unebenheiten"}),
      "Sie verlaufen ueber den ganzen Baum. HE! Da ist ein grosses Loch im Stamm!");
  AD("stamm",
      "Im Stamm ist ein grosses, dunkles Loch!");
  AD("loch",
      "Es ist recht gross, Du kannst sicher reingehen!!!");

  AIT("/d/wasser/dante/zinsel/npc/aus", REFRESH_DESTRUCT);


  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]));
  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht sanft an der kleinen Insel vorbei!");
  AddSound("meer",
      "Es fliesst hier nicht allzu schnell vorbei.");


  AddCmd (({"schwimme", "schwimm"}), "swim");

  JAEGER2

    ACD("rohr", "schau");
  AddExit("nordwesten", "./isle_04");
  AddExit("sueden", "./isle_02");
  AE("rein", "./baum");



}


int schau()  {

  write("Du schaust in das Rohr uns siehst:\n");

  write(BS(
        "Ploetzlich wirst Du ganz klein und irgendeine Macht saugt Dich in "
        "das Rohr."));


  TPM("/d/wasser/dante/zinsel/room/inferno", M_GO,
      "ploetzlich vom Rohr eingesaugt", "wird",
      "erscheint mit Schwall und Knefelrauch");


  return 1; 
}

int swim(string str )
{
  NF("Wohin willst Du schwimmen?!\n");
  if( member( ({"aufs meer", "im meer", "ins meer", "in das meer", "meer",
          "durchs meer", "durch das meer", "aufs meer hinaus", "hinaus", "raus", "no",
          "auf das meer hinaus", "richtung meer", "in richtung meer"}),str)>-1 )
  {
    write( BS("Du huefpst ins Wasser, und schwimmst im Meer herum."));

    this_player()->move("/d/wasser/dante/zinsel/room/swim3", M_GO,
        "ins Meer und schwimmt hinaus", "springt", "kommt hier her geschwommen");
    return 1;
  }
  return 0; 
}
