//dante sl 99

inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
#include <mnpc.h>


reset()  {
	::reset();
	call_other("d/wasser/dante/zinsel/room/baum", "???");
	}

void create()
{
  ::create();

gang_details();


  SSH("In einer Hoehle unter der Zombieinsel");
  SetProp(P_INT_LONG, BS(
"Du befindest Dich nun tief unter der Insel. Hier erblickst Du "
"wieder eine Saeulenhalle. Aber hier ist der Marmor blutrot. "
"Die Saeulen sind keine gewoehnlichen, "
"runden Saeulen, sondern stellen kunstvoll gefertigte Goetzen dar, "
"deren Fuesse der Sockel sind und deren Koepfe bis an die Decke reichen. "
"In vier Himmelsrichtungen fuehren dunkle Gaenge. "
"In der Decke klafft ein grosses, schwarzes Loch, durch "
"das der Aufzug nach oben faehrt. Im Boden hingegen, sieht "
"man ein sehr grosses nach unten fuehrendes Tor, das voll mit seltsamen, aufgemalten Zeichen ist. "
"Es fuehrt in eine Kneipe und angeblich sogar weiter bis zu den Nekromanten!"));


AIT("/d/wasser/dante/zinsel/npc/aus", REFRESH_DESTRUCT);
AIT("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT);

AD(({"gaenge","gang"}),
"Die Gaenge verlassen die Halle in vier Himmelsrichtungen.");
AD(({"halle","saeulenhalle"}),
"Dies hier ist die obere Saeulenhalle. Von hier aus faehrt der Aufzug sowohl "
"nur mehr nach oben. Vier Gaenge verlassen die Halle.");

AD(({"richtung","richtungen","himmelsrichtung","himmelsrichtungen"}),
"In jeder der vier Himmelsrichtungen geht ein Gang weg.");

AD(({"nordewesten","suedwesten","suedosten","nordosten"}),
"Dort kannst Du hingehen, wenn Du mutig genug bist.");
AD("decke",
"Die Decke ist ebenfalls aus Marmor. Man erkennt inmitten der seltsamen "
"Spiegel ein grosses, dunkles Loch. Die Koepfe der Statuen stuetzen sie.");

AD("boden",
"Der Boden besteht aus Marmor der hier vorwiegenden Farbe. "
"Ein verworrenes Muster, das in den Marmor eingestanzt wurde, "
"zieht sich durch die ganze Halle. Ab und zu sieht man "
"dunkelrote Spuren. Ein Tor fuehrt schraeg nach unten. Es soll in "
"eine Kneipe fuehren und dann angeblich weiter zu den Nekromanten!!!");


AD("kneipe",
"Geh einfach runter!");
AD("stadt",
"Duester und sagenumwoben!");
AD(({"nekromant","nekromanten"}),
"Sie hausen dort unten!");

  AD("tor",
  "Das Tor fuehrt in einen Gang, der schraeg nach unten fuehrt. "
  "Seltsame Zeichen verzieren es.");
  AD("zeichen",
  "Neben den Zeichen ist eine kleine Inschrift. Die Zeichen sagen Dir leider nichts!");
  AD("inschrift",
  "Lesen.");
  ARD("inschrift",
  "Sei willkommen Fremder! Hier bist Du sicher!");
  
  
  AddDetail( ({ "system" }), 
    "Es soll recht kompliziert sein." );
  AddDetail( ({ "natur" }), 
    "Zombies haben sie erschaffen um den Goetzen zu dienen." );
  AddDetail( ({ "hoehle" }), 
    "Die Hoehle ist kuenstlicher Natur und ist eigentlich ein System aus "
    "Gaengen." );
  AddDetail( ({ "blutrot" }), 
"Rot wie Blut!");

  AddDetail( ({ "farbe" }), 
    "Die Farbe ist Blutrot." );
  AddDetail( ({ "loch", "loecher" }), 
    "In der Decke ist ein Loch, durch das der "
    "Aufzug faehrt." );
  AddDetail( ({ "marmor" }), 
    "Der Marmor glaenzt in blutroter Farbe." );
  AddDetail( ({ "aufzug" }), 
    "Der Aufzug faehrt hier nur nach oben." );

  AddDetail( ({ "himmel" }), 
                break_string( "In dieser abgeschlossenen Hoehle kannst Du den Himmel "+
               "nicht erkennen.", 78 ) );
 JAEGER2
 

AE("nordwesten", "./nw1");
AE("suedosten", "./so1");
AE("suedwesten", "./sw1");
AE("nordosten", "./no1");
ASE("unten", "check");
call_other("d/wasser/dante/zinsel/room/baum", "???");

}

init()  {
 ::init();
    if(!interactive(TP)) return;

    if(deep_present("ZV", TP))   return;
 
 if(deep_present("ZV_RESISTENT", TP))   return;


      if(!random(90))   {    
    call_out("gag", 1);}
    }
    
    
    
    gag()  {
    object ob;
    write(BS(
    "Eine schleimige Wurzel schiesst aus dem Boden und sticht Dich! WAHHHH!!! "
    "Was soll das denn?!?!?!"));
    
    ob=CLONEOB("/d/wasser/dante/zinsel/obj/zv");
    ob->move(TP, M_NOCHECK);
            }




int check() {

/*write (BS(
"Momentan geschlossen! Sorry!"));
return 1;
*/


 return TPM("/d/wasser/dante/zinsel/room/vor", M_GO,
 "durch das Tor nach unten", "schreitet", "kommt von oben herab");


}

