//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;

void create()
{
  ::create();

farbe="gruen";
dir="Sueden";

gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
"Hier endet der Saeulengang abrupt im "+dir+". Ein grosses Loch in der Decke scheint nach "
"oben zu fuehren. "
"Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
"nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
"die in stabilen Haltern an den Waenden angebracht sind, "
"werfen unheimliche Schatten an die Waende und Decke. Die "
"Schatten scheinen direkt um Dich herumzutanzen."));


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur Deinen eigenen, schnellen Atem.");
    
  AddSound( ({DEFAULT_SOUND, "atem"}),
    "Schnell, fast panisch.");

AddSmell(({DEFAULT_SMELL,
"Es riecht nach Zombies."}));
AddSmell(({"zombie","zombies"}),
"Zombies stinken extrem.");

AD("farbe",
"Hier ist alles in "+farbe+"er Farbe gehalten.");
AD("marmor",
"Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
"sein. Eine unheimliche Kaelte geht von ihm aus.");
AD(""+dir+"",
"Im "+dir+" endet der Saeulengang.");
AD("richtung",
"Der Saeulengang endet hier im "+dir+"!");
AD("decke",
"Die Decke ist auch aus Marmor. Doch sieht man hier neben den "
"seltsamen Spiegeln auch ein grosses Loch, das nach oben fuehrt.");
AD("loch",
"Du scheinst zu dem Loch nicht zu gelangen. Warte ein wenig...");

AddItem("/d/wasser/dante/zinsel/npc/zsnake", REFRESH_DESTRUCT,
([P_MNPC_FLAGS: MOV_INDOORS  ]));

AddItem("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT,
([P_MNPC_FLAGS: MOV_INDOORS  ]));
AIT("/d/wasser/dante/zinsel/room/slift", REFRESH_DESTRUCT, 1);



 NewDoor("norden", ("d/wasser/dante/zinsel/room/s2"),
          ({"tor"}),
          
    ({
        D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED | DOOR_NEEDKEY,
   D_LONG, "Das "+farbe+"e Tor sieht sehr stabil aus.\n",
                D_GENDER, NEUTER,
                D_SHORT, "Ein "+farbe+"es %ses Tor.\n",
                D_NAME, ""+farbe+"es Tor",
                                   } ));


}

