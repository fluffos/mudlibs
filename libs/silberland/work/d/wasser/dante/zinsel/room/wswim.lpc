/*
   schwimm raum fuer inzels
   dante sl 99
   */


inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"


string dir1="westen";
string dir2="osten";

int mag=3;

reset()  {
  ::reset();
  mag=3;  }


void create()
{
  ::create();


  SSH("Mitten im Meer, zwischen 2 Inseln");

  SLO(BS(
        "Du schwimmst mitten im Meer zwischen den Inseln herum. Im "+capitalize(dir1)+" liegt "
        "die Insel mit dem seltsamen Felsquader, im "+capitalize(dir2)+" sieht man die "
        "Insel mit dem alles ueberragenden grossen Baum, an der auch der Steg liegt. "
        "Allzu lange solltest Du hier nicht verweilen, denn angeblich "
        "ist dieser Teil des Meeres voller Haie. Das Wasser scheint hier besonders frisch zu sein."));


  AD(""+dir2+"",
      "Dort siehst Du die groessere der beiden Inseln, die mit dem Steg.");
  AD(""+dir1+"",
      "Dort ist die kleine, verfluchte Insel mit dem Quader."); 

  AD("wasser",
      "Das Wasser sprudelt und blubbert hier stark. Es scheint irgendwie "
      "anders zu sein. Schon wieder steigt eine kleine Blase auf!");
  AD("blase",
      "BLUBB!!! Vielleicht sollte man von diesem Wasser kosten?");
  AD("meer",
      "Du schwimmst gerade mitten darin.");
  AD("baum",
      "Den grossen, vertrockneten Baum sieht man sogar von hier.");
  AD("steg",
      "Der Steg ist von hier nicht zu sehen. Hoffentlich ist er noch da.");
  AD(({"hai","haie"}),
      "Schau Dich um, irgendwo lauert sicher einer auf Dich.");
  AD(({"inseln","insel"}),
      "Du siehst 2 Inseln von hier aus. Eine im "+capitalize(dir1)+", "
      "die andere im "+capitalize(dir2)+"!");
  AD(({"felsquader", "quader","fels"}),
      "Der ist von hier nicht zusehen, aber wenn Du sein schreckliches "
      "Geheimnis noch nicht entdeckt hast, solltest Du ihn Dir "
      "wohl noch einmal ansehen.");
  AD("geheimnis",
      "Angeblich muss man bestimmte Worte murmeln.");
  AD(({"wort","worte"}),
      "Wenn Du sie noch nicht kennst, solltest Du Dir den noerdlichsten "
      "Teil der grossen Insel genau ansehen!!!");
  AD("teil",
      "Wenn man Teil rueckwaerts schreibt bekommt man meistens Liet.");
  AD("liet",
      "Relativ sinnlos.");

  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]));
  AddDetail( ({ "tag" }), 
      "Schau zu, dass es nicht Dein letzter wird." );
  AddDetail( ({ "himmel" }), 
      "Der Himmel ist wolkenlos und strahlenblau. Ein herrlicher Tag!" );
  AddDetail( ({ "boden" }), 
      "Das Meer ist hier viel zu tief um den Boden zu sehen." );
  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht und gluckst hier wild.");
  AddSound("meer",
      "Es rauscht hier recht laut.");


  AddCmd (({"schwimme", "schwimm"}), "swim");
  ACD(({"koste","kost"}), "heilen");

  AIT("d/wasser/dante/zinsel/npc/shark", REFRESH_DESTRUCT, 
      ([SP(P_AGGRESSIVE, 0.05)]));

  AIT(({"d/wasser/dante/zinsel/npc/shark",
        "d/wasser/dante/zinsel/npc/stdfisch",
        "d/wasser/dante/zinsel/npc/stdfisch"}),
      REFRESH_DESTRUCT);

}

int heilen(string str)  {
  NF("Was willst Du kosten?\n");
  if(str=="wasser"||str=="von wasser")   {
    write(BS("Du kostest das seltsame Wasser."));
    say(BS(
          CAP_TPN+" kostet das Wasser."));
    if(mag)  {

      if(present("hai", environment(TP)))  {
        write(BS(
              "Der Hai stoesst Dich weg und Du wirst nie erfahren was das Wasser bewirkt!"));
        return 1; 
      }	
      else {

        write(BS(
              "Das Wasser scheint magisch zu sein. Deine Magie steigt!"));
        TP->restore_spell_points(25+random(15));
        mag--;   return 1; 
      }

      return 0; 
    }

    if(!mag)  {
      write(BS(
            "Das Wasser schmeckt nicht allzu gut."));
      return 1; 
    }
    return 0; 
  }
  return 0; 
}


swim(string str )
{
  NF(BS(
        "Du schwimmst herum, doch die Stroemung scheint Dich hier festzuhalten!"));

  if(!str)   {
    write(BS(
          "Du schwimmst ein bisschen im Wasser herum."));
    say(BS(
          CAP_TPN+" schwimmt um Dich herum und grinst."));
    return 1; 
  }

  if(member(({"nach "+dir2+""}),str)!=-1)  {

    write(BS(
          "Du schwimmst nach "+capitalize(dir2)+" in Richtung der grossen Insel."));
    this_player()->move("/d/wasser/dante/zinsel/room/isle_05", M_GO,
        "nach "+capitalize(dir2)+" davon", "schwimmt",
        "kommt aus dem Wasser gestiegen");
    return 1;
  }

  if(member(({"nach "+dir1+""}),str)!=-1)  {

    write(BS(
          "Du schwimmst nach "+capitalize(dir1)+" in Richtung der kleineren Insel."));
    this_player()->move("/d/wasser/dante/zinsel/room/wi", M_GO,
        "nach "+capitalize(dir1)+" davon", "schwimmt",
        "kommt aus dem Wasser gestiegen");
    return 1;
  }    
  return 0; 
}
