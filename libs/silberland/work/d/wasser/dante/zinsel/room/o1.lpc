//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";
#include <mnpc.h>

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;
int zo=3;


reset()  {
  ::reset();
  zo=3;
}


void create()
{
  ::create();

  farbe="gelb";
  dir="Osten";

  gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Der Saeulengang fuehrt von der oberen Saeulenhalle weg Richtung "+dir+". "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten bilden hier ein merkwuerdiges Muster, das Dich in seinen Bann zieht."));
  AD("bann",
      "Du singst . o O 'Let the spell be broken...lala, lala..'!\n");


  AD("muster",
      "Die Schatten bilden ein Kreis am Boden.");
  AD("boden",
      "Am Boden siehst Du einen Kreis aus Schatten.");
  AD("kreis",
      "In der Mitte des Kreises siehst Du einen Hebel!");
  AD("mitte",
      "Da ist ein Hebel.");
  AD("hebel",
      "Was macht man mit Hebeln?!");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");

  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");
  SP(P_KILL_NAME, "Die boese Macht der Zombieinsel");


  AD("farbe",
      "Hier ist alles in "+farbe+"er Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus.");
  AD(""+dir+"",
      "Im "+dir+" fuehrt der Gang weiter.");
  AD("richtung",
      "Der Saeulengang fuehrt weiter nach "+dir+"!");



  AE("osten", "./o2");
  AE("westen", "./z1");

  ACD(({"zieh","ziehe","drueck","druecke","beweg","bewege"}), "pull");

  AIT("/d/wasser/dante/zinsel/npc/zdog", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS, P_AGGRESSIVE: 0]));

}
int pull(string str)  {
  object ob;
  NF("Was willst Du ziehen/bewegen/druecken?!\n");
  if(str=="hebel"||str=="an hebel"||str=="am hebel")  {

    if( (!zo)||(TP->QueryProp(P_FROG)) )  {
      write(BS("Du ziehst am Hebel, doch nichts passiert."));
      say(BS(CAP_TPN+" zieht an einem Hebel!"));
      return 1; 
    }

    if(present("zombie", environment(TP)))  {
      write(BS(
            "Der Zombie schlaegt Dir auf den Kopf!\n"));
      TP->do_damage(10);
      say(BS(CAP_TPN+" wird vom Zombie geschlagen!"));
      return 1; 
    }
    if(zo)   {

      write(BS(
            "Du ziehst den Hebel und pploetzlich erscheint ein "+TPN+"zombie!!!"));
      say(BS(
            CAP_TPN+" zieht einen Hebel und erzeugt so einen Zombie!"));

      ob=clone_object("d/wasser/dante/zinsel/npc/zobild");

      ob->SP(P_SHORT, "Ein "+TPN+"zombie");
      ob->SP(P_NAME, ({""+TPN+"zombie",
            ""+TPN+"zombies",""+TPN+"zombie",""+TPN+"zombie"}));

      ob->SP(P_LONG,BS(
            "Das ist der "+TPN+"zombie. Ein genaues Ebenbild von "+TPN+", "
            "haesslich, eklig, zum Fuerchten!!!"));
      ob->move(environment(TP), M_TPORT+M_SILENT);	
      ob->SetChats(10,({
            "Der "+TPN+"zombie grinst Dich unheimlich an.\n",
            "Der "+TPN+"zombie scheint zu verfaulen.\n",
            "Der "+TPN+"zombie stinkt eklig.\n",
            "Der "+TPN+"zombie kriecht naeher zu Dir.\n",
            "Der "+TPN+"zombie sagt: "+TPN+" ist wirklich saubloed!\n",
            "Der "+TPN+"zombie sagt: He! "+TPN+", Du verfaulst ja!!!\n",
            "Der "+TPN+"zombie sucht "+TPN+".\n",
            "Der "+TPN+"zombie zerfaellt ein wenig.\n",
            "Der "+TPN+"zombie bohrt in seinen Augen herum.\n",
            "Der "+TPN+"zombie reisst Haut aus sich heraus.\n",
            "Der "+TPN+"zombie reisst sich einen Fingernagel aus.\n",
            "Der "+TPN+"zombie verliert Fleisch am Bein.\n"}));
      TP->AddPursuer(ob);
      zo--;
      return 1; 
    }
    return 0; 
  }
  return 0; 
}

