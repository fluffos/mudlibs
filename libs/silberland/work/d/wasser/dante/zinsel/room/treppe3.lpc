//uebergang von der zombieinsel zu den gildenraeumen
//der nekromanten dante sl 99


#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <room.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>


inherit "/d/wasser/dante/zinsel/room/tr_det.lpc";



create()
 {
 	::create();
treppe_details(); 

SP(P_INT_LONG, QP(P_INT_LONG)+"Die Treppe fuehrt hier "
"nach oben in Richtung der Halle und nach unten weiter in das Reich der Nekromanten.");



AE("oben", "./treppe2");
  AddExit ("unten", ([ EX_DEST: "/d/unterwelt/nekromanten/room/yaq_monoq/e1",
                      EX_MSG: "die Treppe nach unten",
                      EX_MSG_OUT: "geht vorsichtig",
                      EX_FUNC: "dam_fun_1",
           ]));

}

string dam_fun_1(string dir) {
  tell_object(TP, "Ploetzlich umgibt Dich Schwaerze und Du faellst ...\n");
  TP->AddHp(-random(50));
  return "/d/unterwelt/nekromanten/room/yaq_monoq/e1";
}
