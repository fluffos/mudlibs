//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;

int heilen=2;

void create()
{
  ::create();

farbe="weiss";
dir="Nordosten";
gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
"Der Saeulengang fuehrt von der unteren schwarzen Saeulenhalle weg Richtung "+dir+". "
"Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
"nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
"die in stabilen Haltern an den Waenden angebracht sind, "
"werfen unheimliche Schatten an die Waende und Decke. Die "
"Schatten scheinen hier aber ganz anders zu sein!!!"));



AD("farbe",
"Hier ist alles in "+farbe+"er Farbe gehalten.");
AD("marmor",
"Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
"sein. Eine unheimliche Kaelte geht von ihm aus.");
AD(""+dir+"",
"Im "+dir+" geht der Gang weiter.");
AD("richtung",
"Der Saeulengang fuehrt weiter nach "+dir+"!");
//


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur Deinen eigenen, schnellen Atem.");
    
  AddSound( ({DEFAULT_SOUND, "atem"}),
    "Schnell, fast panisch.");

AddSmell(({DEFAULT_SMELL,
"Es riecht nach Zombies."}));
AddSmell(({"zombie","zombies"}),
"Zombies stinken extrem.");


AD("schatten", 
"Die Schatten grinsen Dich freundlich an. Einer der Schatten sieht "
"aus wie eine Hexe!");
AD("hexe",
"Die Hexe grinst freundlich?! Ist es ein Schatten oder eine Hexe. "
"Sie scheint einen Korb zu tragen!");
AD("korb",
"Der Korb ist voller Pilze!");

AD(({"pilz","pilze"}),
"Die Pilze sind sehr lecker und haben gruene Beulen. Wenn man vergiftet ist und "
"diese Beulen betrachtet, so kann es sein, dass man geheilt wird!!!");

ASD(({"beule","beulen"}), "gift");

AE("suedwesten", "./z2");
AE("nordosten", "./no2");


AddItem("/d/wasser/dante/zinsel/npc/zo2", REFRESH_DESTRUCT);
AddItem("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT);


}
 string gift()  {
  
   if(TP->AddPoison()==0)  {
   	write(BS(
   	"Aber Du bist doch nicht vergiftet!"));
   return "";
}


if(!heilen)  {
	write(BS(
	"Du betrachtest Die Beulen, doch nichts passiert!"));
	return ""; }
	

if(heilen)   {
	write(BS(
"Du betrachtest die Beulen auf den Pilzen und bist geheilt!"));
TP->AddPoison(-20); //hmm geht auch eleganter egal:))
heilen--;
return "";	
}

}

reset()  {
	::reset();
	heilen=2; }
	
 	