#include "/players/dante/myowndefine.h"



void insel_details()   {

AD("entfernung",
"Du kannst den grossen Baum erkennen. Mehr nicht.");

AD("baum",
"Ach, waerst Du doch nicht in den Baum geklettert.");


AD(({"wellen","welle"}),
"Die Wellen schlagen hoch herauf, fast so als ob sie Dich in das "
"Meer reissen wollten.");
AD("angst",
"Die Angst vor diesem Ort steigt und steigt.");
AD("ort",
"Du willst hier weg und zwar schnell.");


AD(({"gaenge","saeulengaenge","gang","saeulengang"}),
"Die Gaenge sind weit weg und unter dem Meer.");
AD("aufzug",
"Der kann dich wieder von hier wegbringen. Vielleicht gibt es aber "
"auch eine bessere Loesung!");

AD("loesung",
"Schwimmen waere gut...aber wie und wohin...");


AddRoomMessage(({
	"Du fuehlst Dich hier nicht wohl.\n",
	"Dieser Ort scheint verflucht zu sein!\n",
	"Der Felsquader macht Dir Angst.\n",
	"Du wuerdest hier gerne wieder verschwinden.\n",
	"Irgendetwas ist hinter Dir.\n",
	"Du zuckst aengstlich zusammen.\n",
	"Du hoerst die Zombies unter Dir toben!\n",
	"Angst steigt hoch in Dir.\n",
	"Die Insel ist Dir unheimlich.\n"}),30);
	

AD("meer",
"Das Meer ist hier wild und stroemt sehr schnell vorueber. Die "
"Stroemung des Wasser ist sicher nicht ungefaehrlich.");
AD("wasser",
"Das Wasser ist dunkelblau, nein eher schwarz. Es wirkt sehr bedrohlich.");
AD("stroemung",
"Die Stroemung ist hier sehr schnell. Schwimmen koennte hier "
"schwer werden.");


AD(({"grosse insel","groessere insel"}),
"Die groessere Insel liegt gar nicht so weit von hier. Vielleicht "
"kann man ja irgendwie hinschwimmen.");

AD(({"kleine insel","kleinere insel"}),
"Du stehst auf der kleineren Insel. Insel ist fuer dieses "
"winzige Stueck Fels uebertrieben. Eigentlich sieht man hier "
"nur Fels und die seltsame Saeule. Achja, da ist noch der unheimliche "
"Quader."); 


ASD("altar", "show1");


AD("saeule",
"Die Saeule besteht aus Felsbrocken, die wilde Muster aufweisen.");
AD(({"brocken","felsbrocken"}),
"Die Felsbrocken wirden irgendwie verklebt. Sie stecken jedenfalls "
"fest ineinander und bilden eine Saeule, die innen hohl ist.");
AD("muster",
"Die Muster stellen eine boesartige Kreatur dar.");

AD(({"wort","worte"}),
"Worte, aber welche nur...");

AD("statue",
"Es ist einer der 4 Goetzen der Zombies.");

AD(({"fels","felsen"}),
"Der Fels ist wild zerklueftet und rauh. Das Meer hat ihm hart zugesetzt.");
AD("boden",
"Der Boden besteht aus harten, sehr groben Fels.");
AD("himmel",
"Der Himmel ist hier nicht so schoen wie auf der groesseren Insel. "
"Er ist voller Wolken, die Sonne sieht man kaum.");
AD(({"wolken","wolke"}),
"Die Wolken verheissen Dir Schlimmes.");
AD("schlimmes",
"Diese Insel hier ist Dir nicht geheuer, hau lieber ab!");


AD("stueck",
"Es ist nicht viel laenger als ein sehr grosser Elf.");
AD("elf",
"Naja, kennst Du doch diese Typen mit den spitzen Ohren.");
AD(({"typen","ohr","ohren"}),
"Zum hoeren.");



AD(({"insel","inseln"}),
"Du siehst hier zwei Inseln, die auf der Du stehst, die kleinere Insel, und "
"in einiger Entfernung die groessere Insel, die mit dem Steg.");
AD("steg",
"Den sieht man von hier nicht.");


AD("sonne",
"Die Sonne ist kaum zu sehen, und das was man sieht ist blutrot!");
AD("kreatur",
"Die Kreatur ist einer der 4 Goetzen der Zombies!");



AD(({"zombie","zombies"}),
"Dich kriegen sie auch noch. Sie opfern hier gerne kleine Wuerstchen "
"wie Dich!");
ASD("wuerstchen", "show2");

 SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:30]));   
SP(P_LIGHT, 1);
 AddSmell( DEFAULT_SMELL,
  "Das Wasser riecht hier irgendwie unheilvoll.");
  AddSmell(({"wasser","meer"}),
  "Es riecht gefaehrlich.");
  AddSound(DEFAULT_SOUND,
  "Das Meer rauscht laut an der kleinen Insel vorbei!");
  AddSound("meer",
  "Es fliesst hier sehr schnell vorbei.");
  


}

string show2()  {
	write(BS(
"Du bist ein Wuerstchen, "+TPN+", das wissen wir alle. Du bist "
"schliesslich erst Level "+TP->QueryProp(P_LEVEL)+"!"));
domainshout(BS(CAP_TPN+" ruft: Ich bin ein Wuerstchen!"));
return ""; }

 
string show1()  {
	write(BS(
	"Der Quader ist wirklich ein Altar. Hier opfern die Zombies einem "
      "ihrer Goetzen ab und zu einen "+TP->QueryProp(P_RACE)+"!!"));
      return ""; }
      


