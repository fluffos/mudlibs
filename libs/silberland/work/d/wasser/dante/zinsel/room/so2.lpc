//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;

int open=0;

void create()
{
  ::create();

farbe="tuerkis";
dir="Suedosten";

gang_details();
  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
"Der Saeulengang fuehrt von der unteren schwarzen Saeulenhalle weg Richtung "+dir+". "
"Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
"nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
"die in stabilen Haltern an den Waenden angebracht sind, "
"werfen unheimliche Schatten an die Waende und Decke. Die "
"Schatten scheinen direkt um Dich herumzutanzen."));

SP(P_KILL_NAME, "Die boese Macht der Zombieinsel");


AD("farbe",
"Hier ist alles in "+farbe+"er Farbe gehalten.");
AD("marmor",
"Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
"sein. Eine unheimliche Kaelte geht von ihm aus.");
AD(""+dir+"",
"Im "+dir+" geht der Gang weiter.");
AD("richtung",
"Der Saeulengang fuehrt weiter nach "+dir+"! Doch die unsichtbare Barriere haelt Dich auf!");

AD("barriere",
"Sehen kann an sie nicht. Doch da, Du entdeckst eine Vorrichtung!");
AD("vorrichtung",
"In der Wand eingelassen ist sie kaum zu sehen. Eigentlich "
"ist sie nur eine Oeffnung.");
AD("oeffnung",
"Sie ist kreisrund und Dir kommt ein Gedanke.");
AD("gedanke",
"Vielleicht kann man ja hier einen Hebel reinschieben.");
AD("hebel",
"Solltest Du versuchen.");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur Deinen eigenen, schnellen Atem.");
    
  AddSound( ({DEFAULT_SOUND, "atem"}),
    "Schnell, fast panisch.");

AddSmell(({DEFAULT_SMELL,
"Es riecht nach Zombies."}));
AddSmell(({"zombie","zombies"}),
"Zombies stinken extrem.");
AddItem("/d/wasser/dante/zinsel/npc/zo2", REFRESH_DESTRUCT,

([P_MNPC_FLAGS: MOV_OUTDOORS]));
JAEGER1


//gibt keine sinn, aber er soll sich net bewegen und wenn man 0 rein
//schreibt buggts denke ich...

AE("nordwesten", "./so1");
ASE("suedosten", "try");

ACD(({"schiebe","schieb"}), "auf");
}

reset() {
	::reset();
	open=0; }
	
int auf(string str)  {
	object ob;
	ob=deep_present("ZOMBIE_HEBEL", TP);
	NF("Was willst Du wo reinschieben?!\n");
 if(member(({"hebel in oeffnung","hebel in vorrichtung"}), str)!=-1) {
 	if(!ob)  {
 	write("Du hast keinen geeigneten Hebel!\n");
 	return 1; }
 
 if(present("zombie", TO))  {
 	write(BS(
 	"Der Zombie tritt Dich nieder!"));
 	TP->do_damage(5);  return 1; }
 	
 
 if(ob)  {
 	if(open==1)   {
 	write(BS(
 	"Die magische Barriere ist momentan nicht aktiviert! Also, was solls..."));
 	return 1; }
 if(open==0)  {
 	say(BS(
 	CAP_TPN+" oeffnet die Barriere!"));
 	write(BS(
 "Du schiebst den Hebel in die Vorrichtung und es surrt leise! "
 "Nun ist der Weg nach Suedosten frei!"));
 open=1;
 return 1; }	
 return 0; }
 return 0; }
 return 0; }
 				
 			

int try()  {
	if(!open)  {
 NF(BS("Eine unsichtbare Barriere haelt Dich auf! Doch irgendwie "
 "kann man hier sicher weiter."));		
}
if(open)  {
	return TPM("/d/wasser/dante/zinsel/room/so3", M_GO,
	"nach Suedosten", "geht", "kommt herein");  } }
	