//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define STR   15

#include <mnpc.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;
int da=1;

reset()  {
	::reset();
	da=1; }
	
void create()
{
  ::create();

farbe="violett";
dir="Suedwesten";

gang_details();
  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );

  SetProp( P_INT_LONG, BS(
"Hier endet der Saeulengang abrupt im "+dir+". "
"Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
"nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
"die in stabilen Haltern an den Waenden angebracht sind, "
"werfen unheimliche Schatten an die Waende und Decke. Die "
"Schatten scheinen direkt um Dich herumzutanzen. Was Dich aber hier "
"wirklich interessiert ist die enorm grosse Kiste, die mitten im "
"Saeulengang steht."));

AD("kiste",
"Die Kiste ist aus massivem Holz. Ein dickes Schloss sichert "
"die Kiste vor Dir.");
AD("schloss",
"Das Schloss scheint irgendwie seltsam zu sein, den Schluesselloch "
"siehst Du keines.");
AD(({"loch","schluesselloch"}),
"Nicht da, seltsam.");
AD("holz",
"Das Holz ist enorm dick und hart.");

AD("farbe",
"Hier ist alles in "+farbe+"er Farbe gehalten.");
AD("marmor",
"Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
"sein. Eine unheimliche Kaelte geht von ihm aus.");
SP(P_KILL_NAME, "Die boese Macht der Zombieinsel");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );


AD(""+dir+"",
"Im "+dir+" endet der Saeulengang.");


  AddSound( DEFAULT_SOUND,
    "Du hoerst nur Deinen eigenen, schnellen Atem.");
    
  AddSound( ({DEFAULT_SOUND, "atem"}),
    "Schnell, fast panisch.");

AddSmell(({DEFAULT_SMELL,
"Es riecht nach Zombies."}));
AddSmell(({"zombie","zombies"}),
"Zombies stinken extrem.");

AIT("/d/wasser/dante/zinsel/npc/zo3", REFRESH_DESTRUCT,
([ P_MNPC_FLAGS: MOV_INDOORS]));


AE("nordosten", "./sw2");

ACD(({"brich","breche"}), "get");
}

int get(string str)  {
	object ob1, ob2, ob3, ob4, ob5;
	
	NF("Was willst Du aufbrechen?!\n");
  if(str=="kiste auf"||str=="kiste")  {

if(present("zombie", TO))  {
	write("Der Zombie tritt Dich nieder!\n");
	TP->do_damage(10);
	return 1; }
	
 
  	if(TP->QueryAttribute(A_STR)<=STR)   {
 write(BS("Du versuchst die Kiste aufzubrechen, bist aber zu "
 "schwach dazu."));
 say(BS(CAP_TPN+" ist zu schwach um die Kiste aufzubrechen."));
 return 1; }
 
 if(!da)  {
 	write(BS(
 	"Du brichst die Kiste auf und staunst. "
 	"Die verfluchte Kiste ist leer. Dann schliesst Du "
 	"die Kiste wieder."));
 say(BS(CAP_TPN+" flucht laut ueber die Kiste."));
 return 1; }
 
 if(da)   {
 	write(BS(
 "Du brichst die Kiste auf und staunst!!! Edelsteine, Muenzen "
 "und andere wertvolle Dinge fliegen Dir entgegen!!! WOW!!!"));
 say(CAP_TPN+" bricht die Kiste auf und es regnet wertvolle Dinge!!!\n");
 write(BS("Du schliesst die Kiste wieder."));
 
 ob1=clone_object("/obj/money");
 ob1->SP(P_AMOUNT, 10000+random(10000));
 ob1->move(environment(TP));
"obj/gemmaster"->DistributeGem(5, 3,1, 1);

ob2=clone_object("/d/wasser/dante/zinsel/obj/wkey");
ob2->move(environment(TP));


ob3=clone_object("d/wasser/dante/zinsel/obj/magictrichter");
ob3->move(TO, M_GO);


ob4=clone_object("/d/dschungel/dante/weg/obj/dpilz");
ob4->move(environment(TP));

ob5=clone_object("/d/dschungel/dante/stein/obj/dgo");
ob5->move(environment(TP));


//gold silber einfuegen!!!!!!!!!!!!!! 




 da--;
 return 1; }
 return 0; }
 return 0; }
 
 	
