//dante sl 99 97 nostiarsch

inherit "std/transport";
#include <properties.h>
#include <moving.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

string col;


create()
{
  ::create();

col="gelb";

  SetProp( P_NAME, "Aufzug" );
  SP(P_NAME_ADJ, "uralt");
  AddId( ({ "aufzug", "lift" }) );
  SetProp( P_GENDER, MALE );
  SetProp( P_INT_SHORT, "In einem "+col+"en Aufzug" );
  SetProp( P_INT_LONG,
    "Du stehst hier in einem heruntergekommenen "+col+"en Aufzug.\n"
   "Er sieht schon ziemlich defekt aus, funktioniert aber anscheinend doch noch.\n"
	  );
  SetProp( P_SHORT, "Ein uralter "+col+"er Aufzug" );
  SetProp( P_LONG, BS(
    "Ein heruntergekommener "+col+"er Aufzug, bei dessen Anblick Dir Zweifel an der Funktionstuechtigkeit "
   "kommen. Vom Sicherheitsfaktor ganz zu schweigen.\n"
          ));
  SetProp( P_LIGHT, 1 );
  
  
  
  SetProp( P_DEPARTMSG, ({
    "Die Aufzugstueren schliessen sich, und der "+col+"e Aufzug verlaesst @@QueryArrived@@.\n", 
    "Die Aufzugstueren schliessen sich, und der "+col+"e Aufzug faehrt ab.\n"
  }) );
      
  SetProp( P_ARRIVEMSG, ({
    "Der "+col+"e Aufzug erreicht @@QueryArrived@@, und die Tueren oeffnen sich knarrend.\n",
    "Du hoerst ein Quietschen.\nTueren oeffnen sich, und geben den Blick in einen "+col+"en Aufzug frei.\n"
    }) );
    
  SetProp( P_ENTERMSG, ({
    "betritt aengstlich den "+col+"en Aufzug",
    "kommt zitternd in den "+col+"en Aufzug"
    }) );
	
  SetProp( P_LEAVEMSG, ({
    "verlaesst aengstlich den "+col+"en Aufzug",
    "verlaesst zitternd den "+col+"en Aufzug"
    }) );

     SetProp( P_LEAVEFAIL, ({
     "Die "+col+"e Aufzugstuer ist noch nicht offen",
     "ruettelt verzweifelt an der "+col+"en Aufzugstuer"
     }) );

  SetProp( P_ENTERFAIL, "Es passen nur 3 Passagiere in den "+col+"en Aufzug" );
  SetProp( P_MAX_PASSENGERS, 3 );
  AddDetail( ({ "arm", "beute", "finger" }), 
      "Sorry, ich habs eilig." );
  AddDetail( ({ "platte", "metall", "metallplatte" }), 
      "Das Metall scheint auch schon uralt zu sein." );
  AddDetail( ({ "meter" }), 
      "Connection reset by peer." );
  AddDetail( ({ "geruch", "geraeusch" }), 
      "Riechen oder lauschen..." );
  AddDetail( ({ "antrieb" }), 
      "Er scheint schon sehr alt aber noch funktionierend zu sein." );
  AddDetail( ({ "moder", "nase" }), 
      "IGITTT!!!" );
  AddDetail( ({ "platz", "person", "personen" }), 
      "Hier haben 3 Personen Platz." );
  AddDetail( ({ "himmel" }), 
      "Der ist hier nicht zu sehen." );

  AddDetail( ({ "decke", "liftdecke", "aufzugsdecke", "aufzugdecke", "oben" }), 
      "Die Decke ist, genauso wie Waende und Boden "
      "mit Dreck verschmiert und staubig. Igitt, wie kann ein Lift "
      "nur so verkommen.");
  AddDetail( ({ "film", "dreckfilm" }), 
      "Zaeh, schwarz und eklig - mehr willst Du "
      "nicht wissen.");
  AddDetail( ({ "dreck", "schmutz" }), 
      "Ein zaeher russiger Dreckfilm ueberzieht "
      "die Waende.");
  AddDetail( ({ "funktion", "funktionsweise", "weise" }), 
      "Tja man hoert zwar kein Geraeusch eines "
      "Antriebs, trotzdem bewegt sich der Aufzug. Seltsam, nicht ??");
  AddDetail( ({ "wand", "waende", "aufzugswand", 
        "aufzugswaende", "liftwand", "liftwaende", "aufzugwaende" }), 
      "Die Waende sind schon so verdreckt, dass Du "
      "das Holz, aus dem die Kabine eigentlich gemacht wurde, nur "
      "noch ansatzweise durchschimmern siehst.");
  AddDetail( ({ "staubmilben", "staubmilbe", "milbe", "milben" }), 
      "Die sind zu klein um sie zu sehen, aber es "
      "kratzt Dich in der Nase. Vielleicht hast Du ein paar "
      "aufgwirbelt, und eingeatmet.");
  AddDetail( ({ "netze", "netz" }), 
      "Da die Spinnen hier anscheinend keine Beute "
      "machen (Kakerlaken sind zu gross, Staubmilben zu klein), "
      "haben sie ihre Netze aufgegeben.");
  AddDetail( ({ "spinnen", "spinne" }), 
      "Ueberall haengen ihre nicht mehr verwendeten "
      "Netze herum. Da und dort kannst Du sogar eine ueber den "
      "Boden huschen sehen.");
  AddDetail( ({ "tier", "tiere" }), 
      "Naja Holzwuermer, Kakerlaken, Spinnen, "
      "Staubmilben, und so weiter.... Willst Du das wirklich SO "
      "genau wissen ??");
  AddDetail( ({ "kakerlaken", "kakerlake" }), 
      "Die haben sich schon wieder in der dicken "
      "Staubschicht vergraben, aber Du bist sicher, dass Kakerlaken "
      "nicht die einizgen Tiere sind, die hier in diesem Aufzug "
      "hausen.");
  AddDetail( ({ "holzwuermer", "holzwurm", "wurm", "wuermer" }), 
      "Man kann sie nicht sehen, aber vielleicht "
      "kann man sie ja hoeren.");
  AddDetail( ({ "loecher", "loch", "holzloecher", "holzloch" }), 
      "Die Loecher ruehren bestimmt von Holzwuermern "
      "her, die diesen Lift langsam, aber unaufhaltsam zerlegen. "
      "Wie lange wird dieser Lift also noch halten ?? Hoffentlich "
      "bist Du nicht zu schwer fuer ihn.");
  AddDetail( ({ "holz", "bretter", "holzbretter", 
        "brettern", "holzbrettern", "brett", "holzbrett" }), 
      "Die Bretter sehen ziemlich morsch aus. "
      "Ausserdem kann man kleine Loecher im Holz sehen. Also je "
      "mehr Du ueber diesen Aufzug heraus findest, desto "
      "unheimlicher wird er Dir.");
  AddDetail( ({ "staubschicht", "staub", "schicht" }), 
      "Du laesst Deine Finger in die Staubschicht "
      "graben. Ploetzlich krabbeln einige Kakerlaken an Deinem Arm "
      "hoch. Wild umdichschlagend kannst Du sie noch einmal "
      "abschuetteln. Sofort darauf verschwinden sie wieder im "
      "Staub.");
  AddDetail( ({ "platte", "metall", "metallplate" }), 
      "Sie ist mit einer dicken Staubschicht "
      "bedeckt. Anscheinend wurde dieser Lift schon laenger nicht "
      "mehr sauber gemacht.");
  AddDetail( ({ "boden", "aufzugsboden", "aufzugboden", "liftboden" }), 
      "Der Boden besteht aus einer circa ein mal ein "
      "Meter grossen Metallplatte.");
  AddDetail( ({ "kabine", "aufzugskabine", "aufzugkabine" }), 
      "Sie bietet gerade mal Platz fuer 3 Personen, "
      "und da wird es dann auch schon eng.");
  AddDetail( ({ "lift", "aufzug" }), 
      "Die Aufzugskabine wurde, so scheint es, notduerftig "
      "aus Holzbrettern schnell zusammen gezimmert. Die Funktionsweise "
      "des Liftes kannst Du jedoch nicht erkennen (und willst es auch "
      "nicht). Du bist schon zufrieden wenn Du heil ankommst.");

  AddSound( ({DEFAULT_SOUND}), "Man kann tatsaechlich schon die Holzwuermer nagen hoeren.");
  AddSmell( ({DEFAULT_SMELL}), "Der Geruch von Moder steigt Dir in die Nase.");

  AddCmd( ({ "betrete", "betritt"}), "enter_lift" );
  AddCmd( ({ "verlasse", "verlass"}), "leave_lift" );

  AddRoute("/d/wasser/dante/zinsel/room/oi", 5,5, "die kleine Insel",
    ({"insel","kleine insel","kleinen insel"}), "zu einer kleinen Insel");
  AddMsg("Der "+col+"e Aufzug faehrt wieder nach unten.\n", 2 );
  AddMsg("Der "+col+"e Aufzug wird langsamer.\n", 2 );

  AddRoute("/d/wasser/dante/zinsel/room/o3", 5,5, "den "+col+"en Saeulengang",
    ({"gang","saeulengang",col+"er gang",col+"er saeulengang",col+"en gang",col+"en saeulengang"}),
    "zum "+col+"en Saeulengang");
  AddMsg("Der "+col+"e Aufzug naehert sich der Oberflaeche.\n", 2 );
  AddMsg("Der "+col+"e Aufzug wird langsamer.\n", 2 );
  
Start();
}

enter_lift(string str)
{  
  if (str=="aufzug" || "lift")
    return Enter();
}

leave_lift(string str)
{  
  if (str=="aufzug" || "lift")
    return Leave();
}
