//klause des mytagogen
//fuer die zombies

#include "/players/dante/myowndefine.h"

inherit "std/room";
#include <room.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>



void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));   
  SetProp( P_INT_SHORT, "In der Klause des Mystagogen" );

  SetProp( P_INT_LONG, BS(
        "Das hier ist die Klause eines Mystagogen, in die er sich vor langer "
        "Zeit zurueckgezogen hat. Er meditiert und liest hier Buecher ueber "
        "mystische Rituale, die ihn unzaehligen Regalen an den Waenden lagern. "
        "Die restliche Einrichtung ist sehr karg. Ein Strohsack zum Schlafen, "
        "ein achteckiger Altar zum beten und meditieren und eine merkwuerdige "
        "Statue, deren Kopf 4 Gesichter hat. Im Norden kannst Du durch das Tor wieder "
        "die Kneipe von Zerfallos Zombioid betreten."));

  AIT("/d/wasser/dante/zinsel/npc/mys", REFRESH_DESTRUCT);

  AD("statue",
      "Die Statue besteht aus gefrorenem Blut, das der Mystagoge "
      "den Goetzen der Zombies abgerungen hat. Sie hat nur einen "
      "Kopf, der aber hat vier Gesichter.");

  AD("kopf",
      "Der Kopf hat vier Gesichter und jedes der Gesichter einen Mund.");
  AD(({"mund","muender"}),
      "Die Muender haben jeder eine Oeffnung. Da ist eine seltsame Stelle am Kopf!");
  ASD("stelle", "show");

  AD(({"oeffnung","oeffnungen"}),
      "Die Oeffnungen der Muender fuehren in das Innere der Statue!");
  AD(({"inneres","innere","innen"}),
      "In diese Oeffnungen fuellt der Mystagoge verschiedene Fluessigkeiten. "
      "Du aber kannst das nicht, denn Du wuerdes das nie ueberleben!");
  AD(({"fluessigkeiten","fluessigkeit"}),
      "Es handelt sich dabei um magische Fluessigkeiten, mit denen der "
      "Mystagoge seine Kulte ausfuehrt.");
  AD("meister",
      "Er weiss alles, sagt aber nicht viel.");

  AD("blut",
      "Das Blut ist steinhart und erstarrt.");

  AD(({"goetze","goetzen"}),
      "Die Goetzen sollen angeblich irgendwo hausen...");
  AD(({"gesicht","gesichter"}),
      "Die Gesichter blicken stumm und ausdruckslos. Ihre Muender sind offen!");

  AD("einrichtung",
      "Hier gibt es nur den Strohsack und die Regale.");
  AD(({"ritual","rituale"}),
      "Die Zombies haben dunkle Rituale, bei denen es meistens um "
      "das Opfern geht.");
  AD(({"opfer","opfern"}),
      "Sie opfern sehr gerne Leute wie Dich.");
  AD("leute",
      "Dich eben.");
  AD("altar",
      "Der Altar ist achteckig und dient dem Mystagogen zum beten und "
      "ausueben seiner Kunst.");
  AD("kunst",
      "Er ist ein wahrer Meister was Rituale und den Kult der Zombies betrifft.");
  AD(({"eck","ecken","ecke"}),
      "8!");
  AD(({"wand","waende"}),
      "Die Waende sind aus Stein. Ueberall stehen Regale an den Waenden.");
  AD(({"regale","regale"}),
      "Die Regale sind ebenfalls aus Stein gemacht. Sie sind voller "
      "alter Buecher.");
  AD(({"buch","buecher"}),
      "In den unzaehligen, modrigen Buecher steht fast alles was man "
      "ueber dunkle Kulte und Zombies wissen kann. Lies einfach eines!");
  ARD("buch",
      "Zejng pi wefniu bpiwewuipegj ewghjepi lwjhgepnui lkewgh wezb.\n"
      "Ffmewif lefhh Hmnceji KUdf Kkgh bboul wqwxepooh uvr jhfgftngg.\n\n"
      "Hmm, welche Sprache das wohl sein mag...");
  AD("sprache",
      "Was in den Buechern steht kann Dir der Mystagoge sagen.");
  AD("decke",
      "Die Decke ist hier sehr nieder und auch aus Stein. Eine kleine "
      "Oellampe erhellt die Klause.");
  AD(({"lampe","oellampe"}),
      "Sie haengt von der Decke und erzeugt ein schwaches Licht.");
  AD("licht",
      "Recht schwach, aber man erkennt genug.");
  AD("boden",
      "Der Boden besteht aus grobem Stein. Ein Strohsack liegt da.");
  AD("stein",
      "Der Stein ist grau und grob.");
  AD(({"sack","strohsack", "schlafen"}),
      "Der Strohsack dient dem Mystagogen zum Schlafen.");
  AD("stroh",
      "Etwas Stroh lugt aus dem Sack hervor. Es scheint auch schon sehr alt zu sein.");
  AD(({"halle","saeulenhalle"}),
      "Die Saeulenhalle liegt direkt ueber Dir.");
  AD("norden",
      "Da befindet sich die Kneipe von Zerfallos Zombioid.");
  AD("tor",
      "Das Tor fuehrt nach Norden in die Kneipe.");
  AD("klause",
      "Eine Klause ist eine weltabgeschieden Behausung, die "
      "zum Meditieren geeignet ist. Du stehst mitten drin.");
  AD(({"behausung","meditieren"}),
      "Dort lebt der Mystagoge schon seit ewig. Er soll viel ueber den Kult "
      "der Zombies wissen!");
  AD(({"kult","kulten"}),
      "Ein dunkler Kult.");
  AD("mystagoge",
      "Der Mystagoge ist ein Priester, der sich mit mystischen Kulten beschaeftigt.");
  AD("priester",
      "Er sollte Dich ueber den Kult der Zombies aufklaeren.");
  AD(({"zerfallos","zombioid", "zerfallos zombioid"}),
      "Der betreibt die Kneipe im Norden.");
  AD("kneipe",
      "Im Norden.");
  AD("zeit",
      "Seit die Zeit begann.");
  AD(({"zombies","zombie"}),
      "Die Zombies huldigen einen dunklen Kult.");  
  AD("insel",
      "Du stehst sozusagen unter ihr.");

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));   
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddSmell(DEFAULT_SMELL,
      "Hier riecht es nach alten Buechern.\n");
  AddSmell(({"buch","buecher"}),
      "Die Buecher sind modrig und teilweise verfallen."); 
  AddSound(DEFAULT_SOUND,
      "Es ist hier sehr still.");


  AddExit("norden", "./kneipe1");
}

string show()  {
  return BSA(
      "Hallo, "+TPN+"! Was fuehrt Dich zu uns?! Willst Du mehr ueber "
      "dunkle Rituale erfahren!? Besser nicht! Denn Deine "
      ""+TP->QueryProp(P_XP)+" Erfahrungspunkte sind ja doch etwas mickrig!",
      "Einer der vier Muender sagt: ");
}

