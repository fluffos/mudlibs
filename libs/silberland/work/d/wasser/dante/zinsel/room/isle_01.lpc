//
//dante sl 99

inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"


int amount;
int snake=3;
int da=2;
void create()
{
  ::create();

  amount=0;
  SSH("Ein kleiner Pfad auf einer kleinen Insel mit Baum");

  SLO(BS("Der gigantische Baum ueberschattet auch hier alles. Neben"
        " dem Pfad, dem Meer und dem Sand, siehst Du hier nichts Neues. "
        "Die ganze Insel scheint "
        "ein riesiger trostloser Huegel zu sein. Wo bist Du "
        "da nur gelandet."
        " Wenigstens sind hier und da wenigstens ein paar kleinere Buesche."
        " Das Meer scheint hier besonders gruen zu sein."));
  AD("neues",
      "Hier gibt es viel Neues, Du musst nur suchen.");

  AD("wasser",
      "Das Wasser sieht hier herrlich gruen aus. Die Stroemung bildet "
      "hier tiefe Wirbel.");
  AD("wirbel",
      "Sie drehen sich wie wild und reissen alles nach unten. Schwimmen "
      "ist hier nicht angeraten!!!");
  AD("stroemung",
      "Die Stroemung ist hier wild und verwirbelt.");
  AD("boden",
      "Der Boden ist hier auch aus Sand...");
  AD("sand",
      "Weisser, warmer Sand, fast so wie im Urlaub.");
  AD("urlaub",
      "Hier sicher nicht.");
  AD("insel",
      "Du bist noch immer auf der kleinen Insel, in deren Mitte "
      "dieser seltsame Baum steht.");
  AD("mitte",
      "Direkt vor Dir steht der Baum.");


  AD("meer",
      "Das Wasser ist hier so einladend frisch. Doch das taeuscht! "
      "Die Stroemung ist hier sehr wild!");
  AD("huegel",
      "Fuer einen echten Huegel ist sie aber etwas zu flach.");

  AD("pfad",
      "Der Pfad fuehrt hier nord- und suedostwaerts um die Insel herum.");



  AD("himmel",
      "Der Himmel ist wolkenlos. Ein Vogel fliegt gerade ueber Dich hinweg!");
  AD("vogel",
      "Es ist ein Kackavogel.");
  ASD("kackavogel", "get");

  AD("baum",
      "Der Baum ist auch hier nicht weniger ausgetrocknet. Hell und ausgebleicht "
      "steht sein Stamm da. Eigentlich verwunderlich, dass der Baum noch lebt.");


  AddDetail( ({ "ausbuchtung", "ausbuchtungen" }), 					
      break_string( "Tja, Du kannst ja mal reinfassen, wenn es Dich "	
        "wirklich interessiert, was drinnen ist.", 78 ) ); 			

  AddDetail( ({ "baumstamm", "stamm" }), 						
      break_string( "Durch eine korkig weisse Rinde erscheint der "
        "Stamm gut gegen das Wetter resistent zu sein.", 78 ) );
  AD("wetter",
      "Das Wetter hier ist heiss und trocken.");
  AD("rinde",
      "Die Rinde ist steinhart und weist viele Rillen auf.");
  AD(({"rille","rillen"}),
      "Die Rillen sind teilweise sehr tief und man hoert ein gefaehrliches "
      "Surren heraus. Du entdeckst auch eine Ausbuchtung am Stamm. "
      "In beide, Rillen und Ausbuchtung, kann man fassen, wenn man sich "
      "traut!");
  AD("surren",
      "Von wem koennte das sein!");
  AddSound("surren",
      "SSSSS SSSSSS SSSSSS!!!");

  SP(P_KILL_NAME, "Die boese Macht der Zombieinsel");

  AD("richtung",
      "Nach unten...");
  AddSpecialDetail( ({ "last" }), "may_find");
  AddDetail( ({ "wuchs", "wachstum" }), 
      break_string( "Sie wachsen in Richtung Boden, so als ob eine "+
        "Last sie niederdruecken wuerde.", 78 ) );
  AddDetail( ({ "busch", "buesche" }), 
      break_string( "Ein paar kleine Buesche lockern die Oede des "+
        "Sandes auf. Allerdings kommen sie Dir sehr seltsam vor. Irgend"
        "wie scheint der Wuchs des Busches abnorm.", 78 ) );
  AD("oede",
      "Langweilig und trostlos ist es hier.");


  AIT("/d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT);

  AIT("/d/wasser/dante/zinsel/npc/aus", REFRESH_DESTRUCT);  

  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]));
  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht sanft an der kleinen Insel vorbei!");
  AddSound("meer",
      "Es fliesst hier nicht allzu schnell vorbei.");

  AddCmd (({"fasse", "fass"}), "fasse");
  AddCmd (({"schwimme", "schwimm"}), "wirbel");
  AddExit ("norden", "./isle_05");
  AddExit ("suedosten", "./isle_enter");
}


int wirbel(string str)  {
  NF("Wo willst Du schwimmen?!\n");
  if(member(({"im meer","im wasser","in wasser","in meer",
          "raus","hinaus"}),str)!=-1)  {
    write(BS(
          "Du wolltest nicht hoeren und schwimmst hinaus auf das Meer! "
          "Wilde Wirbel erfassen Dich und druecken Dich unter Wasser! "
          "Du schlaegst mit dem Kopf gegen irgendetwas hartes und verlierst "
          "das Bewusstsein! Gut gemacht!"));
    say(BS(
          CAP_TPN+" springt doof wie "+TP->QueryPronoun(WER)+" ist ins "
          "Wasser und wird von einem Wirbel erfasst! Kurz danach wird "
          ""+TP->QueryPronoun(WER)+" wieder aus dem Wasser direkt vor Deine "
          "Beine geschleudert!"));
    TP->do_damage(10);
    TP->SetProp(P_PARALYZED, ([
          PARALYZE_TIME: 4+random(4),
          PARALYZE_MSG: "Aber Du bist doch total benommen!\n",
          PARALYZE_MSG_OTHER: "%s wird bewusstlos!\n",
          PARALYZE_END: "Du kommst wieder zu Sinnen!\n",
          PARALYZE_END_OTHER: "%s kommt dumm guckend wieder zu sich!\n"]));
    return 1;
  }
  return 0; 
}

string get()  {
  write (BS(
        "WAEHH!!! Genau als Du hinauf zum Kackavogel schaust, muss der "
        "Vogel mal!!! Und WUMMM!!! Er trifft Dich genau!!!"));
  TP->SetProp(P_SMELL, CAP_TPN+" stinkt erbaermlich nach Vogelkot!!!\n");
  domainshout(CAP_TPN+" wird gerade von Vogelscheisse getroffen!\n");
  return ""; 
}


int fasse(string str )
{
  object ob;

  notify_fail( "Huendchen fass, oder was ??\n");
  if (str == "in rille" || str == "rille" ||str=="in rillen")  {

    if(!snake)  {
      write(BS(
            "Du fasst in die Rille und irgenetwas beisst Dich!"));
      TP->do_damage(5);
      say(BS(
            CAP_TPN+" wird von irgendetwas gebissen!"));
      return 1; 
    }
    if(snake)  {	

      write(BS(
            "Du Narr greifst in die Rille und heraust kriecht eine "
            "Daemonenschlange!!!"));
      say(BS(""+CAP_TPN+" greift in eine Rille!!!"));
      snake--;
      ob=clone_object("/d/wasser/dante/zinsel/npc/zsnake");
      ob->move(environment(TP), M_GO+M_SILENT);
      ob->Kill(TP);
      return 1; 
    }
    return 0; 
  } 

  if( str == "in ausbuchtung" || str == "ausbuchtung")
  {
    if(amount<3)
    {
      if(present("\nei",TP))
      {
        write("Aber Du hast doch schon ein Ei, sei nicht so gierig.\n");
        return 1;
      }
      else
      {
        write("Du fasst in die Ausbuchtung und findest ein Ei.\n");
        say( TPN+" krammt in einer Rille herum.\n");
        clone_object("/d/wasser/dante/zinsel/obj/egg.lpc")->move(TP, M_NOCHECK);
        amount++;
        return 1;
      }
    }
    else
    {
      write("Da war wohl jemand schneller als Du, denn die Rille ist leer.\n");
      return 1;
    }
    return 0;
  }
  return 0;   
}




may_find()
{
  object ob;
  if(present("Lichtquelle", TP) || (!da) )
  {
    write(BS
        ("Anscheinend hat lange Zeit ein schwerer Gegenstand auf den Bueschen "
         "gelegen, allerdings scheint dieser Gegenstand nicht mehr da."));

  }
  else
  {
    da--;
    ob=clone_object("/obj/fackel");
    ob->move(TP, M_GET);
    write(BS("Oh sieh da. Es ist gar nicht das Wachstum "
          "abnorm, der Busch wurde nur von einer Fackel "
          "niedergedrueckt, die Du sofort zu Dir nimmst!" ));
  }
  return "";
}


void reset()  {
  ::reset();
  da=2;  
  amount=3;
  snake=3;
}

