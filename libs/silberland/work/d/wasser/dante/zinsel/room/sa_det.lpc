//uebergang von der zombieinsel zu den gildenraeumen
//der nekromanten dante sl 99


#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <room.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>



saeure_details()
{


  SetProp(P_LIGHT, 2);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));   
  SetProp( P_INT_SHORT, "Beim Saeurefall");
  SP(P_KILL_NAME, "Ein giftiger Saeurefall");

  SetProp( P_INT_LONG, BS(
        "Du stehst nun in einer unterirdischen Halle, die eine fast "
        "greifbare Aura des Todes verstroemt. In die Decke und in die "
        "Waenden sind tausende, nein, unzaehlige boese grinsende Fratzen "
        "gemeisselt worden, aus deren weit aufgerissenen Muendern"
        " Saeure fliesst. "
        "Die Saeure sammelt sich am Boden zu einem gewaltigen Strom, "
        "der als brodelnder "
        "Saeurefall in einem Loch, das genau in der Mitte der Halle liegt, "
        "verschwindet! "
        "Um dieses Loch herum ist sozusagen die Halle gebaut worden. "
        "Daempfe und Nebel aus "
        "purer Saeure steigen auf und die Luft wirkt dadurch"
        " wie heisses Gift!"));


  AD(({"daempfe","dampf"}),
      "Die Daempfe schweben gespenstisch auf und nieder.");
  AD("nebel",
      "Der Nebel laesst Dich alles nur ganz undeutlich sehen.... gruselig....");
  AD("luft",
      "Die Luft wirkt heiss und ist voller Saeure. Dieser Ort ist nicht "
      "gerade gemuetlich.");
  AD("ort",
      "Hier ist ein Zugang zu den Nekromanten.");
  AD("zugang",
      "Der Saeurefall.");

  AD("gift",
      "Die Saeure kriecht langsam aber sicher in Dich...");


  AD(({"fall","saeurefall"}),
      "Die Saeure sammelt sich am Boden als Strom und fliesst rauschend "
      "durch ein Loch nach unten. So entsteht ein gewaltiger Saeurefall, "
      "der ein Tor in das Reich der Nekromanten darstellt.");
  AD("tor",
      "Spring in den Saeurefall.");



  AD(({"wand","waende"}),
      "Die Waende sind voll mit Fratzen, die irgendein wahnsinniger "
      "Magier hier gemeisselt hat. Saeure rinnt herab und sammelt sich am Boden.");


  AD("aura",
      "Die Aura durchdringt Dich durch und durch. Hier scheinen die "
      "Nekromanten ihrem Reich ganz nahe zu sein.");
  AD(({"tod","todes"}),
      "Der Tod ist hier ueberall.");
  AD("decke",
      "In die Decke hat irgendein wahnsinniger Magier unzaehlige "
      "Fratzen gemeisselt, aus deren Muender Nebel und Daempfe austreten.");
  AD("magier",
      "Er muss wirklich sehr krank sein...");
  AD("saeure",
      "Die Saeure fliesst aus den Muendern der Fratzen und sammelt sich zu "
      "einem Strom der im Boden wieder verschwindet.");
  AD("strom",
      "Der Strom aus Saeure verschwindet gurgelnd und tosend im Boden.");
  AD("boden",
      "Der Boden ist mit Saeure ueberflutet. Sie verschwindet, versammelt "
      "zu einem Strom als Saeurefall in einem Loch.");
  AD(({"saeure", "saeurenebel"}),
      "Hier ist sie ueberall. Sie rinnt aus den Fratzen, sammelt sich am Boden, "
      "schwebt als giftiger Nebel um Dich herum.");
  AD("loch",
      "Das grosse Loch in der Mitte der Halle nimmt all die Saeure auf. "
      "Dort bildet sich der Saeurefall der nach unten stuerzt.");
  AD("mitte",
      "In der Mitte der Halle ist das grosse Loch. Man kann rund um das Loch "
      "herum gehen.");


  AD(({"mund","muender"}),
      "Die Muender sind starr weit aufgerissen. Saeure fliesst heraus!");
  AD(({"fratze","fratzen"}),
      "Die Fratzen grinsen Dich boese an. Unheimlich. Saeure rinnt aus "
      "ihren Muendern.");
  AD("reich",
      "Die Nekromanten hausen direkt unter Dir. Durch den Saeurefall "
      "kommt man in ihr Reich!");
  AD("halle",
      "Die Halle ist scheinbar recht weit und geraeumig, doch durch den "
      "dichten Nebel aus Saeure kann man nicht allzu weit sehen.");






  ASD(({"nekromanten","nekromant"}), "det_nekro");






  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));   
  SetProp( P_LIGHT,  0);
  SetProp( P_INDOORS, 1 );

  AddRoomMessage(({
        "Der Saeurefall rauscht laut.\n",
        "Die Saeure zischt und brodelt laut.\n",
        "Die Fratzen scheinen Dich zu verhoehnen.\n",
        "Saeure steigt Dir in die Nase.\n",
        "Das Rauschen scheint immer lauter zu werden.\n",
        "Das Tosen nimmt bedrohlich zu.\n",
        "Dir wird schwindlig beim Betrachten des Saeurefalles.\n",
        "Die Saeure fliesst unermuedlich aus den Muendern.\n",
        "Aus dem Loch kommt ein unheimliches Glucksen.\n",
        "Es zischt und broddelt im Loch.\n",
        "Saeurenebel steigt vom Boden auf.\n",
        "Schwaden aus Saeure umhuellen Dich.\n",
        "Saeuredaempfe steigen empor.\n",
        "Es rauscht sehr laut hier.\n"}), 30);


  AddSmell(DEFAULT_SMELL,
      "Hier riecht nach Saeure.\n"); 
  AddSmell(({"nebel","saeure", "saeurenebel"}),
      "Die Saeure riecht scharf und irgendwie toedlich..."); 
  AddSound(DEFAULT_SOUND,
      "Es rauscht und tost extrem laut hier.");
  AddSound("saeurefall",
      "Der Saeurefall tost laut!");
  AddSound(({"tosen","rauschen"}),
      "Es ist sehr laut hier.");



  ACD(({"spring","springe","kletter","klettere","steige","steig"}), "go_down");

}


int go_down(string str)   {

  NF("Wo willst Du hier hinein klettern/springen/steigen?!\n");

  if(str=="in saeurefall"||str=="in loch"||str=="in loch rein"||
      str=="in loch hinein"||str=="in den saeurefall hinein"||
      str=="in fall rein"||str=="in fall"||str=="ins loch"||
      str=="ins loch rein")   {

    write(BS(
          "Du springst todesmutigt in den Saeurefall hinein!")); 
    say(BS(
          CAP_TPN+" springt todesmutig in den Saeurefall hinein!"));


    if(TP->QP(P_GUILD)=="nekromanten")   {
      write(BS(
            "Du fuehlst Dich direkt wohl dabei! Willkommen zu Hause!"));
      say(BS(
            CAP_TPN+" grinst todesfreudig und gluecklich dabei!"));  

    }


    if(TP->QP(P_GUILD)=="paladine")   {	 		
      write(BS(
            "Dir als Paladin ist dabei nicht gut zu Mute!"));
      say(BS(
            CAP_TPN+" schaut aengstlich und fleht zu Dusty dabei!"));
    }

    else {
      write(BS(
            "Du hast ein komisches Gefuehl dabei!"));
      say(BS(
            CAP_TPN+" schaut nicht gerade gluecklich dabei aus!"));
    }	


    TPM("/d/wasser/dante/zinsel/room/treppe1", M_GO, 
        "im Saeurefall", "verschwindet", "stuerzt von oben herein");

    return 1; }

    return 0; }


    /*
       init()  {
       ::init();

       if(interactive(TP))  { call_out("start", 3);   }
       }

*/

    start()  {
      if(environment(TP)!= TO) return ;
      call_out("check", 58);  }
      //das hat den sinn nur kurze call outs zu erzeugen 
      //wenn ein spieler nur durchlaeuft..klar:-))) 

      check()  {
        if(environment(TP)!= TO) return ;

        if(TP->QP(P_GUILD)=="paladine")   {
          write(BS(
                "Der Saeurenebel frisst sich in Deine Lungen! AHHH!!!"));
          TP->do_damage(5); 
        }

        if(TP->QP(P_GUILD)=="nekromanten")  {
          write(BS(
                "Der Saeurenebel erfuellt Deine Lungen! Du fuehlst Dich besser!"));
          TP->heal_self(5);  }

          //10 mins = 50 punkte sollten der balance nicht zuh weh tun oder?!

        else  {
          write(BS(
                "Der Saeurenebel tut Dir nicht gut!"));
          TP->do_damage(2);  }

          call_out("check", 60);

      }



det_nekro()  {
  if(TP->QP(P_GUILD)=="paladine")   {
    return BS(
        "Du als Paladin hast panische Angst vor den Nekromanten!");  }

  if(TP->QP(P_GUILD)=="nekromanten")  {
    return BS(
        "Die Nekromanten herrschen hier! Sei gegruesst!");  }
  else {
    return BS(
        "Du erzitterst leicht, denn hier herrschen die Nekromanten!"); }}

