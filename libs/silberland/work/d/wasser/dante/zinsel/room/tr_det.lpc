//treppe im saeurefall zu den bzw von den nekros weg
//uebergang von der zombieinsel zu den gildenraeumen
//der nekromanten dante sl 99


#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <room.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>



treppe_details()
{


  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));   
  SetProp( P_INT_SHORT, "Im Saeurefall auf einer Treppe");  
  SetProp( P_INT_LONG, BS(
        "Du staunst, denn das hast Du hier nicht erwartet. Du stehst auf "
        "einer breiten Wendeltreppe, erbaut aus den Rippen der Opfer "
        "der Nekromanten. Die Treppe liegt mitten im Saeurefall, und merkwuerdiger "
        "Weise spritzt kein Tropfen Saeure hier her, obwohl rings um Dich "
        "die Saeure herabrast. Das Tosen und Rauschen der herabstuerzenden "
        "Saeure "
        "uebertoent hier alles, der Saeurefall umhuellt Dich wie ein "
        "toedlicher Mantel."));

  SP(P_KILL_NAME, "Ein giftiger Saeurefall");

  AddRoomMessage(({
        "Der Sauerefall rauscht laut herab.\n",
        "Saeuremassen stuerzen an Dir vorbei in die Tiefe.\n",
        "Die Treppe schwankt ein wenig.\n",
        "Saeure steigt Dir in die Nase.\n",
        "Das Rauschen scheint immer lauter zu werden.\n",
        "Das Tosen nimmt bedrohlich zu.\n",
        "Dir wird schwindlig beim Betrachten des Saeurefalles.\n",
        "Die Saeure stuerzt neben Dir herab.\n",
        "Es rauscht sehr laut hier.\n"}), 30);








  ASD(({"nekromanten","nekromant"}), "det_nekro");

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));   
  SetProp( P_LIGHT,  1);
  SetProp( P_INDOORS, 1 );


  AddSmell(DEFAULT_SMELL,
      "Hier riecht nach Saeure.\n"); 
  AddSmell(({"nebel","saeure"}),
      "Die Saeure richt scharf und irgendwie toedlich..."); 
  AddSound(DEFAULT_SOUND,
      "Es rauscht und tost extrem laut hier.");
  AddSound("saeurefall",
      "Der Saeurefall tost laut!");
  AddSound(({"tosen","rauschen"}),
      "Es ist sehr laut hier.");




}



/*
   init()  {
   ::init();

   if(interactive(TP))  { call_out("start", 3);   }
   }

*/

start()  {
  if(environment(TP)!= TO) return ;
  call_out("check", 58);  
}
  //das hat den sinn nur kurze call outs zu erzeugen 
  //wenn ein spieler nur durchlaeuft..klar:-))) 

void check()  {
  if(environment(TP)!= TO) return ;

  if(TP->QP(P_GUILD)=="paladine")   {
    write(BS(
          "Der Saeurenebel frisst sich in Deine Lungen! AHHH!!!"));
    TP->do_damage(5); 
  }

  if(TP->QP(P_GUILD)=="nekromanten")  {
    write(BS(
          "Der Saeurenebel erfuellt Deine Lungen! Du fuehlst Dich besser!"));
    TP->heal_self(5);  }

    //10 mins = 50 punkte sollten der balance nicht zuh weh tun oder?!

  else  {
    write(BS(
          "Der Saeurenebel tut Dir nicht gut!"));
    TP->do_damage(2);  }

    call_out("check", 60);
}



string det_nekro()  {
  if(TP->QP(P_GUILD)=="paladine")   {
    return BS(
        "Bald wirst Du von Deinen Todfeinden umgeben sein. Moege Dusty Dir "
        "Mut und Kraft geben!");  
  }

  if(TP->QP(P_GUILD)=="nekromanten")  {
    return BS(
        "Die Nekromanten herrschen hier! Sei gegruesst!");  
  }
  else {
    return BS(
        "Du erzitterst leicht, denn hier herrschen die Nekromanten!"); 
  }
}

