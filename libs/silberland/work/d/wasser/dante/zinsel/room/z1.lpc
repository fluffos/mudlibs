//dante sl 99

inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
#include <mnpc.h>

void create()
{
  ::create();

gang_details();

  SSH("In einer Hoehle unter der Zombieinsel");
  
  SetProp(P_INT_LONG, BS(
"Du befindest Dich nun direkt unter der Insel. Was Du hier erblickst "
"erstaunt Dich doch, denn eine Saeulenhalle aus schwarzem Marmor "
"haettest Du hier nie erwartet. Die Saeulen sind keine gewoehnlichen, "
"runden Saeulen, sondern stellen kunstvoll gefertigte Goetzen dar, "
"deren Fuesse der Sockel sind und deren Koepfe bis an die Decke reichen. "
"In alle vier Haupthimmelsrichtungen fuehren dunkle Gaenge. "
"In der Decke und im Boden klaffen grosse, schwarze Loecher, durch "
"die der Aufzug nach oben und unten faehrt."));


AD(({"gaenge","gang"}),
"Die Gaenge verlassen die Halle in alle vier Haupthimmelsrichtungen.");
AD(({"halle","saeulenhalle"}),
"Dies hier ist die obere Saeulenhalle. Von hier aus faehrt der Aufzug sowohl "
"nach unten, als auch nach oben. Vier Gaenge verlassen die Halle.");

AD(({"richtung","richtungen","himmelsrichtung","himmelsrichtungen",
"haupthimmelsrichtung","haupthimmelsrichtungen"}),
"In jeder der vier Haupthimmelsrichtungen geht ein Gang weg.");
AD(({"norden","sueden","osten","westen"}),
"Da kannst Du einen Gang entlang hingehen.");
AD("decke",
"Die Decke ist ebenfalls aus Marmor. Man erkennt inmitten der seltsamen "
"Spiegel ein grosses, dunkles Loch. Die Koepfe der Statuen stuetzen sie.");

AD("boden",
"Der Boden besteht aus Marmor der hier vorwiegenden Farbe. "
"Ein verworrenes Muster, das in den Marmor eingestanzt wurde, "
"zieht sich durch die ganze Halle. Ab und zu sieht man "
"dunkelrote Spuren. Ein grosses, dunkles Loch klafft darin.");

  
  AddDetail( ({ "system" }), 
    "Es soll recht kompliziert sein." );
  AddDetail( ({ "natur" }), 
    "Zombies haben sie erschaffen um den Goetzen zu dienen." );
  AddDetail( ({ "hoehle" }), 
    "Die Hoehle ist kuenstlicher Natur und ist eigentlich ein System aus "
    "Gaengen." );
  AddDetail( ({ "schwarz" }), 
    "Ein eher dunkles Schwarz. Nebenbei bemerkt, Schwarz ist recht oft dunkel, "
    "ausser es handelt sich um ein helles Schwarz." );
  AddDetail( ({ "farbe" }), 
    "Die Farbe ist Schwarz." );
  AddDetail( ({ "loch", "loecher" }), 
    "Sowohl in der Decke als auch im Boden ist jeweils ein Loch, durch das der "
    "Aufzug faehrt." );
  AddDetail( ({ "marmor" }), 
    "Der Marmor glaenzt dunkel und hat eine schwarze Farbe." );
  AddDetail( ({ "aufzug" }), 
    "Der Aufzug faehrt hier nach oben und nach unten." );
  AddDetail( ({ "himmel" }), 
                break_string( "In dieser abgeschlossenen Hoehle kannst Du den Himmel "+
               "nicht erkennen.", 78 ) );
 
JAEGER2

AE("westen", "./w1");
AE("sueden", "./s1");
AE("osten", "./o1");
AE("norden", "./n1");

AIT("/d/wasser/dante/zinsel/npc/aus", REFRESH_DESTRUCT);
//AIT("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT);

call_other("d/wasser/dante/zinsel/room/baum", "???");
}


init()  {
 ::init();
     if(!interactive(TP)) return;
     
         if(deep_present("ZV", TP))   return;
     
         if(deep_present("ZV_RESISTENT", TP))  return;
         
               if(!random(100))   {
                   call_out("gag", 1); }
          }
          
          
     gag()  {
         object ob;
             write(BS(
                 "Ein Stachel schiesst aus dem Boden und sticht Dich! WAHHHH!!! "
                     "Was soll das denn?!?!?!"));
                     
                         ob=CLONEOB("/d/wasser/dante/zinsel/obj/zv");
                             ob->move(TP, M_NOCHECK);
                                         }
            reset()  {
	::reset();
	call_other("d/wasser/dante/zinsel/room/baum", "???");
}
                                   