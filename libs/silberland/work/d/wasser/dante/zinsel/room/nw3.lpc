//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;
string *wer;
int i;
int befreit=0;


void create()
{
  ::create();

  farbe="orang";
  dir="Nordwesten";

  gang_details();

  wer=({
      "Mensch","Hobbit","Zwerg","Troll","Elf","Oger","Magier",
      "Erzmagier","Regionsmagier"});
  i=random(sizeof(wer));

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Hier endet der Saeulengang abrupt im "+dir+" an einer "
        "staehlernen Kerkertuere. "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten scheinen direkt um Dich herumzutanzen."));


  AD(({"tuer","tuere","kerkertuere","kerkertuer"}),
      "Die Kerkertuere scheint aus sehr stabilem Stahl zu sein. "
      "Ein einfacher, schwerer Riegel sichert sie.");
  AD("stahl",
      "Schwarzer Stahl. Du erkennst Buchstaben an der Tuere.");
  AD("buchstaben",
      "Lies sie.");
  ARD("buchstaben",
      "GHON VIFIV JKGFBHJK KZUFZKHJB!!!\n"
      "Hmm, scheint wohl zombinisch oder sowas zu sein...");
  AD("riegel",
      "Der Riegel ist sicher recht schwer, trotzdem kannst Du versuchen "
      "ihn aufzuheben und so die Tuere zu oeffnen.");



  AD("farbe",
      "Hier ist alles in "+farbe+"er Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus.");
  AD(""+dir+"",
      "Im "+dir+" endet der Saeulengang.");
  AD("richtung",
      "Der Saeulengang endet hier im "+dir+"!");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");
  AddSound( "wimmern",
      "Jetzt hoerst Du kein Wimmern mehr.");

  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");



  AE("suedosten", "./nw2");

  ACD(({"hebe","heb"}), "up");

  AddRoomMessage(({
        "Du glaubst Schreie aus dem Nordwesten zu hoeren.\n",
        "Irgendetwas scheint von Innen an der Kerkertuere zu ruetteln.\n",
        "HILLLLLLLLLLLFFFFFFFFEEEEEEEE!!!\n",
        "Du glaubst ein Wimmern zu hoeren.\n",
        "[Tod: Ein Jojogeist] Warum hast Du mich auch so genervt, Dante?!\n",

        "Hat da nicht gerade irgendjemand um Hilfe gerufen?!\n"}),5);

  AD("kerker",
      "Der Kerker liegt wohl im Nordwesten, direkt in der Mauer.");

  AD("mauer",
      "In die Mauer hat man hier einen Kerker gebaut.");

  AIT("/d/wasser/dante/zinsel/npc/zdog", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));

  AIT("/d/wasser/dante/zinsel/npc/zdog", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));
  AIT("/d/wasser/dante/zinsel/npc/zo3", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));
}

int up(string str)  {
  object ob, ob1;
  ob1=present("zombie", environment(TP));

  NF("Was willst Du aufheben?!\n");
  if(str=="riegel"||str=="riegel auf"||str=="riegel an")   {

    if(ob1)   {
      write("Du wirst von "+ob1->name(WEM)+" von der Kerkertuere weggestossen!\n");
      ob1->Kill(TP);
      say(CAP_TPN+" wird von "+ob1->name(WEM)+" von der Tuere weggestossen!\n");
      return 1; 
    }


    if(befreit==1)   {
      write(BS("Du hebst den Riegel hoch und oeffnest die Kerkertuere. "
            "Beissender Gestank stroemt Dir entgegen und Du schliesst die "
            "Tuere sofort!"));
      say(BS(CAP_TPN+" hebt den Riegel hoch und ploetzlich stinkt es "
            "widerlich im Saeulengang. "+TPN+" schliesst die Tuere sofort!"));
      return 1; 
    }

    if(!befreit)  {

      write(BS(
            "Du hebst den Riegel hoch und im selben Moment stoesst jemand "
            "von innen die Tuere auf und stuerzt heraus. Es ist ein armer "
            ""+wer[i]+", der hier gefangen gehalten wurde. Aus Dankbarkeit "
            "faellt der "+wer[i]+" Dir um den Hals, schenkt Dir etwas und "
            "laeuft auch schon in Richtung Oberflaeche davon!!!"));
      say(BS(CAP_TPN+" hebt den Riegel hoch und im selben Moment "
            "stoest auch schon ein "+wer[i]+" die Tuere von Innen auf und "
            "stuerzt heraus. Der halbverhungerte "+wer[i]+" faellt "+TPN+" um "
            "den Hals und laeuft dann wie irr davon. War wohl hier gefangen!"));
      ob=clone_object("/d/wasser/dante/zinsel/obj/gruenkey");
      ob->move(TP, M_GET);
      befreit=1;
      return 1; 
    }
    return 0; 
  }
  return 0; 
}



void reset()  {
  ::reset();
  befreit=0;
}

