inherit "std/room"; 

#include "player.h"
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
int schluessel;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Gang" );
  SetProp( P_INT_LONG, 
      "Du befindest Dich in einem schmalen Gang der nach Westen und Osten fuehrt. "
      "Zombies scheint es hier keine mehr zu geben oder doch?! Gruenliche "
      "Daempfe schweben hier herum und erschweren Dir das atmen. Woher sie kommen "
      "kann man nicht erkennen. Gemuetlich ist es hier aber nicht. "
      "Der Boden scheint aber "
      "aufgeraeumt zu sein, helle Fackeln erleuchten den Gang und "
      "werfen lustige Schatten an den Waenden. Du wunderst Dich, dass die "
      "Daempfe nicht explodieren. In "
      "jede der vier Haupthimmelsrichtungen kann man gehen.\n"
      "Eine Tafel.\n");    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );    
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail("tafel",
      "Die Tafel kann man lesen.");
  AddReadDetail("tafel",
      "+-----------------------------------------+\n"
      "|                                         |\n"
      "|      ERBAUT IM JAHRE EINS NACH DER      |\n"
      "|                                         |\n"
      "|        SCHRECKLICHEN ENTDECKUNG         |\n"
      "|                                         |\n"
      "|             DIESER INSEL                |\n"
      "|                                         |\n"
      "|         UND IHRER GRAUSAMEN             |\n"
      "|                                         |\n" 
      "|            BEWOHNER!!!                  |\n"
      "|                                         |\n"
      "|       GEWIDMET DEN UNZAEHLIGEN          |\n"
      "|                                         |\n"
      "|      GEFALLENEN UND VERMISSTEN          |\n"
      "|                                         |\n"
      "|          ZOMBIEJAEGERN.                 |\n"
      "|                                         |\n"            
      "+-----------------------------------------+\n"); 
  AddDetail( ({ "betrachten" }), 
      "Du betrachtest das Betrachten." );

  AddDetail(({"zombies","zombie"}),
      "Die Zombiejaeger haben all das hier erbaut, um sich vor den Zombies "
      "verteidigen zu koennen.");  
  AddDetail(({"jaeger","zombiejaeger"}),
      "Die Zombiejaeger leben, wenn sie noch leben, meistens hier.");

  AddDetail(({"wand","waende"}),
      "Die Wand ist sehr regelmaessig behauen worden. Einige "
      "Loecher und Furchen hat sie aber doch. Mehrere Fackeln haengen an der "
      "Wand und erleuchten den Gang.");
  AddDetail(({"fackel","fackeln"}),
      "Sie flackern unruhig, spenden aber trotzdem genug Licht.");
  AddDetail(("licht"),
      "Man kann eigentlich alles recht gut erkennen.");
  AddDetail("gang",
      "Du stehst ein einem Gang den die Zombiejaeger in den Felsen geschlagen haben..");
  AddDetail(("rest"),
      "Geh nach Osten!");
  AddDetail(({"loch","loecher"}),
      "Die Loecher sind voellig leer und uninteressant. Nicht in jedes Loch kann "
      "man greifen.");
  AddDetail(({"furche","furchen"}),
      "Beim naeheren Betrachten der Furchen entdeckst Du ein kleines Kaestchen, "
      "das versteckt in einer Nische haengt.");
  AddDetail(("nische"),
      "In einer Nische in der Wand haengt ein kleines Kaestchen.");
  AddDetail(("kaestchen"),
      "Das Kaestchen ist klein, schwarz und aus Metall. Es sieht sehr interessant aus.");
  AddDetail(("metall"),
      "Denk nicht ueber das Metall nach, sondern lieber ueber das Kaestchen.");

  AddDetail(("boden"), 
      "Der Boden ist hier sauberer und nicht so mit Felsen uebersaeht. Du "
      "erkennst eine Stelle am Boden, die Dich amuesiert...");
  AddDetail(("stelle"),
      "Auf dieser Stelle muss ein armer Waechter den ganzen Tag stehen und "
      "aufpassen, das hier alles ruhig bleibt. Seine Fuesse haben "
      "schon tiefe Abdruecke hinterlassen.");
  AddDetail(({"abdruck","abdruecke"}),
      "Der Waechter steht hier scheinbar immer...");
  AddDetail(("waechter"),
      "Tja, er scheint nicht da zu sein...");
  AddDetail(("fuesse"),
      "Er muss wohl Plattfuesse haben.");
  AddDetail(("plattfuesse"),
      "Nachdenklich betrachtest Du Deine eigenen Fuesse.");
  AddDetail(("tag"),
      "In der Nacht auch.");
  AddDetail(("nacht"),
      "Sicher sehr einsam in der Nacht hier alleine.");  
  AddDetail(("decke"),
      "Die Decke kann man trotz der Fackeln schlecht erkennen. Das einzige "
      "was Dir auffaellt sind einige grosse, schwarze Flecken und ein grosses Loch.");
  AD("loch",
      "Durch das Loch kommt man wieder nach oben.");

  AddDetail(({"fleck","flecken","flecke"}),
      "Es sind Russflecke, die von oben dunkel herunterschimmern.");
  AddDetail(({"russflecken","russflecke","russfleck"}),
      "Die heisse Luft steigt von den Fackeln nach oben und schwaerzt die Decke.");
  AddDetail(("luft"),
      "Manche Leute reden auch heisse Luft...");
  AddDetail(("leute"),
      "Ich nenne keinen Namen.");
  AddDetail(({"name","namen"}),
      "Auch keine Namen.");
  AddDetail(({"fels","felsen"}),
      "Hier liegen nur sehr wenige und kleine Felsen herum.");

  AddDetail( ({"hoehle"}),
      "Die Hoehle verzweigt sich hier nach Norden, Westen, Osten und Sueden.");
  AddDetail(({"haupthimmelsrichtungen","haupthimmelsrichtung"}),
      "Norden, Osten, Westen und Sueden.");
  AddDetail(({"himelsrichtung","himmelsrichtungen"}),
      "Hier sind leider nur die Haupthimmelsrichtungen gemeint...");
  AddDetail(({"richtung","richrungen"}),
      "Hmmm, der Osten zieht Dich magisch an.");


  AD(({"dampf","daempfe"}),
      "Sie schweben gruen und giftig umher.");
  AD(({"schatten"}),
      "Sie tanzen spassig an den Waenden herum.");

  AddDetail("westen",
      "Im Westen geht der Gang weiter und es sieht sehr unheimlich aus.");
  AD(({"zerfallos", "kneipe"}),
      "Du kennst das doch...");
  AddDetail("osten",
      "Im Osten fuehrt der Gang weiter...");
  AddDetail("sueden",
      "Im Sueden liegt ein sehr merkwuerdiger Raum.");
  AddDetail("raum",
      "Geh hin!");    
  AddDetail("norden",
      "Im Norden ist die Zentrale der Zombiejaeger.");
  AddDetail("zentrale",
      "Besuch sie unbedingt.");

  JAEGER2


    /*
       NewDoor("sueden", ("/d/wasser/dante/zinsel/room/bar3"),
       ({"tuere","tuer","metalltuere","metalltuer"}),

       ({
       D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED,
       D_LONG, "Die Metalltuere sieht sehr sauber aus. Sie glaenzt und blitzt "
       "wie frisch poliert.",
       D_GENDER, FEMALE,
       D_SHORT, "Eine %se Metalltuere.",
       D_NAME, "Metalltuere",
       } ));

*/

    AddSound (DEFAULT_SOUND,
        "Man hoert leise Musik aus den Osten.\n");
  AddSound("musik",
      "Nein, Du hast Dich geirrt.\n");
  AddSmell(DEFAULT_SMELL,
      "Es riecht nach nichts.");

  // AddItem("/d/dschungel/dante/geist/npc/waechter2", REFRESH_DESTRUCT);

  AddCmd(({"oeffne","oeffnen"}), "open");

  schluessel=0;

  AIT("/d/wasser/dante/zinsel/npc/garto.lpc", REFRESH_DESTRUCT);


  AE("oben", "./z2");

  AddExit( "osten", "./vor2"); 
  AddExit( "westen", "./saeure1");     
  ASE( "norden", "nix");
  ASE( "sueden", "nix");
}




int nix()  {
  write( BS(
        "Am Quartier der Zombiejaeger wird noch gebaut."));
  return 1;
}	



int open(string str)
{
  object ob;
  notify_fail( "Was willst Du oeffnen?\n" );
  if (str !="kaestchen") return 0;

  if (!schluessel)
  {
    write("Du oeffnest das Kaestchen, doch leider ist es leer. Enttaeuscht "
        "schliesst Du es wieder.\n");
    say(CAP_TPN+" oeffnet ein Kaestchen, schliesst es aber sogleich wieder.\n");
    return 1;
  }
  else
  {
    write("Du oeffnest das Kaestchen und findest darin einen Schluessel, "
        "den Du sofort zu Dir nimmst. Danach schliesst Du das Kaestchen wieder.\n");
    say(""+TPN+" oeffnet ein Kaestchen und scheint darin etwas zu finden. "
        "Danach schliesst er das Kaestchen wieder.\n");
    ob=clone_object("/d/wasser/dante/zinsel/obj/keyerna");
    ob->move(TP, M_NOCHECK);

    schluessel--;

    return 1;
  }
  return 0;
}



void reset()
{
  schluessel=0;
  ::reset();
}


