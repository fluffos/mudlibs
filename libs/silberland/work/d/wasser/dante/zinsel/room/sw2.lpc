//dante inh fuer zinsel 99
/*

BITTE HIER EIN TELEPORTOR!!!!!!!!!!!!
Die Spieler sollen ja wenigstens die anreise leicht haben....
der rest is eh sauschwer um alles zu kriegen...
DANKE!!!!!!!!!!!!!

*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include <wizlevels.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;

void create()
{
  ::create();
  gang_details();
  farbe="violett";
  dir="Suedwesten";


  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Der Saeulengang fuehrt von der unteren schwarzen Saeulenhalle weg Richtung "+dir+". "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten scheinen direkt um Dich herumzutanzen. Im Suedwesten "
        "scheint etwas sehr Interessantes zu sein."));


  AD("farbe",
      "Hier ist alles in "+farbe+"er Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus.");
  AD(""+dir+"",
      "Im "+dir+" geht der Gang weiter.");
  AD("richtung",
      "Der Saeulengang fuehrt weiter nach "+dir+"!");
  //

  AD("interessantes",
      "Das weisst Du noch nicht, aber sicher ist, das es von "
      "den Zombies bewacht wird.");
  AD(({"zombie","zombies"}),
      "Hmm, wo sind die wohl?!");

  AD(""+dir+"",
      "Im "+dir+" geht der Saeulengang weiter.");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");

  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");

  AIT("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT,
      ([ P_MNPC_FLAGS: MOV_INDOORS]));

  AIT("/d/wasser/dante/zinsel/npc/zo2", REFRESH_DESTRUCT,
      ([ P_MNPC_FLAGS: MOV_INDOORS]));

  AE("nordosten", "./sw1");
  AE("suedwesten", "./sw3");
  AddGuardedExit("suedwesten", "/d/wasser/dante/zinsel/room/sw3",
      "zombie", "Der Zombie tritt Dich weg!\n");


}
