//uebergang von der zombieinsel zu den gildenraeumen
//der nekromanten dante sl 99


#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <room.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <mnpc.h>



create()
{
  ::create();


  SetProp(P_LIGHT, 1);
   SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));   
  SetProp( P_INT_SHORT, "In einem sauerehaltigen, unterirdischen Gang" );

  
  SetProp( P_INT_LONG, BS(
"Ein schmaler Gang erstreckt sich hier von Westen nach Osten. "
"Du erschrickst, denn die Waende sind vollgeschmiert mit frischen Blut, das "
"zu Boden tropft. Dichter Saeurenebel macht Dir das Atmen schwer. Aus "
"dem Westen hoerst Du ein lautes Tosen und Rauschen. Viel mehr kann man hier nicht "
"erkennen, denn der Saeurenebel raubt Dir nicht nur den Atem, sondern auch "
"die Sicht. Im Osten klafft eine Oeffnung in der Wand, im Westen scheint der "
"Gang naeher an die Quelle des Rauschen zu fuehren."));


AD(({"tosen","rauschen"}),
"Lausche besser...");
AD("atem",
"Der Nebel erschwert das Atmen! Er kann auch giftig sein...");
AD("atmen",
"Der Saeurenebel scheint in Dich zu kriechen.");
AD("sicht",
"Allzu weit kann man hier wegen des Nebels nicht sehen. Irgendetwas scheint aber hier zu sein.");
AD(({"etwas","irgendetwas"}),
"Hinter Dir, vor Dir, irgendwo...");
AD("quelle",
"Die Quelle des Nebels und des Tosen ist weiter im Westen zu suchen.");
AD("rauschen",
"Es ist laut, aber besser lausche...");


AD("decke",
"Die Decke ist wegen des Saeurenebels nicht zu erkennen.");
AD("boden",
"Der Boden ist blutverschmiert. Ueberall Blut!");

AD("nebel",
"Es ist kein normaler Nebel, es ist purer Saeurenebel!");

AD("saeure",
"Von irgendwoher muss der Saeurenebel ja kommen. Die Saeure jedenfalls, "
"ist fuer manche giftig.");

AD("saeurenebel",
"Der Saeurenebel scheint aus dem Westen hier herein zu kriechen. Er schwebt "
"unheimlich auf und nieder.");




AD(({"wand","waende"}),
"Die Waende sind schlecht zu erkennen. Blut rinnt herab und sammelt sich am Boden. "
"Es ist das Blut der Feinde der Nekromanten!!!");

ASD(({"feind","feinde"}), "det_enemy");
ASD(({"nekromanten","nekromant"}), "det_nekro");
ASD("blut","det_blut");




AD("gang",
"Der Gang verlaeuft hier von Osten nach Westen. Er ist blutverschmiert und voller "
"Saeurenebel.");

SP(P_KILL_NAME, "Ein giftiger Saeurenebel");

AD("osten",
"Im Osten klafft eine Oeffnung in der Wand.");
AD("westen",
"Im Westen fuehrt der Gang weiter.");
AD("oeffnung",
"Die Oeffnung ist wild gezackt und brutal aus der Wand herausgebrochen.");



 
AIT("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT,
  ([
     P_MNPC_AREA: "/d/wasser/dante/zinsel/room/saeure",
        P_MNPC_DEFAULTROOM: "/d/wasser/dante/zinsel/room/saeure3"]));

  
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));   
  SetProp( P_LIGHT,  0);
  SetProp( P_INDOORS, 1 );

    
  AddSmell(DEFAULT_SMELL,
  "Hier riecht nach Saeure.\n");
  
  AddSmell(({"nebel","saeure"}),
  "Die Saeure richt scharf und irgendwie toedlich...");
  
  AddSound(DEFAULT_SOUND,
 "Es rauscht und tost laut hier. Aehnlich einem Wasserfall.");
 AddSound("wasserfall",
 "Aehnlich...");
 AddSound(({"tosen","rauschen"}),
 "Du musst wohl weiter nach Westen gehen um mehr zu erfahren!");


  AE("westen", "./saeure2");
  AE("osten", "./vor");
}


  

init()  {
	::init();
	
	if(interactive(TP))  { call_out("start", 3);   }
         }


start()  {
	if(environment(TP)!= TO) return ;
	call_out("check", 58);  }
	//das hat den sinn nur kurze call outs zu erzeugen 
	//wenn ein spieler nur durchlaeuft..klar:-))) 

check()  {
	if(environment(TP)!= TO) return ;
	
	 if(TP->QP(P_GUILD)=="paladine")   {
 	write(BS(
 	"Der Saeurenebel frisst sich in Deine Lungen! AHHH!!!"));
 	TP->do_damage(5); 
       }

if(TP->QP(P_GUILD)=="nekromanten")  {
	write(BS(
	"Der Saeurenebel erfuellt Deine Lungen! Du fuehlst Dich besser!"));
	TP->heal_self(5);  }

//10 mins = 50 punkte sollten der balance nicht zuh weh tun oder?!

else  {
	write(BS(
	"Der Saeurenebel tut Dir nicht gut!"));
	TP->do_damage(2);  }

call_out("check", 60);

}
			
	

det_nekro()  {
	 if(TP->QP(P_GUILD)=="paladine")   {
 	return BS(
 "Du als Paladin hast panische Angst vor den Nekromanten!");  }
 	
 if(TP->QP(P_GUILD)=="nekromanten")  {
 	return BS(
 "Die Nekromanten herrschen hier! Sei gegruesst!");  }
 else {
 	return BS(
 "Du erzitterst leicht, denn hier herrschen die Nekromanten!"); }}
 		



det_blut()  {
	 if(TP->QP(P_GUILD)=="nekromanten")  {
	return BS(
	"AHH!!! Du liebst es, wenn Deine Feinde so richtig bluten! Ein echter "
	"Nekromant eben!");
      }
 if(TP->QP(P_GUILD)=="paladine")   {
 	return BS(
 "Dein Blut wird auch bald hier sein, Du &%&$§%& Paladin!");   }
 else  {
 	return BS(
 	"Du ekelst Dich ein wenig vor dem Blut!"); }}
 		



det_enemy()  {	
    if(TP->QP(P_GUILD)=="nekromanten")  {
	
	return BS(
	"Du als Nekromant, kannst ueber Deine Feinde nur lachen!");		
                                }
 if(TP->QP(P_GUILD)=="paladine")   {
 	return BS(
 	"Du als Paladin hast hier nichts zu lachen! Krepier!");  
             }
else {
	return BS(
   "Du hoffst niemals ein Feind der Nekromanten zu werden!");  }}
   	

