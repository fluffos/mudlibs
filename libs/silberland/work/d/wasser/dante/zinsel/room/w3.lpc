//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;

int gut=5;
void reset() {
  ::reset();
  gut=5; 
}


void create()
{
  ::create();

  gang_details();
  farbe="blau";
  dir="Westen";


  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Hier endet der Saeulengang abrupt im "+dir+". Ein grosses Loch in der Decke scheint nach "
        "oben zu fuehren. "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten scheinen direkt um Dich herumzutanzen. Mitten im Raum "
        "steht ein Brunnen."));


  AD("brunnen",
      "Es handelt sich um einen guwinoeskomplexen Brunnen. Frisches "
      "Wasser sprudelt heraus.");
  AD("wasser",
      "1. Kannst Du das Wasser trinken. (SEHR ABZURATEN)!!!\n"
      "2. Kannst Du darin baden. (ANZURATEN)!!!\n"
      "Tja, luegt hier einer oder spricht er wahr. Du kannst es Dir "
      "aussuchen. <syntax: brunnen 2 fuer baden, brunnen 1 fuer trinken.\n");

  AD("baden",
      "Ja, das ist gut!");
  AD("trinken",
      "Mach das nicht!!!");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");


  AD("farbe",
      "Hier ist alles in "+farbe+"er Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus.");
  AD(""+dir+"",
      "Im "+dir+" endet der Saeulengang.");
  AD("richtung",
      "Der Saeulengang endet hier im "+dir+"!");
  AD("decke",
      "Die Decke ist auch aus Marmor. Doch sieht man hier neben den "
      "seltsamen Spiegeln auch ein grosses Loch, das nach oben fuehrt.");
  AD("loch",
      "Du scheinst zu dem Loch nicht zu gelangen. Warte ein wenig...");



  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");


  AIT("/d/wasser/dante/zinsel/room/wlift", REFRESH_DESTRUCT, 1);



  NewDoor("osten", ("d/wasser/dante/zinsel/room/w2"),
      ({"tor"}),

      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED | DOOR_NEEDKEY,
       D_LONG, "Das "+farbe+"e Tor sieht sehr stabil aus.\n",
       D_GENDER, NEUTER,
       D_SHORT, "Ein "+farbe+"es %ses Tor.\n",
       D_NAME, ""+farbe+"e Tor",
       } ));

  JAEGER2

    ACD("brunnen", "virus");
}

int virus(string str)  {
  object ob, v;

  NF("Brunnen 1 oder brunnen 2?!\n");
  if(!str) return 0; 
  ob=deep_present("DANTE_ZOMBIE_VIRUS", TP);

  if(str=="1")  {
    write(BS("Du trinkst das Wasser aus dem Brunnen!"));
    say(BS(CAP_TPN+" trinkt Wasser aus dem Brunnen!!!"));

    if(ob)  {
      write(BS(
            "Du bist sowieso schon krank..."));
      return 1; 
    }

    if(!ob)  {
      write(BS(
            "Das Wasser brennt irgendwie....ob das schlau war?!"));
      v=clone_object("/d/wasser/dante/zinsel/obj/zv");
      v->move(TP, M_GET);
      return 1; 
    }
    return 0; 
  }

  if(str=="2")  {
    write(BS(
          "Du steigst in den Brunnen und badest darin!!!"));
    say(BS(
          CAP_TPN+" steigt in den Brunnen und badet darin!"));
    if(gut)  {
      write(BS(
            "AHHH!!! Das Bad tut Dir unheimlich gut!!!"));
      TP->heal_self(25+random(10));
      gut--;
      return 1; 
    }
    if(!gut)  {
      write(BS(
            "Das Wasser ist frisch, aber sonst..."));
      return 1; 
    }
    return 0; 
  }
  return 0; 
}

