inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"

int dog=3;

void create()
{
  ::create();

  SSH("Ein kleiner Pfad auf einer kleinen Insel mit Baum.");
  SLO(BS("Sind nun die Weiten des Meeres, oder die Trostlosigkeit der Insel groesser ? "
        "Obwohl Du weitergegangen bist, hat sich auch hier nicht viel veraendert."
        " Dir bietet sich das uebliche Bild: der Baum, das Meer, der Sand; mit "
        "einem Wort - trostlos. Doch stop, hier scheint Etwas zu sein."));


  AD("etwas",
      "Hier gibt es zumindest 581 Forscherpunkte.");

  AD(({"punkte","punkt","forscherpunkte","forscherpunkt"}),
      "Mindestens 581, wenn nicht sogar an die 600. Viel interessanter "
      "ist aber der kleine Zaubertrank der da herumliegt.");

  ASD(({"trank","zaubertrank"}), "get_zt"); 


  AD("baum",
      "Der grosse, trockene Baum ist auch von hier natuerlich zu sehen. "
      "Seine Rinde ist total verdorrt.");
  AD("rinde",
      "Die Rinde weisst viele Kratzer auf.");
  AD("kratzer",
      "Die Kratzer sind mal tiefer mal weniger tief. Auch Rillen findet man dort.");

  AD(({"rillen", "rille"}),
      "Die Rillen sind tiefer als die Kratzer aber seichter als das Meer. "
      "Hmm, sollte man nicht mal in die Rillen fassen?!");


  AIT("/d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT);


  AD(({"weite","weiten"}),
      "Unendlich weit...");
  AD("trostlosigkeit",
      "Die Insel ist gar nicht so trostlos...");
  AD("boden",
      "Der Boden weisst Spuren im Sand auf.");
  AD("sand",
      "Der Sand ist hier gelblich und warm.");
  AD(({"spur","spuren"}),
      "Sie fuehren direkt ins Wasser. Du solltest unbedingt schwimmen gehen.");


  AD("himmel",
      "Die Sonne strahlt brutal herab. Sonst ist da nur eine kleine Wolke.");


  AD("wolke",
      "Die Wolke ist weiss und scheint weich wie Butter zu sein!");
  AD("butter",
      "Butter von gesuenden Kuehen.");
  AD(({"kuh","kuehe"}),
      "IAHHH!! Oder machen Kuehe nicht so...");

  AD("wort",
      "So trostlos ist es auch nicht. Da fliegt sogar ein kleiner Kaefer "
      "vorueber.");
  AD("kaefer",
      "SCHWUPPP!!! WAEH! Du hast ihn verschluckt.");
  AD("tod",
      "Solltest Du das Wort Sonnensturm untersuchen, stirbst Du sofort! "
      "ACHTUNG!!! DAS IST KEIN SCHERZ!!!! ACHTUNG!!! Damit wollen die "
      "Mudpolizisten Euch boese, boese Scripter erwischen!! :-)");
  ASD("sonnensturm", "pap");
  AD("pfad",
      "Der Pfad fuehrt um die kleine Insel herum.");
  AD("insel",
      "Du befindest Dich hier im Osten der Insel.");
  AD("osten",
      "Noch weiter oestlich liegt das weite Meer.");
  AD("meer",
      "Das Meer ist hier recht ruhig. Ideal zum schwimmen.");

  AD("bild",
      "Oberflaechlich mag auf der Insel kaum etwas sein, aber...");
  AD("wasser",
      "Das Wasser ist hier dunkelblau.");





  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]));
  AddDetail( ({ "ball" }), 
      "Vernichtend heiss und toedlich. Es koennte Dein Tod sein!!!" );
  AddDetail( ({ "sonne" }), 
      "Hoch oben strahlt die Sonne wie ein feuriger Ball, der alles verbrennt!" );
  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht sanft an der kleinen Insel vorbei!");
  AddSound("meer",
      "Es fliesst hier nicht allzu schnell vorbei.");

  AIT("/d/wasser/dante/zinsel/npc/wgnom1", REFRESH_DESTRUCT);


  AddCmd (({"schwimme", "schwimm"}), "swim");
  AddCmd (({"fasse", "fass"}), "fasse");

  AE("norden", "./isle_03");
  AE("suedwesten", "./isle_enter");
  SP(P_KILL_MSG, "Das sag ich der Mudpolizei!!!");
  SP(P_KILL_NAME, "Ein Sonnensturm"); 
}

string pap()  {
  write(BS(
        "Bitte, wenn Du willst..."));
  TP->die();
  write_file("/d/wasser/dante/zinsel/log/sturm", ctime()+": "+CAP(getuid(TP))+" stirbt am Sonnesturm.\n");
  return "";
}


string get_zt()   {

  if(!TP->FindPotion())  {
    write(BS(
          "Du schaust Dir den Zaubertrank genauer an. Dein Name, "+TPN+" steht "
          "leider nicht drauf. Pech!"));
    say(BS(
          CAP_TPN+" ist enttaeuscht."));
  }


  if(TP->FindPotion())  {
    write(BS(
          "Du schaust Dir den Zaubertrank an. WOW!! Da steht ja "+TPN+" oben! "
          "Begeistert trinkst Du den Trank aus!"));
    say(BS(
          CAP_TPN+" findet einen Zaubertrank!!!"));
    write_file("/d/wasser/dante/zinsel/log/zt", ctime()+": "+CAP(getuid(TP))+" findet den  ZT.\n");

  }
  return ""; 
}



fasse(string str )
{
  object ob;
  notify_fail( "Huendchen fass, oder was ??\n");
  if (str == "in rille" || str == "rille")   
  {
    if(dog)  {
      write(BS(
            "Du fasst in die Rille und findest einen Knochen!!! Ploetzlich "
            "taucht ein Daemonenhund auf und reisst Dir den Knochen aus der Hand!"));
      say(BS(
            CAP_TPN+" fasst in eine Rille und..."));
      ob=clone_object("/d/wasser/dante/zinsel/npc/zdog");
          ob->move(environment(TP), M_GO|M_SILENT);
      ob->Kill(TP); 		
      dog--;
      return 1; 
    }

    if(!dog)   {
      write("Du fasst in die Rille und findest nichts.\n");
      say( TPN+" krammt in einer Rille herum.\n");
      return 1;
    }
    return 0;
  }
  return 0; 
}



void reset()  {
  ::reset();
  dog=3;  
}

int swim(string str )
{
  NF("Wohin willst Du schwimmen?!\n");
  if( member( ({"aufs meer", "im meer", "ins meer", "in das meer", "meer",
          "durchs meer", "durch das meer", "aufs meer hinaus", "hinaus", "raus", "no",
          "auf das meer hinaus", "richtung meer", "in richtung meer"}),str)>-1 )
  {
    write( BS("Du huefpst ins Wasser, und schwimmst im Meer herum."));

    this_player()->move("/d/wasser/dante/zinsel/room/swim2", M_GO,
        "ins Meer und schwimmt hinaus", "springt", "kommt hier her geschwommen");
    return 1;
  }
  return 0; 
}
