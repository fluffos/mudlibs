//dante sl 99

inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>

int rand1=5+random(5);
int rand2=10+random(10);
int bier=3;

void create()
{
  ::create();

  SSH("Ein kleiner Pfad auf einer kleinen Insel mit Baum");
  SLO(BS("Es war ja wohl kaum anders zu erwarten - Wasser, Baum und tonnenweise "
        "Sand. Irgendwie entsteht der Eindruck eines Badestrandes. Ob Du wohl"
        " baden gehen kannst hier ?? Zumindest kannst Du im Wasser nichts gefaehrliches "
        "- also aggressive Fische, oder dergleichen - erkennen. "
        "Im Boden entdeckst Du ein grosses Loch!"));

  AD("pfad",
      "Der kleine Pfad fuehrt um die Insel herum. Irgendwie endet er hier "
      "aber auch am Wasser! Da scheint wohl einer ins Wasser gegangen zu sein.");
  AD("strand",
      "Hier geht die Insel sehr flach ins Meer ueber. Fast ein Badestrand.");
  AD("badestrand",
      "Badestrand ist das hier keiner, doch schwimmen kann man hier. Doch sei vorsichtig, "
      "denn in diesem Gewaesser koennten Haie lauern!");
  AD("gewaesser",
      "Hier sieht man des oefteren Haie.");
  AD(({"hai","haie"}),
      "SCHNAPPPPPP!!! Und weg ist Dein Bein.");
  AD("bein",
      "Deines ist noch da, noch!");
  AD("eindruck",
      "Der Eindruck koennte auch taeuschen. Wer weiss.");
  AD(({"fisch","fische"}),
      "Du koenntest von einem wahnsinnigen Goldfisch attackiert werden! "
      "Stell Dir das doch vor?!");
  AD(({"goldfisch"}),
      "Gold hat Dich immer schon interessiert.");
  AD("gold",
      "WOW!!! Du findest doch glatt einen Klumpen reinstes Gold im Wert "
      "von einer Million Muenzen!!! WAHNSINNNNN!!!!");
  AD(({"klumpen","wert", "million"}),
      "Tja, zu frueh gefreut, Du goldgieriger Sack!");
  AD("sack",
      "WOW! Du findest einen Sack Muenzen!!! Schluss! Aus!!! Vorbei der "
      "Spass.");
  AD("spass",
      "Hoffe Du hattest welchen...");
  AD("baum",
      "Der Baum ist riesengross und sehr trocken. Seine Rinde ist sproede.");
  AD("rinde",
      "Die Rinde ist hier teilweise abgebroeckelt. Der Baum scheint irgendwie "
      "nicht mehr das zu sein was er einmal war. HA! Du siehst einen "
      "Spalt!");
  AD("spalt",
      "Der Spalt laesst Dich in den Baum sehen! Der Baum ist hohl! Leider "
      "ist der Spalt aber nur sehr klein, also rein kommt man da nie.");


  AD("strauch",
      "Der einzelne Strauch sieht eher traurig aus.");

  AD("sonne",
      "Die Sonne brennt herab!");
  AD("himmel",
      "Der Himmel ist herrlich blau. Die Sonne lacht herunter. Ein "
      "violetter Drache segelt hoch oben vorbei.");
  AD("drache",
      "Der Drache ist soweit oben, dass man sehr wenig sieht. Aber Du "
      "schaetzt ihn auf eine Laenge von "+rand1+" Meter und einem "
      "Gewicht von "+rand2+" Tonnen. Tja, wo der wohl hinfliegt. Aja, "
      "da ist auch noch ein Band das man am Drachen befestigt erkennt.");

  AD(({"tonne","tonnen","gewicht"}),
      "Scheint ein fetter Drache zu sein.");

  AD(({"meter","laenge"}),
      "WOW! "+rand1+" Meter ist nicht schlecht.");
  AD("band",
      "Das Band flackert hinter dem Drachen her und da steht etwas:\n"
      "\n"
      "Kaufen sie das gute Dschungelbier!!!\n\n"
      "Sowas, ein Werbedrache!!! Gibts denn das...");
  AD("werbedrache",
      "Hier wundert Dich aber nichts mehr...");
  ASD(({"bier","dschungelbier"}), "beer");

  AD("sand",
      "Der Sand ist hier weiss. Ab und zu ist er mit roten Streifen "
      "durchzogen.");
  AD("streifen",
      "Die Streifen sehen nett aus. Es handelt sich um Blut, wie nett.");
  AD("blut",
      "Das Blut ist schon alt und eingetrocknet. Von wem es wohl stammt...");

  AD("insel",
      "Hier bist Du im Westen der kleinen Insel. Auch hier alles wie "
      "gehabt. Sand, ein Strauch und der grosse Baum.");
  AD("westen",
      "Im Westen liegt das weite, grosse Meer.");
  AD(({"meer", "schwimmen"}),
      "Das Meer ist hier schoen ruhig und ladet so richtig zum Schwimmen ein.");
  AD("wasser",
      "Das Wasser scheint hier recht still zu sein.");


  AD("loch",
      "Das Loch ist tief und fuehrt nach unten!");
  AD("boden",
      "Der Boden ist gleich wie ueberall hier, sandig. Nur ist hier ein "
      "grosses, dunkles Loch!");




  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]));
  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht sanft an der kleinen Insel vorbei!");
  AddSound("meer",
      "Es fliesst hier nicht allzu schnell vorbei.");



  //AIT("/d/dschungel/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT);;

  AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT);




  AddCmd (({"schwimme", "schwimm"}), "swim");

  AddExit("sueden", "./isle_01");
  AddExit("nordosten", "./isle_04");
  ASE("unten", "nix");
}

string beer()
{
  if(bier)  {
    write (BS(
          "Du denkst an ein Dschungelbier und fuehlst Dich ploetzlich sehr gut!!! WOW!!!"));
    TP->heal_self(15);
    bier--;
    return "";
  }

  if(!bier)   {
    write("Leider ist das Bier aus! Sorry! WARTE!!!\n");  
    return ""; 
  }
}




nix()  {
  NF("Du wagst Dich nicht durch das Loch nach unten!\n");
}




swim(string str )
{
  NF("Wohin willst Du schwimmen?!\n");

  if( member( ({"aufs meer", "im meer", "ins meer", "in das meer", "meer",
          "durchs meer", "durch das meer", "aufs meer hinaus", "hinaus", "raus",
          "auf das meer hinaus", "richtung meer", "in richtung meer"}),str)>-1 )
  {
    write( BS("Du huefpst ins Wasser, und schwimmst im Meer herum."));

    this_player()->move("/d/wasser/dante/zinsel/room/swim5", M_GO,
        "ins Wasser und schwimmt aufs Meer hinaus", "springt",
        "schwimmt zu Dir");
    return 1;
  }
  return 0; 
}


void reset()   {
  ::reset();
  bier=3;  
}

