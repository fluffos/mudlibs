//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
#include <mnpc.h>

string farbe;
string dir;

int da=2;

void reset()  {
  ::reset();
  da=2; }


void create()
{
  ::create();

  farbe="rot";
  dir="Norden";
  gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Der Saeulengang fuehrt von der oberen Saeulenhalle weg Richtung "+dir+". "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten scheinen direkt um Dich herumzutanzen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");

  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");

  AD("farbe",
      "Hier ist alles in "+farbe+"er Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus. He! Da ist ein Kreuz!");
  AD("kreuz",
      "Das Kreuz ist in den Marmor eingeritzt. Ein Name steht auch da!");
  AD(({"namen","name"}),
      "Da steht Jojogeist?!");
  ASD("jojogeist", "get");
  AD("geist", 
      "Jojogeist!");
  AD(""+dir+"",
      "Im "+dir+" endet der Saeulengang an einem Tor.");
  AD("richtung",
      "Der Saeulengang fuehrt weiter nach "+dir+"! "
      "Doch ist da noch das "+farbe+"e Tor!");

  AE("sueden", "./n1");

  AIT("d/wasser/dante/zinsel/npc/zo3", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS,
P_AGGRESSIVE: 0]));



  NewDoor("norden", ("/d/wasser/dante/zinsel/room/n3"),
      ({"tor"}),

      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
       D_LONG, "Das "+farbe+"e Tor sieht sehr massiv aus aus. Da steht ein Satz!\n",
       D_GENDER, NEUTER,
       D_SHORT, "Ein "+farbe+"es %ses Tor.\n",
       D_NAME, ""+farbe+"es Tor",
       } ));

  AD("satz",
      "Lies ihn!");
  ARD("satz",
      "Verflucht sei dieses Tor! Dante, i.v. Edi. :-)");

  AD(({"dante","edi"}),
      "Hmm, die wurden hier wohl laengere Zeit aufgehalten.");
  AD("zeit",
      "Viel zu lange!");

  JAEGER2

}





void init()  {
  ::init();
  if(interactive(TP)) {
    call_out("hallo", 10); 
  }
}

void hallo()  {
  if(!TP || TO!=environment(TP)) return ;
  write(BS(
        "Der Marmor fasziniert Dich hier!!!"));  
}


string get()  {object ob;
  if(!da)  {
    return (BS(
          "Kennst Du etwa den Jojogeist nicht, "+TPN+"?!"));  
  }
  if(da)  {
    da--;
    write(BS(
          "Du schaust Dir den Namen genauer an und SCHWUPPP hast Du ein "
          "Jojo in der Hand. Das freut Dich, oder "+TPN+"?!"));
    ob=clone_object("/d/dschungel/dante/weg/obj/jojo");
    ob->move(TP, M_NOCHECK);
    return ""; 
  }
}

