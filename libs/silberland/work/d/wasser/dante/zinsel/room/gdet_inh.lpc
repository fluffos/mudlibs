//details fuer saeulengaenge
#include "/players/dante/myowndefine.h"

int rand;
void gang_details()   {

  rand=10+random(10);

  AD("boden",
      "Der Boden besteht aus Marmor der hier vorwiegenden Farbe. "
      "Ein verworrenes Muster, das in den Marmor eingestanzt wurde, "
      "zieht durch den gesamten Saeulengang. Ab und zu sieht man "
      "dunkelrote Spuren.");
  AD("insel",
      "Du bist tief unter der Insel. Oder besser in ihr.");

  AD("raum",
      "Da stehst Du.");



  AD("muster",
      "Das Muster ist sehr verworren und daher verwirrend. "
      "Es stellt wohl Zombies dar, die Goetzen anbeten.");
  AD("zombie",
      "Tja, wo sind die wohl...");
  AD(({"spur","spuren"}),
      "Die dunkelroten Spuren sind Blut.");
  AD("blut",
      "Blut, von hier abgeschlachteten, unvorsichtigen Leuten...");
  AD(({"leute","leuten"}),
      "Du bist auch bald dran.");



  AD(({"gaenge","saeulengaenge","gang","saeulengang"}),
      "Der Gang ist vollstaendig mit Marmor ausgekleidet. An den Seiten"
      " des Ganges stehen unheimliche Goetzen, deren blosse Anwesenheit "
      "furchterregend ist.");

  AD("anwesenheit",
      "Stumm und boesartig blicken die Goetzen aus grausigen Fratzen.");
  AD(({"fratzen","fratze"}),
      "Ihre Augen leuchten ab und zu. Ihr Mund grinst boesartig.");
  AD(({"auge","augen"}),
      "Die Augen scheinen zu leben.");
  AD("mund",
      "Der Mund ist weit offen und voller spitzer Zaehne.");
  AD(({"zahn","zaehne"}),
      "Die Zaehne der Goetzen blitzen hell auf. Sie sind extrem scharf "
      "und spitz.");
  AD(({"statue","statuen"}),
      "Die Statuen stellen boesartige Goetzen an. Die Zombies "
      "verehren diese Goetzen und opfern z.b. Dich!");
  AD(({"saeule","saeulen"}),
      "Die Saeulen haben die Form von unheimlichen Goetzen.");
  AD("form",
      "Eklig, grausig, unheimlich.");
  AD("kaelte",
      "Der Marmor strahlt eine unangenehme Kaelte aus.");
  AD(({"halle","saeulenhalle"}),
      "Die Saeulenhalle ist von hier aus nicht mehr zu sehen. Aber "
      "allzuweit kann sie nicht sein.");

  AD(({"kopf","koepfe"}),
      "Ihre Koepfe reichen an die Decke und zeigen eklige Fratzen.");
  AD("decke",
      "Die Decke ist ebenfalls aus Marmor. Sie wird durch die Koepfe "
      "der Statuen gestuetzt. Du erkennst einen eingelegten Spiegel.");
  AD("spiegel",
      "Nun erst faellt Dir auf, das in die Decke immer wieder Spiegel "
      "eingebaut sind. Welchen Sinn die wohl haben...");
  AD("sinn",
      "Angeblich zaubern die Goetzen mit den Spiegeln...");
  AD(({"goetze","goetzen"}),
      "Die Goetzen sind Statuen aus Marmor, deren Fuesse den Sockel "
      "bilden und deren Koepfe bis an die Decke reichen. Sie tragen "
      "scheinbar diese unterirdischen Gaenge.");
  AD(({"fuss","fuesse"}),
      "Die Fuesse der Statuen bilden den Sockel der Saeulen.");
  AD("sockel",
      "Der Sockel der Saeulen wird von den Fuessen der Goetzen gebildet. " 
      "Du kannst an jedem Sockel eine andere Inschrift erkennen.");
  ASD("inschrift","liste");
  ARD("inschrift",
      "Untersuchen reicht hier.");
  AD(({"seite","seiten"}),
      "An den Seiten der Saeulengaenge stehen ueberall Goetzen herum.");
  AD(({"wand","waende"}),
      "Die Waende sind auch aus Marmor. Er scheint hier sehr eben "
      "zu sein. In stabilen Haltern stecken Fackeln, die ein flackerndes"
      " Licht verbreiten. Sie werfen unheimliche Schatten an die " "Waende.");
  AD("licht",
      "Das Licht laesst die Schatten leben und um Dich herumtanzen. "
      "Schau besser nicht zu lange hin, Dir koennte schwindlig werden.");
  AD("schatten",
      "Die Schatten schwirren direkt um Dich herum. Ab und zu glaubst "
      "Du ein Gesicht zu sehen, das Dich angrinst.");
  AD("gesicht",
      "Da! Da war wieder eines!");

  AD(({"fackel","fackeln"}),
      "Mit Ekel stellst Du fest, dass die Fackeln aus Knochen bestehen, "
      "die man mit Wachs gefuellt hat.");
  AD("ekel",
      "Wirst auch Du als Fackel enden?");
  AD("knochen",
      "Die Knochen sind hohl und mit Wachs gefuellt.");
  ASD("wachs","show");
  AD(({"halter","haltern"}),
      "Die Halter sind an die Wand genagelte Totenschaedel!");
  AD(({"schaedel","totenschaedel"}),
      "Grausig grinsen sie Dich an. Du siehst einen Punkt!");
  ASD("punkt", "show2");
  AD("himmel",
      "Der hilft Dir hier sicher nicht!");

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));   
  SP(P_LIGHT, 1);

}


string show2()  {
  return (
      "Der Punkt besteht aus Buchstaben und da steht:\n"
      "Hallo "+TPN+"! Wenn Du das liest, bist du in "+rand+""
      " Sekunden tot! Viel Spass!\n");
}

string race_text(string race)
{
  switch(race)
  {
    case "Fee": return race + "n";
    case "Oger":
    case "Troll":
    case "Hobbit": return race;
    default: return race + "en";
  }
}

string show()  {
  return BS("Das Wachs wurde aus "+race_text(TP->QueryProp(P_RACE))+"fett gewonnen. Lecker!");  }


  string liste() {
    write(BS(
          "Du schaust Dir eine Inschrift naeher an."));
    switch(random(4))  {
      case 0:
        return(BS(
              "Diese Statue stellt den Goetzen Ratzhjifed dar, den Herrn "
              "des Todes."));
        break;
      case 1:
        return(BS(
              "Diese Statue stellt den Goetzen Pikleewpi dar, den "
              "Meister der Grausamkeit."));
        break;
      case 2:
        return (BS(
              "Diese Statue stellt den Goetzen Vitxozguegl dar, den "
              "Fuehrer der Untoten."));
        break;
      case 3:
        return BS(
            "Diese Statue stellt den Goetzen Ltopiukliht dar, den "
            "Bewahrer der Faeulniss.");
        break;
      default: write("Die Inschrift ist zu doof!\n");
    }}
