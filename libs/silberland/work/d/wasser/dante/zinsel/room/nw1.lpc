//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;

#define TOLD  (member(told, getuid(this_player()))!=-1)

string *told=({});
void create()
{
  ::create();

  farbe="orange";
  dir="Nordwesten";

  gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Der Saeulengang fuehrt von der unteren schwarzen Saeulenhalle weg Richtung "+dir+". "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"nem Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten scheinen direkt um Dich herumzutanzen. Im Boden "
        "klafft eine dunkle Oeffnung."));

  AD("oeffnung",
      "Sie fuehrt nach unten.");

  AD("decke",
      "In der Decke klafft ein grosses Loch, das in einen schraegen "
      "Schacht fuehrt.");
  AD(({"loch","schacht"}), 
      "Der Schacht fuehrt schraeg nach oben.");



  AD("farbe",
      "Hier ist alles in "+farbe+"ner Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus.");
  AD(""+dir+"",
      "Im "+dir+" geht der Gang weiter.");
  AD("richtung",
      "Der Saeulengang fuehrt weiter nach "+dir+"!");
  //

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");

  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");


  AE("suedosten", "./z2");
  AE("nordwesten", "./nw2");
  AddGuardedExit("oben", "/d/wasser/dante/zinsel/room/n1", "zombie",
      "Der Zombie tritt Dich nieder.\n");

  AIT("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));

  ASE("unten", "jojo");

}


int jojo()  {
  if(TOLD)  {
    write(BS(
          "Du gehst nach unten trotz der Warnung!"));
    return TPM("/d/wasser/dante/zinsel/room/knast", M_GO,
        "dumm wie "+TPN+" ist nach unten", "geht", "kommt dumm" 
        " wie "+TPN+" ist auch zu Dir herab");	  
  }
  if(!TOLD)  {
    NF(BS("Du solltest es Dir besser noch einmal ueberlegen, ob "
          "Du wirklich da runter willst, denn es koennte sein, das "
          "man aus diesem Raum nur sehr schwer wieder raus kann. Es koennte sein, "
          "muss aber nicht. Vielleicht liegen da unten ja auch gigantische Schaetze?!"));
    told += ({getuid(this_player())});   	
  }
}

