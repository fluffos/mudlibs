//dante sl 99 

inherit "std/room";
#include <moving.h>
#include <player.h>
#include "/players/dante/myowndefine.h"

#include <properties.h>


int heilen=3+random(3);
void reset()  {
  ::reset();
  heilen=3+random(3);
}


void create()
{
  ::create();

  SSH("Im Baum auf der Zombieinsel");
  SetProp(P_LIGHT,1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));   
  SLO(BS(
        "Der grosse Baum, den man von ueberall auf der Insel sehen kann, "
        "scheint voellig hohl und oben offen zu sein. Man erkennt den "
        "strahlendblauen Himmel und die Sonne. Im Boden klafft ein riesengrosses, "
        "dunkles Loch von dem eine unheimliche Aura ausgeht. Was mag da unten "
        "wohl sein? Durch einen Spalt im Baum kommst Du wieder "
        "auf die Insel zurueck."));
  AD("spalt",
      "Durch den Spalt kommt man wieder raus.");

  AD("decke",
      "In der Decke klafft eine Oeffnung. Wohin sie fuehrt kann man leider nicht erkennen.");
  AD("oeffnung",
      "Die Oeffnung fuehrt nach oben.");

  AD(({"wand","waende"}),
      "Die Waende des Baumes sind voller Rillen. Man sieht eine "
      "seltsame Vorrichtung.");
  AD(({"rille","rillen"}),
      "Die Rillen sind voller Kaefer.");
  AD("kaefer",
      "Es sind Schleimkaefer.");
  AD("schleimkaefer",
      "Diese Kaefer schmecken angeblich sehr gut. Iss doch einen!!!");
  AD("vorrichtung",
      "Scheint so als fahre ein Lift nach unten.");
  AD("lift",
      "Der Lift scheint nicht da zu sein. WARTE!!!");


  AD("baum",
      "Du stehst mitten im hohlen Baum, um den Du draussen herumgegangen "
      "bist.");
  AD("insel",
      "Du bist noch immer auf der Insel.");
  AD("himmel",
      "Blau und hell ober Dir.");
  AD("sonne",
      "Sie waermt Dich hier angenehm.");
  AD("boden",
      "Im Boden klafft ein tiefes, unheimliches Loch. Eine boesartige "
      "Aura geht von ihm aus.");
  AD("aura",
      "Huete Dich! Dort unten muss etwas Boeses sein.");
  AD("boeses",
      "Was kann es wohl sein...");
  AD("loch",
      "Das Loch fuehrt nach unten, unter die Insel.");

  AD("lift",
      "Hmm, warte einfach...");


  SP(P_HIDE_EXITS, ({"oben"}));


  AIT("/d/wasser/dante/zinsel/room/lift", REFRESH_DESTRUCT, 1);


  AE("raus", "durch einen Spalt nach draussen zurueck#./isle_03.lpc");
  ACD(({"esse","iss"}), "eat");

}

int eat(string str)  {
  NF("Was willst Du essen?\n");
  if(str=="kaefer"||str=="schleimkaefer")  {
    if(!heilen)  {
      write(BS(
            "Du packst und isst einen Schleimkaefer!!! WAEHHH!!! "
            "Sofort spuckst Du ihn wieder aus!"));
      say(BS(CAP_TPN+" packt und isst einen Schleimkaefer. EKLIG!!!"));
      return 1; 
    }

    if(heilen)  {
      heilen--;
      write(BS(
            "Du packst und isst einen Schleimkaefer!!! HMMMM!!! "
            "Diese Kaefer schmecken wirklich gut und sind auch sehr nahrhaft!!!"));
      say(BS(CAP_TPN+" packt und isst einen Schleimkaefer. EKLIG!!!"));
      TP->heal_self(20+random(10));
      return 1; 
    }
    return 0; 
  }
  return 0; 
}

