/*
   das schiff soll zwischen midas insel und tijara hin und her fahren


*/



inherit "std/transport";
#include <properties.h>
#include <moving.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>


int geister=4;

void reset()  {
  ::reset();
  geister=4;
}


void create()
{

  ::create();
  SetProp( P_NAME, "Seelenverkaeufer" );
  SP(P_NAME_ADJ, "uralt");
  AddId( ({ "seelenverkaeufer", "schiff" }) );
  SetProp( P_GENDER, MALE );
  SetProp( P_SHORT, "Ein uralter Seelenverkaeufer");
  SetProp( P_LONG, BS("Eine dunkle, unheimliche Aura begleitet "
        "diesen Seelenverkaeufer auf seiner einmsamen Reise ueber die unendlichen Weiten des Meeres. "
        "Du kannst weder einen Matrosen noch den Kapitaen sehen. Ist es ein Geisterschiff? "
        "Und wo segelt es hin? Ist es klug dieses Schiff zu betreten?"));
  SetProp( P_INT_SHORT, "In einem unheimlichen Schiff" );
  SetProp( P_INT_LONG, BS(
        "Du bist nun auf dem uralten Schiff, dessen Segel zerfetzt und verblasst sind. "
        "Am Bug erkennst Du eine grosse Gallionsfigur, die einem Totenschaedel aehnelt. "
        "Der Rumpf aechzt und knarrt, als ob er jede Sekunde zerbersten will und allen "
        "Passagieren ein nasses Grab bereitet. Eine dunkle, unheimliche Aura begleitet "
        "diesen Seelenverkaeufer auf seiner einmsamen Reise ueber die unendlichen Weiten des Meeres. "
        "Du kannst weder einen Matrosen noch den Kapitaen sehen. Ist es ein Geisterschiff? "
        "Und wo segelt es hin? Ist es klug dieses Schiff zu betreten?"));

  SP(P_KILL_NAME, "Der uralte Seelenverkaeufer");

  AD("aura",
      "Dunkel und unheimlich umgibt sie dieses Schiff. Du glaubst sogar, das es hier etwas dunkler ist als sonst...");

  AD(({"matrosen","kapitaen","matrose"}),
      "Keiner hier. Wer segelt das Schiff? Wer bestimmt den Kurs?!");
  AD("kurs",
      "Scheinbar ist es ein Geisterschiff.");
  AD("boden",
      "Altes, morsches Holz.");
  AD("himmel",
      "Sogar der Himmel sieht von hier aus nicht besonders schoen aus. Von oben haengt "
      "ein Seil herab.");
  AD("seil",
      "Hmm, kann man sicher bewegen!");


  AD("seelenverkaeufer",
      "Das Schiff ist seit langem verflucht. Boese Geister segeln es...");

  AD("geisterschiff",
      "Das Schiff wurde irgendwann einmal verflucht und wird nun fuer ewig "
      "von boesen Geistern gesegelt. Angeblich werden sie sichtbar, "
      "wenn man ein bestimmtes altes Lied singt.");
  AD("lied",
      "Tja, welches koennte das sein...");

  AD(({"weite","weiten"}),
      "Unendlich...");

  AD("meer",
      "Das Schiff segelt schon seit langem einsam ueber das Meer...");
  AD("sklavengaleere",
      "Hier schuften unsichtbare Geister fuer ewig...");
  AD("holz",
      "Alt und faul.");
  AD("grab",
      "Das Meer wuerde Dich fuer immer verschlucken...");
  AD(({"passagiere","passagier"}),
      "Angeblich ueberlebt nur jeder vierte diese Reise...");
  AD("sekunde",
      "Es kraechzt und stoehnt laut.");
  AD("ruder",
      "Die Ruder sind alle zerbrochen und morsch.");
  AD("rumpf",
      "Der Rumpf besteht aus altem, morschen Holz. Hoffentlich ueberlebst "
      "Du diese Reise!");
  AD("reise",
      "Wenn nicht, musst Du fuer ewig hier als Geist rudern...");

  AD("bug",
      "Direkt am Bug ist eine Gallionsfigur angebracht. Einem Totenschaedel nicht unaehnlich.");
  AD(({"gallionsfigur","figur"}),
      "Sie ist einem Totenschaedel sehr aehnlich.");
  AD(({"schaedel","totenschaedel"}),
      "Er grinst unheimlich und scheint mehr ueber dieses Geisterschiff zu wissen.");

  AD("segel",
      "Die Segel haengen eigentlich nur mehr zerfetzt herab. Raetselhaft "
      "wie dieses Wrack sich fortbewegt.");
  AD("wrack",
      "Das Schiff ist wirklich total heruntergekommen.");
  AD("schiff",
      "Das Schiff scheint uralt zu sein, seine Form weist auf eine alte "
      "Sklavengaleere hin. Ausser in eine Kajuete kannst Du auch noch "
      "in den Laderaum des Schiffes steigen.");

  AD("kajuete",
      "Sie gehoerte wohl einst dem Kapitaen.");
  AD(({"raum","laderaum"}),
      "Unter Dir.");
  AD("form",
      "Es ist eher schmal und lang. Es segelt sicher sehr schnell.");
  AD("galeere",
      "Frueher mussten hier Sklaven um ihr Leben rudern. Angeblich "
      "spuken ihre Geister noch heute hier herum.");
  AD(({"geist","geister"}),
      "Irgendwo sind sie sicher...");
  AD(({"sklave","sklaven"}),
      "Die Sklaven wurden alle nicht alt hier.");


  //AE("unten", "nach unten in den Laderaum#./zlade");
  //AE("kajuete","in die Kajuete#./zkaj");

  ASE("unten", "unten_fun");
  ASE("kajuete", "kajuete_fun");

  ACD(({"bewege","beweg"}), "pull");

  SetProp( P_SHORT, "Ein uralter Seelenverkaeufer" );
  SetProp( P_LONG, BS(
        "Du siehst vor Dir ein uraltes Schiff, dessen Segel zerfetzt und verblasst sind. "
        "Am Bug erkennst Du eine grosse Gallionsfigur, die einem Totenschaedel aehnelt. "
        "Der Rumpf aechzt und knarrt, als ob er jede Sekunde zerbersten will und allen "
        "Passagieren ein nasses Grab bereitet. Eine dunkle, unheimliche Aura begleitet "
        "diesen Seelenverkaeufer auf seiner einsamen Reise ueber die unendlichen Weiten des Meeres. "
        "Du kannst weder einen Matrosen noch den Kapitaen sehen. Ist es ein Geisterschiff? "
        "Und wo segelt es hin? Ist es klug dieses Schiff zu betreten?"));

  SetProp( P_LIGHT, 0); //uebernimmt sowieso den lichtlevel vom raum in dem es ist


  AIT(({"/d/wasser/dante/zinsel/npc/stdbird",
        "/d/wasser/dante/zinsel/npc/aus",
        "/d/wasser/dante/zinsel/npc/stdbird",  
        "/d/wasser/dante/zinsel/npc/stdbird",
        "/d/wasser/dante/zinsel/npc/stdbird",  
        "/d/wasser/dante/zinsel/npc/stdbird"}), REFRESH_DESTRUCT,
      ([P_MNPC_DEFAULTROOM: "/d/wasser/dante/zinsel/room/zschiff",
P_MNPC_FLAGS: MOV_OUTDOORS]));



  SetProp( P_DEPARTMSG, ({
        "Ein unheimlicher Seelenverkaeufer hisst die Segel und beginnt seine unheilvolle Reise.\n",
        "Ein unheimlicher Seelenverkaeufer hisst die Segel und beginnt seine unheilvolle Reise.\n"
        }) );


  SetProp( P_ARRIVEMSG, ({
        "Ein unheimlicher Seelenverkaeufer streicht seine Segel und scheint hier zu landen.\n",
        "Ein unheimlicher Seelenverkaeufer streicht seine Segel und scheint hier zu landen.\n"
        }) );

  SetProp( P_ENTERMSG, ({
        "betritt aengstlich den Seelenverkaeufer",
        "kommt zitternd auf den Seelenverkaeufer"
        }) );

  SetProp( P_LEAVEMSG, ({
        "verlaesst aengstlich den Seelenverkaeufer",
        "verlaesst zitternd den Seelenverkaeufer"
        }) );

  SetProp( P_LEAVEFAIL, ({
        "Der Seelenverkaeufer ist noch nicht gelandet",
        "sieht sich verzweifelt um und wuerde hier gerne verschwinden"
        }) );

  SetProp( P_ENTERFAIL, "Es passen nur 8 Passagiere auf den Seelenverkaeufer" );
  SetProp( P_MAX_PASSENGERS, 8 );

  AddSound( ({DEFAULT_SOUND}), "Das Schiff stoehnt und aechzt.");
  AddSmell( ({DEFAULT_SMELL}), "Moder steigt Dir in die Nase.");
  AddSmell("moder",
      "Das Holz ist uralt und faul.");

  AddCmd( ({ "betrete", "betritt"}), "enter_ship" );
  AddCmd( ({ "verlasse", "verlass"}), "leave_ship" );


  //das schiff kommt aus dem hafen von tijara und faehrt als erstes zur insel
  //dann midas dann tijara dann insel wieder usw.....



  //tijara->insel
  //AddRoute("/d/wasser/dante/zinsel/room/steg1", 20,4,"An einem kleinen Steg irgendwo bei einer unheimlichen Insel");

  AddMsg("Irgendetwas beruehrt Dich an der Schulter! IHH!\n", 6);
  AddMsg("Der Seelenverkaeufer schwankt und Dir wird uebel.\n", 7 );   
  AddMsg("Das Schiff schwebt fast ueber das Meer...\n", 6);
  AddMsg("Der Seelenverkaeufer kommt gut voran.\n", 7 );
  AddMsg("Das Meer scheint hier immer wilder zu werden.\n", 3 );
  AddMsg("Das Meer baeumt sich immer mehr auf.\n", 2);
  AddMsg("Ein Sturm kommt auf!!!\n",2);

  AddFun("sturm", 2);

  AddMsg("So schnell wie der Sturm aufkam, legt er sich wieder.\n", 3); 
  AddMsg("Scheinbar segelt das Schiff gen Sueden.\n", 6 );
  AddMsg("Eine kleine Insel scheint in der Ferne zu erscheinen.\n", 7);
  AddMsg("Die Insel kommt immer naeher.\n", 6); 
  AddMsg("Der Seelenverkaeufer schwankt und Dir wird uebel.\n", 7 );     
  AddMsg("Was Dich wohl auf dieser Insel erwartet?\n", 6);
  AddMsg("Das unheimliche Schiff landet an einem kleinen Steg bei der Insel.\n", 1);      

  AddRoute("/d/wasser/dante/zinsel/room/steg1", 20,4,
      "An einem kleinen Steg irgendwo bei einer unheimlichen Insel",
      ({"steg","insel","zombieinsel"}),
      "zur Zombieinsel");


  //insel ->midas
  //AddRoute("/d/wasser/lupus/pier/room/plattform-o", 20,4,"An einem Pier nahe Midas");
  AddMsg("Eine Stimme bruellt laut: Kurs Nordnordwest!\n", 5);
  AddMsg("Der Seelenverkaeufer verlaesst die Zombieinsel und Du bist froh darueber.\n",7);
  AddMsg("Der Seelenverkaeufer segelt nun gen Norden.\n", 6 );
  AddMsg("Der Seelenverkaeufer schwankt und Dir wird uebel.\n", 6 );
  AddMsg("Wie von Geisterhand nimmt das Schiff den richtigen Kurs!\n",7);
  AddMsg("Der Seelenverkaeufer scheint fast uebers das Meer zu schweben.\n", 5 );
  AddMsg("Der Seelenverkaeufer kommt gut voran.\n", 6 );
  AddMsg("Das Schiff naehert sich dem Festland.\n", 7 );
  AddMsg("Der Seelenverkaeufer kommt in die Naehe eines Piers.\n", 5 );      
  AddMsg("Das unheilvolle Schiff landet gleich am Pier nahe Midas.\n", 3);

  AddRoute("/d/wasser/lupus/pier/room/plattform-o", 20,4,
      "An einem Pier nahe Midas",
      ({"midas","pier","dorf","fischerdorf"}),
      "zum Pier vom Fischerdorf");
  //midas->tijara

  //AddRoute("/d/dschungel/feyaria/tijara/room/steg_d1", 20,4,
  //"Im Hafen der Dschungelhauptstadt Tijara");

  AddMsg("Der Seelenverkaeufer nimmt Kurs auf den Hafen von Tijara.\n", 6);
  AddMsg("Die Segel blaehen sich auf und das Schiff wird schneller.\n", 5);
  AddMsg("Eine starke Brise kommt auf und die Segel blaehen sich im Wind.\n", 5 );
  AddMsg("Der Seelenverkaeufer schwankt und Dir wird uebel.\n", 7 );
  AddMsg("Der Seelenverkaeufer schwebt direkt ueber die See.\n", 6 );
  AddMsg("Der Seelenverkaeufer kommt gut voran.\n", 7 );
  AddMsg("Der Seelenverkaeufer scheint von Geisterhand gesteuert zu werden.\n", 4);
  AddMsg("Eine riesengrosse Raubmoewe taucht ober Dir auf!\n", 2);
  AddMsg("Die Raubmoewe kommt immer naeher!\n", 1);

  AddFun("kraehe", 2);

  AddMsg("Die Raubmoewe segelt wieder davon!\n", 3);
  AddMsg("Das Schiff knarrt und aechzt! Hoffentlich geht es nicht unter.\n", 6);
  AddMsg("Du willst runter von diesem verfluchten Schiff.\n", 7 );
  AddMsg("Der Seelenverkaeufer naehert sich dem Hafen von Tijara.\n", 3 );   


  AddRoute("/d/dschungel/feyaria/tijara/room/steg_d1", 20,4,
      "Im Hafen der Dschungelhauptstadt Tijara",
      ({"hafen","dschungel","dschungelhauptstadt","tijara"}),
      "zum Hafen der Dschungelhauptstadt Tijara");

  Start(2);
  JAEGER2

    ACD(({"singe","sing"}), "come_npc");
}



//AE("unten", "nach unten in den Laderaum#./zlade");
//AE("kajuete","in die Kajuete#./zkaj");


kajuete_fun()  {

  if(environment(TP)!=TO)  { 
    write(BS(
          "Dorthin kannst Du nicht gehen."));
    return 1;
  }
  else

    TPM("/d/wasser/dante/zinsel/room/zkaj", M_NOCHECK, "nach unten in die Kajuete",
        "geht", "kommt von oben herabgestiegen");
  return 1; 
}



unten_fun()  {

  if(environment(TP)!=TO)  { 
    write(BS(
          "Dorthin kannst Du nicht gehen."));
    return 1;
  }
  else

    TPM("/d/wasser/dante/zinsel/room/zlade", M_NOCHECK, "nach unten in den Laderaum",
        "geht", "kommt von oben herabgestiegen");
  return 1; 
}




kraehe ()  {
  int i;
  object ob;

  if(random(50)) return; //sonst kommts ja nie

  write("\n\n");
  tell_room(TO, BS(
        "Eine gigantische Raubmoewe attackiert das Schiff und schleppt Dich davon. "
        "Sie wirft Dich bei einer anderen Insel wieder ab. WUMM!!!"));

  write("\n");

  ob=all_inventory(TO);

  if(!sizeof(ob) ) { return;  }

  for(i=0; i<sizeof(ob);  i++)  {

    if( interactive(ob[i]) )  {

      ob[i]->move("/d/dschungel/feyaria/felseninsel/room/strand2", M_GO,
          "von einer Raubmoewe verschleppt", "wird",
          "wird von einer Raubmoewe hier hergeschleppt");
    }
  }
} 


sturm()  {
  int i;
  object ob;

  if(random(50)) return; //sonst kommts ja nie

  write("\n\n");
  tell_room(TO, BS(
        "Eine gigantische Welle schlaegt ueber das Schiff herein und reisst "
        "alles ins Meer was nicht niet und nagelfest ist!!! Du gehts ueber Bord!!!"));
  write("\n");

  ob=all_inventory(TO);

  if(!sizeof(ob) ) { return;  }

  for(i=0; i<sizeof(ob);  i++)  {

    if( interactive(ob[i]) )  {

      ob[i]->move("/d/wasser/dante/zinsel/room/wswim", M_GO,
          "von einer Sturzflut weggeschwemmt", "wird",
          "wird vom wilden Meer hier hergespuelt");
    }
  }
} 



int come_npc(string str)  {
  object ob1;


  if(environment(TP)!=TO)  { return 0; }

  NF("Was willst Du singen?!\n");
  if(!str) return 0;



  if(member(({
          "wir koepften sie ohne gnade", "Wir koepften sie ohne Gnade",
          "wir koepften sie ohne gnade," , "Wir koepften sie ohne Gnade,",		
          "und nahmen sie danach aus", "und nahmen sie danach aus!"}),str)!=-1)  {
    write(
        "Du singst einen Teil des alten Liedes.\n"
        "Irgendetwas neben Dir stoesst Dich! AUA!\n"
        "Hmm, scheinbar nicht genug!\n");
    TP->do_damage(3);
    return 1; 
  }

  if(member(({
          "wir koepften sie ohne gnade, und nahmen sie danach aus",
          "Wir koepften sie ohne Gnade, und nahmen sie danch aus",
          "wir koepften sie ohne gnade, und nahmen sie danach aus!",
          "wir koepften sie ohne gnade, und nahmen sie danach aus!",
          "wir koepften sie ohne gnade und nahmen sie danach aus",
          "wir koepften sie ohne gnade und nahmen sie danach aus!",
          "Wir koepften sie ohne Gnade, und nahmen sie danch aus!"  		
          }),str)!=-1)  {  

    write(
        "Du singst `Wir koepften sie ohne Gnade, und nahmen sie danach aus!`\n"
        "Ein Schauer jagt durch Dich, ein Aechzen geht durch das Schiff!\n"
        "Angst steigt in Dir hoch!\n");
    say(BS(
          CAP_TPN+" singt ein altes Lied. Du bekommst etwas Angst, das "
          "Lies klingt sehr unheimlich!"));

    if(!geister)  {
      write(BS(
            "Das Schiff aechzt und stoehnt, doch sonst passiert nichts!"));
      say(BS(
            "Das Schiff aechzt und stoehnt, doch sonst passiert nichts!"));
      return 1; }


      if(geister)  {

        say(BS(
              "Die Luft vor Dir flimmert und pulsiert. Ein Geist scheint "
              "sichtbar zu werden!"));
        write(BS(
              "Das Schiff aechzt und stoehnt und ploetzlich scheint "
              "die Luft vor Dir zu flimmern und zu pulsieren! Ein "
              "Geist scheint sichtbar zu werden!"));
        ob1=CLONEOB("d/wasser/dante/zinsel/npc/gmatrose");
        ob1->move(TO, M_NOCHECK+M_SILENT);
        ob1->Kill(TP);
        geister--;
        return 1; 
      }
      return 0; 
  }
  return 0; 
}




int pull(string str)  {
  if(environment(TP)!=TO)  { return 0; }
  NF("Was willst Du bewegen?!\n");

  if(!str) return 0;


  if(str=="seil"||str=="am seil"||str="an seil")  {
    write(BS(
          "Du bewegst das Seil. Ein Stueck Holz faellt herab!!! WUMMM!!! "
          "Das Licht geht aus, zumindest bei Dir!"));
    say(BS(
          CAP_TPN+" wird von einem Stueck Holz getroffen und faellt um!"));
    TP->do_damage(10);
    TP->SetProp(P_PARALYZED, ([
          PARALYZE_TIME: 5+random(5),
          PARALYZE_MSG: "Aber Du bist doch total benommen!\n",
          PARALYZE_MSG_OTHER: "%s sinkt zu Boden!\n",
          PARALYZE_END: "Du kommst wieder zu Sinnen!\n",
          PARALYZE_END_OTHER: "%s kommt dumm guckend wieder zu sich!\n"]));
    return 1;                         
  }
  return 0;
}


enter_ship(string str)
{  
  if (str=="schiff" || str=="seelenverkaeufer")
    return Enter();
}

leave_ship(string str)
{  
  if (str=="schiff" || str=="seelenverkaeufer")
    return Leave();
}


