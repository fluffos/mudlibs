//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
#include <mnpc.h>
string farbe;
string dir;

int heilen=10;
reset()  {
	::reset();
	heilen=10;  }
	
void create()
{
  ::create();

farbe="gruen";
dir="Sueden";

gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
"Der Saeulengang fuehrt von der oberen Saeulenhalle weg Richtung "+dir+". "
"Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
"nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
"die in stabilen Haltern an den Waenden angebracht sind, "
"werfen unheimliche Schatten an die Waende und Decke. Die "
"Schatten scheinen direkt um Dich herumzutanzen. Hier "
"haelt Dich irgendeine gute Macht..."));

AD("macht",
"Sie will Dir helfen!");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur Deinen eigenen, schnellen Atem.");
    
  AddSound( ({DEFAULT_SOUND, "atem"}),
    "Schnell, fast panisch.");

AddSmell(({DEFAULT_SMELL,
"Es riecht nach Zombies."}));
AddSmell(({"zombie","zombies"}),
"Zombies stinken extrem.");


AD(({"totenschaedel","schaedel"}),
"Die Schaedel sind hier voellig deformiert. Sie sind "
"eigentlich nur mehr traurige Truemmer.");

AD("truemmer",
"Die Truemmer verdecken einen Knopf.");
AD("knopf",
"Was kann man damit wohl machen?!");


AD("farbe",
"Hier ist alles in "+farbe+"er Farbe gehalten.");
AD("marmor",
"Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
"sein. Eine unheimliche Kaelte geht von ihm aus.");
AD(""+dir+"",
"Im "+dir+" fuehrt der Gang weiter.");
AD("richtung",
"Der Saeulengang fuehrt weiter nach "+dir+"!");


AIT("/d/wasser/dante/zinsel/npc/zsnake", REFRESH_DESTRUCT,
([P_MNPC_FLAGS: MOV_INDOORS,
  P_AGGRESSIVE: 1]));
AIT("/d/wasser/dante/zinsel/npc/zsnake", REFRESH_DESTRUCT,
([P_MNPC_FLAGS: MOV_INDOORS,
  P_AGGRESSIVE: 1]));
AIT("/d/wasser/dante/zinsel/npc/zsnake", REFRESH_DESTRUCT,
([P_MNPC_FLAGS: MOV_INDOORS,
  P_AGGRESSIVE: 1]));


JAEGER1


AE("sueden", "./s2");
AE("norden", "./z1");

ACD(({"druecke","drueck"}), "gut");


AddRoomMessage(({
	"Einer der Totenschaedel sagt: Hallo!\n",
	"Einer der Totenschaedel kichert.\n",
	"Einer der Totenschaedel scheint sich zu bewegen!\n",
	"Dieser Ort ist anders...\n",
	"Du glaubst, dass hier etwas ist...\n"}),10);
	
}





int gut(string str)  {
	NF(BS("Was willst Du hier druecken?!\n"));

if(str=="knopf")  {
	write(BS(
"Du drueckst den Knopf!"));
say(BS(CAP_TPN+" drueckt einen Knopf."));

if(heilen)  {
	write(BS("Einer der Schaedel grinst und spuckt Dir genau in den Mund!!! "
	"Ekligerweise heilt Dich das?!"));
	TP->heal_self(10);
	heilen--;  
	return 1; }
if(!heilen)  {
	write(BS(
"Nichts passiert."));
return 1; }
return 0; }
return 0; }
				