//uebergang von der zombieinsel zu den gildenraeumen
//der nekromanten dante sl 99


#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <room.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>

inherit "/d/wasser/dante/zinsel/room/tr_det.lpc";



create()
 {
 	::create();
treppe_details(); 

SP(P_INT_LONG, QP(P_INT_LONG)+"Die Treppe fuehrt hier wieder direkt "
"durch den Saeurefall "
"nach oben in die Halle und nach unten weiter in das Reich der Nekromanten.");

SP(P_KILL_NAME, "Saeure");

ASE("oben", "go_up");
AE("unten", "./treppe2");

}

int go_up()  {
	write(BS(
"Du steigst direkt durch den Saeurefall nach oben."));

   if(TP->QP(P_GUILD)=="nekromanten")   {
   	write(BS(
"Der Saeurefall teilt sich wie ein Vorhang fuer Dich Nekromanten!"));
        }
 
 
 if(TP->QP(P_GUILD)=="paladine")   {	 		
  write(BS(
"Der Saeurefall zischt laut als Du Paladin hindurchsteigst! Du "
"wirst leicht veraetzt!"));
TP->do_damage(random(5));
}

if(( TP->QP(P_GUILD)!="nekromanten") && (TP->QP(P_GUILD)!="paladine"))

     {
  write(BS(
  "Der Saeurefall zischt laut, aber Dir passiert nichts!"));
}

return TPM("/d/wasser/dante/zinsel/room/saeure3", M_GO,
"nach oben durch den Saeurefall hindurch", "steigt die Treppe",
"kommt direkt aus dem Saeurefall herauf");
}

		