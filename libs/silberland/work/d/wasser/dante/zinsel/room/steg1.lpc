//dante sl 99

inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>



int am=50+random(50);
int pap=1;

reset()  {
	::reset();
	pap=1;
}

void create()
{
  ::create();

  SSH("Auf einem Steg bei der Zombieinsel");
  SetProp(P_INT_LONG, BS(
"Du stehst hier auf einem hoelzernen Steg an einer kleinen "
"Insel, die voellig alleine mitten im weiten Meer liegt. "
"Der Steg wurde vor langer Zeit erbaut und das merkt man dem "
"Holz auch an. Die vielen Stuerme und das ewige Hin und Her "
"der Wellen haben dem Steg maechtig zugesetzt. Trotzdem scheint "
"er sogar Dich auszuhalten. Im Norden erstreckt sich die kleine, "
"unscheinbare Insel. Was Dich da wohl erwartet?"));


AD("himmel",
"Der Himmel ist wolkenlos und strahlenblau. Herrlich!");
AD("wasser",
"Das Wasser glitzert hier gruen und blau. HE! Was ist das! Eine "
"Flosse ragt da heraus!");
AD("flosse",
"Hmm, es handelt sich um einen Hai!");
AD(({"hai","haie"}),
"Hier schwimmen Haie sehr oft vorbei, also sei vorsichtig, wenn Du "
"schwimmen gehst!");

AD(({"hin","her"}),
"Ewig schlagen die Wellen gegen den Steg.");
AD("boden",
"Der Boden besteht aus alten Planken.");
AD(({"planke","planken"}),
"Die Planken sind morsch und knirschen. Teilweise haben sie "
"schon seltsame Muscheln angesetzt.");
AD(({"muschel","muscheln"}),
"Sie sehen irgendwie merkwuerdig aus. Verfault und irgendwie mutiert. "
"Merkwuerdig. Was koennte das bedeuten. Vielleicht kann man ja eine "
"Muschel aufbrechen.");

AD("insel",
"Die Insel liegt ruhig und beschaulich vor Dir im Norden. Sie "
"scheint fast nur aus Sand zu bestehen. Ab und zu sieht man einen "
"Strauch und da ist noch etwas, das eigentlich sofort zu bemerken ist. "
"Ein gigantisch grosser, verdorrter, uralter Baum!!!");

AD("baum",
"Der Baum steht mitten auf der Insel. Die Insel liegt sozusagen "
"um den Baum herum. Er sieht sehr ausgetrocknet aus und irgendetwas "
"zieht Dich magisch in den Baum! Ja, kein Typo, was aber hier keinen "
"wundern wuerde, Du hast richtig gelesen! IN den Baum!");
AD(({"IN","in","typo"}),
"Man kann angeblich irgendwie in den Baum hinein.");

AD(({"strauch","straeucher"}),
"Auch die Straeucher sehen nicht gerade gesund aus, aber die sind "
"wohl etwas weit weg um sie zu analysieren. Du kleiner Botaniker Du!");

AD("botaniker",
"BAEH!");

SP(P_KILL_NAME, "Eine Muschelallergie");

AD("norden",
"Im Norden liegt sie sandige Insel! Geh doch hin!");
AD("sand",
"Der Sand ist teilweise schneeweiss, dann wiederum braeunlich, aber "
"auf jeden Fall ist er heiss.");
ASD("fall", "plop");

AD("steg",
"Der Steg sieht arg mitgenommen aus. Sein Holz ist teilweise schon "
"verfault und knirscht verdaechtig unter Dir.");
AD("holz",
"Das uralte Holz muss schon seit sehr langer Zeit den Stuermen und "
"dem Meer ausgesetzt sein...");
AD("meer",
"Das Meer ist momentan noch recht ruhig, doch das kann sich auch aendern. "
"Ruhig und angenehm branden die Wellen an die Insel und man koennte "
"fast glauben, dass es hier gemuetlich sein kann.");
AD(({"welle","wellen"}),
"Die Wellen wogen momentan sanft gegen die Insel, doch sie koennen "
"sich auch zu gewaltigen Stuermen erheben.");
AD(({"sturm","stuerme"}),
"He! Was siehst Du da am Horizont! Braut sich da etwa ein Sturm zusammen!");
ASD("horizont", "gag");
AD("zeit",
"Der Steg wurde vor vielen Jahren von einem Abenteurer erbaut.");
AD(({"jahre","jahren"}),
"Mindestens 500 Jahre!");
AD("abenteurer",
"Wer es genau war, weiss man nicht mehr. Doch angeblich hat er "
"die schoene Insel panikartig verlassen, als er bemerkte was hier "
"so vor sich geht...");




 SetProp(P_LIGHT,1);
 SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN, ENV_TEMPERATURE:30]));   
  

// -----------------------------------------------------------
// aufgrund von balance ueberpruefung
// erhoeht jetzt Sehertorkosten 
AIT("d/wasser/dante/zinsel/npc/comicdr", REFRESH_DESTRUCT);
// -----------------------------------------------------------

//

AIT("d/wasser/dante/zinsel/room/zschiff", REFRESH_DESTRUCT, 1);


 

AddSmell( DEFAULT_SMELL,
  "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
  "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
  "Das Meer rauscht sanft an der kleinen Insel vorbei!");
  AddSound("meer",
  "Es fliesst hier nicht allzu schnell vorbei.");



ACD(({"brich","breche"}), "text");
ACD(({"schwimm","schwimme"}), "nix");


AE("norden", "./isle_enter");



ACD(({"gilde"}), "go_insel");  


}


int go_insel()  {
if(IS_WIZARD(TP)||TP->QP(P_TESTPLAYER))  {

   TPM("gilden/abenteurer", M_GO+M_SILENT);
      return 1; }
         return 0; }
         




int nix(string str)  {
	NF("Wo willst Du schwimmen?!\n");
if(member(({"im meer","im wasser","in wasser","in meer",
"raus","hinaus"}),str)!=-1)  {


switch(random(3))  {
	case 0:
	write(BS(
"Das Wasser ist hier voller Haie! Lass es lieber!"));
  say(BS(
  CAP_TPN+" hat Angst vor Haien!")); 
   break;	
   case 1:
   write(BS(
   "Du steckst einen Zeh ins Wasser!!! IHH!!! Das Meer ist hier scheinbar "
   "doch recht kalt. Nein! Hier willst Du nicht schwimmen!"));
   say(BSA(
   "Nein! Das Wasser ist mir zu kalt! Hier schwimme ich sicher "
   "nicht!", ""+CAP_TPN+" teilt Dir mit: "));
   break;
   case 2:
   write(BS(
   "Die Stroemung scheint irgendwie gefaehrlich zu sein! Lass es!"));
   say(BS(
   CAP_TPN+" will hier nicht schwimmen!"));
   break;
   default:write("\n");
             }
 return 1; }
return 0; }

int text(string str)  {
	NF("Was willst Du hier aufbrechen?!\n");
if(str=="muschel"||str=="muschel auf") {

if(pap)  {

write(BS(
"Du brichst eine Muschel auf. Im Inneren der Muschel findest "
"Du einen Zettel, den Du sofort liest. Da steht doch glatt was "
"von Zombies und einem Virus und das es ein Gegenmittel irgendwo "
"unter Wasser in einer Kiste geben soll. MIST!!! VERDAMMT!!! Der "
"Wind reisst Dir den Zettel aus der Hand!"));		
say(BS(
CAP_TPN+" bricht eine Muschel auf."));
pap=0;
return 1; }

if(!pap)  {
write(BS(
"Du brichst eine Muschel auf und verschneidest Dir dabei die "
"Finger!"));
TP->do_damage(5);
say(BS(
CAP_TPN+" bricht eine Muschel auf und verschneidest sich dabei die "
"dicken Wurstfinger."));
return 1; }
return 0; }
return 0; }


string plop()  {

if(TP->QueryMoney()<100)  {
write(BS(
"Du faellst fast vom Steg ins Wasser, doch Dir armen Schlucker "
"passiert gluecklicherweise doch nichts!"));
say(BS(
CAP_TPN+" taumelt, doch faellt nicht ins Wasser!"));
}	
if(TP->QueryMoney()>=100)  {	
write(BS(
"Du faellst direkt vom Steg ins Meer!!! Schnell kletterst Du wieder "
"aus dem Wasser heraus. Leider hast Du dabei "+am+" Muenzen verloren!"));
TP->AddMoney(-am);
say(BS(
CAP_TPN+" faellt vom Steg ins Wasser und verliert etwas Geld dabei!"));
}
return ""; }





string gag()  {
say(BS(
CAP_TPN+" verliert Magie aus Angst vor einem Sturm!"));	
	write(BS(
"JA! Am Horizont braut sich ein Sturm zusammen! Das erschreckt Dich "
"so, dass Du ploetzlich 10 Magiepunkte verlierst, die mit einem "
"lauten PLATSCHHH ins Wasser fallen."));
TP->restore_spell_points(-10);
return ""; }
	
