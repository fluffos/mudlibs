//dante sl 99
inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"


int da=1;

void create()
{
  ::create();

  SSH("Mitten im Meer, nahe einer Insel mit Baum");
  SLO(BS("In einiger Entfernung siehst Du das Festland, von dem Du gekommen bist. "
        "Erst von hier kannst Du die wirklichen Ausmasse des Baumes erkennen. Er "
        "ist ja noch groesser als Du gedacht hattest. Viel gibt "
        "es hier sonst nicht zu sehen, naja ausser dem Meer und dem "
        "Baumstamm, der da mitten im Wasser herumtreibt.")); 


  AD(({"stamm","baumstamm"}),
      "Der Baumstamm ist durchsichtig?! Wie geht sowas?! Man sieht "
      "ein kleines Objekt!");
  AD("objekt",
      "Wie koennte man an das Objekt kommen?! Haben willst Du es, das "
      "ist klar.");

  AD("wasser",
      "Das Wasser ist hier sehr ruhig.");
  AD(({"hai","haie"}),
      "Haie sieht man hier keine.");
  AD("himmel",
      "Man sieht eine kleine Wolke.");
  AD("wolke",
      "Die Wolke ist schneeweiss und man sieht eine seltsame Delle.");
  AD("delle",
      "Die Delle sieht aus wie eine Axt.");
  AD("axt",
      "Eine wolkige Axt. Sowas?! Aber vielleicht ist das "
      "ein Hinweis...");
  AD("hinweis",
      "Kann man den Baumstamm vielleicht spalten?!");

  AD("boden",
      "Das Meer ist hier sehr tief.");

  AD("meer",
      "Du bist mitten drin.");
  AD("baum",
      "Den sieht man auch. Der Baumstamm ist aber interessanter.");
  AD("insel",
      "Die liegt im Osten.");
  AD("osten",
      "Dorthin kann man schwimmen.");
  AD("ausmasse",
      "Der Baum ist wirklich sehr gross. Untersuch lieber den Stamm!!!");
  AD("land",
      "Das Festland, die Insel, liegt im Osten.");
  AD("festland",
      "Das Festland ist nicht weit von hier.");


  AD("entfernung",
      "In einiger Entfernung ist die Insel.");



  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]));

  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht und gluckst hier wild.");
  AddSound("meer",
      "Es rauscht hier recht laut.");

  AddCmd (({"schwimme", "schwimm"}), "swim");

  AIT("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);

  ACD(({"spalte","spalt"}), "get");

}

int get(string str)  {object ob;
  NF("Was willst Du hier spalten?!\n");

  if(member(({"stamm","baumstamm"}),
        str)!=-1)   {
    write(BS(
          "Du versuchst den Stamm zu spalten."));
    say(BS(
          CAP_TPN+" versucht den Stamm zu spalten!"));


    if(!da) {
      write(BS(
            "Es gelingt Dir nicht den Stamm zu spalten."));
      return 1; 
    }			

    if(da)   {
      write(BS(
            "Du spaltest den Stamm, ein Objekt fliegt Dir zu, und der "
            "Baumstamm schliesst sich wieder!!! WOW!!!"));
      ob=clone_object("/d/wasser/dante/zinsel/obj/magictrichter");
      ob->move(TP, M_GET);
      da=0;
      return 1; 
    }
    return 0; 
  }
  return 0; 
}


void reset() {
  ::reset();
  da=1;  
}


void init() {
  ::init();
  if(interactive(TP))  { call_out("hallo", 10); }
}

void hallo() {
  if(!TP || environment(TP)!=TO) return ;
  write(BS(
        "Dieser Ort gefaellt Dir gut! Schau ihn Dir gut an, es lohnt sich sicher!"));
}



int swim(string str )
{
  NF("Du schwimmst ein bisschen herum und gelangst immer wieder hier her.\n");

  if(!str)   {
    write(BS(
          "Du schwimmst ein bisschen im Wasser herum."));
    say(BS(
          CAP_TPN+" schwimmt um Dich herum und grinst."));
    return 1; 
  }

  if(member(({"nach osten", "zur insel", "zurueck", "zu insel"}),str)!=-1)  {
    {
      write(BS(
            "Du schwimmst in Richtung der grossen Insel."));
      this_player()->move("/d/wasser/dante/zinsel/room/isle_05", M_GO,
          "davon", "schwimmt", "kommt aus dem Wasser gestiegen");
      return 1;
    }

    return 0; 
  }
  return 0; 
}
