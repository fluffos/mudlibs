       "Hasenpenisen und Otternasen. Eine Prise Wieseleingeweide drauf und fertig. "
       "Er serviert Dir das leckere gefuellte Brot und voller Heisshunger isst Du es "
       "auf! WOW! Das war lecker! Vor allem die Otternasen!",

       "&& sagt etwas zu Zerfallos. "
       "Zerfallos kramt in einer alten Truhe herum. "
       "Dann holt er ein "
       "riesengrosses, leckeres Brot heraus. Er fuellt das Brot mit Schweinsaugen, "
       "Hasenpenisen und Otternasen. Eine Prise Wieseleingeweide drauf und fertig. "
       "Er serviert && das leckere gefuellte Brot und voller Heisshunger isst && es "
       "auf! WOW! Das war lecker! Vor allem die Otternasen! Sowas willst Du auch!",
       "setzt sie an und trinkt sie aus."}));

  AddFood ( "Toter Zombie", ({"toter zombie", "zombie","toter","toten"}), 
      290, 50, 14,
      ({"Du bestellt einen toten Zombie und erhaeltst tatsaechlich einen "
       "ganzen, wenn auch kleinen gebackenen Zombie, denn Du mit grosser "
       "Muehe verschlingst.",
       "&& bestellt sich eine ganzen, wenn auch kleinen toten Zombie, den "
       "&& mit Muehe tatsaechlich alleine verschlingt."}));

  AddFood ( "Frisches Alienherz", ({"herz", "alienherz","alien"}), 
      357, 60,17 ,
      ({"Du isst mit Gruseln ein frisches Alienherz.",
       "&& isst mit Gruseln ein frisches Alienherz."}));

  AddFood ( "Hai a la Surprise", ({"hai","surprise", "surpris"}), 
      300, 30,7 ,
      ({"Du bekommst den Hai a la Surprise und bist sehr enttaeuscht. "
       "Die Ueberraschung besteht aus einem kleinen Marzipanhai, der nicht einmal "
       "gut schmeckt...",
       "&& bestellt sich einen Hai a la Surprise."}));

  AddFood ( "Magiergeschnetzeltes", ({"magier", "geschnetzeltes","magiergeschnetzeltes"}), 
      2500, 100, 17 ,
      ({"Das Magiergeschnetzelte besteht aus geschnetzeltem Nostromo, der "
       "scheinbar einmal zu oft frech war. Nostromo schmeckt ziemlich zaeh und "
       "flachsig.",
       "&& bestellt sich ein Magiergeschnetzeltes und schaut ziemlich doof "
       "drein, als && sieht was && sich da eigentlich kommen hat lassen."}));

  JAEGER1
    JAEGER2

    AE("westen", "./vor2");
  AE("sueden", "./kneipe2");

}


show_race()  {
  if(TP->QP(P_GUILD)=="paladine")   {
    return BS(
        "Dich als Paladin erwartet hier sowieso nur der Tod! Hau lieber ab!");
  }
  if(TP->QP(P_GUILD)=="nekromanten")   {
    return BS(
        "Willkommen, "+TPN+", bald bist Du in Deiner Heimat! Blutende Paladine "
        "gefallen Dir immer!!!");
  }

  else 
  {
    return BS(
        "Dir, der Du weder Paladin noch Nekromant bist, ist das eigentlich alles egal.");
  }   } 	     	




int trinke_antidot(object zahler, object trinker)
{
  object ob;
  ob=deep_present("DANTE_ZOMBIE_VIRUS", trinker);	

  tell_object(trinker, BS(
        "Du bestellst Dir ein Virenantidot, trinkst es sofort aus..."));

  tell_room(TO, BS(
        ""+trinker->name(WER)+" trinkt ein Virenantidot und..."),
      ({trinker}) );

  if(ob)  {           ob->setze_alte_werte();

    /*
       if(ob) {
       ob->setze_alte_werte();
       ob->destruct();  }
       */

    tell_object(trinker, BS(
          "Es brennt und zischt in Dir! Du scheinst geheilt zu sein!!!"));

    tell_room(TO, BS(
          ""+trinker->name(WER)+" schreit laut auf! Aber das Antidot scheint zu wirken!!!"),
        ({trinker}) );
    return 1;
  }

  if(!ob)  {
    tell_object(trinker, BS(
          "Es brennt und zischt in Dir! Du warst nicht mit dem Virus infiziert und bist nun vergiftet!!!"));

    TP->AddPoison(2);

    tell_room(TO, BS(
          ""+trinker->name(WER)+" vergiftet sich selbst."),
        ({trinker}) );	
    return 1;
  }

}	

