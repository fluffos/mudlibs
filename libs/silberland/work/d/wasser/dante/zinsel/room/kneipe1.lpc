
/*
   kneipe dante&sl 99

   verbindung zum mystaggogen
   verbindung zum Saeurefall der hinunter zu den Nekromanten geht


*/

#include "/players/dante/myowndefine.h"

inherit "std/pub";
#include <pub.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <mnpc.h>

int x;


void reset()  {
  object aus;
  ::reset();
  x=10000+random(10000);
  aus=present("aussaetziger", TO);

  if(aus)  {

    aus->move("/d/wasser/dante/zinsel/room/z2", M_GO);
  }	
}


void init()  {
  ::init();
  if(TP->id("aussaetziger"))  {
    if(!random(2))  {

      TP->move("/d/wasser/dante/zinsel/room/z2", M_GO);
    }	
  }

  if(interactive(TP))  {
    if(!random(50))   {
      call_out("aua", 4); 
    }
  }
}


aua()  {
  if(environment(TP)!=TO)  return ;
  write(BS(
        "Du rutscht am glatten Boden aus und knallst gegen die Theke!"));
  TP->do_damage(3);
  say(BS(
        CAP_TPN+" rutscht am glatten Marmorboden aus und knallt gegen die Theke."));
}


void create()
{
  ::create();

  x=20000+random(20000);

  SetProp(P_LIGHT, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));   

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "zerfallos");
  SetProp(P_PUBKEEPER_NAME, "Zerfallos Zombioid");
  SetProp(P_PUBMSG_NOKEEPER, "Sorry, aber Zerfallos ist nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
        "Zerfallos serviert DIR hoechstens den Tod!"));

  SetProp(P_PUBMSG_NOINVITE, BS(
        "Zerfallos serviert Dir sicher nichts!"));
  SetProp(P_PUBMSG_FIGHTING, "Zerfallos ist doch beschaeftigt!!!\n");

  SP(P_INT_SHORT, "Bei Zerfallos Zombioid");
  SP(P_KILL_NAME, "Ein glitschiger Fussboden");

  AIT("/d/wasser/dante/zinsel/npc/blitzd", REFRESH_DESTRUCT);

  AIT("/d/wasser/dante/zinsel/npc/zer", REFRESH_DESTRUCT);



