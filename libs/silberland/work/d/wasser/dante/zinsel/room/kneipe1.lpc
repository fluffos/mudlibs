  AD(({"rand","raender"}),
      "Die Raender sind scharf und zackig. Blut tropft herab.");
  AD("blut",
      "Hmm, es sieht so aus wie das Blut eines Paladins...");
  AD("tod",
      "Der Tod lauert hier ueberall.");

  ASD("paladin", "show_race");

  AD("saeure",
      "Man sieht sie noch nicht, aber man kann sie riechen.");
  AD("geruch",
      "Mal riecht man ihn, mal nicht.");

  AD(({"marmortische","tische","tisch"}),
      "Die Tische sind quadratisch. Kleine Kerzen stehen auf ihnen.");
  AD(({"kerze", "kerzen"}),
      "Die Kerzen brennen hell. Sonst waers es ja hier stockdunkel.");

  AD(({"halle","saeulenhalle"}),
      "Die Saeulenhalle liegt direkt ueber Dir.");

  AD("sessel",
      "Die Sessel sind ebenfalls aus Marmor und sehen nicht gerade "
      "gemuetlich aus. He! Da ist ein Schild.");
  AD("schild",
      "Lies es.");
  ARD("schild",
      "Dantinische Marmorbrueche.");
  AD("marmorbrueche",
      "Wo die wohl sind?!");



  AD("norden",
      "Da befindet sich eine prunkvolle, fast angeberische Theke aus Marmor.");
  AD(({"marmortheke","theke"}),
      "Die Theke ist enorm gross und muss unglaublich viel wiegen.");

  AD("tor",
      "Das Tor fuehrt nach Sueden in die Klause eines Mystagogen.");
  AD("sueden",
      "Im Sueden kannst Du durch ein Tor die Klause eines Mystagogen betreten.");
  AD("klause",
      "Tja, was ist das wohl? Eine weltabgeschiedene Behausung, eine Behausung, die "
