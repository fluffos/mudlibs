//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
#include <mnpc.h>

string farbe;
string dir;

int pulled=0;

void create()
{
  ::create();

  farbe="blau";
  dir="Westen";

  gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Der Saeulengang fuehrt von der oberen Saeulenhalle weg Richtung "+dir+". "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten scheinen direkt um Dich herumzutanzen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  SP(P_KILL_NAME, "Die boese Macht der Zombieinsel");

  AD(({"halter","haltern"}),
      "Die Halter sind an die Wand genagelte Totenschaedel. Einer der Halter, "
      "ein schwarzer Halter,  sieht aus wie ein Hebel!!!");
  AD(({"schwarzer halter","hebel"}),
      "Es ist auch ein Hebel! Er oeffnet etwas, aber was...");

  AddRoomMessage(({
        "Die Halter sind hier irgendwie anders.\n",
        "Die Halter interessieren Dich hier sehr.\n",
        "Die Fackeln sind hier auffaellig.\n",
        "Hier scheint etwas zu sein!\n",
        "Bleib hier und schau genau!\n"}),20);



  ACD(({"zieh","ziehe","bewege","beweg"}), "do_hebel");

  AD("farbe",
      "Hier ist alles in "+farbe+"er Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus.");
  AD(""+dir+"",
      "Im "+dir+" fuehrt der Gang weiter.");
  AD("richtung",
      "Der Saeulengang fuehrt weiter nach "+dir+"!");

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");

  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");


  AE("osten", "./z1");
  AE("westen", "./w2");

  AIT("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT, 
      ([P_MNPC_FLAGS: MOV_INDOORS]));
  AIT("/d/wasser/dante/zinsel/npc/zdog", REFRESH_DESTRUCT);


}

void init()  {
  ::init();
  if(interactive(TP))  {
    call_out("hallo", 10);  
  }
}

hallo()  {
  if(!TP && environment(TP)!=TO) return ;
  write(BS(
        "HE! Da war etwas an einem der Halter!"));   
}


int do_hebel(string str)  {
  NF("Was willst Du hier ziehen?!\n");
  if(str=="hebel"||str=="am hebel"||str=="an hebel")  {

    if(present("zombie", TO))  {
      write(BS(
            "Der Zombie schlaegt Dich nieder!"));
      TP->do_damage(5);
      return 1; 
    }

    write(BS(
          "Du ziehst den Hebel!"));
    say(BS(
          CAP_TPN+" zieht einen Hebel!"));

    if(pulled)   {
      write(BS("Du hoerst aus dem Nordosten ein lautes Geraeusch! "
            "Scheinbar ist ein Tor zugegangen!"));
      call_other("d/wasser/dante/zinsel/room/n1", "close_door");
      pulled=0; 
      return 1; 
    }

    if(!pulled)  {
      write(BS("Du hoerst aus dem Nordosten ein lautes Geraeusch! "
            "Scheinbar ist ein Tor aufgegangen!"));
      call_other("d/wasser/dante/zinsel/room/n1", "open_door");
      pulled=1; 
      return 1; 
    }
    return 0; 
  }
  return 0; 
}


void reset()  {
  ::reset();

  if(pulled==1)  {
    pulled=0;
    tell_object(TO,
        "Du hoerst aus dem Nordosten ein lautes Geraeusch! "
        "Scheinbar ist ein Tor zugegangen!\n");
    call_other("d/wasser/dante/zinsel/room/n1", "close_door");
  }
}
