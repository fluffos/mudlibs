/*

   laden bei den zombiejaegern



*/



inherit "std/laden";
#include <properties.h>
#include <laden.h>
#include "/players/dante/myowndefine.h"
#include "wizlevels.h"
#include "moving.h"
#include <mnpc.h>




void create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_LONG, BS(
        "Du befindest Dich hier in Ernas Kramladen, der natuerlich klinisch "
        "rein ist. Nichts aber auch nichts ist hier staubig oder schmutzig. "
        "Sollte Erna anwesend sein, kannst Du hier alles moegliche kaufen "
        "oder verkaufen, nur eines solltest Du nicht machen, Schmutz! "
        "Der Laden ist ein kleiner Teil des Hauptquartieres der Zombiejaeger. "));

  AD("teil",
      "Das Quartier wird immer groesser und groesser.");
  AD(({"quartier","hauptquartier","jaeger","zombiejaeger"}),
      "Die Zombiejaeger sind erst dabei sich zu etablieren.");



  SetProp (P_INT_SHORT,"In Ernas Kramladen auf der Zombieinsel");

  AddDetail( ({ "zombies", "zombie" }), 
      "Bis hierher sind die Zombies noch nie gekommen." );
  AddDetail("schmutz",
      "Genau den gibt es hier nicht.");

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER  | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "erna");
  SetProp(P_SHOPKEEPER_NAME, "Erna, die Putzfrau");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  AddDetail("pech",
      "Sie wird sicher bald wieder hier sein.");

  AddDetail ("laden", "Du stehst mittendrin in Ernas Kramladen.\n");
  AddDetail ("erna", "Sie scheint wohl nicht hier zu sein. Dein Pech!.\n");
  AddDetail("putzfrau","Erna, die ehemalige Putzfrau von Dante ist im Moment "
      "leider nicht hier...");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehn aus groben Stein und sind natuerlich blitzblank sauber. "
      "Ausser einer Tafel und einem Schild faellt Dir nur noch ein Regal auf.");
  AddDetail("regal",
      "Das Regal haengt an der Wand und scheint keinerlei Funktion zu haben.");
  AddDetail("funktion",
      "Du kannst es drehen und wenden wie Du willst, Du kommst nicht drauf was das "
      "soll...");

  AddDetail("kramladen",
      "Naja, hier gibt es auch Kram zu kaufen.");
  AddDetail("kram",
      "Unnuetzes Zeug.");
  AddDetail("zeug",
      "Unnuetzen Kram."); 
  AddDetail("stein",
      "Der Stein schimmert und blitzt, so dass Du fast geblendet wirst.");
  AddDetail("decke",
      "Die Decke ist mit Holz verkleidet. Einige kleine Lampen haengen herab.");
  AddDetail("holz",
      "Helles, grobfaseriges Kiefernholz.");
  AddDetail("kiefernholz", "Das Holz der Kiefer ist weich und "
      "laesst sich daher gut bearbeiten.");
  AddDetail("kiefer",
      "Du ueberlegst ob Du schon jemals eine Kiefer gesehen hast.");
  AddDetail(({"lampen","lampe"}),
      "Es sind kleine, blaeuliche Oellampen, die ein angenehmes Licht "
      "verbreiten.");
  AddDetail(({"oellampen","oellampe"}),
      "Die Oellampen muessen von Zeit zu Zeit mit....Richtig!...Oel gefuellt "
      "werden.");
  AddDetail("zeit",
      "Zeit ist alles was wir haben.");
  AddDetail("boden",
      "Der Boden ist sauber, nein nahezu steril. Ausser einer Klappe faellt "
      "Dir eigentlich nichts auf.");
  AddDetail(("licht"),
      "Nicht zu hell, aber auch nicht schummrig.");
  AddDetail ("tafel", "Du kannst sie lesen.\n");
  AddDetail(("oel"),
      "Erna wuerde es nie dulden, dass Oel irgendwo herunter tropft.");
  AddDetail("schild",
      "Lies es!");


  AddReadDetail ("schild", "Auf dem Schild steht: Mach ja nichts schmutzig!\n");

  AddReadDetail ("tafel",
      "Verfuegbare Befehle:\n"+
      "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
      "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"+
      "<kaufe> nummer oder\n"+
      "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
      "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
      "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
      "                  Haendler dafuer bezahlt.\n"+
      "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
      "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");



  NewDoor("unten", ("/d/wasser/dante/zinsel/room/zelle1"),
      ({"klappe","metallklappe"}),

      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED |DOOR_NEEDKEY,
       D_LONG, "Die Metallklappe sieht stabil aus, scheint "
       "aber trotzdem sehr alt zu sein. "
       "Sie fuehrt nach unten in das Gefaengnis.",
       D_GENDER, FEMALE,
       D_SHORT, "Eine %se, alte Metallklappe.",
       D_NAME, "Metallklappe",
       } ));

  AD("gefaengnis",
      "Dort werden Zombies und andere Monster festgehalten.");
  AD("monster",
      "UI! Wie schrecklich! Du zitterts! ;-) !");



  AddSmell( DEFAULT_SMELL,
      "Es riecht nach Putzmittel.");

  AddSound( DEFAULT_SOUND,
      "Hier im Laden ist es ruhiger als im Norden."
      " Machmal hoert man von unten einen Schrei.\n");

  AddSmell("putzmittel",
      "Sie verwendet angeblich eingekochte Zombies zum putzen.");
  AddSound("schrei",
      "Dort unten bruellt irgend jemand.\n");    

  JAEGER2

    AddExit("norden", "./vor2"),
  AddItem("d/wasser/dante/zinsel/npc/putze", REFRESH_DESTRUCT);                                       
  SetStorageRoom("/d/wasser/dante/zinsel/room/lagerraum");  
}

