inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

#define Z  (member(z, getuid(this_player()))!=-1)
 string *z=({});

int da=1;


int geister=1;

reset()  {
	::reset();
	da=1; 
	geister=1;}
	
	

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Kajuete" );
  SetProp( P_INT_LONG, BS(
"Du befindest Dich nun in der geraeumigen, prunkvoll "
"eingerichteten Kajuete des Kapitaens. Scheinbar wird sie noch "
"benutzt, den sie sieht sehr sauber und ueberhaupt nicht verstaubt aus. "
"Aber wo ist der Kapitaen? Ist er auch ein Geist? Neben einem "
"grossen Esstisch und einigen Stuehlen, faellt Dir noch ein Bett, "
"ein Kasten und eine grosse Truhe auf."));


AD("bett",
"Das Bett ist auch aus Holz und kunstvoll verziert. Es ist frisch gemacht. "
"Hmm, ob man sich reinlegen soll?");



AD("kasten",
"Der Kasten besteht auch aus Holz, ist aber nicht so schoen "
"verziert.");
AD("truhe",
"Die Truhe besteht aus massiven Gold. Sie muss unglaublich viel "
"wert sein!!!");
AD("gold",
"Es leuchtet herrlich hell.");


AD(({"tisch","esstisch"}),
"Der Esstisch scheint gedeckt zu sein. Eine grosse Kanne steht darauf.");
AD("kanne",
"Hmm, lecker. Leider ist sie verschlossen. Man sollte sie vielleicht "
"einfach zerstoeren, um zu sehen, was drin ist?!");
AD(({"stuhl","stuehle"}),
"Schoene Stuehle aus Holz.");


AD(({"geist","geister"}),
"Hmm, das hat ein Geist oft an sich, das man ihn nicht immer sieht...");
AD(({"wand","waende"}),
"Die Waende sind holzvertaefelt und sehen sehr elegant aus. "
"Ein grosses Bild haengt auch da.");
AD("holz",
"Hier ist das Holz sauber und poliert.");
AD("bild",
"Das Bild zeigt einen Wal.");
AD("wal",
"Der Wal ist gigantisch gross und leuchtet hell. Es ist ein "
"heiliger Wal. Und der Kapitaen war so bloed ihn zu toeten. "
"Und daher ist nun die gesamte Mannschaft fuer immer verflucht und "
"muss als Geister fuer ewig herumsegeln. Was man, wenn man klug ist, "
"nicht alles in ein Bild hineininterpretieren kann. WOW!!!");

AD("mannschaft",
"Alles boese Geister!!!");

AD("kapitaen",
"Tja, wo ist er...");
AD("boden",
"Der Boden ist mit einem dunklem Teppich ausgelegt. Sehr elegant!");
AD("teppich",
"Der Teppich zeigt ein verwirrendes Muster.");
ASD("muster", "get_karte");

AD("kajuete",
"Die Kajuete ist grosszuegig angelegt und viel schoener eingerichtet, "
"als Du es Dir erwartet haettest.");

AD(({"schiff","seelenverkaeufer"}),
"Du bist mitten drin.");
AD("meer",
"Man kann es von hier aus ncht sehen, aber hoeren.");

 SP(P_KILL_NAME, "Der uralte Seelenverkaeufer");
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "decke" }), 
    "Die Decke besteht aus poliertem Holz." );
  AddSound( DEFAULT_SOUND,
"Das Meer rauscht.");
  AddSmell( DEFAULT_SMELL,
    "Die Luft schmeckt und riecht hier sehr feucht.");
AD("luft",
"Feucht!");

AE("raus", "./zschiff");
ACD(({"leg","lege"}), "bett");
ACD(({"oeffne"}), "do_open");
ACD(({"zerstoere","zerstoer"}), "do_kanne");

ACD(({"singe","sing"}), "come_npc");

}

int come_npc(string str)  {
	object ob1, ob2, ob3;
	
  NF("Was willst Du singen?!\n");
  if(!str) return 0;
  
  if(member(({
 "wir koepften sie ohne gnade", "Wir koepften sie ohne Gnade",
  "wir koepften sie ohne gnade," , "Wir koepften sie ohne Gnade,",		
  "und nahmen sie danach aus", "und nahmen sie danach aus!"}),str)!=-1)  {
  	write(
  "Du singst einen Teil des alten Liedes.\n"
  "Irgendetwas neben Dir stoesst Dich! AUA!\n"
  "Hmm, scheinbar nicht genug!\n");
  TP->do_damage(3);
  return 1; }
  
  if(member(({
   "wir koepften sie ohne gnade, und nahmen sie danach aus",
    "Wir koepften sie ohne Gnade, und nahmen sie danch aus",
    "wir koepften sie ohne gnade, und nahmen sie danach aus!",
       "wir koepften sie ohne gnade, und nahmen sie danach aus!",
          "wir koepften sie ohne gnade und nahmen sie danach aus",
             "wir koepften sie ohne gnade und nahmen sie danach aus!",
    "Wir koepften sie ohne Gnade, und nahmen sie danch aus!"  		
   }),str)!=-1)  {  
  
  	write(
  "Du singst `Wir koepften sie ohne Gnade, und nahmen sie danach aus!`\n"
  "Ein Schauer jagt durch Dich, ein Aechzen geht durch das Schiff!\n"
  "Angst steigt in Dir hoch!\n");
  say(BS(
  CAP_TPN+" singt ein altes Lied. Du bekommst etwas Angst, das "
  "Lies klingt sehr unheimlich!"));
  
  if(!geister)  {
  	write(BS(
  "Das Schiff aechzt und stoehnt, doch sonst passiert nichts!"));
  say(BS(
  "Das Schiff aechzt und stoehnt, doch sonst passiert nichts!"));
  return 1; }
  
  
  if(geister)  {
  
  say(BS(
  "Die Luft vor Dir flimmert und pulsiert. Ein Geist scheint "
  "sichtbar zu werden!"));
  	write(BS(
  	"Das Schiff aechzt und stoehnt und ploetzlich scheint "
  	"die Luft vor Dir zu flimmern und zu pulsieren! Ein "
  	"Geist scheint sichtbar zu werden!"));
  	ob1=CLONEOB("d/wasser/dante/zinsel/npc/gmatrose");
  	ob2=CLONEOB("d/wasser/dante/zinsel/npc/gmatrose");
  	ob3=CLONEOB("d/wasser/dante/zinsel/npc/gkap");
  ob1->move(TO, M_NOCHECK+M_SILENT);
  ob2->move(TO, M_NOCHECK+M_SILENT);
  ob3->move(TO, M_NOCHECK+M_SILENT);
  ob1->Kill(TP);
  ob2->Kill(TP);
  ob3->Kill(TP);
  geister=0;
  return 1; }
 return 0; }
return 0; }
  	
  	

int do_kanne(string str)  {
	NF("Was willst Du zerstoeren?!\n");
	if(str=="kanne")  {
	say(BS(
	CAP_TPN+" versucht die Kanne zu zerschlagen."));	
		
if(Z)  {
	write(BS(
	"Aber Du hast doch die Kanne schon einmal zerstoeren wollen."));
			return 1; }
if(!Z)  {
	write(BS(
"Du schlaegt mit voller Wucht auf die Kanne ein. Verfehlst sie, "
"rutscht aus und knallst mit dem Kopf gegen die schwere Truhe! AUA!"
" Hmm, komisch, aber ploetzlich hast Du Worte eines alten Liedes "
"im Kopf. Du singst `Wir koepften sie ohne Gnade`! Hmm, ist das "
"etwas das gesuchte, alte Lied?!"));
 z += ({getuid(this_player())});   				
TP->do_damage(5);
return 1; }
return 0; }
return 0; }


int do_open(string str)  {
	NF("Was willst Du oeffnen?!\n");
	if(str=="truhe")  {
		write(BS(
"Mist! Die Truhe ist fuer Dich einfach zu schwer!"));
say(BS(
CAP_TPN+" ist zu schwach um die Truhe zu oeffnen."));
return 1; }
if(str=="kasten")  {
	  write(BS(
	 "Du oeffnest den Kasten und ploetzlich reisst von innen "
	 "ein Geist den Kasten wieder zu! Tja, Pech! Zu langsam!"));
	 say(BS(
	 CAP_TPN+" wird von einem Geist verarscht."));
return 1; }
return 0; }
	 
	 

int bett(string str)  {
	NF("Wo willst Du Dich reinlegen?!\n");
if(str=="in bett"||str=="ins bett")  {
	write(BS(
	"Du legst Dich ins Bett. Ploetzlich schlaegt Dir ein "
	"unsichtbarer Geist auf den Kopf!!! AUA! Raus da!!!"));
	TP->do_damage(10);
say(BS(
CAP_TPN+" legt sich ins Bett und springt gleich wieder bruellend auf!"));
   return 1; }
  return 0; }
   		

string get_karte()  {
	object ob;
	if(!da)  {
		return BS(
"Das Muster ist nur verwirrend, sonst nichts.");  }
if(da) {
	ob=CLONEOB("/d/wasser/dante/zinsel/obj/zkarte");
	ob->move(TP, M_NOCHECK);
	da--;
return BS(
"Du findest im dicken Teppich eine Karte!");
}}
			
      
