//dante sl 98-99

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>

#define LIED  (member(lied, getuid(this_player()))!=-1)
string *lied=({});

int geister=4;
int rat=3;

void reset()  {
  ::reset();
  rat=3;
  geister=4;  
}



void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Laderaum");
  SetProp( P_INT_LONG, BS(
        "Du bist nun im duesteren Laderaum des Schiffes. Er ist sehr feucht und "
        "modrig. Das Wasser scheint durch Luecken und Ritzen im Schiff "
        "einzudringen und es ist nur eine Frage der Zeit, bis das Schiff sinkt. "
        "Alte, verfaulte Saecke liegen herum. Modrige Tonnen versperren Dir "
        "die Sicht. Von oben faellt etwas Licht durch eine Luke herein."));


  AD(({"laderaum","raum"}),
      "Du bist mitten drin!");

  AD(({"wand","waende"}),
      "Die Waende bestehn aus Holz. Sie sind voller Ritzen und Luecken.");

  AD(({"luecke","luecken"}),
      "Langsam aber sicher fliesst das Wasser herein und wird so das "
      "Schiff versenken.");
  AD(({"ritze","ritzen"}),
      "Ritzen ueberall wo man hinsieht. Das Schiff muss bald sinken!");
  AD("sicht",
      "Man sieht nicht allzu weit, weil ueberall Tonnen und Saecke stehen.");



  AD("decke",
      "Die Decke ist aus Holz und enthaelt die Luke.");
  AD("holz",
      "Alt, modrig, faul.");
  AD("licht",
      "Das Licht kommt durch die Luke von oben herab.");
  AD("luke",
      "Die Luke fuehrt Dich wieder nach oben.");
  AD("boden",
      "Der Boden ist voller Wasser und Schmutz.");
  AD("wasser",
      "Das Wasser dringt langsam in das Schiff ein.");
  AD("schiff",
      "Du bist mitten drinnen.");
  AD("schmutz",
      "Hier war schon lange keiner mehr...");


  AD(({"tonne","tonnen"}),
      "Die Tonnen scheinen auch sehr alt zu sein. Sie sind auch schon leck. "
      "Hmm, aus einer der Tonnen scheint eine Stimme zu kommen?!?!?");
  AD("stimme",
      "Die kann man nur hoeren!");

  AddDetail( ({ "frage", "zeit" }), 
      "Was fuer eine dumme Frage!" );
  AddSound("stimme",
      "Sie singt `und nahmen sie danach aus`! Mist, den ersten Teil "
      "konntest Du nicht verstehen!!!");

  AD(({"sack","saecke"}),
      "Die Saecke sind verfault und stinken. Vielleicht sollte man hineingreifen...!WAEH!");

  SP(P_KILL_NAME, "Der uralte Seelenverkaeufer");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]));


  AddSound( DEFAULT_SOUND,
      "Das Wasser rauscht enorm.");
  AddSmell( DEFAULT_SMELL,
      "Die Luft schmeckt und riecht hier sehr feucht.");


  AE("oben", "nach oben aufs Deck#./zschiff");
  ACD(({"greife","greif"}), "in_tonne");
  ACD(({"singe","sing"}), "come_npc");

}

int come_npc(string str)  {
  object ob1;

  NF("Was willst Du singen?!\n");
  if(!str) return 0;

  if(member(({
          "wir koepften sie ohne gnade", "Wir koepften sie ohne Gnade",
          "wir koepften sie ohne gnade," , "Wir koepften sie ohne Gnade,",		
          "und nahmen sie danach aus", "und nahmen sie danach aus!"}),str)!=-1)  {
    write(
        "Du singst einen Teil des alten Liedes.\n"
        "Irgendetwas neben Dir stoesst Dich! AUA!\n"
        "Hmm, scheinbar nicht genug!\n");
    TP->do_damage(3);
    return 1; 
  }

  if(member(({
          "wir koepften sie ohne gnade, und nahmen sie danach aus",
          "Wir koepften sie ohne Gnade, und nahmen sie danch aus",
          "wir koepften sie ohne gnade, und nahmen sie danach aus!",
          "wir koepften sie ohne gnade, und nahmen sie danach aus!",
          "wir koepften sie ohne gnade und nahmen sie danach aus",
          "wir koepften sie ohne gnade und nahmen sie danach aus!",
          "Wir koepften sie ohne Gnade, und nahmen sie danch aus!"  		
          }),str)!=-1)  {  

    write(
        "Du singst `Wir koepften sie ohne Gnade, und nahmen sie danach aus!`\n"
        "Ein Schauer jagt durch Dich, ein Aechzen geht durch das Schiff!\n"
        "Angst steigt in Dir hoch!\n");
    say(BS(
          CAP_TPN+" singt ein altes Lied. Du bekommst etwas Angst, das "
          "Lies klingt sehr unheimlich!"));

    if(!geister)  {
      write(BS(
            "Das Schiff aechzt und stoehnt, doch sonst passiert nichts!"));
      say(BS(
            "Das Schiff aechzt und stoehnt, doch sonst passiert nichts!"));
        return 1; 
    }


    if(geister)  {

      say(BS(
            "Die Luft vor Dir flimmert und pulsiert. Ein Geist scheint "
            "sichtbar zu werden!"));
      write(BS(
            "Das Schiff aechzt und stoehnt und ploetzlich scheint "
            "die Luft vor Dir zu flimmern und zu pulsieren! Ein "
            "Geist scheint sichtbar zu werden!"));

      ob1=CLONEOB("d/wasser/dante/zinsel/npc/gmatrose");
      ob1->move(TO, M_NOCHECK+M_SILENT);
      ob1->Kill(TP);
      geister--;
      return 1; 
    }
    return 0; 
  }
  return 0; 
}



int in_tonne(string str)  {
  object ob;
  NF("Wohinein willst Du greifen?!\n");
  if(str=="in sack"||str=="in saecke" ||str=="in sack rein"||
      str=="in sack hinein")  {
    write(BS(
          "Du greifst in die Tonne..."));
    say(BS(
          CAP_TPN+" greift in eine Tonne."));
    if(rat)  {
      ob=CLONEOB("/d/unterwelt/dante/skel/srat");
      ob->move(TO, M_NOCHECK+M_SILENT);
      ob->SP(P_MNPC_FLAGS, ([MOV_MOVES]));
      write(BS(
            "IHH!!! WAEH!!! Eine Ratte springt heraus!"));
      ob->Kill(TP);
      rat--;
      return 1;   
    }

    else

    {
      say(BS(
            CAP_TPN+" wird von einer Ratte gebissen!"));
      write(BS(
            "IHH!!! Irgendetwas beisst Dich!"));
      TP->do_damage(5);  
      return 1; 
    }
    return 0; 
  }
  return 0; 
}

