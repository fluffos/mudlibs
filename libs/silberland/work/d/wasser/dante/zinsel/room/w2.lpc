//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;

int da=1;

void reset()  {
  ::reset();
  da=1; 
}

void create()
{
  ::create();

  farbe="blau";
  dir="Westen";

  gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
        "Der Saeulengang fuehrt von der oberen Saeulenhalle weg Richtung "+dir+". "
        "Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
        "nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
        "die in stabilen Haltern an den Waenden angebracht sind, "
        "werfen unheimliche Schatten an die Waende und Decke. Die "
        "Schatten scheinen direkt um Dich herumzutanzen. Mitten im Raum "
        "schwebt eine seltsame Kugel."));

  AD("kugel",
      "Die Kugel besteht scheinbar aus Metall und schwebt trotzdem auf und nieder.");
  AD("metall",
      "Das Metall ist poliert und glaenzt schoen. Du erkennst einen "
      "Abdruck.");
  AD("abdruck",
      "Der Abdruck stellt eine Hand dar.");
  AD("hand",
      "Hmm, was koennte man hier wohl machen. Wie entstand der Abdruck?!");



  AD("decke",
      "In der Decke ist ein grosses Loch, durch das helles Licht faellt.");
  AD("licht",
      "Das Licht kommt von oben von der Insel!");
  AD("insel",
      "Hier kann man zur Insel rausklettern!!!");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen, schnellen Atem.");

  AD("farbe",
      "Hier ist alles in "+farbe+"er Farbe gehalten.");
  AD("marmor",
      "Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
      "sein. Eine unheimliche Kaelte geht von ihm aus.");
  AD(""+dir+"",
      "Im "+dir+" endet der Saeulengang an einem Tor.");
  AD("richtung",
      "Der Saeulengang fuehrt weiter nach "+dir+"! "
      "Doch ist da noch das "+farbe+"e Tor!");

  AddSound( ({DEFAULT_SOUND, "atem"}),
      "Schnell, fast panisch.");

  AddSmell(({DEFAULT_SMELL,
        "Es riecht nach Zombies."}));
  AddSmell(({"zombie","zombies"}),
      "Zombies stinken extrem.");


  AIT("/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));


  AIT("/d/wasser/dante/zinsel/npc/dmonster", REFRESH_DESTRUCT);




  AE("osten", "./w1");
  AddGuardedExit("oben", "/d/wasser/dante/zinsel/room/isle_05",
      "zombie", "Der Zombie haelt Dich fest!\n");

  NewDoor("westen", ("d/wasser/dante/zinsel/room/w3"),
      ({"tor"}),

      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED | DOOR_NEEDKEY,
       D_LONG, "Das "+farbe+"e Tor sieht sehr stabil aus.\n",
       D_GENDER, NEUTER,
       D_SHORT, "Ein "+farbe+"es %ses Tor.\n",
       D_NAME, ""+farbe+"es Tor",
       } ));

  ACD(({"lege","leg","press","presse","drueck","druecke","mach",
        "mache"}), "get");


}

int get(string str)   {
  object ob;
  NF("Was willst Du auf den Abdruck legen?!\n");
  if(member(({"hand auf abdruck","hand in abdruck"}), str)!=-1)  {

    if(present("zombie", TO)) {
      write(BS(
            "Der Zombie sagt: Sicher nicht, Du Kretin!"));
      return 1; 
    }

    if(present("mutant", TO))  {
      write(BS(
            "Der Monsternekrophile sagt: WAEWHHH! Hau bloss ab!!!"));
      return 1; 
    }



    if(!da)  {
      write(BS(
            "Du legst Deine Hand auf den Abdruck. Leider passiert nichts! "
            "Komm spaeter wieder!"));
      say(BS(
            CAP_TPN+" legt seine Hand auf die Kugel!"));
      return 1; 
    }
    if(da) {

      say(BS(
            CAP_TPN+" legt seine Hand auf die Kugel!"));
      write(BS(
            "Du legst Deine Hand auf den Abdruck und ploetzlich surrt die "
            "Kugel. Der Abdruck glueht auf und dann hast Du etwas in der Hand!"));

      ob=clone_object("/d/wasser/dante/zinsel/obj/zvheal");
      ob->move(TP, M_GET);
      da--;
      return 1; 
    }
    return 0; 
  }
  return 0; 
}

