//dante sl 99

inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"

int da=1;
int z=2;

reset()  {
  ::reset();
  z=2;
  da=1;  }



void create()
{
  ::create();


  SSH("Ein kleiner Pfad auf einer kleinen Insel mit Baum");
  SLO(BS(
        "Du bist nun am noerdlichsten Ende der Insel angekommen, und fragst Dich, "
        "ob das wirklich alles sein kann. Diese Insel, so oede sie auch scheinen "
        "mag, verbirgt doch sicher Irgendetwas. Vor Dir liegt im "
        "Norden das weite Meer und hinter Dir im Sueden die kleine Insel. "
        "Direkt am Wasser steht eine kleine Strandvilla. Ein Grabstein, der "
        "umgefallen im Sand liegt, muntert Dich auch nicht besonders auf."));

  AD("sand",
      "Der Sand ist weich und weiss. Aja, heiss ist er auch.");
  AD("insel",
      "Die Insel erstreckt sich hier nur mehr nach Sueden. Dort liegt auch "
      "der grosse Baum und noch weiter suedlich der Steg.");
  AD("steg",
      "Von da bist du hier hergekommen.");

  SP(P_KILL_NAME, "Die boese Macht der Zombieinsel");

  AD("sommer",
      "Hier ist es immer Sommer.");
  AD("erholung",
      "Erholung hast Du hier sicher notwendig!");

  AD("stein",
      "Der Grabstein besteht aus Marmor.");
  AD("marmor",
      "Schwarzer, polierter Marmor.");
  AD("grabstein",
      "Er ist umgefallen und liegt nun im Sand. Du kannst eine "
      "Inschrift aber trotzdem erkennen. Hier war wohl frueher einmal ein Grab!");
  AD("grab",
      "Hier war frueher wirklich einmal ein Grab. Doch das ist lange "
      "schon verfallen. Doch man koennte doch hier im Sand graben...");
  AD("inschrift", "Lies sie!");

  ARD("inschrift",
      "Hier ruhen die Seelen all derer die dem unseligen Zombievirus\n"
      "zum Opfer fielen. Friede und Gnade all denen die nun fuer immer\n"
      "als Untote das Land bevoelkern und Schrecken und Furcht verbreiten!");


  ASD(({"seele","seelen","opfer","friede","gnade","land","untote",
        "furcht","schrecken","zombievirus","virus","zombie"}),
      "text");

  AD("himmel",
      "Der Himmel ist hier unendlich weit und herrlich blau.");

  AD("baum",
      "Der grosse, vertrocknete Baum ist natuerlich auch hier zu sehen. "
      "Ein Ast faellt Dir auf.");
  AD("ast",
      "Der Ast steht rechwinklig vom Baum weg. Ein Seil haengt daran.");
  AD("seil",
      "Das Seil baumelt im Wind. Es ist zu einer Schlinge geknuepft.");
  AD("wind",
      "Der blaest hier recht kuehl vom Norden herab.");
  AD(({"schlinge", "groesse"}),
      "Die Schlinge hat gerade die richtige Groesse fuer Deinen Kopf.");
  AD("kopf",
      "Steck doch den Kopf einfach in die Schlinge!");

  AD("boden",
      "Der Boden besteht aus Sand. Interessant ist hier aber weniger der Sand, "
      "sondern der umgefallenen Grabstein, der darin liegt.");

  AD("sueden",
      "Suedlich von hier erstreckt sich die kleine Insel.");
  AD("norden",
      "Im Norden liegt das unendliche, weite Meer. Und ganz weit im Norden "
      "liegt irgendwo Midas.");
  AD("midas",
      "Vielleicht kann man ja von irgendwo hier auf der Insel sogar "
      "bis nach Midas sehen.");

  AD("ende",
      "Die Insel endet hier und versinkt im tiefen Meer.");
  AD("meer",
      "Das Meer scheint hier recht wild zu sein. Das Wasser sprudelt und "
      "tost um vieles staerker als im Sueden.");
  AD("wasser",
      "Das Wasser rauscht hier schnell an der Insel vorbei. Schwimmen sollte man "
      "hier besser unterlassen.");
  AD( ({"villa", "strandvilla", "haus", "strandhaus"}),
      "Diese kleine Villa sieht aus, als wenn sie jemandem im Sommer zur "
      "Erholung dient. Vielleicht kann man sie ja betreten?"); 




  AddDetail( ({"irgendetwas", "was" }),
      break_string( "Das sollst Du eben rausfinden.", 78 ) );



  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]));
  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht sanft an der kleinen Insel vorbei!");
  AddSound("meer",
      "Es fliesst hier nicht allzu schnell vorbei.");


  AIT("/d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT);


  AIT("/d/dschungel/dante/weg/npc/dgeier", REFRESH_DESTRUCT);




  ACD(({"steck","stecke"}), "put");
  ACD(({"grab","grabe"}), "graben");
  AddCmd (({"schwimme", "schwimm"}), "nix");
  AddCmd(({"betrete", "betritt"}), "eintreten");
  AddExit("suedwesten", "./isle_05");
  AddExit("suedosten", "./isle_03");
}

int eintreten(string str)
{
  notify_fail("Was moechtest Du betreten?\n");
  if(!str) return 0;
  if(str!="haus" && str!="villa" && str!="strandvilla") return 0;  
  write("Du oeffnest die Tuer und betrittst die kleine Strandvilla.\n");
  TP->move("/d/wasser/buzzom/strandhaus/room/flur.lpc", M_GO, "die Strandvilla", 
      "betritt",
      "kommt herein");
  return 1;
}



int graben(string str)  {
  object ob;

  NF("Wo willst Du graben? Im Sand?! syntax<grabe sand>\n");

  if( member(({"sand","boden","grab"}), str)!=-1)  {

    write(BS(
          "Du graebst mit blossen Haenden im Sand."));
    say(BS(
          CAP_TPN+" grabt mit blossen Haenden im Sand."));  

    if(!z)   {
      write(BS("Du graebst und graebst, doch der Sand rutscht "
            "immer wieder in das Loch. Du gibst auf."));
      say(BS(
            CAP_TPN+" gibt das Graben auf."));  
      return 1; 
    }

    if(z)   {
      write(BS("Ploetzlich greifen zwei verfaulte Arme aus dem Loch "
            "herauf und erfassen Dich!!! WAHHH!!! Ein Zombie!!!"));
      say(BS(
            "Ploetzlich klettert ein Zombie aus dem Grab hervor!"));
      ob=clone_object("/d/wasser/dante/zinsel/npc/zo1");
      ob->move(environment(TP), M_GO+M_SILENT);
      ob->Kill(TP);
      z--;
      return 1;   
    }
    return 0; 
  }
  return 0; 
}


int put(string str)  {
  object ob;
  NF("Was willst Du in die Schlinge stecken!?\n");
  if(member(({"kopf in schlinge","kopf in schlinge rein",
          "kopf in schlinge hinein"}),str) !=-1)  {

    write(BS(
          "Du steckst Deinen Kopf in die Schlinge!"));
    say(BS(
          CAP_TPN+" steckt seinen Kopf in eine Schlinge!"));

    if(!da)   {
      write(BS(
            "Irgendjemand zieht im Inneren des Baumes an dem Seil! Die Schlinge "
            "zieht sich zu und wuergt Dich!! AH!! Du ziehst Deinen Kopf gerade "
            "noch heraus! Glueck gehabt!"));
      TP->do_damage(10);	
      say(BS(
            CAP_TPN+" jappst nach Luft! Die Schlinge wuergt "+TP->QueryPronoun(WEN)+"!"));
      return 1; 
    }
    if(da)  {
      ob=clone_object("d/wasser/dante/zinsel/obj/hebel");
      ob->move(TP, M_GET);
      write(BS(
            "Am Seil war ein Hebel angebunden, den Du erst nun entdeckst! Freudig "
            "nimmst Du ihn an Dich!"));
      say(BS(
            CAP_TPN+" freut sich auf einmal!"));
      da--;  
      return 1;  
    }
    return 0; 
  }
  return 0; 
}


string text()  {

  write(
      "Eine verfluchte Seele taucht aus dem Meer auf und laechelt freundlich!\n");

  write (BSA(
        "Sei gegruesst "+TPN+"! Hoere gut zu und merke Dir meine Worte! "
        "Diese Insel ist verflucht und wird von Zombies bewacht. Sie hausen "
        "in den Tiefen unter der Insel und huldigen einen boesen Kult! "
        "Ein grosser Zombiedrache fuehrt sie an und er befehligt seine "
        "Scharen voller Brutalitaet! Es gibt derer 3 Arten von Zombies. "
        "Ehemalige Spieler die mutiert sind, Monster die sich dem "
        "Bann nicht entziehen konnten und boesartige Kreaturen des "
        "Silberlandes, die hier ihr untotes Gegenstueck haben. Sie "
        "alle dienen 4 verfluchten Goetzen, die ihre Kultstaette auf "
        "4 verschiedenen Insel haben. Sie haben die Macht und wer sie "
        "bricht soll der Sage nach reichlich belohnt werden!!! Solltest "
        "Du jemals eine der 4 Altaere finden, so murmle die richtigen "
        "Worte!!! Merke sie Dir gut, den davon haengt Dein Erfolg ab "
        "!!! Viel Glueck, "+TPN+"!",
        "Die Seele sagt: "));

  write(BS(
        "Dann winkt die Seele und verschwindet klagend wieder im Meer!"));	
  return ""; 
}




int nix(string str)  {
  NF("Wo willst Du schwimmen?!\n");
  if(member(({"im meer","im wasser","in wasser","in meer",
          "raus","hinaus"}),str)!=-1)  {

    switch(random(3))  {
      case 0:
        write(BS(
              "Das Wasser ist hier voller Haie! Lass es lieber!"));
        say(BS(
              CAP_TPN+" hat Angst vor Haien!")); 
        break;	
      case 1:
        write(BS(
              "Du steckst einen Zeh ins Wasser!!! IHH!!! Das Meer ist hier scheinbar "
              "doch recht kalt. Nein! Hier willst Du nicht schwimmen!"));
        say(BSA(
              "Nein! Das Wasser ist mir zu kalt! Hier schwimme ich sicher "
              "nicht!", ""+CAP_TPN+" teilt Dir mit: "));
        break;
      case 2:
        write(BS(
              "Die Stroemung scheint irgendwie gefaehrlich zu sein! Lass es!"));
        say(BS(
              CAP_TPN+" will hier nicht schwimmen!"));
        break;
      default:write("\n");
    }
    return 1; 
  }

  return 0; 
}

