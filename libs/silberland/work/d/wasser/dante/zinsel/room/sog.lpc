/*
schwimm raum fuer inzels
dante sl 99
*/




inherit "std/room";
#include <moving.h>
#include <player.h>
#include <combat.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"

#define TIME 60//zum testen kann mans ja herabsetzen



object cash;
object ele;
object g;	
	

void create()
{
  ::create();

  
  SSH("Im Sog des Todes");

  SLO(BS(
  "Du bist nun mitten in einem wilden Sog, irgendwo, mitten im "
  "Meer. Das Wasser sprudelt um Dich herum. Sehen kannst Du nicht viel, "
  "nur etwas solltest Du wissen, irgendwann geht Dir garantiert "
  "die Luft aus! Also eile!!!"));


AddId("NOTAKEJOJO");

cash=clone_object("obj/money");
cash->SetProp(P_AMOUNT, 500000+random(50000));
cash->move(TO, M_GO);
ele=present("elementar", TO);
g=present("jojogeist", TO); 
 SetProp(P_NO_TPORT, NO_TPORT_OUT);
  
 AD("himmel",
 "Der hilft Dir hier sicher nicht.");
 AD("wasser",
 "Das Wasser sprudelt wild um Dich herum!");
 AD("boden",
 "Siehst Du nicht.");
 AD("sog",
 "Du bist mitten drin im Sog.");
 AD(({"wand","waende"}),
 "Gibt es hier auch nicht.");
 AD("luft",
 "Sie wird immer weniger. Aber wie waers mit auftauchen?!?!");
  
 SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_UNDERWATER]));
  AddSmell( DEFAULT_SMELL,
"Unter Wasser riechst Du nichts.");
  AddSound(DEFAULT_SOUND,
  "Das Meer rauscht und gluckst hier extrem laut.");
  AddSound("meer",
  "Es rauscht hier EXTREM laut.");
  
 AddRoomMessage(({
 	"Du wirst wild im Wasser herumgewirbelt.\n",
 	"Das Wasser drueckt Dich nach unten.\n",
 	"Der Sog scheint immer staerker zu werden.\n",
 	"Das Meer tobt und bruellt hier.\n",
 	"Waerst Du nur nicht so gierig gewesen...\n",
 	"Dein Ende wird ein Nasses sein!\n",
 	"Der Sog schleudert Dich wild umher.\n"}),15);
 	 
  
  AddCmd (({"schwimme", "schwimm"}), "swim");

ACD(({"tauch","tauche"}), "down");

SP(P_KILL_NAME, "Ein teuflischer Unterwassersog");
SP(P_KILL_MSG, "BLUBB!!! BLUBBB!!");

ACD("", "log_it", 1); 
}

log_it(str) {
	if(!TP) return;
	if(!str) str="";
	
   write_file("/d/wasser/dante/zinsel/log/soglog",
    ctime()+": "+CAP(getuid(TP))+" verb:"+query_verb()+" str:"+str+" \n");
 } 

init() {
	object bo;
	::init();
	
if(!interactive(TP) )  {
	TP->move("/d/wasser/dante/zinsel/room/oswim", M_NOCHECK+M_GO,
	"nach oben", "taucht", "kommt heraufgetaucht"); }
	
	
if(interactive(TP))  { call_out("a1", 6); 

bo=deep_present("geldboerse", TP);

if(bo)  {
	bo->move("/d/wasser/dante/zinsel/room/oswim", M_NOCHECK);
 tell_room(TO,
 "Eine Geldboerse wird auf einmal vom Sog nach oben gerissen!\n");
 tell_room("/d/wasser/dante/zinsel/room/oswim",
 "Eine Geldboerse taucht auf einmal aus den Tiefen auf.\n");

 }  
}
	if(ele)  {
		ele->die();
	 }
	if(g)  { g->die(); }
	
	}


a1()  {


 if(environment(TP)!=TO || !TP) return 0;
 
 write(BS(
"Deine Luft haelt noch 5 Minuten!"));
call_out("a2", TIME);
if(g)  { g->die(); }

}

	
a2()  {
 if(environment(TP)!=TO || !TP) return 0;
	write(BS(
"Deine Luft haelt noch 4 Minuten!")); 
	call_out("a3", TIME);	
	if(ele)  {
		ele->die();
	 } 
	 if(g)  { g->die(); }
	 }

	a3()  {
 if(environment(TP)!=TO || !TP) return 0;
 	write(BS(
"Deine Luft haelt noch 3 Minuten!")); 
	call_out("a4", TIME);if(g)  { g->die(); }	 
	if(ele)  {
		ele->die();
	 }}

a4()  {

 if(environment(TP)!=TO || !TP) return 0;
	write(BS(
"Deine Luft haelt noch 2 Minuten!")); 
	call_out("a5", TIME);if(g)  { g->die(); }
	if(ele)  {
		ele->die();
	 }	 }


	
a5()  {

 if(environment(TP)!=TO || !TP) return 0;
	write(BS(
	"NOCH 1 MINUTE!!!"));if(g)  { g->die(); }
	call_out("end", TIME);	 if(ele)  {
		ele->die();
	 }}




		
end()  {
	 if(environment(TP)!=TO || !TP) return 0;
	write(BS(
"Du ersaeufst jaemmerlich!"));if(g)  { g->die(); }
TP->die();
if(ele)  {
		ele->die();
	 } 
  }
	
	
	
	
	
	
int down(string str)  {
	object ob, b;
	ob=deep_present("muenzen", TP);
        b=deep_present("geldboerse", TP);
        
NF(BS(
"Du tauchst verzweifelt umher, doch der Sog laesst Dich nicht los!"));

if(ob || b)  {
	write(BS("Du willst nach oben tauchen um Dein mieses Leben "
	"zu retten, doch irgendetwas haelt Dich zurueck! Aus Gier nach "
	"dem Gold und dem Geld das hier lagert bist Du heruntergetaucht, "
	"sollte es Dein Schicksal werden?!?!?"));
return 1; }



if(!ob && !b)  {
	write(BS(
"Du verzichtest auf Geld und Gold und kannst so guten Gewissens "
"wieder auftauchen!!!"));

TPM("/d/wasser/dante/zinsel/room/oswim", M_GO, "nach oben",
"taucht", "kommt heraufgetaucht");
 
  
    


return 1; }
return 0; }
		




swim(string str )
 {
NF(BS(
"Du schwimmst verzweifelt herum, doch der Sog scheint Dich hier festzuhalten!"));

    }
    