//dante dreck!!! sl 97-99

inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"


create()
{
  ::create();

  SSH("Auf einer kleinen Insel mit Baum");
  SLO(BS(
        "Du befindest Dich hier auf dem suedlichsten Teil einer "
        "kleinen Insel, in deren Mitte ein riesengrosser Baum steht."
        " Ausserdem siehst Du noch einen schmalen Pfad, der um den Baum"
        " herumfuehrt. Ansonsten ist die Insel bis auf trockene "
        "Straeucher und Buesche kahl und leer. Im Sueden "
        "kommst Du wieder zurueck auf den schmalen Steg. ")+
        "Eine Tafel.");


  AD("tireks",
      "Mein Liebling!");
  AD("liebling",
      "Tireks!");
  AD("himmel",
      "Die Sonne strahlt vom wolkenlosen Himmel herab.");

  AD("baum",
      "Du wunderst Dich darueber, dass ein so grosser, uralter Baum auf "
      "einer so kleinen Insel leben kann. Seine Rinde ist total "
      "verdorrt und trocken und die Baumkrone traegt keine Blaetter mehr.");

  AD(({"blatt","blaetter"}),
      "Zumindest hier sieht man sicher keine.");
  AD("zeit",
      "Tick, tick,...");
  AD("rinde",
      "Die Rinde ist steinhart. Man sieht kleine, feine Linien.");
  AD(({"linie","linien"}),
      "Die Linien sollen wohl Buchstaben sein, die "
      "irgendjemand vor langer Zeit einmal hier "
      "eingeritzt hat.");

  AD(({"buchstaben","buchstabe"}),
      "Dante + Tireks fuer immer in ewiger Liebe!!!\n"
      "Du denkst . o O 'Diese Magier sind auch perverse Schweine!!!'\n");
  AD("liebe",
      "Ist das was zum essen?!");

  AD("magier",
      "........");
  AD(({"schwein","schweine"}),
      "OINNNNNNNNKKKK!!!!");
  AD("tafel",
      "Lies sie!");

  ARD("tafel",
      "Du versuchst die Tafel zu entziffern:\n\n"
      "Lieber Leidensgenosse!\n"
      "Wenn Du diese Insel erreicht hast, musst Du von sehr weit gekommen sein.\n"
      "Doch hoere auf mich, auch wenn Dein Weg beschwerlich war!\n"
      "Hier erwarten Dich nur Schrecken und der Tod! Mir selbst ging\n"
      "es lange Zeit so schlecht, das ich nun tief unten, unter der\n"
      "Insel lebe und mein Zuhause niemals verlasse. Zu entstellt hat\n"
      "mich diese verfluchte Krankheit um mich jemals wieder unter die\n"
      "Sterblichen zu wagen. Solltest Du jemals bis zu mir vordringen\n"
      "und Dich gegen diese verfluchten Zombies behaupten, \n"
      "so werde ich Dich sicherlich staerken und bewirten!\n"
      "Doch hoere lieber auf mich und kehre um solange Du noch kannst!!!\n"
      "Neuerdings haben sich auch Die Zombiejaeger hier angesiedelt und\n"
      "eine Zentrale gebaut. Sie haben dem Boesen einen Kampf auf Leben\n"
      "Und Tod angesagt!!! Auch sie werden Dir sicher helfen!\n"
      "                                     gezeichnet\n"
      "                                               Zerfallos Zombioid\n");


  AD(({"krone","baumkrone"}),
      "Auch sie ist voellig verdorrt. HE! Sieht man da nicht etwas "
      "Merkwuerdiges!!!");
  AD("merkwuerdiges",
      "Du kannst Dich auch getaeuscht haben, aber kurz war da "
      "etwas Schreckliches zu sehen...");
  ASD("schreckliches", "show");

  AD("teil",
      "Dieser Teil der Insel ist sehr karg.");
  AD("mitte",
      "Genau in der Mitte der Insel steht ein grosser, uralter Baum.");
  AD("pfad",
      "Irgendjemand ist wohl sehr oft um den Baum gelaufen und so "
      "ist um die Insel herum ein sehr kleiner Pfad entstanden.");
  AD("sueden",
      "Im Sueden liegt der kleine, schmale Steg.");
  AD("steg",
      "Der Steg liegt suedlich von hier.");


  AD("insel",
      "Die Insel scheint nicht allzu gross zu sein. Sie erstreckt sich "
      "von hier noch etwas nach Norden, um dann wieder im gruenen Meer "
      "zu verschwinden. Hauptsaechlich besteht sie aus Sand, auf dem "
      "einige karge Buesche und Straeucher vegetieren.");

  AD(({"busch","buesche"}),
      "Die Buesche sind sehr karg, voellig blattlos.");
  AD(({"strauch","straeucher"}),
      "Die trockenen Straeucher wuerden sicher mehr Wasser benoetigen. "
      "Manche davon haben spitze Dornen.");
  AD(({"dorne","dornen"}),
      "Die Dornen koennen Dir sicher gefaehrlich werden...");
  AD("boden",
      "Der Boden besteht hier aus weissem Sand.");
  AD("sand",
      "Der Sand ist weich und sehr warm. Teilweise ist er durch "
      "den Wind zu kleinen Duenen aufgehaeuft.");
  AD("wind",
      "Manchmal blaest hier ein starker Wind vom Norden kommend.");
  AD(({"duene","duenen"}),
      "Die Duenen sind lustig anzusehen. He, da schaut ein Stachel hervor!!!");
  ASD("stachel", "gift");



  AD("norden",
      "Irgendwo nicht weit von hier endet dort die Insel.");
  AD("meer",
      "Das Meer hat hier eine wunderschoene, gruene Farbe. Das "
      "Wasser scheint frisch und kuehl zu sein. Vielleicht "
      "kann man ja irgendwo hier schwimmen.");
  AD("farbe",
      "Hier ist es gruen.");
  AD("wasser",
      "Das Wasser leuchtet und schimmert in der Sonne. Ein herrlicher "
      "Anblick.");
  AD("sonne",
      "Die Sonne leuchtet hell vom Himmel herab. Keine Wolke ist "
      "hier zu sehen.");
  AD("wolke",
      "Hier ist keine.");
  AD("anblick",
      "Die Insel wirkt so angenehm, hoffentlich bleibt das so...");



  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]));
  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht sanft an der kleinen Insel vorbei!");
  AddSound("meer",
      "Es fliesst hier nicht allzu schnell vorbei.");



  AIT("/d/wasser/dante/zinsel/npc/aus", REFRESH_DESTRUCT);
  AIT("/d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT);


  ACD(({"schwimm","schwimme"}), "nix");
  AddExit("nordosten", "./isle_02");
  AddExit("nordwesten", "./isle_01");
  ASE("sueden", "steg");
}

int steg()  {
  return TPM("/d/wasser/dante/zinsel/room/steg1", M_GO,
      "den Steg im Sueden", "betritt", "kommt aus dem Norden auf den Steg");
}


int nix(string str)  {
  NF("Wo willst Du schwimmen?!\n");
  if(member(({"im meer","im wasser","in wasser","in meer",
          "raus","hinaus"}),str)!=-1)  {

    switch(random(3))  {
      case 0:
        write(BS(
              "Das Wasser ist hier voller Haie! Lass es lieber!"));
        say(BS(
              CAP_TPN+" hat Angst vor Haien!")); 
        break;	
      case 1:
        write(BS(
              "Du steckst einen Zeh ins Wasser!!! IHH!!! Das Meer ist hier scheinbar "
              "doch recht kalt. Nein! Hier willst Du nicht schwimmen!"));
        say(BSA(
              "Nein! Das Wasser ist mir zu kalt! Hier schwimme ich sicher "
              "nicht!", ""+CAP_TPN+" teilt Dir mit: "));
        break;
      case 2:
        write(BS(
              "Die Stroemung scheint irgendwie gefaehrlich zu sein! Lass es!"));
        say(BS(
              CAP_TPN+" will hier nicht schwimmen!"));
        break;
      default:write("\n");
    }
    return 1; 
  }

  return 0; 
}


string gift()  {
  return BS(
      "AUAAA!!! Es war der Stachel eines toten Skorpions!"
      " So ein Pech,"
      ""+(TP->QueryProp(P_GENDER)== MALE ? " lieber": " liebe")+" "+TPN+"!");

  TP->AddPoison(1);
}

string show()  {
  return BS(
      "Ach, es war nur eine Luftspiegelung und Du hast das "
      "eklige Pickelgesicht von "+TPN+" gesehen!!! HE!!! Das bist ja Du selbst!!!");	
}
