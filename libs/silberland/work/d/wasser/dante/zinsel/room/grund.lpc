/*
   schwimm raum fuer inzels
   dante sl 99
   */




inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"

#define TIME 300//zum testen kann mans ja herabsetzen



object cash;
int da=1;

void reset()   {
  ::reset();  
  da=1; 
}


void create()
{
  ::create();


  SSH("Unter Wasser");

  SP(P_KILL_NAME, "Die Macht der Zombieinsel");

  SLO(BS(
        "Du tauchst nun in einer bizaren Unterwasserwelt umher. "
        "Seltsame Pflanzen wuchern ueberall. Korallen leuchten "
        "in hellen Farbtoenen, ein Paradies. Das Licht faellt von "
        "oben herab und taucht alles in wunderschoenen Farben."));

  AD(({"koralle","korallen"}),
      "Sie wachsen hier schon seit ewig und geben dieser Wasserwelt "
      "ein magisches Aussehen.");
  AD("aussehen",
      "Sie wirken bizarr und freundlich zu gleich.");

  AD(({"pflanzen", "pflanze"}),
      "Die Pflanzen wogen sanft im Wasser hin und her. Sie sehen sehr "
      "seltsam aus. Du entdeckst eine Moraene und einen dunklen "
      "Fleck am Grund.");
  ASD("moraene", "aua");

  AD("fleck",
      "Der Fleck ist eine im Grund fast versunkene Kiste.");
  AD("kiste",
      "Die Kiste ist halb offen. Man kann fast hineinsehen. AH! "
      "Da ist ein helles Leuchten in ihr!!!");

  AD("leuchten",
      "Du solltest doch einfach in die Kiste reingreifen?! Koennte gut "
      "gehen, koennte aber auch weh tun...");
  AD(({"farben","farbe","farbtoene"}),
      "Jede nur erdenkliche Farbe ist hier zu bewundern. Sie aufzuzaehlen "
      "wuerde den Speicher ueberfordern.");
  AD("speicher",
      "Speicher, Computer, Internet?! Existiert doch alles nicht! "
      "Das hier ist die wahre Realitaet!");
  AD("realitaet",
      "Hier ist sie!");
  AD(({"computer","internet"}),
      "Gibt es gar nicht, glaub mir.");


  AD("meer",
      "Hier zeigt sich das Meer von seiner schoensten Seite.");
  AD("seite",
      "Einfach ueberwaeltigend.");
  AD("licht",
      "Licht fliesst direkt vom Himmel hier her herab.");
  AD("paradies",
      "Ach, waer es nur ueberall so schoen wie hier.");


  AD(({"unterwasserwelt","welt","wasserwelt"}),
      "Herrlich leuchten die Korallen, die Pflanzen wogen sanft "
      "in der milden Stroemung. Ein herrlicher Anblick.");

  AD("anblick",
      "Du willst fuer immer hier bleiben.");
  AD("stroemung",
      "Die Stroemung ist hier sehr mild.");
  AD("wasser",
      "Das Wasser ist hier warm und sehr ruhig. Ab und zu spruddelt "
      "eine Blase vom Boden herauf.");
  AD("blase",
      "BLUBBB.");
  AD("boden",
      "Der Boden ist hier der Grund des Meeres.");
  AD("grund",
      "Der Grund ist ueberwachsen mit vielen, eigenartigen Pflanzen.");



  AIT("d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);






  AD("himmel",
      "Den Himmel sieht man nicht von hier aus.");


  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_UNDERWATER]));
  AddSmell( DEFAULT_SMELL,
      "Unter Wasser riechst Du nichts.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht und gluckst.");
  AddSound("meer",
      "Es rauscht laut.");


  AddCmd (({"schwimme", "schwimm"}), "swim");

  ACD(({"tauch","tauche"}), "down");

  ACD(({"greif","greife"}), "get");

}

int get(string str)  {
  object ob;
  NF("Wo willst Du reingreifen!?\n");
  if(member(({"in kiste", "rein in kiste", "in leuchten", "hinein in kiste"}), str)!=-1)  {
    write(BS(
          "Du greifst in die Kiste hinein!"));
    say(BS(
          CAP_TPN+" greift in eine Kiste!"));
    if(!da)   {
      write(BS("Du greifst in die Kiste, doch das Leuchten weicht "
            "Dir irgendwie aus. Seltsam."));
      return 1; 
    }	

    if(da)   {
      write(BS(
            "Du greifst in die seltsame Kiste und das Leuchten fliesst "
            "genau in Deine Haende. WOW!!! Was Du wohl gefunden hast?!"));
      ob=clone_object("/d/wasser/dante/zinsel/obj/okey");
      ob->move(TP, M_GET);
      da=0;
      return 1; 
    }
    return 0; 
  }
  return 0;
}




string aua()  {
  write(BS(
        "Die Moraene schnellt vor und beisst Dich! AUA!!! Dann "
        "zieht sie sich schnell wieder zurueck."));
  TP->do_damage(5+random(5));
  return ""; 
}

void init() {
  ::init();
  if(interactive(TP))  { call_out("a1", TIME);  }  
}



a1()  {
  if(environment(TP)!=TO)  { return;}
  write(BS(
        "Deine Luft geht aus und Du tauchst nach oben zurueck."));
  TPM("d/wasser/dante/zinsel/room/swim3", M_GO,
      "nach oben", "taucht", "kommt von unten angetaucht");
}



int down(string str)  {
  NF(BS(
        "Du tauchst umher, fein fuer Dich."));

  if(member(({
          "rauf","nach oben","auf","zu oberflaeche"}), str)!=-1)  {
    write(BS(
          "Du tauchst wieder nach oben zurueck."));

    TPM("/d/wasser/dante/zinsel/room/swim3", M_GO, "nach oben",
        "taucht", "kommt heraufgetaucht");
    return 1; 
  }
  return 0; 
}



swim(string str )
{
  NF(BS(
        "Du schwimmst ein bisschen unter Wasser umher."));    
}


