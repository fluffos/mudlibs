// copy von dantes workroom
//dante sl 99-98-97 was was i

inherit "std/room";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"

void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Dantes Inferno" );
  SetProp( P_INT_LONG, 
      "Wo bist Du hier nur hingeraten? Dies ist das Inferno von Dante. "
      "Voellig verwirrt versuchst Du in dem trueben Licht Einzelheiten zu er"
      "kennen. "
      "Aengstlich tastest Du durch die neue fremde Welt und glaubst sich bewe"
      "gende Schatten auszumachen. Sind das etwa die gequaelten Seelen der Suender "
      "die ihr trauriges Dasein nach einem Leben voller Suende und Lasterhaftigkeit " 	 
      "hier buessen? Du faengst an Dein eigenes mieses kleines Leben zu ueberdenken "
      "und musst Dir eingestehn selbst den Versuchungen des Boesen allzu oft zu "
      "erliegen. Solltest Du Dich nicht aendern meldet sich eine Stimme in Deinem "
      "Kopf.....so willst Du doch nicht enden, oder? =:)\n"
      "Eine Tafel.\n");

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_INDOORS, 1 ); 


  AD("tafel",
      "Du kannst Dich auf dieser Tafel verewigen. Syntax zum beschreiben <stafel text>, "
      "zum lesen untersuche Inhalt.");
  ARD("tafel",
      "Nein, so nicht.");


  ASD("inhalt", "text_tafel");


  AD("form",
      "Schlange.");
  AD("fuehrer",
      "Vergil war Dantes Fuehrer.");

  AddDetail( ({"todsuende","todsuenden", "suenden", "suender", "suende" }), 
      "Es gibt 7 Todsuenden: Der Neid, die Gier, der Jaehzorn, die Eitelkeit, "
      "die Traegheit, die Wollust und die Unmaessigkeit!\n" );

  AD("dunkelheit",
      "Naja, Du kannst scheinbar etwas sehen.");
  AD(({"einzelheit","einzelheiten"}),
      "Nichts genaues kann man nicht erkennen.");
  AD("loechern",
      "Loch.");


  AD("sterblicher",
      "Na, so einer wie Du.");
  AD(({"schwefelschwaden","schwefelschwade"}),
      "Siehe unter Schwade.");

  AD(({"dieb","diebe","dieben"}),
      "He! Da klaut Dir einer irgendetwas...");


  AD("entfernung",
      "Nah oder fern...man weiss es nicht.");

  AD("dasein",
      "Ein langes, schreckliches Dasein.");
  AD("hunger",
      "Hunger fuer immer...");
  AD("busse",
      "Wirf alles weg!");

  AD("qual",
      "Du jaulst laut auf.");
  AD("schicht",
      "Dicker gelber Schwefel.");

  AD("gesang",
      "Naja, hoert man nicht.");
  AD("leid",
      "Gut so!");
  AD("diebstahl",
      "Ein Leben voller Suende!");
  AD("alkohol",
      "Den wollen wir aber schon, egal ob Suende oder nicht.");
  AD("promiskuitaet",
      "Darauf stehen wir hier.");

  AddDetail(({ "seelen" ,"seele"}),
      "Es sind die Seelen von Dieben, Moerdern, Kinderschaender, Betruegern...\n" );



  AD(({"moerder","moerdern","schaendern","kinderschaender","kinderschaendern",
        "betreuger","betruegern"}),
      "Eben alles Verbrecher.");
  AD("verbrecher",
      "Du kommst auch in das Inferno!");



  AddDetail( "schatten",
      "Die Schatten scheinen Dich bemerkt zu haben und flehen mit\n"
      "schmerzverzerrtem Gesicht, ja eher mit furchteinfloessenden\n"  
      "Fratzen um Vergebung! Doch Du kleiner Sterblicher kannst die\n"
      "Erloesung wohl kaum bringen, musst Du doch selbst um dein\n"    
      "armseliges Leben betteln.\n" ); 

  AD("gesicht",
      "Aengstlich schaust Du Dich um.");
  AD("beispiel",
      "Nur eines...");


  AddDetail( ({ "inferno", "welt" }),
      "Dies ist die Welt der gepeinigten Seelen, des Leidens und der Qual!\n" );

  AD(({"leiden","leidens"}),
      "Du leidest hier fuer immer!");
  AD(({"fratze","fratzen"}),
      "Eklige Fratzen...");

  AddDetail(  "leben" ,
      "Wer sein Leben vergeudet und dem Boesen widmet muss hier Busse tun!\n" );
  AddDetail( ({ "kopf", "stimme" }),
      "Du bist noch nicht voellig verloren Suender! Tue Busse und bessere Dich!\n" );

  AD(({"adam","eva", "apfel"}),
      "Na, da war doch das mit dem Apfel und der Schlange.");

  AD("erloesung",
      "Interessanter waere wie man hier wieder herauskommt.");
  AD("weib",
      "Und ewig lockt das Weib...");
  AD(({"neid","jaehzorn","zorn","eitelkeit","unmaessigkeit","traegheit",
        "gier","wollust","promiskuitaet"}),
      "Alles miese Suenden!");


  AD(({"kreis","kreise"}),
      "Es waren neun. Besser, Du liest selbst die 'Goettliche Komoedie'! von Dante.");
  AD(({"komoedie","goettliche"}),
      "Von Dante, nein nicht dem Dante hier...");

  AddDetail( "dante",
      "Dante durchschritt mit seinem Fuehrer Vergil die 9 Kreise der Hoelle...\n" ); 
  AddDetail( "Licht",

      "In dieser alles durchdringenden Dunkelheit kannst du nur schemenhaft\n" 
      "Schwefelschwaden an Dir vorbeiziehn sehn. Manchmal leuchtet in grosser\n" 
      "Entfernung ein Feuer kurz auf und was Du sehen musst, verschlaegt Dir\n" 
      "den Atem. Menschen muessen im ewigem Feuer unglaubliches Leid ertragen!\n" ); 
  AddDetail("feuer",
      "Kurz blitzen sie auf, und verschwinden so schnell wieder wie sie gekommen sind.");
  AddDetail( ({ "boese", "boesen" }),
      "Das Boese existiert auf dieser Welt seit dem Dusty und Woody oder waren es\n" 
      "doch Adam und Eva im Paradies der Versuchung durch den Satan in Form einer\n"
      "Schlange nicht widerstehn konnten und obwohl sie nicht Hunger litten einen\n"
      "verbotenen Apfel von Baum pflueckten und assen....\n" );
  AddDetail(({"dusty","woody"}),
      "Hmm, kennst Du die beiden etwa nicht...");
  AddDetail("vergil",
      "Vergil war Dantes Fuehrer durch die Hoelle.");
  AddDetail("hoelle",
      "Da bist Du gerade...");
  AddDetail("paradies",
      "Also paradiesisch ist es hier nicht.");
  AD("vergebung",
      "Nix da.");

  AddDetail("satan",
      "Satan ist gerade nicht hier, sei froh.");
  AddDetail("baum",
      "Der Baum und sein Apfel haben letztendlich uns alle aus dem Paradies vertrieben.");
  AddDetail("schlange",
      "Die Schlange war Satan bzw Satan war die Schlange..");             
  AddDetail( "lasterhaftigkeit" ,
      "Wein, Weib bzw. Mann und Gesang......eben genau das was wir alle lieben!\n" );
  AddDetail( "freiheit" ,
      "Ja die haettest Du wohl gerne wieder......\n" );

  AddDetail( ({ "versuchung", "versuchungen" }),
      "Alkohol,Promiskuitaet,Diebstahl,.....\n" );      

  AddDetail(({"wand","waende"}),

      "Die Waende sind kaum zu erkennen, denn die dicken "
      "Schwaden aus Schwefel machen es nicht moeglich weit zu sehen.");
  AddDetail("schwefel",
      "Ueberall am Boden steigt Schwefel aus tiefen, stinkenden Loechern");
  AddDetail(({"schwade","schwaden"}),
      "Gelb und schwarz schimmern die Schwefelschwaden und rauben Dir "
      "fast den Atem.");
  AddDetail(({"atem","atmen"}),
      "Das Atmen faellt Dir hier sehr schwer.");
  AddDetail(({"loch","loecher"}),
      "Der Boden ist uebersaeht mit Loechern, ja fast kleinen Vulkanen, aus denen "
      "dicker Schwefeldampf emporsteigt.");
  AddDetail("dampf",
      "Der Dampf laesst das Klima hier heiss und sehr schwuel sein.");
  AddDetail("klima",
      "Lebensfeindlich und bedrohlich.");
  AddDetail("schwefeldampf",
      "Gelb und stinkend macht er das sehen fast unmoeglich.");
  AddDetail("boden",
      "Der Boden ist mit einer stinkenden Schicht aus Schwefel ueberzogen. "
      "Aus Loechern steigt ein gelb, schwarzer Dampf empor.");
  AddDetail(({"vulkane","vulkan", "vulkanen"}),
      "Naja, so gross wie richtige Vulkane sind die Loecher in Boden nicht, "
      "aber trotzdem rauchen sie gewaltig. Eines davon ist so gross, das "
      "eine Person sicher hineinpassen wuerde...");
  AddDetail("person",
      "Vielleicht Du zum Beispiel.");
  AddDetail("decke",
      "Die Decke ist zu hoch oben, sehen kann man sie auf jeden Fall nicht.");
  AddDetail("fall",
      "In Deinem Fall kann man doch etwas an der Decke erkennen, naemlich"
      " eine Leiter.");
  AddDetail("leiter",
      "Die Leiter haengt einfach von der Decke herab und scheint nach oben "
      "ins Nichts zu fuehren.");
  AddDetail("nichts",
      "Genau, ins Nichts, und daher kann man diese Leiter auch nicht benutzen. "
      "Nicht jede Leiter hat einen Sinn.");
  AddDetail("sinn",
      "Was hat schon einen Sinn...");

  AddSmell( DEFAULT_SMELL,
      "Hier stinkt es gewaltig nach Schwefel.");
  AddSound(DEFAULT_SOUND,
      "Manchmal glaubst du verzweifelte Schreie zu hoeren.");

  AddSmell("schwefel",
      "Er stinkt gewaltig...");
  AddSound("schreie",
      "Da war schon wieder einer.");

  AddCmd(({"spring","springe"}), "out");

  AIT("d/wasser/dante/zinsel/npc/teufel", REFRESH_DESTRUCT);

  ACD("stafel", "schreiben_tafel");


}   


int schreiben_tafel(string str)  {
  NF("Was willst Du auf die Tafel schreibe?!\n");
  if(!str) return 0;

  write("Du schreibst etwas auf die Tafel. Ob es Sinn macht...\n");

  write_file("/d/wasser/dante/zinsel/obj/tafel.lpc",
      ""+ctime()+": Von "+CAP(getuid(PL))+": \n"+str+"\n");
  return 1; 
}


string text_tafel()  {
  write(
      "Willkommen "+CAP(getuid(PL))+" in Dantes Inferno!\n"
      "Bisher haben sich folgende Sterbliche hier verewigt:\n\n");

  TP->More(read_file("/d/wasser/dante/zinsel/obj/tafel.lpc"));   
  return "";
}



int out(string str)
{
  notify_fail("Wo willst Du hinein springen?\n"); 
  if (!str) return 0;

  if (member(({"in vulkan", "in vulkan rein", "in vulkan hinein", "vulkan"}),str) !=-1)
  {
    write(BS(
          "Du nimmst allen Mut zusammen und stuerzt Dich todesverachtend "
          "in den groessten der Vulkane am Boden."));
    TP->move("/d/wasser/dante/zinsel/room/isle_03", M_GO,
        "sich todesverachtend in einen Vulkan", "stuerzt",
        "faehrt ploetzlich nach schwefelstinkend vor Deinen Augen aus dem Boden");
    return 1;
  }
  return 0;
}

