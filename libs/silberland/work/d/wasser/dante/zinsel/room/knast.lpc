gift()  {
  int i, u;
  object *inv;
  string *text;
  string was;
  text=({
      "Die giftigen Daempfe machen Dir ziemlich zu schaffen.\n",
      "Dir wird sehr uebel.\n",
      "Ein sehr ungesunder Ort.\n",
      "Du bist ein echt dummer Spieler...\n",
      "Wie kommt man hier nur heraus?\n",
      "Du uebergibst Dich.\n",
      "Du hast leichte Halluzinationen.\n",
      "Du taumelst umher.\n",
      "Der Schwefel beginnt Deine Lunge zu zerfressen.\n"});


  inv=filter_array(all_inventory(TO), #'interactive);
//  if(!sizeof(inv) )  { call_out("gift", TIME); }


  for(i=0; i<sizeof(inv);i++)  

  {
    u=random(sizeof(text));
    inv[i]->AddPoison(1+random(2));
    tell_object(inv[i],
        text[u]);

  }         
  call_out("gift", TIME);  }

