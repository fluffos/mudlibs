//dante sl 99



#include <moving.h>
inherit "std/room";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#define TIME 15+random(15)

create()
{
  ::create();

  SP(P_INT_SHORT, "In Nichts");
  SP(P_INT_LONG, BS(
        "Hier beginnt sich die normale Welt bereits aufzuloesen und mit dem Nichts "
        "zu vermischen. Undurchdringbarer Nebel und giftige Daempfe "
        "verperren Dir fast jegliche Sicht. Vom Boden steigen gelbe Schwefeldaempfe auf, "
        "die sich im Nirgendwo ueber Dir verlieren. Hier her kommen nur unvorsichtige und dumme Spieler. "));

  AD("spieler",
      "Solche wie Du eben.");
  AD("nichts",
      "");


  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AD("nirgendwo",
      "Was ober Dir ist, weisst Du nicht. Der Himmel sicher nicht.");
  AD("himmel",
      "Der kann Dir hier auch nicht mehr helfen.");
  AD("decke",
      "Nein."),
  AD(({"wand","waende"}),
      "Waende sind hier sicher keine. Trotzdem fuehrt ein Tor wieder zurueck in Deine Welt.");
  AD("tor",
      "Das Tor ist natuerlich nicht hier. So einfach ist das nicht.");
  AD("osten",
      "Im Osten kommst Du wieder zurueck.");

  AD("boden",
      "Der Boden ist wegen der Daempfe nicht zu erkennen. Du entdeckst trotzdem "
      "eine Leiche, die halbverfault am Boden liegt.");
  AD("leiche",
      "Die Leiche ist schon ziemlich verwest.  Sie starrt Dich aus toten Augen an.");
  AD(({"auge","augen"}),
      "Leer und verfault. Grausig. Du siehst etwas in der Pupille.");
  AD("pupille",
      "Es sieht wie ein Bild aus.");
  AD("bild",
      "Da steigt ein Spieler gerade auf die Schultern von einem Geist, und so kann "
      "der Spieler scheinbar fliehen. Hmmmm, was heisst das fuer Dich?!");
  AD("geist",
      "Es soll sich um einen sehr laestigen, frechen Geist handeln!!!!!!!!!!");
  AD(({"schulter","schultern"}),
      "Die Schultern des Geistes sind jojofoermig!!!");
  AD("jojo",
      "Tja, so koennte es gehen.");
  AD("jojogeist",
      "Genau der!!!");

  AD("nebel",
      "Der Nebel scheint hier zu leben, er tanzt um Dich herum und scheint Dich zu "
      "verhoehnen. Im Nordwesten scheint er sich etwas zu lichten.");
  AD("nordwesten",
      "Hier scheint es weiter zu gehen.");
  AD(({"dampf","daempfe"}),
      "Gruen und gelb umhuellen sie Dich und ab und zu glaubst Du eine "
      "Gestalt zu erkennen.");
  AD("gestalt",
      "Du hast Dich wohl geirrt.");
  AD("sicht",
      "Die Daempfe und der Nebel machen die Sicht sehr schwer...");
  AD(({"schwefel","schwefeldampf","schwefeldaempfe"}),
      "Die Schwefeldaempfe sind hochgiftig. Du solltest hier nicht allzu lange bleiben.");

  AD("welt",
      "Alles was Du bisher kanntest endet hier...");
  AD("alles",
      "Dein geliebtes Silberland endet hier ebenso wie Dein mickriges Leben.");
  ASD("leben", "show");
  AD("silberland",
      "Das Silberland loest sich hier auf um ins Nichts ueberzugehen.");
  AD("sterbliche",
      "Der Namenlose teilt Dir mit: Sterblicher, ich warte...");
  AD(({"untote","untoter"}),
      "Bald bist Du einer von ihnen...");
  SetProp(P_HIDE_EXITS, ({"nordwesten"}) );

  ASE("nordwesten", "gag1");

  AddExit("norden", "./knast");

  AddExit("westen", "./knast");
  AddExit("sueden", "./knast");
  AddExit("nordosten", "./knast");
  AddExit("suedosten", "./knast");
  AddExit("suedwesten", "./knast");
  AE("osten", "./knast");
  ASE("nordsueden", "gag");

  SP(P_KILL_NAME, "Dummheit und Schwefeldaempfe");

  ACD(({"steige","steig"}), "out");

  call_out("gift", TIME);

}


int out(string str)  {
  object ob;
  NF(BS("Worauf willst Du steigen?!"));

  ob=present("jojogeist", TO);

  if(member(({"auf schultern","auf schulter","auf jojogeist","auf geist",
          "auf schultern von geist","auf schultern von jojogeist"}), str)!=-1)  {
    if(!ob)  {
      write("Aber hier ist kein Jojogeist!\n");
      return 1; 
    }
    if(ob)  {
      write(BS(
            "Du steigst auf die Schultern vom Jojogeist, siehst eine Klappe, oeffnest "
            "sie und steigst aus dem Nichts heraus!!!"));
      write(BS(
            "Der Jojogeist bruellt: HE!!! "+TPN+" !! Du &%&%&/ Schwein!!!"));
      TPM("d/wasser/dante/zinsel/room/nw1", M_GO+M_NO_SHOW,
          "auf den Schultern des Jojogeistes nach oben", "steigt",
          "kommt mit Hilfe eines Geistes von unten herauf");
      ob->move("players/dante/workroom", M_TPORT);
      ob->remove();

      return 1; 
    }
    return 0;
  }
  return 0; 
}


int gag()
{
  write("Du versuchst gleichzeitig nach Norden und Sueden zu gehen.\n"
      "Du scheiterst knapp und es zerreisst Dich fast!!! AAAAAA!!!!!!!!!!\n");
  TP->do_damage(10+random(10));
  return 1;
}


int gag1()
{
  NF(BS(
        "So leicht geht das nicht. War wohl ein Witz!"));
}


string show()
{ 
  domainshout(CAP_TPN+" hat im Moment noch"+TP->QueryProp(P_HP)+" Lebenspunkte!\n");
  write("Du hast im Moment noch "+TP->QueryProp(P_HP)+" Lebenspunkte.\n"
      "Wenn Du sie behalten willst, kehre besser um.\n");
  return "";
}

