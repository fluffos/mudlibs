//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/gdet_inh.lpc"
string farbe;
string dir;


void create()
{
  ::create();

farbe="weiss";
dir="Nordosten";
gang_details();

  SetProp( P_INT_SHORT, "Unter der Zombieinsel" );
  SetProp( P_INT_LONG, BS(
"Der Saeulengang fuehrt von der unteren schwarzen Saeulenhalle weg Richtung "+dir+". "
"Unheimlich blicken Dich die Goetzen an. Die Waende sind hier aber "
"nicht aus schwarzem Marmor sondern aus "+farbe+"em Marmor. Fackeln, "
"die in stabilen Haltern an den Waenden angebracht sind, "
"werfen unheimliche Schatten an die Waende und Decke. Die "
"Schatten scheinen direkt um Dich herumzutanzen. Eine Leiter "
"fuehrt nach unten."));

AD("leiter",
"Hmm, die Leiter sieht extrem seltsam aus. Sie ist giftgruen "
"und hat ueberall spitze Dornen. Lass es lieber sein!!!");
AD(({"dorne","dornen"}),
"Sie sind vergiftet und sehr spitz!!!");

AD("farbe",
"Hier ist alles in "+farbe+"er Farbe gehalten.");
AD("marmor",
"Der Marmor ist hier "+farbe+". Er scheint uralt und steinhart zu "
"sein. Eine unheimliche Kaelte geht von ihm aus.");
AD(""+dir+"",
"Im "+dir+" geht der Gang weiter.");
AD("richtung",
"Der Saeulengang fuehrt weiter nach "+dir+"!");
//
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur Deinen eigenen, schnellen Atem.");
    
  AddSound( ({DEFAULT_SOUND, "atem"}),
    "Schnell, fast panisch.");

AddSmell(({DEFAULT_SMELL,
"Es riecht nach Zombies."}));
AddSmell(({"zombie","zombies"}),
"Zombies stinken extrem.");

AIT(ZN"zo1", REFRESH_DESTRUCT);
AIT(ZN"zo3", REFRESH_DESTRUCT);
AIT(ZN"zo2", REFRESH_DESTRUCT);
AE("suedwesten", "./no1");
AE("nordosten", "./no3");
ASE("unten", "gift");

SP(P_KILL_NAME, "Eine vergiftete Dornenleiter");

}

int gift()  {
  if (!TP) return 0; 
  TP->do_damage(10);
  if (!TP) return 0; 
  TP->AddPoison(1+random(2));
  write( BS(
        "Du willst an der Leiter nach unten klettern, doch die Dornen "
        "spiessen Dich fast auf! AHHHH!!!! Schnell laesst Du die Leiter "
        "wieder los!"));
  return 1;
}
