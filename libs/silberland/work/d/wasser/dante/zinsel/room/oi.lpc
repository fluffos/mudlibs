//dante inh fuer zinsel 99


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/d/wasser/dante/zinsel/room/i_inh.lpc"
#include <mnpc.h>

string col;
string dir;

int g=1;
string name="ratzhjifed";

void create()
{
  ::create();

  col="gelb";

  dir="westen";


  insel_details();


  SetProp( P_INT_SHORT, "Auf einer sehr kleinen Insel" );
  SetProp( P_INT_LONG, BS(
        "Du stehst nun hier auf einer kleinen Insel, die nur aus schroffen Fels besteht, "
        "mitten im weiten, grossen Meer. "
        "Rund um Dich tost die hier sehr starke Stroemung und ab und zu "
        "spritzen Wellen bis zu Dir herauf. "
        "In einiger Entfernung kannst Du im "+capitalize(dir)+" die groessere Insel sehen, "
        "von der Du durch die Saeulengaenge gekommen bist. Viel kann "
        "man hier nicht sehen. Eine grosse, hohle Saeule, in der "
        "der Aufzug manchmal anhaelt, das weite grosse Meer und einen "
        "seltsamen, "+col+"en Felsquader."));


  AD(({"quader","felsquader"}),
      "Der Felsquader besteht aus "+col+"en Marmor und strahlt eine "
      "unheimliche Aura aus. Komm ihm nicht zu nahe, denn eigentlich "
      "ist dieser Quader ein Altar! Teilweise ist "
      "er blutverschmiert. Du siehst eine kleine Inschrift!");

  AD("inschrift",
      "Lesen.");
  ARD("inschrift",
      "Murmle die Worte und ich komme!");
  AD(({"worte","wort"}),
      "Worte, gut, aber welche Worte.");

  AD(({"goetze", "goetzen"}),
      "Es gibt derer 4. Diese Kreatur ist der Goetze Ratzhjifed,"
      " der Herr des Todes.");
  AD("ratzhjifed",
      "Er ist der Herr des Todes! Huete Dich vor ihm!");
  AD(({"herr"}),
      "Er wacht ueber die Seelen der Untoten.");
  AD(({"seele","seelen","untoter","untote"}),
      "Viele, viele liesen ihre Seele schon hier.");
  AD("tod",
      "Er bringt und bewahrt ihn!");
  AD("aura",
      "Du fuehlst direkt den Tod, der scheinbar im Marmor haust.");
  AD("marmor",
      "Der Marmor strahlt eine unheimliche Kaelte aus. Er ist "+col+".");
  AD("kaelte",
      "Du zitterst, obwohl Du hier auf einer tropischen Insel bist.");



  AD(""+dir+"",
      "Dort liegt die groessere Insel. Du kannt ja vielleicht nach "
      ""+capitalize(dir)+" schwimmen.");





  AIT("/d/wasser/dante/zinsel/npc/stdbird", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS: MOV_INDOORS]));


  ACD(({"schwimm","schwimme"}), "swim");
  ACD(({"murmel","murmle"}), "come");
}

int come(string str)  {
  object ob;
  NF("Was willst du murmeln?!\n");

  if(!str)  {
    write(BS(
          "Murmeln ist was sehr nettes!"));
    return 1; 
  }

  if(str=="wort"||str=="worte")  {
    write(BS(
          "Du murmelst Worte, aber nichts passiert. So einfach scheint das nicht zu gehen."));
    say(BS(
          CAP_TPN+" murmelt irgendetwas..."));
    return 1; 
  }

  if(str==""+name+"")  {

    if(present("goetze", TO))  {
      write(BS(
            "Die Goetzen gibt es nur als Unikat!"));
      say(BS(CAP_TPN+" murmelt irgendetwas..."));	
      return 1; 
    }

    if(g==0)  {
      write(BS(
            "Du murmelst "+capitalize(name)+", der Altar bebt, doch sonst "
            "passiert nichts!"));
      say(BS (CAP_TPN+" murmelt irgendetwas..."));
      return 1; 
    }

    if(g==1)  {

      write_file
        ("/d/wasser/dante/zinsel/log/goetze", ctime()+": "+CAP(getuid(TP))+" holt Ratz!\n");

      write(BS(
            "Du murmelst "+capitalize(name)+", der Altar bebt!!! "
            "Das Wasser scheint sich aufzubaeumen, Wellen schlagen hoch! "
            "Und vor Dir steht ploetzlich "+capitalize(name)+"!!!"));

      say(BS(
            CAP_TPN+" murmelt etwas Bedrohliches! Der Altar beginnt zu beben, "
            "Wellen schlagen hoch und ploetzlich erscheint der Goetze "
            ""+capitalize(name)+"!!!"));
      g=0;	 
      ob=clone_object("/d/wasser/dante/zinsel/npc/ra");
      ob->move(TO, M_GO+M_SILENT);
      return 1; 
    }
    return 0; 
  }
  return 0;
}


void reset()  {
  ::reset();
  g=1; 
}




swim(string str )
{
  NF(BS(
        "Du versuchst im Meer zu schwimmen, doch die Stroemung treibt Dich "
        "sofort wieder an die kleine Insel zurueck."));

  if(!str)  { return 0; }


  if(member(({"nach "+dir+""}),str)!=-1)   {

    write(BS(
          "Du springst ins Wasser und schwimmst nach "+capitalize(dir)+"! "
          "Die Stroemung hilft Dir dabei und so kommst Du gut voran!"));

    this_player()->move("/d/wasser/dante/zinsel/room/oswim", M_GO,
        "ins Meer und schwimmt hinaus", "springt", "kommt hier her geschwommen");
    return 1;
  }
  return 0; 
}



