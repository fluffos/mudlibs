/*
   schwimm raum fuer inzels
   dante sl 99
   */


inherit "std/room";
#include <moving.h>
#include <player.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"



void create()
{
  ::create();


  SSH("Mitten im Meer");

  SLO(BS(
        "Du bist nun ein Stueck von der Insel entfernt und schwimmst "
        "im Meer. Das Wasser umspuelt Dich sanft, die Wellen plaetschern "
        "um Dich herum. Du fuehlst Dich hier rundherum wohl und erfreust "
        "Dich Deines Lebens. Manchmal steigen Blasen vom Grund auf "
        "und zerplatzen an der Oberflaeche."));


  AD(({"blase","blasen"}),
      "PLOPP! PLOPP! Blasen zerplatzen an der Oberflaeche des Wassers.");

  AD("oberflaeche",
      "Die Oberflaeche des Meeres ist hier ruhig. PLOPP!!! Schon wieder "
      "zerplatzt eine Blase.");
  ASD("leben", "tot");
  AD("meer",
      "Du paddelst genuesslich im Meer herum. Irgendwie spassig, wenn man "
      "nur von Wasser umgeben ist.");
  AD("wasser",
      "Das Wasser ist hier sehr gruen und frisch. Es plaetschert ruhig "
      "dahin.");
  AD(({"welle","wellen"}),
      "Die Wellen schlagen mild an Dich. Lustig.");
  AD("boden",
      "Den Boden kann man nicht erkennen.");
  AD("grund",
      "Der Grund des Meeres ist hier nicht zu sehen. Trotzdem ist das "
      "Meer hier nicht tief. Man koennte ja zum Grund hinab tauchen.");


  AD("stueck",
      "Nicht allzu weit von Dir.");
  AD("insel",
      "Die Insel liegt im Westen von hier. Du kannst einfach zur Insel "
      "zurueckschwimmen.");
  AD("westen",
      "Da liegt die Insel mit dem grossen Baum.");
  AD("baum",
      "Der Baum ist auch von hier zu sehen.");

  AD("himmel",
      "Der Himmel ist hier rot. Rot?! Du musst irgendwie farbenblind sein.");


  SetProp(P_LIGHT,1);
  SP(P_INDOORS, 0);
  SP(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]));

  AddSmell( DEFAULT_SMELL,
      "Du kannst das salzige Wasser des Meeres riechen.");
  AddSmell(({"wasser","meer"}),
      "Es riecht wunderbar frisch.");
  AddSound(DEFAULT_SOUND,
      "Das Meer rauscht und gluckst hier wild.");
  AddSound("meer",
      "Es rauscht hier recht laut.");


  AddCmd (({"schwimme", "schwimm"}), "swim");

  ACD(({"tauch","tauche"}), "down");

  AddRoomMessage(({
        "PLOPP!!! PLOPPP!!!\n",
        "Eine Blase zerplatzt genau vor Deiner Nase!\n",
        "Hmm, was wohl unter Dir ist.\n",
        "Du paddelst vergnuegt herum.\n",
        "Der Grund des Meeres interessiert Dich sehr.\n"}), 30);

  AIT("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);
  AIT("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);


}

int down(string str)  {
  NF("Du willst runter tauchen, oder?!\n");
  if(str=="runter"||str=="nach unten"||str=="zum grund"||str=="zum boden")   {

    if(present("fisch", TO))  {
      write("Der Fisch laesst Dich nicht nach unten tauchen!\n");
      return 1; 
    }

    write(BS(
          "Du tauchst nach unten."));

    TPM("/d/wasser/dante/zinsel/room/grund", M_GO, 
        "nach unten", "taucht", "kommt herabgetaucht");

    return 1; 
  }
  return 0;  
}



int swim(string str )
{
  NF("Du schwimmst ein bisschen herum und gelangst immer wieder hier her.\n");

  if(!str)   {
    write(BS(
          "Du schwimmst ein bisschen im Wasser herum."));
    say(BS(
          CAP_TPN+" schwimmt um Dich herum und grinst."));
    return 1; 
  }

  if(member(({"nach westen", "zur insel", "zurueck", "zu insel"}),str)!=-1)  {
    {
      write(BS(
            "Du schwimmst in Richtung der grossen Insel."));
      this_player()->move("/d/wasser/dante/zinsel/room/isle_03", M_GO,
          "davon", "schwimmt", "kommt aus dem Wasser gestiegen");
      return 1;
    }

    return 0; 
  }
  return 0; 
}

string tot()  {
  return(BS(
        "Du warst schon "+TP->QueryProp(P_DEADS)+" mal tot. Das ist "
        "sicherlich viel zu wenig. Na mal sehen, was wir fuer Dich tun "
        "koennen..."));  
}

