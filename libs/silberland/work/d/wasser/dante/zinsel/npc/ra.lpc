/*
dante sl 99
einer der 4 goetzen die das blut fuer die waffen haben
die der mytagoge daraus bauen kann
jeder goetze hat eine andere schwaeche bzw staerken
sonst sind sie aber aehnlich
jeder hat ein andersfaerbiges blut entsprechen dem marmor der
gaenge die zu ihm fuehren bzw der farbe des altars usw...
jeder goetze hat 2 schwaechen eine physische und eine andere
holy 0 damit paladine nicht soo bevorzugt werden

*/




#include "/players/dante/myowndefine.h"
inherit "std/npc";
inherit "/std/npc/spells.lpc";

#include "/gilden/bardengilde/barden_extern.h"
inherit "/gilden/bardengilde/obj/std_spellprovider";



#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>
#define ANZAHL 5+random(5)



string n="ratzhjifed";

//name des goetzen

object blut;

reset()  {
object ob;
::reset();
if(!is_clone(this_object()))  { return;  }

ob=present("tropfen", TO);

if(ob)  { ob->remove(); }


if(!environment(TO))  { remove(); }


tell_room(environment(TO),
"Der Goetze lacht laut auf und verschwindet wieder!\n");
remove();  }



void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Der Zombiegoetze "+capitalize(n)+"");

SP(P_LONG, BS(
"Das ist der Zombiegoetze "+capitalize(n)+", der Herr des Todes."));

SetProp(P_NAME,({ "Zombiegoetze "+capitalize(n)+"",
                  "Zombiegoetzen "+capitalize(n)+"",
                  "Zombiegoetzen "+capitalize(n)+"",
                  "Zombiegoetzen "+capitalize(n)+""}));
SetProp(P_GENDER, MALE);
AddId(({"goetze","goetzen","zombiegoetze",""+n+""}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:15, T_RANGE_MAX: 40]));
create_default_npc(33);

set_living_name(""+n+"");

SetProp(P_HANDS, 
({" mit seiner dunklen Macht", 400, ({DT_UNHOLY, DT_MAGIC})}));
SetProp(P_BODY, 100);
SetProp(P_SIZE, 500);
SetProp(P_ALIGN, -1000);
SetProp(P_DIE_MSG, " verschwindet so schnell wie er gekommen ist.\n");

SetProp(P_TRANSPARENT, 0);


SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.0,DT_UNHOLY:-1.0, DT_TERROR:-1.0,
  DT_COLD:0.3, DT_RIP:0.5 ]));
  
SetProp(P_AGGRESSIVE, 1);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,10);
SetProp(P_NOCORPSE, 1);

SetProp(P_MSGIN, "erscheint ploetzlich vor Dir");
SetProp(P_MSGOUT, "");
SetProp(P_MMSGIN, "erscheint ploetzlich vor Dir");
SetProp(P_MMSGOUT, "loest sich auf");




SetProp(P_KILL_MSG, "Warum musstest Du mich auch rufen!!! Du elender Wurm!");
SetProp(P_KILL_NAME, "Der Zombiegoetze "+capitalize(n)+"");
SetProp(P_MURDER_MSG, "Meine dunklen Maechte haben mich verlassen!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));


SetProp(P_SPELLRATE,60);


AddSpell(5,500,
"Der Zombiegoetze "+capitalize(n)+" versucht Dich in Wasser zu verwandeln.\n",
"Der Zombiegoetze "+capitalize(n)+" versucht @WEN in Wasser zu verwandeln.\n",
DT_WATER, ([SP_SHOW_DAMAGE:1]));



AddSpell(1,1000,
"Der Zombiegoetze "+capitalize(n)+" schlaegt Deinen Kopf gegen den Altar.\n",
"Der Zombiegoetze "+capitalize(n)+" schlaegt @WESSEN Kopf gegen den Altar.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

AddDefaultSpell(1,300,DS_BLIND,
"Der Zombiegoetze "+capitalize(n)+" blickt Dir tief in die Augen.\n",
"Der Zombiegoetze "+capitalize(n)+" blickt @WEM tief in die Augen.\n");

AddDefaultSpell(1,300,DS_FEAR,
"Der Zombiegoetze "+capitalize(n)+" bruellt Dich an.\n",
"Der Zombiegoetze "+capitalize(n)+" bruellt @WEN an.\n");

AddDefaultSpell(1,300,DS_DISARM,
"Der Zombiegoetze "+capitalize(n)+" untersucht Dich genau.\n",
"Der Zombiegoetze "+capitalize(n)+" untersucht @WEN genau.\n");

AddDefaultSpell(1,300,DS_CURSE_ARMOUR, 
"Der Zombiegoetze "+capitalize(n)+" betrachtet Dich genau.\n",
"Der Zombiegoetze "+capitalize(n)+" betrachtet @WEN genau.\n");

AddDefaultSpell(1,300,DS_CURSE_WEAPON, 
"Der Zombiegoetze "+capitalize(n)+" untersucht Dich genau.\n",
"Der Zombiegoetze "+capitalize(n)+" untersucht @WEN genau.\n");

AddDefaultSpell(1,300,DS_REDUCE_AC,
"Der Zombiegoetze "+capitalize(n)+" mustert Dich genau.\n",
"Der Zombiegoetze "+capitalize(n)+" mustert @WEN genau.\n");

AddDefaultSpell(1,300,DS_REDUCE_WC,
"Der Zombiegoetze "+capitalize(n)+" durchleuchtet Dich genau.\n",
"Der Zombiegoetze "+capitalize(n)+" durchleuchtet @WEN genau.\n");

AddDefaultSpell(1,300,DS_POISON,
"Der Zombiegoetze "+capitalize(n)+" spuckt Blut nach Dir.\n",
"Der Zombiegoetze "+capitalize(n)+" spuckt Blut nach @WEM.\n");



//**************************************************************


AddSpell(1,100,
"Der Zombiegoetze "+capitalize(n)+" belegt Dich mit einer Totenstarre.\n",
"Der Zombiegoetze "+capitalize(n)+" belegt @WEN mit einer Totenstarre.\n",
DT_TERROR, "spell_para");



AddSpell(2,100,
"Der Zombiegoetze "+capitalize(n)+" ruft dunkle Maechte zu Hilfe.\n",
"Der Zombiegoetze "+capitalize(n)+" ruft dunkle Maechte zu Hilfe.\n",
DT_MAGIC, "spell_all");

SetAttackChats(10,({
}));

blut=clone_object("d/wasser/dante/zinsel/obj/ztropfen");
blut->SetProp(P_AMOUNT, ANZAHL);
blut->move(TO, M_GET);


}

void spell_para(object enemy,int damage,mixed dam_type)
{
switch(random(100))

{
case 0 .. 30:
enemy->SetProp(P_PARALYZED, ([PARALYZE_TIME: random(6),
PARALYZE_MSG: "Aber Du bist doch in einer Totenstarre erstarrt!\n",
PARALYZE_MSG_OTHER: "%s erstarrt totenaehnlich.",
PARALYZE_END: "Du erwachst wieder.\n",
PARALYZE_END_OTHER: "%s erwacht wieder aus "
+TP->QueryPossPronoun(FEMALE, WEN, SINGULAR)
+" Totenstarre.\n"]));
break;

case 31 .. 100:
enemy->Defend(300+random(200), DT_UNHOLY,
([SP_SHOW_DAMAGE:1, SP_NAME:"Dunkle Maechte"]), this_object());


tell_object(enemy,
"Du taumelst umher, aber Du entkommst der Totenstarre!!!\n");
tell_room(environment(enemy),
enemy->name(WER)+" taumelt umher, entkommt aber der Totenstarre.\n",({enemy}));
}

}



void spell_all(object enemy,int damage,mixed dam_type)
{
object *inv;

int i;

inv=PresentEnemies();
damage=500+random(500);
damage/=sizeof(inv);
tell_room(ENV(ME), BS("Dunkle Maechte konzentrieren sich auf der Insel!\n"));
for(i=sizeof(inv)-1;i>=0;i--)
{
tell_object(inv[i], "Die dunklen Maechte dringen in Dich ein!!\n");

inv[i]->Defend(damage, DT_UNHOLY,
([SP_SHOW_DAMAGE:1,SP_NAME:"Dunkle Maechte"]), this_object());
       }      }




       
       void NotifyPlayerDeath(object player, object killer, int lostexp)
{

write_file("/d/wasser/dante/zinsel/log/gtot",
ctime()+":  "+n+" hat "+CAP(getuid(PL))+" umgebracht.\n");
call_out("nimm_alles", 0);
}







nimm_alles()  {
  if(present("leiche", environment(TO)))  {
  command("nimm alles aus leiche");
   } 
}

public varargs void die(int poisondeath) {
  domainshout(BS(CAP_TPN+" hat den dunklen Maechten des Zombiegoetzen "+capitalize(n)+" widerstanden "
                  "und einen grossen Sieg errungen! Heil "+TPN+"!"), "wasser/dante/zinsel", 1);
  write_file("/d/wasser/dante/zinsel/log/gtoetet",
  ctime()+": "+n+" wurde von "+CAP(getuid(PL))+" umgebracht.\n");

  if(this_player()->QueryProp(P_BARD_GROUP) == BARD_GROUP_SARRIAN && 
      this_player()->QuerySkill("das geheimnis der insel") == 0) {
        LearnBardSpell(this_player(), "das geheimnis der insel", 
        "Nachdem du diesen Schrecken ueberwunden hast erklingt in deinem "
        "Kopf die unheimliche Ritualmusik der Zombiegoetzen. Mit "
        "ihrer Melodie kannst du den zersetzenden Odem der Untoten "
        "herbeirufen, um deine Feinde zu zerfressen.",
        "spiele 'das geheimnis der insel'");
  }

  ::die(poisondeath);
}
 _query_wimpy() { return 0;}
