//dante sl 99

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include "class.h"
int l;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Geistermatrose");
  SetProp(P_LONG, BS (
        "Das ist einer der unseligen Matrosen die fuer immer und ewig "
        "hier segeln muessen. Er sieht schon sehr faulig und ekelerregend aus."));

  SetProp(P_NAME, "Geistermatrose");
  SetProp(P_GENDER, MALE);
  AddId( ({"geistermatrose","geist","matrose", "MATROSE"}) );
  AddClass(CL_UNDEAD);

  create_default_npc(10+random(6));
  l=QP(P_LEVEL);
  SetProp(P_HANDS, ({" mit eiskalten Klauen",l*12 , DT_UNHOLY}));
  SetProp(P_BODY, l*3);
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, " schaut Dich nur stumm an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Was soll der Geistermatrose damit?!\n"}));
  SP(P_AGGRESSIVE, 0.05);
  SP(P_NOCORPSE,1);

  SetProp(P_DIE_MSG, " verschwindet in das Reich der Geister.\n");

  SetProp(P_SPELLRATE, l*5);

  AddSpell(5, l*12, 
      "Der Geistermatrose rammt Dir einen Fuss in den Bauch.\n",
      "Der Geistermatrose rammt @WEM einen Fuss in den Bauch.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));      

  AddSpell(2, l*20, 
      "Der Geistermatrose rammt Dir einen Fuss in das Gesicht.\n",
      "Der Geistermatrose rammt @WEM einen Fuss in das Gesicht.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));                                                                        
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "erscheint vor Dir");
  SetProp(P_MMSGOUT, "schwebt weit davon");

  SetChats(4, ({
        "Der Geistermatrose grinst Dich boese an.\n",
        "Der Geistermatrose groellt laut.\n",
        "Der Geistermatrose flucht was das Zeug haelt.\n",
        "Der Geistermatrose spuckt Dich an.\n",
        "Der Geistermatrose lacht laut.\n",
        "Der Geistermatrose verflucht das Meer.\n"
        }));
}

init(){
  object defender;
  ::init();
  if(TP && interactive(TP)){
    call_out("tag", 1); }
  if ( environment() && 
      ( (defender = present("MATROSE")) || (defender = present("KAPITAEN")) ))
    AddDefender(defender);   	
}

tag()  {
  if(!TP || environment(TO)!=environment(TP))  return ;
  write(BSA(
        "Was willst Du von mir, "+TPN+"!",
        "Der Geistermatrose sagt: "));
} 

void InformDefend(object enemy)
{
  Kill(enemy);
}

reset()  {
  ::reset();
  if (!is_clone(TO)) return;
  TO->move("/players/dante/workroom.lpc", M_TPORT+M_SILENT);
  remove();
}

