//dante sl 99

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include "class.h"


object cash;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der einbeinige Geisterkapitaen");
  SetProp(P_LONG, BS (
        "Das ist der verfluchte Geisterkapitaen, der Schuld an allem hat! "
        "Seine Gier stuerzte das ganze Schiff uns Unglueck!"));

  SetProp(P_NAME, "Geisterkapitaen");
  SP(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  AddId( ({"geisterkapitaen","geist","kapitaen", "KAPITAEN"}) );
  AddClass(CL_UNDEAD);
  SP(P_NAME_ADJ, "einbeinig");
  create_default_npc(25);
  SetProp(P_HANDS, ({" mit eiskalten Klauen",300 , DT_UNHOLY}));
  SetProp(P_BODY, 90);
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, " schaut Dich nur stumm an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Was soll der Geisterkapitaen damit?!\n"}));
  SP(P_AGGRESSIVE, 1);

  SetProp(P_DIE_MSG, " verschwindet fluchend in das Reich der Geister.\n");
  SP(P_KILL_MSG, "flucht laut: Du verfluchter Buckelwal! Das naechste Mal haeute Ich Dich zusaetzlich noch!");

  SP(P_MSG_FLAGS, ([P_KILL_MSG: 1, P_MURDER_MSG: 1]));
  SP(P_KILL_NAME, "Der einbeinige Geisterkapitaen");
  SP(P_MURDER_MSG, "wuenscht Euch die Beulenpest an den Hals, ihr verfluchten Meeressaeue!!!");

  SetProp(P_SPELLRATE, 70);
  SP(P_NOCORPSE, 1);

  AddSpell(5, 250 ,
      "Der Geistekapitaen rammt Dir einen Fuss in den Bauch.\n",
      "Der Geisterkapitaen rammt @WEM einen Fuss in den Bauch.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));      

  AddSpell(2, 350, 
      "Der Geisterkapitaen rammt Dir einen Fuss in das Gesicht.\n",
      "Der Geisterkapitaen rammt @WEM einen Fuss in das Gesicht.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));                                                                        

  AddSpell(1, 500, 
      "Der Geisterkapitaen verflucht Dich lauthals!\n", 
      "Der Geisterkapitaen verflucht @WEN lauthals.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));                                                                        

  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "erscheint vor Dir");
  SetProp(P_MMSGOUT, "schwebt weit davon");

  SetAttackChats(4, ({
        "Der Geisterkapitaen grinst Dich boese an.\n",
        "Der Geisterkapitaen groellt laut.\n",
        "Der Geisterkapitaen flucht was das Zeug haelt.\n",
        "Der Geisterkapitaen spuckt Dich an.\n",
        "Der Geisterkapitaen lacht laut.\n",
        "Der Geisterkapitaen bruellt: HAU AB!\n",
        "Der Geisterkapitaen bruellt: Du Hurensohn!\n",
        "Der Geisterkapitaen bruellt: Verdamtes Schwein DU!!!\n",
        "Der Geisterkapitaen verflucht das Meer.\n"
        }));

  SUID;
  cash=clone_object("/obj/money");
  cash->SP(P_AMOUNT, 300+random(200));
  cash->move(TO, M_GET);
  //muenzen um das 10 fache verringert...vom 8000 auf max 500

  "obj/gemmaster"->DistributeGem(2,2,1,1);
  CLONEME("/d/wasser/dante/zinsel/obj/hobein");


}


init(){
  object defender;

  ::init();
  if(interactive(TP)){
    call_out("tag", 1); }

  if (defender = present("geist")) AddDefender(defender);          	

}


tag()  {
  if(environment(TO)!=environment(TP))  return ;
  write(BSA(
        "HE, "+TPN+"! Du verfluchter Hund der Meere!!! Krepier Du verfluchter "
        "Hurensohn! Ausgeburt eines Bastards!!! Scheiss auf die Etikette!!! "
        "Verflucht sei alles Leben, Du Warzenwal!",
        "Der Geisterkapitaen flucht: "));
}  


void InformDefend(object enemy)
{
  Kill(enemy);
}

void reset()
{
  object ob,next;

  ::reset();

  if (!is_clone(this_object())) return;

  if(!InFight())  {

    tell_room(environment(TO),
        "Der Geisterkapitaen loest sich ploetzlich auf...\n");
    move("/players/dante/workroom",M_TPORT+M_SILENT);
    for(ob=first_inventory(this_object());ob;) {
      next=next_inventory(ob);
      ob->remove();
      ob=next;
    } 
    call_out("remove", 0);
  }
}

