//dante nostromo sl 97-99

inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;  
  ::create();

  AddId(({"Eiljeen", "eiljeen"}));
  create_default_npc(22);
  SetProp(P_SHORT, "Ein ekelerregendes Eiljeen");
  SetProp(P_LONG, BS(
   "Das Eiljeen ist eine weitgehenst unerforschte Spezies, "
   "da sie aufgrund ihrer Kraefte bis jetzt in noch nie"
   " in einem Raum laenger festgehalten werden konnte. Bekannt "
   "ist nur sein aeusserst hohes Aggressionspotential "
   "und seine unglaubliche Brutalitaet mit dem es alles "
   "attackiert was sich ihm in den Weg stellt. Du erkennst einen "
   "kleinen, schwarzen Punkt am Eiljeen."));
   AD("punkt",
  "Da steht doch glatt:\n"
  "Nostromo ist doof!\n");
   
  SetProp(P_INFO, BS(
"Das Eiljeen hat etwas, was Du gerne haettest!"));

  SetProp(P_NAME, "Eiljeen");
  SP(P_NAME_ADJ, "ekelerregend");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_HANDS, ({" mit staehlernen Klauen", 300, DT_RIP}) );
  SetProp(P_ALIGN, -666);      
  SetProp(P_RACE, "Eiljeen");
  SetProp(P_BODY, 70);
  SetProp(P_SIZE, 210);        
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE: -1.0, DT_COLD: 1.0,
   DT_EXPLOSION: 1.0, DT_TERROR: -0.7, DT_UNHOLY:-0.7,
            DT_LIGHTNING: -0.75, DT_LIGHT: 0.9,
             DT_SLASH: -0.5]));
  SetProp(P_DIE_MSG, " stirbt mit eine Schrei, der Deinen Koerper erschuettern laesst.\n");
  SetProp(P_KILL_NAME, "Das Eiljeen");
  SetProp(P_MURDER_MSG, "windet sich in Schmerzen und geht zugrunde.\n");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1]));
  SetProp(P_MSG_FLAGS, ([P_MURDER_MSG:1]));
  SetProp(P_KILL_MSG, "zerfetzt mit Kaltbluetigkeit eine Leiche");
  SetProp(P_MSGIN, "erscheint lautlos, scheinbar aus dem Nichts");
  SetProp(P_MSGOUT, "gleitet lautlos");
  SetProp(P_MMSGIN, "loest sich gut getarnt vom Hintergrund los");
  SetProp(P_MMSGOUT, "wird mit dem Hintergrund wieder eins");
  SetProp(P_SPELLRATE, 70);
  
  SetChats(3, ({
    "Das Eiljeen faucht Dich an. Dir wird Angst und Bange.\n",
    "Das Eiljeen bewegt sich lautlos.\n",
    "Das Eiljeen jagt Dir noch nie verspuerte Angst ein.\n"
  }) );


   AddSpell(3, 250,
    "Das Eiljeen stoesst einen Schrei aus, der Deinen Koerper erschuettern laesst.\n",
    "Das Eiljeen stoesst einen Schrei aus. @WER muss sich die Ohren zuhalten.\n",
    ({DT_SOUND}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 500,
    "Das Eiljeen bespritzt Dich mit Saeure.\n",
    "Das Eiljeen bespritzt @WEN mit Saeure.\n",
    ({DT_ACID}), ([SP_SHOW_DAMAGE:1]));
    
   AddSpell(1, 300,
    "Das Eiljeen bespritzt Deine Augen mit Saeure.\n",
    "Das Eiljeen bespritzt @WESSEN Augen mit Saeure.\n",
    DT_ACID, ([SP_SHOW_DAMAGE:1]));   
    
      AddSpell(1, 300,
    "Das Eiljeen schaut Dir in die Augen.\n",
    "Das Eiljeen schaut @WEM in die Augen.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));    
    
       AddSpell(1, 300,
    "Das Eiljeen sprueht Gift auf Dich.\n",
    "Das Eiljeen sprueht Gift auf @WEN.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));   
  AddSpell(1, 600,
    "Das Eiljeen schlaegt mit seinem Schwanz gegen Dich.\n",
    "Das Eiljeen schlaegt mit seinem Schwanz gegen @WEN.\n",
    DT_WHIP, ([SP_SHOW_DAMAGE:1]));
    
    SUID;
    CLONEME(ZO"rkey");
    
}

void die(int poisondeath) 
{
   write_file(ZL"alien",
    dtime(time())+": "+CAP(getuid(TP))+" toetet das Alien.\n");
  ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(ZL"alien",
    ctime()+": Das Alien hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}
