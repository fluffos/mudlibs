//saeuredrache
//dante sl 99-98

inherit "/p/std/dragons/dragon";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <wizlevels.h>
#include <class.h>
#include <new_skills.h>

object cash;

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();    
  SetProp(P_NAME, "Azidozok");
  SetProp(P_ARTICLE, 0);
  create_default_dragon(3,6+random(3),0,25+random(7));
  //statt 30+rand(10) nun das, also deutlich weniger

  AddId(({"NOWIMPY","drache","azidozok", "saeuredrache"}));
  SetProp(P_LONG,BS(
        "Das ist Azidozok, der Saeuredrache. Sein massiver Koerper scheint eine "
        "wabbelnde Masse purer Saeure zu sein. Giftige Daempfe steigen von "
        "ihm auf und umgeben ihn mit gelb-gruenen Nebel. Das Atmen in seiner "
        "Umgebung schmerzt und Deine Augen traenen. Wie gross der Drache wirklich "
        "ist kann man nicht so genau sagen..."));

  SetProp(P_SHORT, "Azidozok, der Saeuredrache");
  SetProp(P_NAME_ADJ, "giftgruen");//muss so bleiben!!!
  AddId(({"azidozok","drache","saeuredrache"}));

  set_living_name("saeuredrache");

  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) + 
        ([DT_BLUDGEON: 0.3, DT_RIP:-1.0, DT_PIERCE:-1.0,
          DT_UNHOLY:-1.0, DT_HOLY:0.3, DT_TERROR:-1.0]));

  SetProp(P_HANDS, ({" mit seinen Saeureklauen",QueryProp(P_HANDS)[1]-50,
      ({DT_ACID, DT_RIP})}));
  //hands erhoeht ca 100

  SetProp(P_AGGRESSIVE, 0.01);

  AddSpell(1,100,
      "Azidozok, der Saeuredrache spuckt giftige Saeure nach Dir!\n",
      "Azidozok, der Saeuredrache spuckt giftigen Saeure nach @WEM!!\n",
      DT_ACID, "spell_gift", ([SP_SHOW_DAMAGE:1]) );

  /*

     AddSpell(1,100,
     "Azidozok, der Saeuredrache spuckt EXTREM giftige Saeure nach Dir!\n",
     "Azidozok, der Saeuredrache spuckt EXTREM giftige Saeure nach @WEM!!\n",
     DT_ACID, "spell_virus");
     */


  cash=clone_object("obj/money");
  cash->SP(P_AMOUNT, 5000+random(5000));
  cash->move(TO, M_GET);
  //statt 10k +rand(10)k nun das

}



int Defend(int dam, mixed dtype, mixed spell, object enemy)
{
  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (sizeof(dtype & ({ DT_ACID }) ))
  {
    tell_object(enemy,
        "Der Saeuredache staerkt sich durch Deinen dummen Angriff.\n"
        "Saeurestrahlen schiessen aus dem Drachen direkt auf Dich zu!!!\n");
    enemy->Defend(1000+random(1000), DT_ACID, ([SP_SHOW_DAMAGE: 1]));
    tell_room(environment(TO),
        ""+enemy->name()+" wird von Saeurestrahlen getroffen!\n", ({enemy}));

    heal_self(300);

    return ::Defend(0, dtype, spell, enemy);
  }

  return ::Defend(dam, dtype, spell, enemy);
}


void spell_gift(object enemy, int damage, mixed dam_type)
{
  if(!random(5)) {
    tell_object(enemy,
        "Der giftige Schleim dringt tief in Deine Haut ein!\n");
    enemy->AddPoison(4+random(5));  }

  else
    tell_object(enemy,
        "Der giftige Schleim verfehlt Dich nur knapp.\n"); 
}


int _query_wimpy() { return 0;}


void die(int poisondeath)
{
  object ob;

  if(!deep_present("RPD", TP))  {
    ob=clone_object("/d/wasser/dante/zinsel/obj/resistenz");
    ob->move(TP, M_NOCHECK);
    write("\n"
        "Eine seltsame Saeurewolke huellt Dich ein! Du bist nun eine zeitlang vor "
        "den Saeureattacken des Pflanzendrachens sicher!!!\n\n");
  }

  if(ob = present("\nzechpreller_quest_11", TP))
    ob->Mark(poisondeath);
  

  TP->heal_self(400);
  write("Das Blut des toten Saeuredrachen heilt Dich total!!!\n");

  write_file("/d/wasser/dante/zinsel/log/saeuredrachestirbt",
      ctime()+": "+CAP(getuid(TP))+" killt den Saeuredrachen.\n");
  if( !IS_LEARNER(TP) )
    domainshout(CAP(TP->query_real_name())+
        " hat Azidozok, den Saeuredrachen bezwungen.\n");
  ::die(poisondeath);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/wasser/dante/zinsel/log/saeuredrachetoetet",           
      ctime()+": Der Saeuredrache hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  command("iss leiche");
}

