//dante sl 99

inherit "/std/mnpc";
inherit "/std/npc/spells.lpc";

#include "/players/dante/myowndefine.h"
#include <moving.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <language.h>
#include <thing.h>
#include <new_skills.h>
int am;

init()  {
	::init();
if(interactive(TP)) { call_out("tag", 0); }}

tag()  {
	if(environment(TO)!=environment(TP)) return ;
if(deep_present("DANTE_ZOMBIE_VIRUS", TP))  {
	write(BSA(
	"AHHH!!! Du bist ja krank, "+TPN+"!!! Hau bloss ab!",
	"Der Comiczeichner bruellt: "));  return;  }
		
write(BSA(
"Hallo "+TPN+"! Was fuehrt Dich auf diese einsame Insel!",
"Der Comiczeichner sagt: "));		
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein bis dahin einsamer Comiczeichner");
  SetProp(P_LONG, BS(
  "Du siehst einen einsamen Comiczeichner. Was er hier so macht "
  "und wie er hier auf diese Insel gekommen ist, weiss keiner so "
  "genau. Wahrscheinlich sitzt er hier und zeichnet das Meer, die "
  "Insel, traumhafte Sonnenuntergaenge und denkt ueber das Leben nach. "
  "Er koennte Dir aber auch sehr nuetzlich sein, frag ihn doch "
  "einfach nach Hilfe."));
  SetProp(P_NAME, "Comiczeichner");
  SetProp(P_GENDER, MALE);
SP(P_NAME_ADJ, "einsam");                  

  AddId("comiczeichner");
  AddId("zeichner");

  create_default_npc( 25 );

  SetProp(P_BODY, 70);
  SetProp(P_HANDS, ({" mit seinen Zeichenutensilien", 120, DT_PIERCE}));
  SetProp(P_ALIGN, 100);
  SetProp(P_RACE, "Mensch");
  SUID;
  
  CLONEME("/d/wasser/dante/zinsel/obj/brush.lpc");
  CLONEME("/d/wasser/dante/zinsel/obj/pencil.lpc");

  command ("trage alles");
  command ("zuecke bleistift");
  SP(P_MAX_HP, 2000);

  SetChats(7, ({

  "Der Comiczeichner blaettert zwei bemalte Filmfolien vor und zurueck.\n",
  "Der Comiczeichner sagt: Wohin sind die guten Zeiten.\n",
  "Der Comiczeichner wirft eine missratene Zeichnung in den Papierkorb.\n",
  "Der Comiczeichner zeichnet ein paar Sketches.\n",
  "Der Comiczeichner verwuenscht \"Industrial Light & Magic\".\n",
  "Der Comiczeichner malt seine Comicfiguren auf dem Papier aus.\n",
  "Der Comiczeichner sagt: Ach das waren noch Zeiten....\n",
  "Der Comiczeichner spitzt seinen Bleistift.\n",
  "Der Comiczeichner sagt: \"Halllooooo Schwester\", und grinst dann!\n",   
  "Der Comiczeichner leert den Papierkorb aus.\n",
  }) );

AI("insel",
"Die Insel ist verflucht, weiss auch nicht warum ich noch hier "
"lebe. Aber mir passiert nichts, ich gehe niemals nach unten...",
"sagt: ");
AI("baum",
"Irgendwie kann man in den Baum hinein.", "sagt: ");
AI("hebel",
"Hmm, der war doch da irgendwo...", "sagt: ");
AI(({"aussaetziger","aussatz","aussaetzige"}),
"Die Aussaetzigen hier sind nicht allzugefaehrlich. Sie haben "
"irgendeine schwere Krankheit, die aber von ihnen kaum uebertragen "
"werden kann. Gefaehrlich wirds nur, wenn die Krankheit immer "
"weiter geht. Dann muetieren sie zu Zombies, aber meistens "
"sterben sie viel frueher...", "sagt: ");
AI("krankheit",
"Es muss ein Zombievirus sein, der die Leute grausig entstellt und "
"sie zu lebenden Untoten macht. Eklig!!!", "sagt: ");
AI(({"virus","zombievirus"}),
"Ja, ich denke das ist die Krankheit! Frag lieber Dante...",
"sagt: ");
AI(({"zombie","untoter","untote","zombies"}),
"Angeblich hausen unter der Insel Zombies angefuehrt von einem "
"Zombiedrachen. Sie sollen diese Seuche verursachen, aber man "
"soll sich nur extrem schwer anstecken koennen...", "sagt: ");
AI(({"drache","zombiedrache"}),
"Der Zombiedrache soll irgendwo da unten hausen...",
"warnt: ");
AI(({"goetzen","goetze"}),
"Ja ich habe da einmal was gehoert. Es soll 4 Goetzen geben, die "
"von den Zombies verehrt werden. Angeblich sind sie schreckliche "
"Unwesen, die man irgendwie zum Leben erwecken kann. Aber besser "
"Du fragst Zerfallos Zombioid,", "sagt: ");
AI("hilfe",
"Kein Problem, gib mir Geld, dann siehst Du schon...", "sagt: ");
AI("geld",
"Naja, ich sammle es...", "sagt: ");

AI(({"zerfallos","zombioid"}),
"Hmm, ich kenne ihn kaum. Er wohnt irgendwo unter der Insel. "
"Angeblich hat er eine Kneipe oder sowas...", "sagt: ");
AI("kneipe",
"Hmm, ja es gibt eine, aber da komme ich nicht hinein. Man muss "
"wohl irgendetwas bestimmtes besitzen. Was genau, keine Ahnung!",
"sagt. ");

  AddInfo(({"comic","comics"}), "Oja, das ist mein Leben, mein Beruf. Frueher war sowas noch eine Kunst, aber heute... sieh Dir Toystory an. Da ist kein Leben dahinter, das ist wie mit CDs, da fehlt einfach etwas, findest Du nicht ??", "philosophiert: ");
  AddInfo("leben", "Hmmm... also das fing so an.....*blabla*", "schwelgt dahin: ");
  AddInfo("kunst", "Ja natuerlich ist das eine Kunst, oder willst Du das etwa abstreiten ??", "bruellt Dich an: ");
  AddInfo("nostromo", "Hmmm... jaja, das ist doch der der immer \"Mila Superstar\",\"Bonkers der listige Luchs aus Hollywood\", \"Gargoyles\" und all die anderen Cartoon-Groessen schaut. *kicher* Ein echter Kenner der Szene !!", "antwortet: ");
  AddInfo("dusty", "Tja, dazu kann ich nicht viel sagen, nur soviel, dass ich sie mit diesem Namen nicht in einem Trickfilmstudio einstellen wuerde.", "denkt: ");
  AddInfo("stahldorn", "Hihi, der Marshal Brave Star des Silberlandes...", "schmunzelt: ");
  AddInfo("vivienne", "Hmm, FIFI?!", "spricht: ");
  AddInfo("angrox", "Angrox ist der Herr aller Druiden!", "sagt: ");
  AddInfo("monimor", "Ein fleissiger Mediziner, nicht wahr ?? Tut mir aber total leid, hat naemlich keine Zeit zum Fernsehen mehr, und verpasst somit die besten Zeichentrickserien, wie zB \"Saberrider and the Starsheriff\".", "antwortet: ");
  AddInfo("wuschel", "Sie erinnert mich mit ihren Locken irgendwie an so eine \"Charlie Brown\"-Cartoon-Figur, aber welche nur........", "gruebelt: ");
  AddInfo("feyaria", "Wer war das doch gleich ?? Achja, ich erinnere mich, die kinderreiche Mutter die mich so an \"Slappy\" erinnert *kicher*.", "antwortet: ");
  AddInfo("amazora", "Oho, die kleine Madame Mim ?? *hihi* jaja, sehr nett, wirklich.", "kichert: ");
  AddInfo("berx", "Also Berx erinnert mich stark an Miraculix, den Druiden von Asterix & Obelix, weil er fast so weise ist wie dieser, immer dezent im Hintergrund agiert wie dieser, und nicht zuletzt, weil auch er immer zur Stelle ist wenn er gebraucht wird (und wenn er eingeloggt ist).", "antwortet: ");
  AddInfo("woody", "Ach ja, mein Schoepfer Nostromo spricht von ihm immer als \"Papa Schlumpf\", denn der passt auch immer so brav auf seine Soehne/Toechter/Schaefchen auf. Ein netter Waldzwerg, was man so hoert.", "antwortet: ");
  AddInfo("irgendeine", "Zusammen mit Berx erinnert sie mich an \"Susi & Strolchi\". Ein suesses Paar die zwei, nicht wahr ?? Moegen sie lange und gluecklich in Zweisammkeit leben, das wuensch ich ihnen von Herzen.", "schwaermt: ");
  AddInfo("muddymud", "Mh... er benimmt sich genauso wie Garfield. Der schlaeft auch den ganzen Tag.", "antwortet: ");
  AddInfo("homer", "Ach, so wie ich Homer kenn, sitzt der bestimmt wieder mit Doniuts und Duff-Beer vorm Fernseher und schaut sich seine Biene-Maja Videos an.", "amuesiert sich: ");
  AddInfo(({"zeichnung","zeichnungen"}), "Hier sind einige Zeichnungen von meinem naechsten Film", "antwortet: ");
  AddInfo(({"zeit", "zeiten"}), "Tja, die schoensten Zeiten sind vorbei.", "seufzt: ");
  AddInfo( DEFAULT_INFO,"gruebelt: Hat das was mit Comics zu tun ??\n" );
 AI("dante",
 "Der hat mich mit Nostromo erschaffen. Er ist Ehrenzombie ohnegleichen!", "sagt: ");
 AI("nostromo",
 "Naja, idelt herum , sonst nix.", "sagt: ");
   SP(P_SPELLRATE, 40);
   
   AddSpell(5, 200, 
   	"Der Comiczeichner spuckt Dich an!\n",
   	"Der Comiczeichner spuckt @WEN an!\n",
   	DT_ACID, ([SP_SHOW_DAMAGE:1]));
   
    AddDefaultSpell(3, 300,DS_POISON 
   	"Der Comiczeichner spuckt Dich an!\n",
   	"Der Comiczeichner spuckt @WEN an!\n");
   
   
   
  SetProp(P_MSGOUT, "sucht seine Kreativitaet woanders und eilt");
  SP(P_MSGIN, "wandert gruebelnd hierher");
  SetProp(P_MNPC_WAIT,({20,30,30}));
  SetProp(P_MNPC_AREA,  "/d/wasser/dante/zinsel/room/steg");
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/steg1");
  SetProp(P_MNPC_FLAGS,MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS);
 
  SetProp(P_MURDER_MSG, "Ha, %s, mein Bleistift war stumpf, sonst nichts !!\n");
  SetProp(P_DIE_MSG, " sagt: \"Ich wuensche Dir einen 16-t-Amboss auf den Kopf.\" und stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  
SP(P_INFO,BS(
 "Gegen Geld kann Dich der Comiczeichner heilen. Frag ihn mal "
 "nach Farbe."));
AI("farbe",
"Ja, ich habe magische Farbe. Die kann Dich heilen, aber das kostet Geld. "
"Gibs mir einfach!", "sagt: ");
}


void give_notify(object ob)
{
  // VORAB: wer halbwegs einrueckt, ist klar im Vorteil.
  // vor allem, wenn es darum geht, den Code zu lesen (und noch viel mehr,
  // wenn man ihn nicht selbst geschrieben hat!!!) (anm. woody)

  // wesentlich sicherer als id() (anm. woody)
  
  
  
  if(file_name(ob)[0..10]=="/obj/money#")
  {
    am=ob->QueryProp(P_GIVEN_AMOUNT); // P_AMOUNT war der GESAMTBETRAG!!!
                                      // schlimmer bug gewesen! (anm. woody)
    if(am==1)
    {
      write(BS("Der Comiczeichner sagt: PAH! Eine Muenze!!! Behalt sie!"));
      ob->move(TP, M_GET);
      return ::give_notify();         // return fehlte (anm. woody)
    }

    // if(am<100 && am>1)
    if(am<100)  // besser ALLE faelle wo amount<100 ist, handlen (anm. woody)
    {           // dann bleibt nur noch >=100 muenzen ueber als moeglichkeit.
      write(BSA(
        "Nein! Das sind nur "+am+" Muenzen! "
        "Und das ist zuwenig! Trotzdem danke! Ich behalte sie gerne!",
        "Der Comiczeichner grinst und sagt: "));

      ob->move(TO, M_GET);
      return ::give_notify();         // return fehlte (anm. woody)
    }

    // if(am>100)       // haha, was ist, wenn man GENAU 100 muenzen hergibt?
    {                   // (anm. woody) -> weg mit dem if() (s.o.)
  
if(deep_present("DANTE_ZOMBIE_VIRUS", TP))  {
	write(BSA(
	"AHHH!!! Du bist ja krank, "+TPN+"!!! Hau bloss ab! Dich heile ich nicht!",
	"Der Comiczeichner bruellt: "));  return;  }  
 
 
      if( (InFight(TP)) &&(InFight(TO)))  {
        write(BSA(
          "NEIN! Das geht so sicher nicht!!! Hau ab!",
          "Der Comiczeichner bruellt: "));
        ob->remove();
        return ::give_notify();         // return fehlte (anm. woody)
      } 
  
  
      if( (!InFight(TP)) &&(!InFight(TO)))  {
        write(
          "Der Comiczeichner sprueht magische Farbe auf Dich und "
          "Du fuehlst Dich besser.\n");
        TP->heal_self(am/10); 
        TP->SetProp("last_comic_heal_time", time());
        // Zeit setzen um es beim Sehertor zu ueberpruefen
        
        // solche heilstellen sind auf jeden fall explizit meldungs-
        // pflichtig (nicht nur einfach "schauts euch +wasser/dante/zinsel
        // an" - in den *balance*.TXT files war auch kein Hinweis)
        // sonst suchen wir uns von der Balance deppert nach sowas.
        // Heilstellen ohne jegliche Saettigung und Limits sind nur
        // in wirklich gut abgeschoteten Gebieten (wo man nicht "mal
        // eben" tanken gehen kann) gestattet, d.h. das ist noch zu
        // ueberpruefen!!! (anm. woody)

        // ob->move(TO, M_GET);         // und was soll das bringen?
                // give_notify() wird aufgerufen, wenn ein NPC etwas
                // bereits bekommen _HAT_, move() daher sinnlos (anm. woody)

        return ::give_notify();         // return fehlte (anm. woody)
      }
    }
  }
  else  // Was anderes als das Geldobjekt...
  {
    write(BS(
      "Der Comiczeichner grinst und malt etwas in die Luft!"));
    return ::give_notify(ob);
    // P_REJECT in create() je nach gewuenschtem Verhalten zu setzen
    // waere kein Fehler. (anm. woody)
  }
}




die(arg)  {
  int all_money;
     object geld;
     	 if(!environment(TO))
   
     	   { return;  }
     	
geld=deep_present("muenzen", TO);

if(!geld)  {
   
return ::die(arg);   }     

     
     	 
         all_money=geld->QueryProp(P_AMOUNT);
      
          if(all_money<=2000)  {
return ::die(arg);   
           }
      
       "/p/daemon/zentralbank"->PayIn(all_money);	
       
       tell_room(environment(TO),
       "Der Zeichner verschickt sein ganzes Geld mit einer Brieftaube!\n");
       
       geld->SP(P_AMOUNT, 0);

return ::die(arg);   }






     reset()  {
     int all_money;
     object geld;
     	::reset();
     	 if(!environment(TO))
     	   { return;  }
     
     geld=deep_present("muenzen", TO);
     	
     if (!geld)    {
     	return;
        }
        
        
         all_money=geld->QueryProp(P_AMOUNT);
      
      	  if(all_money<=1000)  {
           return;  }
      
       "/p/daemon/zentralbank"->PayIn(all_money);	
      
      
       
       tell_room(environment(TO),
       "Der Zeichner verschickt sein ganzes Geld mit einer Brieftaube!\n");
       
       geld->SP(P_AMOUNT, 0);
      }
