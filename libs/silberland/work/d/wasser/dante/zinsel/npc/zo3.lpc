void init()
{
    ::init();
   
      if(IS_WIZARD(TP))  { return;  }
      VIRUS
   if(interactive(TP)&&TP->QueryProp(P_ALIGN)>ALI)  { 
    
	write( 
"Der abscheuliche Zombie stuerzt sich auf Dich!\n");
	Kill(TP);
    }
      if(!interactive(TP) && TP->id("ZJ") )  {
   	Kill(TP);
   	 tell_room(environment(TO), BS(
   "Der Zombie stuerzt sich voller Wut auf "+TP->name(WEN)+"!"));
   }
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
call_out("nimm_alles", 0);
}



nimm_alles()  {
  if(present("leiche", environment(TO)))  {
  command("nimm alles aus leiche");
   } 
     }


void spell_virus (object enemy, int damage, mixed dam_type) {


object *inv, ob;
int i;

       
      
inv=PresentEnemies();
inv-=({ this_object(), 0 });

 ob=clone_object("/d/wasser/dante/zinsel/obj/zv");
 
 
for(i=sizeof(inv)-1;i>=0;i--) {
  
 if(!deep_present("ZV", inv[i]))  {

   if(!deep_present("ZV_RESISTENT", inv[i]))  {

 if(interactive(inv[i]))  {   
   
   
   
   ob->move(inv[i], M_NOCHECK);
    tell_object(inv[i],
    "Du wirst voll getroffen!!!\n");
     write_file("/d/wasser/dante/zinsel/log/virus",
    ctime()+": "+inv[i]->name()+" wird infiziert.\n");
                                   }
                                 }                           
                        }
                     }
        }
    





Defend(int dam, string dtype, mixed spell, object enemy)
{

  if(enemy->id("ZJ"))  
    return ::Defend(0, dtype, spell, enemy);
  else if( interactive(enemy))
    SetProp( P_PREFERED_ENEMY, ({80,enemy}));

  return ::Defend(dam, dtype, spell, enemy);
}






