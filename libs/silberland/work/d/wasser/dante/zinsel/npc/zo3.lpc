    case 0..2 : l=10; rasse = "Drachen"; break;
    case 3..5 : l=8; rasse = "Giganten"; break;
    case 6..8 : l=9; rasse = "Titanen"; break;
    case 9..11 : l=6; rasse = "Monster"; break;
    case 12..14: l=4; rasse= "Shogotten"; break;
    case 15..17: l=8; rasse= "Tireks"; break;
    case 18..20: l=7; rasse = "Balrog"; break;
    case 21..24: l=7; rasse = "Zolom"; break;
    case 25..27: l=6; rasse = "Riesen"; break;
    case 28..29: l=7; rasse= "Kraken"; break;
  }

SetProp(P_SIZE, 300+random(100)+l*50 );

  SetProp(P_SHORT, "Ein abscheulicher "+ rasse+ "zombie");
  SetProp(P_LONG, BS(
"Dieser Zombie ist das schlimmste was Du bisher hier gesehen hast. "
"Er ist "+QP(P_SIZE)+" Zentimeter gross und voellig verfault. Du hast "
"ein ausgewachsenens Exemplar eines "+rasse+"zombies vor Dir! "
"Einst waer er ein besonders gefaehrliches Unwesen dieser Welt, "
"nun ist er die mutierte, untote Version davon..."));
AddClass(CL_ZOMBIE);
 
 SetProp(P_NAME, ({
 	""+rasse+"zombie",
 	""+rasse+"zombies",
 	""+rasse+"zombie",
 	""+rasse+"zombie"}));
 	SP(P_NAME_ADJ, ({"abscheulich"}));
 	
  SetProp(P_GENDER, MALE);
  AddId(({ LOWER(rasse), "zombie", ""+LOWER(rasse)+"zombie"}));
 
  create_default_npc(25);


  SetProp(P_HANDS, ({" mit verfaulten "+ rasse +"krallen",400,({DT_TERROR, DT_RIP})}));
  SetProp(P_BODY, 100+l*5);
  SetProp(P_RACE, "Zombie");
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -30);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_RESISTANCE_STRENGTHS,
   ([DT_UNHOLY: -0.1,
   DT_TERROR:-0.5,DT_FIRE:0.5, DT_ACID:0.3,DT_BLUDGEON:-0.2, DT_HOLY: 0.3]));

  SetProp(P_DIE_MSG,  " zerfaellt zu ekligem Matsch.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "bruellt irgendetwas vom Tod.\n");

  SetProp(P_MSGIN, "kriecht grunzend auf Dich zu");
  SetProp(P_MSGOUT, "kriecht bruellend");
  SetProp(P_MMSGIN, "kriecht bruellend auf Dich zu");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, "/d/wasser/dante/zinsel/room/" );
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/z2");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS+
         MOV_MOVES + MOV_SPECIAL+MOV_BACKWARDS);



  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
"Der abscheuliche Zombie bruellt Dich an!"}));
  SetProp(P_SPELLRATE,50);

  AddSpell(6,450,
    "Der abscheuliche "+rasse+"zombie tritt Dir in den Bauch.\n",
    "Der abscheuliche "+rasse+"zombie tritt @WEM in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
 AddSpell(5,550,
    "Der abscheuliche "+rasse+"zombie tritt Dir ins Gesicht.\n",
    "Der abscheuliche "+rasse+"zombie tritt @WEM ins Gesicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
   AddDefaultSpell(1,300,DS_BLIND,
    "Der abscheuliche "+rasse+"zombie sticht Dir ins Auge.\n",
    "Der abscheuliche "+rasse+"zombie sticht @WEM ins Auge.\n");
  
 AddDefaultSpell(1,300,DS_POISON,
    "Der abscheuliche "+rasse+"zombie spuckt Gift nach Dir.\n",
    "Der abscheuliche "+rasse+"zombie spuckt Gift nach @WEM.\n");  


