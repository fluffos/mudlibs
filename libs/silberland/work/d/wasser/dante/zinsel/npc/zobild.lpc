inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"
#include <class.h>

void create()
{
  object money;

  if (!is_clone(TO)) return;
  ::create();



AddClass(CL_ZOMBIE);
 
 SP(P_NAME, ({
 	"Zombie","Zombies",
 	"Zombie","Zombie"}));
 
 SP(P_SHORT, "Zombie");
 	
 	
  SetProp(P_GENDER, MALE);
  AddId(({  "zombie"}));
 
  create_default_npc(15);


  SetProp(P_HANDS, ({" mit verfaulten Krallen",200,({DT_TERROR, DT_RIP})}));
  SetProp(P_BODY, 50);
  SetProp(P_RACE, "Zombie");
     SetProp(P_SIZE, 100 + random(200));
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
   ([DT_UNHOLY: -0.1,
   DT_TERROR:-0.5,DT_FIRE:0.5, DT_ACID:0.3,DT_BLUDGEON:0-5, DT_HOLY: 0.3]));

  SetProp(P_DIE_MSG,  " zerfaellt zu ekligem Matsch.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "bruellt irgendetwas vom Tod.\n");

  SetProp(P_MSGIN, "kriecht grunzend auf Dich zu");
  SetProp(P_MSGOUT, "kriecht bruellend");
  SetProp(P_MMSGIN, "kriecht bruellend auf Dich zu");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

/*
  SetProp(P_MNPC_AREA, "/d/" );
  SetProp(P_MNPC_WAIT, ({ 5, 15, 15 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/z1");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS+
         MOV_MOVES + MOV_SPECIAL+MOV_BACKWARDS);


*/

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
"Der Zombie bruellt Dich an!"}));
  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,250,
    "Der Zombie tritt Dir in den Bauch.\n",
    "Der Zombie tritt @WEM in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
 AddSpell(3,350,
    "Der Zombie tritt Dir ins Gesicht.\n",
    "Der Zombie tritt @WEM ins Gesicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );

  SUID;

    money = CLONEOB ("/obj/money");
    money->SetProp(P_AMOUNT, 500+random(200));
    money->move(ME);

  command("trage alles");


	

}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
call_out("nimm_alles", 0);
}



nimm_alles()  {
  if(present("leiche", environment(TO)))  {
  command("nimm alles aus leiche");
   command("ziehe alles an");
   } 
     }

Defend(int dam, string dtype, mixed spell, object enemy)
{

  if(enemy->id("ZJ"))  
    return ::Defend(0, dtype, spell, enemy);
  else if( interactive(enemy))
    SetProp( P_PREFERED_ENEMY, ({80,enemy}));

  return ::Defend(dam, dtype, spell, enemy);
}

