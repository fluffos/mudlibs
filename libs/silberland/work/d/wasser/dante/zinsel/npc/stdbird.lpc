//dante sl 99
//stdvogel

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"
#include <class.h>

int l;

void create()
{
  string rasse;

  if (!is_clone(TO)) return;
  ::create();

  switch (random(24))
  {
    case 0..2 : rasse = "See"; break;
    case 3..5 : rasse = "Meeres"; break;
    case 6..8 : rasse = "Eis"; break;
    case 9..11 : rasse = "Sonnen"; break;
    case 12..14: rasse= "Paradies"; break;
    case 15..17: rasse= "Zug"; break;
    case 18..20: rasse = "Totenkopf"; break;
    case 21..23: rasse= "Kaka" ; break;
  }

  SetProp(P_SHORT, "Ein "+ rasse+ "vogel");
  SetProp(P_LONG, BS(
        "Dieser Vogel ist aus der Gattung der "+rasse+"voegel. "
        "Er ist friedlich und "
        "freut sich seines Lebens, wenn er von Dir nicht getoetet wird."));


  SetProp(P_NAME, ""+rasse+"vogel");

  SetProp(P_GENDER, MALE);
  AddId(({ LOWER(rasse), "vogel",""+LOWER(rasse)+"vogel"}));

  SP(P_RACE, "Vogel");

  create_default_npc(4+random(5));

  l=TO->QueryProp(P_LEVEL);
  SetProp(P_HANDS, ({" mit seinem "+ rasse +"schnabel",l*10,({DT_RIP})}));
  SetProp(P_BODY, 10+l);
  SetProp(P_RACE, "Dantinischer Vogel");
  SetProp(P_SIZE, 10 + random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE,0);
  SP(P_WIMPY, 30);

  SetProp(P_DIE_MSG,  " stuerzt tot herab.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "macht nur: PIEPPP!!!\n");

  SetProp(P_MSGIN, "fliegt hier her");
  SetProp(P_MSGOUT, "fliegt aufgeregt");
  SetProp(P_MMSGIN, "landet vor Dir");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, "/d/wasser/dante/zinsel/room/" );
  SetProp(P_MNPC_WAIT, ({ 30+random(20), 30, 30}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/isle_01");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+ MOV_MOVES + MOV_BACKWARDS);

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Was soll der Vogel damit?!"}));
  SetProp(P_SPELLRATE,50);

  AddSpell(5,l*10,
      "Der "+rasse+"vogel hackt mit seinem Schnabel nach Dir.\n",
      "Der "+rasse+"vogel hackt mit seinem Schnabel nach @WEM.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]) );

  SetChats(10,({
        "Der "+rasse+"vogel flattert erschreckt umher.\n",
        "Der "+rasse+"vogel fieppt laut.\n",
        "Der "+rasse+"vogel singt irgendetwas.\n",
        "Der "+rasse+"vogel flattert um Dich herum.\n",
        "Der "+rasse+"vogel macht: SIIRIRRI!\n",
        "Der "+rasse+"vogel fliegt etwas hoeher.\n",
        "Der "+rasse+"vogel fliegt etwas tiefer.\n",
        "Der "+rasse+"vogel sucht Nahrung.\n"}));
}
