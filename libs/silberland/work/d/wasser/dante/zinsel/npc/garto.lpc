

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"



_query_poison(){ return 0;}

void create()
{


  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Garto Gnadenstoss");
  SetProp(P_LONG, BS(
        "Garto Gnadenstoss war frueher einmal ein sehr aktiver Zombiejaeger, nun ist er aber "
        "schon lange hier der Waechter. Er spricht nicht gerne ueber Zombies. Garto hat den "
        "hoechsten aller Raenge der Bruderschaft der Zombiejaeger: Er ist Obererzzombieschlaechter! "
        "Diesen Rang kann man nur verliehen bekommen fuer besondere Dienste und Tapferkeit! "
        "Normalerweise gibt es nur 10 Raenge. Garto hat den Rang 11!!!"));

  SetProp(P_NAME,"Garto Gnadenstoss");
  SetProp(P_GENDER, MALE);

  AddId(({"ZJ","gnadenstoss","zombiejaeger","jaeger","garto gnadenstoss","garto",
        "Keulenmeister"}));

  set_living_name("garto");
  SetProp(P_LOG_INFO, "dante/zombiejaeger");
  SP(P_RACE, "Zombiejaeger");

  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinem Zombiejaegerangriff geschickt",
        400+random(100),DT_SLASH}));
  SetProp(P_BODY, 200);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: 0.6, DT_TERROR:1.0,
    DT_BLUDGEON:-1.0, DT_MAGIC:-0.5, DT_WATER: 0.4, DT_COLD: -0.5 ]));

  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 3);
  SetProp(P_NOCORPSE, 0);

  SetProp(P_MSGIN, "kommt froehlich herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "sagt: ACHTUNG!!!");
  SetProp(P_MMSGOUT, "geht");

  SetProp(P_MURDER_MSG, "Ohne mich seid Ihr verloren!");
  SetProp(P_KILL_NAME, "Garto Gnadenstoss (Zombiejaeger)");
  SetProp(P_KILL_MSG, "Du hast Narr! Die Zombies werden uns alle vernichten!!!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));
  SP(P_DIE_MSG, " bricht in Pflichterfuellung nieder und verflucht Dich!\n");


  SetProp(P_MNPC_AREA, ("/d/wasser/dante/zinsel/room/vor"));
  SetProp(P_MNPC_FLAGS, MOV_MOVES+MOV_BACKWARDS+MOV_INDOORS);

  SetProp(P_MNPC_WAIT, ({100, 100, 100}));
  SetProp(P_MNPC_DEFAULTROOM, "d/wasser/dante/zinsel/room/vor");


  SetChats(5,({
        "Garto Gnadenstoss sagt: Tja, das Leben hier ist nicht leicht.\n",
        "Garto Gnadenstoss sagt: Frueher habe ich auch mal Zombies erschlagen!\n",
        "Garto Gnadenstoss sagt: Komm, trink noch was!\n",
        "Garto Gnadenstoss schenkt sich selbst was ein.\n",
        "Garto Gnadenstoss traeumt von alten Zeiten.\n",
        "Garto Gnadenstoss sagt: Die Spieler sind auch nicht mehr das was sie mal waren!\n",
        "Garto Gnadenstoss sagt: Memmen brauchen wir hier nicht!\n"}));

  AddInfo(({"mops","terrormops"}),
      "lacht sich krumm ueber den Terrormops!");

  SetProp(P_SPELLRATE,70);

  SUID;
  CLONEME("/d/gebirge/speedy/trollager/armour/trollruestung");
  CLONEME("/p/weapon/club/streitkolben");
  CLONEME("/p/armour/boots/lederstiefel");
  CLONEME("/d/ebene/lamuerte/wwald/obj/ogerhelm");
  if(random(2)) {
    command("zuecke streitkolben");
  }
  command("zieh alles an");




  AI(({"cristof","feuerwind"}),
      "Das ist der beruehmte Jaeger der Zombies!",
      "sagt: ");
  AI(({"zombie","zombies"}),
      "Frueher habe ich sie auch gejagt.", "sagt: ");

  AI(({"drache","zombiedrache"}),
      "Hmm, der wohnt hier irgendwo.","sagt: ");

  AI("saeuredrache",
      "Der lebt im Westen", "sagt: ");

  AI(({"jona","furchtlos"}),
      "Auch ein Jaeger.", "sagt ernst: ");
  AI("dante",
      "Der hat all das hier verbrochen...!\n", "sagt: ");

  AddInfo(DEFAULT_INFO,({
        "sagt: Hmm, gute Frage!\n",
        "lacht wissend.\n",
        "grinst bloed.\n",
        "sagt leise: Huete Dich vor Dantes boesem Ich!\n",
        "sagt: Bedenke, Du bist nur ein Wurm!\n",
        }));


  AddSpell(4,250,
      "Garto Gnadenstoss greift Dich mit einem grossen Feuerball an.\n",
      "Garto Gnadenstoss greift @WEN mit einem grossen Feuerball an.\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]));


  AddSpell(2,300,
      "Garto Gnadenstoss schlaegt Dir ins Gesicht.\n",
      "Garto Gnadenstoss schlaegt @WEM ins Gesicht.\n",
      DT_SLASH, ([SP_SHOW_DAMAGE:1]));

}

void init() {
  ::init();
  if(interactive(TP)) {
    call_out("tag", 0); return; }

  if(!interactive(TP))  {
    if(TP->id("zombie"))  {
      Kill(TP);
      tell_room(environment(TO), BS(
            "Garto stuerzt sich voller Wut auf "+TP->name(WEN)+"!"));
    }		
  }
}


void tag(){

  if(environment(TP)!=environment(TO))  return ;
  command("emote sagt: "+CAP_TPN+", wie hast Du Dich zu uns verirrt?! Hallo!\n");}




int Defend(int dam, mixed dtype, mixed spell, object enemy)
{

  if(enemy->id("zombie")) 
    return ::Defend(0, dtype, spell, enemy);
  else if( interactive(enemy))
    SetProp( P_PREFERED_ENEMY, ({80,enemy}));

  return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  domainshout(
      "Garto Gnadenstoss bruellt: Danke fuer die "+lostexp+" Eps, "+CAP(getuid(TP))+"!\n");

  write_file("/d/wasser/dante/zinsel/log/jaeger",
      ctime()+":  Garto hat "+CAP(getuid(PL))+" umgebracht.\n");
}



void die(int arg)
{
  write_file("/d/wasser/dante/zinsel/log/jaeger",
      ctime()+":  Garto wurde von "+CAP(getuid(PL))+" umgebracht.\n");

  ::die(arg);
}



