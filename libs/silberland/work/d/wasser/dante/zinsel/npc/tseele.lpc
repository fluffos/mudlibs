
/*

   das geruest fuer die seele teufel usw


*/


inherit "std/mnpc";      
inherit "std/npc/spells";      
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>
#include <class.h>


create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddClass(CL_UNDEAD);
  SetProp (P_GENDER, MALE);
  AddId (({"seele", "teufelsseele"}));
  create_default_npc(10);//eh egal

  SetProp(P_MSGIN, "schwebt boesartig grinsend auf Dich zu");
  SetProp(P_MSGOUT, "schwebt boesartig grinsend");
  SetProp(P_MMSGIN, "faehrt direkt neben Dir aus der Hoelle herauf");
  SetProp(P_MMSGOUT, "steigt tief in die Hoelle hinab");
  SetProp (P_ALIGN, -1000);

  set_living_name("teufelsseele");  

  //SP(P_HANDS, " mit satanischer Macht", 250, DT_UNHOLY); 

  SetProp(P_KILL_NAME, "Ein gebrochener Pakt mit dem Teufel");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
  SP(P_DIE_MSG, " faehrt fluchend ind die Hoelle zurueck!\n");

  SP(P_SPELLRATE, 60);

  AddDefaultSpell(1,200, DS_DISARM,
      "Die teuflische Seele versucht Dich zu entwaffnen!\n",
      "Die teuflische Seele versucht @WEN zu entwaffnen!\n");

  AddDefaultSpell(1,200, DS_FEAR,
      "Die teuflische Seele versucht Dich einzuschuechtern!\n",
      "Die teuflische Seele versucht @WEN einzuschuechtern!\n");

  AddDefaultSpell(1,200, DS_BLIND,
      "Die teuflische Seele versucht Dich zu blenden!\n",
      "Die teuflische Seele versucht @WEN zu blenden!\n",
      5);

  AddDefaultSpell(1,200, DS_POISON,
      "Die teuflische Seele versucht Dich zu vergiften!\n",
      "Die teuflische Seele versucht @WEN zu vergiften!\n",
      1);


  AddSpell(2,400,
      "Die teuflische Seele blickt Dich satanisch an!\n",
      "Die teuflische Seele blickt @WEN satanisch an!\n",
      DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
      "Die teuflische Seele versucht Dich zu entzuenden!\n",
      "Die teuflische Seele versucht @WEN zu entzuenden!\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]));



}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  call_out("remove", 0);
}
