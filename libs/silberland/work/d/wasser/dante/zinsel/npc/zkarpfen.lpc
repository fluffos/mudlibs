//dante sl 99

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>

#include "/players/dante/myowndefine.h"
#define QN QueryProp(P_NAME)
#define QL QueryProp(P_LEVEL)


#include <class.h>

void create()
{
  int x, y;
  string *wie, *was;

  if (!is_clone(TO)) return;
  ::create();

  AddClass(CL_ZOMBIE);

  wie=({
      "jung", "kurz", "duenn", "dick", "haesslich", "lang", "boesartig", 
      "geheimnissvoll", "alt", "riesig", "gewaltig", "gigantisch", "bombastisch"});

  was=({
      "verwest","weiss","blutrot","gelb","gruen","giftgruen","blaugruen",
      "grellblau", "schwarz","nachtschwarz","eklig",
      "dantinisch","angroxmaessig"});


  x=random(sizeof(wie));
  y=random(sizeof(was));
  SP(P_SHORT, "Ein "+wie[x]+"er, "+was[y]+"er Zombiekarpfen");

  SetProp(P_LONG, BS(
        "Dieser Zombiekarpfen ist ein "+wie[x]+"es, "+was[y]+"es "
        "Unwesen dieser Region. Er schwimmt hier herum und wirkt bedrohlich."
        "Irgendwie beunruhigt er Dich...,irgendwie ist er viel zu gross fuer einen Kaprfen..."));


  SetProp(P_NAME,"Zombiekarpfen");
  SetProp(P_NAME_ADJ, ({wie[x], was[y]}) );

  SetProp(P_RACE, "Fisch");
  SetProp(P_GENDER, MALE);
  AddId(({"zombie","karpfen","zombiekarpfen"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(10+x/2+y/2);
  SetProp(P_HANDS, ({" mit seinen Giftzaehnen",
        150+QueryProp(P_LEVEL)*7,DT_POISON}));
  SetProp(P_BODY, 10+QueryProp(P_LEVEL)*5);
  SetProp(P_SIZE, 50+QueryProp(P_LEVEL)*20);
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 2);//flossen ?=??
  SetProp( P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: 0.3, DT_UNHOLY:-1.0, DT_TERROR:-1.0,
        DT_ACID:-0.5, DT_FIRE:0.6, DT_POISON:-0.7,DT_BLUDGEON:0.8]));

  SetProp(P_HEAL, -QueryProp(P_LEVEL));
  SetProp(P_AGGRESSIVE, 0.05);
  SetProp(P_WIMPY, 100);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "schwimmt zischend herein");
  SetProp(P_MSGOUT, "schwimmt zischend");
  SetProp(P_MMSGIN, "taucht ploetzlich aus dem Nichts auf");
  SetProp(P_MMSGOUT, "verschwindet zischend");

  SetProp(P_MNPC_AREA, ("/d/wasser/dante/zinsel/room/saeure"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+
      MOV_BACKWARDS+ MOV_INFIGHT+MOV_INDOORS );

  SetProp(P_MNPC_WAIT, ({10, 5, 10}));
  SetProp(P_MNPC_DEFAULTROOM,
      "d/wasser/dante/zinsel/room/saeure3");
  SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
  SetProp(P_KILL_NAME, "Ein Zombiekarpfen");
  SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt!");

  SetProp(P_SPELLRATE, QueryProp(P_LEVEL)*4);

  AddSpell(5,130+QueryProp(P_LEVEL)*8,
      Name(WER,1) + " versucht Dich zu erwuergen.\n",
      Name(WER,1) + " versucht @WEN zu erwuergen!\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(4, 170+QueryProp(P_LEVEL)*10,
      Name(WER,1) + " schlaegt seine Zaehne in Deine Hand!\n",
      Name(WER,1) + " schlaegt seine Zaehne in Deine Hand!\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(1, 100,
      Name(WER,1) + " spuckt Dich mit giftigem Schleim an!\n",
      Name(WER,1) + " spuckt @WEN mit giftigem Schleim an!\n",
      DT_POISON, "spell_gift", ([SP_SHOW_DAMAGE: 1]));

  AddSpell(1, 300+QueryProp(P_LEVEL)*20,
      "Der Zombiekarpfen bekommt die Kraft eines Drachen und schlaegt auf Dich ein!\n",
      "Der Zombiekarpfen bekommt die Kraft eines Drachen und schlaegt auf @WEN ein!\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

  SetChats(5,({
        Name(WER,1) + " zischt laut.\n",
        Name(WER,1) + " faucht Dich an.\n",
        "Du fuehlst Dich sehr schlecht hier.\n",
        Name(WER,1) + " schlaengelt bedrohlich nahe zu Dir.\n",
        Name(WER,1) + " baut sich vor Dir auf.\n"}));

}


void init(){
  ::init();
  VIRUS
    if((interactive(TP)&&(TP->QueryProp(P_ALIGN)>500))) {
      TO->Kill(TP);}
}


void spell_gift(object enemy,int damage,mixed dam_type)
{
  switch(random(30))
  {
    case 0..6:
      enemy->AddPoison(1);
      break;
    case 7..8:
      enemy->AddPoison(2);
      break;
    case 9:
      enemy->AddPoison(3);
    case 10..29:
      tell_object(enemy,
          "Der Zombiekarpfen verfehlt Dich!\n");
      break;
    default: enemy->AddPoison(2);
  }
}


