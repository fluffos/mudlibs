//dante sl 99

inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>


init()  {
object defender;
  ::init();

    if (defender = present("daemon")) AddDefender(defender);


if(interactive(TP))  {
	call_out("tag", 1);  }}
	
	tag()  {
		if(environment(TP)!=environment(TO))  return;
write(BS(
"Zerfallos sagt: Hallo, "+TPN+", was fuehrt Dich hier her!"));
}
			

void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Zerfallos Zombioid");
SP(P_ARTICLE, 0);
SP(P_LONG, BS(
"Das ist Zerfallos Zombioid, der hier die Kneipe betreibt und "
"sich schon seit Jahren nicht mehr an die Oberflaeche wagt!"
" Und wenn Du in Dir anschaust, weisst Du auch warum!!! Er ist "
"voellig entstellt und mutiert. Ueberall Beulen und Schwielen!!!"
" Er litt einst am Zombievirus, hat ihn aber ueberlebt, doch "
"musste er einen hohen Preis dafuer bezahlen, wie unschwer zu sehen ist."));

AD(({"beule","beulen"}),
"Ueberall wuchern sie heraus!");
AD(({"schwielen","schwiele"}),
"Er sieht aus wie ein halber Zombie!");


SetProp(P_NAME,"Zerfallos Zombioid");

SetProp(P_GENDER, MALE);

AddId(({"NOWIMPY","zerfallos","zombioid","zerfallos zombioid"}));
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 40]));

create_default_npc(20);

SP(P_RACE, "Zombiejaeger");

SetProp(P_HANDS, ({" mit seinen Schwielenhaenden",180,({DT_RIP})}));
SetProp(P_BODY, 30+random(10));
SetProp(P_SIZE, 200);
SetProp(P_ALIGN, 500);
SP(P_HP, 1000); //haelt viel aus tut aber nix
SetProp(P_MAX_HANDS, 2);

SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,3);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "kommt herunter");
SetProp(P_MSGOUT, "geht");
SetProp(P_MMSGIN, "kommt herunter");
SetProp(P_MMSGOUT, "verschwindet ploetzlich");





SetProp(P_MURDER_MSG, "Dir wuensche Ich Eiterbeulen an den Hals!");
SetProp(P_KILL_NAME, "Zerfallos Zombioid");
SetProp(P_KILL_MSG, "Dabei wollte ich Dir doch nur helfen!");

SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));



AI("westen",
"Ich war noch nie im Westen, aber dort stuerzt ein Saeurefall tief hinab "
"in die unterste aller Unterwelten!", "sagt: ");

AI(({"oeffnung"}),
"Durch die Oeffnung gelangt man irgendwie zu einem Saeurefall!",
"sagt: ");
AI(({"saeure","saeurefall","fall"}),
"Der Saeurefall stuerzt tief hinab in die Unterwelt nach Nekropolis!",
"sagt: ");

AI(({"nekromant","nekromanten"}),
"Die Nekromanten hausen dort unten, sind aber auch regelmaessig hier. "
"Sie sind Verehrer des Todes und hassen die Paladine!", "sagt: ");
AI(({"paladin","paladine"}),
"Hmm, irgendwie sind sie allesamt fade Tunten!", "lacht: ");
AI(({"tunten","tunte"}),
"Sorry, nicht so ernst gemeint!", "sagt: ");


AI("unterwelt",
"Hier unten leben irgendwo die Nekromanten!", "sagt: ");

AI("nekropolis",
"Nekropolis ist die Totenstadt der Nekromanten!", "sagt: ");
AI(({"stadt","totenstadt"}),
"Ein wahres Meisterwerk! Besuch sie unbedingt!", "sagt: ");


AI(({"virus","viren","zombivirus"}),
"Ich litt daran, habe aber ueberlebt, aber wie...", "seufzt: ");
AI(({"getraenke","trinken","getraenk"}),
"Mach einfach <menue>!", "sagt: ");
AI(({"essen","speisen","speise"}),
"Tipp doch mal <menue>!", "sagt: ");
AI(({"antidot","dot","virenatidot"}),
"Es kann Dich vom Virus heilen! Aber nur wenn er total ausgebrochen ist!",
"sagt: ");
AI(({"zombie","zombies"}),
"Die Zombies sind alles /&%&/%!!!", "flucht: ");
AI(({"drache","zombiedrache"}),
"Der Zombiedrache lebt nicht weit von hier.", "sagt: ");
AI("insel",
"Sie ist eine verfluchte Hoelle!", "sagt: ");
AI("meer",
"Ach, ich weiss nicht mehr wie das aussieht.", "sagt: ");
AI("mystagoge",
"Der lebt im Sueden!", "sagt: ");
AI(DEFAULT_INFO, ({
	"sagt: Frag den Mystagogen!\n",
	"sagt: Hmm, geh zum Mystagogen!\n"}));
AI(({"daemon","blitzdaemon"}),
"Der soll mich beschuetzen!", "sagt: ");
AI("kneipe",
"Ja, das ist sie!", "sagt: ");
AI(({"zerfallos","zombioid"}),
"Das bin ich!", "sagt: ");
	


SetChats(3,({
"Zerfallos Zombioid sagt: Was darfs sein?!\n",
"Zerfallos Zombioid flucht ueber die Zombies!\n",
"Zerfallos Zombioid sagt: Noch was zu trinken!?\n",
"Zerfallos Zombioid sagt: Die Zombies gehoeren alle umgebracht!\n",
"Zerfallos Zombioid sagt: Der Zombiedrache ist ein &%$%%$&%!!!\n",
"Zerfallos Zombioid sagt: Tod allen Zombies!\n",
"Zerfallos Zombioid sagt: Huete Dich vor dem Virus!\n",
"Zerfallos Zombioid sagt: Kennst Du die Goetzen?!\n",
"Zerfallos Zombioid murmelt was von Rache!\n",
"Zerfallos Zombioid sagt: Geh zum Mystagogen!\n",
"Zerfallos Zombioid flucht laut!\n",
"Zerfallos Zombioid kippt ein Zombiebier!\n"}));


}

void InformDefend(object enemy)
{
  Kill(enemy);
    }
