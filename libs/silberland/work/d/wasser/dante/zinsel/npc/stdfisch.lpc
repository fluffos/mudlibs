//dante sl 99
//stdfisch

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"
#include <class.h>

int l;

void create()
{
  string rasse;

  if (!is_clone(TO)) return;
  ::create();

  switch (random(24))
  {
    case 0..2 : rasse = "Zebra"; break;
    case 3..5 : rasse = "Tiger"; break;
    case 6..8 : rasse = "Ballon"; break;
    case 9..11 : rasse = "Schwert"; break;
    case 12..14: rasse= "Panzer"; break;
    case 15..17: rasse= "Regenbogen"; break;
    case 18..20: rasse = "Hamster"; break;
    case 21..23: rasse= "Panther" ; break;
  }

  SetProp(P_SHORT, "Ein "+ rasse+ "fisch");
  SetProp(P_LONG, BS(
 "Dieser "+rasse+"fisch ist einer der harmloseren Bewohner dieses "
 "Meeres. Seine Gestalt sieht aus wie ein "+rasse+", daher wohl sein "
 "Name."));

 
 SetProp(P_NAME, ""+rasse+"fisch");
 	
  SetProp(P_GENDER, MALE);
  AddId(({ LOWER(rasse), "fisch",""+LOWER(rasse)+"fisch"}));
 
  create_default_npc(5+random(7));

l=TO->QueryProp(P_LEVEL);
  SetProp(P_HANDS, ({" mit seinen "+ rasse +"flossen",l*15,({DT_RIP})}));
  SetProp(P_BODY, 20+l);
  SetProp(P_RACE, "Fisch");
     SetProp(P_SIZE, 10 + random(200));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE,0.01);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
   ([   DT_FIRE:0.5,DT_AIR:-0.7, DT_WATER:-1.0]));

  SetProp(P_DIE_MSG,  " versinkt im Meer.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "macht nur: BLUBB BLUBB!!!\n");

  SetProp(P_MSGIN, "schwimmt hier her");
  SetProp(P_MSGOUT, "schwimmt aufgeregt");
  SetProp(P_MMSGIN, "erscheint aus der Tiefe");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
/*
  SetProp(P_MNPC_AREA, "/d/wasser/dante/zinsel/room/" );
  SetProp(P_MNPC_WAIT, ({ 5, 10, 1o }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/z1");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS+
         MOV_MOVES + MOV_SPECIAL+MOV_BACKWARDS);

*/


  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
"Der Fisch blubbt Dich an!"}));
  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,l*10,
"Der "+rasse+"fisch schlaegt mit seiner Flosse nach Dir.\n",
"Der "+rasse+"fisch schlaegt mit seiner Flosse nach @WEM.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
  

             
SetChats(10,({
	"Der "+rasse+"fisch schwimmt aufgeregt um Dich herum.\n",
	"Der "+rasse+"fisch schwimmt naeher zu Dir.\n",
	"Der "+rasse+"fisch macht PLUPP.\n",
	"Der "+rasse+"fisch erschreckt sich vor Dir.\n",
	"Der "+rasse+"fisch saugt an Deinem Fuss.\n",
	"Der "+rasse+"fisch beaeugt Dich genau.\n"}));
}