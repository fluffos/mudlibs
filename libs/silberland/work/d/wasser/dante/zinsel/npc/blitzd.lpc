//daemon by dante

inherit "/std/mnpc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>


void init()  {
  object defender;
  ::init();
  if (defender = present("zerfallos")) AddDefender(defender);

  if(TP->id("zombie") && 
      file_name(environment(TP)) == "/d/wasser/dante/zinsel/room/kneipe1" )  
  {

    call_out("weg", 1+random(2));  
  }  
}


void weg()  {
  if(!TP || environment(TO)!=environment(TP)) return;

  tell_room(environment(TO),
      BS("Der Blitzdaemon stuerzt sich auf "+TP->name(WEN)+" und wirft "+QueryPronoun(WEN)+""
        " aus der Kneipe!"));
  TP->move("/d/wasser/dante/zinsel/room/z2", M_GO,
      "bruellend aus der Kneipe raus", "fliegt",
      "wird vom Blitzdaemon hier herauf getreten");
}




void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein grellgelber Blitzdaemon");

  if (PO && file_name(PO) == "/d/wasser/dante/zinsel/room/kneipe1")
  {
    SP(P_LONG, BS(
          "Der Blitzdaemon ist ein duennes, sehr schnelles Wesen, aus dessen Augen "
          "ununterbrochen grelle Blitze hervorschiessen. Er wurde vom Mystagogen erschaffen "
          "um Zerfallos zu beschuetzen!"));

    AI(({"zerfallos", "zombioid"}),
        "Ich bewache ihn!", "sagt: ");
    AI("mystagoge",
        "Mein Erschaffer!", "sagt: ");
  }
  else
    SP(P_LONG, 
        "Der Blitzdaemon ist ein duennes, sehr schnelles Wesen, aus dessen Augen "
        "ununterbrochen grelle Blitze hervorschiessen.");

  SetProp(P_NAME,"Blitzdaemon");
  SP(P_NAME_ADJ, "grellgelb");
  SetProp(P_GENDER, MALE);
  AddId(({"daemon","blitzdaemon", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20, T_RANGE_MAX: 90]));
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen Blitzklauen",280,({DT_RIP,DT_TERROR,DT_LIGHTNING})}));
  SetProp(P_BODY, 50+random(10));
  SetProp(P_SIZE, 360+random(200));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:-1.0, DT_BLUDGEON:-0.5,
        DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:-0.6, DT_RIP:-0.7,
        DT_PIERCE:-0.3,DT_LIGHTNING:-1.0, DT_ELECTRIC:-1.0, DT_WATER:0.1]));

  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,3);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "schnellt blitzend herein");
  SetProp(P_MSGOUT, "schnellt blitzend davon");
  SetProp(P_MMSGIN, "entsteht aus einem Blitz");
  SetProp(P_MMSGOUT, "verschwindet mit einer Explosion");
  SetProp(P_DIE_MSG, " verschwindet in der Dunkelheit!\n");

  SetProp(P_MURDER_MSG, "Deine Seele ist mein, elender Sterblicher!!!");
  SetProp(P_KILL_NAME, "Ein Blitzdaemon");
  SetProp(P_KILL_MSG, "bruellt: Ihr elenden Sterblichen, Eure Tage sind gezaehlt");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



  SetProp(P_SPELLRATE,60);


  AddSpell(4,200,
      "Der Blitzdaemon schleudert einen Blitz nach Dir.\n",
      "Der Blitzdaemon schleudert einen Blitz nach @WEM.\n",
      DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 300,
      "Der Blitzdaemon entfacht Funken ueber Dir!\n",
      "Der Blitzdaemon entfacht Funken ueber @WEM!\n",
      DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(1, 500,
      "Der Blitzdaemon schleudert einen Blitz in Deine Augen!\n",
      "Der Blitzdaemon schleudert einen Blitz in @WESSEN Augen!\n",
      ({DT_LIGHTNING, DT_LIGHT}), ([SP_SHOW_DAMAGE: 1]));

  SetChats(3,({
        "Der Blitzdaemon stiert Dich an.\n",
        "Der Blitzdaemon bruellt Dich an.\n",
        "Du fuehlst Dich sehr schlecht hier neben dem Blitzdaemon.\n",
        "Der Blitzdaemon blitzt.\n",
        "Der Blitzdaemon grinst Dich boesartig an!\n",
        "Der Blitzdaemon zuckt wild umher.\n",
        "Der Blitzdaemon schleudert einen Blitz knapp an Dir vorbei.\n",
        "Der Blitzdaemon lacht Dich aus!\n"}));

}

int Defend(int dam, mixed dtype, mixed spell, object enemy)
{
  if (!pointerp(dtype))
    dtype = ({ dtype });


  if (sizeof(dtype & ({ DT_TERROR }) ))
  {

    tell_room(environment(),
        "Der Blitzdaemon lacht Dich aus!!!\n");
    heal_self(dam);
    return ::Defend(0, dtype, spell, enemy);

  }

  if (sizeof(dtype & ({ DT_LIGHTNING }) ))
  {
    tell_object(enemy,
        "Der Blitzdaemon staerkt sich durch Deinen dummen Angriff.\n"
        "Grelle Blitze schiessen aus dem Daemon direkt auf Dich zu!!!\n");

    enemy->Defend(200+random(100), DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));
    tell_room(environment(TO),
        ""+enemy->name()+" wird von einem grellen Blitz getroffen!\n", ({enemy}));
    heal_self(1000);

    return ::Defend(0, dtype, spell, enemy);
  }

  return ::Defend(dam, dtype, spell, enemy);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

