    return ;  
  }               


  write(BS(
        "Der Mystagoge schreitet zur Statue und beginnt wild zu gestikulieren. "
        "Der Boden beginnt leicht zu vibrieren und dann leert er die "
        "Tropfen in die Muender der Statue worauf Du ploetzlich "
        "lautes Gebruell hoerst. Woher es kommt, kann man nur sehr schwer sagen. "
        "Es klingt als wuerden 1000 Zombies kreichen und Toben! "
        "Dann blickt er Dich an und Dir wird mulmig zu Mute!")); 

  tell_room(environment(TP),BS(
        "Der Mystagoge schreitet zur Statue und beginnt wild zu gestikulieren. "
        "Der Boden beginnt leicht zu vibrieren und dann leert er die "
        "Tropfen in die Muender der Statue worauf Du ploetzlich "
        "lautes Gebruell hoerst. Woher es kommt, kann man nur sehr schwer sagen. "
        "Es klingt als wuerden 1000 Zombies kreichen und Toben! "
        "Dann blickt er "+TP->name(WEN)+" an und "+TP->name(WEM)+" wird mulmig zu Mute!"), 
      ({TP}));

  call_out("alle_einmal2", TIME);

}



alle_einmal2()  {
