  {

    case 0..50:
      ai_wert=8;
      break;

    case 51..75:
      ai_wert=10;
      break;

    case 76..86:
      ai_wert=13;
      break;      

    case 87..96:
      ai_wert=16;
      break;

    case 97..99:
      ai_wert=19;
      break;
    default: ai_wert=8;

  }            





  amulett->SetStdServices(
      ai_wert+random(3),ai_wert+random(3),ai_wert+random(3),
      ai_wert+random(3),ai_wert+random(3),ai_wert+random(3) );


  write_file("/d/wasser/dante/zinsel/log/alle_immer",
      ctime()+": "+CAP(getuid(TP))+" alle_immer "+ai_wert+" + random(3) \n");

}

//ende der dauerkompletterhoehung



//beginn der einzelerhoehung
int fun_einzelerhoehung(string element) 
{

  object amulett, tropfen;

  NF(BSA("Welches Element?! Feuer, Wasser, Humus, Eis, Luft, Erz?!",
        "Der Mystagoge sagt: "));


  if(find_call_out("einzel_einmal1")!=-1)  {
    STOP  }
  if(find_call_out("einzel_einmal2")!=-1)  {
    STOP  }

  if(find_call_out("alle_einmal1")!=-1)  {
    STOP  }
  if(find_call_out("alle_einmal2")!=-1)  {
    STOP  }

  if(find_call_out("einzel_immer1")!=-1)  {
    STOP  }
  if(find_call_out("einzel_immer2")!=-1)  {
    STOP  }

  if(find_call_out("alle_immer1")!=-1)  {
    STOP  }
  if(find_call_out("alle_immer2")!=-1)  {
    STOP  }



  if(find_call_out("mys1")!=-1)  {
    STOP  }
  if(find_call_out("mys2")!=-1)  {
    STOP  }
  if(find_call_out("mys3")!=-1)  {
    STOP  }
  if(find_call_out("mys4")!=-1)  {
    STOP  }
  if(find_call_out("mys5")!=-1)  {
    STOP  }
  if(find_call_out("mys6")!=-1)  {
    STOP  }	



  if(!element)  { return 0;  }

  if( element!="feuer"&&element!="wasser"&&element!="humus"&&
      element!="eis"&&element!="luft"&&element!="erz" )
  {
    return 0;
  }

  if(!TP->QP(P_GUILD, "druidenzirkel")) 
  {
    write(BSA(
          "Aber "+TPN+", Du bist doch kein Druide!",
          "Der Mystagoge sagt: "));
    return 1;  
  }

  amulett=present("\ndruidenamulett", TP);    


  if(!amulett)  
  {
    write(BSA(
          "Du hast kein Druidenamulett "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return 1;  
  }                  


  if(!amulett->QueryWorn() )
  {
    write(BSA(
          "Du hast Dein Druidenamulett nicht angezogen "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return 1;  
  }               

  tropfen=deep_present("zombiegoetzenblutstropfen", TP);

  if(!tropfen) 
  {
    write(BSA(
          "Du hast ja gar keine Zombiegoetzentropfen "+TPN+"! Ich kann Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return 1;  
  }

  if(tropfen->QP(P_AMOUNT) < EINZEL_EINMAL ) 
  {
    write(BSA(
          "Du hast ja nur "+tropfen->QP(P_AMOUNT)+" Zombiegoetzentropfen "+TPN+"! "
          "Du brauchst aber "+EINZEL_EINMAL+" Tropfen! Tut mir leid!",
          "Der Mystagoge sagt: "));
    return 1;  
  }	    



  tropfen->AddAmount(-EINZEL_EINMAL);

  write("Der Mystagoge nimmt Dir "+EINZEL_EINMAL+" Blutstropfen weg.\n");

  if(!random(300))  {
    write(BSA(
          "Verflucht! Nun sind mir die Tropfen doch glatt auf den Boden gefallen! "
          "Sie sind fuer immer verloren! Tut mir leid "+TPN+"! So etwas kann "
          "dem allerbesten Magier passieren!",
          "Der Mystagoge sagt: "));
    return 1;  }


    write(BSA(
          "Nun an "+TPN+". Ich werde mein bestes versuchen! Ich versuche nun die "
          "boese Magie der Goetzen in gute umzuwandeln und damit die Energie "
          "Deines Druidenamuletts zu erhoehen!",
          "Der Mystagoge sagt: "));

    tell_room(environment(TP),BSA(
          "Nun an "+TPN+". Ich werde mein bestes versuchen! Ich versuche nun die "
          "boese Magie der Goetzen in gute umzuwandeln und damit die Energie "
          "Deines Druidenamuletts zu erhoehen!",
          "Der Mystagoge sagt: "), ({TP}));


    call_out("einzel_einmal1", TIME, element);

    return 1;  

}  


einzel_einmal1(string element)  {
  object amulett;
  WARNUNG

    amulett=present("\ndruidenamulett", TP);    


  if(!amulett)  
  {
    write(BSA(
          "Du hast kein Druidenamulett "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return ;  
  }                  


  if(!amulett->QueryWorn() )
  {
    write(BSA(
          "Du hast Dein Druidenamulett nicht angezogen "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return ;  
  }               


  write(BS(
        "Der Mystagoge schuettet die Tropfen in einen der Muender der Statue. "
        "Es beginnt augenblicklich zu surren und Dampf kommt aus dem Mund! "
        "Blitze surren um den Kopf der Statue."));


  tell_room(environment(TP),BS(
        "Der Mystagoge schuettet die Tropfen in einen der Muender der Statue. "
        "Es beginnt augenblicklich zu surren und Dampf kommt aus dem Mund! "
        "Blitze surren um den Kopf der Statue."), ({TP}));

  call_out("einzel_einmal2", TIME, element);

}



einzel_einmal2(string element)  {
  object amulett;
  WARNUNG

    amulett=present("\ndruidenamulett", TP);    


  if(!amulett)  
  {
    write(BSA(
          "Du hast kein Druidenamulett "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return ;  
  }                  


  if(!amulett->QueryWorn() )
  {
    write(BSA(
          "Du hast Dein Druidenamulett nicht angezogen "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return ;  
  }               

  write(BS(
        "Der Mystagoge murmelt nun magische Formeln, die Statue scheint zu "
        "pulsieren und ploetzlich schiesst ein starker "+CAP(element)+"strahl aus "
        "den Augen des Mystagogen auf Dich zu und trifft Dich mit voller Wucht! "
        "Benommen taumelst Du umher und scheinst aber zu merken, dass die "
        "Energie Deines Druidenamuletts bezueglich des Elementes "+CAP(element)+" "
        "erhoeht worden ist."));


  tell_room(environment(TP),BS(
        "Der Mystagoge murmelt nun magische Formeln, die Statue scheint zu "
        "pulsieren und ploetzlich schiesst ein starker "+CAP(element)+"strahl aus "
        "den Augen des Mystagogen auf "+TP->name(WEN)+" zu und trifft "
        ""+TP->QueryPronoun(WEN)+" mit voller Wucht! "
        "Benommen taumelt "+TP->name(WER)+" umher. "
        "Die Energie "+TP->QueryPossPronoun(NEUTER, WESSEN, SINGULAR)+" Druidenamuletts "
        "bezueglich des Elementes "+CAP(element)+" "
        "scheint aber erhoeht worden zu sein."), ({TP}));




  switch(random(100)) 
    //dazu kommt immer noch ein random (3)      
  {

    case 0..50:
      ee_wert=8;
      break;

    case 51..75:
      ee_wert=10;
      break;

    case 76..86:
      ee_wert=13;
      break;      

    case 87..96:
      ee_wert=16;
      break;

    case 97..99:
      ee_wert=19;
      break;
    default: ee_wert=8;


  }            






  amulett->SetService(element , ee_wert);


  write_file("/d/wasser/dante/zinsel/log/einzel_einmal",
      ctime()+": "+CAP(getuid(TP))+" element: "+element+" wert: "+ee_wert+"\n");

}

