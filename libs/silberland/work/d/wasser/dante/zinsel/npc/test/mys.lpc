  amulett->SetService(eis ,    ae_wert+random(3) );
  amulett->SetService(luft ,   ae_wert+random(3) );
  amulett->SetService(erz ,    ae_wert+random(3) );

  write_file("/d/wasser/dante/zinsel/log/alle_einmal",
      ctime()+": "+CAP(getuid(TP))+" alle_einmal. wert: "+ae_wert+": + random(3)\n");

}


