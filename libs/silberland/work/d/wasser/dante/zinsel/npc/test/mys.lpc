//beginn der master funcs

int loesche_eintrag_im_mapping() {
  MASTER->loesche_eintrag_im_mapping(getuid(TP));
  return 1;
}

int zeige_alle_daten()  {
  MASTER->zeige_alle_daten(getuid(TP));
  return 1;
}	

int ueberpruefe_ob_waffe_im_mapping()  {
  MASTER->besteht_bereits_ein_eintrag(getuid(TP));
  return 1;  
}

int erzeuge_waffe_aus_mapping()  {
  MASTER->erzeuge_waffe_und_trage_aus(getuid(TP)) ;
  return 1;  }


  int sicher_waffe(string str)  {
    notify_fail("Der Mystagoge sagt: Welche Waffe willst Du sichern lassen?\n");

    if( !str ) return 0;
    if( sscanf( str, "%s durch zombiemagie", waffe)!=1 ) return 0;

    if( !w=present( waffe, TP) )   
    {
      write(BSA(
            "Du hast doch gar kein '"+CAP(waffe)+"'! Schau genauer!",
            "Der Mystagoge sagt: "));
      return 1;
    }

    if( !w->QueryProp(P_WEAPON_TYPE) )
    {
      write(BSA(
            w->Name(WER,1)+" ist gar keine Waffe! Sieh doch genauer hin!",
            "Der Mystagoge sagt: "));
      return 1;  
    }
    tropfen=deep_present("zombiegoetzenblutstropfen", TP);

    if(!tropfen)  {

      write(BSA(
            "Du hast gar keine Blutstropfen "+TPN+"! Was soll das?!",
            "Der Mystagoge sagt: "));
      return 1;  }

      if( tropfen->QP(P_AMOUNT)<SICHER ) {
        write(BSA(
              "Du hast leider nur "+tropfen->QP(P_AMOUNT)+" Zombiegoetzenblutstropfen! "
              "Du brauchst aber mindestens "+SICHER+" dafuer.",
              "Der Mystagoge sagt: "));
        return 1; 
      }

      if(w->QP(P_AUTOLOADOBJ))  {
        write(BSA(
              "Diese Waffe ist doch sicher!",
              "Der Mystagoge sagt: "));
        return 1;  }

        if(w->id("mystagoge_save"))  {
          write(BSA(
                "Diese Waffe ist doch schon von mir gesichert worden!",
                "Der Mystagoge sagt: "));
          return 1;  }	

          if(find_call_out("mys1")!=-1)  {
            STOP  }
          if(find_call_out("mys2")!=-1)  {
            STOP  }
          if(find_call_out("mys3")!=-1)  {
            STOP  }
          if(find_call_out("mys4")!=-1)  {
            STOP  }
          if(find_call_out("mys5")!=-1)  {
            STOP  }
          if(find_call_out("mys6")!=-1)  {
            STOP  }	

          if(find_call_out("alle_einmal1")!=-1)  {
            STOP  }
          if(find_call_out("alle_einmal2")!=-1)  {
            STOP  }
          if(find_call_out("einzel_einmal1")!=-1)  {
            STOP  }
          if(find_call_out("einzel_einmal2")!=-1)  {
            STOP  }


          tropfen->AddAmount(-SICHER);

          write(BSA(
                "Nun gut "+TPN+", moege die Magie der Zombiegoetzen uns gnaedig sein und "
                "uns ermoeglichen "+w->name(WEN)+" zu sichern.",
                "Der Mystagoge sagt: "));
          tell_room(environment(TO),
              "Der Mystagoge sieht "+TP->name(WEN)+" ernst an uns beginnt etwas zu murmeln.\n",
              ({TP}));

          call_out("mys1", 3, w);

          return 1;  }

          //call_outs beginn

          mys1()   {
            WARNUNG
              tell_room(environment(TO),
                  BS("Der Mystagoge nimmt ein Buch aus einem Regal und beginnt laut in einer Dir "
                    "unbekannten Sprache zu lesen. Die Statue beginnt zu pulsieren und "
                    "irgendwie scheint es, als lebe sie!"));
            call_out("mys2", TIME, w); 	}

            mys2()  {
              WARNUNG	
                tell_room(environment(TO),
                    BS("Der Mystagoge beginnt nun einzelne Blutstropfen in die "
                      "vier verschiedenen Muender der Statue zu giesen. Die Statue stoehnt "
                      "und flucht in einer fremden Sprache. Dir wird unheimlich zu Mute!"));
              call_out("mys3", TIME, w);		
            }


            mys3()   {
              WARNUNG
                tell_room(environment(TO),
                    BS("Der Mystagoge kniet sich vor den Altar und beginnt wie in Trance "
                      "zu murmeln. Die Statue verformt sich und die vier Gesichter "
                      "scheinen ploetzlich den Goetzen zu aehneln. Feuer und Rauch "
                      "quillt aus den vier Muendern und umhuellt den Mystagogen!!!"));	
              call_out("mys4", TIME, w);
            }

            mys4()   {
              WARNUNG
                tell_room(environment(TO),
                    BS(
                      "Blitze zucken aus den vier Gesichter auf den Mystagogen nieder. "
                      "Er scheint zu brennen, doch er rezitiert immer weiter in einer "
                      "uralten Sprache. Die Statue bebt und pulsiert nun wild. "
                      "Feuer lodert aus den Muendern. Der Hass der Goetzen scheint "
                      "sich am Mystagogen zu entladen!"));
              call_out("mys5", TIME, w);	
            }


            mys5()   {
              WARNUNG
                tell_room(environment(TO),
                    BS("WUMMMMMMMMM!!! Ein lauter Knall und ploetzlich ist alles ruhig. "
                      "Die Statue scheint nicht mehr zu leben, der Mystagoge liegt "
                      "tot am Boden. Stille. Sollte der Kult der Zombies staerker als "
                      "die Kunst des Mystagogen gewesen sein und ihn umgebracht haben?!"));
              call_out("mys6", TIME, w);	
            }


            mys6()  {


              if(environment(TO)!=environment(TP))  {
                tell_object(TP,
                    BSA("Du wolltest ja nicht hoeren! So sind Deine Blutstropfen vergeudet!",
                      "Der Mystagoge teilt Dir mit: "));    }




              write(BSA(
                    "Ich glaube, es ist vollbracht! "+w->QP(P_SHORT)+" ist nun fuer den naechsten "
                    "Weltuntergang gesichert! Nur der Zorn der teuflische Zombiegoetzen kann uns nun noch aufhalten!",
                    "Der Mystagoge sagt: "));
              tell_room(environment(TP),
                  "Der Mystagoge steht auf und spricht dann irgendetwas zu "+TP->name(WEN)+".\n",
                  ({TP}));



              write_file("/d/wasser/dante/zinsel/log/autoload",
                  ctime()+": "+CAP(getuid(TP))+" waffe: "+w->name()+"\n");


              pfad=explode(file_name(w), "#");
              waffen_file=pfad[0]; 

              sicherungszeit=time();

              MASTER->neue_waffe_im_mapping(getuid(TP), waffen_file, w , sicherungszeit);


            }





            //save fun ende alles

            //waffen verbesserungs func beginn
            //diese fun basiert auf der fun des waffenbalsams 
            //sie funzt und warum das rad zweimal erfinden


int verbessere_waffe(string str)
{
  notify_fail("Der Mystagoge sagt: Welche Waffe willst Du verbessern lassen?\n");
  if( !str ) return 0;
  if( sscanf( str, "%s durch zombiemagie", waffe)!=1 ) return 0;
  if( !w=present( waffe, TP) )   
  {
    write(BSA(
          "Du hast doch gar kein '"+CAP(waffe)+"'! Schau genauer!",
          "Der Mystagoge sagt: "));
    return 1;
  }
  if( !w->QueryProp(P_WEAPON_TYPE) )
  {
    write(BSA(
          w->Name(WER,1)+" ist gar keine Waffe! Sieh doch genauer hin!",
          "Der Mystagoge sagt: "));
    return 1;  
  }
  tropfen=deep_present("zombiegoetzenblutstropfen", TP);
  if(!tropfen)  {
    write(BSA(
          "Du hast gar keine Blutstropfen "+TPN+"! Was soll das?!",
          "Der Mystagoge sagt: "));
    return 1;  }
    if( tropfen->QP(P_AMOUNT)<VERBESSERUNG ) {
      write(BSA(
            "Du hast leider nur "+tropfen->QP(P_AMOUNT)+" Zombiegoetzenblutstropfen! "
            "Du brauchst aber mindestens "+VERBESSERUNG+" dafuer.",
            "Der Mystagoge sagt: "));
      return 1; 
    }
    tropfen->AddAmount(-VERBESSERUNG);
    write(BS("Der Mystagoge sieht Dir genau in die Augen! "
          "Dann sieht er genau auf "+w->name(WEN,1)+". Dir wird etwas schwindlig und "
          "auch warm."));
    tell_room(environment(TP),
        "Der Mystagoge fuehrt einen Zombiezauber im Auftrag von "+TPN+" durch!\n",
        ({TP}));
    wc=w->QueryProp(P_WC);
    dam=w->QueryProp(P_DAMAGED);
    fix=w->QueryProp(P_WC_FIXFACTOR);
    qd=w->QueryProp(P_QUALITY_DECAY);
    weight=w->QueryProp(P_WEIGHT);
    if( random(100) > 10 && dam) // reduziert DAMAGED   
    {
      if( (i=dam*random(100)/100+1)>dam ) i=dam;
      dam-=i;
      wc+=i;
      w->SetProp(P_DAMAGED,dam);
      w->SetProp(P_WC, wc);
      if( i != 0 )
        write(BSA(
              "Verschwindet ihr Maechte des Schadens!",
              "Der Mystagoge murmelt: "));
    }
    if( w->QueryProp("waffenbalsam")<10 )
    {
      if( random(100) > 30 && qd>0) // erhoeht QUALITY_DECAY
      {
        w->SetProp(P_QUALITY_DECAY, qd+random(20) );
        write(BSA(
              "Ihr Geister der Haerte vereinigt euch!",
              "Der Mystagoge murmelt: "));
      }
      if( random(100) > 50 ) // erhoeht WC
      {
        maxwc=MAX_WEAPON_CLASS-(w->QueryProp(P_NR_HANDS)==1?MAX_WEAPON_CLASS/3:0); 
        w->SetProp(P_WC,wc+(maxwc-wc-dam)/10);
        if( wc!=w->QueryProp(P_WC) )
          write(BSA(
                "Oh Goetzen der Schlagkraft versammelt Euch!",
                "Der Mystagoge murmelt: "));
      }
      if( random(100) > 60 ) // reduziert WEIGHT
      {
        w->SetProp(P_WEIGHT, (90+random(10))*weight/100 );
        if( weight!= w->QueryProp(P_WEIGHT) )
          write(BSA(
                "Ihr Monster der Schwerkraft seiht gnaedig!",
                "Der Mystagoge murmelt: "));
      }
      if( random(100) > 80 && fix < 0.7 ) // erhoeht WC_FIXFACTOR
      {
        w->SetProp(P_WC_FIXFACTOR, fix+0.01*((float)random(5)+1.0) );
        write(BSA(
              "Wesen der Geschicklichkeit sei barmherzig mit uns!",
              "Der Mystagoge murmelt: "));
      }
      if( random(100) > 90 ) // setzt zusaetzlichen Schadenstyp
      {
        if( stringp(dam_type=w->QueryProp(P_DAM_TYPE)) )
          dam_type=({dam_type});
        switch( random(9) )
        {
          case 0: newdam=DT_COLD; s="weissen"; break;
          case 1: newdam=DT_FIRE; s="roten"; break;
          case 2: newdam=DT_POISON; s="gruenen"; break;
          case 3: newdam=DT_ACID; s="schwarzen"; break;
          case 4: newdam=DT_LIGHTNING; s="blauen"; break;
          case 5: newdam=DT_LIGHT; s="gelben"; break;
          case 6: newdam=DT_MAGIC; s="regenbogenfarbenen"; break;
          case 7: newdam=DT_HOLY; s="hellen"; break;
          case 8: newdam=DT_UNHOLY; s="dunklen"; break;
        }

        if( member(dam_type, newdam)==-1 )
          w->SetProp(P_DAM_TYPE, dam_type+({newdam}) );
        write(BSA(
              "Zombies der "+s+" Lichtes! Erhoeret uns!",
              "Der Mystagoge murmelt: "));
      }
    }
    w->SetProp("waffenbalsam", (intp(w->QueryProp("waffenbalsam"))?
          w->QueryProp("waffenbalsam")+1:1) );

    write_file("/d/wasser/dante/zinsel/log/verbesserung",
        ctime()+": "+CAP(getuid(TP))+" verbessert "+w->name()+" \n");
    return 1;
}

//waffen verbessserungs funcs ende

//give fuer fluch mit teufel entfernen
void give_notify(object ob)
{
  object pakt;
  pakt=deep_present("TEUFEL_SEELE", TP);      
  if(ob->id("magischer trichter"))  {

    write("\n");

    if(!pakt)  {
      write(BSA(
            "Danke fuer den Trichter! Aber Du hast keinen Pakt mit dem Teufel!",
            "Der Mystagoge sagt: "));   }


    if(pakt)  {
      write(BSA(
            "Danke fuer den Trichter! Ok, ich bemuehe mich!",
            "Der Mystagoge sagt: "));
      write("\n");

      write(BS(
            "Dann nimmt der Mystagoge ein altes Buch und beginnt eine Formel zu lesen. "
            "Du verstehst ueberhaupt nichts! Dann zuckt der Mystagoge zusammen und faellt zu Boden! "
            "Du hoerst lautes Toben und Bruellen aus der Tiefe! Ein Blitz faehrt in Dich und reisst Dich herum!"
            " Der Mystagoge steht auf, hilft Dir auf die Beine und laechelt! Alles ist vorbei!"));
      pakt->remove();
      write_file("/d/wasser/dante/zinsel/log/teufel",
          ctime()+": "+CAP(getuid(PL))+" beseitigt den Pakt!!!!!!\n");             

      if(pakt)  {
        pakt->destuct();  }

    } 
  }

  else
    ::give_notify(ob);
}




Defend(int dam, string dtype, mixed spell, object enemy)
{
  if(!random(2))  {
    tell_object(enemy,
        "Der Mystagoge baut eine Schutzaura auf!\n");
    tell_object(enemy,
        "Der Mystagoge zwingt Dich Dich selbst anzugreifen!!!\n");
    enemy->Defend(200+random(100), DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));
    tell_room(environment(TO),
        ""+enemy->name()+" wird von einem grellen Blitz getroffen!\n", ({enemy}));
    return ::Defend(0, dtype, spell, enemy);
  }
  else
    return ::Defend(dam, dtype, spell, enemy);
}




die(arg)
{	domainshout(
    "\nDer Mystagoge loest sich in Luft auf. "+TPN+" hat ihn besiegt!\n");

write_file("/d/wasser/dante/zinsel/log/mysstirbt",
    ctime()+": "+CAP(getuid(PL))+" killt den Mystagogen.\n");
::die(arg);                                                                                       
}




void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/wasser/dante/zinsel/log/myskillt",
      ctime()+": Der Mystagoge hat "+CAP(getuid(PL))+" umgebracht.\n");
  call_out("nimm_alles", 0);
}     	


nimm_alles()  {
  if(present("leiche", environment(TO)))  {
    command("nimm alles aus leiche");
  } 
} 


