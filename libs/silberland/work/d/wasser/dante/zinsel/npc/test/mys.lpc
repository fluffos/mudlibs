/*

   der mystagoge auf der zinsel:
   jo was kann der:
   1. druidendienste erhoehen , werte nun auf angrox vorlage angepasst
   trotzdem wird man sie imho im laufe des spiels anpassen muessen
   kann auch auskunft ueber die anzahl der dienste geben (random)

   2. waffen verbessern, verwendet gleiche prop wie feys balsam, damit
   pls nicht ewig erhoehen koennen. aber schwieriger zu bekommen

//nicht aktiviert
3. autoload machen von waffen 1 waffe pro pls pro 1 reboot
//

4. die verkaufte seele wieder herstellen (teufel usw)






Die Erhoehungen an sich sollten eher bei random(6)+5 liegen (bei
einzelerhoehungen), bzw bei random(8)+3 bei dauerhaften diensten, wobei
dauerhafte dienste den wert 20 nicht ueberschreiten sollte. 


dante sl 99 2000 129 mal ungebaut
 */



inherit "/std/npc";
#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#include <ansi.h>

#define TIME 4+random(4)
#define LOG   "/d/wasser/dante/zinsel/save/tropfen"

//fuer die waffen!!!
#define VERBESSERUNG 10
#define SICHER       40




//das savefile des masters
#define SAVEFILE "/d/wasser/dante/zinsel/save/daten"
//wird hier nicht gebraucht, aber damit man weiss wos hinkommt


//das masterobj
#define MASTER "/d/wasser/dante/zinsel/save/master"


#define WARNUNG if(environment(TO)!=environment(TP))  {  tell_object(TP, BSA("Wenn Du meine Klause verlaesst, und ich den Kult vollendet habe, und Du dann nicht hier bist, so sind Deine Blutstropfen vergeudet gewesen! Also komm schnell zurueck!", "Der Mystagoge teilt Dir mit: "));  }
#define STOP write(BS("Du musst Dich gedulden! Der Mystagoge arbeitet gerade an einer Sache!")); return 1;


//fuer die druiden
#define EINZEL_EINMAL 10
#define EINZEL_IMMER  50
#define ALLE_EINMAL 40
#define ALLE_IMMER  100
#define DAZ_ALLE 3
#define DAZ_ELE 1

string waffe, newdam, s;
object w, tropfen;
int i,maxwc;
int wc,dam,qd,weight;
float fix;
mixed dam_type;
string waffen_file; 
string *pfad;
int sicherungszeit;


//die werte fuer die erhoehungen 

int ee_wert; //einzel einmal
int ei_wert;  //einzel immer
int ae_wert; //alle einmal 
int ai_wert; //alle immer 

string feuer, wasser, humus, eis, luft, erz;
string fi, wa, lu, hu, er,ei;


init()  {
  ::init();
  if(interactive(TP))  {
    call_out("tag", 1);  }}

    tag()  {

      if(environment(TP)!=environment(TO))  return;
      write(BS(
            "Der Mystagoge durchdringt Dich mit einem Blick und nickt Dir freundlich zu."));
    }





void create()
{
  if (!is_clone(TO)) return;


  ::create();



  SetProp(P_SHORT, "Ein uralter Mystagoge");

  SP(P_LONG, BS(
        "Der Mystagoge ist ein kleines, runzeliges Maennchen, dessen Koerper "
        "sich unter der Last vieler Jahre gebeugt hat. Doch ein Blick in "
        "seine Augen zeigen Dir, dass er mehr weiss und mehr kann als "
        "Du und Deines gleichen zusammen. Sie leuchten rot und scheinen "
        "Dich zu durchblicken. Ein Kampf mit ihm wuerde fuer Dich "
        "fatal ausgehen. Du solltest ihn ganz grundsaetzlich nach "
        "dem Zombiekult fragen, er kann Dir sicher sehr nuetzlich sein und sein "
        "grosses Wissen mit Dir teilen!"));



  AI(({"syntax","wissen"}),
      "Du solltest mich am besten nach Kult fragen, aber hier\n"
      "zur Erinnerung noch einmal die wichtigsten Syntax':\n\n"
      "Fuer das Sichern von Waffen: (Kosten: "+SICHER+" Tropfen.)\n"
      "'sichere waffe durch zombiemagie'\n"
      "'ueberpruefung'\n"
      "'erschaffung'\n"
      "'liste'\n"
      "'loeschung'\n\n"
      "Fuer das Verbessern einer Waffe: (Kosten: "+VERBESSERUNG+" Tropfen.)\n"
      "'verbessere waffe durch zombiemagie'\n\n"
      "Fuer die Erhoehung der Dienste der Druiden:\n"
      "'einzelerhoehung element' Kosten: "+EINZEL_EINMAL+" Tropfen.\n"
      "'dauereinzelerhoehung element' Kosten: "+EINZEL_IMMER+" Tropfen.\n"
      "'einzelkompletterhoehung' Kosten: "+ALLE_EINMAL+" Tropfen.\n"
      "'dauerkompletterhoehung' Kosten: "+ALLE_IMMER+" Tropfen.\n"
      "'dienstanzahl alle' Kosten: "+DAZ_ALLE+" Tropfen.\n"
      "'dienstanzahl element' Kosten: "+DAZ_ELE+" Tropfen.\n",
      "sagt: ");


  AD(({"augen","auge"}),
      "Sie leuchten unheimlich.");
  AD("koerper",
      "Er ist gebueckt und verdorrt.");

  SetProp(P_NAME,"Mystagoge");

  SetProp(P_GENDER, MALE);
  AddId(({"NOWIMPY","mystagoge","priester"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 70]));
  create_default_npc(50);
  SetProp(P_HANDS, ({" mit seinen magischen Kuensten",500,({DT_MAGIC})}));
  SetProp(P_BODY, 100);
  SetProp(P_SIZE, 120);
  SetProp(P_ALIGN, 1000);

  SetProp(P_MAX_HANDS, 2);
  SetProp( P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:-1.0, DT_BLUDGEON:0.5,
DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:-0.6, DT_RIP:-0.7,
DT_PIERCE:-0.7,DT_LIGHTNING:-1.0, DT_ELECTRIC:-1.0]));


  SetProp( P_REJECT, ({ REJECT_GIVE, "Der Mystagoge sagt: Hier nimm wieder! Danke aber!\n" }) );



  AI(({"nekromanten","paladine","paladin","nekromant","nekropolis",
        "unterwelt","saeurefall"}),
      "Der weise Mann spricht nur einmal, also hoere mir gut zu. Fetter Bauch "
      "bringt mehr Leute um als das Schwert! Ob Paladin, ob Nekromant, Tand "
      "Tand ist alles aus Magier Hand!", "sagt leise: ");


  SP(P_INFO, BS(
        "Frag ihn doch einfach nach Kult!"));

  AI(DEFAULT_INFO,({
        "laechelt nur freundlich.\n",
        "sagt: Die Zeit wird Dir helfen!\n",
        "deutet nur nach oben!\n",
        "sagt: Wer dies fragt, ist die Antwort nicht wert!\n",
        "sagt: Frag lieber Dich selbst!\n",
        "sagt: Ich habe Dante erschaffen!\n",
        "sagt: Die Welt wird untergehen!\n",
        "sagt: Nur ein Narr stellt diese Frage!\n",
        "sagt: Der Kult ist alt und so schweigt man besser!\n"}));


  AI("insel",
      "Sie wird da sein, wenn wir nicht mehr da sind.", "sagt: ");
  AI(({"kult","zombiekult"}),
      "Es gibt derer "
      "4 Goetzen, jeder ein anderer mit anderen Reichen. Die "
      "Zombies huldigen diesen Goetzen auf 4 kleinen Inseln. Dort "
      "steht jeweils ein Altar. Mit dem richtigen Wort wird einer "
      "der Goetzen erscheinen. Doch huete Dich! Sie greifen ohne "
      "Warnung an! Das Blut der Goetzen ist pure, boese Magie. Ich kann "
      "aus diesem Blut Magie herstellen. Dabei hilft mir diese Statue. "
      "Bring mir die Tropfen und frag mich dann, "
      "wenn Du sie hast nach der Statue.", "sagt: ");

  AI("statue",
      "Die Statue habe ich mir selbst erschaffen aus dem Blut der Goetzen. "
      "Es ist erstarrt und daher nicht so gefaehrlich. Mit ihrer Hilfe "
      "werde ich Dir helfen koennen, mehr und besser "
      "als es jeder irdische Magier kann. Wenn Du mehr wissen willst, "
      "so frage mich nach Hilfe.", "sagt: ");


  AI("magie",
      "In den Tropfen steckt boese, dunkle Magie, die ich mit Hilfe "
      "meiner unendlichen Weisheit und dieser Statue nuetzen kann. "
      "Ich wandle sie in alle moeglichen Formen um und kann so "
      "viel Nuetzliches erschaffen. Doch jedesmal, wenn ich das tue "
      "spiele ich ein gefaehrliches Spiel mit dem Tod.", 
      "sagt ernst: ");


  AI(({"blut","goetzenblut"}),
      "Ich benoetige mindestens 10 Tropfen, damit "
      "ich Magie erschaffen kann. Das Blut ist sehr gefaehrlich "
      "und nur ein Meister im Zombiekult kann damit umgehen. Jeder "
      "Goetze hat ein anderes Blut. Manchmal kann man es an der Farbe "
      "erkennen, doch mir ist das eigentlich egal, welche Tropfen Du "
      "hast.",
      "sagt: ");


  AI(({"farbe","farben"}),
      "Die Farben des Blutes haben boese Kraefte, doch mehr "
      "will ich dazu nicht sagen.", "sagt: ");

  AI(({"kraft","kraefte"}),
      "Die Kraefte des Blutes sind dunkel und wenn Du versuchen "
      "wuerdest hier Magie zu erschaffen waere es Dein Tod!", 
      "warnt: ");
  AI("tod",
      "Der Tod lauert hier ueberall.", "sagt: ");
  AI(({"goetze","goetzen"}),
      "Es gibt derer 4 mit unaussprechlichen Namen. Sie sind der "
      "Mittelpunkt des Kultes der Zombies!", "sagt: ");


  AI(({"zombies", "zombie"}),
      "Die Zombies sind harmlosen Kreaturen, arme Schweine. Sie sind "
      "die Sklaven der Goetzen!", "sagt: ");

  AI(({"virus","zombievirus"}),
      "Tja, eine schlimme Sache, doch es gibt 2 Moeglichkeiten ihn "
      "los zu werden. Zerfallos hat ein von mir gebrautes Antidot, "
      "und ausserdem gibt es irgendwo unter der Insel bei den Zombies "
      "einen Stachel, der eine Fluessigkeit absondert die heilend wirkt.", 
      "sagt: ");

  AI("antidot",
      "Hilft sicher, aber teuer.", "sagt: ");

  AI(({"stachel"}),
      "Hmm, nicht weit von hier.", "sagt: ");
  AI(({"fluessigkeit","fluessigkeiten"}),
      "Ich zaubere mit ihnen sehr oft.", "sagt: ");
  AI("mystagoge",
      "Es gibt sicher mehrere, aber ich kenne nur mich.","sagt: ");
  AI("dante",
      "Ehrenzombie auf Lebenszeit!", "sagt: ");




  AI("hilfe",
      "Ich kann Dir verschiedene Dienste erweisen.\n"
      "1. Du kannst mich nach Waffen fragen.\n"
      "2. Du kannst mich nach Elementar fragen.\n"
      "3. Wenn Du nur eine Uebersicht haben willst, frage mich nach 'syntax'!\n",
      "sagt: ");




  AI(({"waffe","waffen"}),
      "Nun gut, folgendes kann ich erzeugen mit meiner Magie:\n"
      "1. Ich kann Waffen so verzaubern, dass sie, sollte\n"
      "   diese Welt einmal kurzzeitig vernichtet werden,\n"
      "   Dir auch nach der Wiedererschaffung dieser Welt\n"
      "   zur Verfuegng stehen. <Anmerkung: d.h. rebootsicher>\n"
      "   Frag mich am besten nach Sicherheit.\n"
      "ACHTUNG!!! Dieses feature steht momentan nicht zur Verfuegung!!!\n\n"
      "2. Ich kann Waffen verbessern, was ihre Schlagkraft,\n"
      "   die Leichtigkeit der Handhabung, ihre Beschaedigung\n"
      "   und ihre Widerstandskraft gegen Abnuetzung betrifft.\n"
      "   Moeglicherweise wird die Waffe auch noch in punkto\n"
      "   anderer Qualitaeten verbessert, aber darueber darf\n"
      "   ich Dir leider nichts erzaehlen.\n"
      "   Frag mich am besten nach Verbesserung.\n",
      "sagt: ");

  AI(({"sicherheit","sicherung","sicher"}),
      "Gut, folgende Vorrausetzungen muessen gegeben sein. "
      "Du musst die Waffe natuerlich besitzen. Und Du musst "
      "mindestens "+SICHER+" Blutstropfen haben. Dann tippe "
      "einfach <sichere waffenname durch zombiemagie>." 
      " Achtung! Ich werde die "
      "erste Waffe nehmen die ich in Deinem Inventar finde, auf die Deine "
      "Angabe zutrifft. Ein Beispiel: 'sichere langschwert durch zombiemagie'."
      "Noch etwas ist wichtig! Solltest Du bereits eine Waffe bei mir "
      "gesichert haben, und versuchen eine zweite zu sichern, so wirst "
      "Du wahrscheinlich Deine hart erkaempften Blutstropfen verlieren, aber "
      "keine zweite Waffe sichern koennen!!! "
      "Hoer gut zu! Nachdem die Welt zerstoert und Wiedererschaffen wurde, musst "
      "Du zu mir kommen und Dir hier Deine Waffe abholen. Momentan kann ich "
      "pro Spieler nur eine Waffe ueber den Untergang der Welt hinweg retten. "
      "Frage mich am besten nach Erschaffung.",
      "sagt: ");

  AI(({"druiden","druide"}),
      "Druiden sind eine eigene Gilde, ich kann ihnen sicher gut helfen!",
      "sagt: ");

  AI("liste",
      "Mit Liste bekommst Du eine Totalaufstellung aller Spieler und aller Waffen "
      "die ich hier gesichert haben.",
      "sagt: ");


  AI("erschaffung",
      "Wenn Du eine Waffe bei mir gegen den Untergang der Welt gesichert hast, "
      "kannst Du zu mir herkommen und sie wieder bekommen. Tippe einfach "
      "'erschaffung' und wenn ich eine Waffe fuer Dich gesichert habe, so "
      "wirst Du sie hier wiederbekommen. Wenn Du wissen willst, ob Du schon eine "
      "Waffe sichern hast lassen so tippe einfach 'ueberpruefung'. So ich hoffe, "
      "Du hast das alles verstanden! Etwas noch. Mit 'liste' bekommst Du eine "
      "Aufstellung aller Spieler und ihrer gesicherten Waffen!",
      "sagt: ");

  AI("ueberpruefung",
      "Wenn Du wissen willst, ob Du schon eine "
      "Waffe sichern hast lassen so tippe einfach 'ueberpruefung'. Denn "
      "solltest Du bereits eine Waffe bei mir "
      "gesichert haben, und versuchen eine zweite zu sichern, so wirst "
      "Du wahrscheinlich Deine hart erkaempften Blutstropfen verlieren, aber "
      "keine zweite Waffe sichern koennen!!! "
      "Du kannst diese Waffe nur "+ANSI_RED+"nach"+ANSI_NORMAL+" "
      "der naechsten Zerstoerung wieder haben! Wenn Du unbedingt eine neue "
      "Waffe sichern lassen willst, so kannst Du das mit 'loeschung' machen.",
      "warnt: ");


  AI("loeschung",
      "Solltest Du bereits eine Waffe gesichert haben, aber doch noch eine andere "
      "Waffe sichern wollen, so kannst Du Deine alte Waffe mit 'loeschung' "
      "entsichern lassen und dann eine neue Waffe wieder sichern. Das kostet "
      "natuerlich wieder Blutstropfen. Also ueberlege Dir gut, was Du tust!",
      "sagt: ");



  AI("verbesserung",
      "Wenn Du eine Waffe besitzt, sie aber noch besser machen willst, "
      "dann ist das die richtige Magie fuer Dich! Wie genau die Gewichtung "
      "der Verbesserung der einzelnen Waffenquaelitaeten wirklich aussieht, darf "
      "ich Dir nicht erklaeren, und wenn ich es machen wuerde, muesste ich Dich "
      "danach sofort toeten! " 
      "Du musst um diesen Dienst in Anspruch nehmen zu koennen, mindestens "
      +VERBESSERUNG+" Blutstropfen der Zombiegoetzen haben. "
      "Also, tippe "
      "<verbessere waffenname durch zombiemangie>."
      " Achtung! Ich werde die "
      "erste Waffe nehmen die ich in Deinem Inventar finde, auf die Deine "
      "Angabe zutrifft. Ein Beispiel: 'verbessere todesaxt durch zombiemagie'.",
      "sagt: ");




  AI(({"elementar","elementare","ring","ringe"}),
      "Ich kann Dir mit meiner Magie die Anzahl der Dienste Deiner "
      "Elementare erhoehen. Du musst dazu aber einen Ring besitzen. Wo "
      "man die Ringe findet, weiss ich aber nicht. Frage mich am besten nach "
      "Dienste.",
      "sagt: "); 

  AI(({"dienst","dienste"}),
      "Gut, also erstens musst Du Druide sein, zweitens brauchst Du wie "
      "immer Blutstropfen der Zombiegoetzen. Es gibt 4 Moeglichkeiten. "
      "Frag mich nach Moeglichkeiten und dann wenn Du mehr wissen willst "
      "darueber nach den angefuehrten Stichworten.",
      "sagt: ");



  AI(({"moeglichkeiten","moeglichkeit"}),
      "Es gibt momentan folgende Moeglichkeiten:\n"
      "1. Einzelerhoehung.\n"
      "2. Kompletterhoehung.\n"
      "3. Dienstanzahl.\n",
      "sagt: ");




  AI(({"dienstanzahl","anzahl"}), 
      "Ich kann Dir sagen wieviel Dienste Dir zur Verfuegung stehen. "
      "Du kannst auswaehlen zwischen 'dienstanzahl alle', das kostet Dich "
      ""+DAZ_ALLE+" Tropfen. Dann gibt es noch 'dienstanzahl element', also "
      "zum Beispiel 'dienstanzahl feuer'. Das kostet Dich bei mir "
      ""+DAZ_ELE+" Tropfen. Ich hoffe, Du hast alles verstanden.",
      "sagt: ");



  AI(({"einzelerhoehung","einzel"}),
      "Einzelerhoehung bedeutet, dass ein Dienst Dir haeufiger "
      "zur Verfuegung steht."
      "\nBei den Einzelerhoehungen gibt es momentan:\n"
      "1. Einmalige Einzelerhoehung. Kosten: "+EINZEL_EINMAL+" Tropfen.\n"
      "2. Dauerhafte Einzelerhoehung. Kosten: "+EINZEL_IMMER+" Tropfen.\n",
      "sagt: ");


  AI(({"kompletterhoehung"}),
      "Kompletterhoehung bedeutet, dass Dir alle Dienste die Du "
      "als Druide haben kannst erhoeht werden. Das heist also, "
      "das Du jeden Deiner Dienste haeufiger verwenden kannst. "
      "\nBei den Kompletterhoehungen gibt es momentan:\n"
      "1. Einmalige Kompletterhoehung. Kosten: "+ALLE_EINMAL+" Tropfen.\n"
      "2. Dauerhafte Kompletterhoehung. Kosten: "+ALLE_IMMER+" Tropfen.\n",
      "sagt: ");


  AI(({"einmalige einzelerhoehung"}),
      "Gut, die einmalige Einzelerhoehung bedeutet, dass Du einen Dienst "
      "eine Zeitlang oefter verwenden kannst. Wenn Du Deine Erhoehung aber "
      "verbraucht hast, so steht Dir wieder nur mehr die normale Anzahl "
      "der Dienste zur Verfuegung. syntax: <einzelerhoehung element>."
      " Kosten: "+EINZEL_EINMAL+" Tropfen.",
      "sagt: ");


  AI("dauerhafte einzelerhoehung",
      "Das bedeutet, dass der von Dir erhoehte Dienste "
      "einmalig oefter zu verwenden ist. Und zwar solange bos die Welt untergeht. "
      "Wenn die Welt wieder erschaffen wurde, steht Dir wieder nur mehr die normale Anzahl "
      "dieses Dienstes zur Verfuegung. syntax: <dauereinzelerhoehung element>."
      " Kosten: "+ALLE_IMMER+" Tropfen.",
      "sagt: ");


  AI(({"einmalige kompletterhoehung"}),
      "Gut, die einmalige Kompletterhoehung bedeutet, dass Du Deine Dienste "
      "einmalig oefter verwenden kannst. Also einmal mehr Dienste, und zwar alle "
      "zur Verfuegung hast. "
      "Wenn Du Deine Dienste aber verbraucht hast, steht Dir nur mehr die normale "
      "Anzahl "
      "dieser Dienste zur Verfuegung. syntax: <einzelkompletterhoehung>."
      " Kosten: "+ALLE_EINMAL+" Tropfen.",
      "sagt: ");

  AI("dauerhafte kompletterhoehung",
      "Das bedeutet, dass alle Dir zur Verfuegung stehenden Dienste bis "
      "zum naechsten Weltuntergang erhoeht zur Verfuegung stehen. "
      "Wenn die Welt wieder erschaffen wurde, steht Dir wieder nur mehr die normale Anzahl "
      "dieser Dienste zur Verfuegung. syntax: <dauerkompletterhoehung>."
      " Kosten: "+ALLE_IMMER+" Tropfen.",
      "sagt: ");

  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 50);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "entsteht aus einer Wolke");
  SetProp(P_MSGOUT, "gleitet auf einer Wolke");
  SetProp(P_MMSGIN, "taucht ploetzlich aus einer Wolke auf");
  SetProp(P_MMSGOUT, "verschwindet im Boden");
  SP(P_NOCORPSE, 1);
  SP(P_DIE_MSG, "verfluessigt sich und ist auf einmal weg!\n");
  SetProp(P_KILL_MSG, "Warum musstest Du mich auch provozieren!!!");
  SetProp(P_KILL_NAME, "Ein uralter Mystagoge und seine Kunst");
  SetProp(P_MURDER_MSG, "Wie konnten meine Kuenste nur so versagen?! Dante?!!?");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

  SetChats(1,({
        "Der Mystagoge sagt: Je dunkler der Kult, desto groesser die Macht!\n",
        "Der Mystagoge sagt: 1000 Jahre lebe ich schon hier.\n",
        "Der Mystagoge schuettelt eine dunkle Flasche.\n",
        "Der Mystagoge sucht ein altes Buch!\n",
        "Der Mystagoge sagt: Kennst Du die Goetzen?!\n",
        "Der Mystagoge sagt: Der Kult ist uralt!\n",
        "Der Mystagoge mischt 3 Fluessigkeiten miteinander.\n",
        "Der Mystagoge murmelt eine Formel und flucht dann.\n",
        "Der Mystagoge kontrolliert den Altar.\n",
        "Der Mystagoge versinkt in Trance.\n",
        "Der Mystagoge meditiert.\n",
        "Der Mystagoge betet am Altar.\n",
        "Der Mystagoge durchdringt Dich mit seinen Blicken.\n",
        "Der Mystagoge warnt Dich vor dem Zombievirus.\n"}));

  AI(({"zerfallos","daemon","blitzdaemon","zombioid"}),
      "Tja, Zerfallos betreibt die Kneipe im Norden. Der Daemon bewacht "
      "ihn vor den Zombies!", "sagt: ");
  AI("kneipe",
      "Naja, kennst Du doch, die von Zerfallos!", "sagt: ");
  AI("altar",
      "Den Altar brauche ich um zu zaubern.", "sagt: ");
  AI("klause",
      "Hier lebe, meditiere und zaubere ich!", "sagt: ");
  AI("teufel",
      "Der Teufel, besser gesagt eine Form von ihm, wohnt hier irgendwo an einem "
      "Ort namens Inferno. Man einer ging einen Pakt mit ihm ein!!!", "sagt: ");
  AI(({"inferno","pakt"}),
      "Im Inferno kannst Du dem Teufel Deine Seele verkaufen! Wenn Du schon einen "
      "Pakt mit dem Teufel hast, und diesen beenden willst, so kann nur ich Dir helfen! "
      "Aber ich will als Gegenleistung einen magischen Trichter haben!!! Den gibt es hier auf der Insel irgendwo!!! "
      "Komm einfach her und gib ihn mir!", "sagt: ");
  AI("trichter",
      "Ich glaube, der Trichter ist nicht an Land! Was immer das heisst!!! So genug verraten!",
      "sagt: ");

  //cmds fuer waffen
  /* ACD( "erschaffung", "erzeuge_waffe_aus_mapping");
     ACD( "ueberpruefung", "ueberpruefe_ob_waffe_im_mapping");

     ACD(({"sichere","sicher"}), "sicher_waffe");
     ACD("liste", "zeige_alle_daten");
     ACD("loeschung", "loesche_eintrag_im_mapping");
   */
  // cmds fuer druiden
  ACD(({"verbesser","verbessere"}), "verbessere_waffe");

  //<einzelerhoehung element>."
  ACD("einzelerhoehung", "fun_einzelerhoehung");

  //<einzelkompletterhoehung>."
  ACD("einzelkompletterhoehung", "fun_einzelkompletterhoehung");

  //<dauerkompletterhoehung>."
  ACD("dauerkompletterhoehung", "fun_dauerkompletterhoehung");

  //dauereinzelerhoehung element>."
  ACD("dauereinzelerhoehung", "fun_dauereinzelerhoehung");



  ACD("dienstanzahl", "check_dienst_anzahl");
  //erklaert sich eh selbst


}
//beginn der druiden funcs




int check_dienst_anzahl(string str)  

{
  object tropfen, amulett;
  int feuer_z, wasser_z, eis_z, luft_z, humus_z, erz_z, zahl;


  NF(BSA(
        "Du musst schon genauer sagen was Du ueber die Dienstanzahl wissen willst.",
        "Der Mystagoge sagt: "));


  if(!str) return 0;


  if(
      str!="alle" && str!="feuer" && str!="wasser"&&str!="eis"&&
      str!="humus"&& str!="erz"   && str!="luft" )

  {
    write(BSA(
          "Hmm, tut mir leid, aber mit '"+str+"' kann ich hier wenig anfangen. "
          "Du kannst mich aber nach 'alle, feuer, eis, wasser, erz, humus, luft'"
          " fragen!",
          "Der Mystagoge sagt: "));
    return 1;
  }       	


  tropfen=present("zombiegoetzenblutstropfen", TP);


  if(!tropfen)   
  {
    write(BSA(
          "Du hast leider keine Blutstropfen bei Dir!",
          "Der Mystagoge sagt: "));
    return 1;
  }


  if(!TP->QP(P_GUILD, "druidenzirkel")) 
  {
    write(BSA(
          "Aber "+TPN+", Du bist doch kein Druide!",
          "Der Mystagoge sagt: "));
    return 1;  
  }

  amulett=present("\ndruidenamulett", TP);    


  if(!amulett)  
  {
    write(BSA(
          "Du hast kein Druidenamulett "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return 1;  
  }                  


  if(!amulett->QueryWorn() )
  {
    write(BSA(
          "Du hast Dein Druidenamulett nicht angezogen "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return 1;  
  }               


  if(str=="alle")        { 



    if(tropfen->QP(P_AMOUNT) < DAZ_ALLE ) 
    {
      write(BSA(
            "Du hast ja nur "+tropfen->QP(P_AMOUNT)+" Zombiegoetzentropfen "+TPN+"! "
            "Du brauchst aber "+DAZ_ALLE+" Tropfen! Tut mir leid!",
            "Der Mystagoge sagt: "));
      return 1;  
    }	    



    tropfen->AddAmount(-DAZ_ALLE);

    write("Der Mystagoge nimmt Dir "+DAZ_ALLE+" Blutstropfen weg.\n");

    if(!random(300))  {
      write(BSA(
            "Verflucht! Nun sind mir die Tropfen doch glatt auf den Boden gefallen! "
            "Sie sind fuer immer verloren! Tut mir leid "+TPN+"! So etwas kann "
            "dem allerbesten Magier passieren!",
            "Der Mystagoge sagt: "));
      return 1;  }

      /*

         Mittels amulet->QueryService(element) kannst du abfragen, wie hoch der Dienst
         aktuell ist, und mit QueryStdService bekommst du ein array in der form:
         ({ ([feuer: 10, ...]), ([feuer: 7, ...]) }), wobei ersteres mapping die Werte
         --mehr--(74%) ANFANG 
         anzeigt, auf die bei einem Reset zurueckgesetzt wird (Dauerhafte Erhoehung),
         das zweite Mapping die aktuellen Werte.
       */



      write("\nDer Mystagoge leert die Tropfen in einen der Muender der Statue und "
          "beginnt wild zu gestikulieren. Dann blickt er Dir genau ins Herz.\n");
      write("Der Mystagoge sagt: Nun gut, "+TPN+"! Hier das Ergebnis:\n");

      feuer_z=amulett->QueryService(feuer)+1-random(3); // +/-1
      wasser_z=amulett->QueryService(wasser)+1-random(3); // +/-1
      eis_z=amulett->QueryService(eis)+1-random(3); // +/-1
      erz_z=amulett->QueryService(erz)+1-random(3); // +/-1
      luft_z=amulett->QueryService(luft)+1-random(3); // +/-1
      humus_z=amulett->QueryService(humus)+1-random(3); // +/-1

      if(luft_z  < 0 ) { luft_z=0; }
      if(feuer_z  < 0 ) { feuer_z=0; }	 
      if(eis_z  < 0 ) { eis_z=0; }
      if(erz_z  < 0 ) { erz_z=0; }
      if(wasser_z  < 0 ) { wasser_z=0; }
      if(humus_z < 0 ) { humus_z=0; }


      write(
          "Feuer : "+feuer_z+" Dienst(e).\n"
          "Wasser: "+wasser_z+" Dienst(e).\n"
          "Eis   : "+eis_z+" Dienst(e).\n"
          "Humus : "+humus+" Dienst(e).\n"
          "Erz   : "+erz_z+" Dienst(e).\n"
          "Luft  : "+luft_z+" Dienst(e).\n");

      return 1;

  }

  else

  {

    if(tropfen->QP(P_AMOUNT) < DAZ_ELE ) 
    {
      write(BSA(
            "Du hast ja nur "+tropfen->QP(P_AMOUNT)+" Zombiegoetzentropfen "+TPN+"! "
            "Du brauchst aber "+DAZ_ELE+" Tropfen! Tut mir leid!",
            "Der Mystagoge sagt: "));
      return 1;  
    }	    



    tropfen->AddAmount(-DAZ_ELE);

    write("Der Mystagoge nimmt Dir "+DAZ_ELE+" Blutstropfen weg.\n");

    if(!random(300))  {
      write(BSA(
            "Verflucht! Nun sind mir die Tropfen doch glatt auf den Boden gefallen! "
            "Sie sind fuer immer verloren! Tut mir leid "+TPN+"! So etwas kann "
            "dem allerbesten Magier passieren!",
            "Der Mystagoge sagt: "));
      return 1;  }	



      write(BSA(
            "Nun gut, "+TPN+", Du willst also etwas ueber die Dienstanzahl fuer "
            "das Element "+CAP(str)+" wissen.",
            "Der Mystagoge sagt: "));

      write("\nDer Mystagoge leert die Tropfen in einen der Muender der Statue und "
          "beginnt wild zu gestikulieren. Dann blickt er Dir genau ins Herz.\n");
      write("Der Mystagoge sagt: Nun gut, "+TPN+"! Hier das Ergebnis:\n");      



      zahl=amulett->QueryService(str)+1-random(3); // +/-1

      if(zahl  < 0 ) { zahl=0; }	 

      write(
          ""+CAP(str)+": "+zahl+" Dienst(e).\n");

      return 1;

  }




  return 0;  }


  //ende diensanzahl func





  //beginn der dauer einzel erhoehung

int fun_dauereinzelerhoehung(string element) 
{

  object amulett, tropfen;

  NF(BSA("Welches Element?! Feuer, Wasser, Humus, Eis, Luft, Erz?!",
        "Der Mystagoge sagt: "));

  if(find_call_out("einzel_einmal1")!=-1)  {
    STOP  }
  if(find_call_out("einzel_einmal2")!=-1)  {
    STOP  }

  if(find_call_out("alle_einmal1")!=-1)  {
    STOP  }
  if(find_call_out("alle_einmal2")!=-1)  {
    STOP  }

  if(find_call_out("einzel_immer1")!=-1)  {
    STOP  }
  if(find_call_out("einzel_immer2")!=-1)  {
    STOP  }

  if(find_call_out("alle_immer1")!=-1)  {
    STOP  }
  if(find_call_out("alle_immer2")!=-1)  {
    STOP  }



  if(find_call_out("mys1")!=-1)  {
    STOP  }
  if(find_call_out("mys2")!=-1)  {
    STOP  }
  if(find_call_out("mys3")!=-1)  {
    STOP  }
  if(find_call_out("mys4")!=-1)  {
    STOP  }
  if(find_call_out("mys5")!=-1)  {
    STOP  }
  if(find_call_out("mys6")!=-1)  {
    STOP  }	




  if(!element)  { return 0;  }

  if( element!="feuer"&&element!="wasser"&&element!="humus"&&
      element!="eis"&&element!="luft"&&element!="erz" )
  {
    return 0;
  }

  if(!TP->QP(P_GUILD, "druidenzirkel")) 
  {
    write(BSA(
          "Aber "+TPN+", Du bist doch kein Druide!",
          "Der Mystagoge sagt: "));
    return 1;  
  }

  amulett=present("\ndruidenamulett", TP);    


  if(!amulett)  
  {
    write(BSA(
          "Du hast kein Druidenamulett "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return 1;  
  }                  


  if(!amulett->QueryWorn() )
  {
    write(BSA(
          "Du hast Dein Druidenamulett nicht angezogen "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return 1;  
  }               

  tropfen=deep_present("zombiegoetzenblutstropfen", TP);

  if(!tropfen) 
  {
    write(BSA(
          "Du hast ja gar keine Zombiegoetzentropfen "+TPN+"! Ich kann Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return 1;  
  }

  if(tropfen->QP(P_AMOUNT) < EINZEL_IMMER ) 
  {
    write(BSA(
          "Du hast ja nur "+tropfen->QP(P_AMOUNT)+" Zombiegoetzentropfen "+TPN+"! "
          "Du brauchst aber "+EINZEL_IMMER+" Tropfen! Tut mir leid!",
          "Der Mystagoge sagt: "));
    return 1;  
  }	    



  tropfen->AddAmount(-EINZEL_IMMER);

  write("Der Mystagoge nimmt Dir "+EINZEL_IMMER+" Blutstropfen weg.\n");

  if(!random(300))  {
    write(BSA(
          "Verflucht! Nun sind mir die Tropfen doch glatt auf den Boden gefallen! "
          "Sie sind fuer immer verloren! Tut mir leid "+TPN+"! So etwas kann "
          "dem allerbesten Magier passieren!",
          "Der Mystagoge sagt: "));
    return 1;  }


    write(BSA(
          "Nun an "+TPN+". Ich werde mein bestes versuchen! Ich versuche nun die "
          "boese Magie der Goetzen in gute umzuwandeln und damit die Energie "
          "Deines Druidenamuletts zu erhoehen!",
          "Der Mystagoge sagt: "));

    tell_room(environment(TP),BSA(
          "Nun an "+TPN+". Ich werde mein bestes versuchen! Ich versuche nun die "
          "boese Magie der Goetzen in gute umzuwandeln und damit die Energie "
          "Deines Druidenamuletts zu erhoehen!",
          "Der Mystagoge sagt: "), ({TP}));


    call_out("einzel_immer1", TIME, element);

    return 1;  

}  


einzel_immer1(string element)  {
  object amulett;
  WARNUNG

    amulett=present("\ndruidenamulett", TP);    


  if(!amulett)  
  {
    write(BSA(
          "Du hast kein Druidenamulett "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return ;  
  }                  


  if(!amulett->QueryWorn() )
  {
    write(BSA(
          "Du hast Dein Druidenamulett nicht angezogen "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return ;  
  }               


  write(BS(
        "Der Mystagoge kniet sich vor der Statue nieder und beginnt einzelne "
        "Tropfen in die verschiedenen Muender der Statue zu leeren. "
        "Dann murmelt er irgendwelche Worte die mit Deinem Namen "+TPN+" und "
        "dem Element "+CAP(element)+" zu tun haben. Irgendetwas wie "
        ""+CAP(element)+"zauber fuer "+TP->name(WEN)+" oder so..."));


  tell_room(environment(TP),BS(
        "Der Mystagoge kniet sich vor der Statue nieder und beginnt einzelne "
        "Tropfen in die verschiedenen Muender der Statue zu leeren. "
        "Dann murmelt er irgendwelche Worte die mit dem Namen "
        ""+TPN+" und "
        "dem Element "+CAP(element)+" zu tun haben. Irgendetwas wie "
        ""+CAP(element)+"zauber fuer "+TP->name(WEN)+" oder so..."), ({TP}));


  call_out("einzel_immer2", TIME, element);

}



einzel_immer2(string element)  {
  object amulett;
  WARNUNG

    amulett=present("\ndruidenamulett", TP);    


  if(!amulett)  
  {
    write(BSA(
          "Du hast kein Druidenamulett "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return ;  
  }                  


  if(!amulett->QueryWorn() )
  {
    write(BSA(
          "Du hast Dein Druidenamulett nicht angezogen "+TPN+", also kann ich Dir "
          "nicht helfen!",
          "Der Mystagoge sagt: "));
    return ;  
  }               

  write(BS(
        "Ploetzlich schiesst ein "+CAP(element)+"zombie herein und attackiert den Mystagogen und DICH!!!"));

  write("\nDer "+CAP(element)+"zombie verfehlt den Mystagogen.\n"
      "Der Mystagoge pulverisiert den "+CAP(element)+"zombie.\n"
      "Der z"+CAP(element)+"zombie explodiert mit lautem Knall.\n"
      "Du atmest erleichtert auf! "
      "Der Zauber scheint funktioniert zu haben!\n"); 


  tell_room(environment(TP),
      "Ploetzlich schiesst ein "+CAP(element)+"zombie herein und attackiert den Mystagogen und "+TP->name(WEN)+"!!!\n"
      "Der "+CAP(element)+"zombie verfehlt den Mystagogen.\n"
      "Der Mystagoge pulverisiert den "+CAP(element)+"zombie.\n"
      "Der "+CAP(element)+"zombie explodiert mit lautem Knall.\n"
      ""+TPN+" atmet erleichtert auf! "
      "Der Zauber scheint funktioniert zu haben!\n", ({TP}));



  switch(random(100)) 

  {

    case 0..50:
      ei_wert=8;
      break;

    case 51..75:
      ei_wert=10;
      break;

    case 76..86:
      ei_wert=13;
      break;      

    case 87..96:
      ei_wert=16;
      break;

    case 97..99:
      ei_wert=19;
      break;
    default: ei_wert=8;


  }            



  switch(element)  {

    case "feuer":
      amulett->SetStdService(ei_wert+random(3), -1, -1, -1, -1, -1);
    break;
    case "wasser":
      amulett->SetStdService(-1, ei_wert+random(3), -1, -1, -1, -1);
    break;
    case "eis":
      amulett->SetStdService(-1, -1, ei_wert+random(3), -1, -1, -1);
    break;
    case "humus":
      amulett->SetStdService(-1,- 1, -1, ei_wert+random(3), -1, -1);
    break;
    case "luft":
      amulett->SetStdService(-1, -1, -1, -1, ei_wert+random(3), -1);
    break;
    case "erz":
      amulett->SetStdService(-1, -1, -1, -1, -1, ei_wert+random(3));
    break;             
    default:
    amulett->SetStdService(-1, -1, -1, -1 , -1, -1);

    write_file("/d/wasser/dante/zinsel/log/einzel_immer",
        ctime()+": "+CAP(getuid(TP))+" BUG!!! element: "+element+" wert: "+ei_wert+" plus random 3\n");
  }            


  write_file("/d/wasser/dante/zinsel/log/einzel_immer",
      ctime()+": "+CAP(getuid(TP))+" element: "+element+" wert: "+ei_wert+" + rand 3\n");

}

