// dante@SilberLand

inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Erna, die Putzfrau");
  SetProp(P_LONG, BS(
  "Das ist Erna, Dantes Putzfrau oder besser seine Exputzfrau. Sie befindet "
  "sich gerade im Streik und fordert von ihrem Chef mehr Lohn. Dante denkt "
  "aber nicht daran ihr Gehalt zu erhoehen, denn seiner Meinung nach ist sie "
  "stinkfaul und geldgierig, ausserdem sollten 7 Muenzen pro Monat mehr als "
  "genug sein. Aber so sind sie, die Putzfrauen, gibt man ihnen den kleinen "
  "Finger, wollen sie Dein ganzes Geld. Aus Wut und Frust hat sie hier bei "
  "den Zombiejaegern einen Laden eroeffnet."));  
  SetProp(P_NAME, "Erna, die Putzfrau");
  SetProp(P_GENDER, FEMALE);
  AddId(({"putzfrau", "erna"}));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(13);
  SetProp(P_HANDS, ({" mit ihren gruenen Gummihandschuhen",130,DT_ACID}));
  SetProp(P_MAX_HP, 200);
  SetProp(P_BODY, 30);
  SetProp(P_SIZE, 160);
  SP(P_RACE, "Mensch");
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 1);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "trampelt grantig herein");
  SetProp(P_MSGOUT, "trampelt grantig");
  SetProp(P_MMSGIN, "trampelt grantig");
  SetProp(P_MMSGOUT, "trampelt grantig davon");
  
  SetProp(P_DIE_MSG,  " schreit laut: Danke, nie wieder muss ich putzen!\n");
  
  AddInfo(DEFAULT_INFO, "jammert: Dante, dieser miese Geizkragen!\n");
  AddInfo("dante", "Er will mir nicht mehr bezahlen, dieser miese Kerl.","sagt: ");
  AddInfo("wuschel", "UI! Die hat eine lustige Nase!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Erna sagt: Wenn Dante nur so nett waere....\n" }) );
AddInfo(({"zombie","zombie"}),
  "Zum Glueck kommen sie hier nie her!", "sagt: ");
  
  AddInfo("cornelia", "Naja, sie ist eben ein Putzmops.", "sagt: ");
  SetProp(P_SPELLRATE,70);
  
  AddSpell(3,150,
    "Erna tritt Dir ins Bein.\n",
    "Erna tritt @WEM ins Bein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,150,
    "Erna beisst Dir in die Wade.\n",
    "Erna beisst @WEM in die Wade.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));



AI(({"jaeger","zombiejaeger"}),
"Sie sorgen dafuer, dass mir nichts passiert!\n", "sagt: ");
AI("erna",
"Das bin ich!", "sagt: ");
AI("laden",
"Das ist meiner!", "sagt: ");

  SetChats(10, ({
  "Erna sagt: Ich streike!\n",
  "Erna singt die Internationale.\n",
  "Erna sagt: Nie wieder Putzen!\n",
  "Erna sagt: Dante ist ein mieser Halsabschneider.\n",
  "Erna flucht laut ueber Dante.\n",
  "Erna sagt: Ich melde das der Gewerkschaft!\n",
  "Erna sagt: Kuess mich!\n",
  "Erna fragt: Hast Du schon einen Zombie getoetet?!\n",
  "Erna sagt: Der Trolldaemon soll extrem boesartig sein!\n",
  "Erna sagt: Die Zombies muessen sterben!\n",
  "Erna sagt: Kennst Du Cornelia?\n",
  "Erna sagt: Cornelia ist ein Mops.\n",
  "Erna sagt: Du Dreckfink, pass auf!\n"}) );
  
   SUID;
   CLONEME("/d/wasser/dante/zinsel/weapon/wedel" );
   command("zuecke wedel");  
  
  /*
  if(!random(3))  {
 	CLONEME("/players/dante/k2");
  } 
  */
  
  } 

void init()
{
  ::init();
    if(interactive(TP)) call_out("hallo",0);
    }                

    hallo()
  { if(environment(TO)!=environment(TP)) return ;
   command("emote sagt grantig: "+ TP->name(RAW) +", mach ja nichts schmutzig!\n");
   }
   