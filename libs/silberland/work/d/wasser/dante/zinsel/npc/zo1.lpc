#include "/players/dante/myowndefine.h"
#include <class.h>
#define ALI 100+random(100)

_query_poison() { return 0; }

void create()
{
  object money;
  string rasse;
  int l;
  
  if (!is_clone(TO)) return;
  ::create();

  switch (random(21))
  {
    case 0..2 : l=2;     rasse = "Menschen"; break;
    case 3..5 : l=1;     rasse = "Zwergen"; break;
    case 6..8 : l=3;     rasse = "Elfen"; break;
    case 9..11 : l=1;    rasse = "Hobbit"; break;
    case 12..14: l=4;    rasse= "Troll"; break;
    case 15..17: l=3;    rasse= "Dunkelelfen"; break;
    case 18..20: l=3;    rasse = "Oger"; break;
    default: l=2; rasse="Menschen";
    
  //feenzombies *lach* gibts nicht klar
  }

  SetProp(P_SHORT, "Ein "+ rasse+ "zombie");
  SetProp(P_LONG, BS(
"Dieser Zombie war einst ein normaler Bewohner des Silberlandes. "
"Nun ist er aber ein grausig mutiertes Unwesen, eben ein "+rasse+"zombie!"));

AddClass(CL_ZOMBIE);
 
 SetProp(P_NAME, ({
 	""+rasse+"zombie",
 	""+rasse+"zombies",
 	""+rasse+"zombie",
 	""+rasse+"zombie"}));
 	
  SetProp(P_GENDER, MALE);
  AddId(({ LOWER(rasse), "zombie",""+LOWER(rasse)+"zombie"}));
 
  create_default_npc(15);


  SetProp(P_HANDS, ({" mit verfaulten "+ rasse +"krallen",200,({DT_TERROR, DT_RIP})}));
  SetProp(P_BODY, 40+l*5);
  SetProp(P_RACE, "Zombie");
     SetProp(P_SIZE, 50+random(50) + l*50);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 3);
  SetProp(P_RESISTANCE_STRENGTHS,
   ([DT_UNHOLY: -0.1,
   DT_TERROR:-0.5,DT_FIRE:0.5, DT_ACID:0.3,DT_BLUDGEON:-0.1, DT_HOLY: 0.3]));

  SetProp(P_DIE_MSG,  " zerfaellt zu ekligem Matsch.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "bruellt irgendetwas vom Tod.\n");

  SetProp(P_MSGIN, "kriecht grunzend auf Dich zu");
  SetProp(P_MSGOUT, "kriecht bruellend");
  SetProp(P_MMSGIN, "kriecht bruellend auf Dich zu");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, "/d/wasser/dante/zinsel/room/" );
  SetProp(P_MNPC_WAIT, ({ 5, 15, 15 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/z1");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS+
         MOV_MOVES + MOV_SPECIAL+MOV_BACKWARDS);



  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
"Der Zombie bruellt Dich an!"}));
  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,250,
    "Der "+rasse+"zombie tritt Dir in den Bauch.\n",
    "Der "+rasse+"zombie tritt @WEM in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
 AddSpell(3,350,
    "Der "+rasse+"zombie tritt Dir ins den Gesicht.\n",
    "Der "+rasse+"zombie tritt @WEM ins Gesicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(1,100,DS_BLIND,
    "Der abscheuliche "+rasse+"zombie sticht Dir ins Auge.\n",
    "Der abscheuliche "+rasse+"zombie sticht @WEM ins Auge.\n");
  
 AddDefaultSpell(1,100,DS_POISON,
    "Der abscheuliche "+rasse+"zombie spuckt Gift nach Dir.\n",
    "Der abscheuliche "+rasse+"zombie spuckt Gift nach @WEM.\n");  

  SUID;

    money = CLONEOB ("/obj/money");
    money->SetProp(P_AMOUNT, 200+random(100));
    money->move(ME);

if(!random(3))  {
CLONEME("d/wasser/dante/zinsel/obj/cat");
       }
//waffen
switch(random(23))  {
	
	case 0..4:
	CLONEME("d/wasser/dante/zinsel/weapon/zsch1");
	command("zuecke schwert");
        break;
        case 5..8:
        CLONEME("d/wasser/dante/zinsel/weapon/zkeul");
        command("zuecke keule");
        break;
        case 9:
        CLONEME("d/wasser/dante/zinsel/weapon/zlan");
        command("zuecke lanze");
        break;
        case 10..22:
        break;
        default:      CLONEME("d/wasser/dante/zinsel/weapon/zlan");
        command("zuecke lanze");  }
        
   //ruest!!!
   switch(random(29))  {
   	case 0..2:
   CLONEME("d/wasser/dante/zinsel/armour/zha1");
   command("zieh handschuhe an");
   break;
      	case 3..5:
   CLONEME("d/wasser/dante/zinsel/armour/zhe1");
   command("zieh helm an");
   break;    
  	case 6..8:
   CLONEME("d/wasser/dante/zinsel/armour/zst1");
   command("zieh stiefel an");
   break;
  	case 9..10:
        break;
 	case 11:
   CLONEME("d/wasser/dante/zinsel/armour/zhe1");
   CLONEME("d/wasser/dante/zinsel/armour/zha1");
   command("zieh alles an ");
   break;
 	case 12:
 	 CLONEME("d/wasser/dante/zinsel/armour/zho1");
   CLONEME("d/wasser/dante/zinsel/armour/zha1");
  CLONEME("d/wasser/dante/zinsel/armour/zst1");
  command("zieh alles an");
   break;
   	case 13:
   CLONEME("d/wasser/dante/zinsel/armour/zst1");
   CLONEME("d/wasser/dante/zinsel/armour/zhe1");
   CLONEME("d/wasser/dante/zinsel/armour/zha1");
   command("zieh alles an ");
   break;
   case 14..15:
      CLONEME("d/wasser/dante/zinsel/armour/zumh1");
      command("zieh umhang an");
     break;
     case 16..18:
     CLONEME("d/wasser/dante/zinsel/armour/zho1");
     command("zieh hose an"); 

     case 19..28:
     break;
    default:  	
   CLONEME("d/wasser/dante/zinsel/armour/zhe1");
   CLONEME("d/wasser/dante/zinsel/armour/zst1");
   command("zieh alles an ");
   
     }
   
   
  //ringe amus
  switch(random(55))  {
  	case 0..30:
  	break;
  	case 31..40:
  	   CLONEME("d/wasser/dante/zinsel/armour/zringbad");
  	   break;
  	   case 41..49:
  	  CLONEME("d/wasser/dante/zinsel/armour/zamu"); 
          break;
          case 50..54:
          break;
          default:
             CLONEME("d/wasser/dante/zinsel/armour/zringbad");
          }
             
SetChats(10,({
	"Der "+rasse+"zombie grinst Dich unheimlich an.\n",
	"Der "+rasse+"zombie scheint zu verfaulen.\n",
	"Der "+rasse+"zombie stinkt eklig.\n",
	"Der "+rasse+"zombie kriecht naeher zu Dir.\n",
	"Der "+rasse+"zombie zerfaellt ein wenig.\n",
	"Der "+rasse+"zombie bohrt in seinen Augen herum.\n",
	"Der "+rasse+"zombie reisst Haut aus sich heraus.\n",
	"Der "+rasse+"zombie reisst sich einen Fingernagel aus.\n",
	"Der "+rasse+"zombie verliert Fleisch am Bein.\n"}));
	

}



void init()
{
    ::init();
    if(IS_WIZARD(TP))  { return;  }
    
    VIRUS
    
   if(interactive(TP)&&TP->QueryProp(P_ALIGN)>ALI)  { 
    
	write( 
"Der Zombie stuerzt sich auf Dich!\n");
	Kill(TP);
    }
   
   
   if(!interactive(TP) && TP->id("ZJ") )  {
   	Kill(TP);
   	 tell_room(environment(TO), BS(
   "Der Zombie stuerzt sich voller Wut auf "+TP->name(WEN)+"!"));
   }
    
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
call_out("nimm_alles", 0);
}



nimm_alles()  {
  if(present("leiche", environment(TO)))  {
  command("nimm alles aus leiche");
   } 
     }



Defend(int dam, string dtype, mixed spell, object enemy)
{

  if(enemy->id("ZJ"))  
    return ::Defend(0, dtype, spell, enemy);
  else if( interactive(enemy))
    SetProp( P_PREFERED_ENEMY, ({80,enemy}));

  return ::Defend(dam, dtype, spell, enemy);
}

