void create()
{
  object money;
  string rasse;
  int l;
 
  if (!is_clone(TO)) return;
  ::create();

  switch (random(21))
  {
    case 0..2 : l=6; rasse = "Riesen"; break;
    case 3..5 : l=2; rasse = "Vampir"; break;
    case 6..8 : l=4; rasse = "Daemonen"; break;
    case 9..11 : l=2; rasse = "Ork"; break;
    case 12..14: l=3; rasse= "Goblin"; break;
    case 15..17: l=3; rasse= "Hobgoblin"; break;
    case 18..20: l=3; rasse = "Skelett"; break;

  }

  SetProp(P_SHORT, "Ein boesartiger "+ rasse+ "zombie");
  SetProp(P_LONG, BS(
"Dieser Zombie war ein ein boeses Wesen aus dem Silberland. Nun "
"verfault diese Kreatur langsam, sie ist schliesslich ein "+rasse+"zombie!"));

AddClass(CL_ZOMBIE);
 
 SetProp(P_NAME, ({
 	""+rasse+"zombie",
 	""+rasse+"zombies",
 	""+rasse+"zombie",
 	""+rasse+"zombie"}));
 	SP(P_NAME_ADJ, "boesartig");
 	
  SetProp(P_GENDER, MALE);
  AddId(({ LOWER(rasse), "zombie",""+LOWER(rasse)+"zombie"}));
 
  create_default_npc(18);


  SetProp(P_HANDS, ({" mit verfaulten "+ rasse +"krallen",300,({DT_TERROR, DT_RIP})}));
  SetProp(P_BODY, 50+l*5);
  SetProp(P_RACE, "Zombie");
     SetProp(P_SIZE, 50+random(50)+l*50 );
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -20);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 7);
  SetProp(P_RESISTANCE_STRENGTHS,
   ([DT_UNHOLY: -0.1,
   DT_TERROR:-0.5,DT_FIRE:0.5, DT_ACID:0.3,DT_BLUDGEON:-0.1, DT_HOLY: 0.3]));

  SetProp(P_DIE_MSG,  " zerfaellt zu ekligem Matsch.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "bruellt irgendetwas vom Tod.\n");

  SetProp(P_MSGIN, "kriecht grunzend auf Dich zu");
  SetProp(P_MSGOUT, "kriecht bruellend");
  SetProp(P_MMSGIN, "kriecht bruellend auf Dich zu");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, "/d/wasser/dante/zinsel/room/" );
  SetProp(P_MNPC_WAIT, ({ 10, 25, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/z2");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS+
         MOV_MOVES + MOV_SPECIAL+MOV_BACKWARDS);



  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
"Der Zombie bruellt Dich an!"}));
  SetProp(P_SPELLRATE,50);

  AddSpell(5,350,
    "Der boesartige "+rasse+"zombie tritt Dir in den Bauch.\n",
    "Der boesartige "+rasse+"zombie tritt @WEM in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
 AddSpell(3,450,
    "Der boesartige "+rasse+"zombie tritt Dir ins den Gesicht.\n",
    "Der boesartige "+rasse+"zombie tritt @WEM ins Gesicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(1,200,DS_BLIND,
    "Der abscheuliche "+rasse+"zombie sticht Dir ins Auge.\n",
    "Der abscheuliche "+rasse+"zombie sticht @WEM ins Auge.\n");
  
 AddDefaultSpell(1,200,DS_POISON,
    "Der abscheuliche "+rasse+"zombie spuckt Gift nach Dir.\n",
    "Der abscheuliche "+rasse+"zombie spuckt Gift nach @WEM.\n");  

  
  
  SUID;

    money = CLONEOB ("/obj/money");
    money->SetProp(P_AMOUNT, 400+random(400));
    money->move(ME);
if(!random(2))  {
CLONEME("d/wasser/dante/zinsel/obj/cat");
      
      p=1; }
if(p!=1)  {
if(!random(2))  {
CLONEME("d/wasser/dante/zinsel/obj/zun");
       }
}

