void init()
{
    ::init();

   if(IS_WIZARD(TP))  { return;  }   
   VIRUS
   if(interactive(TP)&&TP->QueryProp(P_ALIGN)>ALI)  { 
    
	write( 
"Der Zombie stuerzt sich auf Dich!\n");
	Kill(TP);
    }
   
   
     if(!interactive(TP) && TP->id("ZJ") )  {
   	Kill(TP);
   	 tell_room(environment(TO), BS(
   "Der Zombie stuerzt sich voller Wut auf "+TP->name(WEN)+"!"));
   }
   
   
    
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
call_out("nimm_alles", 0);
}



nimm_alles()  {
  if(present("leiche", environment(TO)))  {
  command("nimm alles aus leiche");
   } 
}




Defend(int dam, string dtype, mixed spell, object enemy)
{

  if(enemy->id("ZJ"))  
    return ::Defend(0, dtype, spell, enemy);
  else if( interactive(enemy))
    SetProp( P_PREFERED_ENEMY, ({80,enemy}));

  return ::Defend(dam, dtype, spell, enemy);
}

