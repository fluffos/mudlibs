//variabel
//dante sl 98
//zombiehunde

inherit "std/mnpc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <class.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>

int i, x;
string *wie;
string *farbe;

_query_poison() { return 0; }

init()  {
	::init();
	VIRUS
	if(
	(interactive(TP))&&(TP->QueryProp(P_ALIGN)>300))  {
	Kill(TP);
}}
	
create()
{
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_LONG, 
  "Das ist einer der schrecklichen Zombiehunde. Sein Gebiss wartet nur "
  "darauf Dich zu zerfetzen!");
  SetProp(P_NAME, "Zombiehund");
  SetProp(P_GENDER, MALE);
  AddId( ({"hund", "zombiehund","zombie"}) );
   SetProp(P_AGGRESSIVE, 0);
  create_default_npc(6)+random(3);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Zaehnen", 100+random(50),({DT_PIERCE, DT_RIP})}));
  SetProp(P_RACE, "Zombie");
  SetProp(P_SIZE, 130+random(10));
  SetProp(P_ALIGN, -100);
  AddClass(CL_ZOMBIE);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-1.0, DT_UNHOLY:-1.0, DT_TERROR:-1.0,
  DT_BLUDGEON:1.0]));

  SetProp(P_MSGIN, "laeuft knurrend herein");
  SetProp(P_MMSGIN, "laeuft knurrend herein");
  SetProp(P_MMSGOUT, "laeuft knurrend weit weg");
  SetProp(P_MSGOUT, "laeuft knurrend");
   SetProp(P_MNPC_AREA, "/d/wasser/dante/zinsel/room/");
     SetProp(P_MNPC_WAIT, ({random(10)+5, 5,15}));
    SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS +
    MOV_INDOORS+MOV_OUTDOORS);
    SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/z2");
  
  
  
  
  
  AddDetail("gebiss",
  "KRRRRRRRRRRRRRRRRRRRRRRRRR!!!!!!!!");
  AddInfo(DEFAULT_INFO, ({
    "knurrt boese.\n",
    "schleicht um Dich herum.\n",
    "schaut Dich misstrauisch an.\n",
    "knurrt brutal.\n"}) );
  AddInfo("dante", "Wenn ich den zwischen meine Zaehne kriege...", "knurrt: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Zombiehund schnueffelt nur kurz an @WEM und laesst es dann liegen.\n"}));
  SetProp(P_DIE_MSG, " knurrt Dich ein letztes Mal boese an.\n");
   
  SetProp(P_SPELLRATE, 70);
  
  AddSpell(3, 200,
  "Der Zombiehund springt Dir an die Gurgel.\n",
  "Der Zombiehund springt @WEM an die Gurgel.\n",
  DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,333,
    "Der Zombiehund beisst Dich ins Bein.\n",
    "Der Zombiehund beisst @WEN ins Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
    
  AddSpell(3,300,
    "Der Zombiehund zerfetzt Deinen Arm.\n",
    "Der Zombiehund zerfetzt @WESSEN Arm.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));

wie=({"schrecklich","grausig","brutal","knurrend","eklig",
   "dantinisch",
      "haesslich","gemeingefaehrlich","abstossend","untoter",
      "gross","klein","riesig","halbverwest"});
 farbe=({"braun","grau","schwarz","weiss","blutrot","nachtschwarz"});
      
i=random(sizeof(wie));
x=random(sizeof(farbe));

  SetProp(P_SHORT, "Ein "+wie[i]+"er,"+farbe[x]+"er Zombiehund");



}

