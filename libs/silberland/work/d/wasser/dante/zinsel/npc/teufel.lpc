//teufelchen von dante
//uralter schrott
//man kann die seele bei ihm verkaufen
//usw

inherit "std/npc";                                                                                   

#include "/players/dante/myowndefine.h" 
#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP  
#include <new_skills.h>
#include <npc.h>
#include <class.h>
#include <wizlevels.h>
object fire;



void init()
{
  ::init();
  if(TP && interactive(TP)) {
    call_out("tot",1);}
}



void create()   
{   
  if (!is_clone(this_object())) return;  

  ::create();
  SetProp(P_SHORT, "Luzifer");
  SetProp(P_LONG, BS("Das ist Luzifer, der Hoellenfuerst, auch Satan genannt. Seine "
        "haessliche Fratze blickt Dich voller Verachtung und Hinterlist "
        "an. Weisst du denn nicht, dass er Abenteurer wie Dich reihenweise"
        " zum Fruehstueck verspeist. Du spuerst wie sich das Boese "
        "Deiner Seele bemaechtigt, wenn er Dich mit seinen feuerroten "
        "Augen durchdringt. Auf seinem Schaedel ragen zwei maechtige "
        "Hoerner in die Hoehe. Auch den altbekannten Bocksfuss kannst "
        "Du erkennen. Dir wird Angst und Bange!!! "
        "Doch sei gewiss, der Teufel kann in vielen Formen erscheinen "
        "und das ist sicher nur eine davon. Du kannst ihm auch "
        "Deine Seele verkaufen!"));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Luzifer");                

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100, T_RANGE_MAX: 100]));                
  AddDetail(({"hinterlist","verachtung"}),
      "Der Satan hat seit dem Tag, als das Boese Einzug ins Silberland "
      "hielt, versucht, die Seelen der Menschen, Elfen, Hobbits und Zwerge "
      "mit Hinterlist und Tuecke zu fangen, um sie dann auf ewig zu "
      "seinen Sklaven zu machen.");               
  AddDetail(({"angst","bange"}),
      "Du zitterst und schlotterst mit den Knien, der kalte Angstschweiss "
      "laueft Dir ueber den Ruecken, deine Nackenhaare stellen sich auf, "
      "es wird wohl Zeit von hier zu verschwinden!");
  AddDetail(({"abenteurer","fruehstueck"}),
      "Nun beginnst du langsam zu bereuen, dass Dich Dich hierher in die "
      "Tiefen der Hoelle gewagt hast. Dein satanischer Gegner scheint fuer "
      "Dich unueberwindbar zu sein. Solltest du nicht besser fluechten, "
      "wenn das Schicksal unzaehliger anderer Abenteurer Dich nicht ereilen "
      "soll?");
  AddDetail(({"fuss","bocksfuss"}),
      "Der rechte Fuss sieht ganz normal aus, aber der linke ist ein Fuss, "
      "wie Du ihn sonst nur von Ziegenboecken her kennst. Mit diesem stampft "
      "er auf den Boden, dass die Erde erzittert!");                            

  AddDetail(({"schaedel","hoerner","hoehe"}),
      "Diese Spitzen, schwarzen Hoerner wirken furchteinfloessend auf Dich. "
      "Damit hat er sicher so manchen frechen Abenteurer aufgespiesst, kommt "
      "Dir in den Sinn. Manchmal scheinen Flammen um die Hoerner zu zuengeln. "
      "Ueberhaupt hat Luzifer eine undefinierbare Groesse. Ist er nun zwei "
      "oder zwanzig Meter hoch. Oder doch nur ein Trugbild des Boesen?");

  AddDetail(({"fratze","gesicht"}),
      "Seine Fratze ist verzerrt vom Hass, den der Fuerst der Finsternis "
      "auf alle Sterbliche hat. Rotschwarze Flammen umzuengeln sein Maul, "
      "die sich sicher zu einem gewaltigen Feuersturm vermehren koennen."); 

  AddDetail(({"augen","auge"}),
      "Seine feuerroten Augen blicken Dich voller Hass an und Du bemerkst "
      "wie Dir ploetzlich im Schritt sehr warm wird....Du Hosenscheisser!");      

  AddId("luzifer");
  AddId("satan");
  AddId("teufel");  
  AddClass(CL_DEMON);

  create_default_npc( 66, 6666 );
  SetProp(P_XP, 66666666); 
  SetProp(P_BODY, 333);

  SetProp(P_INFO, ("Luzifer hat jede Menge miese Tricks drauf. Sei vorsichtig!\n"));
  SetProp(P_SIZE, 1000);                                                                                     
  SetProp(P_KILL_MSG, ("Deine Seele bleibt nun fuer immer mein!"));
  SetProp(P_ARTICLE, 0);

  SetProp(P_RESISTANCE_STRENGTHS, ([
         DT_UNHOLY:-1.0, DT_FIRE:-1.0,  DT_TERROR:-1.0, 
         DT_SOUND: -0.5, DT_LIGHT: 0.2, DT_AIR: -0.7,
         DT_POISON:-1.0, DT_MIND: -1.0, DT_EXPLOSION: -0.5,
         DT_MAGIC:-0.5,  DT_HOLY: -0.3, DT_COLD:-0.5]));

  SetProp(P_HANDS, ({" mit seinen schrecklichen Klauen", 1234,
        ({DT_RIP, DT_SLASH, DT_PIERCE, DT_FIRE, DT_TERROR, DT_UNHOLY})}));
  SetProp(P_ALIGN, -1000);
  SetProp(P_RACE, "Teufel");
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_AGGRESSIVE, 0);                        
  SetProp(P_SPELLRATE, 66); 

  AddSpell(4,700,
      "Luzifer dringt mit dem Boesen in Dein Herz ein.\n",
      "Luzifer dringt mit dem Boesen in @WESSEN Herz ein.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,2000,
      "Luzifer reisst Dir die Seele aus dem Leib.\n",
      "Luzifer reisst @WESSEN Seele aus dem Leib.\n",
      ({DT_UNHOLY, DT_RIP}),([SP_SHOW_DAMAGE:1]));
  AddSpell(2,900,
      "Du verbrennst fast in einer Wand aus Feuer.\n",
      "@WER verbrennt fast in einer Wand aus Feuer.\n",
      DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,666,
      "Luzifer brennt Dir die Zahl 666 auf die Stirn.\n",
      "Luzifer brennt @WEM die Zahl 666 auf die Stirn.\n",
      DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,800,                
      "Deine Haut beginnt wegen der Hitze Blasen zu bilden.\n",
      "@WESSEN Haut beginnt wegen der Hitze Blasen zu bilden\n",
      DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,1500,                
      "Luzifer rammt Dir seine Klauen in den Leib.\n",
      "Luzifer rammt @WEM seine Klauen in den Leib.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,800,                
      "Luzifer wuehlt in Deinen Eingeweiden.\n",
      "Luzifer wuehlt in @WESSEN Eingeweiden.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,                
      "Eine Stimme in Deinem Kopf sagt: STOP!\n",
      "Eine Stimme in @WESSEN Kopf sagt: STOP!\n",
      DT_MIND,"spell_stop",([SP_SHOW_DAMAGE:1]));


  SetChats(4, ({
        "Luzifer will Deine Seele!\n",
        "Luzifer bruellt: Sterblicher, ich bin der wahre Gott!!!\n",
        "Der Teufel verflucht Deine Seele.\n",
        "Der Teufel fluestert etwas von einem Pakt...\n",
        "Luzifer macht Dir die Hoelle schmackhaft.\n",
        "Luzifer verflucht das Himmelsreich.\n",
        "Luzifer schreit: Ich will Weiber und Alkohol!!!\n",
        "Luzifer verschwindet im Boden und erscheint hinter Dir.\n",             
        "Luzifer schaut Dich diabolisch an.\n",
        "Luzifer beschwoert tasmanische Teufel.\n"
        }) );

  SetAttackChats(10, ({
        "Dir wird Angst und Bange.\n",
        "Fluechte solange Du noch kannst.\n",
        "Luzifer bruellt: Du laecherlicher Sterblicher!\n",
        "Luzifer bruellt: Deine Letzte Stunde hat geschlagen!\n",
        "Luizifer schreit: Das war ein Fehler du Wurm!\n"
        "Der Teufel schreit: Fahr zur Hoelle!\n"
        }) );

  SetProp( P_DIE_MSG, " stampft wuetend mit dem Fuss auf den Boden, die Erde tut\n"
      "sich auf und Luzifer verschwindet fluchend mit Knall und\n"    
      "Schwefelduft in den Tiefen der Erde!\n");
  SetProp( P_NOCORPSE, 1 );

  SetProp(P_DEFAULT_INFO,"sagt: Schweige vor dem Fuerst der Finsternis!\n");


  AddInfo("suende",
      "sagt: JA, suendige mein Freund....\n");           
  AddInfo("leben",
      "sagt: Das Leben ist ein Trugbild und nur allzu kurz.\n");
  AddInfo("dante",
      "sagt: Diesen Wicht hole ich mir auch noch!\n");
  AddInfo("gott",
      "sagt: Der einzig wahre Gott bin ich!\n");
  AddInfo("Hoelle",
      "sagt: Dahin schicke ich Dich gleich!\n");
  SetProp( P_REJECT, ({ REJECT_KEEP, "Luzifer sagt: Mehr davon, ich will mehr!\n" }) );
  AddInfo("moppy",        
      "sagt: Sie ist das netteste Hobbitmaedchen das Dante kennt.\n"                 
      "                    Er liebt sie sehr!!!\n");     
  AddInfo("satan", 
      "sagt: Das bin ich du Idiot!\n");
  AddInfo("woody",
      "sagt: Der Wurm glaubt ein Gott zu sein...laecherlich!\n");
  AddInfo("feyaria",
      "sagt: Sie ist die Herrin des Dschungels, naja, war sie mal und Dantes Mutter.\n");
  AddInfo("teufel",
      "sagt: Der steht vor Dir, Du Wicht!\n");
  AI("seele",
      "Du kannst mir Deine Seele verkaufen und wirst dafuer reich belohnt! "
      "Du wirst dafuer immer satanisch sein, doch ich werde meinen Tribut auf "
      "jeden Fall einfordern. Doch mach Dir keine Sorgen, wie Du weisst, der "
      "Teufel luegt und betruegt nie! Wenn Du noch mehr wissen willst, frag mich "
      "nach Handel!", "sagt grinsend: ");
  AI("handel",
      "Der Handel ist nur ein Vorteil fuer Dich! Du wirst so oft Du willst satanisch "
      "werden koennen. Doch ein kleiner Nachteil ist da auch noch!!!", 
      "sagt grinsend: ");
  AI("vorteil",
      "Du wirst nur Vorteile haben! Verkaufe mir Deine Seele!", "lacht: ");
  AI("nachteil",
      "Bloed, aeh, gut, dass Du fragst! Du wirst von Zeit zu Zeit hier herkommen muessen und mir "
      "huldigen! Sonst nichts! Also, zoegere nicht! Verkaufe mir Deine Seele!!!",
      "sagt: ");

  ACD(({"verkaufe","verkauf"}), "hihi");
  ACD(({"huldige", "huldig"}), "check");

}        


int check(string str)  {
  object ob;
  ob=deep_present("TEUFEL_SEELE", TP);

  NF("Wem willst Du hier huldigen!\n"); 

  if(str=="teufel"||str=="satan"||str=="luzifer")   {

    if(!ob)   {
      write(BSA(
            "Was soll das!!! Wir beide haben keinen Pakt miteinander!!! Los verkauf "
            "mir Deine Seele oder hau ab!",
            "Der Teufel bruellt: "));
      write(BS(
            "Danach schiesst ein Blitz aus seinen Augen auf Dich herab!"));
      tell_room(environment(TO),
          CAP_TPN+" wird von einem Blitz aus den Augen des Teufels getroffen!\n",
          ({TP}));

      TP->do_damage(10+random(10));
      return 1; 
    }

    if(ob)  {

      write(BS(
            "Du kniest nieder und huldigst dem Teufel!"));
      tell_room(environment(TO),
          CAP_TPN+" kniet nieder und huldigt dem Teufel\n", ({TP}));

      write(BSA(
            "Gut! So soll es, "+TPN+"! Hiermit hast Du vorerst Deinen Teil des "
            "Paktes erledigt! Heil dem Boesen! Wir sehen uns wieder!",
            "Der Teufel sagt: "));
      ob->gehuldigt();
      return 1; 
    }
    return 0; 
  }
  return 0; 
}


int hihi(string str)  {
  object ob;
  NF("Was willst Du dem Teufel verkaufen!\n");

  if(!str) {
    write(BS(
          "Du willst dem Teufel Deine Seele verkaufen!"));
    return 1; 
  }

  if(str=="seele")  {

    if(TP->QP(P_GHOST))  {
      write(BSA(
            "Nein! Als Geist geht das nicht!",
            "Der Teufel lacht: "));
      return 1; 
    }

    if(TP->QP(P_ALIGN)>0)  {
      write(BSA(
            "Nein! Du bist zu gut! Hau ab!",
            "Der Teufel lacht: "));
      return 1;  
    }

    if(deep_present("TEUFEL_SEELE", TP))  {
      write(BSA(
            "Aber Du hast mir Deine miese Seele doch schon verkauft! syntax: 'teufelspakt'",
            "Der Teufel lacht: "));
      return 1; 
    }

    else {
      write(BSA(
            "Gut, gut! Eine weisse Entscheidung! Gratuliere! Ab sofort gehoert Deine "
            "Seele mir! Und Du kannst nun von Zeit zu Zeit satanisch werden! Heil dem "
            "Boesen und Satan, also mir! Das Kommando lautet einfach 'teufelspakt'!!! "
            "Merke Dir das gut!!!",
            "Der Teufel sagt: "));
      domainshout(""+CAP(getuid(TP))+" hat soeben dem "
          "Teufel "+TP->QueryPossPronoun(FEMALE, WEN, SINGULAR)+" Seele verkauft!\n");

      write_file("/d/wasser/dante/zinsel/log/teufel",
          ctime()+": "+CAP(getuid(TP))+" Seele verkauft.\n");

      ob=clone_object("/d/wasser/dante/zinsel/obj/pakt");
      ob->move(TP, M_NOCHECK);

      return 1; 
    }
    return 0; 
  }
  return 0;
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  fire=clone_object("/d/wasser/dante/zinsel/npc/tfire");
  fire->move(environment(TO), M_NOCHECK );

  write_file("/d/wasser/dante/zinsel/log/teufel",
      ctime()+": "+CAP(getuid(player))+" stirbt durch den Teufel.\n");
}

int Defend(int dam, string dam_type,mixed spell, object enemy)  {
  
  object ob;
  int i;

  if(!random(15) && !present("teufelsfeuer", environment(TO)))  {
    fire=clone_object("/d/wasser/dante/zinsel/npc/tfire");
    fire->move(environment(TO), M_NOCHECK );

  }
  if( !query_once_interactive(enemy) && stringp(enemy->QueryProp(P_RACE)) &&
      lower_case(enemy->QueryProp(P_RACE)) == "daemon" )
  {
    enemy->remove();
    return 0;
  }
  /* 	
        if(enemy->QueryProp(P_ALIGN)<500)  {
        tell_object(enemy,
        "So kannst Du den Teufel nie verletzen!\n");
        return::Defend(0, dam_type, spell, enemy);  }
        */

  if(enemy->QueryProp(P_ALIGN)>700 && random(2))  {
    tell_object(enemy,
        "Der Teufel fuerchtet sich nicht vor Deinem guten Charakter!\n");
    return::Defend(dam/2, dam_type, spell, enemy);  }             

    return ::Defend(dam, dam_type, spell, enemy) ;
}		


void spell_stop(object enemy, int damage, mixed dam_type)   {

  if( !enemy->QueryProp(P_PARALYZED) )
    enemy->SetProp(P_PARALYZED, ([
          PARALYZE_TIME: 2+random(4), 
          PARALYZE_MSG: "Aber Du bist doch voellig gelaehmt!!!!\n",
          PARALYZE_MSG_OTHER: "Steht stumm herum!!!",
          PARALYZE_END: "Du erwachst wieder aus Deiner Laehmung.\n",
          PARALYZE_END_OTHER: "%s erwacht wieder aus "+
            TP->QueryPossPronoun(FEMALE, WEN, SINGULAR) +" Laehmung.\n"]));
}          


