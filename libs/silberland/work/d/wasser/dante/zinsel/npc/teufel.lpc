varargs void die( int poisondeath )
{
  int i;
  object *u;
  object pakt;
  if( !TP->QueryProp(P_TESTPLAYER) && !IS_LEARNER(TP) )
  {
    write_file("/d/wasser/dante/zinsel/log/teufel",
        ctime()+": "+CAP(getuid(TP))+" Teufel umgebracht.\n"); 
    shout("Gott hat "+this_player()->name(WEM,1)+" geholfen, Luzifer zu besiegen!\n");

    for(i = sizeof(u = users()) - 1; i >= 0; i--)
    {
      if( pakt = present("TEUFEL_SEELE", u[i]) )
      {
        pakt->remove();
        tell_object(u[i],"\n\n\nDein Pakt mit dem Teufel loest sich auf!!!!\n\n\n\n");
        write_file("/d/wasser/dante/zinsel/log/teufel",
            ctime()+": Pakt mit "+CAP(getuid(u[i]))+" endet.\n"); 
      }
    }
  }
  ::die(poisondeath);
}


void tot()
{
  if(environment(TO)!=environment(TP)) return;	

  if ( TP->QueryProp(P_ALIGN) > 500)
  {
    //   Kill(TP);
    write("Luzifer bruellt laut: Du bist zu gut "+TPN+"! Stirb!\n");
    write(BS(
          "Ein Blitz schiesst aus den Nuestern des Teufels herab und trifft Dich!"));

    TP->do_damage(10+random(10)); //fuer paladine fein:-)
  }

  if(TP->QueryProp(P_ALIGN) <-500)
  {
    write("Luzifer sagt grinsend: "+TPN+", Du bist boese, freut mich sehr!\n");
  }
  else
    write("Luzifer lacht Dich, "+TPN+" aus!\n");
}

int _query_align() { return -1000; }

int _query_disable_attack() { return 0; }

int _query_disable_spells() { return 0; }

int _query_wimpy() { return 0; }

int _query_poison() { return 0; }


