inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>


void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_GENDER, MALE);

AddId(({"warzengnom", "gnom"}));
SetProp(P_ARTICLE, 1);

SetProp(P_HANDS, ({" mit seinem ekeligen Haenden", 100,DT_BLUDGEON}));
SetProp(P_BODY, 30);
SetProp(P_SIZE, 50);
SetProp(P_ALIGN, -100);

SP(P_RACE, "Gnom");


SetProp(P_HEAL,-10);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC, 3);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "kommt stinkend herein");
SetProp(P_MSGOUT, "geht stinkend und sabbernd");
SetProp(P_MMSGIN, "taucht ploetzlich neben Dir auf");
SetProp(P_MMSGOUT, "verschwindet");

SetProp(P_DIE_MSG, " faellt sabbernd tot um!\n");

SetChats(5,({
"Der Warzengnom sagt: Du Warzenschwein!\n",
"Der Warzengnom sagt: WARZEN!\n",
"Der Warzengnom stinkt erbaermlich.\n",
"Der Warzengnom sabbert herum.\n",
"Der Warzengnom sagt: DU stinkst ja!\n"}));


AddInfo(DEFAULT_INFO,({
"grinst nur bloed.\n",
"sagt: Du Warzenschwein!\n"}));


}




