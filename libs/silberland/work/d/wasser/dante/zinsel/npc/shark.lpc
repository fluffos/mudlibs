//hai dante sl nosti 97-99

inherit "std/npc";
inherit "std/npc/spells";

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <moving.h>
#include <npc.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>


int i;
string *was;

void create()
{
  if (!is_clone(this_object())) return;  
  ::create();

  was=({"Tiger","Mako","Panzer","Peitschen","Hammer",
      "Riff","Graumaul","Blutbad","Spitzmaul","Silber",
      "Grossdante", "Blut","Zombie","Vampir","Frosch","Ammen","Prokop"});

  i=random(sizeof(was));

  AddId(({"hai" , ""+LOWER(was[i])+"hai"}));
  create_default_npc(10+random(6));
  SetProp(P_AGGRESSIVE, 0.5*random(2));
  SetProp(P_ALIGN, -150);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_SHORT, "Ein aggressiver "+was[i]+"hai");
  SetProp(P_LONG, (
        "Dieser "+was[i]+"hai ist einer der gefaehrlichen Bewohner des "
        "Meeres. Je nach Art sind sie mal gefaehrlicher, mal weniger "
        "aggressiv!"));
  set_living_name("shark");
  SetProp(P_RACE, "Fisch");
  SetProp(P_NAME, ""+was[i]+"hai");
  SetProp(P_GENDER, MALE);      
  SetProp(P_DIE_MSG, " versinkt in den Tiefen des Meeres.\n");
  SetProp(P_NAME_ADJ, "aggressiv");
  SetProp(P_RACE, ""+was[i]+"hai");
  SetProp(P_BODY, 20+random(20));
  SetProp(P_SIZE, 290); 
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", 100+random(150), DT_RIP}) );     
  SetProp(P_MSGIN, "kommt ploetzlich angeschwommen");
  SetProp(P_MSGOUT, "schwimmt an Dir vorbei");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, "Der Hai verschlingt @WEN gierig.\n" }) );
  SetProp(P_SPELLRATE, 70);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE: 0.5, DT_LIGHTNING:0.3, DT_WATER: -1]) );

  SUID;
  CLONEME("d/wasser/dante/zinsel/obj/flo");

  SetChats(15,({
        "Der "+was[i]+"hai schwimmt um Dich herum!\n",
        "Der "+was[i]+"hai schwimmt an Dich heran!\n",
        "Der "+was[i]+"hai schnappt nach Dir.\n",
        "Der "+was[i]+"hai taucht kurz unter aber sofort wieder auf.\n",
        "Der "+was[i]+"hai schlaegt mit seinen Flossen!\n",
        "Der "+was[i]+"hai denkt . o O 'Nostromo schmeckte kotzig!\n"}));

  AddSpell(6, 200+random(100),
      "Der "+was[i]+"hai beisst Dir ins Bein!\n",
      "Der "+was[i]+"hai beisst @WEM ins Bein!\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 300+random(100),
      "Der "+was[i]+"hai beisst Dir in den Arm!\n",
      "Der "+was[i]+"hai beisst @WEM in den Arm!\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 400+random(100),
      "Der "+was[i]+"hai beisst Dir ins Bein!\n",
      "Der "+was[i]+"hai beisst @WEM ins Bein!\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));


  AddDefaultSpell(1,100,DS_PARALYZE,
      "Der "+was[i]+"hai packt Dich und klemmt Dich in seinem Maul fest!\n",
      "Der "+was[i]+"hai packt @WEN und klemmt @WEN in seinem Maul fest!\n", 
      2);


}
