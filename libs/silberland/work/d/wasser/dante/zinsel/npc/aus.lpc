//aussaetziger sl dante 99

inherit "std/mnpc";

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>



create()
{
  if (!is_clone(this_object())) return;  
  ::create();




  AddId(({"aussaetziger", "aussaetzige","kreatur"}));
  create_default_npc(11);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_ALIGN, 150);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_SHORT, "Ein stinkender, halbverwester Aussaetziger");
  SetProp(P_LONG, BS(
  "Diese arme Kreatur die Du da vor Dir siehst, erregt sofort Dein "
  "Mitleid. Einst war es voll ein normaler Bewohner dieser Welt, "
  "doch nun ist er grausig entstellt und scheint zu verfaulen. WAEHHH!!! "
  "Was koennte ihn so zugerichtet haben?!"));
  SP(P_ARTICLE, 0);
  
//SP(P_NAME_ADJ, ({"stinkend","halbverwest"}));
  SetProp(P_NAME, ({"der Aussaetzige",
  "des Aussaetzigen",
  "dem Aussaetzigen",
  "den Aussaetzigen"}));
  SetProp(P_GENDER, MALE);      

SP(P_DIE_MSG, " bricht jammernd nieder.\n");

  SetProp(P_RACE, "Aussaetziger");
  SetProp(P_BODY, 20+random(10));
  SetProp(P_SIZE, 200); 
  SetProp(P_HANDS, ({" mit seinen faulen Armen", 70, DT_BLUDGEON}) );     
  SetProp(P_MSGIN, "humpelt stoehnend hier her");
  SetProp(P_MSGOUT, "humpelt stoehnend");
  SetProp( P_REJECT, ({ REJECT_KEEP, "Der Ausssaetzige jammert nur.\n" }) );
 
   SetProp(P_MMSGIN, "humpelt zu Dir");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, "/d/wasser/dante/zinsel/room/" );
  SetProp(P_MNPC_WAIT, ({ 20, 15, 30}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/isle_04");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+
         MOV_MOVES + MOV_SPECIAL+MOV_BACKWARDS);


 
  
  SP(P_INFO,BS(
  "Die arme Kreatur leidet am Zombievirus!"));
  AI(({"virus","zombievirus"}),
  "Huete Dich davor!!!", "jammert: ");
  AI(({"zombie","zombies"}),
  "Sie leben unter der Insel! Pass ja auf!", "stoehnt: ");
  AddInfo(DEFAULT_INFO, ({
  	"sagt: Huete Dich vor dieser Insel!\n",
  	"sagt: Verschwinde bloss!\n",
  	"stoehnt nur laut auf.\n",
  	"sagt: DIE ZOMBIES KOMMEN!!!\n"}));
  
  AI("insel",
  "Verflucht ist sie! Verflucht!", "sagt: ");
  AI(({"zeichner","comiczeichner"}),
  "Der kann Dir helfen!!! Gib ihm Geld!", "sagt: ");
  AI("karte",
  "Hmm, nein! Gebe ich Dir nicht!", "sagt: ");
  AI("baum",
  "In den Baum kann man klettern, Und zwar im Osten!");
  AI(({"meer", "wasser"}),
  "sagt: Weit ist es und nass.\n");
  AI(({"heilung","medikament","hilfe"}),
  "Ja, es gibt etwas, aber wo?! Na egal, fuer mich ist es zu spaet!", "sagt: ");
  
  
  
  	
   SetChats(5,({
   "Der Aussaetzige stoehnt laut auf.\n",
   "Eiter rinnt an dem Aussaetzigen herab!\n",
   "Eine Beule platzt am Aussaetzigen auf!\n",
   "Der Aussaetzige sagt: DIE ZOMBIES KOMMEN!!!AHHH!!\n",
   "Der Aussaetzige bruellt: Erloese mich!\n",
   "Etwas Haut faellt vom Aussaetzigen zu Boden!\n"}));
     
SUID;
if(!random(5))  CLONEME("/d/wasser/dante/zinsel/obj/zkarte");   
   
   

}
