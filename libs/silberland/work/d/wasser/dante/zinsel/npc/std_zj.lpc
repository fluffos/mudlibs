        case 9: CLONEME( "/d/ebene/obj/ruestung/biberfell"); break;
        case 10:CLONEME( "/d/dschungel/dante/weg/armour/dtigerfell"); break;
      }
    if( random(100)<50 ) // Hose
      switch(random(6) )
      {
        case 0: CLONEME( "/p/armour/trousers/fellhose"); break;
