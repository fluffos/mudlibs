    if( random(100)<50 ) // Schuhe
      switch(random(8) )
      {
        case 0: CLONEME( "/p/armour/boots/lederstiefel"); break;
        case 1: CLONEME( "/p/armour/boots/sandalen"); break;
        case 2: CLONEME( "/p/armour/boots/lederschuhe"); break;
        case 3: CLONEME( "/d/gebirge/eros/ruestung/baerenpranken"); break;
