inherit "std/mnpc";
inherit "/std/npc/spells.lpc";


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <mnpc.h>

#include "/players/dante/myowndefine.h"

int x=1+random(2);
int i, level, tote;
string rasse, rang;
object money, kno;



object da=find_living("dante");

string *was=({"gross","klein","mutig", "duenn","dick","fett","haesslich",
    "todesmutig","arrogant","quirlig","einaeugig","dumm","wagemutig","erfahren",
    "unerfahren","stark","schwach","behindert","blind","taub","verwundet","angeschlagen",
    "fit","verletzt"});

_query_poison() { return 0; }


void create()
{

  if (!is_clone(TO)) return;
  ::create();



  switch(random(134))  {

    case 0..15:
      level=1;
      rang="Zombieopfer";
      break;
    case 16..27:
      level=2;
      rang="Zombieliebling";
      break;


    case 28..39:
      level=3;
      rang="Zombieknuddler";
      break;	

    case 40..50:
      level=4;
      rang="Zombiefeind";
      break;	

    case 51..65:
      level=5;
      rang="Zombieschlaeger";
      break;

    case 66..75:
      level=6;
      rang="Zombiehasser";
      break;

    case 76..85:
      level=7;
      rang="Zombiemetzler";
      break;

    case 86..95:
      level=8;
      rang="Zombiemoerder";
      break;

    case 96..110:
      level=9;
      rang="Zombieschrecken";
      break;

    case 111..122:
      level=10;
      rang="Zombievernichter";
      break;

    case 123..133:
      level=11;
      rang="Erzzombieschlaechter";
      break;
    default: 
      level=6;
      rang="Zombiehasser";
  }



  tote=1+level*level+random(20)+level;

  switch (random(126))
  {
    case 0..4 : rasse = "Menschen"; break;
    case 5..8 : rasse = "Zwergen"; break;
    case 9..12 : rasse = "Elfen"; break;
    case 13..15 : rasse = "Hobbit"; break;
    case 16..19: rasse= "Troll"; break;
    case 20..24: rasse= "Dunkelelfen"; break;
    case 25..30: rasse = "Oger"; break;
    case 31..35 : rasse = "Riesen"; break;
    case 36..40 : rasse = "Vampir"; break;
    case 41..45 : rasse = "Daemonen"; break;
    case 46..50 : rasse = "Ork"; break;
    case 51..55: rasse= "Goblin"; break;
    case 56..60: rasse= "Hobgoblin"; break;
    case  61..65: rasse = "Skelett"; break; 
    case 66..70 : rasse = "Drachen"; break;
    case 71..75 : rasse = "Giganten"; break;
    case 76..80 : rasse = "Titanen"; break;
    case 81..85 : rasse = "Monster"; break;
    case 86..90: rasse= "Shogotten"; break;
    case 91..100: rasse= "Tireks"; break;
    case 101..105: rasse = "Balrog"; break;
    case 106..110: rasse = "Zolom"; break;
    case 111..115: rasse = "Riesen"; break;
    case 116..125: rasse ="Drachen"; break;

  }



  i=random(sizeof(was));



  SP(P_RACE, "Zombiejaeger");

  SetProp(P_SHORT, "Ein "+was[i]+"er "+rasse+ "zombiejaeger des Ranges "+rang+"");

  SetProp(P_LONG, BS(
        "Vor Dir siehst Du ein Mitglied der Zombiejaeger. Einer Bruderschaft deren "
        "Lebensaufgabe es ist alle Zombies zu vernichten! Hier haben wir einen "
        ""+was[i]+"en Zombiejaeger der zur Untergruppe der "+rasse+"zombiejaeger gehoert. "
        "Er ist spezialisiert auf das toeten von: "+rasse+"! Dieser hier hat den "
        "Rang eines "+rang+" innerhalb der Bruderschaft der Zombiejaeger. "
        "Dieser hier hat bereits "+tote+" Zombies erschlagen!"));




  //SetProp(P_NAME,  rasse+"zombiejaeger vom Range eines "+rang+"");

  SP(P_NAME, rasse+"zombiejaeger");

  SP(P_ARTICLE, 1);

  SetProp(P_GENDER, MALE);
  AddId(({ "jaeger","zombiejaeger", "ZJ", lower_case(rasse)+"zombiejaeger"}));

  create_default_npc(12+level*2);


  set_living_name("zombiejaeger");


  SetProp(P_HANDS, ({" mit seinen Haenden",100+level*20,({DT_BLUDGEON, DT_RIP})}));
  SetProp(P_BODY, 50+level*10);
  SetProp(P_SIZE, 100 + random(200));
  SetProp(P_ALIGN, 300+level*50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, level);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, level);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_UNHOLY: -0.1, DT_TERROR:-0.2,DT_FIRE:0.3, DT_ACID:0.1,
        DT_BLUDGEON:0.2, DT_HOLY: -0.3]));

  SetProp(P_DIE_MSG,  " stirbt mit den Worten: Tod allen ZOMBIES!!!\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "bruellt irgendetwas von 'Toetet alle Zombies!'.\n");

  SetProp(P_MSGIN, "stuermt herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "laeuft in die Zentrale der Zombiejaeger");


  SetProp(P_MNPC_AREA, "/d/wasser/dante/zinsel/room/" );
  SetProp(P_MNPC_WAIT, ({ 30, 30, 50 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/wasser/dante/zinsel/room/z"+x+"");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS+
      MOV_INFIGHT+    MOV_MOVES + MOV_SPECIAL+MOV_BACKWARDS);


  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Der Zombiejaeger sagt: Danke! Toete lieber Zombies!"}));
  SetProp(P_SPELLRATE,level*7+20);

  AddSpell(5,100+level*30, 
      "Der "+rasse+"zombiejaeger tritt Dir in den Bauch.\n",
      "Der "+rasse+"zombiejaeger tritt @WEM in den Bauch.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
  AddSpell(3,200+level*30,
      "Der "+rasse+"zombiejaeger tritt Dir ins den Gesicht.\n",
      "Der "+rasse+"zombiejaeger tritt @WEM ins Gesicht.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(1,300+level*30,
      "Der "+rasse+"zombiejaeger sticht Dir ins Auge.\n",
      "Der "+rasse+"zombiejaeger sticht @WEM ins Auge.\n",
      DS_BLIND,([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(2,100+level*30,DS_POISON,
      "Der "+rasse+"zombiejaeger spuckt nach Dir.\n",
      "Der "+rasse+"zombiejaeger spuckt nach @WEM.\n" );  


  SUID;

  money = CLONEOB ("/obj/money");
  money->SetProp(P_AMOUNT, 200+level*50);
  money->move(ME);

  switch(level)  {

    case 1:
      if(!random(3)) CLONEME("/p/armour/boots/lederschuhe");
