      if(!random(2)) CLONEME("/d/dschungel/dante/weg/weapon/demesser");
      break;

    case 2..3:
      if(!random(3)) CLONEME("/p/armour/boots/fellstiefel");
      if(!random(3)) CLONEME("/p/armour/helm/lederhelm");
