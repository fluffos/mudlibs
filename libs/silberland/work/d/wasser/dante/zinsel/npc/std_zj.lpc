        case 16:CLONEME( "/d/wasser/stahldorn/knarkh/obj/knarkhpanzer"); break;
        case 17:CLONEME( "/d/wasser/stahldorn/knarkh/obj/p_knarkhpanzer"); break;
      }
    if( random(100)<70 ) // Helm
