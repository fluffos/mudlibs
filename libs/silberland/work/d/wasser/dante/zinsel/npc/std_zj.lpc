        case 2: CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerhelm"); break;
        case 3: CLONEME( "/d/dschungel/feyaria/tijara/armour/bronzehelm"); break;
        case 4: CLONEME( "/p/armour/helm/tellerhelm"); break;
