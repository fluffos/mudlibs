        case 5: CLONEME( "/d/wasser/stahldorn/knarkh/obj/knarkhhose"); break;
      }
    if( random(100)<40 ) // Armschienen 
      switch(random(6) )
      {
        case 0: CLONEME( "/p/armour/bracers/bronzearmschienen"); break;
        case 1: CLONEME( "/p/armour/bracers/eisenarmschienen"); break;
        case 2: CLONEME( "/d/ebene/lamuerte/burg/obj/trollschienen"); break;
        case 3: CLONEME( "/p/armour/bracers/mithrilarmschienen"); break;
