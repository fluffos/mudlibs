      if(!random(2)) CLONEME("/p/armour/shield/messingschild");
      if(!random(2)) CLONEME("/d/luft/dante/wolken/weapon/lschwert");
      break; 

    case 9:
      if(!random(3)) CLONEME("/d/dschungel/dante/weg/armour/dhaut");
      if(!random(3)) CLONEME("/p/armour/boots/kampfstiefel");
      if(!random(3)) CLONEME("/p/armour/helm/titanhelm");
      if(!random(4)) CLONEME("/p/armour/bracers/titanarmschienen");
      if(!random(2)) CLONEME("/p/armour/armour/titanpanzer");
      if(!random(2)) CLONEME("/p/armour/shield/bronzeschild");
      if(!random(2)) CLONEME("/d/luft/dante/wolken/weapon/lschwert");
      if(!random(4)) CLONEME("/p/armour/belt/guertel");
      break; 

    case 10:
      if(!random(3)) CLONEME("/p/armour/cloak/wolfsfell");
      if(!random(3)) CLONEME("/p/armour/boots/kampfstiefel");
      if(!random(5)) CLONEME("/p/armour/helm/topfhelm");
      if(!random(4)) CLONEME("/p/armour/bracers/eisenarmschienen");
      if(!random(2)) CLONEME("/d/dschungel/dante/stein/armour/dstpanzer");
      if(!random(2)) CLONEME("/p/armour/shield/eisenschild");
      if(!random(2)) CLONEME("/d/luft/dante/wolken/weapon/lschwert");
      if(!random(3)) CLONEME("/p/armour/belt/guertel");
      if(!random(4)) CLONEME("/p/armour/ring/ring");
      break; 
    default:

  }


  if(level>10)  {

    if( random(100)<80 )  
