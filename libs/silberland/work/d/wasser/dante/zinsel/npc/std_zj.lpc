        case 2: CLONEME( "/d/ebene/lamuerte/wwald/obj/ogerpanzer"); break;
        case 3: CLONEME( "/d/dschungel/feyaria/tijara/armour/bronzepanzer");
                break;
        case 4: CLONEME( "/p/armour/armour/kettenhemd"); break;
        case 5: CLONEME( "/p/armour/armour/lederruestung"); break;
        case 6: CLONEME( "/p/armour/armour/mithrilpanzer"); break;
        case 7: CLONEME( "/d/gebirge/eros/ruestung/schuppenpanzer"); break;
        case 8: CLONEME( "/p/armour/armour/plattenpanzer"); break;
        case 9: CLONEME( "/p/armour/armour/titanpanzer"); break;
        case 10:CLONEME( "/p/armour/armour/kettenpanzer"); break;
        case 11:CLONEME( "/p/armour/armour/lederpanzer"); break;
        case 12:CLONEME( "/d/gebirge/angrox/4elem/obj/armour/steinpanzer"); break;
        case 13:CLONEME( "/d/gebirge/thor/hoehlenquest/armour/kpanzer"); break;
        case 14:CLONEME("/d/gebirge/speedy/trollager/armour/schwtrollruestung");
