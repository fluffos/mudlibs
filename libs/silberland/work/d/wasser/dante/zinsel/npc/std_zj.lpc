      if(!random(2)) CLONEME("/p/armour/shield/kupferschild");
      if(!random(2)) CLONEME("/d/dschungel/dante/weg/weapon/gnopei");
      break; 

    case 8:
      if(!random(3)) CLONEME("/p/armour/boots/eisenschuhe");
      if(!random(3)) CLONEME("/p/armour/helm/lederhelm");
      if(!random(3)) CLONEME("/p/armour/gloves/lederhandschuhe");
      if(!random(2)) CLONEME("/p/armour/bracers/lederarmschienen");
