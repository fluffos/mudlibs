}


void InformDefend(object enemy) {
  Kill(enemy);
}


void init()
{
  ::init();
  if(IS_WIZARD(TP))  { return;  }

  if (TP && TP->id("ZJ")) AddDefender(TP);

  if(!interactive(TP) && TP->id("zombie") )  {
    Kill(TP);
    tell_room(environment(TO), BS(
          "Der Zombiejaeger stuerzt sich voller Wut auf "+TP->name(WEN)+"!"));
  }

}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  call_out("nimm_alles", 0);
}



void nimm_alles()  {
  if(present("leiche", environment(TO)))  {
    command("nimm alles aus leiche");
  } 
}



int Defend(int dam, string dtype, mixed spell, object enemy)
{


  if(enemy->id("zombie")) 
    return ::Defend(0, dtype, spell, enemy);
  else if( interactive(enemy))
    SetProp( P_PREFERED_ENEMY, ({80,enemy}));

  return ::Defend(dam, dtype, spell, enemy);
}

