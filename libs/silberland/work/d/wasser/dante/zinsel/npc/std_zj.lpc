        case 3: CLONEME( "/p/armour/cloak/wolfsfell"); break;
        case 4: CLONEME( "/d/dschungel/feyaria/kueste/armour/jaguarfell"); break;
        case 5: CLONEME( "/d/gebirge/eros/ruestung/grizzlyfell"); break;
        case 6: CLONEME( "/p/armour/cloak/baerenfell"); break;
