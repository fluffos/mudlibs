//zombielanze dante sl 99

inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


create()
{

if (!is_clone(this_object()))
return;
::create();


SetProp (P_NAME, "Zombielanze");
SetProp (P_GENDER, FEMALE);
SP(P_NAME_ADJ, "dreigezackt");
SetProp (P_VALUE, 805+random(901));
SetProp (P_WEIGHT, 1200);
SP(P_SIZE, 220);
SetProp (P_WEAPON_TYPE, WT_SPEAR);
SP(P_LONG, BS(
"Diese staehlerne Lanze weist an ihrer Spitze drei mit Haken besetze Zacken "
"auf, mit denen man seine Feinde so richtig schoen "
"aufspiessen kann."));
AD("spitze",
"An der Spitze hat diese Lanze drei hakenbesetze Zacken.");
AD(({"zacken"}),
"Die drei Zacken weisen Haken auf.");
AD("haken",
"Die Haken reissen tiefe Wunden in Deine Feinde.");

AddId(({"lanze","zombielanze"}));

SP(P_SHORT, "Eine dreigezackte Zombielanze");

SetProp (P_DAM_TYPE, ({ DT_TERROR, DT_RIP, DT_PIERCE}));
SetProp (P_NOBUY, 1);
SetProp (P_WC, 222);
SetProp (P_WC_FIX, 41);
SetProp (P_NR_HANDS, 2);
SetProp (P_MATERIAL, ([MAT_STEEL:100]));

}
