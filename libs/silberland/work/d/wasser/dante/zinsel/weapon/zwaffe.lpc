/*

Diese waffe ist wenn man sie so cloned nix....
wie sie aussieht, was sie ist, wird im mystagogen entschieden
sie kann momentan 7 versch waffenarten sein....
man bekommt sie nur wenn man sich durch die insel kaempft und alle 4 goetzen um nietet
also EXTREM schwer....


*/




inherit "std/weapon";

#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

init()  {
	::init();
	if(interactive(environment(TO)))  {
call_out("check", 1);  } }

check()  {
if(!id("OK"))  { remove();}  

}

	

create()
{

if (!is_clone(this_object()))
return;
::create();
AddId("zwaffe");
SP(P_NAME_ADJ, "unheimlich");
SetProp (P_VALUE, 10000);
SetProp (P_WEIGHT, 1000);
SetProp (P_MAGIC, 1);
SetProp(P_INFO, BS(
"Diese Waffe gehoert zu den Besten dieser Welt! Huete sie gut!"));

SetProp (P_NOBUY, 1);
SetProp (P_WC_FIX, 60);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_MISC_MAGIC:90, MAT_BLOOD:10,]));
SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 15, A_INT:15, A_DEX:15]));

}



