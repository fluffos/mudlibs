//zombieschwert dante sl 99

inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


void create()
{

  if (!is_clone(this_object()))
    return;
  ::create();


  SetProp (P_NAME, "Zombieschwert");
  SetProp (P_GENDER, NEUTER);
  SP(P_NAME_ADJ, "zweihaendig");
  SetProp (P_VALUE, 1305+random(101));
  SetProp (P_WEIGHT, 1900);
  SP(P_SIZE, 166);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SP(P_LONG, BS(
        "Diese Waffe der Zombies ist ein sehr langes Schwert, das man "
        "nur beidhaendig verwenden kann. Seine Klinge ist aus blutrotem "
        "Stahl und sicher so lange wie ein Zwerg."));

  AD("klinge",
      "Die Klinge glaenzt blutrot.");
  AD("stahl",
      "Blutrot!");

  AddId(({"schwert","zombieschwert","zweihaendiges schwert"}));

  SP(P_SHORT, "Ein zweihaendiges Zombieschwert");

  SetProp (P_DAM_TYPE, ({ DT_TERROR, DT_SLASH, DT_PIERCE}));
  SetProp (P_NOBUY, 1);
  SetProp (P_WC, 225);
  SetProp(P_WC_BONUS, (["zombie":100]) );
  SetProp (P_WC_FIX, 40);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, ([MAT_STEEL:100]));
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 15]));

}
