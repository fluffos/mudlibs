//zombieaxt dante sl 99

inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

create()
{

  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Eine staehlerne Zombieaxt");
  SetProp(P_NAME, "Zombieaxt");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "staehlern");
  SetProp(P_LONG, BS(
        "Diese Axt stammt von der unseligen Insel der Zombies. Sie besteht "
        "aus dunklem Stahl, ist aber trotzdem nicht so schwer wie man es "
        "erwarten wuerde. Der Griff weist seltsame Zeichen auf."));
  AD("stahl",
      "Hart und erbarmungslos.");
  AD(({"griff","zeichen"}),
      "Der Griff ist mit seltsamen Zeichen versehen. Was sie bedeuten, "
      "weiss wohl nur ein echter Zombie.");

  AddId(({"axt","zombieaxt"}));

  SetProp(P_VALUE, 2205+random(1041));
  SetProp(P_WEIGHT, 2999);
  SetProp(P_SIZE, 100);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE, ({ DT_TERROR, DT_RIP, DT_SLASH}));
  SetProp(P_NOBUY, 1);
  SetProp(P_WC, 261);
  SetProp(P_WC_BONUS, (["zombie":100]) );
  SetProp(P_WC_FIX, 15);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 23]));

}
