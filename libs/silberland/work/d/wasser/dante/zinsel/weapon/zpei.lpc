//zombiepeitsche dante sl 99

inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

void create()
{

  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Eine zwoelfschwaenzige Zombiepeitsche");
  SetProp (P_NAME, "Zombiepeitsche");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "zwoelfschwaenzig");
  AddId(({"peitsche","zombiepeitsche"}));


  SP(P_LONG, BS(
        "Diese Peitsche gehoerte einst einem unseligen Zombie, der die "
        "Insel der Zombies bewohnt. Vom ledernen Griff gehen zwoelf "
        "stahlspitzen verstaerkte Riemen weg, die in jeweils wiederum "
        "zwoelf Kugeln aus Stahl enden. Eine boesartige Waffe, durch und "
        "durch!"));
  AD("griff",
      "Der Griff ist aus Leder.");
  AD("leder",
      "Hartes Zwergenleder.");
  AD("zwergenleder",
      "Naja, die Zombies haben sie gehaeutet.");
  AD("riemen",
      "Die Riemen sind stahlverstaerkt und enden in jeweils zwoelf "
      "mit Stahlspitzen besetzen Kugeln!");
  AD(({"stahlspitze","spitze","spitzen","stahlspitzen"}),
      "Die Stahlspitzen machen sicher gemeine Wunden!");
  AD(({"kugel","kugeln"}),
      "Die Kugeln sind mit Stahlspitzen versehen. AUA!");

  AD("stahl",
      "Hart und erbarmungslos.");

  SetProp (P_VALUE, 1005+random(101));
  SetProp (P_WEIGHT, 900);
  SetProp (P_SIZE, 179);
  SetProp (P_WEAPON_TYPE, WT_WHIP);
  SetProp (P_DAM_TYPE, ({ DT_TERROR, DT_RIP, DT_WHIP}));
  SetProp (P_NOBUY, 1);
  SetProp (P_WC, 180+random(15));
  SetProp (P_WC_BONUS, (["zombie":100]) );
  SetProp (P_WC_FIX, 20);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_STEEL:50 , MAT_LEATHER:50]));
  SetProp (P_WIELD_RESTRICTIONS, ([A_DEX: 13]));
}
