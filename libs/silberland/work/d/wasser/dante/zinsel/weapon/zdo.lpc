//zombiedolch dante sl 99

inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


create()
{

if (!is_clone(this_object()))
return;
::create();


SetProp (P_NAME, "Zombiedolch");
SetProp (P_GENDER, MALE);
SP(P_NAME_ADJ, "giftig");
SetProp (P_VALUE, 505+random(101));
SetProp (P_WEIGHT, 500);
SetProp (P_WEAPON_TYPE, WT_KNIFE);
SP(P_LONG, BS(
"Dieser Zombiedolch hat eine gruene, giftige Klinge, aus der "
"ab und zu ein Tropfen fliesst. Eine seltsame Waffe!"));

AD("klinge",
"Die Klinge besteht aus gruenem Stahl.");
AD("stahl",
"Er ist gruen...");
AD("tropfen",
"Diese Tropfen sind pures Gift!");
AD("gift",
"Sei vorsichtig!");
SP(P_INFO, BS(
"Solltest Du dieser Waffe nicht gewachsen sein, wird sie "
"Dir schaden..."));

AddId(({"dolch","zombiedolch"}));

SP(P_SHORT, "Ein giftiger Zombiedolch");

SetProp (P_DAM_TYPE, ({ DT_TERROR, DT_RIP, DT_PIERCE}));
SetProp (P_NOBUY, 1);
SetProp (P_WC, 130);
SetProp (P_WC_FIX, 55);
SetProp (P_NR_HANDS, 1);
SP(P_SIZE, 30);
SetProp (P_MATERIAL, ([MAT_STEEL:100]));
SP(P_HIT_FUNC, TO);
}




int HitFunc(object enemy)   {
	
if(TP->QueryAttribute(A_DEX)<15)   {
tell_object(environment(TO),
"Gift spritzt aus der Klinge und trifft Dich!\n");
TP->AddPoison(1);

 tell_room(environment(TP),
CAP_TPN+" vergiftet sich selbst mit dem Zombiedolch!!!\n",
  ({TP}));
		return 0; }
		

		
		else
		
	if(!random(20))  {
  
  tell_object(environment(TO),
  "Gift spritzt aus der Klinge direkt auf "+enemy->name(WEN)+"!\n");
  tell_room(environment(TP),
  "Aus dem Zombiedolch von "+TPN+" spritzt Gift"
  " auf "+enemy->name(WEN)+"!\n",
  ({TP}));
  if(enemy->QP(P_POISON) <= 3 ) {
  enemy->AddPoison(1);//reicht!!!
  }
  return 0;  }
  return 0; }
  		
	
