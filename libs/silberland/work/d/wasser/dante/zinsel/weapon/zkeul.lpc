//zombiekeule dante sl 99

inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Zombiekeule");
SetProp (P_GENDER, FEMALE);
SP(P_NAME_ADJ, "hart");
SetProp (P_VALUE, 805+random(801));
SetProp (P_WEIGHT, 1700);
SP(P_SIZE, 90);
SetProp (P_WEAPON_TYPE, WT_CLUB);
SP(P_LONG, BS(
"Diese Keule besteht aus haertestem Eichenholz, das mit staehlernen "
"Spitzen bestueckt wurde. Ein Zombie war einst der Besitzer dieser "
"Waffe."));

AD("stahl",
"Hart und erbarmungslos.");
AD(({"eichenholz","holz"}),
"Das Holz wurde ueber dem Feuer gehaertet und ist so besonders "
"stabil.");
AD(({"spitze","spitzen"}),
"SPITZ!!!");

AddId(({"keule","zombiekeule"}));

SP(P_SHORT, "Eine harte Zombiekeule");

SetProp (P_DAM_TYPE, ({ DT_TERROR, DT_BLUDGEON, DT_PIERCE}));
SetProp (P_NOBUY, 1);
SetProp (P_WC, 149);
SetProp (P_WC_FIX, 35);
SetProp (P_NR_HANDS, 1);
SetProp (P_MATERIAL, ([MAT_STEEL:10, MAT_OAK:90]));
SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 13]));

}
