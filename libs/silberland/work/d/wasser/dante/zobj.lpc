inherit "std/thing";
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <wizlevels.h>
#include <moving.h>
#include <rooms.h>
#include <combat.h>
object shadow_ob;



init()  {
	::init();
   
   if(!is_clone(TO))  { remove();  }
   
   if(!environment(TO))  {
   	remove();
   	}	

  }	


void create(){
  ::create();
  SetProp(P_NAME,"Zombieobjekt");
  SetProp(P_SHORT,"Ein Zombieobjekt");
  SetProp(P_LONG, BS(
    "<zhilfe>."));
    
  SetProp(P_ARTICLE,1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOBUY,1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP,1);
  //SetProp(P_SHOW_INV,1);
  SetProp(P_GENDER,NEUTER);
  SP(P_AUTOLOADOBJ, 1);

AddId(({"zo","objekt", "zombieobjekt"}));

  AddCmd(({"zmutationan"}),"an");
  AddCmd(({"zmutationaus"}),"aus");
  AddCmd("zhilfe","zhilfe");  
}


aus(str,pl){

  if(!pl) pl=this_player();
  notify_fail("cmd: zmutationaus\n");
     
     if(!shadow_ob)  {
     	write(BS(
     	"Du bist gar kein Zombie!"));
     	return 1;}
     else	
     
     shadow_ob->_tarn_turn_off(); 

write(BS(
"Du wirst wieder normal!"));

     tell_room(environment(pl), BS(
"Der Zombie vor Dir verfault urploetzlich. Dann steht auf einmal "
""+TP->name(WER)+" vor Dir."));
     

     return 1;
   }


nosave int an(string str){

  notify_fail("cmd: zmutationan\n");

      if(shadow_ob){
         write("Du bist schon mutiert!\n");
        return 1;
       }  


     if(!shadow_ob=clone_object("/d/dschungel/test/zombie_shadow")){
        write("Fehler: Bitte Dante verstaendigen!\n");
       return 1;
      }  
      shadow_ob->_tarn_turn_on(this_player(),1);
      write("Du mutierst zu einem Zombie.\n");
      tell_room(environment(this_player()),
      TP->name(WER)+" verschwindet ploetzlich! "
      "An Stelle von "+TP->name(WER)+" steht ploetzlich ein Zombie da!\n");
      
     return 1;                          
   }


void BecomesNetDead(){
 if(shadow_ob) shadow_ob->_tarn_turn_off();
}

void NotifyPlayerDeath(){
 if(shadow_ob) shadow_ob->_tarn_turn_off();
}
 
void BecomesNetAlive(){
 if(shadow_ob) shadow_ob->_tarn_turn_off();
}

zhilfe()  {
	write(BS(
    "zmutationan / zmutationaus"));
    return 1;  
    
    }
    	