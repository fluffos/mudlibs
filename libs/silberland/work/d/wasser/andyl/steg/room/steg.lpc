#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int muschel=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Auf einem Steg.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst hier auf einem Steg aus massiven "
                      +"Holzlatten. Auf dem Steg ist zusaetzlich eine "
                      +"kleine Huette aufgebaut in dem Fischernetze "
                      +"in den verschiedensten Groessen haengen. Unter den "
                      +"Netzen stehen mehrere Faesser in denen sich so "
                      +"wie es aussieht verschiedenste Fischkoeder befinden. "
                      +"Von der Decke der Huette baumeln an einem Seil "
                      +"befestigt eine stattliche Anzahl frisch gefangener "
                      +"Fische. Das Meer rauscht angenehm im Hintergrund und "
                      +"der Wind blaest Dir ins Gesicht. Das hier ist also " 
                      +"das Zuhause von Ortios dem Fischer.\n");

  // ROOM DESCRIPTION END;

  // DETAILS START

  AddDetail(({"meer", "horizont"}),
           "Weit erstreckt sich das aufbrausende Meer von hier bis "
           +"zum Horizont.\n");
  AddDetail(("hintergrund"),
           "Im Hintergrund hoerst Du das Rauschen des Meeres.\n");
  AddDetail(("zuhause"),
           "Das hier ist also das Zuhause von Ortios dem Fischer.\n");
  AddDetail(("huette"),
           "Die Huette besteht aus nicht viel mehr als vier Stuetzen "
           +"und einem Dach und ein paar Bretter die wohl als Waende "
           +"dienen duerften. Ein etwas karges Zuhause wie Du findest.\n");
  AddDetail(({"stuetze", "stuetze"}),
           "Ohne die wuerde die Huette wohl zusammenbrechen.\n");
  AddDetail(({"dach", "meisterwerk"}),
           "Ein Meisterwerk ist das Dach ja nicht gerade. Aber es scheint "
           +"zumindest dicht zu sein.\n"); 
  AddDetail(("decke"),
           "Von der Decke baumeln an einem Seil befestigt eine "
           +"stattliche Anzahl an gefangenen Fischen.\n");
  AddDetail(({"waende", "bretter"}),
           "Ein paar schlecht befestigte Bretter bilden die Waende "
           +"der Huette. Da drinnen muss es ziemlich zugig sein.\n");
  AddDetail(("wind"),
           "Kraeftig blaest der Wind in Dein Gesicht und zersaust Dein "
           +"Haar.\n");
  AddDetail(("gesicht"),
           "Hmm, Du hast jetzt irgendwie Schwierigkeiten Dein eigenes "
           +"gesicht zu betrachten.\n");
  AddDetail(("schwierigkeiten"),
           "Schwierigkeiten hat man wohl andauernd *seufz*.\n");
  AddDetail(({"haar", "frisur"}),
           "Mist, durch den Wind ist Deine tolle Frisur jetzt wieder "
           +"voellig hinueber.\n");
  AddDetail(({"himmel"}),
           "Es ist leicht bewoelkt und das scheint sich wohl auch in "
           +"naher Zukunft nicht zu aendern.\n");
  AddDetail(("zukunft"),
           "In die Zukunft schaun wuerdest Du wohl gerne, oder?\n");
  AddDetail(({"fischernetze", "fischernetz", "netz", "netze", "groessen", "groesse"}),
           "Fischernetze in verschiedenen Groessen haengen da in der "
           +"Huette. Die Netze braucht Ortios wohl fuer sein Arbeit. Einige "
           +"davon muss er wohl erst wieder flicken, denn manche sind "
           +"zerissen. Kann aber wahrscheinlich leicht bei dieser "
           +"Arbeit geschehen.\n");
  AddDetail(("arbeit"),
           "Hmmm, was wird wohl die Arbeit eines Fischers sein?\n");
  AddDetail(({"fischen", "fischerei", "kandidat", "punkte"}),
           "Bravo! Der Kandidat hat 100 Punkte!\n");
  AddDetail(({"fischer", "ortios"}),
           "So wie es aussieht scheint er gerade nicht hier zu sein.\n");
  AddDetail(({"faesser", "holzfaesser"}),
           "In den Holzfaessern scheinen hauptsaechlich Fischkoeder zu "
           +"sein.\n");
  AddDetail(({"koeder", "fischkoeder", "wuermer", "kadaver"}),
           "Bei den Koedern handelt es sich hauptsaechlich um Wuermer "
            +"und Kadaver kleinerer Fische.\n");  
  AddDetail(({"steg", "holzsteg"}),
            "Ein aelterer Holzsteg aus massiven Holzlatten. Unzaehlige "
            +"Muscheln haben sich schon an den Pfeilern des Steges "
            +"angesiedelt und einige Algen auf den Latten machen den Steg "
            +"ziemlich rutschig.\n");
  AddDetail(("boden"),
            "Da sind alte, teils von Algen bedeckte Holzlatten.\n");
  AddDetail(({"latten", "holzlatten"}),
            "Ein paar alte Holzlatten die teilweise schon mit Algen "
            +"bedeckt sind. Da sollte man vielleicht etwas vorsichtig "
            +"sein, auf denen kann man leicht ausrutschen.\n");
  AddDetail(("algen"),
            "Algen bedecken hier und da die Holzlatten. Da sollte "
            +"man wohl besser aufpassen, dass man nicht auf ihnen "
            +"ausrutscht.\n");
  AddDetail(({"pfeiler", "aesthetik"}),
            "An den Pfeilern haben sich schon unzaehlige Muscheln "
            +"angesiedelt. Entbehrt aber nicht einer gewissen "
            +"Aesthetik.\n");
  AddDetail(({"muscheln"}),  
            "Die Muscheln haben sich da an den Pfeilern des Steges "
            +"zahlreich angesiedelt. Eine Muschel faellt Dir dabei auf.\n");
  AddDetail(("muschel"),
            "In der Muschel scheint etwas drin zu sein. Ob man die wohl "
            +"oeffnen kann?\n");
  AddDetail(("anzahl"),
           "Die Anzahl der gefangenen Fische ist beindruckend. "
           +"Ortios scheint ein guter Fischer zu sein.\n");
  AddDetail(({"fische", "fisch"}),
           "Ein stattliche Anzahl an Fischen hat Ortios da "
           +"gefangen. Sie baumeln an einem Seil befestigt von der "
           +"Decke der Huette herab. Manche davon sind gut ein bis "
           +"zwei Meter gross. Die waren sicher nicht ganz einfach "
           +"zu fangen.\n");
  AddDetail(("seil"),
           "An dem verhaeltnismaessig dickem Seil haengt eine "
           +"stattliche Anzahl an gefangenen Fischen.\n");
  AddDetail(("meter"),
           "Ein Meter entspricht in etwa der groesse eines etwas groesseren "
           +"Hobbits.\n");
  AddDetail(({"hobbit", "hobbits"}),
           "Du weisst schon, klein, verfressen, gemuetlich, wasserscheu. "
           +"Hobbits eben.\n");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst das sanfte Rauschen des Meeres und das "
	    +"Saeuseln des Windes.\n");
  AddSound(("rauschen"),
	   "*schhhhhh*, *schhhhh*, *schhhhhh*.\n");
  AddSound(({"wind", "rauschen"}),
	    "Du kannst ja mal lauschen.\n");
  AddDetail(({"saeuseln", "wind"}),
	    "*hhhhuuuuii*, *hhhhuuuuii*, *hhhhuuuuii*.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst den salzigen Geruch des Meeres. Ausserdem "
            +"riecht es hier ziemlich intensiv nach Fisch.\n");
  AddSmell(({"meer", "algen"}),
	   "Das Meer riecht salzig und auch nach Algen und Fisch.n");
  AddSmell(("fisch", "fische"),
           "Puhhh, die riechen aber ziemlich intensiv.\n"); 

  // DETAILS ENDE
  
  // EXITS START
  AddExit (("norden"), "/d/wasser/woody/fischerdorf/room/strand");
  // EXITS END
  
  
  // COMMANDS START
  AddCmd(("oeffne"), "oeffne_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

oeffne_was(str)
{
   notify_fail("Was willst Du oeffnen?\n");
   if (!str) return 0;
   if (str == "muschel")
       {
          if (muschel==1)
             {
               write(BS("Du beugst Dich nach unten "
                        "und oeffnest die Muschel mit "
                        "Deinen Haenden und siehe da Du "
                        "findest eine silberne Perle die "
                        "Du natuerlich sofort einsteckst.\n"));
               say(BS(TP->Name(WER)+" beugt sich den Steg runter "
                         "macht sich an einer Muschel zu schaffen "
                         "und steckt dann strahlend etwas ein.\n"));
               CLONE(OBJ("silberperle"),(TP));
               muschel=0;
               return 1;
             }
           else
             {
                write(BS("Du beugst Dich zu der Muschel hinunter "
                         "oeffnest sie, findest aber leider nicht. "
                         "Enttaeuscht ziehst Du Deine Hand zurueck.\n"));
                say(BS(TP->Name(WER)+" beugt sich den Steg hinunter und "
                         "macht sich an einer Muschel zu schaffen, laesst "
                         "dann aber enttaeuscht davon wieder ab.\n")); 
                return 1;
             }       
       } 
   else return 0;
}


reset()
{
  ::reset();
  muschel=1;
}
















