inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"

/* #include <nonsens.h> */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"perle", "silberne perle"}));
  SetProp (P_SHORT, "Eine silberne Perle");
  SetProp (P_LONG,
	   "Eine wunderschoene silberne Perle. Mit dieser "
           +"Perle fuehlst Du Dich gleich um etliches "
           +"schoener als Du ohnehin schon bist. Diese Perle "
           +"moechtest Du um nichts in der Welt hergeben.\n");
  SetProp (P_INFO,
           "Diese kleine Perle laesst jeden Spieler sofort "
           +"das Herz fuer sie erweichen und laesst ihn nicht "
           +"mehr los. Mit <betrachteperle> kann der Spieler "
           +"die Perle genau bewundern.\n");  
  SetProp (P_NAME, "Eine silberne Perle");
  SetProp (P_GENDER, MALE);
  SetProp (P_MAGIC, 1);
  SetProp (P_WEIGHT, 10);
  SetProp (P_VALUE, 1);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_PEARL);
 
  AddCmd(("betrachteperle"), "betrachteperle");

}

betrachteperle()
{
   write(BS("Du betrachtest gedankenverloren die Perle und "
           +"denkst Dir \. o O \( Wahhh, Sie ist so schoen und "
           +"ich genauso, solange ich nur diese Perle habe\)\. Seufzend " 
           +"steckst Du die Perle dann wieder weg.\n"));
   say(BS(capitalize(TP->QueryProp(P_NAME)) +"zieht eine silberne Perle "
           +"hervor, betrachtet zuerst sie dann sich selbst, strahlt "
           +"uebers ganze Gesicht und steckt die Perle dann wieder "
           +"seufzend weg.\n"));    
   return 1;
}

