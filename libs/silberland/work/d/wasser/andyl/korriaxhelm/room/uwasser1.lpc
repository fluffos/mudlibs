#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";


int lukeauf=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE: 11,
                             ENV_TERRAIN    : TT_UNDERWATER,
                             ENV_WATER      : 10 ]) );
  SetProp (P_INT_SHORT, "In der Tiefe des Meeres.\n");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du bist hier in etwa zehn Meter unter der "
                       +"Meeresoberflaeche. Den Himmel kannst "
                       +"Du dadurch, dass das Wasser ziemlich "
                       +"braun ist nicht mehr erkennen. Jedoch kannst "
                       +"Du ein Schiffswrack im Suedosten erkennen und "
                       +"eine interessante Felsformation im Suedwesten. "
                       +"Da und dort siehst Du auch einige kleinere "
                       +"Fischschwaerme.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START

  AddDetail(({"fischschwaerme", "umgebung"}),
           "Einige kleinere Fischschwaerme kreisen da scheinbar ziellos "
           +"in deiner Umgebung hin und her.\n");
  AddDetail(({"felsformation", "felsbloecke"}),
           "Die Felsformation besteht aus fuenf grossen Felsbloecken. "
           +"An einem Felsblock faellt Dir etwas auf.\n");
  AddDetail(({"felsblock", "fels"}),
           "Da ist eine Luke in den Fels eingelassen.\n");
  AddSpecialDetail(({"metallluke", "luke"}), "luke_schau");
  AddSpecialDetail(({"metallschloss", "schloss"}), "schloss_schau");         
  AddDetail(({"boden", "meeresboden", "schlick", "algen"}),
           "Der Meeresboden ist von Schlick und Algen bedeckt. Hier und da "
           +"siehst Du auch ein paar andere Meeresbewohner.\n");
  AddDetail(("meeresbewohner"),
           "Na Krebse, Seesterne und so.\n");
  AddDetail(("wasser"),
           "Das Wasser ist braun, trueb und vor allem ziemlich "
           +"kuehl um nicht zu sagen a....kalt.\n");
  AddDetail(({"krebse", "seesterne"}),
           "Das sind Meeresbewohner.\n");    
  AddDetail(({"schiffswrack", "fischkutter", "wrack"}),
           "Es duerfte sich bei dem Schiffswrack um einen kleinen "
           +"Fischkutter handeln. Vielleicht solltest Du mal nach "
           +"Suedosten schwimmen und das Wrack genauer unter die "
           +"Lupe nehmen.\n");
  AddDetail(("lupe"),
           "Es geht auch ohne Lupe, war doch nur so eine Redensart.\n");
  AddDetail(({"redensart", "redensarten", "ich", "ohr"}),
           "Redensarten sind nur im uebertragenen Sinn zu verstehen."
           +"Oder wuerdest Du beispielsweise \'Ich hau mich aufs Ohr\' "
           +"woertlich nehmen?\n");
  AddDetail(({"meter", "masseinheit"}),
           "Meter ist eine Masseinheit. Anders ausgedrueckt: " 
	   +"Ungefaehr so gross wie ein Hobbit.\n");
  AddDetail(({"hobbits", "hobbit"}),
           "Ein Hobbit soll ja anscheinend ca. einen Meter gross sein.\n");
  AddDetail(({"himmel", "oberflaeche"}),
           "Die Oberflaeche und der Himmel sind durch das brauntruebe "
           +"Wasser leider nicht mehr zu erkennen.\n");  
  AddDetail(("meeresoberflaeche"),
           "Die Meeresoberflaeche ist etwa zehn Meter ueber Dir. "
           +"Der Druck hier unten ist schon recht beachtlich.\n");
  AddDetail(("druck"),
           "Der Druck ist hier schon recht beachtlich. Zum Diamantenpressen "
           +"reicht es aber wohl eher nicht.\n");
  AddDetail(("diamantenpressen"),
           "Du hattest doch nicht wirklich sowas im Sinn, oder?\n");
  AddDetail(({"sinn", "leben", "vision"}),
           "Da eine Vision: Der Sinn des Lebens ist...\n"
           +"...keine Ahnung. Aber Du solltest mal "
           +"damit beginnen Korriaxs Helm zu finden.\n");
  AddDetail(({"ahnung", "antwort", "silberland"}),
           "Du hast keine Ahnung was der Sinn des Lebens sein koennte. "
           +"Falls deine Antwort jedoch \'mudden\' sein sollte, ist sie "
           +"hier im Silberland nicht ganz falsch :).\n");
  AddDetail(({"korriax", "helm"}),
           "Wegen dem Helm von Korriax bist Du ja wohl hier, oder?\n");
  AddDetail(("schluessel"),
           "So wie es aussieht hast Du keinen.\n");
  AddDetail(("metall"),
           "Das Metall ist Dir voellig unbekannt.\n");
  AddSound( (DEFAULT_SOUND),
           "Es klingt alles sehr dumpf hier. Ausserdem sind "
           +"Deine Ohren hier etwas verschlagen.\n");
  AddDetail(({"ohren", "tauchen", "druckausgleich"}),
           "Deine Ohren sind ziemlich verschlagen, Du hast "
           +"beim Tauchen wohl etwas zu spaet an den "
           +"Druckausgleich gedacht.\n"); 
  AddSmell( ({DEFAULT_SMELL, "geruch", "riechen"}),
	    "Du tust Dir hier mit dem Riechen etwas schwer.\n");
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("oben"), ROOM+"wasser");
  AddExit (("suedosten"), ROOM+"schiffswrack");
  // EXITS END
  
  
  // COMMANDS START

  AddCmd(("oeffne"), "oeffne_was");  

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

luke_schau()
{
  if (lukeauf==0)
     {
        return(BS("Ein kleine Metallluke mit einem Schloss daran. "
                 +"Ob man die wohl irgendwie oeffnen kann?\n"));        
     }
  else 
     {
        return(BS("Die Metallluke ist offen, Du kannst Dich da "
                  +"jetzt durchzwaengen wenn Du willst.\n"));
 
     }
}


schloss_schau()
{
  if (lukeauf==0)
     {
        return(BS("Ein solides Metallschloss. Mit einem Schluessel "
                  +"muesste man es aufsperren koennen. Nur wo ist "
                  +"dieser Schluessel wohl?\n"));
     }
  else
     {
        return(BS("Das Metallschloss ist aufgesperrt.\n"));
     }
}



oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if (( str == "schloss" || str == "metallschloss" || 
        str == "luke" || str == "metallluke" ||
        str == "luke mit schluessel" || str == "luke mit korallenschluessel" ||
        str == "metallluke mit schluessel" || 
        str == "metallluke mit korallenschluessel"))
     {

       // HIER FUNKTION ZUM LUKEOEFFNEN EINBAUN

        write("Sesam oeffne Dich!\n");
        lukeauf=1;
        return 1; 
     }
  else return 0;
}

void reset()
{
  ::reset();
  lukeauf=0;
}
