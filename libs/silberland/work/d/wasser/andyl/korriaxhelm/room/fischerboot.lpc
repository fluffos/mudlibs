#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "In einem Fischerbbot.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du sitzt hier im Fischerboot von Ortios. "
                      +"Das Meer rings um Dich herum ist etwas unruhig "
                      +"und auch mit dem Wetter scheint nicht zum Besten "
                      +"bestellt zu sein. Zumindest vorlaeufig duerfte "
                      +"noch kein Sturm aufkommen und Du solltest genug "
                      +"Zeit haben Dein Vorhaben hier zu Ende zu bringen.\n");

  // ROOM DESCRIPTION END;

  // DETAILS START

  AddDetail(("ende"),
           "Du solltest dein Vorhaben hier auch beenden wenn Du "
           +"es schon angefangen hast.\n");
  AddDetail(({"boden", "planken", "holzplanken"}),
           "Der Boden des Bootes besteht aus soliden Holzplanken.\n");

  AddDetail(({"fischerboot", "boot", "schiff", "bord"}),
           "Es ist ein altes kleines Fischerboot mit nur einem Segel "
           +"und einigen Fischernetzen an Bord. Obwohl es nicht so "
           +"aussieht ist es doch erstaunlich seefest.\n");
  AddDetail(("segel"),
           "Ein mehrfach geflicktes blaues Segel, welches der "
           +"Wind aufblaeht.\n");
  AddDetail(({"fischernetze", "fischernetz"}),
           "Da ihr jetzt nicht fischen wollt, wirst Du die Fischernetze "
           +"jetzt wohl nicht brauchen.\n"); 
  AddDetail(("zeit"),
           "Du solltest genug Zeit fuer Dein Vorhaben haben, "
           +"jedoch zu lange solltest Du nicht brauchen, da "
           +"das Wetter nicht sehr vertrauenserweckend aussieht.\n");
  AddDetail(("vorhaben"),
           "Du hast doch wohl nicht vergessen was Du hier tun sollst, "
           +"oder?\n");
  AddDetail(({"meer"}),
           "Rings um Dich herum siehst Du nur die Weite des Meeres. " 
           +"Kein Land ist in Sicht. Unruhig laesst das Wasser das "
           +"kleine Fischerboot hin und her schaukeln.\n");
  AddDetail(({"land", "sicht"}),
           "Land ist hier weit und breit keines in Sicht.\n");
  AddDetail(("sonne"),
           "Durch die dunkle Wolkendecke sieht man die Sonne kaum "
           +"noch.\n");
  AddDetail(({"wolken", "wolke", "wolkendecke"}),
           "Der Himmel ist mit schwarzen bedeckt. Hoffentlich kommt da "
           +"kein Unwetter auf Dich zu.\n");
  AddDetail(("unwetter"),
           "Ein Unwetter kannst Du jetzt beileibe nicht gebrauchen.\n");
  AddDetail(("weite"),
           "Weit, ziemlich weit erstreckt sich das Meer rings um Dich. "
           +"Und nirgends auch nur etwas Land in Sicht.\n");
  AddDetail(("himmel"),
           "Der Himmel ist mit schwarzen Wolken bedeckt, nur vereinzelt "
           +"dringt noch die Sonne durch. Das Wetter sieht auch nicht "
           +"unbedingt sehr vielversprechend aus.\n");
  AddDetail(("wasser"),
           "Das hier ziemlich braeunliche Wasser des Meeres ist ziemlich "
           +"unruhig und laesst das kleine Fischerboot hin und her "
           +"schaukeln. Zum Glueck scheint Ortios aber die Situation "
           +"problemlos meistern zu koennen.\n");
  AddDetail(({"glueck", "erfahrung"}),
           "Wie Du aus Erfahrung bereits weisst, kann man etwas Glueck "
           +"immer gebrauchen.\n");
  AddDetail(({"ortios", "problem"}),
           "Tja, wenn der jetzt nicht da ist dann hast Du eine Problem. "
           +"Dann solltest Du besser Andyl kontaktieren.\n");
  AddDetail(({"andyl", "magier"}),
           "Du weisst schon, der Magier der das hier verbrochen hat.\n"); 
  AddDetail(({"situation", "griff"}),
           "Ortios scheint die Situation voll im Griff zu haben.\n");
  AddDetail(("besten"),
           "Mit dem Wetter ist es ja nicht gerade zum Besten bestellt.\n");
  AddDetail(("wetter"),
           "Das Wetter sieht nicht gerade sehr vertrauenserwecken aus. "
           +"Hoffentlich zieht da kein Unwetter auf.\n");
  AddDetail(("sturm"),
           "Vorlaeufig ist noch mit keinem Sturm zu rechnen, hoffentlich "
           +"bleibt das auch so.\n");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst das Aufbrausen des Meeres und das "
	    +"heftige Pfeifen des Windes.\n");
  AddSound(("aufbrausen"),
	   "*wuuuussssssccccccchhhhhhhhhhh*.\n");
  AddSound(({"wind", "aufbrausen", "pfeifen"}),
	    "Du kannst ihm ja mal lauschen.\n");
  AddDetail(({"pfeifen", "wind"}),
	    "Das Pfeifen des Windes weckt in Dir ein mulmiges "
            +"Gefuehl.\n");
  AddDetail(({"gefuehl", "sache"}),
            "Du hast ein mulmiges Gefuehl bei der Sache.\n");
  
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht salzig hier.\n");

  // DETAILS ENDE
  
  // EXITS START
  AddExit (("wasser"), ROOM+"wasser");
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}
