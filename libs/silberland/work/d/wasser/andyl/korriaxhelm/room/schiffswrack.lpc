#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";


int schluesselda=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE: 11,
                             ENV_TERRAIN    : TT_UNDERWATER,
                             ENV_WATER      : 10 ]) );
  SetProp (P_INT_SHORT, "Bei einem Schiffswrack.\n");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Vor Dir liegt das Wrack eines alten "
                       +"Fischkutters auf dem Meeresgrund. Vermutlich "
                       +"ist das Schiff bei einem heftigen Sturm gesunken. "
                       +"Es ist bereits mit Muscheln und Algen bedeckt. "
                       +"Ein Hai schwimmt auch nicht allzuweit von Dir "
                       +"Dir entfernt durch das kalte Meerwasser.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START

  AddDetail(({"fischerboot", "boot", "schiff", "wrack", "schiffswrack",
              "fischkutter"}),
           "Das Fischerboot duerfte schon vor Jahren gesunken sein, "
           +"es ist bereit mit Muscheln und Algen bedeckt. Am Steuerrad "
           +"des Bootes kannst Du ein Skelett erkennen.\n");
  AddDetail(("jahre"),
           "Das muss schon viele Jahre her sein.\n");
  AddDetail(("steuerrad"),
           "Hinter dem Steuerrad kannst Du ein Skelett erkennen.\n");
  AddDetail(({"skelett", "fischer"}),
           "Bei dem Skelett duerfte es sich wohl um den ungluecklichen "
           +"Fischer handeln. Am Hals des Skelettes faellt "
           +"Dir etwas auf.\n");
  AddSpecialDetail(("hals"), "hals_schau");
  AddDetail(("sturm"),
           "Na hoffentlich passiert dasselbe nicht Dir und Ortios.\n");
  AddDetail(("ortios"),
           "Der ist hoeffentlich noch oben in seinem Fischerboot.\n");
  AddDetail(({"muscheln", "muschel"}),
           "Du untersuchst die Muscheln findest aber keine Perle, "
           +"echt schade.\n");
  AddDetail(("perle"),
           "Keine zu entdecken, leider.\n");
  AddDetail(("hai"),
           "Der sieht recht boesartig aus, hoffentlich bekommt er "
           +"keinen Appetit auf Dich.\n");
  AddDetail(("appetit"),
           "Wenn der Hai auf Dich Appetit bekommt koennte das uebel "
           +"ausgehen. Entweder fuer Dich oder fuer den Hai.\n");
  AddDetail(({"himmel", "oberflaeche"}),
           "Den Himmel oder die Oberflaeche kannst Du durch das "
           +"brauntruebe Wasser leider nicht erkennen.\n");
  AddDetail(({"wasser", "meerwasser"}),
           "Das brauntruebe Meerwasser ist wirklich ziemlich kalt. "
           +"Und Du hast natuerlich wieder Deine Robe der magischen "
           +"Erwaermung vergessen. Ist ja mal wieder typisch.\n");
  AddDetail(({"robe", "erwaermung", "dinge"}),
           "Auf die wichtigen Dinge vergisst man natuerlich immer. "    
           +"Da schlaegt Murphys Gesetz eben wieder voll zu.\n");
  AddDetail(({"gesetz", "murphy"}),
           "Murphys Gesetz lautet:\n"
           +"Alles was schiefgehen kann, geht auch schief!\n");
  AddDetail(({"boden", "meeresboden", "meeresgrund"}),
           "Am Meeresgrund siehst Du Muscheln, Krebse und zudem noch viele "
           +"Meerespflanzen.\n");
  AddDetail(("krebse"),
           "Die krabbeln da recht zahlreich auf dem Meeresgrund herum.\n");
  AddDetail(({"meerespflanzen", "schlick", "menge"}),
           "Da siehst Du Algen, Tang und jede Menge Schlick.\n");
  AddDetail(({"algen", "tang"}),
           "Das sind alles Meerespflanzen.\n");
  AddSound( DEFAULT_SOUND,
           "*blub* blub* *blub*\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "riechen"}),
	    "Du tust Dir hier mit dem Riechen etwas schwer.\n");
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("oben"), ROOM+"wasser");
  AddExit (("nordwesten"), ROOM+"uwasser1");
  // EXITS END  
  
  // COMMANDS START

  AddCmd(("oeffne"), "oeffne_was");  

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

hals_schau()
{

// SCHLUESSEL BEKOMMEN EINBAU + CHECK

  if (schluesselda==1)
     {
        schluesselda=0;
        return(BS("Um den Hals des Skelettes haengt ein Schluessel "
                 +"aus Korallen, den Du natuerlich sofort einsteckst.\n"));        
     }
  else 
     {
        return(BS("Da ist scheinbar doch nichts. Muss wohl eine "
                  +"Taeuschung gewesen sein.\n"));
     }
}


void reset()
{
  ::reset();
  schluesselda=1;
}
