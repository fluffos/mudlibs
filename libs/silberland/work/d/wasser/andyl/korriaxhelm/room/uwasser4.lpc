#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE: 10,
  ENV_TERRAIN    : TT_UNDERWATER,
  ENV_WATER      : 15 ]) );
  SetProp (P_INT_SHORT, "In einer Grotte im Meer.\n");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du bist hier in einer kleinen Seitenkammer "
                       +"der Grotte. Waende und Decke sind wie auch "
                       +"sonst ueberall in der Grotte von einer "
                       +"schleimigen, fluoriszierenden Schicht bedeckt, "
                       +"welche ein giftig gruenes Licht abstrahlt. "
                       +"Ansonsten ist hier ziemlich kahl und trist.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(({"seitenkammer", "grotte"}),
           "Du befindest Dich hier in einer Seitenkammer der Grotte. "
           +"Hier geht es nicht weiter, Du kannst also nur zurueck nach "
           +"Westen.\n"); 
  AddDetail(("decke"), 
            "Die Decke ist wie auch die Waende von der schleimigen, "
            +"fluoriszierenden Schicht bedeckt.\n");
  AddDetail(({"waende", "wand"}),
            "Die Waende der Grotte sind ueberall mit dieser seltsamen "
            +"fluoriszierenden Schicht ueberzogen.\n");
  AddDetail(({"schicht"}),
            "Die fluoriszierende Schicht ist ein regelrechter Schleim "
            +"der ein giftig gruenes Licht abstrahlt.\n");
  AddDetail(({"licht", "farbe"}),
            "Das Licht hat eine giftig gruene Farbe.\n");
  AddDetail(({"boden", "meeresboden"}),
            "Der Meeresboden besteht aus blanken, tristen Fels. "
            +"Keine Meerespflanzen sind hier zu finden.\n");
  AddDetail(({"meerespflanzen", "pflanzen"}),
            "Du kannst keine Meerespflanzen entdecken. Ob das mit dem "
            +"eklig braunen Wasser zusammenhaengt?\n");
  AddDetail(("schleim"), 
            "Als Du den Schleim naeher untersuchst, faellt Dir eine "
            +"Schimmern weiter unten an der Ostwand auf.\n");
  AddDetail(({"schimmern", "ostwand"}),
            "Da scheint eine Muschel in dem Schleim zu stecken.\n");
  AddDetail(({"muschel"}),
            "Eine sehr huebsche Muschel. Ob man die wohl aus dem Schleim "
            +"ziehen kann?\n");
  AddDetail(({"wasser", "meerwasser"}),
            "Das Meerwasser hier ist unnatuerlich braun und "
            +"vermutlich auch ziemlich ungesund.\n");
  AddDetail(("fels"),
            "Trister kahler Fels.\n");
  AddSound( (DEFAULT_SOUND),
	    "Du hoerst unheimliche Geraeusche aus suedlicher Richtung.\n");
  AddDetail(("geraeusche"),
            "Die Geraeusche klingen unheimlich, ja regelreicht "
            +"angsteinfloessend.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "riechen"}),
	    "Unter Wasser solltest Du das Riechen besser sein lassen.\n");

  // DETAILS ENDE
  
  // EXITS START

  AddExit (("westen"), ROOM+"uwasser3");

  // EXITS END
  
  // COMMANDS START

  AddCmd(({"ziehe", "zieh"}), "ziehe_was");

  // COMMANDS END
  
  // ITEMS START
  
  // ITEMS END
}

ziehe_was(str)
{
   notify_fail(BS("Was willst Du wo herausziehen?\n"));
   if (!str) return 0;
   if ((str=="muschel aus schleim" || str=="muschel heraus" ||
        str=="muschel aus schleim heraus" || str=="muschel aus wand" ||
        str=="muschel aus ostwand" || str=="muschel aus wand heraus" ||
        str=="muschel aus ostwand heraus"))
      {
        // MUSCHELAMMULETT CLONEN UND CHECKEN OB SPIELER
        // SCHON EINES HAT
        write(BS("Tja, derzeit gibts hier noch nix."));
        return 1;
      }
   else return 0; 
}


void reset()
{
  ::reset();
}
