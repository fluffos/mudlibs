#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE: 10,
  ENV_TERRAIN    : TT_UNDERWATER,
  ENV_WATER      : 15 ]) );
  SetProp (P_INT_SHORT, "In einer Grotte im Meer.\n");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du befindest Dich hier an einer Stelle wo sich "
                       +"die Grotte verzweigt. Du kannst von hier aus "
                       +"Richtung Osten, oder auch zurueck nach Norden "
                       +"schwimmen. Auch nach Suedosten wuerde der Weg frei "
                       +"sein, allerdings ist das ohnehin schon braune Wasser "
                       +"in dieser Richtung fast vollstaendig schwarz. Zudem "
                       +"dringen von dort markerschuetternde Geraeusche an Dein Ohr. "
                       +"Meerespflanzen oder das sonst uebliche Meeresgetier kannst "
                       +"Du hier nirgends entdecken.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(("stelle"),
            "An dieser Stelle der Grotte geht es in drei Richtungen weiter.\n");
  AddDetail(("grotte"),
            "Die Grotte ist wie bereits vorher gesehen an Waenden und Decke "
            +"mit einer schleimigen fluoreszierenden Schicht bedeckt.\n");
  AddDetail(("schicht"),
            "Die Schicht die den Fels bedeckt ist schleimig, fluoriszierend und "
            +"strahlt ein giftig gruenes Licht ab.\n");
  AddDetail(("decke"),
            "Wie auch die Waende ist der Fels der Decke mit einer schleimigen "
            +"fluoriszierenden Schicht bedeckt.\n");
  AddDetail(({"wand", "waende"}),
            "Die Waende sind wie auch die Decke von einer schleimigen "
            +"fluoreszierenden Schicht bedeckt.\n");
  AddDetail(("fels"),
            "Der Fels ist mit einer schleimigen fluoriszierenden Schicht bedeckt.\n");
  AddDetail(("licht"),
            "Das Licht hat eine giftig gruene Farbe.\n");
  AddDetail(({"farbe", "gruen"}),
            "Die Farbe des Lichts ist ein giftiges Gruen.\n");
  AddDetail(({"boden", "meeresboden"}),
            "Der Meeresboden ist hier kahl und leer. Weder Meerespflanzen noch "
            +"das sonst uebliche Meeresgetier kannst Du entdecken.\n");
  AddDetail(({"pflanzen", "meerespflanzen"}),
               "Nirgends sind hier Meerespflanzen zu entdecken.\n");
  AddDetail(({"richtung", "richtungen"}),
            "Du kommst von hier in die Richtungen Norden, Osten und Suedosten.\n");
  AddDetail(({"wasser", "meerwasser", "farbton"}),
            "Das Meerwasser hat einen untypischen braunen Farbton. Im Suedosten ist es "
            +"sogar schon teilweise schwarz.\n");
  AddDetail(("weg"),
            "Der Weg nach Suedosten waere zwar frei, aber die markerschuetternden Geraeusche und "
            +"die Farbe des Wassers dorten lassen Dich etwas stutzig werden.\n");  
  AddDetail(({"meeresgetier", "getier"}),
            "Kein Meeresgetier weit und breit zu entdecken. Das ist ausgesprochen "
            +"ungewoehnlich.\n");

  AddSound( (DEFAULT_SOUND),
	    "Markerschuetternde Geraeusche dringen von Suedosten an Dein Ohr.\n");
  AddDetail(("ohr"),
            "An Dein Ohr dringen markerschuetternde Geraeusche von Suedosten.\n");
  AddDetail(("geraeusche"),
            "Lausch ihnen mal.\n"); 
  AddSound(("geraeusche"),
            "Die Geraeusche hoeren sich an wie Schrei und ein dumpfes, intensives Gurgeln.\n");
  AddSound(({"schrei", "schreie"}),
            "AAAAAAAAAAAAAIIIIIIIIIIIIAAAAAAAAARRRRRGGGGGGGHHHHHHHHHHH!!!!!\n");
  AddSound(({"gurgeln"}),
            "GRGLGLRGLRGLGLGLRGLGLR!\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "riechen"}),
	    "Du tust Dir mit dem Riechen unter Wasser etwas schwer, also lass es besser sein.\n");
  AddDetail(("riechen"),
            "Lass das unter Wasser besser sein.\n");  

  // DETAILS ENDE
  
  // EXITS START
  AddExit (("norden"), ROOM+"uwasser2");
  AddExit (("osten"), ROOM+"uwasser4");
  
  // Hierher kommt eine SpecialExit, der Spieler anfangs hindert nach Suedosten zu schwimmen. 
  //
  // AddSpecialExit(("suedosten"), ROOM("krakenhoehle"));  

  // EXITS END
  
  // COMMANDS START

  // COMMANDS END
  
  // ITEMS START
  
  // Hierher kommt dann mal 

  // ITEMS END
}

void reset()
{
  ::reset();
}
