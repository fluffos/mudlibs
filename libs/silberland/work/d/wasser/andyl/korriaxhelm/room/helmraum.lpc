#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE: 20,
  ENV_TERRAIN    : TT_UNDERWATER,
  ENV_WATER      : 15 ]) );
  SetProp (P_INT_SHORT, "In einem Raum aus schimmernden Korallen.\n");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Die befindest Dich hier in einem Raum aus blaeulich "
                       +"schimmernden Korallen. Der Raum hat die Form einer "
                       +"einer Halbkugel. In der Mitte des Raumes liegt ein "
                       +"ein Haufen groesserer Felsbrocken. Ein Loch im Boden "
                       +"fuehrt wieder zurueck in die Grotte und damit zurueck "
                       +"ins Meerwasser.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(("korallen"),
            "Die Korallen sind alle weiss und strahlen ein sanftes blaeuliches "
            +"Licht ab.\n"); 
  AddDetail(("raum"),
            "Der Raum ist halbkugelfoermig und besteht aus weissen Korallen die "
            +"ein angenehmes, blaeuliches Licht abstrahlen.\n");
  AddDetail(({"halbkugel", "form"}),
            "Der Raum hat die Form einer Halbkugel, man koennte fast meinen man "
            +"stehe unter einer ueberdimensionalen Kaeseglocke.\n");
  AddDetail(("kaeseglocke"),
            "Naja, der Raum ist die Kaeseglocke und Du bist dann wohl der Kaese.\n");
  AddDetail(({"kaese", "wie"}),
            "Du denkst . o O \(Wie kommt der zustaendige Magier immer auf so "
                             +"kranke Vergleiche? Ich und Kaese, pahhh.\)\n");
  AddDetail(({"vergleich", "vergleiche"}),
            "Solche Vergleiche koennen ja auch nur Magiern einfallen.\n");
 
  AddDetail(({"magier"}),
            "Jaja, mit den Magiern war das ja immer schon so eine Sache.\n");
  AddDetail(("sache"),
            "Du kennst das ja eh.\n"); 
  AddDetail(("decke"), 
            "Auch von der Decke leuchtet das sanfte blaue Licht der Korallen "
            +"auf Dich herab.\n");
  AddDetail(("licht"),
            "Ein sanftes, blaues Licht. Es wird von den Korallen abgestrahlt "
            +"aus denen der Raum besteht.\n");
  AddDetail(("boden"),
            "Der Boden ist aus einem hellen Marmor mit verschiedensten Mustern "
            +"darauf.\n");
  AddDetail(({"marmor", "muster"}),  
            "Auf dem hellen Marmor des Bodens sind verschiedenste Muster die sich alle "
            +"voneinander unterscheiden.\n"); 
  AddDetail(({"waende", "wand"}),
            "Die Waende bestehen aus weissen Korallen welche ein blaeuliches Licht "
            +"abstrahlen.\n");
  AddDetail(({"loch", "grotte"}),
            "Durch das Loch im Boden kommst Du zurueck in die Grotte und damit zurueck ins "
            +"Meerwasser.\n");
  AddDetail(({"wasser", "meerwasser"}),
            "Durch das Loch kommst Du zurueck ins Meerwasser.\n");
  AddDetail(({"haufen", "mitte"}),
            "Ein Haufen grosser Felsbrocken liegt in der Mitte des Raumes.\n");
  AddDetail(({"brocken", "felsbrocken"}),
            "Es sind recht grosse Felsbrocken aus einem dunklen Gestein die da auf "
            +"einem haufen liegen.\n");
  AddDetail(("gestein"),
            "Als Du das Gestein untersuchst, entdeckst Du eine kleine Tafel auf einem "
            +"der Felsbrocken.\n");
  AddDetail(("tafel"),
            "Du kannst sie lesen.\n");

  /// RAETSEL EINBAUN

  AddReadDetail(("tafel"),
            "Hier kommt mal ein raetsel rein, is aber noch nicht erdacht. :P\n");


  AddSound( ({DEFAULT_SOUND}),
	    "Es ist absolut still hier.\n");
  AddSmell( ({DEFAULT_SMELL,}),
	    "Riecht ungewoehnlich angenehm hier.\n");
 
  // DETAILS ENDE
  
  // EXITS START

  AddExit (("loch"), ROOM+"uwasser3");

  // EXITS END
  
  // COMMANDS START

  // COMMANDS END
  
  // ITEMS START

  // ITEMS END
}

void reset()
{
  ::reset();
}


