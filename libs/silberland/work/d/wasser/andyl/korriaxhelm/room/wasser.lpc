#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_WATER]));
  SetProp (P_INT_SHORT, "Im Wasser des Meeres.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du schwimmst jetzt im Wasser des Meeres welches "
                       +"ziemlich unruhig ist und Dir alle Muehe bereitet "
                       +"Dich ueber Wasser zu halten. Vor Dir schaukelt das "
                       +"Fischerboot von Ortios unruhig auf den Wellen "
                       +"hin und her. Du solltest Dich entscheiden ob Du "
                       +"jetzt abtauchst oder auf das Boot zurueckkehrst. "
                       +"Lange wirst Du hier jedoch nicht den Wellen trotzen "
                       +"koennen.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START
  
  AddDetail(({"himmel", "wolken"}),
           "Der Himmel ist mit schwarzen Wolken verhangen. Da "
          +"bahnt sich irgendetwas an.\n");
  AddDetail(("wasser"),
           "Das Wasser ist ziemlich unruhig, schmeckt sehr salzig und "
           +"hat einen seltsamen braunen Farbton.\n");
  AddDetail(("farbton"),
           "Das Wasser hat einen seltsam braeunlichen Farbton angenommen. "
           +"Ob das natuerlich ist?\n");
  AddDetail(("meer"),
           "Du schwimmst jetzt im Wasser des ziemlich unruhigen Meeres "
           +"und kaempfst mit den Wellen die ueber Dich hinwegfegen.\n");
  AddDetail(("wellen"),
           "Die Wellen machen Dir ganz schoen zu schaffen. Hoffentlich "
           +"werden die nicht noch staerker.\n");  
  AddDetail(("muehe"),
           "Mit viel Muehe kaempfst Du gegen die Wellen welche die ganze "
           +"Zeit ueber Dich hinwegfegen.\n");
  AddDetail(({"fischerboot", "boot"}),
           "Das Fischerboot von Ortios schaukelt heftig auf den Wellen "
           +"hin und her. Jedoch ist es erstaunlich seetuechtig. Das "
           +"haettest Du dem kleinen Boot anfangs nicht zugetraut.\n");
  AddDetail(("ortios"),
           "Ortios steht sicher auf seinem Fischerboot und navigiert "
           +"es ruhig durch die Wellen.\n");
  AddDetail(("zeit"),
           "Zuviel Zeit solltest Du hier nicht verbringen. Also entweder "
           +"tauchst Du ab oder kehrst auf das Fischerboot zururck.\n");
  AddDetail(("boden"),
           "Unter Dir siehst Du nur das Meer. Naja, eigentlich nicht "
           +"nur unter Dir. Auch links, rechts, vor und hinter Dir und "
           +"teils sogar ueber Dir.\n"); 
 
  AddSound( (DEFAULT_SOUND),
           "Du hoerst nur das Toben des Meeres rings um Dich herum.\n");
  AddSound(("toben"),
           "Ist ziemlich laut.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht salzig und fischig hier.\n");
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("fischerboot"), ROOM+"fischerboot");
  AddExit (("tauchen"), ROOM+"uwasser1");
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}
