#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE: 10,
  ENV_TERRAIN    : TT_UNDERWATER,
  ENV_WATER      : 15 ]) );
  SetProp (P_INT_SHORT, "In der Ruinen des Unterwassertempels.\n");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du bist hier in einem hoechst deprimierenden Teil "
                       +"der Unterwassergrotte. Es duerfte hier einmal ein wunderschoener "
                       +"Tempel gestanden haben, welcher wie es aussieht erst vor kurzem "
                       +"zerstoert wurde. Alles was von dem Tempel uebrig ist, ist eine "
                       +"unheimliche Ruine in der die Leichen von Meermaennern und "
                       +"Meerfrauen herumtreiben. Das Wasser hier ist beinahe schwarz " 
                       +"und nur mit Muehe schaffst Du es Dich zurechtzufinden. Das man "
                       +"ueberhaupt etwas sieht ist der fluoriszierenden Schicht an Decke "
                       +"und Waenden zu verdanken. Ein herzzerreisendes Weinen hoerst Du "
                       +"ausserdem aus oestlicher Richtung.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(({"waende", "wand"}),
            "Die Waende der Grotte sind wie auch die Decke mit einer schleimigen fluoriszierenden Schicht "
            +"ueberzogen, welche ein giftig gruenes Licht abstrahlt.\n");  
  AddDetail(("licht"),
	    "Das giftig gruene Licht wird von der schleimigen Schicht abgestrahlt, welche Waende und Decke "
	    +"bedeckt.\n");
  AddDetail(("schicht"),
            "Die fluoriszierende Schicht ist ziemlich schleimig, bedeckt Waende und Decke und "
            +"strahlt ein giftig gruenes Licht ab.\n");
  AddDetail(("decke"),
            "Die Decke ist mit einer schleimigen fluoreszierenden Schicht bedeckt.\n"); 
  AddDetail(({"grotte", "unterwassergrotte", "teil"}),
            "Du bist hier in einem recht deprimierenden Teil der Grotte. Rings um dich herum "
            +"siehst Du die Ruine eines vorher wohl recht schoenen Tempels, welcher erst vor "
            +"kurzem zerstoert worden sein duerfte.\n");
  AddDetail(("tempel"),
            "Der Tempel duerfte einmal wunderschoen gewesen sein, aber jetzt ist von ihm nur noch "
            +"eine Ruine uebrig. \n");
  AddDetail(({"ruine", "bild"}),
            "Die Ruine des Tempels kombiniert mit den umhertreibenden Leichen bieten ein hoechst "
            +"frustrierendes Bild.\n"); 
  AddDetail(({"leichen"}),
            "Die Leichen von rund zwei Dutzend Meermaennern und Meerfrauen treiben hier herum. "
            +"Kein sehr schoener Anblick. Was mag hier wohl geschehen sein?\n");
  AddDetail(({"dutzend", "zahl"}),
            "Wie allgemein bekannt entspricht ein Dutzend der Zahl zwoelf.\n"); 
  AddDetail(("anblick"),
            "Die herumtreibenden Leichen bieten wirklich keinen sehr schoenen Anblick.\n");
  AddDetail(({"meerfrauen", "frauen", "gesichter", "auge", "augen", "mund", "mimik"}),
            "Die Gesichter von den Leichen der Meerfrauen sind schrecklich verzerrt. Die Augen "
            +"geweitet, der Mund offen und die gesamte Mimik von Furcht gezeichnet. Sie muessen "
            +"dem blanken Entsetzen ins Auge gesehen haben als sie gestorben sind.\n");
  AddDetail(({"furcht", "entsetzen"}),
	    "Was kann der Grund fuer solche Furcht und ein solches Entsetzen gewesen sein?\n");
  AddDetail(("grund"),
            "Das wirst Du wohl frueh genug herausfinden.\n");
  AddDetail(({"meermaenner", "wachen", "gewand"}),
            "Dem Gewand nach zu schliessen duerften die Meermaenner Wachen oder "
            +"aehnliches gewesen sein. Seltsame Abdruecke an ein paar "
            +"der Leichen fallen Dir auf.\n");
  AddDetail(({"abdruck", "abdruecke"}),
	    "Nachdem Du die Abdruecke naeher untersucht hast, kommst Du zu dem Schluss, dass "
            +"diese Abdruecke wohl von riesigen Tentakeln verursacht worden sein muessen.\n");
  AddDetail(("schluss"),
	    "Du findest Deinen Schluss ueberaus schluessig.\n");
  AddDetail(({"tentakel", "tentakel", "ungetuem"}),
            "Welches Ungetuem koennte wohl solche Tentakel haben?\n");
  AddDetail(("wasser"),
	    "Das Wasser ist hier beinahe schwarz und nur mit Hilfe des gruenen Lichts ist es "
            +"moeglich hier ueberhaupt etwas zu sehen.\n");
  AddDetail(("hilfe"),
            "Hilfe haettest Du jetzt wohl gerne, oder?\n");
  AddDetail(("muehe"),
	    "Nur mit Muehe schaffst Du es in dem dunklen Wasser etwas zu sehen.\n");
  AddDetail(({"boden", "meeresboden"}),
	    "Der Meeresboden ist von Truemmern des Tempels bedeckt neben denen da und dort "
            +"ein paar Leichen liegen.\n");
  AddDetail(({"truemmer", "gestein"}),
	     "Das meiste davon duerfte ein marmoraehnliches Gestein sein.\n");
  AddDetail(("richtung"),
	    "Aus oestlicher Richtung hoerst Du das Weinen.\n");
  AddSound( (DEFAULT_SOUND),
	    "Du hoerst ein bitteres Weinen aus oestlicher Richtung.\n");
  AddDetail(("weinen"),
	    "Du solltest dem Weinen mal lauschen.\n");
  AddSound(("weinen"),
            "Das Weinen ist echt herzzerreissend. Vielleicht solltest Du ja mal nachsehen "
            +"ob man da vielleicht helfen kann. Du musst dazu nur nach Osten schwimmen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "riechen"}),
	    "Du kannst und willst hier unter Wasser nicht riechen.\n");

  // DETAILS ENDE
  
  // EXITS START
  AddExit (("nordwesten"), ROOM+"uwasser3");
 
  AddExit (("osten"), ROOM+"kerker");
  // HIER KOMMT DER WEG ZUM "GEFAENGNIS" DES KRAKEN.
  // KRAKE WIRD GECLONED SOBALD MAN VERSUCHT NACH OSTEN ZU SCHWIMMEN

  // EXITS END
  
  // COMMANDS START

  // COMMANDS END
  
  // ITEMS START

  // ITEMS END
}

void reset()
{
  ::reset();
  // Reset Daemonenkrake nicht vergessen
}


