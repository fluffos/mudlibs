#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE: 10,
  ENV_TERRAIN    : TT_UNDERWATER,
  ENV_WATER      : 15 ]) );
  SetProp (P_INT_SHORT, "Vor einer Wand aus Schleim.\n");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Die Grotte ist hier zu Ende wie es aussieht. "
                       +"Die Wand im Osten besteht komplett aus dem "
                       +"fluoriszierenden Schleim wie Du ihn schon "
                       +"gesehen hast. Nur mit einem Unterschied: "
                       +"Der Schleim ist hier viel dicker und zaeher, "
                       +"ja teilweise sind sogar Leichen von Meerfrauen "
                       +"und Meermaennern in dem Schleim eingeschlossen. "
                       +"Du glaubst jedoch etwas hinter der Schleimschicht "
                       +"zu hoeren.\n");;
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(("decke"),
            "Die Decke ist wie auch die Wand von dem Schleim ueberzogen.\n");
  AddDetail(({"grotte", "ende"}),
            "Die Grotte scheint hier zu Ende zu sein.\n");
  AddDetail(({"waende", "schleimwaende", "wand", "schleimwand"}),
            "Die Waende hier sind vor allem im Osten ueber und ueber "
            +"mit dieser ekligen Schleimschicht ueberzogen.\n"); 
  AddDetail(({"boden", "meeresboden"}),
            "Der Boden ist aus kaltem Fels ohne besondere Merkmale.\n");
  AddDetail(("fels"),
            "Unscheinbarer kalter dunkler Fels.\n");
  AddDetail(("merkmale"),
            "Keine besonderen Merkmale zu entdecken.\n");
  AddDetail(("unterschied"),
            "Die Schleimschicht hier unterscheidet sich von der die Du "
            +"bisher gesehen hast.\n");           
  AddDetail(({"schicht", "schleimschicht", "schleim"}), 
            "Die Schleimschicht hier ist viel dicker und zaeher hier. "
            +"Wie Du auf sie vorsichtig klopfst merkst Du, dass sie "
            +"steinhart ist.\n");
  AddDetail(({"leichen"}),
            "Die Leichen von Meermaennern und Meerfrauen sind in dem "
            +"Schleim eingeschlossen. Ein wahrlich grausamer Anblick.\n");
  AddDetail(("anblick"),
            "Wahrlich kein schoener Anblick.\n");
  AddDetail(({"meermaenner", "meerfrauen"}),
            "So ein trauriges Schicksal haben diesicher nicht verdient.\n");
  AddDetail(("schicksal"),
            "Das Schicksal kann so grausam sein. Hoffentlich ergeht es Dir "
            +"da besser.\n"); 
  AddSound( ({DEFAULT_SOUND, "wand"}),
	    "Du hoerst ein bitteres Weinen.\n");
  AddDetail(({"meerwasser", "wasser"}),
            "Das Wasser hier ist schwarz und unappetitlich.\n");
  AddDetail(("weinen"),
	    "Du solltest dem Weinen mal lauschen.\n");
  AddSound(("weinen"),
            "Das Weinen scheint von hinter der Schleimwand zu kommen. "
            +"Da braucht jemand mit Sicherheit Deine Hilfe.\n");
  AddSound(({"sicherheit", "hilfe"}),
             "Untersuche Deine Gefuehle, "+TP->query_real_name()+"!\n");
  AddDetail(({"gefuehle", "gefuehl"}),
             "Dein Gefuehl sagt Dir das hier Deine Hilfe gebraucht wird.\n"); 
  AddDetail(("sicherheit"),
            "Da wird mit Sicherheit Deine Hilfe gebraucht. Tu also "
            +"was!\n");
  AddDetail(("hilfe"),
            "Hilf doch einfach. Versuch doch diese Schleimwand zu "
            +"zerschlagen!\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "riechen"}),
	    "Als bereits etwas Wasser tiefer in deine Nase stroemt "
            +"laesst Du das riechen bleiben.\n");
  AddDetail(({"nase", "ruebennase"}),
            "Zum Glueck hast Du keine Ruebennase.\n");
  AddDetail(({"glueck"}),
            "Glueck kann man wohl immer gebrauchen.\n");

  // DETAILS ENDE
  
  // EXITS START

  AddExit (("westen"), ROOM+"krakenhoehle");

  // EXITS END
  
  // COMMANDS START

  AddCmd(({"schlag", "schlage", "zerschlage", "zerschlag"}), "zerschlag_was");

  // COMMANDS END
  
  // ITEMS START

  // ITEMS END
}

zerschlag_was(str)
{
   notify_fail(BS("Was willst Du womit zerschlagen?\n"));
   if (!str) return 0;
   // CHECKEN OB ER WAFFE HAT ODER NICHT
   // WAND ZERBRICHT, GEFANGENE FREI, SEQUENZ. TRANSFER IN DEN RAUM MIT
   // KORRIAX HELM  

   write(BS("Jetzt Sequenz und Transfer zu dem Raum mit Korriax Helm.\n"));
   return 1;
}

void reset()
{
  ::reset();
}


