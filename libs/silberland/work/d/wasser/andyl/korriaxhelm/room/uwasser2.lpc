#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE: 10,
  ENV_TERRAIN    : TT_UNDERWATER,
  ENV_WATER      : 15 ]) );
  SetProp (P_INT_SHORT, "In einer Grotte im Meer.\n");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du schwimmst hier in einer Grotte am Grund des "
	   +"Meeres. Die Waende leuchten in einem gruenlichem "
	   +"Licht und verleihen in Kombination mit dem braunen "
	   +"Meerwasser der Grotte einen unheimlichen Anblick. "
	   +"Ein paar Kristalle sind am Boden zu sehen. Aber "
	   +"bis auf ein paar Krebse keine anderen Lebewesen."
	   +"Richtung Sueden kommst Du in einen weiteren Teil "
	   +"der Grotte. Und im Nordosten ist ein offene Luke "
	   +"durch die Du dich sicher durchzwaengen koenntest.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(("fels"),
            "Der Fels der Grotte ist mit einer schleimigen fluoriszierenden "
            +"Schicht bedeckt.\n");
  AddDetail(("meer"),
            "Du befindest Dich hier in einer Grotte im Meer.\n");
  AddDetail(({"decke", "felsdecke"}),
	    "Die Decke ist aus Fels welcher mit einer fluoreszierenden "
 	    +"Schicht bedeckt ist und gibt ein giftiges gruenliches Licht ab. Wirkt "
            +"irgendwie unheimlich und auch nicht ganz natuerlich.\n");
  AddDetail(({"kombination", "anblick"}),
            "Die Kombination aus dem gruenen Licht und dem braunen Meerwasser "
            +"bietet einen unheimlichen Anblick.\n");
  AddDetail(({"wasser", "meerwasser"}),
            "Das Meerwasser hier ist unnaetuerlich braun.\n");
  AddDetail(({"meeresgrund", "grund"}),
            "Du befindest Dich hier in einer Grotte am Meeresgrund.\n");
  AddDetail(("teil"),
            "Wenn Du nach Sueden schwimmst kommst Du in einen weiteren Teil der "
            +"Grotte.\n");
  AddDetail(("schicht"),
            "Díe Schicht wirkt irgendwie schleimig, ist fluoreszierend und gibt ein giftig "
            +"gruenes Licht ab.\n");
  AddDetail(({"licht", "farbton"}),
            "Das Licht hat einen giftig gruenen Farbton. Ob das wirklich natuerlichen "
            +"Ursprungs ist?\n");
  AddDetail(({"ursprung", "wahrscheinlichkeit"}),
            "Das Licht hat mit hoher Wahrscheinlichkeit keinen natuerlichen Ursprung. "
            +"Nur was steckt sonst dahinter?\n");
  AddDetail(({"meeresboden", "boden"}),
            "Der Meeresboden ist hier etwas seltsam. Es sind kaum noch Meerespflanzen zu "
            +"entdecken. Stattdessen sind da ein paar matte unfoermige Kristalle zu "
            +"sehen. Zwischen den Kristallen huschen da und dort noch ein paar Krebse "
            +"herum aber ansonsten kannst Du keine weiteren Lebewesen entdecken.\n");
  AddDetail(("meerespflanzen"),
            "Die einzigen Meerespflanzen die Du hier entdecken kannst sind bereits "
            +"abgestorben.\n");
  AddDetail(("lebewesen"),
            "Ausser ein paar Krebsen kannst Du hier keine weiteren Lebewesen entdecken.\n");
  AddDetail(({"krebse", "krebse"}),
            "Die Krebse huschen da zwischen den Kristallen am Meeresboden umher, jedoch "
            +"scheinen viele von ihnen nicht mehr besonders gesund zu sein, da sie schon "
            +"seltsame Farben angenommen haben und ihre Gangart an die eines Betrunkenen "
            +"erinnert.\n");
  AddDetail(("farben"),
            "Manche Krebse haben denkbar ungesunde Farben angenommen.\n");
  AddDetail(({"gangart", "betrunkene", "betrunkenen"}),
            "Die Gangart einiger Krebse erinnert stark an die eines Betrunkenen.\n"); 
  AddDetail(("kristall"),
            "Die Kristalle sind weder schoen noch ebenmaessig geformt. Sie wirken "
            +"eher wie eine ungesunde Wucherung.\n");
  AddDetail(({"wucherung", "kristallwucherung"}),
            "Was kann diese Kristallwucherung wohl ausgeloest haben?\n");
  AddDetail(("grotte"),
            "Du befindest Dich hier in einer Grotte die ungefaehr 15 Meter unter dem "
            +"Meerespiegel liegt. Durch eine fluoreszierende Schicht an den Waenden und "
            +"Decke ist hier herinnen auch genuegend Licht.\n");
  AddDetail(("meerespiegel"),
            "Der Meerespiegel ist ungefaehr 15 Meter ueber Dir.\n");
  AddDetail(({"meter", "masseinheit", "laenge"}),
            "Eine Meter ist die Masseinheit fuer die Laenge. Aber das weisst "
            +"Du sicher eh schon, du wolltest wahrscheinlich nur ein weiteres "
            +"Detail erforschen, richtig?\n");
  AddDetail(("detail"),
            "Ja, dies hier ist ein Detail extra fuer Dich.\n");
  AddDetail(({"waende", "wand"}),
            "Die Waende sind wie auch die Decke mit einer fluoriszierenden "
            +"schleimigen Schicht bedeckt. An der Westwand faellt Dir jedoch "
            +"zusaetzlich noch etwas auf.\n");
  AddDetail(("westwand"),
            "In die Westwand ist eine aufgeklappte weisse Muschel eingelassen worden. "
            +"Durch die schleimige Schicht war sie nur etwas schwer zu entdecken. Was "
            +"fuer einen Zweck sie wohl erfuellt?\n");
  AddDetail(("zweck"),
            "Tja, den Zweck der Muschel wirst Du wohl selbst herausfinden muessen.\n");
  AddDetail(({"luke", "metallluke"}),
            "Eine offene Metallluke durch welche Du Dich durchzwaengen koenntest.\n");
  AddSound( (DEFAULT_SOUND),
	    "Du glaubst ein leises Jammern aus Richtung Sueden zu hoeren.\n"); 
  AddSound(("jammern"),
           "Das Jammern kommt definitiv aus suedlicher Richtung.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "riechen"}),
	    "Riehchen ist unter Wasser kein guter Gedanke.\n");
  AddDetail(("gedanke"),
	    "Verwirf den Gedanken am besten gleich wieder.\n");
  AddDetail(("muschel"),
            "Eine weisse aufgeklappte Muschel die in die Westwand eingelassen wurde. "
            +"Du hast das Gefuehl das diese Muschel irgendetwas will.\n");
  AddDetail(("gefuehl"),
            "Dein Gefuehl sagt Dir das Du versuchen solltest etwas in die Muschel "
            +"zu legen.\n");
  
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("sueden"), ROOM+"uwasser3");
  // EXITS END
  
  
  // COMMANDS START

  AddCmd(({"zwaenge", "zwaeng"}), "zwaenge_durch");  
  AddCmd(({"leg", "lege"}), "lege_was");

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

lege_was(str)
{
  notify_fail("Was willst Du wohin legen?\n");
  if (!str) return 0;
  // if
  //  HIER TANKQUELLE EINBAUN....
  //
  else return 1;   
}

zwaenge_durch(str)
{
  notify_fail("Durch was willst Du Dich zwaengen?\n");
  if (!str) return 0;
  if (( str=="durch luke" || str=="durch metallluke" ||
        str=="in luke" || str=="in metallluke" ))
      {
        write("sorry, da gibts no nix\n");
        // HIER DURCH GEHTS !!! EINBAUN !!!!
        return 1;
      }
  else return 0;
}

void reset()
{
  ::reset();
}
