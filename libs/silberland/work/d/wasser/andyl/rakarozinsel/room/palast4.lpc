#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im Knochenpalast.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Dieser Raum ist ueber und ueber mit Blut bedeckt. "
	   +"Die Luft hier ist noch kuehler als anderswo im Palast und es "
	   +"stinkt fuerchterlich. Eine kleine Holztuer ist im Osten zu "
	   +"entdecken. Zwei Gaenge fuehren von hier fort, einer nach "
	   +"Nordosten und einer nach Suedosten.\n");
  
  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(("raum"),
	    "Du befindest Dich in einem Raum des Palastes, welcher "
	    +"ueber und ueber mit Blut bedeckt ist.\n");
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt zwei Gaenge hier, der eine fuehrt nach Nordosten, der "
	    +"andere nach Suedosten.\n");
  AddDetail(({"innere", "knochenpalast", "palast"}),
	    "Du befindest Dich hier im Inneren des unheimlichen "
	    +"Knochenpalasts.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen vollstaendig aus Knochen und ueber und ueber mit "
	    +"Blut bespritzt.\n");
  AddDetail(("decke"),
	    "Auch die Decke besteht aus Knochen und ist ueber und ueber mit Blut "
	    +"bespritzt.\n");
  AddDetail(({"boden", "knochenboden"}),
	    "Auch der Boden besteht aus Knochen. Ein Meer aus Blut laesst die Knochen "
	    "darunter kaum noch erkennen.\n");
  AddDetail(("knochen"),
	    "Es sind die Knochen verschiedenster Lebewesen.\n");
  AddDetail(("lebewesen"),
	    "Wieviele Lebewesen mussten wohl sterben um diesen Palast des Grauens zu "
	    +"erbauen?\n");
  AddDetail(({"grauen", "ort"}),
	    "Hier ist wahrlich ein Ort des Grauens.\n");
  AddDetail(({"blut"}),
	    "Es ist ein Meer aus Blut welches von zumeist unschuldigen Opfern stammt.\n");
  AddDetail(("meer"),
	    "Es ist tatsaechlich soviel Blut hier, dass man von einem Meer sprechen kann.\n");
  AddDetail(("opfer"),
	    "Die meisten Opfer haben dieses Schicksal wohl nicht verdient.\n");
  AddDetail(("schicksal"),
	    "Das Schicksal kann oft sehr grausam sein.\n");
  AddDetail(({"tuer", "holztuer"}),
	    "Eine kleine unscheinbare Holztuer. Ob da was wichtiges "
	    +"dahinter ist?\n");
  AddDetail(("luft"),
	    "Die Luft ist kuehl hier und es stinkt fuerchterlich.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "luft"}),
	    "Der Geruch von Tod, Blut und Verwesung liegt in der Luft.\n");
  AddSmell(({"tod", "verwesung", "blut"}),
	   "Iehhhh, stinkt fuerchterlich.\n");

  // DETAILS ENDE
  
  // EXITS START
  
  AddExit(("nordosten"), ROOM+"palast5");
  AddExit(("suedosten"), ROOM+"palast3");
  
  // EXITS END
  
  
  // COMMANDS START
  
  AddCmd(({"oeffne"}), "oeffne_was");
  
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if (( str == "tuer" || str == "holztuer" ))
    {
      write(BS("Mit aller Kraft versuchst Du die Tuer "
	       +"zu oeffnen, schaffst es jedoch nicht.\n"));
      return 1;
    }
  else return 0;
}

reset()
{
  ::reset();
}  

















