#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int leicheda=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im Knochenpalast.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst hier in einer wahren Leichenkammer. Ueberall "
	   +"um Dich herum liegen unzaehlige Kadaver von den verschiedensten "
	   +"Lebewesen. Es stinkt fuerchterlich und der Boden ist rot vor lauter "
	   +"Blut. Man koennte fast meinen hier ist das Essenslager eines "
	   +"Ungetuems \(wahrscheinlich entspricht dies sogar der Wahrheit\). "
	   +"Zwei Gaenge fuehren von hier fort. Der eine nach Suedosten und der "
	   +"andere nach Westen.\n");
  
  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(("wahrheit"),
	    "Die Wahrheit muss nicht unbedingt schoen sein.\n");
  AddDetail(("raum"),
	    "Dieser Raum ist eine wahre Leichenkammer in diesem ohnehin "
	    +"ruchlosen Palast.\n");
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt zwei Gaenge hier, der eine fuehrt nach Westen, der "
	    +"andere nach Suedosten.\n");
  AddDetail(({"innere", "knochenpalast", "palast"}),
	    "Du befindest Dich hier im Inneren des ruchlosen "
	    +"Knochenpalast.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus Knochen. Massenhaft Blut klebt an ihnen.\n");
  AddDetail(({"kammer", "leichenkammer"}),
	    "Diese Kammer ist eine wahre Leichenkammer. Ueberall um Dich herum liegen "
	    +"die Kadaver verschiedenster Lebewesen.\n");
  AddDetail(("lebewesen"),
	    "Jetzt sind die bei weitem nicht so lebendig wie vorher.\n");
  AddDetail(({"kadaver", "rassen", "menschen", "zwerge", "gaffos", "elfen",
		"feen", "dunkelelfen", "trolle", "oger", "hobbits", "orks",
		"goblins", "minotauren"}), 
	    "Du siehst Leichen verschiedenster Rassen: Menschen, Zwerge, Gaffos, "
	    +"Elfen, Feen, Dunkelelfen, Trolle, Oger, Hobbits, Orks und Goblins "
	    +"und sogar einige Minotauren. Die Leiche eines Gnoms faellt Dir besonders "
	    +"auf.\n");
  AddDetail(("decke"),
	    "Die Decke ist hier ziemlich weit oben. Vermutlich bist Du unterhalb "
	    +"eines der Tuerme.\n");
  AddDetail(({"tuerme", "turm"}),
	    "Der Palast hat insgesamt fuenf Tuerme. Du duerftest jetzt unter einem "
	    +"Turm stehen.\n");
  AddDetail(("knochen"),
	    "Der ganze Palast besteht nur aus Knochen.\n");
  AddDetail(({"boden", "knochenboden", "unmenge"}),
	    "Auch der Boden besteht aus Knochen. Eine Unmenge Blut klebt an ihm.\n");
  AddDetail(({"blut", "meer"}),
	    "Du watest in einem Meer aus Blut, soviel ist davon hier.\n");
  AddDetail(({"verwesung", "verwesen"}),
	    "Es stinkt hier fuerchterlich nach Verwesung.\n");
  AddDetail(("essenslager"),
	    "Dieser Raum dient mit ziemlicher Sicherheit als Essenslager fuer "
	    +"ein schreckliches Ungetuem.\n");
  AddDetail(("sicherheit"),
	    "Sicherheit kannst Du Dir hier keine erwarten.\n");
  AddDetail(("ungetuem"),
	    "Das Ungetuem lauert hier sicher irgendwo. Aber wo genau?\n");
  AddSpecialDetail(({"leiche", "gnom"}), "leiche_schau");
  AddSpecialDetail(({"loch"}), "loch_schau");
  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch",}),
	    "Es stinkt nach Tod und Verwesung, der Gestank ist kaum zu ertragen.\n");
  AddSmell(({"tod", "verwesung", "verwesungsgeruch", "gestank"}),
	   "Das riecht grauenvoll. Angewidert haeltst Du Dir die Nase zu.\n");
  AddDetail(("tod"),
	    "Auf den Tod kannst Du vorlaeufig sicher verzichten.\n");
  AddDetail(("nase"),
	    "Du haeltst sie jetzt gaaaanz fest zu.\n");

  // DETAILS ENDE
  
  // EXITS START
  
  AddExit(("westen"), ROOM+"palast5");
  AddExit(("suedosten"), ROOM+"palast1");
  
  // EXITS END
    
  // COMMANDS START
  
  AddCmd(({"krieche", "kriech"}), "kriech_durch");
  AddCmd(({"schieb", "schiebe"}), "schiebe_weg");

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

schiebe_weg(str)
{
  notify_fail(BS("Was willst Du wegschieben?\n"));
  if (!str) return 0;
  if ((str == "leiche weg" || str == "gnom weg" ||
       str == "leiche" || str == "gnom"))
    {
      if (leicheda==0) 
	{
	  write(BS("Die Leiche ist ja bereits weggeschoben worden.\n"));
	  return 1;
	}
      else
	{
	  write(BS("Du schiebst die Leiche weg und entdeckst hinter ihr "
		   +"ein grosses Loch in der Wand.\n"));
	  leicheda=0;
	  return 1;
	}
    }
  else return 0;
}

kriech_durch(str)
{
  notify_fail(BS("Durch was willst Du kriechen?\n"));
  if (!str) return 0;
  if ((str == "in loch" || str == "durch loch" ||str == "durch loch hindurch"))
    {
      if (leicheda==1) return 0;
      else
	{
	  write("Da soll noch a gscheite Sequenz her!");
	  
	  // DA SEQUENZ EINBAUN NICHT VERGESSEN....
	  
	  TP->move(ROOM+"insel2", M_GO, "durch ein Loch", "kriecht",
		   "fliegt von oben herein");
	  TP->AddHp(-10);
	  return 0;
	}
    }
  else return 0;
}

leiche_schau()
{
  if (leicheda==1)
    return(BS("Es ist die Leiche eines jungen ungluecklichen Gnomes. Hinter "
	      +"der Leiche scheint etwas zu sein, allerdings muesstest Du zuerst "
	      +"die Leiche wegschieben um es naeher untersuchen zu koennen.\n"));
  else
    return(BS("Neben der Leiche des Gnomes ist ein grosses Loch zu sehen.\n"));  
}

loch_schau()
{
  if (leicheda==1)
    {
      return(BS("Sowas siehst Du da nicht!"));
    }
  else
    {
      return(BS("Es ist ein grosses Loch durch welches man vielleicht "
		+"hindurchkriechen koennte.\n"));  
    }
}

reset()
{
  ::reset();
  leicheda=1;
}  

















