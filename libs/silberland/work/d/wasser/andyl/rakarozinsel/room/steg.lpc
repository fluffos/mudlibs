#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Auf einem Steg.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst hier auf einem kleinen Steg. Das Meer "
	   +"rauscht angenehm und es weht eine sanfte Brise. Die Insel auf "
	   +"der Du jetzt bist macht jedoch keinen sehr freundlichen Eindruck. "
	   +"Die Landschaft ist oed und kahl und es sind weder Lebewesen noch "
	   +"Pflanzen zu entdecken. Im Nordwesten siehst Du einen unheimlichen "
	   +"weissen Palast der drohend vor Dir aufragt. Ein Weg fuehrt nach "
	   +"Westen zu diesem Palast.\n");

  // ROOM DESCRIPTION END;

  // DETAILS START

  AddDetail(({"pflanzen", "lebewesen"}),
	    "Nichts davon zu sehen.\n");
  AddDetail(("palast"),
	    "Es ist ein unheimlich weisser Palast. Er steht auf einer Anhoehe "
	    +"im Nordwesten und ragt bedrohlich vor Dir auf.\n");
  AddDetail(("anhoehe"),
	    "Auf der Anhoehe steht der unheimliche Palast.\n");
  AddDetail(({"himmel", "grossteil"}),
	    "Ein paar dunkle Wolken sind am Himmel zu sehen. Interessanterweise "
	    +"ballt sich der Grossteil der Wolken ueber der Insel zusammen und " 
	    +"ueber dem Meer lichtet sich der Himmel wieder und die Sonne scheint "
	    +"hervor.\n");
  AddDetail(({"wolke", "wolken", "wolkendecke"}),
	    "Es sind bedrohlich schwarze Wolken die sich hauptsaechlich ueber dem "
	    +"Palast zusammenballen.\n");
  AddDetail(({"sonne", "luecken"}),
	    "Durch einige Luecken in der Wolkendecke scheint die Sonne noch hervor.\n");
  AddDetail(("meer"),
	    "Weit erstreckt sich das Meer bis zum Horizont.\n");
  AddDetail(("horizont"),
	    "Der ist da gaaaanz weit hinten irgendwo.\n");
  AddDetail(({"steg", "holzsteg"}),
	    "Es ist ein sehr einfacher Holzsteg der aus Brettern und Pfloecken "
	    +"zusammengezimmert wurde.\n");
  AddDetail(({"bretter", "brett"}),
	    "Die Bretter sind zwar nicht mehr ganz neu, reichen aber voellig aus "
	    +"um Dein Gewicht zu tragen.\n");
  AddDetail(({"pfloecke", "pflock"}),
	    "Die Pfloecke sehen sehr robust aus, sie duerften also leicht Dein "
	    +"Gewicht tragen.\n");
  AddDetail(("gewicht"),
	    "Du hast doch nicht etwa an Gewicht zugelegt?\n");
  AddDetail(("eindruck"),
	    "Die Insel macht keinen besonders freundlichen Eindruck auf Dich.\n");
  AddDetail(("insel"),
	    "Du bist hier auf Insel, welche jedoch keinen besonders freundlichen "
	    +"Eindruck auf Dich macht.\n");
  AddDetail(("landschaft"),
	    "Die Landschaft ist oed und kahl, Du siehst ueberall nur Felsen und "
	    +"ausgetrockneten Boden.\n");
  AddDetail(("felsen"),
	    "Es sind grosse graue Felsen voller Risse und Spalten.\n");
  AddDetail(({"risse", "spalten"}),
	    "In den Rissen und Spalten gibts es hier jedoch sicher nichts "
	    +"zu finden. Besonders nicht fuer Dich "+this_player()->name(WER,2)+".\n");
  AddDetail(({"boden"}),
	    "Der Boden ist ausgetrocknet und leblos.\n");
  AddDetail(({"weg", "richtung"}),
	    "Der Weg fuehrt in Richtung Palast.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst das sanfte Rauschen des Meeres und das "
	    +"Saeuseln des Windes.\n");
  AddSound(("rauschen"),
	   "Das Rauschen hoert sich beruhigend an.\n");
  AddDetail(({"brise", "wind", "rauschen"}),
	    "Du kannst ja mal lauschen.\n");
  AddDetail(({"wind","saeuseln", "brise", "pffffft"}),
	    "Sanft saeuselt Dir der Wind ein: 'Pffffft' ins Ohr.\n");
  AddDetail(("ohr"),
	    "Damit kann man lauschen, auch wenn Du das "
	    +"vielleicht nicht glaubst.\n"); 
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst den salzigen Geruch des Meeres.\n");
  AddSmell(("meer"),
	   "Riecht salzig und auch ein bisschen fischig.n");
 
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("westen"), ROOM+"insel1");
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}


reset()
{
  ::reset();
}  

















