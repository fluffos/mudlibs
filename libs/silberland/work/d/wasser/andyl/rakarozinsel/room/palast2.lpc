#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im Knochenpalast.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst jetzt in einem weiteren Raum des Palastes. Es ist "
	   +"duester und kuehl hier. Die Luft hier ist stickig und es riecht "
	   +"nach Verwesung. Die Leiche eines Zwerges, oder das was davon uebrig ist "
	   +"liegt inmitten des Raumes. Zwei Gaenge fuehren von hier fort. "
	   +"Der eine nach Nordosten, der andere nach Westen.\n");
  
  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(("raum"),
	    "Du befindest Dich jetzt in einem Raum des Palastes, welcher "
	    +"vermutlich unter einem der Tuerme liegt.\n");
  
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt zwei Gaenge hier, der eine fuehrt nach Westen, der "
	    +"andere nach Nordosten.\n");
  AddDetail(({"innere", "knochenpalast", "palast"}),
	    "Du befindest Dich jetzt im Inneren des unheimlichen "
	    +"Knochenpalasts.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus Knochen der verschiedensten Rassen. "
	    +"Blut klebt an ihnen.\n");
  AddDetail(({"lebewesen", "rassen"}),
	    "Die Knochen verschiedenster Lebewesen und Rassen bilden "
	    +"diesen Ort des Grauens.\n");
  AddDetail(("grauen"),
	    "Das Grauen ueberwaeltigt Dich beinahe.\n");
  AddDetail(("ort"),
	    "Dieser Ort ist wahrlich ein Ort des Grauens.\n");
  AddDetail(("decke"),
	    "Die Decke ist hier ziemlich weit oben. Vermutlich bist Du unterhalb "
	    +"eines der Tuerme.\n");
  AddDetail(({"tuerme", "turm"}),
	    "Der Palast hat insgesamt fuenf Tuerme. Du duerftest jetzt unter einem "
	    +"Turm stehen.\n");
  AddDetail(("boden"),
	    "Auch der Boden besteht aus Knochen. Ueberall auf ihm sind Blutspuren "
	    +"zu sehen.\n");
  AddDetail(({"blut", "blutspuren", "blutspur"}),
	    "Viele der Blutspuren sind ziemlich alt, jedoch scheinen einige davon "
	    +"auch neu zu sein. Hier ist Dein Leben sicher in Gefahr.\n");
  AddDetail(({"zwerg", "leiche"}),
	    "Es ist die Leiche eines Zwerges, oder das was davon uebrig ist. "
	    +"Es ist nur noch der Rumpf ueber, von dem Kopf, den Haenden und "
	    +"den Beinen fehlt jede Spur.\n");
  AddDetail(({"beine", "kopf", "haende"}),
	    "Nichts davon zu entdecken, nicht die geringste Spur.\n");
  AddDetail(({"rumpf", "stelle"}),
	    "Tiefe Wunden sind im Rumpf zu sehen, der Zwerg war wohl auf der "
	    +"Stelle tot.\n");
  AddDetail(("wunden"),
	    "Dem Ungetuem was solche Wunden verursacht, moechtest Du lieber "
	    +"nicht begegnen.\n");
  AddDetail(({"ungetuem", "gefuehl"}),
	    "Dein Gefuehl sagt Dir, dass das Ungetuem hier irgendwo in der "
	    +"Naehe lauert.\n");
  AddDetail(("naehe"),
	    "Ganz in der Naehe.\n");
  AddDetail(("spur"),
	    "Du entdeckst nur eine Blutspur.\n");
  AddDetail(("leben"),
	    "Das willst Du doch nicht verlieren, oder?\n");
  AddDetail(("gefahr"),
	    "Hier irgendwo lauert die Gefahr.\n");
  AddDetail(("boese"),
	    "Du kannst das Boese hier regelrecht fuehlen.\n");
  AddDetail(("verwesung"),
	    "Der Geruch von Verwesung liegt in der Luft.\n");
  AddDetail(("luft"),
	    "Die Luft hier drinnen is ziemlich stickig.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "luft"}),
	    "Der Geruch von Verwesung liegt in der Luft.\n");
  AddSmell(({"tod", "verwesung", "verwesungsgeruch"}),
	   "Der Verwesungsgeruch duerfte von der Leiche und den Knochen stammen.\n");
  AddSmell(({"leiche", "knochen"}),
	   "Der Geruch des Todes kommt von dort.\n");
  
  // DETAILS ENDE
  
  // EXITS START
  
  AddExit(("nordosten"), ROOM+"palast1");
  AddExit(("westen"), ROOM+"palast3");
  
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

reset()
{
  ::reset();
}  

















