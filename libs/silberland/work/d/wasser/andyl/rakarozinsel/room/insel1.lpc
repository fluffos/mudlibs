#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Auf einer Kreuzung");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst hier auf einer Kreuzung. Der Weg gabelt sich hier "
	   +"in drei Richtungen in welche Du weitergehen kannst. Du kannst von hier "
	   +"nach Nordwesten zu dem unheimlichen Palast, nach Osten zurueck zum Steg "
	   +"oder nach Norden zu einer seltsam aussehenden Felsformation gehen. Es "
	   +"ist beunruhigend still hier und Pflanzen oder Lebewesen sind ebenfalls "
	   +"nicht zu entdecken.\n");

  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(("kreuzung"),
	    "Du stehst jetzt auf einer Kreuzung. Der Weg gabelt sich hier in drei "
	    +"Richtungen.\n");
  AddDetail(("weg"),
	    "Der Weg gabelt sich hier in drei Richtungen.\n");
  AddDetail(({"richtungen", "richtung"}),
	    "Du kannst von hieraus in die Richtungen Nordwesten, Westen und Osten.\n");
  AddDetail(({"pflanzen", "lebewesen"}),
	    "Nichts davon zu sehen.\n");
  AddDetail(("palast"),
	    "Es ist ein unheimlich weisser Palast. Er steht auf einer Anhoehe "
	    +"im Nordwesten und ragt bedrohlich vor Dir auf.\n");
  AddDetail(("anhoehe"),
	    "Auf der Anhoehe steht der unheimliche Palast.\n");
  AddDetail(({"himmel", "grossteil"}),
	    "Dunkle Wolken ballen sich ueber Dir zusammmen, die Sonne scheint nur noch "
	    +"ganz vereinzelt hervor.\n");
  AddDetail(({"wolke", "wolken"}),
	    "Es sind bedrohlich schwarze Wolken.\n");
  AddDetail(({"sonne"}),
	    "Man sieht von der Sonne kaum noch etwas.\n");
  AddDetail(("insel"),
	    "Du bist hier auf Insel, welche jedoch keinen besonders freundlichen "
	    +"Eindruck auf Dich macht.\n");
  AddDetail(("eindruck"),
	    "Dein Eindruck von dieser Insel ist nicht besonders positiv.\n");
  AddDetail(("felsformation"),
	    "Die Felsformation befindet sich noerdlich von hier. Irgendetwas hebt sie "
	    +"von den umliegenden Felsen ab. Die solltest Du Dir vielleicht naeher ansehen.\n");
  AddDetail(("felsen"),
	    "Es sind gewoehnliche grosse graue Felsen.\n");
  AddDetail(({"boden", "begriff", "erde"}),
	    "Der Begriff verbrannte Erde trifft auf diesen Boden zu. Er ist ausgetrocknet "
	    +"und voellig leblos.\n");
  AddDetail(({"steg"}),
	    "Der Steg befindet sich oestlich von hier. Wenn Du also wieder von der Insel "
	    +"weg willst musst Du dorthin gehen.\n");
  AddDetail(({"norden", "nordwesten", "osten"}),
	    "Das ist eine Richtung.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "auffaelliges"}),
	    "Du riechst nichts Auffaelliges.\n");
  
  // DETAILS ENDE
  
  // EXITS START
  AddExit (("nordwesten"), ROOM+"tor");
  AddExit (("osten"), ROOM+"steg");
  AddExit (("norden"), ROOM+"insel2");
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}


reset()
{
  ::reset();
}  

















