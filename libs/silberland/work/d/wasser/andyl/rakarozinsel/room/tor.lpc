#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int torzu=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Vor dem Palasttor.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst jetzt vor dem Tor des unheimlichen Palast. Eine "
	   +"duestere Stimmung kommt in Dir auf als Du deine Umgebung naeher betrachtest. "
	   +"Das Weiss des Palastes stammt daher, dass er komplett aus Knochen erbaut worden "
	   +"ist. Es sind Knochen saemtlicher Rassen welche in einer abartigen Weise diesen "
	   +"Ort des Grauens . Neben dem Tor siehst Du die Leiche eines jungen "
	   +"Mannes, seiner Kleidung nach zu schliessen ein Fischer, welche uebel zugerichtet "
	   +"aussieht. Die Wolken ueber Dir sind hier besonders dunkel und der Geruch des Todes "
	   +"liegt in der Luft.\n");

  // ROOM DESCRIPTION END;

  // DETAILS START
  
  AddDetail(("boden"),
	    "Der Boden ist kahl und leblos. Nur etwas Blut von der Leiche ist darauf zu sehen.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende des Palastes bestehen aus Knochen der verschiedensten Rassen.\n");
  AddDetail(("himmel"),
	    "Am Himmel sind tiefschwarze Wolken zu sehen.\n");
  AddDetail(({"wolken"}),
	    "Die Wolken sind tiefschwarz und haben bedrohliche Formen. Eine Wolke faellt Dir "
	    +"besonders auf.\n");
  AddDetail(({"formen", "form"}),
	    "Die Wolken haben teils recht eigenartige und bedrohliche Formen.\n");
  AddDetail(({"wolke", "sarg", "wunden"}),
	    "Die Wolke hat ja die Form von DIR und zwar in einem Sarg und mit haesslichen "
	    +"Wunden. Angewidert wendest Du Dich ab.\n");
  AddDetail(("blut"),
	    "Das Blut ist bereits geronnen und verkrustet.\n");
  AddDetail(({"palast", "gebaeude"}),
	    "Es ist ein riesiger Palast welcher komplett aus Knochen erbaut wurde. Er hat "
	    +"keine Fenster, fuenf Tuerme und ein riesiges Eingangstor, vor welchem Du jetzt "
	    +"stehst. Er scheint schon sehr alt zu sein.\n");
  AddDetail(({"turm", "tuerme", "erhebungen"}),
	    "Der Palast hat insgesamt fuenf Tuerme. Vier jeweils an den Ecken und einen grossen "
	    +"in der Mitte. Seltsamerweise sind jedoch weder Schiessscharten noch Zinnen an den "
	    +"Tuermen zu erkennen. Es scheinen mehr Erhebungen aus dem Knochengebilde des Palastes "
	    +"zu sein.\n");
  AddDetail(("knochengebilde"),
	    "Der Palast ist ein einziges Knochengebilde.\n");
  AddDetail(("ecken"),
	    "An den vier Ecken des Palastes sind jeweils vier Tuerme.\n");
  AddDetail(("mitte"),
	    "In der Mitte des Palastes ragt ein besonders grosser Turm auf.\n");
  AddDetail(({"schiessscharten", "zinnen", "fenster"}),
	    "Eigenartigerweise keine zu entdecken.\n");
  AddDetail(("umgebung"),
	    "Deine Umgebung stimmt Dich nicht besonder froehlich.\n");
  AddDetail(("stimmung"),
	    "Die Stimmung hier ist zutiefst gedrueckt und Du fuehlst das Boese welches "
	    +"diesen Ort durchstroemt.\n");
  AddDetail(("boese"),
	    "Das Boese welches diesen Ort durchstroemt kann man allzu deutlich fuehlen.\n");
  AddDetail(({"ort", "grauen"}),
	    "Dieser Ort ist definitiv ein Ort des Boesen und des Grauens.\n");
  AddDetail(({"weiss", "ganze"}),
	    "Das Weiss des Palastes stammt daher, dass das gesamte Gebaeude aus Knochen erbaut "
	    +"wurde. Das Ganze ist ziemlich makaber.\n");
  AddDetail(({"knochen"}),
	    "Aus den Knochen wurde dieser Palast erbaut. Es sind Knochen von allen moeglichen "
	    +"Rassen.\n");
  AddDetail(({"rassen", "menschen", "zwerge", "elfen", "feen", "goblins", "orks", "oger", "trolle", "dunkelelfen"}),
	    "Du siehst hier die Knochen von Menschen, Zwergen, Elfen, Feen, Goblins, Orks, Oger "
	    +"Trolle, Dunkelelfen und noch von unzaehligen mehr.\n");
  AddDetail(({"leiche", "mann", "fischer", "koerper", "leichnam", "ende"}),
	    "Es ist die Leiche eines jungen Mannes, so Ende zwanzig, welcher der Kleidung nach ein "
	    +"Fischer gewesen sein duerfte. Sein Koerper wurde grausam zugerichtet. Du kannst deutlich "
	    +"sie Spuren von riesigen Klauen entdecken, welche den ganzen Leichnam uebersaeen.\n");
  AddDetail(({"kleidung", "seemannskleidung"}),
	    "Die Kleidung besteht aus typischer Seemannskleidung, wie es auch die Fischer gerne tragen.\n");
  AddDetail(({"spuren", "klauen"}),
	    "Die Spuren der Klauen sind deutlich an dem Leichnam zu sehen. Was fuer ein Ungetuem "
	    +"hat dem armen Fischer dies wohl angetan?\n");
  AddDetail(("ungetuem"),
	    "Diesem Ungetuem moechtest Du lieber nicht begegnen.\n");
  AddDetail(("weise"),
	    "Die Knochen wurden in einer ganz und gar abartigen Weise zu diesem Palast geformt.\n");
  AddDetail(("luft"),
	    "In der Luft liegt der Duft des Todes. Du kannst es regelrecht fuehlen.\n");
  AddDetail(("nase"), 
	    "Deine Nase saugt den Duft des Todes ein. Dir wird etwas schummrig.\n");
  

  AddSpecialDetail(({"tor", "eingangstor"}), "tor_schau");
  AddSpecialDetail(({"kette"}), "kette_schau");


  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "duft"}),
	    "Der Geruch des Todes steigt Dir in die Nase.\n");
  AddSmell(({"tod", "todesgeruch"}),
	   "Der Todesgeruch duerfte von der Leiche und den Knochen stammen.\n");
  AddSmell(({"leiche", "knochen"}),
	   "Der Geruch des Todes kommt von dort.\n");
  

  // DETAILS ENDE
  
  // EXITS START
  AddExit (("suedosten"), ROOM+"insel1");
  AddSpecialExit(("palast", "palastexit")); 
  // EXITS END
  
  
  // COMMANDS START
  
  AddCmd(("oeffne"), "oeffne_was");

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  write(BS("Gibt no nix!\n"));
  return 0;
}


int palastexit(string dir)
{
  if (torzu==1) 
    {
      write (BS("Du musst erst das Tor oeffnen um in den Palast zu gelangen.\n"));
      return 1;
    }
  else
    {
      write (BS("Das Tor ist zwar offen, aber deswegen kommst Du trotzdem nicht durch.\n"));      
      return 1;
    }
}


tor_schau()
{
  return("Da gibts no nix !");
}


reset()
{
  ::reset();
}  

















