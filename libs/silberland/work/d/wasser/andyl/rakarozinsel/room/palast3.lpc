#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im Knochenpalast.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du dueftest Dich hier wieder unter einem der Tuerme befinden."
	   +"Es ist dunkel und kuehl hier drinnen. Einige Blutflecken sind am Boden "
	   +"und an der Wand zu entdecken. Die Stimmung hier ist drueckend wie auch "
	   +"anderswo in diesem unheimlichen Knochenpalast. Zwei Gaenge fuehren von "
	   +"hier fort. Der eine nach Osten und der andere nach Nordwesten.\n");
  
  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt zwei Gaenge hier, der eine fuehrt nach Osten, der "
	    +"andere nach Nordwesten.\n");
  AddDetail(({"innere", "knochenpalast", "palast"}),
	    "Du befindest Dich hier im Inneren des unheimlichen "
	    +"Knochenpalasts.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus Knochen und sie sind mit Blutflecken "
	    +"uebersaet. Ein Blutfleck faellt Dir besonders auf.\n");
  AddDetail(("decke"),
	    "Die Decke ist hier ziemlich weit oben. Vermutlich bist Du unterhalb "
	    +"eines der Tuerme.\n");
  AddDetail(({"tuerme", "turm"}),
	    "Der Palast hat insgesamt fuenf Tuerme. Du duerftest jetzt unter einem "
	    +"Turm stehen.\n");
  AddDetail(({"boden", "knochenboden"}),
	    "Auch der Boden besteht aus Knochen. Ueberall auf ihm sind Blutflecken "
	    +"zu sehen.\n");
  AddDetail(({"blut", "blutflecken"}),
	    "Manche der Blutflecken scheinen alt zu sein, einige jedoch sind auch neu.\n");
  AddDetail(("blutfleck"),
	    "Der Blutfleck hat eine eigenartige Form und ein Loch ist in seiner Mitte.n");
  AddDetail(("form"),
	    "Der Blutfleck hat die Form eines Herzens. Ob das was zu bedeuten hat?\n");
  AddDetail(("herz"),
	    "Das Herz wird oft als Symbol fuer die Liebe oder auch des Lebens benutz.\n");
  AddDetail(("liebe"),
	    "Von Liebe ist an diesem Ort nichts zu spueren.\n");
  AddDetail(("leben"),
	    "Dein Leben moechtest Du hier lieber nicht verlieren.\n");
  AddDetail(({"loch", "groesse"}),
	    "Das Loch hat ungefaehr die Groesse einer Muenze. Ob man da vielleicht "
	    +"Muenzen reinlegen kann?\n");
  AddDetail(("stimmung"),
	    "Deine Stimmung hebt sich nicht wirklich an diesem Ort des Grauens.\n");
  AddDetail(("ort"),
	    "Welche kranke Kreatur hat diesen fuerchterlichen Ort wohl geschaffen?\n");
  AddDetail(("kreatur"),
	    "Die Kreatur welche diesen Ort geschaffen hat muss ziemlich krank gewesen sein.\n");
  AddDetail(({"grauen", "argh"}),
	    "Das Grauen kommt ueber Dich. ARGH !!!\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht muffig hier.\n");
  AddSmell(({"knochen"}),
	   "Der Geruch des Todes kommt von dort.\n");
  AddSmell(("tod"),
	   "Auf den Geruch des Todes kannst Du gerne verzichten.\n");
  AddDetail(("tod"),
	    "Auf den Tod kannst Du vorlaeufig sicher verzichten.\n");
  // DETAILS ENDE
  
  // EXITS START
  
  AddExit(("osten"), ROOM+"palast2");
  AddExit(("nordwesten"), ROOM+"palast4");
  
  // EXITS END
  
  
  // COMMANDS START

  AddCmd(({"leg", "lege"}), "lege_was"); 
  
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

lege_was(str)
{
  notify_fail("Was willst Du wo hineinlegen?n");
  if (!str) return 0;
  
  // HP-Funktion einbaun....
  write(BS("Hier gibts leida no nix!\n"));
  return 1;
}

reset()
{
  ::reset();
}  

















