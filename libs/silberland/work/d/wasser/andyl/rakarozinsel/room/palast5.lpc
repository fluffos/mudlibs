#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im Knochenpalast.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst hier wieder in einem Raum mit einer erhoehten "
	   +"Decke. Vermutlich bist du unter einem der Tuerme. Es ist kuehl hier "
	   +"und Licht ist hier drinnen auch keines. Ein uebler Geruch liegt "
	   +"in der Luft. Der Raum ist mit Blutspuren "
	   +"uebersaet und da und dort haengen auch noch einige Fleischfetzen. "
	   +"Zwei Gaenge fuehren von hier fort. Der eine nach Osten und der andere "
	   +"nach Suedwesten.\n");
  
  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(("raum"),
	    "Du befindest Dich jetzt in einem Raum des Palastes, welcher "
	    +"vermutlich unter einem der Tuerme liegt.\n");
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt zwei Gaenge hier, der eine fuehrt nach Osten, der "
	    +"andere nach Suedwesten.\n");
  AddDetail(("licht"),
	    "Kein Licht zu entdecken.\n");
  AddDetail(({"innere", "knochenpalast", "palast"}),
	    "Du befindest Dich hier im Inneren des unheimlichen "
	    +"Knochenpalasts.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus Knochen der verschiedensten Rassen. "
	    +"Blut klebt an ihnen.\n");
  AddDetail(({"lebewesen", "rassen"}),
	    "Die Knochen verschiedenster Lebewesen und Rassen bilden "
	    +"diesen Ort des Grauens.\n");
  AddDetail(("grauen"),
	    "Das Grauen ueberwaeltigt Dich beinahe.\n");
  AddDetail(("ort"),
	    "Dieser Ort ist wahrlich ein Ort des Grauens.\n");
  AddDetail(("decke"),
	    "Die Decke ist hier ziemlich weit oben. Vermutlich bist Du unterhalb "
	    +"eines der Tuerme.\n");
  AddDetail(({"tuerme", "turm"}),
	    "Der Palast hat insgesamt fuenf Tuerme. Du duerftest jetzt unter einem "
	    +"Turm stehen.\n");
  AddDetail(({"boden", "knochenboden"}),
	    "Auch der Boden besteht aus Knochen. Ueberall auf ihm sind Blutspuren "
	    +"zu sehen und hier und da auch einige Fleischfetzen.\n");
  AddDetail(({"blut", "blutspuren", "blutspur"}),
	    "Es sind Blutspuren die aussehen, als waere da viele blutende Geschoepfe "
	    +"nach Osten geschliffen worden.\n");
  AddDetail(("geschoepfe"),
	    "Der Menge des Blutes nach zu urteilen, haben diese Geschoepfe sicher "
	    +"nicht ueberlebt.\n");
  AddDetail(("menge"),
	    "Da ist wirklich eine Menge Blut vergossen worden.\n");
  AddDetail(({"fleischfetzen", "fetzen"}),
	    "Einige Fleischfetzen haben sich in dem Knochenboden verfangen. Die Fetzen "
	    +"sind zumeist schon am Verwesen und stinken dadurch fuerchterlich.\n");
  AddDetail(({"verwesung", "verwesen"}),
	    "Es stinkt hier fuerchterlich nach Verwesung.\n");
  AddDetail(("luft"),
	    "Die Luft riecht nach Tod und Verwesung.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "luft"}),
	    "Der Geruch von Tod und Verwesung liegt in der Luft.\n");
  AddSmell(({"tod", "verwesung", "verwesungsgeruch"}),
	   "Das riecht wahrlich nicht gut. Angewidert unterdrueckst Du ein Wuergen.\n");
  AddDetail(("wuergen"),
	    "Puh, gerade noch abgefangen.\n");
  AddSmell(({"knochen"}),
	   "Der Geruch des Todes kommt von dort.\n");
  AddDetail(("tod"),
	    "Auf den Tod kannst Du vorlaeufig sicher verzichten.\n");

  // DETAILS ENDE
  
  // EXITS START
  
  AddExit(("osten"), ROOM+"palast6");
  AddExit(("suedwesten"), ROOM+"palast4");
  
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

reset()
{
  ::reset();
}  

















