#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int nische_gefunden=0;

string schluchz()
{
  nische_gefunden=1;
  return(BS("Das Weinen und das Schluchzen kommt aus einer Nische hinter "
	    +"dem Knochenberg.\n"));
}

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "In einem Kerker.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst hier in einem dunklem Kerker. Die "
	   +"Holztuer im Westen scheint fest verschlossen zu sein und "
	   +"ansonsten siehst Du keine weiteren Ausgaenge. Auch Fenster "
	   +"oder dergleichen sind nicht zu entdecken. Ein riesiger "
	   +"Knochenberg liegt in einer der Ecken des Raumes. Ansonsten "
	   +"ist der Raum ziemlich trist und leer.\n");
  
  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(("raum"),
	    "Der Raum ist bis auf einen Knochenberg in einem Eck ziemlich trist und kahl.\n");
  AddDetail(("kerker"),
	    "Du stehts hier in einem dunklen Kerker.\n");
  AddDetail(({"innere", "knochenpalast", "palast"}),
	    "Du befindest Dich hier im Inneren des unheimlichen "
	    +"Knochenpalasts.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen vollstaendig aus Knochen. Fenster oder sonstige "
	    +"Ausgaenge kannst Du nicht entdecken.\n");
  AddDetail(("fenster"),
	    "Keine zu entdecken.\n");
  AddDetail(({"berg", "knochenberg"}),
	    "Es ist ein riesiger Berg an Knochen der da in der Ecke aufghaeuft wurde.\n");
  AddDetail(({"ecken"}),
	    "In einer der vier Ecken ist ein grosser Knochenberg.\n");
  AddDetail(("eck"),
	    "Da ist ein grosser Knochenberg.\n");
  AddDetail(({"ausgaenge", "ausgang"}),
	    "Du kannst nirgends einen Ausgang entdecken.\n");
  AddDetail(("decke"),
	    "Die Decke ist relativ hoch oben. Vermutlich bist Du jetzt "
	    +"im mittleren Turm des Palastes.\n");
  AddDetail(({"tuerme", "turm"}),
	    "Der Palast hat fuenf Tuerme und Du stehst jetzt vermutlich im "
	    +"mittleren der fuenf.\n");
  AddDetail(({"boden", "knochenboden"}),
	    "Auch der Boden besteht aus Knochen.\n");
  AddDetail(("knochen"),
	    "Es sind die Knochen verschiedenster Lebewesen.\n");
  AddDetail(("lebewesen"),
	    "Wieviele Lebewesen mussten wohl sterben um diesen Palast des Grauens zu "
	    +"erbauen?\n");
  AddDetail(({"grauen", "ort"}),
	    "Dieser Ort ist unverkennbar ein Ort des Grauens.\n");
  AddDetail(({"tuer", "holztuer"}),
	    "Eine kleine unscheinbare Holztuer. Sie ist fest verschlossen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Weinen und Schluchzen.\n");
  AddSound(({"weinen", "schluchzen"}), CLOSURE(schluchz));
  AddSpecialDetail(("nische"), "nische_schau");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht etwas muffig hier.\n");
  // DETAILS ENDE
  
  // EXITS START
  
  AddExit(("nordosten"), ROOM+"palast5");
  AddExit(("suedosten"), ROOM+"palast3");
  
  // EXITS END
  
  
  // COMMANDS START
  
  AddCmd(({"oeffne"}), "oeffne_was");
  
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

nische_schau()
{
  if (nische_gefunden==1)
    {     
      // FEE CLONEN !!!
      
      return(BS("In der Nische enteckst Du eine kleine Fee die dort "
		+"dort angekettet ist und weint.\n"));
    }
  else return(BS("Sowas siehst Du da nicht!\n"));
}

oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if (( str == "tuer" || str == "holztuer" ))
    {
      write(BS("Mit aller Kraft versuchst Du die Tuer "
	       +"zu oeffnen, schaffst es jedoch nicht.\n"));
      return 1;
    }
  else return 0;
}

reset()
{
  ::reset();
}  

















