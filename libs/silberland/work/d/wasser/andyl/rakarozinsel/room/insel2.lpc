#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Auf einer Kreuzung");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Eine seltsame Felsformation ragt westlich vor Dir auf. "
	   +"Sie ist direkt mit dem Palast verbunden und wirkt unnatuerlich rund. "
	   +"In der Felswand sind viele Risse und Loecher die gross genug sind, dass "
	   +"ein grosser Oger hindurchpassen wuerde. Ein Weg fuehrt wieder nach Sueden "
	   +"zur Kreuzung zurueck. Wie auch in den anderen Raeumen sind hier weder "
	   +"Pflanzen noch Lebewesen zu entdecken.\n");

  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(("kreuzung"),
	    "Die Kreuzung befindet sich im Sueden.\n");
  AddDetail(("raeume"),
	    "Naja, halt die Raeume in denen Du vorher warst.\n");
  AddDetail(("weg"),
	    "Der Weg fuehrt zurueck zur Kreuzung.\n");
  AddDetail(({"pflanzen", "lebewesen"}),
	    "Du kannst keine entdecken.\n");
  AddDetail(("palast"),
	    "Es ist ein unheimlich weisser Palast. Er steht auf einer Anhoehe "
	    +"westlich von Dir. Die Felsformation scheint mit dieser Anhoehe "
	    +"verbunden zu sein.\n");
  AddDetail(("anhoehe"),
	    "Auf der Anhoehe steht der unheimliche Palast. Die Felsformation ist "
	    +"direkt damit verbunden.\n");
  AddDetail(({"himmel", "grossteil"}),
	    "Dunkle Wolken ballen sich ueber Dir zusammmen, die Sonne scheint nur noch "
	    +"ganz vereinzelt hervor.\n");
  AddDetail(({"wolke", "wolken"}),
	    "Es sind bedrohlich schwarze Wolken.\n");
  AddDetail(({"sonne"}),
	    "Man sieht von der Sonne kaum noch etwas.\n");
  AddDetail(("insel"),
	    "Du bist hier auf Insel, welche jedoch keinen besonders freundlichen "
	    +"Eindruck auf Dich macht.\n");
  AddDetail(("eindruck"),
	    "Dein Eindruck von dieser Insel ist nicht besonders positiv.\n");
  AddDetail(("felsformation"),
	    "Die Felsformation ist ungewoehnlich rund und in der Felswand "
	    +"sind unzaehlige Risse und Loecher.\n");
  AddDetail(({"felsen", "fels"}),
	    "Gewoehnlicher grauer Fels.\n");
  AddDetail(({"felswand", "wand"}),
	    "In der Felswand sind viele Loecher und Risse. Da muss man sicher "
	    +"gut klettern koennen.\n");
  AddDetail(({"oger", "kombination"}),
	    "Gross, stark, dumm, boese, gefraessig, das alles in Kombination ist "
	    +"ein Oger.\n");
  AddDetail(("risse"),
	    "Es sind unzaehlige Risse in der Felswand. Das muesste eigentlich "
	    +"das Paradies fuer Kletterer sein.\n");
  AddDetail(("kletterer"),
	    "Fuer Kletterer muss diese Felswand mit den vielen Rissen ein wahres "
	    +"Paradies.\n");
  AddDetail(({"paradies", "kletterparadies"}),
	    "Ein wahres Kletterparadies.\n");
  AddDetail(({"loecher"}),
	    "Es sind teils sehr grosse Loecher in der Felswand die zumeist weiter "
	    +"oben im Fels sind. Eins davon faellt Dir besonders auf.\n");
  AddDetail(("loch"),
	    "Das Loch ist so gross, dass ein grosser Oger leicht hindurchpassen wuerde. "
	    +"Es ist nur leider so hoch oben, dass nur ein geuebter Kletterer dort hinauf "
	    +"kommen wuerde.\n");
  AddDetail(({"boden"}),
	    "Der Boden ist trist und leblos. Nur Steine und vertrocknete Erde.\n");
  AddDetail(({"steine", "stein", "kieselstein", "kieselsteine"}),
	    "Ganz gewoehnliche Kieselsteine.\n");
  AddDetail(({"erde"}),
	    "Die Erde ist voellig ausgetrocknet.\n");

  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "auffaelliges"}),
	    "Du riechst nichts Auffaelliges.\n");
  
  AddDetail(("kante"),
	    "Die ist sehr scharf.\n");
  AddDetail(("hand"),
	    "Deine Hand tut jetzt ziemlich weh.\n");

  // DETAILS ENDE
  
  // EXITS START
  AddExit (("sueden"), ROOM+"insel1");
  // EXITS END
  
  
  // COMMANDS START
  
  AddCmd(({"kletter", "klettere"}), "kletter_auf");

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

kletter_auf(str)
{
  notify_fail("Wo willst Du raufklettern?\n");
  if (!str) return 0;
  if ((str == "auf fels" || str == "auf felswand" ||
       str == "auf fels rauf" || str == "auf felswand rauf" ||
       str == "auf felsen" || str == "auf felsen rauf" ||
       str == "rauf" || str == "nach oben"))
    {
      TP->AddHp(-15);
      write(BS("Du versuchst Die Felsen hinaufzuklettern, schneidest "
	       +"Dich jedoch sogleich an einer scharfen Kante und verstauchst "
	       +"Die zusaetzlich dazu auch nich die Hand. Also beschliesst Du "
	       +"von dem Kletterversuch abzulassen.\n"));
      return 1;
    }
  else return 0;
}

reset()
{
  ::reset();
}  

















