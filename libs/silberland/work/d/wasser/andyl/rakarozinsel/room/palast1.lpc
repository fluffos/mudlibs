#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Im Knochenpalast.");
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_LONG, "Du stehst jetzt im Inneren des Knochenpalastes. Es ist "
	   +"ziemlich duester hier. Das Tor im Osten von Dir ist fest "
	   +"verschlossen und es sieht nicht so aus als koennte man es von "
	   +"hieraus oeffnen. Die Luft hier ist stickig und es riecht "
	   +"nach Verwesung. Du fuehlst das Boese hier ganz deutlich. Es fuehren "
	   +"zwei Gaenge von hier fort. Der eine nach Nordwesten, der andere nach "
	   +"Suedwesten.\n");

  // ROOM DESCRIPTION END;

  // DETAILS START
  AddDetail(({"gang", "gaenge"}),
	    "Es gibt zwei Gaenge hier, der eine fuehrt nach Nordwesten, der "
	    +"andere nach Suedwesten.\n");
  AddDetail(({"innere", "knochenpalast", "palast"}),
	    "Du befindest Dich jetzt im Inneren des unheimlichen "
	    +"Knochenpalasts.\n");
  AddDetail(({"palasttor", "tor"}),
	    "Das Palasttor ist fest verschlossen. Es scheint hier auch "
	    +"keinen Oeffnungsmechanismus dafuer zu geben.\n");
  AddDetail(({"oeffnungsmechanismus", "mechanismus"}),
	    "Keiner zu entdecken.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende bestehen aus Knochen der verschiedensten Rassen. "
	    +"Blut klebt an ihnen.\n");
  AddDetail(({"lebewesen", "rassen"}),
	    "Die Knochen verschiedenster Lebewesen und Rassen bilden "
	    +"diesen Ort des Grauens.\n");
  AddDetail(("grauen"),
	    "Das Grauen ueberwaeltigt Dich beinahe.\n");
  AddDetail(("ort"),
	    "Dieser Ort ist wahrlich ein Ort des Grauens.\n");
  AddDetail(("decke"),
	    "Die Decke besteht wie alles hier aus den Knochen verschiedenster "
	    +"Lebewesen.\n");
  AddDetail(("boden"),
	    "Auch der Boden besteht aus Knochen. Ueberall auf ihm sind Blutspuren "
	    +"zu sehen.\n");
  AddDetail(({"blut", "blutspuren"}),
	    "Viele der Blutspuren sind ziemlich alt, jedoch scheinen einige davon "
	    +"auch neu zu sein. Hier ist Dein Leben sicher in Gefahr.\n");
  AddDetail(("leben"),
	    "Das willst Du doch nicht verlieren, oder?\n");
  AddDetail(("gefahr"),
	    "Hier irgendwo lauert die Gefahr.\n");
  AddDetail(("boese"),
	    "Du kannst das Boese hier regelrecht fuehlen.\n");
  AddDetail(("verwesung"),
	    "Der Geruch von Verwesung liegt in der Luft.\n");
  AddDetail(("luft"),
	    "Die Luft hier drinnen is ziemlich stickig.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist unheimlich still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "luft"}),
	    "Der Geruch von Verwesung liegt in der Luft.\n");
  AddSmell(({"tod", "verwesung"}),
	   "Der Geruch der Verwesung duerfte von dem Blut und den Knochen kommen.\n");
  AddSmell(({"knochen"}),
	   "Der Geruch des Todes kommt von dort.\n");
  
  // DETAILS ENDE
  
  // EXITS START
  
  AddExit(("suedwesten"), ROOM+"palast2");
  AddExit(("nordwesten"), ROOM+"palast6");
  
  // EXITS END
  
  
  // COMMANDS START
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

reset()
{
  ::reset();
}  

















