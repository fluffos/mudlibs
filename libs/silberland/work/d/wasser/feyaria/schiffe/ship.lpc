inherit "/std/transport";

#include <properties.h>
#include <transport.h>

void create()
{
  ::create();

  SetProp(P_TOTAL_WEIGHT, 100000000 );
  SetProp(P_WEIGHT, 100000000 );
  SetProp(P_VALUE, 100000000 );
  AddCmd( ({ "betrete", "betritt" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );
}

rein(str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

raus(str)
{
  notify_fail("Was willst Du verlassen?\n");
  if( str && id(str) )
    return Leave();
  return 0;
}

void kalt()
{
  tell_room(this_object(), "Es wird eisig kalt.\n");
  SetProp(P_ENVIRONMENT, 
    QueryProp(P_ENVIRONMENT)+([ENV_TEMPERATURE:0+random(5)]) );
}

void warm()
{
  tell_room(this_object(), "Die Temperatur wird wieder angenehm.\n");
  SetProp(P_ENVIRONMENT, 
    QueryProp(P_ENVIRONMENT)+([ENV_TEMPERATURE:15+random(5)]) );
}

void heiss()
{
  tell_room(this_object(), "Es wird sehr heiss.\n");
  SetProp(P_ENVIRONMENT, 
    QueryProp(P_ENVIRONMENT)+([ENV_TEMPERATURE:28+random(5)]) );
}

void create_default_ship(int passengers)
{
  SetProp( P_DEPARTMSG, ({
    Name(WER,1)+" legt ab.\n", 
    Name(WER,1)+" legt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    Name(WER,1)+" legt @@QueryArrived@@ an.\n",
    Name(WER,1)+" legt im Hafen an.\n"}) );
    
  if( !intp(passengers) || passengers < 0 ) passengers = 0;
  SetProp( P_ENTERMSG, ({
    "besteigt "+name(WEN,1),
    "kommt auf "+name(WEN,1)}) );
  SetProp( P_ENTERFAIL, ({
    "Es passen nur "+passengers+" Passagiere auf "+name(WEN,1),
    "hat keinen Platz mehr auf "+name(WEM,1)}) );
  SetProp( P_MAX_PASSENGERS, passengers );

  SetProp( P_LEAVEMSG, ({
    "verlaesst "+name(WEN,1),
    "kommt von "+name(WEM,1)+" herunter"}) );
  SetProp( P_LEAVEFAIL, ({
    Name(WER,1)+" befindet sich doch auf hoher See",
    "wollte "+name(WEN,1)+" auf hoher See verlassen"}) );
}

#define EREIGNIS  ({ \
"Eine Schule Delphine begleitet das Schiff ein kurzes Stueck.", \
"Ein Wal taucht auf und sprueht eine Fontaene hoch in die Luft.",\
"Eine grosse Welle bricht sich am Bug und spritzt Dich von oben bis unten " \
  "nass.",\
"Starke Wellen lassen das Schiff schaukeln.",\
"Der starke Seegang erzeugt bei Dir ein unangenehmes Gefuehl im Magen.",\
"Ein grosser Haufen Seetang treibt am Schiff vorbei.",\
"Die dreieckige Rueckenflosse eines Hais taucht neben dem Schiff auf.",\
"Das Schiff treibt langsam durch eine windstille Zone.",\
"Ein Delphin begleitet das Schiff mit lustigen Spruengen.",\
"Ein Schwarm Voegel fliegt ueber das Schiff hinweg.",\
"Eine ploetzliche Windboe zerzaust Dein Haar.",\
"Eine riesige Seeschlange taucht kurz neben dem Schiff auf.",\
"Die Schiffsplanken knarren unter Deinen Fuessen.",\
"Der Wind erzeugt ein lustiges Pfeifen in der Takelage.",\
"Das Schiff faehrt durch ein grosses Tangfeld.",\
"Ein Bueschel Seetang treibt am Schiff vorbei.",\
"Die Segel knattern laut im Wind.",\
"Der Rumpf des Schiffes aechzt und stoehnt.",\
"Am Horizont segelt ein anderes Schiff in die Gegenrichtung.",\
"Ein grosser Fischschwarm schwimmt nahe der Wasseroberflaeche am Schiff "\
  "vorbei.",\
"Eine steife Brise verleiht dem Schiff eine flottere Geschwindigkeit.",\
"Das Schiff segelt nahe an einem Riff vorbei.",\
"Der Wind frischt auf und treibt das Schiff vor sich her.",\
"Der Wind dreht und das Schiff muss gegen den Wind kreuzen.",\
"Ein Matrose schrubbt missmutig das Deck.",\
"Schwarze Wolken ziehen am Horizont auf - ein Sturm ist im Anmarsch.",\
"Eine alte, mit Muscheln bewachsene Schiffsplanke treibt am Schiff vorbei.",\
"Eine Walherde zieht in grosser Entfernung am Schiff vorbei.",\
"Ein einsamer Seevogel fliegt ueber das Schiff.",\
"Eine Moewe laesst sich kreischend auf einem Mast nieder.",\
"In der Entfernung segelt ein kleines Fischerboot vorbei.",\
"Das Piratenschiff taucht am Horizont auf und beginnt die Verfolgung.",\
"Ein gewaltiger Vogel kreist in grosser Hoehe ueber dem Schiff.",\
"Ein Schwarm Zugvoegel fliegt in V-Formation ueber den Himmel.",\
"Eine Meeresnixe taucht neben dem Schiff auf und laechelt Dich an.",\
"Ein riesiger Adler fliegt mit extrem hoher Geschwindigkeit ueber den "\
  "Himmel.",\
"Eine Gruppe Haie schwimmt fuer einige Zeit hungrig neben dem Schiff her.",\
"Eine grosse Meeresschildkroete schwimmt neben dem Schiff.",\
"Ein Pelikan stuerzt neben dem Schiff ins Wasser und taucht mit einem Fisch "\
  "wieder auf.",\
"Ein maechtiger Baumstamm treibt am Schiff vorbei.",\
"Du glaubst, am Horizont Land zu sehen, aber es ist nur eine "\
  "Wolkenformation.",\
"Ein Seeotter schwimmt neben dem Schiff und kaut an einem gefangenen Fisch.",\
"Das Schiff faehrt gefaehrlich nahe an einem grossen Strudel vorbei.",\
"Einige abgebrochene Zweige schwimmen am Schiff vorbei.",\
"Das Schiff beginnt aus unerklaerlichen Gruenden ploetzlich zu schaukeln.",\
"Die Segel blaehen sich im staerker werdenden Wind.",\
"Von Norden blaest ein kuehler Wind.",\
"Von Sueden blaest ein warmer Wind. ",\
"Am Horizont glaubst Du, eine kleine Insel zu sehen.",\
"Ein gewaltiger Drache fliegt in grosser Entfernung ueber das Meer.",\
"Ein gefluegeltes Pferd fliegt samt Reiter ueber das Schiff.",\
"Das Schaukeln des Schiffes wird Deinem Magen zuviel; Du musst Dich "\
  "uebergeben.",\
"Ein starker Wind erfasst das Schiff und treibt es vor sich her.",\
"Das aufgewuehlte Meer laesst das Schiff noch mehr schaukeln.",\
"Ein kleiner Wal schwimmt vor dem Schiff hin und her.",\
"Ein Krake versucht vergeblich, das Schiff mit seinen Tentakeln zu "\
  "erwischen.",\
"Ein grosser Raubfisch jagt eine grosse Gruppe kleinerer Fische am Schiff "\
  "vorbei.",\
"Ein abgebrochener Schiffsmast treibt am Schiff vorbei.",\
"Am Horizont tauchen die Segel eines unbekannten Schiffes auf.",\
"Jede Menge Algen schwimmen auf der Meeresoberflaeche.",\
"Ein messingfarbener Wasserdrache taucht neben dem Schiff auf und sofort "\
  "wieder unter.",\
"Die Matrosen bitten Pestur um eine gute Fahrt.",\
"Du glaubst, eine Meerjungfrau neben dem Schiff gesehen zu haben.",\
"Ein grosser Schatten gleitet unter dem Schiff vorbei."})


#define EREIGNIS_SUED ({ \
"Ein Schwarm fliegender Fische fliegt am Schiff vorbei.",\
"Eine Kokosnuss treibt am Schiff vorbei.",\
"Der heisse Wind bringt Dich zum Schwitzen.",\
"Du suchst im Schatten der Segel Schutz vor der sengenden Sonne.",\
"Eine abgebrochene Palme treibt am Schiff vorueber.",\
"Viele Palmblaetter schwimmen neben dem Schiff im Wasser.",\
"Das Schiff segelt an einer winzigen, palmenbestandenen Insel vorbei.",\
"Das tiefblaue Meer glitzert im hellen Sonnenlicht.",\
"Du wischst Dir den Schweiss von der Stirn.",\
"Eine handtellergrosse, leuchtendrote Bluete schwimmt am Schiff vorbei.",\
"Ein frischer Wind bringt Dir etwas Kuehlung.",\
"Das Tangfeld vor dem Schiff leuchtet tiefgruen im grellen Licht.",\
"Die gluehende Hitze treibt Dir den Schweiss aus den Poren.",\
"Eine Flaute macht die Hitze unertraeglich. Du sehnst Dich sofort nach "\
  "etwas Wind.",\
"Die Sonne glueht vom Himmel und bringt Dich zum Schwitzen."})


#define EREIGNIS_NORD ({ \
"Eine Robbe schwimmt neugierig auf das Schiff zu.",\
"Eine kleine Eisscholle treibt am Schiff vorueber.",\
"Ein kleine Gruppe Pinguine schwimmt am Schiff vorbei.",\
"Das Schiff segelt in angemessener Entfernung an einem Eisberg vorbei.",\
"Ein gewaltiger Eisberg treibt am Schiff vorbei.",\
"Ein eisiger Wind laesst Deine Glieder schlottern.",\
"Das Schiff segelt an einigen Eisschollen vorbei.",\
"Du zitterst vor Kaelte.",\
"Das Schiff segelt langsam durch das eisige Meer.",\
"Ein Eisbaer treibt, auf einer Eisscholle sitzend, am Schiff vorbei.",\
"Ein Pinguin taucht neben dem Schiff auf.",\
"Eine Herde Seehunde schwimmt am Schiff vorbei.",\
"Vereinzelte Schneeflocken fallen vom Himmel.",\
"Ein eisiger Hauch friert Dein Gesicht ein.",\
"Ein riesiger, weisser Wal taucht kurz neben dem Schiff auf.",\
"Das Meer ist voll von kleinen Eisbrocken."})

void SeeEreignis()                           
{
  tell_room(this_object(),break_string(
      EREIGNIS[random(sizeof(EREIGNIS))],78) );
}

void SeeEreignisNord()                           
{
  if( random(3) )
    tell_room(this_object(),break_string(
      EREIGNIS_NORD[random(sizeof(EREIGNIS_NORD))],78) );
  else
    SeeEreignis();
}

void SeeEreignisSued()                           
{
  if( random(3) )
    tell_room(this_object(),break_string(
      EREIGNIS_SUED[random(sizeof(EREIGNIS_SUED))],78) );
  else
    SeeEreignis();
}

