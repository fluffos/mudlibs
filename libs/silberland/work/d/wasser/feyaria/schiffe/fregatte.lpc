// fregatte.c
// Die Fregatte faehrt von Tiajra zur Wueste, mit Stopp auf der Amazoneninsel
// 2005-01-30  Feyaria@SilberLand

#include "../def.h"

inherit SCHIFFE "ship";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf der Fregatte" );
  SetProp(P_INT_LONG,
    "Die Fregatte ist ein maechtiges Schiff mit drei Masten und vielen "
    "grossen Segeln. Sie wird Dich sicher und schnell zu Deinem Ziel bringen.");
  SetProp(P_SHORT, "Die Fregatte" );
  SetProp(P_LONG, QueryProp(P_INT_LONG) );
  SetProp(P_NAME, "Fregatte" );
  AddId( ({"schiff", "fregatte" }) );
  SetProp(P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN:TT_OTHER]) );  

  AddDetail( ({"schiff", "fregatte"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden", "deck"}),
      "Der Boden, auf einem Schiff Deck genannt, besteht aus soliden "
      "Holzplanken.");
  AddDetail( ({"planken", "holzplanken"}),
    "Die Planken sind aus solidem Steineichenholz gefertigt.");
  AddDetail( ({"holz", "eichenholz", "steineichenholz"}), 
    "Steineichenholz ist sehr hart und widerstandsfaehig und wird darum "
    "sehr gerne fuer den Schiffbau verwendet.") ;
  AddDetail( ({"schiffbau", "meisterleistung"}),
    "Diese Fregatte ist eine Meisterleistung des silberlaendischen "
    "Schiffbaus.");
  AddDetail( ({"steineiche", "steineichen", "eiche", "eichen", 
               "baum", "baeume" }), 
    "Von den Steineichen siehst Du nur das Holz. Oder hast Du schon mal "
    "einen lebenden Baum auf einem Schiff gesehen?") ;
  AddDetail( ({"mast", "masten"}), 
    "Die Fregatte hat drei Masten. Ganz vorne den Fockmast, in der Mitte "
    "den Haupt- oder Grossmast und achtern den Kreuzmast.");
  AddDetail( ({"mitte"}),
    "In der Mitte des Schiffes steht der Grossmast. Warum nennt man ihn dann "
    "nicht Mittenmast?");
  AddDetail( ({"mittenmast", "seemannsbegriffe", "seemansbegriff"}),
    "Du wirst die Seemannsbegriffe nie verstehen.");  
  AddDetail( ({"hoehe", "hoehen"}),
    "Der Hauptmast erstreckt sich in schwindelerregene Hoehen.");
  AddDetail( ({"hauptmast", "grossmast", "haupt"}) , 
    "Der Grossmast ist mit ca. 12 Metern Hoehe der groesste Mast. Er ist "
    "mit drei Rahsegeln getakelt. Seitlich sind breite Wanten angebracht, "
    "um bis in den Mastkorb zu kommen.") ;
  AddDetail( ({"meter", "laengenmass"}),
    "Meter ist ein Laengenmass.");  
  AddDetail( ({"fockmast", "fock", "naehe"}), 
    "Der Fockmast befindet in der Naehe des Bugs. Er hat zwei Rahsegel und "
    "ein Stagsegel, das bis zum Bugspriet hinunterreicht.") ;
  AddDetail( "kreuzmast", 
    "Der Kreuzmast ist der achterlichste Mast. Er hat zwei Rahsegel und ein "
    "Besansegel.") ;
  AddDetail( ({"segel", "segeln"}), 
    "Die Fregatte fuehrt verschiedene Segel. Alle Masten sind mit "
    "Rahsegeln getakelt, vorne gibt es noch ein Stagsegel und achtern ein "
    "Besansegel.") ;
  AddDetail( "rahsegel", 
    "Rahsegel sind viereckige Segel, die quer zur Schiffsachse angebracht "
    "sind. Sie sind an einer langen Stange, 'Rah' genannt, befestigt. "
    "Davon stammt auch ihr Name. Grosse Schiffe haben meist mehrere "
    "Rahsegel uebereinander. Das unterste Segel wird meist nach den Mast "
    "benannt, darueber kommt dann das Marssegel und dann das Brahmsegel.");
  AddDetail( ({"schiffsachse", "fahrtrichtung"}), 
    "Die Schiffsachse liegt genau in Fahrtrichtung, ist doch logisch!");
  AddDetail( ({"rah", "rahen"}), 
    "An den Rahen sind die Rahsegel befestigt.") ;
  AddDetail( "hauptsegel", 
    "Das Hauptsegel ist das unterste und groesste Segel auf einem Mast und "
    "traegt meist den Namen des Mastes.") ;
  AddSpecialDetail( ({"name", "namen"}), "namen");
  AddDetail( "marssegel", 
    "Alle drei Masten fuehren ueber dem Hauptsegel noch ein Marssegel.") ;
  AddDetail( "brahmsegel",
    "Nur der Grossmast fuehrt ein Brahmsegel ueber dem Marssegel. Die "
    "anderen beiden Masten sind dazu zu klein.") ;
  AddDetail( "focksegel", 
    "Das Focksegel ist das untere Rahsegel des Fockmastes.") ;
  AddDetail( "fockrah", 
    "An der Fockrah ist das Focksegel befestigt.") ;
  AddDetail( "vormarssegel",
    "Das Vormarssegel ist das zweite Segel des Fockmastes. Es befindet "
    "sich hoeher oben am Mast und ist dementsprechend kleiner.") ;
  AddDetail( "vormarsrah", 
    "An der Vormarsrah ist das Vormarssegel befestigt.");
 AddDetail( ({"vorbrahmsegel", "vorbrahmrah"}), 
    "Der Fockmast ist zu klein, um ein Brahmsegel zu fuehren."); 
  AddDetail( ({"fockmarssegel", "fockmarsrah", "fockbrahmsegel", 
               "fockbrahmrah"}), 
    "Die oberen Segel am Fockmast werden als Vor- -segel bezeichnet.");
  AddDetail( ({"stagsegel", "stagfock"}), 
    "Das dreieckige Stagsegel ist am Fockstag befestigt.");
  AddDetail( ({"fockstag", "stag"}),
    "Vom Top des Fockmastes fuehrt ein Tau bis zum Bugspriet, um den Mast "
    "zu stuetzen. Daran ist das Stagsegel befestigt.") ;
  AddDetail( ({"top", "spitze"}), 
    "Als Top bezeichnet man die Spitze eines Mastes.") ;
  AddDetail( "focktop", 
    "Das ist die Spitze des Fockmastes.") ;
  AddDetail( "grosstop", 
    "Das ist die Spitze des Grossmastes. Dort flattert die Schiffsflagge im "
    "Wind.") ;
  AddDetail( "kreuztop", 
    "Das ist die Spitze des Kreuzmastes. Sie ist niedriger als die der "
    "anderen Masten.") ;
  AddDetail( ({"grosssegel", "grossegel"}), 
    "Das Grossegel ist das unterste Segel des Grossmastes und somit das "
    "groesste Segel der Fregatte.") ;
  AddDetail( "grossrah", 
    "An der Grossrah ist das Grosssegel befestigt. Diese Rah ist breiter "
    "als die Fregatte, um die Segelflaeche noch groesser zu machen.") ;
  AddDetail( "grossmarssegel",
    "Das Grossmarssegel ist das mittlere Segel des Grossmastes. Weiter oben "
    "befindet sich nur mehr das Kraehennest, wie der Ausguck genannt wird, "
    "und darueber das Grossbrahmsegel.") ;
  AddDetail( "grossmarsrah", 
    "An der Grossmarsrah ist das Grossmarssegel befestigt.") ;
  AddDetail( "grossbrahmsegel", 
    "Das Grossbrahmsegel befindet sich ganz oben am Grossmast. Von unten "
    "schaut es ganz klein aus. Oberhalb dieses Segels weht die "
    "Schiffsflagge im Wind.");
  AddDetail( "grossbrahmrah",
    "An der Grossbrahmrah ist das Grossbrahmsegel befestigt. Diese Rah ist "
    "so hoch oben, dass Dir schwindlig wird bei dem Gedanken, dass die "
    "Matrosen dort oben herumturnen muessen, wenn sie die Segel hissen oder "
    "reffen muessen. Dir faellt ein, dass Piraten immer an der hoechsten "
    "Rah aufgehaengt werden, auf diesem Schiff waere das dann dort oben.");
  AddDetail( ({"flagge", "schiffsflagge"}), 
    "Auf der Spitze des Grossmastes flattert die Schiffsflagge im Wind. Sie "
    "zeigt einen goldenen, von zwei Schlangen umwundenen Speer auf hellblauem "
    "Grund.") ;
  AddDetail( ({"schlangen", "speer", "grund"}), 
    "Die Schiffsflagge zeigt einen goldenen, von zwei Schlangen umwundenen "
    "Speer auf hellblauem Grund.") ;
  AddDetail( "kreuzsegel", 
    "Das Kreuzsegel ist das untere Rahsegel des Kreuzmastes. Es ist nicht "
    "so gross, wie das Focksegel oder gar das Grossegel, weil sich ja "
    "unter dem Kreuzmast der Aufbau der Achtertrutz befindet.");
  AddDetail( "kreuzrah", 
    "An der Kreuzrah ist das Kreuzsegel befestigt.");
  AddDetail( ({"kreuzmarssegel", "gegensatz"}),
    "Das Kreuzmarssegel ist das zweite Segel am Kreuzmast. Ganz im "
    "Gegensatz zu den anderen Masten ist es fast groesser als das "
    "Kreuzsegel.") ;
  AddDetail( "kreuzmarsrah", 
    "An der Kreuzmarsrah ist das Kreuzmarssegel befestigt. ");
  AddDetail( ({"kreuzbrahmsegel", "kreuzbrahmrah"}), 
    "Der Kreuzmast ist zu klein, um ein Brahmsegel zu fuehren.");
  AddDetail( ({"besan", "besansegel"}), 
    "Das Besansegel ist ein rechteckiges Segel, welches laengs der "
    "Schiffsachse angebracht ist, um auch bei seitlichem Wind noch Fahrt "
    "zu machen. Es ist mittels der Besangaffel am Kreuzmast befestigt.") ;
  AddDetail( ({"fahrt"}),
    "Die Fregatte mit ihren vielen Segeln macht gute Fahrt. "
    "Du hoffst, dass Du bald Dein Ziel erreichst.");
  AddDetail( ({"ziel"}),
    "Dein Ziel ist entweder Tijara, die Wueste oder Edynia, die Insel der "
    "Amazonen.");
  AddDetail( ({"insel", "edynia", "amazonen"}),
    "Die Fregatte segelt nach Edynia, der Insel der Amazonen.");   
  AddDetail( ({"besangaffel", "rundholz"}), 
    "Die Besangaffel ist ein langes Rundholz aehnlich einer Rah, die das "
    "Besansegel traegt. Sie ist in Hoehe der Kreuzmarsrah am Kreuzmast "
    "befestigt.") ;
  AddDetail( "segelflaeche", 
    "Die vielen Segel haben zusammen eine grosse Segelflaeche und so bietet "
    "die Fregatte dem Wind eine grosse Angriffsflaeche, was wiederum zu "
    "einer grossen Geschwindigkeit fuehrt.");
  AddDetail( "geschwindigkeit", 
    "Die Geschindigkeit der Fregatte ist schwer abzuschaetzen, aber sie "
    "kann bei gutem Wind schon sehr schnell werden.");
  AddDetail( ({"bugspriet", "befestigung"}),
    "Der Bugspriet ist eine ueber den Bug nach vorne stehende Stange, die "
    "der Befestigung des Fockmastes dient. Ausserdem gibt er einem Schiff "
    "ein schnittiges Aussehen.");
  AddDetail( ({"aussehen"}),
    "Der lange Bugspriet gibt der Fregatte ein schnittiges Aussehen.");
  AddDetail( "wanten", 
    "Die Wanten sind seitliche Stuetztaue, die den Masten zusaetzliche "
    "Stabilitaet geben. Die Matrosen verwenden die Wanten, um auf die "
    "Masten hinaufzukommen. Fuer eine Landratte ist das aber eine "
    "schwere Kletterei.") ;
  AddDetail( ({"stabilitaet"}),
    "Die Wanten geben den Masten zusaetzliche Stabilitaet.");   
  AddDetail( ({"kletterei"}),
    "Auf einem schwankenden Schiff bis zur Spitze eines Mastes zu klettern "
    "ist sicher nicht so einfach.");
  AddDetail( "landratte", 
    "Als Landratte bezeichnen die Matrosen jemanden, der sich mit Schiffen "
    "nicht so gut auskennt, also zum Beispiel Dich.");
  AddSpecialDetail( ({"beispiel"}), "beispiel");  
  AddDetail( ({"tau", "taue", "stuetztaue", "stange","stangen","seile", "seil"}), 
    "Fuer die ganzen Taue, Seile, Stangen und Segel gibt es doch einen "
    "umfassenden Begriff. Wie hiess das noch mal?") ;
  AddDetail( ({"begriff"}),
    "Wenn Du Dich nur an den Begriff fuer die ganzen Taue, Seile, Stangen "
    "und Segel erinnern koenntest....");
  AddDetail( ({"takelage", "takelung"}), 
    "Die Gesamtheit von Segeln, Stangen und Tauen nennt man Takelage.");
  AddDetail( "gesamtheit", 
    "Na alles zusammen.") ;
  AddDetail( ({"kraehennest", "mastkorb", "ausguck"}), 
    "Im Kraehennest sitzt der Ausguck und sucht den Horizont nach fremden "
    "Schiffen und nach Land ab.") ;
  AddDetail( ({"land", "sicht"}),
    "Kein Land in Sicht, oder doch?");  
  AddDetail( "bug", 
    "Der Bug ist der vordere Teil des Schiffes und laeuft spitz zu, damit "
    "der Wasserwiderstand verringert wird. Noch weiter nach vorne steht der "
    "Bugspriet weg.");
  AddDetail( ({"wasserwiderstand"}),
    "Di Fregatte hat nur wenig Wasserwiderstand, daher ist sie sehr schnell.");  
  AddDetail( ({"teil", "teile"}),
    "Ein Teil des Ganzen.");  
  AddDetail( ({"ganzes", "ganze", "ganzen"}),
    "Das Ganze hat mehrere Teile");
  AddDetail( ({"wasserlinie", "linie"}),
    "Das ist die Linie am Rumpf, an der das Wasser endet.");
  AddDetail( ({"rumpf", "koerper", "unterteil"}), 
    "Der Rumpf ist der Koerper des Schiffes (also der Unterteil ohne "
    "Masten).") ;
  AddDetail( "heck", 
    "Das Heck der Fregatte besteht hauptsaechlich aus der Achtertrutz.");
  AddDetail( "reling", 
    "Die Reling laeuft rund um das ganz Schiff (und kommt doch nie an) und "
    "verhindert, dass zufaellig ein Mann ueber Bord geht.");
  AddDetail( "bord",
    "'Bord' bedeutet sowas wie 'auf dem Schiff'.");
  AddDetail( "mann ueber bord",
    "Du willst schon fast 'MANN UEBER BORD' rufen, aber da gar niemand ins "
    "Wasser gefallen ist, laesst Du es bleiben.");
  AddDetail( "anker", 
    "Irgendwo muss dieses Schiff auch einen Anker haben. Sehen tust Du ihn "
    "aber nicht.") ;
  AddDetail( "steuerbord", 
    "Steuerbord ist die rechte Seite eines Schiffes, wenn man in "
    "Fahrtrichtung blickt."); 
  AddDetail( "backbord", 
    "Backbord ist die linke Seite eines Schiffes, wenn man in Fahrtrichtung "
    "blickt.");
  AddDetail( ({"zeit"}),
    "Ach wie schnell die Zeit vergeht.");
  AddDetail( ({"kabinen", "kabine", "platz"}),
    "Du ueberlegst kurz, ob Du nicht Deine Kabine aufsuchen solltest, aber da "
    "es hier an Deck noch so viele Sachen zu bewundern gibt, bleibst Du "
    "lieber hier.") ;
  AddDetail( "sachen", 
    "Sachen, Sachen, findest Du nicht, dass Du das nicht etwas genauer "
    "ausdruecken kannst?"); 
  AddDetail( ({"offiziere", "offizier", "aufsicht"}),
    "Die wenigen Offiziere an Deck haben viel Arbeit mit der Navigation "
    "und der Aufsicht ueber die Matrosen."); 
  AddDetail( ({"navigation", "kurs"}), 
    "Es ist ganz schoen schwierig, ein solches Schiff auf lange Zeit auf "
    "dem richtigen Kurs zu halten.") ;
  AddDetail( "mannschaft", 
    "Die Mannschaft der Fregatte besteht aus einige Offizieren und vielen "
    "Matrosen. Leider sind alle zu beschaeftigt, um sich naeher mit Dir zu "
    "beschaeftigen.");
  AddDetail( ({"matrosen", "matrose", "arbeit"}), 
    "Die Matrosen machen die grobe Arbeit an Deck. Sie bringen die Segel in "
    "die richtige Position und sorgen dafuer, dass alles sauber und in gutem "
    "Zustand ist.");
  AddDetail( ({"zustand"}),
    "Die Fregatte ist in sehr gutem Zustand.");  
  AddDetail( ({"position"}),
    "Wenn die Segel alle in der richtigen Position sind, macht die Fregatte "
    "sehr gute Fahrt.");
  AddDetail( ({"passagiere", "passagier"}), 
    "Du bist ein Passagier.");
  AddDetail( ({"trutz", "achtertrutz", "aufbau", "oberdeck"}) , 
    "Achtern befindet sich eine grosse Trutz, ein Aufbau auf dem Oberdeck, "
    "um mehr Platz fuer die Kabinen zu schaffen.") ;
  AddDetail( ({"wind", "brise"}), 
    "Es weht eine steife Brise. Mit solch einem Wind wird die Fregatte "
    "sicher schnell vorankommen.");
  AddDetail( "wellen", 
    "Die Wellen schlagen sanft gegen das Schiff.");
  AddDetail( "meer", 
    "Das Meer ist rund um die Fregatte herum.");
  AddDetail( "hafen", 
    "Wenn die Fregatte im Hafen ist, kannst Du sie wieder verlassen.");
  AddDetail( "kueste", 
    "Wenn irgendwo die Kueste zu sehen ist, wird die Fregatte wohl bald "
    "in einem Hafen anlegen.");
  AddDetail( "horizont", 
    "Bis zum Horizont siehst Du das Meer.");
  AddDetail( ({"ufer", "sichtweite"}),
    "Sobald das Ufer in Sichtweite kommt, ist die Fahrt der Fregatte "
    "bald vorbei."); 
  AddDetail( ({"tijara", "wueste"}),
    "Die Fregatte faehrt zwischen Tijara und der Wueste hinundher.");
  AddDetail( ({"himmel", "sonne", "wetter", "brise"}),
    "Vom Himmel brennt die Sonne herunter, es weht eine steife Brise; "
    "alles in allem also das ideale Wetter fuers Segeln.");

  AddSound( ({DEFAULT_SOUND, "meer", "wellen", "rauschen"}),
    "Du hoerst das Rauschen der Wellen.");
  AddSmell( ({DEFAULT_SMELL, "meer"}),
    "Es riecht stark nach Meer.");
 
  create_default_ship(9);

  AddRoute( TIJARA, 30, 5, "am Steg in Tijara",
         ({"tijara","dschungel"}), "nach Tiajra" );
  AddMsg( Name(WER,1)+" segelt nach Nordosten.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddFun( "SeeEreignisSued", 10);
  AddMsg( Name(WER,1)+" steuert eine Insel mit einer hohen Klippe an.\n",5);
  AddMsg( "Du bemerkst eine maechtige Burg hoch oben auf der Klippe.\n",5);

  AddRoute( EDYNIA, 20,10, "am Strand von Edynia", 
            ({"insel","amazoneninsel","amazonen","edynia"}), "nach Edynia" );

  AddMsg( Name(WER,1)+" segelt nach Nordosten.\n", 10 );
  AddFun( "SeeEreignisSued", 10);
  AddFun( "SeeEreignis", 10);
  AddMsg( Name(WER,1)+" steuert einen gruenen Fleck an der Wuestenkueste "
     "an.\n",5);

  AddRoute( WUESTESUED, 20,10, "am Steg suedlich von Quaul", 
            ({"wueste","heisse wueste","quaul","kraterrand"}), "nach Quaul" );
  
  AddMsg( Name(WER,1)+" segelt wieder nach Suedwest.\n",10);
  AddFun( "SeeEreignisSued", 10);
  AddFun( "SeeEreignis", 10);  
  AddMsg( Name(WER,1)+" steuert eine Insel mit einer hohen Klippe an.\n",5);
  AddMsg( "Du bemerkst eine maechtige Burg hoch oben auf der Klippe.\n",5);

  AddRoute( EDYNIA, 20,10, "am Strand von Edynia", 
            ({"insel","amazoneninsel","amazonen","edynia"}), "nach Edynia" );

  AddMsg( Name(WER,1)+" segelt weiter nach Seudwesten.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddFun( "SeeEreignisSued", 10);
  AddMsg( "Der Steg von Tijara kommt in Sichtweite.\n",5);
  Start();

}

string schatten()
{
  if( QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE] < 23 )
    return BS("Zum Glueck ist es nich so heiss, dass man unbedingt den "
              "Schatten braeuchte, aber warte nur, bis die Galeere weiter "
              "nach Sueden faehrt.");
  else
    return BS("Du bist froh, dass Du Dich bei dieser Hitze in den Schatten "
              "des Segels stellen kannst.");
}

string beispiel()
{
  return "Ohne Namen nennen zu wollen, "+CAP(getuid(TP))+" ist zum Beispiel "
    "eine Landratte.\n";
}

string namen()
{
  return TP->short();
}
