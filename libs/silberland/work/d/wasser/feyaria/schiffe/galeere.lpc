// galeere.c
// Die Galeere, die von Midas zum Leuchtturm am Suedkap faehrt
// 1998-07-31  Feyaria@SilberLand
// 2004-01-05  Malar@SL: Erweiterung um Ausguck und Beiboot, dient als 
//                       Transportmoeglichkeit nach +wasser/malar/vanataur

#include "../def.h"
#include <properties.h>

inherit SCHIFFE "ship";

#define AUSGUCK "/d/wasser/malar/vanataur/room/ausguck"
#define BOOT    "/d/wasser/malar/vanataur/room/hin"

string *boot = ({});

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf der Galeere" );
  SetProp(P_INT_LONG, BS(
    "Die Galeere ist ein langes, schmales Schiff, das auf beiden Seiten "
    "viele Ruder besitzt. Das kleine Rahsegel auf dem einzigen Mast in "
    "der Schiffsmitte spendet eher Schatten als zusaetzliche "
    "Geschwindigkeit. Wer die Ruder bedient, kann man nicht erkennen, da "
    "die Ruderer unter Deck sitzen.") );
  SetProp(P_SHORT, "Die Galeere" );
  SetProp(P_LONG, QueryProp(P_INT_LONG) );
  SetProp(P_NAME, "Galeere" );
  AddId( ({"schiff", "galeere" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_OTHER]) );  

  AddDetail( ({"schiff", "galeere"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"ruder", "ruderer", "seiten"}),
    "Die Galeere besitzt auf beiden Seiten viele Ruder. Wer die Ruder bedient, "
    "kann man nicht erkennen, da die Ruderer unter Deck sitzen.");
  AddDetail( ({"rahsegel", "segel"}),
    "Das kleine Rahsegel auf dem einzigen Mast in der Schiffsmitte spendet "
    "eher Schatten als zusaetzliche Geschwindigkeit.");
  AddDetail( ({"schiffsmitte", "mitte"}), 
    "In der Schiffsmitte befindet sich ein Mast mit einem kleinen Rahsegel.");
  AddSpecialDetail( ({"schatten"}), "schatten");
  AddDetail( ({"geschwindigkeit"}),    
    "Die Geschwindigkeit der Galeere kommt hauptsaechlich von den Rudern. "
    "Das kleine Segel traegt nur sehr wenig dazu bei.");
  AddDetail( ({"boden", "planken", "planke", "holzplanken", "holzplanke"}),
    "Der Boden besteht aus frischgescheuerten und blankgeputzen Holzplanken.");
  AddDetail( ({"himmel", "sonne", "wolken", "wind", "wetter", "wolke"}),
    "Das Wetter ist heute sehr angenehm: Vom Himmel brennt die Sonne herunter "
    "und ein leichter Wind treibt ein paar Wolken vor sich her.");
  AddDetail( ({"wasser", "meer", "meerwasser", "wellen", "welle"}),
    "Das Meerwasser plaetschert in leichten Wellen gegen das Schiff.");
  AddDetail( ({"deck"}),
    "Unter Deck sitzen die Ruderer.");  

  AddDetail( ({"mast"}),
    "An dem einzigen Mast auf der Galeere ist das Rahsegel befestigt. "
    "An der Spitze kannst Du einen Ausguck erkennen.");
  AddDetail( ({"spitze"}),
    "An ihr befindet sich ein Ausguck!");
  AddDetail( ({"ausguck"}),
    "Er besteht aus einem Bastkorb, der an der Spitze des Mastes befestigt "
    "ist. Von dort oben hat man sicherlich eine wahnsinnige Aussicht!");
  AddDetail( ({"korb", "bastkorb"}),
    "Der Korb dient als Ausguck.");
  AddDetail( ({"aussicht"}),
    "Um ein mal von dort oben ueber das Meer zu blicken, muesstest Du "
    "schon den Mast hochklettern!");
  AddDetail( ({"backbord"}),
    "Das ist die linke Seite der Galeere.");
  AddDetail( ({"steuerbord", "seite"}),
    "Das ist rechte Seite der Galeere. Zwei Seile fallen Dir auf.");
  AddDetail( ({"seile"}),
    "Sie scheinen irgendetwas an der Galeere zu befestigen.. Vielleicht "
    "sollte man sich mal ueber die Reling beugen?");
  AddDetail( ({"reling"}),
    "Vielleicht sollte man sich einfach mal ueber die Reling beugen?");
  AddSpecialDetail( ({"boot", "beiboot"}), "boot");

  AddSound( ({DEFAULT_SOUND, "meer", "wellen", "rauschen", "geraeusch"}),
    "Du hoerst das Rauschen der Wellen. An einer bestimmten Stelle "
    "kann man das Geraeusch besonders stark vernehmen.");
  AddSound( ({"stelle", "richtung"}),
    "Lausch mal in Richtung Steuerbord!");
  AddSound( ({"steuerbord", "bord"}),
    "Es hoert sich so an, als ob manche hohen Wellen gegen ein Beiboot "
    "schlagen!?");
  AddSound( ({"beiboot"}),
    "Es scheinen wirklich hohe Wellen dagegen zu schlagen. Komischerweise "
    "siehst Du nirgends ein Beiboot. Vielleicht solltest Du mal nach "
    "Steuerbord schauen.");
  AddSmell( ({DEFAULT_SMELL, "meer"}),
    "Es riecht stark nach Meer.");
 
  create_default_ship(9);

  AddRoute( PIER_OST, 30, 5, "an der Pier beim Fischerdorf",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddMsg( Name(WER,1)+" segelt nach Suedosten.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddFun( "heiss", 10);
  AddMsg( "Die Ruderer unter Deck stoehnen unter der Hitze.\n",10);
  AddFun( "SeeEreignisSued", 10);
  AddMsg( Name(WER,1)+" steuert einen gruenen Fleck an der Wuestenkueste "
     "an.\n",5);

  AddRoute( WUESTESUED, 20,10, "am Steg suedlich von Quaul", 
            ({"wueste","heisse wueste","quaul","kraterrand"}), "nach Quaul" );
  
  AddMsg( Name(WER,1)+" faehrt wieder nach Nordwest.\n",10);
  AddFun( "SeeEreignisSued", 10);
  AddFun( "warm", 10);
  AddMsg( "Die Ruderer unter dem Deck legen sich noch mal voll ins Zeug.\n",10);
  AddFun( "SeeEreignis", 10);  
  AddMsg( "Der Steg von Midas kommt in Sichtweite.\n",5);
  Start();

  //Ausguck:
  AddCmd(({"kletter", "klettere"}), "cmd_mast");
  //Man beugt sich ueber die Reling --> Beiboot
  AddCmd("beug|beuge&ueber&reling", "cmd_beugen",
         "Willst Du Dich etwas ueber die Reling beugen?|"
         "Vielleicht sollte man sich mal ueber die Reling beugen..");
  //Man laesst das Boot zu Wasser und schippert nach Vanataur
  //(Sequenz im naechsten Raum..)
  AddCmd("lass|lasse&boot|beiboot&zu&wasser", "cmd_boot",
         "Was willst Du zu Wasser lassen?|"
         "Willst Du das Boot zu Wasser lassen?|"
         "Du willst das Boot zu Wasser lassen!?");
}

string schatten()
{
  if( QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE] < 23 )
    return BS("Zum Glueck ist es nicht so heiss, dass man unbedingt den "
              "Schatten braeuchte, aber warte nur, bis die Galeere weiter "
              "nach Sueden faehrt.");
  else
    return BS("Du bist froh, dass Du Dich bei dieser Hitze in den Schatten "
              "des Segels stellen kannst.");
}

int cmd_mast(string str)
{
  if(ENV(TP) != TO)
    return 0;
  notify_fail("Woran willst Du denn hochklettern?\n");
  if( !str || member(({"mast rauf", "auf mast", "mast hinauf", "mast hoch",
          "mast", "rauf", "hoch", "hinauf", "an mast hoch", "an mast rauf",
          "an mast hinauf"}), str) == -1)
    return 0;
  write(BS(
    "Du kletterst ohne Probleme an dem Mast hoch und ziehst Dich ueber "
    "den Rand des Bastkorbes und bist endlich oben und kannst nun "
    "die wahnsinnige Aussicht geniessen!"));
  TP->do_exhaust(200+random(20),1);
  TP->move(AUSGUCK,M_GO,
           "den Mast und befindet sich nun im Ausguck",
           "erklettert",
           "kommt raufgeklettert");
  return 1;
}   

int cmd_beugen(string str)
{  
  if(ENV(TP) != TO)
    return 0;
  write(BS(
    "Du entdeckst tatsaechlich ein Beiboot! Nur haengt das Boot "
    "seltsamerweise ziemlich tief, so dass die Wellen manchmal "
    "dagegen schwappen und ein lustiges Geraeusch dabei erzeugen. "
    "Wenn man jetzt abenteuerlustig waere, koennte man sicherlich "
    "ganz einfach das Boot zu Wasser lassen und damit unbekannte "
    "Gebiete erforschen fahren!"));
  if(member(boot, getuid(TP)) == -1)
    boot += ({getuid(TP)});
  return 1;
}  

string det_boot()
{
  if(member(boot, getuid(TP)) == -1)
    return "Die Galeere ist eher ein Schiff als ein Boot.\n";
  else
    return "Das Beibot haengt an der Steuerbordseite.\n";
}

int cmd_boot(string str)
{
  if(ENV(TP) != TO)
    return 0;
  write(BS(
    "Du laesst das Beiboot gleichmaessig mit den beiden Seilen hinunter "
    "und es klatscht auf die Meeresoberflaeche. Die beiden Seile laesst "
    "Du in das Boot fallen und springst hinterher. Im Boot findest Du "
    "direkt zwei Ruder, mit denen Du Dich von der Galeere abstoesst "
    "und so auf das offene Meer hinaustreibst..."));
  TP->move(BOOT,M_GO,
           "ein Beiboot und faehrt damit auf das Meer hinaus",
           "chartert",
           "kommt hereingehuepft, so dass das Boot herumwackelt");
  return 1;
}

