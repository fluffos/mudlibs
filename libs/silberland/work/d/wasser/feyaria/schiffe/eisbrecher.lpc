//Es war einmal:
// /d/dschungel/feyaria/schiff.c
// Schablone fuer Schiffe
// 27-10-96  Feyaria@SilberLand
//und wird bald ein Eisbrecher (lam)

#include "../def.h"

inherit SCHIFFE "ship";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Eisbrecher" );
  SetProp(P_SHORT, "Ein Eisbrecher" );
  SetProp(P_LONG, BS(
    "Du siehst einen riesigen Eisbrecher. Er wird wohl nach Polar fahren.") );
  SetProp( P_NAME, "Eisbrecher" );
  AddId( ({ "schiff", "eisbrecher", "brecher" }) );
  SetProp(P_GENDER, MALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_OTHER]) );
  
  SetProp(P_INT_LONG, BS(
    "Du befindest Dich auf einem riesigen Eisbrecher. Es ist wohl "+
    "kein Schiff der neusten Generation mehr, doch tapfer leistet es "+
    "noch seine Dienste und bringt seine Fahrgaeste fast immer heil an "+
    "ihr Ziel. ") );
 
  AddDetail("eisbrecher",
    "Er ist zwar alt, doch fahren tut er immer noch.");
  AddDetail("schiff",
    "Es handelt sich hierbei um ein Schiff der Eisbrecherklasse.");
  AddDetail( ({"dienste" }),
    "Fahrgaeste befoerdern, was fuer ein aufregender Dienst.");
  AddDetail( "fahrgaeste",
    "Du bist doch auch einer von ihnen.");
  AddDetail( "ziel",
    "Hobbingen oder Smoersky, das ist hier die Frage."); 
  AddDetail("generation",
    "Alt, aelter, am aeltesten. Es ist eindeutig am aeltesten.");  
  AddDetail("boden",
    "Der Boden besteht aus Holz.");
  AddDetail("holz",
    "Naja, recht sauber ist es ja nicht gerade, aber solange dich der "+
    "Eisbrecher an dein Ziel bringt, bist Du eh zufrieden.");
  AddDetail( ({"wand","waende"}),
    "Sowas siehst Du hier nicht. Oder doch?");
  AddDetail("himmel",
    "Blauer Himmel, was will man mehr.");
  AddDetail("himmel",
    "Kein einziges Woelkchen zu sehen.");
  AddDetail( ({"wolke","woelkchen"}),
    "Ja, wenn doch keine da sind, kann man sie auch net sehen.");
  AddDetail( ({"dienst"}),
    "Man versucht Dich von einem Hafen zu einem andern Hafen zu bringen. "+
    "Das haben Schiffe so an sich.");
  AddDetail("hafen",
    "Ein Ort an dem Schiffe anlegen.");
  AddDetail("ort",
    "Welchen meinst Du jetzt?");
  AddDetail("eisbrecherklasse",
    "Das sind grosse Schiffe, findest Du nicht?");
  AddDetail(({"moewen", "seemoewen", "moewe", "seemoewe"}),
    "Das sind Voegel, die vor allem das Meer lieben.");
  AddDetail(({"meer", "see"}), "Die See sieht nass aus.");

  create_default_ship(7);
  
  AddRoute( HOBBITS, 30, 10, "am Steg von Derlim",
         ({"derlim","hobbitdorf","hobbingen"}), "nach Derlim" );
  AddMsg( "Der Eisbrecher segelt in Richtung Polar.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Eisbrecher segelt nach Nordwesten.\n", 10 ); 
  AddFun( "SeeEreignis", 10);
  AddFun( "kalt", 10 ); 
  AddFun( "SeeEreignisNord", 10);
  AddMsg( "Starke Stuerme machen das Vorwaertskommen schwer.\n", 10 ); 
  AddFun( "SeeEreignisNord", 10);
  AddMsg( "Der Eisbrecher naehert sich einem vereisten Steg.\n", 10 );
  AddMsg( "Der Steg ist nun greifbar nahe.\n", 5 );
  AddRoute( POLAR, 30, 10, "am Steg von Smoersky",
         ({"smoersky","polar"}), "nach Smoersky" );
  AddMsg( "Der Eisbrecher segelt in Richtung Hobbitdorf.\n", 10 );
  AddFun( "SeeEreignisNord", 10);
  AddMsg( "Die See ist rauh und stuermisch.\n", 10 );
  AddFun( "SeeEreignisNord", 10);
  AddFun( "warm", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Eisbrecher segelt nach Suedosten.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Eisbrecher laeuft in eine breite Bucht ein.\n", 10 );
  AddMsg( "Der Eisbrecher naehert sich dem Hobbitdorf.\n", 5 );
 	
  Start();
}

