// kuestensegler.c
// Der Kuestensegler, der das ganze SilberLand umrundet
// 1998-07-30  Feyaria@SilberLand

#include "../def.h"

inherit SCHIFFE "ship";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Kuestensegler" );
  SetProp( P_INT_LONG, BS(
    "Der Kuestensegler ist sehr schnelles Schiff, ideal dafuer geeignet, um "
    "an der Kueste entlang zu segeln. Der vordere Mast besitzt zwei grosse "
    "Rahsegel, der hintere dagegen nur ein Schratsegel, damit das Schiff "
    "wendiger wird und den vielen Riffen in Kuestennaehe ausweichen kann."));
  SetProp( P_SHORT, "Ein Kuestensegler" );
  SetProp( P_LONG, BS(    
    "Der Kuestensegler ist sehr schnelles Schiff, ideal dafuer geeignet, um "
    "an der Kueste entlang zu segeln. Der vordere Mast besitzt zwei grosse "
    "Rahsegel, der hintere dagegen nur ein Schratsegel, damit das Schiff "
    "wendiger wird und den vielen Riffen in Kuestennaehe ausweichen kann."));
  SetProp( P_NAME, "Kuestensegler" );
  AddId( ({ "schiff", "kuestensegler", "segler" }) );
  SetProp( P_GENDER, MALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_OTHER]) );

  AddDetail( ({"schiff", "kuestensegler", "segelschiff", "segler"}),
    "Der Kuestensegler ist sehr schnelles Schiff, ideal dafuer geeignet, um "
    "an der Kueste entlang zu segeln. Der vordere Mast besitzt zwei grosse "
    "Rahsegel, der hintere dagegen nur ein Schratsegel.");
  AddDetail( ({"mast", "masten", "segel", "schratsegel", "rahsegel"}),
    "Der vordere Mast besitzt zwei grosse Rahsegel, der hintere dagegen nur "
    "ein Schratsegel, damit das Schiff wendiger wird und den vielen Riffen "
    "in Kuestennaehe ausweichen kann.");
  AddDetail( ({"boden", "planken", "planke", "holzplanken", "holzplanke"}),
    "Der Boden besteht aus frischgescheuerten und blankgeputzen Holzplanken.");
  AddDetail( ({"himmel", "sonne", "wolken", "wind", "wetter", "wolke"}),
    "Das Wetter ist heute sehr angenehm: Vom Himmel brennt die Sonne herunter "
    "und ein leichter Wind treibt ein paar Wolken vor sich her.");
  AddDetail( ({"wasser", "meer", "meerwasser", "wellen", "welle"}),
    "Das Meerwasser plaetschert in leichten Wellen gegen das Schiff.");

  AddSound( ({DEFAULT_SOUND, "meer", "wellen", "rauschen"}),
    "Du hoerst das Rauschen der Wellen.");
  AddSmell( ({DEFAULT_SMELL, "meer"}),
    "Es riecht stark nach Meer.");
 
  create_default_ship(5);

  AddRoute( PIER_WEST, 30, 10, "an der Pier von Midas",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddMsg( "Der Kuestensegler startet seine Fahrt nach Westen.\n", 4 );
  AddMsg( "Die felsigen Klippen werden immer hoeher und steiler.\n",6);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler segelt nach Norden um das Westkap herum.\n", 5 );
  AddMsg( "Der Kuestensegler legt am Leuchtturm an.\n",5);
  AddMsg( "Der Kuestensegler legt ab.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler segelt nach Osten an einer Huegellandschaft "
          "entlang.\n", 10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler laeuft in eine breite Bucht ein.\n",10);
  AddRoute( HOBBITS, 20,10, "am Steg von Derlim",
         ({"derlim","hobbitdorf","hobbingen"}), "nach Derlim" );
  AddMsg( "Der Kuestensegler faehrt mit gutem Wind nach Norden.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "An der Kueste kann man den Kristallwald erblicken.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler faehrt an einer flachen, kargen Landschaft "
          "vorbei.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler nimmt nun Kurs auf eine kleine Insel etwas "
      "weiter draussen im Meer.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler naehert sich der kleinen Insel.\n",10);
  AddRoute( HYPROS, 20,10, "an einem Steg am Hafen von Hypros",
         ({"hypros","hafen","hafen von hypros"}), "nach Hypros" );
  AddMsg( "Der Kuestensegler laeuft aus dem Hafen aus und naehert sich "
      "wieder dem Festland.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "An der Kueste tuermen sich gewaltige Klippen nach Norden auf.\n",10),  
  AddMsg( "Der Kuestensegler erreicht das sturmumtoste Nordkap.\n",10);  
  AddMsg( "Nur mit knapper Muehe gelingt die Ueberquerung des Kaps der "
          "Stuerme.\n", 10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler legt kurz an einem Steg in einer Bucht an.\n",5);  
  AddMsg( "Der Kuestensegler legt ab.\n",5);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Waelder und Steppen wechseln sich auf der Fahrt nach Osten an "
          "der Kueste ab.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( BS("Der Kuestensegler steuert auf eine grosse Bucht zu. Die Bucht "
        "ist halbrund umgeben von riesigen Felswaenden. Die Klippen "
        "gehen fast hundert Meter in die Hoehe.\n"), 10 );
  AddMsg( BS("Als der Kuestensegler in die Bucht von Khorinis einlaeuft, "
        "bemerkst Du einen grossen Wachturm oben auf der Klippe.\n")
      , 10 );
  AddMsg( BS("Die Faehre naehert sich dem Steg.\n"), 5 );
  AddRoute( TETHYR, 20, 10, 
      "Khorinis", ({"khorinis", "tethyr", "tethyrtal"}),
      "nach Khorinis" );
  AddMsg( BS("Der Kuestensegler segelt aus der Bucht hinaus und der frische "
        "Wind treibt ihn schnell nach Osten weiter."), 10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "An der Kueste tuermt sich ein gewaltiges Gebirge auf.\n",10);
  AddMsg( "Der Kuestensegler haelt kurz an einem Steg in den Trollbergen.\n",5);
  AddMsg( "Der Kuestensegler legt ab.\n",5);
  AddMsg( "Einige Trolle bewerfen den Kuestensegler vom Ufer aus mit "
          "Felsenbrocken.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler segelt durch ein Nebelfeld.\n",10);  
  AddMsg( "Der Kuestensegler legt am Leuchtturm des Ostkaps an.\n",5);
  AddMsg( "Der Kuestensegler legt wieder ab.\n",5);
  AddMsg( "Der Kuestensegler verlaesst die Nebelzone.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "An einer sumpfigen Kueste segelt das Schiff nach Suedosten.\n",10);
  AddFun( "SeeEreignis", 10); 
  AddMsg( "Mitten im Sumpfland sieht man einige grosse Huegel.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler faehrt in eine breite Bucht hinein.\n",10);
  AddMsg( "Ein gewaltiger Strom hat hier sein Muendungsdelta.\n",10);
  AddMsg( "An der westlichen Kueste glitzert eine weisse "
          "Wuestenlandschaft.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler faehrt an einer bewaldeten Insel vorbei.\n",10);
  AddMsg( "Eine Wuestenlandschaft begleitet den Kuestensegler auf der Fahrt "
          "nach Sueden.\n",10);
  AddFun( "SeeEreignisSued", 10);
  AddFun( "heiss",10);
  AddFun( "SeeEreignisSued", 10);
  AddRoute( WUESTESUED, 20,10, "am Steg suedlich von Quaul", 
            ({"wueste","heisse wueste","quaul","kraterrand"}), "nach Quaul" );
  AddFun( "SeeEreignisSued", 10);
  AddMsg( "Der Kuestensegler faehrt wieder nach Nordwest.\n",10);
  AddMsg( "Noch immer begleitet die unendliche Wueste das Schiff.\n",10);
  AddFun( "SeeEreignis", 10);
  AddFun( "warm", 10);
  AddMsg( "Das Schiff segelt an einer Steppenlandschaft vorbei.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Kuestensegler faehrt an einer Lagune vorbei.\n",10);
  AddMsg( "An der Kueste kann man das Piratendorf Knarkh erkennen.\n",10);
  AddFun( "SeeEreignis", 10);  
  AddMsg( "Der Steg von Midas kommt in Sichtweite.\n",10);
  Start();
}

