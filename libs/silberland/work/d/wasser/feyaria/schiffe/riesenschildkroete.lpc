// Riesenschildkroete, die zwischen den Inseln pendelt
// 2005-01-30  Feyaria@SilberLand

#include "../def.h"

inherit SCHIFFE "ship";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Ruecken einer Riesenschildkroete" );
  SetProp( P_INT_LONG, 
    "Du sitzt auf dem Ruecken einer Riesenschildkroete.");
  SetProp( P_SHORT, "Eine Riesenschildkroete" );
  SetProp( P_LONG, 
    "Eine Riesenschildkroete.");
  SetProp( P_NAME, "Riesenschildkroete" );
  AddId( ({ "schildkroete", "riesenschildkroete" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:26, ENV_TERRAIN:TT_OTHER]) );
  
  AddSound( ({DEFAULT_SOUND, "meer", "wellen", "rauschen"}),
    "Du hoerst das Rauschen der Wellen.");
  AddSmell( ({DEFAULT_SMELL, "meer"}),
    "Es riecht stark nach Meer.");
 
  create_default_ship(3);

  AddRoute( PIER_SUED, 30, 5, "an der Pier beim Fischerdorf",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddFun( "random_route_midas", 15);
// 2: Midas -> Tijara
  AddMsg( " segelt langsam nach Sueden.\n", 15 );
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt in die tropische Zone.\n", 10 );
  AddFun( "heiss",10);
  AddFun( "SeeEreignisSued", 10);
  AddMsg( "Das Handelsschiff segelt langsam nach Sueden.\n", 15);
  AddFun( "SeeEreignisSued", 15);
  AddFun( "SeeEreignisSued", 15);
  AddMsg( "Das Handelsschiff naehert sich der Kueste.\n", 5 );
  AddMsg( "Zwischen der dichten Vegetation am Ufer kommt ein kleiner "
          "Hafen in Sichtweite.\n", 5 );
  AddRoute( TIJARA, 30, 5, "am Hafen von Tijara",
         ({"dschungel","tijara"}), "nach Tijara" );
  AddFun( "random_route_tijara", 15 );
// 14: Tijara -> Midas
  AddMsg( "Das Handelsschiff segelt langsam nach Norden.\n", 15 );
  AddFun( "SeeEreignisSued", 15);
  AddMsg( "Das Handelsschiff segelt in die gemaessigte Zone.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddFun( "warm", 10 );
  AddMsg( "Das Handelsschiff segelt langsam nach Norden.\n", 15);
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff naehert sich der Kueste.\n", 5 );
  AddMsg( "Am Ufer kommt ein kleiner Hafen in Sichtweite.\n", 5 );
  AddRoute( PIER_SUED, 30, 5, "an der Pier beim Fischerdorf",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddFun( "random_route_midas", 15);
// 25: Tijara -> Derlim
  AddMsg( "Das Handelsschiff segelt langsam nach Nordwesten.\n",10);
  AddFun( "SeeEreignisSued", 10);
  AddFun( "warm", 10 );
// 28: Midas -> Derlim
  AddMsg( "Das Handelsschiff segelt langsam nach Westen.\n", 15 );
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt nach Norden um das Westkap herum.\n", 15 );
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt langsam nach Osten.\n", 15);
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff naehert sich der Kueste.\n", 5 );
  AddMsg( "Zwischen den Huegeln kommt ein kleiner Steg in Sichtweite.\n", 5 );
  AddRoute( HOBBITS, 30, 5, "am Steg vom Derlim",
         ({"derlim","hobbitdorf","hobbingen"}), "nach Derlim" );
  AddFun( "random_route_hobbits", 15);
// 38: Derlim -> Midas
  AddMsg( "Das Handelsschiff segelt langsam nach Westen.\n", 15 );
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt nach Sueden um das Westkap herum.\n", 15 );
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt langsam nach Osten.\n", 15);
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff naehert sich der Kueste.\n", 5 );
  AddMsg( "Am Ufer kommt ein kleiner Hafen in Sichtweite.\n", 5 );
  AddRoute( PIER_SUED, 30, 5, "an der Pier beim Fischerdorf",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddFun( "random_route_midas", 15);
// 48: Hobbingen -> Tijara
  AddMsg( "Das Handelsschiff segelt langsam nach Westen.\n", 15 );
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt nach Sueden um das Westkap herum.\n", 15 );
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt in die tropische Zone.\n", 10 );
  AddFun( "SeeEreignisSued", 10);
  AddFun( "heiss", 10);
  AddMsg( "Das Handelsschiff segelt langsam nach Sueden.\n", 15);
  AddFun( "SeeEreignisSued", 15);
  AddMsg( "Das Handelsschiff naehert sich der Kueste.\n", 5 );
  AddMsg( "Zwischen der dichten Vegetation am Ufer kommt ein kleiner "
          "Hafen in Sichtweite.\n", 5 );
  AddRoute( TIJARA, 30, 5, "am Hafen von Tijara",
         ({"dschungel","tijara"}), "nach Tijara" );
  AddFun( "random_route_tijara", 15);
// 61: Midas -> Felseninsel
  AddMsg( "Das Handelsschiff segelt ueber das weite Meer.\n", 15);
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt auf eine kleine Insel zu.\n", 15);
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff naehert sich der Felseninsel an.\n", 5);
  AddRoute( FELSENINSEL, 30, 5, "am Steg der Felseninsel",
         ({"felseninsel","kronang"}), "zur Felseninsel" );
  AddFun( "random_route_felseninsel", 15);
 // 68: nach Smoersky
  AddMsg( "Das Handelsschiff schlaegt einen Nordwestkurs ein.\n",15);
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff segelt nach Norden.\n",15);
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff kommt langsam in die Polarregion.\n", 15);
  AddFun( "SeeEreignisNord", 15);
  AddFun( "kalt", 15);
  AddFun( "SeeEreignisNord", 15);
  AddMsg( "Das Handelsschiff naehert sich einem vereisten Steg.\n",5);
  AddRoute( POLAR, 30, 5, "am Steg von Smoersky",
         ({"smoersky","polar"}), "nach Smoersky" );
  AddMsg( "Das Handelsschiff faehrt jetzt nach Derlim.\n",5);
  AddMsg( "Das Handelsschiff segelt nach Sueden.\n",15);
  AddFun( "SeeEreignisNord", 15);
  AddMsg( "Das Handelsschiff kommt langsam in die gemaessigte Zone.\n", 15);
  AddFun( "SeeEreignis", 15);
  AddFun( "warm", 15);
  AddFun( "SeeEreignis", 15);
  AddMsg( "Das Handelsschiff naehert sich dem Steg von Derlim.\n",5);
  AddRoute( HOBBITS, 30, 5, "am Steg vom Derlim",
         ({"derlim","hobbitdorf","hobbingen"}), "nach Derlim" );
  AddFun( "random_route_hobbits", 15);
  Start();
}

void random_route_midas()
{
  Halt();
  switch(random(4))
  {
    case 0: 
    case 1: Start(2);
      tell_room(TO, "Das Handelsschiff faehrt jetzt nach Tijara.\n");
      break;
    case 2: Start(28); 
      tell_room(TO, "Das Handelsschiff faehrt jetzt nach Derlim.\n");
      break;
    case 3: Start(61); 
      tell_room(TO, "Das Handelsschiff faehrt jetzt zur Felseninsel.\n");
      break;
  }
}

void random_route_tijara()
{
  Halt();
  switch(random(4))
  {
    case 0: 
    case 1: Start(14); 
      tell_room(TO, "Das Handelsschiff faehrt jetzt nach Midas.\n");
      break;
    case 2: Start(25); 
      tell_room(TO, "Das Handelsschiff faehrt jetzt nach Derlim.\n");
      break;
    case 3: Start(61); 
      tell_room(TO, "Das Handelsschiff faehrt jetzt zur Felseninsel.\n");
      break;
  }
}

void random_route_hobbits()
{
  Halt();
  switch(random(3))  
  {
    case 0: Start(38); 
      tell_room(TO, "Das Handelsschiff faehrt jetzt nach Midas.\n");
      break;
    case 1: Start(48);
      tell_room(TO, "Das Handelsschiff faehrt jetzt nach Tijara.\n");
      break;
    case 2: Start(68);
      tell_room(TO, "Das Handelsschiff faehrt jetzt in die Polarregion.\n");
      break;

  }
}

void random_route_felseninsel()
{
  Halt();
  switch(random(2))
  {
    case 0: Start(17); 
      tell_room(TO, "Das Handelsschiff faehrt jetzt nach Midas.\n");
      break;
    case 1: Start(4);
      tell_room(TO, "Das Handelsschiff faehrt jetzt nach Tijara.\n");
      break;
  }
}

