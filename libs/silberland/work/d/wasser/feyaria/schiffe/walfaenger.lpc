// walfaenger.c
// Ein Walfaenger, der von Midas nach Smoerksy faehrt
// 1998-07-30  Feyaria@SilberLand

#include "../def.h"

inherit SCHIFFE "ship";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Walfaenger" );
  SetProp( P_INT_LONG, BS(
    "Der Walfaenger ist ein schnittiges Segelschiff. Auf den beiden Masten "
    "befinden sich nur Schratsegel, damit man besser gegen den Wind kreuzen "
    "kann. So kann kein Wal diesem Schiff entkommen. Am Bug befindet sich "
    "ein grosse Torsionsschleuder, mit der man Harpunen auf die Wale "
    "schiessen kann." ) );
  SetProp( P_SHORT, "Ein Walfaenger" );
  SetProp( P_LONG, QueryProp(P_INT_LONG) );   
  SetProp( P_NAME, "Walfaenger" );
  AddId( ({ "schiff", "walfaenger" }) );
  SetProp( P_GENDER, MALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_OTHER]) );

  AddDetail( ({"schiff", "walfaenger", "segelschiff"}), QueryProp(P_INT_LONG));
  AddDetail( ({"bug"}),
    "Am Bug befindet sich ein grosse Torsionsschleuder, mit der man Harpunen "
    "auf die Wale schiessen kann.");
  AddDetail( ({"harpune", "harpunen"}),
    "Die Harpunen werden mit der Torsionsschleuder auf die Wale geschossen.");
  AddDetail( ({"torsionsschleuder", "schleuder", "wurfmaschine"}),
    "Die Torsionsschleuder ist eine Wurfmaschine, die die Energie aus einem "
    "verdrillten Tau nimmt. So kann man Harpunen ueber viele Meter "
    "verschiessen.");
  AddDetail( ({"tau", "energie"}),
    "Das verdrillte Tau liefert die Energie fuer die Wurfmaschine.");  
  AddDetail( ({"schiff", "walfaenger", "segelschiff"}),
    "Der Walfaenger ist ein schnittiges Segelschiff. Auf den beiden Masten "
    "befinden sich nur Schratsegel, damit man besser gegen den Wind kreuzen "
    "kann. So kann kein Wal diesem Schiff entkommen.");
  AddDetail( ({"mast", "masten", "segel", "schratsegel"}),
    "Auf den beiden Masten befinden sich nur Schratsegel, damit man besser "
    "gegen den Wind kreuzen kann. ");
  AddDetail( ({"boden", "planken", "planke", "holzplanken", "holzplanke"}),
    "Der Boden besteht aus frischgescheuerten und blankgeputzen Holzplanken.");
  AddDetail( ({"himmel", "sonne", "wolken", "wind", "wetter", "wolke"}),
    "Das Wetter ist heute sehr angenehm: Vom Himmel brennt die Sonne herunter "
    "und ein leichter Wind treibt ein paar Wolken vor sich her.");
  AddDetail( ({"wasser", "meer", "meerwasser", "wellen", "welle"}),
    "Das Meerwasser plaetschert in leichten Wellen gegen das Schiff.");

  AddSound( ({DEFAULT_SOUND, "meer", "wellen", "rauschen"}),
    "Du hoerst das Rauschen der Wellen.");
  AddSmell( ({DEFAULT_SMELL, "meer"}),
    "Es riecht stark nach Meer.");
  
  create_default_ship(5);

  AddRoute( PIER_WEST, 60, 10, "an der Pier von Midas",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddMsg( "Der Walfaenger segelt mit einer steifen Brise nach Westen.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Walfaenger segelt nach Norden um das Westkap herum.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Walfaenger segelt nach Nordwest.\n", 10);
  AddFun( "SeeEreignis", 10);
  AddFun( "kalt", 10);
  AddFun( "SeeEreignisNord", 10);
  AddMsg( "Der Walfaenger erreicht das Polarmeer.\n", 10);
  AddFun( "SeeEreignisNord", 10);
  AddMsg( "Zwischen den Eisschollen kommt ein kleiner Hafen in Sichtweite.\n", 5 );
  AddRoute( POLAR, 30, 10, "am Steg vom Smoersky",
         ({"smoersky","polar"}), "nach Smoersky" );
  AddMsg( "Der Walfaenger segelt quer durch das Polarmeer.\n", 5 );
  AddFun( "SeeEreignisNord", 5);
  AddMsg( "Ein gewaltiger Wal wird gesichtet - die Jagd beginnt.\n", 5 );
  AddFun( "jagd", 15 );
  AddFun( "SeeEreignisNord", 10);
  AddMsg( "Der Walfaenger segelt durch das Eismeer nach Sueden.\n", 5 );
  AddFun( "SeeEreignisNord", 10);
  AddMsg( "Der Walfaenger laesst das Polargebiet hinter sich.\n",10);
  AddFun( "warm", 10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Walfaenger umrundet das Westkap.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Walfaenger segelt nach Osten.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Der Walfaenger naehert sich der Kueste.\n", 5 );
  AddMsg( "Am Ufer kommt ein kleiner Hafen in Sichtweite.\n", 5 );
  Start();
}

void jagd()
{
  int wie;
  if( wie=random(2) )
    tell_room(TO, "Der Wal wird harpuniert.\n" );
  else
    tell_room(TO, "Der Wal kann den Jaegern entkommen.\n");
  call_out("zurueck", 5, wie);
}  

void zurueck(int wie)
{
  if( wie )
    tell_room(TO, "Der Wal wird ausgeschlachtet und dann gehts wieder "
        "zurueck.\n");
  else
    tell_room(TO, "Enttaeuscht macht man sich zur Umkehr bereit.\n");
}
    

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
