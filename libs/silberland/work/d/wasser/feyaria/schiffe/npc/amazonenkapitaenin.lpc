// amazonenkapitaenin.c
// Kapitaenin des Katamarans nach Edynia

inherit "std/npc";
inherit "std/npc/spells";

#include "/d/wasser/feyaria/def.h"
#include <npc/combat.h>

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Amazonenkapitaenin");
  SetProp(P_LONG, BS(
    "Eine wettergegerbte Amazone steht am Steuer und hat das Meer genauso im "
    "Blick wie ihre Passagiere. Ihre Haltung ist aufrecht und sicher, die "
    "Bewegungen sind knapp und geuebt. Alles an ihr wirkt so, als wuerde sie "
    "dieses Schiff auch bei Sturm und Dunkelheit nach Edynia bringen."));

  SetProp(P_NAME, "Kapitaenin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  AddId(({ "amazone", "amazonenkapitaenin", "kapitaenin", "kapitaen",
           "steuermann", "steuermannin", "\nkatamaran_kapitaenin" }));
  AddAdjective(({ "amazonen", "amazonische", "amazonenkapitaenin" }));

  create_default_npc(35);

  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 250);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "kommt an Deck");
  SetProp(P_MSGOUT, "geht ueber das Deck");

  SetChats(2, ({
    "Die Kapitaenin prueft den Wind und laesst den Blick ueber die Wellen gleiten.\n",
    "Die Kapitaenin zieht das Segel etwas dichter und nickt zufrieden.\n",
    "Die Kapitaenin sagt: Festhalten, wenn der Wind dreht.\n",
    "Die Kapitaenin sagt: Edynia ist nicht weit, wenn das Meer ruhig bleibt.\n",
  }) );

  SetProp(P_SPELLRATE, 60);
  AddSpell(3, 650,
    Name(WER,1) + " stoesst Dir ihren Speer zwischen die Rippen.\n",
    Name(WER,1) + " stoesst @WEM ihren Speer zwischen die Rippen.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
  AddSpell(2, 600,
    Name(WER,1) + " reisst das Segel herum, und eine boesartige Windboe trifft Dich.\n",
    Name(WER,1) + " reisst das Segel herum, und eine boesartige Windboe trifft @WEN.\n",
    DT_AIR, ([SP_SHOW_DAMAGE: 1]));
  AddSpell(1, 850,
    Name(WER,1) + " wirft Dir eine Ladung Gischt ins Gesicht.\n",
    Name(WER,1) + " wirft @WEM eine Ladung Gischt ins Gesicht.\n",
    DT_WATER, ([SP_SHOW_DAMAGE: 1]));

  SetProp(P_GUILD, "amazonen");

  SUID;
  CLONEME("/gilden/amazonen/weapon/amazonenspeer");
  command("zuecke speer");
  CLONEME("/gilden/amazonen/armour/brustharnisch");
  CLONEME("/gilden/amazonen/armour/beinschienen");
  CLONEME("/gilden/amazonen/armour/armschienen");
  CLONEME("/gilden/amazonen/armour/waffengurt");
  CLONEME("/gilden/amazonen/armour/helm3");
  command("trage alles");
}
