// katamaran.c
// Ein Katamaran, der von der Pier nach Edynia faehrt
// 2025-12-19  Codex@SilberLand

#include "../def.h"

inherit SCHIFFE "ship";

#define EDYNIA_STEG "/d/wasser/aaliyah/edynia/room/amazon1"
#define KAPITAENIN  "/d/wasser/feyaria/schiffe/npc/amazonenkapitaenin"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Katamaran");
  SetProp(P_INT_LONG, BS(
    "Du stehst auf einem schnellen Katamaran. Zwei schmale Rumpfe tragen ein "
    "breites Deck, das ueber dem Wasser zu schweben scheint. Das Segel ist "
    "straff gesetzt und der Wind laesst das Schiff leise singen. Von hier aus "
    "kannst Du entweder an der Pier anlegen oder Kurs auf Edynia nehmen."));
  SetProp(P_SHORT, "Ein Katamaran");
  SetProp(P_LONG, QueryProp(P_INT_LONG));
  SetProp(P_NAME, "Katamaran");
  AddId(({ "schiff", "katamaran" }));
  SetProp(P_GENDER, MALE);
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_TRANSPARENT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_OTHER]));

  AddDetail(({"katamaran", "schiff"}), QueryProp(P_INT_LONG));
  AddDetail(({"rumpf", "rumpfe", "ruempfe", "geschwindigkeit"}),
    "Die beiden schmalen Rumpfe schneiden sauber durchs Wasser und geben dem "
    "Katamaran seine Geschwindigkeit.");
  AddDetail(({"deck", "boden", "planken", "fuessen"}),
    "Das breite Deck ist sauber und trocken. Unter Deinen Fuessen fuehlt es "
    "sich stabil an, obwohl das Schiff ueber den Wellen gleitet.");
  AddDetail(({"segel", "takelage", "mast", "wind", "ueberfahrten", "ueberfahrt"}),
    "Das Segel ist straff gesetzt. Die Takelage ist schlicht, aber zweckmaessig "
    "und auf schnelle Ueberfahrten ausgelegt.");
  AddDetail(({"meer", "wasser", "wellen", "bewegung"}),
    "Das Meer liegt rund um das Schiff. Die Wellen wirken von hier aus "
    "harmlos, doch sie tragen Dich weit hinaus.");
  AddDetail(({"pier", "anlegestelle"}),
    "An der Pier kannst Du den Katamaran betreten oder verlassen. Von hier "
    "aus beginnt und endet die Ueberfahrt.");
  AddDetail(({"edynia", "amazoneninsel", "insel", "ziel"}),
    "Edynia ist das Ziel dieser Ueberfahrt. Wenn der Wind guenstig steht, "
    "ist die Insel schnell erreicht.");
  AddDetail(({"kurs", "richtung", "fahrt"}),
    "Der Kurs ist einfach: Entweder zur Pier oder nach Edynia.");
  AddDetail(({"himmel", "wetter"}),
    "Ueber dir liegt der offene Himmel. Bei klarem Wetter wirkt die Fahrt "
    "noch schneller und leichter.");
  AddDetail(({"knarren", "knarzen"}),
    "Bei jeder Bewegung der Wellen knarrt das Deck leise unter Deinen Fuessen.");
  AddDetail(({"meeresluft", "luft", "lungen"}),
    "Salzige Meeresluft fuellt Deine Lungen.");

  AddSound(({DEFAULT_SOUND, "meer", "wellen", "rauschen"}),
    "Du hoerst das Rauschen der Wellen und das leise Knarren des Decks.");
  AddSmell(({DEFAULT_SMELL, "meer", "salz"}),
    "Salzige Meeresluft fuellt Deine Lungen.");

  AddItem(KAPITAENIN, REFRESH_DESTRUCT);

  create_default_ship(6);

  AddRoute(PIER_OST, 30, 10, "an der Ostseite der Pier",
           ({"pier", "midas", "fischerdorf"}), "zur Pier");
  AddMsg("Matrosen werfen die Leinen los, und der Katamaran gleitet von der Pier.\n", 10);
  AddMsg("Das Segel faengt Wind, die beiden Rumpfe schneiden gleichzeitig ins Wasser.\n", 10);
  AddFun("SeeEreignis", 10);
  AddMsg("Kuehles Spruehwasser legt sich wie ein feiner Film auf das Deck.\n", 10);
  AddMsg("Der Katamaran nimmt Fahrt auf; die Wellen klatschen hart gegen die Ruempfe.\n", 10);
  AddFun("SeeEreignis", 10);
  AddMsg("Mit jeder Boe hebt sich der Bug einen Moment aus dem Wasser.\n", 10);
  AddFun("SeeEreignisSued", 10);
  AddMsg("In der Ferne zeichnen sich die Umrisse Edynias ab.\n", 10);
  AddFun("SeeEreignisSued", 10);
  AddMsg("Das Wasser wird ruhiger, als der Katamaran in die Naehe der Kueste kommt.\n", 5);
  AddMsg("Der Katamaran gleitet mit einem leisen Knirschen auf den Strand von Edynia.\n", 5);
  AddRoute(EDYNIA_STEG, 30, 10, "am Steg von Edynia",
           ({"edynia", "amazoneninsel", "amazonen"}), "nach Edynia");

  AddMsg("Der Katamaran wendet und das Segel steht kurz hart im Wind, dann nimmt er Kurs auf offene See.\n", 10);
  AddFun("SeeEreignisSued", 10);
  AddMsg("Die Ruempfe ziehen lange, helle Spuren im Wasser hinter sich her.\n", 10);
  AddFun("SeeEreignis", 10);
  AddMsg("Ein Windstoss laesst das Segel knattern; das Deck zittert unter Deinen Fuessen.\n", 10);
  AddFun("SeeEreignis", 10);
  AddMsg("Langsam tritt die Pier aus dem Dunst hervor.\n", 10);
  AddMsg("Die Pier kommt in Sicht.\n", 5);
  AddMsg("Sanft stupst der Katamaran an den Pier und die Matrosen vertaeuen die Leinen.\n");

  Start();
}
