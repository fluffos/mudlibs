// /d/dschungel/feyaria/felseninsel/obj/yacht.c  
// Yacht fuer Transport zur Felseninsel
// 21-10-96   Feyaria@AnderLand
// 15-11-96   Feyaria@SilberLand

#include "../def.h"

inherit SCHIFFE "ship";

void create()
{
  ::create();

  SetProp(P_SHORT, "Eine Segelyacht (privat)");
  SetProp(P_LONG, BS(
    "Diese kleine Segelyacht sieht ziemlich schnittig aus. Mit ihren "
    "grossen weissen Segeln ist sie sicher flott unterwegs."));
  SetProp(P_INT_SHORT, "Auf einer Segelyacht");
  SetProp(P_INT_LONG, BS(
    "Du bist auf einer kleinen Segelyacht, die Badegaeste auf eine kleine, "
    "abgelegene Insel bringt. Das Deck ist sauber geschrubbt und die Segel "
    "sind weisser als weiss. Sicher wird es eine schoene Ueberfahrt."));
  SetProp(P_NAME, "Segelyacht" );
  AddId( ({ "yacht", "segelyacht"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:28, ENV_TERRAIN:TT_OTHER]) );
  
  AddDetail( ({"mast"}),
    "Natuerlich hat die Yacht auch einen Mast. Daran ist das grosse Segel "
    "befestigt.");
  AddDetail( "segel",
    "Die grossen, weissen Segel machen einen guten Eindruck. Sicher "
    "verhelfen sie der Yacht zu einem enormen Tempo.");
  AddDetail( ({"deck", "boden"}),
    "Das Deck ist sauber geschrubbt.");
  AddDetail( ({"yacht", "segelyacht"}),
    "Du stehst mitten drauf.");
  AddDetail( ({"meer", "wasser"}),
    "Das Meer ist ausserhalb der Yacht.");

  SetProp(P_DEPARTMSG, ({
    "Die Yacht segelt auf das offene Meer hinaus.\n", 
    "Die Yacht hisst die Segel und laeuft aus.\n"}) );
  SetProp(P_ARRIVEMSG, ({
    "Die Segelyacht legt @@QueryArrived@@ an.\n",
    "Eine Segelyacht legt am Steg an.\n"}) );
  SetProp(P_ENTERMSG, ({
    "betritt die Segelyacht",
    "kommt an Bord"}) );
  SetProp(P_LEAVEMSG, ({
    "geht von Bord",
    "verlaesst die Segelyacht"}) );
  SetProp(P_LEAVEFAIL, "Die Segelyacht ist doch auf hoher See");
  SetProp(P_ENTERFAIL, "Es passen nur 2 Passagiere auf die Segelyacht");
  SetProp(P_MAX_PASSENGERS, 2);

  AddRoute( FELSENINSEL, 30, 30, "am Steg der Felseninsel",
         ({"felseninsel","kronang"}), "zur Felseninsel" );
  AddFun( "SeeEreignisSued", 30);
  AddMsg( "Die Yacht segelt mit gutem Wind in Richtung Edynia.\n", 30);
  AddFun( "SeeEreignis", 30);
  AddFun( "SeeEreignisSued", 30);
  AddMsg( "Die Yacht naehert sich der Amazoneninsel Edynia.\n", 30);
  AddRoute( "/players/aaliyah/edynia/room/amazon1", 30, 30, "am Steg von Edynia",
         ({"amazoneninsel","edynia"}), "nach Edynia" );
  AddFun( "SeeEreignisSued", 30);
  AddMsg( "Die Yacht naehert sich der andracischen Pirateninsel.\n", 30 );
  AddRoute( "/d/andracia/yondala/pirateninsel/room/pirateninsel_steg", 30, 30, "am Steg "
      "der andracischen Pirateninsel", ({"pirateninsel"}), "zur andracischen Pirateninsel" );
  AddMsg( "Die Yacht segelt mit gutem Wind in Richtung Felseninsel.\n", 30 );
  AddFun( "SeeEreignis", 30);
  AddFun( "SeeEreignisSued", 30);
  AddMsg( "Die Yacht naehert sich der Felseninsel.\n", 30 );
  Start();
}

void init()
{
  ::init();
  if (TP && present(TP,TO) && !IS_LEARNER(TP))
  {
    tell_object(TP, "Das ist eine Privatyacht!\n");
    TP->move(environment(TO), M_NOCHECK);
  }
}
