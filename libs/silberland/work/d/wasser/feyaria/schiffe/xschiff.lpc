// xschiff.c
// Das Expeditionsschiff, das von Midas in die Trollberge segelt
// 1998-07-31  Feyaria@SilberLand

#include "../def.h"

inherit SCHIFFE "ship";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Expeditionsschiff" );
  SetProp( P_INT_LONG, BS(
    "Das Expeditionsschiff ist ein mittelgrosses, zweimastiges Segelschiff. "
    "Es bringt eine Menge abenteuerlustiger Gestalten in die weite Welt "
    "hinaus. Beide Masten besitzen je zwei Rahsegel. Da der vordere Mast "
    "ziemlich weit hinten steht, ist am Bug noch genug Platz fuer das "
    "grosse Klueversegel. Am hinteren Mast flattert eine weisse Fahne.") );
  SetProp( P_SHORT, "Das Expeditionsschiff" );
  SetProp( P_LONG, QueryProp(P_INT_LONG) );
  SetProp( P_NAME, "Expeditionsschiff" );
  AddId( ({ "schiff", "expeditionsschiff", "xschiff" }) );
  SetProp( P_GENDER, NEUTER );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_OTHER]) );  

  AddDetail( ({"schiff", "expeditionsschiff"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"expedition", "ziel"}),
    "Die Expedition fuehrt wieder einmal in die Trollberge. Da es dort so "
    "viel zu entdecken gibt und man zu Fuss nur sehr schwer dorthinkommt, "
    "faehrt das XSchiff sehr oft dorthin.");
  AddDetail( ({"xschiff"}),
    "Das Expeditionsschiff wird auch mit XSchiff abgekuerzt, zum Teil auch "
    "wegen Kapitaen LIbjosch NUXakomitsch.");
  AddDetail( ({"kapitaen", "libjosch", "nuxakomitsch"}),
    "Libjosch Nuxakomitsch ist der Kapitaen des Expeditionsschiffs. Fuer "
    "einen Gaffo eine sehr ungewoehnliche Stellung, aber er steuert sein "
    "XSchiff sicher durch die Meere.");
  AddDetail( ({"linux"}),
    "So kuerzt Libjosch Nuxakomitsch seinen Namen ab. Irgendwie hast Du "
    "aber das Gefuehl, dass hinter diesem Wort mehr steckt, als es auf den "
    "ersten Blick den Anschein hat.");
  AddDetail( ({"gaffo", "glubschaugen", "gesichtsausdruck"}),
    "Grosse Glubschaugen, etwas duemmlicher Gesichtsausdruck - der Kapitaen "
    "ist wirklich ein echter Gaffo.");
  AddDetail( ({"mast", "masten"}),
    "Das Expeditionsschiff hat zwei Masten. Beide sind mit je zwei Rahsegeln "
    "getakelt.");
  AddDetail( ({"segel"}),
    "Das Expeditionsschiff hat 4 Rahsegel und ein grosses Klueversegel am "
    "Bug.");
  AddDetail( ({"rahsegel"}),
    "Jeder Mast des Expeditionsschiffes hat zwei Rahsegel. Sie sind quer "
    "zur Fahrtrichtung angebracht und nutzen vor allem den Wind, der von "
    "hinten kommt.");
  AddDetail( ({"fahrtrichtung", "richtung"}),
    "Das ist die Richtung, in die das Schiff faehrt. Das kann jede beliebige "
    "Himmelsrichtung sein.");
  AddDetail( ({"himmelsrichtung", "himmelsrichtungen"}),
    "Du denkst . o O ( nordwestobenuntenhintenlinks.... )");
  AddDetail( ({"klueversegel", "kluever"}),
    "Das Klueversegel ist sehr gross und befindet sich zwischen dem vorderen "
    "Mast und dem Bug. Da es sehr beweglich ist, kann es sowohl den Wind "
    "von achtern, von querschiff und auch von vorne ausnutzen. Dadurch ist "
    "das Expeditionsschiff sehr wendig.");
  AddDetail( ({"wind"}),
    "Ohne Wind kommt auch dieses Schiff kaum vorwaerts.");
  AddDetail( ({"bug"}),
    "Der Bug ist relativ schmal und schnittig gebaut.");
  AddDetail( ({"fahne"}),
    "Am hinteren Mast flattert eine Fahne im Wind. Sie ist weiss mit einem "
    "schwarzen Felsbrocken in der Mitte.");
  AddDetail( ({"felsbrocken", "fels", "brocken"}),
    "Der Felsbrocken soll wohl die Trolle guenstig stimmen, damit sie nicht "
    "das Schiff mit Steinen bewerfen, wie sie das angeblich manchmal mit "
    "anderen Schiffen machen. Denn das Ziel dieser Expedition sind mal "
    "wieder die Trollberge.");
  AddDetail( ({"troll", "trolle", "trollberge"}),
    "In den Trollbergen leben viele Trolle.");
  AddDetail( ({"boden", "planken", "planke", "holzplanken", "holzplanke"}),
    "Der Boden besteht aus frischgescheuerten und blankgeputzen Holzplanken.");
  AddDetail( ({"himmel", "sonne", "wolken", "wind", "wetter", "wolke"}),
    "Das Wetter ist heute sehr angenehm: Vom Himmel brennt die Sonne herunter "
    "und ein leichter Wind treibt ein paar Wolken vor sich her.");
  AddDetail( ({"wasser", "meer", "meerwasser", "wellen", "welle"}),
    "Das Meerwasser plaetschert in leichten Wellen gegen das Schiff.");

  AddSound( ({DEFAULT_SOUND, "meer", "wellen", "rauschen"}),
    "Du hoerst das Rauschen der Wellen.");
  AddSmell( ({DEFAULT_SMELL, "meer"}),
    "Es riecht stark nach Meer.");
  
   create_default_ship(9);
  
  AddRoute( PIER_OST, 30, 5, "an der Pier beim Fischerdorf",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddMsg( Name(WER,1)+" segelt nach Suedosten.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddFun( "heiss", 10 );
  AddFun( "SeeEreignisSued", 10);
  AddMsg( Name(WER,1)+" umsegelt das Suedkap.\n", 10);
  AddFun( "SeeEreignisSued", 10);
  AddFun( "warm", 10);
  AddMsg( Name(WER,1)+ " segelt mit Nordostkurs durch das offene Meer.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( Name(WER,1)+ " durchquert ein grosses Nebelfeld.\n",10);
  AddFun( "SeeEreignis", 10);
  AddMsg( Name(WER,1)+" naehert sich den Trollbergen.\n",10);
//  AddRoute( TROLLE, 30, 5, "am Steg in den Trollbergen" );
  AddMsg( Name(WER,1)+ " legt am Steg in den Trollbergen an.\n",5);
  AddMsg( Name(WER,1)+ " legt ab.\n",5);
  AddMsg( Name(WER)+ " segelt nach Suedosten.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( Name(WER,1)+ " durchquert ein grosses Nebelfeld.\n",10);  
  AddFun( "SeeEreignis", 10);
  AddMsg( Name(WER,1)+ " segelt mit Suedwestkurs durch das offene Meer.\n",10);
  AddFun( "heiss", 10 );
  AddFun( "SeeEreignisSued", 10);
  AddMsg( Name(WER,1)+" umsegelt das Suedkap.\n", 10);
  AddFun( "SeeEreignisSued", 10);
  AddFun( "warm", 10);
  AddFun( "SeeEreignis", 10);
  AddMsg( Name(WER,1)+" naehert sich der Kueste.\n", 10 );
  Start();
}

