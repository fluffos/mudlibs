// kogge.c
// Eine Handelskogge, die zwischen Derlim und Midas pendelt
// 1998-07-30  Feyaria@SilberLand


#include "../def.h"

inherit SCHIFFE "ship";
void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Handelskogge" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf einer Handelskogge. Sie transportiert Handelswaren "
    "zwischen Derlim und Midas hin und her. Das Schiff schaut fast so aus "
    "wie ihr Besitzer, ein Hobbit. Die Kogge ist eher klein, aber sehr "
    "dickbaeuchig, sodass man eine ganze Menge von Guetern transportieren "
    "kann. Am einzigen Mast befindet sich nur ein Segel, das dafuer sehr "
    "gross ist.") );
  SetProp( P_SHORT, "Eine Handelskogge" );
  SetProp( P_LONG, BS(
    "Du siehst eine Handelskogge. Sie transportiert Handelswaren "
    "zwischen Derlim und Midas hin und her. Das Schiff schaut fast so aus "
    "wie ihr Besitzer, ein Hobbit. Die Kogge ist eher klein, aber sehr "
    "dickbaeuchig, sodass man eine ganze Menge von Guetern transportieren "
    "kann. Am einzigen Mast befindet sich nur ein Segel, das dafuer sehr "
    "gross ist.") );
  SetProp( P_NAME, "Handelskogge" );
  AddId( ({ "schiff", "handelskogge", "kogge" }) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_OTHER]) );

  AddDetail( ({"schiff", "handelskogge", "kogge"}),
    "Die Kogge ist eher klein, aber sehr dickbaeuchig, sodass man eine "
    "ganze Menge von Guetern transportieren kann. Am einzigen Mast "
    "befindet sich nur ein Segel, das dafuer sehr gross ist.") ;
  AddDetail( ({"mast"}),
    "Die Kogge hat nur einen grossen Mast, der sich in der Mitte des "
    "Schiffes befindet.");
  AddDetail( ({"segel"}),
    "Die Kogge hat nur ein grosses Segel. Damit kann sie zwar einigermassen "
    "schnell segeln, ist aber nicht sehr wendig.");
  AddDetail( ({"waren", "handelswaren", "ware", "handelsware", "gueter"}),
    "Die ganzen Handelswaren sind auf dem Schiff verstaut und werden wohl "
    "im naechsten Hafen wieder verkauft werden.");
  AddDetail( ({"boden", "planken", "planke", "holzplanken", "holzplanke"}),
    "Der Boden besteht aus frischgescheuerten und blankgeputzen Holzplanken.");
  AddDetail( ({"himmel", "sonne", "wolken", "wind", "wetter", "wolke"}),
    "Das Wetter ist heute sehr angenehm: Vom Himmel brennt die Sonne herunter "
    "und ein leichter Wind treibt ein paar Wolken vor sich her.");
  AddDetail( ({"wasser", "meer", "meerwasser", "wellen", "welle"}),
    "Das Meerwasser plaetschert in leichten Wellen gegen das Schiff.");

  AddSound( ({DEFAULT_SOUND, "meer", "wellen", "rauschen"}),
    "Du hoerst das Rauschen der Wellen.");
  AddSmell( ({DEFAULT_SMELL, "meer"}),
    "Es riecht stark nach Meer.");
 
  create_default_ship(6);
  
  AddRoute( PIER_WEST, 30, 10, "an der Pier beim Fischerdorf",
         ({"pier","fischerdorf","midas"}), "zur Pier beim Fischerdorf" );
  AddMsg( "Die Handelskogge segelt langsam nach Westen.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Die Handelskogge segelt nach Norden um das Westkap herum.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Die Handelskogge segelt langsam nach Osten.\n", 10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Die Handelskogge naehert sich der Kueste.\n", 5 );
  AddMsg( "Zwischen den Huegeln kommt ein kleiner Steg in Sichtweite.\n", 5 );
  AddRoute( HOBBITS, 30, 10, "am Steg vom Derlim",
         ({"derlim","hobbitdorf","hobbingen"}), "nach Derlim" );
  AddMsg( "Die Handelskogge segelt langsam nach Westen.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Die Handelskogge segelt nach Sueden um das Westkap herum.\n", 10 );
  AddFun( "SeeEreignis", 10);
  AddMsg( "Die Handelskogge segelt langsam nach Osten.\n", 10);
  AddFun( "SeeEreignis", 10);
  AddMsg( "Die Handelskogge naehert sich der Kueste.\n", 5 );
  AddMsg( "Am Ufer kommt ein kleiner Hafen in Sichtweite.\n", 5 );
  Start();
}

