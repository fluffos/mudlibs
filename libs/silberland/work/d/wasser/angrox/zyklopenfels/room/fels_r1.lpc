inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>

void create()
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Ein Felsplateau");
  SetProp(P_INT_LONG, "Du befindest Dich auf einem kleinen "
		 +"Felsplateau, rings um Dich ist nur die offene See "
		 +"zu sehen. Die Sonne brennt Dir auf den Pelz und "
		 +"an dieser felsigen Gesteinsformation sind hier noch "
		 +"Stufen die ins Meer fuehren zu sehen. Eine leichte "
                 "Brise weht vom Meer "
		 +"her, der Himmel ist wolkenlos. Es ist warm.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:34, ENV_TERRAIN:TT_MOUNTAIN]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht hier anscheinen immer im "
		 +"Zenit, drum ist es auch so verdammt heiss hier.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "Die Sonne ist heiss, sehr heiss sogar, "
		   +"aber das ist nun mal so auf einem Felsplateau mitten im "
		   +"Meer.");

  AddDetail(({"plateau","felsplateau"}),
                   "Du stehst darauf, es ist hart und steinig.");
  
  AddDetail(({"formation","gesteinsformation"}),
                   "Die Formation bildet ein kleines Plateau.");

  AddDetail(({"boden"}), 
                    "Den Boden bildet hier eine Gesteinsformation. "
		   +"Er ist heiss, ja dsogar sehr heiss.");

  AddDetail("zenit", "Sieht so aus als wuerde die Sonne hier immer im "
		   +"Zenit stehen.");

  AddDetail("brise", "Die Brise ist angenehm.");

  AddDetail("luft", "Ja, herrliche Luft. *Schnaub*");

  AddDetail("meer", "Das Meer ist ruhig, aber man hoert es rauschen.");

  AddDetail("see", "Die See ist ruhig.");

  AddDetail("pelz", "Langsam wirst Du braun.");
  
  AddDetail("pelz", "Langsam wirst Du braun.");
 
  AddDetail("stufen", "Sie sind in dir Formation gehauen und fuehren nach "+
      "unten.");
  
  AddSound(DEFAULT_SOUND, "Das Rauschen des Meeres ist zu hoeren.");
 
  AddSmell(DEFAULT_SMELL, "Der salzige Geruch des Meeres liegt in "
		  +"der Luft.");
  AddSound(({"rauschen", "meer"}), "Richtig romantisch ..."); 
  AddSmell(({"geruch", "meeres", "meer", "salz"}), "Du atmest mehrmals tief "
		  +"durch und fuehlst Dich danach wie frisch geboren.");


  AddExit("norden", "/d/wasser/angrox/zyklopenfels/room/fels_r2");
  AddExit("osten", "/d/wasser/angrox/zyklopenfels/room/fels_r4");
  AddExit ("unten", ([ EX_DEST : "/d/wasser/angrox/zyklopenfels/room/swim_back",
                       EX_MSG  : "ins offene Meer",
                       EX_MSG_OUT: "springt",
                       EX_MSG_IN: "faellt vom Felsplateou herunter ins Meer"]) );


}





