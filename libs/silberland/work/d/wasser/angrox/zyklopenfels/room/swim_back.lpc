inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>

int hat_flossen();

void create()
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Im offenen Meer");
  SetProp(P_INT_LONG, "Du befindest Dich im offenen Meer. "
      "Neben Dir ist dieser Felsen zu sehen, ansonsten siehst Du viel "+
      "Wasser und im Westen kannst Du noch eine Insel sehen. "+
      "An dem Felsen sind Stufen zu sehen die nach oben fuehren. "+
      "Du kannst nur hoffen, das Du schnell wieder an Land "+
      "kommst bevor Dich ein Hai frisst.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:34, ENV_TERRAIN:TT_WATER]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht hier anscheinen immer im "
		 +"Zenit, drum ist es auch so verdammt heiss hier.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "Die Sonne ist heiss, sehr heiss sogar, "
		   +"aber das ist nun mal so in mitten des offenen "
		   +"Meeres.");

  AddDetail(({"boden"}), 
                    "Den Boden des Meeres kannst Du nicht erkennen, "
		   +"es ist wohl zu tief.");

  AddDetail("meer", "Das offene Meer ist ein wenig unruhig.");
  
  AddDetail("insel", "Man koennte dort hin, aber ohne Flossen "+
      "wuerdest Du es nie schaffen.");
  
  AddDetail("flossen",
      "Wenn Du welche hast, kannst Du ja nach Westen schwimmen.");
  
  AddSound(DEFAULT_SOUND, "Das Rauschen des Meeres ist zu hoeren.");
 
  AddSmell(DEFAULT_SMELL, "Der salzige Geruch des Meeres liegt in "
		  +"der Luft.");
  AddSound(({"rauschen", "meer"}), "Richtig romantisch ..."); 
  AddSmell(({"geruch", "meeres", "meer", "salz"}), "Du atmest mehrmals tief "
		  +"durch und fuehlst Dich danach wie frisch geboren.");

  AddDetail("stufen", "Sie fuehren nach oben.");

  AddDetail( ({"fels","felsen"}),
      "Man kann ihn besteigen.");

  AddExit("oben", "/d/wasser/angrox/zyklopenfels/room/fels_r1");
  AddExit ("westen", ([
        EX_TESTFUNC: #'hat_flossen,
        EX_DEST : "/d/wasser/angrox/insel/room/strand_r1.lpc",
        EX_MSG  : "ins offene Meer hinaus",
        EX_PLMSG   : "Du schwimmst mit den Flossen zur Insel.\n",
        EX_MSG_OUT: "schwimmt",
        EX_MSG_IN: "schwimmt vom offenen Meer herein"]) );

}

int hat_flossen() {
  if (!deep_present("\nflossi",this_player()) ) {
    write("Ohne Flossen schwimmst Du nicht zur Insel.\n");
    return 0;
  }
  else return 1;
}
  


