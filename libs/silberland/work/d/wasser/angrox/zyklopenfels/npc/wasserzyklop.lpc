inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>

void create()
{
 
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Wasserzyklop");
  SetProp(P_LONG,
    "Vor Dir steht ein riesiger Wasserzyklop. Er hat eine blaue Haut "
   +"und starrt Dich mit seinem einzelnem Auge boese an. Es sieht so aus, "
   +"als wuede er ab und an hier auf diesem Felsen vorbeikommen, um die "
   +"Sonne zu geniessen.");
  SetProp(P_NAME, "Wasserzyklop");
  SetProp(P_GENDER, MALE);
  AddId(({"zyklop", "wasserzyklop"}));

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit wasserigen Haenden", 300, DT_WATER}));
  SetProp(P_MAX_HP, 600);
  SetProp(P_BODY, 100);
  SetProp(P_XP, QueryProp(P_XP)+500*100);
  SetProp(P_RACE, "Zyklop");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_WATER:-0.5]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_DIE_MSG,  " bricht zusammen.\n");

  SetProp(P_SPELLRATE,20);

  AddSpell(3,400,
    "Der Wasserzyklop ersaeuft Dich.\n",
    "Der Wasserzyklop ersaeuft @WEN.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));

}


