inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

create()
{
    if (!is_clone(this_object())) return;
       ::create();
  SetProp (P_SHORT, "Ein Hirte");
  SetProp (P_LONG, "Vor Dir steht eine voellig heruntergekommene Gestalt die "
      "in Fetzen gekleidet ist. Es ist eindeutig, dass er ein Hirte ist, der "
      "einen Schiffbruch erlitten hat. Leider ist er komplett verwirrt und "
      "brummelt nur unverstaendliches Zeug vor sich hin. Offenbar hat er "
      "seinen Hirtenstab verloren und hat sich einen aequivalenten Ersatz "
      "besorgt.");

  SetProp (P_NAME, "Hirte");
  SetProp(P_ARTICLE, 1);
  SetProp(P_AGGRESSIVE,0);
  SetProp (P_GENDER, MALE);
  AddId ( ({"mann","hirte", "chirte"}) );
  create_default_npc (10+random(7));

  SetProp (P_BODY, 60);
  SetProp (P_HANDS, ({" mit blossen Haenden", 170,DT_BLUDGEON}));
  SetProp (P_ALIGN, -50);
  SetProp (P_AGGRESSIVE, 0);
  SetProp (P_RACE, "Mensch");
  SetProp (P_SIZE, 160);
  SetProp (P_MSGOUT, "hinkt weiter");
  SetProp (P_MSGIN, "hinkt herein");
  catch( CLONEME("/players/ronja/obj/kanalgitter") ); 
}
