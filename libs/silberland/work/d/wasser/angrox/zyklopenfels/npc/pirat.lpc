inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

create()
{
    if (!is_clone(this_object())) return;
       ::create();
  SetProp (P_SHORT, "Ein Pirat");
  SetProp (P_LONG, "Ein kleiner Mensch steht vor Dir. Seine Kleider sind "
      +"zerschlissem und auf seinem Kopf traegt er einen Piratenhut. "
      +"Sein linkes Auge duerfte er mal in einem Kampf verloren haben. "
      +"Er scheint hier gestrandet zu sein.");
  SetProp (P_DIE_MSG, " verreckt elendig.\n");
  SetProp (P_NAME, "Pirat");
  SetProp(P_ARTICLE, 1);
  SetProp(P_AGGRESSIVE,0);
  SetProp (P_GENDER, MALE);
  AddId ( ({"mann","pirat"}) );
   create_default_npc (16);

  SetProp (P_BODY, 60);
  SetProp (P_HANDS, ({" mit blossen Haenden", 170,DT_BLUDGEON}));
  SetProp (P_ALIGN, -50);
  SetProp (P_AGGRESSIVE, 0);
  SetProp (P_RACE, "Mensch");
  SetProp (P_SIZE, 160);
  SetProp (P_MSGOUT, "hinkt weiter");
  SetProp (P_MSGIN, "hinkt herein");
   
}
