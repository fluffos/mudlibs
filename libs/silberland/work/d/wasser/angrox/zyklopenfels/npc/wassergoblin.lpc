inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

void create()
{
    if (!is_clone(this_object())) return;
       ::create();
  SetProp(P_SHORT, "Ein Wassergoblin");
  SetProp(P_LONG, "Ein wasserfarbener Goblin steht vor Dir. Er spannt "
      "seine Muskel an und starrt Dich fuerchterlich an. Seine schuppige "
      "Haut erinnert Dich an einen Fisch, doch sein Gesicht sieht eher "
      "aus wie die Mischung aus einer Kuh und einem Hund.");
  SetProp(P_DIE_MSG, " grunzt noch einmal, dann verreckt er.\n");
  SetProp(P_NAME, "Wassergoblin");
  SetProp(P_ARTICLE, 1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_GENDER, MALE);
  AddId( ({"wassergoblin","goblin"}) );
   create_default_npc (16);

  SetProp(P_BODY, 60);
  SetProp(P_HANDS, ({" mit blossen Haenden", 140,DT_BLUDGEON}));
  SetProp(P_ALIGN, -100);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_RACE, "Goblin");
  SetProp(P_SIZE, 150);
  SetProp(P_MSGOUT, "gleitet weiter");
  SetProp(P_MSGIN, "gleitet herein");
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([ DT_WATER: -1, DT_FIRE: 0.3, DT_LIGHTNING: 0.2]) );
   

  AddInfo ("goblin","grunzt laut.\n");
  AddInfo ("wassergoblin","hirtet im Kreis.\n");


  SetAttackChats(25, ({
   "Der Wassergoblin tropft etwas.\n",
   "Der Wassergoblin verschwimmt vor Deinen Augen.\n"
       }) );

  if(random(3)) clone_object("/d/wasser/angrox/zyklopenfels/obj/flossen.lpc")->
        move(this_object(),M_NOCHECK);

}
