inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

create()
{
    if (!is_clone(this_object())) return;
       ::create();
  SetProp (P_SHORT, "Ein Gestrandeter");
  SetProp (P_LONG, "Ein dunkelhaeutiger, in Lumpen gehuellter Mann "
      +"steht vor Dir. Er hat einen Langen Bart und sieht sehr ungepflegt "
      +"aus. Er muss wohl schon einige Tage im Wasser getrieben sein, "
      +"bevor er hier auf diesem Felsen gestrandet ist.");
  SetProp (P_DIE_MSG, " stoehnt noch einmal, dann strirbt er.\n");
  SetProp (P_NAME, "Gestrandeter");
  SetProp(P_ARTICLE, 1);
  SetProp(P_AGGRESSIVE,0);
  SetProp (P_GENDER, MALE);
  AddId ( ({"mann","gestrandeter","gestrandeten"}) );
   create_default_npc (15);

  SetProp (P_BODY, 65);
  SetProp (P_HANDS, ({" mit blossen Haenden", 140,DT_BLUDGEON}));
  SetProp (P_ALIGN, 100);
  SetProp (P_AGGRESSIVE, 0);
  SetProp (P_RACE, "Mensch");
  SetProp (P_SIZE, 180);
  SetProp (P_MSGOUT, "geht weiter");
  SetProp (P_MSGIN, "geht herein");


}
