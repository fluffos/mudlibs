inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>

void create()
{
 
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein antiker Wasserzyklop");
  SetProp(P_LONG,
    "Vor Dir steht ein riesiger antiker Wasserzyklop. Er hat eine blaue Haut "
   +"und starrt Dich mit seinem einzelnem Auge boese an. Es sieht so aus, "
   +"als wuede er ab und an hier auf diesem Felsen vorbeikummen um die "
   +"Sonne zu geniessen.");
  SetProp(P_GENDER, MALE);
  AddId(({"zyklop", "wasserzyklop"}));

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit wasserigen Haenden", 500, DT_WATER}));
  SetProp(P_MAX_HP, 600);
  SetProp(P_BODY, 100);
  SetProp(P_XP, QueryProp(P_XP)+500*100);
  SetProp(P_RACE, "Zyklop");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_WATER:-0.5, DT_FIRE:0.5]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_DIE_MSG,  " bricht zusammen.\n");

  SetProp(P_SPELLRATE,40);

  AddSpell(3,800,
    "Der Wasserzyklop ersaeuft Dich.\n",
    "Der Wasserzyklop ersaeuft @WEN.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));


  clone_object("/d/wasser/angrox/zyklopenfels/obj/zyklopenhaar.lpc")->
    move(this_object(),M_NOCHECK);

  set_living_name("\nHurzenfurz");
  
  SetProp(P_NAME, "Wasserzyklop");
  SetProp(P_NAME_ADJ, "antik");

  
}

void die(int poisondeath)
{
  write_file("/d/wasser/angrox/zyklopenfels/log/zyklop_kills",
    ctime()+": "+capitalize(getuid(this_player()))+" killt den antiken Wasserzyklop.\n");
  ::die(poisondeath);
}
