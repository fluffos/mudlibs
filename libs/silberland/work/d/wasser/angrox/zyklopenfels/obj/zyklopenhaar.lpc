inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Etwas antikes Wasserzyklopenhaar");
  SetProp(P_LONG, 
   "Das Haar ist blau, reissfest, und wirkt leicht magisch.");
  SetProp(P_VALUE, 20000);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MAGIC,100);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Wasserzyklopenhaar");
  SetProp(P_MATERIAL, ([MAT_FUR:48, MAT_MAGIC:20])); 
  AddId( ({"haar","wasserzyklopenhaar","zyklopenhaar", "\nwzhaar"}));

}
