inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Goblinflossen");
  SetProp(P_LONG, 
   "Du siehst Goblinflossen, damit kannst Du schneller schwimmen!");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MAGIC,100);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NAME,"Goblinflossen");
  SetProp(P_MATERIAL, ([MAT_FUR:100])); 
  AddId( ({"flossen", "goblinflossen", "\nflossi"}));

}


reset(){
  ::reset();
  remove( 0 );
}
