inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../insel.h"
#include <player.h>


void create()
{
   if (!is_clone(this_object())) return;
  ::create();
 
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Strandnaehe");
  SetProp(P_INT_LONG, "Du befindest Dich hier etwas abseits vom "
		 +"Strand, schon ein Stueck im Inneren der Insel. Statt "
		 +"aus Sand besteht der Boden hier aus fester Erde, auf "
		 +"der ein paar duenne Grasbuschen wachsen. Eine leichte "
		 +"Brise weht vom Meer her, der Himmel ist wolkenlos. Es "
		 +"ist warm.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht als stumme Beobachterin am "
		 +"Himmel, waermt Deine Haut. Wahrlich ein schoener Tag.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "IIIIIKS! Du blickst in die Sonne, und "
		   +"ploetzlich tanzen zahlreiche bunte Flecken vor Deinen "
		   +"Augen einen flotten Jive.");

  AddDetail("flecken", "Ja, sie tanzen vor Deinen Augen hin und her. "
		   +"Irgendwie macht Dich das verrueckt.");

  AddDetail("strand", "Der Strand besteht vollkommen aus Sand. Nur "
		   +"ab und zu finden sich einige Muscheln im Sand. Die "
		   +"Brandung des Meeres schlaegt sanft gegen Deine Fuesse.");


  AddDetail("insel", "Gluecklicherweise befindest Du Dich auf ihr, denn "
		   +"sonst muesstest Du hier rumschwimmen.");

  AddDetail(({"grasbuschen", "buschen", "gras"}), "Das Gras, das hier "
		   +"waechst, ist ziemlich ausgetrocknet. Du schliesst daraus, "
		   +"dass es hier wohl nur sehr selten regnet.");
  AddDetail("boden", "Der Boden besteht aus trockender Erde.");
  AddDetail("erde", "Die Erde ist ziemlich ausgetrocknet.");
  AddDetail("meer", "Du blickst ueber das Meer, kannst aber ausser Wasser "
		   +"nichts erkennen.");

  AddDetail(({"wasser","ausblick"}), "Endlose Weiten von Wasser. Du "
		   +"wuenschtest Dir einen anderen Ausblick, denn schoen "
		   +"langsam oedet dich dieser monotone Ausblick an.");

  AddDetail("brandung", "Die Brandung schaeumt lustig.");
  AddDetail("muscheln", "Einige Muscheln liegen am Strand ... Dir gefaellt "
         +"keine einzige, also laesst Du sie liegen.");
  AddDetail("brise",
    "Die Brise ist sehr erfrischend.");
  AddSound(DEFAULT_SOUND, "Das Rauschen des Meeres ist zu hoeren.");
  AddSmell(DEFAULT_SMELL, "Der salzige Geruch des Meeres liegt in "
		  +"der Luft.");
  AddSmell(({"meer", "salz"}), "Riecht wuerzig ... hmmm ... Du atmest tief "
                  +"durch.");
   AddSound("rauschen", "Richtig romantisch ..."); 

    previous_object()->CustomizeObject();
  AddExit("norden", INSEL("insel_r2:"+getuid(TP)));
  AddExit("westen", INSEL("insel_r6:"+getuid(TP)));
  AddExit("sueden", INSEL("insel_r4:"+getuid(TP)));
  AddExit("osten", INSEL("insel_r1:"+getuid(TP)));

}

