inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../insel.h"
#include <player.h>
#include <moving.h>

int seil;

void create()
{
   if (!is_clone(this_object())) return;
  ::create();
  seil=1;

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Am Strand");
  SetProp(P_INT_LONG, "Du befindest Dich auf einem kleinem "
		 +"Strandstueck. Der Strand besteht aus reinweissem "
		 +"Sand, in dem vereinzelt ein paar Muscheln zu sehen "
		 +"sind. Ein grosser Felsblock ragt aus dem Sand. "
		 +"Eine leichte Brise weht vom Meer "
		 +"her, der Himmel ist wolkenlos. Es ist warm.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht als stumme Beobachterin am "
		 +"Himmel, waermt Deine Haut. Wahrlich ein schoener Tag.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("strandstueck", "Da befindest Du Dich.");
  
  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "IIIIIKS! Du blickst in die Sonne, und "
		   +"ploetzlich tanzen zahlreiche bunte Flecken vor Deinen "
		   +"Augen einen flotten Jive.");

  AddDetail("flecken", "Ja, sie tanzen vor Deinen Augen hin und her. "
		   +"Irgendwie macht Dich das verrueckt.");

  AddDetail("strand", "Der Strand besteht vollkommen aus Sand. Nur "
		   +"ab und zu finden sich einige Muscheln im Sand. Die "
		   +"Brandung des Meeres schlaegt sanft gegen Deine Fuesse.");

  AddDetail("brandung", "Sie schlaegt sanft gegen Deine Fuesse und "
		   +"das Wasser schaeumt dabei lustig.");

  AddDetail(({"muschel", "muscheln"}), "Die Muscheln liegen im Sand. "
		   +"Du beschliesst sie liegenzulassen.");
  AddDetail(({"sand", "boden"}), "Der Sand ist reinweiss und feinkoernig ... einfach "
                   +"schoen.");
  AddDetail(({"felsblock", "fels", "block"}), "Der Felsblock ragt aus "
		   +"dem Sand, und es sieht so aus, als sei er mindestens bis "
		   +"Haelfte darin vergraben. Einige Spalten und Ritzen befinden "
		   +"sich im Felsblock.");

  AddDetail(({"ritzen", "spalten"}), "Unzaehlige Spalten und Ritzen "
		   +"durchziehen sie den Felsen. Eine Spalte faellt Dir auf, "
		   +"die gross genug ist, um mit der Hand hineinzugreifen.");

  AddDetail("spalte", "Wer weiss, vielleicht befinden sich unermessliche "
		   +"Schaetze in dieser Spalte? Du solltest mal reingreifen.");

  AddDetail("meer", "Du blickst ueber das Meer, kannst aber ausser Wasser "
		   +"nichts erkennen.");

  AddDetail(({"wasser","ausblick"}), "Endlose Weiten von Wasser. Du "
		   +"wuenschtest Dir einen anderen Ausblick, denn schoen "
		   +"langsam oedet dich dieser monotone Ausblick an.");

  AddCmd(({"greif", "greife"}), "greifen");


  AddSound(DEFAULT_SOUND, "Das Rauschen des Meeres ist zu hoeren.");
  AddSmell(DEFAULT_SMELL, "Der salzige Geruch des Meeres liegt in "
		  +"der Luft.");
  AddSmell(({"meer", "salz"}), "Riecht wuerzig ... hmmm ... Du atmest tief "
                  +"durch.");
   AddSound("rauschen", "Richtig romantisch ..."); 

    previous_object()->CustomizeObject();

  AddExit("suedosten", INSEL("insel_r1:"+getuid(TP)));
  AddExit("westen", INSEL("insel_r5:"+getuid(TP)));
  AddExit("sueden", INSEL("insel_r3:"+getuid(TP)));

}


reset()
{
  seil=1;
  ::reset();
}

greifen(string str)
{
  notify_fail("Greifen - na gut. Aber wo willst Du reingreifen?");
  if(!str) return 0;

  notify_fail("Da kannst Du nicht reingreifen.\n");
  if(str=="in spalte" || str=="spalte")
	{
	  if(!seil)
		{
		  write(BS("Du greifst vorsichtig in die Spalte, tastest "
				  +"darin herum, kannst aber nichts finden.\n"));

		  say(TPN+BS(" greift in eine Spalte am Felsblock, scheint "
				  +"aber nichts zu finden.\n"));
		  return 1;
		}

	  write(BS("Du greifst vorsichtig in die Spalte und tastest "
			  +"vorsichtig darin herum. Als Du etwas ertastest, "
			  +"ziehst Du es heraus: Es handelt sich dabei um ein "
			  +"noch recht gut erhaltenes Seil. Du beschliesst es "
			  +"mitzunehmen.\n"));
	  say(TPN+BS(" greift in eine Spalte am Felsblock, findet etwas "
			  +"Laengliches und schiebt es ein.\n"));


	  seil_nehmen();
	  return 1;
	}

  return 0;

}


seil_nehmen()
{
  object ob;

  ob=CLONEOB(OBJ("seil"));
  ob->move(TP, M_NOCHECK);
  seil=0;

}
