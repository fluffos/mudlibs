#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include "../insel.h"

#define P_VALID_NAME "valid_name"

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, INSEL("") );
  SetProp(P_STD_OBJECT, INSEL("sturmfahrt"));
  SetProp(P_VALID_NAME, ({"sturmfahrt", "insel_r1", "insel_r2", 
             "insel_r3", "insel_r4", "insel_r5", "insel_r6",
             "insel_r7", "insel_r8", "insel_r9", "insel_r10", 
             "insel_r11", "heimfahrt" }) );
}


string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1) &&
      (who==lower_case(who)))
  {
    SetProp(P_STD_OBJECT, INSEL(name));
    return file;
  }
}


int CustomizeObject()
{
  string name,foo, who;
  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d",foo,who)!=2)
    return 0;
  return 1;
}



