inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../insel.h"
#include <player.h>
#include <moving.h>
int axtblatt;

void create()
{
   if (!is_clone(this_object())) return;
  ::create();
  axtblatt=1;

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Eine niedrige Klippe");
  SetProp(P_INT_LONG, "Du bist hier auf einer kleinen Klippe, die vollkommen "
                     +"aus Stein besteht. Unter Dir brechen sich die Wellen "
                     +"an dem Felsen, was ein lustiges Blubbern verursacht. "
                     +"Ein, zwei grosse Steine liegen hier herum. Du kannst von "
                     +"hier aus sehr gut ueber das Meer blicken. Die Sonne hat hier "
                     +"saemtliche Steine aufgewaermt, es ist hier so richtig "
                     +"gemuetlich.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht als stumme Beobachterin am "
		 +"Himmel, waermt Deine Haut. Wahrlich ein schoener Tag.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "IIIIIKS! Du blickst in die Sonne, und "
		   +"ploetzlich tanzen zahlreiche bunte Flecken vor Deinen "
		   +"Augen einen flotten Jive.");

  AddDetail("flecken", "Ja, sie tanzen vor Deinen Augen hin und her. "
		   +"Irgendwie macht Dich das verrueckt.");

  AddDetail(({"klippe", "fels", "felsen"}), "Die Klippe, auf der Du stehst, besteht "
                   +"vollkommen aus einem grauen Fels, der durch die dauernde "
                   +"Sonnenbestrahlung aufgewaermt ist. Einige grosse Steine liegen "
                   +"hier.");

  AddDetail("brandung", "Sie schlaegt gegen die Felsen.");

  
  AddDetail("meer", "Du blickst ueber das Meer, kannst aber ausser Wasser "
		   +"nichts erkennen.");

  AddDetail(({"wasser","ausblick"}), "Endlose Weiten von Wasser. Du "
		   +"wuenschtest Dir einen anderen Ausblick, denn schoen "
		   +"langsam oedet dich dieser monotone Ausblick an.");
  
  AddDetail(({"steinchen", "steine", "stein"}), "Die Steine sind etwa kuerbisgross und "
                   +"liegen hier auf der Klippe herum. Hinter einem Stein siehst Du "
                   +"etwas Metallisches glitzern.");
  AddSpecialDetail(({"glitzern", "metallisches"}), "glitzer");                


  AddSound(DEFAULT_SOUND, "Das Rauschen des Meeres ist zu hoeren. Auch ein lustiges " 
                         +"Blubbern der Brandung ist zu vernehmen.");
  AddSound(({"blubbern", "brandung"}), "BLUBB ... blubbub ... blubblubblub ... Hihi, "
                         +"das klingt lustig.");
  
  AddSmell(DEFAULT_SMELL, "Der salzige Geruch des Meeres liegt in "
		  +"der Luft.");
  AddSound("rauschen", "Richtig romantisch ..."); 
  AddSmell(({"meeres", "meer", "salz"}), "Du atmest mehrmals tief "
		  +"durch und fuehlst Dich danach wie frisch geboren.");

   previous_object()->CustomizeObject();

  AddExit("osten", INSEL("insel_r5:"+getuid(TP)));
  AddExit("sueden", INSEL("insel_r9:"+getuid(TP)));
  AddExit("nordwesten", INSEL("insel_r11:"+getuid(TP)));

}


reset()
{
 axtblatt=1;
 ::reset();
}

glitzer()
{
  object ob;
  if(!axtblatt)
    return BS("Hmm... Du haettest schwoeren koennen, dass hier etwas geglitzert hat...\n");

  ob=CLONEOB(OBJ("axtblatt"));
  ob->move(TP, M_NOCHECK);
  axtblatt=0;
  
  return BS("Du blickst hinter den Stein, und tatsaechlich: Ein riesiges Axtblatt hat "
        +"sich hinter dem Stein versteckt. Du nimmst es an Dich.\n");
}
