inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../insel.h"
#include <player.h>
#include <moving.h>

int schatz;


void create()
{
   if (!is_clone(this_object())) return;
  ::create();
  schatz=1;

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Eine Klippe");
  SetProp(P_INT_LONG, "Du stehst hier auf einer hohen Klippe. Unter Dir "
                     +"brechen sich die Wellen an dem maechtigen Felsen. "
                     +"Von so hoch oben hast Du einen tollen Blick ueber das "
                     +"Meer. Dir faellt auf, dass jemand auf dem Boden ein "
                     +"grosses X gemalt hat@@X_zustand@@");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht als stumme Beobachterin am "
		 +"Himmel, waermt Deine Haut. Wahrlich ein schoener Tag.");
  AddDetail("boden", "Der Boden besteht aus Fels.");
  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "IIIIIKS! Du blickst in die Sonne, und "
		   +"ploetzlich tanzen zahlreiche bunte Flecken vor Deinen "
		   +"Augen einen flotten Jive.");

  AddDetail("flecken", "Ja, sie tanzen vor Deinen Augen hin und her. "
		   +"Irgendwie macht Dich das verrueckt.");

  AddDetail(({"klippe", "fels", "felsen"}), "Die Klippe, auf der Du stehst, besteht "
                   +"vollkommen aus einem grauen Fels, der durch die dauernde "
                   +"Sonnenbestrahlung aufgewaermt ist. Ein karger Busch hat sich "
                   +"auf einem Fleckchen Erde festgesetzt.");
  AddDetail("wellen", "Die Wellen schlagen mit unglaublicher Kraft gegen die "
                   +"Klippen.");
  AddDetail("brandung", "Sie schlaegt gegen die Felsen.");

  AddDetail("erde", "Die Erde ist ziemlich verdorrt. Wie der Busch hier "
                   +"nur ueberleben kann?");

  AddDetail("busch", "Der Busch ist voellig duerr. Wie der hier nur ueberleben "
                   +"kann? "); 

  AddDetail("meer", "Du blickst ueber das Meer, kannst aber ausser Wasser "
		   +"nichts erkennen.");

  AddDetail(({"wasser","ausblick", "blick"}), "Endlose Weiten von Wasser. Du "
		   +"wuenschtest Dir einen anderen Ausblick, denn schoen "
		   +"langsam oedet dich dieser monotone Ausblick an.");
    
  AddCmd(({"wuehle", "wuehl"}), "wuehlen");
  AddSound(DEFAULT_SOUND, "Das Rauschen des Meeres ist zu hoeren.");
  AddSmell(DEFAULT_SMELL, "Der salzige Geruch des Meeres liegt in "
		  +"der Luft.");
  AddSound(({"blubbern", "brandung"}), "BLUBB ... blubbub ... blubblubblub ... Hihi, "
                         +"das klingt lustig.");
  AddSmell(({"meer", "salz"}), "Riecht wuerzig ... hmmm ... Du atmest tief "
                  +"durch.");
  AddSound("rauschen", "Richtig romantisch ...");  

  previous_object()->CustomizeObject();
  AddExit("suedosten", INSEL("insel_r8:"+TPN));
 
}

reset()
{
 ::reset();
 schatz=1;
}


init()
{
::init();
if (!schatz)
  {
   RemoveDetail(({"x", "schatz"}));
   AddDetail(({"loch", "x"}), "Offenbar hat hier jemand nach was gebuddelt.");
  }
else
  { 
  AddDetail("x", "Hmm ... vielleicht ist ja da ein Schatz vergraben. Du koenntest es ja "
              +"mit den Haenden aufwuehlen.");  
  AddDetail("schatz", "Du erbebst vor Vorfreude.");
  RemoveDetail("loch");
  }
}

string X_zustand()
{
 if (!schatz)
   {
   return ". Genau in der Mitte des X ist ein Loch.";
   AddDetail(("loch"), "Offenbar hat hier jemand nach was gebuddelt.");
   }
 return ".";
}

wuehlen(string str) 
{
  int anzahl;
  object ob;
  notify_fail("Was willst du aufwuehlen?\n");
  if(!str) return 0;
  notify_fail("Das kannst Du nicht aufwuehlen.\n");
  if(str=="X auf" || str="x auf")
    {
      if (!schatz)
        {
          write("Aber das X ist ja schon aufgewuehlt!\n");
          return 1;
        }
      anzahl=500+random(1000);
      write (BS("Du beginnst zu wuehlen ... Nach einiger Zeit kannst Du etwas "
            +"Blinkendes erkennen: MUENZEN! Rasch zaehlst du sie nach; es sind "
            +anzahl+ " Stueck, die du rasch einschiebst."));
      say(TPN+BS(" beginnt bei dem X zu wuehlen."));
      schatz_nehmen(anzahl);
      return 1;
      schatz_weg();
     }
  return 0;
}


schatz_nehmen(int anzahl)
  {
    object ob;
    int ret;
    
    ob=CLONEOB("/obj/money");
    ob->SetProp(P_AMOUNT, anzahl);
    ret = ob->move(this_player());
    if (ret == ME_TOO_HEAVY)
    {
      write("Der Schatz ist Dir leider zu schwer.");
      ob->remove();
      return 1;
    }
    else
    {  
     schatz = 0;
     return 1;
    }

  }


schatz_weg()
{
RemoveDetail(({"x", "schatz"}));
   AddDetail(({"loch", "x"}), "Offenbar hat hier jemand nach was gebuddelt.");
}
