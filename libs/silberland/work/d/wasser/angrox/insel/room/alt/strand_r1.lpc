inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../insel.h"
#include <moving.h>
#include <player.h>
int boot_da;

void create()
{
  ::create();
  boot_da=1;
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Ein flacher Strand");
  SetProp(P_INT_LONG, "Du befindest Dich auf einem kleinem, vielleicht 10 Meter "
                 +"breitem Strandstueck, dass auf beiden Seiten von Klippen "
                 +"abgegrenzt wird. Auf dem Sand sind vereinzelt ein paar Muscheln "
                 +"zu sehen. Eine leichte Brise weht vom Meer "
		 +"her, der Himmel ist wolkenlos. @@Boot@@");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht als stumme Beobachterin am "
		 +"Himmel, waermt Deine Haut. Wahrlich ein schoener Tag.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "IIIIIKS! Du blickst in die Sonne, und "
		   +"ploetzlich tanzen zahlreiche bunte Flecken vor Deinen "
		   +"Augen einen flotten Jive.");

  AddDetail("flecken", "Ja, sie tanzen vor Deinen Augen hin und her. "
		   +"Irgendwie macht Dich das verrueckt.");

  AddDetail("strand", "Der Strand besteht vollkommen aus Sand. Nur "
		   +"ab und zu finden sich einige Muscheln im Sand. Die "
		   +"Brandung des Meeres schlaegt sanft gegen Deine Fuesse.");

  AddDetail("brandung", "Sie schlaegt sanft gegen Deine Fuesse. Es "
		   +"ist angenehm.");

  AddDetail(({"muschel", "muscheln"}), "Die Muscheln liegen im Sand. "
		   +"Du beschliesst sie liegenzulassen.");

  AddDetail("brise", "Die frische Brise kuehlt Dein Gesicht.");
  AddDetail("ufer", "Das Meer brandet an das Ufer und spuelt "
                   +"ab und zu kleine Muscheln ans Land.");  

  AddDetail("meer", "Du blickst ueber das Meer, kannst aber ausser Wasser "
		   +"nichts erkennen.");

  AddDetail(({"wasser","ausblick"}), "Endlose Weiten von Wasser. Du "
		   +"wuenschtest Dir einen anderen Ausblick, denn schoen "
		   +"langsam oedet dich dieser monotone Ausblick an.");
  AddDetail("sand", "Der Sand ist reinweiss und feinkoernig ... einfach "
                   +"schoen.");
  AddDetail("klippen", "Die Klippen ragen steil auf ... unmoeglich da "
                  +"hinauf zu klettern.");
  
  AddSound(DEFAULT_SOUND, "Das Rauschen des Meeres ist zu hoeren.");
  AddSmell(DEFAULT_SMELL, "Der salzige Geruch des Meeres liegt in "
		  +"der Luft.");
  AddItem(NPC("alrik"), REFRESH_DESTRUCT);
  AddCmd(({"segle", "segel"}), "segeln"); 
  AddExit("nordwesten", "/d/wasser/woody/fischerdorf/room/weg5");
  
}

init()
{
 ::init();

 AddDetail(({"boot", "segelboot"}), "Ein ganz normales Segelboot. "
                 +"Da es seetuechtig wirkt, bist Du sicher, dass Du "
                 +"mit ihm segeln kannst.");
 AddDetail("spuren", "Die Spuren sehen so aus, als waere ein Boot ins "
                 +"Wasser gezogen worden.");
 if(boot_da)
    RemoveDetail("spuren");
 else
    RemoveDetail(({"boot", "segelboot"}));

}

reset()
{
 ::reset();
 boot_da=1;
}

string Boot()
{
 if (boot_da)
   return "Am Ufer steht ein Segelboot.";
 return "Im Sand befinden sich Spuren.";
}


segeln(string str)
{
 object ob;
 notify_fail("Womit willst Du segeln?\n");
 if(!boot_da) return 0;
 if(str!="mit boot" && str!="mit segelboot") return 0;
 notify_fail("Du hast von niemanden die Erlaubnis, dieses Boot "
           +"zu benutzen, also laesst Du es bleiben.\n");
 if(!(ob=present("erlaubnis", TP))) return 0;
 write(BS("Du schiebst das Boot ins Wasser und setzt Dich rein ...\n"));
 TP->move(INSEL("sturmfahrt:"+TPN), M_GO, "ins Boot und segelt weg","steigt");
 boot_da=0;
 ob->remove();
 RemoveDetail(({"segel", "segelboot"}));
 return 1;
} 


