inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../insel.h"
#include <player.h>

int palmen;

void create()
{
   if (!is_clone(this_object())) return;
  ::create();
  palmen=1;

  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Ein Palmenhain");


  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));

  AddDetail("himmel", "Der wolkenlose Himmel erstrahlt in einem "
		 +"satten Blau, die Sonne steht als stumme Beobachterin am "
		 +"Himmel, waermt Deine Haut. Wahrlich ein schoener Tag.");

  AddDetail("blau", "So richtig koenigsblau, eine schoene Farbe.");

  AddDetail("koenigsblau", "Ja, ja. Blau!");

  AddDetail("farbe", "Der Himmel ist blau.");

  AddDetail("sonne", "IIIIIKS! Du blickst in die Sonne, und "
		   +"ploetzlich tanzen zahlreiche bunte Flecken vor Deinen "
		   +"Augen einen flotten Jive.");

  AddDetail("flecken", "Ja, sie tanzen vor Deinen Augen hin und her. "
		   +"Irgendwie macht Dich das verrueckt.");
  AddDetail("holz", "Vielleicht schwimmt es ja?");
  AddDetail("boden", "Der Boden besteht aus trockener Erde.");
  AddDetail("erde", "Ziemlich ausgetrocknet...");
  AddDetail("meer", "Du blickst ueber das Meer, kannst aber ausser Wasser "
		   +"nichts erkennen.");
  AddDetail("anhoehe", "Du stehst drauf.");
  AddSound(DEFAULT_SOUND, "Das Rauschen des Meeres ist zu hoeren.");
  AddSmell(DEFAULT_SMELL, "Der salzige Geruch des Meeres liegt in "
		  +"der Luft.");
  AddSmell(({"meer", "salz"}), "Riecht wuerzig ... hmmm ... Du atmest tief "
                  +"durch.");
   AddSound("rauschen", "Richtig romantisch ..."); 
  AddCmd ("faelle", "palmen_faellen");

   previous_object()->CustomizeObject();

  AddExit("norden", INSEL("insel_r5:"+getuid(TP)));
  AddExit("osten", INSEL("insel_r3:"+getuid(TP)));
  AddExit("westen", INSEL("insel_r9:"+getuid(TP)));
  AddExit("sueden", INSEL("insel_r7:"+getuid(TP)));

}


init()
{
::init();

if (!palmen)
 {
   SetProp(P_INT_LONG, "Du befindest Dich hier auf einer kleinen "
		  +"Anhoehe, auf der einmal sieben Palmen gestanden haben. "
		  +"Allerdings sind jetzt nur mehr die Stuempfe der Palmen "
		  +"zu sehen. Allerlei abgehackte Palmwedel und Holzspaene "
		  +"liegen am Boden. Von hier aus hat man auch einen schoenen "
		  +"Blick ueber das Meer. Die Sonne brennt hier umbarmherzig "
		  +"herunter. Das Rauschen des Meeres ist selbst hier noch "
		  +"zu hoeren.");

   AddDetail("palmen", "Offenbar wurden sie abgeholzt.");

   AddDetail("stuempfe", "Diese Stuempfe zeugen davon, dass hier "
		  +"einmal Palmen gestanden haben. Neben den Stuempfen "
		  +"liegen viele Holzspaene.");

   AddDetail(({"spaene", "holzspaene"}), "Die Groesse dieser Spaene "
		  +"lassen darauf schliessen, dass die Palmen mit einer Axt "
		  +"gefaellt wurden.");

   AddDetail("palmwedel", "Die Palmwedel sind riesengross und schoen. "
		  +"Sie wurden wohl von den Palmen entfernt, als diese gefaellt "
		  +"wurden.");
     
 }

else
 {
   SetProp(P_INT_LONG, "Du befindest Dich hier auf einer kleinen "
		  +"Anhoehe, auf der sieben Palmen stehen. "
		  +"Von hier aus hat man auch einen schoenen "
		  +"Blick ueber das Meer. Die Sonne brennt hier umbarmherzig "
		  +"herunter. Das Rauschen des Meeres ist selbst hier noch zu "
		  +"hoeren.");

   AddDetail("palmen", "Diese wunderschoene Palmen ragen hoch in den "
		  +"Himmel. Leider befinden sich keine Kokusnuesse an ihnen. "
		  +"Wenn Du eine Holzfaelleraxt haettest, dann koenntest Du diese "
		  +"Palmen wohl faellen.");
   RemoveDetail(({"stuempfe", "spaene", "holzspaene", "palmwedel"}));

 }
}



reset()
{
  palmen=1;
  ::reset();
}


palmen_faellen(string str)
{
  int i;
  notify_fail("Was willst Du denn faellen?\n");
  if (!str) return 0;

  notify_fail("Du hast leider keine Holzfaelleraxt dabei.\n");
  if(!present("holzfaelleraxt", TP)) return 0;

  notify_fail("Das kannst Du nicht faellen.\n");
  if(str=="palme" || str=="palmen")
	{
	  if(!palmen)
		{
		  write(BS("Du zueckst die Axt, holst aus ... aber ... "
				  +"Moment mal ... da sind ja gar keine Palmen "
				  +"mehr ... oops ... peinlich.\nDu erroetest.\n"));

		  say(TPN+BS("zueckt eine Axt, schaut sich um und erroetet.\n"));

		  return 1;
		}

	  write(BS("Du nimmst die Holzfaelleraxt und beginnst die Palmen "
			  +"zu faellen. Nach einiger Zeit hast Du die sieben Palmen "
			  +"geschlagen. Du hackst noch alle Palmwedel ab. Schliesslich "
			  +"liegen die Palmenstaemme vor Dir.\n"));
	  say(TPN+BS(" zueckt eine Axt und faellt alle sieben Palmen.\n"));
        
	  for (i=1;i<=7;i++)
	         AddItem(OBJ("palmenstamm"));

	  palmen=0;
	  return 1;
	}

  return 0;

}


