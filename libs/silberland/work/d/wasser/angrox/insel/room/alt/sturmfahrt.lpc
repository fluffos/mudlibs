inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../insel.h"
#include <moving.h>
#include <player.h>

int gebiet,i, zurueck,fisch, segeln;
object room;
void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  i=0;
  segeln=1;
  gebiet=0;
  zurueck=0;
  fisch=0;
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Auf See");
  SetProp(P_INT_LONG, "Du befindest Dich in einem kleinen Segelboot. "
		   +"Es besteht aus lauter kleinen, niedlichen Holzplanken, die "
		   +"gut gegen Wassereintritt abgesichert sind. Der Wind blaest "
		   +"kraeftig in die Segel, und du kommst gut voran.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));

  AddDetail("boden", "Der Boden des Bootes besteht aus Holzplanken.");
  AddDetail(({"boot", "segelboot"}), "Ein kleines, schnittiges "
		   +"Segelboot, in dem Du da sitzt. Das reinweisse Segel, "
		   +"welches am Masten befestigt ist, treibt das kleine "
		   +"Boot schnell vorran.");
  AddDetail("mast", "Der Mast besteht ebenfalls aus Holz. Mit "
		   +"mehreren Seilen ist ein reinweisses Segel daran "
		   +"befestigt.");
  AddDetail("segel", "Das reinweisse Segel bauscht im Wind. Es "
		   +"ist am Mast befestigt.");
  AddDetail("seil", "Das Segel ist mit diesen Seilen an dem Masten "
		   +"befestigt.");
  AddDetail(({"planken", "holzplanken"}), "Die Holzplanken bilden "
		   +"den Schiffskoerper. Sie bestehen - wie der Name schon "
		   +"sagt - aus Holz.");
  AddDetail("meer", "Das Meer liegt ruhig da, nur leicht kraueselt "
                   +"sich das Wasser im Wind.");
  AddDetail("wolken", "Die sind weit weg... kein Grund zur Sorge.");
  AddDetail("himmel", "Der Himmel ist strahlend blau, nur weit entfernt "
                   +"sind dunkle Wolken zu sehen.");
  AddDetail("wind", "Du spuerst ihn, siehst ihn aber nicht.");
  AddDetail("koerper", "Welchen meinst Du jetzt *dreckigkicher*");
  AddDetail("schiffskoerper", "Der Schiffskoerper besteht aus Holzplanken.");  
  AddDetail("holz", "Das Holz sieht noch SEHR stabil aus.");
  AddDetail("wasser",
       "Das Wasser des Meeres ist dunkelblau..."); 
  AddDetail("stelle",
       "Naja, Du koennest es ja mal porbieren...");
  AddCmd(({"angle", "angel"}), "angeln");
  AddCmd(({"segel", "segle"}), "segeln");
  previous_object()->CustomizeObject();
}

void init()
 {
   ::init();
   room=environment(this_player());
   if (query_once_interactive(this_player()))
	call_out("story1", 2,0);
 }



segeln(string str)
{
 notify_fail("Das machst Du ja schon.\n");
 if(segeln) return 0;
 notify_fail("WOHIN willst du segeln?\n");
 if(!str) return 0;
 notify_fail("Das geht nicht.\n");
 if(str!="zurueck" && str!="weiter") return 0;

 if(gebiet>=4 && !zurueck) return 0;
 
 if((str=="zurueck") && zurueck)
  {
    segeln=1;
    write(BS("Na gut... ohne Angel kannst ja eh nix machen, also "
            +"segelst Du zurueck zum Ufer..."));
    gebiet=0;
    zurueck=0;
    TP->move(INSEL("strand_r1"), M_GO, "geht an Land", "kommt mit einem Boot an und geht an Land.");
  }
 if(str=="weiter")
  {
   segeln=1;
   call_out("story4",2,1);
   return 1; 
  }
 segeln=0;
 return 0;
}


angeln(string str)
{
 notify_fail(BS("Oje! Du hast keine Angel dabei ... Vielleicht solltest Du zurueckfahren, " 
               +"und zwar mit 'segle zurueck'.\n"));
 if(!present("angel", TP))
   {
    zurueck=1;
    return 0;
   }
 notify_fail("Mit WAS willst Du angeln?\n");
 if(str!="mit angel")  return 0;
 notify_fail("Hier kannst Du nicht angeln!\n");
 if(gebiet<=0) return 0;
 switch(gebiet)
  {
   case 1: gebiet1();
           break;
   case 2: gebiet2();
           break;
   case 3: gebiet3();
           break;
   default: return 0;
  }
 return 1;
}

gebiet1()
{
 segeln=0;
 write(BS("Du wirfst die Angel aus und wartest ...\n"));
 write(BS("Lange Zeit passiert nichts...offenbar ist hier nicht "
         +"das richtige Gebiet ... mit 'segle weiter' kannst Du "
         +"Dir ein anderes Gebiet suchen...\n"));
}

gebiet2()
{
 object ob;
 segeln=0;
 if (!fisch)
  {
    write("Du wirfst die Angel aus ...\n");
    write(BS("Als etwas an deiner Angel zappelt, holst Du es heraus ..."
         +"es ist ein Hering...\n"));
    ob=CLONEOB(OBJ("hering"));
    ob->move(TP, M_NOCHECK);
    fisch=1;
  }
 else
  {
      write(BS("Du wirfst die Angel aus ... und faengst nichts ...\n"));
  } 
}

gebiet3()
{

 write(BS("Du wirfst die Angel aus und wartest ...\n"));
 gebiet=0;
 call_out("story5", 4, 1);
}



story1()
{
  if (environment(this_player()) != this_object()) return;
  write(BS("Du beginnst zu segeln. Zuerst stellst Du Dich ein bisschen "
	   +"ungeschickt an, aber dann beherrscht du es schon relativ "
	   +"gut. Du beginnst aufs offene Meer hinaus zu segeln.\n"
	   +"Du segelst...\n"));
  if(present(TP, room)) call_out("story2", 5, 0);
}

story2()
{
  if (environment(this_player()) != this_object()) return;
 write ("...und segelst...\n");
 i++;
 if(i<4)
   {
   if(present(TP, room)) call_out("story2", 3, 1);
   }
 else
   call_out("story3", 5, 1);
}

story3()
{
  if (environment(this_player()) != this_object()) return;
  gebiet++;
  write (BS("Schliesslich scheinst Du eine gute Stelle gefunden zu "
		+"haben, wo es sich lohnt, mit der Angel zu angeln.\n"));
  segeln=0;
  i=0;
  fisch=0;
 
}

story4()
{
  if (environment(this_player()) != this_object()) return;
  write("Du segelst weiter...\n");
  if(present(TP, room)) call_out("story4_1", 3, 1);
}

story4_1()
{
  if (environment(this_player()) != this_object()) return;
 write ("...und segelst...\n");
 i++;
 if(i<3)
   {
   if(present(TP, room)) call_out("story4_1", 3, 1);
   }
 else
   if(present(TP, room)) call_out("story3", 3, 1);

}
story5()
{
  object ob;
  if (environment(this_player()) != this_object()) return;
  write(BS("Nach einiger Zeit gelingt es Dir, einen der beruehmten "
	   +"kleinen Silberhaie zu fangen. Du holst den Fisch an Bord "
	   +"und betrachtest ihn: Es ist ein vielleicht 30cm grosser "
	   +"Hai, dessen Haut silbern schimmert.\nDu packst ihn weg und "
	   +"beginnst zurueckzusegeln.\n"));
  ob=CLONEOB(OBJ("silberhai"));
  ob->move(TP, M_NOCHECK);
  if(present(TP, room)) call_out("story6", 7, 1);
}

story6()
{
  if (environment(this_player()) != this_object()) return;
 write(BS("\nDu segelst Richtung Kueste ... dunkle Wolken ziehen "
		 +"auf...\n"));
 RemoveDetail(({"meer", "wolken", "himmel"})); 
 AddDetail("meer", "Das Meer liegt fast ruhig da, allerdings "
                 +"kraeuselt der Wind das Wasser bereits.");
 AddDetail("wolken", "Huch! Die Wolken sind schon SEHR nah.");
 AddDetail("himmel", "Dunkle Wolken ziehen auf.");
  
 if(present(TP, room)) call_out("story7", 5, 1);
}

story7()
{
  if (environment(this_player()) != this_object()) return;
 write("\Ein starker Wind kommt auf...\n");
 RemoveDetail("wind");
 AddDetail("wind", "Der Wind blaest stark.");
 if(present(TP, room)) call_out("story8",5,1);
}

story8()
{
  if (environment(this_player()) != this_object()) return;
 write(BS("Es beginnt zu regnen, immer staerker, die See wird "
		 +"unruhig...\n"));
 RemoveDetail(({"meer", "wolken", "himmel"}));
 AddDetail("meer", "Das Meer liegt ruhig da, nur leicht kraueselt "
                   +"sich das Wasser im Wind.");
 AddDetail("wolken", "Der ganze Himmel ist bewoelkt, und es regnet!");
 AddDetail("himmel", "Es regnet in Stroemen.");
 
 if(present(TP, room)) call_out("story9",5,1);
}

story9()
{
  if (environment(this_player()) != this_object()) return;
 write(BS("\nDie Wellen werden immer hoeher. Es gelingt Dir nur "
	  +"mehr sehr schwer, dass Boot auf Kurs zu halten, ja, "
	  +"ueberhaupt dafuer zu sorgen, dass es nicht kentert.\n"));
 AddDetail("wellen", "Sie sind fast haushoch.");
 if(present(TP, room)) call_out("story10", 2, 1);
}


story10()
{
  if (environment(this_player()) != this_object()) return;
 write(BS("\nDoch da ist es schon zu spaet ... Das Boot bekommt "
	  +"Schlagseite... Du schlaegst Dir den Kopf... Schwaerze ...\n"));
 gebiet=0;
 if(present(TP, room)) call_out("story_end", 2, 1);
}


story_end()
{
  if (environment(this_player()) != this_object()) return;
 write(BS("\nLangsam erwachst Du wieder ... Deine Augen oeffnen sich ... "
	  +"Du spuerst etwas Weiches unter Dir ... Du bist...\n"));
 if(present(TP, room)) call_out("teleportieren",2,1);
}

teleportieren()
{
 TP->move(INSEL("insel_r1:"+TPN), M_GO, "geht unter");
}
