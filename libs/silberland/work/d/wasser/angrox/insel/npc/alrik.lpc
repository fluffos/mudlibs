inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <new_skills.h>
#include "../insel.h"
#include "../inselquest.h"
#include <defines.h>
#include <moredef.h>

#define BSA(x,y) break_string(x,78,y)


void create()
{
  if (!is_clone(this_object())) return;  // (return on BP)
  ::create();
  AddId (({"alrik", "fischer"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_RACE, "Mensch");
  SetProp (P_NAME, "Alrik");
  SetProp (P_SHORT, "Alrik, der Fischer");
  SetProp (P_ARTICLE, 0);
  SetProp (P_LONG,BS("Alrik sieht wie ein gewoehnlicher Fischer aus: Ein "
            "wettergegerbtes Gesicht, eine Pfeife im Mund. Er sieht recht "
            "aufgeloest aus...und staendig brummelt er in seinen "
            "(nichtvorhandenen) Bart hinein.\n"));

  create_default_npc(10);
  SetProp (P_ALIGN, 200);
//  SetProp (P_XP, 250000); deaktiviert, a questnpc soll ja nicht 5 fache 
//  Xp geben..  Feyaria.
  SetProp (P_BODY, 80);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit Fischerhaenden", 130, DT_BLUDGEON}) );
  SetProp (P_LOG_INFO, LOGFILE);
  set_living_name( "alrik" );
 
  SetProp(P_SPELLRATE,20);
  AddSpell(1,100,
	"Alrik wirft einen Fisch nach Dir.\n",
	"Alrik wirft einen Fisch nach @WEN.\n",
        DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SetProp (P_DIE_MSG,
	" stirbt wie ein Fisch an Land.\n");

  SetProp (P_DEFAULT_INFO,
	"brummelt was von einer Wette.\n");

  SetChats(5, ({
	"Alrik rennt aufgeregt umher.\n",
	"Alrik jammert: Die Wette, die Wette ... ach...\n",
	"Alrik seufzt.\n"}) );

  AddInfo (({"angrox","schoepfer"}),
	"sagt: \"Angrox ist mein Schoepfer!\"\n");
  
  AddInfo (({"dusty", "woody", "feyaria"}),
        "Kenn' ich net. Will ich auch net kennen.", "erklaert entschlossen: ");

  AddInfo (({"name","alrik"}),
	"Mein Name ist Alrik. Ich bin Fischer.", "sagt: ");

  AddInfo("berx", "Der ist in Ordnung!", "sagt: ");  


  AddInfo ( ({"aufgabe", "beruf" }),
	"Als Fischer fange ich Fische.","sagt: " );
  AddInfo("fische", "Mit Fischen verdiene ich mein Geld.", "sagt: ");
  AddInfo("geld", "Ach ja ... wenn ich nur mehr davon haette.", "seufzt: ");

  AddInfo("wette", "Mit dem Angler auf dem Pier habe ich eine Wette "
             +"abgeschlossen. Er glaubt mir nicht, dass ich die Gruende "
             +"der legendaeren Silberhaie finde und einen fange. Ach ... "
             +"ich habe schon ueberall gesucht, aber nichts gefunden. "
             +"Wenn mir nur jemand seine Hilfe anbieten wuerde.", "jammert: ");

  AddInfo("angler", "Der Bursche ist gerissen... Haett' ich mir nur nicht "
             +"auf diese Wette mit ihm eingelassen.", "sagt: ");

  AddInfo("schuppen", "Es heisst, sie haben magische Eigenschaften.", "fluestert leise: ");
  AddInfo("eigenschaften", "Darueber weiss ich leider nichts genaueres.", "sagt: ");

  AddInfo(({"hai", "silberhai", "silberhaie"}), "Der Silberhai ist eine kleine, etwa "
             +"30 cm kleine Haiart, die besonders durch ihre silberfarbenen "
             +"Schuppen auffaellt. Sie sind auesserst selten und hochbegehrt.", "schwaermt: ");
  AddInfo("hilfe", "@@aufgabe@@\n", "sagt: ");

  AddInfo("gruende", "Tja, leider weiss ich nicht, wo sich die Gruende der "
             +"Silberhaie befinden. Wenn mir nur jemand helfen koennte...", "seufzt: ");

  AddInfo(({"boot", "segelboot"}), 
          "Das gehoert mir. Ich brauche es.", "sagt: ");
 }




string aufgabe ()
{
  object ob;
  object erl,quest;
  if(!TP) {
    return "Fehler *biep*";
  }
  erl=present("\nerlaubnis", TP);
  quest=present("\nalrikquest", TP);

  if(erl && quest)
    return "Ja, Du hilfst mir bereits. Hast Du den Fisch schon?";
  
  if(!erl) {
     ob=CLONEOB(OBJ("erlaubnis.lpc"));
     ob->move(TP, M_NOCHECK);
  }
  if (!quest) {
     ob = clone_object (OBJ("quest.lpc"));
     ob->move(TP, M_NOCHECK);
  }
  if (!present("angel", TP)) {
    ob=CLONEOB("/p/weapon/spear/angel");
    ob->move(TP, M_NOCHECK);
  }
  return
    "Du wuerdest mit helfen? Du muesstest mit diesem Segelboot hier "
    "aufs Meer fahren, einen solchen Silberhai angeln und ihn zu mir "
    "bringen ... du hast meine Erlaubnis, dieses Boot zu benutzen... "
    "Ich hoffe Du schaffst es. Hier, nimm noch diese Angel, damit du auch "
    "was zum Fangen des Haies hast.";

}
 


give_notify(object obj)
{
   int q;  
   object ob, next;
   string *cloner_string;
   if (obj->id("silberhai"))
   {
     if (!(ob=present("\nalrikquest",TP)))
     {
       tell_room(environment(),
         break_string( "Nanu? Ich hab' Dich ja gar nicht gebeten, "
            "mir einen solchen Fisch zu bringen. Naja, ich werf' "
            "ihn ins Meer zurueck.", 78, "Alrik staunt: "));
       obj->remove();
        return ::give_notify(obj);
     }
     cloner_string=explode(obj->QueryProp(P_CLONER), ":");
     if(!obj->QueryProp("no_cloner_check_for_hai") && !obj->QueryAllowed() && 
         (sizeof(cloner_string) < 2 || 
           cloner_string[1]!=getuid(TP)))
     {
       tell_room(ENV(ME),
         BSA( "Ich glaube nicht das Du selber diesen Fisch "
           "gefangen hast. Damit kann ich meine Wette nicht gewinnen. "
           "Naja, ich werfe den Hai ins Meer zurueck.", "Alrik seufzt: "));
       obj->remove();
       return ::give_notify(obj);
     }


     q = TP->GiveQuest(ANGROXINSELQUEST);
     if (q == 1)
     {
       tell_room(environment(),
         "Alrik sagt: JA! Ein Silberhai! Tatsaechlich, Du hast es "
        +"geschafft. Jetzt hab ich meine Wette doch noch gewonnen. "
        +"Hab' vielen Dank!\nAlrik knuddelt Dich.\n");
         write_file (ANGROXINSELQUESTLOG,
         sprintf ("%s  %s hat Alrik geholfen, seine Wette zu gewinnen.\n",
         dtime(time()), capitalize(TP->query_real_name())));
     }
     else
       if (q != -1)
         return
         write (sprintf("Unbekannter Fehler, bitte den zustaendigen Magier "+
         "verstaendigen!\nFehlercode: %d\n", q)), 1;
       
     write(BS("Alrik geht eilig fort.\n"));
     ob=present("\nalrikquest", TP);
     ob->remove();
     obj->remove();
     ME->remove();
   }
   else
     return ::give_notify(obj);
}



