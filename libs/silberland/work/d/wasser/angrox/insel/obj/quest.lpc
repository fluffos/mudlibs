inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../insel.h"


void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"\nalrikquest", "\nquest"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, "QuestItem");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 0);
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
}

void init()
{
  ::init();
  if(environment() && present("\nalrikquest 2", environment()))
    call_out("remove", 0);
}
