inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("floss");
  SetProp (P_SHORT, "Ein primitives Floss mit Mast");
  SetProp (P_LONG, bs(
           "Dieses Floss hat zwar nun einen Masten, doch es fehlt immer noch "
          +"ein Segel. Wenn Du es am Mast befestigst, dann kannst Du endlich "
          +"starten...\n"));
  SetProp (P_NAME, "Floss");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 300000);
  SetProp (P_VALUE, 1);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MATERIAL, MAT_WOOD);
  AddDetail("mast", "Der Mast ist aus einem der Palmenstaemme.");
 
}


