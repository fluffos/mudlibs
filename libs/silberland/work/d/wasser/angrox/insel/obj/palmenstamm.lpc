inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"palmenstamm", "stamm"}));
  SetProp (P_SHORT, "Ein abgeholzter Palmenstamm");
  SetProp (P_LONG, bs(
           "Dieser Stamm gehoerte mal zu einer praechtigen Palme. Jetzt ist er "
          +"nur mehr ein Stueck Holz, dass sicherlich sehr gut schwimmt.\n"));
  SetProp (P_NAME, "Palmenstamm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 6000);
  SetProp (P_VALUE, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_WOOD);
 
}



