inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"segel", "\nsegel"}));
  SetProp (P_SHORT, "Ein geflicktes Segel");
  SetProp (P_LONG, "Dieses geflickte Segel ist durchaus noch einsetzbar...");
  SetProp (P_NAME, "geflicktes Segel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 20);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  
  SetProp (P_MATERIAL, MAT_CLOTH);
 
}
