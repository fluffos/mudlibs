inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"stiel", "holzstiel", "axtstiel"}));
  SetProp (P_SHORT, "Ein Holzstiel");
  SetProp (P_LONG, bs(
           "Dieser Holzstiel sieht aus, als wuerde er zu einer Axt gehoeren.\n"));
  SetProp (P_NAME, "Holzstiel");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MATERIAL, MAT_WOOD);
 
}
