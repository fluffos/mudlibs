inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("floss");
  SetProp (P_SHORT, "Ein primitives Floss");
  SetProp (P_LONG, bs(
           "Diesem Floss fehlen Mast und Segel. Wenn Du damit hier "
          +"wegkommen willst, dann musst Du noch einen Palmenstamm "
          +"als Mast befestigen.\n"));
  SetProp (P_NAME, "Floss");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 300000);
  SetProp (P_VALUE, 1);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MATERIAL, MAT_WOOD);
 
}


