inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"hissen", "\nhissen"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, "Hissen");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 0);
  SetProp (P_NEVERDROP, 1);

  AddCmd(({"hisse", "hiss"}), "hissen");

}

hissen(string str)
{
 object ob;
 notify_fail("Also, irgendwas stimmt nicht ...\n");
 if(!(ob=present("floss", environment(TP)))) return 0;
 notify_fail("Was willst Du hissen?\n");
 if(str!="segel") return 0;
 write(BS("Du besteigtst das Floss - es scheint Dich zu "
		 +"tragen - und hisst das Segel, ein wie von den "
		 +"Goettern gesandter Windstoss blaest in die Segel "
		 +", dass Floss setzt sich in Bewegung, in Richtung "
		 +"Festland ..."));
 say(TPN+BS("steigt auf das Floss, hisst die Segel und segelt "
		 +"davon.\n"));
 ob->remove();
 TP->move(INSEL("heimfahrt"), M_GO, "das Floss und segelt weg",
                                    "besteigt");
 ME->remove();
 return 1;
}
