inherit "std/weapon";

#include <properties.h>     
#include <combat.h>         		
#include <language.h>      
#include "../insel.h"


create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId (({"axt", "holzfaelleraxt", "\nholzfaelleraxt"}));    
  SetProp (P_SHORT, "Eine Holzfaelleraxt");   
  
  SetProp (P_LONG, BS("Mit dieser Holzfaelleraxt lassen sich gewiss "
                   +"maechtige Baeume faellen.\n"));
 
                   
  SetProp (P_NAME, "Holzfaelleraxt"); 
  SetProp (P_GENDER, FEMALE);   
  SetProp (P_WC, 100);
  SetProp (P_VALUE, 600);    
  SetProp (P_WEIGHT, 1750);   
  SetProp (P_WEAPON_TYPE, WT_AXE); 
  SetProp (P_DAM_TYPE, DT_SLASH);   
  SetProp (P_NR_HANDS, 2);  
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, ({MAT_IRON, MAT_WOOD}));  
}



