/*
** Ein roter Hering :)
** 09.12.1996 Angrox@SL
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../insel.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId("hering");
  SetProp (P_SHORT, "Ein roter Hering");
  SetProp (P_LONG, "Ein ganz normaler roter Hering. Du kannst ihn "
                +"essen...");
  
  SetProp (P_NAME, "Hering");
  SetProp (P_NAME_ADJ, "rot");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 500);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_INFO, bs("Der Hering wird Dich ganz sicher staerken."));
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:20, F_SOAK:10, F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Hmmm ... Sushi ... lecker.\n");
  say (TPN+" verspeist einen roten Hering.\n");
  return ::BeimEssen();
}
