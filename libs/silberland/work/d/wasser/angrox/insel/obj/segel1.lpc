/*
** Ein zerfetztes Segel
** 25-11-1996 Angrox@SL
**
** */


inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("segel");
  SetProp (P_SHORT, "Ein zerfetztes Segel");
  SetProp (P_LONG, "Dieses Segel ist voellig zerfetzt. Etliche Risse machen es "
                 "unbrauchbar. Aber wenn es geflickt wuerde ...");
  SetProp (P_NAME, "zerfetztes Segel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 20);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  
  SetProp (P_MATERIAL, MAT_CLOTH);
 
}
