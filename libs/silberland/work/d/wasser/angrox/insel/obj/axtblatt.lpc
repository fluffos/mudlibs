inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"axtblatt", "blatt"}));
  SetProp (P_SHORT, "Ein Axtblatt");
  SetProp (P_LONG, bs(
           "Das ist ein riesiges Axtblatt, so wie es wohl zu einer "
          +"Holzfaelleraxt gehoert. Wenn Du einen Stiel hattest, dann "
          +"koenntest Du ihn wohl anstecken und haettest eine "
          +"funktionstuechtige Holzfaelleraxt."));

  SetProp (P_NAME, "Axtblatt");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 400);
  SetProp (P_VALUE, 90);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  
  SetProp (P_MATERIAL, MAT_METAL);
  AddCmd(({"steck", "stecke"}), "stecke");
}

stecke (string str)
{
 object ob;
  notify_fail("Was willst Du woran stecken?\n");
  if(!str) return 0; 
  notify_fail("Das geht nicht!\n");
  if (str=="stiel an axtblatt" || str=="holzstiel an axtblatt"
      || str=="stiel an blatt" || str=="holzstiel an blatt"
      || str=="stiel in axtblatt" || str=="holzstiel in axtblatt"
      || str=="stiel in blatt" || str=="holzstiel in blatt"
      || str=="axtblatt an holzstiel" || str=="blatt an stiel") 
    {
     if ((ob=present("stiel", TP)))
       { 
         ob->remove();
         ob=CLONEOB(OBJ("holzfaelleraxt"));
         ob->move(TP, M_NOCHECK);
         write(BS("Du nimmst den Stiel und steckst ihn in das Axtblatt.\n"));
         say(TPN+BS(" steckt einen Holzstiel in ein Axtblatt."));
         ME->remove();
         return 1;
       }
     write(BS("Du hast keinen Holzstiel.\n"));
     return 1;
    }
 return 0; 
}
