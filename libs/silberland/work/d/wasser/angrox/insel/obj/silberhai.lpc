/*
** Der Silberhai
** 09.12.1996 Angrox@SL
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../insel.h"
#include <defines.h>
#include <moredef.h>

nosave int heal;
nosave string owner;
nosave int allowed=0;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  owner="";
  AddId(({"hai", "silberhai"}));
  SetProp (P_SHORT, "Ein Silberhai");
  SetProp (P_LONG, "Der Silberhai ist tatsaechlich nur ca. 30 cm lang. "
             +"Seine Schuppen scheinen aus reinem Silber zu bestehen. Er "
             +"sieht sehr lecker aus. Du bist sicher, dass er Dir sehr "
             +"gut schmecken wuerde...");
  
  SetProp (P_NAME, "Silberhai");
  SetProp (P_GENDER, MALE);
  AddId ("Silberhai");
  SetProp (P_VALUE, 1000);
  SetProp (P_WEIGHT, 300);
  SetProp (P_NOBUY, 1);
  SetProp (P_INFO, bs("Der Hai wird Dich ganz sicherlich staerken, wenn Du "
            +"ihn essen wuerdest."));
  SetProp (P_MATERIAL, MAT_FOOD);
  heal=20+random(50);
  SetProp (P_FOOD_INFO, ([F_HEAL:heal, F_SOAK:10, F_ALCOHOL:0,
F_POISON:0]));
}

BeimEssen()
{
  write ("Hmmm ... Sushi ... lecker.\n");
  say (TPN+" verspeist einen rohen Silberhai.\n");
  return ::BeimEssen();
}

varargs int move(mixed dest, int method,
                 string dir, string textout, string textin)
{
  object env;

  env = ENV(TO);

  if(owner == "" && objectp(dest) && interactive(dest))
  {
    owner == getuuid(dest);
  }

  if(objectp(env) && 
      interactive(env) && 
      objectp(dest) && 
      owner == getuuid(env) && 
      !dest->id("anvar") &&
      explode(file_name(dest), "#")[0][0..21] != 
              "/d/wasser/angrox/insel/npc/alrik")
  {
    heal-=random(20);
    if(heal < 1) {
      tell_object(env, BS("Schnell beisst Du noch ein Stueckchen Hai heraus. "
            "Oops jetzt hast Du alles gegessen."));
      tell_room(ENV(env),BS(env->Name()+" beisst noch schnell ein Stueckchen aus "
          "dem Silberhai heraus. Huch. Nun ist der Silberhai weg."), ({ env }) );
      call_out("remove", 0);
      return 0;

    }
    tell_object(env, BS("Schnell beisst Du noch ein Stueckchen Hai heraus."));
    tell_room(ENV(env),BS(env->Name()+" beisst noch schnell ein Stueckchen aus "
          "dem Silberhai heraus."), ({ env }) );
    SetProp (P_FOOD_INFO, ([F_HEAL:heal, F_SOAK:10, F_ALCOHOL:0,
             F_POISON:0]));
  }

  return ::move(dest,method,dir,textout,textin);
}


void init()
{
  object pl;

  ::init();

  if(owner == "" && objectp(pl = ENV(TO)) && interactive(pl))
  {
    owner = getuuid(pl);
    return;
  }
}

int SetAllowed() {
  allowed=1;
  return 1;
}

int QueryAllowed() {
  return allowed;
}
