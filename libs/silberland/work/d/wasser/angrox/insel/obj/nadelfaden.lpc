inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId (({"nadel", "faden", "\nnadel_und_faden"}));
  SetProp (P_SHORT, "Nadel und Faden");
  SetProp (P_LONG, bs(
           "Eine ganz normale Nadel und ein ganz normaler Faden. Damit kann "
           +"man was flicken.\n"));
  SetProp (P_NAME, "Nadel und Faden");
  SetProp (P_ARTICLE, 0);
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 20);
  SetProp (P_VALUE, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  
  SetProp (P_MATERIAL, ({MAT_CLOTH, MAT_HORN}));
  AddCmd(({"flick", "flicke"}), "flicke");
}

flicke (string str)
{
 object ob;
  notify_fail("Was willst Du denn flicken?\n");
  if(!str) return 0; 
  notify_fail("Das kannst Du nicht flicken.\n");
  if (str!="segel") return 0; 
  notify_fail("Das hast Du ja gar nicht!\n");
  if (ob=present("segel", TP))
    {
     ob->remove();
     ob=CLONEOB(OBJ("segel"));
     ob->move(TP, M_NOCHECK);
     write(BS("Du nimmst Nadel und Faden und flickst das Segel zusammen.\n"));
     say(TPN+BS(" nimmt Nadel und Faden und flickt ein kaputtes Segel zusammen."));
     ME->remove();
     return 1;
   }
 return 0; 
}
