inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"erlaubnis", "\nerlaubnis"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, "Erlaubnis");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 0);
  SetProp(P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
}
