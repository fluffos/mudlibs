inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../insel.h"
#include <moving.h>
#include <player.h>
object room;
int i;
void create()
{
  ::create();
  i=0;
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Auf See");
  SetProp(P_INT_LONG, "Du befindest Dich auf einem primitven Floss. "
		   +"Sechs Palmenstaemme bilden den Koerper des Flosses, ein "
		   +"Stamm dient als Mast, an dem ein geflicktes Segel gehisst"
		   +"ist.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:27]));

  AddDetail(({"boot", "floss", "koerper"}), "Das Floss ist stabil "
		   +"genug, um Dich (hoffentlich) bis zum sicheren Ufer "
		   +"zu begleiten.");
  AddDetail("mast", "Der Mast besteht ebenfalls aus Holz. Mit "
		   +"einem Seil ist ein geflicktes Segel daran "
		   +"befestigt.");
  AddDetail("segel", "Das reinweisse Segel bauscht im Wind. Es "
		   +"ist am Mast befestigt.");
  AddDetail("seil", "Das Segel ist mit diesem Seil an den Mast "
		   +"befestigt.");
  AddDetail("himmel", "Der Himmel ist wolkenlos.");
  AddDetail("meer", "Das Meer ist ueberall ... und es ist ruhig.");
}

void init()
 {
   ::init();
   room=environment(this_player());
   if (query_once_interactive(this_player()))
	if(present(TP, room)) call_out("story1", 2,1);
 }





story1()
{
  write(BS("\nDu steuerst das Boot Richtung Kueste...der Wind "
		  +"wie durch ein Wunder in die richtige Richtung, und "
		  +"so hast du keine Probleme, dass Floss auf Kurs zu "
		  +"halten.\nDu segelst..."));
  if(present(TP, room)) call_out("story2", 5, 1);
}

story2()
{
 write ("...und segelst...\n");
 i++;
 if(i<2)
   {
    if(present(TP, room)) call_out("story2", 3, 1);
   }
 else
    if(present(TP, room)) call_out("story3", 5, 1);
}

story3()
{
  write (BS("\nDie Kueste kommt in Sicht ...\n"));
  AddDetail("kueste", "Endlich ist die Kueste in Sicht...");
  if(present(TP, room)) call_out("story4", 4, 1);
}

story4()
{
  write("... immer naeher...\n");
  if(present(TP, room)) call_out("story5", 6, 1);
}

story5()
{
  write(BS("\n...und schliesslich landet das Floss am "
		  +"Festland.\n"));
  if(present(TP, room)) call_out("story6", 2, 1);
}

story6()
{
 write(BS("\nAls Du an Land gehst, kommt ein heftiger "
		 +"Wind auf und treibt das Floss auf das offene "
		 +"Mehr.\nDu bist ...\n"));

 if(present(TP, room)) call_out("teleportieren", 2, 1);
}

teleportieren()
{
 TP->move(INSEL("strand_r1"), M_GO, "an Land", "kommt",
             "kommt mit einem Floss und geht an Land");
}

GetExits()
{
 return "";
}
