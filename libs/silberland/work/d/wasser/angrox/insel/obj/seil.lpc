inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../insel.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("seil");
  SetProp (P_SHORT, "Ein altes Seil");
  SetProp (P_LONG, bs(
           "Hmm... dieses Seil ist wirklich sehr alt. Mit ihm koenntest Du "
          +"was zusammenbinden. Aber was?\n"));
  SetProp (P_NAME, "altes Seil");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_MATERIAL, MAT_CLOTH);
  AddCmd(({"bind", "binde"}), "binde"); 
  AddCmd("befestige", "befestige");  
}


binde(string str)
{
  int i;
  object ob, room;
 
  room=environment(this_player());
  notify_fail("Was willst Du denn zusammenbinden?\n");
  if(!str) return 0;
 
  notify_fail("So geht das nicht. WAS moechtest du mit WEM zusammenbinden?\n");
  if (str != "palmenstaemme zusammen" && str != "staemme zusammen"
      && str != "palmenstaemme mit seil" && str != "staemme mit seil"
      && str != "palmenstaemme mit seil zusammen" && 
      str != "staemme mit seil zusammen") 
         return 0;
  notify_fail("Hmm ... vielleicht solltest Du sie an einem Ort zusammenbinden, "
            +"von dem Du weisst, dass man von ihm aus sicher ab- und anlegen "
            +"kann?\n");
  if((room->QueryProp(P_INT_SHORT)) != "Ein flacher Strand") return 0; 
  notify_fail("Du hast zuwenig Palmenstaemme.\n");
  if (!present("palmenstamm 6", environment(TP))) return 0;
  for (i=1;i<=6;i++)
    {
       ob=present("palmenstamm", environment(TP));
       ob->remove();  
    }
  ob=CLONEOB(OBJ("floss1"));
  ob->move(environment(TP), M_NOCHECK);
  write(BS("Du verbindest die Palmenstaemme mit dem Seil zu einem primitiven Floss "
         +"ohne Mast und ohne Segel. Du behaeltst noch einiges an Seil ueber."));
  say(TPN+BS(" baut ein primitives Floss ohne Segel und Mast.\n"));
  return 1;
 
}

befestige(string str)
{
 object ob;
 notify_fail("Befestigen - ja. Aber was?\n");
 if(!str) return 0;
 notify_fail("Was willst du als was befestigen?\n");
 if(str=="palmenstamm als mast" || str=="stamm als mast")
   {
     if (!(ob=present("palmenstamm",environment(TP))) && 
         !(ob=present("palmenstamm", TP)))
       {
         write(BS("Huch! Du hast ja gar keinen Stamm mehr.\n"));
         return 1;
       }
     ob->remove();
     if ( !ob=present("floss", environment(TP)))
     {
       write("Wo ist das Floss?\n");
       return 1;
     }
     ob->remove();
     ob=CLONEOB(OBJ("floss2"));
     ob->move(environment(TP), M_NOCHECK);
     write(BS("Du fixierst den Stamm als Mast in der Mitte des Schiffes.\n"));
     say(TPN+BS(" nimmt einen Stamm und befestigt ihn in der Mitte des "
              +"Schiffes. Ein Stueckchen Seil bleibt ueber.\n"));
     return 1; 
   }

if (str=="segel an mast" || str=="segel")
   {
     if(!(ob=present("segel", TP)))
       {
         write (BS("Du hast aber kein Segel ...\n")); 
         return 1;
       }
    
     if( !ob=present("floss", environment(TP)) )
     {
       write("Wo ist bloss das Floss hin....\n");
       return 1;
     }
     ob->remove();
     ob=CLONEOB(OBJ("floss3"));
     ob->move(environment(TP), M_NOCHECK);
     ob=CLONEOB(OBJ("hissen"));
     ob->move(TP, M_NOCHECK);
     write(BS("Du befestigst das Segel am Mast. Fertig zum Auslaufen, Kaept'n!\n"));
     say(TPN+BS(" befestigt das Segel am Mast des Flosses.\n"));
     remove();
     return 1; 
   }
return 0;
}


