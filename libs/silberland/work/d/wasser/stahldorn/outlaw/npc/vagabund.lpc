#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit NPC "outlaw_inh";                                                                        

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Vagabund");
  SetProp(P_LONG,
    "Ein angetrunkener Vagabund luemmelt hier herum. Er sieht ziemlich "
    "unordentlich und ungewaschen aus. In seinem jetzigen Zustand wird er "
    "wohl kein allzu harter Gegner werden.");
  SetProp(P_NAME, "Vagabund");
  SetProp(P_GENDER, MALE);
  AddId(({"mann", "vagabund"}));

  create_default_npc(9);
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Mensch");
  SetProp(P_ALCOHOL, 100);
  SetProp(P_SIZE, 175);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " vagabundiert ins Reich der Toten.\n");
  
  AddInfo(DEFAULT_INFO, "lallt irgendetwas obszoenes. <hick>\n");

  SUID;
  if(random(5)>1)CLONEME("/p/armour/armour/weste" );
  CLONEME( "/p/armour/trousers/hose" );
  if( random(100) < 70 ) CLONEME( "/p/armour/belt/guertel" );
  CLONEME(ARMOUR "mantel" );
  if( random(100) < 70 ) CLONEME( "/p/armour/helm/hut" );
  command("trage alles");
}

void init()
{
  ::init();
  SetProp(P_ALCOHOL, 100);
}
