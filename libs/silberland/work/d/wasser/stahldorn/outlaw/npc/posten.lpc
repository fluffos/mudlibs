#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit NPC "outlaw_inh";                                                                        

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein mueder Wachtposten");
  SetProp(P_LONG, BS(
    "Der Wachtposten scheint schon etwas laenger nicht abgeloest worden "
    "zu sein. Aus seinen mueden Augen heraus sieht er Dich relativ "
    "desinteressiert an."));
  SetProp(P_NAME, "Wachtposten");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "wachtposten", "wachposten", "posten"}));

  create_default_npc(12);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 178);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " beendet toedlich getroffen seinen Wachdienst.\n");
  
  AddInfo(DEFAULT_INFO, "zuckt desinteressiert mit den Schultern.\n");

  SUID;
  CLONEME(WEAPON "brschw" );
  command("zuecke schwert");
  if(random(6) == 4)
  {
    CLONEME( "/p/armour/trousers/hose" );
    CLONEME( "/p/armour/belt/guertel" );
  }
  CLONEME(ARMOUR "brpanz" );
  if( random(100)<50) CLONEME(ARMOUR "hasch" );
  if( random(100)<60) CLONEME(ARMOUR "stief" );
  command("trage alles");
}

void init()
{ 
   ::init();
   if(interactive(TP))
     call_out("haltwerda", 0);
}

void haltwerda()
{
     tell_room(MENV, "Der Posten sagt: Halt! Wer da?\n");
}
