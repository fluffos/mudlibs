#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit NPC "outlaw_inh";                                                                        

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Raeuber");
  SetProp(P_LONG,
    "Vor Dir steht ein mickriger Raeuber mit einer primitiven Keule "
    "in der Hand. Er scheint nicht besonders stark zu sein und geuebt in "
    "seinem Beruf ist er sicherlich auch nicht. Fuer einen Ork sieht "
    "er sogar ziemlich zierlich aus.");
  SetProp(P_NAME, "Raeuber");
  SetProp(P_GENDER, MALE);
  AddId(({"ork", "raeuber"}));

  create_default_npc(10);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " raubt sich sein eigenes Leben.\n");
  
  AddInfo(DEFAULT_INFO, "sagt: Gelb oder Leder!\n");

  SUID;
  CLONEME(WEAPON "keule" );
  command("zuecke keule");
  CLONEME( "/p/armour/armour/weste" );
  if( random(100) < 60 ) CLONEME(ARMOUR "helm" );
  if( random(100) < 70 ) CLONEME( "/p/armour/trousers/hose" );
  command("trage alles");
}
