inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Boss der Vogelfreien");
  SetProp(P_LONG, BS(
    "Der Boss der Vogelfreien schmiedet Plaene, wie er wohl am besten "
    "Knarkhist werden kann. Er hat sich sogar schon die Ausruestung eines "
    "Knarkhisten besorgt, und trotzdem wollte man ihn in Knarkh nicht."));
  SetProp(P_NAME, "Boss");
  SetProp(P_GENDER, MALE);
  AddId(({"mann", "vogelfreier", "boss"}));

  create_default_npc(15);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_DIE_MSG, " stirbt einen Knarkhistentod.\n");
  
  AddInfo(DEFAULT_INFO, "sagt: Verschwinde aus meinem Zelt!\n");

  SUID;
  CLONEME(KNARKHPATH "obj/p_knarkhschwert2" );
  command("zuecke schwert");
  if(random(5) > 2) CLONEME(KNARKHPATH "obj/knarkhpanzer" );
  else CLONEME(KNARKHPATH "obj/p_knarkhpanzer" );
  CLONEME(KNARKHPATH "obj/emblem" );
  CLONEME("/p/armour/trousers/hose" );
  CLONEME( "/p/armour/belt/guertel" );
  if(random(4)) CLONEME(ARMOUR "stief" );
  if(random(2) == random(3)) CLONEME(ARMOUR "helm" );
  if(random(3))CLONEME(ARMOUR "mantel" );
  if(!random(5))CLONEME(ARMOUR "ring" );
  if(!random(5))CLONEME(ARMOUR "hasch" );
  command("trage alles");
  CLONEME(OBJ "sack" );
  { 
    object ob;
    ob=clone_object("/obj/money");
    ob->AddAmount(40+random(70));
    ob->move(TO); 
  }
  command("stecke geld in sack");
}

