inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Taenzerin");
  SetProp(P_LONG,
    "Die Taenzerin ist splitterfasernackt und tanzt wie in Trance vor sich "
    "hin. Anscheinend hat man ihr irgendwelche Drogen gegeben, die sie voll"
    "kommen tilt gemacht haben. Sie hat ihren Beruf jedenfalls nicht verfehlt, "
    "denn nicht nur ihr taenzerisches Koennen ist beeindruckend, sondern "
    "auch ihre Figur.");
  SetProp(P_NAME, "Taenzerin");
  SetProp(P_GENDER, FEMALE);
  AddId(({"taenzerin"}));

  create_default_npc(9);
  SetProp(P_BODY, QueryProp(P_BODY) - 10);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " tanzt den Tanz des Todes.\n");
  
  AddInfo(DEFAULT_INFO, "tanzt um Dich herum.\n");

  SetChats( 10, ({
    "Die Taenzerin vollfuehrt einen atemberaubenden Bauchtanz.\n", 
    "Die Taenzerin wirbelt gekonnt herum.\n", 
    "Die Taenzerin macht eine sehenswerte Pirouette.\n", 
    "Die Taenzerin tanzt zur Musik.\n", 
    "Die Taenzerin tanzt einen Tango.\n", 
    "Die Taenzerin waelzt sich am Boden herum.\n", 
    "Die Taenzerin umgarnt einen der Zuschauer.\n", 
    "Die Taenzerin tut so, als ob sie gerade erst draufkaeme, dass sie nackt ist.\n", 
    "Die Taenzerin schaut Dich verfuehrerisch an. Was die wohl will?\n", 
    "Die Taenzerin macht einen Handstand und schlaegt dann ein Rad.\n", 
    "Die Taenzerin macht einige wiegende Tanzschritte.\n", 
    "Die Taenzerin holt sich kurz einen Schleier und bedeckt sich damit.\n"
    "Die Taenzerin wirft den Schleier sofort wieder weg, als Buhrufe aus dem \n"
    "Publikum ertoenen...\n" }) );

}
