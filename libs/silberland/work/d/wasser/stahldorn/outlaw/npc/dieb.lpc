#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit NPC "outlaw_inh";

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Dieb");
  SetProp(P_LONG, BS(
    "Vor Dir steht ein ungeschickter, ja dummer Moechtegern-Dieb. Dir "
    "ist schleierhaft, wie dieser kleine Kerl mit seinen klobigen und " 
    "haarigen Hobbithaenden je eine Geldboerse aus einer engen Hosen"
    "tasche stehlen will."));
  SetProp(P_NAME, "Dieb");
  SetProp(P_GENDER, MALE);
  AddId(({"dieb"}));

  create_default_npc(10);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " bereut seine Diebstaehle und stirbt.\n");

  AddInfo(DEFAULT_INFO, "grapscht tolpatischig nach Deiner Brieftasche.\n");

  SUID;
  CLONEME( "/p/weapon/knife/dolch" );
  command("zuecke dolch");
  CLONEME( "/p/armour/trousers/hose" );
  if( random(100) < 60 ) CLONEME( "/p/armour/belt/guertel" );
  if( random(100) < 50 ) CLONEME(ARMOUR "ring" );
  if( random(100) < 70 ) CLONEME(ARMOUR "stief" );
  command("trage alles");
}
