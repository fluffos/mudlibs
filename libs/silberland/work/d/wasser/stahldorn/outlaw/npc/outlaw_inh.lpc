inherit "std/npc";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <moving.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
}

varargs void die(int poisondeath)
{
  object ob,next;
  if( objectp(QueryProp(P_KILLER)) &&
      random(QueryProp(P_KILLER)->QueryProp(P_LEVEL)-20)> 5 ) 
  {
    SetProp(P_DIE_MSG, " springt mit letzter Kraft ins Meer und geht unter.\n");
    SetProp(P_NOCORPSE, 1);
    for(ob=first_inventory(this_object());ob;) 
    {
      next=next_inventory(ob);
      ob->remove(1);
      ob=next;
    }
  }
  ::die(poisondeath);
}
  
