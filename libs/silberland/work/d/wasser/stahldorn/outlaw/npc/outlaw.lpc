#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit NPC "outlaw_inh";                                                                        

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Vogelfreier");
  SetProp(P_LONG,
    "Ein nicht mehr allzu junger Mann mit wettergegerbtem Gesicht und "
    "einigen tiefen Narben. Er hat mit Sicherheit schon viel in seinem "
    "ereignisreichen Leben gesehen. An seinen Bewegungen erkennt man, "
    "dass er aber nun bereits von Arthritis geplagt wird und sicher keinen "
    "so gefaehrlichen Gegner, wie er es in seiner Jugend war, abgeben wird.");
  SetProp(P_NAME, ({"der Vogelfreie", "des Vogelfreien", 
     "dem Vogelfreien", "den Vogelfreien" }));
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"mann", "vogelfreier", "vogelfreien", "ausgestossener"}));

  create_default_npc(11);
  SetProp(P_BODY, QueryProp(P_BODY) - 20);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " wird zu einem freien Vogel und stirbt.\n");
  
  AddInfo(DEFAULT_INFO, "hoert Dir nicht zu.\n");

  SUID;
  CLONEME( "/p/weapon/sword/degen" );
  command("zuecke degen");
  if(!random(2))CLONEME(ARMOUR "ring" );
  if(random(3)==2) CLONEME(ARMOUR "ring" );
  CLONEME( "/p/armour/trousers/hose" );
  if(random(10)>6) CLONEME("/p/armour/belt/guertel" );
  if(random(10)>4)  CLONEME(ARMOUR "mantel" );
  if(!random(5)) CLONEME(ARMOUR "helm" );
  command("trage alles");
}
