#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int zweigda=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Strand der Ausgestossenen" );
  SetProp( P_INT_LONG,
    "Du stehst an einem schmalen Durchlass zwischen einigen Bueschen. "
    "Noerdlich von hier befindet sich der Weg und nach Suedwesten hin gehts " 
    "zu einem huebschen Sandstrand, wobei man aber eine breite Duene, "
    "die den Weg versperrt, umgehen muss. Leider sieht "
    "die Landschaft hier nicht so nett aus, wie sie sollte, denn ueberall "
    "hat sich diverses Gesindel breitgemacht und lungert herum. Ein paar "
    "Schritte suedoestlich von hier haben sie sogar Zelte aufgestellt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "durchlass" }),
    "Ein schmaler Durchlass fuehrt durch die Buesche hindurch auf den "
    "Weg, durch den Du hergekommen bist, zurueck.");
  AddDetail( ({ "busch", "buesche", "gebuesch" }),
    "Ziemlich normales Dornengestruepp. Wenn man nicht aufpasst, zerkratzt "
    "man sich leicht die Hand daran.");
  AddSpecialDetail( ({ "dornengestruepp", "gestruepp" }), "nimm_zweig");
  AddSpecialDetail(({"dornen", "dorne", "zweig", "zweige", "dornenzweige"}), 
     "stich");
  AddDetail( ({ "weg" }),
    "Der Weg ist nun hinter den Bueschen verborgen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist etwas sandig. Hie und da sieht ein Grasbueschel heraus.");
  AddDetail( ({ "gras", "grasbueschel", "bueschel" }),
    "Das Gras ist grasgruen. Ganz normal.");
  AddDetail( ({ "himmel" }),
    "Heiter bis wolkig. Immer wieder lacht die Sonne hervor.");
  AddDetail( ({ "wolken", "sonne", "wolke" }),
    "Nichts besonderes daran zu erkennen.");
  AddDetail( ({ "sand", "sandkoerner" }),
    "Der Sand ist von sandiger Farbe und relativ feinkoernig.");
  AddDetail( ({ "strand", "sandstrand" }),
    "Der eigentliche Strand liegt hinter einer Duene. Von hier aus sieht "
    "er recht huebsch aus, obwohl einige lumpige Gestalten herumlungern "
    "und ihn verschandeln.");
  AddDetail( ({ "meer" }),
    "Das Meer liegt hinterm Strand. Also grob im Sueden, Suedwesten und "
    "Westen.");
  AddDetail( ({ "zelte", "umrisse" }),
    "Die groben Umrisse von Zelten kann man suedoestlich erkennen.");
  AddDetail( ({ "landschaft" }),
    "Sehr nett. Wenn nur diese Typen nicht waeren...");
  AddDetail( ({ "gesindel", "gestalten", "typen", "ausgestossene" }),
    "Die zwielichtigen Typen, die hier herumhaengen, scheinen irgendwie "
    "Ausgestossene zu sein. In die gutbuergerliche Welt der Grossstaedte "
    "wie Midas oder Tijara passen sie nicht hinein. Aber zu den richtig "
    "Boesen, wie den Einwohnern in Knarkh, koennen sie auch nicht gehoeren, "
    "weil sie zu schwaechlich sind.");
  AddDetail( ({ "duenen", "duene", "sandduene"  }),
    "Eine grosse Sandduene versperrt den direkten Weg zum Strand.");

  AddSound( DEFAULT_SOUND,
    "Man hoert das Rauschen des Meeres, sowie die Stimmen groehlender "
    "Leute.");
  AddSound( ({ "rauschen", "meer" }),
    "Das Meer rauscht langsam und bedaechtig. Ein beruhigendes Geraeusch.");
  AddSound( ({ "leute", "groehlen", "lieder", "trinklieder", "stimmen" }),
    "Es werden Lieder gesungen wie:\n   'Wir lagen vor Tijara und "
    "hatten Dantes Pest an Bord'.\nund auch:\n   'In Derlim steht ein "
    "Hofbraeuhaus! Oans, Zwoa, Gsuffa!'\n");
    
  AddItem( NPC "posten" , REFRESH_DESTRUCT);

  AddExit( "norden", WEGPATH "weg5" );
  AddExit( "nordwesten", "./n_strand" );
  AddExit( "suedosten", "./vor_zelt" );
}

string stich(string str)
{
  say(TP->Name()+" greift zu sorglos in die Dornen und sticht sich dabei.\n");
  TP->reduce_hit_points(5+random(10));
  return(BS("Aua! Jetzt hast Du nicht aufgepasst und Dich an einem der "
            "Dornen gestochen. Das tut weh."));
}

string nimm_zweig(string str)
{
  if(!zweigda) return stich(str);
  zweigda=0;
  say(TP->Name()+" pflueckt geschickt einen Dornenzweig von einem der "
          "Buesche.\n");
  clone_object(OBJ "zweig")->move(TP, M_NOCHECK);
  return BS("Du untersuchst vorsichtig das Dornengestruepp und findest "
       "dabei einen Dornenzweig, der Dir so gut gefaellt, dass Du ihn "
       "abbrichst und einsteckst.");
}

reset()
{
  ::reset();
  zweigda=1;
}
