#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int zweigda=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Strand der Ausgestossenen" );
  SetProp( P_INT_LONG,
    "Hier beginnt ein kleines Stueckchen Sandstrand, der sich noch ein "
    "wenig nach Sueden hin ausdehnt. Der Weg nach Norden "
    "wird von einigen Bueschen und kleinen Sandduenen versperrt. Westlich "
    "von Dir befindet sich das Meer, das sich bis zum Horizont erstreckt. "
    "Sofort merkst Du, dass Du nicht alleine bist, denn einige schlecht "
    "ausgeruestete Raeuber und Diebe ueben hier das Rauben und Stehlen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "busch", "buesche", "gebuesch" }),
    "Ziemlich normales Dornengestruepp. Wenn man nicht aufpasst, zerkratzt "
    "man sich leicht die Hand daran.");
  AddSpecialDetail( ({ "dornengestruepp", "gestruepp" }), "nimm_zweig");
  AddSpecialDetail(({"dornen", "dorne", "zweig", "zweige", "dornenzweige"}), 
     "stich");
  AddDetail( ({ "weg" }),
    "Der Weg ist nun hinter den Bueschen verborgen.");
  AddDetail( ({ "boden" }),
    "Der Boden ist etwas sandig. Hie und da sieht ein Grasbueschel heraus.");
  AddDetail( ({ "gras", "grasbueschel", "bueschel" }),
    "Das Gras ist grasgruen. Ganz normal.");
  AddDetail( ({ "himmel" }),
    "Heiter bis wolkig. Immer wieder lacht die Sonne hervor.");
  AddDetail( ({ "wolken", "sonne", "wolke" }),
    "Nichts besonderes daran zu erkennen.");
  AddDetail( ({ "sand", "sandkoerner" }),
    "Der Sand ist von sandiger Farbe und relativ feinkoernig.");
  AddDetail( ({ "strand", "sandstrand" }),
    "Der Sandstrand wird von allerlei Raeuber und Dieben bevoelkert. "
    "So eine Art Wettkampf scheint gerade im Gang zu sein." );
  AddDetail( ({ "kampf", "wettkampf" }),
    "Der Wettkampf besteht wohl darin, sich auf moeglichst unfaehige Weise "
    "den Schaedel einzuschlagen, beziehungsweise auf die plumpste vorstell"
    "bare Art das Geld aus der Tasche zu ziehen. Dabei ist ziemlich unklar, "
    "wer hier aktive Wettkaempfer sind, und wer bloss zusieht.");
  AddDetail( ({ "wettkaempfer" }),
    "Welche meinst Du? Die Diebe oder die Raeuber?");
  AddDetail( ({ "raeuber" }),
    "Die Raeuber ueben gerade, wie man am effektivsten jemandem den Kopf "
    "einschlaegt, um ihn auszurauben. Leider stellen sie sich dabei sehr "
    "ungeschickt an und hauen sich immer wieder auf die Finger oder stechen "
    "sich ins Bein.");
  AddDetail( ({ "muscheln", "muschel" }),
    "Die Muscheln besitzen keinen Wert. Du laesst sie liegen.");
  AddDetail( ({ "schuhe", "alte schuhe" }),
    "Also die stammen entweder von den Leichen der Matrosen untergegangener "
    "Schiffe, oder von den Leichen der Passagiere untergegangener "
    "Schiffe. Jedenfalls sind die Schuhe alt, vergammelt und unbrauchbar.");
  AddDetail( ({ "diebe" }),
    "Die Diebe schleichen sich immer wieder an die Raeuber heran, und "
    "versuchen, ihnen das Geld oder kleine Wertgegenstaende zu fladern. "
    "Dabei muessen sie hoellisch aufpassen, um nicht einen der schlecht "
    "gezielten Keulenschlaege eines Raeubers abzubekommen. Oft werden die "
    "Diebe aber auch erwischt und bekommen absichtliche, GUT gezielte "
    "Keulenschlaege ab...");
  AddDetail( ({ "keulenschlag", "keulenschlaege" }),
    "Die meisten gehen daneben. Die, die nicht danebengehen, sind unter die "
    "Kategorie 'Haudraufundschluss' einzuordnen.");
  AddDetail( ({ "horizont" }),
    "Der Horizont ist nicht mehr als eine verwaschene Grenze zwischen "
    "Himmel und Meer weit weit im Westen.");
  AddDetail( ({ "wellen", "meer"}),
    "Sanft rollen die Wellen an den flachen Sandstrand, wo sie schnell " 
    "versanden. Hie und da werden Muscheln oder alte Schuhe "
    "angespuelt.");
  AddDetail( ({ "duenen", "duene" }),
    "Einige Sandduenen gibts hier auch, aber sie sehen uninteressant aus.");

  AddSound( DEFAULT_SOUND,
    "Man hoert das Rauschen des Meeres. Von irgendwoher dringt das Groehlen "
    "ziemlich angetrunkener Leute.");
  AddSound( ({ "rauschen", "meer" }),
    "Das Meer rauscht langsam und bedaechtig. Ein beruhigendes Geraeusch.");
  AddSound( ({ "leute", "groehlen" }),
    "Du erkennst die dritte Strophe des 'Knarkh City Blues'. Sie sind "
    "gerade bei der Stelle wo es heisst: 'Ich moecht so gern wissen, wie "
    "es ist, ach waer ich doch boese, ach waer ich Knarkhist!'");
    
  AddItem( NPC "dieb" , REFRESH_DESTRUCT);
  AddItem( NPC "dieb" , REFRESH_DESTRUCT);
  AddItem( NPC "raeuber" , REFRESH_DESTRUCT);
  AddItem( NPC "raeuber" , REFRESH_DESTRUCT);

  AddExit( "sueden", "./w_strand" );
  AddExit( "suedosten", "./eingang" );
}

string stich(string str)
{
  say(TP->Name()+" greift zu sorglos in die Dornen und sticht sich dabei.\n");
  TP->reduce_hit_points(5+random(10));
  return(BS("Aua! Jetzt hast Du nicht aufgepasst und Dich an einem der "
            "Dornen gestochen. Das tut weh."));
}

string nimm_zweig(string str)
{
  if (!zweigda) return stich(str);
  zweigda=0;
  say(TP->Name()+" pflueckt geschickt einen Dornenzweig von einem der "
          "Buesche.\n");
  clone_object(OBJ "zweig")->move(TP, M_NOCHECK);
  return BS("Du untersuchst vorsichtig das Dornengestruepp und findest "
       "dabei einen Dornenzweig, der Dir so gut gefaellt, dass Du ihn "
       "abbrichst und einsteckst.");
}

reset()
{
  ::reset();
  zweigda=1;
}
