#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Lagerfeuer der Vogelfreien" );
  SetProp( P_INT_LONG,
    "Vor Dir hat jemand ein Lagerfeuer angezuendet, um das ein Haufen "
    "zwielichtiger Typen und seltsamer Kerle sitzt. Sie scheinen sich "
    "praechtig zu amuesieren und der Alkohol fliesst in Stroemen. Es geht "
    "wirklich ausserordentlich lustig zu und alle singen im Chor schrecklich "
    "schlechte Trinklieder. Oestlich von hier wurde ein Zelt aufgestellt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "feuer", "lagerfeuer" }),
    "Das Lagerfeuer lodert hoch auf, weils durch den alkoholgesaettigten Atem "
    "der Leute drumherum massenhaft Nahrung bekommt...");
  AddDetail( ({ "alkohol" }),
    "Fast jeder nuckelt an einer Flasche Rum oder sowas.");
  AddSmell( ({ DEFAULT_SMELL, "alkohol" }),
    "Hier stinkts nach Alkohol.");
  AddDetail( ({ "zelt" }),
    "Es sieht aus wie ein ganz normales Zelt aus dunkelgruenem Stoff. "
    "Wenn Du mehr sehen willst, musst Du reingehen.");
  AddDetail( ({ "vegetation" }),
    "Hier waechst fast nichts. Ueberall nur Sand.\n");
  AddDetail( ({ "boden" }),
    "Der Boden ist voellig von Sand bedeckt.");
  AddDetail( ({ "himmel" }),
    "Am Himmel scheint die Sonne zwischen ein paar Wolken hervor.");
  AddDetail( ({ "wolken", "sonne", "wolke" }),
    "Nichts besonderes daran zu erkennen.");
  AddDetail( ({ "sand", "sandkoerner" }),
    "Der Sand ist von sandiger Farbe und relativ feinkoernig.");
  AddDetail( ({ "strand", "sandstrand" }),
    "Ein paar Duenen verlaufen flach ins offene Meer und bilden hier einen " 
    "schoenen Sandstrand. Viele Leute sitzen hier um ein Lagerfeuer." );
  AddDetail( ({ "muscheln", "muschel" }),
    "Die Muscheln besitzen keinen Wert. Du laesst sie liegen.");
  AddDetail( ({ "horizont" }),
    "Der Horizont ist nicht mehr als eine verwaschene Grenze zwischen "
    "Himmel und Meer weit weit im Westen.");
  AddDetail( ({ "wellen", "meer"}),
    "Die sanften Wellen spuelen manchmal Muscheln an den Strand. "); 
  AddDetail( ({ "duenen", "duene", "sandduenen" }),
    "Einige Sandduenen gibts hier auch, aber sie sehen uninteressant aus.");
  AddDetail( ({ "leute", "kerle", "gestalten", "typen", "haufen" }),
     "Viele verschiedene Leute sitzen am Lagerfeuer, saufen, essen, groehlen, "
     "lachen und aeh... amuesieren sich auf viele verschiedene Arten.");

  AddSound( ({ "lieder", "trinklieder" }),
    "Jetzt gerade ist anscheinend ein satanisches Lied dran, denn sie singen:\n"
    "  '6 6 6, diese Zahl, die haelt uns frisch!'\n"
    "  '6 6 6, auf dem Kuechentisch!'\n"
    "(Ich hab ja gesagt es sind schrecklich schlechte Lieder...)\n");

  AddSound( ({ DEFAULT_SOUND, "leute", "groehlen", "musik" }),
    "Die Lieder, die zur Zeit gesungen werden, sind alles andere als schoen.");
    
  AddItem( NPC "taenzerin" , REFRESH_DESTRUCT);
  AddItem( NPC "outlaw" , REFRESH_DESTRUCT);
  AddItem( NPC "vagabund" , REFRESH_DESTRUCT);
  AddItem( NPC "vagabund" , REFRESH_DESTRUCT);
  AddItem( NPC "dieb" , REFRESH_DESTRUCT);

  AddExit( "nordwesten", "./eingang" );
  AddExit( "westen", "./s_strand" );
  AddExit( "osten", "./zelt" );

  AddRoomMessage( ({
   "'Es gibt kein Bier in Elessar, es gibt kein Bier...'\n",
   "'Alles hat ein Ende, nur die Knarkhwurst hat zwei...'\n", 
   "'Wir lagen vor Tijara und hatten Dantes Pest an Bord!'\n",
   "'Rote Nase, Rote Nase, das ist die grosse Mausefalle "
     "mit-ten-in-Mi-das!'\n", 
   "'Lalalalala, die Goass is weg, die Goass is weg, die Goass is weg...'\n",
   BS("'Sauf Raeuber, sauf Raeuber, sauf, sauf, sauf, mein lieber Raeuber, "
      "guter Raeuber sauf, sauf, sauf! Meihein lieber Raeuber sauf! Meihein "
      "guter Raeuber sauf!'"), 
   "'Runter mit dem Schnaps, mein Schatz!'\n",
   "'Do droben auf dem Bergerl, HOLLADRIO!...'\n", 
   "Irgendjemand lacht laut auf.\n",
   "Irgendjemand uebergibt sich.\n",
   "Irgendwo bricht kurz ein Streit aus, aber er wird schnell 'abgewuergt'.\n", 
   "Alle groehlen wirr durcheinander.\n" }), 1);

}
