#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Zelt der Vogelfreien" );
  SetProp( P_INT_LONG,
    "Du stehst im Zelt der Vogelfreien. Ausser einigen am Boden liegenden "
    "zusammengeknuellten Decken, Matratzen, Schlafsaecken und Kissen ist "
    "es leer, denn Schlaf wird hier nur als eine kurze Unterbrechung der "
    "Fete angesehen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "decke" }),
    "Ueber Dir kruemmen sich die Zeltwaende und vereinigen sich am hoechsten "
    "Punkt.");
  AddDetail( ({ "eingang" }),
    "Durch den Eingang dringt ein wenig Licht in den Raum.");
  AddSpecialDetail( ({ "licht" }), "lfunc");
  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "wand", "waende", "zeltwand", "zeltwaende" }),
    "Die Waende bestehen natuerlich aus Stoff und Leder. Schliesslich bist "
    "Du in einem Zelt.");
  AddDetail( ({ "leder" }),
    "Das Leder wurde gruendlich gegerbt und impraegniert.");
  AddDetail( ({ "stoff" }),
    "Der Stoff macht die Zeltwaende weicher und bequemer.");
  AddDetail( ({ "boden" }),
    "Am Boden liegen viele Polster, Matratzen und sowas herum.");
  AddDetail( ({ "polster", "kissen" }),
    "Die Polster sind schmuddelig und sehen stark benutzt aus.");
  AddDetail( ({ "matratze", "matratzen" }),
    "Auf den Matratzen sind ueberall Flecken. Iiiih.");
  AddDetail( ({ "schlafsaecke", "schlafsack" }),
    "Also in SO einen Schlafsack wuerdest Du NIE kriechen!");
  AddDetail( ({ "decken" }),
    "Die Decken sind alt und schaebig.");
  AddDetail( ({ "flecken" }),
    "Dabei handelt es sich hauptsaechlich um die Ergebnisse zu starken "
    "Alkoholkonsums. Betrunkene koennen halt nicht immer ihre Koerper"
    "funktionen so steuern, dass es nicht grauslich ist.");
  AddDetail( ({ "zelt" }),
    "Da stehst Du grad drin. Mach mal \"schau\"!");

    
  AddItem( NPC "posten" , REFRESH_DESTRUCT);
  AddItem( NPC "boss" , REFRESH_DESTRUCT);
  AddItem( NPC "posten" , REFRESH_DESTRUCT);

  AddExit( "westen", "./vor_zelt" );

}

string lfunc(string str)
{
  TP->SetProp(P_BLIND, "Du bist leider auf immer und ewig blind!\n");
  call_out("just_a_gag", 5);
  return BS("Das Licht, das beim Eingang hereinscheint, ist immerhin noch "
            "stark genug um Dich zu blenden. Du bist BLIND!");
}

void just_a_gag()
{
  write(BS(
    "Uff, das war wohl doch nur ein Staubkorn, das Dir ins Auge gefallen "
    "ist. Du kannst nun wieder sehen."));
  TP->SetProp(P_BLIND, 0);
}
