#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Strand der Ausgestossenen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich an einem huebschen Sandstrand, der durch die "
    "Anwesenheit einiger zwielichtiger Kerle leider ueberhaupt nicht zum "
    "Verweilen einlaedt. Die Vegetation hat sich hier gaenzlich dem Sand "
    "des Strandes und den stetig an den Strand rollenden Wellen beugen "
    "muessen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "vegetation" }),
    "Hier waechst fast nichts. Ueberall nur Sand.\n");
  AddDetail( ({ "boden" }),
    "Der Boden ist voellig von Sand bedeckt.");
  AddDetail( ({ "himmel" }),
    "Etwas wolkig. Doch die Sonne scheint immer wieder mal dazwischen "
    "hervor.");
  AddDetail( ({ "wolken", "sonne", "wolke" }),
    "Nichts besonderes daran zu erkennen.");
  AddDetail( ({ "sand", "sandkoerner" }),
    "Der Sand ist von sandiger Farbe und relativ feinkoernig.");
  AddDetail( ({ "strand", "sandstrand" }),
    "Ein paar Duenen verlaufen flach ins offene Meer und bilden hier einen " 
    "schoenen Sandstrand. Ein paar nicht vertrauenswuerdige Kerle "
    "treiben sich hier herum." );
  AddDetail( ({ "muscheln", "muschel" }),
    "Die Muscheln besitzen keinen Wert. Du laesst sie liegen.");
  AddDetail( ({ "horizont" }),
    "Der Horizont ist nicht mehr als eine verwaschene Grenze zwischen "
    "Himmel und Meer weit weit im Westen.");
  AddDetail( ({ "wellen", "meer"}),
    "Die sanften Wellen spuelen manchmal Muscheln an den Strand. "); 
  AddDetail( ({ "duenen", "duene", "sandduenen" }),
    "Einige Sandduenen gibts hier auch, aber sie sehen uninteressant aus.");
  AddDetail( ({ "kerle", "gestalten", "diebe", "raeuber" }),
    "Die lungern hier nur herum und langweilen sich. Sie scheinen irgendwie "
    "traurig zu sein, weil sie in Knarkh nicht erwuenscht waren.");

  AddSound( ({ DEFAULT_SOUND, "geraeusche"}),
    "Man hoert das Rauschen des Meeres. Aus suedlicher Richtung dringen "
    "die Geraeusche furchtbar schlechter Trinklieder.");
  AddSound( ({ "rauschen", "geraeusch", "meer" }),
    "Das Meer rauscht langsam und bedaechtig. Ein beruhigendes Geraeusch.");
  AddSound( ({ "leute", "groehlen", "lieder", "trinklieder" }),          
    "Du hoerst: 'Alles hat ein Ende, nur die Knarkhwurst hat zwei.'");
    
  AddItem( NPC "outlaw" , REFRESH_DESTRUCT);
  AddItem( NPC "outlaw" , REFRESH_DESTRUCT);
  AddItem( NPC "outlaw" , REFRESH_DESTRUCT);

  AddExit( "norden", "./n_strand" );
  AddExit( "suedosten", "./s_strand" );
}
