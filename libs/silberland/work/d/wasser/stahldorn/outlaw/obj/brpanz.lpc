#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Bronzepanzer");
  SetProp(P_LONG, 
    "Ein sehr gewoehnlicher Brustpanzer aus Bronze. Beim Kampf gegen "
    "kleinere Gegner hilft er zwar sicher etwas, aber ein starker Feind "
    "wuerde ihn sicher schnell zerschmettern." );
  SetProp(P_NAME, "Bronzepanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "brustpanzer", "bronzepanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 18);
  SetProp(P_MATERIAL,([MAT_BRONCE:70,MAT_IRON:15,MAT_LEATHER:12,
     MAT_IRIDIUM:3]));
  SetProp(P_WEIGHT, 1900);
  SetProp(P_VALUE, 750);
}
