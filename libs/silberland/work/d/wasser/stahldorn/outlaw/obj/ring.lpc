#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein goldfarbener Ring");
  SetProp(P_LONG,
    "Ein unscheinbarer goldfarbener Ring. Die Farbe kann jedoch kaum "
    "darueber hinwegtaeuschen, dass der Ring eine plumpe Faelschung ist. "
    "Auch der gruene 'Smaragd', der darin eingearbeitet wurde besteht "
    "allem Anschein nach viel eher aus Glas..." );
  SetProp(P_NAME, "Ring");
  SetProp(P_NAME_ADJ, "goldfarben");
  SetProp(P_GENDER, MALE);
  AddId( ({"bronzering", "ring"}) );
  AddAdjective( ({"goldfarben", "goldfarbenen", "goldfarbener"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_BRONCE:20, MAT_LEAD:60, MAT_GLASS:20 ]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 170);
  SetProp(P_QUALITY_DECAY,400);
}
