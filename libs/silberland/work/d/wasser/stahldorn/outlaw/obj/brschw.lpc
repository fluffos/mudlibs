#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Bronzeschwert");
  SetProp(P_LONG, BS( 
    "Ein ziemlich einfaches Schwert aus Bronze. Der klobige Griff wurde "
    "mit einem Stoffstreifen umwickelt, um den Halt etwas zu verbessern. "
    "Die Schneide ist stumpf und schartig. "
    "Dieses Schwert gehoert sicherlich zur harmloseren Sorte.") );
  SetProp(P_NAME, "Bronzeschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "bronzeschwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 50);
  SetProp(P_WC_BONUS, (["wachposten":60]) );
  SetProp(P_DAMAGED, 60);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BRONCE:85, MAT_IRON:5, MAT_CLOTH:10]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 400);
}
