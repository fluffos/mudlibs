#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Dornenzweig");
  SetProp(P_LONG, BS( 
    "Dieser Zweig ist ueber und ueber mit Dornen besetzt, zwischen denen "
    "kleine hellgruene Blaetter spriessen. Er sieht irgendwie recht "
    "huebsch aus.") );
  SetProp(P_NAME, "Dornenzweig");
  SetProp(P_GENDER, MALE);
  AddId("zweig");
  AddId("dornenzweig");

  SetProp(P_MATERIAL, ([MAT_WOOD:40]) );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 0);
}
