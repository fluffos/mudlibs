#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein weiter Lodenmantel");
  SetProp(P_LONG, 
    "Du siehst einen praktischen Lodenmantel, der von guter Qualitaet "
    "und gediegener Verarbeitung ist. Man kann ihn sicher gut als Umhang "
    "verwenden. Allerdings hat der Mantel bereits ziemlich unter seinem "
    "achtlosen Besitzer gelitten, denn ueberall findest Du schaebige, "
    "abgewetzte Stellen, einige Flicken und Loecher. Ausserdem fehlen "
    "praktisch alle Knoepfe.");
  SetProp(P_NAME, "Lodenmantel");
  SetProp(P_GENDER, MALE);
  AddId( ({"mantel", "lodenmantel"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 3);
  SetProp(P_DAMAGED, 4);
  SetProp(P_MATERIAL,([MAT_CLOTH:15, MAT_FELT:80,MAT_WOOL:5]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:5, T_HEAT_PROT:-2 ]) );
}
