#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Stiefel");
  SetProp(P_LONG, 
    "Diese Lederstiefel haben eine duenne Gummisohle, damit man auf "
    "glatten Boeden nicht so leicht ausrutscht. Innen sind sie mit einem "
    "weichen Material ausgefuettert." );
  SetProp(P_NAME, "Paar Stiefel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel"}) );
  AddAdjective("paar");

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_GUM:15, MAT_LEATHER:60, MAT_FUR:25 ]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:-2]));
  SetProp(P_WEIGHT, 105);
  SetProp(P_VALUE, 330);
}
