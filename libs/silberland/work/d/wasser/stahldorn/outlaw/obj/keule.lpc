#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Bronzekeule");
  SetProp(P_LONG, 
    "Du siehst eine leichte Keule, die vollstaendig aus Bronze gegossen "
    "ist. Die Verarbeitung ist aeusserst schlampig. Ueberall finden sich "
    "Spuren der Abnutzung an der Keule. Die Oberflaeche ist uebersaet von "
    "Blutflecken, Beulen und Kratzern.");
  SetProp(P_NAME, "Bronzekeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "bronzekeule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 75);
  SetProp(P_DAMAGED, 45);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BRONCE:100]) );
  SetProp(P_WEIGHT, 750);
  SetProp(P_VALUE, 250);
  SetProp(P_QUALITY_DECAY,30);
}
