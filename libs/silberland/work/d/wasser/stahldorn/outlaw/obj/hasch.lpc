#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Stoffhandschuhe");
  SetProp(P_LONG, 
    "Die Handschuhe sind an der Rueckseite aus duennem Stoff, waehrend "
    "die Handflaeche mit Ledernoppen ausgepolstert ist." );
  SetProp(P_NAME, "Paar Stoffhandschuhe");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"handschuhe", "stoffhandschuhe"}) );
  AddAdjective("paar");

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_CLOTH:75, MAT_LEATHER:25 ]) );
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 100);
}
