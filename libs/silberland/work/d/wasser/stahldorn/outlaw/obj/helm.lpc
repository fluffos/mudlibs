#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Messinghelm");
  SetProp(P_LONG, 
    "Ein duenner, verbeulter Helm aus Messing." );
  SetProp(P_NAME, "Messinghelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "messinghelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 2);
  SetProp(P_DAMAGED, 2); 
  SetProp(P_MATERIAL, ([MAT_BRASS:100]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 300);
}
