#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

int anwendungen = 5;

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Tube Liebessalbe");
  SetProp(P_NAME, "Liebessalbe");
  SetProp(P_LONG, BS(
   "Eine 25ml Aluminiumtube mit haendisch hergestellter Liebessalbe "
   "darin. Du kannst sie benutzen, indem Du 'trage salbe auf' tippst. Sie "
   "reicht noch fuer @@QueryAnw@@ Anwendungen."));
  SetProp(P_GENDER, FEMALE);
  AddId( ({"liebessalbe", "tube", "salbe", "aluminiumtube"}));

  SetProp(P_MATERIAL, ({ MAT_METAL, MAT_PLANT }) );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_SMELL, "Die Salbe riecht unangenehm ranzig.\n");
  AddCmd( ({"trage", "trag"}), "salben");
}

int salben(string str)
{

  if (str != "salbe auf") return 0;
  if(present("\nliebe", TP))
  {
    write("Du bist doch schon voller Salbe!\n");
    return 1;
  }
  
  clone_object(QUESTPATH "liebe")->move(TP, M_NOCHECK);
  write("Du verteilst die uebelriechende Salbe auf Deinem Koerper.\n");
  say(TP->Name()+" reibt sich mit irgendeinem stinkenden Zeugs ein.\n");
  if(!--anwendungen) 
  {
    write(BS("Die Tube ist nun leer und loest sich aus umweltschutzgruenden "
             "sofort magisch auf. SCHWUPP."));
    remove();
  }
  
  return 1;
}

string QueryAnw() {return ""+anwendungen+"";}
