#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

mapping ingred;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Liste");

  SetProp(P_NAME, "Liste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"liste", "\nquestliste"}));

  SetProp(P_MATERIAL, ([MAT_PAPER:98, MAT_INK:2]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

  SetProp(P_NOSELL, "Dann wuestest Du ja gar nicht mehr, was Du dem "
                    "Alchemisten bringen solltest.");

  SetProp(P_NODROP, "Dann wuestest Du ja gar nicht mehr, was Du dem "
                    "Alchemisten bringen solltest.");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);

  AddCmd( ({"lies", "lese", "les"}), "cmd_lesen");

  ingred = ([ ]);
}

string _query_long()
{
  string s, key, *items;
  int i;

  items = m_indices(ingred);

  s = "Eine Liste mit Zutaten, die Du dem Alchemisten bringen sollst:\n\n";

  i = sizeof(items);
  while(i--)
  {
    s += sprintf("- %s %s\n",ingred[items[i],0],
                             (ingred[items[i],1]?"(erledigt)":""));
  }

  s += "\n"+BS("Wenn Du eine oder mehrere der Zutaten gesammelt hast, so "
       "bring sie dem Alchemisten im Hobbitdorf.")+"\n";

  return s;
}

int cmd_lesen(string str)
{
  if(!str || str == "") return 0;
  if(!id(str))          return 0;

  tell_object(TP, _query_long());
  return 1;
}

int IsListed(object ob)
{
  int i, found;
  string *items;

  items = m_indices(ingred);
  i     = sizeof(items);
  found = 0;

  while(i--)
  {
    if(ob->id(items[i])) found = 1;
  }

  return found;
}

void AddIngred(string key, string desc, string *similar_ids, string text)
{
  ingred += ([key:desc;0;similar_ids;text]);
}

int IsSimilar(object ob)
{
  int i, j, found;
  string *items, *ids;
  object pl;

  pl = find_player("ronja");
  if(!pl) return 0;

  items = m_indices(ingred);
  i     = sizeof(items);
  found = 0;

  while(i--)
  {
    ids = ingred[items[i],2];
    tell_object(pl,sprintf("Teste %O\n",ids));
    j   = sizeof(ids);
    while(j--)
    {
      tell_object(pl,sprintf("Teste %s\n",ids[j]));
      if(ob->id(ids[j])) found = 1;
    }
  }

  return found;
}

int IsMissing(object ob)
{
  int i, found;
  string *items;

  items = m_indices(ingred);
  found = 0;
  i     = sizeof(items);

  while(i--)
  {
    if(ob->id(items[i]) && (ingred[items[i],1] == 0)) found = 1;
  }

  return found;
}

mapping QueryList()
{
  return ingred;
}

void IngredDone(object ob)
{
  int i;
  string *items, key;

  items = m_indices(ingred);
  key   = "";
  i     = sizeof(items);

  while(i--)
  {
    if(ob->id(items[i]) && (ingred[items[i],1] == 0)) key = items[i];
  }

  if(key != "") ingred[key,1] = 1;
}

int QueryAllDone()
{
  int i, done;
  string *items;

  done  = 0;
  items = m_indices(ingred);
  i     = sizeof(items);

  while(i--)
  {
    if(ingred[items[i],1] == 1) done++;
  }

  if(sizeof(items) == done) return 1;
  return 0;
}

