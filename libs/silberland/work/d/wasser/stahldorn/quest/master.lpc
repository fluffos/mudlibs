#include "../def.h"

#define SAVEFILE QUESTPATH "master"
#define TEXTFILE QUESTPATH "questdaten.hpp"
#define BSI(x,y) break_string(x,78,y,1)

mapping questdata;

nosave object pl;

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  questdata = ([ ]);
  return;
}

void Msg(string s)
{
  if(interactive(pl))
  {
    tell_object(pl, BSI(s, "CMP: "));
  }
}

void Parse()
{
  string *lines, z, oldkey, key, shortname, diff, *tid, desc;
  string *sid, *stext;
  int nlines, i;

  if(interactive(this_interactive())) pl = this_interactive();

  lines = explode(read_file(TEXTFILE),"\n");
  nlines = sizeof(lines);

  Msg(sprintf("%d Zeilen eingelesen von %s",nlines, TEXTFILE));

  oldkey    = "";
  key       = "";
  shortname = "";
  diff      = "";
  tid       = ({ });
  desc      = "";
  sid       = ({ });
  stext     = ({ });

  for(i = 0; i < nlines; i++)
  {
    z = regreplace(lines[i],"^ *(.*[^ ]) *$","\\1",0);
    if(!((z[0..0] == "#") || (strlen(z) == 0)))
    {
      if(z[0..3] == "KID:")
      {
        key = z[4..]; if(oldkey == "") oldkey = key;

        if(oldkey != key)
        {
//          Msg(sprintf("1: %s : %s : %s",oldkey,shortname,diff));
//          Msg(sprintf("2: %O %s", tid, desc));
//          Msg(sprintf("3: %O", sid, desc));
//          Msg(sprintf("4: %O", stext));

          questdata += ([oldkey:shortname;diff;tid;desc;sid;stext]);
          oldkey = key;

          key       = "";
          shortname = "";
          diff      = "";
          tid       = ({ });
          desc      = "";
          sid       = ({ });
          stext     = ({ });
        }
      }

      if(z[0..3] == "NAM:") shortname = z[4..];
      if(z[0..3] == "DIF:") diff      = z[4..];
      if(z[0..3] == "TID:") tid      += explode(z[4..], ",");

      if(z[0..3] == "TEX:")
      {
        if(desc == "")
        {
          desc = z[4..];
        }
        else
        {
          desc = desc + " " + z[4..];
        }
      }

      if(z[0..3] == "SID:")
      {
        sid   += ({ explode(z[4..], ":")[0] });
        stext += ({ explode(z[4..], ":")[1] });
      }
   }
  }

  if(oldkey != key)
  {
//    Msg(sprintf("1: %s : %s : %s",oldkey,shortname,diff));
//    Msg(sprintf("2: %O %s", tid, desc));
//    Msg(sprintf("3: %O", sid, desc));
//    Msg(sprintf("4: %O", stext));
    questdata += ([oldkey:shortname;diff;tid;desc;sid;stext]);

  }

  Msg(sprintf("%O", questdata));

}
