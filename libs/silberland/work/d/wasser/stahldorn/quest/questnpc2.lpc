inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include "../def.h"
#include "./quest.h"

#define NEEDED_QUEST_ZUTATEN 4
#define BSI(x,y) break_string(x,78,y,1)
#define DBR(s) if(find_player("ronja")) tell_object(find_player("ronja"),"X: "+s+"\n")

string questanfang(string str);

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Alchemist");
  SetProp(P_LONG,
    "Der Alchemist ist zwar eindeutig ein Hobbit, doch fuer seine Rasse "
    "relativ grossgewachsen und sehr schlank. Ihm muss irgendetwas fehlen, "
    "denn ein schlanker Hobbit ist ein kranker Hobbit, wie schon das "
    "Sprichwort sagt. Sein laengliches Gesicht wird durch eine lustige "
    "Hakennase dominiert, die manchmal etwas tropft, wenn er schnell "
    "spricht, aufgeregt ist oder weint. Irgendetwas sagt Dir, dass der Name "
    "des Alchemisten \"Klaus\" lautet."
  );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:40]));

  SetProp(P_NAME, "Alchemist");
  SetProp(P_GENDER, MALE);

  AddId( ({ "alchemist", "klaus", "mann" , "NOWIMPY"}));
  AddClass(CL_HOBBIT);
  set_living_name("alchemist");

  create_default_npc(15);

  SetProp(P_XP, 0);
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 110);
  SetProp(P_WEIGHT, 45000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "Du wirst schlagartig von extremem Mitleid befallen "
                      "und brichst den Kampf ab.\n");
  SetProp(P_NOCORPSE, 0 );

  AddDetail( ({ "nase", "hakennase" }),
    "Starr den armen Mann doch nicht so an!\n");

  AddInfo(DEFAULT_INFO, "schaut Dich bloed an.\n");
  AddInfo("stahldorn", "Sein krankes Hirn hat mich ausgedacht.","sagt: ");

  AddInfo( ({"liste", "zutaten","hilfe"}), #'questanfang, "sagt: ");
  AddInfo( ({"stahltest"}), #'questanfang, "sagt: ");

  AddLibrary("/d/huegelland/raballion/hobbits/npc/infos.lib", 1);
  AddLibrary(QUESTPATH "questnpc.lib", 1, 1);
}

void SelectIngred(object liste)
{
  mapping alle_zutaten;
  string *items, key;
  int i, sum;

  alle_zutaten =
    (["skorpionbonbon":            "Ein Skorpionschwanzbonbon"      ; 1; ({"bonbon"}); "" //Felonia
     ,"eukalyptusbonbon":          "Ein Eukalyptus-Bonbon"          ; 1; ({"bonbon"}); "" //Felonia
     ,"\nholunderbeere":           "Eine Holunderbeere"             ; 1; ({ }); "" //Midas
     ,"kleeblatt":                 "Ein vierblaettriges Kleeblatt"  ; 1; ({ }); "" //Midas
     ,"karotte":                   "Eine Karotte"                   ; 1; ({ }); "" //Midas
     ,"biberfell":                 "Ein Biberfell"                  ; 1; ({ }); "" //Midas
     ,"otterfell":                 "Ein Otterfell"                  ; 1; ({ }); "" //Midas
     ,"haselnuss":                 "Eine Haselnuss"                 ; 1; ({ }); "" //Midas
     ,"rotblatt":                  "Ein Rotblatt"                   ; 1; ({ }); "" //Elsurion
     ,"wirselkraut":               "Ein Wirselkraut"                ; 1; ({ }); "" //Elsurion
     ,"papageienfeder":            "Eine Papageienfeder"            ; 1; ({ }); "" //Dschnugel Kueste
     ,"wasserschildkroetenei":     "Ein Wasserschildkroetenei"      ; 1; ({ }); "" //Dschungel Kueste
     ,"wasserschildkroetenpanzer": "Ein Wasserschildkroetenpanzer"  ; 1; ({ }); "" //Dschungel Kueste
     ,"kokosnuss":                 "Eine Kokosnuss"                 ; 1; ({ }); "" //Dschungel Plantage
     ,"zwergananas":               "Eine Zwergananas"               ; 1; ({ }); "" //Dschungel Plantage
     ,"passionsfrucht":            "Eine Passionsfrucht"            ; 1; ({ }); "" //Dschungel Plantage
     ,"bienenstachel":             "Ein Bienenstachel"              ; 1; ({ }); "" //Dschungel Plantage
     ,"salzstange":                "Ein Salzstangerl"               ; 1; ({ }); "" //Felonia
     ,"kipferl":                   "Ein Kipferl"                    ; 1; ({ }); "" //Felonia
     ,"goldnugget":                "Ein Goldnugget"                 ; 1; ({ }); "" //Zwergenminen Angrox
     ,"hagebutte":                 "Eine Hagebutte"                 ; 1; ({ }); "" //Derlim Raballion
     ,"hering":                    "Ein Hering"                     ; 1; ({ }); "" //Dschnugel Feyaria obj
     ,"sardine":                   "Eine Sardine"                   ; 1; ({ }); "" //Dschungel Feyaria obj
     ,"dornenzweig":               "Ein Dornenzweig"                ; 1; ({ }); "" //Wasser Stahldorn Outlaw
     ,"mondsteinei":               "Ein Mondsteinei"                ; 1; ({ }); "" //Kristallwald Sragola
     ,"zigarette":                 "Eine Zigarette"                 ; 1; ({ }); "" //Gebirge Monimor
     ,"marille":                   "Eine Marille"                   ; 1; ({ }); "" //Wasser Woody
     ,"apfel":                     "Ein Apfel"                      ; 1; ({ }); "" //Wasser Woody
     ,"gaensebluemchen":           "Ein Gaensebluemchen"            ; 1; ({ }); "" //Sargola Lichtung oder Wasser Woody obj
     ,"wiesenblume":               "Eine Wiesenblume"               ; 1; ({ }); "" //Bauernhof
     ,"dustyveilchen":             "Ein Dustyveilchen"              ; 1; ({ }); "" //Huegelland Feyaria
     ,"ribisel":                   "Eine Ribisel"                   ; 1; ({ }); "" //Woody Wasser
     ,"bierflasche":               "Eine Bierflasche"               ; 1; ({ }); "" //Lamuerte kyranda
     ,"fischbuechse":              "Eine Fischbuechse"              ; 1; ({ }); "" //Lamuerte kyranda
     ,"feenkraut":                 "Ein Straeusschen Feenkraut"     ; 1; ({ }); "" //Ronja Feen
     ,"rattenzahn":                "Ein Rattenzahn"                 ; 1; ({ }); "" //Dschnungel Dante weg weapon
     ]);

//    "Eine Kajuboknospe", "Ein kleiner Rubin",
//    "Ein Opalei","Ein Hasenbraten", "Eine Wurmhaut", "Eine Rothehaxe",

  items = m_indices(alle_zutaten);
  sum   = 0;

//  for(i=0; i < NEEDED_QUEST_ZUTATEN; i++)
  while(sum < NEEDED_QUEST_ZUTATEN)
  {
    key    = items[random(sizeof(items))];
    items -= ({ key });
    tell_object(find_player("ronja"),sprintf("id(%s) desc(%s)\n",key,alle_zutaten[key,0]));
    liste->AddIngred(key,alle_zutaten[key,0],alle_zutaten[key,2],alle_zutaten[key,3]);
    sum += alle_zutaten[key,1];
  }

  return;
}

string questanfang(string str)
{
  object liste;

  if(present("\nquestliste", TP))
  {
    return "Aber Du hast doch schon eine Liste von mir bekommen! Wenn Du "
           "schon Zutaten gesammelt hast, so gib sie mir doch einfach.";
  }

  if(TP->QueryProp(P_FROG))
  {
    return "Iiiiihh! Ein Frosch! Ich hasse Froesche!";
  }

  liste=clone_object(QUESTPATH "questobj2");
  liste->move(TP, M_PUT|M_NOCHECK|M_SILENT);

  SelectIngred(liste);

  if(!(TP->QueryQuest(QUESTKEY)))
  {
    write_file(QUESTPATH "questbeginn.log",
               dtime(time())+": "+TP->Name()+" beginnt die Quest.\n" );
  }

  return "Ja, also das waere wirklich nett von Dir, wenn Du mir helfen "
         "koenntest, "+CAP(getuid(TP))+". Ich hab hier bereits eine Liste "
         "von Dingen zusammengestellt, die ich brauche. Waerst Du bitte "
         "so lieb, und holst diese Sachen fuer mich? Du kannst sie mir "
         "auch einzeln bringen, und ich hake dann auf Deiner Liste ab, "
         "was Du schon gebracht hast.";
}

void give_notify(object ob)
{
  object liste;
  int ret;

  if(TP->QueryProp(P_FROG))
  {
    tell_room(MENV, "Der Alchemist sagt: Von Froeschen nehm ich nix!\n");
    ob->move(TP, M_GIVE);
    tell_object(TP, "Der Alchemist gibt Dir "+ob->name(WEN)+".\n");
    return;
  }

  liste = present("\nquestliste", TP);

  if(!liste || (liste->IsListed(ob) == 0))
  {
    tell_room(MENV, "Der Alchemist sagt: Was soll ich damit?\n");
    ob->move(TP, M_GIVE);
    tell_object(TP, "Der Alchemist gibt Dir "+ob->name(WEN,1)+" zurueck.\n");
    return;
  }

  if(!liste->IsMissing(ob))
  {
    tell_room(MENV, "Der Alchemist sagt: Aber das hast Du mir doch bereits "
                    "gebracht!\n");
    ob->move(TP, M_GIVE);
    write("Der Alchemist gibt Dir "+ob->name(WEN,1)+" zurueck.\n");
    return;
  }

  tell_room(MENV, BSI("Ah! Danke! Genau das hab ich gebraucht. Ich hake das "
                      "auf Deiner Liste als erledigt ab.",
                      "Der Alchemist sagt: "));

  liste->IngredDone(ob);
  ob->remove();

  if(liste->QueryAllDone())
  {
    tell_room(MENV, BSI("Du hast mir nun alle Zutaten gebracht. Ich danke "
                        "Dir, "+CAP(getuid(TP))+"!\n",
                        "Der Alchemist sagt erfreut: "));

    tell_object(TP, "Der Alchemist nimmt Dir die Liste ab.\n");

    liste->remove();

    ret = TP->GiveQuest(QUESTKEY);

    switch(ret)
    {
      case 1:
        write_file(QUESTPATH "questende.log",
                   dtime(time())+": "+TP->Name()+" loest die Quest.\n");

        write_file("/log/quests/liebessalbe",
                   dtime(time())+": "+TP->Name()+" loest die Quest.\n");

      case -1:
        tell_room(MENV, BSI("Weil Du mir so lieb geholfen hast, bekommst Du "
                            "von mir eine alte Liebessalbe, die ich vor "
                            "einiger Zeit einmal gemacht habe, die aber "
                            "nicht so gewirkt hat, wie ich gehofft habe. "
                            "Viel Spass damit. :)",
                            "Der Alchemist freut sich: "));

        tell_object(TP, "Der Alchemist gibt Dir die Liebessalbe.\n");
        clone_object(QUESTPATH "salbe.lpc")->move(TP, M_NOCHECK);
        break;

      default:
        tell_room(MENV, "Der Alchemist sagt: Hui, da buggt was: "+ret+"\n");
    }
  }
}



