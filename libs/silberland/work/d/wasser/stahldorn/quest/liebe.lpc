#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

#define TYP +typname+
#define OPFER +opfername+


int wirkung = 20 + random (5);

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, 0);
  AddId( ({"\nliebe"}));

  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);

  call_out("attract", random(5));

}

attract()
{
  object *leute, raum, typ, opfer;
  int leute_sum;

  if (!(typ=environment()) || !living(typ) || !(raum=environment(typ)))
  { 
    remove();
    return;
  }

//  DB("Wirkung: "+wirkung+" -- Typ: "+typ->name());
  if (!wirkung) 
  { 
    tell_object(typ, 
      "Du spuerst, dass die Wirkung der Salbe aufgehoert hat.\n");
    remove();
    return;
  }

  typ->SetProp(P_SMELL, typ->Name()+" riecht unangenehm ranzig.\n");
  wirkung--;
  leute = filter_array(all_inventory(raum), #'interactive);
  leute -= ({typ});
  if(leute_sum=sizeof(leute))
  {
    opfer=leute[random(leute_sum)];
    if(typ->QueryProp(P_GENDER) != opfer->QueryProp(P_GENDER))
      liebestext(typ, opfer, raum);
    else
      hasstext(typ, opfer, raum);
  }
  else
    einsamtext(typ);

  while(remove_call_out("attract") != -1);  //nur zur Sicherheit.
  call_out("attract", 5 + random (20));
  return;
}


void einsamtext(object typ)
{
  string *text;

  text = ({
//     "",
     "Eine Traene kullert Deine Wange hinunter, weil Du alleine bist.", 
     "Vielleicht solltest Du in ein Partnerinstitut gehen?",
     "Irgendwo auf der Welt wartet jemand auf DICH. Nur wo?",
     "Dir ist fad.",
     "Du sehnst Dich nach einem Partner.",
     "Du fuehlst Dich schrecklich einsam.",
     "Ach, wenn Du nicht so alleine waerst...",
     "Keiner mag Dich. Niemand kuemmert sich um Dich." });

  tell_object(typ, BS(text[random(sizeof(text))]));
  return;
}


void liebestext(object typ, object opfer, object raum)
{
  string *ttext, *otext, *etext;
  string typname, opfername;

  typname = typ->name();
  opfername = opfer->name();

  ttext = ({
     ""OPFER" sieht heute aber wieder verdammt gut aus!", 
     "Wow! "OPFER" hat Dich angelaechelt! Wie lieb!", 
     "Du siehst "OPFER" verliebt in die Augen.",
     "Ach ist das schoen, dass "OPFER" bei Dir ist!",
     "Du fuehlst Dich zu "OPFER" magisch hingezogen." });

  otext = ({
//     "", 
     ""TYP" streicht Dir zaertlich ueber den Arm.", 
     "Du magst es irgendwie, wie "TYP" Dich so ansieht.", 
     ""TYP" schaut Dich vertraeumt an. Dir wird ganz warm ums Herz.",
     "Du fuehlst Dich in Gegenwart von "TYP" so irrsinnig wohl.",
     "Du weisst es. Du fuehlst es. Du bist in "TYP" verliebt." });

  etext = ({
//     "", 
     ""TYP" und "OPFER" scheinen ja ziemlich interessiert aneinander zu sein.", 
     ""TYP" macht "OPFER" schoene Augen.", 
     ""TYP" baggert "OPFER" ungeniert an. "OPFER" schaut sogar total "+
       "gluecklich darueber drein.", 
     ""OPFER" und "TYP" umarmen sich innig.", 
     ""TYP" sieht "OPFER" verliebt in die Augen." });

  tell_object(typ, BS(ttext[random(sizeof(ttext))]));
  tell_object(opfer, BS(otext[random(sizeof(otext))]));
  tell_room(raum, BS(etext[random(sizeof(etext))]), ({opfer, typ}));
  return;

}

void hasstext(object typ, object opfer, object raum)
{
  string *ttext, *otext, *etext;
  string typname, opfername;

  typname = typ->name();
  opfername = opfer->name();

  ttext = ({
//     "", 
     "Aua! "OPFER" rempelt Dich ungehobelt an!", 
     ""OPFER" hat so ein seltsam geroetetes Gesicht...", 
     ""OPFER" sieht Dich eifersuechtig an.",
     ""OPFER" ruempft die Nase, weil Du so stinkst.",
     "Du fuehlst Dich in Gegenwart von "OPFER" aeusserst unwohl." });

  otext = ({
     ""TYP" will Dir anscheinend Konkurrenz machen. Du fuehlst Neid in Dir "
       "aufsteigen.", 
     "Wieso regt Dich die Gegenwart von "TYP" eigentlich so auf?", 
     ""TYP" stinkt wie eine Sau.",
     ""TYP" geht Dir gewaltig auf die Nerven.",
     "Du fuehlst irrationalen Zorn "TYP" gegenueber." });

  etext = ({
//     "", 
     ""OPFER" scheint "TYP" ja ueberhaupt nicht leiden zu koennen.", 
     "Warum schaut "OPFER" "TYP" immer so boese an?", 
     ""TYP" geht "OPFER" ein wenig aus dem Weg. Ist wohl besser so.", 
     ""OPFER" sieht "TYP" missbilligend an.", 
     ""OPFER" macht dumme Gesten hinter "TYP"s Ruecken." });

  tell_object(typ, BS(ttext[random(sizeof(ttext))]));
  tell_object(opfer, BS(otext[random(sizeof(otext))]));
  tell_room(raum, BS(etext[random(sizeof(etext))]), ({opfer, typ}));
  return;
}


int remove()
{
  object ob;

  if(objectp(ob=environment()) && living(ob))
     ob->SetProp(P_SMELL, 0);
  return ::remove();
}
