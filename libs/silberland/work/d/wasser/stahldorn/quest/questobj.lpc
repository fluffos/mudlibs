#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

string *zutaten;
mapping erledigt;

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Liste");
  SetProp(P_NAME, "Liste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"liste", "\nquestliste"}));

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
//  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_MAGIC, 1);

  AddCmd( ({"lies", "lese"}), "lesen");
}

int lesen(string str)
{
   if(id(str)) 
   {
     write(long());
     return 1;
   }
   return 0;
}

string long()
{
  string ret;
  int i;

  ret = "Eine Liste mit Zutaten, die Du dem Alchemisten bringen sollst:\n\n";
  for(i=0; i<sizeof(zutaten); i++)
  {
     ret += " - "+zutaten[i]+((erledigt[zutaten[i]])?("   (erledigt)"):"")+"\n";
  }
  ret += 
     "\nWenn Du eine oder mehrere der Zutaten gesammelt hast, so bring sie\n"
     +"dem Alchemisten im Hobbitdorf.\n";    
  return ret;
}

void SetZutaten(string *arg)
{
  int i;  
  
  erledigt = ([]);
  zutaten = arg;
  for (i=0; i<sizeof(zutaten); i++)
    erledigt[zutaten[i]] = 0;
  return;
}

string *QueryZutaten() { return zutaten; }

void SetZutatErledigt(string key) { erledigt[key] = 1; }

int QueryZutatErledigt(string key) { return erledigt[key]; }

int QueryErledigt() 
{ 
  int i, done;

  done = 1;
  for(i=0; i<sizeof(zutaten); i++)
  {
    if(!erledigt[zutaten[i]]) 
      done = 0;
  }
  return done;
}


mixed _query_autoloadobj()
{
  return ({erledigt, zutaten});
}

void _set_autoloadobj(mixed arg)
{
  if (sizeof(arg) > 1)
  {
    erledigt=arg[0];
    zutaten=arg[1];
  }
}
