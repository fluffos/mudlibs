#include "../def.h"

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <laden.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Alchemisten" );
  SetProp( P_INT_LONG, 
        "Du befindest Dich im Laden eines Alchemisten. Hier sieht es "
        "furchtbar unordentlich aus! Die Waende sind mit "
	"Regalen versehen, die jedoch alle fast leer sind. Ueberall "
	"steht unbrauchbares Geruempel herum. Die Luft ist durchsetzt mit "
        "dem Geruch von Alkohol und Schimmelpilz." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetStorageRoom (QUESTPATH "alchlager");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Der Alchemist");
  SetProp(P_SHOPKEEPER_ID, "alchemist");
  SetProp(P_SHOPKEEPER_GENDER, MALE);


  AddDetail( ({ "boden" }), BS(
    "Du siehst nichts interessantes am Boden.") );
  AddDetail( ({ "waende", "wand" }), BS(
    "Regale haengen an den Waenden.") );
  AddDetail( ({ "decke" }), BS(
    "Du siehst nichts besonderes an der Decke.") );
  AddDetail( ({ "regal", "regale", "last" }), BS(
    "Auf den Regalen liegt hauptsaechlich Staub herum. Dazwischen vergammeln "
    "ein paar alte Flaschen.") );
  AddDetail( ({"flaschen", "flasche"}), 
    "Die Flaschen sind entweder leer, kaputt oder mit verschimmelten "
    "Fluessigkeiten gefuellt. Nur ein paar einzelne Flaschen auf dem Regal "
    "hinter dem Alchemisten sehen noch neuer aus. Sie haben sogar kleine "
    "Etiketten, auf denen steht, was drinnen ist.");
  AddDetail( ({ "alchemist" }), BS(
    "Der ist grad nicht da. :(") );
  AddDetail( ({ "geruempel" }), BS(
    "Das Geruempel steht deswegen hier herum, weil im Hinterzimmer kein Platz "
    "mehr dafuer war. Du siehst hauptsaechlich Reagenzglaeser, Kocher, "
    "Flaschen und Petrischalen.") );
  AddDetail( ({ "petrischalen", "reagenzglaeser", "kocher" }), BS(
    "Lauter altes, kaputtes Zeug. Der Rost nagt daran und eingetrocknete "
    "Reste verleihen allem einen unappetitlichen Eindruck. Gebrauchen kann "
    "man davon sicher nichts mehr.") );
  AddDetail( ({ "etiketten", "etikett", "etiketts" }), BS(
    "Die Etiketten sind deshalb auf den Flaschen, damit man weiss, was drin "
    "ist. Du kannst sie lesen.") );
  AddReadDetail( ({ "etiketten", "etikett", "etiketts" }), 
    "ALKO! Reiner Alkohol in seiner edelsten Reinform! Inhalt: 96% Alkohol!" );
  AddDetail( ({ "fluessigkeiten" }), 
    "Die sind alle eingetrocknet, verschimmelt und nicht mehr interessant." );
  AddDetail( ({ "raum", "laden" }), 
    "Du befindest Dich im Laden eines Alchemisten." );
  AddDetail( ({ "staub", "schicht", "staubschicht" }), 
    "Ueber allem liegt eine dicke, fettige Staubschicht, die so richtig "
    "zum Ekeln herausfordert." );
  AddDetail( ({ "alkohol" }), 
    "Der ist wohl in den Flaschen drin, wenns schon draufsteht." );
  AddSmell( ({ DEFAULT_SMELL, "luft" }), 
    "\tEs riecht stark nach Alkohol und Schimmelpilz. \nUm nicht zu sagen: Es "
    "STINKT nach Alkohol und Schimmelpilz. \n" );
  AddSmell( ({ "alkohol" }), 
    "Der Alkoholgeruch stinkt etwa so, wie Dein Mundgeruch gestern frueh." );
  AddSmell( ({ "schimmel", "schimmelpilz" }), 
    "Widerlich muffig. Ungesund und grauslich." );
  AddDetail( ({ "schimmel", "schimmelpilz" }), 
    "Widerlich muffig. Ungesund und grauslich." );
  AddSmell( ({ "mundgeruch" }), 
    "Du solltest Dir oefter die Zaehne putzen! *wuerg*" );
  AddDetail( ({ "rost" }), 
    "Ja, der Rost scheint sich hier recht wohl zu fuehlen..." );


//  AddDetail( ({ "" }), 
//    "" );


  AddExit( "norden", "/d/huegelland/raballion/hobbits/room/westweg2" );
  AddItem( QUESTPATH "questnpc", REFRESH_DESTRUCT);

}

sell()
{
  notify_fail("Du kannst hier nichts verkaufen.\n");
  return 0;
}
force_sell() { return sell(); }
evaluate() { return sell(); }

