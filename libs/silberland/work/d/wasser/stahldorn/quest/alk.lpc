#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define DRINK_COST 20


create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Reiner Alkohol mit einer Flasche drumherum");
  SetProp(P_LONG, 
     "Eine Flasche, gefuellt mit reinem Alkohol (aus aestethischen Gruenden "
     "wurde er blau gefaerbt). An der Flasche ist ein Etikett befestigt.");
  SetProp(P_NAME, "Flasche" );
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_GLASS:20, MAT_ALCOHOL:77, MAT_WATER:3]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_NOBUY, 0);
  SetProp(P_VALUE, 400);
  AddId( ({"flasche", "alkohol", "alk"}) );

  AddCmd( ({ "trinke", "trink" }), "trinken");
  AddCmd( ({ "leere", "entleere" }), "leeren");

  AddDetail("etikett", "Du kannst es lesen!\n");
  AddReadDetail("etikett", "ALKO! Reiner Alkohol in seiner edelsten Reinform! "
              "Inhalt: 96% Alkohol!\n");

}

leeren(string str)
{
   if(id(str))
   {
      write("Du leerst den Inhalt der Flasche achtlos weg.\n" +
            "Die Flasche loest sich magisch auf.\n");
      say(TP->Name() + " leert eine Flasche aus.\n");
      RemoveCmd( ({"trinke", "leere", "entleere", "trink"}) );
      call_out("remove", 0);
      return 1;
   }
   notify_fail("Was willst Du ausleeren?\n");
   return 0;
}


trinken (string str)
{
  
  if (id(str))
  {
    if(TP->QueryProp(P_DRINK) > (TP->QueryProp(P_MAX_DRINK) - DRINK_COST))
    {
      notify_fail("So viel kannst Du nicht mehr trinken!\n");
      return 0;
    }

    if(TP->QueryProp(P_ALCOHOL) > (TP->QueryProp(P_MAX_ALCOHOL) / 2))
    {
      notify_fail("Du bist viel zu angesoffen dazu!\n");
      return 0;
    }

    say(TP->Name()+ " trinkt aus einer Flasche.\n");
    TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK) + DRINK_COST);
    write("Du trinkst eine Flasche puren Alkohol!\n"+
      "Das Zeug brennt die Kehle hinunter und laesst Dich um Luft ringen.\n"+
      "Du bist stockbesoffen!\n");
    TP->SetProp(P_ALCOHOL, TP->QueryProp(P_MAX_ALCOHOL));

    RemoveCmd( ({"trinke", "leere", "entleere", "trink"}) );
    call_out("remove", 0);
    return 1;
  }

  notify_fail("Was willst Du trinken?\n");
  return 0;
}
