inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"
#include "./quest.h"

#define NEEDED_QUEST_ZUTATEN 8

string questanfang(string str);

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Alchemist");
  SetProp(P_LONG, BS(
    "Der Alchemist ist zwar eindeutig ein Hobbit, doch fuer seine Rasse "
    "relativ grossgewachsen und sehr schlank. Ihm muss irgendetwas fehlen, "
    "denn ein schlanker Hobbit ist ein kranker Hobbit, wie schon das "
    "Sprichwort sagt. Sein laengliches Gesicht wird durch eine lustige "
    "Hakennase dominiert, die manchmal etwas tropft, wenn er schnell "
    "spricht, aufgeregt ist oder weint. Irgendetwas sagt Dir, dass der Name "
    "des Alchemisten \"Klaus\" lautet."));
  SetProp(P_NAME, "Alchemist");
  SetProp(P_GENDER, MALE);
  AddId( ({ "alchemist", "klaus", "mann" }));
  SetProp(P_XP, 0); // Bonus fuer Spells
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, 
    "\b\b\b\b\b\b\b\b\b\b\b\b\b\bDu wirst schlagartig von extremem Mitleid "
    "befallen und brichst den Kampf ab.\n");
  SetProp(P_NOCORPSE, 0 );

  AddDetail( ({ "nase", "hakennase" }), 
    "Starr den armen Mann doch nicht so an!\n");

  AddInfo(DEFAULT_INFO, "schaut Dich bloed an.\n");
  AddInfo("stahldorn", "Sein krankes Hirn hat mich ausgedacht.","sagt: ");
  AddInfo( ({"liste", "zutaten"}), #'questanfang, "sagt: "); 
  AddInfo( ({"stahltest"}), #'questanfang, "sagt: "); 
  
  AddLibrary("/d/huegelland/raballion/hobbits/npc/infos.lib", 1);
  AddLibrary(QUESTPATH "questnpc.lib", 1, 1);

//  SetProp(P_LOG_INFO, 1);

//  SUID;
}


string *ZutatenAuswahl()
{
  string *alle_zutaten;
  string *ret;
  int i, rand;

  ret = ({});
  alle_zutaten = ({
    "Dein Skorpionschwanz-Bonbon",   //Dusty's Bonbons
    "Dein Eukalyptus-Bonbon",   //Dusty's Bonbons
    "Ein vierblaettriges Kleeblatt",  //vor Midas
    "Eine Holunderbeere",   //in Midas bei Kirche
//    "Eine Kajuboknospe",    //Strand bei Tijara (schwer zu finden)
    "Ein rotes Blatt",  //kann man beim Elsurion kaufen
    "Eine Karotte",    //hat das Kaninchen im Silberwald (killen)
    "Ein Salzstangerl",   //Baeckerei in Felonia
    "Ein Kipferl",   //Baeckerei in Felonia
    "Ein Goldnugget",   //Zwergenminen
//    "Ein kleiner Rubin",   //Zwergenminen
    "Ein Mondsteinei",   //bei den Quarzschroetern im Kristallwald 
//    "Ein Opalei",   //irgendwo in Sargolas Kristallwald... 
    "Eine Zigarette",    //Zigarettenautomat Seelenklamm
    "Ein Gaensebluemchen",   //Blumen am Weg zum Obstgarten
    "Ein roter Hering",     //muss man Anfang der Alrik-Quest machen
                            //ODER am Fischerboot (Tijara) fischen
    "Eine gelbe Sardine",   //Fischerboot fischen
    "Ein Straeusschen Wirselkraut",   //hat Elsurion (ist aber relativ teuer)
    "Eine Zwergananas",  //Plantage von Dante
    "Eine Marille",    //Obstgarten beim Fischerdorf
    "Ein Apfel",    //Kyranda  oder  Obstgarten beim Fischerdorf
    "Eine ganz spezielle Passionsfrucht",   // Plantage von Dante
    "Eine grosse runde Kokosnuss",  //Palme in Dantes Dschungel
    "Ein Otterfell",   //Silberwald
    "Ein Biberfell",   //Silberwald
    "Eine schoene Wiesenblume",   //Bauernhof von Rohkopfrex
    "Ein Dustyveilchen",   //am Westweg
//    "Ein Schleimbaellchen",  //Feenschloss von Trogor
    "Eine rote Ribisel",   //Obstgarten beim Fischerdorf
    "Eine Bierflasche",  //Kyranda  (Besoffenen umnieten)
    "Eine Fischbuechse",  //Kyranda (im Tuempel)
//    "Ein Hasenbraten",  //Thors Felsplateau
    "Ein Wasserschildkroetenei",   //Schildkroete Felseninsel
    "Ein Wasserschildkroetenpanzer",   //Schildkroete Felseninsel
    "Ein Dornenzweig",  //Vogelfreienlager
    "Eine bunte Papageienfeder",  //Kuestenweg Tijara
    "Eine Haselnuss",  //Eichhoernchen oder Derlim
    "Eine Hagebutte",  //Derlim
//    "Eine Wurmhaut",   //Dhrkion
//    "Eine Rothehaxe",  //Dhrkion
    "Ein ahn",  // Dschungel oder Kyranda
    "Ein Bienenstachel", // Dschungel oder kristallwald
//    "Ein Straeusschen Feenkraut", // Feenschloss (nur mehr extrem schwer zu finden weil ronja es fast ueberall abgehaengt hat.. Feyaria)
     });

  for (i=0; i < NEEDED_QUEST_ZUTATEN; i++)
  {
    rand=random(sizeof(alle_zutaten));
    ret += ({ alle_zutaten[rand] });
    alle_zutaten -= ({ alle_zutaten[rand] });
    /* Es werden 8 Zutaten zufaellig ausgewaehlt.
       Vielleicht einmal erweitern/verbessern auf 8 Zutaten aus 8 verschiedenen
       Gruppen (zB eine Gruppe Dante-Fruechte, eine Gruppe Woody-Fruechte...) */
  }
  return ret;
}


string questanfang(string str)
{
  object liste;
  string *zutaten;

  if(present("\nquestliste", TP))
  {
    return 
      "Aber Du hast doch schon eine Liste von mir bekommen! " +
      "Wenn Du schon Zutaten gesammelt hast, so gib sie mir doch einfach.";
  }

  if(TP->QueryProp(P_FROG))
    return  "Iiiiihh! Ein Frosch! Ich hasse Froesche!";
  
  liste=clone_object(QUESTPATH "questobj");
  liste->move(TP, M_NOCHECK);
  if(str == "stahltest" && TP == find_player("stahldorn"))
    liste->SetZutaten( ({"Eine Fackel"}) );
  else
    liste->SetZutaten(ZutatenAuswahl());

   if(!(TP->QueryQuest(QUESTKEY)))
     write_file(QUESTPATH "questbeginn.log", 
        dtime(time())+": "+TP->Name()+" beginnt die Quest.\n" );

  return
     "Ja, also das waere wirklich nett von Dir, wenn Du mir helfen "+
     "koenntest, "+CAP(getuid(TP))+". Ich hab hier bereits eine Liste von "+
     "Dingen zusammengestellt, die ich brauche. Waerst Du bitte so lieb, und "+
     "holst diese Sachen fuer mich? Du kannst sie mir auch einzeln bringen, "+
     "und ich hake dann auf Deiner Liste ab, was Du schon gebracht hast.";
}


give_notify(object ob)
{
   object liste;
   string ob_short;

   if(TP->QueryProp(P_FROG))
   {
      tell_room(MENV, 
         "Der Alchemist sagt: Von Froeschen nehm ich nix!\n");
      ob->move(TP, M_GIVE);
      write("Der Alchemist gibt Dir "+ob->name(WEN)+".\n");
      return;
   }

   if(objectp(liste=present("\nquestliste", TP)) && 
      member(liste->QueryZutaten(), ob_short=ob->QueryProp(P_SHORT)) > -1)
   {
     if(liste->QueryZutatErledigt(ob_short))
     {
        tell_room(MENV, 
         "Der Alchemist sagt: Aber das hast Du mir doch bereits gebracht!\n");
        ob->move(TP, M_GIVE);
        write("Der Alchemist gibt Dir "+ob->name(WEN)+".\n");
//        return;
     }
     else
     {
        tell_room(MENV, 
          "Der Alchemist sagt: Ah! Danke! Genau das hab ich gebraucht.\n"+
          "Der Alchemist sagt: Ich hake das an Deiner Liste als erledigt "+
          "ab.\n");
        liste->SetZutatErledigt(ob_short);
        ob->remove();

        if(liste->QueryErledigt())
        {
          tell_room(MENV, 
            "Der Alchemist sagt: Du hast mir nun alle Zutaten gebracht.\n"+
            "Der Alchemist sagt: Ich danke Dir, "+CAP(getuid(TP))+"!\n"+
            "Der Alchemist nimmt Dir die Liste ab.\n");
          liste->remove();

          /*
              QUEST VERGEBEN!
          */

          switch(this_player()->GiveQuest(QUESTKEY)) {
          case 1:
           write_file(QUESTPATH "questende.log", 
              dtime(time())+": "+TP->Name()+" loest die Quest.\n" );
               // Log in /log/quests eingebaut (Angrox)
           write_file("/log/quests/liebessalbe",
              dtime(time())+": "+TP->Name()+" loest die Quest.\n" );
           
          case -1:
          tell_room(MENV, 
            "Der Alchemist sagt: Weil Du mir so lieb geholfen hast, bekommst\n"+
            "Der Alchemist sagt: Du von mir eine alte Liebessalbe, die ich\n"+
            "Der Alchemist sagt: vor einiger Zeit einmal gemacht habe, die \n"+
            "Der Alchemist sagt: aber nicht so gewirkt hat, wie ich gehofft\n"+
            "Der Alchemist sagt: habe. Viel Spass damit. :)\n"+
            "Der Alchemist gibt Dir die Liebessalbe.\n");
          clone_object(QUESTPATH "salbe.lpc")->move(TP, M_NOCHECK);
          break;
          default: tell_room(MENV, "Der Alchemist sagt: Hui, da buggt was.\n");
          }
        }
//        return;
     }
   }

   else
   {
      tell_room(MENV, "Der Alchemist sagt: Was soll ich damit?\n");
      ob->move(TP, M_GIVE);
      write("Der Alchemist gibt Dir "+ob->name(WEN)+".\n");
//      return;
   }
}

