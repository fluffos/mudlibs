#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#define HB_ON 1
#define HB_OFF 0
#define MAX_LASTMOVES 90    

int lastmov=0;
int hb=1;
string *felder=({});


heart_beat()
{
  rotate_fire();

  if(lastmov >= MAX_LASTMOVES)
  {
    if (!is_empty()) 
      lastmov=0;
    else
    {
      hb=0;
      set_heart_beat(HB_OFF);
    }
  }
  lastmov++;
}

int is_empty()    
{
    int i,j;
    string *allinv;

    for(i=0;i<4;i++)
    {             
      allinv=all_inventory(felder[i]);
      for(j=sizeof(allinv)-1, j>=0, j--)
      {
        if(interactive(allinv[j]))
          return 0;
      }
    }
    return 1;
}

init_check(string raum)
{
  if(!hb) 
  {
    hb=1;
    set_heart_beat(HB_ON);
  }
  lastmov=0;
}



