#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Stueck Schnur");
  SetProp(P_LONG,
    "Ein einfaches, ungefaehr 20 Zentimeter langes Stueck Schnur.\n" );
  SetProp(P_NAME, "Schnur");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_WOOL );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 0);
  AddId( ({"lunte", "schnur", "zuendschnur", "\nlunte" }) );
}


