#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein gehoernter Knarkhhelm");
  SetProp(P_LONG, BS( 
    "Dieser Helm ist viel schwerer als die andern Knarkhhelme. Ausser dem "
    "Schutz fuer die Nase wurde er noch an den Seitenwaenden verstaerkt "
    "und oben befinden sich 2 spitze Hoerner.") );
  SetProp(P_NAME, "Knarkhhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "knarkhhelm"}) );
  AddAdjective ("gehoernter");

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL,([MAT_STEEL:50,MAT_IRON:30,MAT_LEATHER:10,MAT_HORN:10]));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_EFFECTIVE_WC, 80+random(20) );  // gehoernter Helm soll mehr 
                                 // Schaden beim Kopfstoss machen.   Feyaria
}

