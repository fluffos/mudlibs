

//  kleines Bugfixing bei "mken" Funktion
//  05.10.2019 -> Eros



#include "../def.h"
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Maulkorb");
  SetProp(P_LONG, BS(
    "Du siehst einen gewoehnlichen Maulkorb fuer Hunde. Wenn man einem Hund "
    "so ein Ding anlegt, kann er nicht mehr beissen.") );
  SetProp(P_INFO, 
     "Die Syntax lautet 'maulkorbe <gegner>' oder 'mk <gegner>'.\n");
  SetProp(P_NAME, "Maulkorb");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 120);
  AddId( ({"maulkorb", "korb", "\nMaulkorb"}) );
  AddCmd( ({"mk", "maulkorbe"}), "mken");
}

mken(string str)
{
   object hund;

   if(!present("hund", ENV(TP)))
   {
     notify_fail("Hier ist kein Hund.\n");
     return 0;
   }


   if (!str)
   {
     notify_fail("Wem moechtest Du den Maulkorb umlegen?\n");
     return 0;
   }

   hund = present(str, ENV(TP));

   if(!hund) 
   {
     notify_fail("Sowas siehst Du hier nicht.\n");
     return 0;
   }

   if (hund->id(str) && hund->id("hund"))
   {

      if(present("\nMaulkorb", hund))
      {
         notify_fail("Aber "+hund->name()+" hat doch schon einen Maulkorb!\n");
         return 0;
      }

      if(random(80) < TP->QueryAttribute(A_DEX)*3)
      {
        write("Du legst "+ hund->name(WEM)+" einen Maulkorb an.\n");
        say(TP->Name()+" legt "+hund->name(WEM)+" einen Maulkorb an.\n");
        move(hund, M_NOCHECK);
      }
      else
      {
         write(BS(
            "Du versuchst, "+ hund->name(WEM)+" einen Maulkorb anzulegen, "
            "aber bist nicht geschickt genug. Der Hund beisst Dich in die "
            "Hand."));
         TP->do_damage(10+random(10));
         say(TP->Name()+" wird von "+hund->name(WEM)+" in die Hand gebissen.\n");
      }
      return 1;
   }
  notify_fail("Das ist kein Hund!\n");
  return 0;
}

