#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Powerstiefel");
  SetProp(P_LONG, BS( 
    "Die Powerstiefel heissen nicht von ungefaehr so. Sie sind mit "
    "Metallsporen und Eisenbeschlaegen versehen und ziemlich schwer.") );
  SetProp(P_NAME, "Paar Powerstiefel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel", "powerstiefel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ({MAT_LEATHER, MAT_METAL, MAT_IRON}) );
  SetProp(P_WEIGHT, 950);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

}

