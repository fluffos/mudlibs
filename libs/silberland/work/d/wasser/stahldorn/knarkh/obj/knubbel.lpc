#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Holzknubbel");
  SetProp(P_LONG, BS(
    "Das ist ein hoelzerner Knubbel, der anscheinend irgendwo abgerissen "
    "wurde. Die fein gemaserte Mahagonioberflaeche absorbiert das meiste "
    "Licht, das darauf faellt. Trotz seiner feinen Verarbeitung ist er "
    "eigentlich zu nichts nuetze und stellt nur Ballast dar.") );
  SetProp(P_NAME, "Knubbel");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 450);
  SetProp(P_VALUE, 50);
  AddId( ({"knubbel", "holzknubbel"}) );
}


