#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Powerpanzer");
  SetProp(P_LONG, BS( 
    "Dieser Panzer muss einem starken Krieger gehoeren. Vorne ziert ihn "
    "ein riesiger aufgemalter Totenkopf. Der Powerpanzer ist ausserdem "
    "thermoverstaerkt und innen mit Leder ausgepolstert.") );
  SetProp(P_NAME, "Powerpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "powerpanzer"}) );
  SetProp(P_INFO, BS(
    "Der Powerpanzer ist thermoverstaerkt. Einerseits ist er gut gefuettert "
    "und waermt, andererseits wurde ein ausgekluegeltes System zur Kuehlung "
    "eingebaut, falls die Temperatur zu stark ansteigt."));

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 35);
  SetProp(P_MATERIAL, ([MAT_LEATHER:10, MAT_STEEL:80, MAT_ASBESTOS:10]) );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 3500);
  SetProp(P_NOBUY, 1);
//  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)
                            + ([DT_FIRE:1, DT_COLD:1]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:6, T_HEAT_PROT:2 ]) );

  AddDetail( ({ "kopf", "totenkopf" }), 
    "Der Totenkopf hat grosse, leere Augenhoehlen voller Hass auf alles "
    "Gute.");

}
