#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <exploration.h>

#define HORNLANG \
  "Am Kopf hat jemand zwei spitze Hoerner befestigt.\n"
#define KLAULANG \
  "An den Beinen hat jemand scharfe Klauen befestigt.\n"
#define REISSLANG \
  "Jemand hat das Gesicht mit dolchartigen Reisszaehnen gespickt.\n"
#define FLUEGLANG \
  "Anstelle von Armen hat jemand zwei Fluegel an die Statue geklebt.\n" 


mapping teile;


create()
{
  if (!is_clone(TO) )  return;
  ::create();

  teile=( ["fluegel":0, "hoerner":0, "klauen":0, "reisser":0]);
  
  SetProp(P_SHORT, "Eine seltsame Statue");
  SetProp(P_LONG, BS( 
    "Mitten auf dem Platz steht diese seltsame Statue. Der Koerper " 
    "macht einen aeusserst kaputten Eindruck. Er ist uebersaet von "
    "Schrammen und Kratzern, und eine dicke Patina hat sich auf der "
    "Statue abgelagert. Aber selbst wenn man sich all die Beschaedigungen "
    "und den Dreck wegdenkt, saehe sie nicht wie eine normale Statue aus. "
    "Eigentlich muesste man sie eher als Torso bezeichnen, denn die Beine "
    "bestehen nur aus kurzen, abgeschlagenen Stummeln, und die Arme fehlen "
    "voellig. Der Kopf ist von einer eigenartigen, ja nichtssagenden "
    "Ausdruckslosigkeit. Das Gesicht fehlt. Alles sieht so aus, als "
    "ob es entweder unfertig oder uralt waere.\n") );
  SetProp(P_INFO, BS(
    "Eine geheimnisvolle Aura umgibt die Statue. Wer weiss, vielleicht "
    "koennte man sie irgendwie zum Leben erwecken?") );
  SetProp(P_NAME, "Statue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_MARBLE );
  SetProp(P_WEIGHT, 2000000);
  SetProp(P_NOGET, BS( 
    "Die Statue besteht aus tonnenschwerem Marmor und ist am Boden fest "
    "verankert. Du kannst sie unmoeglich nehmen.") );
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 30000);
  AddId( ({"statue", "\nStatue"}) );
  
  AddDetail( ({ "koerper", "torso" }), BS(
    "Der Koerper der Statue sieht uebel mitgenommen aus. Die Gliedmassen "
    "fehlen beinahe zur Gaenze. Viele Beschaedigungen weisen darauf hin, "
    "dass der Zahn der Zeit hier herumgenagt hat."));
  AddDetail( ({ "marmor" }),
    "Die Statue besteht aus Marmor.");
  AddDetail( ({ "stummel", "stummeln", "gliedmassen", "beine", "arme" }),
    "Die Arme fehlen voellig und die Beine sind nur noch als Stummeln "
    "vorhanden.\n");
  AddDetail( ({ "beschaedigungen", "kratzer", "schrammen" }),
    "Sie ueberziehen die Statue wie ein dichtgeaesteltes Labyrinth.\n");
  AddDetail( ({ "patina" }), BS(
    "Die Statue muss wirklich alt sein, wenn sich eine dermassen dicke "
    "Patina hat anlagern koennen."));
  AddDetail( ({ "kopf", "gesicht" }), BS(
    "Der Kopf und das Gesicht sind blank und leer. Kein Ausdruck, keine "
    "Haare oder gesichtsspezifische Merkmale finden sich daran. Entweder "
    "fiel das im Laufe der Aeonen der Erosion zum Opfer, oder aber der "
    "Kuenstler hat es absichtlich nicht ausgearbeitet, um Platz zu lassen "
    "fuer eine eigene Persoenlichkeit, die erst spaeter in die Statue "
    "einziehen wuerde."));
  AddDetail( ({ "aura" }),
    "Die");
  
//  AddDetail( ({ "" }),
//    "");

  AddCmd( "befestige", "befestigen");
}

string longplus(string was)
{
  switch(was)
  {
    case "fluegel": return FLUEGLANG;
    case "hoerner": return HORNLANG;
    case "reisser": return REISSLANG;
    case "klauen": return KLAULANG;
  }
}

metamorphose()
{
     CLONEOB( OBJ "figurine")->move(ENV(TO), M_NOCHECK);
     tell_room(MENV, BS(
       "Die Statue erstrahlt ploetzlich in gleissendem Licht, das Dir in "
       "Deinen Augen wehtut. Als Du wieder richtig sehen kannst, bemerkst "
       "Du, dass die Statue verschwunden ist. An ihrer Stelle liegt "
       "eine kleine, unbedeutende Statuette am Boden, die genauso aussieht"
       ", wie die Statue, bevor sie verschwunden ist.") );
      remove();
}


befestigen(string *str)
{
  string was;
  object wasobj;
  mixed msg;

  notify_fail("Was willst Du Woran befestigen?\n");
  str=explode(str, " ");
  if (sizeof(str) < 3) return 0;
  was=str[0];
  if ( (str[1]=="an") && (str[2]=="statue") )
  {
    notify_fail("Was willst Du an der Statue befestigen?\n");
    wasobj=present(was, TP);
    if (!wasobj) wasobj=present(was, ENV(TO));

    if (member(teile, was))
      notify_fail("Aber Du hast doch gar keine "+CAP(was)+"!\n");

    if (!wasobj)
      return 0;

    if (msg = wasobj->QueryProp(P_NODROP)) {
      if (stringp(msg))
        notify_fail(msg);
      else
        notify_fail("So wirst Du " + wasobj->name(WEN,1) + " nicht los!\n");
      return 0;
    }

    notify_fail(
      "Aber es sind doch schon "+CAP(was)+" an der Statue befestigt!\n");
    if(teile[was]) return 0;

      if (!teile[was])
      {
	teile[was]=1;
	AddDetail(wasobj->QueryProp(P_IDS), 
		  wasobj->QueryProp(QueryProp(P_LONG)));
	wasobj->remove();
	SetProp(P_LONG, QueryProp(P_LONG) + longplus(was));
	write("Du befestigst die "+CAP(was)+" an der Statue.\n");
	say (TP->Name() +" befestigt "+CAP(was)+" an der Statue.\n");
	if (teile["fluegel"] && teile["hoerner"]
	  && teile["klauen"] && teile["reisser"])
	    call_out("metamorphose", 1);
      return 1;
      }
  }
  return 0;
}

string _query_info()
{
  EPMASTER->GiveExplorationPoint("identifizieren");
  return Query(P_INFO);
}
