#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein langes Knarkhschwert");
  SetProp(P_LONG, BS( 
    "Ein langes Schwert eines Knarkhisten. Sieht relativ uninteressant aus.") );
  SetProp(P_NAME, "Knarkhschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "knarkhschwert"}) );
  AddAdjective( "langes" );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 145 + random (30));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON:90, MAT_CLOTH:10]) );
  SetProp(P_WEIGHT, 1900);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 0);


}


