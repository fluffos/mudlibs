#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Knarkhstiefel");
  SetProp(P_LONG, BS( 
    "Du siehst ein Paar feste Stiefel. Gut aber gewoehnlich. ") );
  SetProp(P_NAME, "Paar Knarkhstiefel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel", "knarkhstiefel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_LEATHER:90, MAT_GUM:10, MAT_BRASS:10]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 0);

}

