#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Panzerplatte");
  SetProp(P_LONG, BS( 
    "Diese Platte ist mit einer Kette versehen, sodass man sie um den Hals "
    "haengen kann, und sie dann vor der Brust baumelt. Die Stabilitaet "
    "dieses Dings ist zwar recht hoch, aber da ueberall freie, ungeschuetzte "
    "Stellen offenliegen, sollte man sich nicht allzusehr auf seinen "
    "Schutz verlassen.") );
  SetProp(P_NAME, "Panzerplatte");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"panzer", "platte", "panzerplatte"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_STEEL:70, MAT_IRON:30]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);

}

