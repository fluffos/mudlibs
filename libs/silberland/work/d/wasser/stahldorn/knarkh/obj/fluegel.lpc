#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Die Fluegel der gefluegelten Bestie");
  SetProp(P_LONG, BS( 
    "Die Fluegel erinnern von Form, Farbe und Aussehen her stark an "
    "Drachenfluegel. An den Enden stecken winzige aber messerscharfe "
    "Krallen. Die Fluegelhaut ist an manchen Stellen lichtdurchlaessig "
    "und man kann viele dunkelrote Aederchen darin erkennen.") );
  SetProp(P_INFO, BS(
    "Obwohl Du eigentlich nichts damit anzufangen weisst, widerstrebt "
    "es Dir, die Fluegel wegzuwerfen.") );
  SetProp(P_NAME, 
    ({"die Fluegel", "der Fluegel", "den Fluegeln", "die Fluegel"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL,([MAT_MISC_DEAD:10,MAT_HORN:5,MAT_BONE:20,MAT_FLESH:10,MAT_SKIN:55]));
  SetProp(P_WEIGHT, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 3000);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId( ({"fluegel"}) );

  AddDetail( ({ "enden", "krallen", "krallenhaende" }), 
      "An den Enden der Fluegel sitzen messerscharfe Krallenhaende, mit denen "
      "die gefluegelte Bestie ihren Gegnern die Eingeweide herausreissen "
      "konnte... ");
  AddDetail( ({ "haut", "fluegelhaut", "stellen" }), 
      "Die Haut der Fluegel fuehlt sich glatt und ledrig an. An vielen "
      "Stellen kann man beinahe hindurchsehen, so duenn ist sie.");
  AddDetail( ({ "aederchen", "adern" }), 
      "Sie haben wohl den Fluegel mit Blut versorgt.\n");
  AddDetail( ({ "form", "farbe", "aussehen" }), 
      "Erinnert Dich an Drachenfluegel.\n");
//  AddDetail( ({ "" }), 
//      "");

}


