#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  call_out("plumps", 40 + random (40));
  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "Runterfallen");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_KILL_NAME, "Absturz");
  AddId("\nPlumpser");

}

plumps()
{
  object ob;
  ob=MENV;
  if(objectp(ob) && living(ob) && objectp(ENV(ob)) && 
                    file_name(ENV(ob)) == ROOM "balance")
  {
     write ("Du kannst Dich nicht mehr halten und stuerzt ab.\n");
     ob->move(ROOM "dorf_g3", M_GO | M_NO_SHOW, "in die Tiefe", 
       "stuerzt ab und faellt", "kracht am Boden auf");
     write("Aua! Schmerzhaft schlaegst Du am Boden auf.\n");
     ob->do_damage(10 + random(30));
  }
  remove();
}
