#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Stachelhalsband");
  SetProp(P_LONG, BS( 
    "Ein mit vielen Stacheln besetztes Hundehalsband aus Leder. Man koennte "
    "es als Amulett verwenden.") );
  SetProp(P_NAME, "Stachelhalsband");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"halsband", "band", "stachelhalsband", "hundehalsband"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_COPPER:20, MAT_LEATHER:80]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 0);

}

