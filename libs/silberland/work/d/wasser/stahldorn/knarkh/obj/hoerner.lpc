#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Die Hoerner der gehoernten Bestie");
  SetProp(P_LONG, BS( 
    "Du siehst zwei lange und leicht gekruemmte Hoerner. An den Enden "
    "sind sie scharf zugespitzt und dunkel gefaerbt.") );
  SetProp(P_INFO, BS(
    "Obwohl Du eigentlich nichts damit anzufangen weisst, widerstrebt "
    "es Dir, die Hoerner wegzuwerfen.") );
  SetProp(P_NAME, 
    ({"die Hoerner", "der Hoerner", "den Hoernern", "die Hoerner" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_HORN:95, MAT_SKIN:5]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 3000);
  SetProp(P_AUTOLOADOBJ, 1);

  AddId( ({"hoerner", "horn"}) );

  AddDetail( ({ "enden", "spitzen" }), 
      "Die Enden der Hoerner sind extrem spitz.\n");
//  AddDetail( ({ "" }), 
//      "");

}


