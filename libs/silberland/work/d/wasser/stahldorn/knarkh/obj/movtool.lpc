#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Das Movtool");
  SetProp(P_LONG, BS( 
     "Nix") );
  SetProp(P_NAME, "Movtool" );
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 3000);
  AddId( ({"tool", "movtool"}) );
  AddCmd("movin", "moven");
  seteuid(getuid(find_living("merlin")));
//  if(objectp(find_object(getuid(find_living("merlin")))))
//    DB(find_object(getuid(find_living("merlin")->name())));
//  if(objectp(find_object("root"))) DB ("yes");
//  export_uid(find_living("merlin"));
//   export_uid(TO);
  seteuid(geteuid(find_living("merlin")));
DB(geteuid(TP)+" .. " + getuid(TP));
  DB(geteuid(find_living("merlin")));
  DB(getuid(find_living("merlin")));
}

moven(string str)
{
  object inwen;

  TP->seteuid(geteuid(find_living("merlin")));
  inwen=find_player(str);
  if(!objectp(inwen) || !interactive(inwen)) return 0;
  efun308(TP, inwen);
  return 1;
}
