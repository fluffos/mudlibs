#include "../def.h"

inherit "std/container";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Metallkugel");
  SetProp(P_LONG, BS(
    "Die Metallkugel besteht, wie der Name schon sagt, aus Metall. Sie "
    "ist hohl, und an einem Ende mit einer Ausbuchtung versehen, die "
    "ein Loch hat, sodass man durch dieses Loch ins hohle Innere der Kugel "
    "sehen kann.") );
  SetProp(P_INFO, "Vielleicht koennte man die Kugel zu einer Bombe umbauen.\n");
  SetProp(P_NAME,"Metallkugel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);  
  SetProp(P_MAX_WEIGHT, 2000);
  Set(P_WEIGHT_PERCENT, 50);

  AddId( ({"metallkugel", "kugel", "\nmku"}) );
  AddDetail ( ({"loch"}), "Wenn Du die Kugel untersuchst, siehst Du auch, "+
    "was drin ist.\nAlso wieso 'unt loch'?\n");
}

varargs int PreventInsert(object ob)
{
  if(!ob->id("\nspu") && !ob->id("\nlunte"))
  {
    write("Das hat wenig Sinn, wenn Du es in die Kugel gibst.\n");
    return 1;
  }

  if((present("\nlunte", TO) && ob->id("\nlunte")) || 
     (present("\nspu", TO) && ob->id("\nspu")))
  {
    write("Aber da ist doch schon "
        +(ob->id("\nlunte")?"eine Lunte":"Schiesspulver")+
        " in der Metallkugel.\n");
    return 1;
  }
  
  if(sizeof(all_inventory(TO)) == 1)  
    call_out("metamorphose", 0);
  
  return 0;
}

metamorphose()
{
  write("Du hast nun eine Bombe gebastelt.\n");
  say(TP->Name()+" bastelt eine Bombe.\n");
  map_objects(all_inventory(TO), "remove", 1);
  clone_object(OBJ "bombe")->move(MENV, M_NOCHECK);
  ::remove(1);
}
