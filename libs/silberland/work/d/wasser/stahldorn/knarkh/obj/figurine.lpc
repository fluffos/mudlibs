#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
//#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Statuette");
  SetProp(P_LONG, BS( 
    "Du siehst eine kleine Statuette, die mit Hoernern, Klauen, " 
    "zwei Fluegeln und einigen Zaehnen ausgestattet ist.") );
  SetProp(P_INFO, BS(
    "Du erkennst, dass in der Statue die Seelen von vier Bestien hausen. "
    "Wenn Du den Zauberbefehl \"erscheine\" eingibst, kannst Du damit einen "
    "maechtigen Daemonen bannen, der Dir bei einem schweren Kampf beistehen "
    "kann.") );
  SetProp(P_NAME, "Statuette");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_MARBLE );
  SetProp(P_WEIGHT, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Die Statuette will nicht verkauft werden.\n");
  SetProp(P_VALUE, 10000);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId( ({"statuette", "figur", "figurine"}) );
  AddCmd( "erscheine", "erscheinen");
}

CloneDaemon(object master)
{
  object ob;
  ob=CLONEOB( NPC "daemon");
  if(ob->SetMaster(LOWER(getuid(master))))
    remove();
  else
    AddCmd( "erscheine", "erscheinen");
}

erscheinen(string str)
{
  write( BS(
    "Als Du die magische Zauberformel aussprichst, glaubst Du, die Welt "
    "um Dich versinkt im Chaos. Du siehst Farben, die Du nie zuvor gesehen "
    "hast, und hoerst Toene, die Du nie zuvor gehoert hast, als alles um "
    "Dich in einem riesigen Strudel zu versinken scheint. Nach ein paar "
    "Augenblicken merkst Du aber, dass der Strudel immer konkretere Formen "
    "annimmt und schliesslich ein fuerchterliches Wesen ausspuckt. ") );
  say( BS(
    TP->name()+" spricht einige magische Worte.\n"
    "Ploetzlich verschwimmt alles um Dich. Nach kurzer Zeit ist es "
    "wieder vorbei und ein Daemon steht vor Dir.") );
  RemoveCmd("erscheine");
  call_out("CloneDaemon", 0, TP);
  return 1;
}

