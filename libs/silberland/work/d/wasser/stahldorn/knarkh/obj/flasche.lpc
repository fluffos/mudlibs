#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define DRINK_COST 20

string farbe;

SetFluid(string color)
{
  RemoveAdjective(farbe+"e");
  farbe = color;
  SetProp(P_INFO, flasch_info());
  AddAdjective(farbe+"e");
}

string QueryFluid() { return farbe; }

private string flasch_info();
RandomFluid();

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  farbe = "unsinnig";
  SetProp(P_SHORT, "Eine @@QueryFluid@@e Flasche");
  SetProp(P_LONG, 
    "Du siehst eine ganz normale kleine Flasche. \n"
    "Sie ist mit einer @@QueryFluid@@en Fluessigkeit gefuellt.\n");
  SetProp(P_NAME, "Flasche" );
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_GLASS:20, MAT_MISC_FLUID:80]) );
  SetProp(P_WEIGHT, 115);
  SetProp(P_NOBUY, 0);
  SetProp(P_VALUE, 500);
  AddId( ({"flasche", "fluessigkeit"}) );
  AddAdjective("unsinnige");
  AddCmd( ({ "trinke", "trink" }), "trinken");
  AddCmd( ({ "leere", "entleere" }), "leeren");

  RandomFluid();
}

leeren(string str)
{
   if(id(str))
   {
      write("Du leerst den Inhalt der Flasche achtlos weg.\n" +
	    "Die Flasche loest sich magisch auf.\n");
      say(TP->Name() + " leert eine Flasche aus.\n");
      RemoveCmd( ({"trinke", "leere", "entleere", "trink"}) );
      call_out("remove", 0);
      return 1;
   }
   notify_fail("Was willst Du ausleeren?\n");
   return 0;
}


trinken (string str)
{
  
  if (id(str))
  {
    if(TP->QueryProp(P_DRINK) > (TP->QueryProp(P_MAX_DRINK) - DRINK_COST))
    {
      notify_fail("So viel kannst Du nicht mehr trinken!\n");
      return 0;
    }

    write("Du trinkst den Inhalt der Flasche aus.\n");
    say(TP->Name()+ " trinkt aus einer Flasche.\n");
    TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK) + DRINK_COST);
    switch(farbe)
    {
      case "gruen": do_gruen(); break;   //gift
      case "blau": do_blau(); break;     //alkohol auf max
      case "gelb": do_gelb(); break;     //LP-refresh
      case "schwarz": do_schwarz(); break; //TOD
      case "durchsichtig": do_durchsichtig(); break;  //MP-refresh
      case "rot": do_rot(); break;         // macht invis fuer ca 1.5 min
      case "orangerot": do_orangerot(); break;   //setzt alkohol auf 0
      case "braun": do_braun(); break;   //  entgiftet
      case "weiss": do_weiss(); break;   //  heilt blind
      case "grau": do_grau(); break;     //  heilt taub
      case "violett": do_violett(); break;     // entfroscht
      case "bunt": do_bunt(); break;     // zufallswirkung :)
      default: write("Nix passiert.\n");
    }

    RemoveCmd( ({"trinke", "leere", "entleere", "trink"}) );
    call_out("remove", 0);
    return 1;
  }

  notify_fail("Was willst Du trinken?\n");
  return 0;
}


reset()
{
   ::reset();
   if (is_clone(TO)) RandomFluid();
}


private string flasch_info()
{
  switch (farbe)
    {
     case "gruen": return
	"Wenn Du aus dieser Flasche trinkst, wirst Du vergiftet.\n"; break;
     case "blau": return BS(
	"Nach dem Genuss dieser Flasche puren Alkohols, wirst Du nicht mehr "
	"gerade stehen koennen. (made in Hobbingen)"); break;
     case "gelb": 
	return "Die Fluessigkeit in dieser Flasche vermag Wunden zu heilen.\n";
	break;
     case "schwarz": 
	return "Ein Schluck aus dieser Flasche bedeutet deinen Tod!\n";
	break;
     case "durchsichtig": return BS(
	"Die Fluessigkeit in dieser Flasche wird Deine Astralenergie "
    "positiv beeinflussen."); break;
     case "rot": return 
	"Dieser Trank kann Dich fuer eine kurze Zeit unsichtbar machen.\n"; 
	break;
     case "orangerot": return 
	"Die Fluessigkeit in dieser Flasche kann nuechtern machen.\n"; break;
     case "braun": return "Der braune Trank entgiftet Dich.\n"; 
	break;
     case "weiss": return "Dieser Trank macht blinde Leute sehend.\n"; break; 
     case "grau": return "Dieser Trank macht taube Leute hoerend.\n"; break;
     case "violett": return "Dieser Trank kann Dich entfroschen.\n"; break;
     case "bunt": return 
	"Die Wirkung dieses Trankes ist von Mal zu Mal verschieden.\n"; break;
     default: return "Dieser Trank ist wirkungslos.\n";
    }
}

private do_gruen()
{
    write("Du trinkst die Fluessigkeit und bereust es sofort. \n"+
	  "Ein heftiger Schmerz setzt ein und sticht grausam in Dein Gehirn.\n"+
	  "Du bist vergiftet!\n");
    TP->SetProp(P_POISON, TP->QueryProp(P_MAX_POISON));
}

private do_blau()
{
    write("Du trinkst eine Flasche puren Alkohol!\n"+
      "Das Zeug brennt die Kehle hinunter und laesst Dich um Luft ringen.\n"+
      "Du bist stockbesoffen!\n");
    TP->SetProp(P_ALCOHOL, TP->QueryProp(P_MAX_ALCOHOL));
}

private do_schwarz()
{
    write("Oh oh! Du hast aus der schwarzen Flasche getrunken!\n" +
	  "Weisst Du nicht, dass schwarz den Tod bedeutet?\n");
    TP->die();
}


private do_rot()
{
  object ob;

  write("Du wirst ploetzlich unsichtbar.\n");
  say(TP->Name()+ " wird ploetzlich unsichtbar.\n");
//  TP->SetProp(P_INVIS, 1);
  ob = clone_object("/std/player/shadows/visiblemaker.lpc");
//  ob->move(TP, M_NOCHECK);
//  ob->shadow(TP, 1);
}

private do_braun()
{
   write(
    "Du leerst die Flasche in einem Zug und fuehlst Dich sehr erfrischt.\n");
   TP->SetProp(P_POISON, 0);
}

private do_weiss()
{
   write("Als Du die Flasche leerst, sticht ein irrer Schmerz in Deine "+
	 "Augen.\n");
   TP->do_damage(10+random(20));
   if(!TP->QueryProp(P_BLIND))
   {
     write("Die Wirkung bleibt aus.\n");
   }
   else
   {
     write(BS("Voellig benommen oeffnest Du die Augen wieder und stellst "
	"fest, dass Du wieder sehen kannst.") );
     TP->SetProp(P_BLIND, 0);
   }
}

private do_grau()
{
   write("Als Du die Flasche leerst, sticht ein irrer Schmerz in Deine "+
	 "Ohren.\n");
   TP->do_damage(10+random(20));
   if(!TP->QueryProp(P_DEAF))
   {
     write("Die Wirkung bleibt aus.\n");
   }
   else
   {
     write(BS("Voellig benommen reibst Du Dir die Ohren und stellst "
	"fest, dass Du wieder hoeren kannst.") );
     TP->SetProp(P_DEAF, 0);
   }
}

private do_bunt()
{
  int rand;
  rand = random(11) + 1;

  switch(rand)
  {
    case 1: do_gruen(); break;
    case 2: do_blau(); break;
    case 3: do_gelb(); break;
    case 4: do_schwarz(); break;
    case 5: do_durchsichtig(); break;
    case 6: do_rot(); break;
    case 7: do_orangerot(); break;
    case 8: do_braun(); break;
    case 9: do_weiss(); break;
    case 10: do_grau(); break;
    case 11: do_violett(); break;
    default: break;
  }
}

private do_violett()
{
   write("Als Du die Flasche leerst, durchdringt Dich ein irrer Schmerz.\n");
   TP->do_damage(10+random(20));
   if(!TP->QueryProp(P_FROG))
   {
     write("Die Wirkung bleibt aus.\n");
   }
   else
   {
     write(BS("Ploetzlich beginnst Du zu wachsen. Die Haut wird heller, Dein "
	"Appetit auf Fliegen schwindet und Deine Schwimmhaeute bilden sich "
	"zurueck.") );
     TP->SetProp(P_FROG, 0);
   }
}

private do_orangerot()
{
  write("Du fuehlst Dich voellig nuechtern.\n");
  TP->SetProp(P_ALCOHOL, 0);
}

private do_durchsichtig()
{
   write("Du spuerst, wie astrale Energie in Deinen Koerper flutet.\n");
   TP->restore_spell_points(20 + random(30));
}

private do_gelb()
{
   write("Du spuerst, wie Lebensenergie in Deinen Koerper flutet.\n");
   TP->reduce_hit_point(-20 - random(30));
}

RandomFluid()
{
   int rand;
   rand=random(12) + 1;
   switch(rand)
   {
      case 1: SetFluid( "gruen" ); break;
      case 2: SetFluid( "rot" ); break;
      case 3: SetFluid( "blau" ); break;
      case 4: SetFluid( "grau" ); break;
      case 5: SetFluid( "weiss" ); break;
      case 6: SetFluid( "schwarz" ); break;
      case 7: SetFluid( "gelb" ); break;
      case 8: SetFluid( "durchsichtig" ); break;
      case 9: SetFluid( "bunt" ); break;
      case 10: SetFluid( "orangerot" ); break;
      case 11: SetFluid( "braun" ); break;
      case 12: SetFluid( "violett" ); break;
   }
}

int IsFood() {
  if((farbe == "gelb") || (farbe == "durchsichtig")) return 1; 
  else return 0;
}
