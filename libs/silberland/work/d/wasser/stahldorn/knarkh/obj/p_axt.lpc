#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine schwere Axt");
  SetProp(P_LONG, BS(
    "Die Axt des Powerknarkhisten sieht nicht so aus, als ob sie fuer "
    "Anfaenger gemacht ist. Sie ist gut ausbalanciert, und die Klinge blitzt "
    "scharf und gefaehrlich.") );
  SetProp(P_NAME, "Axt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt"}) );
  AddAdjective( "schwere" );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 185);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, (["knarkhist":60]) ); 
  SetProp(P_DAM_TYPE,({ DT_RIP, DT_SLASH }) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_EBONY:40, MAT_STEEL:60]) );
  SetProp(P_WEIGHT, 2800);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);


}


