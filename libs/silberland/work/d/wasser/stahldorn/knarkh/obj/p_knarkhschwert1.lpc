#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein kurzes Powerschwert");
  SetProp(P_LONG, BS( 
    "Dieses kurze Powerschwert ist als leichte Waffe der Power-Knarkhisten "
    "gedacht. Die Klinge funkelt in einem boesen Licht.") );
  SetProp(P_NAME, "Powerschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "powerschwert"}) );
  AddAdjective( "kurzes" );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 140);
  SetProp(P_WC_BONUS, (["knarkhist":80]) );
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_CLOTH:10]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);


}


