#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein glitzerndes Juwel");
  SetProp(P_LONG, BS(
    "Das Juwel funkelt in allen Farben. Jeder Lichtstrahl, der darauf "
    "faellt, wird tausendfach gebrochen und strahlt in gleissenden Farben. "
    "Der Anblick macht Dich beinahe blind.") );
  SetProp(P_NAME, "Juwel");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 1300);
  AddId( ({"juwel"}) );
}


