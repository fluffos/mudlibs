#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Zahnschutz");
  SetProp(P_LONG, BS( 
    "Die Knarkhisten tragen manchmal diesen Zahnschutz fuer den Fall, dass "
    "sie in eine Schlaegerei geraten. Er ist auch dementsprechend eklig.") );
  SetProp(P_NAME, "Zahnschutz");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_PLASTIC );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 2000); // Schuetzt gegen 2000 DT_BLUDGEON Attacken
  SetProp(P_INFO, BS("Der Zahnschutz schuetzt Dich ein wenig vor " 
		  "Schlaegen mit Faeusten oder stumpfen Gegenstaenden.\n") );
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_TEXT, 
    ({ "Du steckst Dir den Schutz mit Todesverachtung zwischen die Zaehne.\n",
       " steckt sich einen Zahnschutz ins Maul.\n"}) );
  SetProp(P_UNWEAR_TEXT, 
    ({ "Du nimmst den Zahnschutz aus dem Mund.\n",
       " nimmt einen Zahnschutz aus dem Mund.\n"}) );
  AddId( ({"zahnschutz", "schutz",  "\nknarkhzahn"}) );

}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if (member(dam_type, DT_BLUDGEON) != -1)
  {
    TakeFlaw(DT_BLUDGEON);
    return (10+random(20));
  }
  return 0;
}

