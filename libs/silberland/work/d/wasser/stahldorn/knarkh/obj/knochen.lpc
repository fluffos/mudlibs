#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>


string rasse()
{
   string str;

   if(!TP) return "";
   switch(str=CAP(TP->QueryProp(P_RACE)))
   {
     case "Mensch": return "Menschen"; break;
     case "Zwerg": return "Zwerg"; break;
     case "Elf": return "Elfen"; break;
     case "Hobbit": return "Hobbit"; break;
     default: return str;
   }
}

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein angenagter Knochen");
  SetProp(P_LONG, BS(
    "Der Knochen duerfte von der Groesse und Form her frueher einem "
    "@@rasse@@ gehoert haben. Er ist ziemlich angenagt.") );
  SetProp(P_NAME, "Knochen");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_BONE );
  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 0);
  AddId( ({"knochen"}) );

  AddDetail( ({ "groesse", "form" }),  
   "Genau die Groesse und Form, die auch DEINE Knochen aufweisen. ;)" );

}
