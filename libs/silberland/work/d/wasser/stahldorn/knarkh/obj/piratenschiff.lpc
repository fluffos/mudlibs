inherit "std/transport";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

string rausschaun();

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Kerkerzelle im Piratenschiff" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in einer abgeschlossenen Zelle irgendwo auf einem "
    "Piratenschiff. Der Raum ist total leer.") );
  SetProp( P_SHORT, "Ein Piratenschiff" );
  SetProp( P_LONG, BS(
    "Du siehst ein Piratenschiff voller wilder Piraten die darauf "
    "fachmaennisch herumturnen. An der Bordwand sind viele Bullaugen, aus "
    "denen grimmige Gesichter blicken.") );
  SetProp( P_NAME, "Piratenschiff" );
  AddId( ({ "schiff", "piratenschiff" }) );
  SetProp( P_GENDER, NEUTER );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_TRANSPARENT,0);


  AddShipDetail( ({"schiff", "piratenschiff"}), 
    "Du befindest Dich quasi in ihm drin.\n");
  AddShipDetail( ({ "boden" }), BS(
    "Der Boden schaut ueberraschend gut gepflegt aus.") );
  AddShipDetail( ({ "raum", "zelle" }), BS(
    "Der Raum, in den Dich die Piraten gesteckt haben, dient nur der "
    "Aufbewahrung von blinden Passagieren und Geiseln. Er ist echt total "
    "uninteressant.") );
  AddShipDetail( ({ "waende", "wand" }), BS(
    "Drei der Waende sind oed und leer. An der vierten Wand wird die oede "
    "Leere allerdings durch ein Bullauge unterbrochen.") );
  AddDetail( ({ "bullauge", "fenster", "bullaugen" }), #'rausschaun);
  AddShipDetail( ({ "pirat", "piraten" }), 
    "Es sind grad keine hier, um Deine Flucht zu verhindern.\n", 
    BS( "Sie turnen und balancieren auf Deck und auf der Takelage umher, "
        "als ob das das normalste auf der Welt waere.") );
  AddShipDetail( ({ "mast", "masten"}), 0, 
    "Die Masten erheben sich hoch ueber das Schiff.\n" );
  AddShipDetail( ({ "segel"}), 0, 
    "Die Segel sind gerefft.\n" );
  AddShipDetail( ({ "takelage"}), 0, 
    "Viele Piraten turnen auf der Takelage umher.\n" );
  AddShipDetail( ({ "rumpf"}), 0, BS(
    "Der Rumpf ist voller Kratzer und Schrammen, die von den vielen Gefechten "
    "stammen, die das Schiff schon hinter sich hat.") );
  AddShipDetail( ({ "decke" }), BS(
    "Auch die Decke ist oed und leer. Bis auf die Luke, durch die Du "
    "hier hereingekommen bist natuerlich.") );
  AddShipDetail( ({ "deck"}), 0, 
    "Auf Deck stehen einige Piraten herum.\n" );
  AddShipDetail( ({ "luke"}), 
    "Die Luke ist zu und man kann sie auch unmoeglich von unten oeffnen.\n" );
  AddShipDetail( ({ "meer" }), 
    "Durch das offene Bullauge siehst du das Meer.\n" );
  AddShipDetail(({"wasser", "meerwasser", "wasseroberflaeche", "oberflaeche"}),
    BS("Das Meerwasser schwappt manchmal herein, da das Bullauge nur knapp "
       "ueber der Wasseroberflaeche liegt.") );
  AddShipDetail( ({ "gesichter", "piratengesichter" }), 0, 
    "Dreckige, ungewaschene Piratengesichter starren Dich an.\n" );

  
  SetProp( P_DEPARTMSG, ({
    "Du hoerst die Piraten bruellen. \n"+
    "\n\"Leinen los!\"\n\"Leinen sind los!\" \n", 
    "Das Piratenschiff legt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({ BS(
    "Ein lautes Rumpeln und ein Blick aus dem Bullauge verraten Dir, dass das "
    "Schiff am Steg von @@QueryArrived@@ angelegt hat."),
    "Ein Piratenschiff legt am Steg an.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "wird von den Piraten auf ihr Schiff geschleppt",
    "wird von den Piraten hereingeworfen"}) );
  SetProp( P_ENTERFAIL, ({
    "Die Piraten stossen Dich wieder vom Schiff",
    "wird wieder vom Schiff heruntergestossen"}) );
  SetProp( P_MAX_PASSENGERS, 20 );

  SetProp( P_LEAVEMSG, ({
    "springt aus dem Fenster",
    "klettert aus dem Bullauge des Piratenschiffs"}) );
  SetProp( P_LEAVEFAIL, ({
    "Wenn Du jetzt rausspringst, fressen Dich die Haie",
    "will aus dem Fenster springen, ueberlegt es sich aber noch"}) );

  /* Verben */
  AddCmd( ({ "betrete", "betritt" }), "rein" );
  AddCmd( ({ "springe", "kletter", "klettere", "spring" }), "raus" );

  /* Kurs */
  AddRoute( ROOM "dorf_a7", 30, 5, "Knarkh",
         ({"knarkh"}), "nach Knarkh" );
  AddMsg( "Das Rauschen der Wellen wird lauter, als "+
          "das Schiff Fahrt aufnimmt.\n", 10 );
  AddMsg( "Du hoerst die Segel im Wind flattern.\n", 15 );
  AddFun( "entern", 5);
  AddMsg( "Die Planken knarren.\n", 10 );
  AddMsg( "\"Laaaaand in Siiiiiicht!\"\n", 3 );
  AddMsg( BS ("Als Du durchs Fenster blickst, siehst Du die Insel am "
              "Horizont rasch groesser werden."), 10 );
  AddMsg( "Der Schatten der Insel verdunkelt den Raum ein wenig.\n", 10 );
  AddMsg( "Die Matrosen bruellen sich gegenseitig Befehle zu.\n", 10 );
  AddRoute( "/d/dschungel/feyaria/felseninsel/room/steg", 30, 5,
      "der Felseninsel", ({"felseninsel","kronang"}), "zur Felseninsel" );
  AddMsg( "Das Rauschen der Wellen wird lauter, als "+
          "das Schiff Fahrt aufnimmt.\n", 10 );
  AddMsg( "Du hoerst die Segel im Wind flattern.\n", 15 );
  AddMsg( "Die Planken knarren.\n", 10 );
  AddMsg( "\"Laaaaand in Siiiiiicht!\"\n", 3 );
  AddMsg( BS ("Als Du durchs Fenster blickst, siehst Du, wie sich ein "
              "Dorf an der Kueste rasch naehert."), 10 );
  AddMsg( "Stinkende Pestschwaden aus dem Dorf wehen Dir " +
          "kurz in die Nase.\n", 10 );
  AddMsg( "Die Matrosen bruellen sich gegenseitig Befehle zu.\n", 10 );
 
  Start();
}

string rausschaun()
{   
   string aussicht;

   if(environment(TP) != TO) return "Die Bullaugen stehen weit offen.\n";

   aussicht = BS(
    "Diese Deppen von Piraten haben Dich doch tatsaechlich in eine "
    "Kerkerzelle mit einem offenen Bullauge gesteckt! Kaum zu glauben...");

   if(QueryArrived())
     aussicht += "Ausserhalb siehst Du den Steg von " + QueryArrived()+ ".\n";
   else
     aussicht += "Ausserhalb siehst Du das Meer.\n";

   return aussicht;
}


rein(str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

raus(string *str)
{
  str=explode(str, " ");
  notify_fail("Wo willst Du denn durch?\n");
  if (sizeof(str) < 2) return 0;
  if( (str[1] && member( ({"fenster", "bullauge"}), str[1]) > -1) && 
       member( ({"aus", "durch"}), str[0]) > -1)
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( ROOM "dorf_a7", "???"));
    catch(call_other( "/d/dschungel/feyaria/felseninsel/room/steg.lpc", "???"));
  }

  if (ENV(TP) == TO)
  {
     tell_object(TP, 
       "Die Piraten stecken Dich in eine Kerkerzelle im Unterdeck.\n" );
  }
}

varargs void AddShipDetail(mixed *det, string in_desc, string out_desc)
{
  AddDetail(det, 
    lambda(0, 
    ({#'?, ({#'==, ({#'environment, ({#'this_player})}), ({#'this_object})}),
       in_desc,
       out_desc})) );
}

void entern()
{
  string ship;
  switch(random(3)+1)
  {
  case 1: ship = "/d/dschungel/feyaria/tijara/obj/karavel"; break;
  case 2: ship = "/d/wasser/feyaria/schiffe/hschiff"; break;
  case 3: ship = "/d/dschungel/feyaria/tijara/obj/fischerboot"; break;
  default: ship = "/d/dschungel/feyaria/tijara/obj/karavel";
  }
//  DB(ship);
  if(call_other(ship, "QueryArrived") || random(30))
     return;
  Halt();
  call_other(ship, "Halt");
  tell_room(TO, "Jemand ruft: Schiff ahoi!\n");
  call_out("entern2", 5, ship);
}

void entern2(string ship)
{
  object ob;
  tell_room(TO, "Das Schiff wird hart durchgeschuettelt.\n");
  if (ob=find_object(ship)) 
    tell_room(ob, "Ploetzlich taucht backbord ein Piratenschiff auf.\n");
  call_out("entern3", 3, ship);
}

void entern3(string ship)
{
  object ob;
  if (ob=find_object(ship)) 
    tell_room(ob, "Die Piraten entern das Schiff.\n");
  tell_room(TO, "Du hoerst lautes Kampfgeschrei.\n");
  call_out("entern4", 3, ship);
}

void entern4(string ship)
{
  object ob;
  if (ob=find_object(ship)) 
    tell_room(ob, "Ein furchtbarer Kampf tobt auf dem Hauptdeck.\n");
  tell_room(TO, "Du hoerst klirrende Schwerter und furchtbare Schreie.\n");
  call_out("entern5", 5, ship);
}

void entern5(string ship)
{
  int success;
  object ob;
  success = random(2);
  if (ob=find_object(ship))
    if(success)
      tell_room(ob, "Die Piraten sind siegreich.\n"
       "Das Schiff wird gepluendert.\n");
     else
      tell_room(ob, 
        "Der Ueberfall der Piraten kann gerade noch abgewehrt werden.\n");
  tell_room(TO, "Der Laerm verstummt langsam.\n");
  call_out("entern6", 5, ship, success);
}

void entern6(string ship, int success)
{
  object ob;
  object *inv;

  if (ob=find_object(ship))
    if(success)
    {
      int i;
      tell_room(ob, "Die Piraten schleppen Dich auf ihr Schiff.\n");
      for(i=0; i<sizeof(inv=all_inventory(ob)); i++)
      {
         if(living(inv[i])) 
           inv[i]->move(TO, M_GO, "gezerrt", "wird aufs Piratenschiff", 
                                   "wird hereingeworfen");
         else
           inv[i]->remove();
      }
    }
     else
      tell_room(ob, 
        "Das Piratenschiff verschwindet am Horizont.\n");
  tell_room(TO, "Das Schiff nimmt wieder Fahrt auf.\n");
  Start(4);
  call_other(ship, "Start", 6);
}

