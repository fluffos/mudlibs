#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Knarkhpanzer");
  SetProp(P_LONG, BS( 
    "Ein simpler Metallpanzer, der aber halbwegs brauchbar aussieht.") );
  SetProp(P_NAME, "Knarkhpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "knarkhpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 27);
  SetProp(P_MATERIAL, ([MAT_BRASS:40, MAT_IRON:50, MAT_LEATHER:10]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 0);

}

