#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  call_out("remove", 20);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, 0);
  SetProp(P_NEVERDROP, 1);
  AddId("\bSperrer");

  AddCmd("", "true", 1);
}

int true()
{
   write("Du bist noch tief in Trance!\n");
   return 1;
}

remove()
{
  if (is_clone(TO))
  {
    write(BS(
       "Du erwachst wieder aus Deiner Trance. Als Du Dich umsiehst, bemerkst "
       "Du, dass Du Dich nicht mehr im Tempel befindest."));
    TP->move(ROOM "tempel2", M_TPORT);
  }
  return ::remove();
}
