#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Die Klauen der Klauenbestie");
  SetProp(P_LONG, BS( 
    "Vier 50 Zentimeter lange Klauen, die wie dafuer geschaffen scheinen, "
    "jemanden zu toeten. Als Waffe allerdings leider kaum zu gebrauchen. "
    "Pass auf, dass Du Dir nicht den Finger abschneidest damit!") );
  SetProp(P_INFO, BS(
    "Obwohl Du eigentlich nichts damit anzufangen weisst, widerstrebt "
    "es Dir, die Klauen wegzuwerfen.") );
  SetProp(P_NAME, 
    ({"die Klauen", "der Klauen", "den Klauen", "die Klauen"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_SKIN:25, MAT_BONE:30, MAT_FLESH:5, MAT_HORN:40]));
  SetProp(P_WEIGHT, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 3000);
  SetProp(P_AUTOLOADOBJ, 1);

  AddId( ({"klauen", "klaue"}) );

//  AddDetail( ({ "" }), 
//      "");

}


