#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

int geladen;

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  geladen = 0;

  SetProp(P_SHORT, "Ein silberner Ring");
  SetProp(P_LONG, BS( 
    "Ein kleiner silberner Ring. Es scheint etwas eingraviert zu sein." ) );
  SetProp(P_INFO, BS(
    "Der kleine Silberring pulsiert magisch. Er hat seinem frueheren Besitzer "
    "sicher viel bedeutet, da er grossen Wert besitzt.") );
  SetProp(P_NAME, "Silberring");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "silberring", "\ncombru"}) );
  AddDetail( ({"inschrift", "gravur"}), "Du kannst sie lesen.\n");
  AddReadDetail( ({"inschrift", "gravur"}), "Die Inschrift lautet:\n" +
	"	COMBRU DUKU MARU!\n");
  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([ MAT_SILVER:60, MAT_MISC_METAL:40 ]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);

}

aufladen()
{
   write("Der Silberring blitzt magisch auf.\n");
   geladen = 1;
}

int ladestatus()
{
   return geladen;
}


reset()
{
  ::reset();
  if((random(25) == 12) && is_clone(TO))
  {
    call_out("remove", 0);
  }
}

ueberladen()
{
   if(random(20) == 10) 
   {
      write("Das magische Schimmern im Silberring verschwindet.\n");
      geladen = 0;
   }
   if(!geladen && !random(5)) 
   {
     write("Der Silberring loest sich in einem kleinen Lichtblitz auf.\n");
     remove();
   }
}

