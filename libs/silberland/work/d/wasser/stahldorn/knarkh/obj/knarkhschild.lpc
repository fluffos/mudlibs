#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Knarkhschild");
  SetProp(P_LONG, BS( 
    "Der Schild der Knarkhisten kann Dich sicher vor heftigen Schlaegen ein "
    "wenig schuetzen. Leider ist er auch ziemlich schwer. ") );
  SetProp(P_NAME, "Knarkhschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "knarkhschild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 22);
  SetProp(P_MATERIAL, ([MAT_IRON:80, MAT_LEATHER:20]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 0);

}

