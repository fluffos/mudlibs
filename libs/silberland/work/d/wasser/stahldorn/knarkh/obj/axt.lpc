#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine leichte Axt");
  SetProp(P_LONG, BS( 
    "Diese Axt ist von eher minderwertiger Qualitaet.") );
  SetProp(P_NAME, "Axt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt"}) );
  AddAdjective( "leichte" );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 130);
  SetProp(P_WC_FIX, 10);
  SetProp(P_DAM_TYPE,({ DT_RIP, DT_SLASH }) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:40, MAT_IRON:60]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 900);
  SetProp(P_NOBUY, 0);

}


