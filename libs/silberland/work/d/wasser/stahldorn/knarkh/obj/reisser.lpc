#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Die Reisser der Reisserbestie");
  SetProp(P_LONG, BS( 
    "Ca. 20 dolchartige Reisszaehne der Reisserbestie mit einem grossen "
    "Stueck Unterkiefer daran. Du hast keine Ahnung wozu man das noch "
    "brauchen koennte. Als Waffe ist es jedenfalls gaenzlich ungeeignet, "
    "da man die Zaehne nirgends richtig halten kann.") );
  SetProp(P_INFO, BS(
    "Obwohl Du eigentlich nichts damit anzufangen weisst, widerstrebt "
    "es Dir, die Reisser wegzuwerfen.") );
  SetProp(P_NAME, 
    ({"die Reisser", "der Reisser", "den Reissern", "die Reisser"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_BONE:95, MAT_SKIN:5]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 3000);
  SetProp(P_AUTOLOADOBJ, 1);

  AddId( ({"reisser", "reisszaehne", "zaehne"}) );

  AddDetail( ({ "kiefer", "unterkiefer" }), 
      "Ein Stueck Unterkiefer haengt an den Reisszaehnen. Beziehungsweise "
      "haengen die Reisszaehne am Unterkiefer.");
//  AddDetail( ({ "" }), 
//      "");

}


