// Stahldornpanzer. Ein ziemlich gutes Ding. Da er Dornen hat, verletzen
// sich Gegner, die jmd angreifen, der diesen Panzer traegt.

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Stahldornpanzer");
  SetProp(P_LONG, BS( 
    "Der beruechtigte Stahldornpanzer macht wirklich einen sehr brutalen "
    "Eindruck. Die starken Dornen, die ueberall herausragen, sind "
    "spitz und scharf. Wenn Du diesen Panzer traegst, sollte jeder Gegner "
    "sich zweimal ueberlegen, ob er Dich angreift.") );
  SetProp(P_NAME, "Stahldornpanzer");
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, BS(
    "Wenn man mit blossen Haenden auf den Panzer haut, tut man sich "
    "moeglicherweise ziemlich weh dabei. Leider scheint der Stahldornpanzer "
    "aber auf Feuchtigkeit und Luft relativ empfindlich zu reagieren. Und "
    "Vorsicht! Pass auf, dass Du im Kampf Deinen eigenen Dornen nicht zu "
    "nahe kommst!") );

  AddId( ({"panzer", "stahldornpanzer", "stahlpanzer", "dornpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 32);
  SetProp(P_MATERIAL, ([MAT_STEEL:70,MAT_TITANIUM:10,MAT_LEATHER:10,MAT_ALUMINIUM:10]) );
  SetProp(P_WEIGHT, 2600);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_DEFEND_FUNC, TO);

  AddDetail( ({ "dornen", "dorne", "dorn" }), BS(
     "Die Dornen ragen wirr plaziert ueberall am Panzer heraus. "
     "Ihre Laenge betraegt zwischen fuenf und zwanzig Zentimetern. "));
}


/* Die Ruestung reagiert ziemlich allergisch auf Wasser und Luft!  */

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  object traeger;

  if(!objectp(traeger = MENV)) return 0;
  if ((member(dam_type, DT_WATER) != -1) || (member(dam_type, DT_AIR) != -1))
  {
    if (random(2))
    {
       tell_object(traeger, BS(
         "Einige Teile des Panzers verrosten spontan und ein paar "
         "Dornen fallen ihm ab. Er schaut nun nicht mehr so stabil aus.") );
       if (QueryProp(P_AC)) {
          SetProp(P_AC, QueryProp(P_AC) - 1);
          SetProp(P_DAMAGED, QueryProp(P_DAMAGED)+1);
       }
    }
    return (-50 - random(30));
  }


/* Wenn man ohne Waffe draufhaut tut man sich aber weh. */

  if (!enemy->QueryProp(P_WEAPON) && 
     (!spell) &&
     (enemy->QueryProp(P_SIZE) > traeger->QueryProp(P_SIZE) / 2))
  {
     SetProp (P_KILLER, traeger->name());
     tell_object(enemy, BS(
       "Aua! Die Dornen des Panzers Deines Gegners schneiden Dir tief "
       "ins Fleisch!") );
     tell_object(traeger, BS(
       "Der Panzer fuegt "+ enemy->name(WEM) +" schwere Verletzungen zu.") );
     say( BS(
       traeger->Name(WESSEN)+" Panzer fuegt "+ enemy->name(WEM) +
       " schwere Verletzungen zu."), traeger );
     enemy->Defend( random(2 * QueryProp(P_AC)) + 15 + QueryProp(P_AC) , 
                     DT_PIERCE, ([SP_NAME:"Dornen des Stahldornpanzers.",
                     SP_SHOW_DAMAGE:1]), traeger);
  }
  
/* ...und wenn der Traeger recht patschert is, verletzt er sich selber... */
  
   if(20 - traeger->QueryAttribute(A_DEX) > random(20))
   {
      SetProp(P_KILLER, "Ungeschicklichkeit im Umgang mit Dornen");
      tell_object(traeger, BS(
        "Aua! Als Du im Kampfgetuemmel dem Gegner ausweichen willst, "
        "schneidest Du Dir die Haut an den Panzerdornen auf."));
      say(traeger->Name()+" schneidet sich ins eigene Fleisch.\n", traeger);
      traeger->do_damage(2 + random(4));
   }
  return 0;
}
