#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein langes Powerschwert");
  SetProp(P_LONG, BS( 
    "Das lange Powerschwert ist die schwere Waffe der Power-Knarkhisten. "
    "Die Klinge funkelt gefaehrlich. Die Schneide ist sehr sehr scharf.") );
  SetProp(P_NAME, "Powerschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "powerschwert"}) );
  AddAdjective( "langes" );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 185);
  SetProp(P_WC_BONUS, (["knarkhist":50]) ); 
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_CLOTH:10]) );
  SetProp(P_WEIGHT, 1900);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);


}


