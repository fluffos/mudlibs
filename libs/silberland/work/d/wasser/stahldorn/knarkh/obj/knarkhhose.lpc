#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Knarkhhose");
  SetProp(P_LONG, BS( 
    "Die Hose sieht total verdreckt und eklig aus. Sein Besitzer duerfte "
    "nicht viel von Hygiene gehalten haben.") );
  SetProp(P_NAME, "Knarkhhose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "knarkhhose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_LEATHER:80, MAT_SHIT:5, MAT_WOOL:10,MAT_BRONCE:5]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 0);
  SetProp(P_SMELL, "Sie stinkt nach Exkrementen. Pfui!\n");

}

