#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Handvoll Schiesspulver");
  SetProp(P_LONG, BS(
    "Du siehst eine grosse Handvoll Schiesspulver. Wenn man es anzuendet, "
    "verbrennt es explosionsartig. Aber so richtig gefaehrlich wird es "
    "erst, wenn man es vorher in eine Metallkugel fuellt.") );
  SetProp(P_NAME, ({
    "das Schiesspulver", "des Schiesspulvers", "dem Schiesspulver", 
    "das Schiesspulver" }));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MATERIAL, MAT_GUNPOWDER );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 1);
  AddId( ({"pulver", "schiesspulver", "\nspu", "\nspulver" }) );
  AddCmd( ({"zuende", "zuend" }), "zuenden");
}

int zuenden(string *str)
{
  notify_fail("Was willst Du anzuenden?\n");
  str = explode(str, " ");
  if (sizeof(str) != 2) return 0;
  if ((str[1] != "an") || (!id(str[0]))) return 0;
  if (TP->QueryProp(P_SP) < 5)
  {
    write("Du hast zu wenig Magiepunkte, um das Pulver anzuzuenden.\n");
    return 1;
  }
  TP->restore_spell_points(-5);
  write(BS(
    "Du zuendest das Schiesspulver mit einem kleinen Feuerball an. Das "
    "Pulver entzuendet sich sofort und verbrennt Dir gehoerig die Finger."));
  say(BS(TP->Name()+ " zieht sich Verbrennungen zu, als er eine Handvoll "
      "Schiesspulver zur Explosion bringt."));
  TP->Defend(150 + random(100), ({ DT_EXPLOSION, DT_FIRE }), 
     "Schiesspulver", TO);
  return ::remove();
}
