#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine schwere Keule");
  SetProp(P_LONG, BS( 
    "Diese Keule sieht so aus als sei sie schon oft (und mit Erfolg) benutzt "
    "worden. Sie liegt gut in der Hand und ist mit Naegeln gespickt.") );
  SetProp(P_NAME, "Keule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule"}) );
  AddAdjective( "schwere" );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 185);
  SetProp(P_WC_FIX, 15);
  SetProp(P_WC_BONUS, (["knarkhist":60]) ); 
  SetProp(P_DAM_TYPE, ({ DT_BLUDGEON, DT_PIERCE }) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_EBONY:80, MAT_IRON:5, MAT_STEEL:15]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);


}


