#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Knarkhhelm");
  SetProp(P_LONG, BS( 
    "Ein simpler Metallhelm mit einem Schutz fuer die Nase. "
    "Er sieht ziemlich stabil aus.") );
  SetProp(P_NAME, "Knarkhhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "knarkhhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_BRASS:20, MAT_COPPER:20, MAT_BRONCE:10, MAT_IRON:40, MAT_LEATHER:10]) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 0);

}

