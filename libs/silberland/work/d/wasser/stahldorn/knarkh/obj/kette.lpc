#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine rostige Kette");
  SetProp(P_LONG, BS(
    "Eine ziemlich schwere Eisenkette. Sie ist schon sehr alt und rostig "
    "und eigentlich zu nix zu gebrauchen.") );
  SetProp(P_NAME, "Kette");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 150);
  AddId( ({"kette"}) );
}


