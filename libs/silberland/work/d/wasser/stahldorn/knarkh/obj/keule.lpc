#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine leichte Keule");
  SetProp(P_LONG, BS( 
    "Diese Keule ist von eher minderwertiger Qualitaet.") );
  SetProp(P_NAME, "Keule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule"}) );
  AddAdjective( "leichte" );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 130);
  SetProp(P_WC_FIX, 10);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:85, MAT_BRASS: 15]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 900);
  SetProp(P_NOBUY, 0);


}


