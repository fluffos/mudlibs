#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein dunkelrotes Stiefmuetterchen");
  SetProp(P_LONG,
    "Du siehst ein ziemlich ordinaeres, dunkelrotes Stiefmuetterchen.\n" );
  SetProp(P_NAME,"Stiefmuetterchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_SMELL, "Das Stiefmuetterchen riecht eigentlich nach gar nix,\n");
  AddId( ({"stiefmuetterchen", "blume"}) );
}


