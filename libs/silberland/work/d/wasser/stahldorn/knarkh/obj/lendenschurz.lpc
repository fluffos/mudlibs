#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Lendenschurz");
  SetProp(P_LONG, BS( 
    "Dieser Lendenschurz duerfte der Groesse nach einem Troll oder "
    "einem Oger gehoert haben.") );
  SetProp(P_NAME, "Lendenschurz");
  SetProp(P_GENDER, MALE);
  AddId( ({"schurz", "lendenschurz"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_CLOTH:60, MAT_LEATHER:40]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 250);
  SetProp(P_NOBUY, 0);

}

