#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Knarkhisten-Emblem");
  SetProp(P_LONG, BS( 
    "Das Emblem der Knarkhisten stellt im Prinzip nur einen Totenkopf "
    "mit stilisierten Blutspritzern darauf dar.") );
  SetProp(P_INFO, BS(
    "Unwahrscheinlich dass sich die Waechter "
    "davon taeuschen lassen wuerden...") );
  SetProp(P_NAME, "Emblem");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"emblem", "knarkhisten-emblem"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, MAT_PLASTIC );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 0);

  AddDetail( ({ "blut", "spritzer", "blutspritzer" }), 
    "Das Blut ist wohl nicht echt.\n" );
  AddDetail( ({ "totenkopf" }), 
    "Der Totenkopf auf dem Emblem grinst Dich haemisch an.\n" );

}

