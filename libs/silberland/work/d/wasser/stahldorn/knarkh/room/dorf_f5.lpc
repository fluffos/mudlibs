#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Plaza in Knarkh" );
  SetProp( P_INT_LONG, BS( PLAZALANG + 
   "Im Nordwesten zweigt ein breiter Zugang ab. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

PLAZADETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "zugang", "nordwesten" }),
     "Er fuehrt zu einem grossen dunklen Gebaeude.\n" );
  AddDetail( ({ "gebaeude", "tempel" }), BS(
     "Das Gebaeude im Nordwesten stellt einen Tempel dar. Mit Sicherheit ein "
     "Tempel des Boesen. Christmetten werden dort keine gelesen. ;)") );
//  AddDetail( ({ "" }),
//     "" );

  AddExit( "nordwesten", "./dorf_g4.lpc" );
  AddExit( "osten", "./dorf_f6.lpc" );
  AddExit( "suedosten", "./dorf_e6.lpc" );
  AddExit( "sueden", "./dorf_e5.lpc" );

  AddItem(NPC "powerknarkhist", REFRESH_DESTRUCT, 
           ([P_MNPC_DEFAULTROOM: ROOM "dorf_f5",
             P_MNPC_CMDS: ({ "sueden", "westen", "nordwesten", "nordwesten", "nordwesten", "nordwesten", "suedosten", "suedosten", 
                             "suedosten", "suedosten", "osten", "sueden", "sueden", "suedwesten", "nordosten", "norden", 
                             "norden", "nordwesten", "suedosten" }) ]) );

}

STDFUNC

