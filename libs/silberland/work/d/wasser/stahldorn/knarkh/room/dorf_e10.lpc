#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Eine Strasse fuehrt nach Westen und ein Weg nach Suedwesten. Noerdlich "
    "von Dir steht ein auffaelliges Haus mit einem kleinen Rasen davor. "
    "@@gut_boes@@"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "strasse" }), 
    "Sie fuehrt nach Westen auf einen Kaefig zu.\n" );
  AddDetail( ({ "weg" }), 
    "Der Weg, der hier in die Strasse muendet, fuehrt nach Suedwesten.\n" );
  AddDetail( ({ "haus" }), BS(
    "Das Haus faellt hauptsaechlich durch sein gepflegtes Aeusseres auf. "
    "Die Waende sind weiss gestrichen und sauber. "));
  AddDetail( ({ "rasen", "gras" }), 
    "Vor dem Haus ist ein frisch gemaehter Rasen.\n" );
  AddDetail( ({ "kaefig" }), BS(
    "Er liegt weiter im Westen. Von hier aus kannst Du noch nichts "
    "erkennen, weil er zu weit weg ist.") );
  AddDetail( ({ "tuer", "tuere" }), 
    "Die Tuer steht sperrangelweit offen. Daneben an der Hauswand haengt "
    "ein kleines Holzschild." );
  AddDetail( ({ "wand", "hauswand", "fassade", "waende" }), BS(
    "Die makellos weisse Fassade wird nur durch die Fenster und die Tuer "
    "unterbrochen, neben der ein kleines Schild angebracht ist.") );
  AddDetail( ({ "schild", "holzschild" }), BS(
    "Ein kleines Schild aus Holz, auf dem etwas geschrieben steht. Als Du "
    "Dir das Holzschild genauer ansiehst, faellt Dir ausserdem ein kleiner "
    "Knopf daneben auf.") );
  AddReadDetail( ({ "schild", "holzschild" }), 
    "Hier wohnt der Magier Nathaniel Dobbodox. Warnung vor der Bestie!\n" );
  AddDetail( ({ "knopf" }), 
    "Ein kleiner dunkelgruener Knopf.\n" );
  AddDetail( ({ "fenster" }), 
    "Die Fenster sind alle verschlossen.\n" );
//  AddDetail( ({ "" }), 
//    "" );

  AddExit( "norden", "./dorf_f10.lpc" );
  AddExit( "westen", "./dorf_e9.lpc" );
  AddExit( "suedwesten", "./dorf_d9.lpc" );

  AddItem(NPC "knarkhist", REFRESH_DESTRUCT);
  AddItem(NPC "powerknarkhist", REFRESH_DESTRUCT, 
           ([P_MNPC_DEFAULTROOM: ROOM "dorf_e10",
             P_MNPC_CMDS: ({ "norden", "sueden", "suedwesten", "suedwesten", 
                 "westen", "westen", "westen", "suedwesten", "nordosten", 
                 "norden", "osten", "nordwesten", "nordosten", "nordosten", 
                 "suedwesten", "sueden", "osten", "nordosten", "suedosten", 
                 "osten" }) ]) );
  
  AddCmd( ({ "druecke", "drueck" }), "druecken" );
}

STDFUNC


int druecken(string str)
{
   if (str != "knopf" && str != "auf knopf")
     return 0;
   say(TP->Name()+" drueckt auf einen Knopf.\n"); 
   write(BS( "Hoeflich wie Du bist drueckst Du zuerst auf die Klingel, "
             "bevor Du das Haus betrittst."));
   tell_room(TO, "   DING!   DONG!\a\n");
   return 1;
}
