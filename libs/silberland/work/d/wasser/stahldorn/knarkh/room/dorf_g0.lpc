
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int gekratzt=0;
int got_ring=0;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Seitengasse im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG +
    "Hier macht die Gasse einen zweiten Knick nach Sueden, weil im Westen "
    "die Palisade ein Durchkommen unmoeglich macht. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS


  AddDetail( ({ "gasse", "seitengasse" }), BS(
    "Sie fuehrt von Osten nach Sueden und macht hier einen Knick. ") );
  AddDetail( ({ "knick" }), BS(
    "Der Knick ist notwendig, weil die Gasse sonst die Palisade durchbrechen "
    "muesste, die sich westlich von Dir befindet.") );
  AddDetail( ({ "osten", "sueden" }), BS(
    "Von da kommt die Gasse und nach dort fuehrt sie auch. "
    "Je nachdem, wie man es betrachtet.") );
  AddDetail( ({ "palisade" }), BS(
    "Sie begrenzt das Dorf Knarkh nach Westen hin. Ohne diesen Schutzwall "
    "waere das Dorf zu verletzlich. Und die Welt wuerde ausserdem womoeglich "
    "von den Leuten, die hier hausen, ueberschwemmt werden...") );
  AddDetail( ({ "leute" }), BS(
    "All diese miesen Typen, die hier rumlaufen.") );
  AddDetail( ({ "schutzwall", "wall" }), BS(
    "Der Wall besteht hauptsaechlich aus Holz, ist aber gerade an diesem "
    "Abschnitt mit Steinquadern verstaerkt. Vielleicht dient die Palisade "
    "wirklich nicht nur dazu, Leute draussen, sondern auch drinnen zu "
    "halten. Hier, wo die Gasse so nah am Rand ist, waere das auch noetig.") );
  AddDetail( ({ "rand" }), BS(
    "Der ist hier gleich im Westen. Knarkh ist da durch die Palisade "
    "begrenzt.") );
  AddDetail( ({ "abschnitt" }), BS(
    "Dieser spezielle Abschnitt hier entlang der Seitengasse ist staerker.") );
  AddDetail( ({ "quader", "stein", "steinquader" }), BS(
    "Die Steinquader sind relativ lose aneinandergefuegt, sodass einige "
    "tiefe Fugen dazwischen frei bleiben.") );
  AddDetail( ({ "fugen", "fuge" }), BS(
    "Die meisten sind mit Moertel gefuellt. Ein paar aber nicht. "
    "Als Kletterhilfe sind sie jedenfalls sicher nicht geeignet.") );
  AddDetail( ({ "moertel" }), BS(
    "Er broeckelt schon ab. Vielleicht kann man ihn an einer Stelle "
    "abkratzen?") );
  AddDetail( ({ "stelle" }), BS(
    "Ja, hier ist der Moertel bruechig. Kratz mal dran!") );


  AddGuardedExit( "osten", ROOM "dorf_g1.lpc", "knarkhist",
	   "Der Knarkhist hindert Dich daran und sagt: STOP, Freundchen!\n" );
  AddExit( "sueden", "./dorf_f0.lpc" );

  AddCmd( ({"kratze", "kratz"}), "kratzen");
  AddCmd( ({"kletter", "klettere"}), "klettern");


}

STDFUNC

klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
if ((member(explode(str, " "), "mauer") >= 0) ||
    (member(explode(str, " "), "wall") >= 0) ||
    (member(explode(str, " "), "palisade") >= 0) )
    {
      write(BS("Du versuchst, auf die Mauer zu klettern, hast aber "
	"keinen richtigen Halt und faellst immer wieder zurueck. Frustriert "
	"gibst Du auf.") );
      return 1;
    }
  return 0;
}

kratzen(string str)
{
  if ((str == "moertel ab") && (!gekratzt))
    {
      write(BS("Du kratzt ein wenig am feuchten Moertel herum und findest "
	"einen Finger, der aus der Fuge herausschaut.") );
      say(BS(TP->name() + " kratzt an Moertelfugen herum und legt einen Finger "
        "frei."));
      AddDetail("finger", BS(
	"Der Finger haengt wahrscheinlich an einem eingemauerten Koerper... "
	"Ein silberner Ring haengt dran.") );
       AddDetail("koerper", 
	"Der Koerper, dem der Finger gehoert, wurde anscheinend eingemauert.\n"+
	"Dich schaudert.\n" );
      AddDetail("ring", BS(
	"Du koenntest versuchen, ihn vom Finger abzustreifen.") );
      AddCmd("streife", "streifen");
 
      gekratzt=1;
      return 1;
    }
  if (str == "moertel ab")
  {
    write ("Du kratzt am Moertel herum, findest aber nichts.\n");
    say (TP->name() + " kratzt sinnlos an einer Moertelfuge herum.\n");
    return 1;
  }
  notify_fail("Was willst du abkratzen?\n");
  return 0;

}

reset()
{
   gekratzt=0;
   RemoveDetail( ({"finger", "koerper", "ring"}) );
   RemoveCmd("streife");
   ::reset();
}

streifen(string str)
{
  notify_fail("Was willst du von wo abstreifen?\n");
  if (str == "ring von finger" || str == "ring von finger ab")
  {
    clone_object(OBJ "silberring")->move(environment(TP), M_NOCHECK);
    write ("Du streifst den Ring schnell vom Finger. \n" +
        "Leider faellt der Ring aber auf den Boden.\n");
    RemoveCmd("streife");
    RemoveDetail("ring");
    AddDetail("finger", 
      "Der Finger haengt wahrscheinlich an einem eingemauerten Koerper...\n");
    return 1;
  }
  return 0;
}





