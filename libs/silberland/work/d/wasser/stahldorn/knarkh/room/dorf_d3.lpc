#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Die truebe Gasse hier macht einen sehr uninteressanten Eindruck. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "haus", "haeuser", "huetten", "huette" }), 
    "Die Haeuser hier sind total uninteressant.\n");
  AddDetail( ({ "gasse" }), 
    "Sie macht hier einen Knick.\n");
  AddDetail( ({ "knick" }), 
    "Die Gasse kommt von Nordwesten und fuehrt nach Nordosten.\n");


  AddExit( "nordosten", ROOM "dorf_e4.lpc" );
  AddExit( "nordwesten", ROOM "dorf_e2.lpc" );

}

STDFUNC

