#include "../def.h"
#include "./knarkh.h"

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <laden.h>

int strafe();

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei der Alchemistin" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich im Laden der Alchemistin. Die Waende sind mit "
	"Regalen, die sich unter ihrer Last biegen, versehen. Ueberall "
	"steht Geruempel herum. Die Luft ist durchsetzt mit dem Geruch "
	"von Chemikalien. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  SetStorageRoom (ROOM "alch_lager");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Die Alchemistin");
  SetProp(P_SHOPKEEPER_ID, "alchemistin");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);


  AddDetail( ({ "boden" }), BS(
    "Du siehst nichts interessantes am Boden.") );
  AddDetail( ({ "waende", "wand" }), BS(
    "Regale haengen an den Waenden.") );
  AddDetail( ({ "decke" }), BS(
    "Du siehst nichts besonderes an der Decke.") );
  AddDetail( ({ "regal", "regale", "last" }), BS(
    "Auf den Regalen stehen vor allem viele verschiedene Flaschen, die in "
    "vielen Farben schimmern.") );
  AddDetail( ({ "farben", "farbe" }), BS(
    "Du siehst Rot, Gelb, Gruen, Blau, Orangerot, Violett, Weiss, Schwarz, "
    "Grau, Braun, Bunt und Durchsichtig.") );
  AddDetail( ({ "rot", "gelb", "blau", "gruen", "violett", "braun", "weiss", 
                "schwarz", "grau", "orangerot", "durchsichtig" }), BS(
    "Auch diese Farbe siehst Du hier.") );
  AddDetail( ({ "bunt" }), BS(
    "Die bunte Farbe ist etwas besonders schoenes.") );
  AddDetail( ({ "flasche", "flaschen" }), BS(
    "Die Flaschen, die hier verkauft werden, haben alle einen ganz besonderen "
    "Inhalt. Die Alchemistin kann Dir sicher mehr darueber sagen.") );
  AddDetail( ({ "alchemistin" }), BS(
    "Die ist grad nicht da. :(") );
  AddDetail( ({ "geruempel" }), BS(
    "Das Geruempel steht deswegen hier herum, weil im Hinterzimmer kein Platz "
    "mehr dafuer war. Du siehst hauptsaechlich Reagenzglaeser, Kocher, "
    "Buecher, Zetteln, Flaschen und Petrischalen.") );
  AddDetail( ({ "petrischalen", "reagenzglaeser", "kocher" }), BS(
    "Die dienen der Alchemistin bei ihren Experimenten.") );
  AddDetail( ({ "zetteln", "zettel", "notizen", "notiz" }), BS(
    "Sie sind mit irgendwelchen Notizen vollgekritzelt. Du kannst die "
    "Handschrift unmoeglich lesen.") );
  AddReadDetail( ({ "zetteln", "zettel", "notizen", "notiz" }), BS(
    "Bhgf.lov^3 s vgiu*2 vssXp0hzt H2O = gnqpw + mcd[pf]sw, fzg ure -OH !!") );
  AddDetail( ({ "buecher" }), BS(
    "Da steht sicher nur Hokuspokus drin. Du verstehst sicher nix davon.") );
  AddDetail( ({ "bhgf.lov^3" }), 
    #'strafe);
  AddDetail( ({ "chemikalien" }), BS(
    "Du siehst sie nicht, Du riechst sie nur.") );
  AddDetail( ({ "inhalt" }), BS(
    "Der Inhalt jeder Flasche hat eine besondere Farbe.") );
  AddDetail( ({ "hinterzimmer" }), BS(
    "Das Hinterzimmer dient als kleine Giftkueche und als Lagerraum.") );
  AddSmell( ({ DEFAULT_SMELL, "geruch", "chemikalien" }), BS(
    "Der scharfe Gestank nach Chemie, der aus dem Hinterzimmer kommt, beisst "
    "Dir unangenehm in der Nase.") );
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Blubbern aus dem Hinterzimmer.\n" );
  AddDetail( ({ "raum", "laden" }), 
    "Du befindest Dich im Laden einer Alchemistin.\n" );

//  AddDetail( ({ "" }), 
//    "" );

  AddSound( ({ "blubbern" }),
    "*BLUBB*   *BLUBB*   *FURZ*   *BLUBB*\n" );

  AddExit( "nordwesten", "./dorf_f0.lpc" );
  AddItem( NPC "alchemistin", REFRESH_DESTRUCT);

}

STDFUNC

sell()
{
  notify_fail("Du kannst hier nichts verkaufen.\n");
  return 0;
}
force_sell() { return sell(); }
evaluate() { return sell(); }

int strafe()
{
  TP->reduce_hit_point(20);
  write("Du kennst Dich da nicht aus!\n");
  return 1;
}
