
#include "../def.h"
#include "./knarkh.h"

inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <laden.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Knarkhshop" );
  SetProp( P_INT_LONG, BS(
	"Du befindest Dich im Knarkhshop, dem groessten (weil einzigen) Laden "
	"in Knarkh. Da die Einwohner und Waechter von Knarkh von "
	"Diebstahl, Raub, Mord, Betrug, Totschlag und Erpressung leben, "
	"hat kaum jemand Interesse daran, hier einzukaufen, wo man doch alles "
	"was man braucht sich einfach vom Nachbar nehmen kann. Dementsprechend "
	"schlecht ist die Geschaeftslage dieser zwielichtigen Bude, und "
	"dementsprechend aermlich ist sie auch eingerichtet."
	" @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  SetStorageRoom (ROOM "lagerraum");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Der Haendler");
  SetProp(P_SHOPKEEPER_ID, "KnarkhHaendler");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({ "shop", "laden", "knarkhshop" }), 
    "Die Einrichtung ist armselig. Der Boden ist schmutzig.\n" +
    "Der Haendler ist unfreundlich. Der Ladentisch ist ungepflegt.\n" );
  AddDetail( ({ "tisch", "ladentisch" }), BS(
    "Der Tisch ist leer. Es sieht nicht so aus, als ob viele Dinge "
    "ueber diesen alten Tisch in all den Jahren gewandert sind.") );
  AddDetail( ({ "boden" }), 
    "Der Boden ist schon lange nicht mehr aufgewischt worden.\n" );
  AddDetail( ({ "decke" }),
    "An der Decke haengen ein paar Spinnweben.\n" );
  AddDetail( ({ "spinnweben" }), 
    "Alte und staubige Spinnweben haengen an der Decke.\n" );
  AddDetail( ({ "wand", "waende" }), 
    "An den Waenden klebt eine schimmlige Tapete.\n" );
  AddDetail( ({ "tapete" }), BS(
    "Die Tapete gibt Dir nur einen Hinweis auf den schlechten Geschmack des "
    "Haendlers. Sie loest sich ueberall ab und Schimmelpilzkulturen haben "
    "sich breitgemacht.") );
  AddDetail( ({ "schimmel", "schimmelpilz", "schimmelpilzkulturen" }), BS(
    "Dir faellt Deine Schimmelpilzallergie ein und laesst den Schimmel "
    "Schimmel sein.") );
  AddDetail( ({ "einwohner", "waechter", "raub", "mord", "erpressung",
                "betrug", "totschlag", "interesse" }), 
    "Das einzige Interesse der Einwohner von Knarkh liegt in Raub, "
    "Totschlag, "
    "Mord, Diebstahl, Betrug und Erpressung.");
  AddDetail( ({ "knarkh", "dorf" }), 
    "Das Dorf liegt draussen.");
  AddDetail( ({ "dinge" }),
    "Mit 'zeige' kannst Du Dir die Dinge anzeigen lassen, die man hier "
    "kaufen kann." );


  AddExit( "nordosten", ROOM "dorf_c5" );
  AddItem( NPC "haendler", REFRESH_DESTRUCT);

}

STDFUNC
