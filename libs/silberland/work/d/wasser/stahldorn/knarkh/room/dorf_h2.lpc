
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddExit( "suedosten", ROOM "dorf_g3.lpc" );
  AddExit( "westen", ROOM "dorf_h1.lpc");

}


STDFUNC
