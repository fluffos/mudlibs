#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kalter Laborraum" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich in einem eisig kalten Laborraum. "
    "Der einzige auffaellige Gegenstand hier ist eine Art Tisch "
    "in der Mitte des Raumes. Die Waende und die Decke sind oed und leer "
    "und reflektieren ein diffuses Licht, das von Nirgendwo herzukommen "
    "scheint. In einer Ecke steht noch ein breiter Schrank.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 8, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "tisch", "labortisch", "gegenstand" }), BS(
    "Ein riesiger nackter Labortisch. Er sieht ganz verdreckt aus. "
    "An den Ecken befinden sich seltsame Schlaufen.") );
  AddDetail( ({ "eck", "ecken" }),
    "An jedem Eck des Tisches sind seltsame Schlaufen angebracht.\n");
  AddDetail( ({ "schlaufe", "schlaufen" }), BS(
    "Die Schlaufen sind wahrscheinlich zum Festbinden nicht "
    "kooperationsbereiter Personen gedacht.") );
  AddDetail( ({ "dreck", "blut" }), BS(
    "Eindeutig. Ganz klar. Der Dreck ist nichts anderes als altes, "
    "getrocknetes Blut. Igitt, wie eklig.") );
  AddDetail( ({ "becken", "waschbecken" }), BS(
    "An einer vergammelten Wand ist noch ein kleines Waschbecken "
    "mit einem Wasserhahn, der zu tropfen scheint."));
  AddDetail( ({ "hahn", "wasserhahn" }),
    "Der Hahn tropft.\n");
  AddDetail( ({ "schrank", "regale" }), BS(
    "Er hat keine Tueren. Im Inneren sind viele Regale angebracht, auf denen "
    "allerlei Werkzeuge und Instrumente liegen."));
  AddDetail( ({ "werkzeuge", "instrumente" }),
    "Uah! *schreck*! Die sehen wirklich furchterregend aus!\n");
  AddDetail( ({ "boden" }), BS(
    "Der Boden ist ziemlich verdreckt. Hier ist schon lange nicht mehr "
    "geputzt worden."));
  AddDetail( ({ "decke", "waende" }),
    "Decke und Waende sind leicht verdreckt, aber sonst leer.\n");
  AddDetail( ({ "wasser" }),
    "Wasser tropft vom Hahn in das Becken.");

  AddSmell( ({ "blut", "dreck" }),
    "Irgendwie suesslich. Auf jeden fall aber ekelerregend.\n");
  AddSmell( ({ "chemikalien" }),
    "Die Chemikalien riechen so... chemisch.\n");

//  AddDetail( ({ "" }),
//    "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht relativ intensiv nach verschiedenen Chemikalien.\n");
    
  AddSound( ({DEFAULT_SOUND, "wasserhahn", "hahn", "tropf", "tropfen", "wasser"}), 
    "Man hoert einen leise vor sich hintropfenden Wasserhahn.\n");

  AddRoomMessage( 
    ({"*Tropf*\n"}),15);

  AddItem( NPC "assistent.lpc", REFRESH_DESTRUCT);

  AddCmd( ({ "drehe" }), "drehen" );

  AddExit( "suedosten", ROOM "dobbo1" );
}

drehen(string str )
{
  notify_fail( "Was willst Du zudrehen?\n" );
  if( str == "wasserhahn zu" || str == "hahn zu" )
  {
    write(
      "Du versuchst den Wasserhahn ganz zuzudrehen, bist aber zu schwach.\n");
    say( TP->Name()+" ruettelt an einem Wasserhahn herum.\n");
    return 1;
  }
  if (str == "wasserhahn auf" || str == "hahn auf")
  {
    write (
      "Du drehst kurz den Hahn auf und laesst etwas Wasser abfliessen.\n"
      "Nach ein paar Sekunden drehst Du wieder so weit es geht zu.\n");
    say(TP->Name()+ " dreht fuer einige Sekunden einen Wasserhahn auf.\n");
    return 1;
  }

  return 0;
}
