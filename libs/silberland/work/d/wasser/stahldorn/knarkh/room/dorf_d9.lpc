#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int wasser;

create()
{
  ::create();

  wasser = 3;
  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Links und rechts von Dir sind zwei Steinmauern. Der Weg fuehrt dazwischen "
    "vorbei. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "boden" }), 
    "Am Boden hat sich bereits eine Pfuetze gebildet.\n" );
  AddDetail( ({ "mauer", "steinmauer", "mauern", "steinmauern" }), 
    "Eine linke Mauer und eine rechte Mauer flankieren den Weg.\n" );
  AddDetail( ({ "weg" }), 
    "Der Weg fuehrt von Suedwesten nach Nordosten.\n" );
  AddDetail( ({ "pfuetze" }), 
    "Eine kleine Pfuetze hat sich am Boden gebildet.\n" );
  AddDetail( ({ "linke mauer" }), 
    "Die linke Mauer wurde dunkelgruen gestrichen. Efeu rankt sich daran "
    "hoch.\n" );
  AddDetail( ({ "efeu" }), 
    "An der linken Mauer klettert Efeu empor.\n" );
  AddDetail( ({ "rechte mauer" }), BS(
    "An der rechten Mauer fliesst Wasser in einem bestaendigen Strom nach "
    "unten. Am Boden sammelt es sich zu einer kleinen Pfuetze.") );
  AddDetail( ({ "wasser", "strom" }), 
    "Wasser rinnt bestaendig an der Mauer nach unten.\n" );
//  AddDetail( ({ "" }), 
//    "" );

  AddExit( "nordosten", "./dorf_e10.lpc" );
  AddExit( "suedwesten", "./dorf_c8.lpc" );

  AddCmd( ({ "trinke", "trink" }), "trinken");

}

STDFUNC

int trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if (str != "wasser" && str != "pfuetze" && str != "aus pfuetze")
    return 0;

  if(!wasser)
  {
    notify_fail("Es hat sich noch nicht genug Wasser angesammelt.\n");
    return 0;
  }
  write("Du trinkst das Wasser und fuehlst Dich erfrischt.\n");
  say(TP->Name()+" trinkt etwas Wasser aus einer Pfuetze.\n");
  TP->reduce_hit_point(-60);
  TP->restore_spell_points(60);
  wasser--;
  return 1;
}

reset()
{
  wasser = 3;
  ::reset();
}
