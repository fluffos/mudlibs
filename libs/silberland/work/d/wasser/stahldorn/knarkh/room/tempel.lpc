#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Tempel von Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Dies ist ein duesterer Tempelraum. "
    "Unzaehlige Kerzenleuchter erhellen den Raum. Genau in der Mitte "
    "steht ein dunkler, blutbefleckter Altar.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "leuchter", "kerzenleuchter", "kerzen", "kerzen" }), BS(
    "Die Kerzen erhellen den Raum ein wenig. Sie stehen ueberall. "
    "Auf dem Boden, auf dem Altar, an den Waenden. Auch von der "
    "Decke haengen ein paar Kerzenleuchter.") );
  AddDetail( ({ "boden" }), BS(
    "Am Boden sind viele Kerzen in verschiedenen Anordnungen aufgestellt.") );
  AddDetail( ({ "anordnungen" }),
    "Hauptsaechlich Pentagramme.\n" );
  AddDetail( ({ "pentagramme", "pentagramm" }), BS(
    "Sie dienen der schwarzen Magie, die hier manchmal ausgeuebt wird.") );
  AddDetail( ({ "wand", "waende" }), BS(
    "Die Waende sind mit Runen und magischen Formeln vollgeschmiert.") );
  AddDetail( ({ "runen", "formeln", "rune", "formel" }), BS(
    "Du kannst versuchen, sie zu lesen, aber sei gewarnt, sie strahlen "
    "eine boesartige Energie aus!") );
  AddReadDetail( ({ "formeln", "formel" }),
    "SACATZ HURLA DANABUN!\n"+
    "DECOLA NIBBEL XI!\n"+
    "COMBRU DUKU MARU!\n"+
    "DLOG QORM DAHAGESH DUKU!\n"+
    "HURLA POCK, MARU EXXENTAH, MARU DENTAH!\n" );
  AddDetail( ({ "rune", "runen", "zeichen" }), BS(
    "Sosehr Du Dich auch anstrengst, Du kannst diese fremdartigen Zeichen "
    "nicht entziffern.") );
  AddDetail( ({ "decke" }), 
    "Ein paar Kerzenleuchter haengen von der Decke.\n" );
  AddDetail( ({ "altar" }), BS(
    "Der Altar steht genau in der Mitte des Raumes. Genaugenommen siehst "
    "Du nicht den Altar selber, sondern die Masse an Opfergaben, "
    "Kerzen, Gebetsteppichen, Ikonen und anderen mystischen "
    "Kultgegenstaenden, die man davor aufgetuermt hat.") );
  AddDetail( ({ "teppich", "gebetsteppich", "teppiche", "gebetsteppiche"}), 
    BS( "Viele Teppiche hat man meterdick vor und auf dem Altar "
    "aufgetuermt. Die, die am Boden liegen, haben bereits viele "
    "blankgescheuerte Stellen durch die vielen Glaeubigen, die hier "
    "gebetet haben muessen.") );
  AddDetail( ({ "stellen" }), BS(
    "Die Teppiche haben blankgescheuerte Stellen. Neu sind sie also nicht "
    "mehr.") );
  AddDetail( ({ "opfergaben", "opfer" }), BS(
    "Bei den Opfergaben handelt es sich hauptsaechlich um Dinge, die "
    "mit Blut und Leichenteilen zu tun haben. Dich ekelt davor." ));
  AddDetail( ({ "blut", "leichenteile", "leichen", "flecken", "fleck" }), BS(
    "Das ganze sieht dermassen abstossend aus, dass Du lieber kein zweites "
    "Mal hinschauen willst. *schauder*") );
  AddDetail( ({ "ikonen", "ikone" }),
    "Bilder mit schrecklichen Fratzen darauf.\n" );
  AddDetail( ({ "fratzen" }),
    "Gesichter des Boesen. Sie starren Dich an.\n" );
  AddDetail( ({ "kultgegenstaende", "gegenstaende" }), BS(
    "Sie dienen alle irgendeinem dunklen, mystischen Zweck. Brauchbares "
    "findest Du allerdings nichts darunter.") );
  AddSound(DEFAULT_SOUND, BS(
    "Irgendwoher dringen unheimliche Geraeusche. Sie klingen, als ob jemand "
    "betet, und dabei immer dieselbe Litanei wieder und wieder aufsagt.") );
  AddSound( ({ "geraeusche", "geraeusch", "litanei" }), BS(
    "So genau Du auch hinhoerst, Du verstehst leider kein einziges Wort."));
  AddSmell(DEFAULT_SMELL, BS(
    "Es riecht muffig und abgestanden. Ausserdem ist alles von diesem "
    "widerlichen Geruch durchsetzt, den die Kerzen absondern.") );
  AddSmell( ({"kerzen", "kerze", "geruch" }),
    "Die Kerzen riechen unangenehm suesslich.\n");

  // auskommentiert 16.8.2003/woody - da gibt es keine Funktion "betreten"...
  // AddCmd("betrete", "betreten");
  AddCmd( ({"sag"}), "sagen", 1);
  AddCmd( ({ "'", ","}), "sagen", 1);
  AddCmd( "bete", "beten");

  NewDoor("sueden", ROOM "dorf_g4", "portal", 
     ({D_FLAGS, DOOR_RESET_CL, 
       D_NAME, "Portal",
       D_GENDER, NEUTER, 
       D_SHORT, "Ein riesiges Portal fuehrt nach Sueden. (%s)",
       D_LONG, "Ein grosses Portal. Es fuehrt nach Sueden auf die Plaza.\n",}));

  NewDoor("suedwesten", ROOM "dorf_g3", ({"tuer", "hintertuer", "holztuer"}), 
     ({D_FLAGS, DOOR_RESET_CL, 
       D_NAME, "Tuer",
       D_GENDER, FEMALE, 
       D_SHORT, "Eine kleine Hintertuer ist in die Wand eingelassen. Sie ist %s.\n",
       D_LONG, BS(
         "Eine kleine Holztuer. Sie ist glatt in der Wand versenkt. Klinke, "
         "Schloss oder Knauf sind nicht zu sehen."),
       D_OPENTESTFUNC, "tuerzu",
       D_FUNC2, "zuschnapp" }));


}

int tuerzu()
{
    write("Du brichst Dir die Fingernaegel ab beim erfolglosen Versuch, "+
          "sie zu oeffnen.\n");
    say(TPN+" versucht vergeblich, die Hintertuer zu oeffnen.\n");
    return 1;

}

STDFUNC


sagen2(string str)
{
  str = TP->_unparsed_args();
  if (str == "DUKU MARU!" || str == "DUKU MARU") str = "COMBRU DUKU MARU";
  return sagen(str, 1);
}

sagen(string str, int sagflag)
{
  object silberring;

  if(!sagflag) str = TP->_unparsed_args();
//  DB(str);
  if(str && str[0] == 32) str = str[1..];
  if (str == "COMBRU DUKU MARU!" || str == "COMBRU DUKU MARU") 
  { 
     if(silberring=present("\ncombru", TP))
     {
       write("Du sprichst die magischen Worte aus.\n");
       say(TPN+" murmelt ein paar magische Worte.\n");
       silberring->aufladen();
     }
     else
        spell_fail(TPN);
     return 1;
  }

  if (str == "DECOLA NIBBEL XI" || str == "DECOLA NIBBEL XI!")
  {
     write("Du sprichst die magischen Worte aus.\n");
     say(TPN+" murmelt ein paar magische Worte.\n");
     if (!present("\bSperrer", TP))
       clone_object(OBJ "sperrer")->move(TP, M_NOCHECK);
     write(BS("Als Du die Worte aussprichst, versinkst Du in eine tiefe "
       "Trance. Die Welt um Dich herum versinkt in nebuloese "
       "Nebensaechlichkeit. Alles scheint unwichtig, waehrend Du den "
       "dunklen Weisheiten lauschst, die von ueberall auf Dich einstroemen. "
       "Du bist so gebannt, dass Du unfaehig bist, Dich zu bewegen."));
     say(BS(
       TP->Name(WESSEN)+ " Augen schweifen ploetzlich in die Ferne."));
     return 1;
  }

  if (str == "SACATZ HURLA DANABUN!" || str == "SACATZ HURLA DANABUN" ||
      str == "DLOG QORM DAHAGESH DUKU!" || str == "DLOG QORM DAHAGESH DUKU"||
      str == "HURLA POCK, MARU EXXENTAH, MARU DENTAH!")
  {
        spell_fail(TPN);
        return 1;
  }
  
  return 0;
}

void spell_fail(string wer)    
{
       write("Du sprichst die magischen Worte aus, aber nichts passiert.\n");
       say(CAP(wer) + " murmelt ein paar magische Worte.\n");
}

beten(string str)
{
   write("Du kniest nieder und betest zu den Goettern des Boesen.\n");
   say(TPN+" kniet nieder und betet.\n");
   if(find_call_out("boeser") > -1)
   {
     remove_call_out("boeser");
     write("Die boese Magie hier drin hat sich noch nicht aufgeladen.\n");
   }
   else
       write("Du fuehlst Dich nun ein wenig boeser als vorher.\n");

   call_out("boeser", 5);
   return 1;
}

boeser()
{
  int align;

  align = TP->QueryProp(P_ALIGN);
  TP->SetProp(P_ALIGN, align - 1 - (align+100)/50 );
}


zuschnapp()
{
//   _close_door("tuer");
  call_other(DOOR_MASTER, "SetDoorStatus", ROOM "dorf_g3", -1);
  write("Die Holztuer faellt hinter Dir zu.\n");
  say("Die Holztuer faellt hinter "+TP->name(WEM)+" zu.\n");
}


