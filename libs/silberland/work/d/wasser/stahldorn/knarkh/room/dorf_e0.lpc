#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

object mund;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Sackgasse im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
	"Die Seitengasse entpuppt sich hier als Sackgasse. Suedlich von Dir "
	"befindet sich ein Haus mit einer Tuer drin. Neben der Tuer stehen "
	"ein paar verkrueppelte Buesche, die eine seltsame Form haben. "
	"@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS


  AddDetail( ({ "gasse", "seitengasse", "sackgasse" }), BS(
    "Die Gasse endet hier vor einem Haus." ) );
  AddDetail( ({ "haus", "steinhaus" }), BS(
    "Das Haus suedlich von Dir hat anscheinend auch schon bessere Zeiten "
    "erlebt. Die Waende sind dreckig und ueberall broeckelt der Putz ab. "
    "Darauf dass es eines der wenigen reinen Steinhaeuser in Knarkh ist "
    "kann sich der Besitzer nichts einbilden. Eine Tuer und zwei schaebige "
    "Fenster links davon komplettieren das Bild." ) );
  AddDetail( ({ "putz" }), BS(
    "Dreckig und broecklig und uninteressant." ) );
  AddDetail( ({ "besitzer" }), BS(
    "Der Besitzer ist nirgends zu sehen. Vielleicht ist er drinnen im Haus."));
  AddDetail( ({ "wand", "waende", "fassade" }), BS(
    "Das Wort 'renovieren' scheint dem Besitzer unbekannt zu sein. Die ganze "
    "Fassade ist verdreckt und desolat. Genau in der Mitte der Wand befindet "
    "sich eine Tuer. Links davon sind zwei Fenster, und rechts davon wird "
    "die Wand durch ein paar Buesche verdeckt.") );
  AddDetail( ({ "dreck" }), 
    "Alle moeglichen Arten von Dreck: \n" +
    "schmutziger Dreck, grauslicher Dreck, stinkender Dreck, \n" +
    "dreckiger Dreck, brauner Dreck, schwarzer Dreck, roter Dreck.\n" );
  AddDetail( ({ "mitte" }), BS(
    "Genau in der Mitte der Wand ist eine Tuer." ) );
  AddDetail( ({ "schmutziger dreck", "schmutzigen dreck" }), BS(
    "Der schmutzige Dreck schaut nur eklig aus, wurde aber hauptsaechlich "
    "durch eher natuerliche Sachen verursacht." ) );
  AddDetail( ({ "grauslicher dreck", "grauslichen dreck" }), BS(
    "Im Gegensatz zum schmutzigen Dreck ist ist der grausliche Dreck nicht "
    "nur optisch, sondern auch inhaltlich eklig." ) );
  AddDetail( ({ "stinkender dreck", "stinkenden dreck" }), BS(
    "Diese Art von Dreck mieft furchtbar. Sie ist hier am haeufigsten zu "
    "finden." ) );
  AddDetail( ({ "dreckiger dreck", "dreckigen dreck" }), BS(
    "Beim dreckigen Dreck muss man besonders aufpassen, dass man sich nicht "
    "selber dreckig macht. Die besonders fiese und hinterhaelige Eigenschaft "
    "des dreckigen Drecks ist naemlich, dass er ausgesprochen dreckig ist."));
  AddDetail( ({ "brauner dreck", "braunen dreck" }), BS(
    "Der braune Dreck ist schon aelter und etwas vertrocknet, kann aber seine "
    "Faekalnatur nicht verbergen." ) );
  AddDetail( ({ "schwarzer dreck", "schwarzen dreck" }), 
    "Der schwarze Dreck strahlt das Boese aus.\n" );
  AddDetail( ({ "roter dreck", "roten dreck" }), BS(
    "Der rote Dreck ist hier recht haeufig vertreten. Er ist dem braunen "
    "Dreck total aehnlich. Man koennte fast glauben, es sei dasselbe. ") );
  AddDetail( ({ "tuer", "tuere" }), BS(
    "Sie ist geschlossen und Du hast keine Ahnung, wie man sie aufmachen "
    "koennte. Weder Schloss, noch Klinke, noch Angeln und Scharniere, noch "
    "Schluesselloch, noch Klopfer, noch Knauf noch Klingel, noch sonst "
    "irgendetwas findest Du an dieser Tuer. Sie ist sozusagen nackt." ) );
  AddDetail( ({ "fenster" }), BS(
    "Die Fenster haben keine Scheiben mehr und sind von innen mit einem "
    "pechschwarzen Vorhang zugehaengt." ) );
  AddDetail( ({ "vorhang", "vorhaenge" }), BS(
    "Die Vorhaenge wurden irgendwie innen vors Fenster genagelt, sodass man "
    "nicht durchschauen kann. Reinklettern geht auch nicht, versuchs erst "
    "gar nicht, dann spar ich mir ein Raumkommando." ) );
  AddDetail( ({ "busch", "buesche" }), BS(
    "Die Buesche rechts von der Tuer sehen ungepflegt aus. Die Blaetter "
    "fallen ab und die Aeste stehen wirr und verkrueppelt herum. "
    "" ) );
  AddDetail( ({ "blaetter", "blatt" }), BS(
    "Gelblich und krank." ) );
  AddSpecialDetail( ({ "aeste", "ast" }), "krueppel" );
  AddDetail( ({ "form" }), BS(
    "Die Form der Buesche ist verdreht und schief." ) );
  AddDetail( ({ "stein" }), BS(
    "Das Haus hier ist aus Stein." ) );
//  AddDetail( ({ "" }), BS(
//    "" ) );

  AddSmell("dreck", "Er riecht einzigartig ekelhaft.\n");

  AddExit( "norden", "./dorf_f0.lpc" );

  AddCmd( ({"kletter", "klettere"}), "klettern");
  AddCmd( ({"oeffne"}), "oeffnen");


}


STDFUNC

klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if (member(explode(str, " "), "fenster") >= 0)
    {
      write("Argl. Ich hab gesagt man kann nicht klettern!\n" );
      return 1;
    }
  return 0;
}

oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (str=="tuer"||str="tuere")
  {
    write ("Du versuchst vergeblich die Tuere zu oeffnen.\n" +
	   "Es geht nicht.\n");
   return 1;
  }
  return 0;
}


string krueppel()
{
  remove_call_out("entdeckt");
  call_out("entdeckt", 4);
  return("Verkrueppelt. Sonst eigentlich nix.\n");
}

entdeckt()
{
  if(TO == environment(TP))
  {
    write (BS(
      "Ploetzlich faellt Dir ein, dass bei den verkrueppelten Aesten "
      "vielleicht doch etwas zu sehen war. Du biegst sie beiseite und "
      "entdeckst etwas sehr seltsames. In die Wand eingelassen ist ein "
      "riesiger Mund. ") );
    AddDetail( ({"ast", "aeste"}), "Verkrueppelt.\n");
    mund = clone_object(NPC "mund");
    mund->move(TO, M_NOCHECK|M_SILENT);
  }
}

reset()
{
  if(objectp(mund)) mund->remove();
  AddSpecialDetail( ({ "aeste", "ast" }), "krueppel" );
  ::reset();
}


