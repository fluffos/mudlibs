#include "../def.h"
#include "./knarkh.h"

inherit "/std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int licht;

create()
{
  ::create();

  licht = 0;

  SetProp( P_INT_SHORT, "Im geheimen Haus in Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Du bist in einem Haus voller Muender. An den Waenden, and der Decke, "
    "am Boden. Ueberall oeffnen sich Gestein oder Holz zu rosaroten, "
    "fleischigen Oeffnungen, aus denen es ununterbrochen wirr plappert, "
    "palavert, ruelpst, hustet, schreit, keucht, spuckt, knirscht, singt "
    "und lacht. Es muessen tausende koerperlose Muender sein, die Dich "
    "umgeben, und deren feuchte Ausduenstungen Dich umhuellen wie einen "
    "stinkenden Nebel. In der Mitte des Raumes befindet sich ein Portal.") );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );


  AddDetail( ({ "portal" }), 
    "Das Portal schimmert gruenlich. Du kannst es betreten, wenn Du Dich "+
    "traust.\n" );
  AddDetail( ({ "mund", "muender" }),BS( 
    "Um Dich herum sind so viele davon, dass Du Dich gar nicht auf einen "
    "einzelnen konzentrieren kannst. Manche sind boese, manche sind gut. "
    "Manche haesslich, manche schoen. Du siehst junge, alte, grosse, kleine "
    "rote, blasse, breite, schmale, lautere, leisere, kluge, dumme, "
    "weibliche, maennliche, feuchte, trockene... etc. etc. Muender.") );
  AddDetail( ({ "maennliche muender", "maennlicher mund" }), 
    "Auf der Oberlippe kann man einen angedeuteten Bart erkennen.\n" );
  AddDetail( ({ "weibliche muender", "weiblicher mund" }), 
    "Sanft und feminin.\n" );
  AddDetail( ({ "grosse muender" }), 
    "Gross und gierig.\n" );
  AddDetail( ({ "kleine muender" }), 
    "Klein und harmlos.\n" );
  AddDetail( ({ "boese muender" }), 
    "Furchtbar boese.\n" );                
  AddDetail( ({ "gute muender" }), 
    "Gutmuetig und nett.\n" );
  AddDetail( ({ "haessliche muender" }), 
    "Voller Fieberblasen, verzerrt und mit gelben Zaehnen.\n" );
  AddDetail( ({ "schoene muender", "huebsche muender" }), 
    "Zarte, aber volle Lippen. Geschmeidig und schoen.\n" );
  AddDetail( ({ "junge muender"}), 
    "Noch voller Tatendrang.\n" );
  AddDetail( ({ "alte muender" }), 
    "Verwittert und ohne Zaehne.\n" );
  AddDetail( ({ "rote muender" }), 
    "Blutrote Lippen, die man am liebsten kuessen moechte.\n" );
  AddDetail( ({ "blasse muender" }), 
    "Ohne Blut.\n" );
  AddDetail( ({ "feuchte muender" }), 
    "Lauter kleine Speicheltropfen fliegen umher, wenn sie reden.\n" );
  AddDetail( ({ "trockene muender" }), 
    "Viel angenehmer als die feuchten Muender.\n" );
  AddDetail( ({ "schmale muender" }), 
    "Voller Bosheit.\n" );
  AddDetail( ({ "breite muender" }), 
    "Sie scheinen dauernd so unecht zu grinsen.\n" );
  AddDetail( ({ "kluge muender" }), 
    "Sie strotzen vor Weisheit.\n" );
  AddDetail( ({ "dumme muender" }), 
    "Sie plappern dauernd Bloedsinn.\n" );
  AddDetail( ({ "laute muender", "lautere muender" }), 
    "Du musst Dir die Ohren zuhalten.\n" );
  AddDetail( ({ "leise muender", "leisere muender" }), 
    "Du verstehst sie fast nicht.\n" );
  AddSound( ({ DEFAULT_SOUND, "mund", "muender" }), 
    "Ein wahres Crescendo aus tausend Stimmen hallt durch den Raum.\n" );
  AddDetail( ({ "boden" }), BS(
    "Der Boden ist von Muendern uebersaet. Teilweise stehst Du auf ihnen, "
    "worueber die sich auch bitter beklagen. Pass auf, dass Du nicht auf "
    "einen der grossen Muender steigst, denn die koennten Dich "
    "verschlucken.") );
  AddDetail( ({ "decke" }), 
    "Ueberall Muender, Muender, Muender, Muender, Muender, Muender.\n" );
  AddDetail( ({ "wand", "waende" }), 
    "Ueberall Muender, Muender, Muender, Muender, Muender, Muender.\n"
    "An einer Wand entdeckst Du einen kleinen Knopf.\n" );
  AddSmell( ({ DEFAULT_SMELL }), 
    "Es riecht feucht und stickig hier drin. Richtig muffig.\n" );
  AddDetail( ({ "tuer", "tuere" }), BS(
    "Die Tuer sieht aus wie ein rechteckiger Mund, "
    "aber es ist trotzdem doch nur eine Tuer und sonst nichts.") );
  AddDetail( ({ "fenster" }), 
    "Die Fenster sind mit Vorhaengen bedeckt, sodass kein Licht "+
    "hereinkommt.\n" );
  AddDetail( ({ "vorhang", "vorhaenge", "brokat" }), 
    "Schwerer, schwarzer Brokat.\n" );
  AddDetail( ({ "holz", "gestein" }), 
    "Alles ist von Muendern uebersaet.\n" );
  AddDetail( ({ "knopf" }), 
    "Vielleicht kann man draufdruecken?\n" );


//  AddDetail( ({ "" }), 
//    "" );

  AddRoomMessage( ({ 
    "Ein grosser Mund hustet.\n",  
    "Ein lauter Mund lacht laut auf.\n",  
    "Ein leiser Mund murmelt: Hmmdigrmmm. Hubsididubsi Flabberadab.\n",  
    "Ein breiter Mund schmollt.\n",  
    "Ein roter Mund sagt: He Du! Dreh Dich um!\n",  
    "Ein schmaler Mund kichert.\n",  
    "Ein huebscher Mund sagt: Komm und kuess mich. Ich will Dich.\n",  
    break_string(
       "Hihi, und hab ich schon erzaehlt, wie ich damals ganz alleine "
       "gegen die drei Maulwuerfe gekaempft hab? Ihr haettet mich sehen "
       "sollen! Euch haette es die Sprache verschlagen!", 78,   
       "Ein kleiner Mund plappert: "),
    "Ein haesslicher Mund schreit: Geh weg. GEH WEG!\n",  
    "Ein grosser Mund versucht, Dich zu beissen.\n",  
    "Ein lauter Mund meint: Also ICH hab Hunger. Ihr nicht?\n",  
    "Ein leiser Mund fluestert: Psst! Sags nicht weiter!\n",
    "Ein breiter Mund ruelpst unanstaendig.\n",
    "Ein Mund singt: Rote Lippen muss man kuessen, denn zum Kuessen "+
    "sind sie da!\n",
    "Ein roter Mund leckt sich die Lippen ab.\n",
    "Ein schmaler Mund tuschelt: Willst Du ein Geheimnis wissen?\n",  
    "Ein huebscher Mund kuesst Dich zaertlich.\n",  
    "Ein kleiner Mund knirscht unangenehm mit den Zaehnen.\n",  
    "Ein haesslicher Mund palavert endlose Monologe vor sich hin.\n",  
    "Ein grosser Mund streckt Dir die Zunge heraus.\n",  
    "Ein lauter Mund bruellt: VIVA LA REVOLUCION!\n",
    "Ein leiser Mund sagt: Ja, aeh Sie. Aeh, wenn Sie so freundlich waeren...\n",
    "Ein breiter Mund fragt Dich: Hattu Karotte?\n",
    "Ein hungriger Mund isst etwas.\n",
    "Ein schmaler Mund klappert mit den Zaehnen.\n",
    "Ein huebscher Mund ruft entsetzt um Hilfe.\n",  
    "Ein kleiner Mund spuckt Dich an.\n",  
    "Ein haesslicher Mund jagt Dir Angst ein.\n",  
    "Ein grosser Mund sagt: Hmmm. Ich glaube, ich hab die Loesung gefunden.\n",  
    "Ein lauter Mund sagt mit droehnender Stimme: Ich verzeihe Dir.\n",  
    "Ein leiser Mund grummelt: Grummelbrummelargl. Grummelbrummelhmpf.\n",  
    "Ein breiter Mund grinst Dich an.\n",  
    "Ein roter Mund laechelt Dich an.\n",  
    "Ein schmaler Mund knabbert an seiner Unterlippe.\n",  
    "Ein huebscher Mund sagt mit fester Stimme: Ich bin ein Berliner!\n",  
    "Ein kleiner Mund weint: Aua! Mami! Ich hab soooo Zahnweh!\n",  
    "Ein Schnabelmund kraechzt: Nimmermehr!\n",  
    "Ein schmutziger Mund summt etwas vor sich hin.\n",
    "Ein kleiner Mund quengelt: Immer ich. Immer auf die Kleinen.\n",
    "Ein Mund an der Decke sagt: Hihi. Du hast ja Schuppen.\n",
    "Ein Mund am Boden flucht: Ich hab es so satt! So satt hab ich es!\n",
    "Ein Mund in der Wand stellt einem anderen Mund eine Raetselaufgabe.\n",
    break_string(
       "Ich weiss ein lustiges Raetsel! Hoert zu! Hoert mir doch zu! "
       "Was ist das? 'Es hat sieben Beine, aber nur fuenf davon koennen "
       "fliegen.' Na? Wisst ihrs? Da kommt ihr NIE drauf!", 78, 
       "Ein eifriger Raetselmund sagt: "),
    "Ein weiser Mund sagt: Und in Anbetracht der disjunkten Hyperbolisation...\n",
    "Ein Mund schreit Dir ins Ohr.\n",
    "Ein paar Muender hinter Dir spielen 'Stille Post'.\n",
    "Ein weiblicher Mund keift: Typisch Maenner. Die wollen immer nur das eine.\n",
    "Ein maennlicher Mund seufzt: Also ich werde die Frauen nie verstehen.\n",
    "Ein Mund gaehnt und steckt zwei andere damit an.\n",
    "Ein kluger Mund rechnet: Fuenf hoch vier ist sechshundertfuenfundzwanzig.\n",
    "Ein dummer Mund rechnet: Sieben minus zwei ist sechs. Glaub ich.\n",
    "Irgendein Mund sagt: Woody ist doof!\n",
    "Ein Mund sagt: Schoenes Wetter heute.\n",
    "Ein gieriger Mund schnappt nach Dir.\n",
    "Ein Mund sagt: Wetten wir, dass ich mich selber essen kann?\n",
    "Ein netter Mund gibt einem anderen netten Mund ein nettes Bussi.\n",
    "Ein naiver Mund sagt: Und ihr meint es gibt WIRKLICH keinen Osterhasen?\n",
    "Ein schizophrener Mund singt einen Kanon.\n",
    "Ein lustiger Mund schneidet ein paar Grimassen.\n",
    "Ein schmaler Mund pfeift vor sich hin.\n",
    "Ein offener Mund staunt ueber Dich.\n",
    "Ein geschlossener Mund gibt seltsame Toene von sich.\n",
    "Ein betrunkener Mund lallt: Di Magia san <hicks> olle Vabrecha...\n",
    "Ein stinkender Mund huellt Dich in eine Knoblauchwolke ein.\n",
    "Ein blasser Mund lacht ueber den Witz eines witzigen Mundes.\n",
    "Ein alter Mund brummt.\n",
    "Ein junger Mund kreischt.\n",
    "Ein rauchender Mund pafft an seiner Zigarre.\n",
    "Ein Mund betet: Et in nomine patris et filii et spiritus sancti. Amen.\n",
    "Ein Mund in der hintersten Ecke prahlt mit seinen Goldzaehnen.\n"
                    }), 15);

  AddExit("raus", ROOM "dorf_e0");

  AddCmd( ({ "betritt", "betrete" }), "betreten" );
  AddCmd( ({ "drueck", "druecke" }), "lichtschalter" );
}

int betreten(string str)
{
   object daemon;

   if(str == "portal")
   {
     daemon = present(TP->Name()+"Daemon\n");
     if(objectp(daemon) && daemon->QueryMaster() == TP->Name())
     {
        write("Du betrittst das Portal und findest Dich ganz woanders "+
        "wieder.\n");
        say(TP->Name()+" betritt das Portal.\n");
        TP->move(ROOM "dobbo2", M_TPORT);
        return 1;
     }
     else
     {
       notify_fail("Nur ein Daemon, der Dich begleitet, kann Dich "+
                   "dazu ueberreden.\n");
       return 0;
     }
   }
   notify_fail("Was willst Du betreten?\n");
   return 0;
}

int lichtschalter(string str)
{
   if(str != "knopf") return 0;

   say(TP->Name()+" drueckt auf einen Knopf.\n");
   if(licht)
   {
      write("Du drueckst auf den Knopf, aber es passiert nix.\n");
   }
   else
   {
     licht=1;
     write("Du drueckst auf den Knopf.\n");
     tell_room(TO, "Auf einmal stroemt von ueberall Licht herein.\n");
     SetProp(P_LIGHT, 1);
   }

   return 1;
}

reset()
{
  ::reset();
  if(licht) tell_room(TO, "Es wird auf einmal wieder dunkel.\n");
  licht = 0;
  SetProp(P_LIGHT, 0);
}
