#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

string maltext;

private string QueryGemalt();

create()
{
  ::create();

  maltext = "";
  
  SetProp( P_INT_SHORT, "Ein zerstoerter Raum" );
  SetProp( P_INT_LONG, BS( 
    "Du stehst im Inneren eines Hauses. Hier sieht es aus, wie auf einem " 
    "Schlachtfeld. Die gesamte Einrichtung des Raumes wurde zertruemmert, "
    "Tische, Schraenke, saemtliches Mobiliar - alles wurde umgeworfen, "
    "zerschlagen und kaputtgemacht. Regale hat man von den Waende gerissen, "
    "den Inhalt von Truhen und Kisten am Boden verstreut... Kurz: hier "
    "muessen Barbaren gehaust haben. Andere Raeume in diesem Gebaeude "
    "kannst Du nicht betreten, da die Schuttberge Dich daran hindern, "
    "weiter vorzudringen.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( "boden", BS(
    "Der Boden ist uebersaet von den Resten des zerschlagenen Mobiliars. "
    "Bretter, Polsterueberzuege, Glasscherben, Mauerbrocken, Muell, "
    "Knochen und noch vieles mehr liegen hier. Auf allem liegt eine dicke "
    "Schicht aus Staub, als ob schon lange niemand mehr hier gewesen "
    "waere.") );
  AddDetail( ({ "wand", "waende" }),BS(
    "Die Waende sind durch die Schutthaufen verdeckt und eigentlich gar "
    "nicht sichtbar. Aber sie muessen wohl wo sein, sonst waere das ganze "
    "Haus bereits eingestuerzt.") );
  AddDetail( "decke",   
    "Eine Oellampe haengt von der spinnwebenuebersaeten Decke.\n" );
  AddDetail( ({ "lampe", "oellampe" }), BS(   
    "Eine simple Lampe haengt ziemlich weit oben, knapp unter der "
    "Decke. Sie scheint das einzige Stueck hier gewesen zu sein, das nicht "
    "mutwillig in seine Einzelteile zerlegt wurde.") );
  AddDetail( ({ "haus", "gebaude" }), BS(
    "Das Gebaeude steht natuerlich leer, denn wer will schon HIER wohnen? "
    "Hmm. Eigentlich willst Du gar nicht wissen, wer hier wohnen will.") );
  AddDetail( ({ "schutt", "haufen", "schutthaufen", 
                "schuttberge", "schuttberg" }), BS(
    "Du wagst Dich nicht weiter vor. Du koenntest schliesslich verschuettet "
    "werden. Die Schutthaufen reichen bis fast an die Decke.") );
  AddDetail( "staub", BS(
    "Eine dicke Staubschicht hat sich ueberall festgesetzt. Man koennte "
    "mit dem Finger direkt etwas in den Staub malen. Vielleicht hat das "
    "sogar schon jemand vor Dir getan? Mach mal 'lies staub'!") );
  AddSmell( "staub",   
    "Haaaaaaaatschhhhhhhhi!\n" );
  AddReadDetail( "staub", #'QueryGemalt );
  AddDetail( ({ "reste", "moebel", "mobiliar", "einrichtung" }),
    "Alles wurde zerschlagen und liegt nun in Truemmern am Boden.\n" );
  AddDetail( ({ "truemmer" }),
    "Es ist alles kaputt. Du findest nichts brauchbares.\n" );
  AddDetail( ({ "bretter" }),   
    "Die Bretter, die herumliegen sind alt, morsch und verfault.\n" );
  AddDetail( ({ "polsterueberzuege", "ueberzuege" }), BS(
    "Es scheint, als ob frueher einmal ein Polstersessel oder eine "
    "Couch zur Einrichtung gehoert haben, aber jetzt sieht man davon "
    "nichts mehr.") );
  AddDetail( ({ "glas", "glasscherben", "scherben" }),   
    "Die Scherben kommen wahrscheinlich von den zerschlagenen Fenstern.\n" );
  AddDetail( ({ "brocken", "mauerbrocken" }), BS(
    "Sie wurden direkt aus den Mauern herausgerissen. Der oder die Vandalen "
    "muessen eine ungeheure Kraft gehabt haben.") );
  AddDetail( "knochen",
    "Ein paar verwitterte Knochen liegen auch herum.\n" );
  AddDetail( ({ "tische", "schraenke" }), BS(
    "Von der urspruenglichen Einrichtung des Raumes ist zu wenig uebrig "
    "geblieben, als dass man sagen koennte, was er einst dargestellt hat."));
  AddDetail( ({ "regale", "buecherregale" }), BS( 
    "Die Buecherregale, die einst an den Waenden montiert waren, liegen "
    "nun zerbrochen am Boden.") );
  AddDetail( ({ "buecher" }), BS(
    "Von den Buechern ist seltsamerweise nichts mehr zu sehen. Die Taeter "
    "haben sie mitgenommen oder verbrannt.") );
  AddDetail( "muell", 
    "Berge stinkenden Muells gesellen sich zum uebrigen Schutt.\n" );
  AddSmell( "muell", 
    "Der Muell stinkt.\n" );
  AddSound( DEFAULT_SOUND, BS(
    "Hie und da hoert man ein gefaehrliches Quietschen und Knarren. Es "
    "kommt von den alten, morschen Dachbalken, die der Belastung wohl "
    "nicht mehr lange standhalten werden.") );
  AddSmell( DEFAULT_SMELL, 
    "Es riecht nach fauligem Muell. Die Luft ist muffig und stickig.\n");
  AddSound( ({ "quietschen", "knarren", "dachbalken" }), BS(
    "Ueberall quietscht und knarrt es, als ob geisterhafte Wesen am Dach "
    "herumlaufen wuerden.") );
  AddSmell( "luft", 
    "Die Luft riecht total abgestanden.\n" );
  AddDetail( "dach", BS(
    "Du kannst von innerhalb des Hauses das Dach nicht sehen. Und eine "
    "Treppe oder Leiter, mit der man hinaufsteigen koennte, gibt es hier "
    "nicht.") );
  AddDetail( ({ "treppe", "leiter" }), 
    "Du suchst vergeblich nach einer Moeglichkeit, aufs Dach zu gelangen.\n");
  AddDetail( ({ "truhen", "kisten", "kiste" }), BS(
    "Ausgeleerte Truhen und Kisten liegen herum. Eine der Truhen erweckt "
    "Deine Aufmerksamkeit.") );
  AddDetail( "truhe", BS(
    "Eine kleine metallische Truhe in der Ecke liegt umgedreht am Boden. "
    "Durch ihre eisenbeschlagene Messingumwandung unterscheidet sie sich "
    "von den anderen Truhen, die aus Holz gemacht sind. Vielleicht solltest "
    "Du sie umdrehen, um zu sehen, was sich darunter verbirgt?") );
  AddDetail( ({ "ecke", "ecken" }), 
    "Dort befindet sich nur Schutt.\n" );
  AddDetail( ({ "spinnweben" }), 
    "Die Decke ist voll davon. Manchmal sieht man sogar noch ein paar tote "
    "Insekten darin." );
  AddDetail( ({ "insekten" }), 
    "Die sind schon lange lange tot.\n" );

//  AddDetail( ({ "" }), 
//    "" );
  
  AddCmd("male", "malen");
  AddCmd("drehe", "drehen");

  AddExit( "osten", "./dorf_f3.lpc" );
}

int malen(string str)
{
   str = TP->_unparsed_args();
   if (!str) 
   {
     notify_fail("Was willst Du denn in den Staub malen?\n");
     return 0;
   }
   maltext = BS("'" + str + "'");
   write(BS("Du wischst den Staub glatt und malst '"+ str +"' hinein.")); 
   say(TP->Name() + " schreibt etwas in den Staub.\n");
   return 1;
}

private string QueryGemalt()
{
   if(maltext == "")
     return("Es hat noch niemand etwas in den Staub geschrieben.\n");
   return maltext;
}

int drehen(string str)
{
  if(str == "truhe" || str == "truhe um") 
  {
    AddDetail( "truhe", 
      "Eine der Truhen ist umgedreht. Sie ist leer.\n");
    RemoveCmd("drehe");
    clone_object( OBJ "metallkugel")->move(TO, M_NOCHECK);
    write("Als Du die Truhe umdrehst, kullert eine dicke Metallkugel" +
          " darunter hervor.\n");
    say(BS(TP->Name()+ " dreht eine Metalltruhe um. Eine Metallkugel rollt "
       "darunter hervor."));
    return 1;
  }
  return 0;
}

reset()
{
  ::reset();
  AddDetail( "truhe", BS(
    "Eine kleine metallische Truhe in der Ecke liegt umgedreht am Boden. "
    "Durch ihre eisenbeschlagene Messingumwandung unterscheidet sie sich "
    "von den anderen Truhen, die aus Holz gemacht sind. Vielleicht solltest "
    "Du sie umdrehen, um zu sehen, was sich darunter verbirgt?") );
  AddCmd("drehe", "drehen");
}
