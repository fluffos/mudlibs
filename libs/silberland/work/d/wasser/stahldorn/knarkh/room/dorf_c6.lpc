#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

string timediff(int time);
string plakattext(string str);

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Plaza in Knarkh" );
  SetProp( P_INT_LONG, BS( PLAZALANG + 
    "Oestlich von Dir muendet der Hafenweg in die Plaza. Suedlich von Dir "
    "siehst Du eine glatte Ziegelmauer. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

PLAZADETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "mauer", "ziegelmauer" }), BS(
    "Eine blanke Mauer steht suedlich von Dir. An vielen Stellen "
    "broeckelt der Putz schon ab und gibt den Blick auf die Ziegel darunter "
    "frei. Ausserdem wurde ein grosses Plakat an der Mauer festgenagelt.") );
  AddDetail( ({ "hafenweg", "weg" }), 
    "Der Hafenweg fuehrt oestlich von Dir zum Hafen.\n" );
  AddDetail( ({ "plakat" }), BS(
    "Ein etwa ein Quadratmeter grosses Plakat haengt an der Ziegelmauer. "
    "Man sieht darauf ein Bild und daneben etwas Text, den Du lesen "
    "kannst.") );
  AddReadDetail( ({ "plakat", "text" }), #'plakattext);
  AddDetail( ({ "naegel", "nagel" }), 
    "Gewoehnliche Naegel wurden verwendet, um das Plakat an die Mauer zu "
    "nageln.\n" );
  AddDetail( "hafen", 
    "Da muesstest Du schon naeher hingehen. Von hier aus siehst Du noch "
    "nichts.\n" );
  AddDetail( ({ "ziegelsteine", "ziegel" }), BS(
    "Die Ziegelsteine, aus denen die Mauer besteht, schauen unter dem Putz "
    "hervor.") );
  AddDetail( ({ "stelle", "stellen", "putz" }), 
    "Der ehemals weisse Putz ist nun grau und broeckelt an vielen Stellen "
    "ab.\n" );
  AddSpecialDetail( "bild", "plakatbild" );
//  AddDetail( ({ "" }), 
//    "" );

  AddExit( "westen", "./dorf_c5.lpc" );
  AddExit( "norden", "./dorf_d6.lpc" );
  AddExit( "osten", "./dorf_c7.lpc" );
  AddExit( "nordwesten", "./dorf_d5.lpc" );

  AddItem(NPC "powerknarkhist", REFRESH_DESTRUCT, 
           ([P_MNPC_DEFAULTROOM: ROOM "dorf_c6",
             P_MNPC_CMDS: ({ "osten", "osten", "nordosten", "nordosten", "westen", "suedwesten", "nordwesten", "westen", 
                             "norden", "nordosten", "suedwesten", "suedwesten", "osten", "sueden", "sueden", "westen", 
                             "suedwesten", "nordosten", "osten" }) ]) );

}

STDFUNC

string plakattext(string str)
{
  return (
    "         +-----------------+ \n"
    "    ***  |  W A N T E D !! |   ***\n"
    "         +-----------------+ \n\n"+
    break_string("Diese"+(TP->QueryProp(P_GENDER)==MALE?"r Mann":" Frau")+
      " wird wegen Verbrechen gegen das Boese gesucht!\n", 78, "  ")+
    "  Name: ........ "+CAP(getuid(TP))+".\n"
    "  Alter: ....... "+timediff(TP->QueryProp(P_AGE)*2)+".\n"
    "  Rasse: ....... "+TP->QueryProp(P_RACE)+".\n"
    "  Level: ....... "+TP->QueryProp(P_LEVEL)+".\n"
    "  Erfahrung: ... "+TP->QueryProp(P_XP)+" Punkte.\n\n"
    "  Achtung! "+TP->name()+" ist "+ (objectp(TP->QueryProp(P_WEAPON))?
        "bewaffnet!":"zwar unbewaffnet, aber gefaehrlich!")+"\n"
    "  Es wird eine Belohnung von 5000 Muenzen fuer die Ergreifung diese"+
    (TP->QueryProp(P_GENDER)==MALE?"s":"r")+" \n"
    "  Wohltaeter"+(TP->QueryProp(P_GENDER)==MALE?"s":"in")+
    " ausgesetzt! TOT oder MAUSETOT!\n\n"
    "gez.: Dobbodox, Magier.\n");
}

string plakatbild(string str)
{
   return TP->long();
}

string timediff(int time)
{
  string ret;
  
  ret="";
  if(time>=86400) {
    ret+=time/86400+"d ";
    time%=86400;
  }
  if(time<36000) ret+="0";
  ret+=time/3600+":";
  time%=3600;
  if(time<600) ret+="0";
  ret+=time/60+":";
  time%=60;
  if(time<10) ret+="0";
  ret+=time+"";
  return ret;
}
