
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Seitengasse im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Die Seitengasse in die Du Dich gewagt hast, macht hier einen Knick "
    "nach Westen. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "knick" }), BS(
    "Die Gasse kommt von Norden und knickt nach Westen. "
    "") );
  AddDetail( ({ "gasse", "seitengasse" }), BS(
    "Sie fuehrt von Norden nach Westen und macht hier einen Knick.") );


  AddGuardedExit( "norden", ROOM "dorf_h1.lpc", "knarkhist",
	   "Der Knarkhist hindert Dich daran und sagt: STOP, Freundchen!\n" );
  AddExit( "westen", ROOM "dorf_g0.lpc" );

}


STDFUNC
