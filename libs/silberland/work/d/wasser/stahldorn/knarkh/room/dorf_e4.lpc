
#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Im Osten kommst Du auf die Plaza. Nach Suedwesten fuehrt eine "
    "schmutzige Gasse, und nach Nordwesten gehts Richtung Ausgang. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "plaza" }),
    "Sie befindet sich oestlich von Dir.\n");
  AddDetail( ({ "gasse" }),
    "Die Gasse im Suedwesten macht dort nach ein paar Metern einen Knick.\n");
  AddDetail( ({ "knick" }),
    "Weiter als bis dorthin siehst Du nicht.\n");  
  AddDetail( ({ "haus", "haeuser", "huetten", "huette" }), 
    "Die Haeuser hier sind uninteressant.\n");
//  AddDetail( ({ "" }), 
//    "");


  AddExit( "osten", "./dorf_e5.lpc" );
  AddExit( "suedwesten", "./dorf_d3.lpc" );
  AddGuardedExit( "nordwesten", ROOM "dorf_f3.lpc", "knarkhist",
           "Der Knarkhist hindert Dich daran und sagt: STOP, Freundchen!\n" );

  AddItem(NPC "knarkhist", REFRESH_DESTRUCT);
  AddItem(NPC "knarkhist", REFRESH_DESTRUCT);


}

STDFUNC

