#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Plaza in Knarkh" );
  SetProp( P_INT_LONG, BS( PLAZALANG + 
    "Westlich von Dir befindet sich eine aermliche Huette. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

PLAZADETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "huette" }), BS(
    "Die Huette sieht sehr heruntergekommen aus. Das Dach ist teilweise "
    "eingestuerzt, die Fensterscheiben zum Grossteil zerschlagen. ") );
  AddDetail( ({ "fensterscheiben", "scheiben" }), 
    "Die wenigsten von ihnen sind noch ganz.\n" );
  AddDetail( ({ "dach" }), BS(
    "Das strohbedeckte Dach haengt schon bedrohlich schief und scheint "
    "jeden Moment voellig einzustuerzen.") );
  AddDetail( ({ "wand", "waende" }), 
    "Die Waende bestehen aus rohen, unbehandelten Brettern.\n" );
  AddDetail( ({ "tuer", "tuere" }), BS(
    "Die Tuer ist der einzige Teil dieser Huette, der noch einigermassen "
    "stabil ausschaut. Sie ist fest verschlossen.") );
  AddDetail( ({ "bretter" }), 
    "Sie sind schon sehr alt.\n" );
  AddDetail( ({ "stroh" }), 
    "Uraltes Stroh liegt am Dach.\n" );
  AddDetail( ({ "fenster" }), BS(
    "Als Du durch das Fenster schaust, erschrickst Du. Da baumelt doch "
    "tatsaechlich eine Leiche an einem Strick von der Decke.") );
  AddDetail( ({ "leiche" }), BS(
    "Die Leiche baumelt sanft hin und her. Die Augen sind geoeffnet und "
    "starren Dich an. Das ganze aufgedunsene Gesicht macht den Eindruck, "
    "als ob es Dich mit seinen Blicken verfolgen wuerde.") );
  AddDetail( ({ "strick" }), 
    "Jemand hat sich daran erhaengt.\n" );
  AddDetail( ({ "gesicht" }), 
    "Es verfolgt jede Deiner Bewegungen.\n" );
  AddDetail( ({ "augen" }), 
    "Sie sind geoeffnet. \n" );
//  AddDetail( ({ "" }), 
//    "" );
  
  AddExit( "norden", "./dorf_e5.lpc" );
  AddExit( "nordosten", "./dorf_e6.lpc" );
  AddExit( "osten", "./dorf_d6.lpc" );
  AddExit( "suedosten", "./dorf_c6.lpc" );
  AddExit( "sueden", "./dorf_c5.lpc" );

  AddCmd( "oeffne", "oeffnen");
}

STDFUNC

oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (str=="tuer"||str=="tuere")
  {
    write ("Du versuchst vergeblich die Tuere zu oeffnen.\n" +
           "Es geht nicht. Sie ist zugesperrt.\n");
   return 1;
  }
  return 0;
}

