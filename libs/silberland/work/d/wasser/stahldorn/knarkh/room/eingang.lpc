#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eingang von Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Du stehst am Eingang zu einer Art Dorf. "
    "Rechts und links von Dir befinden sich zwei magisch glitzernde Saeulen, "
    "die den Abschluss der Holzpalisade rings um das Dorf bilden "
    "und von denen ein leises, hohes Summen auszugehen scheint. Im Suedosten "
    "kannst Du ein paar Huetten und dahinter sogar so etwas wie ein Haus "
    "erkennen." ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN ]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "dorf", "suedosten" }),
    "Das Dorf selber liegt im Suedosten. Von hier aus kannst Du schon "
    "einige Huetten erkennen.");
  AddDetail( ({ "huetten", "huette", "haus" }),
    "Geh naeher ran, dann siehst Du auch mehr davon.");
  AddDetail( ({ "saeulen", "saeule" }),
    "Sie stehen links und rechts von Dir. Welche interessiert Dich?");
  AddDetail( ({ "linke saeule" }),
    "Die linke Saeule erstrahlt in einem magischen gruenen Licht.");
  AddDetail( ({ "rechte saeule" }),
    "Die rechte Saeule erstrahlt in einem magischen blauen Licht.");
  AddDetail( ({ "licht" }),
    "Es strahlt blau und gruen. Du hast keine Ahnung, was das darstellt.");
  AddDetail( ({ "blaues licht" }),
    "Blau. Von rechts.");
  AddDetail( ({ "gruenes licht" }),
    "Gruen. Von links.");
  AddDetail( ({ "eingang" }),
    "Zaun. Loch. Zwei Saeulen daneben. -> Eingang!\n"
    "(Man kanns aber auch als Ausgang ansehen...)\n");
  AddDetail( ({ "ausgang" }),
    "Zaun. Loch. Zwei Saeulen daneben. -> Ausgang!\n"
    "(Man kanns aber auch als Eingang ansehen...)\n");
  AddDetail( ({ "zaun", "loch", "abschluss" }),
    "Die Palisade hat hier ein Loch, damit man sie passieren kann.");
  AddDetail( ({ "holz", "holzpalisade", "palisade" }),
    "Ein starker und dicker Palisadenzaun umgibt Knarkh.");

//  AddDetail( ({ "" }),
//    "");
  AddSound( ({ "summen" }),
    "Es kommt von den beiden Saeulen. Klingt bedrohlich.");

  AddExit( "suedosten", "./dorf_h1" );
  AddGuardedExit( "nordwesten", WEG "weg12", "knarkhist",
           "Der Knarkhist hindert Dich daran und sagt: STOP, Freundchen!\n" );

  AddItem( NPC "knarkhist.lpc", REFRESH_DESTRUCT);
  AddItem( NPC "knarkhist.lpc", REFRESH_DESTRUCT);

  AddCmd( ({ "beruehre", "beruehr" }), "beruehren");
}

beruehren(string str )
{
  notify_fail( "Was willst Du beruehren?\n" );
  if( member(explode(str, " "), "saeule") > -1 )
  {
    write("Ein Stromimpuls jagt durch Deine Hand und betaeubt Dich kurz.\n");
    say( PLN+" wird von einem Stromstoss geschockt.\n");
    SetProp(P_KILL_NAME, "Ein fuerchterlicher Stromstoss");
    TP->do_damage(10 + random (50), TP);
    return 1;
  }
  return 0;
}

init()
{
  ::init();
  
  call_out("levelcheck", 0);
}

levelcheck()
{
  string pr;

  if (TP && TP->QueryProp(P_GHOST))
  {
    tell_object(TP, "\nDu bist ja ein Geist! Komm, geh erstmal beten!\n\n");
   TP->move(stringp(pr=(TP->QueryPrayRoom()))?pr:"/d/ebene/Midas/room/kapelle",
          M_TPORT, "aus Knarkh", "verschwindet", "wird hereingebeten");
    return;
  }

  if (TP && (TP->QueryProp(P_LEVEL) < 15) && (ENV(TP)!="/room/death/death_room"))
  {
    tell_object(TP, BS(
        "Als Du den Eingangsbereich des Dorfes Knarkh betrittst, erstarrst "
        "Du vor Schreck. Ein bestialischer Gestank beisst Dir in die Nase "
        "und die Luft ist erfuellt von den unheimlichen Schreien gepeinigter "
        "Opfer. Du beschliesst, lieber das Wagnis noch nicht einzugehen, "
        "Knarkh zu betreten, und kehrst leise wieder um. "
        "Vielleicht bist Du stark genug, wenn Du Level 15 erreicht hast.") );
    TP->move(WEG "weg12", M_NO_SHOW|M_TPORT, "aus Knarkh",
             "fluechtet entsetzt", "rennt hysterisch schreiend herein");
  }

}
