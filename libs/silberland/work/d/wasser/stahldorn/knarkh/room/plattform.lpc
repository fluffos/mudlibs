#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Plattform" );
  SetProp( P_INT_LONG, BS(
    "Du stehst auf einer wirklich schmalen Plattform vor der Pfahlhuette. "
    "Vor Dir ist ein kleines Loch, das in die Huette fuehrt. "
    "Es ist so schmal hier, dass Du Dich kaum ruehren kannst. "
    "Nach Nordosten fuehrt ein Tau zum Tempel." ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_KILL_NAME, "Absturz");

  AddDetail( ({ "boden" }), BS(
    "Den Boden bildet eine schmale Holzleiste, die den Namen Plattform "
    "eigentlich gar nicht verdient.") );
  AddDetail( ({ "plattform", "holzleiste", "leiste" }), BS(
    "Sie ist wirklich sehr schmal. Es ist besser, Du kletterst entweder "
    "in die Huette hinein, oder hangelst Dich am Tau nach Nordosten, oder "
    "Du springst in die Tiefe.") );
  AddDetail( ({ "tiefe", "abgrund" }), 
    "Du traust Dich nicht, hinunterzuschauen.\n" );
  AddDetail( ({ "himmel", "sonne" }), 
    "Am Himmel scheint die Sonne.\n" );
  AddDetail( ({ "wand", "latten", "holzlatten" }), BS(
    "Die Wand besteht aus lackierten Holzlatten, die mit stabilen "
    "Eisenstreben verstaerkt wurden. Als Du genauer hinsiehst bemerkst Du "
    "einen Hebel neben dem Loch.") );
  AddDetail( ({ "eisenstreben", "streben" }), BS(
    "Eiserne, in die Wand der Huette eingebaute Streben dienen dazu, "
    "das was da drin haust, nicht rauszulassen.\n") );
  AddDetail( ({ "huette", "pfahlhuette" }), BS(
    "Du befindest Dich vor ihr. Sie besteht hauptsaechlich aus Holzlatten. "
    "Das Dach ist mit Stroh gedeckt. Aus dem Inneren der Huette dringen " 
    "angsteinfloessende Geraeusche."));
  AddDetail( ({ "loch", "eingang" }), 
    "Du glaubst, zu erkennen, wie sich da drin was bewegt...\n" );
  AddSound( ({ DEFAULT_SOUND, "geraeusche" }), BS(
    "Du hoerst abwechselnd ein Schaben, ein Knarren, ein Schnaufen und ein "
    "leises Bruellen.") );
  AddSound( ({ "schaben" }), 
    "*SCHAB* *SCHLURF*\n" );
  AddSound( ({ "knarr", "knarren" }), 
    "*KNARR* *KNIRSCH*\n" );
  AddSound( ({ "schnaufen" }), 
    "*SCHNAUF* *BLAS*\n" );
  AddSound( ({ "bruellen" }), 
    "*BRUELL* *KNURR*\n" );
  AddDetail( ({ "tempel", "nordosten" }), 
    "Der Tempel ist schon ziemlich weit weg. Du erkennst keine Einzelheiten.\n" );
  AddDetail( ({ "tau" }), 
    "Es fuehrt nach Nordosten zum Tempel.\n" );
  AddDetail( ({ "hebel" }), 
    "Ein normaler Hebel. Man kann daran ziehen.\n" );
  AddDetail( ({ "dach" }), 
    "Das Dach der Huette ist mit Stroh gedeckt.\n" );
  AddDetail( ({ "stroh" }), 
    "Man hat es benutzt, um das Dach der Huette damit zu decken.\n" );
//  AddDetail( ({ "" }), 
//    "" );

  AddCmd( ({ "hangle", "hangel" }), "hangeln");
  AddCmd( ({ "druecke", "ziehe", "drueck", "zieh" }), "hebeln");
  AddCmd( ({ "klettere", "kletter" }), "klettern");
  AddCmd( ({ "spring", "springe" }), "springen");
}

int hangeln(string str)
{
  if(member(({"nach nordosten", "nach no", "no", "nordosten"}), str) > -1)
  {
    write("Du hangelst Dich am Tau nach Nordosten.\n");
    TP->move(ROOM "balance", M_GO, 
       "nach Nordosten", "hangelt", "kommt hereingehangelt");
    return 1;
  }

  notify_fail("Wohin willst Du Dich hangeln?\n");
  return 0;
}


int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str != "in loch" && str != "durch loch") return 0;

  write( BS(
    "Du versuchst, durch das Loch zu klettern, musst aber feststellen, "
    "dass Du nicht durchpasst. Vielleicht ist das auch besser so, denn "
    "das Wesen da drin klingt nicht gerade freundlich."));
  say(TP->Name()+" versucht vergeblich durch das Loch zu klettern.\n");
  return 1;
}

int hebeln(string str)
{
   int i;
   object *ob;

   notify_fail("Was willst Du druecken oder ziehen?\n");
   if (str != "hebel") return 0;

   write(
     "Du ziehst fest am Hebel. Du hoerst etwas scheppern.\n"
     "Der Hebel schnellt wieder nach oben.\n");
   call_other(ROOM "pfahlhaus", "???", 0);
   call_other(ROOM "dorf_g2", "???", 0);
   if(sizeof(ob = all_inventory(find_object(ROOM "pfahlhaus"))))
   {
     write("Du hoerst, wie etwas weit unter Dir aufschlaegt.\n");
     for (i = 0; i < sizeof(ob); i++)
     {
       tell_object(ob[i], "Die Klappe zu Deinen Fuessen oeffnet sich.\n" +
          "Du faellst nach unten.\n");
       ob[i]->move(ROOM "dorf_g2", M_NOCHECK | M_SILENT);
       tell_room(ROOM "dorf_g2", ob[i]->Name()+" faellt auf den Boden.\n");
       if(living(ob[i])) ob[i]->do_damage(10 + random(30));
     }
   }
   return 1;
}

int springen(string str)
{
  if(!str || member( ({"runter", "nach unten"}), str) > -1)
  {
    write("Du springst todesmutig in die Tiefe.\n");
    TP->move(ROOM "dorf_g2", M_GO, "in die Tiefe", "springt", 
      "kracht am Boden auf");
    write("Aua! Das hat weh getan.\n");
    TP->do_damage(10 + random(30));
    return 1;
  }
  return 0;
}


