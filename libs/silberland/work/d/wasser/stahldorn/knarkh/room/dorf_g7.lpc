#include "../def.h"
#include "./knarkh.h"

inherit "std/pub";

#include <properties.h>
#include <language.h>
#include "/gilden/bardengilde/barden_extern.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Goldener Bauchstich" );
  SetProp( P_INT_LONG, BS( 
    "Du befindest Dich im Goldenen Bauchstich, der verrufensten Kneipe "
    "im ganzen Silberland. Ueberall lungern schraege und gefaehrliche Typen "
    "herum, die anscheinend nur darauf warten, Dir Dein Geld abzunehmen "
    "und Dich in die Gosse zu werfen. In einer der hinteren Ecken "
    "tobt gerade eine wueste Schlaegerei, die aber den Wirt hinter der Theke "
    "nicht zu kuemmern scheint. Es ist sehr stickig und heiss hier drin. " 
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_HOUSE]) );

  AddSmell( DEFAULT_SMELL, BS(
    "Es stinkt nach Tabakqualm, Alkohol, Urin und Erbrochenem.") );
  AddSmell( ({ "alkohol" }), BS(
    "Wahrscheinlich nichts als Fusel, was hier ausgeschenkt wird.") );
  AddSmell( ({ "tabakqualm", "qualm", "tabak" }), BS(
    "*hust* *roechel* *hust*") );
  AddSmell( ({ "urin" }), BS(
    "Ein widerlich beissender Gestank.") );
  AddSmell( ({ "erbrochenes", "fleck" }), BS(
    "Der Fleck am Boden vor Dir strahlt diesen Duft aus.") );


  AddSound( DEFAULT_SOUND, BS(
    "Zwischen das allgemeine Gemurmel mischen sich immer wieder "
    "Schmerzensschreie und die Geraeusche von knackenden Knochen.") );
  AddSound( ({ "schreie", "schmerzensschreie" }), BS(
    "Die Schreie stoesst der Gaffo aus, der gerade von einem starken "
    "Ork verpruegelt wird.") );
  AddSound( ({ "gemurmel" }), BS(
    "rhabarberrhabarbersiehstdudentypdortanderthekerhabarberrhabarberrhabarber"
    "rhabarberfluesterrhabarberrhabarberrhabarberichhauihmeineaufdieruebe"
    "rhabarberrhabarberrhabarmurmelmurmelberrhabarberrhabarberrhabarber"
    "okundichnehmihmdasgeldabrhabarberrhabarberrhabarberrhabarberrhabarber"
    "gutgenausomachenwirsrhabarbermurmel") );
  AddSound( ({ "knochen" }), BS(
    "*knacks* *krach*") );


  AddDetail( ({ "fleck" }), BS(
    "Hier hat sich wohl jemand uebergeben muessen. *wuerg*") );
  AddDetail( ({ "boden" }), BS(
    "Ueberall liegen Glasscherben herum. Und er ist dreckig. Direkt vor Dir "
    "hat zum Beispiel jemand vor nicht allzu langer Zeit einen "
    "riesengrossen Fleck hinterlassen, der uebel stinkt.") );
  AddDetail( ({ "scherben", "glasscherben" }), BS(
    "Die Scherben stammen wahrscheinlich von zerschmetterten Bierkruegen.") );
  AddDetail( ({ "waende", "wand" }), BS(
    "An den Waenden haengen schmuddelige Pin-Up Bilder vor dem Hintergrund "
    "einer speckigen, braunen Tapete.") );
  AddDetail( ({ "tapete" }), BS(
    "Jetzt ist sie braun. Frueher duefte sie einmal hellblau gewesen sein.") );
  AddDetail( ({ "bilder", "pin-ups", "pin-up", "bild" }), BS(
    "Ork- und Gaffoschoenheiten mit unrealistisch grossen Bruesten sieht man "
    "darauf.") );
  AddDetail( ({ "decke" }), BS(
    "An der Decke haengt ein Kronleuchter mit Kerzen dran. Die meisten Kerzen "
    "sind aber verloschen oder fehlen ueberhaupt.") );
  AddDetail( ({ "kronleuchter", "kerzen", "kerze" }), BS(
    "Der Kronleuchter mit seinen Kerzen spendet nur schummriges Licht.") );
  AddDetail( ({ "licht" }), BS(
    "Als Leselicht aeusserst unzureichend.") );
  AddDetail( ({ "kneipe", "bauchstich" }), BS(
    "Du befindest Dich im Goldenen Bauchstich, der verrufensten Kneipe "
    "im ganzen Silberland. Ueberall lungern schraege und gefaehrliche Typen "
    "herum, die anscheinend nur darauf warten, Dir Dein Geld abzunehmen "
    "und Dich in die Gosse zu werfen. In einer der hinteren Ecken "
    "tobt gerade eine wueste Schlaegerei, die aber den Wirt hinter der Theke "
    "nicht zu kuemmern scheint. Es ist sehr stickig und heiss hier drin. ") );
  AddDetail( ({ "typen", "gesindel", "typ" }), BS(
    "Das uebliche Gesindel aus Knarkh. Nur noch mehr und noch dichter "
    "gedraengt als auf der Strasse.") );
  AddDetail( ({ "schlaegerei", "ecke" }), BS(
    "Die Schlaegerei in der Ecke duerfte dem Ende zugehen, denn der eine "
    "Teilnehmer ruehrt sich kaum noch.") );
  AddDetail( ({ "teilnehmer" }), BS(
    "Die Schlaegerei findet in eher kleinem Rahmen statt. Ein grosser "
    "bulliger Ork kniet auf einem eher schwachen Gaffo und bearbeitet "
    "ihn auf brutale Weise. Die beiden "
    "Kontrahenten werden von einer kleinen, gelangweilten Zuschauermenge "
    "umringt.") );
  AddDetail( ({ "ork", "gaffo", "zuschauer", "zuschauermenge" }), BS(
    "Lass sie lieber in Frieden sich gegenseitig umbringen, bevor sie Dich "
    "als Opfer auserwaehlen.") );
  AddDetail( ({ "wirt" }), BS(
    "Der Wirt hinter der Theke schaut Dich abschaetzig an und trommelt "
    "mit den Fingern auf der Theke. Er erwartet wohl, dass Du etwas "
    "bestellst.") );
  AddDetail( ({ "theke" }), BS(
    "Eine normale Theke mit Bierkruegen und Schnapsflaschen drauf.") );  
  AddDetail( ({ "bierkruege", "schnapsflaschen", "flaschen", "kruege" }), BS(
    "Alle leer. Pech gehabt. Du kannst aber was neues bestellen.") );



  AddDrink("Knarkhbier", ({"bier", "knarkhbier"}),
           200, 20, 1, 3,
           ({
             "Du bekommst einen Bierkrug voller eiskaltem Knarkhbier. "+
             "Gierig greifst Du danach und schuettest alles auf einmal in "
	     "Deine Kehle. DAS loescht wirklich den Durst!",
             "&& trinkt einen Becher Knarkhbier."}));

  AddDrink("Fusel", ({"fusel"}),
           500, 70, 9, 4,
           ({
             "Der Wirt stellt Dir einen Becher mit Fusel hin. "+
             "Mutig wie Du bist schluerfst Du ihn in einem Zug aus.",
             "&& wuergt einen Becher Fusel hinunter."}));

  AddDrink("Schmecks' Bitter Daemon", ({"schmecks", "daemon"}),
            300, 30, 0, 5, 
           ({"Der Wirt bringt Dir ein 0.25 Liter Glas mit Bitter Daemon drin. "
             "Du trinkst das Zeug ohne eine Miene zu verziehen aus und bist "
             "stolz auf Dich. Alle gratulieren Dir und Du fuehlst Dich "
             "ziemlich erfrischt.",
             "&& nimmt Schluck Bitter Daemon und verzieht das Gesicht, als "
             "ob &1 Galle im Mund haette. Buah, sieht das eklig aus. "
             "Hoffentlich kotzt &1 nicht auf den Boden... Na also. "
             "Schliesslich hat && ausgetrunken und stellt das Glas weg."}));

  AddDrink("Gift", ({"gift"}),
           800, 30, 0, 2, "giftdrink");

  AddFood("Eine knackige Knarkhwurst", ({"knarkhwurst", "wurst"}),
           250, 25, 18, "wurst_essen");

  AddItem(NPC "schlaegertyp", REFRESH_DESTRUCT);
  AddItem(NPC "schlaegertyp", REFRESH_DESTRUCT);
  AddItem(NPC "schlaegertyp", REFRESH_DESTRUCT);

  AddExit( "suedwesten", "./dorf_f6.lpc" );



}

public void wurst_essen() {
  object task;

  write(BS("Der Wirt bringt Dir eine Knarkhwurst mit viel Senf und Ketchup. "+
           "Irgendwie schmeckt die Wurst nach Ratte, aber sie stillt "
           "wenigstens den aergsten Hunger."));
  say(BS(TPN+"  frisst eine Knarkhwurst."));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(9);
  }
}

STDFUNC


giftdrink(object zahler, object empfaenger)
{
  tell_object(empfaenger, BS(
    "Der Wirt schuettelt veraechtlich den Kopf und hinter Dir lacht jemand. "
    "Das Glas, das Dir vorgesetzt wird, ist mit einer gruenen Fluessigkeit "
    "gefuellt, die gefaehrlich dampft und brodelt.\n"
    "Da Dich die Leute rundherum aber schon so komisch anstarren, trinkst "
    "Du doch nach kurzem Zoegern alles aus.") );
  say( BS(
    empfaenger->name() + " schaut ziemlich dumm aus, als er ein Glas "
      "reines Gift vorgesetzt bekommt. Alle Leute lachen, als " +
      empfaenger->name()+" das Gift sogar trinkt."), empfaenger );
  if(empfaenger->QueryProp(P_POISON) <  empfaenger->QueryProp(P_MAX_POISON) -2)
    empfaenger->SetProp(P_POISON, empfaenger->QueryProp(P_POISON) + 3);
  else empfaenger->SetProp(P_POISON, empfaenger->QueryProp(P_MAX_POISON));
}


spendiere (str)
{
  if (sizeof(explode(str, " ")) > 1)
  {
    if (explode(str, " ")[1]=="gift")
    {
      notify_fail("Nein! Du wirst doch niemanden vergiften wollen?\n");
      return 0;
    }
  }
  return::spendiere(str);
}




