#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem grossen Kaefig" );
  SetProp( P_INT_LONG, BS( 
    "Du stehst in einem grossen Kaefig. Dass es ein Kaefig ist, sieht man "
    "an den vielen eisernen Gitterstaeben rundherum. Der Boden unter "
    "Deinen Fuessen sieht fuerchterlich aus. Du stehst quasi in einer "
    "riesigen Pfuetze aus Blut. Die Klauenbestie, die hier gefangen"
    "gehalten wird, hat in letzter Zeit wohl schrecklich gewuetet..." ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "boden", "anblick", "schicht" }), BS(
    "Der Boden ist mit einer grauenhaften Schicht aus Blut, Leichenteilen "
    "und Knochen bedeckt. Dich schaudert vor Entsetzen bei diesem unappetit"
    "lichen Anblick.") );
  AddDetail( ({ "himmel", "sonne" }), 
    "Die Sonne am Himmel laechelt auf dieses entsetzliche Szenario herab.\n" );
  AddDetail( ({ "szenario" }), 
    "Einfach schauderhaft. Graesslich. Wie aus einem Horrorfilm.\n" );
  AddDetail( ({ "blut" }), BS(
    "Blut aller Rottoenungen. Knoecheltief stehst Du darin. Man kann fast "
    "sagen, dass es sich um einen Blutsee handelt, der an den Raendern "
    "geronnen ist. Der Gestank ist fast nicht auszuhalten.") );
  AddDetail( ({ "leichen", "leichenteile" }), BS(
    "Teile von Leichen in allen Verwesunsstadien. Die Klauenbestie "
    "muss richtig gemaestet worden sein, dass sie so viel 'Futter' "
    "uebriggelassen hat.") );
  AddDetail( ({ "knochen" }), BS(
    "Elfenknochen, Menschenknochen, Zwergenknochen, Hobbitknochen, "
    "Orkknochen, Goblinknochen, Pferdeknochen, Kuhknochen, Schweineknochen, "
    "Hundeknochen... Knochen! Dich ekelt vor ihnen.") );
  AddDetail( ({ "see", "blutsee", "pfuetze" }), 
    "Du stehst bis zu den Knoecheln in Blut.\n" );
  AddDetail( ({ "raender" }), 
    "Die Raender der Blutpfuetze bestehen aus Klumpen geronnenen Blutes.\n"
);
  AddDetail( ({ "klumpen" }), 
    "Pfui! Igitt! *wuerg*\n" );
  AddDetail( ({ "kaefig" }), 
    "Der Kaefig besteht aus extradicken, superharten Eisenstaeben.\n" );
  AddDetail( ({ "staebe", "gitterstaebe", "eisenstaebe" }), BS( 
    "Die Staebe sind sehr sehr stabil. An ihren oberen Enden, also in etwa "
    "zwei Metern Hoehe, sind sie zugespitzt. Da die Klauenbestie zu "
    "hundert Prozent ein Wesen der Erde ist, kann sie unmoeglich von "
    "hier ausbrechen. Du allerdings koenntest mit etwas Geschick raus" 
    "springen. Wenn die Bestie Dich nicht vorher toetet."));
  AddDetail( ({ "bestie", "klauenbestie" }), 
    "Die Klauenbestie ist gerade nicht da. Glueck gehabt.\n" );
  AddSmell( ({ "gestank", "verwesung", "tod", DEFAULT_SMELL }), 
    "Es stinkt nach Verwesung und Tod. Der Gestank zieht sich durch ganz "
    "Knarkh.\n" );
  AddSmell( ({ "blut" }), 
    "Der Geruch des verwesenden Blutes dreht Dir den Magen um.\n" );
  AddSmell( ({ "knochen" }), 
    "Die Knochen stinken bestialisch.\n" );
  AddSmell( ({ "leichen", "leichenteile" }), 
    "Du musst Dich gleich uebergeben.\n" );

//  AddDetail( ({ "" }), 
//    "" );
                      
  AddCmd( ({ "spring", "springe" }), "raus_exit" );

  AddItem(NPC "k_bestie", REFRESH_DESTRUCT);
}

raus_exit(string str)
{
  string wohin;
  int rand;
  
  notify_fail("Wohin willst Du springen?\n");
  if (str != "raus" && str != "aus kaefig") return 0;

  rand = TP->QueryAttribute(A_STR);
  rand = random(5 + ((rand > 20)?0:(20-rand)));
  switch(rand)
  {
    case 0: wohin = "dorf_f8"; break;
    case 1: wohin = "dorf_d8"; break;
    case 2: wohin = "dorf_e7"; break;
    case 3: wohin = "dorf_e9"; break;
    default: wohin = "dorf_e8";
  }
  if(wohin == "dorf_e8")
  {
    write(BS(
      "Du versuchst, aus dem Kaefig zu springen, aber Du springst nicht "
      "hoch genug und faellst wieder zurueck."));
    say(TP->Name()+" versucht verzweifelt, aus dem Kaefig zu springen.\n");
  }
  else
  {
    write("Dank Deiner Kraft schaffst Du es, aus dem Kaefig zu springen.\n");
    TP->move(ROOM + wohin, M_GO, "raus", "springt", "springt herein");
  }
  return 1;
}


