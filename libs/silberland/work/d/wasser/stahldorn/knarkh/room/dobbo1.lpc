#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int fackel;

create()
{
  ::create();

  fackel = 1;

  SetProp( P_INT_SHORT, "Im Dobbokeller" );
  SetProp( P_INT_LONG, BS(
    "Du stehst in einem Kellergewoelbe. Eine enge Wendeltreppe fuehrt "
    "nach oben, von wo ein wenig daemmriges Licht in den Keller dringt. "
    "Im Nordwesten und Nordosten sind zwei Raeume, und ein dunkler " 
    "Kellergang fuehrt nach Norden.")  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "treppe", "wendeltreppe" }), 
    "Die Wendeltreppe besteht aus Stein.\n" );
  AddDetail( ({ "licht" }), 
    "Ein wenig Licht dringt von oben in den Keller herab.\n" );
  AddDetail( ({ "keller" }), BS(
    "Du stehst darin. Die Waende und die Decke bestehen aus Stein. Eine "
    "Treppe fuehrt nach oben und ein Gang nach norden.") );
  AddDetail( ({ "gang", "kellergang" }), 
    "Im Norden verschwindet ein unheimlicher Gang in absoluter Finsternis." );
  AddDetail( ({ "gewoelbe", "kellergewoelbe", "decke" }), BS(
    "Die Decke woelbt sich dumpf und gewaltig in etwa vier Metern Hoehe "
    "ueber Dir. Es duerfte aus maechtigem Felsgestein gehauen worden sein "
    "und macht einen uralten, verwitterten Eindruck, was verwunderlich ist, "
    "wenn man bedenkt, dass vor der Gruendung von Knarkh vor ein paar "
    "Jahren sich hier noch absolute Wildnis befunden haben soll.") );
  AddDetail( ({ "boden" }), BS(
    "Der Boden besteht aus kaltem Stein. Entlang der Waende hat sich Staub "
    "angesammelt.") );
  AddDetail( ({ "waende", "wand" }), 
    "Die Waende bestehen aus Stein und sind voellig kahl.\n" );
  AddDetail( ({ "raeume" }), 
    "Sie sind zwar beleuchtet, aber von hier aus siehst Du zu wenig.\n" );
  AddDetail( ({ "stein", "felsgestein", "fels", "gestein" }), 
    "Gewoehnliches Felsgestein. Kalt und hart.\n" );
  AddDetail( ({ "staub" }), BS(
    "Der Staub hat sich vor allem entlang der Waende angesammelt, in der "
    "Raummitte und an den Ausgaengen befindet sich weniger davon, was "
    "darauf schliessen laesst, dass der Keller oefter begangen wird. Im "
    "Norden, da wo die Dunkelheit eines Ganges beginnt, liegt der Staub fast "
    "knoecheltief.") );
  AddDetail( ({ "finsternis" }), BS(
    "Da siehst Du nichts, denn in der Finsternis herrscht schliesslich "
    "voellige Dunkelheit!") );
  AddDetail( ({ "dunkelheit" }), BS( 
    "Du strengst Dich an und kneifst die Augen abwechselnd zusammen, "
    "doch Du erkennst absolut nichts. Ein altes Sprichwort kommt ploetzlich "
    "in Deinen Sinn. Es heisst:") + 
    "  In der Dunkelheit,\n"+
    "  Do siacht ma ned so weit, \n"+
    "  Ois wie beim Tagesliacht,\n"+
    "  Wo ma vue weida siacht!\nWeise Worte, fuerwahr.\n");
  AddSound( ({ DEFAULT_SOUND }), 
    "Aus der Dunkelheit im Norden dringt ein tiefes Pochen.\n" );
  AddSound( ({ "pochen" }), 
   "Ein pochendes Pochen dringt vom Norden her an Dein Ohr. *POCH* *POCH*\n");
  AddSmell( ({ DEFAULT_SMELL }), 
    "Es riecht recht muffig hier unten.\n" );
  AddDetail( ({ "schloss", "tuerschloss" }), 
    "Das Tuerschloss ist winzigklein. Man braucht sicher einen "
    "Mini-Schluessel dafuer." );
  
//  AddDetail( ({ "" }), 
//    "" );

  AddExit("oben", ROOM "dorf_f10");
  AddExit("nordwesten", ROOM "labor");
  AddExit("norden", ROOM "gang1");
//  AddExit("nordosten", ROOM "uebraum");
  NewDoor("nordosten", ROOM "dorf_g3", ({"tuer", "hintertuer", "holztuer"}), 
     ({D_FLAGS, DOOR_NEEDKEY, 
       D_NAME, "Tuer",
       D_GENDER, FEMALE, 
       D_SHORT, "Eine %se Tuer.",
       D_LONG, BS(
         "Eine Tuer mit Tuerschloss.\n"),
       D_KEYTESTFUNC, "nix" }));


  AddCmd( ({ "durchwuehle", "wuehle", "wuehl", "grabe" }), "staub");
}

int nix() {return 0;}

int staub(string str)
{
   notify_fail("Worin willst Du wuehlen?\n");
   if(str != "in staub" && str != "staub") return 0;
   if(fackel)
   {
     fackel = 0;
     write("Du durchwuehlst den Staub und legst eine Fackel frei.\n");
     say(TP->Name()+" wuehlt im Staub herum und legt eine Fackel frei.\n");
     clone_object("/obj/fackel")->move(TO, M_NOCHECK);
   }
   else
   {
     write("Du durchwuehlst den Staub, findest aber nichts.\n");
     say(TP->Name()+" wuehlt ein wenig im Staub herum.\n");
   }
   return 1;
}

reset()
{
   fackel = 1;
   ::reset();
}
