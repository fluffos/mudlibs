#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
     "Die Strasse fuehrt hier um einen Kaefig herum. "
     "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "strasse", "weg" }), BS(
    "Die Strasse ist hier sehr breit. Sie fuehrt um einen Kaefig herum, "
    "der sich noerdlich von Dir befindet.") );
  AddSpecialDetail( ({ "kaefig", "bestie" }), "kaefigdetail" );
  AddDetail( ({ "gitterstaebe", "staebe" }), 
    "Armdick und aus Metall. Garantiert unkaputtbar.\n" );
  AddDetail( ({ "leiter", "metalleiter" }), BS(
    "Eine Metalleiter wurde aussen am Kaefig angebracht. Man kann damit bequem "
    "hineinklettern. Allerdings stellt sich die Frage, wie man wieder "
    "rauskommt.") );
//  AddDetail( ({ "" }), 
//    "" );
  
  AddExit( "nordosten", ROOM "dorf_e9.lpc" );
  AddExit( "nordwesten", ROOM "dorf_e7.lpc" );
  
  AddCmd( ({ "kletter", "klettere" }), "klettern");

}

STDFUNC

string kaefigdetail()
{
   string ret;

   ret = "Der Kaefig besteht aus hunderten dicken Gitterstaeben, welche "+
         "man kreisfoermig angeordnet hat. Er ist etwa zweieinhalb Meter "
         "hoch. An dieser Stelle wurde aussen eine Leiter angebracht, durch " 
         "die man bequem ins Innere des Kaefigs klettern kann. ";
   call_other(ROOM "dorf_e8", "???", 0);
   if (present("klauenbestie", find_object(ROOM "dorf_e8")))
     ret += "Eine schreckliche Bestie geht da drinnen auf und ab. Ihr "+
            "Kopf schaut teilweise ueber den Rand des Kaefigs...";
   else
     ret += "Das Tier, das sonst da drinnen haust, scheint gerade "+
            "nicht da zu sein.";
   return BS(ret);
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str != "rein" && str !="in kaefig" && str !="ueber kaefig" &&
     str !="leiter" && str !="auf leiter" && str !="hinein")  return 0;
  TP->move(ROOM "dorf_e8", M_GO, "in den Kaefig", "klettert", 
     "klettert herein");
  return 1;
}


