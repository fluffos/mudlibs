#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Sackgasse im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Die Gasse geht im Westen und im Suedosten weiter. Im Osten befindet sich "
    "eine kahle Mauer. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "wand", "hauswand", "mauer" }), BS(
    "Die Mauer vor Dir ist eigentlich total kahl. "
    "Nichts interessantes zu sehen." ) );
  AddDetail( ({ "tuer", "tuere" }), 
    "Die Tueren hier sind alle verschlossen. Nix zu machen.\n" );
  AddDetail( ({ "haus", "haeuser" }),
    "Um Dich herum sind Haeuser. Eingang siehst Du keinen.\n" );
  AddDetail( ({ "gasse" }),
    "Die Gasse fuehrt in Richtung Suedosten weiter.\n" );
  AddDetail( ({ "eingang", "eingaenge" }),
    "Du siehst keine Eingaenge.\n" );


  AddExit( "westen", ROOM "dorf_f0.lpc" );
  AddExit( "suedosten", ROOM "dorf_e2");

  AddItem(NPC "eliteknarkhist", REFRESH_DESTRUCT,
           ([P_MNPC_DEFAULTROOM: ROOM "dorf_f1",
             P_MNPC_CMDS: ({ "suedosten", "suedosten", "nordosten", "osten", "suedosten", "suedwesten", "suedwesten",   
                             "nordosten", "osten", "osten", "sueden", "sueden", "norden", "norden", "osten", "nordosten", 
                             "nordosten", "norden", "sueden", "westen", "nordwesten", "suedwesten", "westen", "suedwesten", 
                             "sueden", "suedwesten", "nordosten", "nordosten", "nordwesten", "westen", "nordwesten", "nordwesten", 
                             "nordwesten", "nordwesten", "suedosten", "sueden", "westen", "sueden", "osten" }) ]) );

}


STDFUNC
