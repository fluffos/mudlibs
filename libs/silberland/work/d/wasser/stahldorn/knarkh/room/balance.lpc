#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tau haengend" );
  SetProp( P_INT_LONG, BS(
    "Du haengst an einem dicken Tau ungefaehr 15 Meter ueber dem Abgrund. "
    "Unter Dir befindet sich eine oede Gasse in Knarkh. Im Nordosten "
    "siehst Du den dunklen Tempel aufragen und im Suedwesten trennen Dich "
    "nur noch ein paar Meter von einer Pfahlhuette. Beeil Dich lieber, "
    "denn lange wirst Du Dich nicht halten koennen." ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_OTHER]) );
  SetProp(P_KILL_NAME, "Absturz");

  AddDetail( ({ "tau" }), 
    "Du haeltst Dich daran fest. Wenn Du loslaesst, stuerzt Du ab.\n" );
  AddDetail( ({ "boden", "abgrund", "tiefe" }), 
    "Du traust Dich gar nicht richtig, hinunterzuschauen.\n" );
  AddDetail( ({ "gasse" }), 
    "Sie befindet sich unter Dir, aber Du willst lieber nicht hinschauen.\n");
  AddDetail( ({ "nordosten", "tempel" }), BS(
    "Der Tempel ragt unheilverkuendend auf. Du kannst nur mit muehe das "
    "kleine Fenster erkennen, durch das Du vorhin herausgeklettert bist.") );
  AddDetail( ({ "suedwesten", "pfahlhuette", "huette" }), BS(
    "Jetzt, wo Du schon so nah bist, bemerkst Du, dass die Huette eher "
    "deshalb auf Pfaehlen gebaut wurde, um das, was drin ist, drin zu "
    "halten, anstatt andere davon abzuhalten, die Huette zu betreten. "
    "Sie ist ausserordentlich stabil gebaut. Die Holzlatten sind mehrere "
    "Schichten dick und durch Eisenstreben verstaerkt. Der sichtbare "
    "Eingang zu der Huette, eine kleine Plattform am Huettenrand, ist gerade "
    "so gross, dass man dort stehen kann. Dahinter gaehnt ein kleines Loch, "
    "durch das man in die Huette hineinklettern kann.") );
  AddDetail( ({ "knarkh", "dorf", "stadt" }), BS(
    "Du hast von hier aus einen guten Ueberblick ueber die Stadt. Leider "
    "erinnert Dich die Aussicht aber auch daran, wie weit oben Du gerade "
    "haengst und Dir wird schwindlig.") );
  AddDetail( ({ "loch", "eingang" }), 
    "Du glaubst, erkennen zu koennen, dass sich dahinter etwas bewegt.\n" );
  AddDetail( ({ "fenster" }), 
    "Das Fenster des Tempels ist schon ziemlich weit weg.\n" );
  AddDetail( ({ "holzlatten", "latten", "streben", "eisenstreben" }), 
    "Sie dienen dazu, etwas in der Huette einzusperren.\n" );
  AddDetail( ({ "pfaehle" }), 
    "Die Huette steht auf dicken Holzpfaehlen." );
  AddDetail( ({ "plattform", "huettenrand", "holzplatte" }), BS(
    "Eine wirklich sehr schmale Holzplatte, gerade gross genug, dass man "
    "darauf aufrecht stehen kann.") );
  AddDetail( ({ "himmel", "sonne" }), 
    "Die Sonne scheint vom Himmel.\n" );
//  AddDetail( ({ "" }), 
//    "" );

  AddCmd( ({ "hangle", "hangel" }), "hangeln");
  AddCmd( ({"lass", "lasse"}), "loslassen");
  AddCmd( ({"ende", "quit"}), "ende");
}

int hangeln(string str)
{
  if(member(({"nach suedwesten", "nach sw", "sw", "suedwesten"}), str) > -1)
  {
    write(BS("Du hangelst Dich am Tau weiter nach Suedwesten. "
       "Als Du die Pfahlhuette erreichst, schwingst Du Dich auf die "
       "Plattform und reibst Dir die schmerzenden Haende."));
    TP->move(ROOM "plattform", M_GO, 
       "nach Suedwesten", "hangelt", "klettert herein");
    return 1;
  }
  
  if(member(({"nach nordosten", "nach no", "no", "nordosten"}), str) > -1)
  {
    write(BS("Du hangelst Dich am Tau weiter nach Nordosten. "
       "Als Du den Tempel erreichst, kletterst Du durch das Fenster "
       "ins Innere und reibst Dir die schmerzenden Haende."));
    TP->move(ROOM "tempel2", M_GO, 
       "nach Nordosten", "hangelt", "klettert durchs Fenster herein");
    return 1;
  }

  notify_fail(BS("Wo willst Du Dich hinhangeln? "
     "Nach Suedwesten oder nach Nordosten?"));
  return 0;
}


init()
{
  object plumpser;

  ::init();
  plumpser = present("\nPlumpser", TP);
  if(plumpser) plumpser->remove();
  clone_object(OBJ "plumpser")->move(TP, M_NOCHECK);
}

int loslassen(string str)
{
  if (str == "los")
  {
     write("Du laesst das Tau los und faellst in die Tiefe.\n");
     TP->move(ROOM "dorf_g3", M_GO | M_NO_SHOW, "in die Tiefe", 
       "stuerzt ab und faellt", "kracht am Boden auf");
     write("Aua! Schmerzhaft schlaegst Du am Boden auf.\n");
     TP->do_damage(10 + random(30));
     return 1;
  }
  return 0;
}


varargs int PreventInsert(object ob)
{
   if (living(ob)) return ::PreventInsert(ob);

//   ob->call_out("move", 0, ROOM "dorf_g3", M_NOCHECK);
   call_out("runterwerfen", 0, ob);
   return ::PreventInsert(ob);
}

int ende(string str)
{
  write("Nein, der Befehl 'ende' funktioniert hier nicht.\n");
  return 1;
}

void runterwerfen(object ob)
{
  if (!objectp(ob) || ENV(ob)!=TO) return;
  tell_room(TO, ob->Name()+" faellt in die Tiefe.\n");
  tell_room(find_object(ROOM "dorf_g3"), ob->Name()+" faellt auf den Boden.\n");
  ob->move(ROOM "dorf_g3", M_NOCHECK);
}


