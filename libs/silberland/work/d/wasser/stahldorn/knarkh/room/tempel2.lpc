#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Tempeldachkammer" );
  SetProp( P_INT_LONG, BS(
    "Dieser Raum dient zum Zweck der Meditation. Er ist kreisrund und "
    "vollstaendig kahl. Die einzige Lichtquelle in der Duesternis "
    "dieser Kammer bildet das kleine Fenster, das im suedwestlichen "
    "Teil der Wand eingelassen ist." ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( "boden", BS(
    "Der Boden besteht aus pechschwarzem Stein. Er fuehlt sich irgendwie "
    "kalt an. Im Zentrum ist ein rundes Eisengitter in den Boden "
    "eingelassen.") );
  AddDetail( ({ "wand", "waende" }), 
    "Die Waende bestehen aus total dunklem Stein.\n" );
  AddDetail( "decke", 
    "Die Decke besteht, wie der Boden und die Waende aus schwarzem Stein.\n");
  AddDetail( ({ "tempelfenster", "fenster", "lichtquelle" }), BS(
    "Als Du durch das scheibenlose Fenster siehst, bemerkst Du ein dickes "
    "Tau, das vom Tempel zu der raetselhaften Pfahlhuette westsuedwestlich "
    "von Dir fuehrt.") );
  AddDetail( ({ "steine", "stein", "gestein" }), BS(
    "Das pechschwarze Gestein stammt aus den weit entfernten Minen und "
    "Steinbruechen der beruechtigten Dunkelzwerge, wie Du an den "
    "Punzierungen unschwer erkennen kannst.") );
  AddDetail( ({ "gitter", "eisengitter", "zentrum" }), BS( 
    "Ein im Boden eingelassenes gusseisernes Gitter, durch das Du in den "
    "Tempelraum unter Dir blicken kannst. Du wunderst Dich, wie Du in "
    "diesen Raum gelangen konntest, wo es doch keinen Eingang gibt.") );
  AddDetail( ({ "tau" }),BS( 
    "Das Tau wurde knapp unterhalb des Fensters irgendwie an der Mauer "
    "befestigt und spannt sich zig Meter weit ueber eine Gasse hinweg zu "
    "einer Pfahlhuette.") );
  AddDetail( ({ "huette", "pfahlhuette" }), 
    "Es kommt Dir so vor, als ob sich im Inneren der Huette etwas bewegt...\n");
  AddDetail( ({ "siegel", "punzierung", "punzierungen", "guetesiegel" }), 
    "Jeder einzelne Stein ist mit einem Guetesiegel der VDZSBGes versehen.\n"+
    "(Vereinigte DunkelZwergische SteinBruch Gesellschaften)\n" );
  AddDetail( ({ "gasse", "hauseck" }), 
    "Ein Hauseck und eine Gasse liegen zwischen der Pfahlhuette und dem "
    "Tempelfenster.\n" );
  AddSpecialDetail( "tempelraum", "tempellang" );
  AddDetail( ({ "altar" }), 
    "Der Altar befindet sich genau unter Dir.\n" );
  AddDetail( "himmel" , 
    "Wenn Du aus dem Fenster blickst, kannst Du ein Stueck vom Himmel sehen.\n" );
  AddDetail( ({ "aussenmauer", "aussenwand", "mauer" }), 
    "An der Aussenmauer wurde ein Tau befestigt.\n" );
  AddDetail( ({ "kammer", "raum", "dachkammer" }), 
    "Du befindest Dich in einer Kammer ueber dem Tempelraum.\n" );

//  AddDetail( ({ "" }), 
//    "" );

  AddCmd( ({ "klettere", "kletter" }), "klettern");
  AddCmd( ({ "meditiere", "meditier" }), "meditieren");
}

string tempellang()
{  
  object tempel;

  call_other( ROOM "tempel", "???", 0);
  tempel = find_object(ROOM "tempel");
  return tempel->int_long(TP, TP);
}

int klettern(string str)
{
  if(str == "durch fenster" || str == "aus fenster")
  {
    write("Du kletterst aus dem Fenster und hangelst Dich am Tau entlang.\n");
    TP->move(ROOM "balance", M_GO | M_NO_SHOW, 
       "aus dem Fenster", "klettert", "kommt hereingehangelt");
    return 1;
  }
  notify_fail("Wo willst Du durchklettern?\n");
  return 0;
}


int meditieren(string str)
{
  write(
   "Du setzt Dich kurz nieder und meditierst ein wenig.\n"
   "Kaum zu glauben, aber als Du wieder aufstehst, fuehlst Du Dich innerlich\n"
   "entspannter als je zuvor.\n");
  say(TP->Name()+" setzt sich nieder und meditiert ein wenig.\n");
  return 1;
}
