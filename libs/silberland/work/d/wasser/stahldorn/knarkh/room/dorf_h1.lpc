#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG +
	"Im Osten und Sueden zweigen Seitengassen ab, die um die Huette vor " +
	"Dir herumfuehren. " +
	"@@gut_boes@@"  ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "seitengassen", "gassen", "seitengasse", "gasse" }), BS(
    "Eine fuehrt nach Osten und eine nach Sueden. Sie sehen nicht gerade "
    "sauber und gepflegt aus.") );
  AddDetail( ({ "osten"  }), BS(
    "Die Gasse im Osten fuehrt ums Haus herum. ") );
  AddDetail( ({ "sueden"  }),
    "Die Gasse im Sueden scheint weiter hinten einen Knick zu machen.\n");
  AddDetail( ({ "haus", "huette", "gebaeude" }), BS(
    "Das Gebaeude vor Dir besteht hauptsaechlich aus Holzlatten, die schwarz "
    "angestrichen wurden. Das Auffaellige daran ist, dass dieses Haus "
    "auf Holzpfaehlen steht und man nirgends einen Eingang erkennen kann.") );
  AddDetail( ({ "latten", "holzlatten" }),
    "Sie sind ganz schwarz gestrichen.\n");
  AddDetail( ({ "eingang"  }),BS(
    "Du suchst vergeblich einen Eingang. Man kann (zumindest von hier aus) "
    "aber keinen erkennen.") );
  AddDetail( ({ "pfaehle", "holzpfaehle" }),
    "Darauf steht diese Huette.\n");

  AddExit( "suedosten", "./dorf_g2.lpc" );
  AddExit( "osten", "./dorf_h2.lpc" );
  AddExit( "sueden", "./dorf_g1.lpc" );
  AddGuardedExit( "nordwesten", ROOM "eingang.lpc", "knarkhist",
	   "Der Knarkhist hindert Dich daran und sagt: STOP, Freundchen!\n" );

  AddItem(NPC "powerknarkhist", REFRESH_DESTRUCT, 
	   ([P_MNPC_DEFAULTROOM: ROOM "dorf_h1",
	     P_MNPC_CMDS: ({ "nordwesten", "suedosten", "suedosten", "suedosten", "suedosten", "suedwesten", "nordwesten", "nordwesten",   
			     "westen", "sueden", "norden", "norden", "osten", "norden", "nordwesten", "suedosten", "osten", 
			     "suedosten", "nordwesten", "westen" }) ]) );

}

STDFUNC
