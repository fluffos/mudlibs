#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Plaza in Knarkh" );
  SetProp( P_INT_LONG, BS( PLAZALANG+ 
    "Im Nordosten steht ein breiter Backsteinbau ohne Fenster aber dafuer mit "
    "einer breiten Tuer. Daneben hat man einen Muelleimer hingestellt. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

PLAZADETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "bau", "backsteinbau", "haus", "kneipe" }), BS(
     "Der Backsteinbau im Nordosten macht einen zwar ebenso schmutzigen aber "
     "nicht ganz so aermlichen Eindruck, wie der Rest von Knarkh. Ueber "
     "der Tuer haengt eine breite Metalltafel."));
  AddDetail( ({ "tuer", "tuere", "schwingtuer", "schwingtuere" }),
     "Eine Schwingtuere nach Saloon-Stil. Vor ihr schimmert ein magisches "
     "Kraftfeld.\n" );
  AddDetail( ({ "kraftfeld" }), BS(
     "Es schimmert regenbogenfarben. Wahrscheinlich dient es dazu, unliebsame "
     "gute Lebewesen davon abzuhalten, sich in der Kneipe zu betrinken. "
     "Der Besitzer achtet wohl auf seinen Ruf und laesst nur Stammgaeste "
     "hinein.") );
  AddDetail( ({ "stammgaeste" }), BS(
     "Ein paar Stammgaeste gehen ein und aus. Dir faellt auf, dass sie alle "
     "einen silbernen Ring am Finger tragen. Seltsam.") );
  AddDetail( ({ "tafel", "metalltafel" }), BS(
     "Man sieht zwei Kerle, die gerade raufen. Der eine hat ein Messer in der "
     "Hand und versucht, den anderen damit abzumurksen. Darunter steht etwas "
     "geschrieben.") );
  AddDetail( ({ "kerle" }),
     "Der eine sieht finster und boese drein, der andere boese und finster.\n");
  AddReadDetail( ({ "tafel", "metalltafel" }),
     "   Zum Goldenen Bauchstich! \n   Tritt ein, bring Geld herein!\n" );
  AddDetail( ({ "fenster" }),BS(
     "Sowas ist bei einer Kneipe dieses Kalibers nur stoerend, weil es Licht "
     "hereinlaesst. Und die meisten der Stammgaeste scheuen das Licht.") );
  AddDetail( ({ "licht" }),
     "Das Licht in Knarkh sieht anders aus als woanders...\n" );
  AddDetail( ({ "wand", "waende" }),
     "Die Waende der Kneipe bestehen aus Backstein.\n" );
  AddDetail( ({ "stein", "backstein" }),
     "Gewoehnlicher Backstein. Mal grau, mal rostrot, mal braun.\n" );
  AddDetail( ({ "eimer", "muelleimer" }),
     "Er ist total leer. Keiner benutzt ihn. Du hast auch keine Lust dazu.\n" );
//  AddDetail( ({ "" }),
//     "" );

  AddSpecialExit( "nordosten", "in_kneipe" );
  AddExit( "westen", "./dorf_f5.lpc" );
  AddExit( "suedwesten", "./dorf_e5.lpc" );
  AddExit( "sueden", "./dorf_e6.lpc" );

  AddItem(NPC "powerknarkhist", REFRESH_DESTRUCT, 
             ([P_MNPC_DEFAULTROOM: ROOM "dorf_f6", 
               P_MNPC_FLAGS: MOV_INDOORS + MOV_OUTDOORS + MOV_MAYLOAD + 
                    MOV_MOVES + MOV_SPECIAL ]) );

}


STDFUNC

int in_kneipe()
{
  object silberring;

  notify_fail("Eine magische Barriere haelt Dich zurueck.\n");
  if (!interactive(TP)) 
    return this_player()->move(ROOM "dorf_g7", M_GO, "nach Nordosten");
;

  if(silberring = present("\ncombru", TP))
  {
    if(silberring->ladestatus())
    {
      write("Der Silberring hilft Dir, die Barriere zu ueberwinden.\n");
      silberring->ueberladen();
      return this_player()->move(ROOM "dorf_g7", M_GO, "nach Nordosten");
    }
  }
  return 0;
}
