#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Plaza in Knarkh" );
  SetProp( P_INT_LONG, BS( PLAZALANG + 
    "Nach Suedwesten hin kannst Du ein Haus betreten. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

PLAZADETAILS
DORFSMELLS
DORFSOUNDS

  
  AddDetail("fenster", "Der Laden hier hat keine Fenster.\n");
  AddDetail( ({"haus", "shop", "laden", "knarkhshop"}), 
    "Sieht etwas heruntergekommen aus. Ueber der Tuer haengt ein Schild.\n");
  AddDetail( "schild", "Es steht was drauf geschrieben.\n");
  AddReadDetail( "schild", "Der Knarkhshop! Kommen Sie, kaufen Sie!\n");
  AddDetail( "tuer", 
    "Die Tuer zum Knarkhshop steht offen. Geh einfach hinein.\n");
  AddDetail( ({ "wand", "waende" }), 
    "Die Waende des Knarkhshops sind weiss getuencht.\n" );
//  AddDetail( ({ "" }), 
//    "" );

  AddExit( "norden", "./dorf_d5.lpc" );
  AddExit( "nordosten", "./dorf_d6.lpc" );
  AddExit( "osten", "./dorf_c6.lpc" );
  AddExit( "suedwesten", "./dorf_b4.lpc" );

  AddItem(NPC "powerknarkhist", REFRESH_DESTRUCT, 
           ([P_MNPC_DEFAULTROOM: ROOM "dorf_c5",
             P_MNPC_CMDS: ({ "suedwesten", "nordosten", "nordosten", "nordwesten", "westen", "suedwesten", "nordwesten", "nordwesten", 
                             "westen", "suedosten", "nordwesten", "osten", "suedosten", "suedosten", "nordosten", "osten", 
                             "suedosten", "suedwesten" }) ]) );

}

STDFUNC
