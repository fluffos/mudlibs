#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor dem Tempel" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Noerdlich von Dir erhebt sich ein riesiger schwarzer Tempel, der eine "
    "unheimliche Aura ausstrahlt und Dir Angst einfloesst. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "tempel" }), 
    "Dunkle Steinmauern ragen vor Dir in den Himmel.\n" );
  AddDetail( ({ "aura" }), 
    "Die Aura, die der Tempel ausstrahlt wirkt bedrueckend.\n" );
  AddDetail( ({ "angst" }), 
    "Gibs zu! Du hast ein klein wenig Angst!\n" );
  AddDetail( ({ "plakat", "plakate" }), BS(
    "Alle moeglichen Sprueche und Parolen stehen drauf. Auch einige "
    "Werbeplakate sind dabei.") );
  AddDetail( ({ "poster", "motive" }), BS(
    "Auf den Postern sieht man immer die selben Motive. Einen Satan beim "
    "Stehlen einer Seele, einen Teufel, der gerade das Hoellenfeuer "
    "heiss macht, einen kleinen Beelzebub, der einem andern Beelzebub "
    "etwas ins Ohr fluestert, einen Antichristen beim Verbrennen eines "
    "Kruzifixes und so weiter.") );
  AddDetail( ({ "werbeplakat", "werbeplakate" }), BS(
    "Darauf wird fuer allerlei boese Dinge geworben. Foltomat zum Beispiel "
    "ist recht haeufig vertreten. Auch die 'Satan AG' wirbt hier. Und "
    "der CdN (Club der Nekrophilen) schreibt, dass er morgen den Tag " 
    "der offenen Tuer hat.") );
  AddDetail( ({ "teufel", "satan", "antichrist", "beelzebub" }), BS(
    "Alles Namen fuer den selben widerwaertigen Kerl. Du hoffst, dass DER "
    "nicht auch noch in Knarkh wohnt.") );
  AddDetail( ({ "sprueche", "parolen" }), 
    "Du kannst sie mit \"lies plakat <nr>\" lesen.\n" );
  AddReadDetail( ({ "plakat", "plakate", "spruch", "sprueche", "parolen", 
    "parole" }), 
    "Welches willst Du lesen? \"lies plakat <nr>\"." );
  AddReadDetail( ({ "plakat 1" }), 
    "Du sollst die Nacht nicht vor dem Tage loben!\n" );
  AddReadDetail( ({ "plakat 2" }), BS(
    "Heute Mitternachtsmatinee! Es spielen 'Gigadeth', 'Midas Massacre'," 
    "'Behold the Black Balrog' und 'The Undead Kennedys' LIVE und "
    "GLEICHZEITIG! Anschliessend Diskussionforum mit dem beruehmten "
    "Dr.Hatecraft zum Thema 'Geliebte Gewalt'.") );
  AddReadDetail( ({ "plakat 3" }), 
    "Bettler und Hausierer unerwuenscht.\n" );
  AddReadDetail( ({ "plakat 4" }), 
    "Achtung, bissiger Poltergeist!\n" );
  AddReadDetail( ({ "plakat 5" }), 
    "Der Herr sagt: 'Hasse Deinen Uebernaechsten wie deinen Naechsten.'\n" );
  AddDetail( ({ "mauern", "mauer", "steinmauer", "steinmauern" }), 
    "Pechschwarz und boese.\n" );
  AddDetail( ({ "stein", "steine" }), 
    "Pechschwarzer Stein. Daraus besteht der Tempel.\n" );
  AddDetail( ({ "hoellenfeuer" }), 
    "Es brennt lichterloh und wartet gefraessig auf Nahrung.\n" );
//  AddDetail( ({ "" }), 
//    "" );

  AddExit( "suedosten", "./dorf_f5.lpc" );

  NewDoor("norden", ROOM "tempel", "portal", 
     ({D_FLAGS, DOOR_RESET_CL, 
       D_NAME, "Portal",
       D_GENDER, NEUTER, 
       D_SHORT, "Ein riesiges Portal fuehrt in den Tempel. (%s)",
       D_LONG, BS(
         "Ein grosses Portal. Es fuehrt nach Norden in den Tempel. "
         "Vom eigentlichen Portal ist aber wenig zu sehen, weil eine "
         "Unmenge von Postern und Plakaten darauf aufgeklebt sind. "),}));
}

STDFUNC
