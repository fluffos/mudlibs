#include <mnpc.h>
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
      "Im Nordwesten ragt eine grosse Huette auf, die auf Pfaehlen steht. "
      "Im Osten und Westen siehst Du zwei dunkle Hauseingaenge. "
      "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "haus", "huette", "gebaeude" }), BS(
    "Das Gebaeude nordwestlich von Dir besteht hauptsaechlich aus "
    "Holzlatten, die schwarz angestrichen wurden. "
    "Das Haus wurde auf dicken Holzpfaehlen errichtet.") );
  AddDetail( ({ "latten", "holzlatten" }),
    "Sie sind ganz schwarz gestrichen.\n");
  AddDetail( ({ "pfaehle", "holzpfaehle" }),
    "Darauf steht diese Huette.\n");
  AddDetail( ({ "hauseingang", "hauseingaenge", "eingang", "eingaenge" }),BS( 
     "Man kann bei keinem der beiden Eingaenge sehen, was dahinter liegt. "
     "Es ist einfach zu dunkel. Ueber dem Eingang im Osten erkennst Du "
     "eine steinerne Tafel; der Eingang im Westen ist von einem halbrunden "
     "Torbogen umgeben.") );
  AddDetail( ({ "tafel", "steintafel", "steinerne tafel" }),  
     "Es stand einmal was drauf geschrieben, was aber nun schon "+
     "verwittert ist.\n" );
  AddReadDetail( ({ "tafel", "steintafel", "steinerne tafel" }),  
     "'Wa n  g vo.  em Hu d!  chtung bi.si ' \n" );
  AddDetail( ({ "hunde", "hund" }),  
     "Du siehst hier keinen Hund. Aber Du hoerst einen.\n" );
  AddSound( ({ "hunde", "hund", "eingang", "westen" }), BS(
     "Ein moerderisches Knurren und wuetendes Bellen von einem oder "
     "mehreren Hunden dringen aus "
     "dem Eingang im Osten an Dein Ohr. Die Hunde haben wohl "
     "Blut gewittert...") );
  AddSound( "knurren",
     " KNUUUURRRRRRRR!!!  GRRRRRRRRRRR!!!  KNUUUURRRRRRRR!!!\n" );
  AddSound( "bellen", 
     " WAFF! BAFF! GRRRRRRRRR! WAU! WAU! WAFF!\n" );
  AddSmell( "blut",  
     "Du riechst kein Blut. Aber die Hunde im Osten anscheinend schon.\n" );
  AddDetail( ({ "torbogen", "bogen", "halbkreis" }), BS(
     "Der Torbogen ueber dem Hauseingang im Westen woelbt sich in einem "
     "makellosen Halbkreis ueber den Resten einer Tuer.") );
  AddDetail( ({ "reste", "tuer" }), BS(
     "Die Reste einer Tuer vergammeln am Hauseingang. Einige verrottete "
     "Truemmer liegen am Boden. An der Wand stecken noch zwei Stuecke "
     "von Holzbrettern an den verrosteten Ueberbleibseln der Tuerangeln.") );
  AddDetail( ({ "wand", "waende", "hauswaende" }),
     "Die Hauswaende sind uninteressant. Mit Ausnahme der beiden "+
     "Eingaenge.\n" );
  AddDetail( "truemmer",
     "Reste eines Tuerblattes liegen am Boden.\n" );
  AddDetail( ({ "stuecke", "holzbretter", "bretter" }), BS(
     "Es sieht so aus, als sei vor langer Zeit einmal die Tuer aufgebrochen "
     "worden. Die an den Angeln haengengebliebenen Stuecke weisen "
     "jedenfalls Spuren von Gewalteinwirkung auf.") );
  AddDetail( "spuren",  
     "Man hat die Tuer anscheinend mit schweren Axtschlaegen zerstoert.\n");
  AddDetail( ({ "angeln", "tuerangeln", "ueberbleibsel" }),
     "Die verrosteten Tuerangeln haben schon bessere Zeiten gesehen.\n" );

  AddExit( "suedosten", "./dorf_e4.lpc" );
  AddExit( "osten", "./dorf_f4.lpc" );
  AddExit( "westen", "./dorf_f2.lpc" );
  AddGuardedExit( "nordwesten", ROOM "dorf_g2.lpc", "knarkhist",
           "Der Knarkhist hindert Dich daran und sagt: STOP, Freundchen!\n" );

  AddItem(NPC "powerknarkhist", REFRESH_DESTRUCT, 
           ([P_MNPC_DEFAULTROOM: ROOM "dorf_f3",
             P_MNPC_CMDS: ({ "w", "o", "nw", "nw", "s", "w", "s", "so", 
                             "nw", "o", "so", "so", "no", "nw", 
                             "o", "w" }) ]) );

}

STDFUNC

