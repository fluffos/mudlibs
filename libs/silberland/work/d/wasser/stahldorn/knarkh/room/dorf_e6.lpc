#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Plaza in Knarkh" );
  SetProp( P_INT_LONG, BS( PLAZALANG + 
    "Nach Osten verlaesst eine Strasse die Plaza. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

PLAZADETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail("strasse", "Eine Strasse fuehrt nach Osten.\n");

  AddExit( "norden", "./dorf_f6.lpc" );
  AddExit( "nordwesten", "./dorf_f5.lpc" );
  AddExit( "westen", "./dorf_e5.lpc" );
  AddExit( "suedwesten", "./dorf_d5.lpc" );
  AddExit( "sueden", "./dorf_d6.lpc" );
  AddExit( "osten", "./dorf_e7.lpc" );

  AddItem(OBJ "statue", REFRESH_REMOVE);

}

STDFUNC
