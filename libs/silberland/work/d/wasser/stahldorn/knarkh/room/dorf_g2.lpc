
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


int gib_healed=2;
int stell_healed=2;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Unter dem Pfahlhaus" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Du stehst unmittelbar unter einer grossen, schwarzen Huette, " 
    "die einen dunklen und boesartig unheimlichen Schatten auf Dich wirft. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "sonne"  }),BS(
    "Die siehst Du hier nicht, weil der Himmel von der Huette ueber Dir "
    "verdeckt wird." ));
  AddDetail( ({ "himmel"  }), BS(
    "Der wird von der grossen Pfahlhuette verdeckt." ));
  AddDetail( ({ "huette", "pfahlhuette" }), BS(
    "Sie befindet sich nun direkt ueber Dir. Von unten sieht man eine Luke, "
    "die hineinfuehrt. Die Luke ist aber geschlossen und ausserdem zu weit "
    "oben, als dass Du hineinklettern koenntest."));
  AddDetail( ({ "pfaehle", "holzpfaehle" }),
    "Auf ihnen ruht die Huette.\n");
  AddDetail( ({ "luke" }),
    "Sie befindet sich genau ueber Dir in etwa zehn Metern Hoehe.\n");
  AddDetail( ({ "dach" }),
    "Das \"Dach\" wird von der Huette ueber Dir gebildet.\n");
  AddDetail( ({ "schatten" }),
    "Er macht Dir Angst, denn er verbirgt die Gefahren, die hier lauern.\n");
  AddDetail( ({ "gefahren", "gefahr" }), BS(
    "Sie sind mannigfaltig und durchwegs toedlich. Gib acht, denn die "
    "Kreaturen des Boesen kennen keine Gnade."));
  AddDetail( ({ "angst" }),
    "Ja, Du hast Angst! Stell Dich ihr!\n");
  AddDetail( ({ "kreaturen" }),
    "Du hast zu viel Angst, um hinzusehen.\n");


  AddCmd( ({"klettere", "kletter"}), "klettern");
  AddCmd( ("gib"), "gibacht");
  AddCmd( ({"stell", "stelle"}), "stellen");


  AddExit( "suedosten", "./dorf_f3.lpc" );
  AddGuardedExit( "nordwesten", ROOM "dorf_h1.lpc", "knarkhist",
           "Der Knarkhist hindert Dich daran und sagt: STOP, Freundchen!\n" );

}

STDFUNC

klettern(string str)
{
  write("Hier gibts nix zu klettern. Und die Luke ist sowieso zu weit oben.\n");
  return 1;
}

gibacht(string str)
{
  if (str == "acht" && gib_healed)
  {
    write (BS( "Du bist intelligent genug, die grossen Gefahren hier in Knarkh "
	"abschaetzen zu koennen. Diese Faehigkeit gibt Dir innere Kraft und "
	"erhoeht Dein Selbstbewusstsein.") );
    TP->restore_spell_points(80+random(30));
    gib_healed--;
    return 1;
  }
  if (!gib_healed)
  {
    write( "Dein Selbstbewusstsein ist bereits hoch genug!\n" );
    return 1;
  }
  return 0;
}


stellen(string str)
{
  notify_fail("Wem oder was willst du Dich stellen?\n");
  if ((str == "dich gefahr" || str == "dich gefahren" || str == "dich angst") 
       && stell_healed)
  {
    write (BS( "Du stellst Dich der Gefahr und befolgst damit die wichtigste "
	"Regel im Kampf gegen das Boese. Wenn man seine Angst ueberhand nehmen "
	"laesst, oder die Gefahr falsch beurteilt, gibt man dem Boesen seine "
	"gefaehrlichste Waffe in die Hand. Den TERROR! Diese Erkenntnis "
	"gibt Dir neue Lebenskraft und mildert Deine Schmerzen.") );
    TP->heal_self(80+random(30));
    stell_healed--;
    return 1;
  }
  if (!stell_healed)
  {
    write( "Die Magie des Ortes muss sich erst wieder sammeln!\n" );
    return 1;
  }
  return 0;
}

reset()
{
  gib_healed=2;
  stell_healed=2;
  ::reset();
}
