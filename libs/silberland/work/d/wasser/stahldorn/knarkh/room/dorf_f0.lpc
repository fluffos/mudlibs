
#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Seitengasse im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
     "Hier zweigen ploetzlich zwei kurze Sackgassen ab. "
     "Nach Suedosten hin kannst Du ein Haus betreten, aus dem ein seltsamer "
     "Geruch stroemt. @@gut_boes@@") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddExit( "suedosten", "./dorf_e1.lpc" );
  AddExit( "sueden", "./dorf_e0.lpc" );
  AddExit( "norden", "./dorf_g0.lpc" );
  AddExit( "osten", "./dorf_f1.lpc" );

  AddDetail( ({"sackgassen", "gassen", "sackgasse", "gasse"}), 
    "Sie fuehren in zwei verschiedene Richtungen:\n" +
    "Eine nach Osten.\n" +
    "Und eine nach Sueden.\n");
  AddDetail( ({ "suedosten", "haus" }), 
    "Das Haus im Suedosten steht offen. Ein seltsamer Geruch stroemt "+ 
    "heraus.\n" );
  AddDetail( ({ "aussenwand", "aussenwaende", "wand", "waende", "holz" }), 
    "Die Aussenwaende der Huetten und Haeuser bestehen aus Holz.\n" );
  AddDetail( ({ "huetten", "haeuser" }), 
    "Die Huetten und Haeuser bestehen aus Holz. Sie sind sehr primitiv "+
    "gebaut.\n" );
  AddSmell( ({ "haus", "geruch" }), 
    "Es riecht eindeutig nach... aeh... hmm... seltsam.\n" );

}

STDFUNC
