#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Plaza in Knarkh" );
  SetProp( P_INT_LONG, BS( PLAZALANG + 
    "Nach Westen verlaesst der Hauptweg den Platz. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_KILL_NAME, "Eine hinterlistige Scriptfalle");

PLAZADETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "weg", "hauptweg" }), 
    "Er muendet westlich von Dir auf die Plaza, bzw. verlaesst er sie dort.\n" );
  AddDetail( "boden", 
    "Als Du den Boden betrachtest, faellt Dir ein kleiner roter Fleck auf.\n" );
  AddDetail( ({ "fleck", "roter fleck" }), BS(
    "Der Fleck sieht aus wie ein Blutfleck. "
    "Irgendetwas stimmt aber daran nicht.") );
  AddDetail( ({ "blutfleck", "blut" }), 
    "Vielleicht ist es doch kein Blut? Irgendwie ist der Fleck zu rot.\n" );
  AddSmell( ({ "blut", "fleck", "blutfleck", "roter fleck" }), BS(
    "Du steckst den Finger in das 'Blut' und riechst daran. Irgendwie kommt "
    "es Dir nun gar nicht mehr vor wie Blut eher wie... Du steckst den "
    "Finger in den Mund und kostest. Ja. Richtig. Es ist Himbeermarmelade."));
  AddDetail( ({ "marmelade", "himbeermarmelade" }), 
    "Jemand hat etwas Himbeermarmelade auf den Boden gekleckst.\n" );
  AddDetail( "finger", 
    "Der Finger ist ein wenig klebrig.\n" );
  AddDetail( ({ "irgendetwas", "irgendwie" }), BS(
    "Dieses Wort hast Du doch nur untersucht, weil es grossgeschrieben "
    "wurde, oder? Irgendwie draengt sich da einem die Vermutung auf, "
    "dass Du mit einem Script auf Forscherpunktejagd gehst. Da das aber "
    "nicht erlaubt ist, bitte ich Dich nun, damit aufzuhoeren und das "
    "Script nicht mehr zu verwenden.") );
  AddDetail( "forscherpunktejagd", BS(
    "Also entweder Du gehoerst zu der ganz harten Sorte, oder die "
    "Vermutung mit dem Untersuche-Script war richtig. Du musst doch "
    "zugeben, dass 'unt irgendetwas', 'unt irgendwie' oder 'unt forscher"
    "punktejagd' relativ wenig Sinn ergeben, oder? Also tu mir bitte den "
    "Gefallen und untersuche das Wort Irgendwann nicht!"));
  AddDetail( "irgendwann", BS(
    "Du sollst das nicht untersuchen! Da ich aber viel Geduld habe "
    "(ich bin ja auch nur ein Computer) lasse ich noch einmal Gnade "
    "vor Recht ergehen. Wenn Du eines der Worte im naechsten Satz "
    "untersuchst, ist es aber aus, denn dann gibts einen Teleport zu "
    "unserem Freund mit der Sense. ") + 
    "   Der Whiskymixer Mixt Den Whisky Mit Dem Whiskymixer.\n");
  AddSpecialDetail( ({ "mixt", "whiskymixer" }), "scripttod" );
  AddDetail( ({ "rot" }), 
    "Eher himbeerrot als blutrot.\n" );
//  AddDetail( ({ "" }), 
//    "" );

  AddExit( "westen", "./dorf_e4.lpc" );
  AddExit( "norden", "./dorf_f5.lpc" );
  AddExit( "nordosten", "./dorf_f6.lpc" );
  AddExit( "osten", "./dorf_e6.lpc" );
  AddExit( "suedosten", "./dorf_d6.lpc" );
  AddExit( "sueden", "./dorf_d5.lpc" );

}

STDFUNC

string scripttod()
{
  write("GENUG! In der Hoelle sollst Du schmoren!\n");
  TP->die();
  return "Selber Schuld!   Ha Ha!   Baeh!   Aetsch!   =8^>  \n";
}

