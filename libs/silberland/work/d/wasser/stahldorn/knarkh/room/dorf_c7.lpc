#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int fass_zu, fass_voll;

create()
{
  ::create();

  fass_zu = 1;
  fass_voll = 1;

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
    "Nach Sueden hin fuehrt ein Steg aufs Meer hinaus. Noerdlich von Dir "
    "siehst Du ein Lagerhaus, vor dessen Eingang sich Kisten und Faesser "
    "tuermen, die hier anscheinend schon laenger herumliegen."
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "lager", "haus", "lagerhaus","zwischenlager" }), BS(
    "Obwohl das Lagerhaus von wirklich beeindruckender Groesse ist, hat "
    "es nur einen vergleichsweise kleinen Eingang in Form einer simplen "
    "Metalltuer. Die Waren da drin koennen also kaum groesser sein als "
    "mannshoch, sonst wuerde man sie nicht ins Haus gebracht haben koennen. "
    "Er dient wahrscheinlich den staerksten der Piraten als Unterschlupf "
    "und Zwischenlager fuer ihre Beute, waehrend andere Gruppen sich "
    "anderswo geheime Schlupfwinkel gesucht haben.") );
  AddDetail( ({ "gruppen", "schlupfwinkel", "unterschlupf" }),
    "Wo die anderen Gruppen ihre Schlupfwinkel gefunden haben, kannst Du "
    "von hier aus natuerlich nicht sehen." );
  AddDetail( ({ "beute", "waren", "ware" }), BS(
    "Nur der relativ wertlose Teil der Beute lagert hier in den Kisten und "
    "Faessern ausserhalb des Lagerhauses. Der wertvolle Rest ist fuer Dich "
    "unzugaenglich.") );
  AddDetail( ({ "haeuser" }), BS(
    "Noerdlich von Dir befindet sich ein Lagerhaus. Andere Haeuser siehst "
    "Du von hier aus nicht.") );
  AddDetail( ({ "kiste", "kisten" }), BS(
    "In den Kisten lagert allerlei Geruempel. Alte Taue, verrostete "
    "Werkzeuge und loechrige Segel. Nichts davon scheint noch zu gebrauchen "
    "zu sein, aber die Piraten werfen so schnell nichts weg.") );
  AddDetail( ({ "taue", "tau" }), BS(
    "Die Taue vermodern schon. Die halten Dein Gewicht sicher nicht mehr "
    "aus, falls Du vorhast, sie zum Klettern zu verwenden. ") );
  AddDetail( ({ "geruempel" }), 
    "Allerlei Geruempel liegt in den Kisten. Nichts davon hat einen Wert.\n");
  AddDetail( ({ "werkzeug", "werkzeuge" }), BS(
    "Die Werkzeuge wurden auf den Schiffen verwendet und sind aufgrund "
    "der feuchten, salzigen und agressiven Meerluft schnell korrodiert.") );
  AddDetail( ({ "segel" }), 
    "Ein paar loechrige Segel verrotten in den Kisten.\n" );
  AddDetail( ({ "faesser" }), BS(
    "Die meisten sind leer oder mit alten und vergammelten Spirituosen "
    "gefuellt. Nur eines sieht noch relativ neu aus. Auf der Oberseite "
    "klebt ein Zettel.") );
  AddDetail( ({ "oberseite" }), 
    "An der Oberseite des Fasses klebt ein Zettel.\n" );
  AddDetail( ({ "fass" }), BS(
    "Nur eines der Faesser sieht noch relativ neu aus. Ein Zettel wurde "
    "an ihm festgeklebt. Es ist geschlossen.") );
  AddDetail( ({ "zettel" }), 
    "Ein fettiger kleiner Zettel. Es steht was drauf.\n" );
  AddDetail( ({ "spirituosen" }), 
    "Schimmliger Grog, stinkender Fusel und gruenliches Bier...\n" );
  AddDetail( ({ "grog", "fusel", "bier" }), BS(
    "Du hoffst, dass der Wirt des Goldenen Bauchstichs seine "
    "Getraenke nicht von hier bezieht.") );
  AddReadDetail( ({ "zettel" }), 
    "Plurrk, Du Kroete! \n"+BS(
      "Vergiss nicht, dieses Fass auf die Felseninsel mit"
      "zunehmen und dort an der ueblichen Stelle zu verstecken. Es ist "
      "noch etwas von dem Pulver drin, das ich Dobbodox geklaut hab." )+
    "Unterschrift: Nuhilo der Kapitaen.\n");
  AddDetail( ({ "welle", "wellen" }), 
    "Du siehst zu wenig, weil zu weit vom Meer entfernt bist.\n" );
  AddSound( ({ "wellen", "rauschen", "meer" }), BS(
    "Du hoerst das Meer im Sueden ganz deutlich. Das Rauschen der Wellen "
    "wirkt beruhigend auf Dich.") );
  AddSmell( ({ "meer", "meerluft" }), BS(
    "Die Meerluft riecht angenehm frisch und salzig. Mit jeder Brise weht "
    "sie einen Teil des Gestanks aus Knarkh weg.") );
  AddDetail( ({ "plaza" }), 
    "Die Plaza liegt westlich von Dir.\n" );
  AddDetail( ({ "weg" }), 
    "Der Weg fuehrt hier am Hafensteg vorbei von Westen nach Osten.\n" );
  AddDetail( ({ "groesse" }), 
    "Das Lagerhaus ist etwa so gross, wie zehn Hobbits breit sind.") ;
  AddDetail( ({ "eingang", "tuer", "tuere", "metalltuere", "metalltuer"}),
    "Die Tuer zum Lagerhaus ist mit einem dicken Vorhaengeschloss versehen. "
    "Die Devise von der Kraehe, die der anderen kein Auge aushackt, gilt "
    "in Knarkh wohl nicht.");
  AddDetail( ({ "schloss", "vorhaengeschloss" }), BS(
    "Das Vorhaengeschloss schuetzt das Lagerhaus vor ungebetenen Eindring"
    "lingen. Es ist gross wie eine Faust und sieht absolut unzerstoerbar "
    "aus. Du kannst die Tuere also nicht oeffnen.") );
  AddDetail( "kraehe", BS(
    "Das war nur ein Sprichwort (*seufz*). Hier gibts keine Kraehen. Oh! "
    "Halt. Als Du aufs Dach des Lagerhauses blickst, bemerkst Du dort "
    "tatsaechlich zwei Kraehen! So ein Zufall...") );
  AddDetail( ({ "dach", "zwei kraehen", "kraehen" }), BS(
    "Auf dem Dach des Lagerhauses sitzen zwei Kraehen. Sie scheinen sich "
    "nicht besonders liebzuhaben, denn die eine hackt gerade der anderen "
    "ein Auge aus.") );
  AddDetail( ({ "aug", "auge" }), 
    "Das Auge der einen Kraehe sieht schon arg zugerichtet aus.\n" );
  AddDetail( ({ "meer" }), 
    "Das Meer erstreckt sich unendlich weit nach Sueden.\n" );
  AddDetail( ({ "steg" }), 
    "Der Steg fuehrt nach Sueden aufs Meer hinaus.\n" );
//  AddDetail( ({ "" }), 
//    "" );
  
  AddExit( "osten", "./dorf_c8.lpc" );
  AddExit( "westen", "./dorf_c6.lpc" );
  AddExit( "sueden", "./dorf_b7.lpc" );

  AddCmd("oeffne", "oeffnen");
  AddCmd("nimm", "nehmen");

}

STDFUNC

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if(str=="tuer" || str == "tuere")
  {
     write(BS(
       "Du zerrst und ruettelst an der Tuer zum Lagerhaus, aber das Vorhaenge"
       "schloss ist einfach zu dick. Enttaeuscht gibst Du wieder auf."));
     say(TP->Name()+" zerrt vergeblich and der Tuer zum Lagerhaus.\n");
     return 1;
  }

  if(str == "fass")
  {
    if(!fass_zu)
    {
      notify_fail("Das Fass ist doch schon offen!\n");
      return 0;
    }
    fass_zu = 0;
    write("Du machst das Fass auf und siehst einen Rest Pulver darin.\n");
    say(TP->Name()+" oeffnet ein Fass.\n");
    RemoveDetail("fass");
    AddDetail( ({ "fass" }), BS(
      "Nur eines der Faesser sieht noch relativ neu aus. Ein Zettel wurde "
      "an ihm festgeklebt. Es ist offen und etwas Pulver liegt drin.") );
    return 1;
  }

  return 0;
}


reset()
{
 ::reset();
 RemoveDetail("fass");
 AddDetail( ({ "fass" }), BS(
    "Nur eines der Faesser sieht noch relativ neu aus. Ein Zettel wurde "
    "an ihm festgeklebt. Es ist geschlossen.") );
 fass_zu = 1;
 fass_voll = 1;
}

int nehmen(string str)
{
  string arg;
  object ob;

  if (!str) return 0;
  if (sscanf(str, "%s aus fass", arg)!=1) return 0;
  
  if(fass_zu)
  {
    write("Du musst das Fass vorher oeffnen, bevor Du etwas herausnehmen "+
          "kannst.\n");
    return 1;
  }
  if(!fass_voll)
  {
    write("Das Fass ist aber leer!\n");
    return 1;
  }
  
  if (arg == "pulver" || arg == "schiesspulver")
  {
    if ((ob=clone_object(OBJ "schiesspulver"))->move(TP, M_GET)==ME_TOO_HEAVY)
    {
      write("Du kannst "+ob->name(WEN)+" nicht mehr tragen.\n");
      ob->move(TO, M_NOCHECK);
    }
    else
      write("Du nimmst "+ob->name(WEN)+" aus einem Fass.\n");
    say(TP->Name()+" nimmt "+ob->name(WEN)+" aus einem Fass.\n");
    fass_voll = 0;
    RemoveDetail("fass");
    AddDetail( ({ "fass" }), BS(
      "Nur eines der Faesser sieht noch relativ neu aus. Ein Zettel wurde "
      "an ihm festgeklebt. Es ist offen und leer.") );
    return 1;
  }
  return 0;
}

