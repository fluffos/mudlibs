#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int knubbel, beule;

create()
{
  ::create();

  beule = 1; knubbel = 1;

  SetProp( P_INT_SHORT, "In der Eingangshalle zum Haus von Dobbodox" );
  SetProp( P_INT_LONG, BS( 
    "Dies ist die Eingangshalle eines maechtigen Herrenhauses. "
    "Der offen zur Schau gestellte Reichtum steht im krassen Gegensatz zu "
    "dem dreckigen, aermlichen - aber auch gefaehrlichen - Dorf draussen. "
    "Eine breite Prachttreppe fuehrt nach oben in das Obergeschoss. Eine "
    "kleinere Wendeltreppe direkt vor Dir dreht sich linkswendig in den "
    "Keller hinunter. Du kannst in allen Himmelsrichtungen weiter in der "
    "Halle herumstreifen. Nach Sueden geht es wieder zurueck auf die "
    "Strasse. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "parkettboden", "boden" }), BS(
    "Der Boden besteht aus Mahagoniparkett, das grossteils durch einen "
    "dicken Teppich verdeckt wird.") );
  AddDetail( ({ "decke" }), 
    "An der Decke haengt ein riesiger Luester.\n" );
  AddDetail( ({ "wand", "waende" }), 
    "Die Waende schillern in allen Regenbogenfarben. Sieht gespenstisch " +
    "aus.\n" );
  AddDetail( ({ "treppe", "treppen" }), BS(
    "Welche der Treppen meinst Du? Die Wendeltreppe in den Keller, oder "
    "Die breite Prachttreppe, die ins Obergeschoss fuehrt?") );
  AddDetail( ({ "wendeltreppe" }), BS(
    "Eine einfache Wendeltreppe. Sie beginnt hier in der Halle und "
    "verschwindet in scharfen Linksdrehungen im Boden.") );
  AddDetail( ({ "prachttreppe" }), BS( 
    "Die Prachttreppe ist mit Teppichen ausgelegt. An den Seiten " 
    "befindet sich ein glattes Gelaender, an dem man sicher schoen "
    "nach unten rutschen koennte, wenn da nicht am Ende ein grosser "
    "Holzknubbel befestigt waer.") );
  AddDetail( ({ "regenbogenfarben", "farben" }), 
    "Um mehr zu erkennen, muesstest Du genauer hingehen.\n" );
  AddDetail( ({ "parkett", "mahagoniparkett", "mahagoni" }), BS(
    "Der Parkettboden besteht aus dunklem Mahagoni. Es sieht recht "
    "edel und geschmackvoll aus.") );
  AddDetail( ({ "luester", "luster" }), 
    "Der Luester unter der Decke spendet der Halle Licht.\n" );
  AddDetail( ({ "teppich", "teppiche" }), BS(
    "Der Teppich bedeckt den groessten Teil des Bodens. Seltsam "
    "mystische Motive verzieren ihn. An einer Stelle siehst Du eine "
    "kleine Ausbeulung.") );
  AddDetail( ({ "keller", "loch" }), BS(
    "Der Keller ist nur als dunkles Loch sichtbar, in das sich die Wendel"
    "treppe windet. Dumpfe Geraeusche dringen dort heraus.") );
  AddDetail( ({ "obergeschoss" }), 
    "Von hier aus kannst Du vom Obergeschoss nichts erkennen.\n" );
  AddDetail( "halle", "Du stehst in ihr. Sieh Dich ruhig um!\n" );
  AddDetail( ({ "knubbel", "holzknubbel" }), BS(
    "Der Knubbel ist wirklich fies. Wenn er nicht da waere, koennte "
    "man so schoen vom Obergeschoss in die Halle rutschen. Vielleicht "
    "kann man ihn ja abreissen...") );
  AddDetail( ({ "gelaender" }), BS( 
    "Ein breites Gelaender saeumt die Prachttreppe. So richtig schoen zum "
    "Runterrutschen.") );
  AddDetail( ({ "licht" }), BS(
    "Seltsam, aber Dir faellt zum wiederholten Mal auf, dass das Licht "
    "in Knarkh ein wenig anders aussieht, als anderswo.") );
  AddSpecialDetail( ({ "beule", "ausbeulung" }), 
    "teppich" );
  AddDetail( ({ "motive", "muster" }), BS(
    "Verschlungene Drachen- und Daemonenornamente bilden ein verwirrendes "
    "Muster am Teppich.") );
  AddSound( ({ "geraeusche", "keller" }), BS(
    "Aus dem Keller dringt ein rhytmisches Pochen. Manchmal wird es aber "
    "durch menschliche, elfische, hobbitische und zwergische Schreie "
    "unterbrochen.") );
  AddSound( DEFAULT_SOUND, 
    "Dumpfe Geraeusche dringen aus dem Keller.\n" );
  AddSound( ({ "schreie" }), 
    "Schreie aus Angst und Schreie aus Pein dringen immer wieder aus dem "
    "Keller.\n" );
  AddSound( ({ "pochen" }), 
    "  *POCH*   *POCH   *POCH*   *POCH*   *POCH*   *POCH*   *POCH*\n" );
  AddDetail( ({ "ornament", "ornamente" }), BS(
    "Sie nehmen an manchen Stellen konkrete Gestalt in Form von Daemonen "
    "und Drachen an, verfliessen aber sofort wieder ins Nichts, nur um "
    "ploetzlich durch ihr Nichtvorhandensein als Negativ des zuvor "
    "gesehenen Ornaments wieder aufzutauchen. Das Ganze fuehrt in "
    "unendlicher Selbstaehnlichkeit immer tiefer und tiefer, bis " 
    "die natuerliche Feinkoernigkeit des Gewebes vor Deinen Augen mit "
    "den Linien und Flaechen des Musters sich zu vermischen beginnt.") );
  AddDetail( ({ "drachenornamente", "drachen" }), 
    "Kompliziert ineinander verschlungene Drachen aller Groessen und Farben.\n" 
    "Faszinierend.\n" );
  AddDetail( ({ "daemonenornamente", "daemonen" }), 
    "Sie tauchen immer dann auf, wenn man gerade nicht damit rechnet.\n"+
    "Gebannt starrst Du darauf bis Dir die Augen weh tun.\n");
  AddDetail( ({ "linien", "flaechen" }), BS(
    "Sie setzen sich in scheinbar willkuerlichen und doch fraktal "
    "mathematischen Abstaenden immer wieder zu daemonenhaften Gebilden "
    "zusammen.") );
  AddDetail( ({ "reichtum" }), 
    "Der Reichtum des Besitzers ist nicht zu uebersehen.\n" );
  AddDetail( ({ "dorf", "knarkh" }), 
    "Das Dorf draussen ist im Gegensatz zu hier viel aermlicher und "+
    "dreckiger.\n" );
//  AddDetail( ({ "" }), 
//    "" );

  AddSpecialExit( ({"norden", "nordosten", "osten", "suedosten"}), "no_go" );
  AddExit( "sueden", "./dorf_e10.lpc" );
  AddSpecialExit( ({"suedwesten", "westen", "nordwesten", "oben"}), "no_go" );
  AddGuardedExit( "unten", ROOM "dobbo1.lpc", "bestie", 
     "Die Bestie hindert Dich daran, nach unten zu gehen.\n");
//  AddSpecialExit( ({"unten"}), "not_yet_unten" );

  AddItem(NPC "h_bestie", REFRESH_DESTRUCT);

  AddCmd( ({ "reiss", "reisse" }), "abreissen");
}

STDFUNC

int no_go(string dir)
{
  if(interactive(TP))
  {
    notify_fail(
      "Irgendein Zauber hindert Dich daran, nach "+CAP(dir)+" zu gehen.\n");
    return TP->move(ROOM "dorf_f10", M_GO, "nicht nach "+CAP(dir));
  }
  else
    return TP->move(ROOM "dorf_e10", M_GO, "nach Sueden");
}

string teppich()
{
  if(beule)
  {
    clone_object(OBJ "lunte")->move(TO, M_NOCHECK);
    beule = 0;
    return BS(
      "Du schlaegst den Teppich zurueck und entdeckst darunter ein "
      "kurzes Stueck einer Zuendschnur oder Lunte."); 
  }
  else
    return 
      "Du schlaegst den Teppich zurueck, aber findest nichts interessantes.\n";
}

reset()
{
  beule = 1; knubbel = 1;
  RemoveDetail( ({ "holzknubbel", "knubbel", "prachttreppe" }) );
  AddDetail( ({ "prachttreppe" }), BS( 
    "Die Prachttreppe ist mit Teppichen ausgelegt. An den Seiten " 
    "befindet sich ein glattes Gelaender, an dem man sicher schoen "
    "nach unten rutschen koennte, wenn da nicht am Ende ein grosser "
    "Holzknubbel befestigt waer.") );
  AddDetail( ({ "knubbel", "holzknubbel" }), BS(
    "Der Knubbel ist wirklich fies. Wenn er nicht da waere, koennte "
    "man so schoen vom Obergeschoss in die Halle rutschen. Vielleicht "
    "kann man ihn ja abreissen...") );
  ::reset();
}

int abreissen(string str)
{
  notify_fail("Was willst Du abreissen?\n");
  if(str != "knubbel ab" && str != "knubbel" && 
     str != "holzknubbel" && str != "holzknubbel ab") return 0;
  if(knubbel)
  {
    knubbel = 0;
    clone_object(OBJ "knubbel")->move(TO, M_NOCHECK);
    write(BS(
      "Du zerrst am Knubbel und reisst ihn schliesslich ab. Er faellt "
      "polternd zu Boden."));
    say(TP->Name()+" reisst den Knubbel vom Gelaender ab.\n");
    RemoveDetail( ({ "prachttreppe", "knubbel", "holzknubbel" }) );
    AddDetail( ({ "prachttreppe" }), BS( 
      "Die Prachttreppe ist mit Teppichen ausgelegt. An den Seiten " 
      "befindet sich ein glattes Gelaender, an dem man sicher schoen "
      "nach unten rutschen koennte."));
    return 1;
  
  }
  notify_fail("Der Knubbel wurde schon abgerissen.\n");
  return 0;
}

void flutsch(object rutscher)
{
  if(objectp(rutscher) && ENV(rutscher) == TO)  
  {
    if(knubbel)
    {
      tell_object(rutscher, BS(
        "Voller Schreck erkennst Du einen riesigen Holzknubbel am Ende "
        "des Gelaenders, auf den Du mit irrwitziger Geschwindigkeit "
        "zurast, ohne eine Moeglichkeit auszuweichen...")+
        "     Z  A  C  K  !\n");
      say(BS(
         rutscher->Name()+" knallt mit voller Wucht gegen den Holzknubbel "
         "am Ende des Gelaenders der Prachttreppe."),({rutscher}));
      SetProp(P_KILL_NAME, "Gelaenderrutschen");
      rutscher->do_damage(20+random(40));
    }
    else
    {
      tell_object(rutscher, BS(
        "Hui! Du hast so viel Zunder drauf, dass Du durch den Raum segelst "
        "und bei der Tuer hinausfliegst."));
      rutscher->move(ROOM "dorf_e10", M_GO, 
        "in hohem Bogen nach Sueden", "fliegt", 
        "kommt in hohem Bogen hereingeflogen");
    }
  }
}
