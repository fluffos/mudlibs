#include "../def.h"
#include "./knarkh.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

inherit "std/room";

#define MAX_THYMIAN 15
#define MAX_BLUMEN 10

int stiefmuetterchen, knochen, thymian;

create()
{
  ::create();

  thymian = MAX_THYMIAN;
  knochen = 1;
  stiefmuetterchen = MAX_BLUMEN;

  SetProp( P_INT_SHORT, "Hinterhof in Knarkh" );
  SetProp( P_INT_LONG, BS( 
    "Du befindest Dich in einem kleinen Hinterhof. Er dient dem Tempel "
    "dahinter anscheinend als Kraeutergarten. Mehrere Kraeuter- und "
    "Blumenbeete befinden sich hier. In der Mitte thront aber eine "
    "gewaltige Hundehuette. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "wand", "waende" }), BS(
    "Im Osten und Sueden siehst Du simple Holzwaende. In der Wand im Westen "
    "fuehrt ein Durchgang zur Strasse zurueck. Die Wand im Norden bildet "
    "die Rueckwand eines Tempels, den Du dort aufragen siehst.") );
  AddDetail( "himmel",
    "Vom Himmel brennt die Sonne herunter.\n" );
  AddDetail( "boden", 
    "Am Boden siehst Du mehrere Beete.\n" );
  AddDetail( "sonne", 
    "Sie brennt vom Himmel. Dir ist warm.\n" );
  AddDetail( ({ "holzwand", "holzwaende" }), 
    "Meinst Du die Ostwand oder die Suedwand?\n" );
  AddDetail( ({ "osten", "ostwand" }), 
    "Die Wand im Osten ist total kahl.\n" );
  AddDetail( ({ "sueden", "suedwand" }), 
    "Die Wand im Sueden ist total kahl. An der Wand lehnt eine Kiste.\n" );
  AddDetail( ({ "westwand", "westen" }), 
    "Die Westwand ist kahl. Ein Durchgang fuehrt hindurch.\n" );
  AddDetail( ({ "nordwand", "norden" }), 
    "Die Nordwand besteht aus moertellos zusammengefuegten Steinquadern.\n");
  AddDetail( ({ "durchgang" }), 
    "Der Durchgang fuehrt nach Westen auf die Strasse.\n" );
  AddDetail( ({ "steinquader" }), BS(
    "Sie sind ohne Moertel aneinandergefuegt. Es gibt keine Fugen, keine "
    "Risse dazwischen.") );
  AddDetail( ({ "riss", "risse" }), 
    "Du findest keine.\n" );
  AddDetail( ({ "fugen", "fuge" }), BS(
    "Du suchst jeden Quadratzentimeter Wand ab und entdeckst doch "
    "tatsaechlich eine kleine Fuge. Du versuchst, hindurchzusehen, kannst "
    "aber nur schemenhaft erkennen, dass in dem Tempel jemand betet.") );
  AddSound( ({ "fuge", "tempel", "wand", "beten" }), 
    "Du glaubst, einige Worte zu verstehen. \n"+
    "Sie lauten: \"DECOLA NIBBEL XI!\".\n" );
  AddDetail( ({ "tempel" }), BS(
    "Der dunkle Tempel zeichnet sich scharfkantig gegenueber dem hellen "
    "Himmel ab. Er besteht aus schwarzen Basaltquadern.") );
  AddDetail( ({ "stein", "basalt", "basaltquader" }), 
    "Schwarzer Basalt. Er wirkt unheimlich.\n" );
  AddDetail( ({ "hof", "hinterhof", "garten", "kraeutergarten" }), BS(
    "Rundherum sind Mauern. Am Boden siehst Du Beete. In der Mitte steht "
    "eine Hundehuette.") );
  AddDetail( ({ "mauer", "mauern" }), 
    "Mauern sind nur ein Synonym fuer Waende.\n" );
  AddDetail( "synonym", 
    "Sinnloses Detail. Du benutzt doch nicht etwa ein Script oder?\n" );
  AddDetail( ({ "script", "detail", "sinnloses" }), 
    "Hmm. Wenn Du eines der folgenden Woerter untersuchst, stirbst Du.\n"+ 
    "Hjk Jujuop Kirapfa Tzoooo\n");
  AddSpecialDetail( ({ "hjk", "jujuop", "kirapfa", "tzoooo" }), "scripttod" );
  AddDetail( ({ "beet", "beete" }), 
    "Welche Beete meinst Du? Die Kraeuterbeete oder die Blumenbeete?\n" );
  AddDetail( ({ "hundehuette", "huette" }), BS(
    "Die Huette beeindruckt durch ihre Ausmasse. Sie ist so gross, dass "
    "sogar ein Elf hineinkriechen koennte. Ein Zwerg koennte darin "
    "sogar aufrecht stehen. An der Vorderfront sind zwei dicke Eisenringe "
    "eingelassen, an denen noch Ueberreste zweier Ketten haengen. "
    "In einem Umkreis von etwa drei Metern um die Huette sind alle Pflanzen "
    "entwurzelt und die Beete zerstoert. Die Erde wurde aufgewuehlt.") );
  AddDetail( ({ "hund" }), 
    "Es ist anscheinend grad kein Hund da. Sei froh!\n" );
  AddDetail( "mitte",
    "Mitten im Hof steht eine Hundehuette.\n" );
  AddDetail( ({ "umkreis" }), 
    "Die Ketten an denen die Hunde angehaengt waren, liessen ihnen drei "+
    "Meter Auslauf.\n" );
  AddDetail( ({ "ketten", "kette", "ueberreste" }), 
    "Die Ketten wurden durch grosse Krafteinwirkung zerrissen.\n" );
  AddDetail( "erde", 
    "Die Erde wurde von den Hunden ueberall, wo sie hinkamen, "+ 
    "aufgewuehlt.\n" );
  AddDetail( ({ "eisenringe", "ringe", "eisenring" }), 
    "Die Ueberreste der Ketten haengen noch dran.\n" );
  AddDetail( "pflanzen", 
    "Viele Pflanzen wachsen hier. Vor allem Blumen und Kraeuter.\n" );
  AddDetail( ({ "kraeuterbeete", "kraeuterbeet", "kraeuter" }), BS(
    "Viele der Kraeuter sind Dir unbekannt. Du erkennst nur Thymian und "
    "Tausendgueldenkraut. Ausserdem ist da noch ein Strauch "
    "mit Tollkirschen."));
  AddDetail( "thymian",
    "Der Thymian verstroemt einen wuerzigen Duft. Man sagt ihm "+
    "Heilkraefte nach.\n" );
  AddSmell( "thymian",
    "Mmmmhh! Riecht wuerzig duftig. Du bekommst Hunger.\n" );
  AddDetail( "tausendgueldenkraut", 
    "Ein hohes Gewaechs mit schoenen rosa Blueten.\n" );
  AddDetail( ({ "bluete", "blueten" }), 
    "Die Blumen, wie auch viele der Kraeuter stehen teilweise in "+
    "voller Bluete.\n" );
  AddDetail( ({ "strauch", "tollkirsche", "tollkirschen", "beeren" }), BS(
    "Ein mannshoher Strauch voller Tollkirschen steht hier. Die Kirschen "
    "sind tiefschwarz wie der Basalt des Tempels. Da Du in der Schule gut "
    "aufgepasst hast, weisst Du, dass Tollkirschen sehr giftig sind.") );
  AddSmell( ({ "strauch", "tollkirsche", "tollkirschen", "beeren" }), 
    "Die Tollkirschen riechen leicht suesslich. Ein ekliger Geruch.\n" );
  AddDetail( ({ "blumen", "blumenbeete", "blumenbeet" }), BS( 
    "Die meisten Blumen hier sind Stiefmuetterchen. Man hat hier "
    "ausschliesslich dunkelrote gezuechtet.") );
  AddDetail( ({ "stiefmuetterchen" }), 
    "Sie sind von dunkelroter Farbe.\n" );
  AddSmell( ({ "stiefmuetterchen", "blumen", "blume" }), 
    "Die Stiefmuetterchen haben fast keinen Eigengeruch.\n" );
  AddSpecialDetail("kiste", "in_kiste");
  AddSmell(({"pflanzen", DEFAULT_SMELL}), 
    "Es riecht hier nach verschiedenen Pflanzen.\n");

  AddExit( "westen", "./dorf_f3.lpc" );
  
  AddCmd( ({"wuehle", "grabe"}), "graben" );
  AddCmd( ({"pflueck", "pfluecke"}), "pfluecken" );
  AddCmd( "iss", "bochum" );
  AddCmd("nimm", "nimm");
  AddCmd(({"steck", "stecke"}), "steck");

  AddItem(NPC "pitbull", REFRESH_DESTRUCT);
  AddItem(NPC "doberfrau", REFRESH_DESTRUCT);
}

STDFUNC

string in_kiste()
{
  int    i;
  string text;
  object *liste;
  
  text= "Die Kiste hat keinen Deckel, kann also nicht geschlossen werden. "+
        "Sie gehoert wohl dem Gaertner oder einem der Tempelpriester. ";
  call_other( ROOM "kiste", "???", 0);
  liste = all_inventory(find_object( ROOM "kiste"));
  if(!sizeof(liste))
    text +="Im Augenblick ist die Kiste leer";
  else
  {
    text += "Im Augenblick befindet sich Folgendes in der Kiste: ";
    if (sizeof(liste)==1)
      text += liste[0]->name(WER);
    else
      text += implode(map_objects(liste[0..<2], "name", WER), ", ")+
              " und "+liste[<1]->name(WER);
  }
  return BS(text+".");
}

int nimm(string str)
{
  string arg;
  object *liste, obj;
  int    i;
  
  if (!str) return 0;
  if (sscanf(str, "%s aus kiste", arg)!=1) return 0;
  
  call_other( ROOM "kiste", "???", 0);
  liste = all_inventory(find_object( ROOM "kiste"));
  for(i=(sizeof(liste))-1; i>=0;i--)
  {
    obj = liste[i];
    if (member(obj->QueryProp(P_IDS), arg)!=-1)
    {
      if (obj->move(TP)==ME_TOO_HEAVY)
      {
        write("Du kannst "+obj->name(WEN)+" nicht mehr tragen.\n");
        obj->move( ENV(TP) );
      }
      else
        write("Du nimmst "+obj->name(WEN)+" aus der Kiste.\n");
      say(TPN+" nimmt "+obj->name(WEN)+" aus der Kiste.\n");
      return 1;  // nur einmal nehmen
    }
  }
  return 0;
}

int steck(string str)
{
  string arg;
  object store, obj;
  int    i;
  
  if (!str) return 0;
  if (sscanf(str, "%s in kiste", arg)!=1) return 0; 
  call_other( ROOM "kiste", "???", 0);
  store = find_object( ROOM "kiste");
  if (obj = present(arg, TP))
  {
      write("Du steckst "+obj->name(WEN)+" in die Kiste.\n");
      say(TPN+" steckt "+obj->name(WEN)+" in die Kiste.\n");
      obj->move(store, M_PUT);
  }
  else
    write(CAP(arg)+"? Sowas hast Du gar nicht dabei.\n");
  return 1;
}

string scripttod()
{
  SetProp(P_KILL_NAME, "Ein schrecklicher Scripttod");
  write("Du elender Scripter! STIRB! STIRB! STIRB!\n");
  TP->die();
  return "";
}

int pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if(!str) return 0;

  if(member( ({"blume", "blumen", "stiefmuetterchen"}), str) > -1)
  {
    if(0 < stiefmuetterchen--)
    {
      write("Du pflueckst eines der dunkelroten Stiefmuetterchen.\n");
      say(TPN + " pflueckt ein dunkelrotes Stiefmuetterchen.\n");
      clone_object(OBJ "stiefmutter")->move(TP, M_NOCHECK);
    }
    else
      write("Es sind zur Zeit keine pflueckbaren Stiefmuetterchen da.\n");
    return 1;
  }
  return 0;
}

int bochum(string str)
{
  notify_fail("Was willst Du essen?\n");
  if(!str) return 0;

  if(member( ({"tollkirsche", "kirsche", "tollkirschen", "beere", "beeren"}),
     str) > -1 )
  {
    write(BS( "Du pflueckst eine von den saftigen Tollkirschen und "
      "steckst sie sogleich in den Mund. Zuerst schmeckt sie klebrig "
      "suess. Fast schmeckt sie Dir sogar. Aber nach wenigen Sekunden "
      "setzt eine grosse Uebelkeit bei Dir ein. Du stellst fest, dass "
      "Du Dich soeben selber vergiftet hast. Das war wirklich eine "
      "tolle Idee, die Tollkirsche zu essen, "+TPN+"!") );
    say(TPN+" pflueckt eine Tollkirsche und isst sie.\n");
    TP->SetProp(P_POISON, TP->QueryProp(P_POISON) + 6);
    TP->reduce_hit_point(10 + random(10));
    return 1;
  }

  if(str == "thymian")
  {
    if(0 < thymian--)
    {
      write(BS( "Du reisst ein paar Thymianblaetter ab und steckst sie "
        "Dir in den Mund. Sofort durchstroemen Dich Wellen der Heilung. "
        "Deine Lebensenergie hat sich erhoeht.") );
      say(TPN+" isst etwas Thyimian und sieht danach erfrischt aus.\n");
      TP->reduce_hit_point( -15 -random(10));
    }
    else
    {
       write("Es ist leider nicht mehr genug Thymian uebrig.\n");
    }
    return 1;
  }

  if(str == "tausendgueldenkraut")
  {
    write("Iiiiiih! Schmeckt das bitter! Du musst Dich beinahe uebergeben.\n");
    say(BS(TPN+" kostet etwas vom Tausendgueldenkraut und macht ein "
       "angeekeltes Gesicht."));
    return 1;
  }

  return 0;
}

int graben(string str)
{
  notify_fail("Wo willst Du graben?\n");
  if (!str) return 0;
  if (str != "in erde" && str != "erde") return 0;
  
  if(knochen)
  {
    write(BS( "Du wuehlst in der Erde herum und legst einen Knochen frei, "
      "den die Hunde anscheinend hier vergraben haben.") );
    say(TPN+ " wuehlt in der Erde herum und findet einen Knochen.\n");
    clone_object(OBJ "knochen")->move(ENV(TP), M_NOCHECK);
    knochen = 0;
  }
  else
  {
    write("Du wuehlst in der Erde herum, machst Dir aber nur die Haende "+
      "schmutzig.\n");
    say(TPN + " wuehlt in der Erde herum.\n");
  }
  return 1;
}

reset()
{
  ::reset();
  thymian = MAX_THYMIAN;
  knochen = 1;
  stiefmuetterchen = MAX_BLUMEN;
}
