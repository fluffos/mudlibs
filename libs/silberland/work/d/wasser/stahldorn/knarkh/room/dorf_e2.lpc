#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG + 
   "Die Gasse fuehrt schnurstracks weiter. Auf eine der Waende hat jemand "
   "eine Parole gemalt. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS

  AddDetail( ({ "wand", "waende", "aussenwaende", "aussenwand", "hauswand" }), 
     BS(
    "Auf einer der Aussenwaende der Haeuser um Dich herum hat jemand eine "
    "Parole geschmiert."));
  AddDetail( ({ "haus", "haeuser", "huetten", "huette" }), BS(
    "Die Gasse fuehrt an ein paar Haeusern vorbei, die Du aber von hier aus "
    "nicht betreten kannst."));
  AddDetail( ({ "parole" }),
    "Mit roter Farbe wurde sie auf eine Hauswand geschmiert. Du kannst sie "+
    "lesen.\n");
  AddReadDetail( ({ "parole" }),
    "   Nieder mit Midas!  Tod den Kampfsoldaten! \n");
  AddDetail( ({ "gasse" }),
    "Sie fuehrt zwischen den Haeusern hindurch.\n");
//  AddDetail( ({ "" }),
//    "");

  AddExit( "nordwesten", ROOM "dorf_f1.lpc" );
  AddExit( "suedosten", ROOM "dorf_d3.lpc" );

}

STDFUNC

