#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dorf Knarkh" );
  SetProp( P_INT_LONG, BS( STANDARDLANG 
    "Die Gasse endet hier vor einem dunklen, tempelartigen Gebaeude. "
    "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

DORFDETAILS
DORFSMELLS
DORFSOUNDS


  AddDetail( ({ "gebaeude", "tempel" }), 
     "Es scheint sich bei dem Gebaeude von der Form her um einen Tempel "
     "zu handeln. Er ist vollstaendig aus schwarzen Steinen erbaut und hebt "
     "sich wuchtig gegen den Himmel ab. Du befindest Dich hier anscheinend "
     "am Hintereingang.");
  AddDetail( ({ "eingang", "hintereingang" }), 
     "Eine kleine Holztuer fuehrt in den Tempel.\n");
  AddDetail( ({ "steine" }), 
     "Die Steine, aus denen der Tempel erbaut ist, sind pechschwarz.\n");
  AddDetail( ({ "wand", "waende", "tempelwand" }), 
     "An der Tempelwand stehen Muelltonnen herum.\n");
  AddDetail( ({ "tonnen", "muelltonnen", "muelltonne", "tonne" }), 
     "Die Muelltonnen sind mit allerlei Muell gefuellt.\n");
  AddSmell( ({ "tonnen", "muelltonnen", "muelltonne", "tonne" }), 
     "Die Muelltonnen stinken penetrant nach Abfall.\n");
  AddDetail( ({ "muell", "abfall" }), 
     "Du durchwuehlst den Muell und kommst Dir etwas bloed vor dabei.\n");
  AddSmell( ({ "muell", "abfall" }), 
     "Der Muell stinkt.\n");
  AddSmell( DEFAULT_SMELL, 
     "Es stinkt hier nach Abfall.\n");
  AddDetail( ({ "gasse", "seitengasse" }), 
     "Die Gasse endet hier vor einem Tempel.\n");
  AddDetail( ({ "form" }), 
     "Naja, das Gebaeude ist halt so... tempelfoermig.\n");

//  AddDetail( ({ "" }), 
//     "");

  NewDoor("nordosten", ROOM "tempel", ({"tuer", "holztuer", "hintertuer"}), 
     ({D_FLAGS, DOOR_RESET_CL, 
       D_NAME, "Tuer",
       D_GENDER, FEMALE, 
       D_SHORT, "Eine kleine Tuer fuehrt in den Tempel. Sie ist %s.",
       D_LONG, "Eine kleine Holztuer.\n", 
       D_FUNC2, "zuschnapp"}));

  AddExit( "nordwesten", ROOM "dorf_h2.lpc");

}


STDFUNC

zuschnapp()
{
//   _close_door("tuer");
  call_other(DOOR_MASTER, "SetDoorStatus", ROOM "dorf_g3", -1);
  write("Die Holztuer faellt hinter Dir zu.\n");
  say("Die Holztuer faellt hinter "+TP->name(WEM)+" zu.\n");
}
