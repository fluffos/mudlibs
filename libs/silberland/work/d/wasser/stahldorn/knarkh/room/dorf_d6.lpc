#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Plaza in Knarkh" );
  SetProp( P_INT_LONG, BS( PLAZALANG "Sonst gibts hier nix besonderes. " 
     "@@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

PLAZADETAILS
DORFSMELLS
DORFSOUNDS

  AddExit( "norden", "./dorf_e6.lpc" );
  AddExit( "nordwesten", "./dorf_e5.lpc" );
  AddExit( "westen", "./dorf_d5.lpc" );
  AddExit( "suedwesten", "./dorf_c5.lpc" );
  AddExit( "sueden", "./dorf_c6.lpc" );

}

STDFUNC

