#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Dobbokeller" );
  SetProp( P_INT_LONG, BS(
    "Der Kellergang endet hier ploetzlich vor drei breiten Portalen. "
    "Die unheimliche Finsternis, die von den Portalen ausgeht, verschlaegt "
    "Dir den Atem. Hier muss etwas furchtbar Boeses lauern.")  );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_CAVE]) );
  
  AddDetail( ({ "keller", "gang", "kellergang" }), 
    "Der Gang fuehrt nach Sueden in die Dunkelheit zurueck.\n" );
  AddDetail( ({ "boden" }), 
    "Der Boden ist voller uraltem Staub.\n" );
  AddDetail( ({ "wand", "waende" }), 
    "Die Waende bestehen aus kaltem Felsgestein.\n" );
  AddDetail( ({ "fels", "stein", "gestein", "felsgestein" }), 
    "Dieser Gang wurde direkt in das Gestein getrieben.\n" );
  AddDetail( ({ "schatten", "finsternis", "dunkelheit" }), BS(
    "Die Finsternis lauert ueberall auf Dich und weicht nur widerwillig "
    "zurueck. Jedesmal, wenn Du Deine Aufmerksamkeit in eine Richtung "
    "lenkst, erobern die Schatten alles, worauf Du nicht blickst, zurueck. " 
    "Aus den Augenwinkeln siehst Du sie vorueberhuschen.") );
  AddDetail( ({ "staub", "woelkchen" }), BS(
    "Du watest in Staub. Mit jedem Schritt wirbelst Du kleine Woelkchen "
    "davon, die Dir in den Augen brennen und Dir die Atemluft rauben.") );
  AddDetail( ({ "decke" }), BS(
    "Die Decke ist hier nur noch etwas ueber zwei Meter hoch.\n") );
  AddSmell( ({ DEFAULT_SMELL }), 
    "Es riecht modrig und muffig hier unten.\n" );
  AddSound( ({ DEFAULT_SOUND }), BS(
    "Ein droehnendes, pulsierendes, pochendes, haemmerndes Geraeusch "
    "erfuellt bruellend den Raum und laesst Deine Eingeweide vibrieren.") );
  AddSound( ({ "geraeusch", "pochen" }), 
    "Es droehnt sehr laut. Du kannst den Ursprung nicht lokalisieren.\n" );
  AddDetail( ({ "portale", "portal", "tor", "tore" }), BS(
    "Drei Portale befinden sich hier in den Waenden. Ueber jedem Portal "
    "erkennst Du eine Inschrift.") );
  AddDetail( ({ "inschriften", "inschrift" }), BS(
    "Die Inschriften sind tief ins Gestein gegraben, sodass man sie noch "
    "gut lesen kann.") );
  AddReadDetail( ({ "inschrift", "inschriften" }), 
    "Welche Inschrift willst Du lesen? \n"
    "  (lies inschrift <nr>)\n" );
  AddReadDetail( "inschrift 1" , 
    "  'Tor der Vernichtung'\n" );
  AddReadDetail( "inschrift 2" , 
    "  'Tor der Verdammnis'\n" );
  AddReadDetail( "inschrift 3" , 
    "  'Tor der Verzweiflung'\n" );
  AddDetail( ({ "verzweiflung", "tor 3", "portal 3" }), 
    "Hinter diesem Tor gibt es keine Hoffnung mehr.\n" );
  AddDetail( ({ "vernichtung", "tor 1", "portal 1" }), 
    "Dieses Tor zu durchschreiten, koennte Deine Vernichtung bedeuten.\n" );
  AddDetail( ({ "tor der verdammnis", "tor 2", "portal 2" }), 
    "Vielleicht ist dies der Weg zur ewigen Verdammnis.\n" );
  AddDetail( ({ "ursprung" }), 
    "Der Ursprung des Pochens liegt wohl hinter den Toren.\n");

//  AddDetail( ({ "" }), 
//    "");

  AddExit("sueden", ROOM "gang2");
  AddExit("zwei", "/d/unterwelt/stahldorn/dammnis/room/dam_c4");
  AddSpecialExit("eins", "portal_one");
  AddSpecialExit( ({ "drei" }), "no_go");
}

int portal_one()
{
  write(break_string(
    "Mit einem mulmigen Gefuehl durchschreitest Du das Portal zur "
    "Vernichtung."));
  this_player()->move("/d/unterwelt/vernichtung/eingang",M_GO|M_SILENT);
  return 1;
}

int no_go()
{
  write ("Deine Angst verhindert das Durchschreiten dieses Portales.\n"
    "(Ausserdem ist das, was dahinter liegt, noch nicht angeschlossen.)\n");
  return 1;
}
