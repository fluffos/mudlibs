#include "../def.h"
#include "./knarkh.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Steg in Knarkh" );
  SetProp( P_INT_LONG, BS( 
    "Du stehst am Ende des Stegs in Knarkh. "
    "Hie und da legt ein Piratenschiff hier an. Sonst ist wenig los, "
    "ausser dem ueblichen Gesindel, das hier herumlungert, und dem Du nicht "
    "zu nahe kommen solltest. @@gut_boes@@" ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );

AddDetail( ({ "gesindel", "abschaum" }), BS(
   "Die gleichen Typen wie im Rest von Knarkh. Abschaum.") );
AddDetail( ({ "boden", "planken", "holzplanken", "steg" }), BS(
   "Der Boden besteht aus rohen Holzplanken. Die Abstaende dazwischen sind "
   "so gross, dass man das Meer darunter sehen kann.") );
AddDetail( ({ "himmel", "sonne" }), BS(
   "Vom Himmel brennt die Sonne herab.") );
AddDetail( ({ "meer", "sueden", "ferne" }), BS(
   "Das Meer erstreckt sich weit nach Sueden. In der Ferne glaubst Du "
   "die Umrisse einer Insel ausmachen zu koennen.") );
AddDetail( ({ "umrisse", "insel" }), BS(
   "Sie ist zu weit weg, um sie identifizieren zu koennen.") );
AddDetail( ({ "wasser" }), BS(
   "Das Wasser ist brackig und braun.") );
AddDetail( ({ "wellen", "welle" }), BS(
   "Die Wellen platschen gegen den Steg.") );
AddDetail( ({ "abstaende" }), BS(
   "Die Abstaende zwischen den Holzplanken sind unterschiedlich gross.") );


  AddExit( "norden", "./dorf_b7.lpc" );
  AddItem( NPC "knarkhist", REFRESH_DESTRUCT);
  AddItem( OBJ "piratenschiff", REFRESH_DESTRUCT, 1);

}

STDFUNC


init()
{
  ::init();

  if(interactive(TP))
    call_out("levelcheck", 0);
}

levelcheck()
{
  if (TP && TP->QueryProp(P_GHOST))
  {
    tell_object(TP, "\nDu bist ja ein Geist! Komm, geh erstmal beten!\n\n");
    TP->move("/d/ebene/Midas/room/kapelle", M_TPORT, "aus Knarkh", 
          "verschwindet", "wird hereingebeten");
    return;
  }

  if (TP && (TP->QueryProp(P_LEVEL) < 15))
  {
    tell_object(TP, BS(
        "Als Du das Schiff verlaesst, erstarrst "
        "Du vor Schreck. Ein bestialischer Gestank beisst Dir in die Nase "
        "und die Luft ist erfuellt von den unheimlichen Schreien gepeinigter "
        "Opfer. Du beschliesst, lieber das Wagnis noch nicht einzugehen, "
        "Knarkh zu betreten, und kehrst leise wieder um. "
        "Vielleicht bist Du stark genug, wenn Du Level 15 erreicht hast.") );
    TP->move(OBJ "piratenschiff", M_NO_SHOW|M_TPORT, "aus Knarkh", 
             "fluechtet entsetzt", "rennt hysterisch schreiend herein");
  }

}
