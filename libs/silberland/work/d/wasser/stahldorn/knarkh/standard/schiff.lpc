// /d/dschungel/feyaria/schiff.c
// Schablone fuer Schiffe
// 27-10-96  Feyaria@SilberLand

inherit "std/transport";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Schiff" );
  SetProp( P_INT_LONG, BS(
    "Du stehts auf einem Schiff.") );
  SetProp( P_SHORT, "Ein Schiff" );
  SetProp( P_LONG, BS(
    "Du siehst ein Schiff.") );
  SetProp( P_NAME, "Schiff" );
  AddId( ({ "schiff" }) );
  SetProp( P_GENDER, NEUTER );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);

  AddDetail( "schiff", BS(
    "Du stehst auf einem Schiff.") );
  
  SetProp( P_DEPARTMSG, ({
    "Das Schiff legt ab.\n", 
    "Das Schiff legt ab.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Das Schiff legt im Hafen von @@QueryArrived@@ an.\n",
    "Das Schiff legt im Hafen an.\n"}) );
    
  SetProp( P_ENTERMSG, ({
    "besteigt das Schiff",
    "kommt auf das Schiff"}) );
  SetProp( P_ENTERFAIL, ({
    "Es passen nur 5 Passagiere auf das Schiff",
    "hat keinen Platz mehr auf dem Schiff"}) );
  SetProp( P_MAX_PASSENGERS, 5 );

  SetProp( P_LEAVEMSG, ({
    "verlaest das Schiff",
    "kommt vom Schiff herunter"}) );
  SetProp( P_LEAVEFAIL, ({
    "Das Schiff befindet sich doch auf hoher See",
    "wollte das Schiff auf hoher See verlassen"}) );

  /* Verben */
  AddCmd( ({ "betrete", "betritt" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  /* Kurs */
  AddRoute( "pfad/hafen1", 30, 20, "Hafen1" );
  AddMsg( "Das Schiff segelt in Richtung Hafen2.\n", 30 );
  AddMsg( "Das Schiff naehert sich Hafen2.\n", 10 );
  AddRoute( "pfad/hafen2", 30, 20, "Hafen2" );
  AddMsg( "Das Schiff segelt in Richtung Hafen2.\n", 30 );
  AddMsg( "Das Schiff naehert sich Hafen2.\n", 10 );
 	
  Start();
}

rein(str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

raus(str)
{
  notify_fail("Was willst Du verlassen?\n");
  if( str && id(str) )
    return Leave();
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( "pfad/hafen1", "???"));
    catch(call_other( "pfad/hafen2", "???"));
  }
}
