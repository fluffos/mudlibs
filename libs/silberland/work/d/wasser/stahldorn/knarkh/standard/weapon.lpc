#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "");
  SetProp(P_LONG, BS( 
    "") );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId( ({"", ""}) );

  SetProp(P_WEAPON_TYPE, WT_ );
  SetProp(P_WC, 1);
  SetProp(P_DAM_TYPE, DT_ );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_ );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

}

int WieldFunc(object waffe)
{
  return 0;
}

int UnwieldFunc(object waffe)
{
  return 1;
}

int HitFunc( object enemy )
{
  if( enemy->id("bestimmter_npc")
    return 10; // WC-Steigerung um 10
  return 0;
}
