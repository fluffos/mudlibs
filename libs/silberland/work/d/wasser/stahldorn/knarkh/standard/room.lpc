#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG, BS(
    "") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15]) );

  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");
    
  AddSmell( DEFAULT_SMELL,
    "");

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "tue" }), "command" );

  AddItem( "item" , REFRESH_REMOVE);

  AddExit( "norden", "nach Norden#" + "./room2" );
}

command(string str )
{
  notify_fail( "Was willst Du tun?\n" );
  if( str == "tuer" )
  {
    write("Du tust etwas.\n");
    say( PLN+" tut etwas.\n");
    return 1;
  }
  return 0;
}
