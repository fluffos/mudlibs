#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "");
  SetProp(P_LONG, BS( 
    "") );
  SetProp(P_INFO, "");
  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId("");

  SetProp(P_MATERIAL, MAT_ );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);

}
