inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine agressive Doberfrau");
  SetProp(P_LONG, BS(
    "Vor Dir steht ein boese dreinschauendes Dobermannweibchen. Die "
    "Lefzen sind halbgeoeffnet und man kann die angsteinfloessenden Zaehne "
    "erkennen. Speichel tropft ihr aus dem Mund auf den Boden. Sie wittert "
    "Deine Angst..."));
  SetProp(P_NAME, "Doberfrau");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "doberfrau", "hund"}));

  create_default_npc(14);
  // P_LEVEL   = x
  // P_SP/P_HP = (10+ x*x)    = 206
  // P_HANDS   = x*10         = 140
  // P_BODY    = x*4          = 56 
  // P_XP      = HP*HANDS*5   = 
  SetProp(P_HANDS, ({ " mit ihren Zaehnen",190,DT_PIERCE}));
  SetProp(P_XP, 180000);
  SetProp(P_BODY, 30);
  SetProp(P_MAX_HP, 120);
  SetProp(P_RACE, "Hund");
  SetProp(P_SIZE, 80);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN, "rennt herein");
  SetProp(P_MSGOUT, "rennt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "knurrt Dich an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hund nimmt nichts an. Danke.\n" }) );

  SUID;
  CLONEME(ARMOUR "stachelband" );
  command("trage alles");
}


Attack(object enemy)
{
  object korb;


  if(!korb =  present("\nMaulkorb", TO))
    ::Attack(enemy);
  else
  {
    tell_object(enemy, 
      "Die Doberfrau versucht Dich zu beissen, wird aber durch den Maulkorb "+
      "gehindert.\n");
    tell_room(MENV, "Die Doberfrau versucht vergeblich, "
      +enemy->name(WEN)+ " zu beissen.\n", ({enemy}));
    if(!random(15)) 
    {
      tell_object(enemy, 
         "Die Doberfrau schafft es, den Maulkorb zu zerfetzen.\n");
      korb->remove();
    }
  }
}
