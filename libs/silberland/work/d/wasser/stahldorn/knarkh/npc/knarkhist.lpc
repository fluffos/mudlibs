inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../def.h"

void create()
{
  object money;
  string rasse;
  int rand;

  if (!is_clone(TO)) return;
  ::create();

  rand = random(12);
  switch (rand)
  {
    case 0..3 : rasse = "Ork"; break;
    case 4..7 : rasse = "Gaffo"; break;
    case 8..9 : rasse = "Oger"; break;
    case 10..11 : rasse = "Troll"; break;
  }

  SetProp(P_SHORT, "Ein "+ rasse+ "-Knarkhist");
  SetProp(P_LONG, BS(
    "Der typische "+ rasse +", der vor Dir steht, sieht Dich aus "
    "boesen und hinterlistigen Augen an. Anhand seiner Ruestung und dem "
    "Knarkhisten-Emblem ist er relativ leicht als Mitglied der Waechtertruppe "
    "von Knarkh zu erkennen."));
  SetProp(P_NAME, "Knarkhist");
  SetProp(P_GENDER, MALE);
  AddId(({ LOWER(rasse), "knarkhist"}));

  create_default_npc(16);
  // P_LEVEL   = x = 16
  // P_SP/P_HP = (10+ x*x)    = 266
  // P_HANDS   = x*10         = 160
  // P_BODY    = x*4          = 64
  // P_XP      = HP*HANDS*5   = 
  SetProp(P_ATTRIBUTES, ([ A_DEX:16, A_STR:20, A_INT:16, A_CON:16 ]) );

  SetProp(P_HANDS, ({" mit stinkenden "+ rasse +"fingern",150,DT_BLUDGEON}));
  SetProp(P_XP, 200000);
  SetProp(P_MAX_HP, 200);
  SetProp(P_RACE, rasse);
  if (rand < 8)
     SetProp(P_SIZE, 165 + random(30));
  else
     SetProp(P_SIZE, 300 + random(60));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,40);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "grunzt boese.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Knarkhist sagt: Danke, aber das reicht noch lange nicht.\n" }) );

  SetProp(P_SPELLRATE, 20);
  AddSpell(2,100,
    "Der Knarkhist rempelt Dich um.\n",
    "Der Knarkhist rempelt @WEN um.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,200,
    "Der Knarkhist haut Dir eine runter.\n",
    "Der Knarkhist haut @WEM eine runter.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,150,
    "Der Knarkhist versucht, Dir einen Kopfstoss zu versetzen.\n",
    "Der Knarkhist versucht, @WEM einen Kopfstoss zu versetzen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SUID;
  if (rand < 8)
  {
    if (random (2)) CLONEME(WEAPON "knarkhschwert2" );
    else 
    {
      CLONEME(WEAPON "knarkhschwert1" );  
      if (random(2)) CLONEME(ARMOUR "knarkhschild" );
    }
    CLONEME(ARMOUR "emblem" );
    if (random(3)) CLONEME(ARMOUR "knarkhpanzer" );
    if (!random(3)) CLONEME(ARMOUR "knarkhhelm" );
    if (!random(3)) CLONEME(ARMOUR "knarkhstiefel" );
    if (!random(15)) CLONEME(ARMOUR "zahnschutz" ); 
    if (!random(3)) CLONEME(ARMOUR "knarkhhose" );

    money = CLONEOB ("/obj/money");
    money->SetProp(P_AMOUNT, 50+random(100));
    money->move(ME);
  }
  else
  {
    if(random(4)) 
    {
      if (random(2)) CLONEME(WEAPON "keule");
      else CLONEME(WEAPON "axt");
    }
    if(random(3)) CLONEME(ARMOUR "lendenschurz");
  }
  command ("zuecke axt");
  command ("zuecke keule");
  command ("zuecke schwert");
  command("trage alles");
}


void init()
{
    ::init();
    if (TP->QueryProp(P_ALIGN) > 200 && !IS_LEARNING(TP))
    {
	tell_room (MENV, 
	       "Der Knarkhist bruellt: Ah! Ein Eindringling von den Guten!\n"+
	       "Der Knarkhist bruellt: Du bist sicher ein Spion! Stirb!\n");
	Kill(TP);
    }
}


int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  int i;
  for(i=1; present("knarkhist " + i) ;i++)
  {
     present("knarkhist " + i)->Kill(enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);
  
}

void Attack(object enemy)
{
  if(objectp(enemy) && enemy->Name()=="Jemand")
  {
    say("Der Knarkhist schaut sich verwundert um.\n");
    enemy->StopHuntFor(TO, 1);
    StopHuntFor(enemy, 1);
    return;
  }
  ::Attack(enemy);
}
