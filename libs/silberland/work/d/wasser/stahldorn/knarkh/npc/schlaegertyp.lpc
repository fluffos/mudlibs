
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schlaegertyp");
  SetProp(P_LONG, BS(
    "Der Schlaegertyp vor Dir lungert laessig an einem der Tische. "
    "Hin und wieder schaut er von seinem Bierkrug auf und mustert "
    "eingehend die Gaeste hier in der Kneipe. So richtig geheuer ist er "
    "Dir jedenfalls nicht. ") );
  SetProp(P_NAME, "Schlaegertyp");
  SetProp(P_GENDER, MALE);
  AddId(({"typ", "schlaegertyp", "\nschlaegertyp"}));
  SetProp(P_SMELL, "Er stinkt nach Bier und billigem Fusel..\n");

  create_default_npc(13);
  // P_LEVEL   = x = 13
  // P_SP/P_HP = (10+ x*x)    = 179
  // P_HANDS   = x*10         = 130
  // P_BODY    = x*4          = 52
  // P_XP      = HP*HANDS*5   = 116350

  SetProp(P_HANDS, ({" mit harten Faeusten",160,DT_BLUDGEON}));
  SetProp(P_BODY, 30);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170 + random(30));
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "setzt sich an einen Tisch");
  SetProp(P_MSGOUT, "steht auf und geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "Was willst Du, Du kleiner Stinker?\n", "bruellt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Schlaegertyp bestellt sich was auf Deine Kosten.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(1,150,
    "Der Schlaegertyp verpasst Dir einen rechten Haken.\n",
    "Der Schlaegertyp verpasst @WEM einen rechten Haken.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,200,
    "Der Schlaegertyp verpasst Dir einen Handkantenschlag.\n",
    "Der Schlaegertyp verpasst @WEM einen Handkantenschlag.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
  "Ein Schlaegertyp rempelt Dich an.\n",
  "Ein Schlaegertyp sagt: He Du! Gib mir eine Zigarette!\n",
  "Ein Schlaegertyp ruepelt einen friedlichen Gast der Kneipe an.\n",
  "Ein Schlaegertyp bruellt: Suchst Du Stunk?\n",
  "Ein Schlaegertyp schmettert sein Bierglas in eine Ecke.\n",
  "Ein Schlaegertyp bricht einen Streit vom Zaun.\n",
  "Ein Schlaegertyp ruelpst unanstaendig.\n",
  "Beim Anblick der Schlaegertypen hier wird Dir mulmig.\n",
  "Der Schlaegertyp packt seinen Saufkumpan am Kragen.\n",
  "Der Schlaegertyp trinkt sein Bier leer und bestellt ein neues.\n",
  "Ein Schlaegertyp groehlt herum.\n", //groelt -> groehlt //Malar Nov 2004
  "Der Schlaegertyp kotzt in die Ecke.\n"}) );

//  SetAttackChats(10, ({
//  ".\n"}) );

}


schlaegern()
{
  object *leute;
  int chosen;
  leute=filter_array(all_inventory(environment(TO)), #'living) - ({TO});

  if (!sizeof(leute))
    return;                     // bugfix, woody, 2003-04-24

  chosen=random(sizeof(leute));
  say ("Der Schlaegertyp faengt eine Schlaegerei mit "+
    leute[chosen]->name(WEM) +" an.\n");
  TO->Kill(leute[chosen]);
}

init()
{

  if (random(12) == 4)
  {
//    DB("SCHLAEGERN\n");
    remove_call_out("schlaegern");
    say("Die Atmosphaere ist besonders gespannt heute.\n");
    call_out("schlaegern", 5);
  }
  ::init();
}

