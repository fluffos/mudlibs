inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein eifriger Laborassistent");
  SetProp(P_LONG, BS(
    "Der Laborassistent steht hier bloed herum und tut eigentlich gar nix."));
  SetProp(P_NAME, "Laborassistent");
  SetProp(P_GENDER, MALE);
  AddId(({"assistent", "laborassistent"}));

  create_default_npc(15);

  SetProp(P_HANDS, ({" mit dreckigen Saeurehaenden",200,DT_ACID}));
  SetProp(P_XP, 400000);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_FIRE:-0.2 ])); 

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein fieser Laborassistent");

  AddInfo(DEFAULT_INFO, "ist zu sehr in sein Nichtstun vertieft.\n");
  AddInfo("stahldorn", "Stahldorn hat mich erschaffen.","sagt: ");
  AddInfo( ({"dobbodox", "chef"}), "Das ist mein Chef. Der motzt dauernd.", 
    "sagt: ");
  AddInfo("knarkh", "Ach, is mir doch egal. Ich komm nie in die Stadt wegen "
     "dem bloeden Job hier.", "sagt: ");
  AddInfo(({"wasserhahn", "hahn"}), "Versuch mal, kannst Du ihn zudrehen?", 
     "sagt: ");
  AddInfo( ({"wasser", "tropfen" }), "Es tropft und tropft und tropft!\n", 
    "sagt: ");
  AddInfo(({ "stadt" }), "Da war ich schon seit Wochen nicht mehr. Dauernd "
     "hab ich hier im Labor zu tun.", "sagt: ");
  AddInfo(({ "arbeit", "job", "labor" }), 
     "Ach, wir machen hier nur ein paar Experimente. Das heisst, Dobbodox "
     "macht sie. Ich darf hoechstens zusehen und nachher das Blut aufwischen "
     "*seufz*. Dabei wuerd ich soooo gern mal versuchsweise einen Menschen "
     "mit einer Heuschrecke kreuzen oder sowas. *traeum*", "sagt: ");
  AddInfo(({ "experimente" }), 
     "Och nichts besonderes. Vivisektionen, Genmanipulationen am lebenden "
     "Objekt, Schmerztests, Verstuemmelungsrituale... Das uebliche halt.", 
     "sagt: ");
  AddInfo(({ "mensch", "heuschrecke" }), 
     "Ach, Rohmaterial hab ich genug. Danke.", "sagt: ");
  AddInfo(({ "rohmaterial" }), 
     "Das laeuft oben frei herum. Manchmal wehrt es sich, aber dann haut man "
     "man halt nochmal drauf.", "sagt: ");
  AddInfo(({ "blut", "flecken" }), 
     "Blut macht so klebrige Flecken. Interessant wirds, wenn das Blut mehr "
     "als drei Wochen eingetrocknet ist. Dann wird es naemlich ganz schwarz. "
     "Und eine Woche spaeter beginnt sich da drin was zu bewegen... ", 
     "sagt: ");
  AddInfo(({"tests", "vivisektionen", "genmanipulationen", "manipulationen", 
             "schmerztests" }), 
     "Hmm. Wenn Du Dich so dafuer interessierst, dann kann ich ja Dobbodox "
     "fragen, ob er ein paar davon an Dir durchfuehren will.", "sagt: ");
  AddInfo(({ "tisch", "schlaufen" }), 
     "An den Schlaufen am Tisch binden wir unkooperatives Rohmaterial fest.", 
     "sagt: ");
  AddInfo(({"assistent", "assistenten", "laborassistent", "laborassistenten"}), 
     "Wen meinst Du? Ich bin der einzige Assistent vom Chef.", "sagt: ");
  AddInfo(({ "" }), 
     "", "sagt: ");
  AddInfo(({ "" }), 
     "", "sagt: ");

//  AddInfo(({ "" }), 
//     "", "sagt: ");

//  SetProp(P_LOG_INFO, 1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Laborassistent will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,800,
    "Der Laborassistent schuettet Dir Saeure ins Gesicht.\n",
    "Der Laborassistent schuettet @WEM Saeure ins Gesicht.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
    "Der Laborassistent mixt etwas zusammen und laesst Dich kosten.\n",
    " \b@WER kostet von einer ungesunden Fluessigkeit.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
  "Der Laborassistent haelt sich die Ohren zu.\n", 
  "Der Laborassistent seufzt.\n", 
  "Der Laborassistent schaut in die Luft.\n", 
  "Der Laborassistent ruettelt wie wild am Wasserhahn.\n", 
  "Der Laborassistent sagt: Der Wasserhahn muesste mal repariert werden.\n", 
  "Der Laborassistent sagt: Also dieses Tropfen macht mich noch wahnsinnig.\n"}) );

//  SUID;
 // CLONEME(WEAPON "" );
 // command("zuecke waffe");
 // CLONEME(ARMOUR "" );
 // command("trage alles");
}

