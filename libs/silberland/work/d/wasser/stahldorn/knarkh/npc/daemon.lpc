inherit "std/npc";
inherit "std/player/soul";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../def.h"

#define P_HAS_DEMON "has_demon"

object master;
string taufname;
int zeit = 3;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  taufname = "";
  SetProp(P_SHORT, "Ein schrecklicher Daemon");
  SetProp(P_LONG, BS(
    "Vor Dir steht ein einsamer Daemon der Finsternis, der anscheinend Blut "
    "wittert."));
  SetProp(P_NAME, "Daemon");
  SetProp(P_GENDER, MALE);
  AddId(({"daemon", "\nknarkhdaemon"}));
  AddAdjective( ({"schrecklicher", "schrecklichen" }) );
  create_default_npc(25);
  SetProp(P_HANDS, 
    ({" mit Klauen, Reissern, Hoernern und Krallenfluegeln"
    , 200, ({DT_BLUDGEON, DT_RIP, DT_SLASH, DT_PIERCE}) }));
  SetProp(P_MAX_HP, 400);
  SetProp(P_BODY, 30);
  SetProp(P_XP, 0);
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 250);
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 3);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_FRIEND, 1);
  SetProp(P_MAX_FOOD, 5);
  SetProp(P_MAX_DRINK, 5);
  SetProp(P_MAX_ALCOHOL, 5);

  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint aus dem Nichts");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");

  SetProp(P_DIE_MSG,  " verpufft ins Schattenreich.\n");
  SetProp(P_NOCORPSE, 1 );
  AddClass(CL_DEMON);

  AddInfo(DEFAULT_INFO, "blickt Dich mit blutroten Augen an.\n");
//  SetProp( P_REJECT, ({ REJECT_DROP,
//    "Daemonen interessieren materielle Gueter nicht.\n" }) );
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_HOLY: 1 ]));

  SetProp(P_SPELLRATE,75);
  AddSpell(1,300,
    "Der Daemon verletzt Dich mit magischen Pfeilen.\n",
    "Der Daemon verletzt @WEN mit magischen Pfeilen.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon schleudert einen Feuerball nach Dir.\n",
    "Der Daemon schleudert einen Feuerball nach @WEM.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon attackiert Dich mit einem daemonischen Kampfschrei.\n",
    "Der Daemon attackiert @WEN mit einem daemonischen Kampfschrei.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon wirft einen satanischen Fluch nach Dir.\n",
    "Der Daemon wirft einen satanischen Fluch nach @WEM.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon schiesst einen scharfen Wasserstrahl auf Dich.\n",
    "Der Daemon schiesst einen scharfen Wasserstrahl auf @WEN.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon wirft einen eisigen Schneeball nach Dir.\n",
    "Der Daemon wirft einen eisigen Schneeball nach @WEM.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon huellt Dich in einen Wirbelsturm ein.\n",
    "Der Daemon huellt @WEN in einen Wirbelsturm ein.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon bespritzt Dich mit Saeure.\n",
    "Der Daemon bespritzt @WEN mit Saeure.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon huellt Dich in eine stinkende Giftwolke.\n",
    "Der Daemon huellt @WEN in eine stinkende Giftwolke.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon blendet Dich mit gleissenden Lichtstrahlen.\n",
    "Der Daemon blendet @WEN mit gleissenden Lichtstrahlen.\n",
     DT_LIGHT,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon elektrisiert Dich.\n",
    "Der Daemon elektrisiert @WEN.\n",
     DT_ELECTRIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon brutzelt Dich mit einem gruenen Blitz.\n",
    "Der Daemon brutzelt @WEN mit einem gruenen Blitz.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon bewirft Dich mit Knallerbsen.\n",
    "Der Daemon bewirft @WEN mit Knallerbsen.\n",
     DT_EXPLOSION,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Daemon terrorisiert Dich.\n",
    "Der Daemon terrorisiert @WEN.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddCmd(({"dbefehl", "dbefehle"}), "befehlen");
  AddCmd(({"dtauf", "dtaufe"}), "taufen");
  add_soul_commands();
}



void InformDefend(object enemy) 
{
  Kill(enemy);
}


int RemoveMaster() {
  if(!objectp(master)) return 0;
  master->RemovePursuer(TO);
  master->RemoveDefender(TO);
  master->SetProp(P_HAS_DEMON, 0);
  RemoveId("\nknarkhdaemon_"+getuid(master));
  SetProp(P_LONG, BS(
    "Vor Dir steht ein einsamer Daemon der Finsternis, der anscheinend Blut "
    "wittert."));
  SetProp(P_INFO, "");
  master=0;
  return 1;
}

int SetMaster(string player)
{

  player = LOWER(player);
  if(objectp(master=find_player(player)))
  {
    if(objectp(master->QueryProp(P_HAS_DEMON)) && 
       (master->QueryProp(P_HAS_DEMON) != TO))
    {
      tell_room(ENV(master), "Ein Daemon kommt an.\n" + break_string(
        "Wie ich sehe, hast Du bereits einen Kumpel von mir beschwoert. "
        "Dann brauchst Du mich ja eigentlich nicht.", 78, "Der Daemon sagt: ")+
        "Der Daemon verschwindet wieder.\n");
      call_out("remove", 0);
      return 0;
    }
    master->AddPursuer(TO);
    master->AddDefender(TO);
    master->SetProp(P_HAS_DEMON, TO);
    SetProp(P_MSGOUT, "eilt "+master->name(WEM)+" hinterher");
    AddId("\nknarkhdaemon_"+getuid(master));
    SetProp(P_LONG, BS(
     "Ein blutruenstiger Daemon. Du kannst die tiefen, "
     "fleischigen Wunden, die seinen Koerper und seine Krallenfluegel "
     "zeichnen, genau erkennen. Sein grosses, mit rasiermesserscharfen "
     "Zaehnen vollgestopftes Maul kann einen Kaempfer in Windeseile in "
     "der Luft zerreissen. Die Klauen sind von boesartiger Kraft, und die "
     "Hoerner haben eine Laenge, die Dich erzittern laesst. Voller Bosheit "
     "sieht er Dich mit seinen blutroten Augen an. Du kannst nur hoffen, "
     "dass ihn sein Meister nicht auf Dich hetzt.\n") + 
     "Er ist treuer und folgsamer Diener von "+ CAP(master->name(WEM)) +".\n");
    SetProp(P_INFO, BS(
      "Der Daemon hoert auf bestimmte Befehle. Welche das sind, musst Du "
      "selber herausfinden. Die Syntax lautet: 'dbefehl <befehl> [text]'."
      "Ausserdem kannst Du ihn taufen. Das geht mit dem Kommando 'dtaufe "
      "<name>'. "));
//    SetProp(P_FRIEND, 1);
    AddId(master->Name()+"Daemon\n");
    
    TO->move(ENV(master), M_NOCHECK);
    if (!MENV)
      return remove(), 0;
    if (master->QueryProp(P_GENDER) == FEMALE)
     tell_room(MENV, 
       "Der Daemon sagt: "+CAP(master->name())+" ist meine Meisterin!\n");
    else
     tell_room(MENV, 
       "Der Daemon sagt: "+CAP(master->name())+" ist mein Meister!\n");
    return 1;
  }
  return 0;
}

string QueryMaster()
{
   if (objectp(master)) return CAP(master->name());
   else return "No_Master";
}

void reset()
{
   if (!is_clone(TO)) return;
   ::reset();
   if(!objectp(MENV) || !objectp(master)) 
   {
     remove();
     return;
   }
   if(!interactive(master) || !--zeit)
   {
     tell_room(MENV,
       "Der Daemon von "+master->name(WEM)+" langweilt sich hier zu Tode.\n"+
       "Ein Spalt in der Erde tut sich auf und verschlingt ihn.\n");
     ::remove();
   }
}


// BecomesNetDead(object netdead) { if (netdead == master) remove(); }


int Defend(int dam, mixed dam_types, mixed spell, object enemy)
{
  object me;
  int ret;

  me=TO;
  ret = ::Defend(dam, dam_types, spell, enemy);  
  if(!objectp(master) || !objectp(environment(master)) || 
    !interactive(master))
  {
     remove();
     return ret; 
  }

  if(master && me && (environment(master) != environment(TO)))
    move(environment(master), M_GO);
  return ret;
}

varargs int remove(int silent)
{
  if(objectp(MENV))
    tell_room(MENV, "Der Daemon hat genug von dieser Welt.\n");
  return ::remove();
}

int befehlen(string str)
{
  str = TP->_unparsed_args();
  if(TP != master)  
  {
    notify_fail("Der Daemon hoert Dir gar nicht zu.\n");
    return 0;
  }

  if(TP->QueryProp(P_SP) < 10)
  {
     notify_fail("Mit so wenig magischer Energie kannst Du "+
                 "den Daemonen nicht beeindrucken.\n");
     return 0;
  }

  notify_fail("Was willst Du dem Daemon Befehlen?\n");
  if(!sizeof(explode(str, " "))) return 0;

  if(command(str))
  {
     TP->restore_spell_points(-10);
     return 1;
   }
  return 0;
}



int verify_name (string name)
{
  if (!stringp(name) || name == "")
    return 0;
  // Pruefung ob ein Spieler bereits so heisst.
  if (file_size(sprintf("/save/%c/%s.o", lower_case(name)[0], lower_case(name))) > 0)
    return 0;

  // Pruefung ob der Name gesperrt ist:
  if ( "/secure/master"->QueryBanished(name) )
    return 0;

  // Pruefung ob sonst ein NPC so heisst.
  if (find_living(name)) 
    return 0;

  // Name ist in Ordnung
  return 1;
}

int taufen(string str)
{
  if(TP != master)  
  {
    notify_fail("Du kannst nur einen Daemon taufen, der Dir gehoert.\n");
    return 0;
  }

  notify_fail("Du kannst dem Daemon nur EINEN Namen geben!\n");
  if(sizeof(explode(str, " ")) > 1) return 0;

  if( !verify_name(str) )
    return notify_fail("Dieser Name ist nicht erlaubt.\n"),1;
  
  notify_fail("Auf welchen Namen willst Du den Daemon taufen?\n");
  if(str)
  {
    RemoveId(taufname);
    taufname = LOWER(str);
    SetProp(P_NAME, "Daemon "+CAP(str));
    SetProp(P_SHORT, CAP(str)+", der schreckliche Daemon");
    write("Ok, Dein Daemon heisst nun "+CAP(str)+".\n");
    say(TP->Name()+" tauft einen Daemonen um.\n", TP);
    SetProp(P_ARTICLE, 0);
    AddId(taufname);
  }
  else
  {
    RemoveId(taufname);
    SetProp(P_NAME, "Daemon");
    SetProp(P_SHORT, "Ein schrecklicher Daemon");
    write("Ok, Dein Daemon hat nun keinen Namen mehr.\n");
    say(TP->Name()+" tauft einen Daemonen um.\n", TP);
    SetProp(P_ARTICLE, 1);
  }
  return 1;
}


init()
{
  ::init();
  if(objectp(master) && present(getuid(master))) master->AddDefender(TO);
}


void Attack(object en)
{
  if(!objectp(master) || !interactive(master) 
     || (environment(master) != environment(TO))) 
    return;
  else 
    ::Attack(en);
}

int _query_wimpy() { return 0; }

int _query_align() { return -500; }
