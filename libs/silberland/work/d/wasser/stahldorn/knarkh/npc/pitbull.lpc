inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein wuetender Pitbull");
  SetProp(P_LONG, BS(
    "Der kleine Pitbull vor Dir knurrt Dich gefaehrlich an. Sein einziges "
    "Interesse besteht darin, Dir die Gurgel aufzureissen. Pass auf, "
    "dass er sich nicht mit seinen kraeftigen Kiefern in Dir verbeisst."));
  SetProp(P_NAME, "Pitbull");
  SetProp(P_GENDER, MALE);
  AddId(({ "pitbull", "hund"}));

  create_default_npc(12);

  SetProp(P_HANDS, ({ " mit kraeftigen Kiefern",230,DT_PIERCE}));
  SetProp(P_XP, 150000);
  SetProp(P_BODY, 25);
  SetProp(P_MAX_HP, 100);
  SetProp(P_RACE, "Hund");
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN, "rennt herein");
  SetProp(P_MSGOUT, "rennt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "knurrt Dich an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Hund nimmt nichts an. Danke.\n" }) );


  SUID;
  CLONEME(ARMOUR "stachelband" );
  command("trage alles");
}

Attack(object enemy)
{
  object korb;


  if(!korb =  present("\nMaulkorb", TO))
    ::Attack(enemy);
  else
  {
    tell_object(enemy, 
      "Der Pitbull versucht Dich zu beissen, wird aber durch den Maulkorb "+
      "gehindert.\n");
    tell_room(MENV, "Der Pitbull versucht vergeblich, "
      +enemy->name(WEN)+ " zu beissen.\n", ({enemy}));
    if(!random(15)) 
    {
      tell_object(enemy, 
         "Der Pitbull schafft es, den Maulkorb zu zerfetzen.\n");
      korb->remove();
    }
  }
}
