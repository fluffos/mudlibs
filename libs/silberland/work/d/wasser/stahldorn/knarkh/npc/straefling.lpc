inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein angeketteter Straefling");
  SetProp(P_LONG, BS(
    "Ein armseliger kleiner Schlucker von Straefling sitzt auf einem " 
    "Holzpflock und schaut Dich traurig und auch aengstlich an. Der "
    "bedauernswerte alte Mann ist mit einer Kette notduerftig gefesselt, "
    "es wurde ihm aber eine gewisse Bewegungsfreiheit zugestanden. Weggehen "
    "ist ihm allerdings nicht erlaubt. Aufgrund seines offensichtlichen "
    "Alters und seiner offen zur Schau gestellten Aengstlichkeit wird er "
    "Dir sicher wenig Auskunft geben koennen.") );
  SetProp(P_NAME, "Straefling");
  SetProp(P_GENDER, MALE);
  AddId("straefling");

  create_default_npc(8);
  // P_LEVEL   = x = 8
  // P_SP/P_HP = (10+ x*x)    = 74
  // P_HANDS   = x*10         = 80
  // P_BODY    = x*4          = 32
  // P_XP      = HP*HANDS*5   = 29600

  SetProp(P_HANDS, ({" mit seinen Ketten",80,DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "wird an einen Pflock gefesselt");
  SetProp(P_MSGOUT, "loest seine Fesseln und flieht");
  SetProp(P_MMSGIN, "wied an einen Pflock gefesselt");
  SetProp(P_MMSGOUT, "loest seine Fesseln und haut ab");

  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "Bitte nicht schlagen!", "wimmert: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Straefling kann wegen seiner Ketten nichts nehmen.\n" }) );

  SUID;
  CLONEME(OBJ "kette");
}

die()
{
   object bestie;
   if(file_name(MENV) == ROOM "dorf_b7")
   {
     call_other(ROOM "meer", "???", 0);
     if (bestie = present("reisserbestie", find_object(ROOM "meer")))
     {
       tell_room(MENV, 
         "Ploetzlich brodelt es im Meer und ein Ungeheuer schaut heraus.\n");
        bestie->move(MENV, M_GO);
     }
   }
   ::die();
}
int _query_wimpy() {return 0;}
