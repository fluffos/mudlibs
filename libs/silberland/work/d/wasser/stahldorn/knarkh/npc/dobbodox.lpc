inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Dobbodox");
  SetProp(P_LONG, BS(
    "Du siehst einen bereits in die Jahre gekommenen Gaffo vor Dir, "
    "der es geschafft hat, so viele Elemente des Boesen zu sammeln und hier "
    "in Knarkh zu konzentrieren. Dobbodox der Magier trieft foermlich vor "
    "Hass auf alles, was von ausserhalb von Knarkh kommt. Er starrt Dich "
    "mit wuetenden Augen an und murmelt ununterbrochen Beschwoerungen "
    "vor sich hin.") );
  SetProp(P_NAME, "Dobbodox");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"magier", "dobbodox" }));
  set_living_name("dobbodox");
  SetProp(P_SOUND, "Dobbodox murmelt etwas vor sich hin.\n");

  create_default_npc(30, 250);

  SetProp(P_ATTRIBUTES, ([A_DEX: 10, A_INT: 70, A_CON: 10, A_STR: 5]));
  SetProp(P_HANDS, ({" mit schwachen Magierhaenden",250,DT_BLUDGEON}));
  SetProp(P_BODY, 15);
  SetProp(P_XP, 3*QueryProp(P_XP)/2);
  SetProp(P_RACE, "Gaffo");
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_WATER:-0.5, DT_ACID:-0.5, DT_POISON:-0.5, DT_FIRE:-0.6, 
        DT_LIGHTNING:-0.5, DT_COLD:-0.1, DT_MAGIC:-1, DT_ELECTRIC:-0.5,  
        DT_EXPLOSION:-1, DT_UNHOLY:-1, DT_HOLY:0.5, DT_AIR:-0.2, 
        DT_SOUND:-0.2, DT_LIGHT:-0.7, DT_TERROR:0.3]));
  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "kommt mit viel Hokuspokus herein");
  SetProp(P_MSGOUT, "geht mit viel Hokuspokus");
  SetProp(P_MMSGIN, "zaubert sich aus einem Zylinder");
  SetProp(P_MMSGOUT, "steigt in eine Kiste mit doppeltem Boden");

  SetProp(P_DIE_MSG,  " stirbt einen wuerdelosen Tod\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich bin nicht beeindruckt.");
  SetProp(P_KILL_NAME, "Der boese Magier Dobbodox");
  SetProp(P_KILL_MSG, "Ich werde Wiederauferstehen und Midas erobern!");

  AddInfo(DEFAULT_INFO, "sagt: DIR sag ich NICHTS!\n");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Dobbodox sagt: Danke. Ich schaus mir spaeter an.\n" }) );

  SetProp(P_SPELLRATE, 100);
  AddSpell(1,100,
    "Dobbodox wirft einen magischen Zauber nach Dir.\n",
    "Dobbodox wirft einen magischen Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,200,
    "Dobbodox wirft zwei magische Zauber nach Dir.\n",
    "Dobbodox wirft zwei magische Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,300,
    "Dobbodox wirft drei magische Zauber nach Dir.\n",
    "Dobbodox wirft drei magische Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,400,
    "Dobbodox wirft vier magische Zauber nach Dir.\n",
    "Dobbodox wirft vier magische Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,500,
    "Dobbodox wirft fuenf magische Zauber nach Dir.\n",
    "Dobbodox wirft fuenf magische Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,1,
    "Dobbodox schwaecht Deine Magiekraft.\n",
    "Dobbodox schwaecht @WESSEN Magiekraft.\n",
     DT_MAGIC, "saugspell" );
  AddSpell(4,1,
    "Dobbodox beschwoert die Macht des Totenreiches.\n",
    "Dobbodox beschwoert die Macht des Totenreiches.\n",
     DT_UNHOLY, "totenspell");
  AddSpell(1,600,
    "Dobbodox verflucht Dich voller Hass.\n",
    "Dobbodox verflucht @WEN voller Hass.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]) );

  AddDefaultSpell(1,400,DS_MASS_DAMAGE,
    "Dobbodox wirft einen Ball aus schwarzem Feuer in den Raum.\n",
    "Dobbodox wirft einen Ball aus schwarzem Feuer in den Raum.\n",
     DT_FIRE);
  AddDefaultSpell(3, 100, DS_DISARM);


  SetAttackChats(20, ({
  "Dobbodox beschmiert sich mit Huehnerblut.\n",
  "Dobbodox murmelt eine Zauberformel.\n",
  "Dobbodox ruft: Sterben sollst Du!\n",
  "Dobbodox versucht, Dir die Augen auszukratzen.\n",
  "Dobbodox bruellt: Brueder der Finsternis! Kommt zu mir!\n",
  "Dobbodox schreit um Hilfe.\n"}) );

  SUID;
  CLONEME(ARMOUR "stahldornpanzer" );
  command("trage alles");
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  object ob;
  if(objectp(ob=present("\nbarden_hero_killquest", QueryProp(P_KILLER)))) {
    ob->Mark();
  }
  
  write_file(LOG "npc.kills",
    ctime()+": "
    +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
    +" killt Dobbodox.\n");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spieler killt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "npc.deads",
    ctime()+": Dobbodox hat "
    +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
    +" umgebracht.\n");
}

totenspell(object enemy, int damage, mixed dam_type)
{
   object leiche;
   if(objectp(leiche=present("leiche", MENV)))
   {
     leiche->remove();
     say("Eine Leiche erwacht ploetzlich zum Leben.\n");
     clone_object(NPC "zombie")->move(MENV, M_GO);
   }
}

saugspell(object enemy, int damage, mixed dam_type)
{
  enemy->restore_spell_points(-15-random(10));
}
