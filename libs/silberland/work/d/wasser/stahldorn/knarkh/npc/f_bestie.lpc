inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die gefluegelte Bestie");
  SetProp(P_LONG, BS(
    "Die gefluegelte Bestie ist eine schreckliche Kreatur voller Hass "
    "auf alles, was sich am Boden bewegt. Die riesigen, unnatuerlichen "
    "Fluegel sehen zwar viel zu plump und muskuloes aus, um dieses "
    "grosse Drachenwesen in die Luefte zu heben, aber sie duerften "
    "wohl trotzdem ihre Funktion erfuellen, da die Bestie etwa "
    "zwei Meter vor Dir in der Luft schwebt.") );
  SetProp(P_NAME, "Bestie");
  SetProp(P_NAME_ADJ, "gefluegelt");
  SetProp(P_GENDER, FEMALE);
  AddId(({"bestie", "fluegelbestie", "\nf_bestie"}));
  AddAdjective("gefluegelte");
  set_living_name("fluegelbestie");
  AddDetail("fluegel", "Sie koennen Dich umhuellen und ersticken.");
  SetProp(P_INFO, 
    "Du erkennst eine gewisse Empfindlichkeit gegenueber Silber.\n");
  SetProp(P_SMELL, "Die gefluegelte Bestie stinkt nach Faeulnis.\n");
  SetProp(P_SOUND, "*BRUUUUUEEEEELLLL!*\n");

  create_default_npc(40);
  // P_LEVEL   = x = 
  // P_SP/P_HP = (10+ x*x)    = 
  // P_HANDS   = x*10         = 
  // P_BODY    = x*4          = 
  // P_XP      = HP*HANDS*5   = 
  SetProp(P_ATTRIBUTES, ([ A_DEX:40, A_STR:40, A_INT:40, A_CON:40 ]) );

  SetProp(P_HANDS, ({" mit ihren Krallenfluegeln",400,DT_SLASH}));
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 120);
  SetProp(P_XP, 2500000);
  SetProp(P_RACE, "Bestie");
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,200);
  SetProp(P_AGGRESSIVE, 0.25);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS  , ([ DT_AIR:-0.85 ]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt bruellend hereingeflattert");
  SetProp(P_MSGOUT, "flattert wuetend");
  SetProp(P_MMSGIN, "wird nun hier wueten");
  SetProp(P_MMSGOUT, "versinkt brodelnd im Erdreich");

  SetProp(P_DIE_MSG,  " stirbt in einem entsetzlichen Aufschrei.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "WAAAAAAAAAAAAARGHHHHHHHH!");
  SetProp(P_KILL_NAME, "Die gefluegelte Bestie");
  SetProp(P_KILL_MSG, "bruellt, als sie sich ueber ihre Mahlzeit hermacht.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0 ]));

  AddInfo(DEFAULT_INFO, "bruellt fuerchterlich.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die gefluegelte Bestie will nur DICH!\n" }) );

  SetProp(P_SPELLRATE,40);
  AddSpell(1,1200,
    "Die Bestie erstickt Dich mit ihren Fluegeln.\n",
    "Die Bestie erstickt @WEN mit ihren Fluegeln.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,700,
    "Die gefluegelte Bestie zerkratzt Dir das Gesicht.\n",
    "Die gefluegelte Bestie zerkratzt @WEM das Gesicht.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,400,
    "Die gefluegelte Bestie drischt mit den Fluegeln auf Dich ein.\n",
    "Die gefluegelte Bestie drischt mit den Fluegeln auf @WEN ein.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,400,
    "Die gefluegelte Bestie wirft Dich mit einem Luftstoss zu Boden.\n",
    "Die gefluegelte Bestie wirft @WEN mit einem Luftstoss zu Boden.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,400,
    "Die gefluegelte Bestie raubt Dir den Atem.\n",
    "Die gefluegelte Bestie raubt @WEM den Atem.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(15, ({
  "Die gefluegelte Bestie bruellt Dich an.\n", 
  "Die gefluegelte Bestie blaest Dir ins Gesicht.\n",
  "Die gefluegelte Bestie flattert wild herum.\n",
  "Die gefluegelte Bestie greift Dich von oben herab an.\n",
  "Die gefluegelte Bestie stuerzt auf Dich herab.\n",
  "Die gefluegelte Bestie schreit schmerzerfuellt auf.\n",
  "Die gefluegelte Bestie zueckt ihre Krallen.\n"}) );

  SUID;
  CLONEME(OBJ "fluegel" );
}

public void init() {
  object task;
  ::init();

  task =present(BARD_ID_GS8_TASK, TP);
  if(objectp(task)) {
    call_out("bard_sees_me", 0, task, TP);
  }
}

public void bard_sees_me(object task, object pl) {
  tell_object(pl, BS("Jetzt, da du " + name(WEN, 1) + " erblickst bekommst du grosse Angst!"));
  tell_room(ENV(TO), BS(pl->Name(WER, 1) + " erblickt " + name(WEN, 1) + " und wird kreidebleich."));

  task->SetBeastSeen(1);
  return;
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  object item;
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(15, TP)) 
    item->SetFlag(3);
  write_file(LOG "npc.kills",
    ctime()+": "
    +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
    +" killt die gefluegelte Bestie.\n");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spieler killt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if (killer == TO)
  write_file(LOG "npc.deads",
    ctime()+": Die gefluegelte Bestie hat "
    +((player->QueryProp(P_FROG))?CAP(getuid(player)):player->name(WEN))
    +" umgebracht.\n");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object weapon;
  if (!spell)
  {
    weapon=enemy->QueryProp(P_WEAPON);
    if (weapon && weapon->QueryMaterial(MAT_SILVER)>10)
        dam*=3; 
  }
  if(!random(4)) enemy->AddPursuer(TO);
  return ::Defend(dam, dam_type, spell, enemy);
}

int PreventFollow(object dest)
{
  string wo;

  if(sscanf(file_name(dest), ROOM+"%s",wo ) != 1) return 2;
  if(dest->QueryProp(P_INDOORS)) return (1 + random(1));

  return 0;
}

