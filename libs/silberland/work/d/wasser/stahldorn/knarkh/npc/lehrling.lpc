inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zaubererlehrling");
  SetProp(P_LONG, BS(
    "Du siehst einen recht jungen menschlichen Zauberer, den Dobbodox "
    "auf die Seite des Boesen gezogen hat und ihn nun zum zur maechtigen "
    "Schwarzmagier ausbildet. Er steht seinem Meister immer treu zur "
    "Seite und verteidigt ihn mit seinem Leben.") );
  SetProp(P_NAME, "Lehrling");
  SetProp(P_GENDER, MALE);
  AddId(({"zaubererlehrling", "lehrling" }));

  create_default_npc(13,100);

  SetProp(P_HANDS, ({" mit blossen Haenden",90,DT_BLUDGEON}));
//  SetProp(P_MAX_HP, 100);
  SetProp(P_BODY, 20);
//  SetProp(P_XP, 100000);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_HEAL, -25);

  SetProp(P_SPELLRATE, 75);
  AddSpell(1,50,
    "Der Lehrling wirft einen schwachen magischen Zauber nach Dir.\n",
    "Der Lehrling wirft einen schwachen magischen Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,100,
    "Der Lehrling wirft zwei schwache magische Zauber nach Dir.\n",
    "Der Lehrling wirft zwei schwache magische Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,150,
    "Der Lehrling wirft drei schwache magische Zauber nach Dir.\n",
    "Der Lehrling wirft drei schwache magische Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,200,
    "Der Lehrling wirft vier schwache magische Zauber nach Dir.\n",
    "Der Lehrling wirft vier schwache magische Zauber nach @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]) );
  AddSpell(4,1,
    "Der Lehrling macht einen Zauberfehler und verbrennt sich.\n",
    "Der Lehrling macht einen Zauberfehler und verbrennt sich.\n",
     DT_MAGIC, "fumblespell" );
}

fumblespell(object enemy, int damage, mixed dam_type)
{
  if(objectp(enemy) && enemy->id("daemon"))
  {
    say(BS(
      "Der Daemon heult schmerzerfuellt auf. Anscheinend hat der Lehrling "
      "einen unbeabsichtigten Effekt erzielt."));
    enemy->Defend(300, DT_HOLY, 1, TO);
  }
  do_damage(1 + random(5));
}
