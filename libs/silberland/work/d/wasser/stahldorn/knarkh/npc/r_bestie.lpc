inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die Reisserbestie");
  SetProp(P_LONG, BS(
    "Die Reisserbestie watschelt auf vier kurzen Stummelbeinen herum. "
    "Da ihr Element das Wasser ist, fuehlt sie sich eher im Meer geborgen, "
    "waehrend sie an Land einen naturgemaess eher unbeholfenen Eindruck "
    "macht. Trotzdem gibt sie auch hier einen immer noch aeusserst "
    "harten Gegner ab, der Dich mit seinen dolchartigen Reisszaehnen "
    "in Stuecke fetzen kann.") );
  SetProp(P_NAME, "Reisserbestie");
  SetProp(P_GENDER, FEMALE);
  AddId(({"bestie", "reisserbestie", "\nr_bestie"}));
  set_living_name("reisserbestie");
  AddDetail("reisser", "Messerscharfe Reisszaehne spicken ihre Kiefer.");
  AddDetail( ({"beine", "flossen", "stummelbeine"}), 
    "Die Beine sind abgeflacht und sehen fast wie Flossen aus.");
  SetProp(P_INFO, 
    "Das Element der Reisserbestie ist das Wasser.\n");
  SetProp(P_SMELL, "Die Reisserbestie stinkt nach modrigem Brackwasser.\n");
  SetProp(P_SOUND, "*BRUUUUUEEEEELLLL!*\n");

  create_default_npc(40);
  // P_LEVEL   = x = 
  // P_SP/P_HP = (10+ x*x)    = 
  // P_HANDS   = x*10         = 
  // P_BODY    = x*4          = 
  // P_XP      = HP*HANDS*5   = 
  SetProp(P_ATTRIBUTES, ([ A_DEX:40, A_STR:40, A_INT:40, A_CON:40 ]) );

  SetProp(P_HANDS, ({" mit ihren Reisszaehnen",400,DT_RIP}));
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 200);
  SetProp(P_XP, 2500000);
  SetProp(P_RACE, "Bestie");
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,200);
  SetProp(P_AGGRESSIVE, 0.75);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_WATER:-1, DT_ACID:-0.5, DT_POISON:-0.5, DT_FIRE:0.5, 
        DT_LIGHTNING:0.5, DT_COLD:0.1 ]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt bruellend hereingeschleimt");
  SetProp(P_MSGOUT, "schleimt wuetend");
  SetProp(P_MMSGIN, "wird nun hier wueten");
  SetProp(P_MMSGOUT, "versinkt brodelnd im Erdreich");

  SetProp(P_DIE_MSG,  " stirbt in einem entsetzlichen Aufschrei.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "WAAAAAAAAAAAAARGHHHHHHHH!");
  SetProp(P_KILL_NAME, "Die Reisserbestie");
  SetProp(P_KILL_MSG, "bruellt, als sie sich ueber ihre Mahlzeit hermacht.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0 ]));

  AddInfo(DEFAULT_INFO, "bruellt fuerchterlich.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Reisserbestie will nur DICH!\n" }) );

  SetProp(P_SPELLRATE,65);
  AddSpell(2,500,
    "Die Reisserbestie versenkt ihre Zaehne in Dein Fleisch.\n",
    "Die Reisserbestie versenkt ihre Zaehne in @WESSEN Fleisch.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1000,
    "Die Reisserbestie zerbeisst Dir das Rueckgrat.\n",
    "Die Reisserbestie zerbeisst @WESSEN Rueckgrat.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,1300,
    "Die Reisserbestie zermalmt Dich zwischen ihren Kiefern.\n",
    "Die Reisserbestie zermalmt @WEN zwischen ihren Kiefern.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,700,
    "Die Reisserbestie fetzt blutige Stuecke Fleisch aus Dir heraus.\n",
    "Die Reisserbestie fetzt blutige Stuecke Fleisch aus @WEM heraus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
    "Die Reisserbestie bespritzt Dich mit einem ueblen Wasserstrahl.\n",
    "Die Reisserbestie bespritzt @WEN mit einem ueblen Wasserstrahl.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
    "Ein Schwall Wasser aus dem Maul der Reisserbestie reisst Dich um.\n",
    "@WER wird von einem Schwall Wasser umgerissen.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(15, ({
  "Die Reisserbestie bruellt Dich an.\n", 
  "Die Reisserbestie spritzt Dir ins Gesicht.\n",
  "Die Reisserbestie attackiert Dich.\n",
  "Die Reisserbestie geifert giftige Galle.\n",
  "Die Reisserbestie schnappt nach Dir.\n",
  "Die Reisserbestie waelzt sich hin und her.\n",
  "Die Reisserbestie fletscht ihre Reisszaehne.\n"}) );

  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 120, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "dorf_b7");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);

  SUID;
  CLONEME(OBJ "reisser" );
}

public void init() {
  object task;
  ::init();

  task =present(BARD_ID_GS8_TASK, TP);
  if(objectp(task)) {
    call_out("bard_sees_me", 0, task, TP);
  }
}

public void bard_sees_me(object task, object pl) {
  tell_object(pl, BS("Jetzt, da du " + name(WEN, 1) + " erblickst bekommst du grosse Angst!"));
  tell_room(ENV(TO), BS(pl->Name(WER, 1) + " erblickt " + name(WEN, 1) + " und wird kreidebleich."), ({pl}));

  task->SetBeastSeen(4);
  return;
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  object item;
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(15, TP)) 
    item->SetFlag(2);
  if(item = present("\nzechpreller_quest_11", TP))
     item->Mark(poisondeath);
  
  write_file(LOG "npc.kills",
    ctime()+": "
    +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
    +" killt die Reisserbestie.\n");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spieler killt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if (killer == TO)
  write_file(LOG "npc.deads",
    ctime()+": Die Reisserbestie hat "
    +((player->QueryProp(P_FROG))?CAP(getuid(player)):player->name(WEN))
    +" umgebracht.\n");
}

