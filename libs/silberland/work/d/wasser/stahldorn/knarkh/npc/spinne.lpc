inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine winzige Spinne");
  SetProp(P_LONG, BS(
    "Diese kleine Spinne ist sicher noch nicht erwachsen. Aufgrund "
    "Futtermangels in dem dunklen Keller ist sie ausserdem ziemlich "
    "aggressiv. Sie hat wohl einfach Hunger."));
  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "winzige spinne", "spinne"}));

  create_default_npc(3);

  SetProp(P_HANDS, ({ " mit acht Beinen",30, ({DT_PIERCE, DT_POISON}) }));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 5);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stirbt.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, " antwortet unhoeflicherweise nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne ist viel zu klein, um sowas zu schleppen.\n" }) );
}
