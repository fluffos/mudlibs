inherit "std/mnpc";
inherit "std/inpc/select.lpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <mnpc.h>
#include <inpc.h>
#include "../def.h"

void create()
{
  object money;
  string rasse;
  int rand;

  if (!is_clone(TO)) return;
  ::create();

  rand = random(12);
  switch (rand)
  {
    case 0..3 : rasse = "Ork"; break;
    case 4..7 : rasse = "Gaffo"; break;
    case 8..9 : rasse = "Oger"; break;
    case 10..11 : rasse = "Troll"; break;
  }

  SetProp(P_SHORT, "Ein "+ rasse+ "-Power-Knarkhist");
  SetProp(P_LONG, BS(
    "Der grosse, kraeftige "+ rasse +", der vor Dir steht, sieht Dich aus "
    "boesen und hinterlistigen Augen an. Anhand seiner Ruestung und dem "
    "Power-Knarkhisten-Emblem erkennt man sofort, dass dieser Kerl einer "
    "Spezialeinheit der Soldaten von Knarkh angehoert."));
  SetProp(P_NAME, "Powerknarkhist");
  SetProp(P_GENDER, MALE);
  AddId(({ LOWER(rasse), "knarkhist", "powerknarkhist"}));

  create_default_npc(26);

  SetProp(P_ATTRIBUTES, ([ A_DEX:26, A_STR:33, A_INT:26, A_CON:26 ]) );
  SetProp(P_HANDS, ({" mit stinkenden "+ rasse +"fingern",250,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 500);
  SetProp(P_BODY, 80);
  SetProp(P_XP, 900000);
  SetProp(P_RACE, rasse);
  if (rand < 8)
     SetProp(P_SIZE, 180 + random(30));
  else
     SetProp(P_SIZE, 330 + random(70));
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 90);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_UNHOLY: -0.5, DT_HOLY: 1]));

  SetProp(P_DIE_MSG,  " faellt tot in sein eigenes Blut.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "grunzt furchtbar boese.\n");

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 5, 20, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "eingang");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_CMDS | MOV_OUTDOORS | 
         MOV_MAYLOAD | MOV_MOVES | MOV_SPECIAL);


  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Knarkhist sagt: Willst Du mich bestechen?\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(4,180,
    "Der Powerknarkhist tritt Dir in die Kniekehle.\n",
    "Der Powerknarkhist tritt @WEM in die Kniekehle.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
  AddSpell(3,250,
    "Der Powerknarkhist haut Dir in die Magengrube.\n",
    "Der Powerknarkhist haut @WEM in den Unterleib.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,500,
    "Der Powerknarkhist drischt im Blutrausch auf Dich ein.\n",
    "Der Powerknarkhist drischt im Blutrausch auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,750,
    "Der Powerknarkhist nimmt Dich in eine toedliche Umarmung.\n",
    "Der Powerknarkhist umarmt @WEN aeusserst brutal.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );


  SUID;

  if (rand < 8)
  {
    if (random (2)) CLONEME(WEAPON "p_knarkhschwert2" );
    else 
    {
      CLONEME(WEAPON "p_knarkhschwert1" );  
      if (random(3)) CLONEME(ARMOUR "knarkhschild" );
    }
    CLONEME(ARMOUR "emblem" );
    if (random(3)) CLONEME(ARMOUR "p_knarkhpanzer" );
    if (!random(3)) CLONEME(ARMOUR "p_knarkhhelm" );
    if (!random(3)) CLONEME(ARMOUR "p_knarkhstiefel" );
    if (!random(5)) CLONEME(ARMOUR "zahnschutz" ); 
    if (!random(3)) CLONEME(ARMOUR "knarkhhose" );

    money = CLONEOB ("/obj/money");
    money->SetProp(P_AMOUNT, 500+random(200));
    money->move(ME);
  }
  else
  {
    if(random(4)) 
    {
      if (random(2)) CLONEME(WEAPON "p_keule");
      else CLONEME(WEAPON "p_axt");
    }
    if(random(3)) CLONEME(ARMOUR "lendenschurz");
    if(random(2)) CLONEME(ARMOUR "panzerplatte");
  }
  command ("zuecke axt");
  command ("zuecke keule");
  command ("zuecke schwert");
  command("trage alles");


add_select_commands();

}

sell_but_worn(object ob)
{
  string *ids;
  int i;
/*  
  if (objectp(ob))
  {
      ids = ob->QueryProp(P_IDS);
      if(!ob->QueryProp(P_WORN) && !ob->QueryProp(P_WIELDED))
      {
        i=0;
        while (stringp(ids[i]) && !(ids[i][0] >= 97) && (!ids[i][0] <= 122) ) 
          i++;
        command("versetze "+ids[i]);
        DB(ids[i]);
      }      

  }
*/

  if (objectp(ob))
  {
     if(ob->QueryProp(P_WORN) || ob->QueryProp(P_WIELDED))
        ob->SetProp(P_KEEP_ON_SELL, getuid(TO));
     else
        ob->SetProp(P_KEEP_ON_SELL, 0);
  }

}


int wandern()
{
   int retour;

   retour = ::wandern();
   command("nimm alles");
   command("trage alles");
//   command("zuecke_beste_waffe");
//   command("trage_beste_ruestungen");
   if (ME && MENV && file_name(MENV) == ROOM "dorf_b4")
   {
//     map_array(all_inventory(TO), #'sell_but_worn);
     command("verkaufe alles");
     command("nimm alles");
   }
   return retour;
}



void init()
{
    ::init();
    if (TP->QueryProp(P_ALIGN) > 200 && 
       !IS_LEARNING(TP) && interactive(TP) &&
       objectp(MENV))
    {
	tell_room (MENV, 
	       "Der Knarkhist bruellt: Ah! Ein Eindringling von den Guten!\n"+
               "Der Knarkhist bruellt: Du bist sicher ein Spion! Stirb!\n");
	Kill(TP);
    }
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  call_out("command_me", 0, "nimm alles aus leiche");
//  call_out("command_me", 4, "zuecke_beste_waffe");
//  call_out("command_me", 6, "trage_beste_ruestungen");
}


int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  int i;
  for(i=1; present("knarkhist " + i) ;i++)
  {
     present("knarkhist " + i)->Kill(enemy);
  }
  return ::Defend(dam, dam_type, spell, enemy);
  
}

void Attack(object enemy)
{
  if(objectp(enemy) && enemy->Name()=="Jemand")
  {
    say("Der Powerknarkhist schaut sich verwundert um.\n");
    enemy->StopHuntFor(TO, 1);
    StopHuntFor(enemy, 1);
    return;
  }
  ::Attack(enemy);
}
