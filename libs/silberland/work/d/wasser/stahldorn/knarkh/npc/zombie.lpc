inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Zombie");
  SetProp(P_LONG, BS(
    "Eine halbverweste wandelnde Leiche. Sie ist beseelt von dem "
    "Gedanken, Dich zu Seinesgleichen zu machen.") );
  SetProp(P_NAME, ({ "Zombie", "Zombies", "Zombie", "Zombie"}) );
  SetProp(P_GENDER, MALE);
  AddId("zombie");

  create_default_npc(12);
  // P_LEVEL   = x = 12
  // P_SP/P_HP = (10+ x*x)    = 154
  // P_HANDS   = x*10         = 120
  // P_BODY    = x*4          = 48
  // P_XP      = HP*HANDS*5   = 92400

  SetProp(P_HANDS, ({" mit verwesenden Haenden",160,DT_BLUDGEON}));
  SetProp(P_RACE, "Zombie");
  SetProp(P_SIZE, 140);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_HEAL, -75);
}
