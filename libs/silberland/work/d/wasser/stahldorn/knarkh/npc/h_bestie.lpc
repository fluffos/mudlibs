inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

#define ELEMENT_SECURE "secure_prop"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die gehoernte Bestie");
  SetProp(P_LONG, BS(
    "Die gehoernte Bestie hat das Aussehen eines ueberdimensionalen "
    "Stieres mit zwei riesigen dunklen Hoernern vorn am Schaedel. " 
    "Die Haut leuchtet feuerrot. Gewaltige Flammen umzuengeln seinen "
    "Leib und strahlen eine sengende Hitze aus. ") );
  SetProp(P_NAME, "Bestie");
  SetProp(P_NAME_ADJ, "gehoernt");
  SetProp(P_GENDER, FEMALE);
  AddId(({"bestie", "hornbestie", "\nh_bestie"}));
  AddAdjective("gehoernte");
  set_living_name("hornbestie");
  SetProp(P_INFO, BS("Die Haut der Bestie besteht praktisch aus Feuer.") );
  AddDetail("haut", "Die Haut ist von einem Flammenkranz umgeben.");
  AddDetail("hoerner", "Toedliche Mordwerkzeuge.");
  SetProp(P_SMELL, "Die gehoernte Bestie stinkt nach verkohltem Fleisch.\n");
  SetProp(P_SOUND, "*BRUUUUUEEEEELLLL!*\n");

  create_default_npc(40);
  // P_LEVEL   = x = 
  // P_SP/P_HP = (10+ x*x)    = 
  // P_HANDS   = x*10         = 
  // P_BODY    = x*4          = 
  // P_XP      = HP*HANDS*5   = 
  SetProp(P_ATTRIBUTES, ([ A_DEX:40, A_STR:40, A_INT:40, A_CON:40 ]) );

  SetProp(P_HANDS, ({" mit ihren langen Hoernern",400,DT_PIERCE}));
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 200);
  SetProp(P_XP, 2500000);
  SetProp(P_RACE, "Bestie");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,200);
  SetProp(P_AGGRESSIVE, 0.75);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS  , ([ DT_FIRE:-0.9, DT_WATER:0.8  ]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt bruellend hereingestampft");
  SetProp(P_MSGOUT, "stampft wuetend");
  SetProp(P_MMSGIN, "wird nun hier wueten");
  SetProp(P_MMSGOUT, "versinkt brodelnd im Erdreich");

  SetProp(P_DIE_MSG,  " stirbt in einem entsetzlichen Aufschrei.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "WAAAAAAAAAAAAARGHHHHHHHH!");
  SetProp(P_KILL_NAME, "Die gehoernte Bestie");
  SetProp(P_KILL_MSG, "bruellt, als sie sich ueber ihre Mahlzeit hermacht.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0 ]));

  AddInfo(DEFAULT_INFO, "bruellt fuerchterlich.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die gehoernte Bestie will nur DICH!\n" }) );

  SetProp(P_SPELLRATE,65);
  AddSpell(1,1100,
    "Die Bestie reisst Dir mit den Hoernern die Eingeweide heraus.\n",
    "Die Bestie reisst @WESSEN Eingeweide heraus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,800,
    "Die gehoernte Bestie nagelt Dich an die Wand.\n",
    "Die gehoernte Bestie nagelt @WEN an die Wand.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,500,
    "Die gehoernte Bestie huellt Dich mit ihren Flammen ein.\n",
    "Die gehoernte Bestie huellt @WEN mit ihren Flammen ein.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Der feurige Schwanz der Bestie schnalzt auf Dich zu.\n",
    "Der feurige Schwanz der Bestie schnalzt auf @WEN zu.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Die gehoernte Bestie zertrampelt Dich mit ihren Hufen.\n",
    "Die gehoernte Bestie zertrampelt @WEN mit ihren Hufen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(15, ({
  "Die gehoernte Bestie bruellt fuerchterlich auf.\n", 
  "Die gehoernte Bestie versengt Dir die Haut.\n",
  "Die gehoernte Bestie versucht, Dich aufzuspiessen.\n",
  "Die gehoernte Bestie versucht, Dich ueber den Haufen zu rennen.\n",
  "Die gehoernte Bestie lodert.\n",
  "Die gehoernte Bestie stampft am Boden auf.\n",
  "Die gehoernte Bestie umkreist Dich.\n"}) );

  SUID;
  CLONEME(OBJ "hoerner" );
}

public void init() {
  object task;
  ::init();

  task =present(BARD_ID_GS8_TASK, TP);
  if(objectp(task)) {
    call_out("bard_sees_me", 0, task, TP);
  }
}

public void bard_sees_me(object task, object pl) {
  tell_object(pl, BS("Jetzt, da du " + name(WEN, 1) + " erblickst bekommst du grosse Angst!"));
  tell_room(ENV(TO), BS(pl->Name(WER, 1) + " erblickt " + name(WEN, 1) + " und wird kreidebleich."), ({pl}));

  task->SetBeastSeen(2);
  return;
}


// Mitloggen wenn der NPC einen Spieler killt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if (killer == TO)
  write_file(LOG "npc.deads",
    ctime()+": Die gehoernte Bestie hat "
    +((player->QueryProp(P_FROG))?CAP(getuid(player)):player->name(WEN))
    +" umgebracht.\n");
}

void die(int poisondeath)
{
  object spieler, ob;
  object item;
  if(!objectp(spieler=TO->QueryProp(P_KILLER))) return ::die(poisondeath);
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(15, TP)) 
    item->SetFlag(0);
          
  if((spieler->QueryProp(P_GUILD))=="druidenzirkel" &&
     (spieler->QueryProp(P_GUILD_LEVEL))==11)
  {
    call_other("/gilden/druidenzirkel/master/druidenmaster", "SetTask", spieler, 
        12);
  } 
  write_file(LOG "npc.kills",
    ctime()+": "
    +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
    +" killt die gehoernte Bestie.\n");
::die(poisondeath);
}

