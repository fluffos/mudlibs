inherit "std/npc";

#include <properties.h>
//#include <language.h>
#include <moving.h>
#include "../def.h"
#include <combat.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die Alchemistin");
  SetProp(P_LONG, BS(
    "Vor Dir steht eine verschlagen dreinschauende Menschenfrau, die sich "
    "in der Kunst der Alchemie auszukennen scheint. "
    "") );
  SetProp(P_NAME, "Alchemistin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Mensch");
  AddId(({"alchemistin", "frau"}));

  create_default_npc(14);

  SetProp(P_HANDS, ({" mit erfahrenen Frauenhaenden",130,DT_BLUDGEON}));
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt aus dem Lagerraum zurueck");
  SetProp(P_MSGOUT, "holt was aus dem Lagerraum");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_NOCORPSE, 0 );
//  SetProp(P_LOG_INFO, 1);

  AddInfo(DEFAULT_INFO, "Ich weiss nicht, was Du meinst.", 
         "sagt: ");
  SetProp(P_SMELL, "Die Alchemistin stinkt nach Chemie.\n");

  AddInfo( ({ "chemie", "alchemie" }),
   "grinst geheimnisvoll, sagt aber nichts.\n" );
  AddInfo( ({ "flasche", "flaschen" }), 
   "Willst Du eine der Flaschen kaufen? Sie koennen sehr nuetzlich sein."
   " Aber sei gewarnt! Manche Fluessigeiten sind auch sehr gefaehrlich, "
   "und ausserdem wechseln sie manchmal von sich aus die Farbe...", "sagt: " );
  AddInfo( ({ "fluessigkeit", "fluessigkeiten" }), 
   "Welche Fluessigkeit meinst Du? Die gruene? Die rote? Die bunte?", "sagt: ");
  AddInfo( ({ "farbe", "farben" }),
   "Welche Farbe meinst Du? Gelb? Braun? Violett?", "sagt: " );
  AddInfo( ({ "braun", "braune fluessigkeit", "brauner fluessigkeit" }), 
   "Die braune Fluessigkeit kuriert selbst schwerste Vergiftungen.", 
   "sagt: " );
  AddInfo( ({ "rot", "rote fluessigkeit", "roter fluessigkeit" }), 
   "Die rote Fluessigkeit macht unsichtbar. Aber nur fuer kurze Zeit.", 
   "sagt: " );
  AddInfo( ({ "blau", "blaue fluessigkeit", "blauer fluessigkeit" }), 
   "Die blaue Fluessigkeit ist nichts anderes als reiner Alkohol. "
   "Ich bekomme sie von meinem Ex-Mann als Direktimport aus Hobbingen.", 
   "sagt: " );
  AddInfo( ({ "gelb", "gelbe fluessigkeit", "gelber fluessigkeit" }), 
   "Die gelbe Fluessigkeit ist eine Heilfluessigkeit.", "sagt: " );
  AddInfo( ({ "violett", "violette fluessigkeit", 
	"violetter fluessigkeit" }), 
   "Die violette Fluessigkeit hebt den recht gebraeuchlichen Zauber der "
   "Amphibisierung auf. Allerdings ist der Metamorphoseprozess nicht "
   "gerade schmerzlos.", "sagt: " );
  AddInfo( ({ "bunt", "bunte fluessigkeit", "bunter fluessigkeit" }), 
   "Die bunte Fluessigkeit tut, was sie will.", "sagt: " );
  AddInfo( ({ "orangerot", "orangerote fluessigkeit", 
	"orangeroter fluessigkeit", "ethannotol" }), 
   "Die orangerote Fluessigkeit ist nichts anderes als reines "
   "Ethannotol hoechster Qualitaet. Es macht Betrunkene nuechtern.", "sagt: " );
  AddInfo( ({ "durchsichtig", "durchsichtige fluessigkeit", 
	"durchsichtiger fluessigkeit" }), 
   "Die durchsichtige Fluessigkeit ist magisch behandeltes Unweihwasser. "
   "Es frischt abgestorbene Gehirnzellen wieder auf.", "sagt: " );
  AddInfo( ({ "grau", "graue fluessigkeit", "grauer fluessigkeit" }), 
   "Die graue Fluessigkeit macht taube Leute hoerend. Allerdings ist die "
   "Einnahme mit Schmerzen verbunden.", "sagt: " );
  AddInfo( ({ "weiss", "weisse fluessigkeit", "weisser fluessigkeit" }), 
   "Die weisse Fluessigkeit macht blinde Leute sehend. Allerdings hat der "
   "Trank eine schmerzhafte Nebenwirkung.", "sagt: " );
  AddInfo( ({ "schwarz", "schwarze fluessigkeit", 
	"schwarzer fluessigkeit" }), 
   "Die schwarze Fluessigkeit wird Dich in nullkommanix toeten, wenn Du so "
   "dumm bist und sie trinkst.", "sagt: " );
  AddInfo( ({ "gruen", "gruene fluessigkeit", "gruener fluessigkeit" }), 
   "Die gruene Fluessigkeit ist ein spezielles Gift, das ich selber "
   "herstelle. Es ist sehr stark.", "sagt: " );
  AddInfo( ({ "inhalt" }), 
    "Du meinst sicher den Inhalt der Flaschen? Da sind verschiedene "
    "Fluessigkeiten mit unterschiedlichen Farben drin.", "sagt: ");
  AddInfo( ({ "nebenwirkung", "nebenwirkungen" }), 
    "Die Nebenwirkungen sind von Fluessigkeit zu Fluessigkeit verschieden. "
    "Am besten, Du findest sie selbst heraus, weil ich trink das Zeug "
    "nicht...", "sagt: ");
  AddInfo( ({ "chemikalien" }), 
    "Ich benutze viele verschiedene Chemikalien.", "sagt: ");
  AddInfo( ({ "formel", "formeln" }), 
    "Die sag ich DIR bestimmt nicht!", "sagt: ");
  AddInfo( ({ "knarkh" }), 
    "Knarkh ist Knarkh. Ich geh nicht oft raus aus dem Laden.\n", "sagt: ");
  AddInfo( ({ "laden", "umsatz", "geschaeft" }), 
    "Der Laden geht vergleichsweise gut, danke der Nachfrage.", "sagt: ");
  AddInfo( ({ "alkohol", "c2h5oh", "aethanol", "ethanol" }), 
    "Alkohol? C2H5OH?", "sagt: ");
  AddInfo( ({ "amphibisierung" }), 
    "Ein grauslicher Vorgang. Zuerst wird man ganz klein (naja, das faellt bei "
    "den Hobbits weg), dann wird man ganz gruen und es wachsen einem so "
    "Schwimmhaeute. Am Ende hat man nur noch Lust auf Fliegen.", "sagt: ");
  AddInfo( ({ "arbeit" }), 
    "Jaja, das Leben besteht aus Arbeit.", "sagt: ");
    AddInfo( ({"salbe","tube","salbentube"}),
            "Hin und wieder habe ich eine kleine Salbentube im Angebot, doch die "
                    "Herstellung der Salbe ist muehsam und zeitaufwendig, deswegen geht "
                            "sparsam mit der Salbe um.",
                                "sagt: ");
      AddInfo( ({"herstellung"}),
              "Das ist geheim.",
                  "sagt: ");


//  AddInfo( ({ "" }), 
//    "", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
     "Die Alchemistin steckt @WEN ohne ein Wort in die Tasche.\n" }) );


}

