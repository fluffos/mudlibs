inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

#define N_FRAGEN 65

int heal, rand;
string frage, *antwort;

string uhrzeit() { return dtime(time()); }

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  rand=random(N_FRAGEN)+1;
  heal = 5;

  SetProp(P_SHORT, "Ein Mund");
  SetProp(P_LONG, BS(
      "Der Mund in der Mauer scheint dich zu beobachten, was angesichts "
      "der Tatsache, dass er nur aus einem Mund besteht und keine Augen hat, "
      "ziemlich seltsam erscheint. Vielleicht kann er Dich ja auch hoeren. "
      "Versuchs mal und frag ihn nach etwas." ) );

  SetProp(P_NAME, "Mund");
  SetProp(P_GENDER, MALE);
  AddId(({"mund", "\nmouthinthewall"}));

  create_default_npc(100);

  SetProp(P_HANDS, ({" mit seiner Zunge",10,DT_BLUDGEON}));
  SetProp(P_RACE, "Mund");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_INVIS, 0);
  SetProp(P_NOATTACK, "ruelpst abfaellig.");

  AddInfo(DEFAULT_INFO,
    "Hmm. Darueber muss ich erst nachdenken.", "sagt: ");
  AddInfo( ({ "mund" }),
    "Ich bin ein weiser Mund. Woher ich komme, weiss ich selber nicht, aber "
    "ich vermute, der boese Magier Dobbodox hat was damit zu tun. ", "sagt: ");
  AddInfo( ({"dobbodox", "magier"}),
    "Der boese Magier Dobbodox beherrscht Knarkh. Er hat damals diese "
    "Halbinsel in Besitz genommen und daraus einen Ort des Boesen gemacht. "
    "In seinen Laboratorien braut er mit schwarzer Magie dunkle Dinge "
    "zusammen. Ich bin ein Teil davon, obwohl ich nicht weiss, welche Aufgabe "
    "er mir zugedacht hat.", "sagt: ");
  AddInfo( ({"knarkh", "dorf"}),
    "Knarkh. So heisst das Dorf hier. Dobbodox hat die uebelsten Kreaturen "
    "versammelt, um es zu beschuetzen, damit er in Ruhe an der "
    "Ausfuehrung seiner Plaene arbeiten kann.", "sagt: ");
  AddInfo( ({"aufgabe", "lebenszweck"}),
    "Meine Aufgabe und meinen Lebenszweck kenne ich nicht. Wohl aber meine "
    "Faehigkeiten.", "sagt: ");
  AddInfo( ({"faehigkeiten"}),
    "Ich weiss, was ich kann. Allerdings musst Du erst ein Raetsel loesen, "
    "wenn Du meine Kraefte in Anspruch nehmen willst.", "sagt: ");
  AddInfo( ({"kraefte"}),
    "Loese erst mein Raetsel!", "sagt: ");
  AddInfo( ({"raetsel"}),
    "Antworte mir!\n@@raetsel@@", "sagt: ");
  AddInfo( ({"plaene", "ausfuehrung", "plan", "plaenen"}),
    "Wie die Plaene  genau aussehen weiss ich nicht. Aber ich bin sicher, "
    "dass sie alle mit der Zerstoerung von Midas und der Uebernahme des "
    "Silberlandes durch dunkle Magie zu tun haben.", "sagt: ");
  AddInfo( ({"magie"}),
    "Dunkle Magie. Das Werkzeug des Boesen und des Hasses.", "sagt: ");
  AddInfo( ({"boesem", "boese", "boesen", "hass"}),
    "Das Boese ist immer und ueberall. Und hier besonders.", "sagt: ");
  AddInfo( ({"kreaturen", "geschoepfe"}),
    "Oh, er hat alle moeglichen Orks, Trolle, Oger und Gaffos aus entlegenen "
    "Winkeln des Silberlandes rekrutiert, die nun als Waechter von Knarkh "
    "fungieren. Du wirst diese Knarkhisten sicher schon gesehen haben. "
    "Noch schlimmer sind die Elitetruppen der Powerknarkhisten. Sie haben ein "
    "spezielles Trainingslager in der Hoelle absolviert. Aber die uebelsten "
    "und fiesesten Geschoepfe sind sicher die Bestien.", "sagt: ");
  AddInfo( ({"trainingslager", "hoelle", "teufel"}),
    "Das Trainingslager in der Hoelle hat angeblich der Teufel selbst "
    "eingerichtet.", "sagt: ");
  AddInfo( ({"waechter", "knarkhisten", "knarkhist", "powerknarkhisten",
	     "powerknarkhist"}),
    "Die Knarkhisten bewachen Knarkh. Sie sind boese.", "sagt: ");
  AddInfo( ({"bestien", "bestie"}),
    "Es gibt 4 verschiedene Bestien hier in Knarkh. Eine gehoernte Bestie, "
    "eine Klauenbestie, eine gefluegelte Bestie und eine Reisserbestie. "
    "Ihr genauer Aufenthaltsort ist mir unbekannt, und glaub mir: Du willst "
    "das auch nicht wissen! Ahja, noch was: "
    "Jede dieser Bestien hat angeblich gewisse Schwachstellen, die man durch "
    "Identifizieren herausbekommen soll. ",
    "sagt: ");
  AddInfo( ({"gefluegelte bestie", "gefluegelter bestie", "fluegelbestie"}),
    "Sie kann fliegen. Ihr Element ist die Luft. Vielleicht kann man mit "
    "ihren Fluegeln etwas anfangen, "
    "denn Dobbodox hat gerade darauf viel Zeit verschwendet, die Fluegel so "
    "hinzubekommen, wie er es sich vorgestellt hat.", "sagt: ");
  AddInfo( ({"fluegel", "hoerner", "klauen", "reisser", "reisszaehne"}),
    "Die sind angeblich irgendwie magisch.", "sagt: ");
  AddInfo( ({"gehoernte bestie", "gehoernter bestie"}),
    "Die gehoernte Bestie lebt im Feuer. Ihre maechtigen Hoerner und "
    "ihre flammende Haut machen sie zu einem der schlimmsten Gegner, "
    "die man sich vorstellen kann.", "sagt: ");
  AddInfo( ({"haut"}),
    "Die Haut der gehoernten Bestie brennt lichterloh.", "sagt: ");
  AddInfo( ({"klauenbestie", "jaeger"}),
    "Die Klauen der Klauenbestie schneiden durch @@spielerrasse@@"
    "fleisch wie durch warme Butter. Die Klauenbestie ist ein Jaeger "
    "des Kontinents, den Dobbodox sich auf seine Art zu eigen gemacht "
    "hat. Er nannte es einmal \"GEM-manipuliert\", oder so aehnlich.",
    "sagt: ");
  AddInfo( ({"butter"}),
    "Nimm mich nicht immer so woertlich!", "sagt aergerlich: ");
  AddInfo( ({"reisserbestie"}),
    "Die Reisserbestie lebt im Meer und kommt nur dann an Land, wenn sie "
    "dort ein denkendes Wesen wittert, dessen Seele sie aussaugen kann. "
    "Ihr Markenzeichen sind - wie ihr Name schon andeutet - ihre gewaltigen "
    "Reisszaehne. Nimm Dich vor Dir in Acht!", "sagt: ");
  AddInfo( ({"seelen", "seele"}),
    "Davon lebt die Reisserbestie.", "sagt: ");
  AddInfo( ({"meer"}),
    "Das Meer grenzt Knarkh von drei Seiten ein. Aber nur im Sueden "
    "ist es zugaenglich. Dort hat man sogar einen kleinen Hafen "
    "gebaut.", "sagt: ");
  AddInfo( ({"hafen", "sueden"}),
    "Der Hafen liegt im Sueden von Knarkh.", "sagt: ");
  AddInfo( ({"halbinsel"}),
    "Knarkh steht auf einer Halbinsel. Nicht gewusst?", "sagt: ");
  AddInfo( ({"oger", "trolle", "gaffos", "orks", "ork", "gaffo", "troll"}),
    "Dobbodox hat sie rekrutiert, damit sie Knarkh bewachen.", "sagt: ");
  AddInfo( ({"haus"}),
    "Das Haus hier steht leer. Das von Dobbodox steht im Osten von Knarkh."
    " (ich weiss ja nicht, welches Du nun meinst)", "sagt: ");
  AddInfo( ({"aufenthaltsort"}),
    "Das weiss ich nicht, das muesstest Du selber rausfinden.", "sagt: ");
  AddInfo( ({"laboratorien", "labor", "labors", "laboratorium"}),
    "Die Laboratorien befinden sich im Keller von Dobbodox' Haus.", "sagt: ");
  AddInfo( ({"dinge"}),
    "Dobbodox beschaeftigt sich mit dem Bannen boeser Geister in "
    "Bestiengestalt. Diese Bestien sind sehr stark und maechtig. Da er dunkle "
    "Magie verwendet, braucht er als Einzelteile der Bestien Teile "
    "lebender Wesen. Menschenaugen, Orkhoden, Gaffonieren, Elfenhaare und "
    "wasweissichnochwasalles. Hauptsache die Spender leben noch, wenn ihnen "
    "die Teile entnommen werden.", "sagt: ");
  AddInfo( ({"menschenaugen", "orkhoden", "elfenhaare", "gaffonieren"}),
    "Das war jetzt nur als Beispiel gedacht. Keine Ahnung, was er "
    "wirklich dazu braucht.", "sagt: ");
  AddInfo( ({"teile", "einzelteile", "teil"}),
    "Frag ihn doch selber! Vielleicht sagt ers Dir ja, bevor er Dich toetet.",
    "sagt: ");
  AddInfo( ({"tuer", "tuere"}),
    "Die bekommst Du nicht so ohne weiteres auf.", "sagt: ");
  AddInfo( ({"eingang", "einlass", "zaubertrank", "teleport"}),
    "Loese erst mein Raetsel!", "sagt: ");
  AddInfo( ({"stahldorn"}),
    "Der Typ ist der einzige ausser Dobbodox vor dem ich Respekt habe.",
    "sagt: ");
  AddInfo( ({"silberland", "welt", "welten"}),
    "Die Welt um uns herum wird SilberLand genannt. Manche Spinner "
    "behaupten, dass es noch andere solche Welten gibt, aber ich "
    "halte das ehrlich gesagt fuer blanken Unsinn.", "sagt: ");
  AddInfo( ({"spinner"}),
    "Die Welt ist voll davon.", "seufzt: ");
  AddInfo( ({"unsinn"}),
    "Eine unsinnige Frage." , "sagt: ");
  AddInfo( ({"frage", "fragen"}),
    "Frage? Welche Frage? Stell mir eine! Oder meinst Du ein Raetsel? "
    "Ich weiss viele Raetsel!", "sagt: ");
  AddInfo( ({"dusty", "woody"}),
    "Ha! Selbst die Goetter werden das Boese hier in Knarkh nicht "
    "aufhalten koennen!", "lacht: ");
  AddInfo( ({"osten"}),
    "Im Osten von Knarkh steht das Haus von Dobbodox.", "sagt: ");
  AddInfo( ({"loesung", "loesungen", "antwort", "antworten"}),
    "Die Loesungen auf meine Raetsel sind meist durch logisches Denken "
    "herauszufinden.", "sagt: ");
  AddInfo( ({"midas", "hauptstadt"}),
    "Midas ist die Hauptstadt des Silberlandes.", "sagt: ");
  AddInfo( ({"heilung"}),
    "Ich habe @@QueryHeilung@@ Heilungen uebrig. Beantworte aber vorher mein Raetsel.",
    "sagt: ");
  AddInfo( ({"statue", "daemon"}),
    "Man sagt, dass in der Statue auf der Plaza ein Daemon lauert, "
    "der darauf wartet, zum Leben erweckt zu werden.", "sagt: ");
  AddInfo( ({"plaza"}),
    "Die Plaza ist der grosse Platz in der Mitte von Knarkh.", "sagt: ");
  AddInfo( ({"tempel"}),
    "Im Tempel finden dunkle Rituale und geheimnisvolle magische Beschwoer"
    "ungen statt. Sieh Dich genau um, vielleicht entdeckst Du dort "
    "Dinge, die Dir helfen.", "sagt: ");
  AddInfo( ({"silberring", "silber"}),
    "Man kann Silber magisch positiv aufladen. Das kann einem helfen, "
    "Barrieren aus Negativmagie zu ueberwinden. Auch manche Ungeheuer, "
    "vor allem wenn es sich um Werwesen handelt, reagieren allergisch "
    "auf Silber.", "sagt: ");
  AddInfo( ({"kneipe", "bauchstich", "barriere"}),
    "Der Goldene Bauchstich ist die einzige Kneipe in Knarkh. Damit nicht "
    "Eindringlinge von ausserhalb sich dort vergnuegen, schuetzt eine "
    "magische Barriere den Eingang. Aber angeblich gibt es irgendwo einen "
    "Gegenstand, der Dir das Betreten der Kneipe ermoeglicht.", "sagt: ");
  AddInfo( ({"ungeheuer", "werwesen"}),
    "Huete Dich davor!", "sagt: ");
  AddInfo( ({"negativmagie"}),
    "Auch schwarze Magie genannt. \nSiehe auch: Positivmagie.", "sagt: ");
  AddInfo( ({"positivmagie"}),
    "Auch weisse Magie genannt. \nSiehe auch: Negativmagie.", "sagt: ");
  AddInfo( ({"weisse magie"}),
    "Auch Positivmagie genannt. \nSiehe auch: schwarze Magie.", "sagt: ");
  AddInfo( ({"schwarze magie"}),
    "Auch Negativmagie genannt. \nSiehe auch: weisse Magie.", "sagt: ");
  AddInfo( ({"gegenstand"}),
    "Das musst Du selber herausfinden.", "sagt: ");
  AddInfo( ({"rituale", "beschwoerungen"}),
    "Sie dienen ausnahmslos dunklen Zwecken, die Dich nichts angehen.",
    "sagt: ");
  AddInfo( ({"augen"}),
    "geheimnisvoll.", "grinst ");
  AddInfo( ({"gesicht"}),
    "Sowas brauch ich nicht.", "sagt: ");
  AddInfo( ({"zunge"}),
    "streckt Dir die Zunge heraus.\n");
  AddInfo( ({"mauer", "wand"}),
    "Ich lebe in einer Mauer. Na und?", "sagt: ");
  AddInfo( ({"ausgang", "flucht", "fluchtweg"}),
    "Ich kann Dir da helfen, aber loese vorher mein Raetsel!", "sagt: ");
  AddInfo( ({"keller"}),
    "Du meinst den Keller von Dobbodox' Haus? Hmm. Ich war da noch nie. "
    "Aber ich habe gehoert, dort soll es in die Unterwelt gehen. "
    "(Anmerkung: Under Construction.)", "sagt: ");
  AddInfo( ({"unterwelt"}),
    "Das ist ein boeser Ort.", "sagt: ");
  AddInfo( ({"hilfe"}),
    "Hilfe! Hilfe! Dauernd fragt ihr mich nach Hilfe!", "sagt: ");
  AddInfo( ({"johannes"}),
    "Ja, an den Johannes erinnere ich mich gut. Der hat hier ein Raetsel "
    "geloest und durfte dann fliehen.", "sagt: ");
  AddInfo( ({"tip"}),
    "Wenn Du einen Tip fuer das Raetsel willst, hast Du Pech gehabt.","sagt: ");
  AddInfo( ({"feyaria"}),
    "Hmm? Wer ist das?", "sagt: ");
  AddInfo( ({"denken", "nachdenken"}),
    "Das tu ich recht gern. Du nicht auch?", "sagt: ");
  AddInfo( ({"zeit"}),
    "@@uhrzeit@@", "sagt: ");
//  AddInfo( ({""}),
//    "", "sagt: ");
//  AddInfo( ({""}),
//    "", "sagt: ");

//  AddInfo( ({""}),
//    "", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ein Mund kann nichts tragen.\n" }) );
  SetProp(P_LOG_INFO, "mund_fragen.log");

  AddCmd( ({"wuschel", "wuschle"}), "wuscheln");
  AddCmd( ({"antworte", "antwort"}), "antworten2");

}

string spielerrasse () { return TP->QueryProp(P_RACE); }

string raetsel()
{
  frage="Huch? Fehler! Verstaendige Stahldorn!";
  switch(rand)
  {
    case 1: frage="Ein schlechtes scheint der Weile wenig zu beduerfen.";
	antwort=({"ding"}); break;
    case 2: frage="Auf Pille nicht, noch Salbe hoff, wer taeglich " +
	"dreizehn ... soff!";
	antwort=({"halbe"}); break;
    case 3: frage="Kuenstler schuf sie Schlag auf Schlag.";
	antwort=({"skulptur", "statue"}); break;
    case 4: frage="Welcher Gang bringt Untergang?";
	antwort=({"muessig", "muessiggang"}); break;
    case 5: frage="Winzigwild mit Blatt oder Schild.";
	antwort=({"laus"}); break;
    case 6: frage="Ihr Fehlen bedauert, wer auf einem Hocker kauert.";
	antwort=({"lehne"}); break;
    case 7: frage="Was ist das Diebesgut der Faulenzer?";
	antwort=({"tag", "tage"}); break;
    case 8: frage="Uebersaettigt muss er passen und von der Ader lassen.";
	antwort=({"blutegel", "egel"}); break;
    case 9: frage="Ist es voll, so koennen Konsequenzen drohen.";
	antwort=({"mass"}); break;
    case 10: frage="Im Zerfall liegt der Ursprung seiner Kraft.";
	antwort=({"atom", "kern", "atomkern"}); break;
    case 11: frage="Diesseits schwanken die Planken, jenseits fehlt's an "+
	"Balken.";
	antwort=({"bord", "schiff", "boot"}); break;
    case 12: frage="Welche Stunde waehrt lang in aller Munde?";
	antwort=({"stern"}); break;
    case 13: frage="Was ist verfuehrerischer als Gold?";
	antwort=({"ruhm"}); break;
    case 14: frage="Zieht der ... ein, zieht das Geheimnis aus.";
	antwort=({"wein"}); break;
    case 15: frage="Wenn sie nicht ins Auge sticht, so sticht sie in den "+
	"Gaumen.";
	antwort=({"graete", "greten"}); break;
    case 16: frage="Nenne die Beere, die des Saftes entbehrt!";
	antwort=({"rosine", "rosinen"}); break;
    case 17: frage="Des Fischers Freud und des Fisches Leid.";
	antwort=({"fang"}); break;
    case 18: frage="Was ist aus Stahl und traegt einen Bart?";
	antwort=({"schluessel"}); break;
    case 19: frage="Was hat einen Ruecken und kann nicht liegen, "+
	"Fluegel und kann nicht fliegen?";
	antwort=({"nase"}); break;
    case 20: frage="Spott und Hohn traegt schlimmen ...";
	antwort=({"lohn"}); break;
    case 21: frage="Sein und Habe anderer laesst ihn mit dem Bocksfuss "+
	"stampfen.";
	antwort=({"neidhammel"}); break;
    case 22: frage="Wer hinter ihm sitzt, hat das Schloss vor sich.";
	antwort=({"riegel"}); break;
    case 23: frage="Am Himmel steht er gross und klein.";
	antwort=({"baer", "wagen"}); break;
    case 24: frage="Was in des Weisen Gedanken ist, ist in des Narren ...";
	antwort=({"mund"}); break;
    case 25: frage="Mit hin wird es zum sowieso.";
	antwort=({"ohne", "ohnehin"}); break;
    case 26: frage="Was ist das Gebilde von Menschenhand?";
	antwort=({"tand"}); break;
    case 27: frage="Wen ziert der Zimperliche?";
	antwort=({"sich"}); break;
    case 28: frage="Summe vieler Baeume, inklusive Zwischenraeume.";
	antwort=({"wald"}); break;
    case 29: frage="Gehoert zu da wie ab zu zu.";
	antwort=({"hie", "hier"}); break;
    case 30: frage="Bei bei fast fast.";
	antwort=({"nah", "nahe", "beinahe", "beinah"}); break;
    case 31: frage="Wer kein eigenes ... hat, ist ueberall daheim.";
	antwort=({"haus"}); break;
    case 32: frage="Eine macht noch keine Garde.";
	antwort=({"robe", "garderobe"}); break;
    case 33: frage="Was hat eine Rose und eine Nadel und " +
	"dreht sich im Kreis?";
	antwort=({"kompass"}); break;
    case 34: frage="Was hinterlaesst keine Luecke, wenn es fehlt?";
	antwort=({"loch"}); break;
    case 35: frage="Vorwaerts zaertlich, rueckwaerts scharf.";
	antwort=({"lieb"}); break;
    case 36: frage="Faellt der, dann nicht weit vom Stamm.";
	antwort=({"apfel"}); break;
    case 37: frage="Passt zu froh, wie hoch zu erfreut.";
	antwort=({"heil", "heilfroh"}); break;
    case 38: frage="cos mal tan";
	antwort=({"sin"}); break;
    case 39: frage="Red was wahr ist, iss was gar ist, trink was ... ist!";
	antwort=({"klar"}); break;
    case 40: frage="Zaster in Schwarz.";
	antwort=({"kohle"}); break;
    case 41: frage="Blinder Saeufer findet ihn!";
	antwort=({"korn"}); break;
    case 42: frage="Viereck fuer Runden.";
	antwort=({"ring", "boxring"}); break;
    case 43: frage="Bei 0 Grad haelt er die Schenkel geschlossen.";
	antwort=({"zirkel"}); break;
	// Ein paar neue Raetsel von Ronja
    case 44: frage="Was ist nackter als nackt, so nackt, dass es knackt?";
  antwort=({"skelett","skelette","knochenmann"}); break;
    case 45: frage="Was will ein jeder werden,was will doch keiner sein?";
  antwort=({"alt","aelter"}); break;
    case 46: frage="Welcher Igel eins - zwei - drei legt ein Mahagoni-Ei?";
  antwort=({"kastanie","kastanien"}); break;
    case 47: frage="Weiss wie Kreide, Leicht wie Flaum, Weich wie Seide, "
                   "feucht wie Schaum.";
  antwort=({"schnee","schneeflocke"}); break;
    case 48: frage="Alle Tage geh ich aus, bleibe dennoch stets zu Haus.";
  antwort=({"schnecke"}); break;
    case 49: frage="Loch bei Loch Und haelt doch.";
  antwort=({"kette"}); break;
    case 50: frage="Welches Wort mit sechs Buchstaben spricht jeder falsch "
                   "aus?";
  antwort=({"falsch"}); break;
    case 51: frage="Nachts kommen sie ohne geholt zu werden, bei Tage"
                   " verschwinden sie ohne geholt zu werden?";
  antwort=({"sterne"}); break;
    case 52: frage="Je mehr es bekommt, desto hungriger wird es und hat es "
                   "alles gefressen, so stirbt es.";
  antwort=({"feuer"}); break;
    case 53: frage="Von vorne und von hint' gelesen bin ich ein schnelles"
                   " Wesen.";
  antwort=({"renner"}); break;
    case 54: frage="Nimm mir ein nu, so bin ich ein Nu.";
  antwort=({"monument"}); break;
    case 55: frage="Ich werde gestern sein, bin morgen da gewesen.";
  antwort=({"heute"}); break;
    case 56: frage="Mein Gesicht ist geschmueckt mit fremdem Licht. "
                   "Schmueckt mich nicht das fremde Licht sieht man nicht "
                   "mein Angesicht.";
  antwort=({"mond"}); break;
    case 57: frage="Wer stolziert mit Kamm und Sichel herum?";
  antwort=({"hahn"}); break;
    case 58: frage="Will man vieles von mir haben, muss man mich erst"
                   " begraben.";
  antwort=({"samen"}); break;
    case 59: frage="Eine weisse Schachtel ohne Ecken, einen goldenen Schatz "
                   "tut sie verstecken.";
  antwort=({"ei"}); break;
    case 60: frage="Lebt ohne Atmen, kalt wie der Tod, nie durstig, trinkt "
                   "doch immerfort.";
  antwort=({"fisch"}); break;
    case 61: frage="Leicht wie eine Feder kann man es doch nicht halten.";
  antwort=({"atem"}); break;
    case 62: frage="Du brichst es wenn du es nennst.";
  antwort=({"stille","schweigen"}); break;
    case 63: frage="Gib ihm zu essen, es wird leben. Gib ihm zu trinken es "      
                   "wird sterben.";
  antwort=({"feuer"}); break;
    case 64: frage="Ich bin nicht viel, fuege 2 hinzu, weniger werd ich "
                   "sein.";
  antwort=({"wenig"}); break;
    case 65: frage="Dumm bin ich, taub bin ich, manchmal blind, sage immer "
                   "die Wahrheit.";
  antwort=({"spiegel"}); break;
/*
    case : frage="";
  antwort=({""}); break;
*/
    default: break;
  }
  RemoveCmd("antworte");
  AddCmd("antworte", "antworten");
  return(frage);

}

chosen(string choice, object wer)
{
   switch(choice)
   {
     case "0": write("Ok, dann beim naechsten Mal.\n"); break;
     case "1": heilung(wer); break;
     case "2": einlass(wer); break;
     case "3": zaubertrank(wer); break;
     case "4": titel(wer); break;
     case "5": teleport(wer); break;
     case "6": bonbon(wer); break;
     case "7": entsorg(wer); break;
     case "8": presay(wer); break;
     default: write("Ungueltige Eingabe!\n"); geloest(wer);
   }
}

private void geloest(object wer)
{

  write(
   "Da Du meine Aufgabe geloest hast, darfst Du Dir eine Belohnung aussuchen.\n"
  +"\n"
  +"0) .. Gar keine.\n"
  +"1) .. Heilung Deiner Lebens- und Magiepunkte. ("+heal+" Heilungen uebrig)\n"
  +"2) .. Einlass in das Haus hinter mir.\n"
  +"3) .. Ein Zaubertrank, dessen Wirkung ungewiss ist.\n"
  +"4) .. Umsetzung Deines Titels.\n"
  +"5) .. Teleport nach Midas. (Achtung! Ankunft nicht garantiert!)\n"
  +"6) .. Ein koestliches Bonbon.\n"
  +"7) .. Entsorgung eines Gegenstandes in Deinem Inventory.\n"
  +"8) .. Ein schoenes neues Presay fuer Dich.\n"
  +"\n");
  tell_object(wer, "Waehle weise: ");
  input_to("chosen", 0, wer);

}

int antworten2(string str)
{
   write("Du antwortest etwas.\n");
   write("Der Mund sagt: Ich hab Dich doch gar nix gefragt!\n");
   say(TP->Name()+" antwortet etwas.\n", TP);
   say("Der Mund sagt zu "+TP->name()+": Ich hab Dich doch gar nix gefragt!\n", TP);
   return 1;
}


int antworten(string str)
{
  if(!str)
  {
    write("Was willst Du antworten?\n");
    return 1;
  }

if(TP->QueryProp(P_SP) < 5)
  {
     write("Du kannst Dich nicht genug konzentrieren.\n");
     return 1;
  }
  write ("Du antwortest: "+CAP(str)+"\n");
  say(TPN+" antwortet dem Mund etwas.\n", TP);
  TP->restore_spell_points(-5);
  if (member(antwort, str) > -1)
  {
    write("Der Mund sagt: RICHTIG!\n");
    say("Der Mund sagt: RICHTIG!\n", TP);
    rand=random(N_FRAGEN)+1;
    RemoveCmd("antworte");
    AddCmd("antworte", "antworten2");
    geloest(TP);
    return 1;
  }
   write ("Der Mund sagt: FALSCH!\n");
   say ("Der Mund sagt: FALSCH!\n", TP);
   return 1;
}

int wuscheln(string str)
{
  string dummy;
  if (str && (sscanf(str, "mun%s", dummy)))
  {
    write ("Ein Mund hat keine Haare!\n");
    return 1;
  }
  return 0;
}

heilung(object wer)
{
   if(0 < heal--)
   {
     tell_room(ENV(wer),
       "Der Mund sagt: Ah! Du willst geheilt werden? Bittesehr!\n");
     wer->restore_spell_points(500);
     wer->reduce_hit_point(-500);
     tell_object(wer, "Du fuehlst Dich total erfrischt.\n");
   }
   else
     tell_room(ENV(wer),
       "Der Mund sagt: Es ist leider keine Heilung mehr uebrig! Pech!\n");
   if(heal < 0) heal = 0;
}

zaubertrank(object wer)
{
   if(wer->FindPotion(BS(
     "Der Mund spuckt einen Zaubertrank aus, den Du auffaengst und sofort "
     "austrinkst. Die prickelnde Wirkung setzt gleich darauf ein.")));
   else
     tell_object(wer, BS(
       "Der Mund spuckt einen Zaubertrank aus, den Du auffaengst und sofort "
       "austrinkst. Leider bleibt jede Wirkung aus."));

}

string QueryHeilung()
{
  return ""+heal+"";
}

einlass(object wer)
{
   tell_object(wer,
     "Der Mund oeffnet sich und verschlingt Dich mit Haut und Haaren.\n");
   if (objectp(ENV(wer))) tell_room( ENV(wer),
     "Der Mund oeffnet sich und verschlingt "+TP->name(WEN)+".\n", ({wer}) );
   wer->move(ROOM "geheimhaus", M_TPORT);
}

get_titel(string str, object wer)
{
   wer->SetProp(P_TITLE, str);
   tell_object(wer, "Ok, Dein Titel lautet nun '"+str+"'!\n");
}

titel(object wer)
{
  tell_object(wer,
    "Der Mund sagt: Du willst Deinen Titel aendern? Gut.\n"+
    "Dein jetziger Titel lautet: '"+ wer->QueryProp(P_TITLE) +"'.\n"+
    "Neuer Titel: ");
  tell_room(ENV(wer), wer->Name()+ " aendert seinen Titel.\n", ({wer}));
  input_to("get_titel", 0, wer);
}

get_presay(string str, object wer)
{
   wer->SetProp(P_PRESAY, str);
   tell_object(wer, "Ok, Dein Presay lautet nun '"+str+"'!\n");
}

presay(object wer)
{
  tell_object(wer,
    "Der Mund sagt: Du willst Dein Presay aendern? Gut.\n"+
    "Dein jetziges Presay lautet: '"+ wer->QueryProp(P_PRESAY) +"'.\n"+
    "Neues Presay: ");
  tell_room(ENV(wer), wer->Name()+ " aendert sein Presay.\n", ({wer}));
  input_to("get_presay", 0, wer);
}

teleport(object wer)
{
  int tport_rand;

  tport_rand = random(100);
  tell_object(wer,
    "Der Mund sagt: Du hast Dich fuer einen Teleport nach Midas "+
    "entschieden.\n"+
    "Der Mund sagt: Nun gut, mal sehen, ob ich das schaffe...\n");
    if(tport_rand < 50)
       tell_object(wer, "Hubs! Da ist etwas schiefgegangen!\n");
    else
       tell_object(wer, "Alles gutgegangen. Viel Spass in Midas!\n");
    tell_room(ENV(wer), wer->Name()+" wird vom Mund wegteleportiert.\n",({wer}));

//  DB(tport_rand);
  switch(tport_rand)
  {
    case 0..4: wer->move("/d/ebene/lamuerte/wwald/room/wasser", M_TPORT);
      break;  // Wasserdaemon
    case 5..9: wer->move("/d/dschungel/feyaria/tijara/room/kult", M_TPORT);
      break;  // Ketzer
    case 10..14: wer->move("/d/gebirge/monimor/room/klammkneipe", M_TPORT);
      break;  // Kneipe von monimor
    case 15..19: wer->move("/d/dschungel/feyaria/felseninsel/room/klippe",
      M_TPORT); break;  // Felseninsel
    case 20..24: wer->move("/d/ebene/woody/tempel/room/tempel1", M_TPORT);
      break;  // Dunkeltroll
    case 25..29: wer->move("/d/ebene/Midas/room/kanal/kanal2_g8", M_TPORT);
      break;  // Kanalisation (besonders fies ohne stiefel)
//    case 30..34: wer->move("/d/ebene/trogor/room/kerkerz", M_TPORT);
//      break;  // Kerkerzelle im Feenschloss
    case 30..34: wer->move("/d/ebene/ronja/feenquest/room/kerkerz", M_TPORT);
      break;  // neue Kerkerzelle von Ronja im Feenschloss
    case 35..39: wer->move("/d/gebirge/angrox/room/ebene4/ebene4_x10y1",
      M_TPORT); break;  // Zwergenminen (weit weit unten)
    case 40..44: wer->move("/d/ebene/Silberwald/room/hoehle/hoe3", M_TPORT);
      break;  // Silberwald-Baer, changed 25.02.2001 Zordan
    case 45..49: wer->move("/d/huegelland/feyaria/weg/room/huette", M_TPORT);
      break;  // Bergwacht-Huette
    default: wer->move("/gilden/abenteurer", M_TPORT);
  }
}

bonbon(object wer)
{
   tell_object(wer,
     "Der Mund sagt: Da! Hier hast Du ein Bonbon!\n"
     "Der Mund spuckt Dir ein Bonbon in die Haende.\n");
   tell_room(ENV(wer),
     "Der Mund spuckt "+wer->name(WEM)+" ein Bonbon in die Haende.\n", ({wer}));
   clone_object("/players/dusty/obj/notused/bonbon")->move(wer, M_NOCHECK);
}

entsorg(object wer)
{
   tell_object(wer,
     "Der Mund sagt: Ok, was soll ich denn entsorgen?\n"
     "Der Mund sagt: Wenn Du doch nichts entsorgen willst, so gib 'nix' ein.\n"
     "Gegenstand: ");
   input_to("entsorg_chosen", 0, wer);
}

void entsorg_chosen(string choice, object wer)
{
  object ob;

   if(choice == "nix")
   {
      tell_object(wer, "Der Mund sagt: Na gut, ich hab eh keinen Hunger.\n");
      return;
   }

   if(ob=present(choice, wer))
   {
     tell_object(wer, "Der Mund frisst "+ob->name(WEN)+" auf.\n");
     tell_room(MENV, "Der Mund ruelpst.\n");
     ob->SetProp(P_CURSED, 0);
     ob->remove();
   }
   else
   {
     tell_object(wer, "Der Mund sagt: So etwas hast Du nicht.\n");
     entsorg(wer);
   }
}

reset()
{
  remove();
}

int remove()
{
  if(MENV) tell_room(MENV, "Ein paar Aeste verdecken den Mund wieder.\n");
  return ::remove();
}

