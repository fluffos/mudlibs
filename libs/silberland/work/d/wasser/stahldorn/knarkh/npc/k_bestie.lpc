inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die Klauenbestie");
  SetProp(P_LONG, BS(
    "Die Klauenbestie starrt Dich aus finsteren Augen heraus an."
    "Ihre Groesse ist ueberwaeltigend und ihre Gestalt furchterregend. "
    "Den riesigen, schuppenbewehrten Koerper verteidigt sie mit ungeheurer "
    "Schnelligkeit und gigantischer Kraft. Am gefaehrlichsten jedoch sind "
    "die vier langen aber starken Beine mit den gefuerchteten Klauen "
    "daran, die diesem Ungetuem ihren Namen gegeben haben.") );
  SetProp(P_NAME, "Klauenbestie");
  SetProp(P_GENDER, FEMALE);
  AddId(({"bestie", "klauenbestie", "k_bestie"}));
  set_living_name("klauenbestie");
  SetProp(P_INFO, BS("Die Haut der Klauenbestie schimmert leicht magisch."
     "An ihrem Bauch sieht man allerdings alte Verletzungen, die von "
     "Explosionen herzuruehren scheinen.") );
  AddDetail("haut", "Die Haut ist schuppig und schimmert magisch blau.");
  AddDetail("klauen", "Die Klauen sind 50cm lang, scharf und spitz.");
  AddDetail( ({"bauch", "verletzungen"}), BS(
    "Die Verletzungen am Bauch sehen aus wie Schuerf- und Brandspuren. "
    "Sie duerften von einer Bombe oder etwas aehnlichem herruehren.") );
  SetProp(P_SMELL, "Die Klauenbestie stinkt nach Blut und Schwefel.\n");
  SetProp(P_SOUND, "*BRUUUUUEEEEELLLL!*\n");

  create_default_npc(40);
  // P_LEVEL   = x = 
  // P_SP/P_HP = (10+ x*x)    = 
  // P_HANDS   = x*10         = 
  // P_BODY    = x*4          = 
  // P_XP      = HP*HANDS*5   = 
  SetProp(P_ATTRIBUTES, ([ A_DEX:40, A_STR:40, A_INT:40, A_CON:40 ]) );

  SetProp(P_HANDS, ({" mit ihren fuerchterlichen Klauen",400,DT_RIP}));
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 200);
  SetProp(P_XP, 2500000);
  SetProp(P_RACE, "Bestie");
  SetProp(P_SIZE, 450);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,200);
  SetProp(P_AGGRESSIVE, 0.05);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS  , ([ DT_MAGIC:-0.3, DT_EXPLOSION:2 ]));
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt bruellend hereingestampft");
  SetProp(P_MSGOUT, "stampft wuetend");
  SetProp(P_MMSGIN, "wird nun hier wueten");
  SetProp(P_MMSGOUT, "versinkt brodelnd im Erdreich");

  SetProp(P_DIE_MSG,  " stirbt in einem entsetzlichen Aufschrei.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "WAAAAAAAAAAAAARGHHHHHHHH!");
  SetProp(P_KILL_NAME, "Die entsetzliche Klauenbestie");
  SetProp(P_KILL_MSG, "bruellt, als sie sich ueber ihre Mahlzeit hermacht.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0 ]));

  AddInfo(DEFAULT_INFO, "bruellt fuerchterlich.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Klauenbestie will nur DICH!\n" }) );

  SetProp(P_SPELLRATE,65);
  AddSpell(1,900,
    "Die Klauenbestie schlitzt Dir den Bauch auf.\n",
    "Die Klauenbestie schlitzt @WESSEN Bauch auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,900,
    "Die Klauenbestie waelzt ihren Leib auf Dich.\n",
    "Die Klauenbestie waelzt ihren Leib auf @WEN.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Die Klauenbestie stellt sich auf die Hinterbeine kreischt entsetzlich\n"
   +"laut auf. Die Luft droehnt und die Erde bebt.\n",
    "Die Klauenbestie kreischt @WEM ins Ohr.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,500,
    "Die Klauenbestie zerschmettert Dich mit ihren Klauen.\n",
    "Die Klauenbestie zerschmettert @WEN mit ihren Klauen.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
  "Die Klauenbestie bruellt Dich an.\n", 
  "Die Klauenbestie schnauft.\n",
  "Die Klauenbestie schaut Dich gierig an.\n",
  "Die Klauenbestie schnueffelt am Boden herum.\n",
  "Die Klauenbestie nagt an einem der Gitterstaebe.\n",
  "Deine Ohren droehnen, als die Bestie einen fahren laesst...\n"}) );



  SetAttackChats(10, ({
  "Die Klauenbestie bruellt fuerchterlich auf.\n", 
  "Die Klauenbestie waelzt sich geschickt herum.\n",
  "Die Klauenbestie versucht, Dich zu erdruecken.\n",
  "Die Klauenbestie versucht, Dir den Kopf abzureissen.\n",
  "Die Klauenbestie kreischt.\n",
  "Die Klauenbestie stampft am Boden auf.\n",
  "Der Atem der Bestie stroemt warm in Dein Gesicht.\n"}) );

  SUID;
  CLONEME(OBJ "klauen" );
}

public void init() {
  object task;
  ::init();

  task =present(BARD_ID_GS8_TASK, TP);
  if(objectp(task)) {
    call_out("bard_sees_me", 0, task, TP);
  }
}

public void bard_sees_me(object task, object pl) {
  tell_object(pl, BS("Jetzt, da du " + name(WEN, 1) + " erblickst bekommst du grosse Angst!"));
  tell_room(ENV(TO), BS(pl->Name(WER, 1) + " erblickt " + name(WEN, 1) + " und wird kreidebleich."), ({pl}));

  task->SetBeastSeen(3);
  return;
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  object item;
  if((item=present("\npaladintaskitem", TP)) && item->GetTask(15, TP)) 
    item->SetFlag(1);
  if(item = present("\nzechpreller_quest_11", TP))
     item->Mark(poisondeath);
  
  write_file(LOG "npc.kills",
    ctime()+": "
    +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WEN))
    +" killt die Klauenbestie.\n");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spieler killt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  write_file(LOG "npc.deads",
    ctime()+": Die Klauenbestie hat "
    +((player->QueryProp(P_FROG))?CAP(getuid(player)):player->name(WEN))
    +" umgebracht.\n");
}
