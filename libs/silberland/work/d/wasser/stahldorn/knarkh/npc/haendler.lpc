
inherit "std/npc";

#include <properties.h>
//#include <language.h>
#include <moving.h>
#include "../def.h"
#include <combat.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Haendler");
  SetProp(P_LONG, BS(
    "Der alte Haendler schaut Dich muede aus seinen faltigen Orkaugen heraus "
    "an. Seine zerrissene Kleidung und sein armes Aussehen erwecken "
    "Mitleid in Dir.") );
  SetProp(P_NAME, "Haendler");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Ork");
  AddId(({"haendler", "ork", "KnarkhHaendler"}));

  create_default_npc(13);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit alten Zitterhaenden",25,DT_BLUDGEON}));
  SetProp(P_SIZE, 150);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_XP, 0);

  SetProp(P_MSGIN, "kommt aus dem Lagerraum zurueck");
  SetProp(P_MSGOUT, "holt was aus dem Lagerraum");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "Wie bitte? Ihr muesst schon lauter sprechen!", 
         "sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
     "Der Haendler steckt @WEN gedankenverloren ein.\n" }) );

  SetChats(2, ({
  "Der Haendler sagt: Ich verkauf soooo wenig.\n",
  "Der Haendler sagt: Ich versteh nicht, wieso die Leute nie etwas kaufen wollen.\n",
  "Der Haendler seufzt.\n",
  "Der Haendler reibt sich seine mueden Augen. \n",
  "Der Haendler langweilt sich.\n",
  "Der Haendler blaettert in seiner Zeitung.\n"+
  "Der Haendler murmelt: Ach, meine Augen sind schon so schlecht.\n"+
  "Der Haendler murmelt: Ich seh schon gar nichts mehr.\n"+
  "Der Haendler legt die Zeitung wieder weg.\n",
  "Der Haendler sagt: Also damals war alles ganz anders...\n"}) );


}

