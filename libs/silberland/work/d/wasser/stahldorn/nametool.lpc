       TP->SetProp(P_PRESAY, ANSI_PURPLE+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun purpur.\n");
       return 1;
    case "cyan":
       TP->SetProp(P_PRESAY, ANSI_CYAN+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun cyan.\n");
       return 1;
    case "weiss":
       TP->SetProp(P_PRESAY, ANSI_WHITE+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun weiss.\n");
       return 1;
    case "schwarz":
       TP->SetProp(P_PRESAY, ANSI_BLACK+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun schwarz.\n");
       return 1;
    case "fett":
    case "bold":
       TP->SetProp(P_PRESAY, ANSI_BOLD+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun fett.\n");
       return 1;
    case "invers":
    case "revers":
       TP->SetProp(P_PRESAY, ANSI_INVERS+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun invers.\n");
       return 1;
    case "underl":
    case "unterstrichen":
    case "underline":
       TP->SetProp(P_PRESAY, ANSI_UNDERL+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun unterstrichen.\n");
       return 1;
    case "blinkend":
    case "blink":
       TP->SetProp(P_PRESAY, ANSI_BLINK+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun blinkend.\n");
       return 1;
    default:
       return 0;
  }
}
