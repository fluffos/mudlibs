#include "./def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <ansi.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Nametool");
  SetProp(P_LONG, BS( 
   "Das Nametool. Mach einfach 'tooltitel <farbe>' oder 'toolpresay <farbe>'."));
  SetProp(P_NAME, "Nametool");
  SetProp(P_GENDER, MALE);
  AddId( ({ "nametool", "Tool" }));

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  AddCmd( ({ "tooltitel", "tooltitle", "ttitle", "ttitel" }), "title");
  AddCmd( ({ "toolpresay", "tpresay" }), "presay");
}

int title(string str)
{
   notify_fail("Welches Attribut soll der Titel haben?\n");
    switch(str)
   {
    case "gruen":
       TP->SetProp(P_TITLE, ANSI_GREEN+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun gruen.\n");
       return 1;
    case "rot":
       TP->SetProp(P_TITLE, ANSI_RED+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun rot.\n");
       return 1;
    case "gelb":
       TP->SetProp(P_TITLE, ANSI_YELLOW+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun gelb.\n");
       return 1;
    case "blau":
       TP->SetProp(P_TITLE, ANSI_BLUE+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun blau.\n");
       return 1;
    case "purpur":
    case "magenta":
       TP->SetProp(P_TITLE, ANSI_PURPLE+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun purpur.\n");
       return 1;
    case "cyan":
       TP->SetProp(P_TITLE, ANSI_CYAN+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun cyan.\n");
       return 1;
    case "weiss":
       TP->SetProp(P_TITLE, ANSI_WHITE+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun weiss.\n");
       return 1;
    case "schwarz":
       TP->SetProp(P_TITLE, ANSI_BLACK+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun schwarz.\n");
       return 1;
    case "fett":
    case "bold":
       TP->SetProp(P_TITLE, ANSI_BOLD+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun fett.\n");
       return 1;
    case "invers":
    case "revers":
       TP->SetProp(P_TITLE, ANSI_INVERS+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun invers.\n");
       return 1;
    case "underl":
    case "unterstrichen":
    case "underline":
       TP->SetProp(P_TITLE, ANSI_UNDERL+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun unterstrichen.\n");
       return 1;
    case "blinkend":
    case "blink":
       TP->SetProp(P_TITLE, ANSI_BLINK+TP->QueryProp(P_TITLE)+ANSI_NORMAL);
       write("Ok, Titel ist nun blinkend.\n");
       return 1;
    default:
       return 0;
  }
}


int presay(string str)
{
   notify_fail("Welches Attribut soll der Presay haben?\n");

   switch(str)
   {
    case "gruen":
       TP->SetProp(P_PRESAY, ANSI_GREEN+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun gruen.\n");
       return 1;
    case "rot":
       TP->SetProp(P_PRESAY, ANSI_RED+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun rot.\n");
       return 1;
    case "gelb":
       TP->SetProp(P_PRESAY, ANSI_YELLOW+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun gelb.\n");
       return 1;
    case "blau":
       TP->SetProp(P_PRESAY, ANSI_BLUE+TP->QueryProp(P_PRESAY)+ANSI_NORMAL);
       write("Ok, Presay ist nun blau.\n");
       return 1;
    case "purpur":
