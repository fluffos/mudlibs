inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../def.h"
#include <wizlevels.h>
#include "/gilden/bardengilde/barden_extern.h"

object *leute;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  leute = ({});

  SetProp(P_SHORT, "Johannes der Fluechtling");
  SetProp(P_LONG, BS(
    "Johannes ist ein alter Mann, der Zeit seines Lebens gut und redlich war. "
    "Durch einen dummen Zufall wurde er nach Knarkh verschleppt, konnte jedoch "
    "gluecklicherweise fliehen. Allerdings scheint er einen kleinen "
    "Knacks davongetragen zu haben.") );
  SetProp(P_NAME, "Johannes");
  set_living_name("johannes");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"johannes", "fluechtling", "mann"}));

  create_default_npc(10);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_XP, 0);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 169);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOATTACK, 
    "weint.\nDu bekommst Mitleid und hoerst sofort auf, zu kaempfen.");

  SetProp(P_MSGIN, "schleppt sich herein");
  SetProp(P_MSGOUT, "schleppt sich");

  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "Haeh? Geh NICHT nach Knarkh!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Johannes sagt: Nein, das will ich nicht, das ist sicher aus Knarkh.\n"}));

  AddInfo( ({ "knarkh" }), 
     "Wenn Du dem Weg weiter nach Sueden folgst, "
     "kommst Du nach Knarkh, aber geh JA NICHT dorthin! Denn reinzukommen "
     "ist einfach, aber viele Leute sind schon gestorben, weil sie nicht "
     "mehr fliehen konnten. "
     "Mir ist die Flucht damals dustyseidank gelungen. Aber "
     "es war knapp. Und da man in Knarkh das Gute hasst, solltest Du schon "
     "mieser Gesinnung sein, um einigermassen passable Ueberlebenschancen "
     "zu haben.", 
     "sagt: ");
  AddInfo( ({ "weg" }), 
     "Der Weg fuehrt nach Knarkh. Ich flehe Dich an, geh dort nicht hin!", 
     "sagt: ");
  AddInfo( ({ "gesinnung" }), 
     "Sei boese, dann tun sie Dir in Knarkh vielleicht nichts. "
     "Aber am besten ist, Du gehst nicht hin!", "sagt: ");
  AddInfo( ({ "flucht", "geschichte" }), 
     "Meine Flucht ist eine lange Geschichte, die ich hier nicht erzaehlen "
     "kann. Aber ich kann Dir verraten, dass ein riesengrosser Mund mir "
     "bei der Flucht geholfen hat. Gepriesen sei dieser Mund.", "sagt: ");
  AddInfo( ({ "mund", "mauer mit mund", "mund in mauer" }), 
     "Ich weiss, es klingt bloed, aber der Mund war in einer Mauer drin!", 
     "sagt: ");
  AddInfo( ({ "mauer" }), 
     "Welche Mauer? Die wo der Mund drin war?", "sagt: ");
  AddInfo( ({ "dobbodox", "tod" }), 
     "faengt fuerchterlich zu zittern an.\n");
  AddInfo( ({ "fluechtling", "johannes" }), 
     "Ja, ich bin ein Fluechtling und heisse Johannes.", "sagt: ");
  AddInfo( ({ "stahldorn" }), 
     "Lieber Kerl. Der clont mich manchmal.", "sagt: ");
  AddInfo( ({ "chancen", "chance", "ueberlebenschance", "ueberlebenschancen"}), 
     "Hast Du nur, wenn Du boese bist.", "sagt: ");
  AddInfo( ({ "dusty", "woody", "gott", "goettin", "goetter" }), 
     "Dusty und Woody sind Goetter, aber ich glaub nicht so recht, dass es "
     "die wirklich gibt. Ich meine, es gibt schon so eine Macht ueber uns, "
     "aber das ist mehr so eine Art Kraft. So einen Bilderbuchgott, der "
     "herumlaeuft und redet und so... Hihi, den gibts sicher nicht.", "sagt: ");
  AddInfo( ({ "hilfe" }), 
     "Die Goetter moegen dir helfen, wenn Du weitergehst.", "sagt: ");
  AddInfo( ({ "bilderbuchgott" }), 
     "Sowas gibts in Wirklichkeit nicht.", "sagt: ");
  AddInfo( ({ "kraft" }), 
     "Wasweissich was das fuer eine Kraft ist. Jedenfalls ist sie "
     "allmaechtig und ausserhalb dieses Universums.", "sagt: ");
  AddInfo( ({ "universum" }), 
     "Silberland heisst unser Universum. Das weiss ich aus geheimer Quelle.",
     "sagt: ");
  AddInfo( ({ "quelle" }), 
    "Na gut, sags nicht weiter, aber Stahldorn hats mir verraten.","sagt: ");
  AddInfo( ({ "knarkhist", "waechter", "knarkhisten"}), 
     "zittert voller Angst.\n");
  AddInfo( ({ "monster", "bestien", "bestie", "eliteknarkhist", 
     "powerknarkhisten", "powerknarkhist", "eliteknarkhist"}), 
     "zittert ganz unbeschreiblich.\n");
  AddInfo( ({ "ausgang" }), 
     "Der Ausgang wird bewacht!", "sagt: ");
  AddInfo( ({ "zufall" }), 
     "Ach, ich war einfach unvorsichtig.", "sagt: ");
  AddInfo( ({ "statue" }), 
     "Hmm. In Knarkh? Ja, da steht eine Statue. Keine Ahnung, was die "
     "darstellen soll.", "sagt: ");
  AddInfo( ({ "kneipe", "bauchstich", "goldenem bauchstich" }), 
     "Der Goldene Bauchstich ist die Kneipe in Knarkh.", "sagt: ");
  AddInfo( ({ "plaza" }), 
     "Dort wimmelt es von Powerknarkhisten!", "zittert: ");

  // BARDEN INFO
  AddInfo( ({"lied", "bardenlied", "zauberlied", "wiegenlied", "wiegenlied des leids"}),
    "Warum willst du denn sowas wissen?! Ich habe in Knarkh schon genug Leid "
    "erfahren, dass ich darueber ein Lied schreiben koennte!@@bard_info@@", "sagt: ");

//  AddInfo( ({ "" }), 
//     "", "sagt: ");

  SetProp(P_LOG_INFO, "stahldorn/johannes.log");

  SetChats(3, ({
   "Johannes sagt: Geh nicht nach Knarkh! Ich warne Dich!\n", 
   "Johannes kichert verrueckt.\n", 
   "Johannes sagt: Ein Mund! Hihi! Ja, ein Mund wars. In einer Mauer! Hihi!\n", 
   "Johannes sagt: Scheiss Dobbodox.\n", 
   "Johannes weint: Ich will nicht nach Knarkh!\n", 
   "Johannes seufzt.\n", 
   "Johannes fragt Dich: Du weisst, dass in Knarkh der Tod lauert?\n", 
   "Johannes sagt: Ach waer ich doch gestorben.\n" }) );

}

public string bard_info() {
   object ob;
   if(TP->QueryProp(P_GUILD) == "bardengilde" && 
      call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", TP) == BARD_GROUP_SARRIAN &&
      TP->QuerySkill("wiegenlied des leids") == 0 && 
      !objectp(present(BARD_ID_GS8_TASK, TP))) {
      ob = clone_object("/gilden/bardengilde/obj/quest/gs8_sarrian_task");
      ob->move(TP, M_GET|M_NOCHECK);
      return " Wenn du wirklich verstehen willst, was Angst ist, dann solltest "
             "du dir die vier Bestien in Knarkh ansehen. Nur ansehen!!! Nicht "
             "angreifen! Sonst toeten sie dich!!!";
   }
   return "";
}


init()
{
  ::init();

  if(!IS_WIZARD(TP) && member(leute, TP) < 0)
  {
    tell_object(TP, break_string(
      "Um Himmels Willen, geh nicht weiter! In Knarkh lauert der Tod auf Dich, "
      + TP->name() +"! Wenn Du nicht sterben willst, so kehr wieder um.", 
      78, "Johannes sagt: "));
    leute += ({TP});
  }
}


