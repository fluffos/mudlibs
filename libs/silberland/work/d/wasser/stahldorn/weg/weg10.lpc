#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Knarkh liegt nun nur noch ein kleines Stueck suedoestlich von Dir. " 
    "Auch wenn es schwer ist, bei dem Zwielicht etwas zu erkennen, denn "
    "der Himmel verdunkelt sich immer mehr und die Sonne kommt kaum noch " 
    "durch die dicke Wolkendecke, siehst Du nun deutlich so etwas wie eine "
    "Palisade, die Knarkh zu umgeben scheint. Das Meer und die Lagune, "
    "welche den Weg auf die Halbinsel flankieren, erscheinen immer "
    "schwaerzer. Unheimliches Gefluester erfuellt den Ort. An den verdorrten "
    "Straeuchern finden sich kaum mehr Blaetter."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22]) );


  AddDetail( ({"weg", "boden"}), BS(
    "Auf dem felsigen Boden ist kein Weg mehr zu erkennen. Doch Du weisst "
    "ja, wohin Du gehen musst!"));
  AddDetail( ({"knarkh", "dorf", "stadt"}), BS(
    "Knarkh ist nun schon sehr nahe. Aber ausser der Palisade kannst Du wegen "
    "dem Zwielicht hier kaum was sehen."));
  AddDetail( ({"zwielicht", "licht"}), BS(
    "Wie sollst Du auch etwas erkennen koennen, wenn sich die Sonne kaum "
    "mehr blicken laesst, weil die Wolken einfach zu dicht sind?"));
  AddDetail( ({"himmel", "sonne"}), BS(
    "Am Himmel ueber Dir siehst Du die Sonne kaum mehr, da sie meist "
    "von Wolken verdeckt ist."));
  AddDetail( ({"wolken", "wolkendecke"}), BS(
    "Die Wolken werden immer dichter und lassen die Sonne kaum durch. "
    "Es sind duestere, finstere, schwarze, dunkle und boese Wolken."));
  AddDetail( ({"finstere wolken"}), 
    "Sie lassen nur wenig Licht durch.\n");
  AddDetail( ({"boese wolken"}), 
    "Sie machen Dir Angst.\n");
  AddDetail( ({"schwarze wolken"}), 
    "Sie sind pechschwarz und verheissen nichts Gutes.\n");
  AddDetail( ({"dunkle wolken"}), 
    "Sie verbergen sicher etwas vor Dir.\n");
  AddDetail( ({"duestere wolken"}), 
    "Sie verschlechtern Deine Stimmung erheblich.\n");
  AddDetail( ({"meer", "wasser"}), BS(
    "Das Meer suedlich von Dir ist mehr schwarz als blau. Sein Rauschen "
    "verstaerkt Deine Angst!"));
  AddSound( ({"meer", "rauschen"}), 
    "Das Meer rauscht deutlich hoerbar.\n");
  AddSound( ({"gefluester", "fluestern"}),
    "Eine Stimme fluestert: In Knarkh lauert der Tod auf Dich!\n");
  AddDetail( ({"lagune"}), BS(
    "Die Lagune befindet sich oestlich von Dir. Das andere Ufer kannst "
    "Du leider nicht erkennen, weil es zu weit weg ist."));
  AddDetail( ({"ort"}), BS(
    "Dieser Ort ist so unheimlich, dass Du beschliesst, so schnell wie "
    "moeglich weiterzugehen."));
  AddDetail( ({"straeucher"}), BS(
    "Nur mehr wenige Straeucher wachsen hier. Ihre Zweige sehen arg "
    "verkuemmert aus."));
  AddDetail( ({"zweige"}), BS(
    "Die Zweige dieser Straeucher sehen so oed aus, wie alles hier. "
    "Kaum mehr Blaetter finden sich an ihnen."));
  AddDetail( ({"blaetter"}), BS(
    "Die paar Blaetter, die sich an den Zweigen finden, sind verdorrt. Nur "
    "ein kleines gruenes Blitzen ist dazwischen zu sehen."));
  AddDetail( ({"blitzen"}), BS(
    "Als Du genauer hinsiehst, erkennst Du einen gruenen Stoffetzen!"));
  AddDetail( ({"stofffetzen", "stoffetzen", "fetzen", "stoff"}), BS(
    "Auf dem gruenen Stoffetzen siehst Du rote Zeichen."));
  AddDetail( ({"zeichen", "blut"}), BS(
    "Dich schaudert, als Du erkennst, dass die Zeichen getrocknetes Blut "
    "sind. Du liest: 'Kehre um, bevor es zu spaet ist!'"));
  AddReadDetail( ({"zeichen", "blut"}), 
    "'Kehre um, bevor es zu spaet ist!'\n");
  AddDetail( ({ "palisade" }), 
    "Eine Palisade umgibt Knarkh. \n");
  AddSound( ({ DEFAULT_SOUND }), 
    "Du hoerst das Meer rauschen.\n");
  AddDetail( ({ "angst" }),
    "Maaaaammmaaaaaaa!");


//  AddDetail( ({ "" }), 
//    "");


  AddExit("nordwesten", WEGPATH "weg9");
  AddExit("suedosten", WEGPATH "weg11");

}

