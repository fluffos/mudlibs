#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Es wird immer unheimlicher. Jetzt kannst Du kaum mehr etwas sehen. Am "
    "Himmel findet die Sonne kaum mehr durch die Wolken. Das Meer rauscht "
    "immer bedrohlicher. Das Schweigen der Lagune bildet dazu einen " 
    "schauerlichen Kontrast. Gras waechst keines mehr, auch keine "
    "Straeucher, es gibt auch nur ein bisschen Erde zwischen den "
    "Felsbrocken, die den Weg bilden. Fast haettest Du in all der "
    "Duesternis uebersehen, dass sich Knarkh nun unmittelbar vor Dir "
    "befindet."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22]) );

  AddDetail( ({"weg", "boden"}), BS(
    "Der Weg macht hier noch einmal eine letzte Biegung nach Osten, wo"
    " Du einen Eingang in der Palisade erkennen kannst."));
  AddDetail( ({"stadt", "knarkh", "dorf"}), BS(
    "Du stehst nun unmittelbar davor. Seltsam, dass das so schnell gegangen "
    "ist, denn eben warst Du doch noch ein ganzes Stueck entfernt... "
    "Der Zugang zu Knarkh wird Dir hier allerdings noch durch eine "
    "Palisade verwehrt."));
  AddDetail( ({"himmel", "sonne"}), BS(
    "Vom blauen Himmel oder der Sonne ist nichts mehr zu sehen. Die "
    "Wolken verdecken und verfinstern alles."));
  AddDetail( ({"wolken"}), BS(
    "Die Wolken werden immer dichter und lassen die Sonne und den Himmel "
    "nicht mehr durchkommen. Es sind duestere, schwarze Wolken, die "
    "bedrohlich wirken."));
  AddDetail( ({"erde"}), BS(
    "Zwischen den Felsbrocken findet sich nur ein kleines bisschen Erde, "
    "zu wenig, als dass irgendetwas wachsen koenne."));
  AddDetail( ({"gras", "straeucher"}), BS(
    "Jetzt findet sich hier nichts mehr. Nach und nach ist alles liebliche "
    "verschwunden. So auch das Gras und die Straeucher. Es schaut trostlos "
    "aus."));
  AddDetail( ({"felsbrocken"}), BS(
    "Der Weg besteht nur mehr aus harten Felsen. Es ist nicht angenehm, "
    "hier zu gehen."));
  AddDetail( ({"felsen"}), 
    "Als Du die Felsen genauer betrachtest, entdeckst Du an einem Fels "
    "etwas.\n");
  AddDetail( ({"fels"}), 
    "In diesen Felsen hat jemand eine Nachricht geritzt.\n");
  AddReadDetail( ({"nachricht", "fels"}), 
    "Nun kannst Du weitergehen, nun ist schon alles zu spaet!\n");
  AddDetail( ({"schweigen", "kontrast"}), 
    "Kein Laut ist von der Lagune zu hoeren.\n");
  AddDetail( ({"lagune"}), BS(
    "Schwarz und still liegt die Lagune nordoestlich von Dir."));
  AddDetail( ({"meer", "wasser"}), BS(
    "Nun schimmert das Meer nur noch schwarz, und nicht mehr blau. Auch "
    "sein Rauschen laesst es toedlich wirken."));
  AddSound( ({DEFAULT_SOUND, "meer", "rauschen"}), 
    "Das Meer rauscht bedrohlich.\n");
  AddDetail( ({"palisade", "mauer", "wall", "schutzwall"}), BS(
    "Die Palisade umgibt Knarkh wie einen Schutzwall und laesst keinen raus "
    "und keinen rein. Nur oestlich von Dir befindet sich ein Eingang."));
  AddDetail( ({"eingang", "ausgang"}), 
    "Der Eingang zu Knarkh befindet sich weiter oestlich.\n");
  AddDetail( ({ "nachricht" }), 
     "Lies sie doch!\n" );
  AddDetail( ({ "duesternis" }), 
     "Die Duesternis ist ziemlich finster. Aber genaugenommen ist "
     "sie unsichtbar." );
  AddDetail( ({ "angst" }),
     "Du hast schreckliche Angst." );

//  AddDetail( ({ "" }), 
//     "" );

  AddExit("osten", WEGPATH "weg12");
  AddExit("nordwesten", WEGPATH "weg10");

}
