#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Der Weg nach Knarkh wird immer schmaler. Das Wasser gewinnt immer mehr "
    "die Oberhand. Die Lagune und das Meer lassen nicht mehr viel Land "
    "uebrig. Es wachsen zwar Gras und Straeucher am Rande des Weges, "
    "doch sehr viel angenehmer machen sie die Gegend nicht."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );

  AddDetail( ({"gegend"}), BS(
    "Die Gegend wird immer unheimlicher! Pass gut auf Dich auf!"));
  AddDetail( ({"weg", "boden"}), BS(
    "Der Weg, dem Du schon lange nachgehst, wird hier immer schmaler, "
    "das Meer und die Lagune reichen schon weit heran."));
  AddDetail( ({"land", "festland"}), BS(
    "Festland ist hier nicht mehr viel uebrig."));
  AddDetail( ({"gras", "blumen"}), BS(
    "Auf dem Boden waechst noch ein bisschen, kuemmerliches Gras. Von "
    "den schoenen Blumen ist nichts mehr zu sehen."));
  AddDetail( ({"straeucher", "blaetter"}), BS(
    "Die Straeucher am Rande sehen auch erbaermlich aus. Es sind kaum "
    "noch Blaetter an ihnen. Es ist unheimlich."));
  AddDetail( ({"rand", "rande"}), BS(
    "Am Rand des Weges findet sich nur ein bisschen Gras und einige "
    "verdorrte Straeucher. Wohin ist bloss das herrliche Gruen von vorhin "
    "verschwunden?"));
  AddDetail( ({"gruen"}), "Hier findest Du kaum mehr Gruen! Leider!\n");
  AddDetail( ({"stadt", "knarkh", "dorf"}), 
    "Du bist leider immer noch zu weit weg.\n");
  AddDetail( ({"wasser", "oberhand"}), BS(
    "Rund um Dich siehst du kaum mehr gruen, sondern fast "
    "ausschliesslich blauschwarz."));
  AddDetail( ({"meer"}), BS(
    "Das Meer ist hier schon mehr schwarz als blau. Sein Rauschen kommt "
    "Dir nicht sehr geheur vor. Als ob namenlose Bestien im Meer hausen und "
    "es immer wieder aufwuehlen und in Bewegung versetzen."));
  AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen des Meeres.\n");
  AddSound( ({"meer", "rauschen"}), BS(
    "Das Meer rauscht deutlich hoerbar, doch irgendwie bestaerkt es nur "
    "das ungewisse Gefuehl, das Du schon laenger hegst."));
  AddDetail( ({"gefuehl"}), BS(
    "Du spuerst es immer deutlicher, dieses ungewisse Gefuehl, Du "
    "koenntest fast meinen, es sei Angst."));
  AddDetail( ({"angst"}), BS(
   "Wieso solltest Du Dich fuerchten? Es erscheint Dir laecherlich und "
   "Du verdraengst dieses Gefuehl schnell wieder."));
  AddDetail( "lagune", BS(
    "Die Lagune nordoestlich von Dir erscheint genauso unheimlich wie "
    "das Meer."));
  AddDetail( ({"himmel", "sonne"}), BS(
    "Am Himmel ueber Dir siehst Du nur sehr selten die Sonne, da sie meist "
    "von Wolken verdeckt ist."));
  AddDetail( ({"wolken"}), BS(
    "Der Grossteil der Wolken ist weiss, doch auch ein paar dunkle sind "
    "nun zu finden."));
  AddDetail( ({"weisse wolken"}), BS(
    "Die meisten der Wolken sind weiss. Sie tuermen sich bis hoch in die "
    "aeussersten Schichten der Atmosphaere auf."));
  AddDetail( ({"dunkle wolken"}), BS(
    "Zu den weissen Wolken gesellen sich nun auch schon einige dunkle "
    "Wolken. Diese sind flacher und scheinen auch irgendwie viel tiefer zu " 
    "haengen als die weissen Wolken."));

  AddExit("osten", WEGPATH "weg9");
  AddExit("nordwesten", WEGPATH "weg7");


}

