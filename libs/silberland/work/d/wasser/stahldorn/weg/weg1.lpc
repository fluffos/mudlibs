#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Du bist am Anfang eines Weges, der unbeirrt immer weiter nach Suedosten "
    "fuehrt. Das Ende des Weges kannst Du noch nicht ausmachen, doch Du willst "
    "ihm gerne weiterfolgen, da er durch seine Lieblichkeit wohl nur Gutes "
    "verheissen kann. Hier waere wohl auch Dr. Faustus stehengeblieben und "
    "haette gerne verweilt. Im Westen siehst Du die Pier, von der aus Du ueber "
    "das riesige, blaue Meer fahren kannst, das sich suedlich von Dir "
    "ausbreitet. Rund um Dich ein Meer von gruenem Gras und herrlichsten "
    "Blumen. Vogelgezwitscher erfuellt den Ort. Die Sonne lacht am Himmel, "
    "Du kannst Dir keinen schoeneren und friedlicheren Platz vorstellen "
    "als hier." )); 

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19]) );

//  AddDetail( ({ "" }),
//    "");

  AddDetail( ({"anfang"}), BS(
    "Jeder faengt mal klein an, doch das passt wohl nicht so ganz hierher. "
    "Jedenfalls beginnt hier ein Weg, dem Du wohl folgen solltest!"));
  AddDetail( ({"weg", "boden", "suedosten"}), BS(
    "Der Weg fuehrt weiter nach Suedosten. Du hast von einer Stadt gehoert, "
    "die sich am Ende dieses Weges befinden soll."));
  AddDetail( ({"stadt", "ende"}), BS(
    "Das Ende dieses Weges kannst Du trotz aller Bemuehungen nicht erkennen. "
    "Du hast aber schon viele Geschichten von einer Stadt gehoert, die sich "
    "dort befinden sollte. Bisher hast Du nicht so recht daran geglaubt, "
    "jetzt koenntest Du es herausfinden."));
  AddDetail( ({"bemuehungen", "augen"}), BS(
    "Obwohl Du Dich sehr anstrengst, ist es Dir nicht moeglich das Ende des "
    "Weges zu erblicken. Deine Augen sind wohl nicht dafuer geschaffen!"));
  AddDetail( ({"lieblichkeit"}), BS(
    "Du bist von diesem Ort einfach fasziniert. Schoener kann es wohl nirgends "
    "sein. Es passt einfach alles zusammen: das Meer, die Blumen, die Sonne, "
    "das Gezwitscher der Voegel. Hier koenntest Du es laenger aushalten."));
  AddDetail( ({"gutes"}), BS(
    "Hier ist es so schoen, dass Du Dir gar nicht vorstellen kannst, dass es "
    "auch anders kommen kann. Deshalb willst Du diesem Weg auch "
    "weiterverfolgen."));
  AddDetail( ({"dr", "faustus", "dr faustus"}), BS(
    "Fuer Dr Faustus sollte das Verweilen der Weg zur Hoelle sein. Ob es das "
    "auch fuer Dich werden wird? Oder eher das Weitergehen?"));
  AddDetail( ({"verweilen", "weitergehen"}), BS(
    "Du musst Dich entscheiden, ob Du weitergehst oder ob Du lieber umkehrst. "
    "Was fuer Dich besser ist, das musst Du selbst entscheiden."));
  AddDetail( ({"hoelle", "angst"}), BS(
    "Die Hoelle ist noch weit entfernt, keine Angst!"));
  AddDetail( ({"geschichten"}), BS(
    "Du hast von einer sagenhaften Stadt gehoert, die sich am Ende dieses "
    "Weges befinden soll! Vielleicht bist Du dazu berufen, diese genauer zu "
    "erforschen."));
  AddDetail( ({"westen", "pier"}), BS(
    "Die Pier ragt weiter westlich von Dir weit ins blaue Meer hinein."));
  AddDetail( ({"meer", "blau", "wasser"}), BS(
    "Das Meer erstreckt sich suedlich von Dir, riesengross und im herrlichsten "
    "Blau! Du starrst vertraeumt hinaus und willst Dich gar nicht "
    "losreissen."));
  AddDetail( ({"gras", "blumen"}), BS(
    "Rings um Dich waechst viel Gras und die schoensten Blumen, die man sich "
    "denken kann! Du fragst Dich, welches Meer wohl schoener ist, das blaue "
    "oder das gruene hier rings um Dich.")); 
  AddDetail( ({"ort", "schoenheiten", "platz"}), BS(
    "Dieser Ort mit seinen einfachen Schoenheiten fasziniert Dich. Am liebsten "
    "wuerdest Du bleiben, doch vielleicht bringt das Weitergehen noch "
    "schoeneres."));
  AddDetail( ({"vogelgezwitscher", "voegel"}), BS(
    "Hoch ueber Dir am Himmel begleiten Voegel Deinen Weg. Sie zwitschern "
    "vergnuegt und verleihen dem Ort noch mehr Lieblichkeit."));
  AddDetail( ({"sonne", "himmel"}), BS(
    "Am blauen Himmel ueber Dir freut sich die Sonne. Voegel schwirren herum. "
    "Es ist einfach schoen!"));      
  AddSound( DEFAULT_SOUND, BS(
     "Du hoerst liebliches Vogelgezwitscher und das Rauschen des Meeres!"));
  AddSound( ({"vogelgezwitscher", "gezwitscher", "voegel"}), BS(
    "Lustig zwitschern die Voegel durcheinander."));
  AddSound( ({"rauschen", "meer"}), BS(
    "Das Meer rauscht friedlich vor sich hin."));
  AddSmell( DEFAULT_SMELL, "Du riechst den herrlichen Duft der Blumen.\n");
  AddSmell( ({"blumen", "duft"}), 
    "Der herrliche Duft ist mit Worten nicht zu beschreiben.\n");


  AddExit("osten", WEGPATH "weg2");
  AddExit("westen", "/d/wasser/woody/fischerdorf/room/weg5");

  AddCmd ("verweile", "verweilen");
}

int verweilen(string str)
{
  write("Du setzt Dich nieder und verweilst einen Augenblick.\n"
        "Du stehst wieder auf und fuehlst Dich so richtig entspannt.\n");
  say(TP->Name()+" macht einen entspannten Eindruck.\n");
  return 1;
}
