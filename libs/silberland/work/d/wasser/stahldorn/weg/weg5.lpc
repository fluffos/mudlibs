#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Allmaehlich bemerkst Du kleine Aenderungen in der Landschaft. Das "
    "Blau des Himmels wird immer mehr vom Weiss der Wolken ueberdeckt. "
    "Die Sonne verschwindet manchmal hinter den Wolken und mit ihr ein "
    "wenig der Zauber dieses Ortes. Auch das Gruen ist nicht mehr so "
    "kraeftig. Die bunten Farbtupfer der Blumen werden immer weniger. Auch "
    "die vertrauten Laute des Meeres und der Voegel aendern sich. Doch in "
    "der Ferne kannst Du nun die Stadt schon deutlicher erkennen. Nach Sueden "
    "fuehrt ein kleiner Weg zum Strand hinunter."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19]) );

  AddDetail( ({"weg", "boden"}), BS(
    "Am Boden siehst Du den Weg, dem Du schon lange folgst."));
  AddDetail( ({"gruen", "gras", "straeucher"}), BS(
    "Die Straeucher und das Gras zeigen nicht mehr das intensive Gruen, "
    "das Du vom Weg vorher kennst. Auch bei den Blumen hat sich "
    "etwas veraendert."));
  AddDetail( ({"blumen", "farbtupfer"}), BS(
    "Noch kurz vorher sah man im lieblichen Gruen viele bunte Farbtupfer, "
    "hunderte Blumen. Jetzt sieht man nur noch sehr wenige, deren Duft "
    "kaum mehr wahrnehmbar ist."));
  AddSmell(DEFAULT_SMELL, BS(
    "Die paar Blumen verbreiten noch suessen Duft, aber nicht mehr sehr " 
    "deutlich."));
  AddDetail( ({"zauber", "ort"}), BS(
    "Langsam aber sicher verschwindet der Zauber, den die Landschaft auf "
    "Dich ausuebt. Ein unbestimmtes Gefuehl beginnt in Dir zu entstehen."));
  AddDetail( ({"gefuehl"}), BS(
    "Noch kannst Du es nicht deutlich fuehlen, was es ist, vielleicht wird "
    "es ja staerker und dann kannst Du es benennen."));
  AddDetail( ({"ferne", "stadt", "dorf"}), BS(
   "Weit suedlich vor Dir siehst Du eine Stadt oder ein Dorf."));
  AddDetail( ({"aenderungen", "aenderung"}), BS(
    "Die Landschaft wandelt sich. Endlich mal ein wenig Abwechslung."));
  AddDetail( ({"abwechslung"}), BS(
   "Eine Abwechslung ist zwar interessant, aber hier scheint sich das "
   "Blatt nicht gerade zum Guten zu wenden!"));
  AddDetail( ({"blatt", "gutes", "guten"}), BS(
    "Das ist doch nur eine Redewendung, nichts, wo man genauer nachforschen "
    "muesste!"));
  AddDetail( ({"redewendung"}), BS(
    "Man soll den Tag nicht vor dem Abend loben, ist ebenfalls eine "
    "Redewendung, die hier vielleicht zutreffen koennte, den Grund wirst "
    "Du noch herausfinden muessen!"));
  AddDetail( ({"tag", "abend", "grund"}), BS(
    "Wenn Du dachtest, dass das Ende des Weges so schoen wird wie der "
    "Beginn, dann koennte die Redewendung zutreffen, aber finde das mal "
    "selbst heraus!"));
  AddDetail( ({"landschaft"}), BS(
    "Um Dich herum siehst Du noch immer Gras und das Meer, doch so schoen "
    "wie vorher, nein, so schoen ist es nicht!"));
  AddDetail( ({"blau", "himmel", "meer", "wasser"}), BS(
   "Blau sind sowohl der Himmel als auch das Meer. Doch die Farben "
   "beginnen sich zu wandeln. Der Himmel zeigt auch immer mehr weiss und "
   "das Meer wird dunkler."));
  AddDetail( ({"farbe", "farben"}), 
    "Das Meer ist dunkler als im Westen und der Himmel bewoelkter.\n");
  AddDetail( ({"voegel"}), BS(
    "Ein paar schwarze Voegel begleiten Dich noch, doch ihr Gezwitscher "
    "ist nicht mehr so froehlich."));

  AddSound(DEFAULT_SOUND, BS(
    "Du hoerst das Rauschen des Meeres und das Gezwitscher der Voegel ueber "
    "Dir."));
  AddSound( ({"laute"}), 
    "Sie sind nicht mehr die selben.\n");
  AddSound( ({"meer", "rauschen"}), 
    "Das Meer rauscht deutlich hoerbar.\n");
  AddSound( ({"voegel", "gezwitscher"}), BS(
    "Das Gezwitscher der Voegel ist zwar weniger geworden, doch noch "
    "begleitet es Dich."));
  AddDetail( ({"wolken", "weiss", "sonne"}), 
   "Es ziehen immer mehr Wolken auf, die die Sonne immer wieder verdecken.\n");
  AddDetail("strand", "Der kleine Weg nach Sueden fuehrt zum Strand hin.\n");
 
  AddExit("suedosten", WEGPATH "weg6");
  AddExit("norden", WEGPATH "weg4");
  AddExit("sueden", OUTLAWPATH "room/eingang");


}

