#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Die Landschaft ist noch immer bezaubernd. Du bereust Deinen Entschluss "
    "nicht, dem Weg noch weiter nachgegangen zu sein. Das Meer ist noch so "
    "blau wie zuvor, das Gras und die Straeucher noch so gruen, die "
    "Blumen duften noch zart und die Voegel sind auch da. Die Sonne spielt "
    "noch immer mit ihren Strahlen und die paar Wolken machen auch nicht "
    "viel Unterschied."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19]) );

  AddDetail( ({"landschaft", "ort"}), BS(
    "Die Strahlen der Sonne erhellen die Landschaft und lassen sie "
    "in strahlendem Licht erscheinen. Im Sonnenschein schauen das Meer, "
    "die Blumen, Straeucher und auch das Gras noch viel schoener aus."));
AddDetail( ({"licht", "strahlen", "sonnenschein"}), BS(
    "Der Sonne waermende Strahlen erhellen die Landschaft und verschoent "
    "sie. Dir wird so leicht ums Herz. Wie koennte man hier auch "
    "ungluecklich sein?"));
  AddDetail( ({"weg", "boden"}), BS(
    "Am Boden siehst Du den Weg, den Du jetzt schon einige Zeit nachgehst. "
    "An seinem Ende wird das Dorf oder die Stadt sein, die man allmaehlich "
    "in der Ferne ausmachen kann."));
  AddDetail( ({"zeit"}), BS(
    "Wie lange Du schon auf diesem Weg gehst, kannst Du nicht genau sagen. "
    "Du willst es aber auch gar nicht wissen. Du erfreust Dich am Meer und "
    "an der Landschaft, das entschaedigt fuer (vielleicht verlorene) Zeit."));
  AddDetail( ({"ende"}), BS(
    "Irgendwann muss auch dieser Weg einmal enden, was Dich dort aber "
    "erwarten wird?"));
  AddDetail( ({"dorf", "stadt", "ferne", "umrisse"}), BS(
    "Weit vor Dir kannst Du bereits die Silhouette von Haeusern erkennen."));
  AddDetail( ({"silhouette", "haeuser"}), BS(
    "Es ist alles noch zu weit weg, um mehr Details auszumachen."));
  AddDetail( ({"meer", "blau", "wasser"}), BS(
    "Suedlich von Dir liegt das blaue Meer, sein Rauschen ist deutlich "
    "zu hoeren."));             
  AddDetail( ({"voegel"}), BS(
    "Ein paar Voegel begleiten Dich noch immer. Doch es sind nicht mehr "
    "so viele wie zuvor."));
  AddSound(DEFAULT_SOUND, BS(
    "Du vernimmst das Rauschen des Meeres und das Gezwitscher der Voegel "
    "ueber Dir. Eine herrliche Mischung!"));
  AddSound( ({"meer", "rauschen"}), BS(
    "Das Meer rauscht zwar nur sanft, es ist aber dennoch deutlich "
    "zu hoeren."));
  AddSound( ({"voegel", "gezwitscher"}), BS(
    "Das Gezwitscher der Voegel ist zwar weniger geworden, doch noch "
    "begleitet es Dich."));
  AddDetail( ({"gras", "blumen", "straeucher"}), BS(
    "Rings um Dich waechst viel Gras, ein paar Straeucher und die "
    "schoensten Blumen. Es scheint aber, dass es immer weniger werden."));
  AddSmell(DEFAULT_SMELL, BS(
    "Die verschiedensten Blumen erfuellen den Ort mit einem suessen Duft, "
    "der zwar nicht mehr so intensiv ist, aber immer noch deutlich "
    "wahrnehmbar."));
  AddSmell( ({ "duft", "blumen" }), BS(
    "Der Duft der Blumen scheint etwas weniger intensiv zu sein als vorhin. "
    "Aber vielleicht kommt Dir das nur so vor."));
  AddDetail( ({"sonne", "himmel", "wolken"}), BS(
    "Am blauen Himmel ueber Dir freut sich die Sonne. Ein paar weisse "
    "Wolken sind zu sehen. Voegel schwirren herum. Es ist einfach schoen!"));
  AddDetail( ({"unterschied"}), BS(
    "Hier sind ein paar Wolken mehr am Himmel und weniger Blumen, aber das "
    "ist nicht so wichtig. Vielleicht taeuschst Du Dich auch nur."));
  AddDetail( ({ "himmel", "sonne" }),
    "Am Himmel lacht die Sonne.\n");

//  AddDetail( ({ "" }),
//    "");


  AddExit("sueden", WEGPATH "weg5");
  AddExit("nordwesten", WEGPATH "weg3");

  AddItem(WEGPATH "johannes", REFRESH_DESTRUCT);

}                                                   

