#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
   "Du folgst dem Weg immer weiter. Noch hat er nichts von seiner Lieblichkeit "
   "eingebuesst. Das Meer rauscht weiter suedlich von Dir vor sich hin. Die "
   "Voegel schwirren um Dich herum. Der Blumen Duft haengt traege in der Luft. "
   "Das Gras blueht so gruen wie zuvor. An den Straeuchern am Rande des Weges "
   "sieht man ebenfalls ein sattes Gruen." ));
 

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19]) );

//  AddDetail( ({ "" }),
//    "");


  AddDetail( ({"weg", "boden", "sueden"}), BS(
    "Der Weg fuehrt weiter in den Sueden. Was Dich dort wohl erwartet?"));
  AddDetail( ({"lieblichkeit"}), BS(
    "Du bist von diesem Ort einfach fasziniert. Es passt einfach alles "
    "zusammen: das Meer, die Blumen, die Sonne, das Gezwitscher der Voegel. "
    "Du bist froh, dass Du weitergegangen bist."));
  AddDetail( ({"ort"}), BS(
    "Dieser Ort ist zwar wunderschoen, doch wenn Du weitergehst, dann "
    "entdeckst Du vielleicht doch noch etwas Schoeneres."));
  AddDetail( ({"anfang"}), BS(
    "Ist dies hier der Anfang von unglaublicher Wundern oder unglaublichen "
    "Schrecken? Das herauszufinden, das ist Deine Aufgabe!"));
  AddDetail( ({"wunder", "schrecken", "aufgabe"}), BS(
    "Versuche doch zu ergruenden, was Dir dieser Weg noch verheisst! Doch "
    "sei auf alles vorbereitet!"));
  AddDetail( ({"meer", "blau", "wasser"}), BS(
    "Das Meer erstreckt sich suedlich von Dir, riesengross und im "
    "herrlichsten Blau! Du starrst vertraeumt hinaus willst Dich gar nicht "
    "losreissen!"));
  AddDetail( ({"vogelgezwitscher", "voegel"}), BS(
    "Hoch ueber Dir am Himmel begleiten Voegel Deinen Weg. Sie zwitschern "
    "vergnuegt und verleihen dem Ort noch mehr Lieblichkeit."));                                        
  AddSound(DEFAULT_SOUND, BS(
    "Du vernimmst das Rauschen des Meeres und das Gezwitscher der Voegel "
    "ueber Dir. Eine herrliche Mischung!"));
  AddSound( ({"meer", "rauschen"}), BS(
    "Das Rauschen des Meeres wirkt beruhigend auf Dich."));
  AddSound( ({"voegel", "gezwitscher"}), BS(
    "Die Voegel unterhalten sich recht froehlich! Nur zu gern wuesstest "
    "Du, was sie erzaehlen!"));
  AddDetail( ({"gras", "blumen"}), BS(
    "Rings um Dich waechst viel Gras und die schoensten Blumen, die man "
    "sich denken kann! Du fragst Dich, welches Meer wohl schoener ist, "
    "das blaue oder das gruene hier rings um Dich."));  
  AddSmell(({"duft", "blumen", "luft"}), BS(
    "Die Luft um Dich ist vom Duft der Blumen erfuellt! Welch' suesser "
    "Duft an lieblichem Orte!"));
  AddSmell(DEFAULT_SMELL, BS(
    "Die verschiedensten Blumen erfuellen den Ort mit einem suessen Duft."));
  AddDetail( ({"sonne", "himmel"}), BS(
    "Am blauen Himmel ueber Dir freut sich die Sonne. Voegel schwirren "
    "herum. Es ist einfach schoen!"));
  AddDetail( ({"straeucher", "rande"}), BS(
    "Am Rande des Weges wachsen hier auch ein paar Straeucher. Sie "
    "erstrahlen ebenfalls in einem satten Gruen."));
  AddDetail( ({"gruen"}), BS(
    "Gruen ist vieles um Dich herum wie das Gras und die Straeucher."));


  AddExit("suedosten", WEGPATH "weg3");
  AddExit("westen", WEGPATH "weg1");


}
