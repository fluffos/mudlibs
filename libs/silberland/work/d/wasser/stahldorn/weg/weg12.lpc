#include "../def.h"

inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Ploetzlich ist alles wieder hell. Die Wolken sind wie weggeblasen und am "
    "Himmel scheint eine freundliche Sonne. Trotzdem beruhigt Dich das keines"
    "wegs, denn die unterschwellige Gefaehrlichkeit dieses Ortes ist bis in "
    "die kleinste Faser Deines Koerpers spuerbar. Das Meer liegt ein paar "
    "hundert Meter weiter im Westen und die Lagune liegt still und schwarz "
    "direkt noerdlich von Dir. Im Sueden gaehnt eine unheilverkuendende "
    "Oeffnung in der Palisade um Knarkh, die bereits einen kleinen Vorge"
    "schmack auf das Grauen in diesem Dorf liefert."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22]) );


  AddDetail( ({"dorf", "stadt", "knarkh"}), BS(
   "Knarkh liegt direkt suedlich von Dir. Jedesmal wenn Du in diese Richtung "
   "blickst, stellen sich Deine Nackenhaare auf und Du bekommst so seltsame "
   "kleine Huegelchen auf Deiner Haut... Du bist Dir nicht so sehr sicher, "
   "ob es ratsam waere, Knarkh zu betreten."));
  AddDetail( ({"weg"}), "Harter Fels macht den Weg hier aus.\n");
  AddDetail( ({"boden"}),
    "Am Boden finden sich nur ein paar Felsbrocken und ein bisschen Erde \n"
    "dazwischen.\n");
  AddDetail( ({"erde"}),
    "Versteckt in der Erde siehst Du einen kleinen Zettel.\n");
  AddDetail( ({"felsen", "fels", "felsbrocken"}), BS(
    "Viele harte Felsbrocken liegen auf der Erde."));
  AddDetail( ({"zettel"}), BS(
    "Der Zettel ist halb in der Erde vergraben und Du wagst nicht ihn "
    "anzuruehren. Aber es steht etwas darauf geschrieben, das Du lesen "
    "kannst."));
  AddReadDetail( ({"zettel"}), BS(
    "Auf dem Zettel steht: 'Wanderer, kommst Du nach Knarkh, dann ueberlege, "
    "ob den letzten Schritt Du wagst. Wenn Du nicht acht gibst, kann er "
    "Dich fuehren ins Verderben, doch wenn Du Lust hast, dann geh nur rein, "
    "um zu sterben.'"));
  AddDetail( ({"sonne", "himmel"}), BS(
    "Nun, vom dunklen Himmel kann man eigentlich nicht sprechen, denn jetzt, "
    "da Du der Stadt nahe bist, kommt die Sonne wieder strahlend durch."));
  AddDetail( ({"wolken"}), BS(
    "Wolken sind eigentlich kaum noch welche zu sehen. Da muss wohl irgend"
    "ein Zauber dahinterstecken."));
  AddDetail( ({"lagune"}),
    "Schwarz und still liegt die Lagune noerdlich von Dir.\n");
  AddDetail( ({"meer", "wasser"}), BS(
    "Das Meer liegt nun ein kleines Stueckerl weiter im Westen. Du siehst "
    "es zwar nicht richtig, aber Du fuehlst seine unheilvolle Praesenz."));
  AddSound( DEFAULT_SOUND, BS(
    "Das Rauschen des Meeres hat abgenommen und die Stille der Lagune wurde "
    "bedrueckender. Aber was so richtig schauerlich ist, das sind die "
    "furchtbaren Schreie, die immer wieder aus Knarkh heraus an Dein Ohr "
    "dringen."));
  AddSound( ({ "schreie", "knarkh" }), BS(
    "Die Schreie, die aus Knarkh kommen, lassen Dein Blut gefrieren."));
  AddSound( ({ "rauschen", "meer" }), BS(
    "Das rauschen des Meeres hoert man nur noch sehr sehr leise."));
  AddSound( ({ "stille", "lagune" }), BS(
    "Die Stille der Lagune wird von den Schreien aus Knarkh uebertoent."));
  AddDetail( ({"holzpalisade", "palisade", "schutz"}), BS(
    "Die grosse Holzpalisade dient als Schutz. Stellt sich nur die Frage, "
    "wer vor wem geschuetzt werden soll."));
  AddDetail( ({ "grauen", "vorgeschmack" }), BS(
    "In Knarkh lauert nicht das Gruenen und auch nicht das Blauen, sondern "
    "das Grauen.") );
  AddDetail( ({ "gruenen", "blauen" }),
    "Ah geh. Du kindischer Depp.\n" );
  AddDetail( ({ "zauber" }), BS(
    "Dass die Wolken sich so schlagartig veraendern muss an einem Zauber "
    "liegen, denn natuerlich ist das nicht!") );
  AddDetail( ({ "haare", "nacken", "nackenhaare" }), BS(
    "Deine Haare stehen zu Berge. Insbesondere die im Nacken.") );
  AddDetail( ({ "gaensehaut", "haut", "huegelchen" }), BS(
    "So kleine Huegelchen breiten sich auf Deiner Haut aus. Sie scheinen "
    "sich direkt proportional mit Deiner Angst zu vermehren. Hoffentlich "
    "ist das keine Knarkheit. Aeh Krankheit.") );
  AddDetail( ({ "angst" }), BS(
    "Ja, das ist wohl diese vielgeruehmte Angst. Wenn es stimmt, und sie "
    "wirklich Fluegel verleihen kann, dann brauchst Du Dir keine Gedanken "
    "zu machen, wie Du aus Knarkh wieder rauskommen sollst...") );
  AddDetail( ({ "faser", "koerper", "gefaehrlichkeit", "gefahr", "ort" }), BS(
    "Mit jeder Faser Deines Koerpers spuerst Du, dass hier eine toedliche "
    "Gefahr lauert. Knarkh ist definitiv kein gastfreundlicher Ort.") );
  AddDetail( ({ "eingang", "ausgang", "oeffnung" }), BS(
    "Suedlich von Dir befindet sich der Eingang nach Knarkh.") );

//  AddDetail( ({ "" }), BS(
//    "") );

  AddExit("westen", WEGPATH "weg11");
  AddExit("suedosten", ([EX_DEST     : KNARKHPATH "room/eingang",
                        /* EX_TESTFUNC : "levelcheck"*/]) );
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
