#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Du folgst dem Weg nach Knarkh. Suedlich von Dir breitet sich das Meer "
    "aus, nordoestlich befindet sich eine Lagune. Am Wegesrand wachsen "
    "noch ein paar Pflanzen. Hoch am Himmel fliegt noch ein einsamer Vogel, "
    "Dein letzter Begleiter. Immer weniger erscheint Dir der Gedanke der "
    "Umkehr absurd."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );

  AddDetail( ({"himmel", "sonne"}), BS(
    "Am Himmel ueber Dir siehst Du nur sehr selten die Sonne, da sie meist "
    "von Wolken verdeckt ist."));
  AddDetail( ({"wolken"}), BS(
    "Der Grossteil der Wolken ist weiss, doch auch ein paar dunkle sind nun "
    "zu finden."));
  AddDetail( ({"vogel", "begleiter"}), BS(
    "Nur mehr ein einziger Vogel ist Dir als Begleiter geblieben. Warum "
    "sind die anderen bloss alle umgekehrt?"));
  AddDetail( ({"weg", "wegesrand", "boden", "rand", "wegrand"}), BS(
    "Dieser Weg fuehrt zur Stadt Knarkh, die Du weit vor Dir erkennen "
    "kannst. Was wird Dich dort erwarten? Am Wegesrand wachsen ein "
    "paar Pflanzen."));
  AddDetail( ({"pflanzen"}), BS(
    "Am Wegesrand waechst ein wenig Gras, ein paar Straeucher und ab und "
    "zu noch einige wenige Blumen."));
  AddDetail( ({"gras"}), BS(
    "Das Gras steht nicht sehr hoch und waechst nur sehr spaerlich."));
  AddDetail( ({"straeucher"}), BS(
    "Gruen und braun sind die Straeucher am Wegesrand. Die meisten eher braun "
    "als gruen."));
  AddDetail( ({"blumen"}), BS(
    "Anfangs saeumten viele Blumen den Weg, jetzt aber gibt es nur mehr "
    "sehr wenige zu finden."));
  AddDetail( ({"stadt", "knarkh", "dorf"}), BS(
    "Du bist Dir sicher, dass Du schon etwas ueber Knarkh gehoert hast, "
    "doch irgendwie scheinst Du es wieder vergessen zu haben! Ihr Anblick in "
    "weiter Ferne scheint Dein Erinnerungsvermoegen zu rauben."));
  AddDetail( ({"anblick", "ferne"}), BS(
    "In weiter Ferne siehst Du im Suedosten Knarkh liegen. Einzelheiten kannst "
    "Du zwar noch keine ausmachen, aber man merkt bereits die Duesternis, die "
    "dieser Ort ausstrahlt."));
  AddDetail( ({"duesternis"}), BS(
    "Dunkle, schwarze Duesternis. Die Duesternis bezieht sich aber weniger "
    "auf die Lichtverhaeltnisse dort, sondern eher auf die unsichtbare aber " 
    "umsomehr spuerbare Aura des Todes."));
  AddDetail( ({"einzelheiten"}),
    "Du bist noch immer zu weit weg.\n");
  AddDetail( ({"halbinsel", "halbinseln"}), BS(
    "Knarkh liegt auf einer Halbinsel, was Du schon hier bemerken kannst, "
    "denn hier grenzen einerseits das Meer, andererseits die Lagune an "
    "den Weg."));
  AddDetail( ({"meer", "wasser"}), BS(
    "Das Meer ist hier schon mehr schwarz als blau. Das Rauschen verstaerkt "
    "den unheimlichen Eindruck nur noch."));
  AddDetail( ({"eindruck"}), BS(
    "Die Umgebung hier erweckt nicht gerade ein positiven Eindruck. "
    "Alles wird immer duesterer!"));
  AddDetail( ({"umgebung"}), BS(
    "Die Umgebung besteht hier hauptsaechlich aus der Lagune und dem "
    "Meer, die beide duester wirken."));
  AddSound(DEFAULT_SOUND, "Du hoerst das Rauschen des Meeres.\n");
  AddSound( ({"meer", "rauschen"}), BS(
    "Das Meer rauscht deutlich hoerbar, doch irgendwie bestaerkt es nur "
    "das ungewisse Gefuehl, das Du schon laenger hegst."));
  AddDetail( ({"gefuehl"}), BS(
    "Du spuerst es immer deutlicher, dieses ungewisse Gefuehl, das sich "
    "immer noch nicht benennen laesst."));
  AddDetail( ({ "lagune", "meeresarm" }), BS(
    "Die Lagune ist eigentlich ein kleiner Meeresarm, der sich in das "
    "Land geschoben hat und durch zwei Halbinseln vom eigentlichen Meer "
    "getrennt ist."));

  AddExit("suedosten", WEGPATH "weg8");
  AddExit("westen", WEGPATH "weg6");


}


