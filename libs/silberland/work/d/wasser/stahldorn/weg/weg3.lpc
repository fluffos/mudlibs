#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Nun bist Du schon ein Stueck des Weges gegangen, doch die sagenhafte "
    "Stadt Knarkh kannst Du immer noch nicht erblicken. Ob alles nur "
    "ein Maerchen ist? Trotzdem solltest Du aber weitergehen, da die "
    "Landschaft noch immer ihre schoenste Seite zeigt! Gras, Blumen, "
    "Straeucher und das Meer sind noch so lieblich wie zuvor. Auch am "
    "Himmel hat sich kaum etwas veraendert!" ));
 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19]) );

//  AddDetail( ({ "" }),
//    "");

  AddDetail( ({"weg", "boden", "sueden"}), BS(
    "Der Weg fuehrt einerseits wieder zurueck zur Pier und andererseits "
    "weiter in den Sueden. Was Dich dort wohl erwartet?"));
  AddDetail( ({"pier"}), BS(
    "Die Pier liegt weiter westlich. Sie ist kaum mehr zu sehen."));
  AddDetail( ({"stueck"}), BS(
    "Ein Stueck des Weges liegt hinter Dir, aber vor Dir erstreckt sich "
    "der Weg noch lange weiter! Folge ihm doch einfach!"));
  AddDetail( ({"stadt", "maerchen", "knarkh"}), BS(
    "Wenn Du herausfinden willst, ob es die Stadt wirklich gibt, musst "
    "Du noch ein Stueck weitergehen!"));
  AddDetail( ({"landschaft", "wunder"}), BS(
    "Die Landschaft rund um Dich ist einfach schoen. Blumen, Graeser, "
    "Straeucher und das Meer. Kein Wunder, dass sich hier die "
    "Voegel versammeln!"));
  AddDetail( ({"meer", "blau", "wasser"}), BS(
   "Suedlich von Dir liegt das blaue Meer, sein Rauschen ist deutlich "
   "zu hoeren."));
  AddDetail( ({"voegel"}), BS(
    "Die Voegel begleiten Dich noch immer. Sie zwitschern vergnuegt, "
    "waehrend sie am Himmel kreisen."));                    
  AddSound(DEFAULT_SOUND, BS(
    "Du vernimmst das Rauschen des Meeres und das Gezwitscher der Voegel "
    "ueber Dir. Eine herrliche Mischung!"));
  AddSound( ({"meer", "rauschen"}), BS(
    "Das Meer rauscht zwar nur sanft, es ist aber dennoch deutlich "
    "zu hoeren."));
  AddSound( ({"voegel", "gezwitscher"}), BS(
    "Die Voegel unterhalten sich recht froehlich! Nur zu gern wuesstest "
    "Du, was sie erzaehlen!"));       
  AddDetail( ({"gras", "blumen", "graeser"}), BS(
    "Rings um Dich waechst viel Gras und die schoensten Blumen. Doch "
    "es kommt Dir so vor, als ob es immer weniger wuerden."));
  AddSmell( ({ "blumen", "duft", DEFAULT_SMELL }), BS(
    "Die verschiedensten Blumen erfuellen den Ort mit einem suessen Duft."));
  AddDetail( ({"sonne", "himmel"}), BS(
    "Am blauen Himmel ueber Dir freut sich die Sonne. Ein paar weisse "
    "Wolken sind zu sehen. Voegel schwirren herum. Es ist einfach schoen!"));
  AddDetail( ({"straeucher", "rande", "rand","strauch"}), BS(
    "Am Rande des Weges wachsen auch ein paar Straeucher. Sie "
    "erstrahlen in einem satten Gruen.")); 
  AddDetail( ({"gruen"}), BS(
    "Das Gras und die Straeucher strahlen in einem intensiven Gruen."));
  AddDetail( ({ "wolken", "weisse wolken" }),
    "Ein paar weisse Wolken sind am Himmel.\n");


  AddExit("suedosten", WEGPATH "weg4");
  AddExit("nordwesten", WEGPATH "weg2");


}

