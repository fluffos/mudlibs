#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Der Weg, auf dem Du Dich befindest, ist nur mehr ein schmaler Korridor, "
    "eine Verbindung zwischen Knarkh und dem Festland. Im Sueden rauscht das "
    "Meer und nordoestlich liegt still die Lagune. Der Himmel verfinstert sich "
    "immer mehr. Nur ab und zu huscht ein vorwitziger Sonnenstrahl durch und "
    "beleuchtet schauerlich das Szenario. Dir wird immer unheimlicher "
    "zumute."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21]) );

  AddDetail( ({"weg", "boden"}), BS(
    "Hier ist kaum noch ein Weg zu erkennen. Der felsige Boden laesst "
    "keine Spuren erkennen, weder Spuren von Vegetation noch von anderen "
    "Wanderern, die hier schon vorbeigekommen sein koennten."));
  AddDetail( ({"spuren"}), "Spuren findest Du hier keine!\n");
  AddDetail( ({"vegetation", "straeucher"}), BS(
    "Hier wachsen nur ein paar verdorrte Straeucher, es gruent so gut wie "
    "gar nicht hier."));
  AddDetail( ({"korridor", "verbindung"}), BS(
    "Knarkh liegt nicht gaenzlich abseits, es ist mit dem Festland ueber "
    "den Korridor verbunden."));
  AddDetail( ({"festland", "land"}), BS(
    "Das Festland liegt ein wenig hinter Dir. Rund um Dich siehst Du kaum "
    "mehr Land."));
  AddDetail( ({"dorf", "stadt", "knarkh"}), BS(
    "Knarkh muss nun schon ziemlich nahe liegen. Leider ist es von hier aus "
    "immer noch nicht richtig sichtbar."));
  AddDetail( ({"meer", "sueden", "wasser"}), BS(
    "Das Meer suedlich von Dir ist mehr schwarz als blau. Sein Rauschen "
    "verstaerkt Deine Angst."));
  AddSound(DEFAULT_SOUND, BS(
    "Du hoerst das Rauschen des Meeres und ein unheimliches Fluestern."));
  AddSound( ({"meer", "rauschen"}), BS(
    "Das Meer rauscht deutlich hoerbar, doch es verstaerkt nur Deine Angst "
    "und laesst schlimme Vorahnungen in Dir aufkommen."));
  AddSound( ({"fluestern"}), 
    "Jemand fluestert: Kehr um! Kehr um!\n");
  AddDetail( ({"vorahnungen", "vorahnung"}), BS(
    "Du willst diese gar nicht naeher ergruenden, sonst bekommst Du "
    "womoeglich noch mehr Angst."));
  AddDetail( ({"angst"}), BS(
    "Wieso solltest Du Dich fuerchten? Es erscheint Dir laecherlich und "
    "Du willst die Angst schnell verdraengen."));
  AddDetail( "lagune", BS(
    "Die Lagune liegt nun nordoestlich von Dir. Du weisst nicht, was "
    "schlimmer ist, das Rauschen des Meeres oder die Totenstille der "
    "Lagune."));
  AddDetail( ({"totenstille", "stille"}), 
    "Die Totenstille klingt so ungesund leise.\n");
  AddSound( ({"totenstille", "stille"}), 
    "Die Totenstille klingt so ungesund leise.\n");
  AddDetail( ({"himmel", "sonne"}), BS(
    "Am Himmel ueber Dir siehst Du die Sonne kaum mehr, da sie meist "
    "von Wolken verdeckt ist."));
  AddDetail( ({"wolken", "weisse wolken"}), BS(
    "Ein paar weisse Wolken sind noch zu sehen, doch schoen langsam "
    "verfinstern auch die sich und gleichen ihr Aussehen den dunklen "
    "Wolken, die hier die Mehrheit bilden, an."));
  AddDetail( ({"szenario", "dunkle wolken"}), BS(
    "Ein duesteres Szenario breitet sich vor Dir aus. Dunkle Wolken haengen "
    "tief am Himmel und lassen nur hie und da einen Sonnenstrahl durch, "
    "der auf etwas Weisses faellt, das sich am Wegesrand befindet."));
  AddDetail( ({"wegesrand", "rand", "weisses"}), BS(
    "Das Weisse am Wegesrand entpuppt sich als Skelett."));
  AddDetail(({"skelett", "sonnenstrahl", "strahl", "strahlen"}), BS(
    "Ab und zu beleuchtet ein Sonnenstrahl ein Skelett am Wegesrand. Es "
    "duerfte schon lange hier liegen, denn die Knochen sind blankweiss "
    "abgescheuert und abgenagt. Die Hand des Skelettes weist nach Suedosten."));
  AddDetail( ({"hand"}), BS(
    "Das Skelett weist Dir den Weg nach Knarkh, wenn das nur nichts "
    "Boeses zu bedeuten hat!"));
  AddDetail( ({ "knochen" }), 
     "Die Knochen wurden abgenagt. Und das nicht nur vom Zahn der Zeit.\n" );

//  AddDetail( ({ "" }), 
//     "" );

  AddExit("westen", WEGPATH "weg8");
  AddExit("suedosten", WEGPATH "weg10");


}

