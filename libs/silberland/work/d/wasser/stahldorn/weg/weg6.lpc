#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Weg nach Knarkh" );
  SetProp( P_INT_LONG, BS(
    "Die Landschaft beginnt sich merklich zu wandeln. Am Himmel ziehen immer "
    "mehr Wolken auf, das Blau des Meeres wird duenkler, die Sonne zieht sich "
    "mehr und mehr zurueck. Es finden sich kaum noch Blumen am Weg und das "
    "Gras waechst nur noch duerftig wegen der fehlenden Strahlen der Sonne. "
    "Am Wegrand steht ein Schild."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19]) );


  AddDetail( ({"himmel", "wolken"}), BS(
    "Den Himmel kannst Du kaum mehr sehen. Wenn Du nach oben blickst, "
    "siehst Du nur mehr Wolken. Ein paar Voegel ziehen noch hoch am Himmel "
    "ihre Kreise."));
  AddDetail( ({"voegel", "geier"}), BS(
    "Du bist Dir nicht sicher, aber Du glaubst, dass es sich bei den Voegeln "
    "um Geier handelt."));
  AddDetail( ({"sonne", "strahlen"}), BS(
    "Durch die dichten Wolken kann die Sonne ihre Strahlen nur mehr sehr "
    "spaerlich ueber die Landschaft senden. So wird es immer dunkler, "
    "kaelter und unfreundlicher."));
  AddDetail( ({"weg", "boden"}), BS(
    "Am Boden siehst Du den Weg, dem Du schon sehr lange folgst."));
  AddDetail( ({"gras", "straeucher"}), BS(
    "Das Gras und die Straeucher verkuemmern immer mehr, da ihnen das "
    "Licht der Sonne fehlt. Auf den Zweigen der Straeucher finden sich "
    "nur mehr sehr wenige Blaetter."));
  AddDetail( ({"blaetter", "zweige"}), BS(
    "Die Straeucher haben viele Zweige, die aber nur spaerlich mit "
    "Blaettern bewachsen sind. Dieser Anblick bestaerkt Dein ungewisses "
    "Gefuehl."));
  AddDetail( ({"anblick", "gefuehl"}), BS(
    "Der Anblick der Landschaft stimmt Dich immer duesterer. Doch das "
    "ungewisse Gefuehl laesst sich immer noch nicht benennen."));
  AddDetail( ({"exemplare", "blumen"}), BS(
    "Du wunderst Dich, wo die vielen Blumen von vorhin wohl geblieben sind, "
    "hier sieht man nur noch vereinzelt ein paar verkuemmerte Exemplare "
    "wachsen."));
  AddSmell(DEFAULT_SMELL, 
    "Es riecht nur noch aeusserst schwach nach Blumen.\n");
  AddSmell( ({ "blumen", "duft" }), 
    "Der Duft der Blumen ist kaum noch riechbar. Leider.\n");
  AddDetail( ({"landschaft"}), BS(
    "Um Dich herum siehst Du noch immer Gras und das Meer, doch so schoen "
    "wie vorher, nein, so schoen ist es nicht!"));
  AddDetail( ({"meer", "blau", "wasser"}), BS(
    "Das Meer rauscht suedlich von Dir, doch das schoene Blau wird immer "
    "dunkler. Es wird immer unheimlicher."));
  AddSound(DEFAULT_SOUND, 
    "Du hoerst das Rauschen des Meeres. Sonst eigentlich nix.\n");
  AddSound( ({"meer", "rauschen"}), "Das Meer rauscht deutlich hoerbar.\n");
  AddSound( ({"vogelgezwitscher", "voegel", "gezwitscher"}), 
    "Nur mehr sehr selten hoerst Du einen Vogel zwitschern.\n");
  AddDetail( ({"wegrand", "schild"}), BS(
    "Am Wegrand siehst Du ein altes, verwittertes Schild. Auf dem "
    "Schild stehen ein paar Worte geschrieben!"));
  AddReadDetail( ({"schild", "worte" }),
    "   'Wanderer, kommst Du nach Knarkh,\n    dann ........'\n"+BS(
    "Der Rest ist leider nicht mehr deutlich lesbar. Du glaubst die Worte "
    "zu erkennen: 'dann seien Dir die Goetter gnaedig', doch Du bist Dir "
    "nicht sicher."));
  AddDetail( ({"knarkh", "stadt", "dorf"}), BS(
    "Von hier aus siehst Du eigentlich noch gar nichts."));
  AddDetail("worte", "Lies sie doch!\n");

  AddExit("osten", WEGPATH "weg7");
  AddExit("nordwesten", WEGPATH "weg5");


}

