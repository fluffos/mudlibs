#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int phiole,wasser;

create() {
  if (!is_clone(TO)) return;
  ::create();

  phiole=0;  
  wasser=0; 

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( QUESTITEM );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

void SetPhiole()
{
  phiole = 1;
  return;
}

int QueryPhiole()
{
  return phiole;
}

void SetWasser()
{
  wasser = 1;
  return;
}

int QueryWasser()
{
  return wasser;
}

int QueryFertisch()
{
  // Alles ok?
  if(!wasser || !phiole ) { return 0; }
 
  return 1;
}