inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ariele");
  SetProp(P_LONG,
    "Ariele liegt im Bett und schuettelt sich im Fieberwahn. "
    "Sie sieht sehr krank aus. Ihre Haut ist leicht geblich angelaufen "
    "und ihre Augen sind blutunterlaufen.");

  SetProp(P_NAME, "Ariele");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  // Kein verlassen des Hauses durch wueten -> NOWIMPY
  AddId(({"ariele", "NOWIMPY", "NOCONTROL"}));
//  set_living_name("ariele");
  create_default_npc(15);
//  SetProp(P_XP, 100 QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 130);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 650);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddClass(CL_HUMAN);

  AddDetail(({"fieberwahn", "fieber", "fiebertraum" }),
    "Ariele scheint hohes Fieber zu haben.");

  AddInfo(DEFAULT_INFO, ({"zittert im Fiebertraum.\n",
                          "ist zu krank um antworten zu koennen.\n",
                          "starrt nur an die Decke.\n"}));

//  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Ariele schaut Dich verwirrt an.\n" }) );

  SetProp(P_SPELLRATE,35);

  AddSpell(4,750,
    "Ariele hustet Dich an.\n",
    "Ariele hustet @WEN an.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
    "Ariele schwitzt stark.\n",
    "Ariele stoehnt.\n"}) );
  SetAttackChats(10, ({
    "Ariele schwitzt stark.\n",
    "Ariele stoehnt.\n"}) );


  SUID;

  clone_object("/p/armour/trousers/rock" )->move(TO);
  clone_object("/p/armour/armour/bluse" )->move(TO);
  command("trage alles");

}
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Ariele.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Ariele hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}