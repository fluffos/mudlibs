inherit "std/npc";
inherit "/std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

//int paralyze(int zeit, object player);
string *players;

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Aurelian, der Fischer");
  SetProp(P_LONG,
    "Aurelian ist ein grosser, grauhaariger und erfahrener Fischer. "
    "Seinen schwieligen Haenden sieht man die jahrelange Arbeit auf dem Meer "
    "an. Nervoes wandert sein Blick staendig zu seiner Tochter.");

  SetProp(P_NAME, "Aurelian");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  // kein verlassen der tochter durch wueten -> NOWIMPY
  AddId(({"fischer", "vater", "aurelian", "Speermeister", "NOWIMPY", "NOCONTROL" }));
  set_living_name("aurelian");
  create_default_npc(25);
//  SetProp(P_XP, 100 QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wer kuemmert sich jetzt um meine Tochter?");
  SetProp(P_KILL_NAME, "Aurelian");
  SetProp(P_KILL_MSG, "Haettest Du uns mal lieber geholfen!");

  AddClass(CL_HUMAN);

  AddDetail("haende",
    "Aurelians rauhe Haende sind mit Schwielen uebersaeht. Er scheint harte "
    "Arbeit gewohnt zu sein.");
  AddDetail(({"schwielen"}),
    "Durch jahrelange Arbeit auf dem Meer wurden seine Haende gestaehlt. Du "
    "solltest ihn besser nicht unterschaetzen.");
  AddDetail("blick",
    "Sein Blick wandert staendig zu seiner Tochter.");
  AddDetail("tochter",
    "Seine Tochter liegt im Bett und scheint schwer krank zu sein.");
  AddDetail("arbeit",
    "Nahezu taeglich faehrt Aurelian aufs Meer und faengt Fische mit seinem Netz "
    "und seinem Speer.");
  AddDetail(({"nutzung", "Speer", "meister"}),
    "Durch jahrelange Nutzung ist er zu einem Meister des Speeres geworden.");
  AddDetail("netz",
    "Mit seinem Netz faengt Aurelian taeglich Fische. Pass auf, dass er nicht auch "
    "Dich einfaengt.");
  AddDetail("fische",
    "Was sollte ein Fischer sonst fangen?");

  AddInfo(DEFAULT_INFO, ({"versteht nicht, was Du meinst.\n",
                          "beachtet Dich gar nicht.\n",
                          "hoert Dir nicht zu.\n"}));
  AddInfo("torian", "Torian hat mich erschaffen.","sagt: ");

  AddInfo( ({"huette","haus"}),
    "Seit vielen Jahren schon lebe ich in dieser Huette.",
    "sagt: ");
  AddInfo( ({"tochter","ariele"}),
    "Ariele ist krank. Wenn ihr doch nur jemand helfen koennte.",
    "sagt: ");


/* Questrelevante Sachen
  AddInfo( ({"hilfe"}),
    "",
    "sagt: ");
  AddInfo( ({"heiler"}),
    "",
    "sagt: ");
  AddInfo( ({"aufgabe"}),
    "");
*/

  SetProp(P_LOG_INFO, "/torian/sumpf/aurelian");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Aurelian sagt: Was soll ich damit? Hilf lieber meiner Tochter!\n" }) );

  SetProp(P_SPELLRATE,30);
  
  AddDefaultSpell(2,850,DS_SLOW,
    "Aurelian sticht nach Deinen Oberschenkeln. Du faengst an zu hinken!\n",
    "Aurelian sticht nach @WEN Oberschenkeln. @WEN faengt an zu hinken!\n");

  AddSpell(3,1,
    "Aurelian wirft ein Fischernetz nach Dir!\n",
    "Aurelian wirft ein Fischernetz nach @WEN!\n",
    DT_BLUDGEON, "hold");

  AddSpell(1,1500,
    "Aurelian sticht nach Deinem Herzen.\n",
    "Aurelian sticht nach @WESSEN Herzen.",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
    "Aurelian seufzt.\n",
    "Aurelian murmelt: Wer koennte nur helfen...\n",
    "Aurelian schaut seine Tochter verzweifelt an.\n"}) );
  SetAttackChats(10, ({
    "Aurelian verflucht Dich lautstark.\n",
    "Aurelian schreit Dich wuetend an.\n"}) );

  SUID;

  clone_object("/p/armour/trousers/hose" )->move(TO);
  clone_object("/p/armour/armour/lederpanzer" )->move(TO);
  clone_object("/p/armour/boots/lederstiefel" )->move(TO);
  command("trage alles");

  clone_object("/p/weapon/spear/dreizack")->move(TO);
  command("zuecke dreizack");

  AddCmd( ({"befreie", "befrei"}) , "cmd_befreie");

  players = ({});
}
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Aurelian.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(member(players, getuid(player)) != -1)
  {
    players -= ({ getuid(player) });
  }
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Aurelian hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "funkelt Dich boese an.",
        "funkelt "+TP->name(WEN)+" boese an.");
      break;
    default :
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void hold(object enemy,int damage,string damtype)
{
// mit Array vielleicht doch besser ...
/*
  mixed res;
  if (res=this_player()->QueryProp(P_TMP_MOVE_HOOK))
  {
    if ( pointerp(res) && sizeof(res) >= 3
        && intp(res[0]) && time() < res[0]
        && objectp(res[1]) && stringp(res[2]) )
    {
    // In diesem Fall ist ein Move Hook bereits gesetzt ...
      return ;
    }
  }
  paralyze (100, this_player());
