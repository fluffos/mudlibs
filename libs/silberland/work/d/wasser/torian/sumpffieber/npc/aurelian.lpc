int cmd_befreie(string str)
{

  notify_fail("Woraus willst Du Dich befreien?\n");
  if(!str || str == "") return 0;
  if(!(str == "dich aus netz" || str == "netz" || str == "aus netz")) return 0;

  if(-1 == member(players, getuid(TP) ))
  {
    notify_fail("Du haengst doch gar nicht fest!\n");
    return 0;
  }

  tell_object(TP,"Du befreist Dich aus dem Netz!\n");
  players -= ({ getuid(TP) });
//  this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
  return 1;
}

string *holded()
{
  return players;
}