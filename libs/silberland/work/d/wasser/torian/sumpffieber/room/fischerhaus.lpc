  AddDetail( ({ "angeln", "angel" }),
    "Du siehst Angeln in allen Groessen und Formen.");
  AddDetail( ({ "groessen" }),
    "Von ganz kleinen Angeln ueber normale bis hin zu grossen Hochseeangeln.");
  AddDetail( ({ "formen" }),
    "Die verschiedensten Formen sind vorhanden.");
  AddDetail( ({ "hochseeangeln" }),
    "Hochseeangeln sind besonders stabil gebaut.");
  AddDetail( ({ "netze" }),
    "Die Netze sind fein saeuberlich zusammengelegt. Obwohl sie schon aelter "
