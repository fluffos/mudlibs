
inherit "std/room";

#include "../def.h"

#define ANSCHLUSS "/d/wasser/hiri/inselversteck/room/steg"

int angel;

create()
{
  ::create();

  angel = DA;

  SetProp( P_INT_SHORT, "Ein kleines Fischerhaus" );
  SetProp( P_INT_LONG,
    "Du hast ein kleines Fischerhaus betreten, das fast genauso aussieht, wie "
    "Du Dir solch ein Haus immer vorgestellt hast. An der westlichen Wand stehen "
    "jede Menge Angeln und Netze, daneben befindet sich eine kleine Arbeitsplatte. "
    "Im Osten sind ein paar Regale mit teilweise sonderbaren Gegenstaenden. Nur "
    "wenige Buecher befinden sich unter ihnen. In der Mitte des Raumes steht ein "
    "einfacher Holztisch mit zwei Stuehlen. An der Nordwand steht ein altes Bett, "
    "in dem ein junges Maedchen liegt. Sie scheint sehr krank zu sein.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "raum"}),
    QueryProp(P_INT_LONG));
  AddDetail( ({ "fischerhaus", "haus" }),
    "Das Fischerhaus ist genauso rustikal und zweckmaessig eingerichtet, wie "
    "Du es Dir immer vorgestellt hast.");
  AddDetail( ({ "westwand" }),
    "An der Westwand stehen jede Menge Angeln und Netze, direkt daneben befindet "
    "sich eine kleine Arbeitsplatte.");
  AddDetail( ({ "menge" }),
    "So viele verschiedene Angeln und Netze hast Du noch nie auf einem Haufen "
    "gesehen.");
  AddDetail( ({ "haufen" }),
    "Die verschiedensten Angeln und Netze sind fein saeuberlich an der Westwand "
