  AddDetail( ({ "haustuer", "tuer" }),
    "Durch die Haustuer hast Du das Haus mit Sicherheit betreten.");
  AddDetail( ({ "voraussetzungen" }),
    "Voraussetzungen, um angeln und fischen zu koennen, sind neben dem "
    "passenden Werkzeug vor allen Dingen Wasser und Fische.");
  AddDetail( ({ "werkzeug", "genuege" }),
    "Passendes Werkzeug gibt es hier zu Genuege.");
  AddDetail( ({ "dingen", "dinge" }),
    "Dinge wie Wasser oder Fische.");
  AddDetail( ({ "wasser" }),
    "Das Meer befindet sich fast direkt vor der Haustuer. Auch ein kleiner Bach "
    "fliesst ganz in der Naehe.");
  AddDetail( ({ "bach", "baeche" }),
    "Auch in einem Bach kann man Fische fangen.");
  AddDetail( ({ "naehe" }),
    "Nur wenige Fussstunden entfernt.");
  AddDetail( ({ "fussstunden", "stunden", "fuss" }),
    "Nur wenige Stunden, die man zu Fuss zuruecklegen muss.");
  AddDetail( ({ "sicherheit" }),
    "Es gibt keinen anderen Weg hinein.");
  AddDetail( ({ "weg" }),
    "Oder hast Du etwa doch einen anderen Weg gefunden?");
  AddDetail( ({ "fische", "fischen" }),
    "Die wahrscheinlich am haeufigsten geangelten Fische sind der Aal, der Barsch, "
    "die Flunder, der Hecht, der Hering, der Karpfen und die Meeresforelle.");
  AddDetail( ({ "aal" }),
    "Der Aal kommt in fast allen Gewaessern vor und kann eine Laenge von bis zu "
    "150 cm erreichen.");
  AddDetail( ({ "gewaesser" }),
    "Man unterscheidet hauptsaechlich fliessende und stehende Gewaesser.");
  AddDetail( ({ "laenge" }),
    "Der maennliche Aal wird nur 50 cm lang. Der weibliche Aal kann bis zu 150 cm "
    "lang werden und ein Gewicht von bis zu 6 Kilo erreichen.");
  AddDetail( ({ "gewicht", "kilo" }),
    "Der weibliche Aal kann bis zu 6 Kilo schwer werden.");
  AddDetail( ({ "barsch" }),
    "Der Barsch ist auffallend gestreift und ein unersaettlicher Raeuber. "
    "Fuer gewoehnlich jagt er in Schwaermen oder kleineren Trupps.");
  AddDetail( ({ "raeuber", "brut" }),
    "Er ist ein unersaettlicher Raeuber, selbst vor der eigenen Brut macht "
    "er nicht halt.");
  AddDetail( ({ "schwaermen", "schwaerme", "trupps" }),
    "Der Barsch jagt in Schwaermen oder kleineren Trupps. Groessere Exemplare "
    "sind Einzelgaenger.");
  AddDetail( ({ "exemplare", "einzelgaenger" }),
    "Groessere Exemplare trifft man nicht so haeufig an.");
  AddDetail( ({ "flunder" }),
    "Von Herbst bis Fruehjahr kommt die Flunder in Kuestennaehe. Sie hat "
    "dornige Hautwarzen an Flossensaeumen und Seitenlinie.");
  AddDetail( ({ "herbst", "fruehjahr" }),
    "Von Herbst bis Fruehjahr kommt die Flunder in Kuestennaehe.");
  AddDetail( ({ "hautwarzen", "flossensaeume", "flossensaeumen", "seitenlinie" }),
    "Dornige Hautwarzen befinden sich an den Flossensaeumen und an den Seitenlinien.");
  AddDetail( ({ "kuestennaehe" }),
    "In Kuestennaehe ist die Flunder mit Beginn der Daemmerung auch von Molen "
    "und Seebruecken gut zu fangen.");
  AddDetail( ({ "beginn", "daemmerung", "wind" }),
    "Bei Beginn der Daemmerung, besonders bei auflandigem Wind, ist die Flunder "
    "gut zu fangen.");
  AddDetail( ({ "molen", "seebruecken" }),
    "Von Molen und Seebruecken aus kann man von Herbst bis Fruehjahr die "
