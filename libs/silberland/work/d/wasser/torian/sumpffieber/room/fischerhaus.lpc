  AddDetail( ({ "wanderfisch" }),
    "Die Meeresforelle wird als Wanderfisch bezeichnet.");
  AddDetail( ({ "sommer" }),
    "Zum Laichen kehrt die Meeresforelle im Sommer zu den Fluessen zurueck.");
  AddDetail( ({ "leichen", "laichen" }),
    "Laichen, nicht zu verwechseln mit Leichen.");
  AddDetail( ({ "fluesse", "fluessen" }),
    "Fluesse sind groessere Baeche.");
  AddDetail( ({ "wand", "waende" }),
    "Welche Wand meinst Du genau?");
  AddDetail( ({ "arbeitsplatte" }),
    "Direkt neben den Angeln und Netzen befindet sich eine Arbeitsplatte. Auf "
    "ihr werden die Fische entschuppt und fuer eine spaetere Verarbeitung "
    "vorbereitet.");
  AddDetail( ({ "verarbeitung" }),
    "Fische werden, wenn sie nicht sofort zubereitet werden, geraeuchert oder "
