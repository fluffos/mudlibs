  AddDetail( ({ "holztisch", "tisch" }),
    "Ein einfacher Holztisch.");
  AddDetail( ({ "stuehlen", "stuhl", "stuehle" }),
    "Auf diesen Stuehlen sitzen fuer gewoehnlich Aurelian und Ariele.");
  AddDetail( ({ "mahlzeiten" }),
    "Die Mahlzeiten bestehen meist, wie nicht anders zu erwarten, aus Fischen.");
  AddDetail( ({ "nordwand" }),
    "An der Nordwand steht ein altes Bett, welches sicherlich auch schon bessere "
    "Tage gesehen hat.");
  AddDetail( ({ "tage" }),
    "Das Bett hat sicherlich schon bessere Tage gesehen.");
  AddDetail( ({ "bett" }),
    "Ein altes, ueberraschend gemuetlich aussehendes Bett. Zur Zeit liegt ein "
    "junges Maedchen darin.");
  AddDetail( ({ "zeit" }),
    "Jetzt.");
  AddDetail( ({ "maedchen" }),
    "Ariele liegt im Bett und schuettelt sich im Fieberwahn. Sie sieht sehr "
    "krank aus. Ihre Haut ist leicht gelblich angelaufen und ihre Augen sind "
    "blutunterlaufen.");
  AddDetail( ({ "ariele", "tochter" }),
    "Ariele ist die Tochter des Fischers Aurelian. Sie hat sich scheinbar eine "
    "schwere Krankheit zugezogen. Unruhig waelzt sie sich im Bett hin und her.");
  AddDetail( ({ "fieberwahn", "wahn" }),
    "Ariele scheint hohes Fieber zu haben.");
  AddDetail( ({ "fieber" }),
    "Ariele schuettelt sich im Fieberwahn.");
  AddDetail( ({ "haut" }),
    "Ihre Haut ist leicht gelblich angelaufen. Was ist das nur fuer eine "
    "schreckliche Krankheit?");
  AddDetail( ({ "krankheit" }),
    "So wirst Du nichts weiter herausfinden, am besten ist wohl, Du "
    "fragst Aurelian danach.");
  AddDetail( ({ "augen" }),
    "Sie starren Dich direkt an, dennoch kommt es Dir so vor, als wenn ihr Blick "
    "direkt durch Dich hindurch geht.");
  AddDetail( ({ "blick", "leere" }),
    "Sie scheint ins Leere zu starren.");
  AddDetail( ({ "suedwand" }),
    "In der Suedwand befindet sich die Tuer, durch die Du gekommen bist.");
  AddDetail( ({ "boden" }),
    "Der Boden ist absolut sauber. Vor dem Tisch faellt Dir eine Klappe auf.");
  AddDetail( ({ "klappe" }),
    "Du bist Dir nicht sicher, was sich unter dieser Klappe verbirgt.");
  AddDetail( ({ "decke" }),
    "Die Decke des Hauses besteht aus einfachem, aber sehr solidem Holz.");
  AddDetail( ({ "holz" }),
    "Einfaches, aber dennoch sehr solide aussehendes Holz.");

  AddReadDetail( ({ "buecher" }),
    "Du nimmst eines der Buecher aus dem Regal und blaetterst kurz darin. "
    "Nachdem Du kaum etwas verstanden hast, legst Du das Buch zurueck. Dabei "
    "faellt Dir ein weiteres Buch, das besonders abgegriffen ist, auf.");
  AddReadDetail( ({ "buch", "kochbuch" }),
    "Es ist voller Rezepte. Du siehst fuenf Eselsohren, diese Rezepte "
    "scheinen sehr haeufig verwendet worden zu sein. <lies rezept 1..>");
  AddReadDetail( ({ "rezept 1", "rezept eins", "eins" }),
    "Hering in Senfsosse.\n"
    "Den Heringen schneidet man, vom Bauch ausgehend, die Koepfe obenhin "
    "soweit ab, dass man die Augen noch mit fortnimmt. Unter Zuruecklassen "
    "von Milch und Rogen werden die Eingeweide aus der so entstandenen "
    "Oeffnung entfernt. Dann waescht man die Heringe, setzt sie in kaltem "
    "Wasser mit Salz und einer Zwiebel an und bringt sie rasch zum Kochen, "
    "laesst sie aber langsam garkochen. Dazu richtet man eine Senfsosse an: "
    "50 g Butter, 50 g Senf und so viel Wasser und Fischwasser, dass die "
    "Sosse fuer 4 Personen reicht, bringt man zum Kochen, gibt 1 Teeloeffel "
    "Zucker daran und ruehrt Staerkemehl hinzu, bis die Sosse dickfluessig "
    "ist. Dann quirlt man sie mit 2 Eidottern und 20 g kalter Butter.");
  AddReadDetail( ({ "rezept 2", "rezept zwei", "zwei" }),
    "Forelle in Sahnesosse.\n"
    "Mittelgrosse Forellen ausnehmen, reinigen und in Salzwasser mit wenig "
    "Essig und Gewuerz (Lorbeer, Zwiebel, Piment) garziehen lassen. Dann "
    "werden sie vom Feuer genommen und heiss gehalten. In einer Kasserole "
    "ruehrt man einige Eigelb, reichlich frische Butter, Zitronenschalen "
    "und 1/2 Glas Weisswein zusammen. Diese Masse bringt man unter staendigem "
    "Umruehren zum Kochen, fuegt 1/4 l Fleischbruehe, 1/4 l Weisswein und "
    "1/8 l saure Sahne hinzu und laesst alles unter fliessendem Ruehren "
    "aufkochen - bis die Sosse saemig ist. Zum Schluss wird die Sosse mit "
    "Zitronensaft und Zucker abgeschmeckt; die Forellen werden auf einer "
    "Platte angerichtet und mit der Sosse uebergossen, dazu gibt es "
    "Salzkartoffeln. ");
  AddReadDetail( ({ "rezept 3", "rezept drei", "drei" }),
    "Karpfen.\n"
    "1 grosse Zwiebel, 1 Lorbeerblatt, Piment, Sellerie und etwas Salz "
    "werden in 1/2 l Wasser gekocht. Vorbereitete Karpfenstuecke darin "
    "garziehen lassen, herausnehmen und in der Fischbruehe 1 bis 2 Teeloeffel "
    "Fliederkreude aufloesen. Mit Essig, Zucker und Salz abschmecken. "
    "Zum Schluss Mehl und saure Sahne verruehren und Sosse binden. 2 "
    "Teeloeffel Butter zugeben.");
  AddReadDetail( ({ "rezept 4", "rezept vier", "vier" }),
    "Gebratene Scholle.\n"
    "Vorbereitete Schollen wuerzt man stark mit Salz und wenig Essig und "
    "laesst sie je nach Groesse 1 bis 2 Stunden darin liegen. Die wieder "
    "abgewaschenen Fische paniert man mit Mehl, das zur Haelfte mit "
    "Zwiebackbroeseln und etwas Salz vermischt ist. Dann braet man sie "
    "schnell gar. Man kann sie lediglich mit dem uebergossenen Bratfett "
    "servieren oder auch eine Sosse bereiten wie beim Hering in Senfsosse.");
  AddReadDetail( ({ "rezept 5", "rezept fuenf", "fuenf" }),
    "Hering in Sahnestip.\n"
    "Einige milcherne Heringe laesst man 2 Tage in Sahne liegen. Dann "
    "trocknet man sie ab, haeutet sie, nimmt sie aus und legt sie in eine "
    "flache Schuessel. Die Heringsmilch wird fein gewiegt und mit dicker "
    "Sahne, Oel und etwas Essig glatt geruehrt. Dann streut man duenne "
    "Scheiben von sauren Gurken auf die Heringe und giesst die Sosse durch "
    "ein Sieb darueber. Das Gericht kann sofort gegessen werden.");

  AddSound( DEFAULT_SOUND,
    "Ariele stoehnt im Fieberwahn. Von draussen glaubst Du, leise das Meer "
    "rauschen zu hoeren.");
  AddSound( ({ "stoehnen", "stoehnt", "ariele" }),
    "Ariele stoehnt leise vor Schmerzen.");
  AddSound( ({ "schmerzen" }),
    "Ariele stoehnt vor lauter Schmerzen.");
  AddSound( ({ "fieberwahn", "fieber" }),
    "Ariele wird vom Fieber geschuettelt.");
  AddSound( ({ "meer", "rauschen" }),
    "Du glaubst, das Meer rauschen zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht, welch Ueberraschung, nach Fisch.");

  AddSmell( ({ "ueberraschung", "geruch" }),
    "Du versuchst erfolglos, noch einen anderen Geruch aufzuschnappen.");
  AddSmell( ({ "fisch" }),
    "Das ganze Haus riecht nach Fisch, besonders aber vom Boden aus.");
  AddSmell( ({ "boden", "klappe" }),
    "Die Klappe im Boden verstroemt einen intensiven Fischgeruch.");
  AddSmell( ({ "fischgeruch" }),
    "Der Fischgeruch ist bei der Klappe am staerksten.");

  AddItem(NPC "aurelian", REFRESH_REMOVE);

  AddExit("raus", ([EX_DEST : ANSCHLUSS, EX_TESTFUNC : "exit_test" ]) );

  AddCmd( ({ "oeffne" }), "cmdoeffne" );
  AddCmd( ({ "nimm", "nehme", "nehm" }), "cmdnehmen" );
  AddCmd( ({ "sitz", "setz", "setze", "sitze" }), "cmdsitzen" );

}

int exit_test()
{
  object fischer;
  int i;

  if(TP && interactive(TP))
  {
    fischer = present("aurelian", TO);
    if(member(fischer->holded(), getuid(TP)) != -1)
    {
      tell_object(TP,"Aber Du haengst doch im Netz fest! Befreie Dich erst einmal!\n");
      return 0;
    }
  }

  return 1;
}

// Klappe oeffnen
int cmdoeffne(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(str == "klappe" )
  {
    if(present("aurelian", TO))
    {
      tell_room(TO,break_string("Finger weg von der Klappe, dort "
        +"befinden sich meine Vorraete fuer diesen Winter.", 78, 
        "Aurelian sagt laut: "));
      return 1;
    }
    else
    {
      say(BS( PL->name()+" oeffnet die Klappe, wirft einen Blick nach "
              +"unten und schliesst sie enttaeuscht wieder."));
      write(BS("Du oeffnest die Klappe und stellst fest, dass sich darunter "
              +"nur ein Vorratsraum befindet. Enttaeuscht schliesst Du die "
              +"Klappe wieder.") );
      return 1;
    }
  }
  return 0;
}

// Auf Stuhl setzen
int cmdsitzen(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(str == "auf stuhl" || str == "auf stuehle" )
  {
    if(present("aurelian", TO))
    {
      tell_room(TO,BS("Aurelian herrscht Dich an: Runter von meinem Stuhl!"));
      return 1;
    }
    else
    {
      say(BS( PL->name()+" setzt sich kurz auf einen der beiden Stuehle, "
              +"steht aber sofort wieder auf."));
      write(BS("Du setzt Dich auf einen der beiden Stuehle und stellst fest, "
              +"dass sie ueberraschend bequem sind. Dennoch beschliesst Du, "
              +"lieber wieder aufzustehen.") );
      return 1;
    }
  }
  return 0;
}

// diverse Sachen versuchen zu nehmen ...
int cmdnehmen(string str)
{
  object myangel;
  
  notify_fail("Was willst Du nehmen?\n");
  
  if (!stringp(str)) { return 0; }  

  switch (str)
  {
    case "haken":
      write(BS("Was willst Du mit einem Haken anfangen?"));
      return -1;
    case "buch":
    case "kochbuch":
    case "buecher":
      write(BS("Die Buecher waeren nur unnuetzer Ballast, es waere sicher "
              +"einfacher, sie gleich hier zu lesen."));
      return -1;
    case "angel":
      if(angel == DA)
      {
        myangel=clone_object("/p/weapon/spear/angel");
        if(ME_TOO_HEAVY==myangel->move(TP,M_GET|M_SILENT))
        {
          write("Du kannst die Angel nicht mehr tragen.\n");
          myangel->remove();
          return -1;
        }
        else
        {
          write(BS("Unbemerkt nimmst Du eine der normalen Angeln."));
          say(BS(PL->name()+" nimmt unbemerkt eine der normalen Angeln."));
          angel = WEG;
          return 1;
        }
      }
      write(BS("Du traust Dich nicht, eine der Angeln zu nehmen."));
      return -1;
    case "angelschnuere":
    case "schnuere":
    case "rollen":
    case "rolle":
      write(BS("Wozu brauchst Du Angelschnuere?"));
      return -1;
    default:
      return 0;
  }
}

reset()
{
  ::reset();

  angel = DA;

}

// Spaeter wenn Tochter geheilt, Long und Details aendern und
// NPC "ariele" in den raum moven (bis reset)