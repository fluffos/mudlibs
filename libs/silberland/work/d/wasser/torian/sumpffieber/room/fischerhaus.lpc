  AddDetail( ({ "masche" }),
    "Aurelian repariert und pflegt seine Netze regelmaessig.");
  AddDetail( ({ "aurelian", "fischer" }),
    "Aurelian heisst der Fischer, dem dieses Haus hier gehoert. Sollte er gerade "
