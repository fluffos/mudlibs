  AddDetail( ({ "anfang", "jahr", "jahres", "zeitpunkt" }),
    "Zu diesem Zeitpunkt ist der Hering am einfachsten zu fangen.");
  AddDetail( ({ "naehe", "kueste" }),
    "Der Hering zieht Anfang des Jahres in die Naehe der Kueste.");
  AddDetail( ({ "karpfen", "speisefisch" }),
    "Der Karpfen ist wohl der bekannteste und meistgenutzte Speisefisch. Er "
