  AddDetail( ({ "einzelhaken" }),
    "Normale einzelne Haken, wie sie bei fast jeder normalen Angel verwendet werden.");
  AddDetail( ({ "rollen" }),
    "Auf ihnen wurden die Angelschnuere aufgerollt.");
  AddDetail( ({ "angelschnueren", "schnueren", "angelschnuere", "schnuere" }),
    "Die verschiedensten Angelschnuere befinden sich auf den Rollen.");
  AddDetail( ({ "rest" }),
    "Dir ist nicht klar, wozu die restlichen Gegenstaende dienen.");
  AddDetail( ({ "buecher" }),
    "Die Buecher handeln ausnahmslos von Fischen.");
  AddDetail( ({ "buch", "kochbuch" }),
    "Es scheint ein Kochbuch zu sein.");
  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes steht ein einfacher Holztisch mit zwei Stuehlen. "
