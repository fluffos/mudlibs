#include "../def.h"

#include <ansi.h>

string *listener;

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  listener = ({"torian"}); // Torian lauscht immer

  return;
}

// Message bei besonderen Aktionen
void Msg(string s)
{
  object pl;
  int i;
  string str;

  i = sizeof(listener);
  while(i--)
  {
    pl = find_player(listener[i]);

    if(objectp(pl) && interactive(pl) && IS_WIZARD(pl))
    {
      str = BSI(s+".","DEBUG: ");
      if(pl->QueryProp(P_TTY)) str = ANSI_BOLD+ANSI_RED+str+ANSI_NORMAL;
      tell_object(pl,str);
    }
  }
  return;
}

void AddListener(string uid)
{
  if(!TI)              return;
  if(!interactive(TI)) return;

  if(getuid(TI) == "torian")  // Torian darf hinzufuegen
  {
    if(member(listener, uid) == -1)
    {
      listener += ({ uid });
      Msg("Neuer Listener: "+CAP(uid));
    }
  }
  else
  {
    Msg(CAP(getuid(TI))+" wollte \""+uid+"\" als Listener eintragen");
  }
  return;
}

void RemoveListener(string uid)
{
  if(!TI)              return;
  if(!interactive(TI)) return;

// Torian darf andere austragen
// Lauscher nur sich selbst
  if(getuid(TI) == "torian" || getuid(TI) == uid)
  {
    if(member(listener, uid) != -1)
    {
      listener -= ({uid});
      Msg("Listener entfernt: "+CAP(uid));
    }
  }
  else
  {
    Msg(CAP(getuid(TI))+" wollte \""+uid+"\" als Listener austragen");
  }
  return;
}
