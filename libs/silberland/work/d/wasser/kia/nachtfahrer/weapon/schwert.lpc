inherit "std/weapon";           

#include "../def.h"       


void create()
{
  
  if (!is_clone(this_object()))
    return;

  ::create();   

  AddId(({"schwert","obsidianschwert"}));
  SetProp (P_GENDER, NEUTER);
  SetProp (P_NAME, "Obsidianschwert");
  SetProp (P_SHORT, "Ein gezacktes Obsidianschwert");
  SetProp (P_LONG,
    "Ein funkelndes Obsidianschwert, dessen Schneidseite scharfe Zacken aufweist. "
	"Fast koennte man meinen, dass es sich dabei um Widerhaken handelt. "
	"Der Griff des Schwertes ist mit Edelsteinen besetzt. Ein wunderschoenes Schwert, das sicher "
	"gut in der Hand liegt und viel Schaden anrichtet.\n" );
  AddDetail(({"schneidseite"}),
    "Du laesst Deinen Finger ueber die Schneidseite des Schwertes wandern. Dabei schneidest Du Dich "
	"sofort.");
  AddDetail(({"zacken"}),
    "Die Zacken aehneln Widerhaken.");
  AddDetail(({"widerhaken","haken"}),
    "Die koennten bei einem Kampf verheerende Auswirkungen haben.");
  AddDetail(({"auswirkungen"}),
    "Die probierst Du am besten selbst aus.");
  AddDetail(({"griff"}),
    "Der Griff des Schwertes ist genau den Formen Deiner Hand angepasst. Du wirst es sicher gut "
	"fuehren koennen.");
  AddDetail(({"formen","hand"}),
    "Durch seinen geformten Griff liegt das Schwert besonders gut in der Hand.");
  AddDetail(({"schaden"}),
    "Mit diesem Schwert kannst Du einiges an Schaden anrichten.");
  AddDetail(({"edelsteine","steine"}),
    "Vielleicht sind sie echt, vielleicht auch nicht. Jedenfalls lassen sie das Schwert wertvoll "
	"aussehen.");
  SetProp (P_VALUE, 3000);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_NOBUY, 1);
  SetProp (P_WEAPON_TYPE, WT_SWORD);      
  SetProp (P_DAM_TYPE, DT_SLASH);     
  SetProp (P_WC, 200);
  SetProp (P_WC_FIX, 60);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([ MAT_OBSIDIAN : 50, MAT_PLATINUM : 20, MAT_TITANIUM : 20, MAT_MISC_JEWEL : 10]) );
  SetProp (P_HIT_FUNC, TO);
  //SetHitFunc(TO);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1,
                                  A_DEX: 22,
                                  A_STR: 22]) );
  SetProp(P_INFO,"Du haeltst ein sehr maechtiges Schwert in der Hand, das durch seine"
  				 " Zacken einiges an Schaden verrichten kann. Doch koennte es auch in "
				 "der Wunde Deines Feindes stecken bleiben.");
SetProp(P_QUALITY_DECAY,45);
}

void pullout(object owner)
{
if ((ENV(ENV(TO)) == ENV(owner)) && ENV(TO)->IsEnemy(owner))
	{
		ENV(TO)->Defend(400+random(150),({DT_RIP}),0,TO);
		TO->move(owner);
	    tell_object(ENV(TO), BS("Du zerrst wieder an Deinem gezackten Obsidianschwert, und kriegst es mit einem gewaltigem Ruck raus.\n") );  
		tell_room(ENV(ENV(TO)), BS(ENV(TO)->Name() + " zerrt an dem Obsidianschwert und kriegt es mit einem gewaltigem Ruck raus.\n"),({ENV(TO)}));
	}
}
		  
		
int HitFunc(object enemy)
{
   if (((random(enemy->QueryProp(P_ATTRIBUTES)["dex"]) + 10)==1) && (enemy->QueryProp(P_SIZE) > 80))
   {
      if(ENV(TO) && interactive(ENV(TO)))
	  {
	      tell_object(ENV(TO), BS("Du zerrst an Deinem gezackten Obsidianschwert, jedoch laesst es sich nicht mehr aus der Wunde Deines Gegners ziehen.\n") );  
		  tell_room(ENV(ENV(TO)), BS("Das gezackte Obsidanschwert von " + ENV(TO)->Name() + " bleibt in der Wunde des Gegners stecken.\n"),({ENV(TO)}));
		  call_out("pullout",random(6)+8,ENV(TO));
		  TO->DoUnwield(1);
		  TO->move(enemy);
	  } 
   }
   return 0; 
}
