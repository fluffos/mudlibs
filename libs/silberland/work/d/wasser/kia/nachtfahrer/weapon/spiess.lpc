// By Kia@Silberland 5.2003

inherit "std/weapon";           

#include <properties.h>        
#include <language.h>           
#include <combat.h>             


void create()
{
  
  if (!is_clone(this_object()))
    return;

  ::create();   

 
  AddId("spiess");
  AddId("grillspiess");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Grillspiess");
  SetProp(P_SHORT, "Ein Grillspiess");
  SetProp(P_LONG,
    "Ein langer, spitzer Grillspiess, auf noch Reste des letzen Wesens haengen, "
    "das daraufgespiesst war. In geschickten Haenden ist der Spiess eine gefaehrliche "
    "Waffe. ");
  SetProp(P_VALUE, 800);
  SetProp(P_WEIGHT, 500);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);      
  SetProp(P_DAM_TYPE, DT_PIERCE);     
  SetProp(P_WC, 70);
  SetProp(P_WC_BONUS, (["knilda":190]) );
  SetProp(P_WC_FIX, 25);
  
}
