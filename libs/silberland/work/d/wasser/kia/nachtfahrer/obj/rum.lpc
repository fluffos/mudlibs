#include "../def.h"

inherit "std/food";  
#include <food.h>

public void create() {
  if(!is_clone(this_object())) return;

  ::create(({"trink", "trinke"}));

  SetProp(P_SHORT, "Eine verkorkte Flasche Rum");
  SetProp(P_LONG,
    "Diese Tonflasche ist fest verkorkt und mit XXX beschriftet. Eindeutig "
    "bester Rum aus Eigenproduktion."
  );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Flasche Rum");
  AddId( ({ "flasche", "rumflasche" , "rum", "\nnachtfahrer_rum"}) );

  SetProp(P_NAME_ADJ,"verkorkt" );
  AddAdjective( ({"verkorkte","verkorkter","verkorkten"}) );

  SetProp(P_WEIGHT, 500); 
  SetProp(P_VALUE, 50);        // und ist hier 50 Muenzen wert.
  SetProp(P_MATERIAL, ([ MAT_MISC_SOLID:20, MAT_ALCOHOL:20 ]) );

  SetProp(P_SMELL,
    "Scheint im Mondschein selbstgebrannt. Hoffentlich wirst du nicht blind.\n");

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10,10 }),
         F_SOAK    : 0, 
         F_DRINK   : 10,
         F_ALCOHOL : 20,
         F_POISON  : 0,
         F_MSG     : "Du entkorkst den Rum und schuettest ihn runter. Gar nicht so schlecht!",
         F_MSG_ROOM: "entkorkt eine Flasche Rum und schuettet sie in einem Zu runter.",
         F_VERB    : "trinken"
      ]) );
}
