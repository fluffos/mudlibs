// By Kia@Silberland 5.2003
// Muschel kann als Messer-Ersatz dienen, um das Seil in f4_1 abzuschneiden.
// Man erhaelt sie in Raum e2_1 durch Forschen.

#include "../def.h"
#pragma strong_types

inherit "/std/thing";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Ein Teil einer Muschel");
  SetProp(P_LONG,"Ein scharfkantige Teil einer Jakobsmuschel. "
                 "In manchen Situationen kann er vielleicht ein Messer ersetzen.");
  
  AddId(({"teil","muschel","jakobsmuschel","\n_muschelteil"}));
  
  SetProp(P_NAME, "Teil einer Jakobsmuschel");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MATERIAL, MAT_MISC_SOLID);

}


	