// By Kia@Silberland 5.2003
// Invis-Objekt, das man braucht um von der Insel wieder wegzukommen.
// Man erhaelt es durch Forschen am Gipfel.

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

inherit "std/thing";


void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"\n_kompass"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_INVIS, 1);
 
}

void reset()
{
    if (!is_clone(TO)) return;
	::reset();
	tell_object(ENV(TO),BS("Du scheinst den Weg von der Schmugglerinsel zum Fischerdorf wieder vergessen zu haben.\n"));
	TO->remove();
}