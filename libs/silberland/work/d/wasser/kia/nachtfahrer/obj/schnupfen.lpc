#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

inherit "std/thing";

int zeit;

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"\n_schnupfen"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_INVIS, 1);

  zeit=15;

  call_out("hatschi", 3);

}

void hatschi()
{
  if(ENV(TO) && interactive(ENV(TO)))
  {
    switch(random(4))
    {
      case 0:
        tell_object(ENV(TO), BS("Deine Nase rinnt wie ein Wasserfall! Du schneuzt Dich in "
                                "den Aermel und hoffst dass niemand es sieht...\n") );
        break;
      case 1:
        tell_object(ENV(TO), BS("Hatschiiiiiiiiii!!! Du niest lautstark.\n") );
        break;
      case 2:
        tell_object(ENV(TO), BS("Du fuehlst Dich, als wuerde Dein Kopf gleich in 1000 "
                                "Teile zerspringen. \n") );
        break;
      case 3:
        tell_object(ENV(TO), BS("Deine Augen traenen, um Dich herum dreht sich alles.\n") );
        
        break;
      case 4:
        tell_object(ENV(TO), BS("Du schniefst lautstark. Dieser Schnupfen bringt Dich "
                                "noch um.\n") );
    }

  }
  zeit--;

  if(zeit <= 0)
  {
    call_out("remove",0);
  }
  else
  {
    call_out("hatschi", 10+random(8));
  }
}

int stop()
{
  zeit = 0;
  return 1;
}
