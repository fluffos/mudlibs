// By Kia@Silberland 5.2003
// Invis-Objekt, das benoetigt wird um sich ein Boot fuer die Schmugglerinsel zu mieten.
// (fluester rokko zu kapitaen)

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

inherit "std/thing";


void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"\n_bootobjekt"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_INVIS, 1);
 
}

void reset()
{
    ::reset();
	TO->remove();
}