// Braucht man, um die Falltuer bei Anheg zu oeffnen, hat Anheg im Inventar.

#include "../def.h"
#pragma strong_types

inherit "/std/thing";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Ein steinerner Schluessel");
  SetProp(P_LONG,"Ein kleiner Schluessel, der vollkommen aus "
                 "Felsgestein besteht.\n ");
  AddId(({"schluessel","\n_kiaschluessel"}));
  
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_MISC_STONE);

}


	