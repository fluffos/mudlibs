// By Kia@Silberland 5.2003

inherit "std/armour";          

#include <properties.h>         
#include <language.h>          
#include <combat.h>             
                                

void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  
  AddId("hosenanzug");
  AddId("anzug");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Hosenanzug");
  SetProp(P_SHORT, "Eine Hosenanzug in Ubergroesse");
  SetProp(P_LONG, 
      "Ein Hosenanzug in Uebergroesse, der aus ausgewaschenem apricotfarbenem "
      "Stoff besteht. Rund um die Taille ist ein Gummi durchgezogen. ");
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 500);
  SetProp(P_MATERIAL, ([ MAT_CLOTH : 100 ]) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 6);
  SetProp(P_QUALITY_DECAY, 80); 
  SetProp(P_WORN_TEXT, "getragen");
  SetProp(P_WEAR_TEXT, ({ "Du ziehst den Hosenanzug an.\n",
                          " zieht den Hosenanzug an.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du ziehst den Hosenanzug aus.\n",
                            " zieht den Hosenanzug aus.\n" }) );
  
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:5,T_HEAT_PROT:-3 ]) );


}
