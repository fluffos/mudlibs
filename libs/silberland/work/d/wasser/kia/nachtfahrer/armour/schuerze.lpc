// By Kia@Silberland 5.2003

inherit "std/armour";          

#include <properties.h>         
#include <language.h>          
#include <combat.h>             
                                

void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();  

  
  AddId("schuerze");

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Schuerze");
  SetProp(P_SHORT, "Eine kesse Schuerze");
  SetProp(P_LONG, 
      "Eine kesse schwarze Schuerze, wie sie Kellnerinnen oft anhaben. "
      "Vorne ist sie mit weisser Spitze besetzt und seitlich hat sie "
      "zwei breite Baender, mit denen man sich die Schuerze umbinden "
      "kann. ");
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([ MAT_CLOTH : 100 ]) );
  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 1);
  SetProp(P_QUALITY_DECAY, 50);  
  SetProp(P_WORN_TEXT, "um die Taille gebunden");
  SetProp(P_WEAR_TEXT, ({ "Du bindest Dir die kesse Schuerze um die Taille.\n",
                          " bindet sich die kesse Schuerze um die Taille.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du loest den Knoten und legst die kesse Schuerze ab.\n",
                            " loest den Knoten und legt die kesse Schuerze ab.\n" }) ); 
  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:-1,T_HEAT_PROT:3 ]) );


}
