// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "Oberhalb des Steges");
  SetProp (P_INT_LONG,
    "Du folgst dem mit Geroell und Schutt uebersaeten Klippenpfad. Er "
    "weist Spuren von menschlicher Bearbeitung auf und wurde anscheinend "
    "kuenstlich angelegt. Wohin er wohl fuehren mag? Rund um Dich ruehrt "
    "sich nichts, ausser ein paar aufgescheuchten Insekten. Vollkommen kahl "
    "liegen die Felsen vor Dir. Das Licht ist so spaerlich, dass weder "
    "Moose noch Flechten auf dem harten Fels Fuss gefasst haben.");
  
  AddDetail(({"angreifer"}),
    "Noch ist keiner da, aber wer weiss?");
  AddDetail(({"aufstieg"}),
    "Der Aufstieg ist so schon anstrengend genug, Du bist heilfroh, nicht "
    "klettern zu muessen.");
  AddDetail(({"augen"}),
    "Du schliesst kurz Deine Augen und siehst nun wieder etwas klarer.");
  AddDetail(({"augenwinkel"}),
    "Deine Augen sind vom angestrengten Schauen ueberstrapaziert und "
    "spielen Dir wohl einen Streich.");
  AddDetail(({"baeume","baum"}),
    "Kein Baum weit und breit.");
  AddDetail(({"bearbeitung"}),
    "Irgendjemand hat einen halbwegs ebenen Pfad in die Klippen geschlagen. "
    "Du fragst Dich, wohin er wohl fuehrt.");
  AddDetail(({"bewegungen","augenwinkel"}),
    "Immer wieder glaubst Du, in den Augenwinkeln Bewegungen zu sehen. Das "
    "sind wohl die Nerven...");
  AddDetail(({"blicke","blick"}),
    "Alles, was hinter dem Felsen ist, bleibt Deinen Blicken verwehrt.");
  AddDetail(({"blumen","blume"}),
    "Du hast bisher noch keine einzige Blume gesehen, die Insel scheint "
    "vollkommen unfruchtbar zu sein.");
  AddDetail(({"boden"}),
    "Geroell und Schutt uebersaehen den Boden und bringen Dich zum "
    "stolpern. Einige kleine Steinchen rollen bei jedem Schritt unter "
    "Deinen Fuessen weg.");
  AddDetail(({"duesternis"}),
    "Dunkel und zerklueftet tuermen sie sich auf, und Du glaubst manchmal, "
    "Bewegungen wahrzunehmen.");
  AddDetail(({"fels","felsen"}),
    "Die Klippen bestehen aus zerklueftetem Fels.");
  AddDetail(({"flechten","flechte"}),
    "Die koennen normal selbst in so unwirtlichen Gegenden wie dieser "
    "ueberleben, aber Du siehst nicht mal eine Flechte.");
  AddDetail(({"fuesse","fuss"}),
    "Auf denen wanderst Du durchs Silberland. Obwohl, momentan stolperst Du "
    "mehr.");
  AddDetail(({"geroell","schutt"}),
    "Der Pfad ist mit Geroell und Schutt uebersaet und nicht gerade bequem, "
    "aber ohne ihn waer der Aufstieg eine Kletterpartie.");
  AddDetail(({"himmel"}),
    "Der Himmel ist grau und duester. Eigentlich magst Du ihn gar nicht "
    "anschaun. Schnell senkst Du den Blick wieder.");
  AddDetail(({"insekten","insekt"}),
    "Der Aufstieg hat Dich ganz schoen ins Schwitzen gebracht. Das riechen "
    "die Insekten, und sie schwirren wie wild um Deinen Kopf.");
  AddDetail(({"kletterpartie"}),
    "So ist es jedenfalls einfacher und bequemer.");
  AddDetail(({"klippen"}),
    "Ueber den Klippen scheint eine unsichtbare Duesternis zu liegen, die "
    "Dir Unbehagen bereitet.");
  AddDetail(({"kopf"}),
    "Du schuettelst den Kopf wild, aber die Insekten lassen sich so nicht "
    "verscheuchen.");
  AddDetail(({"licht"}),
    "Es sieht so aus, als waere es hier auch bei Tageslicht nicht "
    "wesentlich heller, denn Pflanzen hast Du auf der ganzen Insel noch "
    "keine gesehen.");
  AddDetail(({"moose"}),
    "Schade, mit ein wenig Moos auf den Felsen wuerde alles gleich weniger "
    "trostlos aussehen.");
  AddDetail(({"nerven"}),
    "Manchmal gehen Deine Nerven mit Dir durch.");
  AddDetail(({"pfad","klippenpfad"}),
    "Der Pfad windet sich die Klippen hinauf und fuehrt weiter unten zum "
    "Steg. Weiter suedlich verschwindet er hinter dem naechsten Felsen.");
  AddDetail(({"pflanzen"}),
    "Kein Baum, keine Blume, nicht mal Moose und Flechten.");
  AddDetail(({"schauen"}),
    "Immer wieder siehst Du Dich um, um auf alles vorbereitet zu sein.");
  AddDetail(({"schwitzen"}),
    "Es ist zwar nicht warm, aber der Aufstieg war anstrengend.");
  AddDetail(({"silberland"}),
    "Da bist Du gerade!");
  AddDetail(({"spuren"}),
    "Der Weg ist zu steinig, als dass man irgendwelche Spuren sehen "
    "koennte.");
  AddDetail(({"steg"}),
    "Du beugst Dich etwas nach vor und siehst zwischen den Klippen den Steg "
    "unter Dir.");
  AddDetail(({"steinchen"}),
    "Die Steinchen rollen den Pfad hinunter und landen mit einem leisen "
    "*PING* auf dem Steg.");
  AddDetail(({"streich"}),
    "Auch auf seine Augen kann man sich nicht immer hundertprozentig "
    "verlassen.");
  AddDetail(({"unbehagen"}),
    "Du fuehlst Dich ein bisschen unwohl hier. Dir ist, als waerst Du auf "
    "den Klippen jedem Angreifer hoffnungslos ausgeliefert.");
  AddDetail ( ({"insel"}),
    "Diese Insel scheint ziemlich unfruchtbar zu sein.");
  AddDetail ( ({"tageslicht"}),
    "Du fragst Dich, wie es hier bei Tageslicht aussieht.");
  AddDetail ( ({"moos"}),
    "Schade, mit ein wenig Moos auf den Felsen wuerde alles gleich weniger "+
    "trostlos aussehen.");
  AddDetail ( ({"schritt"}),
    "Jeder Schritt bringt einige kleine Steinchen ins Rollen.");
  AddDetail ( ({"rollen"}),
    "Die Steine kullern lautstark den Weg hinab.");
  AddDetail ( ({"weg"}),
    "Der Weg ist eigentlich eher ein Pfad, der die Klippen entlang fuehrt.");
  AddDetail ( ({"steine"}),
    "Die Steinchen rollen den Pfad hinunter und landen mit einem leisen "+
    "*PING* auf dem Steg.");
  AddDetail ( ({"wasser","meer"}),
    "Unter Dir befindet sich das Meer.");
  
  AddSound(DEFAULT_SOUND,
    "Der Wind weht hier staerker als weiter unten, und die Luft ist von "
    "seinem Heulen erfuellt.");
  AddSound(({"geraeusche"}),
    "Du hoerst nur das Heulen des Windes.");
  AddSound(({"heulen"}),
    "Der Wind heult laut. Selbst wenn da andere Geraeusche waeren, "
    "koenntest Du sie wahrscheinlich nicht hoeren.");
  AddSound(({"luft"}),
    "Die Luft ist vom Heulen des Windes erfuellt.");
  AddSound ( ({"wind"}),
    "Der Wind wird durch nichts gebremst und ist dementsprechend laut und "+
    "heftig.");
  AddSmell(DEFAULT_SMELL,
    "So hoch oben ist die Luft frisch und rein, wie nach einer Vollwaesche.");
  AddSmell(({"luft"}),
    "Die Luft riecht irgendwie unberuehrt... doch halt, da liegt noch "
    "irgendein Geruch in der Luft, so schwach, dass Du ihn fast nicht "
    "wahrgenommen haettest.");
  AddSmell ( ({"vollwaesche"}),
    "Wie frisch gewaschen!");
  

AddExit("unten", "./f4_1");
AddExit("sueden", "./mnpcf5_2");

AddCmd ( ({"verscheuche", "verscheuch"}), "cmd_verscheuche");

}

int cmd_verscheuche (string str)
{
   notify_fail("Was moechtest Du verscheuchen?\n");
   
   if((str=="insekten"))
   {  
       
       write(BS("Du fuchtelst wild mit beiden Armen herum. Kurze Zeit nehmen "
                "die Insekten reissaus, doch schon nach wenigen Sekunden ist "
                "es genauso schlimm wie vorher.\n"));
       say( TPN + " fuchtelt mit beiden Armen herum um die Insekten zu verscheuchen.\n");
       return 1;
   }
   return 0;
} 

