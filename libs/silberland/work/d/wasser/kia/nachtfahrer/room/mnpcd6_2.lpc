// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

int wasser;
void create()
{
  ::create();
  wasser = 1;

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
   SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "Am Klippenpfad");
  SetProp (P_INT_LONG,
    "Die Klippe ist hier leicht eingebuchtet, sodass diese Stelle vom "+
    "Wind geschuetzter ist als der restliche Pfad. Ausserdem fuehlst Du "+
    "Dich hier vor beobachtenden Blicken sicher. Ein kleines "+
    "Wasserrinnsal sprudelt aus einem Loch im Fels und rinnt gemaechtlich "+
    "die Klippe hinunter. Richtung Nordosten und Suedwesten kannst Du dem "+
    "Klippenpfad weiter folgen. ");
  
  AddDetail ( ({"loch"}),
    "Ein Loch im Fels, aus dem ein kleines Wasserrinnsal hervorsprudelt.");
  AddDetail ( ({"rinnsal", "wasserrinnsal"}),
    "Aus einem Loch im Fels sprudelt Wasser, das gemaechtlich die Klippe "+
    "hinunterplaetschert und weiter unten ins Meer fliesst. ");
  AddDetail ( ({"grund"}),
    "Der Grund des kleinen Rinnsals ist glitschig und voller Algen.");
  AddDetail ( ({"algen"}),
    "Du greifst vorsichtig in das Wasser. Die Algen fuehlen sich genauso "+
    "glitschig an, wie sie aussehen. Sie sind so gruen, dass das ganze "+
    "Rinnsal gruen aussieht, obwohl das Wasser eigentlich klar ist.");
  AddDetail ( ({"schnecken"}),
    "Genau genommen siehst Du ja nur Schneckenhaeuser, die aber groesser "+
    "sind als normal. Das Wasser scheint etwas Besonderes auf sich zu "+
    "haben.");
  AddDetail ( ({"besonderes"}),
    "Was an diesem Wasser wohl besonders ist?");
  AddDetail ( ({"schneckenhaeuser"}),
    "Die Schneckenhaeuser sind groesser als normal. Du vermutest, dass "+
    "sich darin Schnecken befinden, aber Du siehst keine. Sie haben sich "+
    "bei Deinem Anblick verzogen.");
  AddDetail ( ({"anblick"}),
    "Du betrachtest Dein Spiegelbild im Wasser und findest, dass Du "+
    "wirklich zum davonlaufen aussiehst.");
  AddDetail ( ({"spiegelbild"}),
    "Der Wind hat Dich ganz zerwuschelt, Du solltest Dich mal wieder "+
    "buersten. Allerdings glaubst Du kaum, dass sich die Schnecken darum "+
    "verkrochen haben.");
  AddDetail ( ({"wind"}),
    "Hier bist Du durch die Klippe vom Wind relativ geschuetzt. Nur ein "+
    "kleines Lueftchen weht.");
  AddDetail ( ({"lueftchen"}),
    "Du spuerst das Lueftchen auf Deiner Haut. Du kannst ihm aber auch "+
    "lauschen.");
  AddDetail ( ({"haut"}),
    "Das Lueftchen streicht sanft ueber Deine Haut.");
  AddDetail ( ({"insel"}),
    "Die Insel ist ein wirklich unwirtlicher Ort.");
  AddDetail ( ({"ort"}),
    "Nicht gerade ein Ort an dem Du Dich wohlfuehlst.");
  AddDetail ( ({"fels"}),
    "Der Fels besteht aus hartem, glatten Kalkgestein. Aus einem Loch "+
    "sprudelt kaltes, klares Wasser.");
  AddDetail ( ({"gestein", "kalkgestein"}),
    "Kalkgestein ist normal hellgrau, aber bei diesem Licht sieht es fast "+
    "schwarz aus.");
  AddDetail ( ({"licht"}),
    "Der Mond taucht alles in ein truegerisches Licht.");
  AddDetail ( ({"mond"}),
    "Eine grosse, helle Scheibe die am Himmel steht und truegerische "+
    "Strahlen verbreitet.");
  AddDetail ( ({"scheibe"}),
    "Streng genommen ist der Mond keine Scheibe, aber dennoch sieht er so "+
    "aus.");
  AddDetail ( ({"strahlen"}),
    "Die Strahlen strahlen, wer haette das gedacht.");
  AddDetail ( ({"klippe"}),
    "Die ganze Insel scheint eine einzige Klippe mit ein bisschen Strand "+
    "zu sein. Hier ist sie leicht eingebuchtet, sodass diese Stelle fast "+
    "windgeschuetzt ist.");
  AddDetail ( ({"strand"}),
    "Den Strand bist Du vorher entlang gegangen. Hier jedoch ist nur "+
    "blanker Fels und kein einziges Sandkorn.");
  AddDetail ( ({"korn", "sandkorn"}),
    "Auch wenn Du noch so genau hinsiehst, hier ist keins!");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist in kalt und grau. Kein einziger Stern ist zu sehen, "+
    "nur einige hohe, duenne Wolken. ");
  AddDetail ( ({"stern", "sterne"}),
    "Es ist als wuerde den Sternen die Kraft zu leuchten fehlen...");
  AddDetail ( ({"kraft"}),
    "Du fuehlst Dich genauso kraftlos wie die Sterne. Ein Schluck Wasser "+
    "koennte jetzt nicht schaden.");
  AddDetail ( ({"schluck"}),
    "Das Wasser sieht koestlich erfrischend aus. ");
  AddDetail ( ({"wolken"}),
    "Die Wolken tuermen sich auf. Jedoch ist keinesfalls der ganze Himmel "+
    "mit Wolken bedeckt, deshalb wundert es Dich um so mehr, dass kein "+
    "einziger Stern zu sehen ist.");
  AddDetail ( ({"boden"}),
    "Der Boden ist felsig und ziemlich uneben. Immer wieder stolperst Du "+
    "ueber einen herumliegenden Felsbrocken.");
  AddDetail ( ({"brocken", "felsbrocken"}),
    "Ein paar Felsbrocken liegen herum, die sich scheinbar von der Klippe "+
    "geloest haben.");
  AddDetail ( ({"wesen"}),
    "Auf der Insel hast Du noch nicht viel Lebendiges gefunden. Nicht "+
    "einmal ein Baum koennte ueberleben.");
  AddDetail ( ({"lebendiges"}),
    "Diese Schnecken werden doch ausser Dir nicht die einzigen lebenden "+
    "Wesen sein?");
  AddDetail ( ({"baum"}),
    "Weit und breit keiner zu sehen. Nicht mal das kleinste Baeumchen.");
  AddDetail ( ({"baeumchen"}),
    "Kein Baeumchen zu sehen, ausser es ist so klein, dass Du es nicht "+
    "sehen kannst. ");
  AddDetail ( ({"meer"}),
    "Weiter unten muendet das kleine Rinnsal im Meer. ");
  AddDetail ( ({"stelle"}),
    "Du fuehlst Dich an dieser Stelle nicht mal so unwohl. Die Klippen "+
    "schuetzen Dich vor eventuellen beobachtenden Blicken und vorm Wind.");
  AddDetail ( ({"blicke"}),
    "Hier bist Du endlich das Gefuehl los, beobachtet zu werden.");
  AddDetail ( ({"gefuehl"}),
    "Gefuehle kann man oft nur schwer in Worten beschreiben, aber hier "+
    "fuehlst Du Dich halbwegs sicher.");
  AddDetail ( ({"worte"}),
    "Du betrachtest fasziniert das kleine Rinnsal und Dir fehlen einfach "+
    "die Worte.");
  AddDetail ( ({"pfad"}),
    "Der Pfad fuehrt um die Klippe herum. Du befindest Dich auf ihm.");
  AddDetail ( ({"klippenpfad"}),
    "Der Pfad fuehrt um die Klippe herum. Du befindest Dich auf ihm.");
 
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst das Plaetschern von Wasser.");
  AddSound ( ({"plaetschern", "wasser"}),
    "Das Wasser plaetschert leise vor sich hin. Du wirst ganz durstig.");
  AddSound ( ({"lueftchen"}),
    "Das Lueftchen fluestert Dir Worte zu, die Du noch die zuvor gehoert hast. "
	"Es klingt jedenfalls schoen, auch wenn Du sie nicht verstehst. ");
  AddSound ( ({"worte"}),
    "Leider verstehst Du sie nicht. Was so ein Lueftchen wohl alles zu erzaehlen haette... ");
  AddSmell ( ({DEFAULT_SMELL}),
    "Das Wasser riecht einfach koestlich. Aber auch sonst riecht es hier "
	"wirklich gut. Du fuehlst Dich eigentlich richtig wohl.");
  AddSmell ( ({"wasser"}),
    "Vielleichst solltest Du es mal kosten?");

  AddSpecialDetail ( ({"wasser"}), "detail_wasser");
	
  AddCmd( ({ "trinke", "trink", "koste", "kost"}), "cmd_trink" );


  AddExit ("nordosten", "./mnpce5_2");
  AddExit ("suedwesten", "./mnpcc7_2");

  AddItem(NPC "schmuggler",REFRESH_DESTRUCT,"");

}

void reset()
{
	::reset();
	wasser = 1;
 }

int cmd_trink(string str)
{
  notify_fail( "Was willst Du trinken?\n" );

  if( str == "wasser" || str == "aus Rinnsal" )
  {
    if( wasser == 0) 
    {
      write(BS("Brrr, das Wasser ist ja ganz schmutzig. Sowas willst Du nicht trinken!\n"));
      return 1;
    }
    else 
    {                                                                    
      write(BS("Du formst Deine Haende zu einer Schale und trinkst gierig. Du fuehlst Dich "
            "ploetzlich herrlich erfrischt.\n"));
      say(BS( TPN+" trinkt etwas von dem Quellwasser und sieht ploetzlich viel frischer aus.\n"));
      TP->AddHp(30);
      TP->AddSp(30);
      wasser = 0;
    }
    return 1;
  }
  return 0;
}

string detail_wasser ()
{
   if (wasser == 0)
   {
      return BS("Das Wasser ist schmutzig, irgendwer oder irgendwas muss es aufgewuehlt haben.\n");
   }
   else
   {
      return BS("Das Wasser sieht klar und rein aus. Du siehst sogar einige Schnecken "+
                "am Grund - einige der wenigen Wesen, die auf der Insel ueberleben "+
                "koennen.");
   }
 }
