// kleiner Bugfix beim nehmen des Schwerts, siehe unten (Cirion)

#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";
int spinne;
int schwert;
int vit_geschlossen;

void create()
{
  ::create();
  spinne = 1;
  schwert = 1;
  vit_geschlossen = 1;

  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:13, ENV_TERRAIN: TT_CAVE]));
  SetProp (P_INT_SHORT, "Eine Lagerhoehle");
  SetProp (P_INT_LONG,
    "Diese Hoehle ist nicht sehr gross, aber unglaublich vollgestopft. "+
    "Ueberall stehen Kisten und Truhen herum, und entlang den Waenden "+
    "sind Regale voller Schmugglergut angebracht.");

  AddDetail ( ({"boden"}),
    "Niemand hat sich die Muehe gemacht, den Boden mit Lehm einzuebnen, Du "+
    "stehst auf blankem Fels.");
  AddDetail ( ({"lehm"}),
    "Das wurde hier nicht fuer notwendig empfunden. Wer weiss, wie oft "+
    "diese Hoehle betreten wird...");
  AddDetail ( ({"hoehle"}),
    "Sie ist ziemlich eng und muffig. ");
  AddDetail ( ({"fels"}),
    "Der Boden, die Waende und auch die Decke bestehen aus blankem Fels. "+
    "Es duerfte sich um irgendein Kalkgestein handeln.");
  AddDetail ( ({"gestein", "kalkgestein"}),
    "Nicht, dass Du Experte darin waerst, aber es koennte sich durchaus um "+
    "Kalkgestein handeln.");
  AddDetail ( ({"experte"}),
    "Man braucht kein Experte zu sein, um zu erkennen, dass es sich dabei "+
    "um Kalkgestein handelt.");
  AddDetail ( ({"muehe"}),
    "Naja, wozu auch? Es handelt sich ja nur um eine kleine Hoehle.");
  AddDetail ( ({"waende", "wand", "ostwand", "westwand", "nordwand"}),
    "Die Waende sind so voller Regale, dass man sie dazwischen kaum "+
    "erkennt. Jedenfalls bestehen sie aus Felsgestein, genau wie der Boden "+
    "und die Decke. Nur die Suedwand ist fast leer.");
  AddDetail ( ({"suedwand"}),
     "Die Suedwand ist leer, bis auf eine glaeserne Vitrine.");
  AddDetail ( ({"wappen"}),
     "Das Wappen ist bunt verziert und sieht sehr prunkvoll aus. Da Du noch "
	 "nirgendwo im Silberland so ein Wappen gesehen hast, muss es sehr alt "
	 "sein. Nanu, an dem Wappen ist ja ein Schwert befestigt. Das haettest "
	 "Du aufgrund der schlechten Lichtverhaeltnisse ja fast uebersehen!");
  AddDetail ( ({"lichtverhaeltnisse"}),
     "Die sind hier nicht die besten.");
  AddDetail ( ({"schwert"}),
     "Du schluckst trocken. So ein prachtvolles Schwert hast Du noch nie "
	 "gesehen. Wie es sich wohl in Deiner Hand anfuehlen wuerde?");
  AddDetail ( ({"klinge"}),
     "Die Klinge ist unglaublich scharf.");
  AddDetail ( ({"hand"}),
     "Du wuerdest gerne ausprobieren wie gut das Schwert in der Hand liegt.");
  AddDetail ( ({"regale"}),
    "Die Regale sind vollgestopft mit allerhand Truhen, Kisten und anderem "+
    "Zeugs.");
  AddDetail ( ({"truhen"}),
    "Verstaubte alte Truhen. Du wendest Dich gelangweilt ab.");
  AddDetail ( ({"staub"}),
    "Alles ist voller Staub, die Hoehle wird nicht oft betreten.");
  AddDetail ( ({"kisten"}),
    "Wer weiss was da drinnen ist. Sie scheinen schon laenger herumzustehen. "
	"Vielleicht hat ja sogar Anheg selbst vergessen, was da drin ist.");
  AddDetail ( ({"felsgestein"}),
    "Nicht, dass Du Experte darin waerst, aber es koennte sich durchaus um "+
    "Kalkgestein handeln.");
  AddDetail ( ({"decke"}),
    "Auch die Decke besteht aus Fels. Dort, wo die Falltuer ist, befindet "+
    "sich ein heller Lichtfleck. Von ueberall haengen alte, verstaubte "+
    "Spinnweben herab.");
  AddDetail ( ({"falltuer"}),
    "Dort, wo vorher die Falltuer war, ist jetzt ein viereckiger "+
    "Lichtfleck.");
  AddDetail ( ({"fleck", "lichtfleck"}),
    "Du starrst blinzelnd in den Lichtfleck und fuehlst Dich ploetzlich "+
    "geblendet. Mist, jetzt kannst Du gar nichts mehr erkennen.");
  AddDetail ( ({"spinnweben", "weben"}),
    "Von der Decke haengen Spinnweben. Obwohl dich ekelt, ueben sie eine "+
    "seltsame Faszination auf Dich aus.");
  AddDetail ( ({"faszination"}),
    "Die Spinnweben sind riesig, aber alt und verstaubt. Die dazugehoerige "+
    "Spinne ist wahrscheinlich schon laengst gestorben. Sicher koenntest Du "+
    "sie einfach beruehren.");
  AddDetail ( ({"spinne"}),
    "Die Spinne, die die Spinnweben gemacht hat, ist vermutlich laengst "+
    "gestorben.");
  AddDetail ( ({"gut", "schmugglergut"}),
    "Diese Hoehle ist vollgestopft damit! ");
  AddDetail ( ({"zeugs"}),
    "Seltsame Statuetten, Bilder und Saeckchen mit zweifelhaftem Inhalt.");
  AddDetail ( ({"statuetten"}),
    "Die Statuetten sind total verstaubt und eigentlich haesslich, aber da "+
    "sie aus Jade sind trotzdem wertvoll.");
  AddDetail ( ({"jade"}),
    "Auch wenn sie aus Jade sind, haesslich sind sie trotzdem.");
  AddDetail ( ({"bilder"}),
    "Alle moeglichen Bilder stehen hier herum. Sie zeigen das Silberland.");
  AddDetail ( ({"silberland"}),
    "Ein Bild zeigt eine besonders nette Szene.");
  AddDetail ( ({"bild", "szene"}),
    "Auf einem Bild siehst Du einen gut ausgeruesteten Krieger, der gegen "+
    "einen schrecklichen Fraggle kaempft.");
  AddDetail ( ({"cookies", "krieger"}),
    "Der war wohl auf die Cookies scharf ;)");
  AddDetail ( ({"fraggle"}),
    "Hast Du schon mal gegen einen Fraggle gekaempft?");
  AddDetail ( ({"saeckchen"}),
    "Du willst gar nicht wissen, was in den Saeckchen ist, sicher nichts "+
    "legales!");
  AddDetail ( ({"inhalt"}),
    "Den laesst Du mal lieber unberuehrt.");
  AddDetail ( ({"schloss"}),
    "Soll heissen: die Vitrine kriegt man nur mit geeignetem Schluessel auf.");
  AddSpecialDetail ( ({"schwert"}),
     "detail_schwert");
    AddSpecialDetail ( ({"vitrine"}),
     "detail_vitrine");


  AddSmell ( ({DEFAULT_SMELL}),
    "Hier riecht es ein wenig muffig, denn die Luft ist abgestanden.");
  AddSmell ( ({"luft"}),
    "So ein wenig frische Luft waere jetzt wirklich gut.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst ein gelegentliches Rascheln, aber ansonsten ist es still.");
  AddSound ( ({"rascheln"}),
    "Ob in dieser Hoehle Maeuse sind? ");
  AddSound ( ({"maeuse"}),
    "Du kannst keine Maeuse sehen, aber es hoert sich so an als haetten "+
    "sich welche eingenistet.");

  AddCmd (({"beruehre","beruehr"}), "cmd_beruehre");
  AddCmd (({"oeffne"}), "cmd_oeffne");
  AddCmd (({"nimm"}), "cmd_nimm");

  AddExit("oben", "./mnpcc4_2");

}

void add_schwert()
{
  if (schwert != 1)
  {
    schwert = 1;
  }
}
void reset()
{
  ::reset();
  spinne = 1;
  vit_geschlossen = 1;
  schwert = 1;

}

int cmd_beruehre(string str)
{
  object die_spinne;
  if ( (str == "spinnennetz")||(str=="netz")||(str=="spinnwebe")||(str=="spinnweben")||(str=="webe")||(str=="weben") )
  {
    if (spinne == 1)
    {
      write("Du beruehrst das Spinnennetz und irgendetwas bewegt sich....\n");
      die_spinne=clone_object(NPC "spinne");
      die_spinne->move(TO,M_GO,"","","faellt aus dem Netz herunter");
      die_spinne->kill(TP);
      TP->SetProp(P_POISON, 10);
      spinne = 0;
      return 1;
    }
    else
    {
      write("Tatsaechlich, weit und breit keine Spinne zu sehen.\n");
      return 1;
    }
  }
  write("Was willst Du beruehren?\n");
  return 1;
}

int cmd_oeffne (string str)
{

     {
	    object schluessel;
        notify_fail("Was willst Du oeffnen?\n");
        if (present("\n_kiaschluessel",TP) && str == "vitrine mit schluessel")
        {
          schluessel = present("\n_kiaschluessel",TP);
          schluessel->remove();
          vit_geschlossen = 0;
          write(BS("Du oeffnest die Vitrine, dabei bricht der Schluessel ab.\n"));
          say(TPN +" oeffnet die Vitrine.\n");
          return 1;
        }

	    if (present("\n_kiaschluessel",TP) && str == "vitrine")
        {
           write(BS("Diese Vitrine kannst Du nur mit dem passenden Schluessel oeffnen!\n"));
	       say(TPN +" ruettelt erfolglos an einer Vitrine.\n");
	       return 1;
        }

	    if ((str == "truhe") || (str == "kiste"))
        {
           write(BS("Hoffnungslos zugerostet. Du kriegst sie nicht auf.\n"));
           return 1;
        }
	}
	return 0;

}

int cmd_nimm (string str)
{
  object ob;

  notify_fail("Was willst Du nehmen?\n");
  if (schwert==1 && ((str == "schwert") || (str == "schwert aus vitrine") || (str == "schwert aus wappen")))
  {
    if (vit_geschlossen == 1)
    {
      write(BS("Aber die Vitrine ist doch Geschlossen!\n"));
      return 1;
    }
    // pruefen, ob der Spieler das ueberhaupt tragen kann! (Cirion)
    ob = clone_object(WEAPON "schwert");
    if (ME_TOO_HEAVY == ob->move(TP))
    {
      write(BS("Du nimmst das Schwert von der Wand und laesst es ein paar "
               "mal durch die Luft sausen. Es fuehlt sich an, als waere es "
               "extra fuer Dich gemacht worden. Leider kannst Du im Moment "
               "nichts mehr tragen, daher haengst Du es wieder auf."));
      say(BS(TPN +" nimmt ein Schwert von der Wand, begutachtet es und haengt "
             "es dann wieder auf."));
      ob->remove();
    }
    else
    {
      write(BS("Du nimmst das Schwert von der Wand und laesst es ein paar "
               "mal durch die Luft sausen. Es fuehlt sich an, als waere es "
               "extra fuer Dich gemacht worden."));
    say(BS(TPN +" nimmt ein Schwert von der Wand, begutachtet es und steckt "
           "es dann ein."));
      schwert = 0;
    }
    return 1;
  }
  return 0;
}

string detail_schwert ( string str )

{
  if(schwert == 1)
  {
    write(BS("So ein prachtvolles Schwert hast Du noch nie "
          "gesehen. Du laesst Deinen Finger ueber die Klinge streifen und "
          "prompt schneidest Du Dich... Wie es sich wohl in Deiner Hand "
          "anfuehlen wuerde?\n"));
    return "";
  }
  else
  {
    write(BS("Ein prachtvolles Schwert ist auf das Wappen gezeichnet. "
          "Fuer einen Moment dachtest Du schon, es sei echt.\n"));
    return "";
  }
}

string detail_vitrine ( string str )

{
  if(vit_geschlossen == 1)
  {
    write(BS("Eine glaeserne Vitrine ist das einzige, das an der Suedwand zu "
          "sehen ist. In ihr befindet sich ein Wappen. Es muss wohl sehr wertvoll "
          "sein, denn ein grosses steinernes Schloss verhindert, dass man sie ohne "
          "weiteres oeffnen kann. Sie ist geschlossen.\n"));
    return "";
  }
  else
  {
    write(BS("Eine glaeserne Vitrine ist das einzige, das an der Suedwand zu "
          "sehen ist. In ihr befindet sich ein Wappen. Sie ist geoeffnet.\n"));
    return "";
  }
}
