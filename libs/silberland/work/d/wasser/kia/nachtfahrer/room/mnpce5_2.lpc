// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "Am Klippenpfad");
  SetProp (P_INT_LONG,
    "Du gehst den schmalen, felsigen Pfad entlang, der ungefaehr in "+
    "halber Hoehe um die Klippe herumfuehrt. Grosse Felsbrocken "+
    "erschweren Dir das Vorwaertskommen massgeblich. Von hier aus hast Du "+
    "einen schoenen Blick ueber den Strand, den Du vorher entlanggegange "+
    "bist. Weiter suedwestlich macht der Klippenpfad einen Knick, sodass "+
    "Du nicht sehen kannst wohin er fuehrt. Im Osten fuehrt er hinunter "+
    "auf den Steg.");
  
  AddDetail ( ({"himmel"}),
    "Der Himmel hebt sich hellgrau gegen die Klippe ab. Hoch oben steht "+
    "der Mond, der tapfer durch eine duenne Wolke durchscheint.");
  AddDetail ( ({"wolke"}),
    "Bei genauerem Hinsehen sieht die Wolke eher wie ein Dunstschleier "+
    "aus, der sich vor den Mond geschoben hat.");
  AddDetail ( ({"hinsehen"}),
    "Du siehst genau hin und bist Dir ploetzlich sicher, dass es ein "+
    "Dunstschleier ist, der sich vor den Mond geschoben hat.");
  AddDetail ( ({"dunstschleier", "schleier"}),
    "Es sieht so aus als wuerde der Dunstschleier versuchen, den Mond zu "+
    "verdecken, doch der Mond scheint tapfer durch ihn hindurch.");
  AddDetail ( ({"mond"}),
    "Der Mond ist fast voll und so hell, dass er Deine Umgebung gerade "+
    "genug beleuchtet um zu sehen wo man hinsteigt.");
  AddDetail ( ({"umgebung"}),
    "Um Dich herum ist alles ziemlich dunkel und unheimlich.");
  AddDetail ( ({"boden"}),
    "Der Boden ist uebersaet mit Felsbrocken, die Dich im Halbdunkel immer "+
    "wieder zum stolpern bringen. Du solltest Dich vorsehen, denn ein Sturz "+
    "von der Klippe koennte toedlich enden.");
  AddDetail ( ({"halbdunkel"}),
    "Es ist hier weder richtig hell noch richtig dunkel. Der Mond spendet "+
    "genug Licht, um ein bisschen was zu sehen, aber immer wieder "+
    "uebersiehst Du einen Felsbrocken und faellst fast von der Klippe.");
  AddDetail ( ({"licht"}),
    "Das Licht kommt vom Mond, der hoch ueber Dir am Himmel steht.");
  AddDetail ( ({"sturz"}),
    "Ein Sturz koennte Deinen Tod bedeuten.");
  AddDetail ( ({"tod"}),
    "Du findest, dass Du zum Sterben noch viel zu jung bist und achtest "+
    "daher besonders darauf, wo Du hinsteigst.");
  AddDetail ( ({"sterben"}),
    "Du willst sterben? Du brauchst Dich nur von der Klippe zu stuerzen, "+
    "aber das tut ja wohl keiner freiwillig.");
  AddDetail ( ({"klippenpfad", "pfad"}),
    "Waehrend der Klippenpfad weiter noerdlich so aussieht, als waere er "+
    "von Menschenhand angelegt worden, scheint dieser hier natuerlichen "+
    "Ursprungs zu sein.");
  AddDetail ( ({"hand", "menschenhand"}),
    "Dieser Pfad sieht aus, als waere er voellig natuerlich.");
  AddDetail ( ({"ursprung"}),
    "Du gruebelst ueber den Ursprung des Pfades nach, und denkst nebenbei "+
    "auch gleich noch ueber den Ursprung der Menschheit und des Universums "+
    "nach. So, genug Philosophie fuer heute!");
  AddDetail ( ({"menschheit", "universum"}),
    "Bist Du hier, um ueber sowas nachzudenken?");
  AddDetail ( ({"philosophie"}),
    "Ja, genug davon fuer heute. Davon kriegt man auch keine Rauten.");
  AddDetail ( ({"raute", "rauten"}),
    "Immer brav forschen, dann kommen sie wie von selbst :)");
  AddDetail ( ({"hoehe"}),
    "Der Pfad ist auf halber Hoehe, aber es wuerde dennoch reichen, um Dir "+
    "bei einem Absturz den Hals zu brechen.");
  AddDetail ( ({"absturz"}),
    "Nicht auszudenken, wie Du nach einem Absturz aussehen wuerdest....");
  AddDetail ( ({"hals"}),
    "Du tastest Deinen Hals ab. Er greift sich ploetzlich schmal und "+
    "verletzlich an. Du schluckst trocken und traust Dich gar nicht mehr "+
    "nach unten zu blicken.");
  AddDetail ( ({"blick"}),
    "Du laesst den Blick ueber den Strand schweifen und siehst noch Deine "+
    "eigenen Spuren, die langsam von den Wellen weggeschwemmt werden.");
  AddDetail ( ({"spuren"}),
    "Ganz schwach glaubst Du Deine eigenen Spuren am Strand zu sehen. "+
    "Naja, vielleicht auch nur Einbildung.");
  AddDetail ( ({"einbildung"}),
    "Nein, es sieht wirklich so aus als haettest Du Spuren hinterlassen. "+
    "Wie unvorsichtig!");
  AddDetail ( ({"wellen"}),
    "Die Wellen umspuelen den Strand und verwischen langsam aber sicher "+
    "Die Spuren, die Du hinterlassen hast.");
  AddDetail ( ({"klippe"}),
    "Die ganze Insel scheint aus einer Klippe zu bestehen, Du befindest "+
    "Dich halb auf ihr.");
  AddDetail ( ({"insel"}),
    "Diese Insel ist nicht besonders gross und macht einen unwirtlichen "+
    "Eindruck.");
  AddDetail ( ({"eindruck"}),
    "Es heisst der erste Eindruck truegt oft, aber bei dieser Insel "+
    "fuehlst Du Dich immer mehr bestaetigt, je mehr Du von ihr gesehen "+
    "hast.");
  AddDetail ( ({"steg"}),
    "Der Steg liegt unter Dir. Von hier aus kannst Du keine Einzelheiten "+
    "erkennen, da muesstest Du schon naeher hingehen.");
  AddDetail ( ({"einzelheiten"}),
    "Wenn Du den Steg in allen Einzelheiten betrachen willst, solltest Du "+
    "hingehen.");
  AddDetail ( ({"strand"}),
    "Der Strand ist ein gutes Stueckchen unter Dir. Von hier aus sieht er "+
    "gar nicht mehr so fluoriszierend aus, das hat wohl was mit dem "+
    "Lichteinfall zu tun.");
  AddDetail ( ({"einfall", "lichteinfall"}),
    "Seltsam, von unten aus hat der Strand voellig anders ausgesehen. ");
  AddDetail ( ({"stueckchen"}),
    "Ein Stueckchen unter Dir sind der Steg und der Strand, den Du vorher "+
    "entlanggegangen bist. Von hier oben aus sieht alles viel winziger und "+
    "unbedeutender aus.");
  AddDetail ( ({"vorwaerskommen"}),
    "Die Felsbrocken behindern Dich und bringen Dich zum stolpern.");
  AddDetail ( ({"knick"}),
    "Der Pfad macht einen Knick, sodass Du nicht sehen kannst was sich "+
    "dahinter befindet.");
  AddDetail ( ({"vorwaerskommen"}),
    "Zwar aergern Dich die vielen Felsbrocken, aber sie hindern Dich nicht "+
    "am Vorwaertskommen.");
  AddDetail ( ({"vorwaertskommen"}),
    "Zwar aergern Dich die vielen Felsbrocken, aber sie hindern Dich nicht "+
    "am Vorwaertskommen.");
  AddDetail ( ({"brocken", "felsbrocken"}),
    "Die Felsbrocken sind von der Klippe abgebrochen und liegen nun auf "+
    "dem Pfad herum.");
  AddDetail ( ({"wasser","meer"}),
    "Das Meer befindet sich unter Dir.");
	
	
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst nur den Wind, der fast ungebremst um die Klippen heult.");
  AddSound ( ({"wind"}),
    "Naja, wenn Du GANZ genau hinhoerst kannst Du auch ein leises Rauschen "+
    "vernehmen.");
  AddSound ( ({"rauschen"}),
    "Klingt, als waere hier wo ein Bach oder sowas aehnliches.");
  AddSound ( ({"bach"}),
    "Hier siehst Du keinen Bach, aber Du hoerst dass irgendwo in der Naehe "+
    "einer sein muss.");
  AddSound ( ({"naehe"}),
    "Du hoerst das Rauschen zwar nur schwach, weil der Wind alles "+
    "uebertoent, aber es hoert sich dennoch ziemlich nahe an.");
  AddSound ( ({"klippe"}),
    "Der Wind heult lautstark um die Klippe.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du atmest tief die frische Luft ein. Herrlich!");
  AddSmell ( ({"luft"}),
    "Frische, unverbrauchte Luft. ");
 
  AddCmd( ({"stuerze", "stuerz"}), "cmd_stuerze");

  AddExit ("osten", "./mnpcf5_2");
  AddExit ("suedwesten", "./mnpcd6_2");
  AddExit ("suedwesten", "./mnpcd6_2");

}
  
int cmd_stuerze (string str)
{
   notify_fail("Wo willst Du Dich runterstuerzen?\n");

   if((str=="von klippe") || (str=="klippe runter"))
   { 
       write(BS("Du machst Anstalten, Dich von der Klippe zu stuerzen. Doch "
                "da erscheinen ploetzlich Bilder in deinem Kopf, von Deinen "
                "Freunden, Deiner Familie.... wie sie sich gierig auf Deine "
			    "Ausruestung stuerzen. Diesen Erbschleichern bist Du das ja gar "
			    "nicht vergoennt! Du machst einen Schritt zurueck und beschliesst, "
			    "doch noch eine Weile am Leben zu bleiben.\n"));
       say(TPN +" macht einen Schritt auf den Klippenrand zu, ueberlegt "
	            "es sich aber dann doch anders.\n");
       return 1;
   }
   return 0;
} 
 
