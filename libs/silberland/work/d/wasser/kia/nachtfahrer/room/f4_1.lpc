// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

int ropecut;
void create()
{
  ::create();
  ropecut = 0;

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_WATER]));
  SetProp (P_INT_SHORT, "Auf einem Steg");
  SetProp (P_INT_LONG,
    "Du stehst auf einem breiten Steg, wie Du ihn auf der Insel nicht "
    "erwartet haettest. Hier koennen problemlos auch groessere Schiffe "
    "anlegen, momentan ist jedoch keines zu sehen. Ein dicker, gusseisener "
    "Pflock ist in den Boden eingelassen. Jemand hat Stufen in die Steine "
    "gehaun, sodass Du bequem die Klippen erklimmen kannst. Nordwestlich "
    "von Dir befindet sich der Strand.");
  AddDetail(({"auge","augen"}),
    "Der Steg wurde geschickt angelegt. Er ist halbkreisartig von hohen "
    "Klippen umgeben, sodass er dem ungeuebten Auge leicht entgeht.");
  AddDetail(({"baumstaemme","staemme","eichenstaemme"}),
    "Der Steg ist aus dicken Eichenstaemmen, die auf stuetzende Bretter "
    "genagelt wurden.");
  AddDetail(({"boden"}),
    "Unter Dir befindet sich der Steg.");
  AddDetail(({"bretter"}),
    "Vorsichtig huepfst Du auf dem Steg auf und ab. Er wackelt nicht mal "
    "merkbar. Die Bretter halten sicher einiges aus.");
  AddDetail(({"festschmaus","schmaus"}),
    "Deine Leiche wuerde fuer sie einen perfekten Festschmaus abgeben.");
  AddDetail(({"geier"}),
    "Wohl eher Kraehen.");
  AddDetail(({"halbkreis"}),
    "Du bist halb von den Klippen eingeschlossen.");
  AddDetail(({"himmel"}),
    "Die Wolkendecke ist hier fast undurchdringlich. Durch eine Luecke "
    "siehst Du halb den Mond. Einige grosse schwarze Voegel ziehen ihre "
    "Kreise.");
  AddDetail(({"hochwasser"}),
    "Momentan ist gerade keins, aber wenn es viel regnet steigt auch der "
    "Wasserspiegel an.");
  AddDetail(({"insel"}),
    "An dieser Insel scheinen des oefteren grosse Schiffe anzulegen.");
  AddDetail(({"jemand"}),
    "Du weisst nicht, wer das war.");
  AddDetail(({"klippen"}),
    "Die Klippen umgeben Dich halbkreisfoermig und bilden stellenweise "
    "einen leichten Ueberhang. Jemand hat Stufen hineingeschlagen, sodass "
    "Du sie ganz leicht erklimmen kannst.");
  AddDetail(({"kopf"}),
    "Nicht direkt ueber Deinem Kopf, sondern schon weiter oben.");
  AddDetail(({"kraehen"}),
    "Egal ob Geier oder Kraehen, Du stellst es Dir unangenehm vor, sich von"
    "ihnen die Augen auspicken zu lassen.");
  AddDetail(({"kreise"}),
    "Die Voegel kreisen ueber Deinem Kopf und stossen schrille Schreie aus.");
  AddDetail(({"leiche","geschmaecker"}),
    "Geschmaecker sind halt verschieden.");
  AddDetail(({"licht"}),
    "Ohne das Licht des Mondes waere es hier noch finsterer.");
  AddDetail(({"luecke"}),
    "Die Wolkendecke weist eine Luecke auf, durch die der Mond scheint.");
  AddDetail(({"meer"}),
    "Diese Stelle ist sehr windgeschuetzt. Das Meer bewegt sich "
    "gemaechlich, und kleine Wellen schwappen dann und wann gegen den "
    "Steg.");
  AddDetail(({"menschenhand"}),
    "Irgendjemand hat die Klippen bearbeitet, damit man sie leichter "
    "erklimmen kann.");
  AddDetail(({"metall"}),
    "Das Metall rostet schon. Aha. Der Pflock steht also schon laenger da.");
  AddDetail(({"mond"}),
    "Der Mond ist halb verdeckt. Seine Strahlen spenden Dir ein bisschen "
    "Licht.");
  AddDetail(({"pflock"}),
    "Ein dicker Pflock, der sicher einiges aushaelt. Er besteht aus Metall "
    "und ist fest im Boden verankert. Jemand hat ein Seil daran befestigt.");
  AddDetail(({"ruck"}),
    "Du ziehst so fest Du kannst an dem Seil, aber es reisst nicht.");
  AddDetail(({"schiff"}),
    "Momentan ist keines da. Wer weiss, wenn du ein paar Tage hier "
    "rumidelst, vielleicht kommt dann mal eins.");
  AddDetail(({"schiffe"}),
    "Sosehr Du Deine Augen auch anstrengst, Du siehst weit und breit kein "
    "Schiff. Du musst Dir schon etwas anderes einfallen lassen, um von hier "
    "wieder wegzukommen.");
  AddDetail(({"schreie"}),
    "Du kannst die Schreie nicht sehen, aber dafuer umso lauter hoeren.");
  AddDetail(({"seil"}),
    "Das Seil ist zwar nur fingerdick, aber so gut wie reissfest, wie du mit "
    "einem gekonnten Ruck feststellst. Wenn Du kein Seil dabeihast, koennte Dir "
    "dieses hier helfen.");
  AddDetail(({"steg"}),
    "Der Steg ist sehr breit, und haettest Du nicht weiter noerdlich "
    "angelegt dann waere er Dir sofort ins Auge gestochen. Er wurde aus "
    "Baumstaemmen gemacht und steht auf vielen Stelzen.");
  AddDetail(({"steine","stein"}),
    "Die Steine sind mit Werkzeug bearbeitet worden.");
  AddDetail(({"stelle"}),
    "Diese Stelle ist durch die Klippen ziemlich geschuetzt.");
  AddDetail(({"stelzen"}),
    "Die Stelzen verhindern, dass der Steg bei Hochwasser ueberschwemmt "
    "wird. Um sie herum wabert das Meer.");
  AddDetail(({"sterne"}),
    "Sterne siehst Du keine. Da ist eine Wolkendecke zwischen Dir und "
    "ihnen.");
  AddDetail(({"strahlen"}),
    "Ohne den die Strahlen des Mondes waere es hier viel finsterer.");
  AddDetail(({"strand"}),
    "Der Strand, den Du vorhin schon entlang gegangen bist, befindet sich "
    "nordwestlich von Dir.");
  AddDetail(({"stufen"}),
    "Die grobgehauenen Stufen sind eindeutig von Menschenhand gemacht und "
    "schlaengeln gemaechlich die Klippen hinauf.");
  AddDetail(({"tage"}),
    "Es gibt sicher einen besseren Weg, als hier tagelang auf ein Schiff zu "
    "warten.");
  AddDetail(({"teer"}),
    "Obwohl Du den Teer deutlich riechen kannst, sehen kannst Du keinen. "
    "Du bist Dir aber auch nicht ganz sicher, wie so ein Teer aussieht.");
  AddDetail(({"voegel"}),
    "Wie die Geier flattern sie hoch ueber Dir. Sie warten auf ihren "
    "Festschmaus.");
  AddDetail(({"wasserspiegel"}),
    "Momentan ist er normal. Du solltest froh darueber sein, sonst haettest "
    "Du nicht so bequem den Strand entlanggehen koennen.");
  AddDetail(({"weg"}),
    "Lass Dir was einfallen!");
  AddDetail(({"werkzeug"}),
    "Du fragst Dich, wer das wohl gemacht hat, und vor allem warum.");
  AddDetail(({"wellen","welle"}),
    "Dann und wann schwappt eine kleine Welle gegen den Steg.");
  AddDetail(({"wolkendecke"}),
    "Die Wolkendecke verhindert, dass Du die Sterne sehen kannst.");
  AddDetail ( ({"ueberhang"}),
    "Sie haengen sozusagen ueber Dich drueber.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist ruhig, nur ab und dann schwappt eine Welle ueber "
	"den Steg.");
  AddDetail ( ({"rost"}),
    "Ueberall auf dem Pflock befindet sich Rost.");
	
	
  AddSound(DEFAULT_SOUND,
    "Es herrscht spannungsvolle Ruhe. Nur ab und zu hoerst Du eine kleine "
    "Welle gegen den Steg schwappen, und auch der Wind saeuselt leise.");
  AddSound(({"geraeusch"}),
    "Es faellt Dir schwer, aufmerksam zu bleiben, wenn Du den Wellen "
    "zuhoerst.");
  AddSound(({"ruhe"}),
    "Hier ist es fast ruhig.");
  AddSound(({"welle"}),
    "Das Geraeusch der Wellen, wie sie gegen den Steg schwappen, wirkt "
    "einschlaefernd auf Dich.");
  AddSound(({"wind"}),
    "Der Wind saeuselt leise vor sich hin, als wuerde er auf etwas warten.");
  AddSound(({"schreie", "voegel"}),
    "Ganz leise hoerst Du ein paar Voegel schreien. Bedeutungslos.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Salzwasser und Teer.");
  AddSmell(({"geruch"}),
    "Ueberall entlang des Meeres riecht es ein bisschen nach Salzwasser.");
  AddSmell(({"meer"}),
    "Das Meer verursacht diesen Geruch.");
  AddSmell(({"salzwasser","wasser"}),
    "Der bekannte wuerzige Geruch von Salzwasser eben.");
  AddSmell(({"teer"}),
    "Warum es hier nach Teer riecht ist Dir schleierhaft. Du bist Dir aber "
    "ganz sicher, dass es Teer ist, was Du riechst.");
  

  AddExit("nordwesten", "./e3_1");
  AddExit("oben", "./f4_2");
  
  AddCmd(({"schneide","schneid"}), "cmd_schneid");
  AddCmd(({"binde","bind"}), "cmd_binde");
  AddCmd(({"loese","loes"}), "cmd_loese");

}
void reset()
{
	::reset();
	ropecut = 0;
  AddDetail(({"pflock"}),
    "Ein dicker Pflock, der sicher einiges aushaelt. Er besteht aus Metall "
    "und ist fest im Boden verankert. Jemand hat ein Seil daran befestigt.");
  AddDetail(({"ruck"}),
    "Du ziehst so fest Du kannst an dem Seil, aber es reisst nicht.");
   AddDetail(({"seil"}),
    "Das Seil ist zwar nur fingerdick, aber so gut wie reissfest, wie du mit "
    "einem gekonnten Ruck feststellst. Wenn Du kein Seil dabeihast, koennte Dir "
    "dieses hier helfen.");
 }

int cmd_schneid (string str)
{
  notify_fail("Was willst Du womit abschneiden? \n");

  if ((str=="seil mit messer ab")||(str=="seil mit muschel ab")||
      (str=="seil mit teil ab")||(str=="seil mit jakobsmuschel ab"))
  { 
    if (present("\n_muschelteil",TP)||(present("messer",TP)))
    {
      if(ropecut == 0)
      {
        write(BS("Du schneidest das Seil ab und steckst es ein.\n "));
        say( this_player()->Name(WER,2)+ " schneidet das Seil ab, das vorher"
            "um den Pflock gebunden war.\n");
        clone_object("/obj/seil")->move(this_player());
        ropecut = 1;
		AddDetail ( ({"pflock"}),
		"Ein dicker Pflock, der sicher einiges aushaelt. Er besteht aus Metall und ist "
		"fest im Boden verankert.");
		AddDetail ( ({"seil"}),
		"Vielleicht war an dem Pflock mal ein Seil dran. Jetzt ist jedenfalls keines da. ");
		AddDetail ( ({"ruck"}),
		"Du versuchst mit einem kraeftigen Ruck an dem Seil zu ziehen, das mal an dem Pflock dran "
		"war. Nachdem aber kein Seil da ist, faellst Du rueckwaerts auf den Steg.");
        return 1;
      }
      else
      {
        write(BS("Von dem Seil ist nur noch ein kuemmerliches Stueckchen "
              "uebrig, das viel zu kurz ist als dass Du es brauchen koenntest. "
              "Da war irgendjemand schneller.\n"));
        return 1;
      }
    }
	if (str=="seil ab")
	{
	  write(BS("Womit willst Du das Seil durchschneiden?"));
	  return 1;
	}
    else
    {
      write(BS("Damit kannst Du das Seil nicht durchschneiden!\n"));
      return 1;  
    }	      
  }
  return 0;
} 

int cmd_binde (string str)
{
  notify_fail("Was willst Du losbinden? \n");
  
  if ((str=="seil los") || (str=="seil von pflock") || (str=="seil von pflock los"))
  {
    write(BS("Du versuchst das Seil loszubinden, aber es ist zu fest angebunden. Vielleicht koenntest "
             "Du es ja abschneiden.\n"));
    return 1;
  }
  return 0;
}

int cmd_loese (string str)
{
  notify_fail("Was moechtest Du von wo loesen?\n");
  
  if (str=="seil von pflock")
  {
    write(BS("So einfach laesst sich das Seil nicht vom Pflock loesen. Ob es sich abschneiden laesst?\n"));
    return 1;
  }
  return 0;
 }
  

