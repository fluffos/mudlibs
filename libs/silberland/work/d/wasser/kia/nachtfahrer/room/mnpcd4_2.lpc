// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  SetProp(P_INT_SHORT, "Im Hoehlensystem");
  SetProp(P_INT_LONG,
    "Der Gang fuehrt tief ins Innere der Klippe. Hoch ueber Dir woelbt sich "
    "die schoene, natuerliche Felsdecke. Zahlreiche Steine glitzern im "
    "Feuerschein wie funkelnde Juwelen. Jeder Deiner Schritte verursacht "
    "ein hallendes Echo, das zwischen den Felswaenden widerhallt. Im Norden "
    "und im Sueden befinden sich je ein Durchlass im Gestein. ");
  
  AddDetail(({"abdruck"}),
    "Ein weisser Abdruck, der von dem Kalk im Gestein stammt.");
  AddDetail(({"arme"}),
    "Du kombinierst: die Waende sind weiter auseinander als Deine zwei Arme "
    "lang sind :)");
  AddDetail(({"bearbeitung"}),
    "Die Hoehle ist natuerlich entstanden. Da hat man sich die Bearbeitung "
    "erspart.");
  AddDetail(({"boden"}),
    "Der Boden ist aus natuerlichem Kalkgestein. Die Unebenheiten wurden "
    "mit Lehm ausgebessert, sodass er ziemlich eben ist.");
  AddDetail(({"decke","felsdecke"}),
    "Die Felsdecke ist hoch ueber Dir. Funkelnde Steine reflektieren den "
    "Feuerschein.");
  AddDetail(({"echo"}),
    "Das Geraeusch Deiner Schritte hallt zwischen den Waenden wider und "
    "wird zurueckgeworfen.");
  AddDetail(({"eingang"}),
    "Da der Eingang nur halboffen ist, zieht es hier kein bisschen.");
  AddDetail(({"fackelhalter","halter"}),
    "Einige eisene Fackelhalter sind an den Waenden angebracht. In manchen "
    "stecken brennende Fackeln.");
  AddDetail(({"fackeln"}),
    "Die Fackeln spenden Dir Licht. Ohne sie waere es hier stockdunkel.");
  AddDetail(({"feuerschein"}),
    "Der ganze Gang ist ein schummrigen Feuerschein getaucht. An den "
    "Waenden sind einige Fackelhalter angebracht.");
  AddDetail(({"finger"}),
    "Dein Finger hat nun einen weissen Abdruck.");
  AddDetail(({"gang"}),
    "Der Gang durch die Klippe scheint natuerlichen Ursprungs zu sein. Nur "
    "beim Boden wurde etwas nachgeholfen.");
  AddDetail(({"gefuehl"}),
    "Da die Waende sehr stabil erscheinen, machst Du Dir nichts weiter "
    "draus.");
  AddDetail(({"geheimnis"}),
    "Pscht, sonst waers ja kein Geheimnis mehr.");
  AddDetail(({"geraeusch"}),
    "Dem Geraeusch Deiner Schritte kannst Du lauschen. Sehen kannst Du es "
    "nicht.");
  AddDetail(({"gestein","kalkgestein","kalk"}),
    "Du beruehrst den Fels und siehst einen weissen Abdruck auf deinem "
    "Finger. Daraus schliesst Du dass das Gestein hier sehr kalkhaltig ist.");
  AddDetail(({"gold"}),
    "Wenn es Gold waere, haette es sicher schon wer abgebaut. Ausserdem  "
    "waers auch viel zu weit oben fuer Dich.");
  AddDetail(({"hoehlen","hoehle"}),
    "Geh doch einfach rein und schau nach!");
  AddDetail(({"inneres"}),
    "Der Gang fuehrt tief in die Klippe hinein.");
  AddDetail(({"juwelen"}),
    "Wenn es wertvolles Material waere haette es vermutlich laengst schon "
    "wer weggeschafft, aber es sieht dennoch huebsch aus.");
  AddDetail(({"katzengold"}),
    "Katzengold sieht so aehnlich aus wie Gold, ist aber wertlos.");
  AddDetail(({"klippe"}),
    "Ein komisches Gefuehl, so mitten in einer Klippe zu stehen.");
  AddDetail(({"lehm"}),
    "Harter, festgestampfter Lehm. Er ist stellenweise schon ausgetrocknet "
    "und weist einige kleine Risse auf.");
  AddDetail(({"licht"}),
    "Das Licht im Gang ist schummrig und flackernd, aber Du bist froh dass "
    "ueberhaupt eins scheint.");
  AddDetail(({"material"}),
    "Du tippst auf Katzengold.");
  AddDetail(({"norden","sueden"}),
    "Im Norden und im Sueden sind zwei weitere Hoehlen. Du kannst sie ganz normal "
    "betreten.");
  AddDetail(({"phantasie"}),
    "Manchmal braucht man viel Phantasie, um hinter ein Geheimnis zu "
    "kommen.");
  AddDetail(({"risse"}),
    "Der Lehm duerfte schon laenger nicht mehr erneuert worden sein.");
  AddDetail(({"schritte"}),
    "Du versuchst, Dich lautlos fortzubewegen, aber es ist zwecklos. Jeder "
    "Deiner Schritte verursacht ein lautes Geraeusch, das von den Waenden "
    "wiedergegeben wird.");
  AddDetail(({"spuren","spur"}),
    "Keine Spur davon!");
  AddDetail(({"steine"}),
    "Hoch oben glitzern und funkeln viele Steine. Mit ein bisschen "
    "Phantasie sieht die Decke aus wie der Sternenhimmel.");
  AddDetail(({"sterne"}),
    "Leute ohne Phantasie wuerden darin wohl normale Steine sehen.");
  AddDetail(({"sternenhimmel","himmel"}),
    "Tatsaechlich, die Steine funkeln und glitzern wie Sterne.");
  AddDetail(({"unebenheiten"}),
    "Die Unebenheiten im Kalkgestein wurden einfach mit Lehm aufgefuellt.");
  AddDetail(({"ursprung"}),
    "Weder Waende noch Decke weisen Spuren von menschlicher Bearbeitung "
    "auf.");
  AddDetail(({"waende"}),
    "Die Waende sind hier so weit auseinander, dass Du beide Arme "
    "ausstrecken kannst, ohne sie zu beruehren.");
  AddDetail ( ({"durchlaesse", "durchlass"}),
    "Noerdlich und suedlich befinden sich jeweils ein Durchlass. ");
  AddDetail ( ({"stein"}),
    "Damit ist der Stein gemeint, der den Eingang fast verdeckt.");
  AddDetail ( ({"felswaende"}),
    "Die Waende sind hier so weit auseinander, dass Du beide Arme "+
    "aussrecken kannst, ohne sie zu beruehren.");
  AddDetail ( ({"fels"}),
    "Die Waende bestehen aus Fels.");
  AddDetail ( ({"innere", "inneres"}),
    "Suedwestlich von Dir kannst Du weiter in die Klippe vordringen.");
  AddDetail ( ({"wand"}),
    "Zwei Durchlaesse befinden sich in der Wand.");
  AddDetail ( ({"gegrilltes"}),
    "Wenn Du Gegrilltes magst, solltest Du dem Geruch vielleicht nach "+
    "gehen.");
	
	
  AddSmell ( ({DEFAULT_SMELL}),
    "Der Geruch von Gegrilltem steigt Dir in die Nase.");
  AddSmell ( ({"geruch"}),
    "Es riecht wunderbar nach Essen. Dein Magen beginnt zu knurren.");
  AddSmell ( ({"essen"}),
    "Suedlich von Dir scheint jemand zu grillen. ");
  AddSmell ( ({"magen"}),
    "Bei dem Geruch faengt Dein Magen gleich zu knurren an.");
  AddSmell ( ({"nase"}),
    "Du atmest tief den Geruch ein. Lecker!");
  AddSmell ( ({"gegrilltes"}),
    "Hmm, lecker.");
  AddSound ( ({DEFAULT_SOUND}),
    "Aus dem Sueden hoerst Du halblautes Gegroehle. Sonst hoerst Du nur "+
    "das Hallen Deiner eigenen Schritte.");
  AddSound ( ({"gegroehle", "sueden"}),
    "Jemand versucht anscheinend zu singen - hoert sich grauenvoll an.");
  AddSound ( ({"hallen"}),
    "Jeder Schritt hallt laut. Sicher kann man Dich meilenweit hoeren.");
  AddSound ( ({"schritt", "schritte"}),
    "Das Hallen Deiner Schritte ist unueberhoerbar.");
  
  AddItem(NPC "schmuggler",REFRESH_DESTRUCT,"");


  AddExit("osten", "./mnpce4_2");
  AddExit("norden", "./mnpcladen");
  AddExit("suedwesten", "./mnpcc5_2");
  AddExit("sueden", "./s_kneipe");
}
