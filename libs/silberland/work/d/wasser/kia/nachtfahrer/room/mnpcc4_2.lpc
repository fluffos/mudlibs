// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

int falltuer_offen;
int truhe_verschoben;

void create()
{
  ::create();
  truhe_verschoben = 0;
  falltuer_offen = 0;
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]));
  SetProp(P_INT_SHORT, "In der Hoehle von Anheg");
  SetProp (P_INT_LONG,
    "Diese Hoehle ist groesser und prunkvoller als alle anderen, die Du "
    "bisher gesehen hast. Ein dicker, weinroter Teppich bedeckt den Boden "
    "und verleiht ihr eine Gemuetlichkeit, wie Du sie hier nicht fuer "
    "moeglich gehalten haettest. An der Nordwand steht ein breites Bett und daneben "
    "eine Art Kamin. Die Waende sind voll mit allerhand exotischem Krimskrams, und "
    "in einer Ecke steht eine grosse, schwere Truhe.\n");
    
  AddDetail ( ({"truhe"}),
    "Die Truhe passt nicht so recht zur restlichen Einrichtung. Sie sieht "+
    "aus als waere sie dort hingestellt worden, um etwas zu verbergen.");
  AddDetail ( ({"boden"}),
    "Der Boden ist eben. Wahrscheinlich wurde er, wie alle anderen Hoehlen "+
    "auch, mit Lehm eingeebnet. Ein roter Teppich verbreitet "+
    "Gemuetlichkeit.");
  AddDetail ( ({"hoehlen"}),
    "Die Klippe verbirgt viele Hoehlen. Von aussern sieht man davon "+
    "nichts.");
  AddDetail ( ({"klippe"}),
    "Du befindest Dich mehr oder weniger in ihr.");
  AddDetail ( ({"lehm"}),
    "Du siehst den Lehm nicht, da der Boden von einem Teppich bedeckt ist. "+
    "Aber mit irgendetwas musste er ja eingeebnet werden.");
  AddDetail ( ({"teppich"}),
    "Der Teppich ist einfaerbig rot. Nicht der kleinste Fussel ist auf ihm "+
    "zu sehen.");
  AddDetail ( ({"fussel"}),
    "Hier wird auf Sauberkeit geachtet!");
  AddDetail ( ({"sauberkeit"}),
    "Wenn es hier nicht so sauber waere, koenntest Du Dich glatt "+
    "wohlfuehlen.");
  AddDetail ( ({"gemuetlichkeit"}),
    "So ein Teppich ist schon gemuetlicher als blanker Fels.");
  AddDetail ( ({"fels"}),
    "Du bist von Fels umgeben.");
  AddDetail ( ({"kamin"}),
    "Der Kamin ist eigentlich nur ein Haufen Steine und ein Loch in der "+
    "Decke, aber er erfuellt sicher seinen Zweck.");
  AddDetail ( ({"haufen"}),
    "Die Steine sind kreisfoermig angeordnet.");
  AddDetail ( ({"steine"}),
    "Damit sich das Feuer nicht ausbreiten kann, wenn eingeheizt ist, "+
    "wurden Steine aufgelegt.");
  AddDetail ( ({"feuer"}),
    "Dort wo normalerweise das Feuer sein sollte, sind nur ein flacher "+
    "Stein und ein paar verkohlte Holzstuecke.");
  AddDetail ( ({"stein"}),
    "Ja was haettest Du denn geglaubt? Dass man das Feuer am Teppich "+
    "anzuendet?");
  AddDetail ( ({"holzstuecke", "stuecke"}),
    "Die Holzstuecke beweisen, dass hier tatsaechlich mal ein Feuer "+
    "gebrannt hat. Momentan ist aber nicht eingeheizt.");
  AddDetail ( ({"zweck"}),
    "Der Kamin hat den Zweck, dass man einheizen kann, wenn es kalt ist.");
  AddDetail ( ({"himmel"}),
    "Grau und trostlos und hoechst unspektakulaer. Du wendest Dich "+
    "gelangweilt ab.");
  AddDetail ( ({"hoehle"}),
    "Diese Hoehle gehoert Anheg, dem Anfuehrer der Nachtfahrer.");
  AddDetail ( ({"decke"}),
    "Die Decke besteht aus Felsgestein. Sie hat ein Loch, das sich genau "+
    "ueber dem Kamin befindet.");
  AddDetail ( ({"loch"}),
    "Das Loch dient als Abzug. Du kannst dafurch den Himmel sehen.");
  AddDetail ( ({"abzug"}),
    "Jeder Kamin braucht einen Abzug.");
  AddDetail ( ({"anheg"}),
    "Wenn Anheg hier ist, kannst Du ihn auch sehen.");
  AddDetail ( ({"anfuehrer"}),
    "Anheg ist der maechtigste aller Nachtfahrer.");
  AddDetail ( ({"nachtfahrer"}),
    "Davon soll es auf dieser Insel einige geben.");
  AddDetail ( ({"insel"}),
    "Na welche Insel wohl, hmm?");
  AddDetail ( ({"felsgestein", "gestein"}),
    "Die Decke und die Waende bestehen aus Felsgestein. Eigentlich besteht "+
    "die ganze Klippe daraus.");
  AddDetail ( ({"bett"}),
    "Das Bett ist breit und wuerde gemuetlich aussehen, wenn das Laken "+
    "nicht so peinlich genau gespannt waere.");
  AddDetail ( ({"laken"}),
    "Irgendwer hat da einen ziemlichen Ordnungsfimmel! Du siehst keine "+
    "einzige Falte.");
  AddDetail ( ({"fimmel", "ordnungsfimmel"}),
    "Naja, jeder hat so seine Fimmel :)");
  AddDetail ( ({"falte"}),
    "Nicht mal die kleinste Falte.");
  AddDetail ( ({"waende"}),
    "Die Waende sind voller Krimskrams aus fernen Laendern. ");
  AddDetail ( ({"laender"}),
    "Aus allen Teilen des Silberlandes sind Sachen dabei.");
  AddDetail ( ({"teile"}),
    "Anheg ist weit herumgekommen.");
  AddDetail ( ({"krimskrams", "sachen"}),
    "Allerhand kunterbunt gemischte Sachen, darunter unter anderem ein "+
    "Paar Schneeschuhe und ein Leopardenfell.");
  AddDetail ( ({"paar"}),
    "Also zwei davon.");
  AddDetail ( ({"schneeschuhe", "schuhe"}),
    "Die Schneeschuhe stammen aus Polar und sehen primitiv aus. ");
  AddDetail ( ({"polar"}),
    "In Polar braucht man stellenweise solche Schneeschuhe, um nicht zu "+
    "versinken.");
  AddDetail ( ({"fell", "leopardenfell"}),
    "Das Leopardenfell hat ein braunes Augenmuster und sieht schon sehr "+
    "alt aus. Trotzdem erkennt man, dass es von einem schoenen und grossen "+
    "Tier stammt.");
  AddDetail ( ({"augenmuster", "muster"}),
    "Das Augenmuster dient zur Tarnung.");
  AddDetail ( ({"tarnung"}),
    "Hier wuerde Dir das allerdings nicht viel helfen, also vergiss das "+
    "mal lieber.");
  AddDetail ( ({"tier"}),
    "Ein grosses und schoenes Tier war das einmal.");
  AddDetail ( ({"silberland"}),
    "Diese Insel ist nur ein kleiner Teil des viel groesseren "+
    "Silberlandes.");
  AddDetail ( ({"teil"}),
    "Genaugenommen bist Du auch Teil des Silberlandes.");
  AddDetail ( ({"einrichtung"}),
    "Die Einrichtung besteht aus einem Bett und einem Kamin.");
  AddDetail ( ({"art"}),
    "Der Kamin ist ein bisschen provisorisch, aber dennoch als Kamin zu "+
    "erkennen.");
  AddDetail ( ({"ecke"}),
    "In einer Ecke faellt Dir eine Truhe auf.");
  AddDetail ( ({"nordwand"}),
    "An der Nordwand steht ein grosses, sauber gemachtes Bett.");
  AddDetail ( ({"ostwand", "suedwand", "westwand"}),
    "Jede der anderen Waende ist mit Krimskrams vollgehaengt.");
  AddDetail ( ({"schand"}),
    "Na, schlechtes Gewissen?");
  AddDetail ( ({"gewissen"}),
    "Du beschliesst spontan, lieber an etwas anderes zu denken.");
  AddSpecialDetail(({"falltuer"}),
    "detail_falltuer");
	
	
  AddSound ( ({DEFAULT_SOUND}),
    "Hier ist es ruhig, Du hoerst eigentlich gar nix. Die Waende sind wohl "
    "ziemlich dick.");
  AddSound ( ({"waende", "wand", "lauscher"}),
    "Der Lauscher an der Wand hoert seine eigene Schand :)");
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht nach fernen Laendern und seltsamen Dingen.");
  AddSmell ( ({"laender"}),
    "Es riecht einfach nach Dingen, die Du noch nicht kennst.");
  AddSmell ( ({"dinge"}),
    "Mit welchen Substanzen hier wohl geschmuggelt wird?");
  AddSmell ( ({"substanzen"}),
    "Du weisst es nicht. Schliesslich bist Du ja kein Schmuggler. "
    "Aber dennoch riecht es hier fremdartig.");

  AddItem(NPC "anheg",REFRESH_DESTRUCT,"");
  
  AddExit("sueden", "./mnpcc5_2");
  
  AddCmd(({"verschiebe","verschieb"}), "cmd_verschiebe");
  AddCmd(({"oeffne"}), "cmd_oeffne");
  AddCmd(({"schiebe","schieb"}),"cmd_schiebe");
  
}

void reset()
{
	::reset();
	truhe_verschoben = 0;
	falltuer_offen = 0;
	RemoveExit("unten");
}

int cmd_verschiebe ( string str )
{
  notify_fail("Was willst Du verschieben?\n");

  if(str=="truhe")
  {	
    if (truhe_verschoben == 0)
    {
      write(BS("Du schiebst die Truhe weg. Darunter kommt eine Falltuer "
            "zum Vorschein.\n"));
      say(BS(TP->Name(WER,2)+ " schiebt eine Truhe weg. Darunter kommt "
            "eine Falltuer zum Vorschein. \n"));
      truhe_verschoben = 1;
	  
	  AddDetail ( ({"truhe"}),
	  "Die Truhe ist verschoben. Darunter siehst Du eine Falltuer.");
      return 1;
    }
    else
    {
      write(BS("Irgendjemand hat die Truhe schon verschoben. Dort, wo sie "
            "vorher gestanden ist, befindet sich eine Falltuer. \n"));
      return 1;
    }
  }
  return 0;
}

int cmd_schiebe ( string str )
{
  notify_fail("Was willst Du wegschieben?\n");

  if((str=="truhe weg")||(str=="truhe beiseite")||(str=="truhe zur seite"))
  {	
    if (truhe_verschoben == 0)
    {
      write(BS("Du schiebst die Truhe weg. Darunter kommt eine Falltuer "
            "zum Vorschein.\n"));
      say(BS(TP->Name(WER,2)+ " schiebt eine Truhe weg. Darunter kommt "
            "eine Falltuer zum Vorschein. \n"));
      truhe_verschoben = 1;
	  
	  AddDetail ( ({"truhe"}),
	  "Die Truhe ist verschoben. Darunter siehst Du eine Falltuer.");
      return 1;
    }
    else
    {
      write(BS("Irgendjemand hat die Truhe schon verschoben. Dort, wo sie "
            "vorher gestanden ist, befindet sich eine Falltuer. \n"));
      return 1;
    }
  }
  return 0;
}
 
int cmd_oeffne ( string str )
{
  notify_fail("Was willst Du oeffnen?\n");

  if(str=="falltuer")
  {
    write(BS("Du ruettelst an der Falltuer, kriegst sie aber nicht auf. "
          "Da entdeckst Du ein kleines Schluesselloch. Man braucht "
          "wohl einen Schluessel, um sie zu oeffnen.\n"));
    say(BS(TP->Name(WER)+" versucht vergeblich, eine Falltuer zu oeffnen.\n"));
    return 1;
  }

  if(str=="falltuer mit schluessel")
  {
    if (truhe_verschoben == 1)
    {
      if (falltuer_offen == 0)
      {
        if (!(present("\n_kiaschluessel",TP) == 0))
        {
          write(BS("Du oeffnest eine Falltuer. Unter Dir ist nur gaehnende "
                "Schwaerze.\n"));
          say(TP->Name(WER)+" oeffnet eine Falltuer.\n");
          falltuer_offen = 1;
          AddGuardedExit("unten","./lager","anheg","@@anheg_angriff@@");
          return 1;
        }
        else
        {
          write(BS("Du hast keinen passenden Schluessel dabei.\n"));
          return 1;
        }
      }
      else
      {
        write("Die Falltuer ist bereits offen.\n");
        return 1;
      }
    }
    else
    {
      write(BS("So geht das aber nicht. Zuerst musst Du die Falltuer "
            "schon entdecken. \n"));
      return 1;
    }
  }
  return 0;
}	

string anheg_angriff()
{
  present("anheg", TO)->Kill(TP);
  return "Anheg sagt ruhig: So nicht, Freundchen!\n";
}

string detail_falltuer ( string str )
{
  if( truhe_verschoben == 1)	
  {
    write( "Eine steinerne Falltuer, die unter der Truhe versteckt war.\n" );
    return "";
  }
  else
  {
    write(BS("Du suchst wohl eine Falltuer? Tja, hier siehst Du keine. Wenn Du Dich "
          "genauer umsiehst, findest Du vielleicht eine.\n"));
    return "";
  }
}

   	
	
