inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_WATER]));
  SetProp(P_INT_SHORT,
    "Am Gipfel der Schmugglerinsel.");
  SetProp(P_INT_LONG,
    "Du befindest Dich auf dem hoechsten Punkt der Insel. Hier oben bist Du "
    "dem Wind hoffnungslos ausgeliefert. Er zerrt an Deinen Haaren und weht "
    "Dich fast von der Klippe. Trotz der Daemmerung geniesst Du die "
    "wunderschoene Aussicht ueber das Meer. Es ist, als wuerde die Zeit "
    "stillstehen.");
    
  AddDetail(({"aufstieg"}),
    "Ja, der Aufstieg war nicht gerade leicht, aber er hat sich gelohnt.");
  AddDetail(({"augen"}),
    "Du versuchst halbherzig, Dir Deine Augen auszuwischen, laesst es aber "
    "bald bleiben. Du musst Dich viel zu sehr darauf konzentrieren, nicht "
    "von der Klippe zu fallen.");
  AddDetail(({"boden"}),
    "Der Boden unter Deinen Fuessen ist feucht und glitschig. Pass nur auf "
    "dass Du nicht ausrutscht und ins Meer faellst, hier geht es weit "
    "runter!");
  AddDetail(({"daemmerung"}),
    "Auf dieser Insel herrscht Daemmerung. Ob sie schon jemals wer bei "
    "Tageslicht gesehen hat?");
  AddDetail(({"felsbrocken","brocken"}),
    "Ein paar Felsbrocken haben sich von der Klippe geloest und liegen nun "
    "locker am Boden herum. Du kannst sie ja ins Wasser werfen, und Dir "
    "ausrechnen wie hoch oben du bist.");
  AddDetail(({"fuesse","halt"}),
    "Deine Fuesse finden auf dem glitschigen Boden nur schlecht Halt. Ein "
    "paar lockere Felsbrocken erleichtern das nicht gerade.");
  AddDetail(({"gewitter"}),
    "Ein Gewitter waere hier oben sicher sehr unangenehm. Aber weiter unten "
    "kann man sicher irgendwo Schutz suchen." );
  AddDetail(({"gesicht"}),
    "Der Wind kuehlt Dein heisses Gesicht.");
  AddDetail(({"gischt"}),
    "Die Gischt wird bis hier raufgeweht, darum ist die Klippe so feucht "
    "und glitschig. Ein paar kleine Wassertroepfchen brennen in Deinen "
    "Augen.");
  AddDetail(({"haare","nase","haar"}),
    "Der Wind weht Dir Deine Haare ins Gesicht, sodass sie Dich in der Nase "
    "kitzeln. *hatschi*");
  AddDetail(({"himmel"}),
    "Hoch ueber Dir tuermen sich dunkle Wolken auf, sodass Du den "
    "eigentlichen Himmel nicht sehen kannst. Durch eine Luecke in den "
    "Wolken scheint der Mond.");
  AddDetail(({"insel"}),
    "Damit ist die Insel gemeint, auf der Du Dich gerade befindest. "
    "Irgendwie klar, oder?");
  AddDetail(({"klippe"}),
    "Die Klippe, auf der Du stehst, scheint direkt in den Himmel zu ragen. "
    "Sie ist feucht und glitschig, da die Luft voller kleinster "
    "Wassertroepfchen ist. Ein paar kleine Felsbrocken haben sich von "
    "der Klippe geloest und liegen jetzt am Boden.");
  AddDetail(({"licht"}),
    "Bei diesen Licht sieht alles anders aus.");
  AddDetail(({"lichter","ansammlung"}),
    "Die Ansammlung von Lichtern im Nordosten koennte tatsaechlich Midas "
    "sein.");
  AddDetail(({"luft"}),
    "Die Luft ist feucht und salzig hier oben und irgendwie "
    "spannungsgeladen.");
  AddDetail(({"meer"}),
    "Weit unter Dir ist das Meer, das bei diesem Licht fast schwarz "
    "aussieht. Der Wind wuehlt es so richtig auf, und die Gischt kann man "
    "selbst hier oben noch fuehlen.");
  AddDetail(({"midas","stadt"}),
    "Midas ist eine grosse Stadt, darum ist es dort auch nie richtig "
    "dunkel.");
  AddDetail(({"mond","luecke"}),
    "Durch eine Luecke zwischen den Wolken siehst Du den Mond. Er sieht aus "
    "wie ein bleicher Totenkopf.");
  AddDetail(({"punkt","gipfel"}),
    "Der Gipfel der Klippe ist der hoechste Punkt der Insel.");
  AddDetail(({"schutz"}),
    "Hoffentlich wird das nicht noetig sein!");
  AddDetail(({"spannung","strom"}),
    "Eine Spannung wie vor einem Gewitter.");
  AddDetail(({"strand"}),
    "Der Strand, den Du vorher entlanggegangen bist, sieht von hier oben "
    "laecherlich klein aus.");
  AddDetail(({"tageslicht"}),
    "Gibt es hier sowas wie Tageslicht? Vielleicht herrscht auf dieser "
    "Insel auch ewige Daemmerung.");
  AddDetail(({"totenkopf"}),
    "Der Mond scheint Dich haemisch anzugrinsen. Du grinst zurueck.");
  AddDetail(({"wassertroepfchen","salzwasser","wasser"}),
    "Jaja, Salzwasser brennt in den Augen.");
  AddDetail(({"wellen"}),
    "Der Wind peitscht das Meer zu hohen Wellen auf, sodass die Gischt bis "
    "hier oben spritzt.");
  AddDetail(({"wind"}),
    "Der Wind zerzaust Dein Haar hoffnungslos und weht Dich fast von der "
    "Klippe.");
  AddDetail(({"wolken"}),
    "Hohe, spitze Wolken tuermen sich auf. Die Luft scheint unter Strom zu "
    "stehen." );
  AddDetail(({"zeit"}),
    "Du weisst gar nicht, wie lange Du schon hier oben bist.");
  AddDetail(({"fischerdorf","dorf"}),
    "Das ist weit, weit weg.");
    
  AddSound(DEFAULT_SOUND,
    "Du hoerst nichts ausser dem Wind, jedes andere Geraeusch wuerde auch "
    "untergehen bei dem Laerm.");
  AddSound(({"laerm"}),
    "Hier oben heult Der Wind so laut, dass man es durchaus schon als Laerm "
    "bezeichnen kann.");
  AddSound(({"liedchen"}),
    "Kein sehr melodioeses zwar, aber immerhin.");
  AddSound(({"wind"}),
    "Der Wind braust Dir um die Ohren und singt sein Liedchen. Du hast "
    "ploetzlich Lust, mitzusingen.");
 
  AddSmell(DEFAULT_SMELL,
    "Du atmest einmal tief ein. Die Luft riecht frisch und ein bisschen "
    "nach Salzwasser.");
  AddSmell(({"nase"}),
    "An Deiner eigenen Nase kannst Du nicht riechen." );
  AddSmell(({"salzwasser","wasser","geruch"}),
    "Kleine Wassertroepfchen steigen Dir in die Nase und verursachen diesen "
    "Geruch.");
  AddSound ( ({"lust"}),
    "Wenn Du Lust hast zu singen dann mach doch einfach :)");
  AddSound ( ({"ohren"}),
    "Mit Deinen Ohren hoerst Du nur den Wind.");
  AddSound ( ({"geraeusch"}),
    "Das Heulen des Windes ist das einzige Geraeusch, das Du hoerst.");
  AddSound ( ({"heulen"}),
    "Das Heulen des Windes klingt fuer Dich wie ein Liedchen.");
  AddSpecialDetail(({"aussicht"}),"detail_aussicht");
  // DETAILS END
  
  AddExit("nordunten", "./b4_3");
  
  AddCmd(({"wirf"}), "wirffunktion");
}

int wirffunktion (string str)


{
   notify_fail("Was willst Du wohin werfen? \n");

   if((str=="brocken ins wasser") || (str=="brocken in wasser") || (str=="felsbrocken in wasser")
                                  || (str=="felsbrocken ins wasser"))
   { 
       write(BS("Du wirfst einen Felsbrocken ins Wasser und zaehlst die Sekunden "
             "bis er ins Meer patscht. Eins, zwei, drei, vier... \n"
             "*PLATSCH* \n"
             "Sei froh, dass es nur der Felsbrocken war, und nicht Du. \n"
       ));
       say( this_player()->Name(WER,2)+ " wirft einen Felsbrocken ins Wasser. \n"
       );
       return 1;
   }
   return 0;
} 

string detail_aussicht ( string str )
{
   
  if (present("\n_kompass",TP) == 0) 
  {
	   clone_object(OBJ "kompass")->move(TP);
  }
  return BS("Eine herrlicher Aussicht, die Dich fuer dem harten Aufstieg mehr als "
    "entschaedigt! Weit unter Dir siehst Du das wilde Meer und den Strand, "
    "den Du vorher entlanggegangen bist. Im Nordosten glaubst Du die "
    "Lichter von Midas zu erkennen. Jetzt wirst Du es schaffen zurueck ins Fischerdorf zu rudern ohne Dich zu verfahren!");	
}

