// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_WATER]));
  SetProp(P_INT_SHORT,
    "Am Felshang");
  SetProp(P_INT_LONG,
    "Auf einem schmalen Felsvorsprung machst Du eine kurze Rast. Der Gipfel befindet "
    "sich unweit ueber Dir. Hier ist die Klippe weniger steil, sodass Du ihn "
    "sogar ohne zu klettern erreichen kannst. Weiter unter Dir siehst Du den "
    "Sandstrand, den Du vorher entlanggegangen bist, und das Meer, das wie eine"
    "brodelnde Masse ausssieht. Du bist jedoch zu sehr damit beschaeftigt, Dich "
    "vom Wind nicht hinunterwehen zu lassen, als die Aussicht richtig geniessen "
    "zu koennen. ");
  AddDetail ( ({"boden"}),
    "Du stehst auf einem schmalen Vorsprung im Fels, der gerade breit "+
    "genug ist um kurz stehenzubleiben und zu verschnaufen. Einige Spalten "+
    "verschaffen Dir genug Halt.");
  AddDetail ( ({"spalten"}),
    "Der Boden ist voller Spalten, mit denen Du gerade soviel Halt "+
    "findest, um nicht abzurutschen.");
  AddDetail ( ({"halt"}),
    "Gerade soviel Halt, dass Du nicht nach unten wegrutscht. ");
  AddDetail ( ({"felsvorsprung", "vorsprung"}),
    "Ein Vorsprung im Fels, aehnlich wie ein Fensterbrett. Der ideale "+
    "Platz, um kurz zu verschnaufen.");
  AddDetail ( ({"fensterbrett"}),
    "Der Felsvorsprung ist in etwa so breit wie ein Fensterbrett und auch "+
    "aehnlich geformt.");
  AddDetail ( ({"platz"}),
    "Viel Platz hast Du hier ja nicht gerade, aber es reicht.");
  AddDetail ( ({"himmel"}),
    "Obwohl Du dem Himmel hier naeher bist als weiter unten, sieht er "+
    "genauso unendlich fern aus wie sonst auch. Dunkle Wolken ziehen an Dir "+
    "verueber.");
  AddDetail ( ({"wolken"}),
    "Die Wolken werden vom Wind weitergeweht, aber es kommen immer neue "+
    "nach, sodass sie nicht weniger werden. Alles in allem nicht gerade ein "+
    "Wetter zum Baden gehen.");
  AddDetail ( ({"wind"}),
    "Der Wind weht so stark, dass Du fast den Halt verlierst.");
  AddDetail ( ({"wetter"}),
    "Es sieht nach Sturm aus.");
  AddDetail ( ({"sturm"}),
    "Noch wuerdest Du den Wind nicht als Sturm bezeichnen, hoffentlich "+
    "bleibt das auch so.");
  AddDetail ( ({"baden"}),
    "Du willst nicht baden gehen? Dann solltest Du moeglichst nicht ins "+
    "Meer fallen.");
  AddDetail ( ({"aussicht"}),
    "Wenn Du Dich hier genauer umsehen wuerdest, haettest Du hier sicher "+
    "eine schoene Aussicht. Du bist jedoch viel zu sehr damit beschaeftigt, "+
    "nicht von der Klippe zu fallen und kannst sie daher gar nicht so "+
    "richtig geniessen. ");
  AddDetail ( ({"sandstrand", "strand"}),
    "Der Sandstrand, den Du vorher entlanggegangen bist, kommt Dir von "+
    "hier aus verschwindend klein vor.");
  AddDetail ( ({"meer"}),
    "Das Meer brodelt wie kochendes Wasser. Der Wind peitscht es zu "+
    "meterhohen Wellen auf, Dir kommt es so vor als wuerdest Du ab und zu "+
    "einen kleinen Salzwassertropfen auf Deiner Wange spueren.");
  AddDetail ( ({"wange"}),
    "Du tastest Deine Wange ab. Sie ist trocken. Dennoch, Du bist Dir "+
    "sicher einige kleine Wassertropfen gespuert zu haben.");
  AddDetail ( ({"salzwassertropfen", "tropfen", "wassertropfen"}),
    "Ist es moeglich dass die Wassertropfen bis hier hochspritzen?");
  AddDetail ( ({"masse"}),
    "Das Meer siehst Du wegen dem spaerlichen Licht nur als dunkle Masse. "+
    "Schade, sicherlich koennte man sonst bis zum Meeresgrund runtersehen.");
  AddDetail ( ({"wellen"}),
    "Der Wind peitscht die Wellen auf, die kraeuselnd auseinanderrollen "+
    "und schliesslich am Strand brechen.");
  AddDetail ( ({"wasser"}),
    "Du weisst natuerlich, dass das Meer aus Wasser besteht. Trotzdem "+
    "sieht es bei diesem Licht aus wie eine zaehe, dunkle Masse.");
  AddDetail ( ({"fels"}),
    "Die Klippe besteht aus felsigem, kalkhaltigen Gestein.");
  AddDetail ( ({"gestein"}),
    "Du tastest das Gestein ab, kommst aber nicht drauf was fuer eins es "+
    "ist. Aber Du hast aehnliches Gestein schon oft gesehen, es ist also "+
    "nichts besonders.");
  AddDetail ( ({"meeresgrund"}),
    "Den Meeresgrund siehst Du nicht, dazu ist es viel zu dunkel.");
  AddDetail ( ({"rast"}),
    "Du lehnst Dich gegen die Klippe und atmest tief durch. ");
  AddDetail ( ({"licht"}),
    "Es ist daemmrig, daher siehst Du nicht besonders gut.");
  AddDetail ( ({"gipfel"}),
    "Ein Stueckchen weiter oben befindet sich der Gipfel der Klippe, der "+
    "gleichzeitig auch der hoechste Punkt der Insel ist. ");
  AddDetail ( ({"stueckchen"}),
    "Nur Mut, es ist wirklich nicht mehr weit!");
  AddDetail ( ({"mut"}),
    "Du hast schon ganz andere Abenteuer bestanden und laesst Dich nicht "+
    "so leicht entmutigen.");
  AddDetail ( ({"abenteuer"}),
    "Obwohl es auch ein Abenteuer ist, auf einer so hohen Klippe "+
    "herumzuklettern...");
  AddDetail ( ({"klippe", "klippen"}),
    "Die ganze Insel besteht, soweit Du es beurteilen kannst, aus Klippen "+
    "und Strand. Irgendwie trostlos.");
  AddDetail ( ({"insel"}),
    "Rund im Dich herum ist nur Meer. Du schliesst daraus, dass Du Dich "+
    "auf einer Insel befindest.");
  AddDetail ( ({"punkt"}),
    "Du fixierst einen Punkt auf der Klippe, damit Dir nicht schwindelig "+
    "wird.");
  AddSound ( ({DEFAULT_SOUND}),
    "Duer hoerst ausser dem Wind noch das Kreischen einiger Moewen.");
  AddSound ( ({"kreischen"}),
    "Einen Laerm machen die vielleicht!");
  AddSound ( ({"laerm"}),
    "Du laesst Dich von dem Laerm, den die Moewen machen, nicht weiter "+
    "stoeren.");
  AddSound ( ({"moewen"}),
    "Seltsam, Du siehst hier weit und breit keine Moewen, Du hoerst sie "+
    "nur kreischen.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du atmest tief die frische Luft ein. Koestlich!");
  AddSmell ( ({"luft"}),
    "Die Luft riecht so richtig unverbraucht und frisch.");
  
  AddExit("suedoben", "./s_gipfel");
  AddCmd(({"kletter", "klettere"}), "cmd_kletter");
}

int cmd_kletter (string str)


{
   notify_fail("Wohin willst Du klettern? \n");

   if(str=="runter" || str=="nach unten")
   { 
   		TP->move(ROOM "b3_1",M_GO,"die Klippe hinab","klettert",
		     "kommt von oben heruntergeklettert");
       return 1;
   }
   if( (str=="mit seil runter") || (str=="mit seil hinunter") )
   { 
	   if( present( "seil", TP ) )
	   {   TP->move(ROOM "b3_1",M_GO,"die Klippe hinauf","klettert",
		     "kommt von oben hinabgeklettert");
           return 1;
       }
	   else
	   {
	       write(BS("Aber Du hast ja gar kein Seil!"));
	       return 1;
	   }
   }
   return 0;
}
