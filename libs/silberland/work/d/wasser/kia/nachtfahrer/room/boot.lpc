#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE:13, ENV_TERRAIN: TT_WATER]));
  SetProp (P_INT_SHORT, "In einem Ruderboot");
  SetProp (P_INT_LONG, "Ein kleines, hoelzernes Ruderboot.");
}