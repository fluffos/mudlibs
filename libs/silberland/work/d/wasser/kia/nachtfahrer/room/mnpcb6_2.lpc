// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"


void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem");
  SetProp (P_INT_LONG,
    "Dieser Gang fuehrt mitten ins Innere der Klippe. Die schoenen, "+
    "natuerlichen Felswaende sind hier weit genug auseinander, dass Du "+
    "Dich bequem fortbewegen kannst. Die Decke ist sehr hoch oben, nur "+
    "ein kleines Funkeln ab und zu verraet, dass sie ueber Dir ist. Im "+
    "Suedosten befindet sich ein Ausgang, der halb hinter einem grossen "+
    "Felsbrocken versteckt ist.");

  AddDetail ( ({"boden"}),
    "Der Boden ist, wie die Waende, aus Kalkgestein. Die meisten "+
    "Unebenheiten wurden mit Lehm ausgefuellt, sodass Du trotz des "+
    "spaerlichen Lichts ohne zu stolpern vorwaerts kommst.");
  AddDetail ( ({"gestein", "kalkgestein"}),
    "Kalkgestein ist normalerweise nicht eben, aber beim Boden wurde mit "+
    "Lehm ein bisschen nachgeholfen.");
  AddDetail ( ({"lehm"}),
    "Lehm ist billiges Baumaterial, und haelt noch dazu einiges aus.");
  AddDetail ( ({"baumaterial", "material"}),
    "Mit Kennerblick musterst Du das Baumaterial und stellst fest, dass es "+
    "schon aelter ist, denn der Lehm ist mit einigen Rissen durchzogen.");
  AddDetail ( ({"kennerblick"}),
    "Jaja, Du kennst Dich einfach aus.");
  AddDetail ( ({"risse"}),
    "Einige Risse durchziehen den Lehm, was bei diesem Licht aber fast "+
    "nicht auffaellt.");
  AddDetail ( ({"decke"}),
    "Die Decke siehst Du gar nicht. Nur ab und zu funkelt es ueber Dir, "+
    "was Dir zeigt dass sie doch da ist.");
  AddDetail ( ({"funkeln"}),
    "Ab und zu funkelt es ueber Dir, wenn die Decke den Schein der Fackeln "+
    "reflektiert.");
  AddDetail ( ({"schein"}),
    "Im Schein der Fackeln hat dieser Gang etwas Unwirkliches.");
  AddDetail ( ({"felswaende", "waende"}),
    "Die Waende sind aus Kalkgestein und werden nach oben hin deutlich "+
    "schmaeler. Zwar hast Du genuegend Platz um nicht anzuecken, aber "+
    "trotzdem fuehlst Du Dich eingeengt.");
  AddDetail ( ({"platz"}),
    "Du wirst doch nicht etwa Platzangst kriegen?");
  AddDetail ( ({"platzangst"}),
    "Du fuehlst Dich einfach ein bisschen eingeengt, das ist alles. Dir "+
    "ist so, als wuerden die Waende immer naeher ruecken.");
  AddDetail ( ({"unwirkliches"}),
    "Du kneifst Dich. Nein, Du traeumst nicht!");
  AddDetail ( ({"licht"}),
    "Das wenige Licht geht von den Fackeln aus, die mit Fackelhaltern an "+
    "der Wand befestigt sind.");
  AddDetail ( ({"fackelhalter"}),
    "Normale metallene Fackelhalter, in denen brennende Fackeln stecken.");
  AddDetail ( ({"metall"}),
    "Du erkennst an dem Rost, der sich gebildet hat, dass es sich um "+
    "Metall handelt.");
  AddDetail ( ({"rost"}),
    "Die Fackelhalter sehen sehr alt aus. Sie sind schon ziemlich "+
    "verrostet.");
  AddDetail ( ({"fackeln"}),
    "Die Fackeln brennen vor sich hin und erhellen Deine Umgebung.");
  AddDetail ( ({"umgebung"}),
    "Du bist in einem Gang im Inneren der Klippe gelandet und umgeben von "+
    "Kalkgestein.");
  AddDetail ( ({"ausgang"}),
    "Der Ausgang wurde geschickt angelegt, sodass er halb von einem "+
    "grossen Felsbrocken verdeckt ist. Von aussen kann man ihn sicher nur "+
    "sehen, wenn man direkt davor steht.");
  AddDetail ( ({"felsbrocken"}),
    "Ein Felsbrocken wurde so platziert, dass er den Ausgang halb "+
    "verdeckt. Ob das Absicht war?");
  AddDetail ( ({"absicht"}),
    "Warum die Bewohner der Insel wohl soviel dafuer tun, um unentdeckt zu "+
    "bleiben?");
  AddDetail ( ({"bewohner"}),
    "Irgendjemand muss die Fackeln ja angezuendet haben.");
  AddDetail ( ({"insel"}),
    "Eine kleine Insel abseits der Schiffsrouten. Du befindest Dich auf "+
    "oder besser gesagt in ihr.");
  AddDetail ( ({"schiffsrouten"}),
    "Hast Du schon ein Schiff vorbeifahren sehen?");
  AddDetail ( ({"gipfel", "schiff"}),
    "Von hier aus wirst Du sowieso nie ein Schiff vorbeifahren sehen. Da "+
    "musst Du schon am Gipfel danach Ausschau halten.");
  AddDetail ( ({"ausschau"}),
    "So sehr Du hier auch Ausschau haeltst, Du kannst keine Schiffsrouten "+
    "entdecken.");
  AddDetail ( ({"unebenheiten"}),
    "Das Kalkgestein weist Erhebungen und Vertiefungen auf, ueber die Du "+
    "sicherlich stolpern wuerdest, wenn der Boden nicht ausgebessert worden "+
    "waere.");
  AddDetail ( ({"erhebungen", "vertiefungen"}),
    "Waere der Boden uneben dann wuerdest Du dauernd stolpern, denn das "+
    "Licht ist spaerlich.");
  AddDetail ( ({"klippe","klippen"}),
    "Die ganze Insel scheint nur aus Klippen und einem schmalen "+
    "Sandstreifen zu bestehen. Wie trostlos.");
  AddDetail ( ({"sandstreifen", "streifen"}),
    "Dort, wo Du angelegt hast, war ein schmaler Sandstreifen. Der Rest "+
    "der Insel ist von grossen, hohen Klippen beherrscht.");
  AddDetail ( ({"rest"}),
    "Alles was uebrig bleibt.");
  AddDetail ( ({"gang"}),
    "Der Gang windet sich durch die Klippe, kleinere und groessere Hoehlen "+
    "zweigen von ihm ab. Hier ist er so hoch, dass Du die Decke nicht sehen "+
    "kannst, aber im Nordosten wird er etwas niedriger, dafuer aber "+
    "breiter.");
  AddDetail ( ({"nordosten"}),
    "Du kannst wegen dem mangelnden Licht nicht weit nach Nordosten sehen, "+
    "aber dort scheint der Gang niedriger und breiter zu werden.");
  AddDetail ( ({"inneres","innere"}),
    "Du bist mitten in der Klippe drin.");
  AddDetail ( ({"wand"}),
    "Die Waende sind aus Kalkgestein und werden nach oben hin deutlich "+
    "schmaeler. Zwar hast Du genuegend Platz um nicht anzuecken, aber "+
    "trotzdem fuehlst Du Dich eingeengt.");
  AddDetail ( ({"suedosten"}),
    "Dort gehts raus.");
  AddDetail ( ({"hoehle","hoehlen"}),
    "Von dem Gang aus biegen mehrere Hoehlen ab. Von hier aus kannst Du aber "
	"nur dem Gang folgen.");
	
	
  AddSmell ( ({DEFAULT_SMELL}),
    "Du riechst ganz deutlich die frische Luft, die durch den Eingang "+
    "hereinweht.");
  AddSmell ( ({"eingang"}),
    "Durch den Eingang dringt frische, unverbrauchte Luft herein.");
  AddSmell ( ({"luft"}),
    "Du atmest tief durch. Herrlich!");
  AddSound ( ({DEFAULT_SOUND}),
    "Du lauscht dem Heulen des Windes, der draussen ungebremst um die "+
    "Felsen streift. Sonst hoerst Du nur das Echo Deiner eigenen Schritte.");
  AddSound ( ({"heulen"}),
    "Das Heulen ist so laut, dass Du es sogar hier drinnen noch hoeren "+
    "kannst.");
  AddSound ( ({"wind"}),
    "Der Wind streift im die Felsen und verurscht dabei ein lautes Heulen.");
  AddSound ( ({"felsen"}),
    "Nicht einmal die Felsen bremsen den Wind.");
  AddSound ( ({"echo"}),
    "Deine Schritte hallen zwischen den Waenden wider, sodass man Dich "+
    "sicher meilenweit hoeren kann.");
  AddSound ( ({"waende"}),
    "Die Waende sind sehr nahe beieinander und verursachen darum ein "+
    "lautes Echo. Du versuchst zwar besonders leise zu sein, aber lautlos "+
    "fortbewegen kannst Du Dich einfach nicht.");
  AddSound ( ({"schritte"}),
    "Egal wie leise Du Deine Schritte setzt, man hoert sie sicher "+
    "meilenweit.");
 
  AddItem(NPC "schmuggler",REFRESH_DESTRUCT,"");

  AddExit ("nordosten", "./mnpcc5_2");
  AddExit ("suedosten", "./mnpcc7_2");
  
}
