// By Kia@Silberland 5.2003

inherit "std/pub";
#include "/sys/pub.h"

#include "../def.h"

void create()
{
  ::create();
  
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]));
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "knilda");
  SetProp(P_PUBKEEPER_NAME, "die Wirtin");
  SetProp(P_PUBKEEPER_GENDER, FEMALE);
  SetProp(P_INT_SHORT, "Schmugglerkneipe 'Zollfrei'");
  SetProp(P_INT_LONG,
    "Du stehst in einer verrauchten und schaebig wirkenden Kneipe. Dunkle "
    "Gestalten lungern herum und drehen sich sofort weg, als sie Dich "
    "sehen. Fremde sind hier scheinbar nicht sonderlich willkommen. In dem "
    "schummrigen Licht kannst Du eine Theke und ein paar Barhocker "
    "erkennen, ausserdem eine Tafel auf der jemand ein paar beinahe "
    "unleserliche Worte gekritzelt hat. In einer Ecke stehen ein paar "
    "Faesser.");
  
  AddDetail(({"alkoholkonsum"}),
    "Hast Du schon mal versucht, Deinen eigenen jaehrlichen Alkoholkonsum "
    "aufzulisten?");
  AddDetail(({"anblick"}),
    "Bei Tageslicht muss es hier wirklich furchtbar aussehen.");
  AddDetail(({"armee"}),
    "Eine ganze Armee koennte sich hier besaufen!");
  AddDetail(({"baeume"}),
    "Vielleicht hat es hier mal welche gegeben, aber jetzt nicht mehr.");
  AddDetail(({"barhocker"}),
    "Die Barhocker sind mit duennem Stoff ueberzogene Holzkloetze auf 3 "
    "Beinen und sehen nicht sonderlich bequem aus. Kein Wunder, dass die "
    "meisten Leute hier stehen und fast alle Barhocker unbenutzt "
    "herumstehen.");
  AddDetail(({"baum","baeume"}),
    "Auf dieser Insel gibt es jetzt keine Baeume mehr. Vielleicht wurde aus "
    "dem letzten von ihnen dieser Boden gemacht?");
  AddDetail(({"beine","ergebnis"}),
    "Irgendwer hat versucht diese Beine zu drechseln. Das Ergebnis ist mehr "
    "als klaeglich.");
  AddDetail(({"bier","getraenke"}),
    "Tippe 'menue'.");
  AddDetail(({"blicke","blick"}),
    "Manche Leute schauen Dich finster, manche belustigt an.");
  AddDetail(({"boden"}),
    "Auf dem eingeebneten Boden wurden alte, knarrende Holzdielen verlegt, "
    "allerdings sehr schlampig.");
  AddDetail(({"dielen"}),
    "Die Dielen knarren bei jedem Deiner Schritte. Irgendjemand hat sich "
    "beim Verlegen beachtlich wenig Muehe gegeben.");
  AddDetail(({"dreck","grossputz","putz"}),
    "Die gesamte Kneipe haette dringend einen Grossputz noetig.");
  AddDetail(({"ecke","ecken"}),
    "In einer der vier Ecken stehen ein paar bauchige Bierfaesser.");
  AddDetail(({"einrichtung"}),
    "Nur eine grob getischlerte Theke und ein paar Barhocker bilden die "
    "Einrichtung der Kneipe.");
  AddDetail(({"ergebnis"}),
    "Sowas wuerdest Du auch zusammenbringen!");
  AddDetail(({"etiketten","etikette"}),
    "Auf den Etiketten sind seltsame Zeichen zu sehen.");
  AddDetail(({"faesser","bierfaesser"}),
    "Die Bierfaesser wuerden wohl eine ganze Armee ewig lange mit Bier "
    "versorgen und sagen einiges ueber den Alkoholkonsum der Leute um Dich "
    "herum aus.");
  AddDetail(({"flaschen"}),
    "Grosse und kleine Flaschen haengen kopfueber hinter der Theke, manche "
    "von ihnen sind noch ganz voll. Einige haben bunte Etiketten.");
  AddDetail(({"flecken","ueberbleibsel"}),
    "Dunkelbraune bis rostrote Flecken. Anscheinend Ueberbleibsel der "
    "letzten Schlaegerei.");
  AddDetail(({"fremde"}),
    "Fremde wie Du sind hier nicht gern gesehen.");
  AddDetail(({"gestalten","leute"}),
    "Ausser Dir sind noch einige zwielichtige Gestalten hier. Sie haben "
    "sich jedoch sofort zurueckgezogen, als Du die Kneipe betreten hast, "
    "und betrachten Dich voller Misstrauen.");
  AddDetail(({"hinsehen"}),
    "Manchmal lohnt es sich, nicht so genau hinzusehen...");
  AddDetail(({"holz"}),
    "Das Holz ist schon so alt, dass man gar nicht mehr feststellen kann, "
    "von welchem Baum es stammt.");
  AddDetail(({"holzdielen","dielen"}),
    "Irgendjemand hat sich beim Verlegen der Holzdielen beachtlich wenig "
    "Muehe gegeben.");
  AddDetail(({"holzkloetze","kloetze"}),
    "Du stellst es Dir alles andere als bequem vor, auf stoffbezogenen "
    "Holzkloetzen zu sitzen.");
  AddDetail(({"insel"}),
    "Damit ist die Insel gemeint, auf der Du Dich gerade befindest. "
    "Irgendwie logisch, oder?");
  AddDetail(({"kneipe"}),
    "Du stehst in der Kneipe der Insel, wo sich scheinbar die "
    "unappetitlichsten Gestalten versammelt haben.");
  AddDetail(({"licht"}),
    "Das schummrige Licht erspart Dir den Anblick der Kneipe bei "
    "Tageslicht.");
  AddDetail(({"misstrauen"}),
    "Anscheinend sind sie auf Fremde nicht sehr gut zu sprechen. Also "
    "benimm Dich gut, damit sie sich nicht bestaetigt sehen!");
  AddDetail(({"muehe","verlegen"}),
    "Vielleicht hat sich dieser jemand keine Muehe gegeben, vielleicht war "
    "er aber auch einfach besoffen. Wie die meisten Gestalten, die in der "
    "Kneipe herumhaengen.");
  AddDetail(({"schlaegerei"}),
    "Wenn Du in keine Schlaegerei geraten willst, solltest Du Dich "
    "unauffaellig verhalten.");
  AddDetail(({"schritt","schritte"}),
    "Es trennen Dich nicht mehr viele Schritte von einem kuehlen Bier!");
  AddDetail(({"stoff"}),
    "Einstmals beiger Stoff, der jetzt mit allen moeglichen Flecken "
    "besprenkelt ist.");
  AddDetail(({"tafel"}),
    "Mit 'menue' kannst Du sie lesen.");
  AddDetail(({"tageslicht"}),
    "Du bist froh, diese Kneipe nicht bei Tageslicht sehen zu muessen.");
  AddDetail(({"theke"}),
    "Die Theke ist grob getischlert und sehr schlampig verarbeitet. Sie ist "
	"ein bisschen staubig. "
    "Dahinter haengen kopfueber viele volle und halbvolle Flaschen.");
  AddDetail(({"totenkopf"}),
    "Du willst gar nicht wissen was in den Getraenken, die hier "
    "ausgeschenkt werden, alles drin ist...");
  AddDetail(({"worte"}),
    "Schwer zu entziffernde Worte. Mit 'menue' kannst Du sie lesen.");
  AddDetail(({"wunder"}),
    "Dich wundert gar nichts mehr.");
  AddDetail(({"zeichen"}),
    "Sie sehen aus wie ein Totenkopf, aber sicher bist Du Dir nicht.");
  AddDetail ( ({"tage"}),
    "Wer weiss schon wieviele Tage.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind aus grauem Felsgestein. Auf der hintersten Wand "+
    "haengt eine Tafel.");
  AddDetail ( ({"felsgestein", "gestein"}),
    "Graues, zerklueftetes Felsgestein. Gottseidank sind die Waende hoch "+
    "genug, dass Du Dir nicht den Kopf an der Decke stossen kannst.");
  AddDetail ( ({"decke"}),
    "Die Decke befindet sich hoch genug ueber Dir. Sie weist keine "+
    "Besonderheiten auf und besteht aus dem gleichen Gestein wie die "+
    "Waende.");
  AddDetail ( ({"besonderheiten"}),
    "Naja, was soll an einer Decke schon besonders sein...");
  AddDetail ( ({"kopf"}),
    "Deinem Kopf wuerde ein Zusammenstoss mit der Decke nicht gut tun.");
  AddDetail ( ({"zusammenstoss"}),
    "Gottseidank ist die Decke hoch genug ueber Dir, Du brauchst Dich also "+
    "nicht zu sorgen.");
  AddDetail ( ({"schuppen"}),
    "Dir wird ganz schlecht. Du redest Dir schnell ein, dass es sich dabei "
	"nicht um Schuppen, sondern um Staubfusseln handelt.");
  AddDetail ( ({"staubfusseln", "fusseln"}),
	"Ganz sicher sogar!");
  AddDetail ( ({"staub"}),
    "Du hoffst jedenfalls, dass es sich um Staub handelt...");
	
  AddSound(DEFAULT_SOUND,
    "Rund um Dich wird leise gefluestert.");
  AddSound(({"gefluester","fluestern"}),
    "Die Leute um Dich herum tuscheln leise. Wahrscheinlich reden sie "
    "gerade ueber Dich. Leider kannst Du nicht verstehen was sie sagen.");
  AddSound(({"leute"}),
    "*tuschel* "
    "Du wuerdest zu gern wissen, was sie sagen, aber Du verstehst sie nicht.");
  AddSmell(DEFAULT_SMELL,
    "Du riechst, dass sich nicht alle Leute um Dich herum frisch gewaschen "
    "haben. Ausserdem liegt der saure Geruch von billigen Bier und Schnaps "
    "in der Luft.");
  AddSmell(({"geruch"}),
    "Es riecht nach billigem Bier und Schnaps.");
  AddSmell(({"leute"}),
    "Eine Mischung aus Schweiss und Alkohol - so riecht man nur, wenn man "
    "sich ein paar Tage nicht gewaschen hat.");
  AddSmell(({"schweiss"}),
    "Du schnupperst an Dir selbst und stellst fest, dass Du auch schon "
    "mal besser gerochen hast." );
  AddSmell(({"alkohol"}),
    "Wenn man Alkohol trinkt, riecht man auch danach.");
  AddSmell(({"luft"}),
    "Die Luft ist feucht und abgestanden, hier sollte man mal lueften.");
  AddSmell(({"bier","schnaps"}),
    "Kein angenehmer Geruch...");
  AddSmell(({"mischung"}),
    "Eine uebelkeitserregende Mischung.");
  

  AddFood("Folienkartoffel",({"kartoffel","folienkartoffel"}), 40, ({20, 10}), 5,
          ({"Du wickelst die Folienkartoffel aus, verschlingst sie mit einem Bissen " 
		    "und verbrennst Dir dabei fast die Zunge.",
			"&& verschlingt gierig eine Folienkartoffel. "}));
  AddFood("Raclettebrot",({"raclettebrot","brot"}), 100, ({30,30}), 10,
          ({"Das Raclettebrot ist unten total verkohlt. Nach kurzem Zoegern isst "
		    "Du es trotzdem und findest es gar nicht mal so schlecht. ",
			"&& bekommt ein Raclettebrot serviert, das unten total verkohlt ist. "}));
  AddFood("Gemuesespiess",({"gemuesespiess","spiess"}), 150, ({35,45}), 15,
          ({"Mit einer Gabel versuchst Du, das Gemuese vom Spiess zu loesen und "
		    "schleuderst es dabei durch die halbe Kneipe. Beschaemt hebst Du "
			"alles vom Boden wieder auf und isst es dennoch - schliesslich "
			"hast Du ja dafuer bezahlt. ",
			"&& schleudert bei dem Versuch das Gemuese vom Spiess zu loesen "
			"alles durch den Raum, hebt es dann vom Boden auf und isst "
			"es trotzdem. Igitt! "}));
  AddFood("Kotelett",("kotelett"), 300, ({50,50}), 20, 
          ({"Knilda serviert Dir das groesste Stueck Schweinskotelett, das "
			"Du jemals gesehen hast. Du glaubst, das niemals aufessen zu koennen, "
			"aber dann schaffst Du es doch. Zufrieden haeltst Du Dir den Bauch. ",
			"&& verdrueckt ein riesiges Kotelett und haelt sich anschliessend "
			"zufrieden den Bauch. "}));
  AddFood("Halbe Sau",({"sau","halbe sau"}), 500, ({80,80}), 25,
          ({"Du bekommst eine Platte mit der Haelfte einer ausgewachsenen "
		    "Sau serviert. Sie hat sogar eine Tomate im Ruessel. Du nimmst "
			"sie in beide Haende und verspeist sie ganz barbarisch ohne "
			"Besteck. ",
			"&& nimmt die Haelfte einer ausgewachsenen Sau in beide Haende "
			"und faengt lauthals an zu schmatzen. Manieren sind das... "}));
  AddDrink("Suessmost", ({"suessmost","most"}), 120, ({20,20}), 0, 6,
          ({"Knilda bringt Dir ein Glaeschen Suessmost. Du trinkst es und verziehst "
		    "das Gesicht. So wie der schmeckt, sollte er lieber 'Sauermost' heissen. ",
			"&& trinkt ein Glas Suessmost und verzieht das Gesicht. "}));
  AddDrink("Bockbier", ({"bockbier","bier"}), 150, ({25,25}), 5, 10,
          ({"Knilda bringt Dir ein Kruegerl Bockbier. Es schmeckt billig und ein "
		    "bisschen schal, wahrscheinlich eine Eigenproduktion. ",
			"&& bestellt ein Kruegerl Bockbier, trinkt es aus und wischt sich den "
			"Schaum vom Mund. "}));
  AddDrink("Vogelbeerenschnaps", ({"vogelbeerenschnaps","schnaps"}), 280, ({35,35}), 10, 3,
          ({"Du bestellst einen Vogelbeerenschnaps und kippst ihn runter. "
		    "Du laesst das Glas fallen und schnappst nach Luft. Knilda fegt kommentarlos "
			"die Scherben zusammen. Das ist ihr wohl nicht zum ersten Mal passiert. ",
			"&& kippt ein Stamperl Vogelbeerenschnaps runter und laesst das Glas fallen. "
			"Knilda bueckt sich und fegt die Scherben zusammen, es scheint als waere so eine "
			"Reaktion auf dieses Getraenk normal. "}));
  AddDrink("Knildas Kraeutermix", ({"kraeutermix","mix","knildas kraeutermix"}),
            420, ({50,50}), 0, 10, 
		  ({"Knilda bringt Dir ein Stamperl mit einer komischen Fluessigkeit, "
		    "die einen uebelkeitserregenden Geruch verstroemt. Misstrauisch trinkst "
			"Du es in kleinen Schlucken und fuehlst Dich seltsam erfrischt und voller "
			"Tatendrang! ",
			"&& bekommt ein Stamperl mit einer stinkenden Fluessigkeit serviert, trinkt es "
			"vorsichtig und sieht danach viel frischer aus. "}));		
  AddDrink("Absinth", ("absinth"), 400, ({50, 50}), 13, 3, "absinth_blind");

  AddExit("norden", "./mnpcd4_2");

  AddCmd(({"liste"}), "cmd_liste");
  AddCmd(({"luefte"}), "cmd_luefte");
 
  AddItem(NPC "knilda",REFRESH_DESTRUCT,"");

}


int cmd_liste (string str)

{
   notify_fail("Was willst Du auflisten? \n");

   if(str=="alkoholkonsum auf")
   { 
       write(BS("Du rechnest Dir aus, was Du im letzen Jahr alles getrunken hast. "
             "Bei der Zahl wird Dir schlecht. Darauf brauchst Du dringend ein Bier. \n" ));
       say(TPN+ " zaehlt an den Fingern etwas ab und stuermt "
             "entsetzt zur Theke. \n"
       );
       return 1;
   }
   return 0;
} 

int cmd_luefte (string str)

 { 
     write(BS("Hier kann man leider nicht lueften, darum riecht es ja auch so "
	          "abgestanden.\n" ));
     return 1;
 }

void absinth_blind(object trinker, object zahler)
{
tell_object(trinker,BS("Knilda zuendet ein mit Absinth getraenktes Stueck Wuerfelzucker an, "
		    "wirft es in Dein Glas und ruehrt kraeftig um. Dann knallt sie Dir das "
			"Glas auf die Theke. Du trinkst es aus ohne abzusetzen und faengst "
			"fuerchterlich zu husten an. Teufelszeug!\n"));
tell_room(ENV(trinker),BS("Knilda ruehrt mit geuebten Gesten ein Glas Absinth an und knallt es "
			"vor " + trinker->Name() + " auf die Theke. " + trinker->Name() + " trinkt es in einem Zug leer und faengt "
			"fuerchterlich an zu husten.\n"),({trinker}));
	switch(random(8))
	{
		case 0:
		trinker->SetProp(P_BLIND,random(10)+18);
		tell_object(trinker,BS("Ohoh, Dir wird schwarz vor den Augen!\n"));
		tell_room(ENV(trinker),BS(trinker->Name() + " scheint Probleme mit den Augen zu haben!\n"),({trinker}));
		break;
	}
		
}