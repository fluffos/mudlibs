// By Kia@Silberland 5.2003
// Von hier aus gelangt man zur Schmugglerinsel

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]));
  SetProp (P_INT_SHORT, "Strand");
  SetProp (P_INT_LONG,
    "Hier macht der Weg einen Knick und Du stehst unvermutet genau vorm "+
    "Meer. Es erstreckt sich bis zum Horizont, und sein Anblick raubt Dir "+
    "fast den Atem. Ein paar kleine Fischerboote, die man nur als kleine "+
    "Puenktchen erkennen kann, unterbrechen das endlose Blau. Das Ufer "+
    "bildet ein flach abfallender Sandstrand, der im Osten durch schroffe "+
    "Klippen begrenzt ist. Einige Ruderboote stehen im Sand.");

  AddDetail ( ({"boden"}),
    "Der Boden besteht aus feinstem Sand, unter den sich ein paar "+
    "Steinchen mischen.");
  AddDetail ( ({"steinchen"}),
    "Hie und da mischen sich kleine Steinchen unter den Sand. ");
  AddDetail ( ({"sand"}),
    "Genaugenommen besteht auch der Sand aus kleinsten Steinchen "+
    "unterschiedlicher Faerbung. Die Sonne hat ihn stark erwaermt.");
  AddDetail ( ({"faerbung"}),
    "Nur wenn man genau hinsieht, erkennt man, dass der Sand aus kleinsten "+
    "bunten Steinchen besteht.");
  AddDetail ( ({"sonne"}),
    "Die Sonne lacht vom Himmel. Einige Strahlen kitzeln Dich in der Nase.");
  AddDetail ( ({"sonnenstrahlen", "strahlen"}),
    "Die Sonnenstrahlen bringen Dich fast zum niesen.");
  AddDetail ( ({"nase"}),
    "Deine Nase beginnt fuerchterlich zu jucken. Ha - Haa - Haaa... fast "+
    "musst Du niesen.");
  AddDetail ( ({"himmel"}),
    "Von dem blauen, wolkenlosen Himmel lacht die Sonne herab. Hier "+
    "wimmelt es nur so vor Seevoegeln.");
  AddDetail ( ({"seevoegel", "voegel"}),
    "Hauptsaechlich Moewen, die in den Klippen zu nisten scheinen. Ihr "+
    "Kreischen zerstoert die Idylle ein bisschen.");
  AddDetail ( ({"kreischen"}),
    "Versuchs mal mit lauschen!");
  AddDetail ( ({"moewen"}),
    "Man findet Moewen oft in der Naehe des Meeres.");
  AddDetail ( ({"meer"}),
    "Das Meer ist unglaublich blau. Kleine Wellen "+
    "rollen auf den Strand zu und ziehen sich wieder zurueck. ");
  AddDetail ( ({"wellen"}),
    "Nahe dem Ufer kraeuselt sich das Meer zu kleinen Wellen, die mit "+
    "Schaumkronen bedeckt sind.");
  AddDetail ( ({"kronen", "schaumkronen"}),
    "Durch die Wellen schaeumt das Meer ein bisschen.");
  AddDetail ( ({"anblick"}),
    "Das Meer bietet wirklich einen schoenen Anblick.");
  AddDetail ( ({"puenktchen"}),
    "Die Fischerboote sind sehr weit draussen. Du siehst sie als "+
    "klitzekleine Puenktchen und weisst dennoch, dass es sich dabei um "+
    "Boote und kleine Schiffe handelt.");
  AddDetail ( ({"boote","boot"}),
    "Welche Boote meinst Du? Die Ruderboote am Ufer oder die kleinen "+
    "Fischerboote weit draussen im Meer?");
  AddDetail ( ({"fischerboote","fischerboot"}),
    "Obwohl Du ausser einigen Puenktchen nichts erkennen kannst, "+
    "bist Du Dir sicher, dass es sich dabei um Fischerboote handelt.");
  AddDetail ( ({"ruderboote","ruderboot"}),
    "Einige Ruderboote stehen herum. Vielleicht solltest Du den Schmugglerjungen "+
    "danach fragen?");
  AddDetail ( ({"schmugglerjunge","junge"}),
    "Der ist momentan nicht da.");
  AddDetail ( ({"atem"}),
    "Der Anblick des tiefblauen Meeres laesst Dich doch glatt aufs Atmen "+
    "vergessen! Erst als Du schon ganz gruen bist schnaufst Du ein paar mal "+
    "tief durch.");
  AddDetail ( ({"atmen"}),
    "Tief durchatmen....");
  AddDetail ( ({"weg"}),
    "Der Weg fuehrt vom Fischerdorf zum Strand und wieder retour.");
  AddDetail ( ({"dorf", "fischerdorf"}),
    "Das befindet sich suedoestlich von Dir.");
  AddDetail ( ({"schiffe"}),
    "Ob es sich um Boote oder um kleinere Schiffe handelt, ist nicht so "+
    "genau zu erkennen.");
  AddDetail ( ({"strand"}),
    "Der Strand faellt flach ab und besteht aus Sand und kleineren "+
    "Steinchen.");
  AddDetail ( ({"klippen"}),
    "In den Klippen nisten die Seevoegel. Sie sind nicht besonders hoch "+
    "und begrenzen den Strand.");
  AddDetail ( ({"idylle"}),
    "Wirklich idyllisch, dieser Strand. Nur das Kreischen der Seevoegel "+
    "nervt ein wenig.");
  AddDetail ( ({"naehe"}),
    "Du bist hier eindeutig in der Naehe des Meeres!");
  AddDetail ( ({"moewe"}),
    "Du fixierst eine einzelne Moewe am Himmel und beobachtest sie. "+
    "Ploetzlich laesst sie etwas fallen, das mit einem lauten *platsch* in "+
    "Deinem Gesicht landet! Igitt! Angeekelt wischt Du Dich ab.");
  AddDetail ( ({"gesicht"}),
    "Natuerlich hat die Moewe genau Dein Gewicht erwischen muessen...");
  AddDetail ( ({"horizont", "linie"}),
    "Der Horizont bildet eine Linie zwischen dem Himmel und dem Meer.");
  AddDetail ( ({"blau"}),
    "Das Meer und der Himmel sind strahlend blau.");
  AddDetail ( ({"sandstrand"}),
    "So ein reiner Sandstrand ist das nicht.");
  AddDetail ( ({"knick"}),
    "Der Weg macht hier einen Knick von Nordwesten nach Suedosten und "+
    "endet am Strand.");
  AddDetail ( ({"ufer"}),
    "Du stehst am Ufer des Meeres.");
  AddDetail ( ({"wasser"}),
    "Wasser ueberall!");
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst das leise Rauschen des Meeres und das Kreischen der Voegel, "
	"das Dich gewaltig nervt.");
  AddSound ( ({"rauschen"}),
    "Das Meer rauscht leise vor sich hin und macht Dich irgendwie ganz "+
    "ruhig.");
  AddSound ( ({"meer"}),
    "Du lauscht dem Meer eine Weile und vergisst fast, warum Du hierher "+
    "gekommen bist. Dann aber reisst Du Dich zusammen, denn auch wenn Du "+
    "tagelang so dastehst und zuhoerst, Forscherpunkte oder "+
    "Erfahrungspunkte bringt das keine!");
  AddSound ( ({"erfahrungspunkte", "forscherpunkte", "erfahrungspunkt", "forscherpunkt"}),
    "Nein, auch wenn Du noch so genau lauscht wirst Du dadurch keine "+
    "Forscherpunkte oder Erfahrungspunkte aufspueren.");
  AddSound ( ({"weile"}),
    "Auch nach einer Weile klingt das Meer noch genauso wie vorher.");
  AddSound ( ({"kreischen","voegel","seevoegel"}),
    "Je genauer Du hinhoerst, desto lauter kommt Dir das Kreischen "
	"der Voegel vor.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du kannst das Salzwasser riechen.");
  AddSmell ( ({"salzwasser", "wasser"}),
    "Das Salzwasser riecht sehr intensiv nach... nach Salzwasser eben. Was "+
    "hast Du Dir denn erwartet ;)");
  
  AddCmd ( ({"leihe"}), "cmd_leihe"); 
  AddItem(NPC "rokko",REFRESH_DESTRUCT,"");

  AddExit("nordwesten", "/d/wasser/woody/fischerdorf/room/strandweg2");
  
}

seq1()  {
  write(BS("Du steigst vorsichtig in das kleine, wackelige Ruderboot und ruderst "
        "drauf los.\n"));   
  call_out("seq2",6);
}
seq2()  {
  write(BS("Am Anfang spritzt Du Dich bei jedem Ruderschlag von oben bis unten nass, "
        "aber mit der Zeit geht es immer besser.\n")); 
  call_out("seq3",7);
}
seq3()  {
  write(BS("Die Kueste ist schon in weiter Ferne, und das Fischerdorf verschwindet "
        "im Dunst, aber das ist Dir im Moment egal.\n")); 
  call_out("seq4",7);
}
seq4()  {
  write(BS("Du laesst Dir die Sonne auf die Haut "
        "brennen und groehlst ein Seemannslied.\n")); 
  call_out("seq5",5);
}
seq5()  { 
  write(BS("Ploetzlich haeltst Du inne.\n"));
  call_out("seq6",5);
}
seq6()  {
  write(BS("Stille.\n")); 
  call_out("seq7",9);
}
seq7()  {
  write(BS("Nur die Wellen plaetschern leise gegen den Bootsrand.\n")); 
  call_out("seq8",5);
}
seq8()  { 
  write(BS("Rund um Dich herum ist nichts als Wasser.\n"));
  call_out("seq9",6); 
}
seq9()  {
  write(BS("Panisch beginnst Du in irgendeine Richtung zu rudern.\n")); 
  call_out("seq10",6);
} 
seq10() {
  write(BS("Wolken schieben sich vor die Sonne und es wird dunkel.\n")); 
  call_out("seq11",5);
}
seq11()  {
  write(BS("Eine scharfe Brise kommt auf.\n"));
  call_out("seq12",8);
}
seq12() {
  write(BS("Dein kleines Boot beginnt heftig zu schaukeln, und die "
        "Wellen schwappen ueber den Rand.\n")); 
  call_out("seq13",8);
}
seq13() {
  write(BS("Vor Dir taucht der dunkle Umriss einer Insel auf.\n")); 
  call_out("seq14",5);
}
seq14() {
  write(BS("Wie besessen ruderst Du darauf zu.\n")); 
  call_out("seq15",6);
}
seq15() {
  write(BS("Als Du vor Erschoepfung Deine Arme kaum noch bewegen kannst, hast Du es "
        "endlich geschafft.\n")); 
  call_out("seq16",6);
}
seq16() {
  write(BS("Du kriechst auf allen Vieren aus dem Boot und "
        "verschwendest keinen Gedanken daran, es festzumachen.\n"));
  call_out("seq17",6); 
}
seq17() {
  write(BS("Benommen blickst Du Dich um.\n")); 
  call_out("seq18",1);
}
seq18() {
  TP->move(ROOM "d1_1",M_NOCHECK | M_SILENT);
}
		 
int cmd_leihe (string str)
{
  object ob;
  notify_fail("Was moechtest Du leihen?\n");

  if(str=="boot")
  {
    if (present("rokko",TO) == 0)
    {
      write(BS("Rokko ist im Moment nicht da.\n"));
      return 1;
    }
    if (!(present("\n_bootobjekt",TP) == 0))
    { 
      //TP->SetProp(P_PARALYZED, -1);
      ob = present("\n_bootobjekt",TP);
      ob->remove();
      call_out("seq1",0);
	  TP->move(ROOM "boot",M_NOCHECK | M_SILENT | M_NO_SHOW);
      return 1;
    }
    else
    {
      write(BS("Rokko borgt seine Boote nur Leuten, die das Codewort kennen.\n"));
      return 1;
    }
  }
  return 0;  

}

