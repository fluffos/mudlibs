inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  
  SetProp (P_LIGHT, 1
  );
  SetProp (P_INDOORS, 0
  );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_WATER])
  );
  // Details start ---------------------------------------------------------
  SetProp (P_INT_SHORT, "Am Sandstrand");
  SetProp (P_INT_LONG,
    "Du gehst den kleinen Strand entlang und drueckst Dich eng gegen die "+
    "Klippen um so gut wie moeglich mit dem Schatten zu verschmelzen. "+
    "Hier ist der Sandstreifen nicht mehr ganz so breit. Der Mond "+
    "spiegelt sich im Meer und verursacht ein eigenartiges Funkeln und "+
    "Glitzern, das liegt wohl auch an der aufgewuehlten See. Ein paar "+
    "Schritte weiter weg von Dir siehst Du etwas im Sand liegen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden", "sand"}),
    "Der Sand ist hier sehr feinkoernig und daempft jeden Deiner Schritte. "+
    "Nicht weit von Dir siehst Du etwas im Sand liegen, das aussieht wie "+
    "ein kleiner Haufen.");
  AddDetail ( ({"haufen"}),
    "Du atmest noch einmal tief durch und gehst gebueckt zu dem Haufen, um "+
    "ihn Dir naeher anzusehen. Es handelt sich um die Reste eines "+
    "Lagerfeuers. Anscheinend ist die Insel doch nicht so verlassen wie Du "+
    "zuerst angenommen hast.");
  AddDetail ( ({"reste"}),
    "Nur noch ein Haufen verkohlter Reste sind davon uebrig.");
  AddDetail ( ({"feuer", "lagerfeuer"}),
    "Die Reste eines erst kuerzlich angezuendeten Lagerfeuers beweisen "+
    "deutlich, dass hier noch jemand ausser Dir hier war.");
  AddDetail ( ({"meer", "see"}),
    "Das Meer wird vom Wind aufgepeitscht, hohe Wellen naehern sich dem "+
    "Strand und ueberschlagen sich mit lautem Tosen. Du musst aufpassen, "+
    "dass Du nicht nass wirst.");
  AddDetail ( ({"wellen"}),
    "Die Wellen sind unterschiedlich hoch und darum unberechenbar. Pass "+
    "auf, dass Du nicht nasse Fuesse kriegst.");
  AddDetail ( ({"fuesse"}),
    "Nasse Fuesse (wie Du sicher weisst) sind alles andere als gesund. Man "+
    "holt sich dann leicht einen Schnupfen.");
  AddDetail ( ({"schnupfen"}),
    "Hatschiiiii! Es faengt schon an.");
  AddDetail ( ({"tosen"}),
    "Du solltest dem Tosen mal genauer lauschen.");
  AddDetail ( ({"wind"}),
    "Der Wind peitscht die Wellen so richtig hoch und weht Dir den Sand "+
    "ins Gesicht. Er macht es Dir unmoeglich, auf verdaechtige Geraeusche "+
    "zu achten.");
  AddDetail ( ({"gesicht"}),
    "Du verziehst Dein Gesicht, um es so gut wie moeglich vor dem Wind zu "+
    "schuetzen.");
  AddDetail ( ({"klippen"}),
    "Eng an die Klippen gepresst wanderst Du den Strand entlang. In ihrem "+
    "Schatten bist Du kaum zu sehen, was Dir sehr gelegen kommt. Fast "+
    "senkrecht ragen sie in den Himmel.");
  AddDetail ( ({"insel"}),
    "Von hier aus kann man nicht abschaetzen, wie gross die Insel ist, "+
    "geschweige denn ob sie unbewohnt ist oder nicht.");
  AddDetail ( ({"mond"}),
    "Der Mond ist fast voll und sieht so aus als wuerde er grinsen. Du "+
    "grinst zurueck.");
  AddDetail ( ({"funkeln", "glitzern"}),
    "Der Mond verbreitet ein wenig Licht, welches vom Meer reflektiert "+
    "wird. Es sieht so aus, als wuerde es funkeln und glitzern.");
  AddDetail ( ({"licht"}),
    "Ausser dem Licht des Mondes ist es hier sehr dunkel. Das kommt Dir "+
    "aber ganz gelegen. So kannst Du zwar nichts sehen, aber falls jemand "+
    "kommen sollte bist Du jederzeit in der Lage, unbemerkt in den Schatten "+
    "zu verschwinden.");
  AddDetail ( ({"lage"}),
    "Du bist jederzeit in der Lage, mit dem Schatten zu verschmelzen und "+
    "so gut wie unsichtbar zu werden.");
  AddDetail ( ({"schatten"}),
    "Das Licht des Mondes wirft bizarre Schatten, die es anderen "+
    "unmoeglich machen sollten, Dich zu erkennen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist fast schwarz und voller Wolken. Nicht einmal der "+
    "starke Wind vermag es, diese zu verblasen. Nur der Mond ist deutlich "+
    "sichtbar.");
  AddDetail ( ({"wolken"}),
    "Duenne, hohe Wolken. Das kann nichts gutes verheissen.");
  AddDetail ( ({"wetter"}),
    "Mit dem Wetter kennst Du Dich nicht aus. Aber das muss man auch nicht "+
    "um zu erahnen, dass diese Wolken nichts gutes bedeuten.");
  AddDetail ( ({"wind"}),
    "Der Wind peitscht die Wellen hoch und weht Dir den Sand ins Gesicht, "+
    "zerrt an Deinen Kleidern und macht es Dir unmoeglich, auf verdaechtige "+
    "Geraeusche zu achten.");
  AddDetail ( ({"kleider"}),
    "Der Sand kriecht in jede noch so kleine Ritze Deiner Kleider und "+
    "ploetzlich juckt es Dich ueberall. Du fluchst wild und presst Dich "+
    "enger an die Klippen, die Dich jedoch kaum vor dem Wind schuetzen.");
  AddDetail ( ({"ritze"}),
    "Der Sand dringt in jede Ritze Deiner Kleidung und macht Dich "+
    "wahnsinnig. Ueberall beginnt es zu jucken.");
  AddDetail ( ({"moment"}),
    "Momentan ist das Meer richtig unruhig. Dir wird mulmig zumute.");
  AddDetail ( ({"sandstreifen", "strand", "streifen"}),
    "Du befindest Dich auf dem Sandstreifen einer kleinen Insel, jedoch "+
    "ist der Sandstreifen schon so schmal, dass Du Dich eng an die Klippen "+
    "presst um nicht ins Meer zu fallen.");
  AddDetail ( ({"ahnung"}),
    "Du gruebelst nach, doch du hast echt keine Ahnung.");
  AddDetail ( ({"luv", "seite"}),
    "Du befindest Dich auf der windzugewandten Seite der Insel. In der "+
    "Fachsprache nennt man diese Seite Luv.");
  AddDetail ( ({"fachsprache", "sprache"}),
    "In der Fachsprache nennt man die windzugewandte Seite auch 'Luv'.");
  AddDetail ( ({"ohren"}),
    "Gottseidank, es sind noch beide da!");
  AddDetail ( ({"gefahr"}),
    "Ganz schoen gefaehrlich ist es hier. Pass auf, dass Du nicht ins Meer "+
    "faellst!");
  AddDetail ( ({"naehe", "ufernaehe"}),
    "Ein Strand bedindet sich immer in Ufernaehe, sonst hiesse er ja nicht "+
    "so.");
  AddDetail ( ({"nase"}),
    "Du tastest Dich ab und stellst fest, dass Deine Nase noch da ist. Sei "+
    "froh, Du brauchst sie ja noch zum Riechen.");
  AddDetail ( ({"geraeusche"}),
    "Versuchs mal mit 'lausche'.");
  AddDetail ( ({"schritt", "schritte"}),
    "Nur ein halber Schritt trennt Dich von den nassen Wellen.");
  AddDetail ( ({"kleidung"}),
    "Selbst Deine Kleidung vermag den Sand nicht abzuhalten.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Du haeltst Deine Nase in den Wind und schnupperst. Es riecht "+
    "irgendwie verkohlt. Woher der Geruch wohl stammt?");
  AddSmell ( ({"feuer", "geruch", "lagerfeure"}),
    "Der Geruch duerfte von dem abgebrannten Lagerfeuer kommen.");
  AddSmell ( ({"wind"}),
    "Der Wind bringt einen verbrannten Geruch mit sich.");
  AddSound ( ({DEFAULT_SOUND}),
    "Das Heulen des Windes und das Tosen der Wellen sind so laut, dass Du "+
    "sonst nichts hoeren kannst.");
  AddSound ( ({"tosen"}),
    "Der Wind peitscht die Wellen auf, sodass sie in Ufernaehe mit lautem "+
    "Tosen brechen.");
  AddSound ( ({"geraeusch", "geraeusche"}),
    "Du hoerst nur das Heulen des Windes und das Tosen der Wellen.");
  AddSound ( ({"wellen"}),
    "Am liebsten wuerdest Du Dir ja die Ohren zuhalten, aber dann laeufst "+
    "Du Gefahr, ins Meer zu plumpsen.");
  AddSound ( ({"heulen"}),
    "Der Wind kann hier ungebremst wueten. Sonst hoerst Du nur noch das "+
    "Tosen der Wellen, und selbst wenn noch andere Geraeusche waeren, "+
    "koenntest Du sie nicht hoeren, Dazu ist das Heulen zu laut.");
  AddDetail ( ({"riechen"}),
    "Wie waers mit 'rieche'?");
  // DETAILS END

  // EXITS START
  AddExit ("nordosten", "./d1_1");
  AddExit ("suedwesten", "./b3_1");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
