// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "Oberhalb des Steges");
  SetProp (P_INT_LONG,
    "Du stehst mitten auf der Klippe vor einer Oeffnung im Fels, aus der "
    "gedaempftes Licht scheint. Sie ist halb von einem riesigen Stein "
    "verdeckt, weshalb sie von unten aus nicht zu sehen ist. Ein schneidend "
    "kalter Wind heult unablaessig durch die Felsen und zerzaust Dein Haar. "
    "Unter Dir siehst Du das Meer. Im Nordwesten kannst Du die Hoehle "
    "betreten, westlich von Dir verlaeuft der Klippenpfad. Weiter noerdlich "
    "kommst Du wieder zum Strand.");
  AddDetail(({"augen"}),
    "Deine Augen koennen leider nicht ums Eck schauen. Wenn du wissen "
    "willst, was hinter der naechsten Klippe ist, musst Du schon hingehen.");
  AddDetail(({"boden"}),
    "Der Boden ist uebersaet mit kleinen Steinchen.");
  AddDetail(({"eck"}),
    "Was hinter dem naechsten Eck ist, findest Du am besten heraus wenn Du "
    "hingehst.");
  AddDetail(({"fackeln"}),
    "Du glaubst, dass das Licht von Fackeln kommt, da es unregelmaessig "
    "flackert.");
  AddDetail(({"fels","felsen"}),
    "Der Fels ist aus einem kalkigen Gestein und hat viele Ritzen und "
    "Spalten. Nur durch das gedaempfte Licht bist Du auf die Oeffnung "
    "aufmerksam geworden.");
  AddDetail(({"feuer"}),
    "Wo Rauch ist, ist bekannterweise auch irgendwo Feuer. Von hier aus "
    "siehst Du aber keins.");
  AddDetail(({"gestein"}),
    "In dem Licht kannst Du nicht erkennen, aus welchem Gestein die Klippen "
    "sind.");
  AddDetail(({"haare","haar"}),
    "Deine Haare sind schon ganz verwuschelt.");
  AddDetail(({"himmel"}),
    "Gegen die Klippen sieht der Himmel richtig hellgrau aus. Du siehst "
    "eine kleine Rauchsaeule, die Dir vorher noch nicht aufgefallen ist.");
  AddDetail(({"hoehle"}),
    "Du glaubst, hinter der Oeffnung eine Hoehle erkennen zu koennen.");
  AddDetail(({"inneres"}),
    "Wenn Du ins Innere der Klippe willst, musst Du nach Nordwesten gehen.");
  AddDetail(({"klippe"}),
    "Du bist von hohen Klippen umgeben.");
  AddDetail(({"klippen"}),
    "Die Klippen sind aus trockenem, windgeschliffenem Gestein.");
  AddDetail(({"klippenpfad","pfad"}),
    "Der Pfad verlaeuft westlich von Dir und verschwindet hinter der "
    "naechsten Klippe, sodass Du ihm nicht sehr weit mit den Augen folgen "
    "kannst.");
  AddDetail(({"licht"}),
    "Ein gelber, flackernder Lichtkegel faellt auf den Boden und macht Dich "
    "auf die Oeffnung aufmerksam.");
  AddDetail(({"lichtkegel","kegel"}),
    "Irgendwo im Inneren der Klippe hat anscheinend jemand Fackeln "
    "angezunden.");
  AddDetail(({"meer"}),
    "Das Meer wuetet unter Dir wie kochendes Wasser.");
  AddDetail(({"mensch"}),
    "Einer allein wird da nicht weit kommen!");
  AddDetail(({"menschen","oger","trolle"}),
    "Menschen, Oger, Trolle, was auch immer.");
  AddDetail(({"oeffnung"}),
    "Du siehst eine natuerliche Oeffnung im Fels, die in die Klippe hinein "
    "fuehrt.");
  AddDetail(({"ohren"}),
    "Du rubbelst Deine Ohren wieder warm. Der Wind ist ganz schoen frisch "
    "hier.");
  AddDetail(({"rauchsaeule","saeule"}),
    "Da brennt irgendwo ein Feuer.");
  AddDetail(({"regenwasser","wasser"}),
    "Das Regenwasser sieht nicht besonders sauber aus, also beachtest Du es "
    "nicht weiter.");
  AddDetail(({"ritzen","spalten"}),
    "In den Ritzen und Spalten hat sich teilweise Regenwasser abgelagert.");
  AddDetail(({"schritte","schritt"}),
    "Jeder Schritt bringt ein paar Steinchen ins rollen. Unbemerkt wirst Du "
    "die Hoehle nicht betreten koennen, sicher hat man Dich laengst "
    "gehoert.");
  AddDetail(({"stein"}),
    "Der Stein ist so gross, dass ihn nur mehrere starke Menschen "
    "gleichzeitig verschieben koennen. Er koennte die ganze Oeffnung "
    "verdecken.");
  AddDetail(({"steinchen"}),
    "Jeder Deiner Schritte bringt die kleinen Steinchen ins rollen, die "
    "dann den Pfad hinunterpurzeln.");
  AddDetail(({"strand"}),
    "Der Strand, den Du schon entlanggegangen bist, befindet sich weiter "
    "noerdlich unter Dir.");
  AddDetail(({"wasser"}),
    "Das Wasser des Meeres spritzt jedesmal hoch, wenn eine Welle gegen die "
    "Klippe prallt.");
  AddDetail(({"welle","wellen"}),
    "Der Wind peitscht das Wasser zu mannshohen Wellen auf.");
  AddDetail(({"wind"}),
    "Der Wind braust Dir um die Ohren und zerzaust Dir die Haare.");
  AddDetail ( ({"rauch"}),
    "Du siehst eine Rauchsaeule und kombinierst prompt: irgendwo muss ein "+
    "Feuer brennen.");
  AddDetail ( ({"inneres"}),
    "Im Nordwesten kann man ins Innere der Klippe gehen.");

	
  AddSound ( ({DEFAULT_SOUND}),
    "Das Heulen des Windes uebertoent alles andere.");
  AddSound ( ({"wind", "heulen"}),
    "Du lauscht aufmerksam, aber Du hoerst wirklich nichts anderes als den Wind. "
    "Das beruhigt Dich ein bisschen.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Die Luft riecht angenehm. So frisch...");
  AddSmell ( ({"luft"}),
    "Du atmest tief durch. Hmmmm! ");
	

  AddExit("norden", "./f4_2");
  AddExit("westen", "./mnpce5_2");
  AddExit("nordwesten", "./mnpce4_2");
}
