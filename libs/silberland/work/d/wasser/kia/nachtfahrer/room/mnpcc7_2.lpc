// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_MOUNTAIN]));
  SetProp (P_INT_SHORT, "Am Klippenpfad");
  SetProp (P_INT_LONG,
    "Der Pfad windet sich auf halber Hoehe um die Klippe herum. Grosse "+
    "Felsbrocken liegen herum, die sich von der Felswand geloest haben. "+
    "Jedes laute Geraeusch, jeder falsche Schritt koennen hier eine "+
    "Gesteinslawine verursachen. Immer wieder bringst Du kleine Steinchen "+
    "ins Rollen, die weit unter Dir ins Meer plumpsen. Im Nordosten macht "+
    "der Klippenpfad einen leichten Knick und entwindet sich Deiner "+
    "Sicht, nordwestlich von Dir ist ein grosser Stein, der halb vor eine "+
    "Oeffnung im Fels gerollt wurde.");

  AddDetail ( ({"oeffnung"}),
    "In der Klippe befindet sich eine Oeffnung, die halb von einem grossen "+
    "Stein verdeckt ist. ");
  AddDetail ( ({"stein"}),
    "Der Stein ist riesig. Man braucht sicher mehrere starke Leute, um ihn "+
    "vom Fleck zu bewegen.");
  AddDetail ( ({"leute"}),
    "Nur mehrere Leute gemeinsam koennen einen Stein wie diesen bewegen.");
  AddDetail ( ({"fleck"}),
    "Du wirfst Dich mit voller Wucht gegen den Stein. Er ruehrt sich nicht "+
    "vom Fleck.");
  AddDetail ( ({"wucht"}),
    "War wohl zuwenig. Der Stein ist unbeweglich stehengeblieben.");
  AddDetail ( ({"boden"}),
    "Grosse Felsbrocken liegen am Boden herum. ");
  AddDetail ( ({"felsbrocken"}),
    "Du verfluchst innerlich die Felsbrocken, die immer genau vor Deinen "+
    "Fuessen auftauchen, wenn Du am wenigsten damit rechnest.");
  AddDetail ( ({"fuesse"}),
    "Sei froh, dass Du nicht 2 linke Fuesse hast.");
  AddDetail ( ({"himmel"}),
    "Der Himmel sieht so unendlich weit aus, dass Dir schwindelig wird. "+
    "Zwischen ein paar kleinen Wolken lugt der Mond hervor.");
  AddDetail ( ({"mond"}),
    "Der Mond leuchtet tapfer zwischen zwei kleinen Wolken durch und "+
    "spendet Dir ein bisschen Licht.");
  AddDetail ( ({"wolken"}),
    "Es sieht so aus als wuerden die beiden Wolken versuchen, den Mond zu "+
    "verdecken. Erfolglos, wies scheint.");
  AddDetail ( ({"licht"}),
    "Ein angenehmes, gedaempftes Licht. ");
  AddDetail ( ({"gesteinslawine", "lawine"}),
    "Wie es sich wohl anfuehlt, wenn man unter Tonnen von Steinen begraben "+
    "ist?");
  AddDetail ( ({"steine"}),
    "Lebendig begraben sein.... Du schauderst.");
  AddDetail ( ({"tonnen"}),
    "Die Klippe besteht aus Tonnen von Stein. Nicht auszudenken, wenn Du "+
    "darunter liegen wuerdest.");
  AddDetail ( ({"klippe"}),
    "Eine hohe Klippe ragt in den Himmel. Du gehst auf halber Hoehe um sie "+
    "herum.");
  AddDetail ( ({"hoehe"}),
    "Obwohl Du die Klippe nur halb erklommen hast, bist Du schon ziemlich "+
    "hoch oben.");
  AddDetail ( ({"felswand"}),
    "Neben Dir tuermt sich eine hohe Felswand auf. Sie ist voller Risse "+
    "und Spalten und sieht so aus, als wuerde sie jeden Augenblick in sich "+
    "zusammenstuerzen.");
  AddDetail ( ({"risse", "spalten"}),
    "Die Felswand ist ziemlich zerklueftet und voller handgrosser Risse "+
    "und Spalten.");
  AddDetail ( ({"hand"}),
    "So gross jedenfalls, dass Deine Hand locker reinpassen wuerde.");
  AddDetail ( ({"augenblick"}),
    "Du zwinkerst mit den Augen. Ungefaehr so lange dauert ein Augenblick.");
  AddDetail ( ({"augen"}),
    "Boah Du hast doch tatsaechlich zwei davon!");
  AddDetail ( ({"geraeusch"}),
    "Tippe 'lausche'.");
  AddDetail ( ({"meer"}),
    "Weit unter Dir befindet sich das Meer. Ab und zu faellt eines der "+
    "Steinchen, die Du ins Rollen gebracht hast, hinein. Es ist relativ "+
    "ruhig, die Gischt spritzt nicht einmal bis hier oben.");
  AddDetail ( ({"gischt"}),
    "Die Wellen prallen gegen die Klippe und kleine Wassertroepfchen "+
    "wirbeln hoch. Aber nicht bis zu Dir, Du bist einfach zu hoch oben.");
  AddDetail ( ({"wellen"}),
    "Die Wellen sind nicht sonderlich hoch, weshalb die Gischt Dich auch "+
    "nicht erreicht.");
  AddDetail ( ({"troepfchen", "wassertroepfchen"}),
    "Die Troepfchen werden beim Aufprall in die Luft gewirbelt.");
  AddDetail ( ({"aufprall"}),
    "Wenn die Wellen gegen die Klippe prallen.");
  AddDetail ( ({"luft"}),
    "Kleine Wassertroepfchen werden hoch in die Luft gewirbelt.");
  AddDetail ( ({"steinchen"}),
    "Die Steinchen liegen locker auf dem Pfad herum. Bei jedem Deiner "+
    "Schritte bringst Du einige ins Rollen.");
  AddDetail ( ({"sicht"}),
    "Was im Nordwesten ist kannst Du nicht sehen, da Dir dir Klippe die "+
    "Sicht versperrt. Da muesstest Du schon hingehen.");
  AddDetail ( ({"klippenpfad", "pfad"}),
    "Du stehst auf dem Klippenpfad, der natuerlichen Ursprungs zu sein "+
    "scheint.");
  AddDetail ( ({"ursprung"}),
    "Jedenfalls sieht er nicht so aus, als waere er von Menschenhand "+
    "bearbeitet worden.");
  AddDetail ( ({"hand", "menschenhand"}),
    "Nein, Du bist Dir voellig sicher, dass keine menschliche Hand so "+
    "einen Pfad schaffen koennte... oder wuerde, denn sonderlich bequem ist "+
    "er ja nicht.");
  AddDetail ( ({"knick"}),
    "Der Knick im Pfad verhindert, dass Du ihm mit den Blicken folgen "+
    "kannst.");
  AddDetail ( ({"blicke"}),
    "Du blickst mit neugierigen Blicken um Dich. Leider kannst Du nicht "+
    "ums Eck sehen.");
  AddDetail ( ({"eck"}),
    "Notfalls hilft hingehen :)");
  AddDetail ( ({"schritt"}),
    "Du setzt Deine Fuesse sehr vorsichtig auf. Nichtsdestotrotz rollen "+
    "immer wieder Steinchen darunter weg.");
  AddDetail ( ({"fuss"}),
    "Ein linker und ein rechter, und das ist gut so. Mit zwei linken geht "+
    "es sich so schlecht.");
  AddDetail ( ({"rollen"}),
    "Die Steinchen kullern unter Dir weg und verursachen Laerm, den Du "+
    "lieber vermeiden wuerdest.");
  AddDetail ( ({"laerm"}),
    "Wie ein Elefant im Porzellanladen!");
  AddDetail ( ({"elefant", "laden", "porzellanladen"}),
    "Nur ein Sprichwort...");
  AddDetail ( ({"sprichwort"}),
    "Ja, Du kommst Dir vor wie der sprichwoertliche Elefant im "+
    "Porzellanladen.");

  AddSound ( ({DEFAULT_SOUND}),
	"Ausser dem Wind glaubst Du, Geraeusche aus dem Inneren der Klippe "
	"zu hoeren.");
  AddSound ( ({"wind"}),
    "Der Wind heult hier genauso wie sonstwo. Mittlerweile hast Du Dich "
	"daran gewoehnt und es faellt Dir gar nicht weiter auf.");
  AddSound ( ({"geraeusche"}),
    "Die Geraeusche klingen wie... Stimmen! Ist das denn moeglich?");
  AddSound ( ({"stimmen"}),
    "Dem solltest Du nachgehen.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Die Luft ist frisch und riecht eigentlich nur nach Luft. "
	"Ab und zu traegt der Wind den Geruch von Salzwasser zu Dir.");
  AddSmell ( ({"luft"}),
    "Die Luft riecht nach Luft und sonst gar nix.");
  AddSmell ( ({"geruch"}),
    "Den Geruch von Salzwasser nimmst Du schon fast nicht mehr wahr. "
	"Hier riecht es ueberall danach.");
  AddSmell ( ({"salzwasser"}),
    "Brrrr, ueberall riecht es danach.");
  AddSmell ( ({"wind"}),
    "Der Geruch nach Salzwasser wird vom Wind ueberall hingetragen."
	"Darum riecht es auch ueberall danach.");  

  AddExit ("nordosten", "./mnpcd6_2");
  AddExit ("nordwesten", "./mnpcb6_2");

}
