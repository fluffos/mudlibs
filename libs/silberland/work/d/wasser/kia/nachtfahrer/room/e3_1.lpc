// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_WATER]));
  SetProp (P_INT_SHORT, "Am Sandstrand");
  SetProp (P_INT_LONG,
    "Von dem breiten Strand weiter noerdlich ist nur noch ein schmaler "
    "Streifen uebrig, genau breit genug, dass Du gerade noch drauf gehen "
    "kannst. Grosse Felsbrocken stehen Dir im Weg und machen ein "
    "Vorwaertskommen schwierig. Immer wieder umspuelen kleine, eiskalte "
    "Wellen Deine Fuesse. Noerdlich von Dir wird der Strand wieder "
    "sandiger, weiter suedoestlich siehst Du einen breiten Steg, den Du "
    "betreten kannst.");
  AddDetail(({"bann"}),
    "Wie gebannt starrst Du den Mond an und fuehlst Dich wie verzaubert.");
  AddDetail(({"boden"}),
    "Der Boden ist uebersaet mit groesseren und kleineren Felsbrocken, die "
    "es Dir schwer machen, vorwaerts zu kommen. Dazwischen siehst Du das "
    "bekannte fluoreszierende Schimmern des Sandes, und ein paar grauweisse "
    "Salztuempel, die sich gebildet haben.");
  AddDetail(({"entfernungen","entfernung"}),
    "Alles scheint weiter auseinander zu sein, als es in Wirklichkeit ist.");
  AddDetail(({"fall"}),
    "Das tut sicher weh...");
  AddDetail(({"felsbrocken","brocken"}),
    "Dir ist, als haetten sich saemtliche Felsbrocken gegen Dich "
    "verschworen und versuchen nun, Dich bei jedem Schritt zu Fall zu "
    "bringen. Du fluchst leise.");
  AddDetail(({"finger"}),
    "Was musst Du auch Deine Finger ueberall reinstecken.");
  AddDetail(({"fuesse","fuss"}),
    "Hat Dich Deine Mama nicht vor nassen Fuessen gewarnt? Pass auf dass Du "
    "keinen Schnupfen kriegst.");
  AddDetail(({"glanz"}),
    "Sie glitzern und funkeln und scheinen unendlich weit weg zu sein.  Du "
    "verstehst ploetzlich, wie das Sprichwort \"nach den Sternen greifen\" "
    "gemeint ist.");
  AddDetail(({"haende","hand"}),
    "Falls wirklich ein Felsbrocken runterfallen sollte, wuerden sie Dir "
    "auch nix nuetzen.");
  AddDetail(({"hans-guck-in-die-luft"}),
    "Son nennt man Leute wie Dich, die in den Himmel starren anstatt darauf "
    "zu achten, wo sie hinsteigen.");
  AddDetail(({"himmel"}),
    "Der Himmel ist grau und trist. Zwischen den duennen, hohen Wolken "
    "lugen ein paar Sterne hervor, und der Mond steht wie eine blassgelbe "
    "Scheibe hoch ueber Dir.");
  AddDetail(({"insel"}),
    "Damit ist die Insel gemeint, auf der Du gerade bist.");
  AddDetail(({"klippen"}),
    "Die Klippen ueber Dir bilden einen leichten Ueberhang. Von dort sind "
    "die Felsbrocken abgebrochen und heruntergefallen.");
  AddDetail(({"kopf"}),
    "Schuetzend bedeckst Du Deinen Kopf mit den Haenden.");
  AddDetail(({"leuchten"}),
    "Vielleicht ist es ja auch nur das Licht des Mondes, das im Sand "
    "reflektiert wird.");
  AddDetail(({"leute"}),
    "Solche wie Du!");
  AddDetail(({"licht"}),
    "Du ueberlegst, wie es hier bei Tageslicht aussehen wuerde.");
  AddDetail(({"mama"}),
    "Deine Mama ist nicht hier, aber an das, was sie ueber kalte Fuesse "
    "gesagt hat, erinnerst Du Dich noch ganz deutlich.");
  AddDetail(({"masse"}),
    "Wie eine traege schwarze Masse umspuelt das Meer Deine Fuesse.");
  AddDetail(({"material"}),
    "Du bist Dir ziemlich sicher, so ein Material noch nie gesehen zu "
    "haben. Vielleicht ist es ja einzigartig und nur auf dieser Insel zu "
    "finden.");
  AddDetail(({"meer"}),
    "Du siehst das Meer als wabernde, schwarze Masse, fast, als waere es "
    "lebendig.");
  AddDetail(({"mond"}),
    "Du blickst hoch und starrst den Mond an, der Dich sofort in seinen "
    "Bann zieht. Am liebsten wuerdest Du ihn anheulen.");
  AddDetail(({"mondstrahlen"}),
    "Die Mondstrahlen erhellen Deine Umgebung ein bisschen.");
  AddDetail(({"salztuempel","tuempel"}),
    "Du steckst Deinen Finger in einen der Salztuempel und lutscht daran. "
    "Eindeutig Salzwasser.");
  AddDetail(({"salzwasser"}),
    "Ekliges, abgestandenes Salzwasser. Brrrr!");
  AddDetail(({"sand"}),
    "Der Sand fluoresziert eigenartig, und Du fragst Dich wiederholt, aus "
    "welchem Material er wohl ist.");
  AddDetail(({"scheibe"}),
    "So blassgelb und kreisrund sieht der Mond aus wie eine Scheibe.");
  AddDetail(({"schimmern"}),
    "Du bist Dir nicht sicher, was dieses Schimmern hervorruft. Entweder "
    "ist es das Material an sich, oder es sind einfach die Mondstrahlen, "
    "die reflektiert werden.");
  AddSpecialDetail(({"schnupfen"}),"detail_schnupfen");
  AddDetail(({"schritt"}),
    "Planlos stolperst Du zwischen den Felsbrocken herum und strauchelst "
    "immer wieder. Das truegerische Licht des Mondes macht es schwer, "
    "Entfernungen richtig einzuschaetzen.");
  AddDetail(({"sprichwort"}),
    "Kennst Du das Sprichwort nicht?");
  AddDetail(({"steg"}),
    "Seltsam, der Steg ist Dir vorher gar nicht aufgefallen. Was es damit "
    "wohl auf sich hat?");
  AddDetail(({"sterne"}),
    "Du betrachtest den Glanz der Sterne und stolperst glatt ueber den "
    "naechsten Felsbrocken. Hans-Guck-in-die-Luft!");
  AddDetail(({"strand"}),
    "Der Strand ist dort, wo Du gerade stehst. Neben Dir sind auf der einen "
    "Seite die Klippen, auf der anderen Seite das Meer.");
  AddDetail(({"tageslicht"}),
    "Vielleicht gibt es hier so was wie Tageslicht auch gar nicht? Wenn du "
    "lange genug bleibst, wirst Du es sicher herausfinden.");
  AddDetail(({"ueberhang"}),
    "Es koennte sich jederzeit ein Felsbrocken loesen und Dir auf den Kopf "
    "fallen...");
  AddDetail(({"umgebung"}),
    "Alles rund um Dich herum.");
  AddDetail(({"vorwaertskommen"}),
    "Ein Vorwaertskommen ist durch die Felsbrocken zwar schwieriger, aber "
    "nicht unmoeglich.");
  AddDetail(({"weg"}),
    "Trotz der Felsbrocken bahnst Du Dir einen Weg.");
  AddDetail(({"wellen"}),
    "Die Wellen umspuelen Dich. Deine Fuesse sind schon ganz nass, Du zitterst.");
  AddDetail(({"wirklichkeit"}),
    "In Wirklichkeit sind die Felsbrocken viel naeher zusammen, als es "
    "scheint.");
  AddDetail ( ({"seite", "seiten"}),
    "Hat nicht alles zwei Seiten?");
  AddDetail ( ({"wolken"}),
    "Die Wolken tuermen sich bedrohlich auf.");
  AddDetail ( ({"sandstreifen", "streifen"}),
    "Du stehst auf einem Sandstreifen, der einerseits vom Meer, "+
    "andererseits von den Klippen abgegrenzt ist.");
  AddDetail ( ({"wasser"}),
    "Eins, zwei, viele Wasser.");
	
	
  AddSound(DEFAULT_SOUND,
    "Das Plaetschern des Meeres macht Dich schlaefrig. Der Wind saeuselt "
    "leise vor sich hin und scheint Dich auszulachen.");
  AddSound(({"plaetschern","meer"}),
    "Das Meer plaetschert gleichmaessig vor sich hin. Es faellt Dir schwer, "
    "Dich zu konzentrieren.");
  AddSound(({"wind"}),
    "Der Wind weht fast lautlos ueber Dich hinweg und scheint boesartig vor "
    "sich hinzukichern.");
  AddSmell(DEFAULT_SMELL,
    "Das Salzwasser verstroemt einen intensiven Geruch.");
  AddSmell(({"geruch"}),
    "Anders als weiter noerdlich riecht es hier aber frisch und angenehm.");
  AddSmell(({"salzwasser"}),
    "Salzwasser hat einen ganz eigenen Geruch, manche moegen ihn, andere "
    "nicht.");
	
	
  AddExit("norden", "./e2_1");
  AddExit("suedosten", "./f4_1");
  
  AddCmd(({"heule","heul"}),"cmd_heule");
 
}

void go_schnupf(object theplayer)
{
	if (present("\n_schnupfen",theplayer) == 0)
		clone_object(OBJ "schnupfen")->move(theplayer);
}

string detail_schnupfen()
{
	call_out("go_schnupf",20,TP);
	return "Wenn Du noch lange hier stehenbleibst, verkuehlst Du Dich noch.\n";
}

int cmd_heule (string str)
{
   notify_fail("Was willst Du anheulen? \n");

   if(str=="mond an")
   { 
       write(BS("Du legst den Kopf in den Nacken und heulst wie ein Wolf. Der "
                "Mond reagiert darauf nicht, sondern steht starr und unbekuemmert "
                "am Himmel. Was hast Du Dir denn erwartet? \n" ));
       say(TP->Name(WER,2)+ " legt den Kopf in den Nacken und heult wie ein Wolf. \n");
       return 1;
   }
   return 0;
} 

