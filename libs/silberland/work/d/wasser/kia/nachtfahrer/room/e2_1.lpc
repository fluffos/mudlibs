// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

int muschel;
void create()
{
  ::create();
  muschel = 1; 
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_WATER]));
  SetProp (P_INT_SHORT,
    "Am Sandstrand.");
  SetProp (P_INT_LONG,
    "Hier ist der Strand deutlich schmaeler als weiter noerdlich, trotzdem "
    "hast Du noch genug Platz, um bequem darauf zu gehen. Es ist sehr "
    "dunkel, da eine besonders hohe Klippe sogar den Mond verdeckt. Nur der "
    "Sand fluoresziert eigenartig und laesst die Klippen bizarre Schatten "
    "werfen.");
	
	
  AddDetail(({"albtraum","albtraeume"}),
    "Die Insel koennte aus einem Deiner Albtraeume stammen.");
  AddDetail(({"boden"}),
    "Feinkoerniger Sand bedeckt den Boden und knirscht bei jedem Deiner "
    "Schritte uner den Fuessen. Ein paar kleinere Felsbrocken liegen "
    "herum.");
  AddDetail(({"etwas"}),
    "Du bueckst Dich und betrachtest das Etwas, auf das Du getreten bist. "
    "Es handelt sich um eine handtellergrosse Muschel, die in mehrere Teile "
    "zerbrochen ist.");
  AddDetail(({"felsbrocken","brocken"}),
    "Ein paar groessere und kleinere Felsbrocken liegen herum. "
    "Wahrscheinlich sind sie von der Klippe abgebroeckelt und "
    "heruntergefallen.");
  AddDetail(({"finger"}),
    "Mit den Fingern pruefst Du, ob es sich um Goldstaub handelt oder "
    "nicht. Der Sand greift sich jedoch wie ganz normaler Sand an.");
  AddDetail(({"fuesse"}),
    "Vorsichtig setzt Du einen Fuss vor den anderen und gibst Dir alle "
    "Muehe, kein Geraeusch zu verursachen. Plotzlich steigst Du auf Etwas, "
    "das unter Deinen Fuessen zerbricht.");
  AddDetail(({"fuss"}),
    "Du hast zwei davon, einen linken und einen rechten.");
  AddDetail(({"gefuehl"}),
    "Wenn es nach Deinem Gefuehl ginge, wuerdest Du jetzt sofort umdrehen "
    "und wie der Teufel zurueckrudern.");
  AddDetail(({"geraeusch"}),
    "Versuchs mal mit 'lausche'.");
  AddDetail(({"gipfel"}),
    "Der Gipfel ist SEHR hoch oben.");
  AddDetail(({"goldstaub"}),
    "Du laesst den Sand durch Deine Finger rieseln. Kein Goldstaub, schade "
    "eigentlich.");
  AddDetail(({"hand"}),
    "Du hebst Deine Hand und betrachtest sie. Verglichen mit der Klippe "
    "sieht sie schneeweiss aus. Sie zittert ein wenig.");
  AddDetail(({"himmel","nachthimmel"}),
    "Der Himmel spannt sich wie ein pechschwarzes Zelt ueber Dich.");
  AddDetail(({"insel"}),
    "Damit ist die Insel gemeint, auf der Du Dich befindest. Irgendwie "
    "klar, oder?");
  AddDetail(({"klippe"}),
    "Wie eine ausgestreckte schwarze Hand hebt sich die Klippe gegen den "
    "Nachthimmel ab. Wenn Du zu ihrem Gipfel hochblickst, kommst Du Dir vor "
    "wie ein kleines Wuerstchen.");
  AddDetail(({"klippen"}),
    "Die ganze Insel scheint nur aus Sand und Klippen zu bestehen und "
    "hochgradig unfruchtbar zu sein. Sicher kann hier kein Wesen "
    "ueberleben.");
  AddDetail(({"klischee"}),
    "Dazu fehlt hier eindeutig die Sonne.");
  AddDetail(({"licht"}),
    "Bei diesem Licht sieht alles anders aus als normal.");
  AddDetail(({"meer","ufernaehe"}),
    "Ruhig plaetschert das Meer vor sich hin. Ein paar kleine Wellen "
    "kraeuseln sich in Ufernaehe.");
  AddDetail(({"meerestierchen","tierchen"}),
    "So genau kannst Du das nicht erkennen, aber die Tierchen sind etwa "
    "fingernagelgross und ziemlich flink.");
  AddDetail(({"mond"}),
    "Eine Klippe hat sich zwischen Dir und den Mond geschoben, darum kannst "
    "Du ihn von hier aus nicht sehen. Nur ein paar verirrte Strahlen "
    "reichen bis hier her.");
  AddDetail(({"muschel","jakobsmuschel"}),
    "Bevor du sie zerbrochen hast war das eine wunderschoen gezeichnete "
    "Jakobsmuschel. Jetzt sind nur noch ein paar kuemmerliche Einzelteile "
    "davon uebrig.");
  AddDetail(({"orientierungshilfe","hilfe"}),
    "Hier kann Dir niemand helfen!");
  AddDetail(({"platz"}),
    "Noch ist genuegend Platz vorhanden, um bequem herumzugehen, aber "
    "weiter im Suedosten verengt sich der Strand zu einem schmalen "
    "Streifen.");
  AddDetail(({"sand"}),
    "Du siehst, dass der Sand feinkoernig ist, aber Du spuerst es auch bei "
    "jedem Schritt unter Deinen Fuessen. Er schimmert eigenartig und sieht "
    "bei diesem Licht aus wie Goldstaub.");
  AddDetail(({"schatten"}),
    "Du bist von bizarren Schatten umgeben und kommst Dir vor wie in einem "
    "Albtraum. Dieser schwarze Schatten vor Dir, hat sich der nicht gerade "
    "bewegt?");
  AddDetail(({"schritt","schritte"}),
    "Du machst einen vorsichtigen Schritt und *knirsch* zerbricht Etwas.");
  AddDetail(({"schwarzer schatten","schwarzen schatten"}),
    "Du siehst genauer hin und bist Dir fast sicher, Dich getaeuscht zu "
    "haben. Oder etwa doch nicht? Jedenfalls beschliesst Du, Dich nicht "
    "weiter verrueckt zu machen.");
  AddDetail(({"sonne"}),
    "Eine Sonne siehst Du nicht. Du bist Dir nicht mal sicher, ob sie hier "
    "jemals scheint.");
  AddDetail(({"stern","sterne"}),
    "Weder Sonne noch Sterne koennen Dir auf dieser Insel eine "
    "Orientierungshilfe sein. Du wirst Dich vollkommen auf Dein Gefuehl "
    "verlassen muessen.");
  AddDetail(({"strahlen"}),
    "Anhand der paar verirrten Strahlen weisst Du wenigstens, dass der Mond "
    "noch existiert. Ein beruhigendes Gefuehl.");
  AddDetail(({"strand"}),
    "Der Strand auf dem Du gehst, hat wenig mit den Klischee zu tun, das "
    "einem sofort dabei einfaellt.");
  AddDetail(({"streifen"}),
    "Weiter suedoestlich wird es dann ein wenig eng.");
  AddDetail(({"suedosten"}),
    "Du kannst nach Suedosten gehen und ausprobieren, ob Du noch am Strand "
    "gehen kannst, ohne Dir die Fuesse nass zu machen." );
  AddDetail(({"teile","teil","einzelteile"}),
    "Einer der Teile sieht sehr scharfkantig aus. Vielleicht kannst Du ihn "
    "ja noch brauchen? Du steckst ihn ein.");
  AddDetail(({"teufel"}),
    "Ja, am liebsten wuerdest Du einfach wieder umkehren. Aber das waer "
    "doch feig, nicht wahr?");
  AddDetail(({"tuempel"}),
    "Ein paar kleine Tuempel haben sich angesammelt, und werden immer "
    "wieder von den Wellen genaehrt. Der Strand liegt anscheinend bei Flut "
    "vollkommen unter Wasser. Kleine Meerestierchen tummeln sich in ihnen.");
  AddDetail(({"ufer"}),
    "Dort wo Du stehst, ist das Ufer.");
  AddDetail(({"wellen","schaum"}),
    "Die Wellen sind von weissem Schaum gekroent und plaetschern leise auf "
    "das Ufer zu.");
  AddDetail(({"wesen"}),
    "Immerhin siehst Du ein paar kleine Meerestierchen in dem Tuempel vor "
    "Dir.");
  AddDetail(({"wuerstchen"}),
    "Klein und unbedeutend kommst Du Dir vor, wenn du hinaufblickst. Du "
    "solltest Dich vielleicht eher auf den Boden vor Dir konzentrieren.");
  AddDetail(({"zelt"}),
    "Du weisst zwar, dass der Himmel unendlich ist, aber er sieht trotzdem "
    "wie ein Zelt aus. Kein einziger Stern ist zu sehen.");
   AddDetail ( ({"flut"}),
    "Sei froh, dass nicht gerade Flut ist, sonst muesstest Du jetzt "+
    "schwimmen.");
  AddDetail ( ({"wasser"}),
    "Das Meer ist voll davon.");
  AddSmell ( ({"sinn", "sinne"}),
    "Mit riechen kommst Du hier jedenfalls nicht weiter.");
  AddDetail ( ({"muehe"}),
    "Du gibst Dir wirklich Muehe, leise zu sein, aber Du bist zu "+
    "tollpatschig. ");
	
	
  AddSound(DEFAULT_SOUND,
    "Du befindest Dich auf der windabgewandten Seite der Insel, hier ist "
    "das Heulen des Sturms kaum zu hoeren. Auch das Meer plaetschert nur "
    "ruhig vor sich hin. Aber halt, hast Du nicht gerade ein Geraeusch "
    "gehoert?");
  AddSound(({"geraeusch"}),
    "War da nicht eben ein Knacken? Oder macht Dich diese Insel schoen "
    "langsam verrueckt?");
  AddSound(({"heulen"}),
    "Die Klippen scheinen Dich vor dem Sturm zu schuetzen, Du hoerst hier "
    "kein Heulen.");
  AddSound(({"klippen"}),
    "Du legst Dein Ohr an die Klippe, aber du hoerst nichts. Sie steht "
    "lautlos und unbeweglich da, wie immer.");
  AddSound(({"knacken"}),
    "Jetzt hoerst Du nichts mehr, aber Dir war vorher so, als haette es "
    "irgendwo laut geknackt.");
  AddSound(({"meer"}),
    "Das Meer ist hier viel ruhiger als weiter noerdlich, Du hoerst es "
    "eigentlich kaum. Leise plaetschert es vor sich hin.");
  AddSound(({"ohr"}),
    "An Deinem eigenen Ohr kannst Du nicht lauschen.");
  AddSound(({"sturm"}),
    "Von dem Sturm kriegst Du hier nicht viel mit.");
  AddSmell(DEFAULT_SMELL,
    "Es riecht hier nach abgestandenem Salzwasser.");
  AddSmell(({"salzwasser"}),
    "Durch die Tuempel, die sich im Sand gebildet haben, riecht es hier "
    "nach Salzwasser, und zwar nach abgestandenem.");
  AddSpecialDetail(({"teil","teile","einzelteil","einzelteile"}),
    "detail_teil");
  AddSound ( ({"seite"}),
    "Auf dieser Seite der Insel ist es bedeutend ruhiger.");
	
  
  AddExit("nordwesten", "./d1_1");
  AddExit("sueden", "./e3_1");

  AddCmd( ({"konzentriere", "konzentrier"}), "cmd_konzentriere");
}

void reset()
{
	::reset();
	muschel = 1;
	AddDetail(({"etwas"}),
    "Du bueckst Dich und betrachtest das Etwas, auf das Du getreten bist. "
    "Es handelt sich um eine handtellergrosse Muschel, die in mehrere Teile "
    "zerbrochen ist.");
 }
 
string detail_teil ( string str )
{
  if (muschel)	
  {
    write(BS("Einer der Teile sieht sehr scharfkantig aus. Vielleicht kannst Du ihn "
          "ja noch brauchen? Du steckst ihn ein.\n"));

    say( TPN +" hebt etwas vom Boden auf.\n");
    clone_object(OBJ "muschel")->move(TP);
    muschel = 0;
	AddDetail ( ({"etwas"}),
	"Du bueckst Dich und betrachtest das Etwas, auf das Du getreten bist. Es "
	"handelt sich um die Ueberbleibsel einer zerbrochenen Muschel. Irgendjemand "
	"war erst vor kurzem hier. So verlassen, wie die Insel aussieht, ist sie wohl "
	"doch nicht.");
	AddDetail ( ({"ueberbleibsel"}),
	"Die kannst Du nicht brauchen.");
    return "";
  }
  else
  {
    write(BS("Nur noch ein paar kleinere Teile sind uebrig. Irgendjemand "
          "war vor schon Dir da. Schade, vielleicht haettest Du sie ja brauchen "
          "koennen.\n"));
    return "";
  }
}

int cmd_konzentriere (string str)
{
   notify_fail("Worauf moechtest Du Dich konzentrieren?\n");
   
   if((str=="auf boden") || (str=="dich auf boden"))
   {  
       write(BS("So klappt das nicht. Untersuche den Boden mal lieber.\n"));
       return 1;
   }
   return 0;
} 

