// By Kia@Silberland 5.2003

#include "../def.h"

#include "/sys/laden.h"

inherit "std/laden";

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]));
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp (P_SHOPKEEPER_ID, "turedian");
  SetProp (P_SHOPKEEPER_NAME, "der Ladenbesitzer");
  SetProp (P_SHOPKEEPER_GENDER, MALE);
  SetProp (P_INT_SHORT, "Im Schmugglerladen");
  SetProp (P_INT_LONG,
    "Diese kleine Hoehle ist unglaublich vollgestopft, sodass Du "+
    "fuerchtest, bei jeder Bewegung etwas umzustossen. Ueberall stehen "+
    "Vitrinen und Regale rum, die mit allerhand Krimskrams vollgestopft "+
    "sind. Ziemlich zentral steht ein alter, klappriger Ladentisch. Uber "+
    "alles liegt eine dicke Staubschicht, der Besitzer nimmt es mit "+
    "Sauberkeit wohl nicht so genau.");

  AddDetail ( ({"boden"}),
    "Der Boden ist, wie ueberall anders auch, mit Lehm geebntet worden. "+
    "Darueber wurde ein Teppich gelegt.");
  AddDetail ( ({"lehm"}),
    "Wenn man Lehm mit Wasser mischt, ergibt das eine Masse, die (nachdem "+
    "sie eingetrocknet ist) erstaunlich fest ist.");
  AddDetail ( ({"wasser"}),
    "Lehm und Wasser eignet sich ganz gut dazu, einen Boden einzuebnen.");
  AddDetail ( ({"masse"}),
    "Du trittst fest dagegen. Wirklich widerstandsfaehig, so ein Lehm.");
  AddDetail ( ({"teppich"}),
    "Ein widerstandsfaehiger Teppich aus Kokosfasern, der zwar nicht "+
    "unbedingt schmuck aussieht, aber einiges aushaelt.");
  AddDetail ( ({"fasern", "kokosfasern"}),
    "Kokosfasern sind rauh und werden normal bei Fussabstreifern "+
    "verwendet.");
  AddDetail ( ({"abstreifer", "fussabstreifer"}),
    "Hmm, eigentlich sieht der Teppich ja aus wie ein riesiger "+
    "Fussabstreifer.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind aus glattem, kalkigen Gestein.");
  AddDetail ( ({"gestein"}),
    "Die Waende sind hier glatter als am Gang, sehen aber dennoch so aus "+
    "als waeren sie natuerlichen Ursprungs.");
  AddDetail ( ({"gang"}),
    "Am Gang draussen sind die Waende nicht so glatt wie in dieser Hoehle.");
  AddDetail ( ({"ursprung"}),
    "Du glaubst, dass diese Hoehle nicht kuenstlich angelegt wurde, "+
    "sondern natuerlich entstanden ist.");
  AddDetail ( ({"decke"}),
    "Die Decke ist so niedrig, dass Du fast mit dem Kopf dagegenstoesst. "+
    "Du fuehlst Dich ein bisschen beengt.");
  AddDetail ( ({"bewegung"}),
    "Du bewegst Dich sicherheitshalber nur vorsichtig. Diese Hoehle ist so "+
    "vollgestopft, dass Du Dir vorkommst wie ein Elefant im Porzellanladen.");
  AddDetail ( ({"elefant"}),
    "Du kommst Dir ziemlich ungeschickt vor. Wie der sprichwoertliche "+
    "Elefant im Porzellanladen.");
  AddDetail ( ({"laden", "porzellanladen"}),
    "Eigentlich ist das hier ein ganz normaler Laden, aber kaputt machen "+
    "moechtest Du nichts.");
  AddDetail ( ({"vitrine", "vitrinen"}),
    "In einigen Vitrinen ist allerhand Krimskrams ausgestellt.");
  AddDetail ( ({"krimskrams"}),
    "Schwerter, Ruestungen und andere Dinge werden hier ausgestellt und "+
    "wohl auch verkauft.");
  AddDetail ( ({"ruestungen", "sachen", "schwerter"}),
    "Mit 'zeige' wird Dir alles aufgelistet, was man hier kaufen kann.");
  AddDetail ( ({"regale"}),
    "Weiter hinten stehen einige Regale, die ebenfalls vollgestopft sind. "+
    "Sie sind jedoch schon so verstaubt, dass Du nicht genau erkennen "+
    "kannst, was drauf ist.");
  AddDetail ( ({"regal"}),
    "Jedes einzelne von ihnen ist voll mit Krimskrams.");
  AddDetail ( ({"ladentisch", "tisch"}),
    "Ein alter Tisch steht mitten in der Hoehle. Er ist aus Eichenholz und "+
    "mit Metall beschlegen. Darauf steht eine altmodische Kassa.");
  AddDetail ( ({"eichenholz", "holz"}),
    "Das Eichenholz, aus dem der Ladentisch ist, muss schon sehr alt sein. "+
    "Es ist ganz dunkel verfaerbt.");
  AddDetail ( ({"metall"}),
    "Das Metall ist wohl zur Zierde da, denn einen besonderen Sinn scheint "+
    "es nicht zu haben.");
  AddDetail ( ({"zierde"}),
    "Naja, Geschmackssache...");
  AddDetail ( ({"geschmack", "geschmackssache"}),
    "Nicht ganz Dein Geschmack, aber na gut.");
  AddDetail ( ({"sinn"}),
    "Vielleicht liegt dahinter ja auch ein Sinn, der Dir verborgen bleibt.");
  AddDetail ( ({"kassa"}),
    "Eine altmodische Kassa, die immer klingelt wenn man einen Betrag "+
    "eintippt.");
  AddDetail ( ({"betrag"}),
    "Bei jedem Betrag, der eingetippt wird, klingelt die Kassa lautstark.");
  AddDetail ( ({"staubschicht"}),
    "Eine dicke Staubschicht bedeckt alles, nur der Tisch ist halbwegs "+
    "sauber. Er wird von allen Moebeln am meisten benutzt.");
  AddDetail ( ({"moebel"}),
    "Mehrere Vitrinen und Regale stehen herum, ausserdem ein alter "+
    "Ladentisch.");
  AddDetail ( ({"kopf"}),
    "Zwischen der Decke und Deinem Kopf ist schon noch ein bisschen "+
    "Abstand, aber Du fuehlst Dich dennoch eingeengt.");
  AddDetail ( ({"abstand"}),
    "Du hast dauernd das Gefuehl, Dir den Kopf anzustossen, so klein ist "+
    "der Abstand.");
  AddDetail ( ({"gefuehl"}),
    "Du ziehst den Kopf ein, denn Du fuehlst Dich beengt.");
  AddDetail ( ({"hoehle"}),
    "Diese Hoehle ist niedriger als der Gang und wird als Laden benutzt.");
  AddDetail ( ({"sauberkeit"}),
    "Sauberkeit hat hier keine sehr hohe Prioritaet.");
  AddDetail ( ({"prioritaeten"}),
    "Man muss Prioritaeten setzen! Hier wird vielleicht auf Anderes Wert "+
    "gelegt.");
  AddDetail ( ({"anderes"}),
    "Wer weiss?");
  AddDetail ( ({"staub"}),
    "Den gibts hier ueberall.");
  AddDetail ( ({"prioritaet", "prioritaeten"}),
    "Jeder setzt so seine Prioritaeten.");
  AddDetail ( ({"porzellanladen"}),
    "Das hier ist ein ganz normaler Laden, aber vielleicht gibts hier ja "+
    "auch Porzellan? Du koenntest den Besitzer ja mal fragen.");
  AddDetail ( ({"porzellan"}),
    "Wer weiss, vielleicht wird hier ja welches verkauft?");
  AddDetail ( ({"dinge"}),
    "Hier gibt es viele Dinge, die Du Dir mit 'zeige' auflisten lassen "+
    "kannst.");
	
	
  AddSmell ( ({DEFAULT_SMELL}),
    "Hatschi! Hier ist alles so staubig, dass Du sofort niessen musst, "+
    "wenn Du versuchst zu riechen!");
  AddSound ( ({DEFAULT_SOUND}),
    "Es herrscht eine angenehme Ruhe. Sogar Deine Schritte werden vom "+
    "Teppich gedaempft.");
  AddSound ( ({"ruhe"}),
    "Du geniesst die Ruhe... ");
  AddSound ( ({"schritte"}),
    "Nur ganz leise hoerst Du Deine eigenen Schritte.");
  AddSound ( ({"teppich"}),
    "Jedes Geraeusch, das Deine Schritte verursachen, wird von dem Teppich "+
    "gedaempft.");
  AddSound ( ({"geraeusch"}),
    "Du hoerst nicht viel, nur deine Schritte verursachen ein leises "+
    "Geraeusch.");
  
  
  AddItem(NPC "turedian",REFRESH_DESTRUCT,"");
 
  AddExit("sueden", "./mnpcd4_2");

  SetStorageRoom(ROOM "storage");

}

void reset()
{
// Messer und Seile werden aus dem Laden entfernt damit man nicht so leicht
// die Insel verlassen kann: beides kann jedoch erforscht werden (e2_1: Messer[Muschel],
// f4_1: Seil)
	object tempob;
	::reset();
	tempob = TO->FindInStore("messer");
	while (tempob != 0)
	{
		tempob->remove();
		tempob = TO->FindInStore("messer");
	}
		tempob = TO->FindInStore("seil");
	while (tempob != 0)
	{
		tempob->remove();
		tempob = TO->FindInStore("seil");
	}
}

