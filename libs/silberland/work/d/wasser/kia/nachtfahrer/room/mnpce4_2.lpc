// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  SetProp(P_INT_SHORT, "Im Hoehlensystem");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem hohen Gang im Inneren der Klippe. An den "
    "Waenden sind einige Fackeln angebracht, die alles in schummriges Licht "
    "tauchen. Belustigt betrachtest Du Deinen eigenen Schatten, der im "
    "Schein des Feuers auf und ab tanzt. Ein perfektes Versteck, wenn man "
    "etwas zu verbergen hat. Du kannst dem Gang in suedwestlicher Richtung "
    "folgen, oder den Klippenpfad im Suedosten betreten.");
  AddDetail(({"arm"}),
    "Dort, wo Du Dich gekniffen hast, kriegst Du sicher einen blauen Fleck.");
  AddDetail(({"boden"}),
    "Der Boden ist aus hartem Gestein. Die Zwischenraeume wurden mit Lehm "
    "ausgefuellt, sodass er halbwegs eben ist.");
  AddDetail(({"decke"}),
    "Hoch ueber Dir siehst Du die gewoelbte Decke. Wenn Du nach oben "
    "blickst, kommst Du Dir klein und unbedeutend vor. Ueberall haengen "
    "dicke Spinnweben.");
  AddDetail(({"fackelhalter","halter"}),
    "In den Fackelhaltern stecken kleine Fackeln, die den Gang erhellen.");
  AddDetail(({"fackeln"}),
    "Die Fackeln erhellen den Gang ein bisschen, gerade soviel dass Du "
    "erkennen kannst wo er hinfuehrt.");
  AddDetail(({"feuer"}),
    "Irgendjemand hat diese Fackeln angezunden, Du wuerdest zu gerne wissen "
	"wer das war.");
  AddDetail(({"fleck"}),
    "Noch ist nichts zu sehen, aber das kommt schon noch.");
  AddDetail(({"gang","gaenge"}),
    "Der Gang fuehrt quer durch die Klippe und ist von Nebenhoehlen "
    "gesaeumt.");
  AddDetail(({"gestein"}),
    "Du glaubst, dass es sich um kalkhaltiges Gestein handelt, jedenfalls "
    "fuehlt es sich so an.");
  AddDetail(({"hoehlensystem","hoehlen","system"}),
    "Ein Wirrwarr aus Hoehlen und Gaengen.");
  AddDetail(({"inneres"}),
    "Im inneren der Klippe befindet sich ein richtiges Hoehlensystem, das "
    "man von aussen gar nicht sieht.");
  AddDetail(({"insel"}),
    "Die Insel der Nachtfahrer.");
  AddDetail(({"klippe"}),
    "Von aussen sieht sie wie eine normale Klippe aus. Du haettest nie "
    "erwartet, darin so ein Wirrwarr aus Hoehlen und Gaengen zu finden!");
  AddDetail(({"lehm"}),
    "Festgestampfter Lehm haelt so einiges aus.");
  AddDetail(({"leiter"}),
    "Nicht einmal mit einer Leiter wuerdest Du so weit raufkommen, um die "
    "Spinnweben zu enfernen! Macht aber nichts, dort oben stoeren sie ja "
    "niemanden.");
  AddDetail(({"nachtfahrer"}),
    "Die Nachtfahrer haben sich ins Innere dieser Insel zurueckgezogen.");
  AddDetail(({"nebenhoehlen","nebenhoehle"}),
    "Ein paar kleinere Hoehlen biegen vom Gang ab.");
  AddDetail(({"pfad","klippenpfad"}),
    "Im Suedosten kannst Du dem Klippenpfad weiter folgen, waehrend dieser "
    "Gang tiefer in die Insel hinein fuehrt.");
  AddDetail(({"reichweite"}),
    "Die Decke ist so hoch oben, dass man selbst mit einer Leiter nicht "
    "raufkommt.");
  AddDetail(({"richtung"}),
    "Der Gang windet sich von hier nach Westen.");
  AddDetail(({"risse","riss"}),
    "Der Lehm ist schon etwas ausgetrocknet und von ein paar kleineren Rissen "
    "durchzogen. ");
  AddDetail(({"schatten"}),
    "Das Fackeln verbreiten ein flackerndes Licht. Die Schatten tanzen "
    "durcheinander wie ein richtiges Schattenspiel."  );
  AddDetail(({"schein"}),
    "Die Fackeln verbreiten ein angenehmes Licht, das den Gang aber "
    "irgendwie unwirklich aussehen laesst.");
  AddDetail(({"schiffe","schiff"}),
    "Der Steg wurde offensichtlich gemacht, damit groessere Schiffe anlegen "
	"koennen.");
  AddDetail(({"schiffsrouten","routen"}),
    "Du hast zwar draussen einen Steg gesehen, aber Du glaubst kaum, dass "
    "oeffentliche Schiffe hier anlegen. Sonst haette man den Steg ja nicht "
    "verstecken brauchen.");
  AddDetail(({"spinnweben"}),
    "An der Decke haengen ueberall dicke Spinnweben. Seltsam, weiter unten "
    "siehst Du keine mehr, wahrscheinlich hat jemand alle entfernt, die in "
    "seiner Reichweite waren.");
  AddDetail(({"steg"}),
    "Weiter unten, am Strand, ist ein Steg.");
  AddDetail(({"suedosten"}),
    "Im Suedosten kannst Du den Klippenpfad betreten.");
  AddDetail(({"suedwesten"}),
    "In suedwestlicher Richtung kannst Du dem Gang folgen.");
  AddDetail(({"unwirkliches"}),
    "Du kneifst Dir in den Arm. Autsch! Nein, Du traeumst nicht.");
  AddDetail(({"versteck"}),
    "Wahrlich, ein besseres Versteck koenntest Du Dir kaum vorstellen! "
    "Diese unheimliche Insel betritt wahrscheinlich keiner freiwillig, "
    "ausserdem liegt sie fern abseits der Schiffsrouten. Von aussen sieht "
    "sie voellig unbewohnt aus.");
  AddDetail(({"waende"}),
    "Die Waende bestehen aus natuerlichem Felsgestein und woelben sich "
    "leicht. Ueberall sind Fackelhalter angebracht.");
  AddDetail(({"westen"}),
    "Im Westen kannst Du weiter in die Klippe vordringen.");
  AddDetail(({"wirrwarr"}),
    "Verwirrend!");
  AddDetail(({"zwischenraeume","unebenheiten"}),
    "Saemtliche Unebenheiten wurden ausgebessert. Nur ein paar Risse haben "
    "sich gebildet.");
  AddDetail ( ({"felsgestein"}),
    "Du glaubst, dass es sich um kalkhaltiges Gestein handelt, jedenfalls "+
    "fuehlt es sich so an.");
  AddDetail ( ({"stein"}),
    "Der Stein verdeckt den Eingang halb. ");
  AddDetail ( ({"eingang"}),
    "Der Eingang befindet sich suedoestlich von Dir.");
  AddDetail ( ({"wand"}),
    "Ueberall an den Waenden sind Fackelhalter angebracht.");
  AddDetail ( ({"schattenspiel"}),
    "Die Schatten tanzen um Dich herum wie ein richtiges Schattenspiel. Am "+
    "liebsten wuerdest Du mitspielen.");
  AddDetail ( ({"strand"}),
    "Den kannst Du von hier aus nicht sehen.");
  AddDetail ( ({"innere", "inneres", "westen"}),
    "Im Westen kannst Du weiter ins Innere der Klippe vordringen.");
  AddDetail ( ({"licht"}),
    "Ein tanzendes Licht, das von den Fackeln kommt.");
  
  
  AddSound(DEFAULT_SOUND,
    "Du hoerst nichts ausser Deinen eigenen Schritten.");
  AddSound(({"echo"}),
    "*tapp* *tapp* Sicher kann man Dich schon von weitem kommen hoeren.");
  AddSound(({"schritte"}),
    "Deine Schritte hallen zwischen den Waenden wieder.");
  AddSound(({"waende"}),
    "Die Waende sind hoch und gewoelbt, sodass Deine Schritte ein leises "
    "Echo erzeugen.");
  AddSmell(DEFAULT_SMELL,
    "Im Hoehlensystem riecht es irgendwie muffig und abgestanden. Du bist "
    "Dir fast sicher, dass der Stein deshalb nicht ganz vor den Eingang "
    "gerollt wurde, um frische Luft hereinzulassen.");
  AddSmell(({"eingang"}),
    "Tatsaechlich! Vom Eingang aus weht ein frisches Lueftchen.");
  AddSmell(({"luft","lueftchen"}),
    "Die Luft hier herinnen ist alt und abgestanden, aber dadurch dass der "
    "Stein nicht ganz vorm Eingang liegt wird es hier wohl bald besser "
    "riechen.");
  

  AddExit("suedosten", "./mnpcf5_2");
  AddExit("westen", "./mnpcd4_2");
  
  AddCmd(({"spiele","spiel"}), "cmd_spiele");
}

int cmd_spiele (string str)


{
   notify_fail("Womit willst Du spielen? \n");

   if((str=="mit schatten") || (str=="schatten"))
   { 
       write(BS("Du formst Deine Haende zu einem Kaninchen *hoppel* \n"
                "Da kommt das Krokodil... HAPS das Kaninchen ist aufgegessen. "
                "Du erroetest und blickst Dich um. Hoffentlich hat niemand beobachtet, "
                "wie kindisch Du bist.\n"));
       say( TPN+ " macht mit den Haenden ein paar Verrenkungen "
           "und wirft lustige Tierschatten an die Wand. \n");
       return 1;
   }
   return 0;
} 
