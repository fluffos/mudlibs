// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"


void create()
{
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem");
  SetProp (P_INT_LONG,
    "Du befindest Dich mitten im Inneren der Klippe. Von hier aus kannst "+
    "Du den Eingang gar nicht mehr sehen. Ein paar Fackeln, die an der "+
    "Wand befestigt sind, beleuchten den Gang. Die Decke ist so hoch oben, "+
    "dass Du sie gar nicht mehr sehen kannst. Im Norden befindet sich "+
    "eine weitere kleine Hoehle, ueber der ein grosses, schoen verziertes "+
    "Schild haengt.");

  AddDetail ( ({"boden"}),
    "Der Lehm, mit dem der Boden geebnet wurde, ist vertrocknet und rissig "+
    "und gehoert dringend mal ausgebessert.");
  AddDetail ( ({"risse"}),
    "Der Lehm ist mit breiten Rissen durchzogen. Das sieht nicht sehr schoen "+
    "aus, ist aber eigentlich egal.");
  AddDetail ( ({"lehm"}),
    "Lehm hat eben den Vorteil, dass er nichts kostet, aber den Nachteil, "+
    "dass er nicht so besonders viel aushaelt.");
  AddDetail ( ({"nachteil", "vorteil"}),
    "Alles hat eben so seine Vor- und Nachteile.");
  AddDetail ( ({"decke"}),
    "Diese Hoehle ist so hoch und schlecht beleuchtet, dass Du die Decke "+
    "gar nicht sehen kannst, Nur ein kleines Funkeln ab und zu verraet Dir, "+
    "dass sie ueber Dir ist und manchmal den Schein der Fackeln "+
    "reflektiert.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende bestehen aus glattem Kalkgestein. Einige wenige Fackeln "+
    "stecken in Fackelhaltern, die an den Waenden befestigt sind.");
  AddDetail ( ({"felsgestein", "gestein"}),
    "Du legst beide Haende auf das Kalkgestein. Es greift sich kuehl und "+
    "glatt an.");
  AddDetail ( ({"haende"}),
    "Du betrachtest Deine Haende und plotzlich faellt Dir ein, was Du "+
    "damit schon alles angefasst hast. Angeekelt verscheuchst Du den "+
    "Gedanken.");
  AddDetail ( ({"gedanke", "gedanken"}),
    "Manchmal ist es besser, nicht so viel zu denken...");
  AddDetail ( ({"gang"}),
    "Der Gang geht von Nordosten nach Suedwesten quer durch die Klippe "+
    "durch.");
  AddDetail ( ({"norden"}),
    "Im Norden befindet sich ein Durchlass zu einer weiteren Hoehle.");
  AddDetail ( ({"durchlass"}),
    "Du kannst einfach ganz normal durchgehen.");
  AddDetail ( ({"kalkgestein"}),
    "Die Waende sind aus Kalkgestein, die Decke wahrscheinlich auch, aber "+
    "die siehst Du nicht.");
  AddDetail ( ({"funkeln"}),
    "Ab und zu blitzt es ueber Dir kurz auf.");
  AddDetail ( ({"fackelhalter"}),
    "Die Fackelhalter sind aus Metall. Hoelzerne Fackeln stecken darin, "+
    "die den Gang erhellen.");
  AddDetail ( ({"metall"}),
    "Eisen oder irgendetwas aehnliches.");
  AddDetail ( ({"eisen"}),
    "Dem Rost nach zu schliessen jedenfalls, der die Fackelhalter "+
    "ueberzieht.");
  AddDetail ( ({"rost"}),
    "Die Fackelhalter sind eindeutig schon aelter.");
  AddDetail ( ({"schild"}),
    "Ein schoen verziertes Schild, das Du lesen kannst.");
  AddDetail ( ({"eingang"}),
    "Du bist dem Eingang schon fern und siehst in von hier aus nicht mehr. "+
    "Das traegt nicht gerade zu Deinem Wohlbefinden bei.");
  AddDetail ( ({"wohlbefinden"}),
    "Hier, in diesem hoehen Gang, wo man den Eingang nicht mehr sehen "+
    "kann, fuehlst Du Dich nicht sonderlich wohl.");
  AddDetail ( ({"schein"}),
    "Der Schein truegt manchmal, und auch der Schein der Fackeln laesst "+
    "alles verzerrt und unwirklich aussehen.");
  AddDetail ( ({"fackel", "fackeln"}),
    "Die Fackeln erhellen Deine Umgebung gerade genug, dass Du erkennen kannst wo Du "
    "hinsteigst. Sie sind aus Holz und wurden in eine Fluessigkeit getaucht damit "
    "sie laenger brennen. ");
  AddDetail ( ({"umgebung"}),
    "Du bist von hohen Felswaenden umgeben.");
  AddDetail ( ({"klippe"}),
    "Ein komplettes Hoehlensystem ist geschickt in der Klippe versteckt.");
  AddDetail ( ({"hoehlensystem", "system"}),
    "Ein System aus Hoehlen, ein ideales Versteck wenn man was zu "+
    "verbergen hat.");
  AddDetail ( ({"versteck"}),
    "Wer sich hier wohl versteckt, und vor allem warum?");
  AddDetail ( ({"hoehle"}),
    "Der Gang ist gesaeumt von kleinen und grossen Hoehlen. Auch im Norden "+
    "befindet sich eine Hoehle, die Du betreten kannst.");
  AddDetail ( ({"hoehlen"}),
    "Du weisst nicht, wieviele Hoehlen es hier gibt, aber das ist auch "+
    "nicht so wichtig.");
  AddDetail ( ({"holz"}),
    "Wie die meisten Fackeln sind auch diese aus Holz.");
  AddDetail ( ({"fluessigkeit"}),
    "Du weisst nicht, was das fuer eine Fluessigkeit ist, aber sie riecht "+
    "komisch.");
  AddDetail ( ({"felswaende"}),
    "Die Waende bestehen aus glattem Kalkgestein. Einige wenige Fackeln "+
    "stecken in Fackelhaltern, die an den Waenden befestigt sind.");
  AddDetail ( ({"inneres"}),
    "Du befindest Dich mitten in der Klippe.");
	
	
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst nichts als Deine eigenen Schritte, die zwischen den Waenden "+
    "widerhallen.");
  AddSound ( ({"schritte"}),
    "Das Echo Deiner Schritte hallt zwischen den Waenden wider.");
  AddSound ( ({"echo"}),
    "Das Echo macht es unmoeglich, sich lautlos fortzubewegen.");
  AddSound ( ({"waende"}),
    "Die Waende geben kein Geraeusch von sich, aber sie verursachen ein "+
    "Echo Deiner Schritte.");
  AddSound ( ({"geraeusch"}),
    "Du hoerst kein Geraeusch, ausser das, das Du selbst verursachst.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Die Fackeln riechen irgendwie komisch.");
  AddSmell ( ({"fackeln"}),
    "Sie sind in irgendeine Fluessigkeit getaucht, damit sie laenger "+
    "brennen. Das verursacht einen komischen Geruch.");
  AddSmell ( ({"geruch"}),
    "Du ruempfst die Nase. Dieser Geruch behagt Dir gar nicht!");
  AddSmell ( ({"fluessigkeit"}),
    "Diese Fluessigkeit laesst die Fackeln laenger brennen. Du willst gar nicht "
    "wissen, um welche illegale Substanz es sich dabei handelt...");
  AddSmell ( ({"nase"}),
    "Eine Nase kann mitunter ganz praktisch sein.");
  

  AddExit ("nordosten", "./mnpcd4_2");
  AddExit ("suedwesten","./mnpcb6_2");
  AddExit ("norden","./mnpcc4_2");

  AddCmd(({"lies", "lese"}), "cmd_lies");


}

int cmd_lies (string str)
{
   notify_fail("Was moechtest Du lesen?\n");
   
   if((str=="schild"))
   {  
      write(BS("Auf dem Schild steht 'ANHEG' in Grossbuchstaben geschrieben.\n"));
      return 1;
   }
   return 0;
} 

