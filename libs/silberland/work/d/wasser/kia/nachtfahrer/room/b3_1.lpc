// By Kia@Silberland 5.2003

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_WATER]));
  SetProp (P_INT_SHORT, "Am Sandstrand");
  SetProp (P_INT_LONG,
    "Du stehst vor einer zerkluefteten Felswand, die viele Risse und "+
    "Spalten aufweist. Der Strand hat sich zu einem engen Streifen "+
    "verengt, und obwohl Du eng an die Klippe gepresst dastehst, kommen "+
    "Dir die Wellen gefaehrlich nahe. Grosse Felsbloecke bedecken den "+
    "Boden und lassen Dich immer wieder stolpern, denn im spaerlichen "+
    "Licht des Mondes kannst Du nicht viel erkennen.");
 

  AddDetail ( ({"felswand", "wand"}),
    "Die Felswand ist voller Risse und Spalten. Als geuebter Kletterer "+
    "kommst Du vielleicht hinauf.");
  AddDetail ( ({"risse"}),
    "Viele Risse befinden sich in der Felswand. Sie wuerden Dir einen "+
    "Aufstieg sehr erleichtern. ");
  AddDetail ( ({"spalten"}),
    "Mithilfe der Spalten in der Felswand kannst Du sehr bequem "+
    "aufsteigen. Du koenntest versuchen, hinaufzuklettern.");
  AddDetail ( ({"boden"}),
    "Du stehst vor der Felswand auf einem winzigschmalen Sandstreifen. Eng "+
    "an die Felsen gepresst stehst Du nun da und wartest auf Dein "+
    "Schicksal.");
  AddDetail ( ({"schicksal"}),
    "Dein Schicksal wird schon noch kommen!");
  AddDetail ( ({"kletterer"}),
    "Der letzte Kletterer der hier das Abenteuer gewagt hat duerfte wohl "+
    "klaeglich verendet sein. Du siehst noch seine Ueberreste im Fels "+
    "haengen.");
  AddDetail ( ({"wellen"}),
    "Die Wellen sind Dir gefaehrlich nahe. Du presst Dich eng "+
    "an die Felsen, um nicht Opfer des Meeres zu werden.");
  AddDetail ( ({"licht"}),
    "Im spaerlichen Licht des Mondes kannst Du nicht viel erkennen.");
  AddDetail ( ({"bloecke", "fels", "felsbloecke"}),
    "Rund um Dich befinden sich grosse Felsbloecke. Du findest es muehsam, "+
    "den Weg dazwischen zu finden.");
  AddDetail ( ({"abenteuer"}),
    "So manches Abenteuer hast Du schon bestanden, mach jetzt bloss nicht "+
    "schlapp.");
  AddDetail ( ({"meer"}),
    "Das Meer sieht sehr unruhig aus. Dass Du bloss nicht hineinfaellst!");
  AddDetail ( ({"aufstieg"}),
    "Dieser Aufstieg waere sicher nicht ganz ungefaehrlich, aber mit "+
    "einem Seil koenntest Du es wagen.");
  AddDetail ( ({"opfer"}),
    "Wenn Dich das Meer einmal hat, laesst es Dich nicht mehr so leicht "+
    "los.");
  AddDetail ( ({"mond"}),
    "Es ist ziemlich dunkel, nur der Mond erhellt alles ein bisschen.");
  AddDetail ( ({"pfad", "weg"}),
    "Der Weg fuehrt wieder zurueck zum Bootsanlegeplatz.");
  AddDetail ( ({"anlegeplatz", "bootsanlegeplatz"}),
    "Dort bist Du gelandet. Er befindet sich nordoestlich von Dir.");
  AddDetail ( ({"gipfel"}),
    "Der Gipfel ist weiter oberhalb von Dir.");
  AddDetail ( ({"sandstrand", "strand"}),
    "Trotz der paar Felsbrocken, die herumliegen, kann man das immer noch "+
    "als Sandstrand bezeichnen.");
  AddDetail ( ({"himmel"}),
    "Der Himmel ist vor Wolken arg zerfurcht und zerpfluegt. Du kannst gar "+
    "nicht viel erkennen, ausser dass der Mond gerade am Vollwerden ist.");
  AddDetail ( ({"wolken"}),
    "Die Wolken werfen einen bedrohlichen Schatten auf den Sand und lassen "+
    "Dich erschaudern. Vielleicht erinnern Dich die Formen sogar an "+
    "bestimmte Sachen!?");
  AddDetail ( ({"sachen", "schatten"}),
    "Die Schatten der Formen erinnern Dich an exotische Tiere, die Du "+
    "schon mal gesehen haben musst, sonst wuesstest Du nichts davon...");
  AddDetail ( ({"tiere"}),
    "Selbst exotische Tiere findest Du im Silberland weit verstreut.");
  AddDetail ( ({"formen"}),
    "Die Formen der Schatten erinnern Dich an bestimmte Sachen.");
  AddDetail ( ({"sand"}),
    "Du bueckst Dich und pruefst den Rieselgrad des Sandes. Zufrieden "+
    "stehst Du wieder auf.");
  AddDetail ( ({"grad", "rieselgrad"}),
    "Der Sand rieselt fast reibungslos durch Deine Finger.");
  AddDetail ( ({"gegend"}),
    "Du laesst Deinen Blick kurz durch die Gegend schweifen und stellst "+
    "fest, dass es hier ziemlich unheimlich aussieht.");
  AddDetail ( ({"blick"}),
    "Dass das hier keine Gegend zum Wohlfuehlen ist, kannst Du auf einen "+
    "Blick erfassen.");
  AddDetail ( ({"stueckchen"}),
    "An den Felsen, an die Du Dich anpresst, ist noch ein Stueckchen Weg "+
    "und damit auch Gelaende, wo sich Leute aufhalten koennen.");
  AddDetail ( ({"ausfluegler", "leute"}),
    "Leute? Ausfluegler? Keine hier, oder?");
  AddDetail ( ({"gelaende"}),
    "In diesem Gelaende bist Du vor Ausflueglern sicher...");
  AddDetail ( ({"klippe", "klippen"}),
    "Die Insel, deren Namen Du noch nicht herausgefunden hast, scheint "+
    "fast ausschliesslich aus Klippen zu bestehen.");
  AddDetail ( ({"insel"}),
    "Du denkst kurz nach und bemerkst, dass Du Dich auf einer Insel mitten "+
    "im Meer befindest.");
  AddDetail ( ({"name"}),
    "Du meinst den Namen der Insel? Vielleicht solltest Du einen Bewohner "+
    "danach fragen?");
  AddDetail ( ({"bewohner"}),
    "Wenn es keine gibt wird Dir auch niemand sagen koennen wo Du bist.");
  AddDetail ( ({"reste", "ueberreste"}),
    "Der letzte Abenteurer, der versucht hat, den Gipfel zu erklimmen, ist "+
    "gescheitert. Du bekommst Mitleid mit dem armen Kerl.");
  AddDetail ( ({"abenteurer", "kerl"}),
    "Der arme Kerl! Zuerst klettert er so weit nach oben und dann "+
    "verhungert er einfach.");
  AddDetail ( ({"mitleid"}),
    "Eine echt traurige Geschichte, aber ungeschehen machen kannst Du es "+
    "ohnehin nicht mehr.");
  AddDetail ( ({"finger"}),
    "Deine Finger sind jetzt sandig, das hast Du davon.");
  AddDetail ( ({"silberland"}),
    "Im Silberland bist Du doch ein wenig zuhause, oder?");
  AddDetail ( ({"seil"}),
    "Sowas sollte man immer dabei haben!");
  AddDetail ( ({"sandstreifen", "streifen"}),
    "Der Sandstreifen ist breit genug fuer Dich.");
  AddDetail ( ({"brocken", "felsbrocken"}),
    "Die liegen immer dort, wo sie gerade nicht liegen sollen.");
  AddDetail ( ({"geschichte"}),
    "Leider ist er nicht mehr faehig, Dir seine Geschichte selbst zu "+
    "erzaehlen...");
   AddDetail ( ({"felsen"}),
    "Die Felsen und das Meer sind eindeutig zu nahe beisammen fuer Deinen "+
    "Geschmack.");
  AddDetail ( ({"geschmack"}),
    "Wenns nach Dir ginge koennten die ruhig weiter auseinander sein.");
  AddDetail ( ({"wasser"}),
    "Die Insel ist tatsaechlich von Wasser umgeben.\n");
	
  AddSmell ( ({DEFAULT_SMELL}),
    "Es riecht nach Verwesung.");
  AddSmell ( ({"verwesung"}),
    "Irgendetwas oder irgendwer verwest hier. Du kannst es ganz deutlich "+
    "riechen.");
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst nicht viel. Wind und Meer sind so laut, dass sie alles "+
    "andere uebertoenen.");
  AddSound ( ({"wind"}),
    "Der Wind zerrt an Deinen Haaren und bringt Dich fast zur "+
    "Verzweiflung.");
  AddSound ( ({"haare"}),
    "Deine Haare rascheln lautstark, da der Wind sie so zaust.");
  AddSound ( ({"wind"}),
    "Der Wind, der Wind, das himmlische Kind...");
  AddSound ( ({"kind"}),
    "Der Wind heult und jammert und klingt dabei wie ein flennendes Kind. "+
    "Das raubt Dir noch den letzten Nerv!");
  AddSound ( ({"nerv"}),
    "Du raufst Dir entnervt die Haare.");
  AddSound ( ({"meer"}),
    "Das Meer tobt und brodelt lautstark.");

  AddExit("nordosten", "./c2_1");

  AddCmd(({"kletter", "klettere"}), "cmd_kletter");
}

int cmd_kletter (string str)


{
   notify_fail("Wo willst Du raufklettern?\n");
   
   if( (str=="rauf") || (str=="hinauf") || (str=="auf klippe") || (str=="auf felswand") ||
       (str=="auf wand") )
   {   write(BS("Bei genauerer Betrachtung stellst Du fest, dass Du den "
                "Aufstieg ohne Seil nicht wagen willst. Schliesslich hast Du "
			    "keine Lust so zu enden, wie der arme Kerl, der in der Klippe "
				"haengt.\n" ));
	   return 1;
   }

   if( (str=="mit seil rauf") || (str=="mit seil hinauf") || (str=="mit seil auf klippe") ||
       (str=="mit seil auf felswand") || (str=="mit seil auf wand") )
   { 
	   if( present( "seil", TP ) )
	   {   TP->move(ROOM "b4_3",M_GO,"die Klippe hinauf","klettert",
		     "kommt von unten heraufgeklettert");
           return 1;
       }
	   else
	   {
	       write(BS("Aber Du hast ja gar kein Seil!"));
	       return 1;
	   }
   }
   return 0;
}
