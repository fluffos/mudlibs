// By Kia@Silberland 5.2003
// Hier kann man die Schmugglerinsel verlassen.

inherit "std/room";

#include "../def.h"

void create()
{
  ::create();
  
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_WATER]));
  SetProp (P_INT_SHORT, "Am Sandstrand, Bootsanlegeplatz");
  SetProp (P_INT_LONG,
    "Du stehst auf einem breiten Stueck Sandstrand einer verlassenen "+
    "Insel, zumindest kannst Du von hier aus keine Menschenseele "+
    "entdecken. Hier herrscht Daemmerlicht, und Deine Augen brauchen eine "+
    "Weile bis sie sich an die Dunkelheit gewoehnen. Trotzdem traust Du "+
    "Dich kein Licht anzumachen. Die Insel scheint sehr felsig zu sein, "+
    "denn dunkle Klippen heben sich gegen den Nachthimmel ab. Der "+
    "Sandstreifen wird zu beiden Seiten immer schmaeler und verliert sich "+
    "hinter Dir im Meer.");

  AddDetail ( ({"sand"}),
    "Du laesst den Sand durch Deine Finger rieseln. Er ist noch warm, da "+
    "er das Sonnenlicht tagsueber speichert.");
  AddDetail ( ({"sandstreifen", "streifen"}),
    "Der Sandstreifen wird zu beiden Seiten immer schmaeler.");
  AddDetail ( ({"seiten"}),
    "Mit den beiden Seiten ist Suedwesten und Suedosten gemeint.");
  AddDetail ( ({"suedosten"}),
    "Im Suedosten wird der Strand immer felsiger.");
  AddDetail ( ({"suedwesten"}),
    "Im Suedwesten bleibt der Sand schoen feinkoernig.");
  AddDetail ( ({"menschenseele", "seele"}),
    "Unheimlich ruhig ist es hier. Anscheinend bist Du auf dieser Insel "+
    "ganz allein.");
  AddDetail ( ({"insel"}),
    "Die Insel ist Dir nicht ganz geheuer. Die schroffen Klippen haben "+
    "etwas Bedrohliches an sich, und in dem Daemmerlicht findest Du Dich "+
    "nur schwer zurecht.");
 AddDetail ( ({"bedrohliches"}),
    "Du fuehlst Dich nicht besonders wohl.");
  AddDetail ( ({"daemerlicht", "licht"}),
    "Du siehst zwar niemanden, traust Dich aber trotzdem kein Licht "+
    "anzumachen. Irgendwie fuehlst Du Dich unwohl, als wuerde Dich wer "+
    "beobachten.");
  AddDetail ( ({"felsen", "klippen","klippe"}),
    "Die Klippen sieht man als schwarzen Schatten, der sich gegen den "+
    "Nachthimmel abhebt. Ihre zerklueftete Form kann man nur erahnen.");
  AddDetail ( ({"form"}),
    "Die Form kommt vom Wind, den Du oben auf den Klippen "+
    "deutlich heulen hoerst.");
  AddDetail ( ({"meer"}),
    "Das Meer ist ueberraschend ruhig, aber weisse Gischt kroent die sich "+
    "brechenden Wellen. Trotz der Dunkelheit, die hier herrscht, glitzert "+
    "und funkelt es. Weiter draussen faellt Dir ein dunkler Fleck auf.");
  AddDetail ( ({"fleck"}),
    "Bei diesem dunklen Fleck koennte es sich um ein Boot handeln...");
  AddDetail ( ({"boot","ruderboot"}),
    "Tatsaechlich! Ein kleines Ruderboot. Gut, dass Du es entdeckt hast, "
    "denn damit kannst Du zurueckrudern.");
  AddDetail ( ({"himmel", "nachthimmel"}),
    "Am Himmel tuermen sich hohe, duenne Wolken auf. Kein einziger Stern "+
    "ist zu sehen, nur der Mond verbreitet ein wenig Licht.");
  AddDetail ( ({"mond"}),
    "Der Mond ist fast voll und spiegelt sich im Meer wieder.");
  AddDetail ( ({"augen"}),
    "Deine Augen sind helles Licht gewoehnt und brauchen eine Weile, bis "+
    "sie sich in der Daemmerung zurechtfinden.");
  AddDetail ( ({"weile"}),
    "Du kannst nicht genau sagen, wie lange es dauert, denn hier auf der "+
    "Insel verlierst Du jegliches Zeitgefuehl.");
  AddDetail ( ({"gefuehl", "zeitgefuehl"}),
    "Du bist innerlich sehr angespannt und weisst darum nicht einmal, wie "+
    "lange Du schon auf der Insel bist. Dir kommt es wie eine Ewigkeit vor, "+
    "aber wahrscheinlich bildest Du Dir das nur ein.");
  AddDetail ( ({"brechen"}),
    "Die Wellen rollen auf den Strand zu und brechen dann, wobei die "+
    "Gischt hoch in die Luft gewirbelt wird.");
  AddDetail ( ({"luft"}),
    "Die Luft riecht ganz anders als am Festland, und sie scheint voller "+
    "kleinster Wassertropfen zu sein. Wenn Du hier noch laenger stehen "+
    "bleibst bist Du bald ganz durchnaesst.");
  AddDetail ( ({"tropfen", "wassertropfen"}),
    "Kleinste Wassertropfen wirbeln durch die Luft und bedecken Deine Haut "+
    "mit einer Salzkruste.");
  AddDetail ( ({"haut"}),
    "Du leckst an Deiner Haut und stellst fest, dass sie salzig schmeckt.");
  AddDetail ( ({"dunkelheit"}),
    "Hier ist es ziemlich dunkel, nur der Mond spendet ein bisschen Licht.");
  AddDetail ( ({"ewigkeit"}),
    "Es kommt Dir vor als waere eine Ewigkeit vergangen, seit Du mit "+
    "Deinem Boot hier gelandet bist. Aber ganz so lang wirds schon nicht "+
    "gewesen sein.");
  AddDetail ( ({"festland", "land"}),
    "Am liebsten wuerdest Du so schnell wie moeglich wieder zurueck zum "+
    "Festland rudern.");
  AddDetail ( ({"gischt"}),
    "Schaeumende Gischt kroent die Wellen und wird hoch in die Luft "+
    "geschleudert, wenn sie brechen.");
  AddDetail ( ({"wolken"}),
    "Die Wolken tuermen sich auf und verheissen nichts Gutes. Du kennst "+
    "Dich bei sowas zwar nicht aus, kannst Dir aber gut vorstellen dass "+
    "bald ein Sturm kommt.");
  AddDetail ( ({"gutes"}),
    "Also ein Sturm waere bestimmt nichts Gutes.");
  AddDetail ( ({"sturm"}),
    "Der wuerde Dich einfach von der Insel fegen, also beeil Dich mal.");
  AddDetail ( ({"wellen"}),
    "Die Wellen sind nicht hoch, verursachen aber dennoch ein Tosen.");
  AddDetail ( ({"ruhe"}),
    "Manche Leute waeren heilfroh, so eine Ruhe geniessen zu koennen. Aber "+
    "Dir behagt das gar nicht.");
  AddDetail ( ({"leute"}),
    "Du gehoerst definitiv nicht dazu.");
  AddDetail ( ({"salat"}),
    "Du fragst Dich, wie man etwas essen kann, das so riecht. Du bist Dir "+
    "sicher, dass Du so etwas nie anruehren wuerdest!");
  AddDetail ( ({"sand", "sandstrand"}),
    "Der Strand besteht aus Sand, vermischt mit ein paar Felsbrocken. "+
    "Weiter suedostlich wird er dann immer felsiger.");
  AddDetail ( ({"brocken", "felsbrocken"}),
    "Die sind wohl von den Klippen runtergefallen. Du kannst nur hoffen, "+
    "dass Dir kein solcher Brocken auf den Kopf faellt.");
  AddDetail ( ({"schatten"}),
    "Das Licht des Mondes wirft unheimliche Schatten. Sie sehen aus, als "+
    "wuerden sie sich bewegen.");
  AddDetail ( ({"stern"}),
    "Kein einziger Stern ist da, an dem Du Dich orientieren koenntest. Du "+
    "wirst Dich vollkommen auf Dein Gefuehl verlassen muessen.");
  AddDetail ( ({"gefuehl"}),
    "Dein Gefuehl sagt Dir, dass Du nicht allein bist, obwohl Du niemanden "+
    "sehen kannst. ");
  AddDetail ( ({"kruste", "salzkruste"}),
    "Wenn Salzwasser auf der Haut trocknet, bildet sich eine Salzkruste. "+
    "Das ist nicht gefaehrlich, aber dennoch unangenehm. Mit Suesswasser "+
    "kann man sie wieder abwaschen.");
  AddDetail ( ({"haut"}),
    "Wenn sich darauf eine Salzkruste bildet, ziept das unangenehm.");
  AddDetail ( ({"salzwasser", "wasser"}),
    "Daran mangelt es hier nicht, das Meer ist voll davon.");
  AddDetail ( ({"suesswasser"}),
    "Leider findest Du hier kein Suesswasser, um eine Salzkruste "+
    "abzuwaschen, aber wenn Du schnell genug bist wird das auch gar nicht "+
    "notwengig sein.");
  AddDetail ( ({"finger", "nachzaehlen"}),
    "Du verknotest Deine Finger beim Nachzaehlen, ob noch alle da sind. "+
    "Aua!");
  AddDetail ( ({"kopf"}),
    "Wenn Du nickst, merkst Du gleich ob Dein Kopf noch da ist.");
  AddDetail ( ({"sand", "sandstrand", "strand"}),
    "Der Strand besteht aus Sand, vermischt mit ein paar Felsbrocken. "+
    "Weiter suedoestlich wird er dann immer felsiger.");
  AddDetail ( ({"sand"}),
    "Du laesst den Sand durch Deine Finger rieseln. Er ist noch warm, da "+
    "er das Sonnenlicht tagsueber speichert.");
  AddDetail ( ({"sonnenlicht"}),
    "Ob dieser Strand schon jemals Sonnenlicht gesehen hat? ");
  AddDetail ( ({"boden"}),
    "Ein paar Felsbrocken liegen am Boden herum. Ansonsten siehst Du nur "+
    "Sand.");
  AddDetail ( ({"daemmerlicht", "daemmerung"}),
    "Es ist nicht richtig dunkel, aber auch nicht richtig hell.");
  AddDetail ( ({"stueck"}),
    "Es ist daemmrig, und von dem Sandstrand siehst Du nur ein Stueck. Was "+
    "weiter suedoestlich und suedwestlich ist, kannst Du nicht genau "+
    "erkennen.");
  AddDetail ( ({"tosen"}),
    "Dem Tosen kannst Du lauschen. Sehen kannst Du es nicht.");
  AddDetail ( ({"glitzern","funkeln"}),
    "Bis auf einen dunklen Fleck weiter draussen glitzert und funkelt das Meer. "
	"Wie romantisch, hach!");
	
  AddSound ( ({DEFAULT_SOUND}),
    "Eine unangenehme Ruhe herrscht hier. Du schauderst. Nur das Tosen der "+
    "Wellen und der Wind, der um die Klippen heult, sind zu hoeren.");
  AddSound ( ({"rauschen", "tosen", "wellen"}),
    "Obwohl es hier fast windstill ist, hoert sich das Rauschen der Wellen "+
    "wie ein Tosen an. Wahrscheinlich, weil sonst nicht viel zu hoeren ist.");
  AddSound ( ({"heulen"}),
    "Etwas weiter oben hoerst du den Wind heulen, aber hier ist es fast windstill.");
  AddSound ( ({"ruhe"}),
    "Bis auf das Tosen der Wellen und den Wind ist es ruhig.");
  AddSound ( ({"wind", "klippen"}),
    "Der Wind heult um die Klippen, aber hier unten ist es fast windstill. "+
    "Irgendwie unheimlich.");
  AddSmell ( ({DEFAULT_SMELL}),
    "Der aufdringliche Geruch von Salzwasser liegt in der Luft. Ausserdem "+
    "riecht es hier nach Seetang.");
  AddSmell ( ({"geruch", "salzwasser", "wasser"}),
    "Beim Brechen der Wellen spritzt die Gischt hoch, darum kannst Du das "+
    "Salzwasser ganz deutlich riechen.");
  AddSmell ( ({"seetang", "tang"}),
    "Irgendwo hast Du mal gelesen, aus Seetang kann man Salat machen. "+
    "Igitt! Du wuerdest nie etwas essen, das so riecht.");
  
  AddCmd ( ({"ruder","rudere"}), "cmd_ruder"); 
  AddCmd ( ({"iss"}), "cmd_iss");
  AddCmd ( ({"nicke", "nick", "ja", "jae"}), "cmd_nicke");

  AddExit ("suedosten", "./e2_1");
  AddExit ("suedwesten", "./c2_1");

}
// Falls das Objekt kompass.c im Inventar:
seq1()  {
  write(BS("Du watest durch das eiskalte Wasser und hievst Dich in das kleine "
        "Boot.\n"));
  call_out("seq2",5);
}
seq2()  {
  write(BS("Was fuer ein Glueck, dass es hier herumtrieb, denn Du willst nur noch "
        "weg von diesem grauenhaften, dunklen Ort!\n"));
  call_out("seq3",8);
}
seq3()  {
  write(BS("Vom Gipfel aus hast Du in etwa ausmachen koennen, in welche Richtung "
        "Du Dich halten musst, und zielstrebig ruderst Du dorthin, wo Du das "
        "Fischerdorf vermutest.\n")); 
  call_out("seq4",11);
}
seq4()  {
  write(BS("Der starke Wind, der Dir das Vorwaertskommen anfangs noch sehr schwer "
        "macht, wird zunehmend schwaecher und reduziert sich letztendlich auf "
        "ein angenehmes, kuehlendes Lueftchen, das Dir uebers Gesicht "
        "streicht.\n")); 
  call_out("seq5",11);
}
seq5()  {
  write(BS("Auch die dunklen Wolken reissen immer mehr auf und geben den Blick "
        "auf den strahlend blauen Himmel frei.\n")); 
  call_out("seq6",8);
}
seq6()  {
  write(BS("Unfassbar, wie schnell sich Deine Umgebung veraendert hat. Du hast es "
        "jetzt gar nicht mehr so eilig und faengst an, Deine kleine Seefahrt zu "
        "geniessen.\n")); 
  call_out("seq7",9);
}
seq7()  {
  write(BS("Ploetzlich taucht am Horizont das andere Ufer auf.\n")); 
  call_out("seq8",6);
}
seq8()  {
  write(BS("Du aenderst Deine Richtung ein wenig und steuerst darauf zu. Jetzt "
        "kannst Du auch schon das Fischerdorf mit seinen roten Daechern "
        "ausmachen.\n"));
  call_out("seq9",6);
}
seq9()  {
  write(BS("Nach wenigen Minuten hast Du endlich den Strand erreicht, von dem aus "
        "Du losgezogen bist. \n")); 
  call_out("seq10",6);
}
seq10() {
  write(BS("Erleichtert steigst Du aus dem Boot.\n")); 
  call_out("seq11",4);
}
seq11() {
  TP->move(ROOM "fischerdorf",M_NOCHECK | M_SILENT);
  //TP->SetProp(P_PARALYZED, 0);
}

// Falls das Objekt kompass.c nicht im Inventar:
seq12() {
  write(BS("Du watest durch das eiskalte Wasser und hievst Dich in das kleine "
        "Boot.\n")); 
  call_out("seq13",6);
}
seq13() {
  write(BS("Was fuer ein Glueck, dass es hier herumtrieb, denn Du willst nur noch weg "
        "von diesem grauenhaften, dunklen Ort!\n")); 
  call_out("seq14",8);
}
seq14() {
  write(BS("Du reisst die Ruder an Dich und ruderst wild drauflos.\n")); 
  call_out("seq15",9);
}
seq15() {
  write(BS("Ploetzlich wird Dir bewusst, dass Du keine Ahnung hast, in welcher "
        "Richtung das Fischerdorf liegt.\n")); 
  call_out("seq16",8);
}
seq16() {
  write(BS("Du ueberlegst, ob Du von dem Gipfel der Klippe aus vielleicht ausmachen "
        "koenntest, wohin Du ungefaehr rudern musst.\n")); 
  call_out("seq17",9);
}
seq17() {
  write(BS("Von hier aus ist es jedenfalls hoffnungslos. Bis auf die Umrisse der "
        "Insel, auf der Du gerade warst, und jeder Menge Wasser ist nichts zu "
        "sehen.\n")); 
  call_out("seq18",7);
}
seq18() {
  write(BS("Resigniert machst Du Dich auf den Rueckweg.\n")); 
  call_out("seq19",6);
}
seq19() {
  TP->move(ROOM "d1_1",M_NOCHECK | M_SILENT);
  //TP->SetProp(P_PARALYZED, 0);
}


int cmd_ruder (string str)
{
  object ob;
  notify_fail("Womit moechtest Du rudern?\n");

  if((str=="mit boot") || (str=="boot") || (str=="mit ruderboot") || (str=="ruderboot") ||
     (str=="mit ruderboot zurueck") || (str=="mit boot zurueck") || (str=="zurueck"))
  {  
    if(!(present("\n_kompass",TP) == 0))
    {
      ob = present("\n_kompass",TP);
      ob->remove();

      //TP->SetProp(P_PARALYZED, -1);
      call_out("seq1",0);
	  TP->move(ROOM "boot",M_NOCHECK | M_SILENT | M_NO_SHOW);
      return 1;
    }
    else
    {
      //TP->SetProp(P_PARALYZED, -1);
	  call_out("seq12",0);
      TP->move(ROOM "boot",M_NOCHECK | M_SILENT | M_NO_SHOW);
      return 1;
    }
  }
  return 0;
}


int cmd_iss (string str)
{
   notify_fail("Was moechtest Du essen?\n");
   
   if((str=="tang") || (str=="seetang"))
   {  
       
       write(BS("Du nimmst ein Stueckchen Seetang und betrachtest es argwoehnisch. "
	            "Schliesslich wagst Du es, ein klitzekleines bisschen davon in den "
	            "Mund zu stecken. Leider schmeckt es nicht besser als es riecht... "
                "Angeekelt spuckst Du es wieder aus. \n"));
       say( TPN + " wird ganz gruen im Gesicht und spuckt auf den Boden.\n");
       return 1;
   }
   return 0;
} 

int cmd_nicke (string str)
{
   
   {  
      write(BS("Du nickst vorsichtig. Alles noch dran.\n"));
      say( TPN + " nickt probeweise mit dem Kopf.\n");
      return 1;
   }
   return 0;
} 
	         
