// By Kia@Silberland 5.2003
// Von Rokko kann man sich das Boot leihen, mit dem man zur Insel kommt

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit "std/npc";

create()
{
  if (!is_clone(this_object())) return;
  seteuid(getuid(this_object()));

  ::create();

  SetProp(P_SHORT, "Rokko, der Schmugglerjunge");
  SetProp(P_LONG,
          "Rokko ist entweder sehr braungebrannt oder sehr schmutzig. Zwischen den schwarzen "
          "Fransen, die sein Gesicht umrahmen, blitzen zwei freche Augen hervor. "
		  "Eine viel zu grosse Kapitaensmuetze haengt ihm tief in die Stirn. Wo "
		  "er die wohl aufgegabelt hat... " 
		  "Er steht hier am Strand herum und passt auf die kleinen Boote auf.");
  AddDetail(({"fransen", "stirnfransen"}),
    "Du kannst die Farbe seiner Fransen nicht genau definieren, weil sie so schmutzig sind. "
	"Aber sie sind wohl irgendetwas zwischen dunkelbraun und schwarz.");
  AddDetail(({"gesicht"}),
    "Von Rokkos Gesicht sieht man eigentlich nicht viel, weil seine Fransen viel davon verdecken. ");
  AddDetail(({"muetze","kapitaensmuetze"}),
    "Du willst wissen woher Rokko die hat? Dann frag ihn am besten selber.");
  AddDetail(({"augen"}),
    "Viel von ihnen sieht man ja nicht, aber ab und zu blitzen sie zwischen den Stirnfransen hervor. ");
  AddDetail(({"farbe"}),
    "Irgendeine dunkle Farbe, welche laesst sich nicht so genau sagen.");
  SetProp(P_WEIGHT, 45000);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Rokko");
  SetProp(P_GENDER, MALE);
  AddId(({"rokko", "schmugglerjunge", "junge", "NOWIMPY"}));
  create_default_npc(16);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_SPELLRATE, 20);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 155);
  SetProp(P_DEFAULT_INFO, ({
          "sagt stolz: Ich bin der geborene Kapitaen!\n",
          "blickt beschaemt auf den Boden.\n",
          "fragt Dich: Woher soll ich denn das herkriegen?\n",
		  "lacht: Soll das etwa das geheime Codewort sein?\n" }));
  SetProp(P_HANDS, ({" mit geschickten Fingern", 30, DT_BLUDGEON}));
  
  SetProp( P_REJECT, ({ REJECT_DROP, "Rokko sagt: Ach, behalt doch Deinen Krempel!\n" }));

  AddInfo("rokko",
          "Tja, man kann sich seinen Namen nicht aussuchen.", "sagt: ");
  AddInfo(({"kapitaensmuetze","muetze"}),
          "Die hat mir ein Kapitaen geschenkt, weil ich so eine grosse Klappe hab und ihm "
		  "unabsichtlich das Codewort verraten hab. ",
		  "antwortet: ");
  AddInfo(({"klappe"}),
          "Naja, ich hab auf ihn gedeutet und gemeint er ist das Codewort...","sagt kleinlaut: ");
  AddInfo("schmuggler",
          "Psst, darueber kann ich Dir nix verraten! Das ist streng geheim.",
          "fluestert: ");
  AddInfo(({"schmugglerinsel", "insel", "inseln"}),
          "Wenn man hier in der Naehe vom Strand mit einem Boot wegfaehrt,"
          " so gelangt man recht schnell zur Schmugglerinsel.", "meint: ");
  AddInfo(({"boote", "boot", "ruderboot", "ruderboote"}),
          "Ich koennte Dir schon ein Boot leihen, aber dazu muesstest Du das geheime "
          "Codewort kennen.", "sagt: ");
  AddInfo(({"codewort"}),
          "Kennst Du das Codewort? Dann fluester mir es einfach zu. Wenn es "
          "richtig ist, borge ich Dir dafuer eins meiner Boote.", "sagt: ");
  AddInfo(({"kapitaen"}),
          "Kapitaen muesste man sein! Auf hoher See nach unbekannten Inseln "
          "suchen und Abenteuer erleben...", "schwaermt: ");
  AddInfo(({"abenteuer"}),
          "Hier passiert ja nie etwas.", "murrt: ");
  AddInfo(({"schiff"}),
          "Oh ja, ich werde mal ein beruehmter Kapitaen, damit Dus weisst!", "behauptet: ");
  AddCmd(({"fluester","fluestere"}), "cmd_fluester");
  
  SetChats(1, ({
           "Rokko fragt: Weisst Du das geheime Codewort?\n",
           "Rokko starrt gelangweilt in die Luft.\n",
           "Rokko tut so, als wuerde er ein Schiff steuern.\n",
           "Rokko scharrt mit den Fuessen im Sand.\n",
           "Rokko sagt: Wenn ich mal gross bin werde ich Kapitaen!\n"
           
           }));

  clone_object("/p/weapon/sword/holzschwert")->move(TO);
  clone_object("/p/armour/trousers/hose")->move(TO);
  clone_object("/p/armour/armour/hemd")->move(TO);
  clone_object("/p/armour/boots/sandalen")->move(TO);
  clone_object("/d/wasser/lupus/pier/obj/muetze")->move(TO);

  command_me("ziehe alles an");
  command_me("zuecke schwert");
}

int cmd_fluester (string str)


{
   notify_fail("Was willst Du wem zufluestern? \n");

   if((str=="rokko zu kapitaen") || (str=="rokko kapitaen") || (str=="junge zu kapitaen")
       || (str=="jungen zu kapitaen") || (str=="junge kapitaen") || (str=="jungen kapitaen"))
   { 
       tell_object(TP,BS("Du fluesterst Rokko das geheime Codewort ins Ohr. Rokko nickt Dir "
                "wohlwollend zu. Du darfst Dir jetzt ein Boot leihen.\n"));
       tell_room(ENV(TO), TPN+ " fluestert Rokko ein geheimnisvolles Wort ins Ohr.\n", ({TP}));
       if (present("\n_bootobjekt",TP) == 0)
	   clone_object(OBJ "bootobjekt")->move(TP);
       return 1;
   }
   
   return 0;
} 
