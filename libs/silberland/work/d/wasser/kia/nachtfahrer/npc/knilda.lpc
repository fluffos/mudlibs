// By Kia@Silberland 5.2003

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "../def.h"

create()

{

  if (!is_clone(this_object())) 
    return;

  ::create();       
  
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Knilda, die betrunkene Wirtin");
  SetProp(P_LONG, 
    "Knilda wuselt geschaeftig zwischen den Bierfaessern und der Theke "
    "herum. Ihr dicker Bauch hindert sie nicht daran, sich "
    "erstaunlich leichtfuessig zu bewegen. Wenn sie sich mit jemandem "
    "unterhaelt, hievt sie ihren unglaublich grossen Busen auf die "
    "Theke. Sie scheint einige Male zu oft am Bierkrug genippt zu haben. "
	"Knilda ist ein wenig schwerhoerig.");
  AddDetail(({"busen"}),
    "Ihr Busen wackelt bei jeder Bewegung auf und ab. ");
  AddDetail(({"bauch"}),
    "Knilda hat einen dicken Bauch, der sie aber keineswegs zu beeintraechtigen scheint. ");
  
  SetProp(P_RACE, "Mensch");
  SetProp(P_NAME, "Knilda");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 166);
  AddId("knilda");
  AddId("kellnerin");
  create_default_npc(28);
  SetProp(P_ALIGN, 100);
  SetProp(P_BODY, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_REJECT, ({ REJECT_KEEP, "Knilda sagt: Ein gutes Trinkgeld waer mir lieber.\n" }) );
  
  set_living_name("knilda");

  seteuid(getuid(this_object()));

  clone_object(ARMOUR "schuerze")->move(TO);
  command("trage schuerze");
  clone_object(ARMOUR "hosenanzug")->move(TO);
  command("trage anzug");
  clone_object(WEAPON "spiess")->move(TO);
  command("zuecke spiess");
                        
  SetProp(P_SPELLRATE,35);
                                               
  AddSpell(1,400,
     "Knilda knallt mir ihrem ganzen Gewicht gegen Dich.\n",
     "Knilda knallt mit ihrem ganzen Gewicht gegen @WEN.\n",
	 ({DT_SQUEEZE})
     );

  AddSpell(2,350, 
     "Knilda kreischt Dir ins Ohr, dass Dir der Schaedel brummt.\n",
     "Knilda kreischt @WEM ins Ohr. \n",
	 ({DT_SOUND})
	 
     );

  SetChats(3, ({
  "Knilda kratzt sich am Kopf. Ein paar Schuppen fallen auf die Theke.\n",
  "Knilda nimmt einen grossen Schluck Bier.\n",
  "Knilda bueckt sich und wendet Dir ihr Hinterteil zu. \n",
  "Knilda legt ihren Busen auf die Theke.\n",
  "Knilda fragt: Willscht was trinkn a oder bischt nur wegn mir do?\n",
  "Knilda trinkt einem Betrunkenen das Bier aus.\n",
  "Knilda pokelt mit dem Grillspiess zwischen ihren Zaehnen rum.\n",
  "Knilda ruelpst unanstaendig.\n",
  "Knilda groehlt ein unidentifizierbares Lied.\n",
  "Du kannst den Blick nicht von Knildas Busen wenden.\n",
  "Knildas Busen macht Dich ganz nervoes.\n",
  }) );

  SetAttackChats(30, ({
  "Knilda ueberrascht Dich mit einer gekonnten Pirhouette.\n",
  "Knilda gibt ein wehleidiges Quieken von sich.\n",
  "Knilda versucht Dir die Augen auszukratzen.\n",
  "Knilda zischt Dich an: Bei mir kriegst du ka Bier mehr!\n",
  "Knilda versucht sich auf Dich draufzusetzen.\n",
  "Knilda fegt Dich wie ein Bierglas ueber die Theke.\n",
  }) );


                   
  SetProp(P_DEFAULT_INFO, ({
          "sagt: Red net so viel, trink lieber was!.\n",
          "schreit: Red lauter! Ich versteh nix!\n",
          "sagt: Trink was dann wird Dir das Fragen schon vergehen!\n" }));

  AddInfo("kia",
          "Kia kommt manchmal auf a Bier vorbei.", "sagt: ");
  AddInfo("bier",
  "Mein Bier brau i soelba! Alle trinkens gern... nur Anheg, der ruehrts net an. Spielverderber!", 
  "antwortet stolz: ");
  AddInfo("schmuggler",
  "Die meiste Kundschaft san Schmuggler. Die trinken wenigstens gscheit.", "sagt: ");
  AddInfo("schnaps",
  "Soll i da an bringen?", "fragt: ");
  AddInfo("busen",
  "wackelt stolz mit ihrem Busen.\n"
  "Knilda fragt: Gefallt a dir?\n");
  AddInfo("faesser",
  "sagt: Da lager ich mein Bier.\n");
  AddInfo("gestalten",
  "sagt: Meine Kundschaft eben.\n"
  "Knilda zuckt mit den Schultern.\n");
  AddInfo("kundschaft",
  "macht eine weitreichende Handbewegung.\n");
  AddInfo("sex",
  "oeffnet unauffaellig einen Knopf ihres Hosenanzugs und laechelt verfuehrerisch.\n");
  AddInfo("knilda",
  "verbeugt sich und reckt ihr Hinterteil dabei in die Luft.\n"
  "Knilda sagt: De Knilda bin ich! \n");
  AddInfo("anheg",
  "Man legt sich besser net mit ihm an. Hat immer eine handvoll "
  "Froesche dabei. Wennst aber unbedingt meinst, dann solltest wenigstens an "
  "vollen Bauch ham. Lass Dir das von der alten Knilda raten. ", "sagt: ");
  AddInfo("froesche",
  "Keine normalen Froesche, irgendsolche giftigen! Heissen filolates teribliss, "
  "oder so.","sagt: ");
  AddInfo(({"filolates terribliss","filolates"}),
  "Anheg stopft sie seinen Gegnern in den Mund. Wenn Du so richtig voll bist "
  "kann er Dich aber nicht dazu zwingen, ihn runterzuschlucken. Wenn Du also gegen "
  "ihn kaempfen willst, schau dass Du nix mehr runterbringtst!","sagt: ");
  AddInfo(({"gegner","gegnern"}),
  "Selbst schuld wenn ma sich mit dem anlegt...","sagt schulterzuckend: ");
  AddInfo("mund",
  "Das ueberleben net viele.","meint: ");
  AddInfo("bauch",
  "Iss gscheit viel. I bring Dir gern was. Brauchst Dir nur was aussuchen. ","sagt: ");
 

}


