// By Kia@Silberland 5.2003
// Wird bei "beruehre spinnennetz" im Lager gecloned.

inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Spinne");
  SetProp(P_LONG,
    "Eine kleine schwarze Spinne mit einem gelben Zeichen auf dem Ruecken.");
  AddDetail(({"zeichen"}),
    "Es handelt sich um ein 'X' ");
  AddDetail(({"x"}),
    "Sieht gefaehrlich aus... ");
  AddDetail(({"ruecken"}),
    "Der Ruecken ist schwarz, bis auf ein gelbes Zeichen. ");
  
  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne"}));
  create_default_npc(10);
  SetProp(P_HANDS, ({" mit ihren giftigen Kieferscheren",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 5);
  SetProp(P_WEIGHT, 50);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL, -4);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      1.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:     -0.1, DT_POISON:-0.5, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,0);
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne will Deine Sachen nicht tragen.\n" }) );
}
