inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "../def.h"

int am_invis;

public string barden_frosch() {
        string text;
        text = "Ohja, solche Froesche habe ich ins SilberLand geschmuggelt. Man nennt sie "
               "Phyllobates terribilis. Sie sind furchtbar gefaehrlich. ";
        if(!objectp(present("\nbard_gs8_task", TP))) {
            return text;
        }
    
        text += "Wenn dich Kronang hergeschickt hat, dann kann ich dir auch weiterhelfen. "
                "Du musst mich nur nach einem Frosch bitten.";
        return text;
    }

    
create()

{

  if (!is_clone(this_object())) 
    return;

  ::create();       
  
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Anheg, der Anfuehrer der Schmuggler");
  SetProp(P_LONG, 
    "Anheg sieht Dich mit durchdringenden, weisen Augen an. Du fuerchtest innerlich, "
    "dass er Deine Gedanken lesen kann. Sein Gesicht ist zerfurcht wie altes Leder, "
    "und sein grauer Bart sorgfaeltig gepflegt. Er hat eine beeindruckende charismatische "
	"Ausstrahlung und koennte Dich mit einem Schlag vernichten!\n");
  AddDetail(({"augen"}),
    "Anhegs Augen beobachten jede Deiner Bewegungen genau. ");
  AddDetail(({"gesicht"}),
    "Ein altes, faltiges Gesicht. Anheg hat schon einige Jahre auf dem Buckel. ");
  AddDetail(({"ausstrahlung"}),
    "Man sollte sich zwei mal ueberlegen, ob man sich mit ihm anlegen will... ");
  AddDetail(({"bart"}),
    "Kein Zwergenbart, soviel steht fest. ");
  AddDetail(({"zwergenbart","zwergenbaerte"}),
    "Zwergenbaerte sind nicht so gepflegt.");
  AddDetail(({"bewegung","bewegungen"}),
    "Anheg folgt jeder Deiner Bewegungen mit seinen Augen. Scheinbar vertraut er Dir "
	"nicht sonderlich.");
  AddDetail("gedanken",
    "Sicherheitshalber solltest Du nichts falsches denken... Wer weiss, vielleicht kann "
	"Anheg wirklich Gedanken lesen?");
  AddDetail(({"jahre","buckel"}),
    "Er mag vielleicht alt sein, aber sehr zerbrechlich sieht er dann doch nicht aus.");
  AddDetail(({"schlag","pech"}),
    "Ein einziger Schlag wuerde ihm genuegen, wenn Du Pech hast.");
  AddDetail("leder",
    "Genauer gesagt, wie altes gegerbtes Leder. Er hat eben schon einiges erlebt.");
  
  SetProp(P_SIZE, 192);
  SetProp(P_RACE, "Mensch");
  SetProp(P_NAME, "Anheg");
  SetProp(P_GENDER, MALE);
  AddId("anheg");
  AddId("NOWIMPY");
  create_default_npc(46);
  SetProp(P_ALIGN, -500);  
  SetProp(P_BODY, 125);
  //SetProp(P_HANDS, ({" mit geschickten Haenden", 185}) );
  SetProp(P_MAX_HANDS, 2);  
 
  set_living_name("anheg");
  
  //clone_object("/d/wasser/stahldorn/knarkh/obj/p_knarkhschwert2")->move(TO);
  clone_object("/p/armour/trousers/titanbeinschienen")->move(TO);
  clone_object("/p/armour/armour/kettenhemd")->move(TO);
  
  command_me("ziehe alles an");
  //command_me("zuecke schwert");
                        

  //sseteuid(getuid(this_object()));

  clone_object(OBJ "schluessel")->move(TO);
                        
  

  SetChats(1, ({
  "Anheg murmelt etwas Unverstaemdliches in seinen Bart.\n",
  "Anheg zupft an seinem Bettlaken herum, bis es wieder makellos glatt ist.\n",
  "Anheg klimpert mit seinem Goldbeutel.\n",
  "Anheg zaehlt die Muenzen in seinem Goldbeutel.\n",
  "Anheg wirft Dir einen verschlagenen Blick zu.\n",
  "Anheg sagt: Zeit ist Geld!\n",
  "Anheg geht gedankenversunken auf und ab.\n",
  
  }) );

  SetProp( P_DIE_MSG, " lacht und sagt: Ich komme wieder!\n" );
  SetProp( P_KILL_MSG, "Das hatte doch nicht etwa was mit einem Frosch zu tun?" );                
  SetProp(P_DEFAULT_INFO, ({
          "fragt: Welche Sprache sprichst Du da, Fremder?\n",
          "hebt eine Augenbraue.\n",
          "sagt: Ich weiss nicht wovon Du sprichst.\n" 
		  }));

  SetProp( P_REJECT, ({ REJECT_KEEP, "Anheg sagt: Ich nehme keine Geschenke! Ich hole "
                                     "mir was ich brauche.\n" }) );
  AddInfo("anheg",
          "Ja, was willst Du von mir?", "fragt: ");
  AddInfo("schmuggler",
          "Wir schmuggeln aus allen Teilen des SilberLands, diverse Ladenbesitzer "
		  "Sind unsere Kunden. Aber glaub bloss nicht, dass Du je wieder von "
		  "hier weggkommst, also kannst Du uns auch nicht verraten.", "lacht: ");
  AddInfo(({"ladenbesitzer", "besitzer"}),
          "Die geniessen hoechste Anonymitaet. Aber Du wuerdest Dich wundern, "
		  "wer da so alles dabei ist. ", "sagt grinsend: ");	
  AddInfo("kunden",
          "Wir haben viele Kunden, die ueber das ganze Silberland verteilt "
		  "sind.", "sagt: ");
  AddInfo("anonymitaet",
          "Unsere Kunden koennen sich hoechster Anonymitaet sicher sein!", "sagt: ");  
  AddInfo("boot",
          "Von mir kriegst Du keines. Du bleibst schoen hier.", "sagt: ");
  AddInfo("knilda",
          "Ah, ich sehe Du hast bereits ihre Bekanntschaft gemacht. "
		  "Ich persoenlich meide sie so gut es geht. Ich rate Dir das ebenfalls zu tun. "
		  "Sie tratscht zu viel, vor allem ueber mich. ", "sagt: ");

  AddInfo(({"frosch","froesche","giftfrosch"}),  #'barden_frosch,"sagt stolz: ");

  AddInfo(({"phyllobates", "phyllobates terribilis"}),
          "Phyllobates terribilis bedeutet soviel wie 'schrecklicher Giftfrosch'. Das Gift "
		  "eines Frosches reicht aus, um 10000 Maeuse oder 10 Menschen zu toeten, "
		  "vorausgesetzt, dass es in die Blutbahn gelangt. Es folgt eine Dauererregung, "
		  "die schliesslich zu Herzstillstand und Atemlaehmung f�hren kann. ","erklaert: ");
  AddInfo("gift",
          "Ein toedliches Gift, sehr wirksam. Wenn Du mir falsch kommst, kannst Du das am eigenen "
		  "Leib spueren. ","lacht: ");
  AddInfo("leib",
          "Lange wuerdest du das Gift ja nicht spueren.","sagt bedauernd: ");
  AddInfo(({"maeuse","menschen"}),
          "Es sind ja nicht umsonst die giftigsten Froesche die es gibt. ","sagt: ");
  AddInfo(({"blutbahn","schleimhaut"}),
          "Wenn man den Frosch schluckt dann geraet das Gift ueber die Schleimhaut in die Blutbahn. ",
		  "sagt: ");
  AddInfo(({"dauererregung","erregung"}),
          "Tja, nicht jede Erregung ist positiv zu sehen.","sagt grinsend: ");
  AddInfo(({"herzstillstand","stillstand","atemlaehmung","laehmung"}),
          "Herzstillstand und Atemlaehmung fuehren dann zum Tod.","sagt: ");
  AddInfo("tod",
          "Das Gift ist so stark, dass es fast immer zum sofortigen Tod fuehrt.","sagt: ");
  AddInfo("bekanntschaft",
          "Knilda kennt hier jeder... Und ihr Bier auch.", "antwortet: ");
  AddInfo("bier",
          "Ich selbst trinke ja keins.", "meint: ");
  AddInfo(({"schwert","obsidianschwert"}),
          "Sowas habe ich einmal geschenkt bekommen. Ich bewahre es "
		  "an einem geheimen Ort auf. Und ehe Du fragst: Es ist nicht "
		  "kaeuflich, und ich schenke es Dir auch nicht.", "sagt: ");
  AddInfo("ort",
          "Der wird nicht verraten.", "sagt: ");
  AddInfo("geschenke",
          "Schmuggler haben es nicht noetig, Geschenke anzunehmen! "
		  "Was wir brauchen, holen wir uns einfach. Alles andere ist "
		  "unehrenhaft.", "sagt: ");	
  AddInfo("goldbeutel",
          "Meins! Alles meins!", "sagt: ");	 
  AddInfo("silberland",
          "Heute das SilberLand, morgen die Welt...", "sagt irre: ");
  AddInfo("welt",
          "Irgendwann werden wir Schmuggler die Welt beherrschen!", "sagt: "); 
  AddInfo("anfuehrer",
          "Ich bin hier der Anfuehrer. Und Du hast zu tun, was ich Dir "
		  "befehle.", "sagt: ");
 SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,     DT_BLUDGEON    :-0.1,       DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,       DT_WHIP        :0,       DT_RIP        :0,
    DT_FIRE       :0.0,    DT_COLD        :-0.3,     DT_WATER      :0.1,    
    DT_AIR        :-0.3,       DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,    DT_ELECTRIC   :0.1,    
    DT_ACID       :0.2,       DT_POISON      :0 ,      DT_TERROR     :-0.1,     
    DT_HOLY       :0,     DT_UNHOLY      :-0.2,    DT_MAGIC      :-0.2]) );

 SetProp(P_SPELLRATE,55);
  AddSpell(13,1,"Anheg entwendet geschickt etwas Geld aus Deiner Geldboerse.\n",
	       "Anheg entwendet geschickt etwas Geld aus @WESSEN Geldboerse.\n",
	       ({DT_MAGIC}),"geld_klauen");
  AddSpell(3,1,"Anheg versucht Dir einen Phyllobates Terribilis in den Mund zu stopfen.\n",
  			"Anheg versucht @WEM einen komischen Frosch in den Mund zu stecken.\n",
			({DT_POISON}),"killer_frosch");
  AddSpell(20,1,"","",({DT_MAGIC}),"werde_invis");
  AddSpell(36,1,BS("Anheg ueberschuettet alle mit einer Fluessigkeit und zuendet sie mit einem kleinen Feuerball an!\n"),BS("Anheg ueberschuettet alle mit einer Fluessigkeit und zuendet sie mit einem kleinen Feuerball an!\n"),({DT_MAGIC}),"mache_feuer");
  AddSpell(8,1,"","",({DT_MAGIC}),"beutel_klauen");
  AddSpell(20,1,"","",({DT_MAGIC}),"feind_rufen");
  AddSpell(24,700, 
     BS("Anheg beschwoert einen Blitz vom Himmel.\n"),
     BS("Anheg beschwoert einen Blitz vom Himmel.\n"),
	 ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));
	 
	 am_invis = 0;

  AddCmd("bitte|bitt&anheg|anfuehrer|&um&frosch", "cmd_frosch_lecken", "Wen willst du um was bitten?\n");
}

public int cmd_frosch_lecken() {
    object task;
    
    task = present("\nbard_gs8_task", TP);
    if(!objectp(task)) {
        command_me("sag Nur Freunde Kronang duerfen am Frosch lecken!");
        return -1;
    }

    TP->Message(BS("Anheg holt einen Frosch aus seinem Mantel und laesst dich kurz daran lecken."));
    ENV(TO)->Message(BS(sprintf("Anheg holt einen knallroten Frosch aus seinem Mantel und laesst %s kurz daran lecken.",
                     TP->name(WER, 1))), 
                     MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    task->SetLicked();
    return 1;
}

void werde_vis()
{
	SetProp(P_INVIS,0);
    SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,     DT_BLUDGEON    :-0.1,       DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,       DT_WHIP        :0,       DT_RIP        :0,
    DT_FIRE       :0.0,    DT_COLD        :-0.3,     DT_WATER      :0.1,    
    DT_AIR        :-0.3,       DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,    DT_ELECTRIC   :0.1,    
    DT_ACID       :0.2,       DT_POISON      :0 ,      DT_TERROR     :-0.1,     
    DT_HOLY       :0,     DT_UNHOLY      :-0.2,    DT_MAGIC      :-0.2]) );
	tell_room(ENV(TO),"Anheg wird wieder sichtbar.\n",({}));
	am_invis = 0;
}


void werde_invis(object enemy, int damage, int damage_type)
{

	//object *theplayers;
	//int i;
	if (am_invis == 1) return;
	am_invis = 1;
	SetProp(P_INVIS,1);
	 SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-1,     DT_BLUDGEON    :-1,       DT_PIERCE     :-1,
    DT_SQUEEZE    :-1,       DT_WHIP        :-1,       DT_RIP        :-1,
    DT_FIRE       :-1,    DT_COLD        :-1,     DT_WATER      :-1,    
    DT_AIR        :-1,       DT_LIGHTNING   :-1,       DT_EXPLOSION  :-1, 
    DT_SOUND      :-1,       DT_LIGHT       :-1,    DT_ELECTRIC   :-1,    
    DT_ACID       :-1,       DT_POISON      :-1 ,      DT_TERROR     :-1,     
    DT_HOLY       :-1,     DT_UNHOLY      :-1,    DT_MAGIC      :-1]) );
	tell_room(ENV(enemy),BS("Anheg macht sich kurz unsichtbar.\n"),({}));
	call_out("werde_vis",10);
	//theplayers = filter_array(all_inventory(environment(enemy)), #'interactive);
/*	theplayers = TO->PresentEnemies();
	for(i = 0; i < sizeof(theplayers); i++)
	{
		theplayers[i]->SetProp(P_DISABLE_ATTACK, 3);
		theplayers[i]->SetProp(P_DISABLE_SPELLS, 3);
	}
*/
}

void mache_feuer(object enemy, int damage, int damage_type)
{

	object *theplayers;
	int i;
	theplayers = filter_array(all_inventory(environment(enemy)), #'living);
	//theplayers = TO->PresentEnemies();
	for(i = 0; i < sizeof(theplayers); i++)
	{
		if ((theplayers[i] != TO) && (interactive(theplayers[i]) || IsEnemy(theplayers[i])))
		{
			theplayers[i]->Defend(800+random(200),({DT_FIRE}),0,TO);
		}
	}
}
void beutel_klauen(object enemy, int damage, int damage_type)
{
	object mybeutel;
	mybeutel = present("beutel",enemy);
	if (mybeutel)
	{
		tell_object(enemy,"Anheg entwendet Dir geschickt einen Beutel.\n");
		tell_room(ENV(enemy),"Anheg entwendet " + enemy->Name(WEM) + " einen Beutel.\n",({enemy}));
		mybeutel->move(TO,M_GET);
	}
}

void feind_rufen(object enemy, int damage, int damage_type)
{
	object mybeutel;
	if (present("\n_sinselfeind",enemy) == 0)
	{
		tell_room(ENV(enemy),break_string(enemy->Name() + " wagt es mich anzugreifen! Sorgt dafuer dass " + enemy->QueryPronoun(WER) + " die Insel nicht lebend verlaesst!\n",0,"Anheg bruellt: "),({}));
		clone_object(OBJ "sinselfeind")->move(enemy);
	}
}

void geld_klauen(object enemy,int damage,int damage_type)
{
	if (enemy->QueryMoney() > 500)
	{
		enemy->AddMoney(-500);
		ME->AddMoney(500);
	}
}

void killer_frosch(object enemy, int damage, int damage_type)
{
	if (enemy->eat_food(13,1))
	{
		tell_object(enemy,BS("Da Du Dich nicht sehr satt fuehlst schluckst Du den Phyllobates Terribilis!\n"));
		tell_room(ENV(enemy),enemy->Name() + " schluckt den Frosch...\n",({enemy}));
		enemy->Defend(2800,({DT_POISON}),0,TO);
	} else
	{
		tell_object(enemy,BS("Baeh, nicht noch was essen. Du spuckst den Phyllobates Terribilis aus...\n"));
		tell_room(ENV(enemy),enemy->Name() + " spuckt den Frosch aus...\n",({enemy}));
	}
	
}
