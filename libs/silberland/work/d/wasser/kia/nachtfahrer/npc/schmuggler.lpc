// By Kia@Silberland 5.2003

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include <mnpc.h>
#include "../def.h"

create()

{

  if (!is_clone(this_object())) 
    return;

  ::create();       
  
  SetProp(P_ARTICLE, 1);
  SetProp(P_SHORT, "Ein Schmuggler");
  SetProp(P_LONG, 
    "Ein Schmuggler, der leise vor sich hinmurmelnd die Gaenge auf und ab schreitet. "
	"Er wirkt ziemlich beschaeftigt und scheint Dich kaum zu bemerken. \n" );
  SetProp(P_NAME, "Schmuggler");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  SetProp(P_SIZE, 181);
  AddId("schmuggler");
  create_default_npc(28);
  SetProp(P_ALIGN, -400);
  SetProp(P_BODY, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MNPC_AREA,"/d/wasser/kia/nachtfahrer/room/mnpc");
  SetProp(P_MNPC_WAIT, ({60, 60, 30}));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES);
  
  clone_object("/p/armour/trousers/hose")->move(TO);
  clone_object("/p/armour/bracers/bronzearmschienen")->move(TO);
  clone_object(OBJ "rum")->move(TO);
  
  command_me("ziehe alles an");

  seteuid(getuid(this_object()));
                        
  SetProp(P_SPELLRATE,35);
  AddSpell(1,100,
     BS("Der Schmuggler nimmt den Dolch ploetzlich in die andere Hand und bringt Dich "
	 "damit kurz durcheinander.\n"),
     BS("Der Schmuggler nimmt den Dolch in die andere Hand. @WEN scheint das kurzzeitig "
	 "zu verwirren.\n"), ({DT_MIND}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,500, 
     BS("Der Schmuggler stellt Dir geschickt ein Bein und rammt Dir den Dolch zwischen die Rippen.\n"),
     BS("Der Schmuggler stellt @WEM geschickt ein Bein und rammt den Dolch zwischen die Rippen.\n"),
	 ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,400,
     BS("Der Schmuggler boxt Dir mit der freien Hand hinterhaeltig in die Magengrube.\n"),
	 BS("Der Schmuggler boxt @WEM mit der freien Hand in die Magengrube.\n"),
	 ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));
                                               

  SetChats(3, ({
  "Der Schmuggler rauft sich gestresst die Haare.\n",
  "Der Schmuggler murmelt: Wann trifft endlich die naechste Lieferung ein? \n",
  "Der Schmuggler scheint Dich gar nicht zu bemerken. \n",
  "Der Schmuggler gruebelt: Die Goldbarren aus Tijara muessten schon laengst hier sein!\n",
  }) );
  
  SetProp(P_DEFAULT_INFO, ({
          "sagt: Vielleicht weiss Anheg darueber was?\n",
          "meint: Ich muss arbeiten, frag bitte jemand anderen.\n",
		  "ist zu beschaeftigt, um zu tratschen.\n"}));
  AddInfo("schmuggler",
  "sagt: Schmuggler zu sein ist ein Beruf wie jeder andere...\n");
  AddInfo("anheg",
  "Anheg ist unser Anfuehrer. Du findest ihn in der groessten Hoehle.","sagt: ");
  AddInfo("anfuehrer",
  "meint: Hier kann nur der Beste Anfuehrer werden.\n");
  AddInfo("hoehle",
  "sagt grinsend: Wenn Du in Anhegs Hoehle bist, merkst Du das auch.\n");
  AddInfo("lieferung",
  "fragt: Von welcher Lieferung sprichst Du jetzt?\n");
  AddInfo("tijara",
  "Wir beziehen Waren von ueberall im Silberland, auch aus Tijara.","sagt: ");
  AddInfo("goldbarren",
  "sagt: Die Goldbarren? Ach die werden schon noch ankommen.\n");
  AddInfo("waren",
  "fragt: Hast Du etwa neue Waren fuer uns?\n");
  AddInfo("turedian",
  "Falls Du etwas kaufen willst, solltest Du Turedian aufsuchen. Wir haben keine Zeit um "
  "uns um einzelne Kleinkunden zu kuemmern.","sagt: ");
  AddInfo("zeit",
  "Alles muss zackzack gehen!","murmelt gestresst: ");
  AddInfo("kleinkunden",
  "Viel zu unlukrativ, fuer sowas haben wir keine Zeit.","sagt: ");
  AddInfo("knilda",
  "Oh, Knilda ist die einzige Frau hier.","sagt: ");
  AddInfo("frau",
  "Eine Frau? Wo!","fragt interessiert: ");
}

void toete_feind(object enemy)
{
	tell_room(ENV(TO),"Der Schmuggler schreit: " + enemy->Name() + " ist ein Feind, stiirb!\n",({}));
	Kill(enemy);
}

init()
{
	::init();
	if (TP && !(TO->IsEnemy(TP)) && present("\n_sinselfeind",TP))
	{
		call_out("toete_feind",2,TP);
	}
}

