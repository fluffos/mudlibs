// By Kia@Silberland 5.2003

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h> 
#include "../def.h"

create()

{

  if (!is_clone(this_object())) 
    return;

  ::create();       
  
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Turedian, der Ladenbesitzer");
  SetProp(P_LONG, 
    "Turedian ist ein schmieriger kleiner Mann mit einem unglaublichen Buckel. "
	"Er grinst Dich verschlagen an und Du siehst gleich, dass Du ihm "
	"nicht trauen kannst. Er steht hinter dem Ladentisch und reibt gierig "
	"die Haende.\n");
  AddDetail(({"buckel"}),
    "Der Buckel ist so gross, dass man ihn nicht dezent uebersehen kann.\n ");
  AddDetail(({"haende"}),
    "Turedian reibt sich die Haende. Was das zu bedeuten hat?\n");
  AddDetail("mann",
    "Nun, zumindest sieht er aus wie ein Mann.");
  SetProp(P_NAME, "Turedian");
  SetProp(P_GENDER, MALE);
  AddId("turedian");
  AddId("ladenbesitzer");
  AddId("besitzer");
  SetProp(P_DEFAULT_INFO, ({
          "rechnet im Kopf seinen heutigen Umsatz aus und hoert Dir nicht zu.\n", 
		  }));
  create_default_npc(30);
  SetProp(P_ALIGN, -400);
  SetProp(P_BODY, 200);
  SetProp(P_MAX_HANDS, 2);
  set_living_name("turedian");
  seteuid(getuid(this_object()));
  // clone_object("/d/wasser/stahldorn/knarkh/obj/p_knarkhschwert2")->move(TO);
  clone_object("/p/armour/trousers/hose")->move(TO);
  clone_object("/p/armour/armour/weste")->move(TO);
  
  command_me("ziehe alles an");
  // command_me("zuecke schwert");
                        
  SetProp(P_SPELLRATE,35);  
  
    AddSpell(1,500,
     "Turedian knallt Dir die Kasse an den Kopf.\n",
     "Turedian knallt @WEM die Kasse an den Kopf.\n",
	 ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1])
     ); 
	 
     AddSpell(1,400,
     "Turedian beisst in Dein Knie und zerrt daran.\n",
     "Turedian beisst in @WESSEN Knie und zerrt daran.\n",
	 ({DT_RIP}), ([SP_SHOW_DAMAGE:1])
     );                                          

  SetChats(3, ({
  "Turedian leckt sich die Lippen.\n",
  "Turedian verbeugt sich so tief, dass sein Hosenboden ein Stueckchen aufreisst.\n",
  "Turedian sagt: Dies hier ist der beste Laden der Insel!\n",
  "Turedian klopft Dir etwas Staub von der Kleidung.\n"
  }) );
  
  AddInfo("anheg",
  "Kuemmer Dich doch nicht um Anheg, hier kannst Du das Geschaeft Deines Lebens machen!",
  "behauptet: ");
  AddInfo("geschaeft",
  "Du kannst hier kaufen und verkaufen.");
  AddInfo("schmuggler",
  "Welch unschoenes Wort. Ich wuerde es eher... Haendler nennen!","behauptet: ");
  AddInfo("haendler",
  "Wir sind nur Haendler wie jeder andere.","sagt: ");
  AddInfo("knilda",
  "Ohja, eine huebsche Dame. Kommt mich manchmal besuchen.","sagt grinsend: ");
  AddInfo("dame",
  "Genau gesagt ja die einzige hier.","sagt bedauernd: ");
  AddInfo("umsatz",
  "Berufsgeheimnis!","sagt: ");
  AddInfo("berufsgeheimnis",
  "Um ehrlich zu sein, das Geschaeft geht schlecht. Hast Du nicht Mitleid mit einem "
  "armen alten Mann? Willst Du nicht etwas kaufen?","fragt: ");
  AddInfo("mitleid",
  "schaut Dich ganz arm an.");
  AddInfo("turedian",
  "Turedian ist ein ganz normaler Name. Er ist sicher althochdeutsch, oder so. Und ueberhaupt, "
  "Dein Name ist auch nicht besser!","sagt: ");
  AddInfo("laden",
  "Schau Dich ruhig in Ruhe um.","sagt: ");
  AddInfo("insel",
  "Wir Schmuggler... aeh... Haendler haben uns auf diese Insel zurueckgezogen. Hier ist es "
  "so schoen ruhig.","sagt: ");
}
void toete_feind(object enemy)
{
	tell_room(ENV(TO),"Turedian schreit: " + enemy->Name() + " ist ein Feind, stirb!\n",({}));
	Kill(enemy);
}

init()
{
	::init();
	if (TP && !(TO->IsEnemy(TP)) && present("\n_sinselfeind",TP))
	{
		call_out("toete_feind",2,TP);
	}
}
	


