// von Aaliyah
// 29.1.2005
// Dienerin der Amazonen


inherit "std/mnpc";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Dienerin");
  SetProp(P_LONG, "Die Dienerin ist klein und zierlich. Ihre langen, schwarzen "
          "Locken hat sie mit einem Stirnreif gebaendigt. Ihre bodenlange Toga "
          "betont ihre schoenen, weiblichen Rundungen. Ihre grossen braunen "
          "Augen strahlen groessten Respekt aus. ");
  SetProp(P_NAME, "Dienerin");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"dienerin"}) );
  create_default_npc(12+random(7));
  SetProp(P_HANDS, ({" mit ihren sanften Haenden an",130,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 480);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 40+random(1000));
  SetProp(P_MAX_HANDS, 10);
  SetProp(P_NOATTACK, "wuerde sich niemals auf einen Kampf einlassen.");
  
  SetProp(P_MSGIN, "kommt anmutig herein");
  SetProp(P_MSGOUT, "eilt flink zu einer Amazone");
  SetProp(P_MMSGIN, "erscheint anmutig");
  SetProp(P_MMSGOUT, "taenzelt davon");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "burg1" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 20, 25, 25}) );

  AddInfo(DEFAULT_INFO, "fluestert: Ich habe keine Zeit fuer sowas.\n");
  SetProp(P_LOG_INFO, "aaliyah/edynia_dienerin");

  SetProp( P_REJECT, ({REJECT_DROP, "Die Dienerin lehnt dankend ab.\n" }));

  SetChats(7, ({"Die Dienerin streicht sich eine Locke aus dem Gesicht.\n",
		 "Die Dienerin streift sich ihre Toga glatt.\n",
                 "Die Dienerin wischt sich den Schweiss von der Stirn.\n",
                 "Die Dienerin seufzt wegen der schweren Arbeit.\n",
                 "Die Dienerin laechelt Dich schuechtern an.\n",
                 "Die Dienerin zwinkert Dir verstohlen zu.\n",
		 }));

  SUID;
    CLONEME(ARMOUR "toga.lpc" );
    CLONEME("/gilden/amazonen/armour/sandalen" );
    CLONEME("/d/unterwelt/zordan/dhrkion/armour/stirnreif" );
    command("trage alles");

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "schubst Dich sanft zur Seite.",
	       "schubst "+TP->name(WEM)+ "sanft zur Seite.");
     break;

   case "intim":
     call_out ("react", 0, "weist Dich nett aber bestimmt ab.",
	"weist "+TP->name(WEM)+ " ab.");

    break;

   case "aergerlich":
     call_out("react", 0, "verpasst Dir eine Ohrfeige.",
	      "verpasst "+TP->name(WEN)+" eine Ohrfeige.");
     break;

   case "frech":
     call_out("react", 0, "sagt: So lasst mich doch in Ruhe!",
	      "funkelt "+TP->name(WEN)+" boese an.");
     break;
   
    default:
      call_out("react", 0, "laechelt Dich an.",
	       "laechelt.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 

string* _query_chats()
{
  
  if (!environment())
    return 0;
  switch(explode(file_name(environment()),"/")[4])  // auf 5 aendern, wenn in region wasser
  {
    case "brunnen":
      return ({ "Die Dienerin fuellt einen Eimer mit Wasser.\n",
                "Die Dienerin erfrischt sich kurz am Brunnen.\n",
                "Die Dienerin giesst die Blumen.\n",
                "Die Dienerin waescht sich den Schweiss aus ihrem Gesicht.\n",
                "Die Dienerin waescht sich ihre schmutzigen Haende.\n",
                }) + Query(P_CHATS);
    case "burg7":
      return ({ "Die Dienerin beginnt den Boden zu fegen.\n",
                "Die Dienerin fuettert die Pferde.\n",
                "Die Dienerin bringt den Pferden frisches Wasser.\n",
                "Die Dienerin striegelt ein Pferd.\n",
                "Die Dienerin streichelt ein Pferd.\n",
                "Die Dienerin kaemmt die Maehne eines Pferdes.\n",
                "Die Dienerin putzt einen Sattel.\n",
                "Die Dienerin putzt das Zaumzeug.\n",
                }) + Query(P_CHATS);
    case "burg2":
    case "burg3":
    case "burg4":
    case "burg5":
    case "burg6":
    case "burg8":
    case "burg9":
      return ({ "Die Dienerin giesst die Blumen.\n",
                "Die Dienerin bringt den Amazonen kuehle Getraenke.\n",
                "Die Dienerin zupft die Blumen zurecht.\n",
                "Die Dienerin flechtet einer Amazone die Haare.\n",
                "Die Dienerin massiert einer Amazone den Nacken.\n",
                "Die Dienerin geniesst das schoene Wetter.\n",
                "Die Dienerin bewundert die Amazonen.\n",
                "Die Dienerin schleppt einen Eimer Wasser herum.\n",
                }) + Query(P_CHATS);
    case "mauer1":
    case "mauer2":
    case "mauer3":
    case "mauer4":
    case "mauer5":
    case "mauer6":
    case "mauer7":
    case "mauer8":
    case "mauer9":
    case "mauer10":
    case "mauer11":
    case "mauer12":
    case "mauer13":
    case "mauer14":
    case "mauer15":
    case "mauer16":
      return ({ "Die Dienerin befestigt einen Brief an einer Taube und laesst sie wegfliegen.\n",
                "Die Dienerin blickt sehnsuechtig in die Ferne.\n",
                "Die Dienerin staubt die Zinnen ab.\n",
                "Die Dienerin rastet sich aus.\n",
                "Die Dienerin geniesst die Aussicht.\n",
                "Die Dienerin fuehlt sich unbeobachtet und zuendet sich einen Joint an.\n",
                "Die Dienerin leht sich muede an die Mauer.\n",
                "Die Dienerin drueckt sich hier vor der Arbeit in der Kueche.\n",
                "Die Dienerin schreibt einen Liebesbrief.\n",
                "Die Dienerin kaut an ihren Fingernaegeln.\n",
                "Die Dienerin fegt den Boden.\n"
                }) +  Query(P_CHATS) ;
    case "speise":
      return ({ "Die Dienerin serviert Essen.\n",
                "Die Dienerin serviert frische Getraenke.\n",
                "Die Dienerin raeumt einen Tisch ab.\n",
                "Die Dienerin wischt einen Tisch ab.\n",
                "Die Dienerin fegt den Boden.\n",
                "Die Dienerin serviert den Nachtisch.\n",
                "Die Dienerin stapelt leere Teller auf einem Tablett.\n",
                "Die Dienerin faltet ein paar Servietten.\n",
                "Die Dienerin dekoriert die Tische.\n",
                "Die Dienerin bindet frische Blumengestecke.\n",
                "Die Dienerin serviert die Suppe.\n",
                "Die Dienerin schenkt Wein nach.\n",
                "Die Dienerin rueckt die Stuehle gerade.\n",
                }) + Query(P_CHATS);
    case "kueche":
      return ({ "Die Dienerin spuelt das Geschirr.\n",
                "Die Dienerin nascht heimlich am Dessert.\n",
                "Die Dienerin trocknet nasse Teller ab.\n",
                "Die Dienerin spuelt das Besteck.\n",
                "Die Dienerin stapelt die Teller.\n",
                "Die Dienerin hilft beim Kochen.\n",
                "Die Dienerin ruehrt einen Topf um.\n",
                "Die Dienerin wuerzt die Suppe.\n",
                "Die Dienerin giesst frisches Wasser in einen Kessel.\n",
                "Die Dienerin schuert den Herd.\n",
                "Die Dienerin fegt der Boden.\n",
                "Die Dienerin dekoriert das Dessert.\n",
                "Die Dienerin holt Lebensmittel aus dem Schrank.\n",
                "Die Dienerin wischt sich die Haende in einen Tuch ab.\n",
                "Die Dienerin schmeckt die Suppe ab.\n",
                "Die Dienerin kostet vom Essen.\n",
                }) + Query(P_CHATS);
    case "waffen":
      return ({ "Die Dienerin fegt den Boden.\n",
                "Die Dienerin poliert einen Schild.\n",
                "Die Dienerin poliert Beinschienen.\n",
                "Die Dienerin poliert Armschienen.\n",
                "Die Dienerin putzt ein Paar Stiefel.\n",
                "Die Dienerin poliert einen Brustpanzer.\n",
                "Die Dienerin poliert einen Helm.\n",
                "Die Dienerin sortiert die Speere.\n",
                "Die Dienerin schaerft eine Speerspitze.\n",
                "Die Dienerin stapelt Helme uebereinander.\n",
                }) + Query(P_CHATS);
    case "schmiede":
      return ({ "Die Dienerin fegt den Boden.\n",
                "Die Dienerin hilft der Schmiedin.\n",
                "Die Dienerin bringt frisches Wasser.\n",
                "Die Dienerin legt Kohle ins Feuer.\n",
                "Die Dienerin reicht der Schmiedin eine Eisenstange.\n",
                "Die Dienerin reicht der Schmiedin eine Stahlplatte.\n",
                "Die Dienerin stapelt die Eisenbarren.\n",
                "Die Dienerin tupft der Schmiedin den Schweiss von der Stirn.\n",
                "Die Dienerin kuehlt eine frischgeschmiedete Speerspitze im Wasser ab.\n",
                "Die Dienerin befestigt eine Speerspitze an einem Speer.\n",
                "Die Dienerin reicht der Schmiedin den Hammer.\n",
                "Die Dienerin putzt eine Zange.\n",
                }) + Query(P_CHATS);
    default: return Query(P_CHATS);
  }
}
