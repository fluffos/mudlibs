// Patrouillierende Amazone in Edynia

inherit "std/mnpc";
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Amazone patrouilliert hier");
  SetProp(P_LONG,
    "Eine Amazone patrouilliert aufmerksam am Strand entlang. Ihre Haltung ist "
    "aufrecht und wachsam, und sie laesst ihren Blick ueber Wasser und Land "
    "gleiten, als wuerde sie jede Bewegung registrieren.");

  SetProp(P_NAME, "Amazone");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  AddId(({ "amazone", "patrouille", "patrouillierende", "\nedynia_amazone_patrouille", "NOWIMPY" }));

  create_default_npc(20);

  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 300);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp(P_MSGIN, "kommt auf Patrouille an");
  SetProp(P_MSGOUT, "geht weiter auf Patrouille");

  SetProp(P_MNPC_AREA, ROOM "amazon");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "amazon1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 15, 25, 20 }) );
  SetProp(P_MNPC_ACTIVE_TIME, 3600);

  SUID;
  CLONEME(WEAPON "patrouillenspeer");
  CLONEME(ARMOUR "patrouillenruestung");
  command("trage alles");
  command("zuecke patrouillenspeer");
}

