// Der Flugdrache
// 2005-02-03 Feyaria@SilberLand

#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells";

int mymoney;

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, 
    "Ilgearzyraernidor, der Flugdrache");
  SetProp(P_LONG, 
      "Vor Dir steht ein grosser Drache mit bronzefarbenen Schuppen. "
      "Auf dem relativ kurzen Hals sitzt ein gewaltiger Kopf mit zwei spitzen "
      "Hoernern. Grosse Luftwirbel kommen aus seinen riesiegen Nuestern. "
      "Obwohl das Maul voller scharfer Zaehne ist, scheint Dir der Drache "
      "nicht boese gesinnt zu sein. Auf dem gewaltigen Koeper befinden sich "
      "zwei Paar riesige Fluegel, ein Hinweis, dass sich Bronzedrachen in der "
      "Luft wohler fuehlen als auf der Erde. Der Koerper laeuft in einen "
      "langen Schwanz mit einer schwertaehnlichen Hornspitze aus. Auf seinem "
      "Ruecken ist ein Sattel befestigt, auf dem eine Person bequem Platz "
      "nehmen kann. Scheinbar kann man auf diesem Drachen durch die Luefte "
      "fliegen.");
  SetProp(P_NAME, "Ilgearzyraernidor");
  create_default_dragon(2,7,1,15+random(5));
  AddId( ({"flugdrache", "ilgearzyraernidor"}) );
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_ARTICLE, 0);

  SetProp(P_KILL_NAME, "Ilgearzyraernidor, der Flugdrache");
  SetProp(P_KILL_MSG, "Unterschaetz nie die Macht der Drachen!");
  SetProp(P_MURDER_MSG, "Das naechste Mal flieg ich einfach davon, %s?");

  AddDefaultSpell(1, 1000, DS_ANTIMAGIC);
  AddDefaultSpell(1, 1000, DS_SLOW);
  
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "sagt: ");

  SetProp(P_MSGIN, "fliegt majestaetisch herein");
  SetProp(P_MMSGIN, "fliegt majestaetisch herein");
  SetProp(P_MMSGOUT, "fliegt weit weg");
  SetProp(P_MSGOUT, "fliegt");

  AddCmd( ({"flieg", "fliege"}), "cmd_fliegen" );
}

void die(int poisondeath)
{
  write_file(LOG "drache", dtime(time())+": "+CAP(TP->query_real_name())+
      " killt den Flugdrachen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "drache", dtime(time())+": Der Flugdrache hat gerade "+
      CAP(player->query_real_name())+ " umgebracht. (-"+lostexp+" XP)\n");
}

string random_dest(int r)
{
  if( !r ) r=random(6)+1; 
  switch(r)
  {
    case 1: return "/d/polar/lamuerte/dorf/rooms/steg"; break;
    case 2: return "/d/dschungel/feyaria/felseninsel/room/felsen"; break;
    case 3: return "/d/dschungel/feyaria/dorf/room/baum-0b0"; break;
    case 4: return "/d/kristallwald/sargola/wald/room/4_0602"; break;
    case 5: return "/d/ebene/Midas/room/kirchturm"; break;
    case 6: return "/d/wasser/dante/zinsel/room/steg1"; break;
    case 7: return "/d/wueste/protheg/arrakeen/room/ara_3_4_0"; break;
  }
}
 
int cmd_fliegen( string str)
{
  string str1, dest, str2, wohin, dummy;
  int price;

  notify_fail("Auf wem willst Du fliegen?\n");
  if (!str) return 0;
  price = 1000 + 30 * TP->QueryProp(P_LEVEL);
  sscanf(str, "auf %s", str1);
  if (sscanf(str, "auf %s nach %s", str2, wohin) == 2);
  else if (sscanf(str, "auf %s auf %s", str2, wohin) == 2);
  else if (sscanf(str, "auf %s zur %s", str2, wohin) == 2);
  else if (sscanf(str, "auf %s zu %s", str2, wohin) == 2);
  else if (sscanf(str, "auf %s zum %s", str2, wohin) == 2);
  else sscanf(str, "auf %s in %s", str2, wohin);
  if (id(str) || id(str1))
    dest = random_dest(0);
  else if (id(str2))
  {
    switch(wohin)
    {
      case "smoersky":
      case "norden":
      case "polar": 
      case "polargebiet": 
      case "eishoehle":
        dest = random_dest(1); price += random(500); break;
      case "felseninsel":
      case "insel":
      case "sueden":
        dest = random_dest(2); price += random(200); break;
      case "dschungel":
      case "ulme":
      case "blutulme":
        dest = random_dest(3); price += random(350); break;
      case "kristallwald":
      case "eiche":
      case "kristalleiche":
        dest = random_dest(4); price += random(100); break;
      case "midas":
      case "kirche":
      case "kirchturm":
        dest = random_dest(5); price += random(50); break;
      case "zombieinsel":
      case "zombies":
      case "zombie":
      case "zinsel":
        dest = random_dest(6); price += random(1500); break;
      case "wueste":
      case "arrakeen":
        dest = random_dest(7); price += random(2000); break;
      default: 
        dest = random_dest(0);
    }
  }    
  if (id(str) || id(str1) || id(str2))
  {
    if (InFight() || TP->InFight())
    {
      write("Im Kampf geht das nicht!\n");
      return -1;
    }
    if (TP->QueryProp(P_GUILD) != "amazonen")
    {
      write(BS(Name(WER,1) + " merkt, dass Du keine Amazone bist und faucht "
            "Dich boese an."));
      return -1;
    }
    if (TP->QueryMoney() < price)
    {
      write(BS(Name(WER,1) + " schaut Dich aergerlich an und laesst Dich "
            "nicht aufsitzen. Vielleicht solltest Du das naechste mal "
            "mehr Geld bereithalten!"));
      return 1;
    }
    TP->AddMoney(-price);
    mymoney += price;
    write(BS("Du wirfst einige Muenzen auf den Hort des Flugdrachens, "
             "kletterst auf seinen Ruecken und setzt Dich in den Sattel. "
             "Der Flugdrache erhebt sich und fliegt weit weg."));
    write("\n\n");
    write(BS("In rasender Geschwindigkeit naehert sich der Drache seinem "
             "Ziel und setzt Dich ab. Bis Du begreifst, wo Du jetzt bist, "
             "ist der Drache schon wieder auf und davon."));
    write("\n\n");
    say(CAP_TPN+" klettert auf den Ruecken des Flugdrachen.\n", ({TP,TO})); 
    TP->move(dest, M_TPORT|M_NO_SHOW, "", 
            "reitet auf dem Flugdrachen davon", 
            "wird von einem Flugdrachen abgesetzt"); 
    call_out("back", 10, MENV);
    move("/room/npcasylraum", M_TPORT|M_SILENT);
    return 1;
  }
  return 0;
}

void back(object env)
{
  move(env, M_TPORT);
}
void init()
{
  ::init();
  if (TP && TP->id("Amazone")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( ((gruppe=="nett" || gruppe=="froh"))
      && find_call_out("intim")==-1 && !random(3) )
    call_out("intim",0);
  if( ((gruppe=="traurig" || gruppe=="aengstlich"))
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  Kill(TP);
}

void intim()
{
  tell_object(TP, Name(WER,1)+" blickt Dich gelangweilt an.\n");
  tell_room(MENV, Name(WER,1)+" blickt "+TP->name(WEN)+" gelangweilt an.\n", ({TP, TP}) );
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TPN+".\n", ({TP, TO}) );
}

