// Lady Igraine




inherit "std/mnpc";


#include "../def.h"

string info_erkenntnis();

void init()
{
  ::init();
 if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{

  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Igraine saeuselt: Willkommen!\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Lady Igraine");
  SetProp(P_LONG,
    "Lady Igraine ist die Tochter der Koenigin. Ihre langen, schwarzen Haare " 
    "wurden zum Teil kunstvoll aufgesteckt. Sie hat schoene haselnussbraune "
    "Augen, die von dichten, schwarzen Wimpern malerisch umrahmt werden. "
    "Ihre zarte Figur wird von einer weissen Toga richtig gut zur Geltung "
    "gebracht. Sie huscht durch das ganze Schloss, um ueberall nach dem Rechten "
    "zu sehen. Ausserdem ist sie eine Meisterin des Speerkampfes.");
                   
  SetProp(P_GENDER, FEMALE);
  AddId(({"igraine", "lady", "lady igraine", "Speermeister" }));
  SetProp(P_ARTICLE, 0);
  set_living_name("lady igraine");
  SetProp(P_NAME, "Lady Igraine");

  create_default_npc(40,3000);
  SetProp(P_HANDS, ({" mit ihren zarten Haenden",300,DT_MAGIC}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 74000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "speise.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_GUILD, "amazonen");

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      -0.1, DT_POISON: -0.3, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    -0.5, DT_MAGIC:  -1.0, DT_MIND:   0.2,
     DT_SLASH:     -0.3, DT_PIERCE:  -0.3, DT_WHIP: -0.5, DT_BLUDGEON: -0.5]) );

  SetProp(P_MSGIN, "sieht hier nach dem Rechten");
  SetProp(P_MSGOUT, "schreitet zufrieden");
  SetProp(P_MMSGIN, "taenzelt anmutig herein");
  SetProp(P_MMSGOUT, "verschwindet lautlos");
  SetProp(P_DIE_MSG,  " bricht blutend zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Meine Mutter wird Dich dafuer toeten %s!");
  SetProp(P_KILL_NAME, "Lady Igraine");
  SetProp(P_KILL_MSG, "Wer nicht hoeren will muss fuehlen!");
  SetProp(P_BODY, QueryProp(P_BODY) + 100);
  

  AddInfo(DEFAULT_INFO, "sagt: Das werdet Ihr nie erfahren Fremder.");
  
  AddInfo( ({"vater"}), 
    "Meine Mutter hat gesagt, dass mein Vater tot ist.", "sagt laechelnd: ");
  
  AddInfo( ({"mann","maenner"}),
    "Maenner sind hier nicht erwuenscht. Trotzdem haette ich gerne einen guten "
    "Ehemann.","sagt: ");
  
  AddInfo( ({"druiden","berserker","paladine","nekromanten","zechpreller"}),
     "Ich habe keine Ahnung von diesen Gilden.","sagt: ");
  
  AddInfo( ({"amazonen"}),
     "Die Amazonen kaempfen mit der Macht der Goetter!","sagt: ");
  
  AddInfo( ({"goetter"}),
     "Och, da gibt es hier so einige in der Burg.","sagt: ");
  
  AddInfo( ({"ehemann"}),
     "Meine Mutter wuerde das niemals dulden.","seufzt: ");
  
  AddInfo( ({"schatzkammer","versteck"}), 
     "Das Versteck der Schatzkammer werde ich Euch gewiss nicht verraten.",
     "sagt: ");
  
  AddInfo( ({"heilerin","schlafgemach","badesaal","leuchtturm"}),
     "Schaut doch mal auf den Tuermen nach.","sagt: ");
  
  AddInfo( ({"drache"}),
     "Den Drachen mag ich sehr sehr gerne.","laechelt: ");
  
  AddInfo( ({"thronsaal"}),
     "Der Thronsaal ist in der Naehe des Burghofes.","sagt laechelnd: ");
  
  AddInfo( ({"hippolyte","koenigin","amazonenkoenigin"}),
     "Hippolyte ist meine Mutter. Sie traut niemandem ausser mir. Darum ist es "
     "meine Aufgabe hier alles zu ueberwachen.","erzaehlt: ");
  
  AddInfo( ({"burghof","kueche","speisesaal","waffenkammer","schmiedin"}),
      "Das befindet sich im Erdgeschoss.","kichert: ");
 
  AddInfo( ({"dienerinnen"}),
      "Ich muss gut auf sie achtgeben sonst machen sie nur Unfug.","sagt: ");

  AddInfo( ({"aphrodite"}),
      "Aphrodite schminkt und stylt die Amazonen. Sie befindet sich im "
      "Badesaal.","sagt: ");


  AddInfo("erkenntnis", #'info_erkenntnis, "sagt: ");
  

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Lady Igraine sagt: Dankeschoen!\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(6,450,
    "Igraine schlitzt Dir mit dem Speer die Brust auf.\n",
    "Igraine schlitzt @WEN mit ihrem Speer die Brust auf.\n",    
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,2000,
  "Igraine zieht Dir Deine Seele aus dem Leib.\n",
  "Igraine zieht @WEM die Seele aus dem Leib.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,450,		  
  "Igraine verpasst Dir eine schallende Ohrfeige.\n",
  "Igraine verpasst @WEM eine schallende Ohrfeige.\n",
  DT_WHIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(7,500,
  "Igraine spuckt Dir ins Gesicht.\n",
  "Igraine spuckt @WEM ins Gesicht.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));
  
    

  SetChats(1, ({"Lady Igraine begutachtet ein paar Dienerinnen.\n",
		 "Igraine streift sich eine Haarstraene aus dem Gesicht.\n",
		 "Lady Igraine laechelt Dich verschmitzt an.\n",}));
 
  
  SUID;
  CLONEME("/gilden/amazonen/weapon/amazonenspeer" );
  command("zuecke speer");
  CLONEME(ARMOUR "wtoga.lpc" );
  CLONEME(ARMOUR "stirnreif.lpc" );
  CLONEME(ARMOUR "armschmuck.lpc" );
  CLONEME(ARMOUR "handschmuck.lpc" );
  command("trage alles");

    
}

 void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "fragt: Wollt Ihr meinen Speer spueren?",
          "fragt: "+TP->name(WER)+" wollt Ihr meinen Speer spueren?");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "sagt: Ich hab fuer solchen Unfug keine Zeit "+TPN+".",0);
      break;
  case "traurig":
    call_out("react", 0, "troestet Dich laechelnd "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "grinst Dich an.",0);
       break;
  case "neutral":
    call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEN)+" zu.");
      break;
  case "intim":
    call_out("react", 0, "durchdringt Dich mit ihren Augen. ",
	"durchdringt "+TP->name(WEN)+" mit ihren Augen.");
      break;
  case "froh":
    call_out("react", 0, "strahlt Dich froehlich an.",
             "strahlt "+TP->name(WEN)+" froehlich an.");
      break;
  case "aengstlich":
    call_out("react", 0, "ermutigt Dich.",
             "ermutigt "+TP->name(WEM)+" etwas.");
      break;
  case "frech":
    call_out("react", 0, "kneift Dich in die Nase.", "kneift "
		     +TP->name(WEN)+" in die Nase.");
      break;
  case "nett":
    call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
		    " an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" schimpft: Ihr habts nicht anders gewollt!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

string info_erkenntnis()
{
  mapping sk;
  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "Das Wissen ueber die Erkenntnis teile ich nur mit Amazonen!";

  if (TP->QuerySkill("erkenntnis"))
    return "Aber Du kannst Erkenntnis ja schon!";

  clone_object("/gilden/amazonen/questobj/erkenntnis")->move(TP, M_NOCHECK);
  return "Beantworte diese Fragen und Du wirst Erkenntnis erlangen.";
}

