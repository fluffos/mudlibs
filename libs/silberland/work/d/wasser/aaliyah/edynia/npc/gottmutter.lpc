//Hera, die Goettin

inherit "std/npc";
inherit "/std/npc/spells";


#include "../def.h"
#include "/d/astral/lamuerte/brunnen/npc/sprachfluch.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Hera fluestert: Willkommen!\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Hera, die Mutter aller Goetter");
  SetProp(P_LONG,
    "Hera ist eine kleine, schlanke Frau. Ihre langen schlohweissen Haare hat "
    "sie zu einem Dutt aufgesteckt. In ihrem zarten, faltigen Gesicht zeichnet "
    "sich das Alter. Ihre grossen hellrosa Augen strahlen ein enorme Weisheit "
    "aus. Sie wirkt aeusserst freundlich und sympathisch und eher wie die "
    "nette Grossmutter von nebenan, als wie eine Goettin. Trotzdem sollte man "
    "sich von ihrem Anblick nicht blenden lassen, denn nur allzu gross sind "
    "ihre Kraefte und ihre Macht.");
    
  SetProp(P_NAME, ({"Hera, die Mutter aller Goetter",
                  "Hera, der Mutter aller Goetter", 
                  "Hera, der Mutter aller Goetter",
                  "Hera, die Mutter aller Goetter"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"hera", "goettin", "muttergoettin","Speermeister","mutter"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("hera");

  create_default_npc(70, 10000);
  SetProp(P_HANDS, ({" mit ihren blitzenden Haenden",400,DT_LIGHTNING}));
  SetProp(P_RACE, "Gott");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 30000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_GUILD, "amazonen");
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  0.0, DT_AIR:   0.0, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: 0.0, DT_SOUND:  -1.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -1.0, DT_TERROR: -1.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.0, DT_MAGIC:  -1.0, DT_MIND:   -1.0,
      DT_PIERCE: 0.0, DT_SLASH: 0.0,  DT_BLUDGEON: 0.0]) );

  SetProp(P_MSGIN, "erscheint von einem goettlichen Licht umgeben");
  SetProp(P_MSGOUT, "verschwindet ins Reich der Goetter");
  SetProp(P_MMSGIN, "entsteht aus goettlichem Licht");
  SetProp(P_MMSGOUT, "verschwindet in goettlichem Licht");
  SetProp(P_DIE_MSG,  " verschwindet vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Die Rache der Goetter wird kommen!");
  SetProp(P_KILL_NAME, "Hera, die Muttergoettin");
  SetProp(P_KILL_MSG, "Mit einer Goettin legt man sich nicht an!");

  AddInfo(DEFAULT_INFO, "sagt: Ich bin schon alt, ich brauche Ruhe.");
  
  AddInfo( ({"goetter"}), 
    "Es gibt viele Goetter. Aphrodite, Venus, Fortuna, Isis, Osiris, Hades, "
    "sind nur ein kleines Beispiel.","sagt laechelnd: ");
  
  AddInfo( ({"aphrodite"}),
    "Aphrodite ist die Goettin der Schoenheit.","sagt: ");
  
  AddInfo( ({"druiden"}),
     "Die sind doch alle mit ihren Elementaren verheiratet.","schimpft: ");
  
  AddInfo( ({"venus"}),
     "Venus ist die Goettin der Liebe.","sagt: ");
  
  AddInfo( ({"berserker"}),
     "Dazu muss ich jetzt aber nicht wirklich antworten.","sagt: ");
  
  AddInfo( ({"paladine"}),
     "Ich finde ihre rosa Wappenroeckchen toll.","sagt: ");
  
  AddInfo( ({"druiden"}), 
     "Druiden sehen am besten aus wenn sie tot sind.","sagt: ");
  
  AddInfo( ({"nekromanten","zechpreller"}),
     "Mir wird gleich uebel.","sagt: ");
  
  AddInfo( ({"kronang","zechus"}),
     "Der ist nicht einmal erwaehnenswert.","lacht: ");
  
  AddInfo( ({"anvar","tattergreis"}),
     "Der alte Tattergreis hat schon viel zulange gelebt.","sagt laechelnd: ");
  
  AddInfo( ({"isis"}),
     "Isis ist die Goettin des Tages und der Fruchtbarkeit. Es ist eine "
     "wunderbare Frau.","schwaermt: ");
  
  AddInfo( ({"osiris"}),
     "Osiris ist der Gott des Todes und der Bruder meiner Isis","sagt: ");
  
  AddInfo( ({"hades"}),
     "Hades ist der Gott der Unterwelt. Ein finsterer Geselle.","sagt: ");
     
  AddInfo( ({"fortuna"}),
     "Fortuna ist die Goettin des Gluecks.","sagt: ");
     
  AddInfo( ({"pallas athene","athene"}),
     "Pallas Athene ist die Goettin der Weisheit.","sagt: ");
  
  AddInfo( ({"amun"}),
     "Amun ist der Gott des Windes. Ein huebscher junger Mann.","sagt: ");
  
  AddInfo( ({"poseidon"}),
     "Das ist der Gott des Meeres.","sagt: ");
  
  AddInfo( ({"zeus","ehemann"}),
     "Zeus ist mein Ehemann. Er ist viel unterwegs und selten bei mir","sagt: ");
  
  AddInfo( ({"horus"}),
     "Horus ist der Sohn von Isis und Osiris.","sagt: ");
  
  
  AddInfo( ({"achilles"}),
      "Achilles ist leider nur ein Halbgott.","seufzt: ");

  AddInfo( ({"herkules"}),
      "Herkules ist der Gott des Krieges. Ein wahrlich stattlicher Mann.",
      "sagt: ");

  AddInfo( ({"hermes"}),
      "Ach, Hermes ist der Goetterbote.","sagt: ");

  AddInfo( ({"amor"}),
      "Das ist der Gott der Liebe. Hat er Dich auch schon einmal mit einem "
      "seiner Pfeile getroffen?","fragt: ");

  AddInfo( ({"ares"}),
      "Ares ist einer der Kriegsgoetter.","sagt: ");

  AddInfo( ({"nemesis"}),
      "Nemesis ist die Goettin der Rache.","erklaert: ");

  AddInfo( ({"minvera"}),
      "Minerva ist die Goettin der Arzneien.","sagt: ");

 

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Hera sagt: Oh, ein Geschenk fuer mich! Dankeschoen!\n" }) );

  SetProp(P_SPELLRATE, 99);
  AddSpell(1,200,
  "Hera beschwoert die Macht aller Goetter und wendet sie gegen Dich.\n",
  "Hera attackiert @WEM mit der Macht der Goetter.\n",
   DT_MIND,([SP_SHOW_DAMAGE:1]));
    
 
  AddSpell(4,500,
  "Hera zerfleischt Dich mit ihrer Goetterlanze.\n",
  "Hera zerfleischt @WEM mit ihrer Goetterlanze.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(6,500,		  
  "Hera beschwoert viele Blitze, die Dich attackieren.\n",
  "Hera beschwoert viele Blitze, die @WEM attackieren.\n",
  DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(5,800, DS_SLOW,
  "Hera starrt Dich mit aufgerissenen Augen an.\n"
  "Du erstarrst.\n",
  "Calypso laesst @WEM erstarren.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(3, 450, DS_BLIND);

  AddDefaultSpell(5, 300, DS_ANTIMAGIC);

  AddDefaultSpell(3, 1200, DS_FROG);

  AddDefaultSpell(3, 450, DS_CURSE_WEAPON);

  AddDefaultSpell(3, 450, DS_CURSE_ARMOUR);


  AddSpell(3,600,
  "Heras Blitze laehmen Deine Zunge.\n",
  "Heras Blitze laehmen die Zunge von @WEM.\n",
  DT_SLASH, "spell_sprachfluch",([SP_SHOW_DAMAGE:1]));

  

  AddSpell(3,600,
  "Artemisia spaltet Deine Zunge entzwei.\n",
  "Artemisia spaltet @WEM die Zunge entzwei.\n",
  DT_SLASH, "spell_sprachfluch",([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1500,
  "Hera beschwoert den Ozean und eine Flutwelle bricht ueber Dich herein.\n",
  "Hera beschwoert eine gigantische Flutwelle, die @WEM vernichtet.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1500,
  "Hera streckt ihre Arme empor und ein grosser Wirbelsturm erscheint.\n",
  "Heras Wirbelsturm wirbelt @WEM durch die Luft.\n",
  DT_AIR,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1500,
  "Ein Blitz zuckt aus Heras Augen und formt eine riesige Feuerwand.\n",
  "Viele Blitze zucken aus Heras Augen und verbrennen @WEM stark.\n",
  DT_FIRE,([SP_SHOW_DAMAGE:1]));


  
  AddSpell(2,1500,
  "Hera beschwoert einen Hagelsturm und die Hagelkoerner prallen auf Dich.\n",
  "Hera beschwoert einen Hagelsturm, der @WEM vernichtet.\n",
  DT_COLD,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({"Hera fragt: Wollt Ihr nicht aufgeben?\n",
		       "Hera lacht: Ihr seid so jaemmerlich!\n",
		       "Hera sagt: Ihr seid einer Goettin nicht wuerdig!\n",
		       "Hera schreit: Jetzt gehts richtig los!\n"}) );
  
    

  SetChats(1, ({"Hera setzt sich in ihren Wolkenstuhl und schaukelt.\n",
		"Hera spielt mit einem kleinen Blitz.\n",
		"Hera schaukelt mit ihrem Stuhl.\n",
		"Hera blickt auf die Welt hinunter.\n",
		"Hera beschwoert eine Wolke und laesst es regnen.\n",
		"Hera laesst eine Wolke verschwinden.\n",
		"Hera laesst die Sonne ueber das Silberland scheinen.\n",
		"Hera formt einen wunderschoenen Regenbogen.\n",
		"Hera laesst es dunkel werden.\n"
		"Nacht kehrt ueber das Land und die Sterne funkeln.\n",
		"Hera laesst es hell werden und es wird wieder Tag.\n",
		"Einige kleine Blitze zucken um Heras Haare.\n",
		"Hera holt einen Stern vom Himmel und betrachtet ihn.\n",
		"Hera laesst eine Sternschnuppe vom Himmel saussen.\n",
		"Hera teilt einen Kontinent in zwei Teile.\n",
		"Hera erschafft einen Ozean mit vielen Lebewesen.\n",
		"Hera laesst etwas Nebel entstehen.\n"}));
 
  
  SUID;
    CLONEME(WEAPON "goetterspeer.lpc" );
    command("zuecke speer");
    CLONEME(ARMOUR "wtoga.lpc" );
    CLONEME(ARMOUR "handschmuck.lpc" );
    CLONEME(ARMOUR "armschmuck.lpc" );
    CLONEME(ARMOUR "stirnreif.lpc" );
    command("trage alles");
   
}
  

  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
    call_out("react", 0, "schimpft: Aergert nicht eine Goettin!",
          "schimpft: "+TP->name(WER)+" aergert mich nicht!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "fragt: Wollt Ihr sterben "+TPN+"?",0);
      break;
  case "traurig":
     call_out("react", 0, "sagt: Nicht traurig sein "+TPN+".",0);
      break;
  case "albern":
     call_out("react", 0, "schmunzelt.",0);
       break;
  case "neutral":
     call_out("react", 0, "blickt Dich durchdringend an.", "blickt "
		     +TP->name(WEN)+" durchdringend an.");
      break;
  case "intim":
     call_out("react", 0, "droht Dir mit dem Zeigefinger. ",
	"droht "+TP->name(WEN)+" mit dem Zeigefinger.");
      break;
  case "froh":
     call_out("react", 0, "laechelt Dich zufrieden an.",
             "laechelt "+TP->name(WEN)+" zufrieden an.");
      break;
  case "aengstlich":
     call_out("react", 0, "streichelt Dir beruhigend durch die Haare.",
             "streichelt "+TP->name(WEM)+" durch die Haare.");
      break;
  case "frech":
     call_out("react", 0, "verpasst Dir einen Blitzschlag.", "verpasst "
		     +TP->name(WEN)+" einen Blitzschlag.");
      break;
  case "nett":
      call_out("react", 0, "nimmt Dich in ihre Arme.", "nimmt "
		      +TP->name(WEN)+" in ihre Arme.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" sagt: Wer nicht hoeren will muss fuehlen!\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

