// von Codex
// Amazone - Wache (wandernd)

inherit "std/mnpc";
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Waechterin der Amazonen");
  SetProp(P_LONG,
    "Eine Waechterin der Amazonenburg steht hier und behaelt ihre Umgebung im "
    "Auge. Ihre Bewegungen sind ruhig und geuebt, doch ihr Blick bleibt wachsam. "
    "Offenbar ist sie Teil einer Patrouille, die die gesamte Burg und ihre "
    "Wege kontrolliert.");

  SetProp(P_NAME, "Waechterin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  AddId(({ "amazone", "amazonenwaechterin", "waechterin", "wache", "NOWIMPY",
           "\nedynia_amazone_wache" }));

  create_default_npc(24);

  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 300);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp(P_MSGIN, "kommt auf Patrouille an");
  SetProp(P_MSGOUT, "geht weiter");

  SetProp(P_MNPC_AREA, ROOM);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "burg1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_WAIT, ({ 15, 25, 20 }) );
  SetProp(P_MNPC_ACTIVE_TIME, 3600);

  SetProp(P_GUILD, "amazonen");

  SUID;
  CLONEME("/gilden/amazonen/weapon/amazonenspeer" );
  command("zuecke speer");
  CLONEME("/gilden/amazonen/armour/beinschienen");
  CLONEME("/gilden/amazonen/armour/armschienen");
  CLONEME("/gilden/amazonen/armour/waffengurt");
  CLONEME("/gilden/amazonen/armour/guilditem");
  CLONEME("/gilden/amazonen/armour/brustharnisch");
  CLONEME("/gilden/amazonen/armour/helm3");
  command("trage alles");
}

