// Isis, die Muttergoettin des Tages

inherit "p/std/npc/druid_npc";



#include "../def.h"


void init()
{
  ::init();
 if (find_call_out("hallo") != -1)
  call_out("hallo",0);
}
void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&&InFight())
    tell_room(MENV, "Isis erscheint aus einem hellem Licht.\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Isis, die Muttergoettin des Tages");
  SetProp(P_LONG,
    "Isis ist die Muttergoettin des Tages und der Feuchtigkeit. Sie ist eine " 
    "wahrhaft wunderschoene Erscheinung. Ihre langen goldblonden Haare wehen "
    "im Wind. Lauter hellblaue Blueten haben sich darin verfangen. Ihr Kopf " 
    "wird von einigen Efeuranken geschmueckt. Ihre Toga betont ihren schlanken "
    "wohlgeformten Koerper und aus ihren veilchenblauen Augen strahlt ihre "
    "Guete und Waerme.");
    
  SetProp(P_NAME, ({"Isis, die Muttergoettin des Tages",
                  "Isis, der Muttergoettin des Tages", 
                  "Isis, der Muttergoettin des Tages",
                  "Isis, die Muttergoettin des Tages"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"isis", "goettin", "muttergoettin"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("isis");

  create_default_druid("wasser", 40, 16, 2000);
  SetProp(P_RACE, "Gott");
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.3, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    0.5, DT_MAGIC:  -0.5, DT_MIND:   0.2,
      DT_SLASH:     0.1, DT_BLUDGEON: -0.1, DT_PIERCE: 0.1]) );

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "verschwindet lautlos");
  SetProp(P_MMSGIN, "erwacht mit den Blumen");
  SetProp(P_MMSGOUT, "schwebt davon");
  SetProp(P_MNPC_AREA, "hex_14.lpc" );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hex_14.lpc");
  SetProp(P_DIE_MSG,  " schwebt in den Himmel.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Osiris wird mich raechen!");
  SetProp(P_KILL_NAME, "Isis, die Muttergoettin des Tages");
  SetProp(P_KILL_MSG, "So schlafet ewig in Osiris Reich!");

//--------------Addinfo Anfang-------------------------------

  AddInfo(DEFAULT_INFO, "Vielleicht kann Euch Osiris weiterhelfen.","sagt: ");

  AddInfo( ({"osiris","todesgott","geliebter","gott","todes","liebe"}),
     "Osiris ist mein Bruder und mein Geliebter.","sagt: ");
  
  AddInfo( ({"bruder","bruders"}),
    "Welchen Bruder meint ihr? Seth oder Osiris?","fragt: ");
  
  AddInfo( ({"seth"}),
     "Meine Liebe zu Osiris, weckte die Eifersucht meines anderen Bruders "
     "Seth. Er ermordete Osiris und zerstueckelte seinen Leichnam. Aber "
     "ich habe fuer seine Wiederbelebung gesorgt.","erzaehlt: ");
  
  AddInfo( ({"wiederbelebung","leichnam"}),
     "Ich habe die Leichenteile von Osiris eingesammelt und sie wieder "
     "zusammengefuegt. Lediglich der Penis fehlte, aber auch da wusste ich "
     "mir zu helfen.","erzaehlt: ");
  
  AddInfo( ({"penis"}),
     "Ich formte einen Penis aus purem Gold. Neun Monate spaeter wurde "
     "mein Sohn Horus geboren.","sagt: ");
  
  AddInfo( ({"horus","sohn","schatzmeister"}),
     "Mein Sohn Horus diente den Amazonen. Er war lange Zeit Schatzmeister "
     "auf ihrer Burg. Leider passierte ihm ein Missgeschick.","sagt: ");
  
  AddInfo( ({"burg","amazonen"}),
     "Ich wandle bei den Amazonen umher, in der Hoffnung meinen Sohn wieder "
     "zu finden.","sagt: ");
  
  AddInfo( ({"missgeschick"}),
     "Es gab fuer die Burg zwei Schluessel. Ein Glasschluessel und einer aus "
     "purem Kristall","sagt: ");
  
  AddInfo( ({"schluessel","glasschluessel","kristallschluessel"}),
     "Ich weiss nichts Genaues. Osiris weiss da gewiss mehr.","sagt: ");
  
  AddInfo( ({"splitter"}),
     "Die meisten Splitter wurden von den Bewohnern der Burg gefunden, aber "
     "ein paar davon fehlen leider noch.","sagt: ");
 
  AddInfo( ({"schatzkammer","kammer"}),
     "Ohne die zwei Schluessel gelangt man wohl nicht in die Kammer. Jedoch "
     "bin ich mir sicher das es da eine Moeglichkeit gibt.","sagt: ");
  
  AddInfo( ({"person","schmiedin"}),
    "Die Schmiedin stellt tolle Dinge her. Allerdings muss man sich dafuer "
    "ihre Freundschaft erschleichen.","sagt: ");
  
  AddInfo( ({"nehmen"}),
    "Man kann nicht nur nehmen ohne je zu geben.","sagt: ");
 
  AddInfo( ({"geben"}),
    "Ein kleiner Gefallen hat schon Wunder bewirkt.","sagt: ");
  
  AddInfo( ({"glueck"}),
    "Ich hoffe ihr habt gute Ohren. Man kann die .... sehr leicht..... Es "
    "ist einfach.. . ... gute Menschenkenntnis, die verlangt wird. Ausserdem "
    "muss .....gewisse Dinge besorgen. Als aller Erstes muss man zu ... "
    "etwas besorgen.  ... noch vier Blumen aus.... alle Splitter. ","sagt: ");
 
//---------Info Ende----------------------------------
  
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Isis sagt: Ich habe keine Verwendung fuer irdische Dinge.\n" }) );

   

  SetChats(1, ({"Isis laesst eine Blume wachsen.\n",
		 "Isis spielt mit einem Sonnenstrahl.\n",
		 "Isis streichelt ueber den Boden.\n",
		 "Isis laesst ein paar Schmetterlinge entstehen.\n",
		 "Isis beruehrt den Boden und alles beginnt zu bluehen.\n",
		 "Isis streckt ihren Arm und eine Taube setzt sich darauf.\n",}));
 
  
  SUID;
//    CLONEME(ARMOUR "gottsturm.lpc");
//    CLONEME(ARMOUR "vkleid.lpc" );
//    CLONEME(ARMOUR "pantoffeln.lpc" );
//    CLONEME(ARMOUR "brille.lpc" );
//     command("tra
}
  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "sagt: Ihr wollt doch nicht eine Goettin aergern",
          "sagt: "+TP->name(WER)+" aergert mich nicht.");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
   call_out("react", 0, "fragt: Seid Ihr lebensmuede?, "+TPN+"?",0);
      break;
         break;
  case "traurig":
   call_out("react", 0, "nimmt Dich troestend in die Arme.",
             "nimmt "+TP->name(WEN)+" troestend in die Arme.");
      break;
  case "albern":
    call_out("react", 0, "schmunzelt.",0);
       break;
  case "neutral":
   call_out("react", 0, "grinst Dich an.", "grinst "+TP->name(WEN)+" an.");
      break;
  case "intim":
   call_out("react", 0, "sagt: Das darf nur Osiris.", "weist "+TP->name(WEN)+
		         " zurecht.");
      break;
  case "froh":
   call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
  case "aengstlich":
    call_out("react", 0, "spendet Dir Mut.",
             "spendet "+TP->name(WEM)+" Mut.");
          break;
  case "frech":
    call_out("react", 0, "verpasst Dir eine Ohrfeige.", "haut "+TP->name(WEN)+
		         " Eine runter.");
      break;
  case "nett":
    call_out("react", 0, "umarmt Dich.", "umarmt  "+TP->name(WEN)+" kurz.");
      break;
  }
}
void react(string victim, string others)
	{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" schreit: Strafe muss sein!\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

