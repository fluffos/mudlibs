// 1.2.2005
// Pferd
// Edynia Npc

inherit "std/mnpc";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein praechtiger Lipizzaner");
  SetProp(P_LONG, 
          "Vor Dir steht ein praechtiger Lipizzanerhengst. Sein seidiges "
          "weisses Fell glaenzt im Sonnenlicht. Einige Sehnen kommen bei "
          "jeder seiner Bewegungen zum Vorschein. Kleine Zoepfe wurden mit "
	  "hellblauen Satinbaendern in seine Maehne und seinen Schweif "
	  "geflochten und verleihen ihm ein koenigliches Aussehen. ");
  SetProp(P_NAME, "praechtiger Lipizzaner");
  SetProp(P_GENDER, MALE); 
  AddId( ({"lipizzaner","hengst","lipizzanerhengst","pferd"}) );
  create_default_npc(40+random(50));
  SetProp(P_HANDS, ({" mit seinen maechtigen Hufen",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Pferd");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 300000);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "galoppiert herein");
  SetProp(P_MSGOUT, "galloppiert davon");
  SetProp(P_MMSGIN, "wird von den Goettern hier abgesetzt");
  SetProp(P_MMSGOUT, "wird zu den Goettern gerufen");
  SetProp(P_NOATTACK, "wird von der Macht der Goetter beschuetzt.");
  
  AddInfo(DEFAULT_INFO, "blickt Dich verwirrt an.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Der Hengst braucht so etwas nicht.\n" }));

  SetChats(1, ({ "Der Lipizzaner knabbert etwas Gras.\n",
		 "Der Lipizzaner wiehert leise auf.\n",
		 "Der Lipizzaner taenzelt nervoes umher.\n",
		 "Der Lipizzaner zerrt an seinem Seil.\n"}));

  SUID;
  CLONEME(OBJ "hufeisen.lpc" );
  CLONEME(OBJ "hufeisen.lpc" );
  CLONEME(OBJ "hufeisen.lpc" );
  CLONEME(OBJ "hufeisen.lpc" );
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "bleckt sein weisses Gebiss.",
	       "zeigt "+TP->name(WEM)+ " sein Gebiss.");
     break;

   case "intim":
     call_out ("react", 0, "schmiegt seinen Kopf an Deine Brust.",
	"schmiegt sich an "+TP->name(WEM)+ " an.");

    break;

   case "aergerlich":
     call_out("react", 0, "baeumt sich vor Dir auf.",
	      "baeumt sich vor "+TP->name(WEN)+" auf.");
     break;

   case "frech":
     call_out("react", 0, "schlaegt mit seinem Huf aus.",
	      "versucht "+TP->name(WEN)+" mit seinem Huf zu verletzen.");
     break;
   
    default:
      call_out("react", 0, "stubst Dich freundlich mit dem Maul an.",
	       "wiehert leise.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
}
	


   
