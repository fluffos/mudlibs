// von Aaliyah
// die Schmiedin

inherit "std/repair";

#include "../def.h"
#include "/gilden/amazonen/amazonen_extern.h"

void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
    call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Die Schmiedin blickt kurz auf, wendet sich dann aber "
        "wieder ihrer Arbeit zu.\n");
}

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Xanthippe, die Schmiedin der Amazonen");
  SetProp(P_LONG,
    "Vor Dir steht Xanthippe, die Schmiedin der Amazonenburg. Sie ist fuer "
    "eine Zwergin relativ klein, dafuer aber breit gebaut. Ihr Gesicht und "
    "ihre Haare sind vom Russ so geschwaerzt, dass man die echte Farbe "
    "darunter kaum erkennen kann. Sie schwingt den grossen Schmiedehammer "
    "mit einer Leichtigkeit, wie man es nur von Zwergen kennt. Ihre "
    "Kunstfertigkeit im Schmiedehandwerk ist so gross, dass sie alle "
    "Amazonen mit den besten Ruestungen und Waffen versorgen kann.");
                   
  SetProp(P_GENDER, FEMALE);
  AddId(({"xanthippe", "schmiedin", "Keulenmeister" }));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Xanthippe");

  create_default_npc(35,2000);
  SetProp(P_HANDS, ({" mit ihren harten Haenden", QueryProp(P_HANDS)[1],
        DT_BLUDGEON}));
  SetProp(P_BODY, QueryProp(P_BODY) + 100);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 118);
  SetProp(P_WEIGHT, 64000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_GUILD, "amazonen");

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.6, DT_COLD:     -0.2, DT_WATER:  0.2, DT_AIR:   -0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      -0.2, DT_POISON: -0.6, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    -0.5, DT_MAGIC:   0.2, DT_MIND:   0.2,
     DT_SLASH:     -0.3, DT_PIERCE:  -0.3, DT_WHIP: -0.5, DT_BLUDGEON: -0.5]) );

  SetProp(P_MSGIN, "widmet sich dem Schmiedehandwerk");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint aus einer Wolke Russ und Staub");
  SetProp(P_MMSGOUT, "verschwindet in einer Wolke aus Russ und Staub");
  SetProp(P_DIE_MSG,  " wird nie wieder schmieden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste Mal wird Dich mein Hammer zermalmen, %s!");
  SetProp(P_KILL_MSG, "Und jetzt werf ich Deine Leiche ins Schmiedefeuer!");

  AddInfo(DEFAULT_INFO, "sagt: Stoert mich nicht beim Schmieden.");

  AddInfo( ({"anpassen"}),
      "Wenn ich Dir eine Ruestung anpassen soll, dann gib sie mir einfach.",
      "sagt: ");
  
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1) + " wirft @WEN ins Schmiedefeuer.\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(2,700,
    Name(WER,1) + " wirft Dir fluessiges Metall ins Gesicht.\n",
    Name(WER,1) + " wirft @WEM fluessiges Metall ins Gesicht.\n",
    DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,500,
    Name(WER,1) + " schlaegt Dir den Schmiedehammer voll auf den Kopf.\n",
    Name(WER,1) + " schlaegt @WEM den Schmiedehammer voll auf den Kopf.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 1500,
    Name(WER,1) + " wirft Dich ins Schmiedefeuer.\n",
    Name(WER,1) + " wirft @WEN ins Schmiedefeuer.\n",
    DT_FIRE,([SP_SHOW_DAMAGE:1]));
    

  SetChats(4, ({
        Name(WER,1) + " wischt sich den Schweiss von der Stirn.\n",
        Name(WER,1) + " haemmert wild auf ein Stueck Eisen ein.\n",
        Name(WER,1) + " taucht eine neue Speerspitze ins kalte Wasser.\n*zisch*\n",
        Name(WER,1) + " holt sich einen neuen Eisenbarren.\n",
        Name(WER,1) + " haemmert froehlich vor sich hin.\n",
        Name(WER,1) + " prueft die Schaerfe einer Speerspitze.\n",
        Name(WER,1) + " bearbeitet einen Helm mit ihrem Hammer.\n",
        Name(WER,1) + " formt eine kupferne Guertelschnalle.\n",
        Name(WER,1) + " vergoldet eine bronzene Armschiene.\n",
        Name(WER,1) + " begutachtet ihr Werk.\n",
        Name(WER,1) + " sagt: Ich kann Dir Ruestungen auf Amazonen-Niveau anpassen.\n",
        Name(WER,1) + " holt sich eine neue Zange.\n",
        Name(WER,1) + " holt sich einen neuen Hammer.\n",
        Name(WER,1) + " haemmert auf eine Eisenplatte ein.\n",
        Name(WER,1) + " graviert ein schoenes Muster in eine Beinschiene.\n",
        Name(WER,1) + " poliert einen Brustpanzer.\n",}));
  
  SUID;
  CLONEME("/p/weapon/club/schmiedehammer" );
  command("zuecke hammer");
  CLONEME("/p/armour/trousers/lederhose");
  CLONEME("/p/armour/cloak/lederschuerze");
  CLONEME("/p/armour/armour/hemd");
  command("trage alles");
    
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      if( random(2) )
        call_out("react", 0, "fragt: Wollt Ihr meinen Schmiedehammer spueren?",
            "fragt: "+TP->name(WER)+" wollt Ihr meinen Schmiedehammer spueren?");
      else
        call_out("angriff",0);
      break;
    case "aergerlich":
      call_out("react", 0, "sagt: Ich hab fuer solchen Unfug keine Zeit "+TPN+".",0);
      break;
    case "traurig":
      call_out("react", 0, "troestet Dich laechelnd "+TPN+".",0);
      break;
    case "albern":
      call_out("react", 0, "grinst Dich an.",0);
      break;
    case "neutral":
      call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEN)+" zu.");
      break;
    case "intim":
      call_out("react", 0, "durchdringt Dich mit ihren Augen. ",
          "durchdringt "+TP->name(WEN)+" mit ihren Augen.");
      break;
    case "froh":
      call_out("react", 0, "strahlt Dich froehlich an.",
          "strahlt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "ermutigt Dich.",
          "ermutigt "+TP->name(WEM)+" etwas.");
      break;
    case "frech":
      call_out("react", 0, "kneift Dich in die Nase.", "kneift "
          +TP->name(WEN)+" in die Nase.");
      break;
    case "nett":
      call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
          " an.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" schimpft: Ihr habts nicht anders gewollt!\n");
    Kill(TP);
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
        dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

int rep_auswahl(object ob)
{
  if (ob->QueryProp(P_WEAPON_TYPE))
  {
    if (ob->QueryProp(P_WEAPON_TYPE) != WT_SPEAR)
    {
      write(Name(WER,1) + " sagt: Ich repariere nur Speere!\n");
      return 0;
    }
    return 1;
  }
  if( ob->QueryMaterialGroup(MATGROUP_METAL)<20 )
  {
    write(Name(WER,1) + " sagt: Ich repariere nur Metallruestungen!\n");
    return 0;
  }
  return 1;
}

void give_notify(object ob)
{
  int ac;
  mapping m;
  int value;

  if (TP->QueryProp(P_GUILD) == "amazonen" && ob->QueryProp(P_ARMOUR_TYPE))
  {
    if (ob->QueryProp("amazonen_angepasst"))
    {
      command("sag " + ob->Name(WER,1) + " wurde doch schon angepasst!");
    }
    else if(function_exists("long",ob)[0..4] != "/std/")
    {
      command("sag " + ob->Name(WER,1) + " laesst sich nicht anpassen!");
    }
    else if ((ac = ob->QueryProp(P_AC)) > 5 && (100 * ac > 
        AMA_AC_FAKTOR * VALID_ARMOUR_CLASS[ob->QueryProp(P_ARMOUR_TYPE)] || 
        ob->QueryProp(P_WEIGHT) > AMA_WEIGHT + AMA_WEIGHT_AC * ac))
    {
      if ((value = 3 * ob->QueryProp(P_VALUE)) < 3000)
        value = 3000;
      if (TP->QueryMoney() < value)
      {
        command("sag Das wuerde " + value + " Muenzen kosten!");
      }
      else
      {
        write("Du zahlst " + value + " Muenzen fuer die Anpassung.\n");
        TP->AddMoney(-value);

        tell_room(MENV, BS(sprintf(
                "%s nimmt %s pruefend in ihre starken Haende und macht gerinfuegige "
                "Anpassungen.",
                Name(WER,1), ob->name(WEN,1))));

        if (100 * ac > AMA_AC_FAKTOR * VALID_ARMOUR_CLASS[ob->QueryProp(P_ARMOUR_TYPE)])
          ob->SetProp(P_AC, AMA_AC_FAKTOR * VALID_ARMOUR_CLASS[ob->QueryProp(P_ARMOUR_TYPE)] / 100);
        if (ob->QueryProp(P_WEIGHT) > AMA_WEIGHT + AMA_WEIGHT_AC * ac)
          ob->SetProp(P_WEIGHT, AMA_WEIGHT + AMA_WEIGHT_AC * ob->QueryProp(P_AC));
        ob->SetProp("amazonen_angepasst", 1);
        if (!mappingp(m = ob->QueryProp(P_WEAR_RESTRICTIONS)))
          m = ([]);
        m[P_GUILD] = "amazonen"; 
        ob->SetProp(P_WEAR_RESTRICTIONS, m);
        ob->SetProp("ruestungsbalsam", 10);
        ob->SetProp(P_LONG, ob->QueryProp(P_LONG) +
            ob->Name(WER,1) + " wurde speziell an die Beduerfnisse einer Amazone "
            "angepasst.");
      }
    }
    else
    {
      command("sag "+ob->name(WER,1)+" braucht keine Anpassung!\n");
    }
    printf("%s gibt Dir %s wieder zurueck.\n",
        Name(WER,1), ob->name(WEN,1));
    tell_room(MENV, sprintf("%s gibt %s %s wieder zurueck.\n",
          Name(WER,1), TP->name(WEM,1), ob->name(WEN,1)), ({TP}));
    ob->move(TP, M_NOCHECK);
  }
  else
     ::give_notify(ob);
}


