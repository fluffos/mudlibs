// 15.1.2005 Aaliyah
// Osiris, der Gott des Todes

inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&&!InFight())
    tell_room(MENV, "Osiris ensteht aus einem Schatten.\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Osiris, der Gott des Todes");
      
  SetProp(P_NAME, ({"Osiris, der Gott des Todes",
                  "Osiris, des Gott des Todes", 
                  "Osiris, dem Gott des Todes",
                  "Osiris, den Gott des Todes"}));
                  
  SetProp(P_GENDER, MALE);
  AddId(({"osiris", "gott", "todesgott","Speermeister"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("todesgott");

  create_default_npc(40,3000);
  SetProp(P_HANDS, ({" mit seinem Todeshauch an",300,DT_MAGIC}));
  SetProp(P_RACE, "Gott");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 78000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:40]));  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.2, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.2, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  0.0, DT_MIND:   0.2,
      DT_SLASH:     -0.2, DT_PIERCE:  -0.5, DT_WHIP: -0.5, DT_BLUDGEON: 0.]) );

  SetProp(P_MSGIN, "tritt aus einem Schatten");
  SetProp(P_MSGOUT, "verschwindet in einem Schatten");
  SetProp(P_MMSGIN, "erwacht aus dem Todesreich");
  SetProp(P_MMSGOUT, "verschwindet ins Reich der Toten");
  SetProp(P_MNPC_AREA, "hex_20.lpc" );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hex_20.lpc");
  SetProp(P_DIE_MSG,  " verschwindet ins Reich der Toten.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Das war nicht sehr klug von Euch!");
  SetProp(P_KILL_NAME, "Osiris, der Gott des Todes");
  SetProp(P_KILL_MSG, "Die Toten werden Dich empfangen!");

  AddInfo(DEFAULT_INFO, "Vielleicht kann Euch Isis weiterhelfen.","sagt ");
  
  AddInfo( ({"isis","geliebte","liebe"}),
     "Isis ist meine Geliebte und auch meine Schwester.","sagt: ");
  
  AddInfo( ({"schwester"}),
     "Meine Schwester hat mich vor dem Tod gerettet.","sagt: ");
  
  AddInfo( ({"tod"}),
     "Mein Bruder Seth war eifersuechtig auf unsere Liebe. Er hat mich "
     "getoetet und meinen Leichnam zerstueckelt.","sagt: ");
  
  AddInfo( ({"leichnam"}),
     "Isis hat meine Koerperteile wieder zusammengefuegt. Leider fehlte "
     "mein bestes Stueck.","sagt: ");
  
  AddInfo( ({"stueck","penis"}),
     "Isis formte einen Penis aus purem Gold. Anschliessend zeugten wir "
     "Horus","sagt: ");

   AddInfo( ({"horus","sohn"}),
     "Horus ist mein Sohn. Isis kann Euch sicher mehr ueber ihn erzaehlen, "
     "ich habe das meiste schon verdraengt.","sagt: ");
  
  AddInfo( ({"schluessel"}),
     "Ihr meint die Schluessel fuer die Schatzkammer?", "fragt: ");
  
  AddInfo( ({"kristallschluessel"}),
     "Man munkelt das eine Amazone den Schluessel gefunden hat.", "sagt: ");
  
  AddInfo( ({"glasschluessel"}),
     "Der Glasschluessel fiel vom Turm und zerbarst in tausend Splitter.",
     "sagt: ");
  
  AddInfo( ({"moeglichkeit"}),
     "So wie Isis meine Leichenteile zu einem Ganzen gefuegt hat, ist es "
     "auch moeglich den Glasschluessel wieder zusammen zu fuegen. Es gibt "
     "da eine Person, die das kann.", "erklaert: ");

  AddInfo( ({"freundschaft"}), 
    "Freundschaft ist ein Geben und Nehmen.", "sagt laechelnd: ");
  
  AddInfo( ({"wunder"}),
    "Wundern kann man auch ein bisschen nachhelfen. Mit etwas Glueck "
    "laesst sich viel erreichen","sagt: ");
  
  AddInfo( ({"ohren"}),
    "Schmiedin....besaenftigen. ... ein enormes Einfuehlungsvermoegen "
    "und eine .... . ... man um ihre Gunst zu erlangen... . Insel reisen "
    "und ihr dort... . Goldenes Fliess, denn das mag sie besonders gerne. "
    "Ausserdem .... den Gebieten des Silberlandes und noch dazu kommen",
    "sagt: ");
 
  AddInfo( ({"wirbelwind"}),
     "Du willst etwas ueber Wirbelwind erfahren? Nun gut. Dies ist ein sehr "
     "maechtiger Zauber der Amazonen. Dafuer musst Du aber den Speer der Winde "
     "basteln.","sagt: ");

  AddInfo( ({"speer der winde"}),
     "Der Speer der Winde ist ein maechtiger Speer. Man muss ihn selbst basteln "
     "damit er magisch aufgeladen wird. Aber wenn ihr der Anleitung Folge leistet, "
     "dann ist dies kein Problem.","sagt: ");

  AddInfo( ({"speer"}),
     "Ja welchen Speer meint ihr? Ihr seid mir ganz lustig oder? Es gibt "
     "zuviele Speere.","lacht: ");
 
  AddInfo( ({"anleitung"}),
     "Fuer den Speer der Winde benoetigt man einen Kristallstab, etwas goldenes "
     "Vlies, je einen Elementaredelstein und ein bisschen Luftkraut.","sagt: ");
 
  AddInfo( ({"luftkraut"}),
     "Das Luftkraut waechst hoch im Gebirge in einem Wald aus purem Stein.","sagt: ");

   AddInfo( ({"gebirge","wald"}),
     "Wer suchet der findet.","sagt: ");
   
   AddInfo( ({"goldenes vlies","vlies"}),
     "Goldenes Vlies bekommt ihr auf einer kleinen Insel, die voll von Hexen "
     "ist.","sagt: ");
    
   AddInfo( ({"hexen","hexe"}),
     "Die Hexen wohnen dort auf der Insel.","sagt: ");
   
   AddInfo( ({"insel"}),
     "Mit einem Hexenbesen gelangt man zu dieser Insel.","sagt: ");
  
   AddInfo( ({"hexenbesen","besen"}),
     "Den Hexenbesen muesst ihr wohl selbst finden.","sagt: ");
        
   AddInfo( ({"elementaredelstein","elementaredelsteine"}),
     "Topas, Granat, Rubin, Aquamarin, Smaragd und Saphir zaehlen zu den "
     "wertvollen Elementaredelsteinen.","sagt: ");
	 
   AddInfo( ({"topas","granat","rubin","saphir","smaragd","aquamarin"}),
     "Ihr muesst schon selbst sehen wo ihr Elementaredelsteine herbekommt.","sagt: ");
	 
   AddInfo( ({"kristallstab"}),
     "Hmmmm..... Lasst mich kurz ueberlegen. Irgendwo habe ich schon so einen "
     "Kristallstab herumliegen sehen. Ich glaube es lag mal einer im Burghof "
     "herum aber eine Dienerin hat ihn weggeraeumt. Ich denke in irgendeinem "
     "Schrank hier in der Burg wird er wohl noch sein.","sagt: ");
	   
   AddInfo( ({"dienerin"}),
     "Huebsche Dienerinnen gibt es hier. Und alle so fleissig. Emsig wie Bienchen "
     "wuseln sie herum und raeumen alles brav auf.","sagt: ");
	   
   AddInfo( ({"stab"}),
     "Mit einem normalen Stab werdet ihr wohl kein Glueck haben.","sagt: ");
	     
   AddInfo( ({"glueck"}),
     "Glueck ist relativ. Aber viele Leute wuenschen sich Glueck.","sagt: ");
	      
   AddInfo( ({"wunsch"}),
     "Passt auf was ihr euch wuenscht, es koennte euch gewaehrt werden.","sagt: ");
  
   SetProp( P_REJECT, ({ REJECT_GIVE,
    "Osiris sagt: Ich habe keine Verwendung fuer irdische Dinge!\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(4,500,
    "Osiris schlitzt Dir mit seinem Todesspeer den Bauch auf.\n",
    "Osiris schlitzt @WEN mit seinem Todesspeer den Bauch auf.\n",    
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,900,
   "Osiris schlaegt Dir mit der Faust ins Gesicht.\n",
   "Osiris schlaegt @WEM mit der Faust ins Gesicht.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1200,		  
   "Osiris beschwoert einen riesige Feuerwelle.\n",
   "Osiris vernichtet @WEM mit einer riesigen Feuerwelle.\n",
  DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(5,600,DS_SLOW,
   "Osiris goettlichen Maechte behindern Dich beim Kampf.\n",
   "Osiris goettliche Maechte behindern @WEM beim Kampf.\n");
 
  
  AddSpell(5,900,
   "Osiris reisst Dir Deine Seele aus dem Leib.\n",
   "Osiris reisst @WEM die Seele aus dem Leib.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 600, DS_PARALYZE);
    
 
  SUID;
//   CLONEME("/p/weapon/spear/dreizack" );
//   command("zuecke dreizack");
//   CLONEME("/p/armour/trousers/lederhose");
//   command("trage alles");
//   CLONEME(OBJ "wasserherz.lpc" );
}
 void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "schimpft: Wagt es nicht noch einmal Fremder!",
          "schimpft: "+TP->name(WER)+" wagt es nicht noch einmal!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "sagt: Ihr seid mit einem Fuss im Grab"+TPN+"!",0);
      break;
  case "traurig":
    call_out("react", 0, "troestet Dich "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "laechelt souveraen.",0);
       break;
  case "neutral":
    call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEN)+" zu.");
      break;
  case "intim":
    call_out("react", 0, "sagt: Das darf nur Isis!",
	"weist	"+TP->name(WEN)+" zurecht.");
      break;
  case "froh":
    call_out("react", 0, "zwinkert Dir laechelnd zu.",
             "zwinkert "+TP->name(WEN)+" laechelnd zu.");
      break;
  case "aengstlich":
    call_out("react", 0, "lacht Dich aus.",
             "lacht "+TP->name(WEM)+" aus.");
      break;
  case "frech":
    call_out("react", 0, "droht Dir mit seinem Todesspeer.", "droht "
		     +TP->name(WEN)+" mit seinem Todesspeer.");
      break;
  case "nett":
    call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
		    " an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" sagt: Ihr seid bald tot!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

  string long()
 {
  if( TP->QueryProp(P_GENDER)==MALE )
  SetProp(P_LONG,
    "Osiris, der Gott des Todes steht in seiner ganzen Pracht vor Dir. Du " 
    "beginnst am ganzen Koerper zu zittern als Du seinen starken Koerperbau "
    "siehst. Du bist Dir ziemlich sicher, das ein einziger Hieb seines "
    "goettlichen Speeres Dich vernichten wuerde. Seine langen nachtschwarzen "
    "Haare wallen ihm um die Schultern. Irgendwie scheint es, als wuerden "
    "viele kleine Flammen um seine Haare lodern. Seine smaragdgruenen Augen "
    "strahlen eine Haerte aus, die Du noch nie zuvor gesehen hast.");
  
   else
	   
    SetProp(P_LONG, 
      "Osiris, der Gott des Todes steht in seiner ganzen Pracht vor Dir. Du "
      "siehst seinen starken Koerperbau und fuehlst Dich irgendwie von ihm "
      "angezogen. Dir ist bewusst, das ein einziger Hieb seines goettlichen "
      "Speeres, Deinen weiblichen Koerper in Stuecke fetzen koennte. Aber "
      "das ist Dir egal. Du bewunderst seine nachtschwarzen Haare, die ihm "
      "seidig um die Schultern fallen und seine grossen smaragdgruenen "
      "Augen, die soviel Staerke ausstrahlen. Auch wenn man es ihm ansieht, "
      "das er aus dem Reich der Toten stammt, verringert es kein bisschen "
      "seine enorme Ausstrahlung, die er auf Dich ausuebt.");
  return ::long();
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if (MENV)
    tell_room(MENV, 
      "Osiris verschwindet ins Reich der Toten.\n");
  deep_remove(1);
}
void daemon()
{
  object daemon;
  tell_room(ENV(TO), "Osiris beschwoert einen Daemon, der ihn im Kampf unterstuetzt.\n");
  daemon=clone_object (NPC "/d/dschungel/chivas/tempel/npc/dwizard" );
  daemon->move(ENV(TO), M_GO|M_NOCHECK);
}

void Attack(object enemy)
{
   ::Attack(enemy);
   if (!random(5))
    daemon();
}
 
   
