// Engel


inherit "std/mnpc";
inherit "/std/npc/spells";

#include "../def.h"
#include <npc/combat.h>

string info_betoeren();

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Lady Zarah, das Engelmaedchen");
  SetProp(P_LONG, "Zarah ist ein schlankes, junges Engelsmaedchen. Sie sieht "
          "aus wie 20 Jahre, jedoch ist sie gewiss um einiges aelter. Ihre "
          "langen, goldenen Locken wehen im Wind und ihre grossen hellblauen "
	  "Augen strahlen eine grosse Reinheit aus. Ihre zarten Fluegel "
	  "strahlen perlmuttweiss im Sonnenlicht. Sie ist ein aeusserst "
	  "schoenes Geschoepf. Es hat den Anschein als waere all die Anmut "
	  "und Schoenheit in ein Wesen geflossen.");
  SetProp(P_NAME, "Lady Zarah");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"lady","zarah","engelmaedchen","engel","maedchen"}) );
  create_default_npc(45);
  SetProp(P_HANDS, ({" mit seinen goettlichen Haenden",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Engel");
  SetProp(P_SIZE, 170);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_MATERIAL, MAT_MISC_HOLY);
  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "fliegt herein und legt ihre Fluegel an");
  SetProp(P_MSGOUT, "oeffnet ihre Fluegel und fliegt davon");
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  //SetProp(P_NOATTACK, "ist ein Engel und kann nicht getoetet werden.");
  
  SetProp(P_MNPC_FLAGS, 0);  
  AddInfo(DEFAULT_INFO, "sagt: Belaestigt mich nicht mit irdischen Dingen.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Ein Engel benoetigt sowas nicht.\n" }));

  SetChats(1, ({ "Lady Zarah streicht sich eine Locke aus dem Gesicht.\n",
		 "Lady Zarah nimmt die Hand vom Erzengel.\n",
		 "Lady Zarah blickt den Erzengel verliebt an.\n"}));

  SetProp(P_SPELLRATE, 35);
  AddSpell(2, 550,
    Name(WER,1) + " blickt Dir tief in die Augen und verwirrt Deinen Willen.\n",
    Name(WER,1) + " blickt @WEM tief in die Augen und verwirrt @WENs Willen.\n",
    DT_MIND, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(1, 450,
    Name(WER,1) + " laesst ein sanftes Leuchten um Dich tanzen, das Dich schwaecht.\n",
    Name(WER,1) + " laesst ein sanftes Leuchten um @WEN tanzen, das @WEN schwaecht.\n",
    DT_MAGIC, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(2, 250, DS_PARALYZE,
    Name(WER,1) + " laesst Dich mit einem Blick erstarren.\n",
    Name(WER,1) + " laesst @WEN mit einem Blick erstarren.\n",
    3);

SUID;
    CLONEME(ARMOUR "wtoga.lpc" );
    CLONEME(ARMOUR "handschmuck.lpc" );
    CLONEME(ARMOUR "armschmuck.lpc" );
    CLONEME(ARMOUR "stirnreif.lpc" );
    command("trage alles");
   
  
  //AddInfo("betoeren", #'info_betoeren, "sagt: ");

 
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "schaut Dich wuetend an.",
	       "schaut "+TP->name(WEM)+ "wuetend an.");
     break;

   case "intim":
     call_out ("react", 0, "weist Dich in Deine Grenzen.",
	"weist "+TP->name(WEM)+ " zurecht.");

    break;

   case "aergerlich":
     call_out("react", 0, "droht Dir mit der Hoelle.",
	      "droht "+TP->name(WEN)+" mit der Hoelle.");
     break;

   case "frech":
     call_out("react", 0, "fragt Dich: Wollt Ihr in der Hoelle schmoren?",
	      "baut sich vor "+TP->name(WEN)+" auf.");
     break;
   
    default:
      call_out("react", 0, "knuddelt Dich.",
	       "laechelt goettlich.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 


string info_betoeren()
{
  mapping sk;
  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "Das Wissen ueber das Betoeren teile ich nur mit Amazonen!";

  if (TP->QuerySkill("betoeren"))
    return "Aber Du kannst Betoeren ja schon!";

  if (TP->amazonen_shadow_test())
    return "Mach nur weiter und verfuehre mehr Maenner.";

  return "Versuch einfach einige Maenner zu betoeren, bis sie sich an Dich "
    "ranmachen. Nach einiger Zeit wirst Du dann jeden Mann um den Finger "
    "wickeln koennen, bis sie sogar ihre Leben fuer Dich opfern.";
}


   
