//von Aaliyah 
//Dinah die Amazonenwirtin


inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Dinah, die Amazonenkoechin");
  SetProp(P_LONG,
    "Dinah ist eine kleine, niedliche Hobbitdame. Sie scheint noch ziemlich "
    "jung zu sein, was aber keinerlei Auswirkungen auf ihre tollen Kochkuenste "    "hat. Man sagt ihr sogar nach, sie sei die beste Koechin im ganzen "
    "Silberland. Ihre kastanienbraunen, langen Haare hat sie zu zwei Zoepfen "
    "gebunden. Ihr zarter Koerper wurde von Aphrodite enthaart, da sie sonst "
    "in ihrer Toga sehr unaesthetisch wirken wuerde. Ihre haselnussbraunen " 
    "Rehaugen gucken Dich freundlich an.");
    
  SetProp(P_NAME, "Dinah, die Amazonenkoechin");
  SetProp(P_GENDER, FEMALE);
  AddId(({"dinah", "hobbit", "koechin","amazonenkoechin","amazone",
			  "Speermeister"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("Dinah");

  create_default_npc(29,1500);
  SetProp(P_HANDS, ({" mit ihren Fingernaegeln",300,DT_RIP}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 60);
  SetProp(P_WEIGHT, 18000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,40);
  SetProp(P_GUILD, "amazonen");
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.0, DT_WATER:  0.1, DT_AIR:   -1.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.1, DT_POISON: 0.1, DT_TERROR: 0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.1, DT_MAGIC:  -1.0, DT_MIND:   0.0,
      DT_SLASH:     0.0, DT_PIERCE:   0.0, DT_BLUDGEON: 0.0]) );

  SetProp(P_MSGIN, "tanzt summend herein");
  SetProp(P_MSGOUT, "tanzt summend davon");
  SetProp(P_MMSGIN, "klettert aus einem Kochtopf");
  SetProp(P_MMSGOUT, "klettert in einen Kochtopf");
  SetProp(P_DIE_MSG,  "bricht erbaermlich zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Jetzt hab ich aber die Nase voll!!");
  SetProp(P_KILL_NAME, "Dinah, die Amazonenkoechin");
  SetProp(P_KILL_MSG, "Gruess die Anderen von mir!");

  AddInfo(DEFAULT_INFO, "sagt: Das kann ich Euch leider nicht sagen.");
  
  AddInfo( ({"essen","kochen"}), 
    "Ich bin eine goettliche Koechin.", "sagt: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt die Hexen!","sagt: ");
    
  AddInfo( ({"koechin"}),
     "Ich bin die beste Koechin im ganzen Silberland!","sagt: ");
     
  AddInfo( ({"edynia"}),
     "Edynia ist die Insel der Amazonen.","sagt: ");
     
  AddInfo( ({"berserker"}),
     "Das sind doch lauter Waschlappen.","fragt: ");
     
  AddInfo( ({"paladine"}),
     "Paladine sind grosse Jammerlappen.","sagt: ");
     
  AddInfo( ({"druiden"}), 
     "Die Druiden sind ohne ihre Elementare aufgeschmissen.","sagt: ");
     
  AddInfo( ({"ayla"}),
     "Ayla wollte mich verfuehren.","sagt: ");
     
  AddInfo( ({"kronang","zechus"}),
     "Lass mich mit dem Macho in Ruhe!","schimpft: ");
  
  AddInfo( ({"anvar"}),
     "Das ist ein alter Tattergreis.","sagt laechelnd: ");
   
      
  AddInfo( ({"dill","thymian","salbei","rosmarin","fenchel","safran"}),
      "Diese Gewuerze brauche ich zum Kochen!","sagt genervt: ");
      
   
  AddInfo( ({"feyaria"}),
      "Feyaria ist die Mutter der Berserker. Alle ihre Kinder haengen "
      "an ihrer Brust","sagt: ");
      
  AddInfo( ({"hihi"}),
      "Hihi ist der liebste Oger den es gibt.","sagt: ");
      
  AddInfo( ({"fenris"}),
      "Fenris ist der schoenste aller Elfenmaenner."," schwaermt: ");
      
  AddInfo( ({"andruil"}),
      "Andruil war eine Legende."," seufzt: ");
      
  AddInfo( ({"atreju"}),
      "Elfenheld Atreju ist ein sehr gehaessiges Wesen."," sagt: ");
      
  AddInfo( ({"turgon"}),
      "Turgon ist ein sehr maechtiger Druide."," erklaert: ");
      
  AddInfo( ({"willi"}),
      "Willi ist ein Zwerg und ich finde Zwerge unerotisch.","sagt: ");
      
  AddInfo( ({"andronicus"}),
      "Andronicus ist einer der liebsten Paladine.","schwaermt: ");
      
  AddInfo( ({"steak","auflauf","sorbet","suppe"}),
      "Ach, probiert es doch einfach.","seufzt: ");
      
      
  AddInfo( ({"aaliyah"}),
      "Aaliyah ist die Mutter aller Hexen.","sagt: ");

   SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Dinah zerstoert Dein Zeug.\n" }) );

  SetProp(P_SPELLRATE, 99);
  AddSpell(4,550,
    "Dinah haut Dir ihren Kochloeffel ueber den Kopf.\n",
    "Dinah haut @WEN ihren Kochloeffen ueber den Kopf.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,400,
  "Dinah sticht Dir eine Gabel in die Hand.\n",
  "Dinah sticht @WEM in die Hand.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,800,
  "Dinah reisst Dir ein grosses Bueschel Haare aus.\n",
  "Dinah reisst @WEM ein grosses Bueschel Haare aus.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,1000,
  "Dinah schlitzt Dir mit ihrem Speer den Bauch auf.\n",
  "Dinah schlitzt @WEM mit ihrem Speer den Bauch auf.\n",
  DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
  "Dinah beisst Dir Deine Nase blutig.\n",
  "Dinah beisst @WEM die Nase blutig.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
    
  AddDefaultSpell(3, 1000, DS_FROG);

  SetChats(1, ({"Dinah fragt: Moechtet Ihr was essen Fremder?\n",
            "Dinah nimmt einige Gewuerze aus einer Tonschale.\n",
            "Dinah wuerzt die Suppe und schmeckt sie ab.\n",
            "Dinah giesst den Braten auf.\n",
            "Dinah fuellt etwas Sorbet in kleine Formen.\n",
	    "Dinah ruehrt die Suppe um.\n",
	    "Dinah schneidet etwas Gemuese klein.\n",
	    "Dinah dekoriert ein Glas mit Orchideencocktail.\n",
	    "Dinah fuellt eine Karaffe mit Rosenwein.\n",
	    "Dinah kostet die Sauce fuer den Braten.\n",
	    "Dinah zerstampft einige Nuesse in einem Moerser.\n",
	    "Dinah nimmt einen kleinen Schluck Burgunder.\n",
	    "Dinah wischt sich den Schweiss aus dem Gesicht.\n",
	    "Dinah befestigt eine Haarstraehne mit einer Spange.\n"}));
  
  SUID;
  CLONEME( "/gilden/amazonen/weapon/amazonenspeer.lpc" );
  command("zuecke waffe");
  CLONEME(ARMOUR "toga.lpc" );
  CLONEME(ARMOUR "stirnreif.lpc" );
  CLONEME(ARMOUR "armschmuck.lpc" );
  CLONEME(ARMOUR "handschmuck_silber.lpc" );
  command("trage alles");
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
   case "fies":
      if( random(2) )
        call_out("react", 0, "sagt: Ihr habt keine Manieren Fremder!",
          "sagt: "+TP->name(WER)+" hat keine Manieren");
      else
        call_out("angriff",0);
      break;
   case "aergerlich":
      call_out("react", 0, "fragt: Warum geht Ihr nicht spielen, "+TPN+"?",0);
      break;
   case "traurig":
      call_out("react", 0, "nimmt Dich troestend in die Arme.",
             "troestet "+TP->name(WEN)+" sanft.");
      break;
   case "albern":
      call_out("react", 0, "laechelt.",0);
       break;
    case "neutral":
      call_out("react", 0, "ignoriert Dich.", "beachtet "+TP->name(WEN)+
		      " nicht.");
      break;
    case "intim":
      call_out("react", 0, "haut Dich.", "schlaegt "+TP->name(WEN)+" fest.");
      break;
    case "froh":
      call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "legt beschuetzend ihre Arme um Dich.",
             "umarmt "+TP->name(WEM)+" beschuetzend.");
      break;
    case "frech":
      call_out("react", 0, "grummelt Dich an.", "grummelt "+TP->name(WEN)+" an.");
      break;
    case "nett":
	          call_out("react", 0, "knuddelt Dich.", "knuddelt "
				  +TP->name(WEN)+" lieb.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" seufzt: Nun muesst Ihr sterben.\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

