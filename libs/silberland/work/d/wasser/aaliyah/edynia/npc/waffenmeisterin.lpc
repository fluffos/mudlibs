// von Aaliyah
// die Waffenmeisterin

inherit "std/repair";

#include "../def.h"
#include "/gilden/amazonen/def.h"

string neue_ruestung();
string info_speerstoss();
string info_spiegelbild();
string info_aufspiessen();
string info_speertanz();
string info_durchbohren();

void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
    call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Die Waffenmeisterin mustert Dich und Deine Ruestung.\n");
}

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ulyssa, die Waffenmeisterin der Amazonen");
  SetProp(P_LONG,
    "Vor Dir steht Ulyssa, die Waffenmeisterin der Amazonenburg. Sie ist eine "
    "sehr grosse Frau mit breiten Schultern und kraeftigen Armen, aber einer "
    "schlanken Taille. Sie gilt als eine der besten Speerkaempferinnen unter "
    "den Amazonen und gibt ihr Wissen an die jungen Schuelerinnen weiter. "
    "Ihr langes, kastanienbraunes Haar hat sie zu einem langen Zopf "
    "geflochten, damit ihre Haare sie nicht im Kampf behindern. Ihre "
    "ebenfalls braunen Augen blicken Dich neugierig an."); 
                   
  SetProp(P_GENDER, FEMALE);
  AddId(({"ulyssa", "waffenmeisterin", "Speermeister" }));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Ulyssa");

  create_default_npc(45,3000);
  SetProp(P_HANDS, ({" mit ihren harten Haenden", QueryProp(P_HANDS)[1],
        DT_BLUDGEON}));
  SetProp(P_BODY, QueryProp(P_BODY) + 50);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 188);
  SetProp(P_WEIGHT, 64000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_GUILD, "amazonen");
  SetProp(P_GUILD_LEVEL, 9);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.1, DT_COLD:     -0.2, DT_WATER: -0.2, DT_AIR:    0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:     -0.2, DT_POISON:-0.2, DT_TERROR: 0.1,
      DT_HOLY:     -0.2, DT_UNHOLY:   -0.3, DT_MAGIC: -0.2, DT_MIND:   0.0,
     DT_SLASH:     -0.1, DT_PIERCE:   -0.2, DT_WHIP:  -0.3, DT_BLUDGEON: -0.2]) );

  SetProp(P_MSGIN, "beginnt ihren Dienst als Waffenmeisterin");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint aus einem Lichtblitz");
  SetProp(P_MMSGOUT, "verschwindet in einem Lichtblitz");
  SetProp(P_DIE_MSG,  " stirbt einen Amazonentod.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Die Rache der Amazonen wird Dich ereilen, %s!");
  SetProp(P_KILL_MSG, "Lege Dich nie wieder mit uns Amazonen an!");

  AddInfo(DEFAULT_INFO, "sagt: Langweile mich nicht mit sinnlosen Fragen!");

  AddInfo( ({"waffen", "waffe", "speer", "ruestung", "ruestungen",
      "ausruestung", "ausruestungen"}),
      "Ich bin fuer die Waffen und Ruestungen zustaendig. Wenn Du eine "
      "neue Ausruestung brauchst, dann frage mich einfach nach neuer ruestung.",
      "sagt: ");
  AddInfo( ({"neuer ruestung", "neue ruestung"}), #'neue_ruestung);

  AddInfo( ({"reparatur", "reparieren", "repariere"}),
      "Ich repariere Dir gern Ausruestung, aber nur Speere und "
      "Metallruestungen. Gib dazu einfach 'repariere <ding>' ein, dann sage "
      "ich Dir vorher auch den Preis.",
      "sagt: ");
  AddInfo( ({"kosten", "preis", "geld", "muenzen"}),
      "Eine neue Ruestung ist fuer Amazonen kostenlos, aber nur einmal pro "
      "Neustart. Reparaturen kosten Muenzen; je schwerer beschaedigt und je "
      "wertvoller das Stueck, desto teurer.",
      "sagt: ");
  AddInfo( ({"hilfe", "infos", "info", "fragen"}),
      "Frag mich z.B. nach neuer ruestung, reparatur, speerstoss, "
      "aufspiessen, spiegelbild, speertanz oder durchbohren.",
      "sagt: ");
      
  
  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1) + " sagt: Danke, aber ich brauche das nicht!\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(2,700,
    Name(WER,1) + " rammt Dir ihren Speer in den Brustkorb.\n",
    Name(WER,1) + " rammt @WEM ihren Speer in den Brustkorb.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1500,
    Name(WER,1) + " beschwoert einen gewaltigen Blitz auf Dich herab.\n",
    Name(WER,1) + " beschwoert einen gewaltigen Blitz auf @WEN herab.\n",
    DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));

  SetChats(4, ({
        Name(WER,1) + " poliert ihre Beinschienen.\n",
        Name(WER,1) + " probiert eine neues Paar Sandalen an.\n",
        Name(WER,1) + " legt Armschienen in ein Regal.\n",
        Name(WER,1) + " prueft die Schaerfe der Speerspitzen.\n",
        Name(WER,1) + " sagt: Ich bin die Waffenmeisterin der Amazonen!\n",
        Name(WER,1) + " zeigt Dir einen glaenzenden Schild.\n",
        Name(WER,1) + " bewundert ihr Waffenarsenal.\n",
        Name(WER,1) + " sortiert die Helme.\n",
        Name(WER,1) + " zaehlt die Speere.\n",
        Name(WER,1) + " kontrolliert einen Brustpanzer.\n",}));
  
  SUID;
  CLONEME("/gilden/amazonen/weapon/off_speer" );
  command("zuecke speer");
  CLONEME("/gilden/amazonen/armour/beinschienen");
  CLONEME("/gilden/amazonen/armour/armschienen");
  CLONEME("/gilden/amazonen/armour/waffengurt");
  CLONEME("/gilden/amazonen/armour/guilditem");
  CLONEME("/gilden/amazonen/armour/brustharnisch");
  CLONEME("/gilden/amazonen/armour/helm3");
  command("trage alles");
    
  AddInfo("speerstoss", #'info_speerstoss, "sagt: ");
  AddInfo("aufspiessen", #'info_aufspiessen, "sagt: ");
  AddInfo("spiegelbild", #'info_spiegelbild, "sagt: ");
  AddInfo("speertanz", #'info_speertanz, "sagt: ");
  AddInfo("durchbohren", #'info_durchbohren, "sagt: ");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      if( random(2) )
        call_out("react", 0, "fragt: Wollt Ihr meinen Speer spueren?",
            "fragt: "+TP->name(WER)+" wollt Ihr meinen Speer spueren?");
      else
        call_out("angriff",0);
      break;
    case "aergerlich":
      call_out("react", 0, "sagt: Ich hab fuer solchen Unfug keine Zeit "+TPN+".",0);
      break;
    case "traurig":
      call_out("react", 0, "troestet Dich laechelnd "+TPN+".",0);
      break;
    case "albern":
      call_out("react", 0, "grinst Dich an.",0);
      break;
    case "neutral":
      call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEN)+" zu.");
      break;
    case "intim":
      call_out("react", 0, "durchdringt Dich mit ihren Augen. ",
          "durchdringt "+TP->name(WEN)+" mit ihren Augen.");
      break;
    case "froh":
      call_out("react", 0, "strahlt Dich froehlich an.",
          "strahlt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "ermutigt Dich.",
          "ermutigt "+TP->name(WEM)+" etwas.");
      break;
    case "frech":
      call_out("react", 0, "kneift Dich in die Nase.", "kneift "
          +TP->name(WEN)+" in die Nase.");
      break;
    case "nett":
      call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
          " an.");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" schimpft: Ihr habts nicht anders gewollt!\n");
    Kill(TP);
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
        dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

int rep_auswahl(object ob)
{
  if (ob->QueryProp(P_WEAPON_TYPE))
  {
    if (ob->QueryProp(P_WEAPON_TYPE) != WT_SPEAR)
    {
      write(Name(WER,1) + " sagt: Ich repariere nur Speere!\n");
      return 0;
    }
    return 1;
  }
  if( ob->QueryMaterialGroup(MATGROUP_METAL)<20 )
  {
    write(Name(WER,1) + " sagt: Ich repariere nur Metallruestungen!\n");
    return 0;
  }
  return 1;
}

string neue_ruestung()
{
  int g;

  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "sagt: Nur Amazonen bekommen von mir eine neue Ruestung!\n";
  if (AMASTER->QueryArmourTime(TP) > last_reboot_time())
    return "sagt: Du hast ja schon eine Ruestung ausgefasst!\n";
  g = TP->QueryProp(P_GUILD_LEVEL);
  if (!deep_present("speer", TP) && !deep_present("lanze", TP))
  {
    if (g < 8)
      CLONE("/gilden/amazonen/weapon/amazonenspeer", TP);
    else
      CLONE("/gilden/amazonen/weapon/off_speer", TP);
    TP->command_me("zuecke speer");
  }
  if (TP->QueryProp(P_FREE_HANDS) >= 1 && !present("schild", TP) &&
      !sizeof(TP->QueryArmours(AT_SHIELD)))
    CLONE("/gilden/amazonen/armour/rundschild", TP);
  if (!sizeof(TP->QueryArmours(AT_HELMET)))
  {
    if (g < 5)
      CLONE("/gilden/amazonen/armour/helm", TP);
    else if (g < 8)
      CLONE("/gilden/amazonen/armour/helm2", TP);
    else
      CLONE("/gilden/amazonen/armour/helm3", TP);
  }
  if (!sizeof(TP->QueryArmours(AT_ARMOUR)))
   CLONE("/gilden/amazonen/armour/brustharnisch", TP);
  if (!sizeof(TP->QueryArmours(AT_CLOAK)))
  {
    if (g >= 8)
      CLONE("/gilden/amazonen/armour/off_umhang", TP);
    else
      CLONE("/gilden/amazonen/armour/umhang", TP);
  }
  if (!sizeof(TP->QueryArmours(AT_BRACERS)))
   CLONE("/gilden/amazonen/armour/armschienen", TP);
  if (!sizeof(TP->QueryArmours(AT_GLOVE)))
   CLONE("/gilden/amazonen/armour/handgelenksmanschetten", TP);
  if (!sizeof(TP->QueryArmours(AT_BELT)))
   CLONE("/gilden/amazonen/armour/waffengurt", TP);
  if (!sizeof(TP->QueryArmours(AT_TROUSERS)))
  {
    if (member(({"Troll", "Oger", "Zwerg"}), TP->QueryProp(P_RACE)) == -1)
      CLONE("/gilden/amazonen/armour/rock", TP);
    else
      CLONE("/gilden/amazonen/armour/beinschienen", TP);
  }
  if (!sizeof(TP->QueryArmours(AT_BOOT)))
   CLONE("/gilden/amazonen/armour/sandalen", TP);
  TP->command_me("trage alles");
  AMASTER->SetArmourTime(TP);
  return "sagt: Hier bitte sehr.\n";
}

string info_speerstoss()
{
  mapping sk;
  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "Das Wissen ueber den Speerstoss teile ich nur mit Amazonen!";

  if (TP->QuerySkill("speerstoss"))
    return "Aber Du kannst Speerstoss ja schon!";

  return "Um den Speerstoss zu erlernen, musst Du zuerst einmal ein engeres "
    "Verhaeltnis zu Deinem Speer aufbauen. Und das geht am besten, wenn Du "
    "Dir selbst einen Speer baust.";
}

void give_notify(object ob)
{
  if(ob->id("QUEST-SPEER") &&
     TP->QueryProp(P_GUILD) == "amazonen")
  {
    write(break_string(
          "Da Du nun weisst, worauf es bei einem Speer ankommt, bringe ich "
          "Dir nun den Speerstoss bei.",
          78, "Ulyssa sagt: "));
    ob->remove();
    find_object("/gilden/amazonen")->LearnSpell("speerstoss", TP); 
    return;
  }
  return ::give_notify(ob);
}

string info_spiegelbild()
{
  mapping sk;
  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "Das Wissen ueber das Spiegelbild teile ich nur mit Amazonen!";

  if (TP->QuerySkill("spiegelbild"))
    return "Aber Du kannst Spiegelbild ja schon!";

  if (present("\namazonen_spiegelbild_quest", TP))
    return "Los geh und toete Dein Spiegelbild, dann wirst Du auch Dein "
      "Spiegelbild im Kampf herbeirufen koennen.";

  return "Um Spiegelbild zu erlernen, musst Du zuerst einmal Dein "
    "Spiegelbild besiegen. Im Dschungel gibt es eine Stelle, wo dies "
    "moeglich ist. Nun geh, und besiege Dein Spiegelbild!";
}

string info_aufspiessen()
{
  mapping sk;
  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "Das Wissen ueber das Aufspiessen teile ich nur mit Amazonen!";

  if (TP->QuerySkill("aufspiessen"))
    return "Aber Du kannst Aufspiessen ja schon!";

  if (present("\namazonen_aufspiessen_quest", TP))
    return "Los geh und toete Shagraz in Tijara, dann wirst Du auch "
      "Aufspiessen im Kampf verwenden koennen.";

  return "Der haessliche Ork Shagraz in Tijara haelt sich selbst fuer "
    "einen Experten was Speere anbelangt. Zeige ihm, dass Du es besser "
    "kannst und besiege ihn. Dann wird Dir auch das Wissen ueber die "
    "maechtige Kampffaehigkeit 'Aufspiessen' zuteil werden!";
}

string info_speertanz()
{
  mixed *entry;

  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "Das Wissen ueber den Speertanz teile ich nur mit Amazonen!";

  if (TP->QuerySkill("speertanz"))
    return "Aber Du kannst Speertanz ja schon!";

  if (TP->QueryProp(P_GUILD_LEVEL) < 12)
    return "Speertanz kannst Du erst ab Gildenstufe 12 erlernen.";

  entry = AMASTER->QueryMemberEntry(getuid(TP));
  if (pointerp(entry) && sizeof(entry) > POS_ORDER &&
      stringp(entry[POS_ORDER]) &&
      entry[POS_ORDER] != AMAZONEN_ORDEN_SPEERSEELE)
    return "Speertanz ist eine Technik der Speertaenzerinnen.";

  return "Du fuehrst schnelle Speerbewegungen in Abfolge aus. Der Speertanz "
    "ist eine offensive Technik, die im Kampf besonderen Druck aufbaut; "
    "dadurch wird Dein Speerkampfschaden erhoeht. Kommando: speertanz "
    "(Kosten: 50 MP).";
}

string info_durchbohren()
{
  mixed *entry;

  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "Das Wissen ueber das Durchbohren teile ich nur mit Amazonen!";

  if (TP->QuerySkill("durchbohren"))
    return "Aber Du kannst Durchbohren ja schon!";

  if (TP->QueryProp(P_GUILD_LEVEL) < 15)
    return "Durchbohren kannst Du erst ab Gildenstufe 15 erlernen.";

  entry = AMASTER->QueryMemberEntry(getuid(TP));
  if (pointerp(entry) && sizeof(entry) > POS_ORDER &&
      stringp(entry[POS_ORDER]) &&
      entry[POS_ORDER] != AMAZONEN_ORDEN_SPEERSEELE)
    return "Durchbohren ist eine Technik der Speertaenzerinnen.";

  return "Du nimmst Anlauf und versuchst, Deinen Gegner mit dem Speer zu "
    "durchbohren. Dieser Angriff wird staerker, je mehr negative Effekte "
    "Dein Gegner bereits erleidet. Kommando: durchbohren [<gegner>] "
    "(Kosten: 45 MP).";
}


