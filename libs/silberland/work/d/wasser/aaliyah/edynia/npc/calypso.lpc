//Calypso, die Kammerzofe

inherit "std/npc";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Calypso saeuselt: Braucht Ihr eine Ruestung?\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Calypso, die Kammerzofe");
  SetProp(P_LONG,
    "Calypso ist eine sehr attraktive Elfin. Ihre langen, blauschwarzen Haare "
    "wallen um ihre zarten Schultern. Sie hat ihre Haare hinter ihre spitzen "
    "Ohren geklemmt, damit sie sie nicht bei der Arbeit behindern. Treu und "
    "guetig strahlen ihre amethystvioletten Augen. Eine leichte Toga umhuellt "
    "ihren wohlgeformten Koerper und bringt ihn gut zur Geltung.");
    
  SetProp(P_NAME, ({"Calypso, die Kammerzofe",
                  "Calypso, der Kammerzofe", 
                  "Calypso, der Kammerzofe",
                  "Calypso, die Kammerzofe"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"calypso", "zofe", "kammerzofe","Speermeister"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("calypso");

  create_default_npc(40, 2000);
  SetProp(P_HANDS, ({" mit ihren magischen Haenden",400,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_GUILD, "amazonen");
  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  0.0, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0,
      DT_PIERCE: 0.1, DT_SLASH: -0.2,  DT_BLUDGEON: 0.0]) );

  SetProp(P_MSGIN, "betritt anmutig den Raum");
  SetProp(P_MSGOUT, "verlaesst anmutig den Raum");
  SetProp(P_MMSGIN, "erscheint anmutig");
  SetProp(P_MMSGOUT, "verschwindet anmutig");
  SetProp(P_DIE_MSG,  " bricht blutend zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wer soll jetzt die Amazonen einkleiden?");
  SetProp(P_KILL_NAME, "Calypso, die Kammerzofe");
  SetProp(P_KILL_MSG, "Du warst einfach zu schlecht gekleidet!");

  AddInfo(DEFAULT_INFO, "sagt: Ich habe nur Ahnung von Kleidung.");
  
  AddInfo( ({"kleidung"}), 
    "Kleider machen Leute, darum solltet Ihr Euch gut und sauber kleiden.", 
    "sagt laechelnd: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt die Hexen!","sagt: ");
  
  AddInfo( ({"druiden"}),
     "Die sind doch alle mit ihren Elementaren verheiratet.","schimpft: ");
  
  AddInfo( ({"hose","hosen"}),
     "Hosen sind etwas fuer Maenner, wir Frauen bevorzugen Kleider","sagt: ");
  
  AddInfo( ({"berserker"}),
     "Dazu muss ich jetzt aber nicht wirklich antworten.","sagt: ");
  
  AddInfo( ({"paladine"}),
     "Ich finde ihre rosa Wappenroeckchen toll.","sagt: ");
  
  AddInfo( ({"druiden"}), 
     "Druiden sehen am besten aus wenn sie tot sind.","sagt: ");
  
  AddInfo( ({"nekromanten","zechpreller"}),
     "Mir wird gleich uebel.","sagt: ");
  
  AddInfo( ({"kronang","zechus"}),
     "Der ist nicht einmal erwaehnenswert.","lacht: ");
  
  AddInfo( ({"anvar","tattergreis"}),
     "Der alte Tattergreis hat schon viel zulange gelebt.","sagt laechelnd: ");
  
  AddInfo( ({"kleider","kleid"}),
     "Ach es gibt so wunderschoene Kleider.","schwaermt: ");
  
  AddInfo( ({"roeckchen","rock"}),
     "Wenn Ihr einen Rock benoetigt, so bittet mich einfach darum.","sagt: ");
  
  AddInfo( ({"brustharnisch","harnisch"}),
     "Wenn Ihr einen Brustharnisch benoetigt, so bittet mich einfach darum.",
     "faucht: ");
     
  AddInfo( ({"helm"}),
     "Wenn Ihr einen Helm benoetigt, so bittet mich einfach darum.","sagt: ");
     
  AddInfo( ({"umhang"}),
     "Wenn ihr einen Umhang benoetigt, bittet mich einfach darum.","sagt: ");
  
  AddInfo( ({"sandalen","schuhe","stiefel","riemchensandalen"}),
     "Eine nette Bitte hat schon Wunder bewirkt.","sagt: ");
  
  AddInfo( ({"waffengurt"}),
     "Ja ich habe einen Waffengurt. Wenn Ihr einen benoetigt, bittet mich "
     "einfach darum.","sagt: ");
  
  AddInfo( ({"manschetten","handgelenksmanschetten"}),
     "Wie heisst das Zauberwort?","fragt: ");
  
  AddInfo( ({"armschienen"}),
     "Ich habe auch fuer Euch ein Paar Armschienen.","sagt: ");
  
  
  AddInfo( ({"feyaria"}),
      "Schade dass sie so selten hier ist.","seufzt: ");

  

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Calypso sagt: Danke, aber behaltet Euren Mist.\n" }) );

  SetProp(P_SPELLRATE, 85);
  AddSpell(3,1,
  "Calypso nimmt Dir Deine Ruestung weg und freut sich ueber neue Kleidung.\n",
  "Calypso zieht @WEM splitternackt aus.\n",
   DT_MIND, "ausziehen");
    
 
  AddSpell(4,500,
  "Calypso rammt Dir ihren Speer in den Bauch.\n",
  "Calypso rammt @WEM Dornenklinge in den Bauch.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(6,500,		  
  "Calypso zerkratzt Dir Dein Gesicht.\n",
  "Calypso zerkratzt @WEM das Gesicht.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,800,
  "Calypso starrt Dich entgeistert an.\n",
  "Calypso starrt @WEM mit ihren grossen Augen an.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1500,
  "Calypso springt Dich an und wuergt Dich.\n",
  "Calypso wuergt @WEM.\n",
  DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({"Calypso floetet: Euren Umhang find ich toll.\n",
		       "Calypso fragt: Schenkt Ihr mir Eure Ruestung?\n",
		       "Calypso sagt: Ihr seid ein Jammerlappen!\n",
		       "Calypso fragt: Mehr habt Ihr nicht drauf?\n"}) );
  
    

  SetChats(1, ({"Calypso faltet ein stahlverstaerktes Roeckchen.\n",
		"Calypso putzt eine goldene Riemchensandale.\n",
		"Calypso flickt einen feuerroten Umhang.\n",
		"Calypso steckt sich ein paar Straehnen hinter die Ohren.\n",
		"Calypso legt ein paar Togas zusammen.\n",
		"Calypso saeubert einen Waffengurt.\n",
		"Calypso legt zwei Manschetten in ein kleines Kaestchen.\n",
		"Calypso poliert einen Amazonenhelm.\n"}));
 
  
  SUID;
    CLONEME( "/gilden/amazonen/weapon/amazonenspeer" );
    command("zuecke speer");
    CLONEME(ARMOUR "toga.lpc" );
    CLONEME(ARMOUR "handschmuck_silber.lpc" );
    CLONEME(ARMOUR "armschmuck.lpc" );
    CLONEME(ARMOUR "stirnreif.lpc" );
    command("trage alles");
   
}

 void ausziehen(object enemy)
{
   if (enemy->QueryProp(P_GENDER) == MALE)
 {
	 
   if (sizeof(enemy->QueryProp(P_ARMOURS)))
 {
   command("sag Neue Ruestung kann ich immer brauchen!");
   filter_objects(enemy->QueryProp(P_ARMOURS), "DoUnWear");
   TP->command_me("gib alle ruestungen an calypso");
    
  }
   }
}
  

  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
    call_out("react", 0, "laestert: Eure Kleidung ist unter aller Kritik!",
          "laestert: "+TP->name(WER)+" Eure Kleidung ist unter aller Kritik!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "fragt: Wie behandelt Ihr denn eine Dame?, "+TPN+"?",0);
      break;
  case "traurig":
     call_out("react", 0, "sagt: Nicht traurig sein "+TPN+".",0);
      break;
  case "albern":
     call_out("react", 0, "laechelt zuckersuess.",0);
       break;
  case "neutral":
     call_out("react", 0, "zwinkert Dir verfuehrerisch zu.", "zwinkert "
		     +TP->name(WEN)+" verfuehrerisch zu.");
      break;
  case "intim":
     call_out("react", 0, "beginnt Dich sanft zu streicheln. ",
	"streichelt "+TP->name(WEN)+" sanft.");
      break;
  case "froh":
     call_out("react", 0, "strahlt Dich gluecklich an.",
             "strahlt "+TP->name(WEN)+" gluecklich an.");
      break;
  case "aengstlich":
     call_out("react", 0, "streichelt Dir beruhigend durch die Haare.",
             "streichelt "+TP->name(WEM)+" durch die Haare.");
      break;
  case "frech":
     call_out("react", 0, "zwickt Dich in Dein Hinterteil.", "zwickt "
		     +TP->name(WEN)+" in das Hinterteil.");
      break;
  case "nett":
      call_out("react", 0, "schmiegt sich eng an Dich.", "schmiegt sich bei "
		      +TP->name(WEN)+" an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" sagt: Wer nicht flirten will muss sterben!\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

