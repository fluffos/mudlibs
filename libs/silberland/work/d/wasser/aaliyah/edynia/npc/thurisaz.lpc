// Engel


inherit "std/mnpc";
inherit "/std/npc/spells";

#include "../def.h"
#include <npc/combat.h>

string info_strahlenkranz();

void create()
{
   object ob;
  if (!is_clone(TO)) return;
  
 
  ::create();
  
  SetProp(P_SHORT, "Lord Thurisaz, der Erzengel");
  SetProp(P_LONG, "Thurisaz ist ein grossgewachsener, junger Engel. Du "
          "schaetzt ihn auf 20 Jahre, aber bist Dir sicher, dass er gewiss "
          "bedeutend aelter ist. Seine langen, seidigweissen Haare, wehen "
	  "im Wind und seine grossen himmelblauen Augen strahlen pure Reinheit "
	  "aus. Sein schlanker Koerper strahlt eine imense Anmut aus, was aber "
	  "bei so einer goettlichen Erscheinung nicht verwunderlich ist. "
	  "Seine grossen Fluegel glaenzen perlmuttweiss im Sonnenlicht.");
  SetProp(P_NAME, "Lord Thurisaz");
  SetProp(P_GENDER, MALE); 
  AddId( ({"lord","thurisaz","erzengel","engel"}) );
  create_default_npc(45);
  SetProp(P_HANDS, ({" mit seinen goettlichen Haenden",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Engel");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 68000);
  SetProp(P_MATERIAL, MAT_MISC_HOLY);
  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "fliegt herein und legt seine Fluegel an");
  SetProp(P_MSGOUT, "oeffnet seine Fluegel und fliegt davon");
  SetProp(P_MMSGIN, "schwebt herein");
  SetProp(P_MMSGOUT, "schwebt davon");
  //SetProp(P_NOATTACK, "ist ein Engel und kann nicht getoetet werden.");
  
  SetProp(P_MNPC_FLAGS, 0);  
  AddInfo(DEFAULT_INFO, "sagt: Belaestigt mich nicht mit irdischen Dingen.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Ein Engel benoetigt sowas nicht.\n" }));

  SetChats(1, ({ "Lord Thurisaz streicht ueber seine Fluegel.\n",
		 "Lord Thurisaz fluestert dem Engelmaedchen etwas zu.\n",
		 "Lord Thurisaz setzt sich auf eine Wolke.\n"}));

  SetProp(P_SPELLRATE, 40);
  AddSpell(2, 800,
    Name(WER,1) + " beschwoert einen gleißenden Blitz auf Dich herab.\n",
    Name(WER,1) + " beschwoert einen gleißenden Blitz auf @WEN herab.\n",
    DT_LIGHTNING, ([SP_SHOW_DAMAGE: 1]));

  AddSpell(1, 600,
    Name(WER,1) + " haelt Dir die Hand entgegen und heiliges Licht brennt in Dir.\n",
    Name(WER,1) + " haelt @WEM die Hand entgegen und heiliges Licht brennt in @WEM.\n",
    DT_HOLY, ([SP_SHOW_DAMAGE: 1]));

  AddDefaultSpell(2, 350, DS_BLIND,
    Name(WER,1) + " entzuendet einen Strahlenkranz, der Dich blendet!\n",
    Name(WER,1) + " entzuendet einen Strahlenkranz und blendet @WEN!\n",
    6);

SUID;
  ob = clone_object(ARMOUR "wtoga" );
  ob ->SetProp(P_WEAR_RESTRICTIONS, 0);
  ob->move(TO, M_NOCHECK);
  ob = clone_object(ARMOUR "stirnreif" );
  ob ->SetProp(P_WEAR_RESTRICTIONS, 0);
  ob->move(TO, M_NOCHECK);
  command("trage alles");             
    

  //AddInfo("strahlenkranz", #'info_strahlenkranz, "sagt: ");

}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "schaut Dich wuetend an.",
	       "schaut "+TP->name(WEM)+ "wuetend an.");
     break;

   case "intim":
     call_out ("react", 0, "weist Dich in Deine Grenzen.",
	"weist "+TP->name(WEM)+ " zurecht.");

    break;

   case "aergerlich":
     call_out("react", 0, "droht Dir mit der Hoelle.",
	      "droht "+TP->name(WEN)+" mit der Hoelle.");
     break;

   case "frech":
     call_out("react", 0, "fragt Dich: Wollt Ihr in der Hoelle schmoren?",
	      "baut sich vor "+TP->name(WEN)+" auf.");
     break;
   
    default:
      call_out("react", 0, "knuddelt Dich.",
	       "laechelt goettlich.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 


string info_strahlenkranz()
{
  mapping sk;
  if (TP->QueryProp(P_GUILD) != "amazonen")
    return "Das Wissen ueber den Strahlenkranz teile ich nur mit Amazonen!";

  if (TP->QuerySkill("strahlenkranz"))
    return "Aber Du kannst Strahlenkranz ja schon!";

  return "Bring mir einfach eine leuchtende Passionsfrucht, und ich bringe "
    "Dir Strahlenkranz bei.";
}


void give_notify(object ob)
{
  if(ob->id("\nplantangenfrucht") &&
     TP->QueryProp(P_GUILD) == "amazonen")
  {
    if (ob->QueryProp(P_LIGHT) < 3)
    {
      write("Lord Thurisaz sagt: Diese Passionsfrucht leuchtet zu schwach!\n"
            "Lord Thurisaz gibt Dir die Frucht zurueck.\n");
      ob->move(TP, M_NOCHECK);
    }
    else
    {
      write(break_string(
          "Das ist eine schoen leuchtende Passionsfrucht. Ich lehre Dir jetzt "
          "den Strahlenkranz-Zauber.",
          78, "Lord Thurisaz sagt: "));
      ob->remove();
      find_object("/gilden/amazonen")->LearnSpell("strahlenkranz", TP); 
    }
    return;
  }
  return ::give_notify(ob);
}

