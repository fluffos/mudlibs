//Aaliyah 
//11.02.2005
//Morgaine

inherit "p/std/npc/druid_npc";



#include "../def.h"


void init()
{
  ::init();
 if (find_call_out("hallo") != -1)
  call_out("hallo",0);
}
void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&&InFight())
    tell_room(MENV, "Morgaine fragt: Was fuehrt Euch zu mir Fremder?\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Morgaine, die Heilerin");
  SetProp(P_LONG,
    "Morgaine ist eine grosse schlanke Elfe. Ihre langen weissen Haare fallen "
    "unbaendig um ihre Schultern. Ihre grossen eisblauen Augen strahlen "
    "enormes Wissen aus. Sie ist seit langer Zeit im Dienste von Hippolyte und "    "wird der Koenigin auch bis zu ihrem Tode, treu ergeben sein.");
    
  SetProp(P_NAME, ({"Morgaine, die Heilerin",
                  "Morgaine, der Heilerin", 
                  "Morgaine, der Heilerin",
                  "Morgaine, die Heilerin"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"morgaine", "heilerin", "elfe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("morgaine");

  create_default_druid("wasser", 40, 16, 2000);
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.3, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    0.5, DT_MAGIC:  -0.5, DT_MIND:   0.2,
      DT_SLASH:     0.1, DT_BLUDGEON: 0.0, DT_PIERCE: 0.1]) );

  SetProp(P_MSGIN, "kommt anmutig herein");
  SetProp(P_MSGOUT, "geht hastig");
  SetProp(P_MMSGIN, "entsteht aus einem Nebel");
  SetProp(P_MMSGOUT, "verpufft in einem Nebel");
  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Ich freue mich auf die Revanche!");
  SetProp(P_KILL_NAME, "Morgaine, die Heilerin");
  SetProp(P_KILL_MSG, "Mit einer Heilerin legt man sich nicht an!");

  AddInfo(DEFAULT_INFO, "nimmt Dich gar nicht wahr.");
  
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Morgaine benoetigt solchen Kram nicht.\n" }) );

   

  SetChats(1, ({"Morgaine blickt in ihre Kristallkugel.\n",
		 "Morgaine mischt einige Kraeuter zusammen.\n",
		 "Morgaine zuendet eine Kerze an.\n",}));
 
  
  SUID;
    CLONEME(ARMOUR "wtoga.lpc" );
    command("trage alles");
}
  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "sagt: Ihr stoert mich beim Denken Fremder!",
          "sagt: "+TP->name(WER)+" stoert mich beim Denken.");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
   call_out("react", 0, "fragt: Warum seid Ihr so nervig?, "+TPN+"?",0);
      break;
         break;
  case "traurig":
   call_out("react", 0, "schubst Dich genervt weg.",
             "schubst "+TP->name(WEN)+" genervt weg.");
      break;
  case "albern":
    call_out("react", 0, "schmunzelt.",0);
       break;
  case "neutral":
   call_out("react", 0, "scheucht Dich weg.", "scheucht "+TP->name(WEN)+" weg.");
      break;
  case "intim":
   call_out("react", 0, "drueckt Dich zaertlich.", "drueckt "+TP->name(WEN)+
		         " zaertlich.");
      break;
  case "froh":
   call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
  case "aengstlich":
    call_out("react", 0, "zeigt Dir das Buch der Helden.",
             "zeigt "+TP->name(WEM)+" ein Buch.");
          break;
  case "frech":
    call_out("react", 0, "verpasst Dir eine Ohrfeige.", "haut "+TP->name(WEN)+
		         " Eine runter.");
      break;
  case "nett":
    call_out("react", 0, "umarmt Dich.", "umarmt  "+TP->name(WEN)+" kurz.");
      break;
  }
}
void react(string victim, string others)
	{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" schreit: Strafe muss sein!\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

