// Aphrodite




inherit "std/npc";


#include "../def.h"


void init()
{
  ::init();
 if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{

  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Aphrodite saeuselt: Willkommen!\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Aphrodite, die Goettin der Schoenheit");
  SetProp(P_LONG,
    "Aphrodite ist der Inbegriff der Schoenheit. Sie hat maerchenhafte lange " 
    "blonde Haare. Ihre grossen himmelblauen Augen sind von langen schwarzen "
    "Wimpern umrandet. Ihre vollen, hellrosa Lippen zieren ihr zartes Gesicht. "    "Ihr wohlgeformter Koerper strahlt eine Anmut aus, die Du vorher noch nie "
    "gesehen hast. Sie ist eine Goettin und sie wird eine Goettin bleiben.");
    
  SetProp(P_NAME, ({"Aphrodite, die Goettin der Schoenheit",
                  "Aphrodite, der Goettin der Schoenheit", 
                  "Aphrodite, der Goettin der Schoenheit",
                  "Aphrodite, die Goettin der Schoenheit"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"aphrodite", "goettin","Speermeister" }));
  SetProp(P_ARTICLE, 0);
  set_living_name("aphrodite");

  create_default_npc(40,3000);
  SetProp(P_HANDS, ({" Dich mit ihren zarten Haenden",300,DT_MAGIC}));
  SetProp(P_RACE, "Gott");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 74000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      -0.1, DT_POISON: -0.3, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    -0.5, DT_MAGIC:  -1.0, DT_MIND:   0.2,
     DT_SLASH:     -0.3, DT_PIERCE:  -0.3, DT_WHIP: -0.5, DT_BLUDGEON: -0.5]) );

  SetProp(P_MSGIN, "taenzelt anmutig herein");
  SetProp(P_MSGOUT, "streicht ihre Toga glatt und verschwindet");
  SetProp(P_MMSGIN, "erscheint aus dem Goetterreich");
  SetProp(P_MMSGOUT, "verschwindet in das Reich der Goetter");
  SetProp(P_DIE_MSG,  " verschwindet vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Du musst verschoenert werden %s.");
  SetProp(P_KILL_NAME, "Aphrodite, die Goettin der Schoenheit");
  SetProp(P_KILL_MSG, "Toter siehst Du noch viel haesslicher aus!");
  SetProp(P_BODY, QueryProp(P_BODY) + 100);
  

  AddInfo(DEFAULT_INFO, "sagt: Das werdet Ihr nie erfahren Fremder.");
  
  AddInfo( ({"schoenheit"}), 
    "Schoenheit liegt im Auge des Betrachters.", "sagt laechelnd: ");
  
  AddInfo( ({"betrachter"}),
    "In diesem Fall bist Du das.","sagt: ");
  
  AddInfo( ({"druiden","berserker","paladine","nekromanten","zechpreller"}),
     "Ich habe keine Ahnung von diesen Gilden.","sagt: ");
  
  AddInfo( ({"amazonen"}),
     "Die Amazonen kaempfen mit der Macht der Goetter!","sagt: ");
  
  AddInfo( ({"goetter"}),
     "Och, da gibt es hier so einige in der Burg.","sagt: ");
  
  AddInfo( ({"lippenstift","lippen"}),
     "Mit dem Lippenstift kannst Du Deine Lippen verschoenern.","sagt: ");
  
  AddInfo( ({"lidschatten","augenlider"}), 
     "Der Lidschatten bringt Farbe auf Deine Augenlider.","sagt: ");
  
  AddInfo( ({"puder","glanz","teint"}),
     "Das Puder befreiht Deinen Teint von Glanz.","sagt: ");
  
  AddInfo( ({"kohlestift","kohlestifte","augen"}),
     "Der Kohlestift umrahmt Deine Augen.","laechelt: ");
  
  AddInfo( ({"wangen","rouge"}),
     "Das Rouge zaubert eine leichte Roete auf Deine Wangen.","sagt laechelnd: ");
  
  AddInfo( ({"hippolyte","koenigin","amazonenkoenigin"}),
     "Hippolyte ist meine Koenigin. Sie steht unter meinem Schutz und ich "
     "werde ihr ewig dienen.","erzaehlt: ");
  
   AddInfo( ({"haut"}),
      "Ich habe die zarteste Haut.","kichert: ");
 
   AddInfo( ({"liebe"}),
      "Ich erzaehle Euch gewiss nichts ueber Liebe Fremder.","sagt: ");

  

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Aphrodite sagt: Dieses Geschenk ist nicht wuerdig einer Goettin.\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(6,450,
    "Aphrodite schlitzt Dir mit dem Speer die Brust auf.\n",
    "Aphrodite schlitzt @WEN mit ihrem Speer die Brust auf.\n",    
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,2000,
  "Aphrodite taucht Dich in das Becken.\n",
  "Aphrodite taucht @WEM in das Becken.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,450,		  
  "Aphrodite verpasst Dir eine schallende Ohrfeige.\n",
  "Aphrodite verpasst @WEM eine schallende Ohrfeige.\n",
  DT_WHIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(7,500,
  "Aphrodite beschwoert eine gigantische Welle aus dem Becken.\n",
  "Eine gigantische Welle bricht ueber @WEM herein.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
  "Aphrodite schleudert Dich aus dem Badesaal.\n",
  "Aphrodite schleudert @WEM aus dem Badesaal.\n",
  DT_BLUDGEON, "wegschleudern",([SP_SHOW_DAMAGE:1]));
    

  SetChats(1, ({"Aphrodite kaemmt sich ihre Haare.\n",
		 "Aphrodite beginnt eine Amazone zu schminken.\n",
		 "Aphrodite zieht sich ihre Lippen nach.\n",}));
 
  
  SUID;
    CLONEME("/p/weapon/spear/dreizack" );
    command("zuecke dreizack");
    CLONEME(ARMOUR "wtoga.lpc" );
    CLONEME(ARMOUR "stirnreif.lpc" );
    CLONEME(ARMOUR "armschmuck.lpc" );
    CLONEME(ARMOUR "handschmuck.lpc" );
    command("trage alles");
    
    
}

  void wegschleudern(object enemy)
{
  object* rooms;
  rooms=m_values(MENV->QueryProp(P_EXITS));
  enemy->move(rooms[random(sizeof(rooms))], M_GO, 
    "vom Aphrodite fortgeschleudert", "wird", "fliegt in hohem Bogen herein");
  enemy->SetProp(P_PARALYZED, 10);
}
 void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "fragt: Wollt Ihr meinen Speer spueren?",
          "fragt: "+TP->name(WER)+" wollt Ihr meinen Speer spueren?");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "sagt: Koennt Ihr keine Ruhe geben "+TPN+"?",0);
      break;
  case "traurig":
    call_out("react", 0, "troestet Dich laechelnd "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "grinst Dich an.",0);
       break;
  case "neutral":
    call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEN)+" zu.");
      break;
  case "intim":
    call_out("react", 0, "durchdringt Dich mit ihren Augen. ",
	"durchdringt "+TP->name(WEN)+" mit ihren Augen.");
      break;
  case "froh":
    call_out("react", 0, "pustet Dir etwas Puder ins Gesicht.",
             "pustet "+TP->name(WEN)+" etwas Puder ins Gesicht.");
      break;
  case "aengstlich":
    call_out("react", 0, "ermutigt Dich.",
             "ermutigt "+TP->name(WEM)+" etwas.");
      break;
  case "frech":
    call_out("react", 0, "taucht Deinen Kopf in das Becken.", "taucht "
		     +TP->name(WEN)+" ins Becken.");
      break;
  case "nett":
    call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
		    " an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" schimpft: Ihr habts nicht anders gewollt!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

