// 15.2.2005 Aaliyah
// Horus, der Schatzkammerwaechter

inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&&!InFight())
    tell_room(MENV, "Horus schreitet herein.\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Horus, der Hueter des Schatzes");
      
  SetProp(P_NAME, ({"Horus, der Hueter des Schatzes",
                  "Horus, des Hueters des Schatzes", 
                  "Horus, dem Hueter des Schatzes",
                  "Horus, den Hueter des Schatzes"}));
                  
  SetProp(P_GENDER, MALE);
  AddId(({"horus", "gott", "hueter","Speermeister"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("horus");

  create_default_npc(40,3000);
  SetProp(P_HANDS, ({" mit seinen Faeusten",300,DT_MAGIC}));
  SetProp(P_RACE, "Gott");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 78000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:40]));  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      -1.0, DT_WATER:  0.1, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.2, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  0.0, DT_MIND:   0.2,
      DT_SLASH:     -0.2, DT_PIERCE:  -0.5, DT_WHIP: -0.5, DT_BLUDGEON: 0.1]) );

  SetProp(P_MSGIN, "tritt aus einem Schatten");
  SetProp(P_MSGOUT, "verschwindet in einem Schatten");
  SetProp(P_MMSGIN, "erwacht von den Toten");
  SetProp(P_MMSGOUT, "verschwindet ins Reich der Toten");
  SetProp(P_DIE_MSG,  " verschwindet ins Reich der Toten.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Die Rache der Isis und des Osiris wird gross sein!");
  SetProp(P_KILL_NAME, "Horus, der Hueter des Schatzes");
  SetProp(P_KILL_MSG, "Der Fluch des Goldes liegt nun auf Euch!");

  AddInfo(DEFAULT_INFO, "Vielleicht kann Euch Isis weiterhelfen.","sagt ");
  
     AddInfo( ({"isis","mutter"}),
     "Isis ist meine geliebte Mutter.","sagt: ");
  
  AddInfo( ({"osiris","vater"}),
     "Osiris ist mein geliebter Vater.","sagt: ");
  
  AddInfo( ({"gold","muenzen","schmuck","edelsteine","perlen","goldmuenzen"}),
     "Aus Neid wuerden manche Leute sogar toeten. Jedoch macht Gold und "
     "Reichtum nicht gluecklich. Es gibt Wichtigeres.","sagt: ");
  
  AddInfo( ({"wichtigeres"}),
     "Glueck, Gesundheit und Liebe kann man fuer kein Geld der Welt kaufen. "
     "Leider schaetzen das die wenigsten.","sagt: ");
  
  AddInfo( ({"neid"}),
     "Neid und Habgier sind Eigenschaften, die die meisten Leute praegen",
     "sagt: ");

 
  AddInfo( ({"schluessel"}),
     "Das sag ich Euch gewiss nicht.", "fragt: ");
  
 
 
  
  
  
   SetProp( P_REJECT, ({ REJECT_GIVE,
    "Horus sagt: Ich habe keine Verwendung fuer irdische Dinge!\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(4,500,
    "Horus schlitzt Dir mit seinem Speer den Bauch auf.\n",
    "Horus schlitzt @WEN mit seinem Speer den Bauch auf.\n",    
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,900,
   "Horus schlaegt Dir mit der Faust ins Gesicht.\n",
   "Horus schlaegt @WEM mit der Faust ins Gesicht.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1200,		  
   "Horus beschwoert einen riesige Feuerwelle.\n",
   "Horus vernichtet @WEM mit einer riesigen Feuerwelle.\n",
  DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(5,600,DS_SLOW,
   "Horus goettlichen Maechte behindern Dich beim Kampf.\n",
   "Horus goettliche Maechte behindern @WEM beim Kampf.\n");
 
  
  AddSpell(5,900,
   "Horus reisst Dir Deine Seele aus dem Leib.\n",
   "Horus reisst @WEM die Seele aus dem Leib.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 600, DS_PARALYZE);
    
 
  SUID;
     CLONEME(WEAPON "goetterspeer.lpc" );
     command("zuecke speer");
     CLONEME(ARMOUR "wtoga.lpc");
     command("trage alles");

}
 void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "schimpft: Wagt es nicht noch einmal Fremder!",
          "schimpft: "+TP->name(WER)+" wagt es nicht noch einmal!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "sagt: Ihr seid mit einem Fuss im Grab"+TPN+"!",0);
      break;
  case "traurig":
    call_out("react", 0, "troestet Dich "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "laechelt souveraen.",0);
       break;
  case "neutral":
    call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEN)+" zu.");
      break;
  case "intim":
    call_out("react", 0, "sagt: Das darf nur Isis!",
	"weist	"+TP->name(WEN)+" zurecht.");
      break;
  case "froh":
    call_out("react", 0, "zwinkert Dir laechelnd zu.",
             "zwinkert "+TP->name(WEN)+" laechelnd zu.");
      break;
  case "aengstlich":
    call_out("react", 0, "lacht Dich aus.",
             "lacht "+TP->name(WEM)+" aus.");
      break;
  case "frech":
    call_out("react", 0, "droht Dir mit seinem Todesspeer.", "droht "
		     +TP->name(WEN)+" mit seinem Todesspeer.");
      break;
  case "nett":
    call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
		    " an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" sagt: Ihr seid bald tot!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

  string long()
 {
  if( TP->QueryProp(P_GENDER)==MALE )
  SetProp(P_LONG,
    "Horus, der Hueter des Goldes ist ein wahrer Gott. Sein muskuloeser "
    "Oberkoerper ist mit vielen Narben uebersaeht, die ihn aber keinesfalls "
    "haesslich machen. Seine dunkelbraunen, langen Haare wallen ihm seidenweich "
    "ueber seine kraeftigen Schultern und seine grossen, hellbraunen Augen "
    "blicken Dich misstrauisch an. Du hast grossem Respekt vor ihm und "
    "beneidest ihn etwas um seine maechtige Erscheinung.");
  
   else
	   
    SetProp(P_LONG, 
      "Horus, der Hueter des Goldes ist ein wahrer Gott. Sein muskuloeser "
      "Oberkoerper ist von vielen Narben uebersaeht, die ihn aber keinesfalls "
      "haesslich machen. Seine dunkelbraunen, langen Haare wallen ihm weich"
      "ueber seine kraeftigen Schultern und seine grossen, hellbraunen Augen "
      "blicken Dich misstrauisch an. Du streifst Dir Deine Haare zurecht um "
      "vor diesem Gott so schoen wie moeglich zu sein.");
  return ::long();
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if (MENV)
    tell_room(MENV, 
      "Horus verschwindet ins Reich der Toten.\n");
  deep_remove(1);
}
void daemon()
{
  object daemon;
  tell_room(ENV(TO), "Osiris schickt einen Daemon, der Horus im Kampf "
      "unterstuetzt.\n");
  daemon=clone_object (NPC "/d/dschungel/chivas/tempel/npc/dwizard" );
  daemon->move(ENV(TO), M_GO|M_NOCHECK);
}

void Attack(object enemy)
{
   ::Attack(enemy);
   if (!random(5))
    daemon();
}
 
   
