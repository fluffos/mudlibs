// Der Goetterspeer von Hera.
// 15-02-2005 Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Der Goetterspeer");
  SetProp(P_LONG,
    "Dieser maechtige Speer ist eindeutig eine Waffe der Goetter. "
    "Der Schaft ist gezackt wie ein Blitz und gleisst in hellem "
    "Licht. Um die lange, scharfe Spitze zucken kleine Blitze herum.");
  SetProp(P_NAME, "Goetterspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"goetterspeer", "speer", "\nheraspeer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 250);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_LIGHTNING}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_LIGHTNING:20, MAT_LIGHT:30, MAT_MAGIC:50]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 50000);
  SetProp(P_MAGIC, 12);

  SetProp(P_WC_BONUS, (["hera": 1000, "horus": 600, ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 35]) );
}

