// Patrouillenspeer fuer eine Amazone in Edynia

inherit "std/weapon";
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Patrouillenspeer");
  SetProp(P_LONG,
    "Ein robuster Speer, wie ihn die Amazonen auf ihren Patrouillen tragen. "
    "Der Schaft ist glatt poliert und liegt gut in der Hand, die Spitze ist "
    "stahlhart und sauber geschliffen.");

  SetProp(P_NAME, "Patrouillenspeer");
  SetProp(P_GENDER, MALE);
  AddId(({ "patrouillenspeer", "speer", "\npatrouillenspeer" }));

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 145);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({ DT_PIERCE }));
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WEIGHT, 1400);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_MATERIAL, ([ MAT_WOOD: 60, MAT_STEEL: 40 ]) );
}

