inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Tonklumpen");
  SetProp(P_LONG, 
      "Ein feuchter Tonklumpen. Er ist schoen weich und modellierbar.");
  SetProp(P_NAME, "Tonklumpen");
  SetProp(P_GENDER, MALE); 
  AddId( ({"tonklumpen","klumpen","QUEST-TON","ton"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, ([MAT_EARTH:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
}  
 


