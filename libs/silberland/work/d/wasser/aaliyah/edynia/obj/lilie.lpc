// Lilie

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Lilie");
  SetProp(P_LONG, 
    "Eine wunderschoene weisse Lilie. Ihre grossen Bluetenblaetter weisen eine "
    "schoene hellblaue Umrandung auf. Ausserdem befindet sich noch ein kleiner "
    "Tautropfen auf der Bluete. Die zarten Blaetter haben eine tiefe, gruene "
    "Farbe. Diese praechtige Blume stammt aus den Gaerten von Edynia.");
  SetProp(P_NAME, "Lilie");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"lilie","blume","AMAZON-LILIE"}) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_SMELL, "Die Lilie duftet wunderbar.\n");

  AddDetail( ({"tautropfen"}),
	 "Ein kleiner Tautropfen befindet sich auf der weissen Bluete.");

  AddDetail( ({"bluetenblaetter","umrandung","bluete"}),
	"Die Bluetenblaetter sind weiss und haben eine hellblaue Umrandung.");

  AddDetail( ({"farbe","blaetter"}),
	"Die Blaetter der Lilie haben eine dunkelgruene Farbe.");

  AddDetail( ({"gaerten","edynia"}),
	"Die Lilie stammt aus den Gaerten von Edynia.");
  
 }  
   
