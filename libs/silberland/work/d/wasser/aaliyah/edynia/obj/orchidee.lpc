// Orchidee

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Orchidee");
  SetProp(P_LONG, 
    "Eine grosse praechtige Orchidee. Ihre hellvioletten Bluetenblaetter haben "
    "eine schoene lachsrosa Umrandung. Auch der Bluetenkelch hat eine helle "
    "lachsrosa Farbe. Einige kleine Blaetter sind um den Stengel angereiht. "
    "Diese praechtige Blume stammt aus den Gaerten von Edynia.");
  SetProp(P_NAME, "Orchidee");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"orchidee","blume","AMAZON_Orchidee"}) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_SMELL, "Die Orchidee duftet herrlich.\n");

  AddDetail( ({"stengel","blaetter"}),
	 "Einige Blaetter sind um den Stengel angereiht.");

  AddDetail( ({"bluetenblaetter","umrandung","bluete"}),
	"Die Bluetenblaetter sind hellviolett und haben eine lachsrosa "
	"Umrandung.");

  AddDetail( ({"farbe","bluetenkelch"}),
	"Der Bluetenkelch ist lachsrosa.");

  AddDetail( ({"gaerten","edynia"}),
	"Die Orchidee stammt aus den Gaerten von Edynia.");
  
 }  
   
