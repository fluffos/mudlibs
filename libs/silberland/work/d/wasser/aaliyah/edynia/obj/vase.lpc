// Edynia - Questitem - Vase


inherit "std/thing";
#include "../def.h"

int wasser=0;
int blume=0;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine schoene Vase");
  SetProp(P_LONG, 
      "Eine schoene Vase aus gebranntem Ton. Sie hat die Form einer "
      "umgedrehten Glockenblume und sieht so sehr huebsch aus.");
  SetProp(P_NAME, "Vase");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"schoene vase","QUEST-VASE","vase"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, ([MAT_CERAMIC:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME_ADJ, "schoen");
  AddDetail( ({"form","glockenblume"}),
	  "Die Vase hat die Form einer Glockenblume.");
  
//-----------------KOMMANDOS--------------------------------------------------

  
 AddCmd( ({ "steck", "stecke"}), "c_stecken");
 AddCmd( ({ "fuelle" }), "c_fuellen");
 
}

 int c_fuellen(string str)
{  
  notify_fail(BS("Womit moechtest Du die Vase fuellen?"));
  if((str != "vase mit wasser") && (str != "wasser in vase"))
  { 
    return 0;
  }
  if (wasser==1)
  { 
    write(BS("Aber die Vase ist doch schon mit Wasser gefuellt."));
     return 1;
  }
  if (file_name(ENV(TP)) == ROOM "brunnen")
  { 
    write(BS("Du fuellst die Vase mit frischem Brunnenwasser."));
    tell_room(ENV(TP), TPN+" fuellt eine Vase mit Wasser.\n", ({TP}));
    wasser=1;
    return 1;
  }
  write(BS("Hier kannst Du Deine Vase nicht fuellen."));
  return 1;
}
//-----------------------------------------------------------------------------

 string _query_long()
{
   if (blume == 1)
     return BS(
       "Eine schoene Vase aus gebranntem Ton. Sie hat die Form einer "
       "umgedrehten Glockenblume und eine schoene Blume befindet sich "
       "darin.");
   
   else if (wasser == 1)
     return BS(
       "Eine schoene Vase aus gebranntem Ton. Sie hat die Form einer "
       "umgedrehten Glockenblume und ist mit Wasser gefuellt.");

   else
     return BS(
       "Eine schoene Vase aus gebranntem Ton. Sie hat die Form einer "
       "umgedrehten Glockenblume und sieht so sehr huebsch aus.");
}

//----------------------------------------------------------------------------

 int c_stecken(string str)
{
   notify_fail(BS("Was moechtest Du in die Vase stecken?"));
   if((str != "lilie in vase") && (str != "blume in vase"))
 {
  return 0;
 }
   
   if(!present("AMAZON-LILIE", TP) || (wasser==0))
 {  
  write(BS("Irgendwas hast Du vergessen.")); 
  tell_room(ENV(TP), TPN+" gruebelt ratlos.\n", ({TP}));

  return -1;
 } 
  else if ( wasser==1 && present("AMAZON-LILIE", TP) )
  
 {

  write(BS("Du steckst die Blume in die Vase."));
  tell_room(ENV(TP), TPN+" steckt eine schoene Blume in eine Vase.\n", ({TP}));
  present("AMAZON-LILIE", TP)->remove();
  blume=1;
  return 1;

 }
  
 }
//---------------------------------------------------------------------------

 int quest_fertig()
 {
  return (wasser==1 && blume==1);
 }

//---------------------------------------------------------------------------
