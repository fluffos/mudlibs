//  Aaliyah 
//  Fleischklumpen

inherit "std/thing";


#include "../def.h"


void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Fleischklumpen");
  SetProp(P_LONG, 
    "Du haelst einen ekligen Fleischklumpen in Deinen Haenden. Es scheint "
    "als waere es ein Stueck vom Ruecken eines Zebras. Der Klumpen ist "
    "sehr blutig und hat ein gestreiftes Muster.");
  SetProp(P_NAME, "Fleischklumpen");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 20);
  SetProp(P_ARTICLE, 1);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_FLESH:100]));
  AddId(({"klumpen", "fleischklumpen"}));

  AddDetail( ({"muster"}),
    "Man munkelt das dieses Muster Drachen anlockt.");

//----KOMMANDOS------

   AddCmd( ({ "lock", "locke" }), "c_anlocken");

 }

int c_anlocken(string str)
{
   notify_fail(BS("Wen moechtest Du denn anlocken?"));
   if(!(str == "drache mit klumpen an" || str == "drache mit fleischklumpen an" ||
        str == "drache mit fleisch" || str == "drache mit fleisch an" ||
        str == "drache mit klumpen" || str == "drache mit fleischklumpen"))
   {
     return 0;
   }
     
   write(BS("Du lockst den Drachen mit dem Fleischklumpen an. Er fliegt auf "
            "Dich zu und frisst Dir das Fleisch aus der Hand. Schnell "
	    "kletterst Du auf seinen Ruecken und wirst wohlbehalten auf den "
	    "Klippen abgesetzt."));
   tell_room(ENV(TP), TPN+" verschwindet vor Deinen Augen.\n", ({TP}));
   TP->move(ROOM "amazon5", M_GO, "", "verschwindet", "landet vor Dir");
   remove();
   return 1;
    }
    

	






















  
