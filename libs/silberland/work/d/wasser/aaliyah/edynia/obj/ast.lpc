inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Purpurlindenast");
  SetProp(P_LONG, 
      "Ein dicker, gerader Ast einer Purpurlinde.");
  SetProp(P_NAME, "Purpurlindenast");
  SetProp(P_GENDER, MALE); 
  AddId( ({"purpurlindenast","ast","QUEST-PURPURLINDENAST"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
 
}  
 


