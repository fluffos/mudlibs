// von Aaliyah
// 03.02.2005
// Glassplitter


inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Glasplitter");
  SetProp(P_LONG, 
      "Ein seltsamer Glassplitter. Du weisst nicht genau, was Du damit "
      "anfangen sollst. Zu einem Fenster oder Gefaess scheint er nicht "
      "gehoert zu haben, teilweise erinnert er Dich eher an einen Teil "
      "eines Schluessels, aber wer macht schon Schuessel aus Glas?");
   
  SetProp(P_NAME, "Glassplitter");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"splitter","glassplitter"}) );

  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
}  
 

void setup(int nr)
{
  AddId( "\namazonensplitter" + nr);
  SetProp(P_LONG, QueryProp(P_LONG) + 
      "Dieser Splitter hat " + nr + " Kanten.");
}
