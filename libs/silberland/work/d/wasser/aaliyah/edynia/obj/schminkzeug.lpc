// von Aaliyah
// 03.02.2005
// 
// Das Schminkzeug der Amazonenkoenigin

inherit "std/thing";

#include "../def.h"

int schminke = 0;
void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Das Schminkzeug der Koenigin");
  SetProp(P_LONG, 
    "Du haeltst eine kleine Dose in Deiner Hand. In dieser Dose befinden sich "
    "ein schwarzer Kohlestift, etwas goldener Lidschatten, ein bisschen Puder "
    "und ein lachsfarbener Lippenstift. Ausserdem ein kleines Tuch, das zum "
    "Abschminken benoetigt werden kann.");
 SetProp(P_NAME, ({"Das Schminkzeug der Koenigin",
                  "Des Schminkzeuges der Koenigin", 
                  "Dem Schminkzeug der Koenigin",
                  "Das Schminkzeug der Koenigin"}));

  SetProp(P_INFO, "Mit dieser Dose kannst Du Dich schminken und wieder "
		  "abschminken. Du hast folgende Befehle:\n"
		  "Schminke mich.\n"  
		  "Wische alles ab.\n");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"zeug","schminkzeug","dose"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_PEARL:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 0);

  
//-------Details-----------------------------------------------

 AddDetail( ({"dose","doeschen"}),
	  "Die Dose besteht aus vielen verschmolzenen Perlen. Daher schimmert "
	  "sie huebsch in allen moeglichen Farben.");

 AddDetail( ({"perlen","farben","sonnenlicht","perlmutt"}),
	  "Das Perlmutt der Dose schimmert bunt im Sonnenlicht.");
 
 AddDetail( ({"kohlestift","stift"}),
          "Der schwarze Kohlestift dient zum Umranden der Augen.");

 AddDetail( ({"lippenstift","stift"}),
	  "In der Dose befindet sich rosaroter und lachsfarbener Lippenstift.");
	
 AddDetail( ({"tuch"}),
	  "Das Tuch dient zum Abwischen der Schminke. Es besteht aus einem "
	  "seltsamen Material und reinigt sich selbst.");

 AddDetail( ({"lidschatten"}),
	  "Neben dem goldenen Lidschatten erkennst Du auch noch silbernen und "
	  "smaragdgruenen Lidschatten. Die hast Du vorher gar nicht bemerkt.");

 AddDetail( ({"puder"}),
	  "Duftendes Puder befindet sich in der Dose.");

//--------Kommandos---------------------------------------------

  AddCmd( ({ "schminke", "schmink" }), "c_schminken");
  AddCmd( ({ "wische", "wisch" }), "c_abwischen");


}  
  int c_schminken(string str)
  
  {
   notify_fail(BS("Wen moechtest Du schminken?"));
   if(!(str == "mich"))
   {
     return 0;
   }
   if (schminke == 1)
   {
	  
   write(BS("Du bist doch schon geschminkt! Wenn Du dich noch mehr schminkst, "             "siehst Du aus wie ein bunter, kitschiger Zirkusaffe."));
    say(TPN +" moechte gerne wie ein Clown aussehen.\n", ({TP}) );
     return 1;
   }
   
   write(BS("Du puderst Dir Dein Naeschen, traegst etwas goldenen glitzernden "
            "Lidschatten auf und umrandest gekonnt Deine Augen mit dem " 
	    "Kohlestift. Da noch die Lippen fehlen, schminkst Du Dir einen "
	    "sinnlichen lachsfarbenen Kussmund."));
   say(TPN +" zueckt ein Doeschen und schminkt sich hinreissend.\n", ({TP}) );
   schminke = 1;
   return 1;
  }
  string extra_look()
 {
  object player;
  if (!player = environment()) return "";
  if (schminke == 1)
    return player->Name() + " sieht aus wie eine amazonische Goettin.\n";
  else
    return "";  
  }
  int c_abwischen(string str)
  
  {
   notify_fail(BS("Was moechtest Du denn abwischen?"));
   if(!(str == "alles ab"))
   {
    
     return 0;
   }
    if (schminke == 0)
   {
	  
   write(BS("Was willst Du bitte abwischen? Du bist nicht einmal geschminkt! "
	    "Wenn Dich an Deinem Gesicht etwas stoert, laesst es sich gewiss "
	    "nicht mit einem einfachen Tuechlein beheben."));
    say(TPN +" wischt mit einem Tuechlein im Gesicht herum.\n", ({TP}) );
     return 1;
   }
   
   write(BS("Du nimmst das Tuch und wischst Dir den ganzen Kleister vom "
	    "Gesicht. Deine Haut beginnt zu atmen."));
   say(TPN +" wischt sich die ganze Schoenheit vom Gesicht.\n", ({TP}) );
   schminke = 0;
   return 1;
  }

