// von Aaliyah
// 16.2.2005
// Schluessel

inherit "std/thing";
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein riesiger Eisenschluessel");
  SetProp(P_LONG, 
    "Ein riesiger Eisenschlussel, so gross, dass er fast nicht mehr auf einen "
    "Schluesselbund passt. Die Tuere, die man damit aufsperren kann, "
    "ist sicher auch riesengross.");
  SetProp(P_NAME, "Eisenschluessel");
  SetProp(P_NAME_ADJ, "riesig");
  SetProp(P_GENDER, MALE); 
  AddId( ({"eisenschluessel","schluessel"}) );
  AddAdjective( ({"riesig", "riesiger", "riesigen"}) );

  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([MAT_IRON:100]));

}  
   
string QueryDoorKey()
{
  return ROOM+"burg1"+":"+ROOM+"stiege1" ;
}

