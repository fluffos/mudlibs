inherit "std/thing";
#include "../def.h"



void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, 0);
  AddId( "GILDENBEITRITTSOBJEKT");
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NEVERDROP, 1);

 AddCmd("", "abbrechen", 1);
 }
 int abbrechen(string str)
 {   
 write(BS("Du brichst das Toepfern ab. Leider ist der Ton jetzt unbrauchbar."));
 tell_room(ENV(TP), TPN+" bricht das Toepfern ab.\n", ({TP})); 
 if (present("QUEST-TON", TP))
 present("QUEST-TON", TP)->remove();
 remove();
 
 return 0;
 
  }
  void init()
 {
 ::init();
 call_out("seq1", 0);
 }
  void seq1()
 {
  if (!TP) return;
  write("Du setzt Dich gemuetlich auf den Schemel.\n");
  call_out("seq2", 4);
  tell_room(ENV(TP), TPN+" setzt sich hin und beginnt zu toepfern.\n", ({TP}));
 }

 void seq2()
 {
  if (!TP) return;
  write("Zoegernd legst Du den Ton auf die Scheibe.\n");
  call_out("seq3", 4);
 }
 void seq3()
 {
  if (!TP) return;
  write("Du bist Dir nicht so sicher wie das funktioniert.\n");
  call_out("seq4", 4);
 }
  void seq4()
 {
  if (!TP) return;
  write("Du legst den Ton auf die Scheibe und betaetigst das Pedal.\n");
  call_out("seq5", 4);
 }
 void seq5()
 {
  if (!TP) return;
  write("Die Scheibe beginnt sich knarrend zu drehen.\n");
  call_out("seq6", 4);
 }
 void seq6()
 {
  if (!TP) return;
  write("Du benetzt Deine Haende mit dem Wasser und legst sie auf den Ton.\n");
  call_out("seq7", 4);
 }
 void seq7()
 {
  if (!TP) return;
  write("Du beginnst den Ton zu modellieren.\n");
  call_out("seq8", 4);
 }
 void seq8()
 {
  if (!TP) return;
  write("Dir macht es total Spass so kreativ zu sein.\n");
  call_out("seq9", 4);
 }
 void seq9()
 {
  if (!TP) return;
  write("Du formst eine schoene Vasenform.\n");
  call_out("seq10", 4);
 }
 void seq10()
 {
  if (!TP) return;
  write("Mit den Haenden hoehlst Du die Vase sorgfaeltig aus.\n");
  call_out("seq11", 4);
 }
 void seq11()
 {
  if (!TP) return;
  write("Als letzten Schliff formst Du noch den Vasenhals glockenfoermig.\n");
  call_out("seq12", 4);
 }
 void seq12()
 {
  if (!TP) return;
  write("Die Vase scheint fertig zu sein.\n");
  call_out("seq13", 4);
 }
 void seq13()
 {
  if (!TP) return;
  write("Du nimmst Deinen Fuss vom Pedal und nimmst die Vase von der Scheibe.\n");
  call_out("seq14", 4);
 }
 void seq14()
 {
  if (!TP) return;
  write("Die Scheibe hoert auf sich zu drehen.\n");
  present("QUEST-TON", TP)->remove();
  clone_object(OBJ "rohvase")->move(TP, M_NOCHECK);
  remove();
  
 }
  
  
  
  
   
