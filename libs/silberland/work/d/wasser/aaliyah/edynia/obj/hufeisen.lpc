// 10.11.2004
// Hufeisen


inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Hufeisen (getragen)");
  SetProp(P_LONG, 
    "Ein Hufeisen aus purem Gold. Es stammt aus der Amazonenburg und wurde "
    "dort von der Schmiedin fuer die Pferde eigens angefertigt.");
  SetProp(P_NAME, "Hufeisen (getragen)");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"eisen","hufeisen"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MAGIC, 2);
  SetProp(P_PLURAL, 0);

}  
   
