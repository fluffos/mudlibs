inherit "std/thing";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein braunes Lederband");
  SetProp(P_LONG, 
      "Ein einfaches, braunes Lederband.");
  SetProp(P_NAME, "Lederband");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"lederband","band","QUEST-LEDERBAND"}) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME_ADJ, "braun");
 
}  
 


