// Toga

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine weisse Toga mit goldenem Saum");
  SetProp(P_LONG, 
    "Eine wunderschoene Toga aus weisser Seide. Der Saum ist mit goldenen "
    "Stickereien verziert, die die Insignien der Amazonen und andere Symbole "
    "darstellen. Die Toga wird eng um den Koerper gewickelt, wobei die "
    "Schultern und ein Arm frei bleiben, sodass es fast wie ein Kleid "
    "aussieht.");
  SetProp(P_NAME, "Toga");
  SetProp(P_NAME_ADJ, "weiss");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"toga"}) );
  AddAdjective( ({"weiss", "weisse", "weisser", "weissen"}) );
  AddDetail( ({"insignien", "symbole", "speer", "schlangen"}),
      "Du erkennst einen Speer, der von zwei Schlangen umwunden ist.");

  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2000);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}  
   
