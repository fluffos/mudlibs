// Falkenhose fuer Horus
// 2005-03-24

inherit "std/armour";

#include "../def.h"

void create()
{
  string gem;
  if (!is_clone(TO)) return;

  ::create();
 
  SetProp(P_SHORT, "Die Falkenhose");
  SetProp(P_LONG, 
      "Diese Hose wurde aus den Federn von Falken geschneidert. Daher ist sie "
      "aussergewohnlich leicht, allerdings wurden die Federn magisch verstaerkt, "
      "daher schuetzt sie wohl besser als man von einer Hose aus solch einem "
      "Material erwarten wuerde. Die Federn haben viele verschiedene Farben, "
      "da sie von allen bekannten Falkenarten stammen, und strahlen in hellenm "
      "Licht.");
  SetProp(P_NAME, "Falkenhose");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"hose", "falkenhose"}) );

  AddDetail( ({"feder", "federn", "falkenfedern", "falkenfeder"}),
      "Es wurden viele verschiedene Falkenfedern verwendet, von allen "
      "bekannten Falkenarten.");
  AddDetail( ({"falke", "falken", "falkenart", "falkenarten",
        "sturmfalken", "turmfalken", "wasserfalken", "waldfalken"}),
      "ZB Sturmfalken, Turmfalken, Wasserfalken, Waldfalken usw.");

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 2000);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_FEATHER:100]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT: 1, T_COLD_PROT: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
}  
   
