// stirnreif
// // 2005-02-03 Feyaria@SilberLand

inherit "std/armour";

#include "../def.h"

mapping gems = ([
    "Diamant": MAT_DIAMOND; "weiss",
    "Rubin": MAT_RUBY; "rot",
    "Saphir": MAT_SAPPHIRE; "blau",
    "Smaragd": MAT_EMERALD; "gruen",
    "Amethyst": MAT_AMETHYST; "violett",
    ]);

string gem;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
 
  gem = m_indices(gems)[random(sizeof(gems))];
  SetProp(P_SHORT, "Ein goldener Stirnreif mit einem " + gem);
  SetProp(P_NAME, "Stirnreif");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_GENDER, MALE); 
  AddId( ({"stirnreif", "reif"}) );
  AddAdjective( ({"golden", "goldener", "goldenen"}) );

  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 1000);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_GOLD:90, gems[gem]: 10]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT:0, T_COLD_PROT:0]) );
}  
  

string _query_long()
{
  string traegerin;

  if (QueryProp(P_WORN)) 
    traegerin = "von " + capitalize(getuid(QueryProp(P_WORN)));
  else
    traegerin = "der Traegerin";
  return break_string(
      "Ein schmaler, goldener Stirnreif, der dazu verwendet wird, um die "
      "langen Haare " + traegerin + " aus dem Gesicht heraus zu halten. In der "
      "Mitte der Stirn haengt ein wunderschoener, " + gems[gem,1] + "er " +
      gem + ", der verfuehrerisch knapp ueber den Augenbrauen " + traegerin +
      " hin und her pendelt.", 78);
}
