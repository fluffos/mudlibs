// Handschmuck aus Gold
// 2005-02-03

inherit "std/armour";

#include "../def.h"

mapping gems = ([
    "Diamant": MAT_DIAMOND; "weiss",
    "Rubin": MAT_RUBY; "rot",
    "Saphir": MAT_SAPPHIRE; "blau",
    "Smaragd": MAT_EMERALD; "gruen",
    "Amethyst": MAT_AMETHYST; "violett",
    ]);

void create()
{
  string gem;
  if (!is_clone(TO)) return;

  ::create();
 
  gem = m_indices(gems)[random(sizeof(gems))];
  SetProp(P_SHORT, "Goldener Handschmuck");
  SetProp(P_LONG, 
    "Dieser Handschmuck besteht aus einem goldenen Ring, der mit einem "
    "feinen Kettchen mit einem schmalen Armreif aus Gold verbunden ist. "
    "Sowohl der Ring als auf der Armreif sind mit einem wunderschoenen " + 
    gem + " geschmueckt, der im Licht herrlich " + gems[gem,1] + " funkelt.");
  SetProp(P_NAME, "Handschmuck");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_GENDER, MALE); 
  AddId( ({"handschmuck", "schmuck"}) );
  AddAdjective( ({"golden", "goldener", "goldenen"}) );

  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 1000);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_GOLD:90, gems[gem]: 10]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT:0, T_COLD_PROT:0]) );
}  
   
