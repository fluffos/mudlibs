// Toga

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Goldener Armschmuck");
  SetProp(P_LONG, 
    "Dieser Armschmuck besteht aus einer goldenen Spirale, die sich wie "
    "eine Schlange um den Oberarm der Traegerin windet. Wenn Du genauer "
    "hinsiehst, schaut das eine Ende der Spirale wie der Kopf einer "
    "Schlange aus. Jetzt kannst Du sogar die feinen Schueppchen auf der "
    "Oberflaeche erkennen. Dieses Meisterwerk der Juwelierkunst sieht "
    "echt beinahe aus, wie eine echte Schlange.");
  SetProp(P_NAME, "Armschmuck");
  SetProp(P_NAME_ADJ, "golden");
  SetProp(P_GENDER, MALE); 
  AddId( ({"armschmuck"}) );
  AddAdjective( ({"golden", "goldener", "goldenen"}) );
  AddDetail( ({"schlange", "meisterwerk", "juwelierkunst", "oberarm", 
        "spirale"}),
      "Wenn die Traegerin ihren Oberarm bewegt, sieht es echt so aus, "
      "als wuerde die Schlange sich bewegen. Ein echtes Meisterwerk.");
  AddDetail( ({"kopf", "schlangenkopf", "ende"}),
      "Das eine Ende des Armschmucks sieht echt aus wie ein Schlangenkopf.");
  AddDetail( ({"schueppchen", "oberflaeche", "schuppen"}),
      "Die feinen Schueppchen auf der Oberflaeche sehen echt aus wie die "
      "Schuppen einer Schlange.");

  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 1000);
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT:0, T_COLD_PROT:0]) );
}  
   
