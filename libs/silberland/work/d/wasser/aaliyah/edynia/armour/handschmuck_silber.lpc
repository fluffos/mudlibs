// Handschmuck aus Silber
// 2005-02-03 Feyaria@SilberLand

inherit "std/armour";

#include "../def.h"

mapping gems = ([
    "Topas": MAT_TOPAZ; "gelb",
    "Aquamarin": MAT_JEWEL; "blau",
    "Opal": MAT_OPAL; "weiss",
    "Granat": MAT_JEWEL; "rot",
    "Peridot": MAT_JEWEL; "gruen",
    ]);

void create()
{
  string gem;
  if (!is_clone(TO)) return;

  ::create();
 
  gem = m_indices(gems)[random(sizeof(gems))];
  SetProp(P_SHORT, "Silberner Handschmuck");
  SetProp(P_LONG, 
    "Dieser Handschmuck besteht aus einem silbernen Ring, der mit einem "
    "feinen Kettchen mit einem schmalen Armreif aus Silber verbunden ist. "
    "Sowohl der Ring als auf der Armreif sind mit einem kleinen " + 
    gem + " geschmueckt, der im Licht schoen " + gems[gem,1] + " funkelt.");
  SetProp(P_NAME, "Handschmuck");
  SetProp(P_NAME_ADJ, "silbern");
  SetProp(P_GENDER, MALE); 
  AddId( ({"handschmuck", "schmuck"}) );
  AddAdjective( ({"silbern", "silberner", "silbernen"}) );

  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 1000);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_SILVER:90, gems[gem]: 10]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_HEAT_PROT:0, T_COLD_PROT:0]) );
}  
   
