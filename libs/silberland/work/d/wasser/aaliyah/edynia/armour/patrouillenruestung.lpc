// Patrouillenruestung fuer eine Amazone in Edynia

inherit "std/armour";

#include "../def.h"
#include <armour.h>

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Patrouillenruestung");
  SetProp(P_LONG,
    "Eine zweckmaessige Ruestung aus Leder und Metallplatten. Sie ist nicht "
    "uebermaessig schwer, schuetzt aber gut genug fuer Patrouillengaenge und "
    "kleinere Gefechte.");

  SetProp(P_NAME, "Ruestung");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "ruestung", "patrouillenruestung", "panzer", "\npatrouillenruestung" }));

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 27);
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_MATERIAL, ([ MAT_LEATHER: 60, MAT_STEEL: 40 ]) );
}

