// Toga

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine hellblaue Toga");
  SetProp(P_LONG, 
    "Eine hellblaue Toga. Wenn man sie richtig um den Koerper wickelt ist "
    "sie wie ein Kleid. Die Toga liegt eng am Koerper an und ist schulterfrei. "
    "Ausserdem ist sie bodenlang und und hat goldene Verzierungen.");
  SetProp(P_NAME, "Toga");
  SetProp(P_NAME_ADJ, "hellblau");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"toga"}) );
  AddAdjective( ({"hellblaue", "hellblauer", "hellblau"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 24);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_ARTICLE, 1);
}  
   
