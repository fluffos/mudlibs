// von Aaliyah
// 29.01.2005
// Amazonien
// Amazonenburg Anfang
// Raum 18 von Edynia
//
 
inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Eingang zur Amazonenburg");
  SetProp( P_INT_LONG,
	"Du stehst unter dem Torbogen beim Eingang der Amazonenburg. Von "
       	"hier aus hast Du schon einen guten Ueberblick ins Innere der Burg. "
	"Viele weibliche Gestalten eilen emsig ueber den Burghof und Du "
	"bewunderst die vielen schoenen Togas von ihnen. Der Burghof ist mit "
	"vielen weissen Blumen aller Art geschmueckt und Du kannst sogar einen "
       	"kleinen Brunnen erkennen. Ausserdem faellt Dir die Vorrichtung auf, "
	"mit der das Tor geoeffnet und geschlossen werden kann. ");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

 
  AddDetail( ({"burg","amazonenburg"}),
	   "Du stehst gerade beim Eingang der Amazonenburg.");

  AddDetail( ({"eingang"}), 
            "Du stehst genau unter dem Torbogen der Burg. Neben Dir befinden "
	    "sich die Vorrichtungen zum Hochkurbeln des Tores.");

  AddDetail( ({"torbogen"}), 
            "Der Eingang der Burg fuehrt durch einen schoen geschwungenen "
	    "Torbogen.");

  AddDetail( ({"eisenketten"}), 
            "Die Eisenketten werden benoetigt um den Mechanismus zu "
	    "betaetigen.");

  AddDetail( ({"hochkurbeln","tores","tor"}), 
            "Mit den Vorrichtungen wird das Tor hochgekurbelt.");
  
  AddDetail( ({"vorrichtung","vorrichtungen","mechanismus","metallraedern"}), 
            "Vier Metallzahnraeder befinden sich an den Waenden. An jedem "
	    "von ihnen ist eine Kurbel befestigt.");


  AddDetail( ({"metallzahnraeder","zahnraeder","metallzahnraedern"}), 
            "Dicke Eisenketten verbinden das Tor mit den Metallzahnraedern.");
  
  AddDetail( ({"kurbel","kurbeln"}), 
            "Mit den Kurbeln kann das Tor geoeffnet oder geschlossen werden.");

  AddDetail( ({"waende","waenden","wand"}), 
            "Hinter den Metallraedern befinden sich zwei Kaefige in die Wand "
	    "eingelassen.");


  AddDetail( ({"kaefige","kaefig"}), 
            "In jedem Kaefig befinden sich zwei Trolle. Sie sind dafuer da "
	    "um den Mechanismus zu steuern.");
  
  AddDetail( ({"trolle"}), 
            "Grosse plumpe Trolle wurden in die Kaefige gesperrt.");
  
  AddDetail( ({"toga","togas"}), 
            "Die Togas der Dienerinnen sind hellblau und haben goldene "
	    "Verzierungen.");

  AddDetail( ({"verzierungen","vorderseite"}), 
             "An der Vorderseite jeder Toga ist das goldene Wappen der "
	     "Amazonen aufgestickt.");

    
  AddDetail( ({"amazonenkoenigin","hippolyte"}), 
            "Die Amazonenkoenigin ist von unglaublicher Schoenheit. Sie hat "
	    "den Anmut einer Frau und die Kraft und den Mut eines Mannes.");

  
  AddDetail( ({"anmut","frau","frauen"}), 
            "Frauen sollten schon anmutig sein.");
 
  AddDetail( ({"kraft","mut","mann","mannes"}), 
            "Ein Mann sollte Kraft und Mut besitzen.");
 
  AddDetail( ({"amazonen","innere"}),
	   "Viele Amazonen huschen emsig ueber den Innenhof.");

  AddDetail( ({"ueberblick"}),
	   "Du hast von hier aus einen guten Ueberblick.");

  AddDetail( ({"gestalten","innere","dienerinnen"}),
	   "Viele weibliche Gestalten huschen ueber den Innenhof.");

  AddDetail( ({"burghof","burghofes","hof","hofes","innenhof"}),
	   "Der Burghof ist mit vielen weissen Blumen geschmueckt. Ausserdem "
	   "befindet sich in der Mitte des Hofes ein grosser Brunnen.");

  AddDetail( ({"brunnen","mitte"}),
	   "Der Brunnen befindet sich der Mitte des Burghofes.");

  AddDetail( ({"blumen","art"}),
	   "Viele weisse Blumen schmuecken den Innenhof.");

  AddDetail( ({"innere","burghof","burghofes"}),
	   "Im Inneren der Burg erkennst Du viele weibliche Gestalten.");

  
  AddDetail( ({"fall","hochmut"}),
	     "Hochmut kommt vor dem Fall.");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau.");
 
   AddDetail( ({"dinge"}),
	   "Na alles musst Du auch nicht wissen.");


  AddDetail( ({"gilde","amazonengilde"}),
	   "Hier befindet sich die Amazonengilde.");

  AddDetail( ({"gildenoberhaupt"}),
	   "Oh da gibt es noch so manche.");

  AddDetail( ({"wind"}),
	    "Den kannst Du nicht untersuchen.");

  AddDetail( ({"reisen"}),
	    "Die Amazonen sind oefters mal auf Reisen.");

  AddDetail( ({"amazone"}),
	    "Sehen kannst Du sie nicht, dafuer lautstark hoeren.");

 
  AddDetail( ({"umrandung"}),
	    "Jede Flagge hat eine goldene Umrandung.");

  AddDetail( ({"schlangen"}),
	    "Sie bilden das Wappen.");

  AddDetail( ({"speer"}),
	    "Jede richtige Amazone hat einen Speer bei sich.");
	    
  AddDetail( ({"lungen"}),
	    "Deine Lungen sind noch jung und unverbraucht.");

  AddDetail( ({"ohren"}),
	   "Deine Ohren hoeren oft viele Dinge, die sie nicht hoeren sollten.");

 
  AddDetail( ({"streitwagen","pferd"}),
	   "Der Streitwagen wird von einem Pferd gezogen.");

  
  AddDetail( ({"gespraechsfetzen","ohr"}),
	   "Lauschen!");

  
  AddDetail( ({"maenner","geschoepfe"}),
	   "Schwache Geschoepfe.");

 
  AddDetail( ({"boden","decke","steinbloecke","steinbloecken"}),
	   "Der Boden und die Decke besteht aus Steinbloecken.");

 
  AddDetail( ({"wappen","schlangen","speer","mitte"}),
	   "Zwei ineinander verschlungene Schlangen, in deren Mitte sich "
	   "ein Speer befindet, bilden das Wappen.");

  
  AddDetail( ({"geruch"}),
	   "Riechen!");

   
    
  AddRoomMessage( ({"Eine Amazone reitet auf einem Pferd an Dir vorbei.\n",
	          "Einige Gespraechsfetzen dringen an Dein Ohr.\n",
		  "Ein Streitwagen knattert an Dir vorbei.\n",
		  "Die Trolle in den Kaefigen aechzen.\n"}), 50);


  
  AddSmell(DEFAULT_SMELL, "Du riechst hier die salzige Meeresluft vermischt "
		  "mit einem wuerzigen Nebengeruch.");

  AddSmell( ({"luft","meeresluft"}),
	   "Die Meeresluft dringt tief in Deine Lungen.");

  AddSmell( ({"nebengeruch"}),
	   "Es ist der Geruch von orientalischen Kraeutern.");

  AddSmell( ({"kraeuter","kraeutern"}),
	   "Die Kraeuter haben die Amazonen von ihren Reisen mitgebracht.");
  
     
  AddSound(DEFAULT_SOUND, "Du hoerst hier das Rauschen des Meeres und auch "
		 "einige Gespraechsfetzen aus der Burg.");
	   

  AddSound( ({"gespraechsfetzen"}),
	   "Eine Amazone kichert: Die Maenner sind alle so schwach.");

  AddSound( ({"rauschen","meeres","meer","brandung"}),
	   "Das Meer rauscht in der Brandung.");	  
  

//-----Details Ende-----
  
  AddExit("osten", ROOM "burg1.lpc");
  AddExit("westen", ROOM "amazon17.lpc");
 
}

 
