// 16.02.2005
// 
// Wolkenraum von Edynia

inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Himmel");
  SetProp( P_INT_LONG,
	"Du bist hier mitten im Himmel. Vor Dir befindet sich ein grosses, "
	"goldenes Tor. Helles Licht dringt von drinnen heraus. Was sich aber "
        "genau hinter diesem Tor verbirgt, kannst Du nur erkennen wenn Du es "
	"durchschreitest. Deine Neugierde wird immer groesser, und Du kannst "
	"es kaum mehr erwarten, das Geheimnis zu lueften.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","weg"}), 
            "Der Boden liegt sehr weit unter Dir. Du hast etwas Angst, dass "
	    "Du von der Wolke fallen koenntest.");
             

  AddDetail( ({"gefuehl","angst"}), 
            "Grosse Angst ueberkommt Dich. Irgendwie bemerkst Du, dass Du "
	    "anscheinend an Hoehenangst leidest.");
            
	 
  AddDetail( ({"hoehenangst"}),
	    "Du wirst panisch!");
      

  AddDetail( ({"geheimnis"}),
	    "Du koenntest das Geheimnis sehr leicht lueften, indem Du einfach "
	    "durch das Tor gehst.");
	    	  
  
  AddDetail( ({"himmel"}),
	    "Du befindest Dich mitten im Himmel.");
	 
  AddDetail( ({"wolken","wolke"}),
	    "Rund um Dich befinden sich viele Wolken.");
	     

  AddDetail( ({"sonnenstrahlen","sonne"}),
	    "Vor lauter Nebel kannst Du die Sonne nicht erkennen.");
         

  AddDetail( ({"licht"}),
	    "Das helle Licht, welches von drinnen nach draussen stroemt, wirkt "            "irgendwie goettlich.");

  AddDetail( ({"neugierde"}),
	    "Neugierige Menschen sterben bald.");

  AddDetail( ({"menschen"}),
	    "Andere Wesen auch, keine Sorge.");

  AddDetail( ({"nebel"}),
	    "Der Nebel huellt Dich ein.");

  AddDetail( ({"tor"}),
	    "Das Tor ist riesengross und besteht aus purem Gold. Es hat "
	    "viele schoene Verzierungen und Du ueberlegst, wieviel Muenzen "
	    "es wohl bringen wuerde, wenn Du es verkaufen wuerdest.");
 
  
  AddDetail( ({"verzierungen"}),
	    "Das Tor ist mit vielen Verzierungen geschmueckt.");

  AddDetail( ({"muenzen","gold"}),
            "Denk nicht einmal daran! Du kannst es nicht verkaufen.");

  AddDetail( ({"wesen","sorge","sorgen","leben"}),
            "Du machst Dir Sorgen um Dein Leben.");
 
            

  
  AddSmell(DEFAULT_SMELL, "Es riecht hier einfach goettlich.");
                        
 
  AddSmell( ({"goettlich"}),
	   "Es ist einfach goettlich, Du kannst es nicht beschreiben.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier nichts.");
	   

  AddSound( ({"nichts"}),
	   "Nichts kann man auch nicht hoeren.");

          
  

//-----Details Ende-----
  

AddExit("westen", ROOM "wolke7.lpc");
AddSpecialExit("tor", "aligntest");
AddItem(NPC "zarah.lpc", REFRESH_DESTRUCT);
AddItem(NPC "thurisaz.lpc", REFRESH_DESTRUCT);
 


}  
 int aligntest()
{ 
  if (TP->QueryProp(P_ALIGN) > 200)
    return TP->move(ROOM "wolke9", M_GO,
        "das Portal", "betritt", "kommt durch das Tor herein");

  write(BS("Du willst das Tor durchschreiten, aber da Du zu boese bist, wirst "
        "Du von den Engeln in die Hoelle verbannt."));
  return TP->move("/d/unterwelt/stahldorn/dammnis/room/dam_c4", M_TPORT,
        "verdammt", "wird", "wird hierher verdammt");
}

   
