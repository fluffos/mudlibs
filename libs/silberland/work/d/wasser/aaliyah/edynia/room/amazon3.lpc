// von Aaliyah
// 27.01.2005
// 
// Raum 3 von Edynia
//
 
inherit "std/room";
#include "../def.h"



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Am Strand von Edynia");
  SetProp( P_INT_LONG,
	"Du stehst am letzten Winkel vom Strand. Hier ist der Sand etwas "
	"steiniger und hohe Felsen ragen rund um Dich empor. Ein kleiner "
	"Durchgang verlaeuft steil zwischen den Felsen hindurch ins Ungewisse. "
	"Das Meer liegt im Schatten der Klippen tiefblau vor Dir. Es scheint "
        "hier sehr tief zu sein. Dieser Ort wirkt nicht sonderlich freundlich "
        "und Du fuehlst eine stille Bedrohung die von den Felsen ausgeht.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "winkel", QueryProp(P_INT_LONG) );

  AddDetail( ({"klippen"}), 
            "Viele steile Klippen saeumen das Strandstueck ein.");

  AddDetail( ({"durchgang"}), 
            "Der Durchgang ist sehr schmal und fuehrt zwischen den Klippen "
	    "hindurch ins Ungewisse.");

  AddDetail( ({"felsen"}), 
            "Die Felsen sind so steil das es unmoeglich scheint, sie ueberwinden "
	    "zu koennen.");
 
  AddDetail( ({"strand","osten","strandstueck"}), 
            "Im Osten gelangst Du wieder auf das Strandstueck zurueck.");
 
  AddDetail( ({"schatten"}), 
            "Die hohen Felsen werfen einen grossen Schatten auf den Strand.");

  AddDetail( ({"bedrohung"}), 
            "Du weisst nicht was hinter diesen Felsen auf Dich lauert und hast "
	    "ein mulmiges Gefuehl. Vielleicht ist es auch nichts Schlimmes. "
	    "Trotzdem ist Dir nicht ganz wohl bei dem Gedanken diesem Durchgang "             "zu folgen.");

  AddDetail( ({"du","dich"}), 
            "Fuehlst Du Dich noch nicht genug angesprochen?");

  AddDetail( ({"gefuehl","magen"}), 
            "Dein Magen krampft sich irgendwie zusammen.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist hier nicht mehr so sandig wie im Osten. Viele "
	    "Felsenstuecke und Gesteinsbrocken liegen hier herum.");
  
  AddDetail( ({"sand"}), 
            "Das bisschen Sand ist wunderschoen weiss.");

  AddDetail( ({"schlimmes"}), 
            "Boese Monster zum Beispiel koennten hinter den Felsen auf Dich "
	    "lauern.");
 
  
  AddDetail( ({"monster","beispiel"}), 
            "Ach Du bist einfach ein Angsthase.");

  AddDetail( ({"kopf","lungen","augen","auge","lunge"}), 
            "Dir ist ganz schwindelig.");

  AddDetail( ({"gedanke","gedanken"}), 
            "Hier ist es so schoen dass Du sogar ein bisschen zu traeumen "
	    "beginnst.");

  AddDetail( ({"salz","meersalz"}), 
            "Meersalz soll gesund sein.");

  AddDetail( ({"brise","wind"}), 
            "Hier weht ein leichter Wind.");

  AddDetail( ({"ungewisse"}), 
            "Wenn Du nachguckst, ist es nicht mehr ungewiss.");

  
  AddDetail( ({"angsthase"}), 
            "Na Du bist ein Angsthase wenn Du dich hier nicht weiter traust.");
 
  AddDetail( ({"ort"}), 
            "Dieser Ort wirkt sehr bedrohlich.");
 
  AddDetail( ({"felsenstuecke"}),
	     "Einige unbedeutende Felsenstuecke liegen hier herum.");	  

  AddDetail( ({"gesteinsbrocken"}),
	    "Die Gesteinsbrocken stammen wohl von den Felsen.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau. Leider wird die Sonne von den "
	    "steilen Klippen vollkommen verdeckt.");
	 
  AddDetail( ({"sonne"}),
	    "Die Sonne versteckt sich hinter den Klippen.");

  AddDetail( ({"wirkung","ursache"}), 
            "Jede Ursache hat eine Wirkung.");

  AddDetail( ({"ferne"}), 
            "In der Ferne fliegen einige Moewen und kreischen.");
         

  AddDetail( ({"wasser"}), 
            "Das Wasser ist wirkt im Schatten der Felsen fast schwarz.");
 
  
  AddRoomMessage( ({"Die Wellen rauschen leise vor sich hin.\n",
	          "Ein paar Moewen kreischen in weiter Ferne.\n",
		  "Der Wind weht etwas Sand in Deine Augen.\n",
		  "Du riechst eine leichte Brise Meersalz.\n",
		  "Leichter Wind heult zwischen den Felsen.\n"}), 40);
  

  
  AddSmell(DEFAULT_SMELL, "Die Meeresluft riecht leicht salzig aber wirkt sehr "
		          "erfrischend auf Dich.");

  AddSmell( ({"meeresluft","meerluft"}),
	   "Du saugst die frische Meeresluft in Deine Lungen ein.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst das Kreischen der Moewen und das sanfte "
		  "Rauschen der Wellen.");
	   

  AddSound( ({"kreischen","moewen","moewe"}),
	   "Die Moewen kreischen hoch ueber Deinem Kopf.");

  AddSound( ({"rauschen","wellen","welle"}),
           "Die Wellen rauschen leise und stroemen eine beruhigende Wirkung "
	   "auf Dich aus.");

  AddSound( ({"meer"}),
	   "Es rauscht.");
           
  

//-----Details Ende-----
  
  AddExit("nordostoben", ROOM "amazon4.lpc");
  AddExit("osten", ROOM "amazon1.lpc");
}
