// von Aaliyah
// 16.02.2005
// 
// Wolkenraum von Edynia

inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Himmel");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier in einem sehr hellen Raum. Die Waende scheinen "
	"aus Nebel zu bestehen und auch der Boden besteht aus dichtem Dunst. "
        "An der Ostwand befindet sich ein grosses Podest, auf dem sich ein "
	"grosser, goldener Thron befindet. In der Mitte des Raumes erkennst "
	"Du ein Loch ueber dem sich ein seltsamer Schimmer befindet. Daneben "
	"steht ein gemuetlicher Schaukelstuhl. Du fuehlst Dich hier sehr wohl "
	"und wuerdest hier gerne ewig verweilen.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

 AddDetail( ({"raum","raumes"}),QueryProp(P_INT_LONG));
        
  

  
  AddDetail( ({"boden","dunst","nebelschwaden","schaden"}), 
            "Der Boden besteht aus dichtem Dunst. Einige kleine Nebelschwaden "
	    "ziehen vom Boden auf.");
             

  AddDetail( ({"decke","waende"}), 
            "Die Waende bestehen hier aus purem Nebel. Er ist so dicht, dass "
	    "Du nicht erkennen kannst, was sich dahinter befindet.");
            
	 
  AddDetail( ({"nebel","wolke"}),
	    "Hier besteht alles aus Nebel. Du befindest Dich eigentlich in "
	    "einer riesigen Wolke.");
      

  AddDetail( ({"ostwand","podest"}),
	    "An der Ostwand befindet sich ein grosser Podest. Einige Stufen "
	    "fuehren zu dem goldenen Thron, der sich darauf befindet.");
	    	  
  
  AddDetail( ({"himmel"}),
	    "Du befindest Dich mitten im Himmel.");
	 
  AddDetail( ({"stufen"}),
	    "Die Stufen bestehen aus Nebel und fuehren direkt zum Thron.");
	     

  AddDetail( ({"thron","gebilde"}),
	    "Der goldene Thron ist ein wunderschoenes Gebilde. Er hat viele "
	    "Verzierungen aus Edelsteinen und eine kleine Wolke dient als "
	    "Sitzunterlage.");
         

  AddDetail( ({"edelsteine","edelsteinen","verzierungen"}),
	    "Viele verschnoerkelte Verzierungen aus vielen bunten, reinen "
	    "Edelsteinen zieren den goldenen Thron.");

  AddDetail( ({"sitzunterlage","unterlage"}),
	    "Hera muss ja weich sitzen, auch wenn sie oefters am Schaukelstuhl "
	    "als auf dem Thron sitzt.");

  AddDetail( ({"mitte","loch","spiegel"}),
	    "Du blickst in das Loch und siehst das gesamte Silberland unter "
	    "Dir. Das Loch scheint der Spiegel der Welt zu sein.");

  AddDetail( ({"schimmer"}),
	    "Ein leichter blauer Schimmer befindet sich ueber dem Loch.");

  AddDetail( ({"hoehe","erdboden"}),
	    "Du befindest Dich weit ober dem Erdboden.");
 
  
  AddDetail( ({"silberland","welt"}),
	    "Du erkennst den Silberwald, Tijara, das Polargebiet, Midas, "
	    "Elessar, das Gebirge, Derlim, die grosse weite Wueste und auch "
	    "das Silbermeer mit seinen kleinen Inseln darin.");

  AddDetail( ({"polargebiet","polar"}),
            "Das Polargebiet liegt weiss und klirrend kalt unter Dir. Du "
	    "siehst die Iglus von Yiqanuc, die wie kleine Schneebaelle "
	    "aussehen.");

  AddDetail( ({"yiqanuc","schneebaelle","iglus","baelle"}),
	    "Aus dieser enormen Hoehe scheinen die Iglus wie kleine "
	    "Schneebaelle.");
  
  AddDetail( ({"silberwald","wald","baeume","silberwaldes","graeser"}),
	    "Die Baeume des Silberwaldes wirken von hier aus wie Graeser.");

  AddDetail( ({"tijara","dschungel","flaeche"}),
	    "Tijara liegt sehr weit weg von hier. Der Dschungel wirkt wie "
	    "eine einzige gruene Flaeche und auch die Schiffe sehen irgendwie "
	    "aus wie kleine weisse Punkte.");

  AddDetail( ({"schiffe","punkte","silbermeer","meer"}),
	    "Die Schiffe sind kleine weisse Punkte im grossen Silbermeer.");

  AddDetail( ({"midas","derlim","gebaeude","haeuser","puppenhaeuser"}),
	    "Die Gebaeude von Midas und Derlim wirken wie kleine, suesse "
	    "Puppenhaeuser.");

  AddDetail( ({"elessar","astgeflecht","haeuser","baumkronen","talane"}),
	    "Elessar ist ein einzig gruenes Astgeflecht. Die Haeuser und die "
	    "Talane sind unter den Baumkronen versteckt, sodass Du sie von "
	    "schlecht erkennen kannst. Lediglich Hera hat den Durchblick.");

  AddDetail( ({"hera","durchblick","muttergoettin","goettin","ueberblick"}),
	    "Hera ist die Muttergoettin und hat den Ueberblick ueber das ganze "
	    "Silberland.");

  AddDetail( ({"inseln","flecken","flecke"}),
	    "Die Inseln sind kleine, braune Flecken im blauen Silbermeer.");

  AddDetail( ({"gebirge"}),
	    "So hoch auch das Gebirge ist, es befindet sich sehr weit unter "
	    "Dir.");

  AddDetail( ({"wueste","sand"}),
	    "Von hier aus merkst Du erst wie gross die Wueste ist. Sie liegt "
	    "mit all ihren Oasen westlich von Dir. Der Sand scheint so heiss "
	    "zu sein, das ein grosses Flimmern sich ueber der ganzen Wueste "
	    "befindet.");

  AddDetail( ({"oasen","erg","arrakeen","quaul","wuestendoerfer","doerfer"}),
	    "Arrakeen, Erg und Quaul sind Wuestendoerfer.");

  AddDetail( ({"flimmern","hitze"}),
	    "Das Flimmern ensteht wegen der enormen Hitze.");

  AddDetail( ({"schaukelstuhl","wolkenstuhl","stuhl"}),
	    "Es ist vielmehr ein Wolkenstuhl so weich wie seine Polsterung "
	    "aussieht. Hera ruht sich hier gemuetlich aus, wenn sie die ganze "
	    "Welt ueberblickt.");

  AddDetail( ({"polsterung"}),
	    "Einfach nur weich und gemuetlich.");

  AddDetail( ({"blitze","schar","engel","haare","lichtstrahlen","strahlen"}),
	    "Du bist wie gebannt und geniesst einfach nur.");
 
 
 
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach nichts.");
                        
 
  AddSmell( ({"nichts"}),
	   "Nichts kann man nicht riechen.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier nichts.");
	   

  AddSound( ({"nichts"}),
	   "Nichts kann man auch nicht hoeren.");

 AddRoomMessage( ({"Sanfter Nebel zieht vom Boden auf.\n",
                  "Einige Blitze zucken durch den Raum.\n",
                  "Eine Schar Engel zieht an Dir vorbei.\n",
                  "Ein Engel kaemmt Hera die Haare.\n",
                  "Viele Lichtstrahlen stroemen in den Raum.\n",
                  "Ein kleiner Engel laechelt Dich verstohlen an.\n",
                  "Du fuehlst Dich hier sehr wohl und geborgen.\n"}), 80);
 
  

          
  

//-----Details Ende-----
  
AddExit("westen", ROOM "wolke8.lpc");
AddItem(NPC "gottmutter.lpc", REFRESH_DESTRUCT);

}  
   
