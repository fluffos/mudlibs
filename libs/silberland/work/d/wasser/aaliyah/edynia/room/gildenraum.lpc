inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Thronsaal der Amazonenburg" );
  SetProp(P_INT_LONG, 
    "Du stehst im Thronsaal der Amazonenburg. Voller Ehrfurcht betrachtest "
    "Du die langen Saeulenreihen, die auf beiden Seiten des Saales bis "
    "zum Thron fuehren. Zwischen den maechtigen Marmorsaeulen befinden sich "
    "Blumengestecke, kleine Tischchen mit Obstschalen und Fackelhalter. "
    "Am Ende des Saales steht auf einer Erhebung ein goldener Thron. "
    "Dahinter haengt ein grosses Wappen an der Wand. Nach Westen kannst "
    "Du den Saal wieder verlassen." );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"saal", "thronsaal", "raum"}), QueryProp(P_INT_LONG));

  AddDetail( ({ "waende" }),
    "Die Waende sind mit Wappen, Trophaeen und Gemaelden geschmueckt.");

  AddDetail( ({"wand"}),
    "Welche Wand meinst Du? Die Nordwand, Suedwand, Ostwand oder Westwand?");

  AddDetail( ({"ostwand", "osten"}),
    "An der Ostwand hinter dem Thron befindet sich ein grosses Wappen.");

  AddDetail( ({"westwand", "westen"}),
    "Im Westen kannst Du den Saal wieder verlassen.");

  AddDetail( ({"nordwand", "norden"}),
    "An der Nordwand befinden sich verschiedene Gemaelde.");

  AddDetail( ({"suedwand", "sueden"}),
    "An der Suedwand haengen viele Trophaeen.");

  AddDetail( ({"boden"}),
    "Der Boden besteht aus feinstem Marmor. In der Mitte des Saales liegt "
    "ein grosser, runder Teppich.");

  AddDetail( ({"decke"}),
    "Die kuppelartige Decke wird von den Saeulenreihen getragen.");

  AddDetail( ({"kuppel"}),
    "Die Decke aehnelt einer Kuppel.");

  AddDetail( ({"burg", "amazonenburg"}),
    "Du befindest Dich im Thronsaal der Amazonenburg.");

  AddDetail( ({"ehrfurcht"}),
    "Du erschauderst voller Ehrfurcht vor diesem wunderschoenen Saal.");

  AddDetail( ({"saeulenreihen", "reihen"}),
    "Zwei Reihen mit maechtigen Saeulen tragen die Decke des Saales.");

  AddDetail( ({"saeulenreihe", "reihe"}),
    "Welche Saeulenreihe meinst Du? Die noerdliche oder die suedliche?");

  AddDetail( ({"seiten"}),
    "auf beiden Seiten des Thronsaales befinden sich zwei Saeulenreihen.");

  AddDetail( ({"thron"}),
    "An der Ostwand steht auf einer Erhebung ein goldener Thron.");

  AddDetail( ({"saeulen", "marmorsaeulen", "saeule", "marmorsaeule"}),
    "Die Saeulen sind aus feinstem Marmor und mit vielen Verzierungen "
    "geschmueckt.");

  AddDetail( ({"blumengestecke" ,"blumengesteck", "flair"}),
    "Die Blumengestecke duften himmlisch und geben dem Raum ein gewisses "
    "Flair.");

  AddDetail( ({"tisch", "tischchen"}),
    "Auf den kleinen Tischchen zwischen den Saeulen stehen Schalen mit Obst.");

  AddDetail( ({"obstschalen", "schalen"}),
    "Die Schalen stehen auf den kleinen Tischchen und sind mit Obst gefuellt.");

  AddDetail( ({"obst"}),
    "Suesses Obst befindet sich in den Obstschalen.");

  AddDetail( ({"fackelhalter", "halter"}),
    "Fackeln brennen in den Haltern und beleuchten den Saal.");

  AddDetail( ({"fackel", "fackeln", "spiel", "licht", "schatten"}),
    "Die Fackeln lodern hell und beleuchten den Saal. Durch die vielen Saeulen "
    "entsteht an den Waenden ein betoerendes Spiel von Licht und Schatten.");

  AddDetail( ({"ende"}),
    "Der Saal endet im Osten beim Thron.");

  AddDetail( ({"erhebung", "stufen", "stufe"}),
    "Zwei Stufen fuehren die Erhebung zum Thron hoch.");

  AddDetail( ({"wappen", "speer", "schlangen", "schlange"}),
    "Das Wappen zeigt einen goldenen Speer, der von zwei Schlangen umwunden ist.");

  AddDetail( ({"trophaeen", "trophaee"}),
    "");

  AddDetail( ({"gemaelde", "bild", "bilder", "oelgemaelde"}),
    "Es handet sich um wertvolle Oelgemaelde. Die Bilder zeigen Amazonen "
    "in Schlachten und Kaempfen mit den gefaehrlichsten Monstern des "
    "SilberLandes.");

  AddDetail( ({"marmor"}),
    "Bei dem Marmor handelt es sich um den seltenen Rosenmarmor.");

  AddDetail( ({"rosenmarmor", "aederungen"}),
    "Der Rosenmarmor ist weiss mit feinen rosa Aederungen.");

  AddDetail( ({"teppich"}),
    "In der Mitte des Saales liegt ein grosser, runder Teppich.");

  AddDetail( ({"amazonen"}),
    "Auf dieser Burg leben die Amazonen.");

  AddDetail( ({"gilde", "amazonengilde", "zentrum"}),
    "Hier ist das Zentrum der Amazonengilde.");

  AddDetail( ({"edynia", "insel", "amazoneninsel"}),
    "Du bist auf der Insel Edynia.");

  AddDetail( ({"mitte"}),
    "Mitten in den Mitte.");

  AddDetail( ({"verzierungen", "verzierung"}),
    "Die Verzierungen der Saeulen sind sehr verspielt.");

  AddDetail( ({"schlachten", "schlacht", "horde"}),
    "Du moechtest in keiner Schlacht einer Horde Amazonen gegenueberstehen.");

  AddDetail( ({"kaempfe", "kampf", "kriegerinnen", "kriegerin", "weg"}),
    "Amazonen sind mutige Kriegerinnen und gehen keinem Kampf aus dem Weg.");

  AddDetail( ({"monster"}),
    "Du siehst alle bekannten Monster, die von Amazonen besiegt werden.");

  AddDetail( ({"silberland"}),
    "Du befindest Dich im SilberLand, genauer gesgt auf Edynia, der Amazoneninsel.");

  AddDetail( ({""}),
    "");

  AddDetail( ({""}),
    "");

  AddDetail( ({""}),
    "");

  AddExit("westen", ROOM "burg8");
  AddExit("norden", ROOM "toepferraum.lpc");
}
