// Burgmauer der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor dem Thronsaal der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier im Hof der Amazonenburg. Im Westen siehst "
	"Du den Springbrunnen und im Osten gelangst Du in den Thronsaal. "
        "Um den Torbogen, der in den Saal fuehrt, wachsen lauter weisse und "
        "hellblaue Rosen. Auch neben dem Eingang sind viele Rosenbuesche. "
	"Ausserdem hast Du von hier aus einen guten Ueberblick auf den "
	"restlichen Hof. Aus den Stallungen im Norden hoerst Du leises "
	"Gewieher. Ansonsten ist es hier genauso idyllisch wie in den anderen "
	"Teilen des Hofes. ");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//----------------Details Anfang----------------------------
 AddDetail( ({"hof","burghof","teil","ueberblick","hofes"}), QueryProp(P_INT_LONG));

 AddDetail( ({"boden","rasen","gras"}), 
            "Das Gras wurde hier etwas zusammengetrampelt.");

 AddDetail( ({"himmel"}), 
            "Der Himmel ist strahlend blau.");

 AddDetail( ({"gewieher","stallungen","pferde","norden"}), 
            "Die Pferde wiehern in den Stallungen.");

 AddDetail( ({"torbogen","rosen","torbogens","bogens","bogen","blumen"}), 
            "Entlang des Torbogens wachsen weisse und hellblaue Rosen.");

 AddDetail( ({"eingang"}), 
            "Der Eingang fuehrt direkt in den Thronsaal.");

 AddDetail( ({"thronsaal","aufenthaltsort","saal","osten"}), 
            "Der Thronsaal ist der Aufenthaltsort der Amazonenkoenigin. "
	    "Hier koennen sich Anwaerter fuer die Gilde bewaehren.");

 AddDetail( ({"amazonenkoenigin","koenigin"}), 
            "Die Amazonenkoenigin nimmt es mit den Bestimmungen fuer ihre "
	    "Gilde sehr genau.");

 AddDetail( ({"bestimmungen","gilde","anwaerter"}), 
            "Nicht jeder Anwaerter wird auch in die Gilde aufgenommen.");

 AddDetail( ({"rosenbuesche","buesche","bueschen","rosenbueschen","rose","busch"}), 
            "Auf den Bueschen wachsen viele schoene hellblaue und auch "
	    "weisse Rosen.");

  AddDetail( ({"westen","brunnen","springbrunnen","brunnens","wasser"}), 
            "Im Westen platschert das Wasser des Brunnens vor sich hin.");

  
  AddDetail( ({"amazonen"}), 
            "Ueberall sind Amazonen.");

  
  AddDetail( ({"nase","rudolf","rosenduft"}), 
            "Du singst 'Rudolf the rednose...'.");

  
  AddDetail( ({"schmetterlinge"}), 
            "Einige hellviolette Schmetterlinge tummeln sich um die Blumen.");

  
  AddDetail( ({"dienerin","dienerinnen"}), 
            "Auf der Burg wimmelt es nur so von Dienerinnen.");



  AddDetail( ({"pferd"}), 
            "Ein praechtiges weisses Pferd wird von einer Dienerin gefuehrt.");



  AddDetail( ({"burg","amazonenburg"}), 
            "Du stehst mitten drin.");

 
 
  AddSmell(DEFAULT_SMELL, "Die Rosen von den Bueschen duften himmlisch blumig.");

  AddSmell( ({"rosen","rosenduft"}),
	   "Die vielen Rosen duften herrlich.");

     
  AddSound(DEFAULT_SOUND, "Du hoerst einige Amazonen lachen und auch noch "
		  "das Wiehern der Pferde aus den Stallungen.");
	   

  AddSound( ({"amazonen","lachen"}),
	  "Die Amazonen lachen ausgelassen.");
  
  AddSound( ({"wiehern","pferde"}),
	  "Die Pferde aus den Stallungen wiehern.");

  AddRoomMessage( ({"Eine Dienerin huscht an Dir vorbei.\n",
	          "Zarter Rosenduft umschmeichelt Deine Nase.\n",
		  "Eine Dienerin fuehrt ein weisses Pferd an Dir vorbei.\n",
		  "Einige Amazonen schreiten in den Thronsaal.\n",
		  "Du hoerst die Koenigin nach der Dienerin rufen.\n",
		  "Eine Dienerin bricht eine Rose vom Busch.\n",
		  "Ein paar Schmetterlinge flattern an Dir vorbei.\n"}), 80);
 
  AddItem(NPC "amazone_wache", REFRESH_DESTRUCT);

//---------------Details Ende-----------------------------
  AddExit( "norden", "./burg7");
  AddExit( "sueden", "./burg9");
  AddExit( "westen", "./brunnen");
  AddExit( "osten", "/gilden/amazonen");
}  
   
