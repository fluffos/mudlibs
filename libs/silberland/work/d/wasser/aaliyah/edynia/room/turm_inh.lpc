// Inherit fuer Turmraeume
 
inherit "std/room";
#include "../def.h"

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Turm der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du stehst hier auf einer schmalen Wendeltreppe. Sie fuehrt steil "
	"in die Turmspitze hinauf. An den Waenden befinden sich lauter "
	"Fackelhalter, die den Raum in warmes Licht tauchen. Durch ein "
	"kleines Fenster kannst Du auf die Burg hinunter sehen. Dir wird "
	"als Du in die Tiefe blickst.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//---------Details Anfang-------------

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );

  
  AddDetail( ({"wendeltreppe"}),
	   "Die Wendeltreppe fuehrt steil in die Turmspitze hinauf.");

  
  AddDetail( ({"turmspitze"}),
	   "Was sich in der Turmspitze befindet kannst Du von hier aus "
	   "nicht erkennen.");

  
  AddDetail( ({"wand","waende","waenden"}),
	   "Die Waende bestehen vollkommen aus Stein. Einige Fackelhalter "
	   "wurden an ihnen angebracht");

  
  AddDetail( ({"fackelhalter","fackelhaltern"}),
	   "In den Fackelhaltern befinden sich Fackeln und spenden dem Raum "
	   "etwas Licht.");

  
  AddDetail( ({"licht","fackeln","feuer","fackel"}),
	   "Das Licht der Fackeln strahlt eine feine Waerme aus.");


  
  AddDetail( ({"waerme"}),
	   "Du fuehlst Dich hier sehr wohl.");

  
  AddDetail( ({"fenster","ueberblick","fenstern"}),
	   "Durch die kleinen Fenster hast Du guten Ueberblick ueber die "
	   "Landschaft und den Burghof.");

  
  AddDetail( ({"burghof","burg","mitte"}),
	   "Der Burghof befindet sich in der Mitte der Burg.");

  
  AddDetail( ({"landschaft"}),
	   "Von einigen Fenstern kannst Du das Meer erkennen und von "
	   "den anderen Fenstern hast Du ueberblick auf die Gaerten.");

  
  AddDetail( ({"meer"}),
	   "Das Meer liegt tiefblau unter Dir.");

  
  AddDetail( ({"gaerten"}),
	   "Die Gaerten von Edynia sind der ganze Stolz der Amazonen.");

  
  AddDetail( ({"amazonen"}),
	   "Du bist jetzt mitten unter ihnen.");

  
  AddDetail( ({"stolz"}),
	   "Die Amazonen haben maechtigen Stolz.");

  
  AddDetail( ({"edynia","amazoneninsel"}),
	   "Edynia ist die Amazoneninsel.");

  
  AddDetail( ({"boden","stufen"}),
	   "Du stehst auf steinigen Stufen.");

 
  AddDetail( ({"decke"}),
	   "Die Decke besteht aus Stein. Keine einzige Spinnwebe ist daran "
	   "zu erkennen.");



  AddDetail( ({"spinnwebe","spinnweben","hinweise"}),
	   "Die Amazonen moegen keine Spinnen und somit achten die Dienerinnen "
	   "immer darauf, alle Hinweise auf eine Spinne zu beseitigen.");

  
  AddDetail( ({"spinne","spinnen","viecher"}),
	   "Spinnen sind eklige Viecher.");

  
  AddDetail( ({"dienerinnen","dienerin"}),
	   "Die Dienerinnen eilen emsig durch die Burg.");

  
  AddDetail( ({"tiefe"}),
	   "Es geht hier sehr weit nach unten.");

  AddDetail( ({"moewen"}),
	   "Die Moewen fliegen an den Fenstern vorbei.");

  AddDetail( ({"worte","ohr"}),
	   "Dein Ohr kann die Worte nicht genauer erlauschen.");

  
  AddDetail( ({"es","stein"}),
	   "Es besteht hier fast alles aus Stein.");

  
  AddDetail( ({"amazone"}),
	   "Die Amazone war zu schnell um sie genauer betrachen zu koennen.");


 

  AddRoomMessage( ({"Die Feuer der Fackeln lodert.\n",
	          "Eine Dienerin huscht an Dir vorbei.\n",
		  "Eine vorbeilaufende Amazone stubst Dich unabsichtlich.\n",
		  "Einige Moewen fliegen an den Fenstern vorbei.\n"}), 50);
 
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach dem verbrannten Holz der "
		  "Fackeln.");

  AddSmell( ({"holz","fackeln","fackel"}),
	     "Das verbrannte Holz der Fackeln hat einen beissenden Geruch.");

  AddSmell( ({"geruch"}),
	     "Beissend!");

     
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur leicht das Meer rauschen und "
		  "auch einige Worte dringen an Dein Ohr.");

  AddSound( ({"meer","rauschen"}),
	    "Das Meer rauscht leise vor sich hin.");
	   

  AddSound( ({"worte"}),
	   "Du kannst die Worte nicht verstehen.");

 }


  
   
