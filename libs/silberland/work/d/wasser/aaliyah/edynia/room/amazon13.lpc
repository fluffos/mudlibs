// Raum 13 von Edynia
//
 
inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einem steilen Aufgang");
  SetProp( P_INT_LONG,
	"Du stehst hier auf einem Weg in den Klippen. Er fuehrt steil nach oben "
       	"hin zur Burg. Hier ist alles sehr felsig. Am Boden erkennst Du viele "
	"Wagen und Pferdespuren. Es ist ein Zeichen dafuer das hier ein reger "
	"Betrieb sein muss. Rechts und links faellt die Klippe steil nach unten "
	"ins Meer hinein. Der Abgrund neben Dir ist so tief, das Du panische "
	"Hoehenangst bekommst und Dich etwas weiter in die Mitte begibst.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "weg", QueryProp(P_INT_LONG) );

  AddDetail( ({"zeichen"}),
	   "Es gibt viele Zeichen und Schriften.");

  AddDetail( ({"schriften"}),
	   "Bist Du ein Berserker das Du nicht lesen und schreiben kannst?");


  AddDetail( ({"klippen","klippe"}), 
            "Die Klippen fallen steil nach unten ins Meer hinein.");

  AddDetail( ({"meer"}), 
            "Das Meer liegt sehr weit unter Dir und scheint hier aeusserst "
	    "tief zu sein. Genau sagen kannst Du es nicht. Du schliesst es "
	    "einfach aus der tiefblauen Farbe.");

  AddDetail( ({"farbe"}), 
            "Das Meer hat eine tiefblaue Farbe.");

  AddDetail( ({"burg","sicht"}), 
            "Du kannst die Burg hier noch nicht erkennen, da Dir eine grosse "
	    "Klippe die Sicht versperrt.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist hier sehr felsig. Einige Wagen und Pferdespuren "
	    "befinden sich auf ihm.");


  AddDetail( ({"pferdespuren","wagenspuren","pferdespur","wagenspur",
		"spuren","spur"}), 
            "Viele Wesen scheinen die Burg zu besuchen denn die Spuren deuten "
	    "auf einen regen Betrieb hin.");
 
  
  AddDetail( ({"rechts","links"}), 
            "Rechts und links befindet sich der steile Abgrund.");

  AddDetail( ({"abgrund"}), 
            "Der Abgrund faellt steil ins Meer.");


  AddDetail( ({"betrieb"}), 
            "Die Amazonen werden von vielen Wesen besucht.");
  
  AddDetail( ({"amazonen","edynia","insel"}), 
            "Edynia ist die Insel der Amazonen.");
  
  AddDetail( ({"wesen","rassen"}), 
            "Alle moeglichen Rassen besuchen die Amazonenburg.");

  AddDetail( ({"amazonenburg","besucher","grund"}), 
            "Hippolyte ist die Amazonenkoenigin und auch wohl der Grund fuer "
	    "die vielen Besucher hier.");

    
  AddDetail( ({"amazonenkoenigin","hippolyte","schoenheit"}), 
            "Die Amazonenkoenigin ist von unglaublicher Schoenheit. Sie hat "
	    "den Anmut einer Frau und die Kraft und den Mut eines Mannes.");
  
  AddDetail( ({"gefahr","gefahren"}),
	     "Mutig sind die Berserker schon, das muss man ihnen lassen.");
  
  AddDetail( ({"anmut","frau","frauen"}), 
            "Frauen sollten schon anmutig sein.");

  AddDetail( ({"axt","aexten","aexte"}),
	     "Stumpfsinnig mit sowas zu kaempfen.");

  AddDetail( ({"nachhilfe"}),
	     "Ein Berserker braucht Nachhilfe in Intelligenz.");

  AddDetail( ({"wagen"}),
	     "Hier kommt schon oft ein Wagen vorbei.");
 
  AddDetail( ({"kraft","mut","mann","mannes"}), 
            "Ein Mann sollte Kraft und Mut besitzen und wenn dem nicht der Fall "
	    "ist, kann er sich bei Kronang Nachhilfe geben lassen.");
 
  AddDetail( ({"kronang"}),
	   "Kronang ist zwar stark und mutig, aber das liegt nur daran das er "
	   "sowenig Intelligenz besitzt um zu wissen welche Gefahren ueberall "
	   "lauern koennen.");

  AddDetail( ({"intelligenz"}),
	   "Intelligenz ist Mangelware bei den Berserkern.");

  AddDetail( ({"mangelware"}),
	   "Dort wo andere Gildenmitglieder ein Gehirn haben, befindet sich "
	   "bei den Berserkern nur ein Loch.");

  AddDetail( ({"gildenmitglieder","gildenmitglied","gilden","mitglieder"}),
	   "Alle Mitglieder anderer Gilden haben mehr Intelligenz als die Berserker.");

  AddDetail( ({"loch","effekt"}),
	   "Selbst wenn die Berserker es mit Stroh stopfen wuerden, haette es "
	   "denselben Effekt.");

  AddDetail( ({"stroh"}),
	   "Ich glaube Kronang hat doch etwas faules Stroh im Kopf.");

  AddDetail( ({"kopf","hals"}),
	   "Ein Berserker hat seinen Kopf nur deshalb, damit es ihm nicht in "
	   "den Hals regnet.");

  AddDetail( ({"gehirn"}),
	   "Bist Du ein Berserker das Du nicht weisst was ein Gehirn ist?");

  AddDetail( ({"berserker"}),
	   "Die Berserker sind eine sehr starke Gilde. Sie kaempfen mit Aexten "
	   "und erinnern irgendwie an Bauern beim Zerkleinern von Winterholz. "
	   "Genauso ist auch ihr Kampfstil. Da sie keine Intelligenz besitzen "
	   "wissen die meisten von ihnen nicht einmal was ein Astralring ist.");

  AddDetail( ({"bauern","zerkleinern","winterholz"}),
	   "Die Berserker kaempfen wie die Bauern.");

  AddDetail( ({"kampfstil"}),
	   "Irgendwie erinnern die Berserker auch an Neandertaler. Sie wueten "
	   "wie die Irren, sie zerbeissen sich die Lippen und sie froehnen mit "
	   "ihrem Spalten dem ewigen Holzfaellerdasein.");

  AddDetail( ({"lippen","irren","spalten","nachsicht"}),
	   "Man habe Nachsicht mit den Berserkern.");

  AddDetail( ({"holzfaellerdasein","winterholz"}),
	   "Wenn wir genuegend Berserker haben, gibt es auch genug Winterholz.");

  AddDetail( ({"astralring"}),
	   "Frag einen Berserker danach, er wirds nicht wissen.");

  AddDetail( ({"neandertaler"}),
	   "Man kann nur hoffen das sie ihre Frauen nicht so roh behandeln.");

  
  AddDetail( ({"fall","hochmut"}),
	     "Hochmut kommt vor dem Fall.");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");
	 
   
  AddDetail( ({"mitte"}),
	   "Noch weiter in die Mitte kannst Du nicht gehen.");

  AddDetail( ({"hoehenangst","aengste"}),
	   "Du hast Hoehenangst? Melde Dich bei den Berserkern. Da verlierst "
	   "Du soviel Intelligenz das Du nicht mehr ueber Aengste nachdenkst.");

  AddDetail( ({"gilde","amazonengilde"}),
	   "Hier befindet sich die Amazonengilde.");

  AddDetail( ({"gildenoberhaupt"}),
	   "Oh da gibt es noch so manche.");


  AddDetail( ({"nordostoben"}), 
            "Nach Nordostoben gelangst Du zur Burg hinauf.");

  AddDetail( ({"wind"}),
	    "Den kannst Du nicht untersuchen.");

  AddDetail( ({"tuerme","tuermen"}),
	    "Die Tuerme ragen majaestetisch in den Himmel empor.");

  AddDetail( ({"umrandung"}),
	    "Jede Fahne hat eine goldene Umrandung.");

  AddDetail( ({"wappen","wappens","umrisse"}),
	    "Zwei ineinander verschlungene goldene Schlangen. In der Mitte "
	    "dieser Schlangen befindet sich ein Speer.");

  AddDetail( ({"schlangen"}),
	    "Sie bilden das Wappen.");

  AddDetail( ({"speer"}),
	    "Jede richtige Amazone hat einen Speer bei sich.");
	    
  AddDetail( ({"lungen"}),
	    "Deine Lungen sind noch jung und unverbraucht.");

  AddDetail( ({"ohren"}),
	   "Deine Ohren hoeren oft viele Dinge, die sie nicht hoeren sollten.");

  AddDetail( ({"dinge"}),
	   "Na alles musst Du auch nicht wissen.");

  
  AddSmell(DEFAULT_SMELL, "Du riechst hier die salzige Meeresluft.");

  AddSmell( ({"luft","meeresluft"}),
	   "Die Meeresluft dringt tief in Deine Lungen.");
  
     
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur den Wind und das Plaetschern der "
		 "Wellen.");
	   

  AddSound( ({"wind"}),
	   "Der Wind pfeift Dir um die Ohren.");

  AddSound( ({"plaetschern","wellen"}),
	   "Die Wellen prallen an die Klippen.");	  
  

//-----Details Ende-----
  
  AddExit("nordostoben", ROOM "amazon14.lpc");
  AddExit("suedwestunten", ROOM "amazon12.lpc");
 
}

 
