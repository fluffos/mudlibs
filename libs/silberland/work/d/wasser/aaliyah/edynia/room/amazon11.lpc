#include "../def.h"
#include <ansi.h>
inherit "std/room";


int grundzustand();
int ast_da;

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In Edynia");
  SetProp( P_INT_LONG,
	"Du stehst hier am Rande einer steilen Klippe. Ein breiter Weg fuehrt "
       	"hinauf zur Burg. Der Boden ist hier sehr felsig und nur mehr wenige "
	"Blumen wachsen hier. Irgendwie ist Dir leicht mulmig bei dem Gedanken "
	"diese steile Klippe zu erklimmen mit der Ungewissheit was Dich dort "
	"oben wohl erwarten wird. Rechts und links neben der Klippe befindet "
	"sich ein tiefer Abgrund. Direkt neben Dir waechst eine schoene, "
	"purpurne Linde. Wenn Du mutig bist kannst Du nach Nordosten "
	"Richtung Burg gehen oder nach Westen zu den Gaerten zurueckkehren.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "rande", QueryProp(P_INT_LONG) );

  AddDetail( ({"blumen"}), 
            "Die Blumen wachsen hier sehr spaerlich. Einige wenige Orchideen "
	    "und ein paar Lilien, aber das wars dann schon.");

  AddDetail( ({"ungewissheit"}), 
            "Es ist ungewiss was Dich auf der Burg erwartet.");


  AddDetail( ({"weg","burg","richtung"}), 
            "Ein breiter Weg fuehrt hinauf zur Burg.");


  AddDetail( ({"klippe"}), 
            "Die Klippe verlaeuft steil nach oben.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist hier sehr felsig.");


  AddDetail( ({"mitte","sueden"}), 
            "Die Mitte der Gaerten befindet sich im Sueden.");
 
  
  AddDetail( ({"rechts","links"}), 
            "Rechts und links befindet sich der steile Abgrund.");

  AddDetail( ({"abgrund","meer"}), 
            "Der Abgrund faellt steil ins Meer.");


  AddDetail( ({"groessen"}), 
            "Die Blumen hier haben alle moeglichen Farben und Groessen.");
  
  AddDetail( ({"klippe"}), 
            "Eine maechtige Klippe befindet sich Dir.");
  
  AddDetail( ({"fahnen"}), 
            "An jedem der Tuerme befindet sich eine hellblaue Fahne.");

  AddDetail( ({"gedanke","gedanken"}), 
            "Du gruebelst.");

    
  AddDetail( ({"lilie","lilien"}), 
            "Einige Lilien wachsen hier.");

  AddDetail( ({"amazoneninsel"}), 
            "Du bist auf der Amazoneninsel.");
 
    
  AddDetail( ({"blumenwiesen"}), 
            "Die Blumenwiesen befinden sich suedlicher von hier.");
  
  
  AddDetail( ({"orchidee","orchideen"}), 
            "Zwischen den Lilien wachsen auch einige Orchideen.");
 
  AddDetail( ({"nordosten"}), 
            "Im Nordosten befindet sich die Burg. Die Fahnen an den Tuermen "
	    "flattern wild im Wind.");
 
  AddDetail( ({"fahne"}),
	     "Jede Fahne ist hellblau und hat eine goldene Umrandung. "
	     "In der Mitte befindet sich ein goldenes Wappen");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");
	 
  AddDetail( ({"gaerten","westen"}), 
            "Die bluehenden Gaerten von Edynia befinden sich im Westen.");

  AddDetail( ({"voegel"}), 
            "Einige bunte Voegel tummeln sich durch den Blumenhain.");

   
  AddDetail( ({"vogelgezwitscher","wind","sinn"}), 
            "Dir steht der Sinn nach lauschen.");
  

  AddDetail( ({"nordosten"}), 
            "Nach Nordosten fuehrt der Weg zwischen den Blumenwiesen durch.");

  AddDetail( ({"wind"}),
	    "Den kannst Du nicht untersuchen.");

  AddDetail( ({"purpurlinde","linde"}),
	    "Eine praechtige Linde steht direkt neben Dir. Ihre praechtigen "
	    "Aeste ueberragen Dich fast voellig.");

  AddDetail( ({"ast","aeste","aesten"}),
	    "Die Aeste sind sehr praechtig und purpurn. Daraus koennte man "
	    "sicher was Schoenes bauen.");

  AddDetail( ({"schoenes","speer","speere"}),
	    "Die Amazonen basteln mit diesen Aesten gern ihre Speere.");

  AddDetail( ({"amazone","amazonen"}),
	    "Hier kommen oft Amazonen vorbei.");

  AddDetail( ({"tuerme","tuermen"}),
	    "Die Tuerme ragen majaestetisch in den Himmel empor.");

  AddDetail( ({"umrandung"}),
	    "Jede Fahne hat eine goldene Umrandung.");

  AddDetail( ({"wappen","wappens","umrisse"}),
	    "Zwei ineinander verschlungene goldene Schlangen. In der Mitte "
	    "dieser Schlangen befindet sich ein Speer.");

  AddDetail( ({"schlangen"}),
	    "Sie bilden das Wappen.");

  AddDetail( ({"speer"}),
	    "Jede richtige Amazone hat einen Speer bei sich.");
	    
  AddDetail( ({"lungen"}),
	    "Deine Lungen sind noch jung und unverbraucht.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst hier die salzige Meeresluft.");

  AddSmell( ({"luft","meeresluft"}),
	   "Die Meeresluft dringt tief in Deine Lungen.");
  
  AddSmell( ({"blumen"}),
	   "Die Blumen duften himmlisch suess.");

  AddSmell( ({"ohren"}),
	   "Deine Ohren hoeren oft viele Dinge, die sie nicht hoeren sollten.");

  AddSmell( ({"dinge"}),
	   "Na alles musst Du auch nicht wissen.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur den Wind und das Plaetschern der "
		 "Wellen.");
	   

  AddSound( ({"wind"}),
	   "Der Wind pfeift Dir um die Ohren.");

  AddSound( ({"plaetschern","wellen"}),
	   "Die Wellen prallen an die Klippen.");	  
  

//-----Details Ende-----
  
  AddExit("nordosten", ROOM "amazon12.lpc");
  AddExit("westen", ROOM "amazon10.lpc");
  AddCmd( ({ "brich", "breche" }), "c_abbrechen");

   grundzustand();
}
  reset()
{
   ::reset();
   grundzustand();
}
   void grundzustand()
{
   ast_da = 1;
}
   int c_abbrechen(string str)
{
  
   notify_fail(BS("Was moechtest Du hier wo abbrechen?"));
   if(!(str == "ast von linde ab") ||
       (str == "ast von purpurlinde ab"))
{
     return 0;
}  
   if(present("ast", ENV(TP)) || (ast_da==0))
{
     write(BS("Du willst einen schoenen Ast abbrechen, aber die Purpurlinde "
	      "laesst sich nicht verletzen."));
     return 1;
 }
    else
 {
      write(BS("Als Du einen Ast abbrechen willst, bewegt sich die Linde "
	       "und schenkt Dir freiwillig einen ganz Praechtigen."));
      tell_room(ENV(TP), TPN+" macht irgendwas.\n", ({TP}));
      ast_da = 0;
      CLONE ( "/gilden/amazonen/questobj/ast.lpc", TP);
      return -1;
 }
 }
      string _query_int_long()
{ 
  string s;

  s=::_query_int_long();
 

  if(TP && interactive(TP) && IS_WIZARD(TP))
{ 
    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_BOLD+ANSI_CYAN;

    switch(ast_da)
 { 
      case 0:
        break;

      case 1:
        s += "Es gibt 1 Ast hier.";
        break;

      default:
        s += sprintf("Es gibt %d Ast hier.",ast_da);
        break;
 }

    s += "\n";

    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_NORMAL;
  }
  
  return s;
}
 
