inherit "std/room";
#include "../def.h"
#include <ansi.h>

void grundzustand();
int orchidee_da;
int lilie_da;


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf der Spitze der Klippen");
  SetProp( P_INT_LONG,
	"Du stehst hier auf der Spitze der Klippen. Von hier aus hast "
       	"Du eine wunderschoene Aussicht ueber den Ozean. Ausserdem hast Du "
	"hier auch einen guten Einblick ins Landesinnere. Weiteres siehst Du "
	"Blumenwiesen soweit das Auge reicht. Ein schmaler Weg schlaengelt "
	"sich durch die Wiesen und scheint genau zu einer Burg zu fuehren, die "
	"sich in weiter Ferne auf einer grossen Klippe befindet. Du kannst den "
	"Weg nach Nordosten folgen oder zurueck zum Strand nach Suedwestunten "
	"gehen.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "spitze", QueryProp(P_INT_LONG) );

  AddDetail( ({"klippen"}), 
            "Du stehst gerade auf der Spitze der Klippen.");

  AddDetail( ({"weg"}), 
            "Der Weg schlaengelt sich durch die vielen Blumenwiesen und "
	    "fuehrt genau auf eine grosse Burg zu.");

  AddDetail( ({"wiese","wiesen","blumenwiesen"}), 
            "Wunderschoene Blumenwiesen befinden sich vor Dir und reichen "
	    "so weit das Auge reicht.");
 
  AddDetail( ({"blumen"}), 
            "Viele wilde Rosen, Orchideen, Lilien und Tulpen wachsen hier. "
	    "Ausserdem erkennst Du vereinzelt noch genuegend Dir unbekannte "
	    "Blumen.");
 
  AddDetail( ({"rosen","rose"}), 
            "Es gibt hier Rosen in allen moeglichen Farben und Groessen. "
	    "Sie gedeihen hier praechtig auf dem erdigen Boden.");

  AddDetail( ({"farben","farbe"}), 
            "Rote, weisse, blaue, lachsfarbene, gelbe und rosa Rosen wachsen "
	    "hier. Auch einige violette Rosen kannst Du vereinzelt erkennen.");

  AddDetail( ({"rote","weisse","lachsfarbene","gelbe","rosa","violette"}), 
            "Die Rosen sind einfach himmlisch.");

  AddDetail( ({"groessen"}), 
            "Die Blumen hier haben alle moeglichen Farben und Groessen.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist erdig und einige kleine Steine liegen hier herum.");
  
  AddDetail( ({"steine"}), 
            "Ganz normale kleine Steine.");

  AddDetail( ({"orchideen","orchidee"}), 
            "Unzaehlige weisse Orchideen wachsen hier. Es waere sicherlich "
	    "schoen so eine Orchidee zu pfluecken.");
 
  AddDetail( ({"schlucht"}), 
            "Die Schlucht befindet sich unter Dir.");
  
  AddDetail( ({"lilie","lilien"}), 
            "Viele weisse Lilien wuchern hier wie wild. Es wuerde gewiss "
	    "nicht auffallen wenn Du eine davon abbrechen wuerdest.");

  AddDetail( ({"tulpen","rot","die"}), 
            "Die Tulpen wachsen hier in einem knalligen Rot.");
 
  AddDetail( ({"auge","horizont"}), 
            "Die Blumenwiesen reichen bis zum Horizont.");
 
  AddDetail( ({"einblick","landesinnere"}),
	     "Von hier aus hast Du einen sehr guten Einblick ins Landesinnere.");	  

  AddDetail( ({"ausblick","ozean","meer","aussicht"}),
	    "Der Ausblick ueber den Ozean ist ueberwaeltigend. Klar und ruhig "
	    "liegt das Meer vor Dir und hat eine wunderschoene tuerkise Farbe.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");
	 
  AddDetail( ({"strand","suedwestunten"}),
	    "Nach Suedwestunten gelangst Du wieder zum Strand zurueck.");
         

  AddDetail( ({"nordosten"}), 
            "Nach Nordosten fuehrt der Weg zwischen den Blumenwiesen durch.");

  AddDetail( ({"ferne","klippe","ende"}),
	    "In der Ferne kannst Du eine grosse Burg erkennen, die am Ende "
	    "einer Klippe majaestetisch in den Himmel ragt.");

  AddDetail( ({"burg"}),
	    "Die Burg ist wunderschoen weiss und hat viele Tuerme. Ausserdem "
	    "erkennst Du an jedem der Tuerme eine hellblaue Fahne.");

  AddDetail( ({"tuerme","turm"}),
	    "Die Tuerme ragen majaestetisch in den Himmel empor.");

  AddDetail( ({"fahne"}),
	    "An jedem Turm befindet sich eine hellblaue Fahne.");
 
  
  AddSmell(DEFAULT_SMELL, "Die Luft hier ist sehr erfrischend und klar.");

  AddSmell( ({"luft"}),
	   "Du atmest einmal ganz tief durch. Oh wie das guttut.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur den Wind, der durch die Schlucht "
		  "heult.");
	   

  AddSound( ({"wind"}),
	   "Der Wind heult durch die Schlucht und irgendwie klingt es sehr "
	   "sehr unheimlich.");

           
  

//-----Details Ende-----
  
  AddExit("nordosten", ROOM "amazon8.lpc");
  AddExit("suedostunten", ROOM "amazon5.lpc");
 
//----KOMMANDOS---------

 AddCmd( ({ "brich", "breche" }), "c_abbrechen");
 AddCmd( ({ "pfluecke", "pflueck" }), "c_pfluecken");
 
 grundzustand();
}

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	orchidee_da = 1;
	lilie_da = 1;
}


int c_pfluecken(string str)
{
   notify_fail(BS("Was moechtest Du hier denn pfluecken?"));
   if(!(str == "orchidee"))
   {
     return 0;
   }
   if(present("orchidee", ENV(TP)) || (!orchidee_da))
   {
     write(BS("Du willst eine der Orchideen pfluecken aber ueberlegst es Dir "
	      "doch anders. Schliesslich moechtest Du ja nicht in die Natur "
	      "eingreifen."));

     return 1;
    }
    else
    {
      write(BS("Du pflueckst eine wunderschoene Orchidee und freust Dich."));
      tell_room(ENV(TP), TPN+" pflueckt eine schoene Blume.\n", ({TP}));
      orchidee_da = 0;
      CLONE(OBJ "orchidee.lpc", TP);
      return 1;
     }
   }
    
    int c_abbrechen(string str)
{
   notify_fail(BS("Was moechtest Du hier denn abbrechen?"));
   if(!(str == "lilie ab"))
   {
     return 0;
   }
   if(present("lilie", ENV(TP)) || (!lilie_da))
   {
     write(BS("Du willst eine der Lilien pfluecken aber ueberlegst es Dir "
	      "doch anders. Schliesslich moechtest Du ja nicht in die Natur "
	      "eingreifen."));

     return 1;
    }
    else
    {
      write(BS("Du brichst eine wunderschoene Lilie ab und freust Dich."));
      tell_room(ENV(TP), TPN+" pflueckt eine schoene Blume.\n", ({TP}));
      lilie_da = 0;
      CLONE(OBJ "lilie.lpc", TP);
      return 1;
     }
    }

    string _query_int_long()
{ 
  string s;

  s=::_query_int_long();

  if(TP && interactive(TP) && IS_WIZARD(TP))
  { 
    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_BOLD+ANSI_CYAN;
    
    { 
     
    if (orchidee_da)
      s += "Es gibt 1 Orchidee hier.\n";
    
    if (lilie_da)  
      s += "Es gibt 1 Lilie hier.";
      
      
    }

    s += "\n";

    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_NORMAL;
  }
  
  return s;

}
 
