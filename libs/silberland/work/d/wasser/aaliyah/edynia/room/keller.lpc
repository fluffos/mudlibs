// Keller unter der Amazonenburg

inherit "std/room";
#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Keller der Amazonenburg");
  SetProp(P_INT_LONG,
	"Im Keller der Amazonenburg.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  
//-----Details Anfang-----

  
//-----Details Ende-----
  
  AddExit("sueden", "gang_s1");
  AddExit("norden", "gang_n1");
  AddExit("osten", "gang_o1");
  AddExit("westen", "gang_w1");
}  
   
