// Eingangsbereich der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Eingangsbereich der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier im Eingangsbereich der Burg. Es ist die "
	"direkte Verbindung zwischen dem Tor und dem Burghof. Hier herrscht "
	"ein reges Treiben. Viele Haendler stehen hier mit ihren Karren und "
	"werden von den Waechterinnen ueberprueft. Auch einige Reisende "
	"kannst Du hier erkennen. Auf den Waenden neben Dir, befinden "
	"sich einige Bilder und das Wappen der Amazonen. Im Osten gelangst "
	"Du direkt auf den Burghof und im Westen kommst Du wieder zum Tor "
	"zurueck.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//--------------Detail Anfang---------------------------------

  
 AddDetail( ({"eingangsbereich","bereich","verbindung"}), QueryProp(P_INT_LONG) );

    
  AddDetail( ({"boden","steinbloecken","steinen","bloecken"}), 
            "Der Boden besteht aus vielen Steinbloecken.");

  AddDetail( ({"himmel"}), 
            "Den Himmel siehst Du hier nicht.");

  AddDetail( ({"decke","stein"}), 
            "Die Decke besteht aus weissem Stein.");

  AddDetail( ({"tor","westen"}), 
            "Nach Westen gelangst Du wieder zum Tor zurueck.");

  AddDetail( ({"schluesselloch"}), 
            "Du guckst durchs Schluesselloch und siehst eine Treppe die nach unten "
	    "fuehrt.");

  AddDetail( ({"schluessel"}), 
            "Mit dem passenden Schluessel kannst Du die Tuer sicher aufsperren.");

  AddDetail( ({"treppe"}), 
            "Mehr erkennst Du nicht. Sehr finster dort.");

  AddDetail( ({"osten","hof","burghof"}), 
            "Im Osten von Dir befindet sich der Burghof.");
  
  AddDetail( ({"treiben"}), 
            "Hier herrscht ein reges Treiben.");
  
  AddDetail( ({"haendler","waechterinnen","karren","haendlern","verhandelns"}),             "Die Waechterinnen kontrollieren die Gueter in den Karren "
	    "der Haendler.");

  AddDetail( ({"gueter"}), 
            "Die Haendler beliefern die Burg mit exotischen Dingen.");

  AddDetail( ({"burg"}), 
            "Du stehst mittendrin.");

  AddDetail( ({"dinge","dingen"}), 
            "Orientalische Teppiche, exotisches Obst, jede Menge Fleisch "
	    "und auch huebschen Schmuck fuer die Amazonen. Ausserdem edle "
	    "Stoffe und Naehseide.");

  AddDetail( ({"teppiche","quaul","wuestendorf","dorf"}), 
            "Die Teppiche stammen aus Quaul, dem Wuestendorf.");

  AddDetail( ({"obst","tijara","plantagen"}), 
            "Das Obst stammt von den Plantagen aus Tijara.");

  AddDetail( ({"schmuck","derlim"}), 
            "Der schoene goldene Schmuck stammt aus Derlim.");

  AddDetail( ({"stoffe","naehseide","dschungelelfendorf"}), 
            "Die edlen Stoffe und die Naehseide stammen aus dem "
	    "Dschungelelfendorf.");

  AddDetail( ({"fleisch","schweinefleisch","huehnerfleisch","rentierfleisch"}), 
            "Schweinefleisch, Rindfleisch, Huehnerfleisch, Rentierfleisch und "
	    "auch einige Fische befinden sich im Karren.");

  AddDetail( ({"fische","fischerdorf","aus"}), 
            "Die Fische stammen, man errate: Aus dem Fischerdorf!");

  AddDetail( ({"reisende","leute","ihr","reisender"}), 
            "Viele Leute sind hierher gereist, um Audienz bei der Koenigin "
	    "zu erhalten.");

  AddDetail( ({"audienz","koenigin"}), 
            "Die Koenigin gewaehrt nur Audienz, wenn man ihr wohlgesinnt ist.");

  AddDetail( ({"amazonen"}), 
            "In dieser Burg leben viele Amazonen.");

  AddDetail( ({"wappen"}), 
            "Auch das Wappen der Burg haengt hier.");

  AddDetail( ({"wand","waende","waenden"}), 
            "Auf den Waenden befinden sich einige Bilder und das Wappen der "
	    "Amazonen.");

  AddDetail( ({"bilder","bildern"}), 
            "Auf den Bildern sind die Ahnen der Amazonen verewigt.");

  AddDetail( ({"ahnen","vorfahren"}), 
            "Auch Vorfahren genannt.");

  AddDetail( ({"duft","kraeuter","aroma"}), 
            "Die Kraeuter in dem Karren duften.");

  AddDetail( ({"ware","ordnung","waren","waechterin"}), 
            "Die meisten Waren sind in Ordnung.");

   AddDetail( ({"menge","rindfleisch"}), 
            "In den Karren befindet sich auch jede Menge frisches Rindfleisch.");




 
  AddSmell(DEFAULT_SMELL, "Du riechst hier den Duft exotischer Kraeuter, die "
		  "sich in einem der Karren befinden.");

  AddSmell( ({"kraeuter","duft","aroma"}),
	   "Die Kraeuter verstroemen ein wuerziges Aroma.");

      
  AddSound(DEFAULT_SOUND, "Einige Haendler verhandeln hier mit den Amazonen.");
	   

  AddSound( ({"amazonen","verhandeln"}),
	  "Die Waechterinnen pruefen alles ganz genau.");
  
  AddSound( ({"haendler"}),
	  "Den Haendlern merkt man an, das sie des Verhandelns ueberdruessig "
	  "werden.");

  AddRoomMessage( ({"Eine Waechterin durchsucht einen Karren.\n",
	          "Ein Haendler seufzt.\n",
		  "'Diese Ware ist in Ordnung, Ihr koennt passieren!'\n",
		  "Ein Reisender stupst Dich unabsichtlich.\n",
		  "Der Karren aechzt.\n",
		  "Ein Haendler zieht seinen Karren an Dir vorbei.\n",
		  "Ein Reisender sinkt muede auf den Boden.\n",
		  "Ein Reisender hastet eilig an Dir vorbei.\n"}), 80);

  AddItem(NPC "amazone_wache", REFRESH_DESTRUCT);

//---------------Details Ende-----------------------

   

  AddExit( "osten", "./burg2");
  AddExit( "westen", "./amazon18");

  /*NewDoor( "norden", ROOM "stiege1", ({"tuer", "eisentuer"}),
      ({ D_NAME,"Eisentuer",
       D_GENDER, FEMALE,
       D_SHORT,"Im Norden siehst Du eine %se Eisentuer.",
       D_LONG, "Die Eisentuer schaut sehr stabil aus. Sie ist mannshoch "
               "und sehr breit. Dem riesigen Schluesselloch zufolge braucht "
               "man einen sehr grossen Schluessel, um diese Tuere aufsperren "
               "zu koennen.\n",
       D_FLAGS, DOOR_CLOSED|DOOR_NEEDKEY|DOOR_RESET_CL,
       D_RESET_CLOSEMSG, " wird von einer Dienerin versperrt.",
       }) );*/
}  
   
