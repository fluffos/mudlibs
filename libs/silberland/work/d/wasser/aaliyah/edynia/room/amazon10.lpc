#include "../def.h"
#include <ansi.h>
inherit "std/room";

int grundzustand();
int samen_da;

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Am Ende der Gaerten von Edynia");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier am Ende der Gaerten von Edynia. Der Pfad ist "
       	"nicht mehr so verwildert und Du erkennst am Boden viele Fussspuren. "
	"Die Fahnen flattern wild im Wind und du kannst auch schon das goldene "
	"Wappen sehr gut erkennen. Auch die Blumen scheinen hier etwas weniger "
	"zu werden. Vor Dir kannst Du eine grosse Klippe erkennen, auf deren "
	"Ende sich die Burg befindet.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "gaerten", QueryProp(P_INT_LONG) );

  AddDetail( ({"blumen"}), 
            "Die Blumen wachsen hier nicht mehr so wild wie in der Mitte der "
	    "Gaerten. Trotzdem sind sie noch immer sehr schoen anzusehen");

  AddDetail( ({"fussspuren"}), 
            "Viele Fussspuren befinden sich am Boden. Anscheinend ist dieser "
	    "Teil der Gaerten sehr gut besucht.");
 
  AddDetail( ({"silberland"}), 
            "Du bist mittendrin statt nur dabei.");

  AddDetail( ({"teil"}), 
            "Dieser Teil der Gaerten ist sehr gut besucht.");

  AddDetail( ({"brise","koerper","leben"}), 
            "Die Brise tut Deinem Koerper gut.");
  
  AddDetail( ({"ausruestung"}), 
            "Bist Du gut ausgeruestet?");

  AddDetail( ({"pfad"}), 
            "Der Pfad ist nicht mehr so verwildert wie inmitten der Gaerten.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist erdig und Du erkennst viele Fussspuren.");
  
  AddDetail( ({"ende"}), 
            "Tipp mal Ende, dann siehst Du was passiert.");

  AddDetail( ({"blumenhain","hain"}), 
            "Sind die Blumen nicht wundervoll?");

  AddDetail( ({"mitte","sueden"}), 
            "Die Mitte der Gaerten befindet sich im Sueden.");
 
  AddDetail( ({"blumen"}), 
            "Viele wilde Rosen, Orchideen, Lilien und Tulpen wachsen hier. "
	    "Ausserdem erkennst Du vereinzelt noch genuegend Dir unbekannte "
	    "Blumen. Pfluecken solltest Du hier allerdings keine wenn Du "
	    "nicht den Groll der Amazonen auf Dich ziehen moechtest.");
  
  AddDetail( ({"groll"}), 
            "Wenn die Amazonen boese werden kann das tragisch enden.");

  AddDetail( ({"amazonen","frauen","amazone"}), 
            "Wunderschoene kraeftige Frauen, die mit der Macht der Goetter "
	    "kaempfen und furchtlos durch das Leben schreiten.");

  AddDetail( ({"macht","goetter","woody","macht"}), 
            "Woody hat im Silberland die Macht. Er kann mit einem simplen "
	    "Knopfdruck viele Wesen zum Weinen bringen.");

  AddDetail( ({"knopfdruck","reboot"}), 
            "Dieser Knopfdruck heisst Reboot.");

  AddDetail( ({"wesen","weinen"}), 
            "Gehoerst Du auch zu jenen, die ihrer Ruestung nachheulen?");

  AddDetail( ({"ruestung"}), 
            "Die meisten hier haben eh nur Glump und somit ist fuer sie ein "
	    "Reboot nicht so schlimm.");

  AddDetail( ({"glump","sprachform"}), 
            "Glump wird in der normalen Sprachform auch Schrott genannt.");

  AddDetail( ({"schrott","menge"}), 
            "Tipp mal Ausruestung, dann siehst Du jede Menge Schrott.");

 
  AddDetail( ({"rosen","rose"}), 
            "Es gibt hier Rosen in allen moeglichen Farben und Groessen. "
	    "Sie gedeihen hier praechtig auf dem erdigen Boden.");

  AddDetail( ({"farben"}), 
            "Rote, weisse, blaue, lachsfarbene, gelbe und rosa Rosen wachsen "
	    "hier. Auch einige violette Rosen kannst Du vereinzelt erkennen.");

  AddDetail( ({"rote","weisse","lachsfarbene","gelbe","rosa","violette"}), 
            "Die Rosen sind einfach himmlisch.");

  AddDetail( ({"groessen"}), 
            "Die Blumen hier haben alle moeglichen Farben und Groessen.");
  
  AddDetail( ({"klippe"}), 
            "Eine maechtige Klippe befindet sich Dir.");
  
  AddDetail( ({"fahnen"}), 
            "An jedem der Tuerme befindet sich eine hellblaue Fahne.");

  AddDetail( ({"orchideen","orchidee"}), 
            "Unzaehlige weisse Orchideen wachsen hier und verspruehen ihre "
	    "duftenden Bluetenpollen.");

  AddDetail( ({"bluetenpollen","pollen"}), 
            "Es flirren soviele Bluetenpollen herum, dass man sie fast "
	    "einsammeln koennte. Also wenn Du magst, sammle halt ein paar "
	    "von den Samen hier ein.");
    
  AddDetail( ({"lilie","lilien"}), 
            "Viele weisse Lilien wuchern hier wie wild.");
  
  AddDetail( ({"samen"}), 
            "Man kann die Samen einsammeln.");
  
  AddDetail( ({"tulpen","rot"}), 
            "Die Tulpen wachsen hier in einem knalligen Rot.");
 
  AddDetail( ({"auge","horizont"}), 
            "Die Blumenwiesen reichen bis zum Horizont.");
 
  AddDetail( ({"fahne"}),
	     "Jede Fahne ist hellblau und hat eine goldene Umrandung. "
	     "In der Mitte befindet sich ein goldenes Wappen");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");
	 
  AddDetail( ({"horizont"}),
	    "Einige gute Buecher wuerden Deinen Horizont imens erweitern.");

  AddDetail( ({"buecher"}), 
            "Einige Buecher liegen sicher verstaubt bei Dir herum.");

  AddDetail( ({"voegel"}), 
            "Einige bunte Voegel tummeln sich durch den Blumenhain.");

   
  AddDetail( ({"vogelgezwitscher","wind","sinn"}), 
            "Dir steht der Sinn nach lauschen.");
  

  AddDetail( ({"nordosten"}), 
            "Nach Nordosten fuehrt der Weg zwischen den Blumenwiesen durch.");

  AddDetail( ({"amazoneninsel"}),
	    "Hier leben lauter Amazonen.");

  AddDetail( ({"burg"}),
	    "Die Burg ist nun nicht mehr so weit von Dir entfernt.");

  AddDetail( ({"tuerme"}),
	    "Die Tuerme ragen majaestetisch in den Himmel empor.");

  AddDetail( ({"umrandung"}),
	    "Jede Fahne hat eine goldene Umrandung.");

  AddDetail( ({"wappen","wappens","umrisse"}),
	    "Zwei ineinander verschlungene goldene Schlangen. In der Mitte "
	    "dieser Schlangen befindet sich ein Speer.");

  AddDetail( ({"schlangen"}),
	    "Sie bilden das Wappen.");

  AddDetail( ({"speer"}),
	    "Jede richtige Amazone hat auch einen Speer.");


   AddRoomMessage( ({"Eine warme Brise umschmeichelt Deinen Koerper.\n",
	          "Du fuehlst Dich hier sehr wohl.\n",
	          "Du riechst den wundervollen Bluetenduft.\n"}), 2);
  
 
 
  
  AddSmell(DEFAULT_SMELL, "Die reine Luft duftet herrlich nach diversen "
		  "Blumen..");

  AddSmell( ({"luft"}),
	   "Du atmest einmal ganz tief durch. Oh wie das guttut.");
  
  AddSmell( ({"blumen","bluetenduft","duft"}),
	   "Die Blumen duften himmlisch suess.");
    
  AddSound(DEFAULT_SOUND, "Du hoerst hier leisen Wind, der ueber die Blumen "
		 "streicht und etwas Vogelgezwitscher.");
	   

  AddSound( ({"wind"}),
	   "Der Wind pfeift singend ueber den Blumenhain.");

  AddSound( ({"vogelgezwitscher","voegel","zwitschern","zirpen"}),
	   "Die Voegel zirpen und zwitschern froehlich vor sich hin.");	  
  

//-----Details Ende-----
  
  AddExit("osten", ROOM "amazon11.lpc");
  AddExit("sueden", ROOM "amazon9.lpc");
  AddCmd( ({ "sammel", "sammle" }), "c_einsammeln");

   grundzustand();
}
  reset()
{
   ::reset();
   grundzustand();
}
   void grundzustand()
{
   samen_da = 1;
}
   int c_einsammeln(string str)
{
  
   notify_fail(BS("Was moechtest Du einsammeln?"));
   if(!(str == "samen ein") ||
       (str == "pollen ein")||
       (str == "bluetenpollen ein"))
{
     return 0;
}  
   if(present("samen", ENV(TP)) || (samen_da==0))
{
     write(BS("Du willst einige Bluetenpollen einsammeln aber machst Dir nur "
	      "die Finger schmutzig."));
     return 1;
 }
    else
 {
      write(BS("Du sammelst ein paar Bluetenpollen."));
      tell_room(ENV(TP), TPN+" macht irgendwas.\n", ({TP}));
      samen_da = 0;
      CLONE ( "/gilden/amazonen/questobj/samen.lpc", TP);
      return -1;
 }
 }
      string _query_int_long()
{ 
  string s;

  s=::_query_int_long();
 

  if(TP && interactive(TP) && IS_WIZARD(TP))
{ 
    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_BOLD+ANSI_CYAN;

    switch(samen_da)
 { 
      case 0:
        break;

      case 1:
        s += "Es gibt 1 Orchideensamen hier.";
        break;

      default:
        s += sprintf("Es gibt %d Orchideensamen hier.",samen_da);
        break;
 }

    s += "\n";

    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_NORMAL;
  }
  
  return s;
}
 

 
