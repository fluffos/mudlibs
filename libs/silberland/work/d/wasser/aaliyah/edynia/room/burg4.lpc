// Burgmauer der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Hof der Amazonenburg");
  SetProp( P_INT_LONG,
     	"Du befindest Dich hier im Suedwesteck des Burghofes. Hier befinden "
	"sich einige Zielscheiben und ein paar Speerkoecher. Der Boden ist "
	"uebersaeht mit abgebrochenen Speerspitzen. Weiters fallen Dir noch "
	"ein paar Rundschilder auf, die achtlos auf den Boden geworfen wurden. "
	"Ein paar Amazonen ueben hier gerade den Speerwurf, und Du musst sehr "
	"sehr aufpassen, nicht ihre Zielscheibe zu werden. Eine Marmortreppe "
	"fuehrt hier nach Suedwestoben auf die Burgmauer hinauf.");
    
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//------------------Details Anfang---------------------------------

AddDetail( ({"hof","burghof","suedwesteck","burghofes","hofes"}),
	       	QueryProp(P_INT_LONG) );

  AddDetail( ({"boden","gras"}), 
            "Der Boden ist uebersaeht mit abgebrochenen Speerspitzen. Auch "
	    "einige Rundschilder liegen hier im Gras.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist strahlend blau.");
  
  AddDetail( ({"speerspitzen","spitzen"}), 
            "Viele abgebrochene Speerspitzen liegen hier herum.");

  AddDetail( ({"rundschilder","schilder"}), 
            "Die Rundschilder wurden hier von den Amazonen abgelegt, um "
	    "besser den Speerwurf ueben zu koennen.");

  AddDetail( ({"zielscheiben","scheiben"}), 
            "Die Zielscheiben werden benoetigt um den Speerwurf zu ueben.");

  AddDetail( ({"zielscheibe","scheibe"}), 
            "Du bist die Zielscheibe, wenn Du nicht ganz genau aufpasst.");

  AddDetail( ({"speerkoecher","koecher","speerkoechern"}), 
            "Die Speerkoecher bestehen aus Marmor. Sie wurden hier fix "
	    "aufgestellt, um den Amazonen jederzeit einen Aufbewahrungsort "
	    "fuer ihre Speere zu bieten.");

  AddDetail( ({"aufbewahrungsort","ort","marmor"}), 
            "Damit das ganze Zeug nicht am Boden herumliegt, wurden die "
	    "Speerkoecher aufgestellt.");

  AddDetail( ({"speere","zeug","speer"}), 
            "Die Speere sind bestens in den Speerkoechern aufgehoben.");

  AddDetail( ({"speerwurf"}), 
            "Der Speerwurf ist sehr wichtig fuer die Amazonen. Deshalb ist es "
	    "auch von grosser Prioritaet, ihn staendig zu ueben.");

  AddDetail( ({"prioritaeten","prioritaet"}), 
            "Viele Menschen setzen ihre Prioritaeten falsch.");

  AddDetail( ({"menschen","wesen"}), 
            "Nicht nur Menschen, sondern auch andere Wesen.");

  AddDetail( ({"suedwestoben","burgmauer","mauer","treppe","marmortreppe"}), 
            "Ueber eine Marmortreppe gelangst Du nach Suedwestoben auf die "
	    "Burgmauer.");

  AddDetail( ({"amazonen","amazone"}), 
            "Die Amazonen ueben hier fleissig den Speerwurf.");

  AddDetail( ({"rosen","rosenbuesche","duft","buesche"}), 
            "Erst jetzt entdeckst Du die vielen Rosenbuesche, die hier rund "
	    "um Dich wuchern.");

  AddDetail( ({"dienerin"}), 
            "Die Dienerin reicht der Amazone einen Speer.");



 
  AddSmell(DEFAULT_SMELL, "Du riechst hier den sanften Duft vieler Rosen.");

  AddSmell( ({"rosen","duft"}),
	   "Die vielen Rosen duften herrlich.");

     
  AddSound(DEFAULT_SOUND, "Die Amazonen plappern vergnuegt. Ab und zu hoerst "
		  "Du sie laut lachen.");
	   

  AddSound( ({"amazonen","plappern"}),
	  "Die Amazonen plappern vergnuegt vor sich hin.");
  
  AddSound( ({"lachen"}),
	  "Die Amazonen lachen lauthals.");

  AddRoomMessage( ({"Eine Amazone nimmt einen Speer aus dem Koecher.\n",
	          "Eine Amazone schmettert ihren Speer auf die Zielscheibe.\n",
		  "'Verdammt! Schon wieder daneben!'.'\n",
		  "Eine Dienerin reicht der Amazone einen Speer.\n",
		  "Ein Speer schiesst an Dir vorbei.\n",
		  "'Hey Du! Pass bitte auf!'.\n"}), 80);

//----------Details Ende----------------------------
 
  AddExit( "norden", "./burg2");
  AddExit( "nordosten", "./brunnen");
  AddExit( "osten", "./burg6");
  AddExit( "suedwestoben", "./mauer15");
}  
   
