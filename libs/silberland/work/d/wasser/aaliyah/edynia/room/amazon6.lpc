#include "../def.h"
#include <ansi.h>
inherit "std/room";


void grundzustand();
int fleischklumpen_da;
int band_da;
void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Kurz vorm Absturz");
  SetProp( P_INT_LONG,
	"Du haelst Dich verzweifelt an einem Baum fest um nicht abzustuerzen.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"baum"}), 
            "Der Baum waechst aus der Felswand heraus und wird Dich nicht mehr lange halten koennen. Irgendetwas "
	    "faellt Dir bei dem Baum auf.");

  AddDetail( ({"irgendetwas"}), 
            "Es hat den Anschein als waere ein Seil um den Baumstamm gewickelt.");

  AddDetail( ({"baumstamm","stamm"}), 
            "Ein altes, morsches Seil ist um den Stamm gebunden. Ob es Dir "
	    "helfen kann ist allerdings fraglich.");

  AddDetail( ({"anschein"}),
	     "Versuch doch etwas mit dem Seil.");

  AddDetail( ({"seil"}),
	     "Mit dem Seil kann man sich gewiss abseilen. Trotzdem hat die "
	     "Sache einen Haken.");

  AddDetail( ({"sache","haken"}), 
            "So einfach nehmen laesst sich das Seil nicht. Da musst Du Dir schon "
	    "was anderes einfallen lassen.");

  AddDetail( ({"abgrund","absturz"}), 
            "Der Abgrund ist so dermassen tief, das Du Dir sicher bist, einen "
	    "Absturz nicht zu ueberleben.");

  AddDetail( ({"boden"}), 
            "Der Boden ist sehr weit unter Dir.");
 
  AddDetail( ({"himmel"}), 
            "Du erkennst einige Wolken am Himmel.");
 
  AddDetail( ({"zeit"}), 
            "Deine Zeit ist bald abgelaufen wenn Dir nicht bald was einfaellt.");

  AddDetail( ({"koepfchen"}), 
            "Du strengst Dein Koepfchen an und Dir kommt ein Geistesblitz.");

  AddDetail( ({"du","dich","dein"}), 
            "Du solltest einmal Dein Koepfchen anstrengen.");

  AddDetail( ({"geistesblitz"}), 
            "Der Geistesblitz sagt Dir, das Du mit dem Seil was machen kannst. "
	    "Du siehst die Loesung schon vor Dir.");
  
  AddDetail( ({"loesung"}), 
            "Untersuch einfach die Umgebung genauer!");
  
  AddDetail( ({"umgebung"}), 
            "Ganz so einfach ist das auch wieder nicht!");

  AddDetail( ({"wolken"}), 
            "Der Himmel ist bis auf eine Wolke vollkommen klar.");

  AddDetail( ({"schlucht"}),
	    "Sieh besser zu das Du Dich aus dieser Misere rettest!");

  AddDetail( ({"misere"}),
	    "In einer Misere befindest Du Dich gerade. Ein Seil wuerde Dir "
	    "gewiss helfen.");
 
  AddDetail( ({"aeste"}),
	    "Die Aeste sind knorrig und duenn. An einem Ast erkennst Du ein "
	    "seltsames Funkeln.");
  
  AddDetail( ({"ast"}),
	     "Der Ast sieht aus wie ein Finger. Ein Lederband ist um den Ast "
	     "gewickelt.");

  AddDetail( ({"finger"}),
	     "Der Finger deutet auf Deinen Mund.");

  AddDetail( ({"mund"}),
	     "Wie koenntest Du das Seil vom Stamm bekommen hm?");

  AddDetail( ({"funkeln"}),
	     "Koennte das Funkeln ein Kletterhaken sein?");


  AddDetail( ({"kletterhaken"}),
	     "Das Funkeln ist zu weit entfernt, als das Du erkennen koenntest, "
	     "was es genau ist. Du muesstest das Aestchen irgendwie naeher "
	     "heran bekommen.");

  AddDetail( ({"aestchen"}),
	     "Eine Schnur waere des Raetsels Loesung.");

  AddDetail( ({"schnur"}),
	     "Beim genaueren Hinsehen erkennst Du eine Schnur, die an einem "
	     "der anderen Aeste baumelt.");
  
  AddDetail( ({"hinsehen"}),
	     "Du muesstest irgendwie die Schnur vom Ast bekommen.");

  AddDetail( ({"raetsel","raetsels","abseilen","idee"}),
	     "Ein Seil mit Kletterhaken zum Abseilen waere doch eine Idee.");

  
  AddDetail( ({"wolke","form"}), 
            "Die Wolke hat die Form eines Drachen.");

  
  AddDetail( ({"drache","drachen"}), 
            "Tatsaechlich! Ueber Dir fliegt ein Drache.");
 
  AddDetail( ({"felswand","felswaende","waende","wand"}), 
            "Die Felswaende sind mit Furchen und Rissen uebersaeaet.");

  AddDetail( ({"furche","riss", "furchen", "risse"}),
	     "An den Furchen ist nichts Besonderes. Eine Ritze faellt dir auf.");

  AddDetail( ({"ritze"}),
	     "Neben der Ritze siehst Du eine Spalte.");

  AddDetail( ({"spalte"}),
	     "Du kannst nichts in der Spalte erkennen. Vielleicht ist ja was darin versteckt?");

  AddDetail( ({"kraefte"}),
	     "Waerst Du stark genug, koenntest Du Dich hier mit einem Seil "
	     "vielleicht befreihen.");

  AddDetail( ({"absturz","abenteurer","koerpers","matsch"}),
	     "Der naechste Abenteurer, der hier her kommt, kann den Matsch "
	     "Deines Koerpers im Abgrund sehen.");

 
 AddRoomMessage( ({"Der Baum macht ein knarrendes Geraeusch.\n",
	          "Du kannst Dich nicht mehr lange halten.\n",
		  "Deine Kraefte werden immer schwaecher.\n",
		  "Bald wirst Du im Abgrund zerschellen.\n"}), 3);
  
  
  
  AddSmell(DEFAULT_SMELL, "Du hast keine Zeit dafuer.");

     
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur den Wind, der durch die Schlucht "
		  "heult.");

  AddSound( ({"geraeusch"}),
	    "Das Geraeusch will Dir sicher etwas bestimmtes sagen.");
	   

  AddSound( ({"wind"}),
	   "Der Wind fluestert: Der Baum! Der Baum!");

//----------Details Ende------------  
  
 AddCmd( ({ "greif","greife" }), "c_hineingreifen");
 AddCmd( ({ "wickle","wickel"}), "c_abwickeln");

 
 grundzustand();
}  

void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	fleischklumpen_da = 1;
	band_da = 1;
}  


int c_hineingreifen(string str)
{
   notify_fail(BS("Wo moechtest Du denn hineingreifen?"));
   if(str == "in spalte")
   {
   
   if(present("fleischklumpen", ENV(TP)) || (!fleischklumpen_da))
   {
     write(BS("Mit Deiner letzten Kraft greifst Du in die Furche und musst "
	      "zu Deinem Leidwesen feststellen, das Du Deine Kraft umsonst "
	      "eingesetzt hast."));
	      
     return 1;
    }
    else
    {
      write(BS("Mit Deiner letzten Kraft greifst Du in die Furche und ertastest "
	       "einen Gegenstand, den Du sofort an Dich nimmst."));
      tell_room(ENV(TP), TPN+" aechzt verzweifelt.\n", ({TP}));
      fleischklumpen_da = 0;
      CLONE(OBJ "fklumpen.lpc", TP);
      return 1;
     }
    }
   
    if(str == "in ritze")
    { 
     write(BS("Du greifst in die Ritze aber findest nichts."));
    return 1;
    }
    if(str == "in furche")
    {
     write(BS("Du greifst in die Furche und findest aber leider nichts."));
     return 1;
    }
     return 0;
    }
    
  void init()
  {
  ::init();
  if (TP && interactive(TP))
    call_out("faketod", 10*60);
  }

 void faketod()
 {
  if (TP && interactive(TP) && present(TP))
  {
    SetProp(P_KILL_NAME, "Ein Sturz in den Abgrund");
    TP->SetProp(P_GHOST, 1);
    TP->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW);
    WLOG(LOG "faketod", "faellt in den Abgrund");
    TP->SetProp(P_KILLER, 0);
  }
}
 int c_abwickeln(string str)
{
   notify_fail(BS("Was moechtest Du von wo abwickeln?"));
   if(!(str == "band von ast")         ||
     (str == "band von ast herunter")||
     (str == "lederband von ast")    ||
     (str == "band von ast ab")      ||
     (str == "lederband von ast ab"))
   {
   
   if(present("band", ENV(TP)) || (!band_da))
   {
     write(BS("Leider hat vor Dir schon jemand den groessten Teil vom Lederband "
	      "abgewickelt. Vom Rest ist nicht mehr genug da als dass Du es noch "
	      "gebrauchen koenntest."));
	      
     return 1;
    }
    else
    {
      write(BS("Du wickelst ein Lederband vom Ast."));
      tell_room(ENV(TP), TPN+" aechzt verzweifelt.\n", ({TP}));
      band_da = 0;
      CLONE(  "/gilden/amazonen/questobj/band.lpc", TP);
      return 1;
  }

   }

   return 0;
}   

string _query_int_long()
{ 
  string s;

  s=::_query_int_long();

  if(TP && interactive(TP) && IS_WIZARD(TP))
  { 
    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_BOLD+ANSI_CYAN;
    
    { 
     
    if (band_da)
      s += "Es gibt 1 Lederband hier.\n";
    
    if (fleischklumpen_da)  
      s += "Es gibt 1 Fleischklumpen hier.";
      
      
    }

    s += "\n";

    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_NORMAL;
  }
  
  return s;

}
 
