// Raum 16 von Edynia
//
 
inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer steilen Klippe");
  SetProp( P_INT_LONG,
	"Du stehst hier auf einem Weg in den Klippen. Er fuehrt steil nach oben "
       	"hin zur Burg. Hier ist alles sehr felsig. Am Boden erkennst Du viele "
	"Wagen und Pferdespuren. Es ist ein Zeichen dafuer das hier ein reger "
	"Betrieb sein muss. Rechts und links faellt die Klippe steil nach unten "
	"ins Meer hinein. Der Abgrund neben Dir ist so tief, das Du panische "
	"Hoehenangst bekommst und Dich etwas weiter in die Mitte begibst.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "weg", QueryProp(P_INT_LONG) );

  AddDetail( ({"zeichen","betrieb"}),
	   "Hier ist reger Betrieb.");

  AddDetail( ({"klippen","klippe"}), 
            "Die Klippen fallen steil nach unten ins Meer hinein.");

  AddDetail( ({"meer"}), 
            "Das Meer liegt sehr weit unter Dir und scheint hier aeusserst "
	    "tief zu sein. Genau sagen kannst Du es nicht. Du schliesst es "
	    "einfach aus der tiefblauen Farbe.");

  AddDetail( ({"farbe"}), 
            "Das Meer hat eine tiefblaue Farbe.");

  AddDetail( ({"burg","sicht","hoehe"}), 
            "Die Burg ist nicht mehr weit von Dir entfernt. Du hast sie bald "
	    "erreicht. Ihre Tuerme ragen schon vor Dir in die Hoehe.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist hier sehr felsig. Einige Wagen und Pferdespuren "
	    "befinden sich auf ihm.");


  AddDetail( ({"pferdespuren","wagenspuren","spuren","pferdespur","spur"
	       "wagenspur"}), 
            "Viele Wesen scheinen die Burg zu besuchen denn die Spuren deuten "
	    "auf einen regen Betrieb hin.");
 
  
  AddDetail( ({"rechts","links"}), 
            "Rechts und links befindet sich der steile Abgrund.");

  AddDetail( ({"abgrund"}), 
            "Der Abgrund faellt steil ins Meer.");
 
  AddDetail( ({"wagen","aahhh"}),
	     "Aahhh! Jetzt erspaehst Du ganz weit entfernt einen Wagen.");

  AddDetail( ({"betrieb"}), 
            "Die Amazonen werden von vielen Wesen besucht.");
  
  AddDetail( ({"amazonen","edynia","insel"}), 
            "Edynia ist die Insel der Amazonen.");
  
  AddDetail( ({"wesen","rassen"}), 
            "Alle moeglichen Rassen besuchen die Amazonenburg.");

  AddDetail( ({"amazonenburg","besucher","grund"}), 
            "Hippolyte ist die Amazonenkoenigin und auch wohl der Grund fuer "
	    "die vielen Besucher hier.");

    
  AddDetail( ({"amazonenkoenigin","hippolyte"}), 
            "Die Amazonenkoenigin ist von unglaublicher Schoenheit. Sie hat "
	    "den Anmut einer Frau und die Kraft und den Mut eines Mannes.");

  
  AddDetail( ({"anmut","frau","frauen","nekromantenfrauen"}), 
            "Frauen sollten schon anmutig sein. Leider haben Nekromantenfrauen "             "das vergessen.");
 
  AddDetail( ({"kraft","mut","mann","mannes","nekromantenmaenner"}), 
            "Ein Mann sollte Kraft und Mut besitzen. Nekromantenmaenner "
	    "haben leider nichts davon. Sie verleiten leider auch andere "
	    "Wesen dazu, Angst zu haben.");
 
  AddDetail( ({"wesen"}),
	   "Nekromanten verpassen vielen Wesen eine Gehirnwaesche und lassen "
	   "sie panisch fluechten. Sie machen das weil sie sich mit ihrer Panik "           "so alleine fuehlen.");

  AddDetail( ({"panik"}),
	   "Da die Nekromanten ihre Panik niemals zugeben wuerden, haben sie "
	   "ihr einen anderen Namen verpasst.");

  AddDetail( ({"namen"}),
	   "Sie nennen die Panik Mysterium.");


  AddDetail( ({"mysterium"}),
	   "Ramirez laesst den Kopf nach vorne fallen und hebt beschwoerend "
	   "die Arme.");

  AddDetail( ({"ramirez"}),
	   "Ramirez ist einer von den Leichenbeschwoerern.");

  AddDetail( ({"kopf","arme"}),
	   "Die Nekromanten muessen aufpassen, das ihnen der Kopf und die "
	   "Arme nicht abfallen so morsch wie ihre Koerper sind.");

  AddDetail( ({"koerper","knochen","fleischfetzen"}),
	   "Ihre Koerper bestehen aus einigen morschen Knochen, an denen "
	   "einige verrottete Fleischfetzen haengen.");

  AddDetail( ({"nekromanten","geschoepfe","nekromant"}),
	   "Die Nekromanten sind zwielichtige schleichende Geschoepfe, die "
	   "niemals in den Spiegel schauen, weil sie wissen das sie von ihrem "
	   "eigenen Anblick Albtraeume bekommen würden. Ausserdem haben sie "
	   "den Vorteil, das sie ihre Geliebte jederzeit beschwoeren koennen.");

  AddDetail( ({"spiegel","anblick"}),
	   "Gib einem Nekromanten einen Spiegel und er fluechtet vor sich "
	   "selbst.");

  AddDetail( ({"leichenbeschwoerer","leichenbeschwoerern"}),
	   "Der Oberschnoesel der Leichenbeschwoerer nennt sich Xarfai.");

  AddDetail( ({"vorteil","geliebte"}),
	   "Jeder Nekromant hat eine Geliebte. Und diese Geliebte nennt sich "
	   "Mumie. Sehr praktisch, denn sie hilft ihnen auch im Kampf.");

  AddDetail( ({"kampf","dolch","schaden","zweige","taschenmesser"}),
	   "Nekromanten kaempfen mit einem Taschenmesser, auch Dolch genannt. "
	   "Das erinnert irgendwie an die Kindheit, in der man damit Zweige "
	   "geschnitzt hat. Da sie mit dem Dolch aber nicht viel Schaden machen "
	   "plappern sie monoton irgendwelche Zaubersprueche, von denen sie "
	   "selbst nicht einmal wissen was sie ueberhaupt bedeuten.");

  AddDetail( ({"zaubersprueche","kindheit","clowns","belustigung","kinder"}),
	   "Die Zaubersprueche der Nekromanten wurden in ihrer Kindheit von "
	   "den Clowns zur Belustigung der Kinder gesprochen.");

  AddDetail( ({"mumie","funktion"}),
	   "Die Mumie hat die Funktion einer Gummipuppe fuer die Nekromanten.");
  
  AddDetail( ({"albtraum","albtraeume"}),
	   "Der Albtraum haette ein Ende wenn sie sich endlich mal outen wuerden.");

  AddDetail( ({"ende","kutten"}),
	   "Wenn sie ihre schwarzen Kutten ausziehen wuerden, koennte doch "
	   "jedermann sehen welch nette Kleidung sich darunter verbirgt.");
  
  AddDetail( ({"kleidung"}),
	   "Es ist unbegreiflich wieso sie ihre netten bunten Plueschoverale "
	   "mit den lustigen bunten Knoepfen und den schoenen Rueschen an "
	   "Armen und Kragen verstecken. Und auch ihre rosa Schleife, die sie "
	   "sich ins fahle Haar gebunden haben, ist doch mehr als sehenswert");

  AddDetail( ({"knoepfen","plueschoverale","knoepfe","plueschoveral"}),
	   "Pennywise hat auch so eine nette Kleidung.");

  AddDetail( ({"pennywise"}),
	   "Na den kennst Du doch gewiss.");

  AddDetail( ({"kragen","rueschen","armen"}),
	   "Bunte Rueschen befinden sich an der Kleidung der Nekromanten.");

  AddDetail( ({"schleife","schleifen"}),
	   "Eingefleischte Nekromanten tragen sogar zwei Schleifen in ihrem Haar.");

  AddDetail( ({"haar"}),
	   "Sie faerben sich ihre urspruenglich pinken Haare grau, um boeser "
	   "zu wirken. Jedoch leider erfolglos.");

  
  AddDetail( ({"gummipuppe"}),
	   "Naja sie benutzen sie zum reden und aehm zum kuscheln.");

  AddDetail( ({"xarfai","oberschnoesel","nachfolger"}),
	   "Xarfai ist der Oberschnoesel der Nekromanten. Er hat seine ganzen "
	   "Nachfolger dazu angstiftet Leichen suess zu finden.");

  AddDetail( ({"leichen"}),
	   "So mancher Nekromant hat sich schon einmal in eine Leiche verliebt.");

    
  AddDetail( ({"fall","hochmut"}),
	     "Hochmut kommt vor dem Fall.");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");

  AddDetail( ({"jammerlappen","paladine","paladinen"}),
	     "Wo wir wieder bei den Paladinen waeren.");
	 
   
  AddDetail( ({"mitte"}),
	   "Noch weiter in die Mitte kannst Du nicht gehen.");

  AddDetail( ({"hoehenangst","aengste","luftelementare"}),
	   "Du hast Hoehenangst? Dann geh zu Anvar, der leiht Dir eines seiner "
	   "Luftelementare. Sie verleihen Dir Fluegel oder fliegen mit Dir.");

  AddDetail( ({"fluegel","angst"}),
	   "Druiden fliegen gerne vor lauter Angst davon.");

  AddDetail( ({"dinge"}),
	   "Na alles musst Du auch nicht wissen.");
  
  AddDetail( ({"anvar"}),
	     "Leider wirst Du bei Anvar scheitern, denn der verborgt seine "
	     "Luftelementare nicht so einfach.");

  AddDetail( ({"gehirnwaesche"}),
	     "Du bist froh dass Dir das nicht passiert ist.");

  AddDetail( ({"gilde","amazonengilde"}),
	   "Hier befindet sich die Amazonengilde.");

  AddDetail( ({"gildenoberhaupt"}),
	   "Oh da gibt es noch so manche.");


  AddDetail( ({"nordostoben"}), 
            "Nach Nordostoben gelangst Du zur Burg hinauf.");

  AddDetail( ({"wind"}),
	    "Den kannst Du nicht untersuchen.");

  AddDetail( ({"tuerme","tuermen"}),
	    "Die Tuerme ragen majaestetisch in den Himmel empor.");

  AddDetail( ({"umrandung"}),
	    "Jede Fahne hat eine goldene Umrandung.");

  AddDetail( ({"wappen","wappens","umrisse"}),
	    "Zwei ineinander verschlungene goldene Schlangen. In der Mitte "
	    "dieser Schlangen befindet sich ein Speer.");

  AddDetail( ({"schlangen"}),
	    "Sie bilden das Wappen.");

  AddDetail( ({"speer"}),
	    "Jede richtige Amazone hat einen Speer bei sich.");
	    
  AddDetail( ({"lungen"}),
	    "Deine Lungen sind noch jung und unverbraucht.");

  AddDetail( ({"ohren"}),
	   "Deine Ohren hoeren oft viele Dinge, die sie nicht hoeren sollten.");

  AddDetail( ({"dinge","dingen"}),
	   "Na alles musst Du auch nicht wissen.");

  
  AddSmell(DEFAULT_SMELL, "Du riechst hier die salzige Meeresluft.");

  AddSmell( ({"luft","meeresluft"}),
	   "Die Meeresluft dringt tief in Deine Lungen.");
  
     
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur den Wind und das Plaetschern der "
		 "Wellen.");
	   

  AddSound( ({"wind"}),
	   "Der Wind pfeift Dir um die Ohren.");

  AddSound( ({"plaetschern","wellen"}),
	   "Die Wellen prallen an die Klippen.");	  
  

//-----Details Ende-----
  
  AddExit("osten", ROOM "amazon17.lpc");
  AddExit("suedunten", ROOM "amazon15.lpc");
 
}

 
