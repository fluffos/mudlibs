// von Aaliyah
// 11.02.2005
// 
// Kammer der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Schlafgemach der Waffenmeisterin");
  SetProp(P_INT_LONG,
      "Du stehst hier im Schlafgemach der Waffenmeisterin. An der Westwand "
      "steht ein grosses Himmelbett. Auch ein kleiner Tisch und ein Stuhl "
      "befinden sich im Raum. Weiters erkennst Du ein Waffenregal, das mit "
      "vielen Speeren gefuellt ist. Durch ein grosses Fenster hast Du einen "
      "guten Ueberblick auf die Insel und das Meer. Am Boden liegen viele "
      "Felle und auch einige Vasen stehen hier herum.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//-----------Details Anfang-----------------------------

 AddDetail( ({"schlafgemach","gemach","raum","raumes"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"fenster"}),
	  "Durch das Fenster hast Du einen guten Ueberblick ueber die ganze "
	  "Insel und das Meer. Dir wird etwas schwindelig als Du bemerkst, wie "
	  "hoch der Turm eigentlich ist.");
  
  AddDetail( ({"ueberblick","meer","gaerten","edynia","insel"}),
	  "Du siehst die praechtig gruenen Gaerten von Edynia und das schoene "
	  "tuerkisblaue Meer. Du bewunderst die traumhaft schoene Insel.");

  AddDetail( ({"turm","spitze","turms"}),
	  "Du befindest Dich gerade auf der Spitze des Turms.");

  AddDetail( ({"fenster"}),
	  "Das Fenster ist wunderschoen geschwungen.");

  AddDetail( ({"waffenmeisterin","meisterin","tag","moeglichkeit"}),
	  "Dies ist das Gemach der Waffenmeisterin. Nach einem anstrengenden "
	  "Tag hat sie hier die Moeglichkeit sich auszuruhen.");

  AddDetail( ({"speeren","speere","waffenregal","regal","art","eichenholz",
	      "holz"}),
	  "Das Waffenregal besteht aus Eichenholz und ist mit vielen Speeren "
	  "aller Art gefuellt.");

   AddDetail( ({"westwand","himmelbett","bett"}),
	  "An der Westwand befindet sich das Himmelbett. Viele zartrosa Kissen "
	  "befinden sich darauf. Eine bestickte, hellrosa Seidendecke laed "
	  "richtig zum reinkuscheln ein.");

   AddDetail( ({"kissen","seidendecke"}),
	  "Das Bett sieht so richtig gemuetlich aus.");

   AddDetail( ({"vasen","rosen","vase"}),
	  "Einige Vasen stehen auf dem Boden. Sie sind gefuellt mit hellrosa "
	  "Rosen, die einen zarten Duft verstroemen.");

   AddDetail( ({"duft"}),
	  "Versuch es bitte mit riechen.");

   AddDetail( ({"decke"}),
	  "Die Decke ist nicht wichtig.");


   AddDetail( ({"boden","felle","tigerfelle","tigerfellen"}),
	  "Der Boden ist mit weissen Tigerfellen bedeckt.");

   AddDetail( ({"waende","wand","waenden"}),
	  "Die Waende sind uninteressant.");

   AddDetail( ({"tisch","holz","schale","wasser"}),
	  "Der Tisch besteht aus Holz. Auf dem Tisch befinden sich eine Schale "          "mit Wasser und ein Kerzenstaender.");

   AddDetail( ({"kerzenstaender","staender","kerze","haelfte"}),
	  "Die Kerze im Kerzenstaender ist schon zur Haelfte heruntergebrannt.");
 
   AddDetail( ({"stuhl"}),
	  "Ein Waffengurt und ein stahlverstaerktes Roeckchen wurden achtlos "
	  "ueber den Stuhl geworfen. Das sieht ein bisschen schlampig aus.");
   
   AddDetail( ({"waffengurt","gurt"}),
	  "Der Waffengurt ist alt und sollte mal erneuert werden.");

   AddDetail( ({"roeckchen","dreck"}),
	  "Das Roeckchen steht vor lauter Dreck. Es ist unglaublich das die "
	  "Waffenmeisterin nicht daran denkt es zu waschen.");
 
  AddSmell(DEFAULT_SMELL, "Die Rosen in der Vase duften herrlich.");
 
  AddSmell( ({"rosen","duft"}),
	   "Die Rosen duften einfach himmlisch.");
    
  AddSound(DEFAULT_SOUND, "Hier ist es absolut still.");

//--------------Details Ende------------------------------
 

  AddExit( "unten", "./turm7_4");
}  
   
