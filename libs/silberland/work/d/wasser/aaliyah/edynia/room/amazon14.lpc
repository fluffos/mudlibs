//
 
inherit "std/room";
#include "../def.h"


void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer steilen Klippe");
  SetProp( P_INT_LONG,
	"Du stehst hier auf einem Weg in den Klippen. Er fuehrt steil nach oben "
       	"hin zur Burg. Hier ist alles sehr felsig. Am Boden erkennst Du viele "
	"Wagen und Pferdespuren. Es ist ein Zeichen dafuer das hier ein reger "
	"Betrieb sein muss. Rechts und links faellt die Klippe steil nach unten "
	"ins Meer hinein. Der Abgrund neben Dir ist so tief, das Du panische "
	"Hoehenangst bekommst und Dich etwas weiter in die Mitte begibst.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "weg", QueryProp(P_INT_LONG) );

  AddDetail( ({"zeichen"}),
	   "Im nuechternen Zustand muesstest Du die Zeichen doch erkennen.");

  AddDetail( ({"zustand"}),
	   "Bist Du ein Zechpreller der alles doppelt sieht?");


  AddDetail( ({"klippen","klippe"}), 
            "Die Klippen fallen steil nach unten ins Meer hinein.");

  AddDetail( ({"meer"}), 
            "Das Meer liegt sehr weit unter Dir und scheint hier aeusserst "
	    "tief zu sein. Genau sagen kannst Du es nicht. Du schliesst es "
	    "einfach aus der tiefblauen Farbe.");

  AddDetail( ({"farbe"}), 
            "Das Meer hat eine tiefblaue Farbe.");

  AddDetail( ({"burg","sicht"}), 
            "Du kannst die Burg hier noch nicht erkennen, da Dir eine grosse "
	    "Klippe die Sicht versperrt.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist hier sehr felsig. Einige Wagen und Pferdespuren "
	    "befinden sich auf ihm.");


  AddDetail( ({"pferdespuren","wagenspuren","wagenspur","pferdespur","spur",
	       "spuren"}), 
            "Viele Wesen scheinen die Burg zu besuchen denn die Spuren deuten "
	    "auf einen regen Betrieb hin.");
 
  AddDetail( ({"angst"}),
	     "Hast Du Angst? Wenn ja, wovor?");

  AddDetail( ({"leute"}),
	     "Du bist aber neugierig.");

  AddDetail( ({"wagen"}),
	     "Hier kommt schon oft ein Wagen vorbei.");
  
  AddDetail( ({"rechts","links"}), 
            "Rechts und links befindet sich der steile Abgrund.");

  AddDetail( ({"abgrund"}), 
            "Der Abgrund faellt steil ins Meer.");


  AddDetail( ({"betrieb"}), 
            "Die Amazonen werden von vielen Wesen besucht.");
  
  AddDetail( ({"amazonen","edynia","insel"}), 
            "Edynia ist die Insel der Amazonen.");
  
  AddDetail( ({"wesen","rassen"}), 
            "Alle moeglichen Rassen besuchen die Amazonenburg.");

  AddDetail( ({"amazonenburg","besucher","grund"}), 
            "Hippolyte ist die Amazonenkoenigin und auch wohl der Grund fuer "
	    "die vielen Besucher hier.");

    
  AddDetail( ({"amazonenkoenigin","hippolyte"}), 
            "Die Amazonenkoenigin ist von unglaublicher Schoenheit. Sie hat "
	    "den Anmut einer Frau und die Kraft und den Mut eines Mannes.");

  
  AddDetail( ({"anmut","frau","frauen"}), 
            "Frauen sollten schon anmutig sein.");
 
  AddDetail( ({"kraft","mut","mann","mannes"}), 
            "Ein Mann sollte Kraft und Mut besitzen. Mit diesen Eigenschaften "
	    "kann ein Zechpreller leider nicht dienen.");
 
  AddDetail( ({"eigenschaften"}),
	   "Zechpreller sind Suffhansel die nichts koennen ausser sich in den "
	   "Kneipen volllaufen zu lassen. Ihr ganzes Geld geht fuer Alkohol "
	   "drauf und somit muessen sie die Zeche prellen.");

  AddDetail( ({"zechpreller","zechprellern"}),
	   "Es gibt nur einen Grund warum ein Zechpreller eben ein Zechpreller "
	   "ist und in keiner anderen Gilde zugehoerig ist.");

  AddDetail( ({"grund"}),
	   "Jeder der Zechpreller ist, hat sich schon einmal bei einer anderen "
	   "Gilde beworben. Da er nichts geleistet hat, wurde er aus der Gilde "
	   "geworfen. Das wiederum hat ihn so frustriert das er einfach zur "
	   "Flasche greifen musste um den Demut zu betaeuben.");


  AddDetail( ({"demut","scham"}),
	   "Sie betaeuben ihren Scham mit Alkohol.");

  AddDetail( ({"flasche"}),
	   "Gleich und gleich gesellt sich gern, darum hat jeder Zechpreller "
	   "immer gerne eine Flasche bei sich.");

  AddDetail( ({"suffhansel","wesen"}),
	   "Lauter torkelnde, lallende und nach Alkohol stinkende Wesen.");

  AddDetail( ({"zeche"}),
	   "Frag einmal Zechus Prellus nach Zeche, der lacht Dich aus.");

  AddDetail( ({"zechus","zechus prellus","prellus","oberschnapsnase"}),
	   "Zechus Prellus ist die Oberschnapsnase. Er hat alle schwachen und "
	   "vom Leben gepraegten Wesen aufgegriffen und sie zum Alkohol verleitet.");

  AddDetail( ({"leben","leber"}),
	   "Die Leber hat bei den Zechprellern kein leichtes Leben.");

  AddDetail( ({"alkohol"}),
	   "Gib einem Zechpreller Alkohol er wird Dich fuer immer lieben. "
	   "Er faellt Dir gluecklich um den Hals und zwaengt Dir eines seiner "
	   "ekligen stinkenden Bussis auf.");

  AddDetail( ({"bussis","hals"}),
	   "Dich ekelt es bei dem Gedanken an einen Zechpreller.");

  AddDetail( ({"kampfstil"}),
	   "Die Zechpreller poebeln im Suff die Leute an, sie erbrechen ueber "
	   "den Boden und sie versuchen krampfhaft noch irgendwelchen Schaden "
	   "mit einer xbeliebigen Waffe zu machen.");

  AddDetail( ({"gedanken"}),
	   "Denk besser nicht an ihren Kampfstil.");

  AddDetail( ({"suff","atem","gegenueber"}),
	   "Selbst der Atem eines Zechprellers macht den Gegenueber schon "
	   "betrunken.");

  AddDetail( ({"schaden","waffe"}),
	   "Sie geben halt die Hoffnung nicht auf das sie doch noch lernen "
	   "koennen zu kaempfen.");

  AddDetail( ({"hoffnung"}),
	   "Die Zechpreller werden niemals kaempfen koennen.");

  
  AddDetail( ({"fall","hochmut"}),
	     "Hochmut kommt vor dem Fall.");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");
	 
   
  AddDetail( ({"mitte"}),
	   "Noch weiter in die Mitte kannst Du nicht gehen.");

  AddDetail( ({"hoehenangst","aengste"}),
	   "Du hast Hoehenangst? Dann geh zu Zechus Prellus. Der macht Dich "
	   "so betrunken das Du vor nichts mehr Angst hast.");

  AddDetail( ({"gilde","amazonengilde"}),
	   "Hier befindet sich die Amazonengilde.");

  AddDetail( ({"gildenoberhaupt"}),
	   "Oh da gibt es noch so manche.");


  AddDetail( ({"nordostoben"}), 
            "Nach Nordostoben gelangst Du zur Burg hinauf.");

  AddDetail( ({"wind"}),
	    "Den kannst Du nicht untersuchen.");

  AddDetail( ({"tuerme","tuermen"}),
	    "Die Tuerme ragen majaestetisch in den Himmel empor.");

  AddDetail( ({"umrandung"}),
	    "Jede Fahne hat eine goldene Umrandung.");

  AddDetail( ({"wappen","wappens","umrisse"}),
	    "Zwei ineinander verschlungene goldene Schlangen. In der Mitte "
	    "dieser Schlangen befindet sich ein Speer.");

  AddDetail( ({"schlangen"}),
	    "Sie bilden das Wappen.");

  AddDetail( ({"speer"}),
	    "Jede richtige Amazone hat einen Speer bei sich.");
	    
  AddDetail( ({"lungen"}),
	    "Deine Lungen sind noch jung und unverbraucht.");

  AddDetail( ({"ohren"}),
	   "Deine Ohren hoeren oft viele Dinge, die sie nicht hoeren sollten.");

  AddDetail( ({"dinge"}),
	   "Na alles musst Du auch nicht wissen.");

  
  AddSmell(DEFAULT_SMELL, "Du riechst hier die salzige Meeresluft.");

  AddSmell( ({"luft","meeresluft"}),
	   "Die Meeresluft dringt tief in Deine Lungen.");
  
     
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur den Wind und das Plaetschern der "
		 "Wellen.");
	   

  AddSound( ({"wind"}),
	   "Der Wind pfeift Dir um die Ohren.");

  AddSound( ({"plaetschern","wellen"}),
	   "Die Wellen prallen an die Klippen.");	  
  

//-----Details Ende-----
  
  AddExit("nordwestoben", ROOM "amazon15.lpc");
  AddExit("suedwestunten", ROOM "amazon13.lpc");
 
}

 
