// Wolkenraum von Edynia

inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer Wolkentreppe");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einer schmalen Wolkentreppe. Tief unter "
	"befindet sich das Meer. Auch die Insel kannst Du von hier aus gut "
        "ueberblicken. Rund um Dich befindet sich lauter Nebel und Du hast "
	"dass Gefuehl, Dich inmitten einer kleinen Wolke zu befinden.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_AIR]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","weg"}), 
            "Der Boden liegt sehr weit unter Dir. Du hast etwas Angst, dass "
	    "Du von der Wolke fallen koenntest.");
             

  AddDetail( ({"gefuehl","angst"}), 
            "Grosse Angst ueberkommt Dich. Irgendwie bemerkst Du, dass Du "
	    "anscheinend an Hoehenangst leidest.");
            
	 
  AddDetail( ({"hoehenangst"}),
	    "Du wirst panisch!");
      

  AddDetail( ({"meer"}),
	    "Das Meer liegt tief unter Dir. Sanfte Wellen schlagen gegen die "
	    "Klippe. Das Meer hat eine wunderschoene tuerkise Farbe, sodass "
	    "Du es noch eine Weile bewunderst.");
	    	  
  
  AddDetail( ({"himmel"}),
	    "Du befindest Dich mitten im Himmel.");
	 
  AddDetail( ({"wolken","wolke"}),
	    "Rund um Dich befinden sich viele Wolken.");
	     

  AddDetail( ({"sonnenstrahlen","sonne"}),
	    "Vor lauter Nebel kannst Du die Sonne nicht erkennen.");
         

  AddDetail( ({"wellen","klippe","farbe"}),
	    "Sanfte tuerkise Wellen schlagen auf die Klippe, die sich tief "
	    "unter Dir befindet.");

  AddDetail( ({"weile"}),
	    "Du laesst Dir etwas Zeit.");

  AddDetail( ({"insel"}),
	    "Die Insel liegt sehr weit unter Dir.");

  AddDetail( ({"nebel"}),
	    "Der Nebel huellt Dich ein.");

  
  
  AddDetail( ({"zeit","bedeutung"}),
	    "Hier oben, hoch ober den Wolken, hat die Zeit eine ganz andere "
	    "Bedeutung.");

  AddDetail( ({"wolkentreppe","treppe"}),
            "Du befindest Dich auf einer schmalen Wolkentreppe.");
            

  
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach nichts.");
                        
 
  AddSmell( ({"nichts"}),
	   "Nichts kann man nicht riechen.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier nichts.");
	   

  AddSound( ({"nichts"}),
	   "Nichts kann man auch nicht hoeren.");

          
  

//-----Details Ende-----
  
AddExit("suedostunten", ROOM "wolke4.lpc");
AddExit("nordostoben", ROOM "wolke6.lpc");
}  
   
