// von Aaliyah
// 04.02.2005
// 
// Hexenraum der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Gemach der Hexe");
  SetProp(P_INT_LONG,
      "Du befindest Dich hier in einer duesteren Kammer. An den Waenden "
      "befinden sich viele Regale. Von der Decke haengen lauter Kraeuter "
      "herab und verstroemen einen wuerzigen Geruch. In der Mitte der Kammer "
      "befindet sich ein grosses Eisengestell, an dem sich ein Kessel befindet. "
      "Dampfender Rauch stroemt aus dem Kessel und erweckt Deine Neugier. "
      "Weiters erkennst Du einen kleinen Holztisch, auf dem sich eine grosse "
      "Glaskugel befindet.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//--------------Details Anfang----------------------------------------------

 AddDetail( ({"kammer"}), QueryProp(P_INT_LONG) );

 AddDetail( ({"waende","waenden","wand","stein","regale"}), 
            "Die Waende bestehen aus Stein. Auf den Waenden befinden sich "
	    "viele Regale, die mit unzaehligen Flaschen, Schalen und Dosen "
	    "gefuellt sind.");

 AddDetail( ({"flaschen","essenzen","fluessigkeiten"}), 
            "Die Flaschen sind mit merkwuerdigen Essenzen gefuellt. Die "
	    "Fluessigkeiten haben seltsame Farben und Du entschliesst Dich, "
	    "dem nicht weiter nachzugehen.");

 AddDetail( ({"farben"}), 
            "Blutrot, giftgruen, nachtschwarz, eiergelb und violett.");

 AddDetail( ({"kraeuter","geruch","decke"}), 
            "Viele getrocknete Kraeuter baumeln von der Decke herab und "
	    "verstroemen einen wuerzigen Geruch.");

 AddDetail( ({"mitte","kessel","rauch"}), 
            "Dampfender Rauch stroemt aus dem Kessel, der in der Mitte der "
	    "Kammer steht. Was sich darin befindet kannst Du leider nicht "
	    "erkennen.");

 AddDetail( ({"dosen","schalen"}), 
            "Darin befinden sich zerstampfte Kraeuter, Pasten, zerkleinerte "
	    "Schlangenhaeute, einige Salamanderschwaenze, viele Froschschenkel "
	    "und noch ein paar Zwergenaugen.");

 AddDetail( ({"pasten","salbe","flugsalbe"}), 
            "Unter den Pasten befindet sich auch die traditionelle Flugsalbe "
	    "der Hexen. Mit dieser Salbe koennen die Hexen auch ohne ihre "
	    "Besen fliegen.");

  AddDetail( ({"besen","hexen","sacciw","hexe"}), 
            "Wenn man wahrhaftige Hexen sehen moechte, muss man nach Sacciw "
	    "reisen.");

  AddDetail( ({"schlangenhaeute","schlangenhaut","haut","haeute","muster"}), 
            "Die Schlangenhaeute sind so dermassen zerstueckelt, dass man "
	    "nicht einmal mehr das Muster erkennen kann.");
 
   AddDetail( ({"salamanderschwaenze","schwaenze","blut","salamanderschwaenzen"}), 
            "An den Salamanderschwaenzen befindet sich noch etwas trockenes "
	    "Blut.");
   
   AddDetail( ({"froschschenkel","schenkel"}), 
            "Die sehen getrocknet aus.");

   AddDetail( ({"zwergenaugen","augen","zwergen","zwerge","wesen"}), 
            "Die Zwergenaugen wurden den kleinen Wesen einfach ausgestochen.");

   AddDetail( ({"holztisch","tisch"}), 
            "Ein einfacher Holztisch mit einer Kristallkugel darauf.");

   AddDetail( ({"eisengestell","gestell"}), 
            "Auf dem Eisengestell befindet sich der Kessel.");

   AddDetail( ({"neugier"}), 
            "Du kannst Deine Neugier kaum bremsen.");

   AddDetail( ({"glaskugel","kugel","kristallkugel","zukunft"}), 
            "Mit der Glaskugel kann die Hexe in die Zukunft blicken.");

   AddDetail( ({"boden","decke"}), 
            "Hier besteht alles aus Stein.");



 
 AddSmell(DEFAULT_SMELL, "Die Kraeuter verstroemen einen wuerzigen Geruch.");
 
  AddSmell( ({"kraeuter","geruch"}),
	   "Die Kraeuter riechen wuerzig.");
    
  AddSound(DEFAULT_SOUND, "Du hoerst es aus dem Kessel blubbern.");
	   

  AddSound( ({"kessel","blubbern"}),
	  "Im Kessel blubbert es vor sich hin.");

   AddRoomMessage( ({"Sanfter Rauch stroemt durch die Kammer.\n"}), 80);

//------------Details Ende----------------------------------

    
  AddExit( "unten", "./turm1_4");
  AddItem(NPC "morgaine.lpc", REFRESH_DESTRUCT);
}  
   
