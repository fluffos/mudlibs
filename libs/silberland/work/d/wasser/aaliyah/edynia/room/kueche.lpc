// von Aaliyah
// 15.02.2005
// 
// Kueche der Amazonenburg

inherit "std/pub";
#include <pub.h> 
#include "../def.h"


void create()
{
  ::create();

  

  SetProp( P_INT_SHORT, "In der Amazonenkueche");
  SetProp( P_INT_LONG, "Du befindest Dich hier in einer grossen Kueche. Viele "
	  "Toepfe und Pfannen haengen an den Waenden. An der Westwand befinden "
	  "sich ein grosser Herd, ein Ofen und einige kleine Kaestchen. "
	  "Dampfender Rauch stroemt aus einem grossen Topf, der am Herd "
	  "vor sich hinblubbert. Viele Tonschalen und Flaschen stehen in einem "
	  "grossen Regal, das sich zu Deiner Linken befindet. In einer Ecke "
	  "stehen viele Kisten und Saecke und ein grosses Fass mit Wein. "
	  "Etwas schmutziges Geschirr befindet sich in der Spuele, aber es ist "          "ja nicht Deine Aufgabe, es zu saeubern.");
          
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "dinah");
  SetProp(P_PUBKEEPER_NAME, "Dinah");
  SetProp(P_PUBMSG_NOKEEPER, "Dinah ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Dinah bedient ihre Feinde nicht."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Dinah ist gerade in einen Kampf verwickelt und kann Dich nicht bedienen."));
  SetProp(P_PUBMSG_FIGHTING, "Dinah kaempft gerade.\n");
  
//-----Details Anfang-----
 

 AddDetail( ({"kueche","raum","raumes","amazonenkueche"}),QueryProp(P_INT_LONG));
	
 AddDetail( ({"wand","waenden","waende","toepfe","pfannen"}), 
            "Viele saubere Toepfen und Pfannen haengen an den Waenden.");

 AddDetail( ({"westwand"}), 
            "An der Westwand stehen ein Herd, ein Ofen und einige kleine "
	    "Kaestchen.");
 
 AddDetail( ({"kaestchen"}), 
            "Die Kaestchen sind geschlossen und Du kuemmerst Dich nicht weiter "
	    "darum.");
 
 AddDetail( ({"herd","topf","suppe","rauch"}), 
            "Ein grosser Topf mit dampfender Suppe steht am Herd. Weiters "
	    "siehst Du das geschlossene Backrohr.");

 AddDetail( ({"backrohr","rohr"}), 
            "Das Backrohr ist ziemlich ueberfuellt. Ein Wildschweinbraten und "
	    "ein Auflauf nehmen sehr viel Platz weg.");

 AddDetail( ({"platz"}), 
            "Etwas Platz ist noch im Rohr. Aber mehr als eine Vase passt "
	    "wohl nicht mehr rein.");

 AddDetail( ({"ofen","auflauf","wildschweinbraten","braten"}), 
            "Im Ofen wird gerade ein Wildschweinbraten und ein Auflauf "
	    "zubereitet.");
 
 AddDetail( ({"linken","regal","holz"}), 
            "Das Regal besteht vollkommen aus Holz und ist mit vielen Flaschen "            "und Tonschalen gefuellt.");

 AddDetail( ({"tonschalen","schalen","gewuerze","gewuerzen"}), 
            "In den Schalen befinden sich gehackte und gemahlene Gewuerze.");

 AddDetail( ({"flaschen","essenzen","wuerzen"}), 
            "In den Flaschen befinden sich die edelsten Essenzen, die wohl "
	    "auch zum Wuerzen gedacht sind.");
 
 AddDetail( ({"ecke"}), 
            "Einige Kisten, Saecke und ein grosses Fass Wein stehen in der "
	    "Ecke.");

 AddDetail( ({"saecke","saecken","mehl","getreide"}), 
            "In den Saecken wird das Mehl und auch anderes Getreide aufbewahrt.");
 
 AddDetail( ({"kisten","fruechte","fleisch","lebensmitteln","lebensmittel"}), 
            "In den Kisten befinden sich viele exotische Fruechte und auch "
	    "viel frisches Fleisch.");

 AddDetail( ({"fass","weinfass","wein","burgunder"}), 
            "Koestlicher Burgunder befindet sich im Fass.");

 AddDetail( ({"decke","boden"}), 
            "Hier ist alles peinlich sauber.");

 AddDetail( ({"spuele"}), 
            "In der Spuele befindet sich etwas schmutziges Geschirr.");

 AddDetail( ({"aufgabe"}), 
            "Deine Aufgabe ist es jedenfalls nicht.");

 AddDetail( ({"geschirr"}), 
            "Schmutzige Toepfe, Pfannen und Besteck befinden sich in der "
	    "Spuele. Auch einige Teller kannst Du erkennen.");

 AddDetail( ({"besteck","gabeln","messer","loeffel","schoepfkellen","kellen"}), 
            "Schoepfkellen, Gabeln, Messer und Loeffel.");

 AddDetail( ({"teller","gaeste"}), 
            "Vom Tisch werden die Gaeste wohl kaum essen.");

 AddDetail( ({"tisch","tafel","speisesaal","saal"}), 
            "Die Tafel befindet sich im Speisesaal.");

 AddDetail( ({"speisen","appetit","hunger"}), 
            "Du bekommst einen grossen Hunger.");
 
 
 AddSmell(DEFAULT_SMELL, "Es duftet hier herrlich nach frischen Gewuerzen, "
                          "Suppe, Auflauf und Braten.");  
 
  AddSmell( ({"gewuerze","gewuerzen"}),
	   "Der Gewuerze duften wuerzig und auch suesslich.");
	 

  AddSmell( ({"auflauf","braten","suppe","speisen"}),
	   "Die Speisen duften herrlich und erregen Deinen Appetit.");
  
   
  AddSound(DEFAULT_SOUND, "Das Geschirr klirrt und tscheppert und die Suppe "
		  "am Herd brodelt vor sich hin.");

  AddSound( ({"geschirr","klirren","tscheppern","klirrt","tscheppert"}),
	   "Das Geschirr klirrt und tscheppert.");
  
  AddSound( ({"blubbern","brodeln","suppe"}),
	   "Die Suppe blubbert und brodelt und macht Dir richtigen Hunger."); 
 
//--------------Details Ende-----------------------------
 
 
  AddDrink("Lilientee", ({"lilientee", "tee"}),
           70,({30,10,0}), 0, 5,
           ({"Dinah serviert Dir eine dampfende Tasse mit Lilientee.\n",
             "&& trinkt koestlichen heissen Lilientee.\n"}));

  AddDrink("Rosenwein", ({"rosenwein", "wein"}),
            150, 30, 5, 5,
           ({"Dinah bringt Dir eine Karaffe koestlichen Rosenweins.\n"
            +"Schluerf!!!! Ist der lecker!!\n",
             "&& geniesst ein Glas Rosenwein und laechelt verzueckt.\n"}));
  
  AddDrink("Orchideencocktail", ({"cocktail","orchideencocktail"}),
           700,({100,0,0}), 7, 6,
           ({"Dinah bringt Dir laechelnd Dein Getraenk.\n",
             "&& leert das Glas mit einem Zug.\n"}));

  AddDrink("Prosecco", ({"prosecco", "sekt"}),
            888, 88, 18, 3,
           ({"Eine Dienerin serviert Dir ein Glas prickelnden Prosecco.\n"
            +"Mjamm!!!! Der Sekt prickelt auf Deiner Zunge!!\n",
             "&& nippt an einem Glas Prosecco.\n"}));

   
  AddDrink("Blumennektar", ({"nektar","blumennektar"}),
           1700, 150, 0, 19,
           ({"Eine Dienerin serviert Dir einen Blumenkelch voll Nektar.\n",
             "&& trinkt einen Blumenkelch voll koestlichem Nektar.\n"}));

  AddDrink("Burgunder", ({"burgunder", "wein"}),
            350, 40, 7, 4,
           ({"Dinah serviert Dir flink einen roten Burgunder.\n"
            +"WOW!!!! Schmeckt der edel!!\n",
             "&& trinkt genuesslich ein Glas roten Burgunder.\n"}));

  AddDrink("Gruener Edynier", ({"edynier", "gruener edynier"}),
            600,({0,70,0}), 0, 7,
           ({"Dinah serviert Dir ein Glas gruenen Edynier.\n"
            +"SCHLUCK!!!! Der war vielleicht trocken!!\n",
             "&& trinkt ein Glas gruenen Edynier.\n"}));

  
// ----------------------------------------------

  
  AddFood("Zwergenkuchen", ({"kuchen", "zwergenkuchen"}), 33, 15, 6,
           ({"Dinah bringt Dir laechelnd ein grosses Teller mit Zwergenkuchen. "
            +"\nHmmmm, ist der lecker!. Er schmeckt etwas nussig und nach "
            "vielen Dir unbekannten Gewuerzen.\n",
             "&& isst genuesslich einen Teller Zwergenkuchen.\n"}));
 
  AddFood("Wildschweinbraten", ({"braten","wildschweinbraten"}), 700, 100, 29,
           ({"Dinah bringt Dir einen kleinen Tontopf mit koestlichem Fleisch!\n"
            +BS("Wow, ist das Fleisch zart. Und die Sauce erst.. Gierig "
                "schlingst Du die ganze Portion mit einigen wenigen Bissen "
                "hinunter und ueberlegst Dir noch so einen leckeren Braten "
                "zu bestellen."),
             "&& schlingt gierig das Essen hinunter.\n"}));

  AddFood("Einhornsteak", ({"einhornsteak", "steak"}), 350,({0,100,0}), 16,
           ({"Dinah serviert Dir einen grossen Teller mit einem Einhornsteak. "
            +"\nDu bewunderst die huebsche Gemuesedekoration, nimmst eine "
            "Gabel und ein Messer und isst brav alles auf.\n",
             "&& isst artig ein grosses Teller mit Einhornsteak.\n"}));
 
  AddFood("Drachensuppe", ({"suppe", "drachensuppe"}), 110,({40,0,0}), 7,
           ({"Dinah bringt Dir eine Schale dampfende Suppe. "
            +"\n*DAMPF* sie ist brennend heiss und Du verbrennst Dir "
            "Deine Zunge. Aber lecker ist sie trotzdem.\n",
             "&& schluerft gierig eine dampfende Schale Suppe.\n"}));

  AddFood("Jasminsorbet", ({"jasminsorbet","sorbet"}), 190, 30, 9,
           ({"Eine Dienerin serviert Dir eine Schale mit koestlichem Sorbet. "
            +"\n*Mjaaaaaaamm* Lecker! Das Jasminsorbet schmeckt so lecker, "
            "dass Du sofort Lust auf mehr bekommst.\n",
             "&& geniesst leckeres Jasminsorbet.\n"}));
  
  AddFood("Goetterauflauf", ({"auflauf","goetterauflauf"}), 1000, 90, 23,
           ({"Eine Dienerin bringt Dir eine kleine Pfanne mit Goetterauflauf. "
            +"\nDer Kaese zieht sich lecker. Du isst alles auf und leckst auch "
            "noch die Pfanne sauber.\n",
             "&& schlingt gierig eine Pfanne voll Goetterauflauf hinunter.\n"}));
  
  AddFood("Sanfte Goettin", ({"goettin", "sanfte goettin"}), 2000, 130, 20,
           ({"Dinah serviert Dir eine Kristallschale mit koestlicher Creme. "
            +"\nDie Creme schmeckt nach Waldfruechten und auch einige kleine "
            "Nusssplitter befinden sich darin. Sie ist einfach herrlich.\n",
             "&& isst eine goettliche Creme.\n"}));

//----------------------------------------------------------------------------- 
  
  AddExit( "osten", "./speise");
  AddItem(NPC "dinah.lpc", REFRESH_DESTRUCT);

//-----------------------------------------------------------------------------
   
   AddCmd( ({ "brenn", "brenne" }), "c_brennen");
  }  
  int c_brennen(string str)
   {
   notify_fail(BS("Wo moechtest Du hier was brennen?"));
   if(!((str == "vase in ofen") || (str == "vase in backrohr")) ||
     (str == "vase in rohr") || ((str == "vase in backofen")))
   {
     return 0;
   }
   if(!present("QUEST-ROHVASE", TP))
   {
    
   write(BS("Du hast doch gar keine passende Vase dabei."));
   tell_room(ENV(TP), TPN+" wirft einen kurzen Blick ins Backrohr.\n", ({TP}));

   return -1;
   
   }
  call_out("seq1", 0);

   return 1;
  
 }
  void seq1()
 {
  if (!TP || !present(TP))
  return;
  write("Du oeffnest das Backrohr und guckst ob noch irgendwo Platz ist.\n");
  call_out("seq2", 4);
  tell_room(ENV(TP), TPN+" stellt etwas in den Ofen.\n", ({TP}));
 }

 void seq2()
 {
  if (!TP || !present(TP))
  return;
  write("Du stellst Deine Rohvase in das Backrohr und schliesst es.\n");
  present("QUEST-ROHVASE", TP)->remove();
  call_out("seq3", 4);
 }
 void seq3()
 {
  if (!TP || !present(TP))
  return;
  write("Du setzt Dich hin und wartest.\n");
  call_out("seq4", 4);
 }
  void seq4()
 {
  if (!TP || !present(TP))
  return;
  write("Ein seltsamer Geruch breitet sich in der ganzen Kueche aus.\n");
  call_out("seq5", 4);
 }
 void seq5()
 {
  if (!TP || !present(TP))
  return;
  write("Du guckst auf die Uhr und wirst ungeduldig.\n");
  call_out("seq6", 4);
 }
 void seq6()
 {
  if (!TP || !present(TP))
  return;
  write("Du denkst . o O (Ich hasse die Warterei)\n");
  call_out("seq7", 4);
 }
 void seq7()
 {
  if (!TP || !present(TP))
  return;
  write("Du wirfst einen Blick in den Ofen.\n");
  call_out("seq8", 4);
 }
 void seq8()
 {
  if (!TP || !present(TP))
  return;
  write("Bald ist die Vase fertig.\n");
  call_out("seq9", 4);
 }
 void seq9()
 {
  if (!TP || !present(TP))
  return;
  write("Du drehst Daeumchen und summst eine froehliche Melodie.\n");
  call_out("seq10", 4);
 }
 void seq10()
 {
  if (!TP || !present(TP))
  return;
  write("Jetzt scheint die Vase fertig zu sein.\n");
  call_out("seq11", 4);
 }
 void seq11()
 {
  if (!TP || !present(TP))
  return;
  write("Du nimmst ein Geschirrtuch und holst die heisse Vase aus dem Ofen.\n");
  call_out("seq12", 4);
 }
 void seq12()
 {
  if (!TP || !present(TP))
  return;
  write("Du tauchst die Vase in kaltes Wasser um sie zu kuehlen.\n");
  call_out("seq13", 4);
 }
 void seq13()
 {
  if (!TP || !present(TP))
  return;
  write("Du bist stolz auf Dich so eine schoene Vase hergestellt zu haben.\n");
  call_out("seq14", 4);
 }
 void seq14()
 {
  if (!TP || !present(TP))
  return;
  write("Du steckst die fertige Vase ein.\n");
  clone_object(OBJ "vase")->move(TP, M_NOCHECK);
   
 }
  

    
