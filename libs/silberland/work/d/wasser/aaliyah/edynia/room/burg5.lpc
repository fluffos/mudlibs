// 02.02.2005
// 
// Burghof der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Hof der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier im noerdlichen Teil des Burghofes. Von hier "
	"aus hast Du einen sehr guten Ueberblick auf den gesamten Hof. "
	"Oestlich von Dir befindet sich eine weisse Mauer, an der sich viele "
	"Rosen emporschlaengeln. Im Norden von Dir befindet sich der grosse "
	"Speisesaal der Amazonen. Der Duft vieler Speisen dringt in Deine "
	"Nase und Du verspuerst schon langsam einen leichten Hunger.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//----------------Details Anfang--------------------------

  AddDetail( ({"hof","burghof","teil","burghofes","hofes"}), QueryProp(P_INT_LONG) );

    
  AddDetail( ({"boden","rasen","gras"}), 
            "Das Gras waechst hier saftig gruen.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist strahlend blau.");

  AddDetail( ({"nase","speisen","duft","riechen"}), 
            "Du solltest es mal mit Riechen versuchen.");

  AddDetail( ({"hunger","magen"}), 
            "Dein Magen beginnt laut zu knurren.");

  
  AddDetail( ({"rosen","mauer","stallungen","aussenwand","oestlich"}), 
            "An der Mauer schlaengeln sich viele hellblaue Rosen empor. "
	    "Die Mauer ist die Aussenwand der Stallungen, in die Du von "
	    "hier aus nicht gelangen kannst.");

  
  AddDetail( ({"speisesaal","norden","saal"}), 
            "Durch einen schoenen Torbogen gelangst Du direkt in den Saal.");

  
  AddDetail( ({"torbogen","bogen","eingang"}), 
            "Der Torbogen ist der Eingang zum Speisesaal. Viele hellblaue "
	    "Rosen schlaengeln sich am Bogen entlang.");

  
  AddDetail( ({"ueberblick"}), 
            "Du hast hier einen sehr guten Ueberblick ueber den gesamten "
	    "Burghof. Rund um Dich ragt die maechtige Burg in die Hoehe. "
	    "Ausserdem siehst Du die schoen geschmueckte Tafel im Speisesaal.");

  
  AddDetail( ({"hoehe","burg"}), 
            "Rund um Dich ragt die maechtige Burg in die Hoehe. Die Tuerme "
	    "sind so dermassen hoch, das Du das Gefuehl hast, sie waeren die "
	    "direkte Verbindung zwischen Himmel und Erde.");

  
  AddDetail( ({"tafel"}), 
            "Du musst hingehen um sie genauer betrachten zu koennen.");

  
  AddDetail( ({"gefuehl","tuerme","verbindung"}), 
            "Du hast das Gefuehl als waeren die Tuerme die direkte Verbindung "
	    "zwischen Himmel und Erde.");

  
  AddDetail( ({"erde"}), 
            "Du stehst hoffentlich mit beiden Beinen fest am Boden.");

  
  AddDetail( ({"beinen","beine","reise"}), 
            "Deine Beine sind von der weiten Reise etwas muede. Geh doch in "
	    "den Speisesaal und iss eine Kleinigkeit.");

  
  AddDetail( ({"snack","kleinigkeit","drink","speisen"}), 
            "Ein kleiner Snack und ein kuehler Drink wuerden Deinem Magen "
	    "sicherlich eine grosse Freude bereiten.");

  
  AddDetail( ({"freude"}), 
            "Du leckst Dir ueber Deine Lippen.");

  
  AddDetail( ({"lippen"}), 
            "Deine Lippen schon ganz ausgetrocknet.");

  
  AddDetail( ({"klappern","geschirr","amazonen"}), 
            "Lauschen!");



  AddSmell(DEFAULT_SMELL, "Der Duft vieler leckerer Speisen stroemt in Deine "
		  "Nase und macht Dich etwas hungrig.");

  AddSmell( ({"speisen","duft"}),
	   "Dein Magen krampft sich hungrig zusammen.");

      
  AddSound(DEFAULT_SOUND, "Du hoerst hier das Klappern von Geschirr und das "
		  "Geplapper einiger Amazonen.");
	   

  AddSound( ({"amazonen","geplapper"}),
	  "Die Amazonen plappern vergnuegt vor sich hin.");
  
  AddSound( ({"klappern","geschirr"}),
	  "Anscheinend wird gerade die Tafel im Speisesaal gedeckt.");

  AddRoomMessage( ({"Du riechst den Duft leckerer Speisen.\n"}), 90);

  AddItem(NPC "amazone_wache", REFRESH_DESTRUCT);

//------------------Details Ende------------------------


  AddExit( "norden", "./speise");
  AddExit( "sueden", "./brunnen");
  AddExit( "westen", "./burg3");
}  
   
