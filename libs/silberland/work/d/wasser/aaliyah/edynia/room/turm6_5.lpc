// Leuchtturm der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Leuchtturm der Amazonen");
  SetProp(P_INT_LONG,
      "Du befindest Dich hier auf der Spitze des Turms. Rund um Dich "
      "befinden sich lauter Fenster. In der Mitte des Raumes ist eine grosse "
      "Vorrichtung, in der sich sehr viel Feuerholz befindet. Sie dient dazu, "
      "den Schiffen, bei Dunkelheit, den Weg zur Insel zu weisen. Weiters "
      "erkennst Du einen kleinen Holztisch und einen Schemel. Dort ist es dem "
      "Waechter des Leuchtturms moeglich, eine kleine Pause zu machen.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//-------------Details Anfang--------------------------------


  AddDetail( ({"kammer","spitze","raum","raumes","turms","turm","leuchtturms"}),
		  QueryProp(P_INT_LONG) );

  AddDetail( ({"fenster","scheiben","rauch"}), 
            "Die Fenster befinden sich rund um Dich. Es befinden sich keine "
	    "Scheiben in ihnen, damit der Rauch abziehen kann.");
  
  AddDetail( ({"vorrichtung","mitte"}),
	    "In der Mitte des Raumes befindet sich eine Vorrichtung, um den "
	    "Schiffen bei Dunkelheit den Weg zu weisen.");

  AddDetail( ({"schiffe","dunkelheit","weg","schiffen","insel"}), 
            "Viele Schiffe besuchen die Insel. Damit sie auch bei Dunkelheit "
	    "wohlbehalten anlegen koennen, wird ihnen der Weg geleuchtet.");
  
  AddDetail( ({"feuerstelle","stelle","feuer","feuerholz","holz"}), 
	     "Wenn das Feuer in der Feuerstelle entfacht wird, brennt es so "
	     "lichterloh, das man es meilenweit sehen kann.");

  AddDetail( ({"wand","decke","boden","waende","marmor"}), 
            "Dieser Raum besteht aus weissem Marmor.");
  
  AddDetail( ({"leuchtturm","waechter","pause"}), 
	    "Der Waechter des Leuchtturms benoetigt auch ab und zu eine kleine "            "Pause.");

  AddDetail( ({"schemel","holztisch","tisch"}), 
            "Dort ist es dem Waechter gestattet, sich hinzusetzen und sich "
	    "etwas auszuruhen.");

 AddDetail( ({"luft","lungen"}), 
            "Frische Luft erfuellt Deine Lungen.");

 AddDetail( ({"meer","klippe"}), 
            "Weit unter Dir befindet befindet sich das Meer.");

 AddDetail( ({"wunder"}),
	    "Das Meer ist so maerchenhaft, dass Du Dich wunderst, dass "
	    "niemand im Meer badet.");
 
 

   
 AddSmell(DEFAULT_SMELL, "Die frische Luft stroemt in Deine Lungen. Sie ist "
		 "etwas salzig, aber das ist kein Wunder wenn das Meer sich "
		 "genau unter der Klippe befindet.");
 
 AddSmell( ({"luft"}),
	   "Die Luft ist erfrischend und klar.");

   
 AddSound(DEFAULT_SOUND, "Das Meer rauscht leise vor sich hin.");
	   

 AddSound( ({"rauschen","meer"}),
	  "Das Meer rauscht sehr leise.");

//----------Details Ende--------------------------------


  AddExit( "unten", "./turm6_4");
}  
   
