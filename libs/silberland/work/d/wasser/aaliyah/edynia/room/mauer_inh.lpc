// von Aaliyah
// 29.01.2005
// 
// Inherit fuer Mauerraeume
 
inherit "std/room";
#include "../def.h"

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Burgmauer der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du stehst hier auf der Burgmauer der Amazonenburg. Von hier aus "
	"hast Du einen hervorragenden Ausblick ueber die gesamte Insel. "
	"Dir wird etwas schwindelig als Du durch die Burgzinnen in den Abgrund "
	"blickst. Ausserdem erkennst Du noch einige seltsame Geraete, die in "
	"jeder Ecke der Burgmauer aufgestellt wurden. Der Himmel ober Dir ist "
	"strahlend blau, sodass Du einfach fuer ein paar Minuten inne haelst "
	"und die Aussicht geniesst.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//------Details Anfang------------

  AddDetail( "burgmauer", QueryProp(P_INT_LONG) );
  
  AddDetail( ({"amazonenburg","ueberblick"}),
	   "Von hier aus hast Du Ueberblick ueber die ganze Burg.");

  AddDetail( ({"burg"}),
	   "Du siehst genau in den Burghof.");

  AddDetail( ({"burghof","hof","hofes"}),
	   "Der Burghof ist eine wunderschoene gruene Anlage mit vielen "
	   "Blumen und einem grossem Brunnen. Du siehst einige Dienerinnen "
	   "eilig ueber den Hof huschen und auch ein paar Amazonen, die sich "
	   "gerade im Speerwurf ueben. Im letzten Winkel des Hofes erkennst "
	   "Du eine Amazone, die gerade ein Pferd sattelt.");

  AddDetail( ({"blumen","anlage"}),
	   "Viele Blumen wachsen auf der gruenen Anlage.");

  AddDetail( ({"amazonen","speerwurf"}),
	   "Einige Amazonen ueben sich gerade im Speerwurf.");

  AddDetail( ({"dienerinnen"}),
	   "Unzaehlige Dienerinnen huschen emsig ueber den Hof.");

  AddDetail( ({"amazone","winkel","pferde"}),
	   "Im letzten Winkel wird ein Pferd von einer Amazone gesattelt.");

  AddDetail( ({"pferd","schimmel"}),
	   "Ein praechtiger weisser Schimmel.");

  AddDetail( ({"ecke","geraete","steinschleuder","geraet"}),
	   "In jeder Ecke der Burgmauer befindet sich ein Geraet. Es ist "
	   "einfach eine grosse Steinschleuder und dient zur Verteidigung "
	   "der Burg.");

  AddDetail( ({"verteidigung"}),
	   "Die Amazonen koennen sich sehr gut verteidigen. Sie kaempfen "
	   "mutig mit ihren Speeren gegen alle ihre Gegner.");

  AddDetail( ({"speeren","gegner","speere"}),
	   "Die Amazonen tragen zwar auch ein Schild, aber im Gegensatz "
	   "zu den Paladinen benutzen sie es eher selten.");

  AddDetail( ({"schild","paladinen","paladine","gegensatz"}),
	   "Die Paladine benutzen ihr Schild um sich dahinter zu verstecken.");

  AddDetail( ({"brunnen"}),
	   "Der Brunnen dient der Wasserversorgung der Amazonen.");

  AddDetail( ({"wasserversorgung"}),
	   "Die Amazonen und ihre Pferde brauchen schliesslich auch Wasser.");


  AddDetail( ({"abgrund"}),
	   "Unter Dir gaehnt tiefer Abgrund. Wenn Du hier hinunter fallen "
	   "wuerdest, waere es Dein sicherer Tod.");

  AddDetail( ({"tod"}),
	   "Du wuerdest gewiss an den Klippen zerschellen.");

  AddDetail( ({"klippen"}),
	   "Die Klippen enden im Meer.");

  AddDetail( ({"minuten","zeit","bedeutung"}),
	   "Hier hat die Zeit eine ganz andere Bedeutung.");

  AddDetail( ({"insel"}),
	   "Du hast von hier einen wunderbaren Ausblick ueber die gesamte "
	   "Insel.");

  AddDetail( ({"ausblick"}),
	   "Die Aussicht ist ueberwaeltigend. Du siehst die Gaerten von Edynia "           "und die unendlichen Weiten des Meeres.");

  AddDetail( ({"aussicht","gaerten","edynia","blumenmeer"}),
	   "Die Gaerten sind ein einziges buntes Blumenmeer. Zwischendurch "
	   "erkennst Du einige Einhoerner, die durch die Wiesen galloppieren.");

  AddDetail( ({"wiesen","einhoerner"}),
	   "Einige Einhoerner galloppieren ueber die Wiesen.");

  AddDetail( ({"blumenmeer","wiesen","wiese"}),
	   "Die Gaerten sind einfach maerchenhaft.");

  AddDetail( ({"meeres","meer","weiten"}),
	   "Das Meer scheint unendlich zu sein. Einige Wellen glitzern "
	   "im Sonnenlicht und Dir scheint es, als wuerde sich etwas in den "
	   "Wellen bewegen.");

  AddDetail( ({"sonnenlicht","wellen"}),
	   "Das Sonnenlicht laesst die Wellen glitzern.");

  AddDetail( ({"himmel"}),
	   "Der Himmel ist strahlend blau.");

  AddDetail( ({"etwas"}),
	   "Dir kommt es so vor als wuerden sich unzaehlige Einhoerner in den "
	   "Wellen befinden.");

  AddDetail( ({"windhauch","haare"}),
	   "Ein sanfter Windhauch streift Deine Haare.");

  AddDetail( ({"dienerin"}),
	   "Die Dienerin ist schon wieder verschwunden.");

  AddDetail( ({"sonne","haut"}),
	   "Die Sonne erwaermt Deine Haut.");


  AddDetail( ({"taube","brief"}),
	   "Die Taube bringt der Amazone einen Brief.");

  AddDetail( ({"burgzinnen"}),
	   "Durch die Burgzinnen erkennst Du das Meer.");

  AddDetail( ({"kopf","boden","wasser","wind","wirkung"}),
	    "Die Wirkung von Wind und Wasser laesst Dich schwindlig "
	    "werden. Du stolperst und Dein Kopf knallt auf den Boden.");



  AddRoomMessage( ({"Ein sanfter Windhauch streicht Dir durch die Haare.\n",
	           "Du hoerst ein paar Amazonen lachen.\n",
		   "Eine Dienerin eilt an Dir vorbei.\n",
		   "Eine weisse Taube bringt einer Amazone einen Brief.\n",
		   "Die Sonne ist angenehm warm auf Deiner Haut.\n"}), 80);
 

   
  AddSmell(DEFAULT_SMELL, "Hier oben ist starker Wind. Mit ihm kommen die "
		          "seltsamsten Gerueche .");
  
  AddSmell( ({"gerueche"}),
	   "Meeresluft, Bluetenduft und verschiedene Kraeuter kannst Du hier "
	   "riechen.");

  
  AddSmell( ({"bluetenduft","duft","blumen"}),
	   "Der Wind traegt den Duft der Blumen von den Gaerten bis hierher.");

  
  AddSmell( ({"kraeuter","geruch"}),
	   "Wuerziger Geruch wird von irgendwo hergeweht.");


    
  AddSound(DEFAULT_SOUND, "Du hoerst das Kreischen der Moewen und das sanfte "
		  "Rauschen der Wellen.");

  AddSound( ({"lachen","amazonen"}),
	   "Du hoerst einige Amazonen lachen.");
	   

  AddSound( ({"kreischen","moewen"}),
	   "Die Moewen kreischen hoch ueber Deinem Kopf.");

  AddSound( ({"rauschen","wellen"}),
           "Die Wellen rauschen leise und stroemen eine beruhigende Wirkung "

	   "auf Dich aus.");
}









 








 
   
