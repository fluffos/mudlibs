// von Aaliyah
// 15.02.2005
// 
// Waffenkammer in der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Waffenkammer der Amazonenburg");
  SetProp( P_INT_LONG,
	"In stehst hier in der Waffenkammer der Amazonenburg. An den Waenden "
	"befinden sich lauter Regale, die mit Speeren aller Art gefuellt sind. "        "Weiters erkennst Du einige Vorrichtungen, an denen viele Schilder "
	"haengen. In der Mitte des Raumes befindet sich eine grosse Theke. "
	"Ein praechtiger Speer und einige Seidentuecher liegen darauf. "
	"Eine kleine Tuer fuehrt nach Westen, in die Schmiede der Burg. Und "
	"im Norden gelangst Du wieder zum Burghof zurueck.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);

//------------------Details Anfang---------------------------------

  AddDetail( ({"waffenkammer","raum","raumes","kammer"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"amazonenburg","burg","ort"}), 
            "Du befindest Dich hier in der Amazonenburg. Es ist der Ort wo "
	    "sich die Maechtigsten aller Frauen zu einem Bund schliessen.");
 AddDetail( ({"blumenvasen","vasen","lilien","orchideen"}), 
            "Die Vasen sind gefuellt mit schoenen Lilien und Orchideen.");

  AddDetail( ({"frauen","bund","maechtigsten","amazonen","kriegerinnen"}), 
            "Die Amazonen sind gefuerchtete Kriegerinnen, die keine Furcht "
	    "kennen und mit Mut und Stolz in den Kampf ziehen.");

  AddDetail( ({"jagdspiesse","spiesse"}), 
            "Die Jagdspiesse werden fuer die Jagd benutzt. Schliesslich "
	    "muss doch auch fuer ihr Fleisch gesorgt werden. Und ein leckerer "
	    "Wildschweinbraten springt nicht von selbst aufs Teller.");

  AddDetail( ({"stolz","mut","furcht","kampf","geschoepfe"}), 
            "Die Amazonen sind stolze Geschoepfe und kaempfen furchtlos.");

  AddDetail( ({"marmor","waenden","waende","wand"}), 
            "Die Waende bestehen aus weissem Marmor. Lauter Regale sind an "
	    "die Waende gelehnt.");
  
  AddDetail( ({"regale","regalen","regal"}), 
            "In den Regalen befinden sich viele Speere aller Art.");

  AddDetail( ({"art","speeren","speere"}), 
            "Du siehst viele Lanzen, Wurfspeere, Jagdspiesse und eine Pike.");

  AddDetail( ({"jagdspiesse","spiesse"}), 
            "Die Jagdspiesse werden fuer die Jagd benutzt. Schliesslich "
	    "muss doch auch fuer ihr Fleisch gesorgt werden. Und ein leckerer "
	    "Wildschweinbraten springt nicht von selbst aufs Teller.");

  AddDetail( ({"braten","wildschweinbraten","fleisch","teller","hunger"}), 
            "Du bekommst einen riesigen Hunger.");


  AddDetail( ({"pike","fusskaempfern","fusskaempfer","reiter","kaempfer"}), 
            "Die Pike ist eine lange Lanze und wird von Fusskaempfern gegen "
	    "Reiter benuetzt.");

  AddDetail( ({"wurfspeere","lanzen"}), 
            "Viele praechtige Lanzen und Wurfspeere befinden sich in den "
	    "Regalen.");


  AddDetail( ({"vorrichtungen","schilder","rundschilder"}), 
            "Viele Rundschilder haengen an den Vorrichtungen.");

  AddDetail( ({"speer","theke","mitte"}), 
            "In der Mitte des Raumes befindet sich eine Theke, auf der ein "
	    "praechtiger Speer und einige Seidentuecher liegen.");

  AddDetail( ({"seidentuecher","tuecher","tuechern"}), 
            "Mit den Tuechern werden die Speere gesaeubert und poliert.");

  AddDetail( ({"koeniginnenlanze","speer","lanze","hinblick"}), 
            "Beim genaueren Hinblick entpuppt sich der praechtige Speer als "
	    "Koeniginnenlanze. Die Lanze wurden anscheinend gerade frisch "
	    "poliert und glaenzt.");

  
  AddDetail( ({"westen","tuer","schmiede"}), 
            "Durch die Tuer gelangst Du in die Schmiede.");

  
  AddDetail( ({"burghof","norden","hof"}), 
            "Im Norden gelangst Du zum Burghof zurueck.");

  
  AddDetail( ({"felle","boden","fellen","platten","marmorplatten"}), 
            "Der Boden besteht aus weissen Marmorplatten und wird fast "
	    "vollkommen von Fellen bedeckt.");

  
  AddDetail( ({"decke","fuesse"}), 
            "Die Decke ist so langweilig, da schlafen Dir die Fuesse ein.");

  AddDetail( ({"blumenduft","duft","blumen","gemisch","rauch"}), 
            "Riechen!");

  AddDetail( ({"amazone"}), 
            "Die Amazone hat sich nur einen Speer geholt und ist schon wieder "
	    "verschwunden.");

  AddDetail( ({"zischen","ohren"}), 
            "Wozu hast Du eigentlich Deine Ohren?");

  AddDetail( ({"jagd","meister"}), 
            "Die Amazonen sind Meister der Jagd.");




 AddSmell(DEFAULT_SMELL, "Du riechst hier ein Gemisch von Rauch und "
		 "Blumenduft.");
 
  AddSmell( ({"rauch"}),
	   "Beissender Rauch stroemt aus der Schmiede.");

  AddSmell( ({"blumenduft","duft"}),
	   "Der Duft der Blumen, stroemt vom Burghof herein.");


  AddSmell( ({"gemisch"}),
	   "Ein Gemisch von Rauch und Blumenduft. Irgendwie riecht es schon "
	   "ein kleines bisschen seltsam.");


 AddSound(DEFAULT_SOUND, "Du hoerst hier lediglich ein leises Zischen aus "
		 "der Schmiede nebenan.");
	   

  AddSound( ({"schmiede","zischen"}),
	  "Wenn Du wissen moechtest, was da so zischt, musst Du in die "
	  "Schmiede gehen und nachschauen.");

 AddRoomMessage( ({"Etwas Rauch stroemt aus der Schmiede herein.\n",
	          "Eine Amazone nimmt einen Speer aus dem Regal.\n",
         	  "Du wuerdest gerne die Koeniginnenlanze nehmen.\n"}), 80);


//--------------Details Ende--------------------------------
  AddExit( "norden", "./burg6");
  AddExit( "westen", "./schmiede");
  AddExit( "osten", "/gilden/amazonen/room/laden");
  AddItem(NPC "waffenmeisterin.lpc", REFRESH_DESTRUCT);
  
}  
   
