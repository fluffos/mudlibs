// In den Stallungen
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In den Stallungen");
  SetProp( P_INT_LONG,
	"Du stehst in den Stallungen der Amazonen. Hier werden ihre Pferde "
	"versorgt und untergebracht. Du erkennst viele kleine Boxen, in denen "
	"sich jeweils ein Pferd befindet. An den Waenden befinden sich ein "
	"paar Halterungen fuer das Zaumzeug und die Saettel. Einige Saecke "
	"sind hier an die Wand gelehnt. Du bewunderst die Sauberkeit der "
	"Stallungen. Kein bisschen Stroh liegt am Boden. Ueber eine schmale "
	"Treppe gelangst Du auf die Burgmauer und nach Sueden kannst Du wieder "
	"auf den Burghof gehen.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//-------Detail Anfang-----------

  AddDetail( ({"stallungen","staelle"}), 
            "Dabei sein ist alles, und Du bist mittendrin!");
  
  AddDetail( ({"amazonen","sorgfalt"}), 
            "Die Amazonen hegen und pflegen ihre Pferde mit groesster Sorgfalt.");
  AddDetail( ({"pferde","tiere"}), 
            "Es sind lauter wunderschoene Tiere.");

  AddDetail( ({"saettel","zaumzeug","halterungen","zaumzeugs","sattel"}), 
            "Die Halterungen dienen zur Aufbewahrung des Zaumzeugs und der "
	    "Saettel. Ohne sie wuerde hier nicht so eine Ordnung herrschen.");

  AddDetail( ({"ordnung","aufbewahrung","sachen"}), 
            "Hast Du Ordnung in Deinen Sachen?");

  AddDetail( ({"pferd","boxen","pferden"}), 
            "In jede der Boxen befindet sich ein Pferd. Und ausserdem noch "
	    "ein Trog mit Futter und ein Kuebel mit klarem Wasser.");

  AddDetail( ({"saecke","futter"}), 
            "Da ist nur das Futter der Tiere drin.");

  AddDetail( ({"sauberkeit"}), 
            "Die ganzen Stallungen sind peinlich sauber.");

  AddDetail( ({"boden"}), 
            "Der gesamte Boden ausserhalb der Boxen besteht aus weissen "
	    "Kieselsteinen. Die Boxen wurden allerdings mit Saegespaenen und "
	    "Stroh ausgelegt um es den Tieren so gemuetlich wie moeglich zu "
	    "machen.");

  AddDetail( ({"kieselsteine","kieselsteinen"}), 
            "Der Boden ausserhalb der Boxen besteht aus weissen Kieselsteinen.");

  AddDetail( ({"saegespaenen","saegespaene"}), 
            "Die Boxen wurden mit Saegespaenen gepolstert um es den Pferden "
	    "so gemuetlich wie moeglich zu machen.");

  AddDetail( ({"stroh"}), 
            "Stroh gibt es nur innerhalb der Boxen.");

  AddDetail( ({"trog"}), 
            "Auch Pferde wollen essen.");

  AddDetail( ({"kuebel","wasser"}), 
            "Die Pferde bekommen sauberes Wasser zum trinken.");

  AddDetail( ({"wand","waenden","waende"}), 
            "An den Waenden erkennst Du lediglich einige Halterungen.");

  AddDetail( ({"decke"}), 
            "Die Decke besteht aus einem Mosaik von Edelsteinen.");

  AddDetail( ({"mosaik","edelsteine","edelsteinen"}), 
            "Viele Edelsteine wurden zu einem Mosaik zusammengefuegt.");

  AddDetail( ({"treppe","burgmauer","nordostoben"}), 
            "Eine schmale Treppe fuehrt nach Nordostoben auf die Burgmauer.");

  AddDetail( ({"sueden","burghof","hof"}), 
            "Nach Sueden gelangst Du wieder auf den Hof zurueck.");

  AddDetail( ({"geruch","koerpergeruch","haare"}), 
            "Alles kannst Du nicht untersuchen.");

  AddDetail( ({"halterung"}), 
            "Die Halterung ist fuer die Saettel bestimmt.");

  AddDetail( ({"maul","pferdes"}), 
            "Das Maul des Pferdes ist so weich das Du es kuessen musst.");

  AddDetail( ({"dienerin","dienerinnen"}), 
            "Hier wuseln viele Dienerinnen herum.");




  AddSmell(DEFAULT_SMELL, "Hier riecht es nach frischem Stroh und nach dem "
		  "guten Koerpergeruch der Pferde.");

  AddSmell( ({"stroh","haare"}),
	   "Das Stroh duftet so wie Deine Haare.");

  AddSmell( ({"koerpergeruch","pferde","geruch"}),
	   "Die Pferde haben einen angenehmen Koerpergeruch.");
      
  AddSound(DEFAULT_SOUND, "Du hoerst das Schnauben der Pferde. Manchmal "
		  "wiehert eines von ihnen neugierig auf.");
	   

  AddSound( ({"schnauben"}),
	  "Ja, die Pferde schnauben auch.");
  
  AddSound( ({"pferde","wiehern","pferd"}),
	  "Manchmal wiehert ein Pferd neugierig auf.");

  AddRoomMessage( ({"Ein Pferd wiehert neugierig auf.\n",
	          "Eine Dienerin beginnt die Pferde zu fuettern.\n",
		  "Ein Pferd stubst Dich mit seinem Maul an.\n",
		  "Eine Dienerin nimmt einen Sattel von der Halterung.\n",
		  "Eine Dienerin streichelt zaertlich ein Pferd.\n",
		  "Eine Dienerin putzt die Saettel.\n"}), 80);

//-------Detail Ende-------------

  AddExit( "nordostoben", "./mauer7");
  AddExit( "sueden", "./burg8");

  AddItem(NPC "lipizzaner", REFRESH_DESTRUCT);
  AddItem(NPC "amazone_wache", REFRESH_DESTRUCT);
  
}  
   
