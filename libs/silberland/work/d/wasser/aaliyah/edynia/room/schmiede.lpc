// von Aaliyah
// 29.01.2005
// 
// Brunnen in der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Schmiede der Amazonenburg");
  SetProp( P_INT_LONG,
    "Du stehst in der Schmiede der Amazonenburg. Hier werden alle Waffen "
    "und Ruestungen erzeugt und ausgebessert, die die Amazonen benutzen. "
    "An der Westwand befindet sich ein grosser Schmiedeofen und davor ein "
    "maechtiger Amboss. Eine gewaltige Hitze geht von den Feuer aus. "
    "An der Nordwand steht ein Wasserbecken und ein riesiger Stapel mit "
    "Eisenbarren und Kohlesaecken. An der Suedwand sind viele Werkzeuge "
    "an der Wand aufgehaengt. Nach Osten kommt man zurueck in die "
    "Waffenkammer.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);

  AddDetail( ({"boden"}),
      "Der Boden ist schwarz vom Russ des Schmiedefeuers.");
 
  AddDetail( ({"waende"}),
      "Die Waende sind schwarz vom Russ des Schmiedefeuers.");
 
  AddDetail( ({"decke"}),
      "Die Decke ist schwarz vom Russ des Schmiedefeuers.");
 
  AddDetail( ({"wand"}),
      "Welche Wand meinst Du? Die Nordwand, die Westwand, die Suedwand "
      "oder die Ostwand?");
 
  AddDetail( ({"nordwand", "norden"}),
      "An der Nordwand steht ein Wasserbecken, das zum Abkuehlen des heissen "
      "Metalls benutzt wird. Daneben befindet sich ein Stapel mit Eisenbarren "
      "und Kohlesaecken.");
 
  AddDetail( ({"westwand", "westen"}),
      "Die gesamte Westwand wird von dem riesigen Schmiedeofen eingenommen.");
 
  AddDetail( ({"suedwand", "sueden"}),
      "An der Suedwand sind viele verschiedene Werkzeuge an der Wand "
      "aufgehaengt.");
 
  AddDetail( ({"ostwand", "tuer"}),
      "In der Ostwand befindet sich eine Tuer, die zur Waffenkammer fuehrt.");
 
  AddDetail( ({"amazonenburg", "burg"}),
      "Du befindest Dich in der Burg der Amazonen.");
 
  AddDetail( ({"amazonen", "amazone"}),
      "Die Amazonen leben auf dieser Burg.");
 
  AddDetail( ({"schmiede", "raum"}), QueryProp(P_INT_LONG));
 
  AddDetail( ({"waffen", "waffe"}),
      "In dieser Schmiede werden alle Waffen erzeugt, die die Amazonen "
      "verwenden, hauptsaechlich Speere.");

  AddDetail( ({"metallstueck","sicht","rauch","auge","augen"}), 
            "Etwas Rauch brennt in Deinen Augen.");
 
  AddDetail( ({"ruestungen", "reustung"}),
      "In dieser Schmiede werden alle Ruestungen erzeugt, die die Amazonen "
      "verwenden. Diese bestehen meist aus anderem Metall als die Waffen.");
 
  AddDetail( ({"schmiedeofen", "ofen"}),
      "Im Schmiedeofen brennt ein sehr heisses Feuer. Die Hitze verbreitet "
      "sich im ganzen Raum.");
 
  AddDetail( ({"amboss"}),
      "Der maechtige Amboss steht vor dem Schmiedefeuer. Darauf wird das "
      "Eisen so lange gehaemmert, bis es zu hartem Stahl wird.");
 
  AddDetail( ({"hitze"}),
      "Die Hitze ist fast unertraeglich. Kleine Schweissperlen tropfen von "
      "Deiner Stirn zu Boden.");
 
  AddDetail( ({"feuer", "schmiedefeuer"}),
      "Das Schmiedefeuer ist sehr heiss. Es wird ja auch staendig mit weiteren "
      "Kohlen gefuettert.");
 
  AddDetail( ({"wasserbecken", "becken", "abkuehlen"}),
      "Das Wasserbecken wird zum Abkuehlen des heissen Metalls verwendet. "
      "Es zischt jedes mal sehr laut und eine Dampfwolke steigt dabei auf.");
 
  AddDetail( ({"wasser"}),
      "Das Wasser im Becken ist fast schwarz durch den Russ, der beim "
      "Abkuehlen des Metalls ins Wasser gleangt.");
 
  AddDetail( ({"stapel"}),
      "Der Stapel besteht aus Eisenbarren und Kohlesaecke.");
 
  AddDetail( ({"eisenbarren", "barren"}),
      "Aus diesen Eisenbarren werden sicher bald schoene Waffen und Ruestungen "
      "geschmiedet.");
 
  AddDetail( ({"eisen"}),
      "Eisen wird so lange geschmiedet, bis es zu Stahl wird.");
 
  AddDetail( ({"kohlesaecke", "saecke", "kohlesack", "sack"}),
      "Die Saecke sind mit Kohlen gefuellt, die fuer das Schmiedefeuer "
      "benoetigt werden.");
 
  AddDetail( ({"werkzeuge"}),
      "An der Suedwand haengen viele Werkzeuge, vor allem Haemmer und Zangen.");
 
  AddDetail( ({"werkzeug"}),
      "Vor allem Hammer und Zange.");

  AddDetail( ({"waffenkammer", "osten"}),
      "Zur Waffenkammer gehts nach Osten.");
 
  AddDetail( ({"speere", "speer"}),
      "Jeder Speer, den eine Amazone verwendet, wurde hier geschmiedet. "
      "Zumindest die Speerspitze, der Schaft ist ja meist aus Holz.");

  AddDetail( ({"russ", "schwarz"}),
      "Hier ist alles schwarz vom Russ des Feuers.");

  AddDetail( ({"metall"}),
      "Hier wird vor allem Eisen und Stahl verwendet, aber Du siehst auch "
      "Bronze und Kupfer.");

  AddDetail( ({"stahl"}),
      "Stahl entsteht durch langes Schmieden von Eisen.");

  AddDetail( ({"bronze"}),
      "Bronze ist eine Legierung aus Kupfer und Zinn und wird hier nur "
      "fuer Ruestungen verwendet.");

  AddDetail( ({"kupfer"}),
      "Kupfer wird hier nur fuer Ruestungen verwendet.");

  AddDetail( ({"schweissperlen", "perlen", "schweiss", "poren"}),
      "Das Hitze des Feuers treibt Dir den Schweiss aus den Poren.");

  AddDetail( ({"kohle", "kohlen"}),
      "Die Kohlen werden von weit her, aus dem Koehlerlager.");

  AddDetail( ({"dampf", "dampfwolke", "wolke"}),
      "Das Abkuehlen des Metalls erzeugt jedesmal eine Dampfwolke. "
      "Darum ist es hier so feucht.");

  AddDetail( ({"stirn"}),
      "Deine Stirn ist schweissueberstroemt.");

  AddDetail( ({"haemmer", "hammer"}),
      "Mit einem Hammer kann man gut das Eisen schmieden.");

  AddDetail( ({"zangen", "zange"}),
      "Eine Zange braucht man, um sich nicht am heissen Metall die Finger "
      "zu verbrennen.");

  AddDetail( ({"speerspitze", "speerspitzen", "spitze", "spitzen"}),
      "Hier werden die Spitzen fuer die Speere der Amazonen geschmiedet.");

  AddDetail( ({"schaft", "speerschaft"}),
      "Der Speerschaft besteht meist aus Holz, damit der Speer nicht zu "
      "schwer wird.");

  AddDetail( ({"holz"}),
      "Das Holz fuer die Speere stammt hauptsaechlich aus dem Silberwald, "
      "weil es auf Edynia keine Waelder gibt.");

  AddDetail( ({"koehlerlager", "lager", "koehler", "huegelland"}),
      "Die Koehler im Huegelland erzeugen die Holzkohle, die hier verwendet "
      "wird.");

  AddDetail( ({"holzkohle", "holkohlen"}),
      "Bei der Kohle handelt es sich um Holzkohle.");

  AddDetail( ({"wald", "waelder"}),
      "Auf dieser Insel gibt es kaum Holz, darum wird es aus dem Silberwald "
      "importiert.");

  AddDetail( ({"silberwald", "holzfaeller"}),
      "Die Holzfaeller im Silberwald besorgen das Holz, das hier fuer die "
      "Speere verwendet wird.");

  AddDetail( ({"finger"}),
      "Wenn man das heisse Metall mit den Fingern beruehrt, verbrennen sie "
      "sicher sofort.");

  AddDetail( ({"insel", "amazoneninsel", "edynia"}),
      "Du bist auf Edynia, der Amazoneninsel.");

  AddDetail( ({"legierung", "zinn"}),
      "Wenn man Kupfer und Zinn vermischt, bekommt man Bronze.");
 

  AddSound( ({DEFAULT_SOUND, "laerm"}),
      "Es ist sehr laut hier. Du hoerst vor allem ein Haemmern und Zischen. "
      "Ein richtiger Laerm.");
  
  AddSound( ({"haemmern", "metall", "schmieden"}),
      "Das Haemmern kommt vom Schmieden des Metalls.");

  AddSound( ({"zischen", "abkuehlen", "wasser"}),
      "Das Zischen kommt vom Abkuehlen des heissen Metalls im Wasser.");


  AddSmell( ({DEFAULT_SMELL, "schmiedegeruch", "geruch"}),
      "Es riecht nach Rauch und Metall, ein typischer Schmiedegeruch.");

  AddSmell( ({"rauch", "metall"}),
      "Typischer Schmiedegeruch.");
  
  AddRoomMessage( 
      ({"Das Haemmern ist hier sehr laut.\n",
        "Der Dampf und Russ truebt Deine Sicht.\n",
        "Es zischt sehr laut, als ein heisses Metallstueck im Wasser abgekuehlt wird.\n",
        "Der Laerm hier ist fast unertraeglich.\n",
        "Das Schmiedefeuer strahlt eine beinahe unertraegliche Hitze aus.\n",
 	"Die Hitze treibt Dir den Schweiss auf die Stirn.\n"}), 80);
  
  AddItem(NPC "schmiedin.lpc", REFRESH_DESTRUCT);
  AddExit( "osten", "./waffen");
  AddCmd( ({ "schmied", "schmiede" }), "c_schmieden");

}  
   int c_schmieden(string str)
   {
   notify_fail(BS("Was moechtest Du hier schmieden?"));
   if(!((str == "speerspitze") || (str == "spitze")) ||
     (str == "spitze aus silber") || ((str == "speerspitze aus silber")))
   {
     return 0;
   }
   if(!present("QUEST-SILBERSTUECK", TP))
   {
    
   write(BS("Du hast leider nicht das passende Material dabei."));
   tell_room(ENV(TP), TPN+" seufzt.\n", ({TP}));

   return -1;
   
   }
   else
   {
  write(BS("Du schmiedest Dir eine schoene Speerspitze. Schweisstreibend "
	   "diese Arbeit. Du bist froh kein Schmied zu sein."));
  tell_room(ENV(TP), TPN+ " schmiedet eine Speerspitze.\n", ({TP}));
  clone_object(OBJ "spitze")->move(TP, M_NOCHECK);
  present("QUEST-SILBERSTUECK", TP)->remove();
  return 1;
 }
   }
