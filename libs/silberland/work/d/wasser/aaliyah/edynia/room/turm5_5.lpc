// Turm der Amazonenburg
 
#include "../def.h"
inherit  "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Spitze eines Turmes der Amazonenburg");
  SetProp(P_INT_LONG,
      "Du befindest Dich hier auf der Turmspitze der Amazonenburg. Der Raum "
      "besitzt keine Decke und die Waende ragen in Form von grossen Zacken "
      "empor. Da hier alles aus purem Gold besteht, erweckt es den Eindruck, "
      "dass Du in einer gewaltigen Krone bestehst. Verstaerkt wird das noch "
      "durch die vielen Verzierungen aus Edelsteinen, die in regelmaessigen "
      "Abstaenden in Waenden und Boden angebracht wurden. In der der Mitte des "
      "Raumes befindet sich eine Schlafstelle. ");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//-------------Details Anfang------------------------

 AddDetail( ({"turmspitze","spitze","turm","raum","raumes"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"form","zacken","waende","wand","waenden"}), 
            "Die Waende haben die Form von grossen Zacken.");

   AddDetail( ({"decke"}), 
            "Ober Dir befindet sich nur der strahlendblaue Himmel.");

   AddDetail( ({"himmel"}), 
            "Der Himmel ist strahlendblau. Lediglich eine kleine Wolke kannst "
	    "Du erkennen.");

   AddDetail( ({"wolke","tuermen","tuerme"}), 
            "Die Wolke scheint den Tuermen so nah zu sein.");
 
   
   AddDetail( ({"eindruck","krone"}), 
            "Du hast den Eindruck, Dich hier in einer riesigen Krone zu "
	    "befinden.");
  
   
   AddDetail( ({"gold","boden"}), 
            "Alles besteht hier aus purem Gold.");

   AddDetail( ({"amazonenburg","burg","amazonenfestung","festung"}), 
            "Du befindest Dich hier auf der Amazonenfestung.");
   
   AddDetail( ({"edelsteine","verzierungen","edelsteinen","abstaenden",
		"abstaende"}), 
            "Viele Edelsteine zieren den Raum.");

   
   AddDetail( ({"stelle","schlafstelle","mitte"}), 
            "Auf der Schlafstelle ruht sich der Flugdrache aus, wenn er "
	    "nicht gerade Amazonen durch die Gegend fliegt.");

   
   AddDetail( ({"amazonen","flugdrache","gegend","drache"}), 
            "Wenn der Flugdrache nicht da ist, fliegt er gewiss Amazonen "
	    "durch die Gegend.");

   
   AddDetail( ({"ohren","luft"}), 
            "Die Luft pfeift um Deine Ohren.");

   AddDetail( ({"windhauch","haare","wind"}), 
            "Deine Haare sind vom Wind schon ganz zerzaust.");
  
 
 AddSmell(DEFAULT_SMELL, "Die Luft hier oben ist sehr erfrischend und klar.");
 
  AddSmell( ({"luft"}),
	   "Du atmest die frische Luft ein.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur die Luft um Deine Ohren "
		  "pfeifen.");
	   

  AddSound( ({"luft","pfeifen"}),
	  "Die Luft pfeift um Deine Ohren.");

   AddRoomMessage( ({"Die Luft pfeift um Deine Ohren.\n",
	          "Die Edelsteine funkeln.\n",
		  "Ein Windhauch streift Dir durch die Haare.\n"}), 80);

//--------------Details Ende---------------------------------------

   
  AddExit( "unten", "./turm5_4");
  AddItem(NPC "flugdrache.lpc", REFRESH_DESTRUCT);
  
}  
   
