//
 
inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einer steilen Klippe");
  SetProp( P_INT_LONG,
	"Du stehst hier auf einem Weg in den Klippen. Er fuehrt steil nach oben "
       	"hin zur Burg. Hier ist alles sehr felsig. Am Boden erkennst Du viele "
	"Wagen und Pferdespuren. Es ist ein Zeichen dafuer das hier ein reger "
	"Betrieb sein muss. Rechts und links faellt die Klippe steil nach unten "
	"ins Meer hinein. Der Abgrund neben Dir ist so tief, das Du panische "
	"Hoehenangst bekommst und Dich etwas weiter in die Mitte begibst.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "weg", QueryProp(P_INT_LONG) );

  AddDetail( ({"zeichen","betrieb"}),
	   "Hier ist reger Betrieb.");

  AddDetail( ({"klippen","klippe"}), 
            "Die Klippen fallen steil nach unten ins Meer hinein.");

  AddDetail( ({"meer"}), 
            "Das Meer liegt sehr weit unter Dir und scheint hier aeusserst "
	    "tief zu sein. Genau sagen kannst Du es nicht. Du schliesst es "
	    "einfach aus der tiefblauen Farbe.");

  AddDetail( ({"farbe"}), 
            "Das Meer hat eine tiefblaue Farbe.");

  AddDetail( ({"burg","sicht"}), 
            "Du kannst die Burg hier noch nicht erkennen, da Dir eine grosse "
	    "Klippe die Sicht versperrt.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist hier sehr felsig. Einige Wagen und Pferdespuren "
	    "befinden sich auf ihm.");


  AddDetail( ({"pferdespuren","wagenspuren","spuren","spur","pferdespur",
			  "wagenspur"}), 
            "Viele Wesen scheinen die Burg zu besuchen denn die Spuren deuten "
	    "auf einen regen Betrieb hin.");

  AddDetail( ({"wagen"}),
	     "Vorhin ist gerade ein Wagen vorbeigefahren.");
 
  
  AddDetail( ({"rechts","links"}), 
            "Rechts und links befindet sich der steile Abgrund.");

  AddDetail( ({"abgrund"}), 
            "Der Abgrund faellt steil ins Meer.");


  AddDetail( ({"betrieb"}), 
            "Die Amazonen werden von vielen Wesen besucht.");
  
  AddDetail( ({"amazonen","edynia","insel"}), 
            "Edynia ist die Insel der Amazonen.");
  
  AddDetail( ({"wesen","rassen"}), 
            "Alle moeglichen Rassen besuchen die Amazonenburg.");

  AddDetail( ({"amazonenburg","besucher","grund"}), 
            "Hippolyte ist die Amazonenkoenigin und auch wohl der Grund fuer "
	    "die vielen Besucher hier.");

    
  AddDetail( ({"amazonenkoenigin","hippolyte","schoenheit"}), 
            "Die Amazonenkoenigin ist von unglaublicher Schoenheit. Sie hat "
	    "den Anmut einer Frau und die Kraft und den Mut eines Mannes.");

  
  AddDetail( ({"anmut","frau","frauen"}), 
            "Frauen sollten schon anmutig sein. Bei den Druiden haben Maenner "
	    "wie auch Frauen diese Eigenschaften");
 
  AddDetail( ({"kraft","mut","mann","mannes","maenner"}), 
            "Ein Mann sollte Kraft und Mut besitzen. Leider ist Kraft eine "
	    "Eigenschaft mit der Druidenmaenner nicht dienen koennen. Sie "
	    "sind so dermassen schwach, das sogar ein Baby mehr Muskeln in "
	    "den Oberarmen hat.");
 
  AddDetail( ({"eigenschaften","eigenschaft","druide","druiden"}),
	   "Die meisten Druiden sind alte Tattergreise, die keine Ahnung von "
	   "den neuen technischen Dingen des Silberlandes haben. Sie sind "
	   "unfaehig mit Waffen zu kaempfen, aber das wuerden ihre zarten "
	   "Haende auch gar nicht aushalten.");

  AddDetail( ({"druidenmaenner","muskeln","oberarme","oberarmen"}),
	   "Die Oberarme der Druidenmaenner haben keinerlei Muskeln.");

  AddDetail( ({"baby"}),
	   "Ein Baby ist staerker als ein Druide.");


  AddDetail( ({"waffen","waffe"}),
	   "Gib einem Druiden eine Waffe, er wird sie nicht tragen koennen "
	   "geschweige dann damit kaempfen.");

  AddDetail( ({"ahnung"}),
	   "Hast Du Ahnung vom Kampfstil der Druiden?");

  AddDetail( ({"tattergreise","tattergreis"}),
	   "Der Obertattergreis ist Anvar.");

  AddDetail( ({"haende","hand"}),
	   "Druiden haben zarte Haende.");

  AddDetail( ({"obertattergreis","anvar"}),
	   "Anvar hatte einmal eine kurze Liebelei mit Ayla. Da er staendig "
	   "seine Elementare bei sich hatte und ohne sie ein Jammerlappen war, "
	   "wurde es Ayla zu bunt und sie hat ihn verlassen. Daraufhin hat "
	   "er sich in den Bergen verkrochen und fristet da sein Lebensende.");

  AddDetail( ({"liebelei"}),
	   "Moechtest Du eine Liebelei haben?");

  AddDetail( ({"ayla","geschlecht","maennern"}),
	   "Nach der Liebelei mit Anvar hat Ayla den Maennern abgeschworen und "
	   "sich nun dem weiblichen Geschlecht zugewandt.");

  AddDetail( ({"bergen","lebensende","berge"}),
	   "In den Bergen hat sich Anvar verkrochen.");

  AddDetail( ({"kampfstil"}),
	   "Die Druiden haben Elementare, die den meisten Schaden machen. Ohne "
	   "ein Elementar hat ein Druide ungefaehr soviel Macht wie ein "
	   "Wanderzwerg.");

  AddDetail( ({"gedanken"}),
	   "Denk besser nicht an ihren Kampfstil.");

  AddDetail( ({"elementare","elementar"}),
	   "Ohne ihre Elementare muessten sich die Druiden in den Bergen bei "
	   "Anvar verkriechen.");

  AddDetail( ({"macht"}),
	   "Druiden kaempfen mit den Naturgewalten. Sie wissen zwar selbst "
	   "nicht wie sie es schaffen koennen, was sie aber wissen ist das sie "
	   "es ohne die Gewalten niemals schaffen koennten.");

  AddDetail( ({"silberlandes","silberland"}),
	   "Du befindest Dich im Silberland.");

  AddDetail( ({"naturgewalten","gewalten","elemente"}),
	   "Trotzdem ist es noch fraglich ob die Druiden die Elemente beherrschen"
	   "oder ob es umgekehrt ist.");

    
  AddDetail( ({"fall","hochmut"}),
	     "Hochmut kommt vor dem Fall.");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");

  AddDetail( ({"jammerlappen","paladine","paladinen"}),
	     "Wo wir wieder bei den Paladinen waeren.");
	 
   
  AddDetail( ({"mitte"}),
	   "Noch weiter in die Mitte kannst Du nicht gehen.");

  AddDetail( ({"hoehenangst","aengste","luftelementare"}),
	   "Du hast Hoehenangst? Dann geh zu Anvar, der leiht Dir eines seiner "
	   "Luftelementare. Sie verleihen Dir Fluegel oder fliegen mit Dir.");

  AddDetail( ({"fluegel","angst"}),
	   "Druiden fliegen gerne vor lauter Angst davon.");

  AddDetail( ({"dinge"}),
	   "Na alles musst Du auch nicht wissen.");

  AddDetail( ({"schaden"}),
	     "Druiden machen dennoch ganz guten Schaden.");

  AddDetail( ({"wanderzwerg"}),
	     "Hier findest Du keinen Wanderzwerg.");


  AddDetail( ({"gilde","amazonengilde"}),
	   "Hier befindet sich die Amazonengilde.");

  AddDetail( ({"gildenoberhaupt"}),
	   "Oh da gibt es noch so manche.");


  AddDetail( ({"nordostoben"}), 
            "Nach Nordostoben gelangst Du zur Burg hinauf.");

  AddDetail( ({"wind"}),
	    "Den kannst Du nicht untersuchen.");

  AddDetail( ({"tuerme","tuermen"}),
	    "Die Tuerme ragen majaestetisch in den Himmel empor.");

  AddDetail( ({"umrandung"}),
	    "Jede Fahne hat eine goldene Umrandung.");

  AddDetail( ({"wappen","wappens","umrisse"}),
	    "Zwei ineinander verschlungene goldene Schlangen. In der Mitte "
	    "dieser Schlangen befindet sich ein Speer.");

  AddDetail( ({"schlangen"}),
	    "Sie bilden das Wappen.");

  AddDetail( ({"speer"}),
	    "Jede richtige Amazone hat einen Speer bei sich.");
	    
  AddDetail( ({"lungen"}),
	    "Deine Lungen sind noch jung und unverbraucht.");

  AddDetail( ({"ohren"}),
	   "Deine Ohren hoeren oft viele Dinge, die sie nicht hoeren sollten.");

  AddDetail( ({"dinge","dingen"}),
	   "Na alles musst Du auch nicht wissen.");

  
  AddSmell(DEFAULT_SMELL, "Du riechst hier die salzige Meeresluft.");

  AddSmell( ({"luft","meeresluft"}),
	   "Die Meeresluft dringt tief in Deine Lungen.");
  
     
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur den Wind und das Plaetschern der "
		 "Wellen.");
	   

  AddSound( ({"wind"}),
	   "Der Wind pfeift Dir um die Ohren.");

  AddSound( ({"plaetschern","wellen"}),
	   "Die Wellen prallen an die Klippen.");	  
  

//-----Details Ende-----
  
  AddExit("nordoben", ROOM "amazon16.lpc");
  AddExit("suedostunten", ROOM "amazon14.lpc");
 
}

 
