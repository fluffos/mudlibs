// 16.02.2005
// 
// Inherit fuer Keller
 
inherit "std/room";
#include "../def.h"

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem duesteren Gewoelbe");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier in einem unterirdischen Gang. Es ist "
	"ein unterirdisches Hoehlensystem direkt unter der Burg. Die "
	"Waende wurden grob aus dem Stein gehauen und einige Fackelhalter "
	"spenden duerftiges Licht. Dir ist etwas mulmig, da Du nicht weisst "
	"was Dich am Ende des Tunnels erwartet.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//---------Details Anfang-------------

  AddDetail( ({"gang","tunnel","tunnels","raum"}), QueryProp(P_INT_LONG) );

  
  AddDetail( ({"hoehlensystem"}),
	   "Der Gang wurde grob aus dem Stein gehauen. Viele Zwerge schufteten "           "hier sich fast zu Tode.");

  
  AddDetail( ({"zwerge","tode","kuchen","zwergenkuchen"}),
	   "Aus den toten Zwergen backen die Amazonen einen leckeren Kuchen. "
	   "Wenn Du ihn versuchen moechtest, dann musst Du in die Kueche gehen.");

  
  AddDetail( ({"wand","waende","waenden"}),
	   "Die Waende bestehen vollkommen aus Stein. Einige Fackelhalter "
	   "wurden an ihnen angebracht");

  
  AddDetail( ({"fackelhalter","fackelhaltern"}),
	   "In den Fackelhaltern befinden sich Fackeln und spenden dem Raum "
	   "etwas Licht.");

  
  AddDetail( ({"licht","fackeln","feuer","fackel","knistern"}),
	   "Das Licht der Fackeln ist sehr duerftig und erhellt den Gang "
	   "nur sehr wenig.");


  
  AddDetail( ({"amazonen","kueche"}),
	   "Einige Amazonen sitzen sicher gerade in der Kueche und geniessen "
	   "leckeren Zwergenkuchen.");

  
  AddDetail( ({"stein"}),
	   "Wo die Burg oben noch aus purem, schoenen Marmor bestand, ist hier "
	   "hingegen alles nur aus Stein.");

  
  AddDetail( ({"burg"}),
	   "Du befindest Dich hier tief unter der Burg.");

  
  AddDetail( ({"marmor"}),
	   "Wie kannst Du Marmor untersuchen wenn hier alles nur aus Stein "
	   "besteht?");

  
  AddDetail( ({"boden"}),
	   "Der Boden befindet sich aus groben Steinbloecken. Sie sind etwas "
	   "schmutzig und Du bist froh, das Du Schuhe anhast.");

  
  AddDetail( ({"schuhe"}),
	   "Du solltest sie einmal ausziehen und Deinen Fuessen etwas Luft "
	   "goennen. Sonst bekommst Du sehr leicht Kaesefuesse.");

  
  AddDetail( ({"fuessen","fuesse","kaesefuesse"}),
	   "Igitt! Du bist ein Ferkel! Du hast schon Kaesefuesse!");

  AddDetail( ({"ferkel"}),
	   "Du bist gemeint!");
 
  AddDetail( ({"luft"}),
	   "Du schnappst nach frischer Luft, es ist doch sehr stickig hier.");

   
  AddDetail( ({"steinbloecken","bloecken","steinbloecke"}),
	   "Lauter schmutzige uninteressante Steinbloecke..");

  
 
  AddDetail( ({"decke"}),
	   "Die Decke besteht aus Stein. Keine einzige Spinnwebe ist daran "
	   "zu erkennen.");



  AddDetail( ({"spinnwebe","spinnweben","hinweise"}),
	   "Die Amazonen moegen keine Spinnen und somit achten die Dienerinnen "
	   "immer darauf, alle Hinweise auf eine Spinne zu beseitigen.");

  
  AddDetail( ({"spinne","spinnen","viecher"}),
	   "Spinnen sind eklige Viecher.");

  
  AddDetail( ({"dienerinnen","dienerin"}),
	   "Die Dienerinnen eilen emsig durch die Burg.");

  AddDetail( ({"magengegend","gegend","magen","gefuehl"}),
	   "Im Magen hast Du ein mulmiges Gefuehl.");

  AddDetail( ({"geruch"}),
	   "Ich wuerde es mit riechen versuchen.");
 
  
  AddDetail( ({"meer"}),
	   "Das Meer rauscht leise.");


  AddRoomMessage( ({"Die Feuer der Fackeln lodert.\n",
	          "Eine Dienerin huscht an Dir vorbei.\n",
		  "Dir wird etwas mulmig in der Magengegend.\n",
		  "Dir scheint so, als haette sich etwas bewegt.\n"}), 50);
 
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach dem verbrannten Holz der "
		  "Fackeln.");

  AddSmell( ({"holz","fackeln","fackel"}),
	     "Das verbrannte Holz der Fackeln hat einen beissenden Geruch.");

  AddSmell( ({"geruch"}),
	     "Beissend!");

     
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur leicht das Meer rauschen und "
		  "das Knistern der Fackeln.");

  AddSound( ({"meer","rauschen"}),
	    "Das Meer rauscht leise vor sich hin.");
	   

  AddSound( ({"knistern","fackeln","fackel"}),
	   "Die Fackeln knistern monoton vor sich dahin.");

 }


  
   
