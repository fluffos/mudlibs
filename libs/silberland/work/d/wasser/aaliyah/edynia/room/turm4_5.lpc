// Das Schlafzimmer der Koenigin
 
#include "../def.h"
inherit "std/room";

void grundzustand();
int feuer_brennt;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Schlafgemach der Amazonenkoenigin");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//---------------Details Anfang-----------------------------------


  AddDetail( ({"koenigin","amazonenkoenigin","amazonen","dienerinnen"}),
	  "Die Amazonenkoenigin herrscht ueber alle Amazonen und auch ueber "
	  "unzaehlige Dienerinnen, die ihr alle treu ergeben sind.");
  
  AddDetail( ({"himmelbett","bett","mitte"}),
	  "Das Bett besteht aus Weissgold. Es ist mit vielen Schnoerkeln und "
	  "Einlegearbeiten verziert. Unzaehlige edle Daunenkissen befinden "
	  "sich darauf und auch die schoen bestickte Daunendecke laedt richtig "
          "zum Kuscheln ein.");

  AddDetail( ({"verzierungen","schnoerkeln","einlegearbeiten","weissgold"}),
	  "Die Verzierungen sind maerchenhaft.");

  AddDetail( ({"daunendecke","kissen","daunenkissen","decke","stickereien"}),
	  "Die Kissen und die Decke sind mit edlen Stickereien verziert. Das "
	  "Bett schaut so einladend aus, dass Du dich gerne hineinkuscheln "
	  "moechtest. Leider hast Du zu grossen Respekt vor der Koenigin.");

  AddDetail( ({"respekt"}),
	  "Man sollte der Koenigin grossen Respekt zollen um sie nicht "
	  "unnoetig zu veraergern.");
  
  AddDetail( ({"kuscheln"}),
	  "Du haettest jetzt gerne wen zum kuscheln und druecken.");
  
  AddDetail( ({"nachtkaestchen","kaestchen","gold","ablage","schublade","lade"}),
	  "Das Nachtkaestchen besteht aus purem Gold. Es hat keine Schublade "
	  "und dient lediglich als Ablage.");
  
  AddDetail( ({"schale","obst","fruechten"}),
	  "Eine Schale mit frischen exotischen Fruechten steht auf dem "
	  "Nachtkaestchen.");
   
  AddDetail( ({"boden","waenden","waende","wand","marmor"}),
	  "Der Boden und die Waende bestehen aus weissen Marmor, wobei der "
	  "Boden mit vielen Teppichen zur Gaenze bedeckt ist.");
  
  AddDetail( ({"gaenze","teppiche","teppichen","muster"}),
	  "Viele edle Teppiche bedecken den Boden. Das Muster von ihnen deutet "
	  "auf eine orientalische Herkunft.");
 
  AddDetail( ({"herkunft","orient"}),
	  "Die schoenen Teppiche stammen aus dem fernen Orient. Dort wo die "
	  "Sonne am hoechsten steht, dort werden sie gewebt.");
  
  AddDetail( ({"sonne","sonnenlicht","licht"}),
	  "Das Sonnenlicht flutet durch die vielen Fenster und erhellt den "
	  "Raum.");
  
  AddDetail( ({"fenster"}),
	  "Du blickst aus dem Fenster und geniesst den schoenen Ausblick auf "
	  "das Meer. Grosse Wellen zerschellen an der steilen Klippe unter Dir.");
  
  AddDetail( ({"ausblick","meer","klippe","welle"}),
	  "Der Ausblick ist ueberwaeltigend. Du geniesst ihn und wuenschst "
	  "Dir, einfach einmal einen laengeren Urlaub zu machen.");
 
  AddGenderDetail( ({"urlaub","cocktails","sommer","strand","haengematte"}),
	  "Sommer, Sonne, Strand. Du im knappen Bikini liegst auf einer "
	  "grossen Haengematte. Einige starke, braungebrannte Maenner bringen "
	  "Dir Cocktails und faechern Dir kuehle Luft zu.",
	  "Sommer, Sonne, Strand und Frauen. Du beginnst zu traeumen. Du "
	  "liegst auf einer grossen Haengematte und unzaehlige nackte Frauen "
	  "servieren Dir kuehle Cocktails.");
  
  AddDetail( ({"maenner","luft"}),
	  "Du denkst an die vielen huebschen Maenner und Dir bleibt die "
	  "Luft weg.");
  
  AddDetail( ({"frauen","traeumen","traeume"}),
	  "Die Frauen in Deinen Traeumen sind nackt und braungebrannt.");
  
  AddDetail( ({"schminktisch","tisch","schemel"}),
	  "Auf dem Schminktisch befinden sich einige Utensilien und eine "
	  "Tonschale mit frischem Wasser. Vor dem Tisch steht ein kleiner "
	  "Schemel.");

  AddDetail( ({"wasser","tonschale"}),
	  "Die Tonschale ist mit klarem Wasser gefuellt und dient der Koenigin "
          "zur Morgen und Abendreinigung.");
  
  AddDetail( ({"reinigung","morgenreinigung","abendreinigung","morgen"}),
	  "Die Koenigin saeubert taeglich ihr Gesicht, ihre Haende und auch "
	  "ihre Fuesse vor dem Schlafengehen.");
  
  AddDetail( ({"gesicht","fuesse","haende","schlafengehen","hygiene"}),
	  "Etwas mehr Hygiene wuerde Dir auch nicht schaden.");
  
  AddDetail( ({"schemel"}),
	  "Ein unscheinbarer kleiner Schemel.");
  
  AddDetail( ({"decke","rest"}),
	  "Die Decke besteht wie der Rest des Raumes aus weissem Marmor.");
   
  AddDetail( ({"vanille","rosen","nase","geruch"}),
	  "Wofuer hast Du Deine Nase?");
   
  AddDetail( ({"utensilien","buerste","schleifen"}),
	  "Eine Buerste, einige Schleifen und etwas Schminkzeug liegt auf "
	  "dem Tisch.");
   
  AddDetail( ({"schminkzeug","zeug"}),
	  "Das Schminkzeug benoetigt die Koenigin um sich morgens etwas "
	  "zu verschoenern.");
  
  
  
  
  AddSmell(DEFAULT_SMELL, "Es duftet herrlich nach Vanille und Rosen.");
 
  AddSmell( ({"rosen","vanille"}),
	   "Der suessliche Geruch umschmeichelt Deine Nase.");
    

//----------Details Ende---------------------------------
  AddExit( "unten", "./turm4_4");
  AddItem(NPC "calypso.lpc", REFRESH_DESTRUCT);
 
  AddCmd( ({"loesche", "loesch"}), "c_loeschen");
  AddCmd( ({"kletter", "klettere"}), "c_klettern");
  grundzustand();
}  
   
void grundzustand()
{
  tell_room(TO, 
      "Eine Dienerin huscht herein und zuendet das Feuer im Kamin an.\n");
  feuer_brennt = 1;
  SetProp(P_INT_LONG,
      "Du befindest Dich hier im Schlafgemach der Amazonenkoenigin. In der "
      "Mitte des Raumes befindet sich ein grosses Himmelbett. Neben dem Bett "
      "steht ein goldenes Nachtkaestchen, auf dem sich eine Schale mit Obst "
      "befindet. Etwas Feuer lodert in dem kleinen Kamin, der in die Suedwand "
      "eingemauert ist. Ausserdem erkennst Du noch einen kleinen Schminktisch "
      "mit einem Schemel davor. Viel Sonnenlicht flutet durch die unzaehligen "
      "Fenster und erhellt den Raum. Weiters fallen Dir die edlen Teppiche "
      "auf, die den ganzen Boden bedecken.");

  AddDetail( ({"suedwand","kamin","feuer","funken"}),
	  "Das Feuer knistert und lodert im Kamin.");

  AddDetail( ({"schlafgemach","gemach","raum","raumes"}), QueryProp(P_INT_LONG) );
  
  AddRoomMessage( ({"Das Feuer lodert im Kamin.\n",
		     "Ein Funken springt aus dem Kamin.\n"}), 80);

  AddSound(DEFAULT_SOUND, "Das Feuer im Kamin knistert leise vor sich hin.");

  AddSound( ({"feuer","knistern"}),
	  "Das Feuer knistert und Du fuehlst Dich hier sehr wohl.");
}

void reset()
{
  ::reset();
  if (feuer_brennt == 0)
    grundzustand();
}

void feuer_aus()
{
  feuer_brennt = 0;
  SetProp(P_INT_LONG,
      "Du befindest Dich hier im Schlafgemach der Amazonenkoenigin. In der "
      "Mitte des Raumes befindet sich ein grosses Himmelbett. Neben dem Bett "
      "steht ein goldenes Nachtkaestchen, auf dem sich eine Schale mit Obst "
      "befindet. In die Suedwand ist ein Kamin eingemauert, der momentan "
      "erloschen ist. Ausserdem erkennst Du noch einen kleinen Schminktisch "
      "mit einem Schemel davor. Viel Sonnenlicht flutet durch die unzaehligen "
      "Fenster und erhellt den Raum. Weiters fallen Dir die edlen Teppiche "
      "auf, die den ganzen Boden bedecken.");

  AddDetail( ({"suedwand","kamin","feuer","funken"}),
	  "Das Feuer im Kamin ist erloschen.");
 
  AddDetail( ({"schlafgemach","gemach","raum","raumes"}), QueryProp(P_INT_LONG) );
  
  AddRoomMessage( ({"Voellige Stille erfuellt den Raum.\n"}), 80);

  AddSound(DEFAULT_SOUND, "Voellige Stille erfuellt den Raum.");

  AddSound( ({"feuer","knistern"}),
	  "Du hoerst nichts.");
}

int c_loeschen(string str)
{
  notify_fail("Was willst Du loeschen?\n");
  if (!str || member(({"kamin", "feuer", "kaminfeuer"}), str) == -1)
    return 0;

  if (!feuer_brennt)
  {
    write("Aber das Feuer brennt ja gar nicht.\n");
    return -1;
  }
  write("Du loescht das Kaminfeuer aus.\n");
  tell_room(TO, TP->Name(WER) + " loescht das Kaminfeuer.\n", ({TP}));
  feuer_aus();
  return 1;
}

int c_klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if (!str || member(({"in kamin", "kamin hinauf", "durch kamin"}), str) == -1)
    return 0;

  if (feuer_brennt)
  {
    write("Du versucht, in den Kamin zu klettern, verbrennst Dich aber am "
        "Kaminfeuer.\n");
    tell_room(TO, TP->Name(WER) + " verbrennt sich am Kaminfeuer.\n", ({TP}));
    SetProp(P_KILL_NAME, "Ein heisses Kaminfeuer");
    TP->do_damage(30 + random(30));
    return -1;
  }
  write("Du kletterst in den Kamin.\n");
  tell_room(TO, TP->Name(WER) + " klettert in den Kamin.\n", ({TP}));
  TP->move(ROOM "kamin", M_TPORT|M_NOCHECK|M_SILENT);
  TP->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: 10, 
        PARALYZE_MSG: "Du kletterst durch den Kamin.\n",
        PARALYZE_MSG_OTHER: "",
        PARALYZE_END: "Du kommst aus dem Kamin nach oben in die Wolken.\n",
        ]) );
  call_out("wolke", 10);
  return 1;
}

void wolke()
{
  TP->SetProp(P_PARALYZED, 0);
  TP->move(ROOM "wolke1", M_NOCHECK|M_SILENT);
}

