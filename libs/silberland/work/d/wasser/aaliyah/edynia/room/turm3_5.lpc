// Turm der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void grundzustand();
int splitter_da;
int schminkzeug_da;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Badesaal der Amazonenkoenigin");
  SetProp(P_INT_LONG,
      "Du befindest Dich hier im Badesaal der Koenigin. In der Mitte des "
      "Raumes befindet sich ein grosses, in den Boden eingelassenes Becken. "
      "Das Becken ist gefuellt von milchigweissem Wasser, und auch viele "
      "Rosenblueten schwimmen darin. Um den Beckenrand wurden einige Fackeln, "
      "Blumenvasen und Obstschuesseln aufgestellt. Duftender Rauch stroemt aus "      "vielen Schalen, die ueberall im Raum aufgestellt wurden. In einer Ecke "
      "erkennst Du einen Schminktisch mit einem Schemel davor. Darueber "
      "befindet sich ein grosser Spiegel, indem sich das Spiel der Fackeln "
      "wunderschoen wiederspiegelt.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//-----------------Details Anfang-------------------------

  AddDetail( ({"saal","badesaal","raum","raumes"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"beckenrand","rand"}), 
            "Rund um den Beckenrand wurden lauter Blumenvasen, Fackeln und "
	    "viele Obstschuesseln aufgestellt.");

  AddDetail( ({"blumenvasen","vasen","lilien","orchideen"}), 
            "Die Vasen sind gefuellt mit schoenen Lilien und Orchideen.");

  AddDetail( ({"fackelhaltern","fackeln","fackel","fackelhalter","knistern"}), 
            "Viele lodernde Fackeln befinden sich in den Fackelhaltern und "
	    "tauchen den Raum in ein wunderbares Lichtermeer.");

  AddDetail( ({"atmosphaere","lichtermeer"}), 
            "Die Atmosphaere dieses Raumes ist ueberwaeltigend.");

  AddDetail( ({"obstschuesseln","obstschuessel","schuesseln","schuessel"}), 
            "In den Obstschuesseln befinden sich exotische Fruechte aller Art. "
	    "Die Schuesseln wurden mit jeweils einer lachsfarbenen Bluete "
	    "dekoriert.");
  
  AddDetail( ({"bluete"}), 
            "Lachsfarben.");

  AddDetail( ({"obst","fruechte","art"}), 
            "Mangos, Ananas, Papayas, Karambolfruechte, Erdbeeren, Aepfel, "
	    "Bananen, Orangen, Kokosnuesse, Datteln und viele Trauben.");

  AddDetail( ({"trauben","datteln","aepfel","orangen","erdbeeren","ananas"}), 
            "Die Koenigin nascht waehrend des Badens gerne am frischen Obst.");

  AddDetail( ({"mangos","karambolfruechte","bananen","papayas"}), 
            "Das Obst sieht so verlockend aus, dass Du gerne davon naschen "
	    "moechtest.");

  AddDetail( ({"kokosnuesse","nuesse","kokosnuss","nuss"}), 
            "Bevor man eine Kokosnuss isst, muss man sie erst knacken.");

  AddDetail( ({"schalen","rauch","gestelle","gestell","schale"}), 
            "Jede Schale befindet sich auf einem goldenen Gestell. Duftender "
	    "Rauch stroemt aus den Schalen und zieht langsam durch den Raum.");

  AddDetail( ({"spiegel","spiel","lichterspiel"}), 
            "Der grosse Spiegel hat einen wunderschoen verzierten, goldenen "
	    "Rahmen. Wenn Du in ihn hineinblickst erkennst Du ausser Deinem "
	    "Gesicht noch das unzaehlige Lichterspiel der Fackeln.");

  AddDetail( ({"rahmen","gold","verzierungen","spiegels"}), 
            "Der Rahmen des Spiegels besteht aus purem Gold. Viele kleine "
	    "Verzierungen schmuecken ihn.");

  AddDetail( ({"gesicht","milchbad"}), 
            "Ein Milchbad wuerde Deiner Haut sicherlich auch nicht schaden.");

  AddDetail( ({"sitzflaeche","schemel","holz"}), 
            "Der Schemel besteht aus weissem Holz und hat einige goldene und "
	    "verschnoerkelte Verzierungen. Die Sitzflaeche besteht aus einem "
	    "goldenen Polster.");

  AddDetail( ({"polster","fliess","goldenes fliess"}), 
            "Du bist Dir sicher, dass der Polster aus dem goldenen Fliess "
	    "gewebt wurde.");

  AddDetail( ({"tisch","schminktisch","ecke"}), 
            "Der Schminktisch ist weiss und hat goldene Verzierungen. Auf ihm "             "befinden sich viele Puderdosen, Lippenstifte, Lidschatten, eine "
	    "Buerste und einige Kohlestifte.");

  AddDetail( ({"puderdosen","dosen","glanz","puder"}), 
            "Mit dem Puder wird das Gesicht der Koenigin von laestigem Glanz "
	    "befreiht. Es duftet himmlisch.");

  AddDetail( ({"lidschatten"}), 
            "Du siehst Lidschatten in allen moeglichen Farben.");

  AddDetail( ({"schatten","augenringe","ringe"}), 
            "Der tiefe Schatten unter Deinen Augen sind lediglich Augenringe. "
	    "Das sieht nicht sonderlich huebsch aus, darum solltest Du etwas "
	    "dagegen unternehmen");

  AddDetail( ({"farben"}), 
            "Du siehst goldenen, smaragdgruenen, hellblauen, silbernen und "
	    "lila Lidschatten.");

   AddDetail( ({"augen","kohlestifte","stifte"}), 
            "Die Kohlestifte dienen dazu, die Augen schwarz zu umranden.");

   AddDetail( ({"lippenstifte"}), 
            "Du siehst goldene, rosafarbene, rote, hellbraune, lachsfarbene, "
	    "orangene und silberne Lippenstifte. Bei so einer Vielfalt an "
	    "buntem Schminkzeug bekommst Du richtig Lust Dich zu schminken.");

   AddDetail( ({"vielfalt","schminkzeug","lust"}), 
            "Schmink Dich doch! Mach Dich ein bisschen schoen!");

  AddDetail( ({"becken","mitte","boden"}), 
            "In der Mitte des Raumes befindet sich ein grosses Becken. "
	    "Es wurde in den Boden eingelassen und ist mit vielen goldenen "
	    "Platten umrahmt. Einige Marmorstufen fuehren in das milchigweisse "            "Wasser.");

   AddDetail( ({"marmorstufen","stufen"}), 
            "Einige Marmorstufen fuehren in das milchigweisse Wasser.");

   AddDetail( ({"platten","beckenrand","beckenrandes"}), 
            "Viele goldene Platten bilden den Beckenrand. Sie umrahmen das "
	    "ganze Becken.");

   AddDetail( ({"wand","waende","waenden","decke","marmor"}), 
           "Hier besteht alles aus weissem Marmor.");
 
   
   AddDetail( ({"rosenblueten","blueten","duften"}), 
            "Die unzaehligen Rosenblueten bringen das Wasser zum Duften.");
  
   
   AddDetail( ({"gold","boden"}), 
            "Alles besteht hier aus purem Gold.");

   AddDetail( ({"wasser"}), 
            "Das Becken ist gefuellt mit milchigweissem Wasser. Das liegt "
	    "daran, dass frische Milch hinzugefuegt wurde. Viele Blueten "
	    "schwimmen darin, und bringen das Wasser zum Duften.");
   
   AddDetail( ({"milch","badens"}), 
            "Frische Stutenmilch wurde dem Wasser beigefuegt, um die Haut der "
	    "Koenigin geschmeidig und jung zu erhalten.");

   
   AddDetail( ({"stutenmilch","stallungen"}), 
            "Die Stutenmilch stammt wohl aus den Stallungen der Burg.");

   
   AddDetail( ({"burg","amazonen"}), 
            "Du befindest Dich in der Burg der Amazonen.");

   
   AddDetail( ({"haut","koenigin","amazonenkoenigin","muss","rang","ranges"}), 
            "Die Haut der Amazonenkoenigin ist samtweich und geschmeidig. "
	    "Aber das ist ein Muss bei einer Frau von so hohem Ranges.");

   AddGenderDetail( ({"frau"}), 
            "Du waerst auch gerne so eine starke und schoene Frau. ",
	    "Haettest Du gerne so eine schoene Frau?");

   AddDetail( ({"sandelholz","agar agar","agar","nase","blumenduft","geruch"}), 
            "Riechen!");
   
   AddDetail( ({"mund"}), 
            "Dir laeuft das Wasser im Mund zusammen.");

   AddDetail( ({"buerste"}),
	    "Vielleicht koenntest Du dir ja die Haare kaemmen.");

   AddDetail( ({"jasminblueten","hinsehen","jasmin"}), 
            "Beim genaueren Hinsehen entdeckst Du, dass sich im Wasser auch "
	    "viele Jasminblueten befinden.");

   AddDetail( ({"haare","toga","ankleiden","blick","po"}), 
            "Nun starr doch nicht so auffaellig hin!");

   AddDetail( ({"dienerin","temperatur","haare","kleidung","dienerinnen"}), 
            "Die Dienerinnen sind hier fuer alles zustaendig.");

   AddGenderDetail( ({"brueste","amazone","figur"}), 
	    "Du beneidest die Amazone um ihre schoene Figur. ",
            "Die Amazone hat wunderschoene, pralle und wohlgeformte Brueste. "
	    "Ihr knackiger Po fasziniert Dich dermassen, das es Dir schwer "
	    "faellt, Dich weiter zu konzentrieren. Deine Blicke haften an "
	    "ihrem schoenen Koerper und ein Verlangen ueberkommt Dich, das Du "
	    "kaum mehr zu bremsen vermagst.");

   AddDetail( ({"blicke","koerper","verlangen"}), 
            "Nun reiss Dich doch zusammen!");


  
 
 AddSmell(DEFAULT_SMELL, "Der duftende Rauch stroemt in Deine Nase. Ausserdem "                    "riechst Du zarten Rosenduft und den Geruch der exotischen "
		   "Fruechte.");
 
  AddSmell( ({"rauch","sandelholz","agar agar","agar"}),
	   "Der Rauch duftet herrlich nach Sandelholz und Agar Agar.");

  AddSmell( ({"rosenduft","duft","rosenblueten","blueten"}),
	   "Die Rosenblueten duften himmlisch gut. Ausserdem faellt Dir noch "
	   "weiterer Blumenduft auf.");

  AddSmell( ({"fruechte","geruch"}),
	   "Die exotischen Fruechte duften und lassen Dir das Wasser im "
	   "Mund zusammenlaufen.");

  AddSmell( ({"blumenduft","lilien","orchideen","jasmin"}),
	   "Der Raum duftet ausserdem noch nach Lilien, Orchideen und sogar "
	   "nach frischem Jasmin.");

  AddSmell( ({"puder"}),
	   "Das Puder riecht edel.");

   
  AddSound(DEFAULT_SOUND, "Du hoerst hier lediglich das Knistern der Fackeln.");
	   

  AddSound( ({"fackeln","knistern"}),
	  "Die Fackeln knistern.");

   AddRoomMessage( ({"Sanfter Rauch stroemt durch den Saal.\n",
	          "Eine Dienerin prueft die Temperatur des Wassers.\n",
		  "Eine Amazone zieht sich ihre Kleidung aus.\n",
		  "Eine Dienerin schuettet Milch ins Wasser.\n",
		  "Eine nackte Amazone huscht an Dir vorbei.\n",
		  "Eine Amazone gleitet in das Becken.\n",
		  "Die Dienerin beginnt die Amazone zu waschen.\n",
		  "Die Dienerin waescht die Brueste der Amazone.\n",
		  "Eine Dienerin waescht die Haare einer Amazone.\n",
		  "Eine Amazone schluepft in eine frische Toga.\n",
		  "Eine Amazone beginnt sich zu schminken.\n",
		  "Eine Dienerin kaemmt die Haare einer Amazone.\n",
		  "Eine Dienerin hilft der Amazone beim Ankleiden.\n",
		  "Dein Blick huscht auf den knackigen Po der Amazone.\n"}), 80);

//--------------Details Ende---------------------------------------

  AddExit( "unten", "./turm3_4");
  AddItem(NPC "aphro.lpc", REFRESH_DESTRUCT);
//--------------KOMMANDOS---------------------- 
   AddCmd( ({ "bade", "bad" }), "c_baden");
   AddCmd( ({ "nasche","nasch" }), "c_naschen");
   AddCmd( ({ "schminke", "schmink" }), "c_schminken");
   AddCmd( ({ "buerste","kaemme" }), "c_kaemmen");
   AddCmd( ({ "knacke","knack" }), "c_knacken");
 
 
 grundzustand();
}  

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	splitter_da = 1;
	schminkzeug_da = 1;
	
}

 
int c_knacken(string str)
{
   object splitter;
   notify_fail(BS("Was moechtest Du hier denn knacken?"));
   if(!(str == "kokosnuss"))
   {
     return 0;
   }
   
   if(present("splitter", ENV(TP)) || (splitter_da==0))
   {
     write(BS("Du versuchst die Kokosnuss zu knacken. Als Du bemerkst, dass "
	      "Du zuwenig Kraft hast, schmetterst Du sie mit Gewalt auf dem "
	      "Marmorboden. Die Nuss zerplatzt und die gesamte Kokosmilch "
	      "bekleckert Deine Kleidung. Das hast Du jetzt davon Du Narr!"));
     tell_room(ENV(TP), TPN+" huepft wie ein Narr herum.\n", ({TP}));
     return 1;
    }
    else
    {
      write(BS("Mit einem gekonnten Schlag, schmetterst Du die Kokosnuss zu "
	       "Boden. Zwei wunderbare Haelften liegen vor Dir. Du nimmst eine "
	       "der Haelften und trinkst die koestliche Kokosmilch. Ploetzlich "
	       "bemerkst Du etwas auf Deiner Zunge. Du nimmst es aus dem Mund "
	       "und hast einen Glassplitter in Deiner Hand."));
      tell_room(ENV(TP), TPN+" grinst Dich breit an.\n", ({TP}));
      splitter_da = 0;
      splitter = clone_object(OBJ "splitter");
      if (splitter->move(TP,M_GET) < 0)
  {
    write(BS("Du Seicherl kannst den Splitter nicht mehr tragen."));
    tell_room(TPN +" ist ein kleines Seicherl.\n", ({TP}) );
    splitter->move(TO, M_NOCHECK);
  }
      return 1;
    }
   }
  

int c_baden(string str)
{
  
   
   notify_fail(BS("Worin moechtest Du baden?"));
   if((str == "in becken" || str == "in wasser"))
   {
    
     write(BS("Du ziehst Deine Kleidung aus und steigst ins duftende Milchbad. "
	      "Das Wasser ist angenehm warm. Gerade als Du ein paar Runden "
	      "schwimmen moechtest, packt Dich eine Amazone am Kragen und "
	      "verpasst Dir einen gewaltigen Fausthieb. Du fliegst in "
	      "grossem Bogen aus dem Becken."));
       tell_room(ENV(TP), TPN+" zieht sich splitternackt aus.\n", ({TP}));
      TP->AddHp(-80);
      return 1;

    }
} 

    int c_naschen(string str)
{
   notify_fail(BS("Wovon moechtest Du denn naschen?"));
    if(!(str == "an obst" || str == "an fruechten"))
   {
     return 0;
   }
   write(BS("Du naschst an den Fruechten und sie schmecken wunderbar. Satt "
	    "bist Du davon allerdings nicht geworden."));
   tell_room(ENV(TP), TPN+" wird zu einem kleinen Schleckermaul.\n", ({TP}));
     
   return 1;
  }
        int c_kaemmen(string str)
{
   notify_fail(BS("Was moechtest Du womit kaemmen?"));
    if(!(str == "haare mit buerste" || str == "mit buerste haare"))
   {
     return 0;
   }
   write(BS("Andaechtig beginnst Du Deine Haare zu kaemmen. Sie werden immer "
	    "glaenzender und geschmeidiger. Als Du in den Spiegel guckst, "
	    "erkennst Du Deine Haare kaum wieder. Sie sehen wunderbar aus. "
	    "Die Amazonen haben anscheinend magische Buersten, anders kannst "
	    "Du Dir diese Wandlung nicht erklaeren."));
   tell_room(ENV(TP), TPN+" starrt selbstverliebt in den Spiegel.\n", ({TP}));
     
   return 1;
  }
       int c_schminken(string str)
{
   object schminkzeug;
   notify_fail(BS("Was moechstest Du hier schminken?"));
    if(!(str == "dich" || str == "mich"))
   {
     return 0;
   }
   if(present("schminkzeug", ENV(TP)) || (schminkzeug_da==0))
   {
   notify_fail("Leider haben die Amazonen alles verbraucht.\n");
    return 0;
    }
    else
    {
   write(BS("Du nimmst die Puderdose und puderst Dir Dein Gesicht sorgfaeltig "
	    "ab. Danach nimmst Du goldenen und smaragdgruenen Lidschatten und "
	    "beginnst Dir, Deine Augenlider zu bemalen. Mit einem Kohlestift "
	    "umrahmst Du Deine Augen schoen. Zu guter Letzt malst Du Dir "
	    "schoene lachsrosafarbene Lippen. Als Du in den Spiegel schaust, "
	    "hast Du das Gefuehl, Du wuerdest Cleopatra gegenueber stehen."));
   tell_room(ENV(TP), TPN+" starrt selbstverliebt in den Spiegel.\n", ({TP}));
   schminkzeug_da = 0;
   schminkzeug = clone_object(OBJ "schminkzeug");
      if (schminkzeug->move(TP,M_GET) < 0)  
   return 1;
  }
}
 


