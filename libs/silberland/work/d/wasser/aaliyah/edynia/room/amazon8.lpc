inherit "std/room";
#include "../def.h"
#include <ansi.h>

void grundzustand();
int ton_da;
	
void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In den Gaerten von Edynia");
  SetProp( P_INT_LONG,
	"Du befindest Dich inmitten der Gaerten von Edynia. Rund um Dich "
       	"herum wuchern viele wilde Blumen. Die Blumen sind so hoch, sodass "
	"sie Dir bis zum Bauch reichen. Ein schmaler Weg fuehrt durch den "
	"Blumenhain hindurch. Etwas weiter links von Dir erkennst Du ein paar "
	"Einhoerner, die seelenruhig auf der Wiese grasen. Vor Dir am Horizont "
	"ragen die Tuerme der weissen Burg majestaetisch in den Himmel. "
	"Nach Nordwesten gelangst Du tiefer in die Gaerten und nach Suedwesten "
	"kommst Du wieder zu den Klippen zurueck.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "gaerten", QueryProp(P_INT_LONG) );

  AddDetail( ({"klippen"}), 
            "Die Klippen befinden sich suedwestlich von hier.");

  AddDetail( ({"blumenhain"}), 
            "Du stehst mitten drin.");


  AddDetail( ({"bauch","die"}), 
            "Die Blumen reichen Dir bis zum Bauch.");

  AddDetail( ({"ton"}), 
            "Sowas gibts hier sicher auch.");

  AddDetail( ({"bauch"}), 
            "Die Blumen reichen Dir bis zum Bauch.");
  
  AddDetail( ({"silberland"}), 
            "Du befindest Dich mittendrin.");
 
  AddDetail( ({"statur","sport"}), 
            "Deine koennte etwas Sport vertragen.");

  AddDetail( ({"leben"}), 
            "Ist das Leben nicht schoen?");
 
  AddDetail( ({"ausruestung"}), 
            "Deine Ausruestung sieht eh nicht sooo schlecht aus.");

  AddDetail( ({"weg"}), 
            "Der Weg schlaengelt sich durch die vielen Blumenwiesen und "
	    "fuehrt genau auf eine grosse Burg zu.");

  AddDetail( ({"wiese","wiesen","blumenwiesen"}), 
            "Wunderschoene Blumenwiesen befinden sich vor Dir und reichen "
	    "so weit das Auge reicht.");
 
  AddDetail( ({"blumen"}), 
            "Viele wilde Rosen, Orchideen, Lilien und Tulpen wachsen hier. "
	    "Ausserdem erkennst Du vereinzelt noch genuegend Dir unbekannte "
	    "Blumen. Pfluecken solltest Du hier allerdings keine wenn Du "
	    "nicht den Groll der Amazonen auf Dich ziehen moechtest.");
  
  AddDetail( ({"groll"}), 
            "Wenn die Amazonen boese werden kann das tragisch enden.");

  AddDetail( ({"amazonen","frauen"}), 
            "Wunderschoene kraeftige Frauen, die mit der Macht der Goetter "
	    "kaempfen und furchtlos durch das Leben schreiten.");

  AddDetail( ({"macht","goetter","woody","macht"}), 
            "Woody hat im Silberland die Macht. Er kann mit einem simplen "
	    "Knopfdruck viele Wesen zum Weinen bringen.");

  AddDetail( ({"knopfdruck","reboot"}), 
            "Dieser Knopfdruck heisst Reboot.");

  AddDetail( ({"wesen","weinen"}), 
            "Gehoerst Du auch zu jenen, die ihrer Ruestung nachheulen?");

  AddDetail( ({"ruestung"}), 
            "Die meisten hier haben eh nur Glump und somit ist fuer sie ein "
	    "Reboot nicht so schlimm.");

  AddDetail( ({"glump","sprachform"}), 
            "Glump wird in der normalen Sprachform auch Schrott genannt.");

  AddDetail( ({"schrott","menge"}), 
            "Tipp mal Ausruestung, dann siehst Du jede Menge Schrott.");

 
  AddDetail( ({"rosen","rose"}), 
            "Es gibt hier Rosen in allen moeglichen Farben und Groessen. "
	    "Sie gedeihen hier praechtig auf dem erdigen Boden.");

  AddDetail( ({"farben"}), 
            "Rote, weisse, blaue, lachsfarbene, gelbe und rosa Rosen wachsen "
	    "hier. Auch einige violette Rosen kannst Du vereinzelt erkennen.");

  AddDetail( ({"rote","weisse","lachsfarbene","gelbe","rosa","violette"}), 
            "Die Rosen sind einfach himmlisch.");

  AddDetail( ({"groessen"}), 
            "Die Blumen hier haben alle moeglichen Farben und Groessen.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist erdig und einige kleine Steine liegen hier herum.");
  
  AddDetail( ({"steine"}), 
            "Ganz normale kleine Steine. Sie waeren gewiss nicht hinderlich "
	    "wenn man in der Erde graben wuerde.");

  AddDetail( ({"erde"}), 
            "Vielleicht findet man ja was unter der Erde wenn man darin "
	    "graebt.");
  

  AddDetail( ({"orchideen","orchidee"}), 
            "Unzaehlige weisse Orchideen wachsen hier.");

  AddDetail( ({"einhoerner"}), 
            "Einige Einhoerner grasen friedlich auf der Wiese. Sie strahlen "
	    "solch einen Anmut aus, das Du sie immer wieder anschauen musst.");

  AddDetail( ({"anmut"}), 
            "Ein Einhorn ist besonders anmutig. Es hat eine sehr praechtige "
	    "und muskuloese Statur.");

  AddDetail( ({"einhorn","hinsehen"}), 
            "Beim genaueren Hinsehen erkennst Du das es sich bei diesem Einhorn "
	    "um einen stattlichen Einhornhengst handelt.");
  
  AddDetail( ({"einhornhengst","anfuehrer","hengst","hengstes"}), 
            "Der Einhornhengst ist gewiss der Anfuehrer dieser kleinen Gruppe.");

  AddDetail( ({"gruppe"}), 
            "Die restlichen Einhoerner sind alles Stuten und unterwerfen sich "
	    "ihrem Anfuehrer.");

  AddDetail( ({"stuten"}), 
            "Die Stuten sind beeindruckt vom Gebaelz des Hengstes.");

  AddDetail( ({"gebaelz"}), 
            "Das Gebaelz des Hengstes vor den Stuten erinnert Dich irgendwie an "            "Dich selber.");

  
  AddDetail( ({"lilie","lilien"}), 
            "Viele weisse Lilien wuchern hier wie wild.");

  
  AddDetail( ({"tulpen","rot"}), 
            "Die Tulpen wachsen hier in einem knalligen Rot.");
 
  AddDetail( ({"auge","horizont"}), 
            "Die Blumenwiesen reichen bis zum Horizont.");
 
  AddDetail( ({"einblick","landesinnere"}),
	     "Von hier aus hast Du einen sehr guten Einblick ins Landesinnere.");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");
	 
  AddDetail( ({"horizont"}),
	    "Einige gute Buecher wuerden Deinen Horizont imens erweitern.");

  AddDetail( ({"buecher"}), 
            "Einige Buecher liegen sicher verstaubt bei Dir herum.");

  AddDetail( ({"voegel"}), 
            "Einige bunte Voegel tummeln sich durch den Blumenhain.");

   
  AddDetail( ({"vogelgezwitscher","wind","sinn"}), 
            "Dir steht der Sinn nach lauschen.");
  

  AddDetail( ({"nordosten"}), 
            "Nach Nordosten fuehrt der Weg zwischen den Blumenwiesen durch.");

  AddDetail( ({"amazoneninsel"}),
	    "Hier leben lauter Amazonen.");

  AddDetail( ({"burg"}),
	    "Die Burg ist wunderschoen weiss und hat viele Tuerme. Ausserdem "
	    "erkennst Du an jedem der Tuerme eine hellblaue Fahne.");

  AddDetail( ({"tuerme"}),
	    "Die Tuerme ragen majaestetisch in den Himmel empor.");

  AddDetail( ({"fahne","turm"}),
	    "An jedem Turm befindet sich eine hellblaue Fahne.");
 
  
  AddSmell(DEFAULT_SMELL, "Die reine Luft duftet herrlich nach diversen "
		  "Blumen..");

  AddSmell( ({"luft"}),
	   "Du atmest einmal ganz tief durch. Oh wie das guttut.");
  
  AddSmell( ({"blumen"}),
	   "Die Blumen duften himmlisch suess.");
    
  AddSound(DEFAULT_SOUND, "Du hoerst hier leisen Wind, der ueber die Blumen "
		 "streicht und etwas Vogelgezwitscher.");
	   

  AddSound( ({"wind"}),
	   "Der Wind pfeift singend ueber den Blumenhain.");

  AddSound( ({"vogelgezwitscher","voegel","zwitschern","zirpen"}),
	   "Die Voegel zirpen und zwitschern froehlich vor sich hin.");	  
  

//-----Details Ende-----
  
  AddExit("nordwesten", ROOM "amazon9.lpc");
  AddExit("suedwesten", ROOM "amazon7.lpc");
  AddCmd( ({ "grab", "grabe" }), "c_graben");
 
     grundzustand();
 }

     reset()

 {
    ::reset();
     grundzustand();
 }

 void grundzustand()
 {
	ton_da = 1;


 }


 int c_graben(string str)
{
   notify_fail(BS("Wo moechtest Du hier graben?"));
   if(!(str ==  "in erde"))
   {
     return 0;
   }
   if(present("ton", TP) || (!ton_da))
   {
     write(BS("Du graebst mit Deinen Haenden in der Erde herum, aber ausser "
	      "dass sie nun schmutzig sind, hatte es wenig Sinn."));

     return -1;
    }
    else
    {
      write(BS("Du graebst mit Deinen Haenden in der Erde. Als Du die erste "
	       "Schicht abgetragen hast, merkst Du dass sich darunter "
	       "Ton verbirgt. Schnell steckst Du einen Klumpen davon ein."));
      tell_room(ENV(TP), TPN+" graebt mit den Haenden in der Erde herum.\n", ({TP}));
      ton_da = 0;
      CLONE ( OBJ "ton.lpc", TP);
      
      return 1;
 
  }
   
}
  string _query_int_long()
{ 
  string s;

  s=::_query_int_long();
 

  if(TP && interactive(TP) && IS_WIZARD(TP))
  { 
    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_BOLD+ANSI_CYAN;

    switch(ton_da)
    { 
      case 0:
        break;

      case 1:
        s += "Es gibt 1 Ton hier.";
        break;

      default:
        s += sprintf("Es gibt %d Ton hier.",ton_da);
        break;
    }

    s += "\n";

    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_NORMAL;
  }
  
  return s;
}
 
