// 27.01.2005
// 
// Raum 1 von Edynia
//
 
inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Am Strand von Edynia");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einem kleinen Strandstueck von Edynia. "
	"Es ist ein malerischer Strand mit schoenem weissen Sand und einigen "
	"saftiggruenen Palmen. Oestlich von Dir erkennst Du eine wunderschoene "
	"kleine Bucht und im Westen verlaeuft der Strand noch etwas weiter. "
  "Das Meer liegt ruhig vor Dir und hat eine faszinierende tuerkise "
  "Farbe. Du fuehlst Dich hier sehr wohl und beschliesst noch etwas "
  "zu verweilen.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "strandstueck", QueryProp(P_INT_LONG) );

  AddDetail( ({"farbe"}), 
            "Wunderbar tuerkis.");

  AddDetail( ({"palmen"}), 
            "Die Palmen spenden Dir angenehmen Schatten in der Hitze.");

  AddDetail( ({"schatten"}), 
            "Du haettest jetzt gerne eine Haengematte und einen leckeren, "
	    "kuehlen Cocktail.");
 
  AddDetail( ({"haengematte","richtige"}), 
            "Eine Haengematte waere jetzt genau das Richtige.");
 
  AddDetail( ({"cocktail"}), 
            "Mjammm das waere jetzt lecker!");

  AddDetail( ({"edynia"}), 
            "Du befindest Dich hier in Edynia.");

  AddDetail( ({"du","dich"}), 
            "Fuehlst Du Dich noch nicht genug angesprochen?");

  AddDetail( ({"kopf","lungen","wirkung"}), 
            "Dir ist ganz schwindelig.");

  AddDetail( ({"hitze"}), 
            "Hier ist es schon sehr heiss.");

 
  AddDetail( ({"boden","strand"}), 
            "Der Boden besteht aus wunderschoenem weissen Sand. Einige "
	    "Muscheln und Wasserblumen wurden angeschwemmt und erwecken Deine "
	    "Aufmerksamkeit.");
             

  AddDetail( ({"sand"}), 
            "Der Sand ist wunderschoen weiss.");
            
	 
  AddDetail( ({"muscheln"}),
	    "Nur wenige der Muscheln sind noch ganz. Meistens findet man "
	    "hier nur Muschelsplitter.");
      

  AddDetail( ({"muschelsplitter"}),
	    "Die Muschelsplitter sind leider vollkommen unbrauchbar.");
	    	  
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau und hat eine leichte rosarote "
	    "Faerbung. Er ist vollkommen wolkenlos.");
	 
  AddDetail( ({"faerbung"}),
	    "Rosarot.");
	     

  AddDetail( ({"sonne"}),
	    "Die Sonne spiegelt sich wunderschoen im Wasser.");
         

  AddDetail( ({"aufmerksamkeit"}),
	    "Bist Du jemand der viel Aufmerksamkeit braucht?");

  AddDetail( ({"wasserblumen"}),
	    "Die Wasserblumen wurden hier angespuelt und vertrocknen langsam "
	    "in der Sonne.");
	   
  
  AddDetail( ({"osten","oestlich","bucht"}),
	    "Im Osten befindet sich ein kleine vertraeumte Bucht.");

  AddDetail( ({"westen"}),
            "Im Westen breitet sich der Strand noch weiter aus.");

  AddDetail( ({"wasser"}), 
            "Das Wasser ist kristallklar und Du glaubst einige Fische in "
	    "den Wellen zu erkennen.");
 
  AddDetail( ({"fische","hinsehen"}), 
            "Beim genaueren Hinsehen erkennst Du das es sich um Delfine "
	    "handelt.");

  AddDetail( ({"delfine","gruppe","fluten"}), 
            "Eine kleine Gruppe Delfine tummelt sich verspielt in den Fluten.");
 
  AddDetail( ({"wellen","wasseroberflaeche"}), 
            "Die Wellen kraeuseln sich glitzernd auf der Wasseroberflaeche.");
         

  
  AddSmell(DEFAULT_SMELL, "Die Meeresluft riecht leicht salzig.");
                        
 
  AddSmell( ({"meeresluft"}),
	   "Du saugst die frische Meeresluft in Deine Lungen ein.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst das Kreischen der Moewen und das sanfte "
		  "Rauschen der Wellen.");
	   

  AddSound( ({"kreischen","moewen"}),
	   "Die Moewen kreischen hoch ueber Deinem Kopf.");

  AddSound( ({"rauschen","wellen"}),
           "Die Wellen rauschen leise und stroemen eine beruhigende Wirkung "
	   "auf Dich aus.");

  AddSound( ({"meer"}),
	   "Es rauscht.");
           
  

//-----Details Ende-----
  
AddExit("westen", ROOM "amazon3.lpc");
AddExit("osten", ROOM "amazon2.lpc");
AddExit("oben", "/d/luft/gwenshara/regenbogen/room/regenbogen_ende");
AddItem(NPC "amazone_patrouille.lpc", REFRESH_DESTRUCT);
}  
   
