// Burgmauer der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor der Waffenkammer");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier im suedlichsten Teil des Burghofes. Du stehst "
	"unmittelbar vor der Waffenkammer. Durch die grosse Tuer kannst Du "
	"ein paar Regale mit Speeren erkennen. Einige Amazonen ueben sich hier "
	"in Speerwurf. Zwei weitere Amazonen duellieren sich gerade. Hier "
	"ist es nicht so ruhig wie im noerdlichen Teil des Hofes, aber das "
	"liegt daran das hier der Trainingsort der Amazonen ist.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//----------Details Anfang--------------------------------------

  AddDetail( ({"hof","burghof","teil","burghofes","hofes"}), QueryProp(P_INT_LONG) );

    
  AddDetail( ({"boden","rasen","gras"}), 
            "Das Gras wurde hier etwas zusammengetrampelt.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist strahlend blau.");

  AddDetail( ({"waffenkammer","kammer","tuer","genaueres"}), 
            "Um Genaueres erkennen zu koennen musst Du die Kammer betreten.");

  AddDetail( ({"regale","regalen","speere","speeren"}), 
            "In den Regalen der Waffenkammer befinden sich lauter Speere.");

  AddDetail( ({"trainingsort","ort"}), 
            "Hier ist der Trainingsort der Amazonen.");

  AddDetail( ({"speerwurf","wurf"}), 
            "Tritt der Gilde bei dann musst Du Speerwurf auch ueben.");

  AddDetail( ({"gilde"}), 
            "Hier befindet sich die Gilde der Amazonen.");

  AddDetail( ({"amazonen"}), 
            "Einige Amazonen ueben Speerwurf, einige andere duellieren "
	    "sich.");

  AddDetail( ({"blumen"}), 
            "Viele schoene Blumen wachsen hier.");

  AddDetail( ({"bluetenduft","duft","nebengeruch","geruch","nase"}), 
            "Wofuer hast Du Deine Nase wenn Du sie nie benutzt?");


  AddDetail( ({"schmiede"}), 
            "Sehen kannst Du sie nicht, aber dafuer den beissenden Geruch "
	    "riechen.");

   AddDetail( ({"speer"}), 
            "Fast haette er Dich getroffen.");

   AddDetail( ({"zielscheibe","schwarze","ausweichen"}), 
            "Die Amazonen ueben hier.");

   AddDetail( ({"dienerin","amazone"}), 
            "Die Dienerin reicht der Amazone einen Speer.");




  
 
  
  AddSmell(DEFAULT_SMELL, "Du riechst hier sanften Bluetenduft und auch einen "
		  "beissenden Nebengeruch.");

  AddSmell( ({"bluetenduft","duft"}),
	   "Die vielen Blumen duften herrlich.");

  AddSmell( ({"nebengeruch","geruch"}), 
            "Der Geruch scheint aus der Schmiede zu kommen.");


    
  AddSound(DEFAULT_SOUND, "Die Amazonen plappern vergnuegt. Ab und zu hoerst "
		  "Du sie laut lachen.");
	   

  AddSound( ({"amazonen","plappern"}),
	  "Die Amazonen plappern vergnuegt vor sich hin.");
  
  AddSound( ({"lachen"}),
	  "Die Amazonen lachen lauthals.");

  AddRoomMessage( ({"Zwei Amazonen kaempfen miteinander.\n",
	          "Eine Amazone schmettert ihren Speer auf eine Zielscheibe.\n",
		  "'Verdammt! Fast haette ich ins Schwarze getroffen!'\n",
		  "Eine Dienerin reicht der Amazone einen Speer.\n",
		  "'Du musst das Ausweichen noch besser ueben!'\n",
		  "Die Amazone grummelt.\n",
		  "Ein Speer schiesst an Dir vorbei.\n",
		  "'Hey Du da! Geh weg hier bevor Du getroffen wirst!'.\n"}), 80);

//-----------Details Ende------------------  

  AddExit( "norden", "./brunnen");
  AddExit( "sueden", "./waffen");
  AddExit( "westen", "./burg4");
  AddExit( "osten", "./burg9");
}  
   
