// Burghof der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Hof der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier im Suedosteck des Burghofes. Hier befinden "
	"sich einige Vorrichtungen, an die man Pferde festbinden kann. "
	"Ausserdem siehst Du ein paar Kuebel hier herumstehen. Hier waechst "
	"nur sehr wenig Gras und auch die Blumen sind hier sehr spaerlich "
	"vertreten. Das liegt wahrscheinlich daran, das die Pferde alles "
	"anknabbern. Weiteres siehst Du hier einige Dienerinnen, die am Boden "
	"kauern und Decken fuer die Pferde naehen.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//--------Details Anfang------------------------------------

 AddDetail( ({"suedosteck","burghofes","burghof","hof","hofes"}), QueryProp(P_INT_LONG));


 AddDetail( ({"boden"}), 
            "Der Boden ist hier sehr erdig. Die Pferde haben das schoene "
	    "Gras zusammengetrampelt. Nur mehr wenig Gras waechst hier.");

 AddDetail( ({"himmel"}), 
            "Der Himmel ist strahlend blau.");
 
 AddDetail( ({"kuebel","teil"}), 
            "In einigen der Kuebel befindet sich noch etwas Wasser. Es dient "
	    "zum Teil um den Tieren den Durst zu stillen und auch um sie "
	    "zu waschen. In einem Kuebel befindet sich etwas Putzzeug.");
 
 AddDetail( ({"wasser","brunnen"}), 
            "Das Wasser stammt wohl aus dem Brunnen.");

 AddDetail( ({"durst","hitze","insel"}), 
            "Die Hitze auf der Insel macht die Pferde durstig.");

 AddDetail( ({"gras","blumen"}), 
            "Die Pferde haben hier das meiste Gras und die meisten Blumen "
	    "gefressen.");

 AddDetail( ({"dienerinnen","decken"}), 
            "Einige Dienerinnen kauern am Boden und naehen Decken fuer "
	    "die Pferde.");

 AddDetail( ({"pferde","pferden","tiere","tieren","pferd"}), 
            "Einige Pferde sind an den Vorrichtungen angebunden.");

 AddDetail( ({"vorrichtungen"}), 
            "Die Vorrichtungen sind einfache Holzbalken an denen einige "
	    "Metallringe befestigt worden sind. Sie sind dafuer da um die "
	    "Pferde festzubinden.");

 AddDetail( ({"metallringe","ringe","holzbalken","balken"}), 
            "An den Holzbalken sind einige Metallringe befestigt.");

 AddDetail( ({"putzzeug"}), 
            "Im Kuebel befindet sich etwas Putzzeug fuer die Pferde. Du "
	    "siehst einige Buersten, Striegel, Putzlappen und ein paar "
	    "Satinbaender.");

 AddDetail( ({"buersten"}), 
            "Mit den Buersten wird die Maehne der Pferde gebuerstet.");

 AddDetail( ({"maehne","schweif"}), 
            "Die Maehne der Pferde wird ordentlich gebuerstet. Manche Pferde "
	    "haben kleine Zoepfe in ihrer Maehne und ihrem Schweif.");

 AddDetail( ({"zoepfe","satinbaender","baender"}), 
            "In die Zoepfe der Pferde wurden hellblaue Satinbaender geflochten.");

 AddDetail( ({"putzlappen","lappen"}), 
            "Die Putzlappen dienen dazu, den Pferden den Schmutz und den "
	    "Schweiss vom Koerper zu waschen.");

 AddDetail( ({"schmutz","schweiss","tag"}), 
            "Du solltest jeden Tag duschen, egal ob Du schmutzig bist oder "
	    "nicht. Es ist einfach hygienischer.");

 AddDetail( ({"striegel"}), 
            "Mit dem Striegel wird das Fell der Pferde gestriegelt.");

 AddDetail( ({"fell"}), 
            "Alle Pferde haben ein glaenzendes Fell.");

 AddDetail( ({"geruch","koerpergeruch"}), 
            "Das musst Du riechen.");

  
  AddSmell(DEFAULT_SMELL, "Du riechst hier den Geruch der Pferde.");

  AddSmell( ({"geruch","pferde","koerpergeruch","koerper"}),
	   "Die Pferde haben einen angenehmen Koerpergeruch.");

   
  AddSound(DEFAULT_SOUND, "Einige der Pferde wiehern und Du hoerst die "
		  "Dienerinnen reden.");
	   

  AddSound( ({"dienerinnen","reden"}),
	  "Die Dienerinnen unterhalten sich angeregt.");
  
  AddRoomMessage( ({"'Wieher'.\n",
	          "Ein Pferd nagt an dem Holzbalken.\n",}), 80);


//---------------Details Ende----------------------------
  AddExit( "norden", "./burg8");
  AddExit( "suedostoben", "./mauer11");
  AddExit( "nordwesten", "./brunnen");
  AddExit( "westen", "./burg6");
}  
   
