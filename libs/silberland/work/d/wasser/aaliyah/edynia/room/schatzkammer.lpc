// von Aaliyah
// 24.01.2005
// 
// Schatzkammer der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Inmitten von Gold und Reichtum");
  SetProp( P_INT_LONG,
	"Du stehst hier in einem Raum aus purem Gold. Vor Dir tuermen sich "
	"riesige Berge von Goldmuenzen, Edelsteinen, Schmuck und Perlen. "
	"Ausserdem erkennst Du noch viele Goldschuesseln und Vasen aus purem "
	"Kristall. Der ganze Raum funkelt und glitzert und eine grosse Gier "
	"uebermannt Dich. Dieser prunkvolle Saal scheint endlos gross zu sein. "
	"Du bist ueberwaeltigt von all dem Reichtum und wuerdest am liebsten "
	"all das Gold in Deine Taschen stecken.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//----------Details Anfang--------------------------------------

  AddDetail( ({"raum","raumes","saal","saales"}), QueryProp(P_INT_LONG) );

  
  AddDetail( ({"vasen","kristall"}), 
            "Die Vasen bestehen aus edlem Kristall.");

  AddDetail( ({"gier","taschen","reichtum"}), 
            "Du musst Deine rechte Hand festhalten um nicht alles Gold in "
	    "Deine Taschen zu stecken.");

  AddDetail( ({"hand"}), 
            "Deine rechte Hand zuckt und will all das ganze Gold ergreifen.");
AddDetail( ({"vasen","kristall"}), 
            "Die Vasen bestehen aus edlem Kristall.");

    
  AddDetail( ({"boden"}), 
            "Der Boden besteht aus vielen kleinen Goldplatten, die zu einem "
	    "atemberaubenden Mosaik zusammengefuegt wurden.");

  AddDetail( ({"mosaik"}), 
            "Viele kleine Goldplatten wurden zu einem Mosaik zusammengefuegt. "
	    "Sie sind mit bunten Edelsteinsplittern verziert und strahlen "
	    "einen enormen Glanz aus.");
	  
  AddDetail( ({"reichtums","reichtum","amazonen","geldmuenzen"}), 
            "Die Amazonen sind anscheinend sehr wohlhabend.");


  AddDetail( ({"platten","goldplatten"}), 
            "Fein geschliffene kleine Goldplatten.");

  AddDetail( ({"edelsteinsplittern","edelsteinsplitter","splitter"}), 
            "Die Edelsteinsplitter glaenzen und funkeln im Kerzenlicht.");

  AddDetail( ({"kerzenlicht","kerzen","licht","kerzenhalter","halter"}), 
            "An den Waenden befinden sich viele schoene Kerzenhalter. Sie "
	    "bestehen aus purem Gold und ihre Kerzen tauchen den Raum in ein "
	    "warmes Licht.");

  AddDetail( ({"goldes","gold"}), 
            "Hier besteht alles aus purem Gold. Es funkelt und glaenzt und hat "
	    "den Anschein als wuerde es taeglich poliert werden.");

  AddDetail( ({"anschein","dinge"}), 
            "Manche Dinge scheinen so wie sie eigentlich gar nicht sind. Das "
	    "nennt man eine Illusion.");

  AddDetail( ({"illusion"}), 
            "Laesst Du Dich gerne blenden?");

  AddDetail( ({"berge","goldmuenzen","muenzen"}), 
            "Vor Dir tuermen sich riesige Berge von Goldmuenzen.");

  AddDetail( ({"edelsteinen","schmuck","edelsteine","perlen"}), 
            "Was wuerdest Du nur dafuer geben, einen kleinen Anteil dieses "
	    "Reichtums Dein Eigen nennen zu duerfen.");


  AddDetail( ({"anteil","reichtums","eigen"}), 
            "Du bist arm wie eine Kirchenmaus. Am besten Du suchst Dir ein "
	    "lauschiges Plaetzchen unter einer Bruecke.");

   AddDetail( ({"kirchenmaus","plaetzchen","bruecke","penner"}), 
            "Du bist einfach nur ein Penner.");

   AddDetail( ({"schuesseln","goldschuesseln"}), 
            "Die Goldschuesseln sind mit vielen Perlen verziert. Eine "
	    "Goldschuessel sieht jedoch ein klein wenig anders aus.");

   AddDetail( ({"goldschuessel","land"}), 
            "Die Goldschuessel ist etwas anders als die anderen. Anscheinend "
	    "stammt sie aus einem fernen Land.");


   AddDetail( ({"muenzen","klimpern","feyaria","geruch","geldberg"}), 
            "Feyaria teilt Dir mit: wir muessen uns mal unterhalten.");

   AddDetail( ({"verstand"}), 
            "Sowas besitzt Du doch gar nicht.");

  AddDetail( ({"etwas","unglueck"}), 
            "Zuviel Gold macht die Leute neidisch.");

  AddDetail( ({"leute"}), 
            "Die Leute sind doch um alles neidisch. Egal was, sie moechten "
	    "alles haben. Wenn sie jedoch zufrieden waeren, mit dem was sie "
	    "haben, waeren sie um einiges gluecklicher.");

  AddDetail( ({"perlenkette","amazone"}), 
            "Die Amazone hat sich nur schnell eine Perlenkette gekrallt und "
	    "ist schon wieder weg.");

 
  
  AddSmell(DEFAULT_SMELL, "Du riechst hier den Geruch von Gold und Reichtum.");

  AddSmell( ({"reichtum","gold","goldes","geruch"}),
	   "Der Geruch des Goldes raubt Dir fast den Verstand.");

      
  AddSound(DEFAULT_SOUND, "Du hoerst hier leise das Klimpern von Muenzen.");
	   

  AddSound( ({"muenzen","klimpern"}),
	  "Einige der unzaehligen Muenzen rieseln von einem riesigen Geldberg.");
  
  AddRoomMessage( ({"Ein paar Muenzen rieseln von einem Geldberg.\n",
	          "Eine Amazone schmueckt sich mit einer Perlenkette.\n",
		  "Die Gier uebermannt Dich.\n",
		  "Du moechtest all das Gold mitnehmen.\n",
		  "Etwas fluestert: Gold bringt Unglueck!\n"}), 80);

//-----------Details Ende------------------  

  AddExit( "norden", "./brunnen");
  AddExit( "sueden", "./waffen");
  AddExit( "westen", "./burg4");
  AddExit( "osten", "./burg9");
}  
   
