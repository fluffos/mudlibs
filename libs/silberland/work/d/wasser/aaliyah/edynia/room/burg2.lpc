// von Aaliyah
// 29.01.2005
// 
// Hof der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Hof der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du befindest Dich am Hof der Amazonenburg. Die Amazonen haben "
	"hier eine wunderbare Idylle geschaffen. Der satte gruene Rasen ist "
	"wunderbar gepflegt und ueberall wurden schoene Blumen gepflanzt. "
        "Viele Amazonen sitzen am Boden und lassen sich von den Dienerinnen "
	"mit kuehlen Getraenken bewirten. Im Osten erkennst Du einen grossen "
	"Brunnen und im Westen gelangst Du wieder zum Tor zurueck.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//----------Details Anfang------------

  AddDetail( ({"hof","burghof"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"amazonenburg","burg"}), 
            "Die Burg ragt rund um Dich majestaetisch in den Himmel empor. "
	    "Die Tuerme der Burg sind so hoch, das Du das Gefuehl hast, sie "
            "wuerden die direkte Verbindung zwischen Himmel und Erde sein.");

  AddDetail( ({"tuerme","tuermen"}), 
            "An jedem der Tuerme flattert die hellblaue Fahne der Amazonen.");
 
  AddDetail( ({"verbindung","erde","gefuehl"}), 
            "Vielleicht gelangen die Amazonen ueber die Tuerme zu ihren "
            "Goettern.");
  
  AddDetail( ({"goetter","goettern","macht"}), 
            "Die Amazonen kaempfen mit der Macht der Goetter.");
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist strahlend blau und wolkenlos.");
  
  AddDetail( ({"idylle"}), 
            "Du fuehlst Dich hier ausgesprochen wohl.");
  
  AddDetail( ({"fahne","fahnen"}), 
            "Die Fahnen der Amazonen sind hellblau und haben eine goldene "
	    "Umrandung. In der Mitte jeder Fahne ist das Wappen der Burg "
	    "aufgestickt.");
  
  AddDetail( ({"wappen","mitte","speer","schlangen"}), 
            "Zwei ineinandergeschlungene Schlangen mit einem Speer in der "
	    "Mitte.");
  
  AddDetail( ({"umrandung"}), 
            "Jede Fahne hat eine goldene Umrandung.");
  
  AddDetail( ({"blumen"}), 
            "Eine Vielfalt von Blumen wurden hier angepflanzt.");
  
  AddDetail( ({"vielfalt","orchideen","lilien","rosenbuesche","buesche"}), 
            "Viele Orchideen, Lilien und Rosenbuesche befinden sich hier.");
  
  AddDetail( ({"rasen","boden"}), 
            "Der Rasen ist sehr gepflegt.");
  
  AddDetail( ({"dienerinnen","getraenken","getraenke","getraenk"}), 
            "Die Dienerinnen servieren den Amazonen kuehle Getraenke. "
	    "Wie gerne haettest Du jetzt auch so ein Getraenk.");
  
  AddDetail( ({"amazonen","speerkampf"}), 
            "Einige Amazonen sitzen auf dem Boden, einige stehen um den "
	    "Brunnen herum und einige ueben sich im Speerkampf.");
  
  AddDetail( ({"osten","brunnen"}), 
            "Ein grosser Brunnen befindet sich oestlich von Dir.");
  
  AddDetail( ({"westen","tor"}), 
            "Im Westen gelangst Du wieder zum Tor zurueck.");
  
  AddDetail( ({"nase","gerueche"}), 
            "Benutz Deine Nase doch zum riechen.");
  
  AddDetail( ({"pferde","stimmenwirrwarr","ohr"}), 
            "Benutz doch einmal Dein Ohr, wofuer hast Du es denn?");
  
  AddDetail( ({"rose","haare","gruppe","feyaria","forscherpunkt","maenner"}), 
            "Feyaria teilt Dir mit: hm hier gibt es keinen forscherpunkt.");
 
  
 
  AddSmell(DEFAULT_SMELL, "Viele verschiedene Gerueche umschmeicheln "
		  "Deine Nase.");

  AddSmell( ({"gerueche"}),
	   "Wuerzig und blumige Gerueche.");

    
  AddSound(DEFAULT_SOUND, "Wildes Stimmenwirrwarr dringt an Dein Ohr. "
		  "Ausserdem hoerst Du noch ein paar Pferde wiehern.");
	   

  AddSound( ({"stimmenwirrwarr","amazonen"}),
	  "Die Amazonen plappern vergnuegt vor sich hin.");
  
  AddSound( ({"pferde","wiehern"}),
	  "Irgendwo scheinen Pferde zu sein.");

  AddRoomMessage( ({"Eine Gruppe von Dienerinnen huscht an Dir vorbei.\n",
	          "Zwei Amazonen kaemmen sich gegenseitig die Haare.\n",
		  "'Ja, deswegen sind es ja Maenner!'\n",
		  "Die Amazonen kichern.\n",
		  "'Und dann hat er mir noch eine Rose geschenkt!'\n",
		  "Die Amazonen lachen laut auf.\n"}), 80);

  AddItem(NPC "amazone_wache", REFRESH_DESTRUCT);

//-------Detail Ende-------------
 

  AddExit( "norden", "./burg3");
  AddExit( "sueden", "./burg4");
  AddExit( "westen", "./burg1");
  AddExit( "osten", "./brunnen");
} 
   
