// Kerker der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Kerker der Amazonen");
  SetProp(P_INT_LONG,
      "Du befindest Dich hier im Kerker der Amazonen. Hier werden Frevler und "
      "Missetaeter gefangen gehalten. Durch ein kleines, vergittertes Fenster "
      "dringt ein wenig Licht in den Raum. Die Kammer ist voellig unmoebliert. "      "In einer Ecke liegt ein kleiner Strohhaufen, der wohl als Schlafstaette "
      "dienen soll. Die Kammer ist so unfreundlich, dass Du sie so schnell wie "
      "moeglich wieder verlassen moechtest.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//--------------Details Anfang--------------------------------

  AddDetail( ({"kammer","kerker","raum"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"amazonen","frevler","missetaeter"}), 
            "Die Amazonen sperren hier die Frevler und Missetaeter ein.");

  AddDetail( ({"strohhaufen","haufen","schlafstaette","ecke"}), 
            "Ein frischer Strohhaufen liegt in einer Ecke. Er dient den "
	    "Gefangenen als Schlafstaette.");
 
  
  AddDetail( ({"amazonen","frevler","missetaeter"}), 
            "Die Amazonen sperren hier die Frevler und Missetaeter ein.");

  
  AddDetail( ({"gefangenen"}), 
            "Manche fuehlen sich auch gefangen, wenn sie einen Ehering am "
	    "Finger haben. Sie versuchen dann auszubuechsen, was dann nur "
	    "zu endlosen Debatten und Streitereien fuehrt. Und im Endeffekt "
	    "kommen alle drauf, das es sich nicht gelohnt hat, denn man "
	    "versaeumt sowieso nichts.");

  
  AddDetail( ({"streitereien","debatten","streithansel","eheberatung"}), 
            "Bist Du auch so ein Streithansel?");

  AddDetail( ({"ring","finger","ehering","endeffekt","effekt"}), 
            "Du ueberlegst Dir, ob Du zu einer Eheberatung gehen solltest.");

  AddDetail( ({"fenster","licht","gitter"}), 
            "Durch ein kleines Fenster dringt etwas Licht in die Kammer. Dicke "
	    "Gitter verhindern, dass die Gefangenen ausbuechsen koennen.");

  
  AddDetail( ({"wand","waende","boden","decke","stein"}), 
            "Hier besteht alles aus Stein.");

  AddDetail( ({"stroh","kopf"}), 
            "Dir faellt ein, dass Du in Deinem Kopf noch etwas Stroh hast.");

  AddDetail( ({"gespenster","menschen"}), 
            "Siehst Du tote Menschen?");



  AddSmell(DEFAULT_SMELL, "Du riechst hier lediglich Stroh.");
 
  AddSmell( ({"stroh"}),
	   "Das Stroh riecht irgendwie strohig.");
    
  AddSound(DEFAULT_SOUND, "Du hoerst hier absolut nichts.");
	   

  AddSound( ({"nichts"}),
	  "Nichts fluestert: Hoerst Du Gespenster?");

//----------------Details Ende------------------------ 

  AddExit( "unten", "./turm8_4");
}  
   
