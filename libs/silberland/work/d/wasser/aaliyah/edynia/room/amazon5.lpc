inherit "std/room";
#include "../def.h"



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer Schlucht");
  SetProp( P_INT_LONG,
	"Du stehst in einem steilen Durchgang inmitten der Klippen. "
       	"Der Weg ist so schmal sodass keine zwei Oger nebeneinander Platz "
	"haetten. Rings um Dich herum befinden sich steile Felswaende, die "
	"spitz in den Himmel ragen. Du hast das Gefuehl das sie Dich erdruecken "
	"und bekommst einen leichten Anfall von Platzangst. Im Osten erkennst "
	"Du einen Spalt, durch den Du locker hindurch gehen koenntest.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( "durchgang", QueryProp(P_INT_LONG) );

  AddDetail( ({"klippen"}), 
            "Du stehst gerade mitten drin.");

  AddDetail( ({"durchgang","weg"}), 
            "Der Durchgang ist sehr schmal und fuehrt zwischen den Klippen "
	    "hindurch ins Ungewisse.");

  AddDetail( ({"felsen","felswaende","waende"}), 
            "Die Felsen sind so steil das es unmoeglich scheint, sie ueberwinden "
	    "zu koennen.");
 
  AddDetail( ({"platzangst"}), 
            "Die Felsen scheinen immer naeher auf Dich zu zukommen.");
 
  AddDetail( ({"gefuehl"}), 
            "Dein Gefuehl hat schon oefters versagt.");

  AddDetail( ({"oger"}), 
            "Oger sind dicke, plumpe Wesen ohne einen Funken von Anmut.");

  AddDetail( ({"du","dich"}), 
            "Fuehlst Du Dich noch nicht genug angesprochen?");

  AddDetail( ({"himmel"}), 
            "Ober Dir befindet sich wunderschoener blauer Himmel.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist erdig und viele kleine Felssplitter liegen hier "
	    "herum.");
  
  AddDetail( ({"erde"}), 
            "Das bisschen Erde was hier zu finden ist, ist kaum der Rede wert.");

  AddDetail( ({"rede"}), 
            "Es ist schade um jedes Wort.");
 
  
  AddDetail( ({"wort"}), 
            "Du bist wohl nicht sehr wortkarg oder?");

  
  AddDetail( ({"felssplitter","felssplittern"}), 
            "Der Boden ist uebersaeht von Felssplittern.");
 
  AddDetail( ({"wesen"}), 
            "Elfen zum Beispiel.");
 
  AddDetail( ({"beispiel"}),
	     "Es war ja nur ein Beispiel.");	  

  AddDetail( ({"elfen","anmut","geschoepfe"}),
	    "Elfen sind die anmutigsten Geschoepfe ueberhaupt!");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau. Leider wird die Sonne von den "
	    "steilen Klippen vollkommen verdeckt.");
	 
  AddDetail( ({"sonne"}),
	    "Die Sonne versteckt sich hinter den Klippen.");
  
  AddDetail( ({"platz","schlucht"}),
	    "Ziemlich eng hier was?");  

  AddDetail( ({"funken"}), 
            "Oger haben nicht einmal einen kleinen Funken von Anmut.");

  AddDetail( ({"anfall"}),
	    "Du zuckst aus.");

  AddDetail( ({"spalt","osten"}),
	    "Durch den Spalt gelangst Du nach Osten.");

  AddDetail( ({"ungewisse"}),
	    "Der Weg fuehrt ins Ungewisse. Du weisst nicht wo er endet.");
 
  
  AddSmell(DEFAULT_SMELL, "Die Luft hier ist sehr erfrischend und klar.");

  AddSmell( ({"luft"}),
	   "Du atmest einmal ganz tief durch. Oh wie das guttut.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier nur den Wind, der durch die Schlucht "
		  "heult.");
	   

  AddSound( ({"wind"}),
	   "Der Wind heult durch die Schlucht und irgendwie klingt es sehr "
	   "sehr unheimlich.");

           
  

//-----Details Ende-----
  
  AddExit("nordwestoben", ROOM "amazon7.lpc");
  AddExit("suedwestunten", ROOM "amazon4.lpc");
  AddExit("osten", ROOM "amazon6.lpc");
}
