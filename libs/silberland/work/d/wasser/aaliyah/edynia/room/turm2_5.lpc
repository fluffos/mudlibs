// von Aaliyah
// 11.02.2005
// 
// Gemach der Amazonenburg
 
#include "../def.h"
#include <ansi.h>
inherit "std/room";

int grundzustand();
int schrank_offen;
int stab_da;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Schlafgemach");
  SetProp(P_INT_LONG,
      "Du stehst in einem kleinen Gemach. Hier besteht alles aus hellblauer "
      "Seide. Die Wand wird mit hellblauen Seidenbahnen verdeckt und lassen "
      "nur das Fenster frei, durch das einige Sonnenstrahlen in den Raum "
      "dringen. In der Mitte des Raumes steht ein grosses Himmelbett. In einer "      
      "Ecke befindet sich eine schoene grosse Vase mit frischen, hellblauen "
      "Rosen. Weiters erkennst Du einen kleinen Tisch mit einem Schemel davor "
      "und einem grossen Spiegel darueber. Der Boden wird von hellblauen "
      "Seidenteppichen fast vollkommen bedeckt, die sich edel um einen weissen "
      "Schrank wallen.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1 );

//-------------Details Anfang---------------------------


 AddDetail( ({"schlafgemach","gemach","raum","raumes"}), QueryProp(P_INT_LONG) );

 
  AddDetail( ({"seide","waende","seidenbahnen","wand","decke","waenden"}),
	  "Der gesamte Raum besteht aus hellblauer Seide. Die Waende, der "
	  "Boden und selbst die Decke wird von hellblauen Seidenbahnen bedeckt.");


  AddDetail( ({"boden","teppiche","seidenteppiche","seidenteppichen"}),
	  "Hellblau glaenzende Seidenteppiche bedecken den ganzen Boden. "
	  "Sie reflektieren das Sonnenlicht und bringen den Raum zum glitzern.");

 
  AddDetail( ({"licht","sonnenlicht","strahlen","sonnenstrahlen"}),
	  "Sanfte Sonnenstrahlen dringen durch das Fenster und reflektieren "
	  "sich in der hellblauen Seide.");

  
  AddDetail( ({"fenster"}),
	  "Das Fenster ist wunderschoen geschwungen.");
  
  AddDetail( ({"bett","mitte","himmelbett"}),
	  "In der Mitte des Raumes befindet sich ein praechtiges Himmelbett. "
	  "Viele hellblaue Seidenkissen liegen darauf und auch die hellblaue "
	  "Seidendecke ist ein wahrer Traum.");
  
  AddDetail( ({"verzierungen","kissen","seidenkissen"}),
	  "Die Seidenkissen weisen goldene Verzierungen auf.");
  
  AddDetail( ({"traum","seidendecke","saum"}),
	  "Die hellblaue Seidendecke ist einfach ein Traum. Sie glaenzt "
	  "im Sonnenlicht und ist am Saum golden verziert.");
  
  AddDetail( ({"ecke","vase","rosen"}),
	  "Eine grosse, goldene Vase steht in der Ecke des Raumes. Sie ist "
	  "mit hellblauen Rosen gefuellt.");
  
  AddDetail( ({"schemel","tisch"}),
	  "Auf dem Tisch befindet sich eine Schale mit frischem Wasser. Davor "
	  "steht ein kleiner unbedeutender Schemel.");
  
  AddDetail( ({"schale","wasser","hygiene"}),
	  "Das Wasser dient der Hygiene.");

  AddDetail( ({"holz"}),
	  "Weisses Holz.");

  AddSpecialDetail( ({"schrank", "kleiderschrank"}), "d_schrank");
  
  
  AddDetail( ({"spiegel","spieglein","schoenste","land"}),
	  "Spieglein Spieglein an der Wand, wer ist die Schoenste im ganzen "
	  "Land?");


  AddSmell(DEFAULT_SMELL, "Die Rosen in der Vase duften herrlich.");
 
  AddSmell( ({"rosen"}),
	   "Die Rosen duften einfach himmlisch.");
    
  AddSound(DEFAULT_SOUND, "Hier ist es absolut still.");
	   
//----------Details Ende---------------------------------

 
  AddExit( "unten", "./turm2_4");
  AddCmd( ({ "oeffne" }), "c_oeffnen");
  AddCmd( ({ "nimm" }), "c_herausnehmen");
  
  grundzustand();
}  
 reset()
 {
  ::reset();
  grundzustand();
 }
  void grundzustand()
{
  schrank_offen = 0;
  tell_room(TO, "Die Schranktuer wird vom Wind geschlossen.\n");
  stab_da = 1;
}
  int c_oeffnen(string str)
{
    notify_fail(BS("Was moechtest Du hier denn oeffnen?"));
   if(!(str == "schrank"))
   {
     return 0;
   }
   if(schrank_offen) 
   {       
   write("Aber der Schrank ist doch schon offen.\n");
    return -1;
   }
   else
   {
     write(BS("Du oeffnest den Schrank und siehst einen kristallinen Stab "
              "zwischen dem ganzen Zeug funkeln."));
      tell_room(ENV(TP), TPN+" oeffnet den Schrank.\n", ({TP}));
      schrank_offen = 1;
      
    AddDetail( ({"zeug"}),
        "Das Zeug interessiert Dich nicht so wie der Stab.");

    AddDetail( ({"stab","kristallstab"}),
        "Tatsaechlich! Ein Kristallstab befindet sich im Schrank. Wenn Du magst, "
	"kannst Du ihn ja nehmen.");
  return 1;
     }
  }
  int c_herausnehmen(string str)
{
  
   notify_fail(BS("Was moechtest Du woraus nehmen?"));
   if(!(str == "stab aus schrank") ||
       (str == "kristallstab aus schrank") ||
       (str == "stab heraus") ||
       (str == "kristallstab heraus"))
   {
     return 0;
   }  
   if(present("stab", ENV(TP)) || (stab_da==0))
   {
     write(BS("Du reibst Dir unglaeubig die Augen. Hier gibt es keinen Stab. "
	      "Du hast Dich wohl getaeuscht. Schade!"));
     return 1;
    }
    else
    {
      write(BS("Du nimmst den Kristallstab aus dem Schrank."));
      tell_room(ENV(TP), TPN+" macht irgendwas.\n", ({TP}));
      stab_da = 0;
      CLONE ( "/gilden/amazonen/questobj/kristallstab", TP);
      
      return -1;
    }
 }
    string _query_int_long()
{ 
  string s;

  s=::_query_int_long();
 

  if(TP && interactive(TP) && IS_WIZARD(TP))
  { 
    if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_BOLD+ANSI_CYAN;

    switch(stab_da)
    { 
      case 0:
        break;

      case 1:
        s += "Es gibt 1 Kristallstab hier.";
        break;

      default:
        s += sprintf("Es gibt %d Kristallstaebe hier.",stab_da);
        break;
    }

    s += "\n";

   if(TP->QueryProp(P_TTY) == "ansi") s += ANSI_NORMAL;
  }
  
  return s;
}
   string d_schrank(string str)
  {
   string s;
   
   if(schrank_offen)
   {
    s = "Der Schrank besteht aus weissem Holz. Da er geoeffnet ist "
        "kannst Du hineingucken. Etwas Zeug befindet sich im Schrank.";
   }
   else
   {
    s = "Der Schrank besteht aus weissem Holz. Er ist geschlossen.";
   }
   return BS(s);
   }

   
