// Brunnen in der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Beim Brunnen in der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du stehst genau in der Mitte des Burghofes. Vor Dir befindet sich "
	"ein mit Steinbloecken eingefasster Springbrunnen. Wunderschoene "
	"Wasserrosen schwimmen auf der Wasseroberflaeche und in der Mitte "
	"befindet sich eine Wasserfontaene. Rund um den Brunnen sitzen "
	"einige Amazonen und unterhalten sich. Ein paar Dienerinnen fuellen "
	"hier ihre Eimer mit Wasser. Am liebsten wuerdest Du hier noch etwas "
	"verweilen und die Ruhe dieses Ortes geniessen. ");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1 );

//-----------Details Anfang----------------------
  
  AddDetail( ({"hof","burghof","mitte","burghofes"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"springbrunnen","brunnen"}),
	  "Der Brunnen wurde sehr liebevoll angelegt. Er wird von weissen "
          "Steinbloecken eingefasst und in der Mitte spritzt eine Fontaene "
	  "mit klarem Wasser in die Luft.");

  AddDetail( ({"steinbloecken","steinbloecke","bloecke","bloecken"}), 
            "Viele weisse Steinbloecke fassen den Brunnen ein.");
  
  AddDetail( ({"wasserfontaene","fontaene"}), 
            "Eine Fontaene mit klarem Wasser spritzt in die Hoehe.");

  AddGenderDetail( ({"hoehe"}), 
            "Hast Du schon einmal etwas gesehen das so hoch spritzt?",
	    "Kannst Du auch so hoch spritzen?");

  AddDetail( ({"wasser","wassers","plaetschern"}), 
            "Der Brunnen ist gefuellt mit kaltem klarem Wasser.");

  AddDetail( ({"eimer","dienerin"}), 
            "Die Dienerinnen fuellen hier ihre Eimer mit Wasser.");

  AddDetail( ({"dienerinnen"}), 
            "Viele Dienerinnen huschen hier in ihren hellblauen Togas ueber "
	    "den Hof.");

  AddDetail( ({"togas","toga"}), 
            "Jede der Dienerinnen hat eine huebsche hellblaue Toga an.");

  AddDetail( ({"amazonen","amazone"}), 
            "Einige Amazonen sitzen um den Brunnen und lassen ihre nackten "
	    "Fuesse in das Wasser baumeln.");

  AddDetail( ({"fuesse"}), 
            "An einem der Fuesse kannst Du ein Glitzern erkennen.");

  AddDetail( ({"fuss","glitzern"}), 
            "Bei dem Glitzern handelt es sich um ein Fusskettchen.");

  AddDetail( ({"fusskettchen"}), 
            "Du koenntest es ja versuchen der Amazone vom Fuss zu streifen.");

  AddDetail( ({"ruhe","ortes","ort"}), 
            "Du geniesst die Ruhe des Ortes.");

  AddDetail( ({"luft"}), 
            "Die Luft hier ist kristallklar.");

  AddDetail( ({"wasserrosen","wasseroberflaeche","oberflaeche","wasserrose"}), 
            "Viele weisse Wasserrosen schwimmen ueber die Wasseroberflaeche.");

  AddDetail( ({"rasen","boden","gras","gruen"}), 
            "Du stehst auf einem wunderbar gepflegten Rasen. Das Gras waechst "
	    "hier in einem satten Gruen und wird offensichtlich regelmaessig "
	    "geschnitten.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ober Dir ist strahlend blau.");
  
  AddDetail( ({"ruestung"}), 
            "Deine Ruestung ist schon ganz nass.");

  
    
  AddSmell(DEFAULT_SMELL, "Du riechst die reine, klare Luft.");

  AddSmell( ({"luft"}),
	   "Die Luft ist klar.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier einige Amazonen sprechen und auch "
		  "noch das Plaetschern des Springbrunnens.");
	   

  AddSound( ({"springbrunnen","springbrunnens","plaetschern"}),
	  "Das Wasser des Springbrunnens plaetschert monoton.");
  
  AddSound( ({"amazonen"}),
	  "Die Amazonen unterhalten sich angeregt.");

  AddRoomMessage( ({"Das Wasser plaetschert.\n",
	          "Eine Dienerin trinkt etwas Wasser.\n",
		  "Die Amazonen kichern.\n",
		  "Etwas Wasser spritzt auf Deine Ruestung.\n",
		  "Eine Amazone fischt nach einer Wasserrose.\n",
		  "Die Amazonen grinsen Dich an.\n",
		  "Die Amazonen verstummen kurz.\n"}), 80);
 
//---------Details Ende---------------------

  AddExit( "norden", "./burg5");
  AddExit( "sueden", "./burg6");
  AddExit( "osten", "./burg8");
  AddExit( "westen", "./burg2");
  AddExit( "suedosten", "./burg9");
  AddExit( "nordwesten", "./burg3");
  AddExit( "suedwesten", "./burg4");
 
//------Kommandos Anfang-------------------

 AddCmd( ({ "streife", "streif" }), "c_herunterstreifen");
}  

 int c_herunterstreifen(string str)
{
   notify_fail(BS("Was moechtest Du hier wo herunterstreifen?"));
   if(!(str == "fusskettchen von fuss" || str == "fusskettchen von fuss ab"))
   {
     return 0;
   }
   write(BS("Du willst gerade der Amazone das Fusskettchen herunterstreifen, "
	    "als sie sich empoert zu Dir wendet. Sie starrt Dich entsetzt an "
            "und verpasst Dir eine schallende Ohrfeige."));
   tell_room(ENV(TP), TPN+" wird von einer Amazone geohrfeigt.\n", ({TP}));
   TP->AddHp(-70);
   return 1;
}
 
