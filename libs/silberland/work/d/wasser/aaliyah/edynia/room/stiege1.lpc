// 16.02.2005
// 
// Stiege in den Keller der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einer duesteren Stiege");
  SetProp(P_INT_LONG,
	"Du befindest Dich vor einer Stiege. Sie fuehrt tief hinunter in die "
	"die Dunkelheit. Hier besteht alles aus Stein. Die Waende, die Decke "
	"und auch der Boden. Vom schoenen Marmor der Burg ist hier nicht mehr "
	"viel uebrig. Ausserdem erkennst Du an den Waenden einige Fackeln, die "        "dem Raum etwas Licht spenden. Es ist fraglich ob Du in die Tiefen "
	"hinuntersteigen solltest.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 0);

//----------Details Anfang---------------------------------
 
  AddDetail( ({"raum","raumes"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"stiege"}),
	  "Grosse Steinstufen fuehren hinunter in die Dunkelheit. Es ist "
          "ungewiss was dort unten auf Dich lauert.");	 

  AddDetail( ({"stufen","steinstufen"}),
	  "Die Steinstufen bestehen aus Stein. An manchen Stellen broeckeln "
	  "sie schon ab. Anscheinend ist hier etwas sehr Grosses und Schweres "
	  "nach unten gegangen.");

  AddDetail( ({"stellen","teil"}),
	  "Der Stein an den Stufen ist zum Teil abgebroeckelt.");

  AddDetail( ({"decke","boden","stein"}),
	  "Hier besteht alles aus Stein.");

  AddDetail( ({"marmor"}),
	  "Hier besteht aber auch gar nichts aus Marmor.");
  
  AddDetail( ({"tiefen","dunkelheit"}),
	  "Die Stufen fuehren hinunter in die Dunkelheit.");

  AddDetail( ({"burg"}),
	  "Dieser Teil der Burg ist nicht sehr ansehlich.");

   
  AddDetail( ({"waende","waenden"}),
	  "An den Waenden befinden sich einige Fackeln, die duerftiges Licht "
	  "spenden.");

  AddDetail( ({"laerm","streitwaegen","geplapper"}),
	  "Das kannst Du nur hoeren und nicht sehen.");
 
  
  AddDetail( ({"fackeln","fackel","licht"}),
	  "Einige Fackeln spenden duerftiges Licht. Es ist sehr schumrig "
	  "hier und Dir ist etwas mulmig.");

  AddDetail( ({"berserker","amazonen"}),
	  "Die Amazonen laestern ueber Berserker.");

  AddDetail( ({"streitwaegen","laerm","waegen"}),
	  "Die knarrenden Streitwaegen machen einen ganz schoenen Laerm.");
 
 

  AddSmell(DEFAULT_SMELL, "Hier riecht es sehr modrig und alt. Ausserdem "
		  "riecht es noch etwas erdig.");

  AddSmell( ({"moder","erde"}),
	   "Es riecht hier so modrig das Dir beinahe uebel wird.");

    
  AddSound(DEFAULT_SOUND, "Von draussen dringt ein wenig Geplapper und "
		  "der Laerm der Streitwaegen.");
	   

  AddSound( ({"geplapper"}),
	  "Einige Amazonen stehen vor der Tuer und laestern ueber Berserker.");
  
  
  AddSound( ({"laerm","streitwaegen","waegen"}),
	  "Die Streitwaegen knarren und quietschen.");
 

   AddExit( "unten", "./stiege2");
  NewDoor( "sueden", ROOM "burg1", ({"tuer", "eisentuer"}),
      ({ D_NAME,"Eisentuer",
       D_GENDER, FEMALE,
       D_SHORT,"Im Sueden siehst Du eine %se Eisentuer.",
       D_LONG, "Die Eisentuer schaut sehr stabil aus. Sie ist mannshoch "
               "und sehr breit. Dem riesigen Schluesselloch zufolge braucht "
               "man einen sehr grossen Schluessel, um diese Tuere aufsperren "
               "zu koennen.\n",
       D_FLAGS, DOOR_CLOSED|DOOR_NEEDKEY|DOOR_RESET_CL,
       D_RESET_CLOSEMSG, " wird von einer Dienerin versperrt.",
       }) );
}  
   
