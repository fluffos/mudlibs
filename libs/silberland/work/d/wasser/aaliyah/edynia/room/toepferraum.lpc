// 6.Jaenner 2006
// by Aaliyah
// Toepferraum

 
inherit "std/room";
#include "../def.h"



 
void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Toepferraum der Amazonen");
  SetProp( P_INT_LONG,
	"Der Toepferraum der Amazonen ist etwas duester. Einige Sonnenstrahlen "
	"dringen durch ein staubiges Fenster und erhellen die Kammer leicht. "
	"Unzaehlige Regale wurden an den Waenden angebracht. In ihnen stehen "
	"lauter Tontoepfe und Schalen. Eine grosse Toepferscheibe befindet "
	"sich in der Mitte des Raumes und wartet nur darauf benutzt zu werden. "
	"Neben ihr steht ein Eimer mit frischem Wasser. Ansonsten ist dieser "
	"Raum nicht sonderlich interessant.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail(( {"raum","raumes","kammer","toepferraum"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"boden","marmorboden"}), 
            "Der weisse Marmorboden ist mit ziemlich viel Staub bedeckt.");

  AddDetail( ({"staub","staubpartikel"}), 
            "Es ist fraglich ob es sich hierbei um natuerlichen Staub oder "
	    "vielmehr um trockene Tonpartikel handelt.");

  AddDetail( ({"partikel","tonpartikel","tonfusel"}), 
            "Wenn hier getoepfert wird, gelangt sicher der eine oder andere "
	    "Tonfusel in die Atmosphaere.");
 
  AddDetail( ({"atmosphaere"}), 
            "Im Spiel der Sonnenstrahlen tummeln sich unzaehlige Staubpartikel.");
 
  AddDetail( ({"spiel","sonne","sonnenstrahlen","strahlen"}), 
            "Einige Sonnenstrahlen dringen durch das staubige Fenster.");

  AddDetail( ({"fenster"}), 
            "Allzu gross ist das Fenster nicht. Das ist auch der Grund wieso "
	    "es hier nicht sehr hell ist. Ausserdem ist es ziemlich staubig "
	    "und sollte wieder mal geputzt werden.");

  AddDetail( ({"grund"}), 
            "Es gibt fuer alles im Leben einen Grund.");

  AddDetail( ({"leben"}), 
            "Du lebst, mach was draus!");
  
  AddGenderDetail( ({"decke", "frau", "mann"}),
            "Bist Du so eine, die in manchen Situationen an die Decke starrt?",
            "Moechtest Du eine Frau, die bei manchen Situationen an die Decke "
	    "starrt?");
  
  
  AddDetail( ({"situationen"}), 
            "Aaliyah raeuspert sich.");

  AddDetail( ({"aaliyah"}), 
            "Aaliyah ist nicht da.");
 
  
  AddDetail( ({"wand","waende","waenden"}), 
            "Unzaehlige Regale wurden an den Waenden befestigt.");

  
  AddDetail( ({"amazonen"}), 
            "Du bist mittendrin anstatt nur dabei!");
 
  AddDetail( ({"eimer","holzeimer"}), 
            "Ein grosser, schwerer Holzeimer gefuellt mit frischem Wasser.");
 
  AddDetail( ({"wasser"}),
	     "Das Wasser ist frisch und klar. Anscheinend wurde es vor kurzem "
	     "in den Eimer gefuellt.");	  

  AddDetail( ({"mitte"}),
	    "In der Mitte des Raumes befindet sich die grosse Toepferscheibe. "
	    "Vor ihr steht ein kleiner Schemel.");

  AddDetail( ({"schemel"}), 
            "Sitzend toepfern ist sicher besser als stehend oder?");
  
  AddDetail( ({"regale","regalen"}),
	    "Die Regale sind gefuellt mit Tontoepfen und Tonschalen in allen "
	    "moeglichen Groessen und Formen.");
	 
  AddDetail( ({"groessen"}),
	    "Es gibt die Tontoepfe und die Tonschalen in verschiedenen Groessen. "
	    "Manche sind sehr klein und manche sind sehr gross.");
         

  AddDetail( ({"formen"}), 
            "Kelchfoermig, flach, hoch, viereckig. Alles ist dabei.");

  AddDetail( ({"tontoepfen","tontoepfe","toepfe"}),
	    "Die Toepfe werden von den Amazonen fuer ihre Lebensmittel benoetigt.");

  AddDetail( ({"lebensmittel"}),
	    "Naja, Amazonen muessen auch essen und trinken.");

  AddDetail( ({"tonschalen","schalen","schale"}),
	    "Die Tonschalen haben verschiedene Formen und Groessen.");

  AddDetail( ({"toepferscheibe","vorrichtung"}),
	    "Ein Eisengestell mit einer grossen Scheibe darauf. Die Scheibe dreht "
	    "sich wenn man mit dem Fuss das Tretpedal, dass unten am Gestell "
	    "befestigt ist, bedient.");

  AddDetail( ({"eisengestell","gestell","eisenstangen","stangen"}),
	    "Einige Eisenstangen wurden sorgfaeltig zu einer Vorrichtung gebaut.");

  AddDetail( ({"scheibe"}),
	    "Die Scheibe ist gross und rund. Einige Spuren von Ton befinden sich "
	    "noch auf ihr. Wenn Du moechtest kannst Du sie ja bedienen.");
 
  AddDetail( ({"ton","spuren"}),
	    "Etwas Ton befindet sich noch vom letzten Toepfern auf der Scheibe.");
 
  AddDetail( ({"toepfern"}),
	    "Es wird dann getoepfert wenn etwas gebraucht wird.");

  AddDetail( ({"tretpedal","pedal","fuss"}),
	    "Das Tretpedal ist mit dem Fuss zu bedienen.");


  
  AddSmell(DEFAULT_SMELL, "Die Luft hier ist ziemlich abgestanden und riecht "
		  "stark nach feuchtem Ton.");

  AddSmell( ({"luft"}),
	   "Abgestanden.");

  AddSmell( ({"ton"}),
	   "Erdig.");

    
  AddSound(DEFAULT_SOUND, "Irgendwie ist es hier sehr leise.");
	   

   

//-----Details Ende-----
  
  AddExit("sueden", "/gilden/amazonen");
 
 
//----KOMMANDOS---------

 AddCmd( ({ "bedien", "bediene" }), "c_bedienen");

 
   }
   int c_bedienen(string str)
   {
   notify_fail(BS("Was moechtest Du hier denn bedienen?"));
   if(!(str == "scheibe") || (str == "toepferscheibe"))
   {
     return 0;
   }
   if(!present("QUEST-TON", TP))
   {
    
   write(BS("Du hast keinen Ton dabei und ohne Ton wird das wohl nichts."));
   tell_room(ENV(TP), TPN+" dreht ein bisschen an der Scheibe herum.\n", ({TP}));

   return -1;
   
   }
   CLONE(OBJ "beitrittobj.lpc", TP);
  
   return 1;
   }

 
