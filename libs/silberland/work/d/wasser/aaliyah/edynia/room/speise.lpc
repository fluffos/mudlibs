// Speisesaal in der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Speisesaal der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du stehst hier im Speisesaal. Eine schoene grosse Tafel befindet "
	"sich mitten im Raum. Sie ist mit vielen Blumengestecken geschmueckt. "
	"Die vielen Stuehle sind mit schoenen Hussen bezogen, und stehen "
	"in einer geraden Linie um die Tafel. In den Ecken befinden sich "
	"weinrote grosse Vasen mit frischen Blumen. Die ganze Nordwand besteht "
	"aus Glas und ermoeglicht somit einen guten Ausblick auf das Meer. "
	"Ausserdem siehst Du an den Waenden lauter Kerzenhalter. Und wenn die "
	"Nacht einkehrt tauchen all die Kerzen in den Haltern den Raum in "
	"ein warmes Licht und es ist gewiss schoen hier zu Abend zu essen.");



  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);

//--------------Details Anfang----------------------------------------------

  AddDetail( ({"speisesaal","saal","raum"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus planken graumelierten Marmorplatten.");

  AddDetail( ({"marmor","marmorplatten","platten","goldsprenkeln"}),
	    "Der Marmor ist graumeliert mit einigen Goldsprenkeln darin.");
 
  AddDetail( ({"decke"}),
	    "Die Decke hat ein wunderschoenes Relief und besteht aus Marmor.");
  
  AddDetail( ({"relief","schlangen"}),
	    "Das Relief stellt zwei ineinander verschlungene Schlangen dar.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus planken graumelierten Marmorplatten.");

  AddDetail( ({"tafel"}),
	    "Eine praechtige Tafel steht mitten im Raum. Ein schoenes hellrosa "
	    "Tischtuch wurde darueber gebreitet. Ausserdem ist sie mit vielen "
	    "Blumengestecken, Kerzen und Servietten geschmueckt.");

  AddDetail( ({"tischtuch","tuch"}),
	    "Das Tischtuch ist hellrosa und hat einen goldenen Saum und "
	    "goldene Verzierungen. Ausserdem hat es an jedem Zipfel eine "
	    "goldene Kordel.");

  AddDetail( ({"kordel","saum","verzierungen","zipfel"}),
	    "Gold.");

  AddDetail( ({"blumengestecken","gestecke","blumgengestecke","gestecken"}),
	    "Wunderschoene Blumen wurden zu vielen Gestecken gebunden.");

  AddDetail( ({"blumen","lilien","orchideen","rosen","jasmin"}),
	    "Weisse Lilien, Orchideen, Rosen und etwas Jasmin.");

  AddDetail( ({"stuehle","hussen","stuhl"}),
	    "Alle Stuehle wurden mit hellrosa Hussen bezogen. Um jeden Stuhl "
	    "baumelt eine goldene Kordel.");

  AddDetail( ({"linie"}),
	    "Kein einziger Stuhl ist verrueckt. Du hoffentlich auch nicht.");

  AddDetail( ({"ecken","vasen"}),
	    "In den Ecken stehen weinrote Vasen mit goldenen Verzierungen.");

  AddDetail( ({"nordwand","glas","ausblick","meer"}),
	    "Die ganze Nordwand besteht aus Glas und ermoeglicht so einen "
	    "herrlichen Ausblick auf das Meer.");

  AddDetail( ({"waende","wand","waenden","haltern","kerzenhalter"}),
	    "Die Waende bestehen aus graumeliertem Marmor. Viele Kerzenhalter "
	    "sind an den Waenden befestigt.");

  AddDetail( ({"nacht","kerzen","licht","abend","kerzenlicht"}),
	    "Es ist sicher romantisch bei Kerzenlicht zu Abend zu essen.");

  AddDetail( ({"wasser","auflauf","speisen","geruch","mund","nase"}),
	    "Das Wasser rinnt Dir im Mund zusammen.");

  AddDetail( ({"koechin","geschirr","geschepper","kueche"}),
	    "Nebenan scheppert das Geschirr.");

  AddDetail( ({"servietten","amazonen"}),
	    "Die Amazonen haben huebsch bestickte Servietten.");



  AddSmell(DEFAULT_SMELL, "Der Geruch leckerer Speisen dringt aus der Kueche "
		   "in Deine Nase. Dir rinnt das Wasser im Mund zusammen.");
 
  AddSmell( ({"speisen","geruch"}),
	   "Die Koechin bereitet sicher gerade einen leckeren Auflauf zu.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst hier lediglich einige Amazonen plaudern "
		  "und das Geschepper von Geschirr.");
	   

  AddSound( ({"geschirr","geschepper"}),
	  "Du hoerst von nebenan das Geschirr scheppern.");


//----------Details Ende---------------------

  
  AddExit( "sueden", "./burg5");
  AddExit( "westen", "./kueche");
}  
   
