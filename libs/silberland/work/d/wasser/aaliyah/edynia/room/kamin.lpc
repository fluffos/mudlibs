// Turm der Amazonenburg
 
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Kamin");
  SetProp( P_INT_LONG,
      "Du kletterst durch einen engen Kamin und wunderst Dich, wo Du "
      "wohl hinkommen wirst.");
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 0 );
}  
   
