inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Vor der Amazonenburg");
  SetProp( P_INT_LONG,
	"Du stehst vor der Burg der Amazonen. Majestaetisch ragt sie in den "
       	"Himmel empor. An jedem ihrer Tuerme befindet sich eine hellblaue "
	"Fahne. Ausserdem erkennst Du viele schoen geschwungene Fenster, die "
	"mit Eisengittern geschuetzt sind. Ein grosses geoeffnetes Tor fuehrt "
	"ins Innere der Burg. Ober dem Tor prangt das grosse, goldene Wappen "
       	"der Amazonen. Neben dem Tor stehen zwei riesige Statuen. Ausserdem "
	"kannst Du einige emsig, umherhuschende weibliche Gestalten in der "
	"Burg erkennen. ");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_MOUNTAIN]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

 
  AddDetail( ({"burg","gebaeude","amazonenburg"}),
	   "Diese weisse Burg hat acht Tuerme. Es ist das maechtigste "
	   "Gebaeude, das Du je gesehen hast.");

  AddDetail( ({"tuerme","turm"}), 
            "Die Burg hat acht Tuerme. An jedem Turm ist eine hellblaue "
	    "Flagge befestigt.");

  AddDetail( ({"meer","brandung"}), 
            "Das Meer liegt sehr weit unter Dir und scheint hier aeusserst "
	    "tief zu sein. Genau sagen kannst Du es nicht. Du schliesst es "
	    "einfach aus der tiefblauen Farbe.");

  AddDetail( ({"farbe"}), 
            "Das Meer hat eine tiefblaue Farbe.");

  AddDetail( ({"flagge","flaggen","fahne","fahnen"}), 
            "Die Flaggen sind hellblau und haben eine goldene Umrandung. "
	    "In der Mitte befindet sich das goldene Wappen der Amazonen.");
  
  AddDetail( ({"boden"}), 
            "Der Boden ist hier sehr felsig. Einige Wagen und Pferdespuren "
	    "befinden sich auf ihm.");
  
  AddDetail( ({"wappen"}),
	     "So genau siehst Du das Wappen von hier aus nicht.");

  AddDetail( ({"pferdespuren","wagenspuren","spuren","spur","pferdespur",
	       "wagenspur","wagen"}), 
            "Viele Wesen scheinen die Burg zu besuchen denn die Spuren deuten "
	    "auf einen regen Betrieb hin.");
 
  
  AddDetail( ({"rechts","links","mitte"}), 
            "Rechts und links befindet sich der steile Abgrund.");

  AddDetail( ({"abgrund"}), 
            "Der Abgrund faellt steil ins Meer.");


  AddDetail( ({"betrieb"}), 
            "Die Amazonen werden von vielen Wesen besucht.");
  
  AddDetail( ({"amazonen","edynia","insel"}), 
            "Edynia ist die Insel der Amazonen.");
  
  AddDetail( ({"wesen","rassen"}), 
            "Alle moeglichen Rassen besuchen die Amazonenburg.");

  AddDetail( ({"fenster","fenstern","eisengitter","eisengittern"}), 
            "Die Fenster sind mit Eisengittern geschuetzt.");

    
  AddDetail( ({"amazonenkoenigin","hippolyte"}), 
            "Die Amazonenkoenigin ist von unglaublicher Schoenheit. Sie hat "
	    "den Anmut einer Frau und die Kraft und den Mut eines Mannes.");

  
  AddDetail( ({"anmut","frau","frauen"}), 
            "Frauen sollten schon anmutig sein.");
 
  AddDetail( ({"kraft","mut","mann","mannes","maenner"}), 
            "Ein Mann sollte Kraft und Mut besitzen.");
 
  AddDetail( ({"tor"}),
	   "Das riesige Tor hat einen schoen geschwungenen Bogen. Es besteht "
	   "aus purem Gold und hat wunderschoene Intarsien. Ausserdem ist es "
	   "mit dicken Metallstraengen verstaerkt.");

  AddDetail( ({"metallstraenge","metallstraengen"}),
	   "Die Metallstraenge machen das Tor widerstandsfaehiger.");

  AddDetail( ({"intarsien","gold","bogen"}),
	   "Das Tor ist einfach wunderschoen.");

  AddDetail( ({"statuen"}),
	   "Zwei riesige Statuen stehen rechts und links neben dem Tor. "
	   "Jede Statue hat einen langen Speer in ihren Haenden.");

  AddDetail( ({"statue"}),
	   "Eine Statue verkoerpert Hera und die andere Statue ist das genaue "
	   "Abbild von Artemis.");

  AddDetail( ({"hera","artemis","abbild","goettin"}),
	   "Die Statue ist das exakte Abbild der Goettin.");

  AddDetail( ({"innere","gestalten","inneren"}),
	   "Im Inneren der Burg erkennst Du viele weibliche Gestalten.");

  
  AddDetail( ({"fall","hochmut"}),
	     "Hochmut kommt vor dem Fall.");	  

  AddDetail( ({"edynia"}),
	    "Du befindest Dich auf der Amazoneninsel Edynia.");
  
  AddDetail( ({"himmel"}),
	    "Der Himmel ist strahlend blau und wolkenlos.");
 
   AddDetail( ({"dinge"}),
	   "Na alles musst Du auch nicht wissen.");


  AddDetail( ({"gilde","amazonengilde"}),
	   "Hier befindet sich die Amazonengilde.");

  AddDetail( ({"gildenoberhaupt"}),
	   "Oh da gibt es noch so manche.");

  AddDetail( ({"wind"}),
	    "Den kannst Du nicht untersuchen.");

  AddDetail( ({"reisen"}),
	    "Die Amazonen sind oefters mal auf Reisen.");

  AddDetail( ({"amazone"}),
	    "Sehen kannst Du sie nicht, dafuer lautstark hoeren.");
 
  AddDetail( ({"hand","haenden","haende","die","hmmm"}),
	     "Du guckst Dir Deine Haende an. Hmmm.. Die sind schon sehr zart wenn "
	     "man bedenkt wie oft Du damit kaempfst.");
 
  AddDetail( ({"umrandung"}),
	    "Jede Flagge hat eine goldene Umrandung.");

  AddDetail( ({"schlangen"}),
	    "Sie bilden das Wappen.");

  AddDetail( ({"speer"}),
	    "Jede richtige Amazone hat einen Speer bei sich.");
	    
  AddDetail( ({"lungen"}),
	    "Deine Lungen sind noch jung und unverbraucht.");

  AddDetail( ({"ohren"}),
	   "Deine Ohren hoeren oft viele Dinge, die sie nicht hoeren sollten.");

  AddDetail( ({"dinge","dingen"}),
	   "Na alles musst Du auch nicht wissen.");

  
  AddSmell(DEFAULT_SMELL, "Du riechst hier die salzige Meeresluft vermischt "
		  "mit einem wuerzigen Nebengeruch.");

  AddSmell( ({"luft","meeresluft"}),
	   "Die Meeresluft dringt tief in Deine Lungen.");

  AddSmell( ({"nebengeruch","geruch"}),
	   "Es ist der Geruch von orientalischen Kraeutern.");

  AddSmell( ({"kraeuter","kraeutern"}),
	   "Die Kraeuter haben die Amazonen von ihren Reisen mitgebracht.");
  
     
  AddSound(DEFAULT_SOUND, "Du hoerst hier das Rauschen des Meeres und auch "
		 "einige Gespraechsfetzen aus der Burg.");
	   

  AddSound( ({"gespraechsfetzen"}),
	   "Eine Amazone kichert: Die Maenner sind alle so schwach.");

  AddSound( ({"rauschen","meeres","meer","brandung"}),
	   "Das Meer rauscht in der Brandung.");	  
  

//-----Details Ende-----
  
  AddExit("osten", ROOM "amazon18.lpc");
  AddExit("westen", ROOM "amazon16.lpc");
 
}

 
