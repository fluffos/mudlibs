inherit "std/room";
#include "../def.h"



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Eine vertraeumte Bucht");
  SetProp( P_INT_LONG,
	"Du stehst in einer kleinen vertraeumten Bucht. Sie ist rundherum "
	"von steilen Klippen umgeben und nur ein schmaler Durchgang fuehrt "
	"zwischen den Felsen zum Strand zurueck. Der Sand ist wunderschoen "
	"weiss und sauber. Viele exotische Pflanzen wachsen hier und verleihen "
        "der Bucht eine romantische Atmosphaere. Die Wellen des schoenen "
        "tuerkisen Meeres umschmeicheln sanft Deine Beine und Du kommst in "
	"Versuchung mitsamt Deiner Ruestung hier baden zu gehen.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"bucht" , "raum"}), QueryProp(P_INT_LONG) );

  AddDetail( ({"klippen"}), 
            "Viele steile Klippen saeumen die Bucht ein.");

  AddDetail( ({"durchgang"}), 
            "Der Durchgang ist sehr schmal und fuehrt zum Strand zurueck.");

  AddDetail( ({"felsen"}), 
            "Die Felsen sind so steil das es unmoeglich scheint, sie ueberwinden "
	    "zu koennen.");
 
  AddDetail( ({"strand","westen","strandstueck"}), 
            "Im Westen gelangst Du wieder auf das Strandstueck zurueck.");
 
  AddDetail( ({"atmosphaere"}), 
            "Hier ist es so herrlich romantisch das Du Dich in den Sand setzt "
	    "und Deine Augen schliesst. Du beginnst zu traeumen.");

  AddDetail( ({"augen"}), 
            "Du stellst Dir vor wie es wohl waere hier mit einem geliebten "
	    "Wesen hier zu sein. Engumschlungen den Sonnenuntergang zuzusehen "
	    "und alles rund um Dich einfach zu vergessen.");

  AddDetail( ({"du","dich"}), 
            "Fuehlst Du Dich noch nicht genug angesprochen?");

  AddDetail( ({"beine","reise"}), 
            "Deine Beine sind muede von der weiten Reise.");

  AddDetail( ({"pflanzen"}), 
            "Wild wachsen exotische Pflanzen vor Deinen Augen und Du bewunderst "             "ihre wunderschoenen bunten kraeftigen Farben.");
 
  AddDetail( ({"farben"}), 
            "Es sind zuviele um sie aufzuzaehlen.");
 
  
  AddDetail( ({"boden"}), 
            "Der Boden besteht aus wunderschoenem weissen Sand. Einige "
	    "Muscheln und Wasserblumen wurden angeschwemmt.");
             

  AddDetail( ({"sand"}), 
            "Der Sand ist wunderschoen weiss.");

  AddDetail( ({"ruestung","maus"}), 
            "Zieh Dich aus kleine Maus, mach Dich nackig.");
 
  AddDetail( ({"roete","sonnenuntergang"}), 
            "Ist der Sonnenuntergang nicht schoen? Die Sonne wirkt wie ein "
	    "riesiger Feuerball am Firmament.");        
	 
  AddDetail( ({"wesen"}),
	    "Im Silberland gibt es eine Vielfalt an den seltsamsten Wesen. "
	    "Es sind auch so wunderbare Geschoepfe dabei, wo es einem schwer "
	    "faellt seine Blicke abzuwenden.");

  AddDetail( ({"blicke","geschoepfe","geschoepfen"}), 
            "Unsere Blicke haften an schoenen Geschoepfen.");
 
  AddDetail( ({"versuchung"}), 
            "Kennst Du das? Wenn die Versuchung so dermassen gross ist, das es "
	    "Dir nur mit grosser Muehe gelingt ihr zu widerstehen?");

  AddDetail( ({"muehe","geist","koerper"}), 
            "Der Geist ist stark, der Koerper schwach.");
 
  AddDetail( ({"kopf","lungen","fuesse","fuss","lunge","koerper"}), 
            "Dein Koerper ist einfach muede.");
  
  AddDetail( ({"vielfalt","menge","wesen"}), 
            "Jede Menge Wesen leben im Silberland.");
 
  AddDetail( ({"muscheln"}),
	     "Die Muscheln glitzern perlmuttfarben in der Sonne.");	  

  AddDetail( ({"silberland","land"}),
	    "Das ist das Land indem in letzter Zeit viele Weltuntergaenge "
	    "herrschten.");
  
  AddDetail( ({"weltuntergaenge"}), 
            "Woody sprach: So soll es sein!");

  AddDetail( ({"woody","hochzwergengott","ferne"}), 
            "Hochzwergengott Woody knuddelt Dich aus der Ferne.");
  	    	  
  
  AddDetail( ({"himmel","firmament"}),
	    "Der Himmel ist wunderschoen blau und hat eine leichte rosarote "
	    "Faerbung. Er ist vollkommen wolkenlos.");
	 
  AddDetail( ({"faerbung","roete"}),
	    "Rosarot.");
 
  AddDetail( ({"meersalz"}), 
            "Es ist logisch dass es in einem Meer auch Meersalz gibt.");  

  AddDetail( ({"sonne","feuerball","ball"}),
	    "Die Sonne spiegelt sich wunderschoen im Wasser und wirkt wie "
	    "ein riesiger Feuerball.");

  AddDetail( ({"horizont"}),
	    "Der Horizont ist unendlich weit weg.");
  
  AddDetail( ({"wirkung","zeit","ding","weile"}),
	    "Gut Ding braucht Weile.");

  AddDetail( ({"aufmerksamkeit"}),
	    "Bist Du jemand der viel Aufmerksamkeit braucht?");

  AddDetail( ({"wasserblumen"}),
	    "Die Wasserblumen wurden hier angespuelt und vertrocknen langsam "
	    "in der Sonne.");
	   
  AddDetail( ({"wasser","meer"}), 
            "Das Wasser ist kristallklar und Du glaubst einige Fische in "
	    "den Wellen zu erkennen.");
 
  AddDetail( ({"fische","hinsehen"}), 
            "Beim genaueren Hinsehen erkennst Du das es sich um Delfine "
	    "handelt.");

  AddDetail( ({"delfine","gruppe","fluten"}), 
            "Eine kleine Gruppe Delfine tummelt sich verspielt in den Fluten.");
 
  AddDetail( ({"wellen","wasseroberflaeche"}), 
            "Die Wellen kraeuseln sich glitzernd auf der Wasseroberflaeche.");
   

  AddRoomMessage( ({"Die Wellen rauschen leise vor sich hin.\n",
	          "Ein paar Moewen kreischen in weiter Ferne.\n",
		  "Ein paar Delfine huepfen ueber das Wasser.\n",
		  "Ein paar sanfte Wellen kraeuseln sich um Deine Fuesse.\n",
		  "Du riechst eine leichte Brise Meersalz.\n",
		  "Die Sonne verschwindet langsam am Horizont.\n",
		  "Der Raum taucht sich langsam in eine sanfte Roete.\n"}), 40);
  

  
  AddSmell(DEFAULT_SMELL, "Die Meeresluft riecht leicht salzig mit einem "
		          "Hauch von Bluetenduft.");

  AddSmell( ({"bluetenduft","hauch","blumen","pflanzen"}),
	    "Die Blumen duften herrlich.");
                        
 
  AddSmell( ({"meeresluft","brise"}),
	   "Du saugst die frische Meeresluft in Deine Lungen ein.");

    
  AddSound(DEFAULT_SOUND, "Du hoerst das Kreischen der Moewen und das sanfte "
		  "Rauschen der Wellen.");
	   

  AddSound( ({"kreischen","moewen"}),
	   "Die Moewen kreischen hoch ueber Deinem Kopf.");

  AddSound( ({"rauschen","wellen"}),
           "Die Wellen rauschen leise und stroemen eine beruhigende Wirkung "
	   "auf Dich aus.");

  AddSound( ({"meer"}),
	   "Es rauscht.");
           
  

//-----Details Ende-----
  
  AddExit("westen", ROOM "amazon1.lpc");
//-----Kommandos--------

  AddCmd( ({ "bade", "bad" }), "c_baden");

 }  

 int c_baden(string str)
{
   notify_fail(BS("Worin moechtest Du gerne baden?"));
   if(!(str == "in meer" || str == "in wasser"))
   {
     return 0;
   }
   write(BS("Du haelst es nicht mehr aus. Die Hitze macht Dir so zu schaffen "
	    "das Du einfach mitsamt Deiner ganzen Ruestung ins Wasser huepfst. "
	    "Herrlich perlt das kuehle Nass auf Deiner, von der Sonne geroeteten "            "Haut. Du geniesst die Abkuehlung, tauchst ein paarmal noch unter "
	    "Wasser und erreichst Dann schliesslich patschnass den Strand wieder. "));
	  
    return 1;
}
