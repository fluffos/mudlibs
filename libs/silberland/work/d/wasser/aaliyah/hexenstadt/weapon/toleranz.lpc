// Toleranz




inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>
#include "/gilden/druidenzirkel/druiden_extern.h"



void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Die Toleranz");
  SetProp(P_LONG, 
    "Diese Handschuhe verkoerpern pure Reinheit. Sie bestehen aus goettlichen "
    "Materialien und wurde von Artemisia geschaffen, um die Todeshexe zu "
    "vernichten. Allein diese Handschuhe schaffen es, was noch keine andere "
    "Waffe zuvor geschafft hat. Sie vermoegen die Todeshexe zu verletzen.");
  SetProp(P_NAME, "Toleranz");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"handschuhe","toleranz","Jadekiller"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2000);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, WASSER);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "druidenzirkel", SR_SEER: 1]) );

  AddDetail( ({"materialien"}),
   "Diese Handschuhe bestehen aus dem Wasser der magischen Quelle in Tijara. "
   "Gebuendelt mit Magie ist es die einzige Moeglichkeit, die Hexe zu verletzen "
   "und sie zu toeten.");
}  
   
