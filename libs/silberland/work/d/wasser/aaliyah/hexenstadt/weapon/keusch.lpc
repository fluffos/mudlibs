// 
// Die Keuschheit

inherit "std/weapon";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <weapon.h>



void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Die Keuschheit");
  SetProp(P_LONG, 
    "Dieser Dolch verkoerpert pure Reinheit. Er besteht aus goettlichen "
    "Materialien und wurde von Artemisia geschaffen, um die Todeshexe zu "
    "vernichten. Allein dieser Dolch schafft es, was noch keine andere Waffe "
    "zuvor geschafft hat. Er vermag die Todeshexe zu verletzen.");
  SetProp(P_NAME, "Keuschheit");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keuschheit","dolch","Jadekiller"}) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 5350);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 120);
  SetProp(P_WC_FIX, 40);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 40);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_RIP, DT_PIERCE}));
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD: "nekromanten", SR_SEER: 1]) );

  AddDetail( ({"materialien"}),
    "Dieser Dolch strahlt in magisch dunklem Licht. Wenn man genau hinsieht, "
    "hat man das Gefuehl das viele kleine Flammen aus der Dolchspitze stroemen "    "und sich zuengelnd nach einem neuen Opfer verzehren.");
		  
}  
   
