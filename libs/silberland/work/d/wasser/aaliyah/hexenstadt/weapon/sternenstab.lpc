// Sternenstab

inherit "std/weapon";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <weapon.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Sternenstab");
  SetProp(P_LONG, 
    "Dieser wunderschoen geschmiedete Stab wurde von Artemisia angefertigt. "
    "Er besteht aus purem Gold, und auf der Spitze befindet sich ein Stern.");
  SetProp(P_NAME, "Sternenstab");
  SetProp(P_GENDER, MALE);
  AddId( ({"sternenstab","stab"}) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 850);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 30);
  SetProp(P_WC_FIX, 30);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 1);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC_BONUS, (["fee": 250]) );

  AddDetail( ({"stern","herz"}),
    "Der Stern strahlt in gleissendem Licht und in der Mitte hat es den "
    "Anschein als wuerde ein kleines Herz pulsieren.");
  
}  
   
