// Lichtschwert

inherit "std/weapon";
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Lichtschwert");
  SetProp(P_LONG, 
    "Du haeltst ein gleissend grelles Lichtschwert in Deinen Haenden. Es ist "
    "so dermassen hell, dass es Dir schon in den Augen schmerzt. Aber das ist "
    "kein Wunder, denn es besteht aus purem Licht. Seine Klinge ist hauchduenn "
    "und scheint, als waere sie eine einzige Flamme. Diese ausserordentliche "
    "Waffe fuegt den Gegnern sicher enorme Schmerzen zu.");
  SetProp(P_NAME, "Lichtschwert");
  SetProp(P_INFO, "Das Lichtschwert blendet seine Gegner.");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"lichtschwert","schwert"}) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 40);
  SetProp(P_MATERIAL, ([MAT_LIGHT:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_LIGHT, DT_FIRE, DT_SLASH}));
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, A_DEX:25, A_STR:25]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_WC_BONUS, (["shine": 400]) );
  
}  

 int HitFunc(object enemy)
 {
	  
  if (!random(20) && !enemy->QueryProp(P_BLIND) &&
  enemy->QueryProp(P_SIZE) <
  QueryProp(P_WIELDED)->QueryProp(P_SIZE) * 2 &&
  enemy->QueryProp(P_NOMAGIC) < random(100))
  {
   tell_object(enemy, "Das gleissende Licht des Lichtschwertes laesst "
                      "Dich erblinden.\n");
   tell_object(QueryProp(P_WIELDED), enemy->Name(WER) + " wird vom "
     "gleissenden Licht des Lichtschwertes geblendet.\n");
   enemy->SetProp(P_BLIND, 1 + random(3) );  
   return 100 + random(200);
  
   }
 }
		   
		
   
   
