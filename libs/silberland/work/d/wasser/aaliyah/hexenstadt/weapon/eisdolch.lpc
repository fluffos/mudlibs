// 3.1.2005
// 
// Eisdolch

inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Eiszapfen");
  SetProp(P_LONG, 
    "Der Eiszapfen ist eine gute Waffe vom Typ Dolch. Er besteht vollkommen "
    "aus Eis. Einige magische Zeichen sind in seine Klinge graviert. Weiters "
    "ist die Klinge aeusserst spitz und hart. Man kann mit dem Eiszapfen "
    "gewiss aeusserst schnell seine Gegner zerfleischen und ihnen die "
    "Eingeweide aus dem Koerper schneiden.");
  SetProp(P_NAME, "Eiszapfen");
  SetProp(P_INFO, "Dieser Dolch laehmt seine Gegner.");
  SetProp(P_GENDER, MALE);
  AddId( ({"eiszapfen","dolch"}) );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 850);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 135+random(10));
  SetProp(P_WC_FIX, 55);
  SetProp(P_MATERIAL, ([MAT_ICE:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 40);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_COLD}));
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1, A_DEX:25, A_INT:25]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_WC_BONUS, (["shahin": 450]) );

  AddDetail( ({"zeichen","schriftart"}),
   "Diese mystischen Zeichen wurden von den Hexen ueberliefert und in diese "
   "Waffe gemeiselt. Sie erinnern irgendwie an Figuren, die sich gegenseitig "
   "aufschlitzen.");
  
}  
   
 int HitFunc(object enemy)
 {
   mapping res;	  
   if (mappingp(res = enemy->QueryProp(P_RESISTANCE_STRENGTHS)) &&
    (to_float(res[DT_PIERCE]) < 0.0) &&
    (to_int(res[DT_PIERCE] * -100) > random(100)))

   return 0;
  
  if (!random(25) && !enemy->QueryProp(P_DISABLE_ATTACK) &&
      enemy->QueryProp(P_NOMAGIC) < random(100))
  {
   tell_object(enemy, "Das Eis dringt in Deinen Koerper und "
                      "laehmt Deine Gliedmassen.\n");
   tell_object(QueryProp(P_WIELDED), enemy->Name(WER) + " wird vom "
     "Eis des Dolches gelaehmt.\n");
   enemy->SetProp(P_DISABLE_ATTACK, 1 + random(3) );  
   return 100 + random(200);
  
   }
 }

