// MYSTERIUM

inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Mysterium");
  SetProp(P_LONG, 
    "Diese uralte Waffe wurde vor Tausenden von Jahren von den Herrschern der "
    "Dunkelheit erschaffen. Ihre Diener gaben sie ueber Jahrhunderte immer an "
    "ihre Erben weiter. Diese Waffe ist ein einziger Schatten der Dunkelheit. "
    "Die Axt hat ausser dem scharfen Axtblatt noch einen kleinen Dolch auf "
    "der Rueckseite, der sich in das Fleisch der Gegner bohrt. Mysterium ist "
    "eine sehr maechtige Waffe und kann nur von den staerksten Kaempfern "
    "gefuehrt werden.");
  SetProp(P_NAME, "Mysterium");
  SetProp(P_INFO, "Mysterium erkennt die Anfaelligkeit seiner Gegner.");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"mysterium","axt"}) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 5250);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 245+random(25));
  SetProp(P_WC_FIX, 20);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_NR_HANDS, 2);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 120);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}));
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_ARTICLE, 0);
  SetProp(P_WC_BONUS, (["hazel": 400]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL: 50, A_STR:33]) );
  SetProp(P_MAGIC, 1);

//-----Details Anfang--------------------------------

  AddDetail( ({"axtblatt","blatt"}),
	    "Das Axtblatt ist rasiermesserschaft und es ist besser wenn Du "
	    "vorsichtig damit umgehst.");

  AddDetail( ({"dolch","rueckseite","fleisch"}),
	    "Ein kleiner Dolch befindet sich auf der Rueckseite der Axt. "
	    "Er bohrt sich bei jedem Schlag ins Fleisch der Gegner.");
}  

int HitFunc(object enemy) 
{
  mapping resist;
  float water, fire, cold, air;

  if (!random(10) && sizeof(QueryProp(P_DAM_TYPE)) == 2 &&
      find_call_out("normal") == -1)
  {
    if (mappingp(resist = enemy->QueryProp(P_RESISTANCE_STRENGTHS)))
    {
      water = to_float(resist[DT_WATER]);
      fire = to_float(resist[DT_FIRE]);
      cold = to_float(resist[DT_COLD]);
      air = to_float(resist[DT_AIR]);

      if (water > 0.0 && water >= fire && water >= cold && water >= air)
      {
        SetProp(P_DAM_TYPE, QueryProp(P_DAM_TYPE) + ({DT_WATER}) );
        tell_object(QueryProp(P_WIELDED), 
            "Mysterium beschwoert eine Sturmflut.\n"); 
        QueryProp(P_WIELDED)->AddSp(-5 - random(5));
        call_out("normal", 6 + random(10) );
      }

      else if (fire > 0.0 && fire >= cold & fire >= air)
      {
        SetProp(P_DAM_TYPE, QueryProp(P_DAM_TYPE) + ({DT_FIRE}) );
        tell_object(QueryProp(P_WIELDED), 
            "Mysterium beschwoert einen Feuersturm.\n"); 
        QueryProp(P_WIELDED)->AddSp(-5 - random(5));
        call_out("normal", 6 + random(10) );
      }
      else if (cold > 0.0 && cold >= air)
      {
        SetProp(P_DAM_TYPE, QueryProp(P_DAM_TYPE) + ({DT_COLD}) );
        tell_object(QueryProp(P_WIELDED), 
            "Mysterium beschwoert einen Hagelschlag.\n"); 
        QueryProp(P_WIELDED)->AddSp(-5 - random(5));
        call_out("normal", 6 + random(10) );
      }
      else if (air > 0.0)
      {
        SetProp(P_DAM_TYPE, QueryProp(P_DAM_TYPE) + ({DT_AIR}) );
        tell_object(QueryProp(P_WIELDED), 
            "Mysterium beschwoert einen Wirbelsturm.\n"); 
        QueryProp(P_WIELDED)->AddSp(-5 - random(5));
        call_out("normal", 6 + random(10) );
      }
    }
  }
}  

void normal()
{
  if (objectp(QueryProp(P_WIELDED)))
    tell_object(QueryProp(P_WIELDED),
        "Mysterium beruhigt sich wieder.\n");
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
}

 		
   
   
