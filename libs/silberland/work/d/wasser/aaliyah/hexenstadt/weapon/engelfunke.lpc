// Engelsfunke

inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Engelsfunke");
  SetProp(P_LONG, 
    "Dieser Dolch wurde von den Engeln im Himmelsreich gefertigt. Heilige "
    "Maechte und goettliche Kraefte verschmolzen zu einer einzigartigen Waffe "
    "der Magie. Der Griff des Dolches ist traenenfoermig und sieht aus wie "
    "blaues Glas. Die Klinge sieht ebenfalls aus als waere sie aus blauem Glas. "
    "Weiters ist die Klinge sehr scharf und hat lauter kleine Widerhaken, die "
    "den Gegnern sicher enorme Schmerzen zufuegen koennen.");
  SetProp(P_NAME, "Engelsfunke");
  SetProp(P_INFO, "Engelsfunke bekaempft die Gegner mit heiliger Macht.\n"
		  "Die heilige Macht des Dolches laehmt die Gegner.");
  SetProp(P_GENDER, MALE);
  AddId( ({"engelsfunke","dolch"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 65);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_HOLY, DT_LIGHTNING, DT_RIP}));
  SetProp(P_WC_BONUS, (["morrighan": 450]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1, A_DEX:25, A_INT:25]) );
  SetProp(P_MAGIC, 1);
}  

    int HitFunc(object enemy)
 {
    mapping res;	  
  if (mappingp(res = enemy->QueryProp(P_RESISTANCE_STRENGTHS)) &&
    (to_float(res[DT_PIERCE]) < 0.0) &&
    (to_int(res[DT_PIERCE] * -100) > random(100)))

   return 0;

   if (!random(25) && !enemy->QueryProp(P_DISABLE_ATTACK) &&
       enemy->QueryProp(P_NOMAGIC) < random(100))

 {
   tell_object(enemy, "Die goettliche Macht von Engelsfunke laesst Dich "
                      "erstarren.\n");
   tell_object(QueryProp(P_WIELDED), enemy->Name(WER) + " wird durch "
     "die goettliche Macht von Engelsfunke erstarrt.\n");
   enemy->SetProp(P_DISABLE_ATTACK, 1 + random(3) );  
   return 100 + random(200);
  
   }
 }	   
