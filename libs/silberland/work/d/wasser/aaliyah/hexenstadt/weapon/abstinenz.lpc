// 25.1.2005
// 
// Die Abstinenz

inherit "std/weapon";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <weapon.h>



void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Die Abstinenz");
  SetProp(P_LONG, 
    "Dieses Schwert verkoerpert pure Reinheit. Es besteht aus goettlichen "
    "Materialien und wurde von Artemisia geschaffen, um die Todeshexe zu "
    "vernichten. Allein dieses Schwert schafft es, was noch keine andere "
    "Waffe zuvor geschafft hat. Es vermag die Todeshexe zu verletzen.");
  SetProp(P_NAME, "Abstinenz");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"abstinenz","schwert","Jadekiller"}) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 160);
  SetProp(P_WC_FIX, 55);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 130);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH}));
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD: "paladine", SR_SEER: 1]) );

  AddDetail( ({"materialien"}),
    "Das Schwert besteht aus Magie. Das ist auch der Grund wieso die Klinge "
    "so magisch leuchtet. Der Knauf ist mit bunten Edelsteinen verziert und "
    "somit ist die Abstinenz eine sehr schoene und prunkvolle Waffe.");
}  
   
