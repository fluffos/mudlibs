// Nachtdolch

inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Der Nachtdolch");
  SetProp(P_LONG, 
    "Diese Waffe ist aus der Magie der Nacht entstanden. Tiefste Dunkelheit "
    "und grellstes Licht wurden in dieser einzigartigen Klinge verbannt. "
    "So kann man die Farbe dieser Waffe nicht definieren, denn sie ist sehr "
    "dunkel und irgendwie ist sie auch sehr hell. Viele glitzernde Sterne "
    "zieren den ganzen Dolch. Seine Klinge ist dermassen scharf, dass sie "
    "selbst Knochen muehelos entzwei schneiden koennte.");
  SetProp(P_NAME, "Nachtdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"nachtdolch","dolch"}) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 130);
  SetProp(P_WC_FIX, 60);
  SetProp(P_MATERIAL, ([MAT_MAGIC:40, MAT_LIGHT:30, MAT_MISC_UNHOLY: 30]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_UNHOLY, DT_MAGIC, DT_SLASH}));
  SetProp(P_WC_BONUS, (["aura": 450]) );
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, A_DEX:25, A_INT:25]) );
  SetProp(P_MAGIC, 1);
}  
   
