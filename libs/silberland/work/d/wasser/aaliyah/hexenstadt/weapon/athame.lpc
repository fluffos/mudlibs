// Athame

inherit "std/weapon";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <weapon.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein antiker Athame");
  SetProp(P_LONG, 
    "Der Athame ist die maechtigste Waffe der Wicca. Man braucht diesen Dolch, "
    "um Energien zu fuehren, um den magischen Kreis zu ziehen, Salz und Wasser "
    "damit zu vermischen, sowie Beschwoerungen zu vollziehen. Man zeichnet "
    "damit auch Symbole in die Luft, etwa anrufende oder bannende Pentagramme.");
  SetProp(P_NAME, "Athame");
  SetProp(P_GENDER, MALE);
  AddId( ({"athame","dolch"}) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 70);
  SetProp(P_WC_FIX, 25);
  SetProp(P_MATERIAL, ([MAT_IVORY:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH}));

}  
   
