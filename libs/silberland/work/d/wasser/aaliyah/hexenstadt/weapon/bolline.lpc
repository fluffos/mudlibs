// Bolline

inherit "std/weapon";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <weapon.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein uralter Bolline");
  SetProp(P_LONG, 
    "Der Bolline ist ein Dolch mit einem weissen Griff. Hexen verwenden ihn, "
    "im Gegensatz zum Athame, zum Schneiden oder Kerben. Dieser Dolch ist "
    "mit winzigen Edelsteinen verziert, und in seiner Klinge befinden sich "
    "einige magische Zeichen.");
  SetProp(P_NAME, "Bolline");
  SetProp(P_GENDER, MALE);
  AddId( ({"bolline","dolch"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 55);
  SetProp(P_WC_FIX, 20);
  SetProp(P_MATERIAL, ([MAT_METAL:70, MAT_IVORY:25, MAT_MISC_JEWEL:5]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH}));

  AddDetail( ({"zeichen"}),
    "Eigentlich sind es uralte Schriftzeichen.");

  AddDetail( ({"schriftzeichen","schriftart"}),
    "Diese Schriftart wurde von den Hexen ueberliefert. Daher kannst Du sie "
    "nicht entziffern.");
		 

}  
   
