// 25.1.2005
// 
// Die Gerechtigkeit

inherit "std/weapon";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <weapon.h>



void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Die Gerechtigkeit");
  SetProp(P_LONG, 
    "Diese Axt verkoerpert pure Reinheit. Sie besteht aus goettlichen "
    "Materialien und wurde von Artemisia geschaffen, um die Todeshexe zu "
    "vernichten. Allein diese Axt schafft es, was noch keine andere Waffe "
    "zuvor geschafft hat. Sie vermag die Todeshexe zu verletzen.");
  SetProp(P_NAME, "Gerechtigkeit");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"gerechtigkeit","axt","Jadekiller"}) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 5350);
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 220);
  SetProp(P_WC_FIX, 10);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_NR_HANDS, 2);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 120);
  SetProp(P_ARTICLE, 0);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_RIP, DT_SLASH}));
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD: "berserker", SR_SEER: 1]) );
}  
   
