// Eisschwert-Rauhreif

inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Rauhreif");
  SetProp(P_LONG, 
    "Das weisse Schwert besteht vollkommen aus Silber. Es ist mit Rauhreif "
    "ueberzogen. Viele glitzernde Eisblumen schmuecken die Klinge, die "
    "so scharf ist, dass sie selbst Metall muehelos entzwei schneiden koennte. "
    "Der Griff ist mit einigen eisblauen Edelsteinen verziert. Dieses Schwert "
    "ist die Waffe eines Prinzen und kann nur von maechtigen Kriegern gezueckt "
    "werden.");
  SetProp(P_NAME, "Rauhreif");
  SetProp(P_INFO, "Rauhreif laesst Deine Gegner vor Kaelte erstarren.");
  SetProp(P_GENDER, MALE);
  AddId( ({"rauhreif","schwert","klinge"}) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 180);
  SetProp(P_WC_FIX, 40);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_COLD, DT_RIP}));
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_ARTICLE, 0);
  SetProp(P_WC_BONUS, (["sidharta": 400]) );
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, A_DEX:25, A_STR:25]) );
  SetProp(P_MAGIC, 1);

  AddDetail( ({"eisblumen"}),
    "Die Eisblumen sind sehr zart und ineinander verschlungen und bilden "
    "ein wunderschoenes Muster auf dem Schwert.");

  AddDetail( ({"edelsteine","edelsteinen"}),
    "Die Edelsteine sehen irgendwie wie Aquamarine aus.");
}  

 int HitFunc(object enemy)
 {
  mapping res;	  
  if (mappingp(res = enemy->QueryProp(P_RESISTANCE_STRENGTHS)) &&
    (to_float(res[DT_PIERCE]) < 0.0) &&
    (to_int(res[DT_PIERCE] * -100) > random(100)))

   return 0;
	  
  if (!random(20) && !enemy->QueryProp(P_DISABLE_ATTACK) &&
      enemy->QueryProp(P_NOMAGIC) < random(100))
  {
   tell_object(enemy, "Die Kaelte des Schwertes laesst Dich kurzzeitig "
                      "einfrieren.\n");
   tell_object(QueryProp(P_WIELDED), enemy->Name(WER) + " wird von "
     "der Kaelte des Schwertes eingefroren.\n");
   enemy->SetProp(P_DISABLE_ATTACK, 1 + random(3) );  
   return 100 + random(200);
  
   }
 }
		   
		
   
   
