inherit "/std/weapon";

#include "../def.h"
#include <ansi.h>

void create()
{
  if(!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Seelengeissel, die Peitsche der Zerstoerung");
  SetProp(P_LONG,
      "Seelengeissel ist eine dreischwaenzige Peitsche mit ledernem Griff. "
      "Eine Peitschenschnur leuchtet hellrot und scheint zu brennen, die zweite "
      "ist blauweiss und eisig kalt, waehrend die dritte regenbogenfarben ist "
      "und bestimmt stark magisch. Das ist sicher die maechtigste Peitsche, "
      "die Du je gesehen hast.");
  SetProp(P_NAME, "Seelengeissel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"seelengeissel", "geissel", "peitsche", "peitsche der zerstoerung" }) );
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 200);
  SetProp(P_WC_BONUS, (["jade":300]));
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, ({DT_WHIP, DT_FIRE, DT_MAGIC, DT_COLD}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_LEATHER:10, MAT_FIRE:30, MAT_MAGIC:30, MAT_ICE:30]));
  SetProp(P_WEIGHT, 700);
  SetProp(P_SIZE, 400);
  SetProp(P_ARTICLE, 0);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 0 );
  SetProp(P_MAGIC, 12);
}

string name(int casus, int daemon)
{
  string n;
  n=::name(casus, daemon);
  if( this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return ANSI_YELLOW+ANSI_BOLD+n+ANSI_NORMAL;
  else if( this_player() && this_player()->QueryProp(P_TTY)=="vt100")
    return ANSI_BOLD+n+ANSI_NORMAL;
  return n;
}   

string Name(int casus, int daemon)
{ 
  return capitalize(name(casus,daemon));
}   

string short()
{   
  string s;
  if(QueryProp(P_WIELDED))
    s=" ("+(QueryProp(P_WIELDED_TEXT)||"gezueckt")+")";
  else
    s="";
  if(this_player() && this_player()->QueryProp(P_TTY)=="ansi")
    return ANSI_YELLOW+ANSI_BOLD+QueryProp(P_SHORT)+ANSI_NORMAL+s+".\n";
  else if(this_player() && this_player()->QueryProp(P_TTY)=="vt100")
    return ANSI_BOLD+QueryProp(P_SHORT)+ANSI_NORMAL+s+".\n";
  return QueryProp(P_SHORT)+s+".\n";
}

void init()
{
  ::init();
  if( MENV && interactive(MENV) && !IS_LEARNER(MENV))
    call_out("do_remove",0);
}

void do_remove()
{
  if (TO && MENV)
    tell_object(MENV, Name(WER) + " loest sich auf.\n");
  remove();
}
