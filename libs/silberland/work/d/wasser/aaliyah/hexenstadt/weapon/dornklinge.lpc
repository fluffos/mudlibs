// DORNENKLINGE

inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Dornenklinge");
  SetProp(P_LONG, 
    "Dieses Schwert besteht aus ineinander verwachsenen Rosen. Auf der Klinge "
    "befinden sich lauter kleine Rosendorne, die sich wie Widerhaken in das "
    "Fleisch der Gegner bohren. Am Anfang des Griffs befinden sich einige "
    "weisse Rosenblueten, die dem Schwert als Zierde dienen. Dornenklinge "
    "ist ein maechtiges, lebendes Schwert, das die Gegner auch gern vergiftet.");
  SetProp(P_NAME, "Dornenklinge");
  SetProp(P_INFO, "Dornenklinge vergiftet die Gegner.\n"
		  "Das Gift der Klinge laehmt die Gegner.\n"
		  "Dornenklinge hat daemonische Maechte in sich.");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"dornenklinge","schwert","klinge"}) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 180);
  SetProp(P_WC_FIX, 50);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_UNHOLY, DT_POISON, DT_RIP}));
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_ARTICLE, 0);
  SetProp(P_WC_BONUS, (["acaciah": 400]) );
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, A_DEX:25, A_STR:25]) );
  SetProp(P_MAGIC, 1);
}  

 int HitFunc(object enemy)
 {
  mapping res;	  
  if (!random(25) && !enemy->QueryProp(P_DISABLE_ATTACK) &&
      enemy->QueryProp(P_NOMAGIC) < random(100))
  {
  if (mappingp(res = enemy->QueryProp(P_RESISTANCE_STRENGTHS)) &&
    (to_float(res[DT_PIERCE]) < 0.0) &&
    (to_int(res[DT_PIERCE] * -100) > random(100)))
    
   return 0;
	  
   tell_object(enemy, "Das Gift der Dornen stroemt in Deinen Koerper und "
                      "laehmt Deine Gliedmassen.\n");
   tell_object(QueryProp(P_WIELDED), enemy->Name(WER) + " wird vom "
     "Gift der Dornen gelaehmt.\n");
   enemy->SetProp(P_DISABLE_ATTACK, 1 + random(3) );  
   return 100 + random(200);
  
   }
 }
		   
		
   
   
