// 3.1.2005
// 
// Salvias Schwert der Unschuld

inherit "std/weapon";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Das Schwert der Unschuld");
  SetProp(P_LONG, 
    "Dieses Schwert wurde von den Engeln im Himmel hergestellt. Sie haben "
    "ihre reinen Seelen verbunden und mit grosser Magie dieses einzigartige "
    "Schwert geschmiedet. Es sollte ihre unglaubliche Unschuld repraesentieren "
    "und ihr Reich mit Herz verteidigen. Als es die Goetter gesegnet hatten, "
    "wurde es von Hekate, der Hexenmutter, gestohlen und hierher gebracht.");
  SetProp(P_NAME, "Schwert der Unschuld");
  SetProp(P_INFO, "Das Schwert der Unschuld macht Dich heiliger.");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert der unschuld","schwert","schwert unschuld"}) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 1250);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 180);
  SetProp(P_WC_FIX, 45);
  SetProp(P_MATERIAL, ([MAT_MAGIC:50,MAT_MISC_HOLY:50]));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_HOLY, DT_WATER, DT_SLASH}));
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, A_DEX:25, A_STR:25]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_WC_BONUS, (["salvia": 400]) );

  AddDetail( ({"unschuld","engel","engeln"}),
   "Die Engel haben dieses Schwert mit ihren Traenen gesegnet. Einige dieser "
   "Traenen verliert das Schwert beim Kampf.");

  AddDetail( ({"goetter"}),
    "Die Goetter gaben das Schwert den Engeln zum Segnen und weihten es "
    "anschliessend mit ihren Kraeften.");
  
}  
int HitFunc(object enemy)
{
  int align, enemy_align;
  if (enemy->QueryProp(P_LEVEL) < 10 + random(30))
    return 0;

  if ((enemy_align = enemy->QueryProp(P_ALIGN)) > 0)
    return -random(enemy_align / 50);

  if( (align = QueryProp(P_WIELDED)->QueryProp(P_ALIGN)) < 1000 )
    QueryProp(P_WIELDED)->SetProp(P_ALIGN, align + 1);
  else if (random(2))
    return random(-enemy_align / 50);

}
 
	 
  
	 
 
  
   
