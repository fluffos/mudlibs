// von Aradia
// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexeninsel"


inherit "std/room";
#include "../def.h"





void create()
	
{
 ::create();


  SetProp( P_INT_SHORT, "Im Mittelpunkt");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier am Dorfplatz der Stadt Sacciw. "
        "Der Platz ist fast leer, nur ab und zu siehst Du ein paar "
        "vermummte Gestalten hektisch vorbeihuschen. "
        "Du fuehlst Dich, als waeren 1000 Augen auf Dich gerichtet. "
	"Im Norden befindet sich ein kleines Haeuschen, aus dem seltsame "
	"Geraeusche dringen. Im Sueden kannst Du einen kleinen Laden "
	"betreten, waehrend im Osten und Westen der Weg weiterfuehrt.");

       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","sand","sandig"}), 
            "Der Boden ist hier noch etwas sandig. Vereinzelt liegen "
	    "ein paar Kieselsteine herum.");
             

  AddDetail( ({"sand","sandig"}), 
            "Der Sand wurde offenbar vom Strand hergeweht, und ab und zu "
            "glaubst Du, auch etwas Asche darin zu erkennen.");

  AddDetail( ({"asche"}),
	    "Du laesst etwas Sand durch Deine Finger rieseln und merkst, dass "
	    "es tatsaechlich Asche ist. Wo mag die nur herkommen?.");

  AddDetail( ({"strand"}),
	    "Von hier kannst Du den Strand nicht mehr erkennen.");
  
  AddDetail( ({"gestalten","gestalt"}),
	    "Ganz in schwarz gekleidete Gestalten huschen hektisch "
	    "ueber den Platz.");

  AddDetail( ({"platz","dorfplatz"}),
	    "Du befindest Dich mitten am Dorfplatz.");

  AddDetail( ({"augen","auge"}),
	    "Sehen kannst Du sie nicht, jedoch fuehlst Du, wie sie jeden Deiner "
            "Schritte beobachten.");

  AddDetail( ({"schritte","schritt"}),
	    "Mach hier keinen falschen Schritt, sonst koennte das hier "
	    "womoeglich toedlich enden.");

  AddDetail( ({"laden"}),
	    "Der Laden befindet sich im Sueden. Was genau dort verkauft wird, "
	    "findest Du wohl nur heraus, wenn Du ihn betrittst.");

  AddDetail( ({"kieselsteine","kieselstein","steine","stein"}),
	    "Kleine, mittlere und groessere Kieselsteine, aber sehr "
            "uninteressant. ");

  AddDetail( ({"haeuschen","knusper","knaeuschen","hexenhaeuschen"}),
	    "Knusper Knusper Knaeuschen, im Norden ist ein Hexenhaeuschen.");

  AddDetail( ({"geraeusche","geraeusch"}),
	    "Vor Dir steht ein Geraeusch. Es ist gross, bunt und spielt sich "
	    "nur in Deinem Kopf ab.");

  AddDetail( ({"kopf"}),
	   "Er befindet sich am Hals. Bei manchen Leuten ist er nur da, "
	   "damit es beim Hals nicht reinregnet.");

  AddDetail( ({"hals"}),
	   "Du legst Deine Haende um Deinen Hals und stellst fest, dass "  
           "er wunderschoen schlank und zart ist. ");

  AddDetail( ({"haende","hand"}),
	   "Du versichest Dich, ob Deine Haende wohl sauber sind. "
	   "Du hast sehr saubere Haende. Das liegt wohl daran, dass Du "
	   "von harter Arbeit nicht viel haeltst.");

  AddDetail( ({"arbeit"}),
	   "Du kennst sowas wohl nicht hm?");  
        

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wolkenlos und schimmert in einem violetten "
	    "Licht.");

  AddDetail( ({"wolken","wolke"}),
	    "Bist Du betrunken? Wo siehst Du hier Wolken?");
            

  AddDetail( ({"licht"}),
	    "Mystisch schimmert der Himmel in violettem Licht.");

  AddDetail( ({"weg","weges"}),
	    "Der Weg fuehrt hier vom Dorfplatz im Westen ins "
	    "Ungewisse nach Osten.");

  AddDetail( ({"ungewisse","gewissheit"}),
	    "Wenn Du Dir Gewissheit verschaffen willst, was am Ende "
	    "des Weges ist, solltest Du ihm folgen.");

  AddDetail( ({"ende"}),
	    "Man munkelt, dass manche Leute es schon bereut haben, "
	    "Ende getippt zu haben.");

  AddDetail( ({"leute","maenner","frauen","kinder","mann","frau","kind"}),
	    "Maenner, Frauen, Kinder.");

  AddDetail( ({"summen"}),
	    "Lauschen.");

  AddDetail( ({"stadt","sacciw"}),
	    "Du befindest Dich hier in der Stadt Sacciw.");

  
	     
  
  AddSmell(DEFAULT_SMELL, "Vom Norden und Sueden her dringen seltsame "
                          "Gerueche.");  
 
  AddSmell( ({"geruch","gerueche"}),
	   "Es riecht irgendwie seltsam nach Sandelholz und Mhyrre, "
	   "aber sicher bist Du Dir nicht.");

  AddSmell( ({"luft"}),
	   "Die Luft hier ist alles andere als klar.");
  
  AddSmell( ({"sandelholz"}),
	   "Es riecht hier leicht suesslich nach Sandelholz.");

  AddSmell( ({"Mhyrre"}),
	   "Du scheinst Dich getaeuscht zu haben, es riecht hier doch nicht "  
           "nach Mhyrre.");
  
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst ein Fluestern und ein leises Summen. "
	   "Es scheint, als wuerden Tausende von Frauen leise Lieder singen.");

  AddSound( ({"fluestern","frauen","gesang","wort"}),
	   "So sehr Du Dich bemuehst, Du kannst kein Wort verstehen ");
           
  
  AddSound( ({"lieder","frauen"}),
	   "Du hoerst sanften leisen Gesang. ");

//-----Details Ende-----
  
AddExit("norden", "./hex_09.lpc");
AddExit("westen", "./platz1.lpc");
AddExit("osten", "./whexe_03.lpc");
AddExit("sueden", "./hex_17.lpc");
AddItem("/d/astral/lamuerte/brunnen/npc/seelenraeuber",
REFRESH_DESTRUCT, ([P_MNPC_AREA: ROOM]) );
	
}  
   
