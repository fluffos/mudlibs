// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void grundzustand();
int eisprinz_da;


void create()
{
	

  ::create();


  SetProp( P_INT_SHORT, "Im Haus des Eises");
  SetProp( P_INT_LONG,
	"Du stehst hier in einem wunderschoenen kleinen Eispalast. "
        "Hier besteht alles aus Eis. Ausserdem ist der ganze Raum mit "
        "glitzernden Eiskristallen ueberzogen, die wunderschoen im "
        "Sonnenlicht funkeln und strahlen. An den Waenden wachsen "
	"filigrane Eisblumen und verleihen dem Raum einen gewissen Flair. "
        "In einer Ecke steht ein kleiner Tisch mit einem Stuhl dahinter. "
	"Ausserdem kannst Du auch noch einen Schrank erkennen. In der Mitte "
	"des Raumes befindet sich ein glaeserner grosser Sarg. Weiters "
	"befindet sich neben dem Sarg ein grosser glaeserner Kessel. "
	"Du kannst das Haus im Norden wieder verlassen.");      
	
      
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -40, ENV_TERRAIN: TT_ARCTIC]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"eispalast"}), 
            "Das Haus sieht nur danach aus. Eigentlich ist es eher ein kleines "
	    "Haeuschen aus Eis. Aber man uebertreibt ja gerne :P.");

  AddDetail( ({"flair"}),
	    "Flair sieht man nicht.");
  
  AddDetail( ({"eisblumen","eisblume"}),
	    "Sie schlaengeln sich grazioes ueber die Waende.");
  
  AddDetail( ({"waende"}),
	    "Die Waende bestehen vollkommen aus Eis. An der Suedwand kannst "
	    "Du etwas erkennen.");
  
  AddDetail( ({"suedwand"}),
	    "Ein Relief ist in der Wand eingelassen.");
  
  AddDetail( ({"relief"}),
	    "Es sieht so aus, als waere ein wunderschoener Elfenmann in "
	    "die Wand eingefroren.");
  
  AddDetail( ({"elfenmann"}),
	    "Du spuerst das Verlangen, ihn zu beruehren.");
  
  AddDetail( ({"verlangen"}),
	    "Na fass ihn an, wenn Dir so danach ist, wehren kann er sich "
	    "eh nicht mehr.");
             
  AddDetail( ({"sarg"}),
	     "Der Sarg ist geschlossen.");

  AddDetail( ({"haus","haeuschen","raum"}), 
            "Du befindest Dich hier im Haus des Eises.");

  AddDetail( ({"mitte"}),
	    "In der Mitte des Raumes befindet sich der Sarg.");

  AddDetail( ({"boden"}),
	    "Der Boden ist spiegelglatt.");
  
  AddDetail( ({"nase","himmel"}),
	     "Alles kann man hier auch wieder nicht untersuchen.");
         
	    

  AddDetail( ({"eis","eises","wand","ecke","rest"}),
	    "Das ganze Haus besteht aus Eis.");
          

  AddDetail( ({"tisch"}),
	    "Dieser grosse Tisch besteht, wie der Rest in diesem Raum, "
	    "vollkommen aus Eis. Auf ihm stehen ein paar weisse Kerzenstaender, "
	    "und einige Zettel liegen verstreut herum.");

  
  AddDetail( ({"eiskristalle","eiskristallen","eiskristall"}),
	    "Die Eiskristalle funkeln und glitzern im Sonnenlicht. Sie "
	    "tauchen den ganzen Raum in eine maerchenhafte Umgebung.");
	    

  AddDetail( ({"umgebung"}),
	    "Du fuehlst Dich wie im Maerchen.");

  AddDetail( ({"maerchen"}),
	    "Maenner erzaehlen auch gerne Maerchen.");
           
	   
  AddDetail( ({"maenner"}),
	    "Wirkliche Maenner gibt es nur im Maerchen.");
	    

  AddDetail( ({"schrank"}),
	    "Der Schrank besteht aus purem Eis. Vielleicht kannst Du ihn "
	    "ja oeffnen.");
	    

  AddDetail( ({"kerzenstaender","kerzenstaendern"}),
	    "In den Kerzenstaendern befinden sich seltsamerweise keine Kerzen, "
            "sondern nur kerzenfoermige Eiszapfen.");

  AddDetail( ({"kerzen","kerze"}),
	    "Die Eiszapfen in den Kerzenstaendern sehen aus wie Kerzen.");
	    

  AddDetail( ({"eiszapfen"}),
	    "Welche meinst Du? Die in den Kerzenstaendern oder die an der "
	    "Decke?");
	  	    
  AddDetail( ({"decke"}),
	   "Lauter Eiszapfen haengen von der Decke. Du kannst nur hoffen, "
	   "das sich keiner davon loest und Dir auf den Kopf knallt.");
	  

  AddDetail( ({"kopf","koepfchen"}),
	   "Du hast ein aeusserst huebsches Koepfchen.");  
         

  AddDetail( ({"stuhl"}),
	   "Darauf wuerd ich mich nicht setzen.");

  AddDetail( ({"kessel"}),
	   "In dem Kessel befinden sich Schnee und ein paar Maden.");  
       
  AddDetail( ({"sonnenstrahlen","sonnenlicht","strahlen","licht","strahl"}),
	    "Die Sonnenstrahlen bringen die Kristalle zum glitzern.");
	 	   

  AddDetail( ({"kristalle","kristallen","kristall"}),
	    "In den Eiskristallen spiegelt sich Dein Spiegelbild.");
	   
	            

  AddDetail( ({"spiegelbild"}),
	    "Du erblickst in jedem der Kristalle Deine Leiche.");

  AddDetail( ({"leiche"}),
	    "Verwest, verfault, von Wuermern zerfressen.");

  AddDetail( ({"wuermer","wuermern"}),
	    "Sie fressen Deine letzten erbaermlichen Ueberreste.");

  AddDetail( ({"ueberreste"}),
	    "Als Leiche bist Du ganz und gar nicht mehr sexy.");
	 

  AddDetail( ({"schnee"}),
	    "Er fuehlt sich kalt an.");

  AddDetail( ({"zettel"}),
	     "Oh ein Liebesbrief!");

   AddDetail( ({"liebesbrief","ich","dich"}),
	     "'Ich liebe Dich' steht da drauf.");


	  

  AddDetail( ({"maden","made"}),
	     "Als Du Dir die Maden anguckst, faellt Dir ploetzlich eine "
	     "Hand auf.");
  
  AddDetail( ({"hand","besitzer"}),
	     "Es scheint, als sei die Hand dem Besitzer abgerissen worden.");
  
  AddSmell(DEFAULT_SMELL, "Kalter Wind stroemt durch Deine Nase, als Du tief "
                          "durchatmest.");
			  
 
  AddSmell( ({"wind"}),
	   "Er ist eisig kalt und riecht nach Schnee.");
	  

  AddSmell( ({"schnee"}),
	   "Du kannst den Geruch des Schnees nicht erklaeren.");
  
  AddSmell( ({"geruch"}),
	   "Schnee, Schnee, Schnee und Schnee.");
	      
 
  
  AddSound(DEFAULT_SOUND,"Es ist hier absolut still.");

   
//-----Details Ende-----
  
 AddExit("norden", ROOM "hex_23.lpc");
 AddItem(NPC "shahin.lpc", REFRESH_DESTRUCT);
//-----KOMMANDOS--------

 AddCmd( ({ "beruehre","beruehr" }), "c_beruehren");
 AddCmd( ({ "oeffne" }), "c_oeffnen");
 
 grundzustand();
}  

void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	eisprinz_da = 1;
}

int c_oeffnen(string str)
{
   notify_fail(BS("Was moechtest Du oeffnen"));
   if(!(str == "schrank" || str == "schranktuer"))
   {
     return 0;
   }
   write(BS("Du oeffnest die Schranktuer und Deine Hand bleibt an "
	    "der Schranktuer kleben. Mit aller Gewalt reisst Du sie "
	    "wieder herunter."));
   tell_room(ENV(TP), TPN+" oeffnet einen Schrank.\n", ({TP}));
   TP->AddHp(-60);
   return 1;
}

int c_beruehren(string str)
{
   notify_fail(BS("Was moechtest Du hier beruehren?"));
   if(!(str == "relief" || str == "elfenmann"))
   {
     return 0;
   }
   if(present("eisprinz", ENV(TP)) || (!eisprinz_da))
   {
     write(BS("Du beruehrst vorsichtig den huebschen Elfenmann und wuenschst "
	      "Dir, dass er lebendig waere."));
	      
     return -1;
    }
    else
    {
      write(BS("Sanft streichelst Du ueber das Relief und bewunderst "
	       "die zarten Gesichtszuege des elfischen Mannes. "
	       "Ploetzlich beginnt er sich zu bewegen und steht vor Dir."));
      tell_room(ENV(TP), TPN+" macht etwas und grinst Dich an.\n", ({TP}));
      eisprinz_da = 0;
      CLONEME(NPC "eisprinz.lpc");
      return 1;
     }
  }
