// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/laden";

#include "../def.h"

#include <laden.h>

void grundzustand();
int schrank_offen;


create()	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Kraeuter");
  SetProp( P_INT_LONG,
	"Du befindest Dich in einem kleinen, schmucklosen Kraeuterladen. "
	"Der gesamte Laden duftet nach Kraeutern aller Art. Ein paar "
        "Kraeuterstraeusschen haengen an den Waenden, aber das scheint hier "
        "die einzige Dekoration zu sein. Mitten im Raum befindet sich eine "
        "Theke, hinter der ein paar Regale an die Wand gelehnt stehen. "
	"Ausserdem kannst Du noch einen grossen Schrank erkennen. Nach Norden "
        "kommst Du wieder zum Dorfplatz zurueck.");
	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  SetStorageRoom(ROOM "lagerraum" );
  SetProp(P_SHOPKEEPER_ID, "shila");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Shila");
  
  
  
  
  
//-----Details Anfang-----

  
  AddDetail( ({"kraeuter","kraeutern"}), 
            "Tausendgueldenkraut, Eisenkraut, Johanniskraut, Engelswurz, "
	    "Beifuss, Wermut und Immortelle zB.");

  AddDetail( ({"dekoration"}),
	     "Einige getrocknete Kraeuterbuendel zieren die Wand. Sehr viel "
	     "Dekoration ist es aber leider nicht. Einige frische Blumen "
	     "wuerden hier eigentlich viel huebscher aussehen.");

  AddDetail( ({"blumen"}),
	     "Stell doch bei Dir daheim einige Blumen hin.");
	    
	                 

  AddDetail( ({"tausendendgueldenkraut","kraut"}), 
            "Diese rosa bluehenden Kraeuter werden als Heilpflanzen "
	    "verwendet.");
	    

  AddDetail( ({"regale","rueckwand"}),
	    "Die Regale nehmen die gesamte Rueckwand des Ladens ein. Sie sind "
	    "gefuellt mit bunten Flaeschchen, Keramikdosen und kleinen "
	    "Jutesaeckchen.");
      

  AddDetail( ({"keramikdosen","dosen","dose"}),
	    "In diesen kleinen Keramikdosen bewahrt Shila ihre "
	    "Raeuchermischungen und sonstigen Kraeuter auf. Die Hexen des "
	    "Dorfes kommen oft her, um Nachschub fuer ihre Rituale zu "
	    "besorgen.");
  
  AddDetail( ({"hexen"}),
	    "Die Bewohnerinnen dieses Dorfes sind Hexen.");
	   

  AddDetail( ({"bewohnerinnen","dorf","dorfes"}),
	    "Die Hexen sind sehr boese.");
	    	   

  AddDetail( ({"jutesaeckchen"}),
	    "In ihnen befindet sich gemahlenes Drachenblut.");
            

  AddDetail( ({"drachenblut","harz","baum","baumes"}),
	    "Drachenblut ist das Harz eines bestimmten Baumes.");

  AddDetail( ({"immortelle","unsterblichkeit"}),
	    "Diese Pflanze wird als Kraut fuer die Unsterblichkeit eingesetzt.");
	   
  
  AddDetail( ({"johanniskraut"}),
	    "Auch dieses Kraut wird zum Heilen verwendet.");
            

  AddDetail( ({"spinnweben","ecken","spinnwebe","ecke"}),
	    "Ein paar verlassene Spinnweben befinden sich in den Ecken.");

  AddDetail( ({"decke","buchenholzbretter","buchenholzbrettern",}),
	    "Die Decke besteht aus einfachen Buchenholzbrettern. ");
	    

  AddDetail( ({"wermut","beifuss","engelswurz","eisenkraut"}),
	   "Als Du die Kraeuter naeher inspizierst, faellt Dir eine seltsame "
	   "Pflanze auf.");
	 

  AddDetail( ({"pflanze","gestalt"}),
	   "Die Pflanze hat eine menschenaehnliche Gestalt. Da sie Dir nicht "
	   "bekannt ist, solltest Du Shila danach fragen.");
  
  AddDetail( ({"boden","brettern","kieferbrettern"}),
	   "Der Boden besteht aus Kieferbrettern.");
  
  AddDetail( ({"kraeuterfrau","shila","laden","kraeuterladen","raum"}),
	   "Dieser Kraeuterladen gehoert Shila, der Kraeuterfrau.");

  AddDetail( ({"kreis"}),
	   "Der Kreis ist eckig. Seltsam oder? Normalerweise sind Kreise ja "
	   "rund. Vielleicht bilden sich Deine Augen dass alles einfach nur "
	   "ein.");

  AddDetail( ({"augen"}),
	   "Also bei Deinen wunderschoenen Augen wird ein jeder schwach.");

  AddDetail( ({"schrankrueckseite","rueckseite"}),
	   "Die Schrankrueckseite ist die Rueckseite von einem Schrank.");

          

  AddDetail( ({"dorfplatz"}),
	   "Der befindet sich im Norden.");

  
  AddDetail( ({"kraeuterstraeusschen","kraeuterbuendel"}),
	    "Sie wurden aus undefinierbaren Kraeutern gebunden und duften "
	    "seltsam.");
  
  AddDetail( ({"grosses","heilen","dueftender","schrott"}),
	   "Bitte untersuch nicht jeden Schrott.");

  AddDetail( ({"wand","waende","waenden"}),
	   "Lauter Kraeuterstraeusschen haengen an den Waenden.");

  AddDetail( ({"flaeschchen","heilpflanzen","raeuchermischungen","rituale"}),
	   "Die Hexen benoetigen Vieles fuer ihre magischen Rituale.");

  AddDetail( ({"eichenholz","eichen"}),
	    "Na Holz von Eichen eben.");




  AddSpecialDetail( "schrank", "d_schrank");
  	       
            

  AddDetail( ({"theke"}),
	    "Die Theke ist aus einfachen Brettern zusammengenagelt. "
	    "Dahinter steht die Kraeuterfrau und sortiert ihre Kraeuter.");

  AddDetail( ({"art"}),
	    "Forschen ist sonst nicht so Deine Art hm? ;)");
	    

  AddDetail( ({"duft"}),
	    "Riechen!.");

  AddDetail( ({"fichtenholz","fichte"}),
	    "Das Holz einer Fichte.");

  AddDetail( ({"nachschub","vieles"}),
	   "Die Hexen holen sich hier Nachschub fuer ihre Rituale.");

  AddDetail( ({"energiefeld","feld"}),
	   "Das Energiefeld schimmert seltsam magisch. Irgendwie zieht es "
	   "Deine Blicke auf sich.");

  AddDetail( ({"blicke","augen"}),
	   "Deine Augen sind schon ganz gross.");


 	     
  
  AddSmell(DEFAULT_SMELL, "Der ganze Raum ist erfuellt von den Dueften "
		  "der Kraeuter aller Art.");
                        
 
  AddSmell( ({"Duft","dueften","duefte"}),
	   "Es duftet leicht wuerzig.");

  AddSmell( ({"kraeuterstraeusschen","nelken","zimt","straeusschen"}),
	   "Das Kraeuterstraeusschen duftet irgendwie nach Nelken und Zimt.");
  
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst von irgendwoher ein Scharren. "
		  "So als wuerde etwas Grosses in einer der Waende hausen.");
	   

  AddSound( ({"scharren","monster"}),
	   "Irgendein Monster scheint hinter der Wand zu hausen.");
           
  

//-----Details Ende-----
    AddExit("norden", ROOM "platz2.lpc");

//----KOMMANDOS-------
    
    AddCmd( ({"gehe","geh"}), "c_gehen");
    AddCmd( ({"oeffne"}), "c_oeffnen");
    AddItem(NPC "shila", REFRESH_DESTRUCT);
    AddItem(NPC "kaetzchen", REFRESH_DESTRUCT);     

    grundzustand();
 }

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
    schrank_offen = 0;
    tell_room(TO, "Die Schranktuer schliesst sich knarrend.\n");
   
}

int c_oeffnen(string str)
{
    notify_fail(BS("Was moechtest Du hier denn oeffnen?"));
   if(!(str == "schrank"))
   {
     return 0;
   }
   if(schrank_offen) 
   {	   
   write("Aber der Schrank ist doch schon offen.\n");
    return -1;
   }
   else
   {
     write(BS("Du oeffnest vorsichtig den Schrank und schaemst Dich, dass "
	       "Du so neugierig bist. Der Schrank ist vollkommen leer. "
	       "Auf einmal faellt Dir ein seltsam blau leuchtender Kreis "
	       "an der Schrankrueckseite auf. Es scheint ein Energiefeld "
	       "zu sein. Ob man wohl durch den Schrank gehen kann?"));
      tell_room(ENV(TP), TPN+" oeffnet den Schrank.\n", ({TP}));
      schrank_offen = 1;
      return 1;

     }
  }
  int c_gehen(string str)
{
   notify_fail(BS("Wodurch moechtest Du hier gehen?"));
   if(!(str == "durch schrank"))
   {
     return 0;
   }
   if(schrank_offen) 
   {	   
 
  
   write(BS("Du gehst zitternd, nicht wissend was Dich erwartet, durch den "
	      "Schrank. Du verlierst kurzfristig die Besinnung und wachst "
	      "ploetzlich in einem verborgenen Waeldchen wieder auf."));
              TP->move(ROOM "hex_19.lpc", M_GO);
     return 1;
    }
    else
    {
      write(BS("Du erreichst die Kroenung der vollkommenen Dummheit als "
	       "Du schwachsinnigerweise versuchst, durch den geschlossenen "
	       "Schrank zu gehen. Du knallst mit voller Wucht mit Deinem "
	       "Kopf gegen die Schranktuer. Naja Holz zu Holz gesellt sich "
	       "gern. Vielleicht wirst Du jetzt klueger."));
      tell_room(ENV(TP), TPN+" schlaegt " + TP->QPP(MALE,WEN) + " Holzkopf "          "gegen den Schrank.\n", ({TP}));
      TP->AddHp(-50); 
       return 1;
      

    }
 
   }

  string d_schrank(string str)
  {
   string s;
   
   if(schrank_offen)
   {
    s = "Der Schrank besteht aus massivem Eichenholz. Er ist geoeffnet.";
   }
   else
   {
    s = "Der Schrank besteht aus massivem Eichenholz. Er ist geschlossen.";
   }
   return BS(s);
   }

   int sell(string str, int f)
   
{
  notify_fail("Ihr koennt hier nichts verkaufen Fremder!\n");
  return 0;
}

  int force_sell(string str) { return sell(); }
  int evaluate(string str) { return sell(); }

