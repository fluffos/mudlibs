// Raum meines Gesellenstueckes "Hexenstadt"

inherit "std/room";
#include "../def.h"




void grundzustand();
int koenigskobra_da;
int armreif_da;

create()
{
	

  ::create();


  SetProp( P_INT_SHORT, "Im Haus des Todes");
  SetProp( P_INT_LONG,
	"Du stehst in einem Haus, das Dich erschaudern laesst. Ueberall "
        "am Boden befinden sich brodelnde Tuempel, aus dem dicke Nebelschwaden "
	"durch den gesamten Raum ziehen. Zaehe rote Fluessigkeit schwallt aus "
        "den vielen kleinen Vulkanen, die sich hier ueberall befinden und "
	"sammelt sich zu dicken Baechen. Du musst gut aufpassen, dass Du nicht "
	"auf die vielen Leichen trittst, die hier ueberall verstuemmelt am "
        "Boden liegen. Weiters erkennst Du einige abgetrennte Koepfe, deren "
        "hervorgequollenen Augen Dich unentwegt anstarren. Waende gibt es hier "
	"seltsamerweise keine. Du hast das Gefuehl, Dich in den unendlichen "
	"Weiten der Hoelle zu befinden. Selbst die Tuer ist einfach nur ein "
	"schwarzes Loch, durch das Du wieder zum Wald kommst.");
	

      
	
      
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"weiten","haus","raumes","raum","hauses"}), 
            "Du befindest Dich in Jades Haus des Todes.");
	           

  AddDetail( ({"todes","tod"}), 
            "Der Tod lauert schon auf Dich.");
   
  AddDetail( ({"leichen","leiche"}),
	    "Furchtbar zerstuemmelte Leichen liegen ueberall am Fussboden. "
	    "Ihre Eingeweide sind zum Teil aus ihren Koerpern gequetscht, "
	    "und Du wendest Dich angeekelt ab.");            

  AddDetail( ({"eingeweide","reste","fleisches","eingeweiden"}),
	    "Lauter weisse Maden tummeln sich in den Eingeweiden und fressen "
	    "die letzten Reste des verwesten Fleisches.");
	   
  AddDetail( ({"maden"}),
	    "Sie fressen gierig das tote Fleisch. Unter einer besonders dicken "
	    "Made scheint etwas zu glitzern.");
	    

  AddDetail( ({"du","dich"}),
	    "Jade teilt Dir mit: Du wirst sterben.");

  AddDetail( ({"made"}),
	    "Irgendwas glitzert unter ihr.");
            
  AddDetail( ({"etwas","glitzern"}),
	    "Das Glitzern entpuppt sich als Armreif. Vielleicht solltest "
	    "Du ihn aus den Eingeweiden herausgraben.");
 

  AddDetail( ({"armreif"}),
	    "Ueberwinde Dich und grab ihn aus den Eingeweiden.");
	 
  AddDetail( ({"tuempel","tuempeln"}),
	    "Die Tuempel blubbern und brodeln vor sich hin. ");

  AddDetail( ({"nebelschwaden"}),
	    "Viele blutrote Nebelschwaden stroemen aus den Tuempeln.");
	    

  AddDetail( ({"waende","decke","wand"}),
	    "Das Haus hat weder Waende noch eine Decke.");
	    
  AddDetail( ({"tuer","loch","wald","osten"}),
	   "Durch das Loch im Osten gelangst Du wieder zum Wald zurueck.");
	  

  AddDetail( ({"hoelle"}),
	   "Du wirst hier verrecken und ewig in der Hoelle schmoren.");  
 
  AddDetail( ({"fluessigkeit"}),
	   "Die Fluessigkeit ist blutrot und zaeh. Sie scheint hochgiftig zu "
	   "sein. Wenn Du hineintrittst, bist Du schneller bei Lars, als Du "              "bis 3 zaehlen kannst.");

  AddDetail( ({"lars"}),
	   "Tippe: tritt in Fluessigkeit, dann bist Du mausetot."); 
         
  AddDetail( ({"baeche","baechen"}),
	    "Die Fluessigkeit, die Dich toeten wird, stroemt in dicken Baechen "
	    "ueber den Fussboden.");
	 	   

  AddDetail( ({"boden","fussboden"}),
	    "Die vielen Leichen, die hier herumliegen, ekeln Dich an. Bei "
	    "einer Leiche scheinen sich die Gedaerme zu bewegen.");
            

  AddDetail( ({"gedaerme"}),
	    "Du kommst auf die Schnapsidee, an dem Darm zu ziehen.");
	   
  AddDetail( ({"schnapsidee","idee"}),
	    "Hast Du gute Ideen eigentlich auch?");

  AddDetail( ({"ideen"}),
	    "Von guten Ideen scheinst Du nicht sehr gesegnet zu sein.");

  AddDetail( ({"darm"}),
	    "Der Darm bewegt sich und ist schwarz. Ueberleg es Dir gut, ob "
	    "Du an ihm ziehst.");

  AddDetail( ({"sicht","vulkane","rauch","vulkan"}),
	    "Der dampfende Rauch der Vulkane versperrt Dir die Sicht.");

  AddDetail( ({"gefuehl"}),
	     "Dein Gefuehl sagt Dir, dass Du sterben wirst.");

  AddDetail( ({"koepfe","koepfen","kopf"}),
	     "Die Koepfe wurden ihren Besitzern gewaltsam abgetrennt. "
	     "Sie sind zum Teil verwest, und lauter Maden tummeln sich in den "
	     "Mundhoehlen.");

  AddDetail( ({"besitzer","besitzern","rest"}),
	     "Der Rest, der zu den Koepfen gehoert, liegt hier sicher irgendwo "
	     "zermatscht.");

  AddDetail( ({"teil","koerperteile","deine"}),
	     "Vielleicht liegen Deine Koerperteile auch bald hier.");

  AddDetail( ({"mundhoehlen","zaehne","mundhoehle"}),
	     "Einige verstummelte Zaehne siehst Du zwischen den Maden "
	     "hervorblitzen.");
  
  AddDetail( ({"augen","auge"}),
	     "Die Augen sind hervorgequollen und weiss.");

  AddDetail( ({"jades","koerpern","vulkanen","du","blubb"}),
	     "Bald wirst Du sterben.");

  AddDetail( ({"beine","zischen","schlangen","zungen","bein","schlange"}),
	     "Du bemerkst einige Schlangen, die sich zwischen Deine Beine "
	     "schlaengeln und dabei mit ihren Zungen zischen.");

  
  AddRoomMessage( ({"Die Tuempel blubbern monoton vor sich hin.\n",
	          "*BLUBB* *BLUBB*.\n",
		  "Blutrote Nebelschwaden ziehen vom Boden auf.\n",
		  "Einer der kleinen Vulkane bricht aus.\n",
		  "Du hoerst ein leises Zischen.\n",
		  "Einige Nebel trueben die Sicht.\n",
		  "Rote Fluessigkeit spritzt auf Deine Beine.\n"}), 30);
  
  AddSmell(DEFAULT_SMELL, "Hier riecht es sehr stark nach Schwefel und totem "
                          "Fleisch.");  
 
  AddSmell( ({"schwefel"}),
	   "Die Nebel brennen in Deinen Augen.");
	  

  AddSmell( ({"fleisch"}),
	   "Das verweste Fleisch erweckt Brechreiz bei Dir.");
  
  AddSmell( ({"brechreiz","augen","nebel"}),
	   "Soviel kannst Du hier nun auch wieder nicht riechen.");
  
 
  
  AddSound(DEFAULT_SOUND,"Du hoerst das Brodeln und Blubbern der Tuempel.");
	
  AddSound( ({"brodeln","tuempel"}),
	   "Die Tuempel brodeln monoton.");
	           
  
  AddSound( ({"blubbern"}),
	   "*BLUBB*.");
	   
 
//-----Details Ende-----
  
 AddExit("osten", ROOM "hex_22.lpc");
 AddItem(NPC "jade.lpc", REFRESH_DESTRUCT);
//-----KOMMANDOS--------

 AddCmd( ({ "grabe", "grab" }), "c_herausgraben");
 AddCmd( ({ "tritt","trete" }), "c_hineintreten");
 AddCmd( ({ "ziehe", "zieh" }), "c_ziehen");
 AddCmd( ({ "schlaf", "schlafe" }), "c_schlafen");
 
 grundzustand();
}  

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	koenigskobra_da = 1;
	armreif_da = 1;
}

 
int c_herausgraben(string str)
{
   object armreif;
   notify_fail(BS("Was moechtest Du hier denn herausgraben?"));
   if(!(str == "armreif heraus"))
   {
     return 0;
   }
   if(present("hexe")) 
   {	   
   write("Die Hexe steht Dir im Weg.\n");
    return -1;
   }
   
   if(present("\njadereif", ENV(TP)) || (armreif_da==0))
   {
     write(BS("Du graebst Dich tief in die Eingeweide, aber das Glitzern war "
	      "nichts weiter als ein goldener Zahn. Du ziehst Deine Haende "
	      "wieder heraus und wischt sie in Deinem Umhang sauber."));
     return 1;
    }
    else
    {
      write(BS("Du graebst Deine Haende tief in die Eingeweide. So sehr "
	       "es Dich ekelt, die Gier ist staerker. Du nimmst den Armreif "
	       "an Dich."));
      tell_room(ENV(TP), TPN+" wuehlt tief in den Eingeweiden.\n", ({TP}));
      armreif_da = 0;
      armreif = clone_object(ARMOUR "armreif");
      if (armreif->move(TP,M_GET) < 0)
  {
    write(BS("Du kannst den Armreif nicht mehr tragen."));
    tell_room(TPN +" ist ein kleines Seicherl.\n", ({TP}) );
    armreif->move(TO, M_NOCHECK);
  }
      return -1;
    }
   }
  

int c_ziehen(string str)
{
   object npc;
   
   notify_fail(BS("Woran moechtest Du hier denn ziehen?"));
   if(!(str == "an darm"))
   {
     return 0;
   }
   if(present("koenigskobra", ENV(TP)) || (!koenigskobra_da))
   {
     write(BS("Du ziehst an dem Darm, aber ausser das Du Dich mit Blut "
	      "bekleckerst, ist nichts passiert."));
	      
     return -1;
    }
    else
    {
      write(BS("Du ziehst an dem Darm. Ploetzlich bemerkst Du das es kein "
	       "Darm war sondern die Schwanzspitze einer grossen Kobra, die "
	       "Du voellig schockiert in Deinen Haenden haeltst. Sie blickt "
	       "Dich mit funkelnden Augen an und greift Dich sofort an. "));          tell_room(ENV(TP), TPN+" macht eine grosse Dummheit.\n", ({TP}));
      koenigskobra_da = 0;
      npc = clone_object(NPC "kobra.lpc");
      npc->move(TO, M_GO);
      npc->Kill(TP); 
      
      return 1;

    }
   }

    int c_hineintreten(string str)
{
   notify_fail(BS("Wo moechtest Du denn hineintreten?"));
   if(!(str == "in fluessigkeit"))
   {
     return 0;
   }
   write(BS("Du beachtest keine der Warnungen. Also musst Du jetzt "
	    "mit Konsequenzen rechnen. Viel Spass bei Lars."));
	  	  
   tell_room(ENV(TP), TPN+" beginnt gerade Selbstmord.\n", ({TP}));
   SetProp(P_KILL_NAME, "Das Blut der Todeshexe");
   TP->do_damage(500, TO);
   
   return 1;
  }
          int c_schlafen(string str)
{
   notify_fail(BS("Mit wem moechtest Du schlafen?"));
   if(!(str == "ein"))
   {
     return 0;
   }
   write(BS("Du willst Jade entfliehen und tippst das Kommando 'Schlaf ein'.\n "
	    "Du machst nur ein kleines Nickerchen. Riskant oder?"));
	  	  
   tell_room(ENV(TP), TPN+" ist muede und macht ein Nickerchen.\n", ({TP}));
   
   return 1;
  }
 
 
   
