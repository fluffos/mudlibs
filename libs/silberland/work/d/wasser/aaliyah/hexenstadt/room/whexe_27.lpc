// von Aaliyah
// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"


inherit "std/room";
#include "../def.h"




void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer kleinen Stadt");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einem kleinen Kieselweg, der vom "
	"Dorfplatz im Westen zu ein paar Steinhaeusern im Norden fuehrt. "
	"Am Wegrand wachsen hier vereinzelt ein paar Himbeerstraeucher. "
	"Der Himmel faerbt sich hier seltsam blutrot, und Du fuehlst Dich "
	"hier etwas unsicher. Ausserdem erkennst Du einige Geier, die "
        "ueber Dir ein paar Runden ziehen und auf ihre naechste Beute warten.");       
      

	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

   AddDetail( "raum", QueryProp(P_INT_LONG) );

  
  AddDetail( ({"boden","weg","kieselweg"}), 
            "Es ist ein einfacher Kieselweg. Zwischen den Kieselsteinen "
	    "kannst Du ein paar verwesende Stuecke Fleisch erkennen. "
	    "Du wendest Dich angewidert ab.");
             

  AddDetail( ({"stuecke","fleisch","stueck"}), 
            "Beim genaueren Hinsehen entpuppt sich das Fleisch als "
	    "Leichenteile.");
            
	 
  AddDetail( ({"leichenteile","weise","leichenteil"}),
	    "Scheint so, als wuerden hier Menschen auf grausame Weise "
	    "geschlachtet werden.");
      

  AddDetail( ({"kieselsteine","kieselstein","stein","steine"}),
	    "Sie sind von Blut getraenkt.");
	    	  
  
  AddDetail( ({"blut"}),
	    "Blut von Menschen, die hier grausam hingerichtet wurden.");
	 
  AddDetail( ({"menschen","wesen"}),
	    "Nicht nur Menschen, sondern auch andere Wesen des Silberlands "
	    "wurden hier grausam getoetet.");
	  

  AddDetail( ({"silberland"}),
	    "Es gibt viel schoenere Gegenden hier, wieso musstest Du "
	    "ausgerechnet hierher kommen? Hier findest Du Deinen sicheren "
	    "Tod.");
         

  AddDetail( ({"gegenden","seicherlgegenden","gegend","seicherlgegend"}),
	    "Geh besser in Seicherlgegenden, wo Dir nichts passiert:).");

  AddDetail( ({"tod","leben","ende"}),
	    "Hier findet Dein Leben ein Ende. Bald wirst Du sterben und "
	    "auf Ewigkeit in der Hoelle schmoren. Und wenn Du wie ein Irrer "
	    "Kohlen schaufelst, wirst Du Dir wuenschen, diese Stadt nie "
	    "betreten zu haben.");
	   
  
  AddDetail( ({"ewigkeit"}),
	    "Hast Du Angst?.");
            

  AddDetail( ({"steinhaeuser","norden"}),
	    "Die Steinhaeuser befinden sich im Norden."); 
	   
	    

  AddDetail( ({"geier","ueberreste"}),
	    "Die Geier freuen sich schon auf Deine jaemmerlichen, sterblichen "
	    "Ueberreste.");
	  
  AddDetail( ({"dorfplatz","westen"}),
	   "Im Westen gelangst Du wieder auf den Dorfplatz zurueck.");

  AddDetail( ({"hoelle","kohlen","stadt"}),
	    "Wenn Du in dieser Stadt stirbst, bist Du auf ewig dazu verdammt, "
	    "wie in der Hoelle wie ein Irrer Kohlen zu schaufeln.");

  AddDetail( ({"augen","hinsehen","traenen","auge"}),
	    "Beim genaueren Hinsehen beginnen Deine Augen zu Traenen."); 
  
  AddDetail( ({"oberarm","runden","augenwinkel"}),
	    "Stirb endlich!");
	 

  AddDetail( ({"angst"}),
	   "Du zitterst.");
          

  AddDetail( ({"himmel","blutrot"}),
	   "Der Himmel ist wolkenlos und strahlt in einem tiefen "
	   "blutrot.");

  AddDetail( ({"wolken","wolke"}),
	   "Keine da.");

  AddDetail( ({"hexenstadt"}),
	    "Da bist Du gerade.");
  
  AddDetail( ({"wegrand","wegesrand","himbeerstraeucher"}),
	    "Ein paar Himbeerstraeucher wachsen am Wegesrand.");

  AddDetail( ({"beute"}),
	     "Die Beute wirst Du sein!");
  
  AddDetail( ({"leichen","leiche"}),
	     "Verstuemmelte Leichen liegen ueberall am Boden.");

  AddDetail( ({"irrer"}),
	     "Wenn Du wirklich irre und lebensmuede bist, untersuch "
	     "das Detail Selbstmord.");
  
  AddDetail( ({"selbstmord","detail"}),
	     "Wenn Du das Detail Mord untersuchst, wirst Du sterben. "
	     "Das ist ein richtiger Tod und Du bekommst keinerlei "
	     "Entschaedigung dafuer.");

  AddDetail( ({"entschaedigung","tod"}),
	     "Untersuche Mord und Du bekommst keine Entschaedigung.");

  AddDetail( ({"toten"}),
	"Sie schweigen.");

  AddDetail( ({"nackenhaare","berge","angst"}),
	"Deine Nackenhaare stehen zu Berge, vor lauter Angst vorm Sterben.");

  AddSpecialDetail( ({"mord"}), "d_mord");


	
  
  AddSmell(DEFAULT_SMELL, "Du kannst den Geruch des Todes riechen. "
		  "Der Gestank verwesten Fleisches treibt Dir Traenen in "
		  "die Augen und Du musst Dich uebergeben.");
                        
 
  AddSmell( ({"geruch","todes","tod"}),
	   "Verbranntes Fleisch, verwestes Fleisch.. hier riecht es stark "
	   "nach totem Fleisch.");
  
  AddSmell( ({"fleisch","fleisches"}),
	    "Das kommt von den zerstuemmelten Leichen, die hier ueberall am "
	    "Boden liegen.");
	  
  AddSmell( ({"gestank"}),
	     "Es riecht bestialisch.");
 
  
  AddSound(DEFAULT_SOUND, "Hier ist es totenstill.");

  AddSound( ({"totenstille","raum","toten"}),
	  "Die Toten sind so still wie dieser Raum hier.");
	
	   
  

//-----Details Ende-----
  
AddExit("westen", "./whexe_03.lpc");
AddExit("norden", "./whexe_05.lpc");

AddRoomMessage( ({"Irgendwas streicht Dir ueber den Oberarm.\n",
	          "Du fuehlst Dich beobachtet.\n",
		  "In den Augenwinkeln erkennst Du ein geisterhaftes Wesen.\n",
		  "Irgendwas scheint Dich zu verfolgen.\n",
		  "Irgendwas scheint nach Deinem Blut zu lechzen.\n"}), 70);

}  
  string d_mord()
 {
  if(TP->QueryProp(P_GENDER) == FEMALE)
  SetProp (P_ENEMY_DEATH_SEQUENCE, OBJ "frau.seq");
   	
  else
  SetProp (P_ENEMY_DEATH_SEQUENCE, OBJ "man.seq");
  SetProp(P_KILL_NAME, "Der Tanz der Hexen");
  SetProp(P_KILL_MSG, "Die Hexen tanzen um Deine Leiche");


   write(BS("Du hast alle Warnungen mutwillig umgangen. Deshalb musst Du "
            "jetzt auch die Konsequenzen mit Wuerde tragen. Dies ist kein "
            "Faketod und somit wirst Du einen grossen Teil Deiner Xps "
            "leider nach dem Beten verloren haben."));
   tell_room(ENV(TP), TPN+" hat anscheinend zuviele Xps.\n", ({TP}));
   WLOG(LOG "scripttod", "untersucht Mord");
   TP->die();
   return "Nun stirb mit Wuerde und Ehre.\n";
 }
      
