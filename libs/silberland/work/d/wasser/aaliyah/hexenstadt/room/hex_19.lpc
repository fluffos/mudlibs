// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>


void grundzustand();
int stofffetzen_da;

create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im tiefsten Winter");
  SetProp( P_INT_LONG,
	"Du befindest Dich ploetzlich in einem kleinen verschneiten "
        "Waeldchen. Wo Du hinsiehst, es liegt ueberall Schnee. "
        "Die Eiskristalle funkeln und glitzern im Sonnenlicht. "
        "Weihnachtlich duften die Tannen, und Du spuerst das Verlangen, "
	"einen schoenen Adventskranz zu basteln. Im Nordwesten befindet "
	"sich der seltsame blaue Kreis, durch den Du hierher gekommen bist.");
	
        
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -30, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Am Boden liegt eine dicke Schneeschicht. Du stehst schon bis zu "
	    "den Knien im Schnee, fuehlst aber seltsamerweise keine Kaelte.");
             

  AddDetail( ({"knie","knien"}), 
            "Ein bisschen zittern Deine Knie schon, aber das liegt eher "
            "daran, dass Du Dich fuerchtest als das Dir kalt ist.");

  AddDetail( ({"schneeschicht","schnee","neuschneeschicht"}),
	    "Du wuerdest gerne einen Schneemann bauen, aber dafuer hast Du "
	    "im Moment keine Zeit, pass besser auf, dass Du hier nicht "
	    "stirbst.");
     

  AddDetail( ({"schneemann"}),
	    "Bau ihn lieber in Yiqanuc, da ists weniger gefaehrlich.");
  
  AddDetail( ({"yiqanuc"}),
	    "Die Stadt der Xandims in Polar.");
	    

  AddDetail( ({"xandims","wesen"}),
	    "Xandims sind kleine pelzige Wesen.");

  AddDetail( ({"polar"}),
	    "Brrr.. Dir wird kalt, wenn Du nur daran denkst.");
          

  AddDetail( ({"kaelte"}),
	    "Nein kalt ist Dir hier seltsamerweise nicht.");

  AddDetail( ({"adventskranz","adventkranz","kranz","adventszeit","zeit"}),
            "Du erinnerst Dich an Deine Kindheit.\n"
	    "Deine Mutter hat mit Dir immer zur Adventszeit einen "
	    "Adventkranz gebastelt. Sie ist mit Dir im Wald spazieren "
	    "gegangen und hat mit Dir Tannenzweige gesammelt. "
	    "Daheim wurden die Zweige dann schoen zu einem Kranz gebunden "
	    "und mit goldenen Schleifchen, Kerzen, Perlen und kleinen "
	    "Figuren geschmueckt.");

  AddDetail( ({"kindheit","Kind","sorgen"}),
	    "Wie gerne wuerdest Du wieder ein Kind sein, und Dich "
            "einfach sorgenfrei von Deiner Mutter verwoehnen lassen.");

  AddDetail( ({"mutter","mami","welt","umarmung"}),
	    "Du bist Dir sicher, dass Deine Mami die beste Mami der Welt ist. "
	    "Du brauchtest jetzt eine Umarmung von ihr, um Dich auch hier "
	    "an diesem duesternen, seltsamen Ort geborgen zu fuehlen.");

  AddDetail( ({"ort","wald","stadt"}),
	    "Vielleicht kommst Du hier nie wieder lebend weg?");
	   

  AddDetail( ({"sonnenlicht","sonnenstrahlen","strahlen","sonnenstrahl"}),
	   "Die Sonnenstrahlen bringen die Eiskristalle der Neuschneeschicht "
	   "zum Strahlen und Funkeln. Sie tauchen den gesamten Wald in ein "
	   "funkelndes und glitzerndes Gebiet.");


  AddDetail( ({"gebiet"}),
	   "Der Boden und die Tannen funkeln, als waeren lauter klitzekleine "  
           "Diamanten daruebergestreut. ");

  AddDetail( ({"diamanten","girls"}),
	   "Diamonds are the girls best friends.");

  AddDetail( ({"friends"}),
	   "Haettest Du ein paar mit hierher genommen, wuerdest Du nicht so "  
           "einsam sein.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wolkenlos und schimmert in einem violetten "
	    "Licht.");

  AddDetail( ({"wolken","wolke"}),
	    "Bist Du betrunken? Wo siehst Du hier Wolken? ");
            

  AddDetail( ({"licht"}),
	    "Mystisch schimmert der Himmel in violettem Licht. ");

  AddDetail( ({"eiskristalle","funkeln","eiskristall"}),
	    "Die Eiskristalle funkeln wunderschoen im Sonnenlicht.");

  AddDetail( ({"schokolade"}),
	    "Wie gerne haettest Du jetzt eine heisse Schokolade.");

  AddDetail( ({"tannen"}),
	    "Sie sind total mit Schnee bedeckt. An einer scheint etwas "
	    "zu haengen.");

  AddDetail( ({"tanne","einer","aeste","ast"}),
	    "An einem der Aeste haengt tatsaechlich ein blutroter Stofffetzen.");
	    

  AddDetail( ({"stofffetzen"}),
	    "Vielleicht kannst Du ihn nehmen?");

  AddDetail( ({"schritten","kreis","lungen","moment","gegenwart"}),
	    "Feyaria teilt Dir mit: bug.");

  AddDetail( ({"feyaria","erzmagierin","finger"}),
	    "Finger Feyaria.");

  AddDetail( ({"verlangen"}),
	    "Jetzt haettest Du gerne eine heisse Schokolade.");

  AddDetail( ({"tannenzweige","zweige"}),
	    "Nur die schoensten Zweige wurden von euch verwendet.");

  AddDetail( ({"schleifchen","kerzen","perlen","figuren"}),
	    "Mit denen wurde euer Kranz geschmueckt.");
	     
  
  AddSmell(DEFAULT_SMELL, "Die Luft hier ist rein, ohne jegliche "
                          "Nebengerueche.");  
 
  AddSmell( ({"geruch","nebengerueche"}),
	   "Wenn hier etwas riecht, dann bist das Du.");
	   

  AddSmell( ({"luft"}),
	   "Deinen Lungen tut die frische Luft ganz gut.");
  

  
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst den Schnee knirschen. "
	   "Es hoert sich an, als ob hier lauter Leute durch den "
	   "Schnee stapfen wuerden.");

  AddSound( ({"leute"}),
	   "Sehen kannst Du niemanden, aber Du spuerst ihre Gegenwart.");
           
  
  AddSound( ({"schnee"}),
	   "Er knirscht unter Deinen Schritten.");

//-----Details Ende-----
  

 AddExit("nordwesten", "./hex_17.lpc");
 AddExit("osten", "./hex_20.lpc");
 AddExit("sueden", "./hex_22.lpc");

//-----KOMMANDOS----------------------------------------

 AddCmd( ({"nimm"}), "c_nehmen");

 grundzustand();
}  
  
void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
        stofffetzen_da = 1;
}
	
int c_nehmen(string str)
{
    notify_fail(BS("Was moechtest Du denn nehmen?"));
    if(!(str == "stofffetzen" || str == "fetzen"))
    {
      return 0;
    }
    if(present("stofffetzen", ENV(TP)) || (!stofffetzen_da))

    {
	    
      write(BS("Du schuettelst etwas Schnee vom Ast und wirst dadurch "
	       "total durchnaesst."));
      tell_room(ENV(TP), TPN+" schuettelt etwas Schnee vom Ast.\n", ({TP}));
      
     
      return -1;
     }
     else
     {
       write(BS("Du schuettelst etwas Schnee vom Ast und nimmst den "
	        "Stofffetzen an Dich."));
      tell_room(ENV(TP), TPN+" schuettelt etwas Schnee vom Ast.\n", ({TP}));
      stofffetzen_da = 0;
      CLONE (OBJ "fetzen.lpc", TP);
      return 1;
     }
    }
