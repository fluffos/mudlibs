// von Aradia
// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Mittelpunkt");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier am Dorfplatz der Stadt Sacciw. "
        "Der Platz ist fast leer, nur ab und zu siehst Du ein paar "
        "vermummte Gestalten hektisch vorbeihuschen. "
        "Du fuehlst Dich, als waeren 1000 Augen auf Dich gerichtet. "
	"Aus der Kneipe im Nordwesten stroemt ein seltsamer Geruch.");
	
  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","sand","sandig"}), 
            "Der Boden ist hier noch etwas sandig. Vereinzelt liegen ein paar "
	    "Kieselsteine herum.");
             

  AddDetail( ({"sand","sandig"}), 
            "Der Sand wurde offenbar vom Strand hergeweht, "
            "und ab und zu glaubst Du, auch etwas Asche darin "
	    "zu erkennen. ");

  AddDetail( ({"asche"}),
	    "Du laesst etwas Sand durch Deine Finger rieseln "
	    "und merkst, dass es tatsaechlich Asche ist. Wo mag "
            "die nur herkommen?.");

  AddDetail( ({"strand"}),
	    "Von hier kannst Du den Strand nicht mehr erkennen. ");
  
  AddDetail( ({"gestalten","gestalt"}),
	    "Ganz in schwarz gekleidete Gestalten huschen hektisch "
	    "ueber den Platz. ");

  AddDetail( ({"platz","Dorfplatz"}),
	    "Du befindest Dich mitten am Dorfplatz. ");

  AddDetail( ({"augen","auge"}),
	    "Sehen kannst Du sie nicht, jedoch fuehlst Du, wie sie jeden "
	    "Deiner Schritte beobachten. ");

  AddDetail( ({"schritte","schritt"}),
	    "Mach hier keinen falschen Schritt, sonst koennte das hier "
	    "womoeglich toedlich enden. ");

  AddDetail( ({"kneipe"}),
	    "Die Kneipe befindet sich im Nordwesten. "
	    "Wenn Du Hunger oder Durst hast, kannst Du ja auf einen kleinen "
	    "Imbiss vorbeischauen. ");

  AddDetail( ({"kieselsteine","kieselstein","steine","stein"}),
	    "Kleine, mittlere und groessere Kieselsteine, aber sehr "
	    "uninteressant. ");

  AddDetail( ({"hunger"}),
	    "Durch die ganze Forscherei hast Du total aufs Essen vergessen. ");

  AddDetail( ({"essen","imbiss","leckeres"}),
	    "Schau doch mal in der Kneipe vorbei, vielleicht haben sie ja "
	    "dort etwas Leckeres fuer Dich. ");

  AddDetail( ({"durst"}),
	   "Falls Du Halrons Thermoskanne dabei hast, trink doch mal einen "
	   "Schluck daraus.");

  AddDetail( ({"schluck","wasser","thermoskanne"}),
	   "Ein Schluck Wasser wuerde Deiner trockenen Kehle sicher "  
           "guttun. ");

  AddDetail( ({"kehle"}),
	   "Deine Kehle ist ganz ausgetrocknet.");

  AddDetail( ({"halron","gebirge"}),
	   "Hier wirst Du ihn nicht finden, such doch mal im Gebirge "  
           "nach ihm. ");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wolkenlos und schimmert in einem violetten "
	    "Licht.");

  AddDetail( ({"wolken","wolke"}),
	    "Bist Du betrunken? Wo siehst Du hier Wolken? ");
            

  AddDetail( ({"licht"}),
	    "Mystisch schimmert der Himmel in violettem Licht. ");

  AddDetail( ({"geruch","nebenberuch"}),
	    "Wofuer hast Du Deine Nase hm?");

  AddDetail( ({"nase"}),
	    "Trag sie nicht zu hoch, sonst regnet es noch rein ;).");

  AddDetail( ({"nordwesten"}),
	    "Im Nordwesten befindet sich die Kneipe. ");

  AddDetail( ({"luft"}),
	    "Klare frische Luft mit einem seltsamen Nebengeruch. ");

    
  AddDetail( ({"forscherei"}),
	   "Die viele Forscherei nervt Dich.");

    
  AddDetail( ({"sacciw","stadt"}),
	   "Diese Stadt hier heisst Sacciw.");

    
  AddDetail( ({"windhauch","schulter","haut"}),
	   "Ein Windhauch streift Deine Schulter.");

    
  AddDetail( ({"summen"}),
	   "Lauschen!");

  AddDetail( ({"irgendetwas"}),
	   "Du entdeckst einen toten Vogel, der schon fast verwest ist.");

  AddDetail( ({"vogel","fliegen","vogels"}),
	   "Viele Fliegen tummeln sich um den toten Vogel.");

  AddDetail( ({"brechreiz"}),
	   "Dich wuergt es ganz schoen bei dem Geruch des Vogels.");


    
  AddDetail( ({"nebengeruch","geruch"}),
	   "Riechen!");
	     
  
  AddSmell(DEFAULT_SMELL, "Du riechst klare frische Luft, vermischt "
                          "mit einem seltsamen Nebengeruch.");  
 
  AddSmell( ({"geruch","nebengeruch"}),
	   "Es riecht irgendwie seltsam nach Sandelholz und Mhyrre, "
	   "aber sicher bist Du Dir nicht.");

  AddSmell( ({"luft"}),
	   "Du riechst die klare Luft und fuehlst Dich frei.");
  
  AddSmell( ({"sandelholz"}),
	   "Es riecht hier leicht suesslich nach Sandelholz.");

  AddSmell( ({"Myrrhe"}),
	   "Du scheinst Dich getaeuscht zu haben, es riecht hier doch nicht "  
           "nach Myrrhe.");

  AddSmell( ({"vogel","geruch"}),
	   "Du schnupperst an dem toten Vogel und es wuergt Dich. Er ist total "           "verwest und verfault also darfst Du Dich nicht wundern wenn "
	   "Du bei diesem Geruch einen Brechreiz bekommst.");
  
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst ein Fluestern und ein leises Summen, "
	   "es scheint als wuerden tausende von Frauen leise Lieder singen.");

  AddSound( ({"fluestern","frauen","gesang","wort"}),
	   "So sehr Du Dich bemuehst, Du kannst kein Wort verstehen.");

  AddSound( ({"summen"}),
	   "Es klingt so, als wuerden unzaehlige Fliegen sich um Irgendwas "
	   "tummeln.");

  AddSound( ({"fliegen","fliege"}),
	   "Schau mal besser nach, was die Fliegen so interessant finden.");
           
  
  AddSound( ({"lieder","frauen"}),
	   "Du hoerst sanften leisen Gesang. ");

//-----Details Ende-----

AddExit("norden", "./whexe_10.lpc");
AddExit("nordwesten", "./kneipe.lpc");
AddExit("osten", "./platz2.lpc");
AddExit("westen", "./whexe_13.lpc");

AddItem( NPC "hand", REFRESH_DESTRUCT);

AddRoomMessage( ({"Ein kalter Windhauch streicht ueber Deine Haut.\n",
	          "Du fuehlst Dich beobachtet.\n"}), 90);
}


   
