// von Aaliyah
// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"

inherit "std/pub";
#include "../def.h"
#include <pub.h>



void create()

{
  ::create();

  SetProp( P_INT_SHORT, "Hollys letzte Einkehr");
          
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "holly");
  SetProp(P_PUBKEEPER_NAME, "Holly");
  SetProp(P_PUBMSG_NOKEEPER, "Holly ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du bist gerade in einem verbissen Kampf mit Holly. Kein Wunder, "
      "dass sie Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Holly ist gerade in einen Kampf verwickelt und kann Dich nicht bedienen."));
  SetProp(P_PUBMSG_FIGHTING, "Holly kaempft gerade.\n");
  
//-----Details Anfang-----
  
  AddDetail( ({"boden","teppichboden"}), 
            "Der gesamte Raum ist mit einem Teppichboden ausgelegt. "
	    "Dich wundert es, dass die Wirtin anscheinend keinerlei Angst "
            "vor Brandloechern oder sonstigen Flecken hat. Du fuehlst Dich "
	    "irgendwie wie in einem Wohnzimmer.");

  AddDetail( ({"angst"}), 
            "Hier fuehlst Du Dich wohl, hier hast Du keine Angst.");
           

  AddDetail( ({"brandloecher","flecken","brandloch","fleck"}),
	    "Hier gibt es keine Brandloecher oder Flecken.");
	   

  AddGenderDetail( ({"wohnzimmer", "frau", "mann"}),
	    "Du denkst an Deinen Ehemann, der jetzt sicher daheim "
	    "im Wohnzimmer am Sofa sitzt und gemuetlich ein Bier trinkt.",
	    "Du denkst an Deine brave Ehefrau, die jetzt gewiss daheim "
	    "leckere Speisen fuer Dich zubereitet.");

  AddDetail( ({"ehefrau","speisen"}),
	    "Du bist Dir ganz sicher, dass Deine Ehefrau die beste ist, die "
	    "es gibt.");

  
  
  AddDetail( ({"sofa"}),
	    "Hier gibt es kein Sofa, hier gibt es nur Stuehle.");

  AddDetail( ({"ehemann"}),
	    "Ja, den vergisst man oft sehr leicht, wenn man die vielen "
	    "huebschen Elfenmaenner in Elessar sieht.");

  AddDetail( ({"elfenmaenner"}),
	    "Grosse, starke und aeusserst attraktive Krieger.");
            

  AddDetail( ({"elessar"}),
	    "Das ist sehr sehr weit weg von hier.");

  AddDetail( ({"geruch","duft"}),
	    "Riech doch mal!");

  AddDetail( ({"tische","tisch"}),
	    "Huebsch sind die kleinen Blumengestecke, die auf jedem der "
            "Tische stehen.");

  AddDetail( ({"blumengesteck","gestecke","blumengestecke","gesteck"}),
	    "Rosen, Tulpen, Narzissen und sonstige Blumen wurden liebevoll "
	    "mit einem blauen Schleifchen zu einem Gesteck gebunden. Holly "
	    "hat sich anscheinend sehr viel Muehe gegeben.");

  AddDetail( ({"muehe"}),
	    "Wenn Du Dir etwas mehr Muehe gibst, kannst Du heute noch "
	    "erhoehen!");

  AddDetail( ({"rosen","tulpen","narzissen","blumen","rose","tulpe","narzisse"}),
	   "Holly pflanzt sie sicher im Garten an.");

  AddDetail( ({"garten"}),
	   "Der Garten ist gewiss nicht hier."); 
         

  AddDetail( ({"schleifchen"}),
	   "Die Gestecke wurden mit einem blauen Schleifchen gebunden.");

  AddDetail( ({"waende","wand","holzwaende","holzwand"}),
	   "Die Holzwaende sind mit Bildern und Kraeuterstraeusschen "
	   "geschmueckt.");  
          

  AddDetail( ({"bilder","bildern","bild"}),
	    "Auf der Wand haengen 13 Bilder. Auf jedem Bild kannst Du eine "
	    "junge, wunderschoene Frau erkennen.");

  AddDetail( ({"frau"}),
	    "Anscheinend hat Holly hier die Bewohnerinnen des Dorfes in ihren "
            "jungen Jahren verewigt.");

  AddDetail( ({"jahren","jahre","jahr"}),
	    "Ja, auch Du wirst nicht juenger.");

  AddDetail( ({"dorf","dorfes","sacciw"}),
	    "Du befindest Dich im Dorf Sacciw.");

  AddDetail( ({"dorfplatz","platz","bewohnerinnen"}),
	    "Wenn Du durch das Fenster guckst, hast Du Ausblick auf den "
	    "gesamten Dorfplatz. Die Bewohnerinnen huschen hektisch "
	    "ueber den Platz.");

  AddDetail( ({"fenster","ausblick"}),
	    "Du siehst von hier den ganzen Dorfplatz.");

  AddDetail( ({"gast","mensch"}),
	    "Du bist hier momentan der einzige Gast, aber so wirst Du "
	    "wenigstens schneller bedient ;).");

  AddDetail( ({"kraeuterstraeusschen","kraeuter"}),
	    "Sie verstroemen einen feinen Duft. Waerst Du ein Kraeuterexperte, "
	    "wuerdest Du wissen, um welche Kraeuter es sich hier handelt.");

  AddDetail( ({"kraeuterexperte"}),
	    "Bist Du einer? ");
            
  AddDetail( ({"theke"}),
	    "Die Theke ist sehr sauber und mit Blumen geschmueckt.");

  AddDetail( ({"kessel","kupferkessel"}),
	    "Ein grosser Kupferkessel, in dem ein seltsames Gebraeu "
	    "vor sich koechelt. Roter Rauch stroemt aus dem Kessel und "
	    "sammelt sich an der Decke.");

  AddDetail( ({"gebraeu","fluessigkeit"}),
	    "Du hoerst wie es blubbert und brodelt, aber mehr kannst "
	    "Du von hier aus nicht erkennen.");
  
  AddDetail( ({"rauch"}),
	    "Blutrot!");
  
  AddDetail( ({"decke"}),
	    "Du kannst die Decke wegen des Rauches nicht erkennen.");
	    
  AddDetail( ({"nase"}),
            "Haaaaaaaaaaaaaaaaaatsschiiiiii. Du musst niesen.");

    
  AddDetail( ({"bier","durch","sacciw","raum","krieger"}),
	   "Geh metzeln, das kannst Du besser!");

    
  AddDetail( ({"kraeuterbuendel","hahnenfuss"}),
	   "Es befindet sich auch Hahnenfuss in dem Kraeuterbuendel.");

    
  AddDetail( ({"kneipe","stuehle","wirtin"}),
	   "Das gehoert zu einer Kneipe.");

    
  AddDetail( ({"wesen"}),
	   "Holly hat ein nettes Wesen.");

    
  AddDetail( ({"blut"}),
	   "Dein Blut wird fliessen!");

  AddDetail( ({"nase","naeschen"}),
	   "Du hast aber eine suesses Naeschen! So eine kleine zarte Nase "
	   "wie Du, haette jeder gerne.");
  
  AddSmell(DEFAULT_SMELL, "Seltsamer Geruch, der aus dem Kessel stroemt, "
                          "umschmeichelt Deine Nase.");  
 
  AddSmell( ({"geruch"}),
	   "Der Geruch ist undefinierbar. Es ist einfach ein Gemisch aus "
	   "Essen und getrockneten Kraeutern.");

  AddSmell( ({"gemisch","essen","kraeutern","geruechen","gerueche"}),
	   "Vor lauter Geruechen ist Deine Nase nicht mehr aufnahmefaehig.");
	 

  AddSmell( ({"duft","kraeuterstraeusschen"}),
	   "Die Kraeuterstraeusschen riechen leicht suesslich.");
  
   
  AddSound(DEFAULT_SOUND, "Holly summt leise vor sich hin, waehrend "
	   "sie unermuedlich in ihrem Kessel ruehrt. Ausserdem kannst "
	   "Du das Blubbern der Fluessigkeit im Kessel hoeren.");

  AddSound( ({"holly","summen"}),
	   "'Eisenkraut und Hahnenfuss, sich mit Blut vermischen muss'.");
  
  AddSound( ({"blubbern","brodeln"}),
	   "Es scheint so, als wuerde das Gebraeu seine eigene Melodie "
	   "vor sich hinblubbern!"); 

  AddSound( ({"melodie"}),
           "Es scheint nur so. Wie soll eine Fluessigkeit bitte eine Melodie "
	   "singen?");

//-----Details Ende-----
//
  AddDrink("Apfelcidre", ({"apfelcidre", "cidre"}),
           70,({30,10,0}), 0, 5,
           ({"Holly laechelt und bringt Dir froehlich summend Dein Cidre.\n",
             "&& geniesst ein koestliches Apfelcidre.\n"}));

  AddDrink("Hexenwein", ({"hexenwein", "wein"}),
            150, 30, 5, 5,
           ({"Holly bringt Dir eine Karaffe koestlichen Hexenweins.\n"
            +"Schluerf!!!! Ist der lecker!!\n",
             "&& geniesst ein Glas Hexenwein und laechelt verzueckt.\n"}));
  
  AddDrink("Drachenblutcocktail", ({"cocktail","drachenblutcocktail"}),
           700,({100,0,0}), 7, 6,
           ({"Holly bringt Dir emsig Dein Getraenk.\n",
             "&& leert das Glas mit einem Zug.\n"}));

  AddDrink("Nachtschatten", ({"nachtschatten", "schatten"}),
            888, 88, 18, 3,
           ({"Holly bringt Dir ein Stamperl Nachtschatten.\n"
            +"ROECHEL!!!! Der war scharf!!\n",
             "&& trinkt ein Stamperl Nachtschatten und roechelt dabei.\n"}));

   
  AddDrink("Liebestrank", ({"trank","liebestrank"}),
           1700, 150, 0, 19,
           ({"Holly zwinkert Dir verfuehrerisch zu, als Du Dein Glas leerst.\n",
             "&& trinkt ein Glas roten Saftes.\n"}));

  AddDrink("Mitternachtsbowle", ({"mitternachtsbowle", "bowle"}),
            350, 40, 7, 4,
           ({"Holly ueberreicht Dir grinsend die Bowle.\n"
            +"WOW!!!! Schmeckt die lecker!!\n",
             "&& trinkt genuesslich eine Tasse Bowle.\n"}));

  AddDrink("Tagesundnachtgleiche", ({"tagesundnachtgleiche"}),
            600,({0,70,0}), 0, 7,
           ({"Holly bringt Dir eine Phiole kostbarster Fluessigkeit.\n"
            +"SCHLUCK!!!! Viel war da nicht drin!!\n",
             "&& trinkt eine Phiole leer.\n"}));

  
// ----------------------------------------------

  
  AddFood("Sabbatkuchen", ({"kuchen", "sabbatkuchen"}), 33, 15, 6,
           ({"Holly bringt Dir laechelnd ein grosses Teller mit Sabbatkuchen. "
            +"\nHmmmm, ist der lecker! Er schmeckt etwas nussig und nach "
            "vielen Dir unbekannten Gewuerzen.\n",
             "&& isst genuesslich einen Teller Sabbatkuchen.\n"}));
 
  AddFood("Schmortopf", ({"schmortopf"}), 700, 100, 29,
           ({"Holly bringt Dir einen kleinen Tontopf mit koestlichem Fleisch!\n"
            +BS("Wow, ist das Fleisch zart. Und die Sauce erst.. Gierig "
                "schlingst Du die ganze Portion mit einigen wenigen Bissen "
                "hinunter und ueberlegst Dir, noch so eine Porion Schmortopf "
                "zu bestellen."),
             "&& schlingt gierig das Essen hinunter.\n"}));

  AddFood("Das letzte Abendmahl", ({"abendmahl", "mahl"}), 350,({0,100,0}), 16,
           ({"Holly serviert Dir Deine Henkersmahlzeit und seufzt. "
            +"\nDir ist etwas mulmig zumute, als Du diese seltsame Speise "
            "etwas zoegernd zu Dir nimmst.\n",
             "&& isst zoegernd die Henkersmahlzeit.\n"}));
 
  AddFood("Kardamomsuppe", ({"suppe", "kardamomsuppe"}), 110,({40,0,0}), 7,
           ({"Holly bringt Dir eine Schale dampfende Suppe. "
            +"\n*DAMPF* sie ist brennend heiss, und Du verbrennst Dir "
            "Deine Zunge. Aber lecker ist sie trotzdem.\n",
             "&& schluerft gierig eine dampfende Schale Suppe.\n"}));

  AddFood("Lichtmesssoufflee", ({"lichtmesssoufflee","soufflee"}), 190, 30, 9,
           ({"Holly bringt Dir einen leuchtenden Teller Soufflee. "
            +"\n*Mjaaaaaaamm* Lecker! Holly scheint eine ausgezeichnete "
            "Koechin zu sein.\n",
             "&& vertilgt schmatzend leuchtendes Lichtmesssoufflee.\n"}));
  
  AddFood("Wintersonnenwendequiche", ({"quiche","wintersonnenwendequiche"}), 1000, 90, 23,
           ({"Holly serviert Dir laechelnd das Gewuenschte. "
            +"\nSchmeckt etwas fad, aber da Du so hungrig bist, isst Du den "
            "ganzen Teller auf.\n",
             "&& isst gelangweilt einen Teller Quiche.\n"}));
  
  AddFood("Sommersonnenwende", ({"sommersonnenwende", "sonnenwende"}), 2000, 130, 20,
           ({"Holly bringt Dir eine Pfanne mit gluehendem Etwas. "
            +"\nObwohl Du nicht definieren kannst was Du eigentlich isst, "
            "laesst Du keinen Happen zurueck.\n",
             "&& isst etwas Komisches.\n"}));

  
  

  
  AddExit("suedosten", ROOM "platz1.lpc");
  AddItem(NPC "wirtin.lpc", REFRESH_DESTRUCT);

  }

 string _query_int_long()
 {
   if (present("hexe"))
   return BS(
	"Du befindest Dich in einer kleinen urigen Kneipe. Sofort faellt "
	"Dir der Geruch auf, den Du schon draussen am Dorfplatz gerochen "
	"hast. Trotzdem fuehlst Du Dich hier sehr wohl. Die Tische sind "
	"liebevoll mit bunten Blumengestecken geschmueckt und auch an den "
        "Waenden entdeckst Du ueberall Bilder und kleine Kraeuterbuendel. "
       	"Trotzdem sitzt hier kein einziger Gast. Das einzige Wesen hier "
        "scheint wohl die kleine Wirtin zu sein, die hinter der Theke "
	"in einem Kessel ein seltsames Gebraeu zubereitet.");
      

   else
   return BS(
	"Du befindest Dich in einer kleinen urigen Kneipe. Sofort faellt "
	"Dir der Geruch auf, den Du schon draussen am Dorfplatz gerochen "
	"hast. Trotzdem fuehlst Du Dich hier sehr wohl. Die Tische sind "
	"liebevoll mit bunten Blumengestecken geschmueckt und auch an den "
        "Waenden entdeckst Du ueberall Bilder und kleine Kraeuterbuendel. "
       	"Trotzdem sitzt hier kein einziger Gast.");
      
}
   
