// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void grundzustand();
int tagebuch_da;
int panfloete_da;

create()
{
	

  ::create();


  SetProp( P_INT_SHORT, "Ein leerstehendes Haus");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier in einem verfallenen, kleinen Steinhaus. "
        "Es scheint schon lange leer zu stehen, denn es ist in einem ziemlich "
        "schlechtem Zustand. Der Putz broeckelt von den Waenden, die Fenster "
        "sind schmutzig und an den Waenden haengen lauter Spinnweben. "
	"Ein schlichtes Bett steht in einer Ecke. Daneben befindet sich "
        "ein kleines Nachttischchen mit einem schmutzigen Kessel darauf. "
	"Weiters erkennst Du noch einen grossen schweren Holzschrank. "
	"Nach Nordwesten kannst Du das Haus wieder verlassen.\n"
	"Ein schimmerndens Energiefeld.");

 
	
      
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Eine dicke Staubschicht befindet sich am Boden. Jemand hat einen "
	    "Pfeil in den Staub gemalt.");

  AddDetail( ({"pfeil"}),
	    "Der Pfeil deutet Richtung Schrank.");
  
  AddDetail( ({"spinnweben","spinnwebe"}),
	    "Lauter schwarze Witwen tummeln sich darin.");
  
  AddDetail( ({"witwen","witwe"}),
	    "Ein Biss von einer dieser Spinnen ist toedlich.");
	    
  AddDetail( ({"biss","spinnen","spinne"}),
	    "Auch Spinnen muessen sich verteidigen.");
  
  AddDetail( ({"putz"}),
	    "Es liegt mehr Putz am Boden als an den Waenden.");
  
  AddDetail( ({"waende","wand"}),
	    "Sie sind schmutzig.");

  AddDetail( ({"decke"}),
	    "Die Decke ist eigentlich nicht sehr interessant. Oder meinst Du "
	    "etwa die Bettdecke?");
  
  AddDetail( ({"bett"}),
	    "Die Decke und die Kissen sind schmutzig und eklig. Irgendetwas "
	    "scheint sich darunter zu verbergen.");
             
  AddDetail( ({"bettdecke","kissen"}),
	     "Irgendwas ist da drunter.");

  AddDetail( ({"haus","haeuschen","raum","ruine"}), 
            "Du befindest Dich hier in einer Ruine.");

  AddDetail( ({"mitte"}),
	    "In der Mitte des Raumes befindet sich der Sarg.");

  AddDetail( ({"decke"}),
	    "Wuahhh noch mehr Spinnen.");

  AddDetail( ({"energiefeld","feld"}),
	    "Das Energiefeld schimmert magisch violett. Wenn Du mutig "
	    "genug bist, kannst Du es ja betreten.");
           
	    

  AddDetail( ({"fenster","fensterscheiben"}),
	    "Schmutzig und alt.");
          

  AddDetail( ({"nachttischchen"}),
	    "Ein schlichtes hoelzernes Nachttischchen mit einem alten "
	    "Kessel darauf. Es hat eine kleine Schublade, die man vielleicht "
	    "noch oeffnen kann, wenn das Holz noch nicht zu sehr verzogen ist.");

  
  AddDetail( ({"kessel"}),
	    "Er ist alt und uninteressant.");

  AddDetail( ({"schublade"}),
	    "Vielleicht kannst Du sie noch oeffnen.");

  AddDetail( ({"ecke"}),
	    "Da steht das alte Bett.");
           
	   
  AddDetail( ({"holzschrank","schrank"}),
	    "Er ist geschlossen. Er hat auch kein Schluesselloch. "
	    "Anscheinend ist er anders zu oeffnen.");
	    

  AddDetail( ({"schluesselloch"}),
	    "Der Schrank hat kein Schluesselloch.");

  AddDetail( ({"staub","staubschicht","zustand"}),
	    "Der Zustand hier laesst zu wuenschen uebrig. Alles ist unter "
	    "einer dicken Staubschicht verborgen.");

  AddDetail( ({"eises","eis"}),
	    "Untersuch doch nicht alle!");

  AddDetail( ({"steinhaus"}),
	    "Du stehst gerade mittendrin.");

  AddDetail( ({"holz"}),
	    "Das Holz ist schon poroes.");

  AddDetail( ({"himmel","hexe"}),
	    "Die Hexe, die hier wohnte, befindet sich im Himmel.");

  AddDetail( ({"irgendetwas","irgendwas"}),
	     "Irgendetwas gibt es hier noch nicht.");
		  
  

 
  
  AddSmell(DEFAULT_SMELL, "Hier riecht es ziemlich modrig und alt. "
                          "Du atmest tief ein und musst niesen.");
			  
 
  	      
 
  
  AddSound(DEFAULT_SOUND,"Es ist hier absolut still.");

   
//-----Details Ende-----
  
 AddExit("nordwesten", ROOM "whexe_15.lpc");

//-----KOMMANDOS--------

// AddCmd( ({ "suche","durchsuche" }), "c_durchsuchen");
// AddCmd( ({ "oeffne" }), "c_oeffnen");
   AddCmd( ({ "betrete" }), "c_betreten");
 
 grundzustand();
}  

void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
    tagebuch_da = 1;
    panfloete_da = 1;
}


int c_durchsuchen(string str)
{
   notify_fail(BS("Was moechtest Du durchsuchen?"));
   if(!(str == "bett"))
   {
     return 0;
   }
   if(present("panfloete", ENV(TP)) || (!panfloete_da))
   {
   write(BS("Du durchsuchst das Bett und findest eine kleine Panfloete. "
	    "Du steckst sie ein und fuehlst, dass sie sehr wichtig fuer Dich "
	    "sein koennte."));
   tell_room(ENV(TP), TPN+" macht irgendwas.\n", ({TP}));
   panfloete_da = 0;
// AddItem(("panfloete"), REFRESH_NONE);
   return 1;
 }
}
int c_oeffnen(string str)
{
   notify_fail(BS("Was moechtest Du hier oeffnen"));
   if(!(str == "schublade"))
   {
     return 0;
   }
   if(present("tagebuch", ENV(TP)) || (!tagebuch_da))
   {
     write(BS("Du oeffnest die Schublade aber sie ist leider leer."));
	    
	      
     return -1;
    }
    else
    {
      write(BS("Du oeffnest die Schublade und findest ein Tagebuch, das "
	       "Du sofort an Dich nimmst."));
      tell_room(ENV(TP), TPN+" pfeift unschuldig.\n", ({TP}));
      tagebuch_da = 0;
//    AddItem(("tagebuch"), REFRESH_NONE);
      return 1;
     }
  }

 int c_betreten(string str)
{
   object *raeume;
   object armreif;
   notify_fail(BS("Was moechtest Du hier betreten?"));
   if(!(str == "energiefeld"))
   {
     return 0;
 }
   {
     write(BS("Du nimmst all Deinen Mut zusammen und betrittst das "
	      "Energiefeld."));
     if (armreif = present("\njadereif", TP))
     armreif->remove();
     raeume = ({
    "/d/wueste/gwenshara/echsendorf/room/ges_4",
    "/d/wueste/protheg/kraterrand/room/hafen",
    "/d/dschungel/feyaria/sumpf/room/sumpf17",
    "/d/dschungel/trintrasil/sdschungel/room/strand1",
    "/d/dschungel/dante/hoehle/room/hoehle6",
    "/d/polar/lamuerte/eishoehle/rooms/19605",
    "/d/polar/rage/ostplatz/room/wachturm",
    "/d/gebirge/angrox/room/ebene4/ebene4_x3y4",
    "/d/gebirge/angrox/4elem/room/wald/wald_k4",
    "/d/gebirge/monimor/room/hoehle4",
    "/d/huegelland/feyaria/weg/room/bau6",
    "/d/ebene/zuni/waldsee/room/room_b5",
    "/d/ebene/lostboy/steppe/room/tunnel3",
    "/d/ebene/ronja/feenquest/room/turm32",
    "/d/wasser/kia/nachtfahrer/room/b3_1",
    "/d/wasser/lupus/mauritius/room/wald00",
    "/d/unterwelt/ronja/sternenwald/room/fr_05_07",
    "/d/unterwelt/basics/central/room/00-20+08",
    "/d/ebene/Midas/room/kneipe_saal" });
    
   TP->move(raeume[random(sizeof(raeume))], M_TPORT);
   
   return 1;
    
 }
}
    
