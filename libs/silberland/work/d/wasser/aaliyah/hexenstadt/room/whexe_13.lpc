// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer kleinen Stadt");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einem kleinen, verlassenen Weg in der "
	"Hexenstadt. Dichtes Buschwerk saeumt den Wegrand, und auch der Boden "
	"ist mit Unkraut ueberwachsen. Anscheinend kuemmert sich hier niemand "
	"um die Stadt und somit verwahrlost alles schoen langsam. Im Osten "
	"kannst Du schon den Dorfplatz erkennen, und im Westen kannst Du ein "
        "kleines Steinhaus betreten.");       
      

	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","weg"}), 
            "Lauter Grasbueschel und sonstiges Unkraut waechst am Weg. "
	    "Vereinzelt liegen auch ein paar Kieselsteine herum, aber "
	    "ansonsten kannst Du nichts besonderes erkennen.");
             

  AddDetail( ({"gras","gruen","grasbueschel"}), 
            "Das Gras waechst in sattem Gruen mitten am Weg.");
            
	 
  AddDetail( ({"unkraut"}),
	    "Hier sollte mal gejaetet werden. Du bist sehr froh das es nicht "
	    "Deine Aufgabe ist, denn jaeten gehoert nicht zu Deinen "
	    "Lieblingsbeschaeftigungen.");

  AddDetail( ({"aufgabe","gedanken","nichts"}),
	    "Du wirst Dir dessen bewusst, keine Aufgabe zu haben. Dir wird "
	    "moerderlangweilig bei dem Gedanken immerzu Nichts zu tun.");
      

  AddDetail( ({"kieselsteine","kieselstein","steine","stein"}),
	    "Lieber waeren Dir ein paar Diamanten.");
	    	  
  
  AddDetail( ({"diamanten","diamant"}),
	    "Tower verkauft sie zu sehr frechen Preisen.");
	 
  AddDetail( ({"tower"}),
	    "Ein sehr frecher Zwerg, der fuer seine Edelsteine richtige "
	    "Wucherpreise verlangt.");
	  

  AddDetail( ({"preise","tower","zwerg","wucherpreise","preisen","preis"}),
	    "Musst Du mit ihm feilschen, dann gibt er sie Dir guenstiger;).");
         

  AddDetail( ({"buschwerk","wegesrand","wegrand"}),
	    "Dichtes Buschwerk wuchert am Wegesrand.");

  AddDetail( ({"tuer","fenster","tueren"}),
	    "Das Haus hat weder Fenster noch Tueren.");
	   
  
  AddDetail( ({"platz","osten","dorfplatz"}),
	    "Im Osten gelangst Du auf den Dorfplatz.");
            

  AddDetail( ({"steinhaus","westen"}),
	    "Aus dem Steinhaus im Westen dringen seltsame Gerueche. "
	    "Es ist von einer blauen Aura umgeben. Seltsamerweise "
	    "hat es weder Fenster noch eine Tuer. Stattdessen befindet "
	    "sich an der Frontseite ein komisches Feld.");

  AddDetail( ({"frontseite","feld"}),
	    "An der Frontseite befindet sich ein seltsames Energiefeld. "
	    "Anscheinend kannst Du das Haus dadurch betreten.");
	  
  AddDetail( ({"energiefeld"}),
	   "Du beruehrst das Feld und schreckst mit Deiner Hand zurueck. "
	   "Es fuehlt sich total kalt an.");

    
  AddDetail( ({"aura"}),
	   "Sie wirkt magisch auf Dich.");

    
  AddDetail( ({"luft","boeses"}),
	   "Etwas Boeses liegt in der Luft.");

    
  AddDetail( ({"haus","stadt"}),
	   "Du haettest lieber in Deinem Haus in der Stadt bleiben sollen "
	   "anstatt hierher zu kommen.");

  AddDetail( ({"anscheinend","dichtes","es","im","manchmal","seltsamerweise"}),
	   "Es ist verwunderlich, was Du alles so untersuchst.");

  AddDetail( ({"stattdessen","vereinzelt"}),
	   "Dir muss sehr sehr langweilig sein, oder?");

  AddDetail( ({"du","dir"}),
	   "Na Du einfach!");

	 

  AddDetail( ({"gerueche"}),
	   "Riech doch mal.");
          

  AddDetail( ({"himmel","violett"}),
	   "Der Himmel ist wolkenlos und strahlt in einem hellem Violett.");
	   

  AddDetail( ({"wolken","wolke"}),
	   "Keine da.");

  AddDetail( ({"hexenstadt"}),
	    "Da bist Du gerade.");
  
  AddDetail( ({"hand"}),
	    "Die fuehlt sich jetzt ganz kalt an.");
 	     
  
  AddSmell(DEFAULT_SMELL, "Es duftet herrlich nach Natur. "
		  "Manchmal jedoch durchzieht eine Brise seltsamen "
		  "Geruches die Luft.");
                        
 
  AddSmell( ({"natur","gras"}),
	   "Es duftet nach sattem gruenen Gras und auch ein bisschen "
	   "nach Blumen.");
  
  AddSmell( ({"blumen","blume"}),
	    "Sehen kannst Du sie nicht, aber duften tun sie herrlich. ");
	  
  AddSmell( ({"brise","geruch"}),
	     "Es riecht hier irgendwie nach.. hm.. Kardamom!");

  AddSmell( ({"kardamom"}),
	     "Der Kardamom duftet sehr wuerzig.");
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst leise das Zirpen von Grillen und "
		  "aus dem Steinhaus dringt ein seltsamer Gesang.");
	   

  AddSound( ({"zirpen","grillen","grille"}),
	   "Die Grillen zirpen wie verrueckt.");
  AddSound( ({"gesang"}),
           "Du lauschst genauer und hoerst es ganz deutlich. "
	   "Du hoerst eine Frau singen in dem Haus im Westen.");
  AddSound( ({"jemand","frau","lieder"}),
	   "Die Frau singt wunderschoene Lieder.");
           
  

//-----Details Ende-----
  
AddExit("westen", "./hex_14.lpc");
AddExit("sueden", "./whexe_15.lpc");
AddExit("osten", "./platz1.lpc");
}  
   
