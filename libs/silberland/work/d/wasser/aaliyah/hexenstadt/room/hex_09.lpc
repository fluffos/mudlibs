// von Aaliyah
// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Blumen");
 
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","wiese","blumenwiese"}), 
            "Der Boden ist uebersaeht von lauter bunten Blumen. "
	    "Komischerweise wachsen hier Blumen aus allen 4 Jahreszeiten. "
	    "Du siehst Krokusse, Maigloeckchen, Pfingstrosen, Schneegloeckchen "
	    "und noch jede Menge anderer Blumen.");
             

  AddDetail( ({"blumen","krokusse","maigloeckchen","pfingstrosen","blume",
			  "krokus","pfingstrose"}), 
            "Wie gern wuerdest Du ein paar Blumen pfluecken, "
            "laesst es aber lieber bleiben, um die Hausherrin nicht "
	    "zu veraergern.");

  AddDetail( ({"jahreszeiten","Fruehling","Sommer","Herbst","jahreszeit"}),
	    "Fruehling, Sommer, Herbst und Tod.");
      

  AddDetail( ({"hausherrin"}),
	    "Voellig apathisch sitzt sie da und flechtet Blumenkraenze. "
	    "Richte doch mal Dein Kerbholz drauf, eine Kerbe ist sowieso "
	    "mehr wert als ein paar Bluemchen.");
  
  AddDetail( ({"Tod"}),
	    "Boese Zungen behaupten, dass neugierige Leute hier schnell "
	    "auf dem Scheiterhaufen verbrannt werden.");

  AddDetail( ({"leute","insel"}),
	    "Sehr wenige Leute haben die Insel lebend wieder verlassen. "
	    "Ihre Schreie hallten weit ueber das Meer, bis sie endlich "
	    "verstummten und hoffentlich ihren Frieden am Friedhof fanden.");

  AddDetail( ({"schreie"}),
	    "Verhalte Dich ruhig, denn wenn das Boese erwacht, gibt es kein "
            "Entrinnen.");

  AddDetail( ({"friedhof","berge","bergen","berg"}),
	    "Weit hinter den Bergen soll es einen Friedhof geben.");

  AddDetail( ({"wand","waende","bluetenpracht"}),
	    "Lauter bunte Blumen wachsen an den Waenden.");
	   
  
  AddDetail( ({"boese","entrinnen"}),
	    "Das Boese lauert Dir auf, es wird Dich finden und dann "
            "gibt es kein Entrinnen mehr.");

  AddDetail( ({"blumenkranz","blumenkraenze"}),
	    "Wie gerne wuerdest Du Acaciah um einen ihrer schoenen "
	    "Blumenkraenze bitten, aber leider scheint sie Dich nicht "
	    "wahrzunehmen.");

  AddDetail( ({"decke","blick"}),
	    "Du laesst Deinen Blick zur Decke schweifen und erschrickst "
	    "fuerchterlich. Die ganze Decke wird von einer riesigen,"
	    "fleischfressenden Pflanze eingenommen. Pass auf, dass Du nicht "
	    "zu ihrem Snack wirst.");

  AddDetail( ({"pflanze","snack"}),
	   "Sie scheint hungrig zu sein, also sei lieber vorsichtig.");
	 

  AddDetail( ({"rosen","orchideen","schneegloeckchen","bluemchen","rose",
			  "orchidee"}),
	   "Sie duften herrlich.");
          

  AddDetail( ({"meer"}),
	   "Da gibt es eventuell eine Fluchtmoeglichkeit.");

  AddDetail( ({"fluchtmoeglichkeit"}),
	   "Flieh, solange Du noch kannst.");

  AddDetail( ({"kerbholz","kerben","kerbe"}),
	    "Wenn Du soviel forschst, findest Du vielleicht eine versteckte "
	    "Kerbe.");

  AddDetail( ({"duft"}),
	    "Du untersuchst das Detail 'Duft' und kommst zu dem Entschluss, "
	    "dass es doch besser waere Duft zu riechen.");
            

  AddDetail( ({"entschluss"}),
	    "Entschliess Dich mal. ");

  AddDetail( ({"detail"}),
	    "[Tod:Lars] Eine boese Skriptfalle hat gerade einen Skripter "
	    "umgebracht.");

  AddDetail( ({"skriptfalle"}),
	    "Vielleicht tappst Du ja mal in eine.");

  AddDetail( ({"skripter"}),
	    "Bist Du Einer?.");

  AddDetail( ({"frieden"}),
	    "Frieden ist was sehr schoenes, nur leider hier selten zu finden.");

  AddDetail( ({"zungen","zunge"}),
	    "Zwei sind immer besser als eine.");

  AddDetail( ({"herrin","acaciah","haus"}),
	    "In diesem Haus ist Acaciah die Herrin.");

  AddDetail( ({"himmel","menge","scheiterhaufen","seelen"}),
	    "Jede Menge Seelen jener, die am Scheiterhaufen verbrannten, "
	    "fanden im Himmel ihren Frieden.");
  
  
  
  

 	     
  
  AddSmell(DEFAULT_SMELL, "Lieblich duften die Blumen hier.");
                        
 
  AddSmell( ({"Duft","blumen"}),
	   "Es duftet einfach himmlisch.");

  AddSmell( ({"rosen","rose","duft"}),
	   "Du riechst an den Rosen und atmest tief ihren Duft ein. Sie "
	   "duften herrlich. So wunderbar duftende Rosen hast Du vorher noch "
	   "nie gesehen.");

  AddSmell( ({"orchidee","orchideen"}),
	   "Blumig herrlich.");
	  
 
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst hier einfach Nichts.");
	   

  AddSound( ({"nichts"}),
	   "Null, niente, nada.");
           
  

//-----Details Ende-----
  
AddExit("sueden", "./platz2.lpc");
AddItem(NPC "acaciah.lpc", REFRESH_DESTRUCT);
}  
    string _query_int_long()
 {
   if (present("hexe"))
   return BS(
	"Vorsichtig betrittst Du das kleine Haus. Es ist, als haettest Du "
        "eine Blumenwiese betreten. Lauter bunte Blumen wachsen am Boden und "
        "an den Waenden. Es duftet herrlich nach Rosen und Orchideen. "
        "Inmitten dieser ganzen Bluetenpracht sitzt Acaciah, die Herrin dieses "
	"Hauses und flechtet apathisch einen Blumenkranz. Es ist besser, Du "
	"stoerst sie nicht und verlaesst das Haus wieder im Sueden.");
	

   else
   return BS(
	"Vorsichtig betrittst Du das kleine Haus. Es ist als haettest Du "
        "eine Blumenwiese betreten. Lauter bunte Blumen wachsen am Boden und "
        "an den Waenden. Es duftet herrlich nach Rosen und Orchideen. "
        "Inmitten dieser ganzen Bluetenpracht sitzt normalerweise Acaciah, die "
	"Herrin dieses Hauses und flechtet apathisch einen Blumenkranz. Doch "
	"jetzt scheint sie nicht da zu sein.");
	
  
}
   
