// Raum meines Gesellenstueckes "Hexenstadt"

inherit "std/room";
#include "../def.h"



void grundzustand();
int gluehwuermchen_da;
void init()
{
  ::init();
  if (TP && !TP->QueryProp(P_BLIND))
    TP->SetProp(P_BLIND, 2);
}

create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus des Lichtes");
  SetProp( P_INT_LONG,
	"Du stehst in einem sehr hellen Raum. Die Waende leuchten in einem "
        "gleissend grellem Licht. Lauter kleine Gluehwuermchen fliegen durch "
        "das Haus und tanzen um die vielen Kerzen, die hier ueberall hell "
        "flackern. Der Fussboden gleicht einer riesigen Flamme, die jedoch "
	"in keinster Weise heiss ist. Als Du Dich genauer umsiehst, erkennst "
	"Du verwundert, dass ein hell leuchtender Ball mitten im Raum schwebt. "
	"Weiters befindet sich in der Mitte des Raumes ein kleiner Kessel. "
	"Um den Kessel sind viele leuchtende Edelsteine in der Form eines "
	"Pentagramms angeordnet. Du kannst das Haus im Norden wieder verlassen.");
	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 4 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","fussboden"}), 
            "Du stehst inmitten einer gigantischen Flamme. Waere sie heiss, "
	    "wuerdest Du wohl in ein paar Sekunden hier verbrennen.");
  
  AddDetail( ({"sekunden","sekunde"}),
	    "Lang wuerde es nicht brauchen, um Deinen Koerper einzuaeschern.");

  AddDetail( ({"koerper","huelle"}),
	    "Dein Koerper ist nur eine Huelle, die Du hier ganz gewiss "
	    "verlieren wirst.");
             

  AddDetail( ({"flamme"}), 
            "Sie lodert und flackert in gleissendem Licht.");
    

  AddDetail( ({"licht","raum"}),
	    "Das helle Licht blendet Dich.");
      

  AddDetail( ({"ball"}),
	    "Dieser Ball ist eine kleine Sonne.");
	  
  AddDetail( ({"sonne"}),
	    "Du denkst. o O (Wieso ist hier eine Sonne?).");
	 
  AddDetail( ({"haus"}),
	    "Hier lebt Shine. Pass nur auf, dass Du sie nicht stoerst.");

  AddDetail( ({"mitte"}),
	    "Dort befindet sich ein Kessel.");
         
  AddDetail( ({"kessel"}),
	    "Man munkelt, dass hier das Licht geschaffen wird.");

  AddDetail( ({"weise"}),
	    "Die Flamme ist in keinster Weise heiss.");
	   
  
  AddDetail( ({"edelsteine","edelstein"}),
	    "Sie leuchten und sind in der Form eines Pentagramms angeordnet.");
   
  AddDetail( ({"form"}),
	    "Na wie ein Pentagramm.");	

  AddDetail( ({"klaenge","klang"}),
	     "Lauschen.");

  AddDetail( ({"wieso","lebens","O","einzige","hinsehen","details","leben"}),
	     "Wieso bitte untersuchst Du solche komischen Details?");

  AddDetail( ({"shine","shines","sprache","du"}),
	     "Shines Sprache verstehst Du sehr schlecht.");

	

  AddDetail( ({"waende"}),
	    "Die Waende leuchten.");
	    
	    
  AddDetail( ({"pentagramm"}),
	   "Damit beschwoert die Hexe die hohen Maechte.");
	 

  AddDetail( ({"maechte"}),
	   "Die hohen Maechte verstaerken ihre Zauber.");

  AddDetail( ({"hexe"}),
	   "Das ist Shine. Man sagt ihr nach, dass ihr Charme toeten kann.");

  AddDetail( ({"charme"}),
	   "Wenn Du Dich traust, kannst Du ja einmal mit ihr flirten.");

  AddDetail( ({"zauber"}),
	   "Ihre Zauber sind aeusserst geheim.");


  AddDetail( ({"decke"}),
	    "Du laesst Deinen Blick zur Decke hinauf schweifen und bemerkst "
	    "eine kleine Wolke.");

  AddDetail( ({"blick"}),
	    "Hast Du einen Blick fuer die wirklich wichtigen Dinge des "
	    "Lebens?");
  
  AddDetail( ({"koreander"}),
	     "Riechen.");
	           

  AddDetail( ({"dinge"}),
	    "Meistens kann man sie anfassen.");
	 

  AddSpecialDetail( ({"leben","lebens"}),
	    "Shine wird Dir nach dem Leben trachten.");
	
  AddDetail( ({"wolke","hinsehen","rauches"}),
	    "Beim genaueren Hinsehen erkennst Du, dass es eigentlich ein "
	    "Kokon ist.");

  AddDetail( ({"kokon"}),
	    "Vielleicht kannst Du ihn ja entzwei brechen?");

  AddDetail( ({"erfahrungspunkte","erfahrungspunkt"}),
	    "Du wirst genug davon hier verlieren. Und auch viele Rauten.");

  AddDetail( ({"rauten","raute"}),
	    "Och, zittert Dein kleines Forscherherz schon?");

  AddDetail( ({"forscherherz"}),
	    "Ein einsamer Forscher hat hier nichts verloren, ausser danach "
	    "dann jede menge Rauten. Muahahaha");
  
  AddDetail( ({"wand","einzige","kerzen","gluehwuermchen"}),
	     "Das Einzige, was Du an der Wand erkennen kannst, sind lauter "
	     "Gluehwuermchen und ein paar Kerzen.");


  AddDetail( ({"forscher"}),
	    "Die Hexen freuen sich schon ueber Deine Leiche.");

  
  AddRoomMessage( ({"Sanfte Klaenge ertoenen im Raum.\n",
	          "Das grelle Licht blendet Dich etwas.\n"}), 5);
 	     
  
  AddSmell(DEFAULT_SMELL, "Das Einzige, was Du hier riechen kannst, ist "
	    "der seltsame Geruch des Rauches, welcher aus dem Kessel stroemt.");
                        
 
  AddSmell( ({"geruch"}),
	   "Es riecht hier irgendwie nach Zitronenmelisse.");

  AddSmell( ({"zitronenmelisse"}),
	   "Oder ists doch der Geruch von Kardamom?");

  AddSmell( ({"kardamom"}),
	    "Du wirst doch wissen, dass Kardamom Koreander ist.");
 
 
  
  AddSound(DEFAULT_SOUND, "Du lauschst Shines wunderschoenem Gesang.");	
	   

  AddSound( ({"gesang"}),
	   "Shine singt schoene Lieder in einer Dir unbekannten Sprache.");

  AddSound( ({"lieder"}),
	   "Ud tsriw nebrets masgnal, rettib, dnu llovlauq nebrets, neid "
	   "hcsielf driw reih nesewerv, neid tsieg driw reih nesuah ni "
	   "tiekgiwe.");  
  

//-----Details Ende-----
  
AddExit("norden", ROOM "hex_22.lpc");
AddItem(NPC "shine", REFRESH_DESTRUCT);
//-----KOMMANDOS--------

 AddCmd( ({ "brich", "breche" }), "c_brechen");
 AddCmd( ({ "flirte", "flirt" }), "c_flirten");
 
 grundzustand();
}

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	gluehwuermchen_da = 1;
}


int c_brechen(string str)
{
   notify_fail(BS("Was moechtest Du hier denn entzwei brechen?"));
   if(!(str == "kokon entzwei"))
   {
     return 0;
   }
   if(present("gluehwuermchen", TP) || (!gluehwuermchen_da))
   {
     write(BS("Der Kokon ist steinhart. So sehr Du Dich auch bemuehst, Du "
	      "schaffst es einfach nicht, ihn zu knacken. Ein bisschen mehr "
	      "Kraft wuerde Dir nicht schaden."));

     return -1;
    }
    else
    {
      write(BS("Du nimmst den Kokon in Deine Haende und zerbrichst ihn mit "
	       "roher Gewalt. Ploetzlich hast Du ein Gluehwuermchen in der "
	       "Hand, das Dir sicher eine Weile Licht spenden wird."));
      tell_room(ENV(TP), TPN+" zerstoert etwas.\n", ({TP}));
      gluehwuermchen_da = 0;
      CLONE(OBJ "wuermchen.lpc", TP);
      return 1;
     }
    }

   int c_flirten(string str)
{
   notify_fail(BS("Mit wem moechtest Du flirten?"));
   if(!(str == "mit shine"))
   {
     return 0;
   }
   if(!present("shine"))
   {
   write("Wie willst Du mit Shine flirten, wenn sie gar nicht da ist?\n");
   return -1;
   }
  if(TP->QueryProp(P_FROG))
  {
  write("Als Frosch flirten? Das geht nur mit einer Prinzessin.\n");
  return 1;
  }

  if(TP->QueryProp(P_BLIND))
  {
    write("Als Blinder kannst Du nicht mit Shine flirten.\n");
    return -1;
  }
  if(TP->QueryProp(P_GHOST))
  {
    write("Shine flirtet nicht mit Geistern.\n");
    return -1;
  }
  if(TP->InFight())
  {
    write("Im Kampf flirtet Shine gewiss nicht mit Dir.\n");
    return -1;
  }
   
   
   write(BS("Da Shines Ausstrahlung so enorm auf Dich wirkt, kannst Du ihr "
	    "nicht widerstehen. Du blickst ihr in ihre gleissenden Augen "
	    "und kannst Dich nicht mehr davon abwenden."));
	  	  
   tell_room(ENV(TP), TPN+" beginnt gerade Selbstmord.\n", ({TP}));
   SetProp(P_KILL_NAME, "bisschen zuviel Charme der Lichthexe");
   TP->SetProp(P_TMP_PRAY_ROOM, ROOM "hex_31.lpc");
   TP->SetProp(P_GHOST,1);
   tell_room(ENV(TP), TPN+" hat anscheinend zuviele Xps.\n", ({TP}));
   WLOG(LOG "skripttod", "flirtet mit Shine");
   if(TP->QueryProp(P_GENDER) == FEMALE)
    SetProp (P_ENEMY_DEATH_SEQUENCE, OBJ "frau.seq");
   else
   SetProp (P_ENEMY_DEATH_SEQUENCE, OBJ "man.seq");
   TP->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW);
   TP->SetProp(P_KILLER, 0);

   return 1;

}


