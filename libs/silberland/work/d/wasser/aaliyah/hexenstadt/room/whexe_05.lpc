// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Der letzte Weg");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einem kleinen einsamen Weg. "
	"Im Osten kannst Du ein Steinhaus betreten, waehrend Du "
	"nach Sueden wieder in die Stadt gelangst. Der Boden ist "
	"uebersaeht mit Leichenteilen und Knochen. Die Himbeerstraeucher "
        "am Wegrand scheinen hier auch etwas weniger zu werden. "
        "Lauter grosse blutrote Tropfen regnen vom Himmel.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","weg"}), 
            "Der Boden ist uebersaeht mit stinkenden, verwesten Leichenteilen. "
	    "Vereinzelt liegen auch ein paar abgenagte Knochen dazwischen. "
	    "Dich schauderts.");
             

  AddDetail( ({"leichenteile","knochen","leichenteilen"}), 
            "Urks, so genau moechtest Du sie Dir nicht ansehen.");
            
	 
  AddDetail( ({"Himbeerstraeucher","straeucher","himbeeren","strauch"}),
	    "Einige verfaulte Himbeeren haengen trostlos an den Straeuchern.");
      

  AddDetail( ("wegrand"),
	    "Ein paar karge Himbeerstraeucher wachsen da.");
	    	  
  
  AddDetail( ({"himmel"}),
	    "Der Himmel scheint Blut zu weinen.");
	 
  AddDetail( ({"tropfen"}),
	    "Lauter grosse blutrote Tropfen regnen vom Himmel.");
	     

  AddDetail( ({"blut"}),
	    "Iiiiiehhhhh, es regnet wirklich Blut.");
         

  AddDetail( ({"stadt"}),
	    "Du bist hier irgendwo am Ende von ihr.");

  AddDetail( ({"ende"}),
	    "Es ist Dein Ende.");
	   
  
  AddDetail( ({"osten","steinhaus"}),
	    "Im Osten befindet sich ein Steinhaus.");
        
  AddDetail( ({"schritten","schritte"}),
	    "Die Leichenteile knirschen unter Deinen Schritten.");

  
  AddSmell(DEFAULT_SMELL, "Der Gestank der Leichen liegt hier in der "
		  "Luft.");
                        
 
  AddSmell( ({"leichen","gestank","leiche"}),
	   "Die Leichen stinken bestialisch.");

  AddSmell( ({"luft"}),
            "Hier herrscht dicke Luft.");
 
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst leise das Knirschen der Knochen "
		  "unter Deinen Schritten und ausserdem noch leisen Gesang.");
	   

  AddSound( ({"knirschen","knochen"}),
	   "Die Knochen knirschen unter Deinen Schritten.");

  AddSound( ({"gesang"}),
           "Eine Frau scheint im Steinhaus im Osten zu singen.");

  AddSound( ({"frau"}),
	   "Die Frau singt wunderschoen.");

  AddSound( ({"schritte","schritt"}),
	   "Deine Schritte knirschen wenn Du ueber den Boden gehst. Irgendwie "
	   "wird Dir ganz schoen unheimlich dabei.");
           
  

//-----Details Ende-----
  
AddExit("norden",  "./whexe_28.lpc");
AddExit("sueden", "./whexe_27.lpc");
AddExit("osten", "./hex_07.lpc");
}  
   
