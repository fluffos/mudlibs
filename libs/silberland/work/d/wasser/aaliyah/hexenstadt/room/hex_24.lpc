// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>

void grundzustand();

int ratte_da;

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Jagd");
  SetProp( P_INT_LONG,
	"Vorsichtig betrittst Du das kleine Steinhaus. Sofort fallen "
        "Dir die seltsamen Waffen auf, die hier ueberall an den Waenden "
        "haengen. Ausserdem erkennst Du in der Mitte des Raumes einen "
        "Verkaufstresen. Hinter dem Tresen befinden sich zwei grosse Regale "
	"gefuellt mit allerlei Kram. An der Nord- und Suedwand befindet sich "
        "jeweils ein grosser massiver Eisenschrank. Einige Kerzen erhellen "
	"den fensterlosen Raum. Du kannst das Haus im Westen wieder verlassen "
	"und zum Wald zurueckkehren.");
	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Als Du Dir den Boden angucken willst, bemerkst Du eine tiefe"
	    "Furche. Etwas scheint sich darin zu bewegen.");
	  
	             

  AddDetail( ({"furche","etwas"}), 
            "Etwas bewegt sich in der Furche.");
    

  AddDetail( ({"decke","stein"}),
	    "Die Decke besteht aus kahlem Stein.");
      

  AddDetail( ({"waende"}),
	    "Ueberall an den Waenden haengen Waffen.");
	  
  AddDetail( ({"waffen","waffe"}),
	    "Die Waffen sind Sonderanfertigungen.");
	 
  AddDetail( ({"haus","steinhaus","hexe","artemisia","raum","raumes"}),
	    "Hier lebt Artemisia. Toete sie, bevor sie Dich toetet.");

  AddDetail( ({"sonderanfertigungen","sonderanfertigung"}),
	    "Vielleicht brauchst Du auch einmal so eine Waffe.");
         
  AddDetail( ({"kessel"}),
	    "Etwas verbranntes Raeucherwerk befindet sich darin.");

  AddDetail( ({"raeucherwerk"}),
	    "Es riecht irgendwie verbrannt.");
	   
  
  AddDetail( ({"eisenschrank","schrank","schraenke"}),
	    "Die bekommst Du sicherlich nicht auf.");
   
  AddDetail( ({"tresen","verkaufstresen"}),
	    "Am Tresen befindet sich ein Kessel und ein Notizblock. "
	    "Seltsamerweise siehst Du keine Kassa.");
	  
  AddDetail( ({"kassa","kasse"}),
	    "Es gibt hier keine Kasse. Die Bewohner rechnen wohl anders ab.");
	    
	    
  AddDetail( ({"bewohner"}),
	   "Hier wohnen fast nur Hexen.");
	 

  AddDetail( ({"notizblock","geschreibsel"}),
	   "Du kannst das Geschreibsel von Artemisia nicht entziffern.");
	 
	          

  AddDetail( ({"nordwand","suedwand","wand"}),
	   "Da stehen zwei Schraenke.");

  AddDetail( ({"regale","regal"}),
	   "Hier bewahrt die Hexe ihre Sachen fuer die Herstellung von Waffen "
	   "auf.");

  AddDetail( ({"sachen","kram","dinge","sache","ding"}),
	    "Lauter Dinge zum Herstellen von Waffen.");
	   
  AddDetail( ({"herstellung","herstellen"}),
	    "Na irgendwo muessen die Waffen ja gemacht werden.");
	           

  AddDetail( ({"kerzen","kerze"}),
	    "Die Kerzen flackern in einem violettem Licht.");
	
  AddDetail( ({"hexen"}),
	    "Sie sind alle boese und lechzen nach Deinem Blut.");
	
  AddDetail( ({"blut","mitte"}),
	    "Massen von Deinem Blut werden ueber den Boden stroemen.");

  AddDetail( ({"massen"}),
	    "Vielleicht trinken sie Dein Blut auch. Wer weiss das schon?");

  AddDetail( ({"licht"}),
	    "Die Kerzen erhellen den Raum etwas.");

  AddDetail( ({"wald"}),
	    "Der befindet sich im Westen.");

  AddDetail( ({"unwuerdiger"}),
	     "Du bist nicht wuerdig.");


 
 	     
  
  AddSmell(DEFAULT_SMELL, "Hier riecht es nach Schiesspulver.");
	                          
 
  AddSmell( ({"schiesspulver"}),
	   "Ja so riecht es hier.");

  
  AddSound(DEFAULT_SOUND, "Du lauschst und lauschst und hoerst 'Nichts'.");	
	   

  AddSound( ({"nichts"}),
	   "Nichts schreit: Stirb Du Unwuerdiger!");

 
//-----Details Ende-----
  
AddExit("westen", ROOM "hex_23.lpc");
AddItem(NPC "artemisia.lpc", REFRESH_DESTRUCT);
//-----KOMMANDOS--------
 AddCmd( ({ "greife", "greif" }), "c_hineingreifen");


 grundzustand();
}

reset()

{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	ratte_da = 1;
}


int c_hineingreifen(string str)
{
   notify_fail(BS("Worein moechtest Du greifen?"));
   if(!(str == "furche" || "in furche"))
   {
     return 0;
   }
   if(present("ratte", ENV(TP)) || (!ratte_da))
   {
     write(BS("Du greifst in die Furche, aber scheinst Dich getaeuscht zu"
	      "haben."));
	   

     return -1;
    }
    else
    {
      write(BS("Du greifst in die Furche. Ploetzlich springt Dich eine Ratte"
	       "an und attackiert Dich."));
      tell_room(ENV(TP), TPN+" stoebert herum.\n", ({TP}));
      ratte_da = 0;
      CLONEME("/d/ebene/lamuerte/burg/npc/ratte");
      return 1;
     }
    }
