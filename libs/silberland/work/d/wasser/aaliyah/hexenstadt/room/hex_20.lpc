// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void grundzustand();
int wasserprinz_da;

create()
{
	

  ::create();


  SetProp( P_INT_SHORT, "Im Haus des Meeres");
  	
      
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"weiten","ozean","meer","meeres"}), 
            "Du befindest Dich mitten im Ozean. So weit das Auge reicht "
	    "Wasser, Wasser und nochmal Wasser. Du kannst ausser der "
	    "Insel kein einziges Stueckchen Land erkennen.");
           

  AddDetail( ({"waende","wand"}), 
            "Hast Du schon mal mitten im Meer Waende gesehen?");
   
  AddDetail( ({"hexe","hueterin","herrscherin"}),
	    "Calluna ist die Herrscherin des Wassers und huetet sorgfaeltig "
	    "das Meer und all seine Lebewesen.");            

  AddDetail( ({"lebewesen"}),
	    "Viele Fische in allen Formen und Farben tummeln sich unter Dir "
	    "im Wasser.");
	   
  AddDetail( ({"wasser","fluten"}),
	    "Wenn Du nach unten schaust, erkennst Du viele kleine bunte "
	    "Fische, die froehlich durch die Fluten tummeln.");
	    

  AddDetail( ({"fische","farben","fisch"}),
	    "Die Fische schillern in allen moeglichen Farben.");

  AddDetail( ({"formen","form"}),
	    "Es gibt grosse Fische, kleine Fische und riesige Fische.");
            
  AddDetail( ({"walflosse","wale","kolosse","giganten"}),
	    "Im Meer leben auch Wale. Ab und zu siehst Du den Schwanz "
	    "dieser Kolosse vom Wasser hochschnellen. Ein bisschen unwohl "
	    "fuehlst Du Dich schon, in der Naehe dieser Giganten.");
 

  AddDetail( ({"seetang","eisblau"}),
	    "Der Seetang schillert in einem merkwuerdigen Eisblau.");
	 
  AddDetail( ({"szenerie"}),
	    "Die ist hier mehr als traurig. Eine kleine Traene rinnt "
            "Dir ueber die Wange. Verstohlen wischst Du sie wieder weg.");

  AddDetail( ({"schwanz","schwanzflosse"}),
	    "Nein, es ist eine Schwanzflosse, ums genau zu nehmen.");
	    

  AddDetail( ({"naehe"}),
	    "Die Wale schwimmen nicht weit von Dir entfernt.");
	    
  AddDetail( ({"meter","fuesse","gefuehl","flosse"}),
	   "Hast Du Dir hier einen Forscherpunkt erwartet?");
	  

  AddDetail( ({"forscherpunkt"}),
	   "Der Forscherpunkt kreischt: Such mich, fang mich, halt mich fest!");  
 
  AddDetail( ({"insel"}),
	   "Die Insel ist nicht groesser als 2 Meter. Sie ist fast voellig "
	   "mit Perlen und Muscheln bedeckt. Etwas Seetang befindet sich auch "            "noch darauf.");

  AddDetail( ({"raum","raumes","haus"}),
	   "Du befindest Dich hier im Haus des Meeres."); 
         
  AddDetail( ({"muscheln","perlmuttfarben"}),
	    "Die Muscheln schillern in allen moeglichen Perlmuttfarben. "
	    "Eine Muschel sieht jedoch anders aus.");
	 	   

  AddDetail( ({"muschel"}),
	    "Als Du die Muschel nehmen willst, bemerkst Du, dass die Insel "
	    "etwas Seltsames auf sich hat.");
            

  AddDetail( ({"seltsames"}),
	    "Du erkennst, dass die Insel eigentlich keine richtige Insel ist. "
	    "Vielmehr ist es eine einzige grosse Venusmuschel, auf der die "
	    "Hexe sitzt.");

  AddDetail( ({"venusmuschel"}),
	    "Was sich wohl darin befindet? Das wirst Du jedoch nur dann "
	    "wissen, wenn Du vorher Calluna toetest.");

  AddDetail( ({"perlen","perle"}),
	    "Es sind die edelsten Perlen, die das Meer hergibt.");

  AddDetail( ({"auge"}),
	    "Pass nur auf, dass Dir Calluna mit ihrer Flosse keins aufs Auge "
	    "verpasst.");

  AddDetail( ({"land","stueckchen","mitte"}),
	    "Die Insel ist das einzige Stueckchen Land hier.");

  AddDetail( ({"mann"}),
	     "So einfach ist es nicht. Du musst ihn suchen.");

  AddDetail( ({"salz","luft","seetang","fisch"}),
	     "Riechen!");

  AddDetail( ({"wellen","maennerstimme","stimme"}),		  
	     "Lauschen!");

  AddDetail( ({"boden"}),
	     "Unter Dir befindet sich nur Wasser. Du kannst den Meeresgrund "
	     "kaum erkennen.");

  AddDetail( ({"meeresgrund","grund"}),
	     "Ein paar schoene Korallen glitzern am Grund.");

  AddDetail( ({"korallen","koralle"}),
	     "Die haettest Du jetzt gerne.");

  AddDetail( ({"sonne","horizont","roete","himmel"}),
	     "Die Sonne verschwindet langsam am Horizont und taucht den "
	     "Himmel in eine wunderschoene Roete.");
 
  AddDetail( ({"ferne","moewen","du"}),
	     "In der Ferne hoerst Du ein paar Moewen kreischen.");

  AddDetail( ({"calluna","callunas","meerjungfrau"}),
	     "Calluna ist eine wunderschoene Meerjungfrau.");

  AddDetail( ({"brise","meersalz","uebelkeit"}),
	     "Das Meersalz wirkt sicher gut gegen Uebelkeit.");





  AddRoomMessage( ({"Die Wellen rauschen leise vor sich hin.\n",
	          "Ein paar Moewen kreischen in weiter Ferne.\n",
		  "Eine Walflosse schnellt neben Dir vom Wasser hoch.\n",
		  "Ein paar sanfte Wellen kraeuseln sich um Deine Fuesse.\n",
		  "Du riechst eine leichte Brise Meersalz.\n",
		  "Die Sonne verschwindet langsam am Horizont.\n",
		  "Der Raum taucht sich langsam in eine sanfte Roete.\n"}), 80);
  
  AddSmell(DEFAULT_SMELL, "Die Luft ist hier wunderbar klar und riecht nach "
                          "Salz und Seetang.");  
 
  AddSmell( ({"salz","luft"}),
	   "Die ganze Luft riecht salzig.");
	  

  AddSmell( ({"seetang"}),
	   "Der Seetang riecht irgendwie stark nach Fisch.");
  
  AddSmell( ({"fisch"}),
	   "Du findest, dass Fische eklig riechen. Je laenger Du riechst, "
	   "desto mehr ueberkommt Dich das Gefuehl der Uebelkeit.");

   
 
  
  AddSound(DEFAULT_SOUND,"Du hoerst das Meer rauschen und die Wellen schlagen. "
	   "Ausserdem scheinst Du ein leises Singen wahrzunehmen.");

  AddSound( ({"wellen","schlagen"}),
	   "Die Wellen schlagen.");
	           
  
  AddSound( ({"meer","rauschen"}),
	   "Das Meer rauscht.");
	   
  AddSound( ({"singen"}),
            "Das Singen hoert sich wie eine Maennerstimme an.");
	    
  AddSound( ({"maennerstimme"}),
	    "Irgendwo hier scheint ein Mann versteckt zu sein.");

//-----Details Ende-----
  
 AddExit("westen", ROOM "hex_19.lpc");
 AddItem(NPC "calluna.lpc", REFRESH_DESTRUCT);
//-----KOMMANDOS--------

 AddCmd( ({ "oeffne" }), "c_oeffnen");
 
 grundzustand();
}  

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	wasserprinz_da = 1;
}


int c_oeffnen(string str)
{
   notify_fail(BS("Was moechtest Du hier denn oeffnen?"));
   if(!(str == "muschel"))
   {
     return 0;
   }
   if(present("hexe")) 
   {	   
   write("Die Hexe sitzt auf der Muschel.\n");
    return -1;
   }
   
   if(present("wasserprinz", ENV(TP)) || (wasserprinz_da==0))
   {
     write(BS("Du oeffnest die Muschel und stellst zu Deinem Bedauern fest, "
	      "dass sie leer ist. Kein versteckter Schatz, rein gar nichts. "
	      "Irgendwie sieht es so aus, als wuerde hier jemand leben."));
     return 1;
    }
    else
    {
      write(BS("Du oeffnest die Muschel und trittst erschrocken ein paar "
	       "Schritte zurueck. Vor Dir in der Muschel liegt auf Perlen "
	       "gebettet, ein wunderschoener Prinz. Du kannst Deine Augen "
	       "kaum abwenden, so geblendet bist Du von seiner Schoenheit."));
      tell_room(ENV(TP), TPN+" oeffnet die Muschel.\n", ({TP}));
      wasserprinz_da = 0;
      CLONEME(NPC "wasserprinz.lpc");
      return 1;
    }
}
string _query_int_long()
 {
   if (present("hexe"))
   return BS(
   	"Du betrittst Callunas Haus des Meeres. Vor Dir siehst Du die Weiten "
        "des Ozeans. Hier gibt es weder Waende noch einen Boden. Du stehst "
        "stattdessen mitten im Meer. Komischerweise kannst Du einfach "
	"so ueber das Wasser gehen. Manchmal schnellt eine Walflosse "
	"vom Wasser hoch und spritzt Dich etwas nass. Als Du Dich genauer "
        "umsiehst, bemerkst Du in der Mitte des Raumes eine kleine Insel. "
        "Sie ist nicht groesser als zwei Meter, und es befinden sich lauter "
	"Muscheln, Perlen und Seetang darauf. Ausserdem erkennst Du auf "
	"der Insel eine wunderschoene Meerjungfrau. Es ist Calluna, die "
	"Hexe des Meeres und die Hueterin des Ozeans.");


   else
   return BS(
   	"Du betrittst Callunas Haus des Meeres. Vor Dir siehst Du die Weiten "
        "des Ozeans. Hier gibt es weder Waende noch einen Boden. Du stehst "
        "stattdessen mitten im Meer. Komischerweise kannst Du einfach "
	"so ueber das Wasser gehen. Manchmal schnellt eine Walflosse "
	"vom Wasser hoch und spritzt Dich etwas nass. Als Du Dich genauer "
        "umsiehst, bemerkst Du in der Mitte des Raumes eine kleine Insel. "
        "Sie ist nicht groesser als zwei Meter, und es befinden sich lauter "
	"Muscheln, Perlen und Seetang darauf. Normalerweise sitzt Calluna "
	"auf der Insel aber nun scheint sie verlassen und leer.");

 }

      
   
