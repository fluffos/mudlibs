// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void grundzustand();
int buch_da;


create()
{
	

  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Magie");

      
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"bibliothek","haus"}), 
            "Das Haus ist voller Buecher und aehnelt daher einer Bibliothek.");
   
  AddDetail( ({"kirschenholz","kirschholz","holz"}),
	    "Das Kirschenholz sieht alt aber edel aus. Einige Wurmloecher "
	    "bieten hier anscheinend das Zuhause von einigen Insekten.");

  AddDetail( ({"zuhause","wurmloecher","loecher"}),
	    "Ein nettes Zuhause fuer Insekten.");
 
  AddDetail( ({"insekten","haus"}),
	    "Du putzt immer schoen brav, dadurch hast Du keine im Haus.");  
             

  AddDetail( ({"waende","wand"}), 
            "Die Waende bestehen aus einem schoenen Kirschenholz. Viel davon "
            "kann man leider nicht erkennen, da die Regale die Waende "
	    "vollkommen verstellen.");
	    

  AddDetail( ({"boden","decke"}),
	    "Der Boden und die Decke bestehen aus schoenem Kirschenholz.");
          

  AddDetail( ({"regale","regalen","regal"}),
	    "In den Regalen stehen lauter Buecher, die sorgfaeltig nach "
	    "dem Alphabet sortiert wurden.");
	
  
  AddDetail( ({"alphabet"}),
	    "Hast Du das in der Grundschule verpasst?");
	    

  AddDetail( ({"grundschule",}),
	    "Wenn Du da nicht warst, ist es hoechste Zeit, Dich bei den "
	    "anonymen Analphabeten anzumelden.");

  AddDetail( ({"zeit"}),
	    "Die scheint hier still zu stehen.");
          
	
  AddDetail( ({"analphabeten","analphabet"}),
	    "Es ist noch nicht zu spaet, um lesen und schreiben zu lernen.");
	    

  AddDetail( ({"kessel"}),
	    "Ein kleiner silberner Kessel befindet sich in der Schublade. "
	    "Leider kannst Du ihn nicht herausnehmen, da er nicht fuer Dich "
	    "bestimmt ist.");

  AddDetail( ({"sofa"}),
	    "Einst war es leuchtend blau. Mittlerweile ist es blaugrau "
            "und zerschlissen. Setz Dich besser nicht hin.");

  AddDetail( ({"zettel","zetteln"}),
	    "Auf den Zetteln steht eine Dir unbekannte Sprache.");
	    

  AddDetail( ({"sprache"}),
	    "Yiwah razniki delidra mahir rahim.");
	    
  AddDetail( ({"buecher"}),
	   "Ein goldenes Buch erweckt Deine Aufmerksamkeit. Vielleicht "
	   "kannst Du es ja herausziehen und lesen.");
	  

  AddDetail( ({"neugierde"}),
	   "Guck Dir die Buecher an.");  
         

  AddDetail( ({"buch"}),
	   "Das Buch kreischt: Lies mich!\n"
	   "Du erschrickst.");

  AddDetail( ({"holztisch","tisch"}),
	   "Ein huebscher kleiner Holztisch aus Kirschenholz. Lauter "  
           "Buecher und Zettel befinden sich darauf. Weiters kannst Du "
	   "eine Schublade erkennen.");

  AddDetail( ({"schublade"}),
	    "Das geht Dich nichts an, was sich darin befindet.");
	 
	   

  AddDetail( ({"winkel"}),
	    "Da befindet sich der Holztisch.");

  AddDetail( ({"als","am","auch","das","er","es","in","lauter","setz"}),
	    "Untersuch doch nicht solche seltsamen Details.");

  AddDetail( ({"details","mittlerweile","vielleicht","weiteres"}),
	    "Dir ist langweilig, oder?");
 
 
            

  AddDetail( ({"frau"}),
	    "Diese Frau ist eine Hexe, und eine ganz ganz boese auch noch "
	    "dazu.");

  AddDetail( ({"hexe"}),
	    "Dieses Detail hat Feyaria gepachtet.");

  AddDetail( ({"feyaria"}),
	    "Kennst Du Feyaria nicht?");

  AddDetail( ({"stadt","dorf"}),
	    "Vielmehr ein Dorf.");

    
  AddDetail( ({"himmel","gott"}),
	   "Der Gott wohnt im Himmel.");

  AddDetail( ({"lies"}),
	   "Mach es einfach");

    
  AddDetail( ({"kristallkugel","zukunft"}),
	   "In der Kristallkugel befindet sich Deine Zukunft.");

    
  AddDetail( ({"aufmerksamkeit","violet"}),
	   "Violet schenkt Dir keine Aufmerksamkeit.");

    
  AddDetail( ({"detail","einzige","seite","gott","himmel"}),
	   "Untersuch nicht alles.");

    
  AddDetail( ({"holzwaende"}),
	   "Grosse Regale stehen an den Holzwaenden.");
      
  
  AddSmell(DEFAULT_SMELL, "Du riechst den leichten Geruch von Kirschenholz "
                          "und Papier.");  
 
  AddSmell( ({"geruch"}),
	   "Es riecht nach Kirschenholz und Buecher.");
	  

  AddSmell( ({"kirschenholz"}),
	   "Holzig.");
  
  AddSmell( ({"papier","buecher"}),
	   "Es riecht irgendwie nach sehr sehr alten Buechern.");
	
   
 
  
  AddSound(DEFAULT_SOUND,"Das Einzige, was Du hier hoeren kannst, ist "
	   "das Umblaettern des Buches von Violet.");

  AddSound( ({"umblaettern"}),
	   "Na, sie wird logischerweise nicht immer dieselbe Seite lesen.");
	              
  
  AddSound( ({"buch"}),
	   "Oh Gott, wieso lauschst Du einem Buch?!");
	 


//-----Details Ende-----
  
 AddExit("osten", ROOM "whexe_13.lpc");
 AddItem(NPC "violet.lpc", REFRESH_DESTRUCT);
//-----KOMMANDOS--------

 AddCmd( ({ "ziehe", "zieh" }), "c_herausziehen");
 
 grundzustand();
}  

void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	buch_da = 1;
	
}

int c_herausziehen(string str)
{
   object buch;
   
   notify_fail(BS("Was moechtest Du herausziehen?"));
   if(!(str == "buch heraus"))
   {
     return 0;
   }
   if(present("\nviolet_buch", ENV(TP)) || (!buch_da))
   {
   write(BS("Vor Dir war leider schon jemand hier und hat das Buch "
	    "entwendet. Tja wer zuerst kommt, malt zuerst."));
   return -1;
   }
   else
   {
    write(BS("Du greifst nach dem Buch und ziehst es vorsichtig aus dem Regal. "             "Neugierig haeltst Du es in Deinen Haenden und begutachtest es. "
	     "Ob Du es wirklich lesen solltest?"));
     tell_room(ENV(TP), TPN+" zieht ein Buch aus dem Regal.\n", ({TP}));
     buch_da = 0;
     buch = clone_object(OBJ "buch");
  if (buch->move(TP,M_GET) < 0)
  {
    write(BS("Das Buch ist Dir zu schwer, deshalb laesst Du es zu "
             "Boden fallen."));
    tell_room(TPN +" laesst ein Buch zu Boden fallen.\n", ({TP}) );
    buch->move(TO, M_NOCHECK);
  }   
     
      return 1;
    }
   }


 string _query_int_long()
 {
   if (present("hexe"))
   return BS(
     	"Du befindest Dich hier in einem sehr gemuetlichem kleinem Haus. "
        "Es aehnelt irgendwie einer Bibliothek, da die Holzwaende von "
        "Regalen vollgestellt sind. In den Regalen befinden sich massenweise "
        "Buecher, die Deine Neugierde erwecken. Als Du Dich genauer umsiehst, "
	"bemerkst Du einen kleinen Holztisch im hintersten Winkel des Hauses. "
        "Er ist vollgeraeumt mit Buechern und Zetteln. Auch eine kleine "
	"Kristallkugel befindet sich am Tisch. Weiters erkennst Du ein "
	"altes zerschlissenes Sofa, hinter dem Tisch. Am Sofa kauert eine "
	"wunderschoene junge Frau. Es ist die Hexe Violet, die vollkommen "
	"vertieft in ein Buch Dich gar nicht wahrnimmt.");


   else
   return BS(
	"Du befindest Dich hier in einem sehr gemuetlichem kleinem Haus. "
        "Es aehnelt irgendwie einer Bibliothek, da die Holzwaende von "
        "Regalen vollgestellt sind. In den Regalen befinden sich massenweise "
        "Buecher, die Deine Neugierde erwecken. Als Du Dich genauer umsiehst, "
	"bemerkst Du einen kleinen Holztisch im hintersten Winkel des Hauses. "
        "Er ist vollgeraeumt mit Buechern und Zetteln. Auch eine kleine "
	"Kristallkugel befindet sich am Tisch. Weiters erkennst Du ein "
	"altes zerschlissenes Sofa, hinter dem Tisch.");

  
}
   
