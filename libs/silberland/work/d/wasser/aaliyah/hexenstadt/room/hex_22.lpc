inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

void grundzustand();
int nuss_da;

create()
{
	
::create();
   
   SetProp(P_INT_SHORT, "Mitten im Herbst");
   SetProp(P_INT_LONG,
     "Du befindest Dich nun tiefer im Wald. Wo im Norden noch tiefster "
     "Winter herrscht, scheint hier seltsamerweise Herbst zu sein. Starker, "
     "kalter Wind heult durch die Baeume, und dicke graue Wolken verdunkeln "
     "die Umgebung. Der Waldboden ist mit abgestorbenen Tannennadeln bedeckt, " 
     "und ab und zu siehst Du auch ein paar braune Tannenzapfen, die der Sturm "
     "von den Baeumen gerissen hat. Unter einer Tanne streitet sich eine "
     "kleine Gruppe von Eichhoernchen um ein paar Nuesse. Im Osten scheint "
     "der Wald wieder etwas freundlicher zu werden.");
     

//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: -10, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
  

//-------------------RAUMDETAILS---------------------------------------------

   AddDetail( ({ "umgebung" }), QueryProp(P_INT_LONG));
   
   AddDetail( ({ "winter","norden" }),
     "Im Norden herrschte tiefster Winter.");
   
   AddDetail( ({ "wind" }),
     "Eigentlich ist es eher ein Sturm.");
   
   AddDetail( ({ "tannennadeln", "tannenzapfen","nadeln","zapfen" }),
     "Der ganze Waldboden ist mit Tannennadeln und Tannenzapfen bedeckt.");
     
   AddDetail( ({ "sturm","umhang" }),
     "Es stuermt hier ganz schoen. Du ziehst Deinen Umhang enger um Dich.");
   
   AddDetail( ({ "baeume","tannen" }),
     "Riesige Tannen umzingeln Dich. Ihre Aeste bewegen sich im Wind. "
     "Ihre dicken Staemme sind mit einer grauen Moosflechte ueberzogen. "
     "Als Du genauer hinsiehst, erkennst Du, dass sich die Rinde ihrer Staemme "
     "bewegt, und es scheint, als wuerden sie Dir etwas sagen wollen.");
   
   AddDetail( ({ "staemme","stamm" }),
     "Diese Baeume scheinen schon sehr alt zu sein.");
   
   AddDetail( ({ "moosflechte" }),
     "Grau!");
   
   AddDetail( ({ "rinde" }),
     "Als Du die Rinde genauer betrachtest, faellt Dir auf, dass ein paar "
     "der Baeume seltsamerweise einen Mund haben. Sofort schwindet Deine "
     "Angst, denn sprechende Baeume kennst Du aus Deinen Kinderbuechern "
     "und da waren sie immer freundlich.");
     
   AddDetail( ({ "mund" }),
     "Vielleicht solltest Du einmal an den Baeumen lauschen.");
   
   AddDetail( ({ "kinderbuecher" }), 
     "Vergiss Deine ollen Kinderbuecher! Das hier ist die Realitaet! "
     "Die Insel gleicht eher einem Horror als einem Maerchen.");
     
   AddDetail( ({ "horror","stephen king","king","horrorbuecher" }),
     "Stephen King schreibt gute Horrorbuecher.");
   
   AddDetail( ({ "maerchen" }),
     "Es ist nichts so, wie es scheint.");
   
   AddDetail( ({ "tanne" }),
     "Unter der Tanne streitet sich eine kleine Gruppe von Eichhoernchen "
     "um ein paar Nuesse.");
   
    AddDetail( ({ "realitaet","silberland","gedanken" }),
     "Wenn das Silberland schon zu Deiner Realitaet geworden ist, solltest Du "
     "Dir einmal Gedanken drueber machen.");
    
   AddDetail( ({ "gruppe","eichhoernchen" }),
     "Du hoerst, wie sie streiten.");
   
   AddDetail( ({ "nuesse","nuss" }),
     "Nimm Dir ein paar, die kann man sicher essen.");
   
   AddDetail( ({ "waldboden","boden" }),
     "Es knirscht und knackt unter Deinen Schritten.");
   
   AddDetail( ({ "schritten","schritt","schritte" }),
     "Das Knirschen kommt sicher von den unzaehligen Tannennadeln, die "
     "ueberall am Boden liegen.");
   
   AddDetail( ({ "knirschen" }),
     "'Knirsch'.");
   
   AddDetail( ({ "wald" }),
     "Im Norden herrscht tiefster Winter, hier ists herbstlich, aber im "
     "Osten scheint es etwas waermer zu werden.");
   
   AddDetail( ({ "norden" }),
     "Da herrscht Winter.");
   
   AddDetail( ({ "osten" }),
     "Geh einfach hin!");
   
   AddDetail( ({ "wolken","wolke" }),
     "Der Himmel ist von dicken grauen Wolken bedeckt.");
   
   AddDetail( ({ "himmel" }),
     "Der Himmel ist durch das dichte Blaetterdach nicht zu entdecken.");
   
   AddDetail( ({ "blau" }),
     "Du bist knapp davor, zu Holly zu gehen und Deine Angst im Alkohol "
     "zu ertraenken.");
   
   AddDetail( ({ "holly" }),
     "Dieser netten kleinen Fee gehoert die Kneipe.");
   
   AddDetail( ({ "fee" }),
     "Hier findest Du im Moment keine Fee.");
   
   AddDetail( ({ "kneipe","o","ob","alkohol" }),
     "Du denkst. o O (Ob ich rauschiger noch metzeln kann?).");
   
   AddDetail( ({ "angst" }),
     "Deine Haende sind eiskalt, der Angstschweiss rinnt Dir ueber die Stirn, "
     "und Du zitterst am ganzen Koerper.");
   
   AddDetail( ({ "haende","hand" }),
     "Schoene gepflegte Haende hast Du.");
   
   AddDetail( ({ "angstschweiss" }),
     "Du wischst Dir den Angstschweiss von der Stirn.");
   
   AddDetail( ({ "angst" }),
     "Man weiss hier nie, was hinter der naechsten Ecke lauert.");
   
   AddDetail( ({ "ecke","fall" }),
     "In diesem Fall eher Baum.");
   
   AddDetail( ({ "baum" }),
     "Du siehst den Wald vor lauter Baeume nicht.");
   
   AddDetail( ({ "stirn" }),
     "Hoffentlich ist auch etwas dahinter ;).");
   
   AddDetail( ({ "koerper" }),
     "Du solltest ein bisschen abnehmen. Dein Bauch und Dein Hintern sind "
     "ein bisschen zu dick geworden.");
   
   AddDetail( ({ "bauch", "hintern" }),
     "Nicht soviel naschen!");

   AddDetail( ({"aeste","herbst","ast"}),
     "Die Aeste sind schon vom Herbst gezeichnet.");

   AddDetail( ({"insel","moment"}),
     "Fuer einen Moment wuenschst Du Dir, auf einer einsamen Insel zu sein.");
   
//-------------------GERAUESCHE----------------------------------------------

   AddSound(DEFAULT_SOUND,
     "Der Wind heult durch den Wald, und es scheint, als wuerden die Baeume "
     "fluestern.");
   
   AddSound( ({ "wind" }),
     "Der Wind heult und pfeift.");
    
   AddSound( ({ "baeume" }),
     "Die Baeume fluestern: Lauf weg, solange Du noch kannst!.");
   
   AddSound( ({ "knirschen" }),
     "Es knirscht: Flieh von hier, so schnell Du kannst!");
   
   AddSound( ({ "eichhoernchen" }),
     "'Gib das her, das ist meins!'");
   
   
//-------------------EXITS---------------------------------------------------


  AddExit("osten", ROOM "hex_23.lpc");
  AddExit("norden", ROOM "hex_19.lpc");
  AddExit("sueden", ROOM "hex_31.lpc");
  AddExit("westen", ROOM "hex_32.lpc");
  AddItem("/d/astral/lamuerte/brunnen/npc/seelenraeuber",
  REFRESH_DESTRUCT, ([P_MNPC_AREA: ROOM]) );
//-------------------KOMMANDOS-----------------------------------------------

   AddCmd( ({"nimm"}), "c_nehmen");
 
   grundzustand();
}

void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
   nuss_da = 1;
}

int c_nehmen(string str)
{  
   notify_fail(BS("Was moechtest Du denn hier nehmen?"));
   if(!(str == "nuesse" || str == "nuss"))
   {
     return 0;
   }
   if(present("nuss", ENV(TP)) || (!nuss_da))
   {
     write(BS("Dir laeuft das Wasser im Mund zusammen, und Du freust Dich "
     	      "auf ein paar leckere Nuesse, aber leider haben die "
     	      "Eichhoernchen alles weggefressen."));
     return -1;
  }
  else
  {
    write(BS("Du durchwuehlst die vielen Nussschalen und findest eine "
    	     "Astralnuss, die Du sofort einsteckst."));
    	    
    tell_room(ENV(TP), TPN+" sammelt ein paar Nuesse.\n", ({TP}));
    nuss_da = 0;
    CLONE(OBJ "astralnuss.lpc", TP);
    return 1;
  }
 }



