// von Aaliyah
// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void grundzustand();
int traene_da;

create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Traenen");
      
	
      
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"frauengesichter","frauengesicht"}), 
            "In den Waenden befinden sich weinende Frauengesichter. Sie "
	    "blicken Dich mit grossen waessrigen Augen an. Ihre Blicke flehen "
	    "Dich an, ihnen zu helfen. ");
		    
             

  AddDetail( ({"waenden","waende","decke"}), 
            "Die Waende scheinen zu weinen. Sie bestehen aus den Seelen "
	    "unzaehliger Frauen, die an gebrochenem Herzen gestorben sind.");
           
	    

  AddDetail( ({"frauen"}),
	    "Sie schluchzen: Hilf uns!");
           

  AddDetail( ({"kristalle","kristall"}),
	    "Diese Kristalle sind kleine versteinerte Traenen. Anscheinend "
	    "weint Morrighan Kristalltraenen. ");
  
  AddDetail( ({"schluchzen"}),
	    "Sehen kannst Du das Schluchzen nicht.");
	    

  AddDetail( ({"gefuehl","moment"}),
	    "Im Moment bist Du einfach nur noch trauig.");

  AddDetail( ({"traenen"}),
	    "Sie fliessen von den Waenden und den Wangen unzaehliger "
            "Frauen, die sich in den Waenden spiegeln. Als Du genauer "
	    "hinsiehst, bemerkst Du, dass manche Traenen sogar versteinert "
	    "sind.");

  AddDetail( ({"kristalltraenen"}),
	    "Nur Morrighan weint Kristalltraenen.");
	    

  AddDetail( ({"hexe","morrighan","herrscherin","traenenhexe"}),
	    "Morrighan, die Traenenhexe ist die Herrscherin der Traurigkeit. ");
	    

  AddDetail( ({"traurigkeit"}),
	    "Du spuerst, wie Traenen in Deine Augen schiessen und versuchst "
            "erfolglos, das Weinen zu unterdruecken.");

  AddDetail( ({"weinen"}),
	    "Heul nur. Ab und zu tut es ganz gut.");
	    

  AddDetail( ({"pfuetzen","pfuetze"}),
	    "Am Boden haben sich lauter kleine Pfuetzen gesammelt. Es sind die "
	    "Traenen des Hauses, das auch nicht dieser enormen Traurigkeit "
	    "standhalten konnte.");
	    
  AddDetail( ({"steinhaus","haus","raum","raumes","hauses","steinhauses"}),
	   "Du befindest Dich im Haus der Traenen.");
	  

  AddDetail( ({"boden"}),
	   "Am Boden befinden sich lauter kleine Pfuetzen und viele kleine "
	   "Kristalltraenen.");  
         

  AddDetail( ({"haeufchen","elend","haenden","gesicht"}),
	   "Morrighan kauert am Boden wie ein Haeufchen Elend.");

  AddDetail( ({"blicke","blick"}),
	   "Die Frauen blicken Dich verzweifelt an. ");  
         
  AddDetail( ({"ohr"}),
	    "Eine Frau heult: Nun lausch doch mal!");
	 	   

  AddDetail( ({"seelen","seele"}),
	    "Die Waende bestehen aus den Seelen der Frauen. Sie wurden hierher "
	    "verbannt und sind verflucht, auf Ewigkeit hier zu bleiben.");
            

  AddDetail( ({"herzen"}),
	    "Wenn das Herz bricht, muss schon was sehr Schlimmes passiert "
	    "sein. ");

  AddDetail( ({"ewigkeit"}),
	    "Diese armen Seelen werden wohl nie zur Ruhe kommen. Es sei denn, "
	    "sie finden wen, der ihnen hilft.");

  AddDetail( ({"herz","leute"}),
	    "Manche Leute haben ein Herz aus Stein.");

  AddDetail( ({"stein"}),
	    "Erst jetzt bemerkst Du, dass der Raum auf einmal verschlossen ist "
	    "und ein grosser Stein aus der letzten Ecke des Hauses auf Dich "
	    "zurollt.");

  AddDetail( ({"ecke"}),
	    "Den Stein hast Du erst gar nicht bemerkt. Jetzt scheint er jedoch "
	    "mit Eiltempo bedrohlich auf Dich zuzurollen.");

  AddDetail( ({"eiltempo"}),
	     "Wenn er Dich erreicht hat, koennen die Hexen Deine armseligen "
	     "Ueberreste von der Wand kratzen.");

  AddDetail( ({"hexen","ueberreste"}),
	     "Die Hexen werden Deine Ueberreste von der Wand kratzen.");

  AddDetail( ({"augen","auge"}),
	     "Sie starren Dich traurig an.");

  AddDetail( ({"schlimmes"}),
	     "Etwas Schlimmes steht Dir noch bevor.");

  AddDetail( ({"ruhe","frau"}),
	   "Vielleicht ist es besser, Du laesst die Frau in Ruhe.");

    
  AddDetail( ({"traene","wangen","wand"}),
	   "Eine dicke Traene rinnt ueber die Wangen der Frau in der Wand. "
	   "Vielleicht solltest Du sie troesten.");

    
  AddDetail( ({"wunder"}),
	   "Es waere ein Wunder, wenn Du ueberleben wuerdest.");

  
  AddRoomMessage( ({"Sanftes Schluchzen ertoent im Raum.\n",
	          "Die Waende seufzen.\n",
		  "Eine dicke Traene tropft von der Decke.\n",
		  "Die Frauen seufzen: Hilf uns!.\n"}), 80);
  
  AddSmell(DEFAULT_SMELL, "Der Raum riecht nach Salz. Kein Wunder, wenn hier "
                          "alles von Traenen ueberflutet ist.");
			
  AddSmell( ({"traenen","traene"}),
	   "Sie riechen salzig.");
	  

  AddSmell( ({"salz"}),
	   "Die Traenen riechen salzig.");
  
       
 
  
  AddSound(DEFAULT_SOUND,"Leises trauriges Schluchzen ertoent von den Waenden "
	   "und der Hexe. Der ganze Raum scheint zu weinen.");

  AddSound( ({"schluchzen"}),
	   "Die Frauen schluchzen: Uns kann niemand helfen.");
	           
  
  AddSound( ({"weinen","frauen"}),
	   "Die Frauen weinen: Troeste uns doch.");
	 

  AddSound( ({"waende","waenden"}),
            "Die Waende jammern: Wieso koennen die Frauen nicht einfach still "
	    "sein?");

   
    
  
	    
  
//-----Details Ende-----
  
 AddExit("nordosten", ROOM "whexe_15.lpc");
 AddItem(NPC "morrighan.lpc", REFRESH_DESTRUCT);
//-----KOMMANDOS--------

 AddCmd( ({ "troeste","troest" }), "c_troesten");
 
 grundzustand();
}  

void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	traene_da = 1;
}


int c_troesten(string str)
{
   notify_fail(BS("Wen moechtest Du denn hier troesten?"));
   if(!(str == "frau"))
   {
     return 0;
   }
   if(present("morrighan_traene", ENV(TP)) || (!traene_da))
   {
     write(BS("Du streichelst der Frau troestend ueber die Wangen, und sie "
	      "hoert auch kurz auf zu weinen, faengt jedoch gleich wieder "
	      "damit an."));
	      
     return -1;
    }
    else
    {
      write(BS("Du streichelst der Frau eine Traene weg. Sie laechelt Dich "
	       "an und fluestert: Ueber unser Schicksal weiss die Hexe "
	       "Bescheid. Frag sie danach, sie wird es Dir gewiss erzaehlen. "
	       "Danach schenkt sie Dir aus Dankbarkeit eine kristallerne "
	       "Traene."));
      tell_room(ENV(TP), TPN+" streichelt ueber die Wand.\n", ({TP}));
      traene_da = 0;
      CLONE(OBJ "traene.lpc", TP);
      return 1;
     }
    }

 string _query_int_long()
 {
   if (present("hexe"))
   return BS(
	"Du stehst in einem kleinen Steinhaus. Ploetzlich wirst Du von "
        "einem grossen Gefuehl der Traurigkeit uebermannt. Die Waende und die "
        "Decke sind voll mit lauter kleinen Traenen, die langsam auf den Boden "
        "tropfen und sich zu kleinen Pfuetzen sammeln. Leises Schluchzen "
	"dringt an Dein Ohr, und Du bemerkst unzaehlige Frauengesichter, die "
        "sich in den Waenden befinden. Weiterhin erkennst Du am Boden einige "
	"traenenfoermige, blaue Kristalle. Inmitten der Kristalle hockt die "
	"Hexe, zusammengekauert wie ein Haeufchen Elend, das Gesicht in ihren  "
	"Haenden verborgen und weint bitterlich. Der ganze Raum scheint zu "
	"weinen und strahlt eine unsagbar grosse Traurigkeit aus. ");


     

   else
   return BS(
        "Du stehst in einem kleinen Steinhaus. Ploetzlich wirst Du von "
        "einem grossen Gefuehl der Traurigkeit uebermannt. Die Waende und die "
        "Decke sind voll mit lauter kleinen Traenen, die langsam auf den Boden "
        "tropfen und sich zu kleinen Pfuetzen sammeln. Leises Schluchzen "
	"dringt an Dein Ohr, und Du bemerkst unzaehlige Frauengesichter, die "
        "sich in den Waenden befinden. Weiterhin erkennst Du am Boden einige "
	"traenenfoermige, blaue Kristalle. Der ganze Raum scheint zu weinen "
	"und strahlt eine unsagbar grosse Traurigkeit aus. ");


     
  
}
   
