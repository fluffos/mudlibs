// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"

inherit "std/room";
#include "../def.h"



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Dunkelheit");
  SetProp( P_INT_LONG,
	"Du stehst hier in einem kleinen Haus, das vollkommen aus Samt besteht. "
	"Der Boden, die Waende und sogar die Decke bestehen aus blutrotem Samt. "
	"Am ersten Blick erkennst Du, dass das Haus sehr spaerlich eingerichtet ist. "
	" Ein grosses Regal scheint das einzige Mobilar zu sein. In einer Ecke "
	"liegen noch ein paar schwarze Kissen. Weiters faellt Dir der seltsame "
        "Wandteppich auf, der die Ostwand ziert. Zarte Lichtstrahlen dringen von "
	"draussen ein und zaubern ein bizarres Muster darauf.");       
      

	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, -2 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden besteht aus rotem Samt. Kein einziger Fleck ist darauf "
	    "zu erkennen. Anscheinend ist Hazel eine sehr ordentliche Hexe. ");
             

  AddDetail( ({"fleck"}), 
            "Fleck springt Dich an und wuergt Dich.");
            
	 
  AddSpecialDetail( ({"hazel","hexe"}), "d_hazel");
	         

  AddDetail( ({"mobilar"}),
	    "Nur ein Regal.");
	    	  
  
  AddDetail( ({"regal"}),
	    "Darin befinden sich zahlreiche Rexglaeser.");
	 
  AddDetail( ({"rexglaeser","rexglas","glas","glaeser"}),
	    "Beim genaueren Hinsehen bemerkst Du, das Hazel hier Leichenteile "
	    "konserviert und aufbewahrt.");
	  

  AddDetail( ({"hinsehen"}),
	    "Dir wird uebel.");
         

  AddDetail( ({"leichenteile"}),
	    "Finger, Augen, Zungen, Ohren zB.");

  AddDetail( ({"augen","finger","ohren","zungen"}),
	    "Die hat die Hexe wem ausgerissen.");
	   
  
  AddDetail( ({"kissen","ecke"}),
	    "Waere es nicht so dunkel hier, wuerdest Du merken das das keine "
	    "Kissen sind, sondern Koepfe.");
            

  AddDetail( ({"koepfe"}),
	    "Eklige blutige Koepfe.");
	    
	  
  AddDetail( ({"muster","lichtstrahlen"}),
	    "Du fuerchtest Dich ein wenig. ");
	 	  
  AddDetail( ({"wandteppich","teppich"}),
	   "Als Du genauer hinsiehst bemerkst Du das der Teppich aussieht wie eine "
	   "gegerbte Menschenhaut.");
	
	 

  AddDetail( ({"menschenhaut"}),
	   "Er sieht nicht nur so aus, es ist eine gegerbte Menschenhaut.");
          

  AddDetail( ({"samt"}),
	   "Seltsame Abdruecke befinden sich im Samt.");
	   

  AddDetail( ({"abdruecke"}),
	   "Du kannst Dir nicht erklaeren woher die kommen.");

  AddDetail( ({"decke","wand","waende"}),
	    "Alles besteht vollkommen aus Samt.");
  
  AddDetail( ({"haus","blick"}),
	    "Es ist sehr sehr dunkel hier.");

  AddDetail( ({"himmel"}),
	    "Du wirst sehr sehr bald dort sein. ");

  AddDetail( ({"ostwand"}),
	    "Dort befindet sich der Wandteppich.");

 	     
  
  AddSmell(DEFAULT_SMELL, "Von der Haut an der Wand stroemt ein bestialischer "
		  "Geruch. ");
	
                        
 
  AddSmell( ({"geruch","haut"}),
	   "Es stinkt bestialisch. ");
	   
  
    
  AddSound(DEFAULT_SOUND, "Suesse Stille durchflutet das ganze Haus. ");
		
	   

  AddSound( ({"stille"}),
	   "Stille kreischt: Du kannst mich nicht hoeren!");
             
  

//-----Details Ende-----
  
AddExit("sueden", "./whexe_03.lpc");
AddItem(NPC "hazel.lpc", REFRESH_DESTRUCT);
}  
  string d_hazel()
{
  if (present("hazel")) 
    return "Hazel lechzt nach Deinem Blut.\n";
  else 
    return "Hazel wuerde nach Deinem Blut lechzen, waere sie da.\n";
}

   
