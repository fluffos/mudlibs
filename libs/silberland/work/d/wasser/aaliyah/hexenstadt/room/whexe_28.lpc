// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "The Point of no Return");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einem kleinen, einsamen Weg. "
	"Im Osten kannst Du ein Steinhaus betreten, waehrend Du "
	"nach Sueden wieder in die Stadt gelangst. Der Boden ist "
	"uebersaeht mit Leichenteilen und Knochen. Nur mehr wenige "
        "Himbeerstraeucher saeumen den Wegrand. Auch der Regen hat "
        "hier aufgehoert, und die Sonne beginnt zwischen den Wolken "
	"hervorzublinzeln.");
    	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","weg"}), 
            "Der Boden ist uebersaeht mit stinkenden verwesten Leichenteilen. "
	    "Vereinzelt liegen auch ein paar abgenagte Knochen dazwischen. "
	    "Dich schauderts.");
             

  AddDetail( ({"leichenteile","knochen","leichenteilen"}), 
            "Urks, so genau moechtest Du sie Dir nicht ansehen.");
            
	 
  AddDetail( ({"Himbeerstraeucher","straeucher","himbeeren","strauch"}),
	    "Einige verfaulte Himbeeren haengen trostlos an den Straeuchern.");
      

  AddDetail( ("wegrand"),
	    "Ein paar karge Himbeerstraeucher wachsen da.");
	    	  
  
  AddDetail( ({"himmel"}),
	    "Die Wolken lassen schon zarte Sonnenstrahlen durch.");
	 
  AddDetail( ({"wolken","wolke"}),
	    "Sie sind blutrot.");
	     

  AddDetail( ({"sonnenstrahlen","sonne","sonnenstrahl"}),
	    "Die Sonne trocknet das Blut auf Deiner Kleidung.");

  AddDetail( ({"schritten","schritte"}),
	    "Es knackst und knirscht unter Deinen Schritten.");

  AddDetail( ({"regen"}),
	    "Es regnet hier nicht mehr.");
         

  AddDetail( ({"stadt"}),
	    "Du bist hier irgendwo am Ende von ihr.");

  AddDetail( ({"ende"}),
	    "Es ist Dein Ende.");
	   
  
  AddDetail( ({"osten","steinhaus"}),
	    "Im Osten befindet sich ein Steinhaus.");

  AddDetail( ({"kleidung","blut"}),
            "Deine Kleidung ist mit Blut beschmiert.");
            

  
  AddSmell(DEFAULT_SMELL, "Der Gestank der Leichen liegt hier in der Luft.");
	
                        
 
  AddSmell( ({"leichen","gestank","leiche"}),
	   "Die Leichen stinken bestialisch.");

  AddSmell( ({"luft"}),
            "Hier herrscht dicke Luft.");
 
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst leise das Knirschen der Knochen unter "
		  "Deinen Schritten und ausserdem noch leisen Gesang.");
	   

  AddSound( ({"knirschen","knochen"}),
	   "Die Knochen knirschen unter Deinen Schritten.");

  AddSound( ({"gesang"}),
           "Eine Frau scheint im Steinhaus im Osten zu singen.");

  AddSound( ({"frau"}),
	   "Die Frau singt wunderschoen.");
           
  

//-----Details Ende-----
  
AddExit("sueden", "./whexe_05.lpc");
AddExit("osten", "./hex_06.lpc");

AddItem( NPC "leiche", REFRESH_DESTRUCT);
AddItem("/d/astral/lamuerte/brunnen/npc/seelenraeuber",
REFRESH_DESTRUCT, ([P_MNPC_AREA: ROOM]) );

}
   
