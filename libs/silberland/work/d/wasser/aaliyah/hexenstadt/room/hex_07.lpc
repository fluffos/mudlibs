// 025.09.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>

void grundzustand();

int kraeutersaeckchen_da;

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Mystik");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier an dem Ort, an dem die Mystik entsteht. "
        "Von hier wird all die Magie und Mystik des Silberlandes in die "
        "einzelnen Gebiete gesendet. Lauter kleine Irrlichter tanzen im "
        "Raum und tauchen ihn in ein mystisches Licht. Viele Gegenstaende "
        "fliegen in der Luft und verfehlen nur knapp Deinen Kopf. "
	"Weiters erkennst Du seltsame bunte Lichtbahnen, die ueberall "
	"aus der Wand schiessen und mit den Irrlichtern ein seltsames "
	"Szenario ergeben. Du kannst das Haus im Westen wieder verlassen.");
	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden besteht aus blankem Glas. Viele bunte Lichter taenzeln "
	    "darueber und ergeben ein lustiges buntes Muster.");
             

  AddDetail( ({"muster"}), 
            "Als Du Dich ueber das Muster amuesieren willst, fallen Dir "
	    "ein paar Bluttropfen auf.");
    

  AddDetail( ({"lichter","irrlichter"}),
	    "Sie taenzeln verspielt ueber den Boden.");
      

  AddDetail( ({"glas","stephen","glasshouse","kings"}),
	    "Kennst Du Stephen Kings 'Glasshouse'?.");
	  
  AddDetail( ({"magie","mystik"}),
	    "Etwas, was man mit Haenden nicht anfassen kann.");
	 
  AddDetail( ({"haus","raum"}),
	    "Hier lebt Myrica. Pass nur auf, dass Du sie nicht stoerst.");

  AddDetail( ({"licht"}),
	    "Es wird etwas heller.");
         
  AddDetail( ({"kessel"}),
	    "Den kannst Du leider nicht erreichen.");

  AddDetail( ({"silberland","silberland"}),
	    "Da bist Du gerade.");
	   
  
  AddDetail( ({"waende","decke"}),
	    "Hier besteht alles aus blitzblankem Glas.");
   
  AddDetail( ({"szenario"}),
	    "Beim genauerem Hinsehen erkennst Du, dass die Lichter zwei "
	    "Gestalten bilden.");
	 

  AddDetail( ({"gebiete"}),
	    "Das Silberland hat viele Gebiete.");
	    
	    
  AddDetail( ({"lichtbahnen","lichtbahn"}),
	   "Woher sie kommen, kannst Du nicht erkennen. Sie scheinen einfach "
	   "so zu entstehen");
	 

  AddDetail( ({"luft"}),
	   "Die Luft hier ist seltsam frisch.");
          

  AddDetail( ({"gestalten","gestalt"}),
	   "Sie haben lange Haende und schlitzen sich mit ihren Fingernaegeln "
	   "gegenseitig auf.");

  AddDetail( ({"kopf"}),
	   "*Autsch* Ein silberner Kochloeffel trifft Dich mitten auf der "
	   "Stirn.");

  AddDetail( ({"stirn"}),
	    "Du greifst Dir auf die Stirn. Eine dicke Beule befindet sich "
	    "jetzt darauf.");

  AddDetail( ({"kochloeffel"}),
	    "Der schwirrt schon wieder woanders rum.");
	           

  AddDetail( ({"beule"}),
	    "Die tut hoellisch weh.");

  AddDetail( ({"haende","fingernaegel","hand","fingernagel"}),
	    "Sie koennten auch Dich aufschlitzen.");
	
  AddDetail( ({"bluttropfen","blut"}),
	    "Von irgendwoher tropft Blut.");

  AddDetail( ({"gegenstaende","gegenstand","vieles"}),
	    "Kelche, Kraeuter, Messer, Kochloeffel und noch viele andere "
	    "komische Dinge fliegen im Raum umher.");

  AddDetail( ({"kraeuter"}),
	    "Du kannst sie nicht erkennen, wenn sie so rumflitzen.");

  AddDetail( ({"messer"}),
	    "An jedem einzelnen klebt Blut.");

  AddDetail( ({"dinge","ding"}),
	    "Kraeutersaeckchen, Loeffel, Kelche und vieles mehr.");

  AddDetail( ({"kraeutersaeckchen"}),
	    "Davon schwirren sehr viele hier in der Gegend herum. Vielleicht "
	    "kannst Du ja eines davon fangen.");

	
   AddRoomMessage( ({"Ein Kraeutersaeckchen fliegt an Dir vorbei.\n",
	          "Ein paar Irrlichter taenzeln durch den Raum.\n",
		  "Ein kleiner Loeffel knallt Dir mitten auf die Stirn.\n",
		  "Lauter Dinge schweben im Raum an Dir vorbei.\n"}), 60);
		   
  
  AddSmell(DEFAULT_SMELL, "Du riechst frische Luft mit einem Hauch von etwas "
	    "Dir Unbekanntem.");
                        
 
  AddSmell( ({"luft"}),
	   "Sehr frische Luft.");

  AddSmell( ({"unbekanntem"}),
	   "Du kommst nicht drauf, was es sein koennte.");

  AddSmell( ({"hauch"}),
	    "Irgendwie blumig.");

 
  
  AddSound(DEFAULT_SOUND, "Du hoerst das Zischen und Schwirren der fliegenden "
		          "Gegenstaende.");	
	   

  AddSound( ({"zischen"}),
	   "Es zischt.");

  AddSound( ({"schwirren"}),
	   "Die Gegenstaende schwirren an Deinen Ohren vorbei.");
  
  

//-----Details Ende-----
  
AddExit("westen", "./whexe_05.lpc");
AddItem(NPC "myrica.lpc", REFRESH_DESTRUCT);

//-----KOMMANDOS--------
 AddCmd( ({ "fang", "fange" }), "c_fangen");

 grundzustand();
}

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	kraeutersaeckchen_da = 1;
}
int c_fangen(string str)
{
	
   notify_fail(BS("Was moechtest Du hier denn fangen?"));
   if(!(str == "kraeutersaeckchen" || "saeckchen"))
   {
     return 0;
   }

  
   if(present("kraeutersaeckchen", ENV(TP)) || (!kraeutersaeckchen_da))
   {
     write(BS("Leider bist Du viel zu langsam und kannst keines der Dinge"
	      "erwischen."));
    tell_room(ENV(TP), TPN+" fuchtelt in der Gegend herum.\n", ({TP}));
	      
     return -1;
    }
    else
    {
      write(BS("Du greifst ins Getuemmel und faengst geschickt ein\n"
	       "Kraeutersaeckchen."));
      tell_room(ENV(TP), TPN+" fuchtelt in der Gegend herum.\n", ({TP}));
      kraeutersaeckchen_da = 0;
      CLONE(OBJ "kraeuters.lpc", TP);
      return 1;
     }
 
}
      
