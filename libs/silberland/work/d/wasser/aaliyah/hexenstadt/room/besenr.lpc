//Besenraum


inherit "std/room";
#include "../def.h"
#include <properties.h>
#include <moving.h>


void init()
{
  ::init();
  if (interactive(TP))
    call_out("seq1", 4);
}


void create()
	
{
  if( !is_clone(TO) ) return;

  ::create();
  PO->CustomizeObject(); 
  

  SetProp( P_INT_SHORT, "Auf einem Hexenbesen");
  SetProp( P_INT_LONG,
	"Du sitzt auf einem wackeligen Hexenbesen. Er gleitet sanft ueber den "
	"Wolken und Du hast keine Ahnung, wohin er Dich jetzt tragen wird. "
	"Vielleicht stuerzt er ja auch ab, und Du zerschellst an den Felsen "
	"oder in den Bergen oder ertrinkst im Ozean, der sich tief unter Dir "
        "befindet. Diese Ungewissheit macht Dir schon irgendwie Angst. Dir "
	"wird schwindlig, als Du in die Tiefe blickst, und haeltst Dich noch "
        "etwas fester am Besenstil fest.");       
      
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_WATER]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
//-----Details Anfang-----

  
  AddDetail( ({"ozean","tiefe"}), 
            "Tief unter Dir befindet sich der Ozean. Das Sonnenlicht laesst "
	    "das Wasser richtig schoen glitzern.");
           

  AddDetail( ({"besenstil","stil"}), 
            "Du umklammerst den Besenstil etwas fester.");

  
  AddDetail( ({"wolken","himmel","blau"}), 
            "Der Himmel strahlt in wunderbaren Blau. Unter Dir befinden sich "
	    "einige Wolken, die richtig watteweich zu sein scheinen. Manchmal "
	    "lichten sie sich, und Du kannst den Ozean unter Dir erkennen.");
           

  AddDetail( ({"licht","sonnenlicht","sonne","wasser"}), 
            "Das Sonnenlicht laesst das Wasser wunderschoen glitzern.");

  AddDetail( ({"felsen","bergen","fels","berg","berge"}), 
            "Du kannst nur hoffen, dass der Besen dort nicht abstuerzt.");

  AddDetail( ({"besen","hexenbesen","dich"}), 
            "Du befindest Dich gerade auf einem Hexenbesen.");

  AddDetail( ({"ungewissheit","angst","ahnung"}), 
            "Ploetzlich wackelt der Besen etwas fester.");




}

 void seq1()
 {
  if (!TP || !present(TP)) return;
  write("Du fliegst uebers Meer.\n");
  call_out("seq2", 4);
 }
 void seq2()
 {
  if (!TP || !present(TP)) return;
  write("Einige Voegel fliegen an Dir vorbei.\n");
  call_out("seq3", 4);
 }
 void seq3()
 {
  if (!TP || !present(TP)) return;
  write("Beim genaueren Hinsehen bemerkst Du, dass es Schwaene sind.\n");
  call_out("seq4", 4);
 }
  void seq4()
 {
  if (!TP || !present(TP)) return;
  write("Das Sonnenlicht glitzert im Gefieder der Schwaene.\n");
  call_out("seq5", 4);
 }
 void seq5()
 {
  if (!TP || !present(TP)) return;
  write("Ein Lufthauch bringt den Besen stark zum Schwanken.\n");
  call_out("seq6", 4);
 }
 void seq6()
 {
  if (!TP || !present(TP)) return;
  write("Du klammerst Dich noch fester an den Besenstil.\n");
  call_out("seq7", 4);
 }
 void seq7()
 {
  if (!TP || !present(TP)) return;
  write("Du geniesst den Ausblick und die frische Luft.\n");
  call_out("seq8", 4);
 }
 void seq8()
 {
  if (!TP || !present(TP)) return;
  write("Das Meer unter Dir schimmert, und Du erspaehst eine Walflosse.\n");
  call_out("seq9", 4);
 }
 void seq9()
 {
  if (!TP || !present(TP)) return;
  write("In weiter Ferne erkennst Du eine kleine Insel.\n");
  call_out("seq10", 4);
 }
 void seq10()
 {
  if (!TP || !present(TP)) return;
  write("Der Besen steuert genau auf diese Insel zu.\n");
  call_out("seq11", 4);
 }
 void seq11()
 {
  if (!TP || !present(TP)) return;
  write("Der Besen wird auf einmal immer schneller.\n");
  call_out("seq12", 4);
 }
 void seq12()
 {
  if (!TP || !present(TP)) return;
  write("Du befindest Dich ploetzlich genau ueber einer Insel.\n");
  call_out("seq13", 4);
 }
 void seq13()
 {
  if (!TP || !present(TP)) return;
  write("Der Besen geht in den Sinkflug ueber.\n");
  call_out("seq14", 4);
 }
 void seq14()
 {
  if (!TP || !present(TP)) return;
  write("Der Besen landet, und Du steigst wohlbehalten herab.\n");
  WLOG(LOG "ankunft", "betritt die Insel");
  TP->move(ROOM "platz1", M_GO, "", "landet", "landet mit einem Hexenbesen");
  
 }
	
       
 
  
 
