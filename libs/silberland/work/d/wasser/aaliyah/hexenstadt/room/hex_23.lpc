inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

void grundzustand();
int johanniskraut_da;
create()
{
	
::create();
   
   SetProp(P_INT_SHORT, "Im Fruehling");
   SetProp(P_INT_LONG,
     "Du befindest Dich hier in einem sehr freundlichen Waldstueck. "
     "Man sieht hier schon die Vorboten des Fruehlings. Der Schnee taut, "
     "und die ersten Blumen stecken ihre Koepfe durch die Schneedecke. "
     "Warme Sonnenstrahlen erwaermen Deine Haut, und Voegel tummeln sich "
     "froehlich um die Baumkronen. Im Westen scheint es etwas duesterer zu "
     "werden, und im Osten und Sueden befinden sich kleine Holzhaeuser.");
 
   
   

//-------------------RAUMEIGENSCHAFTEN---------------------------------------
   
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
   SetProp(P_INDOORS, 0);
 

//-------------------RAUMDETAILS---------------------------------------------

   AddDetail( ({ "waldstueck" }), QueryProp(P_INT_LONG));
   
   AddDetail( ({ "holzhaeuser","holzhaus" }),
     "Im Sueden oder Osten kannst Du jeweils ein Holzhaus betreten.");
     
   AddDetail( ({ "vorboten" }),
     "Die ersten Fruehlingsblumen und ein paar Tiere, die aus ihrem "
     "Winterschlaf erwacht sind.");
   
   AddDetail( ({ "tiere","tier" }),
     "Sehen kannst Du sie nicht, aber Du hoerst sie rascheln und kratzen.");
   
   AddDetail( ({ "rascheln","kratzen" }),
     "Lausch ihm!");

   AddDetail( ({ "erde" }),
     "Der Boden ist erdig und die Erde ist braun und hart");
   
   AddDetail( ({ "tannen","tanne" }),
     "Riesige Tannen ragen in den Himmel empor.");
   
   AddDetail( ({ "winterschlaf" }),
     "Du denkst an Dornroeschen, die hat auch solang geschlafen.");
   
   AddDetail( ({ "dornroeschen","jahren","jahr","jahre" }),
     "Sie wurde nach 100 Jahren von einem Prinzen wachgekuesst.");
   
   AddGenderDetail( ({"prinzen","prinz"}),
     "Suchst Du Deinen Prinz immer noch?",
     "Bist Du ein Prinz?");
   
   AddDetail( ({ "sonnenstrahlen","haut","sonnenstrahl" }),
     "Du geniesst die warmen Sonnenstrahlen auf Deiner Haut.");
   
   AddDetail( ({ "schnee","schneedecke" }), 
     "Auf den Tannen befindet sich kein Schnee mehr, und am Boden ist "
     "auch schon sehr viel weggeschmolzen.");
   
     
   AddDetail( ({ "blaetterdach" }),
     "Das dichte Blaetterdach laesst nur wenige Sonnenstrahlen hindurch.");
   
   AddDetail( ({ "himmel" }),
     "Es ist herrliches Wetter. Der Himmel ist bis auf eine Wolke strahlend "
     "blau. Du fuehlst Dich schon fast wohl hier.");
   
   AddDetail( ({ "baumkronen","wipfel" }),
     "Du siehst ein paar Voegel, die sich froehlich um die Wipfel tuemmeln.");
   
   AddDetail( ({ "fruehling","fruehlings" }),
     "Es ist schoen hier.");
    
     
   AddDetail( ({ "voegel","vogel" }),
     "Sie flattern vegnuegt zwitschernd um die Baumkronen.");
   
   AddDetail( ({ "koepfe","kopf" }),
     "Die ersten Fruehlingsblumen brechen schon durch die duenne Schneedecke.");

   
   AddDetail( ({ "boden", "waldboden" }),
     "Ein Teil des Bodens ist noch mit Schnee bedeckt, aber meistens kann "
     "man schon den erdigen Waldboden erkennen.");
   
   AddDetail( ({ "wolken" }),
     "Eine einzige Wolke befindet sich am Himmel.");
   
   AddDetail( ({ "wolke" }),
     "Die Wolke hat irgendwie die Form eines Totenschaedels.");
   
   AddDetail( ({ "form" }),
     "Ja, sie sieht wirklich aus wie ein Totenkopf.");
   
   AddDetail( ({ "totenkopf","totenschaedel","totenschaedels" }),
     "Kurze Zeit war Deine Angst verschwunden, doch jetzt ist sie wieder "
     "da.");
   
   AddDetail( ({ "zeit" }),
     "Hier scheint die Zeit still zu stehen.");
   
   AddDetail( ({ "angst" }),
     "Du hasst es, Angst zu haben.");
   
   AddDetail( ({ "blumen", "fruehlingsblumen","blume","fruehlingsblume" }),
     "Du erkennst nur Krokusse und Schneegloeckchen, da Du keine Ahnung "
     "von Blumen hast. Dir faellt auf, dass ein Schneegloeckchen etwas "
     "anders ist als die Anderen.");
   
   AddDetail( ({ "anderen" }),
     "Na die anderen Blumen sind normal ;).");
   
   AddDetail( ({ "ahnung" }),
     "Kennst Du Dich eigentlich nirgends aus?.");
   
   AddDetail( ({ "schneegloeckchen" }),
     "Das Schneegloeckchen ist etwas groesser als die anderen und hat einen "
     "seltsamen violetten Farbschimmer. Es duftet gewiss auch anders als die "
     "die Anderen, riech doch mal.");
   
   AddDetail( ({ "farbschimmer" }),
     "Dieses Schneegloeckchen leuchtet violett.");
   
   AddDetail( ({ "krokusse","krokus" }),
     "Weisse und violette Krokusse.");
   
   AddDetail( ({ "ohr","lauscher"}),
     "Sperr auf Deine Lauscher!");
   
   AddDetail( ({"wetter"}),
     "Das Wetter ist fruehlingshaft.");

   AddDetail( ({"teil"}),
     "Ein Teil eben.");

   AddDetail( ({"hinhoeren"}),
     "Untersuch nicht alles.");
		  
		 
		   
   
//-------------------GERAUESCHE----------------------------------------------
      

  AddSmell(DEFAULT_SMELL, "Die Luft riecht hier irgendwie ganz leicht "
		  "nach Vogelkot.");  
 
  AddSmell( ({"vogelkot","kot"}),
           "Anscheinend war Birdy kurz vorher hier.");
          

  AddSmell( ({"birdy"}),
           "Sehen kannst Du ihn nicht mehr, aber sehr wohl riechen.");
  
    
   AddSound(DEFAULT_SOUND,
     "Froehliches Vogelgezwitscher dringt an Dein Ohr.");
   
   AddSound( ({ "vogelgezwitscher","voegel","voegeln" }),
     "Du lauschst den Voegeln, als Dir noch ein anderes Geraeusch "
     "auffaellt.");
   
   AddSound( ({ "geraeusch" }),
     "Beim genaueren Hinhoeren hoerst Du Frauengesang.");
   
   AddSound( ({ "frauengesang" }),
     "Als wenn tausende von Frauen traurige Lieder singen wuerden.");
   
   AddSound( ({ "frauen","lieder" }),
     "Du rufst: Hallo?! Ist hier jemand???!!.");
   
   
//-------------------EXITS---------------------------------------------------

  
   AddExit( "osten", ROOM "hex_24.lpc");
   AddExit( "westen", ROOM "hex_22.lpc");
   AddExit( "sueden", ROOM "hex_26.lpc");

//-------------------KOMMANDOS-----------------------------------------------

   AddCmd( ({ "rieche", "riech" }), "c_riechen");
  
  
   grundzustand();
}

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
   johanniskraut_da = 1;
  
}

int c_riechen(string str)
{  
   notify_fail(BS("Woran moechtest Du riechen?"));
   if(!(str == "an gloeckchen" || str == "an schneegloeckchen"))
   {
     return 0;
   }
   if(present("johanniskraut", ENV(TP)) || (!johanniskraut_da))
   {
     write(BS("Du bueckst Dich und schnupperst an dem Schneegloeckchen. "
     	      "Es duftet wirklich sehr gut, sodass Du es am liebsten "
     	      "pfluecken wuerdest."));
     return -1;
  }
  else
  {
    write(BS("Du schnupperst an dem Schneegloeckchen, als Dir ein seltsames "
    	     "Kraut auffaellt. Du nimmst es sofort an Dich und beschliesst "
    	     "Shila danach zu fragen."));
    tell_room(ENV(TP), TPN+" pflueckt ein seltsames Kraut.\n", ({TP}));
    johanniskraut_da = 0;
    CLONE(OBJ "johkraut.lpc", TP);
    return 1;
  }
}




