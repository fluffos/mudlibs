// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Ein verwachsener Weg");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einem kleinen, verwachsenen Weg. "
	"Kleine Straeucher wachsen sehr dicht am Wegesrand. Der Boden "
	"ist auch fast zur Gaenze mit Gras bewachsen, nur ab und zu "
	"liegen ein paar Kieselsteine herum. Im Suedwesten kannst Du ein "
        "kleines Haeuschen erkennen. Im Suedosten befindet sich eine seltsame "
        "Ruine und im Norden kommst Du wieder auf den Platz zurueck.");
      
	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","weg"}), 
            "Lauter Grasbueschel und sonstiges Unkraut waechst am Weg. "
	    "Vereinzelt liegen auch ein paar Kieselsteine herum, aber "
	    "ansonsten kannst Du nichts besonderes erkennen.");
             

  AddDetail( ({"gras","gruen","grasbueschel"}), 
            "Das Gras waechst in sattem Gruen mitten am Weg.");
            
	 
  AddDetail( ({"unkraut"}),
	    "Hier sollte mal gejaetet werden.");
      

  AddDetail( ({"kieselsteine","kieselstein","stein"}),
	    "Lieber waeren Dir ein paar Diamanten.");
	    	  
  
  AddDetail( ({"diamanten","diamant"}),
	    "Tower verkauft sie zu sehr frechen Preisen.");
	 
  AddDetail( ({"tower"}),
	    "Ein sehr frecher Zwerg, der fuer seine Edelsteine richtige "
	    "Wucherpreise verlangt.");
	  

  AddDetail( ({"preise","tower","zwerg","preis","wucherpreis"}),
	    "Musst Du mit ihm feilschen, dann gibt er sie Dir guenstiger;).");
         

  AddDetail( ({"straeucher","wegesrand","wegrand","strauch"}),
	    "Lauter Straeucher wachsen wild am Wegesrand.");

  AddDetail( ({"gaenze"}),
	    "Fast bis zur Gaenze.");
	   
  
  AddDetail( ({"platz","norden","dorfplatz"}),
	    "Im Norden ist der Dorfplatz.");
            

  AddDetail( ({"ruine","steinhaus","suedosten"}),
	    "Ein total zerfallenes Steinhaus befindet sich im Suedosten. "
	    "Es scheint schon sehr lange unbewohnt. Die Besitzer sind "
	    "sicher verstorben oder haben diesen schrecklichen Ort klugerweise "
	    "verlassen.");

  AddDetail( ({"besitzer"}),
	    "Eigentlich interessiert es Dich gar nicht, was mit dem Besitzer "
	    "dieses Hauses passiert ist.");
	  
  AddDetail( ({"ort","insel"}),
	   "Du wolltest schon immer gerne wissen, woran Du sterben wirst. "
	   "Woran ist noch nicht sicher, aber wo und zwar genau hier, auf "
	   "dieser Insel.");
	 

  AddDetail( ({"haeuschen","haus","hauses"}),
	   "Aus dem Haeuschen im Suedwesten dringen seltsame Geraeusche, "
	   "Du ueberlegst Dir, ob Du es ueberhaupt wagen solltest, es zu "
	   "betreten.");
	
          

  AddDetail( ({"himmel","violett"}),
	   "Der Himmel ist wolkenlos und strahlt in einem hellen Violett.");


  AddDetail( ({"wolken","wolke"}),
	   "Keine da.");

  AddDetail( ({"geraeusche"}),
	    "Lauschen ;).");
 	     
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier seltsam salzig.");
                        
 
  AddSmell( ({"salz"}),
	   "Salz ist doch geruchlos! Deine Sinne spielen Dir einen Streich.");
	
	  
 
 
  
  AddSound(DEFAULT_SOUND, "Du hoerst leise das Zirpen von Grillen und aus dem "
		  "Suedwesten seltsame Geraeusche.");
	   

  AddSound( ({"zirpen","grillen","grille"}),
	   "Die Grillen zirpen wie verrueckt.");
  AddSound( ({"geraeusche"}),
           "Du lauschst genauer und hoerst es ganz deutlich. Jemand scheint "
	   "in dem Haus im Suedwesten bitterlich zu weinen.");
  AddSound( ({"jemand","weinen","leute"}),
	   "Nein, es scheinen mehrere Leute zu weinen.");
           
  

//-----Details Ende-----
  
AddExit("norden", "./whexe_13.lpc");
AddExit("suedwesten", "./hex_30.lpc");
AddExit("suedosten", "./hex_18.lpc");
}  
   
