// von Aaliyah
// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"

inherit "std/room";
#include "../def.h"



void grundzustand();
int loewenbaby_da;

create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Einsamkeit");
   
	
      
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"marmor","marmorplatten","raum","raumes","haus"}), 
            "Der ganze Saal besteht aus weissem Marmor. Im Laufe der Jahre "
	    "entstanden lauter Risse und Furchen darin. Aber die Zeit leistet "
	    "ihren Beitrag, was manchmal positiv aber auch oft negativ "
	    "ist.");
	    
             

  AddDetail( ({"jahre","laufe","jahr","lauf"}), 
            "Im Laufe der Jahre ist der Marmor rissig geworden,");
           
	    

  AddDetail( ({"risse","furchen","riss","furche"}),
	    "In keine dieser Risse und Furchen kannst Du hineingreifen. "
	    "Der Marmor ist alt, das ist alles ;).");            

  AddDetail( ({"himmelbett","bett"}),
	    "So ein wunderschoenes Bett hast Du noch nie gesehen. "
	    "Es besteht aus Elfenbein und ist mit lauter Schnoerkeln "
	    "verziert. Grosse weisse Seidenkissen und eine weisse "
	    "Seidendecke befinden sich darauf. Ausserdem sind lauter "
	    "kleine weisse Blueten daruebergestreut.");
  
  AddDetail( ({"zeit","geld"}),
	    "Zeit ist Geld, und Geld hamma keins.");
	    

  AddDetail( ({"Wind"}),
	    "Der Wind laesst die Blueten durch den ganzen Raum wirbeln.");

  AddDetail( ({"blueten","bluete"}),
	    "Huebsche kleine weisse Blueten werden vom Winde verweht.");
	    

  AddDetail( ({"schnoerkeln","schnoerkel","elfenbein"}),
	    "Das Bett besteht aus Elfenbein und ist mit lauter kleinen "
	    "Schnoerkeln verziert.");
	    

  AddDetail( ({"fenster"}),
	    "Durch die grossen Fenster wird der Saal schoen von der Sonne "
            "durchflutet.");

  AddDetail( ({"scheiben","scheibe","fensterscheiben","scheiben"}),
	    "Alle zerbrochen.");
	    

  AddDetail( ({"rosenbusch","rosen","ecke","ecken","busch","rose"}),
	    "In jeder Ecke steht ein Rosenbusch mit weissen duftenden "
	    "Rosen darauf. Vielleicht kannst Du ja eine dieser Blueten "
	    "abbrechen?");
	    
  AddDetail( ({"decke"}),
	   "Die Decke ist zerfurcht und rissig.");
	  

  AddDetail( ({"boden"}),
	   "Er besteht aus Marmor. Weisse Blueten taenzeln darueber.");  
         

  AddDetail( ({"seidenkissen","kissen"}),
	   "Bluetenweise Seidenkissen befinden sich am Bett.");

  AddDetail( ({"saal"}),
	   "Du befindest Dich hier im Haus der Einsamkeit. "  
           "Ploetzlich entdeckst Du Efeuranken, die vorher nicht "
	   "da waren.");

  AddDetail( ({"sonne"}),
	    "Die Sonne durchflutet den Raum.");
	 	   

  AddDetail( ({"scherben","scherbe"}),
	    "Am Boden vor den Fenstern liegen lauter Scherben. "
	    "Salvia sollte nicht soviel schlafen, sondern eher "
	    "hier einmal fegen.");

  AddDetail( ({"dornen","finger","dorn"}),
	    "Die Dornen stechen Dir die Finger blutig.");
            

  AddDetail( ({"kleid"}),
	    "Salvia traegt ein wunderschoenes weisses Kleid. ");

  AddDetail( ({"frau","schlaf"}),
	    "Die Frau schlummert friedlich dahin. Es waere besser, wenn Du "
	    "sie nicht aufwecken wuerdest.");

  AddDetail( ({"seidendecke","bettdecke"}),
	    "Eine bluetenweisse Seidendecke liegt am Bett.");

  AddDetail( ({"mitte"}),
	    "In der Mitte des Raumes steht verlassen und einsam das "
	    "Himmelbett.");

  AddDetail( ({"efeuranken","ranken"}),
	    "Auf einmal schlaengeln sich Efeuranken die Waende hoch. "
	    "Zwischen ihnen scheint sich etwas zu bewegen.");

  AddDetail( ({"etwas"}),
	     "Du koenntest die Ranken beiseite schieben und einfach "
	     "nachgucken.");
  
  AddDetail( ({"himmel"}),
	    "Dort wirst Du gewiss bald sein.");
   
  AddDetail( ({"waende","beitrag","wand"}),
	    "Die Waende sind zerfurcht. Die Zeit hat gewiss ihren Beitrag "
	    "geleistet");

  AddDetail( ({"einsamkeit","die"}),
	    "Die Einsamkeit macht Dir schwer zu schaffen.");

  AddDetail( ({"gefuehl","haare","ortes"}),
	    "Untersuch doch nicht alles.");
  
  AddDetail( ({"hexe","salvia","anwesenheit"}),
	   "Du spuerst ihre Anwesenheit."); 


  
  AddDetail( ({"luft"}),
	    "Seit wann kann man Luft untersuchen?");

  AddRoomMessage( ({"Der Wind weht ein paar Blueten ueber den Boden.\n",
	          "Der Wind heult durch den Raum.\n",
		  "Der Wind streicht Dir durch Deine Haare.\n",
		  "Ein paar Blueten wirbeln durch den Raum.\n",
		  "Ein starkes Gefuehl der Einsamkeit ueberkommt Dich.\n",
		  "Der Wind saeuselt: Verschwinde, solange Du noch kannst.\n",}), 50);

  AddSmell(DEFAULT_SMELL, "Das einzige, was Du hier riechst, ist der sanfte "
                          "Duft der Blueten, die hier durch die Luft "
			  "wirbeln.");  
 
  AddSmell( ({"duft"}),
	   "Es ist ein sehr leichter, blumiger Geruch.");
	  

  AddSmell( ({"geruch"}),
	   "Aaliyah sagt: blumig!");
  
  AddSmell( ({"blueten"}),
	   "Aaliyah sagt: blumig, wie oft denn noch!?");
	      
 
  
  AddSound(DEFAULT_SOUND,"Der Wind heult durch den Saal und jeder Deiner "
	   "Schritte erzeugt ein lautes Echo.");

  AddSound( ({"echo"}),
	   "Selbst wenn Du leise gehen wuerdest, wuerd es immer noch "
	   "durch den Saal hallen.");
           
  
  AddSound( ({"wind","kind"}),
	   "Der Wind, der Wind, das himmlische Kind.");
	 

  AddSound( ({"schritte"}),
            "Trampel nicht so! Sonst weckst Du die Hexe noch auf!");
	    
  
//-----Details Ende-----
  
 AddExit("sueden", ROOM "whexe_10.lpc");
 AddItem(NPC "salvia", REFRESH_DESTRUCT);
//-----KOMMANDOS--------

 AddCmd( ({ "schiebe","schieb" }), "c_wegschieben");
 AddCmd( ({ "breche", "brich" }), "c_abbrechen");
 
 grundzustand();
}  

void reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	loewenbaby_da = 1;
}

int c_abbrechen(string str)
{
   notify_fail(BS("Was moechtest Du abbrechen?"));
   if(!(str == "blueten ab" || str == "bluete ab"))
   {
     return 0;
   }
   write(BS("Du suchst Dir eine schoene weisse Bluete aus und "
	    "brichst sie ab. Ploetzlich beginnt der Busch sich "
	    "zu bewegen und lauter Dornen stechen Dir in den Finger."));
	  
   tell_room(ENV(TP), TPN+" verletzt sich an den Dornen.\n", ({TP}));
   TP->AddHp(-60);
   return 1;
}

int c_wegschieben(string str)
{
   notify_fail(BS("Was moechtest Du hier beiseite schieben?"));
   if(!(str == "ranken beiseite"))
   {
     return 0;
   }
   if(present("loewenbaby", ENV(TP)) || (!loewenbaby_da))
   {
     write(BS("Du schiebst die Efeuranken beiseite, aber anscheinend hast "
	      "Du Dich getaeuscht."));
	      
     return -1;
    }
    else
    {
      write(BS("Du schiebst vorsichtig die Efeuranken beiseite. "
	       "Ploetzlich springt ein kleines Loewenbaby dazwischen "
	       "hervor. Es zittert am ganzen Koerper vor lauter Angst. "
	       "Vielleicht wuerde es ihm besser gehen, wenn Du es einfach "
	       "mal ganz lieb in den Arm nehmen wuerdest."));
      tell_room(ENV(TP), TPN+" schiebt ein paar Ranken beiseite.\n", ({TP}));
      loewenbaby_da = 0;
      CLONEME(NPC "lbaby.lpc");
      return 1;
    
     }
    }
 string _query_int_long()
 {
   if (present("hexe"))
   return BS(
	"Du stehst in einem grossen Saal. Die Waende, die Decke und der "
        "Boden bestehen aus weissen, zerfurchten Marmorplatten. Grosse "
        "Fenster befinden sich an den Waenden. Die Fensterscheiben sind "
        "zerbrochen und somit liegen ueberall am Boden ihre Scherben. Lauter "
	"weisse Blueten wirbeln durch den Saal. Der Wind scheint sie von "
        "draussen hereinzuwehen. In jede der 4 Ecken steht ein Rosenbusch mit "
	"wunderschoenen weissen Rosen darauf. In der Mitte des Raumes "
	"befindet sich ein weisses Himmelbett. Als Du genauer hinsiehst, "
	"entdeckst Du, dass auf dem Bett eine wunderschoene Frau in einem "
	"weissen Kleid friedlich vor sich hinschlummert. Es ist die Hexe "
	"Salvia, die im Schlaf versucht der schrecklichen Einsamkeit dieses "
	"Ortes zu entrinnen.");


   else
   return BS(
  	"Du stehst in einem grossen Saal. Die Waende, die Decke und der "
        "Boden bestehen aus weissen, zerfurchten Marmorplatten. Grosse "
        "Fenster befinden sich an den Waenden. Die Fensterscheiben sind "
        "zerbrochen und somit liegen ueberall am Boden ihre Scherben. Lauter "
	"weisse Blueten wirbeln durch den Saal. Der Wind scheint sie von "
        "draussen hereinzuwehen. In jede der 4 Ecken steht ein Rosenbusch mit "
	"wunderschoenen weissen Rosen darauf. In der Mitte des Raumes befindet "
	"befindet sich ein weisses Himmelbett. Auf dem Bett befinden sich "
	"viele Kissen und eine zerknautschte Bettdecke. Wahrscheinlich hat "
	"kurz zuvor wer in diesem Bett geschlafen.");
 }
