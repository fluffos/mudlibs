// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>

void grundzustand();
int jasminbluete_da;

object *finder;
void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer kleinen Stadt");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einem kleinen, verlassenen Weg in der "
	"Hexenstadt. Dichtes Buschwerk saeumt den Wegrand, und auch der Boden "
	"ist mit Unkraut ueberwachsen. Anscheinend kuemmert sich hier niemand "
	"um die Stadt und somit verwahrlost alles schoen langsam. Im Sueden "
	"kannst Du schon den Dorfplatz erkennen, und im Norden kannst Du ein "
        "grosses Marmorhaus betreten.");       
      

	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden","weg"}), 
            "Lauter Grasbueschel und sonstiges Unkraut waechst am Weg. "
	    "Vereinzelt liegen auch ein paar Kieselsteine herum, aber "
	    "ansonsten kannst Du nichts besonderes erkennen.");
             

  AddDetail( ({"gras","gruen","grasbueschel"}), 
            "Das Gras waechst in sattem Gruen mitten am Weg.");
            
	 
  AddDetail( ({"unkraut"}),
	    "Hier sollte mal gejaetet werden.");
      

  AddDetail( ({"kieselsteine","kieselstein"}),
	    "Lieber waeren Dir ein paar Diamanten.");
	    	  
  
  AddDetail( ({"diamanten","diamant"}),
	    "Sowas besitzt Du leider nicht.");

  AddDetail( ({"blueten","luft","bluete"}),
	    "Kleine weisse Blueten wirbeln durch die Luft.");

  AddDetail( ({"buschwerk"}),
	    "Du erkennst ein leichtes Glitzern zwischen den Aesten.");

  AddDetail( ({"aeste","aesten"}),
	    "Ja tatsaechlich. Irgendetwas glitzert da.");
  
  AddDetail( ({"glitzern","irgendetwas"}),
	    "Das Glitzern entpuppt sich als Ring.");

  AddDetail( ({"ring"}),
	    "Der Ring sieht genauso aus wie der Meisterring der Druiden.");

  AddDetail( ({"meisterring","druiden","druide"}),
	    "Den hat hier wohl jemand verloren.");

      

  AddDetail( ({"wegesrand","wegrand"}),
	    "Dichtes Buschwerk wuchert am Wegesrand.");
	   
  
  AddDetail( ({"platz","sueden","dorfplatz"}),
	    "Im Sueden gelangst Du auf den Dorfplatz.");
            

  AddDetail( ({"marmorhaus","norden","haus"}),
	    "Das Marmorhaus befindet sich im Norden. Ueberall befinden sich "
	    "grosse Fenster. Leider sind die Fensterscheiben alle zerbrochen. "
	    "Du kannst es durch ein grosses Portal betreten.");

  AddDetail( ({"fensterscheiben","fenster","scheiben","scheibe"}),
	    "Das Haus hat wunderschoene grosse Fenster, dessen Scheiben "
	    "leider alle zerbrochen sind.");
	  
  AddDetail( ({"portal","eingang"}),
	   "Der Eingang zum Haus fuehrt durch ein grosses Portal.");
	 
	
	 

  AddDetail( ({"gerueche"}),
	   "Riech doch mal.");
          

  AddDetail( ({"himmel","violett"}),
	   "Der Himmel ist wolkenlos und strahlt in einem hellen Violett.");

  AddDetail( ({"wolken","wolke"}),
	   "Keine da.");

  AddDetail( ({"hexenstadt","stadt"}),
	    "Da bist Du gerade.");
  
  AddSpecialDetail( ({"jasmin","jasminstrauch"}), "d_strauch");
  
 	     
  
  AddSmell(DEFAULT_SMELL, "Es duftet hier herrlich nach Jasmin. "
		  "Wahrscheinlich liegt es an den Blueten, die hier "
		  "ueberall durch die Luft wirbeln.");
                        
 
  AddSmell( ({"jasmin","blueten"}),
	   "Der Jasmin duftet himmlisch. Vielleicht findest Du ja einen "
	   "Strauch, wenn Du danach suchst.");
  
  AddSmell( ({"luft"}),
	    "Die Luft ist erfuellt mit dem blumigen Duft von Jasmin.");
	  
  AddSmell( ({"duft"}),
	     "Herrlich.");
 
  
  AddSound(DEFAULT_SOUND, "Hier herrscht eine beaengstigende Stille.");
		   

  AddSound( ({"stille"}),
	   "Wenn es still ist, kannst Du doch nichts hoeren.");
   

//-----Details Ende-----
  
 AddExit("norden", "./hex_11.lpc");
 AddExit("sueden", "./platz1.lpc");

//-----KOMMANDOS--------

 AddCmd( ({ "such","suche" }), "c_suchen");
 AddCmd( ({ "pflueck","pfluecke" }), "c_pfluecken");
 
 grundzustand();
}  

void reset()
{
    ::reset();
    grundzustand();
}

void grundzustand()
{
   jasminbluete_da = 1;
   finder = ({});
   
}

int c_suchen(string str)
{
   notify_fail(BS("Was moechtest Du denn hier suchen?"));
   if(!(str == "strauch" || str == "jasminstrauch"))
   {
     return 0;
   }
   write(BS("Du durchsuchst das Buschwerk und findest tatsaechlich "
	    "einen Jasminstrauch."));
   
   finder += ({TP});
   return 1;
}

int c_pfluecken(string str)
{
   notify_fail(BS("Was moechtest Du denn hier pfluecken?"));
   if(!(str == "bluete" || str == "jasminbluete"))
   
   {
     return 0;
   }
   if (member(finder, TP) == -1) return 0;
   if(present("jasminbluete", ENV(TP)) || (!jasminbluete_da))
   {
     write(BS("Du versuchst eine Bluete zu pfluecken, aber leider sind "
	      "die Aeste zu hoch ober Dir."));
     return -1;
   }
   else
   {
      write(BS("Vorsichtig brichst Du eine Jasminbluete vom Ast herunter."));
      tell_room(ENV(TP), TPN+" bricht eine Bluete vom Strauch.\n", ({TP}));
      jasminbluete_da = 0;
      CLONE( OBJ "jblueten", TP);
      return 1;
    }
   }
  string d_strauch()
 {
  if (member(finder, TP) == -1) 

   return "Du musst schon danach suchen.\n";
  else
    return "Vor Dir steht ein kleiner Jasminstrauch mit vielen Blueten drauf.\n";
 }
    	   
