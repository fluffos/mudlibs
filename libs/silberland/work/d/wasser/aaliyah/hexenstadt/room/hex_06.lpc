// Raum meines Gesellenstueckes "Hexenstadt"

inherit "std/room";
#include "../def.h"




void grundzustand();

int landkarte_da;

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Im Haus des Mondes");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_OTHER]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Als Du Dir den Boden angucken willst, bemerkst Du, dass Du "
	    "schwebst. Du hast keine Ahnung, wo der Boden ist, aber unter Dir "
	    "befindet er sich jedenfalls nicht. Und wenn, dann so weit unter "
	    "Dir, dass Du ihn von hier nicht sehen kannst.");
             

  AddDetail( ({"sterne","stern"}), 
            "Sie strahlen und funkeln wunderschoen im Mondlicht.");
    

  AddDetail( ({"sternschnuppe"}),
	    "Du darfst Dir jetzt etwas wuenschen.");
      

  AddDetail( ({"ahnung"}),
	    "Du hast keine Ahnung, wie weit unter Dir der Boden ist.");
	  
  AddDetail( ({"mond"}),
	    "Der Mond leuchtet in einer Sichel in der Mitte des Raumes.");
	 
  AddDetail( ({"haus"}),
	    "Hier lebt Moon. Pass nur auf, dass Du sie nicht stoerst.");

  AddDetail( ({"mitte"}),
	    "Dort schwebt der Mond.");
         
  AddDetail( ({"kessel"}),
	    "Du wuerdest zu gern wissen, was sich darin befindet.");

  AddDetail( ({"rauch"}),
	    "Sanfter Rauch stroemt aus dem Kessel.");
	   
  
  AddDetail( ({"sternbilder","sternenbilder"}),
	    "Die Sternenbilder kannst Du zu diesem Zeitpunkt noch nicht "
	    "deuten.");

  AddDetail( ({"zeitpunkt","punkt","zeit"}),
	    "Den Zeitpunkt wirst Du ganz gewiss erfahren.");
   
  AddDetail( ({"universum","himmel"}),
	    "Du befindest Dich inmitten der unendlichen Weiten des Universums. "
	    "Um Dich herum befinden sich lauter wunderschoen leuchtende "
	    "Sterne.");

  AddDetail( ({"decke","waende","einzige","wand"}),
	    "Hier gibt es keine Waende, nur Sternenhimmel.");
	    
	    
  AddDetail( ({"sichel"}),
	   "Sie erinnert Dich irgendwie an die Sichel des Todes.");
	 

  AddDetail( ({"tod","todes"}),
	   "Der Tod hat eine Sense und keine Sichel mit! Aber er kommt Dich "
	   "sowieso bald holen, dann kannst Du Dich selbst davon uebezeugen.");
          

  AddDetail( ({"sense"}),
	   "Mit der Sense hackt er Dir dann den Kopf ab.");

  AddDetail( ({"kopf"}),
	   "Keine Angst. Du stirbst so schnell, dass Du keine Schmerzen spueren "
	   "wirst.");

  AddDetail( ({"schmerzen","schmerz"}),
	    "Greif eine der Hexen an, und sie wird Dir Schmerzen zufuegen. "
	    "So enormen Schmerz, dass es Dir den Verstand rauben wird.");

  AddDetail( ({"verstand"}),
	    "Den brauchst Du nicht mehr wenn Du tot bist.");
	           

  AddDetail( ({"angst"}),
	    "Keine Sorge, die Hexen greifen Dich auch an, obwohl Du ihnen "
	    "nichts tust. Muahahaha.");

  AddDetail( ({"hexen"}),
	    "Sie sind alle boese und lechzen nach Deinem Blut.");
	
  AddDetail( ({"blut"}),
	    "Massen von Deinem Blut werden ueber den Boden stroemen.");

  AddDetail( ({"sorge"}),
	    "Hast Du Angst um Deine mickrigen Erfahrungspunkte?");

  AddDetail( ({"erfahrungspunkte"}),
	    "Du wirst genug davon hier verlieren. Und auch viele Rauten.");

  AddDetail( ({"rauten"}),
	    "Och zittert Dein kleines Forscherherz schon?");

  AddDetail( ({"forscherherz"}),
	    "Ein einsamer Forscher hat hier nichts verloren, ausser danach "
	    "dann jede menge Rauten. Muahahaha");

  AddDetail( ({"forscher"}),
	    "Die Hexen freuen sich schon ueber Deine Leiche.");

  AddDetail( ({"leiche"}),
	    "Guck mal in den Spiegel!");

  AddDetail( ({"spiegel"}),
	    "Auf einmal taucht vor Dir ein Spiegel auf. Ueberleg es Dir, ob "
	    "ob Du in ihn hineinblickst.");

  AddDetail( ({"koreander"}),
	     "Riechen!.");

  AddDetail( ({"mondlicht","sternenhimmel"}),
	     "Es ist wunderschoen.");

  AddDetail( ({"hexe","aura","auras","weiten","raumes","sprache"}),
	     "Soviel forschen bringt nichts.");

 	     
  
  AddSmell(DEFAULT_SMELL, "Das Einzige, was Du hier riechen kannst, ist "
	    "der seltsame Geruch des Rauches, welcher aus dem Kessel stroemt.");
                        
 
  AddSmell( ({"geruch"}),
	   "Es riecht hier irgendwie nach Zitronenmelisse.");

  AddSmell( ({"zitronenmelisse"}),
	   "Oder ists doch der Geruch von Kardamom?");

  AddSmell( ({"kardamom"}),
	    "Du wirst doch wissen, dass Kardamom Koreander ist.");
 
 
  
  AddSound(DEFAULT_SOUND, "Du lauschst Auras wunderschoenem Gesang.");	
	   

  AddSound( ({"gesang"}),
	   "Aura singt wunderschoene Lieder in einer Dir unbekannten Sprache.");

  AddSound( ({"lieder"}),
	   "Ma innec in ochii tai, lalalala lei, plinge lumia dupa iei, "
	   "lalalalei, ieste un inger pa pamint.");  
  

//-----Details Ende-----
  
  AddExit("westen", "./whexe_28.lpc");
  AddItem(NPC "aura.lpc", REFRESH_DESTRUCT);
//-----KOMMANDOS--------
// AddCmd( ({ "deute", "deut" }), "c_deuten");
 AddCmd( ({ "blick", "blicke" }), "c_blicken");

 grundzustand();

 
}

reset()
{
   ::reset();
   grundzustand();
}

void grundzustand()
{
	landkarte_da = 1;
}

int c_blicken(string str)
{
    notify_fail(BS("Worein moechtest Du blicken?"));
    if(!(str == "in spiegel" || str == "in den spiegel"))
    {
      return 0;
    }
    write(BS("Du blickst in den Spiegel und bekommst einen Schreck. "
	     "Eine halbverweste Leiche guckt Dich grinsend an. Ihre Augen "
	     "sind zum Teil schon gefault und lauter kleine Wuermer kringeln "
	     "sich darin. In ihrem verwesten Mund tummeln sich allerdings schon "            "dicke weisse Maden und fressen das verfaulte Zahnfleisch. "
	     "Ihre Haare sind schon ziemlich schuetter, und lauter Spinnweben "
	     "befinden sich darin. Der Schreck faehrt Dir in die Glieder, als "
	     "Du merkst, dass Du diese Leiche bist."));
    tell_room(ENV(TP), TPN+" erschreckt sich fuerchterlich.\n", ({TP}));
    TP->AddHp(-30);
    return 1;
}

int c_deuten(string str)
{
   notify_fail(BS("Was moechtest Du hier denn deuten?"));
   if(!(str == "sternenbilder"))
   {
     return 0;
   }
   if(present("landkarte", ENV(TP)) || (!landkarte_da))
   {
     write(BS("Als Du die Sternenbilder deuten willst, bemerkst Du, dass es "
	      "eine Karte zu einem Dir unbekannten Ort ist, leider kannst Du "
	      "sie Dir nicht merken."));

     return 1;
    }
    else
    {
      write(BS("Du versuchst die Sternenbilder zu deuten und hast ploetzlich "
	       "eine Karte in Deinem Inventar. "));
      tell_room(ENV(TP), TPN+" versucht die Sterne zu deuten.\n", ({TP}));
      landkarte_da = 0;
//      AddItem("landkarte", REFRESH_NONE);

return 1;
     }
      
  }

 string _query_int_long()
 {
   if (present("hexe"))
   return BS(
	"Du befindest Dich hier mitten im Universum. Ueber Dir, unter Dir, "
        "ueberall ist wunderschoen klarer Sternenhimmel. Die Sterne funkeln "
        "und strahlen wundervoll. Ab und zu siehst Du eine Sternschnuppe an "
        "Dir vorbeiflitzen. In der Mitte des Raumes befindet sich der grosse, "
	"sichelfoermige Mond. Auf ihm sitzt die Hexe und deutet die vielen " 
	"Sternenbilder. Vor ihr steht ein kleiner Kessel, aus dem etwas "
	"Rauch stroemt. Du kannst das Haus im Westen wieder verlassen.");

   else
   return BS(
	"Du befindest Dich hier mitten im Universum. Ueber Dir, unter Dir, "
        "ueberall ist wunderschoen klarer Sternenhimmel. Die Sterne funkeln "
        "und strahlen wundervoll. Ab und zu siehst Du eine Sternschnuppe an "
        "Dir vorbeiflitzen. In der Mitte des Raumes befindet sich der grosse, "
	"sichelfoermige Mond. Die Hexe, die dort normalerweise sitzt, scheint " 
	"wohl nicht da zu sein. Ein Kessel steht im Raum, aus dem dampfender "
	"Rauch stroemt. Daraus schliesst Du, dass sie gewiss bald wieder kommt.");
 
  
}
   
