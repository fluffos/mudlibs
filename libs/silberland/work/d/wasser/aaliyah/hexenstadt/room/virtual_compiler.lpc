// Virtual Complier fuer Hexenbesen
// Feyaria@SilberLand

inherit "std/virtual/v_compiler";

#include "../def.h"
#include <v_compiler.h>

#define P_VALID_NAME "valid_name"

void create()
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM  );
  SetProp(P_STD_OBJECT, ROOM "besenr");
  SetProp(P_VALID_NAME, ({ "besenr"}) );
}


string Validate(string file)
{
  string path, who, name;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%s", name, who) == 2) &&
      (member(QueryProp(P_VALID_NAME), name) != -1) &&
      (who==lower_case(who)))
  {
    SetProp(P_STD_OBJECT, QueryProp(P_COMPILER_PATH) + name );
    return file;
  }
}


int CustomizeObject()
{
  string name,foo, who;

  name = ::CustomizeObject();
  if (!name || (sscanf(name,"%s:%s",foo,who)!=2))
    return 0;
  return 1;
}

