// von Aradia
// 012.10.2004
// 
// Raum meines Gesellenstueckes "Hexenstadt"
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include <moving.h>



void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einer kleinen Stadt");
  SetProp( P_INT_LONG,
	"Du befindest Dich hier auf einem kleinen Kieselweg, der vom "
	"Dorfplatz im Westen nach Osten ins Ungewisse fuehrt. Im Norden "
	"kannst Du ein finsteres Steinhaus betreten. Am Wegrand wachsen " 
	"hier vereinzelt ein paar Himbeerstraeucher. Der Himmel faerbt "
	"sich hier seltsam blutrot, und Du fuehlst Dich hier etwas unsicher. "
	"Ausserdem erkennst Du einige Geier, die ueber Dir ein paar Runden "
        "ziehen und auf ihre naechste Beute warten.");       
      

	
	
       
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  
  AddDetail( ({"boden","weg","kieselweg"}), 
            "Es ist ein einfacher Kieselweg. Zwischen den Kieselsteinen "
	    "kannst Du ein paar verwesende Stuecke Fleisch erkennen. "
	    "Du wendest Dich angewidert ab.");
             

  AddDetail( ({"stuecke","fleisch","stueck"}), 
            "Beim genaueren Hinsehen entpuppt sich das Fleisch als "
	    "Leichenteile.");
            
	 
  AddDetail( ({"leichenteile","weise"}),
	    "Scheint so, als wuerden hier Menschen auf grausame Weise "
	    "geschlachtet werden.");
      

  AddDetail( ({"kieselsteine","kieselstein","stein","steine"}),
	    "Sie sind von Blut getraenkt.");
	    	  
  
  AddDetail( ({"blut"}),
	    "Blut von Menschen, die hier grausam hingerichtet wurden.");
	 
  AddDetail( ({"menschen","wesen"}),
	    "Nicht nur Menschen, sondern auch andere Wesen des Silberlands "
	    "wurden hier grausam getoetet.");
	  

  AddDetail( ({"silberland"}),
	    "Es gibt viel schoenere Gegenden als hier, wieso musstest Du "
	    "ausgerechnet hierher kommen? Hier findest Du Deinen sicheren "
	    "Tod.");
         

  AddDetail( ({"gegenden","seicherlgegenden"}),
	    "Geh besser in Seicherlgegenden, wo Dir nichts passiert:).");

  AddDetail( ({"tod","leben","ende"}),
	    "Hier findet Dein Leben ein Ende. Bald wirst Du sterben und "
	    "auf Ewigkeit in der Hoelle schmoren. Und wenn Du wie ein Irrer "
	    "Kohlen schaufelst, wirst Du Dir wuenschen, diese Stadt nie "
	    "betreten zu haben.");
  
  AddDetail( ({"kohlen","hoelle","kohle"}),
	    "Du wirst wie ein Irrer Kohlen in der Hoelle schaufeln.");

  AddDetail( ({"irrer","du"}),
	    "Das bist natuerlich Du!");
  
  AddDetail( ({"ewigkeit"}),
	    "Hast Du Angst?");
            

  AddDetail( ({"steinhaus","norden","haus"}),
	    "Ein sehr finsteres Steinhaus befindet sich im Norden. "
	    "Wenn Du Dich traust, kannst Du es durch eine kleine Tuer "
	    "betreten. Hoffentlich wartet dort nicht das Unheil auf Dich. ");

 AddDetail( ({"tuer"}),
	    "Durch die Tuer gelangst Du in das finstere Haus.");

 AddDetail( ({"unheil"}),
	    "Nichts ist unheilvoller als der Tod.");

 AddDetail( ({"ungewisse","knick"}),
	    "Wegen dem Knick im Osten kannst Du nicht erkennen, wohin der "
	    "Weg fuehrt.");
 
 AddDetail( ({"augen","auge"}),
	    "Sie beobachten Dich.");

 AddDetail( ({"hinsehen"}),
	    "Du kannst nicht laenger hinsehen.");

 AddDetail( ({"stadt","traenen","geruch","traene"}),
	    "Der Geruch der Stadt treibt Dir Traenen in die Augen.");

 AddDetail( ({"runden","runde"}),
	    "Die Geier kreisen ueber Dir ihre Runden.");
 
 AddDetail( ({"phantasie"}),
	    "Du traeumst von heissen Eislutschern.");

 AddDetail( ({"eislutscher","eislutschern"}),
	    "Wenn Du an sowas glaubst, bist Du reif fuer die Klapsmuehle.");

 AddDetail( ({"klapsmuehle"}),
	    "Dieses Haus wurde extra fuer Dich gebaut und nennt sich auch "
	    "Irrenanstalt.");

 AddDetail( ({"irrenanstalt"}),
	    "Ein Oger ist der Leiter dort.");

 AddDetail( ({"oger","leiter"}),
	    "Du kennst ihn ganz bestimmt.");
	   
	    

  AddDetail( ({"geier","ueberreste"}),
	    "Die Geier freuen sich schon auf Deine jaemmerlichen, sterblichen "
	    "Ueberreste.");
	  
  AddDetail( ({"dorfplatz","westen"}),
	   "Im Westen gelangst Du wieder auf den Dorfplatz zurueck.");
	 	
	 

  AddDetail( ({"angst"}),
	   "Du zitterst.");
          

  AddDetail( ({"himmel","blutrot"}),
	   "Der Himmel ist wolkenlos und strahlt in einem tiefem Blutrot.");
	  

  AddDetail( ({"wolken","wolke"}),
	   "Die gibt es hier nur in Deiner Phantasie.");

  AddDetail( ({"hexenstadt"}),
	    "Da bist Du gerade.");
  
  AddDetail( ({"wegrand","wegesrand","himbeerstraeucher","straeucher","strauch"}),
	    "Ein paar Himbeerstraeucher wachsen am Wegesrand.");

  AddDetail( ({"zwerg","zwerges","andronicus"}),
	     "Der Zwerg koennte Andronicus sein.");

  AddDetail( ({"beute"}),
	     "Die Beute wirst Du sein!");
  
  AddDetail( ({"leichen","leiche"}),
	     "Verstuemmelte Leichen liegen ueberall am Boden.");
  
  AddSmell(DEFAULT_SMELL, "Du kannst den Geruch des Todes riechen. "
		  "Der Gestank verwesten Fleisches treibt Dir Traenen in "
		  "die Augen und Du musst Dich uebergeben.");
                        
 
  AddSmell( ({"geruch","todes","tod"}),
	   "Verbranntes Fleisch, verwestes Fleisch.. hier riecht es stark "
	   "nach totem Fleisch.");
  
  AddSmell( ({"fleisch","fleisches"}),
	    "Das kommt von den zerstuemmelten Leichen, die hier ueberall am "
	    "Boden liegen.");
	  
  AddSmell( ({"gestank"}),
	     "Es riecht bestialisch.");

  AddSmell( ({"leichen"}),
	     "Die Leichen stinken bestialisch. Sie erinnern irgendwie an den "
	     "Geruch eines toten, ungeduschten Zwerges.");
 
  
  AddSound(DEFAULT_SOUND, "Hier ist es totenstill.");
	
	   
  

//-----Details Ende-----
  
AddExit("westen", "./platz2.lpc");
AddExit("norden", "./hex_04.lpc");
AddExit("osten", "./whexe_27.lpc");

AddItem( NPC "nase", REFRESH_DESTRUCT);
}  
   
