/// 12.1.2005 
//  Aaliyah - Gesellenstueck
//  Teufelsauge

inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Teufelsauge");
  SetProp(P_LONG, 
    "Das Teufelauge ist eine Blume mit einem behaartem Stiel und einer grossen "
    "blutroten Bluete. Sie waechst in den Gaerten Satans und ihre Wirkung ist "
    "ungewiss. Darum sei es gut ueberlegt, ob man sie essen sollte.");
  SetProp(P_NAME, "Teufelsauge");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INFO, "Das Teufelsauge erweckt den Teufel in Dir.");
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 20000);
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"kraut", "teufelsauge","blume","auge"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:0, F_SOAK:1, F_POISON:14,
      F_MSG: "Du isst das Teufelsauge. Satan erscheint und zwinkert Dir zu.\n",
      F_MSG_ROOM: "isst eine Blume und die Umgebung verdunkelt sich.\n" ]));

}
  
  void BeimEssen(object pl)
  
 {
  if (pl->QueryProp(P_ALIGN) > -1000)
    pl->SetProp(P_ALIGN, pl->QueryProp(P_ALIGN) - 200);
 }

 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 3600); // 2 Tage
 }            
              
 	
