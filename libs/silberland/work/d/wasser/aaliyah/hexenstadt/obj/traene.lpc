// Traene

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine versteinerte Traene");
  SetProp(P_LONG, 
    "Du haeltst eine Traene in Deinen Haenden. Sie ist seltsamerweise zu "
    "einem Kristall erstarrt. In der Mitte der Traene kannst Du ein kleines "
    "pulsierendes Herz erkennen. Es ist das Herz der Person, die Dir diese "
    "Traene schenkte und es schlaegt nur fuer Dich.");
  SetProp(P_NAME, "Traene");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"traene","morrighan_traene"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
}  
   
