// Drachenkralle

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Drachenkralle");
  SetProp(P_LONG, 
    "Eine grosse Kralle des Eisdrachens. Irgendeinen Sinn wird sie wohl "
    "haben. Es liegt an Dir, ihn heraus zu finden.");
  SetProp(P_NAME, "Drachenkralle");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"drachenkralle","kralle","HMO_Drachenkralle"}) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_HORN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  
}  
   
