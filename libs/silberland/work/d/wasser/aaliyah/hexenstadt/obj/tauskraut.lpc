//  Aaliyah - Gesellenstueck
//  TAUSENDGUELDENKRAUT

inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Tausendgueldenkraut");
  SetProp(P_LONG, 
    "Das Tausendgueldenkraut hat in der Laenge reich verzweigte Staengel mit "
    "vielen kleinen Blaettern. Einige zarte rosa Blueten befinden sich darauf.");
  SetProp(P_NAME, "Tausendgueldenkraut");
  SetProp(P_INFO, "Das Tausendgueldenkraut hat eine heilende Wirkung.");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 9000);
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"kraut", "tausendgueldenkraut"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:200, F_SOAK:40,
      F_MSG: "Das Tausendgueldenkraut schmeckt leicht suesslich.\n",
      F_MSG_ROOM: "isst ein Tausendgueldenkraut.\n" ]));

}
void init()
{
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 3600); // 2 Tage
}            
              
  

	
