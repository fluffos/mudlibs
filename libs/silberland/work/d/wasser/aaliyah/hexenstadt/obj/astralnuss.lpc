/// 10.1.2005 
//  Aaliyah - Gesellenstueck
//  Astralnuss

inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Astralnuss");
  SetProp(P_LONG, 
    "Die Astralnuss ist ca. 5 cm gross und leuchtet in magisch violettem "
    "Licht. Da Du so eine Nuss noch nie gesehen hast ueberlegst Du Dir, "
    "ob es ratsam ist sie zu essen.");
  SetProp(P_NAME, "Astralnuss");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20 );
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"nuss", "astralnuss"}));
  SetProp(P_FOOD_INFO, ([F_HEAL: ({80,50}), F_SOAK:20,
      F_MSG: "Du knackst die Astralnuss und fuehlst Dich geheilt.\n",
      F_MSG_ROOM: "knackt eine Astralnuss.\n" ]));

}
  

void init()
{
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 3600); // 2 Tage
}            
              
	
