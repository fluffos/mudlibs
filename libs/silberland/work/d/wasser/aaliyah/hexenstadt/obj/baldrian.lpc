//  Aaliyah - Gesellenstueck
//  Baldrian

inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Baldrian");
  SetProp(P_LONG, 
    "Ein Bueschel blauer Blueten mit einigen gruenen Blaettern. Du hast "
    "Baldrian normalerweise anders in Erinnerung, aber hier auf der Insel "
    "wundert Dich nichts mehr.");
  SetProp(P_NAME, "Baldrian");
  SetProp(P_INFO, "Der Baldrian beruhigt Deinen Koerper und Deine Seele.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1500);
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"kraut", "baldrian"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:0, F_SOAK:15,
      F_MSG: "Du kaust etwas Baldrian und fuehlst Dich herrlich beruhigt.\n",
      F_MSG_ROOM: "stopft sich Baldrian in den Mund.\n" ]));

}

 void BeimEssen(object pl)

 {
  CLONE(OBJ "vorsicht" ,TP);
 }
  
void init()
{
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 3600); // 2 Tage
}            
              
  

	
