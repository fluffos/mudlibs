/// 12.1.2005 
//  Aaliyah - Gesellenstueck
//  Sandelholz

inherit "std/thing";


#include "../def.h"


int sandelholz_brennt = 0;
void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Sandelholz");
  SetProp(P_LONG, 
    "Du hast ein paar Raeucherstaebchen Sandelholz in den Haenden. Sie duften "
    "himmlisch. Sie eignen sich gewiss perfekt fuer ein Ritual. Zumindest "
    "werden sie von den Hexen dafuer verwendet.");
  SetProp(P_NAME, "Sandelholz","raeucherstaebchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"sandelholz", "raeucherstaebchen"}));

  
//---------KOMMANDOS-------  

  AddCmd( ({"zuende","zuend"}), "c_anzuenden");
      
}

 int c_anzuenden(string str)
 {	

	 notify_fail(BS("Was moechtest Du denn anzuenden?"));
    if(!(str == "sandelholz an" || str == "raeucherstaebchen an"))
   
   {
     return 0;
   }
   if(sandelholz_brennt) 
   {	   
   write("Aber das Sandelholz brennt doch schon.\n");
    return -1;
   }

 else
   {
     write(BS("Du zuendest mit einem kleinen Feuerball das Sandelholz an. "
	       "Es duftet herrlich und huellt den Raum in leichten Nebel. "
	       "Ploetzlich erkennst Du im Nebel eine Gestalt. Sie warnt Dich, "
	       "die Insel zu verlassen, und verschwindet wieder so ploetzlich, "
	       "wie sie gekommen ist."));
      tell_room(ENV(TP), TPN+" zuendet das Sandelholz an und der Raum huellt "                              "sich in leichten duftenden Nebel.\n", ({TP}));
      sandelholz_brennt = 1;
    SetProp(P_SHORT, "Sandelholz (duftend) (glimmend)");
    SetProp(P_LONG, 
        "Das Sandelholz glimmt in Deinen Haenden und verstroemt wunderbar "
  	"duftenden Rauch. Schade, dass es nicht ewig brennt.");
    
    SetProp(P_NODROP, "Du wirst Doch nicht ein gluehendes Raeucherstaebchen "                        "wegwerfen und einen Waldbrand verursachen?!!\n");
    call_out ("duften", 4);
    return 1;

     }
  }


  void duften()
{
  tell_room(ENV(TP), "Das Sandelholz duftet.\n");
  sandelholz_brennt++;
   if(sandelholz_brennt > 10)
  call_out ("ende", 4);

   else

  call_out ("duften", 10);

}
  void ende()

 {
 tell_room(ENV(TP), "Das Sandelholz verglimmt.\n");

 remove();

 }
