//  Aaliyah - Gesellenstueck
//  Melisse

inherit "std/food";

#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Melisse");
  SetProp(P_LONG, 
    "Einige getrocknete Blaetter Melisse. Sie duften leicht nach Zitrone.");
  SetProp(P_NAME, "Melisse");
  SetProp(P_INFO, "Die Melisse ist DER Schluessel.");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 1000);
  SetProp(P_SMELL, "Die Melisse duftet herrlich frisch nach Zitrone.\n");
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"kraut", "melisse"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:0, F_SOAK:1,
      F_MSG: "Du isst die Blaetter und gebracht hat es Dir nichts.\n",
      F_MSG_ROOM: "kaut auf ein paar Blaettern Melisse herum.\n" ]));

}
  

	
