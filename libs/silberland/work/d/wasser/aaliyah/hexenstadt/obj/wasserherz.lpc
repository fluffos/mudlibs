// Wasserherz

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Alvaros Wasserherz");
  SetProp(P_LONG, 
    "Das Herz schimmert in tiefem Blau. Es besteht vollkommen aus Wasser und "
    "fuehlt sich nass an. Wenn Du genau an dem Herz lauschst, kannst Du das "
    "Rauschen des Ozean hoeren.");
  SetProp(P_NAME, "Alvaros Wasserherz");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"herz","wasserherz","alvaros wasserherz","HMO_Wasserherz"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2000);
  SetProp(P_MATERIAL, ([MAT_WATER:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SOUND, "Leise hoerst Du das Rauschen des Ozeans");
}  
   
