/// 27.1.2005 
//  Aaliyah - Gesellenstueck
//  Goldenes Buch

inherit "std/thing";


#include "../def.h"

int buchseite_da = 1;
void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein goldenes Buch");
  SetProp(P_LONG, 
    "Der Einband des Buches besteht aus purem Gold. Auf der Vorderseite "
    "befindet sich ein Relief aus zwei verschlungenen Schlangen. Das Buch "
    "erweckt Deine Neugier, und Du ueberlegst, ob Du es lesen solltest.");
  SetProp(P_NAME, "goldenes Buch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 500);
  SetProp(P_ARTICLE, 1);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_GOLD:20,MAT_PAPER:80]));
  AddId(({"buch", "goldenes buch","\nviolet_buch"}));

  AddDetail( ({"relief"}),
    "Zwei ineinander verschlungene Schlangen bilden ein Relief. Du koenntest "
    "Dir vorstellen, dass das Relief auch ein schicker Kettenanhaenger waere.");

//----KOMMANDOS------

   AddCmd( ({ "lies", "lese" }), "c_lesen");

 }

int c_lesen(string str)
{
   notify_fail(BS("Was moechtest Du denn lesen?"));
   if(!(str == "buch"))
   {
     return 0;
   }
     if(present("buchseite", ENV(TP)) 	|| (!buchseite_da))
   {
   write(BS("Du oeffnest das Buch und entdeckst eine Seite mit der Aufschrift "
              "'Wiederbelebungszauber'. Leider ist fast die ganze Seite "
	      "herausgerissen, sodass Du die Formel nicht lesen kannst."));
	 
     return -1;
    }
    else
    {
    write(BS("Vorsichtig oeffnest Du das Buch. Du erkennst viele Bilder von "
            "allen moeglichen Sachen. Da sind Kraeuter, Frauen, Kelche und "
	    "viele andere Dinge darin abgebildet. Eine Seite erweckt Deine "
	    "Aufmerksamkeit. Die Ueberschrift lautet: 'Wiederbelebungszauber'. "
	    "Du denkst, dass Du sie vielleicht noch brauchen koenntest, und "
            "reisst sie aus dem Buch."));
        tell_room(ENV(TP), TPN+" reisst eine Seite aus einem Buch.\n", ({TP}));
      buchseite_da = 0;
      CLONE(OBJ "buchseite.lpc", TP);
      return 1;
    }
} 

	






















  
