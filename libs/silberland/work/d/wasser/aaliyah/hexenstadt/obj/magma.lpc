// Magma

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Magma");
  SetProp(P_LONG, 
    "Das Lava glueht feuerrot und verbrennt Dir langsam Deine Haende. Darum "
    "solltest Du Dir ueberlegen, was Du damit machen kannst.");
  SetProp(P_NAME, "Magma");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"magma","HMO_Magma"}) );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_FIRE:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  
}  
void init()
{
  ::init();
  if (TP && interactive(TP))
  {
    tell_object(TP, "Das Magma verbrennt Deine Finger.\n");
    TP->AddHp(-10);
  }
}
   
