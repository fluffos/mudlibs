// Prinzenherz

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Sidhartas Prinzenherz");
  SetProp(P_LONG, 
    "Das Herz schimmert in eisigem Rosa. Es pulsiert noch leicht und fuehlt "
    "sich eisig kalt an. Es ist von ein paar Adern durchzogen, in denen man "
    "man das adelige blaue Blut fliessen laesst.");
  SetProp(P_NAME, "Sidhartas Prinzenherz");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"herz","prinzenherz","sidhartas prinzenherz","HMO_Prinzenherz"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2000);
  SetProp(P_MATERIAL, ([MAT_ICE:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 0);
}  
   
