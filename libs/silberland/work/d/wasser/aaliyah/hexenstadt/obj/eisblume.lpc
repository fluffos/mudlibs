// Eisblume

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Eisblume");
  SetProp(P_LONG, 
    "Eine wunderschoene filigrane Eisblume. Ihr zarter Bluetenkelch hat die "
    "Form einer Rose. Die herzfoermigen Bluetenblaetter bestehen aus lauter "
    "aneinander gereihten Eiskristallen und schimmern leicht eisblau. Dieses "
    "maerchenhafte Gebilde aus purem Eis wurde von Shahin, der Eishexe "
    "erschaffen und glitzert in Deinen Haenden.");
  SetProp(P_NAME, "Eisblume");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"eisblume","blume","HMO_Eisblume"}) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_ICE:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);

  AddDetail( ({"bluetenkelch","form","rose"}),
	 "Der Bluetenkelch hat die Form einer Rose und sieht sehr zerbrechlich "         "aus.");

  AddDetail( ({"bluetenblaetter","bluetenblatt"}),
	"Die Bluetenblaetter sind herzfoermig und bestehen aus lauter kleinen "
	"Eiskristallen.");

  AddDetail( ({"eiskristalle","eiskristallen","eiskristall"}),
	"Viele kleine Eiskristalle bilden diese Blume.");

  AddDetail( ({"gebilde","welt"}),
	"Die Blume ist ein wunderschoenes Gebilde. Sie ist so maerchenhaft, "
	"dass man denken koennte, sie stammt aus einer anderen Welt.");
  
  AddDetail( ({"shahin","eishexe"}),
	"Shahin ist eher eine Eisprinzessin.");

  AddDetail( ({"eisprinzessin"}),
	"Bist Du ein Prinz? So suche sie auf und lass ihr Herz schmelzen.");
}  
   
