//  Aaliyah - Gesellenstueck
//  Hexenkelch

inherit "std/container";


#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein verzierter Hexenkelch");
  SetProp(P_LONG, 
    "Dieser wunderschoene Hexenkelch besteht aus purem Silber. Er ist mit "
    "lauter bunten Edelsteinen verziert und einige magische Symbole wurden "
    "eingeritzt. Weiters befindet sich an der Vorderseite ein goldenes "
    "Relief in Form eines Pentagrammes. Er eignet sich hervorragend fuer "
    "Rituale und andere magische Taetigkeiten.");
  SetProp(P_NAME, "Hexenkelch");
  SetProp(P_GENDER, MALE);
  SetProp(P_MAX_WEIGHT, 1000);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME_ADJ, "verziert");
  SetProp(P_MATERIAL, MAT_SILVER);
  AddId(({"kelch", "hexenkelch"}));
  

}
  

	
