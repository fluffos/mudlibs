// Kometenstaub

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Kometenstaub");
  SetProp(P_LONG, 
    "Eine Handvoll Kometenstaub schimmert magisch in Deinen Haenden. Er "
    "ist feinkoernig und glitzert graeulich weiss.");
  SetProp(P_NAME, "Kometenstaub");
  SetProp(P_GENDER, MALE); 
  AddId( ({"staub","kometenstaub","HMO_Kometenstaub"}) );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);

  
}  
   
