//  Aaliyah - Gesellenstueck
//  Stofffetzen

inherit "std/thing";


#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Stofffetzen");
  SetProp(P_LONG, 
    "Ein kleines Stueck braunen Stoffes. Er stammt sicher von dem Umhang "
    "eines Kriegers. Das verkrustete Blut auf ihm bildet einen Schriftzug.");
  SetProp(P_NAME, "Stofffetzen");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 30);
  SetProp(P_ARTICLE, 1);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, MAT_CLOTH);
  AddId(({"fetzen", "stofffetzen"}));

  AddDetail( ({"schriftzug"}),
    "Das Blut bildet einen krakeligen Schriftzug. Du liest muehsam:\n "
    "'Kehre um, bevor Dein Blut an der Hexen Finger klebt'.");
 

}
  

	
