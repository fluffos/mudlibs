// Goldenes Fliess

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Goldenes Vlies");
  SetProp(P_LONG, 
    "Das goldene Vlies besteht aus vielen kleinen goldenen Faeden, die sich "
    "zu einem Buendel verworren haben. Es ist sicher wertvoll und sollte "
    "nicht leichtfertig benuetzt werden.");
  SetProp(P_NAME, "Goldenes Vlies");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"vlies","goldenes vlies","HMO_Goldenes Vlies"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2000);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 0);
}  
   
