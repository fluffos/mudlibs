//  Aaliyah - Gesellenstueck
//  Jasmin

inherit "std/food";

#include <food.h>
#include "../def.h"

 string smell_func();
 int healed = 0;

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Jasminblueten");
  SetProp(P_LONG, 
    "Ein paar weisse Jasminblueten. Sie duften himmlisch. Sie sind noch ganz "
    "frisch, anscheinend wurden sie gerade erst gepflueckt. Oder welken sie "
    "einfach nur nie?");
  SetProp(P_NAME, "Jasminblueten");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_PLURAL, 1);
  AddId(({"kraut", "blueten","jasminblueten"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:1, F_SOAK:1,
      F_MSG: "Du isst die Blueten und juhu sie haben Dich +1 geheilt! "
             "Haettest Du an ihnen gerochen, haette es Dir mehr gebracht.\n",
      F_MSG_ROOM: "isst ein paar Jasminblueten und grummelt.\n" ]));


  SetProp(P_SMELL, #'smell_func);
}
  string smell_func()
{ 
  if (!healed)
  { 
    healed = 1;
    this_player()->heal_self(5);
    call_out("remove",0,1);
    return "Die Jasminblueten duften so himmlisch, dass Du geheilt wirst.\n";
  }
  remove(1);
  return "Du riechst nichts, weil die Jasminblueten nicht mehr da sind.\n";
}

	
