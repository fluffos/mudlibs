/// 10.1.2005 
//  Aaliyah - Gesellenstueck
//  Johanniskraut

inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Johanniskraut");
  SetProp(P_LONG, 
    "Zarte gruene Stengel, mit zarten gruenen Blaettern. Einige gelbe Blueten "
    "befinden sich darauf.");
  SetProp(P_NAME, "Johanniskraut");
  SetProp(P_INFO, "Das Johanniskraut hat eine heilende Wirkung.");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10000 );
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"kraut", "johanniskraut"}));
  SetProp(P_FOOD_INFO, ([F_HEAL: ({140,100}), F_SOAK:20,
      F_MSG: "Du isst das Johanniskraut und fuehlst Dich geheilt.\n",
      F_MSG_ROOM: "isst ein Johanniskraut.\n" ]));

}
  
void init()
{
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 3600); // 2 Tage
}            
              

	
