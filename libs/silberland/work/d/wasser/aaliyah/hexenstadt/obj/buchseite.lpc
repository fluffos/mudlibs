/// 27.1.2005 
//  Aaliyah - Gesellenstueck
//  Buchseite

inherit "std/thing";


#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Eine Buchseite");
  SetProp(P_LONG, 
    "Eine vergilbte Buchseite mit vielen goldenen Verzierungen. Sie wurde "
    "aus einem Buch herausgerissen. Du erkennst darauf eine seltsame Formel.");
  SetProp(P_NAME, "Buchseite");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 5);
  SetProp(P_ARTICLE, 1);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_GOLD:20,MAT_PAPER:80]));
  AddId(({"seite", "buchseite"}));

  AddReadDetail( ({"formel"}),
    "~*~Wiederbelebungszauber~*~.\n"
    "*************************.\n"
    "Man benoetige:.\n"
    "- Ein Tausendgueldenkraut.\n"
    "- Einen Alraun.\n"
    "- Etwas Schafgarbe.\n"
    "- Etwas Kometenstaub.\n"
    "- Ein Dustyveilchen.\n"
    "- Ein Sinneskraut.\n"
    "- Einen Regenbogenfisch.\n"
    "- Einen Diamant.\n"
    "- Einen Fliegenpilz.\n"
    "- Etwas Immortelle.\n"
    "- Etwas Drachenblut.\n"
    "- Eine Birne.\n"
    "**************************.\n"
    "Man suche sich einen geeigneten Platz fuer dieses magische Ritual. "
    "Danach erschaffe man sich eine mystische Aura, indem man drei Kerzen und "
    "eine Fackel anzuendet. Und zwar eine rote, eine weisse und eine schwarze "
    "Kerze. Man nehme einen Kessel und lege alle Zutaten in den Kessel. Danach "
    "nehme man einen Athame und ziehe rund um sich selbst einen magischen "
    "Kreis. Man murmle die Formel: 'Corpus wicca e spiritus mortes' und zuende "    "alles im Kessel an. Die Zutaten verschmelzen zu einer Paste, die man in "
    "das Fleisch des Leichnams schmieren muss. Diese Zeremonie muss bei "
    "Vollmond vollbracht werden.");
 

}
  

	
