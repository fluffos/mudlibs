// Mondstein

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Mondstein");
  SetProp(P_LONG, 
    "Der Mondstein hat die Form eines Sternes. Er ist grau und hat lauter "
    "kleine glitzernde Splitter. Er schimmert leicht magisch.");
  SetProp(P_NAME, "Mondstein");
  SetProp(P_GENDER, MALE); 
  AddId( ({"mondstein","stein","HMO_Mondstein"}) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_STONE:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  
}  
   
