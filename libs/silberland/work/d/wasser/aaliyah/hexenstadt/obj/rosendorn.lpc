// Rosendorn

inherit "std/thing";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Rosendorn");
  SetProp(P_LONG, 
    "Ein einfacher Dorn einer weissen Rose. Er ist klein, aber scharf und "
    "wurde vom Stengel abgebrochen.");
  SetProp(P_NAME, "Rosendorn");
  SetProp(P_GENDER, MALE); 
  AddId( ({"rosendorn","dorn","HMO_Rosendorn"}) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_PLANT:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  
}  
void init()
{
  ::init();
  if (TP && interactive(TP))
  {
    tell_object(TP, "Du stichst Dich am Rosendorn.\n");
    TP->AddHp(-10);
  }
}
   
