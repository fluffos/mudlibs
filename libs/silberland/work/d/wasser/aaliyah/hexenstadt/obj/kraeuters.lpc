//  Aaliyah - Gesellenstueck
//  Kraeutersaeckchen

inherit "std/thing";


#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Ein Kraeutersaeckchen");
  SetProp(P_LONG, 
    "Ein kleines Kraeutersaeckchen mit den Kraeutern aller Art gefuellt. "
    "Welche genau in dem Saeckchen sind, kannst Du nicht beurteilen, es sei "
    "denn, Du wuerdest es zerstoeren. Aber es waere schade um den violetten "
    "Samt, aus dem es gemacht wurde.");
  SetProp(P_NAME, "Kraeutersaeckchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_PLANT:80, MAT_CLOTH:20]) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_SMELL, "Das Kraeutersaeckchen riecht wuerzig.\n");
  AddId(({"saeckchen","kraeutersaeckchen"}));
 
}
  

	
