// Vorsichtobjekt

inherit "std/thing";

#include "../def.h"

int wimpy;

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, 0);
  AddId( "VORSICHT");
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_NEVERDROP, 1);

  }

 void init()

{
 ::init();

 if (MENV && interactive(MENV))
 {
  wimpy = MENV->QueryProp(P_WIMPY);
  MENV->Set(P_WIMPY, symbol_function("vorsicht", this_object()),
  F_QUERY_METHOD);
  call_out ("remove", 300);
		  
 }

}
 int vorsicht()

 {
   return wimpy;

 }
  
 	
 
 
 
  
  
  
  
   
