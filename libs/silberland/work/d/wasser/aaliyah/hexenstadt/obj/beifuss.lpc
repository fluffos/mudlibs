//  Aaliyah - Gesellenstueck
//  Beifuss

inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Beifuss");
  SetProp(P_LONG, 
    "Ein kleines Straeusschen Beifuss. An den duennen Stengeln befinden sich "
    "noch einige kleine Blueten. Ob man es essen kann, ist ungewiss.");
  SetProp(P_NAME, "Beifuss");
  SetProp(P_INFO, "Der Beifuss staerkt Deine magischen Kraefte.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 4000);
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"kraut", "beifuss"}));
  SetProp(P_FOOD_INFO, ([F_HEAL: ({0,200}), F_SOAK:20,
      F_MSG: "Du isst den Beifuss und fuehlst Dich von Magie durchflutet.\n",
      F_MSG_ROOM: "isst etwas Beifuss.\n" ]));

}
void init()
{
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 3600); // 2 Tage
}            
              
  

	
