// Gluehwuermchen

inherit "std/thing";

#include "../def.h"
#include <properties.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein leuchtendes Gluehwuermchen");
  SetProp(P_LONG, 
    "Das leuchtende Gluehwuermchen ist nicht groesser als ein Daumen. Es "
    "spendet Dir Licht, aber nur fuer eine gewisse Zeit.");
  SetProp(P_NAME, "Gluehwuermchen");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"gluehwuermchen","wuermchen"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_LIGHT:100]));
  SetProp(P_LIGHT, 2);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  call_out("remove", 600);
 
} 
 varargs int remove(int silent)

{
  if (!silent && MENV)
  {
    if (MENV->id("Raum") || MENV->id("Transporter"))
      tell_room(MENV,
        "Das Gluehwuermchen verglueht.\n");
    else  
      tell_object(MENV,
        "Das Gluehwuermchen verglueht.\n");
  }
  ::remove(silent);
}

   
