// Perle

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine schimmernde Perle");
  SetProp(P_LONG, 
    "Diese Perle stammt aus den Tiefen des Ozeans. Sie ist herzfoermig und "
    "schimmert in allen moeglichen Farben, wenn man sie ins Sonnenlicht haelt. "
    "Sie eignet sich gewiss als wunderschoener Anhaenger fuer eine Kette.");
  SetProp(P_NAME, "Perle");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"perle","calluna_perle","HMO_Perle"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_PEARL:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
}  
   
