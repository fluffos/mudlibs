// Wolldecke

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine bluetenweisse Wolldecke");
  SetProp(P_LONG, 
    "Eine flauschige, bluetenweisse Wolldecke. Sie spendet gewiss an kalten "
    "Winterabenden eine wohlige Waerme. Die Decke sieht so flauschig aus, dass "
    "Du Dich am liebsten sofort mit ihr vor dem Kamin kuscheln wuerdest.");
  SetProp(P_NAME, "Wolldecke");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"decke","wolldecke"}) );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 1000);
  SetProp(P_MATERIAL, ([MAT_WOOL:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
}  
   
