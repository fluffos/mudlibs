/// 12.1.2005 
//  Aaliyah - Gesellenstueck
//  Schafgarbe

inherit "std/food";

#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Schafgarbe");
  SetProp(P_LONG, 
    "Ein kleiner Bund mit getrockneter Schafgarbe. Sie wurde sorgfaeltig "
    "getrocknet und ordentlich mit einem lila Band zusammengebunden. Sie "
    "duftet irgendwie nach frischem Heu.");
  SetProp(P_NAME, "Schafgarbe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_PLURAL, 0);
  SetProp(P_SMELL, "Die Schafgarbe duftet nach frischem Heu.\n");
  AddId(({"kraut", "bund","schafgarbe"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:-50, F_SOAK:1,
      F_MSG: "Du knabberst an der Schafgarbe herum und es passiert nichts. "
             "Jetzt hast Du Dein Geld umsonst ausgegeben, denn dieses Kraut "
	     "ist nicht zum Essen gedacht.\n",
      F_MSG_ROOM: "knabbert etwas Schafgarbe.\n" ]));

}
  

	
