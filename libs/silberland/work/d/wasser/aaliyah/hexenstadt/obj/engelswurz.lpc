/// 10.1.2005 
//  Aaliyah - Gesellenstueck
//  Engelswurz

inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Engelswurz");
  SetProp(P_LONG, 
    "Der Engelswurz ist ein leuchtend goldenes Kraut. Viele goldene zarte "
    "Wurzeln haben sich zu einer Art Bluete gebildet.");
  SetProp(P_NAME, "Engelswurz");
  SetProp(P_INFO, "Der Engelswurz macht Deine Gesinnung besser.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, MAT_PLANT);
  AddId(({"kraut", "engelswurz","wurz"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:50, F_SOAK:10,
      F_MSG: "Du isst den Engelswurz und ein goettliches Gefuehl uebermannt "
             "Dich. Kurzfristig wirst Du von hellem Licht umgeben.\n",
      F_MSG_ROOM: "isst den Engelswurz und erstrahlt in goettlichem Licht.\n" ]));

}

 void BeimEssen(object pl)
  
 {
  if (pl->QueryProp(P_ALIGN) < 1000)
    pl->SetProp(P_ALIGN, pl->QueryProp(P_ALIGN) + 50);
 }
  
void init()
{
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 3600); // 2 Tage
}            
              

	
