// Kerze

inherit "std/lightsource";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <lightsource.h>



create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine rote Kerze");
  SetProp(P_LONG, 
    "Eine einfache rote Kerze. Einige magische Symbole sind in das Wachs "
    "eingeritzt. Sie wird von den Hexen bei ihren Ritualen eingesetzt. Du "
    "kannst sie anzuenden und wieder loeschen.");
  SetProp(P_NAME, "Kerze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kerze"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([MAT_WAX:100]));
  SetProp(P_NAME_ADJ, "rot");
  AddAdjective( ({"rote"}) );
  SetProp(P_NOBUY, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_FUEL, 1500);
  SetProp(P_ARTICLE, 1);
  SetProp(P_LIGHTDESC,
      ({ "glimmend","flackernd","leicht flackernd","brennend",
         "hell lodernd","frisch angezuendet" }) );
 
}  
   
