/// 12.1.2005 
//  Aaliyah - Gesellenstueck
//  Mhyrre

inherit "std/food";
#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Mhyrre");
  SetProp(P_LONG, 
    "Ein frischer Bund Mhyrre. Ihre rosa Blueten sind vollkommen aufgeblueht "
    "und sehen irgendwie huebsch aus. Die Mhyrre hat ein wuerziges Aroma und "
    "wird von den Hexen fuer Raeucherrituale verwendet.");
  SetProp(P_NAME, "Mhyrre");
  SetProp(P_INFO, "Du wirst Mhyrre brauchen wenn die Zeit reif ist.");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_SMELL, "Die Mhyrre riecht leicht wuerzig.\n");
  AddId(({"kraut", "bund","mhyrre"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:0, F_SOAK:1,
      F_MSG: "Du isst etwas Mhyrre und Dir wird etwas schwindelig. Die Mhyrre "
             "ist nicht zum Essen gedacht und Du fuehlst Dich wie ein kleines "
	     "Kind, das alles in den Mund steckt.\n",
      F_MSG_ROOM: "steckt wie ein kleines Kind alles in den Mund.\n" ]));

 }
  
 void init()
 {
  ::init();
  if (TP && interactive(TP) && query_decay() == -1)
    start_decay(172800, 3600); // 2 Tage
 }            

	
