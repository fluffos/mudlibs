/// 12.1.2005 
//  Aaliyah - Gesellenstueck
//  Wermut

inherit "std/food";

#include <food.h>
#include "../def.h"

void create()
{
  if( !is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT, "Wermut");
  SetProp(P_LONG, 
    "Ein kleines Straeusschen Wermut. Er wird meistens fuer bestimmte Rituale "
    "genutzt. In einem Moerser zerstampft und mit Beigabe von gewissen anderen "
    "Kraeutern kann man aus ihm auch eine gute Heilpaste herstellen.");
  SetProp(P_NAME, "Wermut");
  SetProp(P_INFO, "Was man mit Wermut macht, musst Du wohl noch herausfinden.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 3000);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_SMELL, "Der Wermut riecht leicht wuerzig.\n");
  AddId(({"kraut", "straeuschen","wermut"}));
  SetProp(P_FOOD_INFO, ([F_HEAL:0, F_SOAK:1,
      F_MSG: "Du beisst in den Wermut und schmeckst den bitteren Geschmack. "
             "Du fragst Dich, ob es noetig ist, alles in den Mund zu stecken, " 
	     "was Du zwischen die Finger bekommst.\n",
      F_MSG_ROOM: "beisst in den Wermut.\n" ]));

}
  

	
