//Aaliyah

//Myrica die Hexe der Magie

inherit "std/npc";
inherit "std/npc/spells";




#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Myrica o O (Oh ein neues Opfer).\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Myrica, die Hexe der Mystik");
  SetProp(P_LONG,
    "Myrica ist eine sehr kleine zarte Hexe. Ihre bodenlangen lila Haare " 
    "funkeln magisch. In ihren blasslila Augen funkeln zwei Sterne. Ihr "
    "niedliches Aussehen hat schon so manchen Krieger getaeuscht. Sie ist " 
    "die Hueterin der Mystik und scheut nicht, sie zu benutzen. Man munkelt "
    "das sie aus reiner Willkuer toetet und es geniesst, ihre Opfer sterben "
    "zu sehen.");
    
  SetProp(P_NAME, ({"Myrica, die Hexe der Mystik",
                  "Myrica, der Hexe der Mystik", 
                  "Myrica, der Hexe der Mystik",
                  "Myrica, die Hexe der Mystik"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"myrica", "hexe", "mystikhexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("myrica");

  create_default_npc(35,3000);
  SetProp(P_HANDS, ({" mit einer Flut von Mystik ",350,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 38000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.2, DT_WATER:  0.4, DT_AIR:   -0.3, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.0, DT_POISON: 0.3, DT_TERROR: 0.1,
      DT_HOLY:      0.2, DT_UNHOLY:    -1.0, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_SLASH:     0.1, DT_BLUDGEON: 0.1, DT_PIERCE: 0.1]) );

  SetProp(P_MSGIN, "entsteht aus einem mystischen Wirbel");
  SetProp(P_MSGOUT, "wirbelt magisch");
  SetProp(P_MMSGIN, "materialisiert sich aus mystischen Pixeln");
  SetProp(P_MMSGOUT, "verpufft im mystischen Nebel");
  SetProp(P_DIE_MSG,  " verpufft in mystischen Nebel.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich werde Dich als Geist verfolgen.");
  SetProp(P_KILL_NAME, "Myrica, die Hexe der Mystik");
  SetProp(P_KILL_MSG, "MUAHAHA Der Teufel sei Dir gnaedig!");

  AddInfo(DEFAULT_INFO, "Myrica schenkt Dir keine Beachtung.");
  
 
  AddInfo( ({"aradia"}),
    "Aradia ist die Schutzgoettin der Hexen","sagt: ");
  
  AddInfo( ({"tod"}),
     "Wir werden Euch toeten!","sagt: ");
  
  AddInfo( ({"paladine","paladin","paladin"}),
     "Ayla hat noch zu selten geblutet.","sagt: ");
  
  AddInfo( ({"ayla"}),
     "In der Walpurgisnacht wird sie sterben.","sagt: ");
    
  AddInfo( ({"mystik"}),
      "Die Mystik ist mein Leben und Dein Tod","sagt: ");
  
  AddInfo( ({"hexen"}),
      "Ich bin die Maechtigste unter Ihnen. Hekate gab mir die groesste "
      "Macht, nur wissen es die Anderen nicht.","erklaert: ");
  
  AddInfo( ({"hekate"}),
      "Hekate hat ihre Macht auf uns aufgeteilt, bevor sie verschwand.","sagt: ");
  
  AddInfo( ({"macht"}),
      "Meine Macht kennt keine Grenzen.","sagt: ");
  
   

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Myrica winkt dankend ab.\n" }) );

  SetProp(P_SPELLRATE, 95);
  
  AddDefaultSpell(3, 1200, DS_FROG);
      
  AddDefaultSpell(2, 600, DS_PARALYZE);
  
  AddSpell(6,500,
  "Myrica fuegt Dir eine tiefe Wunde zu.\n",
  "Myrica fuegt @WEM eine tiefe Wunde zu.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(5, 300, DS_ANTIMAGIC);

  AddSpell(2,1200,	 
  "Myrica veraetzt Dich mit hochgiftiger Saeure.\n",
  "Myrica veraetzt @WEN mit hochgiftiger Saeure.\n",
  DT_ACID,([SP_SHOW_DAMAGE:1]));
      
  AddDefaultSpell(3, 450, DS_BLIND);

  AddSpell(4,1000,	
  "Myrica greift in Deine Haare und schmettert Deinen Kopf zu Boden.\n",
  "Myrica schmettert den Kopf von @WEM zu Boden.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
    
   AddDefaultSpell(3, 450, DS_CURSE_WEAPON);

  SetChats(1  , ({"Myrica zaubert etwas herbei.\n",
	         "Myrica murmelt ein paar magische Formeln.\n",
		 "Myrica wirft ein paar Kraeuter in den Kessel.\n"}));
 
  
  SUID;
    CLONEME(ARMOUR "mkleid.lpc" );
    CLONEME(ARMOUR "pantoffeln.lpc" );
    command("trage alles");
    CLONEME(OBJ "fliess.lpc" );
}
  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
    call_out("react", 0, "sagt: Geh schleich di!",
          "sagt: "+TP->name(WER)+" schleich di!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "fragt: Los mi in Ruah do herst, "+TPN+"!",0);
      break;
  case "traurig":
     call_out("react", 0, "sagt: Suder mi ned on "+TPN+"!",0);
      break;
  case "albern":
	   call_out("react", 0, "grinst magisch.",0);
       break;
  case "neutral":
     call_out("react", 0, "schmunzelt ueber Dich.", "grinst"
		     +TP->name(WEN)+" an.");
      break;
  case "intim":
     call_out("react", 0, "faucht Dich wuetend an. ",
	"faucht "+TP->name(WEN)+" wuetend an.");
      break;
  case "froh":
     call_out("react", 0, "strahlt Dich gluecklich an.",
             "strahlt "+TP->name(WEN)+" gluecklich an.");
      break;
  case "aengstlich":
     call_out("react", 0, "taetschelt Dir den Kopf.",
             "taetschelt "+TP->name(WEM)+" den Kopf.");
      break;
  case "frech":
     call_out("react", 0, "verpasst Dir eine Ohrfeige.", "verpasst "
		     +TP->name(WEN)+" eine Ohrfeige.");
      break;
  case "nett":
     call_out("react", 0, "grinst Dich gelangweilt an.", "grinst "
		      +TP->name(WEN)+" gelangweilt an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" schreit: I hob da gsogt, Du sollst Di "
		                 "schleichn!\n");
    Kill(TP);
      }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

