//15.1.2005
//von Aaliyah - Gesellenstueck
//Koenigskobra


inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"



void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Koenigskobra");
  SetProp(P_LONG,
    "Eine gigantische Koenigskobra. Sie baeumt sich drohend vor Dir auf, und " 
    "ihre blutroten Schlangenaugen funkeln Dich boese an. Ihre zarte "
    "Schlangenzunge zischt jedesmal, wenn sie ihre Giftzaehne entbloesst. "
    "Diese Kobra ist ein besonders giftiges Exemplar. Ihr Gift ist meistens "
    "toedlich, darum solltest Du auf der Hut sein.");
  
    
                   
  SetProp(P_GENDER, FEMALE);
  AddId(({"schlange", "kobra", "koenigskobra"}));
  SetProp(P_NAME, "Koenigskobra");
  set_living_name("koenigskobra");
  SetProp(P_ARTICLE, 1);
  create_default_npc(24);
  SetProp(P_HANDS, ({" mit ihren Giftzaehnen",300,DT_POISON}));
  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.0, DT_WATER:  0.4, DT_AIR:   -0.3, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: 0.2, DT_SOUND:  0.0, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  0.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      0.4, DT_UNHOLY:    0.1, DT_MAGIC:  0.1, DT_MIND:   0.2,
      DT_PIERCE: 0.1, DT_BLUDGEON: 0.2,  DT_SLASH:     0.1]) );

  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt davon");
  SetProp(P_MMSGIN, "schlaengelt herein und baeumt sich auf");
  SetProp(P_MMSGOUT, "schlaengelt in eine andere Welt");
  SetProp(P_DIE_MSG,  " bleibt regungslos liegen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Nun wohne ich im Garten Eden!");
  SetProp(P_KILL_NAME, "Der Todesbiss der Koenigskobra");
  SetProp(P_KILL_MSG, "Jetzt ist Dein Blut genauso giftig wie meines!");

  AddInfo(DEFAULT_INFO, "ignoriert Dich.");
  
    
   SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Koenigskobra sagt: Beisst in einen Apfel!\n" }) );

  SetProp(P_SPELLRATE, 90);

  AddDefaultSpell(2, 600, DS_PARALYZE);
   
  
  AddSpell(8,700,
  "Die Koenigskobra vergiftet Dich mit toedlichem Gift.\n",
  "Die Koenigskobra vergiftet @WEN mit toedlichem Gift.\n",
  DT_POISON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,300,		  
  "Die Koenigskobra zerreisst Dich mit ihren Giftzaehnen.\n",
  "Die Koenigskobra zerreisst @WEN mit ihren Giftzaehnen.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,200,
  "Die Koenigskobra peitscht Dich mit ihrem langen Schwanz.\n",
  "Die Koenigskobra peitscht @WEN mit ihrem langen Schwanz.\n",
  DT_WHIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,3000,
  "Die Koenigskobra versetzt Dir ihren Todesbiss.\n.",
  "Die Koenigskobra versetzt @WEM ihren Todesbiss.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
    
 AddDefaultSpell(5, 600, DS_POISON);  

 
   SUID;
    CLONEME("/p/std/skills/sewing_tanning/obj/magieseide.lpc");
    CLONEME("/p/std/skills/sewing_tanning/obj/magieseide.lpc");
      
  }

void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if (MENV)
    tell_room(MENV, 
      "Die Koenigskobra verkriecht sich.\n");
  deep_remove(1);
}

