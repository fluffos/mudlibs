//4.1.2005
//Aaliyah

//Acaciah die Blumenhexe

inherit "std/npc";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out ("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Acaciah saeuselt: Willkommen Fremder!\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Acaciah, die Blumenhexe");
  SetProp(P_LONG,
    "Acaciah ist eine schlanke, aeusserst attraktive Hexe mit langen blonden " 
    "Haaren und veilchenblauen Augen. Ihre langen Locken fallen ihr verspielt "
    "ins Gesicht. Lauter kleine weisse Blueten haben sich darin verfangen. "
    "Ihre zierlichen Haende sind unentwegt mit dem Binden von Blumenkraenzen " 
    "beschaeftigt. ");
    
  SetProp(P_NAME, ({"Acaciah, die Blumenhexe",
                  "Acaciah, der Blumenhexe", 
                  "Acaciah, der Blumenhexe",
                  "Acaciah, die Blumenhexe"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"acaciah", "hexe", "blumenhexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("acaciah");

  create_default_npc(40, 2000);
  SetProp(P_HANDS, ({" mit ihren dornigen Haenden an",400,DT_POISON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  0.1, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      -0.3, DT_UNHOLY:    -0.3, DT_MAGIC:  0.1, DT_MIND:   0.2,
      DT_PIERCE: -0.1, DT_SLASH: -0.2,  DT_BLUDGEON: 0.0]) );

  SetProp(P_MSGIN, "bricht aus der Erde heraus");
  SetProp(P_MSGOUT, "zaubert sich");
  SetProp(P_MMSGIN, "klettert aus einer riesigen Blume");
  SetProp(P_MMSGOUT, "verschmilzt mit dem Element Erde");
  SetProp(P_DIE_MSG,  " bricht blutend zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wer soll jetzt die Blumen wachsen lassen?");
  SetProp(P_KILL_NAME, "Acaciah die Blumenhexe");
  SetProp(P_KILL_MSG, "Ich leg Dir einen Blumenkranz aufs Grab!");

  AddInfo(DEFAULT_INFO, "fragt: Wollt Ihr sterben?");
  
  AddInfo( ({"jade","todeshexe"}), 
    "Jade wird Euch gewiss schnell toeten.", "sagt laechelnd: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt uns Hexen!","sagt: ");
  
  AddInfo( ({"druiden"}),
     "Die sind doch alle mit ihren Elementaren verheiratet.","schimpft: ");
  
  AddInfo( ({"tod"}),
     "Wir werden Euch toeten!","sagt: ");
  
  AddInfo( ({"berserker"}),
     "Mit einem von ihnen hatte ich mal eine Affaire.","sagt: ");
  
  AddInfo( ({"paladine","paladin"}),
     "Ayla hat noch zu selten geblutet.","sagt: ");
   
  AddInfo( ({"ayla"}),
     "In der Walpurgisnacht wird sie sterben.","sagt: ");
  
  AddInfo( ({"kronang","zechus"}),
     "Der ist nicht einmal erwaehnenswert.","lacht: ");
  
  AddInfo( ({"anvar","tattergreis"}),
     "Der alte Tattergreis hat schon viel zulange gelebt.","sagt laechelnd: ");
  
  AddInfo( ({"affaire","affaere"}),
     "Das ist schon lange her. Ich habe ihn verlassen, weil er mir einfach "
     "zu brutal war. Ausserdem habe ich einen netten Druiden kennengelernt. "
     "Seine heilenden Haende fand ich sehr praktisch.","erzaehlt: ");
  
  AddInfo( ({"druide"}),
     "Den Druiden habe ich getoetet, weil er mir nach einiger Zeit sehr "
     "auf die Nerven gegangen ist. Seitdem habe ich beschlossen, dass es ohne "
     "Maenner einfach viel besser ist.","sagt: ");
  
  AddInfo( ({"maenner"}),
     "Wir Hexen brauchen keine Maenner. Wenn ich einen von ihnen erwische, "
     "mache ich Hackfleisch aus ihm.","faucht: ");
     
  AddInfo( ({"nerven","nerv"}),
     "Wir Hexen haben keine guten Nerven. Darum lege ich Euch nahe, keine "
     "von uns zu erzuernen.","sagt: ");
     
  AddInfo( ({"hackfleisch"}),
     "Ein Mann schmeckt sicher lecker.","sagt: ");
  
  AddInfo( ({"haende","hand"}),
     "Ich liebe sanfte Haende.","sagt: ");
  
  AddInfo( ({"kardamom"}),
     "Kardamom ist ein scharfes Gewuerz aus den Samen von Ingwergewaechsen. "
     "Es wird benutzt, um Zauber zu verstaerken.","sagt: ");
  
  AddInfo( ({"aura","shahin","myrica","morrighan"}),
     "Sie ist mir eigentlich egal.","sagt: ");
  
  AddInfo( ({"hazel","jade","shine","artemisia"}),
     "Die ist so boese, da halte ich mich sogar fern.","sagt: ");
  
  AddInfo( ({"salvia","calluna"}),
     "Eine meiner zwei besten Freundinnen. Sie ist genauso huebsch wie "
     "ich, und verstehe mich blendend mit ihr.","sagt: ");
  
  AddInfo( ({"freundinnen","freundin"}),
     "Salvia und Calluna sind meine zwei besten Freundinnen. Wir verbringen "
     "viel Zeit miteinander. Leider schlaeft Salvia soviel. Ich finde sie "
     "uebertreibt es mit dem Schoenheitsschlaf.","sagt: ");
  
  AddInfo( ({"hexen","hexe"}),
     "Salvia, Calluna und ich geben uns kaum mit den anderen Hexen ab. Ausser "
     "fuer die Rituale und Feiertage meiden wir ein Treffen. Das liegt daran, "
     "dass wir uns einfach viel zu gut fuer die anderen sind.","sagt: ");
  
  AddInfo( ({"nachtschatten"}),
      "Er wird auch Solanum nigrum genannt und waechst auf stickstoffreichen "
      "Lehmboeden. Er wird zur Beschwoerung der dunklen Macht verwendet und "
      "sollte nur von einer erfahrenen Hexe benutzt werden.","sagt: ");
  
  AddInfo( ({"schoenheitsschlaf"}),
      "Schoenheitsschlaf ist wichtig. Guck doch mal meine reine Haut an. "
      "Trotzdem finde ich, dass Salvia etwas uebertreibt.","sagt: ");
  
  AddInfo( ({"prinzen","prinz"}),
      "Man munkelt, dass es hier zwei Prinzen gibt. Sie sind die Liebhaber der "
      "Hexen und werden von ihnen versteckt, da sie sonst von den anderen  "
      "Hexen mit grosser Sicherheit getoetet werden.","sagt: ");
  
  AddInfo( ({"haut"}),
      "Ich habe die zarteste Haut.","kichert: ");
  
  AddInfo( ({"liebhaber"}),
      "Einen davon hat Calluna versteckt. Ein praechtiges Exemplar von einem "
      "Mann. Wo der Andere ist weiss, ich jedoch nicht.","fluestert: ");
  
  AddInfo( ({"exemplar","mann"}),
      "Callunas Prinz ist goettlich. Trotzdem soll der Andere um einiges mehr "
      "an Anmut besitzen.","schwaermt: ");
  
  AddInfo( ({"blumen","hueterin"}),
      "Ich bin die Hueterin aller Blumen, die es hier im Silberland gibt. Von "
      "mir haben sie ihre Formen und Farben erhalten.","sagt: ");
  
  AddInfo( ({"formen","farben","form","farbe"}),
      "Sie sind wunderschoen. Aber das ist klar, schliesslich sind sie ja von "
      "mir, und ich habe einen guten Sinn fuer schoene Dinge.","sagt: ");
  
  AddInfo( ({"holly","shila"}),
      "Die sind ganz nett. Die eine kocht gut, die andere besorgt mir meine "
      "Zutaten fuer die Rituale.","sagt: ");

   AddInfo( ({"tulpen","rosen","nelken","veilchen","margeriten"}),
      "Frag mich nicht ueber Blumen aus. Pflueck lieber ein paar und leg sie "
      "mir dann zu Fuessen.","sagt: ");
   
   AddInfo( ({"feyaria"}),
      "Schade, dass sie eine Frau ist.","seufzt: ");

   AddInfo( ({"aaliyah"}),
      "Aaliyah ist unsere Mutter.","sagt: ");

   AddInfo( ({"fenris"}),
       "Fenris war einmal mein Liebhaber, und er war heiss!","schwaermt: ");
  

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Acaciah sagt: Iiih jetzt hab ich mir die Finger schmutzig gemacht.\n" }) );

  SetProp(P_SPELLRATE, 85);
  AddSpell(3,1,
  "Acaciah zwinkert Dir zu und zieht Dir Deine ganze Ruestung aus.\n",
  "Acaciah zwinkert und zieht @WEM die ganze Ruestung aus.\n",
   DT_MIND, "ausziehen");
    
 
  AddSpell(4,500,
  "Acaciah rammt Dir Dornenklinge in den Bauch.\n",
  "Acaciah rammt @WEM Dornenklinge in den Bauch.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(6,500,		  
  "Acaciah beschwoert viele scharfe Dornen.\n",
  "Acaciahs Dornen zerfleischen @WEN.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,800,
  "Acaciah starrt Dich mit ihren grossen Augen an.\n",
  "Acaciah starrt @WEN mit ihren grossen Augen an.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1500,
  "Acaciah zerfleischt Dich mit ihren dornigen Krallen.\n",
  "Acaciah zerfleischt @WEN mit ihren dornigen Krallen.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({"Acaciah floetet: Steckt doch Eure Waffe weg.\n",
		       "Acaciah fragt: Springt man so mit Frauen um?\n",
		       "Acacia fragt: Wollt Ihr nicht was anderes machen?\n"}) );
  
    

  SetChats(1, ({"Acaciah bindet singend einen Blumenkranz.\n",
		"Acaciah zwinkert Dir verfuehrerisch zu.\n",
		"Acaciah blaest sich eine Locke aus dem Gesicht.\n",
		"Acaciah befeuchtet langsam ihre Lippen.\n",
		"Acaciah bueckt sich und verschafft Dir tiefen Einblick.\n",
		"Acaciah haucht Dir ein Kuesschen zu.\n",
		"Acaciah raekelt sich lasziv in den Blumen.\n",
		"Acaciah sagt: Wollt Ihr nicht auf schoene Weise sterben?\n"}));
 
  
  SUID;
    CLONEME(WEAPON "dornklinge.lpc" );
    command("zuecke dornenklinge");
    CLONEME(ARMOUR "rosenkleid.lpc" );
    CLONEME(ARMOUR "mbschuhe.lpc" );
    CLONEME(ARMOUR "blumenkranz.lpc" );
    command("trage alles");
    CLONEME(OBJ "rosendorn.lpc" );
}

 void ausziehen(object enemy)
{
   if (enemy->QueryProp(P_GENDER) == MALE)
 {
	 
   if (sizeof(enemy->QueryProp(P_ARMOURS)))
 {
   command("sag Zieht Doch Eure Ruestung aus Suesser!");
    filter_objects(enemy->QueryProp(P_ARMOURS), "DoUnwear");
  }
   }
}
  

  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
    call_out("react", 0, "sagt: Wollt Ihr nicht lieber flirten Fremder?",
          "fragt: "+TP->name(WER)+" wollt Ihr nicht lieber flirten?");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "fragt: Wie behandelt Ihr denn eine Dame?, "+TPN+"?",0);
      break;
  case "traurig":
     call_out("react", 0, "saeuselt: Kommt in meine Arme "+TPN+".",0);
      break;
  case "albern":
     call_out("react", 0, "laechelt zuckersuess.",0);
       break;
  case "neutral":
     call_out("react", 0, "zwinkert Dir verfuehrerisch zu.", "zwinkert "
		     +TP->name(WEM)+" verfuehrerisch zu.");
      break;
  case "intim":
     call_out("react", 0, "beginnt Dich sanft zu streicheln. ",
	"streichelt "+TP->name(WEN)+" sanft.");
      break;
  case "froh":
     call_out("react", 0, "strahlt Dich gluecklich an.",
             "strahlt "+TP->name(WEN)+" gluecklich an.");
      break;
  case "aengstlich":
     call_out("react", 0, "streichelt Dir beruhigend durch die Haare.",
             "streichelt "+TP->name(WEM)+" durch die Haare.");
      break;
  case "frech":
     call_out("react", 0, "zwickt Dich in Dein Hinterteil.", "zwickt "
		     +TP->name(WEN)+" in das Hinterteil.");
      break;
  case "nett":
      call_out("react", 0, "schmiegt sich eng an Dich.", "schmiegt sich bei "
		      +TP->name(WEN)+" an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" sagt: Wer nicht flirten will muss sterben!\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

