// MORRIGHAN

inherit "std/npc";
inherit "std/npc/spells";



#include "../def.h"


void init()
{
  ::init();
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV))
    tell_room(MENV, "Morrighan weint: Du stoerst mich in meiner Trauer?\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Morrighan, die Hexe der Traenen");
  SetProp(P_LONG,
    "Morrighan hockt zusammengekauert am Boden. Ihr Gesicht in die Haende " 
    "verborgen. Ihre langen wasserblauen Haare triefen vor lauter Traenen. "
    "Sie schluchzt und jammert unentwegt und strahlt unendliche Traurigkeit "
    "aus. Haettest Du nicht soviel Angst vor ihr, wuerdest Du Dich sicher "
    "wagen, sie zu troesten.");
  
    
  SetProp(P_NAME, ({"Morrighan, die Traenenhexe",
                  "Morrighan, die Traenenhexe", 
                  "Morrighan, die Traenenhexe",
                  "Morrighan, die Traenenhexe"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"morrighan", "hexe", "traenenhexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("morrighan");

  create_default_npc(40,2300);
  SetProp(P_HANDS, ({"mit unendlicher Traurigkeit",300,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:      0.0, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.1, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    0.2, DT_MAGIC:  0.1, DT_MIND:   0.2,
      DT_SLASH:     0.0, DT_BLUDGEON: 0.0, DT_RIP: 0.0]) );

  SetProp(P_MSGIN, "kommt mit gesenktem Kopf herein");
  SetProp(P_MSGOUT, "geht traurig");
  SetProp(P_MMSGIN, "entsteht aus einer Traene");
  SetProp(P_MMSGOUT, "zerfliesst in einer Traene");
  SetProp(P_MNPC_AREA, "hex_30.lpc" );
  SetProp(P_DIE_MSG,  " zerfliesst in einer Traene.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Jetzt bin ich von meiner Qual erloest");
  SetProp(P_KILL_NAME, "Morrighan die Hexe der Traenen");
  SetProp(P_KILL_MSG, "Moechtet Ihr nochmal?");

  AddInfo(DEFAULT_INFO, "jammert: Ihr goennt mir meine Trauer nicht?");
  
    
   SetProp( P_REJECT, ({ REJECT_DROP,
    "Morrighan schluchzt: Ich brauche nur Trost!\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(4,400,
    "Morrighan schlitzt Dir mit ihren Krallen den Bauch auf.\n",
    "Morrighan schlitzt @WEM mit ihren Krallen den Bauch auf.\n",
  DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,400,
  "Morrighan spuckt Dir Saeure ins Gesicht.\n",
  "Morrighan spuckt @WEM Saeure ins Gesicht.\n",
  DT_ACID,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(6,800,		  
  "Morrighan schneidet Dir mit Engelsfunke eine tiefe Wunde ins Gesicht.\n",
  "Morrighan schneidet @WEM mit Engelsfunke eine tiefe Wunde ins Gesicht.\n",
  DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,900,
  "Morrighan zerstoert Deine Seele mit unendlicher Traurigkeit.\n",
  "Morrighan zerstoert die Seele von @WEM mit unendlicher Traurigkeit.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
  "Morrighan bohrt Dir Engelsfunke in Dein Herz.\n",
  "Morrighan bohrt @WEM Engelsfunke ins Herz.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(5, 300, DS_ANTIMAGIC);
    

  SetChats(10, ({"Morrighan weint bitterlich.\n",
	         "Morrighan schluchzt herzzerreissend.\n",
		 "Morrighan wischt sich eine Traene von der Wange.\n"}));
 
  
  SUID;
    CLONEME(WEAPON "engelfunke.lpc" );
    command("zuecke engelsfunke");
    CLONEME(ARMOUR "fusskette.lpc" );
    CLONEME(ARMOUR "morkleid.lpc" );
    command("trage alles");
}

  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
   case "fies":
      if( random(2) )
     call_out("react", 0, "sagt: Ihr habt keine Manieren Fremder!",
          "sagt: "+TP->name(WER)+" hat keine Manieren!");
      else
     call_out("angriff",0);
      break;
   case "aergerlich":
     call_out("react", 0, "fragt: Koennt Ihr mich nicht in Ruhe lassen?, "+TPN+"?",0);
      break;
   case "traurig":
     call_out("react", 0, "sagt: Ich kann Euch nicht troesten!, "+TPN+"?",0);
      break;
   case "albern":
     call_out("react", 0, "schluchzt laut auf.",0);
       break;
   case "neutral":
     call_out("react", 0, "weint leise weiter.", "beachtet "+TP->name(WEN)+
		     " nicht.");
      break;
   case "intim":
     call_out("react", 0, "umarmt Dich weinend. ",
	"umarmt "+TP->name(WEN)+" weinend.");
      break;
   case "froh":
     call_out("react", 0, "laechelt Dich gequaelt an.",
             "laechelt "+TP->name(WEN)+" gequaelt an.");
      break;
   case "aengstlich":
     call_out("react", 0, "redet Dir Mut zu.",
             "redet "+TP->name(WEM)+" Mut zu.");
      break;
   case "frech":
     call_out("react", 0, "grummelt Dich an.", "grummelt "+TP->name(WEN)+" an.");
      break;
    case "nett":
      call_out("react", 0, "umarmt Dich.", "umarmt "+TP->name(WEN)+" lieb.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" sagt: Aergern lasse ich mich nicht!\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

