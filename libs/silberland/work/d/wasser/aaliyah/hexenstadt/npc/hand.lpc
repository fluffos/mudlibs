// von Aaliyah
// 09.11.2005
// 
// NPC meines Gesellenstueckes "Hexenstadt"

inherit "std/mnpc";


#include "../def.h"



void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Hand");
  SetProp(P_LONG, "Die Hand weist viele Brandwunden und eitrige Schwielen auf. "
     "Sie gehoerte einmal einem Abenteurer und hat sich nach dessen Tod auf "
     "seltsame Weise ein Eigenleben angeeignet.");
  SetProp(P_NAME, "Hand");
  SetProp(P_GENDER, FEMALE); 
  AddId("hand");
  
  create_default_npc(2+random(4));
  SetProp(P_HANDS, ({" mit ihren Fingern",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Hand");
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 100);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 40+random(1000));
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "zeigt Dir ihren Mittelfinger und krabbelt");
  SetProp(P_MMSGIN, "bewegt ihre Finger");
  SetProp(P_MMSGOUT, "krabbelt von dannen");

  SetProp(P_MNPC_AREA, ({ ROOM "platz1.lpc", ROOM "platz2.lpc"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "platz1.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);  
  SetProp(P_DIE_MSG, " ermatscht in einen ekligen Fleischklumpen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Leg Dich nicht mit mir an!");
  SetProp(P_MURDER_MSG, "Wart Du nur, bis Dich mein Freund, das Bein erwischt!");  
  AddInfo(DEFAULT_INFO, "zeigt Dir ihren Mittelfinger.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Braucht so etwas nicht.\n" }));

  SetChats(3, ({ "Die Hand kruemmt ihre Finger.\n",
		 "Die Hand zupft Dich an Deiner Hose.\n",
		 "Die Hand zwickt Dich ins Bein.\n"}));

  SetAttackChats(10, ({ "Die Hand hebt drohend ihren Zeigefinger.\n",
			"Die Hand ballt sich zur Faust.\n"}));

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "hebt drohend ihren Zeigefinger.",
	       "droht "+TP->Name(WEM)+ "mit ihrem Zeigefinger.");
     break;

   case "aergerlich":
     call_out("react", 0, "ignoriert Dich.",
	      "ignoriert "+TP->Name(WEN)+".");
     break;

   case "frech":
     call_out("react", 0, "zwickt Dich fest ins Bein.",
	      "zwickt "+TP->Name(WEN)+" ins Bein.");
     break;
   
    default:
      call_out("react", 0, "knackst mit den Fingern.",
	       "macht Fingerschattenspiele.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 

   
