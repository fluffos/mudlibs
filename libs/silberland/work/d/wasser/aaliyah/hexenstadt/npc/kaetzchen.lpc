// NPC meines Gesellenstueckes "Hexenstadt"

inherit "std/mnpc";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Kaetzchen");
  SetProp(P_LONG, "Das kleine suesse Kaetzchen sieht eher aus wie ein weisses "
     "Wollknaeuel. So plueschig ist sein Fell. Es blickt Dich scheu aus seinen "
     "schoenen, mandelfoermigen eisblauen Augen an. ");
  SetProp(P_NAME, "Kaetzchen");
  SetProp(P_GENDER, NEUTER); 
  AddId("kaetzchen");
  
  create_default_npc(2+random(4));
  SetProp(P_HANDS, ({"seinen kleinen Krallen ",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 40+random(1000));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "tapst herein");
  SetProp(P_MSGOUT, "wuselt neugierig umher");
  SetProp(P_MMSGIN, "guckt scheu");
  SetProp(P_MMSGOUT, "tapst davon");
  SetProp(P_NOATTACK, "ist viel zu suess getoetet zu werden.");
  
  
 
  SetProp(P_MNPC_FLAGS, 0);  
  SetProp(P_DIE_MSG, " bricht erbaermlich zusammen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Tut mir leid, aber ich muss mich ja wehren!");
  SetProp(P_MURDER_MSG, "Hast Du denn ueberhaupt kein Herz?");  
  AddInfo(DEFAULT_INFO, "putzt sich.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Braucht so etwas nicht.\n" }));

  SetChats(1, ({ "Das Kaetzchen blickt Dich scheu an.\n",
		 "Das Kaetzchen klettert auf den Schrank.\n",
		 "Das Kaetzchen putzt sich seine Pfoten.\n"}));

  SetAttackChats(10, ({ "Das Kaetzchen faucht Dich an.\n",
			"Das Kaetzchen schaerft seine Krallen.\n"}));

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "blickt Dich verstoert an.",
	       "blickt "+TP->Name(WEN)+ "verstoert an.");
     break;

   case "aergerlich":
     call_out("react", 0, "fluechtet vor Dir.",
	      "fluechtet vor "+TP->Name(WEM)+".");
     break;

   case "frech":
     call_out("react", 0, "sagt: Lass mich, ich tu Dir nichts.",
	      "miaut "+TP->Name(WEN)+" scheu an.");
     break;
   
    default:
      call_out("react", 0, "wuselt durch den Raum.",
	       "versteckt sich hinter der Theke.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 

   
