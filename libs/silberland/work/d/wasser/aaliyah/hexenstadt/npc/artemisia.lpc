//Artemisia die Jagdhexe


inherit "std/npc";
inherit "std/npc/spells";
#include "../def.h"
#include "/d/astral/lamuerte/brunnen/npc/sprachfluch.h"


void init()
{
  ::init();
  call_out("hallo",0);
  
}

void hallo()
{
   object* umhang;
  if (objectp(TP) && objectp(MENV) && present(TP, MENV) && !IS_LEARNING(TP) &&
      interactive(TP))
  {
    if (!sizeof(umhang=TP->QueryArmours(AT_CLOAK)) ||
       !umhang[0]->id("lichtumhang"))
    {
       tell_room(MENV, "Artemisia strahlt: Oh, ein Opfer!\n");
       Kill(TP);
    }
    else
      tell_room(MENV, "Artemisia sagt: Seid gegruesst Shine!\n"); 
  }
  
}
string i_dinge();
string i_waffe();

void create()
{     
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Artemisia, die Hexe der Jagd");
  SetProp(P_LONG,
    "Artemisia ist eine Amazone ersten Ranges. Ihre silbernen, lockigen Haare " 
    "fallen wild ueber ihren Schultern. Ihr muskuloeser Koerper ist von "
    "Sehnen durchzogen und repraesentiert ihre unglaubliche Kraft. Sie " 
    "ist faehig mit jeder erdenklichen Waffe umzugehen.");
    
  SetProp(P_NAME, ({"Artemisia, die Jagdhexe",
                  "Artemisia, der Jagdhexe", 
                  "Artemisia, der Jagdhexe",
                  "Artemisia, die Jagdhexe"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"artemisia", "hexe", "jagdhexe", "amazone","Speermeister"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("artemisia");

  create_default_npc(42,5000);
  SetProp(P_HANDS, ({" mit ihrer Kraft ",300,DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 240);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.1,
      DT_ELECTRIC:  0.0, DT_ACID:      0.1, DT_POISON: 0.1, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.2,
      DT_SLASH:     -0.2, DT_BLUDGEON: -0.2, DT_PIERCE: -0.2]) );

  SetProp(P_MSGIN, "kommt mit majestaetischen Schritten herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint mit Knall und Schwefelduft");
  SetProp(P_MMSGOUT, "verschwindet in einem Blitz");
  SetProp(P_DIE_MSG,  " stirbt eines Amazonentodes.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Meine Geister werden Dich holen!");
  SetProp(P_KILL_NAME, "Artemisia die Hexe der Jagd");
  SetProp(P_KILL_MSG, "Zerstueckelt gefaellst Du mir viel besser!");

  AddInfo(DEFAULT_INFO, "fragt: Wollt Ihr sterben?");
  
  AddInfo( ({"shine","lichthexe"}), 
    "Ihr wollt wissen, was ich von Euch halte? Ich schmiede Euch gerne eure "
    "Waffen, jedoch mag ich Euer grelles Licht nicht.", "sagt: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt uns Hexen!", "sagt: ");

  AddInfo( ({"jade","todeshexe"}), 
    "Jade kann nur durch eine meiner Waffen verletzt werden.", "sagt laechelnd: ");
  
 
  AddInfo( ({"bogen","boegen"}),
     "Elfen kaempfen mit Pfeil und Bogen. Tenobaal schmiedet zwar auch "
     "erstklassige Boegen, aber meine hier sind magisch.", "sagt: ");
  
  AddInfo( ({"waffen","waffe"}),
     "Schwerter, Boegen, Messer, Speere, Peitschen und eine Vielfalt "
     "an anderen Waffen werden von mir hergestellt.", "sagt: ");
  
  AddInfo( ({"tenobaal","konkurrenz"}),
     "Lasst mich mit der Konkurrenz in Ruhe!.", "schimpft: ");
  
  AddInfo( ({"elfen","wesen","elf"}),
     "Elfen sind sehr anmutige Wesen.", "sagt: ");
  
  AddInfo( ({"messer"}), 
     "Mit dem Messer schlitze ich meine Gegner auf.", "sagt: ");
  
  AddInfo( ({"ayla"}),
     "In der Walpurgisnacht wird sie sterben.", "sagt: ");
  
  AddInfo( ({"peitschen","peitsche"}),
     "Eine Peitsche von mir zerfleischt alle Gegner.", "lacht: ");
  
  AddInfo( ({"schwerter","schwert"}),
     "Meine Schwerter wurden von den Goettern gesegnet.", "sagt laechelnd: ");
  
  AddInfo( ({"speere","speer"}),
     "Meine Speere sind so scharf, dass sie die Gegner muehelos aufspiessen. "
     "Ein sehr schneller Tod.", "erzaehlt: ");
  
  AddInfo( ({"gegner"}),
     "Eines haben alle Gegner meiner Waffen gemeinsam. Sie sterben! "
     "Meistens aeusserst qualvoll.", "sagt: ");
  
  AddInfo( ({"goetter"}),
     "Wir Hexen haben andere Goetter als der Rest des Landes. Wir haben "
     "Hekate, Venus, Aphrodite, Pan, Isis usw.", "sagt: ");
     
  AddInfo( ({"aphrodite","hekate","venus","pan","isis"}),
     "Habt Ihr unsere Goetter vergessen Shine?", "tadelt: ");
     
  AddInfo( ({"material"}),
     "Mondstein, Kometenstaub und auch goldenes Vlies sind fuer die "
     "Herstellung meiner Waffen unerlaesslich.", "sagt: ");
  
  AddInfo( ({"vlies"}),
     "Leider wurde es mir gestohlen. Es muss eine der Hexen gewesen sein als "
     "ich geschlafen habe. Bringt es mir wieder und ich helfe Euch.","sagt: ");
  
  AddInfo( ({"mondstein"}),
     "Ich bekomme meinen Mondstein immer von Aura. Sie versorgt mich auch mit "
     "Kometenstaub. Fragt sie doch.", "sagt: ");
  
  AddInfo( ({"aura"}),
     "Sie versorgt mich mit Mondstein und Kometenstaub.", "sagt: ");
  
  AddInfo( ({"wasserherz"}),
     "Das muesstet Ihr doch wissen Shine.", "laechelt: ");
  
  AddInfo( ({"prinzenherz"}),
     "Das brauche ich fuer Eure Waffe.", "sagt: ");
  
  AddInfo( ({"magma","eisblume","drachenkralle","rosendorn","perle"}),
     "Ach Shine, meine Liebe! So strengt Doch Euer Koepfchen an.","sagt: ");
  
  AddInfo( ({"hilfe"}),
     "Natuerlich helfe ich Euch Shine. Ihr wollt gewiss eine besondere Waffe "
     "von mir. Ich schmiede sie Euch gerne, jedoch muesst Ihr mir einige  "
     "Dinge besorgen, da mein Vorrat erschoepft ist.", "sagt: ");
  
  AddInfo( ({"dinge"}), #'i_dinge, "sagt: ");

  AddInfo( ({"waffe"}), #'i_waffe, "sagt: ");
        
  AddLibrary( "/d/gebirge/feyaria/drachen/drachen.lib",2);
  
  
  
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Artemisia sagt: Behaltet Euren Schrott!\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(4,500,
    "Artemisia rammt Dir ihren Jagdspiess in die Brust.\n",
    "Artemisia rammt @WEM ihren Jagdspiess in die Brust.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1200,
  "Artemisia murmelt: In duria dentris mortes.\n",
  "Artemisia vernichtet @WEN mit magischen Formeln.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,500,		  
  "Artemisia schneidet Dir ein Stueck Fleisch aus dem Arm.\n",
  "Artemisia schneidet @WEM ein Stueck Fleisch aus dem Arm.\n",
  DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,2100,
  "Artemisia tritt Dir zwischen die Beine.\n",
  "Artemisia tritt @WEM zwischen die Beine.\n",
  DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(3, 450, DS_CURSE_WEAPON);

  AddDefaultSpell(5, 700, DS_FEAR,
  "Artemisia erschreckt Dich dermassen, dass Du panisch fluechtest.\n",
  "Artemisia jagt @WEN davon.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 450, DS_MASS_DAMAGE,
  "Artemisia wirbelt ihre Waffe durch die Luft und verletzt Dich.\n",
  "Artemisia wirbelt ihre Waffe durch die Luft und verletzt @WEN.\n",
  DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,600,
  "Artemisia spaltet Deine Zunge entzwei.\n",
  "Artemisia spaltet @WEM die Zunge entzwei.\n",
  DT_SLASH, "spell_sprachfluch",([SP_SHOW_DAMAGE:1]));

  SetChats(10, ({"Artemisia schmiedet ein Schwert.\n",
		 "Artemisia wischt sich den Schweiss von der Stirn.\n",
		 "Artemisia rueckt sich ihren Busen zurecht.\n",
		 "Artemisia sagt: Ihr nervt mich!\n",
		 "Artemisia fragt: Muesst Ihr da so rumlungern?\n"}));
 
  
  SUID;
    CLONEME("/p/weapon/spear/jagdspiess" );
    command("zuecke spiess");
    CLONEME(ARMOUR "schupumhang.lpc" );
    CLONEME(ARMOUR "dpanzer.lpc" );
    CLONEME("/p/weapon/club/schmiedehammer");
    CLONEME(ARMOUR "drock.lpc");
    CLONEME(ARMOUR "drastiefel.lpc");
    CLONEME(ARMOUR "draschild.lpc");
    command("trage alles");
   
}

   string i_dinge()

 {
	 
  object ob;
  string* alle_materialien;
  string* spieler_materialien;
  
  int i,r;
  string ret;
  
  
  if (present("HEXENMATERIALIENOBJEKT", TP))

  return "Ein Priester predigt auch nicht zweimal.";

  ob = clone_object(OBJ "hmobjekt");
  
  ob->move(TP, M_NOCHECK);
  
 alle_materialien = ({"Prinzenherz", "Wasserherz", "Magma", "Mondstein",
		      "Kometenstaub", "Perle", "Rosendorn", "Drachenkralle",
		      "Goldenes Vlies", "Eisblume"}); 

  spieler_materialien = ({});
  
  ret = "Du brauchst folgende Dinge: ";
  
  for (i = 0; i < 4; i++)

 {
   r = random(sizeof(alle_materialien));
   
   spieler_materialien += ({alle_materialien[r]});

   ret += alle_materialien[r]; 
	  
  switch(i) 
  {
   case 3: ret += "."; break;
   case 2: ret += " und "; break;
   default: ret += ", "; break;
  }
	                                  
	   
	   
   alle_materialien -= ({alle_materialien[r]});

  }

  ob->set_materialien(spieler_materialien); 

 return ret;

 }
  
int do_frage(string question, string text)
{
  object* umhang;
  if (!sizeof(umhang=TP->QueryArmours(AT_CLOAK)) ||
      !umhang[0]->id("lichtumhang"))
  {
    tell_room(MENV,
      "Artemisia spricht mit ihren Feinden nicht.\n");
    return 1;  
  }
  return ::do_frage(question, text);
}

string i_waffe()
{
  object ob;
  string *mat;
  int i;
  object *obs;
  object waffe;
  
  if (ob = present("HEXENMATERIALIENOBJEKT", TP))
  {
    mat = ob->query_materialien();
    obs = ({0,0,0,0});
    for (i = 0; i < 4; i++)
      obs[i] = present("HMO_"+mat[i], TP);
    if (obs[0] && obs[1] && obs[2] && obs[3])
    {
      switch(TP->QueryProp(P_GUILD))
      {
        case "berserker":
          waffe = clone_object( WEAPON "gerecht");
          break;
        case "druidenzirkel":
          waffe = clone_object( WEAPON "toleranz");
          break;
        case "nekromanten":
          waffe = clone_object( WEAPON "keusch");
          break;
        case "paladine":
          waffe = clone_object( WEAPON "abstinenz");
          break;
	  
     default:
	 return "Geh lieber in den Sandkasten spielen!";
      }
      tell_object(TP,
        "Artemisia nimmt Dir einige Dinge ab und ueberreicht Dir " +
        waffe->name(WEN) + ".\n");
      for (i = 0; i < 4; i++)
        obs[i]->remove();
      ob->remove();
      WLOG(LOG "jadewaffe", "bekommt " + waffe->name(WEN));
      waffe->move(TP, M_NOCHECK);
      return "Mit dieser Waffe kannst Du Jade verletzen. Toete sie!";
    } 
  }
  return "Du musst zuerst die richtigen Dinge besorgen!";
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
   
