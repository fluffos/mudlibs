// 3.1.2005 Aaliyah
// Shahin die Hexe des Eises

inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&&!InFight())
    tell_room(MENV, "Shahin verneigt sich anmutig.\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Shahin, die Hexe des Eises");
  SetProp(P_LONG,
    "Vor Dir steht ein Geschoepf aus purem Eis. In Shahins langen, eisigen " 
    "weissen Haaren funkeln lauter Eiskristalle. Ihre eisblauen Augen strahlen "
    "die vollkommene Kaelte aus. Ihr filigraner wunderschoener Koerper wirkt "
    "wie ein einziges Eisgebilde und laesst sie dadurch zerbrechlich wirken. "
    "Trotzdem waere es eine Dummheit, dieses maechtige Wesen zu unterschaetzen.");
  
    
  SetProp(P_NAME, ({"Shahin, die Eishexe",
                  "Shahin, die Eishexe", 
                  "Shahin, die Eishexe",
                  "Shahin, die Eishexe"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"shahin", "hexe", "eishexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("eishexe");

  create_default_npc(40,3500);
  SetProp(P_HANDS, ({" mit ihren eisigen Haenden ",300,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 60000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:40]));  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.2, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.2, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  0.0, DT_MIND:   0.2,
      DT_SLASH:     -0.2, DT_PIERCE:  -0.5, DT_WHIP: -0.5, DT_BLUDGEON: 0.1]) );

  SetProp(P_MSGIN, "formt sich aus purem Eis");
  SetProp(P_MSGOUT, "verschmilzt mit dem Eis");
  SetProp(P_MMSGIN, "kristallisiert sich aus purem Eis");
  SetProp(P_MMSGOUT, "zerbricht in lauter Eiskristalle");
  SetProp(P_DIE_MSG,  " zerbricht in lauter Eiskristalle.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Eisige Zeiten werden auf Euch zukommen");
  SetProp(P_KILL_NAME, "Shahin, die Hexe des Eises");
  SetProp(P_KILL_MSG, "Wie dumm muss man sein?");

  AddInfo(DEFAULT_INFO, "saeuselt: Das kann ich doch nicht wissen Fremder.");
  
     AddInfo( ({"schnee"}),
     "Schnee ist etwas Wundervolles.","sagt: ");
  
  AddInfo( ({"kardamom"}),
     "Kardamom ist ein scharfes Gewuerz aus den Samen von Ingwergewaechsen. "
     "Es wird benutzt, um Zauber zu verstaerken.","sagt: ");
  
  AddInfo( ({"aura","myrica","morrighan"}),
     "Sie ist mir eigentlich egal.","sagt: ");
  
  AddInfo( ({"hazel","jade","artemisia"}),
     "Die ist so boese, da halte ich mich sogar fern.","sagt: ");
  
  AddInfo( ({"salvia","calluna","acaciah"}),
     "Ueber diese Hexe bin ich erhaben. Sie ist mir zu viel mit sich selbst "
     "beschaeftigt.","sagt: ");

  AddInfo( ({"shine"}),
     "Shine ist meine beste Freundin.","sagt: ");
  
  AddInfo( ({"eis"}),
     "Ich habe das Eis erschaffen.","sagt: ");
  
  AddInfo( ({"prinz"}),
     "Was genau meint Ihr?","huestelt: ");

  AddInfo( ({"jade","todeshexe"}), 
    "Jade wird Euch gewiss schnell toeten.", "sagt laechelnd: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt uns Hexen!","sagt: ");
  
  AddInfo( ({"feyaria"}),
     "Feyaria ist lieb. Sie kommt mich oefters mal besuchen.","strahlt: ");
 
  AddInfo( ({"kraeuter"}),
    "Fuer Kraeuter ist Shila zustaendig","sagt: ");
  
  AddInfo( ({"shila","kraeuterexpertin"}),
     "Das ist unsere Kraeuterexpertin.","sagt: ");
  
  AddInfo( ({"eisblume","eiszapfen","schneeball"}), 
    "Ich habe alle Eisgebilde erschaffen.", "sagt laechelnd: ");
  
  AddInfo( ({"schneemann"}),
    "Ihr seid wohl von Eurer Mama noch nicht abgenabelt hm?","fragt: ");
  
  AddInfo( ({"mama","aaliyah"}),
     "Unsere Mutter ist Aaliyah.","sagt: ");
  
  
  
   SetProp( P_REJECT, ({ REJECT_KEEP,
    "Shahin floetet: Ich bin Euch zu groesstem Dank verpflichtet!\n" }) );

  SetProp(P_SPELLRATE, 98);
  AddSpell(4,900,
    "Shahin schlitzt Dir mit ihren eisigen Krallen den Bauch auf.\n",
    "Shahin schlitzt @WEM mit ihren eisigen Krallen den Bauch auf.\n",    
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,700,
  "Shahin zerfleischt Dir Dein Gesicht.\n",
  "Shahin zerfleischt das Gesicht von @WEM.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1900,		  
  "Shahin beschwoert eine maechtige Schneelawine.\n",
  "Shahin vernichtet @WEN mit einer maechtigen Schneelawine.\n",
  DT_COLD,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(5,600,DS_SLOW,
  "Shahin vereist Dich mit unglaublicher Kaelte.\n",
  "Shahin vereist @WEN mit unglaublicher Kaelte.\n");
 
  
  AddSpell(5,500,
  "Shahin rammt Dir ihren Eiszapfen in Dein Bein.\n",
  "Shahin rammt @WEM ihren Eiszapfen in das Bein.\n",
  DT_COLD,([SP_SHOW_DAMAGE:1]));
    

  SetChats(1, ({"Shahin singt ein wunderschoenes Lied.\n",
	         "Shahin laesst eine Eisrose entstehen.\n",
		 "Shahin bueckt sich und streichelt ein Schneehaeschen.\n"}));
 
  
  SUID;
    CLONEME(WEAPON "eisdolch.lpc" );
    command("zuecke dolch");
    CLONEME(ARMOUR "schlitt.lpc" );
    CLONEME(ARMOUR "eiskleid.lpc" );
    CLONEME(ARMOUR "eistiara.lpc" );
    command("trage alles");
    CLONEME(OBJ "eisblume.lpc" );
}
 void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "sagt: Wieso tut Ihr das Fremder?",
          "fragt: "+TP->name(WER)+", wieso tut Ihr das?");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "fragt: Wie behandelt Ihr denn eine Dame "+TPN+"?",0);
      break;
  case "traurig":
    call_out("react", 0, "troestet Dich eiskalt "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "laechelt kuehl.",0);
       break;
  case "neutral":
    call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEM)+" zu.");
      break;
  case "intim":
    call_out("react", 0, "durchdringt Dich mit ihren Augen. ",
	"durchdringt "+TP->name(WEN)+" mit ihren Augen.");
      break;
  case "froh":
    call_out("react", 0, "haucht Dir eisige Blumen zu.",
             "haucht "+TP->name(WEM)+" eisige Blumen zu.");
      break;
  case "aengstlich":
    call_out("react", 0, "lacht Dich aus.",
             "lacht "+TP->name(WEN)+" aus.");
      break;
  case "frech":
    call_out("react", 0, "droht Dir mit ihrem Dolch.", "droht "
		     +TP->name(WEM)+" mit ihrem Dolch.");
      break;
  case "nett":
    call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
		    " an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" schimpft: Ich werde Euch vereisen!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

