//1.12.2004
//Gesellenstueck Aaliyah

//Aura, die Hexe der Nacht


inherit "std/npc";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&&!InFight())
    tell_room(MENV, "Aura seufzt: Oh Ihr seid ja gar nicht Andruil.\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Aura, die Hexe des Mondes");
  SetProp(P_LONG,
    "Aura ist eine der anmutigsten Hexen, die Du je gesehen hast. In ihren " 
    "langen nachtschwarzen Haaren befinden sich unzaehlige leuchtende Sterne. "
    "Ihre grossen bernsteinfarbenen Mandelaugen bieten einen guten Kontrast " 
    "zu ihrer reinen blassen Haut.");
    
  SetProp(P_NAME, ({"Aura, die Mondhexe",
                  "Aura, der Mondhexe", 
                  "Aura, der Mondhexe",
                  "Aura, die Mondhexe"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"aura", "hexe", "mondhexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("aura");

  create_default_npc(40,2000);
  SetProp(P_HANDS, ({" mit ihren zarten Haenden ",300,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 84000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -1.0, DT_COLD:      0.1, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.2, DT_ACID:      0.0, DT_POISON: 0.2, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    0.2, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_SLASH:     -0.2, DT_BLUDGEON: -1.0, DT_PIERCE: -1.0]) );

  SetProp(P_MSGIN, "entsteht aus tiefster Finsternis");
  SetProp(P_MSGOUT, "fliegt auf einer Sternschnuppe");
  SetProp(P_MMSGIN, "verneigt sich anmutig");
  SetProp(P_MMSGOUT, "verschmilzt mit der Nacht");
  SetProp(P_DIE_MSG,  " bricht blutend zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Andruil ich werde im Herzen ewig bei Dir sein.");
  SetProp(P_KILL_NAME, "Aura, die Hueterin der Nacht");
  SetProp(P_KILL_MSG, "Jetzt bist Du auch ein Stern am Himmel!");

  AddInfo(DEFAULT_INFO, "fragt: Wisst Ihr wo sich Andruil befindet?");
  
  AddInfo( ({"jade","todeshexe"}), 
    "Jade wird Euch gewiss schnell toeten.", "sagt laechelnd: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt uns Hexen!","sagt: ");
  
  AddInfo( ({"herz"}),
     "Mein Herz gehoert nur Andruil.","schmachtet: ");
  
  AddInfo( ({"tod"}),
     "Wir werden Euch toeten!","sagt: ");
  
  AddInfo( ({"berserker"}),
     "Mein Geliebter ist der groesste Berserker.","sagt: ");
  
  AddInfo( ({"paladine","paladin"}),
     "Ayla hat noch zu selten geblutet.","sagt: ");
  
  AddInfo( ({"druiden","druide"}), 
     "Anvar hats einfach nicht drauf.","sagt: ");
  
  AddInfo( ({"ayla"}),
     "In der Walpurgisnacht wird sie sterben.","sagt: ");
  
  AddInfo( ({"kronang","zechus"}),
     "Der ist nicht einmal erwaehnenswert.","lacht: ");
  
  AddInfo( ({"anvar","tattergreis"}),
     "Der alte Tattergreis hat schon viel zulange gelebt.","sagt laechelnd: ");
  
  AddInfo( ({"andruil"}),
     "Andruil ist mein Geliebter. Mein Herz gehoert nur ihm. Er ist der "
     "groesste Held des ganzen Landes. Leider ist er von seinen Kaempfen "
     "noch nicht zurueckgekehrt. Ich mache mir schon Sorgen.","erzaehlt: ");
  
  AddInfo( ({"kaempfe","kaempfen"}),
     "Ich habe noch nie jemand so gut kaempfen gesehen wie Andruil.","sagt: ");
    
  AddInfo( ({"maenner"}),
     "Wir Hexen brauchen keine Maenner. Wenn ich einen von ihnen erwische, "
     "mache ich Hackfleisch aus ihm.","faucht: ");
     
  AddInfo( ({"held"}),
     "Andruil ist mein Held.","sagt: ");
     
  AddInfo( ({"hackfleisch"}),
     "Ein Mann schmeckt sicher lecker.","sagt: ");
  
  AddInfo( ({"sorgen","sorge"}),
     "Ich hoffe ihm ist nichts passiert.","bangt: ");
  
  AddInfo( ({"kardamom"}),
     "Kardamom ist ein scharfes Gewuerz aus den Samen von Ingwergewaechsen. "
     "Es wird benutzt, um Zauber zu verstaerken.","sagt: ");
  
  AddInfo( ({"shine","shahin","myrica","morrighan"}),
     "Sie ist mir eigentlich egal.","sagt: ");
  
  AddInfo( ({"hazel","jade","artemisia"}),
     "Die ist so boese, da halte ich mich sogar fern.","sagt: ");
  
  AddInfo( ({"salvia","calluna","acaciah"}),
     "Ach die ist mir viel zu arrogant.","sagt: ");
  
  AddInfo( ({"wagen"}),
     "Der grosse Wagen ist nur ein kleiner Teil des Universums. Es gibt "
     "soviele Sternenbilder. Aber die sind mein Geheimnis.","sagt: ");
  
  AddInfo( ({"hexen","hexe"}),
     "Ach mir sind die Hexen ganz egal. Ich bin lieber alleine und deute "
     "hier meine Sternenbilder.","sagt: ");
    
    
  AddInfo( ({"prinzen"}),
      "Man munkelt, dass es hier zwei Prinzen gibt. Sie sind die Liebhaber der "
      "Hexen und werden von ihnen versteckt, da sie sonst von den anderen Hexen "
      "mit grosser Sicherheit getoetet werden.","sagt: ");
  
  AddInfo( ({"sternenbilder","sternenbild"}),
      "Siehst Du den grossen Wagen?","fragt: ");
  
  AddInfo( ({"liebhaber"}),
      "Mich interessieren die Prinzen nicht. Mein Prinz ist Andruil, und "
      "mit ihm kann sowieso niemand konkurrieren.","erklaert: ");
  
  AddInfo( ({"prinz"}),
      "Andruil! Wie oft denn noch?","schimpft: ");
  
  AddInfo( ({"universum"}),
      "Das Universum ist unendlich. Der Mond ist mein Zuhause und die Sterne "
      "meine Gefaehrten.","sagt: ");
  
  AddInfo( ({"sterne","gefaehrten","stern","gefaehrte"}),
      "Sind sie nicht wunderschoen? Sie sind die Seelen jener, die mutig "
      "im Kampf gefallen sind.","sagt: ");
  
  AddInfo( ({"seelen","seele"}),
      "Die Sterne sprechen nur mit mir. Ich huete ueber sie.","sagt: ");

   AddInfo( ({"zuhause","mond"}),
      "Der Mond ist mein Zuhause. Er gewaehrt mir Schutz.","sagt: ");

   AddInfo( ({"liebe","halt"}),
      "Das Einzige, was mir Halt gibt, ist meine Liebe zu Andruil.","sagt: ");

   AddInfo( ({"aaliyah"}),
      "Aaliyah ist unsere liebe Mutter.","sagt: ");

   
   

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Aura sagt: Da ich sowas nicht brauche, werde ich es zerstoeren.\n" }) );

  SetProp(P_SPELLRATE, 70);
  AddSpell(4,300,
   "Aura schlitzt Dir mit einer Mondsichel die Brust auf.\n",
   "Aura schlitzt @WEM mit ihrer Mondsichel die Brust auf.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,2500,
  "Aura laesst Dich von einen Kometen erschlagen.\n",
  "Aura laesst @WEN von einen Kometen erschlagen.\n",
  DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,700,		  
  "Aura reisst Dir ein grosses Bueschel Haare aus.\n",
  "Aura reisst @WEM ein grosses Bueschel Haare aus.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,700,
  "Aura beschwoert Hekate und vernichtet Dich mit unglaublicher Magie.\n",
  "Aura vernichtet @WEN mit Hekates Magie.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(8,450,
  "Aura rammt Dir ihren Nachtdolch in Deine Brust.\n",
  "Aura rammt @WEM ihren Nachtdolch in die Brust.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
    

  SetChats(1, ({"Aura deutet fasziniert die Sterne.\n",
	         "Aura seufzt: Oh Andruil, mein Geliebter, wo bleibst Du nur?\n",
		 "Aura jammert: Wie ich Dich vermisse Andruil.\n"}));
 
  
  SUID;
    CLONEME(WEAPON "nachtdolch.lpc" );
    command("zuecke dolch");
    CLONEME(ARMOUR "mondsichel.lpc" );
    CLONEME(ARMOUR "nachtkleid.lpc" );
    CLONEME(ARMOUR "nstiefel.lpc" );
    command("trage alles");
   if (random(2))
    CLONEME(OBJ "kstaub.lpc");
   else
    CLONEME(OBJ "mondstein.lpc");
    
    
}


  void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
    call_out("react", 0, "faucht: Ihr seid ganz schoen unverschaemt!",
          "faucht: "+TP->name(WER)+" ist ganz schoen unverschaemt!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "fragt: Wie behandelt Ihr denn eine Dame "+TPN+"?",0);
      break;
  case "traurig":
     call_out("react", 0, "troestet Dich teuflisch grinsend "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "grinst diabolisch.",0);
       break;
  case "neutral":
     call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEN)+" zu.");
      break;
  case "intim":
     call_out("react", 0, "schubst Dich sanft zur Seite. ",
	"schubst "+TP->name(WEN)+" sanft zur Seite.");
      break;
  case "froh":
     call_out("react", 0, "strahlt Dich gluecklich an.",
             "strahlt "+TP->name(WEN)+" gluecklich an.");
      break;
  case "aengstlich":
     call_out("react", 0, "zeigt Dir den grossen Wagen.",
             "zeigt "+TP->name(WEM)+" den grossen Wagen.");
      break;
  case "frech":
     call_out("react", 0, "zwickt Dich in Dein Hinterteil.", "zwickt "
		     +TP->name(WEN)+" in das Hinterteil.");
      break;
  case "nett":
    call_out("react", 0, "knickst vor Dir.", "knickst vor "+TP->name(WEN)+
		    " hoeflich.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" schimpft: Genug des Guten!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
  
