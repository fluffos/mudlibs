// NPC meines Gesellenstueckes "Hexenstadt"

inherit "std/mnpc";
#include "../def.h"



void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine verweste Leiche");
  SetProp(P_LONG, "Die Leiche ist fast vollkommen verfault. Ihre Haare sind zum Teil "
     "ausgefallen und lauter Kaefer krabbeln darin herum. Selbst ihre Augen sind nur "
     "mehr kleine vertrocknete Fleischklumpen. In ihrem geoeffnetem Mund tummeln "
     "sich lauter kleine weisse Maden, die die Reste ihrer Zunge fressen.");
  SetProp(P_NAME, "Leiche");
  SetProp(P_GENDER, FEMALE); 
  AddId("leiche");
  
  create_default_npc(2+random(4));
  SetProp(P_HANDS, ({" mit ihren knochigen Fingern",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 178);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 40+random(1000));
  SetProp(P_MAX_HANDS, 10);
  SetProp(P_MSGIN, "wankt herein");
  SetProp(P_MSGOUT, "wankt");
  SetProp(P_MMSGIN, "kichert irre");
  SetProp(P_MMSGOUT, "wankt davon");

  SetProp(P_MNPC_AREA, ({ ROOM "whexe_28.lpc", ROOM "whexe_05.lpc"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "whexe_28.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);  
  SetProp(P_DIE_MSG, " zerplatzt in viele verweste Leichenteile.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Bald stinkst Du so wie ich!");
  SetProp(P_MURDER_MSG, "Mein Geist wird Dich nie wieder in Ruhe lassen!"); 
  
  AddInfo(DEFAULT_INFO, "lacht Dich nur aus.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Braucht so etwas nicht.\n" }));

  SetChats(1, ({ "Die Leiche holt sich eine Made aus dem Mund.\n",
		 "Die Leiche kichert irre.\n"}));
		

  SetAttackChats(10, ({ "Die Leiche versucht nach Dir zu greifen.\n",
			"Die Leiche lechzt nach Deinem Blut.\n"}));

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "hebt drohend ihren Zeigefinger.",
	       "droht "+TP->Name(WEM)+ "mit ihrem Zeigefinger.");
     break;

   case "aergerlich":
     call_out("react", 0, "ignoriert Dich.",
	      "ignoriert "+TP->Name(WEN)+".");
     break;

   case "frech":
     call_out("react", 0, "gibt Dir eine Ohrfeige.",
	      "gibt "+TP->Name(WEM)+" eine Ohrfeige.");
     break;
   
    default:
      call_out("react", 0, "zerzaust sich ihre Haare.",
	       "bricht sich einen Finger ab und lacht.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 

   
