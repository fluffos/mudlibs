// von Aaliyah
// 16.1.2005
// LOEWENBABY
// NPC meines Gesellenstueckes "Hexenstadt"

inherit "std/mnpc";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Loewenbaby");
  SetProp(P_LONG, "Das kleine, suesse Loewenbaby hat ein flauschig weiches "
          "Fell. Es schaut Dich mit grossen braunen Kulleraugen scheu an. "
          "Du wuerdest es am liebsten streicheln und knuddeln. ");
  SetProp(P_NAME, "Loewenbaby");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"baby","loewenbaby"}) );
  create_default_npc(2+random(4));
  SetProp(P_HANDS, ({" mit seinen kleinen Krallen",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Raubtier");
  SetProp(P_SIZE, 50);
  SetProp(P_WEIGHT, 15000);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 40+random(1000));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "tapst herein");
  SetProp(P_MSGOUT, "tapst davon");
  SetProp(P_MMSGIN, "oeffnet seine Kulleraugen");
  SetProp(P_MMSGOUT, "tapst davon");
  SetProp(P_NOATTACK, "ist viel zu suess, um getoetet zu werden.");
  
  SetProp(P_MNPC_AREA, ({ ROOM "hex_11.lpc"}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hex_11.lpc");
  SetProp(P_MNPC_FLAGS, 0);  
  SetProp(P_DIE_MSG, " bricht erbaermlich zusammen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Tut mir leid, aber ich muss mich ja wehren!");
  SetProp(P_MURDER_MSG, "Hast Du denn ueberhaupt kein Herz?");  
  AddInfo(DEFAULT_INFO, "putzt seine Pfoten.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Das Loewenbaby mag sowas nicht.\n" }));

  SetChats(3, ({ "Das Loewenbaby kuckt Dich treuherzig an.\n",
		 "Das Loewenbaby leckt Dir ueber Deine Hand.\n",
		 "Das Loewenbaby beisst Dich sanft ins Bein.\n"}));

  SetAttackChats(10, ({ "Das Loewenbaby faucht Dich an.\n",
			"Das Loewenbaby schaerft seine Krallen.\n"}));

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "blickt Dich verstoert an.",
	       "blickt "+TP->name(WEN)+ "verstoert an.");
     break;

   case "intim":
     call_out ("react", 0, "beginnt mit Dir zu spielen.",
	"beginnt mit "+TP->name(WEM)+ " zu spielen.");

    break;

   case "aergerlich":
     call_out("react", 0, "fluechtet vor Dir.",
	      "fluechtet vor "+TP->name(WEM)+".");
     break;

   case "frech":
     call_out("react", 0, "sagt: Lass mich, ich tu Dir nichts.",
	      "knurrt "+TP->name(WEN)+" scheu an.");
     break;
   
    default:
      call_out("react", 0, "schmiegt sich an Deine Beine.",
	       "schnurrt zufrieden.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 
 void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if (MENV)
    tell_room(MENV, 
      "Das Loewenbaby versteckt sich wieder hinter den Efeuranken.\n");
  remove(1);
}

   
