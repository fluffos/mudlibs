//Shila die Kraeuterfee




inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Shila, die Kraeuterfee");
  SetProp(P_LONG,
    "Shila ist eine huebsche, zierliche kleine Fee. Sie hat meerblaue Augen " 
    "und lange goldene Haare. Auf ihrem Kopf ist ein schoener Blumenkranz. "
    "Sie lebt hier seit ihrer Kindheit und kennt sich bestens mit Kraeutern " 
    "aus. Wenn Du etwas ueber Kraeuter wissen willst, frag sie einfach.");
    
  SetProp(P_NAME, "Shila, die Kraeuterfee");
  SetProp(P_GENDER, FEMALE);
  AddId(({"shila", "fee", "kraeuterfee"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("Shila");

  create_default_npc(32,1500);
  SetProp(P_HANDS, ({" mit ihren magischen Haenden",300,DT_MAGIC}));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 18000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.1, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: 0.4, DT_SOUND:  0.3, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.5, DT_POISON: 0.3, DT_TERROR: 0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.5, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_BLUDGEON:   0.1 ,DT_PIERCE: -1.0,   DT_SLASH:  0.1]) );

  SetProp(P_MSGIN, "taenzelt herein");
  SetProp(P_MSGOUT, "flattert vergnuegt davon");
  SetProp(P_MMSGIN, "flattert herunter");
  SetProp(P_MMSGOUT, "fliegt ihre Schwester suchen.");
  SetProp(P_DIE_MSG,  " zerbricht in lauter Feenstaub.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Die Hexen werden mich raechen!!");
  SetProp(P_KILL_NAME, "Shila, die Kraeuterfee");
  SetProp(P_KILL_MSG, "So seht den Karotten von unten beim Wachsen zu!");

  AddInfo(DEFAULT_INFO, "sagt: Alles kann ich auch nicht wissen.");
  
  AddInfo( ({"kamille","kamilleblueten"}), 
    "Kamille ist ein altbewaehrtes Heilmittel.", "sagt: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt die Hexen!","sagt: ");
  
  AddInfo( ({"druiden"}),
     "Druiden sind die beste Gilde!","sagt: ");
  
  AddInfo( ({"hexen"}),
     "Sie werden Euch toeten!","sagt: ");
  
  AddInfo( ({"berserker"}),
     "Was interessieren mich die Berserker?","fragt: ");
  
  AddInfo( ({"paladine"}),
     "Ayla hat noch zu selten geblutet.","sagt: ");
  
  AddInfo( ({"sex"}), 
     "Darueber spricht man nicht, dass macht man.","sagt: ");
  
  AddInfo( ({"ayla"}),
     "In der Walpurgisnacht wird sie sterben.","sagt: ");
  
  AddInfo( ({"kronang","zechus"}),
     "Das ist ein Wuerstel.","sagt: ");
  
  AddInfo( ({"anvar"}),
     "Das ist mein lieber Opa.","sagt laechelnd: ");
  
  AddInfo( ({"johanniskraut"}),
     "Das echte Johanniskraut ist gelbbluehend und eine Heilpflanze. "
     "Es blueht von Juni bis Oktober und ist auf Sand bzw Lehmboeden, "
     "an Waldraendern, offenen Weiden und Wegraendern zu finden.","sagt: ");
  
  AddInfo( ({"passionsblume"}),
     "Passiflora Edulis ist eine suedamerikanische Kletterpflanze mit "
     "farbenpraechtigen Blueten, deren Teile mit den Marterwerkzeugen "
     "Christi verglichen wurden. Sie ist ein Zauberkraut.","sagt: ");
  
  AddInfo( ({"beifuss"}),
     "Gattungsname ist Artemisia. Er wird fuer Astralreisen und prophetische "
     "Traeume verwendet. Beifusswasser nimmt man auch zum Waschen von Kristall "
     "kugeln. Weiters schafft diese Pflanze eine fuers Hellsehen guenstige "
     "Atmosphaere. Er waechst auf naehrstoffreichen Boeden.","sagt: ");
  
  AddInfo( ({"galgenmaennlein","alraun","gestalt","alraune"}),
     "Der Alraun ist die Wurzel der Mandragora und ist ein Nachtschatten "           "gewaechs. Er hat eine menschenaehnliche Gestalt und wird zur Herstellung "
     "von Liebestraenken genommen. Er waechst unter der Erde in Waldboeden.",
     " sagt: ");
     
  AddInfo( ({"ylang ylang","ylang"}),
     "Ein sehr erotisierendes Kraut.","sagt: ");

  AddInfo( ({"pflanze"}),
     "Welche Pflanze meint Ihr denn?","fragt: ");
  
  AddInfo( ({"sandelholz"}),
     "Sandelholz duftet herrlich. Kauf es doch.","sagt: ");
  
  AddInfo( ({"kardamom"}),
     "Kardamom ist ein scharfes Gewuerz aus den Samen von Ingwergewaechsen. "
     "Es wird benutzt, um Zauber zu verstaerken.","sagt: ");
  
  AddInfo( ({"basilikum","schnittlauch","petersilie","kresse"}),
     "Dieses Kraut wird zum Kochen verwendet.","sagt: ");
  
  AddInfo( ({"anis","vanille","zimt","lemongrass"}),
     "Dieses Kraut wird zum Backen verwendet.","sagt: ");
  
  AddInfo( ({"wicke"}),
     "Wicke waechst in Aeckern, Gebueschen, an Wegesraendern und auf Schutt. "
     "Sie bindet die Kraeuter in einem Zaubertrank.","sagt: ");
  
  AddInfo( ({"immortelle"}),
     "Das ist die franzoesische Strohblume. Sie gehoert zu der Gattung der "
     "Korbbluetler und waechst hier auf Sandboeden und in Gaerten. Sie "
     "bewirkt, dass die Zauber unendlich wirken.","sagt: ");
  
  AddInfo( ({"tausendgueldenkraut"}),
     "Es wird auch Centaurium pulchellum genannt. Es ist eine zierliche kleine "
     "Pflanze mit enormer Wirkung. Die Hexen verwenden es, um Tote zum Leben "
     "zu erwecken. Es waechst auf Wiesen und Ufern.","sagt: ");
  
  AddInfo( ({"nachtschatten"}),
      "Er wird auch Solanum nigrum genannt und waechst auf stickstoffreichen "
      "Lehmboeden. Er wird zur Beschwoerung der dunklen Macht verwendet und "
      "sollte nur von einer erfahrenen Hexe benutzt werden.","sagt: ");
  
  AddInfo( ({"teufelsauge"}),
      "Diese Pflanze bewirkt, dass sich der Geist mit der Materie des irdischen "
      "Koerper binden. Sie waechst auf Kalkboeden.","sagt: ");
  
  AddInfo( ({"venuskamm"}),
      "Diese Pflanze restauriert tote Koerper, die das Verwesungsstadium schon "
      "ueberschritten haben. Sie entmumifiziert und erneuert alle Zellen und "
      "Organe des Koerpers. Sie waechst auf Weinbergen.","sagt: ");
  
  AddInfo( ({"agar agar","agar"}),
      "Davon hab ich Raeucherstaebchen.","sagt: ");
  
  AddInfo( ({"lehmboeden","wiesen","kalkboeden","sandboeden","ufer"}),
      "Davon gibt es hier reichlich.","sagt laechelnd: ");
  
  AddInfo( ({"dill","thymian","salbei","rosmarin","fenchel","safran"}),
      "Wollt Ihr kochen, dann geht zu Holly!","sagt genervt: ");
  
  AddInfo( ({"schafgarbe"}),
      "Schafgarbe waechst auf Wiesen. Sie schafft eine mystische Aura fuer "
      "jegliche Art von Ritual.","sagt: ");
  
  AddInfo( ({"wermut"}),
      "Ich weiss nur das Wermut auf Aeckern waechst und das es ein sehr gutes "
      "Mittel zum Vertreiben von Boesen ist.","sagt: ");
  
  AddInfo( ({"holly"}),
      "Holly ist meine Zwillingsschwester. Wir wurden, als wir noch Babies "
      "waren, von den Hexen als Geisel genommen. Sie haben gut fuer uns gesorgt  "    
      "und haben uns, als wir aelter wurden eine Arbeit besorgt. Holly hat von "
      "ihnen das Wirtshaus bekommen und ich den Laden.","sagt: ");

   AddInfo( ({"oger"}),
      "Oger stinken fuerchterlich.","sagt grinsend: ");

   AddInfo( ({"mhyrre"}),
      "Mhyrre ist ein sehr mystisches Kraut.","sagt grinsend: ");

   AddInfo( ({"melisse"}),
      "Melisse duftet herrlich nach Zitrone. Man kann daraus einen wunderbaren "      "Tee machen.","sagt grinsend: ");

   AddInfo( ({"engelswurz"}),
      "Der Engelswurz ist eine heilige Pflanze. Wenn Ihr sie esst, werdet ihr "
      "gewiss von heiliger Macht durchflutet.","sagt grinsend: ");

   AddInfo( ({"hexenkelch","kelch"}),
      "Mit einem Hexenkelch kann man viele Rituale vollziehen. Entweder man "
      "raeuchert damit oder man braeut sich einen Trank.","sagt grinsend: ");

   AddInfo( ({"trank"}),
      "Es gibt fuer jedes Problem einen Trank.","sagt: ");

   AddInfo( ({"rituale","ritual"}),
      "Darueber muesst Ihr erst noch viel lernen.","sagt: ");

   AddInfo( ({"bolline"}),
      "Der Bolline ist ein Dolch. Hexen verwenden ihn, im Gegensatz zum "
      "Athame, zum Schneiden und Kerben.","sagt: ");

   AddInfo( ({"athame"}),
      "Der Athame ist die maechtigste Waffe der Hexen. Sie brauchen diesen "
      "Dolch, um Energien zu fuehren, um den magischen Kreis zu ziehen, Salz "
      "und Wasser damit zu vermischen sowie Beschwoerungen zu vollziehen. Man "
      "zeichnet damit auch Symbole in die Luft zB anrufende oder bannende "
      "Pentagramme.","sagt: ");


   AddInfo( ({"baldrian"}),
      "Baldrian wirkt sehr beruhigend und macht Euch mutig.","sagt grinsend: ");
   
   AddInfo( ({"kerzen"}),
      "Normalerweise zuendet man sie an.","sagt: ");

   
   AddInfo( ({"drachenblut"}),
      "Drachenblut ist das rote Harz des Baumes Draceana Cinnabari.","sagt: ");



   AddInfo( ({"kraeuter","kraut"}),
	"Ueber welches Kraut wollt Ihr denn Bescheid wissen?","fragt: ");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Shila sagt: Behaltet das mal schoen. Ich brauche es nicht.\n" }) );

  SetProp(P_SPELLRATE, 90);
  
  AddSpell(4,500,
   "Shila schlitzt Dir mit dem Sternenstab die Brust auf.\n",
   "Shila schlitzt @WEM mit ihrem Sternenstab die Brust auf.\n",
   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,700,
  "Shila beisst Dir in die Nase.\n",
  "Shila beisst @WEM in die Nase.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(8,300,		  
  "Shila reisst Dir ein grosses Bueschel Haare aus.\n",
  "Shila reisst @WEM ein grosses Bueschel Haare aus.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,1000,
  "Shila hebt ihre Arme und vernichtet Dich mit unglaublicher Magie.\n",
  "Shila vernichtet @WEN mit unglaublicher Magie.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,900,
  "Shila rammt Dir ihren Sternenstab in den Bauch.\n",
  "Shila rammt @WEM ihren Sternenstab in den Bauch.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 450, DS_BLIND);
    

  SetChats(5, ({"Shila fragt: Wollt Ihr was ueber Kraeuter erfahren?\n"}));
 
  
  SUID;
  CLONEME(WEAPON "sternenstab.lpc" );
  command("zuecke waffe");
  CLONEME(ARMOUR "skleidchen.lpc" );
  CLONEME(ARMOUR "sstiefel.lpc" );
  CLONEME(ARMOUR "blumenkranz.lpc" );
  command("trage alles");
  CLONEME(OBJ "dkralle.lpc" );
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
        call_out("react", 0, "sagt: Ihr habt keine Manieren Fremder!",
          "sagt: "+TP->name(WER)+" hat keine Manieren");
      else
        call_out("angriff",0);
      break;
  case "aergerlich":
      call_out("react", 0, "fragt: Warum geht Ihr nicht spielen, "+TPN+"?",0);
      break;
  case "traurig":
      call_out("react", 0, "nimmt Dich troestend in die Arme.",
             "troestet "+TP->name(WEN)+" sanft.");
      break;
  case "albern":
      call_out("react", 0, "laechelt.",0);
       break;
  case "neutral":
      call_out("react", 0, "ignoriert Dich.", "beachtet "+TP->name(WEN)+
		      " nicht.");
      break;
  case "intim":
      call_out("react", 0, "haut Dich.", "schlaegt "+TP->name(WEN)+" fest.");
      break;
  case "froh":
      call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "legt beschuetzend ihre Arme um Dich.",
             "umarmt "+TP->name(WEN)+" beschuetzend.");
      break;
  case "frech":
      call_out("react", 0, "grummelt Dich an.", "grummelt "+TP->name(WEN)+" an.");
      break;
  case "nett":
	          call_out("react", 0, "knuddelt Dich.", "knuddelt "
				  +TP->name(WEN)+" lieb.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" seufzt: Nun muesst Ihr sterben.\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

