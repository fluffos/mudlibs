//4.11.2004
//von Aaliyah - Gesellenstueck
//Shine die Lichthexe


inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Shine erscheint von grellem Licht umgeben.\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Shine, die Hexe des Lichtes");
  SetProp(P_LONG,
    "Vor Dir steht eine gleissend grelle Gestalt. Sie ist so hell, dass Du mit " 
    "zusammengekniffenen Augen auch nur ihre Umrisse wahrnehmen kannst. Du "
    "kannst ihre sehr langen Haaren erahnen, musst Dich jedoch abwenden, so "
    "sehr wirst Du von ihr geblendet. Trotzdem bist Du von ihrer umwerfenden "
    "Aura nahezu ueberwaeltigt.");
  
    
  SetProp(P_NAME, ({"Shine, die Lichthexe",
                  "Shine, die Lichthexe", 
                  "Shine, die Lichthexe",
                  "Shine, die Lichthexe"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"shine", "hexe", "lichthexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("shine");

  create_default_npc(35,2200);
  SetProp(P_HANDS, ({" mit gleissendem Licht",300,DT_LIGHTNING}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 84000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.0, DT_WATER:  0.2, DT_AIR:   -0.3, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: 0.2, DT_SOUND:  0.0, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  0.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    0.5, DT_MAGIC:  0.1, DT_MIND:   0.2,
      DT_PIERCE: 0.1, DT_BLUDGEON: 0.1,  DT_SLASH:     0.1]) );

  SetProp(P_MSGIN, "erscheint aus grellem Licht");
  SetProp(P_MSGOUT, "erlischt");
  SetProp(P_MMSGIN, "erscheint aus grellem Licht");
  SetProp(P_MMSGOUT, "erlischt");
  SetProp(P_DIE_MSG,  " erlischt.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Jetzt ist die ewige Flamme erloschen!");
  SetProp(P_KILL_NAME, "Shine die Lichthexe");
  SetProp(P_KILL_MSG, "Am Ende des Tunnels wartet das Licht!");

  AddInfo(DEFAULT_INFO, "sagt: Jetzt ist keine Fragestunde!");

  AddInfo( ({"jagdhexe","artemisia","freundin","waffen"}), 
    "Artemisia ist meine beste Freundin. Sie schmiedet nur fuer mich "
    "ihre Waffen.", "sagt laechelnd: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt uns Hexen!","sagt: ");
  
 
    
   SetProp( P_REJECT, ({ REJECT_KEEP,
    "Shine sagt: Dankeschoen!\n" }) );

  SetProp(P_SPELLRATE, 90);

  AddDefaultSpell(2, 600, DS_PARALYZE);
   
  AddSpell(4,800,
    "Grelle Blitze stroemen aus Shines Augen und verbrennen Dich schwer.\n",
    "Grelle Blitze aus Shines Augen verbrennen @WEN schwer.\n",
  DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(8,600,
  "Shine formt eine Lichtkugel und wirft sie nach Dir.\n",
  "Shine formt eine Lichtkugel und wirft sie nach @WEM.\n",
  DT_LIGHT,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,300,		  
  "Shine schlitzt Dir mit ihrem Lichtschwert langsam Deinen Hals auf.\n",
  "Shine schlitzt @WEM mit ihrem Lichtschwert langsam den Hals auf.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1200,
  "Shine formt ihre Haende und wirft einen Lichtspeer nach Dir.\n",
  "Shine wirft einen Lichtspeer nach @WEM.\n",
  DT_LIGHT,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
  "Shine rammt Dir ihr Lichtschwert in Dein Bein.\n.",
  "Shine rammt @WEM ihr Lichtschwert in das Bein.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
    

  SetChats(1, ({"Shine spielt mit einem Irrlicht.\n",
	         "Shine singt mystische Lieder.\n",
		 "Shine zaubert Licht herbei.\n"}));
 
  
  SUID;
   CLONEME(WEAPON "lschwert.lpc" );
   command("zuecke schwert");
   CLONEME(ARMOUR "blitzschuhe.lpc" );
   CLONEME(ARMOUR "lichtkleid.lpc" );
   CLONEME(ARMOUR "lichtumhang.lpc" );
   command("trage alles");
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

