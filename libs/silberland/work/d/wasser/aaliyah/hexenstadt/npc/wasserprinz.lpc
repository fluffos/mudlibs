// 15.1.2005 Aaliyah
// Lord Alvaro, der Wasserprinz

inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&&!InFight())
    tell_room(MENV, "Alvaro erwacht aus seinem Schlaf.\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Lord Alvaro, der Wasserprinz");
      
  SetProp(P_NAME, ({"Alvaro, der Wasserprinz",
                  "Alvaro, des Wasserprinz", 
                  "Alvaro, dem Wasserprinz",
                  "Alvaro, den Wasserprinz"}));
                  
  SetProp(P_GENDER, MALE);
  AddId(({"alvaro", "prinz", "wasserprinz","Speermeister"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("wasserprinz");

  create_default_npc(40,3000);
  SetProp(P_HANDS, ({" mit seinen sanften Haenden ",300,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 78000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:40]));  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.2, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.2, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  0.0, DT_MIND:   0.2,
      DT_SLASH:     -0.2, DT_PIERCE:  -0.5, DT_WHIP: -0.5, DT_BLUDGEON: 0.]) );

  SetProp(P_MSGIN, "schreitet majestaetisch herein");
  SetProp(P_MSGOUT, "schreitet koeniglich");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "taucht in die Tiefen des Ozans");
  SetProp(P_DIE_MSG,  " sinkt tot auf den Meeresgrund.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Welch Jammer fuer die Frauenwelt!");
  SetProp(P_KILL_NAME, "Alvaro, der Gott des Wassers");
  SetProp(P_KILL_MSG, "Ihr wart mir aber kein wuerdiger Gegner!");

  AddInfo(DEFAULT_INFO, "sagt: Ich weiss das nicht Fremder.");
  
     AddInfo( ({"calluna","geliebte"}),
     "Calluna ist meine Geliebte.","sagt: ");
  
  AddInfo( ({"aaliyah"}),
     "Aaliyah habe ich gestern heimlich vernascht.","sagt: ");
  
  AddInfo( ({"frauen","fuessen"}),
     "Alle Frauen liegen mir zu Fuessen.","sagt: ");
  
  AddInfo( ({"maenner","mann"}),
     "Kein Mann kann mir das Wasser reichen.","sagt: ");
  
  AddInfo( ({"salvia","aura","acaciah","myrica","violet","hexen","shine"}),
     "Ich habe alle Hexen schon gehabt.","sagt: ");

   AddInfo( ({"shahin","shahin"}),
     "Shahin ist eine tolle Liebhaberin.","sagt: ");
  
  AddInfo( ({"hazel"}),
     "Die ist mir zu haesslich.","sagt: ");
  
  AddInfo( ({"jade"}),
     "Jade kann richtig wild sein!","sagt: ");
  
  AddInfo( ({"ayla"}),
     "Die Puppe hat mir lange nachgetrauert.","sagt: ");
  
  AddInfo( ({"prinz"}),
     "Ich bin der einzig wahre Prinz","gibt an: ");

  AddInfo( ({"feyaria"}), 
    "Feyaria ist ganz wild nach mir.", "sagt laechelnd: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt die Hexen!","sagt: ");
  
  
  
   SetProp( P_REJECT, ({ REJECT_KEEP,
    "Alvaro sagt: Ich danke Euch!\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(4,500,
    "Alvaro schlitzt Dir mit seinem Dreizack den Bauch auf.\n",
    "Alvaro schlitzt @WEM mit seinem Dreizack den Bauch auf.\n",    
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,900,
   "Alvaro schlaegt Dir mit der Faust ins Gesicht.\n",
   "Alvaro schlaegt @WEM mit der Faust ins Gesicht.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1200,		  
   "Alvaro beschwoert eine maechtige Flutwelle.\n",
   "Alvaro vernichtet @WEN mit einer maechtigen Flutwelle.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(5,600,DS_SLOW,
   "Alvaro beschwoert einige Schlingpflanzen, die Dich behindern.\n",
   "Alvaro behindert @WEN mit einigen Schlingpflanzen.\n");
 
  
  AddSpell(5,900,
   "Alvaro reisst Dir Deine Seele aus dem Leib.\n",
   "Alvaro reisst @WEM die Seele aus dem Leib.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 600, DS_PARALYZE);
    
 
  SUID;
   CLONEME("/p/weapon/spear/dreizack" );
   command("zuecke dreizack");
   CLONEME("/p/armour/trousers/lederhose");
   command("trage alles");
   CLONEME(OBJ "wasserherz.lpc" );
}
 void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "schimpft: Wagt es nicht noch einmal Fremder!",
          "schimpft: "+TP->name(WER)+", wagt es nicht noch einmal!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "sagt: Ihr seid mit einem Fuss im Grab"+TPN+"!",0);
      break;
  case "traurig":
    call_out("react", 0, "troestet Dich "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "laechelt souveraen.",0);
       break;
  case "neutral":
    call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEM)+" zu.");
      break;
  case "intim":
    call_out("react", 0, "beginnt Dich stuermisch zu kuessen. ",
	"kuesst "+TP->name(WEN)+" stuermisch.");
      break;
  case "froh":
    call_out("react", 0, "zwinkert Dir laechelnd zu.",
             "zwinkert "+TP->name(WEM)+" laechelnd zu.");
      break;
  case "aengstlich":
    call_out("react", 0, "lacht Dich aus.",
             "lacht "+TP->name(WEN)+" aus.");
      break;
  case "frech":
    call_out("react", 0, "droht Dir mit seinem Dreizack.", "droht "
		     +TP->name(WEM)+" mit seinem Dreizack.");
      break;
  case "nett":
    call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
		    " an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" sagt: Ihr seid bald tot!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

  string long()
 {
  if( TP->QueryProp(P_GENDER)==MALE )
  SetProp(P_LONG,
    "Vor Dir steht das Abbild eines Gottes. Der Prinz hat einen schoenen " 
    "muskuloesen Oberkoerper, der Dich richtig neidisch macht. Du denkst an "
    "Deine eigenen paar Speckroellchen und musst leise seufzen. Seine langen "
    "nachtschwarzen Haare wallen ihm ueber die Schultern. Einige Muscheln "
    "haben sich darin verfangen, aber das laesst ihn zu Deinem Leidwesen nur "
    "noch interressanter wirken. Sein ganzes Erscheinungsbild ist aeusserst "
    "majestaetisch und Du wuenschst Dir, dass Du nur annaehernd so gut aussehen "
    "wuerdest wie er. Die Frauen sind gewiss ganz verrueckt nach ihm.");
  
   else
	   
    SetProp(P_LONG, 
      "Vor Dir steht das Abbild eines Gottes. Der Prinz hat einen schoenen "
      "muskuloesen Oberkoerper, der Dich richtig wild macht. Seine langen "
      "nachtschwarzen Haare wallen ihm ueber die Schultern, und wie gerne "
      "wuerdest Du Dich am liebsten in sie krallen und ihn leidenschaftlich "
      "kuessen. Einige Muscheln haben sich darin verfangen, aber das macht "
      "ihn nur noch interessanter fuer Dich. Du versinkst in seinen grossen "
      "meerblauen Augen und beginnst zu traeumen. Sein ganzes Erscheinungsbild "      "ist majestaetisch und Du wuenscht Dir, dass Du ihn einfach mit nach "
      "Hause nehmen koenntest und dass er nie mehr von Deiner Seite weicht.");
  return ::long();
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if (MENV)
    tell_room(MENV, 
      "Der Wasserprinz zerfliesst mit seinem Element.\n");
  deep_remove(1);
}

   
