//20.12.2004
//von Aaliyah
//Hazel die Hexe der Dunkelheit


inherit "std/npc";
inherit "std/npc/spells";



#include "../def.h"


void init()
{
  ::init();
   if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Hazel faucht: Jade toetet schnell, aber ich bin schneller. "                    "\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Hazel, die Hexe der Dunkelheit");
  SetProp(P_LONG,
    "Hazel ist eine Kreatur des Grauens. Ihr einst huebsches Gesicht ist " 
    "uebersaeht von eitrigen Schwielen und Brandwunden. Ihre orangenen Augaepfel "
    "sind etwas aus den Augenhoehlen hervorgetreten, und in ihren verfilzten " 
    "grauen Haaren tummeln sich Maden und Kaefer. Weiters hat sie vier Arme "
    "und zwei verstuemmelte Beine, was alles das Endprodukt eines misslungenen "
    "Zauberspruches ist. Eingehuellt in nur eine Wolldecke kauert sie am Boden.");
    
  SetProp(P_NAME, ({"Hazel, die Hexe der Dunkelheit",
                  "Hazel, die Hexe der Dunkelheit", 
                  "Hazel, die Hexe der Dunkelheit",
                  "Hazel, die Hexe der Dunkelheit"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"hazel", "hexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("hazel");

  create_default_npc(50,3000);
  SetProp(P_HANDS, ({" mit ihren Schlangenhaenden",350,DT_MAGIC}));
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 290);
  SetProp(P_WEIGHT, 150000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_BODY, QueryProp(P_BODY) + 50);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.0, DT_WATER:  -1.0, DT_AIR:  -1.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: -1.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    -1.0, DT_MAGIC:  -1.0, DT_MIND:   0.0,
      DT_PIERCE: 0.0, DT_BLUDGEON: 0.0,  DT_SLASH:     0.0]) );

  SetProp(P_MSGIN, "entsteht aus purem Hass");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint aus einer Nebelwolke");
  SetProp(P_MMSGOUT, "wird von einem schwarzen Loch verschluckt");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hex_04.lpc");
  SetProp(P_DIE_MSG,  " zerplatzt in gruenen Schleim.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Meine Bosheit wird mich raechen!");
  SetProp(P_KILL_NAME, "Hazel, die Hexe der Dunkelheit");
  SetProp(P_KILL_MSG, "Hol Deine armseligen Ueberreste hier ab!");

  AddInfo(DEFAULT_INFO, "sagt: Zeit zum Sterben Honey.");
  
    
   SetProp( P_REJECT, ({ REJECT_GIVE,
    "Hazel sagt: Danke, wenn Ihr tot seid, nehm ich mir den Rest.\n" }) );

  SetProp(P_SPELLRATE, 93);
  AddSpell(4,500,
    "Hazel zerreisst Dir mit ihren Krallen die Bauchdecke.\n",
    "Hazel zerreisst @WEN mit ihren Krallen die Bauchdecke.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,700,
  "Hazel reisst Dir saemtliche Eingeweide aus dem Koerper.\n",
  "Hazel reisst @WEM die Eingeweide aus dem Koerper.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,1000,		  
  "Hazel zerschmettert Dir mit Mysterium den Kopf.\n",
  "Hazel zerschmettert @WEM mit Mysterium den Kopf.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(5,500,
  "Hazel speit Dir Feuer ins Gesicht.\n",
  "Hazel speit @WEM Feuer ins Gesicht.\n",
  DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,700,
  "Hazel veraetzt Dich mit ihren ekligen Haenden.\n",
  "Hazel veraetzt @WEM mit ihren ekligen Haenden.\n",
  DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(5, 300, DS_ANTIMAGIC);
    

  SetChats(5, ({"Eklig verwester Geruch erfuellt den Raum.\n"}));
 
  
  SUID;
    CLONEME(WEAPON "mysterium.lpc" );
    command("zuecke mysterium");
    CLONEME(OBJ "wolldecke.lpc");
   
}

  void Attack(object enemy) 
 
{
  ModifySkillAttribute(TO, SA_SPEED, ((random(4)+1)*100), 2);
  ::Attack(enemy);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

