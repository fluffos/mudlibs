//1.1.2005
//von Aaliyah

//Salvia die Hexe der Einsamkeit


inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"


int salvia_schlaeft;
void schlafen()
{
 
  
  SetProp(P_SHORT, "Salvia liegt schlafend auf ihrem Bett");
  SetProp(P_LONG,
    "Diese wunderschoene Hexe liegt friedlich schlummernd in ihrem Bett. " 
    "Ihre langen mondweissen Haare ragen ueber das Bett bis zum Boden. "
    "Sie hat ihre Haende auf der Brust gefaltet, und es waere besser, wenn sie " 
    "nicht geweckt werden wuerde.");

  SetChats(1, ({"Salvia seufzt im Schlaf.\n",
	         "Salvia dreht sich zur Seite.\n",
		 "Salvia zieht sich die Decke hoch.\n",
		 "Salvia traeumt von ihrem Prinzen.\n"}));

   
  SetProp( P_REJECT, ({ REJECT_DROP,
                      "schlaeft doch!\n" }) );

  AddInfo(DEFAULT_INFO, "murmelt im Schlaf etwas Unverstaendliches.");
  
  salvia_schlaeft = 1;
  SetProp(P_NOATTACK, "schlaeft doch.");
  
 }

void aufwachen()
{
   SetProp(P_SHORT, "Salvia, die Hexe der Einsamkeit");
   SetProp(P_LONG,
    "Vor Dir steht Salvia und ist aeusserst wuetend, dass Du sie geweckt hast. "
    "Ihre langen mondweissen Haare wehen im Wind, und sie funkelt Dich mit "
    "ihren blassblauen Augen zornig an. Sie ist noch etwas zerknautscht vom " 
    "Schlafen, was aber nicht ihre Kampfesqualitaet beeintraechtigt. Da sie "
    "eine Meisterin des Schwertkampfes ist, ist sie auch dieser Situation "
    "gewachsen.");

   SetChats(0, ({}) );

    
  SetProp( P_REJECT, ({ REJECT_DROP,
                        "ist zu wuetend\n" }) );

  AddInfo(DEFAULT_INFO, "schreit: Du wagst es, mir Fragen zu stellen?");

  salvia_schlaeft = 0;
  SetProp(P_NOATTACK, 0); 

  tell_room(ENV(TO), "Salvia wacht veraergert auf.\n");
  command("zuecke schwert");
  Kill(TP);  
} 

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  schlafen();
 
 
  SetProp(P_NAME, ({"Salvia, die Hexe der Einsamkeit",
                   "Salvia, die Hexe der Einsamkeit", 
                   "Salvia, die Hexe der Einsamkeit",
                   "Salvia, die Hexe der Einsamkeit"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"salvia", "hexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("salvia");

  create_default_npc(40,2000);
  SetProp(P_HANDS, ({" mit purem Hass",300,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 210);
  SetProp(P_WEIGHT, 90000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:    0.5, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.2, DT_POISON: 0.3, DT_TERROR: -1.0,
      DT_HOLY:      0.2, DT_UNHOLY:    0.1, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_PIERCE: -1.0, DT_BLUDGEON: 0.1,  DT_SLASH:     0.1]) ); 
  
  SetProp(P_MSGIN, "richtet sich in ihrem Himmelbett auf");
  SetProp(P_MSGOUT, "geht anmutig");
  SetProp(P_MMSGIN, "erwacht aus tiefem Schlaf");
  SetProp(P_MMSGOUT, "legt sich in ihr Himmelbett");
  SetProp(P_MNPC_AREA, "hex_11.lpc" );
  SetProp(P_DIE_MSG,  " sinkt tot in ihr Bett.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Jetzt weckt mich niemand mehr auf!");
  SetProp(P_KILL_NAME, "Salvia, die Hexe der Einsamkeit");
  SetProp(P_KILL_MSG, "Moeget Ihr auf Rosen ewig schlafen!");

    
  SetProp(P_SPELLRATE, 90);
  
  AddSpell(4,700,
    "Salvia fuegt Dir mit ihrem Schwert tiefe Wunden zu.\n",
    "Salvia fuegt @WEM mit ihrem Schwert tiefe Wunden zu.\n",
  DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(8,900,
  "Salvia verletzt Dich mit ein paar dornigen Rosen.\n",
  "Salvia verletzt @WEN mit ein paar dornigen Rosen.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(6,500,DS_POISON);
  
  AddSpell(8,600,		  
  "Salvia zerkratzt Dir mit ihren Fingernaegeln das Gesicht.\n",
  "Salvia zerkratzt @WEM mit ihren Fingernaegeln das Gesicht.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

   AddSpell(2,2000,		  
  "Salvia versucht Dich mit ihrer Bettdecke zu ersticken.\n",
  "Salvia versucht @WEN mit ihrer Bettdecke zu ersticken.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));

   AddDefaultSpell(3, 450, DS_BLIND);
  
   
  
  SUID;
    CLONEME(WEAPON "salschwert.lpc" );
    CLONEME(ARMOUR "skleid.lpc" );
     command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (salvia_schlaeft && touch)
  {
   
   call_out("aufwachen", 2);
    
   
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void reset()
{
  if(!is_clone(TO)) return;
  ::reset(); 
  if (!salvia_schlaeft && !InFight())
  { 
    command("stecke schwert zurueck");
    tell_room(ENV(TO), "Salvia schlaeft wieder ein.\n");
    schlafen();
  }
  set_next_reset(10 * 60); 
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

