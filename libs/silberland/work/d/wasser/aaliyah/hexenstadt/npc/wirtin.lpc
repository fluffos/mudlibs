//4.12.2005
//von Aaliyah - Gesellenstueck
//Holly die Feenwirtin


inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Holly, die Feenwirtin");
  SetProp(P_LONG,
    "Holly ist eine huebsche, zierliche kleine Fee. Sie hat meerblaue Augen " 
    "und lange goldene Haare. Auf ihrem Kopf hat sie eine Glockenblume, die "
    "ihr wohl als Hut dient. Sie ist ein aeusserst gutmuetiges Feelein und " 
    "liebt es, ihre Gaeste mit diversen Leckereien zu verwoehnen.");
    
   SetProp(P_NAME, ({"Holly, die Feenwirtin",
                  "Holly, der Feenwirtin", 
                  "Holly, der Feenwirtin",
                  "Holly, die Feenwirtin"}));
   
  SetProp(P_GENDER, FEMALE);
  AddId(({"holly", "fee", "wirtin","feenwirtin"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("Holly");

  create_default_npc(29,1500);
  SetProp(P_HANDS, ({" mit unglaublicher Magie",300,DT_MAGIC}));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 60);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,40);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.1, DT_WATER:  0.1, DT_AIR:   -1.0, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: 0.5, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      0.5, DT_POISON: 0.3, DT_TERROR: 0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.2, DT_MAGIC:  -1.0, DT_MIND:   0.2,
      DT_SLASH:     0.1, DT_PIERCE:   0.1, DT_BLUDGEON: 0.1]) );

  SetProp(P_MSGIN, "flirrt vergnuegt herein");
  SetProp(P_MSGOUT, "flirrt vergnuegt davon");
  SetProp(P_MMSGIN, "flattert herunter");
  SetProp(P_MMSGOUT, "flattert summend davon");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "kneipe.lpc");
  SetProp(P_DIE_MSG,  " zerbricht in lauter Feenstaub.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Die Hexen werden mich raechen!!");
  SetProp(P_KILL_NAME, "Holly die Guetige");
  SetProp(P_KILL_MSG, "Es tut mir so unendlich leid!");

  AddInfo(DEFAULT_INFO, "sagt: Das kann ich Euch leider nicht sagen.");
  
  AddInfo( ({"kamille","kamilleblueten"}), 
    "Kamille ist ein altbewaehrtes Heilmittel.", "sagt: ");

  AddInfo( ({"shahin"}),
      "Shahin ist mir zu frostig.","sagt: ");

  AddInfo( ({"shine","morrighan","myrica","violet"}),
      "Ich laestere nicht so gern ueber die Hexen.","sagt: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt die Hexen!","sagt: ");
    
  AddInfo( ({"druiden"}),
     "Druiden sind die beste Gilde!","sagt: ");
     
  AddInfo( ({"hexen"}),
     "Sie werden Dich toeten!","sagt: ");
     
  AddInfo( ({"berserker"}),
     "Was interessieren mich die Berserker?","fragt: ");
     
  AddInfo( ({"paladine"}),
     "Ayla hat noch zu selten geblutet?","sagt: ");
      
  AddInfo( ({"ayla"}),
     "In der Walpurgisnacht wird sie sterben.","sagt: ");
     
  AddInfo( ({"kronang","zechus"}),
     "Lass mich mit dem Macho in Ruhe!","schimpft: ");
  
  AddInfo( ({"anvar"}),
     "Das ist mein lieber Opa.","sagt laechelnd: ");
     
  AddInfo( ({"kraut","kraeuter"}),
     "Frag doch Shila, meine liebe Schwester. Sie kennt sich auf diesem Gebiet "
     "hervorragend aus.","sagt: ");
 
  AddInfo( ({"essen","trinken"}),
     "Ich koche alles aus frischen Zutaten.","sagt: ");
   
  AddInfo( ({"kessel"}),
     "Mit dem Kessel raeuchert man Kraeuter fuer Rituale, oder man braut darin "
     "gewisse Traenke zusammen. Jeder Trank hat einen bestimmten Sinn und nur "
     "erfahrene Hexen koennen damit Zaubern.","sagt: ");
     
 AddInfo( ({"hexe","hexen"}),
     "Welche Hexe meint Ihr? Im Dorf leben 12 Hexen. Acaciah, Hazel, Aura, "
     "Jade, Artemisia, Shine, Shahin, Morrighan, Salvia, Myrica, Violet und "
     "Calluna. Ach da war ja noch eine 13. Hexe. Leider ist sie sehr frueh "
     "von uns gegangen. An ihren Namen kann ich mich leider nicht mehr "
     "erinnern. Aber als Kinder nannten Shila und ich sie immer 'Nana'" ,"sagt: ");
     
  AddInfo( ({"nana"}),
     "Astarel hat sie getoetet. Es hat mir das Herz gebrochen.","sagt: ");
     
  AddInfo( ({"astarel"}),
     "Astarel war einst der groesste Krieger des Landes. Er wurde getoetet "
     "und man munkelt, dass sein Geist noch auf der Insel ist.","sagt: ");
     
  AddInfo( ({"aura"}),
     "Aura ist die Hexe des Mondes. Sie hat ein Stueck des Sternenhimmels zu "
     "ihrem Haus gemacht. Sie ist sehr sehr launisch.","sagt: ");
     
  AddInfo( ({"hazel"}),
     "Hazel ist die Hexe der Dunkelheit. Sie war mal eine wunderschoene junge "
     "Frau. Leider ist ihr ein Zauber missglueckt und entstellte sie. Deshalb "
     "hat sie ihr Haus komplett dunkel gemacht und verlaesst es nie. So sieht "
     "keiner ihre Missbildungen. Huete Dich vor ihr. Sie ist wirklich die "          "Bosheit in Person.","sagt: "); 
     
  AddInfo( ({"calluna"}),
     "Calluna ist die Hexe des Meeres. Man munkelt, dass sie einen Liebhaber in "
     "ihrem Haus versteckt haelt, jedoch wissen tut es keiner.","sagt: ");
     
  AddInfo( ({"acaciah"}),
     "Acaciah ist die Hexe der Blumen. Sie stellt wunderschoene Blumenkraenze "
     "her. Von ihr haben Shila und ich unsere Huete.","sagt: ");
     
  AddInfo( ({"salvia"}),
     "Salvia ist die Hexe der Einsamkeit. Sie war die Schwester von meiner "
     "Nana und hat sich nach deren Tod komplett zurueckgezogen.","sagt: ");
     
  AddInfo( ({"jade"}),
     "Jade ist die Hexe des Todes. Ooohhh huete Dich vor ihr. Sie toetet jeden, "
     "der in ihre Naehe kommt.","sagt: ");
     
  AddInfo( ({"artemisia"}),
      "Artemisia ist die Hexe der Jagd. Sie stellt die besten Waffen her. Sie "
      "macht viele Spezialanfertigungen zu einem guten Preis.","sagt: ");
      
  AddInfo( ({"teufelsauge"}),
      "Diese Pflanze bewirkt, dass sich der Geist mit der Materie des irdischen "
      "Koerper binden. Sie waechst auf Kalkboeden.","sagt: ");
      
  AddInfo( ({"venuskamm"}),
      "Diese Pflanze restauriert tote Koerper, die das Verwesungsstadium schon "
      "ueberschritten haben. Sie entmumifiziert und erneuert alle Zellen und "
      "Organe des Koerpers. Sie waechst auf Weinbergen.","sagt: ");
      
  AddInfo( ({"agar agar","agar"}),
      "Davon hab ich Raeucherstaebchen.","sagt: ");
      
  AddInfo( ({"lehmboeden","wiesen","kalkboeden","sandboeden","ufer"}),
      "Davon gibt es hier reichlich.","sagt laechelnd: ");
      
  AddInfo( ({"dill","thymian","salbei","rosmarin","fenchel","safran"}),
      "Willst Du kochen dann geh zu Holly!","sagt genervt: ");
      
  AddInfo( ({"schafgarbe"}),
      "Schafgarbe waechst auf Wiesen. Sie schafft eine mystische Aura fuer "
      "jeglicher Art von Ritual.","sagt: ");
      
  AddInfo( ({"wermut"}),
      "Ich weiss nur das Wermut auf Aeckern waechst und das es ein sehr gutes "
      "Mittel zum Vertreiben von Boesen ist.","sagt: ");
      
  AddInfo( ({"shila"}),
      "Shila ist meine Zwillingsschwester. Wir wurden, als wir noch Babies "
      "waren, von den Hexen als Geisel genommen. Sie haben gut fuer uns gesorgt "  
      "und haben uns als wir aelter wurden, eine Arbeit besorgt. Shila hat von "
      "ihnen den Laden bekommen und ich das Wirtshaus.","sagt: ");
  
  AddInfo( ({"feyaria"}),
      "Feyaria ist die Mutter der Berserker.","sagt: ");
      
  AddInfo( ({"atreju"}),
      "Atreju ist einer, der besten Krieger im ganzen Land.","sagt: ");
      
  AddInfo( ({"fenris"}),
      "Fenris ist der schoenste aller Elfenmaenner."," schwaermt: ");
      
  AddInfo( ({"andruil"}),
      "Andruil war eine Legende."," seufzt: ");
      
  AddInfo( ({"zidane"}),
      "Zidane ist ein kleiner frecher Elf."," sagt: ");
      
  AddInfo( ({"turgon"}),
      "Turgon ist ein sehr maechtiger Druide."," erklaert: ");
      
  AddInfo( ({"willi","rambo"}),
      "Willi ist ein Zwerg, und ich finde Zwerge unerotisch.","sagt: ");
      
  AddInfo( ({"andronicus"}),
      "Andronicus ist einer der liebsten Paladine.","schwaermt: ");
      
  AddInfo( ({"gilagas"}),
      "Ach Gilagas hat mich leider nicht gewollt.","seufzt: ");
      
  AddInfo( ({"lovetah"}),
      "Lovetah ist ein sehr mutiger Berserker.","sagt: ");
      
  AddInfo( ({"aaliyah"}),
      "Aaliyah ist die Mutter aller Hexen.","sagt: ");

   SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Holly taetschelt Dir den Kopf.\n" }) );

  SetProp(P_SPELLRATE, 99);
  AddSpell(4,550,
    "Holly schlitzt Dir mit dem Sternenstab die Brust auf.\n",
    "Holly schlitzt @WEM mit ihrem Sternenstab die Brust auf.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1200,
  "Holly schaut Dir tief in Deine Seele.\n",
  "Holly durchdringt @WEN mit ihren Augen.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,800,
  "Holly reisst Dir ein grosses Bueschel Haare aus.\n",
  "Holly reisst @WEM ein grosses Bueschel Haare aus.\n",
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,1000,
  "Holly hebt ihre Arme und vernichtet Dich mit unglaublicher Magie.\n",
  "Holly vernichtet @WEN mit unglaublicher Magie.\n",
  DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
  "Holly rammt Dir ihren Sternenstab in den Bauch.\n",
  "Holly rammt @WEM ihren Sternenstab in den Bauch.\n",
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
    
  AddDefaultSpell(3, 1000, DS_FROG);

  SetChats(1, ({"Holly fragt: Moechtet Ihr was essen Fremder?\n",
     "Holly seufzt: Ich hoffe, die Hexen fuegen Euch keine Schmerzen zu.\n",
     "Holly sagt: Kostet den Nachtschatten, er mundet Euch gewiss.\n"}));
  
  SUID;
  CLONEME(WEAPON "sternenstab" );
  command("zuecke waffe");
  CLONEME(ARMOUR "blumenkleid.lpc" );
  CLONEME(ARMOUR "sstiefel.lpc" );
  CLONEME(ARMOUR "glockenblume.lpc" );
  CLONEME(ARMOUR "sschuerze.lpc" );
  CLONEME(OBJ "magma.lpc" );
  command("trage alles");
}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
   case "fies":
      if( random(2) )
        call_out("react", 0, "sagt: Ihr habt keine Manieren Fremder!",
          "sagt: "+TP->name(WER)+" hat keine Manieren");
      else
        call_out("angriff",0);
      break;
   case "aergerlich":
      call_out("react", 0, "fragt: Warum geht Ihr nicht spielen, "+TPN+"?",0);
      break;
   case "traurig":
      call_out("react", 0, "nimmt Dich troestend in die Arme.",
             "troestet "+TP->name(WEN)+" sanft.");
      break;
   case "albern":
      call_out("react", 0, "laechelt.",0);
       break;
    case "neutral":
      call_out("react", 0, "ignoriert Dich.", "beachtet "+TP->name(WEN)+
		      " nicht.");
      break;
    case "intim":
      call_out("react", 0, "haut Dich.", "schlaegt "+TP->name(WEN)+" fest.");
      break;
    case "froh":
      call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "legt beschuetzend ihre Arme um Dich.",
             "umarmt "+TP->name(WEN)+" beschuetzend.");
      break;
    case "frech":
      call_out("react", 0, "grummelt Dich an.", "grummelt "+TP->name(WEN)+" an.");
      break;
    case "nett":
	          call_out("react", 0, "knuddelt Dich.", "knuddelt "
				  +TP->name(WEN)+" lieb.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" seufzt: Nun muesst Ihr sterben.\n");
    Kill(TP);
  }
}

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

