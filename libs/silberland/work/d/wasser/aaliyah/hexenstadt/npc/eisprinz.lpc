// 15.1.2005 Aaliyah
// Prinz Sidharta der Gott des Eises

inherit "std/npc";
inherit "std/npc/spells";


#include "../def.h"


void init()
{
  ::init();
  if (find_call_out("hallo") != -1)  
  call_out("hallo",TP,0);
  
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&&!InFight())
    tell_room(MENV, "Prinz Sidharta wird lebendig.\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Prinz Sidharta, der Gott des Eises");
      
  SetProp(P_NAME, ({"Sidharta, der Eisprinz",
                  "Sidharta, des Eisprinz", 
                  "Sidharta, dem Eisprinz",
                  "Sidharta, den Eisprinz"}));
                  
  SetProp(P_GENDER, MALE);
  AddId(({"sidharta", "prinz", "eisprinz"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("eisprinz");

  create_default_npc(40,4000);
  SetProp(P_HANDS, ({" mit seinen sanften Haenden ",300,DT_COLD}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:40]));  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.2, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.2, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      -1.0, DT_UNHOLY:    0.2, DT_MAGIC:  0.1, DT_MIND:   0.2,
      DT_SLASH:     -0.2, DT_PIERCE:  0.1, DT_WHIP:  0.0, DT_BLUDGEON: 0.1]) );

  SetProp(P_MSGIN, "verneigt sich vor Dir");
  SetProp(P_MSGOUT, "schreitet koeniglich");
  SetProp(P_MMSGIN, "entsteht aus einer eisigen Wolke");
  SetProp(P_MMSGOUT, "verschwindet so schnell wie er gekommen ist");
  SetProp(P_DIE_MSG,  " zerbricht in lauter Eissplitter.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Der Adel wird weiterleben!");
  SetProp(P_KILL_NAME, "Sidharta der Gott der Eises");
  SetProp(P_KILL_MSG, "Der Zorn der Goetter sei mit Euch!");

  AddInfo(DEFAULT_INFO, "sagt: Ich weiss das nicht, Fremder.");
  
     AddInfo( ({"calluna"}),
     "Calluna ist eine aeusserst attraktive Frau.","sagt: ");
  
  AddInfo( ({"aaliyah"}),
     "Aaliyah laesst sich gerne von mir streicheln.","sagt: ");
  
  AddInfo( ({"frauen","fuessen","fuesse"}),
     "Alle Frauen liegen mir zu Fuessen.","sagt: ");
  
  AddInfo( ({"maenner","mann"}),
     "Kein Mann kann mir das Wasser reichen.","sagt: ");
  
  AddInfo( ({"salvia","aura","acaciah","myrica","violet","hexen","shine"}),
     "Ich habe alle Hexen schon gehabt.","sagt: ");

   AddInfo( ({"shahin","geliebte"}),
     "Shahin ist meine Geliebte.","sagt: ");
  
  AddInfo( ({"hazel"}),
     "Die ist mir zu haesslich.","sagt: ");
  
  AddInfo( ({"jade"}),
     "Jade kann richtig wild sein!","sagt: ");
  
  AddInfo( ({"ayla"}),
     "Ayla ist sauer auf mich, weil ich sie nicht wollte.","sagt: ");
  
  AddInfo( ({"prinz"}),
     "Ich bin der einzig wahre Prinz","gibt an: ");

  AddInfo( ({"feyaria"}), 
    "Mit Feyaria hatte ich eine schoene Nacht.", "sagt laechelnd: ");
  
  AddInfo( ({"aradia"}),
    "Aradia besuche ich oefters mal","sagt zwinkernd: ");
  
  
  
   SetProp( P_REJECT, ({ REJECT_GIVE,
    "Sidharta sagt: Ich brauche sowas nicht!\n" }) );

  SetProp(P_SPELLRATE, 80);
  AddSpell(4,400,
    "Sidharta schwingt sein Schwert und verletzt Dich dabei.\n",
    "Sidharta verletzt @WEN mit seinem Schwert.\n",    
  DT_RIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,500,
   "Sidharta schlaegt Dir mit der Faust Dein Gesicht blutig.\n",
   "Sidharta schlaegt @WEM mit der Faust ins Gesicht.\n",
  DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1800,		  
   "Sidharta beschwoert einen gigantischen Schneesturm.\n",
   "Sidharta vernichtet @WEN mit einem gigantischen Schneesturm.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));
  
  AddDefaultSpell(5,300,DS_SLOW,
   "Sidharta legt seine Haende auf Dich und laesst Dich einfrieren.\n",
   "Sidharta legt seine Haende auf @WEN und friert @PWEN ein.\n");
 
  
  AddSpell(5,500,
   "Sidharta liest Deine Gedanken.\n",
   "Sidharta liest die Gedanken von @WEM.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 600, DS_PARALYZE);
    
 
  SUID;
   CLONEME(WEAPON "rauhreif.lpc" );
   command("zuecke rauhreif");
   CLONEME("/d/polar/lamuerte/eishoehle/obj/eishose");
   CLONEME("/d/polar/lamuerte/eishoehle/obj/eisschienen");
   CLONEME("/d/polar/lamuerte/eishoehle/obj/eisstiefel"); 
   command("trage alles");
   CLONEME(OBJ "prinzenherz.lpc" );
}
 void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "schimpft: Wagt es nicht noch einmal Fremder!",
          "schimpft: "+TP->name(WER)+" wagt es nicht noch einmal!");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "schimpft: Wo bleibt Euer Respekt"+TPN+"?!",0);
      break;
  case "traurig":
    call_out("react", 0, "troestet Dich "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "laechelt charmant.",0);
       break;
  case "neutral":
    call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEM)+" zu.");
      break;
  case "intim":
    call_out("react", 0, "streichelt Dich. ",
	"streichelt "+TP->name(WEN)+".");
      break;
  case "froh":
    call_out("react", 0, "zwinkert Dir laechelnd zu.",
             "zwinkert "+TP->name(WEM)+" laechelnd zu.");
      break;
  case "aengstlich":
    call_out("react", 0, "lacht Dich aus.",
             "lacht "+TP->name(WEN)+" aus.");
      break;
  case "frech":
    call_out("react", 0, "droht Dir mit seinem Dreizack.", "droht "
		     +TP->name(WEM)+" mit seinem Dreizack.");
      break;
  case "nett":
    call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
		    " an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" sagt: Ich werde Euch Respekt lehren!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}

  string long()
 {
  if( TP->QueryProp(P_GENDER)==MALE )
  SetProp(P_LONG,
    "Der Prinz ist goettlich. Sein muskuloeser Oberkoerper laesst Dich vor " 
    "Neid erblassen. In seinen langen schneeweissen Haaren sind lauter kleine "
    "Zoepfe geflochten. Viele kleine Eiskristalle glitzern darin und funkeln "
    "im Sonnenlicht. Seine eisblauen Augen starren Dich kuehl an, aber Du "
    "bewunderst seine endlos langen Wimpern, die jedes Auge malerisch umrahmen. "
    "Seine Ausstrahlung ueberwaeltigt Dich, und Du denkst an die vielen Frauen, "
    "die ihm wohl scharenweise hinterherlaufen. Der Neid packt Dich. Du "
    "wuerdest ihm am liebsten an die Kehle springen. Seine Gesichtszuege "
    "sind so fein und edel, wie Du sie niemals haben wirst.");
  
   else
	   
    SetProp(P_LONG, 
      "Vor Dir steht wahrlich ein Gott. Sein Oberkoerper ist dermassen "
      "muskuloes, dass Du Deine Blicke nicht von ihm abwenden kannst. In "
      "seinen langen schneeweissen Haaren sind viele kleine Zoepfe geflochten "
      "und verleihen ihm ein wildes Aussehen. Lauter kleine Eiskristalle "
      "funkeln darin. Dein Blick versinkt in seinen grossen eisblauen Augen, "
      "die Dich vertraeumt anschauen. Lange schwarze Wimpern umranden sie "
      "malerisch. Seine Ausstrahlung ist so uebewaeltigend, dass Du wie gebannt "
      "bist. Das ist mit Abstand der schoenste Mann, den Du je gesehen hast und "
      "Du fuehlst Dich dermassen von ihm angezogen, dass Du Dich nur mit grosser "      "Muehe beherrschen kannst, keine Dummheiten zu machen.");
  return ::long();
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
 void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if (MENV)
    tell_room(MENV, 
      "Sidharta verneigt sich vor Dir und verschwindet.\n");
  deep_remove(1);
}

   
