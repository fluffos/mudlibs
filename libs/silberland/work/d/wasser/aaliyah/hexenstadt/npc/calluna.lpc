inherit "std/npc";


#include "../def.h"



void init()
{ 
  ::init();
 if (getuid(TP) == "karpfen" && find_call_out("karpfen")==-1)
   call_out("karpfen", 0);
 else if (find_call_out("hallo") == -1)
   call_out("hallo",0);
}


void hallo()
{

  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Calluna saeuselt: Willkommen in meinem Reich!\n");
}
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Calluna, die Meerjungfrau");
  SetProp(P_LONG,
    "Calluna ist das exakte Abbild einer Goettin. So wunderschoen ist sie. " 
    "Ihre langen blonden Haare umschmeicheln ihre zarten Schultern. Einige "
    "schillernde Muscheln befinden sich darin. Ihre grossen meerblauen Augen " 
    "strahlen in ihrem zierlichen Gesicht. Ihre schoen geschwungene Flosse "
    "schimmert perlmuttgruen im Sonnenlicht. Sie ist mit Karpfen verheiratet.");
    
  SetProp(P_NAME, ({"Calluna, die Meerjungfrau",
                  "Calluna, der Meerjungfrau", 
                  "Calluna, der Meerjungfrau",
                  "Calluna, die Meerjungfrau"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"calluna", "hexe", "meerjungfrau","Speermeister" }));
  SetProp(P_ARTICLE, 0);
  set_living_name("calluna");

  create_default_npc(40,3000);
  SetProp(P_HANDS, ({" mit ihren Schwanzflosse ",300,DT_MAGIC}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 198);
  SetProp(P_WEIGHT, 74000);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:   0.1, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      -0.1, DT_POISON: -0.3, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    -0.5, DT_MAGIC:  -1.0, DT_MIND:   0.2,
     DT_SLASH:     -0.3, DT_PIERCE:  -0.3, DT_WHIP: -0.5, DT_BLUDGEON: -0.5]) );

  SetProp(P_MSGIN, "taucht aus den Tiefen des Ozeans auf");
  SetProp(P_MSGOUT, "schwimmt mit den Wellen");
  SetProp(P_MMSGIN, "taucht aus den Tiefen des Ozeans auf");
  SetProp(P_MMSGOUT, "verschwindet in den Tiefen des Ozeans");
  SetProp(P_MNPC_AREA, "hex_20.lpc" );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hex_20.lpc");
  SetProp(P_DIE_MSG,  " taucht leblos unter.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste Mal erschlag ich Dich %s.");
  SetProp(P_KILL_NAME, "Calluna, die Meerjungfrau");
  SetProp(P_KILL_MSG, "Deine Leiche verpestet meinen Ozean!");
  SetProp(P_BODY, QueryProp(P_BODY) + 100);
  

  AddInfo(DEFAULT_INFO, "sagt: Das werdet Ihr nie erfahren Fremder.");
  
  AddInfo( ({"jade","todeshexe"}), 
    "Jade wird Euch gewiss schnell toeten.", "sagt laechelnd: ");
  
  AddInfo( ({"aradia"}),
    "Aradia beschuetzt uns Hexen!","sagt: ");
  
  AddInfo( ({"druiden","berserker","paladine","nekromanten","zechpreller"}),
     "Ich habe keine Ahnung von Gilden.","sagt: " );
  
  AddInfo( ({"tod"}),
     "Wir werden Euch toeten!","sagt: ");
  
  AddInfo( ({"hexen"}),
     "Ich treffe sie nur, wenn sie zum Schwimmen kommen.","sagt: ");
  
  AddInfo( ({"schwimmen"}),
     "Meistens kommt Salvia und Acaciah zu mir.","sagt: ");
  
  AddInfo( ({"salvia"}), 
     "Das ist eine meiner besten Freundinnen. Sie verbringt die meiste "
     "Zeit mit Schlafen.","sagt: ");
  
  AddInfo( ({"ayla"}),
     "In der Walpurgisnacht wird sie sterben.","sagt: ");
  
  AddInfo( ({"kronang","zechus"}),
     "Der ist nicht einmal erwaehnenswert.","lacht: ");
  
  AddInfo( ({"anvar","tattergreis"}),
     "Der alte Tattergreis hat schon viel zulange gelebt.","sagt laechelnd: ");
  
  AddInfo( ({"acaciah"}),
     "Acaciah ist eine meiner besten Freundinnen. Ich umgebe mich gerne mit "
     "schoenen Wesen. Sie ist zwar nicht annaehernd so schoen wie ich, aber "
     "sie ist dennoch schoen anzusehen.","erzaehlt: ");
  
  AddInfo( ({"meer","ozean"}),
     "Ich bin die Hueterin des Ozeans und die Herrscherin aller Meere und "
     "all deren Lebewesen.","sagt: ");
  
  AddInfo( ({"hueterin","herrscherin"}),
     "Das bin ich.","sagt: ");
     
  AddInfo( ({"lebewesen"}),
     "Der Ozean ist nicht nur meine Heimat, sondern auch das Zuhause von "
     "unzaehligen Fischen, Krebsen und Saeugetieren.","sagt: ");
     
  AddInfo( ({"heimat","zuhause"}),
     "Der Ozean ist meine Heimat.","sagt: ");
  
  AddInfo( ({"fische","fischen","fisch"}),
     "Schwertfische, Zander, Thunfische, Haie und noch viele andere "
     "Fische leben hier.","sagt: ");
  
  AddInfo( ({"saeugetiere","saeugetier"}),
     "Delfine, Wale und Robben.","sagt: ");
  
  AddInfo( ({"aura","shahin","myrica","morrighan"}),
     "Sie ist mir eigentlich egal.","sagt: ");
  
  AddInfo( ({"hazel","jade","shine","artemisia"}),
     "Die ist so boese, da halte ich mich sogar fern.","sagt: ");
  
  AddInfo( ({"korallen","koralle"}),
     "Es gibt hier wunderschoene Korallen.","sagt: ");
  
  
  AddInfo( ({"prinz"}),
      "Alvaro ist mein Prinz. Ich habe ihn sehr gut versteckt, damit ihn "
      "die anderen Hexen nicht finden koennen. Er ist mein Eigentum und "
      "wird es auf ewig bleiben.","fluestert: ");
  
  AddInfo( ({"schoenheitsschlaf"}),
      "Schoenheitsschlaf ist wichtig. Guck doch mal meine reine Haut an. "
      "Trotzdem finde ich, dass Salvia etwas uebertreibt.","sagt: ");
  
  AddInfo( ({"prinzen"}),
      "Man munkelt, dass es hier zwei Prinzen gibt. Sie sind die Liebhaber der "
      "Hexen und werden von ihnen versteckt, da sie sonst von den anderen Hexen "
      "mit grosser Sicherheit getoetet werden.","sagt: ");
  
  AddInfo( ({"haut"}),
      "Ich habe die zarteste Haut.","kichert: ");

   AddInfo( ({"karpfen","ehemann"}),
      "Karpfen ist mein lieber Ehemann. Ich habe ihn in einer romantischen "
      "Bucht kennen gelernt. Ich liebe ihn wie am ersten Tag unserer "
      "Begegnung und ich glaube das wird immer so bleiben.","schwaermt: ");
  
  
  AddInfo( ({"liebhaber"}),
      "Einer der Prinzen ist mein Liebhaber. Ich habe ihn gut versteckt, "
      "also werdet Ihr ihn nicht finden.","fluestert: ");
  
  AddInfo( ({"haie","hai"}),
      "Die tummeln sich gerade unter Euch und freuen sich auf den baldigen "
      "Leckerbissen.","sagt: ");
  
  AddInfo( ({"eigentum"}),
      "Der Prinz gehoert mir. Ich habe die Macht ueber ihn und seine Liebe "
      "und somit wird er mich niemals verlassen koennen.","sagt: ");
  
  AddInfo( ({"holly","shila"}),
      "Die sind ganz nett. Die eine kocht gut, die andere besorgt mir meine "
      "Zutaten fuer die Rituale.","sagt: ");

   AddInfo( ({"liebe"}),
      "Ich erzaehle Euch gewiss nichts ueber Liebe, Fremder.","sagt: ");

  

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Calluna sagt: Dieses Geschenk ist nicht wuerdig einer Goettin.\n" }) );

  SetProp(P_SPELLRATE, 90);
  AddSpell(6,450,
    "Calluna schlitzt Dir mit dem Dreizack die Brust auf.\n",
    "Calluna schlitzt @WEM mit ihrem Dreizack die Brust auf.\n",    
  DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,2000,
  "Calluna drueckt Dich unter die Wasseroberflaeche.\n",
  "Calluna drueckt @WEN unter die Wasseroberflaeche.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,450,		  
  "Calluna peitscht Dich mit ihrer Schwanzflosse.\n",
  "Calluna peitscht @WEN mit ihrer Schwanzflosse.\n",
  DT_WHIP,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(7,500,
  "Calluna beschwoert eine gigantische Welle.\n",
  "Eine gigantische Welle bricht ueber @WEM herein.\n",
  DT_WATER,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
  "Callunas maechtige Schwanzflosse katapultiert Dich aus dem Raum.\n",
  "Callunas Schwanzflosse katapultiert @WEN aus dem Raum.\n",
  DT_BLUDGEON, "wegschleudern",([SP_SHOW_DAMAGE:1]));
    

  SetChats(10, ({"Calluna streichelt einen Delfin.\n",
		 "Calluna zeigt Dir eine wunderschoene Perle.\n",
		 "Calluna streicht mit der Hand ueber das Wasser.\n",}));
 
  
  SUID;
    CLONEME("/p/weapon/spear/dreizack" );
    command("zuecke dreizack");
    CLONEME(ARMOUR "hauch.lpc" );
    command("trage alles");
    CLONEME(OBJ "perle.lpc" );
    CLONEME("/p/std/skills/sewing_tanning/obj/magieseide.lpc");
    CLONEME("/p/std/skills/sewing_tanning/obj/magieseide.lpc");
}

  void wegschleudern(object enemy)
{
  object* rooms;
  rooms=m_values(MENV->QueryProp(P_EXITS));
  enemy->move(rooms[random(sizeof(rooms))], M_GO, 
    "vom Calluna fortgeschleudert", "wird", "fliegt in hohem Bogen herein");
  enemy->SetProp(P_PARALYZED, 10);
}
 void StartReaction(string verb, string gruppe, string adverb, int touch)

{ 
  
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
  case "fies":
      if( random(2) )
   call_out("react", 0, "fragt: Wollt Ihr meine Schwanzflosse spueren?",
          "fragt: "+TP->name(WER)+" wollt Ihr meine Flosse spueren?");
      else
   call_out("angriff",0);
      break;
  case "aergerlich":
    call_out("react", 0, "sagt: Der Ozean wird Euch vernichten "+TPN+"!",0);
      break;
  case "traurig":
    call_out("react", 0, "troestet Dich laechelnd "+TPN+".",0);
      break;
  case "albern":
	    call_out("react", 0, "grinst Dich an.",0);
       break;
  case "neutral":
    call_out("react", 0, "nickt Dir zu.", "nickt "+TP->name(WEM)+" zu.");
      break;
  case "intim":
    call_out("react", 0, "durchdringt Dich mit ihren Augen. ",
	"durchdringt "+TP->name(WEN)+" mit ihren Augen.");
      break;
  case "froh":
    call_out("react", 0, "spritzt Dir etwas Wasser ins Gesicht.",
             "spritzt "+TP->name(WEM)+" etwas Wasser ins Gesicht.");
      break;
  case "aengstlich":
    call_out("react", 0, "lacht Dich aus.",
             "lacht "+TP->name(WEN)+" aus.");
      break;
  case "frech":
    call_out("react", 0, "taucht Deinen Kopf unter Wasser.", "taucht "
		     +TP->name(WEN)+" unter Wasser.");
      break;
  case "nett":
    call_out("react", 0, "laechelt Dich an.", "laechelt "+TP->name(WEN)+
		    " an.");
      break;
  }
}
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
	   {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}
  void angriff()
{
  if (present(TP, ENV(TO))) 
  {
 tell_room(ENV(TO), Name(WER, 1)+" schimpft: Ihr habts nicht anders gewollt!\n");
    Kill(TP);
  }
 }

  void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
	  return StartReaction(verb, gruppe, adverb, touch);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}


void karpfen()
{
  if (TP && MENV && present(TP, MENV))
  {
    write("Calluna begruesst Dich mit einem zaertlichen Kuss.\n");
    tell_room(MENV, "Calluna begruesst ihren Ehemann Karpfen hocherfreut "
        "mit einem zaertlichen Kuss.\n", ({TP}));
  }
}
 

int Defend(int dam, mixed *dam_type_list, mixed spell, object enemy)
{
  if (dam > 500) dam = 500;
  return ::Defend( dam, dam_type_list, spell, enemy);
}
 
