//Jade die Todeshexe

inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"


void init()
{
  ::init();
   if (find_call_out("hallo") != -1)  
  call_out("hallo",0);
}

void hallo()
{
  if (objectp(TP) && objectp(MENV) && present(TP, MENV)&& !InFight())
    tell_room(MENV, "Jade funkelt Dich boese an.\n");
}
object* feinde = ({});
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Jade, die Hexe des Todes");
  SetProp(P_LONG,
    "Jade, die Todeshexe ist eine sehr grossgewachsene Hexe mit langen feurig " 
    "flammenden Haaren. Ihre pupillenlosen weissen Augen funkeln Dich boese "
    "an. Sie ist die Tochter des Teufels und ist in ihren Faehigkeiten nicht " 
    "zu unterschaetzen. In ihrem hautengen, schwarzen Catsuit sieht sie dennoch "
    "aeusserst attraktiv aus.");
  
    
  SetProp(P_NAME, ({"Jade, die Todeshexe",
                  "Jade, der Todeshexe", 
                  "Jade, der Todeshexe",
                  "Jade, die Todeshexe"}));
                  
  SetProp(P_GENDER, FEMALE);
  AddId(({"jade", "hexe", "todeshexe"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("jade");

  create_default_npc(52,7000);
  SetProp(P_HANDS, ({" beruehrt Dich und vergiftet Dich",400,DT_POISON}));
  SetProp(P_RACE, "Hexe");
  SetProp(P_SIZE, 1000);
  SetProp(P_WEIGHT, 1000000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:60]));  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  0.0, DT_AIR:   -1.0, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: -1.0, DT_SOUND:  -1.0, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  0.0, DT_ACID:      -1.0, DT_POISON: 0.0, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    -1.0, DT_MAGIC:  -1.0, DT_MIND:   -1.0,
      DT_PIERCE: -0.3, DT_BLUDGEON: -0.3,  DT_SLASH:    -0.3]) ); 

  SetProp(P_MSGIN, "entsteht aus einer Flamme");
  SetProp(P_MSGOUT, "verfluessigt sich zu Blut");
  SetProp(P_MMSGIN, "formt sich aus fluessigem Lava");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");
  SetProp(P_DIE_MSG,  " verfluessigt sich.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste Mal geleite ich Dich in den Tod!");
  SetProp(P_KILL_NAME, "Die Todeshexe Jade");
  SetProp(P_KILL_MSG, "Zerfleischt gefaellst Du mir am besten!");

  AddInfo(DEFAULT_INFO, "sagt: Red nicht! Stirb!");
  
    
   SetProp( P_REJECT, ({ REJECT_GIVE,
    "Jade sagt: Was soll ich mit irdischem Zeug?\n" }) );

  SetProp(P_SPELLRATE, 95);
  
  AddSpell(4,800,
    "Jade schlitzt Dir mit ihren langen Krallen den Hals auf.\n",
    "Jade schlitzt @WEM mit ihren Krallen den Hals auf.\n",
  DT_SLASH,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,900,
  "Jade speit Dir blutrote aetzende Saeure ins Gesicht.\n",
  "Jade speit @WEM blutrote aetzende Saeure ins Gesicht.\n",
  DT_ACID,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(6,700,		  
  "Jade peitscht Dich mit der Seelengeissel.\n",
  "Jade peitscht @WEN mit ihrer Seelengeissel.\n",
  DT_WHIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,2500,		  
  "Jade befoerdert Dich mit daemonischem Grinsen ins Todesreich.\n",
  "Jade schickt @WEN in die Hoelle und grinst daemonisch.\n",
  DT_MIND,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 600, DS_PARALYZE);

  AddDefaultSpell(3, 300, DS_FROG);
  

  AddDefaultSpell(1,2000, DS_MASS_DAMAGE 
  "Jade legt ihre Haende auf den Boden und gluehende Lavamassen treffen Dich.\n",
  "Jade legt ihre Haende auf den Boden und vernichtet @WEN mit Lava.\n",
  DT_FIRE);
  
  AddSpell(5,600,
  "Jade oeffnet den Mund und eine riesige Flamme schiesst hervor.\n",
  "Jade verbrennt @WEM mit einer riesigen Flamme aus ihrem Mund.\n",
  DT_FIRE,([SP_SHOW_DAMAGE:1]));
    

  SetChats(5, ({"Jade lechzt nach Deinem Blut.\n"}));
 
  
  SUID;
    CLONEME(WEAPON "seelengeissel.lpc" );
    command("zuecke seelengeissel");
    CLONEME( "/d/unterwelt/zordan/dhrkion/armour/stiefel");
    CLONEME(ARMOUR "netzh.lpc" );
    CLONEME(ARMOUR "catsuit.lpc" );
    CLONEME( "/d/unterwelt/amazora/dimension/obj/muellkutte"); 
    command("trage alles");
}

int Defend(int dam, string dtype, int spell, object enemy)
  
{ 
  object ob, *obs;
  if (((ob = enemy->QueryProp(P_WEAPON)) && 
        ob->id("Jadekiller")) ||
      (sizeof(obs = enemy->QueryArmours(AT_GLOVE)) && 
       obs[0]->id("Jadekiller")))
{
  if (member(feinde, enemy) == -1)
  feinde += ({enemy});

  return ::Defend(dam, dtype, spell, enemy);
  }
  return ::Defend(0, dtype, spell, enemy);
}
 
 int remove_jadekiller(object ob)
 { 
  object killer;
  if (killer = present("Jadekiller", ob))
  { 
    tell_object(ob, 
        killer->Name(WER) + " zerbroeselt beim Tod von Jade zu Staub.\n");
    killer->remove();
  } 
  return 1;
}

 varargs void die( int poisondeath )

 {
  string *gildenitems;
  gildenitems = ({"achillesf","apollo","kriegsfaust","hadesk","osiris",
		  "venus","aphrodite","luftwirbel","mkrone","arachne",
		  "gottschutz","heraschutz","meerspiegel"});

 CLONEME(ARMOUR + gildenitems[random(sizeof(gildenitems))]);
 CLONEME(ARMOUR + gildenitems[random(sizeof(gildenitems))]);
 filter_array(feinde - ({0}), "remove_jadekiller");
 ::die(poisondeath);
  
  } 
  
void NotifyPlayerDeath(object player, object killer, int lostexp)
{ 
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}
 varargs void ModifySkillAttribute(object caster, string atrname, int value, 
    int duration, mixed fun)
{
  return 0;
}
 
