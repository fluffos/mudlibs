// 09.11.2005
// 
// NPC meines Gesellenstueckes "Hexenstadt"

inherit "std/mnpc";

#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine blutige Nase");
  SetProp(P_LONG, "Die Nase scheint einmal einem Oger gehoert zu haben, denn "       "sie ist gross und plump. Anscheinend wurde sie ihm abgebissen, denn ihre "
     "Enden sind fleischig und zerfetzt. Das eklige Ding ist irgendwie zum "
     "Leben erwacht. Ausserdem kommt sie Dir sehr bekannt vor. Sie sieht "
     "irgendwie wie Hihis Nase aus. War er wohl wieder einmal zu frech und "
     "als Konsequenz hat er seine Nase verloren.");
  SetProp(P_NAME, "Nase");
  SetProp(P_GENDER, FEMALE); 
  AddId("nase");
  
  create_default_npc(2+random(4));
  SetProp(P_HANDS, ({" mit ihren Nasenfluegeln",30,DT_BLUDGEON}));
  SetProp(P_RACE, "Ogernase");
  SetProp(P_SIZE, 4);
  SetProp(P_WEIGHT, 200);
  SetProp(P_MATERIAL, MAT_FLESH);
  SetProp(P_ALIGN, 40+random(1000));
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "trieft vor lauter Blut");
  SetProp(P_MMSGIN, "niest lautstark");
  SetProp(P_MMSGOUT, "huepft davon");

  SetProp(P_MNPC_AREA, ({ ROOM "whexe_03.lpc", ROOM "whexe_027.lpc"}));
  SetProp(P_MNPC_WAIT, ({ 15, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "whexe_03.lpc");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);  
  SetProp(P_DIE_MSG, " ermatscht in einen ekligen Fleischklumpen.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_KILL_MSG, "Du Seicherl laesst Dich von einer Nase toeten!");
  SetProp(P_MURDER_MSG, "Ich hoffe, Du bist mit meinem Blut besudelt!");  
  AddInfo(DEFAULT_INFO, "schnieft.\n");

  SetProp( P_REJECT, ({REJECT_DROP, "Braucht so etwas nicht.\n" }));

  SetChats(1, ({ "Die Nase schnieft.\n",
		 "Die Nase niest Dir Blut ins Gesicht.\n",
		 "Die Nase blutet.\n"}));

  SetAttackChats(10, ({ "Die Nase stupst Dich an.\n",
			"Die Nase niest Dich an.\n"}));

}
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react") != -1)
   return;

  switch(gruppe)
    {
   case "fies":
     call_out ("react", 0, "schmiert Dir Blut in Deine Hose.",
	       "beschmiert "+TP->Name(WEN)+ "mit Blut.");
     break;

   case "aergerlich":
     call_out("react", 0, "ignoriert Dich.",
	      "ignoriert "+TP->Name(WEN)+".");
     break;

   case "frech":
     call_out("react", 0, "stupst Dich fest an.",
	      "stupst "+TP->Name(WEN)+" fest an.");
     break;
   
    default:
      call_out("react", 0, "huepft in der Gegend herum.",
	       "zieht sich den Schleim hoch.");
     break;
  }

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
    {
      tell_object(TP, BS(Name(WER) + " "+victim));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));

     }
  
	
} 

   
