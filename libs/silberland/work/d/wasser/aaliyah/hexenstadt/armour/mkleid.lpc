// Blumenkleid

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Myricas Kleid der Mystik");
  SetProp(P_LONG, 
    "Myricas Kleid der Mystik ist ein bodenlanges blasslila Kleid. Es hat "
    "um die Taille eine dunkelblaue Schaerpe gebunden. An dieser Schaerpe "
    "ist eine Vorrichtung angebracht, in der sich ein Schwert befindet. Die "
    "weite Schleppe des Kleides ist so lang, das es im Kampf ein wenig "
    "hinderlich ist. Weiters ist das Kleid mit kleinen glitzernden Kristallen "
    "uebersaeht und hat an den langen Aermeln magische Stickereien.");
  SetProp(P_NAME, "Myricas Kleid der Mystik");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleid"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 27);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_ARTICLE, 0);
}  
   
