// Armreif

inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Armreif");
  SetProp(P_LONG, 
    "Der Armreif besteht aus purer Magie. Einige mystische Symbole wurden "
    "in ihn geritzt. Er kann Dir auf dieser Insel vielleicht noch ganz "
    "nuetzlich sein. Er schimmert wunderschoen golden.");
  SetProp(P_NAME, "Armreif");
  SetProp(P_GENDER, MALE); 
  AddId( ({"goldener armreif","armreif","reif","\njadereif"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
 }

 void reset()
{ 
  object wer;
  if( !is_clone(TO)) return;
  ::reset();
  if (wer = QueryProp(P_WORN))
  {
    if (strstr(file_name(ENV(wer)), ROOM) != -1)
      wer->heal_self(200);
    else
      remove();
  }
} 

   
