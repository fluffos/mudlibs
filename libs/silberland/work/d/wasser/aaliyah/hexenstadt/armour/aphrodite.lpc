// von Aaliyah
// 16.1.2005
// 
// Aphrodites Schleier

inherit "std/armour";
#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Aphrodites Schleier");
  SetProp(P_LONG, 
    "Aphrodites Schleier wurde von der Goettin aus goldenem Vlies gewebt. "
    "Es ist ein goldener, wallender und bodenlanger Umhang, der mit vielen "
    "Edelsteinsplittern und einigen Perlen verziert ist. Weiters hat er eine "
    "Kapuze aufgenaeht, die die Goettin auch vor Wind und Wetter schuetzte. "
    "Die Macht der Goettin wurde in jede Faser gewebt, darum ist es nur den "
    "maechtigsten Kriegern gestattet, ihn zu tragen.");
  SetProp(P_NAME, "Aphrodites Schleier");
  SetProp(P_INFO, "Aphrodites Schleier erhoeht Deine Magie leicht.\n"
		  "Aphrodites Schleier verbessert Deine Zauber.\n"
		  "Aphrodites Schleier schuetzt vor Paralyse.");
  SetProp(P_GENDER, MALE); 
  AddId( ({"aphrodites schleier","schleier","umhang"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:9]) );
  SetProp(P_PALADIN_SPELLCOST, 5);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_UNHOLY:1, DT_COLD:1, DT_MAGIC:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "paladine", P_LEVEL: 50]) );
  call_other("/p/daemon/itemd/functions/defendfuncnoparalyze", "???");
  SetProp(P_DEFEND_FUNC,
  find_object("/p/daemon/itemd/functions/defendfuncnoparalyze"));

  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:1]) );

//----Details Anfang-----------------------

  AddDetail( ({"vlies"}),
     "Der Umhang der Goettin wurde aus goldenem Vlies gewebt. Viele Perlen "
     "und Edelsteinsplitter ergeben ein wunderschoenes Muster.");

  AddDetail( ({"edelsteinsplitter","muster","perlen"}),
     "Das Muster sieht aus wie ein goettliches Zeichen. Du bist Dir sicher, "
     "dass Du dieses Zeichen noch einmal brauchen wirst.");
  
  AddDetail( ({"kapuze"}),
     "Eine Kapuze ist auf dem Umhang aufgenaeht. Somit schuetzt er vor Hitze "
     "sehr gut und auch vor Kaelte.");  
  
  
 
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
    
   
  
 
   
