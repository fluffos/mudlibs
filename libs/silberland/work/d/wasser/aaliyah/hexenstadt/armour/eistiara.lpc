// Eistiara

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eistiara");
  SetProp(P_LONG, 
    "Diese filigrane Eistiara erinnert an eine kleine Krone. Sie besteht "
    "aus puren Eiskristallen und ist mit wunderschoenen Eisblumen verziert. "
    "An den aeusseren Enden wurde eine Kette befestigt, an deren Ende sich ein "
    "Tropfen aus Eis befindet. Wenn die Traegerin die Tiara traegt, baumelt "
    "dieser Tropfen genau zwischen den Augenbrauen.");
  SetProp(P_NAME, "Eistiara");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"tiara","eistiara"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 850);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_ICE:100]));
  SetProp(P_LIGHT, 0);
 }  
   
