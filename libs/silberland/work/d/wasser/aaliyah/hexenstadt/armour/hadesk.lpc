// Hades Hoellenkrallen

inherit "std/armour";
#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Hades uralte Hoellenkrallen");
  SetProp(P_LONG, 
    "Hades uralte Hoellenkrallen sind das letzte Erinnerungsstueck des Gottes. "
    "Sie wurden aus dem Feuer der Hoelle geschmiedet, und die Dunkelheit "
    "aus dem Herzen des Gottes floss in das Gewebe ein. Wenn man die Krallen "
    "genau betrachtet, erkennt man sogar noch Blutreste von den Opfern, die "
    "mit diesen uralten Handschuhen zerschlitzt wurden.");
  SetProp(P_NAME, "Hades uralte Hoellenkrallen");
  SetProp(P_INFO, "Hades Hoellenkrallen verdunkeln die Umgebung.");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"hades hoellenkrallen","hoellenkrallen","krallen","handschuhe"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_FIRE:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_SP:6, P_HP:6]) );
  SetProp(P_NEKRO_BONUS, (["all":5]) );
  SetProp(P_NEKRO_SPELLCOST, 3);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_HOLY:1, DT_FIRE:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "nekromanten", P_LEVEL: 50]) );
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);

  AddDetail( ({"erinnerungsstueck","erinnerung"}),
   "Diese Handschuhe erinnern an den Gott Hades. Sie sind voellig schwarz und "
   "strahlen eine enorme dunkle Macht aus.");
  
  AddDetail( ({"feuer"}),
    "Beim genaueren Betrachten siehst Du, dass aus den Fingerspitzen lauter "
    "kleine Flammen lodern.");

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
   int WearFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, -1);
  return 1;
}

int RemoveFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 0);
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}
   
