// Acaciahs Rosenkleid

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein zartes Rosenkleid");
  SetProp(P_LONG, 
    "Dieses zarte Kleid besteht aus rosa Seide. Das Oberteil hat filigrane "
    "Traeger und ist unter der Brust leicht gezogen. Es ist bis zur Taille "
    "enganliegend. Ab der Taille verlaeuft es wallend bis hinunter zum Boden. "
    "Ausserdem verstroemt es einen wunderbaren Duft nach Rosen und macht seine "
    "Traegerin weiblicher.");
  SetProp(P_NAME, "Rosenkleid");
  SetProp(P_NAME_ADJ, "zart");  
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleid","rosenkleid"}) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 26);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
   }

int WearFunc(object ruest,int silent)
{
  call_out("duften", 2);
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  while(remove_call_out("duften") != -1);
  return 1;
}

void BecomesNetDead(object wer)
{
  while(remove_call_out("duften") != -1);
}

void BecomesNetAlive(object wer)
{
  if(wer==QueryProp(P_WORN))
    call_out("duften", 2);
}

void duften()
{
  object wer;
  if (!wer = QueryProp(P_WORN))
    return;
  if (!ENV(wer))
    return; 
  
  switch(random(2))
 {
  case 0:
  
  tell_room(ENV(wer), wer->Name() + " duftet herrlich nach Rosen.\n", ({wer}) );
  tell_object(wer, "Du duftest himmlisch nach Rosen.\n");
 

  break;
 
  case 1:

  tell_room(ENV(wer), wer->Name() + " ist von einer Wolke aus Rosenduft "
		                    "umgeben.\n", ({wer}) );
  tell_object(wer, "Du schwebst in einer Wolke aus Rosenduft.\n");

  break;
}

 call_out("duften", 30 + random(50));

 }

  


  
 
   
