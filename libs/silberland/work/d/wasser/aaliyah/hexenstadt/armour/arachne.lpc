// Arachnes Spinnennetz

inherit "std/armour";
#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Arachnes Spinnennetz");
  SetProp(P_LONG, 
    "Arachne die Spinnengoettin schuf diesen aussergewoehnlichen Umhang. "
    "Viele zarte Spinnenfaeden bilden ein dichtes Netz, das die Goettin "
    "vor heiligen Attacken schuetzte. In diesem Umhang wurde die ganze Macht "
    "Arachnes und ihre Finsternis eingewebt. Weiters wurden einige verdammte "
    "Seelen in den Umhang gebannt und repraesentieren die Vollkommenheit des "
    "Boesen. Dieser Umhang bietet den Dienern des Boesen sicher guten Schutz "
    "und kann auch wirklich nur von ihnen benutzt werden.");
  SetProp(P_NAME, "Arachnes Spinnennetz");
  SetProp(P_INFO, "Diese Ruestung schuetzt vor Paralyse. "
		  "Arachnes Spinnennetz macht die Umgebung dunkler. "
		  "Ausserdem senkt dieser Umhang Deine Spellkosten.");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"netz","umhang","arachnes spinnennetz","spinnennetz"}) );
  SetProp(P_WEIGHT,500);
  SetProp(P_VALUE, 4200);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_HOLY:1, DT_LIGHT:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "nekromanten", P_LEVEL: 50]) );
  call_other("/p/daemon/itemd/functions/defendfuncnoparalyze", "???");
  SetProp(P_DEFEND_FUNC,
  find_object("/p/daemon/itemd/functions/defendfuncnoparalyze"));
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);
  SetProp(P_NEKRO_SPELLCOST, 5);
 
  AddDetail( ({"spinnenfaeden","faeden"}),
    "Die Spinnenfaeden glaenzen leicht silbern und stroemen eine enorme "
    "dunkle Macht aus.");

  AddDetail( ({"arachne"}),
    "Arachne ist die Spinnengoettin.");

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


  
   
}  
 int WearFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, -1);
  return 1;
}

int RemoveFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 0);
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}  
