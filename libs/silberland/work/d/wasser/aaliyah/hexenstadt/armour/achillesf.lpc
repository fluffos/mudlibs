// 15.1.2005
// 
// Achilles Ferse

inherit "std/armour";
#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Achilles Ferse");
  SetProp(P_LONG, 
    "Achilles Ferse ist eine sehr gute Ruestung vom Typ Stiefel. Sie bestehen "
    "aus zusammengenaehten Drachenschuppen. Weiters wurden sie mit einigen "
    "Metallstraengen verstaerkt. Das Innenfutter besteht aus dem goldenen "
    "Vlies, das die Fuesse des Traegers wie auf Wolken bettet. Die dicke "
    "Sohle der Stiefel ist aeusserst widerstandsfaehig und bietet sicher bei "
    "jedem Wetter einen guten Schutz.");
  SetProp(P_NAME, "Achilles Ferse");
  SetProp(P_INFO, "Die Stiefel senken die Kosten Deiner Zauber.\n"
		  "Achilles Ferse erhoeht Deine Attribute.\n");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"achilles ferse","ferse","stiefel"}) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 3000);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_HORN:60, MAT_METAL:20, MAT_GOLD:20]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_ATTR_MOD, ([A_DEX:1]) );
  SetProp(P_BERSERKER_BONUS, (["all":5]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:2]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "berserker", P_LEVEL: 50]) );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);
  SetProp(P_EFFECTIVE_WC, 150 + random(50));
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:3]) );

//---------Details Anfang---------------------------------

  AddDetail( ({"vlies","innenfutter","futter"}),
   "Das Innenfutter der Stiefel besteht aus goldenem Vlies. Dieses Material "
   "vermag es vor Waerme sowie auch vor Kaelte zu schuetzen.");

  AddDetail( ({"metallstraenge","metalltraengen","straenge"}),
   "Die Stiefel wurden mit Metallstraengen verstaerkt. Sie sind daher sehr "
   "widerstandsfaehig.");

  AddDetail( ({"drachenschuppen","schuppen"}),
   "Viele Drachenschuppen wurden zu exzellenten Stiefeln vernaeht.");

  
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
  }

void _set_autoloadobj(mixed data)
  {
  SetProp(P_ITEMD_TMPMAGIC, data);
  }

mixed _query_autoloadobj()
 {
  return QueryProp(P_ITEMD_TMPMAGIC);
  
  
 }  
   
