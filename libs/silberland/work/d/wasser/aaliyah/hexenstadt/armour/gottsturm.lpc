// Goettersturm




inherit "std/armour";
#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Goettersturm");
  SetProp(P_LONG, 
    "Diese magischen Handschuhe wurden von Anvar gefertigt. Alle 6 Elemente "
    "wurden in diese Ruestung gebannt und vereinigten sich zu einem Meisterwerk "
    "der Elemente. Die Handschuhe bestehen aus den glitzernden blauen Schuppen "
    "des Wasserdrachens. Einige Perlen wurden in Form eines Pentagrammes in "
    "die Handschuhe eingearbeitet. Goettersturm kann nur von den Maechtigsten "
    "der Druiden getragen werden.");
  SetProp(P_NAME, "Goettersturm");
  SetProp(P_GENDER, MALE); 
  AddId( ({"handschuhe","goettersturm"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2000);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_MAGIC:40, MAT_HORN:50, MAT_PEARL:10]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, WASSER);
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 10 + random(6) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_WATER:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_GUILD: "druidenzirkel",P_GUILD_LEVEL: 15]) );
  SetProp(P_INFO, 
	  "Goettersturm veraendet den Schadenstyp der Elementarhand und "
	  "schuetzt zusaetzlich vor Wasser.");
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);
 
}  
   
