// 
// Das Kleid der Kaelte

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein eisiges Kleid");
  SetProp(P_LONG, 
    "Das Kleid ist ein maerchenhaftes Gebilde aus purem Eis. Es besteht aus "
    "einem Korsett und einem weiten Reifrock. Das Korsett besteht aus vielen "
    "ineinander verschlungenen Eisblumen, die so ein loechriges Gewebe bilden. "
    "Der Reifrock besteht aus Raureif, der sich auf magische Weise zu einem "
    "dichten Gewebe gebildet hat. Lauter Eiskristalle funkeln darauf.");
  SetProp(P_NAME, "Kleid der Kaelte");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleid"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 850);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 20);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, ([MAT_ICE:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}  
   
