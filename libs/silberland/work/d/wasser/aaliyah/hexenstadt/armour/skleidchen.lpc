// Seidenkleidchen

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Seidenkleidchen");
  SetProp(P_LONG, 
    "Es ist ein weisses Kleidchen aus reinster Seide. Zarte Stickereien zieren "
    "das Dekolletee. Genau oberhalb der Brust befindet sich eine kleine blaue "
    "Masche aus Satin.");
  SetProp(P_NAME, "Seidenkleidchen");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"seidenkleidchen","kleidchen"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 500);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 17);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_RACE: "Fee"]) );
  
}  
   
