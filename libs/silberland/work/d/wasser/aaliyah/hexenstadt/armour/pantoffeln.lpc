// Ein Paar Pantoffeln

inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Paar Pantoffeln");
  SetProp(P_LONG, 
    "Du siehst ein Paar violette Pantoffeln. Sie bestehen voellig aus Pluesch "
    "und sehen richtig bequem aus. Sie sind an kalten Wintertagen besonders "
    "begehrt.");
  SetProp(P_NAME, "Paar Pantoffeln");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"pantoffeln"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_FELT:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:0]) );
  
}  
   
