// 16.1.2005
// 
// Apollos Verteidigung

inherit "std/armour";
#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Apollos Verteidigung");
  SetProp(P_LONG, 
    "Apollos Verteidigung wurde vom Kriegsgott erschaffen und hat ihn in "
    "vielen Schlachten sehr gute Dienste erwiesen. Der Schild besteht voellig "
    "aus Magie und erstrahlt in goettlichem Licht. Auf der Vorderseite befindet "
    "sich ein Relief mit dem Abbild Apollos. Es laesst den Traeger mit der "
    "Macht der Goetter kaempfen und bietet auch erstklassigen Schutz. Darum "
    "ist es auch nicht jedem gewaehrt, es zu tragen.");
  SetProp(P_NAME, "Apollos Verteidigung");
  SetProp(P_INFO, "Apollos Verteidigung erleichtert Deine Zauber.\n"
		  "Apollos Verteidigung erhoeht Deine Magie.\n");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"apollos verteidigung","verteidigung","schild"}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 28);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_HP:5, P_SP:7]) );
  SetProp(P_PALADIN_SCHILDPARADE_AC, 7);
  SetProp(P_PALADIN_SPELLCOST, 5);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_UNHOLY:1, DT_LIGHTNING:1, DT_SOUND:1, DT_MAGIC:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "paladine", P_LEVEL: 50]) );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);

//--------------Details Anfang--------------------------------

  AddDetail( ({"schlachten","dienste"}),
   "Der Schild hat dem Kriegsgott in vielen Schlachten sehr gute Dienste "
   "erwiesen. Einige Kratzer weisen auf starke Kaempfe hin.");

  AddDetail( ({"goetter","macht"}),
   "Die Macht der Goetter ist grenzenlos. Normal Sterbliche koennen von "
   "so hohen Maechten nur traeumen.");

  AddDetail( ({"relief","abbild","apollos","apollo"}),
   "Das Relief stellt Apollo, den Kriegsgott dar. Seine kraeftige Statur "
   "wird so richtig zur Geltung gebracht.");
  
  
  
 
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


 
  
}  
   
