// Netzhandschuhe

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Schwarze Netzhandschuhe");
  SetProp(P_LONG, 
    "Diese Handschuhe bestehen aus schwarzem Netzstoff. Sie reichen bis zu "
    "den Ellbogen und lassen ihre Traegerin erotisch wirken. Einige kleine "
    "Rubine wurden in das Netz genaeht und lassen sie edel glitzern. In jedem "
    "einzelnen Rubin ist das Feuer der Leidenschaft und Extase gebannt.");
  SetProp(P_NAME, "Netzhandschuhe");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"handschuhe","netzhandschuhe"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 200);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_VELVET:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_PLURAL, 1);
}  
   
