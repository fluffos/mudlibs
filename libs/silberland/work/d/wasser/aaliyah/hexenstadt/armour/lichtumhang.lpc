// Blumenkleid

inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Shines Lichtumhang");
  SetProp(P_LONG, 
    "Dieser gleissend helle Umhang besteht aus purem Licht. Du kannst ihn "
    "nicht genauer anschauen, da er Dich so stark blendet.");
  SetProp(P_NAME, "Lichtumhang");
  SetProp(P_INFO, "Der Lichtumhang macht die Umgebung heller.");
  SetProp(P_GENDER, MALE); 
  AddId( ({"lichtumhang","umhang"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 580);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_LIGHT:100]));
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  
}  
int WearFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 1);
  return 1;
}

int RemoveFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 0);
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}
   
