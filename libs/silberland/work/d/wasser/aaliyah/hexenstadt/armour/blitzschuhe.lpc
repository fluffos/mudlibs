// Blitzsandalen

inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Shines gleissende Blitzsandalen");
  SetProp(P_LONG, 
    "Dieses zarte Schuhwerk besteht aus purem Licht. Es passt sich genau an "
    "den Fuss der Traegerin an. Viele magische Blitze lassen die Sandalen "
    "an den Fuessen haften. Sie erstrahlen in gleissendem Licht.");
  SetProp(P_NAME, "Blitzsandalen");
  SetProp(P_INFO, "Die Sandalen machen die Umgebung heller.");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"sandalen","blitzsandalen"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_LIGHT:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_PLURAL, 1);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + 
   ([DT_LIGHTNING:1]) );
}
   
int WearFunc(object ruestung, int silent)
{   
  SetProp(P_LIGHT, 1);
  return 1;
} 
 
  
int RemoveFunc(object ruestung, int silent)
{ 
  SetProp(P_LIGHT, 0);
  return 1;
} 
  
void reset()
{ 
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}  
  
   
