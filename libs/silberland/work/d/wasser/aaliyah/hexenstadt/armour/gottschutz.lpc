// von Aaliyah
// 16.1.2005
// 
// Zeus Goetterschutz

inherit "std/armour";
#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Zeus Goetterschutz");
  SetProp(P_LONG, 
    "Zeus Goetterschutz ist eine sehr gute Ruestung vom Typ Panzer. Er besteht "
    "vollkommen aus Magie und erstrahlt in weissem Licht. Er wurde von Zeus "
    "erschaffen und machte ihn noch maechtiger als er ohnehin schon war. Nur "
    "die maechtigsten Krieger sind in der Lage, ihn zu tragen und somit mit "
    "den Maechten von Zeus zu kaempfen.");
  SetProp(P_NAME, "Zeus Goetterschutz");
  SetProp(P_INFO, "Zeus Goetterschutz erhoeht leicht Deine Lebenspunkte.\n"
		  "Zeus Goetterschutz schuetzt vor Paralyse.");
  SetProp(P_GENDER, MALE); 
  AddId( ({"zeus goetterschutz","goetterschutz","panzer","schutz"}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 38);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_HP:8, P_SP:4]) );
  SetProp(P_BERSERKER_BONUS, (["kampfschrei":15, "schlachtruf":15, "all": 5]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_LIGHTNING:1, DT_SOUND:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "berserker", P_LEVEL: 50]) );
  call_other("/p/daemon/itemd/functions/defendfuncnoparalyze", "???");
  SetProp(P_DEFEND_FUNC,
  find_object("/p/daemon/itemd/functions/defendfuncnoparalyze"));

  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);

  AddDetail( ({ "licht" }),
     "Der Goetterschutz ist von weissem Licht umgeben. Es ist wie eine "
     "goettliche Aura, die ihn staerkt und vor harten Schlaegen schuetzt.");

  
  AddDetail( ({ "zeus","gott" }),
     "Zeus erschuf dieses magische, maechtige Ruestungsteil um sich vor "
     "Gefahren besser schuetzen zu koennen.");

  
  AddDetail( ({ "ruestungsteil","magie","ruestung","panzer" }),
     "Dieser ausserordentlich schoene Panzer besteht aus vielen, magisch "
     "schimmernden Lichtplatten, die sich zu einer Art Muster ineinander "
     "verschmolzen haben. Er schmiegt sich wie eine zweite Haut um den "
     "Koerper seines Traegers oder seiner Traegerin.");
  
  
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);
  
  
  
}  
   
