// Catsuit

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Catsuit");
  SetProp(P_LONG, 
    "Der Catsuit besteht aus schwarzem Leder. Er liegt hauteng am Koerper an "
    "und betont somit die weiblichen Rundungen. Das Oberteil besteht aus "
    "zwei 10cm breiten Baendern, die im Nacken der Traegerin verknotet werden. "
    "Die Baender verdecken nur wenig vom Oberkoerper. Der Bauchnabel und ein "
    "grosser Teil der prallen Brueste der Traegerin werden so perfekt zur "
    "Geltung gebracht.");
  SetProp(P_NAME, "Catsuit");
  SetProp(P_GENDER, MALE); 
  AddId( ({"catsuit"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}  
   
