// Schlittschuhe

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Paar Schlittschuhe");
  SetProp(P_LONG, 
    "Du siehst ein einfaches Paar Schlittschuhe, die vollkommen aus Eis "
    "bestehen. Einige winzige Eiskristalle haben sich darauf gebildet und "
    "verleihen den Schuhen ein eisiges Funkeln.");
  SetProp(P_NAME, "Paar Schlittschuhe");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"schlittschuhe"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 850);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_ICE:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
}  
   
