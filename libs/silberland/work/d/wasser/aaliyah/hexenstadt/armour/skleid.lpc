// Blumenkleid

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Salvias Kleid der Unschuld");
  SetProp(P_LONG, 
    "Ein langes, bluetenweisses Kleid. Es ist schulterfrei und hat lange " 
    "Aermel, die an den Enden mit kleinen Perlen bestickt sind. Es ist "
    "wallend und besteht aus feinster Seide. Es ist Salvias Zeichen der "
    "Reinheit und der Unschuld und stattet seine Traegerin mit diesen "
    "Eigenschaften aus.");
  SetProp(P_NAME, "Salvias Kleid der Unschuld");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleid der unschuld","kleid"}) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 25);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_ARTICLE, 0);
}  
   
