// Blumenkleid

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Das Kleid der Nacht");
  SetProp(P_LONG, 
    "Das Kleid der Nacht ist bodenlang und schwarz. Es besteht aus feinem "
    "Satin und hat lauter eingearbeitete Sternensplitter. Das Kleid ist "
    "schulterfrei, und auf der Brust befindet sich ein blutroter Rubin. "
    "Das Kleid der Nacht ist von einer magischen Aura umgeben und verdunkelt "
    "die Umgebung der Traegerin.");
  SetProp(P_NAME, "Kleid der Nacht");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleid"}) );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_MAGIC, 2);
}  
 int WearFunc(object ruestung, int silent)

 {   
  SetProp(P_LIGHT, -1);
  return 1;
 } 
  
 int RemoveFunc(object ruestung, int silent)
  { 
  SetProp(P_LIGHT, 0);
  return 1;
 } 
 void reset()
{ 
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}  

     	
