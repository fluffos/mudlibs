// von Aaliyah
// 30.1.2005
// 
// Nekromantenumhang fuer kleine Spieler

inherit "std/armour";
#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Nyraerias Spinnennetz");
  SetProp(P_LONG, 
    "Nyraerias Spinnennetz besteht aus vielen verwebten Spinnenfaeden. "
    "Weiters wurden einige Edelsteinsplitter als Zierde eingewebt. "
    "Der Umhang hat eine Kapuze aufgenaeht und bietet daher einen guten "
    "Schutz gegen Feuer und auch gegen Wasser. Der Umhang ist ein Produkt "
    "tiefster Finsternis und kann daher nur von den Dienern des Boesen "
    "benutzt werden.");
  SetProp(P_NAME, "Nyraerias Spinnennetz");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INFO, "Nyraerias Spinnennetz macht die Umgebung dunkler."); 
  AddId( ({"umhang","spinnennetz","nyraerias spinnennetz","netz"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1500);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 9);
  SetProp(P_M_HEALTH_MOD, ([P_SP:3, P_HP:5]) );
  SetProp(P_NEKRO_BONUS, (["all":5]) );
  SetProp(P_NEKRO_SPELLCOST, 3);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_FIRE:1, DT_WATER:1, DT_LIGHT:1]) );
  SetProp(P_MAGIC, 1);
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "nekromanten", SR_MAX_LEVEL: 30]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_ARTICLE, 0);
  
}  
     
   int WearFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, -1);
  return 1;
}

int RemoveFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 0);
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}
