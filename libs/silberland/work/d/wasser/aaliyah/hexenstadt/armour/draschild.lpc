inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Sturmdrachenschild");
  SetProp(P_LONG, 
    "Dieser Schild besteht aus den Schuppen des Sturmdrachens. Es hat die "
    "Form eines Achtecks und bietet sicher einen guten Schutz. Auf der "
    "Vorderseite ist das Wappen des Drachens eingeritzt.");
  SetProp(P_NAME, "Sturmdrachenschild");
  SetProp(P_GENDER, MALE); 
  AddId( ({"schild","sturmdrachenschild"}) );
  SetProp(P_WEIGHT, 1400);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 25);
  SetProp(P_MATERIAL, ([MAT_HORN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_AIR:1]) );
  SetProp(P_MAGIC, 2);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  
  
}  
   
