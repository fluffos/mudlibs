// von Aaliyah
// 10.11.2004
// Nachtstiefel


inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Paar Nachtstiefel");
  SetProp(P_LONG, 
    "Die Nachtstiefel bestehen aus reiner Seide und haben eine dicke Sohle "
    "aus einem unbekanntem Material. Sie haben ein gelbes Muster, das einige "
    "Sternenbilder des Himmels zeigt.");
  SetProp(P_NAME, "Nachtstiefel");
  SetProp(P_INFO, "Die Nachtstiefel verdunkeln die Umgebung.");
  SetProp(P_GENDER, MALE); 
  AddId( ({"stiefel","nachtstiefel"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAGIC, 2);
  SetProp(P_PLURAL, 1);
}  
 int WearFunc(object ruestung, int silent)
{   
  SetProp(P_LIGHT, -1);
  return 1;
} 
  
int RemoveFunc(object ruestung, int silent)
{ 
  SetProp(P_LIGHT, 0);
  return 1;
} 
  
void reset()
{ 
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}  

 
