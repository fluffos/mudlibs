// Blumenkleid

inherit "std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Blumenkleid");
  SetProp(P_LONG, 
    "Dieses suesse, kleine Blumenkleid besteht aus zwei grossen Orchideen. "
    "Sie wurden einfach aneinander gebunden und welken seltsamerweise nicht.");
  SetProp(P_NAME, "Blumenkleid");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"blumenkleid","kleid"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
}  
   
