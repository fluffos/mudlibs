// Fusskette

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein zartes Fusskettchen");
  SetProp(P_LONG, 
    "Dieses filigrane Fusskettchen besteht aus purem Silber. Lauter kleine "
    "traenenfoermige Aquamarine zieren es und funkeln im Sonnenlicht. Es ist "
    "ein besonders schoener Fussschmuck und bei Frauen heiss begehrt.");
  SetProp(P_NAME, "Fusskettchen");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({ "kettchen","fusskettchen","fusskette","kette" }) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 2000);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

  
}  
   
