// Seidenschuerze

inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Seidenschuerze");
  SetProp(P_LONG, 
    "Diese rosa Seidenschuerze ist mit einem Bluemchenmuster bestickt. An den "
    "Saeumen sind Rueschen und an der Brust befindet sich eine rosa Masche.");
  SetProp(P_NAME, "Seidenschuerze");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"seidenschuerze","schuerze"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_RACE: "Fee"]) );
  
}  
   
