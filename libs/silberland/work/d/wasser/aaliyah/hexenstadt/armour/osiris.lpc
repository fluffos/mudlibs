// von Aaliyah
// 16.1.2005
// 
// Osiris Vermaechtnis

inherit "std/armour";
#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Osiris Vermaechtnis");
  SetProp(P_LONG, 
    "Osiris Vermaechtnis stammt aus dem Todeslager der Sklaven des Gottes. "
    "Der Ungehorsam der Sklaven wurde mit sofortigem Tod bestraft. Ihr Leichnam "
    "wurde in diesen Panzer gehuellt, um ihnen nach altem Glauben einen "
    "schoenen Gang in die Hoelle zu gewaehrleisten. Damit ihre verdammten "
    "Seelen auf ewige Zeit verbannt sind, wurde dieser Panzer mit grosser "
    "Macht gefertigt. Der Panzer ist das Erbe Osiris an seine Geliebte Isis.");
  SetProp(P_NAME, "Osiris Vermaechtnis");
  SetProp(P_INFO, "Osiris Vermaechtnis macht die Umgebung dunkler.");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"osiris vermaechtnis","panzer","vermaechtnis"}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 38);
  SetProp(P_MATERIAL, ([MAT_FIRE:100]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_SP:3, P_HP:9]) );
  SetProp(P_NEKRO_BONUS, (["all":5]) );
  SetProp(P_NEKRO_SPELLCOST, 3);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_HOLY:1, DT_FIRE:1, DT_LIGHT:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "nekromanten", P_LEVEL: 50]) );
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);


  AddDetail( ({ "sklaven", "todeslager" }),  
    "Der Gott hatte viele Sklaven, die ihr Blut fuer ihn vergossen haben.");

  AddDetail( ({ "gott","osiris" }),
    "Man munkelt, dass Osiris noch immer im Silberland herumspukt.");

  AddDetail( ({ "erbe" }),
     "Osiris Vermaechtnis ist ein komplett schwarzes Ruestungsteil. "
     "Es sieht irgendwie aus, als wuerde sich schwarzes Samt eng um "
     "den Koerper huellen. Trotzdem bietet das Erbe einen hervorragenden "
     "Schutz.");
  
  
 
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
  }

  void _set_autoloadobj(mixed data)
  {
  SetProp(P_ITEMD_TMPMAGIC, data);
  }

   mixed _query_autoloadobj()
  {
  return QueryProp(P_ITEMD_TMPMAGIC);


  }  
   
   int WearFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, -1);
  return 1;
}

int RemoveFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 0);
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}
