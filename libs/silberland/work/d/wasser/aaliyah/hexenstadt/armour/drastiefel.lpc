// Eisdrachenstiefel

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Paar Eisdrachenstiefel");
  SetProp(P_LONG, 
    "Diese Stiefel wurden aus den Schuppen des Eisdrachen gefertigt. "
    "Sie haben eine dicke Sohle und reichen bis zu den Knien des Traegers. "
    "So bieten sie einen guten Schutz und schuetzen ausserdem vor Eis.");
  SetProp(P_NAME, "Paar Eisdrachenstiefel");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"stiefel","eisdrachenstiefel"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_HORN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_COLD:1]) );
  SetProp(P_MAGIC, 2);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 1);
  
  
}  
   
