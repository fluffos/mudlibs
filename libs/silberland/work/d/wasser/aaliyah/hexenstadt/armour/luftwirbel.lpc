// von Aaliyah
// 16.1.2005
// 
// Amuns Luftwirbel

inherit "std/armour";
#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Amuns Luftwirbel");
  SetProp(P_LONG, 
    "Amuns Luftwirbel ist ein einzigartiges Gebilde, das voellig aus Luft "
    "besteht. Dieser Guertel schmiegt sich sanft um die Taille des Traegers "
    "und bietet ihm guten Schutz vor dem Element Luft. Er gehoerte einst dem "
    "Luftgott Amun und kann somit nur von den maechtigsten Kriegern getragen "
    "werden.");
  SetProp(P_NAME, "Amuns Luftwirbel");
  SetProp(P_GENDER, MALE); 
  AddId( ({"amuns luftwirbel","wirbel","guertel","luftwirbel"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_SP:9, P_HP:3]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([LUFT:7, FEUER:7]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_AIR:1, DT_FIRE:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "druidenzirkel", P_LEVEL: 50]) );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);

  AddDetail( ({"gebilde"}),
   "Amuns Luftwirbel besteht aus vielen ineinander geschwungenen Luftstroemen. "   "Die gebuendelte Luft des Guertels ist so maechtig, dass sie es sogar "
   "vermochte, Amun vor dem Sturz in einen Vulkan zu retten.");

  AddDetail( ({"sturz","vulkan"}),
   "Da Amun beinahe in einen Vulkan gestuerzt waere, verlieh er dem Guertel "
   "die Eigenschaft, auch vor Feuer einen guten Schutz zu bieten.");
		
  
  
  
 
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
  }

  void _set_autoloadobj(mixed data)
  {
  SetProp(P_ITEMD_TMPMAGIC, data);
  }

  mixed _query_autoloadobj()
  {
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
  
   
