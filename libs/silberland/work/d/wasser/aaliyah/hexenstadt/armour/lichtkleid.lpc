// Lichtkleid

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Shines Lichtkleid");
  SetProp(P_LONG, 
    "Das Kleid besteht aus purem Licht. Es hat Spaghettitraeger und ist bis "
    "zur Taille enganliegend. An der Taille sind lauter duenne Stoffbahnen "
    "befestigt, die weiten Einblick auf die Beine der Traegerin gewaehren. "
    "Es wurde so angefertigt, das es die Traegerin beim Kampf nicht behindert.");
  SetProp(P_NAME, "Lichtkleid");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"lichtkleid","kleid","shines lichtkleid"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 18);
  SetProp(P_MATERIAL, ([MAT_LIGHT:100]));
  SetProp(P_LIGHT, 0);

}  
 int WearFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 1);
  return 1;
}

int RemoveFunc(object ruestung, int silent)
{
  SetProp(P_LIGHT, 0);
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  if (!objectp(QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);
}
     
