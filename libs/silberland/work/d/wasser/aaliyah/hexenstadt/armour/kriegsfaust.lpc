// Herkules Kriegsfaust

inherit "std/armour";
#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Herkules Kriegsfaust");
  SetProp(P_LONG, 
    "Diese schoen gefertigten Handschuhe bestehen aus den kleinen weissen "
    "Schuppen des Eisdrachens. Auf jeder Schuppe befindet sich ein kleiner "
    "eingravierter Drachenkopf. Das Innenfutter der Handschuhe wurde aus dem "
    "goldenen Vlies gewebt und schuetzt sehr gut gegen Kaelte.");
  SetProp(P_NAME, "Herkules Kriegsfaust");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"herkules kriegsfaust","kriegsfaust","handschuhe","faust"}) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 3000);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_HORN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_ATTR_MOD, ([A_STR:1]) );
  SetProp(P_BERSERKER_BONUS, (["all":5, "spalten":15]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:-1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "berserker", P_LEVEL: 50]) );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_COLD:1]) );

  AddDetail( ({"drachenkopf"}),
   "Der Drachenkopf erinnert Dich an irgendwie an eine Mudderin,");

  AddDetail( ({"innenfutter","futter"}),
   "Das Innenfutter schimmert golden. Aber das ist kein Wunder, denn es "
   "besteht ja aus dem goldenen Vlies.");
   

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
   
