// Blumenkleid

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine goldene Lesebrille.");
  SetProp(P_LONG, 
    "Eine einfache zarte, goldene Lesebrille, die dem Traeger das Lesen "
    "erleichtern soll.");
  SetProp(P_NAME, "Lesebrille");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"brille","lesebrille"}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 50);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
}  
   
