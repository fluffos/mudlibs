// Morrighans Kleid

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Das Kleid der Verzweiflung");
  SetProp(P_LONG, 
    "Du haeltst ein zartes, blassblaues Kleidchen in Deinen Haenden. Es fuehlt "
    "sich an wie Seide, jedoch besteht es aus purer Traurigkeit. Viele "
    "kleine Tropfen quellen aus dem Stoff hervor. Beim genaueren Hinsehen "
    "erkennst Du, dass es Traenen sind. Traenen der Verzweiflung und der "
    "Trauer. Dieses Kleid bietet kaum Schutz und macht die Traegerin trauriger.");
  SetProp(P_NAME, "Kleid der Verzweiflung");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleid","kleidchen"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_ARTICLE, 0);
}  
   
