// Glockenblumenhut

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Glockenblume");
  SetProp(P_LONG, 
    "Diese kleine lila Glockenblume wird von Holly als Hut verwendet. Sie welkt "
    "seltsamerweise nicht und ist fuer eine Fee ein huebscher Kopfschmuck.");
  SetProp(P_NAME, "Glockenblume");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0); 
  AddId( ({"glockenblume","blume"}) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 20);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_RACE: "Fee"]) );
   
  
	  
}  
   
