// 
// Callunas Hauch von Nichts

inherit "/d/dschungel/aaliyah/unterwaesche/armour/std_underwear";
 
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Hauch von Nichts");
  SetProp(P_LONG, 
    "Dieses knappe Oberteil besteht aus zwei perlmuttfarbenen Muscheln. "
    "Sie sind mit ein paar Perlenstraengen miteinander verbunden. Die "
    "Muscheln sind mit ein paar Perlen verziert und bedecken nur sehr "
    "wenig von der Traegerin.");
  SetProp(P_NAME, "Hauch von Nichts");
  SetProp(P_GENDER, MALE); 
  AddId( ({"hauch","muscheln","nichts"}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 150);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_PEARL:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp("underwear_type", "Buestenhalter");
  
}  
   
