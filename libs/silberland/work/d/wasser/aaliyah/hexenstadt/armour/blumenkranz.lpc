// Blumenkranz

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Blumenkranz");
  SetProp(P_LONG, 
    "Aus lauter Veilchen, Gaensebluemchen, Glockenblumen und Maigloeckchen wurde "
    "dieser huebsche Kranz gebunden. Die Blumen des Kranzes duften herrlich.");
  SetProp(P_NAME, "Blumenkranz");
  SetProp(P_SMELL, "Der Blumenkranz duftet wunderbar nach Veilchen.\n");
  SetProp(P_GENDER, MALE); 
  AddId( ({"blumenkranz","kranz"}) );
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 20);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:100]));
}  
   
