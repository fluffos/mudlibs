// Blumenkleid

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein langes, violettes Kleid");
  SetProp(P_LONG, 
    "Das Kleid besteht aus violettem Samt. Es hat lange glockenfoermige "
    "Aermel und einen mit Diamanten verzierten V-Ausschnitt. Es ist bodenlang "
    "und verlaeuft ab der Taille glockenfoermig. Alle Saeume sind mit "
    "Edelsteinen verziert, die im Kerzenschein funkeln.");
  SetProp(P_NAME, "Violets Kleid");
  SetProp(P_GENDER, NEUTER); 
  AddId( ({"kleid"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 850);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_VELVET:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );
  SetProp(P_ARTICLE, 0);
  
}  
   
