inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Rosa Riemchensandalen");
  SetProp(P_LONG, 
    "Dieses suesse Schuhwerk besteht aus rosa Leder. Die Sandalen haben viele "
    "zarte Riemchen, mit denen sie am Fuss befestigt werden. Weiters haben sie "
    "hohe Absaetze, die die Beine der Traegerin optisch verlaengern. Auf der "
    "Sohle sind zwei Buchstaben aufgedruckt. *MB*.");
  SetProp(P_NAME, "Riemchensandalen");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"sandalen","riemchensandalen"}) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_VALUE, 5000);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAGIC, 2);
  SetProp(P_PLURAL, 1);
//  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: "FEMALE"]) );
  SetProp(P_NAME_ADJ, "rosan");
}  
   
