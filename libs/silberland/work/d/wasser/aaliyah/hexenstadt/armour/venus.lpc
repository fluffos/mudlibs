// von Aaliyah
// 16.1.2005
 
// Venus Goetterkralle

inherit "std/armour";
#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Venus Goetterkralle");
  SetProp(P_LONG, 
    "Venus Goetterkralle sind feine goldene Handschuhe. Sie wurden aus dem "
    "goldenen Vlies erschaffen, wie fast alle Goetterruestungen. In das Vlies "
    "wurden die Kraefte der Goettin mitgewebt und bieten so einen sehr guten "
    "Schutz. Weiters befinden sich auf den Handschuhen einige magische Zeichen, "
    "die nur der Verzierung dienen.");
  SetProp(P_NAME, "Venus Goetterkralle");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"venus goetterkralle","kralle","handschuhe"}) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_SP:5, P_HP:7]) );
  SetProp(P_PALADIN_SPELLCOST, 5);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_UNHOLY:1, DT_COLD:1, DT_FIRE:1, DT_MAGIC:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "paladine", P_LEVEL: 50]) );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);

  AddDetail( ({ "vlies" }),
   "Das goldene Vlies funkelt und glitzert wunderschoen golden im Licht.");

  AddDetail( ({ "zeichen", "verzierungen" }),
   "Einige seltsame mystische Zeichen leuchten auf den Handschuhen. Sie sehen "
   "irgendwie aus wie viele ineinander verschlungene Kreise. Ob die etwas "
   "zu bedeuten haben?");

  AddDetail( ({ "kreise" }),
   "Die Form der Kreise veraendert sich staendig. Zuerst waren es Kreise, "
   "jetzt aber wirken die Zeichen irgendwie wie lauter kleine Sterne.");
  
  
 
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
  }

void _set_autoloadobj(mixed data)
  {
  SetProp(P_ITEMD_TMPMAGIC, data);
  }

mixed _query_autoloadobj()
  {
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
    
   
