// Heras Goetterschutz

inherit "std/armour";
#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Heras Goetterschutz");
  SetProp(P_LONG, 
    "Heras Goetterschutz ist eine sehr gute Ruestung vom Typ Panzer. Er "
    "besteht vollkommen aus Magie und erstrahlt in goettlichem Licht. Er "
    "wurde von Hera erschaffen, um sie im Kampf gegen die Diener der Hoelle "
    "zu beschuetzen. Dieser Panzer wurde von Hera gesegnet und laesst seinen "
    "Traeger mit goettlichen Kraeften kaempfen. Aus diesem Grund kann er nur "
    "von den maechtigsten aller Krieger benutzt werden.");
  SetProp(P_NAME, "Heras Goetterschutz");
  SetProp(P_INFO, "Dieser Panzer entfroscht Dich.");
  SetProp(P_GENDER, MALE); 
  AddId( ({"heras goetterschutz","goetterschutz","panzer","schutz"}) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 38);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_HP:10, P_SP:2]) );
  SetProp(P_PALADIN_SPELLCOST, 3);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_UNHOLY:1, DT_SOUND:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "paladine", P_LEVEL: 50]) );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);
  call_other("/p/daemon/itemd/functions/defendfuncnofrog", "???");
  SetProp(P_DEFEND_FUNC,
    find_object("/p/daemon/itemd/functions/defendfuncnofrog"));
  SetProp(P_INFO, "Heras Goetterschutz schuetzt Dich vor Verfroschung.");
 
  AddDetail( ({"hera","traeger","kraeften","kraefte"}),
    "Dieser Panzer wurde von Hera gesegnet. Er kann nur von maechtigen "
    "Kriegern getragen werden und verleiht ihnen die Eigenschaft, noch "
    "maechtiger zu werden. Aus diesem Grunde erlaubt es Hera nicht, das "
    "er von Froeschen getragen wird und verlieh ihm die Eigenschaft, seine "
    "Traeger zu entfroschen.");
 
 
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
   
  
   
