// Drachenrock

inherit "std/armour";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Regenbogenrock");
  SetProp(P_LONG, 
    "Dieser Rock schillert in allen Farben des Regenbogens. Das liegt daran, "
    "dass er aus den Schuppen des Regenbogendrachens gefertigt wurde. Er "
    "reicht der Traegerin bis knapp ueber die Knie und macht seine Traegerin "
    "etwas mutiger. Er schimmert in magischem Licht.");
  SetProp(P_NAME, "Regenbogenrock");
  SetProp(P_GENDER, MALE); 
  AddId( ({"rock","regenbogenrock"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_HORN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_TERROR:1]) );
  SetProp(P_MAGIC, 2);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER: FEMALE]) );

  
  
}  
   
