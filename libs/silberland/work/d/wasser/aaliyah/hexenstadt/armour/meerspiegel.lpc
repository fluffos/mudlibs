// Poseidons Meeresspiegel

inherit "std/armour";
#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Poseidons Meeresspiegel");
  SetProp(P_LONG, 
    "Poseidons Meeresspiegel ist ein wallender Umhang, der nur aus Wasser "
    "besteht. Sanfte Wellen wiegen leicht in ihm und spiegeln das Sonnenlicht. "
    "Dieses traumhafte Gebilde aus Wasser wurde von Poseidon, dem Gott des "
    "Wassers und des Erdbebens, erschaffen und genau diese Kraefte wurden in "
    "den Umhang gebannt. Darum ist diese Goetterruestung nur den staerksten "
    "Kriegern gewaehrt, und nur sie sind faehig diesen Umhang zu tragen.");
  SetProp(P_NAME, "Poseidons Meeresspiegel");
  SetProp(P_GENDER, MALE); 
  AddId( ({"poseidons meeresspiegel","meeresspiegel","umhang"}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_WATER:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_SP:6, P_HP:6]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([WASSER:7]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_WATER:1, DT_MAGIC:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "druidenzirkel", P_LEVEL: 50]) );
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);
 
  
  

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
   
   
