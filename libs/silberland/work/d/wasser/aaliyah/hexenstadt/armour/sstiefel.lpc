// Seidenstiefel

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Paar Seidenstiefel");
  SetProp(P_LONG, 
    "Diese kleinen Stiefelchen bestehen aus reinster weisser Seide. Sie sind "
    "wohl kein allzu guter Schutz gegen Wind und Wetter, sehen aber trotzdem "
    "huebsch aus. Shila hat sie selbst genaeht.");
  SetProp(P_NAME, "Seidenstiefel");
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_PLURAL, 1);
  AddId( ({"seidenstiefel","stiefel"}) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 200);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_RACE: "Fee"]) );
  
}  
   
