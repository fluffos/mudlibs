// von Aaliyah
// 10.11.2004
// Mondsichel


inherit "std/armour";
#include "../def.h"

int traene_drauf;
void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Eine Mondsichel");
  SetProp(P_LONG, 
    "Die Mondsichel ist eine schlichte Kette aus Silber. Sie sieht aus wie "
    "ein schmaler Reifen in der Form eines Halbmondes. Mit einem Anhaenger "
    "sieht die Mondsichel sicherlich huebsch aus.");
  SetProp(P_NAME, "Mondsichel");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"sichel","mondsichel"}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILVER:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MAGIC, 1);
  SetProp(P_PLURAL, 0);

  AddCmd( ({ "steck", "stecke", "befestige", "befestig" }), "c_befestigen");

 }

 int c_befestigen(string str)

 {
   object ob;
   
   notify_fail(BS("Was moechtest Du woran befestigen?"));
   if(str == "traene an mondsichel" || str == "traene an sichel")
   
   {
   if (traene_drauf)
   {
   write(BS("Aber es steckt ja schon ein Anhaenger auf der Kette!"));
     return -1;
 }
   if (!ob = present("morrighan_traene", TP))
 
 {
   write(BS("Aber Du hast Doch gar keine Traene!"));
     return -1;
   }

   write(BS("Du befestigst die Traene an der Mondsichel."));

   traene_drauf = 1;
   SetProp(P_MATERIAL, ([MAT_SILVER:90, MAT_CRYSTAL:10]));
   

   SetProp(P_LONG, 
    "Die Mondsichel ist eine schlichte Kette aus Silber. Sie sieht aus wie "
    "ein schmaler Reifen in der Form eines Halbmondes. Eine schoene kleine "
    "Traene befindet sich als Anhaenger darauf.");
   
   ob->remove();

   return 1;
   
   } 
   
   if(str == "perle an mondsichel" || str == "perle an sichel")
   
 {
    
   if (traene_drauf)
   {
   write(BS("Aber es steckt ja schon ein Anhaenger auf der Kette!"));
     return -1;
 }
   if (!ob = present("calluna_perle", TP))
 
 {
   write(BS("Aber Du hast Doch gar keine passende Perle!"));
     return -1;
   }

   write(BS("Du befestigst die Perle an der Mondsichel."));

   traene_drauf = 1;
   SetProp(P_MATERIAL, ([MAT_SILVER:90, MAT_PEARL:10]));
   

   SetProp(P_LONG, 
    "Die Mondsichel ist eine schlichte Kette aus Silber. Sie sieht aus wie "
    "ein schmaler Reifen in der Form eines Halbmondes. Eine schoene kleine "
    "Perle in Form eines Tropfen befindet sich.");

   
   ob->remove();

      return 1;
   }
   return 0;
 }

   
   
