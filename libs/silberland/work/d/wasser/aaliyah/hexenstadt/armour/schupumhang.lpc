// Schuppenumhang

inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Schuppenumhang");
  SetProp(P_LONG, 
    "Der Schuppenumhang wurde aus den Drachenschuppen des Feuerdrachen "
    "gefertigt. Er ist bodenlang und hat eine Kapuze aufgenaeht. Dieser "
    "Umhang bietet einen guten Schutz gegen Feuer und schimmert magisch.");
  SetProp(P_NAME, "Schuppenumhang");
  SetProp(P_GENDER, MALE); 
  AddId( ({"umhang","schuppenumhang"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_HORN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_FIRE:1]) );
  SetProp(P_MAGIC, 1);
}  
   
