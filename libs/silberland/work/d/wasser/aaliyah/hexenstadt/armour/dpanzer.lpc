inherit "std/armour";

#include "../def.h"
#include <properties.h>
#include <combat.h>
#include <armour.h>


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Sanddrachenpanzer");
  SetProp(P_LONG, 
    "Kraya und Kerek mussten ihr Leben fuer diese schoene Ruestung lassen. "
    "Ihre Schuppen wurden zu einem einzigartigen Panzer verarbeitet. Einige "
    "magische Muster zieren die Vorderseite, und an der Rueckseite ist das "
    "Wappen des Drachens eingeritzt.");
  SetProp(P_NAME, "Sanddrachenpanzer");
  SetProp(P_GENDER, MALE); 
  AddId( ({"panzer","sanddrachenpanzer"}) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 1200);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_HORN:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_FIRE:1]) );
  SetProp(P_MAGIC, 2);
  SetProp(P_PLURAL, 0);
  SetProp(P_ARTICLE, 1);
  
  
}  
   
