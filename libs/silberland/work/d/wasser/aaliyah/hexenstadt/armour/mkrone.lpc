// 16.1.2005
// 
// Minveras Krone

inherit "std/armour";
#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"


void create()
{
  if (!is_clone(TO)) return;

  ::create();
  
  SetProp(P_SHORT, "Minervas Krone");
  SetProp(P_LONG, 
    "Diese wunderschoene Krone gehoerte einst der Goettin Minerva. Sie "
    "hat 5 filigrane Zacken, an deren Ende sich jeweils ein eisblauer Aquamarin "
    "in Form eines Tropfen befindet. Weiters ist die Krone mit vielen kleinen "
    "Edelsteinsplittern verziert und ist somit ein sehr schoener Kopfschmuck. "     "Minervas Krone verbessert die Faehigkeiten der Druiden und kann auch nur "
    "von den maechtigsten Elementarbeschwoerern genutzt werden.");
  SetProp(P_NAME, "Minervas Krone");
  SetProp(P_INFO, "Dieser Helm schuetzt vor Paralyse.");
  SetProp(P_GENDER, FEMALE); 
  AddId( ({"minervas krone","krone","helm"}) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 3000);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 12);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_LIGHT, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_M_HEALTH_MOD, ([P_HP:12]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, 3);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
	 ([DT_HOLY:1, DT_UNHOLY:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([P_GUILD: "druidenzirkel", P_LEVEL: 50]) );

  call_other("/p/daemon/itemd/functions/defendfuncnoparalyze", "???");
  SetProp(P_DEFEND_FUNC,
  find_object("/p/daemon/itemd/functions/defendfuncnoparalyze"));
  SetProp(P_QUALITY_DECAY, 150 + random(50));
  SetProp(P_MAGIC, 5);

  AddDetail( ({"edelsteinsplittern","edelsteinsplitter","splitter"}),
   "Viele bunte Splitter von jeglicher Art von Edelsteinen.");
 		  
  
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);


}  
  
  
  

   
