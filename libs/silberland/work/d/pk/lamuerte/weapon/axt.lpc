//PK Axt 
//funktion: create_weapon("rasse");
// rasse.. eine spielerrase gegen die mehr schaden gemacht wird.
// returns 1 if race is ok, otherwise it returns 0.

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

#include "./pk.h"

string oldtitle;
string roomname;
string rasse;

create()
{
  if( !is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine undefinierte PK Doppelaxt");
  SetProp(P_LONG,  
    "UNDEFINIERT.");
  SetProp(P_NAME, "Doppelaxt");
  SetProp(P_INFO, 
    "UNDEFINIERT."
     );

  SetProp(P_NAME, "Doppelaxt");
  
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_DAM_TYPE, ({DT_RIP}) );
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 40);
  SetProp(P_NR_HANDS, 2);
 
  SetProp(P_MATERIAL, ([MAT_MAGIC:70, MAT_OAK:30]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 0);
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());  
  AddId( ({"axt", "\npk"}) );

}

int create_weapon(string r)
{
  rasse=capitalize(r);

  if(!PK_VALID_RACE(r))
  {
    return  0;
  }
  
  SetProp(P_SHORT, "Eine Doppelaxt namens '"+rasse+"tod' der Zerstoerer");
  SetProp(P_LONG,  
    "Ein praechtige Axt welche sich gut dazu eignet Deine Mitspieler zu spalten. Diese hier ist mit Edelsteinen besetzt "+
    "und eignet sich wunderbar dazu "+(rasse)+"en das Fuerchten zu lehren. Sie ist zwei Meter lang, ihere mit spitzen "+
    "Zaehnen uebersaehte Klinge ist doppelschneidig und scheint aus einem Magisch rotem Material zu sein. ");
  SetProp(P_INFO, 
    "Dies ist eine PK Schwert. Sie besteht aus einem magischen Material welches "+(rasse)+"en wirkliche Schmerzen "+
    "zufuegen kann. Du solltest sie einsetzen wenn Du mal einen "+(rasse)+" jagst.");
  AddId( ({lower_case(rasse)+"tod"}) );

  return 1;
}

int WieldFunc(object waffe)
{
  object ob;

  ob=environment(this_player());
  roomname=file_name(ob);

  
  if(roomname[0..5]!="/d/pk/"){
    write("Diese Waffe kann hier nicht gezueckt werden!\n");
    return 0;
    }
   oldtitle=this_player()->QueryProp(P_TITLE);

  if( this_player()->QueryProp(P_GENDER)==FEMALE )
    this_player()->SetProp(P_TITLE, "die "+(rasse)+" Spalterin");
  else
    this_player()->SetProp(P_TITLE, "der "+(rasse)+" Spalter");
  return 1;
  }

int UnwieldFunc(object waffe)
{
  this_player()->SetProp(P_TITLE, oldtitle);
  return 1;
}

int HitFunc(object enemy)
{
  object ob; 
  int schaden;
  
   ob=environment(this_player());
   roomname=file_name(ob);

   if(roomname[0..5]!="/d/pk/" || interactive(enemy)==0){
     call_out("RemoveMe",0);
     return 0;
   }
   
  if( enemy->QueryProp(P_RACE)!=rasse )
  {
    return 0;
  }
  if( enemy->QueryProp(P_RACE)==rasse )
  {
    schaden=50+random(170);
    if( random(5100)==55 )
    {
      write("Deine magisch rot gluehende Doppelaxt VERNICHTET "+enemy->name(WEN)+".\n");
      return 100+random(2000);
    }
    if( schaden>205)
    {
      write("Die vordere Klinge deiner Doppelaxt hinterlaesst einen tiefen Schnitt Koerper von "+
       enemy->name(WEN)+".\n"+
      "Die hintere Klinge deiner Doppelaxt hinterlaesst einen tiefen Schnitt Koerper von "+
       enemy->name(WEN)+".\n");

      tell_object(enemy,"Die Doppelaxt von "+this_player()->QueryProp(P_NAME)+ 
          " hinterlaesst tiefe Wunden in Deinem Koerper als sie Dich mit beiden Klingen erwischt.\n");
      

      return schaden+(2*40);
    }
  return 0;  
  }
}

RemoveMe()
{
 this_player()->command_me("steck schwert zurueck");
 write("Deine Axe zerfaellt zu Staub.");
 this_object()->remove(1);
  return 1;
}

