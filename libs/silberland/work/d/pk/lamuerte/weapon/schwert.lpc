//PK Schwert
//funktion: create_weapon("rasse");
// rasse.. eine spielerrase gegen die mehr schaden gemacht wird.
// returns 1 if race is ok, otherwise it returns 0.

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

#include "./pk.h"

string oldtitle;
string roomname;
string rasse;

create()
{
  if( !is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein undefiniertes PK Langschwert");
  SetProp(P_LONG,  
    "UNDEFINIERT");
  SetProp(P_NAME, "Langschwert");
  SetProp(P_INFO, 
    "UNDEFINIERT."
     );

  SetProp(P_NAME, "Langschwert");
  
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 40);
  SetProp(P_NR_HANDS, 1);
 
  SetProp(P_MATERIAL, ([MAT_MAGIC:70, MAT_OAK:30]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 0);
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());  
  AddId( ({"schwert", "\npk"}) );

}

int create_weapon(string r)
{
  rasse=capitalize(r);

  if(!PK_VALID_RACE(r))
  {
    return  0;
  }
  
  SetProp(P_SHORT, "Ein Langschwert namens '"+rasse+"tod'");
  SetProp(P_LONG,  
    "Ein praechtiges Langschwert welches sich gut dazu eignet Deine Mitspieler zu zerstoeren. Dieses hier "+
    "eignet sich wunderbar dazu aus "+(rasse)+"en Hackfleisch zu machen. Es ist eineinhalb Meter "+
    "lang und seine Klinge scheint aus einem Magisch grünen Material zu sein. ");
  SetProp(P_INFO, 
    "Dies ist ein PK Schwert. Es besteht aus einem magischen Material welches "+(rasse)+"en wirkliche Schmerzen "+
    "zufuegen kann. Du solltest es einsetzen wenn Du mal einen "+(rasse)+" jagst.");
  AddId( ({lower_case(rasse)+"tod"}) );

  return 1;
}

int WieldFunc(object waffe)
{
  object ob;

  ob=environment(this_player());
  roomname=file_name(ob);

  
  if(roomname[0..5]!="/d/pk/"){
    write("Diese Waffe kann hier nicht gezueckt werden!\n");
    return 0;
    }
   oldtitle=this_player()->QueryProp(P_TITLE);

  if( this_player()->QueryProp(P_GENDER)==FEMALE )
    this_player()->SetProp(P_TITLE, "die Playerkillerin");
  else
    this_player()->SetProp(P_TITLE, "der Playerkiller");
  return 1;
  }

int UnwieldFunc(object waffe)
{
  this_player()->SetProp(P_TITLE, oldtitle);
  return 1;
}

int HitFunc(object enemy)
{
  object ob; 
  int schaden;
  
   ob=environment(this_player());
   roomname=file_name(ob);

   if(roomname[0..5]!="/d/pk/" || interactive(enemy)==0){
     call_out("RemoveMe",0);
     return 0;
   }
   
  if( enemy->QueryProp(P_RACE)!=rasse )
  {
    return 0;
  }
  if( enemy->QueryProp(P_RACE)==rasse )
  {
    schaden=50+random(150);
    if( random(2100)==55 )
    {
      write("Die Klinge deines Langschwerts glueht auf und VERNICHTET "+enemy->name(WEN)+".\n");
      return 100+random(2000);
    }
    if( schaden>170)
    {
      write("Die Klinge deines Schwertes hinterlaesst klaffende Wunden im Koerper von "+
       enemy->name(WEN)+".\n");
      tell_object(enemy,"Das Schwert von "+this_player()->QueryProp(P_NAME)+ 
          " hinterlaesst eine schmerzende Fleischwunde in Deinem Koerper.");
    return schaden+40;
    }
  return 0;  
  }
}

RemoveMe()
{
 this_player()->command_me("steck schwert zurueck");
 write("Deie Schwert zerfaellt zu Staub.");
 this_object()->remove(1);
  return 1;
}

