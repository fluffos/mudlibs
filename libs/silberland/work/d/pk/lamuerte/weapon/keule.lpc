//PK Keule 
//funktion: create_weapon("rasse");
// rasse.. eine spielerrase gegen die mehr schaden gemacht wird.
// returns 1 if race is ok, otherwise it returns 0.

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

#include "./pk.h"

string oldtitle;
string roomname;
string rasse;

create()
{
  if( !is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine undefinierte PK Keule");
  SetProp(P_LONG,  
    "UNDEFINIERT.");
  SetProp(P_NAME, "Keule");
  SetProp(P_INFO, 
    "UNDEFINIERT."
     );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 30);
  SetProp(P_NR_HANDS, 1);
 
  SetProp(P_MATERIAL, ([MAT_MAGIC:70, MAT_OAK:30]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 0);
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());  
  AddId( ({"keule", "\npk"}) );

}

int create_weapon(string r)
{
  rasse=capitalize(r);

  if(!PK_VALID_RACE(r))
  {
    return  0;
  }
  
  SetProp(P_SHORT, "Eine Keule der Geschwindikgit namens '"+rasse+"verklopper'");
  SetProp(P_LONG,  
    "Ein praechtige Keule welche sich gut dazu eignet Deine Mitspieler zu verpruegeln. Diese hier ist mit Stacheln besetzt "+
    "und eignet sich wunderbar dazu "+(rasse)+"en den Schaedel einzuschlagen. Sie ist einen Meter lang, ihere mit spitzen "+
    "Stacheln uebersaehte Forderseite sieht gefaehrlich aus und scheint aus einem Magisch gauem Material zu sein. ");
  SetProp(P_INFO, 
    "Dies ist eine PK Keule. Sie besteht aus einem magischen Material welches "+(rasse)+"en wirkliche Schmerzen "+
    "zufuegen kann. Du solltest sie einsetzen wenn Du mal einen "+(rasse)+" jagst.");
  AddId( ({lower_case(rasse)+"verklopper"}) );

  return 1;
}

int WieldFunc(object waffe)
{
  object ob;

  ob=environment(this_player());
  roomname=file_name(ob);

  
  if(roomname[0..5]!="/d/pk/"){
    write("Diese Waffe kann hier nicht gezueckt werden!\n");
    return 0;
    }
   oldtitle=this_player()->QueryProp(P_TITLE);

  if( this_player()->QueryProp(P_GENDER)==FEMALE )
    this_player()->SetProp(P_TITLE, "die "+(rasse)+" Spalterin");
  else
    this_player()->SetProp(P_TITLE, "der "+(rasse)+" Spalter");
  return 1;
  }

int UnwieldFunc(object waffe)
{
  this_player()->SetProp(P_TITLE, oldtitle);
  return 1;
}

int HitFunc(object enemy)
{
  object ob; 
  int schaden;
  
   ob=environment(this_player());
   roomname=file_name(ob);

   if(roomname[0..5]!="/d/pk/" || interactive(enemy)==0){
     call_out("RemoveMe",0);
     return 0;
   }
   
  if( enemy->QueryProp(P_RACE)!=rasse )
  {
    return 0;
  }
  if( enemy->QueryProp(P_RACE)==rasse )
  {
    schaden=50+random(150);
    if( random(8700)==55 )
    {
      write("Deine magisch grau funkelnde Keule VERNICHTET "+enemy->name(WEN)+".\n");
      return 100+random(2000);
    }

  if( schaden>110)
  {
    write("  Du triffst "+enemy->name(WEN)+" sehr hart.\n");

    tell_object(enemy,"  "+this_player()->QueryProp(P_NAME)+" trifft Dich sehr hart.\n");
                          
    return schaden+(30);
  }

    
  if( schaden>160)
  {
    write("  Du triffst "+enemy->name(WEN)+" sehr hart.\n");
    write("  Du triffst "+enemy->name(WEN)+" sehr hart.\n");

    tell_object(enemy,"  "+this_player()->QueryProp(P_NAME)+" trifft Dich sehr hart.\n");
    tell_object(enemy,"  "+this_player()->QueryProp(P_NAME)+" trifft Dich sehr hart.\n");

    return schaden+(2*30);
  }

    
    if( schaden>180)
    {
      write("  Du triffst "+enemy->name(WEN)+" sehr hart.\n");
      write("  Du zerschmetterst "+enemy->name(WEN)+" in kleine Stueckchen.\n");
      write("  Du triffst "+enemy->name(WEN)+" sehr hart.\n");

      tell_object(enemy,"  "+this_player()->QueryProp(P_NAME)+" trifft Dich sehr hart.\n");
      tell_object(enemy,"  "+this_player()->QueryProp(P_NAME)+" zerschmettert Dich in kleine Stueckchen.\n");
      tell_object(enemy,"  "+this_player()->QueryProp(P_NAME)+" trifft Dich sehr hart.\n");
      return schaden+(3*30);
      }
  return 0;  
  }
  } 

  
  
RemoveMe()
{
 this_player()->command_me("steck keule zurueck");
 write("Deine Keule zerfaellt zu Staub.\n");
 this_object()->remove(1);
  return 1;
}

