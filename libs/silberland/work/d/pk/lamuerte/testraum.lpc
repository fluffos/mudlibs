inherit "std/room";
#include <properties.h>
#include <language.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "Im Nichts");
  SetProp( P_INT_LONG, "Du stehst in einem dunklen Teil des Nichts, hierher "+
  "brachten Dich magische kraefte, als die Mauern einstuertzen. ");
  SetProp( P_LIGHT, 1);
}
