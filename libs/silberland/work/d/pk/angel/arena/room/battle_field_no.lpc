#pragma strong_types

inherit "std/room";

#include <properties.h>
#include "./def.h"
#include LIB_DUELL "headers/duell.h"

// Prueft ob ein Item eine illegale ID hat:
int verify_item (object ob)
{
   int i;
   for (i = 0; i <  sizeof( P_ILLEGAL_ITEMS ); i++)
       if ( ob->id( P_ILLEGAL_ITEMS[i] ) )
          return 1;
}

// Alle Illegalen Dinge werden in die Truhe eingelagert:
void remove_illegal_things()
{
   int    index, i;
   object ob;
   mixed  illegal_inv;
   
   ob = this_object();
   
   // Dieses Array enthaelt dann alle illegalen items:
   illegal_inv = filter_array(deep_inventory(ob), #'verify_item );
   
   if (!sizeof(illegal_inv))
      return;
      
   // Wir legen die Dinge in die Truhe im Buero:
   for (i = 0; i < sizeof (illegal_inv); i++)
       illegal_inv[i]->move(DOBJ "arena_box", M_NOCHECK);
}   

void remove_objects()
{
   object *things,*people,*all;
   int i;
   
   all = all_inventory(this_object());
   people = filter_array(all_inventory(this_object()), #'living );
 
   things = all - people;

   for(i = sizeof(things) -1; i>=0; i--)
   {
      if (query_once_interactive(things[i]))
         things[i]->move(DROOM "arena_buero", M_NOCHECK);
      else
         things[i]->move(DOBJ "arena_box", M_NOCHECK); 
   }
   
   for(i = sizeof(people) -1; i>=0; i--)
   {
      if (interactive(people[i]))
         people[i]->move(DROOM "nordteil", M_NOCHECK);
   }      
} 

// Wir werfen alles Illegale Zeug raus welches uns wasauchimmer bringen mag :)
void init ()
{
   ::init();
   remove_illegal_things();
}


void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Nordostteil der Arena" );
  SetProp( P_INT_LONG, break_string("Du befindest Dich hier im Nordostteil der Arena. Von hier aus haette "+
           "man einen guten Ueberblick ueber den Kampfplatz und die Tribuene der Arena, waere da nicht das unangenehme "+
           "Gefuehl der Gefahr, welches Dich daran hindert, alles in Ruhe unter die Lupe zu nehmen.",78));
           
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

  SetProp(P_INDOORS,0);

  SetProp(P_NO_TPORT, NO_TPORT_OUT|NO_STARGATE_TPORT);

  AddDetail( ({"ruhe", "nerven", "forschen" }),
             "Na Du hast Nerven! Auf dem Kampfplatz einer Arena forschen zu wollen!\n" );
  AddDetail( ({ "nordostteil", "teil" }),
             "Du befindest Dich im Nordostteil des Kampfplatzes, unter der Tribuene." );
  AddDetail( "ueberblick",
             "Ja den Ueberblick hast Du ... noch ..." );
  AddDetail(  "lupe",
              "Eine Lupe brauchst Du hier sicherlich nicht! Eher eine Waffe oder ein Zauberbuch mit dem Du gut umgehen kannst.\n" );
  AddDetail( ({ "waffe", "zauberbuch", "buch" }),
             "Hoffentlich hast Du schon vorher daran gedacht, hier wirst Du nichts finden ausser Dein Verderben.\n" );
  AddDetail( ({"verderben","ende","tod"}),
             "Dein eigenes Ende, Deinen Tod solltest Du nicht stark genug sein.\n" );
  AddDetail( "gefuehl",
             "Wirklich gruselig!\n" );
  AddDetail( ({ "boden", "lehmboden" }),
             "Der Boden besteht aus festgetretenem Lehm.\n" );
  AddDetail( "lehm",
             "Festgetretener Lehm, den die Sonne ausgetrocknet hat.\n" );
  AddDetail( ({ "holz", "steineichenholz" }),
             "Bekannt fuer seine Stabilitaet.\n" );
  AddDetail( ({ "stabilitaet" }),
             "Haelt eben etwas aus.\n" );
  AddDetail( ({ "wand", "waende" }),
             "Die Waende der Tribuene sind aus solidem Holz.\n" );
  AddDetail( ({ "tribuene", "tribuenen" }),
             "Bei genauerem Hinsehen kannst Du ein System von Spiegeln an den Waenden der Tribuene "+
             "ausmachen, welches wahrscheinlich dazu dient den Zuschauern auch die Sicht unter die Tribuene "+
             "zu ermoeglichen.\n");
  AddDetail( ({ "sicht", "spiegel", "system" }),
             "Eigentlich ein geniales System!\n" );
  AddDetail( "hinsehen",
             "Du bemuehst Dich wirklich." );
  AddDetail( ({ "zuschauer", "zuseher" }),
             "Von hier unten kannst Du keine ausmachen, was aber nicht heisst, dass Dir niemand zusieht." );
  AddDetail( "niemand",
             "Du denktst darueber nach ob man 'niemand' wirklich sehen kann kann, gibst es aber schnell wieder auf." );
  AddDetail( "decke",
             "Da alles als Freiluftbuehne angelegt zu sein scheint ist keine Decke vorhanden.\n" );
  AddDetail( ({ "buehne", "freiluftbuehne" }),
             "So etwas befindet sich immer im Freien.\n" );
  AddDetail( "freien",
             "Nun draussen im Freien eben.\n" );
  AddDetail( ({ "sonne", "himmel", "hitze", "grund" }), BS(
                "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
                "der Grund fuer die Hitze hier.") );
  AddDetail( ({ "licht", "lichtverhaeltnisse" }),
             "Die Lichtverhaeltnisse sind optimal fuer Augen, die das Licht verkraften.\n" );
  AddDetail( "augen",
             "Scheust Du etwa das Licht?\n" );
  AddDetail( ({ "arena", "arenen", "gebaeude", "kampfplatz" }),
             "Eine Arena ist ein Platz auf dem Kaempfe ausgetragen werden.\n" );
  AddDetail( ({ "kampf", "kaempfe" }),
             "Was ein Kampf ist weisst Du sicher schon.\n" );
  AddDetail( ({ "platz" }),
             "In diesem Fall ist es ein oval angelegter Platz.\n" );
  AddDetail( ({ "fall" }),
             "Nun wieviele Arenen hast Du schon gesehen?\n" );


  AddExit("westen",([ EX_DEST : ROOM "battle_field_nw",
                      EX_MSG  : "nach Westen in den Nordwestteil der Arena"]) );

  AddExit("sueden",([ EX_DEST : ROOM "battle_field_zo",
                      EX_MSG  : "nach Sueden, ins oestliche Zentrum der Arena"]) );

  AddExit("suedosten",([ EX_DEST : ROOM "battle_field_o",
                         EX_MSG  : "nach Suedosten in den Ostteil der Arena"]) );

  AddExit("suedwesten",([ EX_DEST : ROOM "battle_field_zw",
                          EX_MSG  : "nach Suedwesten, ins westliche Zentrum der Arena"]) );


  AddItem(DOBJ "camera", REFRESH_REMOVE);

}
