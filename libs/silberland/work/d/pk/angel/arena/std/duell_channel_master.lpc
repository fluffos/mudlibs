#include "./def.h"

void create()
{
  if (is_clone(this_object()))
     destruct (this_object());
}

string name() 
{  
  return "Die Arenaleitung"; 
}

void Channel(string msg) 
{
  CHMASTER->join("Duell",TO);
  CHMASTER->send("Duell","",msg,MSG_SAY);
}
