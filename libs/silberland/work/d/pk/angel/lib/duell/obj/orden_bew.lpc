// Checkt ob el element von arr ist.
int is_element (mixed arr, object el)
{
  int i;
  for (i = 0;i < sizeof(arr) ;i++)
  {  
     if (arr[i] == el) return 1;
  }
  return 0;
}

// Sind wir beim Duell Koordinator registriert?
int is_registered (object ob)
{
  object server;
  
  catch(call_other(OBJ "coordinator", "???", 0));
  if (objectp(server = find_object( OBJ "coordinator")))
  {
     if ((ob == server->get_partner())||
         (ob == server->get_challenger()))
         return 1;
  }
  else 
  return 0;
}

// Sind wir dabei uns im Buero zu registrieren?
int is_registering (object ob)
{
  object buero;
  if (objectp(buero = find_object( DROOM "arena_buero")))
  {
     if ((ob == buero->get_pot_partner())||
         (ob == buero->get_challenger()))
         return 1;
  }
  return 0;
}

string check_duell_mode ()
{
   string modus;
   modus = "Duell ";
   if (honour_mode)
      modus += "der Ehre ";
   if (fatality_mode)
      modus += "bis zum Tod eines Duellanten";
   else
      modus += "bis zur Bewusstlosigkeit eines Duellanten";
   return modus;
}
