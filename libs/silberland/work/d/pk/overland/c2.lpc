inherit "/std/room";

#include <room.h>
#include <properties.h>
#include <moving.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Stadt 2");
  SetProp(P_INT_LONG, "Du befindest Dich beim Tor von der Stadt 2.\n");
  SetProp(P_LIGHT, 1);
 
  AddSpecialExit("norden", "ov_1");
}
ov_1()
{
  object des;
  des="/d/pk/overland/ovmaster"->init_new_player(this_player(), 30, 91);
  this_player()->move(des, M_GO, "nach Norden");
  return 1;
}

