    o->remove();
    rooms[y][x]=0;
  }
  return 1;
  */
}

mixed init_new_player(object p, int mx, int my)
{
  object o;

  ply+= ([ p: ({ mx, my }) ]);
  
//  if (find_player("creative"))
//    tell_object(find_player("creative"), sprintf("%O\n", ply));

  return init_room(mx, my);
}

int remove_player(object p)
{
  remove_room(ply[p][0], ply[p][1]);
  if (member(ply, p))
    ply-=([ p ]);
}


int move_north(object pl)
{
  int x, y;

  if (!member(ply, pl))
    return 0;
  x=ply[pl][0];
  y=ply[pl][1];
  
  y--;
  switch (query_xy(x, y)) {
    case OV_CITY:     pl->move(query_city(x,y), M_GO, "in die Stadt"); 
                      remove_player(pl);
                      return 1;
    case OV_WATER:    y++; break;
	case OV_MOUNTAIN: y++; break;
	case OV_OTHERS:   y++; break;
	default: if (y<1) y=1;
  }
  if (ply[pl][1]==y) {
    tell_object(pl, "Etwas hindert Dich daran, hier weiterzugehen.\n");
    return 1;
  }
  ply[pl][1]=y;
  pl->move(init_room(x, y), M_GO, "nach Norden");
  remove_room(x, y+1);
  return 1;
}

int move_south(object pl)
{
  int x, y;

  if (!member(ply, pl))
    return 0;
  x=ply[pl][0];
  y=ply[pl][1];

  y++;
  switch (query_xy(x, y)) {
    case OV_CITY:     pl->move(query_city(x,y), M_GO, "in die Stadt"); 
                      remove_player(pl);
                      return 1;
    case OV_WATER:    y--; break;
	case OV_MOUNTAIN: y--; break;
	case OV_OTHERS:   y--; break;
	default: if (y>height-2) y=height-2;
  }
  if (ply[pl][1]==y) {
    tell_object(pl, "Etwas hindert Dich daran, hier weiterzugehen.\n");
    return 1;
  }
  ply[pl][1]=y;
  pl->move(init_room(x, y), M_GO, "nach Sueden");
  remove_room(x, y-1);
  return 1;
}

int move_west(object pl)
{
  int x, y;

  if (!member(ply, pl))
    return 0;
  x=ply[pl][0];
  y=ply[pl][1];

  x--;
  switch (query_xy(x, y)) {
    case OV_CITY:     pl->move(query_city(x,y), M_GO, "in die Stadt"); 
                      remove_player(pl);
                      return 1;
    case OV_WATER:    x++; break;
	case OV_MOUNTAIN: x++; break;
	case OV_OTHERS:   x++; break;
	default: if (x<1) x=1;
  }
  if (ply[pl][0]==x) {
    tell_object(pl, "Etwas hindert Dich daran, hier weiterzugehen.\n");
    return 1;
  }
  ply[pl][0]=x;
  pl->move(init_room(x, y), M_GO, "nach Westen");
  remove_room(x+1, y);
  return 1;
}

int move_east(object pl)
{
  object lastenv;
  int x, y;

  if (!member(ply, pl))
    return 0;
  x=ply[pl][0];
  y=ply[pl][1];

  x++;
  switch (query_xy(x, y)) {
    case OV_CITY:     pl->move(query_city(x,y), M_GO, "in die Stadt"); 
                      remove_player(pl);
                      return 1;
    case OV_WATER:    x--; break;
	case OV_MOUNTAIN: x--; break;
	case OV_OTHERS:   x--; break;
	default: if (x>width-2) x=width-2;
  }
  if (ply[pl][0]==x) {
    tell_object(pl, "Etwas hindert Dich daran, hier weiterzugehen.\n");
    return 1;
  }
  ply[pl][0]=x;
  pl->move(init_room(x, y), M_GO, "nach Osten");
  remove_room(x-1, y);
  return 1;
}

