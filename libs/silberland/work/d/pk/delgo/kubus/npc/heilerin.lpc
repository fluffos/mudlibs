#include "../def.h"

inherit "std/npc";

//inherit "/std/player/moneyhandler";

int heilung;            // wie oft heilt sie denn?

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "\e[1mE\e[0mine \e[1mH\e[0meilerin");
  SetProp(P_LONG,
    "Androna, die Heilerin der Zwerge. Obwohl sie eine Elfe ist, half sie Leuten vom kleinen Volk in ihrer Schlacht. Sie heilte Kaempfer des Volkes da ihre Heilmaechte die der Geoden weit uebertraf. "
    "Heute rennt sie ziellos durch die Reste der alten Festung. Ob sie dich noch heilen kann?"
  );
  SetProp(P_INFO, "Androna wird dich einige Male komplett und kostenlos heilen. Nutze das weise!");
  SetProp(P_NAME, "Androna");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));
  //set_linving_name(); unwichtig
  AddId( ({"androna","heilerin"}) );
  AddClass(CL_ELF); 
  SetProp(P_NOATTACK, "sagt: das waere unklug!");
  create_default_npc(25);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Elf");
  SetProp(P_SIZE, 165);
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MNPC_AREA, 1); //am besten nur in den nX, cX, pX, lX- woanders verleirt sie ja nur lps =)

  SetProp(P_WIMPY, 0);

  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  AddInfo(DEFAULT_INFO, "Ich kann Dich heilen!","fragt Dich: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );

  SetChats(3,
    ({Name(WER,1)+" sagt: Ich war die Heilerin der Zwerge!\n"
     })
  );

  
  AddCmd( ({"heile","heil"}), "cmd_heilen");

  heilung = 5; 

  
}

void init()
{
  ::init();


  if(TP && interactive(TP)) call_out("init_hallo",0,TP);
}

void init_hallo(object player)
{
  if(!player)                return;
  if(!interactive(player))   return;
  if(ENV(player) != ENV(TO)) return;

  tell_room(ENV(TO),break_string(
    "Hallo "+TP->name()+", wenn ich Dich heilen soll, so sage \"heile mich\". Ich kann auch deine Magie wieder auffrischen! "
    ,78,Name(WER,1)+" sagt: ",1));
}


void reset()
{
  ::reset();

  heilung += 1;
  if(heilung > 5) heilung = 5; 

}


// HEILEN


int cmd_heilen(string str)
{
  notify_fail("Wenn ich dich heilen soll musst du nur \"heile mich\" eingeben!\n");

  if(!str || str == "") return 0;
  if(!(str == "mich"))  return 0;
// 5 HEILUNGEN!
  if(heilung <= 0)
  {
    tell_object(TP, "Andronas heilenden Kraefte muessen sich erst "
                    "regenerieren.\n");
    return -1;   }
/*// HEILUNG NOTWENDIG?
  if(TP->QueryProp(P_MAX_HP) == TP->QueryProp(P_HP))
  {
    tell_object(TP,"Du brauchst doch gar keine Heilung!\n");
    return -1;
  }*/ //lassen wir mal weg -  jeder muss wissen wie er die dinger verschwendet =)
  tell_object(TP,"Androna heilt Dich.\n");
  TP->AddHp(350+random(50)); 
  TP->AddSp(350+random(50));
  heilung = heilung -1;
  return 1;
}







