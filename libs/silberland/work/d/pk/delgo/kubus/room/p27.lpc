#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Dschungel - 2");
  SetProp(P_INT_LONG,
    "     \e[32mMitten im Dschungel\e[0m\n"
    "Du kannst kaum erkennen wo du hintrittst. Ueberall nur Pflanzen, Gruenzeug, Gewaechse "
    "und Natur pur! Weit kannst du nicht schauen denn die dicken Baeume versperren die Sicht. "
    "Den Himmel kannst du natuerlich auch nicht sehen und die Orientierung faellt dir langsam schwer..."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );

  AddDetail( ({"untergrund" , "erde" , "boden"}) ,
    "Pfalnzen"
  );

  AddDetail( ({"sicht" , "baeume" , "himmel"}) ,
    "Pflanzen!"
  );

  AddDetail( ({"pflanzen" , "gruenzeug" , "gewaechse" , "natur"}) ,
    "Humus ist das wichtigste Element fuer dieses Leben hier..."
  );
  
  AddDetail( ({"humus"}) ,
    "Wo?"
  );

  AddDetail( ({"element" , "staubschicht"}) ,
    "Nicht forschen, rennen!"
  );
  
  AddSmell( DEFAULT_SMELL ,
    "Wer haette es gedacht. Es riecht nach Tropen, Palmen und exotischen Pflanzen."
  );

  AddSound( DEFAULT_SOUND ,
    "Du hoerst das Rascheln der Pflanzen. Und nur die Pflanzen oder war da gerade etwas?"
  );
  
  AddExit("westen", ROOM "p26");
  AddExit("norden", ROOM "n23");
  AddExit("nordwesten", ROOM "p22");
  //AddExit("osten", ROOM "n23");
}