#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Testraum");
  SetProp(P_INT_LONG,
    "Ein echter Testraum! TEST IT! Taste the Feeling... YEAH! "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"test"}) ,
    "Setzen. 6."
  );

  AddDetail( ({"taste"}) ,
    "..coke!"
  );

  AddExit("raus",  "/players/gott/workroom");
}