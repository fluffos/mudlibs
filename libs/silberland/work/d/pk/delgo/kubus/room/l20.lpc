#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Windkanal - 2");
  SetProp(P_INT_LONG,
    "     \e[36mEin Windkanal\e[0m\n"
    "Du musst die Augen zusammenkneifen, da der Wind hier sehr stark weht. Was du erkennst "
    "ist nicht viel: Ein gemauerter Gang in dem scheinbar Tornados gezuechtet werden. "
    "Erst als du dich genauer umschaust bemerkst du was hier so seltsam ist: Der Kanal ist senkrecht. Du schwebst mitten im Raum, da dich der Wind auf dieser Hoehe haelt. Du spuerst ueber dir einen starken und bestaendigen Wind. Ob dich dieser Kanal wohl schneller bewegt? Du kannst dich aber auch nach Westen treiben lassen. Da ist ein Absatz..."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"untergrund" , "erde" , "boden"}) ,
    "Von Menschenhand gemauert."
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein"}) ,
    "Alles Mauern aus Steinbloecken."
  );

  AddDetail( ({"decke"}) ,
    "Gemauert."
  );
  
  AddDetail( ({"kanal"}) ,
    "Er wird dich sehr schnell sehr weit weg bringen..."
  );
  
  AddDetail( ({"absatz"}) ,
    "Scheint kein Windkanal zu sein."
  );
  
  AddDetail( ({"mauer", "menschenhand", "gang", "gaenge"}) ,
    "In solchen Gaengen warst du schon oft. Du kennst sie aus Burgen und Schloessern."
  );

  AddDetail( ({"wind" , "kraft", "tornados"}) ,
    "Du fragst dich wie der Wind wohl hier in diesen Gang gelenkt wird..."
  );
  
 // AddSmell( DEFAULT_SMELL ,
 //   "Es riecht hier ganz normal. Anstatt rumzuschueffeln solltest du die anderen suchen..."
 // );

  AddSound( DEFAULT_SOUND ,
    "Du hoerst nur das Heulen des Windes!"
  );
  
  AddExit("westen", ROOM "n19");
  AddExit("westoben", ROOM "l35");
  AddSpecialExit("kanal", "ww2");
}

int ww2 ()
{
	TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 4, PARALYZE_MSG: "", PARALYZE_MSG_OTHER: "", PARALYZE_END: "Du stehst wieder auf.", PARALYZE_END_OTHER: "%s rappelt sich auf."]));  
	write("Der Wind erfasst dich auf einmal und schleudert dich in den Gang...\n");
	call_out("a", 2);
	call_out("b", 4);
	call_out("c", 6);
	return 1;
}

int a ()
{
	write(" \n");
	write("Du fliegst mit einer atemberaubenden Geschwindigkeit den Gang entlang. Das wird ne harte Landung...");
	write(" \n");
	return 1;
}	

int b ()
{
	write(" \n");
	write("Du siehst die Kurve kaum, aber sehr wohl die Wand auf die du zurast..\n");
	write(" \n");
	return 1;
}	       
       
int c ()
{
       write(" \n");
       write("Der Aufprall wird nicht schoen... \n");
       write(" \n");
       this_player()->move(ROOM "l47", M_GO, "in den Kanal", "springt", "schlaegt auf");
       TP->do_damage(10+random(5));
}	       
       