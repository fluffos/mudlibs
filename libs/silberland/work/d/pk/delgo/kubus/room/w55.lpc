#include "../def.h"
#define SN 0

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Wasser - 4");
  SetProp(P_INT_LONG,
    "     \e[1m\e[34mEine Bucht\e[0m\n"
    "Du tauchst wieder auf und holst ersteinmal tief Luft. Nachdem du deinen Schreck ueberwunden hast "
    "schaust du dich um und siehst: Wasser! Ueberall Wasser! Weiter kannst du nicht sehen denn dafuer ist es zu dunkel in dieser Bucht (warum auch immer). Hier zu kaempfen ist nicht leicht. Du solltest schnell "
    "wegschwimmen. Du kannst nach Suedwesten und Westen schwimmen. Da kannst du schon Baeume erkenen... "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_WATER]) );

  AddDetail( ({"untergrund" , "erde" , "boden"}) ,
    "Tief unter dir."
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein" , "grotte"}) ,
    "Dafür ist es zu dunkel!"
  );

  AddDetail( ({"luft"}) ,
    "Fast haettest du sie gesehen!"
  );
  
  AddDetail( ({"schreck"}) ,
    "..lass nach!"
  );

  AddDetail( ({"wasser"}) ,
    "Sogar zwerge wissen was das ist."
  );
  
  AddSmell( DEFAULT_SMELL ,
    "Es riecht leicht verfault..."
  );

  AddSound( DEFAULT_SOUND ,
    "Du hoerst gleichmaessiges Plaetschern."
  );
 // SetProp(P_HIDE_EXITS, ({"raus"}) );
 // AddExit("raus", ROOM "testraum");
  
 //AddCmd(({"tauch", "tauche"}), "tauchen");
 AddCmd(({"schwimm", "schwimme"}), "schwimme");

}

int schwimme (string str)
{        
	 if(member(({"nach suedwesten"}), str) !=-1) 
	 {
	   this_player()->move(ROOM "w58", M_GO, "nach Suedwesten", "schwimmt",
                              "schwimmt herein");
	   return 1; 
	  }
	  if(member(({"nach westen"}), str) !=-1) 
	 {
	   this_player()->move(ROOM "p54", M_GO, "nach Westen", "schwimmt",
                              "schwimmt herein");
	   return 1; 
	  }
	 write("wohin?\n");
	 return 1;
}
