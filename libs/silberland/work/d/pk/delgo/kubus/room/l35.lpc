#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Windkanal - 3");
  SetProp(P_INT_LONG,
    "     \e[36mEin Windkanal\e[0m\n"
    "Du musst die Augen zusammenkneifen, da der Wind hier sehr stark weht. Was du erkennst "
    "ist nicht viel: Ein gemauerter Gang in dem scheinbar Tornados gezuechtet werden. "
    "Zurueck gehts nicht, gegen diese Gewalt kommst du nicht an. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"untergrund" , "erde" , "boden"}) ,
    "Von Menschenhand gemauert."
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein"}) ,
    "Alles Mauern aus Steinbloecken."
  );

  AddDetail( ({"decke"}) ,
    "Gemauert."
  );
   
  AddDetail( ({"mauer", "menschenhand", "gang", "gaenge"}) ,
    "In solchen Gaengen warst du schon oft. Du kennst sie aus Burgen und Schloessern."
  );

  AddDetail( ({"wind" , "kraft", "tornados"}) ,
    "Du fragst dich wie der Wind wohl hier in diesen Gang gelenkt wird..."
  );
  
 // AddSmell( DEFAULT_SMELL ,
 //   "Es riecht hier ganz normal. Anstatt rumzuschueffeln solltest du die anderen suchen..."
 // );

  AddSound( DEFAULT_SOUND ,
    "Du hoerst nur das Heulen des Windes!"
  );
  
  AddExit("suedosten", ROOM "l40");
  //AddExit("kanal", ROOM "ww1");
}