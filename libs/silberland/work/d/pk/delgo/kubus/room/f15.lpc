#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Feuerhoehle - 1");
  SetProp(P_INT_LONG,
    "     \e[31m\e[1mEine Feuerhoehle\e[0m\n"
    "RAUS! - Das ist dein erster Gedanke als du hier reinkommst. Du siehst Feuergysiere, Lavastroeme und Magmabrocken. "
    "Der Anblick dieser Gewalten ist teilweise so beeindruckend, dass du die Hitze fast vergisst. Aber eben nur fast. "
    "Wenn du nicht grade mit Feuer umgehen kannst solltest du schnell woanders hin. An der Felswand koenntest du nach oben klettern..."
  );

  SetProp(P_LIGHT, 2);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({"magmabrocken" , "erde" , "boden", "stein"}) ,
    "Magma. Erstarrte Lava."
  );

  AddDetail( ({"lava" , "lavastroeme", "bad", "feuergysiere"}) ,
    "Nein, du bist dir sicher heute kein Bad!"
  );

  AddDetail( ({"hitze"}) ,
    "Hab ich die nicht erwaehnt?"
  );
  
  AddDetail( ({"anblick", "gewalten" , "feuer"}) ,
    "Schon beeindruckend."
  );

  //AddDetail( ({"mal" , "staubschicht"}) ,
  //  "Lange her..."
  //);
  
  AddSmell( DEFAULT_SMELL ,
    "Verbrannte Erde und verkohlte Reste..."
  );
  AddSound( DEFAULT_SOUND ,
    "Die Lava blubbert..."
  );
  
  AddExit("osten", ROOM "n16");
  AddExit("nordosten", ROOM "f12");
  AddExit("oben", ROOM "f31");
}