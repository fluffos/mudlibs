#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ruine - 4");
  SetProp(P_INT_LONG,
    "     \e[1mEine alte Ruine\e[0m\n"
    "Du stehst auf festem Untergrund. Die (noch erhaltenen) Waende um dich herum "
    "bestehen aus Steinbloecken. Die Tatsache, dass sich auf dem Boden eine dicke "
    "Staubschicht befindet, zeigt dir wann jemand das letzte Mal hier war. Achja... das is noch ein Portal und ein Loch. Weiter ueber dir weht ein starker Wind. Wenn du nach oben springst koennte dich eine Boehe erfassen..."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_OTHER]) );

  AddDetail( ({"untergrund" , "erde" , "boden"}) ,
    "Festgetrampelte Erde."
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein"}) ,
    "Ganz normaler Stein. Hier ist alles normal!"
  );

  AddDetail( ({"tatsache"}) ,
    "Mach Sachen!"
  );
  
  AddDetail( ({"sachen"}) ,
    "Mach mal..."
  );

  AddDetail( ({"mal" , "staubschicht"}) ,
    "Lange her..."
  );
  
  AddDetail( ({"portal", "loch"}) ,
    "Wohin wird es fuehren?"
  );
  AddSmell( DEFAULT_SMELL ,
    "Es riecht hier ganz normal. Anstatt rumzuschueffeln solltest du die anderen suchen..."
  );

  AddSound( DEFAULT_SOUND ,
    "Du hoerst nur dich!"
  );
  
  AddExit("osten", ROOM "p50");
  AddExit("suedosten", ROOM "p54");
  AddExit("unten", ROOM "p33");
  AddSpecialExit("oben", "ww1");
  SetProp(P_EXIT_PREPOSITION,"durch das");
  AddExit("portal", ROOM "n13");
}

int ww1 ()
{
	write(" \n");
	write("Der Wind erfasst dich auf einmal und schleudert dich weit nach Osten...\n");
	write(" \n");
	this_player()->move(ROOM "n52", M_GO, "nach oben", "springt", "schlaegt auf");
	TP->do_damage(5+random(5));
	return 1;
}	