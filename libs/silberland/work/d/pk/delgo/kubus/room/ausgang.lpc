#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine kleine Hoehle...");
  SetProp(P_INT_LONG,
    "Ruhe! - Das ist das erste was dir auffaellt. Keine extremen Bedrohungen und lebensgefaehrliche Fallen. Du bist in einer kleinen Felshoehle die scheinbar keine Besonderheiten besitzt bis auf das Loch im Boden durch das schwach Licht hereindringt."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"ruhe"}) ,
    "Du atmest auf! Der Albtraum ist vorbei, deine Freunde jagen dich nichtmehr und du kannst dich ausruhen."
  );  
  
  AddDetail( ({"freunde"}) ,
    "Der Playerkill ist hier wieder verboten!"
  );
  
  AddDetail( ({"albtraum"}) ,
    "Als du nochmal an das Innere der Festung denken musst laeuft dir ein kalter Schauer ueber den Ruecken... "
  );
  
  AddDetail( ({"schauer", "ruecken"}) ,
    "Puh! Dein Ruecken ist noch da!"
  );
  
  AddDetail( ({"innere", "festung"}) ,
    "Noch immer hallen die Schreie der Verzweiflung durch deinen Kopf. Was fuer ein schrecklicher Ort."
  );
  
  AddDetail( ({"schreie", "verzweiflung"}) ,
    "All die gemarterten Seelen. Auch durch deine Haende mussten darin schon einige leiden. Doch gluecklicherweise ist dein Geist nun wieder klar."
  );
  
  AddDetail( ({"ort"}) ,
    "Du bist froh ihm entronnen zu sein!"
  );
  
  AddDetail( ({"seelen", "haende", "kopf"}) ,
    "Ja! genau Du bist gemeint!"
  );
  
  AddDetail( ({"geist"}) ,
    "Wirklich wieder voll bei Verstand?"
  );
  
 AddDetail( ({"verstand"}) ,
    "Ein kleiner Test wird das besser fesstellen!"
  );
  
  AddDetail( ({"test"}) ,
    "            _____\n"
    "           / ___ \\ \n"
    "          / /   \\ \\ \n"
    "          | | 0 | | \n"
    "          \\ \\___/ / \n"
    "           \\_____/ \n"
    " Los, triff die Mitte! :-)\n"
  );
  
   
  AddDetail( ({"bedrohungen", "fallen", "gedanken"}) ,
    "Du schuettelst dich bei dem Gedanken daran."
  );
  
  
  AddDetail( ({"felshoehle", "besonderheiten", "fels", "decke", "waende", "boden"}) ,
    "Eine sehr kleine stinknormale Felshoehle. Alles ist aus Fels."
  );
  
  AddDetail( ({"licht"}) ,
    "Soll ich dir das wirklich erklaeren?"
  );
  
  AddDetail( ({"loch"}) ,
    "Du schaust nach unten und erkennst die Eingangshalle! Deswegen hast du unten keine Decke erkannt. Sie liegt naemlich verdammt hoch..."
  );
  
  AddDetail( ({"eingangshalle"}) ,
    "Du befindest dich ueber ihr. (Saui wer hier schlechtes denkt :) )"
  );
  
  AddDetail( ({"saui"}) ,
    "Du weist schon was ich meine."
  );
  
   AddCmd( ({"triff"}), "test");
  
  AddExit("unten", ROOM "eingang"); 
}

int test (string str)
{
	notify_fail ("Was willst Du treffen?\n");   
        if (!str) {
                     return 0;
                  }   
        notify_fail ("Warum das?\n"); 
        if (str != "mitte") {   return 0; 
        	              }
        write ("Du hast keine Ahnung mit was du eigentlich grade auf irgendetwas geschossen hast, aber du hast getroffen. Gratuliere: Du bist nuechtern!\n");
        return 1;   
}	
	