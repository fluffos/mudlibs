#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eishoehle");
  SetProp(P_INT_LONG,
    "     Eine Eishoehle - EG\n"
    "*BBBRRRRRR* - Ist das kalt. Du stehst inmitten einer riesigen Eishoehle. Du musst aufpassen das du nicht ausrutschst, denn hier ist alles, ja wirklich alles aus Eis. "
    "Nur durch einige Eiszapfen und Formationen unterscheiden sich die einzelnen Abschnitte. "
    );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_ARCTIC]) );

  AddDetail( ({"untergrund" , "erde" , "boden", "decke"}) ,
    "Eis."
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein"}) ,
    "Nix da. Alles aus Eis."
  );

  AddDetail( ({"eis"}) ,
    "Schon mal an einen IQ  - Test gedacht?"
  );
  
  AddDetail( ({"iq"}) ,
    "Oh oh ..."
  );

  AddDetail( ({"test"}) ,
    "Setzen. 6."
  );
  
  AddDetail( ({"eiszapfen", "formationen"}) ,
    "Mit deiner Phantasie kannst du wunderbare Dinge sehen... *abschweif*"
  );
  
  AddDetail( ({"phantasie", "dinge"}) ,
    "Nichts?\n"
    "Komm schon, streng dich an!"
  );
  
  //AddSmell( DEFAULT_SMELL ,
    //"Es riecht hier ganz normal. Anstatt rumzuschueffeln solltest du die anderen suchen..."
  //);

  AddSound( DEFAULT_SOUND ,
    "Das Klirren des Eises ist zu hoeren..."
  );
  
  AddExit("raus", ROOM "testraum");
}