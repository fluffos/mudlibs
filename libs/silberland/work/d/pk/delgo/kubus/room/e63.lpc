#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eishoehle - 4");
  SetProp(P_INT_LONG,
    "     \e[35m\e[1mEine Eishoehle\e[0m\n"
    "*BBBRRRRRR* - Ist das kalt. Du stehst inmitten einer riesigen Eishoehle. Du musst aufpassen das du nicht ausrutschst, denn hier ist alles, ja wirklich alles aus Eis. "
    "Nur durch einige Eiszapfen und Formationen unterscheiden sich die einzelnen Abschnitte. Seltsam... nach Osten hin scheint das Eis abzunehmen. Fast haettest du das Gefaelle im Nordosten uebersehen... "
    );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -5, ENV_TERRAIN: TT_ARCTIC]) );

  AddDetail( ({"untergrund" , "erde" , "boden", "decke"}) ,
    "Eis."
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein"}) ,
    "Nix da. Alles aus Eis."
  );

  AddDetail( ({"eis"}) ,
    "Schon mal an einen IQ  - Test gedacht?"
  );
  
  AddDetail( ({"iq"}) ,
    "Oh oh ..."
  );

  AddDetail( ({"test"}) ,
    "Setzen. 6."
  );
  
  AddDetail( ({"eiszapfen", "formationen"}) ,
    "Mit deiner Phantasie kannst du wunderbare Dinge sehen... *abschweif*"
  );
  
  AddDetail( ({"phantasie", "dinge"}) ,
    "Nichts?\n"
    "Komm schon, streng dich an!"
  );
  
  AddDetail( ({"gefaelle"}) ,
    "Du beugst dich ein wenig nach vorne und schaust in den Abgrund. Du bist dir sicher: Noch ein Schritt nach Nordosten und du rutschst diese spiegelglatte Bahn runter. Wer weis wo die hinfuehrt..."
  );
  
  //AddSmell( DEFAULT_SMELL ,
    //"Es riecht hier ganz normal. Anstatt rumzuschueffeln solltest du die anderen suchen..."
  //);

  AddSound( DEFAULT_SOUND ,
    "Das Klirren des Eises ist zu hoeren..."
  );
  
  AddExit("osten", ROOM "n64");
  AddSpecialExit("nordosten", "eb2");
  //AddExit("unten", ROOM "e46");
}

int eb2 ()
{
	TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 4, PARALYZE_MSG: "", PARALYZE_MSG_OTHER: "", PARALYZE_END: "Du stehst wieder auf.", PARALYZE_END_OTHER: "%s rappelt sich auf."]));  
	write(" \n");
	write("Du hast es so gewollt! Du rutschst aus und gleitest schnell nach unten...\n");
	call_out("a", 2);
	call_out("b", 4);
	call_out("c", 6);
	return 1;
}

int a ()
{
	write(" \n");
	write("Du bist mittlerweile sehr schnell geworden und recht nervoes...");
	write(" \n");
	return 1;
}	

int b ()
{
	write(" \n");
	write("Du bist extrem schnell und dir laeuft der Schweiss von der Stirn. Ob das gut geht?\n");
	write(" \n");
	return 1;
}	       
       
int c ()
{
       write(" \n");
       write("Der Aufprall wird nicht schoen... \n");
       write(" \n");
       this_player()->move(ROOM "n51", M_GO, "runter", "faellt", "schlaegt auf");
       TP->do_damage(5+random(5));
       //TP->SetProp(P_PARALYZED);
}