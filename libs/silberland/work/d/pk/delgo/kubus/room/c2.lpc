#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Hoehle - 1");
  SetProp(P_INT_LONG,
    "     \e[33mEine Felshoehle\e[0m\n"
    "Viel kannst du ja nicht erkennen. Oh... Moment. Doch. Du siehst den Boden "
    ", Waende und die Decke. Alles aus Fels. Selsbt wenn noch irgendetwas hier waere, wuerdest du es nicht sehen, "
    "weil deine Lichtquelle nicht stark genug ist."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"untergrund" , "fels" , "boden"}) ,
    "Fels eben."
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein"}) ,
    "Koennt Stein sein, nein - ist nur Fels ;)."
  );

  AddDetail( ({"decke"}) ,
    "Schoen gemuetlich zum einkuscheln..."
  );
  
  AddDetail( ({"Lichtquelle"}) ,
    "Also wenn du keine hast und das hier lesen kannst ... CHEATER!"
  );

  AddDetail( ({"cheater", "sheriff"}) ,
    "Der Sheriff wurde soeben benachrichtigt!"
  );
  
  AddSmell( DEFAULT_SMELL ,
    "Dein Schweiss!"
  );

  AddSound( DEFAULT_SOUND ,
    "Du hoerst nur dich!"
  );
  
  AddExit("westen", ROOM "n1");
  AddExit("osten", ROOM "c3");
  AddExit("westoben", ROOM "c17");
}