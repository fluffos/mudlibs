#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ruine - 1");
  SetProp(P_INT_LONG,
    "     \e[1mEine alte Ruine\e[0m\n"
    "Du stehst auf festem Untergrund. Die (noch erhaltenen) Waende um dich herum "
    "bestehen aus Steinbloecken. Die Tatsache, dass sich auf dem Boden eine dicke "
    "Staubschicht befindet, zeigt dir wann jemand das letzte Mal hier war. Auffaellig ist nur das blaue Portal in der Mitte des Raumes und die Leiter."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_OTHER]) );

  AddDetail( ({"untergrund" , "erde" , "boden"}) ,
    "Festgetrampelte Erde."
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein"}) ,
    "Ganz normaler Stein. Hier ist alles normal!"
  );

  AddDetail( ({"tatsache"}) ,
    "Mach Sachen!"
  );
  
  AddDetail( ({"sachen"}) ,
    "Mach mal..."
  );

  AddDetail( ({"mal" , "staubschicht"}) ,
    "Lange her..."
  );
  
  AddDetail( ({"portal", "leiter"}) ,
    "Wie nutzt man das nur?"
  );
  AddSmell( DEFAULT_SMELL ,
    "Es riecht hier ganz normal. Anstatt rumzuschueffeln solltest du die anderen suchen..."
  );

  AddSound( DEFAULT_SOUND ,
    "Du hoerst nur dich!"
  );
  
  AddExit("norden", ROOM "f12");
  AddExit("westen", ROOM "f15");
  AddExit("oben", ROOM "n32");
  SetProp(P_EXIT_PREPOSITION,"durch das");
  AddExit("portal", ROOM "n4");
}

