int schwimme (string str)
{        
	 if(member(({"nach westen"}), str) !=-1) 
	 {
	   this_player()->move(ROOM "u5", M_GO, "nach Westen", "schwimmt", "schwimmt herein");
	   return 1; 
	  }
	 if(member(({"nach suedwesten"}), str) !=-1) 
	 {
	   this_player()->move(ROOM "u9", M_GO, "nach Suedwesten", "schwimmt", "schwimmt herein");
	   return 1; 
	  }
	 if(member(({"nach sueden"}), str) !=-1) 
	 {
	   this_player()->move(ROOM "u10", M_GO, "nach Sueden", "schwimmt", "schwimmt herein");
	   return 1; 
	  }
	 write("wohin?\n");
	 return 1;
	 
	 
}

