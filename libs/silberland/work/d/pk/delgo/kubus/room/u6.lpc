#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Unterwasser");
  SetProp(P_INT_LONG,
    "     \e[34mDu bist unterwasser...\e[0m \n"
    "Du tauchst irgendwo in einer Hoehle. Erkennen kannst du nur leider nichts. Aber ich bin mir sehr sicher du kannst nicht im Wasser atmen. Also hau lieber schnell ab! Wer weis was hier noch fuer Kreaturen herumschwimmen. Von deinen Jaegern mal ganz abgesehen.\n"
    "Auftauchen geht hier nicht. Du kannst nur nach westen, suedwesten sowie sueden schwimmen."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 8,
                           ENV_TERRAIN: TT_UNDERWATER,
                           ENV_WATER: 19 ]));

  AddDetail( ({"untergrund" , "erde" , "boden"}) ,
    "WO DENN?"
  );

  AddDetail( ({"waende" , "steinbloecke" , "stein"}) ,
    "Ich sehe was was du nicht siehst!"
  );

  AddDetail( ({"wasser"}) ,
    "Nein wirklich?"
  );
  
  AddDetail( ({"kreaturen" , "jaeger"}) ,
    "Kommen bald..."
  );

  AddDetail( ({"wasseroberflaeche", "hoehle"}) ,
    "Nur im Westen schimmert was.."
  );
  
  AddSmell( DEFAULT_SMELL ,
    "Wuerde ich dir nicht empfhelen..."
  );

  AddSound( DEFAULT_SOUND ,
    "*GURGEL,BLUBB*"
  );
  
  AddRoomMessage( 
    ({"Langsam geht dir die Luft aus. Und warm ist es auch nicht grade...\n"}),30,"warnung");
  
 // SetProp(P_HIDE_EXITS,({"raus"}));
 // AddExit("raus", ROOM "testraum");
  
 //AddCmd(({"tauch", "tauche"}), "tauchen");
 AddCmd(({"schwimm", "schwimme"}), "schwimme");
 
 //call_out("warnung", 15);
 //call_out("warnung2", 35);
 //call_out("ertrinken", 60);
 
}

int warnung () {
	write("Dir wird langsam aber sicher bewusst das du kein Wasser atmen kannst!\n");
        TP->do_damage(15+random(10));
        return 1;
}
