int pforte (string str)
{
	notify_fail ("Was willst Du beruehren?\n");   
        if (!str) {
                     return 0;
                  }   
        notify_fail ("Warum das?\n"); 
        if (str != "flaeche") {
        	               return 0; 
        	              }
        write ("Du beruehrst die Flaeche mit dem Finger und ziehst deine Hand erschrocken zurueck als der Waechter dich anknurrt. Auf der Flaeche haben sich Wellen gebildet. Als waere die Flaeche aus Wasser!\n");
        return 1;   
}	

int schatten (string str)
{
	notify_fail ("Was willst Du erfuehlen? Das Schattensymbol?\n");   
        if (!str) {
                     return 0;
                  }   
        notify_fail ("Meinst du das Schattensymbol?\n"); 
        if (str != "schattensymbol") {
        	               return 0; 
        	              }
        write ("Du ertastest eine Sonne die von ein paar senkrechten Wellenlinien verdeckt wird...\n");
        return 1;   
}	