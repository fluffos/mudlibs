#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Pforte...");
  SetProp(P_INT_LONG,
    "Du bist geplaettet! Was du siehst ist einfach nur beeindruckend und zugleich Zeugniss von zwergischer Baukunst und Magie."
    " Durch Fackeln an den Waenden ist die gigantische Halle bis ins kleinste ausgeleuchtet und du erkennst nahezu jedes kleine Detail."
    " Die Halle ist ca. 25 Meter lang und die Waende zu deiner linken und rechten werden regelmaessig durch Vorspruenge unterbrochen."
    " Alles ist mit kunstvollen Bildern, Fresken und Glasmalereien verziert. Nur am Ende hinter dem Waechter werden die Zeichnungen durch eine kreisrunde und pechschwarze Flaeche unterbrochen."
    "Ansonsten faellt dir noch das kleine Podest mitten im Raum auf..."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"zeugniss"}) ,
    "Diese Halle wurde aus dem Fels herausgehaun und dann weiter ausgebaut. Das koennen nur Zwerge gewesen sein!"
  );
  
  AddDetail( ({"halle", "raum", "eingang", "felshoehle", "hoehle"}) ,
    "Die Halle hat keinen rechten Eingang, auf einmal hoert die Felshoehle auf und du stehst auf dem ebenem Boden. Wenn du 2 Schritte zurueck gehst stehst du wieder in einer normalen Felshoehle."
  );

  AddDetail( ({"schritte"}) ,
    "...1...2... fein gemacht!"
  );
 
  AddDetail( ({"fels"}) ,
    "Das war frueher alles grober Fels. Doch die Zwerge haben alles fein bearbeitet."
  );
    
  AddDetail( ({"zwerge"}) ,
    "Wenn sie dies Pracht alleine errichtet haben sind sie wahrlich wuerdig die Goetterrasse zu sein!"
  );
  
  AddDetail( ({"pracht"}) ,
    "Bist du etwa nicht beeindruckt?\n"
    "Du bist erstaunt.\n"
    "Na also!\n"
  );
  
  AddDetail( ({"goetterrasse"}) ,
    "Finger Woody, finger Dusty - Was stellen wir fest?"
  );
  
  AddDetail( ({"baukunst"}) ,
    "Die zwerge sind beruehmt fuer ihre Fertigkeit im Graben, Bauen und Verzieren. Du schaust dir die Halle noch einmal genauer an und bist dir sicher: Hier muss es sich um eine zwergische Festung handeln."
  );
  
  AddDetail( ({"fertigkeit", "bauten"}) ,
    "Viele ihrer Bauten sind beruehmt."
  );
  
  AddDetail( ({"festung"}) ,
    "Du bist ausserhalb. Ob diese schwarze Flaeche wohl die Pforte bildet?"
  );
  
  AddDetail( ({"flaeche"}) ,
    "Du gehst etwas naeher ran und stellst fest das diese Flaeche so glatt ist das du dich darin spiegeln kannst. Du koenntest sie ja mal beruehren..."
  );
  
  AddCmd( ({"beruehre"}), "pforte");
  
  AddDetail( ({"finger", "hand"}) ,
    "Ist das nicht im Inventar?"
  );
  
  AddDetail( ({"inventar"}) ,
    "Erreichst du mit dem Buchstaben 'i'."
  );
  
  AddDetail( ({"buchstaben"}) ,
    "<ohne Worte>"
  );
   
  AddDetail( ({"wasser", "wellen"}) ,
    "Scheint sich um ein echtes Spiegelportal zu handeln. Ein Hoehepunkt der Magie!"
  );
   
  AddDetail( ({"hohepunkt"}) ,
    "420m NN."
  );
   
  AddDetail( ({"magie", "geoden"}) ,
    "Man sollte die Geoden nie unterschaetzen!"
  );
  
  AddDetail( ({"spiegelportal", "pforte"}) ,
    "Der Waechter wird dich wohl nicht ohne weiteres durchlassen..."
  );
   
  AddDetail( ({"fackeln"}) ,
    "Da ist eine! Dort noch eine - wow! Jetzt sind es schon 2. Das hoert ja gar nicht mehr auf!"
  );
  
  AddDetail( ({"waende", "waenden", "fresken"}) ,
    "Wunderschoen wurden dutzende von Motiven aus dem Fels herausgehaun."
  );
  
  AddDetail( ({"motiven", "motive"}) ,
    "Du siehst verschieden Szenen. Alle scheinen kaempfende Zwerge zu zeigen. Sie kaempfen manchmal auch gegen andere Rassen..."
  );
   
  AddDetail( ({"szenen"}) ,
    "Die Zwerge wehren sich ohne Probleme gegen Eindringlinge die in ihre Festung wollen."
  );
   
  AddDetail( ({"probleme"}) ,
    "Mit den normalen Eindringlingen gab es keine."
  );
  
  AddDetail( ({"rassen", "eindringlinge"}) ,
    "Mhhh... groesstenteils normale. Aber es sind auch einige Untote abgebildet..."
  );
  
  AddDetail( ({"untote"}) ,
    "Du findest jetzt immer mehr Szenen die den Kampf der Zwerge gegen Heerscharen von Untoten abbilden. Bei Woody - Anscheinend wurde diese Festung extra gegen diese Bedrohung errichtet."
  );
        
  AddDetail( ({"kampf"}) ,
    "Irgendwas sagt dir das du in dieser Festung kaempfen musst. Wenn du nur wuesstes wie du rein kommst. *gruebel*"
  );
   
  AddDetail( ({"heerscharen", "untoten", "bedrohung"}) ,
    "Schau dich mal weiter genau um. Eventuell findest du mehr Informationen dazu."
  );
  
  AddDetail( ({"informationen"}) ,
    "Nein, hier nicht :)"
  );
   
  AddDetail( ({"detail"}) ,
    "Das war eines. Gut erkannt!"
