// Schwierigkeitsgrad bzw. -bonus
// room_no - difficulty - (old difficulty)
//       1 - 0.4        - 0.0
//      10 - 0.5        - 2.3
//     100 - 0.8        - 4.7
//     500 - 7.2        - 6.3
//    1000 - 14.0       - 7.0
varargs float difficulty(int room_no, mixed max, mixed k)
{
    if(room_no <= 0) room_no = 1;
    if(!floatp(max)) max = (float) max;
    if(!max || (floatp(max) && max == 0.0)) max = 14.428;
    if(!floatp(k)) k = (float) k;
    if(!k || (floatp(k) && k == 0.0)) k = 0.007;

    //return DC_A + DC_B * log(to_float(no)); // old difficulty (0-7)

    return (max/(1+exp((float) -(k*(room_no-500))))); // new difficulty
}

// Schwierigkeitsgrad als int
varargs int difficulty_int(int room_no, mixed max, mixed k)
{
    return (int) difficulty(room_no, max, k);
}

// MoreThanOnePresent
// gibt 0 zurueck wenn id_to_test hoechstens 1 Mal im deep_inv der Umgebung von ob auffindbar ist, sonst 1
int MoreThanOnePresent(object ob, string id_to_test)
{
    object *inv;
    int i, no_of_strings;

    if(!ENV(ob)) return -1;
    inv=deep_inventory(ENV(ob));
    no_of_strings = 0;

    for(i=0;i<sizeof(inv);i++)
        if( inv[i]->id(id_to_test))
        {
            if(no_of_strings == 0) no_of_strings = 1;
            else return 1;
        }
    return 0;
}

// Count
// zaehlt die id_to_test im deep_inv von ob
int Count(object ob, string id_to_test)
{
    object *inv;
    int i, no_of_strings;

    if(!ob) return -1;
    inv=deep_inventory(ob);
    no_of_strings = 0;

    for(i=0;i<sizeof(inv);i++)
        if( inv[i]->id(id_to_test))
            no_of_strings++;
    return no_of_strings;
}