// Schattenwelt
// von Wraz / Mendralim
// Poseys abgetrennter Kopf

#include "../def.h"

inherit "/std/thing";

int _decay = 6;
string _adverb = " abgetrennte";
string _name = "von Posey Olivenwein";

void create () 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der"+_adverb+" Kopf "+_name);
  SetProp(P_LONG,
    "Das ist der Kopf von Posey Olivenwein. Jemand hat ihn von ihrer Leiche abgeschnitten, "
    "grauenhaft.");

  SetProp(P_INFO, BS(""));
  SetProp(P_NAME, "Kopf von Posey Olivenwein");
  SetProp(P_GENDER, MALE);
  AddId( ({"kopf","kopf von posey olivenwein","poseykopf","\nposey_head"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_DEAD:100]) );
  SetProp(P_WEIGHT, 4750);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 0);

  call_out("do_decay", 60*30);
}

void reset()
{
  ::reset();
}

// kopiert & adaptiert von /std/corpse.c
void do_decay()
{
  _decay -= 1;
  if (_decay > 0) 
  {
    switch(_decay)
    {
      case 5: SetProp(P_SHORT,"Der leicht stinkende"+_adverb+" Kopf "+_name);
              if(random(2)) environment(ME)->Message(BS(
                "Der Kopf "+_name+" faengt langsam an zu stinken."));
              break;
      case 4: SetProp(P_SHORT,"Der bereits ziemlich stinkende"+_adverb+" Kopf "+_name);
              if(random(2)) environment(ME)->Message(BS(
                "Der stinkende Kopf "+_name+" faengt langsam an zu verschimmeln."));
              break;
      case 3: SetProp(P_SHORT,"Der leicht schimmelnde"+_adverb+" Kopf "+_name);
              if(random(2)) environment(ME)->Message(BS(
                "Der schimmelige Kopf "+_name+" schimmelt stark weiter."));
              break;
      case 2: SetProp(P_SHORT,"Der halbverweste und schimmelnde Kopf "+_name);
              if(random(2)) environment(ME)->Message(BS(
                "Der verschimmelte Kopf "+_name+" faengt an zu verwesen!"));
              if ( QueryProp( P_HEAL ) >= -5 )
                SetProp( P_HEAL, -5 );
              break;
      case 1: SetProp(P_SHORT,"Der verfaulten Einzelteile "+_name);
              environment(ME)->Message(BS(
                "Der halbverweste Kopf "+_name+" faengt an zu verfaulen! IGITT!!!"));
              SetProp( P_HEAL, -10 );
              break;
	    }
    call_out("do_decay", 60*30);
    return;
  }
  environment(ME)->Message(BS(
    "Der verfaulte Kopf "+_name+" zerfaellt zu Staub."));
  ME->remove();
}