// Schatten Todesmarke
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Schattenmarke");
  SetProp(P_LONG, "Die Schattenmarke klebt seit Deinem Tod in den Schatten an Dir.");
  SetProp(P_NAME, "Schattenmarke");
  SetProp(P_GENDER, FEMALE);

  AddId( ({"schattenmarke","\nshadow_deathmark"}) );

  SetProp(P_INFO, BS("Mit dieser Schattenmarke kannst Du eine begrenzte Zeit lang "
  "in die Schatten zurueckkehren und dort Deine koerperliche Gestalt wiedererlangen. "
  "Wie genau, musst Du selbst herausfinden. Willst Du allerdings "
  "in der materiellen Welt verweilen und den Schlachtfeldpfad betreten, so "
  "solltest Du zuerst die Schattenmarke mittels <entmarke> entfernen."));

  SetProp(P_MATERIAL, MAT_SHADOW);
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  //SetProp(P_NOGET, 1);

  AddCmd( ({"entmarke"}), "cmd_entmarken");
}

int cmd_entmarken(string str)
{
  object ob;

  if(!interactive(TP)) return 0;
  if(!ENV(TO)) return 0;

  if(TP != ENV(TO))
   return 0;

  TP->Message(BS("Die Schattenmarke loest sich auf."));
  TO->remove(1);
  return 1;
}

void reset() 
{
  ::reset();

  if (!is_clone(TO)) return;

  if(QueryProp(P_CLONE_TIME) < time() - 60*60*24*7) 
  {
    if(interactive(ENV(TO))) 
      ENV(TO)->Message(BS("Die Schattenmarke loest sich auf."));
    remove(1);
  }
}