// Schattenpacktaschen
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"

inherit "/std/thing";
inherit ZONE "std/std.lpc";

#include "/p/daemon/itemd/itemd.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddId( ({"schattenpacktaschen", "packtaschen", "taschen",
    "schattenpacktasche", "packtasche", "tasche"}));
  SetProp(P_PLURAL,1);
  SetProp(P_SHORT,"Schattenpacktaschen");
  SetProp(P_LONG,
   "Die Schattenpacktaschen bestehen aus farblosem Leder. Sie scheinen fuer ein "
   "Lastentier geeignet zu sein.");
  SetProp(P_NAME, "Schattenpacktaschen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 1700);  
  SetProp(P_VALUE, 2000); 
  SetProp(P_MATERIAL, ([ MAT_LEATHER:99, MAT_SHADOW:1 ]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  seteuid(getuid(TO));
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);

  AddCmd("lege", "CmdAnlegen");
}

// ------------------------------------------------------------------------------
int CmdAnlegen(string str)
{
  string first;
  string second;
  object gaul;

  if(!interactive(TP)) return 0;
  if(!ENV(TO) || !ENV(ENV(TO))) return 0;

  if(TP != ENV(TO))
  {
   return -1;
  }

  else if(!str || sscanf(str, "%s %s an", first, second) != 2)
  {
    //write(BS("Wem moechtest Du die Schattenpacktaschen anlegen?"));
    return 0;
  }

  else if(!gaul = present(first,ENV(ENV(TO))))
  {
    write(BS("Hier ist doch gar kein*e '"+first+"'!"));
    return -1;
  }

  else if(!gaul->id("\nlastentier"))
  {
    write(BS(gaul->Name(WEM)+" kannst Du die Schattenpacktaschen nicht anlegen."));
    return -1;
  }

  else if(!TO->id(second))
  {
    write(BS("Was moechtest Du "+gaul->name(WEM)+" anlegen?"));
    return -1;
  }

  else if(!gaul->QueryProp(P_REJECT))
  {
    write(BS(gaul->Name(WER)+" braucht keine weiteren Schattenpacktaschen."));
    return -1;
  }

  else
  {
    write(BS("Du legst "+gaul->name(WEM)+" die Schattenpacktaschen an."));
    ENV(TP)->Message(BS(TPN+" legt "+gaul->name(WEM)+" Schattenpacktaschen an."),
      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    TO->move(gaul,M_NOCHECK);
    TO->SetProp(P_NODROP, 1);
    gaul->SetProp("reject_saved",gaul->QueryProp(P_REJECT));
    gaul->SetProp(P_REJECT, 0);
    return 1;
  }

}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;

  // Lastentier weg
  if (TO && ENV(TO) && !ENV(TO)->id("\nlastentier"))
    if(TO->QueryProp(P_NODROP)) TO->SetProp(P_NODROP, 0);
}