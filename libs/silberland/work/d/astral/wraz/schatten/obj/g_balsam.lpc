// Balsam zur Itemgewicht-Reduktion
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Balsam des Federgewichts");
  SetProp(P_LONG,
    "Paradoxerweise ist dieser, in einer etwa muenzgrossen Ledertube gefuellte Balsam "
    "unerwartet schwer. Ob so die Magie funktioniert? Du weisst es nicht.");

  SetProp(P_INFO, BS("Der Balsam des Federgewichts scheint schwer wie Blei. "
    "Es ist Dir wirklich ein Raetsel. Wie kann das sein? Ob der Name taeuscht "
    "und am Ende der eingeschmierte Gegenstand noch schwerer wird? Es gibt wohl nur "
    "einen Weg, das herauszufinden."));
  SetProp(P_NAME, "Balsam des Federgewichts");
  SetProp(P_GENDER, MALE);
  AddId( ({"federgewichtsbalsam","balsam"}) );

  SetProp(P_MATERIAL, ([MAT_FAT:20,MAT_ALCOHOL:2,MAT_WATER:17,
    MAT_FEATHER:41, MAT_SHADOW:1, MAT_LEATHER:19]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_SIZE, 3);
  SetProp(P_VALUE, 9000);
  SetProp (P_MAGIC, 1);

  AddCmd( ({"schmier","schmiere"}), "cmd_einschmieren");
}

int cmd_einschmieren(string str)
{
  string target;
  string balm;
  object ob;

  if(!interactive(TP)) return 0;
  if(!ENV(TO)) return 0;

  if(TP != ENV(TO))
  {
    TP->Message(BS("Du musst den Balsam schon in die Hand "
   "nehmen."));
   return -1;
  }

  if(!str || sscanf(str, "%s mit %s ein", target, balm) != 2)
  {
    write(BS("Was moechtest Du womit einschmieren?"));
    return -1;
  }

  if(!ob = present(target,TP))
  {
    TP->Message(BS("Du hast doch gar kein(e) '"+capitalize(target)+"'!"));
   return -1;
  }

  if(balm != "federgewichtsbalsam" && balm != "balsam")
  {
    write(BS("Womit moechtest Du das einschmieren?"));
    return -1;
  }

  if(ob->QueryProp("federgewichtsbalsam") >= 10)
  {
    write(BS("Auf "+ob->name(WEN,1)+" wuerde der Federgewichtsbalsam nicht wirken."));
    return -1;
  }

  else
  {
    TP->Message(BS("Du schmierst "+ob->name(WEN,1)+" mit dem Federgewichtsbalsam ein. "
    "Er laesst sich erstaunlich schwierig verteilen."));
    ENV(TP)->Message(BS(
     TPN+" schmiert "+ob->name(WEN,1)+" mit einem zaehen Balsam ein."),
     MSGFLAG_NO_TP);
    ob->SetProp("federgewichtsbalsam", ob->QueryProp("federgewichtsbalsam") + 1);
    ob->SetProp(P_WEIGHT, to_int(ob->QueryProp(P_WEIGHT) * 0.9) );

    TO->remove(1);
    return 1;
  }

}
