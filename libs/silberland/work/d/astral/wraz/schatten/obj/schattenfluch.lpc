// Schattenfluch fuer Entfluchung
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schattenfluch");
  SetProp(P_LONG,
    "Wie eine seltsame, substanzlose 'Masse' aendert der Schattenfluch staendig "
    "seine 'Form': Einmal sieht er aus wie eine Axt, dann wie Stiefel, dann wie "
    "eine Peitsche... er wechselt in fast jede erdenkliche Ruestungs- und "
    "Waffenform. ");

  SetProp(P_INFO, BS("Mit Deinem Scharfsinn schliesst Du, dass der Schattenfluch "
  "wohl Flueche entfernen kann. Er ist aber nicht besonders lange haltbar. Und wie "
  "genau Du ihn verwendest, ist dir ein Raetsel. Irgendwas mit 'a'..."));
  SetProp(P_NAME, "Schattenfluch");
  SetProp(P_GENDER, MALE);
  AddId( ({"schattenfluch","fluch"}) );

  SetProp(P_MATERIAL, ([MAT_MISC: 50, MAT_SHADOW:50]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOSELL, "Den Schattenfluch zu verkaufen erscheint Dir irgendwie eine sehr "
    "seltsame Idee, daher laesst Du es.");
  SetProp(P_MAGIC, 1);

  AddCmd( ({"appliziere"}), "cmd_appliziere");
}

int cmd_appliziere(string str)
{
  object ob;
  string s1, s2;

  if(!TP || !interactive(TP)) return 0;
  if(!ENV(TO)) return 0;
  notify_fail("Appliziere den Schattenfluch worauf?\n");
  if(!str) return 0;
  if (sscanf(str, "%s auf %s", s1, s2) != 2) return 0;
  if (!id(s1)) return notify_fail("Das kannst Du nicht applizieren.\n"),0;
  if(TP != ENV(TO)) return notify_fail("Du musst den Schattenfluch bei Dir tragen.\n"),0;
  if(!ob = present(s2,TP))
    return notify_fail("Du hast doch gar kein(e) '"+capitalize(str)+"'!\n"),0;
  if(!ob->QueryProp(P_CURSED))
    return notify_fail("Auf "+ob->name(WEN,1)+" haette der Schattenfluch keine Auswirkung.\n"),0;
  if (strstr(file_name(ENV(TP)), ROOM) == -1)
  {
    TP->Message(BS("In dieser all zu materiellen Welt versagt der Schattenfluch "
    "und verschwindet."));
    TO->remove();
    return -1;
  }
  else
  {
    TP->Message(BS("Du applizierst den Schattenfluch auf "+ob->name(WEN,1)+". "
    +capitalize(ob->QueryPronoun())+" verschmilzt mit dem Schattenfluch, und... "
    "dann passiert nichts mehr."));
    ENV(TP)->Message(BS(
     TPN+" appliziert einen Schattenfluch auf "+ob->name(WEN,0)+". "
    +ob->QueryPronoun()+" verschmilzt damit."), MSGFLAG_NO_TP);
    ob->SetProp(P_CURSED, 0);

    TO->remove(1);
    return 1;
  }

}

// ------------------------------------------------------------------------------
// Reset
void reset()
{
  ::reset();
  if(!is_clone(TO)) return;
  
  // Schaffenfluch loest sich nach ca. 1 Tag auf
  if(time() - QueryProp(P_CLONE_TIME) > 86400 * (90+random(21))/100)
  {
    if(ENV(TO)) ENV(TO)->Message(BS(Name(WER,1)+" loest sich einfach auf."));
    TO->remove();
  }
}