// Schatten Attached Tentacle (Gedankenschinder)
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";
inherit ZONE "std/std.lpc";

object pl, npc;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "");

  AddId( ({"\nshadow_attached_tentacle"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);

  // fuer testzwecke random(20); real dann hoeher setzen (200?)
  if(find_call_out("RemoveTentacle") == -1) call_out("RemoveTentacle", 10+random(20));
}

string extra_look()
{
  if(pl && pl->QueryProp(P_NOMOVE))
   return BS("Ein Tentakel klebt fest an "+TP->QueryPossPronoun(1,2)+" Kopf!");
  else return 0;
}

void Setup(object _pl, object _npc)
{
  pl = _pl;
  npc = _npc;

  if(!pl || !living(pl)|| !npc || !living(npc)) 
  {
    TO->remove();
    return;
  }
  pl->SetProp(P_NOMOVE, npc->Name(WER, 1)+" haelt Dich mit dem Tentakel fest!\n");
}

void RemoveTentacle()
{
  if(TO && pl && pl->QueryProp(P_NOMOVE))
  {
    pl->Message(BS("Der Tentakel laesst von Dir ab."));
    ENV(pl)->Message(BS("Der Tentakel laesst von "+pl->name(WER)+" ab."),
      MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({pl})]));
    pl->SetProp(P_NOMOVE,0);
    TO->remove();
  }
  else if(TO) TO->remove();
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(pl && (pl == player) && pl->QueryProp(P_NOMOVE))
  {
    pl->SetProp(P_NOMOVE,0);
    TO->remove();
  }
}

int remove()
{
  SetProp(P_X_ATTR_MOD, 0);
  if(pl) pl->UpdateAttributes();
  if(pl && pl->QueryProp(P_NOMOVE))
  {
    pl->SetProp(P_NOMOVE,0);
  }
  destruct(TO);
  return 1;
}

void reset() 
{
  ::reset();
  if (!is_clone(TO)) return;
  if(!TO || !pl) remove();
  else if(!pl->QueryProp(P_NOMOVE) && QueryProp(P_CLONE_TIME) < time() - 60*60) remove();
}