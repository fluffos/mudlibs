// Brandisborgels verbliebenes Auge
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Brandisborgels verbliebenes Auge");
  SetProp(P_LONG,
    "Das ist des Daemons Brandisborgels verbliebenes Auge. Es blickt Dich unangenehm "
    "lebendig an. Die Qualen, die der Daemon in alten Zeiten durchgemacht hat, sind "
    "deutlich zu fuehlen.");

  SetProp(P_INFO, BS("Das Auge Brandisborgels hat aussergewoehnliche, magische "
  "Faehigkeiten. Es kann fuer Dich sehen, indem Du durch das Auge blickst, oder "
  "durch das Auge auf eine zu untersuchende Sache blickst."));
  SetProp(P_NAME, "Brandisborgels Auge");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"auge","\nbrandisborgelauge"}) );
  AddAdjective( ({"verblieben","verbliebenes"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_DEAD:100]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 6);
  SetProp(P_VALUE, 12000);
  SetProp(P_MAGIC, 1);

  AddCmd( ({"blicke","blick"}), "cmd_blicken");
}

int cmd_blicken(string str)
{
  string target;
  string balm;
  object ob;

  if(!interactive(TP)) return 0;
  if(!ENV(TO)) return 0;
  if(!str) return 0;

  if(TP != ENV(TO))
  {
    TP->Message(BS("Du musst das Auge schon in die Hand "
   "nehmen."));
   return -1;
  }

  if(str == "durch auge" || str == "durch aug")
  {
    write(BS("Brandisborgels Auge erblickt:"));
    write(ENV(TP)->QueryProp(P_INT_LONG));
    write(ENV(TP)->GetExits(TP));
    return 1;
  }

  if(sscanf(str, "durch auge auf %s", target) == 1 ||
     sscanf(str, "durch aug auf %s", target) == 1 )
  {
    if(!ENV(TP)->GetDetail(target))
    {
      write(BS("Brandisborgels Auge sieht hier kein(e) '"+target+"'."));
      return 1;
    }
    write(BS("Brandisborgels Auge erblickt:"));
    write(ENV(TP)->GetDetail(target));
    return 1;
  }

  return 0;

}
