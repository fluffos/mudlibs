// Schatten Dunkelzauber (zB Schreiter)
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "");

  AddId( ({"\nshadow_darkness"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);

  set_light(-1);
}

void reset() 
{
  ::reset();
  if(QueryProp(P_CLONE_TIME) < time() - 60*60) remove(1);
}

void init() // INIT ------------------------------------------------------------------------
{
  ::init();

  if(TO && (!ENV(TO) || !living(ENV(TO)))) remove(1);
}