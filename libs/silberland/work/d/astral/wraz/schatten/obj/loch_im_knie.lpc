// Schatten Loch im Knie (Chaosfraggle)
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";
inherit ZONE "std/std.lpc";

object pl;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "");

  AddId( ({"\nshadow_loch_im_knie"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);

  if(find_call_out("RemoveLoch") == -1) call_out("RemoveLoch", 10+random(200));
}

string extra_look()
{
  if(pl && pl->QueryProp(P_NOMOVE))
   return BS(capitalize(TP->QueryPronoun()) + " hat ein uebles Loch im Knie! Ob das ein Fraggle war?");
  else return 0;
}

void Setup(object _pl)
{
  pl = _pl;
}

void RemoveLoch()
{
  if(TO && pl && Count(pl,"\nshadow_loch_im_knie") >= 2) 
  {
    TO->remove(1);
    return;
  }

  else if(TO && pl && pl->QueryProp(P_NOMOVE))
  {
    pl->Message(BS("Das Loch in Deinem Knie ist soweit verheilt, dass Du Dich "
     "wieder fortbewegen kannst."));
    pl->SetProp(P_NOMOVE,0);
    TO->remove(1);
  }
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(pl && (pl == player) && pl->QueryProp(P_NOMOVE))
  {
    pl->SetProp(P_NOMOVE,0);
    TO->remove(1);
  }
}

int remove()
{
  if(pl && pl->QueryProp(P_NOMOVE))
  {
    pl->SetProp(P_NOMOVE,0);
  }
  destruct(TO);
  return 1;
}

void reset() 
{
  ::reset();
  if (!is_clone(TO)) return;
  if(!TO || !pl) remove(1);
  else if(!pl->QueryProp(P_NOMOVE) && QueryProp(P_CLONE_TIME) < time() - 60*60) remove(1);
}