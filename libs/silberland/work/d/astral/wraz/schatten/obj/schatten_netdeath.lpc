// Schatten Netztotenmarke
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "");

  AddId( ({"\nshadow_netdeath"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_AUTOLOADOBJ, 1);
}

void BecomesNetAlive(object player)
{
  if(!ENV(player) || strstr(file_name(ENV(player)),ROOM) == -1)
  {
    TP->Message(BS(
      "Die Schatten begruessen Dich an diesem Ort und geleiten Dich sogleich zurueck "
      "in deren Welt."));
    call_other(ROOM "sn000","???");
    player->move(ROOM "sn000",M_GO,"in eine schattenhafte Welt",
      "entschwindet","betritt wie aus dem Nichts diese Welt");
  } 
  TO->remove();
}