// Testmaterial
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"
#include <thing/material.h>

inherit "std/thing";

string *all_mat;
string mat1, mat1_name, mat1_name_nospace;
string mat2, mat2_name, mat2_name_nospace;

void create()
{
  int i;

  if (!is_clone(TO)) return;

  ::create();



  all_mat = ({MAT_MISC_SOLID, MAT_LEATHER, MAT_GLASS, MAT_CERAMIC, MAT_ICE, MAT_SNOW, MAT_PHOSPHORUS, 
  MAT_SALPETER, MAT_CARBON, MAT_PEARL, MAT_WAX, MAT_TAR, MAT_CHALK, MAT_SHIT, MAT_FAT, MAT_PLASTIC, 
  MAT_PAPER, MAT_CARTON, MAT_PERGAMENT, MAT_PAPYRUS, MAT_CLOTH, MAT_SILK, MAT_VELVET, MAT_COTTON, 
  MAT_FELT, MAT_BAUSCH, MAT_SATIN, MAT_EARTH, MAT_SAND, MAT_DUST, MAT_PLUTONIUM, MAT_MISC_WOOD, 
  MAT_MISC_DECIDUOUS_WOOD, MAT_MISC_CONIFER_WOOD, MAT_MISC_TROPICAL_WOOD, MAT_PEAR_WOOD, MAT_OAK, 
  MAT_BEECH, MAT_EBONY, MAT_FIR, MAT_TEAK, MAT_CORK, MAT_BALSA, MAT_ELM_WOOD, MAT_YEW_WOOD, MAT_ASH_WOOD, 
  MAT_TICTOC_WOOD, MAT_BIRCH_WOOD, MAT_MAHAGHONI_WOOD, MAT_CHERRY_WOOD, MAT_MISC_STONE, MAT_GRANITE, 
  MAT_SLATE, MAT_MARBLE, MAT_CONCRETE, MAT_ASPHALT, MAT_LIME, MAT_MISC_METAL, MAT_IRON, MAT_STEEL, 
  MAT_COPPER, MAT_BRONCE, MAT_BRASS, MAT_TIN, MAT_LEAD, MAT_TITANIUM, MAT_MERCURY, MAT_ALUMINIUM, 
  MAT_TUNGSTEN, MAT_COBALT, MAT_IRIDIUM, MAT_CHROMIUM, MAT_NICKEL, MAT_MAGNESIUM, MAT_SILVER, 
  MAT_GOLD, MAT_PLATINUM, MAT_MITHRIL, MAT_ADAMANT, MAT_MISC_FLUID, MAT_WATER, MAT_MILK, MAT_ALCOHOL, 
  MAT_OIL, MAT_BLOOD, MAT_PARFUM, MAT_INK, MAT_SLIME, MAT_MISC_ACID, MAT_MISC_GAS, MAT_AIR, MAT_METHANE, 
  MAT_HELIUM, MAT_LAUGHING_GAS, MAT_MISC_JEWEL, MAT_OCTARINE, MAT_DIAMOND, MAT_RUBY, MAT_SAPPHIRE, 
  MAT_AQUAMARINE, MAT_EMERALD, MAT_JADE, MAT_QUARTZ, MAT_AMETHYST, MAT_TOPAZ, MAT_AMBER, MAT_OPAL, 
  MAT_GARNET, MAT_ROCKCRYSTAL, MAT_LAPISLAZULI, MAT_TURMALIN, MAT_ONYX, MAT_MISC_MINERAL, MAT_AGATE, 
  MAT_SULFUR, MAT_LAZURITE, MAT_CRYSTAL, MAT_OBSIDIAN, MAT_ASBESTOS, MAT_MISC_HERBAL, MAT_MISC_PLANT, 
  MAT_WOODEN_PLANT, MAT_STRAW, MAT_MISC_DRUG, MAT_CANNABIS, MAT_HEAL, MAT_MISC_FOOD, MAT_FRUIT, 
  MAT_BREAD, MAT_SUGAR, MAT_MUSHROOM, MAT_MISC_SPICE, MAT_PEPPER, MAT_SALT, MAT_MISC_DEAD, MAT_HORN, 
  MAT_HAIR, MAT_BONE, MAT_CHITIN, MAT_GHOST, MAT_SKIN, MAT_FEATHER, MAT_PELT, MAT_IVORY, MAT_WOOL, 
  MAT_FLESH, MAT_MISC_EXPLOSIVE, MAT_GUNPOWDER, MAT_NITROGLYCERINE, MAT_TNT, MAT_MISC, MAT_MISC_MAGIC, 
  MAT_MISC_HOLY, MAT_MISC_UNHOLY, MAT_MISC_LIVING, MAT_MISC_POISON, MAT_MISC_INVIS, MAT_MISC_FLEXIBLE, 
  MAT_MISC_MAGNETIC, MAT_FIRE, MAT_LIGHTNING, MAT_SHADOW, MAT_LIGHT, MAT_WOOD, MAT_MISC_WOOD, MAT_METAL, 
  MAT_MISC_METAL, MAT_JEWEL, MAT_MISC_JEWEL, MAT_MAGIC, MAT_MISC_MAGIC, MAT_ANIMAL, MAT_MISC_LIVING, 
  MAT_PLANT, MAT_MISC_PLANT, MAT_FOOD, MAT_MISC_FOOD, MAT_FUR, MAT_PELT, MAT_STONE, MAT_MISC_STONE, 
  MAT_GUM, MAT_PLASTIC});

  mat1 = all_mat[random(sizeof(all_mat))];
  mat2 = all_mat[random(sizeof(all_mat))];

  mat1_name = call_other(MATERIALDB,"MaterialName",mat1,0,100);
  mat2_name = call_other(MATERIALDB,"MaterialName",mat2,0,100);

  mat1_name_nospace = implode(explode(mat1_name, " "), "");
  mat2_name_nospace = implode(explode(mat2_name, " "), "");

  for(i=0;i<sizeof(all_mat);i++)
  {
    mat1_name += call_other(MATERIALDB,"MaterialName",all_mat[i],0,100) + ", ";
  }

  SetProp(P_SHORT, "Ein Testmaterial");
  SetProp(P_LONG,
    "Dieses Testmaterial besteht aus: "+mat1_name);

  SetProp(P_NAME, "Testmaterial");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"testmaterial","material","testmat"}) );

  SetProp(P_MATERIAL, all_mat );
  SetProp(P_WEIGHT, 25);
  SetProp(P_SIZE, 8);
  SetProp(P_VALUE, 500);

}

