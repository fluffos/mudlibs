// Balsam zur Materialwandlung
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"
#include <thing/material.h>

inherit "std/thing";

string *all_mat;
string mat1, mat1_name, mat1_name_nospace;
string mat2, mat2_name, mat2_name_nospace;

void SetMaterial(string new_mat_1, string new_mat_2)
{
  mat1 = new_mat_1;
  mat2 = new_mat_2;
  
  mat1_name = call_other(MATERIALDB,"MaterialName",mat1,0,100);
  mat2_name = call_other(MATERIALDB,"MaterialName",mat2,0,100);

  mat1_name_nospace = implode(explode(mat1_name, " "), "");
  mat2_name_nospace = implode(explode(mat2_name, " "), "");

  SetProp(P_SHORT, "Ein "+mat1_name+"-zu-"+mat2_name+" Balsam");
  SetProp(P_LONG,
    "Dieser seltsame Balsam besteht aus "+mat2_name+". Ob das Sinn ergibt?");

  SetProp(P_INFO, BS("Dieser Balsam, wenn aufgetragen auf "+mat1_name+", wird dieses Material "
    "in "+mat2_name+" verwandeln. Es muss sich dabei exakt um das korrekte Material handeln. Ein "
    "Metall-zu-Milch Balsam kann also Metall verwandeln, aber nicht Titan. Fuer Titan waere "
    "beispielsweise ein Titan-zu-Kork Balsam geeignet."));
  SetProp(P_NAME, mat1_name+"-zu-"+mat2_name+" Balsam");
  SetProp(P_GENDER, MALE);
  AddId( ({lower_case(mat1_name_nospace)+"-zu-"+lower_case(mat2_name_nospace)+" balsam",
  lower_case(mat1_name_nospace)+"-zu-"+lower_case(mat2_name_nospace)+"balsam", 
  lower_case(mat1_name_nospace)+"zu"+lower_case(mat2_name_nospace)+"balsam", 
  lower_case(mat1_name_nospace+mat2_name_nospace)+"balsam","balsam"}) );

  SetProp(P_MATERIAL, ([mat1:1, mat2:99]) );
}

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  all_mat = ({MAT_MISC_SOLID, MAT_LEATHER, MAT_GLASS, MAT_CERAMIC, MAT_ICE, MAT_SNOW, MAT_PHOSPHORUS, 
  MAT_SALPETER, MAT_CARBON, MAT_PEARL, MAT_WAX, MAT_TAR, MAT_CHALK, MAT_SHIT, MAT_FAT, MAT_PLASTIC, 
  MAT_PAPER, MAT_CARTON, MAT_PERGAMENT, MAT_PAPYRUS, MAT_CLOTH, MAT_SILK, MAT_VELVET, MAT_COTTON, 
  MAT_FELT, MAT_BAUSCH, MAT_SATIN, MAT_EARTH, MAT_SAND, MAT_DUST, MAT_PLUTONIUM, MAT_MISC_WOOD, 
  MAT_MISC_DECIDUOUS_WOOD, MAT_MISC_CONIFER_WOOD, MAT_MISC_TROPICAL_WOOD, MAT_PEAR_WOOD, MAT_OAK, 
  MAT_BEECH, MAT_EBONY, MAT_FIR, MAT_TEAK, MAT_CORK, MAT_BALSA, MAT_ELM_WOOD, MAT_YEW_WOOD, MAT_ASH_WOOD, 
  MAT_TICTOC_WOOD, MAT_BIRCH_WOOD, MAT_MAHAGHONI_WOOD, MAT_CHERRY_WOOD, MAT_MISC_STONE, MAT_GRANITE, 
  MAT_SLATE, MAT_MARBLE, MAT_CONCRETE, MAT_ASPHALT, MAT_LIME, MAT_MISC_METAL, MAT_IRON, MAT_STEEL, 
  MAT_COPPER, MAT_BRONCE, MAT_BRASS, MAT_TIN, MAT_LEAD, MAT_TITANIUM, MAT_MERCURY, MAT_ALUMINIUM, 
  MAT_TUNGSTEN, MAT_COBALT, MAT_IRIDIUM, MAT_CHROMIUM, MAT_NICKEL, MAT_MAGNESIUM, MAT_SILVER, 
  MAT_GOLD, MAT_PLATINUM, MAT_MITHRIL, MAT_ADAMANT, MAT_MISC_FLUID, MAT_WATER, MAT_MILK, MAT_ALCOHOL, 
  MAT_OIL, MAT_BLOOD, MAT_PARFUM, MAT_INK, MAT_SLIME, MAT_MISC_ACID, MAT_MISC_GAS, MAT_AIR, MAT_METHANE, 
  MAT_HELIUM, MAT_LAUGHING_GAS, MAT_MISC_JEWEL, MAT_OCTARINE, MAT_DIAMOND, MAT_RUBY, MAT_SAPPHIRE, 
  MAT_AQUAMARINE, MAT_EMERALD, MAT_JADE, MAT_QUARTZ, MAT_AMETHYST, MAT_TOPAZ, MAT_AMBER, MAT_OPAL, 
  MAT_GARNET, MAT_ROCKCRYSTAL, MAT_LAPISLAZULI, MAT_TURMALIN, MAT_ONYX, MAT_MISC_MINERAL, MAT_AGATE, 
  MAT_SULFUR, MAT_LAZURITE, MAT_CRYSTAL, MAT_OBSIDIAN, MAT_ASBESTOS, MAT_MISC_HERBAL, MAT_MISC_PLANT, 
  MAT_WOODEN_PLANT, MAT_STRAW, MAT_MISC_DRUG, MAT_CANNABIS, MAT_HEAL, MAT_MISC_FOOD, MAT_FRUIT, 
  MAT_BREAD, MAT_SUGAR, MAT_MUSHROOM, MAT_MISC_SPICE, MAT_PEPPER, MAT_SALT, MAT_MISC_DEAD, MAT_HORN, 
  MAT_HAIR, MAT_BONE, MAT_CHITIN, MAT_GHOST, MAT_SKIN, MAT_FEATHER, MAT_PELT, MAT_IVORY, MAT_WOOL, 
  MAT_FLESH, MAT_MISC_EXPLOSIVE, MAT_GUNPOWDER, MAT_NITROGLYCERINE, MAT_TNT, MAT_MISC, MAT_MISC_MAGIC, 
  MAT_MISC_HOLY, MAT_MISC_UNHOLY, MAT_MISC_LIVING, MAT_MISC_POISON, MAT_MISC_INVIS, MAT_MISC_FLEXIBLE, 
  MAT_MISC_MAGNETIC, MAT_FIRE, MAT_LIGHTNING, MAT_SHADOW, MAT_LIGHT, MAT_WOOD, MAT_MISC_WOOD, MAT_METAL, 
  MAT_MISC_METAL, MAT_JEWEL, MAT_MISC_JEWEL, MAT_MAGIC, MAT_MISC_MAGIC, MAT_ANIMAL, MAT_MISC_LIVING, 
  MAT_PLANT, MAT_MISC_PLANT, MAT_FOOD, MAT_MISC_FOOD, MAT_FUR, MAT_PELT, MAT_STONE, MAT_MISC_STONE, 
  MAT_GUM, MAT_PLASTIC});

  SetMaterial(all_mat[random(sizeof(all_mat))], all_mat[random(sizeof(all_mat))]);

  SetProp(P_WEIGHT, 25);
  SetProp(P_SIZE, 8);
  SetProp(P_VALUE, 500);
  SetProp(P_MAGIC, 1);

  AddCmd( ({"schmier","schmiere"}), "cmd_einschmieren");
}

int special_strstr(string str, string s)
{
  if(strstr(str,s) >= 0) return 1;
  else return 0;
}

string myreplace(string str, string old, string new)
{
  str = regreplace(str,lower_case(old),lower_case(new),1);
  str = regreplace(str,capitalize(old),capitalize(new),1);
  return str;
}

int cmd_einschmieren(string str)
{
  string target;
  string balm;
  object ob;

  string *ids;

  mixed target_material;

  if(!interactive(TP)) return 0;
  if(!ENV(TO)) return 0;

  if(TP != ENV(TO))
  {
    TP->Message(BS("Du musst den Balsam schon in die Hand "
   "nehmen."));
   return -1;
  }

  if(!str || sscanf(str, "%s mit %s ein", target, balm) != 2)
  {
    write(BS("Was moechtest Du womit einschmieren?"));
    return -1;
  }

  if(!ob = present(target,TP))
  {
    TP->Message(BS("Du hast doch gar kein(e) '"+capitalize(target)+"'!"));
   return -1;
  }

  if(interactive(ob) || living(ob)) 
    TP->Message(BS("Du kannst nur Gegenstaende mit dem Balsam einschmieren, an "
    +ob->name(WEM)+" waere er verschwendet!"));

  if(member(QueryProp(P_IDS),balm) == -1)
  {
    write(BS("Womit moechtest Du das einschmieren?"));
    return -1;
  }

  target_material = ob->QueryProp(P_MATERIAL);

  if(!target_material ||
    mappingp(target_material) && !member(target_material,mat1) // mapping
    ||
    stringp(target_material) && target_material != mat1 // string
    || 
    member(target_material,mat1) == -1) // jetzt muss es ein array sein
  {
    write(BS("Du suchst verzweifelt "+mat1_name+" an "+ ob->name(WEM,1)+
      " und gibst schliesslich erfolglos auf."));
    return -1;
  }

  else
  {
    TP->Message(BS("Du schmierst "+ob->name(WEN,1)+" mit "+TO->name(WEM)+" ein. "
    "Mit einem *Wuuuhhschhh* wandelt sich "+mat1_name+ " in "+mat2_name+"."));
    ENV(TP)->Message(BS(
     TPN+" schmiert "+ob->name(WEN,1)+" mit einem seltsamen Balsam ein."),
     MSGFLAG_NO_TP);
     
    // Materialwandlung:

    if(mappingp(target_material) && member(target_material,mat1) ) // mapping
    {
      target_material[mat2] += target_material[mat1]; // neues Material reinschreiben
      target_material -= ([mat1]); // altes Material loeschen
      ob->SetProp(P_MATERIAL, target_material); // setzen
    }
    else if(stringp(target_material) && target_material == mat1) // string
    {
      ob->SetProp(P_MATERIAL, target_material);
    }
    else if(member(target_material,mat1) != -1) // array
    {
      target_material = exclude_array(target_material, member(target_material,mat1)); // altes loeschen
      target_material += ({mat2});
    }

    // Umbenennen
    ob->SetProp(P_SHORT, myreplace(ob->QueryProp(P_SHORT),mat1_name,mat2_name) );
    ob->SetProp(P_LONG, myreplace(ob->QueryProp(P_LONG),mat1_name,mat2_name) );
    ob->SetProp(P_NAME, myreplace(ob->QueryProp(P_NAME),mat1_name,mat2_name) );
    if(ob->QueryProp(P_INFO)) ob->SetProp(P_INFO, 
      myreplace(ob->QueryProp(P_INFO),mat1_name,mat2_name) );
    // Runenitems
    if(ob->QueryProp(P_ITEMD_VIS_SHORT)) ob->SetProp(P_ITEMD_VIS_SHORT, 
      myreplace(ob->QueryProp(P_ITEMD_VIS_SHORT),mat1_name,mat2_name) );
    if(ob->QueryProp(P_ITEMD_VIS_LONG)) ob->SetProp(P_ITEMD_VIS_LONG, 
      myreplace(ob->QueryProp(P_ITEMD_VIS_LONG),mat1_name,mat2_name) );
    if(ob->QueryProp(P_ITEMD_VIS_NAME)) ob->SetProp(P_ITEMD_VIS_NAME, 
      myreplace(ob->QueryProp(P_ITEMD_VIS_NAME),mat1_name,mat2_name) );
    
    ids = ob->QueryProp(P_IDS);
    ids = filter_array(ids,#'special_strstr,lower_case(mat1_name)); //'
    ob->RemoveId(lower_case(mat1_name));
    ob->RemoveId(ids);
 
    ids = 
      explode(
        myreplace(
          implode(ids,"\n"),mat1_name,mat2_name),
      "\n");

    ob->AddId(ids);

    TO->remove(1);
    return 1;
  }

}

