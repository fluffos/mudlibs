// Schattenleine
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"

inherit "/std/thing";
inherit ZONE "std/std.lpc";

#include "/p/daemon/itemd/itemd.h"

object current_gaul;

create()
{
  if (!is_clone(TO)) return;
  ::create();
  AddId( ({"schattenleine", "leine"}));
  SetProp(P_SHORT,"Schattenleine");
  SetProp(P_LONG,
   "Die Schattenleine bestehen aus farblosem Leder.");
  SetProp(P_NAME, "Schattenleine");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 400);  
  SetProp(P_VALUE, 1000); 
  SetProp(P_MATERIAL, ([ MAT_LEATHER:99, MAT_SHADOW:1 ]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  seteuid(getuid(TO));
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);

  //AddCmd("lege", "CmdAnlegen"); // clashes with 'lege x ab'
  AddCmd("lein|leine", "CmdAnleinen");
}

// ------------------------------------------------------------------------------
int _query_nodrop()
{
  if(!current_gaul)
  {
    TO->SetProp(P_NODROP, 0);
    return 0;
  }
  else return 1;
}

