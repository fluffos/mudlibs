// ------------------------------------------------------------------------------
int CmdAnleinen(string str)
{
  string first, second;
  object gaul;

  if(!interactive(TP)) return 0;
  if(!ENV(TO) || !ENV(ENV(TO))) return 0;

  if(TP != ENV(TO)) return 0;

  else if(!str || sscanf(str, "%s %s", first, second) != 2)
  {
    write(BS("Wen moechtest Du mit der Schattenleine an- oder ableinen?"));
    return -1;
  }

  else if(second != "an" && second != "ab")
  {
    write(BS("Du kannst die Schattenleine nur fuer dan An- oder Ableinen benutzen."));
    return -1;
  }

  else if(!gaul = present(first,ENV(ENV(TO))))
  {
    write(BS("Hier ist doch gar kein*e '"+first+"'!"));
    return -1;
  }

  // ANleinen ab hier
  else if(second == "an")
  {
    if(current_gaul)
    {
      write(BS("Aber die Schattenleine ist doch bereits in Verwendung! Leine den Gaul doch erst einmal ab."));
      return -1;
    }

    else if(!gaul->id("\nlastentier"))
    {
      write(BS(gaul->Name(WEM)+" kannst Du mit der Schattenleine nicht anleinen."));
      return -1;
    }

    else if(gaul->QueryProp("has_schattenleine"))
    {
      write(BS(gaul->Name(WER)+" ist bereits angeleint."));
      return -1;
    }

    else
    {
      write(BS("Du legst "+gaul->name(WEM)+" die Schattenleine an."));
      ENV(TP)->Message(BS(TPN+" legt "+gaul->name(WEM)+" die Schattenleine an."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      TO->SetProp(P_NODROP, 1);
      gaul->SetOwner(TP);
      current_gaul = gaul;
      return 1;
    }
  }

  // ABleinen ab hier
  else if(second == "ab")
  {
    if(!current_gaul)
    {
      write(BS("Derzeit ist nichts und niemand an dieser Schattenleine angeleint."));
      return -1;
    }

    if(current_gaul != gaul)
    {
      write(BS("Dieser Schattengaul ist nicht an dieser Leine angeleint."));
      return -1;
    }

    else if(!gaul->QueryProp("has_schattenleine"))
    {
      write(BS(gaul->Name(WER)+" ist doch gar nicht angeleint."));
      return -1;
    }

    else
    {
      write(BS("Du nimmst "+gaul->name(WEM)+" die Schattenleine wieder ab."));
      ENV(TP)->Message(BS(TPN+" nimmt "+gaul->name(WEM)+" die Schattenleine ab."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      TO->SetProp(P_NODROP, 0);
      gaul->RemoveOwner();
      current_gaul = 0;
      return 1;
    }
  }
}


// ------------------------------------------------------------------------------
int remove()
{
  // if removed --> clean Pursuers in gaul
  if(is_clone(TO) && current_gaul) current_gaul->RemoveOwner();
  destruct(TO);
  return 1;
}