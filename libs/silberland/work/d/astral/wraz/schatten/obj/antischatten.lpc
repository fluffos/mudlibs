// Antischatten fuer Prop "waffenbalsam" = 9 (nur Sterbewaffen)
// Schattenwelt
// Wraz / Mendralim

// Update 9.1.2025: Da der Waffenbalsam ohnehin nicht auf Sterbewaffen funktioniert, musste 
// der Antischatten geaendert werden:
// Die Idee war, dass Sterbewaffen einen Lichtschaden erhalten koennen, um in der Schattenwelt
// genutzt werden zu koennen. Neue Variante daher: Lichtschaden wird zu DAM_TYPES hinzugefuegt.
// Funktioniert auch fuer alle anderen Waffen.
// Bei Sterbewaffen kann der Lichtschaden einfach wieder entfernt werden, wenn die Waffe eine
// Rissseite hat ("schlage mit nicht/rissseite zu"), dann wird der Schadenstyp ueberschrieben.
// Bei anderen Waffen ist die Aenderung permanent (aehnlich wie bei Waffenbalsam).

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Antischatten");
  SetProp(P_LONG,
    "Der Antischatten sieht aus wie ein Schatten, doch auf eine unbeschreibliche Weise "
    "gleichzeitig wie sein Gegenteil.");

  SetProp(P_INFO, BS("Vom Antischatten geht eine schwer in Worte zu fassende Anti-Aura aus. "
    "Du bist Dir ganz sicher, dass Du mit 'anti ...' einen materiellen Gegenstand "
    "veraendern kannst, hast aber absolut keine Ahnung, was dann passieren wird."));
  SetProp(P_NAME, "Antischatten");
  SetProp(P_GENDER, MALE);
  AddId( ({"antischatten","balsam"}) );

  SetProp(P_MATERIAL, ([MAT_MISC: 50, MAT_SHADOW:50]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOSELL, "Den Schatten zu verkaufen erscheint Dir irgendwie eine sehr "
    "seltsame Idee, daher laesst Du es.");
  SetProp(P_MAGIC, 1);

  AddCmd( ({"anti"}), "cmd_anti");
}

int cmd_anti(string str)
{
  object ob;

  if(!TP || !interactive(TP)) return 0;
  if(!ENV(TO)) return 0;
  if(!str) 
  {
    TP->Message(BS("Anti was?"));
    return -1;
  }

  if(TP != ENV(TO))
  {
    TP->Message(BS("Du musst den Antischatten schon in die Hand "
   "nehmen ... obwohl, eigentlich ist er nie richtig 'in' Deiner Hand, aber doch "
   "irgendwie in Deiner Kontrolle."));
   return -1;
  }

  if(!ob = present(str,TP))
  {
    TP->Message(BS("Du hast doch gar kein(e) '"+capitalize(str)+"'!"));
   return -1;
  }

  //if(ob->QueryProp("waffenbalsam") != 10 || !ob->id("\nsterbewaffe"))
  if(!ob->QueryProp(P_WEAPON_TYPE) || !ob->QueryProp(P_DAM_TYPE))
  {
    write(BS("Auf "+ob->name(WEN,1)+" haette der Antischatten keine Wirkung."));
    return -1;
  }

  else
  {
    TP->Message(BS("Du 'legst' den Antischatten auf "+ob->name(WEN,1)+", und "
    +ob->QueryPronoun()+" schillert fuer einige Sekunden in Farben, die Du noch "
    "nie gesehen hast. Als das Schillern endet, fragst Du Dich, was sich wohl "
    "geaendert hat."));
    ENV(TP)->Message(BS(
     TPN+" 'legt' etwas Seltsames auf "+ob->name(WEN,0)+". "
    +ob->QueryPronoun()+" schillert fuer einige Sekunden in Farben, die Du noch "
    "nie gesehen hast."),
     MSGFLAG_NO_TP);
    //ob->SetProp("waffenbalsam", 9);

    // Lichtschaden hinzufuegen oder entfernen
    if(member(ob->QueryProp(P_DAM_TYPE), DT_LIGHT) != -1)
      ob->SetProp(P_DAM_TYPE, ob->QueryProp(P_DAM_TYPE) - ({DT_LIGHT}) );
    else
      ob->SetProp(P_DAM_TYPE, ob->QueryProp(P_DAM_TYPE) + ({DT_LIGHT}) );

    TO->remove(1);
    return 1;
  }

}
