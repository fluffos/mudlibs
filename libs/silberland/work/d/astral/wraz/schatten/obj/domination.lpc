// Schatten Domination (Gedankenschinder)
// Schattenwelt
// Wraz / Mendralim

#include "../def.h"

inherit "std/thing";
inherit ZONE "std/std.lpc";

object pl;
object dominator;

int min_domination_time = 10;
int rnd_domination_time = 60;

string original_pmsgout = "geht";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "");

  AddId( ({"\nshadow_domination"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);

  if(find_call_out("RemoveDomination") == -1) 
    call_out("RemoveDomination", min_domination_time+random(rnd_domination_time));
}

public void init() {
  ::init();

  add_action("DisableCommands","",1);
}

int DisableCommands(string str)
{
  if(TP && pl && TP == pl)
  {
    pl->Message(BS("Du hast keine Kontrolle ueber Deinen Koerper!"));
    return 1;
  }
  return 0;
}

string extra_look()
{
  if(pl && living(pl))
   return BS(CAP(pl->QueryPronoun())+" starrt mit leerem Blick.");
  else return 0;
}

void Setup(object _pl, object _dominator)
{
  pl = _pl;
  dominator = _dominator;

  if(!pl || !living(pl)) 
  {
    TO->remove(1);
    return;
  }
  
  pl->UpdateAttributes();

  if(TO && pl && Count(pl,"\nshadow_domination") >= 2) 
  {
    TO->remove(1);
    return;
  }

  // Kampf beenden
  pl->StopHuntFor(dominator,1);
  dominator->StopHuntFor(pl,1);

  // Verfolgung starten
  dominator->AddPursuer(pl);
  original_pmsgout = pl->QueryProp(P_MSGOUT);
  pl->SetProp(P_MSGOUT, "folgt "+dominator->name(WEM,1)+" mit leerem Blick");
}

void RemoveDomination()
{
  if(TO && pl)
  {
    pl->Message(BS("Deine Gedanken werden wieder klar."));
    if(ENV(pl)) ENV(pl)->Message(BS(pl->Name(WESSEN)+" Blick klart wieder auf."),
      MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE:({pl})]));
    if(dominator) {
      dominator->RemoveDominatedPlayer(pl);
      // Kampf wieder starten
      dominator->Kill(pl);
      // Verfolgung beenden
      dominator->RemovePursuer(pl);
      pl->SetProp(P_MSGOUT, original_pmsgout);
    }
    TO->remove(1);
  }
  else TO->remove(1);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(pl && (pl == player))
  {
    TO->remove(1);
  }
}

int remove()
{
  if(pl)
  {
    pl->UpdateAttributes();
  }
  destruct(TO);
  return 1;
}

void reset() 
{
  ::reset();
  if (!is_clone(TO)) return;
  if(!pl) remove(1);
  else if(QueryProp(P_CLONE_TIME) < time() - (min_domination_time+rnd_domination_time)) 
    remove(1);
}