// Schattendrachenschuppe
// Schattenwelt
// Wraz / Mendralim

inherit "std/unit";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Schattendrachenschuppe");
  SetProp(P_LONG,
    "Die Schattendrachenschuppe ist graeulich durchscheinend, die Schatten darin "
    "wabern langsam.");

  SetProp(P_NAME, ({"Schattendrachenschuppe", "Schattendrachenschuppen"}) );
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schattendrachenschuppe","drachenschuppe","schuppe"}) );

  AddSingularId( ({"schattendrachenschuppe", "drachenschuppe","schuppe"}) );
  AddPluralId( ({"schattendrachenschuppen","drachenschuppen","schuppen"}) );

  SetProp(P_MATERIAL, ([MAT_HORN:100]) );
  SetProp(P_SIZE, 10);

  SetCoinsPerUnits(9000,1);
  SetGramsPerUnits(1,1);

  SetProp(P_MAGIC, 1);
}

int _query_autoloadobj() 
{
  return QueryProp(P_AMOUNT);
}

_set_autoloadobj(int data)
{
  SetProp(P_AMOUNT, data);
}