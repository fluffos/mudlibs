// Schattenwelt
// von Wraz / Mendralim
// Schattenlinse: Wandelt Feuer- in Lichtschaden

// Schattenkristalllinse, schwebt vor dem Spieler (nur Druide) und fokussiert
//  Feuerangriffe magisch in Licht

#include "../def.h"

inherit "/std/thing";
inherit ZONE "std/std.lpc";

#include "/p/daemon/itemd/itemd.h"

object owner;

void create () 
{
  if (!is_clone(TO)) return;
  ::create();

  call_other(TO,"first_set",previous_object());

  AddId ("\nlichtwandler");
  SetProp(P_NAME, "Kristalllinse");
  SetProp(P_NAME_ADJ, "schattig");
  SetProp(P_LONG,
    "Diese Kristalllinse wird kontinuierlich von Schatten umspuelt. Sie ist etwa "
    "menschenfaustgross und reflektiert das Licht auf eine ganz seltsame Art. "
    "Farben scheinen irgendwie in Grautoene verwandelt zu werden. Du weisst nicht "
    "so recht, was Du damit anfangen sollst.");
  AddId( ({"linse","kristalllinse","kristallinse","schattenkristalllinse",
    "schattenlinse","schattenkristall","kristall"}) );
  AddAdjective( ({ "schattige", "schattig" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MAGIC, 1);
  SetProp(P_WEIGHT, 250);
  SetProp(P_SIZE, 12);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:50, MAT_SHADOW:50]) );
  SetProp(P_MAGIC, 1);
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  seteuid(getuid(TO));
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);

  AddCmd("fokussiere&auf&linse|kristalllinse|schattenkristall|schattenlinse"+
    "|schattenkristalllinse|kristallinse", "FokussiereAufLinse", 
    "AUF was moechtest Du Dich fokussieren?|Worauf moechtest Du Dich fokussieren?");
  
  AddCmd("loese|fokus", "LoeseFokus", 
  "Was moechtest Du loesen??");
}

// ------------------------------------------------------------------------------
string _query_short()
{
  if(owner && living(owner)) 
  {
    if(TP == owner && ENV(TO) == owner) return "Eine schattige Kristalllinse (schwebend)";
    else if(TP == owner) return "Eine schattige Kristalllinse (vor Dir schwebend)";
    else return "Eine schattige Kristalllinse (vor "+owner->name(WEM)+" schwebend)";
  }
    
  return "Eine schattige Kristalllinse";
}

// ------------------------------------------------------------------------------
void setup(object target)
{
  owner = target;
  owner->AddPursuer(TO);

  return;
}

// ------------------------------------------------------------------------------
int FokussiereAufLinse()
{
  if(!TO || !ENV(TO)) return 0;
  if(TP != ENV(TO)) 
  {
    write(BS("Du musst die schattige Kristalllinse schon nehmen."));
    return -1;
  }
  else if(TP->QueryProp(P_GUILD) != "druidenzirkel")
  {
    write(BS("Du fokussierst Dich ganz auf die schattige Kristalllinse. Nichts passiert."));
    return -1;
  }
  else if(TP->QueryProp(P_GUILD_LEVEL) < 14)
  {
    write(BS("Du fokussierst Dich ganz auf die schattige Kristalllinse. "
      "Du spuerst, wie Deine astrale Macht mit der Magie der Linse in "
      "Kontakt tritt. Dann aber endet der Kontakt. Du glaubst, noch nicht "
      "ausreichend maechtig zu sein, um diese Linse zu nutzen."));
    return -1;
  }
  write(BS("Du fokussierst Dich ganz auf die schattige Kristalllinse. "
    "Du spuerst, wie Deine astrale Macht mit der Magie der Linse in "
    "Kontakt tritt. Dann nimmst Du innerlich ein leichtes Prickeln, "
    "ein Knistern wahr. Die Linse scheint nun an Dich gebunden zu sein."));
  setup(TP);
  return 1;
}

// ------------------------------------------------------------------------------
int LoeseFokus()
{
  if(owner && TP == owner)
  {
    TP->Message(BS("Du loest den Fokus auf die schattige Kristalllinse wieder "
      "und nimmst sie an Dich."));
    owner->RemovePursuer(TO);
    owner = 0;
    TO->move(TP,M_NOCHECK);
    return 1;
  }
  return 0;
}

// ------------------------------------------------------------------------------
string _query_info()
{
  string adj;

  if(TO && ENV(TO) && interactive(ENV(TO)))
  {
    if(ENV(TO)->QueryProp(P_GUILD) == "druidenzirkel")
      switch (ENV(TO)->QueryProp(P_GUILD_LEVEL))
      {
        case 1..14:
          return BS("Du erkennst, dass Dir diese schattige Kristalllinse von Nutzen "
            "sein kann, aber genaueres erkennst Du nicht.");
            break;
        case 15:
         return BS("Du erkennst, dass Dir diese schattige Kristalllinse von Nutzen "
            "sein kann. Dazu musst Du sie irgendwie zum Schweben bringen, Du weisst "
            "aber nicht, wie.");
            break;
        case 16..17: // vllt gibts ja mal gildenlevel 17 ;)
          switch (QueryProp("shadow_difficulty_int"))
          {
            case 0..3: adj = "gewoehnlich"; break;
            case 4..5: adj = "recht gut"; break;
            case 6..7: adj = "gut"; break;
            case 8..9: adj = "sehr gut"; break;
            case 10..11: adj = "aussergewoehnlich gut"; break;
            case 12..13: adj = "fast perfekt"; break;
            case 14: adj = "perfekt"; break;
            default: adj = "** ERROR - Magier informieren **"; break;
          }
         return BS("Du erkennst, dass Dir diese schattige Kristalllinse von Nutzen "
            "sein kann. Dazu musst Du Dich zuerst auf die Linse fokussieren, und "
            "sie dann ablegen, oder Dich einfach bewegen. Sie wird Dir dann folgen, "
            "schwebend, und sich immer so vor Dir positionieren, dass wohl manche "
            "Deiner Zauber zu Licht fokussiert werden. Wie und welche genau, weisst "
            "Du nicht, das musst Du wohl ausprobieren. Den Fokus kannst Du "
            "jederzeit loesen.")+
            BS("Ausserdem erkennst Du, dass die Linse "+adj+" verarbeitet ist.");
            break;
        default:
          return 0;
          break;
      }
  }
  return 0;
}

// ------------------------------------------------------------------------------
string _query_noget()
{
  if (owner && TP != owner) return BS("Du zerrst an der Linse, doch sie scheint "
    "wie vor "+owner->name()+" festgeschraubt, obwohl sie schwebt.");
  else if (owner && TP == owner && ENV(TO) == ENV(owner))
  {
    /*TP->Message(BS("Du loest den Fokus auf die schattige Kristalllinse wieder."));
    owner->RemovePursuer(TO);
    owner = 0;*/
    return BS("Wenn Du die Linse nehmen moechtest, musst Du zuerst den Fokus loesen.");
  }
  else return 0;
}

// ------------------------------------------------------------------------------
void init() 
{
  ::init();
  /*if(active && volume <= 0) {
    call_out("end");
  }*/

  if(TP != owner && !interactive(TP)) {
    TP->AddDefender(TO);
  }
}

// ------------------------------------------------------------------------------
mixed DefendOther(int dam, mixed dam_type, mixed spell,object enemy) 
{
  int diff;

  if(!objectp(owner) || enemy != owner) return ({dam, dam_type, spell});

  // Debug
  if(QueryProp("wdebug",1)) DB(BS("dam: "+to_string(dam)+
    ", dam_type: "+to_string(implode(dam_type,";"))+
    ", spell: "+to_string(implode(m_indices(spell),", "))+
    "; "+to_string(implode(m_values(spell),", "))
    ));

  // Bei maximaler Difficulty (==14) funktioniert die Feuer-in-Licht Transformation immer
  // Ansonsten nur mit einer Wahrscheinlichkeit (von 1:1 bis 14:1)
  diff = QueryProp("shadow_difficulty_int");
  if(diff < 14 && !random(2+diff)) return ({dam, dam_type, spell});

  // Es muss ein Zauber sein
  if(!spell || spell == ([])) return ({dam, dam_type, spell});

  // Schaden muss Feuer sein (oder Feuer enthalten)
  if(!dam_type || (stringp(dam_type) && dam_type != DT_FIRE)) return ({dam, dam_type, spell});
  else if(member(dam_type,DT_FIRE) == -1) return ({dam, dam_type, spell});
  
  tell_object(owner, BS(Name(WER)+" transformiert Deinen Feuerzauber in grelles Licht!"));
  tell_room(ENV(owner), BS(Name(WER)+" transformiert "+owner->Name(WESSEN)+
    " Feuerzauber in grelles Licht!"), ({owner}));  

  // Debug
  if(QueryProp("wdebug",1)) DB(BS("enemy: "+to_string(enemy)+", owner: "+to_string(owner)));
  if(QueryProp("wdebug",1)) DB(BS("dam: "+to_string(dam)+
    ", dam_type: "+to_string(implode(dam_type,";"))+
    ", spell: "+to_string(implode(m_indices(spell),", "))+
    "; "+to_string(implode(m_values(spell),", "))
    ));

  // Schadenstyp aendern
  dam_type -= ({DT_FIRE});
  dam_type += ({DT_LIGHT});

  // Schaden verstaerken (5% Chance auf ca. 520% Schaden - fuer "perfekte" Linse)
  dam = dam * (100 + 2 * diff + random(4*diff) + random(21)/20 * 30 * diff) / 100;

  return ({dam, dam_type, spell});
}

// ------------------------------------------------------------------------------
int PreventFollow(object dest)
{
  if(!dest || !owner || owner->QueryProp(P_GHOST)) 
  {
    owner = 0;
    return 2;
  }
  if(owner && ENV(TO) == owner)
  {
    owner->Message(BS("Die schattige Kristalllinse schwebt von alleine vor Dir her."));
    return 0;
  }

  else return 0;
}

// ------------------------------------------------------------------------------
void BecomesNetDead(object spieler)
{
  if(spieler == owner)
  {
    owner->RemovePursuer(TO);
    owner = 0;
  }
}

// ------------------------------------------------------------------------------
void reset()
{
  ::reset();

  if (!is_clone(TO)) return;
}
