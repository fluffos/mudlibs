// Movehook in Schattenwelt
// von Wraz / Mendralim
// XP Kosten bei Verlassen der Schattenwelt

#include "../def.h"

inherit "std/thing";

object pl;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,"");

  SetProp(P_NAME, "Schatten_Movehook");
  SetProp(P_GENDER, NEUTER);
  AddId("\nwrazschatten_movehook");

  SetProp(P_MATERIAL, ([MAT_MISC_INVIS:100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  //SetProp(P_NOGET,1);
}

void Setup(object _pl)
{
  DB("Setup() called\n");
  pl = _pl;
  pl->SetProp(P_TMP_MOVE_HOOK, ({time()+270000, TO, "CheckEnvShadow"})); // 270000
}

string CheckEnvShadow(mixed dest)
{
  int xp_cost;
  object dest_room;
  DB("strstr: "+strstr(file_name(ENV(pl)),ROOM)+"\n");
  DB("ROOM: "+ROOM+"\n");
  DB("dest: "+to_string(dest)+"\n");
  if(stringp(dest)) dest_room = find_object(dest);
  else if(objectp(dest)) dest_room = dest;
  else dest_room = 0;
  if(!dest_room) { DB("dest_room not found\n");
  return 0;}
  if(pl&&dest_room&&strstr(file_name(dest_room),ROOM) == -1)
  {
    xp_cost = pl->QueryProp(P_XP)/100;
    call_other(SCHATTEN "master/log_master", "DoEntryExitLog", pl, TO, ENV(pl), 
      dest_room,"schatten_movehook, xp_cost: "+xp_cost);
    pl->Message("\n"+BS(
      "Der krasse Wechsel aus den Schatten in diese Wirklichkeit zehrt "
      "massiv an Deiner Erfahrung.")+"\n");
    pl->AddExp(-xp_cost);
    TO->remove();
  }
}

void reset()
{
  if (!is_clone(TO)) return;
  //::reset(); //check if this should be here
  if(TO&&ENV(TO)&&query_once_interactive(ENV(TO))) Setup(ENV(TO)); 
}

void BecomesNetAlive(object player)
{
  Setup(player); 
}