// Schattenwelt
// von Wraz / Mendralim
//
// Dogrok, Wirt in Taverne

#include "../def.h"
inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Dogrok, der Wirt");
  SetProp(P_LONG,
    "Dogrok der Wirt ist ein Oger." );

  SetProp(P_NAME, "Dogrok");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"oger", "dogrok", "wirt", "Schwertexperte", "NOWIMPY", "Krieger"}));
  set_living_name("dogrok");
  SetProp(P_ARTICLE, 0);

  create_default_npc(32);

  SetProp(P_HANDS, ({" mit seinen Faeusten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON}) }));

  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 240);
  SetProp(P_WEIGHT, 130000);
  SetProp(P_ALIGN, 10);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" nimmt das nicht!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_DIE_MSG,  " kippt tot um.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "sieht Dich verwirrt an.\n");

  AddInfo( ({"oger"}),
    "Ich bin ein Oger!",
    "antwortet: ");

  AddInfo( ({"posey","posey olivenwein","olivenwein","anfuehrerin"}),
    "Posey ist meine Anfuehrerin! Sie beschuetzt uns, vor den Schatten.",
    "sagt: ");

  AddInfo( ({"schatten"}),
    "Die Schatten koennen hier nicht herein.",
    "sagt: ");

  SetProp(P_SPELLRATE,45);

  AddSpell(1,450,
    "Das Blut spritzt, als Dogroks Waffe in Dich eindringt!\n",
    "Das Blut spritzt, als Dogroks Waffe in @WEN eindringt!\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,550,
    "Dogrok verpasst Dir einen deftigen Kinnhaken!\n",
    "Dogrok verpasst @WEM einen deftigen Kinnhaken!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10,
  ({Name(WER, 1)+" versucht Dir die Kehle aufzuschlitzen!\n",
   "Das Blut spritzt, als Dogroks Waffe in Dich eindringt!\n",
   "Dogroks Kinnhaken geht meilenweit daneben.\n"
   }));

  SUID;

  CLONEME(METZELORGIE "weapon/zackenschwert");
  command("zuecke schwert");

}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "aergerlich":
    case "albern":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "fragt Dich: Wie waer's mit einem Bier zur Beruhigung?",
        "fragt "+capitalize(getuid(TP))+": Wie waer's mit einem Bier zur Beruhigung?",
        0);
      break;

    case "froh":
    case "neutral":
    case "nett":
      call_out("reaction", 0, TP,
        "fragt Dich: Wie waer's mit einem Mass Bier, zur Feier des Tages?",
        "fragt "+capitalize(getuid(TP))+": Wie waer's mit einem Mass Bier, zur Feier des Tages?",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt: Lass das! Trink lieber ein Bier.",
        "sagt zu "+capitalize(getuid(TP))+": Lass das! Trink lieber ein Bier.",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "fragt Dich: Wie waer's mit einem Bier zur Aufmunterung?",
        "fragt "+capitalize(getuid(TP))+": Wie waer's mit einem Bier zur Aufmunterung?",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  LOGMASTER->LogFile("specialnpcdeaths", TO->name(RAW), TP);
  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) LOGMASTER->LogFile("playerdeaths", killer->name(RAW), player, lostexp);
}