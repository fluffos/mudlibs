// Schattenflughund
// Schattenwelt
// Von Wraz / Mendralim

#include "../def.h"
inherit "/std/npc/spells";
inherit "std/npc";
inherit NPC "npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  diff_int = difficulty_int(env_room_no());

  SetProp(P_SHORT, "Ein Schattenflughund");
  SetProp(P_LONG,
    "Diese Kreatur ist eine riesige, aus den Schatten geformte Fledermaus. Das "
    "Furchterregendste an ihr sind ihre tatsaechlich rot gluehenden Augen! Die "
    "erste und einzige Farbe in dieser duesteren, grauen Umgebung.");

  AddDetail( ({"augen"}),
    "Im Kontrast zu der ansonsten vollkommen schwarz-weissen Schattenwelt "
    "wirken die rot gluehenden Augen des Schattenflughunds dermassen "
    "abartig schaurig, dass Du vor Angst nahezu erstarrst!");

  SetProp(P_NAME, "Schattenflughund");
  SetProp(P_GENDER, MALE);
  AddId(({"schattenflughund","flughund","fledermaus"}));

  create_default_shadownpc(32+random(3),0,0,15000);
  
  SetProp(P_MAX_HP, 400+QueryProp(P_MAX_HP)); // mindestens 400 HP

  AddClass( ({CL_ANIMAL, CL_FLYING}) );

  SetProp(P_HANDS, ({" mit seinem Gebiss", QueryProp(P_HANDS)[1] , ({DT_RIP}) }) );

  //SetProp(P_XP, (QueryProp(P_XP)*7)/4);

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 550+random(100));
  SetProp(P_WEIGHT, 2000000+random(400000));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_NOMAGIC,10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann @WEN nicht nehmen.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " zerfaellt schrill kreischend zu Schatten.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "spricht schrill in einer Dir unverstaendlichen Sprache.\n");

  AddInfo( ({""}),
  "","spricht schrill: ");

  SetChats(1,
  ({Name(WER,1)+" kreischt furchterregend!\n",
    "@@HideCalledByChat@@",
    "","","","","",""
   }));


  SetProp(P_SPELLRATE,20+5*diff_int);

  AddSpell(30, 150+150*diff_int,
    Name(WER,1)+" beisst Dich.\n",
    Name(WER,1)+" beisst @WEN.\n",
    DT_PIERCE, "Bite", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,
    "",
    "",
    DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );

  SUID;
}

// ------------------------------------------------------------------------------
string HideCalledByChat()
{
  npc::hide();
  return "";
}

// ------------------------------------------------------------------------------
void Bite(object enemy, int damage, mixed dam_type)
{
  int dam;

  if(random(enemy->QueryAttribute(A_INT)) < 5)
  {
    enemy->Message(BS(Name(WER,1)+" saugt Dir mit seinem Biss Magie ab."));
    dam = -10-random(30*diff_int);
    enemy->AddSp(dam);
    TO->AddHp(3*dam);
  }
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  DropShadowItems();
  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  CallPlayerDeathLog(player, killer, lostexp);
  //call_out("leiche_verwandeln",2+random(5));
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 //if(!is_clone(TO)) return;
}
