// Schattendrache
// Schattenwelt, NPC Endgegner Raum 99
// Von Wraz / Mendralim

#include "../def.h"
inherit "p/std/dragons/dragon";
inherit "/std/npc/spells";
inherit NPC "npc.lpc";

string default_short = "Vagghuthcerrvnippintaa, die schwarze, steinalte Schattendrachin, die Gnadenlose";

// ------------------------------------------------------------------------------
void EndInvisSpell()
{
  if(!QueryProp(P_SHORT)) 
  {
    SetProp(P_SHORT,default_short);
    SetProp(P_INVIS,0);
    if(TO && ENV(TO)) ENV(TO)->Message(BS("Eine kolossale, schattenhafte "
      "Gestalt wird ploetzlich sichtbar!"));
  }
}

// ------------------------------------------------------------------------------
void InvisSpell(object enemy, int damage, mixed dam_type)
{
  if(QueryProp(P_SHORT)) 
  {
    if(TO && ENV(TO)) ENV(TO)->Message(BS(Name(WER,1)+" verschmilzt mit den "
      "Schatten und wird unsichtbar."));
    SetProp(P_SHORT,0);
    SetProp(P_INVIS,1);
    if(find_call_out("EndInvisSpell") == -1) call_out("EndInvisSpell", 1200+random(400));
  }
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "Vagghuthcerrvnippintaa ist eine schwarze, steinalte Schattendrachin. Ihr Beiname, 'Die Gnadenlose', "
    "laesst nichts Gutes vermuten. Ihre koerperlichen Ausmasse sind unfassbar, wie ein drakonisches, "
    "schwarzes Rathaus erhebt sie sich vor Dir. Aus der Ferne sah sie wie ein riesiger, wilder Haufen "
    "vieler Schatten aus, wie ein dunkler Gewittersturm. Aus der Naehe erkennst Du ihre durchscheinenden, "
    "schattigen Schuppen und Fluegel, sowie den schwarzen, mit den Schatten scheinbar verschmelzenden "
    "Leib. Die boese Dunkelheit, die von ihr ausgeht, laesst Dir das Mark in den Knochen gefrieren.");

  AddDetail( ({"ausmasse"}),
    "Vagghuthcerrvnippintaa ist kolossal gross! Allein dadurch waere sie schon toedlich. Du willst "
    "Dir nicht ausmalen, was sie mir ihrer steinalten Drachenmagie noch zusaetzlich anrichten kann.");

  AddDetail( ({"drachenmagie"}),
    "Davon siehst Du nichts. Noch nichts.");
  
  AddDetail( ({"schuppen","fluegel"}),
    "Die Schuppen und Fluegel der Schattendrachin sind durchscheinend, schattig. Du kannst nur hoffen, dass "
    "sie ebenso sehr das Licht hasst, wie die anderen Schattenwesen. Mit normaler Gewalt wird "
    "sie kaum zu bezwingen sein.");

  SetProp(P_NAME, "Vagghuthcerrvnippintaa");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"vagghuthcerrvnippintaa", "schattendrachin", "drachin", "drache", "gnadenlose"}));
  AddAdjective( ({"schwarz","schwarze","steinalt","steinalte"}) );
  set_living_name("vagghuthcerrvnippintaa");

  create_default_shadownpc(40);
  create_default_dragon(1,12,0,46+random(10));

  SetProp(P_RESISTANCE_STRENGTHS, SHADOW_DEF_RESISTANCE_STR + 
   (["acid":-1,"magic":-0.3,"air":-0.3,"pierce":-0.3]) );

  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)*3);
  SetProp(P_XP, QueryProp(P_XP)*2);

  SetProp(P_NOMAGIC,20);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" zerschmettert @WEN.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " zerfaellt tosend zu unzaehligen Schatten.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "funkelt Dich dunkel an.\n");

  AddInfo( ({"gnade"}),
  "Dich einfach aus!","lacht ");

  AddInfo( ({""}),
  "","saeuselt: ");

  SetChats(1,
  ({Name(WER,1)+" bruellt markerschuetternd!\n",
    BS(Name(WER,1)+" lacht so kalt und boese, dass es Dir die Kehle zuschnuert."),
    BS(Name(WER,1)+" spricht mit tiefer Stimme, offensichtlich belustigt: Ihr wollt euch mir stellen?"),
    "@@HideCalledByChat@@",
    "","","","","",""
   }));

  SetAttackChats(10,
  ({Name(WER, 1)+" lacht: Du niederer, materieller Wurm! Was willst Du?\n",
   Name(WER, 1)+" laesst ein paralysierendes, roehrendes Bruellen los!\n",
   Name(WER, 1)+" bruellt: Ihr laecherlichen Kreaturen!\n"
   }));


  SetProp(P_SPELLRATE,40);

  AddDefaultSpell(30, 1250, DS_MASS_DAMAGE,
    Name(WER,1)+" trifft Dich mit ihrem gewaltigen Drachenschwanz.\n",
    Name(WER,1)+" trifft @WEN mit ihrem gewaltigen Drachenschwanz.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(5, 1000, DS_MASS_FEAR,
   BS(Name(WER,1)+" bruellt so gewaltig, dass Dir kurz schwarz vor Augen wird."));

  AddSpell(10,1,
    Name(WER,1)+" spricht tiefe, dunkle Worte und agiert viel schneller.\n",
    Name(WER,1)+" spricht tiefe, dunkle Worte und agiert viel schneller.\n",
    DT_MAGIC, "SpeedSpell", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(5,1,
    Name(WER,1)+" spricht mit tiefer, schattiger Stimme einen Zauber.\n",
    Name(WER,1)+" spricht mit tiefer, schattiger Stimme einen Zauber.\n",
    DT_MAGIC, "DarknessSpell", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(5,1,
    Name(WER,1)+" spricht mit tiefer, schattiger Stimme einen Zauber.\n",
    Name(WER,1)+" spricht mit tiefer, schattiger Stimme einen Zauber.\n",
    DT_MAGIC, "InvisSpell", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(1,1,
    "",
    "",
    DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );

  AddDefaultSpell(5, 900, DS_DISARM);

  AddDefaultSpell(5, 900, DS_CURSE_WEAPON);

  AddDefaultSpell(5, 900, DS_CURSE_ARMOUR);

  AddDefaultSpell(5, 900, DS_REDUCE_WC);

  AddDefaultSpell(5, 900, DS_REDUCE_AC);

  CLONEME(OBJ "dunkelzauber");
  CLONEME(OBJ "dunkelzauber");

  SUID;

  SetProp(P_INVIS, 1); // muss hier am Ende stehen, sonst sind die ganzen Name() Aufrufe "Jemand" :)
  if(!random(6)) EndInvisSpell(); // Manchmal ist sie gleich sichtbar
}

// ------------------------------------------------------------------------------
string HideCalledByChat()
{
  npc::hide();
  return "";
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
void DarknessSpell(object enemy, int damage, mixed dam_type)
{
  // Je mehr Dunkelzauber bereits aktiv sind, umso unwahrscheinlicher wird's
  if(!random(Count(TO,"\nshadow_darkness")-4)) CLONEME(OBJ "dunkelzauber");
}

// ------------------------------------------------------------------------------
void SpeedSpell(object enemy, int damage, mixed dam_type)
{
  TO->ModifySkillAttribute(TO,SA_SPEED,350+random(251),8+random(5));
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  object schuppen, start_room;

  schuppen = clone_object(OBJ "sdschuppe");
  schuppen->SetProp(P_AMOUNT, 3+random(3));
  schuppen->move(TO,2);

  DropShadowItems(10000000); // 1000% Chance-Basis (siehe npc.c)
  if(!random(20)) CLONEME("/d/astral/lamuerte/brunnen/armour/staubschild");
  if(!random(30)) CLONEME("/d/astral/lamuerte/brunnen/armour/feldherrenguertel");
  if(!random(40)) CLONEME("/d/astral/lamuerte/brunnen/armour/silmaril");
  if(!random(30)) CLONEME("/d/astral/lamuerte/brunnen/armour/kupferohrring");
  if(!random(2)) CLONEME(ARMOUR "schattenbeinkleid");
  if(!random(4)) CLONEME(ARMOUR "schattencape");
  if(!random(4)) CLONEME(ARMOUR "schattencape");
  if(!random(8)) CLONEME(ARMOUR "schattenarmreife");

  // Boss Resetzeit (siehe ROOM sn_template.c)
  if(start_room = find_object(ROOM + "sn" + RMASTER->get_lead_zeros(QueryProp("shadow_room_no"))))
    call_other(start_room, "SetProp", "last_boss_death", time());
  else DB(BS("Schattendrachin: Raum "+QueryProp("shadow_room_no")+" nicht gefunden!") );

  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  ::NotifyPlayerDeath(); // nur wegen create_default_dragon()
  CallPlayerDeathLog(player, killer, lostexp);
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 if(!is_clone(TO)) return;

 if(QueryProp(P_SHORT)) SetProp(P_SHORT,0);
 if(Count(TO,"\nshadow_darkness") <= 1)
 {
  CLONEME(OBJ "dunkelzauber");
  CLONEME(OBJ "dunkelzauber");
 } 
}
