// Schattendrachen Minions
// Schattenwelt
// Von Wraz / Mendralim

#include "../def.h"
inherit "p/std/dragons/dragon";
inherit "/std/npc/spells";
inherit NPC "npc.lpc";

int gender; // MALE = 1, FEMALE = 2
int age;
string age_adj;
string base_age_adj_part; // adjektivisches Partizip, Linksattribut :)
string age_adj_part; 
string *base_name;
string default_short;

void create()
{
  if(!is_clone(TO)) return;

  gender = 1+random(2); // MALE = 1, FEMALE = 2
  age = (int) (1+random(4)*random(2)+random(4)*random(2)+random(4)*random(2)+random(3)*(!random(3)));
  age_adj = ({"extrem jung","ganz jung","sehr jung","jung","jugendlich","erwachsen",
    "etwas aelter","alt","sehr alt","ganz alt","uralt"})[age-1];
  base_age_adj_part = (gender == 1 ? "er" : "e");
  age_adj_part = age_adj + base_age_adj_part; 
  base_name = ({"schattendrach"+(gender == 1 ? "e" : "in"), "drach"+(gender == 1 ? "e" : "in")});
  default_short = "Ein"+(gender == 1 ? "" : "e")+" "+age_adj_part+" Schattendrach"+(gender == 1 ? "e" : "in");

  ::create();

  SetProp(P_SHORT, (random(age) > 5 ? 0 : default_short));
  
  AddDetail( ({"schuppen","fluegel"}),
    "Die Schuppen und Fluegel sind durchscheinend, schattig.");

  SetProp(P_NAME, capitalize(base_name[0]));
  SetProp(P_NAME_ADJ, age_adj);
  SetProp(P_GENDER, gender);
  AddId(({"drache"})+base_name);
  AddAdjective( ({"schwarz"+base_age_adj_part,explode(age_adj_part," ")[0],explode(age_adj_part," ")[<1]}) );


  SetProp(P_LONG,
    Name(WER)+" sieht aus der Ferne wie ein wilder Haufen "
    "vieler Schatten aus, wie ein dunkler Gewittersturm. Aus der Naehe erkennst Du die durchscheinenden, "
    "schattigen Schuppen und Fluegel, sowie den schwarzen, mit den Schatten scheinbar verschmelzenden "
    "Leib. Eine Dunkelheit geht von diesem Wesen aus, dass Dir froestelt vor Schauder.");

  create_default_shadownpc(34+age/2);
  create_default_dragon(1,age,0,46+random(10));

  SetProp(P_RESISTANCE_STRENGTHS, SHADOW_DEF_RESISTANCE_STR + 
   (["acid":(float) -0.4-(0.1*age/2),"magic":-0.3,"air":-0.3,"pierce":-0.3]) );

  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)*2);

  SetProp(P_NOMAGIC,5+age);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" zerschmettert @WEN.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " zerfaellt zu unzaehligen Schatten.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "funkelt Dich dunkel an.\n");

  AddInfo( ({"gnade"}),
  "Dich einfach aus!","lacht ");

  AddInfo( ({""}),
  "","saeuselt: ");

  SetChats(1,
  ({Name(WER,1)+" bruellt!\n",
    BS(Name(WER,1)+" lacht kalt und boese."),
    "","","",""
   }));

  SetAttackChats(10,
  ({Name(WER, 1)+" lacht: Du Winzling!\n",
   Name(WER, 1)+" laesst ein roehrendes Bruellen los!\n"
   }));


  SetProp(P_SPELLRATE,20+age);

  if(age>=7) AddDefaultSpell(30, 1000+20*age, DS_MASS_DAMAGE,
    Name(WER,1)+" trifft Dich mit dem gewaltigen Drachenschwanz.\n",
    Name(WER,1)+" trifft @WEN mit dem gewaltigen Drachenschwanz.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  if(age>=9) AddDefaultSpell(5, 1000, DS_MASS_FEAR,
   BS(Name(WER,1)+" bruellt so gewaltig, dass Dir kurz schwarz vor Augen wird."));

  if(age>=6) AddSpell(10,1,
    Name(WER,1)+" spricht tiefe, dunkle Worte und agiert viel schneller.\n",
    Name(WER,1)+" spricht tiefe, dunkle Worte und agiert viel schneller.\n",
    DT_MAGIC, "SpeedSpell", ([SP_SHOW_DAMAGE:0]) );

  if(age>=6) AddSpell(5,1,
    Name(WER,1)+" spricht mit tiefer, schattiger Stimme einen Zauber.\n",
    Name(WER,1)+" spricht mit tiefer, schattiger Stimme einen Zauber.\n",
    DT_MAGIC, "DarknessSpell", ([SP_SHOW_DAMAGE:0]) );

  if(age>=7) AddSpell(5,1,
    Name(WER,1)+" spricht mit tiefer, schattiger Stimme einen Zauber.\n",
    Name(WER,1)+" spricht mit tiefer, schattiger Stimme einen Zauber.\n",
    DT_MAGIC, "InvisSpell", ([SP_SHOW_DAMAGE:0]) );

  if(age>=8) AddDefaultSpell(5, 700+10*age, DS_DISARM);

  if(age>=4) AddDefaultSpell(5, 700+10*age, DS_CURSE_WEAPON);

  if(age>=7) AddDefaultSpell(5, 700+10*age, DS_CURSE_ARMOUR);

  if(age>=7) AddDefaultSpell(5, 700+10*age, DS_REDUCE_WC);

  if(age>=8) AddDefaultSpell(5, 700+10*age, DS_REDUCE_AC);

  if(age>=8) CLONEME(OBJ "dunkelzauber");
  if(age>=9) CLONEME(OBJ "dunkelzauber");

  SUID;
}

// ------------------------------------------------------------------------------
void EndInvisSpell()
{
  if(!QueryProp(P_SHORT)) 
  {
    SetProp(P_SHORT,default_short);
    SetProp(P_INVIS,0);
    if(TO && ENV(TO)) ENV(TO)->Message(BS("Eine schattenhafte "
      "Gestalt wird ploetzlich sichtbar!"));
  }
}

// ------------------------------------------------------------------------------
void InvisSpell(object enemy, int damage, mixed dam_type)
{
  if(QueryProp(P_SHORT)) 
  {
    if(TO && ENV(TO)) ENV(TO)->Message(BS(Name(WER,1)+" verschmilzt mit den "
      "Schatten und wird unsichtbar."));
    SetProp(P_SHORT,0);
    SetProp(P_INVIS,1);
    if(find_call_out("EndInvisSpell") == -1) call_out("EndInvisSpell", 1200+random(400));
  }
}

// ------------------------------------------------------------------------------
void DarknessSpell(object enemy, int damage, mixed dam_type)
{
  // Je mehr Dunkelzauber bereits aktiv sind, umso unwahrscheinlicher wird's
  if(!random(Count(TO,"\nshadow_darkness")-4)) CLONEME(OBJ "dunkelzauber");
}

// ------------------------------------------------------------------------------
void SpeedSpell(object enemy, int damage, mixed dam_type)
{
  TO->ModifySkillAttribute(TO,SA_SPEED,100+20*age+random(251),8+random(5));
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  object schuppen;

  if(random(age) >= 7 || !random(100))
  {
    schuppen = clone_object(OBJ "sdschuppe");
    schuppen->SetProp(P_AMOUNT, 1+random(age/2));
    schuppen->move(TO,2);
  }

  DropShadowItems();
  if(age>=9 && !random(3)) CLONEME("/d/astral/lamuerte/brunnen/armour/staubschild");
  if(age>=9 && !random(4)) CLONEME("/d/astral/lamuerte/brunnen/armour/feldherrenguertel");
  if(age>=9 && !random(5)) CLONEME("/d/astral/lamuerte/brunnen/armour/silmaril");
  if(age>=9 && !random(4)) CLONEME("/d/astral/lamuerte/brunnen/armour/kupferohrring");
  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  ::NotifyPlayerDeath(); // nur wegen create_default_dragon()
  CallPlayerDeathLog(player, killer, lostexp);
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 if(!is_clone(TO)) return;

 if(QueryProp(P_SHORT)) SetProp(P_SHORT,0);
 if(Count(TO,"\nshadow_darkness") <= 1)
 {
  CLONEME(OBJ "dunkelzauber");
  CLONEME(OBJ "dunkelzauber");
 } 
}
