// Schattenrabe
// Schattenwelt
// Von Wraz / Mendralim

#include "../def.h"
inherit "/std/npc/spells";
inherit "/p/std/npc/nekro_npc"; // um von Nekros beherrscht werden zu koennen
inherit NPC "npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schattenrabe");
  SetProp(P_LONG,
    "Der Schattenrabe traegt schattig-schwarze Federn und wirkt sehr unheimlich. "
    "Er ist von Schatten umgeben, die staendig aus ihm herauszuwabern scheinen. "
    "Seine matten, und dennoch glaenzenden weissen Augen starren Dich hohl an.");

  AddDetail( ({""}),
    "");

  SetProp(P_NAME, "Schattenrabe");
  SetProp(P_GENDER, MALE);
  AddId(({"schattenrabe","rabe"}));

  create_default_shadownpc(24+random(3),0,0,4000); // level, maxhp, incorp, hplimit = 4000

  SetProp(P_MAX_HP, 150+QueryProp(P_MAX_HP)); // mindestens 150 HP

  AddClass( ({CL_ANIMAL, CL_FLYING}) );

  SetProp(P_HANDS, ({" mit schattigen Krallen", QueryProp(P_HANDS)[1] , ({DT_RIP}) }) );

  //SetProp(P_XP, (QueryProp(P_XP)*7)/4);

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 50+random(10));
  SetProp(P_WEIGHT, 2000+random(500));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_NOMAGIC,10);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann @WEN nicht nehmen.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " zerfaellt zu Schatten.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "ruft tief: Kroh, kroh.\n");

  AddInfo( ({""}),
  "","ruft: ");

  SetChats(1,
  ({Name(WER,1)+" ruft: Aak, aak.\n",
    "@@HideCalledByChat@@",
    "","","","","",""
   }));


  SetProp(P_SPELLRATE,20);

  AddSpell(30, 150+room_no,
    Name(WER,1)+" pickt in Deine Augen.\n",
    Name(WER,1)+" pickt @WEM in die Augen.\n",
    DT_PIERCE, "AttackEyes", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,
    "",
    "",
    DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );

  SUID;
}

// ------------------------------------------------------------------------------
string HideCalledByChat()
{
  npc::hide();
  return "";
}

// ------------------------------------------------------------------------------
void AttackEyes(object enemy, int damage, mixed dam_type)
{
  if(random(enemy->QueryAttribute(A_DEX)) < 5)
  {
    enemy->Message(BS(Name(WER,1)+" zerhackt Deine Augen. Du bist blind."));
    enemy->SetProp(P_BLIND, ([BLIND_TIME:30,
      BLIND_MSG:"Deine Augaepfel sind vollkommen zerhackt, Du siehst nichts!\n",
      BLIND_END_MSG:"Deine Augen heilen und Du kannst wieder sehen!\n"]));
  }
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  DropShadowItems();
  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  CallPlayerDeathLog(player, killer, lostexp);
  //call_out("leiche_verwandeln",2+random(5));
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 //if(!is_clone(TO)) return;
}
