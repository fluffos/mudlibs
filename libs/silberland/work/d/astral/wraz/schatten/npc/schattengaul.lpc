// ------------------------------------------------------------------------------
void CheckEnvDamage()
{
  int dmg;

  if(!TO || !ENV(TO)) return;

  if(find_call_out("CheckEnvDamage")==-1) call_out("CheckEnvDamage",600+random(60));

  // Ausserhalb der Schattenwelt bzw der Astralwelt nimmt der Schattengaul Schaden
  // -> ausserhalb Astral, viel Schaden
  if (strstr(file_name(ENV(TO)), "/d/astral/") == -1)
  {
    ENV(TO)->Message(BS(Name(WER)+" wiehert stoerrisch und schwer leidend in dieser realen Umgebung."),
        MSGFLAG_SOUND);
    dmg=(-25-random(130)); // 157 HP_MAX ueberleben das fix (siehe oben)
  }

  // -> ausserhalb Schatten, aber innerhalb Astral, weniger Schaden
  else if (strstr(file_name(ENV(TO)), "/d/astral/wraz/schatten/") == -1)
  {
    ENV(TO)->Message(BS(Name(WER)+" wiehert stoerrisch und leidend in dieser schattenarmen Welt."),
        MSGFLAG_SOUND);
    dmg=(-15-random(70)); // 86 HP HP_MAX ueberleben das fix (siehe oben)
  }

  TO->AddHp(dmg);
  if(dmg && TO->QueryProp(P_HP) <= 1) TO->die();
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 if(!is_clone(TO)) return;
 if(find_call_out("CheckEnvDamage")==-1) call_out("CheckEnvDamage",600+random(60));
}
