// Schattenwelt
// von Wraz / Mendralim
//
// Liseth, Haendlerin

#include "../def.h"
inherit "std/npc";
inherit "/std/npc/spells";

#define LBS(x) break_string(x, 78, "Liseth sagt: ", 1)

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Liseth, die Haendlerin");
  SetProp(P_LONG,
    "Liseth ist die Haendlerin des Lagers. Sie ist eine Halbelfe mit "
    "langem, blondem Haar und leicht zugespitzten Ohren. Liseth blickt Dich freundlich "
    "an, zugleich faellt Dir auf, dass sie stets aufmerksam ist." );

  SetProp(P_NAME, "Liseth");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"halbelf", "halbelfe", "liseth", "haendlerin", "Messermeister", "NOWIMPY", "Krieger"}));
  set_living_name("liseth");
  SetProp(P_ARTICLE, 0);

  create_default_npc(42);

  SetProp(P_HANDS, ({" mit ihren Faeusten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON}) }));

  SetProp(P_RACE, "Halbelf");
  SetProp(P_SIZE, 190);
  SetProp(P_WEIGHT, 70000);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" nimmt das nicht!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "sieht Dich freundlich an.\n");

  AddInfo( ({"halbelfe","halbelfen","halbelf"}),
    "Ich bin eine Halbelfe!",
    "antwortet: ");
  
  AddInfo( ({"schatten","schattenwelt"}),
    "Duester und grau ist es hier, nicht wahr? Mir fehlt die Sonne am meisten.",
    "seufzt: ");

  AddInfo( ({"sonne"}),
    "Ich kann mich kaum erinnern, wie sich ihre Waerme auf der Haut anfuehlt. Traurig.",
    "sagt: ");

  AddInfo( ({"waerme"}),
    "Hier in den Schatten ist es immer gleichmaessig kuehl.",
    "sagt: ");

  AddInfo( ({"dogrok"}),
    "Dogrok der Ogerwirt! Ich mag sein Bier nicht wirklich, aber welche Wahl habe ich schon?",
    "sagt: ");

  AddInfo( ({"bier"}),
    "Wein waere mir viel lieber, oder Traubensaft.",
    "sagt: ");

  AddInfo( ({"wein","traubensaft"}),
    "Wein oder Traubensaft waeren grossartig. Aber hier wuerden sie ohnehin fad schmecken.",
    "sagt: ");

  AddInfo( ({"tod"}),
    "Der Tod wird uns alle ereilen. Wieso fragst Du?",
    "sagt: ");
  
  AddInfo( ({"ausweg","ausgang"}),
    "Welchen meinst Du? Einen Ausgang aus der Schattenwelt etwa?",
    "sagt: ");

  AddInfo( ({"ausgang aus der schattenwelt","auweg aus der schattenwelt",
    "ausgang aus schattenwelt","ausweg aus schattenwelt",
    "schattenwelt ausgang","schattenwelt ausweg"}),
    "Ich kenne niemanden, der die Schattenwelt lebend verlassen hat.",
    "sagt: ");

  AddInfo( ({"wraz"}),
    "Wraz ist ein maechtiger Magier. Angeblich zeigen sich seine Avatare hier in den Schatten "
    "manchmal, aber ich glaube es nicht.",
    "sagt: ");

  AddInfo( ({"avatare","avatar"}),
    "Es gibt nur Geruechte, ich kenne niemanden dem ich traue, der je wirklich einen "
    "Avatar von Wraz gesehen haette.",
    "sagt: ");

  AddInfo( ({"geruechte","geruecht"}),
    "Die Geruechte sagen, dass ein oder mehrere Avatare von Wraz weit im Norden gesehen wurden. "
    "Sie sollen uebermaechtig sein, unmoeglich zu bezwingen. Je nach Laune spielen sie mit "
    "ihren Gegnern, also falls man verrueckt genug ist, sich mit ihnen anzulegen. Sie lassen "
    "einen im Glauben, eine Chance zu haben, nur um dann gelangweilt einen Blitz vom Himmel zu "
    "beschwoeren. Ich halte das alles fuer Unfug.",
    "sagt: ");

  AddInfo( ({"gegner"}),
    "Willst Du Dich etwa einem Avatar stellen? Er wuerde Dich vernichten, ohne Dich auch nur "
    "anzublicken! Ich meine, sofern er tatsaechlich existiert, was ich fuer Unfug halte.",
    "lacht: ");

  AddInfo( ({"laune","unfug"}),
    "Geh doch nach Norden, so weit Du kannst. Du waerst nicht der erste, der nie wieder gesehen "
    "wird.",
    "sagt: ");

  AddInfo( ({"schattenpanzer"}),
    "Ein Schattenpanzer ist eine maechtige Ruestung! Er kann Dich regenerieren, permanent. "
    "Das kostet Dich aber einiges an Erfahrung. Leider sind Schattenpanzer auch nicht sehr "
    "stabil und loesen sich nach zwei bis drei Monaten auf. Ihre Schutzwirkung ist auch "
    "begrenzt, aber erstaunlich, wenn man bedenkt, dass sie aus purem Schatten bestehen.",
    "sagt: ");

  AddInfo( ({"posey","olivenwein","posey olivenwein","veteranin"}),
    "Posey Olivenwein ist die Leiterin, die Anfuehrerin hier im Lager. Sie kam als erste "
    "hierher und hat diesen Stuetzpunkt, der einzige bekannte, aufgebaut. Sie ist eine "
    "Veteranin, doch ihre Geschichte ist eine traurige.",
    "sagt: ");
  
  AddInfo( ({"leiterin","anfuehrerin"}),
    "Unsere Leiterin hier im Schattenlager ist Posey Olivenwein, die Fee.",
    "sagt: ");

  AddInfo( ({"lager","schattenlager","stuetzpunkt"}),
    "Dieses Lager ist das einzige bekannte hier in den Schatten. Posey Olivenwein "
    "hat es gegruendet.",
    "sagt: ");

  AddInfo( ({"geschichte"}),
    "Welche meinst Du? Die Geschichte von Posey?",
    "sagt: ");

  AddInfo( ({"geschichte von posey"}),
    "Ich vertraue Posey, und sie mir. Ich kann Dir nicht mehr sagen. Wenn sie Dir ihre "
    "Geschichte nicht erzaehlen moechte, wer waere ich, sie an ihrer statt zu erzaehlen?",
    "sagt: ");

  AddInfo( ({"adaldria","flinkfuss","adaldria flinkfuss"}),
    "Soso, Du kennst also die wahre Identitaet von Posey? Dann kennst Du wohl auch ihre "
    "traurige Geschichte.",
    "sagt: ");
  
  AddInfo( ({"geschichte von adaldria"}),
    "Es ist eine traurige. Doch dass Adaldria nun hier ist und uns an diesem duesteren Ort "
    "leitet und beschuetzt, dafuer bin ich dankbar.",
    "sagt: ");

  AddInfo( ({"liseth", "haendlerin"}),
    "Ja, was kann ich fuer Dich tun?",
    "sagt: ");

  AddInfo( ({"reparatur","reparieren"}),
    "Ich kann Waffen und Ruestungen fuer Dich reparieren. Probier' es mit "
    "'repariere <gegenstand>'.",
    "sagt: ");

  AddInfo( ({""}),
    "",
    "sagt: ");

  SetProp(P_SPELLRATE,45);

  AddSpell(3,650,
    "Das Blut spritzt, als Liseths Waffe Dich aufschlitzt!\n",
    "Das Blut spritzt, als Liseths Waffe @WEN aufschlitzt!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,850,
    "Liseth steht ploetzlich hinter Dir und rammt ihren Dolch in Deinen Leib!\n",
    "Liseth rammt @WEM ihren Dolch von hinten in den Leib!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2,750,DS_BLIND,
    "Liseth sticht Dir ins Auge!\n",
    "Liseth sticht @WEM ins Auge!\n");

  AddDefaultSpell(1,350,DS_MASS_FEAR,
    "Liseth stoesst wie aus dem Nichts einen markerschuetternden Schrei aus!\n");

  SetAttackChats(10,
  ({Name(WER, 1)+" versucht Dir die Kehle aufzuschlitzen!\n",
   "Das Blut spritzt, als Liseth Waffe Dich aufschlitzt!\n",
   "Liseths Angriff auf Dein Auge geht daneben. Glueck gehabt.\n"
   }));

  SUID;

  CLONEME("/p/weapon/knife/meucheldolch");
  command("zuecke dolch");

  AddCmd(({"repariere", "reparier"}), "repair");
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "aergerlich":
    case "albern":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "fragt Dich: Willst Du nicht lieber etwas kaufen, statt hier herum zu bloedeln?",
        "fragt "+capitalize(getuid(TP))+": Willst Du nicht lieber etwas kaufen, statt hier herum zu bloedeln?",
        0);
      break;

    case "froh":
    case "neutral":
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+capitalize(getuid(TP))+" an.",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "sagt streng: Hoer auf damit!",
        "sagt streng zu "+capitalize(getuid(TP))+": Hoer auf damit!",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "laechelt Dich aufmunternd an.",
        "laechelt "+capitalize(getuid(TP))+" aufmunternd an.",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  LOGMASTER->LogFile("specialnpcdeaths", TO->name(RAW), TP);
  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) LOGMASTER->LogFile("playerdeaths", killer->name(RAW), player, lostexp);
}

// ------------------------------------------------------------------------------
// Vorlage: /d/ebene/Midas/room/experte.c
int repair(string str)
{
  object ob;
  int dam, wert, maxwert, damrest, preis, damrest_pct;

  if(InFight())
  {
    write(BS("Im Kampf ist Liseth aber wirklich viel zu beschaeftigt, um sich um "
        "Reparaturen zu kuemmern!"));
    return 1;
  }
  if(TP->InFight())
  {
    write(BS("Im Kampf bist Du viel zu beschaeftigt, um Dich um Reparaturen zu "
        "kuemmern!"));
    return 1;
  }

  notify_fail("Was willst Du reparieren lassen?\n");
  if (!str || !stringp(str)) return 0;
  if (!ob=present(str,TP)) {
    write(LBS("So etwas hast Du ja gar nicht dabei!\n"));
    return 1;
  }
  dam = ob->QueryProp(P_DAMAGED);
  if (ob->QueryProp(P_WEAPON_TYPE)) {
    write(LBS("Okay, ich sehe mir das einmal kurz an..."));
    wert=ob->QueryProp(P_WC);
    damrest_pct=3+random(3);
    preis=250;   // Multiplikator
  }
  else if (ob->QueryProp(P_ARMOUR_TYPE)) {
    write(LBS("Zeig' mal her..."));
    wert=ob->QueryProp(P_AC);
    damrest_pct=4+random(2);
    preis=1000;  // Multiplikator
  }
  else {
    write(LBS("Damit kenne ich mich leider nicht aus. Aber mit Ruestungen "
      "und Waffen kann ich Dir helfen."));
    return 1;
  }
  write(TO->Name(WER)+" sieht sich "+ob->name(WEN,1)+" genau an.\n");
  maxwert = wert + dam;
  damrest = (maxwert * damrest_pct) / 100;
  if (damrest<1) damrest=1;
  if (dam <= damrest) {
    write(LBS("Die Schaeden an "+ob->name(WEM,1)+" sind sehr gering, "
        "die Reparatur wuerde sich kaum lohnen."));
    return 1;
  }
  preis=preis*(dam-damrest);
  write(LBS("Die Reparatur "+ob->name(WESSEN,1)+" wuerde Dich "+
      preis+" Muenzen kosten."));
  write("Willst Du sie durchfuehren lassen? (ja/nein) -> ");
  input_to("repair2", 0, ob, dam, dam-damrest, preis, time());
  return 1;
}

// ------------------------------------------------------------------------------
void repair2(string str, object ob, int dam, int damrep, int preis, int zeit)
{
  if (!TP) return;
  if (environment(TP) != ENV(ME)) {  // Spieler mit !bla rausgegangen...?
    write("Dazu ist es jetzt zu spaet!\n");
    return;
  }
  if (time() > (zeit+15))       // 15 Sekunden Zeit
  {
    write(LBS("Du hast Dir zuviel Zeit gelassen! Ueberlege es Dir "
        "noch einmal. Mein Angebot gilt aber weiterhin."));
    return;
  }
  if ((str!="ja") && (str!="j")) {
    write(LBS("In Ordnung, dann halt nicht."));
    return;
  }
  if (!ob) {
    write(LBS("Hm, der Gegenstand ist ja ploetzlich nicht mehr da?"));
    return;
  }
  if (environment(ob) != TP) {
    write(LBS("Hm, wo "+(ob->IsPlural() ? "sind" : "ist")+" denn "+
          ob->name(WER,1)+" auf einmal hin?"));
    return;
  }
  if (dam != ob->QueryProp(P_DAMAGED)) {
    write(LBS("Seltsam, "+ob->name(WER,1)+
          (ob->IsPlural() ? " sind" : " ist")+
          (dam > ob->QueryProp(P_DAMAGED) ?
                    " gar nicht mehr so schlimm" :
                    " auf einmal viel schlimmer")+
          " beschaedigt! Da muss ich mein Angebot ueberdenken."));
    return;
  }
  if (TP->QueryMoney() < preis) {
    write(LBS("Aber Du hast doch gar keine "+preis+" Muenzen "
        "dabei! Das wird nichts."));
    return;
  }
  TP->AddMoney(-preis);
  "/p/daemon/zentralbank"->PayIn(preis);
  ob->Damage(-damrep);
  write(BS(TO->Name(WER)+" nimmt Dir "+preis+" Muenzen ab und beginnt "
      "mit der Reparatur "+ob->name(WESSEN,1)+". Kurze Zeit spaeter ist "
      +TO->QueryPronoun()+" fertig und drueckt Dir "+ob->QueryPronoun(WEN)+" in viel "
      "besserem Zustand als zuvor in die Haende."));
}

