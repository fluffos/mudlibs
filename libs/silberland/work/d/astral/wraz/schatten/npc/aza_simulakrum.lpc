// ------------------------------------------------------------------------------
int CmdTauschen(string str)
{
  string obj1_name, obj2_name;
  object rolle, auge;
  int i;

  if(!str || str == "") return 0;
  if(sscanf(str, "%s gegen %s", obj1_name, obj2_name) != 2) return 0;

  rolle = clone_object(OBJ "portalrolle");

  if((auge=present("\nbrandisborgelauge",TP)) 
      &&
     (rolle->id(obj1_name) || rolle->id(obj1_name+"n") ||
      rolle->id(obj2_name) || rolle->id(obj2_name+"n")) 
      &&
     (auge->id(obj1_name) || auge->id(obj1_name+"n") ||
      auge->id(obj2_name) || auge->id(obj2_name+"n")))
  {
    ENV(TP)->Message(BS(Name(WER)+" sagt: Wunderbar, eine tolle Materialkomponente! Hier hast Du "
      "die versprochenen Schriftrollen."));
    
    for(i=0;i<9;i++)
    {
      CLONEME(OBJ "portalrolle");
      command_me("gib "+lower_case(TPN)+" portalrolle");
      command_me("wirf portalrolle weg");
    }

    auge->remove();
    return 1;
  }

  else if(!auge)
  {
    TP->Message(BS(Name(WER)+" sagt: Hm, Du hast aber gar kein Auge!"));
    ENV(TP)->Message(BS(Name(WER)+" sagt zu "+TPN+": Hm, Du hast aber gar kein Auge!"),MSGFLAG_NO_TP);
    return -1;
  }

  else
  {
    TP->Message(BS(Name(WER)+" sagt: Ich kann Dir im Tausch nur Schattenportalschriftrollen "
      "fuer Brandisborgels Auge anbieten."));
    ENV(TP)->Message(BS(Name(WER)+" sagt zu "+TPN+": Ich kann Dir im Tausch nur Schattenportalschriftrollen "
      "fuer Brandisborgels Auge anbieten."),MSGFLAG_NO_TP);
    return -1;
  }
}

// ------------------------------------------------------------------------------
string _query_info()
{
  if(TP->QueryAttribute(A_INT) >= 35 ||
    (TP->QueryAttribute(A_INT) >= 30 && random(2)))
    return BS("Von Aza geht ein ganz schwacher, kuehler Luftzug aus. Irgendetwas "
      "stimmt nicht.");
  else return BS("Aza ist eine maechtige Zauberin, sei sehr vorsichtig!");
}

// ------------------------------------------------------------------------------
int _query_size()
{
  return current_size;
}

// ------------------------------------------------------------------------------
string _query_short()
{
  string str;

  str = "Aza";

  if(is_class_member(CL_FLYING)) str += " (fliegend)";
  if(current_size != default_size) str += " (winzig)";
  
  return str;
}

// ------------------------------------------------------------------------------
void EndReducePerson()
{
  if(current_size != default_size) 
  {
    current_size = default_size;
    ENV(TO)->Message(BS(Name(WER, 1)+" wird wieder normal gross."),MSGFLAG_VISUAL);
  }
}

// ------------------------------------------------------------------------------
void ReducePerson(object enemy, int damage, mixed dam_type)
{
  if(current_size == default_size)
  {
    current_size = 9+random(3);
    ENV(TO)->Message(BS(Name(WER, 1)+" wirkt einen Zauber und schrumpft stark."),
      MSGFLAG_VISUAL);
    if(find_call_out("EndReducePerson") == -1) call_out("EndReducePerson",120+random(12));
  }
}

// ------------------------------------------------------------------------------
string ReducePersonCalledByChat()
{
  ReducePerson(0,0,0);
  return "";
}

// ------------------------------------------------------------------------------
void EndFly()
{
  if(is_class_member(CL_FLYING)) 
  {
    RemoveClass(({CL_FLYING}));
    ENV(TO)->Message(BS(Name(WER, 1)+" landet am Boden und fliegt nicht mehr."),MSGFLAG_VISUAL);
  }
}

// ------------------------------------------------------------------------------
void Fly(object enemy, int damage, mixed dam_type)
{
  if(!is_class_member(CL_FLYING))
  {
    AddClass( ({CL_FLYING}) );
    ENV(TO)->Message(BS(Name(WER, 1)+" wirkt einen Zauber und hebt magisch fliegend ab."),
      MSGFLAG_VISUAL);
    if(find_call_out("EndFly") == -1) call_out("EndFly",60+random(6));
  }
}

// ------------------------------------------------------------------------------
string FlyCalledByChat()
{
  Fly(0,0,0);
  return "";
}

// ------------------------------------------------------------------------------
void Disintegrate(object enemy, int damage, mixed dam_type)
{
  if(!enemy->QueryProp(P_HP)) enemy->SetProp("last_disintegrate",time());
  if(!enemy->QueryProp(P_HP)) DB(" disintegrate function\n");
  if(!enemy->QueryProp(P_HP)) DB(BS("  hp: "+enemy->QueryProp(P_HP)+" time: "+time()));
}

// ------------------------------------------------------------------------------
int ReturnHome()
{
  call_other(ROOM "turm_1","???");

  if(ENV(TO) != find_object(ROOM "turm_1") && QueryProp(P_HP) >= QueryProp(P_MAX_HP)/2)
    {
      ENV(TO)->Message(BS(Name()+" teleportiert sich davon!"),
        MSGFLAG_VISUAL);
      move(ROOM "turm_1",M_NOCHECK+M_SILENT);
      (ROOM "turm_1")->Message(BS(Name()+" teleportiert herein."),
        MSGFLAG_VISUAL);
      return 1;
    }
  else 
  {
    if(find_call_out("ReturnHome")==-1) call_out("ReturnHome",120+random(120));
    return 0;
  }
}

// ------------------------------------------------------------------------------
int Flee_()
{
  int room_nr;

  room_nr = AZA_ROOM - random(4) + random(8);

  if(!read_file(ROOM "sn"+room_nr)) RMASTER->write_next_room(ROOM "sn"+room_nr,"norden");
  call_other(ROOM "sn"+room_nr,"???");
  if(!find_object(ROOM "sn"+room_nr))
  {
    write("ERROR: room not found!\n");
    return 0;
  }

  ENV(TO)->Message(BS(Name()+" teleportiert sich davon!"),
      MSGFLAG_VISUAL);

  move(ROOM "sn"+room_nr,M_NOCHECK+M_SILENT);

  (ROOM "sn"+room_nr)->Message(BS(Name()+" teleportiert herein."),
    MSGFLAG_VISUAL);

  if(find_call_out("ReturnHome")==-1) call_out("ReturnHome",120+random(120));

  return 1;
}

//--Defend--------------------------------------------------------------
int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  //if(!random(4)) TO->ModifySkillAttribute(TO,SA_SPEED,150+random(151),6+random(5));

  // Flucht bei wenig HP
  if(QueryProp(P_HP) <= (QueryProp(P_MAX_HP)/5) && !random(3) && find_call_out("Flee_") == -1)
    call_out("Flee_",0);


  if(current_size < default_size && (random(3)))
  {
    dam /= 10;
    enemy->Message(BS(Name()+" ist so klein, dass Du sie kaum treffen kannst!"));
    ENV(enemy)->Message(BS(Name()+" ist so klein, dass "+enemy->Name(WER)+" sie kaum trifft!"),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ enemy }) ]));
  }

  if(is_class_member(CL_FLYING) && (random(3)))
  {
    dam /= 5;
    enemy->Message(BS(Name()+" weicht fliegend geschickt aus!"));
    ENV(enemy)->Message(BS(Name()+" weicht "+enemy->Name(WEM)+" fliegend aus!"),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ enemy }) ]));
  }

  // Trigger Fly() and ReducePerson()
  if(!is_class_member(CL_FLYING) && current_size == default_size && random(2))
  {
    if(find_call_out("Fly") == -1) 
      call_out("Fly",3,0,0,0);
    if(find_call_out("ReducePerson") == -1) 
      call_out("ReducePerson",3,0,0,0);
  }
  else if(!is_class_member(CL_FLYING) && find_call_out("Fly") == -1) 
    call_out("Fly",3,0,0,0);
  else if(current_size == default_size && find_call_out("ReducePerson") == -1) 
    call_out("ReducePerson",3,0,0,0);

  return ::Defend(dam, dtypelist, spell, enemy);
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "aergerlich":
    case "albern":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "fragt Dich: Was soll das?",
        "fragt "+capitalize(getuid(TP))+": Was soll das?",
        0);
      break;

    case "froh":
    case "neutral":
    case "nett":
      call_out("reaction", 0, TP,
        "nickt.",
        "nickt.",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "faehrt Dich scharf an: Nein!",
        "faehrt "+capitalize(getuid(TP))+" scharf an: Nein!",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt: Kopf hoch!",
        "sagt zu "+capitalize(getuid(TP))+": Kopf hoch!",
        0);
      break;
  }
}

// ------------------------------------------------------------------------------
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

// ------------------------------------------------------------------------------
void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

// ------------------------------------------------------------------------------
void init()
{
  ::init();
  //if(TP && TP->id("\nposeyfriends")) AddDefender(TP);
}

// ------------------------------------------------------------------------------
void InformDefend(object enemy)
{
  if(!random(3)) command_me("sag Vernichtet "+enemy->Name(WEN)+"!");
  Kill(enemy);
}

// ------------------------------------------------------------------------------
void reset()
{
  ::reset();
  if(!is_clone(TO)) return;
}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  object ob;

  // Logging
  LOGMASTER->LogFile("specialnpcdeaths", "aza_simulakrum", TP);

  // "last_aza_deathtime" -> reloads only every 24h
  call_other(ROOM "turm_1","SetProp","last_aza_deathtime",time());

  if(random(4)) CLONEME(OBJ "schattenlinse");
  if(random(2)) CLONEME(OBJ "portalrolle");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 9000+random(210)*10);
  ob->move(TO);

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void DisintegrateCorpse(object player, object killer, int lostexp)
{
  object corpse;

  // Leiche disintegrieren?
  corpse = present("Leiche",ENV(TO));
  DB(player->QueryProp("last_disintegrate")-time()+"\n");
  DB(" 1\n");
  if (!corpse) return;
  DB(" 2\n");
  if (file_name(corpse)[0..10] != "/std/corpse") return;
  DB(" 3\n");
  if (player->QueryProp("last_disintegrate") - time() != 0) return; // Disintegrate hat den Tod nicht verursacht
  DB(" 4\n");

  ENV(TO)->Message(BS(
    player->Name(WESSEN)+" Koerper wird vollstaendig zu einem Haeufchen Asche disintegriert."),MSGFLAG_VISUAL,
    ([ MSGFLAG_EXCLUDE : ({ player }) ]));
  player->Message(BS(
    "Dein Koerper wird vollstaendig zu einem Haeufchen Asche disintegriert."));
  corpse->remove();
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) LOGMASTER->LogFile("playerdeaths", "aza_simulakrum", player, lostexp);

  // Braucht ein call_out, damit Disintegrate() vorher ausgefuehrt werden kann (Reihenfolge)
  if(find_call_out("DisintegrateCorpse")==-1) call_out("DisintegrateCorpse",0,player,killer,lostexp);
}


// ------------------------------------------------------------------------------
// Vorlage: /d/ebene/Midas/room/experte.c
int repair(string str)
{
  object ob;
  int dam, wert, maxwert, damrest, preis;

  if(InFight())
  {
    write(BS("Im Kampf ist Aza aber wirklich viel zu beschaeftigt, um sich um "
        "Reparaturen zu kuemmern!"));
    return 1;
  }
  if(TP->InFight())
  {
    write(BS("Im Kampf bist Du viel zu beschaeftigt, um Dich um Reparaturen zu "
        "kuemmern!"));
    return 1;
  }

  notify_fail("Welchen Gegenstand genau moechtest Du denn reparieren?\n");
  if (!str || !stringp(str)) return 0;
  if (!ob=present(str,TP)) {
    write(ABS("Das hast Du doch gar nicht dabei.\n"));
    return 1;
  }
  dam = ob->QueryProp(P_DAMAGED);
  if (ob->QueryProp(P_WEAPON_TYPE)) {
    write(ABS("Sehr gut! Ich sehe mir das jetzt erst einmal ganz genau an."));
    preis=500;   // Multiplikator
  }
  else if (ob->QueryProp(P_ARMOUR_TYPE)) {
    write(ABS("Eine Ruestung, interessant. Ich sehe sie mir einmal genauer an."));
    preis=2000;  // Multiplikator
  }
  else {
    write(ABS("Diesen Gegenstand kann ich nicht reparieren. Bei Schaeden an "
        "Waffen und Ruestungen kann ich Dir aber gerne weiterhelfen."));
    return 1;
  }
  write(TO->Name(WER)+" sieht sich "+ob->name(WEN,1)+" akribisch genau an.\n");
  if (dam <= 0) {
    write(ABS(ob->Name(WER,1)+" "+(ob->IsPlural() ? "sind" : "ist")+
    " doch bereits in hervorragendem Zustand!"));
    return 1;
  }
  preis=preis*dam;
  write(ABS("Fuer die Reparatur "+ob->name(WESSEN,1)+" verlange ich Edelsteine im Wert von "+
      preis+" Muenzen. Wenn das fuer Dich in Ordnung ist, dann tippe 'ja'."));
  input_to("repair2", 0, ob, dam, dam, preis, time());
  return 1;
}

// ------------------------------------------------------------------------------
void repair2(string str, object ob, int dam, int damrep, int preis, int zeit)
{
  object it;
  int gem_tot_val, gem_single_val;

  if (!TP) return;
  if (environment(TP) != ENV(ME)) {  // Spieler mit !bla rausgegangen...?
    write("Dazu ist es jetzt zu spaet!\n");
    return;
  }
  if (time() > (zeit+15))       // 15 Sekunden Zeit
  {
    write(ABS("Das hat viel zu lange gedauert! Du musst Dich bitte etwas "
    "schneller entscheiden."));
    return;
  }
  if ((str!="ja") && (str!="j")) {
    write(ABS("Wie Du wuenschst, keine Reparatur. Solltest Du es Dir doch noch "
    "anders ueberlegen, dann komm einfach wieder zu mir."));
    return;
  }
  if (!ob) {
    write(ABS("Sehr eigenartig, der Gegenstand ist ploetzlich verschwunden..."));
    return;
  }
  if (environment(ob) != TP) {
    write(ABS("Mysterioes, wo "+(ob->IsPlural() ? "sind" : "ist")+
          ob->name(WER,1)+" hin verschwunden?"));
    return;
  }
  if (dam != ob->QueryProp(P_DAMAGED)) {
    write(ABS("Eigenartig, aeusserst eigenartig! "+ob->Name(WER,1)+
          (ob->IsPlural() ? " sind" : " ist")+
          (dam > ob->QueryProp(P_DAMAGED) ?
                    " gar nicht mehr so stark" :
                    " auf einmal wesentlich staerker")+
          " beschaedigt! Das muss ich mir nochmal genau ansehen."));
    return;
  }
  gem_tot_val=0;
  for(it=first_inventory(TP);it;it=next_inventory(it))
  {
    if(!it->id("EDELSTEIN")) continue;
    gem_tot_val+=it->QueryProp(P_VALUE);
    if(gem_tot_val>=preis) break;
  }
  if (gem_tot_val<preis) {
    write(ABS("Nunja, Du hast nicht genug Edelsteine "
        "dabei. Komm einfach wieder, wenn Du sie aufgetrieben hast."));
    return;
  }
  else
  {
    gem_tot_val=0;
    for(it=first_inventory(TP);it;it=next_inventory(it))
    {
      if(!it->id("EDELSTEIN") || !it->QueryProp(P_AMOUNT)) continue;
      gem_single_val=it->QueryProp(P_VALUE)/it->QueryProp(P_AMOUNT);
      if(gem_tot_val+gem_single_val>preis) continue;
      while (gem_tot_val+gem_single_val<=preis && it && it->QueryProp(P_AMOUNT))
      {
        gem_tot_val+=gem_single_val;
        it->AddAmount(-1);
      };
      if(gem_tot_val==preis) break;
    }
    if(gem_tot_val == preis)
    {
      write(ABS("Ausgezeichnet, das geht sich genau aus! Deine Edelsteine sind exakt "
      "soviel wert, wie ich fuer die Reparatur verlange."));
    }
    else if(!random(2) && (it=present("EDELSTEIN",TP)) && it->QueryProp(P_AMOUNT))
    {
      write(ABS("Deine Edelsteine sind leider nicht exakt soviel wert, wie ich "
      "fuer die Reparatur verlange. Halbe oder sonstwie geteilte Edelsteine sind "
      "nicht moeglich, daher musste ich aufrunden. Tut mir leid."));
      it->AddAmount(-1);
      gem_tot_val+=gem_single_val;
    }
    else
    {
      write(ABS("Weil ich in guter Stimmung bin und der Wert Deiner Edelsteine nicht "
      "exakt passt, habe ich fuer Dich abgerundet."));
    }
    ob->Damage(-damrep);
    write(BS(TO->Name(WER)+" nimmt Dir Edelsteine im Wert von "+gem_tot_val+" Muenzen ab und beginnt, "
        "mehrere Zauber auf "+ob->name(WEN,1)+" zu wirken. Magisches Knistern und Leuchten erfuellt "
        "die Umgebung fuer kurze Zeit. Wenig spaeter grinst Dich "
        +TO->Name(WER)+" an und drueckt Dir "+ob->name(WEN,1)+" in "
        "hervorragendem Zustand wieder in die Haende."));
    }
  
}

