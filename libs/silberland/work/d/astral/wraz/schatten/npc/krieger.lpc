// Schattenwelt
// von Wraz / Mendralim
//
// Krieger*in

#include "../def.h"
#include "/p/daemon/itemd/itemd.h"

inherit "std/mnpc";
inherit "/std/npc/spells";

string *weapon;
string *armour;
string *armour2;
string *armour3;

int charge_shout=0, max_retry_arm=3;

object ob;
object weapon_ob;

varargs void arm_me(int rnd)
{
  if(!rnd) rnd = 300;

  weapon = ({"/p/weapon/axe/langaxt","/p/weapon/axe/streitaxt","/p/weapon/chain/trippelstern",
  "/p/weapon/chain/doppelstern","/p/weapon/club/streithammer","/p/weapon/club/kriegshammer",
  "/p/weapon/knife/meucheldolch","/p/weapon/knife/langdolch","/p/weapon/spear/pike",
  "/p/weapon/spear/hellebarde","/p/weapon/sword/flamberge","/p/weapon/sword/bihaender",
  "/p/weapon/whip/bullenpeitsche"});
  weapon = ({weapon[random(sizeof(weapon))]}); // notwendig fuer zuecken
 
  weapon_ob = clone_object(weapon[0]);
  weapon_ob->move(TO,2);

  if(!random(rnd))
  {
    weapon_ob->SetProp(P_DAM_TYPE,({DT_LIGHT}));
    weapon_ob->SetProp(P_NAME, weapon_ob->QueryProp(P_NAME)+" aus purem Licht");
    weapon_ob->SetProp(P_VALUE, weapon_ob->QueryProp(P_VALUE)*20);
    weapon_ob->SetProp(P_ITEMD_TMPMAGIC, ({2900, 2900}) ); // ca. 90 Tage
    weapon_ob->seteuid(getuid(weapon_ob));
    find_object(ITEMD)->RegisterNewItem(weapon_ob, TIME_ID);
  }
  else
  {
    weapon_ob->SetProp(P_DAM_TYPE,weapon_ob->QueryProp(P_DAM_TYPE)+({DT_LIGHT}));
    weapon_ob->SetProp(P_NAME_ADJ, "leuchtend");
    weapon_ob->AddAdjective( ({ "leuchtend", "leuchtende", "leuchtenden",
      "leuchtendes", "leuchtender" }) );
    weapon_ob->SetProp(P_VALUE, weapon_ob->QueryProp(P_VALUE)*5);
  }
  weapon_ob->SetProp(P_SHORT, weapon_ob->Name());
  weapon_ob->SetProp(P_MAGIC, 1);
  weapon_ob->SetProp(P_ITEMD_NO_MAGIC, 1);

  command("zuecke "+explode(weapon[0],"/")[<1]);
  
  if(!weapon_ob->QueryProp(P_WIELDED) && max_retry_arm)
  {
    max_retry_arm--;
    weapon_ob->remove();
    arm_me();
  }

}

void armour_me()
{
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 1000+random(210)*5);
  ob->move(TO);

 armour = ({"/p/armour/armour/mithrilpanzer","/p/armour/armour/plattenpanzer",
    "/p/armour/armour/kettenpanzer","/p/armour/armour/titanpanzer"});
  armour2 = ({"/p/armour/boots/eisenstiefel","/p/armour/boots/eisenschuhe",
    "/p/armour/boots/kampfstiefel","/p/armour/boots/lederstiefel"});
  armour3 = ({"/p/armour/helm/mithrilhelm","/p/armour/helm/topfhelm",
    "/p/armour/helm/bronzehelm","/p/armour/helm/titanhelm"});

  CLONEME( armour[random(sizeof(armour))] );
  if(random(2)) CLONEME( armour2[random(sizeof(armour2))] );
  if(random(2)) CLONEME( armour3[random(sizeof(armour3))] );

  command("trage alles");
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_GENDER, ({MALE,FEMALE})[random(2)]);

  if(QueryProp(P_GENDER)==MALE)
  {
    SetProp(P_SHORT, "Ein Krieger");
    SetProp(P_NAME, "Krieger");
    SetProp(P_RACE, ({"Mensch","Elf","Halbelf","Zwerg","Oger",
    "Troll","Hobbit"})[random(7)]);
  }
    
  else 
  {
    SetProp(P_SHORT, "Eine Kriegerin");
    SetProp(P_NAME, "Kriegerin");
    SetProp(P_RACE, ({"Mensch","Elf","Halbelf","Zwerg","Oger",
    "Troll","Hobbit"})[random(7)]);
  }

  if(QueryProp(P_RACE)=="Mensch")
  {
    SetProp(P_SIZE, 160+random(40));
    SetProp(P_WEIGHT, 60000+random(40000));
  }
  else if (QueryProp(P_RACE)=="Elf")
  {
    SetProp(P_SIZE, 180+random(40));
    SetProp(P_WEIGHT, 60000+random(20000));
  }
  else if (QueryProp(P_RACE)=="Halbelf")
  {
    SetProp(P_SIZE, 170+random(35));
    SetProp(P_WEIGHT, 60000+random(30000));
  }
  else if (QueryProp(P_RACE)=="Zwerg")
  {
    SetProp(P_SIZE, 105+random(30));
    SetProp(P_WEIGHT, 65000+random(30000));
  }
  else if (QueryProp(P_RACE)=="Oger")
  {
    SetProp(P_SIZE, 220+random(60));
    SetProp(P_WEIGHT, 175000+random(50000));
  }
  else if (QueryProp(P_RACE)=="Troll")
  {
    SetProp(P_SIZE, 300+random(60));
    SetProp(P_WEIGHT, 300000+random(100000));
  }
  else if (QueryProp(P_RACE)=="Fee")
  {
    SetProp(P_SIZE, 60+random(20));
    SetProp(P_WEIGHT, 15000+random(10000));
  }
  else if (QueryProp(P_RACE)=="Hobbit")
  {
    SetProp(P_SIZE, 90+random(30));
    SetProp(P_WEIGHT, 40000+random(20000));
  }
  
  SetProp(P_LONG,
    Name(WER,1) + " gehoert der Rasse " + QueryProp(P_RACE) +
    " an. "+ capitalize(QueryPronoun()) +" sieht kraeftig und erfahren aus.");
  
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({lower_case(QueryProp(P_RACE)),
    lower_case(QueryProp(P_NAME)), 
    QueryProp(P_GENDER)==MALE ? "waechter" : "waechterin",
    QueryProp(P_GENDER)==MALE ? "krieger" : "kriegerin",
    "Kettenmeister", "Axtmeister",
    "Keulenmeister", "Speermeister", "Schwertmeister", 
    "\nposeyfriends", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(35,1000+random(500));
  
  SetProp(P_ALIGN, -60+random(120));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MNPC_AREA, ({ ROOM "laden", ROOM "lagerplatz", ROOM "leiterinzelt",
    ROOM "taverne"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "lagerplatz");
  SetProp(P_MNPC_WAIT, ({ 60, 60, 500 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" nimmt das nicht an.\n" }) );

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "schaut Dich fragend an.\n");

  AddInfo( ({"angebot"}),
    "Wie allen hier, ausser Posey, erschien mir das Angebot vor meinem geistigen "
    "Auge. Ich nahm es stolz an und kaempfte mich danach zum Lager durch.",
    "sagt: ");

  AddInfo( ({"posey","posey olivenwein","olivenwein","anfuehrerin"}),
    "Posey ist unsere Leiterin. Ihr Schutzzauber verhindert, dass das Lager von "
    "den Schattenkreaturen ueberfallen wird.",
    "sagt: ");

  AddInfo( ({"schutzzauber", "zauber"}),
    "Danach fragst Du Posey am besten selbst, damit kenne ich mich nicht aus.",
    "sagt: ");

  AddInfo( ({"schattenkreaturen", "kreaturen", "schatten"}),
    "Wir bekaempfen die Schattenkreaturen, um das Boese zu vernichten! Und wer "
    "weiss, vielleicht vernichten wir auch einen Avatar von Wraz!",
    "sagt: ");

  AddInfo( ({"boese", "brunnen"}),
    "Das Boese sitzt nicht nur als DAS BOESE im Brunnen, sondern auch in jeder "
    "der haesslichen Schattenkreaturen. Die Schatten zu bekaempfen bedeutet, das "
    "Boese im Silberland zu bekaempfen!",
    "sagt: ");

  AddInfo( ({"silberland", "schattenwelt", "teil", "teil des silberlandes"}),
    "Ja, auch die Schattenwelt ist Teil des Silberlandes. Ein dunkler Teil.",
    "sagt: ");

  SetProp(P_SPELLRATE,30);

  AddSpell(4,500,
    Name(WER,1) + " versetzt Dir einen ueblen Kinnhaken!\n",
    Name(WER,1) + " versetzt @WEM einen Kinnhaken!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,600,
    Name(WER,1) + " trifft Dich an einer empfindlichen Stelle am Hals!\n",
    Name(WER,1) + " trifft @WEN am Hals!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2, 1,
    Name(WER,1)+" wirft sich bruellend auf Dich: AAAAHHHHHHH!\n",
    Name(WER,1)+" bruellt 'AAAAAHHHHHH!' und wirft sich auf @WEN!\n",
    DT_BLUDGEON, "SpecialAttack", ([SP_SHOW_DAMAGE:0]));

  SetAttackChats(5,
  ({Name(WER)+" attackiert Dich unerwartet!\n"
   }));

  SUID;

  arm_me();
  armour_me();

  call_out("ExpeditionMode",1);
}

// ------------------------------------------------------------------------------
// ExpeditionMode(1) erlaubt die Bewegung in den Schattenraeumen mit Monstern,
//  ExpeditionMode(0) nur im Lager
// ROOM "schatten.lpc" setzt die Prop "expedition_mode" = 1
varargs void ExpeditionMode(int i)
{
  if (i==1 || QueryProp("expedition_mode") == 1) 
    SetProp(P_MNPC_AREA, ({ ROOM "laden", ROOM "lagerplatz", ROOM "leiterinzelt",
      ROOM "taverne", ROOM "sn"}) );
  else if(!i) SetProp(P_MNPC_AREA, ({ ROOM "laden", ROOM "lagerplatz", ROOM "leiterinzelt",
    ROOM "taverne"}) );
}

// ------------------------------------------------------------------------------
void SpecialAttack(object enemy, int damage, mixed dam_type)
{
  object ob;

  if(enemy && enemy->id("\nschattenweltnpc") && TO->QueryProp(P_WEAPON) &&
    !random(2))
  {
    ENV(enemy)->Message(BS(Name(WESSEN,1)+" Waffe leuchtet grell auf!"));
    TO->ModifySkillAttribute(SA_DAMAGE, 150+random(400),4+random(4));
  }
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "aergerlich":
    case "albern":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "blickt Dich irritiert an.",
        "blickt "+capitalize(getuid(TP))+" irritiert an.",
        0);
      break;

    case "froh":
    case "neutral":
    case "nett":
    case "traurig":
      call_out("reaction", 0, TP,
        "ignoriert Dich.",
        "ignoriert "+capitalize(getuid(TP)),
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "schreit Dich wuetend an: Hoer sofort auf damit!",
        "schreit "+capitalize(getuid(TP))+" wuetend an: Hoer sofort auf damit!",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER)+ " "+macher));
  tell_room(ENV(TO), BS(Name(WER)+ " "+andere), ({pl}) );
}

// ------------------------------------------------------------------------------
void KillShadowNPC(object enemy)
{
  if(TO->QueryProp("last_scream") < time() - 4) command_me("sag Nieder mit der Ausgeburt des Boesen!");
  TO->SetProp("last_scream",time());
  if(enemy && TO && ENV(TO) && present(enemy, ENV(TO))) Kill(enemy);
}

// ------------------------------------------------------------------------------
void init()
{
  object it;

  ::init();
  if(TP && TP->id("\nposeyfriends")) AddDefender(TP);

  if(TO && ENV(TO) && present("Spieler",ENV(TO)))
  {
    if(TP && TP->id("\nschattenweltnpc")) call_out("KillShadowNPC",1,TP);
    else
    {
      for(it=first_inventory(ENV(TO));it;it=next_inventory(it))
      {
        if(it->id("\nschattenweltnpc") && !IsEnemy(it)) call_out("KillShadowNPC",1,it);
      }
    }
  }
}

// ------------------------------------------------------------------------------
void InformDefend(object enemy)
{
  if(!charge_shout)
  {
    command_me("sag Vernichtet den Eindringling mit vereinten Kraeften!");
    charge_shout = 1;
  }
  Kill(enemy);
}

// ------------------------------------------------------------------------------
mixed DefendOther(int dam,mixed dam_type,mixed spell,object enemy)
{
  // nur Angriffe auf Posey werden geblockt
  if(!previous_object() || !previous_object()->id("\nposey"))
    return({dam,dam_type,spell});

  else
  {
    ENV(TO)->Message(BS(Name()+" blockt den Angriff auf Posey teilweise ab!"));
    dam /= 4;
    return({dam,dam_type,spell});
  }
}

// ------------------------------------------------------------------------------
void reset()
{
    if(!is_clone(TO)) return;
    charge_shout = 0;
}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  LOGMASTER->LogFile("specialnpcdeaths", TO->name(RAW), TP);
  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) LOGMASTER->LogFile("playerdeaths", killer->name(RAW), player, lostexp);
}