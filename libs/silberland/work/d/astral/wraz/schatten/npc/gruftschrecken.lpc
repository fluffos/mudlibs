// Gruftschrecken (wight)
// Schattenwelt
// Von Ildenar (ghostwriter)
// angepasst von Wraz / Mendralim

#include "../def.h"
inherit "/std/npc/spells";
inherit "std/npc";
inherit NPC "npc.lpc";

string *armour_arr;
object armour;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Gruftschrecken");
  SetProp(P_LONG,
    "Eine schauderhafte Kaelte steigt in Dir empor waehrend Du den Gruftschrecken erblickst. "
    "Vor Dir steht eine humanoide Gestalt mit fahler, eingefallener Haut, weissem Haar und Augen, die "
    "Dir mit blankem, weiss gluehendem Hass entgegenstarren. Ihre Haende sind zu grotesken Klauen mutiert "
    "die ein Langschwert umklammern. "
    "Der Gruftschrecken traegt eine alte, stark verwitterte Ruestung, die in Teilen "
    "von seinem verottetem Koerper haengt."
  );
	
  AddDetail( ({ "kaelte" }),
	"Eine unnatuerliche schauderhafte Kaelte steigt in Dir auf. "
	"Vielleicht haettest Du nicht herkommen sollen."
  );
  
  AddDetail( ({ "gestalt", "koerper" }),
	"Der Gruftschrecken hat eine generell humanoide Geschalt, sein Koerper wirkt aber mehr wie eine Leiche "
	"und weniger wie ein lebendiger Mensch."
  ); 

  AddDetail( ({ "haut" }),
	"Die Haut ist fahl, grau und fleckig, die Wangen eingefallen und leblos. "
	"Im Ganzen erinnert Dich das Aussehen an eine Mumie ohne Bandagen."
  );

  AddDetail( ({ "haar", "haare" }),
	"Weisse Haare, die an vielen Stellen schon ausgefallen sind."
  ); 

  AddDetail( ({ "augen" }),
	"Die Augen strahlen mit einem weissen unnatuerlichem Gluehen."
  );    
  
  AddDetail( ({ "hass" }),
	"Davon hat der Gruftschrecken ausreichend, genug sogar um Dir etwas davon abzugeben."
  );

  AddDetail( ({ "hand", "haende", "klauen" }),
	"Die Haende entsprechen nicht denen von normalen Menschen, sie sind zu Klauen mutiert."
  ); 

  AddDetail( ({ "ruestung", "teile" }),
	"Die Ruestung scheint so wie der restliche Koeper langsam zu verrotten, viel Schutz bietet "
  "sie wohl nicht mehr."
  );  

  AddDetail( ({ "mumie" }),
	"Der Koerper hat die generelle Aesthetik einer Mumie."
  );   


//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gruftschrecken");
  SetProp(P_GENDER, MALE);
  AddId(({"gruftschrecken", "untoter"}));

//--Eigenschaften----------------------------------------------------------

  create_default_shadownpc(38+random(3),0,0);
  // Existiert von Raum sn041 bis sn500 --> HP:
  //  41: ca  500
  //  50:     563
  // 100:     970
  // 200:    2846
  // 300:    7980
  // 400:   19979
  // 500:   40000


  SetProp(P_HANDS, ({" mit seinen Klauen",
                    QueryProp(P_HANDS)[1],
                    ({DT_SLASH})
                    }) );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 160+random(20));
  SetProp(P_WEIGHT, 50000+random(20000));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -2);
  SetProp(P_AGGRESSIVE,([P_GUILD:(["Nekromanten":0.5, 0:1])]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" schlaegt Dir @WEN aus der Hand.\n" }) );

  /*SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_LIGHT:     0.8, DT_POISON:    -1.0, DT_TERROR:   -0.5, 
	   DT_HOLY:      0.8, DT_UNHOLY:    -1.0, DT_SLASH:    -0.7, 
	   DT_BLUDGEON: -0.7, DT_PIERCE:    -0.7, DT_COLD:     -0.8,
     ]) );*/

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "steigt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint aus den Schatten");
  SetProp(P_MMSGOUT, "verschwindet in den Schatten");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " bricht zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das naechste Mal fuege ich Dich meiner Heerschar hinzu!");
  SetProp(P_KILL_MSG, "Einer mehr!");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "empfindet nur Verachtung fuer Dich.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 15+2*diff_int);

  AddSpell(20, 1, 
    Name(WESSEN,1) + " Augen gluehen mit blankem Hass!\n",
    Name(WESSEN,1) + " Augen gluehen mit blankem Hass!\n",
     DT_SLASH, "schnell", ([SP_SHOW_DAMAGE:0]) );	
	 
  AddSpell(10, 1, 
    Name(WER,1) + " packt Dich am Hals und entzieht Dir Lebensenergie!\n",
    Name(WER,1) + " packt @WEN am Hals und Du siehst ein leichtes Gluehen!\n",
     DT_SLASH, "lifedrain", ([SP_SHOW_DAMAGE:0]) );		 

  AddSpell(1,1,
  "",
  "",
  DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );


//--Chats------------------------------------------------------------------

  SetAttackChats(3,
  ({Name(WER, 1)+" bruellt Dich an.\n",
    Name(WER, 1)+" ruft nach seinen Dienern.\n",
   }) );

  SetChats(1,
  ({Name(WER,1)+" bruellt!\n",
    "@@HideCalledByChat@@",
    "","","","","",""
   }));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME("/p/weapon/sword/langschwert" );
  command("zuecke langschwert");

  armour_arr = ({"/p/armour/armour/lederruestung","/p/armour/armour/lederpanzer",
    "/p/armour/armour/ringelpanzer","/p/armour/armour/kettenpanzer"});
  armour = clone_object( armour_arr[random(sizeof(armour_arr))] );

  armour->SetProp(P_NAME_ADJ, "verrottet");
  armour->AddAdjective( ({ "verrottet", "verrottete", "verrotteten",
      "verrottetes", "verrotteter" }) );
  armour->SetProp(P_AC, (int) (0.5*(armour->QueryProp(P_AC))+random(4)));
  armour->SetProp(P_SHORT, armour->Name());

  armour->move(TO,2);
  command("trage alles");
}

// ------------------------------------------------------------------------------
void schnell(object enemy, int damage, mixed dam_type) 
{
	ModifySkillAttribute(this_object(), SA_SPEED, 200, 2);
}	

// ------------------------------------------------------------------------------
void lifedrain(object enemy, int damage, mixed dam_type)
{
  int rndDmg;

	rndDmg = random(50);
	enemy->do_damage(rndDmg, TO);
	TO->addHP(rndDmg);
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
string HideCalledByChat()
{
  npc::hide();
  return "";
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  DropShadowItems();
  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  CallPlayerDeathLog(player, killer, lostexp);
  call_out("leiche_verwandeln",2+random(5));
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 //if(!is_clone(TO)) return;
}
