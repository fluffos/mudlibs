// Schattenwelt
// von Wraz / Mendralim
//
// Leibwache

#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

string *weapon;
string *armour;
string *armour2;
string *armour3;

int charge_shout;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_GENDER, ({MALE,FEMALE})[random(2)]);

  if(QueryProp(P_GENDER)==MALE)
  {
    SetProp(P_SHORT, "Ein Leibwaechter");
    SetProp(P_NAME, "Leibwaechter");
    SetProp(P_RACE, ({"Mensch","Elf","Halbelf","Zwerg","Oger",
    "Troll","Hobbit"})[random(7)]);
  }
    
  else 
  {
    SetProp(P_SHORT, "Eine Leibwaechterin");
    SetProp(P_NAME, "Leibwaechterin");
    SetProp(P_RACE, ({"Mensch","Elf","Halbelf","Zwerg","Oger",
    "Troll","Hobbit"})[random(7)]);
  }

  if(QueryProp(P_RACE)=="Mensch")
  {
    SetProp(P_SIZE, 160+random(40));
    SetProp(P_WEIGHT, 60000+random(40000));
  }
  else if (QueryProp(P_RACE)=="Elf")
  {
    SetProp(P_SIZE, 180+random(40));
    SetProp(P_WEIGHT, 60000+random(20000));
  }
  else if (QueryProp(P_RACE)=="Halbelf")
  {
    SetProp(P_SIZE, 170+random(35));
    SetProp(P_WEIGHT, 60000+random(30000));
  }
  else if (QueryProp(P_RACE)=="Zwerg")
  {
    SetProp(P_SIZE, 105+random(30));
    SetProp(P_WEIGHT, 65000+random(30000));
  }
  else if (QueryProp(P_RACE)=="Oger")
  {
    SetProp(P_SIZE, 220+random(60));
    SetProp(P_WEIGHT, 175000+random(50000));
  }
  else if (QueryProp(P_RACE)=="Troll")
  {
    SetProp(P_SIZE, 300+random(60));
    SetProp(P_WEIGHT, 300000+random(100000));
  }
  else if (QueryProp(P_RACE)=="Fee")
  {
    SetProp(P_SIZE, 60+random(20));
    SetProp(P_WEIGHT, 15000+random(10000));
  }
  else if (QueryProp(P_RACE)=="Hobbit")
  {
    SetProp(P_SIZE, 90+random(30));
    SetProp(P_WEIGHT, 40000+random(20000));
  }
  
  SetProp(P_LONG,
    Name(WER,1) + " gehoert der Rasse " + QueryProp(P_RACE) +
    " an. "+ capitalize(QueryPronoun()) +" blickt Dich ruhig an.");
  
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({lower_case(QueryProp(P_RACE)), "leibwache", "wache", 
    lower_case(QueryProp(P_NAME)), 
    QueryProp(P_GENDER)==MALE ? "waechter" : "waechterin",
    QueryProp(P_GENDER)==MALE ? "leibwaechter" : "leibwaechterin",
    "Kettenmeister", "Axtmeister",
    "Keulenmeister", "Speermeister", "Schwertmeister", 
    "\nposeyfriends", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);

  set_living_name("\nposeileibwache");

  create_default_npc(40,2000+random(1000));

  SetProp(P_ATTRIBUTES, ([A_STR:50,A_INT:15,A_DEX:25,A_CON:45]) );
  
  SetProp(P_ALIGN, -40+random(80));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" nimmt das nicht!\n" }) );

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "schaut Dich nachdenklich an.\n");

  SetProp(P_SPELLRATE,60); // zuvor 40

  AddSpell(4,600,
    Name(WER,1) + " schlaegt Dir hart ins Gesicht!\n",
    Name(WER,1) + " schlaegt @WEN hart ins Gesicht!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,800,
    Name(WER,1) + " schlaegt Dich mit einem Treffer gegen die Schlaefe fast bewusstlos!\n",
    Name(WER,1) + " schlaegt @WEN mit einem Treffer gegen die Schlaefe fast bewusstlos!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10,
  ({Name(WER)+" attackiert Dich geschickt!\n"
   }));

  SUID;

  weapon = ({"/p/weapon/axe/langaxt","/p/weapon/axe/streitaxt","/p/weapon/chain/trippelstern",
  "/p/weapon/chain/doppelstern","/p/weapon/club/streithammer","/p/weapon/club/kriegshammer",
  "/p/weapon/knife/meucheldolch","/p/weapon/knife/langdolch","/p/weapon/spear/pike",
  "/p/weapon/spear/hellebarde","/p/weapon/sword/flamberge","/p/weapon/sword/bihaender"});
  weapon = ({weapon[random(sizeof(weapon))]});
  armour = ({"/p/armour/armour/mithrilpanzer","/p/armour/armour/plattenpanzer"});
  armour2 = ({"/p/armour/boots/eisenstiefel","/p/armour/boots/eisenschuhe"});
  armour3 = ({"/p/armour/helm/mithrilhelm","/p/armour/helm/topfhelm"});

  CLONEME( weapon[0] );
  CLONEME( armour[random(sizeof(armour))] );
  if(armour2) CLONEME( armour2[random(sizeof(armour2))] );
  if(armour3) CLONEME( armour3[random(sizeof(armour3))] );

  command("zuecke "+explode(weapon[0],"/")[<1]);
  command("trage alles");
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "aergerlich":
    case "albern":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "blickt Dich herablassend an.",
        "blickt "+capitalize(getuid(TP))+" herablassend an.",
        0);
      break;

    case "froh":
    case "neutral":
    case "nett":
    case "traurig":
      call_out("reaction", 0, TP,
        "ignoriert Dich.",
        "ignoriert "+capitalize(getuid(TP)),
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "bellt Dich wuetend an: Hoer sofort auf!",
        "bellt "+capitalize(getuid(TP))+" wuetend an: Hoer sofort auf!",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER)+ " "+macher));
  tell_room(ENV(TO), BS(Name(WER)+ " "+andere), ({pl}) );
}

void init()
{
  ::init();
  if(TP && TP->id("\nposeyfriends")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  if(!charge_shout)
  {
    if(TO && ENV(TO) && present("\nposey",ENV(TO)))
    {
      command_me("sag Schuetzt Posey, unsere Leiterin!");
      charge_shout = 1;
    }
    else command_me("sag Toetet den Eindringling!");
  }
  Kill(enemy);
}

mixed DefendOther(int dam,mixed dam_type,mixed spell,object enemy)
{
  // nur Angriffe auf Posey werden geblockt
  if(!previous_object() || !previous_object()->id("\nposey"))
    return({dam,dam_type,spell});

  else
  {
    ENV(TO)->Message(BS(Name()+" blockt den Angriff auf Posey teilweise ab!"));
    dam /= 4;
    return({dam,dam_type,spell});
  }
}

void reset()
{
  if(!is_clone(TO)) return;
  charge_shout = 0;
}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  LOGMASTER->LogFile("specialnpcdeaths", TO->name(RAW), TP);
  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) LOGMASTER->LogFile("playerdeaths", killer->name(RAW), player, lostexp);
}