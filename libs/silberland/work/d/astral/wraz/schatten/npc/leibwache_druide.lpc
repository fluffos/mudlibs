// Schattenwelt
// von Wraz / Mendralim
//
// Leibwache: Druide

#include "../def.h"

inherit "/p/std/npc/druid_npc";

object ob;
int charge_shout;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_GENDER, ({MALE,FEMALE})[random(2)]);

  if(QueryProp(P_GENDER)==MALE)
  {
    SetProp(P_SHORT, "Ein Leibwaechter-Druide");
    SetProp(P_NAME, "Leibwaechter-Druide");
    SetProp(P_RACE, ({"Mensch","Elf","Halbelf","Zwerg","Oger",
    "Troll","Hobbit"})[random(7)]);
  }
    
  else 
  {
    SetProp(P_SHORT, "Eine Leibwaechter-Druidin");
    SetProp(P_NAME, "Leibwaechter-Druidin");
    SetProp(P_RACE, ({"Mensch","Elf","Halbelf","Zwerg","Oger",
    "Troll","Fee","Hobbit"})[random(7)]);
  }

  SetProp(P_LONG,
    Name(WER,1) + " gehoert der Rasse " + QueryProp(P_RACE) +
    " an. "+ capitalize(QueryPronoun()) +" blickt Dich ruhig an.");

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:40]));
  AddId(({lower_case(QueryProp(P_RACE)), "leibwache", "wache", 
    lower_case(QueryProp(P_NAME)), 
    QueryProp(P_GENDER)==MALE ? "waechter" : "waechterin",
    QueryProp(P_GENDER)==MALE ? "druide" : "druidin",
    QueryProp(P_GENDER)==MALE ? "leibwaechter" : "leibwaechterin", 
    "\nposeyfriends", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);

  create_default_druid(({"luft", "wasser", "feuer", "eis", "humus", "erz"})[random(6)],
    42,11+random(5),650+random(400));

  if(QueryProp(P_RACE)=="Mensch")
  {
    SetProp(P_SIZE, 160+random(40));
    SetProp(P_WEIGHT, 60000+random(40000));
  }
  else if (QueryProp(P_RACE)=="Elf")
  {
    SetProp(P_SIZE, 180+random(40));
    SetProp(P_WEIGHT, 60000+random(20000));
  }
  else if (QueryProp(P_RACE)=="Halbelf")
  {
    SetProp(P_SIZE, 170+random(35));
    SetProp(P_WEIGHT, 60000+random(30000));
  }
  else if (QueryProp(P_RACE)=="Zwerg")
  {
    SetProp(P_SIZE, 105+random(30));
    SetProp(P_WEIGHT, 65000+random(30000));
  }
  else if (QueryProp(P_RACE)=="Oger")
  {
    SetProp(P_SIZE, 220+random(60));
    SetProp(P_WEIGHT, 175000+random(50000));
  }
  else if (QueryProp(P_RACE)=="Troll")
  {
    SetProp(P_SIZE, 300+random(60));
    SetProp(P_WEIGHT, 300000+random(100000));
  }
  else if (QueryProp(P_RACE)=="Fee")
  {
    SetProp(P_SIZE, 60+random(20));
    SetProp(P_WEIGHT, 15000+random(10000));
  }
  else if (QueryProp(P_RACE)=="Hobbit")
  {
    SetProp(P_SIZE, 90+random(30));
    SetProp(P_WEIGHT, 40000+random(20000));
  }

  SetProp(P_ALIGN, 10);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);

  SetProp( P_REJECT, ({ REJECT_DROP, "" }) );

  SUID;
  
  CLONEME( "/p/armour/armour/seidenjacke" );
  CLONEME( "/p/armour/cloak/umhang" );
  command("trage alles");
}

void init()
{
  ::init();
  if(TP && TP->id("\nposeyfriends")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  if(!charge_shout)
  {
    if(TO && ENV(TO) && present("\nposey",ENV(TO)))
    {
      command_me("sag Schuetzt Posey, unsere Leiterin!");
      charge_shout = 1;
    }
    else command_me("sag Toetet den Eindringling!");
  }
  Kill(enemy);
}

void reset()
{
  if(!is_clone(TO)) return;
  charge_shout = 0;
}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  LOGMASTER->LogFile("specialnpcdeaths", TO->name(RAW), TP);
  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) LOGMASTER->LogFile("playerdeaths", killer->name(RAW), player, lostexp);
}