// Schreiter
// Schattenwelt
// Von Wraz / Mendralim

#include "../def.h"
inherit "/std/npc/spells";
inherit "std/npc";
inherit NPC "npc.lpc";

string default_short = "Ein Schreiter";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, default_short);
  SetProp(P_LONG,
    "Der Schreiter ist ein schreckenerregender Riese! Seine Gestalt verkoerpert "
    "eindeutig einen Daemonen, mit schweren, gewundenen Hoernern an der Stirn. "
    "Statt in Haenden enden seine Arme in dunkel funkelnden Schwertern.");

  AddDetail( ({""}),
    "");

  SetProp(P_NAME, "Schreiter");
  SetProp(P_GENDER, MALE);
  AddId(({"schreiter"}));

  create_default_shadownpc(34+random(3),0,0,20000);
  
  SetProp(P_MAX_HP, 500+QueryProp(P_MAX_HP)); // mindestens 500 HP

  SetProp(P_HANDS, ({" mit Schwertarmen", QueryProp(P_HANDS)[1] , ({DT_SLASH}) }) );

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 650+random(100));
  SetProp(P_WEIGHT, 2500000+random(500000));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC,20);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" zerschmettert @WEN.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " stuerzt vernichtet zu Boden.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "blickt Dich dunkel an.\n");

  AddInfo( ({""}),
  "","saeuselt: ");

  SetChats(1,
  ({Name(WER,1)+" verzieht das Gesicht zu einer daemonischen Fratze.\n",
    "@@HideCalledByChat@@",
    "","","","","",""
   }));


  SetProp(P_SPELLRATE,50+3*diff_int);

  AddDefaultSpell(30, 350+200*diff_int, DS_MASS_DAMAGE,
    Name(WER,1)+" trifft Dich mit einem maechtigen Rundumschlag.\n",
    Name(WER,1)+" trifft @WEN mit einem maechtigen Rundumschlag.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 600+120*diff_int, DS_MASS_FEAR,
   Name(WER,1)+" wuetet herum und schuechtert Dich gewaltig ein.\n");

  AddSpell(1,1,
    "",
    "",
    DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(15,1,
    Name(WER,1)+" spricht dunkle Worte und beschleunigt seine Angriffe.\n",
    Name(WER,1)+" spricht dunkle Worte und beschleunigt seine Angriffe.\n",
    DT_MAGIC, "SpeedSpell", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(5,1,
    Name(WER,1)+" spricht einen Zauber.\n",
    Name(WER,1)+" spricht einen Zauber.\n",
    DT_MAGIC, "DarknessSpell", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(5,1,
    Name(WER,1)+" spricht einen Zauber.\n",
    Name(WER,1)+" spricht einen Zauber.\n",
    DT_MAGIC, "InvisSpell", ([SP_SHOW_DAMAGE:0]) );

  // todo: 
  // idee in die(): droppt schreiterschwerter

  SUID;
}

// ------------------------------------------------------------------------------
string HideCalledByChat()
{
  npc::hide();
  return "";
}

// ------------------------------------------------------------------------------
void EndInvisSpell()
{
  if(!QueryProp(P_SHORT)) SetProp(P_SHORT,default_short);
}

// ------------------------------------------------------------------------------
void InvisSpell(object enemy, int damage, mixed dam_type)
{
  if(QueryProp(P_SHORT)) 
  {
    SetProp(P_SHORT,0);
    if(find_call_out("EndInvisSpell") == -1) call_out("EndInvisSpell", 400+random(400));
  }
}

// ------------------------------------------------------------------------------
void DarknessSpell(object enemy, int damage, mixed dam_type)
{
  // Je mehr Dunkelzauber bereits aktiv sind, umso unwahrscheinlicher wird's
  if(!random(Count(TO,"\nshadow_darkness"))) CLONEME(OBJ "dunkelzauber");
}

// ------------------------------------------------------------------------------
void SpeedSpell(object enemy, int damage, mixed dam_type)
{
  TO->ModifySkillAttribute(TO,SA_SPEED,350+random(251),12+random(8));
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  DropShadowItems();
  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  CallPlayerDeathLog(player, killer, lostexp);
  //call_out("leiche_verwandeln",2+random(5));
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 //if(!is_clone(TO)) return;
}
