// Schattenwelt
// von Wraz / Mendralim
//
// Posey Olivenwein, Fee
// eigentlich Adaldria, Ahtawqas Mutter (getarnt als Fee)
// TODO: mehr infos ueber bestimmte schattenwesen

#include <exploration.h> 
#include "../def.h"
inherit "std/npc";
inherit "/std/npc/spells";

int i_seq = 0;
int disguise(int i);

string grauen_info();

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"Messermeister", "\nposeyfriends", "NOWIMPY", "\nposey"}));
  set_living_name("posey");
  SetProp(P_ARTICLE, 0);

  create_default_npc(45,10000+random(1000));

  /*SetProp(P_HANDS, ({" mit ihren Haenden"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON}) }));

  SetProp(P_RACE, "Hobbit");*/

  disguise(2); // --> setzt P_SHORT, LONG, etc

  SetProp(P_SIZE, 95);
  SetProp(P_WEIGHT, 40000);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,50);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" nimmt das nicht!\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_DIE_MSG,  " stuerzt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_CORPSE_PROPS, (["corpse_decay": 100, P_RACE: "Hobbit"]));

  AddInfo(DEFAULT_INFO, "blickt Dich streng an.\n");

  AddInfo( ({"hilfe"}),
    "Wobei benoetigst Du denn Hilfe? Suchst Du einen Ausgang aus den Schatten? "
    "Oder moechtest Du kaempfen, wie meine mutigen Krieger*innen?",
    "sagt: ");
  
  AddInfo( ({"schatten","schattenwelt"}),
    "Einmal hier, immer hier. Mir ist niemand bekannt, der diesen Ort verlassen konnte.",
    "sagt: ");

  AddInfo( ({"ort"}),
    "Welchen Ort meinst Du? Die Schattenwelt?",
    "sagt: ");

  AddInfo( ({"liseth"}),
    "Liseth ist die Haendlerin in meinem Lager. Du findest sie ganz in der Naehe.",
    "sagt: ");

  AddInfo( ({"dogrok","wirt"}),
    "Dogrok, der haessliche Oger, ist unser Wirt.",
    "sagt: ");

  AddInfo( ({"lager"}),
    "Ich habe das Lager hier erbaut! Nach meiner Ankunft in den Schatten gab es hier nichts "
    "ausser den Tod, doch mit dem Lager gibt es zumindest eine Zuflucht - und eine Festung "
    "gegen die Ausgeburten der Schatten! Ich habe einen Zauber auf das Lager gelegt, sodass "
    "die Schattenwesen hier nicht herein kommen koennen.",
    "sagt: ");

  AddInfo( ({"zauber"}),
    "Es ist ein starker, ortsgebundener Zauber, der die Schattenwesen von hier fern haelt.",
    "sagt: ");
  
  AddInfo( ({"ankunft","ankunft in den schatten","ankunft schatten"}),
    "Es ist lange her... Ich war... stark, aber nicht stark genug.",
    "sagt nachdenklich: ");

  AddInfo( ({"tod"}),
    "Wenn Du den Tod suchst, geh in die Schatten, dort wirst Du fuendig.",
    "sagt: ");

  AddInfo( ({"zuflucht","festung"}),
    "Mein Lager hier ist die einzige Zuflucht vor den Monstern hier in der Schattenwelt!",
    "sagt: ");

  AddInfo( ({"ausgeburten","ausgeburten der schatten","schattenwesen"}),
    "Dergleichen gibt es etliche. Mit normalen Waffen sind sie nicht zu bezwingen, doch sie "
    "hassen das Licht und das Gute. Auch mit purer Magie kann man sie verletzen. Meine "
    "Krieger*innen bekaempfen sie unermuedlich, um das Boese gering zu halten.",
    "sagt: ");

  AddInfo( ({"licht"}),
    "Wo kein Licht ist, ist auch kein Schatten. Doch das Licht bestimmt den Schatten, daher sind "
    "die Schattenwesen gegen Licht verletzlich.",
    "sagt: ");

  AddInfo( ({"gute","das gute","magie","pure magie","aexte","schwerter"}),
    "Mit Licht, Magie und dem Guten kann man die Schattenwesen bezwingen. Mit normalen Aexten oder "
    "Schwerten ist man hingegen des Todes.",
    "sagt: ");

  AddInfo( ({"geist","geister"}),
    "Geister sind schwaechere Schattenwesen, sie haben keine besonderen Faehigkeiten.",
    "sagt: ");
  
  AddInfo( ({"ausweg","ausgang","ausgang aus der schattenwelt","auweg aus der schattenwelt",
    "ausgang aus schattenwelt","ausweg aus schattenwelt",
    "schattenwelt ausgang","schattenwelt ausweg","ausgang aus den schatten",
    "ausgang aus schatten"}),
    "Es gibt keinen Ausgang aus der Schattenwelt. Niemand kann diesen Ort verlassen. "
    "Jedenfalls nicht lebend.",
    "sagt: ");

  AddInfo( ({"wraz"}),
    "Wraz der Magier ist eng mit den Schatten verbunden. Es gibt Berichte, denen zufolge er "
    "einen oder sogar mehrere seiner Avatare in diese Welt gesetzt hat.",
    "sagt: ");

  AddInfo( ({"avatare","avatar"}),
    "Avatare sind maechtige Abbilder von Magiern oder gar Goettern. Sie stehen ihren Vorbildern "
    "um fast nichts nach und gelten als ebenso unberechenbar wie unbesiegbar.",
    "sagt: ");

  AddInfo( ({"berichte","bericht"}),
    "Es gibt eine handvoll Berichte ueber Begegnungen mit einem Avatar von Wraz, allesamt "
    "bestenfalls aus zweiter, meist dritter oder gar vierter Hand.",
    "sagt: ");

  AddInfo( ({"begegnungen"}),
    "Niemand der angeblich einen solchen Avatar zu Gesicht bekommen hat, hat je bei mir "
    "persoenlich einen Bericht erstattet. Es gibt nur Berichte von Krieger*innen, die "
    "behaupten, mit anderen Krieger*innen gesprochen zu haben, welche angeblich einen "
    "Avatar sahen, aber starben, bevor sie zurueckkehren konnten. Die Informationen, "
    "die ich von diesen Berichten erhielt, sind also mit grosser Skepsis zu geniessen.",
    "sagt: ");

  AddInfo( ({"informationen","information"}),
    "Die Informationen ueber angebliche Avatare von Wraz sind gleichermassen unbestaetigt "
    "wie spaerlich. Der oder die Avatare wurden weit im Norden gesichtet. In einem Bericht "
    "wurde erzaehlt, dass ein zweiter Avatar erschien, als der erste attackiert wurde. "
    "Auch wurde berichtet, dass ein Avatar entweder mit spielerischer Leichtigkeit in einen "
    "Kampf ging, oder mit brutaler Gewalt. In jedem Fall ging er ohne sichtliche Anstrengung "
    "immer siegreich hervor, sei es durch toedliche Blitze vom Himmel oder durch "
    "zerstoererische Gewalt mit verschiedenen Waffen.",
    "sagt: ");

    AddInfo( ({"leichen","leiche"}),
    "Eine gute Frage. Leichen von gefallenen Krieger*innen verschwinden hier manchmal "
    "mitsamt Ausruestung unmittelbar nach dem Tod der Person. Warum das so ist, oder "
    "wohin die Leiche verschwindet, wissen wir nicht.",
    "sagt: ");

  AddInfo( ({"zugang","eingang"}),
    "Meine magischen Forschungen haben ergeben, dass es moeglich sein koennte, dass "
    "die Geister der hier in den Schatten Gefallenen moeglicherweise wieder in die "
    "Schatten zurueckkehren koennen, ueber einen anderen Zugang. Es waere logisch, "
    "schliesslich treiben sich hier viele Geister herum, die irgendwoher gekommen "
    "sein muessen. Ich vermute, dass sich dieser Zugang auf dem Schlachtfeld in "
    "der Naehe des Pfades befinden muss. Wo genau, kann ich nicht sagen. Meine "
    "Krieger*innen wissen, dass das moeglich sein koennte, doch keine*r der "
    "Gefallenen ist bisher je zurueck gekehrt als Geist.",
    "sagt: ");

  AddInfo( ({"gefallene","gefallenen","geister der gefallenen"}),
    "Ich vermute, dass jene, die hier in den Schatten sterben, und als Geister "
    "in die materielle Welt zurueckkehren, ueber einen Zugang in der Naehe des "
    "Pfades wieder in die Schattenwelt gelangen koennen. Das geht aber sicherlich "
    "nur, solange sie auch noch Geister sind.",
    "sagt: ");

  AddInfo( ({"riss","portal"}),
    "Ich bin damals ueber einen Riss zwischen der materiellen und der Schattenwelt "
    "hierher gelangt. Ob es einen anderen Zugang gibt, weiss ich nicht genau. Aber "
    "ich habe Forschungen dazu angestellt.",
    "sagt: ");

  AddInfo( ({"forschungen"}),
    "Ich habe die Schatten und die Magie hier lange untersucht, und ich denke, "
    "es muesste einen weiteren Zugang zur Schattenwelt, neben dem Riss, geben.",
    "sagt: ");

  AddInfo( ({"schlachtfeld"}),
    "Das Schlachtfeld ist ein duesterer, blutiger Ort. Ich war dort, bevor ich "
    "hier her gelangte.",
    "sagt: ");

  AddInfo( ({"pfad","pfad des todes"}),
    "Der Pfad des Todes auf dem Schlachtfeld ist noch unbarmherziger als das "
    "Schlachtfeld selbst. Nachdem ich gemeinsam mit... meinem... mit einem grossen Krieger "
    "den Meisterschlaechter niederstreckte, erschien der Riss. Ich betrat ihn, seitdem "
    "bin ich hier.",
    "sagt: ");

  AddInfo( ({"meisterschlaechter"}),
    "Der Meisterschlaechter ist ein furchterregender, maechtiger Krieger in der "
    "materiellen Welt. Doch ich habe ihn besiegt!",
    "sagt: ");

  AddInfo( ({"grosser krieger"}),
    "Es war... er... er war... mein Gatte.",
    "sagt zittrig: ");

  AddInfo( ({"gatte","gatten"}),
    "Er fiel im ungleichen Kampf gegen den Meisterschlaechter. Mein Herz blieb fast "
    "stehen vor Trauer... doch dann die Wut... ich streckte ihn bruellend nieder! "
    "Aber was dann geschah... das Grauen... ich kann...",
    "sagt, mit Emotionen ringend: ");

  AddInfo( ({"grauen"}), #'grauen_info); //'

  AddInfo( ({"barriere"}),
    "Von welcher Barriere sprichst Du? Der Barriere zwischen den Welten, zwischen "
    "dieser schattenhaften Welt und der materiellen Welt?",
    "sagt: ");

  AddInfo( ({"lichtspiel"}),
    "Interessant, dass Du das erwaehnst. Einige Krieger*innen haben mir von "
    "ungewoehnlichen Lichtspielen in den Schatten berichtet. Ich kann nur "
    "mutmassen, dass es irgendetwas mit der Barriere zwischen den Welten "
    "zu tun hat. Vielleicht ist die Barriere dort irgendwie anders, und "
    "verursacht so das Lichtspiel.",
    "sagt: ");

  AddInfo( ({"barriere zwischen den welten","barriere zwischen welten",
    "barriere zwischen schattenhafter welt und materieller welt"}),
    "Die Barriere zwischen dieser schattenhaften Welt und der materiellen "
    "ist grundsaetzlich duenner, als zwischen anderen Welten. Ein Uebertritt "
    "von der materiellen, der 'normalen' Welt hierher war mir nur durch den "
    "Riss am Pfad moeglich. Ich glaube nicht, dass es einen Ausgang aus dieser "
    "Welt hier gibt. Und wenn doch, dann nur durch den Tod.",
    "sagt: ");

  AddInfo( ({"welt","welten"}),
    "Es gibt mehrere Welten im Silberland. Zum Beispiel die 'normale', materielle "
    "Welt. Dort sind unter anderem Midas oder Felonia angesiedelt. Die astrale "
    "Welt ist oft schwierig zu erreichen und zu verlassen, wie der Brunnen oder "
    "der Nexus. Die schattige Welt, in der wir uns hier befinden, ist ebenfalls "
    "Teil der astralen Welt.",
    "sagt: ");

  AddInfo( ({"astrale welt"}),
    "Die astrale Welt ist seltsam, magisch und oft schwer zu erklaeren. Manchmal "
    "ist sie voellig unlogisch, ja widerspruechlich! Vielleicht sind Dir die "
    "Ungereimtheiten der Wege hier schon einmal aufgefallen.",
    "sagt: ");

  AddInfo( ({"materielle welt","normale welt"}),
    "Die materielle Welt ist uns allen wohl bekannt. Grosse Teile des "
    "Silberlandes fussen auf ihr. Doch die astrale Welt ist verworren und "
    "zugleich faszinierend!",
    "sagt: ");

  AddInfo( ({"ungereimtheiten"}),
    "Sprichst Du von den Ungereimtheiten der Wege?",
    "sagt: ");

  AddInfo( ({"ungereimtheiten der wege"}),
    "Es scheint, hier in den Schatten sind Wege nicht immer erklaerbar. Manchmal "
    "geht man in eine Richtung, und kommt nicht zurueck, wenn man anschliessend "
    "in die Gegenrichtung geht. Die Schatten verzerren die Geographie scheinbar "
    "nach Lust und Laune.",
    "sagt: ");

  AddInfo( ({"geographie"}),
    "Die Geographie in den Schatten ist oft unerklaerlich.",
    "sagt: ");

  AddInfo( ({"leibwaechter","leibwaechterin","leibwaechter*innen"}),
    "Meine Leibwaechter*innen sind exzellent ausgebildete Krieger*innen und "
    "Druid*innen!",
    "sagt: ");

  AddInfo( ({"krieger*innen","krieger","kriegerinnen"}),
    "Alle hier sind furchtlose Krieger*innen und verdienen hoechsten Respekt ",
    "fuer ihre Entscheidung, hierher zu kommen. Sie bekaempfen die Schatten, "
    "um die Macht des Boesen hier in Zaum zu halten.",
    "sagt: ");

  AddInfo( ({"macht des boesen", "boese", "selbstzweck"}),
    "Die mutigen Krieger*innen, die hierher kamen, bekaempfen die Schattenwesen "
    "zum Selbstzweck: Das Boese muss vernichtet werden.",
    "sagt: ");

  AddInfo( ({"druiden","druid*innen","druidinnen","druidenzirkel"}),
    "Der Druidenzirkel ist eine maechtige und vielseitige Gilde. Ich habe "
    "hoechstes Vertrauen in ihre Faehigkeiten, daher sind immer Druid*innen "
    "unter meinen Leibwachen.",
    "sagt: ");

  AddInfo( ({"gilden"}),
    "Gilden gibt es im Silberland etliche, doch die Druiden ragen heraus!",
    "sagt: ");

  AddInfo( ({"entscheidung"}),
    "Alle Krieger*innen hier haben sich bewusst entschieden, in die Schatten "
    "zu kommen. Sie erhielten das Angebot, und haben es angenommen.",
    "sagt: ");  

  AddInfo( ({"angebot"}),
    "Eine unbekannte Macht, vielleicht ein Avatar von Wraz oder gar ein Gott, "
    "waehlt sorgfaeltig aus, "
    "wem das Angebot, in die Schatten zu kommen, unterbreitet wird. Eines "
    "haben alle gemeinsam, denen das Angebot unterbreitet wurde: Sie sind "
    "maechtig und mutig, und sie moechten das Boese in dieser Welt ausradieren.",
    "sagt: ");
  
  AddInfo( ({"macht","unbekannte macht"}),
    "Diese Macht ist unbekannt. Ich habe viel geforscht, doch keine logische "
    "Ursache gefunden, wem das Angebot unterbreitet wird. Die Krieger*innen "
    "sagen, es erschien ihnen vor ihren inneren Augen, ganz klar und deutlich. "
    "Und obwohl es nicht real war, war ihnen doch klar, dass es echt war. Sie "
    "wussten genau, was zu tun ist, um das Angebot, in die Schatten zu kommen, "
    "anzunehmen. Danach erschienen sie hier, irgendwo. Und sie kaempften sich "
    "bis hier ins Lager durch - oder starben, bei dem Versuch.",
    "sagt: ");

  AddInfo( ({"ursache", "logische ursache"}),
    "Ich konnte keine logische Ursache finden. Daher vermute ich, dass eine "
    "mir unbekannte Macht die Angebote unterbreitet. Eine Macht wie ein Gott, "
    "oder vielleicht auch nur ein maechtiger Magier wie Wraz.",
    "sagt: ");

  AddInfo( ({"schattenpanzer"}),
    "Damit kenne ich mich nicht aus, aber vielleicht weiss Liseth etwas "
    "darueber.",
    "sagt: ");

  AddInfo( ({"schreckgespenst"}),
    "Es stand am Pfad des Todes. Woher weisst Du das?",
    "sagt mit dunklem Blick: ");

  AddInfo( ({"leiterin","leitung"}),
    "Ich bin die Leiterin dieses Lagers! Die Krieger*innen finden hier "
    "Zuflucht und Schutz, dank meinem Zauber. Ich sorge hier fuer "
    "Ordnung.",
    "sagt: ");

  AddInfo( ({"schutz"}),
    "Das Lager bietet Schutz vor den Schattenwesen, denn ich habe es "
    "mit einem Zauber belegt.",
    "sagt: ");

  AddInfo( ({""}),
    "",
    "sagt: ");

  AddInfo( ({""}),
    "",
    "sagt: ");

  AddInfo( ({""}),
    "",
    "sagt: ");

  SetProp(P_SPELLRATE,100);

  AddDefaultSpell(2,750,DS_BLIND,
    Name()+" blendet Dich mit einem Zauber!\n",
    Name()+" blendet @WEN mit einem Zauber!\n");

  AddDefaultSpell(1,250,DS_FROG,
    Name()+" spricht eine magische Formel und deutet auf Dich.\n",
    Name()+" spricht eine magische Formel und deutet auf @WEN.\n");

  AddDefaultSpell(1,450,DS_PARALYZE,
    Name()+" spricht eine magische Formel und deutet auf Dich.\n",
    Name()+" spricht eine magische Formel und deutet auf @WEN.\n");

  AddDefaultSpell(1,350,DS_DISARM,
    Name()+" spricht eine magische Formel und deutet auf Dich.\n",
    Name()+" spricht eine magische Formel und deutet auf @WEN.\n");

  AddDefaultSpell(1,450,DS_SLOW,
    Name()+" spricht eine magische Formel und deutet auf Dich.\n",
    Name()+" spricht eine magische Formel und deutet auf @WEN.\n");

  AddDefaultSpell(1,250,DS_ANTIMAGIC,
    Name()+" spricht eine magische Formel und deutet auf Dich.\n",
    Name()+" spricht eine magische Formel und deutet auf @WEN.\n");

  AddDefaultSpell(3,850,DS_MASS_DAMAGE,
    Name()+" erzeugt einen grellen Lichtblitz!\n",
    Name()+" erzeugt einen grellen Lichtblitz!\n",
    DT_LIGHT);

  SetAttackChats(10,
  ({Name(WER, 1)+" blickt Dich kalt an.\n",
   Name(WER, 1)+" flucht wild!\n"
   }));

  SUID;

}

//--Defend--------------------------------------------------------------
int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  if(!random(4)) TO->ModifySkillAttribute(TO,SA_SPEED,150+random(151),6+random(5));

  if(!random(2))
  {
    dam /= 4;
    enemy->Message(BS(Name()+" weicht Deinem Angriff geschickt aus!"));
  }

  return ::Defend(dam, dtypelist, spell, enemy);
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "aergerlich":
    case "albern":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "fragt Dich: Was soll das?",
        "fragt "+capitalize(getuid(TP))+": Was soll das?",
        0);
      break;

    case "froh":
    case "neutral":
    case "nett":
      call_out("reaction", 0, TP,
        "nickt.",
        "nickt.",
        0);
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "faehrt Dich scharf an: Nein!",
        "faehrt "+capitalize(getuid(TP))+" scharf an: Nein!",
        0);
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt: Kopf hoch!",
        "sagt zu "+capitalize(getuid(TP))+": Kopf hoch!",
        0);
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere, int kill)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );

  if(kill) Kill(pl);
}

void init()
{
  ::init();
  if(TP && TP->id("\nposeyfriends")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  if(!random(3)) command_me("sag Vernichtet den Eindringling!");
  Kill(enemy);
}

void grauen_sequence()
{
  string message;
  string text;
  string indent;
  int i;

  i = 8; // default Sekunden zwischen call_out()

  if(InFight())
  {
    if(TO && ENV(TO))
      ENV(TO)->Message(BS(Name()+" bricht die Erzaehlung aufgrund des Kampfes ab."));
    i_seq = 0;
    return;
  }

  switch (i_seq)
  {
    case 0:
      text = "Als der Schlaechter starb, krochen "
        "die Schatten aus ihm heraus und in den Koerper meines gefallenen Gatten hinein.";
      indent = Name()+" sagt, sich mit Muehe beherrschend: ";
      i = 9;
    break;

    case 1:
      text = "Ein Wesen von "
      "unfassbarem Schrecken erhob sich, und mein Innerstes gefror vor Furcht.";
      indent = Name()+" sagt bebend: ";
      i = 9;
    break;

    case 2:
      text = "Ich sah "
      "die Qualen in den dunklen Augen des schrecklichen Wesens, und ich sah, dass die "
      "Seele meines geliebten Gatten darin verzweifelt gegen das Boese kaempfte.";
      indent = Name()+" fluestert: ";
      message = Name()+" schluchzt.";
      i = 11;

    break;

    case 3:
      text = "Doch war er chancenlos.";
      indent = Name()+" sagt dunkel: ";
    break;

      
    case 4:
      text = "Ich musste ihn von seinen untoten Qualen erloesen, also vernichtete "
      "ich das schattige Wesen, das seine Seele gefangen hielt...";
      indent = Name()+" sagt bestimmt: ";
    break;

    case 5:
      text = "Ich musste ihn toeten, es war die einzige Erloesung fuer ihn!";
      indent = Name()+" fluestert: ";
      message = "Du fuehlst eisige Kaelte.";
      break;

    case 6:
      text = "Doch egal was der Grund war... ich... habe ihn getoetet, meinen Geliebten!";
      indent = Name()+" sagt hart: ";
    break;

    case 7:
      text = "Als er in schwarzen Nebel zerfloss und sich der Riss oeffnete, sah "
      "ich keinen Grund mehr, in der Welt zu verweilen. Es war mir egal... zu leben... zu "
      "sterben.";
      indent = Name()+" sagt: ";
      message = "Du fuehlst ergriffen die Kaelte und Leere in ihren Worten.";
    break;
      
    case 8:
      text = "Da betrat ich den Riss und ergab mich meinem Schicksal.";
      indent = Name()+" sagt gefasst: ";
    break;
      
    case 9:
      text = "Einzig mein lieber Sohn fehlt mir sehr.";
      indent = Name()+" sagt: ";
      message = Name()+" wendet sich kurz ab, in Erinnerungen versunken.";
    break;

    case 10:
      text = "Um die Erinnerungen zu verdraengen, verschleiere ich mein Aeusseres. Aber "
      "da Ihr jetzt die Wahrheit kennt, kann ich es genausogut lassen.";
      indent = Name()+" sagt: ";
      message = Name()+" beginnt einen Zauber zu wirken.";
      call_out("disguise",6,0);
      i = 12;
    break;

    case 11:
      EPMASTER->GiveExplorationPoint("schattenwelt_posey_grauen", EP_MISC); 
      text = "Ich bin ein Hobbit. Mein Sohn heisst Ahtawqa, mein wirklicher Name ist "
      "Adaldria Flinkfuss. Und nun, lasst mich bitte in Ruhe.";
      indent = Name()+" sagt: ";
      message = Name()+" wendet sich von Dir ab.";
    break;

    default:
      i_seq = 0;
      return;
      break;
  }
  if(TO && ENV(TO)) ENV(TO)->Message("\n"+break_string(text,78,indent),MSGFLAG_SOUND);
  if(message && TO && ENV(TO)) ENV(TO)->Message(BS(message));
  i_seq++;
  if(find_call_out("grauen_sequence")==-1) call_out("grauen_sequence",i);
}

string grauen_info()
{
  if(InFight()) return "hat im Kampf keine Zeit dafuer.";

  if(QueryProp(P_RACE)=="Fee")
  {
    if(find_call_out("grauen_sequence")==-1)
    {
      call_out("grauen_sequence",6);
      return "setzt zu einer laengeren Erzaehlung an: Mein Gatte fiel, doch er blieb "
        "nicht gefallen...";
    }
    else return "erzaehlt doch bereits!";
    
  }
  else return "sagt: Frag mich bitte nicht mehr danach.";
  
}

// Disguise
//  do_disguise = 1 -> change to "Fee"
//  do_disguise = 0 -> change to "Hobbit"
//  do_disguise = 2 -> Aufruf kommt erstmalig aus create() --> "Fee"
int disguise(int do_disguise)
{
  if(do_disguise == 1 && QueryProp(P_RACE) == "Fee") return 0; // ist bereits disguised (Fee)
  else if(!do_disguise && QueryProp(P_RACE) == "Hobbit") return 0; // ist bereits un-disguised (Hobbit)

  else if (do_disguise) // disguise: Hobbit -> Fee; ODER (wenn disguise == 2) -> erstmaliger Aufruf in create()
  {
    SetProp(P_RACE, "Fee");

    if(do_disguise != 2)
    {
      if(ENV(TO)) ENV(TO)->Message(BS(Name()+" spricht einige magische Silben und verwandelt "
        "sich zugleich in eine Fee."),MSGFLAG_VISUAL);
      RemoveId(({"hobbit", "adaldria", "flinkfuss", "adaldria flinkfuss"}));
    }
    AddId(({"fee", "posey", "olivenwein", "posey olivenwein"}));
      
    SetProp(P_SHORT, "Posey Olivenwein");
    SetProp(P_LONG,
      "Posey Olivenwein ist eine Fee. Sie blickt Dich streng aus ihren graugruenen Augen "
      "an, als erwarte sie jederzeit eine Gefahr. Fuer eine Fee ist sie erstaunlich gross, "
      "und ihre Fluegel hat sie anscheinend gut unter ihrer Kleidung versteckt. Irgendetwas "
      "an ihrem Blick sagt Dir, dass eine versteckte Traurigkeit tief in ihr sitzt." );

    SetProp(P_NAME, "Posey");

    SetProp(P_HANDS, ({" mit ihren Haenden"
                      ,QueryProp(P_HANDS)[1]
                      , ({DT_BLUDGEON}) }));

    AddInfo( ({"fee"}),
    "Was genau moechtest Du ueber Feen wissen? Ich bin jedenfalls eine.",
    "sagt genervt: ");

    AddInfo( ({"ahtawqa","sohn"}),
    "Wer soll das sein?",
    "sagt verstoert: ");

    AddInfo( ({"posey","posey olivenwein"}),
    "Das ist mein Name.",
    "sagt: ");

    AddInfo( ({"olivenwein"}),
    "Das ist mein Nachname. Klingt er nicht wundervoll?",
    "sagt: ");

    AddInfo( ({"adaldria","adaldria flinkfuss"}),
    "Wer soll das sein?",
    "sagt irritiert: ");

    AddInfo( ({"flinkfuss"}),
    "Wer soll das sein?",
    "sagt irritiert: ");

    return 1;
  }

  else if (!do_disguise) // un-disguise: Fee -> Hobbit
  {
    SetProp(P_RACE, "Hobbit");

    if(ENV(TO) && QueryProp(P_CLONE_TIME) < time()-4)
      ENV(TO)->Message(BS(Name()+" spricht einige magische Silben und verwandelt "
      "sich zugleich in eine Hobbitfrau."),MSGFLAG_VISUAL);

    SetProp(P_SHORT, "Adaldria Flinkfuss");
    SetProp(P_LONG,
      "Adaldria ist eine Hobbitfrau. Sie blickt Dich streng aus ihren graugruenen Augen "
      "an, als erwarte sie jederzeit eine Gefahr. Irgendetwas "
      "an ihrem Blick sagt Dir, dass eine versteckte Traurigkeit tief in ihr sitzt." );

    SetProp(P_NAME, "Adaldria");
    RemoveId(({"fee", "posey", "olivenwein", "posey olivenwein"}));
    AddId(({"hobbit", "adaldria", "flinkfuss", "adaldria flinkfuss"}));

    SetProp(P_HANDS, ({" mit ihren pelzigen Haenden"
                      ,QueryProp(P_HANDS)[1]
                      , ({DT_BLUDGEON}) }));

    AddInfo( ({"fee"}),
    "Mit einem Zauber wandle ich meine Erscheinung meist in eine Fee. Der Anblick meines "
    "Hobbitkoerpers erinnert mich zu sehr an meine Vergangenheit...",
    "sagt: ");

    AddInfo( ({"ahtawqa","sohn"}),
    "Er ist ein guter, geschickter Junge! Ich hoffe, es geht ihm gut, aber ich werde ihn "
    "nie wieder sehen. Ich koennte ihm nicht unter die Augen treten nachdem, was ich "
    "getan habe...",
    "sagt traurig: ");

    AddInfo( ({"posey","posey olivenwein"}),
    "Das ist der Name, den ich als Fee nutze.",
    "sagt: ");

    AddInfo( ({"olivenwein"}),
    "Das ist der Name, den ich als Fee nutze.",
    "sagt: ");

    AddInfo( ({"adaldria","adaldria flinkfuss"}),
    "Das ist mein wahrer Name.",
    "sagt: ");

    AddInfo( ({"flinkfuss"}),
    "Das ist mein wahrer Nachname. Wir Flinkfussens haben uns diesen sehr verdient, denn "
    "wenn es darauf ankommt, sind wir enorm flink! Das gilt auch fuer meinen lieben "
    "Ahtawqa.",
    "sagt: ");

    return 1;
  }
}

void reset()
{
  ::reset();
  if(!is_clone(TO)) return;
  call_out("disguise",2,1);
}

void die(int poisondeath)
{
  object invis_posey_head;

  LOGMASTER->LogFile("specialnpcdeaths", TO->name(RAW), TP);

  // "last_posey_deathtime" -> reloads only every 24h
  call_other(ROOM "leiterinzelt","SetProp","last_posey_deathtime",time());

  // if disguised at death -> undisguise
  if(QueryProp(P_RACE)=="Fee")
  {
    ENV(TO)->Message(BS("Als das Leben aus Posey weicht, aendert sich ihr Aussehen und "
      "sie wird zu einer Hobbitfrau. Offenbar lag ein Zauber auf ihr."));
    SetProp(P_RACE, "Hobbit");
  }

  invis_posey_head = clone_object(OBJ "invis_posey_head");
  invis_posey_head->SetProp("posey_corpse_id", "leiche\n" + file_name(TO));
  invis_posey_head->move(ENV(TO));
  
  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) LOGMASTER->LogFile("playerdeaths", killer->name(RAW), player, lostexp);
}