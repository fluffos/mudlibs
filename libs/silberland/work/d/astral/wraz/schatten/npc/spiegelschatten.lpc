// Spiegelschatten
// Schattenwelt
// Von Wraz / Mendralim

#include "../def.h"
inherit "/std/npc/spells";
inherit "std/npc";
inherit NPC "npc.lpc";

int i = 0;
int hppc = 100; // Prozent der aktuellen Gruppen-HP
int myhppc = 100; // Prozent der aktuellen HP des Spiegelschattens
string *pl_names = ({});

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schatten");
  //SetProp(P_LONG,
   // "Der Schatten gleitet unheimlich ueber den Boden, ohne ein passendes, festes "
    //"Objekt zu begleiten. Seine Zuege sind vage humanoid.");

  AddDetail( ({""}),
    "");

  SetProp(P_NAME, "Schatten");
  SetProp(P_GENDER, MALE);
  AddId(({"schatten"}));

  create_default_shadownpc(29+random(3),0,1,10000);

  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) / 2 + 200); // halbe HP, aber mindestens 200

  //SetProp(P_XP, (QueryProp(P_XP)*7)/4);

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 100+random(201));
  SetProp(P_WEIGHT, 0);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  //SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@CAP_WER faellt einfach zu Boden.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " verschwindet.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "reagiert nicht.\n");

  AddInfo( ({""}),
  "","saeuselt: ");

  SetChats(1,
  ({Name(WER,1)+" wandert ueber den Boden.\n",
    "@@HideCalledByChat@@",
    "","","","","",""
   }));


  SetProp(P_SPELLRATE,30+6*diff_int);

  AddSpell(30,1,
    Name(WER,1)+" entzieht Dir mit seiner Beruehrung Kraft.\n",
    Name(WER,1)+" entzieht @WEM mit seiner Beruehrung Kraft.\n",
    DT_MAGIC, "CastAttrDrain", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(1,1,
    "",
    "",
    DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );

  SUID;
}

// ------------------------------------------------------------------------------
int check_players()
{
  object pl;
  int hpmax;
  int hpcurrent;

  if(!TO || !ENV(TO)) return 0;

  i = 0;
  pl_names = ({});

  hpmax = 0;
  hpcurrent = 0;

  for(pl=first_inventory(ENV(TO));pl;pl=next_inventory(pl))
  {
    if(!query_once_interactive(pl)) continue;
    else 
    {
      pl_names += ({pl->Name()});
      i++;
      hpmax += pl->QueryProp(P_MAX_HP);
      hpcurrent += pl->QueryProp(P_HP);
    }
  }

  if(!i || !hpmax || !TO->QueryProp(P_MAX_HP)) return -1;

  myhppc = TO->QueryProp(P_HP) * 100 / TO->QueryProp(P_MAX_HP);
  hppc = hpcurrent * 100 / hpmax;

  return i;
}

// ------------------------------------------------------------------------------
string _query_long()
{
  string long_return;
  string *pl_names_not_TP;
  string current_name;
  int j;

  pl_names_not_TP = ({});

  check_players();

  for(j=0;j<sizeof(pl_names);j++)
    if(pl_names[j] != TP->Name()) pl_names_not_TP += ({pl_names[j]});

  long_return = "Der Schatten gleitet unheimlich ueber den Boden, ohne ein passendes, festes "
  "Objekt zu begleiten. Seine Zuege sind vage humanoid. Tatsaechlich erinnert "
  "er Dich an Dich selbst";

  if(sizeof(pl_names_not_TP)==0) 
    long_return += "!";
  else if (sizeof(pl_names_not_TP)==1) 
    long_return += (" und an "+pl_names_not_TP[0]+"!");
  else if (sizeof(pl_names_not_TP)==2) 
    long_return += (" und an "+pl_names_not_TP[0]+" und "+pl_names_not_TP[1]+"!");
  else if (sizeof(pl_names_not_TP)>=3) 
    long_return += (" und an "+implode(pl_names_not_TP[0..<2],", ")+
    " und "+pl_names_not_TP[<1]+"!");

  return BS(long_return);

}

// ------------------------------------------------------------------------------
void MirrorHealth()
{
  if(check_players() <= 0) return;

  if(hppc >= 2 && myhppc >= hppc) return; // Spiegelschatten hat bereits mehr HP-% als die Spielergruppe

  if(hppc <= 20) return; // Spielergruppe hat unter 20% HP

  else
  {
    ENV(TO)->Message(BS(TO->Name(WER,1)+" spiegelt "+(i>1?"Eure":"Deine")+" Lebenskraft."),
      MSGFLAG_SENSE);
    TO->SetProp(P_HP,TO->QueryProp(P_MAX_HP) * hppc / 100);
  }
  
}

//--Defend--------------------------------------------------------------
int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  if(!random(10) && find_call_out("MirrorHealth") == -1 && check_players())
  {
    ENV(TO)->Message(BS(TO->Name(WER,1)+" heftet sich an "+(i>1?"Eure":"Deine")+" Fuesse."),
      MSGFLAG_SENSE);
    call_out("MirrorHealth",2);
  }

  return ::Defend(dam, dtypelist, spell, enemy);
}

// ------------------------------------------------------------------------------
string HideCalledByChat()
{
  npc::hide();
  return "";
}

// ------------------------------------------------------------------------------
void CastAttrDrain(object enemy, int damage, mixed dam_type)
{
  object ob;
  ob = clone_object(OBJ "attr_drain");
  ob->Setup(([A_STR:-1-random(3)]));
  ob->move(enemy,M_NOCHECK);
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  DropShadowItems();
  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  CallPlayerDeathLog(player, killer, lostexp);
  //call_out("leiche_verwandeln",2+random(5));
}

