// Geist
// Schattenwelt
// Von Wraz / Mendralim

#include "../def.h"
inherit "/std/npc/spells";
inherit "/p/std/npc/nekro_npc"; // um von Nekros beherrscht werden zu koennen
inherit NPC "npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Geist");
  SetProp(P_LONG,
    "Dieser furchterregende Geist gleitet vollkommen lautlos durch die Luft. "
    "Seine Anwesenheit bereitet Dir grosses Unbehagen.");

  AddDetail( ({""}),
    "");

  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  AddId(({"geist"}));

  create_default_shadownpc(31+random(3),0,1,10000);

  SetProp(P_MAX_HP, 200+QueryProp(P_MAX_HP)); // mindestens 200 HP

  //SetProp(P_XP, (QueryProp(P_XP)*7)/4);

  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 150+random(41));
  SetProp(P_WEIGHT, 10);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  //SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@CAP_WER faellt durch den Geist einfach zu Boden.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_MSGIN, "gleitet herbei");
  SetProp(P_MSGOUT, "gleitet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "entschwindet");

  SetProp(P_DIE_MSG,  " loest sich in Nichts auf.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "blickt Dich eisig an.\n");

  AddInfo( ({""}),
  "","saeuselt: ");

  SetChats(1,
  ({"Der Geist gleitet durch einen festen Gegenstand einfach hindurch.\n",
    "@@HideCalledByChat@@",
    "","","","","",""
   }));


  SetProp(P_SPELLRATE,(10*diff_int>100?100:10*diff_int));

  AddDefaultSpell(30, 250+100*diff_int, DS_MASS_DAMAGE,
    Name(WER,1)+" faehrt durch Dich hindurch.\n",
    Name(WER,1)+" faehrt durch @WEN hindurch.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 400+80*diff_int, DS_MASS_FEAR,
   "Der Geist aechzt, dass Dir schaudert!\n");

  AddSpell(1,1,
    "",
    "",
    DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );

  SUID;
}

// ------------------------------------------------------------------------------
string HideCalledByChat()
{
  npc::hide();
  return "";
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  DropShadowItems();
  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  CallPlayerDeathLog(player, killer, lostexp);
  //call_out("leiche_verwandeln",2+random(5));
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 //if(!is_clone(TO)) return;
}
