    "Angriffe werden ihm vermutlich sogar zugute kommen."));

  create_default_shadownpc(40);

  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);

  SetProp(P_AGGRESSIVE, 0); // der Daemon ist verrueckt, aber nicht auto :)

  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_RESISTANCE_STRENGTHS, SHADOW_DEF_RESISTANCE_STR + 
   ([DT_FIRE: -0.9, DT_MIND: -0.9]) );
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)*3);
  SetProp(P_XP, QueryProp(P_XP)*2);

  SetProp(P_NOMAGIC,10);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" zerbroeselt @WEN zu Schatten.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " birst in tausende Schatten.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "blickt Dich leidend an.\n");

  AddInfo( ({"hilfe"}),
  "Hilfe? Hiiiiiilfe! Gibt's im Norden!","schreit irre: ");

  AddInfo( ({"wraz"}),
  "Wraz ist ein kranker HUND!","kichert irre: ");

  AddInfo( ({"auge"}),
  "Bringst Du es mir wieder? Oder habe ich es schon gefressen? Aahahahaha!",
  "saeuselt: ");

  AddInfo( ({"leid","qual"}),
  "Leid und Qual, brinst Du mir? Bring ich Dir! Haha - Hal! Haha - Hier! Haha, hoho, haha - Irr'!",
  "singt: ");

  AddInfo( ({"schattendrachin","schattendrache","vagghuthcerrvnippintaa"}),
  "Oohh, ohoo! Ihr seid also irgendwie an der dummen alten Vagghuthcerrvnippintaa vorbei gekommen? "
  "Gratuliere, ja, gratuliere! Ja...",
  "saeuselt: ");

  AddInfo( ({"norden"}),
  "Norden? Im Norden, da ist die Aza irgendwo, hihi, die wird Euch zerlegen! ZERLEGEN!! Und, im Norden, "
  "da hat der Wraz, der verfluchte Wraz, seine Avatare abgestellt. Ja, es stimmt, das hat er!",
  "kraechzt: ");

  AddInfo( ({"sueden"}),
  "Sueden, ganz sicher im Sueden! Da ist alles: Aza, Fingernagel, Wraz, Reichtum. Alles.",
  "kichert: ");

  AddInfo( ({"reichtum"}),
  "Im Sueden! Hm, oder war es Osten?",
  "sagt: ");

  AddInfo( ({"osten"}),
  "Der Reichtum ist dort! Im Westen natuerlich, natuerlich. Wo auch sonst?",
  "saeuselt lieblich: ");

  AddInfo( ({"westen"}),
  "Im Westen liegt die Aza, mit ganz, ganz breiten Beinen! Aahahahah!",
  "kraechzt: ");

  AddInfo( ({"beine","beinen"}),
  "Verrate es nicht weiter, Du Dreckschwein!",
  "fluestert: ");

  AddInfo( ({"dreckschwein","drecksschwein","schwein"}),
  "Drecki, Decki, Dreckschwein! *hust*",
  "raeuspert: ");

  AddInfo( ({"sex"}),
  "Mit Aza? HAHAHA, erbaermlich, Du Wurm!",
  "saeuselt und lacht: ");

  AddInfo( ({"wurm","penis"}),
  "Dein Wurm, ist erbaermlich!",
  "sagt: ");

  AddInfo( ({"hodenbeutel"}),
  "Es soll hier irgendwo einen geben! Aber ich weiss nicht, wo. Und wenn ich es wuesste...",
  "fluestert: ");

  AddInfo( ({"aza"}),
  "Die Aza, die alte Magierin. Wenn Ihr dort vorbei kommt, wird sie euch belohnen! Reichlich belohnen! "
  "Nennt einfach meinen Namen, kein Problem!",
  "saeuselt: ");

  AddInfo( ({"avatare"}),
  "Die Avatare von Wraz, die sind im Norden, ganz sicher nicht! Die sind im Sueden. Einer ist einfach nur "
  "ein Fingernagel. Harmlos. *kicher*",
  "saeuselt: ");

  AddInfo( ({"fingernagel","avatar"}),
  "Einer von Wraz' Avataren ist nichts weiter als ein kleiner Zehennagel. Sagte ich Fingernagel? Nein, ich "
  "sagte Zehennagel! Voellig ungefaehrlich, einfach umschnippen und erledigt.",
  "saeuselt grinsend: ");

  AddInfo( ({"zehennagel"}),
  "Zehenhagel? Wovon sprecht Ihr? Seid Ihr nicht bei Sinnen?",
  "sagt ernst: ");

  AddInfo( ({"sinn","sinne","sinnen"}),
  "Sinn, sim, simte-di-bim!",
  "summt: ");

  AddInfo( ({"zehenhagel"}),
  "Es ist ein Fingernagel, der Avatar von Wraz! Brandgefaehrlich! Aber zuerst muesst ihr ohnehin an mir "
  "vorbei. Soll ich Euch einfach vorbei lassen? Das waere doch was, oder? Oder nein, nein, nein! Toetet "
  "mich doch einfach, ja? Ganz einfach! Ja!",
  "fluestert: ");

  SetChats(1,
