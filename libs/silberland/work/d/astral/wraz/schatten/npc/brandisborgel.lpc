// Brandisborgel
// Schattenwelt, NPC Endgegner Raum 199
// Von Wraz / Mendralim

#include "../def.h"
inherit "/std/npc/spells";
inherit "std/npc";
inherit NPC "npc.lpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Der Daemon Brandisborgel, der Gequaelte");
  SetProp(P_LONG,
    "Der Daemon Brandisborgel sieht aus wie eine arme, misshandelte Menschengestalt. Sein "
    "Gesicht ist schmerzverzerrt und blutueberstroemt. Ein Auge fehlt, eine fuerchterliche "
    "Hoehle hinterlassend. Das andere blickt wirr und aengstlich durch die Gegend. "
    "Der Koerper ist offensichtlich "
    "geschunden und gefoltert, in zerfetzten Lumpen steht er auf scheinbar wackeligen Beinen. "
    "Doch dann wechselt sein Blick, wird starr, dann ernst, dann... erschreckend! So "
    "verletzt er auf den ersten Blick scheint, bist Du Dir sicher, dass es reine Fassade ist, "
    "vielleicht aus alten Zeiten. Der Daemon ist toedlich gefaehrlich, das ist gewiss.");

  AddDetail( ({"auge"}),
    "Ein Auge des Daemons fehlt, es hinterlaesst eine haessliche Hoehle in seinem Gesicht.");

  AddDetail( ({"gesicht"}),
    "Das Gesicht Brandisborgels zeugt von unbeschreiblichen Qualen und Leid. Ein Auge fehlt.");

  AddDetail( ({"qualen","qual","leid"}),
    "Der Daemon ist gezeichnet von unbeschreiblichen Qualen.");

  AddDetail( ({"lumpen"}),
    "Nur zerfetzte Lumpen haengen vom geschundenen Leib des Daemons.");

  AddDetail( ({"leib","koerper","narben","wunden"}),
    "Der Koerper Brandisborgels ist von schrecklichen Narben und offenen Wunden uebersaeht. "
    "Er muss furchtbares Leid durchgemacht haben.");

  AddDetail( ({"blick","fassade"}),
    "Der Blick des Daemons ist ambivalent. Zuerst glaubst Du, dass er gebrochen und verwirrt "
    "ist, doch dann durchschaust Du die Fassade! Er muss wahnsinnig sein, und ebenso wahnsinnig "
    "gefaehrlich.");

  SetProp(P_NAME, ({"Brandisborgel der Gequaelte","Daemons Brandisborgel",
    "Brandisborgel dem Gequaelten", "Brandisborgel den Gequaelten"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"brandisborgel", "gequaelte", "brandisborgel der gequaelte", "daemon",
   "daemon brandisborgel"}));
  //AddId(({"NOWIMPY", "\nschattenweltnpc", "\nschattenwache"}));
  set_living_name("brandisborgel");

  SetProp(P_INFO, BS("Der Wahnsinn in Brandisborgels Auge zeugt von einem traurigen, "
