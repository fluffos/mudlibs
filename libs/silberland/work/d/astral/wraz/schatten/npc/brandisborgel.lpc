    Name(WER,1)+" jammert: Mein Auge! Mein wunderschoenes Auge! Aaahhh!\n",
    Name(WER,1)+" stoehnt schmerzerfuellt.\n",
    Name(WER,1)+" schluchzt herzzerreissend.\n",
    Name(WER,1)+" bittet Dich, sein Leid zu beenden.\n",
    Name(WER,1)+" kichert boshaft.\n","","",""
   }));


  SetProp(P_SPELLRATE,35);

  AddSpell(10,1250,
    BS(Name(WER,1)+" stoehnt so gequaelt, dass Dir das Blut in den Adern gefriert!"),
    BS(Name(WER,1)+" stoehnt so gequaelt, dass @WEM das Blut in den Adern gefriert!"),
    DT_TERROR, "SlowSpell", ([SP_SHOW_DAMAGE:0]) );

  AddDefaultSpell(3,1, DS_ANTIMAGIC,
    BS(Name(WER,1)+" blickt Dich an und steigert sein Stoehnen in hysterisches Gelaechter, "
      "Du fuehlst Dich von dieser "
      "Kakophonie extrem ausgelaugt."),
    BS(Name(WER,1)+" blickt @WEN an und steigert sein Stoehnen in hysterisches Gelaechter, "
      "@PWER scheint von dieser "
      "Kakophonie extrem ausgelaugt."),
    DT_TERROR, "SlowSpell", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(5,950,
    BS(Name(WER,1)+" blickt Dich aus seiner graesslichen, leeren Augenhoehle an, und es wird schwarz!"),
    BS(Name(WER,1)+" blickt @WEN aus seiner graesslichen, leeren Augenhoehle an!"),
    DT_TERROR, "BlindSpell", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(2,1,
    BS(Name(WER,1)+" kreischt unerwartet auf, steigert das Gekreische immer weiter und geht dann "
      "... in ein Lachen ueber?! Ein hysterisches Lachen! Danach scheint er erholt."),
    BS(Name(WER,1)+" kreischt unerwartet auf, steigert das Gekreische immer weiter und geht dann "
      "... in ein Lachen ueber?! Ein hysterisches Lachen! Danach scheint er erholt."),
    DT_TERROR, "HealSpell", ([SP_SHOW_DAMAGE:0]) );

  AddDefaultSpell(5, 800, DS_DISARM,
    BS(Name(WER,1)+" laesst Dich all sein erlebtes Leid fuehlen, und Deine Muskeln erschlaffen kurz."),
    BS(Name(WER,1)+" laesst @WEN all sein erlebtes Leid fuehlen, und @WESSEN Muskeln erschlaffen kurz."));

  AddDefaultSpell(5, 1200, DS_PARALYZE,
    BS("In Deinem Geiste erscheinen all die graesslichen Qualen, die "+Name(WER,1)+
      " zu Lebzeiten ertragen musste! Du erstarrst vor Schrecken!"),
    BS("@WER reisst die Augen vor Schreck weit auf und erstarrt!"));
  
  AddSpell(1,1,
    "",
    "",
    DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );

  SUID;
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
void HealSpell(object enemy, int damage, mixed dam_type)
{
  int healing;
  healing = 1000+random(500);
  TO->AddHp(healing);
  DB("Brandisborgel heilt "+healing+" HP -> "+QueryProp(P_HP)+
    "/"+QueryProp(P_MAX_HP)+"\n");
}

// ------------------------------------------------------------------------------
void BlindSpell(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_BLIND, ([BLIND_TIME:30+random(15),
    BLIND_MSG:BS("Du siehst nur die schreckliche Dunkelheit in Brandisborgels leerer Augenhoehle!"),
    BLIND_END_MSG:BS("Der Terror weicht aus Dir, und Du kannst wieder sehen.")]));
}

// ------------------------------------------------------------------------------
void SlowSpell(object enemy, int damage, mixed dam_type)
{
  enemy->ModifySkillAttribute(TO,SA_SPEED,50-random(26),6+random(5));
}

// HealingRoomInfo -----------------------------------------------------
// Info an Spieler, ob sie mehr Schaden machen als sie heilen
void HealingRoomInfo(int previous_hp)
{
  int hp_diff;
  string str;

  hp_diff = QueryProp(P_HP) - previous_hp;

  switch (hp_diff)
  {
    case -100000..-1000: str = "massiv schlechter"; break;
    case -999..-100: str = "wesentlich schlechter"; break;
    case -99..-50: str = "deutlich schlechter"; break;
    case -49..-10: str = "schlechter"; break;
    case -9..9: str = "weder besser noch schlechter"; break;
    case 10..49: str = "besser"; break;
    case 50..99: str = "deutlich besser"; break;
    case 100..999: str = "wesentlich besser"; break;
    case 1000..100000: str = "massiv besser"; break;
    default: str = "undefinierbarer"; break;
  }
  DB("* Brandisborgel: hp_diff="+hp_diff+" HP:"+QueryProp(P_HP)+" previous_hp:"+previous_hp+"\n");
  ENV(TO)->Message(BS(TO->Name(WER)+" sieht nach diesen Attacken "+str+" aus als zuvor."));
  return;
}

//--Defend--------------------------------------------------------------
int Defend(int dam, string *dtypelist, int spell, object enemy)
{

  int i, found, healing, physical_dam_factor;
  string *healing_dam_types;

  if(stringp(dtypelist)) dtypelist = ({dtypelist});

  healing_dam_types = ({ DT_SLASH, DT_BLUDGEON, DT_PIERCE,DT_SQUEEZE, DT_WHIP, DT_RIP});
  found = 0;

  for(i=0;i<sizeof(healing_dam_types);i++)
  {
    // Debug scrollt massiv, also Vorsicht :)
    //DB("i: "+i+"\n");
    //DB("healing_dam_types[i]: "+healing_dam_types[i]+"\n");
    //DB("dtypelist: "+(dtypelist?implode(dtypelist," "):"0")+"\n");
    if(healing_dam_types[i] && member(dtypelist,healing_dam_types[i]) != -1) found += 1;
  }

  physical_dam_factor = sizeof(dtypelist) / (found > 0 ? found : 1);
  physical_dam_factor = physical_dam_factor > 0 ? physical_dam_factor : 1;

  //DB("sizeof: "+sizeof(dtypelist)+
  //" found: "+found+
  //" physical_dam_factor: "+physical_dam_factor+"\n");

  if(found)
  {
    healing = (30+random(dam)) / physical_dam_factor / 10;
    TO->AddHp(healing);
    dam = dam - dam / physical_dam_factor; // zuvor: dam /= 2
    ENV(TO)->Message(BS(Name(WER,1)+" stoehnt voller Leid auf, doch lacht dann lustvoll: Oh ja, "
      "mehr! Gib mir MEHR davon!!"));

    if(find_call_out("HealingRoomInfo") == -1) call_out("HealingRoomInfo",4,QueryProp(P_HP));
    //DB(QueryProp(P_HP)+"\n");

    DB("* Brandisborgel nimmt ca. "+(dam/10)+" Schaden und heilt "+healing+" HP (Bilanz: "+
     (healing-(dam/10))+") -> "
     +QueryProp(P_HP)+
     "/"+QueryProp(P_MAX_HP)+"\n");
  }

  return ::Defend(dam, dtypelist, spell, enemy);
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  object start_room;

  DropShadowItems(10000000); // 1000% Chance-Basis (siehe npc.c)
  if(!random(40)) CLONEME("/d/astral/lamuerte/brunnen/armour/staubschild");
  if(!random(20)) CLONEME("/d/astral/lamuerte/brunnen/armour/feldherrenguertel");
  if(!random(30)) CLONEME("/d/astral/lamuerte/brunnen/armour/silmaril");
  if(!random(20)) CLONEME("/d/astral/lamuerte/brunnen/armour/kupferohrring");
  CLONEME(OBJ "auge");
  if(!random(2)) CLONEME(ARMOUR "schattenguertel");
  if(!random(2)) CLONEME(ARMOUR "schattenguertel");
  if(!random(2)) CLONEME(ARMOUR "schattenstiefel");
  if(!random(2)) CLONEME(ARMOUR "schattenstiefel");
  if(!random(8)) CLONEME(ARMOUR "schattenamulett");
  if(!random(2)) CLONEME(ARMOUR "schattenbeinkleid");

  // Boss Resetzeit (siehe ROOM sn_template.c)
  if(start_room = find_object(ROOM + "sn" + RMASTER->get_lead_zeros(QueryProp("shadow_room_no"))))
    call_other(start_room, "SetProp", "last_boss_death", time());
  else DB(BS("Brandisborgel: Raum "+QueryProp("shadow_room_no")+" nicht gefunden!") );

  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  CallPlayerDeathLog(player, killer, lostexp);
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 if(!is_clone(TO)) return;
}
