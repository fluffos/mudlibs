// Chaosfraggle (Vorlage: /d/ebene/Midas/npc/fraggle.c von Woody)
// Schattenwelt
// Von Wraz / Mendralim

#include "../def.h"
inherit "/std/npc/spells";
inherit "/p/std/npc/nekro_npc"; // um von Nekros beherrscht werden zu koennen
inherit NPC "npc.lpc";

create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Ein Chaosfraggle");
  SetProp (P_LONG, "Dieser Chaosfraggle ist weniger eklig als boesartig, und Cookies "
    "hat er auch keine dabei.");
  SetProp (P_INFO, "Der Chaosfraggle scheint wirklich extrem boese zu sein.\n");
  SetProp (P_NAME, ({"Chaosfraggle", "Chaosfraggles", "Chaosfraggle", "Chaosfraggle"}) );
  SetProp (P_GENDER, MALE);
  AddId (({"fraggle","chaosfraggle"}));

  create_default_shadownpc(14+random(3),0,0,3000); // level, maxhp, incorp, hplimit = 3000

  SetProp(P_MAX_HP, 100+QueryProp(P_MAX_HP)); // mindestens 100 HP

  SetProp (P_HANDS, ({" mit seinen ekligen Pfoten", QueryProp(P_HANDS)[1] , ({DT_BLUDGEON}) }));
  SetProp (P_ALIGN, -600);
  SetProp (P_SIZE, 30+random(10));
  SetProp (P_RACE, "Fraggle");
  SetProp (P_FOOD, 0);

  SetChats(1,
  ({Name(WER,1)+" stiert Deine Knie an.\n",
    "@@HideCalledByChat@@",
    "","","","","",""
   }));

   SetAttackChats(10,
  ({Name(WER,1)+" beschimpft Dich wuest.\n",
    Name(WER,1)+" streckt Dir seine haessliche Zunge raus.\n"}));

  SetProp(P_SPELLRATE,20+2*diff_int);

  AddSpell(30, 100+40*diff_int,
    Name(WER,1)+" bohrt Dir ein Loch ins Knie.\n",
    Name(WER,1)+" bohrt @WEM ein Loch ins Knie.\n",
    DT_PIERCE, "AttackKnee", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,
    "",
    "",
    DT_MAGIC, "hide", ([SP_SHOW_DAMAGE:0]) );

  SUID;
}

// ------------------------------------------------------------------------------
string HideCalledByChat()
{
  npc::hide();
  return "";
}

// ------------------------------------------------------------------------------
void AttackKnee(object enemy, int damage, mixed dam_type)
{
  object ob;

  if(random(enemy->QueryAttribute(A_DEX)) < 4)
  {
    enemy->Message(BS(Name(WER,1)+" bohrt so tief, dass Du Dein Bein nicht mehr bewegen kannst."));
    enemy->SetProp(P_NOMOVE, "Du hast ein Loch im Knie und kannst nicht gehen!\n");

    ob = clone_object(OBJ "loch_im_knie");
    ob->Setup(enemy);
    ob->SetProp(P_X_ATTR_MOD,([A_DEX:-1-random(5)]));
    ob->move(enemy,M_NOCHECK);
  }
}

// ------------------------------------------------------------------------------
void hide(object enemy, int damage, mixed dam_type, string room_file_name)
{
  npc::hide(enemy,damage,dam_type,room_file_name);
}

// ------------------------------------------------------------------------------
int _query_paralyzed() {return 0;}
nosave int _set_paralyzed(mixed para) {return 0;}

// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  DropShadowItems();
  CallNPCKillLog();

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  CallPlayerDeathLog(player, killer, lostexp);
  //call_out("leiche_verwandeln",2+random(5));
}

// ------------------------------------------------------------------------------
void reset()
{
 ::reset();
 //if(!is_clone(TO)) return;
}
