// ------------------------------------------------------------------------------
void die(int poisondeath)
{
  object gems, start_room;

  DropShadowItems(10000000); // 1000% Chance-Basis (siehe npc.c)
  if(!random(20)) CLONEME("/d/astral/lamuerte/brunnen/armour/staubschild");
  if(!random(50)) CLONEME("/d/astral/lamuerte/brunnen/armour/feldherrenguertel");
  if(!random(20)) CLONEME("/d/astral/lamuerte/brunnen/armour/silmaril");
  if(!random(20)) CLONEME("/d/astral/lamuerte/brunnen/armour/kupferohrring");
  CLONEME(ARMOUR "schattenhandschuhe");
  CLONEME(ARMOUR "schattenhandschuhe");
  if(!random(2)) CLONEME(ARMOUR "schattenhandschuhe");
  if(!random(2)) CLONEME(ARMOUR "schattenhandschuhe");
  if(!random(2)) CLONEME(ARMOUR "schattenring");
  if(!random(2)) CLONEME(ARMOUR "schattenring");
  if(!random(2)) CLONEME(ARMOUR "schattenhelm");
  if(!random(2)) CLONEME(ARMOUR "schattenhelm");
  if(!random(2)) CLONEME(ARMOUR "schattencape");
  if(!random(2)) CLONEME(ARMOUR "schattencape");
  if(!random(2)) CLONEME(ARMOUR "schattenstiefel");
  if(!random(2)) CLONEME(ARMOUR "schattenstiefel");
  CLONEME(OBJ "boerse");

  "/obj/gemmaster"->DistributeGem(400, 201, 0, TO, "opal");

  // Boss Resetzeit (siehe ROOM sn_template.c)
  if(start_room = find_object(ROOM + "sn" + RMASTER->get_lead_zeros(QueryProp("shadow_room_no"))))
    call_other(start_room, "SetProp", "last_boss_death", time());
  else DB(BS("Fingernagel: Raum "+QueryProp("shadow_room_no")+" nicht gefunden!") );

  CallNPCKillLog();

  if(ENV(TO) && !sizeof(ENV(TO)->QueryProp(P_EXITS)))
    ENV(TO)->reset(); // dabei werden die Ausgaenge wieder gesetzt

  ::die(poisondeath);
}

// ------------------------------------------------------------------------------
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  DB("NotifyPlayerDeath called\n");
  CallPlayerDeathLog(player, killer, lostexp);
}