// Schattenwelt, NPC Endgegner Raum 299
// von Wraz / Mendralim
//
// Avatar von Wraz: Fingernagel
// Ist kein Schattenwaechter (kann also einfach passiert werden)


#include "../def.h"
inherit "/std/npc/spells";
inherit "std/npc";
inherit NPC "npc.lpc";

int *shield = ({0,0});

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein riesiger, stehender Fingernagel");
  SetProp(P_LONG,
    "Dieser Fingernagel ueberragt einen Menschen um einen ganzen Kopf! Er steht hier, "
    "aufrecht, obwohl er eigentlich umfallen muesste. Er sieht schmutzig und gelblich aus, "
    "Risse ziehen sich ueber seine Oberflaeche, und ein wenig Dreck klebt an seiner "
    "Unterseite." );

  AddDetail( ({"schmutz", "unterseite", "dreck"}),
    "Brauner Schmutz klebt unregelmaessig verteilt an der nach unten gewoelbten Seite des riesigen "
    "Fingernagels.");

  AddDetail( ({"risse", "oberflaeche", "manikuere"}),
    "Einige ekelerregende Risse ziehen sich ueber die Oberflaeche des gelblichen "
    "Fingernagels, als haette der Traeger des Nagels sich wenig um Manikuere "
    "geschert.");

  AddDetail( ({"traeger"}),
    "Wer mag wohl der Traeger dieses Fingernagels gewesen sein? Ein riesiges Wesen? "
    "Oder ist der Fingernagel doch nur ein Konstrukt? Oder war es doch der maechtige Wraz, "
    "der ihn als Avatar erschuf?");

  AddDetail( ({"wesen"}),
    "Kein Wesen, das Du Dir vorstellen kannst, koennte gross genug sein, um diesen "
    "Fingernagel natuerlich am Koerper zu tragen.");

  AddDetail( ({"konstrukt", "nichts"}),
    "Waere moeglich, dass der Fingernagel nur magisch aus 'dem Nichts' erschaffen wurde.");

  AddDetail( ({""}),
    "");

  SetProp(P_INFO, BS("Es handelt sich hier definitiv um einen Avatar von Wraz."));

  SetProp(P_NAME, "Fingernagel");

  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"nagel","fingernagel","avatar", "\nwrazavatar", "NOWIMPY"})); // keine Schattenwache!
  set_living_name("fingernagel");
  SetProp(P_ARTICLE, 1);

  create_default_npc(49,50000+random(5000));

  SetProp(P_HANDS, ({" magisch"
                    ,600
                    , ({DT_MAGIC}) }));

  SetProp(P_RACE, "Avatar");

  SetProp(P_SIZE, 195);
  SetProp(P_WEIGHT, 6200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,50);

 SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      -0.9, DT_COLD:      -0.9, DT_WATER:       -0.9
     , DT_AIR:       -0.9, DT_LIGHTNING: -0.9, DT_EXPLOSION:   -0.9
     , DT_SOUND:     -0.9, DT_LIGHT:     -0.9, DT_ELECTRIC:    -0.9
     , DT_ACID:      -0.9, DT_POISON:    -0.9, DT_TERROR:      -0.9
     , DT_HOLY:      -0.9, DT_UNHOLY:    -0.9, DT_MAGIC:       -1.0
     , DT_MIND:      -0.9, DT_SLASH:      0.0,DT_BLUDGEON:     -0.8
     , DT_PIERCE:    -0.9, DT_SQUEEZE:   -0.7, DT_WHIP:        -0.9
     , DT_RIP:        0.1
     ]));

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" nimmt das nicht.\n" }) );

  SetProp(P_LOG_INFO, "/wraz/fragen_schatten");

  SetProp(P_DIE_MSG,  " sagt noch telepathisch 'Nagut.' und teleportiert sich fort.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "reagiert nicht.\n");

  AddInfo( ({"hilfe"}),
    "Hilfe? Wobei?",
    "spricht telepathisch: ");

  AddInfo( ({"wraz"}),
    "Ich bin Wraz.",
    "spricht telepathisch: ");

  AddInfo( ({"avatar","avatar von wraz","wraz' avatar"}),
    "Ich bin Wraz' Avatar, somit bin ich Wraz.",
    "spricht telepathisch: ");

  AddInfo( ({"norden"}),
    "Passiert nach Norden, wenn Ihr wuenscht. Ich werde euch nicht aufhalten.",
    "spricht telepathisch: ");

  AddInfo( ({"schatten","schattenwelt"}),
    "Die Schattenwelt wurde von mir erschaffen.",
    "spricht telepathisch: ");

  AddInfo( ({"brandisborgel"}),
    "Der Daemon ist eine traurige Gestalt, er fuegt sich gut in die Schattenwelt.",
    "spricht telepathisch: ");

  AddInfo( ({"aza"}),
    "Aza ist eine Magierin in der Schattenwelt.",
    "spricht telepathisch: ");

  AddInfo( ({""}),
    "",
    "spricht telepathisch: ");

  AddInfo( ({""}),
    "",
    "spricht telepathisch: ");

  AddInfo( ({""}),
    "",
    "spricht telepathisch: ");

  SetProp(P_SPELLRATE,100);

  AddSpell(5,550,
    BS(Name(WER,1)+" beschwoert einen Blitz vom Himmel!")+BS("Der Blitz streift Dich nur."),
    BS(Name(WER,1)+" beschwoert einen Blitz vom Himmel!")+BS("Der Blitz streift @WEN nur."),
    DT_MAGIC, "ZapSpell", ([SP_SHOW_DAMAGE:0]) );

  AddSpell(1,3000,
    BS(Name(WER,1)+" beschwoert einen Blitz vom Himmel!")+BS("Der Blitz trifft Dich direkt!"),
    BS(Name(WER,1)+" beschwoert einen Blitz vom Himmel!")+BS("Der Blitz trifft @WEN direkt!"),
    DT_MAGIC, ([SP_SHOW_DAMAGE:0]) );

  AddSpell(5,1,
    BS(Name(WER,1)+" erzeugt einen magischen Schutzschild vor sich, der dann unsichtbar wird."),
    BS(Name(WER,1)+" erzeugt einen magischen Schutzschild vor sich, der dann unsichtbar wird."),
    DT_MAGIC, "ShieldSpell", ([SP_SHOW_DAMAGE:0]) );

  AddDefaultSpell(2,750,DS_BLIND,
    Name(WER,1)+" blendet Dich mit einem Zauber!\n",
    Name(WER,1)+" blendet @WEN mit einem Zauber!\n");

  AddDefaultSpell(10,450,DS_DRAIN_MANA,
    BS("Von "+name(WEM,1)+" ausgehend spruehen magische Funken in alle Richtungen."),
    BS("Von "+name(WEM,1)+" ausgehend spruehen magische Funken in alle Richtungen."));

  AddDefaultSpell(10,850,DS_PARALYZE,
    BS("Ein Blitz schiesst von "+name(WEM,1)+" genau in Deine Brust!"),
    BS("Ein Blitz schiesst von "+name(WEM,1)+" genau in @WESSEN Brust!"));

  AddDefaultSpell(30,650,DS_SLOW,
    BS(Name(WER,1)+" feuert einen eisigen Strahl auf Dich!"),
    BS(Name(WER,1)+" feuert einen eisigen Strahl auf @WEN!"));

  AddDefaultSpell(20,250,DS_ANTIMAGIC,
    Name(WER,1)+" spricht eine magische Formel und deutet auf Dich.\n",
    Name(WER,1)+" spricht eine magische Formel und deutet auf @WEN.\n");

  AddDefaultSpell(15,950,DS_MASS_DAMAGE,
    Name(WER,1)+" erzeugt einen grellen Lichtblitz!\n",
    Name(WER,1)+" erzeugt einen grellen Lichtblitz!\n",
    DT_LIGHT);

  SetAttackChats(5,
  ({Name(WER, 1)+" seufzt telepathisch.\n"
   }));

  SUID;

}

