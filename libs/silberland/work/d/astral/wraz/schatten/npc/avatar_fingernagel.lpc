void ZapSpell(object enemy, int damage, mixed dam_type)
{  
  if(!random(4))
    ENV(TO)->Message(BS("Du glaubst, "+name(WEN,1)+" telepathisch fluchen zu hoeren..."));
  
}

// ------------------------------------------------------------------------------
void ShieldSpell(object enemy, int damage, mixed dam_type)
{
  shield = ({11+random(50),time()+12+random(13)});  
}

//--Defend--------------------------------------------------------------
int Defend(int dam, string *dtypelist, int spell, object enemy)
{
  if(!random(4) && TO->QuerySkillAttribute(SA_SPEED) <= 100)
    TO->ModifySkillAttribute(TO,SA_SPEED,300+random(601),6+random(10));

  if(shield[1] >= time())
  {
    dam = dam * 10 / shield[0];
    enemy->Message(BS("Bei Deinem Angriff schimmert der Schutzschild "+name(WESSEN,1)+
      " kurz auf, und Deine Attacke wird stark abgeschwaecht!"));
    ENV(enemy)->Message(BS(enemy->Name(WESSEN,1)+" Angriff auf "+name(WEN,1)+
      " wird durch dessen magischen Schutzschild stark abgeschwaecht!"),
      MSGFLAG_VISUAL, ([ MSGFLAG_EXCLUDE : ({ enemy }) ]));
  }

  if(QueryProp(P_MAX_HP)/QueryProp(P_HP) >= 5)
    if(!random(10) && sizeof(ENV(TO)->QueryProp(P_EXITS)))
    {
      ENV(TO)->Message(BS(Name(WER,1)+" erzeugt einen schattigen, knisternden Ball, "
        "der sich mit einem Knall explosionsartig ausdehnt und verpufft! Danach scheint "
        "die Umgebung veraendert... pfadlos und eingeschlossen!"));
      ENV(TO)->RemoveExit(0);
    }

  return ::Defend(dam, dtypelist, spell, enemy);
}


//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
    case "aergerlich":
    case "albern":
    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "teilt Dir telepathisch mit: Strafe folgt.",
        "",
        0,
        "mana");
      break;

    case "froh":
    case "neutral":
    case "nett":
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "teilt Dir telepathisch mit: Strafe folgt.",
        "",
        0,
        "alles");
      break;

    case "traurig":
      break;
  }
}

// ------------------------------------------------------------------------------
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

// ------------------------------------------------------------------------------
void reaction(object pl, string macher, string andere, int kill, string punish)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  if(macher && macher != "") 
    tell_object(pl, BS(Name(WER, 1)+" "+macher));
  if(andere && andere != "" )
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );

  if(kill) Kill(pl);

  switch (punish)
  {
    case "mana":
      pl->AddSp(-200-random(200));
      break;
    case "alles":
      pl->AddSp(-200-random(200));
      pl->AddHp(-200-random(200));
  }
}

