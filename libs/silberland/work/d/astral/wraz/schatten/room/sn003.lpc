// Schattenwelt
// von Wraz / Mendralim
//
// Raum-Template

#include "../def.h"

inherit "std/room";
inherit ROOM "schatten.lpc";

// Create
void create()
{
  ::create();
  schatten::create_default_shadowroom(1);
  schatten::initialize_me();
}

// Reset
void reset()
{
  ::reset();
  schatten::refresh_exits(def_exits);
  schatten::set_rnd_planeshift_option();
  if(QueryProp("last_player_death") > time() - 60*60*24*7) call_out("keep_alive",10);
}

// Keep Alive (soll verhindern dass der Raum sich selbst removed... kA ob das so funktioniert)
void keep_alive() {}

// NotifyPlayerDeath
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  schatten::player_death(player, killer, lostexp);
}

// Remove
int remove()
{
  string file;
  file = file_name(TO);

  // Raum bleibt wenn letzter Spielertod weniger als 7 Tage her ist
  if(QueryProp("last_player_death") > time() - 60*60*24*7) return 0;

  // Template nicht loeschen
  if(strstr(file,"sn_template") >= 0) return 0;

  else 
  {
    ::remove();
    rm(file + ".lpc");
    return 1;
  }
}

// Init
void init()
{
  ::init();
  if(find_call_out("revive") <= 4) call_out("revive",1,TP);
}

// BecomesNetDead
void BecomesNetDead(object player)
{
  if(sizeof(filter_objects(all_inventory(player),"id","\nshadow_netdeath")) >= 1) return;
  clone_object(OBJ "schatten_netdeath")->move(player,M_NOCHECK|M_SILENT);
}