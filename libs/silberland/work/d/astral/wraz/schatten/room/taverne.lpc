// Schattenwelt
// von Wraz / Mendralim
//
// Taverne in Lager von Ahtawqas Mutter

#include "../def.h"
#include <pub.h>

inherit "std/pub";
inherit ROOM "schatten.lpc";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Taverne in den Schatten");
  SetProp(P_INT_LONG,
    "Das Zelt um Dich herum hat hohe Seitenwaende, sodass Du problemlos aufrecht stehen "
    "kannst. Holzbaenke und -tische stehen dicht aneinander. Die Theke aus Holz wirkt "
    "beinahe provisorisch, dahinter ist auch ein Kochbereich. Obwohl reichlich Bier "
    "und Teller mit Speisen oder Speiseresten herumstehen, riecht es erstaunlich "
    "wenig danach. Angehoerige verschiedener Rassen lassen sich hier verkoestigen, "
    "es ist einiges los.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "dogrok");
  SetProp(P_PUBKEEPER_NAME, "Dogrok");
  SetProp(P_PUBMSG_NOKEEPER, "Dogrok ist leider nicht hier.\n");
  SetProp(P_PUBMSG_NOENEMY, BS(
      "Du kaempfst gerade auf Leben und Tod gegen Dogrok. Kein Wunder, "
      "dass er Dich nicht bedient."));
  SetProp(P_PUBMSG_NOINVITE, BS(
      "Dogrok kaempft gerade um sein Leben..."));
  SetProp(P_PUBMSG_FIGHTING, "Dogrok kaempft gerade.\n");

  AddDrink("Seidl", ({"seidl","kleines bier"}),
           199, 17, 4, 3,
           ({"Dogrok bringt Dir einen Becher voll Bier.\n",
             "&& trinkt einen Becher Bier.\n"}));
  
  AddDrink("Bier", ({"bier"}),
           379, 25, 6, 4,
           ({"Dogrok setzt ein Ogergrinsen auf und bringt Dir einen Humpen Bier.\n",
             "&& trinkt einen Humpen Bier.\n"}));
  
  AddDrink("Masskrug Bier", ({"mass","massbier","masskrug bier"}),
           649, 50, 12, 7,
           ({"Dogrok nickt zustimmend, als er Dir einen Masskrug voll Bier vor die Nase stellt.\n",
             "&& trinkt einen ganzes Mass Bier.\n"}));

  AddDrink("Wasser", ({"wasser"}),
           179, 10, 0, 3,
           ({"Mit ausdruckslosem Gesicht bringt Dogrok Dir einen Becher Wasser.\n",
             "&& trinkt einen Becher Wasser.\n"}));

  AddDrink("Krabbensaft", ({"saft"}),
           399, 26, 0, 5,
           ({BS("Dogrok kann seinen Speichelfluss kaum kontrollieren, waehrend er Dir "
              "einen Krug mit einer schwach fischig riechenden, grau-schleimigen "
              "Fluessigkeit bringt. Da es nur schwach riecht, verzichtest Du auf das "
              "Zuhalten Deiner Nase und kippst die Bruehe einfach runter."),
             "&& trinkt ein seltsames, graues Getraenk.\n"}));

  AddFood("Ein graues Kotlett", ({"kotlett"}), 449, 30, 10,
           ({"Dogrok bringt Dir einen Teller mit einem grauen Kotlett.\n"
            +BS("Grau oder nicht, das Kotlett schmeckt gar nicht schlecht, "
                "was Dich tatsaechlich ueberrascht. Du isst alles auf."),
             "&& isst scheinbar zufrieden ein graues Kotlett.\n"}));

  AddFood("Ochsenhoden", ({"ochsenhoden","hoden"}), 649, 40, 10,
           ({"Dogrok serviert Dir grinsend einen Teller mit zwei grossen, runden... 'Dingen'.\n"
             "Du hast keine Ahnung, was Du da vor Dir hast, und denkst: 'Ochsenhoden... das \n"
             "ergibt doch keinen Sinn?!'\n"
            +BS("Wie auch immer, Du bist hungrig, also faengst Du an zu essen. Es schmeckt "
                "fast nach nichts, schattig halt, also isst Du einfach auf."),
             "&& zoegert kurz, isst dann aber zwei Ochsenhoden flink auf.\n"}));

  AddFood("Zwiebelsuppe", ({"zwiebelsuppe","suppe"}), 269, 17, 4,
           ({BS("Dogrok bringt Dir eine Holzschuessel mit einer Zwiebelsuppe.")
            +BS("Du erhoffst Dir einen kraeftig-wuerzigen Geschmack, wirst aber leider, wie "
            "so oft in der Schattenwelt, von der Intensitaet der Sinneswahrnehmung enttaeuscht."),
             "&& loeffelt enttaeuscht eine Suppenschuessel aus.\n"}));

  AddDetail( ({"zelt","stoff","seitenwaende"}),
    "Das Zelt besteht aus dunklem Stoff und hat relativ hohe Seitenwaende. Du kannst "
    "an jeder Stelle aufrecht stehen.");

  AddDetail( ({"holzbaenke","holztische","innenraum","baenke","tische"}),
    "Holzbaenke und Holztische fuellen den gesamten Innenraum dieses Zeltes, abgesehen "
    "von der Theke, fast vollkommen aus. Man kann kaum durchgehen.");

  AddDetail( ({"taverne"}),
    "Darin befindest Du Dich. Ihr Name lautet 'Zur grauen Eminenz'.");

  AddDetail( ({"graue eminenz",""}),
    "So lautet der Name dieser Taverne.");

  AddDetail( ({"theke",""}),
    "Sie besteht aus Holz und wirkt beinahe improvisiert, aber zu abgenutzt um tatsaechlich "
    "ein Provisorium sein zu koennen.");

  AddDetail( ({"provisorium",""}),
    "Anscheinend hat man sich keine besondere Muehe gegeben, die Theke zu erbauen.");

  AddDetail( ({"holz",""}),
    "Theke, Tische und Baenke bestehen allesamt aus grauem Holz.");

  AddDetail( ({"kochbereich",""}),
    "Der Kochbereich befindet sich hinter der Theke. Dort werden Speisen zubereitet.");

  AddDetail( ({"speisen","getraenke","essen"}),
    "Verschiedene Speisen und Getraenke. Du blickst kurz auf das Menue und erschrickst, als Du die "
    "hohen Preise siehst.");

  AddDetail( ({"preise",""}),
    "Unfassbar, die Preise hier sind enorm hoch! Aber "
    "vermutlich hat die Taverne hier in der Schattenwelt ein Monopol, man hat also kaum "
    "eine Wahl.");

  AddDetail( ({"monopol","wahl","einzige","wahl"}),
    "Die Taverne ist vermutlich die einzige weit und breit in der Schattenwelt, wenn nicht "
    "ueberhaupt die Einzige. Deine Wahl beschraenkt sich also auf das Akzeptieren der "
    "hohen Preise, oder den Verzicht auf den Konsum hier.");

  AddDetail( ({"verzicht","konsum"}),
    "Verzichte oder konsumiere, das ist Deine Wahl.");

  AddDetail( ({"bier",""}),
    "Bier scheint es hier jedenfalls reichlich zu geben. Siehe 'Menue'.");
  
  AddDetail( ({"teller","besteck","holzteller","metallbesteck","gabeln","messer","loeffel",
    "speisereste"}),
    "Es stehen, wie in einer Taverne zu erwarten, einige Holzteller mit Speiseresten und "
    "Metallbesteck herum.");
  
  AddDetail( ({"rassen",""}),
    "Etliche verschiedene.");
  
  AddDetail( ({"boden",""}),
    "Der Boden hier ist festgetreten und grau.");

  AddDetail( ({"schattenwelt",""}),
    "Darin befindest Du Dich.");

  AddDetail( ({"schatten",""}),
    "Alles hier sieht nach Schatten aus, grau in grau.");

  AddDetail( ({"",""}),
    "");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Klirren von Besteck und andere typische Tavernengeraeusche, "
    "nur eben etwas gedaempfter als Du es erwartet haettest. Das ist der schattenhaften "
    "Umgebung geschuldet.");

  AddSound( ({"",""}),
   "");


  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nur schwach nach Essen und Bier, obwohl reichlich Speisen und "
    "Getraenke gereicht werden. Die schattenhafte Umgebung entfernt nicht nur alle "
    "Farben, sondern leider auch den Grossteil der Vielfalt an Geruechen.");

  AddSmell( ({"essen","bier","speisen","getraenke"}),
    "Es riecht hier schwach nach Essen und Bier.");

  AddRoomMessage(
    ({BS("Eine "+({"Menschenfrau","Elfe","Halbelfe","Zwergin","Ogerin",
    "Trollin","Fee","Hobbitfrau","Dunkelelfe"})[random(9)]+" bestellt ein Bier."),
    BS("Ein "+({"Mensch","Elf","Halbelf","Zwerg","Oger",
    "Troll","Hobbit","Dunkelelf"})[random(8)]+" bestellt ein Bier."),
    "Jemand wirft einen Humpen um, vermutlich unabsichtlich.\n",
    "Alles ist grau, es riecht fad.\n"}),650+random(123));

  SUID;

  AddExit( "sueden", ROOM "lagerplatz" );

  AddItem( NPC "dogrok" , REFRESH_DESTRUCT);
}

// NotifyPlayerDeath
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  schatten::player_death(player, killer, lostexp);
}

// Init
void init()
{
  ::init();
  if(find_call_out("revive") <= 4) call_out("revive",1,TP);
}

// BecomesNetDead
void BecomesNetDead(object player)
{
  if(sizeof(filter_objects(all_inventory(player),"id","\nshadow_netdeath")) >= 1) return;
  clone_object(OBJ "schatten_netdeath")->move(player,M_NOCHECK|M_SILENT);
}