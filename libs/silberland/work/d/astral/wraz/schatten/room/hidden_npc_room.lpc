// Schattenwelt
// von Wraz / Mendralim
//
// Auffangraum fuer versteckte NPC

#include "../def.h"

inherit "std/room";
inherit ROOM "schatten.lpc";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auffangraum");
  SetProp(P_INT_LONG,
    "Du solltest nicht hier sein koennen.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21,
    ENV_TERRAIN: TT_PLAIN]) );
  SetProp(P_NO_TPORT,NO_TPORT); // verhindert bersi "Heimkehr" und Druiden "Luftele-Teleport"

  SUID;

  AddExit( "raus", ROOM "sn000" );
}
