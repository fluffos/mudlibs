// Schattenwelt
// von Wraz / Mendralim
//
// Azas Turm (1)

#include "../def.h"

inherit "std/room";
inherit ROOM "schatten.lpc";

int available = 2;
int no_of_special_details = 6;
int detail_idx = random(no_of_special_details);

string gemaelde(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Azas Turm");
  SetProp(P_INT_LONG,
    "Gemaelde von Trinkgelagen zieren die Waende, es riecht schwach nach verschuettetem "
    "Bier und Branntwein. Das hattest Du nicht erwartet.");

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_NO_TPORT,NO_TPORT); // verhindert bersi "Heimkehr" und Druiden "Luftele-Teleport"

  AddDetail( ({"gemaelde","trinkgelage","darstellungen","bilder","bild"}),
    "Die Gemaelde zeigen immer wieder die gleichen Gestalten, die sich offenkundig "
    "derben Trinkgelagen hingeben: Ein schwer geruesteter Halbengel, neben dem meist "
    "ein riesiger Baer sitzt, ein edel gekleideter Mann mit Krone, der vermutlich "
    "ein Koenig ist, eine ansehnliche doch seltsam hexerisch wirkende Menschenfrau, "
    "haeufig mit einem winzigen, drachenaehnlichen Wesen neben ihr, eine rothaarige, "
    "moosgruen-haeutige Gnomin in magischen Roben, oft mit einem schwarzen Raben "
    "an ihrer Seite, ein mehr als stattlicher Paladin mit uebergrossem Kinn, ein "
    "weiterer Halbengel, der allerdings Aehnlichkeiten mit einem Gnom hat, ein "
    "etwas borstig dreinblickender zwergischer Paladin mit beeindruckendem Bart, "
    "ein kraeftiger Halb-Mensch-Halb-Drache, ein Waldlaeufer und ein unfassbar "
    "muskuloeser, glatzkoepfiger Zwerg.");

  AddDetail( ({"halbengel","baer","krieger","kraft"}), #'gemaelde); //' 0
  AddDetail( ({"pfote"}), #'gemaelde); //'

  AddDetail( ({"mann","koenig"}),
    "Der scheinbare Koenig ist edel gekleidet und traegt meist eine Krone.");

  AddDetail( ({"krone"}), #'gemaelde); //' 1
  AddDetail( ({"edelstein"}), #'gemaelde); //'

  AddDetail( ({"frau","menschenfrau","frau","hexe","mensch"}),
    "Die Frau erinnert an eine Hexe. Auch das seltsame, winzige Drachenwesen "
    "an ihrer Seite wuerde dazu passen.");

  AddDetail( ({"wesen","drachenwesen"}), #'gemaelde); //' 2
  AddDetail( ({"schwanz"}), #'gemaelde); //'

  AddDetail( ({"gnomin","zauberin"}),
    "Die feuerrothaarige, moosgruen-haeutige Gnomin ist wohl eine Zauberin. "
    "Dargestellt ist sie haeufig gemeinsam mit einem schwarzen Raben.");

  AddDetail( ({"feuerrote haare"}), #'gemaelde); //' 3

  AddDetail( ({"rabe",""}),
    "Jetzt erst faellt Dir auf, dass der Rabe oft gleich oder sogar viel "
    "groesser dargestellt ist, als die Gnomin. Eigenartig.");

  AddDetail( ({"robe",""}),
    "Die Gnomin wird haeufig in offenkundig magischen Roben dargestellt.");

  AddDetail( ({"paladin",""}),
    "Der menschliche Paladin traegt eine wundervolle Ruestung und besitzt ein "
    "ueber alle Masse hinaus markantes Kinn.");

  AddDetail( ({"ruestung",""}),
    "Die Ruestung des menschlichen Paladins ist sehr schoen, waehrend zur "
    "Ruestung des Halbengels eher das Wort 'schwer' passt.");

  AddDetail( ({"kinn",""}),
    "Das Kinn des Paladins ist oft dermassen gross dargestellt, dass man "
    "meinen moechte, der Maler haette zuerst einen kraeftigen Kinnbart "
    "malen wollen, und sich dann entschieden, das Kinn zu vergroessern "
    "um den Bart zu uebermalen.");

  AddDetail( ({"kinnbart"}), #'gemaelde); //' 4

  AddDetail( ({"halbengelgnom","gnom","aehnlichkeiten"}),
    "Ein Halbengel hat Aehnlichkeiten mit einem Gnom. Man koennte sagen: Halbengelgnom. "
    "Er blickt etwas irre drein und wedelt in vielen Darstellungen "
    "mit einem magischen Stab herum.");

  AddDetail( ({"magischer stab","stab"}), #'gemaelde); //' 5
  AddDetail( ({"schalter"}), #'gemaelde); //'

  AddDetail( ({"zwergischer paladin","zwergenpaladin"}),
    "Der zwergische Paladin ist ganz klar die trinkfesteste der Gestalten, ebenso "
    "wie auch die kratzbuerstigste, seinem Blick nach zu urteilen.");

  AddDetail( ({"blick"}), #'gemaelde); //' 6

  AddDetail( ({"bart","zwerge"}),
    "Der zwergische Paladin traegt einen stattlichen, schwarzen Bart, wie es "
    "von klassischen Zwergen erwartet wird.");

  AddDetail( ({"halb-mensch-halb-drache","halbdrache","drache"}), #'gemaelde); //' 7
  AddDetail( ({"schuppen"}), #'gemaelde); //'

  AddDetail( ({"waldlaeufer"}), #'gemaelde); //' 8
  AddDetail( ({"koecher"}), #'gemaelde); //'

  AddDetail( ({"zwerg","glatzkoepfiger zwerg"}), 
    "Der glatzkoepfige Zwerg muss unglaublich stark sein, gleichzeitig sieht er sehr "
    "geschickt und besonnen aus.");
  
  AddDetail( ({"glatze"}), #'gemaelde); //' 9

  AddDetail( ({"gestalten","abenteurer","haufen"}),
    "Die in den Gemaelden dargestellten Gestalten scheinen ein wild zusammengewuerfelter "
    "Haufen Abenteurer zu sein.");

  AddDetail( ({"waende","wand","decke","granit"}),
    "Aussen bestanden die Waende noch aus aussergewoehnlichem Granit. Hier herinnen "
    "sind die Waende und Decke schwarz und glatt, aus undefinierbarem Gestein, das an Basalt "
    "erinnert. An einer Stelle befindet sich eine Treppe, die nach oben fuehrt.");

  AddDetail( ({"basalt","gestein"}),
    "Es erinnert an Basalt, scheint aber doch irgendwie anders zu sein.");

  AddDetail( ({"boden",""}),
    "Der Boden ist grau und glatt.");

  AddDetail( ({"treppe","stufe","stelle"}),
    "Die Treppe fuehrt weiter nach oben in den Turm. Als Du sie naeher untersuchst, "
    "stoesst Du gegen eine unsichtbare Barriere, welche die Treppe vollkommen "
    "abschirmt. Du findest keine Moeglichkeit, die Treppe zu betreten.");

  AddDetail( ({"turm","erwartung","innere","innere des turms"}),
    "Von aussen hattest Du eine andere Erwartung an das Innere des Turms. Es ist hier "
    "viel ... schlichter und stinkiger als Du gedacht haettest.");

  AddDetail( ({"bier","branntwein"}),
    "Obwohl es stark danach riecht, sind weder Bier noch Branntwein zu sehen. Ausser auf "
    "den Gemaelden.");

  AddDetail( ({"barriere","weg","moeglichkeit"}),
    "So sehr Du auch suchst, Du findest keinen Weg an der Barriere vorbei.");

  AddDetail( ({"fenster",""}),
    "Seltsam, es befinden sich ueberhaupt keine Fenster in diesem Turm, und dennoch "
    "ist es hier nicht dunkel. Es ist sogar recht hell.");

  AddDetail( ({"",""}),
    "");

  AddDetail( ({"",""}),
    "");

  AddDetail( ({"",""}),
    "");

  AddDetail( ({"",""}),
    "");

  AddSound( DEFAULT_SOUND,
    "Es ist hier sehr, sehr still.");

  AddSound( ({"",""}),
   "");


  AddSmell( DEFAULT_SMELL,
    "Es riecht hier schwach nach altem, abgestandenen Bier und Branntwein.");

  AddSmell( ({"bier","branntwein"}),
    "Eindeutig. Es erinnert Dich an eine Taverne, aber hier bist Du definitiv "
    "in keiner Taverne.");

  AddRoomMessage(
    ({BS("Es ist unheimlich still und leer.")
    }),1250+random(123));

  SUID;

  call_out("reset",2+random(10));

  AddExit( "raus", ([EX_FUNC: "check_room_existence"]) );

}

// ------------------------------------------------------------------------------
string gemaelde(string str)
{
  string additional_text;
  additional_text = "";

  switch (str)
  {
    // ---
    case "halbengel" :
    case "baer" :
    case "krieger" :
    case "kraft" :
      if(detail_idx == 0) additional_text = " Eine Pfote des Baers faellt Dir in einem Gemaelde besonders auf.";
      return BS("Der schwer geruestete Halbengel scheint ein Krieger zu sein. Der Baer, der "
        "sich meist neben ihm befindet, muss gewaltige Kraft haben." + additional_text);
      break;

    case "pfote":
    case "knopf":
      if(detail_idx != 0) {return BS("Sowas siehst Du da nicht!"); break;}
      if(available == 2)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS("Du untersuchst die Pfote naeher, und bemerkst einen Knopf, den Du sogleich drueckst. "
          "Etwas faellt zu Boden.");
      }
      else if (available == 1)
      {
        "/obj/gemmaster"->DistributeGem(1,3,1,1);
        available = 0;
        return BS("Du untersuchst die Pfote naeher, und bemerkst einen Knopf, den Du sogleich drueckst. "
          "Etwas faellt zu Boden.");
      }
      else return BS("Du untersuchst die Pfote naeher, bemerkst aber nichts Besonderes.");
      break;

    // ---
    case "krone":
      if(detail_idx == 1) additional_text = " Ein Edelstein in der Krone glitzert auffaellig.";
      return BS("Die Krone funkelt majestaetisch."+additional_text);
      break;

    case "edelstein":
      if(detail_idx != 1) {return BS("Sowas siehst Du da nicht!"); break;}
      if(available == 2)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS("Als Du Dir den Edelstein naeher ansiehst, blitzt es kurz blaeulich. "
          "Etwas faellt zu Boden.");
      }
      else if (available == 1)
      {
        "/obj/gemmaster"->DistributeGem(1,0,1,1);
        available = 0;
        return BS("Als Du den Edelstein genau betrachtest, faellt er aus dem Gemaelde heraus zu Boden.");
      }
      else return BS("Du untersuchst den Edelstein naeher, bemerkst aber nichts Besonderes.");
      break;

    // ---
    case "wesen":
    case "drachenwesen":
      if(detail_idx == 2) additional_text = " Es hat einen langen, drachenaehnlichen Schwanz.";
      return BS("Das Drachenwesen grinst keck."+additional_text);
      break;

    case "schwanz":
      if(detail_idx != 2) {return BS("Sowas siehst Du da nicht!"); break;}
      if(available == 2)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS(" Der Schwanz wedelt ploetzlich! Irgendetwas materialisiert sich und faellt zu Boden");
      }
      else if (available == 1)
      {
        "/obj/gemmaster"->DistributeGem(2,3,1,1);
        available = 0;
        return BS(" Der Schwanz wedelt ploetzlich, und das Drachenwesen furzt Edelsteine in Dein Gesicht, "
        "die sodann zu Boden kullern.");
      }
      else return BS("Du untersuchst den Schwanz naeher, bemerkst aber nichts Besonderes.");
      break;

    // ---
    case "feuerrote haare":
      if(available == 2 && detail_idx == 3)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS("Du betrachtest die feuerroten Haare der Zauberin genauer, und ploetzlich wird sie "
          "scheinbar lebendig, zwinkert Dir zu, schnippt mit den Fingern und etwas faellt zu Boden.");
      }
      else if (available == 1 && detail_idx == 3)
      {
        "/obj/gemmaster"->DistributeGem(1,3,1,1);
        available = 0;
        return BS("Du betrachtest die feuerroten Haare der Zauberin genauer, und ploetzlich wird sie "
          "scheinbar lebendig, zwinkert Dir zu, schnippt mit den Fingern und etwas faellt zu Boden.");
      }
      else return BS("Du untersuchst die feuerroten Haare der Zauberin naeher. Du glaubst kurz, dass "
        "Dir die Gnomin zuzwinkert! Doch dann ist das Gemaelde auch schon wieder normal.");
      break;

    // ---
    case "kinnbart":
      if(available == 2 && detail_idx == 4)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS("Als Du Dir das maechtige Kinn an einem Gemaelde besonders genau ansiehst, faellt "
          "Dir ein Gegenstand auf dem Boden vor Deinen Fuessen auf, der vorher sicher nicht da war!");
      }
      else if (available == 1 && detail_idx == 4)
      {
        "/obj/gemmaster"->DistributeGem(1,3,1,1);
        available = 0;
        return BS("Als Du Dir das maechtige Kinn an einem Gemaelde besonders genau ansiehst, fallen "
          "Dir einige Steine auf dem Boden vor Deinen Fuessen auf, der vorher sicher nicht da waren!");
      }
      else return BS("Kein Kinnbart zu sehen, nur gigantisches Kinn.");
      break;

    // ---
    case "magischer stab":
    case "stab":
      if(detail_idx == 5) additional_text = " Oh, jetzt erst siehst Du einen kleinen Schalter an dem "
        "Stab in einem der Gemaelde.";
      return BS("Der Stab des Halbengelgnoms muss besonders sein, sonst waere er wohl nicht so oft "
        "dargestellt."+additional_text);
      break;

    case "schalter":
      if(detail_idx != 5) {return BS("Sowas siehst Du da nicht!"); break;}
      if(available == 2)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS("Du kannst nicht widerstehen und drueckst den Schalter. "
          "Etwas faellt zu Boden.");
      }
      else if (available == 1)
      {
        "/obj/gemmaster"->DistributeGem(1,3,1,1);
        available = 0;
        return BS("Du kannst nicht widerstehen und drueckst den Schalter. "
          "Etwas faellt zu Boden.");
      }
      else return BS("Du versuchst, den Schalter zu druecken, er bewegt sich aber nicht.");
      break;

    // ---
    case "blick":
      if(available == 2 && detail_idx == 6)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS("Der Blick des zwergischen paladins ist grimmig-grantig. "
          "Waehrend Du dem Zwerg in die Augen starrst, verschwimmt auf einmal alles um Dich "
          "herum und es wird dunkel, als Du in seinen Bann gezogen wirst! "
          "Als Du von der Trance wieder erwachst, meinst Du, dass er noch grantiger drein "
          "schaut. Ausserdem liegt etwas vor Deinen Fuessen.");
      }
      else if (available == 1 && detail_idx == 4)
      {
        "/obj/gemmaster"->DistributeGem(1,3,1,1);
        available = 0;
        return BS("Der Blick des zwergischen paladins ist grimmig-grantig. "
          "Waehrend Du dem Zwerg in die Augen starrst, verschwimmt auf einmal alles um Dich "
          "herum und es wird dunkel, als Du in seinen Bann gezogen wirst! "
          "Als Du von der Trance wieder erwachst, meinst Du, dass er noch grantiger drein "
          "schaut. Ausserdem liegt etwas vor Deinen Fuessen.");
      }
      else return BS("Der Blick des zwergischen paladins ist grimmig-grantig. Zwergisch eben.");
      break;

    // ---
    case "halb-mensch-halb-drache":
    case "halbdrache":
    case "drache":
      if(detail_idx == 7) additional_text = " Seine Schuppen funkeln in einem der Gemaelde besonders stark.";
      return BS("Der Halbdrache sieht edel und gefaehrlich aus."+additional_text);
      break;

    case "schuppen":
      if(detail_idx != 7) {return BS("Sowas siehst Du da nicht!"); break;}
      if(available == 2)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        TP->AddHp(-random(30));
        return BS("Fasziniert beruehrst Du die Schuppen auf dem Bild, und ein Blitz schiesst "
          "auf Dich! "
          "Etwas faellt zu Boden.");
      }
      else if (available == 1)
      {
        "/obj/gemmaster"->DistributeGem(1,3,1,1);
        available = 0;
        return BS("Neugierig streichst Du vorsichtig ueber die Schuppen. Es knistert leicht, "
          "und vor Dir materialisieren sich Edelsteine.");
      }
      else return BS("Neugierig streichst Du vorsichtig ueber die Schuppen. Es knistert leicht.");
      break;
    
    // ---
    case "waldlaeufer":
      if(detail_idx == 8) additional_text = " Auf einem Gemaelde sieht sein Koecher merkwuerdig aus.";
      return BS("Der Waldlaeufer ist unauffaellig, und auch nur in wenigen Gemaelden zu sehen."+additional_text);
      break;

    case "koecher":
      if(detail_idx != 8) {return BS("Sowas siehst Du da nicht!"); break;}
      if(available == 2)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS("Du betrachtest den Koecher auf dem Gemaelde genauer. Es sieht so aus, als koenntest Du "
          "hinein greifen. Das tust Du auch sogleich, und ziehst etwas heraus, das Dir allerdings aus der "
          "Hand auf den Boden faellt.");
      }
      else if (available == 1)
      {
        "/obj/gemmaster"->DistributeGem(1,3,1,1);
        available = 0;
        return BS("Du betrachtest den Koecher auf dem Gemaelde genauer. Es sieht so aus, als koenntest Du "
          "hinein greifen. Das tust Du auch sogleich, und ziehst einige Edelsteine heraus, die Dir allerdings aus der "
          "Hand auf den Boden fallen.");
      }
      else return BS("Du betrachtest den Koecher auf dem Gemaelde genauer. Es sieht so aus, als koenntest Du "
          "hinein greifen. Als Du das versuchst, stoesst Deine Hand einfach gegen das Gemaelde. Was hast "
          "Du Dir auch dabei gedacht!");
      break;

    // ---
    case "glatze":
      if(available == 2 && detail_idx == 9)
      {
        CLONEME(OBJ "portalrolle");
        available = 1;
        return BS("Du kannst nicht widerstehen, und streichelst dem Zwerg ueber die "
        "Glatze. Magische Energie tritt aus dem Gemaelde und formt einen Gegenstand "
        "neben Dir auf dem Boden.");
      }
      else if (available == 1 && detail_idx == 9)
      {
        "/obj/gemmaster"->DistributeGem(1,3,1,1);
        available = 0;
        return BS("Du kannst nicht widerstehen, und streichelst dem Zwerg ueber die "
        "Glatze. Magische Energie tritt aus dem Gemaelde und formt einige Steine "
        "neben Dir auf dem Boden.");
      }
      else {
        TP->AddHp(-random(50));
        return BS("Du kannst nicht widerstehen, und streichelst dem Zwerg ueber die "
        "Glatze. Magische Energie tritt aus dem Gemaelde und fetzt Dich. Das laesst "
        "Du wohl lieber!");
      }
      break;
  }
  
}

// ------------------------------------------------------------------------------
mixed check_room_existence()
{
  if(!read_file(ROOM "sn"+AZA_ROOM)) RMASTER->write_next_room(ROOM "sn"+AZA_ROOM,"norden");
  call_other(ROOM "sn"+AZA_ROOM,"???");
  if(!find_object(ROOM "sn"+AZA_ROOM))
  {
    notify_fail(BS("Du willst den Turm verlassen, doch eine Barriere haelt Dich auf."));
    return 0;
  }

  return ROOM "sn"+AZA_ROOM;
}

// NotifyPlayerDeath
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  schatten::player_death(player, killer, lostexp);
}

// Init
void init()
{
  ::init();
  if(find_call_out("revive") <= 4) call_out("revive",1,TP);
}

// BecomesNetDead
void BecomesNetDead(object player)
{
  if(sizeof(filter_objects(all_inventory(player),"id","\nshadow_netdeath")) >= 1) return;
  clone_object(OBJ "schatten_netdeath")->move(player,M_NOCHECK|M_SILENT);
}

// Reset
void reset()
{
  object last_aza;

  ::reset();

  detail_idx = random(no_of_special_details);
  
  if(!random(24)) available = 2;
  else available = 1;

  if(QueryProp("last_aza_deathtime") < time()-60*60*24 && 
    !present("\naza",TO) &&
    (!QueryProp("last_aza") || !find_object(QueryProp("last_aza"))))
  {
    last_aza = clone_object(NPC "aza_simulakrum");
    last_aza->move(TO,M_GO);
    SetProp("last_aza",file_name(last_aza));
  }
}
