// Schattenwelt
// von Wraz / Mendralim
//
// Seed-Room sn000

#include "../def.h"

inherit "std/room";
inherit ROOM "schatten.lpc";

void create()
{
  ::create();
  // initialize this room: room name, forward, backward (not used), room number, flag 1 (only forward exit)
  RMASTER->initialize_first_room("sn000","norden","sueden",0,1);
  schatten::create_default_shadowroom();
}

void reset()
{
  ::reset();
  schatten::refresh_exits(def_exits);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  schatten::player_death(player, killer, lostexp);
}

void init()
{
  ::init();
  schatten::revive(TP);  
}