// Schattenwelt
// von Wraz / Mendralim
//
// Leiterinzelt im Lager in der Schattenwelt

#include "../def.h"

inherit "std/room";
inherit ROOM "schatten.lpc";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Leiterinzelt");
  SetProp(P_INT_LONG,
    "In diesem Zelt herrscht offensichtliche Ordnung. Der hintere Bereich ist durch "
    "einen Vorhang abgetrennt, durch einen Spalt erkennst Du ein Bett, vermutlich die "
    "Schlafstaette. An den Zeltwaenden wurden Zierteppiche und Stoffregale befestigt. "
    "Der Boden ist saeuberlich ausgelegt mit festen Lederbahnen. Es duftet schwach "
    "nach Rauchstaebchen.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 19+random(3),
  ENV_TERRAIN: TT_PLAIN]) );
  SetProp(P_NO_TPORT,NO_TPORT); // verhindert bersi "Heimkehr" und Druiden "Luftele-Teleport"

  AddDetail( ({"zelt","jurte"}),
    "Dieses Zelt ist eine Jurte, die Zeltwaende stehen senkrecht, das Zeltdach "
    "ist kegelfoermig. In der Mitte ist ein Loch, ein hoelzernes Dreibein haelt "
    "das Zeltdach in der Mitte hoch.");
  
  AddDetail( ({"zeltdach","dach"}),
    "Es ist kegelfoermig und wird von einem Dreibein in der Mitte, dort wo das "
    "Loch ist, hochgehalten. Man koennte ein Feuer machen und der Rauch wuerde "
    "fein saeuberlich durch das Loch abziehen, aber hier ist definitiv keine "
    "Feuerstelle.");
 
  AddDetail( ({"feuerstelle",""}),
    "Keine zu sehen.");
 
  AddDetail( ({"dreibein",""}),
    "Das hoelzerne Dreibein haelt das Zeltdach in der Mitte hoch und gespannt.");
 
  AddDetail( ({"mitte","loch"}),
    "Das Zeltdach hat in der Mitte ein Loch, durch welches Rauch abziehen koennte, "
    "wuerde man hier ein Feuer machen. Es ist aber keine Feurestelle zu sehen.");
 
  AddDetail( ({"rauch",""}),
    "Der einzige Rauch hier kommt von den Rauchstaebchen.");
 
  AddDetail( ({"zeltwaende",""}),
    "An den senkrechten Zeltwaenden sind Zierteppiche und Stoffregale angebracht.");
 
  AddDetail( ({"zierteppiche","teppiche"}),
    "Die Zierteppiche dekorieren die Zeltwaende.");
 
  AddDetail( ({"stoffregale","regale"}),
    "In den Stoffregalen sind verschiedene Gegenstaende aufbewahrt.");
 
  AddDetail( ({"gegenstaende",""}),
    "Keiner davon faellt Dir besonders auf.");
 
  AddDetail( ({"ordnung",""}),
    "Die Ordnung in der Jurte hier ist auffaellig.");
 
  AddDetail( ({"hinterer bereich"}),
    "Er ist mit einem Vorhang abgetrennt, aber durch einen Spalt erspaehst Du "
    "ein Bett, also vermutest Du eine Schlafstaette.");
 
  AddDetail( ({"schlafstaette",""}),
    "Diese vermutest Du im hinteren Bereich hinter dem Vorhang.");
 
  AddDetail( ({"vorhang",""}),
    "Ein Vorhang trennt den hinteren Bereich ab.");
 
  AddDetail( ({"spalt",""}),
    "Durch einen Spalt im Vorhang siehst Du ein Bett.");
 
  AddDetail( ({"bett",""}),
    "Du siehst es nur teilweise durch einen Spalt im Vorhang im hinteren Bereich.");
 
  AddDetail( ({"boden",""}),
    "Er ist fein saeuberlich mit festen Lederbahnen ausgelegt.");
 
  AddDetail( ({"lederbahnen",""}),
    "Gewoehnliches Leder, aber besonders trittfest!");
 
  AddDetail( ({"rauchstaebchen",""}),
    "Sie sind an dem Dreibein montiert und verbreiten einen schwachen Duft.");
 
  AddDetail( ({"",""}),
    "");

  AddSound( DEFAULT_SOUND,
    "Es ist erstaunlich still hier.");

  AddSound( ({""}),
   "");

  AddSmell( DEFAULT_SMELL,
    "Es riecht schwach nach Rauchstaebchen.");

  AddSmell( ({"rauchstaebchen","rauch","duft"}),
    "Obwohl einige Rauchstaebchen gluehen, duftet es nur sehr schwach nach ihnen. Die "
    "Schattenwelt schwaecht Duefte und Geschmaecker stark ab.");

  SUID;

  AddExit( "norden", ROOM "lagerplatz" );

  AddItem( NPC "posey" , REFRESH_NONE); //-> im reset() nur alle 24h
  AddItem( NPC "leibwache" , REFRESH_DESTRUCT);
  AddItem( NPC "leibwache" , REFRESH_DESTRUCT);
  AddItem( NPC "leibwache_druide" , REFRESH_DESTRUCT);
}

// NotifyPlayerDeath
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  schatten::player_death(player, killer, lostexp);
}

// Init
void init()
{
  ::init();
  if(find_call_out("revive") <= 4) call_out("revive",1,TP);
}

// BecomesNetDead
void BecomesNetDead(object player)
{
  if(sizeof(filter_objects(all_inventory(player),"id","\nshadow_netdeath")) >= 1) return;
  clone_object(OBJ "schatten_netdeath")->move(player,M_NOCHECK|M_SILENT);
}

// Reset
void reset()
{
  ::reset();

  if(QueryProp("last_posey_deathtime") < time()-60*60*24 && !present("\nposey",TO))
    clone_object(NPC "posey")->move(TO,M_GO);
}
