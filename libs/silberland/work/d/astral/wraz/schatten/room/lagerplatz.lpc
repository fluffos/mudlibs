// Schattenwelt
// von Wraz / Mendralim
//
// Lager von Ahtawqas Mutter

#include "../def.h"

inherit "std/room";
inherit ROOM "schatten.lpc";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Lagerplatz in den Schatten");
  SetProp(P_INT_LONG,
    "Um Dich herum befinden sich einige Zelte. Am auffaelligsten davon sind drei: "
    "Das Zelt im Westen scheint einer "
    "Handelstreibenden zu gehoeren, das Zelt im Norden riecht eher nach Taverne. "
    "Das Zelt im Sueden ist hingegen ordentlicher, wer oder was sich darin verbirgt "
    "ist Dir von hier aus nicht klar. Insgesamt ist die Umgebung weiterhin schattenhaft "
    "und oede, der Boden staubig und der Himmel fahl. Es treiben sich hier allerdings "
    "humanoide Wesen herum, von denen keine Gefahr auszugehen scheint.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(5),
  ENV_TERRAIN: TT_PLAIN]) );
  SetProp(P_NO_TPORT,NO_TPORT); // verhindert bersi "Heimkehr" und Druiden "Luftele-Teleport"

  AddDetail( ({"zelte",""}),
    "Zelte unterschiedlicher Groessen, Formen und Graustufen. Insgesamt sind es etwa "
    "drei Dutzend.");

  AddDetail( ({"formen","groessen"}),
    "Du siehst verschieden grosse Tipis, Jurten, Kohten und klassische Zelte.");

  AddDetail( ({"graustufen","farben"}),
    "Die 'Farben' der Zelte reichen von fast weiss bis vollkommen schwarz.");

  AddDetail( ({"tipis",""}),
    "Eines davon ist auffaellig, es steht im Westen.");

  AddDetail( ({"westliches zelt","tipi","westen"}),
    "Das Zelt im Westen scheint einer Handelstreibenden zu gehoeren, zu erkennen am "
    "ueber dem Eingang montierten Schild.");
  
  AddReadDetail( ({"schild"}),
    "\n"
    " ---------------------------------------\n"
    "| Liseth's Material, Waffen, Ruestungen |\n"
    " ---------------------------------------\n\n");

  AddDetail( ({"handelstreibende","liseth"}),
    "Vermutlich ist sie im Zelt im Westen.");

  AddDetail( ({"jurten","schwarzzelte"}),
    "Jurten sind relativ grosse Schwarzzelte. Fast alle sind schwarz, daher der Name. "
    "Eine auffaellige Jurte steht im Sueden.");

  AddDetail( ({"suedliches zelt","jurte","sueden"}),
    "Die Jurte im Sueden sieht irgendwie ordentlicher aus als alle anderen Zelte. Was sich darin "
    "wohl verbirgt?");

  AddDetail( ({"klassische zelte","querschnitt","seitenwaende"}),
    "Zelte mit im Querschnitt dreieckigem Dach sind relativ klassisch. Einige haben "
    "Seitenwaende, andere sind im gesamten Querschnitt dreieckig. Ein auffaelliges Zelt "
    "mit hohen Seitenwaenden befindet sich im Norden.");

  AddDetail( ({"noerdliches zelt","graue eminenz","grauschattierungen","schriftzug","taverne","norden"}),
    "Der Eingang des Zelts im Norden ist mit unterschiedlichen Grauschattierungen verziert, darueber "
    " der Schriftzug: "
    "'Zur grauen Eminenz'.");

  AddDetail(({"umgebung","schattenwelt"}),
            "Alles ist schwarz-weiss oder grau, und kein Gestirn erhellt den Himmel. Dennoch ist es nicht "
            "stockfinster.");

  AddDetail(({"gestirn", "himmel"}),
            "Der Himmel ist fahl und grau, kein Gestirn ist zu sehen.");

  AddDetail( ({"boden",""}),
    "Der Boden ist grau und staubig.");

  AddDetail( ({"wesen","humanoide wesen","menschen","elfen","halbelfen","zwerge","oger",
      "trolle","feen","hobbits","dunkelelfen","rassen"}),
    "Es treiben sich hier Menschen, Elfen, Dunkelelfen, Halbelfen, Hobbits, Zwerge, Oger, Trolle und "
    "sogar Feen herum - also so gut wie alle bekannten Rassen. Die meisten sehen relativ ernst "
    "oder gar grimmig drein, aber nicht angriffslustig. Jedenfalls nicht Dir gegenueber.");

  AddDetail( ({"",""}),
    "");

  AddSound( DEFAULT_SOUND,
    "Verschiedene, nicht weiter ungewoehnliche Geraeusche der humanoiden Wesen dringen an Dein Ohr. "
    "Wie ueblich hier in der Schattenwelt, alles ein wenig gedaempft, detailarm und lustlos. "
    "Nur der Tavernenlaerm aus dem Norden faellt auf.");

  AddSound( ({"humanoide wesen","wesen"}),
   "Nichts, das Dir daran besonders auffaellt.");

  AddSound( ({"tavernenlaerm","taverne"}),
   "Du lauschst und hoerst Holzteller aneinander schlagen, Metallbesteck klirren. Klingt nach "
   "Essen und Trinken.");

  AddSound( ({"",""}),
   "");


  AddSmell( DEFAULT_SMELL,
    "Die Taverne im Norden riecht schwach nach Essen und Bier.");

  AddSmell( ({"taverne","zelt im norden","essen","bier"}),
    "Die Taverne im Norden riecht schwach nach Essen und Bier.");

  AddRoomMessage(
    ({BS("Eine "+({"Menschenfrau","Elfe","Halbelfe","Zwergin","Ogerin",
    "Trollin","Fee","Hobbitfrau","Dunkelelfe"})[random(9)]+" rempelt Dich an und geht "
    "einfach weiter."),
    BS("Ein "+({"Mensch","Elf","Halbelf","Zwerg","Oger",
    "Troll","Hobbit","Dunkelelf"})[random(8)]+" rempelt Dich an und geht "
    "einfach weiter."),
    "Aus dem Zelt im Norden dringt grau ein Groehlen.\n",
    "Alles ist grau.\n"}),250+random(23));

  SUID;

  AddItem( NPC "krieger" , REFRESH_DESTRUCT);
  AddItem( NPC "krieger" , REFRESH_DESTRUCT);
  AddItem( NPC "krieger" , REFRESH_DESTRUCT);

  AddExit( "norden", ROOM "taverne" );
  AddExit( "osten", ([EX_FUNC: "check_room_existence"]) );
  AddExit( "sueden", ROOM "leiterinzelt" );
  AddExit( "westen", ROOM "laden" );
}

mixed check_room_existence()
{
  if(!read_file(ROOM "sn010")) RMASTER->write_next_room(ROOM "sn010","norden");
  call_other(ROOM "sn010","???");
  if(!find_object(ROOM "sn010"))
  {
    notify_fail(BS("Du gehst los, doch als sich der Pfad sehr rasch verlaeuft, kehrst Du wieder um."));
    return 0;
  }

  return ROOM "sn010";
}

// NotifyPlayerDeath
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  schatten::player_death(player, killer, lostexp);
}

// Init
void init()
{
  ::init();
  if(find_call_out("revive") <= 4) call_out("revive",1,TP);
}

// BecomesNetDead
void BecomesNetDead(object player)
{
  if(sizeof(filter_objects(all_inventory(player),"id","\nshadow_netdeath")) >= 1) return;
  clone_object(OBJ "schatten_netdeath")->move(player,M_NOCHECK|M_SILENT);
}