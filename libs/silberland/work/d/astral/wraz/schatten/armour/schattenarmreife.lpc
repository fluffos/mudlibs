// Schattenarmreif - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Schattenarmreife");
  SetProp(P_LONG,
    BS("Zylindrisch streichen Schatten durch die Luft und formen "
      "zwei Armreife. Gelegentlich kraeuseln sich die grauen Schatten und "
      "formen einzigartige Muster."));
  AddDetail(({"muster","musterung","musterungen"}),
    "Die Muster sind einzigartig und scheinen sich staendig zu aendern.\n");
  SetProp(P_NAME, "Schattenarmreife");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"reif", "reife", "armreif", "armreife", "schattenarmreif", "schattenarmreife",
    "\nwrazschattenarmreife"}) );
  AddId(ELEMENT_RING_LUFT);

  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_VALUE, 12500); 
  
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();
}

// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
}