// Schattenstiefel - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Schattenstiefel");
  SetProp(P_LONG,
    BS("Zuerst hast Du sie nicht als Stiefel erkannt, diese zwei dunklen "
    "Flecken. Schattenhaft protzen sie wie zwei unwillige Felsbrocken, fast, "
    "als wuerden sie sich vor ihrer eigenen Existenz zieren."));
  SetProp(P_NAME, "Schattenstiefel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({ "stiefel", "schattenstiefel", "\nwrazschattenstiefel"}) );
  AddId(ELEMENT_RING_ERZ);

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_VALUE, 12500); 
  
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();
}

// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
}