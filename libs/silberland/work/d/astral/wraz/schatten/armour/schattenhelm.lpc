// Schattenhelm - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Ein Schattenhelm");
  SetProp(P_LONG,
    BS("Wirre Schatten hauchen umher. Sie zeichnen einen ungewoehnlichen "
    "Helm in die Luft."));
  SetProp(P_NAME, "Schattenhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({ "helm", "schattenhelm", "\nwrazschattenhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_VALUE, 17500); 
  
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();
}

// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
}