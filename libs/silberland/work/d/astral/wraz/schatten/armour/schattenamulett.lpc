// Schattenamulett - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

// Kann gelegentlich in die Schattenwelt teleportieren.

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

int teleport_possible = 0;
string check_circle(string key);

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Ein Schattenamulett");
  SetProp(P_LONG,
    BS("Das Schattenamulett wird von dunkel- und hellgrauen Faeden geformt. "
    "Sie ziehen sich in kleinen, unregelmaessigen Kreisen durch- und ineinander."));
  AddDetail(({"faeden","faden"}),
    "Ungewoehnlich, schattig und grau.");
  AddDetail("kreise",
    "Einer der Kreise faellt Dir auf, er ist heller... oder dunkler?");
  AddDetail("kreis", #'check_circle); //'
  SetProp(P_NAME, "Schattenamulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "amulett", "schattenamulett", "\nwrazschattenamulett"}) );
  AddId(ELEMENT_RING_WASSER);

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_VALUE, 9500); 
  
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();

  AddCmd(({"beruehre"}), "cmd_beruehren");
}

// ------ CHECK_CIRCLE() --------------------------------------------------
string check_circle(string key)
{
  if (teleport_possible)
  {
    return BS("Du siehst einen Kreis, der sich von den anderen abhebt. Er ist "
      "heller als die anderen, und Du hast das Gefuehl, dass er Dich "
      "irgendwohin teleportieren koennte.");
  }
  return BS("Du siehst einen Kreis, der sich von den anderen abhebt. Er ist "
    "heller als die anderen, und Du hast das Gefuehl, dass er Dich "
    "irgendwohin teleportieren koennte. Aber nicht jetzt.");
}

// ------ CMD_BERUEHREN() -------------------------------------------------
int cmd_beruehren(string str)
{
  object player_shadow;

  if(!str) return 0;
  if(str != "kreis") return 0;
  if(teleport_possible && !in_schattenwelt(TP))
  {
    teleport_possible = 0;
    TP->Message(BS("Du beruehrst den Kreis und wirst in die Schatten teleportiert."));
    call_other(ROOM "sn000", "???");
    TP->move(ROOM "sn000", M_GO,TP->QueryPossPronoun(TO)+" "+
    TO->name(RAW)+" und verschwindet in den Schatten","beruehrt","erscheint");
    
    player_shadow = clone_object(NPC "spielerschatten");
    player_shadow->SetOwner(TP);
    player_shadow->move(ROOM "sn000",M_NOCHECK);
    call_other(LOGMASTER, "DoEntryExitLog", TP, TO, (ENV(TP)?ENV(TP):"TP has no ENV"), 
      find_object(ROOM "sn000"));
    return 1;
  }
  else if(teleport_possible && in_schattenwelt(TP))
  {
    TP->Message(BS("Du beruehrst den Kreis und verspuerst kurz einen Sog, der "
    "sogleich abebbt. Sonst passiert nichts. Vielleicht bist Du schon dort, wo "
    "Dich das Amulett hinschicken wollte."));
    ENV(TP)->Message(BS(TPN+" beruehrt "+TP->QueryPossPronoun(TO)+" "+
    TO->name(RAW)+", aber nichts passiert."),MSGFLAG_NO_TP);
    return 1;
  }
  else
  {
    TP->Message(BS("Du beruehrst den Kreis, aber nichts passiert."));
    ENV(TP)->Message(BS(TPN+" beruehrt "+TP->QueryPossPronoun(TO)+" "+
    TO->name(RAW)+", aber nichts passiert."),MSGFLAG_NO_TP);
    return 1;
  }
}

// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
  if(!random(10)) teleport_possible = 1;
}