// Schattenweihnachtshaube - NICHT Teil des Schattenruestung-Sets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

int default_call_out_time = 600;
int magic_rand = 1;

void create()
{
  int i;
  if (!is_clone(this_object())) return;
  ::create();


  for(i=random(5);i>0;i--)
    magic_rand *= random(11);
  magic_rand += 1;

  SetProp(P_SHORT, "Eine Schattenweihnachtshaube");
  SetProp(P_LONG, 
    "Scheinbar materiallos und doch irgendwie fest schleichen Schatten durch die "
    "Luft um diese Schattenweihnachtshaube zu formen. Kurz glaubst du, eine "
    "rote Farbe zu erkennen, doch dann ist sie wieder grau in grau.");
  SetProp(P_NAME, "Schattenweihnachtshaube");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 0);
  AddId( ({"haube","schattenhaube", "schattenweihnachtshaube"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET); 
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, ([MAT_SHADOW:100]));
  SetProp(P_WEIGHT, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([P_XP:100000000]) );
  SetProp(P_VALUE, 17500);
  SetProp(P_MAGIC, 1);
  SetProp(P_ITEMD_TMPMAGIC, ({magic_rand, magic_rand}) );
  seteuid(getuid(TO));
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  SetProp(P_QUALITY_DECAY, 750 );

  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:2]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_TERROR:1]) );
  SetProp(P_X_HEALTH_MOD,([
        P_HP:14,
        P_SP:28]));

  SetProp("federgewichtsbalsam", 1000); // Federgewichtsbalsam wirkt hier nicht

  if(find_call_out("Heal") == -1) 
    call_out("Heal", default_call_out_time + random(default_call_out_time/10));
}

// ------ WEARFUNC() ------------------------------------------------------
int WearFunc(object me)
{
  if(!me || !ENV(me) || !living(ENV(me))) return 0;
  // ...
  return 1;
}

// ------ REMOVEFUNC() ------------------------------------------------------
int RemoveFunc(object me)
{
  if(!me || !ENV(me) || !living(ENV(me))) return 0;
  // ...
  return 1;
}

// ------------------------------------------------------------------------------
varargs void Heal(int percent)
{
  if(!TO || !ENV(TO)) return;
  if(!living(ENV(TO))) return;

  if(QueryProp(P_WORN) == ENV(TO) &&
    ((ENV(TO)->QueryProp(P_HP) < ENV(TO)->QueryProp(P_MAX_HP)) ||
    (ENV(TO)->QueryProp(P_SP) < ENV(TO)->QueryProp(P_MAX_SP))) )
  {
    ENV(TO)->Message(BS(Name(WER,1)+" umstroemt Dein Haupt kurz und intensiv."));

    ENV(TO)->AddHp(90+random(21));
    ENV(TO)->AddSp(90+random(21));
  }


  if(find_call_out("Heal") == -1) 
  {
    call_out("Heal", 
      default_call_out_time + random(default_call_out_time/10));
  }
}

// ------------------------------------------------------------------------------
void BecomesNetAlive(object player)
{
  if(find_call_out("Heal") == -1) 
    call_out("Heal", default_call_out_time + random(default_call_out_time/10));
}


// ------------------------------------------------------------------------------
string _query_info()
{
  if(TO && ENV(TO) && interactive(ENV(TO)))
  {
    if(ENV(TO)->QueryAttribute(A_INT) >=35)
      switch (ENV(TO)->QueryAttribute(A_INT))
      {
        case 35..39:
          return BS("Du erkennst, dass diese Schattenweihnachtshaube besonders ist, aber "
            "Dein Intellekt reicht nicht, um genaueres zu sagen.");
            break;
        case 40:
         return BS("Du erkennst, dass diese Schattenweihnachtshaube Teil "
            "des Weihnachtsfests ist, und nur zu bestimmten Zeiten zu finden.");
            break;
        default:
          return 0;
          break;
      }
  }
  return 0;
}

// ------------------------------------------------------------------------------
void reset()
{
  ::reset();
  
  if (!TO || !is_clone(TO)) return;
}