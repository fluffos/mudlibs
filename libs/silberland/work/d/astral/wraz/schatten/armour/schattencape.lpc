// Schattencape - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Ein Schattencape");
  SetProp(P_LONG,
    BS("Wie ein in der Ferne sanft und gleichmaessig ueber einen Huegel "
    "ziehender dunkler Nebel erscheint dieses schattenhafte Cape."));
  SetProp(P_NAME, "Schattencape");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "cape", "schattencape", "\nwrazschattencape"}) );
  AddId(ELEMENT_RING_FEUER);

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_VALUE, 12500); 
  
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();
}

// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
}