// Schattenguertel - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Ein Schattenguertel");
  SetProp(P_LONG,
    BS("Aehnlich einem breiten Seil windet sich dieser Schattenguertel durch "
    "die Luft. Schatten fliessen wie Maden seine Windungen entlang."));
    AddDetail("windungen",
      "Die schattenhaften Windungen des Guertels sind unregelmaessig und scheinen sich "
      "staendig neu zu formen, als waeren sie jeden Moment einzigartig.");
  SetProp(P_NAME, "Schattenguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "guertel", "schattenguertel", "\nwrazschattenguertel"}) );
  AddId(ELEMENT_RING_HUMUS);

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_VALUE, 17500); 
  
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();
}

// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
}