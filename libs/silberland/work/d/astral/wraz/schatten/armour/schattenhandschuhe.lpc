// Schattenhandschuhe - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

string *previous_hand_damage_type = ({DT_BLUDGEON});

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Schattenhandschuhe");
  SetProp(P_LONG, 
    "Schatten stroemen durch die Luft und formen ein Paar Handschuhe, die aus Nichts "
    "zu bestehen scheinen. Je laenger Du sie betrachtest, umso schwerer faellt es Dir, "
    "sie zu beschreiben, aber es sind eindeutig Handschuhe.");
  SetProp(P_NAME, "Schattenhandschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"handschuhe","schattenhandschuhe","\nwrazschattenhandschuhe"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE); 
  SetProp(P_VALUE, 12500);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();
  _extra_info = BS("Waehrend die Schattenhandschuhe selbst schattig und dunkel sind, scheint sich "
    "um sie herum das Licht etwas zu verstaerken, als wuerden sie Licht und Schatten "
    "nur trennen.");
}

// ------ WEARFUNC() ------------------------------------------------------
int WearFunc(object me)
{
  if(!me || !ENV(me) || !living(ENV(me))) return 0;

  previous_hand_damage_type = ENV(me)->QueryProp(P_HANDS)[2];
  ENV(me)->SetProp(P_HANDS, ({ENV(me)->QueryProp(P_HANDS)[0],
    ENV(me)->QueryProp(P_HANDS)[1],
    ({DT_LIGHT}) }));

  return schattenset::WearFunc(me);
}

// ------ REMOVEFUNC() ------------------------------------------------------
int RemoveFunc(object me)
{
  if(!me || !ENV(me) || !living(ENV(me))) return 0;
  ENV(me)->SetProp(P_HANDS, ({ENV(me)->QueryProp(P_HANDS)[0],
    ENV(me)->QueryProp(P_HANDS)[1],
    previous_hand_damage_type }));
  
  return schattenset::RemoveFunc(me);
}
// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
}