// ------ HEAL() ----------------------------------------------------------
varargs void Heal(int percent)
{
  object pl;
  if(!TO || !pl=ENV(TO)) return;
  if(!living(pl)) return;

  if(QueryProp(P_WORN) == pl)
  {
    if((pl->QueryProp(P_HP) < pl->QueryProp(P_MAX_HP)) ||
       (pl->QueryProp(P_SP) < pl->QueryProp(P_MAX_SP)))
    {
      pl->Message(BS(Name(WER,1)+" "+_umstroemung+" kurz und intensiv."));
      pl->AddHp(_heal_hp[set_is_complete] * (80+random(41)) / 100);
      pl->AddSp(_heal_sp[set_is_complete] * (80+random(41)) / 100);
    }

    switch (pl->QueryProp(P_GUILD))
    {
      case "paladine":
        if (pl->QueryProp(P_ALIGN) < 1500)
          pl->SetProp(P_ALIGN, pl->QueryProp(P_ALIGN)+random(25) );
        break;
      case "nekromanten":
        if (pl->QueryProp(P_ALIGN) > -1500)
          pl->SetProp(P_ALIGN, pl->QueryProp(P_ALIGN)-random(25) );
        break;
      case "druidenzirkel":
        if (pl->QueryProp(P_ALIGN) > 200)
          pl->SetProp(P_ALIGN, pl->QueryProp(P_ALIGN)-random(25) );
        else if (pl->QueryProp(P_ALIGN) < -200)
          pl->SetProp(P_ALIGN, pl->QueryProp(P_ALIGN)+random(25) );
        break;
      case "zechpreller":
        if (pl->QueryProp(P_ALCOHOL) < 2*pl->QueryProp(P_MAX_ALCOHOL)/3)
          pl->SetProp(P_ALCOHOL,pl->QueryProp(P_ALCOHOL)+random(15) );
        break;
    }
  }

  HealCallOut();
}

// ------ INFO() ----------------------------------------------------------
string _query_info()
{
  if(!TO || !ENV(TO)) return 0;

  if(interactive(ENV(TO)) && ENV(TO)->QueryAttribute(A_INT) >=35)
    switch (ENV(TO)->QueryAttribute(A_INT))
    {
    case 35..39:
      return BS("Du erkennst, dass "+TO->name(WER,1)+" besonders "+
        (TO->QueryProp(P_PLURAL)?"sind":"ist")+", aber "
        "Dein Intellekt reicht nicht, um Genaueres zu sagen.");
      break;
    case 40:
      return BS("Du erkennst, dass "+TO->name(WER,1)+" Teil einer aussergewoehnlichen "
        "Ruestung "+(TO->QueryProp(P_PLURAL)?"sind":"ist")+
        ". Nur, wenn Du alle Teile besitzt, wird sich ihre ganze Macht entfalten.")+
        _extra_info;
      break;
    default: return 0; break;
    }
  return 0;
}

// ------ SetPanzerAc() ---------------------------------------------------
void SetPanzerAc(int ac0, int ac1)
{
  if(!TO) return;
  _ac = ({ac0, ac1});
  SetProp(P_AC, _ac[set_is_complete]-QueryProp(P_DAMAGED));
}

// ------ BECOMES_NET_ALIVE() ----------------------------------------------
void BecomesNetAlive(object player)
{
  HealCallOut();
}

