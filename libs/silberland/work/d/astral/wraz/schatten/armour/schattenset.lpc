  SetProp(P_WEIGHT, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_XP:100000000]) );
  SetProp(P_MATERIAL, ([MAT_SHADOW:50,MAT_MAGIC:50]));
  SetProp(P_QUALITY_DECAY, 750 );
  SetProp(P_MAGIC, 1);
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  seteuid(getuid(TO));
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
  SetProp("federgewichtsbalsam", 1000); // Federgewichtsbalsam wirkt hier nicht
  SetProp("ruestungsbalsam", 10); // Ruestungsbalsam wirkt hier nicht

  DoSetProperties(); // wird hier zum ersten Mal aufgerufen; sonst aus WearFunc() und RemoveFunc()
}