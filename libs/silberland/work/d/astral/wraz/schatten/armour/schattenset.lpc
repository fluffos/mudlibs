inherit "/std/thing/description";
inherit ZONE "std/std.lpc";

int set_is_complete = 0; // muss 0 oder 1 sein

int *_ac, *_hp, *_sp, *_heal_hp, *_heal_sp, *_cold_prot, *_heat_prot;

int default_call_out_time = 450;

int light = 0;

string _umstroemung = "umstroemt Dich";
string _extra_info = "";

mapping dam_prot_physical = ([DT_PIERCE:1,DT_SLASH:1,DT_BLUDGEON:1,DT_RIP:1,
  DT_WHIP:1,DT_SQUEEZE:1]);
mapping dam_prot_elemental = ([DT_FIRE:1, DT_COLD: 1, DT_WATER:1, DT_AIR:1]);

mapping _dam_prot, _gildenboni;

// ------ _SET_AUTOLOADOBJ() ------------------------------------------------
void _set_autoloadobj(mixed data)
{     
  SetProp(P_ITEMD_TMPMAGIC, data);
}

// ------ _QUERY_AUTOLOADOBJ() ----------------------------------------------
mixed _query_autoloadobj()
{   
  return QueryProp(P_ITEMD_TMPMAGIC);
}

// ------ IN_SCHATTENWELT() -------------------------------------------------
int in_schattenwelt(object player)
{
  if(!player || !ENV(player)) return 0;
  if (strstr(file_name(ENV(player)), ROOM) == -1)
    return 0;
  else
    return 1;
}

// ------ HealCallOut() ---------------------------------------------------
void HealCallOut()
{
  if(!TO || !ENV(TO)) return;

  if( (_heal_hp[set_is_complete] || _heal_sp[set_is_complete]) 
    && find_call_out("Heal") == -1) 
  {
    call_out("Heal", 
      default_call_out_time * (80+random(20))/100 * (in_schattenwelt(ENV(TO))?1:2) );
  }
}

// ------ DoSetProperties() ------------------------------------------------
void DoSetProperties()
{
  // Properties setzen
  // Nur bei AC checken, ob >0 (weil Schattenpanzer AC sonst ueberschrieben werden koennte)
  if(_ac[set_is_complete]) SetProp(P_AC, _ac[set_is_complete]-QueryProp(P_DAMAGED));
  SetProp(P_M_HEALTH_MOD, ([P_HP:_hp[set_is_complete], P_SP:_sp[set_is_complete]]));
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:_cold_prot[set_is_complete],
    T_HEAT_PROT:_heat_prot[set_is_complete]]));
  if(set_is_complete) SetProp(P_DAM_PROTECTION, _dam_prot);
  else SetProp(P_DAM_PROTECTION, dam_prot_physical);
  SetProp(P_NEVERDROP, set_is_complete);
  SetProp(P_BERSERKER_BONUS, _gildenboni[P_BERSERKER_BONUS][set_is_complete]);
  SetProp(P_PALADIN_BONUS, _gildenboni[P_PALADIN_BONUS][set_is_complete]);
  SetProp(P_ZECHPRELLER_BONUS, _gildenboni[P_ZECHPRELLER_BONUS][set_is_complete]);
  SetProp(P_NEKRO_BONUS, _gildenboni[P_NEKRO_BONUS][set_is_complete]);
  SetProp(P_ITEMD_ELEMENTAL_VALUE, _gildenboni[P_ITEMD_ELEMENTAL_VALUE][set_is_complete]);
  SetProp(P_BARDEN_BONUS, _gildenboni[P_BARDEN_BONUS][set_is_complete]);
  if(QueryProp(P_ARMOUR_TYPE)==AT_GLOVE)
    SetProp(P_DRUID_ADD_HAND_DAMAGE, _gildenboni[P_DRUID_ADD_HAND_DAMAGE][set_is_complete]);
  if(QueryProp(P_WORN)) 
    QueryProp(P_WORN)->AddResistanceModifier((set_is_complete?
      ([DT_UNHOLY: -0.01, DT_TERROR: -0.02]):
      ([DT_UNHOLY: -0.005, DT_TERROR: -0.01])) );

  if(TO && ENV(TO))
  {
    ENV(TO)->UpdateAttributes(); // fuer zB health modifiers wegen call_out
  }

  // Heal-Callout ausrufen (koennte bei Setvollstaendigkeit erst jetzt aktiv werden)
  HealCallOut();
}

// ------ SetComplete() ---------------------------------------------------
int SetComplete(int i)
{
  if(i == set_is_complete) return set_is_complete;

  set_is_complete = i;
  DoSetProperties();
  return set_is_complete;
}

// ------ CheckIfComplete() ------------------------------------------------
int CheckIfComplete()
{
  object *ruest;
  int i,j;
  string kriegerin, artikel;

  if(!TO || !ENV(TO) || !living(ENV(TO))) return 0;

  // Zaehle, ob alle Setteile getragen werden
  ruest = ENV(TO)->QueryArmours();
  j=0;
  for(i=0; i<sizeof(ruest); i++)
  {
    if(ruest[i]->id("\nwrazschattenset")) j++;
  }

  // Alle Setteile da?
  if(j==11) // ja
  {
    set_is_complete = 1;
    switch(ENV(TO)->QueryProp(P_GENDER))
    {
      case MALE: artikel="ein"; kriegerin="Schattenkrieger"; break;
      case FEMALE: artikel="eine"; kriegerin="Schattenkriegerin"; break;
      default: artikel="ein*e"; kriegerin="Schattenkrieger*in"; break;
    }
    if(ENV(TO)->QueryProp("last_schattenkrieger_set") < time()-1)
    { // sonst kommt die Meldung bei "trage alles" 11 mal :)
      ENV(TO)->SetProp("last_schattenkrieger_set", time());
      ENV(TO)->SetProp(P_PRESAY, getcolor("blue")+kriegerin+getcolor("none"));
      ENV(TO)->Message(BS(" Du bist nun "+artikel+" "+kriegerin+"!"));
    }
  }
  else // nein (Set unvollstaendig)
    set_is_complete = 0;

  // Setze set_is_complete in allen getragenen (!) Setteilen
  for(i=0;i<sizeof(ruest);i++)
  {
    if(ruest[i]->id("\nwrazschattenset"))
    {
      ruest[i]->SetComplete(set_is_complete);
    }
  }
}

// ------ UpdateAfterUnwear() ----------------------------------------------
int UpdateAfterUnwear()
{
  object *ruest;
  int i,j;

  if(!TO || !ENV(TO) || !living(ENV(TO))) return 0;

  if(!QueryProp(P_WORN)) set_is_complete = 0;
  else return 0; // Ende hier, wenn die Ruestung noch getragen wird

  ruest = ENV(TO)->QueryArmours();

  // Setze set_is_complete in allen getragenen (!) Setteilen
  for(i=0;i<sizeof(ruest);i++)
  {
    if(ruest[i]->id("\nwrazschattenset"))
    {
      ruest[i]->SetComplete(set_is_complete);
    }
  }

  // update Props in dieser Ruestung (die ja gerade ausgezogen wurde, daher nicht 
  //  in ruest aufscheint)
  DoSetProperties();
}

// ------ WEARFUNC() ------------------------------------------------------
int WearFunc(object me)
{
  if(!me || !ENV(me) || !living(ENV(me))) return 0;

  if(find_call_out("CheckIfComplete") == -1) call_out("CheckIfComplete", 0);

  // Licht/Dunkelheit setzen
  if(QueryProp(P_ARMOUR_TYPE)==AT_BELT)
  {
    if(ENV(TO)->QueryProp(P_GUILD)=="Nekromanten")
      light = -2;
    else light = 1;
  }
  if(light)
  {
    SetProp(P_LIGHT, light);
    if(light > 0)
      ENV(TO)->Message(BS(Name(WER,1)+" beginnt zu leuchten."));
    else if(light < 0)
      ENV(TO)->Message(BS(Name(WER,1)+" verdunkelt die Umgebung."));
  }

  return 1;
}

// ------ REMOVEFUNC() ------------------------------------------------------
int RemoveFunc(object me)
{
  if(!me || !ENV(me) || !living(ENV(me))) return 0;
  if(find_call_out("UpdateAfterUnwear") == -1) call_out("UpdateAfterUnwear", 0);

  // ev. Presay wieder loeschen
  if(strstr(ENV(me)->QueryProp(P_PRESAY),getcolor("blue")+"Schattenkrieger")>=0)
    ENV(me)->SetProp(P_PRESAY, 0);

  // Licht/Dunkelheit wieder entfernen
  if(QueryProp(P_ARMOUR_TYPE)==AT_BELT)
  {
    if (light > 0)
      write(Name(WER,1)+" wird wieder dunkel.\n");
    else if (light < 0)
      write(Name(WER,1)+" verliert seine dunkle Aura.\n");
    SetProp(P_LIGHT, 0);
  }

  // Resistenzen entfernen
  QueryProp(P_WORN)->RemoveResistanceModifier();
  
  return 1;
}
