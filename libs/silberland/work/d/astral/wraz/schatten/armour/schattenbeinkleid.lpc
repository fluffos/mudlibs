// Schattenbeinkleid - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Ein Schattenbeinkleid");
  SetProp(P_LONG,
    BS("Zwei schattig-graeuliche Windhosen ersinnen dieses seltsame, scheinbar "
    "immaterielle Beinkleid. Sie bewegen sich, und verharren doch am gleichen "
    "Ort."));
  SetProp(P_NAME, "Schattenbeinkleid");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "beinkleid", "schattenbeinkleid", "windhose", "windhosen",
  "\nwrazschattenbeinkleid"}) );
  AddId(ELEMENT_RING_EIS);

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_VALUE, 12500); 
  
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();
}

// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
}