// Schattenring - Teil des Schattensets
// Schattenwelt
// von Wraz / Mendralim

#include "../def.h"

inherit "std/armour";
inherit ZONE "std/std.lpc";
inherit ARMOUR "schattenset.lpc";

#include "/p/daemon/itemd/itemd.h"
#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,"Ein Schattenring");
  SetProp(P_LONG,
    BS("Ein fast perfekter Ring aus Schatten. Nur bei ganz genauer Betrachtung "
    "erkennst Du die winzigen Unregelmaessigkeiten, die ihn als Schatten entlarven."));
  AddDetail(({"unregelmaessigkeiten","unregelmaessigkeit"}),
    "Sie sind grau, unnatuerlich, fast daemonisch. Und doch wunderschoen.");
  SetProp(P_NAME, "Schattenring");
  SetProp(P_GENDER, MALE);
  AddId( ({ "ring", "schattenring", "\nwrazschattenring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_VALUE, 12500); 
  
  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );

  DoSetup();
}

// ------ RESET() ---------------------------------------------------------
void reset()
{
  ::reset();
  if (!TO || !is_clone(TO)) return;
}