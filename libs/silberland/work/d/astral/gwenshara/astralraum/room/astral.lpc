#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG, 
     "Dich umgibt ein graues, undefinierbares Wabern. Staendig hast du das Gefuehl zu fallen "
     "und in deinen Ohren rauscht es. In dem farblosen grau kannst du nur einen zentralen "
     "gluehenden Punkt erkennen - den Nexus, der alle Welten verbindet");

    AddDestination("nexus");
    ConnectRegion("dschungel");
    ConnectRegion("ebene");
    ConnectRegion("gebirge");
    ConnectRegion("huegelland");
    ConnectRegion("kristallwald");
    ConnectRegion("polar");
    ConnectRegion("unterwelt");
    ConnectRegion("wasser");
    ConnectRegion("wueste");
}