#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG,
        "Du kreist hoch ueber den Wellen des Meeres. Unter dir sausen einige "
        "kleinere und groessere Inseln vorbei. Im Vorueberfliegen kannst du "
        "eine kahle Felseninsel mit einer kleinen Huette darauf erkennen. Auf "
        "einer anderen Insel entdeckst du ein kleine Staedtchen, waehrend die "
        "kahle und duestere Zombieinsel duester am Rande deines Blickfelds "
        "thront. Am Ufer des Festlands erkennst du das kleine Fischerdorf, sowie "
        "die Piratenstadt Knarkh. Mit einer Schlaufe in den Norden kannst du "
        "den kalten Polarkreis erreichen, waehrend der maechtige Dschungel am "
        "suedlichen Horizont auf dich wartet.");

    AddDestination("fischerdorf");
    AddDestination("knarkh");
    AddDestination("zombieinsel");
    AddDestination("mauritius");
    AddDestination("hypros");
    AddDestination("felseninsel");

    ConnectRegion("astral");
    //ConnectRegion("andracia");
    ConnectRegion("ebene");
    ConnectRegion("huegelland");
    ConnectRegion("dschungel");
    ConnectRegion("wueste");
    ConnectRegion("polar");
}