#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG,
        "Schwuele Luft rauscht durch deine Schwingen, als du ueber dem "
        "feuchten Blaetterdach des Dschungels deine Runden drehst. Das "
        "meiste des kaum erkundeten Lands wird von dichten Blaettern verdeckt. "
        "An der Kueste erkennst du gut sichtbar den Hafen von Tijara und weiter "
        "westlich das Dorf der Dschungelelfen.");

    AddDestination("tijara");
    AddDestination("dschungelelfendorf");

    //ConnectRegion("astral");
    ConnectRegion("wasser");
    ConnectRegion("unterwelt");
    ConnectRegion("astral");
}