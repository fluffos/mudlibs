#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG,
        "Mit rasender Geschwindigkeit zischst du durch die finsteren "
        "Gaenge der Unterwelt. Schmale Tunnel und grosse Hoehlen wechseln "
        "sich hier ab. Als du um eine Biegung zischst flatterst du rasant "
        "ueber die Stad Dhrkion, wo die Dunkelelfen leben und am Ende "
        "eines anderen Ganges schiesst du mit atemberaubendem Getoese "
        "in den Sternenwald hinaus. Ein rascher Looping fuehrt dich ueber "
        "den gefaehrlichen Saeuresee in dessen Mitte die Insel Yaq'Monoq "
        "mit dem Ritualort der Nekromanten.");

    AddDestination("dhrkion");
    AddDestination("sternenwald");
    AddDestination("yaq'monoq");

    ConnectRegion("ebene");
    ConnectRegion("huegelland");
    ConnectRegion("dschungel");
    ConnectRegion("gebirge");
    ConnectRegion("wueste");
    ConnectRegion("astral");
}