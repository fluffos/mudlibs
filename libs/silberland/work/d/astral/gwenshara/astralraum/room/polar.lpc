#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG,
        "Eiskristalle und Schnee wehen dir um den Kopf, als du in den hohen "
        "Norden vorstoesst. Die Sonne ist hinter dem Horizont im Sueden nur "
        "halb zu erkennen. Unter dir erstreckt sich eine Landschaft aus "
        "Schnee und Klirrfrost. Nahe einem grossen, eisbedeckten Geirge erkennst "
        "du am Ufer des Polarmeeres das kleine Walfaengerdorf Smoersky. Weiter "
        "im Norden steigen die Rauchsaeulen des Dorfes Yiqanuc auf.");

    AddDestination("smoersky");
    AddDestination("yiqanuc");

    ConnectRegion("wasser");
    ConnectRegion("astral");
}