#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG,
        "Sanfte Huegel und gruene Weiden ziehen unter dir dahin. Du drehst hohe "
        "Kreise ueber dem Huegelland und nur wenige Schaefchenwolken schweben "
        "ueber dir. Weit unten erkennst du den Osterhasen hoppeln. Suedlich "
        "siehst du die gemuetlichen Wohnhoehlen der Hobbits von Derlim. Nahe am "
        "Kristallwald fallen gelegentlich Baeume im Holzfellerlager. Auf einer "
        "kleinen Lichtung im Nordosten erkennst du inmitten mehrer Monolithe den "
        "Druidenzirkel.");

    AddDestination("derlim");
    AddDestination("druidenzirkel");
    AddDestination("holzfaellerlager");

    ConnectRegion("ebene");
    ConnectRegion("kristallwald");
    ConnectRegion("gebirge");
    ConnectRegion("unterwelt");
    ConnectRegion("wasser");
    ConnectRegion("astral");
}