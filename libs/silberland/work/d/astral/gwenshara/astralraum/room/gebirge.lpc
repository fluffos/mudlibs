#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG, 
        "Knatternd saust der Wind durch deine ausgebreiteten Fluegel, "
        "als du dich bis zu den hoechsten Gipfeln aufschwingst. Im "
        "Sturzflug einen Abhang entlang erkennst du den Eingang zur "
        "Zwergenstadt Felonia und das Bergwerk. Auf dem Weg hoch zum "
        "umstuermtesten Felsen rast du am Trollager vorbe. Hinter dem "
        "Sturmfels, wo sich die Burg der Paladine erhebt drehst du noch "
        "eine Runde ueber Arwenock.");

    AddDestination("bergwerk");
    AddDestination("steinstadt");
    AddDestination("felonia");
    AddDestination("sturmfels");
    AddDestination("arwenock");
    AddDestination("trollager");

    ConnectRegion("huegelland");
    ConnectRegion("kristallwald");
    ConnectRegion("ebene");
    ConnectRegion("unterwelt");
    ConnectRegion("astral");
}