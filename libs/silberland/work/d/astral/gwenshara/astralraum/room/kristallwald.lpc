#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG,
        "Unter dir wogt das dunkelgruene Blaetterdach des Kristallwalds. "
        "Zwischen den Baeumen im Westen erblickst du die Talane der Elfenstadt "
        "Elessar. Noerdlich davon erhebt sich der grosse See von Rhodonit, "
        "hinter dem du den Hain der Bardengilde erkennen kannst. Nordwestlich "
        "des Sees erkennst du die Zentaurenstadt Roch Adan und noch weiter "
        "im Norden die Hochebene und den Eingang zur Zwergenfest Ardhmir. Wenn "
        "du weit nach Norden fliegst kannst du bis nach Avir gelangen.");

    AddDestination("elessar");
    AddDestination("zentaurenstadt");
    AddDestination("bardengilde");
    AddDestination("ardhmir");
    AddDestination("avir");
    
    ConnectRegion("huegelland");
    ConnectRegion("ebene");
    ConnectRegion("gebirge");
    ConnectRegion("astral");
}