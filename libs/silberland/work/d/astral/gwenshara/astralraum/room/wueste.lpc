#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG,
        "Du kreist hoch ueber den sandigen Duenen der Wueste, die sich unter dir wie "
        "ein gelbes Meer erstrecken. Die sengende Hitze der Sonne brennt auf dich herab. "
        "Im Norden der Sandduenen erkennst du die kleine Palisade des Echsendorfs, waehrend "
        "im Nordosten die stolzen Mauern von Arrakeen und der kleinen Oase davor thronen. "
        "Mittem im Sand kannst du den Krater von Quaul aus machen, wo geschaeftige Reisende "
        "Handel treiben. Am Nordwestlichen Rand der Wueste, wo es gerade in die Steppe "
        "uebergeht, siehst du noch die kleine Oase Erg.");

    AddDestination("arrakeen");
    AddDestination("echsendorf");
    AddDestination("quaul");
    AddDestination("erg");

    ConnectRegion("astral");
    ConnectRegion("wasser");
    ConnectRegion("ebene");
    ConnectRegion("unterwelt");
}