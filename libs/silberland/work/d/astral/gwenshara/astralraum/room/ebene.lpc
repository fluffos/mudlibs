#include "../def.h"

inherit ROOM "std_astralebene";

public void create() {
    ::create();

    SetProp(P_INT_LONG, 
        "Deine guten Augen koennen weit ueber das Grasland der Ebene sehen. "
        "Du drehst einige Kreise ueber Midas, das Mitten in der Ebene liegt, "
        "wobei du auch am Feenschloss vorbei kommst. Im Nordosten erkennst du "
        "die Festung Kyranda.");

    AddDestination("midas");
    AddDestination("kyranda");
    AddDestination("feenschloss");

    //ConnectRegion("astral");
    ConnectRegion("gebirge");
    ConnectRegion("huegelland");
    ConnectRegion("wasser");
    ConnectRegion("wueste");
    ConnectRegion("unterwelt");
    ConnectRegion("astral");
    ConnectRegion("kristallwald");
}