#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Irgendwo auf der Astralebene");
  SetProp(P_INT_LONG,
    "Das Nichts!");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
}

void init()
{
  ::init();
  if(interactive(TP)) return;
  TP->SetProp(P_MNPC_FLAGS, 0);
  tell_room(TO, BS("Astralstroemungen fesseln "+TPN));
  return;
}
