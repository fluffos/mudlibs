#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

inherit NPC "froschsoldat";


void create() {
    mapping res;
    object ob;

    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein giftiger Froschsoldat");
    SetProp(P_LONG,
        "Dieser Froschsoldat traegt ein schmieriges, dunkelgrünes Muster auf "
        "der Haut, das nach altem Sumpfgift riecht. Seine Pupillen sind schmal "
        "und aufmerksam.");
    SetProp(P_NAME, "Giftiger Froschsoldat");
    AddId(({"giftiger froschsoldat", "giftiger", "\nbiberburg_giftiger_froschsoldat"}));

    res = QueryProp(P_RESISTANCE_STRENGTHS) || ([]);
    res += ([DT_POISON: -0.4, DT_HOLY: 0.2, DT_ACID: -0.1]);
    SetProp(P_RESISTANCE_STRENGTHS, res);

    SetProp(P_SPELLRATE, 34);
    AddSpell(3, 240,
        Name(WER,1)+" spuckt eine widerliche Giftfontaene auf Dich.\n",
        Name(WER,1)+" spuckt eine widerliche Giftfontaene auf @WEN.\n",
        DT_POISON, ([SP_SHOW_DAMAGE:1]));
    AddSpell(2, 220,
        Name(WER,1)+" ritzt Dich mit seiner Waffe und injiziert Gift.\n",
        Name(WER,1)+" ritzt @WEN mit seiner Waffe und injiziert Gift.\n",
        ({DT_PIERCE, DT_POISON}), ([SP_SHOW_DAMAGE:1]));

    SUID;
    if (objectp(ob = clone_object(WEAPON "giftspiess")))
        ob->move(TO, M_NOCHECK);
    if (objectp(ob = clone_object(ARMOUR "giftgurt")))
        ob->move(TO, M_NOCHECK);
    command("zuecke giftspiess");
    command("trage alles");
}
