// Sturmreif fuer sturmaffine Froschsoldaten

#include "../def.h"
#include <armour.h>
#include <material.h>

inherit "std/armour";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein schmaler Sturmreif");
    SetProp(P_LONG,
        "Ein metallener Reif fuer das Handgelenk, in den feine Blitzmotive "
        "eingraviert sind. Er summt leise, als wuerde er Ladung speichern.");
    SetProp(P_NAME, "Sturmreif");
    SetProp(P_GENDER, MALE);
    AddId(({"reif", "sturmreif", "armschiene"}));
    SetProp(P_NAME_ADJ, ({"schmal", "blitzend"}));
    AddAdjective(({"schmalen","schmaler","schmalem","schmales","schmale",
                   "blitzenden","blitzender","blitzendem","blitzendes","blitzende"}));

    SetProp(P_VALUE, 700);
    SetProp(P_WEIGHT, 750);
    SetProp(P_MATERIAL, ([ MAT_STEEL: 80, MAT_MAGIC: 20 ]));

    SetProp(P_ARMOUR_TYPE, AT_BRACERS);
    SetProp(P_AC, 8);
    SetProp(P_QUALITY_DECAY, 100);
    SetProp(P_DAM_PROTECTION, ([DT_ELECTRIC: 1]));
    SetProp(P_WORN_TEXT, "angelegt");
}
