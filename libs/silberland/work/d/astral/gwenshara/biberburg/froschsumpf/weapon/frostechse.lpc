// Frostige Axt fuer kaelteaffine Froschsoldaten

#include "../def.h"
#include <material.h>

inherit "std/weapon";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine mit Raureif uebersaeete Axt");
    SetProp(P_LONG,
        "Der Axtkopf ist rau und mit Raureif ueberzogen, der Stiel besteht aus "
        "glattem, kaltem Holz. Beim Anfassen entweicht ein feiner Hauch Kaelte.");
    SetProp(P_NAME, "Frostechse");
    SetProp(P_GENDER, FEMALE);
    AddId(({"echse", "axt", "frostaxt"}));
    SetProp(P_NAME_ADJ, ({"frostig"}));
    AddAdjective(({"frostige","frostiger","frostigen","frostigem","frostiges"}));

    SetProp(P_VALUE, 1050);
    SetProp(P_WEIGHT, 3600);
    SetProp(P_MATERIAL, ([ MAT_WOOD: 50, MAT_STEEL: 50 ]));

    SetProp(P_WEAPON_TYPE, WT_AXE);
    SetProp(P_DAM_TYPE, ({DT_SLASH, DT_COLD}));
    SetProp(P_WC, 210);
    SetProp(P_NR_HANDS, 2);
    SetProp(P_QUALITY_DECAY, 105);
}
