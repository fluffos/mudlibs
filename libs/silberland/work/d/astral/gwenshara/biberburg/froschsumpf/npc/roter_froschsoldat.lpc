#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

inherit NPC "froschsoldat";


void create() {
    mapping res;
    object ob;

    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein roter Froschsoldat");
    SetProp(P_LONG,
        "Die ledrige Haut dieses Froschsoldaten schimmert roetlich und ist warm "
        "wie gluehender Schlick. Seine Bewegungen wirken hektisch und aufbrausend.");
    SetProp(P_NAME, "Roter Froschsoldat");
    AddId(({"roter froschsoldat", "roter", "\nbiberburg_roter_froschsoldat"}));

    res = QueryProp(P_RESISTANCE_STRENGTHS) || ([]);
    res += ([DT_FIRE: -0.35, DT_COLD: 0.25, DT_WATER: 0.15]);
    SetProp(P_RESISTANCE_STRENGTHS, res);

    SetProp(P_SPELLRATE, 35);
    AddSpell(3, 260,
        Name(WER,1)+" speit einen brodelnden Feuerstrahl auf Dich.\n",
        Name(WER,1)+" speit einen brodelnden Feuerstrahl auf @WEN.\n",
        DT_FIRE, ([SP_SHOW_DAMAGE:1]));
    AddSpell(2, 220,
        Name(WER,1)+" schwingt seine Waffe und hinterlaesst eine Flammenspur.\n",
        Name(WER,1)+" schwingt seine Waffe und trifft @WEN mit einer Flammenspur.\n",
        ({DT_SLASH, DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

    SUID;
    if (objectp(ob = clone_object(WEAPON "glutspiess")))
        ob->move(TO, M_NOCHECK);
    if (objectp(ob = clone_object(ARMOUR "glutamulett")))
        ob->move(TO, M_NOCHECK);
    command("zuecke glutspiess");
    command("trage alles");
}
