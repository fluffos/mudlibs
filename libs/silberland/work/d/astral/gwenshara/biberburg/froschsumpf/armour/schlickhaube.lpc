// Schlickhaube fuer saeureaffine Froschsoldaten

#include "../def.h"
#include <armour.h>
#include <material.h>

inherit "std/armour";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine schwere Schlickhaube");
    SetProp(P_LONG,
        "Eine dichte Haube aus getrocknetem Schlick und Schilf, innen mit "
        "Froschhaut ausgekleidet. Sie riecht modrig, schuetzt aber den Kopf.");
    SetProp(P_NAME, "Schlickhaube");
    SetProp(P_GENDER, FEMALE);
    AddId(({"haube", "helm", "schlickhaube"}));
    SetProp(P_NAME_ADJ, ({"schwere", "schlickig"}));
    AddAdjective(({"schwere","schweren","schwerer","schwerem","schweres",
                   "schlickige","schlickigen","schlickiger","schlickigem","schlickiges"}));

    SetProp(P_VALUE, 720);
    SetProp(P_WEIGHT, 1800);
    SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 40, MAT_LEATHER: 60 ]));

    SetProp(P_ARMOUR_TYPE, AT_HELMET);
    SetProp(P_AC, 12);
    SetProp(P_QUALITY_DECAY, 95);
    SetProp(P_DAM_PROTECTION, ([DT_ACID: 1]));
}
