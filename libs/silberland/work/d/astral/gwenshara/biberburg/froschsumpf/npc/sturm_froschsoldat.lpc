#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

inherit NPC "froschsoldat";


void create() {
    mapping res;
    object ob;

    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein sturmumtoster Froschsoldat");
    SetProp(P_LONG,
        "Um diesen Froschsoldaten knistert Luft, kleine Funken springen zwischen "
        "seinen feuchten Fingern. Seine Augen blitzen neugierig.");
    SetProp(P_NAME, "Sturm-Froschsoldat");
    AddId(({"sturm froschsoldat", "sturm-froschsoldat", "sturm", "\nbiberburg_sturm_froschsoldat"}));

    res = QueryProp(P_RESISTANCE_STRENGTHS) || ([]);
    res += ([DT_ELECTRIC: -0.35, DT_WATER: 0.15]);
    SetProp(P_RESISTANCE_STRENGTHS, res);

    SetProp(P_SPELLRATE, 36);
    AddSpell(3, 260,
        Name(WER,1)+" entlaedt einen zuckenden Blitz in Dich.\n",
        Name(WER,1)+" entlaedt einen zuckenden Blitz in @WEN.\n",
        DT_ELECTRIC, ([SP_SHOW_DAMAGE:1]));
    AddSpell(2, 240,
        Name(WER,1)+" schleudert eine knisternde Gabel, die Dich schockt.\n",
        Name(WER,1)+" schleudert eine knisternde Gabel auf @WEN, die schockt.\n",
        ({DT_PIERCE, DT_ELECTRIC}), ([SP_SHOW_DAMAGE:1]));

    SUID;
    if (objectp(ob = clone_object(WEAPON "blitzgabel")))
        ob->move(TO, M_NOCHECK);
    if (objectp(ob = clone_object(ARMOUR "sturmreif")))
        ob->move(TO, M_NOCHECK);
    command("zuecke blitzgabel");
    command("trage alles");
}
