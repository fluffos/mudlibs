// Frostamulett fuer kaelteaffine Froschsoldaten

#include "../def.h"
#include <armour.h>
#include <material.h>

inherit "std/armour";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein blaeulich schimmerndes Frostamulett");
    SetProp(P_LONG,
        "Ein glatter Stein mit feinen Eisadern, eingefasst in kaltes Metall. "
        "Er fuehlt sich erstaunlich kuhl an und riecht nach frischem Eis.");
    SetProp(P_NAME, "Frostamulett");
    SetProp(P_GENDER, NEUTER);
    AddId(({"amulett", "frostamulett"}));
    SetProp(P_NAME_ADJ, ({"frostig", "blaeulich"}));
    AddAdjective(({"frostigen","frostiger","frostigem","frostiges","frostige",
                   "blaeulichen","blaeulicher","blaeulichem","blaeuliches","blaeuliche"}));

    SetProp(P_VALUE, 760);
    SetProp(P_WEIGHT, 580);
    SetProp(P_MATERIAL, ([ MAT_STEEL: 70, MAT_MAGIC: 30 ]));

    SetProp(P_ARMOUR_TYPE, AT_AMULET);
    SetProp(P_AC, 4);
    SetProp(P_QUALITY_DECAY, 110);
    SetProp(P_DAM_PROTECTION, ([DT_COLD: 1]));
    SetProp(P_WORN_TEXT, "umgehaengt");
}
