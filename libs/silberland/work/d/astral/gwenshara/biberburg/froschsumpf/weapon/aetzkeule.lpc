// Aetzende Keule fuer saeureaffine Froschsoldaten

#include "../def.h"
#include <material.h>

inherit "std/weapon";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine triefende Aetzkeule");
    SetProp(P_LONG,
        "Eine knorrige Keule, deren Kopf in schlickigem Schleim getraenkt ist. "
        "Wo sie vorbeistreicht, bleibt ein beissender Geruch zurueck.");
    SetProp(P_NAME, "Aetzkeule");
    SetProp(P_GENDER, FEMALE);
    AddId(({"aetzkeule", "keule"}));
    SetProp(P_NAME_ADJ, ({"aetzend", "schlickig"}));
    AddAdjective(({"aetzende","aetzender","aetzenden","aetzendem","aetzendes",
                   "schlickige","schlickiger","schlickigen","schlickigem","schlickiges"}));

    SetProp(P_VALUE, 900);
    SetProp(P_WEIGHT, 3400);
    SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 70, MAT_MISC_PLANT: 30 ]));

    SetProp(P_WEAPON_TYPE, WT_CLUB);
    SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_ACID}));
    SetProp(P_WC, 160);
    SetProp(P_NR_HANDS, 1);
    SetProp(P_QUALITY_DECAY, 95);
}
