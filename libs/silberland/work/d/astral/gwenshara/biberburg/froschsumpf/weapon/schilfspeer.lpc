// Einfacher, feuchter Schilfspeer fuer Froschsoldaten

#include "../def.h"
#include <material.h>

inherit "std/weapon";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein feuchter Schilfspeer");
    SetProp(P_LONG,
        "Ein ausgedorrter Schilfspeer mit einer zugespitzten, getrockneten "
        "Schilfrohrspitze. Er ist leicht und fuer schnelle Stiche geeignet.");
    SetProp(P_NAME, "Schilfspeer");
    SetProp(P_GENDER, MALE);
    AddId(({"speer", "schilfspeer"}));
    SetProp(P_NAME_ADJ, ({"feucht", "schilf"}));
    AddAdjective(({"feuchten","feuchter","feuchtem","feuchtes","feuchte",
                   "schilfigen","schilfiger","schilfigem","schilfiges","schilfige"}));

    SetProp(P_VALUE, 450);
    SetProp(P_WEIGHT, 2800);
    SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 70, MAT_MISC_PLANT: 30 ]));

    SetProp(P_WEAPON_TYPE, WT_SPEAR);
    SetProp(P_DAM_TYPE, DT_PIERCE);
    SetProp(P_WC, 230);
    SetProp(P_NR_HANDS, 2);
    SetProp(P_QUALITY_DECAY, 100);
}
