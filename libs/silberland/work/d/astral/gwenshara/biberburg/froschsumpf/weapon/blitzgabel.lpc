// Blitzgeladene Gabel fuer sturmaffine Froschsoldaten

#include "../def.h"
#include <material.h>

inherit "std/weapon";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine knisternde Blitzgabel");
    SetProp(P_LONG,
        "Ein dreizinkiger Stab mit metallenen Spitzen, die leicht knistern. "
        "Ein feiner ozoniger Geruch liegt in der Luft.");
    SetProp(P_NAME, "Blitzgabel");
    SetProp(P_GENDER, FEMALE);
    AddId(({"blitzgabel", "gabel"}));
    SetProp(P_NAME_ADJ, ({"blitzend", "knisternd"}));
    AddAdjective(({"blitzende","blitzender","blitzenden","blitzendem","blitzendes",
                   "knisternde","knisternder","knisternden","knisterndem","knisterndes"}));

    SetProp(P_VALUE, 1150);
    SetProp(P_WEIGHT, 3300);
    SetProp(P_MATERIAL, ([ MAT_STEEL: 60, MAT_MISC_WOOD: 40 ]));

    SetProp(P_WEAPON_TYPE, WT_SPEAR);
    SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_ELECTRIC}));
    SetProp(P_WC, 175);
    SetProp(P_NR_HANDS, 2);
    SetProp(P_QUALITY_DECAY, 105);
}
