// Giftiger Speer fuer toxinorientierte Froschsoldaten

#include "../def.h"
#include <material.h>

inherit "std/weapon";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein mit Gift bestrichener Speer");
    SetProp(P_LONG,
        "Ein schlanker Speer mit einer duennen Klinge, die nach altem Sumpfgift "
        "riecht. Die Spitze ist dunkel verfaerbt und oelig.");
    SetProp(P_NAME, "Giftspiess");
    SetProp(P_GENDER, MALE);
    AddId(({"giftspiess", "speer"}));
    SetProp(P_NAME_ADJ, ({"giftig"}));
    AddAdjective(({"giftigen","giftiger","giftigem","giftiges","giftige"}));

    SetProp(P_VALUE, 980);
    SetProp(P_WEIGHT, 3200);
    SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 65, MAT_MISC_PLANT: 35 ]));

    SetProp(P_WEAPON_TYPE, WT_SPEAR);
    SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_POISON}));
    SetProp(P_WC, 165);
    SetProp(P_NR_HANDS, 2);
    SetProp(P_QUALITY_DECAY, 100);
}
