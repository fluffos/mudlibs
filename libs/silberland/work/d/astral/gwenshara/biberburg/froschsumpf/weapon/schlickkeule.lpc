// Schwere, schleimige Keule aus sumpfigem Holz

#include "../def.h"
#include <material.h>

inherit "std/weapon";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine schleimige Schlickkeule");
    SetProp(P_LONG,
        "Ein krummer, schwerer Ast aus dem Sumpf, verstaerkt mit getrocknetem "
        "Schlick. Das feuchte Holz macht die Keule schwer, aber beeindruckend "
        "wuchtig.");
    SetProp(P_NAME, "Schlickkeule");
    SetProp(P_GENDER, FEMALE);
    AddId(({"keule", "schlickkeule"}));
    SetProp(P_NAME_ADJ, ({"schleimig", "schlickig"}));
    AddAdjective(({"schleimige","schleimiger","schleimigen","schleimigem",
                   "schleimiges","schlickige","schlickiger","schlickigen",
                   "schlickigem","schlickiges"}));

    SetProp(P_VALUE, 380);
    SetProp(P_WEIGHT, 3600);
    SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 80, MAT_MISC_PLANT: 20 ]));

    SetProp(P_WEAPON_TYPE, WT_CLUB);
    SetProp(P_DAM_TYPE, DT_BLUDGEON);
    SetProp(P_WC, 160);
    SetProp(P_WC_FIX, 5);
    SetProp(P_NR_HANDS, 1);
    SetProp(P_QUALITY_DECAY, 95);
}
