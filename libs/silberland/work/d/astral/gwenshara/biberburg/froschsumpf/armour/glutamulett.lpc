// Glutamulett fuer feueraffine Froschsoldaten

#include "../def.h"
#include <armour.h>
#include <material.h>

inherit "std/armour";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein glimmendes Glutamulett");
    SetProp(P_LONG,
        "Ein rundes Amulett aus dunklem Metall, dessen Mitte rot glimmt. Es "
        "verbreitet wohlige Waerme und schuetzt leicht vor Hitze.");
    SetProp(P_NAME, "Glutamulett");
    SetProp(P_GENDER, NEUTER);
    AddId(({"amulett", "glutamulett"}));
    SetProp(P_NAME_ADJ, ({"glimmend"}));
    AddAdjective(({"glimmendes","glimmenden","glimmender","glimmendem","glimmende"}));

    SetProp(P_VALUE, 750);
    SetProp(P_WEIGHT, 600);
    SetProp(P_MATERIAL, ([ MAT_STEEL: 80, MAT_MAGIC: 20 ]));

    SetProp(P_ARMOUR_TYPE, AT_AMULET);
    SetProp(P_AC, 4);
    SetProp(P_QUALITY_DECAY, 110);
    SetProp(P_DAM_PROTECTION, ([DT_FIRE: 1]));
    SetProp(P_WORN_TEXT, "umgehaengt");
}
