// Giftgurt fuer toxinorientierte Froschsoldaten

#include "../def.h"
#include <armour.h>
#include <material.h>

inherit "std/armour";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein mit Kraeutern durchtraenkter Giftgurt");
    SetProp(P_LONG,
        "Ein breiter Gurt aus geflochtener Froschhaut, in den getrocknete "
        "Sumpfkraeuter eingearbeitet wurden. Ein leicht beissender Duft entweicht.");
    SetProp(P_NAME, "Giftgurt");
    SetProp(P_GENDER, MALE);
    AddId(({"gurt", "giftgurt"}));
    SetProp(P_NAME_ADJ, ({"kraeuter", "giftig"}));
    AddAdjective(({"kraeuterigen","kraeuteriger","kraeuterigem","kraeuteriges","kraeuterige",
                   "giftigen","giftiger","giftigem","giftiges","giftige"}));

    SetProp(P_VALUE, 650);
    SetProp(P_WEIGHT, 900);
    SetProp(P_MATERIAL, ([ MAT_LEATHER: 70, MAT_MISC_PLANT: 30 ]));

    SetProp(P_ARMOUR_TYPE, AT_BELT);
    SetProp(P_AC, 4);
    SetProp(P_QUALITY_DECAY, 95);
    SetProp(P_DAM_PROTECTION, ([DT_POISON: 1]));
    SetProp(P_WORN_TEXT, "umgeschnallt");
}
