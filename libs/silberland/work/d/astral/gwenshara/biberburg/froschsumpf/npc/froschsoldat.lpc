
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"

private void EquipBaseGear();

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein Froschsoldat");
    SetProp(P_LONG,
        "Dieser Froschsoldat ist ein grosser, muskulöser Amphibienkrieger mit "
        "grüner, feuchter Haut und kräftigen Gliedern. Seine Augen sind groß und "
        "leuchtend, und er trägt eine primitive Rüstung aus Schilfrohr und "
        "Froschhaut.Trotz seines furchterregenden Aussehens strahlt er eine gewisse "
        "Disziplin und Loyalität aus, als ob er einem höheren Zweck dient."
    );
    SetProp(P_NAME, "Froschsoldat");
    SetProp(P_GENDER, MALE);
    AddId(({"soldat", "froschsoldat", "\nbiberburg_froschsoldat"}));

    create_default_npc(26);
    SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
    SetProp(P_RACE, "Frosch");
    SetProp(P_SIZE, 0);
    SetProp(P_WEIGHT, 75000);
    SetProp(P_ALIGN, 0);
    SetProp(P_MAX_HANDS, 2);
    SetProp(P_HEAL,0);
    SetProp(P_AGGRESSIVE,0);
    SetProp(P_WIMPY, 0);
    SetProp(P_NOMAGIC,0);
    SetProp(P_RESISTANCE_STRENGTHS , 
        ([DT_FIRE:    0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
        DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
        DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
        DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0, DT_MIND:   0.0]) );

    SetProp(P_MSGIN, "kommt an");
    SetProp(P_MSGOUT, "geht");
    SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
    SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

    SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
    SetProp(P_NOCORPSE, 0 );

    AddInfo(DEFAULT_INFO, "quakt laut.\n");
    AddInfo("gwenshara", "Gwenshara hat mich erschaffen.","sagt: ");

    AddInfo( ({"",""}),
        ".",
        "sagt: ");

    SetProp(P_LOG_INFO, "npc_logfile");

    SetProp( P_REJECT, ({ REJECT_DROP,
        "Der Soldat will Deine Sachen nicht tragen.\n" }) );

    SetProp(P_SPELLRATE,25);
    AddSpell(3, 250,
        Name(WER,1)+" schnellt seine klebrige Zunge nach Dir.\n",
        Name(WER,1)+" schnellt seine klebrige Zunge nach @WEM.\n",
        DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
    AddSpell(2, 250,
        Name(WER,1)+" spuckt einen Schwall beissenden Sumpfschleims auf Dich.\n",
        Name(WER,1)+" spuckt einen Schwall beissenden Sumpfschleims auf @WEN.\n",
        DT_ACID, ([SP_SHOW_DAMAGE:1]));
    AddSpell(2, 250,
        Name(WER,1)+" laesst eine platschnasse Welle ueber Dich zusammenschlagen.\n",
        Name(WER,1)+" laesst eine platschnasse Welle ueber @WEM zusammenschlagen.\n",
        DT_WATER, ([SP_SHOW_DAMAGE:1]));

    SUID;
    EquipBaseGear();
}

private void EquipBaseGear() {
    object ob;
    string weapon;
    string *weapons, *armours;
    
    weapons = ({
        WEAPON "schilfspeer",
        WEAPON "schlickkeule"
    });
    armours = ({
        ARMOUR "schilfruestung",
        ARMOUR "schilfschild"
    });

    weapon = weapons[random(sizeof(weapons))];
    if (objectp(ob = clone_object(weapon)))
        ob->move(TO, M_NOCHECK);
    
    // Brustschutz immer, Schild mit 50% Chance dazu.
    if (objectp(ob = clone_object(armours[0])))
        ob->move(TO, M_NOCHECK);
    if (!random(2) && objectp(ob = clone_object(armours[1])))
        ob->move(TO, M_NOCHECK);

    command("zuecke "+explode(weapon,"/")[<1]);
    command("trage alles");
}
