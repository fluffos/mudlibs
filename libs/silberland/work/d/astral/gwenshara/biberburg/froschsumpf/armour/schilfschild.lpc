// Einfacher Schild aus Schilfbuescheln und Holzrahmen

#include "../def.h"
#include <armour.h>
#include <material.h>

inherit "std/armour";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein mit Schilf umwickelter Rundschild");
    SetProp(P_LONG,
        "Ein runder Schild aus biegsamen Zweigen, eng mit Schilfhalmen umwickelt. "
        "Er haelt leichte Schlaege ab und ist erstaunlich schwimmfaehig.");
    SetProp(P_NAME, "Schilfschild");
    SetProp(P_GENDER, MALE);
    AddId(({"schild", "rundschild", "schilfschild"}));
    SetProp(P_NAME_ADJ, ({"rund", "schilf"}));
    AddAdjective(({"runden","runder","rundem","rundes","runde",
                   "schilfigen","schilfiger","schilfigem","schilfiges","schilfige"}));

    SetProp(P_VALUE, 420);
    SetProp(P_WEIGHT, 2800);
    SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 70, MAT_MISC_PLANT: 30 ]));

    SetProp(P_ARMOUR_TYPE, AT_SHIELD);
    SetProp(P_AC, 25);
    SetProp(P_QUALITY_DECAY, 85);
    SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
    SetProp(P_WORN_TEXT, "umgeschnallt");
}
