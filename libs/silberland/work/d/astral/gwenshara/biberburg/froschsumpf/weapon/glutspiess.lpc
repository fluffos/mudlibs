// Glutiger Speer fuer feueraffine Froschsoldaten

#include "../def.h"
#include <material.h>

inherit "std/weapon";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein glutheisser Speer");
    SetProp(P_LONG,
        "Der Speer besteht aus dunklem, erhitztem Holz, dessen Spitze von einem "
        "glimmenden Metallkeil verstaerkt wird. Leichtes Funkeln laesst Hitze "
        "ahnen.");
    SetProp(P_NAME, "Glutspeer");
    SetProp(P_GENDER, MALE);
    AddId(({"glutspeer", "speer"}));
    SetProp(P_NAME_ADJ, ({"glutheiss", "funkelnd"}));
    AddAdjective(({"glutheissen","glutheisser","glutheissem","glutheisses",
                   "glutheisse","funkelnden","funkelnder","funkelndem",
                   "funkelndes","funkelnde"}));

    SetProp(P_VALUE, 1100);
    SetProp(P_WEIGHT, 3400);
    SetProp(P_MATERIAL, ([ MAT_OAK: 60, MAT_STEEL: 40 ]));

    SetProp(P_WEAPON_TYPE, WT_SPEAR);
    SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_FIRE}));
    SetProp(P_WC, 170);
    SetProp(P_NR_HANDS, 2);
    SetProp(P_QUALITY_DECAY, 105);
}
