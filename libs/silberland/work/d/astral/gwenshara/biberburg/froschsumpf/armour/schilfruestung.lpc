// Leichte Schilfruestung fuer Froschsoldaten

#include "../def.h"
#include <armour.h>
#include <material.h>

inherit "std/armour";

void create() {
    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Eine zusammengeschnuerte Schilfruestung");
    SetProp(P_LONG,
        "Getrocknete Schilfrohre wurden zu Matten geflochten und mit Froschhaut "
        "zusammengebunden. Sie bietet ein wenig Schutz, ohne die Beweglichkeit "
        "im Sumpf zu behindern.");
    SetProp(P_NAME, "Schilfruestung");
    SetProp(P_GENDER, FEMALE);
    AddId(({"ruestung", "schilfruestung", "brustpanzer"}));
    SetProp(P_NAME_ADJ, ({"schilf", "geflochten"}));
    AddAdjective(({"schilfruestung","schilfene","schilfenen","schilfener",
                   "schilfenes","geflochtene","geflochtenen","geflochtenem",
                   "geflochtenes"}));

    SetProp(P_VALUE, 520);
    SetProp(P_WEIGHT, 6200);
    SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 60, MAT_MISC_PLANT: 40 ]));

    SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
    SetProp(P_AC, 30);
    SetProp(P_QUALITY_DECAY, 90);
    SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);
}
