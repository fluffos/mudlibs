#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

inherit NPC "froschsoldat";

void create() {
    mapping res;
    object ob;

    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein saeuretriefender Froschsoldat");
    SetProp(P_LONG,
        "Schleimige Tropfen laufen ueber die Haut dieses Froschsoldaten und "
        "hinterlassen kleine Aetzspuren. Er bewegt sich mit zischender Gier.");
    SetProp(P_NAME, "Saeure-Froschsoldat");
    AddId(({"saeure froschsoldat", "saeure-froschsoldat", "saeure", "\nbiberburg_saeure_froschsoldat"}));

    res = QueryProp(P_RESISTANCE_STRENGTHS) || ([]);
    res += ([DT_ACID: -0.35, DT_FIRE: 0.2, DT_COLD: 0.1]);
    SetProp(P_RESISTANCE_STRENGTHS, res);

    SetProp(P_SPELLRATE, 34);
    AddSpell(3, 250,
        Name(WER,1)+" spritzt brennenden Schleim nach Dir.\n",
        Name(WER,1)+" spritzt brennenden Schleim nach @WEN.\n",
        DT_ACID, ([SP_SHOW_DAMAGE:1]));
    AddSpell(2, 230,
        Name(WER,1)+" laesst eine saure Pfuetze unter Dir aufplatzen.\n",
        Name(WER,1)+" laesst eine saure Pfuetze unter @WEM aufplatzen.\n",
        ({DT_ACID, DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

    SUID;
    if (objectp(ob = clone_object(WEAPON "aetzkeule")))
        ob->move(TO, M_NOCHECK);
    if (objectp(ob = clone_object(ARMOUR "schlickhaube")))
        ob->move(TO, M_NOCHECK);
    command("zuecke aetzkeule");
    command("trage alles");
}
