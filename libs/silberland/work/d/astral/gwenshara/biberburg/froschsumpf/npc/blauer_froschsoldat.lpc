#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

inherit NPC "froschsoldat";

void create() {
    mapping res;
    object ob;

    if (!is_clone(TO)) return;
    ::create();

    SetProp(P_SHORT, "Ein blauer Froschsoldat");
    SetProp(P_LONG,
        "Die Haut dieses Froschsoldaten schimmert blaeulich und wirkt kuehl und "
        "glatt wie ein nasser Stein. Er bewegt sich ruhig, fast wie eine "
        "traeg fliessende Stroemung.");
    SetProp(P_NAME, "Blauer Froschsoldat");
    AddId(({"blauer froschsoldat", "blauer", "\nbiberburg_blauer_froschsoldat"}));

    res = QueryProp(P_RESISTANCE_STRENGTHS) || ([]);
    res += ([DT_COLD: -0.35, DT_WATER: -0.25, DT_FIRE: 0.3]);
    SetProp(P_RESISTANCE_STRENGTHS, res);

    SetProp(P_SPELLRATE, 32);
    AddSpell(3, 240,
        Name(WER,1)+" schickt eine schneidende Kaeltewelle ueber Dich.\n",
        Name(WER,1)+" schickt eine schneidende Kaeltewelle ueber @WEM hinweg.\n",
        DT_COLD, ([SP_SHOW_DAMAGE:1]));
    AddSpell(2, 260,
        Name(WER,1)+" erstickt Dich in einer gurgelnden Wasserblase.\n",
        Name(WER,1)+" erstickt @WEN in einer gurgelnden Wasserblase.\n",
        ({DT_WATER, DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

    SUID;
    if (objectp(ob = clone_object(WEAPON "frostechse")))
        ob->move(TO, M_NOCHECK);
    if (objectp(ob = clone_object(ARMOUR "frostamulett")))
        ob->move(TO, M_NOCHECK);
    command("zuecke frostaxt");
    command("trage alles");
}
