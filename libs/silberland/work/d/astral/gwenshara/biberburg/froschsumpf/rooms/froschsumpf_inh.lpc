#include "../../def.h"
inherit "std/room";

public void create() {
    ::create();
    SetProp(P_INT_SHORT, "Im Froschsumpf");
    SetProp(P_INT_LONG,
        "Du befindest dich mitten im Froschsumpf. Ueberall um dich herum "
        "siehst du moorige, sumpfige Landschaft. Hohe Grashalme und "
        "Schilfrohr wachsen hier in Huelle und Fuelle. Der Boden ist "
        "feucht und matschig, und es riecht stark nach fauligem Wasser. "
        "Vereinzelt quaken Froesche und andere Amphibien, die in diesem "
        "Sumpfgebiet leben. Der Himmel ist grau und wolkenverhangen, was "
        "der ganzen Szenerie eine duestere Atmosphaere verleiht."
    );

    AddSmell(DEFAULT_SMELL, "Der Geruch von fauligem Wasser liegt in der Luft.");
    AddSound(DEFAULT_SOUND, "Das Quaken von Froeschen ist allgegenwaertig.");
}