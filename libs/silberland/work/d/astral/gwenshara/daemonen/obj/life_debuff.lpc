#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_MAGIC, 1);
    SetProp(P_WEIGHT, 0);
    SetProp(P_X_HEALTH_MOD, ([P_HP: -10-random(10)]));

    AddId("\ngwenshara_siegel_life_debuff");
}

public void startRemove() {
    if(!objectp(ENV(TO))) {
        remove(1);
        return;
    }

    ENV(TO)->UpdateAttrbutes();
    call_out("remove", 120, 1);
}