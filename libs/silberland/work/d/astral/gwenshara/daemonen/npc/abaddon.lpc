#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

private int nextRage;

public void create() {
  object ob;

  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Abaddon, blutsaufender Verschlinger der Wut, Heerfuehrer der jenseitigen Mordscharen");
  SetProp(P_LONG,
    "Haushoch erhebt sich vor der der blutruenstige Daemonenfuerst Abbadaon. Er ist "
    "bekannt als der blutsaufende Verschlinger der Wut. Ihm obliegt es den hoellischen "
    "Heerscharen voranzuschreiten. Seinen Feinden bringt er Gemetzel, Verstuemmelung und "
    "grauenhaftes Zerstueckeln.\n"
    "Sein Antlitz ist das eines riesigen, schwer gepanzerten Minotauren mit sechs Armen und "
    "neun Augen. Eine lange, rote und gespaltene Zunge haengt wild flatternd aus seinem "
    "stierartigen Maul mit den riesen Reisszaehnen eines Ebers. Jede seiner Haende schwingt "
    "eine brutale Mordwaffe und unzaehlige Stacheln wachsen aus seiner Ruestung.");

  SetProp(P_NAME, "Abaddon");
  SetProp(P_GENDER, MALE);
  AddId(({"abaddon", "verschlinger", "heerfuehrer", "\ngwenshara_abaddon"}));
  SetProp(P_ARTICLE, 0);

  create_default_npc(45);

  SetProp(P_HANDS, ({" mit seinen sechs Mordwaffen",
                    (int) (QueryProp(P_HANDS)[1] * 1.5),
                    ({DT_SLASH, DT_RIP, DT_BLUDGEON, DT_WHIP, DT_SQUEEZE, DT_PIERCE, DT_UNHOLY})
                    }) );

  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 600);
  SetProp(P_WEIGHT, 575000);
  SetProp(P_ALIGN, -6666);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 40);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" verschliengt @WEN bruellend.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:      0.1, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.1, DT_EXPLOSION:  -0.2,
       DT_SOUND:     0.0, DT_LIGHT:     0.3, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:   -0.1, DT_TERROR:     -0.5,
       DT_HOLY:      0.5, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.2,
       DT_MIND:      0.0, DT_SLASH:    -0.2, DT_BLUDGEON:   -0.2,
       DT_PIERCE:   -0.2, DT_SQUEEZE:  -0.2, DT_WHIP:       -0.2,
       DT_RIP:      -0.2,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_MSGIN, "trampelt bruellend herein");
  SetProp(P_MSGOUT, "trampelt bruellend");
  SetProp(P_MMSGIN, "bricht mit einem markerschuetternden Bruellen aus dem Boden hervor.");
  SetProp(P_MMSGOUT, "zerfaellt zu Asche");

  SetProp(P_DIE_MSG,  " zerplatzt bruellend in eine blutige und schlemigie Masse.\n");
  SetProp(P_NOCORPSE, 01);

  AddInfo(DEFAULT_INFO, " bruellt irre.\n");
  
  SetProp(P_SPELLRATE, 75);

  AddSpell(3, 400,
    Name(WER, 1)+" zerreisst dich mit seinen Klauen.\n",
    Name(WER, 1)+" zerreisst @WEN mit seinen Klauen.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 400,
    Name(WER, 1)+" zertrampelt dich mit seinen Hufen.\n",
    Name(WER, 1)+" zertrampelt @WEN mit seinen Hufen.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 500,
    Name(WER, 1)+" laesst seine Axt auf dich herabsausen.\n",
    Name(WER, 1)+" laesst seine Axt auf @WEN herabsausen.\n",
      DT_SLASH, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 400,
    Name(WER, 1)+" schleudert einen daemonischen Zauber nach dir.\n",
    Name(WER, 1)+" schleudert einen daemonischen Zauber auf @WEN.\n",
      DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 350, DS_DISARM,
    Name(WER,1) + " schmetert seine gekreuzten Klingen gegen deine Waffenhand.\n",
    Name(WER,1) + " schmettert seine gekreuzten Klingen gegen @WESSEN Waffenhand.\n" );

  AddDefaultSpell(2, 600, DS_MASS_DAMAGE,
    Name(WER,1) + " faehrt mit seinen Waffen wie eine Furie durch seine Gegnerhorden.\n",
    Name(WER,1) + " faehrt mit seinen Waffen wie eine Furie durch seine Gegnerhorden.\n", ({DT_SLASH}));

  AddSpell(2, 400,
    "Du stichst dich an " + Name(WESSEN, 1) + " stacheliger Ruestung.\n",
    "@WER sticht sich an " + Name(WESSEN,1) + " stacheliger Ruestung.\n", DT_PIERCE);

  AddDefaultSpell(2, 600, DS_REDUCE_AC,
    Name(WER,1) + " zertruemmert deine Ruestung mit einem gewaltigen Hieb!\n",
    Name(WER,1) + " zertruemmert @WESSEN Ruestung mit einem gewaltigen Hieb!\n" );

  AddDefaultSpell(2, 500, DS_REDUCE_WC,
      Name(WER,1) + " versucht deine Waffe zu zerschmettern\n",
      Name(WER,1) + " versucht @WESSEN Waffe zu zerschmettern!\n" );

  AddSpell(2, 800, 
    Name(WER, 1) + " zerstueckelt dich!\n",
    Name(WER, 1) + " zerstueckelt @WEN!\n",
    DT_SLASH, "life_debuff", ([SP_SHOW_DAMAGE: 1]));
  

  SUID;
  
}

public void life_debuff(object enemy) {
  object ob;
  ob = clone_object(OBJ "life_debuff");
  ob->move(enemy, M_NOCHECK);
  ob->startRemove();
  enemy->UpdateAttributes();
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
public varargs void die( int poisondeath ) {  
  object ob;

  write_file(LOG "npc.kills",
  dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
  " killt " + name(WEN, 1) + ".\n");

  if(!poisondeath)
    if(objectp(QueryProp(P_KILLER)) && interactive(QueryProp(P_KILLER)))
      if(objectp(ob=find_object(ITEMD)->GenerateUnique(ARMOUR "abaddon_panzer")))
	      ob->move(ME);

  ::die();
  return;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  if(nextRage < time()) {
    tell_room(ENV(TO), BS("Abaddon bruellt wahnsinnig auf und verfaellt in Rage!"));
    ModifySkillAttribute(TO, SA_SPEED, 200+random(100), 10+random(20));
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}
