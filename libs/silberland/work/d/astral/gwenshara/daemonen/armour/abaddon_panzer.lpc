inherit "/std/armour";

#include "../def.h"
#include <vt100.h>
#include <ansi.h>

private int timeOfCreation;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  if(file_name(previous_object())!="/p/daemon/itemd/itemd") {
    raise_error("Illegales Clonen des Uniques! ");
    destruct();
    return;
  }

  timeOfCreation = time();


  SetProp(P_SHORT, "Abaddons blutruenstiger Stachelpanzer");
  SetProp(P_LONG, 
    "Dieser Panzer besteht aus dichtem Kettengeflecht aus schwarzem Stahl. An jedem "
    "Kettenglied wurden scharfe Dornen angebracht, die zum groessten Teil schon mit "
    "feucht-klebrigem Blut bedeckt sind. Ein unheimliches, rotes Gluehen geht von "
    "dem Panzer aus. Er sieht irgendwie unheilig aus.");
  SetProp(P_NAME, "Abaddons Stachelpanzer");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId (({"panzer", "stachelpanzer", "\ndaemonen_panzer"}) );
  SetProp(P_INFO, BS(
      "Dies ist der Panzer von Abaddon, dem Heerfuehrer der jenseitigen Mordscharen und "
      "und Verschlinger der Wut. Wenn du ihn traegst werden seine unheiligen Kraefte auf "
      "dich uebergehen. Er kann nicht fuer immer in dieser Welt bestehen und wird sich "
      "irgendwann aufloesen!"));

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 38);
  SetProp(P_MATERIAL, ([MAT_STEEL: 75, MAT_MISC_UNHOLY: 20, MAT_BLOOD: 5]) );
  SetProp(P_WEIGHT, 15000);
  SetProp(P_VALUE, 6666);
  SetProp(P_MAGIC, 5);
  SetProp(P_QUALITY_DECAY, 1500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 8, T_HEAT_PROT: 8]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_UNHOLY: 2]) );
  SetProp(P_DEFEND_FUNC, TO);


  SUID;
}

public int DefendFunc (mixed dam_type, int spell, object enemy) {
  int bonus;
  object wer;

  bonus += call_other("/p/daemon/itemd/functions/defendfuncstacheln2", "DefendFunc", dam_type, spell, enemy);
  bonus += call_other("/p/daemon/itemd/functions/defendfuncheal", "DefendFunc", dam_type, spell, enemy);

  wer=PO->QueryProp(P_WORN);
  if(!random(10) && wer->QuerySkillAttribute(SA_SPEED)<=100) {
    tell_object(wer, BS("Unbaendiger Zorn packt dich! Blutruenstig stuerzt du dich in den Kampf!!"));
    tell_room(ENV(wer), BS(sprintf("%s wird von unbaendigem Zorn gepackt und stuerzt sich blutruenstig bruellend in den Kampf!!")));
    wer->ModifySkillAttribute(wer, SA_SPEED, 300, 10+random(10));
    wer->command_me("toete alle");
  }

  if(!random(20)) {
    tell_object(wer, BS("Die Stacheln von Abaddons Panzer bohren sich in dein Fleisch!"));
    wer->AddHp(-random(10));
  }

  return bonus + random(10);
}

string short() {
  string s;

  if(QueryProp(P_WORN)) 
    s=" (getragen)"; 
  else 
    s="";
  
  if((TP) && (TP->QueryProp(P_TTY)=="ansi"))
    return VT_RED+VT_TA_B+QueryProp(P_SHORT)+VT_NORMAL+s+".\n"; 
  else 
    if((TP) && (TP->QueryProp(P_TTY)=="vt100"))
      return VT_TA_B+QueryProp(P_SHORT)+VT_NORMAL+s+".\n";

  return QueryProp(P_SHORT)+s+".\n";
}

public void reset() {
  ::reset();
  if(!is_clone(TO)) return;

  if(time() - timeOfCreation >= 2419200) { // existiert max. 28 tage
    if(objectp(ENV(TO))) {
      tell_object(ENV(TO), BS("Abaddons Stachelpanzer zerfaellt zu Daemonenschleim..."));
    }
    remove();
  }
}