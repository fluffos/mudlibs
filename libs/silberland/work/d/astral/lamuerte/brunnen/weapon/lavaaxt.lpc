// Lavaaxt, Schaden abhaengig von Temperatur
// Feyaria@SilberLand

#include <properties.h>
#include <combat.h>

inherit "/std/weapon";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Die Lavaaxt");
  SetProp(P_LONG,
    "Die Klinge dieser sonderbaren Axt zischt mit hoellischer Inbrunst, so als "
    "bestuende sie aus reiner Lava. Und tatsaechlich ist sie extrem heiss. "
    "Sogar der bronzene Stiel ist in der Naehe der Klinge gluehend blau und "
    "so heiss das man ihn fast nicht angreifen kann.");
  SetProp(P_NAME, "Lavaaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "lavaaxt", "\nwell_equip"}) );  
  SetProp(P_INFO, 
    "Irgendjemand muss die elementare Macht des Feuers in die Form einer "
    "Axtklinge gezaubert haben, ansonsten gibt es keine Erklaerung fuer "
    "die Hitze, die diese Axt ausstrahlt.");
  AddDetail( ({"klinge", "lava"}),
    "Die Klinge besteht wirklich aus blubbernder Lava. Man kann schon fast von "
    "einer elementaren Manifestation sprechen.");

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 243);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_FIRE}) );
  SetProp(P_QUALITY_DECAY, 180);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 4);
  SetProp(P_VALUE, 4000);
  SetProp(P_WEIGHT, 3400);
  SetProp(P_SIZE, 170);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:42, A_STR:32]) );
  SetProp(P_MATERIAL, ([MAT_BRONCE:60, MAT_FIRE:40]) ); 
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );
  SetProp(P_HIT_FUNC, this_object());    
}

int HitFunc(object enemy)
{
  int t;
  t=environment(QueryProp(P_WIELDED))->QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE];
  if( t < 10 )
  {
    TakeFlaw();
    if( random(t+30)<25 && QueryProp(P_WC) > 35 )
    {
      tell_object(QueryProp(P_WIELDED), "Deine Lavaaxt kuehlt etwas ab.\n");
      Damage(1);
    }
    return -random(100);
  }
  if( t > 50 )
    t = 50;
  if( t > 25 )
  {
    if( 25+random(40)<t && !random(5))
    {
      write("Die Lavaaxt brodelt fuerchterlich.\n");
      Damage(-1);
      return -5*(t-30)+100+random(500);
    }
    return 5*(t-30)+random(100);
  }  
   return random(20);
}


