// Horgarspeer 
// Feyaria@SilberLand

#include <properties.h>
#include <combat.h>

inherit "/std/weapon";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Der Horgarknochenspeer");
  SetProp(P_LONG,
    "Ein Speer aus den extrem harten Knochen eines Horgars. Auf der Spitze "
    "befinden sich noch Reste des aetzenden und giftigen Blutes des Horgars.");
  SetProp(P_NAME, "Horgarknochenspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "knochenspeer", "horgarknochenspeer", "\nwell_equip"}) );  
  AddDetail( ({"knochen"}),
    "Die Knochen des Horgars sind so hart wie Metall.");
  AddDetail( ({"blut"}),
    "Auf der Spitze des Horgarknochenspeeres befindet sich noch Reste von "
    "Horgarblut. Ob es noch die gleiche aetzende und giftige Wirkung hat "
    "wie der Horgar selber?");  

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 225);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP, DT_ACID, DT_POISON}) );
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 3);
  SetProp(P_VALUE, 2500);
  SetProp(P_WEIGHT, 1700);
  SetProp(P_SIZE, 200);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:25, A_STR:15]) );
  SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_MISC_POISON:5, MAT_MISC_ACID:5]) ); 
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );
}

