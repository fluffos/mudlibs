inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Daemonenschwert");
  SetProp(P_LONG, 
   "Das ist das maechtige Schwert eines Schwertdaemons. "
   "Es ist viel zu gross, als das Du es verwenden koenntest.");
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 5100);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Daemonenschwert");
  AddId( ({"schwert", "daemonenschwert"}));
  SetProp(P_WC, 200);
  SetProp(P_SIZE, 300);
  SetProp(P_MAGIC, 3);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_MATERIAL, MAT_MISC_UNHOLY);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Daemon"})]) );
}


string short()
{
  if(environment() && environment()->id("schwertdaemon") )
    return "Ein Daemonenschwert (gezueckt).\n";
  return ::short();
}
  
