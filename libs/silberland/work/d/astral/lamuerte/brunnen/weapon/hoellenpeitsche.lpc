// Hoellenpeitsche
// Feyaria@SilberLand


#include <properties.h>
#include <combat.h>
#include <new_skills.h>

inherit "/std/weapon";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Eine Hoellenpeitsche");
  SetProp(P_LONG,
    "Die Hoellenpeitsche ist aus dem Schwanz einer Hoellenkreatur gefertigt. "
    "Sie koennte von einem Hoellenhund oder einer Hoellenkatze stammen, so "
    "genau kann man das jetzt nicht mehr unterscheiden. Die Peitsche ist von "
    "daemonischen Flammen umgeben. Wenn Du damit kaempfen willst, verbrennst "
    "Du Dir sicher Deine Haende.");
  SetProp(P_NAME, "Hoellenpeitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "hoellenpeitsche", "\nwell_equip"}) );  

  SetProp(P_WEAPON_TYPE, WT_WHIP);
  SetProp(P_WC, 185);
  SetProp(P_WC_FIX, 35);
  SetProp(P_DAM_TYPE, ({DT_WHIP, DT_RIP, DT_UNHOLY, DT_FIRE}) );
  SetProp(P_QUALITY_DECAY, 140);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MAGIC, 3);
  SetProp(P_VALUE, 1100);
  SetProp(P_WEIGHT, 400);
  SetProp(P_SIZE, 300);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:25, SR_GOOD:-300]) );
  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:30, MAT_FIRE:20, MAT_BONE:50]) ); 
  SetProp(P_HIT_FUNC, this_object() );
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );
}

int HitFunc(object enemey)
{
  object wer;
  if( !wer=QueryProp(P_WIELDED) ) return 0;  
  if( wer->QueryProp(P_ALIGN)>0 || !random(100) ) 
  {
    tell_object(wer, "Die Hoellenpeitsche wird Dir zu heiss und Du "
        "laesst sie fallen.\n");
    wer->AddHp(-10-random(20));
    return DoUnwield(), -300;
  }
  wer->AddHp(-1); 
  return random(100);
}

