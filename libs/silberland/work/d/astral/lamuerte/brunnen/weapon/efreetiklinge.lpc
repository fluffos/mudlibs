// Efreetiklinge
// Feyaria@SilberLand

#include "../def.h"

inherit "/std/weapon";

int sultan = 0;
int nr = -1;
void check_hitfunc();

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  if (nr == -1)
    nr = random(7);
  switch (nr)
  {
    case 0..1:
      SetProp(P_SHORT, "Eine unglaublich scharfe Efreetiklinge");
      SetProp(P_NAME_ADJ, "unglaublich scharf" );
      AddAdjective (({"unglaublich", "unglaubliche", "scharf", "scharfe"}) );
      SetProp(P_WC, 155);
      SetProp(P_WC_FIX, 100);
      break;
    case 2..3:
      SetProp(P_SHORT, "Eine geflammte Efreetiklinge");
      SetProp(P_NAME_ADJ, "geflammt" );
      AddAdjective (({"geflammt", "geflammte"}) );
      SetProp(P_WC, 175);
      SetProp(P_WC_FIX, 80);
      break;
    case 4..5:
      SetProp(P_SHORT, "Eine toedliche Efreetiklinge");
      SetProp(P_NAME_ADJ, "toedlich" );
      AddAdjective (({"toedlich", "toedliche"}) );
      SetProp(P_WC, 195);
      SetProp(P_WC_FIX, 60);
      break;
    case 6:
      SetProp(P_SHORT, "Eine vernichtende Efreetiklinge");
      SetProp(P_NAME_ADJ, "vernichtend" );
      AddAdjective (({"vernichtend", "vernichtende"}) );
      SetProp(P_WC, 200);
      SetProp(P_WC_FIX, 70);
      break;
  }
  SetProp(P_LONG,
    "Die Efreetiklinge ist eine schwertaehnliche Waffe mit einer langen, "
    "leicht gebogenen Klinge, die aus Dir gaenzlich unbekannten Metallen "
    "geschmiedet ist. Der Griff ist von wabernden Flammen umgeben, sodass "
    "es sicher eine grosse Ueberwindung ist, diese Waffe zu zuecken.");
  SetProp(P_NAME, "Efreetiklinge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"klinge", "efreetiklinge", "\nwell_equip"}) );
  SetProp(P_INFO,
      "Die Efreetiklinge ist in der Lage, Elementarwesen zu vernichten.");

  AddDetail( ({"klinge"}),
    "Die Klinge ist ca 1 Meter lang, sehr schmal und leicht gebogen.");
  AddDetail( ({"metall", "metalle"}),
    "Das Metall der Klinge ist sehr hart und perfekt geschmiedet.");
  AddDetail( ({"griff", "flamme", "flammen"}),
    "Der Griff der Efreetiklinge ist von wabernden Flammen umgeben. "
    "Mit viel Ueberwindung kann man sie zuecken, aber dabei verbrennt "
    "man sich sicher die Finger.");

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_EXPLOSION}) );
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MAGIC, 5);
  SetProp(P_VALUE, 3500);
  SetProp(P_WEIGHT, 1600);
  SetProp(P_SIZE, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:45, A_STR:20]) );
  SetProp(P_MATERIAL, ([MAT_TUNGSTEN:15, MAT_IRIDIUM:75, MAT_FIRE:10]) ); 
  SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(4), P_SP:3+random(4)]) );
  
  SetProp(P_WIELD_FUNC, this_object() );
  check_hitfunc();

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void check_hitfunc()
{
  if (!objectp(QueryProp(P_HIT_FUNC)))
  {
    call_other("/p/daemon/itemd/functions/hitfuncelemental" + (sultan ? "2" : "1"), "???");
    SetProp(P_HIT_FUNC, 
        find_object("/p/daemon/itemd/functions/hitfuncelemental" + (sultan ? "2" : "1")));
  }
}

int WieldFunc(object waffe, int silent)
{
  if(!silent)
    write("Die Flammen der Efreetiklinge verbrennen Deine Hand.\n");
  this_player()->AddHp(-random(3) );
  return 1;
}

void reset()
{
  if( !is_clone(this_object()) ) return;
  ::reset();
  check_hitfunc();
}

void set_sultan()
{
  if (member(ALLOWED_UIDS, getuid(previous_object())) == -1)
    return;
  sultan = 1;
  SetProp(P_SHORT, QueryProp(P_SHORT) + " des Sultans");
  SetProp(P_NAME, QueryProp(P_NAME) + " des Sultans");
  SetProp(P_QUALITY_DECAY, 550);
  SetProp(P_M_HEALTH_MOD, ([P_HP:9+random(4), P_SP:9+random(4)]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:5, P_SP:5]) );
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:65, A_STR:25]) );
  SetProp(P_HIT_FUNC, 0);
  SetProp(P_MAGIC, 10);
  SetProp(P_WC, QueryProp(P_WC) + 20);
  SetProp("waffenbalsam", 10);
  check_hitfunc();
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, pointerp(data[0]) ? data[0] : ({2222,1}) );
  SetProp(P_NODROP, 1);
  if (data[1])
    set_sultan();
  nr = data[2];
}

mixed _query_autoloadobj()
{ 
  return ({QueryProp(P_ITEMD_TMPMAGIC), sultan, nr});
}

