// Eisdolch 
// Feyaria@SilberLand

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

inherit "/std/weapon";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Eisfroschdorn");
  SetProp(P_LONG,
    "Das ist der Dorn eines Eisfrosches. Er besteht gaenzlich aus "
    "daemonischem Eis und laesst sich als Dolch verwenden, falls man "
    "gewissenlos genug ist, eine daemonische Waffe zu verwenden.");
  SetProp(P_NAME, "Eisfroschdorn");
  SetProp(P_GENDER, MALE);
  AddId( ({"dorn", "eisfroschdorn", "\nwell_equip"}) );  
  AddDetail( ({"eis"}),
    "Dieses Eis ist sicher daemonischer Natur, denn es schmilzt nicht.");

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 125);
  SetProp(P_WC_FIX, 60);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_BLUDGEON, DT_UNHOLY, DT_COLD}) );
  SetProp(P_QUALITY_DECAY, 210);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MAGIC, 3);
  SetProp(P_VALUE, 1500);
  SetProp(P_WEIGHT, 700);
  SetProp(P_SIZE, 30);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:20, SR_GOOD:-300]) );
  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:30, MAT_ICE:70]) ); 
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );
}

