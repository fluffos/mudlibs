// Eisaxt, Schaden abhaengig von Temperatur
// Feyaria@SilberLand

#include <properties.h>
#include <combat.h>

inherit "/std/weapon";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Die Eisaxt");
  SetProp(P_LONG,
    "Die Klinge dieser sonderbaren Axt glitzert blaeulich-weiss, so als "
    "bestuende sie aus reinem Eis. Und tatsaechlich ist sie extrem kalt. "
    "Sogar der bronzene Stiel ist in der Naehe der Klinge von einer duennen "
    "Eisschicht umgeben.");
  SetProp(P_NAME, "Eisaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "eisaxt", "\nwell_equip"}) );  
  SetProp(P_INFO, 
    "Irgendjemand muss die elementare Macht des Eises in die Form einer "
    "Axtklinge gezaubert haben, ansonsten gibt es keine Erklaerung fuer "
    "die Kaelte, die diese Axt ausstrahlt.");
  AddDetail( ({"klinge", "eis"}),
    "Die Klinge besteht wirklich aus reinstem Eis. Man kann schon fast von "
    "einer elementaren Manifestation sprechen.");

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 245);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_COLD}) );
  SetProp(P_QUALITY_DECAY, 180);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 4);
  SetProp(P_VALUE, 4500);
  SetProp(P_WEIGHT, 3300);
  SetProp(P_SIZE, 160);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:42, A_STR:32]) );
  SetProp(P_MATERIAL, ([MAT_BRONCE:60, MAT_ICE:40]) ); 
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );
  SetProp(P_HIT_FUNC, this_object());    
}

int HitFunc(object enemy)
{
  int t;
  t=environment(QueryProp(P_WIELDED))->QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE];
  if( t > 25 )
  {
    TakeFlaw();
    if( random(t)>25 && QueryProp(P_WC) > 30 )
    {
      tell_object(QueryProp(P_WIELDED), "Deine Eisaxt schmilzt etwas.\n");
      Damage(1);
    }
    return -t-random(t);
  }
  if( t < -25 )
    t = -25;
  if( t < 0 )
  {
    if( random(40)<-t && !random(5))
    {
      write("Die Eisaxt leuchtet in eisigem Licht auf.\n");
      Damage(-1);
      return -5*t+100+random(500);
    }
    return -5*t+random(100);
  }  
    return random(20);
}


