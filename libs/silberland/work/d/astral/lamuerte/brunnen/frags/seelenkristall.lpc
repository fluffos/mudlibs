inherit "std/thing";


#define MAX_WASSER 300000
#define MAX_LUFT 100000
#define MAX_EIS 50000
#define MAX_FEUER 15000

#include <properties.h>
#include <language.h>
#include <ansi.h>
#include "../def.h"
#include "../well_level.h"

#ifndef P_X_MAX_HEALTH_MOD
#define P_X_MAX_HEALTH_MOD "x_max_health_mod"
#endif

int f,w,e,l;
int nr = 1;
string *fragtypes=({"feuerfragment","wasserfragment","luftfragment","eisfragment",
                    "feuerfragmente","wasserfragmente","luftfragmente","eisfragmente"});
mapping races = ([
    "Zwerg" : ""; "Zwergenheld"; "Zwergenheldin",
    "Elf" : ""; "Elfenheld"; "Elfenheldin",
    "Mensch" : ""; "Menschenheld"; "Menschenheldin",
    "Hobbit" : ""; "Hobbitheld"; "Hobbitheldin",
    "Fee" : ""; "Feenheldin"; "Feenheldin",
    "Oger" : ""; "Ogerheld"; "Ogerheldin",
    "Troll" : ""; "Trollheld"; "Trollheldin",
    "Dunkelelf" : ""; "Dunkelelfenheld"; "Dunkelelfenheldin",
    "Untoter" : ""; "Lich"; "Lich",
    "Gaffo": ""; "Gaffoheld";"Gaffoheldin",
    ]);
mapping races2 = ([
    "Zwerg" : ""; "Zwergenkoenig"; "Zwergenkoenigin",
    "Elf" : ""; "Elfenkoenig"; "Elfenkoenigin",
    "Mensch" : ""; "Menschenkoenig"; "Menschenkoenigin",
    "Hobbit" : ""; "Hobbitkoenig"; "Hobbitkoenigin",
    "Fee" : ""; "Feenkoenigin"; "Feenkoenigin",
    "Oger" : ""; "Ogerkoenig"; "Ogerkoenigin",
    "Troll" : ""; "Trollkoenig"; "Trollkoenigin",
    "Dunkelelf" : ""; "Dunkelelfenkoenig"; "Dunkelelfenkoenigin",
    "Untoter" : ""; "Lichkoenig"; "Lichkoenigin",
    "Gaffo": ""; "Obergaffo"; "Obergaffo",
    ]);
string old_race = "";
string hero_race = "";

int set_modifiers();

void _set_autoloadobj( mixed args )
{
  f = args[0];
  w = args[1];
  e = args[2];
  l = args[3];
  if (sizeof(args) >= 5)
    nr = args[4];
}

_query_autoloadobj()
{
  return ({f,w,e,l,nr});
}

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  e=f=w=l=0;
  SetProp(P_NAME,"Seelenkristall");
  SetProp(P_SHORT,"Seelenkristall");
  SetProp(P_LONG,
      "Ein Seelenkristall. Mit 'fusioniere' kannst Du elementare Fragmente mit "
      "ihm verbinden. Mit 'fragreport' kannst Du allen im Raum stehenden "
      "Spielern zeigen wieviel Energie Dein Kristall hat. Mit 'fragliste' "
      "kannst Du Dir anzeigen lassen wieviel Energie Dein Kristall hat. "
      "Mit brufe und bemote kannst Du mit den anderen Anwesenden im Brunnen "
      "kommunizieren und mit brhist die Meldungen nochmal anschauen.");
  AddId( ({"\nfragkristall","kristall","seelenkristall", "NODESTRUCT"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_MAGIC, 10);
  SetProp(P_VALUE, 0);
  
  AddCmd(({"fusioniere","fusion"}), "fusefunc");
  AddCmd(({"fragreport"}), "frepfunc");
  AddCmd(({"fraglist","fragliste"}), "writerep");

  AddCmd(({"bruf", "brufe","bemote"}),"brunnen_shout");
  AddCmd(({"brhist", "brhistory"}),"brunnen_history");
  seteuid(getuid(this_object()));
}

string rep(int pers)
{
  return sprintf(
      nr > 3 ?
      "---------------------------------------------\n"
      "| Wasserelementarenergie: (%7d/%7d) |\n"
      "| Luftelementarenergie:   (%7d/%7d) |\n"
      "| Eiselementarenergie:    (%7d/%7d) |\n"
      "| Feuerelementarenergie:  (%7d/%7d) |\n"
      "---------------------------------------------\n"
      :
      "-------------------------------------------\n"
      "| Wasserelementarenergie: (%6d/%6d) |\n"
      "| Luftelementarenergie:   (%6d/%6d) |\n"
      "| Eiselementarenergie:    (%6d/%6d) |\n"
      "| Feuerelementarenergie:  (%6d/%6d) |\n"
      "-------------------------------------------\n",
      w,MAX_WASSER*nr,l,MAX_LUFT*nr,e,MAX_EIS*nr,f,MAX_FEUER*nr)
      +
      (nr > 1 ?
        sprintf(
        "\n"+
        (pers ? "Du hast Deinen" : 
         this_player()->Name(WER,1)+" hat "+this_player()->QueryPossPronoun(MALE,WEN))+
        " Seelenkristall bereits %d Mal vollstaendig angefuellt und "+
        (pers ? "bist " : "ist ") +
        (this_player()->QueryProp(P_GENDER) == FEMALE ? "eine echte Heldin.\n" : 
        "ein echter Held.\n"), nr-1)
      :
      "");
}

int frepfunc(string str)
{
  if (this_player() != environment())
    return 0;
  write("Du zeigst allen den Fuellstand Deines Seelenkristalls.\n");
  say(this_player()->Name(WER,1)+" zeigt Dir "+
      this_player()->QueryPossPronoun(MALE,WER,SINGULAR)+
      " Seelenkristall.\n");
  say(rep(0));
  write(rep(1));
  return 1;
}

int writerep(string str)
{
  if (this_player() != environment())
    return 0;
  write(rep(1));
  return 1;
}

nosave void full_kristall()
{
  int i;
  write(break_string("Dein Seelenkristall leutet ganz hell auf und ein "
        "Gefuehl von unbegrenzter Macht ueberflutet Dich. Du fuehlst Dich "
        "ploetzlich wie einer der grossen Helden aus alten Zeiten."));
  this_player()->heal_self(500);
  if (!IS_LEARNER(this_player()))
    call_other(FRAGS "kristallmaster", "Channel", 
        capitalize(getuid(this_player())) + " hat soeben "+
        this_player()->QueryPossPronoun(MALE, WEN) +" Seelenkristall "+
        (nr > 1 ? "zum " + nr + ". Mal " : "")+ "vollstaendig angefuellt und ist nun " +
        (this_player()->QueryProp(P_GENDER) == FEMALE ? "eine echte Heldin." : 
         "ein echter Held."));
  for (i = 1; i <= 78; i++)
    call_other(POTIONS "ampullenmaster", "player_rezept", i);
  w=l=e=f=0;
  nr++;
}

int fragcheck(object fragment, int fragamount)
{
  if(fragamount>fragment->QueryProp(P_AMOUNT) || fragamount<1){
    write("So viele Fragmente dieser Art hast Du nicht.\n");
    return 0;
  }
  return 1;
}

int fusefunc(string arg)
{
  string fragtype;
  int fragamount;
  object fragment;

  fragamount=0; 

  if (this_player() != environment())
    return 0;
  notify_fail("Nein, so nicht.\n");
  if(!arg) return 0;

  if (sscanf(arg,
        "%d %s", fragamount, fragtype) != 2 && member(fragtypes,arg)==-1 ){
    write("Es muss z.B. fusioniere 10 feuerfragmente heissen.\n");
    return 1;
  }
  else
  {
    if (member(fragtypes,arg)!=-1){
      fragamount=1;
      fragtype=arg;
    }
    if (member(fragtypes,fragtype)==-1) {
      write("Es koennen nur Feuer, Wasser, Eis und Luftfragmente fusioniert werden.\n");
      return 1;
    }
    if (fragtype[0..8]=="feuerfrag") {
      if (!fragment=deep_present("\nfeuerfrag",this_player())){
        write("Du hast ja gar keine echten Feuerfragmente bei Dir!\n");
        return 1;
      }
      if (!fragcheck(fragment, fragamount)) return 1;
      if (f + fragamount > MAX_FEUER * nr) {
        write("So viele Fragmente passen in diesen Kristall nicht hinein.\n");
        return 1;
      }
      f=f+fragamount;
    }
    if (fragtype[0..8]=="eisfragme") {
      if (!fragment=deep_present("\neisfrag",this_player())){
        write("Du hast ja gar keine echten Eisfragmente bei Dir!\n");
        return 1;
      }
      if (!fragcheck(fragment, fragamount)) return 1;
      if (e + fragamount > MAX_EIS * nr) {
        write("So viele Fragmente passen in diesen Kristall nicht hinein.\n");
        return 1;
      }
      e=e+fragamount;
    }
    if (fragtype[0..8]=="wasserfra") {
      if (!fragment=deep_present("\nwasserfrag",this_player())){
        write("Du hast ja gar keine echten Wasserfragmente bei Dir!\n");
        return 1;
      }
      if (!fragcheck(fragment, fragamount)) return 1;
      if (w + fragamount > MAX_WASSER * nr) {
        write("So viele Fragmente passen in diesen Kristall nicht hinein.\n");
        return 1;
      }
      w=w+fragamount;
    }
    if (fragtype[0..8]=="luftfragm") {
      if (!fragment=deep_present("\nluftfrag",this_player())){
        write("Du hast ja gar keine echten Luftfragmente bei Dir!\n");
        return 1;
      }
      if (!fragcheck(fragment, fragamount)) return 1;
      if (l + fragamount > MAX_LUFT * nr) {
        write("So viele Fragmente passen in diesen Kristall nicht hinein.\n");
        return 1;
      }
      l=l+fragamount;
    }
  } 
  write_file(LOGS "frags/"+getuid(this_player())+".log", 
      sprintf("%s: %6d Wasser, %6d Luft, %6d Eis, %6d Feuer\n",
        dtime(time()), w, l, e, f));
  fragment->AddAmount(-fragamount);
  if (fragamount==1)
  {
    write("Du fusionierst das Fragment mit dem Seelenkristall.\n"
        "Der Seelenkristall flackert ein wenig auf.\n");
    say(break_string(this_player()->Name(WESSEN)+" Seelenkristall flackert ein "
          "wenig auf, als ein Fragment mit "+this_player()->QueryPronoun(WEM)+
          " fusioniert.",78));
  }
  else
  {
    write("Du fusionierst die Fragmente mit dem Seelenkristall.\n"
        "Der Seelenkristall blitzt kurz auf.\n");
    say(break_string(this_player()->Name(WESSEN)+" Seelenkristall blitzt kurz "
          "auf, als Fragmente mit "+this_player()->QueryPronoun(WEM)+
          " fusionieren.",78));
  }
  if (w == MAX_WASSER * nr && l == MAX_LUFT * nr && 
      e == MAX_EIS * nr && f == MAX_FEUER * nr)
    full_kristall();
  call_other(FRAGS "kristallmaster", "fragused", fragtype[0..8], fragamount);
  call_other(FRAGS "kristallmaster", "set_frags", getuid(this_player()),
      w, l, e, f, nr);
  set_modifiers();
  return 1;          
}

mixed _query_noget()
{
  if(present("\nfragkristall", this_player()))
    return write("Du hast doch schon einen Seelenkristall!!\n"),1;
  return 0;
}

int inside_well()
{
  return strstr(file_name(environment(environment())), ROOMS) != -1;
}

int set_modifiers()
{
  int faktor;
  float res;
  int i;
  object pl;

  if( !objectp(pl = environment()) || !environment(pl) ) 
    return 0;
  if(inside_well())
  {
    faktor = 5;
    res = 0.0;
    for (i = 1; i < nr; i++)
      res += -0.15 / i;
    pl->AddResistanceModifier( ([
          DT_WATER: res - 0.15 /nr * (1.0 * w / (MAX_WASSER * nr)),
          DT_AIR: res - 0.15 /nr * (1.0 * l / (MAX_LUFT * nr)),
          DT_COLD: res - 0.15 /nr * (1.0 * e / (MAX_EIS * nr)),
          DT_FIRE: res - 0.15 /nr * (1.0 * f / (MAX_FEUER * nr)),
          ]), "seelenkristall");
  }
  else
  {
    pl->RemoveResistanceModifier("seelenkristall");
    faktor = 1;
  }

  SetProp(P_X_ATTR_MOD, ([
        A_DEX: to_int(faktor * (nr - 1 + 1.0 * w / (MAX_WASSER * nr))),
        A_INT: to_int(faktor * (nr - 1 + 1.0 * l / (MAX_LUFT * nr))),
        A_CON: to_int(faktor * (nr - 1 + 1.0 * e / (MAX_EIS * nr))),
        A_STR: to_int(faktor * (nr - 1 + 1.0 * f / (MAX_FEUER * nr))),
        ]) );
  SetProp(P_X_HEALTH_MOD, ([
        P_SP: to_int(5 * faktor * (nr - 1 + 1.0 * w / (MAX_WASSER * nr))) +
              to_int(5 * faktor * (nr - 1 + 1.0 * l / (MAX_LUFT * nr))),
        P_HP: to_int(5 * faktor * (nr - 1 + 1.0 * e / (MAX_EIS * nr))) +
              to_int(5 * faktor * (nr - 1 + 1.0 * f / (MAX_FEUER * nr))),
        ]) );
  RemoveId("\nseelenkristall_held");
  if (nr > 1)
  {
    SetProp(P_X_MAX_HEALTH_MOD, ([ P_HP: (nr - 1) * 10, P_SP: (nr - 1) * 10]) );
    AddId("\nseelenkristall_held");
    old_race = pl->QueryProp(P_RACE);
    if (nr > 2)
      hero_race = races2[old_race, pl->QueryProp(P_GENDER)];
    else
      hero_race = races[old_race, pl->QueryProp(P_GENDER)];
    pl->Set(P_RACE,  symbol_function("race", this_object()), F_QUERY_METHOD);
    if(!inside_well())
      pl->AddResistanceModifier( ([
          DT_WATER: -0.05 * (nr - 1), 
          DT_AIR: -0.05 * (nr - 1),
          DT_COLD: -0.05 * (nr - 1),
          DT_FIRE: -0.05 * (nr - 1),
          ]), "seelenkristall");
  }
  pl->UpdateAttributes();
  return 1;
}

string race()
{ 
  if (previous_object(1) && (file_name(previous_object(1)) == "/obj/werliste" ||
        file_name(previous_object(1)) == "/p/daemon/fingerd"))
    return hero_race;
  else
    return old_race;
}

void reset()
{
  if(!is_clone(this_object())) 
    return;
  ::reset();
  call_out("my_reset", 2 + random(30));
}

void my_reset()
{
  if(set_modifiers())
  {
    if (inside_well())  // Im Brunnen immer Heilung
    {
      if (environment()->QueryProp(P_HP) < environment()->QueryProp(P_MAX_HP) ||
          environment()->QueryProp(P_SP) < environment()->QueryProp(P_MAX_SP))
      {
        tell_object(environment(), "Dein Seelenkristall leuchtet hell auf.\n");
        environment()->heal_self( (nr - 1) * 400 + 100 * w / MAX_WASSER + 
            100 * l / MAX_LUFT + 100 * e / MAX_EIS + 100 * f / MAX_FEUER);
      }
      set_next_reset(15 * 60);
    }
    else if (nr > 1) // Ausserhalb nur bei vollen Kristall
    {
      if (environment()->QueryProp(P_HP) < environment()->QueryProp(P_MAX_HP) ||
          environment()->QueryProp(P_SP) < environment()->QueryProp(P_MAX_SP))
      {
        tell_object(environment(), "Dein Seelenkristall leuchtet auf.\n");
        environment()->heal_self((nr - 1) * (50+random(150)));
      }
      set_next_reset(90 / nr * 60);
    }
  }
}

void init()
{
  int *frags;

  ::init();
  if( query_once_interactive(environment()) )
  {
    frags = call_other(FRAGS "kristallmaster", "query_frags", getuid(environment()));
    if( e * l * w * f == 0 && pointerp(frags))
    { 
      w = frags[0];
      l = frags[1];
      e = frags[2];
      f = frags[3];
      nr = frags[4];
    }
    else if( !pointerp(frags))
      call_other(FRAGS "kristallmaster", "set_frags", getuid(this_player()), 
          w, l, e, f, nr);
  }
  set_modifiers();
}

void BecomesNetAlive(object spieler)
{
  set_modifiers();
}

int IsInWell(object pl)
{
  if (member(INFORM_WIZ, getuid(pl)) != -1 || well_level(pl)) 
    return 1;
  return 0;
}

nosave int brunnen_shout(string str) {
  int i, no_msg, invis,lvl, emote;
  object *members;
  string *presay, *ignores, pre, msg, newmsg, addon, std_pre;
  no_msg=0;
  
  notify_fail("Das geht nur im Brunnen!\n");
  if (!IsInWell(TP))
    return 0;
  if(query_verb() == "bemote")
    emote=1;
  notify_fail("Was moechtest Du im Brunnen rufen?\n");
  if (!stringp(str)) 
    return 0;
  msg=TP->_unparsed_args();
  if(objectp(TP->QueryProp(P_PERM_STRING)))
     msg=call_other(TP->QueryProp(P_PERM_STRING),"permutate_string",msg)||"";
  members=filter_array(users(), "IsInWell");
  std_pre="<Brunnen:"+TP->name(WER);
  if(emote) addon="";
  else addon=">";
  std_pre+=addon+" ";
  for(i=sizeof(members)-1;i>=0; i--) {
    if(TP->QueryProp(P_INVIS) && !IS_WIZARD(members[i]))
      pre="<Brunnen:Jemand"+addon+" ";
    else if(TP->QueryProp(P_INVIS) && IS_WIZARD(members[i]))
      pre="<Brunnen:("+CAP(getuid(TP))+")"+addon+" ";  
    else     
      pre="<Brunnen:"+TP->Name(WER)+
        addon+" ";
    if(emote) 
    {
      newmsg=pre+msg+">";
      pre="";
    }
    else
      newmsg=msg;
    members[i]->Message(
          (members[i]->QueryProp(P_TTY) == "ansi" ?  ANSI_BOLD + ANSI_PURPLE : "") +
          break_string(newmsg +
          (members[i]->QueryProp(P_TTY) == "ansi" ?  ANSI_NORMAL : ""), 
          members[i]->QueryProp(P_SCREENWIDTH), pre),
        MSGFLAG_CHANNEL);
  }
  if(emote) 
  {
    newmsg=std_pre+"%s"+">";
    std_pre=" ";
  }
  call_other(FRAGS "kristallmaster", "AddHistory", std_pre, msg, invis, emote, newmsg);
  return 1;
}



nosave varargs int brunnen_history(mixed number) 
{
  int i;
  string *msgs;
  mixed *history;
  mixed *hist_time;
 
  notify_fail("Das geht nur im Brunnen!\n");
  if (!IsInWell(TP))
    return 0;
  if(!number) number=10;
  number=to_int(number);
  history=call_other(FRAGS "kristallmaster", "QueryHistory", number);
  hist_time=history[0];
  history=history[1];
  if (sizeof(history)==0)
  {
    write("Nichts ist im Brunnen passiert.\n");
    return 1;
  }
  if (TP->QueryProp(P_TTY) == "ansi")
    write(ANSI_BOLD+ANSI_PURPLE);
  write("Das haben die Brunnenmetzler gerufen:\n");
  write("-----------------------------------------------"
       "-------------------------------\n");
  for(i=0;i<=sizeof(history)-1;i++) {
    msgs=explode(history[i],"&&*%%");
    if( msgs[0][0..0] == " ")
      msgs[0]=msgs[0][1..];
    if (((time()+7200)/86400)>((hist_time[i]+7200)/86400)) {
      write(BS(dtime(hist_time[i])));
    }
    else {
      write(BS(dtime(hist_time[i])[19..26]));
    }
    // Wenn ein Spieler nhist macht bei jemand der invis nkreischt ...
    if(msgs[2]=="1" && !IS_WIZARD(TP)) {
      if(msgs[3] == "1") { // == emote 
        write(break_string(sprintf("<Brunnen:Jemand %s>",msgs[1]), TP->QueryProp(P_SCREENWIDTH)));
      }
      else {
        write(break_string(msgs[1], TP->QueryProp(P_SCREENWIDTH), "<Brunnen:Jemand> "));
      }
    }
    else { // ... und hier der Magier 
      if(msgs[3] == "1") { //emote
        write(break_string(sprintf(msgs[4], msgs[1]), TP->QueryProp(P_SCREENWIDTH)));
      }
      else {
        write(break_string(msgs[1], TP->QueryProp(P_SCREENWIDTH), msgs[0]));
      }
    }
  }
  write("-----------------------------------------------"
        "-------------------------------");
  if (TP->QueryProp(P_TTY) == "ansi")
    write(ANSI_NORMAL);
  write("\n");
  return 1;  
}

