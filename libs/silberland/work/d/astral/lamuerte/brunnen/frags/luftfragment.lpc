inherit "std/unit";

#pragma strong_types

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Fragmentes!");
    destruct();
    return;
  }
  SetProp(P_NAME,({"Luftfragment","Luftfragmente"}));
  SetProp(P_SHORT,"Luftfragment");
  AddSingularId("fragment");
  AddPluralId("fragmente");
  AddSingularId("luftfragment");
  AddPluralId("luftfragmente");
  AddId(({"\nfrag","\nluftfrag"}));
  SetProp(P_GENDER,NEUTER);
  SetCoinsPerUnits(0,0);
  SetGramsPerUnits(1,1);
}
