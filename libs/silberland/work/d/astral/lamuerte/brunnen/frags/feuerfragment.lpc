inherit "std/unit";

#pragma strong_types

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Fragmentes!");
    destruct();
    return;
  }
  SetProp(P_NAME,({"Feuerfragment","Feuerfragmente"}));
  SetProp(P_SHORT,"Feuerfragment");
  AddSingularId("fragment");
  AddPluralId("fragmente");
  AddSingularId("feuerfragment");
  AddPluralId("feuerfragmente");
  AddId(({ "\nfrag","\nfeuerfrag" }));
  SetProp(P_GENDER,NEUTER);
  SetCoinsPerUnits(0,0);
  SetGramsPerUnits(1,1);
}
