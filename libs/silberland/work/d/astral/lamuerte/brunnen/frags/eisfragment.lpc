inherit "std/unit";

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Fragmentes!");
    destruct();
    return;
  }
  SetProp(P_NAME,({"Eisfragment","Eisfragmente"}));
  SetProp(P_SHORT,"Eisfragment");
  AddSingularId("fragment");
  AddPluralId("fragmente");
  AddSingularId("eisfragment");
  AddPluralId("eisfragmente");
  AddId(({"\nfrag","\neisfrag"}));
  SetProp(P_GENDER,NEUTER);
  SetCoinsPerUnits(0,0);
  SetGramsPerUnits(1,1);
}
