#define ROOMS "/d/ebene/lamuerte/brunnen/rooms/"

#include <properties.h>
#include <moving.h>
#include <exploration.h>
#include <combat.h>


mapping tracking;

void create()
{
 if(is_clone(this_object())) destruct(this_object());
 tracking=([]);

 return; 
} 


void track(string npc)
{
 string *FILENAMES;
 string *EXITNAMES;
 int MAPSIZE;
 int x,z,y;

 MAPSIZE=0;
 
 FILENAMES=m_values(environment(this_player())->QueryProp(P_EXITS));
 EXITNAMES=m_indices(environment(this_player())->QueryProp(P_EXITS));
 MAPSIZE=sizeof(m_indices(tracking));
 
 
 if (sizeof(EXITNAMES)>0)
 { 
   for (x=0;x<sizeof(EXITNAMES);x++)
   {
    //map += ([ key: value0; ...; valuen ]);
    //write(EXITNAMES[x]+" "+FILENAMES[x]+"\n"); 
    tracking += ([ MAPSIZE+x: EXITNAMES[x]; FILENAMES[x]; EXITNAMES[x][0..0] ]);
    //write(tracking[x,2]+"\n"); 
   // call_other(FILENAMES[x,1],"???"); 
   }
   y=sizeof(m_indices(tracking));
   for (x=0;x<y;x++)
   {
    FILENAMES=m_values(find_object(tracking[x,1])->QueryProp(P_EXITS));
    EXITNAMES=m_indices(find_object(tracking[x,1])->QueryProp(P_EXITS));

    if(present(npc,find_object(tracking[x,1])))
    {
     write(npc+" steht im "+tracking[x,0]);
     return; 
    }
    
    if (sizeof(EXITNAMES)<2)
    {
      write("Deleting: "+tracking[x,1]);
      tracking -= ([ x ]); 
    }
    else
    {
    for (z=0;z<sizeof(EXITNAMES);z++) 
      {
        write(EXITNAMES[z]+ " - " +tracking[x,0]+"\n");
        MAPSIZE=sizeof(m_indices(tracking));
        tracking += ([ MAPSIZE+1: EXITNAMES[z]; FILENAMES[z]; EXITNAMES[z][0..0] ]);
       write(MAPSIZE+"\n");
      }
    }
   }
 }
 return;
}

void show_map()
{int x;
  for (x=0;x<sizeof(m_indices(tracking));x++){
    write(tracking[x,0]+" "+tracking[x,1]+" "+tracking[x,2]+"\n");
  }
  return;
}


void show_path(int i)
{
  string out;

  write(tracking[i,1]+" "+tracking[i,2]+"\n");
  return;
}

