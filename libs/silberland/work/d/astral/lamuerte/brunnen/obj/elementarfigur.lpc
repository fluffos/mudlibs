inherit "/std/thing";

#include "../def.h"
#include "../well_level.h"

string element;

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Figur");
  SetProp(P_LONG, 
   "Eine Figur.");
  SetProp(P_NAME,"Figur");
  AddId( ({"figur", "\nbrunnenfigur", "elementarfigur"}));

  SetProp(P_INFO, 
      "Vielleicht kann man diese Figur reiben?\n");
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 20);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);

  AddCmd( ({"reibe", "reib"}), "reiben" );
}

int set_element(string str)
{
  if (member(ALLOWED_UIDS, getuid(previous_object())) == -1 && 
     !IS_ARCH(this_player()) ) 
    return 1;
  element = str;
  switch (element)
  {
    case "feuer":
      SetProp(P_NAME, "Efreeti-Figur");
      SetProp(P_NAME_ADJ, ({"klein", "feurig"}) );
      SetProp(P_SHORT, "Eine kleine, feurige Efreeti-Figur");
      AddId (({"feuerfigur", "efreeti-figur", "efreetifigur", "efreeti figur"}));
      AddAdjective (({"kleine", "feurige"}));
      SetProp(P_LONG,
          "Diese kleine Figur scheint aus purem Feuer zu bestehen und aehnelt "
          "einem Efreeti.");
      SetProp(P_MATERIAL, MAT_FIRE);
      break;
    case "wasser":
      SetProp(P_NAME, "Marid-Figur");
      SetProp(P_NAME_ADJ, ({"kugelrund", "waessrig"}) );
      SetProp(P_SHORT, "Eine kugelrunde, waessrige Marid-Figur");
      AddId (({"wasserfigur", "marid-figur", "maridfigur", "marid figur"}));
      AddAdjective (({"kugelrunde", "waessrige"}));
      SetProp(P_LONG,
          "Diese kugelrunde Figur scheint aus reinem Wasser zu bestehen und aehnelt "
          "einem Marid.");
      SetProp(P_MATERIAL, MAT_WATER);
      break;
    case "luft":
      SetProp(P_NAME, "Djinni-Figur");
      SetProp(P_NAME_ADJ, ({"schlank", "luftig"}) );
      SetProp(P_SHORT, "Eine schlanke, luftige Djinni-Figur");
      AddId (({"luftfigur", "djinni-figur", "djinnifigur", "djinni figur"}));
      AddAdjective (({"schlanke", "luftige"}));
      SetProp(P_LONG,
          "Diese schlanke Figur scheint aus reiner Luft zu bestehen und aehnelt "
          "einem Djinni.");
      SetProp(P_MATERIAL, MAT_AIR);
      break;
    case "eis":
      SetProp(P_NAME, "Dao-Figur");
      SetProp(P_NAME_ADJ, ({"gross", "eisig"}) );
      SetProp(P_SHORT, "Eine grosse, eisige Dao-Figur");
      AddId (({"eisfigur", "dao-figur", "daofigur", "dao figur"}));
      AddAdjective (({"grosse", "eisige"}));
      SetProp(P_LONG,
          "Diese grosse Figur scheint aus purem Eis zu bestehen und aehnelt "
          "einem Dao.");
      SetProp(P_MATERIAL, MAT_ICE);
      break;
  } 
  return 1;
}

int reiben(string str)
{
  object ob;
  if ( !element ) return 0;
  notify_fail("Was willst Du reiben?\n");
  if ( !id(str) ) return 0;
  if ( call_other("/spellbooks/druiden_spells", "QueryOwnCreature", this_player(), 0, 1) )
    return write("Du beherrscht schon ein Elementar.\n"),1;
  if(this_player()->QueryProp(P_GUILD) != "druidenzirkel")
    return notify_fail("Nur Druiden koennen diese Figur verwenden!\n"),0;
  if ( file_name(environment(this_player()))[0..37]!=
      ROOMS "level" && !IS_ARCH(this_player()))
    return write("Du reibst und reibst aber nichts passiert.\n"
        "Scheinbar ist die elementare Dichte hier nicht gross genug :(\n"),1;
  write("Ploetzlich manifestiert sich eine Gestalt aus reinstem " +
      capitalize(element)+".\n");
  say("Ploetzlich manifestiert sich eine Gestalt aus reinstem "+
      capitalize(element)+".\n");

  ob = clone_object("/gilden/druidenzirkel/npc/elementar");
  ob->Customize(element, TP, 10000+random(10)*1000, 20 + well_level(TP));
  ob->SetProp("e_owner", TP);
  ob->move(ENV(TP), M_TPORT|M_SILENT);
  ob->SetOwner(TP, 1);

  if (!random(20))
    call_out("remove", 1);
  return 1;
}
