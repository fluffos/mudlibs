inherit "/std/thing";

#include "../def.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Kompass");
  SetProp(P_LONG, 
   "Ein kleiner Kompass, der Dir den Weg zu vielen verborgenen "
   "Dingen zeigen kann.");
  SetProp(P_INFO,break_string(
    "Mit diesem Kompass kannst Du den Zwergenschatz, die Astralwelt, den "
    "magischen Brunnen, den Weg ins Gaffodorf und Deinen allerletzen "
    "Forscherpunkt finden. Einfach 'kompass finde <was>' eingeben und "
    "schon bist Du auf dem richtigen Weg."),78);  
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 100);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Kompass");
  AddId( ({"kompass", "\nbrunnenkompass"}));

  AddCmd( ({"kompass"}), "kompass");
}

string tt2string(int tt)
{
  switch(tt)
  {
    case 1: return "in einer Hoehle";
    case 2: return "in einem Haus";
    case 3: return "auf einem Huegel";
    case 4: return "im Wald";
    case 5: return "in einer Stadt";
    case 6: return "in den Bergen";
    case 7: return "in der Wueste";
    case 8: return "im Dschungel";
    case 9: return "im Sumpf";
    case 10: return "im Flachland";
    case 11: return "im Polargebiet";
    case 12: return "unterwasser";
    case 13: return "im Wasser";
    case 14: return "auf einer Strasse";
    case 15: return "In der Luft";
    default: return "an einem unbestimmten Platz";
  }
}

int kompass(string str)
{
  object ob;
  string str2;
  int tt;
  string *parts, *parts2;;
  notify_fail("Was soll der Kompass fuer Dich finden?"+
     " ('kompass finde <was>')\n");
  if(!str) return 0;
  if(sscanf(str,"finde %s",str2)!=1)
    return 0;
  if( this_player()->QueryProp(P_SP)<10) 
    return write("Du hast zu wenig Magiepunkte um den Kompass zu benutzen!\n"),1;
  this_player()->AddSp(-3-random(13));
  switch(str2)
  {
    case "forscherpunkt":
    case "fp":
      write(break_string("Dir fehlt noch mehr als 1 Forscherpunkt, also "
            "kannst Du auch nicht Deinen allerletzten finden.\n",78));
      return 1;
    case "zwergenschatz":
    case "schatz":
    case "astralwelt":
    case "welt":
    case "gaffodorf":
    case "gaffos":
    case "gaffo":
    case "dorf":
      switch(random(14))
      {
        case 0: write("Der Kompass sagt: Naechste Abzweigung links.\n"); break;    
        case 1: write("Der Kompass sagt: Naechste Abzweigung rechts.\n"); break;    
        case 2: write("Der Kompass sagt: Immer gerade aus.\n"); break;    
        case 3: write("Der Kompass sagt: Weiter nach Norden.\n"); break;    
        case 4: write("Der Kompass sagt: Weiter nach Sueden.\n"); break;    
        case 5: write("Der Kompass sagt: Weiter nach Osten.\n"); break;    
        case 6: write("Der Kompass sagt: Weiter nach Westen.\n"); break;    
        case 7: write("Der Kompass sagt: Du bist ja schon viel zu weit!\n"); break;    
        case 8: write("Der Kompass sagt: Bald bist Du dort!\n"); break;    
        case 9: write("Der Kompass sagt: Jetzt bist Du voellig falsch.\n"); break;    
        case 10: write("Der Kompass sagt: Weiter nach Nordosten.\n"); break;    
        case 11: write("Der Kompass sagt: Weiter nach Suedosten.\n"); break;    
        case 12: write("Der Kompass sagt: Weiter nach Nordwesten.\n"); break;    
        case 13: write("Der Kompass sagt: Weiter nach Suedwesten.\n"); break;    
      }
      return 1;
    case "brunnen":
      if(!find_living("wellentrancenpc"))
        call_other( NPC "eingang", "???");
      if(!(ob=find_living("wellentrancenpc")) || !environment(ob))
      {
        write("Der Kompass sagt: Der Eingang zum Brunnen ist zur Zeit "
           "nicht ereichbar!\n");
        return 1;
      }
      parts=explode(file_name(environment(ob)),"/");
      parts2=explode(file_name(environment(this_player())),"/");
      tt=environment(ob)->QueryProp(P_ENVIRONMENT)[ENV_TERRAIN];
      if (file_name(environment(this_player()))[0..32]==ROOMS)
        return write("Der Kompass sagt: Du bist doch schon im Brunnen!\n"),1;
      else if(present("\nbrunneneingang", environment(this_player()))) 
        return write("Der Kompass jubelt: GEFUNDEN!\n"),1;
      else if(sizeof(parts2)<4) 
        return write(break_string("Von hier aus kannst Du den Brunnen nicht "+
              "finden!\n", 78,"Der Kompass sagt: ")),1;
      else if(sizeof(parts)<4)
        return write(break_string("Der Brunnen ist irgendwo, wo er eigentlich "
              "gar nicht sein duerfte!",78,"Der Kompass sagt: ")),1;
      else if(parts[1]!=parts2[1])
        write("Der Kompass sagt: Der Brunnen ist ganz wo anders!\n");
      else if( parts[2]!=parts2[2])
        write("Der Kompass sagt: Der Brunnen ist sehr weit weg!\n");
      else if( parts[3]!=parts2[3])
        write("Der Kompass sagt: Der Brunnen ist relativ weit weg!\n");
      else if( parts[4]!=parts2[4])
        write("Der Kompass sagt: Der Brunnen ist relativ in der Naehe!\n");
      else 
        write("Der Kompass sagt: Der Brunnen ist ganz in der Naehe!\n");
      if(!random(5))
        write("Der Kompass sagt: Der Brunnen ist "+ tt2string(tt)+".\n");
      else if (!random(10))
        write("Du koenntest schwoeren, dass der Brunnen dort ist, wo er "
            "normalerweise nicht ist.\n");
      return 1;
    default:
      write("Der Kompass sagt: Sowas kann ich nicht finden!\n");
      return 1;
  }
}
