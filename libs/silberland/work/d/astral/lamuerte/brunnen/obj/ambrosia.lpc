inherit "std/food";

#include <food.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Goettliches Ambrosia");
  SetProp(P_LONG,
      "Du haeltst goettliches Ambrosia in den Haenden. Es schimmert in allen Farben "
      "und duftet besser als alls was Du bisher gesehen hast. Die Speise der "
      "Goetter kann getrunken werden, zumindest von Goettern, was mit Sterblichen "
      "passiert wenn sie Ambrosia verspeisen ist doch recht fraglich.");
  SetProp(P_NAME_ADJ,({"goettlich"}));
  SetProp(P_NAME, "Ambrosia");
  AddId(({"ambrosia"}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_MAGIC, 1);
  SetProp(P_GENDER,NEUTER);
  SetProp(P_FOOD_INFO, ([F_HEAL : ({5, 0}), F_SOAK : 10]));
  SetProp(P_ARTICLE,0);

  SetProp(P_KILL_NAME,"Goettliches Ambrosia");
  SetProp(P_KILL_MSG,({"ist nichts fuer Sterbliche.",MSG_EMOTE}));

  SetProp(P_INFO,"Wie bist Du bloss an Ambrosia gekommen?! Ein Gott "+
      "wuerde so etwas nie hergeben, es kann ihm hoechstens von einem "+
      "Daemon oder einem aehnlich Wesen aus den tiefen des Boesen "+
      "gestohlen worden sein.");
}

void BeimEssen()
{
  int value;
  value=(-10)+random(999);
  if(value>0){
    write("Du trinkst goettliches Ambrosia.\nDu fuehlst Dich goettlich!\n");
    say(this_player()->name()+" trinkt goettliches Ambrosia.\n");
    this_player()->SetProp(P_MAX_HP,value);
    this_player()->SetProp(P_HP,value);
    clone_object(OBJ "ambrosia_cancel")->move(this_player(),M_NOCHECK);
  }
  else
  {
    write("Du trinkst Ambrosia.\nDu stirbst daran, es war zu goettlich!\n");
    say(this_player()->name()+" stirbt an goettlichem Ambrosia.\n");
    this_player()->do_damage(10000,this_object()); 
  }
}
