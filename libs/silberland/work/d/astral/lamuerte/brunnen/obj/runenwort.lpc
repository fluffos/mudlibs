inherit "std/thing";

#include "../def.h"
#include "/p/daemon/itemd/data/itemd_socketed_data.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Runenwortes!");
    destruct();
    return;
  }

  SetProp(P_NAME, "Runenwort");
  SetProp(P_SHORT, "Ein Runenwort");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_LONG,
      "Du kannst das Runenwort nicht entziffern.");
  AddId (({"runenwort", "\nwellrunenwort"}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_NOSELL, 1);
}



int final_setup()
{
  object npc;

  if(!npc=environment()) 
    return remove();
  if(!(npc->id("\nbrunnenpc")) && 
      getuid(npc)!="feyaria" && getuid(npc)!="lamuerte")
    return remove();
  SetProp(P_LONG,
      "Das Runenwort lautet: " + 
      RUNEWORDTALISMAN[random(sizeof(RUNEWORDTALISMAN))] );
}

void reset()
{
  if(!is_clone(this_object())) return;
  ::reset();
  if(!random(3))
  {
    if(environment())
      tell_object(environment(), "Das Runenwort zerfaellt zu Staub.\n");
    remove();
  }
}
