inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Kopf einer Hydra");
  SetProp(P_LONG, 
   "Ein grosser Kopf einer Hydra, irgendwer muss ihn ihr "
   "abgeschlagen haben.");
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT, 5100);
  SetProp(P_GENDER, MALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Hydrakopf");
  AddId( ({"kopf", "\nbrunnenkopf", "hydrakopf"}));

}

void reset()
{
  ::reset();
  if( !is_clone(this_object())) return;
  if( environment() )
  {
    tell_object( environment(), "Der Hydrakopf zerfaellt zu Staub.\n" );
    tell_room( environment(), "Der Hydrakopf zerfaellt zu Staub.\n" );
  }
  remove();
}
