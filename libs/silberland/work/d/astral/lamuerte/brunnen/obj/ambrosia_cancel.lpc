inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  AddId (({"\nambrosia_mod"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);

  call_out("remove_me",400+random(400));
}

void remove_me()
{
  if(environment())
  {
    tell_object(environment(), "Dein Goettliches Gefuehl schwindet.\n");
    environment()->UpdateAttributes();
    environment()->AddHp(400);
  }
  call_out("remove",0);
}

