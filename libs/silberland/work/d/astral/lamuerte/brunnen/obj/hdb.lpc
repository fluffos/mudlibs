inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include <new_skills.h>

object player;

cast_now();

void create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_SHORT,"DAS HERZ DES BOESEN");
  SetProp(P_LONG,
      "Das pulsierende Herz des Boesen! Es will deinen TOD!");
  SetProp(P_NAME,"Herz");
  SetProp(P_KILL_NAME,"DAS HERZ DES BOESEN" );
  AddId( ({"herz", "\nbrunnenherz", "herzdesboesen"}));

  SetProp(P_INFO,
      "Das Herz des Boesen! Nur wer eines reinen Herzens ist, nur wer\n"
      "die Tugenden eines Paladins sein Leben lang verfolgte, nur wer\n"
      "fuer das Gute steht, nur wer von Dusty gesgnet ist, kann - es sei\n"
      "seine Schnelligkeit gleicht derer eines Falken im Sturz auf seine\n"
      "Beute - dieses Herz vernichten bevor das Herz ihn selbst zerstoert.\n");
  SetProp(P_VALUE, 666666);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_MAGIC, 666);

  call_out("cast_now",20+random(6));
}


int cast_now() {
  object pl;
  if (objectp(pl = environment(this_object())) && query_once_interactive(pl)){
    if (pl->QueryProp(P_GUILD)!="paladine" || 
        pl->QueryProp(P_GUILD_LEVEL) != 15) {
      tell_object(pl,"DAS HERZ DES BOESEN Z E R F E T Z T DICH!\n");
      pl->do_damage(random(120)+1);
      call_out("cast_now",4+random(6));
      return 1;
    }
    else {
      tell_object(pl,
          "DAS HERZ DES BOESEN trifft Dich hart!\n"
          "Du als Paladin kannst den meissten Schaden abwenden!\n");
      pl->do_damage(random(3)+1);
      call_out("cast_now",4+random(6));
      return 1;
    }
  }
  call_out("cast_now",4+random(6));
  return 0;
}

