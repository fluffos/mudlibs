inherit "/std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Daemonenschwert");
  SetProp(P_LONG, 
   "Das ist das maechtige Schwert eines Schwertdaemons.  "
   "Es ist viel zu gross, als das Du es verwenden koenntest.");
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 5100);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Daemonenschwert");
  AddId( ({"schwert", "daemonenschwert"}));
  SetProp(P_WC, 300);
  SetProp(P_WC_FIX, 90);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_WIELD_RESTRICTIONS, ([P_RACE:"Daemon"]) );
}


string short()
{
  if(environment()->id("schwertdaemon") )
    return "Ein Daemonenschwert (gezueckt).\n";
  return ::short();
}
  
