inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,0);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NAME, 0);
  SetProp(P_INVIS, 1);
  AddId( ({"\ndaokiller" }));
}

void reset()
{
  ::reset();
  if(!random(100))
    remove(1);
}
