inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>


object player;
create() {
  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  AddId (({"\nbrainstorm"}));
  SetProp(P_WEIGHT, 0);
}

init() {
  ::init();
  if(!interactive(player=environment(this_object())) ) {
    call_out("remove",0);
    return ;
  }
  else {
  SetProp(P_X_ATTR_MOD,([A_INT:-(random(3)+1)]));
  player->UpdateAttributes();
  call_out("bs", 1, player);
  }
}

bs() {
    tell_object(environment(),"Dein Gehirn brennt, Du scheinst alles zu vergessen was Du je wusstest.\n");
    environment()->AddSp(-5-random(10));
    call_out("remove_me",300+random(300));
    return ;
}

remove_me() {
  SetProp(P_X_ATTR_MOD,0);
   environment()->UpdateAttributes();
  tell_object(environment(),"Endlich, Du kannst wieder klare Gedanken fassen.\n");
  remove(1);
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  remove(1);
}

