inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>


object player;
int cntr;
create()
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, 0);
SetProp(P_SHORT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
AddId (({"\nhold"}));
SetProp(P_WEIGHT, 0);

cntr=0;
AddCmd( ({"n", "s", "o", "w", "norden", "sueden", "osten", "westen"}), "nix");
}

nix()
{
  write ("Du kannst nicht Laufen, Deine Beine sind gelaehmt!\n");
  return 1;
}

init() {
  ::init();
  if(present("\nhold 2") || !player=interactive(environment(this_object())) ) {
  call_out("remove_now",1);
  }
}

set_time(int time)
{
  while (remove_call_out("remove_now") != -1) /* continue */ ;
  call_out("remove_now", time);
}

remove_now() {
  tell_object(environment(), "\nDu kannst Deine Beine wieder bewegen!\n\n");
  remove(1);
}

