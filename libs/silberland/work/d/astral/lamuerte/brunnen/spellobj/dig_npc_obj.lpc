inherit "std/thing";

#include "../def.h"
#include "../well_level.h"

#define RAUMNAME(x) explode(file_name(x),"/")[<1]

object player;
object obj;
int cntr;

void create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET,1);

  SetProp(P_WEIGHT, 0);

  cntr=0;
}

void remove_me() {
  if(cntr) tell_room(environment(),"Etwas passiert.\n");
  environment(this_object())->RemoveExit("krater");
  call_out("remove", 0);
}

void init() {
  ::init();
  call_out("remove_me", 60);
}

int start_saug(object pl){
  string path;
  cntr=1;
  AddId (({"\ntrapdoor","sauger"}));
  if(!pl) return 0;

  if(file_size(ROOMS "level"+to_string(well_level(this_object())+1)+"/"+
        RAUMNAME( (environment(this_object())))+".lpc") != -1)
  {
    environment(this_object())->AddExit(
        "krater",path=ROOMS "level"+to_string(well_level(this_object())+1)+"/"+
        RAUMNAME((environment(this_object()))));
    tell_room(environment(this_object()), break_string(
        "Eine konische Plasmawolke dringt blitzartig in den Boden ein "
        "und reisst einen tiefen Krater."));
    tell_object(pl,"Du wirst durch einen Krater in die Tiefe gesaugt!\n");
    tell_room(environment(this_object()),this_player()->QueryProp(P_NAME)+
        " wird durch einen Krater in die Tiefe gesaugt!!!\n", ({pl}));
    pl->move(path, M_NOCHECK);

    call_out("remove_me", 60);
    return 1;
  }
  tell_object(pl,"Du spuerst eine leichte Schwankung im Raum-Zeit-Gefuege.\n");
  call_out("remove", 0);
  return 1;
}
