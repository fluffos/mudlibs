inherit "std/thing";

#include "../def.h"

object player;
int cntr;

void create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET,1);

  AddId (({"\ntrapdoor"}));
  SetProp(P_WEIGHT, 0);

  cntr=0;
}

void init() 
{
  ::init();
  call_out("remove_me", 60);
}


void remove_me() 
{
  tell_room(environment(),"Ein Loch verschwindet.\n");
  environment(this_object())->RemoveExit("loch");
  this_object()->remove(1);
}

