inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include <mnpc.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Steinkreis");
  SetProp(P_SHORT, "Ein Steinkreis der Regeneration");
  SetProp(P_GENDER, MALE);
  SetProp(P_LONG,
      "Viele kleine, in vielen bunten Farben schillernde Steine sind in diesem "
      "Raum in einem Kreis aufgelegt. Dieser Steinkreis kann Deine Wunden "
      "heilen oder Deine Magie auffrischen oder vielleicht sogar beides.");
  SetProp(P_NOGET, "Der Steinkreis ist doch viel zu gross und zu schwer.\n");
  AddId (({"kreis", "steinkreis"}));
  SetProp(P_WEIGHT, 100000000);
}

void set_remove_time(int time)
{
  call_out("remove_me",time);
}

void remove_me() {
  tell_room(environment(),"Der Steinkreis loest sich in Luft auf.\n");
  remove(1);
}

void reset()
{
  if(!is_clone(this_object())) return;
  ::reset();
  remove(1);
}

varargs void heal(mixed heal, int time)
{
  int i;
  object *livings;
  if( !time) time=4;
  if( !heal) heal=({1,1});
  if( intp(heal) ) heal=({heal,heal});
  if( !environment() ) return;
  livings=filter_array(all_inventory(environment()),#'living);
  for(i=sizeof(livings)-1;i>=0;i--)
  {
    livings[i]->AddHp(heal[0]);
    livings[i]->AddSp(heal[1]);
    if(!random(5) && livings[i]->QueryProp(P_POISON))
      livings[i]->AddPoison(-1);
    else if(!random(30) && livings[i]->QueryProp(P_FROG))
    {
      tell_object(livings[i], "Die Macht des Steinkreises entfroscht Dich!\n");
      livings[i]->SetProp(P_FROG, 0);
    }
    else if(!random(20) && livings[i]->QueryProp(P_BLIND))
    {
      tell_object(livings[i], "Die Macht des Steinkreises laesst Dich wieder sehen!\n");
      livings[i]->SetProp(P_BLIND, 0);
    }
    else if(!random(10) && livings[i]->QueryProp(P_DEAF))
    {
      tell_object(livings[i], "Die Macht des Steinkreises laesst Dich wieder hoeren!\n");
      livings[i]->SetProp(P_DEAF, 0);
    }
  }
  call_out("heal", time, heal, time);
}
