#include "../def.h"

inherit "std/unit";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"\nbrunnenrolle"}));
  AddSingularId("rolle");
  AddSingularId("schriftrolle");
  AddPluralId("rollen");
  AddPluralId("schriftrollen");
  SetCoinsPerUnits(1000,1);
  SetGramsPerUnits(21,1);
}

string short()
{
  string s, t;
  int d;

  s = ::short();
  if (QueryProp(P_NODROP))
    s = s[0..<3] + " (lesend).\n";
  if (stringp(s) && sscanf(s, "%d %s", d, t) == 2)
  {
    if (d > 100) return "Hunderte " + t;
    if (d > 50) return "Dutzende " + t;
    if (d > 20) return "Ein Buendel " + t;
    if (d > 10) return "Viele " + t;
    if (d > 5) return "Einige " + t;
    else return ([2:"Zwei", 3:"Drei", 4:"Vier", 5:"Fuenf", 6:"Sechs", 
                  7:"Sieben", 8:"Acht", 9:"Neun"])[d] + " " + t;
  }
  return s;
}

int IsEqual(object ob)
{
  if (QueryProp(P_NODROP)) 
    return 0;
  return ::IsEqual(ob);
}
