inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include <mnpc.h>

object player;

void create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, "Schutzsteinkreis");
  SetProp(P_SHORT, "Ein Steinkreis des Schutzes");
  SetProp(P_GENDER, MALE);
  SetProp(P_LONG,
      "Grosse, zackige Steine sind in diesem Raum ausgelegt und bilden einen "
      "vollkommenden Kreis. Die Zacken zeigen alle zu den Ausgaengen, als "
      "wollten sie Dich vor boesen Monstern beschuetzen.");
  SetProp(P_NOGET, "Der Steinkreis ist doch viel zu gross und zu schwer.\n");
  AddId (({"kreis", "steinkreis", "schutzsteinkreis", "\nschutzsteinkreis"}));
  SetProp(P_WEIGHT, 100000000);
  SetProp(P_MATERIAL, MAT_STONE);
}

void init() {
  ::init();
  environment()->SetProp(P_NO_MNPC, 1);
}

void set_remove_time(int time)
{
  call_out("remove_me",time);
}

void remove_me() 
{
  tell_room(environment(),"Der Steinkreis loest sich in Luft auf.\n");
  environment()->SetProp(P_NO_MNPC, 0);
  remove(1);
}

void reset()
{
  if(!is_clone(this_object())) return;
  ::reset();
  remove_me();
}

