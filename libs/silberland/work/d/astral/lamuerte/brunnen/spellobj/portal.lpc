inherit "std/thing";

#include "../def.h"
#include <mnpc.h>

object desttrans;

void create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, "Portal");
  SetProp(P_SHORT, "Ein magisches Portal");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_LONG,
      "Das Portal ist grell rot, wenn man hindurch blickt scheint man eine "
      "andere Dimension zu sehen. Man kann dieses hochmagische Portal auch "
      "betreten, doch entscheide Dich schnell, sonst verschwindet es wieder.");
  SetProp(P_NOGET, "Das Portal ist doch viel zu gross und zu schwer.\n");
  AddId (({"portal"}));
  SetProp(P_WEIGHT, 100000000);

  AddCmd(({"betrete","gehe","geh","huepf","spring","kletter","klettere"}), "do_portal");
}

void set_remove_time(int time)
{
  call_out("remove_me",time);
}

void remove_me() 
{
  if(environment())
    tell_room(environment(),"Das Portal wird unsichtbar.\n");
  remove(1);
}

int set_dest(object rname)
{
  desttrans=rname;
  return 1;
}

void reset()
{
  if(!is_clone(this_object())) return;
  ::reset();
  remove(1);
}

int do_portal(string wohin)
{
  object ob;

  notify_fail("Was willst Du betreten?\n");
  if(!wohin)
  {
    return 0;
  }

  if(wohin=="portal" || wohin == "teleporter" )
  {
    if(file_name(environment(this_player()))[0..25]==ZONE)
      tell_object(this_player(),"Du wirst an die Oberflaeche des Brunnens teleportiert.\n");
    else
    {
      if (!IS_SEER(this_player()))
      {
        write("Eine magische Macht verhindert, dass Du das Portal betrittst.\n");
        return 1;
      }
      tell_object(this_player(),"Du wirst in die Tiefen des Brunnens teleportiert.\n");
      if( !IS_LEARNER(this_player()) && !present("\nbrunnencorpseobj", this_player()) ) 
        clone_object(CORPSE "corpseobj")->move(this_player(), M_NOCHECK);
    } 
    this_player()->move(desttrans,M_NOCHECK, "in ein Portal", "steigt",
        "steigt aus einem Portal");
    if( ob = present("\nfragkristall", this_player()) )
      ob->set_modifiers();

    return 1;
  }

  return 0;
}

