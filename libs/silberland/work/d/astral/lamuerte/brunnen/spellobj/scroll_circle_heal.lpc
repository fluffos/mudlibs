#include "../def.h"

inherit SPELLOBJ "unit";

object player;
int cntr;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME,({ "'Hegrusc' Schriftrolle", "'Hegrusc' Schriftrollen"}));
  SetProp(P_SHORT, "Eine 'Hegrusc' Schriftrolle");
  SetProp(P_LONG, 
      "Du siehst eine alte Papyrusrolle in Deinen Haenden. Sie ist schon etwas vergilbt und "
      "der Rand des Papyrus sieht etwas zerschlissen aus. Auf der Schriftrolle befinden sich "
      "einige magische Runen, welch Du versuchen kannst zu lesen, darunter sieht man "
      "einen mit wackeliger Hand gezeichneten Steinkreis, in dem Kreis stehen einige "
      "Strichmaennchen welche sich gegenseitig ihre Wunden versorgen.");

  SetProp(P_GENDER,FEMALE);

  AddReadDetail(({"rolle","schriftrolle","papyrus","runen","hegrusc", 
        "hegrusc rolle", "hegrusc schriftrolle"}),"@@cast_now@@");

  AddId (({"\nbrunnenrolle"}));
  AddId ("hegrusc");
  AddSingularId(({"schriftrolle", "rolle"}));
  AddPluralId(({"schriftrollen", "rollen"}));
  AddSingularId("hegrusc schriftrolle");
  AddPluralId("hegrusc schriftrollen");
  AddSingularId("hegrusc rolle");
  AddPluralId("hegrusc rollen");

  cntr=10;
  seteuid(getuid(this_object()));
}

void remove_me() 
{
  while (remove_call_out("remove_me") != -1);
  while (remove_call_out("cast_now") != -1);
  write("Die Papyrusrolle loest sich auf.\n");
  if( player)
    player->SetProp(P_TMP_MOVE_HOOK, 0);
  player = 0;
  cntr = 10;
  SetProp(P_NODROP, 0);
  AddAmount(-1);
}

varargs mixed player_tries_to_move(mixed dest, int methods, string direction, 
    string textout, string textin)
{
  if (player && player->QueryProp(P_GHOST))
  {
    player->SetProp(P_TMP_MOVE_HOOK,0);
    while(remove_call_out("cast_now") != -1);
    call_out("remove_me",0);
    return ({dest, methods, direction, textout, textin});
  }
  call_out("remove_me",2);
  return(break_string("Als Du versuchst, wegzulaufen, brichst Du das Lesen "+
        "der Schriftrolle ab, bleibst aber stehen.",78));
}

string cast_now() {
  object obj;

  if(!player)
  {
    if(!(player = this_player()))
    {
      remove_me();
      return "";
    }
  }
  switch(cntr) {

    case 10..20 :
      if(!player->QueryProp(P_TMP_MOVE_HOOK)){
        player->SetProp(P_TMP_MOVE_HOOK, ({ time()+200,
              this_object(), "player_tries_to_move" }) );
      }
      else
      {
        write("Aus irgendeinem Grund kannst Du die Schriftrolle nicht "
            "lesen.\nDu wirst schon wissen, warum!\n");
        return "";
      }
      SetProp(P_NODROP, 1);
      say(player->Name(WER,1)+" faengt an von einer magischen Papyrusrolle zu lesen.\n");
      RemoveReadDetail(({"rolle","schriftrolle","papyrus","runen"}),"@@cast_now@@");
      AddReadDetail(({"rolle","schriftrolle","papyrus","runen"}),"Du liest ja schon.");
      break;

    case 21..40 :
      if (file_name(environment(player))[0..26]!=ZONE)
      { 
        write("Als Du versuchst, die Rolle zu lesen, loest sie sich in Rauch auf.\n");
        say("Als "+player->Name(WER,1)+" versucht, die Rolle "+
            "zu lesen, loest sie sich in Rauch auf.\n");
        call_out("remove_me",2);
        return "";
      }
      write("Du liest die Runen laut vor.\nDu sagst: Nogo flkreh nemaleck!\n");
      say(player->Name(WER,1)+" sagt: Nogo flkreh nemaleck!\n");
      break;

    case 41..60 :
      write("Du spuerst wie sich Dein Koerper mit magischer Energie laedt.\n");
      say(player->Name(WER,1)+" wird von einer leuchtenden gelben Aura eingehuellt!\n");
      break; 

    case 61..80 :
      write("Du rufst: Woto biteto chailo chalo infelkreiso!\nWas mag das wohl bedeuten?!\n");
      say(player->Name(WER,1)+" ruft: Woto biteto chailo chalo infelkreiso!\n");
      break;

    case 81..100 :
      write("Vor Deinem Koerper bildet sich eine strahlende Plasmawolke!\n");
      say(player->Name(WER,1)+" erzeugt eine strahlende "+
          "Plasmawolke vor "+player->QueryPossPronoun(MALE,WEM,SINGULAR)+
          " Koerper!\n");
      break;

    case 101..120 :
      write("Steinbrocken werden aus der Plasmawolke materialisiert, "
          "welche sich\nkreisfoermig am Boden anordnen.\n");
      say("Steinbrocken werden aus der Plasmawolke materialisiert, welche "
          "sich\nkreisfoermig am Boden anordnen.\n");
      obj=clone_object(SPELLOBJ "circle_healing.lpc");
      obj->move(environment(player),M_NOCHECK);
      obj->set_remove_time(330+random(630));
      obj->heal( ({4+random(8),4+random(8)}) ,2);
      if( player)
        player->SetProp(P_TMP_MOVE_HOOK, 0);
      break;

    case 121..140 :
      write("Die Plasmawolke verschwindet vor Deinen Augen.\n");
      say("Die Plasmawolke verschwindet vor Deinen Augen.\n");
      break;

    case 141 .. 160 :
      write("Die magische Energie verlaesst Deinen Koerper.\n");
      say(player->Name(WER,1)+" wird von der gelben Aura verlassen.\n");
      break;

  }

  if(cntr>141) 
    call_out("remove_me",1);
  else
  {
    cntr=cntr+20;
    call_out("cast_now",2);
  }
  return "Du konzentrierst Dich.";
}



varargs int move(mixed dest,int method) {
  if (find_call_out("remove_me") != -1 ||
      find_call_out("cast_now") != -1)
  {
    write("Die Schriftrolle laesst sich nicht bewegen!\n");
    return 0;
  }
   return ::move(dest,method);
}
