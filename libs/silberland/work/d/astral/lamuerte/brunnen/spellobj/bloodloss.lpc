inherit "std/thing"; 
#include "../def.h"

int cntr;
void create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  AddId (({"\nbloodloss"}));
  SetProp(P_WEIGHT, 0);

  cntr=0;
}

void init() {
  ::init();
  if(present("\nbloodloss 2") || !interactive(environment(this_object())) ) {
    call_out("remove_now",1);
  }
  else{
  call_out("bs", 3);
  }
}

void bs() {
    object obj;
    cntr++;
    
    switch(random(200)) {
      case 0 .. 20 :
        write("Blut spritzt aus Deinen klaffenden Wunden, Du fuehlst Dich schwaecher.\n");
      break;

      case 21..40 :
        write("Deine Wunden entzuenden sich, Du scheinst Energie zu verlieren.\n");
      break;
     
      case 41..60 :
       write("Ein Blutstrahl fliesst aus Deinen Wunden. Die Schmerzen werden beinahe unertraeglich.\n");
      break; 

      case 61..80 :
        write("Du kannst Dich kaum noch bewegen, Du verlierst zu viel Blut.\n");
      break;

      case 81..100 :
        write("Deine Wunden brennen. Es trieft Blut heraus.\n");
      break;
     
      case 101..120 :
       write("Blut rinnt in grossen Mengen aus Deinen Wunden. Du fuehlst Dich elend.\n");
      break;

      case 121..140 :
       write("Du kippst beinahe um als Du das Blut aus Deinen Wunden fliessen siehst.\n");
      break;

      case 141 .. 160 :
       write("Du verlierst so viel Blut, wo soll das noch hinfuehren.\n");
      break;

      case 161 .. 180 :
       write("Du wirst bald sterben wenn Du weiter so viel Blut verlierst.\n"); 
      break;

      case 181 .. 200 :
       write("Dir wird schummrig vor den Augen. Du verlierst Blut.\n");
      break;
    }

    obj=clone_object(SPELLOBJ "blutspur.lpc");
    obj->set_name(this_player()->QueryProp(P_NAME));
    obj->move(environment(this_player()),M_NOCHECK);

    say(capitalize(this_player()->QueryProp(P_NAME))+" verliert Blut.\n");
    
    this_player()->reduce_hit_point(5+random(10));
    if(cntr==6) call_out("remove_me",1);
    call_out("bs",4+random(6));
    return ;
}

void remove_me() {
    write("Deine Wunden schliessen sich.\n");
  remove(1);
}

void remove_now() {
  remove(1);
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  remove(1);
}

