#include "../def.h"

inherit SPELLOBJ "unit";

object player;
int cntr;

void create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, ({"'Moprosc' Schriftrolle", "'Moprosc' Schriftrollen"}));
  SetProp(P_SHORT, "Eine 'Moprosc' Schriftrolle");
  SetProp(P_LONG, 
      "Du siehst eine alte Papyrusrolle in Deinen Haenden. Sie ist schon etwas vergilbt und "
      "der Rand des Papyrus sieht etwas zerschlissen aus. Auf der Schriftrolle befinden sich "
      "einige magische Runen, welch Du versuchen kannst zu lesen, darunter sieht man "
      "einen mit wackeliger Hand gezeichneten Steinkreis, rundum den einige Monster stehen. "
      "In der Mitte des steinkreises ist ein kleines Strichmaennchen gezeichnet welches "
      "einem der Monster die Zunge herausstreckt." );

  SetProp(P_GENDER,FEMALE);

  AddReadDetail(({"rolle","schriftrolle","papyrus","runen", "moprosc",
        "moprosc rolle", "moprosc schriftrolle"}),"@@cast_now@@");

  AddId (({"\nbrunnenrolle"}));
  AddId("moprosc");
  AddSingularId(({"schriftrolle", "rolle"}));
  AddPluralId(({"schriftrollen", "rollen"}));
  AddSingularId("moprosc schriftrolle");
  AddPluralId("moprosc schriftrollen");
  AddSingularId("moprosc rolle");
  AddPluralId("moprosc rollen");

  cntr=10;
}

void remove_me() 
{
  while (remove_call_out("remove_me") != -1);
  while (remove_call_out("cast_now") != -1);
  write("Die Papyrusrolle loest sich auf.\n");
  if( player)
    player->SetProp(P_TMP_MOVE_HOOK, 0);
  player = 0;
  cntr = 10;
  SetProp(P_NODROP, 0);
  AddAmount(-1);
}


varargs mixed player_tries_to_move(mixed dest, int methods, string direction, 
    string textout, string textin)
{
  if (player && player->QueryProp(P_GHOST))
  {
    player->SetProp(P_TMP_MOVE_HOOK,0);
    while(remove_call_out("cast_now") != -1);
    call_out("remove_me",0);
    return ({dest, methods, direction, textout, textin});
  }
  call_out("remove_me",2);
  return(break_string("Als Du versuchst, wegzulaufen, brichst Du das Lesen "+
        "der Schriftrolle ab, bleibst aber stehen.",78));
}

string cast_now() {
  object obj;

  if(!player)
  {
    if(!(player = this_player()))
    {
      remove_me();
      return "";
    }
  }
  switch(cntr) {

    case 10..20 :
      if(!this_player()->QueryProp(P_TMP_MOVE_HOOK)){
        this_player()->SetProp(P_TMP_MOVE_HOOK, ({ time()+200,
              this_object(), "player_tries_to_move" }) );
      }
      else
      {
        write("Aus irgendeinem Grund kannst Du die Schriftrolle nicht "
            "lesen.\nDu wirst schon wissen, warum!\n");
        return "";
      }
      SetProp(P_NODROP, 1);
      write("Du versuchst die magischen Runen auf dem Papyrus laut zu lesen.\n");
      say(this_player()->Name(WER,1)+" faengt an von einer magischen Papyrusrolle zu lesen.\n");
      RemoveReadDetail(({"rolle","schriftrolle","papyrus","runen"}),"@@cast_now@@");
      AddReadDetail(({"rolle","schriftrolle","papyrus","runen"}),"Du liest ja schon.");
      break;

    case 21..40 :
      if (file_name(environment(this_player()))[0..26]!=ZONE)
      { 
        write("Als Du versuchst, die Rolle zu lesen, loest sie sich in Rauch auf.\n");
        say("Als "+this_player()->Name(WER,1)+" versucht, die Rolle "+
            "zu lesen, loest sie sich in Rauch auf.\n");
        call_out("remove_me",2);
        return "";
      }
      write("Du liest die Runen laut vor.\nDu sagst: Cha Chagtazz Nigurazzor di Chado!\n");
      say(this_player()->Name(WER,1)+" sagt: Cha Chagtazz Nigurazzor di Chado!\n");
      break;

    case 41..60 :
      write("Du spuerst wie sich Dein Koerper mit magischer Energie laedt.\n");
      say(this_player()->Name(WER,1)+" wird von einer blitzenden blauen Aura eingehuellt!\n");
      break; 

    case 61..80 :
      write("Du rufst: Steino Circillio chomma umani jetzat!\nWas mag das wohl bedeuten?!\n");
      say(this_player()->Name(WER,1)+" ruft: Steino Circillio chomma umani jetzat!\n");
      break;

    case 81..100 :
      write("Vor Deinem Koerper bildet sich eine dunkle Wolke!\n");
      say(this_player()->Name(WER,1)+" erzeugt eine dunkle Wolke "
          "vor "+this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)+" Koerper!\n");
      break;

    case 101..120 :
      write("Steinbrocken werden aus der Wolke materialisiert, welche sich\n"
          "kreisfoermig am Boden anordnen.\n");
      say("Steinbrocken werden aus der Wolke materialisiert, welche sich\n"
          "kreisfoermig am Boden anordnen.\n");
      obj=clone_object(SPELLOBJ "circle_protection.lpc");
      obj->set_remove_time(90+random(290));
      obj->move(environment(this_player()),M_NOCHECK);
      if( this_player())
        this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
      break;

    case 121..140 :
      write("Die dunkle Wolke verschwindet vor Deinen Augen.\n");
      say("Die dunkle Wolke verschwindet vor Deinen Augen.\n");
      break;

    case 141 .. 160 :
      write("Die magische Energie verlaesst Deinen Koerper.\n");
      say(this_player()->Name(WER,1)+" wird von der blauen Aura verlassen.\n");
      break;

  }


  if(cntr>141) 
    call_out("remove_me",1);
  else
  {
    cntr=cntr+20;
    call_out("cast_now",2);
  }
  return "Du konzentrierst Dich.";
}
varargs int move(mixed dest,int method) {
  if (find_call_out("remove_me") != -1 ||
     find_call_out("cast_now") != -1)
  {
     write("Die Schriftrolle laesst sich nicht bewegen!\n");
     return 0;
  }
  return ::move(dest,method);
}
