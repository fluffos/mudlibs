inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>


object player;
int cntr, cint;
create()
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, 0);
SetProp(P_SHORT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
AddId (({"\nmanadrain"}));
SetProp(P_WEIGHT, 0);

cntr=0;
}

init() {
  ::init();
  if(present("\nmanadrain 2") || !player=interactive(environment(this_object())) ) {
  call_out("remove_now",1);
  }
  else{
  call_out("bs", 3);
  }
}

bs() {
    object obj;
    cntr++;
    
    switch(cint=cint+20) {
      case 0 .. 20 :
        write("Dein Koerper brennt. Du scheinst ein magisches Gift abbekomen zu haben.\n");
      break;

      case 21..40 :
        write("Du fuehlst wie Dich Deine Kraefte immer weiter verlassen.\n");
      break;
     
      case 41..60 :
       write("Einige Deiner Energie verpuffen im Nichts.\n");
      break; 

      case 61..80 :
        write("Du bemerkst wie Du immer mehr Deiner Energie verlierst.\n");
      break;

      case 81..100 :
        write("Deine Kraefte schwinden.\n");
      break;
     
      case 101 .. 120 :
       write("Das magische Gift scheint schwaecher zu werden.\n"); 
      break;

      case 121 .. 241 :
       write("Das magische Gift scheint seine Wirkung langsam zu verlieren.\n");
      break;
    }


    say(capitalize(this_player()->QueryProp(P_NAME))+" verliert magische Energie.\n");
   
    if (this_player()->QueryProp(P_SP)>10) { 
    this_player()->restore_spell_points(-(10+random(20)));
    }
    else{
    this_player()->reduce_hit_point(6+random(4));
    }
    if(cntr==6) call_out("remove_me",1);
    call_out("bs",4+random(20));
    return ;
}

remove_me() {
    write("Magisches Gift verlaesst Deinen Koerper.\n");
  remove(1);
}

remove_now() {
  remove(1);
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  remove(1);
}

