inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>


object player;
int cntr;
create()
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, "Blutspur");
SetProp(P_SHORT, "Eine Blutspur");
SetProp(P_NOGET, 1);
SetProp(P_LONG, "Eine rote Blutspur klebt am Boden.");
SetProp(P_GENDER, FEMALE);
AddId (({"\nblood","spur","blutspur"}));
SetProp(P_WEIGHT, 0);

cntr=0;
}

init() {
  ::init();
  if(present("\nblood 5") || player=interactive(environment(this_object())) ) {
  call_out("remove_now",1);
  }
  call_out("remove_me",10+random(55));
}

set_name(string s) {
  SetProp(P_SHORT,"Eine Blutspur von "+capitalize(s));
  AddId("\nblut"+s);
  return;
}

remove_me() {
    tell_room(environment(this_object()),"Eine Blutspur vertrocknet.\n");
  this_object()->remove(1);
}

remove_now() {
  this_object()->remove(1);
}
