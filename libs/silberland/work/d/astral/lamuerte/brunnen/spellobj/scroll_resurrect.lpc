#include "../def.h"

inherit SPELLOBJ "unit";

object player;
int cntr;
object leiche, leichenob;
string leichenname;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, ({"'Plaressurco' Schriftrolle", "'Plaressurco' Schriftrollen"}));
  SetProp(P_SHORT, "Eine 'Plaressurco' Schriftrolle");
  SetProp(P_LONG, 
      "Du siehst eine alte Papyrusrolle in Deinen Haenden. Sie ist schon etwas "
      "vergilbt und der Rand des Papyrus sieht etwas zerschlissen aus. Auf der "
      "Schriftrolle befinden sich einige magische Runen, welch Du versuchen "
      "kannst zu lesen, darunter sieht man ein mit wackeliger Hand gezeichnetes "
      "Strichmaennchen, welches ein zweites, zerstueckeltes Strichmaennchen "
      "wieder zusammenbaut.");

  SetProp(P_GENDER,FEMALE);

  AddReadDetail(({"rolle","schriftrolle","papyrus","runen", "plaressurco",
        "plaresurrco rolle", "plareusrroc schriftrolle"}),"@@cast_now@@");

  AddId (({"\nbrunnenrolle"}));

  AddId ("plaressurco");
  AddSingularId(({"schriftrolle", "rolle"}));
  AddPluralId(({"schriftrollen", "rollen"}));
  AddSingularId("plaressurco schriftrolle");
  AddPluralId("plaressurco schriftrollen");
  AddSingularId("plaressurco rolle");
  AddPluralId("plaressurco rollen");
  SetCoinsPerUnits(3000,1);
  cntr=10;
  seteuid(getuid(this_object()));
}

void remove_me() 
{
  while (remove_call_out("remove_me") != -1);
  while (remove_call_out("cast_now") != -1);
  write("Die Papyrusrolle loest sich auf.\n");
  if( player)
    player->SetProp(P_TMP_MOVE_HOOK, 0);
  player = 0;
  cntr = 10;
  leichenob = 0;
  SetProp(P_NODROP, 0);
  AddAmount(-1);
}

varargs mixed player_tries_to_move(mixed dest, int methods, string direction, 
    string textout, string textin)
{
  if (player && player->QueryProp(P_GHOST))
  {
    player->SetProp(P_TMP_MOVE_HOOK,0);
    while(remove_call_out("cast_now") != -1);
    call_out("remove_me",0);
    return ({dest, methods, direction, textout, textin});
  }
  call_out("remove_me",2);
  return(break_string("Als Du versuchst, wegzulaufen, brichst Du das Lesen "+
        "der Schriftrolle ab, bleibst aber stehen.",78));
}


varargs string ghost_tries_to_move(mixed dest,
        int methods, string direction, string textout, string textin)
{
  return "Die Magie der Schriftrolle verhindert Deine Bewegung.\n";
}

string cast_now() 
{
  object ob, next, mark;
  int xp, lvl, x;

  if(!player)
  {
    if(!(player = this_player()))
    {
      remove_me();
      return "";
    }
  }
  switch(cntr) 
  {
    case 10..20 :
      if(!player->QueryProp(P_TMP_MOVE_HOOK))
      {
        player->SetProp(P_TMP_MOVE_HOOK, ({ time()+200,
              this_object(), "player_tries_to_move" }) );
      }
      else
      {
        write("Aus irgendeinem Grund kannst Du die Schriftrolle nicht "
            "lesen.\nDu wirst schon wissen, warum!\n");
        return "";
      }
      SetProp(P_NODROP, 1);
      write("Du versuchst die magischen Runen auf dem Papyrus laut zu lesen.\n");
      say(player->Name(WER,1)+" faengt an von einer magischen Papyrusrolle zu lesen.\n");
      RemoveReadDetail(({"rolle","schriftrolle","papyrus","runen"}),"@@cast_now@@");
      AddReadDetail(({"rolle","schriftrolle","papyrus","runen"}),"Du liest ja schon.");
      break;

    case 21..40 :
      if (file_name(environment(player))[0..26]!=ZONE)
      {
        write("Als Du versuchst, die Rolle zu lesen, loest sie sich in Rauch auf.\n");
        say("Als "+player->Name(WER,1)+" versucht, die Rolle "+
            "zu lesen, loest sie sich in Rauch auf.\n");
        call_out("remove_me",2);
        return "";
      }
      write("Du liest die Runen laut vor.\nDu sagst: Holdsu Urigand Norftu Uiopsiutzl!\n");
      say(player->Name(WER,1)+" sagt: Holdsu Urigand Norftu Uiopsiutzl!\n");
      break;

    case 41..60 :
      if(leiche=present("leiche", environment(player)))
      {  
        leichenname=leiche->QueryProp(P_ORIG_NAME);
        if( !leichenob=find_player(lower_case(leichenname)))
          leiche=0; 
        write("Du spuerst wie sich Dein Koerper mit magischer Energie laedt.\n");
        say(player->Name(WER,1)+" wird von einer blitzenden weissen Aura eingehuellt!\n");
      }
      if( !leiche ) 
      {
        write(break_string("Im letzen Moment merkst Du, dass etwas fuer den "
              "erfolgreichen Zauber dieser Rolle fehlt und brichst den ganzen "
              "Vorgang ab.",78));
        say(player->Name(WER)+" bricht das Lesen der Schriftrolle ab.\n");
        AddReadDetail(({"rolle","schriftrolle","papyrus","runen"}),"@@cast_now@@");
        cntr = 10;
        player->SetProp(P_TMP_MOVE_HOOK, 0);
        player = 0;
        SetProp(P_NODROP, 0);
        return "";
      }
      break; 

    case 61..80 :
      write("Du rufst: Corpso deados liverti uno Zervasti!\nWas mag das wohl bedeuten?!\n");
      say(player->Name(WER,1)+" ruft: Corpso deados liverti uno Zervasti!\n");
      break;

    case 81..100 :
      write("Vor Deinem Koerper bildet sich eine weisse Wolke!\n");
      say(player->Name(WER,1)+" erzeugt eine weisse Wolke vor "+
          player->QueryPossPronoun(MALE,WEM,SINGULAR)+" Koerper!\n");
      break;

    case 101..120 :
      if( objectp(leichenob) && leichenob->QueryProp(P_GHOST))
      {
        tell_object(leichenob, player->Name(WER)+" ruft Deinen Geist "+
            "zu Deinem alten Koerper zurueck.\n");
        leichenob->move(environment(player),M_TPORT);
        leichenob->SetProp(P_TMP_MOVE_HOOK, ({ time()+10,
              this_object(), "ghost_tries_to_move" }) );
      }
      else
      {
        write(leichenname+" ist kein Geist mehr, daher wirkt die Rolle nicht.\n");
        say(player->Name(WER)+" bricht das lesen der Schriftrolle ab.\n");
        AddReadDetail(({"rolle","schriftrolle","papyrus","runen"}),"@@cast_now@@");
        call_out("remove_me",0);
        return "";
      }
      break;

    case 121..140 :
      if( !leichenob)
      {
        write("Die Schriftrolle loest sich auf. Die Magie zischt frei durch "+
            "den Raum.\n");
        say("Die Schriftrolle loest sich auf. Die Magie zischt frei durch "+
            "den Raum.\n");
        call_out("remove_me",0);
      }
      else
      {
        write("Der Geist faehrt wieder in seinen alten Koerper.\n"+
            leichenname+" weilt wieder unter den Lebenden!\n");
        say("Der Geist faehrt wieder in seinen alten Koerper.\n"+
            leichenname+" weilt wieder unter den Lebenden!\n",({leichenob, player}));
        tell_object(leichenob, "Du schluepfst wieder in Deinen alten Koerper "
            "und weilst wieder unter den Lebenen.\n"); 
        leichenob->SetProp(P_GHOST,0);
        leichenob->heal_self(400);
        leichenob->SetProp(P_TMP_MOVE_HOOK, 0);
        while (mark = present("\ndeath_mark", leichenob))
          mark->remove();

        xp = leichenob->QueryProp(P_XP);
        lvl = leichenob->QueryProp(P_LEVEL);
        if( lvl > 90 ) lvl = 90;
/*
        printf("xp=%d, lvl=%d\n",xp, lvl);
        x = xp / (lvl-18) * (lvl-17) - xp;
        if( x<0) x=0;
        if( x>leichenob->QueryProp(P_LOST_XP)) x = leichenob->QueryProp(P_LOST_XP);
        xp = random(x);

        printf("x=%d, xp=%d\n",x, xp);
        leichenob->AddExp(xp);
*/
        leichenob->resurrect(lvl / 2 + random(lvl / 2));
        if(leiche) 
        {
          for(ob=first_inventory(leiche);ob;) 
          {
            next=next_inventory(ob);
            ob->move(leichenob, M_NOCHECK|M_SILENT);
            ob=next;
          }
          leiche->remove();
        }
        if( !present("\nbrunnencorpseobj", leichenob) ) 
          clone_object(CORPSE "corpseobj")->move(leichenob, M_NOCHECK);
        write_file(LOGS "kills", sprintf("%s: %s resurrectet %s (%d XP zurueck)\n",
            dtime(time()), 
            capitalize(getuid(player)),
            capitalize(getuid(leichenob)),
            leichenob->QueryProp(P_XP) - xp));
        if (ob = present("\nfragkristall", leichenob))
          ob->set_modifiers();
      }
      player->SetProp(P_TMP_MOVE_HOOK, 0);
      break;

    case 141..160 :
      write("Die weisse Wolke verschwindet vor Deinen Augen.\n");
      say("Die weisse Wolke verschwindet vor Deinen Augen.\n");
      break;

    case 161 .. 180 :
      write("Die magische Energie verlaesst Deinen Koerper.\n");
      say(this_player()->Name(WER)+" wird von der weissen Aura verlassen.\n");
      break;

  }


  if(cntr>161) 
    call_out("remove_me",1);
  else
  {
    cntr=cntr+20;
    call_out("cast_now",4+random(6));
  }
  return "Du konzentrierst Dich.";
}


varargs int move(mixed dest,int method) {
  if (find_call_out("remove_me") != -1 ||
     find_call_out("cast_now") != -1)
  {
     write("Die Schriftrolle laesst sich nicht bewegen!\n");
     return 0;
  }
  return ::move(dest,method);
}
