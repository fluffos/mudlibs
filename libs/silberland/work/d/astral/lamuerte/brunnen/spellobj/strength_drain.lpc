inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>


object player;
create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  AddId (({"\nstrengthdrain"}));
  SetProp(P_WEIGHT, 0);
}

init() {
  ::init();
  if(!player=interactive(environment(this_object())) ) {
    call_out("remove",0);
  }
  else {
    SetProp(P_X_ATTR_MOD,([A_STR:-(random(3)+1)]));
    this_player()->UpdateAttributes();
    call_out("bs", 1);
  }
}

bs() {
  write("Deine Muskeln werden ploetzlich ganz schlapp.\n");
  this_player()->reduce_hit_point(5+random(10));
  call_out("remove_me",50+random(100));
  return ;
}

remove_me() {
  SetProp(P_X_ATTR_MOD,0);
  this_player()->UpdateAttributes();
  write("Endlich findest Du Deine alte Kraft wieder zurueck.\n");
  remove(1);
}

void reset()
{
  ::reset();
  if (!is_clone(this_object())) return;
  remove(1);
}

