// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/xorn.c
// ~Level:  30-35 
// ~Hands:  305,DT_BLUDGEON  WC: default AC: default 
// ~Spells: (Rate: 1, Steckt Gegner mit Malaria an
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:frisst des Spielers geld auf.

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Eine merkwuerdige, dreiarmige und dreibeinige Kreatur");
  SetProp(P_LONG, 
      "Du siehst eine reichlich merkwuerdige Kreatur vor Dir. Sein Kopf und sein "
      "Koerper sind zusammengewachsen und vom Kopf-Koeper wachsen nach oben drei "
      "Arme und nach unten drei Beine. Arme und Beine sind quasi dreieckig "
      "angeordnet. Da Du auch keine Augen erkennen kannst, weisst Du gar nicht, "
      "wo jetzt vorne und hinten ist. Ein wirklich sehr seltsames Wesen! "
      "Auch sonderbar ist, dass sein grosser Mund golden glaenzt, genaus wie "
      "Du es von Deinen Goldmuenzen kennst.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({40, 70, 20}));
  
  SetProp(P_AGGRESSIVE,0.1+0.07*to_int(well_level()));
  SetProp(P_NAME, "Xorn");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 190+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","xorn", "kreatur"}));
  create_default_npc(25+random(6));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 3); 
  SetProp(P_HANDS, ({" mit drei Haenden gleichzeitig",305,DT_BLUDGEON})); 
  SetProp(P_SPELLRATE,40);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0.3, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :-0.3,    DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :-0.5]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "treibt sich herein");
  SetProp(P_MSGOUT, "treibt");

  SetProp(P_DIE_MSG, " kippt um und ist tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Naechstes mal klopp ich Dich tot, %s!");
  SetProp(P_KILL_NAME, "Ein Xorn");
  SetProp(P_KILL_MSG, "Jetz issa weg!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(1, 100,
     "  Der Xorn wuehlt in Deinen Taschen.\n",
     "  Der Xorn wuehlt in @WESSEN Taschen.\n",
     DT_ACID, "spell_moneydestruct", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 400,
      "  Der Xorn beisst Dich!\n",
      "  Der Xorn beisst @WEN!\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(1, 300,
      "  Der Xorn versucht in Deinen Taschen herumzuwuehlen.\n",
      "  Der Xorn versucht in @WESSEN Taschen herumzuwuehlen.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );

  SUID;
}
