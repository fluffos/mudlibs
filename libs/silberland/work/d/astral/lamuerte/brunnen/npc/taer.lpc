#include "../def.h"

inherit NPC "std_well_npc";

#include <npcmaster.h>

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein braunes, affenartiges Wesen funkelt Dich boesartig an");
  SetProp(P_LONG, 
      "Du siehst ein braunes, etwa eineinhalb Meter grosses, "
      "affenartiges Wesen vor Dir. Seine Augen funkeln "
      "in tiefstem Rot. Es scheint, als ob es nicht sehr freundlich ist, "
      "aber von selbst angreifen wuerde es Dich nicht. "
      "Das Wesen hat ein zotteliges, sehr ungepflegt aussehendes Fell und "
      "seine Arme reichen bis an den Boden. Es gehoert "
      "zu der Rasse der Gnome, obwohl es nicht wirklich wie ein echter Gnom aussieht.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Taer");
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 140+random(20));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_GENDER, NEUTER);
  AddId(({"\nbrunnenpc","taer","wesen","gnom"}));
  create_default_npc(15);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit sein langen Haenden",165, ({DT_BLUDGEON, DT_TERROR})})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0,       DT_BLUDGEON    :0,       DT_PIERCE     :0,
    DT_SQUEEZE    :0,       DT_WHIP        :0,       DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :0,       DT_WATER      :-0.2,    
    DT_AIR        :0,       DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :-0.2,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "huepft kreischend herein");
  SetProp(P_MSGOUT, "schwingt sich mit sieben langen Armen");

  SetProp(P_DIE_MSG, " stirbt elendiglich vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich will Racheeeeeeeeeee, %s!");
  SetProp(P_KILL_NAME, "Ein Taer");
  SetProp(P_KILL_MSG, "Jetzt hab ich miech endlich einmal geraecht!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Das Taer wirbelt seine langen Haende in der Luft herum.\n",
    "Die roten Augen des Taer funkeln Dich an.\n",
    "Das Taer huepft im Kreis herum.\n",
  }) );

  AddSpell(9, 220+random(30),
     "  Der Taer beisst Dir in den Fuss.\n",
     "  Der Taer beisst @WEN.\n",
     DT_RIP,  ([SP_SHOW_DAMAGE:1]) );

  SUID;
}

