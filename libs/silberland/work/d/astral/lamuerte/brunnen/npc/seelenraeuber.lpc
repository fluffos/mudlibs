// ~(w) Lamuerte 2001
// ~Seelenraeuber / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/seelenraeuber.c
// ~Level:  40-45
// ~Hands:  255,DT_PIERCE   WC: default AC: default 
// ~R.Str:  SLASH:-0.2,BLUDGEON:-0.2,PIERCE:0.3,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Saugt Mana ab, sprachfluch

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

#include "./spells.h"

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 
      "Ein Seelenraeuber steht in seiner schattenhaften Form vor "
      "Dir. Er kann sich sehr gut an seine "
      "Umgebung anpassen, deshalb sieht man ihn auch sehr schwer. "
      "Die Seelenraeuber besitzen die Macht, "
      "sich magische Energie von ihren Gegnern abzusaugen, was schon "
      "so manchen Abenteurer sein Leben gekostet "
      "hat. Die Augen des Seelenraeubers funkeln tiefblau und warten "
      "nur daruf, Dich auszusaugen und zu vernichten.");
  SetProp (P_MNPC_WAIT, ({6, 10, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Seelenraeuber");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 195+random(33));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","seelenraeuber","raeuber"}));
  create_default_npc(30+(to_int(well_level())));
  SetProp(P_ALIGN, -420);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit seinem spitzen Krallen",
        260+to_int((to_int(well_level())*to_int(well_level())*2)),DT_PIERCE}));
  SetProp(P_SPELLRATE,(25+(to_int(well_level())*3)));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.2,    DT_BLUDGEON    :-0.2,    DT_PIERCE     :0.3,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0.1,
    DT_FIRE       :0,       DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");

  SetProp(P_DIE_MSG, " stirbt vor Deinen Augen.\n");
  SetProp(P_KILL_MSG, "Und wieder gehoert mir eine Seele mehr!");
  SetProp(P_MURDER_MSG, "Aber das naechste Mal stehle ich Deine Seele, %s?");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");


  AddDefaultSpell(1,300, DS_MASS_BLIND,
      "Ploetzlich kannst Du nichts mehr sehen!\n",
      "Ploetzlich kannst Du nichts mehr sehen!\n", 
      3);
  AddSpell(1, 200+(to_int(well_level())*to_int(well_level())*5),
       "  Der Seelenraeuber saugt Dir magische Energie ab.\n",
       "  Der Seelenraeuber saugt @WEM magische Energie ab.\n",
       DT_MAGIC, "spell_manadrain", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 200+(to_int(well_level())*to_int(well_level())*3),
       "  Der Seelenraeuber reisst Dir einen Teil Deiner Seele heraus.\n",
       "  Der Seelenraeuber reisst @WEM einen Teil der Seele heraus.\n",
       DT_MIND, "spell_backspeech", ([SP_SHOW_DAMAGE:1]));

  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(7, ({
    "Du siehst kurz die Umrisse eines Wesen bevor es wieder mit seiner Umgebung\nverschmilzt.\n",
    "Du hoerst das Scharren von spitzen Krallen am Boden.\n",
    "Eine finstere Macht greift nach Deiner Seele.\n",
    "Du spuerst die Anwesenheit eines unsichtbaren Wesens.\n",
    "Irgendwas ist unheimlich hier. Deine Nackenhaare stellen sich auf.\n",
    "Etwas versucht, Dir die Seele aus dem Herzen zu reissen.\n",
    "Zwei tiefblaue Augen funkeln Dich boesartig an.\n",
    "Dein Herz krampft sich zusammen.\n",
    "Du spuerst einen schmerzhaften Stich in Deiner Seele.\n",
  }) );

  SUID;
}


varargs int move(mixed dest, int method, string dir, string textout, string textin)
{
  int r;
  SetProp(P_INVIS, 1);
  r=::move(dest, method, dir, textout, textin);
  SetProp(P_INVIS, 0);
  return r;
}

string short()
{ 
  if (InFight())
    return "Der Seelenraeuber trachtet Dir nach der Seele.\n";
  else
    return 0;
}

