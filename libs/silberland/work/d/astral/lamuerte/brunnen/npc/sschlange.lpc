// ~(w) Lamuerte 2000
// ~Stachelschlange / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/sporenpilz.c
// ~Level:  13-16
// ~Hands:  175,DT_POISON   WC: default AC: default 
// ~Spells: (Rate: 1) Vergiftet seine Gegner mit 1+random(2)
// ~R.Str:  SLASH:-0.3,BLUDGEON:-0.3,PIERCE:-0.3,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:-0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0.3,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:-1,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Eine Stachelschlange schlaengelt sich ueber den Boden");
  SetProp(P_LONG, 
      "Eine drei Meter lange Stachelschlange schlaengelt sich "
      "vor Dir am Boden herum. Diese Tiere sind "
      "mit vielen, kleinen aber sehr spitzen Stacheln uebersaeht. "
      "Jeder einzelne dieser Stachel ist mit einer "
      "hochkonzentrierten giftigen Fluessigkeit ueberzogen. "
      "Im Kampf setzen diese Biester ihr Gift so perfekt "
      "ein, das es beinahe unmoeglich ist, nicht vergiftet zu "
      "werden, wenn man gegen sie kaempft.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Stachelschlange");
  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 10+random(6));
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nbrunnenpc","schlange","stachelschlange"}));
  create_default_npc(17+random(4));
  SetProp(P_ALIGN, -10);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit ihren giftigen Stacheln",175, ({ DT_PIERCE, DT_POISON})})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.3,    DT_BLUDGEON    :-0.3,    DT_PIERCE     :-0.3,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :-0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :-0.3,    DT_EXPLOSION  :0.3, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :-1,      DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "schlaengelt sich herein");
  SetProp(P_MSGOUT, "schlaengelt sich");

  SetProp(P_DIE_MSG, " verpufft vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Aber vergiftet hab ich Dich, %s!");
  SetProp(P_KILL_NAME, "Eine Stachelschlange");
  SetProp(P_KILL_MSG, "Ah, Rache tut gut!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Die Stachelschlange schlaengelt sich im Kreis herum.\n",
    "Die Stachelschlange stellt ihre giftigen Stacheln auf.\n",
    "Die Stachelschlange bereitet sich auf einen Angriff vor.\n",
  }) );

  AddDefaultSpell(1,200,DS_MASS_POISON,
      "Die Stachelschlange verspritzt ihr Gift in alle Richtungen.\n",
      "Die Stachelschlange verspritzt ihr Gift in alle Richtungen.\n",
      1);
  
  AddSpell(4, 300,
     "  Die Stachelschlange versucht Dich zu vergiften!\n",
     "  Die Stachelschlange vergiftet @WEN.\n",
     DT_POISON, "spell_poison", ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 500,
     "  Die Stachelschlange wickelt sich um Deinen Fuss!\n",
     "  Die Stachelschlange wickelt sich um @WESSEN Fuss!\n",
     DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
  
  SUID;
}

