// ~Schimmelwesen / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/schimmelpilz.c
// ~Level:  20-25 
// ~Hands:  185,DT_RIP  WC: default AC: default 
// ~Spells: (Rate: 9  20+random(230) DT_AIR Spell
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:-0.3,WATER-0.3,AIR:-0.3,LIGHTNING:0.3,EXPLOSION:0.3,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Schimmelwesen");
  SetProp(P_LONG, 
      "Ein etwa einen Meter grosses, haarig weiss ueberzogenes Monster steht "
      "vor Dir. Es hat die Form eines Pilzes, jedoch siehst "
      "Du, dass es kleine Haende und Beine besitzt. Seine behaart "
      "aussehende Haut ist mit Schimmelpilzen uebersaeht. "
      "Das Wesen sieht etwas vermodert aus, dennoch macht es einen "
      "nicht allzu schwachen eindruck. An manchen Stellen sieht es "
      "aus, als ob es Brandwunden hat. Ob es feueranfaellig ist?");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Schimmelwesen");
  SetProp(P_RACE, "Pilzwesen");
  SetProp(P_SIZE, 90+random(20));
  SetProp(P_GENDER, NEUTER);
  AddId(({"\nbrunnenpc","pilz","wesen","pilzwesen","schimmelwesen"}));
  create_default_npc(20+random(5));
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen haarigen Haenden",225,DT_RIP})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0.3,     DT_EXPLOSION  :0.3, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "steigt herein");
  SetProp(P_MSGOUT, "steigt");

  SetProp(P_DIE_MSG, " stirbt elendiglich.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Komm nochmal und Deine Leiche wird verschimmeln, %s!");
  SetProp(P_KILL_NAME, "Ein Schimmelwesen");
  SetProp(P_KILL_MSG, "Hehe, einer weniger.");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(1, 300+random(230),
     "  Das Schimmelwesen wuergt Dich. Dir geht Die Luft dabei beinahe aus.\n",
     "  Das Schimmelwesen erwuergt @WEN beinahe.\n",
     DT_AIR,  ([SP_SHOW_DAMAGE:1]) );

  SUID;
}


int Defend(int dam, mixed dtype, int spell, object enemy){
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1){
    if(random(100)>70) tell_room(environment(), "  Das Schimmelwesen zuckt zusammen.\n");
    this_object()->AddHp(dam);
    return ::Defend(0, dtype, spell, enemy);
  }
 return ::Defend(dam, dtype, spell, enemy);
}
