// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/terrordaemon.c
// ~Level:  32-34 
// ~Hands:  250,DT_TERROR  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.5,COLD:-0.5,WATER:-0.5,AIR:0.3,LIGHTNING:-0.5,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0.3,POISON:0,TERROR:-0.3,HOLY:0,UNHOLY:0,MAGIC:-0.3
// ~Special: fear, mass_fear 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Ein Terrordaemon");
  SetProp(P_LONG, 
      "Der Terrordaemon ist so furchterregend anzuschauen, dass Du eigentlich "
      "gar nicht sagen kannst, wie er aussieht. Du weisst nur, dass Du am "
      "liebsten sofort vor dem Terrordaemon fliehen moechtest.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({70, 70, 30}));

  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Terrordaemon");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 190+random(50));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","terrordaemon", "daemon"}));
  create_default_npc(40+random(3));
  SetProp(P_ALIGN, -790);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit namenlosem Schrecken", 450, ({DT_BLUDGEON,DT_TERROR})})); 
  SetProp(P_SPELLRATE, -30 + to_int(well_level()) * to_int(well_level()));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0.2,     DT_COLD        :-0.5,    DT_WATER      :-0.3,    
    DT_AIR        :-0.5,    DT_LIGHTNING   :-0.1,    DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0.5,     DT_ELECTRIC   :0,    
    DT_ACID       :0.3,     DT_POISON      :0,       DT_TERROR     :-1,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :-0.3]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "verbreitet hier Angst und Schrecken");
  SetProp(P_MSGOUT, "verbreitet Angst und Schrecken");

  SetProp(P_DIE_MSG, " stirbt mit angstvollem Gewimmer.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Angst und Schrecken eines Terrordaemons");
  SetProp(P_KILL_MSG, ({"Wer fuerchtet sich vorm schwarzen Mann?", MSG_SAY, PLURAL}) );
  SetProp(P_MURDER_MSG, "Trotzdem hast Du noch immer Angst vor mir, %s!"); 

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(1,1700, 
      "Der Terrordaemon terrorisiert Dich zu Tode.\n",
      "Der Terrordaemon terrorisiert @WEN zu Tode.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(15,700, 
      "Der Terrordaemon terrorisiert Dich.\n",
      "Der Terrordaemon terrorisiert @WEN.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(5,500, DS_FEAR,
      "Der Terrordaemon terrorisiert Dich.\n"
      "Du haeltst es nicht mehr aus und fluechtest.\n",
      "Der Terrordaemon terrorisiert @WEN.\n");
  AddDefaultSpell(1,400, DS_MASS_FEAR,
      "Der Terrordaemon terrorisiert Dich und Du suchst Dein Heil in der Flucht.\n"
      "Der Terrordaemon terrorisiert Dich und Du suchst Dein Heil in der Flucht.\n");
  
  SUID;
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{ 
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_TERROR ) != -1){
    if(random(100)>40)
      tell_room(environment(), "  Der Terrordaemon lacht Dich aus.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  return ::Defend(dam, dtype, spell, enemy);
}

