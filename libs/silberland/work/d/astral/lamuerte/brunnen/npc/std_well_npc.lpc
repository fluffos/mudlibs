inherit "std/mnpc";

#include "../def.h" 
#define STD_WELL_NPC 1
#include "./functions.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Brunnennpcs!");
    destruct();
    return;
  }
  SetProp(P_MNPC_AREA, ROOMS "level"+well_level()+"/");
  SetProp(P_MNPC_DEFAULTROOM,
      file_name(living(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_BACKWARDS + 
                        MOV_MOVES + MOV_MAYLOAD + MOV_INCHAT);
  SetProp(P_MNPC_ACTIVE_TIME, 600);
  SetProp(P_HP_DELAY, 3-to_int(well_level())/3 );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:100]) );
  SUID;
}

varargs void create_default_npc(int level, int hp)
{
  if( hp )
    ::create_default_npc(level, hp);
  else
    ::create_default_npc(level);
  SetProp(P_XP, QueryProp(P_XP) * 11 / 10); // 10% XP-Bonus
  SetProp(P_HEAL, QueryProp(P_LEVEL) * (5 + to_int(well_level()) / 3) );
}

