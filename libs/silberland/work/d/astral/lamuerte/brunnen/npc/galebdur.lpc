// ~Galebdur / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/galebdur.c
// ~Level:  25 + Well Level / 2 
// ~Hands:  205,DT_BLUDGEON  WC: default AC: default 
// ~R.Str:  SLASH:-0.3,BLUDGEON:-0.3,PIERCE:-0.3,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.3,COLD:-0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Zaubert sich im Kampf Hilfsmonster herbei. heilt diese. heilt sich selbst durch feuer attacke.

#include "../def.h"

inherit NPC "std_well_npc";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Galebdur");
  SetProp(P_LONG, 
      "Vor Dir steht ein ueber zwei Meter grosser steinerner Galebdur. Diese "
      "Golemabart besitzt sogar die Faehigkeit kleine Hilfsmonster "
      "herbeizuzaubern, welche ihm im Kampf gegen seine Gegner hilft. Die "
      "Galebdur sind sehr boesartig und vernichten ihre Gegner meisst sehr "
      "schnell. Hoffentlich erwischt Dich dieser Galeb nicht.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
        
  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Galebdur");
  SetProp(P_RACE, "Golem");
  SetProp(P_SIZE, 250+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","galeb","galebdur"}));
  create_default_npc(25+(to_int(well_level())/2));
  SetProp(P_ALIGN, 180);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({"  mit seinen steinernen Haenden",280+(to_int(well_level())*to_int(well_level())),DT_BLUDGEON}));
  SetProp(P_SPELLRATE,(60+random((to_int(well_level())*3))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.3,    DT_BLUDGEON    :-0.3,    DT_PIERCE     :-0.3,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");

  SetProp(P_DIE_MSG, " zefaellt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Komm nochmal %s, meine Boulder werden Dich vernichten!");
  SetProp(P_KILL_NAME, "Ein Galebdur");
  SetProp(P_KILL_MSG, "Ihr Irren, dachtet ihr wirklich ihr koennt mich besiegen?!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

     
  AddSpell(3,1,
        "  Der Galebdur spricht magische Worte.\n", 
        "  Der Galebdur spricht magische Worte.\n", 
        DT_MIND, "do_bheal");
        
  AddSpell(1, 1,
         "  Der Galebdur versucht einen Boulder herbeizuzaubern.\n",
         "  Der Galebdur versucht einen Boulder herbeizuzaubern.\n",
         DT_MIND, "do_spawn");

    SUID;

}


int do_bheal() {
  object *inv;
  int i;

  inv=filter_array(all_inventory(environment(this_object())), #'living );
      for(i=sizeof(inv)-1;i>=0;i--) 
          {
             if(member_array("boulder",inv[i]->QueryProp(P_IDS))!=-1 )
             {
              if(inv[i]->QueryProp(P_HP) < inv[i]->QueryProp(P_MAX_HP) ) {
                tell_room(environment(),"  Der Galebdur heilt einen Boulder.\n");
                inv[i]->AddHp(random(20)+39);
              } 
          }
          }
  return 1;
}

int do_spawn() {

  if(!present("boulder 5")){
  clone_object(NPC "boulder")->move(environment(),M_GO);
  }
  else
  {
  tell_room(environment(),"  Der Zauberspruch des Galebdur geht daneben.\n");
  }
  return 1;
}


