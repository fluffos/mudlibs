// ~(w) Lamuerte 2001
// ~Beholder / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/basilisk.c
// ~Level:  28+well leve 28+well level 
// ~Hands:  85,DT_PIERCE   WC: default AC: default 
// ~R.Str:  SLASH:0.2,BLUDGEON:0.2,PIERCE:0.2,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Speedwalk / Paralyze

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein kleines, reptilienartiges Wesen schaut Dich angriffslustig an");
  SetProp(P_LONG, 
      "Du siehst ein kleines etwa 40cm langes Tier vor Dir am Boden. "
      "Es hat acht Fuesse, wobei jeder aus fuenf langen Krallen besteht. "
      "Seine Augen leuchten knall orange und stechen somit ziemlich " 
      "vom Rest des gruenen Koerpers hervor. Die aus Knorpeln bestehende "
      "Maehne auf seinem Ruecken zeugt von seiner reptilartigen Herkunft. "
      "Dieses kleine Wesen ist sehr flink und kaum zu erwischen. Es ist " 
      "zwar nicht immer in Angriffslaune, aber wenn doch, huete Dich vor ihm.");
  SetProp (P_MNPC_WAIT, ({30, 5, 10}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.3+0.07*to_int(well_level()));
  SetProp(P_NAME, "Basilisk");
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 35+random(10));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","basilisk"}));
  create_default_npc(28+(to_int(well_level())/1));
  SetProp(P_ALIGN, 70);
  SetProp(P_MAX_HANDS, 8); 
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen",280+(to_int(well_level())*to_int(well_level())),DT_PIERCE})); 
  SetProp(P_SPELLRATE,(20+random((to_int(well_level())*4))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0.2,     DT_BLUDGEON    :0.2,     DT_PIERCE     :0.2,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,95);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");

  SetProp(P_DIE_MSG, " verreckt vor Deinen Augen.\n");
  SetProp(P_MURDER_MSG, "Wie konntest Du nur meiner Paralyse entkommen, %s?");
  SetProp(P_KILL_NAME, "Der versteinernde Blick eines Basilisken");

  SetProp( P_REJECT, REJECT_KEEP);

  AddDefaultSpell(3,300,DS_PARALYZE,
       "  Der Basilisk paralysiert Dich.\n",
       "  Der Basilisk paralysiert @WEN.\n");
  AddSpell(1,500,
       "  Der Basilisk paralysiert Dich nicht.\n",
       "  Der Basilisk paralysiert @WEN nicht.\n",
       DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  SUID;
}
