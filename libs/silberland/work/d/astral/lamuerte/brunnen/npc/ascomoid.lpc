// ~(w) Lamuerte 2000
// ~Ascomoid / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/ascomoid.c
// ~Level:  Base 20 + welllevel / 2
// ~Hands:  185,DT_BLUDGEON  WC: default AC: default 
// ~Spells: (Rate: 9, 20+random(230)) DT_FIRE Spell
// ~        (Rate: 9, 20+random(230)) DT_AIR Spell
// ~        (Rate: 9, 20+random(230)) DT_WATER Spell
// ~        (Rate: 1, Vergiftet seine Gegner mit 1+random(2)
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:Heilt sich durch Feuerattacken.

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"


void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein grosses, rundes Pilzwesen rollt hier herum");
  SetProp(P_LONG, 
      "Vor Dir waechst eine kugelfoermige Anhaeufung von Schmarotzerpilzen, "
      "welche sich Ascomoid nennt. Es handelt sich hierbei um ein Pilzwesen, "
      "welches sich aus mehreren einzelnen Teilen von andern Pilzwesen "
      "zusammensetzt, und dadurch die Faehigkeiten der verschiedenen Wesen "
      "in sich vereinen kann. Deswegen sind diese Wesen unter den Abenteurern "
      "auch nicht sonderlich beliebt. ");
  //SetProp(P_ARTICLE,0);

  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
        
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Ascomoid");
  SetProp(P_RACE, "Pilzwesen");
  SetProp(P_SIZE, 80+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","pilz","wesen","pilzwesen","ascomoid"}));
  create_default_npc(20+(to_int(well_level())/2));
  SetProp(P_ALIGN, 180);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem kugelfoermigen Koerper",
        200+(to_int(well_level())*to_int(well_level())),DT_BLUDGEON}));
  SetProp(P_SPELLRATE,(30+random((to_int(well_level())*3))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "rollt herein");
  SetProp(P_MSGOUT, "rollt");

  SetProp(P_DIE_MSG, " verreckt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Komm nochmal %s und ich zeig Dir was ich drauf hab!");
  SetProp(P_KILL_NAME, "Ein Ascomoid");
  SetProp(P_KILL_MSG, "Hehe, einer weniger.");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(9, 200+random(230),
     "  Der Ascomoid wuergt Dich. Dir geht Die Luft dabei beinahe aus.\n",
     "  Der Ascomoid erwuergt @WEN beinahe.\n",
     DT_AIR,  ([SP_SHOW_DAMAGE:1]) );

  AddSpell(7, 300+(to_int(well_level())*to_int(well_level())*3),
     "  Du verbrennst Dich an der Haut des Ascomoiden.\n",
     "  Der Ascomoid verbrennt @WEN.\n",
     DT_FIRE,  ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 300,
     "  Du vergiftest Dich an dem Ascomoid als Du seine Haut beruehrst!\n",
     "  Der Ascomoid vergiftet @WEN.\n",
     DT_POISON, "spell_poison", ([SP_SHOW_DAMAGE:1]));

  AddSpell(5, 320+random(230),
     "  Der Ascomoid versucht Dich zu ersaeufen.\n",
     "  Der Ascomoid ersaeuft @WEN.\n",
     DT_WATER, ([SP_SHOW_DAMAGE:1]) );

  SUID;
}

Defend(int dam, mixed dtype, int spell, object enemy){
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_POISON ) != -1){
    if(random(100)>70) tell_room(environment(), "  Der Ascomoid saugt sich mit Energie an.\n");
    this_object()->AddHp(dam);
    return ::Defend(0, dtype, spell, enemy);
  }
 return ::Defend(dam, dtype, spell, enemy);
}

