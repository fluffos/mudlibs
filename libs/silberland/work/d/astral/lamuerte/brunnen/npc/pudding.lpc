// ~Pudding / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/pudding.c
// ~Level:  13-18 
// ~Hands:  185,DT_SQUEEZE WC: default AC: default 
// ~Spells: (Rate: 2) Kann Schild vom Gegner vernichten, wenn P_WORN
// ~        (Rate: 9) 50+random(200) DT_AIR Spell.
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:-0.4,WHIP:0,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:0,AIR:0,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"
#include <npcmaster.h>

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein laches, schleimiges Etwas zerrinnt ueber dem Boden");
  SetProp(P_LONG, 
      "Du siehst ein flaches, schleimiges Etwas vor Dir, welches am Boden "
      "zerrinnen zu scheint. Diese unheimliche Kreatur hat keinen wirklichen "
      "Namen, doch unter den erfahrenen Abenteurern wird sie Pudding genannt, "
      "denn sie hat die gleiche Konsistenz wie ein lauwarmer Pudding, welcher "
      "auf den Boden gefallen ist. Doch Vorsicht, manche dieser Wesen "
      "verschlingen Gegenstaende!");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.3);
  SetProp(P_NAME, "Pudding");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 10+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","pudding","wesen","daemon", "etwas"}));
  create_default_npc(13+random(4));
  SetProp(P_NO_SCORE, 1);
  SetProp(P_ALIGN, -120);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seiner ganzen schleimigen Masse",185,DT_SQUEEZE})); 
  SetProp(P_SPELLRATE,75);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.4,    DT_WHIP        :0,       DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0,    
    DT_AIR        :0,       DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "schwabbelt herein");
  SetProp(P_MSGOUT, "schwabbelt");

  SetProp(P_DIE_MSG, " zerrinnt vor Dir.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Naechstes mal schleim ich Dich ein, %s!");
  SetProp(P_KILL_NAME, "Ein Pudding");
  SetProp(P_KILL_MSG, "Ah, endlich hab ich Dich erwischt!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Der Pudding schwabbelt unruhig am Boden herum.\n",
    "Der Pudding verformt sich. Anscheinend geht er in Angriffsposition.\n",
    "Der Pudding spritzt mit einer Fluessigkeit herum.\n"
  }) );

  AddSpell(9, 150+random(200),
     "  Du erstickst beinahe als Dich der Pudding einschleimt.\n",
     "  @WER erstickt beinahe als @PWER von dem Pudding eingeschleimt wird.\n",
     DT_AIR,  ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 100,
     "  Der Pudding versucht Dich vollzuschleimen.\n",
     "  Der Pudding attackiert @WEN.\n",
     DT_ACID, "spell_shielddestruct", ([SP_SHOW_DAMAGE:1]));
  
  SUID;
}

