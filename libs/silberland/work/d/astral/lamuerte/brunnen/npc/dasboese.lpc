#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "DAS BOESE");
  SetProp(P_LONG, 
    "DAS BOESE DRINGT IN DEINEN GEIST EIN UND VERSUCHT DICH ZU VERFUEHREN. "
    "DEIN GEIST SCHAFFT ES GAR NICHT, EIN RICHTIGES BILD VON DIESEM URALTEN "
    "WESEN EINZUFANGEN, SO ABGRUNDTIEF BOESARTIG UND LEBENSVERACHTEND IST ES. "
    "SEIT ANBEGINN DER ZEITEN IST ES DER FEIND UND WIDERSACHER DER GOETTER.");
  SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({150, 60, 180}));

  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, ({"DAS BOESE", "DES BOESEN", "DEM BOESEN", "DAS BOESE"}) );
  set_living_name("theabsolutlyevil");
  SetProp(P_RACE, "Gott");
  SetProp(P_SIZE, 2300);
  SetProp(P_GENDER, NEUTER);
  AddId(({"\nbrunnenpc","boese", "boeses", "boesen", "NOFALLDOWN"}));
  create_default_npc(66, 6666);
  SetProp(P_BODY, 666);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 13); 
  SetProp(P_HANDS, ({" MIT URALTER BOSHEIT", 1666, ({DT_MAGIC, DT_UNHOLY})})); 
  SetProp(P_SPELLRATE, 99);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.3,    DT_BLUDGEON    :-0.3,    DT_PIERCE     :-0.3,
    DT_SQUEEZE    :-0.3,    DT_WHIP        :-0.3,    DT_RIP        :-0.3,
    DT_FIRE       :-0.5,    DT_COLD        :-0.1,    DT_WATER      :-0.5,
    DT_AIR        :-0.7,    DT_LIGHTNING   :-0.6,    DT_EXPLOSION  :-0.5,
    DT_SOUND      :-0.8,    DT_LIGHT       :-0.5,    DT_ELECTRIC   :-0.5,    
    DT_ACID       :-0.7,    DT_POISON      :-0.8,    DT_TERROR     :-0.9,     
    DT_HOLY       :-0.1,    DT_UNHOLY      :-0.6,    DT_MAGIC      :-0.6,
    DT_MIND       :-0.8]) );
 
  SetProp(P_NOMAGIC, 66);

  SetProp(P_MSGIN, "VERBREITET HIER BOESARTIGKEIT");
  SetProp(P_MSGOUT, "VERBREITET BOESARTIGKEIT");

  SetProp(P_DIE_MSG, " WIRD VON DER EIGENEN BOESARTIGKEIT VERSCHLUNGEN.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "NIEMAND IST BOESER ALS ICH!");

  SetProp( P_REJECT, REJECT_DESTRUCT,
      "DAS BOESE VERNICHTET @WEN.\n");
  AddInfo( DEFAULT_INFO,"SAGT: ICH BIN     D A S      B O E S E.\n");

  AddDefaultSpell(1, 1357, DS_MASS_DAMAGE,
      "DAS BOESE VERBREITET SEINE BOESARTIGKEIT.\n",
      "DAS BOESE VERBREITET SEINE BOESARTIGKEIT.\n",
      DT_TERROR);
  AddDefaultSpell(1, 999, DS_MASS_DAMAGE,
      "DAS BOESE VERWANDELT DEN RAUM IN EINEN VULKAN.\n",
      "DAS BOESE VERWANDELT DEN RAUM IN EINEN VULKAN.\n",
      DT_FIRE);
  AddDefaultSpell(1, 999, DS_MASS_DAMAGE,
      "DAS BOESE BESCHWOERT EINEN SCHNEESTURM HERBEI.\n",
      "DAS BOESE BESCHWOERT EINEN SCHNEESTURM HERBEI.\n",
      DT_COLD);
  AddDefaultSpell(1, 1234, DS_MASS_POISON,
      "DAS BOESE VERGIFTET DEINEN GEIST, DEINE SEELE UND DEINEN KOERPER.\n",
      "DAS BOESE VERGIFTET DEINEN GEIST, DEINE SEELE UND DEINEN KOERPER.\n",
      6);
  AddDefaultSpell(1, 1111, DS_MASS_BLIND,
      "DAS BOESE RAUBT DIR DEINEN KLAREN VERSTAND.\n",
      "DAS BOESE RAUBT DIR DEINEN KLAREN VERSTAND.\n",
      30);
  AddDefaultSpell(1, 777, DS_PARALYZE,
      "DAS BOESE PARALYSIERT DICH.\n",
      "DAS BOESE PARALYSIERT @WEN.\n",
      5);
  AddDefaultSpell(1, 888, DS_FROG,
      "DAS BOESE VERFROSCHT DICH.\n",
      "DAS BOESE VERFROSCHT @WEN.\n");
  AddDefaultSpell(1, 666, DS_CURSE_ARMOUR,
      "DAS BOESE VERFLUCHT DICH.\n",
      "DAS BOESE VERFLUCHT @WEN.\n");
  AddDefaultSpell(1, 666, DS_CURSE_WEAPON,
      "DAS BOESE VERFLUCHT DICH.\n",
      "DAS BOESE VERFLUCHT @WEN.\n");
  AddSpell(1, 1666,
      "DAS BOESE SCHLAEGT DIR EINE GEMEINE WUNDE!\n",
      "DAS BOESE SCHLAEGT @WEM EINE GEMEINE WUNDE!\n",
      DT_SLASH, "spell_bloodloss", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 1200,
      "DAS BOESE SAUGT DEINE STAERKE AB!\n",
      "DAS BOESE SAUGT @WESSEN STAERKE AB!\n",
      DT_UNHOLY, "spell_strengthdrain", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 2222,
      "DAS BOESE SAUGT DEINE SEELE AUS!\n",
      "DAS BOESE SAUGT @WESSEN SEELE AUS!\n",
      DT_MAGIC, "spell_manadrain", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 1300,
      "DAS BOESE SAUGT DEINE WEISHEIT AB!\n",
      "DAS BOESE SAUGT @WESSEN WEISHEIT AB!\n",
      DT_MIND, "spell_brainstorm", ([SP_SHOW_DAMAGE:1]));

  SetProp(P_HB, 1);

  SUID;
}

varargs void die( int poisondeath )
{
  if( !IS_LEARNER(this_player()) )
    shout("\n"+break_string("DAS BOESE wurde nach einem glorreichen Kampf "
          "in den tiefsten Tiefen des Brunnens ausgeloescht!",78)+"\n");
  ::die(poisondeath);
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  object diener;

  if (stringp(dtype))
    dtype = ({dtype});
  SetProp(P_SKILL_ATTRIBUTES, 0);
  enemy->SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!interactive(enemy))
    dam /= 3;
  if(!random(20) && !present("dienerdesboesen", environment(this_object())))
  {
    tell_room(environment(),  "DAS BOESE BESCHWOERT EINEN SEINER DIENER HERBEI.\n");
    diener=clone_object(NPC "dienerdesboesen.lpc");
    diener->move(environment(),M_GO);
    if (!random(3))
      AddPursuer(diener);
  }
  if (sizeof(dtype & m_indices(PHYSICAL_DAMAGE_TYPES)))
  {
    if (dam > 1000) dam = 1000;
  }
  else if (dam > 666) dam = 666;
  return ::Defend(dam, dtype, spell, enemy);
}

void Attack(object enemy)
{
  object *enemies;
  if (!query_once_interactive(enemy) && 
      sizeof(enemies = filter_array(PresentEnemies(), #'interactive)))
    enemy = enemies[random(sizeof(enemies))];

  ::Attack(enemy);
}

int _query_align() { return -1000; }

int _query_disable_attack() { return 0; }

int _query_disable_spells() { return 0; }

int _query_wimpy() { return 0; }

int _query_poison() { return 0; }
                                                                         
int _query_frog() { return 0; }

void heart_beat()
{
  ::heart_beat();
  AddHp(1);
}

