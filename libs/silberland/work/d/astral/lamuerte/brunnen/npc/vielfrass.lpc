// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/vielfrass.c
// ~Level:  15-18
// ~Hands:  175,DT_RIP   WC: default AC: default 
// ~R.Str:  SLASH:-0.3,BLUDGEON:-0.3,PIERCE:-0.3,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Vielfrass");
  SetProp(P_LONG, 
      "Ein kleiner Vielfrass steht vor Dir. Seine Besonderheit liegt darin, "
      "dass er alles und jeden auffressen will, egel wie gross sein Gegner "
      "ist und egal wie unterlegen er eigentlich ist. Sein Koerper "
      "ist vergleichbar mit einer Mischung aus einem Wiesel und einer "
      "Wildsau, also lang aber ein unheimlich dicker Bauch. Eigentlich "
      "gehoert er zur Rasse der Daemonen, wenngleich sein Aussehen zum "
      "Laecheln animiert.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Vielfrass");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 45+random(3));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","frass","vielfrass"}));
  create_default_npc(19+random(3));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem tollwuetigen Maul",225,DT_RIP})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.3,    DT_BLUDGEON    :-0.3,    DT_PIERCE     :-0.3,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0.3,     DT_COLD        :-0.3,    DT_WATER      :-0.5,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "laeuft hungrig herein");
  SetProp(P_MSGOUT, "sabbert");

  SetProp(P_DIE_MSG, " krepiert vor Deinen Augen.\n");
  SetProp(P_MURDER_MSG, "Wehe Du frisst meine Leiche, %s!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetAttackChats(5, ({
    "Der Vielfrass bruellt: Ich Dir FRESSENNNNNN!!!.\n",
    "Der Vielfrass zeigt Dir seine ekelhaften Zaehne.\n",
    "Der Vielfrass bruellt: Ganze SL ich wolle FRESSE!!!.\n",
  }) );

  AddSpell(1, 500,
      "Der Vielfrass versucht, Dich aufzufressen.\n",
      "Der Vielfrass versucht, @WEN aufzufressen.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]) );
  
  SUID;
}

