// ~Pyrohydra / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/pyrohydra.c
// ~Level:  30-32 
// ~Hands:  405,DT_BLUDGEON  WC: default AC: default 
// ~Spells: (Rate: 1, Steckt Gegner mit Malaria an
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-1,COLD:0.3,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:AreaDamage Fire, Heals when attacked with Fire

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

string *heads=({"kopflose","einkoepfige","zweikoepfige","dreikoepfige"});
int numbheads,curhp;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  numbheads=3;

  SetProp(P_SHORT, "Eine "+heads[numbheads]+" Pyrohydra");
  SetProp(P_LONG, 
      "Du siehst eine riesige Pyrohydra vor Dir. Ihre Koerperoberflaeche "
      "besteht aus vielen roten Schuppen und sie ist mindestens so gross "
      "wie ein Drache. Diese Form der Hydra hat gefaehrliche Koepfe, "
      "welche von der Form her an Echsen erinnern. Aus den Nuestern quallmt "
      "stinkender Schwefeldampf heraus, welcher nur die Vorwarnung von ihren "
      "Flammenattacken ist.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({40, 70, 20}));
  
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Pyrohydra");
  SetProp(P_RACE, "Drache");
  SetProp(P_SIZE, 490+random(20));
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nbrunnenpc","hydra","pyrohydra"}));
  create_default_npc(30+random(3));
  SetProp(P_ALIGN, -890);
  SetProp(P_MAX_HANDS, 3); 
  SetProp(P_HANDS, ({" mit einem ihrer feurigen Koepfe",355,({DT_BLUDGEON,DT_FIRE})})); 
  SetProp(P_SPELLRATE,20);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-1,      DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");

  SetProp(P_DIE_MSG, " erlischt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Naechstes mal verbrenne ich euch Alle!");
  SetProp(P_KILL_NAME, "Eine Pyrohydra");
  SetProp(P_KILL_MSG, "Jetz issa verbrannt!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");


  AddDefaultSpell(1, 500, DS_MASS_DAMAGE, 
      "  Die Pyrohydra blaest einen heissen Flammenstrahl durch den ganzen Raum.\n",
      "  Die Pyrohydra blaest einen heissen Flammenstrahl durch den ganzen Raum.\n",
      DT_FIRE );

  curhp=this_object()->QueryProp(P_MAX_HP);
  SUID;
}

void Attack(object enemy) {
  SetProp(P_SKILL_ATTRIBUTES, 0);
  ModifySkillAttribute(this_object(), SA_SPEED, ((random(numbheads)+1)*100), 2);
  ::Attack(enemy);
}


Defend(int dam, string dam_type, mixed spell, object enemy)
{ 
  object ob;
  int which,damdone;

  if (!pointerp(dam_type)) dam_type = ({ dam_type });

  if((this_object()->QueryProp(P_HP)<=((curhp/3)*2) || random(1999)==512) && numbheads > 0)
  {
    tell_room(environment(),
        "  ** Ein Kopf der Hydra stirbt erbaermlich und knallt auf den Boden. **\n");
    numbheads--;
    curhp=this_object()->QueryProp(P_HP);
    SetProp(P_SHORT, "Eine "+heads[numbheads]+" Pyrohydra");
    clone_object(OBJ "hydrahead")->move(environment(),M_NOCHECK);
   return ::Defend(dam, dam_type, spell, enemy);
  }

  if (member( dam_type, DT_FIRE ) != -1 && numbheads < 3){
    tell_room(environment(), "  ** Die Pyrohydra wird von "+
                             "feuriger Energie durchdrungen! **\n "+
                             "** Die Koepfe der Pyrohydra sind komplett regeneriert! **\n");
    numbheads=3;
    SetProp(P_SHORT, "Eine "+heads[numbheads]+" Pyrohydra");
    SetProp(P_HP,QueryProp(P_MAX_HP));
    curhp=this_object()->QueryProp(P_MAX_HP);
    return ::Defend(dam, dam_type, spell, enemy);
  }

  return ::Defend(dam, dam_type, spell, enemy);
}

