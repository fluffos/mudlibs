// ~(w) Lamuerte 2000-2001
// ~Der Eingang zum Brunnen

inherit "std/mnpc";

#include "../vt100.h"
#include "../def.h"

void do_random_move();

void create()
{
  if (is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT,"Der Eingang zum Brunnen"); 
  SetProp(P_LONG, 
      "Du musst schon sehr genau hinsehen, um die Konturen des Brunnens zu "
      "erkennen, der sich hier befindet. Seine Umrisse sind leicht "
      "verschwommen; Du koenntest schwoeren, dass er normalerweise nicht hier "
      "ist. Aus der Brunnenoeffnung, die in eine duesteren Finsternis "
      "fuehrt, meinst Du leise Schreie zu vernehmen. Dich froestelt leicht "
      "bei dem Gedanken was sich da unten verbirgt...");

  AddDetail ( ({ "konturen", "umrisse" }),
     "Die Konturen des Brunnens sind leicht verschwommen. Du kannst sie "
     "irgendwie nicht klar erkennen, sie entziehen sich staendig auf "
     "eine befremdliche Weise Deinem Blick.");
  AddDetail( ({ "oeffnung", "brunnenoeffnung" }),
    "Die Brunnenoeffnung liegt wie ein grosses dunkles Maul vor Dir. "
    "Von weiter unten meinst Du leise Schreie zu vernehmen.");

  AddDetail ( ({"finternis"}),
    "Die Finsternis ist undurchdringbar. Du kannst nichts genaueres "
    "erkennen bis auf ein paar Schatten.");
  AddDetail( ({"schatten"}),
    "Zu bemerkst einige huschende Schatten in der Finsternis. Was immer "
    "das auch ist - es ist hoellisch schnell.");
  SetProp(P_SOUND, 
      "Du glaubst leise Schreie aus dem Brunnen zu vernehmen.");
  
 
  SetProp(P_MNPC_AREA, "/d/");
  SetProp(P_MNPC_WAIT, ({20, 30, 120}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/feyaria/sumpf/room/turm");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES);
  SetProp(P_MNPC_ACTIVE_TIME, 3600);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:100]) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Eingang");
  SetProp(P_RACE, "Gegenstand");
  SetProp(P_MATERIAL, ([MAT_MAGIC:50, MAT_WOOD:25, MAT_WATER:25]) );
  SetProp(P_SIZE, 80);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunneneingang","eingang","brunneneingang", "brunnen",
        "eingang zum brunnen", "\nwellentrancenpc", "wellentrancenpc",
        "NOT_LIVING"}));
  create_default_npc(50);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0); 

  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschiebt sich");

  SetProp(P_NOATTACK, "ist ein Objekt welches man nicht toeten kann.");
  
  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ist eine tote Materie.");

  AddCmd(({"betrete","gehe","geh","huepf","spring","kletter","klettere"}), "go_welling");
  
  set_living_name("wellentrancenpc");
 
  do_random_move();
  seteuid(getuid(this_object()));
}

string short()
{
  if(!this_player())  
    return "Der Eingang zum Brunnen, Du koenntest schwoeren, dass er "
      "normalerweise nicht hier ist.\n";
 
    switch(this_player()->QueryProp(P_TTY))
    {
      case "ansi": 
        return VT_TA_B+VT_MAGENTA+"Der Eingang zum Brunnen"+VT_NORMAL+", Du "
               "koenntest schwoeren, dass er normalerweise nicht hier ist.\n"; 
      case "dumb":
        return "Der Eingang zum Brunnen, Du koenntest schwoeren, dass er "
               "normalerweise nicht hier ist.\n";
      case "vt100": 
        return VT_TA_B+"Der Eingang zum Brunnen"+VT_NORMAL+", Du "
               "koenntest schwoeren, dass er normalerweise nicht hier ist.\n";
    }

}

string long()
{
 return break_string("Das ist er, der Eingang zum Brunnen. Du koenntest "
     "schwoeren, dass er normalerweise nicht hier ist. "
     "Wasser scheint man aus diesem Brunnen nicht bekommen zu koennen, "
     "sicher hat er einen anderen Sinn. Ob es wohl der Eingang zu einem "
     "unterirdischen Reich ist? Nur wenn Du mutig genug bist, wirst Du es "
     "herausfinden. Was Dich wohl erwartet, wenn Du diesen Brunnen betrittst?"
     ,78);
}


int go_welling(string wohin)
{
  object ob;
  string msg;
  int i;

  notify_fail("Wohin denn?\n");
  if(!wohin)
  {
    return 0;
  }

  if(wohin == "brunnen" || wohin == "in brunnen" || wohin == "eingang" || 
      wohin == "in eingang")
  {
//     return tell_object(this_player(),"Noch ist die Zeit fuer Helden noch nicht gekommen.\n"),1;

    if( !IS_SEER(this_player()) || 
        (dtime()[19..20] == "05" && to_int(dtime()[22..23]) < 15))
    {
      tell_object(this_player(),
          "Du traust Dich nicht, diesen gefaehrlichen Ort zu betreten.\n");
      return 1;
    }
    tell_object(this_player(),"Du kletterst in den Brunnen.\n");
    this_player()->move(ROOMS "level1/x1y1.lpc",M_GO, "in den Brunnen", "klettert", 
        "klettert herein");
    msg = VT_TA_B+VT_MAGENTA+"[Brunnen:] "+capitalize(getuid(this_player()))+
      " betritt den Brunnen."+VT_NORMAL+"\n";
    for (i = sizeof(INFORM_WIZ) - 1; i >= 0; i--)
      if( find_player(INFORM_WIZ[i]) )
        tell_object(find_player(INFORM_WIZ[i]), msg);
    if( !IS_LEARNER(this_player()) && !present("\nbrunnencorpseobj", this_player()) ) 
      clone_object(CORPSE "corpseobj")->move(this_player(), M_NOCHECK);

    if( ob = present("\nfragkristall", this_player()) )
      ob->set_modifiers();
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  if( random(2) )
    do_random_move();
}

void do_random_move()
{
  string *rooms;

  rooms=({
      "/d/dschungel/dante/weg/room/weg1",
      "/d/dschungel/feyaria/dorf/room/dorf-010",
      "/d/dschungel/dante/tijaraneu/room/ti_pfad11",
      "/d/dschungel/feyaria/sumpf/room/sumpf11",
      "/d/ebene/lamuerte/burg/mauer/00_09",
      "/d/ebene/lostboy/steppe/room/kneipe",
      "/d/ebene/ronja/feenquest/room/turm29",
      "/d/gebirge/angrox/room/ebene1/bergwerk_r24",
      "/d/gebirge/angrox/room/ebene3/ebene3_r6",
      "/d/gebirge/angrox/4elem/room/stadt/stadt_f9",
      "/d/huegelland/raballion/hobbits/room/laden",
      "/d/huegelland/zordan/fischerweg/room/a6a9",
      "/d/huegelland/zordan/holzfaeller/room/room-a2",
      "/d/huegelland/feyaria/weg/room/huette",
      "/d/kristallwald/sargola/wald/room/0902",
      "/d/kristallwald/sargola/lichtung/room/0404",
      "/d/kristallwald/chivas/zentauren/room/zen50",
      "/d/polar/thor/xandim/room/kneipe",
      "/d/polar/lamuerte/eishoehle/rooms/19631",
      "/d/unterwelt/zordan/dhrkion/room/laden",
      "/d/unterwelt/ronja/sternenwald/room/wr_06_06",
      "/d/unterwelt/ronja/sternenwald/room/th_04_06",
      "/d/unterwelt/basics/central/room/00-07+12",
      "/d/wueste/protheg/kraterrand/room/steg",
      "/d/wueste/arthoas/erg/room/valley/raum27",
      "/d/wueste/protheg/arrakeen/room/ara_1_2_0",
      "/d/wueste/protheg/arrakeen/room/ara_5_5_0",
  });
  catch(this_object()->move(rooms[random(sizeof(rooms))], M_GO));
}

void brunnen_out_msg()
{
  int i;
  string msg;

  msg = VT_TA_B+VT_MAGENTA+"[Brunnen:] "+capitalize(getuid(this_player()))+
    " verlaesst den Brunnen."+VT_NORMAL+"\n";
  for (i = sizeof(INFORM_WIZ) - 1; i >= 0; i--)
    if( find_player(INFORM_WIZ[i]) )
      tell_object(find_player(INFORM_WIZ[i]), msg);
}

void init()
{
  ::init();
  if( this_player() && query_once_interactive(this_player()) &&
      objectp(this_player()->QueryProp(P_LAST_COMMAND_ENV)) &&
      file_name(this_player()->QueryProp(P_LAST_COMMAND_ENV))[0..36] ==
      ROOMS "level" )
    brunnen_out_msg();
}

void catch_tell(string str)
{
  string wer, was;
  if(sscanf(str, "%s teilt Dir mit: %s\n", wer, was)==2) {
    write_file(LOGS "eingang_tells",
        dtime(time())+": "+str);
  }
  return;
}
