// ~Steinfresser / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/steinfresser.c
// ~Level:  20-25
// ~Hands:  150,DT_SQUEEZE   WC: default AC: default 
// ~R.Str:  SLASH:-0.6,BLUDGEON:-0.6,PIERCE:-0.6,SQUEEZE:-0.6,WHIP:-0.6,RIP:-0.6,
// ~        FIRE:-0.3,COLD:-0.3,WATER:-0.3,AIR:0.3,LIGHTNING:-0.3,EXPLOSION:0.3,SOUND:0,
// ~        LIGHT:0,ELECTRIC:-0.3,ACID:0.3,POISON:-0.5,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:-0.5
// ~Special: Fluechtet bei 1/3 MAX_HP

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Steinfresser knabbert hier an den Waenden");
  SetProp(P_LONG, 
      "Ein kleiner Steinfresser steht vor Dir. Er ist ist nicht viel groesser "
      "als ein Zwerg und sieht eigentlich recht amuesant aus mit seinen "
      "grossen steinernen Augen. Eigentlich sind diese Steinfresser recht "
      "harmlos, doch da sie komplett aus Stein bestehen, sind sie mit "
      "herkoemmlichen Waffen sehr schwer zu treffen. Einen Steinfresser zu "
      "besiegen kann sich manchmal als recht langwierige Prozedur "
      "herausstellen.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Steinfresser");
  SetProp(P_RACE, "Golem");
  SetProp(P_SIZE, 60+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","fresser","stein","steinfresser"}));
  create_default_npc(20+random(5));
  SetProp(P_BODY, QueryProp(P_BODY)*2);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem steinernen Faeusten",350,DT_SQUEEZE})); 

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.6,    DT_BLUDGEON    :-0.3,    DT_PIERCE     :-0.7,
    DT_SQUEEZE    :-0.6,    DT_WHIP        :-0.8,    DT_RIP        :-0.6,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :-0.3,    DT_EXPLOSION  :0.3, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :-0.3,    
    DT_ACID       :0.3,     DT_POISON      :-0.5,    DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :-0.5]) );
  
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");

  SetProp(P_DIE_MSG, " zerbroeselt.\n");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");


  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Der Steinfresser stampft mit dem Fuss auf.\n",
    "Der Steinfresser grinst Dich frech an.\n",
    "Der Steinfresser reibt sich die Haende.\n",
  }) );

  SUID;
}

