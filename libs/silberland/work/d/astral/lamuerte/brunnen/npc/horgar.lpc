// ~(w) Lamuerte 2001
// ~Beholder / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/beholder.c
// ~Level:  20+well level*2
// ~Hands:  200,DT_RIP   WC: default AC: default 
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.1,WATER:0.1,AIR:-0.1,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:-0.5,POISON:-0.5,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Eignet sich Waffen des Enemy an, frisst sie mit geringer Wahrscheinlichkeit.

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

#include "./spells.h"

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein grosser Wurm schlaengelt sich durch den Raum");
  SetProp(P_LONG, 
      "Du siehst ein riesiges wurmartiges Gebilde vor Dir, welches ungefaehr "
      "so gross ist wie ein Baum. Der Koerper des Wurms ist ziemlich schleimig, "
      "von brauner Farbe, stinkend und runzelig. Am Kopfende befindet sich "
      "mittig ein einziges grosses Auge und direkt darunter ein Maul mit langen, "
      "metallenen Zaehnen. Diese Kreaturen fressen mit vorliebe Waffen, also "
      "pass auf das es nicht auch Deine Waffe schnappt und auffrisst.");
  SetProp (P_MNPC_WAIT, ({50, 60, 40}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Horgar");
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 245+random(133));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","wurm","horgar"}));
  create_default_npc(20+(to_int(well_level())*2));
  SetProp(P_ALIGN, -70);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen metallenen Zaehnen",200+(2*to_int(well_level())*to_int(well_level())),DT_RIP}));
  SetProp(P_SPELLRATE,(30+random((to_int(well_level())*3))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.1,     DT_WATER      :0.1,    
    DT_AIR        :-0.1,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :-0.5,    DT_POISON      :-0.5,    DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");

  SetProp(P_DIE_MSG, " verendet im Dreck.\n");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");


  AddSpell(2, 200+QueryProp(P_LEVEL)*10,
        "  Der Horgar beisst Dir beinahe einen Arm ab.\n",
        "  Der Horgar beisst @WEM beinahe einen Arm ab.\n",
        DT_RIP, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(2, 300+QueryProp(P_LEVEL)*10,
        "  Der Horgar beisst Dir beinahe einen Fuss ab.\n",
        "  Der Horgar beisst @WEM beinahe einen Fuss ab.\n",
        DT_RIP, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(1,100,
        "  Der Horgar versucht, Dir Deine Waffe zu entreissen.\n",
        "  Der Horgar versucht, sich @WESSEN Waffe zu krallen.\n",
        DT_MAGIC, "spell_weapondestruct", ([SP_SHOW_DAMAGE:1]));

  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Das Auge des Horgar starrt Dich boese an.\n",
    "Der Horgar zeigt Dir seine scharfen Zaehnen.\n",
    "Der Horgar grunzt.\n",
  }) );


  SUID;
}

