// ~Wasserpilz / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/wasserpilz.c
// ~Level:  15-20 
// ~Hands:  185,DT_WATER WC: default AC: default 
// ~Spells: (Rate: 9) 20+random(230) DT_WATER Spell. 
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0.3,COLD:0.3,WATER:-0.7,AIR:0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein durchsichtiges, pilzartiges Wesen waechst hier");
  SetProp(P_LONG, 
      "Ein etwa einen Meter grosses, beinahe dursichtiges Wesen steht vor Dir. "
      "Es hat die Form eines Pilzes, jedoch siehst "
      "Du, dass es kleine Haende und Beine besitzt. Seine glatte Haut sieht aus "
      "als ob man durch einen wassergefuellten "
      "Glasbecher blickt. Hin und wieder kannst scheint es als wuerden "
      "Wassertropfen an seinem Koerper hinablaufen, jedoch "
      "passiert dies viel zu schnell als das man es genauer sehen koennte.");
  //SetProp(P_ARTICLE,0);
  SetProp(P_MNPC_FLAGS, 0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Wasserpilz");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 90+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","pilz","wesen","pilzwesen","wasserpilz"}));
  create_default_npc(15+random(5));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen feuchten Haenden",215,({DT_BLUDGEON,DT_WATER})})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0.3,     DT_COLD        :0.3,     DT_WATER      :-0.7,    
    DT_AIR        :0,       DT_LIGHTNING   :0.2,     DT_EXPLOSION  :0.2, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "fliesst herein");
  SetProp(P_MSGOUT, "fliesst nach");

  SetProp(P_DIE_MSG, " vertrocknet vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das nachste mal ersaeufe ich Dich, %s!");
  SetProp(P_KILL_NAME, "Ein Wasserpilz");
  SetProp(P_KILL_MSG, "Ah, Rache tut gut!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Kleine Wassertropfen laufen ueber den Koerper des Pilzwesens.\n",
    "Das Pilzwesen scheint Wasser zu verlieren.\n",
    "Das Pilzwesen verschwimmt vor Deinen Augen.\n",
  }) );

  AddSpell(9, 300,
     "  Der Wasserpilz versucht Dich zu ersaeufen.\n",
     "  Der Wasserpilz ersaeuft @WEN.\n",
     DT_WATER, ([SP_SHOW_DAMAGE:1]) );

  SUID;
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_WATER ) != -1){
    if(random(100)>40)
      tell_room(environment(), 
          "  Der Wasserpilz wird durch das Wasser nur noch groesser.\n");
    SetProp(P_MAX_HP, QueryProp(P_MAX_HP) + 10);
    this_object()->AddHp(dam);
    return 0;
  }
  return ::Defend(dam, dtype, spell, enemy);
}

