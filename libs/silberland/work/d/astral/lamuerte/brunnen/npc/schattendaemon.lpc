// ~Schattendaemon / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/schattendaemon.c
// ~Level:  32-34 
// ~Hands:  500,DT_SLASH  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.5,COLD:-0.5,WATER:-0.5,AIR:0.3,LIGHTNING:-0.5,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0.3,POISON:0,TERROR:-0.3,HOLY:0,UNHOLY:0,MAGIC:-0.3
// ~Special: 1-4 attacken/runde

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 
      "Eigentlich siehst Du nur einen Schatten an der Wand, aber dies muss einer "
      "dieser gefuerchteten Schattendaemonen sein. Er bewegt sich nahezu "
      "unsichtbar und greift ploetzlich aus dem Hinterhalt an, wenn man sich "
      "gerade ganz sicher fuehlt.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 30, 10}));

  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Schattendaemon");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 120+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","schattendaemon", "daemon"}));
  create_default_npc(35+random(3));
  SetProp(P_ALIGN, -550);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen schattenhaften Kraeften",420,({DT_RIP,DT_UNHOLY})})); 
  SetProp(P_SPELLRATE, 40);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0.2,     DT_COLD        :-0.5,    DT_WATER      :-0.5,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :-0.2,    DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :1,       DT_ELECTRIC   :0,    
    DT_ACID       :-0.3,    DT_POISON      :0,       DT_TERROR     :-0.3,     
    DT_HOLY       :0.1,     DT_UNHOLY      :-0.5,    DT_MAGIC      :-0.3]) );
  
  SetProp(P_NOMAGIC,45);

  SetProp(P_DIE_MSG, " loest sich in Nichts auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Tritt ein in das Reich der Schatten!");
  SetProp(P_MURDER_MSG, "Das naechste Mal zieh ich Dich mit ins Reich der "
      "ewigen Schatten, %s?"); 

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(5,300,
      "Der Schattendaemon huellt Dich in einen tiefen Schatten.\n",
      "Der Schattendaemon huellt @WEN in einen tiefen Schatten.\n",
      DT_UNHOLY, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(3, 400, DS_BLIND,
      "Der Schattendaemon huellt Dich in ewigen Schatten.\n",
      "Der Schattendaemon huellt @WEN in ewigen Schatten.\n",
      20);
  AddDefaultSpell(1, 200, DS_MASS_BLIND,
      "Der Schattendaemon huellt Dich in ewigen Schatten.\n",
      "Der Schattendaemon huellt Dich in ewigen Schatten.\n",
      20);
    
  SetChats(8, ({
    "In Deinen Augenwinkeln nimmst Du eine Bewegung wahr.\n",
    "Du fuehlst Dich beobachtet.\n",
    "Irgendetwas macht ein schlurfendes Geraeusch.\n",
    "Huch? Was war das?\n",
    "Du zaehlst die Schatten und die Personen im Raum, aber irgendwie ist da "
    "ein Schatten\nzuviel. Oder hast Du Dich nur verzaehlt?\n",
    "Du spuerst eine dunkle Bedrohung, die von einem Schatten ausgeht.\n",
    "Da bewegt sich ein Schatten.\n",
    "Etwas verschmilzt mit Deinem Schatten.\n"}) );

  SUID;
}


varargs int move(mixed dest, int method, string dir, string textout, string textin)
{
  int r;
  SetProp(P_INVIS, 1);
  r=::move(dest, method, dir, textout, textin);
  SetProp(P_INVIS, 0);
  return r;
}

string short()
{ 
  if (InFight())
    return "Du kaempfst gegen einen Schatten.\n";
  else
    return 0;
}

