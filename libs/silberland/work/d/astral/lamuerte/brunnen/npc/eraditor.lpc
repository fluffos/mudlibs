// ~kleiner Eraditor / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/pyrohydra.c
// ~Level:  32-34 
// ~Hands:  610,DT_BLUDGEON  WC: default AC: default 
// ~Spells: 
// ~R.Str:  SLASH:-1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-1,COLD:-1,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:AreaDamage Fire, Heals when attacked with Fire/Cold, More attcks/round

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

string *heads=({"kopfloser","einkoepfiger","zweikoepfiger","dreikoepfiger","vierkoepfiger","fuenfkoepfiger","sechskoepfiger","siebenkoepfiger"});
int numbheads,curhp;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  numbheads=7;

  SetProp(P_SHORT, "Ein "+heads[numbheads]+" Eraditor");
  SetProp(P_LONG, 
      "Ein Eraditor baut sich vor Dir auf. Bei diesem Monster handelt es "
      "sich um einen Daemon, welcher sieben Koepfe hat. Er ist nicht viel "
      "groesser als ein kleiner Eraditor, doch viel wiederstandsfaehiger "
      "und nochdazu unter anderem immun gegen Schwertattacken, er hat Schaum "
      "vor seinen Muendern und wartet nur noch darauf, Dich zu verspeisen.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({40, 70, 20}));

  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Eraditor");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 590+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","eraditor"}));
  create_default_npc(38+random(3));
  SetProp(P_ALIGN, -690);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit einem seiner eisigen Koepfe",400,({DT_RIP, DT_COLD})})); 
  SetProp(P_SPELLRATE,20);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-1,      DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-1,      DT_COLD        :-1,      DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "gleitet herein");
  SetProp(P_MSGOUT, "gleitet");

  SetProp(P_DIE_MSG, " stirbt erbaermlich.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Arghhhhhhhhhhh!");
  SetProp(P_KILL_NAME, "Ein Eraditor");
  SetProp(P_KILL_MSG, "Harr Harr Harrrrr!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");


  curhp=this_object()->QueryProp(P_MAX_HP);

  SUID;
}



void Attack(object enemy) {
  SetProp(P_SKILL_ATTRIBUTES, 0);
  ModifySkillAttribute(this_object(), SA_SPEED, ((random(numbheads)+1)*100), 2);
  ::Attack(enemy);
}


Defend(int dam, string dam_type, mixed spell, object enemy)
{ 
  object ob;
  int which,damdone;

  if (!pointerp(dam_type)) dam_type = ({ dam_type });

  if((this_object()->QueryProp(P_HP)<=((curhp/3)*2) || random(1999)==512) && numbheads > 0)
  {
    tell_room(environment(),
        "  ** Ein Kopf des Eraditors faellt ab. **\n");
    numbheads--;
    curhp=this_object()->QueryProp(P_HP);
    SetProp(P_SHORT, "Ein "+heads[numbheads]+" Eraditor");
    clone_object(OBJ "eraditorhead")->move(environment(),M_NOCHECK);
   return ::Defend(dam, dam_type, spell, enemy);
  }

  if (member( dam_type, DT_COLD ) != -1 || member( dam_type, DT_FIRE ) != -1 && numbheads < 7){
    tell_room(environment(), "  ** Der Eraditor wird von "+
                             "eisiger Energie durchdrungen! **\n "+
                             "** Die Koepfe des Eraditors sind komplett regeneriert! **\n");
    numbheads=7;
    SetProp(P_SHORT, "Ein "+heads[numbheads]+" Eraditor");
    SetProp(P_HP,QueryProp(P_MAX_HP));
    curhp=this_object()->QueryProp(P_MAX_HP);
    return ::Defend(dam, dam_type, spell, enemy);
  }

  return ::Defend(dam, dam_type, spell, enemy);
}

