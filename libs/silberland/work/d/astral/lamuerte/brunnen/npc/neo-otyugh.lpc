// ~Neo-Otyugh / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/neo-otyugh.c
// ~Level:  38-43 
// ~Hands:  350,DT_POISON  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.2,BLUDGEON:-0.2,PIERCE:-0.2,SQUEEZE:-0.2,WHIP:-0.2,RIP:-0.2,
// ~        FIRE:-0.4,COLD:-0.4,WATER:-0.4,AIR:0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:-0.3,POISON:0.2,TERROR:-0.3,HOLY:0.1,UNHOLY:-0.5,MAGIC:-0.3
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Eine riesige Muellhalde verbreitet hier ekligen Geruch");
  SetProp(P_LONG, 
  "Jede Menge Geruempel liegt auf dieser gigantischen Muellhalde. Abgebrannte Fackeln, "
  "zerbrochene Schwerter, zerfetzte Kleidung, ein Tentakel mit einem Auge.... "
  "Halt! Das bewegt sich doch etwas in diesem Muellhaufen. Jetzt wird Dir "
  "erst bewusst, dass ueberall kleine Tentakel, Augen, zerfurchte Haut und "
  "eitrige Warzen zwischen dem Muell zu sehen sind. Dass muss ein Neo-Otyugh sein, "
  "eines dieser Muell-sammelden Wesen.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 30, 10}));

  SetProp(P_AGGRESSIVE,0.1*to_int(well_level()));
  SetProp(P_NAME, "Neo-Otyugh");
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 400);
  SetProp(P_GENDER, NEUTER);
  AddId(({"\nbrunnenpc","neo-otyugh", "muellhalde", "muellhaufen"}));
  create_default_npc(38+to_int(well_level())/2);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit Muell",377,({DT_POISON, DT_RIP}) })); 
  SetProp(P_SPELLRATE, 40);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :-0.2,    DT_EXPLOSION  :0.3,
    DT_SOUND      :0,       DT_LIGHT       :-0.3,    DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :-1,      DT_TERROR     :-0.3,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0.3]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "verbreitet hier seinen Gestank");
  SetProp(P_MSGOUT, "verbreitet seinen Gestank");

  SetProp(P_DIE_MSG, " wird von einem Muellberg begraben.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Und wieder ein Stueck mehr auf meinem Muellhaufen!");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(1,800,
      "  Das Neo-Otyugh bewirft Dich mit Muell.\n",
      "  Das Neo-Otyugh bewirft @WEN mit Muell.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1,500, DS_POISON,
      "  Das Neo-Otyugh spritzt Dich mit einer ekligen Fluessigkeit an.\n",
      "  Das Neo-Otyugh spritzt @WEN mit einer ekligen Fluessigkeit an.\n",
      2);
  AddDefaultSpell(1,400, DS_MASS_POISON,
      "  Das Neo-Otyugh spritzt Dich mit einer ekligen Fluessigkeit an.\n",
      "  Das Neo-Otyugh spritzt Dich mit einer ekligen Fluessigkeit an.\n",
      1);
  AddDefaultSpell(1,200, DS_FROG,
      "  Das Neo-Otyugh verfroscht Dich.\n",
      "  Das Neo-Otyugh verfroscht @WEN.\n");

  SetChats(2, ({
        "Es stinkt hier gewaltig.\n",
        }));
  SUID;
}


void init()
{
  ::init();
  command_me("nimm alles");
}

