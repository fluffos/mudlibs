// ~(w) Lamuerte 2001
// ~Hoellenkatze / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/hoellenkatze.c
// ~Level:  Base 15 + welllevel * 2
// ~Hands:  285,DT_BLUDGEON  WC: default AC: default 
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.3,COLD:-0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0.3,POISON:-0.3,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:Extrem Verwundbar durch Wasser, Heilt sich durch Feuerattacken(trocknet?).

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
 
  ::create(); 
  
  SetProp(P_SHORT, "Eine Hoellenkatze");
  SetProp(P_LONG, 
      "Vor Dir steht eine eineinhalb Meter grosse Hoellenkatze. Sie ist eine "
      "Abart eines Daemons. " "Ihr Koerper ist komplett von Feuer eingehuellt. "
      "Ab und an sieht man durch den Feuerschild der Hoellenkatze ihren "
      "eigentlichen Koerper, welcher nur noch aus Knochen, Sehnen und Fleischfetzen "
      "besteht.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.5);
  SetProp(P_NAME, "Hoellenkatze");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 150+random(20));
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nbrunnenpc","wesen","katze","hoellenkatze"}));
  create_default_npc(15+(to_int(well_level())*2));
  SetProp(P_ALIGN, -480);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit ihren feurigen Krallen",150+(2*to_int(well_level())*to_int(well_level())),({DT_RIP,DT_FIRE})})); 
  SetProp(P_SPELLRATE,(10+random((to_int(well_level())*3))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0.3,     DT_POISON      :-0.3,    DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "steigt mit gluehenden Pfoten herein");
  SetProp(P_MSGOUT, "steigt mit gluehenden Pfoten");

  SetProp(P_DIE_MSG, " erlischt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Komm nochmal und ich brenn' Dich weg, %s!");
  SetProp(P_KILL_NAME, "Eine Hoellenkatze");
  SetProp(P_KILL_MSG, "Tod jenen, die keine Hitze aushalten!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");


  AddDefaultSpell(1, 250, DS_MASS_DAMAGE,
          "Die Hoellenkatze wirft einen riesigen Feuerball in den Raum.\n",
          "Ein riesiger Hoellenfeuerball explodiert im Raum!\n", DT_FIRE );
  
    SUID;

}

Defend(int dam, mixed dtype, int spell, object enemy){
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1){
    if(random(100)>40) tell_room(environment(), "  Die Hoellenkatze bekommt eine steinharte Oberflaeche.\n");
    this_object()->AddHp(dam);
    return ::Defend(0, dtype, spell, enemy);
  }

  if (member( dtype, DT_WATER ) != -1){
    if(random(100)>80) {
      tell_room(environment(), "  Die Hoellenkatze schreit laut auf vor Schmerzen!\n");
      return ::Defend((3*dam/2), dtype, spell, enemy);
    }
  }
   return ::Defend(dam, dtype, spell, enemy);
}
