// ~Schwertdaemon / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/schwertdaemon.c
// ~Level:  32-34 
// ~Hands:  500,DT_SLASH  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.5,COLD:-0.5,WATER:-0.5,AIR:0.3,LIGHTNING:-0.5,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0.3,POISON:0,TERROR:-0.3,HOLY:0,UNHOLY:0,MAGIC:-0.3
// ~Special: 1-4 attacken/runde

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Ein fuerchterlicher Daemon mit 4 Schwertern");
  SetProp(P_LONG, 
      "Vor Dir steht einer der gefuerchteten Schwertdaemonen. Aus seinem "
      "spindelduerren Koerper wachsen vier sehr muskuloese Arme, die in gewaltigen, "
      "klauenbesetzten Haenden enden. Aber das wahrlich fuerchterliche sind die vier "
      "Schwerter, von denen er je eines in seinen Haenden haelt. Frisches Blut "
      "tropft von den blitzenden, extrem scharfen Klingen auf den Boden.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 30, 10}));

  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Schwertdaemon");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 390+random(50));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","schwertdaemon", "daemon"}));
  create_default_npc(38+random(3));
  SetProp(P_ALIGN, -590);
  SetProp(P_MAX_HANDS, 4); 
  SetProp(P_HANDS, ({" mit einem seiner Schwerter",500,DT_SLASH})); 
  SetProp(P_SPELLRATE,1);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.5,    DT_COLD        :-0.5,    DT_WATER      :-0.5,    
    DT_AIR        :0.3,     DT_LIGHTNING   :-1,      DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0.3,     DT_POISON      :0,       DT_TERROR     :-0.3,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :-0.3]) );
  
  SetProp(P_NOMAGIC,45);

  SetProp(P_MSGIN, "kommt mit wirbelnden Schwertern herein");
  SetProp(P_MSGOUT, "begibt sich");

  SetProp(P_DIE_MSG, " laesst seine Schwerter fallen und verschwindet im Nichts.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Ein Schwert des Schwertdaemons");
  SetProp(P_KILL_MSG, "Fuehle meine Klinge, Sterblicher!");
  SetProp(P_MURDER_MSG, "Wie konntest Du nur meinen vier toedlichen Klingen entkommen, %s?"); 

  AddDefaultSpell(1, 400, DS_CURSE_WEAPON,
      "Der Schwertdaemon verflucht Dich.\n",
      "Der Schwertdaemon verflucht @WEN.\n");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  clone_object(WEAPON "daemonenschwert")->move(this_object());  
  clone_object(WEAPON "daemonenschwert")->move(this_object());  
  clone_object(WEAPON "daemonenschwert")->move(this_object());  
  clone_object(WEAPON "daemonenschwert")->move(this_object());  

  SUID;
}



void Attack(object enemy) {
  SetProp(P_SKILL_ATTRIBUTES, 0);
  ModifySkillAttribute(this_object(), SA_SPEED, ((random(3)+random(3)+1)*100), 2);
  ::Attack(enemy);
}


