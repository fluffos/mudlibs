// ~(w) Lamuerte 2000
// ~Erinnerungsnetz / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/erinnerungsnetz.c
// ~Level:  35-40 
// ~Hands:  175,DT_WHIP WC: default AC: default 
// ~Spells: (Rate: 6) "hold spell", kein Weglaufen moeglich, Kampf jedoch wird fortgesetzt
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:0,RIP:0,
// ~        FIRE:-0.2,COLD:-0.3,WATER:-0.2,AIR:-0.2,LIGHTNING:-0.2,EXPLOSION:-0.2,SOUND:0,
// ~        LIGHT:0.5,ELECTRIC:-0.4,ACID:0,POISON:-1,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  SetProp(P_SHORT, "Ein Erinnerungsnetz spannt sich durch den Raum");
  SetProp(P_LONG, 
      "Ein grosses Erinnerungsnetz haengt hier quer durch den Raum. Ab und an "
      "zuckt es leicht, es sieht wirklich aus, als ob es leben wuerde. In "
      "seiner Form erinnert es Dich an diese 'normalen' Netze, doch dieses "
      "hier ist noch groesser und viel gemeiner. Fuer diese Abart eines "
      "Daemonen bist Du nicht mehr als ein mickriger Wurm.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  SetProp (P_MNPC_FLAGS, 0);

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.1+0.07*to_int(well_level()));
  SetProp(P_NAME, "Erinnerungsnetz");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 50+random(22));
  SetProp(P_GENDER, NEUTER);
  AddId(({"\nbrunnenpc","netz","erinnerungsnetz","daemon"}));
  create_default_npc(25+random(6));
  SetProp(P_ALIGN, -89);
  SetProp(P_MAX_HANDS, 10); 
  SetProp(P_HANDS, ({" mit unzaehligen Netzfaeden",275,DT_WHIP})); 
  SetProp(P_SPELLRATE,35);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0.1,     DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :0,       DT_RIP        :-0.1,
    DT_FIRE       :-0.2,    DT_COLD        :-0.3,    DT_WATER      :-0.2,    
    DT_AIR        :-0.2,    DT_LIGHTNING   :-0.2,    DT_EXPLOSION  :-0.2, 
    DT_SOUND      :0,       DT_LIGHT       :0.5,     DT_ELECTRIC   :-0.4,    
    DT_ACID       :0,       DT_POISON      :-1,      DT_TERROR     :0,     
    DT_HOLY       :0.1,     DT_UNHOLY      :0,       DT_MAGIC      :0.1]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");

  SetProp(P_DIE_MSG, " stirbt ohne viel Aufsehen zu erregen.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Das Netz zuckt leicht.\n",
  }) );


  AddSpell(6, 200+random(10*this_object()->QueryProp(P_LEVEL)),
      "  Das Netz wickelt Dich in unzaehligen Faeden ein, die Deine Fuesse lahmen.\n",
      "  @WER wird von einem Netz eingewickelt und sieht etwas unbeweglich aus.\n",
      DT_WHIP, "spell_hold", ([SP_SHOW_DAMAGE:1]));

    SUID;

}

