// ~Remorhaz / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/remorhaz.c
// ~Level:  30-39 
// ~Hands:  350,DT_SQUEEZE  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:-0.1,WHIP:-0.1,RIP:-0.1,
// ~        FIRE:0.2,COLD:-0.3,WATER:-0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0.3,POISON:-0.5,TERROR:0.3,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Ein riesiger, blauer Wurm windet sich durch den Raum");
  SetProp(P_LONG, 
      "Dieser riesige, blaue Wurm ist wohl ein Remorhaz, ein Lebewesen, dass "
      "nur aus Maul und Magen zu bestehen scheint, denn es frisst alles und jeden "
      "auf. Sogar vor der Erde selber haelt sich der Remorhaz nicht zurueck, so "
      "kann es sein, dass diese weitlaeufigen Gewoelbe durch den Hunger vieler "
      "Remorhaze entstanden sind.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({5, 20, 50}));

  SetProp(P_AGGRESSIVE,0.5+0.04*to_int(well_level()));
  SetProp(P_NAME, "Remorhaz");
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 700);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","remorhaz","wurm"}));
  create_default_npc(30+random(to_int(well_level())));
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem gigantischen Maul",350,DT_SQUEEZE })); 
  SetProp(P_SPELLRATE, 40);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-0.7,    DT_WATER      :-0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0,
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0.3,     DT_POISON      :-0.5,    DT_TERROR     :0.3,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "windet sich herein");
  SetProp(P_MSGOUT, "windet sich");

  SetProp(P_DIE_MSG, " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Und jetzt fress ich Dich auf! *MAMPF*");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(3,500,
      "Der Remorhaz versucht Dich aufzufressen.\n", 
      "Der Remorhaz versucht @WEN aufzufressen.\n", 
      ({DT_RIP, DT_COLD}), ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1, 300, DS_REDUCE_AC,
      "Der Remorhaz beisst in Deine Ruestung.\n", 
      "Der Remorhaz beisst in @WESSEN Ruestung.\n", 
      5);
  AddDefaultSpell(1, 200, DS_SLOW,
      "Der Remorhaz blockiert Deine Waffe.\n", 
      "Der Remorhaz blockiert @WESSEN Waffe.\n", 
      3);

  SUID;
}
