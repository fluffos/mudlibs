// ~Todestentakel / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/todestentakel.c
// ~Level:  35-40 
// ~Hands:  285,DT_BLUDGEON  WC: default AC: default 
// ~Spells: (Rate: 9, 90+random(230)) DT_FIRE Spell
// ~        (Rate: 9, 90+random(230)) DT_ICE Spell
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:Heilt sich durch Feuer & Eisattacken.

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Todestentakel waechst hier aus dem Boden");
  SetProp(P_LONG, 
      "Vor Dir waechst ein rieseges Tentakelungetuem aus dem Boden. "
      "Es ist mit unzaehligen roten und weissen "
      "Tentakelarmen uebersaeht. Manche dieser Tentakel lodern in "
      "hellen Flammen, andere wiederum sehen ein wenig "
      "vereist aus. Das ganze Gebilde hat eine birnenaehnliche "
      "Form und es ist immer in Bewegung. Du solltest "
      "aufpassen das es Dich nicht angreift. ");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  SetProp (P_MNPC_FLAGS, 0);

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.3+0.05*to_int(well_level()));
  SetProp(P_NAME, "Todestentakel");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 190+random(80));
  SetProp(P_GENDER, NEUTER);
  AddId(({"\nbrunnenpc","tentakel","todestentakel"}));
  create_default_npc(35+random(6));
  SetProp(P_ALIGN, -210);
  SetProp(P_MAX_HANDS, 12); 
  SetProp(P_HANDS, ({" mit seinem birnenfoermigen Koerper",385,DT_BLUDGEON})); 
  SetProp(P_SPELLRATE,-20+to_int(well_level()) * to_int(well_level()));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "schwabbelt herein");
  SetProp(P_MSGOUT, "schwabbelt");

  SetProp(P_DIE_MSG, " hat ausgeschwabbelt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Komm nochmal %s, und ich bringe Dich um!");
  SetProp(P_KILL_NAME, "Ein Todestentakel");
  SetProp(P_KILL_MSG, "Hehe, einer weniger.");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddDefaultSpell(2, 600, DS_MASS_DAMAGE,
      "  Das Todestentakel schlaegt wie wild mit seinen Armen umher.\n",
      "  Das Todestentakel schlaegt wie wild mit seinen Armen umher.\n",
      ({DT_FIRE, DT_COLD}));
  
  AddSpell(9, 890,
     "  Das Todestentakel erwischt Dich mit einem seiner eisigen Arme.\n",
     "  Das Todestentakel erwischt @WEN mit einem seiner eisigen Arme.\n",
     DT_COLD, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(9, 890,
     "  Das Todestentakel erwischt Dich mit einem seiner feurigen Arme.\n",
     "  Das Todestentakel verbrennt @WEN.\n",
     DT_FIRE,  ([SP_SHOW_DAMAGE:1]) );

  SUID;
}



Defend(int dam, mixed dtype, int spell, object enemy){
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1 || member( dtype, DT_COLD ) != -1){
    if(random(100)>70) 
      tell_room(environment(), "  Das Tentakel saugt sich mit Energie an.\n");
    this_object()->AddHp(dam);
    return ::Defend(0, dtype, spell, enemy);
  }
 return ::Defend(dam, dtype, spell, enemy);
}
