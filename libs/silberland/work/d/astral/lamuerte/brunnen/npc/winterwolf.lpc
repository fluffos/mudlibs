// ~Winterwolf / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/winterwolf.c
// ~Level:  Base 25 + welllevel * 2
// ~Hands:  285,DT_BLUDGEON  WC: default AC: default 
// ~R.Str:  SLASH:-0.2,BLUDGEON:-0.2,PIERCE:-0.2,SQUEEZE:0,WHIP:-0.2,RIP:0,
// ~        FIRE:0.3,COLD:-1,WATER:-0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0.3,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:Extrem Verwundbar durch Feuer, Heilt sich durch Coldattacken

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
 
  ::create(); 
  
  SetProp(P_SHORT, "Ein riesiger weisser Wolf verstroemt toedliche Kaelte");
  SetProp(P_LONG, 
      "Vor Dir steht ein zweieinhalb Meter grosser Winterwolf. Sein Fell "
      "ist weiss, lang und glaenzt im Licht seiner Umgebung. Der Kopf des "
      "Winterwolfs faellt duch seine strahlend blauen Augen auf "
      "welche Dich boese anstarren. Seine Pranken sind mit aeusserst "
      "scharfen Krallen ausgestattet, welche Dich in der Luft zerreissen werden.");
  SetProp (P_MNPC_WAIT, ({20, 20, 40}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.1+0.09*to_int(well_level()));
  SetProp(P_NAME, "Winterwolf");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 240+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","wolf","winterwolf"}));
  create_default_npc(25+(to_int(well_level())));
  SetProp(P_ALIGN, -880);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen",
        250+(to_int(well_level())*to_int(well_level())),DT_RIP})); 
  SetProp(P_SPELLRATE,(30+random((to_int(well_level())*3))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.2,    DT_BLUDGEON    :-0.2,    DT_PIERCE     :-0.2,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0.3,     DT_COLD        :-1,      DT_WATER      :-0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0.3,     DT_POISON      :0.2,     DT_TERROR     :-0.3,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :-0.2]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "steigt mit eisigen Pfoten herein");
  SetProp(P_MSGOUT, "steigt mit eisigen Pfoten");

  SetProp(P_DIE_MSG, " stirbt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Der Naechste bitte!");
  SetProp(P_MURDER_MSG, "Das naechste Mal entkommst Du nicht meinem "
      "toedlichen Schneesturm, %s?");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");


  AddDefaultSpell(1, 350+to_int(well_level())*30, DS_MASS_DAMAGE,
          "Der Winterwolf beschwoert einen Schneesturm herbei.\n"+
          "Riesige Eisbrocken treffen Dich hart!\n", 
          "Der Winterwolf beschwoert einen Schneesturm herbei.\n"+
          "Riesige Eisbrocken treffen Dich hart!\n", 
          DT_COLD );

  SUID;
}


Defend(int dam, mixed dtype, int spell, object enemy){
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_COLD ) != -1){
    if(random(100)>40) 
      tell_room(environment(), 
          "  Der Winterwolf bekommt eine steinharte Oberflaeche.\n");
    this_object()->AddHp(dam);
    SetProp(P_BODY, QueryProp(P_BODY)+random(10));
    return ::Defend(0, dtype, spell, enemy);
  }

  if (member( dtype, DT_FIRE ) != -1){
    if(random(100)>80) 
      tell_room(environment(),
          "  Der Winterwolf schreit laut auf vor Schmerzen!\n");
    return ::Defend((3*dam/2), dtype, spell, enemy);
  }
   return ::Defend(dam, dtype, spell, enemy);
}
