// ~(w) Lamuerte 2000
// ~Trakanbiest / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/trakanbiest.c
// ~Special: Hohe Drachenaart mit zusaetzlichem bloodloss spell

inherit "/p/std/dragons/dragon.lpc";
inherit "/std/npc/spells";

#include "../def.h"

#include "./functions.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Brunnennpcs!");
    destruct();
    return;
  }
  SetProp(P_GENDER,NEUTER);
  SetProp(P_NAME,"Drakanbiest");
  create_default_dragon(1,4+to_int(well_level())/2,2,12);

  SetProp(P_SHORT, "Vor Dir tuermt sich ein amethystviolettes Drakanbiest auf");
  SetProp(P_AGGRESSIVE,0.5);
  SetProp(P_GENDER,NEUTER);
  AddId(({"biest","drakanbiest", "\nbrunnenpc"}));
  SetProp(P_LONG,
   "Vor Dir tuermt sich ein amethystviolettes Drakanbiest auf. "
   "Dieses Biest stammt von einem Drachen ab, jedoch "
   "hat es stark daemonischen Einschlag. "
   "Huete Dich, viele tapfere Helden sind ihm schon zum Opfer gefallen.");

  SetProp(P_MNPC_AREA, ROOMS "level"+well_level()+"/");
  SetProp(P_MNPC_WAIT, ({20, 40, 60}));
  SetProp(P_MNPC_DEFAULTROOM,
              file_name(interactive(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS  + MOV_MOVES + MOV_MAYLOAD);
  SetProp(P_MSGIN, "biestert herein");
  SetProp(P_MSGOUT, "biestert");

  AddSpell(1, 1,
      "  Das Drakanbiest saugt Dir Blut ab.\n",
      "  Das Drakanbiest saugt @WEM Blut ab.\n",
      DT_POISON, "spell_bloodloss", ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 500, DS_MASS_DEAF);
  AddDefaultSpell(1, 500, DS_DEAF);

  SetProp(P_HEAL, QueryProp(P_LEVEL)*to_int(well_level()) );

  SUID;
}

