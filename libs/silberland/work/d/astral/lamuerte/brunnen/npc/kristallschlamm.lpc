// ~Kristallschlamm / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/kristallschlamm.c
// ~Level:  10-14 
// ~Hands:  145,DT_SQUEEZE WC: default AC: default 
// ~Spells:
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:-0.4,WHIP:0,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:0,AIR:0,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:-1,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

#include <npcmaster.h>

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein kristallen schimmerndes, schleimiges Wesen fliesst ueber den Boden");
  SetProp(P_LONG, 
      "Du siehst ein flaches, schleimiges Etwas vor Dir, welches am Boden "
      "zerrinnen zu scheint. Dieses unheimliche Kreatur hat keinen wirklichen "
      "Namen, doch unter den erfahrenen Abenteurern wird es Kristallschlamm genannt, "
      "denn seine funkelnde, rauhe Oberflaecher erinnert an einen wunderbaren "
      "Kristall. Das Ding ist nicht besonders gefaehrlich, doch ab und an "
      "greift es aus heiterem Himmel einfach irgendwen an.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Kristallschlamm");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 10+random(4));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","schlamm","kristallschlamm","wesen","daemon"}));
  create_default_npc(13+random(4));
  SetProp(P_NO_SCORE, 1);
  SetProp(P_ALIGN, -220);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seiner ganzen schlammigen Masse",145,({DT_SQUEEZE, DT_ACID}) })); 
  SetProp(P_SPELLRATE,25);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.4,    DT_WHIP        :0,       DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0,    
    DT_AIR        :0,       DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :-1,      DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "schwabbelt herein");
  SetProp(P_MSGOUT, "schwabbelt");

  SetProp(P_DIE_MSG, " zerrinnt vor Dir.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Naechstes mal schleim ich Dich ein, %s!");
  SetProp(P_KILL_NAME, "Ein Kristallschlamm");
  SetProp(P_KILL_MSG, "Ah, endlich hab ich Dich erwischt!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Der Kristallschlamm schwabbelt unruhig am Boden herum.\n",
    "Der Kristallschlamm verformt sich. Anscheinend geht er in Angriffsposition.\n",
    "Der Kristallschlamm spritzt mit einer Fluessigkeit herum.\n"
  }) );


  SUID;
}
