// ~        FIRE:-0.5,COLD:-0.5,WATER:-0.5,AIR:-1,LIGHTNING:-0.5,EXPLOSION:0,SOUND:-0.5,
// ~        LIGHT:0,ELECTRIC:-0.5,ACID:-0.5,POISON:-0.5,TERROR:-0.5,HOLY:-0.5,UNHOLY:-0.5,MAGIC:0
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"


void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Der Djinni Kalif");
  SetProp(P_LONG,
    "Dieses gigantische Luftwesen besteht aus einem gewaltigen Wirbelwind mit "
    "einem menschenaehnlichen Oberkoerper. Der Kopf des Djinnis Kalifs wird von "
    "einer grossen Krone geschmueckt. Dies ist die groesste "
    "Manifestation eines Luftelementars, das Du je zu Gesicht bekommen hast. "
    "Moeglicherweise ist dies sogar der Herrscher ueber das Element Luft.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({10, 50, 50}));

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Djinni Kalif");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 800);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","djinni", "djinni kalif", "kalif", "elementar"}));
  AddClass(CL_FLYING);
  create_default_npc(55);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit einem Luftwirbel",600,({DT_BLUDGEON, DT_AIR})})); 
  SetProp(P_SPELLRATE, 80);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      : 0.1,    DT_BLUDGEON    :0.2,     DT_PIERCE     : 0.1,
    DT_SQUEEZE    : 0.1,    DT_WHIP        :0.1,     DT_RIP        : 0.1,
    DT_FIRE       :-0.5,    DT_COLD        :-0.5,    DT_WATER      :-0.5,    
    DT_AIR        :-1,      DT_LIGHTNING   :-0.5,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.5,    DT_LIGHT       :0,       DT_ELECTRIC   :-0.5,    
    DT_ACID       :-0.5,    DT_POISON      :-0.5,    DT_TERROR     :-0.5,     
    DT_HOLY       :-0.5,    DT_UNHOLY      :-0.5,    DT_MAGIC      :0]) );
 
  SetProp(P_NOMAGIC,55);

  SetProp(P_MSGIN, "fliegt majestaetisch herein");
  SetProp(P_MSGOUT, "fliegt majestaetisch");

  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Niemand besiegt den grossen Kalif aller Djinnis!");
  SetProp(P_MURDER_MSG, "Unmoeglich! Wie konntest Du nur den Herrscher " 
            "der Luefte bezwingen, %s?");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"sagt: Ich bin der Kalif aller Djinnis.");

  AddSpell(7,999,
      "Der Djinni Kalif laesst einen Windstoss auf Dich los.\n",
      "Der Djinni Kalif laesst einen Windstoss auf @WEN los.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(5, 900, DS_MASS_DAMAGE,
      "Der Djinni Kalif beschwoert eine Windhose herbei.\n",
      "Der Djinni Kalif beschwoert eine Windhose herbei.\n",
      DT_AIR);
  AddDefaultSpell(5, 1200, DS_BLIND,
      "Der Djinni Kalif blaest Dir Schmutz in die Augen.\n",
      "Der Djinni Kalif blaest @WEM Schmutz in die Augen.\n",
      5);
  AddDefaultSpell(4, 800, DS_MASS_BLIND,
      "Der Djinni Kalif blendet Dich.\n",
      "Der Djinni Kalif blendet Dich.\n",
      4);
  AddDefaultSpell(2,100, DS_PARALYZE,
      "Der Djinni Kalif paralysiert Dich.\n",
      "Der Djinni Kalif paralysiert @WEN.\n",
      4);
  AddSpell(4,1000,
      "Der Djinni Kalif verwirrt Deinen Geist!\n",
      "Der Djinni Kalif verwirrt @WESSEN Geist!\n",
      DT_MAGIC, "spell_brainstorm", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1,
      "Der Djinni Kalif holt einen seiner Untertanen zu Hilfe!\n",
      "Der Djinni Kalif holt einen seiner Untertanen zu Hilfe!\n",
      DT_MIND, "clone_helper");

  SUID;
}


void init()
{ 
  ::init();
  if( this_player() && this_player()->id("djinni"))
    AddDefender(this_player());
  if( this_player() && this_player()->QueryProp("djinnikiller") > time())
    Kill(this_player());
}

void InformDefend(object enemy)
{ 
  Kill(enemy);
}

varargs void clone_helper(object enemy, int damage, mixed dam_type)
{
  object ob;
  if(!present("djinni 3", environment(this_object())))
  {
    ob=clone_object(NPC "djinni_malik.lpc");
    ob->move(environment(),M_GO);
    AddPursuer(ob);
  }
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{ 
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_AIR ) != -1){
    if(random(100)>40)
      tell_room(environment(), "  Der Djinni Kalif freut sich ueber die frische Luft.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  if(!random(22)) clone_helper();
  return ::Defend(dam, dtype, spell, enemy);
}

varargs void die( int poisondeath )
{
  this_player()->SetProp("djinnikiller", time() + 3600 * 24 * 3);
  ::die(poisondeath);
}

int _query_disable_attack() { return 0; }

int _query_disable_spells() { return 0; }

int _query_wimpy() { return 0; }

int _query_poison() { return 0; }
                                                                         
