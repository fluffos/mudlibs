// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/sandling.c
// ~Level:  20-25 
// ~Hands:  285,DT_BLUDGEON  WC: default AC: default 
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.3,COLD:-0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:Extrem Verwundbar durch Wasser, Heilt sich durch Feuerattacken(trocknet).

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Sandling");
  SetProp(P_LONG, 
      "Vor Dir steht ein ueber zwei Meter grosses Sandwesen, Es hat den "
      "Koerperbau eines Trolls, doch es ist eine Abart eines Daemons und "
      "besteht nur aus Sand. Sein ganzer Koerper weist keine einzige eckige "
      "Stelle auf, jedoch umso mehr Rundungen. Diese Wesen hat eine enorme "
      "Kraft, welche schon so manchen wackeren Helden in die Knie gezwungen hat.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.3);
  SetProp(P_NAME, "Sandling");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 250+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","wesen","sandling","sandwesen"}));
  create_default_npc(25+random(5));
  SetProp(P_ALIGN, -280);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen sandigen Haenden",385,DT_BLUDGEON})); 
  SetProp(P_SPELLRATE,25);
  SetAttribute(A_STR, 55 );

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");

  SetProp(P_DIE_MSG, " zefaellt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Komm nochmal und ich zeig Dir was ich drauf hab, %s!");
  SetProp(P_KILL_NAME, "Ein Sandling");
  SetProp(P_KILL_MSG, "Tod jenen, die aus Fleisch und Blut sind!");

  AddSpell(39,300,
      "  Der Sandling ueberschuettet Dich mit Sand.\n",
      "  Der Sandling ueberschuettet @WEN mit Sand.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 1,
      "  Der Sandling sagt: Na grabero de!\n",
      "  Der Sandling sagt: Na grabero de!\n",
      DT_MAGIC, "spell_drop");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  SUID;
}


int Defend(int dam, mixed dtype, int spell, object enemy){
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1){
    if(random(100)>40) 
      tell_room(environment(), 
          "  Der Sandling bekommt bekommt eine steinharte Oberflaeche.\n");
    this_object()->AddHp(dam/10);
    SetProp(P_BODY, QueryProp(P_BODY)+random(20) );
    return ::Defend(0, dtype, spell, enemy);
  }

  if (member( dtype, DT_WATER ) != -1){
    if(random(100)>80) 
    {
      tell_room(environment(), 
          "  Der Sandling schreit laut auf vor Schmerzen!\n");
      return ::Defend((3*dam/2), dtype, spell, enemy);
    }
  }
  return ::Defend(dam, dtype, spell, enemy);
}
