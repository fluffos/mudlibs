// ~Wasserlaeufer / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/wasserlaeufer.c
// ~Level:  Base 25 + Well Level / 2  
// ~Hands:  185,DT_RIP  WC: default AC: default 
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.3,COLD:0,WATER-0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein krokodilartiges Reptil laeuft hier herum");
  SetProp(P_LONG, 
      "Du siehst ein unheimliches Reptil vor Dir. Es ist etwa 3 Meter lang, "
      "und aehnelt einem Krokodil. Oft wird es als Wasserlaeufer bezeichnet, "
      "da es sich unheimlich schnell im Wasser fortbewegen kann. Seine "
      "langen Krallen, welches dieses Monster bevorzugt im Kampf gegen seine "
      "Gegner einsetzt, sind messerscharf und koennen Dich mit Leichtigkeit "
      "aufschlitzen. "); 
  //SetProp(P_ARTICLE,0); 
  SetProp(P_MNPC_FLAGS, 0); 
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Wasserlaeufer");
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 30+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","laeufer","wasserlaeufer", "reptil"}));
  create_default_npc(25+(to_int(well_level())/2));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit seinem kugelfoermigen Koerper",
        220+(to_int(well_level())*to_int(well_level())),DT_RIP}));
  SetProp(P_SPELLRATE,(40+random((to_int(well_level())*3))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0.3,     DT_COLD        :-0.4,    DT_WATER      :-0.8,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0.2,     DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");

  SetProp(P_DIE_MSG, " verreckt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Komm nochmal %s, und ich zeig Dir was ich drauf hab!");
  SetProp(P_KILL_NAME, "Ein Wasserlaeufer");
  SetProp(P_KILL_MSG, "Hehe, einer weniger.");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(9, 300+(to_int(well_level())*to_int(well_level())*3),
     "  Der Wasserlaeufer erwischt Dich an Deinem verwundbarsten Punkt mit seinen Krallen.\n",
     "  Der Wasserlaeufer zerfetzt @WEN mit seinen Krallen.\n",
     ({DT_RIP, DT_WATER}), ([SP_SHOW_DAMAGE:1]) );

  SUID;
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_WATER ) != -1){
    if(random(100)>40)
      tell_room(environment(), 
          "  Der Wasserlaeufer freut sich ueber dieser Erfrischung.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  return ::Defend(dam, dtype, spell, enemy);
}

