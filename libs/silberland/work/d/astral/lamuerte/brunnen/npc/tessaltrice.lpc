// ~Tessaltrice / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/tessaltrice.c
// ~Level:  35-37 
// ~Hands:  500,DT_SLASH  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.2,BLUDGEON:-0.2,PIERCE:-0.2,SQUEEZE:-0.2,WHIP:-0.2,RIP:-0.2,
// ~        FIRE:-0.4,COLD:-0.4,WATER:-0.4,AIR:0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:-0.3,POISON:0.2,TERROR:-0.3,HOLY:0.1,UNHOLY:-0.5,MAGIC:-0.3
// ~Special: 


#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Eine Tessaltrice");
  SetProp(P_LONG, 
  "Die Tessaltrice ist ein fuerchterlicher Daemon. Sie ist bekannt fuer "
  "ihre Illusionen und Tricks, also sei auf der Hut.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 30, 10}));

  SetProp(P_AGGRESSIVE,0.1+0.07*to_int(well_level()));
  SetProp(P_NAME, "Tessaltrice");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 200);
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nbrunnenpc","tessaltrice", "daemon"}));
  create_default_npc(35+random(3));
  SetProp(P_ALIGN, -450);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit daemonischer Macht",300,({DT_UNHOLY, DT_RIP}) })); 
  SetProp(P_SPELLRATE, 50);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE    :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :-0.4,    DT_COLD        :-0.4,    DT_WATER      :-0.2,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0.2,     DT_EXPLOSION  :0,
    DT_SOUND      :0,       DT_LIGHT       :-0.3,    DT_ELECTRIC   :0,    
    DT_ACID       :0.3,     DT_POISON      :-0.2,    DT_TERROR     :-0.3,     
    DT_HOLY       :0.1,     DT_UNHOLY      :-0.5,    DT_MAGIC      :-0.3]) );
  
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "ist ploetzlich da");
  SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
      "Ist sie jetzt nach Sueden, nach Norden, # oder gar nach Osten gegangen....");

  SetProp(P_DIE_MSG, " wird in viele kleine Stuecke zerfetzt.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Und komm nie wieder!!!");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(10,500,
      "  Die Tessaltrice kitzelt Dich am Bauch.\n",
      "  Die Tessaltrice kitzelt @WEN am Bauch.\n",
      DT_RIP );
  AddSpell(10,100,
      "  Die Tessaltrice pulverisiert Dich.\n",
      "  Die Tessaltrice pulverisiert @WEN.\n",
      DT_RIP );
  AddSpell(10,400,
      "  Die Tessaltrice atomisiert Dich.\n",
      "  Die Tessaltrice atomisiert @WEN.\n",
      DT_RIP );
  AddSpell(10,700,
      "  Die Tessaltrice trifft Dich extrem hart.\n",
      "  Die Tessaltrice trifft @WEN extrem hart.\n",
      DT_RIP );
  AddDefaultSpell(2, 200, DS_CURSE_ARMOUR,
      "  Die Tessaltrice verflucht Dich.\n",
      "  Die Tessaltrice verflucht @WEN.\n");
  AddDefaultSpell(1, 300, DS_CURSE_WEAPON,
      "  Die Tessaltrice verflucht Dich.\n",
      "  Die Tessaltrice verflucht @WEN.\n");

  SetChats(20, ({
        "Ein Eraditor gleitet herein.\n",
        "Prinz Eisenherz-Modus.\n",
        "Ok, Fluchtrichtung Nordsueden.\n",
        "Du ziehst Dein Halsband aus.\n",
        "Der Jojogeist kommt Dich tretend und grinsend herin.\n",
        "Du bist vergiftet.\n",
        "Du bist jetzt ein Frosch.\n",
        "Eine Ampulle zerbricht.\n",
        "Deine Intelligenz hat sich gerade verringert.\n",
        "Jemand teilt Dir mit: Ich fuerchte jetzt wirst Du gleich sterben *troest*\n",
        "Dein Teddy zwinkert Dir ein letztes Mal zu.\n",
        "Jemand klaut Dir all Dein Geld.\n",
        "Du bist paralysiert und kannst Dich nicht mehr bewegen.\n",
        "Du kaempfst jetzt gegen den Schattendaemon.\n",
        "[Info:] Reboot in 5 Sekunden!\n",
        "Dein Drachenpanzer loest sich in Luft auf.\n",
        }));
  SetAttackChats(20, ({
        "Die Tessaltrice faellt tot zu Boden.\n"
        "[Moerder:Geist einer Tessaltrice] Ich komme wieder!!!\n",
        "Ein Eraditor gleitet herein.\n",
        "Prinz Eisenherz-Modus.\n",
        "Ok, Fluchtrichtung Nordsueden.\n",
        "Du ziehst Dein Halsband aus.\n",
        "Der Jojogeist kommt Dich tretend und grinsend herin.\n",
        "Dein Zauberspruch ist misslungen.\n",
        "Du verfehlst die Tessaltrice.\n",
        "Die Tessaltrice ist absolut fit.\n",
        "Du bist vergiftet.\n",
        "Du bist jetzt ein Frosch.\n",
        "Eine Ampulle zerbricht.\n",
        "Deine Intelligenz hat sich gerade verringert.\n",
        "Jemand teilt Dir mit: Ich fuerchte jetzt wirst Du gleich sterben *troest*\n",
        "Dein Teddy zwinkert Dir ein letztes Mal zu.\n",
        "Eine gewaltige Explosion erschuettert den Raum.\n",
        "Jemand klaut Dir all Dein Geld.\n",
        "Du bist paralysiert und kannst Dich nicht mehr bewegen.\n",
        "Die Tessaltrice ist paralysiert und kann sich nicht mehr bewegen.\n",
        "Du kaempfst jetzt gegen den Schattendaemon.\n",
        "[Info:] Reboot in 5 Sekunden!\n",
        "Deine Waffe zersplittert in kleine Teile.\n",
        "  Die Tessaltrice schleudert Dich einmal rund ums SilberLand.\n",
        "  Die Tessaltrice ***VERNICHTET*** Dich mit gewaltiger Kraft!\n",
        "  Die Tessaltrice ****VERNICHTET**** Dich mit gewaltiger Kraft!\n",
        "  Die Tessaltrice *****VERNICHTET***** Dich mit gewaltiger Kraft!\n",
        "  Die Tessaltrice ******VERNICHTET****** Dich mit gewaltiger Kraft!\n",
        "  Die Tessaltrice zerbroeselt Dich zu feinstem Staub.\n",
        "Dein Drachenpanzer loest sich in Luft auf.\n",
        }));
  SUID;
}


void init()
{
  ::init();
  switch(random(12) )
  {
    case 0:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Sueden, nach Norden, # oder gar nach Osten gegangen?");
      break;
    case 1:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Westen,#, nach Norden oder gar nach Sueden gegangen....");
      break;
    case 2:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Osten, nach Norden, nach Sueden oder gar# gegangen....");
      break;
    case 3:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt#, nach Norden, nach Westen oder gar nach Osten gegangen....");
      break;
    case 4:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Sueden, nach Westen,# oder gar nach Sueden gegangen....");
      break;
    case 5:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt#, nach Westen, nach Osten oder gar nach Osten gegangen....");
      break;
    case 6:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Sueden,#, nach Osten oder gar nach Osten gegangen....");
      break;
    case 7:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Osten, nach Norden, nach Osten oder gar# gegangen....");
      break;
    case 8:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt#, nach Westen, nach Norden oder gar nach Norden gegangen....");
      break;
    case 9:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Norden,#, nach Westen oder gar nach Westen gegangen....");
      break;
    case 10:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Osten, nach Westen,# oder gar nach Norden gegangen....");
      break;
    case 11:
      SetProp(P_MSGOUT, "verschwindet ploetzlich.\n"
        "Ist sie jetzt nach Westen, nach Norden, nach Norden oder gar# gegangen....");
      break;
  }
}

