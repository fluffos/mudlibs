// ~Doppelganger / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/doppelganger.c
// ~Level:  Default Drache create_default_dragon(1,5,0,10);

inherit "/p/std/dragons/dragon";

#include "../def.h"
#include "./functions.h"

void create() 
{ 
  int x,y;

  if (!is_clone(this_object())) return;
  ::create();

  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Brunnennpcs!");
    destruct();
    return;
  }
  SetProp(P_NAME,"Doppelganger");
  create_default_dragon(3,3+to_int(well_level())/2,2,10);
  SetProp(P_AGGRESSIVE,1); 
  SetProp(P_SHORT,"Doppelganger");
  SetProp(P_LONG,
      "Du siehst einen Doppelganger vor Dir. Dies ist ein Drache, welcher "
      "nicht ueberall im Lande zu finden ist. Er ist nicht einer der "
      "staerksten Drachen, doch er traegt ausser Schuppen auch "
      "noch Fragmente bei sich, was ihn zu einem begehrten Objekt unter "
      "den Abenteurern des Silberlandes macht.");
  AddId(({"doppelganger", "\nbrunnenpc"}));
  SetProp(P_HEAL, QueryProp(P_LEVEL)*to_int(well_level()) );

  SetProp(P_MNPC_AREA, ROOMS "level"+well_level()+"/");
  SetProp(P_MNPC_WAIT, ({20, 40, 60}));
  SetProp(P_MNPC_DEFAULTROOM,
              file_name(interactive(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS  + MOV_MOVES + MOV_MAYLOAD);
  SetProp(P_MSGIN, "verdoppelt sich");
  SetProp(P_MSGOUT, "teilt sich. Ein Teil bleibt hier, der andere geht");

  SUID;
}

