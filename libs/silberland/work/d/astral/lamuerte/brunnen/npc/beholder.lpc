// ~(w) Lamuerte 2001
// ~Beholder / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/beholder.c
// ~Level:  25+well level
// ~Hands:  285,DT_SLASH   WC: default AC: default 
// ~R.Str:  SLASH:-0.4,BLUDGEON:-0.4,PIERCE:-0.4,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Area Spell / Paralyze

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein riesiges Auge schwebt mitten im Raum");
  SetProp(P_LONG, 
      "Vor Dir schwebt eine ekelerregede, schleimige Fleischkugel. Sie "
      "hat viele lange Tentakel an ihrem Koerper herabhaengen. An jedem "
      "dieser Tentakel haengt am Ende ein dickes Glupschauge, "
      "ein jedes graesslicher als das Andere. In der Mitte seines "
      "kugelfoermigen Koerpers sitzt noch ein Auge, welches jedoch "
      "groesser ist als jene an den Tentakelenden. Unter diesem Auge befindet sich "
      "ein stinkender Mund, welcher mit zahlreichen spitzen Zaehnen uebersaeht ist.");
  SetProp (P_MNPC_WAIT, ({30, 40, 50}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Beholder");
  SetProp(P_RACE, "Beholder");
  SetProp(P_SIZE, 45+random(33));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","beholder"}));
  create_default_npc(25+(to_int(well_level())));
  SetProp(P_ALIGN, -170);
  SetProp(P_MAX_HANDS, 8); 
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen",200+(2*to_int(well_level())*to_int(well_level())),DT_SLASH}));
  SetProp(P_SPELLRATE,(10+random((to_int(well_level())*3))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.4,    DT_BLUDGEON    :-0.4,    DT_PIERCE     :-0.4,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");

  SetProp(P_DIE_MSG, " verreckt vor Deinen Augen.\n");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");

  AddDefaultSpell(1,200,DS_PARALYZE,
       "  Der Beholder paralysiert Dich.\n",
       "  Der Beholder paralysiert @WEN.\n");

  AddDefaultSpell(5,300+100*to_int(well_level()),DS_MASS_DAMAGE,
       "  Der Beholder trifft Dich mit einem feurigen Tantakelarm.\n",
       "  Der Beholder trifft @WEN mit einem feurigen Tentakelarm.\n",DT_FIRE);


  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Die Augen des Beholders starren Dich an.\n",
    "Der Beholder flaetscht mit seinen Zaehnen.\n",
    "Der Beholder schlaegt Dich zu Brei.\n",
  }) );

  SUID;
}
