// ~Sturmdaemon / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/sturmdaemon.c
// ~Level:  32-34 
// ~Hands:  500,DT_SLASH  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.5,COLD:-0.5,WATER:-0.5,AIR:0.3,LIGHTNING:-0.5,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0.3,POISON:0,TERROR:-0.3,HOLY:0,UNHOLY:0,MAGIC:-0.3
// ~Special: 1-4 attacken/runde

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Ein lebender Wirbelwind saust durch den Raum");
  SetProp(P_LONG, 
      "Der Sturmdaemon schaut aus wie ein lebender Wirbelwind. Er scheint "
      "tatsaechlich nur aus herumwirbelnder Luft zu bestehen. Pass auf, "
      "dass Du nicht vom Sturm davongeweht wirst.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({5, 10, 5}));

  SetProp(P_AGGRESSIVE,0.6+0.03*to_int(well_level()));
  SetProp(P_NAME, "Sturmdaemon");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 320+random(80));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","sturmdaemon", "daemon"}));
  create_default_npc(35+random(3));
  SetProp(P_ALIGN, -550);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit der Macht eines Wirbelsturms",400,({DT_BLUDGEON,DT_AIR})})); 
  SetProp(P_SPELLRATE, 10 + to_int(well_level()) * to_int(well_level()) / 2);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.2,    DT_BLUDGEON    :-0.2,    DT_PIERCE     :-0.2,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.2,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        : 0.2,    DT_WATER      :-0.5,    
    DT_AIR        :-1,      DT_LIGHTNING   :-0.2,    DT_EXPLOSION  :0.3,
    DT_SOUND      :-0.3,    DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :-0.3,    DT_POISON      :-0.2,    DT_TERROR     :-0.3,     
    DT_HOLY       :0.1,     DT_UNHOLY      :-0.5,    DT_MAGIC      :0.3]) );
  
  SetProp(P_NOMAGIC,45);

  SetProp(P_MSGIN, "stuermt herein");
  SetProp(P_MSGOUT, "stuermt");

  SetProp(P_DIE_MSG, " wird davongeblasen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Das hast Du davon, Dich mit den Kraeften des Sturmes anzulegen!");
  SetProp(P_MURDER_MSG, "Wie konntest Du nur der Macht des Sturmes entkommen, %s?"); 

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(5,500,
      "Der Sturmdaemon wirbelt Dich herum.\n",
      "Der Sturmdaemon wirbelt @WEN herum.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,900,
      "Der Sturmdaemon beschwoert Die Kraft eines Gewitters auf Dich herab.\n",
      "Der Sturmdaemon beschwoert Die Kraft eines Gewitters auf @WEN herab.\n",
     ({DT_LIGHTNING,DT_WATER,DT_SOUND,DT_AIR}), ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(4, 500, DS_ANTIMAGIC,
      "Der Sturmdaemon stoert Deine Konzentrationsfaehigkeit.\n",
      "Der Sturmdaemon stoert Deine Konzentrationsfaehigkeit.\n");
  AddDefaultSpell(1, 800, DS_DEAF,
      "Das Brausen des Sturmdaemons laesst Dich ertauben.\n",
      "Das Brausen des Sturmdaemons laesst @WEN ertauben.\n",
      200);
  AddDefaultSpell(1, 500, DS_MASS_DEAF,
      "Das Brausen des Sturmdaemons laesst Dich ertauben.\n",
      "Das Brausen des Sturmdaemons laesst Dich ertauben.\n",
      500);

  SUID;
}
