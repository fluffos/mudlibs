// ~(w) Lamuerte 2001
// ~Skelettfledermaus / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/skelettfledermaus.c
// ~Level:  15-18 
// ~Hands:  155,DT_PIERCE  WC: default AC: default 
// ~Spells: (Rate: 1, Steckt Gegner mit Malaria an
// ~R.Str:  SLASH:-0.1,BLUDGEON:0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:-0.2,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Blind spell 

#include "../def.h"

inherit "/p/std/npc/nekro_npc";
inherit "/std/npc/spells";

#include "./functions.h"
#include <npcmaster.h>

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Brunnennpcs!");
    destruct();
    return;
  }
  
  SetProp(P_SHORT, "Eine Skelettfledermaus flattert durch den Raum");
  SetProp(P_LONG, 
      "Du siehst eine daemonische Skelettfledermaus. Sie hat "
      "zwei Fluegel welche nicht mit Haut sondern mit "
      "Spinnweben ueberzogen sind. Ihre Fuesse bestehen aus "
      "vier langen Knochen, wobei jeder zu einer scharfen "
      "Kralle zusammenlaeuft. Ansonsten besteht ihr ganzer "
      "Koerper aus Knochen, nur an manchen Stellen sind "
      "noch einige modrige Fleischreste und Muskelfasern zu sehen.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 10, 60}));

  SetProp(P_AGGRESSIVE,
      ([P_GUILD: ([0: 0.3, "nekromanten": 0.0]) ]) );
  SetProp(P_NAME, "Skelettfledermaus");
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 30+random(20));
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nbrunnenpc","fledermaus","maus","skelett","skelettfledermaus"}));
  create_default_npc(14+random(3));
  AddClass(CL_FLYING);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_ALIGN, -350);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit ihren spitzen Krallen",185,DT_PIERCE})); 
  SetProp(P_SPELLRATE,20);
  SetProp(P_NOCORPSE, 1);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.2,    DT_BLUDGEON    :0.2,     DT_PIERCE     :-0.5,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :-0.2,    DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp (P_MNPC_AREA, ROOMS "level"+well_level()+"/");
  SetProp (P_MNPC_DEFAULTROOM,
      file_name(living(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS  + MOV_MOVES  + MOV_MAYLOAD);

  SetProp(P_HP_DELAY, 3-to_int(well_level())/3 );

  AddDefaultSpell(1, 300, DS_BLIND, 
      "Die Skelettfledermaus wirft Dir Knochenstaub in die Augen. Du bist blind.\n",
      "Die Skelettfledermaus wirft @WEM Knochenstaub in die Augen.\n");
  
  SetProp(P_DIE_MSG, " faellt auf den Boden und ist tot.\n");
  SetProp(P_NOCORPSE, 0 );
//  SetProp(P_MURDER_MSG, "");
//  SetProp(P_KILL_NAME, "");
//  SetProp(P_KILL_MSG, "");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  SUID;
}

