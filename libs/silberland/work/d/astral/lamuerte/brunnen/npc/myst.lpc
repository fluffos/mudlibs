#include "../def.h"

inherit NPC "std_well_npc";

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein mystischer Nebel truebt Deine Sicht");
  SetProp(P_LONG, 
  "Deine Sicht wird durch einen mystischen Nebel getruebt.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 10, 90}));
  
  SetProp(P_NOATTACK, "ist nicht zu treffen.");
  SetProp(P_NAME, "Nebel");
  SetProp(P_NAME_ADJ, "mystisch");
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 240+random(20));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","nebel","\nmyst", "NOT_LIVING"}));
  create_default_npc(5);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0); 
  SetProp(P_NOMAGIC,100);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");

  SetProp(P_DIE_MSG, " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );

  SetProp( P_REJECT, REJECT_DROP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  SetChats(1, ({
    "Deine Sicht wird durch den Nebel getruebt.\n",
    "Der mystische Nebel verzerrt die magischen Kraftlinien.\n",
    "Der mystische Nebel regeneriert Deine magischen Kraefte.\n",
    "Der mystische Nebel breitet sich im ganzen Raum aus.\n",
  }) );

  AddCmd( ({"norden", "sueden", "osten", "westen"}), "gehen" );

  SUID;
}

void heart_beat()
{
  object ob;
  ::heart_beat();
  for (ob=first_inventory(environment()); ob; ob=next_inventory(ob)) 
  {
    if (living(ob))
    {
      if( !random(3000) )
        ob->SetProp(P_SP, 0);
      else
        ob->AddSp(random(3+to_int(well_level())/3 ));
    }
  }
}

int gehen(string str)
{
  if(random(10) ) return 0;
  this_player()->command_me( ({"norden", "sueden", "osten", "westen"})[random(4)] );
  return 1;
}
