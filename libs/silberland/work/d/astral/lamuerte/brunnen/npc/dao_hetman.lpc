// ~Dao Hetman / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/dao_hetman.c
// ~Level:  45-48 
// ~Hands:  400,DT_COLD  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:0.1,BLUDGEON:0.2,PIERCE:0.1,SQUEEZE:0.1,WHIP:0.1,RIP:0.1,
// ~        FIRE:-0.2,COLD:-0.2,WATER:-0.2,AIR:-1,LIGHTNING:-0.2,EXPLOSION:0,SOUND:-0.3,
// ~        LIGHT:0,ELECTRIC:-0.2,ACID:-0.3,POISON:-0.2,TERROR:-0.3,HOLY:-0.2,UNHOLY:-0.2,MAGIC:0
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"


void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 


  SetProp(P_SHORT, "Ein Dao Hetman");
  SetProp(P_LONG, 
    "Ein grosses Wesen aus reinstem Eis steht vor Dir. Der Oberkoerper erinnert etwas an "
    "einen Menschen, der Unterleib hingegen besteht aus kaeltestem Eis. Sicher ist der "
    "Dao Hetman eine maechtige elementare Manifestation des Eises.");
  SetProp (P_MNPC_WAIT, ({5, 35, 25}));

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Dao Hetman");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 400);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","dao", "dao hetman", "hetman", "elementar"}));
  create_default_npc(45+random(3));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit eisiger Kaelte",450,({DT_COLD, DT_BLUDGEON})})); 
  SetProp(P_SPELLRATE, 60);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-1,      DT_WATER      :-0.3,   
    DT_AIR        :-0.3,    DT_LIGHTNING   :-0.3,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.3,    DT_LIGHT       :-0.2,    DT_ELECTRIC   :-0.3,    
    DT_ACID       :-0.3,    DT_POISON      :0.2,     DT_TERROR     :-0.3,     
    DT_HOLY       :-0.3,    DT_UNHOLY      :-0.3,    DT_MAGIC      :-0.2]) );
 
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "verbreitet hier seine Kaelte");
  SetProp(P_MSGOUT, "verbreitet seine Kaelte");

  SetProp(P_DIE_MSG, " schmilzt.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Ich habe die Eindringlinge besiegt, oh mein Khan!");
  SetProp(P_MURDER_MSG, "Ich habe versagt, oh mein Khan! %s war staerker als "
      "die Macht des Eises!");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(5,700,
      "Der Dao Hetman wirft eine Eislanze auf Dich.\n",
      "Der Dao Hetman wirft eine Eislanze auf @WEN.\n",
      DT_COLD, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1, 500, DS_MASS_DAMAGE,
      "Der Dao Hetman beschwoert einen Hagelsturm herbei.\n",
      "Der Dao Hetman beschwoert einen Hagelsturm herbei.\n",
      DT_COLD);
  AddDefaultSpell(1, 400, DS_SLOW,
      "Der Dao Hetman friert Dich ein.\n",
      "Der Dao Hetman friert @WEN ein.\n"); 
  AddSpell(1,800,
      "Der Dao Hetman laesst Deine Beine am Boden festfrieren!\n",
      "Der Dao Hetman laesst @WESSEN Beine am Boden festfrieren!\n",
      DT_COLD, "spell_hold", ([SP_SHOW_DAMAGE:1]));

  SUID;
}


void init()
{ 
  ::init();
  if( this_player() && this_player()->id("dao"))
    AddDefender(this_player());
  if (this_player() && this_player()->QueryProp("daokiller") > time())
   Kill(this_player());
}

void InformDefend(object enemy)
{ 
  Kill(enemy);
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{ 
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_COLD ) != -1){
    if(random(100)>40)
      tell_room(environment(), "  Der Dao Hetman fuehlt sich durch die Kaelte erfrischt.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  return ::Defend(dam, dtype, spell, enemy);
}

varargs void die( int poisondeath )
{
  if (this_player() && this_player()->QueryProp("daokiller") < time())
    this_player()->SetProp("daokiller", time() + 3600 * 3);
  ::die(poisondeath);
}

