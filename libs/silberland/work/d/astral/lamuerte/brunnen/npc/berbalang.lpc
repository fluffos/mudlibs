// ~(w) Lamuerte 2000
// ~Berbalang / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/berbalang.c
// ~Level:  10-15 
// ~Hands:  100,DT_RIP  WC: default AC: default 
// ~Spells: Rate: 1, Vergiftet Gegner
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein steinerner Gargyl sitzt auf dem Boden");
  SetProp(P_LONG, 
      "Du siehst einen Gargyl am Boden sitzen, der etwa die Groesse eines "
      "Zwerges hat. Er bewegt sich kaum, es scheint fast als waere er "
      "versteinert, doch der Schein truegt, denn ab und an siehst Du seine "
      "Muskelberge zucken. Sein Koerper gleicht dem eines Goblins, doch an "
      "seinem Ruecken kannst Du lange, sehr schwerfaellig aussehende Fluegel "
      "erkennen, an deren Spitze sich eine einzige, sehr spitze Kralle befindet.");

  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Berbalang");
  SetProp(P_RACE, "Gargyl");
  SetProp(P_SIZE, 90+random(60));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","gargyl","berbalang"}));
  create_default_npc(10+random(5));
  SetProp(P_ALIGN, -140);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen riesigen Klauen",150,DT_RIP})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "steigt herein");
  SetProp(P_MSGOUT, "steigt");

  SetProp(P_DIE_MSG, " kippt um und ist tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Naechstes mal vernichte ich Dich mit Sicherheit, %s!");
  SetProp(P_KILL_NAME, "Ein Berbalang");
  SetProp(P_KILL_MSG, "Endlich ist er tot!");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(1, 150,
     "  Der Berbalang sticht Dich mit seiner Fluegelspitze.\n",
     "  Der Berbalang sticht @WEN mit seiner Fluegelspitze.\n",
     DT_POISON, "spell_poison", ([SP_SHOW_DAMAGE:1]));

  SUID;
}
