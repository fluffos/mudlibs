// ~Marid Mufti / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/marid_mufti.c
// ~Level:  38-40 
// ~Hands:  350,DT_AIR  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:0.1,BLUDGEON:0.2,PIERCE:0.1,SQUEEZE:0.1,WHIP:0.1,RIP:0.1,
// ~        FIRE:-0.2,COLD:-0.2,WATER:-0.2,AIR:-1,LIGHTNING:-0.2,EXPLOSION:0,SOUND:-0.3,
// ~        LIGHT:0,ELECTRIC:-0.2,ACID:-0.3,POISON:-0.2,TERROR:-0.3,HOLY:-0.2,UNHOLY:-0.2,MAGIC:0
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Ein Marid Mufti");
  SetProp(P_LONG, 
    "Vor Dir steht ein hellblaues Wesen, dessen Oberkoerper menschenaehnliche "
    "Gestalt hat, desssen Unterkoerper aber in ein wirbelnde Fluessigkeit "
    "uebergeht. Sicher ist der Marid Mufti eine elementare Manifestation "
    "des Wassers.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({10, 10, 10}));

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Marid Mufti");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 200);
  SetProp(P_GENDER, MALE);

  if(objectp(PO))
    if(PO->id("marid padisha"))
      AddId("\nnofrags");

  AddId(({"\nbrunnenpc","marid", "marid mufti", "mufti", "elementar"}));
  create_default_npc(38+random(3));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit einer Flutwelle",400,({DT_BLUDGEON,DT_WATER})})); 
  SetProp(P_SPELLRATE, 50);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-0.2,    DT_WATER      :-1,    
    DT_AIR        :-0.2,    DT_LIGHTNING   :-0.2,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.3,    DT_LIGHT       :0,       DT_ELECTRIC   :-0.2,    
    DT_ACID       :-0.3,    DT_POISON      :-0.2,    DT_TERROR     :-0.3,     
    DT_HOLY       :-0.2,    DT_UNHOLY      :-0.2,    DT_MAGIC      :0]) );
 
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "fliesst herein");
  SetProp(P_MSGOUT, "fliesst");

  SetProp(P_DIE_MSG, " verrinnt im Boden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Ich habe die Eindringlinge besiegt, oh mein Padisha!");
  SetProp(P_MURDER_MSG, "Ich habe versagt, oh mein Padisha! %s war staerker als "
            "die Macht des Wassers!");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(5,500,
      "Der Marid Mufti versucht Dich zu ertraenken.\n",
      "Der Marid Mufti versucht @WEN zu ertraenken.\n",
      DT_WATER, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1, 400, DS_MASS_DAMAGE,
      "Der Marid Mufti beschwoert eine Sturmflut herbei.\n",
      "Der Marid Mufti beschwoert eine Sturmflut herbei.\n",
      DT_WATER);
  AddDefaultSpell(1, 300, DS_ANTIMAGIC,
      "Der Marid Mufti stoert Deine Konzentration.\n",
      "Der Marid Mufti stoert @WESSEN Konzentration.\n",
      3);
  AddSpell(1,500,
      "Der Marid Mufti spritzt magisches Gift in Deine Venen!\n",
      "Der Marid Mufti spritzt magisches Gift in Deine Venen!\n",
      DT_MAGIC, "spell_manadrain", ([SP_SHOW_DAMAGE:1]));


  SUID;
}

void init()
{
  ::init();
  if( this_player() && this_player()->id("marid"))
    AddDefender(this_player());
  if (this_player() && this_player()->QueryProp("maridkiller") > time())
    Kill(this_player());
}

void InformDefend(object enemy) 
{
  Kill(enemy);
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_WATER ) != -1){
    if(random(100)>40) 
      tell_room(environment(), "  Der Marid Mufti saugt das Wasser in sich auf.\n");
    this_object()->AddHp(dam);
    return 0;
  }
    return ::Defend(dam, dtype, spell, enemy);
}

varargs void die( int poisondeath )
{
  if (this_player() && this_player()->QueryProp("maridkiller") < time())
    this_player()->SetProp("maridkiller", time() + 3600 * 3);
  ::die(poisondeath);
}
