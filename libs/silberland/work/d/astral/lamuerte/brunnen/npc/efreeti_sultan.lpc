// ~Hands:  500,DT_FIRE WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:0.1,BLUDGEON:0.2,PIERCE:0.1,SQUEEZE:0.1,WHIP:0.1,RIP:0.1,
// ~        FIRE:-0.2,COLD:-0.2,WATER:-0.2,AIR:-1,LIGHTNING:-0.2,EXPLOSION:0,SOUND:-0.3,
// ~        LIGHT:0,ELECTRIC:-0.2,ACID:-0.3,POISON:-0.2,TERROR:-0.3,HOLY:-0.2,UNHOLY:-0.2,MAGIC:0
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Der Efreeti Sultan");
  SetProp(P_LONG, 
    "Vor Dir steht ein riesiges, in gluehend rote Flammen gehuelltes Wesen, "
    "dessen Oberkoerper menschenaehnliche Gestalt hat. Der Unterkoerper "
    "hingegen ist eine einzige grosse Flamme. Der Kopf des Efreeti Sultans "
    "wird von einer grossen Krone geschmueckt. Dies ist die groesste "
    "Manifestation eines Feuererelementars, die Du je zu Gesicht bekommen hast. "
    "Moeglicherweise ist dies sogar der Herrscher ueber das Element Feuer.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({5, 45, 50}));

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Efreeti Sultan");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 800);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","efreeti", "efreeti sultan", "sultan", "elementar"}));
  create_default_npc(55);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit Flammen",600,({DT_BLUDGEON,DT_FIRE})})); 
  SetProp(P_SPELLRATE, 80);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :-1,      DT_COLD        : 0.2,    DT_WATER      :0.2,   
    DT_AIR        :-0.5,    DT_LIGHTNING   :-0.5,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.5,    DT_LIGHT       :0,       DT_ELECTRIC   :-0.5,    
    DT_ACID       :-0.5,    DT_POISON      :-0.5,    DT_TERROR     :-0.5,     
    DT_HOLY       :-0.5,    DT_UNHOLY      :-0.5,    DT_MAGIC      :0]) );
 
  SetProp(P_NOMAGIC,55);

  SetProp(P_MSGIN, "brennt majestaetisch herein");
  SetProp(P_MSGOUT, "brennt majestaetisch ");

  SetProp(P_DIE_MSG, " verloescht.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Niemand besiegt den grossen Sultan aller Efreetis!");
  SetProp(P_MURDER_MSG, "Unmoeglich! Wie konntest Du nur den Herrscher " 
            "des Feuers bezwingen, %s?");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"sagt: Ich bin der Sultan aller Efreetis.");

  AddSpell(7,999,
      "Der Efreeti Sultan huellt Dich in Flammen ein.\n",
      "Der Efreeti Sultan huellt @WEN in Flammen ein.\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(5, 900, DS_MASS_DAMAGE,
      "Der Efreeti Sultan beschwoert einen Feuersturm herbei.\n",
      "Der Efreeti Sultan beschwoert einen Feuersturm herbei.\n",
      DT_FIRE);
  AddDefaultSpell(4, 800, DS_REDUCE_AC,
      "Der Efreeti Sultan verbrennt Deine Ruestung.\n",
      "Der Efreeti Sultan verbrennt @WESSEN Ruestung.\n");
  AddDefaultSpell(2, 1200, DS_REDUCE_WC,
      "Der Efreeti Sultan verbrennt Deine Waffe.\n",
      "Der Efreeti Sultan verbrennt @WESSEN Waffe.\n");
  AddSpell(4,1000,
      "Der Efreeti Sultan raubt Dir Deine Kraft!\n",
      "Der Efreeti Sultan raubt @WEM die Kraft!\n",
      DT_FIRE, "spell_strengthdrain", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1,
      "Der Efreeti Sultan holt einen seiner Untertanen zu Hilfe!\n",
      "Der Efreeti Sultan holt einen seiner Untertanen zu Hilfe!\n",
      DT_MIND, "clone_helper");

    SUID;

}


void init()
{ 
  ::init();
  if( this_player() && this_player()->id("efreeti"))
    AddDefender(this_player());
  if (this_player() && this_player()->QueryProp("efreetikiller") > time())
    Kill(this_player());
}

void InformDefend(object enemy)
{ 
  Kill(enemy);
}

varargs void clone_helper(object enemy, int damage, mixed dam_type)
{
  object ob;
  if(!present("efreeti 3", environment(this_object())))
  {
    ob=clone_object(NPC "efreeti_mushir.lpc");
    ob->move(environment(),M_GO);
    AddPursuer(ob);
  }
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{ 
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1){
    if(random(100)>40)
      tell_room(environment(), "  Der Efreeti Sultan fuegt das Feuer lachend seinen Flammend hinzu.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  if(!random(22)) clone_helper();
  return ::Defend(dam, dtype, spell, enemy);
}

varargs void die( int poisondeath )
{
  this_player()->SetProp("efreetikiller", time() + 3600 * 24 * 3);
  ::die(poisondeath);
}
