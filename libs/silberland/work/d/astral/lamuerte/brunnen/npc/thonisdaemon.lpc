// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/sturmdaemon.c
// ~Level:  32-34 
// ~Hands:  500,DT_SLASH  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.2,BLUDGEON:-0.2,PIERCE:-0.2,SQUEEZE:-0.2,WHIP:-0.2,RIP:-0.2,
// ~        FIRE:-0.4,COLD:-0.4,WATER:-0.4,AIR:0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:-0.3,POISON:0.2,TERROR:-0.3,HOLY:0.1,UNHOLY:-0.5,MAGIC:-0.3
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Ein riesiger Daemon steht hier");
  SetProp(P_LONG, 
  "Vor Dir siehst Du den riesengrossen Thonis Daemon, bzw Du siehst nur seine "
  "Fuesse und Beine, der Rest von diesem Daemon ist so weit ueber Dir, dass Du "
  "den Kopf ganz in den Nacken legen musst, um irgendetwas zu sehen. Der Thonis "
  "Daemon hat eine schwarze, schuppige Haut, an der staendig eine oelige "
  "Fluessigkeit herunterrinnt. Er hat mindestens sechs Arme, soweit Du das "
  "von hier unten beurteilen kannst.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({50, 50, 50}));

  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_NAME, "Thonis Daemon");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 2000);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","thonisdaemon", "thonis", "thonis daemon", "daemon"}));
  create_default_npc(42+random(3));
  SetProp(P_ALIGN, -750);
  SetProp(P_MAX_HANDS, 6); 
  SetProp(P_HANDS, ({" mit seiner Daemonenmacht",440,({DT_UNHOLY, DT_BLUDGEON}) })); 
  SetProp(P_SPELLRATE, 80);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.2,    DT_BLUDGEON    :-0.2,    DT_PIERCE     :-0.2,
    DT_SQUEEZE    :-0.2,    DT_WHIP        :-0.2,    DT_RIP        :-0.2,
    DT_FIRE       :-0.4,    DT_COLD        :-0.4,    DT_WATER      :-0.4,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0,
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :-0.3,    DT_POISON      :0.2,     DT_TERROR     :-0.3,     
    DT_HOLY       :0.1,     DT_UNHOLY      :-0.5,    DT_MAGIC      :-0.3]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");

  SetProp(P_DIE_MSG, " faellt in sich zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "Hahaha! Du Winzling!");
  SetProp(P_MURDER_MSG, "Das naechste Mal zerstampfe ich Dich Winzling, %s!");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(5,1200,
      "Der Thonis Daemon zerstampft Dich.\n",
      "Der Thonis Daemon zerstampft Dich.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(2, 600, DS_MASS_DAMAGE,
      "Der Thonis Daemon schlaegt wild um sich.\n",
      "Der Thonis Daemon schlaegt wild um sich.\n",
      DT_SQUEEZE);
  AddDefaultSpell(1, 100, DS_FROG);
  SUID;
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  SetProp(P_SKILL_ATTRIBUTES, 0);
  return ::Defend(dam, dtype, spell, enemy);
}

int _query_disable_attack() { return 0; }

int _query_disable_spells() { return 0; }

int _query_wimpy() { return 0; }
