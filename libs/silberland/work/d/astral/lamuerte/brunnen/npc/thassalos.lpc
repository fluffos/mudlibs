// ~(w) Feyaria 2002
// ~Thassalos / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/thassalos.c
// ~Level:  35-37 
// ~Hands:  500,DT_SLASH  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:-0.1,BLUDGEON:0.4,PIERCE:-0.8,SQUEEZE:0.2,WHIP:-0.1,RIP:-0.1,
// ~        FIRE:-0.4,COLD:-0.4,WATER:0.2,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0.2,ELECTRIC:0,ACID:-0.3,POISON:-0.5,TERROR:-0.3,HOLY:0.1,UNHOLY:-0.5,MAGIC:-0.3
// ~Special: 

#include "../def.h"

inherit "/p/std/npc/nekro_npc";
inherit "std/npc/spells";

#include "./functions.h"
#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Brunnennpcs!");
    destruct();
    return;
  }

  SetProp(P_SHORT, "Ein grosses Skelett mit gluehend roten Augen");
  SetProp(P_LONG, 
  "Bei dieser skelettartigen Kreatur muss es sich um einen Thassalos handeln. "
  "Seine Augen gluehen in diabolischem Rot und seine klauenbesetzten Haende "
  "machen sich bereit Dich zu erwuergen.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({50, 50, 50}));

  SetProp(P_AGGRESSIVE,
      ([P_GUILD: ([0: 0.1+0.07*to_int(well_level()), "nekromanten": 0.0]) ]) );
  SetProp(P_NAME, "Thassalos");
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 200);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","thassalos","skelett"}));
  create_default_npc(35+random(3));
  SetProp(P_ALIGN, -750);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen Skeletthaenden",350,({DT_UNHOLY, DT_RIP}) })); 
  SetProp(P_SPELLRATE, 50);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.3,    DT_BLUDGEON    :0.4,     DT_PIERCE     :-0.8,
    DT_SQUEEZE    :0.2,     DT_WHIP        :-0.3,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-0.4,    DT_WATER      :-0.2,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0,
    DT_SOUND      :0,       DT_LIGHT       :0.2,     DT_ELECTRIC   :0,    
    DT_ACID       :-0.3,    DT_POISON      :-0.5,    DT_TERROR     :-0.3,     
    DT_HOLY       :0.1,     DT_UNHOLY      :-0.5,    DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "kommt an und starrt Dich mit gluehenden Augen an");
  SetProp(P_MSGOUT, "verzieht sich");
  SetProp (P_MNPC_AREA, ROOMS "level"+well_level()+"/");
  SetProp (P_MNPC_DEFAULTROOM,
      file_name(living(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS  + MOV_MOVES  + MOV_MAYLOAD);

  SetProp(P_HP_DELAY, 3-to_int(well_level())/3 );

  SetProp(P_DIE_MSG, " verfaellt zu einem Knochenhaufen.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Verrotte in der Hoelle!!");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(10,500,
      "Der Thassalos reisst Dir fast das Herz heraus.\n",
      "Der Thassalos reisst @WEM fast das Herz heraus.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(7, 300, DS_ANTIMAGIC,
      "Der Thassalos blickt Dich mit seinen gluehend roten Augen an.\n",
      "Der Thassalos blickt @WEN mit seinen gluehend roten Augen an.\n",
      5);
  AddSpell(5,700,
      "Der Thassalos raubt Dir Deine Kraft.\n",
      "Der Thassalos raubt @WEM die Kraft.\n",
      DT_MAGIC, "spell_strengthdrain", ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(2, 200, DS_CURSE_ARMOUR,
      "Der Thassalos verflucht Dich.\n",
      "Der Thassalos verflucht  @WEN.\n");
  AddDefaultSpell(1, 300, DS_CURSE_WEAPON,
      "Der Thassalos verflucht Dich.\n",
      "Der Thassalos verflucht  @WEN.\n");
  SUID;
}

