// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/tessalgorgon.c
// ~Level:  40-42
// ~Hands:  385,DT_RIP   WC: default AC: default 
// ~R.Str:  SLASH:-0.4,BLUDGEON:-0.4,PIERCE:-0.4,SQUEEZE:-0.4,WHIP:-0.4,RIP:-0.4,
// ~        FIRE:0,COLD:-0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0.5,POISON:0,TERROR:-0.4,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Paralysiert

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein riesiges, bullenartiges Wesen mit metallischen Schuppen");
  SetProp(P_LONG, 
  "Ein riesieger Tessalgorgon steht vor Dir. Seine Koerperform erinnert Dich "
  "an einen Stier. Doch seine Haut besteht nicht aus Fleisch und Blut sondern "
  "scheint mit einer dicken Eisenschicht ueberzogen zu sein. Diese Schicht "
  "besteht aus unzaehligen Metallschuppen, welche Dich an die Schuppen "+
  "eines Drachen erinnern, jedoch sind sie um einiges kleiner. Nimm Dich in "
  "Acht, diese Monster sind Meister der Paralyse.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.3+0.07*to_int(well_level()));
  SetProp(P_NAME, "Tessalgorgon");
  SetProp(P_RACE, "Gorgone");
  SetProp(P_SIZE, 245+random(33));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","gorgone","gorgon", "tesaalgorgon", "tessalgorgone"}));
  create_default_npc(40+random(3));
  SetProp(P_ALIGN, -120);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem metallenen Hoernern",385,DT_PIERCE})); 
  SetProp(P_SPELLRATE,40);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.4,    DT_BLUDGEON    :-0.6,    DT_PIERCE     :-0.2,
    DT_SQUEEZE    :-0.6,    DT_WHIP        :-0.6,    DT_RIP        :-0.4,
    DT_FIRE       :0,       DT_COLD        :-0.3,    DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0.4,     DT_POISON      :0,       DT_TERROR     :-0.4,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "geht herein");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG, " fallt zu einem Haufen Metall zusammen.\n");
  SetProp(P_MURDER_MSG, "Wie konntest Du nur meiner Paralyse entkommen, %s?");
  SetProp(P_KILL_MSG, "Niemand entkommt meiner Paralyse!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");

  AddDefaultSpell(2,900,DS_PARALYZE,
       "  Der Tessalgorgon paralysiert Dich.\n",
       "  Der Tessalgorgon paralysiert @WEN.\n");
  AddSpell(1, 800,
       "  Der Tessalgorgon trifft Dich mit seinen Hoernern.\n",
       "  Der Tessalgorgon trifft @WEN mit seinen Hoernern.\n",
       DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );



  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Der Tessalgorgon scheint Dich paralysieren zu wollen.\n",
    "Die Metallschuppen des Tessalgorgons knarren, als er sich ein weinig bewegt.\n",
    "Der Tessalgorgon schaut Dich boese an.\n",
  }) );

  SUID;
}
