// ~Violetter Fungus / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/fungus.c
// ~Level:  10-15 
// ~Hands:  195,DT_BLUDGEON  WC: default AC: default 
// ~Spells: (Rate: 1, Steckt Gegner mit Malaria an
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein violetter Fungus");
  SetProp(P_LONG, 
      "Du siehst einen etwa eineinhalb meter grossen, violett gestreiften "
      "Fungus vor Dir. Bei diesem Wesen handelt sich um eines spezielle Art "
      "eines Pilzungetuems. Seine abschreckende violette Farbe zeugt davon, "
      "dass es mit vorliebe Krankheitserreger verbreitet. Sein Koerper sieht "
      "aus, als ob es beinahe selbst dem Tode nahe waere, doch es lebt in "
      "Symbiose mit seinen Krankheitserregern und kann so gut leben.");
  //SetProp(P_ARTICLE,0);
  SetProp(P_MNPC_FLAGS, 0);
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Fungus");
  SetProp(P_RACE, "Pilzwesen");
  SetProp(P_SIZE, 90+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","pilz","wesen","pilzwesen","fungus"}));
  create_default_npc(10+random(5));
  SetProp(P_ALIGN, 80);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen zerschlissenen Haenden",195,DT_BLUDGEON})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "steigt herein");
  SetProp(P_MSGOUT, "steigt");

  SetProp(P_DIE_MSG, " kippt um und ist tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Naechstes mal vernichte ich Dich mit Sicherheit, %s!");
  SetProp(P_KILL_NAME, "Ein violetter Fungus");
  SetProp(P_KILL_MSG, "Endlich ist er tot!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(1, 100,
     "  Der Fungus versucht Dich mit seiner Krankheit anzustecken.\n",
     "  Der Fungus versucht @WEN mit einer Krankheit anzustecken.\n",
     DT_POISON, "spell_flue", ([SP_SHOW_DAMAGE:1]));

    SUID;

}
