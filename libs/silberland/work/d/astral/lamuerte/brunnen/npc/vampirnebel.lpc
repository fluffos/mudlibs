// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/vampir.c
// ~Level:  15-25 
// ~Hands:  195,DT_BLUDGEON  WC: default AC: default 
// ~Spells: (Rate: 1, Steckt Gegner mit Malaria an
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER-0.3,AIR:-0.3,LIGHTNING:0.3,EXPLOSION:-1,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:-0.3,POISON:-0.3,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: bloodloss spell

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Vampirnebel");
  SetProp(P_LONG, 
      "Nebel zieht vor Dir auf. Ein graues Gebilde zieht vor Dir im Raum "
      "herum. Es ist beinahe unsichtbar was es schwierig macht es zu treffen. "
      "Das Wesen gehoert zu der Rasse der Daemonen, besser gesagt zu "
      "den Blutsaugerdaemonen, welche verrueckt nach Blut sind. Es kann Dir "
      "sehr gefaerlich werden, also lass es besser sein und geh weiter.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  //SetProp(P_ARTICLE,1);
  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Vampirnebel");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 190+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","nebel","vampirnebel"}));
  create_default_npc(15+random(5));
  AddClass(CL_FLYING);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit einer giftigen Nebelschwade",195,({DT_BLUDGEON,DT_POISON})})); 
  SetProp(P_SPELLRATE,30);
  SetProp(P_NOCORPSE, 1 );

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0.3,     DT_EXPLOSION  :-1, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :-0.3,    DT_POISON      :-0.3,    DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,65);

  SetProp(P_MSGIN, "zieht herein");
  SetProp(P_MSGOUT, "zieht");

  SetProp(P_DIE_MSG, " verschwindet.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Wir sprechen uns noch einmal, %s!");
  SetProp(P_KILL_NAME, "Ein Vampirnebel");
  SetProp(P_KILL_MSG, "Dein Blut gehoert nun mir! Hahah!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(1, 200,
     "  Der Vampirnebel saugt Dir Blut ab.\n",
     "  Der Vampirnebel saugt @WEM Blut ab.\n",
     DT_POISON, "spell_bloodloss", ([SP_SHOW_DAMAGE:1]));

  SUID;
}

