// ~Djinni Wesier / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/djinni_wesier.c
// ~Level:  45-47 
// ~Hands:  400,DT_AIR  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:0.1,BLUDGEON:0.2,PIERCE:0.1,SQUEEZE:0.1,WHIP:0.1,RIP:0.1,
// ~        FIRE:-0.2,COLD:-0.2,WATER:-0.2,AIR:-1,LIGHTNING:-0.2,EXPLOSION:0,SOUND:-0.3,
// ~        LIGHT:0,ELECTRIC:-0.2,ACID:-0.3,POISON:-0.2,TERROR:-0.3,HOLY:-0.2,UNHOLY:-0.2,MAGIC:0
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Ein Djinni Wesier");
  SetProp(P_LONG, 
  "Ein grosser Luftwirbel mit einem menschenaehnlichen Oberkoerper, so kann man den "
  "Djinni Wesier am besten beschreiben. Er scheint tatsaechlich eine elementare "
  "Manifestation der Luft zu sein. Er ist sicher doppelt so gross wie ein Djinni "
  "Malik und auch sicher viel gefaehrlicher.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({10, 10, 10}));

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Djinni Wesier");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 400);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","djinni", "djinni wesier", "wesier", "elementar"}));
  AddClass(CL_FLYING);
  create_default_npc(45+random(3));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit einem Luftwirbel",450,({DT_BLUDGEON,DT_AIR})})); 
  SetProp(P_SPELLRATE, 60);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      : 0.1,    DT_BLUDGEON    :0.2,     DT_PIERCE     : 0.1,
    DT_SQUEEZE    : 0.1,    DT_WHIP        :0.1,     DT_RIP        : 0.1,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :-1,      DT_LIGHTNING   :-0.3,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.3,    DT_LIGHT       :0,       DT_ELECTRIC   :-0.3,    
    DT_ACID       :-0.3,    DT_POISON      :-0.3,    DT_TERROR     :-0.4,     
    DT_HOLY       :-0.3,    DT_UNHOLY      :-0.3,    DT_MAGIC      :0]) );
 
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");

  SetProp(P_DIE_MSG, " loest sich in Luft auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Ich habe die Eindringlinge besiegt, oh mein Kalif!");
  SetProp(P_MURDER_MSG, "Ich habe versagt, oh mein Kalif! %s war staerker als "
            "die Macht der Luefte!");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(5,700,
      "Der Djinni Wesier laesst einen Windstoss auf Dich los.\n",
      "Der Djinni Wesier laesst einen Windstoss auf @WEN los.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1, 500, DS_MASS_DAMAGE,
      "Der Djinni Wesier beschwoert eine Windhose herbei.\n",
      "Der Djinni Wesier beschwoert eine Windhose herbei.\n",
      DT_AIR);
  AddDefaultSpell(1, 400, DS_BLIND,
      "Der Djinni Wesier blaest Dir Schmutz in die Augen.\n",
      "Der Djinni Wesier blaest @WEM Schmutz in die Augen.\n",
      4);
  AddDefaultSpell(1, 400, DS_MASS_BLIND,
      "Der Djinni Wesier blendet Dich.\n",
      "Der Djinni Wesier blendet Dich.\n",
      3);
  AddSpell(1,700,
      "Der Djinni Wesier verwirrt Deinen Geist!\n",
      "Der Djinni Wesier verwirrt @WESSEN Geist!\n",
      DT_MAGIC, "spell_brainstorm", ([SP_SHOW_DAMAGE:1]));
  SUID;
}


void init()
{ 
  ::init();
  if (this_player() && this_player()->id("djinni"))
    AddDefender(this_player());
 if (this_player() && this_player()->QueryProp("djinnikiller") > time())
   Kill(this_player());
}

void InformDefend(object enemy)
{ 
  Kill(enemy);
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{ 
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_AIR ) != -1){
    if(random(100)>40)
      tell_room(environment(), "  Der Djinni Wesier freut sich ueber die frische Luft.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  return ::Defend(dam, dtype, spell, enemy);
}

varargs void die( int poisondeath )
{
  if (this_player() && this_player()->QueryProp("djinnikiller") < time())
    this_player()->SetProp("djinnikiller", time() + 3600 * 3);
  ::die(poisondeath);
}
