// ~Eisfrosch / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/eisfrosch.c
// ~Level:  15 + Brunnenlevel 
// ~Hands:  190,DT_COLD WC: default AC: default 
// ~Spells: 
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0.3,COLD:-0.6,WATER:0,AIR:0,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Eisfrosch");
  SetProp(P_LONG, 
      "Ein etwa einen Meter grosses, weisses Wesen steht vor Dir. Es hat "
      "die Form eines Frosches, doch es ist viel groesser als ein Laubfrosch "
      "und nicht aus Fleisch und Blut sondern aus steinhartem Eis. "
      "An seinem Schaedel befinden sich unzaehlige, aus Eis geformte Dornen, "
      "welche dieses Wesen zum Aufspiessen seiner Gegner benutzt.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Eisfrosch");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 80+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","wesen","frosch","eisfrosch"}));
  create_default_npc(15+(to_int(well_level())));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HANDS, ({" mit seinen eisigen Dornen",190+(to_int(well_level())*to_int(well_level())),({DT_RIP, DT_COLD})}));
  SetProp(P_SPELLRATE,(20+random((to_int(well_level())*3))));

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0.3,     DT_COLD        :-1,      DT_WATER      :0,    
    DT_AIR        :0,       DT_LIGHTNING   :0,       DT_EXPLOSION  :0.2, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0.2,     DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "schlittert herein");
  SetProp(P_MSGOUT, "schlittert");

  SetProp(P_DIE_MSG, " schmilzt vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Eisfrosch");
  SetProp(P_KILL_MSG, "War ich Dir zu kalt?");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddDefaultSpell(10,300+to_int(well_level()), DS_MASS_DAMAGE,
      "Der Eisfrosch friert Dich mit eisiger Kaelte ein.\n", 
      "Der Eisfrosch friert Dich mit eisiger Kaelte ein.\n", 
      DT_COLD);
  AddDefaultSpell(1, 100, DS_FROG);

  SUID;
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{ 
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_COLD ) != -1){
    if(random(100)>40)
      tell_room(environment(), "  Der Eisfrosch fuehlt sich durch die Kaelte erfrischt.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  return ::Defend(dam, dtype, spell, enemy);
}

