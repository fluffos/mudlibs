// ~Level:  55 
// ~Hands:  500,DT_WATER  WC: default AC: default 
// ~Spells: keine,
// ~R.Str:  SLASH:0.1,BLUDGEON:0.2,PIERCE:0.1,SQUEEZE:0.1,WHIP:0.1,RIP:0.1,
// ~        FIRE:-0.2,COLD:-0.2,WATER:-0.2,AIR:-1,LIGHTNING:-0.2,EXPLOSION:0,SOUND:-0.3,
// ~        LIGHT:0,ELECTRIC:-0.2,ACID:-0.3,POISON:-0.2,TERROR:-0.3,HOLY:-0.2,UNHOLY:-0.2,MAGIC:0
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Der Marid Padisha");
  SetProp(P_LONG, 
    "Vor Dir steht ein riesiges blaues Wesen, dessen Oberkoerper "
    "menschenaehnliche Gestalt hat. Der Unterkoerper jedoch besteht aus "
    "einer wirbelnden Fluessigkeit. Der Kopf des Marid Padishas wird von "
    "einer grossen Krone geschmueckt. Dies ist die groesste Manifestation "
    "eines Wasserelementars, die Du je zu Gesicht bekommen hast. "
    "Moeglicherweise ist dies sogar der Herrscher ueber das Element Wasser.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({10, 20, 20}));

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Marid Padisha");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 800);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","marid", "marid padisha", "padisha", "elementar"}));
  create_default_npc(55);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit einer Flutwelle",600,({DT_BLUDGEON,DT_WATER})})); 
  SetProp(P_SPELLRATE, 80);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-0.5,    DT_WATER      :-1,    
    DT_AIR        :-0.5,    DT_LIGHTNING   :-0.5,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.5,    DT_LIGHT       :0,       DT_ELECTRIC   :-0.5,    
    DT_ACID       :-0.5,    DT_POISON      :-0.5,    DT_TERROR     :-0.5,     
    DT_HOLY       :-0.5,    DT_UNHOLY      :-0.5,    DT_MAGIC      :0]) );
 
  SetProp(P_NOMAGIC,55);

  SetProp(P_MSGIN, "fliesst majestaetisch herein");
  SetProp(P_MSGOUT, "fliesst majestaetisch");

  SetProp(P_DIE_MSG, " verrinnt im Boden.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Niemand besiegt den grossen Padisha aller Marids!");
  SetProp(P_MURDER_MSG, "Unmoeglich! Wie konntest Du nur den Herrscher " 
            "des Wassers bezwingen, %s?");

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"sagt: Ich bin der Padisha aller Marids.");

  AddSpell(8,999,
      "Der Marid Padisha versucht Dich zu ertraenken.\n",
      "Der Marid Padisha versucht @WEN zu ertraenken.\n",
      DT_WATER, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(6, 900, DS_MASS_DAMAGE,
      "Der Marid Padisha beschwoert eine Sturmflut herbei.\n",
      "Der Marid Padisha beschwoert eine Sturmflut herbei.\n",
      DT_WATER);
  AddDefaultSpell(2, 1200, DS_ANTIMAGIC,
      "Der Marid Padisha stoert Deine Konzentration.\n",
      "Der Marid Padisha stoert @WESSEN Konzentration.\n",
      3);
  AddDefaultSpell(4, 800, DS_MASS_DEAF,
      "Der Marid Padisha spritzt Wasser in Deine Ohren.\n",
      "Der Marid Padisha spritzt Wasser in Deine Ohren.\n",
      60);
  AddSpell(6,1000,
      "Der Marid Padisha spritzt magisches Gift in Deine Venen!\n",
      "Der Marid Padisha spritzt magisches Gift in Deine Venen!\n",
      DT_MAGIC, "spell_manadrain", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1,
      "Der Marid Padisha holt einen seiner Untertanen zu Hilfe!\n",
      "Der Marid Padisha holt einen seiner Untertanen zu Hilfe!\n",
      DT_MIND, "clone_helper");

    SUID;

}

void init()
{
  ::init();
  if( this_player() && this_player()->id("marid"))
    AddDefender(this_player());
  if (this_player() && this_player()->QueryProp("maridkiller") > time())
    Kill(this_player());
}

void InformDefend(object enemy) 
{
  Kill(enemy);
}

varargs void clone_helper(object enemy, int damage, mixed dam_type)
{
  object ob;
  if(!present("marid 3", environment(this_object())))
  {
    ob=clone_object(NPC "marid_mufti");
    ob->move(environment(),M_GO);
    AddPursuer(ob);
  }
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_WATER ) != -1){
    if(random(100)>40) 
      tell_room(environment(), "  Der Marid Padisha saugt das Wasser in sich auf.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  if(!random(22)) clone_helper();
  return ::Defend(dam, dtype, spell, enemy);
}

varargs void die( int poisondeath )
{
  if (this_player() && this_player()->QueryProp("maridkiller") < time())
    this_player()->SetProp("maridkiller", time() + 3600 * 24 * 3);
  ::die(poisondeath);
}
