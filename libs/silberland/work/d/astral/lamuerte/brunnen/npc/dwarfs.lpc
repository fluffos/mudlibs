void create()
{
  object ob;
  string myname;
  int x;
  
  x=sizeof(dwarv_names);
  if(random(50)>20)
    myname=(string)dwarv_names[random(x)][0]+dwarv_names[random(x)][1];
  else
    myname=(string)dwarv_names[random(x)][0]+dwarv_names[random(x)][2];

  if (!is_clone(this_object())) return;
  
  ::create(); 
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Brunnennpcs!");
    destruct();
    return;
  }
  
  SetProp(P_SHORT, myname+", der untote Zwerg");
  SetProp(P_LONG, 
      "Vor Dir steht ein kleiner untoter Zwerg. Er hat Aehnlichkeit mit "
      "einem Zombie. Hautfetzen haengen von seinem Gesicht herunter und "
      "seine Kleidung, oder besser das was davon noch uebrig ist, ist "
      "verfault, stinkend und loechrig. Er duerfte wohl aus Valhalla "
      "verbannt worden sein und fristet nun sein Leben als Untoter weiter, "
      "bis ihn jemand davon befreit. Seine blutroten Augen "
      "starren Dich an als ob er sich jeden Moment auf Dich stuerzen wollte.");
  SetProp (P_MNPC_WAIT, ({30, 40, 50}));

  SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,
      ([P_GUILD: ([0: 0.3, "nekromanten": 0.0]) ]) );
  SetProp(P_NAME, myname);
  SetProp(P_KILL_NAME, "Ein untoter Zwerg");
  SetProp(P_RACE, "Untoter");
  AddClass(CL_DWARF);
  SetProp(P_SIZE, 95+random(33));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","zwerg","untoter",lower_case(myname)}));
  create_default_npc(20+(to_int(well_level())));
  SetProp(P_ALIGN, -170);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen",
        200+(2*to_int(well_level())*to_int(well_level())),DT_SLASH}));
  SetProp(P_SPELLRATE,(10+random((to_int(well_level())*3))));
  SetProp(P_NOCORPSE, 1);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.4,    DT_BLUDGEON    :0.4,     DT_PIERCE     :-0.4,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :-0.2,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :-0.4,    DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0.2]) );
  
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "schleift seinen Koerper herein");
  SetProp(P_MSGOUT, "schleift seinen Koerper");

  SetProp(P_DIE_MSG, " wurde von seinem Fluch als Untoter erloest.\n");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");

  AddDefaultSpell(1,400,DS_MASS_DAMAGE,
       "  "+myname+" trifft Dich mit einem Rundumschlag.\n",
       "  "+myname+" trifft Dich mit einem Rundumschlag.\n",
       DT_PIERCE);


  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Die Augen des untoten Zwerges starren Dich an.\n",
    "Der untote Zwerg klappert mit seinen Zaehnen.\n",
    "Der untote Zwerg lacht ueber Dich.\n",
  }) );

  SUID;
  ob=clone_object("/d/gebirge/angrox/obj/kettenhemd_rost");
  ob->move(this_object());
  ob->DoWear();
}
