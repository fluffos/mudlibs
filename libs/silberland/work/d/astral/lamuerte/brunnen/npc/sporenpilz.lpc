// ~(w) Lamuerte 2000
// ~Sporenpilz / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/sporenpilz.c
// ~Level:  15-20 
// ~Hands:  185,DT_AIR   WC: default AC: default 
// ~Spells: (Rate: 1) Vergiftet seine Gegner mit 1+random(2)
// ~        (Rate: 9) 20+random(230) DT_FIRE Air
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:-0.3,AIR:-0.3,LIGHTNING:-0.5,EXPLOSION:0,SOUND:0.3,
// ~        LIGHT:0,ELECTRIC:-0.3,ACID:0,POISON:-1,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Sporenpilz waechst hier aus dem Boden");
  SetProp(P_LONG, 
      "Ein etwa einen Meter grosses, dunkelweisses Wesen steht "
      "vor Dir. Es hat die Form eines Pilzes, jedoch siehst "
      "Du, dass es kleine Haende und Beine besitzt. Seine "
      "stachelige Haut ist mit giftigen Sporen uebersaeht. "
      "Ab und zu scheint einer der Sporen zu platzen wobei "
      "ein giftiger Nebel entstehen zu scheint, jedoch "
      "passiert dies viel zu schnell als das man es genauer sehen koennte.");
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  SetProp (P_MNPC_FLAGS, 0);

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Sporenpilz");
  SetProp(P_RACE, "Pilzwesen");
  SetProp(P_SIZE, 90+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","pilz","wesen","pilzwesen","sporenpilz"}));
  create_default_npc(18+random(5));
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen staubigen Haenden",225,({DT_BLUDGEON,DT_AIR})})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :-0.5,    DT_EXPLOSION  :0, 
    DT_SOUND      :0.3,     DT_LIGHT       :0,       DT_ELECTRIC   :-0.3,    
    DT_ACID       :0.3,     DT_POISON      :-1,      DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "kommt beinahe schwebend herein");
  SetProp(P_MSGOUT, "schwebt");

  SetProp(P_DIE_MSG, " verpufft vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das nachste mal bereite ich mich besser auf den Kampf vor, %s!");
  SetProp(P_KILL_NAME, "Ein Sporenpilz");
  SetProp(P_KILL_MSG, "Ah, Rache tut gut!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Einige Sporen des Sporenpilzes scheinen ueber seinen Koerper zu gleiten.\n",
    "Die Sporen des Sporenpilzes verbreiten eine giftige Wolke in diesem Raum.\n",
    "Der Sporenpilz scheint angriffslustig zu sein.\n",
  }) );

  AddSpell(9, 320+random(130),
     "  Du bekommst kaum noch Luft als der Pilz Dir Sporen ins Gesicht schleudert.\n",
     "  Der Sporenpilz nimmt @WEM die Luft zum Atmen.\n",
     DT_AIR,  ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 200,
     "  Der Sporenpilz wirft Dir giftige Sporen ins Gesicht!\n",
     "  Der Sporenpilz vergiftet @WEN.\n",
     DT_POISON, "spell_poison", ([SP_SHOW_DAMAGE:1]));
  
  SUID;
}


