// ~Sandwesen / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/boudler.c
// ~Level:  10-15 
// ~Hands:  80,DT_BLUDGEON  WC: default AC: default 
// ~R.Str:  SLASH:0,BLUDGEON:0,PIERCE:0,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.3,COLD:-0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:Wird von Galebdur summoned im kampf.                                       

#include "../def.h"

inherit NPC "std_well_npc";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Boulder");
  SetProp(P_LONG, 
      "Dieses eigenartige Monster tritt nur in Kombination mit sogenannten "
      "Galebdur auf. Die Boulder werden von den Galebdur im Kapf "
      "herbeigezaubert um ihnen zu helfen ihre Gegner zu besiegen. "
      "Dieser Boulder besteht aus Granit und erinnert an einen "
      "ueberdimenional grossen Steinwuerfel. Auch wenn ein Boulder nicht "
      "besonders stark ist, mehrere auf einmal koennen schon gefaehrlich sein.");
  SetProp (P_MNPC_FLAGS, 0);

  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Boulder");
  SetProp(P_RACE, "Golem");
  SetProp(P_SIZE, 50+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","boulder","wuerfel", "\nnofrags"}));
  create_default_npc(10+random(5));
  SetProp(P_ALIGN, -80);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem steinernen Koerper",130,DT_BLUDGEON})); 

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0,       DT_BLUDGEON    :0,       DT_PIERCE     :0,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "wuerfelt herein");
  SetProp(P_MSGOUT, "wuerfelt");

  SetProp(P_DIE_MSG, " zerwuerfelt.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  SUID;
}
