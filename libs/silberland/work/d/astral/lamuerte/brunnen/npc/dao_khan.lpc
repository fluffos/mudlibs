// ~Spells: keine,
// ~R.Str:  SLASH:0.1,BLUDGEON:0.2,PIERCE:0.1,SQUEEZE:0.1,WHIP:0.1,RIP:0.1,
// ~        FIRE:-0.2,COLD:-0.2,WATER:-0.2,AIR:-1,LIGHTNING:-0.2,EXPLOSION:0,SOUND:-0.3,
// ~        LIGHT:0,ELECTRIC:-0.2,ACID:-0.3,POISON:-0.2,TERROR:-0.3,HOLY:-0.2,UNHOLY:-0.2,MAGIC:0
// ~Special: 

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

#include "./spells.h"


void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Der Dao Khan");
  SetProp(P_LONG, 
    "Ein grosses Wesen aus reinstem Eis steht vor Dir. Der Oberkoerper "
    "erinnert etwas an einen Menschen, der Unterleib hingegen besteht aus "
    "kaeltestem Eis. Der Kopf des Dao Khan wird von einer grossen Krone "
    "geschmueckt. Der Dao Khan ist die groesste Manifestation eines "
    "Eiselementars, die Du je zu Gesicht bekommen hast. Moeglicherweise ist "
    "dies sogar der Herrscher ueber das Element Eis.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({5, 25, 50}));

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Dao Khan");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 800);
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","dao", "dao khan", "khan", "elementar"}));
  create_default_npc(55);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit eisiger Kaelte",600,({DT_BLUDGEON, DT_COLD})})); 
  SetProp(P_SPELLRATE, 80);
  
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-1,      DT_WATER      :-0.5,   
    DT_AIR        :-0.5,    DT_LIGHTNING   :-0.5,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.5,    DT_LIGHT       :-0.2,    DT_ELECTRIC   :-0.5,    
    DT_ACID       :-0.5,    DT_POISON      :0.2,     DT_TERROR     :-0.5,     
    DT_HOLY       :-0.5,    DT_UNHOLY      :-0.5,    DT_MAGIC      :-0.4]) );
 
  SetProp(P_NOMAGIC,55);

  SetProp(P_MSGIN, "verbreitet hier seine majestaetische Kaelte");
  SetProp(P_MSGOUT, "verbreitet seine Kaelte");

  SetProp(P_DIE_MSG, " schmilzt.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Niemand besiegt den grossen Khan aller Daos!");
  SetProp(P_MURDER_MSG, "Unmoeglich! Wie konntest Du nur den Herrscher "
      "des Eises bezwingen, %s?"); 

  SetProp( P_REJECT, REJECT_KEEP);
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(8,999,
      "Der Dao Khan wirft eine Eislanze auf Dich.\n",
      "Der Dao Khan wirft eine Eislanze auf @WEN.\n",
      DT_COLD, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(4, 900, DS_MASS_DAMAGE,
      "Der Dao Khan beschwoert einen Hagelsturm herbei.\n",
      "Der Dao Khan beschwoert einen Hagelsturm herbei.\n",
      DT_COLD);
  AddDefaultSpell(3, 1200, DS_SLOW,
      "Der Dao Khan friert Dich ein.\n",
      "Der Dao Khan friert @WEN ein.\n"); 
  AddSpell(1,1000,
      "Der Dao Khan laesst Deine Beine am Boden festfrieren!\n",
      "Der Dao Khan laesst @WESSEN Beine am Boden festfrieren!\n",
      DT_COLD, "spell_hold", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1,
      "Der Dao Khan holt einen seiner Untertanen zu Hilfe!\n",
      "Der Dao Khan holt einen seiner Untertanen zu Hilfe!\n",
      DT_MIND, "clone_helper");
  AddDefaultSpell(1, 800, DS_FROG,
      "Der Dao Khan verfroscht Dich ein.\n",
      "Der Dao Khan verfroscht @WEN ein.\n"); 

  SUID;
}

void init()
{ 
  ::init();
  if( this_player() && this_player()->id("dao"))
    AddDefender(this_player());
  if (this_player() && this_player()->QueryProp("daokiller") > time())
     Kill(this_player());
}

void InformDefend(object enemy)
{ 
  Kill(enemy);
}

varargs void clone_helper(object enemy, int damage, mixed dam_type)
{
  object ob;
  if(!present("dao 3", environment(this_object())))
  {
    ob=clone_object(NPC "dao_sabri.lpc");
    ob->move(environment(),M_GO);
    AddPursuer(ob);
  }
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{ 
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_COLD ) != -1){
    if(random(100)>40)
      tell_room(environment(), "  Der Dao Khan fuehlt sich durch die Kaelte erfrischt.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  if(!random(22)) clone_helper();
  return ::Defend(dam, dtype, spell, enemy);
}

varargs void die( int poisondeath )
{
  this_player()->SetProp("daokiller", time() + 3600 * 24 * 3);
  ::die(poisondeath);
}

