// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/hirnsauger.c
// ~Level:  12-15 
// ~Hands:  195,DT_BLUDGEON  WC: default AC: default 
// ~Spells: (Rate: 1, Steckt Gegner mit Malaria an
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:-0.3,WATER:-0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0.4,ELECTRIC:0,ACID:0,POISON:0,TERROR:-0.7,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:-int spell

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"
#include <npcmaster.h>

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Hirnsauger");
  SetProp(P_LONG, 
      "Du siehst einen etwa zwei Meter grossen Hirnsauger vor Dir. Er hat "
      "eine menschliche Gestalt, doch seine Haut scheint sehr schleimig zu "
      "sein. Sein Gesicht besteht zu zwei Dritteln nur aus einem grossen "
      "Maul, aus welchem einige dunne, aber sehr lange Tentakel herausragen. "
      "Hirnsauger koennen sehr gefaehrlich werden, da sie ab und an eine "
      "Gehirnwaesche mit ihren Opfern durchfuehren.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));
  
  SetProp(P_AGGRESSIVE,0.3);
  SetProp(P_NAME, "Hirnsauger");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 190+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","sauger","hirnsauger"}));
  create_default_npc(12+random(3)+to_int(well_level())/2);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_ALIGN, -380);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen langen Tentakeln",195,DT_BLUDGEON})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0.4,     DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :-0.7,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "steigt herein");
  SetProp(P_MSGOUT, "steigt");

  SetProp(P_DIE_MSG, " kippt um und ist tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Naechstes mal sauge ich Dein Hirn komplett aus, %s!");
  SetProp(P_KILL_NAME, "Ein Hirnsauger");
  SetProp(P_KILL_MSG, "Dein Hirn gehoert nun mir! Hahah!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

  AddSpell(1, 300,
     "  Der Hirnsauger unterzieht Dich einer Gehirnwaesche.\n",
     "  Der Hirnsauger unterzieht @WEN einer Gehirnwaesche.\n",
     DT_MIND, "spell_brainstorm", ([SP_SHOW_DAMAGE:1]));

    SUID;

}


