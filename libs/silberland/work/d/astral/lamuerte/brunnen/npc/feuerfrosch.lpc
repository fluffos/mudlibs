// ~Feuerfrosch / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/feuerfrosch.c
// ~Level:  20-25 
// ~Hands:  235,DT_FIRE  WC: default AC: default 
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-1,COLD:0.3,WATER:0.3,AIR:0,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Feuerfrosch");
  SetProp(P_LONG, 
  "Ein etwa einen halben Meter grosses, knallrotes Wesen steht vor Dir. Es "
  "hat die Form eines Frosches, ist aber wesentlich groesser als ein normaler "
  "Frosch. Seine blutroten Augen und seine toedlich aussehende Musterung "
  "versetzt viele seiner Gegner in Angst und Schrecken. An seiner Stirn "
  "ragt ein kleines Horn heraus, welches moeglicherweise Zeuge seines "
  "daemonischen Ursprungs ist.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Feuerfrosch");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 50+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","wesen","frosch","feuerfrosch"}));
  create_default_npc(20+random(6));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem gluehenden Stirnhorn",235,({DT_PIERCE,DT_FIRE})})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-1,      DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :0,       DT_LIGHTNING   :0,       DT_EXPLOSION  :0.2, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "huepft von Flammen umgeben herein");
  SetProp(P_MSGOUT, "huepft von Flammen umgeben");

  SetProp(P_DIE_MSG, " erlischt vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Naechstes mal loesche ich Dich aus, %s!");
  SetProp(P_KILL_NAME, "Ein Feuerfrosch");
  SetProp(P_KILL_MSG, "Another one bites the dust!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Kleine Flammen blitzen ueber den Koerper des Feuerfrosches.\n",
    "Die Haut des Feuerfrosches scheint zu gluehen.\n",
    "Einige lange Flammen stroemen ueber den Feuerfrosch.\n",
  }) );

  AddDefaultSpell(20,300+to_int(well_level())*10, DS_MASS_DAMAGE,
      "Der Feuerfrosch huellt Dich in Flammen ein.\n", 
      "Der Feuerfrosch huellt Dich in Flammen ein.\n",
      DT_FIRE);
  AddDefaultSpell(1, 100, DS_FROG);  

  SUID;
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1){
    if(random(100)>40)
      tell_room(environment(), 
          "  Der Feuerfrosch fuegt das Feuer laechelnd zu seinem eigenen hinzu.\n");
    this_object()->AddHp(dam);
    return 0;
  }
  return ::Defend(dam, dtype, spell, enemy);
}

