// ~Level:  8-12 
// ~Hands:  155,DT_PIERCE  WC: default AC: default 
// ~Spells: (Rate: 1, Steckt Gegner mit Malaria an
// ~R.Str:  SLASH:0,BLUDGEON:0,PIERCE:0,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:-0.2,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Eine kleine Fledermaus flattert durch den Raum");
  SetProp(P_LONG, 
      "Du siehst eine kleine Fledermaus. Sie hat zwei Fluegel welche in kleinen "
      "Greifarmen mit spitzen Krallen enden. Ihre Fuesse bestehen aus vier langen "
      "Zehen, wobei jede Zehe von einem scharfen Nagel umgeben ist. "
      "Bis auf ihre spitzen Ohren ist ihr ganzer Koerper mit einem Fell bemantelt. "
      "Zwischen den Schnurrbarthaaren am Kopf der Fledermaus befindet sich eine "
      "kleine Stupsnase und ueber dieser sitzen ihre Augen.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({10, 20, 30}));

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Fledermaus");
  SetProp(P_RACE, "Tier");
  SetProp(P_SIZE, 20+random(20));
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nbrunnenpc","fledermaus","maus"}));
  AddClass(CL_FLYING);
  create_default_npc(8+random(4));
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit ihren spitzen Krallen",155,DT_PIERCE})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0,       DT_BLUDGEON    :0,       DT_PIERCE     :0,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0,       DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :-0.2,    DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");

  SetProp(P_DIE_MSG, " faellt auf den Boden um und ist tot.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Flapp Flapp");
//  SetProp(P_KILL_NAME, "");
//  SetProp(P_KILL_MSG, "");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");

    SUID;

}
