// ~Level:  45-50
// ~Hands:  285,DT_PIERCE   WC: default AC: default 
// ~R.Str:  SLASH:-0.8,BLUDGEON:-0.8,PIERCE:-0.8,SQUEEZE:0,WHIP:-0.4,RIP:0,
// ~        FIRE:0,COLD:0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special: Area Spell, Poison, Area Poison

#include "../def.h"

inherit NPC "std_well_npc";
inherit "/std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Eine riesengrosse Schlange mit einem wunderschoenen Frauengesicht");
  SetProp(P_LONG, 
      "Eine riesengrosse, prachtvolle Schlange baeumt sich vor Dir auf. "
      "Doch halt, das ist keine normale Schlange, bei einem genaueren Blick "
      "erkennst Du, dass ihr Kopf nicht der einer Schlange ist, sondern der "
      "einer wunderschoenen Frau. Es scheint als haettest Du eine Medusa "
      "gefunden. Doch Vorsicht, der wundervolle Anblick ihres Kopfes sollte "
      "Dich nicht ueber den Koerper der Schlange taeuschen. Diese "
      "Wesen koennen sehr unfreundlich werden.");
  SetProp (P_MNPC_WAIT, ({15, 25, 35}));

  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0.5+0.05*to_int(well_level()));
  SetProp(P_NAME, "Medusa");
  SetProp(P_NAME_ADJ, "alt");
  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 145+random(45));
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nbrunnenpc","medusa","schlange"}));
  AddAdjective( ({"alte"}) );
  create_default_npc(40+random(5));
  SetProp(P_ALIGN, -270);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit ihrem Schlangenzahn",590,({DT_PIERCE, DT_POISON})})); 
  SetProp(P_SPELLRATE,40);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.8,    DT_BLUDGEON    :-0.8,    DT_PIERCE     :-0.8,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.4,    DT_RIP        :0,
    DT_FIRE       :0,       DT_COLD        :-0.3,    DT_WATER      :-0.3,    
    DT_AIR        :0.3,     DT_LIGHTNING   :0.3,     DT_EXPLOSION  :0, 
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,60);

  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt");

  SetProp(P_DIE_MSG, " verreckt vor Deinen Augen.\n");
  SetProp(P_KILL_MSG, "Nur ein versteinerter Spieler ist ein guter Spieler!");
  SetProp(P_MURDER_MSG, "Wie konntest Du nur meinem versteinernden Blick entkommen, %s?");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");

  AddDefaultSpell(1, 200, DS_PARALYZE,
       "  Die alte Medusa paralysiert Dich.\n",
       "  Die alte Medusa paralysiert @WEN.\n");

  AddDefaultSpell(3, 800, DS_POISON,
       "  Die alte Medusa vergiftet Dich.\n",
       "  Die alte Medusa vergiftet @WEN.\n",3);

  AddDefaultSpell(1, 400, DS_MASS_POISON,
       "  Die alte Medusa versprueht Gift im Raum.\n",
       "  Die alte Medusa vergiftet @WEN.\n",2);

  AddSpell(1, 1, 
       "  Die alte Medusa paralysiert Dich.\n",
       "  Die alte Medusa paralysiert Dich.\n",
       DT_MAGIC, "para");

  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Die Augen der Medusa funkeln Dich an.\n",
    "Die Medusa zeigt Dir ihren giftigen Schlangenzahn.\n",
    "Die Medusa versucht Dich zu vergiften.\n",
  }) );

    SUID;

}


void para( object enemy, int damage, mixed dam_type)
{
  object *enemies;
  int i;

  enemies = PresentEnemies(); 
  if( enemies && sizeof(enemies) )
  {
    for( i=sizeof(enemies)-1;i>=0;i--)
    {
      if( !enemies[i]->QueryProp(P_PARALYZED) )
        enemies[i]->SetProp(P_PARALYZED, 1+random(2));
    }
  }
}

