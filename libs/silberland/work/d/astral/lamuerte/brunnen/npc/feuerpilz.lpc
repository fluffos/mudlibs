// ~Feuerpilz / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/feuerpilz.c
// ~Level:  15-20 
// ~Hands:  185,DT_FIRE  WC: default AC: default 
// ~Spells: (Rate: 1) Vergiftet seine Gegner mit 1+random(2)
// ~        (Rate: 9) 20+random(230) DT_FIRE Spell.
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-1,COLD:0.3,WATER:0.3,AIR:0,LIGHTNING:0.3,EXPLOSION:0.2,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:-0.5,POISON:-1,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Feuerpilz");
  SetProp(P_LONG, 
  "Ein etwa einen Meter grosses, knallrotes Wesen steht vor Dir. Es hat die "
  "Form eines Pilzes, jedoch siehst Du, dass es kleine Haende und Beine "
  "besitzt. Seine rote Haut sieht verdammt giftig aus, besser man greift es "
  "nicht an. Hin und wieder kannst scheint es als wuerden sich langgezogene "
  "Flammen an seinem Koerper emporstrecken, jedoch passiert dies viel zu "
  "schnell als das man es genauer sehen koennte.");

  //SetProp(P_ARTICLE,0);
  SetProp(P_MNPC_FLAGS, 0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Feuerpilz");
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 90+random(20));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","pilz","wesen","pilzwesen","feuerpilz"}));
  create_default_npc(15+random(5));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen gluehenden Haenden",185,({DT_BLUDGEON,DT_FIRE})})); 
  SetProp(P_SPELLRATE,30);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-1,      DT_COLD        :0.3,     DT_WATER      :0.3,    
    DT_AIR        :0,       DT_LIGHTNING   :0.3,     DT_EXPLOSION  :0.2,
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,    
    DT_ACID       :-0.5,    DT_POISON      :-1,      DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "brennt herein");
  SetProp(P_MSGOUT, "brennt");

  SetProp(P_DIE_MSG, " erlischt vor Deinen Augen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Das nachste mal verbrenne ich Dich, %s!");
  SetProp(P_KILL_NAME, "Ein Feuerpilz");
  SetProp(P_KILL_MSG, "Ah, Rache tut gut!");

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Kleine Flammen blitzen ueber den Koerper des Feuerpilzes.\n",
    "Die Haut des Feuerpilzes scheint zu knistern.\n",
    "Einige lange Flammen stroemen ueber den Feuerpilz.\n",
  }) );

  AddSpell(9, 230,
     "  Du verbrennst Dich an der Haut des Feuerpilzes.\n",
     "  Der Feuerpilz verbrennt @WEN.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 100,
     "  Du vergiftest Dich an dem Feuerpilz, als Du seine Haut beruehrst!\n",
     "  Der Feuerpilz vergiftet @WEN.\n",
     DT_POISON, "spell_poison", ([SP_SHOW_DAMAGE:1]));

  
    SUID;

}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  SetProp(P_SKILL_ATTRIBUTES, 0);
  if (!pointerp(dtype)) dtype = ({ dtype });
  if (member( dtype, DT_FIRE ) != -1){
    if(random(100)>40)
      tell_room(environment(), 
          "  Der Feuerpilz wird durch das Feuer nur noch groesser .\n");
    SetProp(P_MAX_HP, QueryProp(P_MAX_HP) + 10);
    this_object()->AddHp(dam);
    return 0;
  }
  return ::Defend(dam, dtype, spell, enemy);
}

