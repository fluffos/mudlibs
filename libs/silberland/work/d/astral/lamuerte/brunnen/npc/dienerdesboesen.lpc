// ~Level:  10-15 
// ~Hands:  80,DT_BLUDGEON  WC: default AC: default 
// ~R.Str:  SLASH:0,BLUDGEON:0,PIERCE:0,SQUEEZE:0,WHIP:-0.1,RIP:0,
// ~        FIRE:-0.3,COLD:-0.3,WATER:0.3,AIR:-0.3,LIGHTNING:0,EXPLOSION:0,SOUND:0,
// ~        LIGHT:0,ELECTRIC:0,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:0
// ~Special:Wird vom BOESEN summoned im kampf.                                       

#include "../def.h"

inherit NPC "std_well_npc";

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Diener des Boesen");
  SetProp(P_LONG, 
      "Das ist ein Diener des Boesen. Die absolute Bosartigkeit seines Herren hat "
      "ihn zu einem undefinierten Schatten werden lassen.");
  //SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NAME, "Diener des Boesen");
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 50+random(200));
  SetProp(P_GENDER, MALE);
  AddId(({"\nbrunnenpc","diener","diener des boesen","dienerdesboesen"}));
  create_default_npc(10+random(5));
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinen Dienerhaenden",200,DT_BLUDGEON})); 

  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "kommt unterwuerfig seinem Herrn zu Hilfe");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG, " stirbt fuer das BOESE.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SUID;
}

