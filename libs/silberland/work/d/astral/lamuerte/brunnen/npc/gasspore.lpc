// ~Gasspore / BrunnenZone
// ~Pfad:   /d/ebene/lamuerte/brunnen/npc/gasspore.c
// ~Level:  13-33 
// ~Hands:  1125,DT_ELECTRIC WC: default AC: default 
// ~Spells: (Rate: 2) "hold spell", kein Weglaufen moeglich, Kampf jedoch wird fortgesetzt
// ~        (Rate: 10) 50+random(20*LEVEL) DT_AIR Spell.
// ~R.Str:  SLASH:-0.1,BLUDGEON:-0.1,PIERCE:-0.1,SQUEEZE:0,WHIP:0,RIP:0,
// ~        FIRE:-0.2,COLD:-0.3,WATER:-0.2,AIR:-0.2,LIGHTNING:-0.4,EXPLOSION:-0.2,SOUND:0.5,
// ~        LIGHT:0,ELECTRIC:-0.7,ACID:0,POISON:0,TERROR:0,HOLY:0,UNHOLY:0,MAGIC:-0.2
// ~Special:Wimpy 100

#include "../def.h"

inherit NPC "std_well_npc";

#include "./spells.h"

int i;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 
  SetProp(P_SHORT, "Ein kleines, kugelfoermiges Wesen schwebt im Raum");
  SetProp(P_LONG, 
      "Ein kleines, kugelfoermiges Wesen welches mit einer Vielzahl von "
      "antennenartigen Fuehlern uebersaeht ist, schwebt vor Dir. Kleine "
      "elektrische Ladungen scheinen sich zwischen den Fuehlern aufzubauen, "
      "welche dieses Wesen auf seine Gegner feuern kann, wenn es im Kampf "
      "ist. So klein dieses Ding auch sein mag, manche seiner Art koennen "
      "trotzdem gefaehrlich sein.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_WAIT, ({20, 40, 60}));

  SetProp(P_AGGRESSIVE,0.1);
  SetProp(P_NAME, "Gasspore");
  SetProp(P_RACE, "Pilzwesen");
  SetProp(P_SIZE, 30+random(22));
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nbrunnenpc","spore","gasspore", "wesen"}));
  create_default_npc(13+to_int(well_level())+random(5) );
  SetProp(P_ALIGN, 90);
  SetProp(P_MAX_HANDS, 5); 
  SetProp(P_HANDS, ({" mit einigen ihrer Fuehler",155+to_int(well_level())*10,({DT_WHIP,DT_ELECTRIC})})); 
  SetProp(P_SPELLRATE,55);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :0,       DT_WHIP        :0,       DT_RIP        :0,
    DT_FIRE       :-0.2,    DT_COLD        :-0.3,    DT_WATER      :-0.2,    
    DT_AIR        :-0.2,    DT_LIGHTNING   :-0.4,    DT_EXPLOSION  :-0.2, 
    DT_SOUND      :0.5,     DT_LIGHT       :0,       DT_ELECTRIC   :-0.7,    
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,     
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :-0.2]) );
  
  SetProp(P_NOMAGIC,25);

  SetProp(P_WIMPY,100);
  
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");

  SetProp(P_DIE_MSG, " stirbt ohne viel Aufsehen zu erregen.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp( P_REJECT, REJECT_KEEP);
  //clone_object("")->move(this_object());  
  //command("");
  //set_living_name("");
  AddInfo( DEFAULT_INFO,"ignoriert Dich komplett.");
  SetChats(1, ({
    "Elektrische Ladungen zischen ueber die Fuehler der Gasspore.\n",
  }) );


  AddSpell(10, 150+random(20*this_object()->QueryProp(P_LEVEL)),
      "  Die Gasspore elektrisiert Dich! Du fuehlst unheimliche Schmerzen.\n",
      "  @WER schreit vor Schmerzen als @PWER von einer Gasspore elektrisiert wird.\n",
      DT_ELECTRIC, "spell_hold", ([SP_SHOW_DAMAGE:1]));

    SUID;

}

