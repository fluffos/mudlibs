inherit "/std/armour";

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

int khan = 0;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eisig weisse Daoarmschuetzer");
  SetProp(P_LONG, 
    "Diese Armschuetzer bestehen vollstaendig aus magischem Eis, das sowohl "
    "angenehm kuehlt aber auch Kaelte von aussen fern haelt. Eine sehr "
    "seltsame Magie muss das Eis in die Form von Armschuetzern gezwungen haben.");
  SetProp(P_NAME, "Daoarmschuetzer");
  SetProp(P_NAME_ADJ, ({"eisig weiss"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"armschuetzer","daoarmschuetzer", "\nwell_equip"}));
  AddAdjective( ({"eisige", "weisse" }) ); 
  AddDetail( ({"eis"}),
     "Magisches Eis, das sowohl kuehlt als auch Kaelte von aussen fernhaelt.");  
  AddDetail( ({"magie"}),
      "Die Magie, die diese Armschuetzer erschaffen hat, ist sicherlich elementaren "
      "Ursprungs.");

  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_ICE:100]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 1500);
  SetProp(P_MAGIC, 6);
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_COLD:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(4), P_SP:3+random(4)]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([EIS:10]));

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_COLD: khan ? -0.15 : -0.07]) );
  if( !silent)
    tell_object(environment(),
        "Du fuehlst Dich jetzt gegen Kaelte geschuetzt.\n");
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void set_khan()
{
  if (member(ALLOWED_UIDS, getuid(previous_object())) == -1)
    return;
  khan = 1;
  SetProp(P_SHORT, QueryProp(P_SHORT) + " des Khans");
  SetProp(P_NAME, QueryProp(P_NAME) + " des Khans");
  SetProp(P_AC, 10);
  SetProp(P_MAGIC, 10);
  SetProp(P_QUALITY_DECAY, 600);
  SetProp(P_M_HEALTH_MOD, ([P_HP:9+random(4), P_SP:9+random(4)]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:5, P_SP:5]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([EIS:15, "all":5]));
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, P_LEVEL:65 ]) );
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, pointerp(data[0]) ? data[0] : ({2222,1}) );
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  if (data[1])
    set_khan();
}

mixed _query_autoloadobj()
{ 
  return ({QueryProp(P_ITEMD_TMPMAGIC), khan});
}

