inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/berserker/berserker_extern.h"
#include "/p/daemon/itemd/itemd.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Feldherrenguertel");
  SetProp(P_LONG, 
    "Ein sehr breiter Guertel, wie ihn Feldherren gerne tragen. Er ist aus "
    "stahlverstaerktem Leder gefertigt und mit kleinen roten Punkten verziert.");
  SetProp(P_NAME, "Feldherrenguertel");
  SetProp(P_GENDER, MALE);
  AddId (({"guertel","feldherrenguertel", "\nwell_equip"}));
  SetProp(P_INFO,
      "Dieser Guertel verstaerkt die Faehigkeiten eines Berserkers.");
  AddDetail( ({"leder"}),
      "Es handelt sich um sehr eigenartiges Leder, aber es scheint von "
      "einem echsenartigen Lebewesen zu stammen.");
  AddDetail( ({"punkte", "punkt", "blut"}),
      "Bei den roten Punkten scheint es sich um Blut zu handeln.");

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_LEATHER:50, MAT_STEEL:40, MAT_BLOOD:10]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_MAGIC, 13);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_M_HEALTH_MOD, ([P_HP:13, P_SP:13]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_BERSERKER_BONUS, (["all":30]) );
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int WearFunc()
{
  SetProp(P_NODROP, 1);
  return 1;
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

