inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/waldlaeufer/def_extern.h"
#include "/p/daemon/itemd/itemd.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Werkzeugguertel des Fallenmeisters");
  SetProp(P_LONG, 
    "Dieser Guertel ist besonders breit und vielen Taschen und Schlaufen "
    "versehen an denen allerlei Werkzeuge, Draehte und Schnuere zu finden sind. "
    "Jedes Mal wenn du eines der Werkzeuge entfernst erscheint automatisch ein "
    "neues. Dieser Guertel wird von Meisterfallenstellern verwendet.");
  SetProp(P_NAME, "Werkzeugguertel des Fallenmeisters");
  SetProp(P_GENDER, MALE);
  AddId (({"guertel","fallenmeisterguertel", "werkzeugguertel", "\nwell_equip", TRAP_BELT_ID}));
  SetProp(P_INFO,
      "Dieser Guertel enthaelt endlos Werkzeuge und laesst Waldlaeufer bessere Fallen bauen.");

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_LEATHER:50, MAT_STEEL:40, MAT_BLOOD:10]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_MAGIC, 13);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_M_HEALTH_MOD, ([P_HP:13, P_SP:13]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_RANGER_BONUS, (["all":5, "fesselfalle": 40, "fangfalle": 40, "stolperdraht": 40, "pfeilfalle": 40]) );
  SetProp(P_RANGER_SPELLCOST, 10);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int WearFunc()
{
  SetProp(P_NODROP, 1);
  return 1;
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int get_ladungen() { 
  return 999; 
}

int can_build(int n) {
  return 1; // wir koennen immer fallen bauen
}
