inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/p/daemon/itemd/itemd.h"

void create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Sturmschild");
  SetProp(P_LONG, 
    "Der Sturmschild ist ein rechteckiges Gebilde, das aus einem Gewitter "
    "zu bestehen scheint. Du kannst deutlich Blitz und Donner sehen, und wie "
    "der Sturmwind die Regentropfen herumwirbelt. Trotzdem kannst Du den "
    "Sturmschild in die Hand nehmen und damit Angriffe Deiner Gegner "
    "abblocken."); 
  SetProp(P_NAME, "Sturmschild");
  SetProp(P_GENDER, MALE);
  AddId (({"schild","sturmschild", "\nwell_equip"}));
  AddDetail( ({"gewitter", "blitz", "donner", "sturm", "wind", "regen", 
        "regentropfen"}),
      "Unglaublich, woraus so ein Schild alles bestehen kann.....");

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 28);
  SetProp(P_MATERIAL, 
      ([MAT_LIGHTNING:25, MAT_WATER:25, MAT_MISC_MAGIC:25, MAT_AIR:25]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5500);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MAGIC, 4);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:4]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+
      ([DT_LIGHTNING:1, DT_WATER:1, DT_SOUND:1, DT_AIR:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:2+random(9), P_SP:2+random(9)]) );

  SetProp(P_ITEMD_TMPMAGIC, ({1500, 1500}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

