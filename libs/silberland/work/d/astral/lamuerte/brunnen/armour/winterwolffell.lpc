inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein glaenzend weisses warmes Fell");
  SetProp(P_LONG, 
    "Das ist das Fell eines Winterwolfes, einer daemonischen Manifestation "
    "aus den dunklen Maechten des Winters. Es hat eine glaenzend weisse Farbe, "
    "wie frisch gefallener Schnee. Es laesst sich sicher gut als Umhang "
    "verwenden.");
  SetProp(P_NAME, "Fell");
  SetProp(P_NAME_ADJ, ({"glaenzend weiss", "warm"}) );
  SetProp(P_GENDER, NEUTER);
  AddId (({"fell","winterwolffell", "\nwell_equip"}));
  AddAdjective( ({"weisses", "glanzendes", "glaenzend weisses", "warmes" , 
                  "warm"}) ); 
  SetProp(P_INFO,
     "Das Winterwolffell ist sicher ein sehr guter Waermeschutz, es kann "
     "sogar den Schaden durch Kaelte verringern, gegen Hitze hingegen "
     "hat es sicher die umgekehrten Eigenschaften."); 

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 8+random(3));
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 2500);
  SetProp(P_MAGIC, 4);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:9, T_HEAT_PROT:-3]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_COLD:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_COLD:-0.15, DT_FIRE:0.05]) );
  if( !silent)
    tell_object(environment(),
        "Du fuehlst Dich jetzt gegen Kaelte geschuetzt.\n");
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}
