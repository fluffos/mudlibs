inherit "/gilden/bardengilde/instrument/base_drum";

#include "/gilden/bardengilde/barden_extern.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>
#include "../def.h"

create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Daotamburin");
  SetProp(P_LONG, 
	  BS("Dieses Tamburin ist von der Art, wie es die Dao abunan spielen. Um "
       "einen Holzrahmen ist ein Winterwolffell gespannt und kleine Eiskristalle "
       "bilden die schellen.")); 
  SetProp(P_NAME, "Daotamburin");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"tamburin", "daotamburin", "\nwell_equip"}) );

  SetProp(P_INSTRUMENT_LEVEL, 5);

  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:30, MAT_LEATHER: 30, MAT_ICE:40]));
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
}














