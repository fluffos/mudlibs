inherit "/std/armour";

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

int kalif = 0;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine luftig gelbe Djinnihaube");
  SetProp(P_LONG, 
    "Diese Haube besteht eigentlich nur aus Luft, trotzdem schuetzt sie den "
    "Kopf sehr gut. Was muss das fuer eine seltsame Magie sein, die Luft in "
    "eine solch merkwuerdige Form bringen kann.");
  SetProp(P_NAME, "Djinnihaube");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "luftig gelb" );
  AddId (({"haube","djinnihaube", "\nwell_equip"}));
  AddAdjective( ({"luftige", "gelbe" }) ); 

  AddDetail( ({"luft"}),
      "Die Djinnihaube ist wirklich aus magischer Luft gefertigt. Daher ist "
      "sie wohl so leicht.");
  AddDetail( ({"magie"}),
      "Die Magie, die diese Haube erschaffen hat, ist sicherlich elementaren "
      "Ursprungs.");

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 11);
  SetProp(P_MATERIAL, ([MAT_AIR:100]) );
  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 1500);
  SetProp(P_MAGIC, 6);
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1, T_HEAT_PROT:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(4), P_SP:3+random(4)]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([LUFT:10]));

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_AIR: kalif ? -0.15 : -0.07]) );
  if( !silent)
    tell_object(environment(),
        "Du fuehlst Dich jetzt gegen Luftangriffe geschuetzt.\n");
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void set_kalif()
{
  if (member(ALLOWED_UIDS, getuid(previous_object())) == -1)
    return;
  kalif = 1;
  SetProp(P_SHORT,  QueryProp(P_SHORT) + " des Kalifen");
  SetProp(P_NAME, QueryProp(P_NAME) + " des Kalifen");
  SetProp(P_AC, 15);
  SetProp(P_MAGIC, 10);
  SetProp(P_QUALITY_DECAY, 600);
  SetProp(P_M_HEALTH_MOD, ([P_HP:9+random(4), P_SP:9+random(4)]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:5, P_SP:5]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([LUFT:15, "all": 5]));
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, P_LEVEL:65 ]) );
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, pointerp(data[0]) ? data[0] : ({2222,1}) );
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  if (data[1])
    set_kalif();
}

mixed _query_autoloadobj()
{ 
  return ({QueryProp(P_ITEMD_TMPMAGIC), kalif});
}

