inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden_extern.h"

#ifndef AT_EARRING
#define AT_EARRING AT_MISC
#endif

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein verrosteter Kupferohrring");
  SetProp(P_LONG, 
    "Dieser unscheinbare Ohrring aus Kupfer ist zwar schon sehr verrostet, "
    "es scheint aber ein magische Aura von ihm auszugehen.");
  SetProp(P_NAME, "Kupferohrring");
  SetProp(P_NAME_ADJ, "verrostet");
  SetProp(P_GENDER, MALE);
  AddId (({"ohrring","kupferohrring", "\nwell_equip", DRUID_ALLOWED_METAL_ITEM }));
  AddAdjective( ({"verrostet", "verrosteten", "verrosteter"}) );

  AddDetail( ({"rost"}),
      "Seltsam, Kupfer rostet doch nicht. Wollte da vielleicht jemand "
      "absichtlich diesen Ohrring schlechter erscheinen lassen als er ist?");
  
  SetProp(P_ARMOUR_TYPE, AT_EARRING);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_COPPER:100]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MAGIC, 1);
  SetProp(P_M_HEALTH_MOD, ([P_HP:2, P_SP:2]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );

}
