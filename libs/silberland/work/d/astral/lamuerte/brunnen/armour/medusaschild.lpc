inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/amazonen/amazonen_extern.h"
#include "/p/daemon/itemd/itemd.h"

void create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Medusaschild");
  SetProp(P_LONG, 
    "Der Medusaschild ist eigentlich nur eine grosse spiegelnde Scheibe, "
    "die man wie ein Schild in der Hand halten kann. Wenn du hinein blickst "
    "erkennst du das Gesicht einer schoenen Frau mit Schlangenhaaren."); 
  SetProp(P_NAME, "Medusaschild");
  SetProp(P_GENDER, MALE);
  AddId (({"schild","medusaschild", "\nwell_equip"}));
  SetProp(P_INFO, "Der Medusaschild kann deine Gegner laehmen.\n");

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_MERCURY:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MAGIC, 13);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:13, P_SP:13]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_AMAZONEN_SPELLCOST, 20);

  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  if(!random(33))
  {
    tell_object(QueryProp(P_WORN),
      "Dein Medusaschild reflektiert den Blick Deines Gegners und laehmt ihn!\n");
    tell_object(enemy,
      "Der Blick Deines Gegners wird von seinem Medusaschild reflektiert "
      "und laehmt Dich!\n");
    enemy->SetProp(P_DISABLE_ATTACK, random(2)+1);
  }
}

int WearFunc()
{
  SetProp(P_NODROP, 1);
  return 1;
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
  SetProp(P_NODROP, 1);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

