inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Ring des ewigen Schmerzes");
  SetProp(P_LONG, 
    "Dieser Ring ist eindeutig daemonischer Herkunft. Schon ihn anzusehen "
    "bereitet Schmerzen, ihn zu tragen muss fast unertraeglich sein.");
  SetProp(P_NAME, "Ring des ewigen Schmerzes");
  SetProp(P_GENDER, MALE);
  AddId (({"ring","ring des ewigen schmerzes", "schmerzring", "NOUNCURSE", 
        "\nwell_equip"}));
  SetProp(P_INFO,
      "Dieser Ring wird Dir sicher ewig Schmerzen bringen.");

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:50, MAT_MISC_METAL:50]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_MAGIC, 3);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_NO_DAMAGE_DESTRUCT, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-1, T_HEAT_PROT:-1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:13, P_SP:13]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_DEFEND_FUNC, this_object() );
  SetProp("ruestungsbalsam", 10);
}

int WearFunc(object ruest,int silent)
{
  if( !silent)
    tell_object(environment(),
        "Der Ring schneidet sich tief in Deinen Finger. Welcher Schmerz!\n");
  SetProp(P_CURSED, 1);
  SetProp(P_NODROP, 1);
  environment()->AddHP(-5-random(13));
  return 1;
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  object wer;
  if(!wer=QueryProp(P_WORN) ) return 0;
  if( !random(13) )
  {
    tell_object(wer,
        "Der Ring des ewigen Schmerzes schneidet sich tief in Deinen Finger.\n"
        "AAAUUUUAAAA!!!! Welcher Schmerz!\n");
    tell_room(environment(wer),
        wer->Name(WER,1)+" schreit vor Schmerz!\n", ({wer}));
    wer->AddHp(-random(5));
  }
  return random(13);
}

void reset()
{
  object wer;
  ::reset();
  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer))
  {
    tell_object(wer,
        "Der Ring des ewigen Schmerzes schneidet sich tief in Deinen Finger.\n"
        "AAAUUUUAAAA!!!! Welcher Schmerz!\n");
    wer->AddHp(-13-random(13));
    tell_room(environment(wer),
        wer->Name(WER,1)+" schreit vor Schmerz!\n", ({wer}));
  }
}
  
