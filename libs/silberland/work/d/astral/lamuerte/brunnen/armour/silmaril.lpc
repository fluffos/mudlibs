inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/p/daemon/itemd/itemd.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Silmaril");
  SetProp(P_LONG, 
    "Der Silmaril ist ein magische gluehendes Gebilde, das man sich um "
    "den Hals haengen kann. Es scheint nur so von Energie zu pulsieren.");
  SetProp(P_NAME, "Silmaril");
  SetProp(P_GENDER, MALE);
  AddId (({"silmaril", "\nwell_equip"}));
  SetProp(P_INFO, 
      "Der Silmaril erhoeht die Lebens- und Magiepunkte und wird ab und "
      "zu Energie in Dich fliessen lassen.");

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MAGIC, 13);
  SetProp(P_NOSELL, 1);
  SetProp(P_M_HEALTH_MOD, ([P_HP:random(20), P_SP:random(20)]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );

  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void reset()
{
  ::reset();
  call_out("heal", 10+random(200));
}

void heal()
{
  object ob;

  if( ob=QueryProp(P_WORN) )
  {
    SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(ob->QueryAttribute(A_CON)), 
                              P_SP:3+random(ob->QueryAttribute(A_INT))]) );
    tell_object(ob, "Der Silmaril glueht auf.\n");
    ob->UpdateAttributes();
    ob->heal_self(100+random(300));
      
  }
}

int WearFunc()
{
  SetProp(P_NODROP, 1);
  return 1;
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
  SetProp(P_NODROP, 1);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

