inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

int notunwear, lastheal;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Otyughpanzer");
  SetProp(P_LONG, 
    "Dieser Panzer besteht aus der narbigen und warzigen Haut eines "
    "Otyugh. Er ist noch ganz voll mit Abfall und Dreck, in dem das "
    "Otyugh gelebt hat und stinkt dadurch ganz fuerchterlich.");
  SetProp(P_NAME, "Otyughpanzer");
  SetProp(P_GENDER, MALE);
  SetProp(P_SMELL, "Der Otyughpanzer stinkt nach Abfall.\n");
  SetProp(P_INFO,
      "Der Otyughpanzer vermag Dich gegen Gift zu schuetzen, allerdings "
      "wird Dich niemand mehr moegen, weil Du damit haesslich aussiehst "
      "und ziemlich stinkst.");
  AddId (({"panzer","otyughpanzer", "\nwell_equip"}));

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 37);
  SetProp(P_MATERIAL, ([MAT_SKIN:100]) );
  SetProp(P_WEIGHT, 2100);
  SetProp(P_VALUE, 3000);
  SetProp(P_MAGIC, 5);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_WEAR_RESTRICTIONS, ([A_CON:15, SR_SEER:1 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_POISON:1]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_DEFEND_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );

  AddCmd( ({"knuddel", "umarme", "liebe", "kuess", "kuesse", "wuschel",
        "flausch", "flausche", "kitzel", "drueck", "druecke", "haetschel",
        "knutsche", "knutsch", "laechel", "laechle", "schmuse", "schmeischel",
        "schnurre", "schnurr", "schmunzel", "grins", "grinse",  "strahle",
        "strahl", "streichel", "streichle", "tasetschel", "taeschle", "troseste",
        "troest", "umarm", "winke", "wink", "wuensche", "wuensch"
        }), "nix");
  lastheal=0;
}

int WearFunc(object ruest,int silent)
{
  object wer;
  wer= environment();
  wer->AddResistanceModifier( ([DT_POISON:-0.07]) );
  if( !silent)
  {
    tell_object(wer,
        "Du fuehlst Dich jetzt gegen Gift geschuetzt.\n");
    tell_room(environment(wer),
        wer->Name(WER,1)+" stinkt fuerchterlich!\n", ({wer}));
  }
  notunwear=1;
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  if( notunwear) 
    return tell_object(QueryProp(P_WORN), 
        "Dein Otyughpanzer klebt auf Deiner Haut fest.\n"),0;
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  object wer;
  if(!wer=QueryProp(P_WORN) ) return 0;
  if( (wer->QueryProp(P_POISON) || member( dtyp, DT_POISON)!=-1) && 
      time()-lastheal>10+random(15) )
  {
    tell_object(wer, "Dein Otyughpanzer absorbiert das Gift.\n");
    wer->AddPoison(-1);
    if (random(2)) wer->AddHp(random(5));
    notunwear=1;
    lastheal=time();
    return 5+random(10);
  }
}

void reset()
{
  object wer;
  if (!is_clone(this_object())) return;
  ::reset();
  if ((wer=QueryProp(P_WORN)) && interactive(wer))
  {
    if (wer->QueryProp(P_POISON))
    {
      tell_object(wer, "Dein Otyughpanzer absorbiert das Gift.\n");
      wer->AddPoison(-1);
    }
    else
    {
      tell_object(wer,
          "Der Gestank des Otyughpanzer bringt Dich um den Verstand!\n");
      wer->AddHp(-5-random(5));
      wer->AddSp(-20-random(25));
      tell_room(environment(wer),
          wer->Name(WER,1)+" stinkt fuerchterlich!\n", ({wer}));
      notunwear=0;
    }
  }
}
 
int nix(string str)
{
  if( !QueryProp(P_WORN) ) return 0;
  write("Dich mag niemand, weil Du so stinkst!\n");
  say(this_player()->Name(WER,1)+" stinkt fuerchterlich!\n", ({this_player()}));
  return 1;
}

int _query_neverdrop()
{
  return notunwear;
}
