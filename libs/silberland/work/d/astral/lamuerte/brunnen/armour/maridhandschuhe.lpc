inherit "/std/armour";

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

int padisha = 0;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Waessrig blaue Maridhandschuhe");
  SetProp(P_LONG, 
    "Diese Handschuhe haben die gleiche Konsistenz wie Wasser, allerdings "
    "wird das Wasser durch eine seltsame Art der Magie in eine Form "
    "gezwungen, dass man sie als Handschuhe verwenden kann.");
  SetProp(P_NAME, "Maridhandschuhe");
  SetProp(P_NAME_ADJ, ({"waessrig blau"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"handschuhe","maridhandschuhe", "\nwell_equip"}));
  AddAdjective( ({"waessrige", "blaue", "wassrigen", "blauen"}) ); 
  AddDetail( ({"wasser"}),
      "Magisches Wasser, es ist staendig in Bewegung, aber die Form der "
      "Handschuhe bleibt immer gleich.");
  AddDetail( ({"magie"}),
      "Die Magie, die diese Handschuhe erschaffen hat, ist sicherlich elementaren "
      "Ursprungs.");
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_WATER:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1500);
  SetProp(P_MAGIC, 6);
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:2]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(4), P_SP:3+random(4)]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([WASSER:10]));
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 15+random(10));
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, WASSER );

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_WATER: padisha ? -0.15 : -0.07]) );
  if( !silent)
    tell_object(environment(),
        "Du fuehlst Dich jetzt gegen Wasser geschuetzt.\n");
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void set_padisha()
{
  if (member(ALLOWED_UIDS, getuid(previous_object())) == -1)
    return;
  padisha = 1;
  SetProp(P_SHORT, QueryProp(P_SHORT) + " des Padishas");
  SetProp(P_NAME, QueryProp(P_NAME) + " des Padishas");
  SetProp(P_AC, 10);
  SetProp(P_MAGIC, 10);
  SetProp(P_QUALITY_DECAY, 600);
  SetProp(P_M_HEALTH_MOD, ([P_HP:9+random(4), P_SP:9+random(4)]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:5, P_SP:5]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([WASSER:15, "all":5]));
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 35);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, P_LEVEL:65 ]) );
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, pointerp(data[0]) ? data[0] : ({2222,1}) );
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  if (data[1])
    set_padisha();
}

mixed _query_autoloadobj()
{ 
  return ({QueryProp(P_ITEMD_TMPMAGIC), padisha});
}

