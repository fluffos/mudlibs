inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/paladine/paladin_extern.h"
#include "/p/daemon/itemd/itemd.h"

void create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Staubschild");
  SetProp(P_LONG, 
    "Der Staubschild ist eigentlich nur eine grosse Staubwolke, die wie man "
    "wie ein Schild in der Hand halten kann. Welch seltsame Magie mag hinter "
    "diesem Ding stecken?"); 
  SetProp(P_NAME, "Staubschild");
  SetProp(P_GENDER, MALE);
  AddId (({"schild","staubschild", "\nwell_equip"}));
  SetProp(P_INFO, "Der Staubschild macht Dich in Windeseile heilig.\n");
  AddDetail( ({"staub"}),
      "Der Staub ist einfach.... goettlich!");

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_DUST:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MAGIC, 13);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:13, P_SP:13]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_PALADIN_SPELLCOST, 17);
  SetProp(P_PALADIN_SCHILDPARADE_AC, 7);

  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int align;
  if( (align=QueryProp(P_WORN)->QueryProp(P_ALIGN))<1000 )
    QueryProp(P_WORN)->SetProp(P_ALIGN, align+1);
}

int WearFunc()
{
  SetProp(P_NODROP, 1);
  return 1;
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
  SetProp(P_NODROP, 1);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

