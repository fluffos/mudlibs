inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/p/daemon/itemd/itemd.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Gorgonenhose");
  SetProp(P_LONG, 
    "Diese Hose ist aus der Haut eines Gorgons gefertigt. Da die Haut eines "
    "Gorgonen aber aus Metallschuppen besteht, ist diese Hose ausgesprochen "
    "widerstandsfaehig."); 
  SetProp(P_NAME, "Gorgonenhose");
  SetProp(P_GENDER, FEMALE);
  AddId (({"hose","gorgonenhose", "\nwell_equip"}));
  AddDetail( ({"haut", "schuppen", "metallschuppen", "metall"}),
      "Die Schuppen bestehen aus einem eisenaehnlichem Metall, das sicher "
      "daemonischen Ursprungs ist.");
  SetProp(P_INFO,
      "Gorgonen sind gefuerchtet fuer ihre Paralyse. Ob Dir diese Hose "
      "vielleicht dagegen helfen kann?");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 8+random(2));
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:20, MAT_LEATHER:30, MAT_MAGIC:30, MAT_MISC_UNHOLY:20]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 230);
  SetProp(P_MAGIC, 4);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:3, P_SP:3]) );

  call_other("/p/daemon/itemd/functions/defendfuncnoparalyze", "???");
  SetProp(P_DEFEND_FUNC, 
      find_object("/p/daemon/itemd/functions/defendfuncnoparalyze"));

  SetProp(P_ITEMD_TMPMAGIC, ({1500, 1500}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void reset()
{
  if (!objectp(QueryProp(P_DEFEND_FUNC)))
  {
    call_other("/p/daemon/itemd/functions/defendfuncnoparalyze", "???");
    SetProp(P_DEFEND_FUNC, 
        find_object("/p/daemon/itemd/functions/defendfuncnoparalyze"));
  }
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

