inherit "/gilden/bardengilde/instrument/base_glass";

#include "/gilden/bardengilde/barden_extern.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>
#include "../def.h"

create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Maridglungsang");
  SetProp(P_LONG, 
	  BS("Das Maridglungsang ist ein bemerkenswertes Instrument. Es wurde "
       "von den Kuenstlern der Marid aus Glas geschaffen und ist unter "
       "Wasser fast nicht zu sehen. Seine Toene erzeugt es ueber mehrer "
       "mit Wasser gefuellte Glaskammern, die vom Musiker durch Blasen "
       "und Reiben in Schwingung versetzt werden.")); 
  SetProp(P_NAME, "Maridglungsang");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"maridglungsang", "glungsang", "\nwell_equip"}) );

  SetProp(P_INSTRUMENT_LEVEL, 6);

  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:30, MAT_LEATHER: 30, MAT_ICE:40]));
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
}














