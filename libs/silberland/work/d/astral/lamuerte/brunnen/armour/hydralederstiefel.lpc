inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Hydralederstiefel");
  SetProp(P_LONG, 
    "Diese Stiefel sind aus dem Leder einer Hydra gefertigt. Sie sind noch "
    "ganz warm vom Feuer der Hydra, deshalb sind sie ein guter Kaelteschutz. "
    "Sie koennen sogar den Schaden durch Feuer verringern."); 
  SetProp(P_NAME, "Hydralederstiefel");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"stiefel","hydrastiefel", "hydralederstiefel", "\nwell_equip"}));

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_MAGIC, 3);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:-1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_FIRE:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_FIRE:-0.07]) );
  if( !silent)
    tell_object(environment(),
        "Du fuehlst Dich jetzt gegen Feuer geschuetzt.\n");
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}
