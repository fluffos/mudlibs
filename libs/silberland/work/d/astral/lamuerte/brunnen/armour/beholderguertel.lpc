inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>

void create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Beholderguertel");
  SetProp(P_LONG, 
    "Dieser Guertel besteht aus den aneinadergereihten Augen eines Beholders. "
    "Er ist schrecklich anzusehen, denn es scheint so, als wuerden die Augen "
    "noch leben und Dich staendig beobachten.");
  SetProp(P_NAME, "Beholderguertel");
  SetProp(P_GENDER, MALE);
  AddId (({"beholderguertel","guertel", "\nwell_equip"}));
  AddDetail( ({"augen", "beholderaugen"}),
    "Ob diese viele Augen Deine Sehleistung steigern koennen?"); 
  SetProp(P_INFO,
      "Es scheint so, als koennte die Magie der Beholderaugen auf Dich "
      "uebergehen und dadurch Deine Blindheit heilen.");

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_MISC_LIVING:90, MAT_LIGHT:10]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 1500);
  SetProp(P_QUALITY_DECAY, 444);
  SetProp(P_MAGIC, 3);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );

  call_other("/p/daemon/itemd/functions/defendfuncnoblind2", "???");
  ob=find_object("/p/daemon/itemd/functions/defendfuncnoblind2");
  SetProp(P_DEFEND_FUNC, ob);

}

void reset()
{
  ::reset();
  if(QueryProp(P_WORN) )
  {
    QueryProp(P_WORN)->SetProp(P_BLIND, 0);
  }
}

// TODO: bestimmte Anzahl von Augen, die bei jeder Blindheilung 1 weniger wird.
