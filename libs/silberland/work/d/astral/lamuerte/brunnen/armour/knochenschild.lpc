inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/nekromanten/nekro_properties.h"
#include "/p/daemon/itemd/itemd.h"

void create()
{
  object ob;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Knochenschild");
  SetProp(P_LONG, 
    "Der Knochenschild ist ein grosser Schild, der aus den Rippenknochen "
    "eines unbekannten Wesens besteht. Du kannst keinerlei Verbindung "
    "der einzelnen Knochen erkennen, es scheint fast so, als waeren sie "
    "so zusammengewachsen. Welch seltsame Magie mag hinter diesem Ding "
    "stecken?"); 
  SetProp(P_NAME, "Knochenschild");
  SetProp(P_GENDER, MALE);
  AddId (({"schild","knochenschild", "\nwell_equip"}));
  SetProp(P_INFO, "Der Knochenschild macht Dich in Windeseile satanisch.\n");
  AddDetail( ({"knochen", "wesen", "rippenknochen"}),
      "Welch seltsames Wesen hat wohl solche Knochen?");

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_BONE:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_MAGIC, 13);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, SR_GOOD: -500 ]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP:13, P_SP:13]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_NEKRO_SPELLCOST, 20);
  SetProp(P_NEKRO_BONUS, (["all": 20]) );

  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_ITEMD_TMPMAGIC, ({2000, 2000}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int align;
  if( (align=QueryProp(P_WORN)->QueryProp(P_ALIGN)) > -1000 )
    QueryProp(P_WORN)->SetProp(P_ALIGN, align - 1);
}

int WearFunc()
{
  SetProp(P_NODROP, 1);
  return 1;
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
  SetProp(P_NODROP, 1);
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

