inherit "/gilden/bardengilde/instrument/base_string";

#include "/gilden/bardengilde/barden_extern.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>
#include "../def.h"

create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Efreetisitar");
  SetProp(P_LONG, 
	  BS("Die Efreetisitar ist ein langhalsiges, bauchiges Saiteninstrument, "
       "das vollstaendig aus Metall gefertigt ist, um dem feurigen Griff "
       "der Efreeti zu widerstehen. Es erzeugt tragende und rasante Toene.")); 
  SetProp(P_NAME, "Efreetisitar");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"sitar", "efreetisitar", "\nwell_equip"}) );

  SetProp(P_INSTRUMENT_LEVEL, 5);

  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]));
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
}














