inherit "/gilden/bardengilde/instrument/base_floete";

#include "/gilden/bardengilde/barden_extern.h"
#include "/p/std/barden/instrument.h"
#include <properties.h>
#include <combat.h>
#include "../def.h"

create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Djinnenschabbaba");
  SetProp(P_LONG, 
	  BS("Die Djinnenschabbaba ist eine Floete, wie sie oft von Djinni gespielt wird. "
         "Sie besteht aus einem schlanken Spielrohr aus verholztem Schilf, das "
         "mit mehreren Griffloechern und Kerben versehen ist.")); 
  SetProp(P_NAME, "Djinnenschabbaba");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schabbaba", "floete", "djinnifloete", "\nwell_equip"}) );

  SetProp(P_INSTRUMENT_LEVEL, 5);

  SetProp(P_HANDS, 2);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1 ]) );
}














