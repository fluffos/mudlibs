inherit "std/container"; 
#include "../def.h"
#include "../well_level.h"

string uid;

void create()
{ 
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Eine Leiche");
  SetProp(P_LONG, 
    "Du siehst sterblichen Ueberreste.");

  SetProp(P_VALUE,0);
  SetProp(P_NOGET, "Ihh! Eine Leiche!\n");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_MISC_DEAD);
  SetProp(P_NAME,"Leiche");
  AddId( ({"leiche", "\nwell_corpse"}));

  seteuid(getuid());
  call_out("final_setup",2);
}

void final_setup()
{
  call_other(CORPSE "master", "register_me", 
      uid, well_level(this_object()));
}

varargs int PreventLeave(object ob, mixed dest)
{
  if( getuid(dest)!=uid )
    return 1;
  return ::PreventLeave(ob);
  if (find_call_out("check") == -1)
    call_out("check", 0);
}

void check()
{
  if(!sizeof(all_inventory()) )
  {
    if( environment() ) 
      tell_room(environment(), "Die Leiche zerfaellt zu Staub.\n");
    remove();
  }
}

void reset()
{
  ::reset();
  if( !is_clone(this_object())) 
    return set_next_reset(-1); // No reset in blueprint
  set_next_reset(5*60);
  check();
}

void remove()
{
  call_other(CORPSE "master", "remove_me" );
  ::remove();
}

/* Damit die Leiche nicht voll wird... */
int MayAddWeight(mixed weight)
{
  return 0;
}

/* Uebernehme den Namen von ob */
void Identify(object ob)
{
  int level;
  string _name;

  uid=getuid(ob);
  AddId( "leiche\n" + file_name(ob) );
  _name = ob->name(WESSEN,0);
  SetProp(P_SHORT, "Die Leiche "+_name);
  SetProp(P_LONG, "Du siehst die sterblichen Ueberreste "+ _name + ".\n");
  level=ob->QueryProp(P_LEVEL);
  SetProp(P_LEVEL, level);
  SetProp(P_ORIG_NAME, ob->name(RAW));
  SetProp(P_RACE, ob->QueryProp(P_RACE));
  SetProp(P_SIZE, ob->QueryProp(P_SIZE));
  SetProp(P_WEIGHT, ob->QueryProp(P_WEIGHT));
  SetProp(P_KILLER, ob->QueryProp(P_KILLER));
  SetProp(P_ATTRIBUTES, ob->QueryProp(P_ATTRIBUTES));
  SetProp(P_LAST_DAMTYPES, ob->Query(P_LAST_DAMTYPES));
  SetProp(P_ALIGN, ob->QueryProp(P_ALIGN));
  
}

int query_prevent_shadow() { return 1; }
