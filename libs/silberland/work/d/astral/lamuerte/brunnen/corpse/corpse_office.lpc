// Buero von Loewenherz
// 28-7-2002 Feyaria@SilberLand
inherit "std/laden";
inherit "/std/more";

#include "../def.h"
#include <laden.h>
#include <ansi.h>
#include <mnpc.h>

string storage;
string liste;

void randomliste()
{
  liste= ({ "frags_top.log",  "npc_playerkills.log",   "npc_top.log",
            "player_lostxp.log", "lvl_top.log",   "npc_playerlostxp.log",
            "player_death.log",  "welllvl_top.log"})[random(8)];
}

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "Im Buero von Loewenherz");
  SetProp(P_INT_LONG, 
      "Du stehst in Buero von Loewenherz, dem mutigen Wiederbeschaffer von "
      "Leichen. Solltest Du im Brunnen gestorben sein, so frag einfach "
      "Loewenherz, ob er Dir Deine Leiche wieder von dort herausholt. "
      "Billig ist das aber sicher nicht, sonst haette er sein Buero nicht "
      "so exklusiv einrichten koennen."); 
  SetProp(P_NO_MNPC, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );
  SetStorageRoom (storage=CORPSE "store");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER+SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_NAME, "Loewenherz");
  SetProp(P_SHOPKEEPER_GENDER, MALE);
  SetProp(P_SHOPKEEPER_ID, "loewenherz");
  SetBuyFact(1);
  RemoveFixedObject(0);

  AddDetail( ({"boden"}), 
      "Der Boden ist voller Staub.");
  AddDetail( ({"decke", "holz", "balken", "holzbalken"}), 
      "Die Decke ist aus Holzbalken gefertigt. Auf einem der Balken "
      "ist eine Gravur zu sehen.");
  AddDetail("gravur",
      "Sie sieht verwackelt aus, aber mit ein bisschen Muehe kannst Du sie "
      "lesen.");
  AddReadDetail("gravur",
      ".-----------------------------------------------------------------.\n"
      "| Hi, ich war da!                                                 |\n"
      "|                                                       Haegar.   |\n"
      "'-----------------------------------------------------------------'\n");
  AddDetail( ({"wand", "waende"}), 
      "Vier Waende gibt es in diesem Raum. Eine im Norden, eine im Sueden, "
      "eine im Westen und, welche Ueberraschung, eine im Osten.");
  AddDetail( ({"ueberraschung"}),
      "Also eine richtige Ueberraschung war das nicht......");
  AddDetail( ({"raum", "buero"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"staub"}), 
      "Wo der viele Staub bloss herkommt? Ob das vielleicht lauter zu Staub "
      "zerfallene Leichen sind?");
  AddDetail( ({"leichen", "leiche"}), 
      "Da Loewenherz sein Geld damit verdient, Leichen von verstorbenen "
      "Abenteurern aus dem Brunnen zu bergen, liegen hier wohl ab und zu "
      "einige Leichen herum, bevor sie zu Staub zerfallen.");
  AddSpecialDetail( ({"geld","muenzen"}), "det_geld");
  AddDetail( ({"loewenherz"}), 
      "Loewenherz ist gerade nicht da, sicher ist er gerade unterwegs, um "
      "eine Leiche zu bergen.");
  AddDetail( ({"abenteurer"}),
      "Solche Leute wie Du!");
  AddDetail( ({"leute"}),
      "Leute, die Mehrzahl von Leut.");
  AddDetail( ({"leut"}),
      "Leut, die Einzahl von Leute.\n"
      "Du denkst . o O (Gibt es dieses Wort ueberhaupt?)");
  AddDetail( ({"wort", "einzahl", "mehrzahl", "begriff"}),
      "Es gibt nicht zu jedem Begriff eine Einzahl und eine Mehrzahl.");
  AddDetail( ({"brunnen"}),
      "Du kennst den Brunnen nicht? Irgendwann wirst Du ihn schon "
      "kennenlernen, und wenn Du dann dort stirbst, kannst Du auch auf die "
      "Dienste von Loewenherz zurueckgreifen. Mit dem Kommando <bwo> kannst "
      "Du nachsehen wer gerade im Brunnen ist.");
  AddDetail( ({"wiederbeschaffer", "dienste"}),
      "Loewenherz kann Dir Deine Leiche wieder beschaffen, wenn Du im Brunnen "
      "gestorben sein solltest.");
  AddSpecialDetail( "name", "det_name");
  AddDetail( ({"osten", "ostwand"}),
      "Die Ostwand ist im Osten (wie der Name schon sagt). Dort geht es raus "
      "nach Kyranda.");
  AddDetail( ({"kyranda", "silberland", "stadt"}),
      "Du befindest Dich in Kyranda, einer Stadt im SilberLand.");
  AddDetail( ({"westen", "westwand"}),
      "Die Westwand ist im Westen (wie der Name schon sagt). Dort steht ein "
      "grosser Schreibtisch .");
  AddDetail( ({"norden", "nordwand"}),
      "Die Nordwand ist im Norden (wie der Name schon sagt). Dort haengt ein "
      "Spiegel mit Goldrahmen.");
  AddDetail( ({"sueden", "suedwand"}),
      "Die Suedwand ist im Sueden (wie der Name schon sagt). Dort haengt eine "
      "grosse magische Karte des SilberLandes, wo man immer sieht, wo sich der "
      "Brunnen gerade aufhaelt.");
  AddDetail( ({"schreibtisch", "tisch"}),
      "Der Schreibtisch von Loewenherz ist ueberdeckt mit lauter Papieren. "
      "Er besteht aus teuerstem Tropenholz.");
  AddDetail( ({"papiere"}),
      "Die Papiere bilden einen richtigen Haufen. Ob das vielleicht was "
      "Interessantes dabei ist?");
  AddDetail( ({"haufen"}),
      "Du koenntest in dem Haufen wuehlen.");
  AddDetail( ({"tropenholz", "dschungel"}),
      "Tropenholz, importiert aus dem Dschungel, fuer jeden anderen beinahe "
      "unerschwinglich teuer.");
  AddDetail( ({"spiegel"}),
      "An der Nordwand haengt ein grosser Spiegel mit Goldrahmen. Man muss "
      "schon extrem reich sein, um sich so ein Kunstwerk aus Feenhand leisten "
      "zu koennen.");
  AddDetail( ({"goldrahmen", "gold", "rahmen"}),
      "Der Goldrahmen war sicher sehr teuer. Schon alleine das Gold ist viel "
      "wert.");
  AddDetail( ({"feenhand", "feen", "fee", "kunstwerk", "kunstwerke"}),
      "Solche Spiegel fertigen nur die Feen, solche Kunstwerke sind extrem "
      "selten, weil sie so teuer sind.");
  AddDetail( ({"karte"}),
      "Die Karte auf der Suedwand zeigt das ganze SilberLand. Loewenherz kann "
      "auf ihr immer sehen, wo der Brunnen sich gerade aufhaelt, damit er "
      "Leichen von dort holen kann.");

  AddSmell( ({DEFAULT_SMELL, "leichen"}),
      "Irgendwie riecht es hier nach Leichen.");
  AddSound( ({DEFAULT_SOUND, "strassenlaerm", "laerm", "osten"}),
      "Aus dem Osten hoerst Du Strassenlaerm.");

  AddItem( ({CORPSE "loewenherz"}), REFRESH_DESTRUCT );
  AddCmd( ({"wuehle", "wuehl", "durchwuehle", "durchwuehl"}), "wuehlen");
  AddCmd(({"bwhere", "bwhe", "bwo"}), "whe");
  AddExit("osten","/d/ebene/lamuerte/burg/weg/10x4y");
  seteuid(getuid(this_object()));
  randomliste();

  AddItem( CORPSE "welltopliste", REFRESH_DESTRUCT );
}

string det_name()
{
  return "Dein Name lautet: "+this_player()->Name(WER,1)+"\n";
}

string det_geld()
{
  return break_string("Du hast "+this_player()->QueryDeepMoney()+" Muenzen, "
      "ob das wohl genuegt, um Loewenherz zu bezahlen?", 78);
}

sell()
{
  notify_fail(break_string("Such Dir einen anderen Laden zum verkaufen, das "
        "wird doch nicht so schwer sein, oder?",78, "Loewenherz sagt: "));
  return 0;
}

force_sell() { return sell(); }
evaluate() { return sell(); }

void reset()
{
  ::reset();
  randomliste();
}

int wuehlen(string str)
{
  notify_fail("Was willst Du durchwuehlen?\n");
  if (str != "haufen" && str != "in haufen" && str != "papiere" && str != "in papieren")
    return 0;
  write("Du wuehlst in den Papieren und findest eine sehr interessante Liste:\n");
  say( this_player()->Name(WER,1)+ " wuehlt in den Papieren am Schreibtisch herum.\n");
  this_player()->More(read_file(
        LOGS "top/generic/"+liste));
  return 1;
}



nosave int CheckZone(object u)
{
  if (!(ENV(u))) return 0;      // gerade einloggende Spieler...
  if (stringp(ENV(u)->QueryProp(P_ZONE)) &&
      ENV(u)->QueryProp(P_SUBDOMAIN) == "Brunnen"  &&
      (!IS_LEARNER(u) || IS_ARCH(TP))) 
    return 1;
  return 0;
}


int whe(string str)
{
  int i, j;
  object *usrs;
  string u_name, u_lev, u_loc, u_zone, u_end;

  if (!(i = sizeof(usrs = filter_array(users(),"CheckZone"))))
  {
    write("Es befinden sich derzeit keine Spieler im Brunnen.\n");
    return 1;
  }
  switch(TP->QueryProp(P_TTY)) 
  {
    case "ansi" : u_name = ANSI_GREEN + ANSI_BOLD; u_lev = ANSI_YELLOW + ANSI_BOLD;
                  u_zone = ANSI_NORMAL; u_loc = ANSI_CYAN;
                  u_end = ANSI_NORMAL; break;
    case "vt100": u_name = ANSI_BOLD; u_lev = ANSI_NORMAL; u_loc = ANSI_BOLD;
                  u_zone = ANSI_NORMAL; u_end = ANSI_NORMAL; break;
    default     : u_name = u_lev = u_loc = u_zone = u_end="";
  }

  str = "Derzeit befinden sich folgende Spieler im Brunnen:\n"
        "       Name      Stufe      Zone              Ort\n"
        "-+--------------+-----+-----------------+--------------------------\n";
  for (j = 0; j < i; j++) 
  {
    str += sprintf(" | %s%-12s%s | %s%3d%s | %s%-15s%s | %s%s%s\n",
        u_name, CAP(getuid(usrs[j])), u_end,
        u_lev, usrs[j]->QueryProp(P_LEVEL), u_end,
        u_zone, environment(usrs[j])->QueryProp(P_ZONE), u_end,
        u_loc, (IS_WIZARD(TP) ? file_name(environment(usrs[j])) : 
          environment(usrs[j])->QueryProp(P_INT_SHORT)), u_end
        );
  }
  TP->More(str+"\n");
  return 1;
}

void init()
{
  object ob;
  
  ::init();
  if( this_player() && (ob = present("\nfragkristall", this_player())) )
    ob->set_modifiers();
  if(!find_living("wellentrancenpc"))
    call_other( NPC "eingang", "???");
}

