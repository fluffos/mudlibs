inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddId("\nbrunnencorpseobj");
}

void init()
{
  ::init();
  if (!query_once_interactive(environment())) 
    return remove(),0;
  environment()->Set(P_CORPSE, symbol_function("p_corpse", this_object()), F_QUERY_METHOD);
  environment()->Set(P_NOCORPSE, symbol_function("p_nocorpse", this_object()), F_QUERY_METHOD);
}

string p_corpse()
{
  if(file_name(environment(previous_object()))[0..37]==ROOMS "level") 
    return CORPSE "corpse";
  else
    return previous_object()->Query(P_CORPSE);
}

int p_nocorpse()
{
  if(file_name(environment(previous_object()))[0..37]==ROOMS "level" ||
      file_name(environment(previous_object()))[0..17] == "/d/astral/feyaria/")
    return 0;
  else
    return previous_object()->Query(P_NOCORPSE);
}
