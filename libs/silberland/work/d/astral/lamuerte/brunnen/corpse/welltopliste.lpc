/* Folgendes war mal long() */
string _query_long()
{
  string file;

  if (this_player()) {
    if ( file_size(whatdenn) ) {
      file = read_file(whatdenn);
      this_player()->More( file );
    }
    else
      write("Da lief etwas schief!\n");
}
  whatdenn="";
  return "";
}
