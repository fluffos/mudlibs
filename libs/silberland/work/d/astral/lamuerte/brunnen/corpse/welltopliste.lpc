inherit "std/thing";

#include "../def.h"

string _query_long();
int magliste();
nosave string whatdenn;
nosave int mag;
int age;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  seteuid(getuid(this_object()));
  SetProp(P_SHORT,"Eine Top-Fragmenteliste, Top-Gegnerstufenliste, Top-Npcliste, Top-Killerliste, "+
	  "Top-Sterbeliste, Top-Epverlustliste und die einzelnen Top-Spielernamen");
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,20);
  AddId(({"liste","topliste","top-liste", "top-fragmenteliste",
          "fragmenteliste","topfragmenteliste",
          "topgegnerstufenliste","top-gegnerstufenliste","gegnerstufenliste",
          "topnpcliste","top-npcliste","topnpc","npcliste",
          "topkillerliste","top-killerliste","topkiller","killerliste",
          "topsterbeliste","top-sterbeliste","topsterbe","sterbeliste",
          "topepverlustliste","top-epverlustliste","epverlust","epverlustliste",
          "topspielernamen","top-spielernamen","spielernamen","spielernamenliste",
          ""}));
  SetProp(P_NAME,"Liste");
  SetProp(P_NOGET,"Die Topliste ist an der Wand festgenagelt.\n");
  mag=0;
}

void reset()
{
  ::reset();
  mag=0;
}

void init()
{
  ::init();
  add_action("lies","lies");
}

varargs int id(string str, int lvl)
{
  int ret;

  if((query_verb() == "lies") && stringp(str) &&
      file_size(LOGS "top/stats/" +
        regreplace(str,"[^A-Za-z]","",1) + ".log") >= 0)        // bugfix by woody, 6.9.2003
  {
    whatdenn=LOGS "top/stats/"+str+".log";
    return 1;}

  if (!ret = ::id(str))
    return ret;

  if (strstr(str,"verlust")>=0){
    whatdenn=LOGS "top/generic/player_lostxp.log";
    return 1;}
  if (strstr(str,"sterbe")>=0){
    whatdenn=LOGS "top/generic/player_death.log";
    return 1;}
  else if (strstr(str,"killer")>=0){
    whatdenn=LOGS "top/generic/npc_top.log";
    return 1;}
  else if (strstr(str,"npc")>=0){
    whatdenn=LOGS "top/generic/npc_playerkills.log";
    return 1;}
  else if (strstr(str,"gegnerstufen")>=0){
    whatdenn=LOGS "top/generic/lvl_top.log";
    return 1;}
  else if (strstr(str,"fragmente")>=0){
    whatdenn=LOGS "top/generic/frags_top.log";
    return 1;}
  else if (strstr(str,"spielername")>=0){
    whatdenn=LOGS "top/generic/spielernamen.txt";
    return 1;}
  else
  return 0;
}

int lies(string str)
{
  if (!id(str))
    return 0;
  _query_long();
  return 1;
}

