// ~(w) Feyaria 2002
// ~Loewenherz, der Leichen Wiederbeschaffer

inherit "std/npc";

#include "../def.h"

int geld = 0;

void create()
{
  object ob;
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Loewenherz, der Leichenwiederbeschaffer");
  SetProp(P_LONG, 
  "Vor Dir steht Loewenherz, der mutige Mann der in windeseile Deine "
  "Leiche aus dem Brunnen bergen kann. Eigentlich ist er ein kleines "
  "schmaechtiges Maennchen, dem man solche Leistungen eigentlich gar nicht "
  "zutraut. Das ist wohl auch der Grund, worum er an den gefaehrlichsten "
  "Monstern einfach so vorbeispazieren kann.");
  SetProp(P_ARTICLE,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Loewenherz");
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 175);
  SetProp(P_GENDER, MALE);
  SetProp(P_NOATTACK,"sagt: Ich mache keine Leichen, ich berge sie nur!");
  AddId(({"\nlionheart","loewenherz","lionheart"}));
  create_default_npc(32);
  SetProp(P_ALIGN, 270);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit seinem ganzen Mut",234,DT_BLUDGEON}));
          
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");

  SetProp(P_DIE_MSG, " stirbt einen Heldentod.\n");

  SetProp( P_REJECT, REJECT_KEEP);

  ob=clone_object("/std/weapon");
  ob->move(this_object());  
  ob->SetProp(P_NAME, "Leichensuchstab");
  ob->SetProp(P_SHORT, "Der Leichensuchstab von Loewenherz");
  ob->SetProp(P_WC, 250);
  ob->SetProp(P_GENDER, MALE);
  ob->wield_me();

  clone_object("/p/armour/trousers/lederbeinschienen")->move(this_object());  
  clone_object("/p/armour/bracers/lederarmschienen")->move(this_object());  
  clone_object("/p/armour/armour/lederpanzer")->move(this_object());  
  clone_object("/p/armour/helm/lederhelm")->move(this_object());  
  command("trage alles");

  AddInfo( DEFAULT_INFO,"sagt: Was willst Du eigentlich?\n");

  AddInfo( ({"brunnen"}),
      "Ich kenne den Brunnen in und auswendig, deshalb kann ich dort "
      "jede Leiche in kuerzester Zeit finden und hierherbringen!", "sagt: ");
  AddInfo( ({"leiche", "leichen"}),
      "Wenn Deine Leiche im Brunnen liegt, dann kannst Du mich ja "
      "beauftragen, sie zurueckzuholen.", "sagt: ");
  AddInfo( ({"kompass"}),
      "Mit dem Kompass kannst Du den Aufenthaltsort des Brunnens genau "
      "feststellen.", "sagt: ");
  AddInfo( ({"ampulle","ampullen"}),
      "Die Ampullen kannst Du an den Fontaenen im Brunnen auffuellen. Je nach "
      "Farbe haben sie unterschiedliche Wirkungen.", "sagt: ");
  AddInfo( ({"schriftrolle", "schriftrollen"}),
      "Die Schriftrollen haben unterschiedliche Wirkungen, aber alle sind sehr "
      "praktisch, wenn man sie im Brunnen mithat.", "sagt: ");
  AddInfo( ({"caposc", "caposc schriftrolle"}),
      "Damit kann man angeblich ein Portal aufmachen, das einem zurueck zum "
      "Eingang des Brunnens fuehrt.", "sagt: ");
  AddInfo( ({"plaressurco", "plaressurco schriftrolle"}),
      "Mit dieser Schriftrolle kann man einen Toten wiederbeleben, wenn er "
      "im Brunnen liegt. Falls Du aber nach einem Tod nicht mehr in den "
      "Brunnen zurueck willst, waer es besser wenn Du mich beauftragst, "
      "Deine Leiche hierher zu holen.", "sagt: ");

  AddCmd( ({"beauftrage", "beauftrag"}), "beauftragen");
}

int beauftragen(string str)
{
  int preis;
  
  notify_fail( "Wen willst Du beauftragen?\n");
  if( !str ) return 0;
  if( !id(str) ) return 0;

  preis=call_other(CORPSE "master", 
      "check_corpse", this_player() );

  tell_room( environment(this_object()),
      this_player()->Name() + " beauftragt Loewenherz.\n",
      ({ this_player() }) );

  if( !preis )
    return tell_room(environment(this_object()),
        break_string("Wieso willst Du mich beauftragen, wenn "
          "doch gar keine Leiche von Dir im Brunnen liegt? Los, geh und "
          "such den Brunnen und stirb dort, das wird doch nicht so schwer "
          "sein, oder?", 78, "Loewenherz sagt: ")), 1;

  if( this_player()->QueryMoney()<preis )
    return tell_room(environment(this_object()),
      break_string("Deine Leiche wiederzubeschaffen wuerde "+
          preis+ " Muenzen kosten, Du hast aber nur mickrige "+
          this_player()->QueryMoney()+". Geh doch einfach zur Bank und "
          "pluender Dein Konto, das wird doch nicht so schwer "
          "sein, oder?", 78, "Loewenherz sagt: ")), 1;

  tell_room(environment(this_object()),
      break_string("Das kostet "+ preis+ " Muenzen, ist doch geschenkt "+
        "fuer meinen tollen Service, oder?", 78, "Loewenherz sagt: ")+
      break_string("Loewenherz rast aus dem Raum und ist in "
        "Sekundenbruchteilen mit einer Leiche im Schlepptau wieder da.",78));

  write_file(LOGS "kills",
        dtime(time())+": "+capitalize(getuid(this_player()))+" kauft Leiche um "+
        preis+ " Muenzen.\n");
  this_player()->AddMoney(-preis);
  geld += preis;
  call_other(CORPSE "master", "get_corpse", this_player() );
  
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  if(geld) 
  {
    "p/daemon/zentralbank"->PayIn(geld, 100);
    geld=0;
  }
}
