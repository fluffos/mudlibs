#include "../../def.h"
inherit ROOMS "room";

void create() {
  ::create();
  seteuid(getuid(this_object()));
  SetProp( P_INT_SHORT, "In einem Brunnen");
  SetProp( P_LIGHT, 0);
  SetProp(P_INDOORS, 1 );
   SetProp(P_INT_LONG,"Du befindest Dich inmitten eines riesigen Gangs. Es hat beinahe ein mediterranes Klima in diesem Raum, Feuchtheit liegt in der Luft. Einige mit Moos und Unkraut bewachsene Stellen zeigen, dass es wirklich um die 290% Luftfeuchte haben muss. Du kannst hier zwei Wege einschlagen, um vorwaerts zu kommen.");
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15+random(10), ENV_TERRAIN:TT_CAVE]) );
   SetProp(P_ELEMENTAL_ROOM,"wasser");
   SetProp(P_ZONE, "Level 2");
AddDetail(({"gang","gangs","ganges"}),
    "Alles ist feucht in diesem Gang.");
AddDetail(({"sackgasse"}),
    "Es gibt nur einen Ausgang, der Dich aus dieser Sackgasse herausbringt.");
AddDetail(({"ende"}),
    "Du siehst Dich um. Ja, das hier ist wirklich das Ende. Zeit, einen anderen Weg einzuschlagen.");
AddDetail(({"wegen","wege","weg","weges"}),
    "Es gibt verdammt viele Wege hier, welchen sollst Du nur einschlagen?");
AddDetail(({"raeume","raum","raums"}),
    "Der Raum vermittelt einen kuehlen Eindruck.");
AddDetail(({"ausgang","ausgaenge"}),
    "Nun bist Du schon durch so viele Ausgaenge gewandert und hast immer noch keine Idee, wohin Du gehen sollst.");
AddDetail(({"idee"}),
    "Eine Idee untersuchen? Na dazu muesstest Du erst mal eine haben!");
AddDetail(({"richtung","richtungen"}),
    "Welche ist nun die richtige Richtung?");
AddDetail(({"gasse"}),
    "Es ist feucht in dieser Gasse.");
AddDetail(({"wand","waende","waenden"}),
    "Die Waende hier drinnen sind ziemlich feucht. Wassertropfen haengen an den Waenden.");
AddDetail(({"tropfen","wassertropfen"}),
    "Die Wassertropfen ueberziehen die Waende.");
AddDetail(({"kreuzung"}),
    "Du blickst Dich um. Tatsaechlich eine Kreuzung. Vier Wege laufen hier zusammen.");
AddDetail(({"luft"}),
    "Es muss viel Luftfeuchtigkeit haben hier herinnen, Du kannst kaum atmen.");
AddDetail(({"luftfeuchtigkeit"}),
    "Recht viel feuchter kann die Luft nicht sein, es fuehlt sich alles feucht an, selbst Du.");
AddDetail(({"feuchtigkeit"}),
    "Es ist wirklich alles feucht hier.");
AddDetail(({"temperatur"}),
    "Es ist angenehm warm hier. Gerade recht, wuerdest Du mal behaupten.");
AddDetail(({"temperaturen"}),
    "Wirklich gerade recht hier, bis auf die stickige Luft.");
AddDetail(({"klima"}),
    "Das Klima hier herinnen ist angenehm. Du fuehlst dich wohl.");
AddDetail(({"feuchte"}),
    "Es hat wirklich eine enorme Luftfeuchtigkeit, darum ist alles so feucht hier.");
AddDetail(({"schweiss"}),
    "Schleck. Er ist salzig.");
AddDetail(({"koerper"}),
    "Dein Koerper fuehlt sich schon total aufgeweicht an. Muss wohl an der Feuchte liegen.");
AddDetail(({"dunst"}),
    "Der Dunst truebt Deine Sicht ein wenig, ansonsten stoert er aber nicht weiter.");
AddDetail(({"sicht"}),
    "Sie ist gut genug, um alles klar zu erkennen.");
AddDetail(({"wasser"}),
    "Es ist nass.");
AddDetail(({"arme","armen"}),
    "Sie sind total verschwitzt.");
AddDetail(({"dschungel"}),
    "Du bist nicht wirklich im Dschungel hier, selbst wenn die Waerme und Luftfeuchtigkeit darauf schliessen lassen koennten.");
AddDetail(({"waerme"}),
    "Es ist angenehm warm. Du schaetzt so 28°C.");
AddDetail(({"verhaeltnis","verhaeltnisse"}),
    "Gute Verhaeltnisse zum Sterben.");
AddDetail(({"hitze"}),
    "Es ist nicht wirklich so heiss durch die Temperatur, aber durch die hohe Luftfeuchtigkeit drueckt es ein wenig.");
AddDetail(({"temperaturunterschiede"}),
    "Die Temperaturunterschiede in dieser Region wechseln wirklich sehr oft. Muss wohl mit Magie zusammenhaengen.");
AddDetail(({"magie"}),
    "Das ist nichts fuer Dich, viel zu kompliziert.");
AddDetail(({"umgebung"}),
    "Du siehst Dir die Umgebung an, findest aber nichts besonders wichtiges.");
AddDetail(({"teil"}),
    "Ein Teil von vielen, wirklich nicht sehr aufregend.");
AddDetail(({"gott"}),
    "Woody? Wo ist der bloss?");
AddDetail(({"woody"}),
    "Du soltest wieder mal beten, vielleicht hast Du dann eine Erscheinung.");
AddDetail(({"erscheinung"}),
    "Woody kommt an.\nWoody sagt: Hiermit erscheine ich Dir.\nWoody winkt.\nWoody teleportiert sich nach Hause.\n");
AddDetail(({"haare"}),
    "Auch Deine Haare werden langsam feucht.");
AddDetail(({"frisur"}),
    "Du siehst ja aus wie Feyaria?! Muahah, geh mal haareschneiden!");
AddDetail(({"hand"}),
    "Doch, sie ist da irgendwo.");
AddDetail(({"augen"}),
    "Du kannst sehen, also musst Du auch Augen haben, oder?");
AddDetail(({"nebel"}),
    "Es ist wirklich dunstig hier. Doch man kann noch genug sehen, wenn man sich zusammenreisst.");
AddDetail(({"nebelschwaden"}),
    "Sie verhindern beinahe, dass man etwas sieht.");
AddDetail(({"bronchitis"}),
    "*HUST* Naja, geht schon wieder.");
AddDetail(({"koerper"}),
    "Du fuehlst Dich feucht. Hast Du Dich angemacht?");
AddDetail(({"schlingpflanzen"}),
    "Sie sind gruen und riesig.");
AddDetail(({"wunder"}),
    "Du glaubst an keine Wunder. Also untersuch sie auch nicht erst.");
AddDetail(({"vogel"}),
    "Soviel Du erkennen konntest, war er gruenblauviolettmagentasilberschwarzweissbraunlila gestreift.");
AddDetail(({"blickfeld"}),
    "Dein Blickfeld ist etwas eingeschraenkt durch die vielen Nebelschwaden.");
AddDetail(({"boden"}),
    "Der Boden ist selbstverstaendlich auch feucht hier.");
AddDetail(({"moos"}),
    "Das Moos gedeiht hier praechtig.");
AddDetail(({"unkraut"}),
    "Das Unkraut sieht ekelhaft aus.");
AddDetail(({"pflanzen"}),
    "Du kennst keine einzige dieser vielen Pflanzen, bis auf das Moos vielleicht.");
AddDetail("krkmorcks",
    "Aeh, Krkmorcks? Ja, genau, abgefaulte liegen da am Boden herum.");
AddDetail(({"pflanzenparadies"}),
    "Naja, das ist vielleicht etwas uebertrieben, aber sie wachsen schon ganz gut hier.");
AddDetail(({"schlingpflanze"}),
    "Sie ist gruen, lang und gedeiht praechtig.");
AddDetail(({"holzstamm","holzstaemme"}),
    "Sie sind verfault. Einige Wuermer kriechen in ihnen herum.");
AddDetail(({"wuermer"}),
    "Es sind Holzwuermer.");
AddDetail(({"holzwuermer"}),
    "Sie fressen sich durch die abgefaulten Holzstaemme.");
AddDetail(({"laub","tropenlaub"}),
    "Es ist verfault.");
AddDetail(({"affe"}),
    "Angrox ist nicht hier.");
AddDetail(({"taeuschung"}),
    "Ja, war wohl wirklich eine.");
AddDetail(({"gras","tropengras","graeser"}),
    "Leider ist kein thc drinnen, sonst wuerde man es rauchen koennen.");
AddDetail(({"tarzen"}),
    "Du Tarzan, aber wer Jane?");
AddDetail(({"sinnestaeuschung"}),
    "Ja, die Sinnestaeuschung hat zugeschlagen.");
AddDetail(({"stelle","stellen"}),
    "Viele Stellen sind total feucht hier.");
AddDetail(({"luftfeuchte"}),
    "Sie liegt wirklich beinahe bei 400%.");
AddDetail("decke",
    "Selbst die Decke ist total feucht hier.");
  AddItem( ({"/d/astral/lamuerte/brunnen/npc/ascomoid", "/d/astral/lamuerte/brunnen/npc/schimmelpilz", "/d/astral/lamuerte/brunnen/npc/kristallschlamm", "/d/astral/lamuerte/brunnen/npc/myst", }), REFRESH_DESTRUCT);
   AddExit("norden","/d/astral/lamuerte/brunnen/rooms/level2/x25y22");
   AddExit("westen","/d/astral/lamuerte/brunnen/rooms/level2/x24y21");
}
