#include "../../def.h"
inherit ROOMS "room";

void create() {
  ::create();
  seteuid(getuid(this_object()));
  SetProp( P_INT_SHORT, "In einem Brunnen");
  SetProp( P_LIGHT, 0);
  SetProp(P_INDOORS, 1 );
   SetProp(P_INT_LONG,"Du befindest Dich in einem engen Gang. Deine Haare scheinen fast zu schmelzen bei dieser enormen Temperatur hier drinnen. Dir wird ganz uebel, als Du einen verkohlten Aschenhaufen eines Helden, der vor Dir hier starb, entdeckst. Du erkennst zwei Richtungen, in die Du weitergehen kannst.");
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25+random(20), ENV_TERRAIN:TT_CAVE]) );
   SetProp(P_ELEMENTAL_ROOM,"feuer");
   SetProp(P_ZONE, "Level 7");
AddDetail(({"gang","gangs","ganges"}),
    "Es ist sau heiss hier in diesem Gang.");
AddDetail(({"teil"}),
    "Phu, in diesem Teil ist es so heiss, dass Du beinahe vergluehst.");
AddDetail(({"sackgasse"}),
    "Naja, das Ende eines Weges halt.");
AddDetail(({"ausgang"}),
    "Das ist ein Gang, durch den man raus kann.");
AddDetail("gasse",
    "Du siehst Dich um. Ja eine wunderbare Gasse.");
AddDetail(({"ausgaenge","ausgaengen"}),
    "Die Ausgaenge zeigen Dir in keinster Weise, wohin Du weitergehen sollst.");
AddDetail("ausgang",
    "Ein Ausgang ist dazu da, um durch ihn durchzugehen.");
AddDetail(({"raum","raums"}),
    "Du unteruchst den Raum, er scheint gesund zu sein.");
AddDetail(({"richtung","richtungen"}),
    "Norden. Sueden. Osten. Westen. Hier ists immer noch am Besten.");
AddDetail(({"norden","sueden","osten","westen"}),
    "Das ist eine Himmelsrichtung!");
AddDetail("weg",
    "Du stehst auf einem, oder nicht?");
AddDetail("wege",
    "Viele Wege fuehren nach Midas, doch welchen Du hier einschlagen sollst, kannst Du nicht genau sagen.");
AddDetail("wand",
    "Du untersuchst die Wand. Sie sieht irgendwie heiss aus.");
AddDetail(({"waende","waenden"}),
    "Die Waende strahlen Waerme ab.");
AddDetail("waerme",
    "Naja, es ist fast schon Hitze.");
AddDetail("hitze",
    "Du hast recht, es ist wirklich sauwarm hier drinnen. Komisch, diese haeufigen Klimawechsel.");
AddDetail(({"wechsel","klimawechsel"}),
    "Naja, irgendwie musst Du der Hoelle nah sein. Einmal kalt, einmal warm, das muss ein verzaubertes Gebiet sein.");
AddDetail("hoelle",
    "Hoffentlich kommst Du dort nicht hin, wenn to tot bist.");
AddDetail("gebiet",
    "Das Gebiet hier ist mit einem Klimafluch belegt.");
AddDetail(({"fluch","klimafluch"}),
    "Jeder Raum kann ein anderes Klima haben. Das ist sicher ein Fluch.");
AddDetail("raum",
    "Es ist ganz schoen heiss in diesem Raum hier.");
AddDetail("raums",
    "Pfuh, diese Hitze hier drinnen bringt Dich noch um.");
AddDetail("midas",
    "Du bist weit weg von dort.");
AddDetail("bereich",
    "Ganz schoen warm in diesem Bereich.");
AddDetail("durchgang",
    "Ein Gang, durch den man durch kann.");
AddDetail("durchgangsbereich",
    "Dieser Durchgangsbereich ist so aufgeheizt, dass Du beinahe vergluehst.");
AddDetail("kreuzung",
    "Naja, es handelt sich um eine ungeregelte, gesicherte Kreuzung mit vier Wegen.");
AddDetail("hitze",
    "Es hat hier mindestens 30°C. Einfach zu heiss fuer Dich.");
AddDetail("schweiss",
    "Du wischst Dir etwas Schweiss von der Stirn und schleckst ihn von Deinen Haenden ab. Igitt wie salzig!");
AddDetail("stirn",
    "Du klatschtst Dir auf die Stirn. Mann, ist es hier heiss!");
AddDetail(({"haende","haenden"}),
    "Die Innenseite Deiner Haende ist schmierig.");
AddDetail("innenseite",
    "Sie ist schweissbehaftet und schmierig.");
AddDetail(({"sohlen","schuhsohlen"}),
    "Sie sind schon ganz weich von der grossen Hitze.");
AddDetail("umgebung",
    "Du willst die Umgebung gar nicht naeher betrachten, es ist viel zu heiss dazu.");
AddDetail("feuer",
    "Ja, Feuer ist heiss, aber nicht so heiss wie die Raumtemperatur. *uebertreib*");
AddDetail(({"temperaturen","temperatur","raumtemperatur"}),
    "Du schaetzt sie auf 32,918°C.");
AddDetail("haut",
    "Sie ist mit Schweiss ueberzogen.");
AddDetail("wangen",
    "Sie sind rot. Sie sind heiss. Sie kochen beinahe.");
AddDetail(({"schuhe","schuhen"}),
    "Es sammelt sich Dein Schweiss in ihnen!");
AddDetail("klima",
    "Es wechselt sehr oft in dieser Gegend. Irgendwas kann da nicht stimmen.");
AddDetail("gegend",
    "Es ist trocken und heiss in diesem Raum, doch im Rest der Gegend kann es ganz anders aussehen.");
AddDetail("rest",
    "Naja, der Rest ist der Rest ist der Rest.");
AddDetail("achselhaare",
    "Deine Achselhaare sind verpufft. Du haettest sie so und anders nicht mehr gebraucht.");
AddDetail(({"behaarung","kopfbehaarung","haare"}),
    "Deine Kopfbehaarung loest sich schon fast auf bei den Temperaturen hier.");
AddDetail("bach",
    "Leider ist keiner da.");
AddDetail("boden",
    "Der Boden strahlt wie alles hier Hitze ab.");
AddDetail("decke",
    "Selbst die Decke ist fuerchterbar heiss.");
AddDetail(({"eier","spiegeleier"}),
    "Du hast doch keine Eier, oder?");
AddDetail("sauhitze",
    "Ja, wirklich, es IST heiss verdammt noch mal.");
AddDetail("wind",
    "Wind? Hier? Hahaha, kein Lueftlein ist zu spueren.");
AddDetail("lueftlein",
    "Keines da.");
AddDetail("sinne",
    "Deine Sinne sind schon ein wenig unscharf.");
AddDetail("ohren",
    "Deine Ohren vergluehen bald. Sie sind schon dunkelrot.");
AddDetail("irgendwas",
    "Blh blabb asjldh 0129.... Das war 'Irgendwas'.");
AddDetail("magma",
    "Es handelt sich nicht wirklich um Magma.");
AddDetail("gestein",
    "Das Gestein ist sehr heiss, wie alles um Dich in diesem Raum.");
AddDetail("ecke",
    "Ein kleines Feuerchen lodert dort.");
AddDetail("feuerchen",
    "Es brennt unaufhaltsam vor sich hin.");
AddDetail("feuer",
    "Das Feuer ist heiss, man koennte sich daran leicht verbrennen.");
AddDetail("flammen",
    "Sei vorsichtig, man verbrennt sich schneller, als man glaubt daran.");
AddDetail(({"brocken","gesteinsbrocken"}),
    "Auch sie strahlen Waerme ab.");
AddDetail(({"abstufung","abstufungen"}),
    "Es sind ganz schoen viele Abstufungen.");
AddDetail("flaemmchen",
    "Es war schon sehr mini. Kaum zu sehen.");
AddDetail("stelle",
    "Die war ganz schoen heiss.");
AddDetail("fuesse",
    "Sie tun Dir ein wenig weh.");
AddDetail("spucke",
    "Sie ist verdampft, als sie auf den Boden aufgetroffen ist.");
AddDetail("dampf",
    "Du findest nichts besonderes daran.");
AddDetail(({"asche","haeufchen","aschehaeufchen"}),
    "Scheint ein Haeufchen verbrannter Helden zu sein.");
AddDetail("haufen",
    "Der Haufen besteht aus Asche.");
AddDetail(({"helden","held"}),
    "Einige sind schon verbrannt hier drinnnen.");
AddDetail("gedanke",
    "Nicht ein klarer Gedanke, den Du fassen koenntest.");
AddDetail("glueck",
    "Hoffentlich hast Du mehr davon.");
AddDetail(({"dinge","dingen"}),
    "Welche denn?!");
AddDetail(({"teufel","feuerteufel"}),
    "Es ist keiner da, oder doch?!");
AddDetail("fusspuren",
    "Sie sind klar zu sehen.");
AddDetail("schuhwerk",
    "Es ist schon etwas abgenuetzt.");
AddDetail("nase",
    "Du fasst an Deine Nase. Ja, sie ist noch da.");
AddDetail("stein",
    "Er sieht hart, aber zersprungen aus.");
AddDetail(({"teile","einzelteile"}),
    "Eins, zwei, drei, viele Einzelteile.");
AddDetail("lagerfeuer",
    "Es strahlt enorme Hitze ab.");
  AddItem( ({"/d/astral/lamuerte/brunnen/npc/galebdur", "/d/astral/lamuerte/brunnen/npc/schwertdaemon", "/d/astral/lamuerte/brunnen/npc/doppelganger", }), REFRESH_DESTRUCT);
   AddExit("sueden","/d/astral/lamuerte/brunnen/rooms/level7/x27y16");
   AddExit("norden","/d/astral/lamuerte/brunnen/rooms/level7/x27y18");
AddItem("/d/astral/lamuerte/brunnen/potions/fontaene", REFRESH_REMOVE);
}
