inherit "std/room";
#include <properties.h>
#include <language.h>

void create() {
  ::create();
  SetProp( P_INT_SHORT, "Im Nichts");
  SetProp( P_INT_LONG, "Du stehst in einem dunklen Teil des Nichts, hierher "+
  "brachten Dich magische Kraefte, als die Mauern einstuerzten. ");
  SetProp( P_LIGHT, 1);
  AddExit("raus","/d/ebene/lamuerte/burg/shop/loewenherz");
}
