#include "../../def.h"
inherit ROOMS "room";

void create() {
  ::create();
  seteuid(getuid(this_object()));
  SetProp( P_INT_SHORT, "In einem Brunnen");
  SetProp( P_LIGHT, 0);
  SetProp(P_INDOORS, 1 );
   SetProp(P_INT_LONG,"Du stehst in einem Teil, welcher schnurgerade weiterfuehrt. So fuerchterlich kalt wie es hier drinnen ist, war es wo anders noch ueberhaupt nie. An den Waenden haben sich einige Eiskristalle gebildet, sie funkeln praechtig. Du kannst hier zwei Wege einschlagen, um vorwaerts zu kommen.");
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: -25+random(20), ENV_TERRAIN:TT_CAVE]) );
   SetProp(P_ELEMENTAL_ROOM,"eis");
   SetProp(P_ZONE, "Level 1");
AddDetail(({"gang","gangs","ganges"}),
    "Es ist sehr kuehl in diesem Gang.");
AddDetail(({"sackgasse"}),
    "Es gibt nur einen Ausgang, der Dich aus dieser Sackgasse herausbringt.");
AddDetail(({"ende"}),
    "Du siehst Dich um. Ja, das hier ist wirklich das Ende. Zeit, einen anderen Weg einzuschlagen.");
AddDetail(({"wegen","wege","weg","weges"}),
    "Es gibt verdammt viele Wege hier, welchen sollst Du nur einschlagen?");
AddDetail(({"raeume","raum","raums"}),
    "Der Raum vermittelt einen kuehlen Eindruck.");
AddDetail(({"ausgang","ausgaenge"}),
    "Nun bist Du schon durch so viele Ausgaenge gewandert und hast immer noch keine Idee, wohin Du gehen sollst.");
AddDetail(({"idee"}),
    "Eine Idee untersuchen? Na dazu muesstest Du erst mal eine haben!");
AddDetail(({"richtung","richtungen"}),
    "Welche ist nun die richtige Richtung?");
AddDetail(({"gasse"}),
    "Es ist kuehl in dieser Gasse.");
AddDetail(({"wand","waende","waenden"}),
    "Es sind viele kleine Eiskristalle an den Wanden zu sehen.");
AddDetail(({"kristalle","eiskristalle","eiskristallen"}),
    "Die Kristalle funkeln. Beinahe bist Du davon geblendet.");
AddDetail(({"kreuzung"}),
    "Du blickst Dich um. Tatsaechlich eine Kreuzung. Vier Wege laufen hier zusammen.");
AddDetail(({"teil"}),
    "Sieht komisch aus, aber du hast keine Idee warum.");
AddDetail("boden",
    "Der Boden ist spiegelglatt.");
AddDetail("decke",
    "Die Decke ist mit einer duennen Eisschicht ueberzogen.");
AddDetail("eisschicht",
    "Sie ist hauchduenn.");
AddDetail(({"kaelte"}),
    "Es ist wirklich saukalt hier drinnen. Komisch einige Raeume vorher war es doch noch wunderbar warm.");
AddDetail(({"temperatur","temperaturen"}),
    "Du hast das Gefuehl, als haette es -93°C. Doch das kann wohl nicht sein. Du bibberst vor lauter Kaelte.");
AddDetail("gefuehl",
    "Manchmal kann es Dich auch taeuschen.");
AddDetail(({"klima"}),
    "Das Klima wechselt hier in diesem Gebiet rasch. Manchmal ist es sauheiss, dann wieder eiskalt.");
AddDetail(({"gebiet"}),
    "Du befindest Dich in einem Durcheinander von Gaengen");
AddDetail(({"durcheinander"}),
    "Ja, die Gaenge sind wirklich planlos aneinandergereiht.");
AddDetail(({"schal"}),
    "Hmm, vielleicht solltest Du Dir einen umhaengen? Naja, egal, Du bist doch eh so abgehaertet.");
AddDetail(({"hause"}),
    "Jaja, zu Hause waer es schoen warm und kuschelig.");
AddDetail(({"atem"}),
    "Du atmest aus und siehst, wie die Luft ihn dabei friert.");
AddDetail(({"luft"}),
    "Die Luft ist eisig kalt.");
AddDetail(({"rechnung","heizrechnung"}),
    "Hast Du vielleicht vergessen, sie zu bezahlen? Oder war es doch wer anderer?");
AddDetail(({"zehen"}),
    "Schoen langsam friert eine Zehe an die naechste.");
AddDetail(({"zehe"}),
    "Du spuerst sie kaum noch.");
AddDetail(({"schuhe","schuhen"}),
    "Dickes Schuhwerk ist angesagt in diesem kalten Raum.");
AddDetail(({"lust"}),
    "Lust? Nein, Lust hast Du gerade auf gar nichts.");
AddDetail(({"leben"}),
    "Du spielst mit dem Gedanken: 'SELBSTLOESCHUNG'");
AddDetail(({"smoersky"}),
    "Ja, das ist ein Badeort im Gegensatz zu dem hier, oder?");
AddDetail(({"knie"}),
    "Sie schlottern ganz fuerchterlich.");
AddDetail(({"leib"}),
    "Er ist beinahe schon unterkuehlt.");
AddDetail(({"ohren"}),
    "Sie sind steif geworden von der grimmigen Kaelte.");
AddDetail(({"eis"}),
    "Es ist saukalt und hart.");
AddDetail(({"hose"}),
    "Sie klebt an Deinem Bein. Ach, ist es aber auch wieder kalt hier drinnen.");
AddDetail(({"bein"}),
    "Du spuerst es kaum noch. Anscheinend friert es gerade ab.");
AddDetail("beine",
    "Du hast 2 davon.");
AddDetail(({"haare"}),
    "Sie sehen eher wie ein Yetifell als wie Haare aus.");
AddDetail("yetifell",
    "Ja genau, wie ein Yetifell sehen Deine Haare aus.");
AddDetail(({"eisklumpen"}),
    "Fuehlen sich kalt an.");
AddDetail(({"nase"}),
    "Sie ist schon rot angelaufen.");
AddDetail(({"knopf"}),
    "Meinst Du den in Deinem Gesicht? Das ist Deine Nase!");
AddDetail(({"gesicht"}),
    "Es ist schon ganz gefuehllos von der Kaelte hier.");
AddDetail(({"eiszapfen"}),
    "Du untersuchst einen Eiszapfen. Er ist lang, spitz und eiskalt. Aber er ist trotzdem schoen anzusehen.");
AddDetail(({"schnee"}),
    "Es handelt sich dabei um eine Anhaeufung von Eiskristallen.");
AddDetail(({"anhaeufung"}),
    "Naja, sie ist nicht besonders gross, aber man kann sie sehen.");
AddDetail(({"klimaunterschiede"}),
    "Sie sind von Raum zu Raum wirklich sehr unterschiedlich, doch manchmal auch gleich.");
AddDetail(({"schneehaufen"}),
    "Sieht kalt aus, so wie alles hier in diesem Raum.");
  AddItem( ({"/d/astral/lamuerte/brunnen/npc/pudding", "/d/astral/lamuerte/brunnen/npc/ascomoid", "/d/astral/lamuerte/brunnen/npc/berbalang", }), REFRESH_DESTRUCT);
   AddExit("sueden","/d/astral/lamuerte/brunnen/rooms/level1/x29y7");
   AddExit("norden","/d/astral/lamuerte/brunnen/rooms/level1/x29y9");
}
