#include "../../def.h"
inherit ROOMS "room";

void create() {
  ::create();
  seteuid(getuid(this_object()));
  SetProp( P_INT_SHORT, "In einem Brunnen");
  SetProp( P_LIGHT, 0);
  SetProp(P_INDOORS, 1 );
   SetProp(P_INT_LONG,"Du erblickst Dich inmitten eines engen Ganges. Es ist wahnsinnig angenehm hier, zumindest von der Umgebungstemperatur. *QEUEEK* Du faengst an zu grunzen, als Du vor lauter Sinnlosigkeit Deine Gedanken verlierst. Was? aeh? Hm.... Du erkennst zwei Richtungen, in die Du weitergehen kannst.");
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10+random(10), ENV_TERRAIN:TT_CAVE]) );
   SetProp(P_ELEMENTAL_ROOM,"humus");
   SetProp(P_ZONE, "Level 5");
AddDetail(({"gang","gangs","ganges"}),
    "Alles trocken und angenehm warm hier.");
AddDetail(({"sackgasse"}),
    "Es gibt nur einen Ausgang, der Dich aus dieser Sackgasse herausbringt.");
AddDetail(({"ende"}),
    "Du siehst Dich um. Ja, das hier ist wirklich das Ende. Zeit, einen anderen Weg einzuschlagen.");
AddDetail(({"wegen","wege","weg","weges"}),
    "Es gibt verdammt viele Wege hier, welchen sollst Du nur einschlagen?");
AddDetail(({"raeume","raum","raums"}),
    "Der Raum vermittelt einen angenehmen Eindruck.");
AddDetail(({"ausgang","ausgaenge"}),
    "Nun bist Du schon durch so viele Ausgaenge gewandert und hast immer noch keine Idee, wohin Du gehen sollst.");
AddDetail(({"idee"}),
    "Eine Idee untersuchen? Na dazu muesstest Du erst mal eine haben!");
AddDetail(({"richtung","richtungen"}),
    "Welche ist nun die richtige Richtung?");
AddDetail(({"gasse"}),
    "Es ist trocken und angenehm in dieser Gasse.");
AddDetail(({"wand","waende","waenden"}),
    "Die Waende hier drinnen sind ziemlich trocken.");
AddDetail(({"kreuzung"}),
    "Du blickst Dich um. Tatsaechlich eine Kreuzung. Vier Wege laufen hier zusammen.");
AddDetail("decke",
    "Selbst die Decke ist trocken und strahlt irgendwie eine angenehme Waerme ab.");
AddDetail(({"waerme"}),
    "Nicht zu heiss, nicht zu kalt, gerade angenehm warm.");
AddDetail(({"temperatur","temperaturen"}),
    "Es ist angenehm warm in diesem Raum.");
AddDetail("durchgangsbereich",
    "Es ist angenehm warm in diesem Durchgangsbereich.");
AddDetail("umgebung",
    "Deine Umgebung sieht ziemlich trostlos aus.");
AddDetail(({"raum"}),
    "Er vermittelt irgendwie Wohlbefinden.");
AddDetail(({"wohlbefinden"}),
    "Dir gehts hier richtig gut, oder?");
AddDetail(({"gegend"}),
    "Es ist warm, es ist trocken, es ist alles gut.");
AddDetail(({"stirn"}),
    "36.5°C. Kein Fieber, dir geht es gut.");
AddDetail(({"fieber"}),
    "Du hast kein Fieber, sei froh!");
AddDetail(({"glueck"}),
    "Du hast Glueck! Jawohl! Immerhin lebst Du noch!");
AddDetail(({"klima"}),
    "Das Klima ist angenehm hier. Schaetzungsweise 28°C.");
AddDetail(({"erwartung"}),
    "Du hast Dir anscheinend zu viel erwartet.");
AddDetail(({"bahnen"}),
    "Laeuft alles rund hier.");
AddDetail(({"teil"}),
    "Du untersuchst den Teil, findest aber absolut nichts besonderes daran.");
AddDetail(({"programmierer"}),
    "Aeh, reg Dich bei Lamuerte auf, wenn Dir was nicht passt.");
AddDetail(({"umgebungstemperatur"}),
    "Sie ist schaetzungsweise bei 26°C.");
AddDetail(({"dinge"}),
    "Du siehst keine interessanten Dinge herumliegen.");
AddDetail(({"bueschel"}),
    "Es ist Gras.");
AddDetail(({"gras"}),
    "Das Gras wurde schon lange nicht mehr gemaeht.");
AddDetail(({"oeffnung"}),
    "Sie ist so klein, Du kannst sie einfach nicht untersuchen.");
AddDetail(({"sinnlosigkeit"}),
    "Ach so schlimm ist es doch nicht.");
AddDetail(({"gedanken"}),
    "Brcheflslmsssss, du kannst keinen klaren Gedanken fassen.");
AddDetail(({"blumen"}),
    "Die Blumen haben viele verschiedene Farben.");
AddDetail(({"farben"}),
    "Alle Farben dabei, die Du so kennst.");
AddDetail(({"helden"}),
    "Ja, ein Held moechtest Du auch mal sein.");
AddDetail(({"reste","ueberreste"}),
    "Nicht viel uebrig geblieben von dem Helden. Muss ein grauenvoller Tod gewesen sein.");
AddDetail(({"tod"}),
    "Phu, was fuer ein Glueck, er ist nicht da. Hoffentlich holt er Dich nicht all zu schnell.");
AddDetail(({"grasbuechel"}),
    "Die Grasbueschel bestehen aus Gras, ist das nicht unglaublich?!");
AddDetail(({"laub"}),
    "Das Laub ist braun und total vertrocknet.");
AddDetail(({"baum"}),
    "Nein, Baum gibts hier wirklich keinen.");
AddDetail(({"kaefer"}),
    "Er ist zu flink, um ihn genauer zu untersuchen.");
AddDetail(({"klimaverhaeltnisse"}),
    "Hier ist das Klima angenehm, doch da es sich oft in diesem Gebiet aendert, strengt es Dich an vorwaertszukommen.");
AddDetail(({"steinhaufen"}),
    "Er besteht aus Steinen.");
AddDetail(({"steine"}),
    "Sie sind klein und hart.");
AddDetail(({"grasteppich"}),
    "Der Grasteppich ist gruen und sieht kuschelig weich aus.");
AddDetail(({"blumenwiese"}),
    "Blumenwiese kann man doch nicht dazu sagen, dafuer sind es zu wenige.");
AddDetail(({"horde","kaeferhorde"}),
    "Sie schleicht an der Wand entlang, sieht aber harmlos aus.");
AddDetail(({"wand","waende","waenden"}),
    "Die Waende strahlen eine angenehme Waerme ab.");
AddDetail(({"boden"}),
    "Du stehst drauf.");
  AddItem( ({"/d/astral/lamuerte/brunnen/npc/basilisk", "/d/astral/lamuerte/brunnen/npc/steinfresser", "/d/astral/lamuerte/brunnen/npc/fungus", "/d/astral/lamuerte/brunnen/npc/horgar", }), REFRESH_DESTRUCT);
   AddExit("sueden","/d/astral/lamuerte/brunnen/rooms/level5/x1y14");
   AddExit("norden","/d/astral/lamuerte/brunnen/rooms/level5/x1y16");
AddItem("/d/astral/lamuerte/brunnen/potions/fontaene", REFRESH_REMOVE);
}
