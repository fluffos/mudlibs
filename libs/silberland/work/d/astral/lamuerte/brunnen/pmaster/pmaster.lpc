#include <language.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <wizlevels.h>

mapping playerdb;

void create() {
  playerdb=([ ]);
}

void register_player(string pln) {
  if(!member(playerdb, pln))
    playerdb+=([ pln: file_name(environment(find_player(pln))) ]);
  return;
}

void unregister_player(string pln) {
  if(member(playerdb, pln))
  playerdb-=([ pln: file_name(environment(find_player(pln))) ]);
 return;
}

string show_player(string pln, string whom) {
  if(!find_player(whom)) return "Output Player not found!";
  if(member(playerdb,pln)){
    return playerdb[pln,0];
  }
 return "error";
}

int show_players(string whom) {
  string output;
  string *keys;
  int i;
  object whom2;
  
  keys=m_indices(playerdb);
  if(!whom2=find_player(whom)) return -1;
  output="-----------------------------------------------------------------\n";
  for(i=0;i<sizeof(keys);i++){
    playerdb[keys[i],0]=file_name(environment(find_player(keys[i])));
    output+=sprintf("  %-10s | %-20s \n",keys[i],playerdb[keys[i],0]);
  }
  output+="-----------------------------------------------------------------\n";
  tell_object(whom2,output);
  return 1;
}

