inherit "std/thing";

#include "../def.h"
#include "../well_level.h"

string farbe;
int type;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  AddId (({"\nbrunnenampull_schutz"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_DEFEND_FUNC, this_object());
}

void remove_me()
{
  if(environment())
  {
    tell_object(environment(), "Der Effekt der "+farbe+" Ampulle laesst nach.\n");
    switch(type)
    {
      case 1: 
        environment()->Set(P_FROG, 0, F_QUERY_METHOD);
        environment()->SetProp(P_FROG, 0);
        break;
      case 2: 
        environment()->Set(P_POISON, 0, F_QUERY_METHOD);
        environment()->SetProp(P_POISON, 0);
        break;
      case 3: 
        environment()->Set(P_BLIND, 0, F_QUERY_METHOD);
        environment()->SetProp(P_BLIND, 0);
        environment()->Set(P_DEAF, 0, F_QUERY_METHOD);
        environment()->SetProp(P_DEAF, 0);
        break;
      case 4: 
        environment()->Set(P_PARALYZED, 0, F_QUERY_METHOD);
        environment()->SetProp(P_PARALYZED, 0);
        break;
      case 5:
        environment()->Set(P_FROG, 0, F_QUERY_METHOD);
        environment()->SetProp(P_FROG, 0);
        environment()->Set(P_POISON, 0, F_QUERY_METHOD);
        environment()->SetProp(P_POISON, 0);
        environment()->Set(P_BLIND, 0, F_QUERY_METHOD);
        environment()->SetProp(P_BLIND, 0);
        environment()->Set(P_DEAF, 0, F_QUERY_METHOD);
        environment()->SetProp(P_DEAF, 0);
        environment()->Set(P_PARALYZED, 0, F_QUERY_METHOD);
        environment()->SetProp(P_PARALYZED, 0);
        break;
    }
  }
  call_out("remove",0);
}

varargs set_stat(int t, int dauer, object player, string f)
{
  object ob;
  if(!ob=previous_object()) 
    return remove();
  if((file_name(ob)!=AMPULLENMASTER) && 
      getuid(ob)!="feyaria" && getuid(ob)!="lamuerte")
    return remove();
  call_out("remove_me",dauer);
  type=t;
  farbe=f;
  switch(type)
  {
    case 1: 
      player->SetProp(P_FROG, 0);
      player->Set(P_FROG, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      break;
    case 2: 
      player->SetProp(P_POISON, 0);
      player->Set(P_POISON, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      break;
    case 3: 
      player->SetProp(P_DEAF, 0);
      player->SetProp(P_BLIND, 0);
      player->Set(P_DEAF, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      player->Set(P_BLIND, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      break;
    case 4: 
      player->SetProp(P_PARALYZED, 0);
      player->Set(P_PARALYZED, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      break;
    case 5:
      player->SetProp(P_FROG, 0);
      player->SetProp(P_POISON, 0);
      player->SetProp(P_DEAF, 0);
      player->SetProp(P_BLIND, 0);
      player->SetProp(P_PARALYZED, 0);
      player->Set(P_FROG, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      player->Set(P_POISON, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      player->Set(P_DEAF, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      player->Set(P_BLIND, symbol_function("schutz", this_object()), F_QUERY_METHOD);
      player->Set(P_PARALYZED, symbol_function("schutz", this_object()), F_QUERY_METHOD);
  }
}

mixed schutz()
{
  if (!environment() || !well_level(environment()))
    remove_me();
  return 0;
}

void reset()
{
  if (!is_clone(this_object()))
    return;
  ::reset();
  remove_me();
}
