inherit "std/thing";

#include "../def.h"
#include "../well_level.h"

int farbe;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Fontaene");
  SetProp(P_SHORT, "Eine Fontaene");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LONG,
      "Faerbiges Wasser spritzt aus dieser Fontaene heraus. Sicher kann "
      "man hier Ampullen auffuellen.");
  SetProp(P_NOGET, "Die Fontaene ist doch viel zu gross und zu schwer.\n");
  AddId (({"fontaene"}));
  SetProp(P_WEIGHT, 100000000);

  AddCmd( ({"fuelle", "fuell"}), "fuellen");
  call_out("final_setup",0);
}

final_setup()
{
  int level;
  if(!environment()) 
    return remove();
  if(!level=well_level())
    return remove();
  if(level*level>random(500))  
    farbe=({4,5,6})[random(3)];
  else
    farbe=({1,2,3})[random(3)];
  SetProp(P_COLOR, AMPULLENMASTER-> adjective(farbe));
  SetProp(P_NAME_ADJ, AMPULLENMASTER-> adjective(farbe));
  SetProp(P_SHORT, Name(WER,0));
  AddAdjective(({AMPULLENMASTER->colorstring(farbe),
       AMPULLENMASTER-> adjective(farbe)}));

  tell_room(environment(),"Die Fontaene faengt an "+AMPULLENMASTER-> adjective(farbe)+" zu spritzen.\n");
}

int fuellen(string str)
{
  string amp;
  object ob;
  notify_fail("Was willst Du in der Fontaene auffuellen?\n");
  if(!str) return 0;
  if( sscanf(str, "%s an schwanz aus fass heraus",amp) ==1)
  {
    write(break_string("Die richtige Syntax ist 'fuelle "+amp+
          " in fontaene auf', aber so funktioniert das auch!\n",78));
    str=amp+" in fontaene auf";
  }
  if( sscanf(str,"%s in fontaene auf",amp)!=1 && 
      sscanf(str,"%s auf",amp)!=1 ) 
    return 0;
  if(!ob=present(amp,this_player()))
    return write("Wie willst Du "+CAP(amp)+" auffuellen, wenn Du das gar nicht "
        "hast?\n"),1;
  if(!ob->id("\nbrunnenampulle"))
    return write("Du kannst nur die geeigneten Ampullen in dieser Fontaene "
       "auffuellen.\n"),1; 
  if(!ob->id("leerebrunnenampulle") && 
     !ob=present("leerebrunnenampulle", this_player()))
    return write("Du kannst nur leere Ampullen auffuellen!\n"),1;
  if( this_player()->InFight() && this_player()->QueryProp(P_ATTACK_BUSY) )
    return write("Nicht so schnell!\n"),1;
  this_player()->SetProp(P_ATTACK_BUSY, 1+random(4));
  ob->set_might(2 + 2 * well_level(TP) / 3);
  ob->set_color(farbe);
  write("Du fuellst die leere Ampulle in "+name(WEM,1)+" auf.\n");
  say(this_player()->Name()+" fuellt eine leere Ampulle in "+name(WEM,1)+
      " auf.\n",({this_player()}));
  return 1;
}

