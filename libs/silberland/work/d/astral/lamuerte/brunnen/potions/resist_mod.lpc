inherit "std/armour";

#include "../def.h"
#include "../well_level.h"

string *resist;
int dam;
string farbe;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  AddId (({"\nbrunnenampullen_resist_mod"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_DEFEND_FUNC, this_object());
}

void remove_me()
{
  if(environment())
  {
    tell_object(environment(), "Der Effekt der "+farbe+" Ampulle laesst nach.\n");
  }
  DoUnwear(1);
  call_out("remove",0);
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  int i;
  if ( !well_level(QueryProp(P_WORN)) )
    return remove_me(),0;
  if( intp(dam_type) )
    dam_type= ({dam_type});
  for(i=sizeof(dam_type)-1;i>=0;i--)
  {
    if( member(resist, dam_type[i])!=-1 )
    {
      return dam/3+random(dam);  
    }
  }
}

varargs set_stat(string* dam_type, int defend, int dauer, string f, mapping temp)
{
  object ob;
  if(!ob=previous_object()) 
    return remove();
  if((file_name(ob)!=AMPULLENMASTER) && 
      getuid(ob)!="feyaria" && getuid(ob)!="lamuerte")
    return remove();
  call_out("remove_me",dauer);
  resist=dam_type;
  dam=defend;
  farbe=f;
  if( mappingp(temp))
    SetProp(P_TEMPERATURE_PROTECTION, temp);
}

void reset()
{
  if (!is_clone(this_object()))
    return;
  ::reset();
  remove_me();
}
