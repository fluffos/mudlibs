inherit "std/thing";

#include "../def.h"
#include "../vt100.h"

string text;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Brunnenrezeptes!");
    destruct();
    return;
  }

  SetProp(P_NAME, "Rezeptbuch");
  SetProp(P_SHORT, "Ein Buch fuer Brunnenrezepte");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_LONG,
      "Dieses Rezeptbuch verraet Dir, welche Rezepte Du schon gelernt hast.");
  AddId (({"rezeptbuch", "buch"}));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOSELL, 1);

  AddCmd( ({"lies", "lese", "les"}), "cmd_lesen");

  SUID;
}

int cmd_lesen(string str)
{
  notify_fail("Was willst Du lesen?\n");
  if (!id(str) || !environment() || TP != environment())
    return 0;
  
  if (find_player("feyaria"))
    tell_object(find_player("feyaria"),
        VT_TA_B+VT_MAGENTA+"[Brunnen:] "+this_player()->Name(WER,1)+ 
        " liest im Rezeptbuch." +VT_NORMAL+"\n");
  write("Du liest im Rezeptbuch:\n");
  AMPULLENMASTER->check_player(getuid(this_player()), 0);
  RemoveCmd( ({"lies", "lese", "les"}) );
  call_out("remove_me", 2);
  return 1;
}

void remove_me()
{
  if(environment())
    tell_object(environment(), "Das Rezeptbuch zerfaellt zu Staub.\n");
  remove();
}

void reset()
{
  if(!is_clone(this_object())) return;
  ::reset();
  if(!random(3))
    remove_me();
}
