inherit "std/thing";

#include "../def.h"
#include "../well_level.h"

string text;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1) {
    raise_error("Illegales Clonen eines Brunnenrezeptes!");
    destruct();
    return;
  }

  SetProp(P_NAME, "Rezept");
  SetProp(P_SHORT, "Ein Rezept fuer eine Ampullenmischung");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_LONG,
      "Dieses Rezept verraet Dir, wie Du zwei Ampullen mischen kannst, um "
      "eine neue Mixtur zu bekommen. Vielleicht kannst Du das Rezept sogar "
      "entziffern.");
  AddId (({"rezept"}));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_NOSELL, 1);

  SUID;
//  call_out("final_setup",2);
}



void final_setup()
{
  object npc;
  int r;
  if(!npc=environment()) 
    return (void)remove();
  if(!(npc->id("\nbrunnenpc")) && 
      getuid(npc)!="feyaria" && getuid(npc)!="lamuerte")
    return (void)remove();
  AddCmd( ({"entziffer", "entziffere"}), "entziffern");
  text=AMPULLENMASTER->rezept(npc);
}

int entziffern(string str)
{
  object ob;

  notify_fail("Was willst Du entziffern?\n");
  if(!str || !id(str)) return 0;
  notify_fail("Das geht hier nicht.\n");
  if (!well_level(TP) || !environment() || TP != environment())
    return 0;
  write("Du entzifferst das Rezept:\n"+text);
  if (AMPULLENMASTER->player_rezept(QueryProp("rezept_nr")))
  {
    write_file(LOGS "items/rezept_gelesen.log",
        sprintf(  "%s %s lernt Rezept %d.\n",
        dtime(), CAP(getuid(TP)), QueryProp("rezept_nr")));
    write("Du lernst das Rezept auswendig und kannst es nun benutzen.\n");
    RemoveCmd( ({"entziffer", "entziffere"}));
    call_out("remove_me", 0);
  }
  else
  {
    write("Du erinnerst Dich, dass Du dieses Rezept schon kennst.\n");
  }
  return 1; 
}

void remove_me()
{
  if(environment())
    tell_object(environment(), "Das Rezept zerfaellt zu Staub.\n");
  remove();
}

void reset()
{
  if(!is_clone(this_object())) return;
  ::reset();
  if(!random(3))
    remove_me();
}
