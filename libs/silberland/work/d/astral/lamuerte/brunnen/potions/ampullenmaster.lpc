    23:"dunkelrot";"dunkelrote";1;16;"heilt Deine gesamte Lebensenergie", // 3-5
    24:"dunkelgelb";"dunkelgelbe";3;12;"frischt Deine Bewegungspunkte komplett auf", // 3-4
