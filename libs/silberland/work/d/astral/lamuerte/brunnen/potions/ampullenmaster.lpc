    17:"orange-violett";"orange-violette";5;6;"heilt Blindheit, Taubheit oder entfroscht Dich", // 2,3,4
    18:"gruen-violett";"gruen-violette";4;6;"lindert starke Vergiftungen", // 2,3,4
