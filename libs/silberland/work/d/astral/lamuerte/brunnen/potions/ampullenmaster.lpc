#define DBF(x) if(find_player("feyaria")) tell_object(find_player("feyaria"),x)
#define MAX_ALIGN 1500

nosave mapping farben = ([]);
nosave mapping mischen = ([]);
nosave mapping nummer = ([]);
mapping rezepte = ([]);

