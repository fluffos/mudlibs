    53:"hellrot";"hellrote";9;16;"erhoeht Deine Lebenkraft fuer kurze Zeit", // 4-7
    // level 6   
    54:"hellblau";"hellblaue";12;16;"erhoeht Deine magische Kraft fuer kurze Zeit", // 4-7
    55:"diamantweiss";"diamantweisse";9;14;"erhoeht alle Attribute", // 4-6
    56:"hellbraun";"hellbraune";16;17;"heillt alle unangenehmen Zustaenden", // 4-8
    57:"bunt";"bunte";13;18;"hat einen zufaelligen Effekt", // 4-7
    58:"ockern";"ockerne";15;17;"laesst Dich in der Dunkelheit sehen", // 4-7
    // level 7   
    59:"tuerkis";"tuerkise";14;15;"repariert und entflucht Deine Ausruestung", // 4-7
    60:"rotblau";"rotblaue";8;12;"heilt Dich voellig", // 4-6
    61:"dunkelgruen";"dunkelgruene";4;49;"heilt alle Flueche und Zustaende", // 5-9
    62:"hellgelb";"hellgelbe";2;24;"laesst Dich schneller laufen", // 4-5
    63:"lila";"lilane";6;36;"schuetzt vor Eisangriffen und Kaelte", // 4-6
    // level 8   
    64:"magenta";"magentane";3;35;"schuetzt vor Feuerangriffen und Hitze", // 4-5
    65:"indigoblau";"indigoblaue";12;15;"laesst Dich Magiepunkte regenerieren", // 4-6
    66:"karmesinrot";"karmesinrote";7;13;"laesst Dich Lebenspunkte regenerieren", // 4-6
    67:"beige";"beige";4;27;"laesst Dich Lebens und Magiepunkte regenerieren", // 5-8
    68:"neongruen";"neongruene";2;37;"schuetzt vor Verfroschung", // 4-7
    // level 9
    69:"neonviolett";"neonviolette";5;45;"schuetzt vor Vergiftung", // 5-8
    70:"neonorange";"neonorangene";1;40;"schuetzt vor Erblindung und Ertaubung", // 4-5
    71:"neonbraun";"neonbraune";6;38;"schuetzt vor Paralyse", // 4-7
    72:"neonrot";"neonrote";1;47;"laesst Dich mehr Schaden machen", // 4-5
    73:"neongelb";"neongelbe";2;39;"laesst Dich schneller kaempfen", // 4-5
    // level 10       
    74:"neonblau";"neonblaue";3;44;"laesst Dich schneller kaempfen und mehr Schaden machen", // 4-6
    75:"neonweiss";"neonweisse";39;42;"schuetzt vor Paralyse, Vergiftung, Verfroschung, Erblindung und Ertaubung", // 6-8
    76:"schwarz";"schwarze";10;18;"teleportiert Dich in Sicherheit", //  4-7
    77:"dunkelbraun";"dunkelbraune";31;56;"heilt alles", // 7-13
    78:"lustigbunt";"lustigbunte";45;54;"erhoeht Deine Stufenpunkte", // 8-13
    ]);
  for (i = sizeof(farben) - 1; i >= 0; i--)
  {
    x = farben[i, 2] + "-" + farben[i, 3];
    mischen[x] = i;
    nummer[farben[i,1]] = i;
  }
  seteuid(getuid(this_object()));
  restore_object(POTIONS "rezeptesave");
}

int mischen(int a,int b)
{
  if (!member(rezepte, getuid(this_player())))
    return 0;
  if (test_bit(rezepte[getuid(this_player())], mischen[a + "-" + b]))
    return mischen[a + "-" + b];
  else
    return 0;
}

string colorstring(int color)
{
  return farben[color,1];
}

string adjective(int color)
{
  return farben[color,0];
}

nosave string rezept_text(int level)
{
  TP->AddSp(-random(level));
  return
      "Das ist das Rezept fuer eine "+farben[level,1]+" Ampulle.\n"+
      ( level < 4 ? "Dazu brauchst Du nur eine leere Ampulle an einer "+
        farben[level,1]+"n Fontaene auffuellen.\n" : 
      "Dazu muss man eine "+farben[farben[level,2],1]+" und eine "+
      farben[farben[level,3],1]+ " Ampulle mischen.\n" )+  
      "Die "+farben[level,1]+" Ampulle "+farben[level,4]+".\n";
}

string rezept(object npc)
{
  int level;
  string text;
  int wl;

  wl = well_level(npc);
  while(level < 7 || level > sizeof(farben) - (51 - wl * 5))
    level = (random(npc->QueryProp(P_LEVEL)) + wl * 4) % sizeof(farben); 
  previous_object()->SetProp("rezept_nr", level);
  return rezept_text(level);
}

int effekt(int number, int might, object player)
{
  int i, breakflask;
  mixed x,y;
  int d, da;

  if (well_level(player) == 0) 
    might /= 10;
  switch (number)
  {
    case 1: //rot
            if (x = player->QueryProp(P_HP) < player->QueryProp(P_MAX_HP))
            {
              i = 20 + random(3 * well_level(player) + 4 * might);
              if (!player->drink_drink(i / 25, 0))
                i /= 2;
              tell_object(player,".....und Du fuehlst Dich gleich viel besser!\n"); 
              player->AddHp(i);
            }
            break;
    case 2: //gelb
            if (x = player->QueryProp(P_MV) < player->QueryProp(P_MAX_MV))
            {
              tell_object(player,".....und Deine Muedigkeit schwindet!\n"); 
              player->SetProp(P_MV, player->QueryProp(P_MV) +
                  100 * might + 100 * well_level(player));
            }
            break;
    case 3: //blau
            if (x = player->QueryProp(P_SP) < player->QueryProp(P_MAX_SP))
            {
              i = 20 + random(3 * well_level(player) + 4 * might);
              if (!player->drink_drink(i / 25, 0))
                i /= 2;
              tell_object(player,".....und Deine Magische Kraft steigt!\n"); 
              player->AddSp(i);
            }
            break;
    case 4: //gruen
            if (x = player->QueryProp(P_FROG))
            {
              tell_object(player,".....und Du bist kein Frosch mehr!\n"); 
              player->SetProp(P_FROG, 0);
            }
            break;
    case 5: //orange
             if (x = player->QueryProp(P_BLIND))
            {
              player->SetProp(P_BLIND, x +([BLIND_TIME: x[BLIND_TIME] / (1 + might / 2)]) );
              tell_object(player,".....der Schmerz in Deinen Augen wird leichter!\n");
            }
            else if (x = player->QueryProp(P_DEAF)) 
            {
               player->SetProp(P_DEAF, x + ([DEAF_TIME: x[DEAF_TIME] / (1 + might / 2)]) );
               tell_object(player,"......der Schmerz in Deinen Ohren wird leichter!\n");
            }
            break;
    case 6: //violett
            if (x = player->QueryProp(P_POISON))
            {
              player->AddPoison(-1 - random(might));
              if(player->QueryProp(P_POISON))
                tell_object(player,".....und Deine Vergiftung wird gelindert!\n"); 
              else
                tell_object(player,".....und Deine Vergiftung wird geheilt!\n"); 
            }
            break;
    case 7: //rot-orange
            while (x = present("\nbloodloss",player))
            { 
              x->remove_me();
              x = 1;
            }
            break;
    case 8: //rot-gruen
            if (x = player->QueryProp(P_FOOD))
            {
              player->SetProp(P_FOOD, x - might - random(might * 3));
              tell_object(player,".....und Du wirst hungriger.\n");
            }
            if (!random(5)) breakflask = 1;
            break;
    case 9: //rot-violett
            while (y = present("\nstrengthdrain",player))
            { 
              y->remove_me();
              x = 1;
            }
            break;
    case 10://blau-orange
            while (y = present("\nmanadrain",player))
            { 
              y->remove_me();
              x = 1;
            }
            break;
    case 11://blau-gruen
            if (x = player->QueryProp(P_ALCOHOL))
            {
              if (player->QueryProp(P_GUILD) == "zechpreller")
              {
                player->SetProp(P_ALCOHOL, x + might + random(might * 3));
                tell_object(player,".....und Du wirst betrunkener.\n");
              }
              else
              {
                player->SetProp(P_ALCOHOL, x - might - random(might * 3));
                tell_object(player,".....und Du wirst nuechtener.\n");
              }
            }
            if (!random(5)) breakflask = 1;
            break;
    case 12://blau-violett 
            while (y = present("\nbrainstorm",player))
            { 
              y->remove_me();
              y = 0;
              x = 1;
            }
            break;
    case 13://gelb-orange
            if (x = player->QueryProp(P_DRINK))
            {
              player->SetProp(P_DRINK, x - might - random(might * 3));
              tell_object(player,".....und Du wirst durstiger.\n");
            }
            if (!random(5)) breakflask = 1;
            break;
    case 14://gelb-gruen
            if ((x = player->QueryProp(P_WEAPON)) && x->QueryProp(P_DAMAGED) > 10)
              x->Damage(-1 - random(5 * might));
            else
              x = 0;
            if (y = player->QueryProp(P_ARMOURS))
            {
              for (i = sizeof(y) - 1; i >= 0; i--)
              {
                d = 1 + random(might / 3);
                if ((da = y[i]->QueryProp(P_DAMAGED)) > 1)
                {
                  y[i]->Damage(-(d > da ? da : d));
                  x = 1;
                }
              }
            }
            if(x)
              tell_object(player,"....und Deine Ausruestung wird repariert.\n");
            break;
    case 15://gelb-violett
            if (well_level(player) == 0) break;
            if (x = player->QueryProp(P_WEAPON)) y = ({x}); else y = ({});
            if (x = player->QueryProp(P_ARMOURS)) y += x;
            i = sizeof(y);
            x = 0;
            while(--i >= 0 && x == 0)
            {
              if (x = (y[i]->QueryProp(P_CURSED)) && !y[i]->id("NOUNCURSE"))
              {
                y[i]->SetProp(P_CURSED, 0);
                tell_object(player, ".....und " + y[i]->name(WER) + " " +
                    (y[i]->IsPlural() ? "werden" : "wird") + " entflucht.\n");
                breakflask = 1;
              }
            }
            break;
    case 16://orange-gruen
            i = 10+4*well_level(player)+random(5*might);
            if (x = ((player->QueryProp(P_HP) < player->QueryProp(P_MAX_HP)
              || player->QueryProp(P_SP) < player->QueryProp(P_MAX_SP))))
            {
              if (!player->drink_drink(i / 40, 0))
                i /= 2;
              tell_object(player,".....und Du fuehlst Dich geheilt!\n"); 
              player->heal_self(i);
            }
            if (!random(25)) breakflask = 1;
            break;
    case 17://orange-violett
            if (x=player->QueryProp(P_BLIND))
            {
              player->SetProp(P_BLIND, x +([BLIND_TIME: x[BLIND_TIME] / (might + 1)]) );
              tell_object(player,".....der Schmerz in Deinen Augen wird leichter!\n");
              player->heal_self(5 + 2 * well_level(player) + random( 5 * might));
            }
            else if (x=player->QueryProp(P_DEAF)) 
            {
              player->SetProp(P_DEAF, x + ([DEAF_TIME: x[DEAF_TIME] / (might + 1)]) );
              tell_object(player,"......der Schmerz in Deinen Ohren wird leichter!\n");
              player->heal_self(5 + 2 * well_level(player) + random(5 * might));
            }
            else if (x = player->QueryProp(P_FROG))
            {
              tell_object(player,".....und Du bist kein Frosch mehr!\n"); 
              player->SetProp(P_FROG, 0);
              player->AddSp(5 + 2 * well_level(player) + random(5 * might));
            }
            break;
    case 18://gruen-violett
            if (x = player->QueryProp(P_POISON))
            {
              player->AddPoison(-1-might);
              player->AddHp(5 + 2 * well_level(player) + random(x * might));
              if(player->QueryProp(P_POISON))
                tell_object(player,".....und Deine Vergiftung wird gelindert!\n"); 
              else
                tell_object(player,".....und Deine Vergiftung wird geheilt!\n"); 
            }
            break;
    case 19: //rubinrot
            if (!present("\nbrunnenampullen_attr_mod",player))
            {
              tell_object(player,".....und Du fuehlst Dich staerker!\n"); 
              x = clone_object(POTIONS "attr_mod");
              x->set_stat(([A_STR: 1 + might / 10 + well_level(player) / 4]), 
                  60 * (might + well_level(player)), "rubinroten");
              x->move(player,M_NOCHECK);
              player->UpdateAttributes();
            }
            if (!random(10)) breakflask = 1;
            break;
    case 20: //saphirblau
            if (!present("\nbrunnenampullen_attr_mod",player))
            {
              tell_object(player,".....und Du fuehlst Dich intelligenter!\n"); 
              x = clone_object(POTIONS "attr_mod");
              x->set_stat(([A_INT: 1 + might / 10 + well_level(player) / 4]), 
                  60 * (might + well_level(player)), "saphirblauen");
              x->move(player,M_NOCHECK);
              player->UpdateAttributes();
            }
            if (!random(10)) breakflask = 1;
            break;
    case 21: //smaragdgruen
            if (!present("\nbrunnenampullen_attr_mod",player))
            {
              tell_object(player,".....und Du fuehlst Dich ausdauernder!\n"); 
              x = clone_object(POTIONS "attr_mod");
              x->set_stat(([A_CON: 1 + might / 10 + well_level(player) / 4]), 
                  60 * (might+well_level(player)), "smaragdgruenen");
              x->move(player,M_NOCHECK);
              player->UpdateAttributes();
            }
            if (!random(10)) breakflask = 1;
            break;
    case 22: //amethystviolett
            if (!present("\nbrunnenampullen_attr_mod",player))
            {
              tell_object(player,".....und Du fuehlst Dich geschickter!\n"); 
              x = clone_object(POTIONS "attr_mod");
              x->set_stat(([A_DEX: 1 + might / 10 + well_level(player) / 4]), 
                  60 * (might + well_level(player)), "amethystvioletten");
              x->move(player,M_NOCHECK);
              player->UpdateAttributes();
            }
            if (!random(10)) breakflask = 1;
            break;
    case 23: //dunkelrot
            if (well_level(player) == 0) break;
            if (x = (player->QueryProp(P_HP) < player->QueryProp(P_MAX_HP)))
            {
              if (!player->drink_drink(2, 0)) i = 2; else i = 1;
              tell_object(player,".....und Du fuehlst Dich komplett geheilt!\n"); 
              player->AddHp(player->QueryProp(P_MAX_HP) / i);
            }
            if (!random(20)) breakflask = 1;
            break;
    case 24: //dunkelgelb
            if (well_level(player) == 0) break;
            if (x = player->QueryProp(P_MV) < player->QueryProp(P_MAX_MV))
            {
              tell_object(player,".....und Deine Muedigkeit schwindet voellig!\n"); 
              player->SetProp(P_MV, player->QueryProp(P_MAX_MV));
            }
            break;
    case 25: //dunkelblau
            if (well_level(player) == 0) break;
            if (x = (player->QueryProp(P_SP) < player->QueryProp(P_MAX_SP)))
            {
              if (!player->drink_drink(2, 0)) i = 2; else i = 1;
              tell_object(player,".....und Deine magische Kraft erneuert sich komplett!\n"); 
              player->AddSp(player->QueryProp(P_MAX_SP) / i);
            }
            if (!random(20)) breakflask = 1;
            break;
    case 26://gruenlichgelb
            if (well_level(player) == 0) break;
            if ((x = player->QueryProp(P_WEAPON)) && x->QueryProp(P_DAMAGED))
              x->Damage(-3 - random(15 * might));
            else
              x = 0;
            if (y = player->QueryProp(P_ARMOURS))
            {
              for (i = sizeof(y) - 1; i >= 0; i--)
              {
                d = 2 + random(might);
                if ((da = y[i]->QueryProp(P_DAMAGED)) > 0)
                {
                  y[i]->Damage(-(d > da ? da : d));
                  x = 1;
                }
              }
            }
            if (x)
              tell_object(player,"....und Deine Ausruestung wird repariert.\n");
            break;
    case 27://rosa
            if (well_level(player) == 0) break;
            if (x = player->QueryProp(P_WEAPON)) y = ({x}); else y = ({});
            if (x = player->QueryProp(P_ARMOURS)) y += x;
            i = sizeof(y);
            x = 0;
            while (--i >= 0 )
            {
              if (x = (y[i]->QueryProp(P_CURSED)) && !y[i]->id("NOUNCURSE"))
              {
                y[i]->SetProp(P_CURSED, 0);
                tell_object(player,".....und "+y[i]->name(WER)+" " + 
                    (y[i]->IsPlural() ? "werden" : "wird") + " entflucht.\n");
                breakflask = 1;
              }
            }
            break;
    case 28://weiss
            if (well_level(player) == 0) break;
            if (y = player->QueryProp(P_BLIND))
            {
              player->SetProp(P_BLIND, y + ([BLIND_TIME: y[BLIND_TIME] / (might + 1)]) );
              tell_object(player,".....der Schmerz in Deinen Augen wird leichter!\n");
              player->heal_self(5 + 3 * well_level(player) + random(5 * might));
              x = 1;
            }
            if (y = player->QueryProp(P_DEAF)) 
            {
              player->SetProp(P_DEAF, y + ([DEAF_TIME: y[DEAF_TIME] / (might + 1)]) );
              tell_object(player,"......der Schmerz in Deinen Ohren wird leichter!\n");
              player->heal_self(5 + 3 * well_level(player) + random(5 * might));
              x = 1;
            }
            if (y = player->QueryProp(P_FROG))
            {
              tell_object(player,".....und Du bist kein Frosch mehr!\n"); 
              player->SetProp(P_FROG, 0);
              player->AddSp(5 + 3 * well_level(player) + random(5 * might));
              x = 1;
            }
            if (y = player->QueryProp(P_POISON))
