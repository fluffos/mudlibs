              y->set_modifiers();
            breakflask=1;
            break;
    case 77://"dunkelbraun";"dunkelbraune";52;4"heilt alles",
            if( well_level(player)==0 ) break;
            player->SetProp(P_BLIND, 0);
            player->SetProp(P_DEAF, 0);
            player->SetProp(P_FROG, 0);
            player->SetProp(P_POISON, 0);
            player->SetProp(P_FOOD,0);
            player->SetProp(P_DRINK,0);
            call_out("remove_lang_curses", 0, player, might);
            call_out("remove_bloodloss", 0, player, might);
            call_out("remove_drains", 0, player, might);
            call_out("remove_brainstorms", 0, player, might);
            // nur bei dunkelgruen:
            // call_out("remove_item_curses", 0, player, might);
            player->heal_self(500);
            x=1;
            breakflask=1;
            break;
    case 78:// lustigbunt";"lustigbunte";45;50;"erhoeht Deine Stufenpunkte",
            if( well_level(player)==0 ) break;
            if (well_level(player) < 10)
            {
              tell_object(player,"Diese Ampulle hat hier keine Wirkung!\n");
              break;
            }
            EPMASTER->GiveExplorationPoint("lustigbunteampulle", EP_MISC);
            tell_object(player,"..... und Deine Stufenpunkte steigen!\n");
            x=1;
            breakflask=1;
            break;

  } 
  if(breakflask) return -1;
  if(x) return 1; else return 0;
}

void end_msg(object player, string farbe)
{
  if(objectp(player) && interactive(player))
    tell_object(player, "Der Effekt der "+farbe+" Ampulle laesst nach.\n");
}

void remove_lang_curses(object player, int might)
{
  object x;
  if (!player || !interactive(player)) return;

  while(x=present("\nsprachfluch",player)) {
    x->remove();
  }
}

void remove_bloodloss(object player, int might)
{
  object x;
  if (!player || !interactive(player)) return;

  while(x=present("\nbloodloss",player)) {
    x->remove_me();
    player->AddHp(5+4*well_level(player)+random(5*might));
  }
}

void remove_drains(object player, int might)
{
  object x;
  if (!player || !interactive(player)) return;

  while(x=present("\nstrengthdrain",player)) {
    x->remove_me();
  }
  while(x=present("\nmanadrain",player)) {
    x->remove_me();
    player->AddSp(5+4*well_level(player)+random(5*might));
  }
}

void remove_brainstorms(object player, int might)
{
  object x;
  if (!player || !interactive(player)) return;

  while(x=present("\nbrainstorm",player)) {
    x->remove_me();
    player->AddSp(5+4*well_level(player)+random(5*might));
  }
}

void remove_item_curses(object player, int might)
{
  int i;
  mixed x;
  if (!player || !interactive(player)) return;

  x = (x = player->QueryProp(P_WEAPON)) ? ({ x }) : ({ });
  x += player->QueryProp(P_ARMOURS) || ({ });
  for ( i=sizeof(x); i-->0; ) {
    if (x[i]->QueryProp(P_CURSED) && !x[i]->id("NOUNCURSE")) {
      x[i]->SetProp(P_CURSED,0);
      tell_object(player, ".....und "+x[i]->name(WER)+" " +
          (x[i]->IsPlural() ? "werden" : "wird") + " entflucht.\n");
    }
  }
}

int player_rezept(int nr)
{
  string uid;

  if (!this_player() || member(ALLOWED_UIDS, getuid(previous_object())) == -1) 
    return 0;

  uid = getuid(this_player());
  if (!member(rezepte, uid))                 // erstes Rezept dieses spielers?
    rezepte += ([uid: "_!            "; 0]);    // die ersten 7 Rezepte hat jeder

  if (test_bit(rezepte[uid], nr))            // spieler hat das rezept schon
    return 0;

  rezepte[uid] = set_bit(rezepte[uid], nr);  // bit fuer das rezept setzen
  rezepte[uid,1]++;                          // Anzahl der Rezepte steigt
  save_object(POTIONS "rezeptesave");        // und gleich speichern
  return 1;
}

string check_rezept(string farbe)
{
  int nr;

  if (!this_player() || member(ALLOWED_UIDS, getuid(previous_object())) == -1) 
    return "Illegaler Zugriff, Erzmagier benachrichtigen!\n";

  if (member(m_indices(nummer), farbe) == -1 || 
      !member(rezepte, getuid(this_player())) ||
      !test_bit(rezepte[getuid(this_player())], nr = nummer[farbe]))
    return "An eine " + farbe + " Ampulle kannst Du Dich nicht erinnern.\n";
  else
    return rezept_text(nr);
}

varargs int check_player(string player, int flag)
{
  int i;
  string ret;

  if (!member(rezepte, player))
    return 0;
  
  ret = capitalize(player) + " kennt folgende Rezepte"+
    (flag ? " nicht" : "") + ": ";
  for (i = 1; i < sizeof(farben); i++)
  {
    if (test_bit(rezepte[player], i) == !flag)
      ret += farben[i,0]+", ";
  }
  write(break_string(ret, 78));
  return 1;
}

varargs int anzahl_rezepte(string player)
{
  int i;
  int ret;

  ret = 0;
  if (!member(rezepte, player))
    return 0;
  
  for (i = 1; i < sizeof(farben); i++)
  {
    if (test_bit(rezepte[player], i))
      ret++;
  }
  return ret;
}

void write_rezept(string player)
{
  int i;
  string ret, r;

  if (IS_LEARNER(player))
    return;
  r = rezepte[player];
  ret = sprintf("%11s (%2d) :", player, rezepte[player,1]);
  for (i = 7; i < sizeof(farben); i++)
  {
    if (test_bit(r, i))
    {
      switch (i)
      {
        case 7..33:  ret += "1"; break;
        case 34..38: ret += "2"; break;
        case 39..43: ret += "3"; break;
        case 44..48: ret += "4"; break;
        case 49..53: ret += "5"; break;
        case 54..58: ret += "6"; break;
        case 59..63: ret += "7"; break;
        case 64..68: ret += "8"; break;
        case 69..73: ret += "9"; break;
        case 74..78: ret += "0"; break;
      }
    }
    else
      ret += " ";
  }
  write(ret + ".\n");
}

int nr_rezepte(string a, string b)
{
  if (rezepte[a,1] < rezepte[b,1])
    return 1;
  return 0;
}

void check_all_player()
{
  int i;
  string ret;
  string *pls;
  
  filter_array(sort_array(m_indices(rezepte), "nr_rezepte"), "write_rezept");
}

