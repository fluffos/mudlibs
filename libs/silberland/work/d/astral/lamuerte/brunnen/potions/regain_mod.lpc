inherit "std/thing";

#include "../def.h"
#include "../well_level.h"

string farbe, type;
int dauer, might;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  AddId (({"\nbrunnenampullen_regain_mod"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
}

set_stat(string t, int m, int d, string f)
{
  object ob;
  int r;
  if(!ob=previous_object()) 
    return remove();
  if((file_name(ob)!=AMPULLENMASTER) && 
      getuid(ob)!="feyaria" && getuid(ob)!="lamuerte")
    return remove();
  farbe=f;
  type=t;
  dauer=d;
  might=m * 5;
  call_out("regain", 2, might);
}

void remove_me()
{
  if(environment())
  {
    tell_object(environment(), "Der Effekt der "+farbe+" Ampulle laesst nach.\n");
  }
  call_out("remove",0);
}

void regain(int count)
{
  int bonus;
  if ( !environment() || !well_level(environment()) )
    return remove_me(),0;
  if( (count+=might)>100)
  {  
    bonus=count/100;
    count%=100;
    switch(type)
    {
      case "mv": 
        environment()->SetProp(P_MV, environment()->QueryProp(P_MV)+might);
      break;
      case "hp":
        environment()->AddHp(1 + random(1 + bonus * 2));
      break;
      case "sp":
        environment()->AddSp(1 + random(1 + bonus * 2));
      break;
      case "hpsp":
        environment()->heal_self(1 + random(1 + bonus));
      break;
    }
  }
  if( dauer--<=0 )
    call_out("remove_me");
  else
    call_out("regain", 2, count);
}


void reset()
{
  if (!is_clone(this_object()))
    return;
  ::reset();
  remove_me();
}
