inherit "std/thing";

#include "../def.h"

string farbe;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  AddId (({"\nbrunnenampullen_nightvision"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
}



set_stat(int dauer, string f)
{
  object ob;
  int r;
  if(!ob=previous_object()) 
    return remove();
  if((file_name(ob)!=AMPULLENMASTER) && 
      getuid(ob)!="feyaria" && getuid(ob)!="lamuerte")
    return remove();
  environment()->AddId("nightvision");
  call_out("remove_me",dauer);
  farbe=f;
}

void remove_me()
{
  if(environment())
  {
    tell_object(environment(), "Der Effekt der "+farbe+" Ampulle laesst nach.\n");
    environment()->RemoveId("nightvision");
  }
  call_out("remove",0);
}

void reset()
{
  if (!is_clone(this_object()))
    return;
  ::reset();
  remove_me();
}
