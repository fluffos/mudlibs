#include "./def.h"

void create()
{
  SUID;
}

void remove()
{
  destruct(this_object());
}


int parse()
{
  string *x;
  int i;
  string dummy1, dummy2, player;
  int nl, wl, nr;
  int level;
  mapping rezepte;

  rezepte = ([]);
  x = explode(read_file(LOGS + "items/rezept.log"), "\n");
  for (i = sizeof(x) - 1; i >= 0; i--)
  {
    nr = 0;
    if (sscanf(x[i], "%s - %s - %d - %d - %s - Rezept %d", 
          dummy1, dummy2, nl, wl, player, nr) != 6)
    {
      if (sscanf(x[i], "%s - %s - %d - %d - %s - Rezept", 
          dummy1, dummy2, nl, wl, player) != 5)
        continue;
        while (!nr || nr > 78)
          nr = random(2 * nl) + wl + 3;
    }
    if (strstr(player, ".") != -1 || IS_LEARNER(player))
      continue;
    if (!member(rezepte, player))
      rezepte += ([player: "_             "]);
    rezepte[player] = set_bit(rezepte[player], nr);
  }
  printf("%O\n", rezepte);
  return 1;
}
