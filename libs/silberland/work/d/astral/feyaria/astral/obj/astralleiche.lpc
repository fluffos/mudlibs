// std-leiche fuer astral
// 05-10-2004  Feyaria@SilberLand

inherit "std/corpse";

#include "../def.h"

void create()
{
  object killer;
  object ob;
  object geld;
  int flag;

  if (!is_clone(TO)) return;
  ::create();

  SUID;
  if (!PO || PO->QueryProp("got_loot"))
    return;

  PO->SetProp("got_loot", 1);
  if (PO->id("luxiana"))
  {
    BOSS_LOOT;
  }
  if (!random(WSALBE_CHANCE))
    CLONELOG( WSALBE, PO )
  else if (!random(RSALBE_CHANCE))
    CLONELOG( RSALBE, PO )
  MAGIC_WANDS
}
