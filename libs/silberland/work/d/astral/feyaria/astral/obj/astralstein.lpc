
#include "../def.h"

inherit "std/thing";

#define COST 100
#define P_SEERDOORS     "rw_sehertore"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Astralstein");
  SetProp(P_LONG,
    "Der Astralstein ist ein magisches Gebilde, dass Dich in die Astralebene "
    "bringen kann." );
  SetProp(P_INFO, 
      "Die Magie des Steines laesst sich durch reiben aktivieren.");
  SetProp(P_NAME, "Astralstein");
  SetProp(P_GENDER, MALE);
  AddId("astralstein");

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 33333);
  SetProp(P_NOBUY, 1);

  AddCmd( ({"reibe", "reib"}), "reiben");
}

int reiben(string str)
{
  mapping st;
  notify_fail("Was willst Du reiben?\n");
  if( !id(str) ) return 0;
  if( TP->QueryProp(P_SP) < COST )
    return write("Dazu hast du zu wenig magische Kraft!\n"), 1;
  if( ENV(TP)->QueryProp(P_NO_TPORT) == NO_TPORT || 
      ENV(TP)->QueryProp(P_NO_TPORT) == NO_TPORT_OUT )
     return write("Das geht hier nicht!\m"),1;
  if( time() - TP->QueryProp(P_LAST_COMBAT_TIME) < 300 )
    return write("Du bist noch zu sehr aufgewuehlt vom letzen Kampf!\n"),1;
  if( mappingp(st=TP->QueryProp(P_SEERDOORS)) && st[12] == 1)
    return write("Verwende besser ein Sehertor, das ist billiger!\n"),1;
  WLOG( LOG "astralstein", "verwendet einen Astralstein");
  TP->AddSp(-COST);
  TP->move(ROOM "nexus", M_TPORT);
  call_out("remove", 0);
  return 1;
}
