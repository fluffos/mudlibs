mapping fame = ([]);
mapping flags = ([]);
mapping times = (["mechanus":0, "djinnistan":0, "inferno":0, "aquatika":0, "frostania":0, 
                  "draconia":0, "elysia":0, "abgrund":0, "eternia":0]);
