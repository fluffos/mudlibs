    "elysia": 810549, // 9 Tage, 9 Stunden, 9 Minuten, 9 Sekunden
    "abgrund": 630427, // 7 Tage, 7 Stunden, 7 Minuten, 7 Sekunden
    "eternia": 2071403, // 23 Tage, 23 Stunden, 23 Minuten, 23 Sekunden
    ]);

nosave mapping buchstab = ([
  FLAG_LUXIANA: "Wisse, Sterblicher: der zweite Buchstabe vom Namen des Herrn der Zeit lautet: E";
                "Luxiana, die Koenigin der Lichtfeen und Herrscherin ueber die Astralebene", 
