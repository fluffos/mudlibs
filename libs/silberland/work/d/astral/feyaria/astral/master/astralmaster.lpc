    "mechanus": 990671, // 11 Tage, 11 Stunden, 11 Minuten und 11 Sekunden
    "djinnistan": 540366, // 6 Tage, 6 Stunden, 6 Minuten, 6 Sekunden
    "inferno": 540366, // 6 Tage, 6 Stunden, 6 Minuten, 6 Sekunden
