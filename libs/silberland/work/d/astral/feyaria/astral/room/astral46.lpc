
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Octo 3, Quadra 2, Hexa 15.");

  AddExit ("nordwesten" ,"./astral32");
  AddExit ("osten", "./astral58");
  AddExit ("sueden", "./astral41");
  AddExit ("oben", "./astral47");
  AddExit ("unten", "./astral45");
  add_random_exits();
}


