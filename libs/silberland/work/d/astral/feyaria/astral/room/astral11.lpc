
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Zweiter Circolar; Penta 4, Hexa 3, Hexa 10.");

  AddExit ("norden" ,"./astral04");
  AddExit ("suedwesten", "./astral22");
  AddExit ("suedosten", "./astral21");
  AddExit ("oben", "./astral12");
  AddExit ("unten", "./astral10");
  add_random_exits();
}


