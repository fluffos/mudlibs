
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Dritter Circolar; Hexa 3, Hexa 9, Hexa 10.");
  AddDetail( ({"trippelpunkt", "tetrapunkt"}),
    "Ja, dies hier ist der geheimnisvolle Tetrapunkt, auch Trippelpunkt "
    "genannt.");

  AddExit ("sueden" ,"./astral33");
  AddExit ("nordwesten", "./astral11");
  AddExit ("nordosten", "./astral10");
  AddExit ("oben", "./astral22");
  AddExit ("unten", "./astral20");
  add_random_exits();

  AddCmd( ({"sag", "sage", "ruf", "rufe"}), "cmd_sagen");
}

int cmd_sagen(string str)
{
  if (str != "zerbuxoruk" || 
      !ASTRALMASTER->QueryFlag(getuid(this_player()), FLAG_TIME) ) 
    return 0;
  write("Du rufst: ZERBUXORUK!\n"
        "Eine magische Macht transportiert Dich nach Eternia, der Ebene "
        "der Zeit.\n");
  TP->move(ENTER_TIME, M_TPORT|M_NOCHECK);
  return 1;
}
