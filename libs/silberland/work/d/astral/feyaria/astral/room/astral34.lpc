
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Octo 4, Hexa 10, Hexa 13.");

  AddExit ("norden" ,"./astral22");
  AddExit ("suedwesten", "./astral49");
  AddExit ("suedosten", "./astral48");
  AddExit ("oben", "./astral35");
  AddExit ("unten", "./astral33");
  add_random_exits();
}


