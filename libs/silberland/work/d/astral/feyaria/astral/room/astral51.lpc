
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 17, Hexa 11, Hexa 18.");

  AddExit ("westen" ,"./astral44");
  AddExit ("nordosten", "./astral36");
  AddExit ("suedosten", "./astral35");
  AddExit ("oben", "./astral52");
  AddExit ("unten", "./astral50");
  add_random_exits();
}


