
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Dritter Circolar; Octo 2, Hexa 7, Penta 2.");

  AddExit ("nordwesten" ,"./astral16");
  AddExit ("suedwesten", "./astral08");
  AddExit ("osten", "./astral29");
  AddExit ("oben", "./astral18");
  AddExit ("unten", "./astral16");
  add_random_exits();
}


