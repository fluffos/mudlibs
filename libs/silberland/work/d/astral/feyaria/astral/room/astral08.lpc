
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Zweiter Circolar; Penta 2, Hexa 7, Hexa 2.");
  
  AddExit ("westen" ,"./astral02");
  AddExit ("nordosten", "./astral17");
  AddExit ("suedosten", "./astral18");
  AddExit ("oben", "./astral09");
  AddExit ("unten", "./astral07");
  add_random_exits();
}


