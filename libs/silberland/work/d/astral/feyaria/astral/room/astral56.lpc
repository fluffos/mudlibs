
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddDetail( ({"portal", "blaues portal"}),
      "Das blaue Portal fuehrt nach Aquatika, der Ebene des Wassers. "
      "Du kannst es betreten.");

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Sechster Circolar; Octo 5, Quadra 3, Octo 2.");

  AddExit ("nordwesten" ,"./astral55");
  AddExit ("osten", "./astral53");
  AddExit ("sueden", "./astral42");
  AddExit ("oben", "./astral57");
  AddExit ("unten", "./astral55");
  add_random_exits();

  AddCmd( "betrete|betret|betritt&portal|blaues portal",
           "cmd_betreten",
           "Was willst Du betreten?");
}

int cmd_betreten(string str)
{
  write(BS("Du betrittst das blaue Portal und wirst nach Aquatika, der Ebene "
        "des Wassers, befoerdert."));
  say(TPN+" betritt das blaue Portal.\n");
  TP->move(ENTER_AQUATIKA, M_TPORT|M_NOCHECK);
  return 1;
}

varargs string GetExits(object viewer)
{ 
  string c1,c2;

  if (objectp(TP) && TP->QueryProp(P_TTY) == "ansi")
  {
    c1 = ANSI_BLUE + ANSI_BOLD;
    c2 = ANSI_NORMAL;
  }
  else
    c1 = c2 = "";
  return "Ein " + c1 + "blaues Portal" + c2 + ".\n" + ::GetExits(viewer);
}

