
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Dritter Circolar; Octo 1, Penta 1, Hexa 12.");

  AddExit ("westen" ,"./astral25");
  AddExit ("nordosten", "./astral14");
  AddExit ("suedosten", "./astral05");
  AddExit ("oben", "./astral14");
  AddExit ("unten", "./astral24");
  add_random_exits();
}


