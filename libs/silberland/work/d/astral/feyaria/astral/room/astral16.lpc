
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Dritter Circolar; Hexa 6, Octo 2, Penta 2.");

  AddExit ("norden" ,"./astral28");
  AddExit ("suedwesten", "./astral07");
  AddExit ("suedosten", "./astral17");
  AddExit ("oben", "./astral17");
  AddExit ("unten", "./astral15");
  add_random_exits();
}


