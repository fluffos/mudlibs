
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddDetail( ({"portal", "gruenes portal"}),
      "Das gruene Portal fuehrt nach Draconia, dem Reich der Drachen. "
      "Du kannst es betreten.");

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Sechster Circolar; Octo 4, Quadra 1, Octo 5.");

  AddExit ("sueden" ,"./astral54");
  AddExit ("osten", "./astral49");
  AddExit ("nordwesten", "./astral60");
  AddExit ("oben", "./astral60");
  AddExit ("unten", "./astral58");
  add_random_exits();

  AddCmd( "betrete|betret|betritt&portal|gruenes portal",
           "cmd_betreten",
           "Was willst Du betreten?");
}

int cmd_betreten(string str)
{
  write(BS("Du betrittst das gruene Portal und wirst nach Draconia, dem Reich "
        "der Drachen, befoerdert."));
  say(TPN+" betritt das gruene Portal.\n");
  TP->move(ENTER_DRACONIA, M_TPORT|M_NOCHECK);
  return 1;
}

varargs string GetExits(object viewer)
{ 
  string c1,c2;

  if (objectp(TP) && TP->QueryProp(P_TTY) == "ansi")
  {
    c1 = ANSI_GREEN + ANSI_BOLD;
    c2 = ANSI_NORMAL;
  }
  else
    c1 = c2 = "";
  return "Ein " + c1 + "gruenes Portal" + c2 + ".\n" + ::GetExits(viewer);
}

