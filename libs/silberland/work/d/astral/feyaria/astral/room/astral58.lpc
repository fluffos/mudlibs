
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddDetail( ({"portal", "gelbes portal"}),
      "Das gelbe Portal fuehrt nach Djinnistan, dem Koenigreich der Luft. "
      "Du kannst es betreten.");

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Sechster Circolar; Octo 3, Octo 5, Quadra 2.");

  AddExit ("nordosten" ,"./astral57");
  AddExit ("westen", "./astral46");
  AddExit ("sueden", "./astral55");
  AddExit ("oben", "./astral59");
  AddExit ("unten", "./astral57");
  add_random_exits();

  AddCmd( "betrete|betret|betritt&portal|gelbes portal",
           "cmd_betreten",
           "Was willst Du betreten?");
}

int cmd_betreten(string str)
{
  write(BS("Du betrittst das gelbes Portal und wirst nach Djinnistan, der Ebene "
        "der Luft, befoerdert."));
  say(TPN+" betritt das gelbe Portal.\n");
  TP->move(ENTER_DJINNISTAN, M_TPORT|M_NOCHECK);
  return 1;
}

varargs string GetExits(object viewer)
{ 
  string c1,c2;

  if (objectp(TP) && TP->QueryProp(P_TTY) == "ansi")
  {
    c1 = ANSI_YELLOW + ANSI_BOLD;
    c2 = ANSI_NORMAL;
  }
  else
    c1 = c2 = "";
  return "Ein " + c1 + "gelbes Portal" + c2 + ".\n" + ::GetExits(viewer);
}

