
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Hexa 9, Octo 3, Hexa 15.");

  AddExit ("norden" ,"./astral20");
  AddExit ("suedwesten", "./astral47");
  AddExit ("suedosten", "./astral46");
  AddExit ("oben", "./astral33");
  AddExit ("unten", "./astral31");
  add_random_exits();
}


