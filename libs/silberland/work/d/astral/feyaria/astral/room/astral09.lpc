
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Zweiter Circolar; Hexa 2, Hexa 8, Penta 3.");

  AddExit ("westen" ,"./astral03");
  AddExit ("nordosten", "./astral18");
  AddExit ("suedosten", "./astral19");
  AddExit ("oben", "./astral10");
  AddExit ("unten", "./astral08");
  add_random_exits();
}


