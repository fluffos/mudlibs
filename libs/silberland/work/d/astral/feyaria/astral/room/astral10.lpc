
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Zweiter Circolar; Hexa 3, Penta 3, Hexa 9.");

  AddExit ("norden" ,"./astral03");
  AddExit ("suedwesten", "./astral21");
  AddExit ("suedosten", "./astral20");
  AddExit ("oben", "./astral11");
  AddExit ("unten", "./astral09");
  add_random_exits();
}


