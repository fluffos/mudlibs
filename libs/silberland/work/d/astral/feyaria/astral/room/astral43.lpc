
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 16, Hexa 17, Hexa 7.");

  AddExit ("nordwesten" ,"./astral29");
  AddExit ("suedwesten", "./astral30");
  AddExit ("osten", "./astral52");
  AddExit ("oben", "./astral44");
  AddExit ("unten", "./astral42");
  add_random_exits();
}


