
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 13, Hexa 14, Hexa 5.");
  
  AddExit ("norden" ,"./astral48");
  AddExit ("suedwesten", "./astral26");
  AddExit ("suedosten", "./astral27");
  AddExit ("oben", "./astral40");
  AddExit ("unten", "./astral38");
  add_random_exits();
}


