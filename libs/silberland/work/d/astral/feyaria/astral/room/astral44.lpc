
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 17, Hexa 18, Hexa 8.");

  AddExit ("nordwesten" ,"./astral30");
  AddExit ("suedwesten", "./astral31");
  AddExit ("osten", "./astral51");
  AddExit ("oben", "./astral45");
  AddExit ("unten", "./astral43");
  add_random_exits();
}


