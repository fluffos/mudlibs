
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Dritter Circolar; Hexa 5, Hexa 6, Hexa 1.");

  AddExit ("norden" ,"./astral27");
  AddExit ("suedwesten", "./astral06");
  AddExit ("suedosten", "./astral07");
  AddExit ("oben", "./astral16");
  AddExit ("unten", "./astral14");
  add_random_exits();
}


