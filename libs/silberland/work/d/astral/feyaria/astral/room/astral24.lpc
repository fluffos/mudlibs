
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Dritter Circolar; Hexa 12, Hexa 4, Hexa 11.");
  
  AddExit ("westen" ,"./astral36");
  AddExit ("nordosten", "./astral05");
  AddExit ("suedosten", "./astral12");
  AddExit ("oben", "./astral13");
  AddExit ("unten", "./astral23");
  add_random_exits();
}


