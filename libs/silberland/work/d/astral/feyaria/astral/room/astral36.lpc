
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Hexa 12, Hexa 11, Hexa 17.");

  AddExit ("nordwesten" ,"./astral52");
  AddExit ("suedwesten", "./astral51");
  AddExit ("osten", "./astral24");
  AddExit ("oben", "./astral25");
  AddExit ("unten", "./astral35");
  add_random_exits();
}


