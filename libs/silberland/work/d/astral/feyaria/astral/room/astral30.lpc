
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Hexa 7, Hexa 17, Hexa 8.");

  AddExit ("westen" ,"./astral18");
  AddExit ("nordosten", "./astral43");
  AddExit ("suedosten", "./astral44");
  AddExit ("oben", "./astral31");
  AddExit ("unten", "./astral29");
  add_random_exits();
}


