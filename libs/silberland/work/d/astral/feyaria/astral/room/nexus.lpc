#include "../def.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Nexus");
  SetProp(P_INT_LONG,
    "Du stehst oder vielmehr schwebst im Nexus, dem zentralen Punkt der "
    "Astralebene. Du bist total verwirrt von den vielen Linien, Kreisen und "
    "anderen geometrischen Symbolen, die von vielen kleinen Lichtpunkten "
    "gebildet werden, die in allen Richtungen zu sehen sind. Der Raum "
    "scheint sich nach oben und unten zu verkleinern, bis nur mehr ein "
    "voellig schwarzes Puenktchen zu sehen ist. In vier Richtungen gibt "
    "es dunkle Durchgaenge, die in die unendlichen Tiefen der Astralebene "
    "fuehren." );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_OTHER]) );

  AddDetail( ({ "nexus" }),
    "Der Nexus ist das Zentrum der Astralebene.");
  AddDetail( ({ "zentrum" }),
    "Das Zentrum liegt in der Mitte.");
  AddDetail( ({ "mitte" }),
    "In der Mitte liegt das Zentrum.");
  AddDetail( ({ "punkt" }),
      "Strich.");
  AddDetail( ({ "strich" }),
    "Punkt.");
  AddDetail( ({ "astralebene" }),
      "Dies ist die Astralebene. Sie liegt jenseits der normalen Welt und ist "
      "nur mittels Magie zugaenglich.");
  AddDetail( ({ "welt" }),
      "Das SilberLand ist die normale Welt.");
  AddDetail( ({ "silberland" }),
      "Obwohl die Astralebene jenseits der normalen Welt liegt, und die "
      "normale Welt das SilberLand ist, ist die Astralebene doch auch ein "
      "Teil des SilberLandes. Schwer zu begreifen, oder?");
  AddDetail( ({ "teil" }),
      "Ein Teil des Ganzen.");
  AddDetail( ({ "ganze" }),
      "Das Ganze hat viele Teile, die Astralebene ist zB ein Teil des "
      "SilberLandes.");
  AddDetail( ({ "magie" }),
      "Nur mittels des Sehertores kann man die Astralebene betreten.");
  AddDetail( ({ "linien", "linie" }),
      "Viele der Lichtpunkte bilden Linien und Symbole.");
  AddDetail( ({ "kreise", "kreis" }),
      "Viele der Lichtpunkte bilden Kreise. Insgesamt gibt es sechs davon.");
  AddDetail( ({ "symbole", "symbol" }),
      "Es gibt hier viele geometrische Symbole.");
  AddDetail( ({ "geometrische symbole" }),
      "Dabei handelt es sich hauptsaechlich um regelmaessige Vierecke, Fuenfecke, "
      "Sechsecke und Achtecke.");
  AddDetail( ({ "vierecke", "viereck" }),
      "Du kannst vier Vierecke erkennen.");
  AddDetail( ({ "fuenfecke", "fuenfeck" }),
      "Du kansnt vier Fuenfecke erkennen.");
  AddDetail( ({ "sechsecke", "sechseck" }),
      "Du kannst achtzehn Sechsecke erkennen.");
  AddDetail( ({ "achtecke", "achteck" }),
      "Du kannst fuenf Achtecke erkennen.");
  AddDetail( ({ "lichtpunkte" }),
      "Die Lichtpunkte scheinen alle unendlich weit entfernt zu sein, fast "
      "wie Sterne.");
  AddDetail( ({ "lichtpunkt", "stern" }),
      "Es gibt hier so viele Lichtpunkte, dass Dir kein einziger besonders "
      "auffaellt.");
  AddDetail( ({ "sterne" }),
      "Es koennte sich wirklich um Sterne handlen, nur komisch, dass sie "
      "sowohl unter als auch ueber Dir sind, einfach ueberall in jeder "
      "Richtung. Einige Sterne scheinen Woerter zu bilden.");
  AddDetail( ({"woerter", "wort"}),
      "Du siehst 'awo' und 'arufe', was diese Woerter wohl zu bedeuten haben?");
  AddDetail( ({ "richtung", "richtungen" }),
      "In allen Richtungen schaut es gleich aus, nur nach oben und unten "
      "scheint sich der Raum zu verkleinern.");
  AddDetail( ({ "raum" }),
      "Der Raum scheint sich nach oben und unten zu verkleinern, bis nur "
      "mehr ein voellig schwarzes Puenktchen zu sehen ist.");
  AddDetail( ({ "puenktchen" }),
      "Ueber und unter Dir is ein solcher schwarzer Punkt. Obwohl es dort "
      "sehr eng zu werden scheint, kann man sich trotzdem in diese "
      "Richtung bewegen.");
  AddDetail( ({ "punkt" }),
      "Fuer einen Punkt ist es viel zu gross, es ist nur ein winziges Puenktchen.");
  AddDetail( ({ "durchgang", "durchgaenge" }),
      "Vier Durchgaenge fuehren in die Tiefen der Astralebene. Was Dich wohl "
      "dort erwartet?");
  AddDetail( ({ "tiefe", "tiefen" }),
      "Die Astralebene ist angeblich unendlich tief.");
  AddDetail( ({ "boden" }),
      "Von einem Boden kann man hier eigentlich nicht reden, da Du irgendwie "
      "schwebst. Unter Dir sind diese Lichtpunkte wie ueberall sonst auch, "
      "nur scheint sich der Raum unter Dir zu einem winzigen schwarzen "
      "Puenktchen zu verkleinern.");
  AddDetail( ({ "himmel" }),
      "Von einem Himmel kann man hier eigentlich nicht reden. "
      "Ueber Dir sind diese Lichtpunkte wie ueberall sonst auch, "
      "nur scheint sich der Raum ueber Dir zu einem winzigen schwarzen "
      "Puenktchen zu verkleinern.");

  AddSound( ({DEFAULT_SOUND, "rauschen"}),
    "Du hoerst ein leichtes Rauschen, das aus allen Richtungen zu kommen " 
    "scheint.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht astral!?");

  AddItem( "/obj/sehertor" , REFRESH_DESTRUCT);
  SetProp(P_TPORT_COST_IN, 10);
  SetProp(P_TPORT_COST_OUT, 5);

  AddExit( "nordwesten", "./astral01" );
  AddExit( "nordosten", "./astral02" );
  AddExit( "suedosten", "./astral03" );
  AddExit( "suedwesten", "./astral04" );
  AddExit( "oben", "./nexus" );
  AddExit( "unten", "./nexus" );
  AddExit( "friedhof", "auf den Friedhof#./friedhof" );
  SetProp(P_ZONE, "Nexus");
#include "../../where.h"
}

void init()
{
  ::init();
  if (TP && interactive(TP) && TP->QueryProp(P_RACE) == "Untoter" &&
      !present("\nbrunnencorpseobj", TP))
    CLONE(CORPSEOBJ, TP);
}
