
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Octo 1, Hexa 12, Hexa 16.");

  AddExit ("nordwesten" ,"./astral37");
  AddExit ("suedwesten", "./astral52");
  AddExit ("osten", "./astral13");
  AddExit ("oben", "./astral26");
  AddExit ("unten", "./astral36");
  add_random_exits();
}


