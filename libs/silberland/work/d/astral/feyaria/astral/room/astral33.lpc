
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Hexa 10, Hexa 9, Hexa 14.");

  AddExit ("norden" ,"./astral21");
  AddExit ("suedwesten", "./astral48");
  AddExit ("suedosten", "./astral47");
  AddExit ("oben", "./astral34");
  AddExit ("unten", "./astral32");
  add_random_exits();
}


