
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Octo 4, Hexa 13, Quadra 1.");
  
  AddExit ("nordosten" ,"./astral34");
  AddExit ("westen", "./astral59");
  AddExit ("sueden", "./astral38");
  AddExit ("oben", "./astral50");
  AddExit ("unten", "./astral48");
  add_random_exits();
}


