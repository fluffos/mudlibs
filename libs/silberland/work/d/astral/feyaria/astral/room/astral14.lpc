
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();
  
  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Dritter Circolar; Octo 1, Hexa 5, Penta 1.");

  AddExit ("norden" ,"./astral26");
  AddExit ("suedwesten", "./astral13");
  AddExit ("suedosten", "./astral06");
  AddExit ("oben", "./astral15");
  AddExit ("unten", "./astral13");
  add_random_exits();
}


