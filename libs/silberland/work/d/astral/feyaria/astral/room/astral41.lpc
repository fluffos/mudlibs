
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 15, Quadra 2, Octo 2.");

  AddExit ("suedwesten" ,"./astral28");
  AddExit ("osten", "./astral55");
  AddExit ("norden", "./astral46");
  AddExit ("oben", "./astral42");
  AddExit ("unten", "./astral40");
  add_random_exits();
}


