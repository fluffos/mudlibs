
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();
  
  AddDetail( ({"portal", "violettes portal"}),
      "Das violette Portal fuehrt zu den ewig vereisten Ebenen von Frostania. "
      "Du kannst es betreten.");

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Sechster Circolar; Quadra 4, Octo 4, Octo 5.");

  AddExit ("suedosten" ,"./astral59");
  AddExit ("westen", "./astral57");
  AddExit ("norden", "./astral50");
  AddExit ("oben", "./astral53");
  AddExit ("unten", "./astral59");
  add_random_exits();

  AddCmd( "betrete|betret|betritt&portal|violettes portal",
           "cmd_betreten",
           "Was willst Du betreten?");
}

int cmd_betreten(string str)
{
  write(BS("Du betrittst das violette Portal und wirst nach Frostania, der "
        "Ebene des Eises, befoerdert."));
  say(TPN+" betritt das violette Portal.\n");
  TP->move(ENTER_FROSTANIA, M_TPORT|M_NOCHECK);
  return 1;
}

varargs string GetExits(object viewer)
{
  string c1,c2;

  if (objectp(TP) && TP->QueryProp(P_TTY) == "ansi")
  {
    c1 = ANSI_PURPLE + ANSI_BOLD;
    c2 = ANSI_NORMAL;
  }
  else
    c1 = c2 = "";
  return "Ein " + c1 + "violettes Portal" + c2 + ".\n" + ::GetExits(viewer);
}

