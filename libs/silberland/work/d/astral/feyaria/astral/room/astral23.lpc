
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Dritter Circolar; Hexa 11, Penta 4, Octo 4.");

  AddExit ("westen" ,"./astral35");
  AddExit ("nordosten", "./astral12");
  AddExit ("suedosten", "./astral22");
  AddExit ("oben", "./astral24");
  AddExit ("unten", "./astral22");
  add_random_exits();
}


