
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 14, Hexa 15, Hexa 6.");

  AddExit ("norden" ,"./astral47");
  AddExit ("suedwesten", "./astral27");
  AddExit ("suedosten", "./astral28");
  AddExit ("oben", "./astral41");
  AddExit ("unten", "./astral39");
  add_random_exits();
}


