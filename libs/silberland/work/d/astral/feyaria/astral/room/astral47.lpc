
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 9, Hexa 15, Hexa 14.");

  AddExit ("sueden" ,"./astral40");
  AddExit ("nordwesten", "./astral33");
  AddExit ("nordosten", "./astral32");
  AddExit ("oben", "./astral48");
  AddExit ("unten", "./astral46");
  add_random_exits();
}


