
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddDetail( ({"portal", "graues portal"}),
      "Das graue Portal fuehrt nach Mechanus, der Ebene der Zahlen.");

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Sechster Circolar; Octo 5, Octo 1, Quadra 3.");

  AddExit ("nordosten" ,"./astral54");
  AddExit ("westen", "./astral56");
  AddExit ("sueden", "./astral37");
  AddExit ("oben", "./astral54");
  AddExit ("unten", "./astral60");
  add_random_exits();

  AddCmd( "betrete|betret|betritt&portal|graues portal",
           "cmd_betreten",
           "Was willst Du betreten?");
}

int cmd_betreten(string str)
{
  if (MECHANUSMASTER->MayEnter())
  {
    write(BS("Du betrittst das graue Portal und wirst nach Mechanus, der "
          "Ebene der Zahlen, befoerdert."));
    say(TPN+" betritt das graue Portal.\n");
    TP->move(ENTER_MECHANUS, M_TPORT|M_NOCHECK);
  }
  else
  {
    write(BS("Das Portal ist geschlossen, scheinbar sind schon zu viele "
        "Spieler in diese Ebene."));
  }
  return 1;
}

varargs string GetExits(object viewer)
{ 
  return "Ein graues Portal.\n" + ::GetExits(viewer);
}

