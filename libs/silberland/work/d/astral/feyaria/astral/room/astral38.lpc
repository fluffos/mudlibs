
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Fuenfter Circolar; Quadra 1, Hexa 13, Octo 1.");

  AddExit ("suedosten" ,"./astral26");
  AddExit ("westen", "./astral54");
  AddExit ("norden", "./astral49");
  AddExit ("oben", "./astral39");
  AddExit ("unten", "./astral37");
  add_random_exits();
}


