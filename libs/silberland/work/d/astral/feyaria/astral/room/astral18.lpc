
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Dritter Circolar; Hexa 7, Hexa 8, Hexa 2.");

  AddExit ("nordwesten" ,"./astral08");
  AddExit ("suedwesten", "./astral09");
  AddExit ("osten", "./astral30");
  AddExit ("oben", "./astral19");
  AddExit ("unten", "./astral17");
  add_random_exits();
}


