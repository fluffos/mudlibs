
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Erster Circolar; Penta 1, Hexa 1, Hexa 4.");

  AddExit ("suedosten" ,"./nexus");
  AddExit ("westen", "./astral05");
  AddExit ("norden", "./astral06");
  AddExit ("oben", "./astral02");
  AddExit ("unten", "./astral04");
  add_random_exits();
}


