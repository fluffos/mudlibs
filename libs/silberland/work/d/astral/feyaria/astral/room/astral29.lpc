
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Octo 2, Hexa 16, Hexa 7.");

  AddExit ("westen" ,"./astral17");
  AddExit ("nordosten", "./astral42");
  AddExit ("suedosten", "./astral43");
  AddExit ("oben", "./astral30");
  AddExit ("unten", "./astral28");
  add_random_exits();
}


