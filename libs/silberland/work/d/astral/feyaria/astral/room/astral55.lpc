
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddDetail( ({"portal", "graues portal"}),
      "Das weisse Portal fuehrt zum heiligen Garten von Elysia. "
      "Du kannst es betreten.");

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Sechster Circolar; Quadra 2, Octo 5, Octo 2.");

  AddExit ("suedosten" ,"./astral56");
  AddExit ("westen", "./astral41");
  AddExit ("norden", "./astral58");
  AddExit ("oben", "./astral56");
  AddExit ("unten", "./astral54");
  add_random_exits();

  AddCmd( "betrete|betret|betritt&portal|weisses portal",
           "cmd_betreten",
           "Was willst Du betreten?");
}

int cmd_betreten(string str)
{
  write(BS("Du betrittst das weisse Portal und wirst in den heiligen Garten "
        "von Elysia befoerdert."));
  say(TPN+" betritt das weisse Portal.\n");
  TP->move(ENTER_ELYSIA, M_TPORT|M_NOCHECK);
  return 1;
}

varargs string GetExits(object viewer)
{ 
  string c1,c2;

  if (objectp(TP) && TP->QueryProp(P_TTY) == "ansi")
  {
    c1 = ANSI_BOLD;
    c2 = ANSI_NORMAL;
  }
  else
    c1 = c2 = "";
  return "Ein " + c1 + "weisses Portal" + c2 + ".\n" + ::GetExits(viewer);
}

