
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 16, Hexa 12, Hexa 17.");

  AddExit ("westen" ,"./astral43");
  AddExit ("nordosten", "./astral25");
  AddExit ("suedosten", "./astral36");
  AddExit ("oben", "./astral37");
  AddExit ("unten", "./astral51");
  add_random_exits();
}


