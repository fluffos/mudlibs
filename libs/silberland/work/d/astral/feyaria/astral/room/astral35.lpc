
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Hexa 11, Octo 4, Hexa 18.");

  AddExit ("nordwesten" ,"./astral51");
  AddExit ("suedwesten", "./astral50");
  AddExit ("osten", "./astral23");
  AddExit ("oben", "./astral36");
  AddExit ("unten", "./astral34");
  add_random_exits();
}


