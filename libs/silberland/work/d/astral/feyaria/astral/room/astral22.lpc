
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Dritter Circolar; Penta 4, Hexa 10, Octo 4.");

  AddExit ("sueden" ,"./astral34");
  AddExit ("nordwesten", "./astral23");
  AddExit ("nordosten", "./astral11");
  AddExit ("oben", "./astral23");
  AddExit ("unten", "./astral21");
  add_random_exits();
}


