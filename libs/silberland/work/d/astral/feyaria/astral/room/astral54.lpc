
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddDetail( ({"portal", "rotes portal"}),
      "Das rote Portal fuehrt ins flammende Inferno, der Ebene des Feuers. "
      "Du kannst es betreten.");

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Sechster Circolar; Octo 5, Quadra 1, Octo 1.");

  AddExit ("suedwesten" ,"./astral53");
  AddExit ("osten", "./astral38");
  AddExit ("norden", "./astral59");
  AddExit ("oben", "./astral55");
  AddExit ("unten", "./astral53");
  add_random_exits();

  AddCmd( "betrete|betret|betritt&portal|rotes portal",
           "cmd_betreten",
           "Was willst Du betreten?");
}

int cmd_betreten(string str)
{
  write(BS("Du betrittst das rote Portal und wirst ins flammende Inferno, der "
        "Ebene des Feuers, befoerdert."));
  say(TPN+" betritt das rote Portal.\n");
  TP->move(ENTER_INFERNO, M_TPORT|M_NOCHECK);
  return 1;
}

varargs string GetExits(object viewer)
{ 
  string c1,c2;

  if (objectp(TP) && TP->QueryProp(P_TTY) == "ansi")
  {
    c1 = ANSI_RED + ANSI_BOLD;
    c2 = ANSI_NORMAL;
  }
  else
    c1 = c2 = "";
  return "Ein " + c1 + "rotes Portal" + c2 + ".\n" + ::GetExits(viewer);

}

