
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Hexa 15, Octo 2, Hexa 6.");

  AddExit ("sueden" ,"./astral16");
  AddExit ("nordwesten", "./astral40");
  AddExit ("nordosten", "./astral41");
  AddExit ("oben", "./astral29");
  AddExit ("unten", "./astral27");
  add_random_exits();
}


