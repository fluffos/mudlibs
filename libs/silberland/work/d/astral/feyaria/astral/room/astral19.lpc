
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Dritter Circolar; Hexa 8, Octo 3, Penta 3.");

  AddExit ("nordwesten" ,"./astral09");
  AddExit ("suedwesten", "./astral20");
  AddExit ("osten", "./astral31");
  AddExit ("oben", "./astral20");
  AddExit ("unten", "./astral18");
  add_random_exits();
}


