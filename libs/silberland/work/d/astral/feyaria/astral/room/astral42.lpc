
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Octo 2, Quadra 3, Hexa 16.");

  AddExit ("suedwesten" ,"./astral29");
  AddExit ("osten", "./astral37");
  AddExit ("norden", "./astral56");
  AddExit ("oben", "./astral43");
  AddExit ("unten", "./astral41");
  add_random_exits();
}


