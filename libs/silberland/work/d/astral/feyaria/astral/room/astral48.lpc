
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 10, Hexa 14, Hexa 13.");

  AddExit ("sueden" ,"./astral39");
  AddExit ("nordwesten", "./astral34");
  AddExit ("nordosten", "./astral33");
  AddExit ("oben", "./astral49");
  AddExit ("unten", "./astral47");
  add_random_exits();
}


