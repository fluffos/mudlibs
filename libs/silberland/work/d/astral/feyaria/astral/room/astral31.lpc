
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Hexa 8, Hexa 18, Octo 3.");

  AddExit ("westen" ,"./astral19");
  AddExit ("nordosten", "./astral44");
  AddExit ("suedosten", "./astral45");
  AddExit ("oben", "./astral32");
  AddExit ("unten", "./astral30");
  add_random_exits();
}


