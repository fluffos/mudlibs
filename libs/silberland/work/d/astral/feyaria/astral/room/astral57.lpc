
#include "../def.h"

inherit ROOM "astral_inh";

object *warned = ({});

void create() 
{
  ::create();

  AddDetail( ({"portal", "schwarzes portal"}),
      "Das schwarze Portal fuehrt in den finsteren Abgrund von Zyr-Xarra. "
      "Du kannst es betreten.");

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Sechster Circolar; Octo 3, Quadra 4, Octo 5.");

  AddExit ("suedwesten" ,"./astral58");
  AddExit ("osten", "./astral60");
  AddExit ("norden", "./astral45");
  AddExit ("oben", "./astral58");
  AddExit ("unten", "./astral56");
  add_random_exits();

  AddCmd( "betrete|betret|betritt&portal|schwarze portal",
           "cmd_betreten",
           "Was willst Du betreten?");
}

int cmd_betreten(string str)
{
  if (member(warned, TP) == -1)
  {
    write("Eine innere Stimme warnt Dich, dieses Portal zu betreten.\n");
    warned += ({TP});
    return 1;
  }
  write(BS("Du betrittst das schwarze Portal und wirst in den finsteren "
        "Abgrund von Zyr-Xarra befoerdert."));
  say(TPN+" betritt das schwarze Portal.\n");
  TP->move(ENTER_ABGRUND, M_TPORT|M_NOCHECK);
  return 1;
}

varargs string GetExits(object viewer)
{ 
  string c1,c2;

  if (objectp(TP) && TP->QueryProp(P_TTY) == "ansi")
  {
    c1 = ANSI_BLACK + ANSI_BOLD;
    c2 = ANSI_NORMAL;
  }
  else
    c1 = c2 = "";
  return "Ein " + c1 + "schwarzes Portal" + c2 + ".\n" + ::GetExits(viewer);
}

