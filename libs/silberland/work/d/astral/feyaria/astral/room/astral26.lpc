
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Vierter Circolar; Hexa 13, Hexa 5, Octo 1.");

  AddExit ("sueden" ,"./astral14");
  AddExit ("nordwesten", "./astral38");
  AddExit ("nordosten", "./astral39");
  AddExit ("oben", "./astral27");
  AddExit ("unten", "./astral25");
  add_random_exits();
}


