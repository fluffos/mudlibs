
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Zweiter Circolar; Hexa 6, Penta 2, Hexa 1.");
  
  AddExit ("nordwesten" ,"./astral15");
  AddExit ("nordosten", "./astral16");
  AddExit ("sueden", "./astral02");
  AddExit ("oben", "./astral08");
  AddExit ("unten", "./astral06");
  add_random_exits();
}


