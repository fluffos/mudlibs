
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 18, Octo 4, Quadra 4.");

  AddExit ("nordosten" ,"./astral35");
  AddExit ("westen", "./astral45");
  AddExit ("sueden", "./astral60");
  AddExit ("oben", "./astral51");
  AddExit ("unten", "./astral49");
  add_random_exits();
}


