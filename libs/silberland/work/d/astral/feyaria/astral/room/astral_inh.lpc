
#include "../def.h"

inherit STDROOM;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In der Astralebene");
  SetProp(P_INT_LONG,
    "Du stehst oder vielmehr schwebst in einem schwarzgrauen Nichts. Nur mit "
    "Muehe kannst Du oben von unten unterscheiden. Die einzige "
    "Orientierungshilfe sind die vielen kleinen Lichtpunkte, die ueberall "
    "zu sehen sind. "     
    "Genauso hast Du Dir die Astralebene immer vorgestellt, aber trotzdem "
    "ist sie so fremdartig, dass Du sie wohl nie richtig begreifen wirst.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_OTHER]) );
  SetProp(P_ZONE, "Astral");

  AddDetail( ({"boden"}),
    "Der Boden, falls man hier ueberhaupt von so etwas sprechen kann, besteht "
    "aus dem selben schwarzgrauen Nichts wie der Himmel.");  
  AddDetail( ({"himmel"}),
    "Der Himmel, falls man hier ueberhaupt von so etwas sprechen kann, besteht "
    "aus dem selben schwarzgrauen Nichts wie der Boden.");  
  AddDetail( ({"nichts"}),
    "Du siehst nichts, aber die Farbe ist schwarzgrau.");
  AddDetail( ({"farbe"}),
    "Alles hier ist schwarzgrau, das scheint die einzige Farbe in der "
    "Astralebene zu sein. Die Farbe der vielen Lichtpunkte ist kaum "
    "feststellbar, weil sie zu hell sind.");
  AddDetail( ({"astralebene"}),
    "Die Astralebene ist sehr verwirrend, nur mit Muehe kannst Du Dich orientieren.");
  AddDetail( ({"muehe"}),
    "Die Orientierung bereitet Dir grosse Muehe.");
  AddDetail( ({"orientierung"}),
    "Du kannst Dich nur mit Hilfe der kleinen Lichtpunkte orientieren.");
  AddDetail( ({"hilfe"}),
    "Die vielen kleinen Lichtpunkte sind Deine einzige Orientierungshilfe.");
  AddDetail( ({"orientierungshilfe"}),
    "Ob die kleinen Lichtpunkte Dir bei der Orientierung helfen koennen?");
  AddDetail( ({"lichtpunkt"}),
    "Unter all den Lichtpunkten faellt Dir keiner besonders auf.");  
  AddDetail( ({"lichtpunkte"}),
    "Die Lichtpunkte schauen aus wie Sterne.");
  AddDetail( ({"sterne", "stern"}),
    "Ob es sich wirklich um Sterne handelt ist schwer zu sagen, jedenfalls "
    "bilden sie verschiedene Muster.");
  AddDetail( ({"muster"}),
    "Bei den Mustern handelt es sich groesstenteils um Sechsecke."),  
  AddDetail( ({"sechsecke", "sechseck"}),
    "Neben den Sechsecken gibt es auch einige Fuenfecke."),  
  AddDetail( ({"fuenfecke", "fuenfeck"}),
    "An jedes Fuenfeck grenzt immer ein Achteck."),  
  AddDetail( ({"achteck", "achtecke"}),
    "Jetzt wo Du die Achtecke genauer betrachtest, fallen Dir auch "
    "kleine Vierecke auf.");
  AddDetail( ({"vierecke", "viereck"}),
    "Jetzt wo Du Dich auf die Vierecke konzentrierst, siehst Du "
    "erst, dass alles von gewaltigen Kreisen durchdrungen ist.");
  AddDetail( ({"kreis", "kreise"}),
    "Die Kreise bilden mit den anderen Mustern eine unbeschreiblich schoene "
    "Symmetrie.");
  AddDetail( ({"symmetrie"}),
    "Ploetzlich durchschaust Du die ganze Anordnung der Sterne!");
  AddDetail( ({"anordnung"}),
    "Die Lichtpunkte, oder Sterne, sind so angeordnet, dass man die "
    "Hyperastralkoordinaten ablesen kann.");
  AddDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
    "Mit etwas Muehe kannst Du sie aus der Anordnung der Kreise, Sechsecke, "
    "Fuenfecke, Achtecke und Vierecke ablesen.");
  AddDetail( ({"richtung", "richtungen"}),
    "Du kannst Dich hier nach Nordwesten, Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen, Oben und Unten bewegen.");
  AddDetail( ({"nordwesten", "norden", "nordosten", "osten", "suedosten", 
        "sueden", "suedwesten", "westen", "oben", "unten"}),
      "Dorthin kannst Du Dich bewegen.");
  
  AddSound( ({DEFAULT_SOUND, "rauschen"}),
    "Du hoerst den Rausch der Ewigkeit.");
  AddSound( ({"rausch", "ewigkeit"}),
    "Hier rauscht es ewig.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht astral!?");

  if (random(2))
    AddItem( ({NPC "dummy", NPC "dummy", NPC "dummy", 
        NPC "astralhirsch", NPC "astralpanther", 
        NPC "lichtfee", NPC "magiesauger", NPC "sternenfalke",
        NPC "sternentiger", NPC "wirbel" }), REFRESH_DESTRUCT,
        ([P_HEAL: 200,
          P_MNPC_WAIT: ({ 30, 60, 60 }) ]) );
  else if (!random(20))
    AddItem( ({
        NPC "astralhirsch", NPC "astralpanther", 
        NPC "lichtfee", NPC "magiesauger", NPC "sternenfalke",
        NPC "sternentiger", NPC "wirbel",
        NPC "dummy", NPC "dummy", NPC "dummy", 
        NPC "dummy", NPC "dummy", NPC "dummy", 
        NPC "dummy", NPC "dummy", NPC "dummy",
        NPC "dummy", NPC "dummy", NPC "dummy",
        NPC "dummy", NPC "dummy", NPC "dummy",
        NPC "dummy", NPC "dummy", NPC "dummy",
        NPC "corruptor", NPC "corruptor", NPC "lichtfee_koenigin"
        }), REFRESH_DESTRUCT , ([P_HEAL: 400,
          P_MNPC_WAIT: ({ 30, 90, 90 }) ]) );
}

void add_random_exits()
{
  string *rooms, *alldirs, *dirs;
  string room, dir;

  alldirs = ({"norden", "nordosten", "osten", "suedosten", "sueden", 
              "suedwesten", "westen", "nordwesten", "oben", "unten"});
  dirs = alldirs - m_indices(QueryProp(P_EXITS));
  rooms = m_values(QueryProp(P_EXITS));
  while (sizeof(dirs))
  {
    dir = dirs[random(sizeof(dirs))];
    dirs -= ({dir});
    if (sizeof(rooms))
      room = rooms[random(sizeof(rooms))];
    else
      room = file_name(TO);
    rooms -= ({room});
    AddExit(dir, room);
  }
}

varargs string GetExits( object viewer )
{
  if (QueryProp(P_INT_SHORT) == "Im Nexus")
    return ::GetExits(viewer);
  return "Du kannst Dich in alle 10 Richtungen frei bewegen.\n";
}

