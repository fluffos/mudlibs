
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Zweiter Circolar; Hexa 4, Penta 4, Hexa 11.");

  AddExit ("nordwesten" ,"./astral24");
  AddExit ("suedwesten", "./astral23");
  AddExit ("osten", "./astral04");
  AddExit ("oben", "./astral05");
  AddExit ("unten", "./astral11");
  add_random_exits();
}


