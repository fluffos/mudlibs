
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Vierter Circolar; Hexa 14, Hexa 6, Hexa 5.");

  AddExit ("sueden" ,"./astral15");
  AddExit ("nordwesten", "./astral39");
  AddExit ("nordosten", "./astral40");
  AddExit ("oben", "./astral28");
  AddExit ("unten", "./astral26");
  add_random_exits();
}


