
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Zweiter Circolar; Hexa 5, Hexa 1, Penta 1.");

  AddExit ("sueden" ,"./astral01");
  AddExit ("nordwesten", "./astral14");
  AddExit ("nordosten", "./astral15");
  AddExit ("oben", "./astral07");
  AddExit ("unten", "./astral05");
  add_random_exits();
}


