
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Quadra 3, Octo 1, Hexa 16.");

  AddExit ("suedosten" ,"./astral25");
  AddExit ("westen", "./astral42");
  AddExit ("norden", "./astral53");
  AddExit ("oben", "./astral38");
  AddExit ("unten", "./astral52");
  add_random_exits();
}


