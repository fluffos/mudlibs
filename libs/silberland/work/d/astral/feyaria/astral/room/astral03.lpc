
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Erster Circolar; Hexa 2, Penta 3, Hexa 3.");
  
  AddExit ("nordwesten" ,"./nexus");
  AddExit ("osten", "./astral09");
  AddExit ("sueden", "./astral10");
  AddExit ("oben", "./astral04");
  AddExit ("unten", "./astral02");
  add_random_exits();
}


