
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Erster Circolar; Hexa 4, Hexa 3, Penta 4.");

  AddExit ("nordosten" ,"./nexus");
  AddExit ("westen", "./astral12");
  AddExit ("sueden", "./astral11");
  AddExit ("oben", "./astral01");
  AddExit ("unten", "./astral03");
  add_random_exits();
}


