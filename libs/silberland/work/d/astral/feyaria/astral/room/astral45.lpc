
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Fuenfter Circolar; Hexa 18, Quadra 4, Octo 3.");

  AddExit ("nordwesten" ,"./astral31");
  AddExit ("osten", "./astral50");
  AddExit ("sueden", "./astral57");
  AddExit ("oben", "./astral46");
  AddExit ("unten", "./astral44");
  add_random_exits();
}


