
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Dritter Circolar; Penta 3, Octo 3, Hexa 9.");

  AddExit ("sueden" ,"./astral32");
  AddExit ("nordwesten", "./astral10");
  AddExit ("nordosten", "./astral19");
  AddExit ("oben", "./astral21");
  AddExit ("unten", "./astral19");
  add_random_exits();
}


