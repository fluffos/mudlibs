
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();
  
  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
            "Erster Circolar; Hexa 1, Penta 2, Hexa 2.");
  
  AddExit ("suedwesten" ,"./nexus");
  AddExit ("osten", "./astral08");
  AddExit ("norden", "./astral07");
  AddExit ("oben", "./astral03");
  AddExit ("unten", "./astral01");
  add_random_exits();
}


