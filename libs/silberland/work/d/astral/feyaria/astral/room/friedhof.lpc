
#include "../def.h"

inherit "std/room";

string read_grabstein();
string read_liste();
string read_topliste();
string read_todesliste();
string read_xpliste();

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf dem Friedhof");
  SetProp(P_INT_LONG,
    "Du stehst auf einem Friedhof. Alles ist sehr duester, bis auf eine "
    "grosse Steintafel in der Mitte kannst Du kannst nur einige Grabsteine "
    "erkennen.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_OTHER]) );

  AddDetail( ({"himmel"}),
      "Ueber Dir ist ein duesterer grauer Himmel.");
  AddDetail( ({"boden"}),
      "Der Boden voll mit Grabsteinen, ab und zu siehst Du auch eine noch "
      "nicht bestattet Leiche.");
  AddDetail( ({"leiche"}),
      "Keine Leiche zu sehen, da hast Du Dich wohl getaeuscht.");
  AddDetail( ({"friedhof"}),
      "Das ist ein Friedhof, wie man an den Grabsteinen erkennen kann.");
  AddDetail( ({"grabsteine"}),
      "Du siehst viele Grabsteine hier. Einer faellt Dir besonders auf.");
  AddDetail( ({"grabstein"}), 
      "Auf dem Grabstein steht etwas geschrieben. Du kannst es lesen.");
  AddReadDetail( ({"grabstein"}), #'read_grabstein);
  AddDetail( ({"steintafel", "tafel"}),
      "Auf der Tafel stehen mehrere Listen mit Namen.");
  AddDetail( ({"listen", "liste"}),
      "Du siehst die Top-Astralliste, die Heldenliste, die Todesliste und die Sterbeliste. "
      "Du kannst sie lesen.");
  AddDetail( ({"heldenliste", "sterbeliste", "todesliste", "topastralliste",
        "top-astralliste"}),
      "Du kannst sie lesen.");
  AddReadDetail( ({"listen", "liste"}), 
      "Welche Liste willst Du lesen?\n");
  AddReadDetail( ({"topastralliste", "top-astralliste", "astralliste"}), #'read_topliste);
  AddReadDetail( ({"heldenliste"}), #'read_liste);
  AddReadDetail( ({"todesliste"}), #'read_todesliste);
  AddReadDetail( ({"sterbeliste"}), #'read_xpliste);

  AddSound( ({DEFAULT_SOUND, "stille", "totenstille"}),
    "Stille, man koennte fast Totenstille sagen.");
  AddSmell( ({DEFAULT_SMELL, "tot", "verwesung"}),
    "Es riecht nach Tod und Verwesung.");

  AddExit( "raus", "./nexus" );
  SetProp(P_ZONE, "Friedhof");
#include "../../where.h"
}

string read_grabstein()
{
  string x, str;
  int d;

  if (!(d = TP->QueryProp(P_DEADS)))
    return BS("Der Grabstein ist leer. Scheinbar ist die Person, fuer die "
        "das Grab gedacht ist, noch nicht gestorben.");

  x = "   |%|60s|\n";

  str = "   /------------------------------------------------------------\\\n";
  str += sprintf(x, sprintf("Das Grab von %s", CAP(getuid(TP))));
  str += sprintf(x, "");
  if (d == 1)
    str += sprintf(x, sprintf("Wir bedauern den Tod von %s,", CAP(getuid(TP))));
  else
    str += sprintf(x, sprintf("Wir bedauern die %d Tode von %s,", 
        TP->QueryProp(P_DEADS), CAP(getuid(TP))));
  str += sprintf(x, sprintf("%s %s %d Erfahrungspunkte gekostet ha%s.",
        d == 1 ? "der" : "die",
        TP->QueryPronoun(WEM), 
        TP->QueryProp(P_TOTAL_LOST_XP),
        d == 1 ? "t" : "ben" ));
  str += sprintf(x, "");
  str += sprintf(x, sprintf("Moege %s in Frieden ruhen.", 
        TP->QueryPronoun(WER)));
  str += sprintf(x,"");
  str += "   \\------------------------------------------------------------/\n";
  return str;
}

string read_topliste()
{
  write(
    "Die Liste der beruehmtesten Helden der Astralebene\n"
    "--------------------------------------------------\n");
  ASTRALMASTER->FameList("astral");
  return "";
}

string read_liste()
{
  write(
    "Die Liste der beruehmtesten Helden aller 10 Ebenen der Macht\n"
    "------------------------------------------------------------\n");
  ASTRALMASTER->FameList("total");
  return "";
}

string read_todesliste()
{
  write("Die Liste der am oeftesten gestorbenen Helden\n"
        "---------------------------------------------\n");
  ASTRALMASTER->DeathList(0);
  return "";
}

string read_xpliste()
{
  write("Die Liste der groessten Erfahrunspunkteverluste\n"
        "-----------------------------------------------\n");
  ASTRALMASTER->DeathList(1);
  return "";
}

int _query_nomagic()
{
  if (TP && interactive(TP) && query_verb() == "auferstehung")
    return 0;
  else
    return 100;
}

