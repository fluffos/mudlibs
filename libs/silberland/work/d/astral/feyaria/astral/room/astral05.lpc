
#include "../def.h"

inherit ROOM "astral_inh";

void create() 
{
  ::create();

  AddReadDetail( ({"hyperastralkoordinaten", "hyperastralkoordinate"}),
      "Zweiter Circolar; Penta 1, Hexa 4, Hexa 12.");

  AddExit ("osten" ,"./astral01");
  AddExit ("nordwesten", "./astral13");
  AddExit ("suedwesten", "./astral24");
  AddExit ("oben", "./astral06");
  AddExit ("unten", "./astral12");
  add_random_exits();
}


