// Lavaaxt, Schaden abhaengig von Temperatur
// Feyaria@SilberLand

#include "../def.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  SetProp(P_SHORT, "Der Lichtbogen");
  SetProp(P_LONG,
    "Du haeltst einen Bogen aus festgewordenem Licht in der Hand. Er ist kaum zu erkennen, da er fast "
    "durchscheinend wirkt. Sobald du an der Sehne aus einem einizgen, hellweissen Lichtstrahl ziehst "
    "entsteht ein hell gleissender Pfeil aus Licht.");
  SetProp(P_NAME, "Lichtbogen");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"bogen", "lichtbogen"}) );  
  SetProp(P_INFO, 
    "Dieser Bogen buendelt das Licht der Umgebung in seine Pfeile.");

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 240);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, ({DT_LIGHT}) );
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MAGIC, 5);
  SetProp(P_VALUE, 9000);
  SetProp(P_WEIGHT, 300);
  SetProp(P_SIZE, 170);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:50, SR_SEER: 1, A_DEX:32]) );
  SetProp(P_MATERIAL, ([MAT_LIGHT:60, MAT_MAGIC:40]) ); 
  SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );
  SetProp(P_HIT_FUNC, this_object());    
}

int HitFunc(object enemy)
{
  if(!random(33) && !enemy->QueryProp(P_BLIND)) {
    tell_room(ENV(enemy), BS("Ein Lichtpfeil trifft "+enemy->name(WEN)+" in die Augen und blendet!"));
    enemy->SetProp(P_BLIND, 2+random(5));
  }

  return ENV(enemy)->QueryProp(P_TOTAL_LIGHT)*random(10);
}


