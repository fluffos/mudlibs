// Lichtpanzer
// 26-10-2003 Feyaria@SilberLand

inherit "std/armour";

#include "../def.h"
#include "/p/daemon/itemd/itemd.h"

void create()
{
  if( !is_clone(TO) )     return;
  ::create();

  SetProp(P_SHORT, "Der Lichtpanzer");
  SetProp(P_LONG, 
    "Der Lichtpanzer besteht quasi auf gefrorenem Licht, schwer zu verstehen, "
    "wenn man keine Lichtfee ist. Er strahlt ein mattes, angenehmes Licht aus "
    "und scheint sehr gut zu schuetzen." );
  SetProp(P_NAME, "Lichtpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "lichtpanzer"}) );
  SetProp(P_INFO,
      "Dieser Panzer ist nicht nur wunderschoen und verstaerkt Deine "
      "magische Kraft, sondern schuetzt auch noch vor Licht und Magie.");

  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 5000);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_MATERIAL, ([MAT_LIGHT:100]) );
  SetProp(P_AC, 34 + random(7) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:1]) );
  SetProp(P_M_HEALTH_MOD, ([P_SP:7 + random(7)]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:3, P_SP:3]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 50, A_INT: 20, SR_BAD: 500]) );
  SetProp(P_DAM_PROTECTION, 
      QueryProp(P_DAM_PROTECTION) + ([DT_LIGHT:1, DT_MAGIC:1]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
  SetProp(P_NEVERDROP, 1);
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_LIGHT:-0.1, DT_MAGIC:-0.1]) );
  SetProp(P_LIGHT, 1);
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  SetProp(P_LIGHT, 0);
  return 1;
}

void reset()
{
  if( !is_clone(TO) ) return;
  ::reset();
  call_out("heal", 10 + random(200));
}

void heal()
{
  object wer;
  if (!objectp(wer = QueryProp(P_WORN)))
    return SetProp(P_LIGHT, 0), 0;  // Sicherheitsmassnahme :)

  if (interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, "Die Magie des Lichtpanzers heilt Dich.\n");
    wer->heal_self(188);
  }
}

void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
  SetProp(P_NODROP, 1);  
}

mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}
