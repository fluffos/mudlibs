// Sternenguertel
// 26-10-2003 Feyaria@SilberLand

inherit "std/armour";

#include "../def.h"

void create()
{
  if( !is_clone(TO) )     return;
  ::create();

  SetProp(P_SHORT, "Ein Sternenguertel");
  SetProp(P_LONG, 
    "Dieser Guertel besteht aus kleinen goldenen Sternen, die auf ein "
    "Stoffband aufgenaeht sind." );
  SetProp(P_NAME, "Sternenguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"guertel", "sternenguertel"}) );
  SetProp(P_INFO,
      "Dieser Guertel ist nicht nur wunderschoen und verstaerkt Deine "
      "magische Kraft, sondern schuetzt auch noch vor Licht und Magie.");

  AddDetail( ({"stern", "sterne"}),
      "Die goldenen Sternen sind wunderschoen. Eine magische Kraft scheint "
      "in ihnen zu liegen.");
  AddDetail( ({"kraft"}),
      "Die magische Kraft der Sterne verstaerkt Deine Magie.");

  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 2500);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_MATERIAL, ([MAT_CLOTH: 60, MAT_GOLD: 40]) );
  SetProp(P_AC, 4);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_SP: 3]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_DAM_PROTECTION, 
      QueryProp(P_DAM_PROTECTION) + ([DT_LIGHT: 1, DT_MAGIC: 1]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_LIGHT:-0.03, DT_MAGIC:-0.03]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if( !is_clone(TO) ) return;
  ::reset();
  call_out("heal", 10 + random(200));
}

void heal()
{
  object wer;
  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, "Die Magie des Sternenguertels heilt Dich.\n");
    wer->heal_self(33 + random(33));
  }
}
