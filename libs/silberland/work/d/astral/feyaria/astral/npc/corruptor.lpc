// eine Lichtfee
// 25-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, ({"Korruptor des Lebens",
                    "Korruptors des Lebens",
                    "Korruptor des Lebens",
                    "Korruptor des Lebens"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_LONG, 
    "Der Korruptor des Lebens ist einer der maechtigsten Daemonen. Er hat "
    "die Faehigkeit, jegliches Lebewesen auf die Seites DES BOESEN zu "
    "verfuehren. Der Korruptor ist beinahe unsichtbar, aber du erkennst, "
    "dass er riesengross ist, mindestens 6 Arme hat und einen mit vielen "
    "Hoernern gekroenten Kopf besitzt." );
  AddId(({"korruptor"}));

  create_default_npc(45);
  SetProp(P_HANDS, ({" mit der Macht der Daemonen", 555, 
        ({DT_BLUDGEON, DT_UNHOLY}) }));
  SetProp(P_XP, QueryProp(P_XP) * 3 / 2);
  SetProp(P_RACE, "Daemon");
  SetProp(P_BODY, QueryProp(P_BODY) * 2);
  SetProp(P_SIZE, 666);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_NOMAGIC, 50);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_LIGHT:0.2,  DT_MAGIC:-1,  DT_HOLY: 0.3, DT_AIR: -0.5,
        DT_TERROR:-0.9,   DT_POISON: -0.3,  DT_EXPLOSION: -0.2, 
        DT_COLD: 0.1, DT_UNHOLY: -0.5, DT_FIRE: -0.5])); 
  SetProp(P_AGGRESSIVE, 0.02);

  SetProp(P_MSGIN, "schwebt lautlos herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt lautlos herein");
  SetProp(P_MMSGOUT, "schwebt weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 20, 25, 25 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_BACKWARDS + 
                        MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " wird aus der Welt verbannt.\n");
  SetProp(P_KILL_MSG, "Ich korumpiere alles!");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" korumpiert @WEN.\n" }) );
  AddInfo(DEFAULT_INFO, "versucht Dich zu vernichten.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 80 );
  AddSpell(5, 1100, 
      "Der Korrputor des Lebens korumpiert Deinen Koerper.\n",
      "Der Korrputor des Lebens korumpiert @WESSEN Koerper.\n",
      DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 1000, 
      "Der Korrputor des Lebens korumpiert Deinen Geist.\n",
      "Der Korrputor des Lebens korumpiert @WESSEN Geist.\n",
      DT_MIND,([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 1000, 
      "Der Korrputor des Lebens straft Dich mit der Macht der Daemonen.\n",
      "Der Korrputor des Lebens straft @WEN mit der Macht der Daemonen.\n",
      DT_UNHOLY,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 600, DS_PARALYZE,
      "Der Korrputor des Lebens uebernimmt die Kontrolle ueber Deinen Koerper.\n",
      "Der Korrputor des Lebens uebernimmt die Kontrolle ueber @WESSEN Koerper.\n");
  AddDefaultSpell(1, 800, DS_CURSE_WEAPON,
      "Der Korrputor des Lebens korumpiert Deine Waffe.\n",
      "Der Korrputor des Lebens korumpiert @WESSEN Waffe.\n");
  AddDefaultSpell(1, 800, DS_CURSE_ARMOUR,
      "Der Korrputor des Lebens korumpiert Deine Ruestung.\n",
      "Der Korrputor des Lebens korumpiert @WESSEN Ruestung.\n");

  SetChats(3, ({
    "Dein Herz krampft sich zusammen.\n",    
    "Ein kalter Schauer laeuft Dir ueber den Ruecken.\n",    
    "Deine Haare stehe zu Berge.\n",    
    "Etwas scheint die Harmonie hier zu stoeren.\n",    
    "Du fuehlst Dich ploetzlich sehr unwohl.\n"}) );

  SUID;
  CLONEME(ARMOUR "halsband");
}

string short()
{
  if (InFight())
    return "Der Korrputor des Lebens.\n";
  else
    return 0;
}

int _query_invis()
{
  if (InFight())
    return 0;
  else
    return 1;
}
