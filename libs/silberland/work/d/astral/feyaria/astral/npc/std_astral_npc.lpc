// std-npc fuer die astral
// 24-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit STDNPC;

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_LOG_INFO, "feyaria/astral");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD + MOV_BACKWARDS);
  SetProp(P_CORPSE, OBJ "astralleiche");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;

  if( QueryProp(P_HP) == QueryProp(P_MAX_HP) && !random(10) )
  {
    move("/room/npcasylraum", M_TPORT);
    deep_remove();
  }
}

void die(int poisondeath)
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "astral", QueryProp(P_LEVEL));
  ::die(poisondeath);
}
