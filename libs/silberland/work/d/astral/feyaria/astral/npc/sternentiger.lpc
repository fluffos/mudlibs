// ein Sternentiger 
// 7-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";
inherit "std/npc/spells";

void create()
{
  int level;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Sternentiger");
  SetProp(P_GENDER, MALE);
  switch( random(4) )
  {
    case 0:  level = 28;
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"klein", "kleiner", "kleinen"}) ); 
      break;
    case 1: level = 30; break;
    case 2: level = 33;
      SetProp(P_NAME_ADJ, "gross");
      AddAdjective( ({"gross", "grosser", "grossen"}) ); 
      break;
    case 3: level = 37;
      SetProp(P_NAME_ADJ, "riesig");
      AddAdjective( ({"riesig", "riesiger", "riesigen"}) ); 
      break;
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, BS(
    "Der Sternentiger hat ein blauschwarzes Fell, das mit vielen leuchtenden "
    "Sternen bedeckt ist. Dadurch ist er in der Astralebene kaum zu erkennen. "
    "Mit seinen grossen Tatzen pirscht er leise zwischen den Sternen herum, genau "
    "wie sein Verwandter im Dschungel. Es scheint sich hier nicht um ein Tier im "
    "herkoemmlichen Sinn zu handeln, sondern vielmehr um die Essenz aller "
    "Katzenwesen.") );
  AddId(({"sternentiger", "tiger", "FELL_WUSCHEL"}));

  AddDetail( ({"fell"}),
    "Der Sternentiger hat ein blaushwarzes Fell. Es ist mit leuchtenden "
    "Sternen bedeckt. So ist er hier in der Astralebene perfekt getarnt.");  
  AddDetail( ({"tatze", "tatzen"}),
    "Der Sternentiger hat gewaltige Tatzen, trotzdem schleicht er fast "
    "lautlos durch die Astralebene.");
  AddDetail( ({"essenz", "katzenwesen"}),
    "Du kannst die Essenz der Katzenwesen in diesem wunderschoenen "
    "Wesen spueren.");

  create_default_npc(level);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", level * 13, ({DT_RIP, DT_MAGIC}) }));
  SetProp(P_XP, QueryProp(P_XP) * 4 / 3);
  SetProp(P_RACE, "Raubkatze");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_PIERCE:-0.2,    DT_LIGHT:-1,  DT_MAGIC:-0.5, 
        DT_TERROR:-0.7,    DT_COLD: 0.4, DT_POISON: 0.2])); 

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "springt bruellend herein");
  SetProp(P_MMSGOUT, "springt bruellend weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " stuerzt toedlich verletzt zu Boden.\n");
  SetProp(P_KILL_MSG, "Es war ein Fehler, mich zu unterschaetzen!");
  SetProp(P_MURDER_MSG, "Die Macht der Sterne wird Dich das naechste Mal "
      "besiegen, %s!");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "faucht Dich nur an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "schnurrt: ");

  SetProp(P_SPELLRATE, 30 + level);
  AddSpell(10, 200 + level * 15,
    Name(WER,1)+" greift Dich mit seinen gefaehrlichen Reisszaehnen an.\n",
    Name(WER,1)+" greift @WEN mit seinen gefaehrlichen Reisszaehnen an.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 300 + level * 20,
    Name(WER,1)+" wirft Dich mit einem gewaltigen Tatzenhieb zu Boden.\n",
    Name(WER,1)+" wirft @WEN mit einem gewaltigen Tatzenhieb zu Boden.\n",
     ({DT_RIP, DT_SQUEEZE}),"disable", ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(2, 100 + level * 25, DS_DEAF,
    Name(WER,1)+" bruellt Dich an.\n",
    Name(WER,1)+" bruellt @WEN an.\n", level);

  SetChats(2, ({
    Name(WER,1)+" faucht Dich an.\n",
    Name(WER,1)+" schaut Dich mit seinen leuchtenden Katzenaugen an.\n",
    Name(WER,1)+" zeigt seine gewaltige Reisszaehne.\n",
    Name(WER,1)+" bruellt laut.\n",
    Name(WER,1)+" schnurrt leise.\n",
    Name(WER,1)+" fletscht seine Zaehne.\n"}) );


  SUID;
}

void disable(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(4));
}

void die(int poisondeath)
{
  object ob, pl;

  if(!random(GUERTEL_CHANCE))
  {
    pl = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
    if (interactive(pl))
    { 
      write_file(LOG "items", sprintf("%s: %s findet einen Sternenguertel von %s.\n",
            dtime(), capitalize(getuid(pl)), name(WEM,1)));
      CLONEME(ARMOUR "sternenguertel");
    }
  }
  else
    GELD(random(QueryProp(P_LEVEL) * MONEY_FACTOR), TO);
  ::die(poisondeath);
}

