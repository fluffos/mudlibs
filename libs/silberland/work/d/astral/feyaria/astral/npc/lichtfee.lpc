// eine Lichtfee
// 25-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";
inherit "std/npc/spells";

void create()
{
  object ob;
  int level;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lichtfee");
  SetProp(P_GENDER, FEMALE);
  switch (random(10))
  {
    case 0:  level = 19;
      SetProp(P_NAME_ADJ, "winzig");
      AddAdjective( ({"winzig", "winzige", "winziger" }) ); 
      break;
    case 1:  level = 21;
      SetProp(P_NAME_ADJ, "jung");
      AddAdjective( ({"jung", "junge", "junger" }) ); 
      break;
    case 2:  level = 23;
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"klein", "kleine", "kleiner" }) ); 
      break;
    case 3:  level = 25;
      SetProp(P_NAME_ADJ, "schoen");
      AddAdjective( ({"schoen", "schoene", "schoener" }) ); 
      break;
    case 4: level = 27; break;
    case 5:  level = 29;
      SetProp(P_NAME_ADJ, "leuchtend");
      AddAdjective( ({"leuchtend", "leuchtende", "leuchtender" }) ); 
      break;
    case 6:  level = 31;
      SetProp(P_NAME_ADJ, "strahlend");
      AddAdjective( ({"strahlend", "strahlende", "strahlender" }) ); 
      break;
    case 7:  level = 33;
      SetProp(P_NAME_ADJ, "wunderschoen");
      AddAdjective( ({"wunderschoen", "wunderschoene", "wunderschoener" }) ); 
      break;
    case 8: level = 35;
      SetProp(P_NAME_ADJ, "maechtig");
      AddAdjective( ({"maechtig", "maechtige", "maechtiger"}) ); 
      break;
    case 9: level = 40;
      SetProp(P_NAME_ADJ, "uralt");
      AddAdjective( ({"uralt", "uralte", "uralter"}) ); 
      break;
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    Name(WER,1)+ " fuehlt sich hier in der Astralebene sichtlich wohl, "
    "umgeben von Licht und Magie. Mit ihren kleinen Fluegelchen schwirrt sie "
    "vergnuegt zwischen den Sternen umher." );
  AddId(({"lichtfee", "fee"}));

  AddDetail( ({"fluegel", "fluegelchen"}),
      "Die Fluegel der Lichtfee sind nicht sehr gross, aber gross genug, "
      "dass sie hier herumschwirren kann.");

  create_default_npc(level);
  SetProp(P_HANDS, ({" mit Feenmagie", level * 11, ({DT_MAGIC}) }));
  SetProp(P_XP, QueryProp(P_XP) * 4 / 3);
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, level + random(25));
  SetProp(P_ALIGN, 800 + random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, level);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_LIGHT:-1,  DT_MAGIC:-1,  DT_HOLY: -0.5, DT_AIR: -0.5,
        DT_TERROR:0.4,   DT_POISON: 0.3,  DT_EXPLOSION: 0.2, DT_COLD: 0.2])); 

  SetProp(P_MSGIN, "schwirrt herein");
  SetProp(P_MSGOUT, "schwirrt");
  SetProp(P_MMSGIN, "schwirrt herein");
  SetProp(P_MMSGOUT, "schwirrt weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 20, 25, 25 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " haucht ihre zartes Leben aus.\n");
  SetProp(P_KILL_MSG, "Die Maechte des Lichts haben wieder einmal gesiegt!");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" verwandelt @WEN in einen Stern.\n" }) );
  AddInfo(DEFAULT_INFO, "sagt: @@random_info@@.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 40 + level);
  AddSpell(7, level * 10,
    Name(WER,1)+" schiesst einen hellen Lichtstrahl auf Dich ab.\n",
    Name(WER,1)+" schiesst einen hellen Lichtstrahl auf @WEN ab.\n",
     DT_LIGHT,([SP_SHOW_DAMAGE:1]));
  AddSpell(5, level * 14,
    Name(WER,1)+" wirft einen magischen Pfeil auf Dich.\n",
    Name(WER,1)+" wirft einen magischen Pfeil auf @WEN.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, level * 16, DS_ANTIMAGIC,
    Name(WER,1)+" verzerrt das astrale Gefuege rund um Dich.\n",
    Name(WER,1)+" verzerrt das astrale Gefuege rund um @WEN.\n",
    1 + level / 7);
  AddDefaultSpell(1, level * 20, DS_BLIND,
    Name(WER,1)+" blendet Dich mit hellem Licht.\n",
    Name(WER,1)+" blendet @WEN mit hellem Licht.\n",
    level / 7);

  SetChats(5, ({
    Name(WER,1)+" schwirrt vergnuegt herum.\n",
    Name(WER,1)+" leuchtet hell.\n",
    Name(WER,1)+" leuchtet sehr hell.\n",
    Name(WER,1)+" zwitschert etwas in einer unverstaendlichen Sprache.\n",
    Name(WER,1)+" sagt: @@random_info@@.\n",
    Name(WER,1)+" flattert mit ihren kleinen Fluegelchen.\n"}) );

  SUID;

  if (!random(5))
  {
    ob = clone_object(MAGIESTEIN);
    ob->AddAmount(random(level)/10);
    ob->move(ME, M_NOCHECK);
  }
  CLONEME(FEENKLEID);
  if (random(2))
    CLONEME(FEENSCHLEIER);
  if (random(4))
    CLONEME(FEENHANDSCHUHE);
  if (random(3))
    CLONEME(SEIDENSCHUHE);
  command("trage alles");
}

string random_info()
{
  string x;
  int i,j;
  string *abc;

  abc = ({"ala", "alo", "isi", "eth", "myth", "gor", "zik", "kol",
          "ful", "yib", "flapp", "loo", "mii", "re", "ju", "ro",
          "gamm", "tyr", "oth", "giz", "baa", "darra", "fero",
          "ovo", "atta", "cor", "nef", "do", "aar", "romi", "pyr"});
  x="";
  for (i = random(5) + random(3) + 1; i >= 0; i--)
  {
    for (j = !random(4) + random(2) + 1; j >= 0; j--)
    {
      x += abc[random(sizeof(abc))];
    }
    x += " ";
    if (strlen(x) > 35) break;
  }
  return CAP(x[0..<2]);
}
