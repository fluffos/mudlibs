// ein magischer Wirbel
// 25-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";

void create()
{
  int level;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Wirbel");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "magisch");
  AddAdjective( ({"magisch", "magischer", "magischen"}) ); 
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Der magische Wirbel ist ein ganz seltsames Wesen, wie man es nur in "
    "der Astralebene findet. Es scheint aus purer Magie zu bestehen, die "
    "wild im Kreis herum wirbelt.");
  AddId(({"wirbel"}));

  AddDetail( ({"wesen", "magie"}),
      "Ein Wirbel aus purer Magie.");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit purer Magie", QueryProp(P_HANDS)[1], ({DT_MAGIC}) }));
  SetProp(P_XP, QueryProp(P_XP) * 4 / 3);
  SetProp(P_RACE, "Astralwesen");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_NOMAGIC, 100);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -1.0, DT_COLD:     -1.0, DT_WATER: -1.0, DT_AIR:   -1.0, 
      DT_LIGHTNING:-1.0, DT_EXPLOSION:-1.0, DT_SOUND: -1.0, DT_LIGHT: -1.0,
      DT_ELECTRIC: -1.0, DT_ACID:     -1.0, DT_POISON:-1.0, DT_TERROR:-1.0,
      DT_HOLY:     -1.0, DT_UNHOLY:   -1.0, DT_MAGIC: -1.0, DT_MIND:  -1.0]) );

  SetProp(P_MSGIN, "wirbelt herein");
  SetProp(P_MSGOUT, "wirbelt");
  SetProp(P_MMSGIN, "wirbelt herein");
  SetProp(P_MMSGOUT, "wirbelt weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 20, 20, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " loest sich in pure Magie auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" loest @WEN in magische Bestandteile auf.\n" }) );
  AddInfo(DEFAULT_INFO, "wirbelt weiter herum und beachtet Dich nicht.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");


  SetChats(2, ({
    Name(WER,1)+" wirbelt herum.\n",
    Name(WER,1)+" verstaerkt das Gefuege der Astralebene.\n",
    Name(WER,1)+" verstaerkte Deine Magie.\n",
    Name(WER,1)+" schwaecht Deine Magie.\n"}) );

  SUID;
  if (!random(9))
    CLONEME(MAGIESTEIN);
  else
    GELD(random(QueryProp(P_LEVEL) * MONEY_FACTOR), TO);
}

void heart_beat()
{
  ::heart_beat();

  filter_objects(filter_array(all_inventory(MENV), #'interactive), "AddSp", 1);
  if (present("muenzen", environment()))
    command_me("nimm muenzen");
}

