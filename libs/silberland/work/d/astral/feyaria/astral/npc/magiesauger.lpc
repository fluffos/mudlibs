// ein Magiesauger
// 25-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";
inherit "std/npc/spells";

void create()
{
  int level;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Magiesauger");
  SetProp(P_GENDER, MALE);
  switch (random(6))
  {
    case 0: level = 15;
      SetProp(P_NAME_ADJ, "unheimlich");
      AddAdjective( ({"unheimlich", "unheimlicher", "unheimlichen"}) ); 
      break;
    case 1: level = 17;
      SetProp(P_NAME_ADJ, "gemein");
      AddAdjective( ({"gemein", "gemeiner", "gemeinen"}) ); 
      break;
    case 2: level = 13;
      SetProp(P_NAME_ADJ, "hungrig");
      AddAdjective( ({"hungrig", "hungriger", "hungrigen"}) ); 
      break;
    case 3: level = 10;
      SetProp(P_NAME_ADJ, "winzig");
      AddAdjective( ({"winzig", "winziger", "winzigen"}) ); 
      break;
    case 4: level = 20;
      SetProp(P_NAME_ADJ, "gewaltig");
      AddAdjective( ({"gewaltig", "gewaltiger", "gewaltigen"}) ); 
      break;
    default: level = 14;
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, BS(
    "Der Magiesauger ist ein magisches Lebewesen, dass sich nur von Magie "
    "ernaehrt. Es besteht quasi nur aus einem riesigen Ruessel mit zwei "
    "Fluegeln. Andere Koerperteile oder Sinnesorgane fehlen komplett. "
    "Trotzdem scheint Dich der Magiesauger schon gesichtet zu haben, "
    "denn er beginnt schon, Deine Magiepunkte abzusaugen.") );
  AddId(({"magiesauger", "sauger"}));

  AddDetail( ({"ruessel"}),
      "Ein riesiger Ruessel, er dient wohl zum Absaugen den Magiepunkte.");
  AddDetail( ({"fluegel"}),
      "Der Magiesauger hat zwei grosse Fluegel, mit denen er sich durch die "
      "Astralebene bewegt.");

  create_default_npc(level);
  SetProp(P_HANDS, ({" mit seinem riesigen Ruessel", level*10, ({DT_MAGIC}) }));
  SetProp(P_XP, QueryProp(P_XP) * 4 / 3);
  SetProp(P_RACE, "Astralwesen");
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:-0.5,   DT_PIERCE:-0.5,      DT_BLUDGEON: -0.5,
        DT_RIP: -0.5,    DT_SQUEEZE: -0.5,    DT_WHIP:-0.5,
        DT_LIGHT:-1,     DT_MAGIC:-1,         DT_TERROR:-1,
        DT_AIR: 0.2,     DT_SOUND: 0.5,       DT_EXPLOSION: 0.2,
        DT_MIND: -0.4,   DT_COLD: -0.3,       DT_POISON: -0.7 
        ])); 

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " loest sich in pure Magie auf.\n");
  SetProp(P_KILL_MSG, "Deine ganze Magie gehoert jetzt mir!");
  SetProp(P_MURDER_MSG, "Das naechste Mal saug ich Dir Deine ganze Magie aus, %s!");
  SetProp(P_NOCORPSE, 1);
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" loest @WEN in magische Bestandteile auf.\n" }) );
  AddInfo(DEFAULT_INFO, "kreischt Dich nur an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, level * 3);
  AddSpell(7, level * 18,
    Name(WER,1)+" greift Dich mit Ruessel und Fluegeln zugleich an.\n",
    Name(WER,1)+" greift @WEN mit Ruessel und Fluegeln zugleich an.\n",
     ({DT_MAGIC, DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(2, level * 10, DS_ANTIMAGIC,
    Name(WER,1)+" behindert Deine Magie.\n",
    Name(WER,1)+" behindert @WESSEN Magie.\n", level/4 );
  AddDefaultSpell(1, level * 15, DS_DRAIN_MANA,
    Name(WER,1)+" raubt Dir einige Magiepunkte.\n",
    Name(WER,1)+" raubt @WEM einige Magiepunkte.\n");
  AddSpell(5, level * 13,
    Name(WER,1)+" saugt Dir Deine Magie aus.\n",
    Name(WER,1)+" saugt @WEM die Magie aus.\n",
     ({DT_MAGIC}),"manaleach",([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    Name(WER,1)+" flattert herum.\n",
    Name(WER,1)+" breitet seine Schwingen aus.\n",
    Name(WER,1)+" fliegt um Deinen Kopf.\n",
    Name(WER,1)+" kreischt laut.\n"}) );

  SUID;
  if (!random(9))
    CLONEME(MAGIESTEIN);
  else
    GELD(random(QueryProp(P_LEVEL) * MONEY_FACTOR), TO);
}

void manaleach(object enemy, int damage, mixed dam_type)
{ 
  enemy->AddSp(-enemy->QueryProp(P_SP) / 4);
}

void heart_beat()
{
  ::heart_beat();

  filter_objects(filter_array(all_inventory(MENV), #'interactive), "AddSp", -1);
  if (present("muenzen", environment()))
    command_me("nimm muenzen");
}

