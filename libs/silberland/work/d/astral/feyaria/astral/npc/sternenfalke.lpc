// ein Sternenfalke
// 24-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";
inherit "std/npc/spells";

void create()
{
  int level;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Sternenfalke");
  SetProp(P_GENDER, MALE);
  switch( random(4) )
  {
    case 1:
      SetProp(P_NAME_ADJ, "schnell");
      AddAdjective( ({"schnell", "schneller", "schnellen"}) ); 
      break;
    case 2:
      SetProp(P_NAME_ADJ, "mutig");
      AddAdjective( ({"mutig", "mutiger", "mutigen"}) ); 
      break;
    case 3: 
      SetProp(P_NAME_ADJ, "schoen");
      AddAdjective( ({"schoen", "schoener", "schoenen"}) ); 
      break;
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, BS(
    "Der Sternenfalke ist ein grosser Vogel mit nachtblauen Federn, die wie "
    "Sternenlicht funkeln. Nur seinen grossen Schnabel und die strahlenden "
    "Augen kann man deutlich erkennen. Es scheint sich hier nicht um ein Tier "
    "im herkoemmlichen Sinn zu handeln, sondern vielmehr um die Essenz aller "
    "Voegel.") );
  AddId(({"sternenfalke", "falke", "FEDER_WUSCHEL"}));

  AddDetail( ({"federn"}),
    "Die Federn des Sternenfalken sind nachtblau und funklen.");
  AddDetail( ({"schnabel", "augen"}),
    "Die Augen und der Schnabel des Sternenfalken strahlen wie ein Stern.");
  AddDetail( ({"essenz", "voegel"}),
    "Du kannst die Essenz der Voegel in diesem wunderschoenen "
    "Wesen spueren.");

  create_default_npc(27);
  SetProp(P_HANDS, ({" mit seinem scharfen Schnabel", 300, ({DT_PIERCE, DT_MAGIC}) }));
  SetProp(P_XP, QueryProp(P_XP) * 4 / 3);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 750);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:-0.2,    DT_LIGHT:-1,  DT_MAGIC:-0.5, 
        DT_AIR:0.4,    DT_ELECTRIC:-0.3, DT_LIGHTNING:-0.3])); 

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " stuerzt toedlich verletzt zu Boden.\n");
  SetProp(P_KILL_MSG, "Es war eine Fehler, mich zu unterschaetzen!");
  SetProp(P_MURDER_MSG, "Die Macht der Sterne wird Dich das naechste Mal "
      "besiegen, %s!");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "kreischt Dich nur an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(8, 600,
    Name(WER,1)+" greift Dich mit Krallen und Schnabel zugleich an.\n",
    Name(WER,1)+" greift @WEN mit Krallen und Schnabel zugleich an.\n",
     ({DT_RIP, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 400, DS_BLIND,
    Name(WER,1)+" zerkratzt Dein Gesicht.\n",
    Name(WER,1)+" zerkratzt @WESSEN Gesicht.\n", 3);

  SetChats(1, ({
    Name(WER,1)+" flattert herum.\n",
    Name(WER,1)+" breitet seine Schwingen aus.\n",
    Name(WER,1)+" fliegt um Deinen Kopf.\n",
    Name(WER,1)+" kreischt laut.\n"}) );


  SUID;
}

void die(int poisondeath)
{
  object ob, pl;

  if(!random(GUERTEL_CHANCE))
  {
    pl = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
    if (interactive(pl))
    { 
      write_file(LOG "items", sprintf("%s: %s findet einen Sternenguertel von %s.\n",
            dtime(), capitalize(getuid(pl)), name(WEM,1)));
      CLONEME(ARMOUR "sternenguertel");
    }
  }
  else
    GELD(random(QueryProp(P_LEVEL) * MONEY_FACTOR), TO);
  ::die(poisondeath);
}

