// P_NO_GLOBAL_ATTACK eingefuegt - damit Platzhalter
// auf jeden Fall seine Funktion erfuellen kann
// 31.07.2019 Eros

inherit "std/mnpc";

#include "../def.h"

void create()
{
  int level;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_INVIS, 1);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  AddId(({"dummy"}));
  SetProp( P_NO_GLOBAL_ATTACK, 1 );

  call_out("remove", 0);
}

