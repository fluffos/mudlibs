// ein Astralhirsch
// 24-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";

void create()
{
  int level;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Astralhirsch");
  SetProp(P_GENDER, MALE);
  switch (random(5))
  {
    case 0: 
      SetProp(P_NAME_ADJ, "anmutig");
      AddAdjective( ({"anmutig", "anmutiger", "anmutigen"}) ); 
      break;
    case 1: 
      SetProp(P_NAME_ADJ, "elegant");
      AddAdjective( ({"elegant", "eleganter", "eleganten"}) ); 
      break;
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Der Astralhirsch ist eine wunderschoene Kreatur, die genau die gleiche "
    "Statur wie ein Hirsch hat. Aber sein tiefschwarzes Fell mit den feinen "
    "weissen Streifen und die leuchtenden Augen sind total anders wie bei "
    "einem normalen Hirsch. Das maechtige Geweih ist auch tiefschwarz und nur "
    "zu erkennen, weil es von einer schimmernden Aura umgeben ist. Zusammen "
    "mit dem Astralpanther spielt der Astralhirsch auf ewig das Spiel der "
    "Jagd.");
    
  AddId( ({"astralhirsch", "hirsch", "FELL_WUSCHEL"}) );

  AddDetail( ({"augen"}),
    "Die Augen des Astralhirsches leuchten, scheinbar ist " 
    "dieses Wesen viel intelligenter als ein normales Tier.");
  AddDetail( ({"fell", "streifen"}),
    "Das Fell des Astralhirsches ist tief schwarz, man sieht eigentlich nur "
    "die feinen weissen Streifen.");  
  AddDetail( ({"geweih", "aura"}),
    "Das maechtige Geweih ist tiefschwarz und von einer schimmernden "
    "Aura umgeben.");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinem maechtigen Geweih", QueryProp(P_HANDS)[1], 
        ({DT_PIERCE, DT_MAGIC}) }) );
  SetProp(P_XP, QueryProp(P_XP) * 4 / 3);
  SetProp(P_RACE, "Hirsch");
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, 800);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_LIGHT:-1, DT_MAGIC:-0.5, DT_SOUND:0.3, DT_ACID:0.3 ])); 

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "springt weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 20, 25, 25 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " stuerzt toedlich verletzt zu Boden.\n");
  SetProp(P_KILL_MSG, "Es war ein Fehler, mich zu unterschaetzen!");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "schaut Dich fragend an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 40);
  AddSpell(3, 300,
    Name(WER,1)+" tritt Dich mit den Hinterhufen.\n",
    Name(WER,1)+" tritt @WEN mit den Hinterhufen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 300,
    Name(WER,1)+" tritt Dich mit den Vorderhufen.\n",
    Name(WER,1)+" tritt @WEN mit den Vorderhufen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 700,
    Name(WER,1)+" rammt Dir sein Geweih voll in den Magen.\n",
    Name(WER,1)+" rammt @WEM sein Geweih voll in den Magen.\n",
     ({DT_SQUEEZE}),([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    Name(WER,1)+" wittert aengstlich.\n",
    Name(WER,1)+" kaut an etwas herum.\n",
    Name(WER,1)+" ist in seinem Tarnkleid kaum zu sehen.\n",
    Name(WER,1)+" zeigt Dir sein eindrucksvolles Geweih.\n",
    Name(WER,1)+" schaut Dich mit seinen leuchtenden Augen an.\n",
    Name(WER,1)+" schnuppert an Deinem Hintern.\n"}) );

  SUID;

}

void die(int poisondeath)
{
  object ob, pl;

  if (!random(ASTRALRING_CHANCE))
  {
    pl = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
    if (interactive(pl))
    {
      write_file(LOG "items", sprintf("%s: %s findet Astralring von %s.",
            dtime(), capitalize(getuid(pl)), name(WEM,1)));
      ob = clone_object(ASTRALRING);
      ob->SetProp(P_M_HEALTH_MOD, ([P_SP:1 + random(3) ]) );
      ob->SetProp(P_AC, 2 + random(4) );
      ob->SetProp(P_QUALITY_DECAY, 150 + random(100) );
      ob->SetOwner(getuid(pl));
      if (!random(ASTRALRING_MYSTICAL_CHANCE)) 
      {
        write_file(LOG "items", " (mystisch).\n");
        ob->SetMystical();
      }
      else
        write_file(LOG "items", ".\n");
      ob->SetProp(P_WEAR_RESTRICTIONS, ob->QueryProp(P_WEAR_RESTRICTIONS)+
          ([P_LEVEL: 50]));
      ob->move(TO, M_NOCHECK);
    }
  }
  else
    GELD(random(QueryProp(P_LEVEL) * MONEY_FACTOR), TO);
  ::die(poisondeath);
}
