// ein Astralpanther
// 7-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";

void create()
{
  int level;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Astralpanther");
  SetProp(P_GENDER, MALE);
  switch (random(10))
  {
    case 0..1:  level = 25;
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"klein", "kleiner", "kleinen"}) ); 
      break;
    case 2..5: level = 30; break;
    case 6..8: level = 33;
      SetProp(P_NAME_ADJ, "gross");
      AddAdjective( ({"gross", "grosser", "grossen"}) ); 
      break;
    case 9: level = 35;
      SetProp(P_NAME_ADJ, "riesig");
      AddAdjective( ({"riesig", "riesiger", "riesigen"}) ); 
      break;
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Der Astralpanther ist eine nachtschwarze Kreatur, die sich wie ein "
    "dunkler Schatten vor dem sternenuebersaeten Hintergrund der Astralebene "
    "bewegt. Die gelbgluehenden Augen schauen Dich wissend an, scheinbar ist "
    "dieses Wesen viel intelligenter als ein normales Tier. Die gewaltigen "
    "Reisszaehne sind leuchtend weiss und schauen extrem gefaehrlich aus.");
  AddId(({"astralpanther", "panther", "FELL_WUSCHEL"}));

  AddDetail( ({"zaehne", "reisszaehne"}),
    "Die gewaltigen Reisszaehne sind leuchtend weiss und schauen extrem "
    "gefaehrlich aus.");
  AddDetail( ({"augen"}),
    "Die gelbgluehenden Augen schauen Dich wissend an, scheinbar ist " 
    "dieses Wesen viel intelligenter als ein normales Tier.");
  AddDetail( ({"krallen"}),
    "Der Astralpanther hat grosse, scharfe Krallen.");  

  create_default_npc(level);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", level*12, ({DT_RIP, DT_MAGIC}) }));
  SetProp(P_XP, QueryProp(P_XP) * 4 / 3);
  SetProp(P_RACE, "Raubkatze");
  SetProp(P_SIZE, 140);
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_RIP:-0.2,    DT_LIGHT:-1, DT_MAGIC:-0.5, 
        DT_TERROR:-0.7, DT_ACID:0.3, DT_EXPLOSION:0.2])); 

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "springt bruellend herein");
  SetProp(P_MMSGOUT, "springt bruellend weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 10, 15, 15 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " stuerzt toedlich verletzt zu Boden.\n");
  SetProp(P_KILL_MSG, "Es war ein Fehler, mich zu unterschaetzen!");
  AddInfo(DEFAULT_INFO, "faucht Dich nur an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "schnurrt: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(5, 500,
    Name(WER,1)+" greift Dich mit seinen gefaehrlichen Reisszaehnen an.\n",
    Name(WER,1)+" greift @WEN mit seinen gefaehrlichen Reisszaehnen an.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 900,
    Name(WER,1)+" springt Dich an, reisst Dich zu Boden und graebt seine "
    "Krallen\nin Deine Brust.\n",
    Name(WER,1)+" springt und reisst @WEN zu Boden.\n",
     ({DT_RIP, DT_SQUEEZE}),"disable",([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
    Name(WER,1)+" faucht Dich an.\n",
    Name(WER,1)+" schaut Dich mit seinen leuchtenden Katzenaugen an.\n",
    Name(WER,1)+" zeigt seinen gewaltigen Reisszaehne.\n",
    Name(WER,1)+" bruellt laut.\n",
    Name(WER,1)+" schnurrt leise.\n",
    Name(WER,1)+" fletscht seine Zaehne.\n"}) );

  SUID;
}

void disable(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, 1 + random(4));
}

mixed _query_reject()
{
  if( random(2) )
    return ({ REJECT_DESTRUCT, Name(WER,1)+" frisst @WEN auf.\n" });
  else
    return ({ REJECT_DROP, Name(WER,1)+" bruellt Dich hungrig an.\n" });
} 

void init()
{
  ::init();
  if( !TP || !TP->id("astralhirsch")) return;
  if( random(2) )
  {
    call_out("hungrig",2);
  }
}

void hungrig()
{
  if( objectp(TP) && objectp(MENV) && present(TP, MENV) )
  {
    write(Name(WER,1)+" schleicht hungrig um Dich herum.\n");
    say(Name(WER,1)+" schleicht hungrig um "+ TP->name(WEN) +" herum.\n", ({TP}) );
    if( random(2) )
      call_out("angriff", 2);
  }
}

void angriff()
{
  if( !TP ) return;
  if( present( TP, MENV ) )
  {
    write("Ploetzlich springt Dich "+name(WER,1)+" an.\n");
    say("Ploetzlich springt "+name(WER,1)+" "+ TP->name(WEN) +" an.\n", ({TP}) );
    Kill(TP);
  }
}

void die(int poisondeath)
{
  object ob, pl;

  if (!random(ASTRALRING_CHANCE))
  {
    pl = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
    if (interactive(pl))
    {
      write_file(LOG "items", sprintf("%s: %s findet Astralring von %s.",
            dtime(), capitalize(getuid(pl)), name(WEM,1)));
      ob = clone_object(ASTRALRING);
      ob->SetProp(P_M_HEALTH_MOD, ([P_SP:1 + random(3) ]) );
      ob->SetProp(P_AC, 2 + random(4) );
      ob->SetProp(P_QUALITY_DECAY, 150 + random(100) );
      ob->SetOwner(getuid(pl));
      if (!random(ASTRALRING_MYSTICAL_CHANCE)) 
      {
        write_file(LOG "items", " (mystisch).\n");
        ob->SetMystical();
      }
      else
        write_file(LOG "items", ".\n");
      ob->SetProp(P_WEAR_RESTRICTIONS, ob->QueryProp(P_WEAR_RESTRICTIONS)+
          ([P_LEVEL: 50]));
      ob->move(TO, M_NOCHECK);
    }
  }
  else
    GELD(random(QueryProp(P_LEVEL) * MONEY_FACTOR), TO);
  ::die(poisondeath);
}

