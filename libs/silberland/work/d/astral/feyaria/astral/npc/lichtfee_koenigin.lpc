// eine Lichtfee
// 25-10-2003  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_astral_npc";
inherit "std/npc/spells";

void create()
{
  object ob;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Luxiana");
  SetProp(P_ARTICLE, 0);
  SetProp(P_KILL_NAME, "Die Koenigin der Lichtfeen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Luxiana, die Koenigin der Lichtfeen");
  SetProp(P_LONG, 
    Name(WER,1)+ " fuehlt sich hier in der Astralebene sichtlich wohl, "
    "umgeben von Licht und Magie. Mit ihren kleinen Fluegelchen schwirrt sie "
    "vergnuegt zwischen den Sternen umher. Sie ist von einem wahrhaft "
    "koeniglichem Licht umgeben." );
  AddId(({"lichtfee", "fee", "luxiana"}));

  AddDetail( ({"fluegel", "fluegelchen"}),
      "Die Fluegel der Lichtfee sind nicht sehr gross, aber gross genug, "
      "dass sie hier herumschwirren kann.");

  create_default_npc(55, 7000);
  SetProp(P_HANDS, ({" mit Feenmagie", 700, ({DT_MAGIC, DT_LIGHT}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_BODY, QueryProp(P_BODY) + 150);
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 63);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 50);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_LIGHT:-1,  DT_MAGIC:-1,  DT_HOLY: -0.6, DT_AIR: -0.8, 
        DT_FIRE: -0.5, DT_UNHOLY: 0.1, DT_SOUND: -0.3, DT_SLASH: -0.4,
        DT_BLUDGEON: -0.3, DT_RIP: -0.2, DT_PIERCE: -0.2, DT_WHIP: -0.1,
        DT_TERROR:0.1,   DT_POISON: 0.1,  DT_EXPLOSION: 0.1, DT_COLD: 0.1])); 

  SetProp(P_MSGIN, "schwirrt herein");
  SetProp(P_MSGOUT, "schwirrt");
  SetProp(P_MMSGIN, "schwirrt herein");
  SetProp(P_MMSGOUT, "schwirrt weg");
  SetProp(P_MNPC_AREA, (ROOM "astral") );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "astral33") );
  SetProp(P_MNPC_WAIT, ({ 20, 25, 25 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SetProp(P_DIE_MSG,  " haucht ihre zartes Leben aus.\n");
  SetProp(P_KILL_MSG, "Die Maechte des Lichts haben wieder einmal gesiegt!");
  SetProp(P_MURDER_MSG, "Wie konntest Du nur meinem prismatischen Licht "
      "entkommen, %s?");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" verwandelt @WEN in einen Stern.\n" }) );
  AddInfo(DEFAULT_INFO, "sagt: @@random_info@@.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 100);
  AddSpell(1, 900,
    Name(WER,1)+" schiesst einen hellen Lichtstrahl auf Dich ab.\n",
    Name(WER,1)+" schiesst einen hellen Lichtstrahl auf @WEN ab.\n",
     DT_LIGHT,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 800,
    Name(WER,1)+" wirft einen magischen Pfeil auf Dich.\n",
    Name(WER,1)+" wirft einen magischen Pfeil auf @WEN.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
    Name(WER,1)+" schwirrt vergnuegt herum.\n",
    Name(WER,1)+" leuchtet hell.\n",
    Name(WER,1)+" leuchtet sehr hell.\n",
    Name(WER,1)+" zwitschert etwas in einer unverstaendlichen Sprache.\n",
    Name(WER,1)+" sagt: @@random_info@@.\n",
    Name(WER,1)+" flattert mit ihren Fluegeln.\n"}) );

  SUID;

  ob = clone_object(ERZMAGIESTEIN);
  ob->AddAmount(5 + random(10));
  ob->move(ME, M_NOCHECK);

  ob = clone_object("/p/armour/trousers/rock_kurz");
  ob->SetProp(P_AC, 10);
  ob->SetProp(P_QUALITY_DECAY, 2000);
  ob->SetProp(P_NAME_ADJ, ({"wunderschoen", "kurz"}) );
  ob->AddAdjective( ({"wunderschoen", "wunderschoenen", "wunderschoener"}) );
  ob->SetProp(P_SHORT, ob->Name(WER,0) + " (glitzernd)" );
  ob->SetProp(P_M_HEALTH_MOD, ([P_HP: 10, P_SP: 10]));
  ob->move(ME, M_NOCHECK);

  CLONEME(FEENHANDSCHUHE);
  CLONEME(ARMOUR "lichtpanzer");
  if(!random(2)) CLONEME(WEAPON "lichtbogen");
  CLONEME(FEENSCHLEIER);

  command_me("trage alles");
}

string random_info()
{
  string x;
  int i,j;
  string *abc;

  abc = ({"ala", "alo", "isi", "eth", "myth", "gor", "zik", "kol",
          "ful", "yib", "flapp", "loo", "mii", "re", "ju", "ro",
          "gamm", "tyr", "oth", "giz", "baa", "darra", "fero",
          "ovo", "atta", "cor", "nef", "do", "aar", "romi", "pyr"});
  x="";
  for(i=random(5)+random(3)+1; i>=0; i--)
  {
    for(j = !random(4)+random(2)+1; j>=0; j--)
    {
      x+=abc[random(sizeof(abc))];
    }
    x+=" ";
    if( strlen(x)>35) break;
  }
  return CAP(x[0..<2]);
}

mapping prism = ([ 1: "rot"; DT_FIRE; P_DISABLE_ATTACK; 5; ANSI_RED + ANSI_BOLD,
                   2: "orangen"; DT_COLD; P_PARALYZED; 3; ANSI_YELLOW,
                   3: "gelb"; DT_LIGHT; P_BLIND; 20; ANSI_YELLOW + ANSI_BOLD,
                   4: "gruen"; DT_MAGIC; P_FROG; 1; ANSI_GREEN + ANSI_BOLD,
                   5: "zyan"; DT_POISON; P_POISON; 5; ANSI_CYAN + ANSI_BOLD,
                   6: "blau"; DT_WATER; P_DISABLE_SPELLS; 5; ANSI_BLUE + ANSI_BOLD,
                   7: "violett"; DT_AIR; P_DEAF; 20; ANSI_PURPLE + ANSI_BOLD ]);

void prismatic_spray()
{
  object *enemies, wer;
  int i;
  string n;


  n = ANSI_NORMAL;
  for(i=1; i<=7; i++)
  {
    if (!sizeof(enemies = PresentEnemies()))
      return;
    wer = enemies[random(sizeof(enemies))];
    if( random(100) > 90 || (wer->QueryProp(prism[i,2]) && !random(3)) )
    {
      tell_room(MENV, prism[i,4] + "Der " + prism[i] + "e Strahl zischt ohne "
          "Wirkung durch den Raum." + n + "\n" );
    }
    else if( wer->QueryAttribute(A_DEX) > random(200) )
    {
      tell_room(MENV, prism[i,4] + wer->Name(WER,1)+" weicht dem " + prism[i] +
          "en Strahl aus." + n + "\n", 
          ({wer}) );
      tell_object(wer, prism[i,4] + "Du weichst dem "+prism[i]+"en Strahl aus." + n + "\n");
    }
    else
    {
      tell_room(MENV, prism[i,4] + wer->Name(WER,1)+" wird vom "+prism[i]+
          "en Strahl getroffen." + n + "\n", ({wer}) );
      tell_object(wer, prism[i,4] + "Du wirst vom "+prism[i]+"en Strahl getroffen." + n + "\n");
      wer->Defend(333+random(333), prism[i,1], ([SP_SHOW_DAMAGE:1]), TO);
      if(objectp(wer) && !wer->QueryProp(prism[i,2]) && 
          wer->QueryAttribute(A_INT) < random(120) && !wer->QueryProp(P_GHOST))
        wer->SetProp(prism[i,2], prism[i,3]);
    }
  }
}

void heart_beat()
{
  string prismatic;

  ::heart_beat();
  if (InFight() && random(2))
  {
    prismatic = ANSI_BOLD+ANSI_RED+"p"+ANSI_YELLOW+"r"+ANSI_CYAN+"i"+
              ANSI_GREEN+"s"+ANSI_BLUE+"m"+ANSI_PURPLE+"a"+ANSI_RED+"t"+
              ANSI_YELLOW+"i"+ANSI_CYAN+"s"+ANSI_GREEN+"c"+ANSI_BLUE+"h"+
              ANSI_PURPLE+"e"+ANSI_RED+"m"+ANSI_NORMAL;
    tell_room(MENV, Name(WER,1)+" ueberflutet den Raum mit "+prismatic+" Licht.\n");
    prismatic_spray();
  }
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  ASTRALMASTER->AddFlag(killer, FLAG_LUXIANA, filter_array(PresentEnemies(), #'interactive));
  write_file( LOG "luxiana.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  ::die(poisondeath);
}

int _query_disable_attack() { return 0; }
int _query_disable_spells() { return 0; }
mixed _query_skill_attr() { return 0; }
int _query_poison() { return 0; }
int _query_frog() { return 0; }
int _query_blind() { return 0; }

int Defend(int dam, string *dtype, int spell, object enemy)
{
  if (!random(4))
  {
    ENV(TO)->Message(Name(WER,1) + " weicht dem Angriff einfach aus.\n",
        MSGFLAG_VISUAL);
    return ::Defend(0, dtype, spell, enemy);
  }
  return ::Defend(dam, dtype, spell, enemy);
}

