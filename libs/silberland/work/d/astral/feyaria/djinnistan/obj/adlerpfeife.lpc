// Wings fuers Fliegen per Luftelementar 
// 8.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

int ladungen = 1;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Adlerpfeife");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine Adlerpfeife");
  SetProp(P_LONG,
      "Eine kleine Pfeife, in die das Bild eins Adlers geschnitzt ist.");
  AddId( ({"\nadlerpfeife", "adlerpfeife", "pfeife"}) );
  SetProp(P_INFO,
      "Hinter dieser unscheinbaren Pfeife scheint viel mehr zu stecken als Du "
      "auf den ersten Eindruck vermutet hast. Eine extrem maechtige Magie "
      "steckt in diese Pfeife, es scheint sich um Luftmagiezu handeln, Du "
      "kannst aber auch Muster von Bewegungs- und Beschwoerungsmagie erkennen. "
      "Vielleicht kannst Du auf ihr pfeifen, um einen Adler herbeizurufen?");

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 500);
  SetProp(P_MATERIAL, MAT_HORN);

  AddCmd( ({"pfeif", "pfeife"}), "cmd_pfeifen");
}

int cmd_pfeifen(string str)
{
  notify_fail("Worauf willst Du pfeifen?\n");
  if (!str || (str != "auf pfeife" && str != "auf adlerpfeife"))
    return 0;
  write("Du pfeifst auf Deiner Adlerpfeife.\n");
  say(CAP(TPN) + " pfeift auf einer Adlerpfeife.\n");
  call_out("adler", 5+ random(5));
  return 1;
}

void adler()
{
  if (!TP || !TO || !ENV(TP))
    return;
  if (!ladungen)
  {
    write("Nichts passiert, scheibar muss sich die Magie der Pfeife wieder "
        "aufladen.\n");
    return;
  }
  if (ENV(TP)->QueryProp(P_INDOORS))
  {
    write("Die Adlerpfeife funktioniert nur unter freiem Himmel!\n");
    return;
  }
  if (ENV(TP)->QueryProp(P_NO_TPORT))
  {
    write("Eine magische Macht verhindert, dass der Adler hier landen kann!\n");
    return;
  }
  tell_room(ENV(TP),
      "Du siehst einen gewaltigen Adler auf Dich zufliegen.\n");
  call_out("landung", 2, ENV(TP));
  ladungen = 0;
}

void landung(object room)
{
  object ob;

  if (!TP)
    return;
  ob = clone_object(RIESENADLER);
  ob->move(room, M_TPORT);
  ob->set_player(TP);
  if (!random(7))
  {
    tell_object(TP, "Die Adlerpfeife zerbricht!\n");
    remove();
  }
}

void reset()
{
  ::reset();
  ladungen = 1;
}
