// std-leiche fuer djinnistan
// 10-03-2004  Feyaria@SilberLand

inherit "std/corpse";

#include "../def.h"

void create()
{
  object killer;
  object ob;
  int level;

  if (!is_clone(TO)) return;
  ::create();

  SUID;
  if (!PO || PO->QueryProp("got_loot"))
    return;

  level = PO->QueryProp(P_LEVEL);
  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object(1);
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "djinnistan", level);

  PO->SetProp("got_loot", 1);
  if (strstr(file_name(PO), "kalif") != -1)
  {
    if (objectp(killer))
    {
      ASTRALMASTER->AddFlag(killer, FLAG_KALIF,
          filter_array(PO->PresentEnemies(), #'interactive));
      write_file( LOG "kalif.kills",
          dtime(time())+": "+CAP(getuid(killer))+" toetet "+PO->name(WEN)+".\n");
    }
    ob = clone_object( DJINNI_EQUIP );
    ob->set_kalif();
    ob->move(PO, M_NOCHECK);
    BOSS_LOOT;
    ASTRALMASTER->SetTime("djinnistan");
  }
  else if (strstr(file_name(PO), DJINNI) != -1 && !random(DJINNI_CHANCE))
    CLONELOG( DJINNI_EQUIP, PO )
  else if (!random(MASK_CHANCE) || 
      (level >= 40 && !random(RARE_MASK_CHANCE)))
    CLONELOG( ARMOUR "luftmaske", PO )
  else if (level >= 35 && !random(AIRHAMMER_CHANCE))
    CLONELOG( WEAPON "sturmhammer", PO)
  else if (level >= 25 && !random(ADLERPFEIFE_CHANCE))
    CLONELOG( OBJ "adlerpfeife", PO)
  else if (!random(KEY_CHANCE - level * level / 50))
    CLONELOG( OBJ + ({"luftessenz", "luftkristall", "luftsymbol"})[random(3)], PO)
  else if (!random(SALBE_CHANCE))
    CLONELOG( OBJ "luftsalbe", PO )
  else if (!random(WSALBE_CHANCE))
    CLONELOG( WSALBE, PO )
  else if (!random(RSALBE_CHANCE))
    CLONELOG( RSALBE, PO )
  MAGIC_WANDS
  else if (random(2))
  {
    object geld;
    geld = clone_object("/obj/money");
    geld->AddAmount(level + random(level * MONEY_FACTOR));
    geld->move(PO, M_NOCHECK);
  }
  else
  {
    geld = clone_object(LUFTFRAGMENT);
    geld->AddAmount(random(2 * level / 3));
    geld->move(PO, M_NOCHECK);
  }
}
