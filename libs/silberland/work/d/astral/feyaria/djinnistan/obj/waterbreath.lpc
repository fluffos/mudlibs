#include "../def.h"

inherit WATERBREATH;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId("\nastralwaterbreather");
}

void reset()
{
  object *helms;
  if (!is_clone(this_object())) return;
  if (!MENV || 
     !(sizeof(helms = MENV->QueryArmours(AT_HELMET)) && 
       helms[0]->id("\ndjinnistanluftmaske") ||
     (sizeof(helms = MENV->QueryArmours(AT_CLOAK)) && 
      helms[0]->id("\ndraconiawassermantel"))))
    ::reset();
}

