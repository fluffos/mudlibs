// Wings fuers Fliegen per Luftelementar 
// 8.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

int duration;
object caster;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Fluegel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Elementare Fluegel");
  SetProp(P_LONG,
      "Diese Fluegel bestehen aus reiner Luft, trotzdem tragen sie Dich gut "
      "durch die Luefte. @@zustand@@");
  AddId( ({"\nwings", "fluegel"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, MAT_AIR);

}

int query_duration()
{
  return duration - time();
}

string zustand()
{
  return "Die Fluegel scheinen noch ca. " + (duration - time()) / 60 + 
    " Minuten zu halten.\n";
}

void fliegen(object _caster, int _duration)
{
  while(remove_call_out("remove") != -1);
  duration = time() + _duration;
  if((caster = _caster) != MENV)
    remove();
  call_out("warn_remove", _duration, 0);
  caster->AddClass(CL_FLYING);
}

varargs void warn_remove(int count)
{
  if (objectp(caster))
    tell_object(caster,
        "\nDeine Fluegel werden sich bald aufloesen!\n\n");
  if (++count < 5)
    call_out("warn_remove", 30, count);
  else
    call_out("remove", 30);
}

varargs int remove(int silent)
{
  if(caster && !silent)
    tell_object(caster, BS("Deine elementaren Fluegel loesen sich auf. "
        "Hoffentlich schwebst Du nicht zu hoch in der Luft, sonst wuerde "
        "Dich der Absturz sicherlich toeten."));
  if (caster)
    caster->RemoveClass(CL_FLYING);
  ::remove();
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  remove(1);
}

void init()
{
  ::init();
  if(!MENV || !interactive(MENV))
    remove(1);
}

string extra_look()
{
  if (caster)
    return "Zwei grosse Fluegel lassen " + caster->QueryPronoun(WEN) + 
      " in der Luft schweben.\n";
  return "";
}
