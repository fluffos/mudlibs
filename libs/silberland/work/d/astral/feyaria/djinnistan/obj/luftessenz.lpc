// Luftessenz fuer Eingang zum Palast
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Essenz des Sturms");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Die Essenz des Sturms");
  SetProp(P_LONG,
      "Die Essenz des Sturms ist ein maechtiges Artefakt und besteht aus "
      "purer Luft. Wofuer mag sie wohl gut sein?"); 
  AddId( ({"essenz", "sturmessenz", "essenz sturms", 
        "essenz des sturms", "\nluftpalastkey2"}) );
  SetProp(P_INFO, BS(
      "Die Essenz des Sturms wird fuer den Zugang zum Palast der "
      "Luefte benoetigt. Allerdings brauchst man dazu noch "
      "das Symbol der Luft und den Kristall des Windes. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast der Luefte oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_AIR);
  SetProp(P_MAGIC, 1);
}

