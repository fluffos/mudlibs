// Luftkristall fuer Eingang zum Palast
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Kristall des Windes");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Der Kristall des Windes");
  SetProp(P_LONG,
      "Der Kristall des Windes ist ein maechtiges Artefakt und besteht "
      "aus fester Luft. Wofuer mag er wohl gut sein?");
  AddId( ({"kristall", "windkristall", "kristall windes",
        "kristall des windes", "\nluftpalastkey1"}) );
  SetProp(P_INFO, BS(
      "Der Kristall des Windes wird fuer den Zugang zum Palast der "
      "Luefte benoetigt. Allerdings brauchst man dazu noch "
      "die Essenz des Sturms und das Symbol der Luft. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast der Luefte oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_AIR);
  SetProp(P_MAGIC, 1);

  AddCmd("oeffne", "cmd_oeffnen");
}

int cmd_oeffnen(string str)
{
  object ob1, ob2;

  if (objectp(ob1 = present("\nluftpalastkey2")) && 
      objectp(ob2 = present("\nluftpalastkey3")) && 
      ENV(TP) && strstr(file_name(ENV(TP)), "djinnistan/room/luftraum") != -1)
  {
    if (member( ({"zugang", "zugang zum palast", "zugang zum palast luefte"}), 
          str) != -1)
    {
      if (ASTRALMASTER->QueryTime("djinnistan") > 0)
      {
        write(BS("Du versuchst, den Zugang zum Palast des Luefte zu oeffnen, "
              "aber irgendwie funkioniert das nicht. Scheinbar ist der Djinni "
              "Kalif nicht in seinem Palast."));
        return -1;
      }
      call_other(ROOM "palast1", "???");
      if (sizeof(find_object(ROOM "palast1")->QueryProp(P_EXITS)) > 1)
      {
        write("Der Palast wurde bereits betreten!\n");
        return -1;
      }
      write(BS("Du haeltst das Symbol der Luft in die Hoehe, sodass es in "
            "Augenhoehe vor Dir schwebt. Dannn nimmst Du den Kristall des "
            "Windes und die Essenz des Sturmes in die ausgestreckten Arme und "
            "laesst Deine Magie fliessen."));
      say(BS(TPN + " haelt das Symbol der Luft in die Hoehe, sodass es in "
            "Augenhoehe vor " + TP->QueryPronoun(WEM) + " schwebt. Dannn nimmt "+
            TP->QueryPronoun(WER) + " den Kristall des Windes und die Essenz des "
            "Sturmes in die ausgestreckten Arme und laesst " +
            TP->QPP(FEMALE, WEN, SINGULAR)+ " Magie fliessen."));
      tell_room(ENV(TP),"\nDas Portal zum Palast der Luefte oeffnet sich.\n\n");
      find_object(ROOM "palast1")->AddExit("raus", file_name(ENV(TP)));
      CLONE(OBJ "portal", ENV(TP));
      ob1->remove();
      ob2->remove();
      TP->AddSp(-400);
      call_out("remove", 0);
      return 1;
    }
    notify_fail("Willst Du vielleicht den Zugang zum Palast der Luefte oeffnen?\n");
    return 0;
  }
}
