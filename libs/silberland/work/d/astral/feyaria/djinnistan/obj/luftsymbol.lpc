// Luftsymbol fuer Eingang zum Palast
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, ({"Symbol der Luft",
                    "Symbols der Luft",
                    "Symbol der Luft",
                    "Symbol der Luft"}) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Das Symbol der Luft");
  SetProp(P_LONG,
      "Das Symbol der Luft ist ein maechtiges Artefakt und besteht "
      "voellig aus Luft. Wofuer mag es wohl gut sein?");
  AddId( ({"symbol", "luftsymbol", "symbol luft", 
        "symbol der luft", "\nluftpalastkey3"}) );
  SetProp(P_INFO, BS(
      "Das Symbol der Luft wird fuer den Zugang zum Palast der "
      "Luefte benoetigt. Allerdings brauchst man dazu noch den "
      "Kristall des Windes und die Essenz des Sturms. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast der Luefte oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_AIR);
  SetProp(P_MAGIC, 1);
}

