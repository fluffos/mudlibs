#include "../def.h"

inherit ROOM "std_luftraum";

void create()
{
  string *npcs;

  if(!is_clone(TO)) return;
  ::create();
  PO->CustomizeObject();

  SetProp(P_INT_SHORT, "Mitten im luftigen Djinnistan");
  SetProp(P_INT_LONG,
      "Du befindest Dich mitten in Djinnistan, dem Reich der Luefte. In "
      "allen Richtungen siehst Du nur Wolken. Es blaest ein starker Wind, "
      "der Deine Haare zerzaust. Auch unter Dir befindet sich nur Luft, "
      "zum Glueck kannst Du fliegen, sonst waerst Du sicher schon "
      "abgestuerzt.");

  AddDetail( ({"djinnistan", "reich", "reich der luefte"}),
      "Djinnistan, das Reich der Luefte, sie wird von Druiden auch als die "
      "elementare Ebene der Luft bezeichnet. Der Name kommt von den Djinnis, "
      "die in dieser Ebene leben.");
  AddDetail( ({"djinnis", "djinni", "djinne", "djinn", "luftwesen"}),
      "Die Djinne sind die Herrscher ueber die Ebene der Luefte.");
  AddDetail( ({"herrscher"}),
      "Der Herrscher aller Luftwesen ist der Djinni Kalif.");
  AddSpecialDetail( ({"kalif", "djinni kalif", "macht"}), "det_kalif");
  AddDetail( ({"luft"}),
      "Luft gibt es hier viel, Du bist ja auch in der Ebene der Luft.");
  AddDetail( ({"ebene"}),
      "Ebene bedeutet hier keine Landschaftsform oder dass hier alles ganz "
      "flach ist ist. Vielmehr stellt man sich vor, dass die verschiedenen "
      "Ebenen wie die Stockwerke eines Hauses uebereinander liegen.");
  AddDetail( ({"stockwerk", "stockwerke", "haus"}),
      "So kann man es sich vorstellen.");
  AddDetail( ({"landschaftsform", "bedeutung"}),
      "Nein, diese Bedeutung von Ebene ist nicht gemeint.");
  AddDetail( ({"druiden"}),
      "Druiden haben grosse Macht ueber die Elemente. ");
  AddDetail( ({"elemente", "feuer", "wasser", "eis", "humus", "erz"}),
      "Die Elemente sind Feuer, Wasser, Eis, Humus, Erz und natuerlich Luft.");
  AddDetail( ({"macht", "verstaendnis"}),
      "Die Macht der Druiden ueber die Elemente kommt aus dem Verstaendnis "
      "der Elementartheorie.");
  AddDetail( ({"elementartheorie"}),
      "Vereinfacht sagt die Elementartheorie, dass es sechs Elemente gibt, "
      "wobei sich jeweils zwei immer entgegengesetzt sind, zum Beispiel "
      "Erz und Luft.");
  AddDetail( ({"beispiel"}),
      "Ein anderes Beispiel ist Feuer und Wasser.");
  AddDetail( ({"richtungen", "richtung"}),
      "In jede Richtung schaut es hier ziemlich gleich aus.");
  AddDetail( ({"wind", "sturm"}),
      "Der Wind ist schon fast ein Sturm! Er zerzaust Deine Haare.");
  AddDetail( ({"haare"}),
      "Die sind vom Wind ganz zerzaust.");
  AddDetail( ({"boden"}),
      "Kein Boden, unter Dir befindet sich nur Luft.");
  AddDetail( ({"himmel"}),
      "Irgendwie ist das, was Du sonst unter Himmel verstehst, ueberall rund "
      "um Dich.");
  AddDetail( ({"wolken", "wolke"}),
      "Ueberall sind Wolken, nicht nur ueber Dir wie normalerweise, sondern "
      "auch neben und sogar unter Dir.");
  AddDetail( ({"glueck"}),
      "Zum Glueck kannst Du fliegen! Sonst waerest Du schon laengst tief "
      "hinuntergefallen. Wie tief, daran willst Du gar nicht denken.");

  AddSmell( ({DEFAULT_SMELL, "geruch"}), 
      "Es riecht luftig.");
  AddSound( ({DEFAULT_SOUND, "brausen", "wind"}), 
      "Du hoerst das Brausen des Windes.");
 
  npcs =({
      ADLER,
      WOLKENHACKER,
      LUFTGEIST_KLEIN,
      LUFTGEIST_GROSS,
      ORKANDAEMON,
      HARPYIE,
      FLUEGELSCHLANGE,
      DONNERVOGEL,
      NPC "luftelementar",
      NPC "windhose",
      NPC "wirbelsturm",
      NPC "tornado",
      NPC "luftdruide",
      NPC "greif",
      });
  if (random(100) < NPC_CHANCE)
    AddItem( npcs + (!random(3) ? ({DJINNI "malik"}) : ({})), 
        REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES,
          P_MNPC_WAIT: ({ 30, 60, 60 }),
          P_HEAL: 200,
          P_CORPSE: OBJ "luftleiche",
          P_NOCORPSE: 0]) ); 

  if (random(100) < RARE_NPC_CHANCE)
    AddItem(  npcs + ({
          CORRUPTOR,
          RIESENADLER,
          NPC "orkan",
          NPC "sturmriese",
          NPC "sturmdrache",
          DJINNI "wesier",
          }), REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES,
          P_MNPC_WAIT: ({ 60, 90, 90 }),
          P_ASTRAL_RARE_NPC: 1,
          P_HEAL: 500,
          P_CORPSE: OBJ "luftleiche",
          P_NOCORPSE: 0]) ); 

}

string det_kalif()
{
  if (ASTRALMASTER->QueryTime("djinnistan") < 0)
    return "Du kannst die Macht des Djinni Kalif richtig spueren.\n";
  else
    return "Die Macht des Djinni Kalif ist momentan sehr schwach.\n";
}
