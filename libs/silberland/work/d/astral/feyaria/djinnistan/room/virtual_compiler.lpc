// Virtual Compiler fuer Djinnistan 
// 23.1.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/virtual/v_compiler";

#include <v_compiler.h>

#define P_ROOMS "raum"

mapping exits;
mapping extra_exits;

void create() 
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "luftraum" );
  SetProp(P_ROOMS, ({"luftraum"}) );

  exits = ([
      "norden":  1;  0;  0,
      "sueden": -1;  0;  0,
      "westen":  0;  1;  0,
      "osten":   0; -1;  0,
      "oben":    0;  0;  1,
      "unten":   0;  0; -1,
    ]);
  extra_exits = ([
      "nordwesten":  1;  1;  0,
      "suedwesten": -1;  1;  0,
      "nordosten":   1; -1;  0,
      "suedosten":  -1; -1;  0,
      "nordwestoben":  1;  1;  1,
      "suedwestoben": -1;  1;  1,
      "nordostoben":   1; -1;  1,
      "suedostoben":  -1; -1;  1,
      "nordwestunten":  1;  1; -1,
      "suedwestunten": -1;  1; -1,
      "nordostunten":   1; -1; -1,
      "suedostunten":  -1; -1; -1,
    ]);
}

string Validate(string file) 
{
  string name, foo;
  int x, y, z;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%d:%d:%d%s", name, x, y, z, foo) == 5) &&
      (member(QueryProp(P_ROOMS), name) != -1) &&
      x >= 0 && x < XSIZE && 
      y >= 0 && y < YSIZE && 
      z >= 0 && z < ZSIZE) 
    return name+":"+x+":"+y+":"+z;
  return 0;
}

int CustomizeObject() 
{
  string foo,foo2;
  string *ind;
  int x,y,z,i;
  mixed name;
  
  if (!(name = ::CustomizeObject()) || 
      sscanf(name,"%s:%d:%d:%d%s", foo, x, y, z, foo2) != 5)
    return 0;

  ind = m_indices(exits);
  for (i = 0; i < sizeof(ind); i++) 
    PO->AddExit( ind[i], ROOM "luftraum:" +
        ((x + exits[ind[i], 0] + XSIZE) % XSIZE) + ":" +
        ((y + exits[ind[i], 1] + YSIZE) % YSIZE) + ":" +
        ((z + exits[ind[i], 2] + ZSIZE) % ZSIZE) );
  if (x == 0 && y == 0 & z == 0)
    PO->AddItem(NPC "luftkneipennpc", REFRESH_DESTRUCT);
  return 1;
}
