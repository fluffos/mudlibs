
#include "../def.h"
#include <pub.h>

inherit  "std/pub";

string read_liste();

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "Die Luftkneipe");
  SetProp(P_INT_LONG,
      "Du stehst in der Luftkneipe. Allerdings erinnert hier nichts an eine "
      "normale Kneipe, ausser dass man sich hier Essen und Getraenke "
      "bestellen kann. Serviert werden sie von seltsamen Luftwesen, die "
      "wie aus dem Nichts erscheinen, sobald man etwas bestellt hat und "
      "sich wieder in Luft aufloesen, sobald sie das Gewuenschte gebracht "
      "haben. Ein breites Portal fuehrt in den Nexus und ein kleiner "
      "Ausgang fuehrt weiter in diese luftige Welt.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_AIR]) );

  AddDrink("Fluessige Luft", 
      ({"fluessige luft", "luft", "fluessig"}),
      345, 34, 0, 6,
      ({"Du bekommst fluessige Luft serviert und trinkst sie in einem "
       "Zug hinunter.... total geschmacklos, aber kraeftigend.",
       "&& bekommt fluessige Luft serviert und trinkt sie in einem "
       "Zug hinunter."}));
  AddDrink("Sturmbraeu", 
      ({"braeu", "sturmbraeu"}),
      545, 47, 9, 0,
      ({"Du bekommst ein Sturmbraeu serviert und waehrend Du es austrinkst, "
       "wirst Du wie in einem Wirbelsturm herumgewirbelt.",
       "&& bekommt ein Sturmbraeu Luft serviert und wird wie in einem "
       "Wirbelsturm herumgewirbelt."}));
  AddFood ( "Feste Luft", 
      ({"feste luft", "fest"}),
      678, 69, 14,
      ({"Du bekommst einen Klumpen feste Luft serviert und isst sie sofort "
       "auf..... total geschmacklos, aber saettigend.",
       "&& bekommt einen Klumpen feste Luft serviert und isst sie sofort "
       "auf."}) );
  AddFood ( "Luftleere Leckerbissen", 
      ({"leckerbissen", "luftleere leckerbissen", "luftleer"}),
      1234, -3, -10,
      ({"Du bekommst luftleere Leckerbissen serviert die aber nach ueberhaupt "
       "nicht schmecken und Dir eigentlich nur noch mehr Hunger machen.",
       "&& bekommt luftleere Leckerbissen serviert und schaut nun noch "
       "hungriger aus."}) );

  AddSpecialDetail( ({"speise", "speisen", "getraenke", "getraenk", 
        "bestellen", "essen", "trinken", "bestellungen"}), 
      "det_menu");

  AddDetail( ({"boden", "luftstrom"}),
      "Hier gibt es keinen Boden! ein starker Luftstrom von unten verhindert, "
      "dass Du runterfaellst."),
  AddDetail( ({"waende", "wand", "decke"}),
      "Alles nur Luft.");
  AddDetail( ({"kneipe", "luftkneipe"}),
      "Du befindest Dich in der Luftkneipe.");
  AddDetail( ({"luftwesen", "wesen"}),
      "Die Luftwesen erscheinen nur, um Bestellungen zu erfuellen und "
      "verschwinden dann sofort wieder.");
  AddDetail( ({"portal", "nexus"}),
      "Ein breites Portal fuehrt in den Nexus.");
  AddDetail( ({"ausgang", "welt"}),
      "Ein kleiner Ausgang fuehrt hinaus in die luftige Welt Djinnistans.");
  AddDetail( ({"djinnistan"}),
      "So nennt man in Fachkreisen die Ebene der Luft.");
  AddDetail( ({"luft"}),
      "Luft gibt es hier viel, Du bist ja auch in der Ebene der Luft.");
  AddDetail( ({"ebene"}),
      "Ebene bedeutet hier keine Landschaftsform oder dass hier alles ganz "
      "flach ist ist. Vielmehr stellt man sich vor, dass die verschiedenen "
      "Ebenen wie die Stockwerke eines Hauses uebereinander liegen.");
  AddDetail( ({"stockwerk", "stockwerke", "haus"}),
      "So kann man es sich vorstellen.");
  AddDetail( ({"landschaftsform", "bedeutung"}),
      "Nein, diese Bedeutung von Ebene ist nicht gemeint.");
  AddDetail( ({"fachkreis", "fachkreise"}),
      "ZB bei den Druiden.");
  AddDetail( ({"druiden"}),
      "Druiden haben grosses Wissen ueber die Elemente. ");
  AddDetail( ({"elemente", "feuer", "wasser", "eis", "humus", "erz"}),
      "Die Elemente sind Feuer, Wasser, Eis, Humus, Erz und natuerlich Luft.");
  AddDetail( ({"macht", "verstaendnis", "wissen"}),
      "Die Macht der Druiden ueber die Elemente kommt aus dem Verstaendnis "
      "der Elementartheorie.");
  AddDetail( ({"elementartheorie"}),
      "Vereinfacht sagt die Elementartheorie, dass es sechs Elemente gibt, "
      "wobei sich jeweils zwei immer entgegengesetzt sind, zum Beispiel "
      "Erz und Luft.");
  AddDetail( ({"beispiel"}),
      "Ein anderes Beispiel ist Humus und Eis.");
  AddDetail( ({"nichts"}),
      "Du siehst hier nichts.");
  AddDetail( ({"gewuenschte"}),
      "Du solltest selber wissen, was Du wuenscht.");

  AddSmell( ({DEFAULT_SMELL}), 
      "Es riecht luftig.");
  AddSound( ({DEFAULT_SOUND, "kneipengeraeusche"}), 
      "Obwohl es sich hier um eine ganz seltsame Kneipe handelt, hoerst "
      "Du trotzdem die ueblichen Kneipengeraeusche.");

  AddExit ("raus", ([EX_MSG: "raus",
                     EX_FUNC: "raus"]) );
  AddExit ("nexus", ([EX_MSG: "zurueck in den Nexus",
                      EX_DEST: NEXUS]) );

  RemoveItem("/obj/topliste");
  AddDetail( ({"liste", "djinnistanliste", "topliste", "topdjinnistanliste", 
        "top-djinnistanliste"}), #'read_liste);
  AddReadDetail( ({"liste", "djinnistanliste", "topliste", "topdjinnistanliste", 
        "top-djinnistanliste"}), #'read_liste);
  SetProp(P_ZONE, "Djinnistan");
#include "../../where.h"
}

int flying(object pl)
{
  if(IS_LEARNING(TP))
    return 1;
  if(TP->is_class_member(CL_FLYING))
    return 1;
  return 0;
}

mixed raus(string verb)
{
  object ob;
  if(!flying(TP))
  {
    write(BS("Du musst schon Fliegen koennen, um da hinaus zu gehen. Sonst "
          "waere das der reine Selbstmord!"));
    return 1;
  }
  if(ob = find_living("luftkneipeneingang"))
    return file_name(ENV(ob));
  else
  {
    call_other(ROOM "luftraum:0:0:0", "reset");
    return ROOM "luftraum:0:0:0";
  }
}

string det_menu()
{
  TP->command_me("menue");
  return "";
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  return ::int_long(viewer, viewpoint, shortflag) +
    "Die Top-Djinnistanliste.\n";
}

string read_liste()
{
  write(
    "Die Liste der beruehmtesten Helden von Djinnistan\n"
    "-------------------------------------------------\n");
  ASTRALMASTER->FameList("djinnistan");
  return "";
}
