#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit STDROOM;

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_IN);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_AIR]) );
  SetProp(P_ELEMENTAL_ROOM, LUFT);

  SetProp(P_ZONE, "Djinnistan");
}

int flying(object pl)
{
  if(IS_LEARNING(TP))
    return 1;
  if(TP->is_class_member(CL_FLYING))
    return 1;
  return 0;
}

void init()
{
  ::init();
  if(objectp(TP) && interactive(TP) && !flying(TP))
  {
    write("Da Du nicht fliegen kannst, stuerzt Du ab und stirbst.\n");
    SetProp(P_KILL_NAME, "Ein Absturz aus unendlicher Hoehe");
    SetProp(P_KILL_MSG, "Wer Fliegen kann, ist im Vorteil!");
    TP->do_damage(10000, this_object());
  }
}
