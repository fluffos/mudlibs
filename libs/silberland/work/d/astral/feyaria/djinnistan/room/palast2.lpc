#include "../def.h"

inherit ROOM "std_luftraum";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Palast der Luefte");
  SetProp(P_INT_LONG,
      "Du stehst in einer gewaltigen Saeulenhalle, nur sind die Saeulen keine "
      "normalen Saeulen sondern richtige Wirbelstuerme, die aber fix an ihrem "
      "Platz bleiben. Die Wirbel werden in Richtung Sueden immer kleiner, "
      "im Norden bilden sie einen Halbkreis.");

  AddDetail( ({"boden"}),
      "Der Boden besteht nur aus Luft, Du wirst wohl abstuerzen, wenn Du "
      "nicht fliegen kannst.");
  AddDetail( ({"decke"}),
      "Die Decke dieses Palastes bildet der Himmel.");
  AddDetail( ({"himmel"}),
      "Der Himmel bildet die Decke dieses Palastes. Er besteht aus dichten "
      "Wolken.");
  AddDetail( ({"waende", "wand"}),
      "Waende kannst Du hinter den Saeulen nicht erkennen.");
  AddDetail( ({"saeulenhalle", "halle"}),
      "Die riesige Saeulenhalle besteht nicht aus normalen Saeulen, sondern "
      "aus Wirbelstuermen.");
  AddDetail( ({"saeulen", "saeule"}),
      "Die Saeulen sind eigentlich Wirbelstuerme.");
  AddDetail( ({"wirbelsturm", "wirbel", "sturm", "wirbelstuerme", "stuerme"}),
      "Die Wirbelstuerme bleiben fix an ihrem Platz und vermitteln so den "
      "Eindruck einer Saeulenhalle.");
  AddDetail( ({"platz"}),
      "Eine starke Magie muss die Wirbelstuerme an ihrem Platz halten. Du "
      "kannst foermlich die Energie spueren, die hier gebunden ist.");
  AddDetail( ({"richtung", "sueden"}),
      "In Richtung Sueden werden die Saeulen kleiner.");
  AddDetail( ({"wesen", "luftwesen"}),
      "Hier leben die Luftwesen, die diese Ebene beherrschen, die Djinnis.");
  AddDetail( ({"palast"}),
      "Dies ist der Palast der Luefte.");
  AddDetail( ({"luft", "ebene", "ebene der luft", "luefte"}),
      "Hier ist alles aus Luft, kein Wunder, da Du Dich ja auf der Ebene der "
      "Luft befindest.");
  AddDetail( ({"wolke", "wolken"}),
      "Der Himmel besteht hier aus dichten Wolken.");
  AddDetail( ({"wunder"}),
      "Eines der Wunder ist, dass Du noch nicht abgestuerzt bist.");
  AddDetail( ({"magie"}),
      "Es handelt sich wohl um elementare Luftmagie.");
  AddDetail( ({"energie"}),
      "In den gebunden Wirbelstuermen steckt eine gewaltige Energie!");
  AddDetail( ({"djinnis", "djinni", "djinne", "djinn"}),
      "Die Djinne sind die Herrscher ueber die Ebene der Luefte.");
  AddDetail( ({"luftmagie"}),
      "Nur Luftmagie ist maechtig genug, um einen Wirbelsturm an einen Ort "
      "zu binden.");
  AddDetail( ({"herrscher", "kalif"}),
      "Der Herrscher aller Luftwesen ist der Djinni Kalif.");
  AddDetail( ({"norden", "halbkreis"}),
      "Im Norden bilden die Saeulen einen Halbkreis, dort scheint der "
      "Herrscher dieses Palastes zu residieren.");
  AddDetail( ({"kreis"}),
      "Kein Kreis, nur ein Halbkreis.");
  AddDetail( ({"ort", "eindruck"}),
      "Dieser Ort macht einen starken Eindruck auf Dich.");

  AddSmell( ({DEFAULT_SMELL, "geruch"}), 
      "Es riecht luftig.");
  AddSound( ({DEFAULT_SOUND, "brausen", "wind"}), 
      "Du hoerst das Brausen des Windes.");

  AddExit( "sueden", ROOM "palast1");
  AddExit( "norden", ([
        EX_DEST: ROOM "palast3",
        EXG_ID: "djinni wesier",
        EXG_PLMSG: "Der Djinni Wesier laesst Dich nicht vorbei.\n",
        EXG_RMMSG: "Der Djinni Wesier laesst @wen@ nicht vorbei.\n"]) );
}

