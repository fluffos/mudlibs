// Der Sturmhammer
// 27.12.2004 Feyaria@SilberLand
// 12.10.2009: M_NOCHECK eingefuegt, damit die NPC zurueckkehren
// koennen -> Eros
#include "../def.h"

inherit "std/weapon";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Sturmhammer");
  SetProp(P_LONG,
    "Der Sturmhammer ist eine maechtige zweihaendige Waffe. An einem langen "
    "Stiel aus einem seltsamen Metall befindet sich ein maechtiger Hammerkopf, "
    "der staendig von Luftwirbeln umgeben ist. Man kann foermlich spueren, "
    "dass die Maechte des Sturmes in diese Waffe gebannt sind.");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Sturmhammer");
  AddId( ({"sturmhammer", "hammer"}) );
  SetProp(P_INFO,
      "Der Sturmhammer ist nicht nur eine maechtige Waffe, sondern schuetzt den "
      "Traeger auch noch etwas vor Luftangriffen.");

  SetProp(P_VALUE, 4000);
  SetProp(P_WEIGHT, 2500);
  SetProp(P_MATERIAL, ([ MAT_AIR:10, MAT_METAL:90 ]) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_AIR}) );
  SetProp(P_WC, 255);
  SetProp(P_WC_FIX, 15);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());
}


int WieldFunc(object waffe, int silent)
{
  MENV->AddResistanceModifier( ([DT_AIR:-0.1]) );
  return 1;
}

int UnwieldFunc(object waffe, int silent)
{
  QueryProp(P_WIELDED)->RemoveResistanceModifier();
  return 1;
}

int HitFunc(object enemy)
{
  if (!random(77))
  {
    call_out("wirbeln",0, enemy, QueryProp(P_WIELDED));
    return 200 + random(300);
  }
  return random(10);
}

void wirbeln(object enemy, object wer)
{
  if (!objectp(enemy) || !ENV(enemy) || !objectp(wer) || !ENV(wer))
    return;
  tell_object(enemy, "Eine maechtiger Sturm wirbelt Dich hinfort!\n");
  tell_room(ENV(enemy), BS("Die Macht des Sturmhammers wirbelt " +
      enemy->name(WEN) + " hinfort!"), ({enemy}) );
  enemy->move("/room/npcasylraum", M_TPORT, 
      "in die Luft gewirbelt", "wird", "wird heraufgewirbelt");
  call_out("move_back",2+2*random(2), enemy, ENV(wer));
}

void move_back(object enemy, object wohin)
{
  if(objectp(enemy) && objectp(wohin))
     enemy->move(wohin, M_TPORT|M_NOCHECK|M_NO_ATTACK, "wieder hinunter", "faellt",
              "faellt wieder herunter");
}

void reset()
{
  object wer;
  if (!is_clone(this_object())) return;
  ::reset();

  if (objectp(wer = QueryProp(P_WIELDED)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die luftige Energie des Sturmhammers heilt Dich.\n");
    wer->heal_self(77);
  }
}

