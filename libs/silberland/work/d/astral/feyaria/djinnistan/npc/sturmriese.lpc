// eine Sturmriese
// 01-04-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_luft_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Sturmriese");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein gewaltiger Sturmriese");
  SetProp(P_LONG, 
    "Diese gewaltige Gestalt kann nur einer der legendaeren Sturmriesen sein. "
    "Schon seine saeulenartigen Beine ueberragen Dich haushoch. Seine "
    "Haende und Fuesse sind von maechtigen Luftwirbeln umgeben, mit deren "
    "Hilfe er trotz seiner Masse hier schweben kann. Sein Kopf besteht aus "
    "einer schwarzen Wolke, aus der Dich zwei leuchtende Augen anblicken. "
    "Dieses Wesen ist wahrlich eine Verkoerperung der Ebene der Luft.");
  AddId(({"riese", "sturmriese"}));

  create_default_npc(45);
  SetProp(P_HANDS, 
      ({" mit der Kraft des Sturmes", 400, ({DT_AIR, DT_BLUDGEON}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_BODY, QueryProp(P_BODY) * 2);
  SetProp(P_RACE, "Riese");
  AddClass(CL_FLYING);
  SetProp(P_SIZE, 1500);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:0.05,   DT_BLUDGEON: 0.3, DT_RIP: 0.1, DT_PIERCE: 0.05,
        DT_AIR:-1, DT_SOUND:-1, DT_LIGHTNING:-1, DT_MAGIC:0.3])); 

  SetProp(P_MSGIN, "stuermt herein");
  SetProp(P_MSGOUT, "stuermt");
  SetProp(P_MMSGIN, "stuermt herein");
  SetProp(P_MMSGOUT, "stuermt weg");
  SetProp(P_MNPC_WAIT, ({ 60, 60, 60 }));

  SetProp(P_DIE_MSG,  " faellt tot um.\n"
      "Die Erschuetterung laesst Dich erzittern.\n");
  SetProp(P_KILL_MSG, "Die Macht des Sturmes ist unueberwindbar!");
  SetProp(P_MURDER_MSG, "Wie konntest Du die Macht des Sturmes ueberwinden, %s?");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
        "Der Sturmriese loest @WEN in Luft auf."}) );
  AddInfo(DEFAULT_INFO, "spricht mit donnernder Stimme.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(5, 1200,
      Name(WER,1)+" trifft Dich hammerhart.\n",
      Name(WER,1)+" trifft @WEN hammerhart.\n",
      ({DT_AIR, DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 800, 
      Name(WER,1)+ " wirbelt Dich durch die Luft.\n",
      Name(WER,1)+ " wirbelt @WEN durch die Luft.\n",
      ({DT_AIR}), "wegblasen", ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 500, DS_PARALYZE,
      Name(WER,1)+ " schlaegt Dich bewusstlos.\n",
      Name(WER,1)+ " schlaegt @WEN bewusstlos.\n",2);
      
  SetChats(1, ({
    "Der Sturmriese tritt beinahe auf Dich drauf.\n",
    "Du bestaunst die gewaltige Groesse des Sturmriesen.\n"}) );

  SUID;

  GEMMASTER->DistributeGem(3, 7, 1, 1, GEMARRAY);

}

