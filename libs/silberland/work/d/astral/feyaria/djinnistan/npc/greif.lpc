// ein Greif
// 10-03-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_luft_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Greif");
  SetProp(P_GENDER, MALE);
  switch( random(4) )
  {
    case 1:
      SetProp(P_NAME_ADJ, "majestaetisch");
      AddAdjective( ({"majestaetisch", "majestaetischer", "majestaetischen"}) ); 
      break;
    case 2:
      SetProp(P_NAME_ADJ, "gewaltig");
      AddAdjective( ({"gewaltig", "gewaltiger", "gewaltigen"}) ); 
      break;
    case 3: 
      SetProp(P_NAME_ADJ, "maechtig");
      AddAdjective( ({"maechtig", "maechtiger", "maechtigen"}) ); 
      break;
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Der Greif hat einen riesigen Loewenkoerper, aber die Fluegel, den "
    "Schnabel und die Krallen eines Adlers. Er ist eines der maechtigsten "
    "gefluegelten Lebewesen.");
  AddId(({"greif", "FEDER_WUSCHEL"}));

  AddDetail( ({"fluegel"}),
      "Der Greif hat Fluegel wie ein riesiger Adler.");
  AddDetail( ({"schnabel"}),
      "Der Schnabel des Greifs erinnert an einen Adler.");
  AddDetail( ({"krallen"}),
      "Der Greif hat statt den Pranken eines Loewen die Krallen eines Adlers.");

  create_default_npc(32);
  SetProp(P_HANDS, ({" mit seinem scharfen Schnabel", 350, ({DT_PIERCE}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Vogel");
  AddClass(CL_FLYING);
  SetProp(P_SIZE, 350);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:-0.2,    DT_MAGIC:0.2,  DT_BLUDGEON: 0.2,
        DT_AIR:-0.6,      DT_LIGHTNING:-0.5])); 

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weg");
  SetProp(P_MNPC_WAIT, ({ 30, 20, 20 }));

  SetProp(P_DIE_MSG,  " stuerzt toedlich verletzt zu Boden.\n");
  SetProp(P_KILL_MSG, "zerreisst mit Krallen und Schnabel die Leiche.");
  SetProp(P_MURDER_MSG, "Trotzdem bleibe ich der Koenig der Luefte, %s!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1]) );
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "kreischt Dich nur an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 60);
  AddSpell(4, 600,
    Name(WER,1)+" greift Dich mit Krallen und Schnabel zugleich an.\n",
    Name(WER,1)+" greift @WEN mit Krallen und Schnabel zugleich an.\n",
     ({DT_RIP, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1,200, DS_BLIND,
    Name(WER,1)+" zerkratzt Dein Gesicht.\n",
    Name(WER,1)+" zerkratzt @WESSEN Gesicht.\n");

  SetChats(1, ({
    Name(WER,1)+" flattert herum.\n",
    Name(WER,1)+" breitet seine gewaltigen Schwingen aus.\n",
    Name(WER,1)+" fliegt um Deinen Kopf.\n",
    Name(WER,1)+" kreischt laut.\n"}) );

  SUID;
  
}

