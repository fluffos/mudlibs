// eine Windhose
// 01-04-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_luft_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Orkan");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein zerstoererischer Orkan");
  SetProp(P_LONG, 
    "Dieser maechtige Orkan zerstoert alles was ihm in den Weg kommt. "
    "Er besteht aus gewaltigen Gewitterwolken und einem starken Sturm, "
    "der Dich leicht durch die Gegend blasen kann.");
  AddId(({"orkan"}));

  create_default_npc(40);
  SetProp(P_HANDS, 
      ({" mit Blitz und Donner", 370, ({DT_AIR, DT_SOUND, DT_LIGHTNING}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Elementar");
  AddClass(CL_FLYING);
  SetProp(P_SIZE, 2000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:0.05,   DT_BLUDGEON: 0.3, DT_RIP: 0.1, DT_PIERCE: 0.05,
        DT_AIR:-1, DT_SOUND:-1, DT_LIGHTNING:-1, DT_ELECTRIC:-1,
        DT_MAGIC:0.3, DT_UNHOLY: -0.5, DT_HOLY:-0.5])); 

  SetProp(P_MSGIN, "wirbelt herein");
  SetProp(P_MSGOUT, "wirbelt");
  SetProp(P_MMSGIN, "wirbelt herein");
  SetProp(P_MMSGOUT, "wirbelt weg");
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }));

  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_KILL_MSG, "wirbelt Deine Leiche wild durch die Luft.");
  SetProp(P_MURDER_MSG, "Das naechste Mal zerstoere ich Dich, %s!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1]) );
    
  SetProp(P_REJECT, ({ REJECT_DROP, ""}) );
  AddInfo(DEFAULT_INFO, "blaest Dich an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 80);
  AddSpell(15, 800,
      Name(WER,1)+" wirbelt Dich im Kreis herum.\n",
      Name(WER,1)+" wirbelt @WEN im Kreis herum.\n",
      ({DT_AIR}),([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 1500,
      "Ein Blitz schlaegt in Dir ein.\n",
      "Ein Blitz schlaegt in @WEM ein.\n",
      ({DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 800, 
      Name(WER,1)+ " blaest Dich weg.\n",
      Name(WER,1)+ " blaest @WEN weg.\n",
      ({DT_AIR}), "wegblasen", ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(10, 500, DS_DEAF,
      Name(WER,1)+ " erschreckt Dich mit einem gewltigen Donner.\n",
      Name(WER,1)+ " erschreckt @WEN mit einem gewltigen Donner.\n");
      


  SetChats(1, ({
    Name(WER,1)+" wirbelt herum.\n",
    Name(WER,1)+" verblaest Dich.\n"}) );

  SUID;

  GEMMASTER->DistributeGem(3, 7, 1, 1, GEMARRAY);

}

