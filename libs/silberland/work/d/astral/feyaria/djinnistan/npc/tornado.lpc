// eine Windhose
// 01-04-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_luft_npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Tornado");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein gewaltiger Tornado");
  SetProp(P_LONG, 
    "Ein gewaltiger Tornado zerstoert hier alles was ihm in den Weg kommt. "
    "Er besteht zwar nur aus Luft, aber trotzdem ist er sehr gefaehrlich.");
  AddId(({"tornado"}));

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit einem Luftwirbel", 330, ({DT_BLUDGEON, DT_AIR}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Elementar");
  AddClass(CL_FLYING);
  SetProp(P_SIZE, 450);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:0.1,   DT_BLUDGEON: 0.5, DT_RIP: 0.3, DT_PIERCE: 0.1,
        DT_AIR:-1, DT_MAGIC:0.3, DT_UNHOLY: -0.5, DT_HOLY:-0.5])); 

  SetProp(P_MSGIN, "wirbelt herein");
  SetProp(P_MSGOUT, "wirbelt");
  SetProp(P_MMSGIN, "wirbelt herein");
  SetProp(P_MMSGOUT, "wirbelt weg");
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }));

  SetProp(P_DIE_MSG,  " loest sich in Luft auf.\n");
  SetProp(P_KILL_MSG, "Die Macht des Sturmes ist unueberwindbar!");
  SetProp(P_MURDER_MSG, "Wie konntest Du die Macht des Sturmes ueberwinden, %s?");
  SetProp(P_REJECT, ({ REJECT_DROP, ""}) );
  AddInfo(DEFAULT_INFO, "blaest Dich an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 60);
  AddSpell(5, 700,
    Name(WER,1)+" wirbelt Dich im Kreis herum.\n",
    Name(WER,1)+" wirbelt @WEN im Kreis herum.\n",
     ({DT_AIR}),([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 700, 
      Name(WER,1)+ " blaest Dich weg.\n",
      Name(WER,1)+ " blaest @WEN weg.\n",
     ({DT_AIR}), "wegblasen", ([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    Name(WER,1)+" wirbelt herum.\n",
    Name(WER,1)+" verblaest Dich.\n"}) );

  SUID;

  GEMMASTER->DistributeGem(3, 4, 1, 1, GEMARRAY);

}

