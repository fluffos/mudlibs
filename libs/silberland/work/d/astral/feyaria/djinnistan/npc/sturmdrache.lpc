// Der Luftdrache
// 2004-04-13 Feyaria@SilberLand

#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells";

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  create_default_dragon(5,5,2,15+random(5));
  SetProp(P_SHORT, 
    "Aeroretzuquilloyaraxxi, der Sturmdrache");
  SetProp(P_LONG, 
    "Du musst fast Deine Augen abwenden, solch eine gleissende Erscheinung "
    "ist dieser Sturmdrache. Seine Schuppen glitzern wie reinste Diamanten "
    "und seine Fluegel schlagen so schnell, dass er einen richtigen Sturm "
    "erzeugt, daher sein Name.");
  SetProp(P_NAME, "Sturmdrache");
  AddId( ({"sturmdrache", "aeroretzuquilloyaraxxi"}) );
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_ARTICLE,1);

  SetProp(P_KILL_NAME, "Aeroretzuquilloyaraxxi, der Sturmdrache");
  SetProp(P_KILL_MSG, "Die Macht des Sturmes ist unueberwindbar!");
  SetProp(P_MURDER_MSG, "Wie konntest Du die Macht des Sturmes ueberwinden, %s?");

  AddDefaultSpell(1, 500, DS_MASS_BLIND,
    Name(WER,1)+" glitzert in hellstem Licht.\n",  
    Name(WER,1)+" glitzert in hellstem Licht.\n");

  GEMMASTER->DistributeGem(2, 4, 0, 1, "diamant");
}

void die(int poisondeath)
{
  write_file(LOG "drache", dtime(time())+": "+CAP(TP->query_real_name())+
      " killt den Sturmdrachen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "drache", dtime(time())+": Der Sturmdrache hat gerade "+
      CAP(player->query_real_name())+ " umgebracht. (-"+lostexp+" XP)\n");
}

