// std-npc fuer djinnistan
// 10-03-2004  Feyaria@SilberLand

#include "../def.h"

inherit STDNPC;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"\ndjinnistannpc"}) );
  SetProp(P_LOG_INFO, "feyaria/djinnistan");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "luftraum:0:0:0") );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  if( QueryProp(P_HP) == QueryProp(P_MAX_HP) && !random(10) )
  {
    move("/room/npcasylraum", M_TPORT);
    deep_remove();
  }
}

void wegblasen(object enemy, int damage, mixed dam_type)
{
  string dir;
  dir = m_indices(QueryProp(P_EXITS))[random(sizeof(QueryProp(P_EXITS)))];
  tell_object(enemy, "Du fliegst nach " + capitalize(dir) + ".\n");
  enemy->move(QueryProp(P_EXITS)[dir], M_GO);
}

int Defend(int dam, string *dtype, int spell, object enemy)
{
  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (member(dtype, DT_AIR) != -1)
  {
    ENV(TO)->Message(Name(WER,1) + " saugt die Luft in sich auf und wird "
        "staerker !\n", MSGFLAG_VISUAL);
    heal_self(dam/10);
    return ::Defend(0, dtype, spell, enemy);
  }
  return ::Defend(dam, dtype, spell, enemy);
}

