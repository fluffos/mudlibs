// Helm fuer Unterwasseratmen
// 08.04.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Die Luftmaske");
  SetProp(P_LONG, 
    "Diese Maske besteht aus magischer Luft. Wenn man sie aufsetzt, bedeckt "
    "sie Mund und Nase komplett, ob man dann die magische Luft atmen kann, "
    "aus der sie besteht?");
  SetProp(P_NAME, "Luftmaske");
  SetProp(P_GENDER, FEMALE);
  AddId (({"maske", "luftmaske", "\ndjinnistanluftmaske"}) );
  SetProp(P_INFO,
      "Diese Maske erlaubt es Dir, ueberall zu atmen!\n");

  AddDetail( ({"luft"}),
      "Die Luft dieser Maske ist hochgradig magisch.");
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_AIR: 100]) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 2000);
  SetProp(P_MAGIC, 5);
  SetProp(P_QUALITY_DECAY, 1500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 1, P_SP: 1]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_AIR: 2]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([LUFT: 4+random(4)]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);

  SUID;
}

int WearFunc(object me)
{
  object ob;

  environment()->AddResistanceModifier( ([DT_AIR:-0.05]) );
  while(ob = present("\nastralwaterbreather",  environment()))
    ob->remove();
  CLONE(OBJ "waterbreath", environment());
  return 1;
}

int RemoveFunc(object me)
{
  object ob;
  if(ob = present("\nastralwaterbreather", QueryProp(P_WORN)))
    ob->ende();
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Frische Luft aus der Luftmaske dringt in Deine Lungen und heilt Dich.\n");
    wer->heal_self(44);
  }
}

