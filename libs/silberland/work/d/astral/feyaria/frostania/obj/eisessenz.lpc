// Eisessenz fuer Eingang zum Palast
// 26.6.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Essenz des Frostes");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Die Essenz des Frostes");
  SetProp(P_LONG,
      "Die Essenz der Frostes ist ein maechtiges Artefakt und besteht aus "
      "kaeltestem Eis. Wofuer mag sie wohl gut sein?"); 
  AddId( ({"essenz", "frostessenz", "essenz frostes",
        "essenz des frostes", "\neispalastkey2"}) );
  SetProp(P_INFO, BS(
      "Die Essenz des Frostes wird fuer den Zugang zum Palast des "
      "Eises benoetigt. Allerdings brauchst man dazu noch "
      "das Symbol des Eises und den Kristall der Kaelte. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Eises oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_MAGIC, 1);
}

