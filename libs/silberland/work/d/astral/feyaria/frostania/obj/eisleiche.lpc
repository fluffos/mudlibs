// std-leiche fuer inferno
// 10-06-2004  Feyaria@SilberLand

inherit "std/corpse";

#include "../def.h"

void create()
{
  object killer;
  object ob;
  int level;

  if (!is_clone(TO)) return;
  ::create();

  SUID;
  if (!PO || PO->QueryProp("got_loot"))
    return;

  level = PO->QueryProp(P_LEVEL);
  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object(1);
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "frostania", level);

  PO->SetProp("got_loot", 1);
  if (strstr(file_name(PO), "khan") != -1)
  {
    if (objectp(killer))
    {
      ASTRALMASTER->AddFlag(killer, FLAG_KHAN,
          filter_array(PO->PresentEnemies(), #'interactive));
      write_file( LOG "khan.kills",
          dtime(time())+": "+CAP(getuid(killer))+" toetet "+PO->name(WEN)+".\n");
    }
    ob = clone_object( DAO_EQUIP );
    ob->set_khan();
    ob->move(PO, M_NOCHECK);
    BOSS_LOOT;
    ASTRALMASTER->SetTime("frostania");
  }
  else if (strstr(file_name(PO), DAO) != -1 && !random(DAO_CHANCE))
    CLONELOG( DAO_EQUIP, PO )
  else if (!random(STIEFEL_CHANCE) ||
      (level >= 40 && !random(RARE_STIEFEL_CHANCE)))
    CLONELOG( ARMOUR "gletscherstiefel", PO)
  else if (level >= 35 && !random(ICESPEAR_CHANCE))
    CLONELOG( WEAPON "frostbrand", PO)
  else if (!random(KEY_CHANCE - level * level / 50))
    CLONELOG( OBJ + ({"eisessenz", "eiskristall", "eissymbol"})[random(3)], PO)
  else if (!random(SALBE_CHANCE))
    CLONELOG( OBJ "eissalbe", PO)
  else if (!random(WSALBE_CHANCE))
    CLONELOG( WSALBE, PO )
  else if (!random(RSALBE_CHANCE))
    CLONELOG( RSALBE, PO )
  MAGIC_WANDS
  else if (random(2))
  {
    object geld;
    geld = clone_object("/obj/money");
    geld->AddAmount(level + random(level * MONEY_FACTOR));
    geld->move(PO, M_NOCHECK);
  }
  else
  {
    geld = clone_object(EISFRAGMENT);
    geld->AddAmount(random(level / 2));
    geld->move(PO, M_NOCHECK);
  }
}
