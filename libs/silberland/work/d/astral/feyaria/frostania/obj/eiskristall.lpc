// Eiskristall fuer Eingang zum Palast
// 24.6.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, ({"Kristall der Kaelte",
                    "Kristalls der Kaelte",
                    "Kristall der Kaelte",
                    "Kristall der Kaelte"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Der Kristall der Kaelte");
  SetProp(P_LONG,
      "Der Kristall der Kaelte ist ein maechtiges Artefakt und besteht "
      "aus kaeltestem Eis. Wofuer mag er wohl gut sein?");
  AddId( ({"kristall", "kaeltekristall", "kristall kaelte",
        "kristall der kaelte", "\neispalastkey1"}) );
  SetProp(P_INFO, BS(
      "Der Kristall der Kaelte wird fuer den Zugang zum Palast des "
      "Eises benoetigt. Allerdings brauchst man dazu noch "
      "die Essenz des Frostes und das Symbol des Eises. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Eises oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_MAGIC, 1);

  AddCmd("oeffne", "cmd_oeffnen");
}

int cmd_oeffnen(string str)
{
  object ob1, ob2;

  if (objectp(ob1 = present("\neispalastkey2")) && 
      objectp(ob2 = present("\neispalastkey3")) && 
      ENV(TP) && strstr(file_name(ENV(TP)), "frostania/room/eisraum") != -1)
  {
    if(member( ({"zugang", "zugang zum palast", "zugang zum palast eises"}), 
          str) != -1)
    {
      if (ASTRALMASTER->QueryTime("frostania") > 0)
      {
        write(BS("Du versuchst, den Zugang zum Palast des Eises zu oeffnen, "
              "aber irgendwie funkioniert das nicht. Scheinbar ist der Dao "
              "Khan nicht in seinem Palast."));
        return -1;
      }
      call_other(ROOM "palast1", "???");
      if (sizeof(find_object(ROOM "palast1")->QueryProp(P_EXITS)) > 1)
      {
        write("Der Palast wurde bereits betreten!\n");
        return -1;
      }
      write(BS("Du haeltst das Symbol des Eises in die Hoehe, sodass es in "
            "Augenhoehe vor Dir schwebt. Dannn nimmst Du den Kristall der "
            "Kaelte und die Essenz des Frostes in die ausgestreckten Arme und "
            "laesst Deine Magie fliessen."));
      say(BS(TPN + " haelt das Symbol des Eises in die Hoehe, sodass es in "
            "Augenhoehe vor " + TP->QueryPronoun(WEM) + " schwebt. Dannn nimmt "+
            TP->QueryPronoun(WER) + " den Kristall der Kaelte und die Essenz des "
            "Frostes in die ausgestreckten Arme und laesst " +
            TP->QPP(FEMALE, WEN, SINGULAR)+ " Magie fliessen."));
      tell_room(ENV(TP),"\nDas Portal zum Palast des Eises oeffnet sich.\n\n");
      CLONE(OBJ "portal", ENV(TP));
      find_object(ROOM "palast1")->AddExit("raus", file_name(ENV(TP)));
      ob1->remove();
      ob2->remove();
      TP->AddSp(-400);
      call_out("remove", 0);
      return 1;
    }
    notify_fail("Willst Du vielleicht den Zugang zum Palast des Eises oeffnen?\n");
    return 0;
  }
  return 0;
}
