// Waffensalbe
// 15.6.2004 - Feyaria@SilberLand

inherit "std/thing";

#include "../def.h"

#define MAX_QD 500

int salbe;

mapping adj = ([
 0 : "farblos"; " der Negation"; 0; 0,
 1 : "golden"; " der Macht"; 0; 0, 
 2 : "silbern"; " der Genauigkeit"; 0; 0, 
 3 : "rot"; " der Flammen"; DT_FIRE; 0,
 4 : "blau"; " der Wellen"; DT_WATER; 0,
 5 : "gruen"; " der Kobra"; DT_POISON; 0,
 6 : "weiss"; " der Kaelte"; DT_COLD; 0,
 7 : "braun"; " der Wolken"; DT_AIR; 0,
 8 : "violett"; " des Donners"; DT_SOUND; 0,
 9 : "orangen"; " des Blitzes"; DT_LIGHTNING; 0,
10 : "purpurn"; " des Stromes"; DT_ELECTRIC; 0,
11 : "hell"; " des Paladins"; DT_HOLY; 0,
12 : "dunkl"; " des Nekromanten"; DT_UNHOLY; 0,
13 : "schwarz"; " des Schwefels"; DT_ACID; 0,
14 : "zyan"; " der Macht"; DT_EXPLOSION; 0,
15 : "grau"; " des Schreckens"; DT_TERROR; 0,
16 : "bunt"; " der Magie"; DT_MAGIC; 0,
17 : "beig"; " des Geistes"; DT_MIND; 0,
18 : "gelb"; " der Sonne"; DT_LIGHT; 0,
19 : ""; " des Menschenschlaechters"; "human"; "(Menschentoeter)", 
20 : ""; " des Elfenschlaechters"; "elf"; "(Elfentoeter)", 
21 : ""; " des Zwergenschlaechters"; "dwarf"; "(Zwergentoeter)", 
22 : ""; " des Feenschlaechters"; "fairy"; "(Feentoeter)", 
23 : ""; " des Hobbitschlaechters"; "hobbit"; "(Hobbittoeter)", 
24 : ""; " des Trollschlaechters"; "troll"; "(Trolltoeter)", 
25 : ""; " des Ogerschlaechters"; "ogre"; "(Ogertoeter)", 
26 : ""; " des Orkenschlaechters"; "orc"; "(Orktoeter)", 
27 : ""; " des Goblinschlaechters"; "goblin"; "(Goblintoeter)", 
28 : ""; " des Gaffoschlaechters"; "gaffo"; "(Gaffotoeter)", 
29 : ""; " des Dunkelelfenschlaechters"; "darkelf"; "(Dunkelelfentoeter)", 
30 : ""; " des Sarnakschlaechters"; "sarnak"; "(Sarnaktoeter)", 
31 : ""; " des Baerenschlaechters"; "bear"; "(Baerentoeter)", 
32 : ""; " des Wolfschlaechters"; "wolf"; "(Wolfstoeter)", 
33 : ""; " des Katzenschlaechters"; "cat"; "(Katzentoeter)", 
34 : ""; " des Echsenschlaechters"; "lizard"; "(Echsentoeter)", 
35 : ""; " des Froschschlaechters"; "frog"; "(Froschtoeter)", 
36 : ""; " des Vogelschlaechters"; "bird"; "(Vogeltoeter)", 
37 : ""; " des Gnomschlaechters"; "gnom"; "(Gnomtoeter)", 
38 : ""; " des Fischschlaechters"; "fish"; "(Fischtoeter)", 
39 : ""; " des Insektenschlaechters"; "insect"; "(Insektentoeter)", 
40 : ""; " des Wurmschlaechters"; "worm"; "(Wurmtoeter)", 
41 : ""; " des Koboldschlaechters"; "kobold"; "(Koboldtoeter)", 
42 : ""; " des Spinnenschlaechters"; "spider"; "(Spinnentoeter)", 
43 : ""; " des Skelettschlaechters"; "skeleton"; "(Skelettvertilger)", 
44 : ""; " des Zombieschlaechters"; "zombie"; "(Zombievertilger)", 
45 : ""; " des Vampirschlaechters"; "vampir"; "(Vampirvertilger)",
46 : ""; " des Geisterschlaechters"; "ghost"; "(Geistervertilger)", 
47 : ""; " des Riesenschlaechters"; "giant"; "(Riesentoeter)", 
48 : ""; " des Golemschlaechters"; "golem"; "(Golemzerstoerer)", 
49 : ""; " des Untotenschlaechters"; "undead"; "(Untotenvertilger)", 
50 : ""; " des Elementarschlaechters"; "elemental"; "(Elementartoeter)", 
51 : ""; " des Daemonenschlaechters"; "demon"; "(Daemonenvertilger)", 
52 : ""; " des Drachenschlaechters"; "dragon"; "(Drachentoeter)", 

]);

void create()
{
  string short_id; 
  if (!is_clone(this_object())) return;
  ::create();
  
  switch (random(100))
  {
    case 0..19: 
      salbe = 0; 
      SetProp(P_INFO, BS(
          "Diese Salbe loest magische Schaeden, Spezialschaden gegen bestimmte "
          "Gegner und Verfluchungen auf einer Waffe wieder auf."));
      break;
    case 20..22:
      salbe = 1;
      SetProp(P_INFO, BS("Diese Salbe bannt astrale Energie in eine Waffe."));
      break;
    case 23..31:
      salbe = 2;
      SetProp(P_INFO, BS(
          "Diese Salbe laesst Dich mit der Waffe genauer zuschlagen."));
      break;
    case 32..59: 
      salbe = 3 + random(16); 
      SetProp(P_INFO, BS(
            "Diese Salbe verleiht einer Waffe magischen Schaden."));
      break;
    case 60..99: 
      salbe = 19 + random(29) + !random(5) * random(6); // die letzen 5 salben sind seltener
      SetProp(P_INFO, BS(
            "Diese Salbe verleiht einer Waffe zusaetzlichen Schaden gegen "
            "bestimmte Gegner."));
      break;
  }
    
  SetProp(P_NAME, "Waffensalbe" + adj[salbe,1]);
  if (strlen(adj[salbe]))
  {
    SetProp(P_NAME_ADJ, adj[salbe]);
    AddAdjective( ({adj[salbe], adj[salbe] + "e", adj[salbe] + "er",
                    adj[salbe] + "en", adj[salbe] + "em"}) );
  }
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    "Ein kleines Doeschen mit etwas Salbe. Sie stinkt fuerchterlich und "
    "ist ziemlich oelig, wahrscheinlich ist sie eher fuer eine Waffe "
    "geeignet als fuer Deine Haut.");
  AddId( ({"salbe", "waffensalbe", "\nwaffensalbe", }) );
  if (stringp(adj[salbe,1])) {
    AddId( "waffensalbe" + lower_case(adj[salbe,1]) );
    if(sizeof(explode(adj[salbe,1], " ")) == 2) {
      short_id=lower_case(explode(adj[salbe,1], " ")[1]);
      short_id=short_id[0..(strlen(short_id)-2)]+"waffensalbe";
      AddId( short_id );
    }
  }
  
  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT, 50);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_CERAMIC: 10, MAT_MISC_MAGIC: 90]) );
  SetProp(P_NOBUY, 1);
  
  AddCmd( ({"schmiere", "schmier"}), "cmd_schmieren");  
}

int cmd_schmieren(string str)
{
  string was, womit;
  object ob, hf;
  string n, n1, n2;
  
  notify_fail("Was willst Du mit " + name(WEM,1) + " einschmieren?\n");
  if (!str) 
    return 0;
  str = lower_case(TP->_unparsed_args());
  if (sscanf(str, "%s mit %s ein", was, womit) != 2)
    return 0;
  if (!id(womit))
  {
    notify_fail("Aber Du hast ja gar kein " + CAP(womit) + "!\n");
    return 0;
  }
  if (!objectp(ob = present(was, TP)))
  {
    notify_fail("Aber Du hast ja gar kein " + CAP(was) + "!\n");
    return 0;
  }

  if (!ob->QueryProp(P_WEAPON_TYPE))
  {
    write("Du kannst nur Waffen mit dieser Salbe einschmieren!\n");
    return 1;
  }
  if (ob->QueryProp(P_WEAPON_TYPE) == WT_MISC ||
      (salbe > 0 && ob->QueryProp("waffenbalsam") >= 10) ||
      (salbe == 0 && !((objectp(ob->QueryProp(P_HIT_FUNC)) && 
                        file_name(ob->QueryProp(P_HIT_FUNC))[0..32] == ITEMD_HFC) || 
                       sizeof(ob->QueryProp(P_DAM_TYPE) & m_indices(MAGICAL_DAMAGE_TYPES)) ||
                       ob->QueryProp(P_CURSED))) ||
      (salbe == 1 && mappingp(ob->QueryProp(P_M_HEALTH_MOD))) ||
      (salbe == 2 && ob->QueryProp(P_WC_FIX) > 90 - 20 * ob->QueryProp(P_HANDS)) ||
      (salbe > 2 && salbe < 19 && 
       sizeof(ob->QueryProp(P_DAM_TYPE) & m_indices(MAGICAL_DAMAGE_TYPES))) ||
      (salbe >= 19 && (ob->QueryProp(P_HIT_FUNC) ||
                       file_name(ob)[0..37] == SOCKET_WEAPON)) )
  {
    write(BS(Name(WER,1) + " wuerde auf "+ ob->name(WEM) +" keine Wirkung "
          "haben!"));
    return 1;
  }
  if (salbe != 0 && ob->QueryProp("balsam_time") && 
      ob->QueryProp("balsam_time") > time())
  {
    write("So oft kannst Du keine Waffe mit einer Salbe einschmieren!\n");
    return 1;
  }

  write(BS("Du schmierst " + ob->name(WEN) + " mit " + name(WEM) + " ein."));
  say(BS(TP->Name(WER, 1) + " schmiert " + ob->name(WEN) + " mit " +
    name(WEM) + " ein."));

  if (salbe == 0)
  {
    if (ob->QueryProp(P_CURSED))
    {
      write(BS(ob->Name(WER,1) + " wird entflucht."));
      ob->SetProp(P_CURSED, 0);
    }
    else
    {
      if (stringp(n = ob->QueryProp(P_NAME)) &&
          sscanf(n, "%s (%s)", n1, n2) == 2 )
        ob->SetProp(P_NAME, n1);
      if (sscanf(ob->QueryProp(P_SHORT), "%s (%s)", n1, n2) == 2 )
        ob->SetProp(P_SHORT, n1);
      if (objectp(ob->QueryProp(P_HIT_FUNC)) && 
          file_name(ob->QueryProp(P_HIT_FUNC))[0..32] == ITEMD_HFC)
        ob->SetProp(P_HIT_FUNC, 0);
      ob->SetProp(P_DAM_TYPE, 
          ob->QueryProp(P_DAM_TYPE) - m_indices(MAGICAL_DAMAGE_TYPES) );
      if (ob->QueryProp("waffenbalsam") > 0)
        ob->SetProp("waffenbalsam", ob->QueryProp("waffenbalsam") - 1);
      write(BS("Einige magische Veraenderungen von " + ob->name(WEM,1) + 
            " verschwinden."));
    }
  }
  else if (salbe == 1)
  {
    ob->SetProp(P_M_HEALTH_MOD, ([P_HP: 1 + random(4), P_SP: 2 + random(6)]) );
    ob->SetProp("waffenbalsam", ob->QueryProp("waffenbalsam") + 1);
    write(BS( "Astrale Energie fliesst in " + ob->name(WEN,1) + "."));
    if(objectp(ob->QueryProp(P_WIELDED)))
      ob->QueryProp(P_WIELDED)->UpdateAttributes();
  }
  else if (salbe == 2)
  {
    ob->SetProp(P_WC_FIX, ob->QueryProp(P_WC_FIX) + 2 + random(6));
    ob->SetProp("waffenbalsam", ob->QueryProp("waffenbalsam") + 1);
    write(BS( ob->Name(WER,1) + " liegt nun besser in der Hand."));
  }
  else if (salbe > 2 && salbe < 19)
  {
    ob->SetProp(P_DAM_TYPE,  ob->QueryProp(P_DAM_TYPE) + ({adj[salbe,2]}));
    ob->SetProp("waffenbalsam", ob->QueryProp("waffenbalsam") + 1);
    ob->SetProp("waffenkunde", 0);
    write(ob->Name(WER,1) + " wird von einer " + adj[salbe] + "en Aura "
        "umhuellt.\n");
  }
  else if (salbe >= 19 )
  {
    call_other(ITEMD_HFC + adj[salbe,2], "???");
    hf = find_object(ITEMD_HFC + adj[salbe,2]);
    ob->SetProp(P_HIT_FUNC, hf);
    if (stringp(n = ob->QueryProp(P_NAME)))
      ob->SetProp(P_NAME, n + " " + adj[salbe,3]);
    ob->SetProp(P_SHORT, ob->QueryProp(P_SHORT) + " " + adj[salbe,3]);  
    ob->SetProp("waffenbalsam", ob->QueryProp("waffenbalsam") + 1);
    write(BS(ob->Name(WER,1) + " macht nun besonders viel Schaden gegen "
        "bestimmte Gegner."));
  }

  if (ob->QueryProp(P_QUALITY_DECAY) > 0 && 
      ob->QueryProp(P_QUALITY_DECAY) < MAX_QD)
    ob->SetProp(P_QUALITY_DECAY, 
        ob->QueryProp(P_QUALITY_DECAY) + 10 + random(11));
      
  if (ob->QueryProp(P_WC) + ob->QueryProp(P_DAMAGED) < MAX_WEAPON_CLASS - 15 - 
      100 * (ob->QueryProp(P_NR_HANDS) == 1))
    ob->SetProp(P_WC, ob->QueryProp(P_WC) + random(5));

  ob->SetProp(P_VALUE, ob->QueryProp(P_VALUE) + 50 + random(100));

  ob->SetProp("balsam_time", time() + 60 * 10);
  tell_room(ENV(TP),BS(
        sprintf("%s schmiert %s mit %s ein.", capitalize(TPN), ob->name(WEN,1),
          name(WEM,0))), ({TP}));
  DB(sprintf("salbe = %d\nwaffe = %O\nplayer = %O\nhitfunc = %O\ndtype = %O\n", 
        salbe, ob, TP, ob->QueryProp(P_HIT_FUNC), ob->QueryProp(P_DAM_TYPE)));
  remove();
  return 1;    
}

