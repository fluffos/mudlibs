// Feuersymbol fuer Eingang zum Palast
// 10.6.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Symbol des Eises");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Das Symbol des Eises");
  SetProp(P_LONG,
      "Das Symbol des Eises ist ein maechtiges Artefakt und besteht "
      "vollstaendig aus kaeltestem Eis. Wofuer mag es wohl gut sein?");
  AddId( ({"symbol", "eissymbol", "symbol eises", 
        "symbol des eises", "\neispalastkey3"}) );
  SetProp(P_INFO, BS(
      "Das Symbol des Eises wird fuer den Zugang zum Palast des "
      "Eises benoetigt. Allerdings brauchst man dazu noch den "
      "Kristall der Kaelte und die Essenz des Frostes. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Eises oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_MAGIC, 1);
}

