// Stiefel zum fliegen
// 21.06.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

int flying;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Gefluegelte Gletscherstiefel");
  SetProp(P_LONG, 
    "Diese Stiefel bestehen aus Eis, und haben kleine Fluegeln an der Seite. "
    "Ob sie gross genug zum fliegen sind?");
  SetProp(P_NAME, "Gletscherstiefel");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"stiefel", "gletscherstiefel", "\nfrostaniagletscherstiefel"}) );

  AddDetail( ({"eis"}),
      "Das Eis dieser Stiefel ist hochgradig magisch.");
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_ICE: 100]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 2000);
  SetProp(P_MAGIC, 5);
  SetProp(P_QUALITY_DECAY, 1500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 4, T_HEAT_PROT: -5]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 1, P_SP: 1]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_COLD: 2]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([EIS: 4+random(4)]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);

  SUID;
}

int WearFunc(object ruest, int silent)
{
  if(!MENV->is_class_member(CL_FLYING))
  {
    flying = 1;
    MENV->AddClass(CL_FLYING);
    tell_object(MENV, 
        "Mit Hilfe der Gletscherstiefel kannst Du nun fliegen!\n");
  }
  MENV->AddResistanceModifier( ([DT_COLD:-0.05]) );
  return 1;
}

int RemoveFunc(object ruest, int silent)
{
  if(flying)
  {
    QueryProp(P_WORN)->RemoveClass(CL_FLYING);
    flying = 0;
  }
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Gletscherstiefel leuchten auf und heilen Dich.\n");
    wer->heal_self(44);
  }
}

