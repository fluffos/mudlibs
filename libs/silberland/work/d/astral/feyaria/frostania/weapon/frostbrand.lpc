// Frostbrand, das eisige Schwert
// 27.12.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Frostbrand, das eisige Schwert");
  SetProp(P_LONG,
    "Frostbrand ist ein Schwert ganz aus Eis. Die Spitze sieht fast aus wie ein "
    "Eiszapfen, allerdings wie ein sehr spitzer. "
    "Sicher muss man sehr maechtig sein, um diese Waffe fuehren zu koennen.");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Frostbrand");
  AddId( ({"frostbrand", "schwert"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_INFO,
      "Frostband ist nicht nur eine maechtige Waffe, sondern schuetzt den "
      "Traeger auch noch etwas vor Kaelteangriffen.");

  AddDetail( ({"eis"}),
    "Frostbrand besteht aus niemals schmelzendem Eis.");

  SetProp(P_VALUE, 4000);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_MATERIAL, ([ MAT_ICE:100 ]) );

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_COLD}) );
  SetProp(P_WC, 240);
  SetProp(P_WC_FIX, 40);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());
}


int WieldFunc(object waffe, int silent)
{
  MENV->AddResistanceModifier( ([DT_COLD:-0.1]) );
  return 1;
}

int UnwieldFunc(object waffe, int silent)
{
  QueryProp(P_WIELDED)->RemoveResistanceModifier();
  return 1;
}

int HitFunc(object enemy)
{
  return random(10);
}

void reset()
{
  object wer;
  if (!is_clone(this_object())) return;
  ::reset();

  if (objectp(wer = QueryProp(P_WIELDED)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die eisige Energie von Frostbrand heilt Dich.\n");
    wer->heal_self(77);
  }
}

