// Der Schneefresser
// 22.6.2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_eis_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Schneefresser");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    "Der Schneefresser ist ein langer, weisser Wurm, der staendig "
    "Schnee in sein gewaltiges Maul schiebt. Scheinbar ernaehrt er sich "
    "davon.");
  AddId( ({"schneefresser", "fresser", "wurm"}) );

  create_default_npc(28);
  SetProp(P_HANDS, ({" mit seinem gewaltigen Maul", QueryProp(P_HANDS)[1],
      DT_RIP}));
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_COLD: -1.0, DT_FIRE:0.5, DT_POISON:0.5,
      DT_MAGIC: -0.3, DT_TERROR: -0.5, DT_ACID: -0.2,
      DT_SLASH: -0.2, DT_PIERCE: -0.2, DT_BLUDGEON: -0.2]) );

  SetProp(P_MSGIN, "windet sich herein");
  SetProp(P_MSGOUT, "windet sich");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));

  SetProp(P_DIE_MSG, " wird nie wieder Schnee fressen!\n");
  SetProp(P_KILL_MSG, "In diesem eisigen Reich fressen nur ich!");
  SetProp(P_MURDER_MSG, "Wehe Du frisst mir jetzt meinen Schnee weg, %s!");
  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" frisst @WEN auf.\n"}));

  SetChats(1, ({
    Name(WER,1)+" frisst Schnee.\n"}) );

  SetProp(P_SPELLRATE, 50);
  AddSpell(5, 700,
    Name(WER,1)+" beisst Dir fast den Kopf ab.\n",
    Name(WER,1)+" beisst @WEM fast den Kopf ab.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 950, 
    Name(WER,1)+" ueberschuettet Dich mit Schnee.\n",
    Name(WER,1)+" ueberschuettet @WEN mit Schnee.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 950, DS_SLOW,
    Name(WER,1)+" friert Dich ein.\n",
    Name(WER,1)+" friert @WEN ein.\n");

  SUID;
}

