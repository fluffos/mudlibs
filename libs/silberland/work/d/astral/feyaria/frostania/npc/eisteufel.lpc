// Ein kleiner Eisteufel
// 25.6.2004 Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_eis_npc";

#define EISWAND OBJ "eiswand"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp (P_SHORT, "Ein kleiner Eisteufel");
  SetProp (P_LONG, "Der kleine Eisteufel ist zwar nicht gerade der "
      "groesste, aber seine roten Augen starren Dich feindselig und "
      "furchteinfloessend an, sodass Dir ganz mulmig zumute wird. "
      "Ein irres Grinsen liegt auf seinem Gesicht, Du bist Dir nicht "
      "sicher, ob es Wahnsinn oder Vorfreude auf seine Opfer ist...");
  SetProp (P_NAME, "Eisteufel");
  SetProp (P_GENDER, MALE);
  AddId ( ({"teufel","eisteufel"}) );
  SetProp (P_INFO,
      "Der Eisteufel kann Fluchtwege mit Eiswaenden versperren.\n");

  create_default_npc(20+random(4));
  SetProp (P_ALIGN, -100-random(100));
  SetProp (P_AGGRESSIVE, 0.2);
  SetProp (P_XP, QueryProp(P_XP)+100000);  // Spell-Bonus
  SetProp (P_HEAL, -30);
  SetProp (P_SIZE, 130+random(15));
  SetProp (P_RACE, "Elementar");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seinen eisigen Krallen", 200, ({DT_RIP, DT_COLD}) }) );

  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_FIRE:      0.5, DT_COLD:     -1.0, DT_WATER:  -0.5,
       DT_LIGHT:    -0.3, DT_TERROR:   -0.5, DT_POISON:  0.5]) );

  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft");

  SetProp (P_SPELLRATE, 25);

  AddSpell(3, 350,
    "Der Eisteufel wirft einen Eisball nach Dir.\n",
    "Der Eisteufel wirft einen Eisball nach @WEM.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]) );

  // Eiswand aufbauen
  AddSpell(1, 1, "", "", DT_COLD, "eiswand");

  SetProp (P_DIE_MSG, " zerfaellt in kleine Eisstuecke.\n");
  SetProp(P_KILL_MSG, "Jetzt bist Du eiskalt!");
  SetProp(P_MURDER_MSG, "%s hat mich eiskalt erwischt!");
  SetProp (P_DEFAULT_INFO, "sagt: Kuemmert mich nicht!\n");


  SetProp (P_REJECT, ({ REJECT_KEEP,
    "Der Eisteufel bedankt sich fuer @WEN.\n" }) );

  SUID;
}

void eiswand(object enemy, int damage, mixed dam_type)
{
  object wall;
  string *dirs, *opendirs, wo;
  int i;

  dirs=m_indices(environment()->QueryProp(P_NEW_EXITS));
  opendirs=({});
  for (i=sizeof(dirs)-1; i>=0; i--)
    if (!present("Eiswand im "+dirs[i],environment()))
      opendirs += ({ dirs[i] });
  if (!sizeof(opendirs)) return;

  wall=clone_object(EISWAND);
  wo=wall->SetDirection(opendirs[random(sizeof(opendirs))]) || "";
  wall->move(environment(), M_NOCHECK);
  tell_room(environment(),
      "Der Eisteufel errichtet eine Eiswand"+wo+"!\n");
}

