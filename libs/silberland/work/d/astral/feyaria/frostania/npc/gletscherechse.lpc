// Eine Gletscherechse
// 22.6.2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_eis_npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Gletscherechse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    "Die Gletscherechse hat eine eisblaue, schimmernde Schuppenhaut und "
    "dunkelblaue, gluehende Augen. Sie liebt die Kaelte, denn sie scheint "
    "sich von Eis zu ernaehren. Das ist sehr ungewoehnlich fuer ein Reptil, "
    "allerdings bist Du Dir fast sicher, dass es sich hier eher um ein "
    "Elementarwesen handelt.");
  AddId( ({"gletscherechse", "echse"}) );

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit eisigem Maul", QueryProp(P_HANDS)[1] + 30, 
        ({DT_COLD, DT_BLUDGEON})}));
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_COLD: -1.0, DT_FIRE:0.5, DT_POISON:0.5,
      DT_MAGIC: -0.3, DT_TERROR: -0.5, DT_ACID: -0.2,
      DT_SLASH: -0.2, DT_PIERCE: -0.2, DT_BLUDGEON: -0.2]) );

  SetProp(P_MSGIN, "trippelt  herein");
  SetProp(P_MSGOUT, "trippelt");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));

  AddInfo(DEFAULT_INFO, "zischelt Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " zerfaellt in kleine Eisstueckchen.\n");
  SetProp(P_KILL_MSG, "Jetzt bist Du eiskalt!");
  SetProp(P_MURDER_MSG, "Das naechste mal mach ich Gletschereis aus Dir, %s!");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" laesst @WEN zu Eis erstarren und zersplittern.\n"}));

  SetProp(P_SPELLRATE, 30);
  AddSpell(1, 500,
    Name(WER,1)+" friert Dich ein.\n",
    Name(WER,1)+" friert @WEN ein.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]));

  SUID;
}

