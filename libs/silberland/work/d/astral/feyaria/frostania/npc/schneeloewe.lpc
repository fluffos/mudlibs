// Ein Schneeloewe
// 22.06.2004  Feyaria@SilberLand

#include "../def.h"
inherit NPC "std_eis_npc";

void create()
{
  int alter;
  if (!is_clone(TO)) return;
  ::create();

  switch( random(10))
  {
    case 0: alter = -2;
      SetProp(P_NAME_ADJ, "jung");
      AddAdjective( ({"jungen", "junge"}) );
      break;
    case 1: alter = -1;
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"kleinen", "kleine"}) );
      break;
    case 2: alter = 1;
      SetProp(P_NAME_ADJ, "alt");
      AddAdjective( ({"alten", "alte"}) );
      break;
    case 3: alter = 2;
      SetProp(P_NAME_ADJ, "gross");
      AddAdjective( ({"grosse", "grossen"}) );
      break;
    case 4: alter = 2;
      SetProp(P_NAME_ADJ, "hungrig");
      AddAdjective( ({"hungriger", "hungrige"}) );
      break;
    case 5: alter = 3;
      SetProp(P_NAME_ADJ, "gefaehrlich");
      AddAdjective( ({"gefaehrlichen", "gefaehrliche"}) );
      break;
    case 6: alter = 4;
      SetProp(P_NAME_ADJ, "riesig");
      AddAdjective( ({"riesigen", "riesige"}) );
      break;
    default: alter = 0;
  }

  if(random(2))
  {
    SetProp(P_NAME, "Schneeloewe");
    SetProp(P_GENDER, MALE);
    AddId( ({"loewe", "schneeloewe", "MAEHNEN_WUSCHEL"}) );
    SetProp(P_LONG,
      "Der Schneeloewe hat ein weisses Fell, seine dichte Maehne dagegen "
      "ist fast schwarz, was einen starken Kontrast bildet. Die Quaste an "
      "seinem langen Schwanz ist auch ziemlich dunkel. Die gewaltigen "
      "Reisszaehne in seinem Gebiss sind nicht weniger gefaehrlich als die "
      "scharfen Krallen seiner Pranken.");
    SetProp(P_KILL_MSG, "Ich bin der Koenig von Frostania!");
    SetProp(P_MURDER_MSG, "Trotzdem bin ich der Koenig von Frostina, %s!");
  }
  else
  {
    SetProp(P_NAME, "Schneeloewin");
    SetProp(P_GENDER, FEMALE);
    AddId( ({"loewin", "schneeloewin", "FELL_WUSCHEL"}) );
    SetProp(P_LONG,
        "Die Schneeloewin hat ein weisses Fell, nur die Quaste an ihrem "
        "langen Schwanz ist fast schwarz. Die gewaltigen Reisszaehne in ihrem "
        "Gebiss sind nicht weniger gefaehrlich als die scharfen Krallen ihrer "
        "Pranken.");
    SetProp(P_KILL_MSG, "Ich bin die Koenigin von Frostania!");
    SetProp(P_MURDER_MSG, "Trotzdem bin ich die Koenigin von Frostina, %s!");
  }
  SetProp(P_SHORT, Name(WER,0));

  create_default_npc(26 + alter);
  SetProp(P_HANDS, ({" mit gewaltigen Pranken", QueryProp(P_HANDS)[1],
     ({DT_RIP, DT_COLD}) }));
  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 150 + alter * 10);
  SetProp(P_ALIGN, -150 + random(250));
  SetProp(P_AGGRESSIVE, 0.05);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_COLD: -1.0, DT_FIRE:0.5, DT_POISON:0.5, 
      DT_MAGIC: -0.3, DT_TERROR: -0.5, DT_ACID: -0.2,
      DT_SLASH: -0.2, DT_PIERCE: -0.2, DT_BLUDGEON: -0.2]) );

  SetProp(P_MSGIN, "kommt laut bruellend an");
  SetProp(P_MSGOUT, "verschwindet bruellend");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  SetProp(P_DIE_MSG, " stirbt einen wahren Loewentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN hungrig auf.\n"}));

  SetChats(3, ({
    Name(WER,1)+" schlaegt mit einer Pranke durch die Luft.\n",
    Name(WER,1)+" schaut Dich hungrig an.\n",
    Name(WER,1)+" reisst das Maul ganz weit auf.\n",
    Name(WER,1)+" gibt einen lauten, grollenden Ton von sich.\n",
    Name(WER,1)+" schnaubt leise.\n",
    Name(WER,1)+" bruellt laut.\n",
    Name(WER,1)+" schnurrt.\n"}) );

  SetProp(P_SPELLRATE, 50 + 3 * alter);
  AddSpell(2, 500 + alter * 100,
    Name(WER,1)+" beisst Dich.\n",
    Name(WER,1)+" beisst @WEN.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 450 + alter * 150,
    Name(WER,1)+" schlaegt Dir die Krallen tief in den Koerper.\n",
    Name(WER,1)+" schlaegt @WEM die Krallen tief in den Koerper.\n",
    ({DT_PIERCE, DT_COLD}), ([SP_SHOW_DAMAGE:1]));

  SUID;
}


