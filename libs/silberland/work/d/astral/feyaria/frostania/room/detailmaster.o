#0:0
text_short ({"Mitten in Frostania","In der Ebene des Eises","Im eisigen Frostania","Frostania - die Ebene des Eises","Im eiskalten Frostania",})
text_long ([2:({"Der Boden ist tiefgefroren und eiskalt.","Der Boden besteht aus reinem Eis.","Der Boden ist eiskalt.","Der Boden ist eine einzige grosse Eisplatte.","Der Boden ist hart wie eine Eisplatte.",}),5:({"Bis zum Horizont siehst Du nur Eis und Schnee.","Ueberall siehst Du nur Eis und Schnee.","Alles ist voller Eis und Schnee.","Hier ist so viel Schnee, dass man einen Schneemann bauen koennte.",}),1:({"Du befindest Dich in Frostania, der Ebene des Eises.","Du stehst frierend mitten in der Ebene des Eises, auch Frostania genannt.","Du bist in der Ebene des Eises.","Frostania - die Ebene des Eises.","Du bist im eiskalten Frostania.",}),4:({"Die toedliche Kaelte bringt Dich um den Verstand.","Es ist toedlich kalt hier.","Es ist eisig kalt hier.","Du schlotterst vor Kaelte.","Es ist unglaublich kalt hier.",}),3:({"Der Himmel ist nicht zu sehen, dafuer schneit es viel zu stark.","Den Himmel kannst Du in dem dichten Schneetreiben nicht sehen.","Vom Himmel fallen grosse Schneeflocken heruntern.","Der Himmel ist wegen dem starken Schneefall nur schwer zu erkennen.",}),])
text_details (["umgebung":({"Die Umgebung ist hier ist extrem lebensfeindlich.",}),"schneefall":({"Es schneit hier sehr stark.","Viele Schneeflocken fallen vom Himmel herunter.","Der Schneefall ist sehr stark hier. Bald bist du komplett eingeschneit, wenn Du Dich nicht bewegst.",}),"verstand":({"Du kannst keinen Verstand haben, sonst wuerdest Du nicht in solch einer lebensfeindlichen Umgebung herumlaufen.",}),"kaelte":({"Die toedliche Kaelte bringt Dich um den Verstand.","Es ist toedlich kalt hier.","Es ist eisig kalt hier.","Du schlotterst vor Kaelte.","Es ist unglaublich kalt hier.",}),"schneeflocken":({"Es schneit hier sehr stark.","Viele Schneeflocken fallen vom Himmel herunter.","Die Schneeflocken hier sind riesig gross.","Die Schneeflocken hier sind viel groesser als normal.",}),"haufen":({"Haufenweise Schnee",}),"wunder":({"Es ist ein Wunder, dass Du noch nicht erfroren bist.",}),"schneemann":({"Aus dem ganzen Schnee koenntest Du wirklich einen Schneemann bauen, leider ist es aber dazu viel zu kalt.",}),"schnee":({"Hier liegt viel Schnee.","Es schneit hier sehr stark.","Viele Schneeflocken fallen vom Himmel herunter.","So viel Schnee auf einem Haufen hast Du noch nie gesehen.",}),"eisplatte":({"Der Boden ist hart wie eine Eisplatte.","Der Boden ist tiefgefroren und eiskalt.","Der Boden besteht aus reinem Eis.","Der Boden ist eiskalt.","Der Boden ist eine einzige grosse Eisplatte.",}),"eis":({"Hier ist alles voller Eis, kein Wunder, du bist ja auch in der Ebene des Eises.",}),"boden":({"Der Boden ist tiefgefroren und eiskalt.","Der Boden besteht aus reinem Eis.","Der Boden ist eiskalt.","Der Boden ist eine einzige grosse Eisplatte.",}),"himmel":({"Der Himmel ist nicht zu sehen, dafuer schneit es viel zu stark.","Den Himmel kannst Du in dem dichten Schneetreiben nicht sehen.","Vom Himmel fallen grosse Schneeflocken heruntern.","Der Himmel ist wegen dem starken Schneefall nur schwer zu erkennen.",}),"schneetreiben":({"Du bist schon halb mit Schnee bedeckt.","Es schneit hier sehr stark.","Viele Schneeflocken fallen vom Himmel herunter.","Der Schneefall ist sehr stark hier. Bald bist du komplett eingeschneit, wenn Du Dich nicht bewegst.",}),])
