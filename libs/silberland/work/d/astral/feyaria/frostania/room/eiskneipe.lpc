
#include "../def.h"
#include <pub.h>

inherit  "std/pub";

string read_liste();

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "Die Eiskneipe");
  SetProp(P_INT_LONG,
      "Du stehst in der Eiskneipe. Allerdings erinnert hier nichts an eine "
      "normale Kneipe, ausser dass man sich hier Essen und Getraenke "
      "bestellen kann. Serviert werden sie von seltsamen Eiswesen, die "
      "wie aus dem Nichts erscheinen, sobald man etwas bestellt hat und "
      "sich wieder in Eis aufloesen, sobald sie das Gewuenschte gebracht "
      "haben. Ein breites Portal fuehrt in den Nexus und ein kleiner "
      "Ausgang fuehrt weiter in diese frostige Welt.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 0, ENV_TERRAIN: TT_OTHER]) );

  AddDrink("Eiswasser", 
      ({"eiswasser", "wasser"}),
      200, 29, 0, 8,
      ({"Du bekommst einen Becher mit Eiswasser und trinkst es aus. "
       "Deine Haende frieren fast ein, denn der Becher besteht aus "
       "eiskaltem Eis!",
       "&& bekommt Eiswasser serviert."}));
  AddDrink("Whisky mit Eis", 
      ({"whisky", "whisky mit eis"}),
      700, 57, 11, 2,
      ({"Du bekommst ein Stamperl Whisky mit Eis! Der Alkohol brennt in "
       "Deiner Kehle sodass das Eis sofort schmilzt!",
       "&& trinkt ein Stamperl Whisky mit Eis."}));
  AddDrink("Geschmolzener Schnee", 
      ({"geschmolzener schnee", "schnee"}),
      400, 5, -2, 3,
      ({"Du bekommst einen Haufen Schnee in Deine Haende, wartest bis er "
       "geschmolzen ist und trinkst das Schmelzwasser dann aus. Schmeckt "
       "zwar eklig, aber macht Deinen Kopf wieder klar.",
       "&& schmilzt Schnee in &=en Haenden und trinkt dann das Schmelzwasser."}));
  AddDrink("Magische Schneeschmelze", 
      ({"magische schneeschmelze", "schneeschmelze", "schmelze"}),
      1000, ({40,80,35}), 1, 16,
      ({"Du trinkst die legendaere magische Schneemelze und schmilzt fast "
       "selber.",
       "&& trinkt magische Schneeschmelze und schmilzt fast selber."}));

  AddFood ( "Eiszapfen", 
      ({"eiszapfen", "zapfen"}),
      77, 14, 5,
      ({"Du lutscht an einem Eiszapfen. Brrr! Ist das kalt!",
       "&& lutscht an einem Eiszapfen."}) );
  AddFood ( "Winterknoedel", 
      ({"winterknoedel", "winter", "knoedel"}),
      491, ({20,55,15}), 10,
      ({"Du bestellst Winterknoedel, ein leckerer Knoedel mit Eisfuellung!",
       "&& bestellt Winterknoedel."}) );
  AddFood ( "Schneemannkotlett", 
      ({"schneemannkotlett", "kotlett", "schneemann"}),
      577, ({70,10,25}), 12,
      ({"Du isst ein Schneemannkotlett. Es ist gut durchgebraten, aber "
       "trotzdem noch eiskalt!",
       "&& isst ein Schneemannkotlett."}) );
  AddFood ( "Gletschereis", 
      ({"gletschereis", "gletscher"}),
      1845, 129, 18,
      ({"Du bekommst Gletschereis, die wohl kaelteste Substanz, die Du je "
       "gesehen hast. Dein Magen gefriert voellig ein, trotzdem fuehlst Du "
       "Dich gesaettigt!",
       "&& bekommt extrem kaltes Gletschereis."}) );


  AddSpecialDetail( ({"speise", "speisen", "getraenke", "getraenk", 
        "bestellen", "essen", "trinken", "bestellungen"}), 
      "det_menu");

  AddDetail( ({"boden"}),
      "Der Boden besteht komplett aus Eis, das aber aus irgendeinem Grund "
      "nicht schmilzt.");
  AddDetail( ({"waende", "wand", "decke"}),
      "Alles nur Eis.");
  AddDetail( ({"grund"}),
      "Es wird wohl ein magischer Grund sein.");
  AddDetail( ({"kneipe", "eiskneipe"}),
      "Du befindest Dich in der Eiskneipe.");
  AddDetail( ({"eiswesen", "wesen"}),
      "Die Eiswesen erscheinen nur, um Bestellungen zu erfuellen und "
      "verschwinden dann sofort wieder.");
  AddDetail( ({"portal", "nexus"}),
      "Ein breites Portal fuehrt in den Nexus.");
  AddDetail( ({"ausgang", "welt"}),
      "Ein kleiner Ausgang fuehrt hinaus in die eisige Welt von Frostania.");
  AddDetail( ({"frostania"}),
      "So nennt man in Fachkreisen die Ebene des Eises.");
  AddDetail( ({"eis"}),
      "Eis gibt es hier viel, Du bist ja auch in der Ebene der Eises.");
  AddDetail( ({"ebene"}),
      "Ebene bedeutet hier keine Landschaftsform oder dass hier alles ganz "
      "flach ist ist. Vielmehr stellt man sich vor, dass die verschiedenen "
      "Ebenen wie die Stockwerke eines Hauses uebereinander liegen.");
  AddDetail( ({"stockwerk", "stockwerke", "haus"}),
      "So kann man es sich vorstellen.");
  AddDetail( ({"landschaftsform", "bedeutung"}),
      "Nein, diese Bedeutung von Ebene ist nicht gemeint.");
  AddDetail( ({"fachkreis", "fachkreise"}),
      "Zum Beispiel bei den Druiden.");
  AddDetail( ({"druiden"}),
      "Druiden haben grosses Wissen ueber die Elemente.");
  AddDetail( ({"elemente", "wasser", "luft", "feuer", "humus", "erz"}),
      "Die Elemente sind Wasser, Feuer, Humus, Luft, Erz und natuerlich Eis.");
  AddDetail( ({"macht", "verstaendnis", "wissen"}),
      "Die Macht der Druiden ueber die Elemente kommt aus dem Verstaendnis "
      "der Elementartheorie.");
  AddDetail( ({"elementartheorie"}),
      "Vereinfacht sagt die Elementartheorie, dass es sechs Elemente gibt, "
      "wobei sich jeweils zwei immer entgegengesetzt sind, zum Beispiel "
      "Eis und Humus.");
  AddDetail( ({"beispiel"}),
      "Ein anderes Beispiel ist Luft und Erz.");
  AddDetail( ({"nichts"}),
      "Du siehst hier nichts.");
  AddDetail( ({"gewuenschte"}),
      "Du solltest selber wissen, was Du wuenscht.");

  AddSmell( ({DEFAULT_SMELL}), 
      "Es riecht eisig.");
  AddSound( ({DEFAULT_SOUND, "kneipengeraeusche"}), 
      "Obwohl es sich hier um eine ganz seltsame Kneipe handelt, hoerst "
      "Du trotzdem die ueblichen Kneipengeraeusche.");

  AddExit ("raus", ([EX_MSG: "raus",
                     EX_FUNC: "raus"]) );
  AddExit ("nexus", ([EX_MSG: "zurueck in den Nexus",
                      EX_DEST: NEXUS]) );

  RemoveItem("/obj/topliste");
  AddDetail( ({"liste", "frostanialiste", "topliste", "topfrostanialiste", 
        "top-frostanialiste"}), #'read_liste);
  AddReadDetail( ({"liste", "frostanialiste", "topliste", "topfrostanialiste", 
        "top-frostanialiste"}), #'read_liste);
  SetProp(P_ZONE, "Frostania");
#include "../../where.h"
}

mixed raus(string verb)
{
  object ob;
  if (!IS_LEARNING(TP) && TP->QueryProp(P_TEMPERATURE_RANGE)[0] -
      TP->QueryProp(P_TOTAL_TEMPERATURE_PROTECTION)[0] -
      TP->QueryProp(P_TEMPERATURE_OFFSET) > -25)
  {
    write("Das wuerde Dir ohne einen zusaetzlichen Kaelteschutz viel zu "
        "kalt werden!\n");
    return 1;
  }
  if(ob = find_living("eiskneipeneingang"))
    return file_name(ENV(ob));
  else
  {
    call_other(ROOM "eisraum:0:0:0", "reset");
    return ROOM "eisraum:0:0:0";
  }
}

string det_menu()
{
  TP->command_me("menue");
  return "";
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  return ::int_long(viewer, viewpoint, shortflag) +
    "Die Top-Frostanialiste.\n";
}

string read_liste()
{
  write(
    "Die Liste der beruehmtesten Helden in Frostania\n"
    "-----------------------------------------------\n");
  ASTRALMASTER->FameList("frostania");
  return "";
}
