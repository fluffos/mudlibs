#include "../def.h"

inherit STDROOM;

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_IN);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -50+random(25), ENV_TERRAIN: TT_ARCTIC]) );

  SetProp(P_ZONE, "Frostania");
}

