#include "../def.h"

inherit ROOM "std_eisraum";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Palast des Eises");
  SetProp(P_INT_LONG,
      "Du stehst in einer gewaltigen Saeulenhalle, nur sind die Saeulen keine "
      "normalen Saeulen sondern riesige Eiszapfen, die aber fix an ihrem "
      "Platz bleiben. Die Eiszapfen werden in Richtung Westen immer kleiner, "
      "im Osten bilden sie einen Halbkreis.");

  AddDetail( ({"boden"}),
      "Der Boden besteht nur aus extrem kalten Eis, allerdings frieren "
      "Deine Fuesse nicht an.");
  AddDetail( ({"decke"}),
      "Die Decke dieses Palastes besteht aus Eis.");
  AddDetail( ({"waende", "wand"}),
      "Waende kannst Du hinter den Saeulen nicht erkennen.");
  AddDetail( ({"saeulenhalle", "halle"}),
      "Die riesige Saeulenhalle besteht nicht aus normalen Saeulen, sondern "
      "aus Eiszapfen.");
  AddDetail( ({"saeulen", "saeule"}),
      "Die Saeulen sind eigentlich riesige Eiszapfen.");
  AddDetail( ({"eiszapfen"}),
      "Die Eiszapfen bleiben fix an ihrem Platz und vermitteln so den "
      "Eindruck einer Saeulenhalle.");
  AddDetail( ({"platz"}),
      "Eine starke Magie muss die Eiszapfen an ihrem Platz halten. Du "
      "kannst foermlich die Energie spueren, die hier gebunden ist.");
  AddDetail( ({"richtung", "westen"}),
      "In Richtung Westen werden die Saeulen kleiner.");
  AddDetail( ({"wesen", "eiswesen"}),
      "Hier leben die Eiswesen, die diese Ebene beherrschen, die Daos.");
  AddDetail( ({"palast"}),
      "Dies ist der Palast des Eises.");
  AddDetail( ({"eis", "ebene", "ebene des eises"}),
      "Hier ist alles aus Eis, kein Wunder, da Du Dich ja auf der Ebene des "
      "Eises befindest.");
  AddDetail( ({"wunder"}),
      "Eines der Wunder ist, dass Du noch nicht erforen bist.");
  AddDetail( ({"magie"}),
      "Es handelt sich wohl um elementare Eismagie.");
  AddDetail( ({"energie"}),
      "In den riesigen Eiszapfen steckt eine gewaltige Energie!");
  AddDetail( ({"dao", "daos"}),
      "Die Daos sind die Herrscher ueber die Ebene des Eises.");
  AddDetail( ({"eismagie"}),
      "Nur Eismagie ist maechtig genug, um einen Eiszapfen an einen Ort "
      "zu binden.");
  AddDetail( ({"herrscher", "khan"}),
      "Der Herrscher aller Eiswesen ist der Dao Khan.");
  AddDetail( ({"ort", "eindruck"}),
      "Dieser Ort macht einen starken Eindruck auf Dich.");
  AddDetail( ({"osten", "halbkreis"}),
      "Im Osten bilden die Saeulen einen Halbkreis, dort scheint der "
      "Herrscher dieses Palastes zu residieren.");
  AddDetail( ({"kreis"}),
      "Kein Kreis, nur ein Halbkreis.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "eis"}), 
      "Es riecht nach Eis.");
  AddSound( ({DEFAULT_SOUND, "knacken", "eis"}), 
      "Du hoerst das Knacken der Eis.");

  AddExit( "westen", ROOM "palast1");
  AddExit( "osten", ([
        EX_DEST: ROOM "palast3",
        EXG_ID: "dao hetman",
        EXG_PLMSG: "Der Dao Hetman laesst Dich nicht vorbei.\n",
        EXG_RMMSG: "Der Dao Hetman laesst @wen@ nicht vorbei.\n"]) );
}


