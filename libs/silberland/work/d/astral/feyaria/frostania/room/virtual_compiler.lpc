// Virtual Compiler fuer Frostania 
// 21.6.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/virtual/v_compiler";

#include <v_compiler.h>

#define P_ROOMS "raum"

mapping exits;
mapping extra_exits;

void create() 
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "eisraum" );
  SetProp(P_ROOMS, ({"eisraum"}) );

  exits = ([
      "norden":  1;  0;  0,
      "sueden": -1;  0;  0,
      "westen":  0;  1;  0,
      "osten":   0; -1;  0,
    ]);
  extra_exits = ([
      "nordwesten":  1;  1;  0,
      "suedwesten": -1;  1;  0,
      "nordosten":   1; -1;  0,
      "suedosten":  -1; -1;  0,
    ]);
}

string Validate(string file) 
{
  string name, foo;
  int x, y, z;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%d:%d:%d%s", name, x, y, z, foo) == 5) &&
      (member(QueryProp(P_ROOMS), name) != -1) &&
      x >= 0 && x < XSIZE && 
      y >= 0 && y < YSIZE && 
      z >= 0 && z < ZSIZE) 
    return name+":"+x+":"+y+":"+z;
  return 0;
}

int CustomizeObject() 
{
  string foo,foo2;
  string *ind;
  int x,y,z,i;
  mixed name;
  string extra;
  
  if (!(name = ::CustomizeObject()) || 
      sscanf(name,"%s:%d:%d:%d%s", foo, x, y, z, foo2) != 5)
    return 0;

  ind = m_indices(exits);
  for (i = 0; i < sizeof(ind); i++) 
    PO->AddExit( ind[i], ROOM "eisraum:" +
        ((x + exits[ind[i], 0] + XSIZE) % XSIZE) + ":" +
        ((y + exits[ind[i], 1] + YSIZE) % YSIZE) + ":" +
        ((z + exits[ind[i], 2] + ZSIZE) % ZSIZE) );
  if(!random(6))
  {
    extra = m_indices(extra_exits)[random(sizeof(extra_exits))];
    PO->AddExit(extra, ROOM "eisraum:"+
        ((x + extra_exits[extra, 0] + XSIZE) % XSIZE) + ":" +
        ((y + extra_exits[extra, 1] + YSIZE) % YSIZE) + ":" +
        ((z + extra_exits[extra, 2] + ZSIZE) % ZSIZE) );
  }
  if (x == 0 && y == 0 & z == 0)
    PO->AddItem(NPC "eiskneipennpc", REFRESH_DESTRUCT);
  ROOM "detailmaster"->Customize(PO);
  return 1;
}
