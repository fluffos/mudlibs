#include "../def.h"

inherit ROOM "std_eisraum";

void create()
{
  string *npcs;

  if(!is_clone(TO)) return;
  ::create();
  PO->CustomizeObject();

  AddDetail( ({"frostania", "reich", "reich des eises", "reich"}),
      "Frostania, es wird von Druiden auch als die elementare Ebene des "
      "Eises bezeichnet. Es wird von den Daos beherrscht.");
  AddDetail( ({"dao", "daos", "eiswesen"}),
      "Die Daos sind die Herrscher ueber die Ebene des Eises.");
  AddDetail( ({"herrscher"}),
      "Der Herrscher aller Eiswesen ist der Dao Khan.");
  AddSpecialDetail(({"dao khan", "khan", "macht"}), "det_khan");
  AddDetail( ({"eis"}),
      "Eis gibt es hier viel, Du bist ja auch in der Ebene des Eises.");
  AddDetail( ({"ebene"}),
      "Ebene bedeutet hier keine Landschaftsform oder dass hier alles ganz "
      "flach ist ist. Vielmehr stellt man sich vor, dass die verschiedenen "
      "Ebenen wie die Stockwerke eines Hauses uebereinander liegen.");
  AddDetail( ({"stockwerk", "stockwerke", "haus"}),
      "So kann man es sich vorstellen.");
  AddDetail( ({"landschaftsform", "bedeutung"}),
      "Nein, diese Bedeutung von Ebene ist nicht gemeint.");
  AddDetail( ({"druiden"}),
      "Druiden haben grosse Macht ueber die Elemente. ");
  AddDetail( ({"elemente", "wasser", "luft", "feuer", "humus", "erz"}),
      "Die Elemente sind Feuer, Wasser, Humus, Luft, Erz und natuerlich Eis.");
  AddDetail( ({"macht", "verstaendnis"}),
      "Die Macht der Druiden ueber die Elemente kommt aus dem Verstaendnis "
      "der Elementartheorie.");
  AddDetail( ({"elementartheorie"}),
      "Vereinfacht sagt die Elementartheorie, dass es sechs Elemente gibt, "
      "wobei sich jeweils zwei immer entgegengesetzt sind, zum Beispiel "
      "Eis und Humus.");
  AddDetail( ({"beispiel"}),
      "Ein anderes Beispiel ist Feuer und Wasser.");
  AddDetail( ({"richtung", "richtungen"}),
      "In allen Richtungen siehst Du nur Eis.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "eis"}), 
      "Es riecht hier nach Eis.");
  AddSound( ({DEFAULT_SOUND, "eis", "stille"}), 
      "Du hoerst nicht in der eisigen Stille.");
 
  npcs =({
      EISFROSCH,
      WINTERWOLF,
      EISMANN,
      EISWUERFEL,
      EISRIESE,
      EISBAER,
      EISSCHLANGE,
      SCHNEEMANN,
      NPC "eiselementar",
      NPC "eisdruide",
      NPC "schneeloewe",
      NPC "schneefresser",
      NPC "eisteufel",
      NPC "gletscherechse",
      });
  if (random(100) < NPC_CHANCE)
    AddItem( npcs + (!random(3) ? ({DAO "sabri"}) : ({})), 
        REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES,
          P_MNPC_WAIT: ({ 30, 60, 60 }),
          P_HEAL: 200,
          P_CORPSE: OBJ "eisleiche",
          P_NOCORPSE: 0,
          P_TEMPERATURE_RANGE: ([T_RANGE_MIN:-200,T_RANGE_MAX:40])]) ); 

  if (random(100) < RARE_NPC_CHANCE)
    AddItem(  npcs + ({ 
          CORRUPTOR,
          DAO "hetman",
          NPC "eisriese",
          SCHNEEGEIST,
          }), REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES,
          P_MNPC_WAIT: ({ 60, 90, 90 }),
          P_ASTRAL_RARE_NPC: 1,
          P_HEAL: 500,
          P_CORPSE: OBJ "eisleiche", 
          P_NOCORPSE: 0,
          P_TEMPERATURE_RANGE: ([T_RANGE_MIN:-200,T_RANGE_MAX:40])]) ); 

}

string det_khan()
{
  if (ASTRALMASTER->QueryTime("frostania") > 0)
    return "Die Macht des Dao Khan ist momentan sehr schwach.\n";
  else
    return "Du kannst die Macht des Dao Khan hier foermlich fuehlen.\n";
}
