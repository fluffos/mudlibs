// Eine Feuerschlange
// 10-06-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_feuer_npc";
inherit "std/npc/spells";

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Feuerschlange");
  SetProp(P_LONG,
      "Diese kleine Feuerschlange ist ein wahres Phaenomen, sie hat eine "
      "orangerote Schuppenhaut, aus der ab und zu kleine Flaemmchen "
      "aufsteigen. Scheinbar liebt sie das Feuer, sonst wuerde sie nicht "
      "in diesser heissen Umgebung leben.");
  SetProp(P_NAME, "Feuerschlange");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "feuerschlange","schlange" }) );

  create_default_npc(10+random(3));
  SetProp(P_HANDS, ({" mit ihren gluehend heissen Zaehnen",
                   QueryProp(P_HANDS)[1] + 30, ({DT_FIRE, DT_PIERCE}) }));
  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 20+random(5));
  SetProp(P_ALIGN, -150);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:       0.4, DT_WATER:   0.3, 
      DT_POISON:    -0.7, DT_MAGIC:     -0.3, DT_SOUND:  -1.0]) );

  SetProp(P_MSGIN, "kommt schlaengelnd an");
  SetProp(P_MSGOUT, "windet sich weiter");

  SetProp(P_DIE_MSG,  " bleibt regungslos liegen.\n");
  SetProp(P_KILL_MSG, "Niemand kann die Macht des Feuers besiegen!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Feuerschlange kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,40);

  AddDefaultSpell(1, 350, DS_POISON, 
    "Die Feuerschlange vergiftet Dich mit einem starken Biss.\n",
    "Die Feuerschlange vergiftet @WEN mit einem starken Biss.\n");

  AddSpell(4,250,
    "Die Feuerschlange beisst Dir ins Bein.\n",
    "Die Feuerschlange beisst @WEM ins Bein.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,200,
    "Die Feuerschlange beisst Dir in den Fuss.\n",
    "Die Feuerschlange beisst @WEM in den Fuss.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Feuerschlange verbrennt fast Deine Fuesse.\n",
    "Die Feuerschlange baut sich gefahrvoll vor Dir auf.\n", }) );

}

