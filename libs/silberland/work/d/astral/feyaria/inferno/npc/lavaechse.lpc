// Eine Lavaechse
// 22.6.2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_feuer_npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lavaechse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    "Die Lavaechse hat eine hellrote, schimmernde Schuppenhaut und dunkelrot "
    "gluehende Augen. Sie liebt die Hitze, denn sie scheint sich von heisser "
    "Lava zu ernaehren.");
  AddId( ({"lavaechse", "echse"}) );

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit Feueratem", QueryProp(P_HANDS)[1] + 30,
        ({DT_FIRE, DT_BLUDGEON}) }));
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_COLD: 0.5, DT_FIRE:-1.0, DT_WATER:0.5,
      DT_MAGIC: -0.3, DT_TERROR: -0.5, DT_ACID: -0.2,
      DT_SLASH: -0.2, DT_PIERCE: -0.2, DT_BLUDGEON: -0.2]) );

  SetProp(P_MSGIN, "trippelt  herein");
  SetProp(P_MSGOUT, "trippelt");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));

  AddInfo(DEFAULT_INFO, "zischelt Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " zerfaellt in kleine Lavastueckchen.\n");
  SetProp(P_KILL_MSG, "Niemand kann die Macht des Feuers besiegen!");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" verbrennt @WEN zu Asche.\n"}));

  SetProp(P_SPELLRATE, 30);
  AddSpell(1, 500,
    Name(WER,1)+" verbrennt Dich.\n",
    Name(WER,1)+" verbrennt @WEN.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  SUID;
}

