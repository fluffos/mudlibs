// ein Feuerriese
// 10-06-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_feuer_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Feuerriese");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein gewaltiger Feuerriese");
  SetProp(P_LONG, 
    "Diese gewaltige Gestalt kann nur einer der legendaeren Feuerriesen sein. "
    "Schon seine saeulenartigen Beine ueberragen Dich haushoch. Er hat "
    "brennende Haende und Fuesse, eine leuchtend rote Haut und lange, "
    "dunkelrote Haare. Der Feuerriese ist wirklich dafuer geschaffen, in "
    "dieser Feuerwelt zu leben.");
  AddId(({"riese", "feuerriese"}));

  create_default_npc(45);
  SetProp(P_HANDS, 
      ({" mit der Kraft des Feuers", 400, ({DT_FIRE, DT_BLUDGEON}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_BODY, QueryProp(P_BODY) * 2);
  SetProp(P_RACE, "Riese");
  SetProp(P_SIZE, 1500);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:-0.15,   DT_BLUDGEON: -0.3, DT_RIP: -0.1, DT_PIERCE: -0.05,
        DT_WATER:0.5, DT_COLD:0.3, DT_FIRE:-1, DT_LIGHT:-0.6])); 

  SetProp(P_MSGIN, "trampelt herein");
  SetProp(P_MSGOUT, "trampelt");
  SetProp(P_MMSGIN, "trampelt herein");
  SetProp(P_MMSGOUT, "trampelt weg");
  SetProp(P_MNPC_WAIT, ({ 60, 60, 60 }));

  SetProp(P_DIE_MSG,  " faellt tot um.\n"
      "Die Erschuetterung laesst Dich erzittern.\n");
  SetProp(P_KILL_MSG, "Niemand kann die Macht des Feuers besiegen!");
  SetProp(P_MURDER_MSG, "Wie konntest Du gegen die Macht des Feuers siegen, %s?");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
        "Der Feuerriese verbrennt @WEN."}) );
  AddInfo(DEFAULT_INFO, "spricht mit donnernder Stimme.\n");

  SetProp(P_SPELLRATE, 50);
  AddSpell(5, 1200,
      Name(WER,1)+" trifft Dich hammerhart.\n",
      Name(WER,1)+" trifft @WEN hammerhart.\n",
      ({DT_FIRE, DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 800, 
      Name(WER,1) + " umhuellt Dich mit Feuer.\n",
      Name(WER,1) + " umhuellt @WEN mit Feuer.\n",
      ({DT_FIRE}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 500, DS_PARALYZE,
      Name(WER,1)+ " schlaegt Dich bewusstlos.\n",
      Name(WER,1)+ " schlaegt @WEN bewusstlos.\n",2);
      
  SetChats(1, ({
    "Der Feuerriese tritt beinahe auf Dich drauf.\n",
    "Du bestaunst die gewaltige Groesse des Feuerriesen.\n"}) );

  SUID;

  GEMMASTER->DistributeGem(3, 7, 1, 1, GEMARRAY);

}

