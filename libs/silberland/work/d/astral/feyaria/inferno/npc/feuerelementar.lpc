// Feuerelementar
// 10.06.2004 Feyaria@SilberLand

#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"

inherit "/gilden/druidenzirkel/npc/elementar";

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  SetProp(P_GUILD, "druidenzirkel");
  Customize(FEUER, TO, 10000, 10 + random(11) + random(11));
  SetProp(ELEMENTAL_CASTER, 0);
  SetProp(P_XP, QueryProp(P_HANDS)[1] * QueryProp(P_MAX_HP) * 5);
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SetProp(P_FRIEND, 0);
  SetProp(P_NO_GLOBAL_ATTACK, 0);
  SetProp(P_LOG_INFO, "feyaria/inferno");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

