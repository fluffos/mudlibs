// Der Phoenix
// 10-06-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_feuer_npc";
inherit "std/npc/spells";

int lives = 1;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Phoenix");
  SetProp(P_LONG, BS(
    "Der Phoenix ist das maechtigste Elementarwesen des Feuers. "
    "Er sieht aus wie ein riesiger Vogel, der komplett aus Flammen besteht. "
    "Die Hitze in seiner Naehe ist gewaltig. ")) ;
  SetProp(P_NAME, "Phoenix");
  SetProp(P_GENDER, MALE);
  AddId(({"phoenix"}));

  create_default_npc(45);
  SetProp(P_HANDS, ({" mit toedlichen Flammenklauen",600, ({DT_FIRE, DT_RIP})}));
  SetProp(P_BODY, QueryProp(P_BODY)*2);
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 700);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_LIGHT, 6);
  SetProp(P_HP_DELAY, 0);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_FIRE       :-1,       DT_COLD       :0.3,      DT_WATER      :0.3,    
    DT_AIR        :-0.3,     DT_LIGHTNING  :-0.3,     DT_EXPLOSION  :-0.3, 
    DT_SOUND      :-0.7,     DT_LIGHT      :-0.5,     DT_ELECTRIC   :-0.3,    
    DT_ACID       :-0.3,     DT_POISON     :-0.7,     DT_TERROR     :-0.7,   
    DT_HOLY       :-0.5,     DT_UNHOLY     :-0.5,     DT_MAGIC      :-0.2,
    ]) );
  SetProp(P_NOMAGIC, 60);

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "entsteht aus einer Flammenexplosion");
  SetProp(P_MMSGOUT, "vergeht in einer Flammenexplosion");

  SetProp(P_DIE_MSG, " vergeht in einer Flammenexplosion!\n");
  SetProp(P_KILL_MSG, "Glaubtest Du echt, Du haettest einen Chance gegen den "
      "unbesiegbaren Phoenix?");
  SetProp(P_MURDER_MSG, "Arg, warum konnte ich nicht ein weiteres Mal aus der "
      "Asche auferstehen, %s?");
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "@WER verbrennt sofort.\n" }) );
  
  SetProp(P_SPELLRATE, 60);
  AddDefaultSpell( 5, 700, DS_MASS_DAMAGE,
      Name(WER,1)+" verbrennt die gesamte Umgebung!\n",
      Name(WER,1)+" verbrennt die gesamte Umgebung!\n",
      DT_FIRE);
  AddSpell(9, 1100,
      Name(WER,1)+" huellt Dich in Flammen ein!\n",
      Name(WER,1)+" huellt @WEN in Flammen ein!\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 1000,
      Name(WER,1)+" blendet Dich mit seinen Flammen!\n",
      Name(WER,1)+" blendet @WEN mit seinen Flammen!\n");
  AddSpell(1, 1800,
      Name(WER,1)+" verwandelt Dich in ein flammendes Inferno!\n",
      Name(WER,1)+" verwandelt @WEN in ein flammendes Inferno!\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  GEMMASTER->DistributeGem(3, 7, 1, 1, GEMARRAY);

}

void die(int poisondeath)
{
  lives--;
  if (lives > -2 + random(4))
  {
    environment()->Message("Der Phoenix vergeht in einer Flammenexplosion!\n");
    environment()->Message("Der Phoenix steht aus der Asche wieder auf!\n");
    AddHp(2000);
    return; 
  }
  ::die(poisondeath);
}

