// Ein Flammenmonser
// 22.6.2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_feuer_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Flammenmonster");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    "Das Flammenmonster besteht nur aus einer riesigen Flamme. Es veraendert "
    "staendig seine Form und flackert wild. Die Hitze in seiner Naehe ist "
    "fast unertraeglich. Sein einziger Lebenszweck ist, alles zu verbrennen "
    "un die Macht des Feuers dadurch zu staerken.");
  AddId( ({"flammenmonster", "monster", "flamme"}) );

  create_default_npc(28);
  SetProp(P_HANDS, ({" mit Flammen", QueryProp(P_HANDS)[1] + 50, 
        ({DT_FIRE, DT_BLUDGEON})}));
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 400);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_COLD: 0.5, DT_FIRE:-1.0, DT_WATER:0.5,
      DT_MAGIC: -0.3, DT_TERROR: -0.5, DT_ACID: -0.2,
      DT_SLASH: -0.2, DT_PIERCE: -0.2, DT_BLUDGEON: -0.2]) );
  SetProp(P_LIGHT, 1);
  SetProp(P_AGGRESSIVE, 0.2);

  SetProp(P_MSGIN, "brennt sich herein");
  SetProp(P_MSGOUT, "brennt sich");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " erloescht.\n");
  SetProp(P_KILL_MSG, "Niemand kann die Macht des Feuers besiegen!");
  SetProp(P_MURDER_MSG, "Wie konntest Du meinen heissen Flammen entkommen, %s?");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" verbrennt @WEN zu Asche.\n"}));

  SetChats(4, ({
    Name(WER,1)+" verbrennt Dich beinahe.\n"}) );

  SetProp(P_SPELLRATE, 50);
  AddSpell(9, 700,
    Name(WER,1)+" verbrennt Dich.\n",
    Name(WER,1)+" verbrennt @WEN.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 950, DS_BLIND,
    Name(WER,1)+" blendet Dich.\n",
    Name(WER,1)+" blendet @WEN.\n",
    2);

  SUID;
}

