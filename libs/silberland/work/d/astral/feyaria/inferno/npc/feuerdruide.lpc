// ein Druide des Feuers
// 08-04-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_feuer_npc";

#include "/p/std/npc/druid_npc.h"

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  switch(random(2))
  {
    case 0: 
      SetProp(P_NAME, "Feuerdruide");
      SetProp(P_GENDER, MALE);
      AddId(({"druide", "feuerdruide"}));
      break;
    case 1: 
      SetProp(P_NAME, "Feuerdruidin");
      SetProp(P_GENDER, FEMALE);
      AddId(({"druidin", "feuerdruidin"}));
      break;
  }
  switch(random(100))
  {
    case 0..15:
      SetProp(P_RACE, "Elf" );
      SetProp(P_SIZE, 180 + random(30));
      SetProp(P_NAME_ADJ, "elfisch");
      AddId(({"", "elf", "elfe"})[QueryProp(P_GENDER)]);
      break;
    case 16..25:
      SetProp(P_RACE, "Fee" );
      SetProp(P_SIZE, 60 + random(10));
      SetProp(P_NAME, "Feenfeuerdruidin");
      SetProp(P_GENDER, FEMALE);
      RemoveId(({"druide", "feuerdruide"}));
      AddId(({"fee", "druidin", "feuerdruidin", "feenfeuerdruidin"}));
      break;
    case 26..40:
      SetProp(P_RACE, "Hobbit" );
      SetProp(P_SIZE, 80 + random(20));
      SetProp(P_NAME_ADJ, "hobbitig");
      AddId("hobbit");
      break;
    case 41..55:
      SetProp(P_RACE, "Mensch" );
      SetProp(P_SIZE, 160 + random(30));
      SetProp(P_NAME_ADJ, "menschlich");
      AddId("mensch");
      break;
    case 56..85:
      SetProp(P_RACE, "Zwerg" );
      SetProp(P_SIZE, 120 + random(10));
      SetProp(P_NAME_ADJ, "zwergisch");
      AddId(({"", "zwerg", "zwergin"})[QueryProp(P_GENDER)]);
      break;
    case 86..99:
      SetProp(P_RACE, "Dunkelelf" );
      SetProp(P_SIZE, 170 + random(30));
      SetProp(P_NAME_ADJ, "dunkelelfisch");
      AddId(({"", "dunkelelf", "dunkelelfe"})[QueryProp(P_GENDER)]);
      break;
  }
  SetProp(P_SHORT, Name(WER,0) + " studiert hier die Maechte des Feuers");
  SetProp(P_LONG, 
      Name(WER,1) + " gehoert der Rasse " + QueryProp(P_RACE) + " an "
      "und studiert hier die elementaren Maechte des Feuers. " +
      CAP(QueryPronoun(WER)) + " ist schon so lange hier, dass " +
      QueryPossPronoun(FEMALE, WER) + " Haare eine flammendrote Farbe haben.");

  create_default_druid(FEUER, 30, 10 + random(6));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "bewegt sich mittels Feuermagie herein");
  SetProp(P_MSGOUT, "bewegt sich mittels Feuermagie");
  SetProp(P_MMSGIN, "zaubert sich herein");
  SetProp(P_MMSGOUT, "zaubert sich weg");
  SetProp(P_MNPC_WAIT, ({ 50, 50, 50 }));

  SetProp(P_DIE_MSG,  " loest sich in Feuer auf.\n");
  SetProp(P_KILL_MSG, "Das Element Feuer ist das staerkste!");
  SetProp(P_MURDER_MSG, "Die Rache der Druiden wird Dich irgendwann erreichen, %s!");
  SetProp(P_REJECT, 
      ({ REJECT_KEEP, Name(WER,1) + " bedankt sich fuer die edle Spende.\n"}) );
  AddInfo(DEFAULT_INFO, "blubbert etwas unverstaendliches.\n");
  AddInfo("feuer", "Feuer ist das maechtigste aller Elemente!", "sagt: ");
  AddInfo( ({"humus", "wasser", "luft", "erz", "eis"}), 
      "Feuer ist maechtiger als dieses Element!", "sagt: ");

  SUID;

  if(!random(10))
  {
    ob = clone_object(FOCUS);
    ob->move(TO, M_NOCHECK);
    ob->SetVariables(FEUER, 1 + random(2)*random(2));
  }
  else if(!random(20))
  {
    ob = clone_object(ELERING);
    ob->move(TO, M_NOCHECK);
    ob->set_ring_element(FEUER);
  }
  if(QueryProp(P_GENDER) == FEMALE)
  {
    if(!random(3))
      CLONEME("/p/armour/boots/seidenschuhe");
    if(!random(2))
      CLONEME("/p/armour/trousers/rock_kurz");
    if(!random(4))
      CLONEME("/p/armour/gloves/seidenhandschuhe");
  }
  else
  {
    if(!random(3))
      CLONEME("/p/armour/boots/sandalen");
    if(!random(2))
      CLONEME("/p/armour/trousers/seidenhose");
    if(!random(4))
      CLONEME("/p/armour/cloak/seidenumhang");
  }
  command("trage alles");
}

