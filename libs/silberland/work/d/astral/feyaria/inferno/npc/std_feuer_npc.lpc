// std-npc fuer inferno
// 10-06-2004  Feyaria@SilberLand

#include "../def.h"

inherit STDNPC;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"\ninfernonpc"}) );
  SetProp(P_LOG_INFO, "feyaria/inferno");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "feuerraum:0:0:0") );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:1000000]));

  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  if( QueryProp(P_HP) == QueryProp(P_MAX_HP) && !random(10) )
  {
    move("/room/npcasylraum", M_TPORT);
    deep_remove();
  }
}

int Defend(int dam, string *dtype, int spell, object enemy)
{
  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (member(dtype, DT_FIRE) != -1)
  {
    ENV(TO)->Message(Name(WER,1) + " heilt sich durch das Feuer!\n", MSGFLAG_VISUAL);
    heal_self(dam/10);
    return ::Defend(0, dtype, spell, enemy);
  }
  return ::Defend(dam, dtype, spell, enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch) call_out("fire", 0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fire()
{
  tell_room(ENV(TO), sprintf("%s verbrennt sich furchtbar an "
      "%s!\n%s schreit laut auf!\n", TP->Name(WER), name(WEM,1),
      TP->Name(WER)), ({TP}));

  tell_object(TP, BS(sprintf("WAHHHH! Du verbrennst Dich furchtbar an "
      "%s!", name(WEM,1))));

  TP->AddHp(-random(20)-1);
}
