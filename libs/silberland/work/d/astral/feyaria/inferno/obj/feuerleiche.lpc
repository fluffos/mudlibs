// std-leiche fuer inferno
// 10-06-2004  Feyaria@SilberLand

inherit "std/corpse";

#include "../def.h"

void create()
{
  object killer;
  object ob;
  int level;

  if (!is_clone(TO)) return;
  ::create();
  SUID;

  if (!PO || PO->QueryProp("got_loot"))
    return;

  level = PO->QueryProp(P_LEVEL);
  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object(1);
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "inferno", level);

  PO->SetProp("got_loot", 1);
  if (strstr(file_name(PO), "sultan") != -1)
  {
    if (objectp(killer))
    {
      ASTRALMASTER->AddFlag(killer, FLAG_SULTAN,
          filter_array(PO->PresentEnemies(), #'interactive));
      write_file( LOG "sultan.kills",
          dtime(time())+": "+CAP(getuid(killer))+" toetet "+PO->name(WEN)+".\n");
    }
    ob = clone_object( EFREETI_EQUIP );
    ob->set_sultan();
    ob->move(PO, M_NOCHECK);
    BOSS_LOOT;
    ASTRALMASTER->SetTime("inferno");
  }
  if (strstr(file_name(PO), EFREETI) != -1 && !random(EFREETI_CHANCE))
    CLONELOG( EFREETI_EQUIP, PO )
  else if (!random(UMHANG_CHANCE) ||
      (level >= 40 && !random(RARE_UMHANG_CHANCE)))
    CLONELOG( ARMOUR "lavaumhang", PO)
  else if (level >= 35 && !random(FLAMINGSOWRD_CHANCE))
    CLONELOG( WEAPON "flammenzunge", PO)
  else if (!random(KEY_CHANCE - level * level / 50))
    CLONELOG( OBJ + ({"feueressenz", "feuerkristall", "feuersymbol"})[random(3)], PO)
  else if (!random(SALBE_CHANCE))
    CLONELOG( OBJ "feuersalbe", PO)
  else if (!random(WSALBE_CHANCE))
    CLONELOG( WSALBE, PO )
  else if (!random(RSALBE_CHANCE))
    CLONELOG( RSALBE, PO )
  MAGIC_WANDS
  else if (random(2))
  {
    object geld;
    geld = clone_object("/obj/money");
    geld->AddAmount(level + random(level * MONEY_FACTOR));
    geld->move(PO, M_NOCHECK);
  }
  else
  { 
    geld = clone_object(FEUERFRAGMENT);
    geld->AddAmount(random(level / 3));
    geld->move(PO, M_NOCHECK);
  }
}
