// Portal fuer Eingang zum Palast
// 5.5.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

int nr = 0;
void clone_efreeti(string type, object dest);

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Portal");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Das Portal zum Palast des Feuers");
  SetProp(P_LONG,
      "Dieses magische Portal fuehrt in den Palast des Feuers.");
  AddId( ({"portal", "\nfeuerpalastportal"}) );

  SetProp(P_WEIGHT, 1000000);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOGET, 1);

  AddCmd(({"betrete", "betritt", "betret"}), "cmd_betreten");
  call_other(ROOM "palast1", "???");
  clone_efreeti("mushir", find_object(ROOM "palast1"));
 
  call_out("clone2",2);
  call_out("clone3",4);
  
  call_out("remove", 100);
}

void clone2()
{
  call_other(ROOM "palast2", "???");
  clone_efreeti("mushir", find_object(ROOM "palast2"));
  clone_efreeti("amir", find_object(ROOM "palast2"));
}

void clone3()
{
  call_other(ROOM "palast3", "???");
  clone_efreeti("mushir", find_object(ROOM "palast3"));
  clone_efreeti("amir", find_object(ROOM "palast3"));
  clone_efreeti("sultan", find_object(ROOM "palast3"));
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(str != "portal") return 0;
  TP->move(ROOM "palast1", M_GO, "den Palast des Feuers", "betritt");
  WLOG(LOG "portal", "betritt das Portal zum Palast");
  nr++;
  if (nr >= GROUPSIZE2) 
    remove();
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  remove();
}

void clone_efreeti(string type, object dest)
{ 
  object ob;
  if (present("efreeti "+ type, dest))
    return;
  ob = clone_object(EFREETI + type);
  ob->SetProp(P_MNPC_DEFAULTROOM, file_name(dest));
  ob->SetProp(P_MNPC_AREA, ROOM);
  ob->SetProp(P_CORPSE, OBJ "feuerleiche");
  ob->SetProp(P_NOCORPSE, 0);
  ob->SetProp(P_MNPC_FLAGS, 0);
  if (type == "sultan")
    ob->SetProp(P_MAX_HP, 10000);

  ob->move(dest, M_NOCHECK);
}

                                                                                     
