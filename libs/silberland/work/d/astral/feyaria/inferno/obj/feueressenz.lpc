// Feueressenz fuer Eingang zum Palast
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Essenz der Lava");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Die Essenz der Lava");
  SetProp(P_LONG,
      "Die Essenz der Lava ist ein maechtiges Artefakt und besteht aus "
      "purem Feuer. Wofuer mag sie wohl gut sein?"); 
  AddId( ({"essenz", "lavaessenz", "essenz lava",
        "essenz der lava", "\nfeuerpalastkey2"}) );
  SetProp(P_INFO, BS(
      "Die Essenz der Lava wird fuer den Zugang zum Palast des "
      "Feuers benoetigt. Allerdings brauchst man dazu noch "
      "das Symbol des Feuers und den Kristall der Hitze. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Feuers oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_MAGIC, 1);
}

