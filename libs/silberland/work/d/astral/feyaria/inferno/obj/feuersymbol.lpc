// Feuersymbol fuer Eingang zum Palast
// 10.6.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Symbol des Feuers");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Das Symbol des Feuers");
  SetProp(P_LONG,
      "Das Symbol des Feuers ist ein maechtiges Artefakt und besteht "
      "voellig aus Feuer. Wofuer mag es wohl gut sein?");
  AddId( ({"symbol", "sfeuersymbol", "symbol feuers",
        "symbol des feuers", "\nfeuerpalastkey3"}) );
  SetProp(P_INFO, BS(
      "Das Symbol des Feuers wird fuer den Zugang zum Palast des "
      "Feuers benoetigt. Allerdings brauchst man dazu noch den "
      "Kristall der Hitze und die Essenz der Lava. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Feuers oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_MAGIC, 1);
}

