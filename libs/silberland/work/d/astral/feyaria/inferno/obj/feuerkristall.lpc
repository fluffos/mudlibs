// Feuerkristall fuer Eingang zum Palast
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, ({"Kristall der Hitze",
                    "Kristalls der Hitze",
                    "Kristall der Hitze",
                    "Kristall der Hitze"}) );
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Der Kristall der Hitze");
  SetProp(P_LONG,
      "Der Kristall des Hitze ist ein maechtiges Artefakt und besteht "
      "aus reinem Feuer. Wofuer mag er wohl gut sein?");
  AddId( ({"kristall", "hitzekristall", "kristall hitze",
        "kristall der hitze", "\nfeuerpalastkey1"}) );
  SetProp(P_INFO, BS(
      "Der Kristall des Hitze wird fuer den Zugang zum Palast des "
      "Feuers benoetigt. Allerdings brauchst man dazu noch "
      "die Essenz der Lava und das Symbol des Feuers. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Feuers oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_MAGIC, 1);

  AddCmd("oeffne", "cmd_oeffnen");
}

int cmd_oeffnen(string str)
{
  object ob1, ob2;

  if (objectp(ob1 = present("\nfeuerpalastkey2")) && 
      objectp(ob2 = present("\nfeuerpalastkey3")) && 
      ENV(TP) && strstr(file_name(ENV(TP)), "inferno/room/feuerraum") != -1)
  {
    if(member( ({"zugang", "zugang zum palast", "zugang zum palast feuers"}), 
          str) != -1)
    {
      if (ASTRALMASTER->QueryTime("inferno") > 0)
      {
        write(BS("Du versuchst, den Zugang zum Palast des Feuers zu oeffnen, "
              "aber irgendwie funkioniert das nicht. Scheinbar ist der Efreeti "
              "Sultan nicht in seinem Palast."));
        return -1;
      }
      call_other(ROOM "palast1", "???");
      if (sizeof(find_object(ROOM "palast1")->QueryProp(P_EXITS)) > 1)
      {
        write("Der Palast wurde bereits betreten!\n");
        return -1;
      }
      write(BS("Du haeltst das Symbol des Feuers in die Hoehe, sodass es in "
            "Augenhoehe vor Dir schwebt. Dannn nimmst Du den Kristall der "
            "Hitze und die Essenz der Lava in die ausgestreckten Arme und "
            "laesst Deine Magie fliessen."));
      say(BS(TPN + " haelt das Symbol des Feuers in die Hoehe, sodass es in "
            "Augenhoehe vor " + TP->QueryPronoun(WEM) + " schwebt. Dannn nimmt "+
            TP->QueryPronoun(WER) + " den Kristall der Hitze und die Essenz der "
            "Lava in die ausgestreckten Arme und laesst " +
            TP->QPP(FEMALE, WEN, SINGULAR)+ " Magie fliessen."));
      tell_room(ENV(TP),"\nDas Portal zum Palast des Feuers oeffnet sich.\n\n");
      CLONE(OBJ "portal", ENV(TP));
      find_object(ROOM "palast1")->AddExit("raus", file_name(ENV(TP)));
      ob1->remove();
      ob2->remove();
      TP->AddSp(-400);
      call_out("remove", 0);
      return 1;
    }
    notify_fail("Willst Du vielleicht den Zugang zum Palast des Feuers oeffnen?\n");
    return 0;
  }
  return 0;
}
