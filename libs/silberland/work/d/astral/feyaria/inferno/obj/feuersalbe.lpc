// Salben mit diversen Wirkungen
// 4.3.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

int salbe;
mapping prop = ([
    0: "blau-rot"; "wandelt Intelligenz in Kraft"; A_INT; A_STR,
    1: "gelb-rot"; "wandelt Geschicklichkeit in Kraft"; A_DEX; A_STR,
    2: "gruen-rot"; "wandelt Ausdauer in Kraft"; A_CON; A_STR,
    3: "rot"; "erhoeht die Kraft bis zum naechsten Tod"; A_STR; 1,
    4: "schwarz"; "erhoeht die Lebenspunkte bis zum naechsten Tod"; P_HP; 2,
    5: "weiss"; "erhoeht die Magiepunkte bis zum naechsten Tod"; P_SP; 2,
    ]);

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  salbe = random(sizeof(prop));
  SetProp(P_LONG,
    "Ein kleines Doeschen mit einer Salbe. Du fragst Dich, welche Wirkung "
    "sie haben wird, wenn Du Dich damit einschmierst. Sie hat eine "+
    prop[salbe,0]+ "e Farbe.");
  SetProp(P_NAME, "Salbe");
  SetProp(P_NAME_ADJ, prop[salbe,0] );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  AddId( ({"salbe"}) );
  AddAdjective( ({prop[salbe,0], prop[salbe,0]+"e", prop[salbe,0]+"en", 
        prop[salbe,0]+"er"}) );
  SetProp(P_INFO, 
      "Diese Salbe "+prop[salbe,1]+"." );

  SetProp(P_MATERIAL, ([MAT_CERAMIC: 20, MAT_FAT:70, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 1000);

  AddCmd( ({"schmiere", "schmier"}), "cmd_schmieren");

  SUID;
}

int cmd_schmieren(string str)
{
  string wen, was;
  int v, n;
  
  notify_fail("Wen oder was willst Du mit was einschmieren?\n");
  if(!str || sscanf(str, "%s mit %s ein", wen, was) != 2 || !id(was)) 
    return 0;
  notify_fail("Mit dieser Salbe kannst Du Dich nur selbst einschmieren!\n");
  if(wen != "mich" && wen != "mich selbst")
    return 0;
 
  write("Du schmierst Dich mit "+name(WEM)+" ein.\n");
  if(salbe<3)
  {
    v=TP->QueryRealAttribute(prop[salbe,2]);
    n=TP->QueryRealAttribute(prop[salbe,3]);
    if (n < A_MAX)
    {
      PL->SetRealAttribute(prop[salbe,2], --v);
      PL->SetRealAttribute(prop[salbe,3], ++n);
      WLOG( LOG "attr-wandel", sprintf("%s [now %d] -> %s [now %d]",
            prop[salbe,2], v, prop[salbe,3], n));
      log_file("interactive/ATTR_CHANGED",
          sprintf("[%s] %O: %s [now %d] -> %s [now %d] (Salbe)\n",
            ctime(), TP, prop[salbe,2], v, prop[salbe,3], n));
    }
  }
  else
  {
    if(!present("\nsalbenobj", TP))
      CLONE(SALBENOBJ, TP);
    if(present("\nsalbenobj", TP)->AddModifier(prop[salbe,2], prop[salbe,3]))
    {
      write("Diese Salbe wuerde bei Dir keine Wirkung haben.\n");
      return 1;
    }
  }
  remove();
  return 1;
}
