#include "../def.h"

inherit ROOM "std_feuerraum";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Palast des Feuers");
  SetProp(P_INT_LONG,
      "Du stehst in einer gewaltigen Saeulenhalle, nur sind die Saeulen keine "
      "normalen Saeulen sondern riesige Flammen, die aber fix an ihrem "
      "Platz bleiben. Die Flammen werden in Richtung Westen immer groesser, "
      "vielleicht befinden sich dort auch maechtigere Feuerwesen.");

  AddDetail( ({"boden"}),
      "Der Boden besteht nur aus Feuer, allerdings verbrennen Deine Fuesse "
      "nicht.");
  AddDetail( ({"decke"}),
      "Die Decke dieses Palastes besteht aus Feuer.");
  AddDetail( ({"waende", "wand"}),
      "Waende kannst Du hinter den Saeulen nicht erkennen.");
  AddDetail( ({"saeulenhalle", "halle"}),
      "Die riesige Saeulenhalle besteht nicht aus normalen Saeulen, sondern "
      "aus Flammen.");
  AddDetail( ({"saeulen", "saeule"}),
      "Die Saeulen sind eigentlich riesige Flammen.");
  AddDetail( ({"flammen", "flamme"}),
      "Die Flammen bleiben fix an ihrem Platz und vermitteln so den "
      "Eindruck einer Saeulenhalle.");
  AddDetail( ({"platz"}),
      "Eine starke Magie muss die Flammen an ihrem Platz halten. Du "
      "kannst foermlich die Energie spueren, die hier gebunden ist.");
  AddDetail( ({"richtung", "westen"}),
      "In Richtung Westen werden die Saeulen groesser.");
  AddDetail( ({"wesen", "Feuerwesen"}),
      "Hier leben die Feuerwesen, die diese Ebene beherrschen, die Efreetis.");
  AddDetail( ({"palast"}),
      "Dies ist der Palast des Feuers.");
  AddDetail( ({"feuer", "ebene", "ebene des feuers"}),
      "Hier ist alles aus Feuer, kein Wunder, da Du Dich ja auf der Ebene des "
      "Feuer befindest.");
  AddDetail( ({"wunder"}),
      "Eines der Wunder ist, dass Du noch nicht verbrannt bist.");
  AddDetail( ({"magie"}),
      "Es handelt sich wohl um elementare Feuermagie.");
  AddDetail( ({"energie"}),
      "In den riesigen Flammen steckt eine gewaltige Energie!");
  AddDetail( ({"efreeti", "efreetis"}),
      "Die Efreetis sind die Herrscher ueber die Ebene des Feuers.");
  AddDetail( ({"feuermagie"}),
      "Nur Feuermagie ist maechtig genug, um eine Flamme an einen Ort "
      "zu binden.");
  AddDetail( ({"herrscher", "sultan"}),
      "Der Herrscher aller Feuerwesen ist der Efreeti Sultan.");
  AddDetail( ({"ort", "eindruck"}),
      "Dieser Ort macht einen starken Eindruck auf Dich.");

  AddSmell( ({DEFAULT_SMELL, "geruch"}), 
      "Es riecht nach Feuer.");
  AddSound( ({DEFAULT_SOUND, "zischen", "flammen"}), 
      "Du hoerst das Zischen der Flammen.");

  AddExit( "westen", ([
        EX_DEST: ROOM "palast2",
        EXG_ID: "efreeti mushir",
        EXG_PLMSG: "Der Efreeti Mushir laesst Dich nicht vorbei.\n",
        EXG_RMMSG: "Der Efreeti Mushir laesst @wen@ nicht vorbei.\n"]) );
}

void init()
{
  ::init();
  set_next_reset(2 * 3600);
}

void reset()
{ 
  ::reset();
  RemoveExit("raus");
}

