#0:0
text_short ({"Im flammenden Inferno","In der Ebene des Feuers","Die gluehende Ebene des flammenden Infernos","Die Ebene des Feuers","Das flammende Inferno - die Ebene des Feuers","Mitten in der Ebene des Feuers","Das flammende Inferno",})
text_long ([6:({"Das Feuer wird Dich bald veschlingen.","Hoffentlich kommst Du bald in eine kuehlere Gegend, sonst verbrennst Du noch.","Warum hast Du Dich bloss in diese lebensfeindliche Gegend gewagt.",}),2:({"Ringsherum siehst Du nur Feuer.","In allen Richtungen siehst Du nur Feuer.","Ueberall Feuer, wohin Du auch schaust.",}),5:({"Die Luft scheint zu kochen.","Der Himmel hat eine hellrote Farbe.","Der Himmel ist glutrot.",}),1:({"Du befindest Dich mitten im flammenden Inferno, dem Reich des Feuers.","Du befindest Dich in der Ebene des Feuers, auch flammendes Inferno genannt.","Du bist im flammende Inferno, auch Ebene des Feuers genannt.",}),4:({"Der Boden ist glutrot.","Der Boden ist strohtrocken und von dunkelroter Farbe.","Der Boden ist gluehend heiss.",}),3:({"Die gewaltige Hitze bringt Dich fast um.","Es ist unmenschlich heiss hier.","Die Hitze bringt Dich fast um den Verstand.",}),])
text_details (["hitze":({"Die Hitze bringt Dich fast um den Verstand.","Die gewaltige Hitze bringt Dich fast um.","Es ist unmenschlich heiss hier.",}),"verstand":({"Dein Verstand wird durch die Hitze fast zerkocht.",}),"atem":({"Der wird Dir von der heissen Luft geraubt, darum siehst Du ihn nicht :)",}),"boden":({"Der Boden ist glutrot.","Der Boden ist strohtrocken und von dunkelroter Farbe.","Der Boden ist gluehend heiss.",}),"rot":({"Hier ist alles Rot.","Hellroter Himmel, dunkelroter Boden.... alles hier ist Rot.",}),"farbe":({"Rot ist die beherrschende Farbe hier.","Es gibt hier nur eine Farbe.... ROT!",}),"gegend":({"Die Gegend hier ist extrem lebensfeindlich.",}),"luft":({"Die Luft scheint zu kochen.","Die Luft hier ist so heiss, dass es Dir richtiggehend den Atem raubt.",}),"himmel":({"Der Himmel hat eine grelle hellrote Farbe.","Der Himmel ist glutrot.",}),])
