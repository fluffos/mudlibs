#include "../def.h"

inherit ROOM "std_feuerraum";

void create()
{
  string *npcs;

  if(!is_clone(TO)) return;
  ::create();
  PO->CustomizeObject();

  AddDetail( ({"inferno", "reich", "reich des feuers", "flammendes inferno"}),
      "Das flammende Inferno, es wird von Druiden auch als die elementare "
      "Ebene des Feuers bezeichnet. Es wird von den Efreetis beherrscht.");
  AddDetail( ({"efreeti", "efreetis", "feuerwesen"}),
      "Die Efreetis sind die Herrscher ueber die Ebene des Feuers.");
  AddDetail( ({"herrscher"}),
      "Der Herrscher aller Feuerwesen ist der Efreeti Sultan.");
  AddSpecialDetail(({"efreeti sultan", "sultan", "macht"}), "det_sultan");
  AddDetail( ({"Feuer"}),
      "Feuer gibt es hier viel, Du bist ja auch in der Ebene des Feuers.");
  AddDetail( ({"ebene"}),
      "Ebene bedeutet hier keine Landschaftsform oder dass hier alles ganz "
      "flach ist ist. Vielmehr stellt man sich vor, dass die verschiedenen "
      "Ebenen wie die Stockwerke eines Hauses uebereinander liegen.");
  AddDetail( ({"stockwerk", "stockwerke", "haus"}),
      "So kann man es sich vorstellen.");
  AddDetail( ({"landschaftsform", "bedeutung"}),
      "Nein, diese Bedeutung von Ebene ist nicht gemeint.");
  AddDetail( ({"druiden"}),
      "Druiden haben grosse Macht ueber die Elemente. ");
  AddDetail( ({"elemente", "wasser", "luft", "eis", "humus", "erz"}),
      "Die Elemente sind Wasser, Eis, Humus, Luft, Erz und natuerlich Feuer.");
  AddDetail( ({"macht", "verstaendnis"}),
      "Die Macht der Druiden ueber die Elemente kommt aus dem Verstaendnis "
      "der Elementartheorie.");
  AddDetail( ({"elementartheorie"}),
      "Vereinfacht sagt die Elementartheorie, dass es sechs Elemente gibt, "
      "wobei sich jeweils zwei immer entgegengesetzt sind, zum Beispiel "
      "Feuer und Wasser.");
  AddDetail( ({"beispiel"}),
      "Ein anderes Beispiel ist Luft und Erz.");
  AddDetail( ({"richtung", "richtungen"}),
      "In allen Richtungen siehst Du nur Feuer.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "feuer"}), 
      "Es riecht irgendwie verbrannt.");
  AddSound( ({DEFAULT_SOUND, "feuer", "flammen", "zischen"}), 
      "Du hoerst das Zischen des Flammen.");
 
  npcs =({
      FEUERFROSCH,
      FEUERPILZ,
      FEUERTEUFEL,
      FEUERZYKLOP,
      FEUERGEIST,
      NPC "feuersalamander",
      NPC "feuerelementar",
      NPC "feuerdruide",
      NPC "flammenmonster",
      NPC "feuerschlange",
      NPC "lavaechse",
      NPC "flamme",
      });
  if (random(100) < NPC_CHANCE)
    AddItem( npcs + (!random(3) ? ({EFREETI "mushir"}) : ({})), 
        REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES,
          P_MNPC_WAIT: ({ 30, 60, 60 }),
          P_HEAL: 200,
          P_CORPSE: OBJ "feuerleiche",
          P_NOCORPSE: 0,
          P_TEMPERATURE_RANGE: ([T_RANGE_MIN:-100,T_RANGE_MAX:100])]) ); 

  if (random(100) < RARE_NPC_CHANCE)
    AddItem(  npcs + ({ 
          CORRUPTOR,
          EFREETI "amir",
          NPC "feuerriese",
          NPC "phoenix",
          }), REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES,
          P_MNPC_WAIT: ({ 60, 90, 90 }),
          P_HEAL: 500,
          P_CORPSE: OBJ "feuerleiche", 
          P_NOCORPSE: 0,
          P_ASTRAL_RARE_NPC: 1,
          P_TEMPERATURE_RANGE: ([T_RANGE_MIN:-100,T_RANGE_MAX:100])]) ); 

}

string det_sultan()
{
  if (ASTRALMASTER->QueryTime("inferno") > 0)
    return "Die Macht des Efreeti Sultan ist momentan sehr schwach.\n";
  else
    return "Du kannst die Macht des Efreeti Sultan hier foermlich fuehlen.\n";
}
