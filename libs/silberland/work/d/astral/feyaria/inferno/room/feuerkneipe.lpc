
#include "../def.h"
#include <pub.h>

inherit  "std/pub";

string read_liste();

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "Die Feuerkneipe");
  SetProp(P_INT_LONG,
      "Du stehst in der Feuerkneipe. Allerdings erinnert hier nichts an eine "
      "normale Kneipe, ausser dass man sich hier Essen und Getraenke "
      "bestellen kann. Serviert werden sie von seltsamen Feuerwesen, die "
      "wie aus dem Nichts erscheinen, sobald man etwas bestellt hat und "
      "sich wieder in Feuer aufloesen, sobald sie das Gewuenschte gebracht "
      "haben. Ein breites Portal fuehrt in den Nexus und ein kleiner "
      "Ausgang fuehrt weiter in diese feurige Welt.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 33, ENV_TERRAIN: TT_OTHER]) );

  AddDrink("Fluessige Lava", 
      ({"lava", "fluessige lava"}),
      410, 41, 0, 9,
      ({"Fluessige Lava tropft von der Decke genau in Deinen Mund. "
       "Du verbrennst Dir Deine Kehle!",
       "&& verbrennt sich die Kehle an fluessiger Lava."}));
  AddDrink("Brennender Schnaps", 
      ({"schnaps", "brennender schnaps"}),
      510, 41, 9, 0,
      ({"Du bekommst ein Stamperl mit brennendem Schnaps!",
       "&& trinkt brennenden Schnaps."}));
  AddDrink("Feuerzangenbowle", 
      ({"bowle", "feuerzangenbowle"}),
      610, ({171,0}), 15, 5,
      ({"Du trinkst einen Schluck aus der Feuerzangenbowle und fuehlst die "
       "gluehende Hitze Deine Kehle hinunterrinnen.",
       "&& trinkt einen Schluck aus der Feuerzangenbowle."}));

  AddFood ( "Chili con chili", 
      ({"chili", "chili chon chili"}),
      127, 16, 4,
      ({"Du bekommst Chilischoten in einer Chilisauce. Es ist heiss und "
       "scharf.. zusammengefasst: HOT!",
       "&& ist lebensmuede und probiert Chili con Chili."}) );
  AddFood ( "Flambierter Scheiterhaufen", 
      ({"scheiterhaufen", "flambierter scheiterhaufen"}),
      1133, ({100,70,30}), 21,
      ({"Du bekommst einen brenndenden Haufen scheiterfoermiger "
       "Fleischstuecke, die Du schnell verschlingst. Kleine Flammen "
       "zuengeln aus Deinem Mund und Deinen Ohren!",
       "&& isst einen ganzen Haufen voller flambierter Fleischstuecke. "
       "Kleine Flammen zuengeln aus &=em Mund und Ohren."}) );
  AddFood ( "Erstarrte Flammen", 
      ({"erstarrte flammen", "flammen"}),
      1234, ({19,99,55}), 13,
      ({"Du bekommst erstarrte Flammen serviert. Du verbrennst Dir aber "
       "trotzdem die Finger. Aber irgendwie fuehlst Du Dich magisch "
       "aufgeladen.",
       "&& verbrennt sich die Finger an erstarrten Flammen."}) );


  AddSpecialDetail( ({"speise", "speisen", "getraenke", "getraenk", 
        "bestellen", "essen", "trinken", "bestellungen"}), 
      "det_menu");

  AddDetail( ({"boden"}),
      "Der Boden besteht komplett aus Feuer, aber aus irgendeinem Grund "
      "verbrennst Du nicht.");
  AddDetail( ({"waende", "wand", "decke"}),
      "Alles nur Feuer.");
  AddDetail( ({"grund"}),
      "Es wird wohl ein magischer Grund sein.");
  AddDetail( ({"kneipe", "feuerkneipe"}),
      "Du befindest Dich in der Feuerkneipe.");
  AddDetail( ({"feuerwesen", "wesen"}),
      "Die Feuerwesen erscheinen nur, um Bestellungen zu erfuellen und "
      "verschwinden dann sofort wieder.");
  AddDetail( ({"portal", "nexus"}),
      "Ein breites Portal fuehrt in den Nexus.");
  AddDetail( ({"ausgang", "welt"}),
      "Ein kleiner Ausgang fuehrt hinaus in die feurige Welt des flammenden "
      "Infernos.");
  AddDetail( ({"inferno", "flammendes inferno"}),
      "So nennt man in Fachkreisen die Ebene des Feuers.");
  AddDetail( ({"feuer"}),
      "Feuer gibt es hier viel, Du bist ja auch in der Ebene der Feuer.");
  AddDetail( ({"ebene"}),
      "Ebene bedeutet hier keine Landschaftsform oder dass hier alles ganz "
      "flach ist ist. Vielmehr stellt man sich vor, dass die verschiedenen "
      "Ebenen wie die Stockwerke eines Hauses uebereinander liegen.");
  AddDetail( ({"stockwerk", "stockwerke", "haus"}),
      "So kann man es sich vorstellen.");
  AddDetail( ({"landschaftsform", "bedeutung"}),
      "Nein, diese Bedeutung von Ebene ist nicht gemeint.");
  AddDetail( ({"fachkreis", "fachkreise"}),
      "Zum Beispiel bei den Druiden.");
  AddDetail( ({"druiden"}),
      "Druiden haben grosses Wissen ueber die Elemente.");
  AddDetail( ({"elemente", "wasser", "luft", "eis", "humus", "erz"}),
      "Die Elemente sind Wasser, Eis, Humus, Luft, Erz und natuerlich Feuer.");
  AddDetail( ({"macht", "verstaendnis", "wissen"}),
      "Die Macht der Druiden ueber die Elemente kommt aus dem Verstaendnis "
      "der Elementartheorie.");
  AddDetail( ({"elementartheorie"}),
      "Vereinfacht sagt die Elementartheorie, dass es sechs Elemente gibt, "
      "wobei sich jeweils zwei immer entgegengesetzt sind, zum Beispiel "
      "Feuer und Wasser.");
  AddDetail( ({"beispiel"}),
      "Ein anderes Beispiel ist Eis und Humus.");
  AddDetail( ({"nichts"}),
      "Du siehst hier nichts.");
  AddDetail( ({"gewuenschte"}),
      "Du solltest selber wissen, was Du wuenscht.");

  AddSmell( ({DEFAULT_SMELL}), 
      "Es riecht verbrannt.");
  AddSound( ({DEFAULT_SOUND, "kneipengeraeusche"}), 
      "Obwohl es sich hier um eine ganz seltsame Kneipe handelt, hoerst "
      "Du trotzdem die ueblichen Kneipengeraeusche.");

  AddExit ("raus", ([EX_MSG: "raus",
                     EX_FUNC: "raus"]) );
  AddExit ("nexus", ([EX_MSG: "zurueck in den Nexus",
                      EX_DEST: NEXUS]) );
  
  RemoveItem("/obj/topliste");
  AddDetail( ({"liste", "infernoliste", "topliste", "topinfernoliste", 
        "top-infernoliste"}), #'read_liste);
  AddReadDetail( ({"liste", "infernoliste", "topliste", "topinfernoliste", 
        "top-infernoliste"}), #'read_liste);
  SetProp(P_ZONE, "Inferno");
#include "../../where.h"
}

mixed raus(string verb)
{
  object ob;
  if (!IS_LEARNING(TP) && TP->QueryProp(P_TEMPERATURE_RANGE)[1] +
      TP->QueryProp(P_TOTAL_TEMPERATURE_PROTECTION)[1] -
      TP->QueryProp(P_TEMPERATURE_OFFSET) < 45)
  {
    write("Das wuerde Dir ohne einen zusaetzlichen Hitzeschutz viel zu "
        "heiss werden!\n");
    return 1;
  }
  if(ob = find_living("feuerkneipeneingang"))
    return file_name(ENV(ob));
  else
  {
    call_other(ROOM "feuerraum:0:0:0", "reset");
    return ROOM "feuerraum:0:0:0";
  }
}

string det_menu()
{
  TP->command_me("menue");
  return "";
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  return ::int_long(viewer, viewpoint, shortflag) +
    "Die Top-Infernoliste.\n";
}

string read_liste()
{
  write(
    "Die Liste der beruehmtesten Helden im flammenden Inferno\n"
    "--------------------------------------------------------\n");
  ASTRALMASTER->FameList("inferno");
  return "";
}
