// Flammenzunge, der feurige Speer
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Flammenzunge, der feurige Speer");
  SetProp(P_LONG,
    "Flammenzunge ist ein Speer, der nur aus Flammen zu bestehen scheint. "
    "Sicher muss man sehr maechtig sein, um diese Waffe fuehren zu koennen.");

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Flammenzunge");
  AddId( ({"flammenzunge", "speer"}) );
  SetProp(P_ARTICLE, 0);

  AddDetail( ({"flammen"}),
    "Die Flammen dieses Speeres sind echt! Pass auf, dass Du Dich nicht "
    "verbrennst.");
  SetProp(P_INFO,
      "Flammenzunge scheint feindliches Feuer abzufangen und schuetzt Dich "
      "daher vor Feuer.");

  SetProp(P_VALUE, 4000);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MATERIAL, ([ MAT_FIRE:100 ]) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_FIRE}) );
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 50);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());
}


int WieldFunc(object waffe, int silent)
{
  if (!silent)
    write("Deine Finger beginnen zu gluehen. Dieser Speer ist wirklich "
        "heiss!\n");
  TP->AddHp(-1); // Man verliert einen Lebenspunkt beim Zuecken.
  MENV->AddResistanceModifier( ([DT_FIRE:-0.1]) );
  return 1;
}

int UnwieldFunc(object waffe, int silent)
{
  if( !silent )
    tell_object(QueryProp(P_WIELDED),
        "Die Brandblasen auf Deinen Fingern schauen schrecklich aus.\n");
  QueryProp(P_WIELDED)->RemoveResistanceModifier();
  return 1;
}

int HitFunc(object enemy)
{
  // Ab und zu wird man von den Flammen selber getroffen!
  if( !random(50) )  // Bei ca jedem 50sten Schlag
  {
    tell_object(QueryProp(P_WIELDED),
        "Flammenzunge versengt Deine Finger.\n");
    QueryProp(P_WIELDED)->AddHp(-1);
  }
  return random(10);
}

void reset()
{
  object wer;
  if (!is_clone(this_object())) return;
  ::reset();

  if (objectp(wer = QueryProp(P_WIELDED)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die feurige Energie von Flammenzunge heilt Dich.\n");
    wer->heal_self(77);
  }
}

