// Portalrune fuer Abgrund
// 3.9.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

int destination = 0;
int counter = 0;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Runenstein");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein undefinierter Runenstein");
  SetProp(P_LONG,
      "Ein seltsamer Runenstein. Wofuer der wohl gut ist?");
  AddId( ({"rune", "stein", "runenstein", "\nabgrundportalrune"}) );
  SetProp(P_INFO,
      "Mit diesem Runenstein kann man einen Riss in die Welten reissen.\n");

  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_STONE}));
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);

  AddCmd(({"reisse", "reiss"}), "cmd_reissen");
}

int cmd_reissen(string str)
{
  object ob;
  notify_fail("Willst Du etwa einen Riss in die Welten reissen?\n");

  if(str != "riss in welten") 
    return 0;
  if (strstr(file_name(ENV(TP)), ROOM "abgrund") == -1)
  {
    write(BS("Du versuchst, einen Riss in die Welten zu reissen, aber " +
          name(WER,1) + " zerbroeselt zu Staub.")) ;
    say(BS(TP->Name(WER,1) + " versucht, einen Riss in die Welten zu "
          "reissen, aber nichts passiert, nur ein Runenstein zerbroeselt "
          "zu Staub.")) ;
  }
  else
  {
    write(BS("Du wirfst " + name(WEN,1) + " auf den Boden und "
          "ploetzlich entsteht ein Riss in den Welten."));
    say(BS(TP->Name(WER,1) + " wirft " + name(WEN,0) + " auf den Boden und "
          "ploetzlich entsteht ein Riss in den Welten."));
    ob = clone_object(OBJ "portal");
    ob->SetDestination(destination);
    ob->move(ENV(TP), M_NOCHECK);
  }
  remove();
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  if ((counter++) > 1000)
    remove();
}

void SetPortal(mixed d)
{
  string adj;

  d = to_int(d);
  if (d < 0 || d > 4)
    return;
  if (random(3))
    d = 0;
  destination = d;
  adj = ({"rund", "quadratisch", "dreieckig", "achteckig", "siebeneckig"})[d];
  SetProp(P_NAME_ADJ, adj);
  AddAdjective( ({adj, adj +"en", adj+"er"}) );
  SetProp(P_SHORT, Name(WER,0));
}

