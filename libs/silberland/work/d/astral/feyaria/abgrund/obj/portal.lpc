// Portal fuer Abgrund
// 3.9.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

int nr = 0;
int destination;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Riss");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Ein Riss zwischen den Welten");
  SetProp(P_LONG,
      "Ein Riss in den Welten hat sich aufgetan. Wo wirst Du wohl hinkommen, "
      "wenn Du ihn betrittst?");
  AddId( ({"riss", "\nabgrundportal"}) );

  SetProp(P_WEIGHT, 1000000);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOGET, 1);

  AddCmd(({"betrete", "betritt", "betret"}), "cmd_betreten");
  set_next_reset(10*60);
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(str != "riss") 
    return 0;
  write("Du betrittst den Riss und bist ploetzlich ganz wo anders.\n");
  TP->move( ({NEXUS, ROOM "abgrund:2:1:0", ROOM "abgrund:3:1:0", 
        ROOM "abgrund:4:1:0", ROOM "palast1"})[destination], M_TPORT|M_NOCHECK);
  nr++;
  if (nr >= GROUPSIZE)
    remove();
  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  remove();
}

void SetDestination(int d)
{
  destination = d;
}

void remove(int silent)
{
  if (!silent && MENV)
    tell_room(MENV, "Der Riss zwischen den Welten schliesst sich wieder.\n");
  ::remove(silent);
}
