// Das schwarze Loch
// 2004-12-20 Feyaria@SilberLand

#include "../def.h"

#define IN_COST 3
#define OUT_COST 6

inherit "std/container";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein schwarzes Loch");
  SetProp(P_LONG,  
    "Das schwarze Loch ist ein kopfgrosses, kugelfoermiges Objekt, das "
    "voellig schwarz ist. Nur wenn Du nahe herangehst, siehst Du, dass es "
    "eigentlich ein Riss in den Welten ist. Dahinter befindet sich eine "
    "seltsame, konturlose, graue Welt, in der einige Gegenstaende schweben. "
    "Sicher handelt es sich dabei um irgendeine fremde Dimension.");
  SetProp(P_NAME, "Loch");
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"loch", "\nblackhole", "blackhole"}) );
  AddAdjective( ({"schwarz", "schwarzes", "schwarze", "schwarzen", "schwarzem"}) );
  SetProp(P_INFO, 
      "Das schwarz Loch eignet sich hervorragend, um Dinge aufzubewahren, "
      "allerdings kostet es Magiepunkte, um den Kontakt zu dieser fremden "
      "Dimension herzustellen.");

  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY: 50, MAT_SHADOW: 50]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10000);
  SetProp(P_MAX_WEIGHT, 20000);
  SetProp(P_WEIGHT_PERCENT, 6);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}

int check_zone()
{
  string *filenames;

  filenames = explode(file_name(environment(this_player())), "/");
  if (sizeof(filenames) < 6 || filenames[1]!= "astral")
  {
    write(BS("Die fremde Dimension ist zu weit weg, Du kannst hier keine "
          "Sachen in das schwarze Loch hineinstecken oder herausnehmen."));
    return 1;
  }
  return 0;
}

varargs int PreventInsert(object ob) 
{
  if (check_zone())
    return 1;
  if (TP->QueryProp(P_SP) < IN_COST)
  {
    write("Du hast zu wenig Magiepunkte, um etwas in das schwarze Loch zu "
        "stecken.\n");
    return 1;
  }
  TP->AddSp(-IN_COST);
  return ::PreventInsert(ob); 
}

varargs int PreventLeave(object ob, mixed dest)
{
  if (check_zone())
    return 1;
  if (TP->QueryProp(P_SP) < OUT_COST)
  {
    write("Du hast zu wenig Magiepunkte, um etwas aus dem schwarze Loch zu "
        "nehmen.\n");
    return 1;
  }
  TP->AddSp(-OUT_COST);
  return ::PreventLeave(ob, dest);
}

mixed _query_noget()
{
  if(this_player() && present("\nblackhole", this_player()))
    return "Mehr als ein schwarzes Loch wuerde fatale Konsequenzen fuer "
        "Dich haben!\n";
  return 0;
}

