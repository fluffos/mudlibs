// Heiltrank fuer Abgrund
// 04-09-2004 Feyaria@SilberLand

inherit "std/unit";
inherit "std/food"; 

#include "../def.h"
#include <food.h>

void create()
{
  if (!is_clone(this_object())) return;
  unit::create();
  SetProp(P_SHORT, "Ein daemonischer Trank");
  SetProp(P_LONG, 
   "Eine kleines Glasflaeschchen in dem sich eine schwarze Fluessigkeit "
   "befindet. Man kann es trinken.");
  SetCoinsPerUnits(100, 1);
  SetGramsPerUnits(20, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, ({"Trank", "Traenke"}) );
  SetProp(P_NAME_ADJ, "daemonisch");
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([ MAT_GLASS: 15, MAT_MISC_DRUG: 85]) );

  AddSingularId( ({"trank","glasflaeschchen","flaeschchen","heiltrank"}) );
  AddPluralId(  ({"traenke", "heiltraenke"}) );
  AddId( ({"daemonentrank"}) );

  AddCmd( ({"trink", "trinke"}), "eat");
}


varargs int eat(string what, object pl)
{
  int val;
  if (file_name(environment(this_player()))[0..30] == ROOM)
  {
    if (TP->QueryProp("last_time_demon_potion") + 60 > time()) 
      val = 50;
    else
      val = 150;
    SetProp(P_FOOD_INFO, ([
       F_HEAL: val + random(41), F_DRINK: 5, F_ALCOHOL: 0,
       F_VERB: "trinken" ,
       F_MSG:"Du trinkst den dunklen Trank. \n"
             "Irgendwie fuehlst Du Dich viel besser.\n",
       F_MSG_ROOM:"trinkt ein Flaeschchen aus.\n" ]) );
    TP->SetProp("last_time_dark_potion", time());
    if (TP->QueryProp(P_ALIGN) > -500)
      TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN) - random(50));
  }
  else
  {
    // ausserhalb heilt es weniger
    if (TP->QueryProp("last_time_demon_potion") + 90 > time()) 
      val = 5;
    else
      val = 15;
    SetProp(P_FOOD_INFO, ([F_HEAL: val + random(15), F_DRINK: 5, F_ALCOHOL: 0,
           F_VERB: "trinken" ,
           F_MSG:"Du trinkst den dunklen Trank. \n"
                 "Irgendwie fuehlst Du Dich kaum besser.\n",
           F_MSG_ROOM:"trinkt ein Flaeschchen aus.\n" ]) );
    TP->SetProp("last_time_dark_potion", time());
    if (TP->QueryProp(P_ALIGN) > -500)
      TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN) - 100);
  }
  return ::eat(what, pl);
}

int second_life(object pl)
{
  AddAmount(-1);
  return QueryProp(P_AMOUNT);
}

