// std-leiche fuer abgrund
// 03-09-2004  Feyaria@SilberLand

inherit "std/corpse";

#include "../def.h"

void create()
{
  object killer;

  if (!is_clone(TO)) return;
  ::create();

  SUID;
  if (!PO || PO->QueryProp("got_loot"))
    return;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object(1);
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "abgrund", PO->QueryProp(P_LEVEL));

  PO->SetProp("got_loot", 1);
  if (strstr(file_name(PO), "daemonenfuerstin") != -1)
  {
    BOSS_LOOT;
    ASTRALMASTER->SetTime("abgrund");
  }

  if (strstr(file_name(PO), "thonis") != -1 && random(100) < EQUIP_CHANCE_THONIS)
    CLONELOG(ARMOUR "thonispanzer", PO)
  else if (strstr(file_name(PO), "sturmdaemon") != -1 && random(100) < EQUIP_CHANCE_STORM)
    CLONELOG(ARMOUR "sturmhose", PO)
  else if (strstr(file_name(PO), "terrordaemon") != -1 && random(100) < EQUIP_CHANCE_TERROR)
    CLONELOG(ARMOUR "terrorarmschienen", PO)
  else if (strstr(file_name(PO), "schwertdaemon") != -1 && random(100) < EQUIP_CHANCE_SWORD)
    CLONELOG(ARMOUR "schwertguertel", PO)
  else if (strstr(file_name(PO), "hoellenhund") != -1 && random(100) < EQUIP_CHANCE_DOG)
    CLONELOG(ARMOUR "hoellenamulett", PO)
  else if (strstr(file_name(PO), "hoellenkatze") != -1 && random(100) < EQUIP_CHANCE_CAT)
    CLONELOG(ARMOUR "hoellenring", PO)

  if (!random(PORTAL_CHANCE) && strstr(file_name(ENV(PO)), ":") > 0)
  {
    object portal;
    portal = clone_object(OBJ "portalrune");
    portal->SetPortal(random(3) ? explode(file_name(ENV(PO)),":")[1] : 0);
    portal->move(PO, M_NOCHECK);
    WLOG(LOG "portal", "findet " + portal->name(WEN,1) + " von " + PO->name(WEM)); 
  }
  else if (!random(STACHEL_CHANCE))
  {
    string s;
    s = ({OBJ "stacheln", OBJ "dornen", OBJ "hoerner"}) [random(3)];
    CLONELOG(s, PO);
  }
  else if (!random(WSALBE_CHANCE))
    CLONELOG(WSALBE , PO)
  else if (!random(RSALBE_CHANCE))
    CLONELOG(RSALBE , PO)
  MAGIC_WANDS
  else if (!random(HOLE_CHANCE) && PO->QueryProp(P_LEVEL) > 20 + random(20))
  {
    CLONE(OBJ "blackhole", PO);
    WLOG(LOG "rare", "schwarzes Loch von " + PO->name(WEM)); 
  }
  else if (PO->QueryProp(P_LEVEL) > random(50))
    CLONE( OBJ "heiltrank", PO);
}
