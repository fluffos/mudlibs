// ein Daemonid
// 01-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_abgrund_npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Daemonid");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Daemonid");
  SetProp(P_LONG, 
    "Der Daemonid ist ein Mischwesen aus Daemonen und Menschen, entstanden "
    "durch magische Experimente von skrupellosen, boesen Zauberern. "
    "Er hat eine menschenaehnliche Gestalt, aber seine Klauen, Hoerner und "
    "Krallen deuten auf das daemonische Erbe hin.");
  AddId(({"daemonid", "daemon"}));

  create_default_npc(17);
  SetProp(P_HANDS, ({" mit seinem Klauen", 200, ({DT_RIP, DT_UNHOLY}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Daemon");
  AddClass(CL_FLYING);
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_AGGRESSIVE, 0.7);

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft weg");
  SetProp(P_MNPC_WAIT, ({ 20, 30, 30 }));

  SetProp(P_DIE_MSG,  " stirbt einen Daemonentod.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, ""}) );
  AddInfo(DEFAULT_INFO, "sagt: Daemonen sind die besten!\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(1, 300, 
      Name(WER,1)+ " trifft Dich mit der Macht der Daemonen.\n",
      Name(WER,1)+ " trifft @WEN mit der Macht der Daemonen.\n",
     ({DT_UNHOLY}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 400, 
      Name(WER,1)+ " attackiert Dich mit seinen Dornen, Stacheln und Hoernen.\n",
      Name(WER,1)+ " attackiert @WEN mit seinen Dornen, Stacheln und Hoernen.\n",
     ({DT_RIP, DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));

  SUID;

}

