// daemonenfuersting - abgrund
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_abgrund_npc";
inherit "std/npc/spells";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Zyr-Xarra, die finstere Herzogin der Daemonen");
  SetProp(P_LONG, 
    "Vor Dir steht Zyr-Xarra, die finstere Herzogin, auch Daemonenfuerstin "
    "genannt. Sie ist die Herrscherin ueber den Abgrund und Herrin ueber "
    "alle Daemonen und somit eines der maechtigsten Wesen in allen Sphaeren "
    "des SilberLandes. Man sagt ihr ungebrochene Loyalitaet DEM BOESEN "
    "gegenueber zu. Sie ist eine grosse, sehr weibliche Gestalt und ganz in "
    "schwarzes Leder gekleidet. Ihr bleiches Gesicht wird von blauschwarzem "
    "Haar umrahmt und von einer fuenfstrahligen Daemonenkrone gekroent. "
    "Ihre roten Augen gluehen wie Feuer. Sie strahlt eine Aura von absoluter "
    "Boesartigekeit aus.");
  SetProp(P_NAME, "Zyr-Xarra");
  SetProp(P_KILL_NAME, "Die finstere Herzogin der Daemonen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"zyr-xarra", "herzogin", "finstere herzogin", "fuerstin", 
        "daemonenfuerstin", "daemon", "daemonin", "NOWIMPY", "NOFALLDOWN"}));

  create_default_npc(66, 9999);
  SetProp(P_ALIGN, -1000);
  SetProp(P_HANDS, ({" mit daemonischer Macht", 666, ({DT_UNHOLY, DT_RIP}) }));
  SetProp(P_SIZE, 666);
  SetProp(P_MAX_HANDS, 13);
  SetProp(P_NOMAGIC, 50);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_HOLY:      0.3, DT_UNHOLY:  -1, DT_TERROR: -1,  DT_SOUND: -0.5,
        DT_ELECTRIC: -0.2, DT_LIGHT:  0.2, DT_COLD: -0.4,  DT_EXPLOSION: -0.5,
        DT_FIRE:     -0.3, DT_WATER:  0.1, DT_AIR: -0.3,   DT_MIND: -0.1,
        DT_POISON:   -0.3, DT_ACID:  -0.3, DT_MAGIC: -0.3, DT_LIGHTNING:  0.1, 
        DT_SLASH:    -0.4, DT_RIP:   -0.2, DT_PIERCE: -0.2, 
        DT_BLUDGEON: -0.3, DT_WHIP:  -0.5, DT_SQUEEZE: -0.5,]) );
  SetProp(P_KILL_MSG, "Dein Leiche wird als Futter fuer meine Daemonen dienen!");
  SetProp(P_MURDER_MSG, "Verflucht seist Du auf immer und ewig, %s! Meine "
      "daemonischen Diener werden Dich hetzen und fangen und auf ewige "
      "Zeiten foltern und quaelen, bis auch Du zu einem meiner Daemonen wirst "
      "und mir bis in die Unendlichkeit als Sklave zu Fuessen liegst!");

  Set(P_SPELLRATE, 99);
  AddDefaultSpell(1, 999, DS_SLOW, 3);
  AddDefaultSpell(1, 999, DS_ANTIMAGIC, 3);
  AddDefaultSpell(1, 999, DS_POISON);
  AddDefaultSpell(1, 666, DS_MASS_DAMAGE,
      Name(WER,1) + " umhuellt Dich mit einer daemonischen Aura.\n",
      Name(WER,1) + " umhuellt Dich mit einer daemonischen Aura.\n",
      DT_UNHOLY);
  AddSpell(1, 1666, 
      Name(WER,1) + " umhuellt Dich mit einer daemonischen Aura.\n",
      Name(WER,1) + " umhuellt @WEN mit einer daemonischen Aura.\n",
      DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

  CLONEME( ARMOUR "daemonenkrone");
  command("trage alles");
}

int _query_disable_attack() { return 0; }

int _query_disable_spells() { return 0; }

mixed _query_skill_attr() { return 0; }

int _set_spellrate() { return 99; }

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  if (!query_once_interactive(enemy))
  { 
    if (enemy->is_class_member(CL_DEMON))
    {
      enemy->remove();
      return 0;
    }
    dam /= 2;
  }
  if (dam > 666) dam = 666;
  return ::Defend(dam, dtype, spell, enemy);
}

void Attack(object enemy)
{
  object *enemies;
  SetProp(P_AGGRESSIVE, 1);
  if (!query_once_interactive(enemy) && 
      sizeof(enemies = filter_array(PresentEnemies(), #'interactive)))
    enemy = enemies[random(sizeof(enemies))];

  ::Attack(enemy);
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  ASTRALMASTER->AddFlag(killer, FLAG_DEMON,
      filter_array(PresentEnemies(), #'interactive));
  write_file( LOG "fuerst.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  environment()->AddExit("nexus", 
      ([EX_DEST: NEXUS, 
        EX_TESTFUNC: "nexus",
        EX_PLMSG   : "\nDeine Ausruestung wird auf wundersame Weise entflucht.\n\n"
      ]));
  ::die(poisondeath);
}

