// ein Gereliss
// 01-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_abgrund_npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Gereliss");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Gereliss");
  SetProp(P_LONG, 
    "Dieser gefluegelte Daemon ist unter dem Namen Gereliss bekannt. "
    "Er hat eine humanoide Gestalt, besteht aber fast nur aus Haut und "
    "Knochen, so duerr ist er. Er hat riesige fledermausartige Fluegel, "
    "mit denen er sich hier erstaunlich schnell bewegen kann. Mit seinen "
    "klauenartigen Fingern versucht er Dich zu zerfleischen.");
  AddId(({"gereliss", "daemon"}));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinem Klauen", 200, ({DT_RIP, DT_UNHOLY}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Daemon");
  AddClass(CL_FLYING);
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_AGGRESSIVE, 1);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weg");
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }));

  SetProp(P_DIE_MSG,  " zerbirst in einen Haufen Knochen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, ""}) );
  AddInfo(DEFAULT_INFO, "sagt: Nurxio jarro Zykx.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(1, 500, 
      Name(WER,1)+ " versucht Dich zu zerfleischen.\n",
      Name(WER,1)+ " versucht @WEN zu zerfleischen.\n",
     ({DT_RIP}), ([SP_SHOW_DAMAGE:1]));

  SUID;

}

