// std-npc fuer abgrund
// 01-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit STDNPC;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"\nabgrundnpc"}) );
  SetProp(P_LOG_INFO, "feyaria/abgrund");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "abgrund:0:0:0") );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD + MOV_BACKWARDS);

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
}
