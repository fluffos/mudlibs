// ein Karakul
// 01-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_abgrund_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Karakul");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Karakul");
  SetProp(P_LONG, 
    "Dieser Daemon sieht aus wie die Mischung aus einem Saebelzahntiger und "
    "einem Skorpion, allerdings ist sein Fell violett-giftgruen gestreift. "
    "Sein langer Skorpionstachel sieht sehr gefaehrlich aus, allerdings "
    "scheinen die langen Tigerzaehne nocht toedlicher zu sein. Am besten "
    "fliehst Du vor diesem abscheulichen Wesen.");
  AddId(({"karakul", "daemon"}));

  create_default_npc(23);
  SetProp(P_HANDS, ({" mit seinem Tigerzaehnen", 300, ({DT_RIP, DT_UNHOLY}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 270);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_AGGRESSIVE, 1);

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "springt weg");
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }));

  SetProp(P_DIE_MSG,  " zerplatzt in eine Giftwolke.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, ""}) );
  AddInfo(DEFAULT_INFO, "sagt: Nurxio jarro Zykx.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(7, 500, 
      Name(WER,1)+ " zerreisst Dich mit seinen Tigerzaehnen.\n",
      Name(WER,1)+ " zerreisst @WEN mit seinen Tigerzaehnen.\n",
     ({DT_RIP, DT_UNHOLY}), ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell( 1, 300, DS_POISON,
      Name(WER,1)+ " trifft Dich mit seinem Skorpionstachel.\n",
      Name(WER,1)+ " trifft @WEN mit seinem Skorpionstachel.\n");

  SUID;

}

