#include "../def.h"

inherit ROOM "std_abgrund";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor dem Thron der Daemonenfuerstin");
  SetProp(P_INT_LONG,
      "Du stehst vor dem Thron der Daemonenfuerstin, der aus Knochen und "
      "Totenkoepfen erbaut wurde. Nach unten fuehrt eine Treppe zum Thronsaal "
      "hinunter.");
  SetProp(P_INDOORS, 1);

  AddDetail( ({"abgrund", "zyr", "xarra", "zyr-xarra", "ebene"}),
      "Der finstere Abgrund von Zyr-Xarra ist die Ebene der Daemonen.");
  AddDetail( ({"daemon", "daemonen"}),
      "Sei froh, dass gerade kein Daemon da ist, um Dich zu zerfleischen.");
  AddDetail( ({"palast"}),
      "Du befindest Dich im Palast der Daemonenfuerstin.");
  AddDetail( ({"thronsaal"}),
      "Du befindest Dich im Thronsaal der Daemonenfuerstin.");
  AddDetail( ({"boden", "waende", "wand", "decke", "halle"}),
      "Die Halle wurde aus Knochen und Totenkoepfen erbaut.");
  AddDetail( ({"knochen"}),
      "Das Palast und auch der Thron wurden aus allen moeglichen Knochen "
      "erbaut, Du siehst ganz winzige, menschengrosse und riesengrosse Knochen.");
  AddDetail( ({"totenkopf", "totenkoepfe", "kopf"}),
      "Die meisten Totenkoepfe haben menschenaehnliche Form. "
      "Vielleicht wird Dein Kopf ja auch bald in den Palast eingebaut, "
      "wenn Du nicht vorsichtig bist.");
  AddDetail( ({"form"}),
      "Menschenaehnlich.");
  AddDetail( ({"treppe"}),
      "Die Treppe fuehrt nach unten in den Thronsaal des Palastes.");
  AddDetail( ({"thron", "groesse", "ausmass", "ausmasse"}),
      "Der Thron hat gewaltige Ausmasse, also muss die Daemonenfuerstin auch von "
      "enormere Groesse sein.");
  AddDetail( ({"daemonenfuerstin", "fuerstin", "diener", "wesen", "herzogin"}),
      "Die Fuerstin der Daemonen, auch als finstere Herzogin bekannt, ist "
      "ein schreckliches Wesen und eine der wichtigsten Verbuendeten "
      "DES BOESEN.");
  AddDetail( ({"boese", "boesen", "verbuendete", "verbuendeter"}),
      "DAS BOESE lauert ueberall.");

  AddExit( "unten", ROOM "palast2");
}

void entfluchen(object ob)
{
  if (ob->QueryProp(P_CURSED))
  {
    ob->SetProp(P_CURSED, 0);
    ob->SetProp(P_NEVERDROP, 0);
  }
}

int nexus()
{
  if (TP && pointerp(TP->QueryProp(P_ARMOURS)))
    filter_array(TP->QueryProp(P_ARMOURS), "entfluchen");
  return 1;

}

void clone_fuerstin()
{
  object ob;
  if (ASTRALMASTER->QueryTime("abgrund") < 0)
  {
    RemoveExit("raus");
    if (!present("herzogin"))
    {
      ob = clone_object(NPC "daemonenfuerstin");
      ob->SetProp(P_CORPSE, OBJ "abgrundleiche");
      ob->move(TO, M_NOCHECK);
    }
  }
}

void reset()
{ 
  ::reset();
  clone_fuerstin();
}

void init()
{
  ::init();
  clone_fuerstin();
}
