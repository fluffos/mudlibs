#include "../def.h"

inherit ROOM "std_abgrund";

mapping equip = ([AT_ARMOUR: "thonispanzer",
                  AT_HELMET: "erdbebenhelm",
                  AT_AMULET: "hoellenhundamulett",
                  AT_RING: "hoellenkatzenring",
                  AT_GLOVE: "pestdaemonhandschuhe",
                  AT_CLOAK: "orkandaemonumhang",
                  AT_BOOT: "flutwellendaemonstiefel",
                  AT_TROUSERS: "sturmdaemonhose",
                  AT_BELT: "schwertdaemonguertel",
                  AT_BRACERS: "terrordaemonarmschienen",
                ]);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Palast der Daemonenfuerstin");
  SetProp(P_INT_LONG,
      "Du befindest Dich im Palast der Daemonenfuerstin, und zwar in "
      "einer gewaltigen Halle, die aus Knochen und Totenkoepfen erbaut "
      "wurde. Nach oben fuehrt eine Treppe zum Thron der Fuerstin aller "
      "Daemonen.");
  SetProp(P_INDOORS, 1);

  AddDetail( ({"abgrund", "zyr", "xarra", "zyr-xarra", "ebene"}),
      "Der finstere Abgrund von Zyr-Xarra ist die Ebene der Daemonen.");
  AddDetail( ({"daemon", "daemonen"}),
      "Sei froh, dass gerade kein Daemon da ist, um Dich zu zerfleischen.");
  AddDetail( ({"palast"}),
      "Du befindest Dich im Palast der Daemonenfuerstin.");
  AddDetail( ({"boden", "waende", "wand", "decke", "halle"}),
      "Die Halle wurde aus Knochen und Totenkoepfen erbaut.");
  AddDetail( ({"knochen"}),
      "Das Palast wurde aus allen moeglichen Knochen erbaut, Du siehst ganz "
      "winzige, menschengrosse und riesengrosse Knochen.");
  AddDetail( ({"totenkopf", "totenkoepfe", "kopf"}),
      "Die meisten Totenkoepfe haben menschenaehnliche Form. "
      "Vielleicht wird Dein Kopf ja auch bald in den Palast eingebaut, "
      "wenn Du nicht vorsichtig bist.");
  AddDetail( ({"form"}),
      "Menschenaehnlich.");
  AddDetail( ({"treppe"}),
      "Die Treppe fuehrt nach oben zum Thron der Daemonenfuerstin. Sie ist "
      "aus maechtigen Steinbloecken gefertigt.");
  AddDetail( ({"stein", "steinbloecke", "bloecke"}),
      "Auf einem Steinblock faellt Dir etwas auf.");
  AddDetail( ({ "steinblock", "block", "jemand"}),
      "Jemand hat hier eine Inschrift in einen Steinblock eingeritzt, "
      "scheinbar bist Du nicht der erste Besucher.");
  AddDetail( ({"inschrift", "muehe"}),
      "Du kannst sie, wenn auch mit viel Muehe, lesen.");
  AddReadDetail( ({"inschrift"}),
      "iafraX raw reih!");
  AddDetail( ({"besucher"}),
      "Wer wohl dieser Besucher war?");
  AddDetail( ({"xarfai"}),
      "Du bist Dir ziemlich sicher, dass Xarfai schon mal hier war. Das "
      "verwundert Dich auch gar nicht.");
  AddDetail( ({"thron", "groesse", "ausmass", "ausmasse"}),
      "Der Thron hat gewaltige Ausmasse, also muss die Daemonenfuerstin auch von "
      "enormer Groesse sein.");
  AddDetail( ({"daemonenfuerstin", "fuerstin", "diener", "wesen", "herzogin"}),
      "Die Fuerstin der Daemonen, auch als finstere Herzogin bekannt, ist "
      "ein schreckliches Wesen und eine der wichtigsten Verbuendeten "
      "DES BOESEN.");
  AddDetail( ({"boese", "boesen", "verbuendete", "verbuendeter"}),
      "DAS BOESE lauert ueberall.");
 
  AddExit( "oben", ([
        EX_DEST: ROOM "palast3",
        EX_TESTFUNC:  "test_equip",
        EX_FUNC: "curse_equip"]) );

}

string curse_equip(string dir)
{
  filter_array(TP->QueryArmours(), "curse_item");
  return ROOM "palast3";
}

int test_equip(string dir)
{
  string *armours;
  int i;
  object *obj;
  int failed;

  failed = 0;

  for (i = sizeof(armours = m_indices(equip)) - 1; i >= 0; i--)
  {
    obj = TP->QueryArmours(armours[i]);
    while (sizeof(obj))
    {
      if (obj[0]->id(equip[armours[i]]))
        break;
      else
        obj -= ({obj[0]});
    }
    if (!sizeof(obj))
    {
      failed = 1;
      break;
    }
  }
  if (failed)
  {
    write(BS("Nur Daemonen ist der Zutritt gestattet, vielleicht "
          "solltest Du Dich als Daemon verkleiden."));
    return 0;
  }
  return 1;
}

