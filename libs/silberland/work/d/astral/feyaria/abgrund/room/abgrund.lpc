#include "../def.h"
#include <exploration.h>

inherit ROOM "std_abgrund";

int x,y,z;

string sound_liste();

void create()
{
  string *npcs;

  SUID;
  if(!is_clone(TO)) return;
  ::create();
  PO->CustomizeObject();

  AddDetail( ({"abgrund", "zyr", "xarra", "zyr-xarra", "ebene"}),
      "Der finstere Abgrund von Zyr-Xarra ist die Ebene der Daemonen.");
  AddDetail( ({"daemon", "daemonen"}),
      "Sei froh, dass gerade kein Daemon da ist, um Dich zu zerfleischen.");
  AddDetail( ({"gegend", "alptraum"}),
      "Eine Gegend, schlimmer als Dein schlimmster Alptraum.");
  AddDetail( ({"blick", "nebel", "schwaden", "nebelschwaden", "himmel"}),
      "Dein Blick wird durch schwarze Nebelschwaden getruebt.");


  AddCmd( ({"rette", "rett"}), "cmd_retten");
}

void SetXYZ(int _x, int _y, int _z)
{
  x = _x;
  y = _y;
  z = _z;
}

void SetFreefall()
{
  SetProp(P_INT_SHORT, "Im finsteren Abgrund vom Zyr-Xarra");
  SetProp(P_INT_LONG,
      "Du befindest Dich im finsteren Abgrund von Zyr-Xarra, einer Gegend, "
      "die schlimmer als Dein schlimmster Alptraum ist. Unter und ueber Dir "
      "befinden sich nur schwarze Nebelschwaden. Da Du keinen Boden unter "
      "Deinen Fuessen hast, faellst Du nach unten, allerdings nur ganz "
      "langsam, denn die Luft hier ist seltsam schwer. In einiger Entfernung "
      "kannst Du Stege sehen, die nach oben und unten fuehren, allerdings "
      "hast Du keine Chance, dorthinzugelangen. Du wirst also weiter nach "
      "unten fallen, bis Du irgendwann mal auf dem Grund landest, falls es "
      "hier ueberhaupt einen gibt.");

  AddDetail( ({"steg", "boden", "fuesse", "fuss"}),
      "Du hast keinen Boden unter Deinen Fuessen, darum faellst Du nach unten.");
  AddDetail( ({"stege","steg", "entfernung"}),
      "Die Stege sind schmal und winden sich nach oben und unten, allerdings "
      "hast Du keine Chance, dorthinzugelangen.");
  AddDetail( ({"chance", "ueberlebenschance"}),
      "Ueberlebenschance: ja; Chance, zu einem Steg zu kommen: nein.");
  AddDetail( ({"luft"}),
      "Die Luft ist seltsam schwer, dadurch kannst Du Dich nur sehr langsam "
      "bewegen, allerdings faellst Du auch nur ganz langsam. Daher hast Du "
      "wohl doch eine Ueberlebenschance, wenn Du irgendwann mal auf dem "
      "Grund ankommst.");
  AddDetail( ({"grund", "bodenlose"}),
      "Falls es einen gibt, faellst Du immer naeher dorthin, ansonsten "
      "faellst Du ins Bodenlose.");

  if (random(100) < FREEFALL_NPC_CHANCE)
    AddItem( ({NPC "gereliss"}), 
        REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM "abgrund:0:",
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
          P_CORPSE: OBJ "abgrundleiche",
          P_HEAL: 50,
          P_NOCORPSE: 0]) ); 

  AddCmd( ({"oben", "unten"}), "cmd_obenunten");
}

void SetAbgrund()
{
  string *npcs;

  SetProp(P_INT_SHORT, "Im finsteren Abgrund vom Zyr-Xarra");
  SetProp(P_INT_LONG,
      "Du befindest Dich im finsteren Abgrund von Zyr-Xarra, einer Gegend, "
      "die schlimmer als Dein schlimmster Alptraum ist. Du stehst auf einem "
      "sehr schmalen Steg, der sich endlos nach oben und unten windet. Du "
      "kannst einige andere Steg erkennen, die sich in aehnlicher Weise nach "
      "oben und unten winden, sie sind aber zu weit entfernt, um direkt "
      "dorthin zu gelangen. Dein Blick wird durch schwarze Nebelschwaden "
      "getruebt, was sich dahinter befindet, kannst Du nicht festellen. "
      "Die Luft ist seltsam schwer, dadurch kannst Du Dich nur sehr langsam "
      "bewegen.");

  AddDetail( ({"steg", "boden"}),
      "Der Steg, auf dem Du Dich befindest, ist sehr schmal. Er windet sich "
      "nach oben und unten.");
  AddDetail( ({"stege", "weise"}),
      "Die anderen Stege sind genauso schmal wie der, auf dem Du gerade "
      "stehst, und winden sich auch nach oben und unten.");
  AddDetail( ({"luft"}),
      "Die Luft ist seltsam schwer, dadurch kannst Du Dich nur sehr langsam "
      "bewegen.");

  AddRoomMessage( ({
        "Fast waerst Du von dem schmalen Steg hinuntergefallen.\n",
        "Du fuehlst Dich sehr unwohl.\n",
        "Ein Gereliss flattert kreischend an Dir vorbei.\n",
        "Die vielen Daemonen hier machen Dir Angst.\n",
        "Dein Herz rast.\n",
        "Du fuehlst Dich seltsam bedrueckt.\n",
        "Der Steg unter Dir ist wirklich sehr schmal.\n",
        "Gleich wird der Steg brechen und Du wirst ins Bodenlose fallen.\n",
        "Du hoerst ein nervenzereissendes Kreischen aus der Ferne.\n",
        "Die Macht der Daemonenfuerstin laesst Dich erzittern.\n",
        "Gleich werden die Daemonen kommen und Dich toeten.\n",
        "Du fragst Dich, ob Du hier jemals wieder lebend raus kommst.\n",
        "Hier ist Dein schlimmster Alptraum Realitaet geworden.\n",
        "Du willst hier einfach nur weg.\n",
        "Durch den Nebel siehst Du einen bedrohlichen Schatten immer naeher kommen.\n",
        "Eine leichte Panik steigt in Dir auf.\n",
        "Du fuehlst Dich von den Daemonen beobachtet.\n",
        "Du bereust, dass Du in das Reich der Daemonen eingedrungen bist.\n",
        "Die seltsam schwere Luft erschwert Dir das Atmen.\n",
        "Eine dunkle Nebelschwade truebt Deinen Blick.\n",
        "Eine daemonische Macht versucht in Dein Bewusstsein einzudringen.\n",
        "Ein fuerchterlicher Daemon starrt Dich von einem benachtbarten Steg an.\n",
        "Dieser Steg hat wohl nie ein Ende.\n",
        "Du wirst hier sterben und fuer immer im Reich der Daemonen verrotten.\n",
        "Es war ein Fehler, hierherzukommen.\n",
        "Du hast eine kurze Vision, wie Du von einem Daemon zerfleischt wirst.\n",
        "Die finstere Herzogin der Daemonen teilt Dir mit: Stirb, Sterblicher!\n",
        "Du hoerst das Bruellen eines Sturmdaemons in der Ferne.\n",
        "Du spuerst die Erschuetterungen eines Erdbebendaemons.\n",
        "Von oben tropft etwas Saeure eines Saeuredaemons auf Dich herab.\n",
        "Du hoerst das Bellen eines Hoellenhundes.\n",
        "Auf einem entfernten Steg siehst Du die riesige Gestalt eines Thonis Daemons.\n",
        "Du riechst den Gestank eines Pestdaemons.\n",
        }), 45);

  npcs = ({});
  switch (x)
  {
    case 4: npcs += ({THONISDAEMON,
                      STURMDAEMON,
                      BAUMREISSERDAEMON,
                      FLUGDAEMON,
                      SAEURALIA,
                   }); 
    case 3: npcs += ({TERRORDAEMON,
                      SCHWERTDAEMON,
                      TESSALTRICE,
                      FLUTWELLENDAEMON,
                      PESTDAEMON,
                      BLITZDAEMON
                   }); 
    case 2: npcs += ({HOELLENHUND,
                      NPC "gereliss",
                      NPC "karakul",
                   }); 
    case 1: npcs += ({HOELLENKATZE,
                      LICHTDAEMON,
                      ERDBEBENDAEMON,
                      ORKANDAEMON,
                      SAEUREDAEMON,
                      NPC "daemonid",
                    }); 
            break;
  }

  if (random(100) < NPC_CHANCE)
    AddItem( npcs,
        REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM "abgrund:"+x,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
          P_HEAL: 200,
          P_CORPSE: OBJ "abgrundleiche",
          P_NOCORPSE: 0]) ); 
  if (random(100) < SECOND_NPC_CHANCE)
    AddItem( npcs,
        REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM "abgrund:"+x,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
          P_HEAL: 500,
          P_CORPSE: OBJ "abgrundleiche",
          P_NOCORPSE: 0]) ); 

  if (y == 0 && z == 0) // Startraum
  {
    SetProp(P_INT_LONG, Query(P_INT_LONG)[0..<2] + 
        " Du hoerst hier seltsame Stimmen.");
    AddDetail("stimmen", "Lauschen!");
    AddSound("stimmen", #'sound_liste);
  }
}

int cmd_obenunten(string str)
{
  if (!query_once_interactive(TP))
    return 0;
  write(BS("Die Luft ist so schwer, dass Du Dich kaum bewegen kannst, Du "
        "faellst nur ganz langsam nach unten."));
  return 1;
}

void TellAbgrund(string msg)
{
  int i;
  object room;

  for (i = 1; i <= XSIZE; i++)
    if (room = find_object(ROOM "abgrund:" + i + ":" + y + ":" + z))
      tell_room(room, msg);
}

void init()
{
  ::init();
  if (TP && query_once_interactive(TP) && x == 0)
  {
    TellAbgrund("Du siehst, wie " + TP->name(WER,1) + " langsam von oben "
        "herunterfaellt.\n");
    call_out("weiterfallen", 10 + random(10), TP);
  }
}

void weiterfallen(object wer)
{
  if (!wer || !interactive(wer) || !present(wer))
    return;
  tell_object(wer, "Du faellst weiter nach unten.\n");
  wer->move(QueryProp(P_EXITS)["unten"], M_GO, "unten");
  if (present(wer))
    wer->move(QueryProp(P_EXITS)["unten"], M_GO|M_NOCHECK, "unten");
  else if (present(wer))
  {
    call_out("weiterfallen", 10 + random(10), TP);
    return;
  }
  TellAbgrund(wer->Name(WER,1) + " faellt langsam nach unten.\n");
}

int cmd_retten(string str)
{
  object ob;
  if (x == 0) 
    return 0;
  notify_fail("Wen willst Du retten?\n");
  if (!str)
    return 0;
  if (!objectp(ob = present(str, find_object(ROOM "abgrund:0:" + y + ":0"))))
    return 0;
  if (!interactive(ob) || ob == TP)
    return notify_fail("Du kannst nur Spieler retten!\n"), 0;

  if (random(100) > RESCUE_CHANCE)
  {
    write("Du versuchst, " + ob->name(WEN,1) + " zu retten, erreichst " +
        ob->QueryPronoun(WEN) + " aber nicht.\n");
    say(TP->Name(WER,1) + " versucht, " + ob->name(WEN,1) + " zu retten, erreicht " +
        ob->QueryPronoun(WEN) + " aber nicht.\n");
    tell_object(ob, 
        TP->Name(WER,1) + " versucht, Dich zu retten, aber versagt.\n");
    ENV(ob)->weiterfallen(ob);
    return -1;
  }
  tell_object(ob, 
      TP->Name(WER,1) + " rettet Dich heldenhaft und zieht Dich auf den Steg "
      "zurueck.\n");
  write("Heldenhaft rettest Du " + ob->name(WEN,1) + " und ziehst " +
      ob->QueryPronoun(WEN) + " zurueck auf den Steg.\n");
  say("Heldenhaft rettet " +TP->name(WER,1) + " " + ob->name(WEN,1) + 
      " und ziehst " + ob->QueryPronoun(WEN) + " zurueck auf den Steg.\n");
  call_other(ROOM "abgrund", "EP");
  ob->move(TO, M_GO);
  return 1;
}

string sound_liste()
{
  write(
    "Die Liste der beruehmtesten Helden im finsteren Abgrund vom Zyr-Xarra\n"
    "---------------------------------------------------------------------\n");
  ASTRALMASTER->FameList("abgrund");
  return "";
}

string pl_txt(object *pl)
{
  string ret;

  ret = "";
  while(sizeof(pl))
  {
    ret += capitalize(getuid(pl[0]));
    pl -= ({pl[0]});
    if (sizeof(pl) > 1)
      ret += ", ";
    else if (sizeof(pl) == 1)
      ret += " und ";
  }
  return ret;
}

string pl_adv(object *pl)
{
  if (sizeof(pl) > 1)
    return "sie";
  else return pl[0]->QueryPronoun(WEN);
}

string _query_int_long()
{
  string str;
  object *pl;

  str = "";
  if (x != 0)
  {
    call_other(ROOM "abgrund:0:" + y + ":0", "???");
    pl = filter_array(all_inventory(find_object(ROOM "abgrund:0:" + y + ":0")), 
                      #'interactive);
    if (sizeof(pl))
    {
      str = sprintf(" Du siehst %s neben dem Steg langsam hinunterfallen. "
        "Vielleicht koenntest Du %s retten.",
        pl_txt(pl), pl_adv(pl));
    }
  }
  return break_string(Query(P_INT_LONG)[0..<2] + str, 78);
}

void EP()
{
  if (getuid(previous_object()) == getuid(this_object()))
    EPMASTER->GiveExplorationPoint("rettung", EP_MISC);
}

void reset()
{
  ::reset();
  set_next_reset(25*60);
}
