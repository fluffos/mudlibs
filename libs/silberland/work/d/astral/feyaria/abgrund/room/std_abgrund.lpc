#include "../def.h"

inherit STDROOM;

void create()
{
  ::create();

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_IN);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 0, ENV_TERRAIN: TT_OTHER]) );

  AddSmell( ({DEFAULT_SMELL, "geruch"}), 
      "Es riecht ekelhaft.");
  AddSound( ({DEFAULT_SOUND, "nichts"}), 
      "Du hoerst seltsame Schreie, Jammern, Heulen und Kreischen.");
  AddSound( ({"schreie", "schrei"}),
      "*SCHREI*");
  AddSound( ({"jammern", "jammer"}),
      "*JAMMER*");
  AddSound( ({"heulen", "heul"}),
      "*HEUL*");
  AddSound( ({"kreischen", "kreisch"}),
      "*KREISCH*");

  SetProp(P_ZONE, "Abgrund");
}

