// 23.1.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/virtual/v_compiler";

#include <v_compiler.h>

#define P_ROOMS "raum"

void create() 
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "abgrund" );
  SetProp(P_ROOMS, ({"abgrund"}) );
}

string Validate(string file) 
{
  string name, foo;
  int x, y, z;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%d:%d:%d%s", name, x, y, z, foo) == 5) &&
      (member(QueryProp(P_ROOMS), name) != -1) &&
      x >= 0 && x < XSIZE && 
      y >= 0 && y < YSIZE && 
      z >= 0 && z < ZSIZE) 
    return name+":"+x+":"+y+":"+z;
  return 0;
}

int CustomizeObject() 
{
  string foo, foo2;
  int x, y, z;
  string dir1, dir2;
  mixed name;
  string *dirs;

  dirs = ({"norden", "nordosten", "osten", "suedosten", "sueden", 
           "suedwesten", "westen", "nordwesten", "oben", "unten"});
  
  if (!(name = ::CustomizeObject()) || 
      sscanf(name,"%s:%d:%d:%d%s", foo, x, y, z, foo2) != 5)
    return 0;

  PO->SetXYZ(x,y,z);
  switch (x)
  {
    case 0:
      dir1 = "oben"; dir2 = "unten"; 
      break;
    case 1:
      switch (y % 4)
      {
        case 0: dir1 = "ostoben"; dir2 = "suedunten"; break;
        case 1: dir1 = "suedoben"; dir2 = "westunten"; break;
        case 2: dir1 = "westoben"; dir2 = "nordunten"; break;
        case 3: dir1 = "nordoben"; dir2 = "ostunten"; break;
      }
      break;
    case 2:
      switch (y % 4)
      {
        case 0: dir1 = "suedwestoben"; dir2 = "suedostunten"; break;
        case 1: dir1 = "suedostoben"; dir2 = "nordostunten"; break;
        case 2: dir1 = "nordostoben"; dir2 = "nordwestunten"; break;
        case 3: dir1 = "nordwestoben"; dir2 = "suedwestunten"; break;
      }
      break;
    case 3:
      switch (y % 8)
      {
        case 0: dir1 = "suedostoben"; dir2 = "suedwestunten"; break;
        case 1: dir1 = "suedostoben"; dir2 = "nordwestunten"; break;
        case 2: dir1 = "westoben"; dir2 = "nordwestunten"; break;
        case 3: dir1 = "westoben"; dir2 = "ostunten"; break;
        case 4: dir1 = "westoben"; dir2 = "ostunten"; break;
        case 5: dir1 = "westoben"; dir2 = "ostunten"; break;
        case 6: dir1 = "nordostoben"; dir2 = "ostunten"; break;
        case 7: dir1 = "nordostoben"; dir2 = "suedwestunten"; break;
      }
      break;
    case 4:
      switch (y % 8)
      {
        case 0: dir1 = "suedwestoben"; dir2 = "ostunten"; break;
        case 1: dir1 = "suedoben"; dir2 = "nordostunten"; break;
        case 2: dir1 = "suedostoben"; dir2 = "nordunten"; break;
        case 3: dir1 = "ostoben"; dir2 = "nordwestunten"; break;
        case 4: dir1 = "nordostoben"; dir2 = "westunten"; break;
        case 5: dir1 = "nordoben"; dir2 = "suedwestunten"; break;
        case 6: dir1 = "nordwestoben"; dir2 = "suedunten"; break;
        case 7: dir1 = "westoben"; dir2 = "suedostunten"; break;
      }
      break;
  }
  PO->AddExit( dir1, ROOM "abgrund:" + x + ":" + (y + 1) % YSIZE + ":" + z);
  PO->AddExit( dir2, ROOM "abgrund:" + x + ":" + (y + YSIZE - 1) % YSIZE + ":" + z);
  if (x) 
  {
    PO->SetAbgrund();
    if (random(100) < FALSE_EXIT_CHANCE)
      PO->AddExit( dirs[random(sizeof(dirs))], ROOM "abgrund:0:" + y + ":0" );
  }
  else
    PO->SetFreefall();
  return 1;
}
