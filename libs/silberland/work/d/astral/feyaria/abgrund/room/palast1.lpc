#include "../def.h"

inherit ROOM "std_abgrund";

mapping equip = ([AT_ARMOUR: "thonispanzer",
                  AT_HELMET: "erdbebenhelm",
                  AT_AMULET: "hoellenhundamulett",
                  AT_RING: "hoellenkatzenring",
                  AT_GLOVE: "pestdaemonhandschuhe",
                  AT_CLOAK: "orkandaemonumhang",
                  AT_BOOT: "flutwellendaemonstiefel",
                  AT_TROUSERS: "sturmdaemonhose",
                  AT_BELT: "schwertdaemonguertel",
                  AT_BRACERS: "terrordaemonarmschienen",
                ]);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Reich der Daemonenfuerstin");
  SetProp(P_INT_LONG,
      "Du befindest Dich vor dem Palast der Daemonenfuerstin. Es ist ein "
      "furchteregendes Gebilde aus Knochen und Totenkoepfen, umgeben von "
      "gewaltigen Flammen. Nach oben fuehrt eine Treppe, die von zwei "
      "Daemonenstatuen bewacht wird. Ein magisches Portal fuehrt in den "
      "Nexus.");

  AddDetail( ({"abgrund", "zyr", "xarra", "zyr-xarra", "ebene"}),
      "Der finstere Abgrund von Zyr-Xarra ist die Ebene der Daemonen.");
  AddDetail( ({"daemon", "daemonen"}),
      "Sei froh, dass gerade kein Daemon da ist, um Dich zu zerfleischen.");
  AddDetail( ({"blick", "nebel", "schwaden", "nebelschwaden", "himmel"}),
      "Dein Blick wird durch schwarze Nebelschwaden getruebt.");
  AddDetail( ({"boden", "nebel"}),
      "Der Boden besteht aus undefinierbarem Nebel.");
  AddDetail( ({"portal", "nexus"}),
      "Ein magsiches Portal fuehrt in den Nexus. Eine innere Stimme sagt Dir, "
      "Dich sofort dorthin zu begeben.");
  AddDetail( ({"stimme", "innere stimme"}),
      "Deine innere Stimme teilt Dir mit: Fliehe sofort in den Nexus!");
  AddDetail( ({"palast", "gebilde"}),
      "Der Palast ist ein furchteregendes Gebilde aus Knochen und "
      "Totenkoepfen, umgeben von gewaltigen Flammen. Nach oben fuehrt eine "
      "Treppe, die von zwei Daemonenstatuen bewacht wird.");
  AddDetail( ({"knochen"}),
      "Das Palast wurde aus allen moeglichen Knochen erbaut, Du siehst ganz "
      "winzige, menschengrosse und riesengrosse Knochen.");
  AddDetail( ({"totenkopf", "totenkoepfe", "kopf"}),
      "Die meisten Totenkoepfe haben menschenaehnliche Form und Groesse. "
      "Vielleicht wird Dein Kopf ja auch bald in den Palast eingebaut, "
      "wenn Du nicht vorsichtig bist.");
  AddDetail( ({"form", "groesse"}),
      "Menschenaehnlich.");
  AddSpecialDetail( ({"flamme", "flammen", "flackern"}), "det_flammen");
  AddDetail( ({"schatten"}),
      "Beaengstigend.");
  AddDetail( ({"treppe"}),
      "Die Treppe fuehrt nach oben, in den Palast der Daemonenfuerstin. "
      "Sie wird von zwei Daemonenstatuen bewacht.");
  AddDetail( ({"daemonenstatuen", "daemonenstatue", "statuen", "statue"}),
      "Die Statuen bewachen die Treppe. Sie lassen wohl nur Daemonen "
      "passieren.");
  AddDetail( ({"daemonenfuerstin", "fuerstin", "diener", "wesen", "herzogin"}),
      "Die Fuerstin der Daemonen, auch als finstere Herzogin bekannt, ist "
      "ein schreckliches Wesen und eine der wichtigsten Verbuendeten "
      "DES BOESEN.");
  AddDetail( ({"boese", "boesen", "verbuendete", "verbuendeter"}),
      "DAS BOESE lauert ueberall.");
  AddDetail( ({"zeichen"}),
      "Wenn die Flammen stark auflodern, ist die Daemonenfuerstin sicher im "
      "Palast, wenn sie nur ganz schwach sind, ist sie wohl nicht da.");
 
  AddExit( "oben", ([
        EX_DEST: ROOM "palast2",
        EX_TESTFUNC:  "test_equip",
        EX_FUNC: "curse_equip"]) );

  AddExit( "nexus", NEXUS);

}

int test_equip(string dir)
{
  string *armours;
  int i;
  object *obj;
  int failed;

  failed = 0;

  if (ASTRALMASTER->QueryTime("abgrund") > 0)
  {
    write("Der Palast der Daemonenfuerstin ist momentan nicht betretbar.\n");
    return 0;
  }
  for (i = sizeof(armours = m_indices(equip)) - 1; i >= 0; i--)
  {
    obj = TP->QueryArmours(armours[i]);
    while (sizeof(obj))
    {
      if (obj[0]->id(equip[armours[i]]))
        break;
      else
        obj -= ({obj[0]});
    }
    if (!sizeof(obj))
    {
      failed = 1;
      break;
    }
  }
  if (failed)
  {
    write(BS("Die Daemonenstatuen lassen Dich nicht passieren, vielleicht "
          "solltest Du Dich als Daemon verkleiden."));
    return 0;
  }
  return 1;
}

void curse_item(object ob)
{
  if (stringp(ob->QueryProp(P_NAME)))   // Sicherheitsabfrage, woody, 3.3.06
    if (member(m_values(equip), lower_case(ob->QueryProp(P_NAME))) != -1)
    {
      ob->SetProp(P_CURSED, ob->Name(WER,1) + " " +
          (ob->IsPlural() ? "sind": "ist") + " von der Daemonenfuerstin verflucht!\n");
      ob->SetProp(P_NEVERDROP, 1);
    }
}

string curse_equip(string dir)
{
  filter_array(TP->QueryArmours(), "curse_item");
  return ROOM "palast2";
}

string det_flammen()
{
  if (ASTRALMASTER->QueryTime("abgrund") > 0)
    return BS("Die Flammen sind nur sehr schwach, scheinbar ist die "
        "Daemonenfuerstin gar nicht da.");
  return  BS("Gewaltige Flammen umgeben den Palast, und ihr Flackern erzeugt "
      "beaengstigende Schatten. Die Hoehe der Flammen ist ein deutliches "
      "Zeichen, dass sich die Daemonenfuerstin im Palast aufhaelt.");
}
