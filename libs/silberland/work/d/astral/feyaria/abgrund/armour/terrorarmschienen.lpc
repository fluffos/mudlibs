// Armschienen fuer Terrordaemon
// 03.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Die Terrordaemonarmschienen");
  SetProp(P_LONG, 
    "Die Armschienen des Terrordaemons bestehen aus gehaertetem Leder, in "
    "das viele kleine Nieten und Stacheln eingesetzt wurden.");
  SetProp(P_NAME, "Terrordaemonarmschienen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId (({"armschienen", "terrordaemonarmschienen", "\nabgrundarmschienen"}) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1000);
  SetProp(P_MAGIC, 2);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 2, P_SP: 2]) );
  SetProp(P_EFFECTIVE_WC, 100);
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY: 1, DT_TERROR:1]) );
}
