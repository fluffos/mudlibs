// Guertel fuer Schwertdaemon 
// 03.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Schwertdaemonguertel");
  SetProp(P_LONG, 
    "Ein sehr breiter Lederguertel aus daemonisch schwarzem Leder, wie er "
    "gerne von Schwertdaemonen gertagen wird.");
  SetProp(P_NAME, "Schwertdaemonguertel");
  SetProp(P_GENDER, MALE);
  AddId (({"guertel", "schwertdaemonguertel", "\nabgrundguertel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_MAGIC, 2);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 1, P_SP: 1]) );
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY: 1, DT_MAGIC:1]) );
}
