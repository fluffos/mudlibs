// Panzer fuer Thonis Daemon
// 03.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Thonispanzer");
  SetProp(P_LONG, 
    "Der Panzer eines Thonis Daemons. Er besteht aus schwarzen Schuppen, "
    "die zum Teil ineinander verwachsen sind.");
  SetProp(P_NAME, "Thonispanzer");
  SetProp(P_GENDER, MALE);
  AddId (({"panzer", "thonispanzer", "\nabgrundpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 37);
  SetProp(P_MATERIAL, ([MAT_HORN: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1000);
  SetProp(P_MAGIC, 2);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY: 1]) );
}
