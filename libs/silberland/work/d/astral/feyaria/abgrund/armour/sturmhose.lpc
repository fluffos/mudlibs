// Hose fuer Sturmdaemon
// 03.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Die Sturmdaemonhose");
  SetProp(P_LONG, 
    "Diese Hose besteht aus herumwirbelnder Luft und gehoerte einmal dem "
    "Sturmdaemon.");
  SetProp(P_NAME, "Sturmdaemonhose");
  SetProp(P_GENDER, FEMALE);
  AddId (({"hose", "sturmdaemonhose", "\nabgrundhose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_AIR: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1000);
  SetProp(P_MAGIC, 2);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 2, P_SP: 2]) );
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY: 1, DT_SOUND:1, DT_LIGHTNING:1]) );
}
