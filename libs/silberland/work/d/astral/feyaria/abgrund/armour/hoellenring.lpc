// Ring fuer Hoellenkatze
// 03.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Der Hoellenkatzenring");
  SetProp(P_LONG, 
    "Ein Ring aus den Schnurrhaaren einer Hoellenkatze.");
  SetProp(P_NAME, "Hoellenkatzenring");
  SetProp(P_GENDER, MALE);
  AddId (({"ring", "hoellenkatzenring", "\nabgrundring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_HAIR: 100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1000);
  SetProp(P_MAGIC, 2);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 1, P_SP: 1]) );
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY: 1, DT_FIRE:1]) );
}
