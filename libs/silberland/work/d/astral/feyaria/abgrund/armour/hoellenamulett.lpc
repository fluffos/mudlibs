// Amulett fuer Hoellenhund
// 03.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Das Hoellenhundamulett");
  SetProp(P_LONG, 
    "Ein Amulett aus den Haaren eines Hoellenhundes.");
  SetProp(P_NAME, "Hoellenhundamulett");
  SetProp(P_GENDER, NEUTER);
  AddId (({"amulett", "hoellenhundamulett", "\nabgrundamulett"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_HAIR: 100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1000);
  SetProp(P_MAGIC, 2);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 1, P_SP: 1]) );
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY: 1, DT_FIRE:1]) );

}
