// std-raum fuer ebenen der macht
// 11-11-2003 Feyaria@SilberLand

#define GEBIET "std"
#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();
#include "../where.h"  
}

void init()
{
  ::init();
  if (objectp(TP) && ((IS_LEARNER(TP) && !IS_LORD(TP) &&
          member(ALLOWED_UIDS, getuid(TP)) == -1) || 
       (TP->QueryProp(P_TESTPLAYER) && 
        !IS_LORD(lower_case(TP->QueryProp(P_TESTPLAYER))))))
  {
    WLOG( LOG "illegal_enter", 
        file_name(TO));
    tell_object(TP, "\nMagier und Testspieler haben hier nichts zu suchen!!!\n\n");
    TP->move(NEXUS, M_SILENT|M_NOCHECK|M_NO_SHOW);
  }
}
