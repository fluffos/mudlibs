inherit "/std/mnpc";

#include "../def.h"

void create()
{
  if (!is_clone(this_object()))
    return;

  ::create();

  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1 &&
      !IS_ARCH(previous_object())) 
  {
    raise_error("Illegales Clonen!");
    destruct();
    return;
  }

  AddId( ({"NOWIMPY", "NOCONTROL"}) );
}
