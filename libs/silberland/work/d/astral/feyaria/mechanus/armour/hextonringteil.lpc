// Hextonringteil
// 4.1.2004 Feyaria

inherit "/std/thing";

#include "../def.h"

int colornr;

void create()
{
  string color;
  if (!is_clone(this_object())) return;
  ::create();

  colornr = 1 + random(12);
  color = ({"", "rot", "blau", "gruen", "weiss", "gelb", "schwarz", "grau",
      "braun", "orangen", "violett", "farblos", "bunt"})[colornr];
  SetProp(P_NAME, "Hextonringteil");
  SetProp(P_NAME_ADJ, color);
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, Name(WER,0) );
  SetProp(P_LONG, 
    Name(WER,1) + " scheint ein Teilstueck eines Ringes zu sein. Er ist "
    "ein sechseckiger Zylinder, dessen Ober- und Unterseite genau den "
    "richtigen Winkel bilden, um sechs davon zu einem Ring zusammen "
    "bauen zu koennen.");
  AddId (({"hextonringteil", "ringteil", "\nmechanus_item"}) );
  AddAdjective( ({color, color+"e", color+"er", color+"en"}) );

  AddDetail( ({"winkel"}),
      "Der Winkel ist natuerlich 60 Grad.");
  
  SetProp(P_MATERIAL, ([MAT_MAGIC: 100]) );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 500);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);

  AddCmd( ({"baue", "bau"}), "cmd_bauen");
  SUID;
}

int cmd_bauen(string str)
{
  object ring;
  
  notify_fail("Was willst Du zusammenbauen?\n");
  if( !str || member( ({"hextonring", "hextonring zusammen"}), str) == -1 )
    return 0;
 
  if( !present("hextonringteil 6", TP) ) 
  {
    write("Dazu brauchst Du sechs Hextonringteile!\n");
    return -1;
  }
  
  ring = clone_object(ARMOUR "hextonring");
  ring->move(TP, M_NOCHECK);
  ring->Setup( ({present("hextonringteil", TP), present("hextonringteil 2", TP), 
      present("hextonringteil 3", TP), present("hextonringteil 4", TP), 
      present("hextonringteil 5", TP), present("hextonringteil 6", TP)}) );
  return 1;
}

int QueryColor()
{
  return colornr;
}
