// lufthandschuhe
// 23.11.2003 Feyaria

inherit "/std/armour";

#include "../def.h"
#include  "/gilden/druidenzirkel/druiden_extern.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Fuenffingrige Lufthandschuhe");
  SetProp(P_LONG, 
    "Diese Handschuhe bestehen nur aus Luft. Sie sind fast unsichtbar, man "
    "spuert nur eine staendige leichte Brise an den Fingern wenn man sie "
    "traegt. Eine sehr maechtige Magie muss da im Spiel sein. "
    "Man muss schon eine sehr vertrauensvolle Beziehung zum Element Luft "
    "haben, um diese Handschuhe tragen zu koennen.");
  SetProp(P_NAME, "Lufthandschuhe");
  SetProp(P_NAME_ADJ, "fuenffingrig");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"handschuhe","lufthandschuhe","\nmechanus_item"}) );
  AddAdjective( ({"fuenffingrig", "fuenffingrige"}) );

  AddDetail( ({"Luft"}),
      "Diese Handschuhe bestehen wirklich nur aus Luft.");
   SetProp(P_INFO,
       "Die Handschuhe unterstuetzen die Luftmagie der Druiden und "
       "verbessern den Handkampf!");

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_AIR: 100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2500);
  SetProp(P_MAGIC, 3);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 1, P_SP: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, 
      ([SR_SEER: 1, P_GUILD: "druidenzirkel", P_GUILD_LEVEL: 11 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_AIR: 2]) );

  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([LUFT: 5 + random(5)]) );
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 15 + random(6) );
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, LUFT);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_WEAR_FUNC, TO);
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, Name(WER,1) + " gluehen auf und heilen Dich!\n");
    wer->heal_self(55);
  }
}

int RemoveFunc(object me)
{ 
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
} 

int WearFunc(object ruest,int silent)
{ 
  environment()->AddResistanceModifier( ([DT_AIR:-0.05]) );
  return 1;
}


