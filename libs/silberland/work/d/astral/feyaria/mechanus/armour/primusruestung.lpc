inherit "/std/armour";

#include "../def.h"
#include "/p/daemon/itemd/itemd.h"

int nr = -1;

void create()
{
  string at;
  mapping a;

  if (!is_clone(this_object())) return;
  ::create();

  if (nr == -1)
    nr = random(10);
  at = ({AT_ARMOUR, AT_HELMET, AT_CLOAK, AT_RING, AT_BELT, AT_AMULET, 
      AT_BRACERS, AT_GLOVE, AT_TROUSERS, AT_BOOT})[nr];
  
  SetProp(P_NAME, "Primus" + lower_case(at));
  if(at == AT_TROUSERS)
  {
    SetProp(P_NAME, "Primushose" );
    SetProp(P_GENDER, FEMALE);
    SetProp(P_SHORT, Name(WER,1));
  }
  else if(nr < 5)
  {
    SetProp(P_GENDER, MALE);
    SetProp(P_SHORT, Name(WER,1));
  }
  else if(nr < 6)
  {
    SetProp(P_GENDER, NEUTER);
    SetProp(P_SHORT, Name(WER,1));
  }
  else
  {
    SetProp(P_PLURAL, 1);
    SetProp(P_SHORT, Name(RAW));
  }

  if(nr == 3 || nr == 5)
    SetProp(P_WEIGHT, 11); 
  else if (nr == 4  || nr == 7)
    SetProp(P_WEIGHT, 111);
  else 
    SetProp(P_WEIGHT, 1111);

  SetProp(P_LONG, 
    Name(WER,1) + (IsPlural() ? " sind" : " ist") + " einzigartig und besteh" +
    (IsPlural() ? "en" : "t") + " vollstaendig aus Magie.");
  AddId (({lower_case(at), lower_case(QueryProp(P_NAME)), "\nmechanus_item"}) );

  SetProp(P_ARMOUR_TYPE, at);
  SetProp(P_AC, VALID_ARMOUR_CLASS[at] );
  SetProp(P_MATERIAL, ([MAT_MAGIC: 100]) );
  SetProp(P_VALUE, 11111);
  SetProp(P_MAGIC, 11);
  SetProp(P_QUALITY_DECAY, 1111);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 11, P_SP: 11]) );
  SetProp(P_M_ATTR_MOD, ([A_STR: 1, A_INT: 1, A_CON: 1, A_DEX: 1]) );
  SetProp(P_M_MAX_HEALTH_MOD, ([P_HP:5, P_SP:5]) );
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_EFFECTIVE_WC, 111);
  SetProp("ruestungsbalsam", 11);
  SetProp(P_ITEMD_TMPMAGIC, ({1500, 1500}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{     
  nr = data[0];
  create();
  SetProp(P_ITEMD_TMPMAGIC, data[1]);
  SetProp(P_NODROP, 1);
}

mixed _query_autoloadobj()
{   
  return ([0: nr, 1: QueryProp(P_ITEMD_TMPMAGIC)]);
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  return random(11); 
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
    call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, Name(WER,1) + " glueh"+
        (IsPlural() ? "en auf und heilen" : "t auf und heilt") + " Dich!\n");
    wer->heal_self(111);
  }
}
