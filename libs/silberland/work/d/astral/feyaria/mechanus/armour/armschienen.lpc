// vierlagige Armschienen
// 23.11.2003 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Vierlagige Armschienen");
  SetProp(P_LONG, 
    "Diese Armschienen bestehen aus vier Lagen Leder. Jede Lage ist aus "
    "einer anderen Sorte Leder gefertigt. Daher schuetzen diese Armschienen "
    "besonders gut.");
  SetProp(P_NAME, "Armschienen");
  SetProp(P_NAME_ADJ, "vierlagig");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"armschienen", "\nmechanus_item"}) );
  AddAdjective( ({"vierlagig", "vierlagige", "vierlagigen"}) );

  AddDetail( ({"leder", "sorten", "sorte"}),
      "Das Leder der Armschienen besteht aus vier Sorten.");
  AddDetail( ({"lage", "lagen"}),
      "Welche Lage willst Du genauer untersuchen? Lage 1, Lage 2, Lage 3 "
      "oder Lage 4?");
  AddDetail( ({"lage 1", "krokodilleder", "sorte 1"}),
      "Die erste Lage besteht aus Krokodilleder und schuetzt gegen Wasser.");
  AddDetail( ({"lage 2", "schlangenleder", "sorte 2"}),
      "Die zweite Lage besteht aus Schlangenleder und schuetzt gegen Gift.");
  AddDetail( ({"lage 3", "zolomleder", "sorte 3"}),
      "Die dritte Lage besteht aus Zolomleder und schuetzt gegen Saeure.");
  AddDetail( ({"lage 4", "drachenleder", "sorte 4"}),
      "Die vierte Lage besteht aus Drachenleder und schuetzt gegen Feuer.");
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 100]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 2500);
  SetProp(P_MAGIC, 3);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 2, P_SP: 2]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + 
      ([DT_FIRE: 1, DT_ACID: 1, DT_WATER: 1, DT_POISON: 1]) );
  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
  SetProp(P_NEVERDROP, 1);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([
        DT_FIRE:-0.05, DT_ACID:-0.05, DT_WATER:-0.05, DT_POISON:-0.05]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, Name(WER,1) + " gluehen auf und heilen Dich!\n");
    wer->heal_self(44);
  }
}
