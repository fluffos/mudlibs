// dreifacher Guertel
// 23.11.2003 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein dreifacher Guertel");
  SetProp(P_LONG, 
    "Dieser Guertel ist so lange, dass Du in Dir drei mal um den Bauch "
    "winden kannst. Er besteht aus schwarzem Leder, das mit "
    "verschiedenfarbigen Metallplaettchen verziert ist.");
  SetProp(P_NAME, "Guertel");
  SetProp(P_NAME_ADJ, "dreifach");
  SetProp(P_GENDER, MALE);
  AddId (({"guertel", "\nmechanus_item"}) );
  AddAdjective( ({"dreifach", "dreifacher", "dreifachen"}) );
  SetProp(P_INFO, "Dieser Guertel schuetzt vor Blitz, Donner und Explosionen.\n");

  AddDetail( ({"leder"}),
      "Schwarzes Leder.");
  AddDetail( ({"plaettchen", "metallplaettchen"}),
      "Die Plaettchen bestehen aus verschiedenen Metallen.");
  AddDetail( ({"metall", "metalle"}),
      "Silber, Gold, Platin, Kupfer und Bronze.");
  AddDetail( ({"silber", "silberne Plaettchen"}),
      "Die silbernen Plaettchen glaenzen weiss.");
  AddDetail( ({"gold", "goldene Plaettchen"}),
      "Die goldenen Plaettchen glaenzen gelblich.");
  AddDetail( ({"platin", "platinene Plaettchen"}),
      "Die platinenen Plaettchen glaenzen blaeulich.");
  AddDetail( ({"kupfer", "kupferne Plaettchen"}),
      "Die kupfernen Plaettchen glaenzen roetlich.");
  AddDetail( ({"bronze", "bronzene Plaettchen"}),
      "Die bronzenen Plaettchen glaenzen gruenlich.");

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 80, MAT_GOLD: 4, MAT_SILVER: 4, 
                        MAT_PLATINUM: 4, MAT_COPPER: 4, MAT_BRONCE: 4 ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 2500);
  SetProp(P_MAGIC, 3);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 3, P_SP: 3]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + 
      ([DT_EXPLOSION: 2, DT_LIGHTNING: 2, DT_SOUND: 2]) );

  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
  SetProp(P_NEVERDROP, 1);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([
        DT_EXPLOSION:-0.05, DT_LIGHTNING:-0.05, DT_SOUND:-0.05]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, Name(WER,1) + " glueht auf und heilt Dich!\n");
    wer->heal_self(133);
  }
}
