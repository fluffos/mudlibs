// Hextonringteil
// 4.1.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

mapping res = ([]);

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Hextonring");
  SetProp(P_GENDER, MALE);
  AddId (({"hextonring", "ring", "\nmechanus_item"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_MAGIC: 100]) );
  SetProp(P_WEIGHT, 6);
  SetProp(P_VALUE, 6666);
  SetProp(P_MAGIC, 6);
  SetProp(P_QUALITY_DECAY, 666);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp("ruestungsbalsam", 10);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_WEAR_FUNC, TO);
  SUID;
}

// macht aus dem 6-er array ein array von groesse 0-3 mit den doppelt 
// vorkommenden Werten
int* CheckDouble(int* f)
{
  int i;
  int* ret;
  
  ret = ({});
  for(i = 0; i < 5; i++)
  {
    if(f[i] == f[i+1])
    {
      ret += ({f[i]});
      i++;  // doppelten Wert gefunden, gleich zum naechsten weiter
    }
  }
  return ret;
}

// auf 0 gesetzte Attribut-Modifier blokieren andere Attributverandernde
// Objekte, daher muessen wir die 0-Werte entfernen
mapping CheckAttrMod(mapping a)
{
  if( !a[A_STR] ) a = m_delete(a, A_STR);
  if( !a[A_CON] ) a = m_delete(a, A_CON);
  if( !a[A_DEX] ) a = m_delete(a, A_DEX);
  if( !a[A_INT] ) a = m_delete(a, A_INT);
  return a;
}

int Quadrat(int i)
{
  return i * i;
}

void Setup(object* ringteil)
{
  int* f;
  int i;
  int* d;
  mapping health_mod;
  mapping attr_mod;
  mapping temp_prot;
  mapping dam_prot;
  string* protections;
  string* colors;
  string* adjectives;
  string* adjmod;
  int power;
  
  health_mod = ([P_HP: 1, P_SP: 1]);
  attr_mod = ([A_STR: 0, A_INT: 0, A_DEX: 0, A_CON: 0]);
  temp_prot = ([T_COLD_PROT: 1, T_HEAT_PROT: 1]);
  dam_prot = QueryProp(P_DAM_PROTECTION);
  protections = ({"", DT_FIRE, DT_WATER, DT_POISON, DT_COLD, DT_LIGHT, DT_ACID, 
      DT_TERROR, DT_AIR, DT_LIGHTNING, DT_SOUND, DT_EXPLOSION, DT_MAGIC});
  colors = ({"", "rot", "blau", "gruen", "weiss", "gelb", "schwarz", 
      "grau", "braun", "orangen", "violett", "farblos", "bunt"});
  adjectives = ({});
  adjmod = ({"", "", "hell", "", "leuchtend"});
  f = allocate(6);

  if(!strstr(getuid(PO), "feyaria"))
  {
    DB("HEXTONRING: Falsche uid!\n");
    return;
  }

  for( i = 0; i < 6; i++)
  {
    if( !objectp(ringteil[i]) || !ringteil[i]->id("hextonringteil") ||
        !strstr(getuid(ringteil[i]), "feyaria") )
    {
      DB("HEXTONRING: Falsche uid!\n");
      return;
    }
    f[i] = ringteil[i]->QueryColor();
    ringteil[i]->remove();
  }

  if( sizeof(d = CheckDouble(sort_array(f, #'>))) )
  {
    while(sizeof(d))
    {
      // kommt einmal vor->1, zweimal->2, dreimal->4
      power = 1 + Quadrat(sizeof(d) - sizeof(d - ({d[0]}))) / 3;
      switch(d[0] == 12 ? 1 + random(11) : d[0])
      {
        case 1: attr_mod[A_STR] = 1 * power; break; // rot
        case 2: attr_mod[A_INT] = 1 * power; break; // blau 
        case 3: attr_mod[A_CON] = 1 * power; break; // gruen
        case 4: attr_mod[A_DEX] = 1 * power; break; // weiss

        case 5: health_mod[P_SP] += 6 * power; break; // gelb
        case 6: health_mod[P_HP] += 6 * power; break; // schwarz
        case 7: health_mod[P_SP] += 3 * power;        // grau
                health_mod[P_HP] += 3 * power; break; 

        case 8: temp_prot[T_COLD_PROT] += 3 * power; break; // braun
        case 9: temp_prot[T_HEAT_PROT] += 2 * power; break; // orange
        case 10: health_mod[P_SP] += 2 * power;             // violett
                 health_mod[P_HP] += 2 * power;
                 temp_prot[T_COLD_PROT] += 1 * power;
                 temp_prot[T_HEAT_PROT] += 1 * power; break;
        case 11: SetProp(P_TELEPORT_COST, 1 + 2 * power); break; // farblos         
      }
      adjectives += ({adjmod[power] + colors[d[0]]});
      d -= ({d[0]});
    }
    SetProp(P_M_HEALTH_MOD, health_mod );
    if( sizeof(attr_mod = CheckAttrMod(attr_mod)) )
      SetProp(P_M_ATTR_MOD, attr_mod );
    SetProp(P_TEMPERATURE_PROTECTION, temp_prot );
  }

  for(i = 0; i < 6; i++)
  {
    dam_prot += ([protections[f[i]]: 3]);
    if (res[protections[f[i]]])
      res[protections[f[i]]] += -0.01;
    else
      res[protections[f[i]]] = -0.01;
  }
  SetProp(P_DAM_PROTECTION, dam_prot);

  SetProp(P_NAME_ADJ, adjectives);
  for(i = sizeof(adjectives) - 1; i >= 0; i--)
  {
    AddAdjective( ({adjectives[i], adjectives[i]+"en", adjectives[i]+"er"}) );
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Dieser "+name(WER,1)[4..] +" ist etwas ganz einmaliges. "
    "Er ist sechseckig und besteht aus 6 verschiedenfarbigen Teilen, "
    "auch wenn einige Teile fast die gleiche Farbe zu haben scheinen. "+
    "Er wurde von " + CAP(getuid(TP)) + " zusammengebaut.");

  DB(sprintf("HEXTONRING: %s Farben:%@s, [%O]\n", getuid(TP), adjectives, TO));
  WLOG(LOG "hextonring", sprintf("baut %s zusammen (%s, %s, %s, %s, %s, %s)", 
        name(WEN,0), colors[f[0]], colors[f[1]], colors[f[2]], colors[f[3]],
        colors[f[4]], colors[f[5]]));
  write(sprintf("Du baust einen %s zusammen.\n", name(WEN,0)));
  environment(TP)->Message(sprintf("%s baut einen %s zusammen.\n", 
        TP->Name(WER), name(WEN,0)), MSGFLAG_VISUAL | MSGFLAG_NO_TP);
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, Name(WER,1) + " glueht auf und heilt Dich!\n");
    wer->heal_self(66);
  }
}

int RemoveFunc(object me)
{ 
  QueryProp(P_WORN)->RemoveResistanceModifier(Name());
  return 1;
} 

int WearFunc(object ruest,int silent)
{ 
  environment()->AddResistanceModifier(res, Name());
  return 1;
}

