string ShowTime()
{
  int t;

  if (!eventtime || !event)
    return "Die Sanduhr scheint still zu stehen.\n";
 
    t = 9 - 9 * (eventtime - time()) / (EVENT_TIME[event] * 60);
  if (t >= 0 && t < sizeof(uhr))
    return uhr[t];
  EndEvent(1);
  return "Die Sanduhr ist in einem sehr komischen Zustand.\n";
}

