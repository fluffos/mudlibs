
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("norden", MECHANUS_ASTRAL);
  AddExit ("nordosten" ,"./5_2");
  AddExit ("sueden", "./7_3");
  AddExit ("nordwesten", "./5_1");

  AddDetail( ({"tunnel", "nordosten", "nordwesten"}),
      "Zwei fuenkeckige Tunnel fuehren nach Nordwesten und Nordosten.");
  AddDetail( ({"pforte", "sueden"}),
      "Eine siebeneckige Pforte fuehrt nach Sueden.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: zwei fuenfeckige Tunnel fuehren "
      "nach Nordosten und Nordwesten und eine siebeneckige Pforte geht nach "
      "Sueden. Wohin es nach Norden geht, kannst Du leider nicht genau "
      "erkennen."));
}
