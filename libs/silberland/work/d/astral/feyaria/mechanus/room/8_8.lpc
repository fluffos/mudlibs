
#include "../def.h"

inherit ROOM "8_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./4_4");
  AddExit ("westen", "./9_9");
  AddExit ("nordwesten", "./6_6");

  AddDetail( ({"verbindung", "nordosten"}),
      "Eine viereckige Verbindung geht nach Nordosten.");
  AddDetail( ({"tuer", "nordwesten"}),
      "Eine sechseckige Tuer fuehrt nach Nordwesten.");
  AddDetail( ({"westen", "gang"}),
      "Ein neuneckiger Gang fuehrt nach Westen.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine viereckige Verbindung geht "
      "nach Nordosten, eine sechseckige Tuer fuehrt nach Nordwesten "
      "und ein neuneckiger Gang nach Westen."));
}
