
#include "../def.h"

inherit ROOM "8_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./9_1");
  AddExit ("suedosten" ,"./5_1");
  AddExit ("suedwesten", "./4_1");

  AddDetail( ({"verbindung", "suedwesten"}),
      "Eine viereckige Verbindung geht nach Suedwesten.");
  AddDetail( ({"tunnel", "suedosten"}),
      "Ein fuenfeckiger Tunnel fuehrt nach Suedosten.");
  AddDetail( ({"osten", "gang"}),
      "Nach Osten fuehrt ein neuneckiger Gang.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine viereckige Verbindung geht "
      "nach Suedwesten, ein fuenfeckiger Tunnel fuehrt nach Suedosten "
      "und ein neuneckiger Gang nach Osten."));
}
