
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In einem achteckigen Raum");
  SetProp(P_INT_LONG,
      "Du stehst in einem achteckigen Raum, der wohl das Heim eines Octons "
      "ist, denn er ist eindeutig der Zahl Acht gewidmet. Daher gibt es hier "
      "auch acht Waende und acht Ecken. Die Waende sind ueber und ueber mit Zahlen "
      "bedeckt, die alle nur aus der Ziffer '8' bestehen.");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden"}),
      "Der Boden besteht aus regelmaessigen Achtecken.");
  AddDetail( ({"decke"}),
      "Die Decke besteht aus regelmaessigen Achtecken.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den acht Waenden stehen eine Menge Zahlen.");
  AddDetail( ({"ecken"}),
      "Die acht Waende bilden acht Ecken.");
  AddDetail( ({"ecke", "eck"}),
      "Es gibt acht Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '8'.");
  AddDetail( ({"Octon", "heim"}),
      "Hier koenntest Du einen Octon treffen, leider ist gerade keiner da.");
  AddDetail( ({"achteck", "achtecke"}),
      "Ueberall Achtecke. Sie bilden ein symmetrisches Muster auf dem Boden "
      "und der Decke.");
  AddDetail( ({"symmetrie", "muster"}),
      "Das Muster der Achtecke bildet eine schoene Symmetrie.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige, von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf den Waenden.");
  AddDetail( ({"8"}),
      "Acht.");
  AddDetail( ({"acht"}),
      "8.");
  AddDetail( ({"88"}),
      "Achtundachtzig.");
  AddDetail( ({"achtundachtzig"}),
      "88.");
  AddDetail( ({"888"}),
      "Achthundertachtundachtzig.");
  AddDetail( ({"achthundertachtundachtzig"}),
      "888.");
  AddDetail( ({"8888"}),
      "Achttausendachthundertachtundachtzig.");
  AddDetail( ({"achttausendachthundertachtundachtzig"}),
      "8888.");
  AddDetail( ({"88888"}),
      "Achtundachtzigtausendachthundertachtundachtzig.");
  AddDetail( ({"achtundachtzigtausendachthundertachtundachtzig"}),
      "88888.");
  AddDetail( ({"888888"}),
      "Achthundertachtundachtzigtausendachthundertachtundachtzig.");
  AddDetail( ({"achthundertachtundachtzigtausendachthundertachtundachtzig"}),
      "888888.");
  AddDetail( ({"8888888"}),
      "Achtmillionenachthundertachtundachtzigtausendachthundertachtundachtzig.");
  AddDetail( ({"achtmillionenachthundertachtundachtzigtausendachthundertachtundachtzig"}),
      "8888888.");
  AddDetail( ({"88888888"}),
      "Achtundachtzigmillionenachthundertachtundachtzigtausendachthundertachtundachtzig.");
  AddDetail( ({"achtundachtzigmillionenachthundertachtundachtzigtausendachthundertachtundachtzig"}),
      "88888888.");
  AddDetail( ({"888888888"}),
      "Achthundertachtundachtzigmillionenachthundertachtundachtzigtausendachthundertachtundachtzig.");
  AddDetail( ({"achthundertachtundachtzigmillionenachthundertachtundachtzigtausendachthundertachtundachtzig"}),
      "888888888.");
  AddDetail( ({"8888888888"}),
      "Achtmilliardenachthundertachtundachtzigmillionenachthundertachtundachtzigtausendachthundertachtundachtzig.");
  AddDetail( ({"achtmilliardenachthundertachtundachtzigmillionenachthundertachtundachtzigtausendachthundertachtundachtzig"}),
      "8888888888.");
  AddDetail( ({"88888888888", "888888888888", "8888888888888", "8888888888888"}),
      "Vor lauter Achter wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "8";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}
