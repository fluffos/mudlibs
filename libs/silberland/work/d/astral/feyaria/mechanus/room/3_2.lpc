
#include "../def.h"

inherit ROOM "3_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./1_1");
  AddExit ("nordosten" ,"./6_2");
  AddExit ("osten" ,"./7_5");
  AddExit ("westen", "./7_4");
  AddExit ("nordwesten", "./6_1");
 
  AddDetail( ({"gang", "norden"}),
      "Ein runder Gang fuehrt nach Norden. Solch einen Gang hast Du in "
      "Mechanus sonst nirgendwo gesehen, er scheint einzigartig zu sein.");
  AddDetail( ({"pforte", "pforten", "westen", "osten"}),
      "Siebeneckige Pforten fuehren nach Westen und Osten.");
  AddDetail( ({"nordwesten", "nordosten", "tuer"}),
      "Im Nordwesten und Nordosten ist je eine sechseckige Tuer.");
}

string GetExits()
{
  string b, n;
  if( TP && member( ({"ansi", "vt100"}), TP->QueryProp(P_TTY) ) != -1 )
  {
    b = ANSI_BOLD; 
    n = ANSI_NORMAL;
  }
  else
    b=n="";
  return "Es gibt fuenf sichtbare Ausgaenge: ein runder Gang fuehrt nach "
    +b+"Norden"+n+", nach\n"+b+"Nordosten"+n+" und "+b+"Nordwesten"+n+
    " fuehrt je eine sechseckige Tuer und nach "+b+"Westen"+n+" und\n"
    +b+"Osten"+n+" je ein siebeneckiger Durchgang.\n";
}
