
#include "../def.h"

inherit ROOM "3_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./6_6");
  AddExit ("osten" ,"./9_9");
  AddExit ("sueden", "./2_2");
  AddExit ("westen", "./10_10");
  AddExit ("nordwesten", "./6_5");
 
  AddDetail( ({"tor", "sueden"}),
      "Das doppelfluegelige Tor fuehrt nach Sueden.");
  AddDetail( ({"gang", "osten"}),
      "Ein neuneckiger Gang fuehrt nach Osten.");
  AddDetail( ({"durchgang", "westen", "meter"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Westen.");
  AddDetail( ({"nordwesten", "nordosten", "tuer"}),
      "Im Nordwesten und Nordosten ist je eine sechseckige Tuer.");
}

string GetExits()
{
  string b, n;
  if( TP && member( ({"ansi", "vt100"}), TP->QueryProp(P_TTY) ) != -1 )
  {
    b = ANSI_BOLD; 
    n = ANSI_NORMAL;
  }
  else
    b=n="";
  return "Es gibt fuenf sichtbare Ausgaenge: ein zweifluegeliges Tor fuehrt "
    "nach "+b+"Sueden"+n+",\nnach "+b+"Nordosten"+n+" und "+b+"Nordwesten"+n+
    " fuehrt je eine sechseckige Tuer, nach "+b+"Osten"+n+" ein\nneueckiger "
    "Gang und nach "+b+"Westen"+n+" ein 10 Meter breiter Durchgang.\n";
}
