
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In einem zehneckigen Raum");
  SetProp(P_INT_LONG,
      "Du stehst in einem zehneckigen Raum, der wohl das Heim eines Decatons "
      "ist, denn er ist eindeutig der Zahl 10 gewidmet. Daher gibt es hier "
      "auch zehn Waende und zehn Ecken. Auf den Waenden allerdings sieht man "
      "nur die Ziffer '0'. Wo ist die '1', die zum Zehner dazugehoert?");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden"}),
      "Der Boden ist voellig kahl.");
  AddDetail( ({"decke"}),
      "Die Decke ist voellig kahl.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den zehn Waenden findest Du nur die Ziffer '0'.");
  AddDetail( ({"ecken"}),
      "Die zehn Waende bilden zehn Ecken.");
  AddDetail( ({"ecke", "eck"}),
      "Es gibt zehn Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '0'.");
  AddDetail( ({"decaton", "heim"}),
      "Hier koenntest Du einen Decaton treffen.");
  AddDetail( ({"zahlen", "zahl"}), 
      "Du siehst keine richtige Zahl, nur Nullen.");
  AddDetail( ({"0"}),
      "Null.");
  AddDetail( ({"null", "nullen"}),
      "0.");
  AddDetail( ({"zehn", "zehner"}),
      "10.");
  AddDetail( ({"10"}),
      "Zehn.");
  AddDetail( ({"1", "eins"}),
      "Keine Eins zu sehen, daher gibt es hier auch nur Nullen und keine Zehner.");
}

