
#include "../def.h"

inherit ROOM "7_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./9_3");
  AddExit ("suedosten" ,"./6_2");
  AddExit ("suedwesten", "./6_1");

  AddDetail( ({"gang", "norden"}),
      "Der Gang nach Norden ist neuneckig.");
  AddDetail( ({"tueren", "tuer", "suedosten", "suedwesten"}),
      "Es gibt zwei sechsseckige Tueren hier, eine nach Suedwesten und "
      "die andere nach Suedosten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: zwei sechseckige Tueren fuehren "
      "nach Suedwesten und Suedosten und eine neuneckiger Gang fuehrt nach "
      "Norden."));
}
