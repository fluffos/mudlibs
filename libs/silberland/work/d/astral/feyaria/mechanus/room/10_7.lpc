
#include "../def.h"

inherit ROOM "10_inh";

void create() 
{
  ::create();

  AddExit ("sueden", "./9_8");
  AddExit ("nordwesten", "./8_6");

  AddDetail( ({"ausgang", "nordwesten"}),
      "Ein achteckiger Ausgang fuehrt nach Nordwesten.");
  AddDetail( ({"gang", "sueden"}),
      "Der Gang nach Sueden ist neuneckig.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: ein achteckiger Ausgang fuehrt "
      "nach Nordwesten und ein neuneckiger Gang nach Sueden."));
}
