
#include "../def.h"

inherit ROOM "6_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./7_3");
  AddExit ("suedosten" ,"./3_2");
  AddExit ("westen", "./10_4");
  AddExit ("nordwesten", "./5_3");

  AddDetail( ({"spur", "spuren", "weg", "suedosten"}),
      "Der Weg fuehrt in drei Spuren nach Suedosten.");
  AddDetail( ({"tunnel", "nordwesten"}),
      "Ein fuenkeckiger Tunnel fuehrt nach Nordwesten.");
  AddDetail( ({"pforte", "nordosten"}),
      "Eine siebeneckige Pforte fuehrt nach Nordosten.");
  AddDetail( ({"durchgang", "meter", "westen"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Westen.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: ein dreispuriger Weg fuehrt "
      "nach Suedosten, ein fuenfeckiger Tunnel nach Nordwesten, eine "
      "siebeneckige Pforte nach Nordosten und ein 10 Meter breiter "
      "Durchgang nach Westen."));
}
