
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In der Einzigartigkeit von Primus");
  SetProp(P_INT_LONG,
      "Du stehst in der Einzigartigkeit von Primus. Dieser Raum ist "
      "angefuellt mit Einzigartigkeiten, er scheint sogar nur eine Wand und "
      "eine Ecke zu haben, aber das ist wohl eine optische Taeuschung. "
      "Auf der Wand stehen eine Menge Zahlen, die alle nur aus der Ziffer "
      "'1' bestehen.");

  AddDetail( ({"primus", "herr", "herr der zahlen"}),
      "Primus, der Herr der Zahlen, ist gerade nicht hier. Nur selten zeigt "
      "er sich den Sterblichen.");
  AddDetail( ({"sterbliche", "sterblicher"}),
      "Du wirst sterben, wenn Du Dich mit Primus anlegst!");
  AddDetail( ({"boden"}),
      "Es gibt einen Boden hier, wie passend.");
  AddDetail( ({"decke"}),
      "Es gibt eine Decke hier, wie passend.");
  AddDetail( ({"wand"}), 
      "Es gibt hier nur eine Wand, und auf der siehst Du jede Menge Zahlen.");
  AddDetail( ({"waende"}),
      "Waende? Hier gibt es nur eine Wand?!");
  AddDetail( ({"ecken"}),
      "Ecken? Hier gibt es nur eine Ecke?!");
  AddDetail( ({"ecke"}),
      "Es gibt hier nur eine Ecke, aber wie kann es die ueberhaupt geben, "
      "da es nur eine Wand gibt? Du bist verwirrt und Dir wird schwindlig.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '1'.");
  AddDetail( ({"einzigartigkeit", "einzigartigkeiten", "mal"}),
      "In diesem Raum ist alles einzigartig, selbst Du bist nur ein einziges "
      "Mal in diesem Raum.");
  AddDetail( ({"raum"}),
      "Ein einzigartiger Raum.");
  AddDetail( ({"taeuschung"}),
      "Wie kann es nur eine Wand und eine Ecke geben? Das muss eine optische "
      "Taeuschung sein.");
  AddDetail( ({"ausgang", "sueden"}),
      "Es gibt nur einen Ausgang, es haette Dich gewundert wenn es mehere waeren.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige, von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf der Wand. Aber wenn Du sie genau betrachtest, ist doch jede Zahl "
      "einzigartig.");
  AddDetail( ({"1"}),
      "Eins.");
  AddDetail( ({"eins"}),
      "1.");
  AddDetail( ({"11"}),
      "Elf.");
  AddDetail( ({"elf"}),
      "11.");
  AddDetail( ({"111"}),
      "Einhundertelf.");
  AddDetail( ({"einhundertelf"}),
      "111.");
  AddDetail( ({"1111"}),
      "Eintausendeinhundertelf.");
  AddDetail( ({"eintausendeinhundertelf"}),
      "1111.");
  AddDetail( ({"11111"}),
      "Elftausendeinhundertelf.");
  AddDetail( ({"elftausendeinhundertelf"}),
      "11111.");
  AddDetail( ({"111111"}),
      "Einhundertelftausendeinhundertelf.");
  AddDetail( ({"einhundertelftausendeinhundertelf"}),
      "111111.");
  AddDetail( ({"1111111"}),
      "Einemillioneinhundertelftausendeinhundertelf.");
  AddDetail( ({"einemillioneinhundertelftausendeinhundertelf"}),
      "1111111.");
  AddDetail( ({"11111111"}),
      "Elfmillioneneinhundertelftausendeinhundertelf.");
  AddDetail( ({"elfmillioneneinhundertelftausendeinhundertelf"}),
      "11111111.");
  AddDetail( ({"111111111"}),
      "Einhundertelfmillioneneinhundertelftausendeinhundertelf.");
  AddDetail( ({"einhundertelfmillioneneinhundertelftausendeinhundertelf"}),
      "111111111.");
  AddDetail( ({"1111111111"}),
      "Einemilliardeeinhundertelfmillioneneinhundertelftausendeinhundertelf.");
  AddDetail( ({"einemilliardeeinhundertelfmillioneneinhundertelftausendeinhundertelf"}),
      "1111111111.");
  AddDetail( ({"11111111111", "111111111111", "1111111111111", "1111111111111"}),
      "Vor lauter Einsen wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "1";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}

string GetExits()
{
  return bold_exits("Natuerlich gibt es auch nur einen Ausgang, naemlich "
      "nach Sueden.\n");
}
