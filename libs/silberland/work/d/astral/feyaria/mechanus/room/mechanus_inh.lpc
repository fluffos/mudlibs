#include "../def.h"

inherit STDROOM;

string sound_uhr();

void create() 
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_OTHER]) );

  AddDetail( ({"mechanus", "ebene"}),
      "Du befindest Dich in Mechanus, der Ebene der Zahlen.");
  AddDetail( ({"norden", "sueden", "westen", "osten", "nordosten",
               "nordwesten", "suedosten", "suedwesten"}),
      "Kein Ausgang in dieser Richtung");
  AddDetail( ({"richtung", "richtungen"}),
      "Norden, Sueden, Osten, Westen, Nordwesten, Nordosten, Suedwesten, "
      "Suedosten.");
  AddSpecialDetail( ({"ausgang", "ausgaenge"}), "GetExits");
  AddSound( ({DEFAULT_SOUND, "gehoernerven"}),
      "Deine Gehoernerven sind durch die vielen Zahlen verwirrt. "
      "Du hoerst nur das Rauschen einer Sanduhr.");
  AddSound( ({"rauschen", "uhr", "sanduhr"}), #'sound_uhr);

  AddSmell( ({DEFAULT_SMELL, "geruchsnerven"}),
      "Deine Geruchsnerven sind durch die vielen Zahlen verwirrt.");

  SetProp(P_ZONE, "Mechanus");
}

string bold_exits(string str)
{
  if( TP && member( ({"ansi", "vt100"}), TP->QueryProp(P_TTY) ) != -1 )
  {
    str = regreplace(str, "Norden", ANSI_BOLD+"Norden"+ANSI_NORMAL, 1);
    str = regreplace(str, "Nordosten", ANSI_BOLD+"Nordosten"+ANSI_NORMAL, 1);
    str = regreplace(str, "Osten", ANSI_BOLD+"Osten"+ANSI_NORMAL, 1);
    str = regreplace(str, "Suedosten", ANSI_BOLD+"Suedosten"+ANSI_NORMAL, 1);
    str = regreplace(str, "Sueden", ANSI_BOLD+"Sueden"+ANSI_NORMAL, 1);
    str = regreplace(str, "Suedwesten", ANSI_BOLD+"Suedwesten"+ANSI_NORMAL, 1);
    str = regreplace(str, "Westen", ANSI_BOLD+"Westen"+ANSI_NORMAL, 1);
    str = regreplace(str, "Nordwesten", ANSI_BOLD+"Nordwesten"+ANSI_NORMAL, 1);
  }
  return str;
}

void init()
{
  ::init();
  if (objectp(TP) && interactive(TP) && !IS_LEARNER(TP))
    MECHANUSMASTER->AddPlayer(TP);
}

string sound_uhr()
{
  return (string) MECHANUSMASTER->ShowTime();
}
