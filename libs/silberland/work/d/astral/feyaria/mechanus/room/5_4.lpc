
#include "../def.h"

inherit ROOM "5_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./7_2");
  AddExit ("suedosten" ,"./8_4");
  AddExit ("suedwesten", "./6_2");

  AddDetail( ({"gang", "suedwesten"}),
      "Eine sechseckige Tuer fuehrt nach Suedwesten.");
  AddDetail( ({"pforte", "norden"}),
      "Eine siebeneckige Pforte fuehrt nach Norden.");
  AddDetail( ({"ausgang", "suedosten"}),
      "Ein achteckiger Ausgang fuehrt nach Suedosten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine sechseckige Tuer fuehrt "
      "nach Suedwesten, eine siebeneckige Pforte nach Norden und ein "
      "achteckiger Ausgang nach Suedosten."));
}
