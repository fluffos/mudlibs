
#include "../def.h"
#include <pub.h>

inherit  "std/pub";

string read_liste();

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "Die Kneipe Einszweidrei");
  SetProp(P_INT_LONG,
      "Du stehst in der Kneipe Einszweidrei. Fuer eine Kneipe ist es sehr "
      "eigenartig hier, denn es gibt nur eine lange Theke mit 10 Knoepfen, "
      "mit denen man scheinbar die Speisen und Getraenke bestellen kann.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_OTHER]) );
  SetProp(P_PUB_FLAGS, PUB_NOMULTFACTOR );

  AddDrink("Wasser mit Haertegrad 10", 
      ({"wasser", "zehn", "10", "wasser mit haertegrad 10"}),
      100, 18, 0, 6,
      ({"Du drueckst auf Knopf 10 und ploetzlich materialisiert sich ein "
       "Becher Wasser vor Dir auf der Theke, den Du sofort austrinkt.",
       "&& drueckt auf Knopf 10 und ploetzlich materialisiert sich ein "
       "Becher Wasser vor &3 auf der Theke, den &! sofort austrinkt."}));
  AddDrink("Ein Achterl Rotwein", ({"achterl", "acht", "8", "rotwein", 
        "achterl rot", "achterl rotwein", "rot"}),
      88, ({9,15,8}), 2, 2,
      ({"Du drueckst auf Knopf 8 und ploetzlich materialisiert sich ein "
       "Glas Rotwein vor Dir auf der Theke, das Du sofort austrinkt.",
       "&& drueckt auf Knopf 10 und ploetzlich materialisiert sich ein "
       "Glas Rotwein vor &3 auf der Theke, das &! sofort austrinkt."}));
  AddDrink("Ein Sechserpack Zwergenbier", ({"bier", "sechs", "6", 
        "zwergenbier", "sechserpack", "sechserpack zwergenbier"}),
      666, ({65,45,25}), 9, 9,
      ({"Du drueckst auf Knopf 6 und ploetzlich materialisiert sich ein "
       "Sechserpack Bier vor Dir auf der Theke. Du trinkst alle 6 Flaschen "
       "aus und musst laut ruelpsen.",
       "&& drueckt auf Knopf 10 und ploetzlich materialisiert sich ein "
       "Sechserpack Bier vor &3 auf der Theke. && trinkt alle 6 Flaschen "
       "aus und muss laut ruelpsen."}));
  AddDrink("Ein Viertel Astralwein", ({"viertel", "vier", "4", 
        "astralwein", "viertel astral", "viertel astralwein", "astral" }),
      444, ({40,35,26}), 0, 11,
      ({"Du drueckst auf Knopf 4 und ploetzlich materialisiert sich ein "
       "Glas Astralwein vor Dir auf der Theke. Du trinkst dem "
       "Wein, aber spuerst ueberhaupt keinen Alkohol.",
       "&& drueckt auf Knopf 10 und ploetzlich materialisiert sich ein "
       "Glas Astralwein vor &3 auf der Theke, das &! sofort austrinkt."}));
  AddDrink("Doppelt gebrannter Schnaps", ({"schnaps", "zwei", "2", 
        "gebrannter", "doppelt gebrannter schnaps"}),
      222, 22, 4, 0,
      ({"Du drueckst auf Knopf 2 und ploetzlich materialisiert sich ein "
       "Stamperl doppelt gebrannter Schnaps vor Dir auf der Theke, das Du "
       "sofort austrinkst. Und der BRENNT!!!!",
       "&& drueckt auf Knopf 2 und ploetzlich materialisiert sich ein "
       "Stamperl doppelt gebrannter Schnaps vor &3 auf der Theke, das &! "
       "sofort austrinkt."}));

  AddFood ( "Neun Salatblaetter", 
      ({"9", "neun", "salat", "salatblaetter", "neun salatblaetter"}),
      99, 21, 7,
      ({"Du drueckst auf Knopf 9 und ploetzlich materialisieren sich neun "
       "Salatblaetter vor Dir auf der Theke, die Du sofort isst. Bald wachsen "
       "Dir Hasenohren!",
       "&& drueckt auf Knopf 9 und ploetzlich materialisieren sich neun "
       "Salatblaetter vor &3 auf der Theke, die &! sofort isst."}) );
  AddFood ( "Sieben belegte Broetchen", ({"7", "sieben", "broetchen", 
        "belegte broetchen", "sieben belegte broetchen"}),
      777, ({100,20}), 16,
      ({"Du drueckst auf Knopf 9 und ploetzlich materialisieren sich sieben "
       "belegte Broetchen vor Dir auf der Theke, die Du sofort isst.",
       "&& drueckt auf Knopf 9 und ploetzlich materialisieren sich sieben "
       "belegte Broetchen vor &3 auf der Theke, die &! sofort isst."}) );
  AddFood ( "Fuenf gebratene Forellen", ({"5", "fuenf", "forellen", 
        "gebratene forellen", "fuenf gebratene forellen"}),
      555, ({10,90}), 12,
      ({"Du drueckst auf Knopf 5 und ploetzlich materialisieren sich fuenf "
       "gebratene Forellen vor Dir auf der Theke, die Du sofort isst.",
       "&& drueckt auf Knopf 9 und ploetzlich materialisieren sich fuenf "
       "gebratene Forellen vor &3 auf der Theke, die &! sofort isst."}) );
  AddFood ( "Drei Elefanteneier in Maeusesauce", 
      ({"3", "drei", "eier", "elefanteneier", "drei elefanteneier",
       "drei elefanteneier in maeusesauce",}),
      3333, 333, 33,
      ({"Du drueckst auf Knopf 3 und ploetzlich materialisieren sich drei "
       "gigantisch grosse Elefanteneier in einer leckeren Maeusesauce vor "
       "Dir auf der Theke. Du stopfst alles in Dich hinein und bist nun "
       "komplett voll.",
       "&& drueckt auf Knopf 3 und ploetzlich materialisieren sich drei "
       "gigantisch grosse Elefanteneier in einer leckeren Maeusesauce vor "
       "&3 auf der Theke, die &! sofort isst."}) );
  AddFood ( "Das einzigartige Festmahl", 
      ({"eins", "1", "festmahl", "einzigartiges festmahl"}),
      11111, 400, 25, "primus_heal");

  AddSpecialDetail( ({"speise", "speisen", "getraenke", "getraenk", 
        "bestellen", "essen", "trinken"}), 
      "det_menu");
  AddDetail( ({"theke"}),
      "Auf der langen Theke befinden sich 10 Knoepfe, die wohl fuer das "
      "Bestellen der Speisen und Getraenke zustaendig sind.");
  AddDetail( ({"knoepfe"}),
      "Mit den 10 Knoepfen kannst Du ein Getraenk oder eine Speise Deiner "
      "Wahl bestellen.");
  AddDetail( ({"wahl", "druecken", "auswahl"}),
      "Durch das Druecken der Knoepfe kannst Du Dir Essen und Trinken auswaehlen.");
  AddDetail( ({"kneipe", "raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"einszweidrei"}),
      "123.");
  AddDetail( ({"eins"}),
      "1.");
  AddDetail( ({"zwei"}),
      "2.");
  AddDetail( ({"drei"}),
      "3.");
  AddDetail( ({"1"}),
      "Eins.");
  AddDetail( ({"2"}),
      "Zwei.");
  AddDetail( ({"3"}),
      "Drei.");
  AddDetail( ({"boden"}),
      "Auf dem Boden steht in riesigen Zahlen: 123.");
  AddDetail( ({"decke"}),
      "Die Decke ist voll mit klitzekleinen Zahlen.");
  AddDetail( ({"zahlen"}),
      "Eins, Zwei, Drei........");
  AddDetail( ({"waende", "wand"}),
      "Die Waende sind voller Zahlen.");
  AddDetail( ({"mechanus", "ebene"}),
      "Du befindest Dich in Mechanus, der Ebene der Zahlen.");
  AddDetail( ({"sueden", "westen", "osten", "nordosten",
               "nordwesten", "suedosten", "suedwesten"}),
      "Kein Ausgang in dieser Richtung");
  AddDetail( ({"richtung", "richtungen"}),
      "Norden, Sueden, Osten, Westen, Nordwesten, Nordosten, Suedwesten, "
      "Suedosten.");
  AddSpecialDetail( ({"ausgang", "ausgaenge", "norden"}), "GetExits");

  AddCmd( ({"druecke", "drueck"}), "cmd_druecken");

  AddExit ("norden", "./eingang");

  RemoveItem("/obj/topliste");
  AddDetail( ({"liste", "mechanusliste", "topliste", "topmechanusliste", 
        "top-mechanusliste"}), #'read_liste);
  AddReadDetail( ({"liste", "mechanusliste", "topliste", "topmechanusliste", 
        "top-mechanusliste"}), #'read_liste);
  SetProp(P_ZONE, "Mechanus");
#include "../../where.h"
}

string det_menu()
{
  TP->command_me("menue");
  return "";
}

int cmd_druecken(string str)
{
  string knopf;
  int nr;
  notify_fail("Was willst Du druecken?\n");
  if( !str )
    return 0;
  if( (sscanf(str, "%s knopf",knopf) == 1 || 
      sscanf(str, "knopf %s", knopf) == 1) && (
      member( ({"eins", "zwei", "drei", "vier", "fuenf", "sechs", "sieben", 
          "acht", "neun", "zehn"}), knopf ) != -1 || 
      (sscanf(knopf, "%d",nr) == 1 && nr > 0 && nr < 11) ))
  {
    TP->command_me("kaufe " + knopf); 
    return 1;
  }
  return 0;
}

void primus_heal(object z, object e)
{
  tell_object(e, BS(
      "Du drueckst auf Knopf 1 und ploetzlich materialisiert sich ein "
       "einzigartiges Festmahl vor Dir auf der Theke, das Du sofort isst. "
       "Du fuehlst Dich wie neugeboren."));
  tell_room(TO, BS(
       e->Name(WER)+ " drueckt auf Knopf 1 und ploetzlich materialisiert "
       "sich ein einzigartiges Festmahl vor " + e->QueryPronoun(WEM) +
       "auf der Theke, die " + e->QueryPronoun(WER) + " sofort isst."),
      ({e}));
  e->SetProp(P_BLIND, 0);
  e->SetProp(P_DEAF, 0);
  e->SetProp(P_FROG, 0);
  e->SetProp(P_POISON, 0);
  e->SetProp(P_ALCOHOL, e->QueryProp(P_ALCOHOL) / 2);
  e->SetProp(P_DRINK, e->QueryProp(P_DRINK) / 2);
  e->SetProp(P_MV, e->QueryProp(P_MAX_MV));
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  return ::int_long(viewer, viewpoint, shortflag) +
    "Die Top-Mechanusliste.\n";
}

string read_liste()
{
  write(
    "Die Liste der beruehmtesten Helden in Mechanus\n"
    "----------------------------------------------\n");
  ASTRALMASTER->FameList("mechanus");
  return "";
}
