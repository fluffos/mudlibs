
#include "../def.h"

inherit ROOM "7_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./10_5");
  AddExit ("suedosten" ,"./6_4");
  AddExit ("suedwesten", "./5_5");
  AddExit ("westen", "./3_2");

  AddDetail( ({"spur", "spuren", "weg", "westen"}),
      "Der Weg fuehrt in drei Spuren nach Westen.");
  AddDetail( ({"verbindung", "suedwesten"}),
      "Ein fuenfeckiger Tunnel fuehrt nach Suedwesten.");
  AddDetail( ({"durchgang", "meter", "osten"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Osten.");
  AddDetail( ({"tuer", "suedosten"}),
      "Es gibt eine sechsseckige Tuer hier, die nach Suedosten fuehrt. ");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: eine dreispuriger Weg fuehrt nach "
      "Westen, ein fuenfeckiger Tunnel geht nach Suedwesten, eine sechseckige "
      "Tuer fuehrt nach Suedosten und ein 10 Meter breiter Durchgang nach "
      "Osten."));
}
