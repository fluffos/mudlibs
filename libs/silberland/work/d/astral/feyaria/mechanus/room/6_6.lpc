
#include "../def.h"

inherit ROOM "6_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./10_9");
  AddExit ("nordosten" ,"./7_7");
  AddExit ("suedosten" ,"./8_8");
  AddExit ("suedwesten", "./3_3");

  AddDetail( ({"spur", "spuren", "weg", "suedwesten"}),
      "Der Weg fuehrt in drei Spuren nach Suedwesten.");
  AddDetail( ({"pforte", "nordosten"}),
      "Eine siebeneckige Pforte fuehrt nach Nordosten.");
  AddDetail( ({"ausgang", "suedosten"}),
      "Ein achteckiger Ausgang fuehrt nach Suedosten.");
  AddDetail( ({"durchgang", "meter", "norden"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Norden.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: ein dreispuriger Weg fuehrt "
      "nach Suedwesten, eine siebeneckige Pforte nach Nordosten, ein "
      "achteckiger Ausgang nach Suedosten und ein 10 Meter breiter "
      "Durchgang nach Norden."));
}
