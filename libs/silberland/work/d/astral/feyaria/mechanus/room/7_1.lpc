
#include "../def.h"

inherit ROOM "7_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./5_1");
  AddExit ("sueden", "./5_3");
  AddExit ("nordwesten", "./4_1");

  AddDetail( ({"verbindung", "nordwesten"}),
      "Eine viereckige Verbindung geht nach Nordwesten.");
  AddDetail( ({"tunnel", "sueden", "nordosten"}),
      "Es gibt zwei fuenfeckige Tunnel hier, einer nach Nordosten und "
      "der andere nach Sueden.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine viereckige Verbindung geht "
      "nach Nordwesten und zwei fuenfeckige Tunnel fuehren nach Nordosten "
      "und Sueden."));
}
