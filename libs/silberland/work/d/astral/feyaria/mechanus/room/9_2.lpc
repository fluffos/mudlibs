
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./4_1");
  AddExit ("sueden", "./10_3");

  AddDetail( ({"verbindung", "nordosten"}),
      "Eine viereckige Verbindung fuehrt nach Nordosten.");
  AddDetail( ({"durchgang", "meter", "sueden"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Sueden.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: eine viereckige Verbindung fuehrt "
      "nach Nordosten und ein 10 Meter breiter Durchgang nach Sueden."));
}
