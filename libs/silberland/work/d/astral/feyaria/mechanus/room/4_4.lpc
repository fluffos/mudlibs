
#include "../def.h"

inherit ROOM "4_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./9_8");
  AddExit ("suedwesten", "./8_8");
  AddExit ("nordwesten", "./7_7");

  AddDetail( ({"pforte", "nordwesten"}),
      "Eine siebeneckige Pforte fuehrt nach Nordwesten.");
  AddDetail( ({"ausgang", "suedwesten"}),
      "Ein achteckiger Ausgang fuehrt nach Suedwesten.");
  AddDetail( ({"gang", "nordosten"}),
      "Der Gang nach Nordosten ist neuneckig.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine siebeneckige Pforte fuehrt "
      "nach Nordwesten, ein achteckiger Ausgang nach Suedwesten und ein "
      "neuneckiger Gang nach Nordosten."));
}
