
#include "../def.h"

inherit ROOM "10_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./6_1");
  AddExit ("suedosten" ,"./7_4");
  AddExit ("suedwesten", "./8_5");
  AddExit ("westen", "./8_3");

  AddDetail( ({"tuer", "osten"}),
      "Eine sechseckige Tuer fuehrt nach Osten.");
  AddDetail( ({"pforte", "suedosten"}),
      "Eine siebeneckige Pforte fuehrt nach Suedosten.");
  AddDetail( ({"ausgang", "westen", "suedwesten"}),
      "Zwei achteckige Ausgaenge fuehren nach Westen und Suedwesten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: eine sechseckige Tuer fuehrt "
      "nach Osten, eine siebeneckige Pforte nach Suedosten und "
      "zwei achteckige Ausgaenge nach Westen und Suedwesten."));
}
