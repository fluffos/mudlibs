
#include "../def.h"

inherit ROOM "7_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./4_2");
  AddExit ("sueden", "./5_4");
  AddExit ("nordwesten", "./5_2");

  AddDetail( ({"verbindung", "nordosten"}),
      "Eine viereckige Verbindung geht nach Nordosten.");
  AddDetail( ({"tunnel", "sueden", "nordwesten"}),
      "Es gibt zwei fuenfeckige Tunnel hier, einer nach Nordwesten und "
      "der andere nach Sueden.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine viereckige Verbindung geht "
      "nach Nordosten und zwei fuenfeckige Tunnel fuehren nach Nordwesten "
      "und Sueden."));
}
