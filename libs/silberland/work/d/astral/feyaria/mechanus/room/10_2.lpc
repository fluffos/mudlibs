
#include "../def.h"

inherit ROOM "10_inh";

void create() 
{
  ::create();

  AddExit ("sueden", "./9_4");
  AddExit ("nordwesten", "./4_2");

  AddDetail( ({"verbindung", "nordwesten"}),
      "Eine viereckige Verbindung fuehrt nach Nordwesten.");
  AddDetail( ({"sueden", "gang"}),
      "Nach Sueden fuehrt ein neuneckiger Gang.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: eine viereckige Verbindung fuehrt "
      "nach Nordwesten und ein neuneckiger Gang nach Sueden."));
}
