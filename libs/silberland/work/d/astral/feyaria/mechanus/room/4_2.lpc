
#include "../def.h"

inherit ROOM "4_inh";

void create() 
{
  ::create();

  AddExit ("suedosten" ,"./10_2");
  AddExit ("suedwesten", "./7_2");
  AddExit ("nordwesten", "./8_2");

  AddDetail( ({"pforte", "suedwesten"}),
      "Eine siebeneckige Pforte fuehrt nach Suedwesten.");
  AddDetail( ({"ausgang", "nordwesten"}),
      "Ein achteckiger Ausgang fuehrt nach Nordwesten.");
  AddDetail( ({"gang", "suedosten", "meter"}),
      "Der Durchgang nach Suedosten ist 10 Meter breit.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine siebeneckige Pforte fuehrt "
      "nach Suedwesten, ein achteckiger Ausgang nach Nordwesten und ein "
      "10 Meter breiter Durchgang nach Suedosten."));
}
