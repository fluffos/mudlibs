
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In einem fuenfeckigen Raum");
  SetProp(P_INT_LONG,
      "Du stehst in einem fuenfeckigen Raum, der wohl das Heim eines Quintons "
      "ist, denn er ist eindeutig der Zahl fuenf gewidmet. Daher gibt es hier "
      "auch fuenf Waende und fuenf Ecken. Die Waende sind ueber und ueber mit Zahlen "
      "bedeckt, die alle nur aus der Ziffer '5' bestehen.");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden"}),
      "Der Boden besteht aus kleinen Pentagonen.");
  AddDetail( ({"decke"}),
      "Die Decke besteht aus kleinen Pentagrammen.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den fuenf Waenden stehen eine Menge Zahlen.");
  AddDetail( ({"ecken"}),
      "Die fuenf Waende bilden fuenf Ecken.");
  AddDetail( ({"ecke", "eck"}),
      "Es gibt fuenf Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '5'.");
  AddDetail( ({"quinton", "heim"}),
      "Hier koenntest Du einen Quinton treffen, leider ist gerade keiner da.");
  AddDetail( ({"pentagon", "pentagone"}),
      "Ein Pentagon ist ein regelmaessiges Fuenfeck.");
  AddDetail( ({"fuenfeck", "fuenfecke"}),
      "Ueberall Fuenfecke.");
  AddDetail( ({"pentagramm", "pentagramme", "sterne", "stern"}),
      "Ein Pentagramm ist ein fuenfzackiger Stern.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige, von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf den Waenden.");
  AddDetail( ({"5"}),
      "Fuenf.");
  AddDetail( ({"fuenf"}),
      "5.");
  AddDetail( ({"55"}),
      "Fuenfundfuenfzig.");
  AddDetail( ({"fuenfundfuenfzig"}),
      "55.");
  AddDetail( ({"555"}),
      "Fuenfhundertfuenfundfuenfzig.");
  AddDetail( ({"fuenfhundertfuenfundfuenfzig"}),
      "555.");
  AddDetail( ({"5555"}),
      "Fuenftausendfuenfhundertfuenfundfuenfzig.");
  AddDetail( ({"fuenftausendfuenfhundertfuenfundfuenfzig"}),
      "5555.");
  AddDetail( ({"55555"}),
      "Fuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig.");
  AddDetail( ({"fuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig"}),
      "55555.");
  AddDetail( ({"555555"}),
      "Fuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig.");
  AddDetail( ({"fuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig"}),
      "555555.");
  AddDetail( ({"5555555"}),
      "Fuenfmillionenfuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig.");
  AddDetail( ({"fuenfmillionenfuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig"}),
      "5555555.");
  AddDetail( ({"55555555"}),
      "Fuenfundfuenfzigmillionenfuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig.");
  AddDetail( ({"fuenfundfuenfzigmillionenfuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig"}),
      "55555555.");
  AddDetail( ({"555555555"}),
      "Fuenfhundertfuenfundfuenfzigmillionenfuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig.");
  AddDetail( ({"fuenfhundertfuenfundfuenfzigmillionenfuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig"}),
      "555555555.");
  AddDetail( ({"5555555555"}),
      "Fuenfmilliardenfuenfhundertfuenfundfuenfzigmillionenfuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig.");
  AddDetail( ({"fuenfmilliardenfuenfhundertfuenfundfuenfzigmillionenfuenfhundertfuenfundfuenfzigtausendfuenfhundertfuenfundfuenfzig"}),
      "5555555555.");
  AddDetail( ({"55555555555", "555555555555", "5555555555555", "5555555555555"}),
      "Vor lauter Fuenfen wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "5";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}
