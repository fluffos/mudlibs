
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./eingang");
  AddExit ("sueden", "./6_5");

  AddDetail( ({"gang", "sueden"}),
      "Eine sechseckige Tuer fuehrt nach Sueden.");
  AddDetail( ({"ausgang", "osten"}),
      "Ein normaler Ausgang fuehrt nach Osten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: eine sechseckige Tuer fuehrt nach "
      "Sueden und durch einen normalen Ausgang kommt man nach Osten ."));
}
