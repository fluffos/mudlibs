
#include "../def.h"

inherit ROOM "6_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./5_4");
  AddExit ("suedosten" ,"./10_5");
  AddExit ("nordwesten", "./7_3");
  AddExit ("suedwesten", "./3_2");

  AddDetail( ({"spur", "spuren", "weg", "suedwesten"}),
      "Der Weg fuehrt in drei Spuren nach Suedwesten.");
  AddDetail( ({"tunnel", "nordosten"}),
      "Ein fuenkeckiger Tunnel fuehrt nach Nordosten.");
  AddDetail( ({"pforte", "nordwesten"}),
      "Eine siebeneckige Pforte fuehrt nach Nordwesten.");
  AddDetail( ({"durchgang", "meter", "suedosten"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Suedosten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: ein dreispuriger Weg fuehrt "
      "nach Suedwesten, ein fuenfeckiger Tunnel nach Nordosten, eine "
      "siebeneckige Pforte nach Nordwesten und ein 10 Meter breiter "
      "Durchgang nach Suedosten."));
}
