
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In einem trigonalen Raum");
  SetProp(P_INT_LONG,
      "Du stehst in einem trigonalen Raum, der wohl das Heim eines Tertians "
      "ist, denn er ist eindeutig der Zahl Drei gewidmet. Daher gibt es hier "
      "auch drei Waende und drei Ecken. Die Waende sind ueber und ueber mit Zahlen "
      "bedeckt, die alle nur aus der Ziffer '3' bestehen.");

  AddDetail( ({"boden"}),
      "Der Boden ist mit dreieckigen Fliesen ausgelegt.");
  AddDetail( ({"decke"}),
      "Die Decke besteht aus dreieckigen Fliesen.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den drei Waenden stehen eine Menge Zahlen.");
  AddDetail( ({"ecken"}),
      "Die drei Waende bilden drei Ecken.");
  AddDetail( ({"ecke", "eck"}),
      "Es gibt drei Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '3'.");
  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"tertian", "heim"}),
      "Hier koenntest Du einen Tertian treffen, leider ist gerade keiner da.");
  AddDetail( ({"fliesen", "fliese"}),
      "Kleine Dreiecke, es gibt sie ueberall am Boden und an der Decke. Hier "
      "muss wohl ein fleissiger Fliesenleger gearbeitet haben.");
  AddDetail( ({"dreieck", "dreiecke"}),
      "Ueberall Dreiecke.");
  AddDetail( ({"fliesenleger"}),
      "Du singst: des schenste im leb'n fuer mi is fliesenlegen.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf den Waenden.");
  AddDetail( ({"3"}),
      "Drei.");
  AddDetail( ({"drei"}),
      "3.");
  AddDetail( ({"33"}),
      "Dreiunddreissig.");
  AddDetail( ({"dreiunddreissig"}),
      "33.");
  AddDetail( ({"333"}),
      "Dreihundertdreiunddreissig.");
  AddDetail( ({"dreihundertdreiunddreissig"}),
      "333.");
  AddDetail( ({"3333"}),
      "Dreitausenddreihundertdreiunddreissig.");
  AddDetail( ({"dreitausenddreihundertdreiunddreissig"}),
      "3333.");
  AddDetail( ({"33333"}),
      "Dreiunddreissigtausenddreihundertdreiunddreissig.");
  AddDetail( ({"dreiunddreissigtausenddreihundertdreiunddreissig"}),
      "33333.");
  AddDetail( ({"333333"}),
      "Dreihundertdreiunddreissigtausenddreihundertdreiunddreissig.");
  AddDetail( ({"dreihundertdreiunddreissigtausenddreihundertdreiunddreissig"}),
      "333333.");
  AddDetail( ({"3333333"}),
      "Dreimillionendreihundertdreiunddreissigtausenddreihundertdreiunddreissig.");
  AddDetail( ({"dreimillionendreihundertdreiunddreissigtausenddreihundertdreiunddreissig"}),
      "3333333.");
  AddDetail( ({"33333333"}),
      "Dreiunddreissigmillionendreihundertdreiunddreissigtausenddreihundertdreiunddreissig.");
  AddDetail( ({"dreiunddreissigmillionendreihundertdreiunddreissigtausenddreihundertdreiunddreissig"}),
      "33333333.");
  AddDetail( ({"333333333"}),
      "Dreihundertdreiunddreissigmillionendreihundertdreiunddreissigtausenddreihundertdreiunddreissig.");
  AddDetail( ({"dreihundertdreiunddreissigmillionendreihundertdreiunddreissigtausenddreihundertdreiunddreissig"}),
      "333333333.");
  AddDetail( ({"3333333333"}),
      "Dreimilliardendreihundertdreiunddreissigmillionendreihundertdreiunddreissigtausenddreihundertdreiunddreissig.");
  AddDetail( ({"dreimilliardendreihundertdreiunddreissigmillionendreihundertdreiunddreissigtausenddreihundertdreiunddreissig"}),
      "3333333333.");
  AddDetail( ({"33333333333", "333333333333", "3333333333333", "3333333333333"}),
      "Vor lauter Dreien wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "3";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}
