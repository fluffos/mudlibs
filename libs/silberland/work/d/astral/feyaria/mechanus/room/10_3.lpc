
#include "../def.h"

inherit ROOM "10_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./9_2");
  AddExit ("suedosten" ,"./8_3");

  AddDetail( ({"ausgang", "suedosten"}),
      "Ein achteckiger Ausgang fuehrt nach Suedosten.");
  AddDetail( ({"gang", "norden"}),
      "Der Gang nach Norden ist neuneckig.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: ein achteckiger Ausgang fuehrt "
      "nach Suedosten und ein neuneckiger Gang nach Norden."));
}
