
#include "../def.h"

inherit ROOM "8_inh";

void create() 
{
  ::create();

  AddExit ("suedosten" ,"./4_2");
  AddExit ("suedwesten", "./5_2");
  AddExit ("westen", "./10_1");

  AddDetail( ({"verbindung", "suedosten"}),
      "Eine viereckige Verbindung geht nach Suedosten.");
  AddDetail( ({"tunnel", "suedwesten"}),
      "Ein fuenfeckiger Tunnel fuehrt nach Suedwesten.");
  AddDetail( ({"westen", "meter", "durchgang"}),
      "Ein 10 Meter breiter Druchgang fuehrt nach Westen.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine viereckige Verbindung geht "
      "nach Suedosten, ein fuenfeckiger Tunnel fuehrt nach Suedwesten "
      "und ein 10 Meter breiter Durchgang nach Westen."));
}
