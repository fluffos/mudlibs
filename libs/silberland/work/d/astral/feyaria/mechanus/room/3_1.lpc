
#include "../def.h"

inherit ROOM "3_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./2_1");
  AddExit ("osten" ,"./10_1");
  AddExit ("suedosten" ,"./5_2");
  AddExit ("suedwesten", "./5_1");
  AddExit ("westen", "./9_1");

  AddDetail( ({"tor", "norden"}),
      "Das doppelfluegelige Tor fuehrt nach Norden.");
  AddDetail( ({"gang", "westen"}),
      "Der neuneckige Gang fuehrt nach Westen.");
  AddDetail( ({"osten", "durchgang", "meter"}),
      "Nach Osten fuehrt der 10 Meter breite Durchgang");
  AddDetail( ({"suedwesten", "suedosten", "tunnel"}),
      "Dorthin fuehrt eine fuenfeckiger Tunnel.");
}

string GetExits()
{
  string b, n;
  if( TP && member( ({"ansi", "vt100"}), TP->QueryProp(P_TTY) ) != -1 )
  {
    b = ANSI_BOLD; 
    n = ANSI_NORMAL;
  }
  else
    b=n="";
  return "Es gibt fuenf sichtbare Ausgaenge: ein zweifluegeliges Tor "
      "fuehrt nach "+b+"Norden"+n+",\nein neuneckiger Gang geht nach "+
      b+"Westen"+n+", im "+b+"Osten"+n+" siehst Du einen 10 Meter\n"
      "breiten Durchgang und nach "+b+"Suedwesten"+n+" und "
      +b+"Suedosten"+n+" gibt es je einen\nfuenfeckigen Tunnel.\n";
}
