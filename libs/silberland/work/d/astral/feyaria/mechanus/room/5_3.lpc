
#include "../def.h"

inherit ROOM "5_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./7_1");
  AddExit ("suedosten" ,"./6_1");
  AddExit ("suedwesten", "./8_3");

  AddDetail( ({"gang", "suedosten"}),
      "Eine sechseckige Tuer fuehrt nach Suedosten.");
  AddDetail( ({"pforte", "norden"}),
      "Eine siebeneckige Pforte fuehrt nach Norden.");
  AddDetail( ({"ausgang", "suedwesten"}),
      "Ein achteckiger Ausgang fuehrt nach Suedwesten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine sechseckige Tuer fuehrt "
      "nach Suedosten, eine siebeneckige Pforte nach Norden und ein "
      "achteckiger Ausgang nach Suedwesten."));
}
