
#include "../def.h"

inherit ROOM "8_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./6_5");
  AddExit ("osten" ,"./10_10");
  AddExit ("nordwesten", "./4_3");

  AddDetail( ({"verbindung", "nordwesten"}),
      "Eine viereckige Verbindung geht nach Nordwesten.");
  AddDetail( ({"tuer", "nordosten"}),
      "Eine sechseckige Tuer fuehrt nach Nordosten.");
  AddDetail( ({"osten", "meter", "durchgang"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Osten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine viereckige Verbindung geht "
      "nach Nordwesten, eine sechseckige Tuer fuehrt nach Nordosten "
      "und ein 10 Meter breiter Durchgang nach Osten."));
}
