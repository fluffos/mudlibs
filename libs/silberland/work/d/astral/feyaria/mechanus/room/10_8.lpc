
#include "../def.h"

inherit ROOM "10_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./9_5");
  AddExit ("suedosten" ,"./4_3");

  AddDetail( ({"verbindung", "suedosten"}),
      "Eine viereckige Verbindung fuehrt nach Suedosten.");
  AddDetail( ({"norden", "gang"}),
      "Nach Norden fuehrt ein neuneckiger Gang.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: eine viereckige Verbindung fuehrt "
      "nach Suedosten und ein neuneckiger Gang nach Norden."));
}
