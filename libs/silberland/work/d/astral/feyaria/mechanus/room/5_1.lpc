
#include "../def.h"

inherit ROOM "5_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./3_1");
  AddExit ("suedosten" ,"./9_3");
  AddExit ("suedwesten", "./7_1");
  AddExit ("nordwesten", "./8_1");

  AddDetail( ({"spur", "spuren", "weg", "nordosten"}),
      "Der Weg fuehrt in drei Spuren nach Nordosten.");
  AddDetail( ({"pforte", "suedwesten"}),
      "Eine siebeneckige Pforte fuehrt nach Suedwesten.");
  AddDetail( ({"ausgang", "nordwesten"}),
      "Ein achteckiger Ausgang fuehrt nach Nordwesten.");
  AddDetail( ({"gang", "suedosten"}),
      "Der Gang nach Suedosten ist neuneckig.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: ein dreispuriger Weg fuehrt "
      "nach Nordosten, eine siebeneckige Pforte nach Suedwesten, ein "
      "achteckiger Ausgang nach Nordwesten und ein neuneckiger Gang nach "
      "Suedosten."));
}
