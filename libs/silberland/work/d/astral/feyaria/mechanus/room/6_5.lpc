
#include "../def.h"

inherit ROOM "6_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./9_7");
  AddExit ("suedosten" ,"./3_3");
  AddExit ("suedwesten", "./8_7");
  AddExit ("nordwesten", "./7_6");

  AddDetail( ({"spur", "spuren", "weg", "suedosten"}),
      "Der Weg fuehrt in drei Spuren nach Suedosten.");
  AddDetail( ({"pforte", "nordwesten"}),
      "Eine siebeneckige Pforte fuehrt nach Nordwesten.");
  AddDetail( ({"ausgang", "suedwesten"}),
      "Ein achteckiger Ausgang fuehrt nach Suedwesten.");
  AddDetail( ({"gang", "norden"}),
      "Der Gang nach Norden ist neuneckig.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: ein dreispuriger Weg fuehrt "
      "nach Suedosten, eine siebeneckige Pforte nach Nordwesten, ein "
      "achteckiger Ausgang nach Suedwesten und ein neuneckiger Gang nach "
      "Norden."));
}
