
#include "../def.h"

inherit ROOM "6_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./8_6");
  AddExit ("sueden", "./7_7");
  AddExit ("westen", "./9_6");
  AddExit ("nordwesten", "./7_5");

  AddDetail( ({"pforte", "pforten", "nordwesten", "sueden"}),
      "Zwei siebeneckige Pforten fuehren nach Nordwesten und Sueden.");
  AddDetail( ({"ausgang", "nordwesten"}),
      "Ein achteckiger Ausgang fuehrt nach Nordosten.");
  AddDetail( ({"gang", "westen"}),
      "Der Gang nach Westen ist neuneckig.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: zwei siebeneckige Pforten "
      "fuehren nach Nordwesten und Sueden, ein achteckiger Ausgang nach "
      "Nordosten und ein neuneckiger Gang nach Westen."));
}
