
#include "../def.h"

inherit ROOM "8_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./5_3");
  AddExit ("osten" ,"./10_4");
  AddExit ("sueden", "./8_5");
  AddExit ("nordwesten", "./10_3");

  AddDetail( ({"tunnel", "nordosten"}),
      "Ein fuenkeckiger Tunnel fuehrt nach Nordosten.");
  AddDetail( ({"ausgang", "sueden"}),
      "Ein achteckiger  Ausgang fuehrt nach Sueden.");
  AddDetail( ({"durchgang", "meter", "nordwesten", "osten"}),
      "Nach Nordwesten und Osten fuehrt je ein 10 Meter breiter Durchgang.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: ein fuenfeckiger Tunnel fuehrt "
      "nach Nordosten, ein achteckiger Ausgang geht nach Sueden und "
      "nach Nordwesten und Osten fuehrt je ein 10 Meter breiter Durchgang."));
}
