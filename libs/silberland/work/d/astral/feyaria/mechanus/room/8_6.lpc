
#include "../def.h"

inherit ROOM "8_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./8_4");
  AddExit ("suedosten" ,"./10_7");
  AddExit ("suedwesten", "./6_4");
  AddExit ("westen", "./10_5");

  AddDetail( ({"tuer", "suedwesten"}),
      "Eine sechseckige Tuer fuehrt nach Suedwesten.");
  AddDetail( ({"ausgang", "norden"}),
      "Ein achteckiger  Ausgang fuehrt nach Norden.");
  AddDetail( ({"durchgang", "meter", "westen", "suedosten"}),
      "Nach Westen und suedosten fuehrt je ein 10 Meter breiter Durchgang.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: eine sechseckige Tuer fuehrt "
      "nach Suedwesten, ein achteckiger Ausgang geht nach Norden und "
      "nach Westen und Suedosten fuehrt je ein 10 Meter breiter Durchgang."));
}
