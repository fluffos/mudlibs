
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In der Dualitaet der Secundi");
  SetProp(P_INT_LONG,
      "Du stehst in der Dualitaet der Secundi. Dieser Raum scheint der "
      "der Zahl Zwei gewidmet zu sein. Daher gibt es hier auch nur zwei "
      "Waende und zwei Ecken. Die Waende sind ueber und ueber mit Zahlen "
      "bedeckt, die alle nur aus der Ziffer '2' bestehen.");

  AddDetail( ({"boden"}),
      "Der Boden ist mit zweifaerbigen Kacheln ausgelegt, und zwar in Blau "
      "und Gelb.");
  AddDetail( ({"decke"}),
      "Die Decke besteht aus zweifarbigen Kacheln, und zwar in Rot und Gruen.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den beiden Waenden stehen eine Menge Zahlen.");
  AddDetail( ({"ecken"}),
      "Die zwei Waende bilden zwei Ecken.");
  AddDetail( ({"ecke"}),
      "Es gibt zwei Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '2'.");
  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"secundi", "mehrzahl"}),
      "Die Mehrzahl von Secundus.");
  AddDetail( ({"secundus"}),
      "Hier koenntest Du einen Secundus treffen.");
  AddDetail( ({"sueden", "norden", "richtungen" }),
      "Hier geht es in zwei Richtungen, naemlich nach Norden und nach Sueden.");
  AddDetail( ({"ziel"}),
      "Scheinbar gehen beide Ausgaenge zum selben Ziel, obwohl ihre Richtung "
      "entgegengesetzt ist. Sehr eigenartig.");
  AddDetail( ({"dualitaet"}),
      "Das bedeutet, dass alles doppelt vorhanden ist.");
  AddDetail( ({"kachel", "kacheln"}),
      "Boden und Decke bestehen aus unterschiedlich gefaerbten Kacheln.");
  AddDetail( ({"blau", "gelb", "blau-gelb"}),
      "Die Kacheln am Boden sind Blau-Gelb");
  AddDetail( ({"rot", "gruen", "rot-gruen"}),
      "Die Kacheln auf der Decke sind Rot-Gruen.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige, von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf den Waenden.");
  AddDetail( ({"2"}),
      "Zwei.");
  AddDetail( ({"zwei"}),
      "2.");
  AddDetail( ({"22"}),
      "Zweiundzwanzig.");
  AddDetail( ({"zweiundzwanzig"}),
      "22.");
  AddDetail( ({"222"}),
      "zweihundertzweiundzwanzig.");
  AddDetail( ({"zweihundertzweiundzwanzig"}),
      "222.");
  AddDetail( ({"2222"}),
      "Zweitausendzweihundertzweiundzwanzig.");
  AddDetail( ({"zweitausendzweihundertzweiundzwanzig"}),
      "2222.");
  AddDetail( ({"22222"}),
      "Zweiundzwanzigtausendzweihundertzweiundzwanzig.");
  AddDetail( ({"zweiundzwanzigtausendzweihundertzweiundzwanzig"}),
      "22222.");
  AddDetail( ({"222222"}),
      "Zweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig.");
  AddDetail( ({"zweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig"}),
      "222222.");
  AddDetail( ({"2222222"}),
      "Zweimillionenzweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig.");
  AddDetail( ({"zweimillionenzweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig"}),
      "2222222.");
  AddDetail( ({"22222222"}),
      "Zweiundzwanzigmillionenzweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig.");
  AddDetail( ({"zweiundzwanzigmillionenzweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig"}),
      "22222222.");
  AddDetail( ({"222222222"}),
      "Zweihundertzweiundzwanzigmillionenzweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig.");
  AddDetail( ({"zweihundertzweiundzwanzigmillionenzweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig"}),
      "222222222.");
  AddDetail( ({"2222222222"}),
      "Zweimilliardenzweihundertzweiundzwanzigmillionenzweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig.");
  AddDetail( ({"zweimilliardenzweihundertzweiundzwanzigmillionenzweihundertzweiundzwanzigtausendzweihundertzweiundzwanzig"}),
      "2222222222.");
  AddDetail( ({"22222222222", "222222222222", "2222222222222", "2222222222222"}),
      "Vor lauter Zweien wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "2";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}

string GetExits()
{
  return bold_exits(BS( 
      "Es gibt auch zwei Ausgaenge, und zwar nach Norden und Sueden, "
      "aber irgendwie scheint es in beide Richtungen zum selben Ziel zu gehen."));
}
