
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./10_7");
  AddExit ("suedwesten", "./4_4");

  AddDetail( ({"verbindung", "suedwesten"}),
      "Eine viereckige Verbindung fuehrt nach Suedwesten.");
  AddDetail( ({"durchgang", "meter", "norden"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Norden.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: eine viereckige Verbindung fuehrt "
      "nach Suedwesten und ein 10 Meter breiter Durchgang nach Norden."));
}
