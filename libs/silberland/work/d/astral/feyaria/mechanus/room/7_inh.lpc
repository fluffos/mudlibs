
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In einem siebeneckigen Raum");
  SetProp(P_INT_LONG,
      "Du stehst in einem siebeneckigen Raum, der wohl das Heim eines Septons "
      "ist, denn er ist eindeutig der Zahl Sieben gewidmet. Daher gibt es hier "
      "auch sieben Waende und sieben Ecken. Die Waende sind ueber und ueber mit Zahlen "
      "bedeckt, die alle nur aus der Ziffer '7' bestehen.");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden"}),
      "Der Boden besteht aus unregelmaessigen Siebenecken.");
  AddDetail( ({"decke"}),
      "Die Decke besteht aus unregelmaessigen Siebenecken.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den sieben Waenden stehen eine Menge Zahlen.");
  AddDetail( ({"ecken"}),
      "Die sieben Waende bilden sieben Ecken.");
  AddDetail( ({"ecke", "eck"}),
      "Es gibt sieben Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '7'.");
  AddDetail( ({"septon", "heim"}),
      "Hier koenntest Du einen Septon treffen, leider ist gerade keiner da.");
  AddDetail( ({"siebeneck", "siebenecke"}),
      "Ueberall Siebenecke. Obwohl sie unregelmaessig geformt sind und "
      "keines dem anderen gleicht, bilden sie in ihrer Gesamtheit eine "
      "Symmetrie."); 
  AddDetail( ({"gesamtheit", "symmetrie", "eindruck"}),
      "Alle Siebenecke gemeinsam machen einen symmetrischen Eindruck.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige, von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf den Waenden.");
  AddDetail( ({"7"}),
      "Sieben.");
  AddDetail( ({"sieben"}),
      "7.");
  AddDetail( ({"77"}),
      "Siebenundsiebzig.");
  AddDetail( ({"siebenundsiebzig"}),
      "77.");
  AddDetail( ({"777"}),
      "Siebenhundertsiebenundsiebzig.");
  AddDetail( ({"siebenhundertsiebenundsiebzig"}),
      "777.");
  AddDetail( ({"7777"}),
      "Siebentausendsiebenhundertsiebenundsiebzig.");
  AddDetail( ({"siebentausendsiebenhundertsiebenundsiebzig"}),
      "7777.");
  AddDetail( ({"77777"}),
      "Siebenundsiebzigtausendsiebenhundertsiebenundsiebzig.");
  AddDetail( ({"siebenundsiebzigtausendsiebenhundertsiebenundsiebzig"}),
      "77777.");
  AddDetail( ({"777777"}),
      "Siebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig.");
  AddDetail( ({"siebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig"}),
      "777777.");
  AddDetail( ({"7777777"}),
      "Siebenmillionensiebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig.");
  AddDetail( ({"siebenmillionensiebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig"}),
      "7777777.");
  AddDetail( ({"77777777"}),
      "Siebenundsiebzigmillionensiebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig.");
  AddDetail( ({"siebenundsiebzigmillionensiebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig"}),
      "77777777.");
  AddDetail( ({"777777777"}),
      "Siebenhundertsiebenundsiebzigmillionensiebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig.");
  AddDetail( ({"siebenhundertsiebenundsiebzigmillionensiebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig"}),
      "777777777.");
  AddDetail( ({"7777777777"}),
      "Siebenmilliardensiebenhundertsiebenundsiebzigmillionensiebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig.");
  AddDetail( ({"siebenmilliardensiebenhundertsiebenundsiebzigmillionensiebenhundertsiebenundsiebzigtausendsiebenhundertsiebenundsiebzig"}),
      "7777777777.");
  AddDetail( ({"77777777777", "777777777777", "7777777777777", "7777777777777"}),
      "Vor lauter Siebener wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "7";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}
