
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In einem neuneckigen Raum");
  SetProp(P_INT_LONG,
      "Du stehst in einem neuneckigen Raum, der wohl das Heim eines Nonatons "
      "ist, denn er ist eindeutig der Zahl neun gewidmet. Daher gibt es hier "
      "auch neun Waende und neun Ecken. Die Waende sind ueber und ueber mit Zahlen "
      "bedeckt, die alle nur aus der Ziffer '9' bestehen.");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden"}),
      "Der Boden besteht aus unregelmaessigen Neunecken.");
  AddDetail( ({"decke"}),
      "Die Decke besteht aus unregelmaessigen Neunecken.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den neun Waenden stehen eine Menge Zahlen.");
  AddDetail( ({"ecken"}),
      "Die neun Waende bilden neun Ecken.");
  AddDetail( ({"ecke", "eck"}),
      "Es gibt neun Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '9'.");
  AddDetail( ({"nonaton", "heim"}),
      "Hier koenntest Du einen Nonaton treffen, leider ist gerade keiner da.");
  AddDetail( ({"neuneck", "neunecke"}),
      "Ueberall Neunecke. Obwohl sie unregelmaessig geformt sind und "
      "keines dem anderen gleicht, bilden sie in ihrer Gesamtheit eine "
      "Symmetrie."); 
  AddDetail( ({"gesamtheit", "symmetrie", "eindruck"}),
      "Alle Neunecke gemeinsam machen einen symmetrischen Eindruck.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige, von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf den Waenden.");
  AddDetail( ({"9"}),
      "Neun.");
  AddDetail( ({"neun"}),
      "9.");
  AddDetail( ({"99"}),
      "Neunundneunzig.");
  AddDetail( ({"neunundneunzig"}),
      "99.");
  AddDetail( ({"999"}),
      "Neunhundertneunundneunzig.");
  AddDetail( ({"neunhundertneunundneunzig"}),
      "999.");
  AddDetail( ({"9999"}),
      "Neuntausendneunhundertneunundneunzig.");
  AddDetail( ({"neuntausendneunhundertneunundneunzig"}),
      "9999.");
  AddDetail( ({"99999"}),
      "Neunundneunzigtausendneunhundertneunundneunzig.");
  AddDetail( ({"neunundneunzigtausendneunhundertneunundneunzig"}),
      "99999.");
  AddDetail( ({"999999"}),
      "Neunhundertneunundneunzigtausendneunhundertneunundneunzig.");
  AddDetail( ({"neunhundertneunundneunzigtausendneunhundertneunundneunzig"}),
      "999999.");
  AddDetail( ({"9999999"}),
      "Neunmillionenneunhundertneunundneunzigtausendneunhundertneunundneunzig.");
  AddDetail( ({"neunmillionenneunhundertneunundneunzigtausendneunhundertneunundneunzig"}),
      "9999999.");
  AddDetail( ({"99999999"}),
      "Neunundneunzigmillionenneunhundertneunundneunzigtausendneunhundertneunundneunzig.");
  AddDetail( ({"neunundneunzigmillionenneunhundertneunundneunzigtausendneunhundertneunundneunzig"}),
      "99999999.");
  AddDetail( ({"999999999"}),
      "Neunhundertneunundneunzigmillionenneunhundertneunundneunzigtausendneunhundertneunundneunzig.");
  AddDetail( ({"neunhundertneunundneunzigmillionenneunhundertneunundneunzigtausendneunhundertneunundneunzig"}),
      "999999999.");
  AddDetail( ({"9999999999"}),
      "Neunmilliardenneunhundertneunundneunzigmillionenneunhundertneunundneunzigtausendneunhundertneunundneunzig.");
  AddDetail( ({"neunmilliardenneunhundertneunundneunzigmillionenneunhundertneunundneunzigtausendneunhundertneunundneunzig"}),
      "9999999999.");
  AddDetail( ({"99999999999", "999999999999", "9999999999999", "9999999999999"}),
      "Vor lauter neuner wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "9";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}
