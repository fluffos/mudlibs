
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In einem quadratischen Raum");
  SetProp(P_INT_LONG,
      "Du stehst in einem quadratischen Raum, der wohl das Heim eines Quartons "
      "ist, denn er ist eindeutig der Zahl Vier gewidmet. Daher gibt es hier "
      "auch vier Waende und vier Ecken. Die Waende sind ueber und ueber mit Zahlen "
      "bedeckt, die alle nur aus der Ziffer '4' bestehen.");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden"}),
      "Der Boden besteht aus kleinen Quadraten.");
  AddDetail( ({"decke"}),
      "Die Decke besteht aus kleinen Quadraten.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den vier Waenden stehen eine Menge Zahlen.");
  AddDetail( ({"ecken"}),
      "Die vier Waende bilden vier Ecken.");
  AddDetail( ({"ecke", "eck"}),
      "Es gibt vier Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '4'.");
  AddDetail( ({"quarton", "heim"}),
      "Hier koenntest Du einen Quarton treffen, leider ist gerade keiner da.");
  AddDetail( ({"quadrat", "quadrate"}),
      "Ein Quadrat ist ein regelmaessiges Viereck.");
  AddDetail( ({"viereck", "vierecke"}),
      "Ueberall Vierecke.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige, von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf den Waenden.");
  AddDetail( ({"4"}),
      "Vier.");
  AddDetail( ({"vier"}),
      "4.");
  AddDetail( ({"44"}),
      "Vierundvierzig.");
  AddDetail( ({"vierundvierzig"}),
      "44.");
  AddDetail( ({"444"}),
      "Vierhundertvierundvierzig.");
  AddDetail( ({"vierhundertvierundvierzig"}),
      "444.");
  AddDetail( ({"4444"}),
      "Viertausendvierhundertvierundvierzig.");
  AddDetail( ({"viertausendvierhundertvierundvierzig"}),
      "4444.");
  AddDetail( ({"44444"}),
      "Vierundvierzigtausendvierhundertvierundvierzig.");
  AddDetail( ({"vierundvierzigtausendvierhundertvierundvierzig"}),
      "44444.");
  AddDetail( ({"444444"}),
      "Vierhundertvierundvierzigtausendvierhundertvierundvierzig.");
  AddDetail( ({"vierhundertvierundvierzigtausendvierhundertvierundvierzig"}),
      "444444.");
  AddDetail( ({"4444444"}),
      "Viermillionenvierhundertvierundvierzigtausendvierhundertvierundvierzig.");
  AddDetail( ({"viermillionenvierhundertvierundvierzigtausendvierhundertvierundvierzig"}),
      "4444444.");
  AddDetail( ({"44444444"}),
      "Vierundvierzigmillionenvierhundertvierundvierzigtausendvierhundertvierundvierzig.");
  AddDetail( ({"vierundvierzigmillionenvierhundertvierundvierzigtausendvierhundertvierundvierzig"}),
      "44444444.");
  AddDetail( ({"444444444"}),
      "Vierhundertvierundvierzigmillionenvierhundertvierundvierzigtausendvierhundertvierundvierzig.");
  AddDetail( ({"vierhundertvierundvierzigmillionenvierhundertvierundvierzigtausendvierhundertvierundvierzig"}),
      "444444444.");
  AddDetail( ({"4444444444"}),
      "Viermilliardenvierhundertvierundvierzigmillionenvierhundertvierundvierzigtausendvierhundertvierundvierzig.");
  AddDetail( ({"viermilliardenvierhundertvierundvierzigmillionenvierhundertvierundvierzigtausendvierhundertvierundvierzig"}),
      "4444444444.");
  AddDetail( ({"44444444444", "444444444444", "4444444444444", "4444444444444"}),
      "Vor lauter Vieren wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "4";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}
