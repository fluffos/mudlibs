
#include "../def.h"

inherit ROOM "10_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./8_4");
  AddExit ("osten" ,"./8_6");
  AddExit ("westen", "./7_5");
  AddExit ("nordwesten", "./6_2");

  AddDetail( ({"tuer", "nordwesten"}),
      "Eine sechseckige Tuer fuehrt nach Nordwesten.");
  AddDetail( ({"pforte", "westen"}),
      "Eine siebeneckige Pforte fuehrt nach Westen.");
  AddDetail( ({"ausgang", "nordosten", "osten"}),
      "Zwei achteckige Ausgaenge fuehren nach Nordosten und Osten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: eine sechseckige Tuer fuehrt "
      "nach Nordwesten, eine siebeneckige Pforte nach Westen und "
      "zwei achteckige Ausgaenge nach Nordosten und Osten."));
}
