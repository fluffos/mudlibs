
#include "../def.h"

inherit ROOM "8_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./9_4");
  AddExit ("sueden", "./8_6");
  AddExit ("suedwesten", "./10_5");
  AddExit ("nordwesten", "./5_4");

  AddDetail( ({"tunnel", "nordwesten"}),
      "Ein fuenkeckiger Tunnel fuehrt nach Nordwesten.");
  AddDetail( ({"ausgang", "sueden"}),
      "Ein achteckiger Ausgang fuehrt nach Sueden.");
  AddDetail( ({"gang", "nordosten"}),
      "Der Gang nach Nordosten ist neuneckig.");
  AddDetail( ({"durchgang", "meter", "suedwesten"}),
      "Nach Suedwesten fuehrt ein 10 Meter breiter Durchgang.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: ein fuenfeckiger Tunnel fuehrt "
      "nach Nordwesten, ein achteckiger Ausgang geht nach Sueden, ein "
      "neuneckiger Gang nach Nordosten und ein 10 Meter breiter Durchgang "
      "nach Suedwesten."));
}
