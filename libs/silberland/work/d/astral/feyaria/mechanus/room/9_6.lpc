
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./6_4");
  AddExit ("suedosten" ,"./7_7");
  AddExit ("westen", "./5_5");

  AddDetail( ({"gang", "osten"}),
      "Eine sechseckige Tuer fuehrt nach Osten.");
  AddDetail( ({"pforte", "suedosten"}),
      "Eine siebeneckige Pforte fuehrt nach Suedosten.");
  AddDetail( ({"tunnel", "westen"}),
      "Ein fenfeckiger Tunnel fuehrt nach Westen.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: ein fuenfeckiger Tunnel fuehrt nach "
      "Westen, eine sechseckige Tuer nach Osten und eine siebeneckige Pforte "
      "nach Suedosten."));
}
