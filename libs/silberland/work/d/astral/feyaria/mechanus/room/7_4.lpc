
#include "../def.h"

inherit ROOM "7_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./3_2");
  AddExit ("suedosten" ,"./5_5");
  AddExit ("suedwesten", "./6_3");
  AddExit ("nordwesten", "./10_4");

  AddDetail( ({"spur", "spuren", "weg", "osten"}),
      "Der Weg fuehrt in drei Spuren nach Osten.");
  AddDetail( ({"verbindung", "suedosten"}),
      "Ein fuenfeckiger Tunnel fuehrt nach Suedosten.");
  AddDetail( ({"durchgang", "meter", "nordwesten"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Nordwesten.");
  AddDetail( ({"tuer", "suedwesten"}),
      "Es gibt eine sechsseckige Tuer hier, die nach Suedwesten fuehrt. ");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: eine dreispuriger Weg fuehrt nach "
      "Osten, ein fuenfeckiger Tunnel geht nach Suedosten, eine sechseckige "
      "Tuer fuehrt nach Suedwesten und ein 10 Meter breiter Durchgang nach "
      "Nordwesten."));
}
