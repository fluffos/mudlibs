
#include "../def.h"

inherit ROOM "8_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./8_3");
  AddExit ("nordosten" ,"./10_4");
  AddExit ("suedosten" ,"./6_3");
  AddExit ("suedwesten", "./9_5");

  AddDetail( ({"tuer", "suedosten"}),
      "Eine sechseckige Tuer fuehrt nach Suedosten.");
  AddDetail( ({"ausgang", "norden"}),
      "Ein achteckiger  Ausgang fuehrt nach Norden.");
  AddDetail( ({"gang", "suedwesten"}),
      "Der Gang nach Suedwesten ist neuneckig.");
  AddDetail( ({"durchgang", "meter", "nordosten"}),
      "Nach Nordosten fuehrt ein 10 Meter breiter Durchgang.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: eine sechseckige Tuer fuehrt "
      "nach Suedosten, ein achteckiger Ausgang geht nach Norden, ein "
      "neuneckiger Gang nach Suedwesten und ein 10 Meter breiter Durchgang "
      "nach Nordosten."));
}
