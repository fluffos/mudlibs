
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./10_2");
  AddExit ("suedwesten", "./8_4");

  AddDetail( ({"ausgang", "suedwesten"}),
      "Eine achteckiger Ausgang fuehrt nach Suedwesten.");
  AddDetail( ({"durchgang", "meter", "norden"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Norden.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: eine achteckiger Ausgang fuehrt "
      "nach Suedwesten und ein 10 Meter breiter Durchgang nach Norden."));
}
