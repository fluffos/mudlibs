
#include "../def.h"

inherit ROOM "mechanus_inh";

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "In einem sechseckigen Raum");
  SetProp(P_INT_LONG,
      "Du stehst in einem sechseckigen Raum, der wohl das Heim eines Hextons "
      "ist, denn er ist eindeutig der Zahl Sechs gewidmet. Daher gibt es hier "
      "auch sechs Waende und sechs Ecken. Die Waende sind ueber und ueber mit Zahlen "
      "bedeckt, die alle nur aus der Ziffer '6' bestehen.");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden"}),
      "Der Boden besteht aus kleinen Sechsecken.");
  AddDetail( ({"decke"}),
      "Die Decke besteht aus kleinen Sechsecken.");
  AddDetail( ({"wand", "waende"}), 
      "Auf den sechs Waenden stehen eine Menge Zahlen.");
  AddDetail( ({"ecken"}),
      "Die sechs Waende bilden sechs Ecken.");
  AddDetail( ({"ecke", "eck"}),
      "Es gibt sechs Ecken hier.");
  AddDetail( ({"ziffer"}),
      "Ueberall nur die Ziffer '6'.");
  AddDetail( ({"hexton", "heim"}),
      "Hier koenntest Du einen Hexton treffen, leider ist gerade keiner da.");
  AddDetail( ({"sechseck", "sechsecke"}),
      "Ueberall Sechsecke. Sie erinnern Dich an Bienenwaben.");
  AddDetail( ({"bienenwaben", "bienenwabe", "wabe", "waben"}),
      "Bienenwaben schauen genauso aus wie die Decke und der Boden hier. "
      "Trotzdem bist Du Dir sicher, dass es hier keine Bienen gibt.");
  AddDetail( ({"bienen", "biene"}),
      "Keine einzige Biene zu sehen, dafuer vielleicht ein Hexton.");
  AddSpecialDetail( ({"zahlen", "zahl"}), "det_zahl");
  AddDetail( ({"menge"}),
      "Das einzige, von dem es eine Menge in diesem Raum gibt, sind die Zahlen "
      "auf den Waenden.");
  AddDetail( ({"6"}),
      "Sechs.");
  AddDetail( ({"sechs"}),
      "6.");
  AddDetail( ({"66"}),
      "Sechsundsechzig.");
  AddDetail( ({"sechsundsechzig"}),
      "66.");
  AddDetail( ({"666"}),
      "Sechshundertsechsundsechzig.");
  AddDetail( ({"sechshundertsechsundsechzig"}),
      "666.");
  AddDetail( ({"6666"}),
      "Sechstausendsechshundertsechsundsechzig.");
  AddDetail( ({"sechstausendsechshundertsechsundsechzig"}),
      "6666.");
  AddDetail( ({"66666"}),
      "Sechsundsechzigtausendsechshundertsechsundsechzig.");
  AddDetail( ({"sechsundsechzigtausendsechshundertsechsundsechzig"}),
      "66666.");
  AddDetail( ({"666666"}),
      "Sechshundertsechsundsechzigtausendsechshundertsechsundsechzig.");
  AddDetail( ({"sechshundertsechsundsechzigtausendsechshundertsechsundsechzig"}),
      "666666.");
  AddDetail( ({"6666666"}),
      "Sechsmillionensechshundertsechsundsechzigtausendsechshundertsechsundsechzig.");
  AddDetail( ({"sechsmillionensechshundertsechsundsechzigtausendsechshundertsechsundsechzig"}),
      "6666666.");
  AddDetail( ({"66666666"}),
      "Sechsundsechzigmillionensechshundertsechsundsechzigtausendsechshundertsechsundsechzig.");
  AddDetail( ({"sechsundsechzigmillionensechshundertsechsundsechzigtausendsechshundertsechsundsechzig"}),
      "66666666.");
  AddDetail( ({"666666666"}),
      "Sechshundertsechsundsechzigmillionensechshundertsechsundsechzigtausendsechshundertsechsundsechzig.");
  AddDetail( ({"sechshundertsechsundsechzigmillionensechshundertsechsundsechzigtausendsechshundertsechsundsechzig"}),
      "666666666.");
  AddDetail( ({"6666666666"}),
      "Sechsmilliardensechshundertsechsundsechzigmillionensechshundertsechsundsechzigtausendsechshundertsechsundsechzig.");
  AddDetail( ({"sechsmilliardensechshundertsechsundsechzigmillionensechshundertsechsundsechzigtausendsechshundertsechsundsechzig"}),
      "6666666666.");
  AddDetail( ({"66666666666", "666666666666", "6666666666666", "6666666666666"}),
      "Vor lauter Sechsen wird Dir ganz schwindlig.");
        
}

string det_zahl()
{
  int i;
  string zahl;

  zahl = "";
  for(i=1+random(10); i>0; i--)
    zahl += "6";
  return "Auf der Wand sind jede Menge Zahlen, zb "+zahl+".\n";
}
