
#include "../def.h"

inherit ROOM "4_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./8_1");
  AddExit ("suedosten" ,"./7_1");
  AddExit ("suedwesten", "./9_2");

  AddDetail( ({"pforte", "suedosten"}),
      "Eine siebeneckige Pforte fuehrt nach Suedosten.");
  AddDetail( ({"ausgang", "nordosten"}),
      "Ein achteckiger Ausgang fuehrt nach Nordosten.");
  AddDetail( ({"gang", "suedwesten"}),
      "Der Gang nach Suedwesten ist neuneckig.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine siebeneckige Pforte fuehrt "
      "nach Suedosten, ein achteckiger Ausgang nach Nordosten und ein "
      "neuneckiger Gang nach Suedwesten."));
}

