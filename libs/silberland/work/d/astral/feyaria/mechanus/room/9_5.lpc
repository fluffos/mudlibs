
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./8_5");
  AddExit ("sueden", "./10_8");

  AddDetail( ({"verbindung", "nordosten"}),
      "Ein achteckiger Durchgang fuehrt nach Nordosten.");
  AddDetail( ({"durchgang", "meter", "sueden"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Sueden.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: ein achteckige Ausgang fuehrt "
      "nach Nordosten und ein 10 Meter breiter Durchgang nach Sueden."));
}
