
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./3_1");
  AddExit ("westen", "./8_1");

  AddDetail( ({"spur", "spuren", "weg", "osten"}),
      "Der Weg fuehrt in drei Spuren nach Osten.");
  AddDetail( ({"ausgang", "westen"}),
      "Ein achteckiger Ausgang fuehrt nach Westen.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: ein dreispuriger Weg fuehrt "
      "nach Osten und ein achteckiger Ausgang nach Westen."));
}
