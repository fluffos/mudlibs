
#include "../def.h"

inherit ROOM "9_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./8_8");
  AddExit ("westen", "./3_3");

  AddDetail( ({"spur", "spuren", "weg", "westen"}),
      "Der Weg fuehrt in drei Spuren nach Westen.");
  AddDetail( ({"ausgang", "osten"}),
      "Ein achteckiger Ausgang fuehrt nach Osten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: ein dreispuriger Weg fuehrt "
      "nach Westen und ein achteckiger Ausgang nach Osten."));
}
