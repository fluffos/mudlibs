
#include "../def.h"

inherit ROOM "7_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./6_3");
  AddExit ("nordosten" ,"./10_6");
  AddExit ("suedosten" ,"./6_5");
  AddExit ("suedwesten", "./4_3");

  AddDetail( ({"verbindung", "suedwesten"}),
      "Nach Suedwesten fuehrt eine viereckige Verbindung.");
  AddDetail( ({"durchgang", "meter", "nordosten"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Nordosten.");
  AddDetail( ({"tueren", "tuer", "suedosten", "suedwesten"}),
      "Es gibt zwei sechsseckige Tueren hier, eine nach Norden und "
      "die andere nach Suedosten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: eine viereckige Verbindung fuehrt "
      "nach Suedwesten, zwei sechseckige Tueren fuehren nach Norden und "
      "Suedosten und ein 10 Meter breiter Durchgang geht nach Nordosten."));
}
