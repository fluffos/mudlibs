
#include "../def.h"

inherit ROOM "7_inh";

void create() 
{
  ::create();

  AddExit ("norden", "./6_4");
  AddExit ("suedosten" ,"./4_4");
  AddExit ("suedwesten", "./6_6");
  AddExit ("nordwesten", "./9_6");

  AddDetail( ({"verbindung", "suedosten"}),
      "Nach Suedosten fuehrt eine viereckige Verbindung.");
  AddDetail( ({"gang", "nordwesten"}),
      "Der Gang nach Nordwesten ist neuneckig.");
  AddDetail( ({"tueren", "tuer", "norden", "suedwesten"}),
      "Es gibt zwei sechsseckige Tueren hier, eine nach Norden und "
      "die andere nach Suedwesten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: eine viereckige Verbindung fuehrt "
      "nach Suedosten, zwei sechseckige Tueren fuehren nach Norden und "
      "Suedwesten und eine neuneckiger Gang fuehrt nach Nordwesten."));
}
