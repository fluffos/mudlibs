
#include "../def.h"

inherit ROOM "6_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./7_4");
  AddExit ("osten" ,"./10_6");
  AddExit ("sueden", "./7_6");
  AddExit ("nordwesten", "./8_5");

  AddDetail( ({"pforte", "pforten", "nordosten", "sueden"}),
      "Zwei siebeneckige Pforten fuehren nach Nordosten und Sueden.");
  AddDetail( ({"ausgang", "nordwesten"}),
      "Ein achteckiger Ausgang fuehrt nach Nordwesten.");
  AddDetail( ({"durchgang", "meter", "osten"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Osten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: zwei siebeneckige Pforten "
      "fuehren nach Nordosten und Sueden, ein achteckiger Ausgang nach "
      "Nordwesten und ein 10 Meter breiter Durchgang nach Osten."));
}
