
#include "../def.h"

inherit ROOM "5_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./7_5");
  AddExit ("osten" ,"./9_6");
  AddExit ("westen", "./10_6");
  AddExit ("nordwesten", "./7_4");

  AddDetail( ({"pforte", "pforten", "nordosten", "nordwesten"}),
      "Zwei siebeneckige Pforten fuehren nach Nordosten und Nordwesten.");
  AddDetail( ({"gang", "osten"}),
      "Der Gang nach Osten ist neuneckig.");
  AddDetail( ({"meter", "durchgang", "westen"}),
      "Ein 10 Meter breiter Durchgang fuehrt nach Westen.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: zwei siebeneckige Pforten fuehren "
      "nach Nordwesten und Nordosten, ein neuneckiger Gang nach Osten und "
      "ein 10 Meter breiter Durchgang nach Westen."));
}
