
#include "../def.h"

inherit ROOM "10_inh";

void create() 
{
  ::create();

  AddExit ("osten" ,"./5_5");
  AddExit ("suedwesten", "./7_6");
  AddExit ("westen", "./6_3");

  AddDetail( ({"gang", "westen"}),
      "Eine sechseckige Tuer fuehrt nach Westen.");
  AddDetail( ({"pforte", "suedwesten"}),
      "Eine siebeneckige Pforte fuehrt nach Suedwesten.");
  AddDetail( ({"tunnel", "osten"}),
      "Ein fenfeckiger Tunnel fuehrt nach Osten.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: ein fuenfeckiger Tunnel fuehrt nach "
      "Osten, eine sechseckige Tuer nach Westen und eine siebeneckige Pforte "
      "nach Suedwesten."));
}
