
#include "../def.h"

inherit ROOM "10_inh";

void create() 
{
  ::create();

  AddExit ("sueden", "./6_6");
  AddExit ("westen", "./eingang");

  AddDetail( ({"gang", "sueden"}),
      "Eine sechseckige Tuer fuehrt nach Sueden.");
  AddDetail( ({"ausgang", "westen"}),
      "Ein normaler Ausgang fuehrt nach Westen.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt zwei sichtbare Ausgaenge: eine sechseckige Tuer fuehrt nach "
      "Sueden und durch einen normalen Ausgang kommt man nach Westen ."));
}
