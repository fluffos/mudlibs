
#include "../def.h"

inherit ROOM "4_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./7_6");
  AddExit ("suedosten" ,"./8_7");
  AddExit ("nordwesten", "./10_8");

  AddDetail( ({"pforte", "nordosten"}),
      "Eine siebeneckige Pforte fuehrt nach Nordosten.");
  AddDetail( ({"ausgang", "suedosten"}),
      "Ein achteckiger Ausgang fuehrt nach Suedosten.");
  AddDetail( ({"gang", "nordwesten", "meter"}),
      "Der Durchgang nach Nordwesten ist 10 Meter breit.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt drei sichtbare Ausgaenge: eine siebeneckige Pforte fuehrt "
      "nach Nordosten, ein achteckiger Ausgang nach Suedosten und ein "
      "10 Meter breiter Durchgang nach Nordwesten."));
}
