
#include "../def.h"

inherit ROOM "5_inh";

void create() 
{
  ::create();

  AddExit ("nordosten" ,"./8_2");
  AddExit ("suedosten" ,"./7_2");
  AddExit ("suedwesten", "./9_3");
  AddExit ("nordwesten", "./3_1");

  AddDetail( ({"spur", "spuren", "weg", "nordwesten"}),
      "Der Weg fuehrt in drei Spuren nach Nordwesten.");
  AddDetail( ({"pforte", "suedosten"}),
      "Eine siebeneckige Pforte fuehrt nach Suedosten.");
  AddDetail( ({"ausgang", "nordosten"}),
      "Ein achteckiger Ausgang fuehrt nach Nordosten.");
  AddDetail( ({"gang", "suedwesten"}),
      "Der Gang nach Suedwesten ist neuneckig.");
}

string GetExits()
{
  return bold_exits(BS(
      "Es gibt vier sichtbare Ausgaenge: ein dreispuriger Weg fuehrt "
      "nach Nordwesten, eine siebeneckige Pforte nach Suedosten, ein "
      "achteckiger Ausgang nach Nordosten und ein neuneckiger Gang nach "
      "Suedwesten."));
}
