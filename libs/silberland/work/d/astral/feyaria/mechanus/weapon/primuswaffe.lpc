// Primuswaffe
// 2.1.2004 Feyaria
// 24.05.2009 Angrox, Autoload debugged

#include "../def.h"

inherit "/std/weapon";

int nr = -1;

int generate_weapon();


void create()
{

  if( !is_clone(this_object()) ) return;
  ::create();

  generate_weapon();
  AddId( ({"\nprimuswaffe" }) );

  SetProp(P_QUALITY_DECAY, 1111);
  SetProp(P_VALUE, 11111);
  SetProp(P_MAGIC, 11);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_MATERIAL, ([MAT_MAGIC: 100]) );
  SetProp(P_HIT_FUNC, this_object());
  SetProp("waffenbalsam", 11);
  SetProp(P_ITEMD_TMPMAGIC, ({1500, 1500}) );
  SUID;
}

int generate_weapon() {
  if (nr == -1)
    nr = random(5);

  switch(nr)
  {
    case 0:
      SetProp(P_SHORT, "Ein Dolch der primaeren Macht");
      SetProp(P_NAME, "Primusdolch");
      SetProp(P_LONG,
          "Dieser lange, leicht gekruemmte Dolch pulsiert foermlich, so stark "
          "ist die Macht der Magie, die in diese Waffe gebunden wurde.");
      AddId( ({"primusdolch", "dolch"}) );
      SetProp(P_WEAPON_TYPE, WT_KNIFE);
      SetProp(P_WC, 145);
      SetProp(P_WC_FIX, 75);
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
      SetProp(P_NR_HANDS, 1);
      SetProp(P_WEIGHT, 500);
      SetProp(P_GENDER, MALE);
      break;

    case 1:
      SetProp(P_SHORT, "Ein Schwert der primaeren Macht");
      SetProp(P_NAME, "Primusschwert");
      SetProp(P_LONG,
          "Dieses lange, schmale Schwert pulsiert foermlich, so stark "
          "ist die Macht der Magie, die in diese Waffe gebunden wurde.");
      AddId( ({"primusschwert", "schwert"}) );
      SetProp(P_WEAPON_TYPE, WT_SWORD);
      SetProp(P_WC, 185);
      SetProp(P_WC_FIX, 65);
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
      SetProp(P_NR_HANDS, 1);
      SetProp(P_WEIGHT, 1000);
      SetProp(P_GENDER, NEUTER);
      break;
      
    case 2:
      SetProp(P_SHORT, "Eine Axt der primaeren Macht");
      SetProp(P_NAME, "Primusaxt");
      SetProp(P_LONG,
          "Diese Axt hat ein gezahntes Axtblatt und pulsiert foermlich, so stark "
          "ist die Macht der Magie, die in diese Waffe gebunden wurde.");
      AddId( ({"primusaxt", "axt"}) );
      SetProp(P_WEAPON_TYPE, WT_AXE);
      SetProp(P_WC, 265);
      SetProp(P_WC_FIX, 35);
      SetProp(P_DAM_TYPE, ({DT_SLASH, DT_RIP}) );
      SetProp(P_NR_HANDS, 2);
      SetProp(P_WEIGHT, 2000);
      SetProp(P_GENDER, FEMALE);
      break;

    case 3:
      SetProp(P_SHORT, "Ein Streithammer der primaeren Macht");
      SetProp(P_NAME, "Primusstreithammer");
      SetProp(P_LONG,
          "Dieser gewaltige Streithammer pulsiert auf Grund der "
	  "starken Macht, die in ihm gebunden ist. Sein Griff ist "
	  "mit Draht umwickelt, ueber den staendig Blitze zucken und "
	  "sein Kopf hat an einem Ende eine Spitze und am anderen den "
	  "ueblichen Hammerkopf.");
      AddId( ({"primushammer", "streithammer", "hammer"}) );
      SetProp(P_WEAPON_TYPE, WT_CLUB);
      SetProp(P_WC, 265);
      SetProp(P_WC_FIX, 35);
      SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
      SetProp(P_NR_HANDS, 2);
      SetProp(P_WEIGHT, 2000);
      SetProp(P_GENDER, MALE);
      break;

    case 4: // Deaktiviert
      SetProp(P_SHORT, "Ein Bogen der primaeren Macht");
      SetProp(P_NAME, "Primusbogen");
      SetProp(P_LONG,
          "Dieser Bogen pulsiert aufgrund der starken Macht, die in ihm gebunden ist. Die "
          "sehne besteht aus festem Draht ueber den immer wieder Blitze aus purer Kraft "
          "zischen.");
      AddId( ({"primusbogen", "bogen"}) );
      SetProp(P_WEAPON_TYPE, WT_BOW);
      SetProp(P_WC, 265);
      SetProp(P_WC_FIX, 35);
      SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
      SetProp(P_NR_HANDS, 2);
      SetProp(P_WEIGHT, 2000);
      SetProp(P_GENDER, MALE);
      break;
  }
  return 1;
}

int HitFunc(object enemy)
{
  object ob;

  if( !random(111) )
    if(ob = present("\nprimalpower", QueryProp(P_WIELDED)) )
      ob->new_timer();
    else
      clone_object(OBJ "primalpower")->move(QueryProp(P_WIELDED), M_NOCHECK);
  return random(11) + random(11) * random(11) * random(11) / 2;
}

void reset()
{
  object wer;
  if (!is_clone(this_object())) return;
  ::reset();

  if (objectp(wer = QueryProp(P_WIELDED)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die primaere Energie von " + name(WEM) + " heilt Dich.\n");
    wer->heal_self(111);
  }
}

void _set_autoloadobj(mixed data)
{     
  nr = data[0];
  generate_weapon();
  SetProp(P_ITEMD_TMPMAGIC, data[1]);
  SetProp(P_NODROP, 1);
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

mixed _query_autoloadobj()
{   
  return ([0: nr, 1: QueryProp(P_ITEMD_TMPMAGIC)]);
}

