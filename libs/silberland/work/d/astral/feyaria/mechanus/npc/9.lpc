// Nonaton in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Nonaton");
  SetProp(P_LONG, 
    "Der Nonaton ist ein seltsames Wesen, das aus einem neuneckigen Rumpf "
    "besteht. Einen Kopf oder irgendwelche Koerperoeffnungen kannst Du "
    "nicht erknnen. In jeder Ecke befindet sich ein Arm bzw ein Bein, den "
    "Unterschied kann man nicht wirklich erkennen, da der Nonaton ziemlich "
    "symmetrisch ist.");
  SetProp(P_NAME, "Nonaton");
  SetProp(P_GENDER, MALE);
  AddId(({"nonaton", "9"}));
  SetProp(P_MECHANUS_NR, 9);

  create_default_npc(33);
  SetProp(P_HANDS, ({" mit neun Armen", 330, ({DT_BLUDGEON}) }));
  SetProp(P_SIZE, 190);
  SetProp(P_MAX_HANDS, 9);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_POISON: 0.5, DT_WATER: -1, DT_LIGHT: -1, DT_AIR: -1])); 

  SetProp(P_SPELLRATE, 45);
  AddSpell(4, 550,
    Name(WER,1)+" trifft Dich mit allen 9 Armen gleichzeitig.\n",
    Name(WER,1)+" trifft @WEN mit allen 9 Armen gleichzeitig.\n",
     ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 450, DS_ANTIMAGIC);

}
