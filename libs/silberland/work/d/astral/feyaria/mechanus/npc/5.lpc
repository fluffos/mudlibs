// Quinton in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Quinton");
  SetProp(P_LONG, 
    "Der Quinton ist ein seltsames Wesen, das aus einem fuenfeckigen Rumpf "
    "besteht. Einen Kopf oder irgendwelche Koerperoeffnungen kannst Du "
    "nicht erknnen. In jeder Ecke befindet sich ein Arm bzw ein Bein, den "
    "Unterschied kann man nicht wirklich erkennen, da der Quinton ziemlich "
    "symmetrisch ist."); 
  SetProp(P_NAME, "Quinton");
  SetProp(P_GENDER, MALE);
  AddId(({"quinton", "5"}));
  SetProp(P_MECHANUS_NR, 5);

  create_default_npc(41);
  SetProp(P_HANDS, ({" mit fuenf Armen", 410, ({DT_BLUDGEON}) }));
  SetProp(P_SIZE, 555);
  SetProp(P_MAX_HANDS, 5);
  SetProp(P_NOMAGIC, 30);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_EXPLOSION: 0.5, DT_AIR: -1, DT_POISON: -1, DT_COLD: -1])); 

  SetProp(P_SPELLRATE, 65);
  AddSpell(4, 750,
    Name(WER,1)+" trifft Dich mit allen 5 Armen gleichzeitig.\n",
    Name(WER,1)+" trifft @WEN mit allen 5 Armen gleichzeitig.\n",
     ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 600, DS_SLOW);
  AddDefaultSpell(1, 500, DS_REDUCE_WC);

}
