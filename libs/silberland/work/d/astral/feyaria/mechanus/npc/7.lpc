// Septon in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Septon");
  SetProp(P_LONG, 
    "Der Septon ist ein seltsames Wesen, das aus einem siebeneckigen Rumpf "
    "besteht. Einen Kopf oder irgendwelche Koerperoeffnungen kannst Du "
    "nicht erknnen. In jeder Ecke befindet sich ein Arm bzw ein Bein, den "
    "Unterschied kann man nicht wirklich erkennen, da der Septon ziemlich "
    "symmetrisch ist.");
  SetProp(P_NAME, "Septon");
  SetProp(P_GENDER, MALE);
  AddId(({"septon", "7"}));
  SetProp(P_MECHANUS_NR, 7);

  create_default_npc(37);
  SetProp(P_HANDS, ({" mit sieben Armen", 370, ({DT_BLUDGEON}) }));
  SetProp(P_SIZE, 370);
  SetProp(P_MAX_HANDS, 7);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_ACID: 0.5, DT_ELECTRIC: -1, DT_WATER: -1, DT_LIGHTNING: -1])); 

  SetProp(P_SPELLRATE, 55);
  AddSpell(4, 650,
    Name(WER,1)+" trifft Dich mit allen 7 Armen gleichzeitig.\n",
    Name(WER,1)+" trifft @WEN mit allen 7 Armen gleichzeitig.\n",
     ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 550, DS_FROG);
  AddDefaultSpell(2, 450, DS_REDUCE_AC);

}
