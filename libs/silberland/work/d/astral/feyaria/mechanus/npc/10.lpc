// Decaton in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Decaton");
  SetProp(P_LONG, 
    "Der Decaton ist ein seltsames Wesen, das aus einem zehneckigen Rumpf "
    "besteht. Einen Kopf oder irgendwelche Koerperoeffnungen kannst Du "
    "nicht erkennen. In jeder Ecke befindet sich ein Arm bzw ein Bein, einen "
    "Unterschied kann man nicht wirklich feststellen, da der Decaton ziemlich "
    "symmetrisch ist.");
  SetProp(P_NAME, "Decaton");
  SetProp(P_GENDER, MALE);
  AddId(({"decaton", "10"}));
  SetProp(P_MECHANUS_NR, 10);

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit zehn Armen", 300, ({DT_BLUDGEON}) }));
  SetProp(P_SIZE, 100);
  SetProp(P_MAX_HANDS, 10);
  SetProp(P_NOMAGIC, 5);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_AIR: 0.5, DT_ELECTRIC: -1, DT_COLD: -1, DT_LIGHTNING: -1])); 

  SetProp(P_SPELLRATE, 40);
  AddSpell(4, 500,
    Name(WER,1)+" trifft Dich mit allen 10 Armen gleichzeitig.\n",
    Name(WER,1)+" trifft @WEN mit allen 10 Armen gleichzeitig.\n",
     ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 400, DS_DEAF);

}
