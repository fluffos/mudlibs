// Tertian in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Tertian");
  SetProp(P_LONG, 
    "Der Tertian ist ein seltsames Wesen, das aus einem dreieckigen Rumpf "
    "besteht. Einen Kopf oder irgendwelche Koerperoeffnungen kannst Du "
    "nicht erknnen. In jeder Ecke befindet sich ein Arm bzw ein Bein, den "
    "Unterschied kann man nicht wirklich erkennen, da der Tertian ziemlich "
    "symmetrisch ist.");
  SetProp(P_NAME, "Tertian");
  SetProp(P_GENDER, MALE);
  AddId(({"tertian", "3"}));
  SetProp(P_MECHANUS_NR, 3);

  create_default_npc(47);
  SetProp(P_HANDS, ({" mit drei Armen", 473, ({DT_BLUDGEON}) }));
  SetProp(P_SIZE, 633);
  SetProp(P_MAX_HANDS, 3);
  SetProp(P_NOMAGIC, 50);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_LIGHTNING: 0.5, DT_FIRE: -1, DT_EXPLOSION: -1, DT_LIGHT: -1,
        DT_SLASH:    -0.3, DT_RIP:    -0.2, DT_PIERCE:    -0.2, 
        DT_BLUDGEON: -0.3, DT_WHIP:   -0.2, DT_SQUEEZE:   -0.2,]) );

  SetProp(P_SPELLRATE, 75);
  AddSpell(4, 900,
    Name(WER,1)+" trifft Dich mit allen 3 Armen gleichzeitig.\n",
    Name(WER,1)+" trifft @WEN mit allen 3 Armen gleichzeitig.\n",
     ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 750, DS_BLIND);
  AddDefaultSpell(1, 650, DS_MASS_DAMAGE,
      "Der Tertian explodiert.\n",
      "Der Tertian explodiert.\n",
      DT_EXPLOSION);

}
