// Secundus in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Secundus");
  SetProp(P_LONG, 
    "Der Secundus ist ein seltsames Wesen, das aus einem zweieckigen Rumpf "
    "besteht. Einen Kopf oder irgendwelche Koerperoeffnungen kannst Du "
    "nicht erknnen. In jeder Ecke befindet sich ein Arm bzw ein Bein, den "
    "Unterschied kann man nicht wirklich erkennen, da der Secundus ziemlich "
    "symmetrisch ist.");
  SetProp(P_NAME, "Secundus");
  SetProp(P_GENDER, MALE);
  AddId(({"secundus", "2"}));
  SetProp(P_MECHANUS_NR, 2);

  create_default_npc(50);
  SetProp(P_HANDS, ({" mit zwei Armen", 522, ({DT_BLUDGEON}) }));
  SetProp(P_SIZE, 722);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 60);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_LIGHT: 0.5, DT_AIR: -1, DT_ACID: -1, DT_LIGHTNING: -1, 
        DT_SLASH:    -0.4, DT_RIP:    -0.3, DT_PIERCE:    -0.3, 
        DT_BLUDGEON: -0.4, DT_WHIP:   -0.3, DT_SQUEEZE:   -0.3,]) );

  SetProp(P_SPELLRATE, 80);
  AddSpell(4, 1000,
    Name(WER,1)+" trifft Dich mit beiden Armen gleichzeitig.\n",
    Name(WER,1)+" trifft @WEN mit beiden Armen gleichzeitig.\n",
     ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 800, DS_BLIND);
  AddDefaultSpell(1, 700, DS_MASS_POISON);

}
