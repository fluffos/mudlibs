// std-npc fuer die Mechanus
// 30-12-2003  Feyaria@SilberLand

#include "../def.h"

inherit STDNPC;
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"\nmechanus_npc"}) );
  SetProp(P_RACE, "Zahlenwesen");
  SetProp(P_ALIGN, 0);
  SetProp(P_HP_DELAY, 0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "materialisiert sich aus dem Zahlenkontinuum");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "materialisiert sich aus dem Zahlenkontinuum");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_DIE_MSG,  " verschmilzt wieder mit dem Zahlenkontinuum.\n");
  SetProp(P_KILL_MSG, "Die Macht der Zahlen war wieder einmal staerker!");
  SetProp(P_REJECT, ({REJECT_DROP, ""}) );
  SetProp(P_LOG_INFO, "feyaria/mechanus");
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:    -0.2, DT_RIP:    -0.1, DT_PIERCE:    -0.1, 
        DT_BLUDGEON: -0.2, DT_WHIP:   -0.1, DT_SQUEEZE:   -0.2,
        DT_HOLY:     -0.5, DT_UNHOLY: -0.5, DT_MAGIC:     -0.5,
        DT_SOUND:    -1.0, DT_MIND:   -1.0, DT_TERROR:    -1.0,
        ])); 

  AddInfo(DEFAULT_INFO, "bleibt stumm.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

void reset()
{
  object ob, next;

  if( !is_clone(TO) ) return;
  ::reset();

  if(MENV)
    MENV->Message(Name(WER,1)+" verschmilzt wieder mit dem "
        "Zahlenkontinuum.\n", MSGFLAG_VISUAL);
  remove();
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  if (killer && QueryProp(P_LEVEL) > 30)
    write_file( LOG "npckills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "mechanus", QueryProp(P_LEVEL));
  MECHANUSMASTER->DeadNpc(this_object());
  ::die(poisondeath);
}

varargs int remove(int silent)
{
  MECHANUSMASTER->RemoveNpc(this_object());
  return ::remove(silent);
}

int _query_frog() { return 0; }

int _query_wimpy() { return 0; }

int _query_poison() { return 0; }

int _query_align() { return 0; }
