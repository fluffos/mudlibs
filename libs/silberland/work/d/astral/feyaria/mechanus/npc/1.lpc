// Primus in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Primus, der Herr der Zahlen");
  SetProp(P_LONG, 
    "Primus, der Herr der Zahlen, ist eine majestaetische Erscheinung. Er "
    "ist so einzigartig, dass Du ihn mit nichts anderem vergleichen kannst, "
    "das Du bisher gesehen hast. Du kannst nicht einmal genau beschreiben, "
    "wie er aussieht, denn dazu fehlen einfach die passenden Worte. "
    "Allerdings stellt er die Einzigartigkeit der Eins sehr gut dar.");
  SetProp(P_NAME, "Primus");
  SetProp(P_ARTICLE, 0);
  SetProp(P_KILL_NAME, "Primus, der Herr der Zahlen");
  SetProp(P_GENDER, MALE);
  AddId(({"primus", "NOFALLDOWN", "1"}));
  SetProp(P_MECHANUS_NR, 1);
  SetProp(P_MURDER_MSG, "Ich bin doch einzigartig! Wie konnte %s mich "
      "dann besiegen?");

  create_default_npc(60,11111);
  SetProp(P_HANDS, ({" mit primaerer Macht", 1111, ({DT_MAGIC, DT_BLUDGEON}) }));
  SetProp(P_SIZE, 1111);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_NOMAGIC, 75);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_ELECTRIC:  0.5, DT_LIGHT:  -1,   DT_COLD: -1,    DT_EXPLOSION: -1,
        DT_FIRE:     -0.3, DT_WATER:  -0.3, DT_AIR: -0.3,
        DT_POISON:   -0.3, DT_ACID:   -0.3, DT_LIGHTNING: -0.3,
        DT_SLASH:    -0.5, DT_RIP:    -0.4, DT_PIERCE:    -0.4, 
        DT_BLUDGEON: -0.5, DT_WHIP:   -0.4, DT_SQUEEZE:   -0.4,]) );

  SetProp(P_SPELLRATE, 100);
  AddDefaultSpell(1, 1111, DS_REDUCE_WC);
  AddDefaultSpell(1, 1111, DS_REDUCE_AC);
  AddDefaultSpell(1, 500, DS_PARALYZE);
  AddDefaultSpell(1, 900, DS_POISON);
  AddDefaultSpell(2, 800, DS_MASS_BLIND);
  AddDefaultSpell(2, 800, DS_MASS_DAMAGE,
      "Primus laesst Dich von innen heraus explodieren.\n",
      "Primus laesst Dich von innen heraus explodieren.\n",
      DT_EXPLOSION);
  AddSpell(1, 1800, 
      "Primus trifft Dich mit einzigartiger Macht.\n",
      "Primus trifft @WEN mit einzigartiger Macht.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
}

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  if (!interactive(enemy))
    dam /= 2;
  if(dam > 1111) dam = 1111;
  return ::Defend(dam, dtype, spell, enemy);
}

void Attack(object enemy)
{
  object *enemies;
  if (!query_once_interactive(enemy) && 
      sizeof(enemies = filter_array(PresentEnemies(), #'interactive)))
    enemy = enemies[random(sizeof(enemies))];

  ::Attack(enemy);
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  ASTRALMASTER->AddFlag(killer, FLAG_PRIMUS, filter_array(PresentEnemies(), #'interactive));
  ASTRALMASTER->SetTime("mechanus");
  write_file( LOG "primus.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  ::die(poisondeath);
}

int _query_disable_attack() { return 0; }
int _query_disable_spells() { return 0; }
mixed _query_skill_attr() { return 0; }
int _query_poison() { return 0; }
int _query_frog() { return 0; }
int _query_blind() { return 0; }

