// Quarton in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Quarton");
  SetProp(P_LONG, 
    "Der Quarton ist ein seltsames Wesen, das aus einem viereckigen Rumpf "
    "besteht. Einen Kopf oder irgendwelche Koerperoeffnungen kannst Du "
    "nicht erknnen. In jeder Ecke befindet sich ein Arm bzw ein Bein, den "
    "Unterschied kann man nicht wirklich erkennen, da der Quarton ziemlich "
    "symmetrisch ist.");
  SetProp(P_NAME, "Quarton");
  SetProp(P_GENDER, MALE);
  AddId(({"quarton", "4"}));
  SetProp(P_MECHANUS_NR, 4);

  create_default_npc(44);
  SetProp(P_HANDS, ({" mit vier Armen", 444, ({DT_BLUDGEON}) }));
  SetProp(P_SIZE, 444);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_NOMAGIC, 40);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_FIRE: 0.5, DT_WATER: -1, DT_EXPLOSION: -1, DT_ELECTRIC: -1])); 

  SetProp(P_SPELLRATE, 70);
  AddSpell(4, 800,
    Name(WER,1)+" trifft Dich mit allen 4 Armen gleichzeitig.\n",
    Name(WER,1)+" trifft @WEN mit allen 4 Armen gleichzeitig.\n",
     ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 650, DS_DISARM);
  AddDefaultSpell(1, 550, DS_PARALYZE);

}
