// Octon in Mechanus
// 04-01-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_mechanus_npc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Octon");
  SetProp(P_LONG, 
    "Der Octon ist ein seltsames Wesen, das aus einem achteckigen Rumpf "
    "besteht. Einen Kopf oder irgendwelche Koerperoeffnungen kannst Du "
    "nicht erknnen. In jeder Ecke befindet sich ein Arm bzw ein Bein, den "
    "Unterschied kann man nicht wirklich erkennen, da der Octon ziemlich "
    "symmetrisch ist.");
  SetProp(P_NAME, "Octon");
  SetProp(P_GENDER, MALE);
  AddId(({"octon", "8"}));
  SetProp(P_MECHANUS_NR, 8);

  create_default_npc(35);
  SetProp(P_HANDS, ({" mit acht Armen", 350, ({DT_BLUDGEON}) }));
  SetProp(P_SIZE, 280);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_NOMAGIC, 15);
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) +
      ([DT_WATER: 0.5, DT_FIRE: -1, DT_POISON: -1, DT_ACID: -1])); 

  SetProp(P_SPELLRATE, 50);
  AddSpell(4, 600,
    Name(WER,1)+" trifft Dich mit allen 8 Armen gleichzeitig.\n",
    Name(WER,1)+" trifft @WEN mit allen 8 Armen gleichzeitig.\n",
     ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 500, DS_POISON);

}
