// Objekt fuer hitfunc von primuswaffe
// 2.1.2004 Feyaria

#include "../def.h"

inherit "std/thing";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_NAME, "Primaere Macht");
  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddId( ({"\nprimalpower"}) );
}

void init()
{
  int time;
  ::init();

  if( !MENV || !interactive(MENV) || present("\nprimalpower 2", MENV) )
  {
    call_out("remove", 0, 1);
    return;
  }
  SetProp(P_X_ATTR_MOD, ([A_STR: random(6), A_DEX: random(6),
                          A_INT: random(6), A_CON: random(6)]) );
  SetProp(P_X_HEALTH_MOD, ([P_HP: random(20), P_SP: random(20)]) );
  SetProp(P_X_MAX_HEALTH_MOD, ([P_HP: 5 + random(5), P_SP: 5 + random(5)]) );
  MENV->UpdateAttributes();
  time = (3 + random(6)) * 60;
  MENV->ModifySkillAttribute(MENV, SA_QUALITY, 111, time);
  call_out("remove", time);
  tell_object(MENV, 
      "Die primaere Macht erfuellt Dich!\n");
}

int remove(int silent)
{
  if( environment() && query_once_interactive(environment()) )
  {
    SetProp(P_X_ATTR_MOD, 0);
    SetProp(P_X_HEALTH_MOD, 0);
    environment()->UpdateAttributes();
    if(!silent)
      tell_object(environment(), 
          "Die primaere Macht verlaesst Dich!\n");
  }
  return ::remove(silent);
}

void new_timer()
{
  int time;

  time = find_call_out("remove") + (2 + random(4)) * 6;
  while(remove_call_out("remove") != -1) ;
  MENV->ModifySkillAttribute(MENV, SA_QUALITY, 111, time);
  call_out("remove", time);
}

void reset()
{
  if( !is_clone(TO) ) return;
  ::reset();
  remove();
}
