// Wasserkristall fuer Eingang zum Palast
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Kristall des Meeres");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Der Kristall des Meeres");
  SetProp(P_LONG,
      "Der Kristall des Meeres ist ein maechtiges Artefakt und besteht "
      "aus festem Wasser. Wofuer mag er wohl gut sein?");
  AddId( ({"kristall", "meerkristall", "kristall meeres",
        "kristall des meeres", "\nwasserpalastkey1"}) );
  SetProp(P_INFO, BS(
      "Der Kristall des Meeres wird fuer den Zugang zum Palast des "
      "Wassers benoetigt. Allerdings brauchst man dazu noch "
      "die Essenz des Ozeans und das Symbol des Wasser. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Wassers oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_WATER);
  SetProp(P_MAGIC, 1);

  AddCmd("oeffne", "cmd_oeffnen");
}

int cmd_oeffnen(string str)
{
  object ob1, ob2;

  if (objectp(ob1 = present("\nwasserpalastkey2")) && 
      objectp(ob2 = present("\nwasserpalastkey3")) && 
      ENV(TP) && strstr(file_name(ENV(TP)), "aquatika/room/wasserraum") != -1)
  {
    if(member( ({"zugang", "zugang zum palast", "zugang zum palast wassers"}), 
          str) != -1)
    {
      if (ASTRALMASTER->QueryTime("aquatika") > 0)
      {
        write(BS("Du versuchst, den Zugang zum Palast des Wassers zu oeffnen, "
              "aber irgendwie funkioniert das nicht. Scheinbar ist der Marid "
              "Padisha nicht in seinem Palast."));
        return -1;
      }
      call_other(ROOM "palast1", "???");
      if (sizeof(find_object(ROOM "palast1")->QueryProp(P_EXITS)) > 1)
      {
        write("Der Palast wurde bereits betreten!\n");
        return -1;
      }
      write(BS("Du haeltst das Symbol des Wasser in die Hoehe, sodass es in "
            "Augenhoehe vor Dir schwebt. Dannn nimmst Du den Kristall des "
            "Meeres und die Essenz des Ozeans in die ausgestreckten Arme und "
            "laesst Deine Magie fliessen."));
      say(BS(TPN + " haelt das Symbol des Wasser in die Hoehe, sodass es in "
            "Augenhoehe vor " + TP->QueryPronoun(WEM) + " schwebt. Dannn nimmt "+
            TP->QueryPronoun(WER) + " den Kristall des Meeres und die Essenz des "
            "Ozeans in die ausgestreckten Arme und laesst " +
            TP->QPP(FEMALE, WEN, SINGULAR)+ " Magie fliessen."));
      tell_room(ENV(TP),"\nDas Portal zum Palast des Wassers oeffnet sich.\n\n");
      find_object(ROOM "palast1")->AddExit("raus", file_name(ENV(TP)));
      CLONE(OBJ "portal", ENV(TP));
      ob1->remove();
      ob2->remove();
      TP->AddSp(-400);
      call_out("remove", 0);
      return 1;
    }
    notify_fail("Willst Du vielleicht den Zugang zum Palast des Wassers oeffnen?\n");
    return 0;
  }
}
