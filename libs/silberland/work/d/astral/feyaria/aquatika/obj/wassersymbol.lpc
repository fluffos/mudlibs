// Wassersymbol fuer Eingang zum Palast
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Symbol des Wassers");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Das Symbol des Wassers");
  SetProp(P_LONG,
      "Das Symbol des Wassers ist ein maechtiges Artefakt und besteht "
      "voellig aus Wasser. Wofuer mag es wohl gut sein?");
  AddId( ({"symbol", "wassersymbol", "symbol wassers", 
        "symbol des wassers", "\nwasserpalastkey3"}) );
  SetProp(P_INFO, BS(
      "Das Symbol des Wassers wird fuer den Zugang zum Palast des "
      "Wassers benoetigt. Allerdings brauchst man dazu noch den "
      "Kristall des Meeres und die Essenz des Ozeans. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Wassers oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_WATER);
  SetProp(P_MAGIC, 1);
}

