// Wasseressenz fuer Eingang zum Palast
// 21.4.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Essenz des Ozeans");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Die Essenz des Ozeans");
  SetProp(P_LONG,
      "Die Essenz des Ozeans ist ein maechtiges Artefakt und besteht aus "
      "purem Wasser. Wofuer mag sie wohl gut sein?"); 
  AddId( ({"essenz", "ozeanessenz", "essenz ozeans",
        "essenz des ozeans", "\nwasserpalastkey2"}) );
  SetProp(P_INFO, BS(
      "Die Essenz des Ozeans wird fuer den Zugang zum Palast des "
      "Wassers benoetigt. Allerdings brauchst man dazu noch "
      "das Symbol des Wasser und den Kristall des Meeres. Nur mit allen "
      "drei Teilen kann man den Zugang zum Palast des Wassers oeffnen."));

  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_WATER);
  SetProp(P_MAGIC, 1);
}

