// std-leiche fuer djinnistan
// 10-03-2004  Feyaria@SilberLand

inherit "std/corpse";

#include "../def.h"

void create()
{
  object killer;
  object ob;
  int level;

  if (!is_clone(TO)) return;
  ::create();

  SUID;
  if (!PO || PO->QueryProp("got_loot"))
    return;

  level = PO->QueryProp(P_LEVEL);
  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object(1);
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "aquatika", level);

  PO->SetProp("got_loot", 1);
  if (strstr(file_name(PO), "padisha") != -1)
  {
    if (objectp(killer))
    {
      ASTRALMASTER->AddFlag(killer, FLAG_PADISHA, 
          filter_array(PO->PresentEnemies(), #'interactive));
      write_file( LOG "padisha.kills",
          dtime(time())+": "+CAP(getuid(killer))+" toetet "+PO->name(WEN)+".\n");
    }
    ob = clone_object( MARID_EQUIP );
    ob->set_padisha();
    ob->move(PO, M_NOCHECK);
    BOSS_LOOT;
    ASTRALMASTER->SetTime("aquatika");
  }
  else if ((strstr(file_name(PO), MARID) != -1 && !random(MARID_CHANCE)) )
    CLONELOG( MARID_EQUIP, PO)
  else if (!random(HOSE_CHANCE) ||
      (level >= 40 && !random(RARE_HOSE_CHANCE)))
    CLONELOG( ARMOUR "wasserhose", PO)
  else if (level >= 35 && !random(WATERDAGGER_CHANCE))
    CLONELOG( WEAPON "wellenbeisser", PO)
  else if (!random(KEY_CHANCE - level * level / 50))
    CLONELOG( OBJ + ({"wasseressenz", "wasserkristall", "wassersymbol"})[random(3)], PO)
  else if (!random(SALBE_CHANCE))
    CLONELOG( OBJ "wassersalbe", PO)
  else if (!random(WSALBE_CHANCE))
    CLONELOG( WSALBE, PO )
  else if (!random(RSALBE_CHANCE))
    CLONELOG( RSALBE, PO )
  MAGIC_WANDS
  else if (random(2))
  {
    object geld;
    geld = clone_object("/obj/money");
    geld->AddAmount(level + random(level * MONEY_FACTOR));
    geld->move(PO, M_NOCHECK);
  }
  else
  {
    geld = clone_object(WASSERFRAGMENT);
    geld->AddAmount(random(3 * level / 2));
    geld->move(PO, M_NOCHECK);
  }
}
