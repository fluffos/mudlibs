// eine Sturmriese
// 01-04-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_wasser_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Krake");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Krake");
  SetProp(P_LONG, 
    "Ein grosser Krake. Er hat acht lange Fangarme mit vielen Saugnaepfen "
    "und ein gefaehrliches Maul. Seine warzige, graue Haut schaut sehr "
    "zaeh und widerstandsfaehig aus. Sicher ist er ein gefaehrlicher Gegner.");
  AddId(({"krake", "NOWIMPY"}));

  create_default_npc(30);
  SetProp(P_HANDS, 
      ({" mit acht Fangarmen", QueryProp(P_HANDS)[1], DT_BLUDGEON }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Fisch");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:0.1,   DT_BLUDGEON: 0.1, DT_RIP: 0.1, DT_POISON: -1,
        DT_WATER:-1, DT_FIRE:0.3, DT_LIGHTNING:0.3, DT_MAGIC:-0.3])); 

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "schwimmt weg");
  SetProp(P_MNPC_WAIT, ({ 20, 20, 20 }));

  SetProp(P_DIE_MSG,  " streckt alle acht Fangarme von sich und stirbt.\n");
  SetProp(P_KILL_MSG, "schlingt alle acht Fangarme umd die Leiche.");
  SetProp(P_MURDER_MSG, "Wie konntest Du nur meinen acht Fangarmen entkommen, %s?");
  SetProp( P_MSG_FLAGS, ([P_KILL_MSG:1]) );
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
        "Der Krake frisst @WEN auf."}) );
  AddInfo(DEFAULT_INFO, "blubbert vor sich hin.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(5, 600,
      "Der Krake beisst Dich.\n",
      "Der Krake beisst @WEN.\n",
      ({DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 700,
      "Der Krake wuergt Dich mit seinen Fangarmen.\n",
      "Der Krake wuergt @WEN mit seinen Fangarmen.\n",
      ({DT_SQUEEZE}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 300, DS_POISON,
      "Der Krake spritzt Dir Tintenfluessigkeit in den Mund.\n",
      "Der Krake spritzt @WEM Tintenfluessigkeit in den Mund.\n", 1);
  AddDefaultSpell(1, 300, DS_BLIND,
      "Der Krake spritzt Dir Tintenfluessigkeit in die Augen.\n",
      "Der Krake spritzt @WEM Tintenfluessigkeit in die Augen.\n", 4);
      
  SUID;

  PEARLMASTER->DistributePearl(2, 4, 1, 1);
}

