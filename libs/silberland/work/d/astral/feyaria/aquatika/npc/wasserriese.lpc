// eine Sturmriese
// 01-04-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_wasser_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Wasserriese");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein gewaltiger Wasserriese");
  SetProp(P_LONG, 
    "Diese gewaltige Gestalt kann nur einer der legendaeren Wasserriesen sein. "
    "Schon seine saeulenartigen Beine ueberragen Dich haushoch. Er hat "
    "flossenartige Haende und Fuesse, die etwas dunkelblauer sind als seine "
    "blassblaue Haut. Seine langen gruenen Haare sehen aus wie Algen. Der "
    "Wasserriese ist wirklich dafuer geschaffen, in dieser Wasserwelt zu "
    "leben.");
  AddId(({"riese", "wasserriese"}));

  create_default_npc(45);
  SetProp(P_HANDS, 
      ({" mit der Kraft des Wassers", 400, ({DT_WATER, DT_BLUDGEON}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_BODY, QueryProp(P_BODY) * 2);
  SetProp(P_RACE, "Riese");
  SetProp(P_SIZE, 1500);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:-0.15,   DT_BLUDGEON: -0.3, DT_RIP: -0.1, DT_PIERCE: -0.05,
        DT_WATER:-1, DT_FIRE:0.3, DT_LIGHTNING:0.3, DT_MAGIC:-0.3])); 

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "schwimmt weg");
  SetProp(P_MNPC_WAIT, ({ 60, 60, 60 }));

  SetProp(P_DIE_MSG,  " faellt tot um.\n"
      "Die Erschuetterung laesst Dich erzittern.\n");
  SetProp(P_KILL_MSG, "Niemand kann die Macht des Wassers besiegen!");
  SetProp(P_MURDER_MSG, "Wie konntest Du gegen die Macht des Wassers siegen, %s?");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
        "Der Wasserriese trinkt @WEN."}) );
  AddInfo(DEFAULT_INFO, "spricht mit donnernder Stimme.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(5, 1200,
      Name(WER,1)+" trifft Dich hammerhart.\n",
      Name(WER,1)+" trifft @WEN hammerhart.\n",
      ({DT_WATER, DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 800, 
      Name(WER,1) + " bringt Dich fast zum Ertrinken.\n",
      Name(WER,1) + " bringt @WEN fast zum Ertrinken.\n",
      ({DT_WATER}),([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 500, DS_PARALYZE,
      Name(WER,1)+ " schlaegt Dich bewusstlos.\n",
      Name(WER,1)+ " schlaegt @WEN bewusstlos.\n",2);
      
  SetChats(1, ({
    "Der Wasserriese tritt beinahe auf Dich drauf.\n",
    "Du bestaunst die gewaltige Groesse des Wasserriesen.\n"}) );

  SUID;

  PEARLMASTER->DistributePearl(3, 7, 1, 1);

}

