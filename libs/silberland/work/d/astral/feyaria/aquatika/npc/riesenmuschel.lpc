// eine Sturmriese
// 01-04-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_wasser_npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Riesenmuschel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, "Eine Riesenmuschel");
  SetProp(P_LONG, 
    "Diese Muschel ist wirklich ein riesiges Exemplar. Sie ist mehrere Meter "
    "lang und breit und fast 2 Meter hoch. Sicher koennte sie Dich in einem "
    "Happen verschlingen.");
  AddId(({"muschel", "riesenmuschel", "NOWIMPY"}));

  create_default_npc(25);
  SetProp(P_HANDS, 
      ({" mit der harten Muschelschale", QueryProp(P_HANDS)[1], ({DT_WATER, DT_BLUDGEON}) }));
  SetProp(P_XP, QueryProp(P_XP)*4/3);
  SetProp(P_RACE, "Muschel");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_SLASH:-0.3,   DT_BLUDGEON: -0.3, DT_RIP: -0.3, DT_PIERCE: -0.3,
        DT_WHIP: -0.7, DT_SQUEEZE: -0.7, DT_AIR: -0.5, DT_COLD: -0.2,
        DT_WATER:-1, DT_FIRE:0.3, DT_LIGHTNING:0.3, DT_MAGIC:-0.3])); 

  SetProp(P_MSGIN, "schwimmt herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt herein");
  SetProp(P_MMSGOUT, "schwimmt weg");
  SetProp(P_MNPC_WAIT, ({ 600, 100, 600 }));

  SetProp(P_DIE_MSG,  " klappt tot zusammen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Die Riesenmuschel kann @WEN doch gar nicht tragen."}) );
  AddInfo(DEFAULT_INFO, "blubbert vor sich hin.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp(P_SPELLRATE, 50);
  AddSpell(1, 500,
      Name(WER,1)+" schlaegt Dich mit der unteren Muschelschale.\n",
      Name(WER,1)+" schlaegt @WEN mit der unteren Muschelschale.\n",
      ({DT_WATER, DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 500,
      Name(WER,1)+" schlaegt Dich mit der oberen Muschelschale.\n",
      Name(WER,1)+" schlaegt @WEN mit der oberen Muschelschale.\n",
      ({DT_WATER, DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]));
      
  SUID;

  PEARLMASTER->DistributePearl(2, 3, 1, 1);
}

