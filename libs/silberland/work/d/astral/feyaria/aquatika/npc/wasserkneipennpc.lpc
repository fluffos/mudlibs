// Die Wasserkneipe von Aussen
// 08-04-2004  Feyaria@SilberLand

#include "../def.h"

inherit "std/mnpc";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Der Eingang zur Wasserkneipe");
  SetProp(P_LONG, 
    "Das ist der Eingang zur Wasserkneipe. Du kannst ihn betreten.");
  SetProp(P_NAME, "Eingang zur Wasserkneipe");
  SetProp(P_GENDER, MALE);
  AddId(({"eingang", "NOT_LIVING"}));
  set_living_name("wasserkneipeneingang");

  create_default_npc(20);
  SetProp(P_SIZE, 300);
  SetProp(P_NOATTACK, " kann nicht angegriffen werden.");
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_FRIEND, 1);

  SetProp(P_MSGIN, "taucht hier auf");
  SetProp(P_MSGOUT, "veraendert seine Position");
  SetProp(P_MMSGIN, "taucht hier auf");
  SetProp(P_MMSGOUT, "veraendert seine Position");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wasserraum:0:0:0" );
  SetProp(P_MNPC_WAIT, ({ 240, 180, 300 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD);

  AddCmd( CMD_BETRETEN , "cmd_betreten");
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(str != "eingang" && str != "kneipe" && str != "wasserkneipe")
    return 0;
  write("Du betrittst die Wasserkneipe.\n");
  TP->move( ROOM "wasserkneipe", M_GO, "die Wasserkneipe", "betritt");
  return 1;
}

