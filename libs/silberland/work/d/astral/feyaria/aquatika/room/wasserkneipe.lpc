
#include "../def.h"
#include <pub.h>

inherit  "std/pub";

string read_liste();

void create() 
{
  ::create();
  SetProp(P_INT_SHORT, "Die Wasserkneipe");
  SetProp(P_INT_LONG,
      "Du stehst in der Wasserkneipe. Allerdings erinnert hier nichts an eine "
      "normale Kneipe, ausser dass man sich hier Essen und Getraenke "
      "bestellen kann. Serviert werden sie von seltsamen Wasserwesen, die "
      "wie aus dem Nichts erscheinen, sobald man etwas bestellt hat und "
      "sich wieder in Wasser aufloesen, sobald sie das Gewuenschte gebracht "
      "haben. Ein breites Portal fuehrt in den Nexus und ein kleiner "
      "Ausgang fuehrt weiter in diese waessrige Welt.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_UNDERWATER]) );

  AddDrink("Reines Wasser", 
      ({"wasser"}),
      10, 3, 0, 1,
      ({"Du bekommst Wasser serviert und trinkst es aus. "
       "Es schmeckt, oh welche Ueberraschung, nach Wasser!",
       "&& bekommt Wasser serviert."}));
  AddDrink("Algenschnaps", 
      ({"schnaps", "algenschnaps"}),
      542, ({67, 53, 12}), 13, 2,
      ({"Du bekommst einen Algenschnaps serviert und trinkst ihn aus. "
       "Extrem scharf und ein ueberwaeltigender Geschmack nach Algen!",
       "&& bestellt einen Algenschnaps."}));
  AddDrink("Haiblut", 
      ({"blut", "haiblut"}),
      1234, 111, 0, 21,
      ({"Du schluerfst frisches Haiblut aus einer kleinen Schale. "
       "Es erfrischt Dich ungemein, aber Dein Gesicht und Deine Haende sind "
       "nun blutrot.",
       "&& schluerft frisches Haiblut und bekommt ein ganz blutiges Gesicht."}));
  AddDrink("Antiwasser", 
      ({"antiwasser", "anti"}),
      1832, -2, 2, -10,
      ({"Du trinkst ein paar Tropfen Antiwasser und trocknest innerlich fast aus.",
       "&& trinkt ein paar Tropfen Antiwasser und trocknet innerlich fast aus."}));

  AddFood ( "Fischsuppe", 
      ({"suppe", "fischsuppe"}),
      107, 14, 4,
      ({"Du isst eine leckere Fischsuppe. ",
       "&& isst eine leckere Fischsuppe."}) );
  AddFood ( "Muschelsalat", 
      ({"salat", "muschelsalat"}),
      165, 19, 5,
      ({"Du isst einen Salat voll mit leckeren Muscheln. Knackig!",
       "&& isst einen Muschelsalat."}) );
  AddFood ( "Tintenfischsteak", 
      ({"steak", "tintenfischsteak", "tintenfisch"}),
      845, ({100, 50, 17}), 20,
      ({"Ein Steak vom Tintenfisch! Aussen knusprig, innen blutig. "
       "Aber seit wenn haben die blaues Blut? Oder ist das etwa noch Tinte?",
       "&& isst ein Tintenfischsteak und spritzt Tinte von sich."}) );
  AddFood ( "geroestetes Muraenenhirn", 
      ({"geroestetes muraenenhirn", "muraenenhirn", "hirn", "muraene"}),
      523, ({10, 65, 12}), 6,
      ({"Geroestetes Muraenenhirn! Unbeschreiblich gut! Nur wusstest Du gar "
       "nicht, dass Muraenen solch grosse Hirne haben!",
       "&& isst ein geroestetes Muraenenhirn."}) );


  AddSpecialDetail( ({"speise", "speisen", "getraenke", "getraenk", 
        "bestellen", "essen", "trinken", "bestellungen"}), 
      "det_menu");

  AddDetail( ({"boden"}),
      "Der Boden besteht komplett aus Wasser, aber aus irgendeinem Grund "
      "wirst Du trotzdem nich nass.");
  AddDetail( ({"waende", "wand", "decke"}),
      "Alles nur Wasser.");
  AddDetail( ({"grund"}),
      "Es wird wohl ein magischer Grund sein.");
  AddDetail( ({"kneipe", "wasserkneipe"}),
      "Du befindest Dich in der Wasserkneipe.");
  AddDetail( ({"wasserwesen", "wesen"}),
      "Die Wasserwesen erscheinen nur, um Bestellungen zu erfuellen und "
      "verschwinden dann sofort wieder.");
  AddDetail( ({"portal", "nexus"}),
      "Ein breites Portal fuehrt in den Nexus.");
  AddDetail( ({"ausgang", "welt"}),
      "Ein kleiner Ausgang fuehrt hinaus in die waessrige Welt von Aquatika.");
  AddDetail( ({"aquatika"}),
      "So nennt man in Fachkreisen die Ebene des Wassers.");
  AddDetail( ({"wasser"}),
      "Wasser gibt es hier viel, Du bist ja auch in der Ebene der Wasser.");
  AddDetail( ({"ebene"}),
      "Ebene bedeutet hier keine Landschaftsform oder dass hier alles ganz "
      "flach ist ist. Vielmehr stellt man sich vor, dass die verschiedenen "
      "Ebenen wie die Stockwerke eines Hauses uebereinander liegen.");
  AddDetail( ({"stockwerk", "stockwerke", "haus"}),
      "So kann man es sich vorstellen.");
  AddDetail( ({"landschaftsform", "bedeutung"}),
      "Nein, diese Bedeutung von Ebene ist nicht gemeint.");
  AddDetail( ({"fachkreis", "fachkreise"}),
      "Zum Beispiel bei den Druiden.");
  AddDetail( ({"druiden"}),
      "Druiden haben grosses Wissen ueber die Elemente. ");
  AddDetail( ({"elemente", "feuer", "luft", "eis", "humus", "erz"}),
      "Die Elemente sind Feuer, Eis, Humus, Luft, Erz und natuerlich Wasser.");
  AddDetail( ({"macht", "verstaendnis", "wissen"}),
      "Die Macht der Druiden ueber die Elemente kommt aus dem Verstaendnis "
      "der Elementartheorie.");
  AddDetail( ({"elementartheorie"}),
      "Vereinfacht sagt die Elementartheorie, dass es sechs Elemente gibt, "
      "wobei sich jeweils zwei immer entgegengesetzt sind, zum Beispiel "
      "Feuer und Wasser.");
  AddDetail( ({"beispiel"}),
      "Ein anderes Beispiel ist Luft und Erz.");
  AddDetail( ({"nichts"}),
      "Du siehst hier nichts.");
  AddDetail( ({"gewuenschte"}),
      "Du solltest selber wissen, was Du wuenscht.");

  AddSmell( ({DEFAULT_SMELL}), 
      "Es riecht wasserig.");
  AddSound( ({DEFAULT_SOUND, "kneipengeraeusche"}), 
      "Obwohl es sich hier um eine ganz seltsame Kneipe handelt, hoerst "
      "Du trotzdem die ueblichen Kneipengeraeusche.");

  AddExit ("raus", ([EX_MSG: "raus",
                     EX_FUNC: "raus"]) );
  AddExit ("nexus", ([EX_MSG: "zurueck in den Nexus",
                      EX_DEST: NEXUS]) );

  RemoveItem("/obj/topliste");
  AddDetail( ({"liste", "aquatikaliste", "topliste", "topaquatikaliste", 
        "top-aquatikaliste"}), #'read_liste);
  AddReadDetail( ({"liste", "aquatikaliste", "topliste", "topaquatikaliste", 
        "top-aquatikaliste"}), #'read_liste);
  SetProp(P_ZONE, "Aquatika");
#include "../../where.h"
}

mixed raus(string verb)
{
  object ob;
  if(!present(WATERBREATH_ID, TP) && !IS_LEARNING(TP))
  {
    write(BS("Du musst schon unter Wasser atmen koennen, um da hinaus zu "
          "gehen. Sonst waere das der reine Selbstmord!"));
    return 1;
  }
  if(ob = find_living("wasserkneipeneingang"))
    return file_name(ENV(ob));
  else
  {
    call_other(ROOM "wasserraum:0:0:0", "reset");
    return ROOM "wasserraum:0:0:0";
  }
}

string det_menu()
{
  TP->command_me("menue");
  return "";
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  return ::int_long(viewer, viewpoint, shortflag) +
    "Die Top-Aquatikaliste.\n";
}

string read_liste()
{
  write(
    "Die Liste der beruehmtesten Helden in Aquatika\n"
    "----------------------------------------------\n");
  ASTRALMASTER->FameList("aquatika");
  return "";
}
