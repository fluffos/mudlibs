text_short ({"Mitten im waessrigen Aquatika","In der Ebene des Wassers","Die endlosen Weiten von Aquatika","Die Ebene des Wassers","Aquatika - die Ebene des Wassers","Mitten in der Ebene des Wassers",})
text_long ([6:({"Zum Glueck kannst Du unter Wasser Atmen, sonst waerst Du sicher schon ertrunken.",}),2:({"Ringsherum siehst Du nur Wasser.","In allen Richtungen siehst Du nur Wasser.","Ueberall Wasser, wohin Du auch schaust.",}),5:({"Viele kleine Fische schwimmen hier herum.","Ein Schwarm kleiner Fische schwimmt hier herum.","Ein kleiner Fisch schwimmt vor Deiner Nase herum.",}),1:({"Du befindest Dich mitten in Aquatika, dem Reich des Wassers.","Du befindest Dich in der Ebene des Wassers, auch Aquatika genannt.",}),4:({"Einige Wasserpflanzen erschweren Deine Sicht.","Hier wachsen viele Algen.","Das Wasser ist erstaunlich klar hier.",}),3:({"Du spuerst eine leichte Stroemung, die von Westen nach Oben geht.","Du spuerst eine leichte Stroemung, die von Westen nach Unten geht.","Du spuerst eine leichte Stroemung, die von Westen nach Norden geht.","Du spuerst eine leichte Stroemung, die von Westen nach Sueden geht.","Du spuerst eine leichte Stroemung, die von Westen nach Osten geht.","Du spuerst eine leichte Stroemung, die von Osten nach Oben geht.","Du spuerst eine leichte Stroemung, die von Osten nach Unten geht.","Du spuerst eine leichte Stroemung, die von Osten nach Norden geht.","Du spuerst eine leichte Stroemung, die von Osten nach Sueden geht.","Du spuerst eine leichte Stroemung, die von Osten nach Westen geht.","Du spuerst eine leichte Stroemung, die von Norden nach Oben geht.","Du spuerst eine leichte Stroemung, die von Norden nach Unten geht.","Du spuerst eine leichte Stroemung, die von Norden nach Sueden geht.","Du spuerst eine leichte Stroemung, die von Norden nach Westen geht.","Du spuerst eine leichte Stroemung, die von Norden nach Osten geht.","Du spuerst eine leichte Stroemung, die von Sueden nach Oben geht.","Du spuerst eine leichte Stroemung, die von Sueden nach Unten geht.","Du spuerst eine leichte Stroemung, die von Sueden nach Norden geht.","Du spuerst eine leichte Stroemung, die von Sueden nach Westen geht.","Du spuerst eine leichte Stroemung, die von Sueden nach Osten geht.","Du spuerst eine leichte Stroemung, die von Oben nach Unten geht.","Du spuerst eine leichte Stroemung, die von Oben nach Norden geht.","Du spuerst eine leichte Stroemung, die von Oben nach Sueden geht.","Du spuerst eine leichte Stroemung, die von Oben nach Westen geht.","Du spuerst eine leichte Stroemung, die von Oben nach Osten geht.","Du spuerst eine leichte Stroemung, die von Unten nach Oben geht.","Du spuerst eine leichte Stroemung, die von Unten nach Norden geht.","Du spuerst eine leichte Stroemung, die von Unten nach Sueden geht.","Du spuerst eine leichte Stroemung, die von Unten nach Westen geht.","Du spuerst eine leichte Stroemung, die von Unten nach Osten geht.","Hier gibt es ueberhaupt keine Stroemung.",}),])
text_details (["wasserpflanzen":({"Die Pflanzen wuchern hier sehr stark.",}),"nase":({"Du verdrehst Deine Augen, aber kannst Deine eigene Nase nur sehr schwer sehen.","Deine Nase ist zu gross.","Deine Nase ist zu klein.","Deine Nase ist voll Wasser.",}),"augen":({"Ohne Spiegel kannst Du Deine Augen nicht sehen.","Ohne Augen koenntest Du nichts sehen.",}),"algen":({"Hier wachsen viele Algen.","Algen sind Wasserpflanzen.",}),"schwarm":({"Der Schwarm besteht aus vielen Fischen, ein Fischschwarm sozusagen.","Der Schwarm besteht aus vielen Fischen.",}),"spiegel":({"Wo ist hier ein Spiegel?",}),"fische":({"Viele kleine Fische schwimmen hier herum.",}),"pflanzen":({"Die Wasserpflanzen wuchern hier sehr stark.","Ganz normale Wasserpflanzen, unter anderem auch Algen.",}),"fisch":({"Ein kleiner Fisch.","Hier gibt es viele Fische.",}),"fischschwarm":({"Der Schwarm besteht aus vielen Fischen.","Ein Schwarm aus vielen Fischen.",}),])
