#include "../def.h"

inherit ROOM "std_wasserraum";

void create()
{
  string *npcs;

  if(!is_clone(TO)) return;
  ::create();
  PO->CustomizeObject();

  AddDetail( ({"aquatika", "reich", "reich des wassers"}),
      "Aquatika, das Reich des Wassers, es wird von Druiden auch als die "
      "elementare Ebene des Wassers bezeichnet. Es wird von den Marids "
      "beherrscht.");
  AddDetail( ({"marid", "marids", "wasserwesen"}),
      "Die Marids sind die Herrscher ueber die Ebene des Wassers.");
  AddDetail( ({"herrscher"}),
      "Der Herrscher aller Wasserwesen ist der Marid Padisha.");
  AddSpecialDetail(({"marid padisha", "padisha", "macht"}), "det_padisha");
  AddDetail( ({"wasser"}),
      "Wasser gibt es hier viel, Du bist ja auch in der Ebene der Wasser.");
  AddDetail( ({"ebene"}),
      "Ebene bedeutet hier keine Landschaftsform oder dass hier alles ganz "
      "flach ist ist. Vielmehr stellt man sich vor, dass die verschiedenen "
      "Ebenen wie die Stockwerke eines Hauses uebereinander liegen.");
  AddDetail( ({"stockwerk", "stockwerke", "haus"}),
      "So kann man es sich vorstellen.");
  AddDetail( ({"landschaftsform", "bedeutung"}),
      "Nein, diese Bedeutung von Ebene ist nicht gemeint.");
  AddDetail( ({"druiden"}),
      "Druiden haben grosse Macht ueber die Elemente. ");
  AddDetail( ({"elemente", "feuer", "luft", "eis", "humus", "erz"}),
      "Die Elemente sind Feuer, Eis, Humus, Luft, Erz und natuerlich Wasser.");
  AddDetail( ({"macht", "verstaendnis"}),
      "Die Macht der Druiden ueber die Elemente kommt aus dem Verstaendnis "
      "der Elementartheorie.");
  AddDetail( ({"elementartheorie"}),
      "Vereinfacht sagt die Elementartheorie, dass es sechs Elemente gibt, "
      "wobei sich jeweils zwei immer entgegengesetzt sind, zum Beispiel "
      "Feuer und Wasser.");
  AddDetail( ({"beispiel"}),
      "Ein anderes Beispiel ist Eis und Humus.");
  AddDetail( ({"richtungen", "richtung"}),
      "In jede Richtung schaut es hier ziemlich gleich aus.");
  AddDetail( ({"boden"}),
      "Kein Boden, unter Dir befindet sich nur Wasser.");
  AddDetail( ({"himmel"}),
      "Kein Himmel, ueber Dir befindet sich nur Wasser.");
  AddDetail( ({"glueck"}),
      "Zum Glueck kannst Du unter Wasser Atmen! Sonst waerest Du schon "
      "laengst ertrunken.");
  AddDetail( ({"stroemung", "wasserstroemung"}),
      "Gemeint ist die Wasserstroemung.");
  AddSpecialDetail( ({"augen"}), "det_augen");

  AddSmell( ({DEFAULT_SMELL, "geruch", "wasser"}), 
      "Es riecht waessrig.");
  AddSound( ({DEFAULT_SOUND, "blubbern", "wasser"}), 
      "Du hoerst das Blubbern des Wassers.");
 
  npcs =({
      FISCH, FISCH, FISCH,
      HAI,
      MURAENE,
      WASSERLAEUFER,
      KROKODIL,
      WASSERPILZ,
      WASSERSCHLANGE,
      WASSERGOBLIN,
      MANTA,
      QUALLE,
      WASSERGEIST,
      NPC "wasserelementar",
      NPC "wasserdruide",
      NPC "krake",
      NPC "riesenmuschel",
      });
  if (random(100) < NPC_CHANCE)
    AddItem( npcs + (!random(3) ? ({MARID "mufti"}) : ({})), 
        REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES,
          P_MNPC_WAIT: ({ 30, 60, 60 }),
          P_HEAL: 200,
          P_CORPSE: OBJ "wasserleiche",
          P_NOCORPSE: 0]) ); 

  if (random(100) < RARE_NPC_CHANCE)
    AddItem(  npcs + ({ 
          CORRUPTOR,
          MARID "atabeg",
          TENTAKEL,
          UWDRACHE,
          WASSERZYKLOP,
          NPC "wasserriese",
          }), REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES,
          P_MNPC_WAIT: ({ 60, 90, 90 }),
          P_ASTRAL_RARE_NPC: 1,
          P_HEAL: 500,
          P_CORPSE: OBJ "wasserleiche",
          P_NOCORPSE: 0]) ); 

}

string det_augen()
{
  return "Deine Augen sind " + TP->QueryProp(P_EYE_COLOR) + ".\n";
}

void init()
{
  ::init();
  if( TP && interactive(TP) && !present("\nwaterbreath", TP) && 
      !present("\nertrinken", TP) &&
      !TP->id("WATERBREATH") && !IS_LEARNER(TP) )
  {
    CLONE(ERTRINKEN, TP);
  }
}

string det_padisha()
{
  if (ASTRALMASTER->QueryTime("aquatika") > 0)
    return "Die Macht des Marid Padisha ist momentan sehr schwach.\n";
  else
    return "Du kannst die Macht des Marid Padisha hier foermlich fuehlen.\n";
}
