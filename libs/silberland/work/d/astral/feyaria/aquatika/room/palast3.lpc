#include "../def.h"

inherit ROOM "std_wasserraum";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Palast des Wassers");
  SetProp(P_INT_LONG,
      "Du stehst in einer gewaltigen Saeulenhalle, nur sind die Saeulen keine "
      "normalen Saeulen sondern riesige Wasserfaelle, die aber fix an ihrem "
      "Platz bleiben. Die Wasserfaelle werden in Richtung Norden immer kleiner. "
      "In der Mitte des Halbkreises steht ein riesiger Thron.");

  AddDetail( ({"boden"}),
      "Der Boden besteht nur aus Wasser, allerdings werden Deine Fuesse "
      "nicht nass.");
  AddDetail( ({"decke"}),
      "Die Decke dieses Palastes besteht aus Wasser.");
  AddDetail( ({"waende", "wand"}),
      "Waende kannst Du hinter den Saeulen nicht erkennen.");
  AddDetail( ({"saeulenhalle", "halle"}),
      "Die riesige Saeulenhalle besteht nicht aus normalen Saeulen, sondern "
      "aus Wasserfaellen.");
  AddDetail( ({"saeulen", "saeule"}),
      "Die Saeulen sind eigentlich Wasserfaelle.");
  AddDetail( ({"wasserfaelle", "wasserfall"}),
      "Die Wasserfaelle bleiben fix an ihrem Platz und vermitteln so den "
      "Eindruck einer Saeulenhalle.");
  AddDetail( ({"platz"}),
      "Eine starke Magie muss die Wasserfaelle an ihrem Platz halten. Du "
      "kannst foermlich die Energie spueren, die hier gebunden ist.");
  AddDetail( ({"richtung", "norden"}),
      "In Richtung Norden werden die Saeulen kleiner.");
  AddDetail( ({"wesen", "Wasserwesen"}),
      "Hier leben die Wasserwesen, die diese Ebene beherrschen, die Marids.");
  AddDetail( ({"palast"}),
      "Dies ist der Palast des Wassers.");
  AddDetail( ({"wasser", "ebene", "ebene des wassers"}),
      "Hier ist alles aus Wasser, kein Wunder, da Du Dich ja auf der Ebene des "
      "Wasserss befindest.");
  AddDetail( ({"wunder"}),
      "Eines der Wunder ist, dass Du noch nicht ertrunken bist.");
  AddDetail( ({"magie"}),
      "Es handelt sich wohl um elementare Wassermagie.");
  AddDetail( ({"energie"}),
      "In den gewaltigen Wasserfaellen steckt eine gewaltige Energie!");
  AddDetail( ({"marid", "marids"}),
      "Die Marids sind die Herrscher ueber die Ebene des Wassers.");
  AddDetail( ({"wassermagie"}),
      "Nur Wassermagie ist maechtig genug, um einen Wasserfall an einen Ort "
      "zu binden.");
  AddDetail( ({"herrscher", "padisha"}),
      "Der Herrscher aller Wasserwesen ist der Marid Padisha.");
  AddDetail( ({"ort", "eindruck"}),
      "Dieser Ort macht einen starken Eindruck auf Dich.");
  AddDetail( ({"abschluss", "halbkreis", "ende"}),
      "Hier bilden die Saeulen einen Halbkreis und somit das Ende der "
      "gewaltigen Saeulenhalle. In der Mitte steht ein grosser Thron. "
      "Hier scheint der Herrscher dieses Palastes zu residieren.");
  AddDetail( ({"kreis"}),
      "Kein Kreis, nur ein Halbkreis.");
  AddDetail( ({"thron", "mitte"}),
      "In der Mitte des Halbkreises aus Wasserfaellen steht ein gewaltiger "
      "Thron, der vollstaendig aus Wasser besteht.");

  AddSmell( ({DEFAULT_SMELL, "geruch"}), 
      "Es riecht nach Wasser.");
  AddSound( ({DEFAULT_SOUND, "rauschen", "wasserfall"}), 
      "Du hoerst das Rauschen des Wasserfalls.");

  AddExit( "norden", ROOM "palast2");
}

