#include "../def.h"

inherit STDROOM;

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_IN);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_UNDERWATER]) );

  SetProp(P_ZONE, "Aquatika");
}

void init()
{
  ::init();
  if(objectp(TP) && interactive(TP) && !IS_LEARNING(TP) && 
      !present(WATERBREATH_ID, TP) && !present(ERTRINKEN_ID, TP))
  {
    CLONE(ERTRINKEN, TP);
  }
}
