// Wellenbeisser, der Wasserdolch
// 27.12.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Wellenbeisser, der Wasserdolch");
  SetProp(P_LONG,
    "Wellenbeisser ist ein Dolch aus einem blaeulich schimmernden Metall. "
    "Die Klinge ist gewellt und scheint sich zu bewegen, fast wie eine Welle. "
    "Es tropft auch staeandig Meerwasser von dem Dolch herunter. "
    "Sicher muss man sehr maechtig sein, um diese Waffe fuehren zu koennen.");

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Wellenbeisser");
  AddId( ({"wellenbeisser", "dolch", "wasserdolch"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_INFO,
      "Wellenbeisser ist nicht nur eine maechtige Waffe, sondern schuetzt den "
      "Traeger auch noch etwas vor Wasserangriffen.");

  AddDetail( ({"metall"}),
    "Wellenbeisser besteht aus einem seltsamen blaeulichen Metall.");

  SetProp(P_VALUE, 4000);
  SetProp(P_WEIGHT, 500);
  SetProp(P_MATERIAL, ([ MAT_WATER:10, MAT_METAL:90 ]) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_WATER}) );
  SetProp(P_WC, 155);
  SetProp(P_WC_FIX, 65);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp(P_HIT_FUNC, this_object());
}


int WieldFunc(object waffe, int silent)
{
  MENV->AddResistanceModifier( ([DT_WATER:-0.1]) );
  return 1;
}

int UnwieldFunc(object waffe, int silent)
{
  QueryProp(P_WIELDED)->RemoveResistanceModifier();
  return 1;
}

int HitFunc(object enemy)
{
  if (!random(77))
  {
    tell_object(enemy, "Eine gewaltige Flutwelle reisst Dich zu Boden!\n");
    tell_room(ENV(enemy), BS(
        "Eine gewaltige Flutwelle reisst " + enemy->name(WEN) + " zu Boden!"),
        ({enemy}));
    enemy->SetProp(P_DISABLE_ATTACK, 2 + random(3));
    return 200 + random(300);
  }
  return random(10);
}

void reset()
{
  object wer;
  if (!is_clone(this_object())) return;
  ::reset();

  if (objectp(wer = QueryProp(P_WIELDED)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die waessrige Energie von Wellenbeisser heilt Dich.\n");
    wer->heal_self(77);
  }
}

