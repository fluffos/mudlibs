#include "../def.h"

inherit NPC "std_eternia_npc";
inherit "std/npc/spells";

void create()
{
  string what;
  if (!is_clone(this_object())) return;

  ::create();
  what = ({"Zeit", "Vergangenheit", "Gegenwart", "Zukunft", "Ewigkeit"}) [random(5)];

  SetProp(P_SHORT, "Ein Waechter der " + what);
  SetProp(P_LONG, 
      "Diese geisterhafte Erscheinung ist einer der Waechter von Eternia, "
      "der Ebene der Zeit. Der Waechter scheint keine feste Form zu besitzen, "
      "daher kann er wohl leichter in der Zeit reisen. Dieser Waechter "
      "kuemmert sich primaer um die " + what + ".");
  SetProp(P_NAME, ({"Waechter der " + what,
                    "Waechters der " + what,
                    "Waechter der " + what,
                    "Waechter der " + what}) );

  SetProp(P_GENDER, MALE);
  AddId( ({"waechter", "waechter der " + what}) );
  set_living_name("eterniawaechter");

  create_default_npc(40, 4000);
  SetProp(P_HANDS, ({" mit der Kraft der " + what, QueryProp(P_HANDS)[1] * 2,
        ({DT_MAGIC, DT_BLUDGEON}) }));
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Geist");
  SetProp(P_NOCORPSE, 1);

  SetProp(P_SIZE, 250);
  SetProp(P_MAX_HANDS, 0);

  SetProp(P_MSGIN, "bewegt herein");
  SetProp(P_MSGOUT, "bewegt");
  SetProp(P_MMSGIN, "bewegt");
  SetProp(P_MMSGOUT, "bewegt sich weit weg");

  SetProp(P_DIE_MSG,  " wird zeitlos.\n");
  SetProp(P_KILL_MSG, "Deine Zeit ist abgelaufen!"); 
  AddInfo(DEFAULT_INFO, "scheint Dich nicht hoeren zu koennen.\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS);
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }) );

  SetProp(P_REJECT, ({ REJECT_DROP, "" }) );

  SetProp(P_SPELLRATE, 60);
  AddDefaultSpell(1, 500, DS_PARALYZE,
      Name(WER,1) + " beraubt Dich Deiner Zeit.\n",
      Name(WER,1) + " beraubt @WEN jeglicher Zeit.\n");
  AddSpell(4, 1000,
      Name(WER,1) + " straft Dich mit der Macht der " + what + ".\n",
      Name(WER,1) + " straft @WEN mit der Macht der " + what + ".\n",
      DT_MIND, ([SP_SHOW_DAMAGE:1]));

  SetProp(P_TRANSPARENT, 0);

  switch (random(100))
  {
    case 0: CLONEME(ESSENZ); break;
    case 1..3: CLONEME(WSALBE); break;
    case 4..6: CLONEME(RSALBE); break;
    case 7..9: CLONEME(SALBE); break;
  }
}

