#include "../def.h"

inherit NPC "std_eternia_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp(P_SHORT, "Zerbuxoruk, der Herr der Zeit");
  SetProp(P_LONG, 
      "Vor Dir steht ein gewaltiges geisterhaftes Wesen, dessen wahre Form "
      "Du kaum wahrnehmen kannst. Das muss Zerbuxoruk sein, der Herr ueber "
      "die Zeit. Er hat angeblich gottaehnlich Kraefte, und schon alleine "
      "sein Anblick laesst Dir einen Schauer der Ehrfurcht ueber den Ruecken "
      "laufen. Du siehst Deine eigene Vergangenheit, Deine Gegenwart und "
      "alle Moeglichkeiten, wie Deine Zukunft aussehen koennte, alles zur "
      "gleichen Zeit. Dir wird schwindlig und Du musst Deinen Blick abwenden, "
      "um nicht den Verstand zu verlieren.");
  SetProp(P_NAME, "Zerbuxoruk");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"herr", "zeit", "herr der zeit", "zerbuxoruk"}) );

  create_default_npc(70, 100000);
  SetProp(P_HANDS, ({" mit der Kraft der Zeit", QueryProp(P_HANDS)[1] * 2,
                     ({DT_BLUDGEON, DT_MAGIC}) }));
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      0.3, DT_WATER:       0.3,
       DT_AIR:       0.3, DT_LIGHTNING: 0.3, DT_EXPLOSION:   0.3,
       DT_SOUND:     0.3, DT_LIGHT:     0.3, DT_ELECTRIC:    0.3,
       DT_ACID:      0.3, DT_POISON:    0.3, DT_TERROR:      0.3,
       DT_HOLY:      0.3, DT_UNHOLY:    0.3, DT_MAGIC:       0.3,
       DT_MIND:      0.3, DT_SLASH:     0.3, DT_BLUDGEON:    0.3,
       DT_PIERCE:    0.3, DT_SQUEEZE:   0.3, DT_WHIP:        0.3,
       DT_RIP:       0.3,
     ]) );
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Gott");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_HP_DELAY, 0);

  SetProp(P_SIZE, 1000);
  SetProp(P_MAX_HANDS, 0);

  SetProp(P_MSGIN, "bewegt sich herein");
  SetProp(P_MSGOUT, "bewegt sich");
  SetProp(P_MMSGIN, "bewegt sich herein");
  SetProp(P_MMSGOUT, "bewegt sich weit weg");

  SetProp(P_DIE_MSG,  " verliert die Kontrolle ueber die Zeit.\n");
  AddInfo(DEFAULT_INFO, "scheint Dich nicht hoeren zu koennen.\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS);
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }) );

  SetProp(P_REJECT, ({ REJECT_DROP, "" }) );

  SetProp(P_SPELLRATE, 100);
  AddDefaultSpell(1, 1000, DS_PARALYZE,
      Name(WER,1) + " beraubt Dich Deiner Zeit.\n",
      Name(WER,1) + " beraubt @WEN der Zeit.\n", 
      2);
  AddDefaultSpell(1, 600, DS_MASS_DAMAGE,
      Name(WER,1) + " erzeugt ein Loch in der Zeit.\n",
      Name(WER,1) + " erzeugt ein Loch in der Zeit.\n", 
      DT_MAGIC);
  AddSpell(4, 1500,
      Name(WER,1) + " straft Dich mit der Macht der Zeit.\n",
      Name(WER,1) + " straft @WEN mit der Macht der Zeit.\n",
      DT_MIND, ([SP_SHOW_DAMAGE:1]));

  SetProp(P_TRANSPARENT, 0);
}

void heart_beat()
{
  ::heart_beat();
  AddHp(2 + random(10));
}
