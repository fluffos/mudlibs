#include "../def.h"

inherit NPC "std_eternia_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp(P_SHORT, "Der Herr ueber die Vergangenheit");
  SetProp(P_LONG, 
      "Diese maechtige geisterhafte Erscheinung ist der Herr ueber die "
      "Vergangenheit. Er kontrolliert die Errinngerungen der Sterblichen "
      "an die gewesenen Ereignisse.");
  SetProp(P_NAME, ({"Herr ueber die Vergangenheit",
                    "Herren ueber die Vergangenheit",
                    "Herrn ueber die Vergangenheit",
                    "Herrn ueber die Vergangenheit"}) );

  SetProp(P_GENDER, MALE);
  AddId( ({"herr", "vergangenheit", "herr der vergangenheit"}) );
  set_living_name("eternialord");

  create_default_npc(60, 10000);
  SetProp(P_HANDS, ({" mit der Kraft der Vergangenheit", QueryProp(P_HANDS)[1] * 2,
                     ({DT_BLUDGEON, DT_MAGIC}) }));
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Geist");
  SetProp(P_NOCORPSE, 1);

  SetProp(P_SIZE, 750);
  SetProp(P_MAX_HANDS, 0);

  SetProp(P_MSGIN, "bewegt herein");
  SetProp(P_MSGOUT, "bewegt");
  SetProp(P_MMSGIN, "bewegt");
  SetProp(P_MMSGOUT, "bewegt sich weit weg");

  SetProp(P_DIE_MSG,  " verliert die Kontrolle ueber die Vergangenheit.\n");
  AddInfo(DEFAULT_INFO, "scheint Dich nicht hoeren zu koennen.\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS);
  SetProp(P_MNPC_WAIT, ({ 30, 30, 30 }) );

  SetProp(P_REJECT, ({ REJECT_DROP, "" }) );

  SetProp(P_SPELLRATE, 60);
  AddDefaultSpell(1, 1000, DS_PARALYZE,
      Name(WER,1) + " beraubt Dich Deiner Vergangenheit.\n",
      Name(WER,1) + " beraubt @WEN der Vergangenheit.\n");
  AddSpell(4, 1500,
      Name(WER,1) + " straft Dich mit der Macht der Vergangenheit.\n",
      Name(WER,1) + " straft @WEN mit der Macht der Vergangenheit.\n",
      DT_MIND, ([SP_SHOW_DAMAGE:1]));

  SetProp(P_TRANSPARENT, 0);
}

