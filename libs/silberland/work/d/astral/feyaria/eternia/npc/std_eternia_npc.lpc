// std-npc fuer eternia
// 10-12-2004  Feyaria@SilberLand

#include "../def.h"

inherit STDNPC;

int reset_counter = 0;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"\neternianpc"}) );
  SetProp(P_LOG_INFO, "feyaria/eternia");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "0x0y") );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD + MOV_BACKWARDS);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:1000000]));

  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  if (QueryProp(P_LEVEL) > 50 && ++reset_counter > 3)
    deep_remove();
}

varargs void create_default_npc(int level, int hp)
{
  if (hp)
    ::create_default_npc(level, hp);
  else
    ::create_default_npc(level);
  SetProp(P_XP, QueryProp(P_XP) * 3 / 2); // 50% XP-Bonus
}

void init()
{
  ::init();
  if (!TP)
    return;
  if (TP->id("\neternianpc"))
    AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void ZoneShout(string str)
{
  write(str);
  domainshout(str, ZONE, 1);
}

void die(int poisondeath)
{
  object killer;

  if (QueryProp(P_LEVEL) == 40 &&
      sizeof(find_livings("eterniawaechter")) == 1 &&  // letzter Waechter
      ASTRALMASTER->QueryTime("eternia") <= 0 &&
      !sizeof(find_livings("eternialord")) &&
      !find_living("zerbuxoruk"))
  {
    ZoneShout("\n\nVergangenheit, Gegenwart und Zukunft scheinen ploetzlich "
        "eins zu sein.\n\n\n");
    ASTRALMASTER->SetTime("eternia", time());
    clone_object(NPC "vergangenheit")->move(ROOM "12x1y", M_NOCHECK);
    clone_object(NPC "gegenwart")->move(ROOM "0x10y", M_NOCHECK);
    clone_object(NPC "zukunft")->move(ROOM "12x19y", M_NOCHECK);
  }
  else if (QueryProp(P_LEVEL) == 60 &&
      sizeof(find_livings("eternialord")) == 1) 
  {
    ZoneShout("\n\nDu spuerst wie eine unglaublich starke Macht die Zeit "
        "verzerrt!\n\n\n");
    clone_object(NPC "herr_der_zeit")->move(ROOM "8x10y", M_NOCHECK);
  }

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "eternia", QueryProp(P_LEVEL));
  ::die(poisondeath);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object ob;
  if (QueryProp(P_LEVEL) > 50 && (ob = find_living("eterniawaechter")))
  {
    tell_object(enemy, ob->Name(WER) + " verhindert Deinen Angriff.\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

int _query_frog() { return 0; }
int _query_wimpy() { return 0; }
int _query_poison() { return 0; }
int _query_align() { return 0; }
int _query_disable_attack() { return 0; }
int _query_disable_spells() { return 0; }
mixed _query_skill_attr() { return 0; }
int _query_blind() { return 0; }
