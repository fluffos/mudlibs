// Eternia, die Ebene der ZEit
// 28.12.2004 Feyaria@SiblerLand

#include "../def.h"

inherit ROOM "std_eternia";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Der Eingang zu Eternia, der Ebene der Zeit");
  SetProp(P_INT_LONG,
      "Der Eingang zu Eternia, der Ebene der Zeit. Du siehst keine Konturen, "
      "alles ist nebelhaft und verschwommen. Aus den Augenwinkeln siehst "
      "Du vergangene und zukuenftige Ereignisse an Dir vorueberrasen. "
      "Du spuerst ein seltsames Kribbeln im Bauch und fuehlst Dich sehr unwohl. "
      "Ein Portal fuehrt zurueck in den Nexus.");
 
  AddExit( "vergangenheit", "./10x8y" );
  AddExit( "gegenwart", "./4x10y");
  AddExit( "zukunft", "./10x12y");
  AddExit( "raus", NEXUS);
}

