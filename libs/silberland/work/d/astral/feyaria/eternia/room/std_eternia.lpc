// Eternia, die Ebene der ZEit
// 28.12.2004 Feyaria@SiblerLand

#include "../def.h"

inherit STDROOM;

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Eternia, die Ebene der Zeit");
  SetProp(P_INT_LONG,
      "Du bist in Eternia, der Ebene der Zeit. Du siehst keine Konturen, "
      "alles ist nebelhaft und verschwommen. Aus den Augenwinkeln siehst "
      "Du vergangene und zukuenftige Ereignisse an Dir vorueberrasen. "
      "Du spuerst ein seltsames Kribbeln im Bauch und fuehlst Dich sehr "
      "unwohl.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_IN);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_OTHER]) );
  SetProp(P_ZONE, "Eternia");

  AddDetail( ({"boden"}),
      "Der Boden ist in dieser nebelhaften Welt kaum zu sehen.");
  AddDetail( ({"decke", "himmel"}),
      "Ueber Dir ist nur ein nebelhafter Schleier.");
  AddDetail( ({"eternia", "ebene", "ebene der zeit"}),
      "Eternia, die Ebene der Zeit. Hier wird die Gegenwart erzeugt, die "
      "Erinnerungen an die Vergangenheit gespeichert und die Zukunft "
      "vorbereitet.");
  AddDetail( ({"gegenwart", "jetzt"}),
      "Jetzt ist die Gegenwart, aber waehrend wir darueber reden, wird sie "
      "schon wieder Vergangenheit.");
  AddDetail( ({"erinnerung", "erinnungen"}),
      "Sicher hast Du viele schoene Erinnerungen, sie werden alle hier "
      "gespeichert.");
  AddDetail( ({"vergangenheit"}),
      "Die ist laengst vorbei.");
  AddDetail( ({"zukunft"}),
      "Leider kannst Du nicht erkennen, was die Zukunft so bringen wird.");
  AddDetail( ({"waende", "wand"}),
      "Keine Waende, nur Nebel.");
  AddDetail( ({"konturen"}),
      "Durch den Nebel ist hier alles ganz unscharf.");
  AddDetail( ({"augenwinkeln", "augen", "winkel", "ereignis", "ereignisse"}),
      "Aus den Augenwinkeln siehst Du vergangene und zukuenftige Ereignisse "
      "an Dir vorueberrasen.");
  AddDetail( ({"kribbeln", "bauch"}),
      "Du spuerst ein seltsames Kribbeln im Bauch.");
  if(!random(3))
    AddItem(NPC "waechter", REFRESH_DESTRUCT);
}

void load()
{
  if (find_call_out("load_rooms") == -1)
    call_out("load_rooms", 2);
}

void init()
{
  ::init();
  load();
}

void load_rooms()
{
  int i;
  string *exits;

  for (i = sizeof(exits = m_values(QueryProp(P_EXITS))) - 1; i >= 0; i--)
    if (!find_object(exits[i]))
      call_other(exits[i], "load");
}

void reset()
{
  ::reset();
  set_next_reset(4*60*60);
}
