inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

string DESCPATH = "/d/huegelland/feyaria/eternia/doc/";
string ROOMPATH = "/d/huegelland/feyaria/eternia/room/";

void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Der Autozonengenerator" );
   SetProp(P_INT_LONG, "Nicht viel hier.");

   AddCmd( "zmake","do_read_map" );
}

int do_read_map(string path) 
{
  string err;
  string result;
  string *lines;
  string outp;
  int x,y;
  x=0;
  y=0;
  outp="";

  err = catch(result = read_file(path));
  if (err) {
    write(path + ": " + err + ".\n");
    return -1;
  }

  lines=explode(result,"\n");

  for (x=0;x<sizeof(lines);x++) 
  {
    for (y=0;y<=strlen(lines[x]);y++) 
    {
      outp="";
      outp+="/* Eternia, die Ebene der Zeit\n";
      outp+="** "+(x/2)+"x"+(y/2)+"y.lpc";
      outp+="  [created using autozne map converter 0.1 (c) Lamuerte]\n";
      outp+="** "+dtime()+" Feyaria@SilberLand\n";
      outp+="*/\n";
      outp+=read_file(DESCPATH+"room.desc");
      if((lines[x][y..y])=="#") 
      {
        if(x>1 && lines[x-1][y..y]=="|")
          outp+="  AddExit(\"norden\",\"./"+((x-2)/2)+"x"+(y/2)+"y\");\n";

        if(x<(strlen(lines[x])-1) && lines[x+1][y..y]=="|")
          outp+="  AddExit(\"sueden\",\"./"+((x+2)/2)+"x"+(y/2)+"y\");\n";

        if(y>1 && lines[x][y-1..y-1]=="-")
          outp+="  AddExit(\"westen\",\"./"+(x/2)+"x"+((y-2)/2)+"y\");\n";

        if(y<(sizeof(lines)-1) && lines[x][y+1..y+1]=="-")
          outp+="  AddExit(\"osten\",\"./"+(x/2)+"x"+((y+2)/2)+"y\");\n";

        if(x>1 && y>1 && lines[x-1][y-1..y-1]=="\\")
          outp+="  AddExit(\"nordwesten\",\"./"+((x-2)/2)+"x"+((y-2)/2)+"y\");\n";

        if(x>1 && y<(sizeof(lines)-1) && lines[x-1][y+1..y+1]=="/")
          outp+="  AddExit(\"nordosten\",\"./"+((x-2)/2)+"x"+((y+2)/2)+"y\");\n";

        if(x<(strlen(lines[x])-1) && y>1 && lines[x+1][y-1..y-1]=="/")
          outp+="  AddExit(\"suedwesten\",\"./"+((x+2)/2)+"x"+((y-2)/2)+"y\");\n";

        if(x<(strlen(lines[x])-1) && y<(sizeof(lines)-1) && lines[x+1][y+1..y+1]=="\\")
          outp+="  AddExit(\"suedosten\",\"./"+((x+2)/2)+"x"+((y+2)/2)+"y\");\n";

        outp += "\n}\n";
        write_file(ROOMPATH+(x/2)+"x"+(y/2)+"y.lpc", outp);
      }
    }
  }
  return 1;
}
