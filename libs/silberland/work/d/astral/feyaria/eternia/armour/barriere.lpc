// Barriere der Elemente
// Feyaria@SilberLand

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Die Barriere der Elemente");
  SetProp(P_LONG, 
    "Dieser Schild wurde aus den sechs Elementen gefertigt und bietet einen "
    "perfekten Schutz gegen alle elementaren Angriffe.");
  SetProp(P_NAME, ({"Barriere der Elemente",
                    "Barriere der Elemente",
                    "Barriere der Elemente",
                    "Barriere der Elemente"}) );
  SetProp(P_GENDER, FEMALE);
  AddId (({"barriere", "\neternia_item", "barriere der elemente", 
        "bariere elemente"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_FIRE: 15, MAT_EARTH: 15, MAT_WATER: 15, 
           MAT_ICE: 15, MAT_AIR: 15, MAT_HUMUS: 15, MAT_MAGIC: 10 ]) );
  SetProp(P_WEIGHT, 1900);
  SetProp(P_VALUE, 15000);
  SetProp(P_MAGIC, 12);
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_EFFECTIVE_WC, 200);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 4, T_HEAT_PROT: 4]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 70]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 9, P_SP: 9]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + 
      ([DT_FIRE: 1, DT_COLD: 1, DT_WATER: 1, DT_POISON: 1, 
        DT_AIR:1, DT_MAGIC: 1]) );
  SetProp(P_WEAR_FUNC, this_object() );
  SetProp(P_REMOVE_FUNC, this_object() );
  SetProp(P_NEVERDROP, 1);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([
        DT_FIRE:-0.05, DT_COLD:-0.05, DT_WATER:-0.05, 
        DT_POISON:-0.05, DT_AIR:-0.05, DT_MAGIC:-0.05]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, Name(WER,1) + " glueht auf und heilt Dich!\n");
    wer->heal_self(444);
  }
}
