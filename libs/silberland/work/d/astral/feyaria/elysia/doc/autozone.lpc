inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

string DESCPATH = "/d/huegelland/feyaria/elysia/doc/";
string ROOMPATH = "/d/huegelland/feyaria/elysia/room/";

void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Der Autozonengenerator" );
   SetProp(P_INT_LONG, "Nicht viel hier.");

   AddCmd( "zmake","do_read_map" );
}

int do_read_map(string path) 
{
  string err;
  string result;
  string *lines;
  string outp;
  int x,y;
  x=0;
  y=0;
  outp="";

  err = catch(result = read_file(path));
  if (err) {
    write(path + ": " + err + ".\n");
    return -1;
  }

  lines=explode(result,"\n");

  for (x=0;x<sizeof(lines);x++) 
  {
    for (y=0;y<=strlen(lines[x]);y++) 
    {
      outp="";
      outp+="/* Der heilige Garten von Elysia\n";
      outp+="** "+(x/2)+"x"+(y/2)+"y.lpc";
      outp+="  [created using autozne map converter 0.1 (c) Lamuerte]\n";
      outp+="** "+dtime()+" Feyaria@SilberLand\n";
      outp+="*/\n";
      outp+=read_file(DESCPATH+"room.desc");
      if(member(({"A", "B", "C", "D", "E", "F", "G", "H", "I", "J"}), (lines[x][y..y])) != -1) 
      {
        outp+="inherit ROOM \""+(lines[x][y..y])+"_inh\";\n";
        outp+=read_file(DESCPATH+"room.desc2");
        if(x>1 && lines[x-1][y..y]=="|")
          outp+="  AddExit(\"norden\",\"./room"+(-7+(x-2)/2)+"x"+(-7+y/2)+"y\");\n";

        if(x<(strlen(lines[x])-1) && lines[x+1][y..y]=="|")
          outp+="  AddExit(\"sueden\",\"./room"+(-7+(x+2)/2)+"x"+(-7+y/2)+"y\");\n";

        if(y>1 && lines[x][y-1..y-1]=="-")
          outp+="  AddExit(\"westen\",\"./room"+(-7+x/2)+"x"+(-7+(y-2)/2)+"y\");\n";

        if(y<(sizeof(lines)-1) && lines[x][y+1..y+1]=="-")
          outp+="  AddExit(\"osten\",\"./room"+(-7+x/2)+"x"+(-7+(y+2)/2)+"y\");\n";

        if(x>1 && y>1 && lines[x-1][y-1..y-1]=="\\")
          outp+="  AddExit(\"nordwesten\",\"./room"+(-7+(x-2)/2)+"x"+(-7+(y-2)/2)+"y\");\n";

        if(x>1 && y<(sizeof(lines)-1) && lines[x-1][y+1..y+1]=="/")
          outp+="  AddExit(\"nordosten\",\"./room"+(-7+(x-2)/2)+"x"+(-7+(y+2)/2)+"y\");\n";

        if(x<(strlen(lines[x])-1) && y>1 && lines[x+1][y-1..y-1]=="/")
          outp+="  AddExit(\"suedwesten\",\"./room"+(-7+(x+2)/2)+"x"+(-7+(y-2)/2)+"y\");\n";

        if(x<(strlen(lines[x])-1) && y<(sizeof(lines)-1) && lines[x+1][y+1..y+1]=="\\")
          outp+="  AddExit(\"suedosten\",\"./room"+(-7+(x+2)/2)+"x"+(-7+(y+2)/2)+"y\");\n";

        outp += "\n}\n";
        write_file(ROOMPATH+"room"+(-7+x/2)+"x"+(-7+y/2)+"y.lpc", outp);
      }
    }
  }
  return 1;
}
