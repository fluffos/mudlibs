#include "../def.h"

inherit NPC "std_elysia_npc";
inherit "std/npc/spells";

void create()
{
  int i;
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Die Tugend der Tapferkeit");
  SetProp(P_LONG, 
      "Vor Dir steht eine grosse weibliche Gestalt, gekleidet in eine "
      "glaenzende Ruestung. Sie hat einen stolzen Blick und schaut sehr "
      "mutig und tapfer aus, richtig tugendhaft. Scheinbar ist das die "
      "Verkoerperung der Tugend der Tapferkeit. Sie laechelt Dich froehlich "
      "an, Du fuehlst Dich gleich viel tapferer.");
  SetProp(P_NAME, "Tapferkeit");
  SetProp(P_ARTICLE, 0);
  SetProp(P_KILL_NAME, "Zu wenig Tapferkeit");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tugend","tapferkeit"}) );

  create_default_npc(50, 7000);
  SetProp(P_HANDS, ({" mit Tapferkeit",QueryProp(P_HANDS)[1], 
        ({DT_TERROR, DT_BLUDGEON}) }));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Tugend");
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: -1, DT_UNHOLY: 0.1, DT_LIGHT: -1, DT_MIND:-1, DT_MAGIC:-1,
        DT_TERROR: -1]) );

  SetProp(P_SIZE, 250);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " stirbt tugendhaft.\n");
  SetProp(P_KILL_MSG, "Zeige Deinen Mut!");
  SetProp(P_MURDER_MSG, "Sei auf ewig mit Feigheit bestraft, %s?");
  AddInfo(DEFAULT_INFO, "sagt: Sei immer tapfer und mutig!\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_REJECT, ({ REJECT_KEEP, Name(WER,1) + 
        " bedankt sich hoeflich fuer diese Spende." }) );

  SetProp(P_SPELLRATE, 80);
  AddSpell(2, 800,
      Name(WER,1) + " prueft Deine Tapferkeit.\n",
      Name(WER,1) + " prueft @WESSEN Tapferkeit.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 1000, DS_SLOW,
      Name(WER,1) + " laesst Dich stramm stehen.\n",
      Name(WER,1) + " laesst @WEN stramm stehen.\n");
  AddDefaultSpell(1, 700, DS_MASS_DAMAGE,
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      ({DT_TERROR, DT_HOLY}));

  SetChats(2, ({
    "Du fuehlst Dich ploetzlich sehr tapfer.\n",
    "Der Tapfere ist immer mutig und laesst jede Vorsicht beiseite.\n"}) );

  SUID;
  if (random(100) < 40) CLONEME( "/p/armour/trousers/mithrilbeinlinge");
  if (random(100) < 40) CLONEME( "/p/armour/bracers/mithrilarmschienen");
  if (random(100) < 40) CLONEME( "/p/armour/armour/mithrilpanzer");
  if (random(100) < 40) CLONEME( "/p/armour/helm/mithrilhelm");
  for(i=0;i<4;i++)
  {
    if (ob = present(({"panzer","helm","armschienen","beinlinge"})[i]))
    {
      ob->SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(7), P_SP:3+random(7)]) );
      ob->SetProp(P_AC, ob->QueryProp(P_AC) + 1);
      ob->SetProp(P_QUALITY_DECAY, ob->QueryProp(P_QUALITY_DECAY)+100+random(100));
      ob->AddAdjective(({"tugendhaft", "tugendhafter", "tugendhafte", "tugendhaften"}));
      ob->SetProp(P_NAME_ADJ, ({"tugendhaft"}));
      ob->SetProp(P_SHORT, ob->Name() + " der Tapferkeit");
      ob->SetProp(P_DAM_PROTECTION, ob->QueryProp(P_DAM_PROTECTION) + ([DT_TERROR:1]) );
      ob->SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
    }
  }

  command("trage alles");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object ob;
  if (ob = find_living("elysia_golem"))
  {
    tell_object(enemy, ob->Name(WER) + " beschuetzt die Tugend der Tapferkeit.\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  if (!interactive(enemy))
    return ::Defend(dam / 2, dam_type, spell, enemy);
  if (enemy->QueryProp(P_WIMPY) != 0)
  {
    tell_object(enemy, Name(WER) + " sagt: Du bist nicht tapfer genug!\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  enemy->SetProp(P_ELYSIA_ENEMY, time() + 60 * 180);
  return ::Defend(dam, dam_type, spell, enemy);
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "tugend.kills",
      dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  killer->SetProp(P_ELYSIA_ENEMY, time() + 60 * 60 * 24);
  ELYSIAMASTER->dead_tugend(lower_case(QueryProp(P_NAME)));

  if(killer->QueryProp(P_GUILD) == "bardengilde" && !mappingp(killer->QuerySkill("der alte pakt"))  && !mappingp(killer->QuerySkill("requiem der traeume")) && 
  !mappingp(killer->QuerySkill("zug der tausend oger")) && !mappingp(killer->QuerySkill("lied der lieder"))) {
   killer->SetProp("barden_tugend", "tapferkeit");
   tell_object(killer, BS("Du wirst ganz und gar von der Essenz der Tapferkeit erfuellt."));
}

  ::die(poisondeath);
}         

