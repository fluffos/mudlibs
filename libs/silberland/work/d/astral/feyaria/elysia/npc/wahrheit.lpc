#include "../def.h"

inherit NPC "std_elysia_npc";
inherit "std/npc/spells";

void create()
{
  int i;
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Die Tugend der Wahrheit");
  SetProp(P_LONG, 
      "Vor Dir steht eine eindrucksvolle weibliche Gestalt, gekleidet in eine "
      "glaenzende Ruestung. Sie haelt eine Waage in der erhobenen Hand und "
      "schaut sehr gerecht aus, richtig tugendhaft. Scheinbar ist das die "
      "Verkoerperung der Tugend der Wahrheit. Sie laechelt Dich freundlich "
      "an, Du fuehlst Dich gleich viel gerechter.");
  SetProp(P_NAME, "Wahrheit");
  SetProp(P_ARTICLE, 0);
  SetProp(P_KILL_NAME, "Zu wenig Wahrheit");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tugend","wahrheit"}) );

  create_default_npc(50, 4000);
  SetProp(P_HANDS, ({" mit der Macht der Gerechtigkeit",QueryProp(P_HANDS)[1], 
        ({DT_COLD, DT_BLUDGEON}) }));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Tugend");
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: -1, DT_UNHOLY: 0.1, DT_LIGHT: -1, DT_MIND:-1, DT_MAGIC:-1]) );

  SetProp(P_SIZE, 250);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " stirbt tugendhaft.\n");
  SetProp(P_KILL_MSG, "Das ist wahre Gerechtigekit!");
  SetProp(P_MURDER_MSG, "Sei auf ewig mit Luege bestraft, %s?");
  AddInfo(DEFAULT_INFO, "sagt: Sei immer gerecht!\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_REJECT, ({ REJECT_KEEP, Name(WER,1) + 
        " bedankt sich hoeflich fuer diese Spende." }) );

  SetProp(P_SPELLRATE, 80);
  AddSpell(5, 800,
      Name(WER,1) + " zeigt Dir Wahrheit und Gerechtigkeit.\n",
      Name(WER,1) + " zeigt @WEM Wahrheit und Gerechtigkeit.\n",
      DT_COLD, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 500, DS_MASS_BLIND,
      "Wahre Gerchttigkeit ist blind!\n",
      "Wahre Gerchttigkeit ist blind!\n",
      3);
  AddDefaultSpell(1, 700, DS_MASS_DAMAGE,
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      ({DT_COLD, DT_HOLY}));

  SetChats(2, ({
    "Du fuehlst Dich ploetzlich sehr gerecht.\n",
    "Um die Wahrheit zu finden, darfst Du Dich nicht selbst veraendern.\n"}) );

  SUID;
  if (random(100) < 40) CLONEME( "/p/armour/trousers/mithrilbeinlinge");
  if (random(100) < 40) CLONEME( "/p/armour/bracers/mithrilarmschienen");
  if (random(100) < 40) CLONEME( "/p/armour/armour/mithrilpanzer");
  if (random(100) < 40) CLONEME( "/p/armour/helm/mithrilhelm");
  for(i=0;i<4;i++)
  {
    if (ob = present(({"panzer","helm","armschienen","beinlinge"})[i]))
    {
      ob->SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(7), P_SP:3+random(7)]) );
      ob->SetProp(P_AC, ob->QueryProp(P_AC) + 1);
      ob->SetProp(P_QUALITY_DECAY, ob->QueryProp(P_QUALITY_DECAY)+100+random(100));
      ob->AddAdjective(({"tugendhaft", "tugendhafter", "tugendhafte", "tugendhaften"}));
      ob->SetProp(P_NAME_ADJ, ({"tugendhaft"}));
      ob->SetProp(P_SHORT, ob->Name() + " der Wahrheit");
      ob->SetProp(P_DAM_PROTECTION, ob->QueryProp(P_DAM_PROTECTION) + ([DT_COLD:1]) );
      ob->SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
    }
  }

  command("trage alles");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object ob;
  object *things;
  if (ob = find_living("elysia_golem"))
  {
    tell_object(enemy, ob->Name(WER) + " beschuetzt die Tugend der Wahrheit.\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  if (!interactive(enemy))
    return ::Defend(dam / 2, dam_type, spell, enemy);
  things = enemy->QueryProp(P_ARMOURS) + 
    (enemy->QueryProp(P_WEAPON) ? ({enemy->QueryProp(P_WEAPON)}) : ({}));
  if (sizeof(filter_array(things,
          lambda( ({'a}), ({#'call_other, 'a, "QueryProp", P_M_HEALTH_MOD}) ))))
  {
    tell_object(enemy, Name(WER) + " sagt: Du bist nicht Dein wahres Ich!\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  enemy->SetProp(P_ELYSIA_ENEMY, time() + 60 * 180);
  return ::Defend(dam, dam_type, spell, enemy);
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "tugend.kills",
      dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  killer->SetProp(P_ELYSIA_ENEMY, time() + 60 * 60 * 24);
  ELYSIAMASTER->dead_tugend(lower_case(QueryProp(P_NAME)));
  ::die(poisondeath);
}         

