#include "../def.h"

inherit NPC "std_elysia_npc";

string idblum;

void create()
{
  int    stufe;
  string ltext, idtext;

  if (!is_clone(this_object())) return;
  ::create();

  ltext  = "Ein durchscheinendes, kleines Wesen, das durch den Garten "
           "schwebt. In seinem Inneren, pulsierend wie ein Herz, ";

  switch(1 + random(45))
  {
    case 1..3:
      ltext += "ein winziges Gaensebluemchen.";
      idtext = "gaensebluemchengeist";
      idblum = "gaensebluemchen";
      stufe  = 2;
      break;

    case 4..6:
      ltext += "eine winzige Sternblume.";
      idtext = "sternblumengeist";
      idblum = "sternblume";
      stufe  = 2;
      break;

    case 7..9:
      ltext += "ein winziges Vergissmeinnicht.";
      idtext = "vergissmeinnichtgeist";
      idblum = "vergissmeinnicht";
      stufe  = 3;
      break;

    case 10..12:
      ltext += "eine winzige Kornblume.";
      idtext = "kornblumengeist";
      idblum = "kornblume";
      stufe  = 3;
      break;

    case 13..15:
      ltext += "ein winziges Veilchen.";
      idtext = "veilchengeist";
      idblum = "veilchen";
      stufe  = 4;
      break;

    case 16..18:
      ltext += "ein winziges Schneegloeckchen.";
      idtext = "schneegloeckchengeist";
      idblum = "schneegloeckchen";
      stufe  = 4;
      break;

    case 19..21:
      ltext += "ein kleiner Loewenzahn.";
      idtext = "loewenzahngeist";
      idblum = "loewenzahn";
      stufe  = 5;
      break;

    case 22..24:
      ltext += "eine kleine Butterblume.";
      idtext = "butterblumengeist";
      idblum = "butterblume";
      stufe  = 5;
      break;

    case 25..28:
      ltext += "eine kleine Schluesselblume.";
      idtext = "schluesselblumengeist";
      idblum = "schluesselblume";
      stufe  = 6;
      break;

    case 29..31:
      ltext += "eine kleine Glockenblume. ";
      idtext = "glockenblumengeist";
      idblum = "glockenblume";
      stufe  = 7;
      break;

    case 32..33:
      ltext += "ein Hahnenfuss.";
      idtext = "hahnenfussgeist";
      idblum = "hahnenfuss";
      stufe  = 8;
      break;

    case 34..36:
      ltext += "eine Margerite.";
      idtext = "margeritengeist";
      idblum = "margerite";
      stufe  = 9;
      break;

    case 37..38:
      ltext += "ein Enzian.";
      idtext = "enziangeist";
      idblum = "enzian";
      stufe  = 10;
      break;

    case 39..40:
      ltext += "eine gelb-orange Tulpe.";
      idtext = "tulpengeist";
      idblum = "tulpe";
      stufe = 11;
      break;

    case 41..42:
      ltext += "eine weisse Lilie.";
      idtext = "liliengeist";
      idblum = "lilie";
      stufe  = 12;
    break;

    case 43..44:
      ltext += "eine blutrote Rose.";
      idtext = "rosengeist";
      idblum = "rose";
      stufe  = 13;
    break;

    case 45:
      ltext += "eine leuchtende, violett-gelbe Orchidee.";
      idtext = "orchideengeist";
      idblum = "orchidee";
      stufe  = 14;
      break;

    default:
      break;
  }

  SetProp(P_SHORT, "Ein "+CAP(idtext));
  SetProp(P_LONG, ltext);
  SetProp(P_NAME, CAP(idtext));

  SetProp(P_GENDER, MALE);
  AddId( ({"geist","blumengeist",idtext}) );

  create_default_npc(stufe);
  SetProp(P_HANDS, ({" mit etwas, das wie Haende aussieht,",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_ALIGN, 450 + (20 + random(20)) * stufe);
  SetProp(P_RACE, "Blumengeist");
  SetProp(P_NOCORPSE, 1);

  SetProp(P_SIZE, stufe*10);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "schwebt um Dich herum");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt");
  SetProp(P_MMSGOUT, "schwebt hinfort");

  SetProp(P_DIE_MSG,  " verpufft lautlos.\n");
  AddInfo(DEFAULT_INFO, "scheint Dich nicht hoeren zu koennen.\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS |
                         MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({ 90, 90, 30 }) );

  SetProp(P_REJECT, ({ REJECT_DROP, "" }) );

}

void die(int poisondeath)
{
  object ob;

  ob = clone_object(BLUMENHERZ);
  if (ob)
  {
    ob->move(TO,M_NOCHECK|M_SILENT);
    ob->Customize(idblum);
  }
  ::die( poisondeath);
}

