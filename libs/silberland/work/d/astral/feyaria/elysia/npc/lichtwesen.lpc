#include "../def.h"

inherit NPC "std_elysia_npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Lichtwesen");
  SetProp(P_LONG, 
      "Dieses Wesen scheint nur aus Licht zu bestehen. Es hat die Form einer "
      "Kugel und schwebt mitten in der Luft. Es leuchtet sehr hell, und "
      "pulsiert in allen moeglichen Farben.");
  SetProp(P_NAME, "Lichtwesen");

  SetProp(P_GENDER, NEUTER);
  AddId( ({"wesen","lichtwesen"}) );

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit einem Lichtstrahl",QueryProp(P_HANDS)[1],
                     DT_LIGHT}));
  SetProp(P_ALIGN, 500 + random(400));
  SetProp(P_RACE, "Geist");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: -1, DT_UNHOLY: 0.1, DT_LIGHT: -1, DT_MIND:-1, DT_MAGIC:-1]) );

  SetProp(P_SIZE, 50);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_LIGHT, 3);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt");
  SetProp(P_MMSGOUT, "schwebt hinfort");

  SetProp(P_DIE_MSG,  " erloescht.\n");
  SetProp(P_KILL_MSG, "Das Licht siegt immer ueber die Dunkelheit");
  SetProp(P_MURDER_MSG, "Dir wird noch ein Licht aufgehen, %s!");
  AddInfo(DEFAULT_INFO, "scheint Dich nicht hoeren zu koennen.\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS |
                         MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({ 90, 90, 30 }) );

  SetProp(P_REJECT, ({ REJECT_DROP, "" }) );

  SetProp(P_SPELLRATE, 60);
  AddDefaultSpell(1, 500, DS_BLIND,
      "Das Lichtwesen blendet Dich.\n",
      "Das Lichtwesen blendet @WEN.\n",
      4);
  AddSpell(7, 500,
      "Das Lichtwesen versucht Dich zu blenden.\n",
      "Das Lichtwesen versucht @WEN zu blenden.\n",
      DT_LIGHT, ([SP_SHOW_DAMAGE:1]));

  SetProp(P_TRANSPARENT, 0);
  PEARLMASTER->DistributePearl(1,2,1,1);
}

