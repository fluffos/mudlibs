#include "../def.h"

inherit NPC "std_elysia_npc";
inherit "std/npc/spells";

void create()
{
  int i;
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Elysia, die Verkoerperung aller Tugenden");
  SetProp(P_LONG, 
      "Vor Dir steht eine wunderschoene weibliche Gestalt, sie strahlt "
      "eine solche Tugendhaftigkeit aus, dass Du Deinen Blick nicht mehr "
      "abwenden kannst. Wie sie wirklich aussieht, kannst Du kaum "
      "beschreiben, Du fuehlst vielmehr nur ihre Aura, die so viel "
      "Guete und Waerme ausstrahlt, wie Du es niemals fuer moeglich "
      "gehalten hast. Sicher handelt es sich hier um die Verkoerperung "
      "alles Tugenden.");
  SetProp(P_NAME, "Elysia");
  SetProp(P_ARTICLE, 0);
  SetProp(P_KILL_NAME, "Kein Vertrauen in die Tugenden");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"elysia", "tugend"}) );

  create_default_npc(70, 10000);
  SetProp(P_HANDS, ({" mit der Macht der Tugend", 777, ({DT_HOLY}) }));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Tugend");
  SetProp(P_REMOVE_RESET, 1);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_FIRE:-0.2, DT_AIR: -0.2, DT_POISON: -0.5, DT_HOLY: -1, DT_UNHOLY: 0.1,
        DT_COLD:-0.5, DT_WATER: -0.3, DT_EXPLOSION: -0.1, DT_TERROR: -0.1, DT_ACID: -0.2,
        DT_SOUND: -0.1, DT_LIGHT: -1, DT_MIND:-1, DT_MAGIC:-1, DT_ELECTRIC:-0.1]) );

  SetProp(P_SIZE, 250);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " stirbt tugendhaft.\n");
  SetProp(P_KILL_MSG, "Zeige Deine Tugend!");
  SetProp(P_MURDER_MSG, "Wie kannst Du nur jede Tugend aus der Welt "
      "verbannen, %s?");
  AddInfo(DEFAULT_INFO, "laechelt Dich liebevoll an!\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room0x0y");
  SetProp(P_MNPC_WAIT, ({ 60, 60, 60 }) );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_REJECT, ({ REJECT_KEEP, Name(WER,1) + 
        " bedankt sich hoeflich fuer diese schoene Spende." }) );

  SetProp(P_SPELLRATE, 100);
  AddSpell(1, 2000, 
      Name(WER,1) + " testet Deine Tugend!\n",
      Name(WER,1) + " testet @WESSEN Tugend!\n",
      ({DT_LIGHT, DT_FIRE, DT_LIGHTNING, DT_TERROR, DT_WATER, DT_COLD, 
       DT_AIR, DT_HOLY, DT_MAGIC}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 1000, DS_BLIND,
      Name(WER,1) + " testet Deine Liebe!\n",
      Name(WER,1) + " testet @WESSEN Liebe!\n");
  AddDefaultSpell(1, 1000, DS_FEAR,
      Name(WER,1) + " testet Deine Tapferkeit!\n",
      Name(WER,1) + " testet @WESSEN Tapferkeit!\n");
  AddDefaultSpell(1, 1000, DS_PARALYZE,
      Name(WER,1) + " testet Deine Ehrfurcht!\n",
      Name(WER,1) + " testet @WESSEN Ehrfurcht!\n", 2);
  AddDefaultSpell(1, 1000, DS_FROG,
      Name(WER,1) + " testet Deine Bescheidenheit!\n",
      Name(WER,1) + " testet @WESSEN Bescheidenheit!\n");
  AddDefaultSpell(1, 1000, DS_POISON,
      Name(WER,1) + " testet Dein Mitleid!\n",
      Name(WER,1) + " testet @WESSEN Mitleid!\n");
  AddDefaultSpell(1, 1000, DS_DRAIN_MANA,
      Name(WER,1) + " testet Deine Wahrheit!\n",
      Name(WER,1) + " testet @WESSEN Wahrheit!\n");
  AddDefaultSpell(1, 1000, DS_SLOW,
      Name(WER,1) + " testet Deine Schoenheit!\n",
      Name(WER,1) + " testet @WESSEN Schoenheit!\n");
  AddDefaultSpell(1, 1000, DS_ANTIMAGIC,
      Name(WER,1) + " testet Dein Vertrauen!\n",
      Name(WER,1) + " testet @WESSEN Vertrauen!\n");
  AddDefaultSpell(3, 500, DS_MASS_DAMAGE,
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      ({DT_LIGHT, DT_FIRE, DT_LIGHTNING, DT_TERROR, DT_WATER, DT_COLD, 
       DT_AIR, DT_HOLY, DT_MAGIC}));
  AddSpell(4, 500,
      Name(WER,1) + " explodiert geradezu vor lauter Tugend.\n",
      Name(WER,1) + " explodiert geradezu vor lauter Tugend.\n",
      DT_EXPLOSION, "spell_explosion", ([SP_SHOW_DAMAGE: 1]));

  SUID;
}

void spell_explosion(object enemy, int damage, mixed dam_type)
{
  int x,y,z;
  object ob;

  x = -7 + random(15);
  y = -7 + random(15);

  if (ob = find_object(ROOM "room" + x + "x" + y + "y"))
    enemy->move(ob, M_GO, "weggeschleudert", "wird", "fliegt herein");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object ob;
  if (ob = find_living("elysia_golem"))
  {
    tell_object(enemy, ob->Name(WER) + " beschuetzt Elysia.\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  enemy->SetProp(P_ELYSIA_ENEMY, time() + 60 * 60 * 24);
  if (dam > 888) dam = 888;
  if (!interactive(enemy))
    return ::Defend(dam / 2, dam_type, spell, enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  if (killer && interactive(killer))
    ASTRALMASTER->AddFlag(getuid(killer), FLAG_ELYSIA);
  write_file( LOG "elysia.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  killer->SetProp(P_ELYSIA_ENEMY, time() + 60 * 60 * 24 * 3);
  ::die(poisondeath);
}

varargs int remove(int silent)
{
  if (!silent && is_clone(this_object()))
    ELYSIAMASTER->ZoneShout("\n\nElysia verschmilzt wieder mit ihrer Umgebung!\n\n\n");
  return ::remove(silent);
}

int _query_disable_attack() { return 0; }
int _query_disable_spells() { return 0; }
mixed _query_skill_attr() { return 0; }
int _query_poison() { return 0; }
int _query_frog() { return 0; }
int _query_blind() { return 0; }
int _query_align() { return 1000; }
