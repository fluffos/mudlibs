#include "../def.h"

inherit NPC "std_elysia_npc";
inherit "std/npc/spells";

void create()
{
  int i;
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Die Tugend des Vertrauens");
  SetProp(P_LONG, 
      "Vor Dir steht eine nette weibliche Gestalt, gekleidet in einfaches "
      "Leder. Sie hat einen netten Blick und schaut sehr "
      "vertrauensselig aus, richtig tugendhaft. Scheinbar ist das die "
      "Verkoerperung der Tugend des Vertrauens. Sie laechelt Dich "
      "freundlich an, Du hast richtig Vertrauen zu ihr.");
  SetProp(P_NAME, "Vertrauen");
  SetProp(P_ARTICLE, 0);
  SetProp(P_KILL_NAME, "Zu wenig Vertrauen");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tugend","vertrauen"}) );

  create_default_npc(50, 4000);
  SetProp(P_HANDS, ({" mit Vertrauen",QueryProp(P_HANDS)[1], 
        ({DT_BLUDGEON, DT_WATER}) }));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Tugend");
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: -1, DT_UNHOLY: 0.1, DT_LIGHT: -1, DT_MIND:-1, DT_MAGIC:-1]) );

  SetProp(P_SIZE, 250);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " stirbt tugendhaft.\n");
  SetProp(P_KILL_MSG, "Zeige Dein Vertrauen!");
  SetProp(P_MURDER_MSG, "Sei auf ewig mit Misstrauen bestraft, %s?");
  AddInfo(DEFAULT_INFO, "sagt: Vertraue Deiner wahren Staerke.\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_REJECT, ({ REJECT_KEEP, Name(WER,1) + 
        " bedankt sich hoeflich fuer diese Spende." }) );

  SetProp(P_SPELLRATE, 80);
  AddSpell(6, 800,
      Name(WER,1) + " vertraut Dir gar nicht mehr.\n",
      Name(WER,1) + " vertraut @WEM gar nicht mehr.\n",
      DT_WATER, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 800, DS_PARALYZE,
      Name(WER,1) + " vertraut Dir ueberhaupt nicht mehr.\n",
      Name(WER,1) + " vertraut @WEM ueberhaupt nicht mehr.\n", 
      3);
  AddDefaultSpell(1, 700, DS_MASS_DAMAGE,
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      ({DT_WATER, DT_HOLY}));

  SetChats(2, ({
    "Dein Selbstvertrauen verstaerkt sich ungemein.\n",
    "Vertraue Deiner wahren Staerke.\n"}) );

  SUID;
  if (random(100) < 20) CLONEME( "/p/armour/trousers/lederhose");
  if (random(100) < 20) CLONEME( "/p/armour/bracers/lederarmschienen");
  if (random(100) < 20) CLONEME( "/p/armour/armour/lederruestung");
  if (random(100) < 20) CLONEME( "/p/armour/helm/lederhelm");
  if (random(100) < 20) CLONEME( "/p/armour/gloves/lederhandschuhe");
  if (random(100) < 20) CLONEME( "/p/armour/boots/lederschuhe");
  for (i = 0; i < 6; i++)
  {
    if (ob = present(({"ruestung","helm","armschienen","hose", "handschuhe", "schuhe"})[i]))
    {
      ob->SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(7), P_SP:3+random(7)]) );
      ob->SetProp(P_AC, ob->QueryProp(P_AC) * 2);
      ob->SetProp(P_QUALITY_DECAY, ob->QueryProp(P_QUALITY_DECAY)+100+random(100));
      ob->AddAdjective(({"tugendhaft", "tugendhafter", "tugendhafte", "tugendhaften"}));
      ob->SetProp(P_NAME_ADJ, ({"tugendhaft"}));
      ob->SetProp(P_SHORT, ob->Name() + " des Vertrauens");
      ob->SetProp(P_DAM_PROTECTION, ob->QueryProp(P_DAM_PROTECTION) + ([DT_WATER:1]) );
      ob->SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
    }
  }

  command("trage alles");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object ob;
  object *things;
  if (ob = find_living("elysia_golem"))
  {
    tell_object(enemy, ob->Name(WER) + " beschuetzt die Tugend des Vertrauens.\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  if (!interactive(enemy))
    return ::Defend(dam / 2, dam_type, spell, enemy);
  things = enemy->QueryProp(P_ARMOURS) + 
    (enemy->QueryProp(P_WEAPON) ? ({enemy->QueryProp(P_WEAPON)}) : ({}));
  if (sizeof(filter_array(things,
          lambda( ({'a}), ({#'call_other, 'a, "QueryProp", P_M_ATTR_MOD}) ))))
  {
    tell_object(enemy, Name(WER) + " sagt: Vertraue Deiner wahren Staerke!\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  enemy->SetProp(P_ELYSIA_ENEMY, time() + 60 * 180);
  return ::Defend(dam, dam_type, spell, enemy);
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "tugend.kills",
      dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  killer->SetProp(P_ELYSIA_ENEMY, time() + 60 * 60 * 24);
  ELYSIAMASTER->dead_tugend(lower_case(QueryProp(P_NAME)));

  if(killer->QueryProp(P_GUILD) == "bardengilde" && !mappingp(killer->QuerySkill("der alte pakt"))  && !mappingp(killer->QuerySkill("requiem der traeume")) && 
     !mappingp(killer->QuerySkill("zug der tausend oger")) && !mappingp(killer->QuerySkill("lied der lieder"))) {
      killer->SetProp("barden_tugend", "vertrauen");
      tell_object(killer, BS("Du wirst ganz und gar von der Essenz des Vertrauens erfuellt."));
  }

  ::die(poisondeath);
}         

