#include "../def.h"

inherit NPC "std_elysia_npc";
inherit "std/npc/spells";

void create()
{
  string adj;
  if (!is_clone(this_object())) return;

  ::create();

  adj = ({"klein", "winzig", "lieb", "quirlig", "suess"})[random(5)];
  SetProp(P_NAME, "Bluetenfee");
  SetProp(P_NAME_ADJ, adj);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,1) + " schwirrt hier zwischen den Blueten umher");
  SetProp(P_LONG, 
      "Eine Bluetenfee schwirrt hier zwischen den Blueten herum. Sie ist"
      "viel kleiner als andere Feen, man koennte sie fast mit einem riesigen "
      "Schmetterling verwechseln. Ihr Fluegel sind riesengross und sehen aus, "
      "wie die eines Schmetterlings. Genaue Details kannst Du nur schwer "
      "erkennen, weil sie so klein ist, allerdings entspricht alles, was "
      "Du erkennen kannst, dem Erscheinungsbild der groesseren Feen.");
  AddId( ({"fee","bluetenfee"}) );
  AddAdjective( ({adj, adj + "e", adj + "er", adj + "en"}) );
  SetProp(P_INFO, BS(
      "Die Bluetenfee scheint staerker zu sein, als man nach ihrer "
      "Groesse zu urteilen vermag. Sie traegt eine maechtige Magie in sich."));

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit ihren winzigen Haendchen,",QueryProp(P_HANDS)[1],
                     DT_MAGIC}));
  SetProp(P_ALIGN, 550 + random(450));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 20);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: -1, DT_UNHOLY: 0.1, DT_LIGHT: -1, DT_MIND:-1, DT_MAGIC:-1,
        DT_AIR:0.2, DT_TERROR:0.2]) );

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "teleportiert sich herein");
  SetProp(P_MMSGOUT, "teleportiert sich weg");

  SetProp(P_DIE_MSG,  " stoesst einen spitzen Schrei aus und stirbt.\n");
  SetProp(P_MURDER_MSG, "Und wer kuemmert sich jetzt um die vielen Blumen, %s?");
  AddInfo(DEFAULT_INFO, "sagt: @@random_info@@.\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS |
                         MOV_INFIGHT | MOV_MAYLOAD );
  SetProp(P_MNPC_WAIT, ({ 20, 10, 10 }) );

  SetProp(P_REJECT, ({ REJECT_DROP, "" }) );

  SetProp(P_SPELLRATE, 70);
  AddSpell(1, 1000,
      Name(WER,1) + " belegt Dich mit einem Feenzauber.\n",
      Name(WER,1) + " belegt @WEN mit einem Feenzauber.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(5, 400,
      Name(WER,1) + " verwirrt Dich mit Feenstaub.\n",
      Name(WER,1) + " verwirrt @WEN mit Feenstaub.\n",
      DT_MIND, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(3, 500, DS_ANTIMAGIC,
      Name(WER,1) + " umgibt Dich mit einer Antimagieaura.\n",
      Name(WER,1) + " umgibt @WEN mit einer Antimagieaura.\n",
      3);
  AddDefaultSpell(1, 300, DS_DRAIN_MANA,
      Name(WER,1) + " schwaecht Deine Magie.\n",
      Name(WER,1) + " schwaecht @WESSEN Magie.\n");

  SetProp(P_TRANSPARENT, 0);
  GEMMASTER->DistributeGem(1, 2, 1, 1, GEMARRAY);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if (!random(3) && !QueryProp(P_DISABLE_ATTACK))
  {
    tell_object(enemy, "  " + Name(WER,1) + " weicht geschickt aus.\n");
    return 0;
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

string random_info()
{
  string x;
  int i,j;
  string *abc;

  abc = ({"ala", "alo", "isi", "eth", "myth", "gor", "zik", "kol",
          "ful", "yib", "flapp", "loo", "mii", "re", "ju", "ro",
          "gamm", "tyr", "oth", "giz", "baa", "darra", "fero",
          "ovo", "atta", "cor", "nef", "do", "aar", "romi", "pyr"});
  x="";
  for(i=random(5)+random(3)+1; i>=0; i--)
  {
    for(j = !random(4)+random(2)+1; j>=0; j--)
    {
      x+=abc[random(sizeof(abc))];
    }
    x+=" ";
    if( strlen(x)>35) break;
  }
  return CAP(x[0..<2]);
}
