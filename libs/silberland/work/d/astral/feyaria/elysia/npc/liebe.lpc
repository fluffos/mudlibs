#include "../def.h"

inherit NPC "std_elysia_npc";
inherit "std/npc/spells";

void create()
{
  int i;
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Die Tugend der Liebe");
  SetProp(P_LONG, 
      "Vor Dir steht eine liebevolle weibliche Gestalt, gekleidet in "
      "feinste Seide. Sofort beginnt Dein Herz zu rasen, Du beginnst zu "
      "schwitzen - du bist sofort in sie verliebt. Das muss die "
      "Verkoerperung der Tugend der Liebe sein. Sie laechelt Dich "
      "bezaubernd an, Du kannst Dich vor lauter Zuneigung gar nicht "
      "mehr abwenden.");
  SetProp(P_NAME, "Liebe");
  SetProp(P_ARTICLE, 0);
  SetProp(P_KILL_NAME, "Zu wenig Liebe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tugend","liebe"}) );

  create_default_npc(50, 9000);
  SetProp(P_HANDS, ({" mit unglaublicher Liebe",QueryProp(P_HANDS)[1], 
        ({DT_BLUDGEON, DT_LIGHT}) }));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Tugend");
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_HOLY: -1, DT_UNHOLY: 0.1, DT_LIGHT: -1, DT_MIND:-1, DT_MAGIC:-1]) );

  SetProp(P_SIZE, 250);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " stirbt tugendhaft.\n");
  SetProp(P_KILL_MSG, "Das naechste zeige Deine Liebe!");
  SetProp(P_MURDER_MSG, "Sei mit ewigem Hass gestraft, %s?");
  AddInfo(DEFAULT_INFO, "laechelt Dich liebevoll an!\n");

  SetProp(P_MNPC_AREA, ({ ROOM }) );
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_REJECT, ({ REJECT_KEEP, Name(WER,1) + 
        " bedankt sich hoeflich fuer diese schoene Spende." }) );

  SetProp(P_SPELLRATE, 80);
  AddSpell(6, 800,
      Name(WER,1) + " erleuchtet Dich mit der wahren Liebe.\n",
      Name(WER,1) + " erleuchtet @WEN mit der wahren Liebe.\n",
      DT_LIGHT, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 500, DS_MASS_BLIND,
      "Liebe macht blind!\n",
      "Liebe macht blind!\n", 3);
  AddDefaultSpell(1, 700, DS_MASS_DAMAGE,
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      Name(WER,1) + " zeigt Dir die Macht der Tugend.\n",
      ({DT_LIGHT, DT_HOLY}));

  SetChats(2, ({
    "Du bist blind vor Liebe.\n",
    "Die Tugend der Liebe sagt: Blumen sind ein Zeichen der Liebe.\n"}) );

  SUID;
  if (random(100) < 25) CLONEME( "/p/armour/trousers/seidenhose");
  if (random(100) < 25) CLONEME( "/p/armour/armour/seidenjacke");
  if (random(100) < 25) CLONEME( "/p/armour/cloak/seidenumhang");
  if (random(100) < 25) CLONEME( "/p/armour/gloves/seidenhandschuhe");
  if (random(100) < 25) CLONEME( "/p/armour/boots/seidenschuhe");
  for (i = 0; i < 5; i++)
  {
    if (ob = present(({"jacke","umhang","hose", "handschuhe", "schuhe"})[i]))
    {
      ob->SetProp(P_M_HEALTH_MOD, ([P_HP:3+random(7), P_SP:3+random(7)]) );
      ob->SetProp(P_AC, ob->QueryProp(P_AC) * 4);
      ob->SetProp(P_QUALITY_DECAY, ob->QueryProp(P_QUALITY_DECAY)+100+random(100));
      ob->AddAdjective(({"tugendhaft", "tugendhafter", "tugendhafte", "tugendhaften"}));
      ob->SetProp(P_NAME_ADJ, ({"tugendhaft"}));
      ob->SetProp(P_SHORT, ob->Name() + " der Liebe");
      ob->SetProp(P_DAM_PROTECTION, ob->QueryProp(P_DAM_PROTECTION) + ([DT_FIRE:1]) );
      ob->SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
    }
  }

  command("trage alles");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object ob;
  if (ob = find_living("elysia_golem"))
  {
    tell_object(enemy, ob->Name(WER) + " beschuetzt die Tugend der Liebe.\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  if (!interactive(enemy))
    return ::Defend(dam / 2, dam_type, spell, enemy);
  if (!present("blume", enemy))
  {
    tell_object(enemy, Name(WER) + " sagt: Blumen sind ein Zeichen der Liebe!\n");
    enemy->StopHuntFor(this_object());
    StopHuntFor(enemy);
    return 0;
  }
  enemy->SetProp(P_ELYSIA_ENEMY, time() + 60 * 180);
  return ::Defend(dam, dam_type, spell, enemy);
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "tugend.kills",
      dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  killer->SetProp(P_ELYSIA_ENEMY, time() + 60 * 60 * 24);
  ELYSIAMASTER->dead_tugend(lower_case(QueryProp(P_NAME)));
  ::die(poisondeath);
}         

