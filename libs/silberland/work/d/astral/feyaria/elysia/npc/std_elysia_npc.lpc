// std-npc fuer elysia
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit STDNPC;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({"\nelysianpc"}) );
  SetProp(P_LOG_INFO, "feyaria/elysia");
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "room0x0y") );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_MAYLOAD + MOV_BACKWARDS);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:1000000]));

  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;
  if (((!sizeof(GetEnemies()) && QueryProp(P_REMOVE_RESET)) || 
      QueryProp(P_REMOVE_RESET) == 2) && (!id("golem") || !random(4)))
    call_out("deep_remove");
}

int Defend(int dam, string *dtype, int spell, object enemy)
{
  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (member(dtype, DT_HOLY) != -1)
  {
    ENV(TO)->Message(Name(WER,1) + " heilt sich durch den heiligen Angriff!\n", 
        MSGFLAG_VISUAL);
    heal_self(dam/10);
    return ::Defend(0, dtype, spell, enemy);
  }
  if (!interactive(enemy))
    return ::Defend(dam / 4, dtype, spell, enemy);
  return ::Defend(dam, dtype, spell, enemy);
}

varargs void create_default_npc(int level, int hp)
{
  if (hp)
    ::create_default_npc(level, hp);
  else
    ::create_default_npc(level);
  SetProp(P_XP, QueryProp(P_XP) * 5 / 4); // 25% XP-Bonus
}

void init()
{
  ::init();
  if (!TP)
    return;
  if (TP->id("\nelysianpc"))
    AddDefender(TP);
  else if (TP->QueryProp(P_ELYSIA_ENEMY) > time())
    Kill(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

