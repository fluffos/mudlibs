// std-leiche fuer elysia
// 05-10-2004  Feyaria@SilberLand

inherit "std/corpse";

#include "../def.h"

void create()
{
  object killer;
  object ob;
  object geld;
  int flag;

  if (!is_clone(TO)) return;
  ::create();

  SUID;
  if (!PO || PO->QueryProp("got_loot"))
    return;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object(1);
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "elysia", PO->QueryProp(P_LEVEL));

  PO->SetProp("got_loot", 1);
  if (PO->id("\nelysia"))
  {
    if (killer = ((object) PO->QueryProp(P_KILLER)) || this_player())
    {
      ASTRALMASTER->AddFlag(killer, FLAG_ELYSIA,
          filter_array(PO->PresentEnemies(), #'interactive));
      write_file( LOG "elysia.kills",
          dtime(time())+": "+CAP(getuid(killer))+" toetet "+PO->name(WEN)+".\n");
    }
    CLONE( ARMOUR "elysiakette", PO );
    BOSS_LOOT;
    ASTRALMASTER->SetTime("elysia");
  }
  if (PO->id("tugend"))
  {
    CLONELOG( OBJ "essenz", PO )
    CLONELOG( OBJ "essenz", PO )
  }
  flag = 0;
  if (PO->QueryProp(P_LEVEL) > 20)
  {
    if (!random(GOLEMGOVES_CHANCE))
      CLONELOG( ARMOUR "golemfaeustlinge", PO)
    if (!random(WSALBE_CHANCE))
      CLONELOG( WSALBE, PO )
    else if (!random(RSALBE_CHANCE))
      CLONELOG( RSALBE, PO )
    MAGIC_WANDS
    else if (!random(10))
      GEMMASTER->DistributeGem(2, 3, 1, PO, GEMARRAY);
    else if (!random(10))
      PEARLMASTER->DistributePearl(2, 3, 1, PO);
    else if (!random(ESSENZ_CHANCE))
      CLONELOG( OBJ "essenz", PO )
    else
      flag = 1;
  }
  else
    flag = 1;
  if (flag && PO->QueryProp(P_LEVEL) > random(25))
  {
    geld = clone_object("/obj/money");
    geld->AddAmount(random(PO->QueryProp(P_LEVEL) * MONEY_FACTOR));
    geld->move(PO, M_NOCHECK);
  }
}
