// heilige Handschuhe
// 16.10.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Golemfaeustlinge");
  SetProp(P_LONG, 
    "Eigentlich schauen diese Handschuhe mehr wie Steinbrocken aus, denn sie "
    "bestehen vollstaendig aus Stein, und zwar aus einer bunten Mischung "
    "verschiedener Gesteinssorten. Wenn man die Faeustlinge traegt, sieht "
    "es fast so aus, als ob man die Faeuste eines Golems haette.");
  SetProp(P_NAME, "Golemfaeustlinge");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"faeustlinge", "golemfaeustlinge", "\nelysiaruestung"}) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_GRANITE: 25, MAT_SLATE: 25, MAT_MARBLE: 25, 
                        MAT_MISC_STONE: 25]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1700);
  SetProp(P_MAGIC, 1);
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 3, T_HEAT_PROT: 0]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 1, P_SP: 1]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + 
      ([DT_UNHOLY: 1, DT_MAGIC: 1, DT_ACID: 1]) );
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 15);
  SUID;

  AddDetail( ({"gestein", "sorten", "gesteinssorten", "granit", "marmor", 
        "schiefer"}),
      "Unter anderem erkennst Du Granit, Marmor und Schiefer.");
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Golemhandschuhe huellen Dich in eine heilende Aura ein.\n");
    wer->heal_self(50 + random(50));
  }
}

