#include "../def.h"

inherit ROOM "std_room";

varargs create(string dir1, string dir2, string dir3) 
{
  ::create();

  SetProp(P_INT_LONG,
      "Du stehst auf einer Wegkreuzung. Ein schmaler Pfad fuehrt nach " + 
      CAP(dir1) + " und " + CAP(dir2) + " die Hecke entlang und ein Kiesweg "
      "fuehrt von der Hecke weg nach " + CAP(dir3) + " ins Zentrum von "
      "Elysia, dem heiligen Garten. Die Hecke ist so hoch, dass Du nicht "
      "sehen kannst, was sich dahinter verbirgt, in der anderen Richtung "
      "siehst Du allerdings ein wahres Blumenmeer.");

  AddDetail( ({"kiesweg", "weg", "zentrum"}),
      "Der Kiesweg fuehrt von der Hecke weg ins Zentrum von Elysia.");
  AddDetail( ({"boden"}),
      "Du stehst auf feinem Kies.");
  AddDetail( ({"kies"}),
      "Feiner Kies, wie auf allen Wegen hier in Elysia.");
  AddDetail( ({"feiner kies"}),
      "Wirklich sehr fein.");
  AddDetail( ({"richtung", dir3}),
      "In Richtung " + CAP(dir3) + " befindet sich ein wahres Blumenmeer.");
  AddDetail( ({"meer", "blumenmeer"}),
      "Du siehst ein richtiges Meer aus Blumen.");
  AddDetail( ({"blume", "blumen"}),
      "Die Blumen sind wunderschoen. Viele Insekten und Voegel fliegen von "
      "Blume zu Blume.");
  AddDetail( ({"insekt", "insekten"}),
      "Vor allem Bienen und Schmetterlinge.");
  AddDetail( ({"biene", "bienen"}),
      "Die Bienen schwirren um die Blumen herum.");
  AddDetail( ({"schmetterling", "schmetterlinge"}),
      "Die Schmetterlinge flattern um die Blumen herum.");
  AddDetail( ({"vogel", "voegel"}),
      "Die kleinen Voegel schwirren um die Blumen herum.");
  AddDetail( ({"pfad", dir1, dir2}),
      "Ein schmaler Pfad fuehrt die Hecke entlang, er windet sich nach " +
      CAP(dir1) + " und " + CAP(dir2) + ".");
  AddDetail( ({"hecke"}),
      "Die Hecke ist undurchdinglich, daher kannst Du nicht sehen, was sich "
      "dahinter befindet.");
  AddDetail( ({"kreuzung", "wegkreuzung"}),
      "Man nennt dies hier eine Kreuzung, weil sich der Weg und der Pfad "
      "hier begegnen.");
}

