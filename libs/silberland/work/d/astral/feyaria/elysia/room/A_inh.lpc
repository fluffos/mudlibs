#include "../def.h"

inherit "std/pub";

string read_liste();

void create() 
{
  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT|NO_TPORT_OUT|NO_TPORT_IN);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );
  SetProp(P_INT_SHORT, "In einem kleinen Pavillon im heiligen Garten von Elysia");
  SetProp(P_INT_LONG,
      "Du stehst mitten auf einer grossen Wegkreuzung im heiligen Garten von "
      "Elysia. In der Mitte befindet sich eine wunderschoene Statue und "
      "daneben ein kleiner Pavillon, wo Speisen und Getraenke ausgeschenkt "
      "werden. Die acht Wege fuehren sternfoermig in alle Richtungen, und ein "
      "kleines Portal scheint in den Nexus zu fuehren.");

  AddDetail( ({"boden"}),
      "Du stehst auf feinem Kies.");
  AddDetail( ({"kies"}),
      "Feiner Kies, wie auf allen Wegen hier in Elysia.");
  AddDetail( ({"feiner kies"}),
      "Wirklich sehr fein.");
  AddDetail( ({"weg", "wege", "kreuzung", "wegkreuzung"}),
      "Acht Wege fuehren sternfoermig in alle Himmelsrichtungen.");
  AddDetail( ({"himmelsrichtungen", "richtungen", "richtung", 
        "himmelsrichtung"}),
      "Norden, Sueden, Osten, Westen, Nordosten, Nordwesten, Suedosten und "
      "Suedwesten.");
  AddDetail( ({"norden", "sueden", "osten", "westen", "nordosten",
        "nordwesten", "suedosten", "suedwesten"}),
      "Eine Himmelsrichtung.");
  AddDetail( ({"stern", "form"}),
      "Diese Form haben die Wege, sehr aufmerksam!");
  AddDetail( ({"mitte"}),
      "Du bist in der Mitte der Wegkreuzung, fast koennte man das schon als "
      "kleinen Platz bezeichnen.");
  AddDetail( ({"platz"}),
      "Kein richtiger Platz, sondern hoechstens ein ....");
  AddDetail( ({"plaetzchen"}),
      "Richtig, 'Plaetzchen' ist eine gute Beschreibung.");
  AddDetail( ({"beschreibung"}),
      "Dieser Raum wurde mit aller Liebe zum Detail beschrieben.");
  AddDetail( ({"raum", "liebe", "detail", "detailliebe"}),
      "So weit geht die Detailliebe dann auch wieder nicht....");
  AddDetail( ({"pavillon"}),
      "In dem kleinen Pavillon gibt es Speisen und Getraenke.");
  AddSpecialDetail( ({"speisen", "speise", "getraenke", "getraenk"}),
     "det_menu");
  AddDetail( ({"portal", "nexus"}),
      "Das Portal ist wirklich sehr klein und unscheinbar, aber trotzdem "
      "bist Du Dir sicher, dass es in den Nexus fuehrt.");
  AddDetail( ({"garten"}),
      "Du befindest Dich im heiligen Garten von Elysia.");
  AddDetail( ({"himmel"}),
      "Der Himmel ist hellblau und sehr klar, allerdings bist Du Dir ganz "
      "sicher, dass das kein normaler Himmel ist, wie Du ihn aus normalen "
      "Gegenden kennst.");
  AddDetail( ({"gegend", "gegenden"}),
      "Normale Gegenden, Du weisst schon, was gemeint ist.");
  AddDetail( ({"statue", "elysia", "verkoerperung" }),
      "Die Statue stellt Elysia da, die Verkoerperung der absoluten Tugend. "
      "Sie ist als wunderschoene Frau mit einem friedlichen Laecheln "
      "dargestellt, die mit einer Toga bekleidet ist. Die Statue ist von "
      "einer heligen Aura umgeben.");
  AddDetail( ({"tugend", "tugendhaft"}),
      "Absolut!");
  AddDetail( ({"absolut"}),
      "Tugendhaft!");
  AddDetail( ({"laecheln", "laechelnd"}),
      "Friedlich.");
  AddDetail( ({"friedlich"}),
      "Laechelnd.");
  AddDetail( ({"frau"}),
      "Wunderschoen!");
  AddDetail( ({"wunderschoen"}),
      "Frau!");
  AddDetail( ({"toga", "kleidungsstueck", "koerper"}),
      "Ein um den Koerper geschlungenes Kleidungsstueck.");
  AddSpecialDetail( ({"aura"}), "det_aura");

  AddSound( ({DEFAULT_SOUND}),
      "Es ist angenehm ruhig hier.");
  AddSmell( ({DEFAULT_SMELL}),
      "Es riecht sehr angenehm hier.");

  AddDrink("Gemischter Gemuesesaft", ({"gemuese", "gemuesesaft", 
        "gemischerter gemuesesaft", "saft"}),
      222, 23, 0, 5,
      ({"Du bestellt ein Glaeschen gemischten Gemuesesaft und trinkst es mit "
       "gemischtem Gefuehl aus. Es hat auch wirklich einen sehr gemischten "
       "Geschmack.",
       "&& trinkt gemischten Gemuesesaft."}));

  AddDrink("Heiliger Alkohol", ({"alkohol", "heiliger alkohol"}),
      532,({65, 45, 11}), 11, 2,
      ({"Du bestellst heiligen Alkohol und fuehlst Dich heilig berauscht.",
       "&& trinkt heiligen Alkohol und verfaellt in heiligen Rausch."}) );

  AddFood ( "Gemischter Salatteller", 
      ({"teller", "salat", "salatteller", "gemischter salat"}),
      203, 21, 5,
      ({"Du bestellst einen gemischten Salatteller. Du bekommst einen Salat "
       "mit einer Mischung verschiedener Teller serviert. Du bist etwas "
       "verwirrt, isst aber trotzdem alles brav auf.",
       "&& isst einen gemischten Salatteller."}) );

  AddFood ( "Golemsteak in Sonnenblumenoel", 
      ({"steak", "golemsteak", "golemsteak in sonnenblumenoel"}),
      1103, ({71, 65, 35}), 19,
      ({"Du bestellst ein Golemsteak in Sonnenblumenoel. Es schmeckt "
       "steinig und sonnig??",
       "&& isst ein Golemsteak in Sonnenblumenoel."}) );

  AddExit("nexus", NEXUS);
  RemoveItem("/obj/topliste");
  AddDetail( ({"liste", "elysialiste", "topliste", "topelysialiste", 
        "top-elysialiste"}), #'read_liste);
  AddReadDetail( ({"liste", "elysialiste", "topliste", "topelysialiste", 
        "top-elysialiste"}), #'read_liste);
  SetProp(P_ZONE, "Elysia");
#include "../../where.h"  
}

string det_menu()
{
  TP->command_me("menue");
  return "";
}

string det_aura()
{
  if (ASTRALMASTER->QueryTime("elysia") < 0)
    return "Die Aura der Statue ist sehr stark.\n";
  else
    return "Die Aura der Statue ist momentan kaum zu spueren.\n";
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  return ::int_long(viewer, viewpoint, shortflag) +
    "Die Top-Elysialiste.\n";
}

string read_liste()
{
  write(
    "Die Liste der beruehmtesten Helden im heiligen Garten von Elysia\n"
    "----------------------------------------------------------------\n");
  ASTRALMASTER->FameList("elysia");
  return "";
}
