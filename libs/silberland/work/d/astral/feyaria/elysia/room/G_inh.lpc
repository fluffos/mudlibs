#include "../def.h"

inherit ROOM "std_room";

varargs create(string dir1, string dir2, string dir3) 
{
  ::create();

  SetProp(P_INT_LONG,
      "Du bist im heiligen Garten von Elysia und befindest Dich auf einem "
      "breiten Wiesenweg, der sich entlang einer hohen Hecke von " + 
      CAP(dir1) + " nach " + CAP(dir2) + " dahinschlaengelt. Im " + 
      CAP(dir3) + " befindet sich ein Durchgang durch die Hecke, "
      "allerdings ist dieser so schmal, dass man nicht hindurchsehen kann.");

  AddDetail( ({"boden", "wiesenboden"}),
      "Du stehst auf einem Wiesenboden.");
  AddDetail( ({"weg", "wiesenweg"}),
      "Der Wiesenweg ist realtiv breit und schlaengelt sich von " + CAP(dir1) +
      " nach " + CAP(dir2) + ".");
  AddDetail( ({"durchgang"}),
      "Im " + CAP(dir3) + " befindet sich ein Durchgang durch die Hecke.");
  AddDetail( ({"hecke"}),
      "Die Hecke ist zu hoch, um darueber hinwegzublicken, und auch durch "
      "den Durchgang im " + CAP(dir3) + " kannst Du nicht sehen, was sich "
      "dahinter befindet.");
}

