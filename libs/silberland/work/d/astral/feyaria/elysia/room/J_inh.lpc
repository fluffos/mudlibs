#include "../def.h"

inherit ROOM "std_room";

void create() 
{
  ::create();
  SetProp(P_INT_LONG,
      "Du befindest Dich in einer kleinen Nische in einer gewaltig hohen "
      "Hecke im heiligen Garten von Elysia. Die Ausstrahlung des Guten ist "
      "hier besonders stark, Du kannst sie direkt fuehlen. Dies muss ein "
      "wahrlich heiliger Platz sein. "
      "Der einzige Ausgang fuehrt zurueck auf den Wiesenweg.");

  AddDetail( ({"ausgang", "wiesenweg"}),
      "Der einzige Ausgang fuehrt zurueck auf den Wiesenweg.");
  AddDetail( ({"hecke"}),
      "Die Hecke ist sehr hoch und dicht, Du kannst nicht erkennen, "
      "was sich dahinter befindet.");
  AddDetail( ({"nische"}),
      "Du befindest Dich in einer kleinen Nische in einer gewaltig hohen "
      "Hecke.");
  AddDetail( ({"ausstrahlung"}),
      "Die Ausstrahlung des Guten ist hier besonders stark, Du kannst "
      "sie direkt fuehlen.");
  AddDetail( ({"platz"}),
      "Dieser Platz ist heilig, daran kann es keinen Zweifel geben.");
  AddDetail( ({"zweifel"}),
      "Keinen.");
  AddDetail( ({"boden", "wiesenboden"}),
      "Du stehst auf einem Wiesenboden.");
  AddDetail( ({"wiese", "rand"}),
      "Du stehst am Rand der Wiese, die sich hier bis in die Nische der Hecke "
      "ausbreitet.");

  AddCmd( "fuehl|fuehle&austrahlung|ausstrahlung|ausstrahlung guten|gute", 
      "cmd_fuehlen", "Was willst Du fuehlen?");
}

void init()
{
  ::init();
  ELYSIAMASTER->check_tugend();
}

int cmd_fuehlen(string str)
{
  write("Du kannst die Ausstrahlung des Guten hier direkt fuehlen.\n");
  if (present("tugend"))
    write("Das ist auch kein Wunder, wenn eine leibhaftige Tugend hier ist.\n");
  return 1;
}
