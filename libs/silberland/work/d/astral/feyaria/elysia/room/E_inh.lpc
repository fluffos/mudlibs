#include "../def.h"

inherit ROOM "std_room";

varargs create(string dir1, string dir2, string dir3) 
{
  ::create();

  SetProp(P_INT_LONG,
      "Du stehst auf einem schmalen Pfad, der von " + CAP(dir1) + " nach " + 
      CAP(dir2) + " an einer hohen Hecke entlang fuehrt. Im " + CAP(dir3) + 
      " befindet sich ein Durchgang durch die Hecke, allerdings ist dieser so "
      "schmal, dass Du kaum durchsehen kannst.");

  AddDetail( ({"boden", "erde", "erdboden"}),
      "Du stehst auf fester Erde, also auf einem Erdboden.");
  AddDetail( ({"pfad", dir1, dir2}),
      "Ein schmaler Pfad fuehrt die Hecke entlang, er windet sich nach " +
      CAP(dir1) + " und " + CAP(dir2) + ".");
  AddDetail( ({"hecke"}),
      "In der Hecke befindet sich ein schmaler Durchgang.");
  AddDetail( ({"durchgang"}),
      "Der Durchgang fuehrt nach " + CAP(dir3) + ", allerdings ist er so "
      "schmal und lang, dass man nicht erkennen kann, wohin er fuehrt.");

}

