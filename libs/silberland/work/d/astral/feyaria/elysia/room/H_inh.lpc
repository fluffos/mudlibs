#include "../def.h"

inherit ROOM "std_room";

varargs create(string dir1, string dir2) 
{
  ::create();

  SetProp(P_INT_LONG,
      "Du bist inm heiligen Garten von Elysia und befindest Dich auf einem "
      "breiten Wiesenweg, der sich entlang einer hohen Hecke von " + 
      CAP(dir1) + " nach " + CAP(dir2) + " dahinschlaengelt. Auf der anderen "
      "Seite scheint sich die Wiese bis ins Unendliche auszudehnen, obwohl "
      "Du Dich mit keiner noch so grossen Anstrengung in diese Richtung "
      "bewegen kannst.");

  AddDetail( ({"boden", "wiesenboden"}),
      "Du stehst auf einem Wiesenboden.");
  AddDetail( ({"weg", "wiesenweg"}),
      "Der Wiesenweg ist realtiv breit und schlaengelt sich von " + CAP(dir1) +
      " nach " + CAP(dir2) + ".");
  AddDetail( ({"hecke"}),
      "Die Hecke ist zu hoch, um darueber hinwegzublicken, daher kannst Du "
      "nicht sehen, was sich dahinter verbirgt.");
  AddDetail( ({"seite"}),
      "Auf der anderen Seite scheint sich die Wiese bis ins Unendliche "
      "auszudehnen.");
  AddDetail( ({"wiese"}),
      "Eine saftige gruene Wiese, obwohl Dir das Gruen etwas seltsam "
      "vorkommt.");
  AddDetail( ({"gruen"}),
      "Ein solches Gruen hast Du noch nie gesehen. Es ist genauso unpassend "
      "fuer eine Wiese wie das Blau fuer den Himmel.");
  AddDetail( ({"unendlich", "unendliche", "unendlichkeit", "richtung"}),
      "Die Wiese scheint sich bis in die Unendlichkeit auszudehnen, "
      "allerdings kannst Du Dich mit keiner noch so grossen Anstrengung "
      "dorthin bewegen.");
  AddDetail( ({"anstrengung"}),
      "Du strengst Dich sehr an, aber Du kannst Dich nur in die Richtungen " +
      CAP(dir1) + " und " + CAP(dir2) + " bewegen.");
  AddDetail( ({"richtungen"}),
      CAP(dir1) + " und " + CAP(dir2) + ".");

  AddItem( ({NPC "golem", NPC "golem", NPC "lichtwesen", NPC "bluetenfee"}), 
      REFRESH_DESTRUCT, 
      ([P_MNPC_DEFAULTROOM: file_name(TO), 
        P_MNPC_AREA: ROOM,
        P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
        P_REMOVE_RESET: 1,
        P_CORPSE: OBJ "elysialeiche",
        P_HEAL: 200,
      ]) ); 
}

void init()
{
  ::init();
  if (find_call_out("load_rooms") == -1)
    call_out("load_rooms", 2);
}

void reset()
{
  ::reset();
  set_next_reset(2*60*60);
}
