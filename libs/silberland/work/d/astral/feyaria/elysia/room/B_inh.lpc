#include "../def.h"

inherit ROOM "std_room";

varargs create(string dir1, string dir2) 
{
  ::create();

  SetProp(P_INT_LONG, 
      "Du befindest Dich auf einem Kiesweg, der schnurgerade von " + 
      CAP(dir1) + " nach " + CAP(dir2) + " durch den heiligen Garten von "
      "Elysia fuehrt. Links und rechts davon befinden sich Beete mit "
      "wunderschoenen Blumen. Viele Insekten und kleine Voegel schwirren "
      "um die Blumen herum. Die friedliche Atmosphaere erquickt Deine Seele.");

  AddDetail( ({"kiesweg", "weg"}),
      "Du befindest Dich auf einem Kiesweg, der schnurgerade von " + 
      CAP(dir1) + " nach " + CAP(dir2) + " durch den heiligen Garten von "
      "Elysia fuehrt.");
  AddDetail( ({dir1, dir2}),
      "In diese Richtung fuehrt der Kiesweg.");
  AddDetail( ({"richtung", "richtungen"}),
      "Nach " + CAP(dir1) + " und  nach " + CAP(dir2) + ".");
  AddDetail( ({"boden"}),
      "Du stehst auf feinem Kies.");
  AddDetail( ({"kies"}),
      "Feiner Kies, wie auf allen Wegen hier in Elysia.");
  AddDetail( ({"feiner kies"}),
      "Wirklich sehr fein.");
  AddDetail( ({"beete", "beet", "blumenbeete", "blumenbeet"}),
      "Die Blumenbeete sind voller Blumen.");
  AddDetail( ({"blume", "blumen"}),
      "Die Blumen sind wunderschoen.");
  AddDetail( ({"insekt", "insekten"}),
      "Vor allem Bienen und Schmetterlinge.");
  AddDetail( ({"biene", "bienen"}),
      "Die Bienen schwirren um die Blumen herum.");
  AddDetail( ({"schmetterling", "schmetterlinge"}),
      "Die Schmetterlinge flattern um die Blumen herum.");
  AddDetail( ({"vogel", "voegel"}),
      "Die kleinen Voegel schwirren um die Blumen herum.");
  AddDetail( ({"atmosphaere"}),
      "Die Atmosphaere ist sehr friedlich hier.");
  AddDetail( ({"seele"}),
      "Deine Seele wird durch die friedliche Atmosphaere erquickt.");

  AddSound( ({DEFAULT_SOUND}),
      "Du hoerst das Piepen der Voegel.");
  AddSound( ({"vogel", "voegel", "piep", "piepen"}),
      "*piep*");
  AddSmell( ({DEFAULT_SMELL, "blume", "blumen"}),
      "Die Blumen riechen wunderbar.");

  AddItem( ({BIENE, KOLIBRI, SCHMETTERLING, 
        ROTKEHLCHEN, BLUETI, VANA, 
        NPC "blumengeist", NPC "lichtwesen", NPC "bluetenfee",
        }), 
      REFRESH_DESTRUCT,
      ([P_MNPC_DEFAULTROOM: file_name(TO), 
        P_MNPC_AREA: ROOM,
        P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
        P_CORPSE: OBJ "elysialeiche",
        P_HEAL: 20,
        ]) ); 
}

