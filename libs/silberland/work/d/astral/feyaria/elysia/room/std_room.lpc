#include "../def.h"

inherit STDROOM;

void create() 
{
  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_NO_TPORT, NO_TPORT_OUT);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );
  SetProp(P_INT_SHORT, "Der heilige Garten von Elysia");
  SetProp(P_INT_LONG, "Der heilige Garten von Elysia.");

  AddDetail( ({"garten"}),
      "Du befindest Dich im heiligen Garten von Elysia.");
  AddDetail( ({"elysia"}),
      "Elysia ist das Reich des Guten.");
  AddDetail( ({"reich", "gut", "gutes", "guten", "gute"}),
      "Das Gute wird durch die acht Tugenden verkoerpert.");
  AddDetail( ({"tugend", "tugenden"}),
      "Schoenheit, Liebe, Vertrauen, Mitleid, Wahrheit, "
      "Tapferkeit, Ehrfurcht und Bescheidenheit. ");
  AddDetail( ({"schoeneheit", "auge", "betrachter"}),
      "Schoenheit liegt im Auge des Betrachters.");
  AddDetail( ({"auge des betrachtees"}),
      "Das hat noch einen andere Bedeutung :)");
  AddDetail( ({"liebe", "welt"}),
      "Kannst Du Dir eine Welt ohne Liebe vorstellen?");
  AddDetail( ({"vertrauen", "kontrolle"}),
      "Vertrauen ist gut, Kontrolle ist besser.");
  AddDetail( ({"mitleid", "sorgen", "mitmenschen"}),
      "Das Mitleid gebietet Dir, Dich um die Sorgen Deiner Mitmenschen zu "
      "kuemmern.");
  AddDetail( ({"wahrheit", "gerechtigkeit"}),
      "Nur die Wahrheit fuehrt zu Gerechtigkeit.");
  AddDetail( ({"tapferkeit", "mut", "ueberzeugungen"}),
      "Tapferkeit ist der Mut, seinen inneren Ueberzeugungen treu zu bleiben.");
  AddDetail( ({"ehrfurcht", "respekt", "alten", "altes", "alter"}),
      "Ehrfurcht ist der Respekt vor dem Alten.");
  AddDetail( ({"bescheidenheit", "groesse"}),
      "An der Bescheidenheit erkennt man wahre Groesse.");
  AddDetail( ({"himmel"}),
      "Der Himmel ist hellblau und sehr klar, allerdings bist Du Dir ganz "
      "sicher, dass das kein normaler Himmel ist, wie Du ihn aus normalen "
      "Gegenden kennst, denn das Hellblau ist eine ganz andere Farbe als "
      "bei einem normalen Himmel.");
  AddDetail( ({"farbe", "blau", "hellblau", "farbton"}),
      "Der Farbton dieses Himmels ist ganz anders als ein normaler Himmel.");
  AddDetail( ({"gegend", "gegenden", "midas", "huegelland"}),
      "Normale Gegenden, wie Midas oder das Huegelland.");

  AddSound( ({DEFAULT_SOUND}),
      "Es ist angenehm ruhig hier.");
  AddSmell( ({DEFAULT_SMELL}),
      "Es riecht sehr angenehm hier.");

  SetProp(P_ZONE, "Elysia");
}

