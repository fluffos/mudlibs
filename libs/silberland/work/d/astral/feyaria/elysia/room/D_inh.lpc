#include "../def.h"

inherit ROOM "std_room";

varargs create(string dir1, string dir2) 
{
  ::create();

  SetProp(P_INT_LONG,
      "Du stehst auf einem schmalen Pfad, der von " + CAP(dir1) + " nach " + 
      CAP(dir2) + " an einer hohen Hecke entlang fuehrt, die so hoch ist, "
      "dass Du nicht erkennen kannst, was sich dahinter befindet. Auf der "
      "anderen Seite befinden sich viele Blumenbeete, die von Insekten und "
      "Voegeln bevoelkert werden.");

  AddDetail( ({"boden", "erde", "erdboden"}),
      "Du stehst auf fester Erde, also auf einem Erdboden.");
  AddDetail( ({"beet", "beete", "blumenbeet", "blumenbeete"}),
      "Die Beete sind voller wunderschoener Blumen.");
  AddDetail( ({"blume", "blumen"}),
      "Die Blumen sind wunderschoen. Viele Insekten und Voegel fliegen von "
      "Blume zu Blume.");
  AddDetail( ({"insekt", "insekten"}),
      "Vor allem Bienen und Schmetterlinge.");
  AddDetail( ({"biene", "bienen"}),
      "Die Bienen schwirren um die Blumen herum.");
  AddDetail( ({"schmetterling", "schmetterlinge"}),
      "Die Schmetterlinge flattern um die Blumen herum.");
  AddDetail( ({"vogel", "voegel"}),
      "Die kleinen Voegel schwirren um die Blumen herum.");
  AddDetail( ({"pfad", dir1, dir2}),
      "Ein schmaler Pfad fuehrt die Hecke entlang, er windet sich nach " +
      CAP(dir1) + " und " + CAP(dir2) + ".");
  AddDetail( ({"hecke"}),
      "Die Hecke ist undurchdinglich, daher kannst Du nicht sehen, was sich "
      "dahinter befindet.");

  AddItem( ({BIENE, KOLIBRI, SCHMETTERLING, 
        ROTKEHLCHEN, BLUETI, VANA, 
        NPC "blumengeist", NPC "lichtwesen", NPC "bluetenfee",
        }), 
      REFRESH_DESTRUCT,
      ([P_MNPC_DEFAULTROOM: file_name(TO), 
        P_MNPC_AREA: ROOM,
        P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
        P_CORPSE: OBJ "elysialeiche",
        P_HEAL: 20,
        ]) ); 
}

