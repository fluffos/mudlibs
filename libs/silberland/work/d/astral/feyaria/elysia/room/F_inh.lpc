#include "../def.h"

inherit ROOM "std_room";

varargs create() 
{
  ::create();

  SetProp(P_INT_LONG,
      "Di befindest Dich mitten in einem Durchgang durch eine Hecke im "
      "heiligen Garten von Elysia. Es ist sehr duester hier, nur aus den "
      "beiden Ausgaengen dringt etwas Licht herein, sodass Du gerade noch "
      "genug erkennen kannst, um Dich zurechtzufinden.");
  SetProp(P_NO_MNPC, 1);

  AddDetail( ({"durchgang"}),
      "Du bist in einem Durchgang durch eine Hecke.");
  AddDetail( ({"hecke"}),
      "Du bist mitten in einer sehr dichten Hecke, nur ein schmaler "
      "Durchgang erlaubt es Dir, hier durchzugehen.");
  AddDetail( ({"ausgaenge"}),
      "Es gibt zwei davon.");
  AddDetail( ({"licht"}),
      "Es ist sehr duester hier, das wenige Licht stammt von den beiden "
      "Ausgaengen.");
  AddDetail( ({"boden", "erde", "erdboden"}),
      "Du stehst auf fester Erde, also auf einem Erdboden.");

  AddItem(NPC "golem", REFRESH_DESTRUCT, 
      ([P_MNPC_FLAGS: 0,
        P_CORPSE: OBJ "elysialeiche"
      ]));
}

void init()
{
  ::init();
  if (find_call_out("load_rooms") == -1)
    call_out("load_rooms", 2);
}

void reset()
{
  ::reset();
  set_next_reset(3*60*60);
}
