#include "../def.h"

inherit ROOM "std_room";

void random_exits();

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Der Eingang zum heiligen Garten von Elysia");
  SetProp(P_INT_LONG,
      "Du stehst vor dem heiligen Garten von Elysia, allerdings kannst Du "
      "von hier aus noch nichts erkennen. Alle Ausgaenge scheinen in den "
      "Garten hinein zu fuehren, den Weg zurueck in die Astralebene musst Du "
      "Dir wohl oder uebel wo anders suchen.");
  
  AddDetail( ({"astralebene"}),
      "Die ist weit weg.");
  AddDetail( ({"weg", "ausgaenge", "wege"}),
      "Alle Wege fuehren nach Elysia.");
  AddDetail( ({"boden"}),
      "Der Boden ist hellgruen.");

  random_exits();
}

void reset()
{
  ::reset();
  random_exits();
}

void random_exits()
{
  int i;

  SetProp(P_EXITS, 0);
  for (i = 1 + random(6); i >= 0; i--)
    AddExit(({"nordwesten", "suedwesten", "nordosten", "suedosten", "norden",
          "sueden", "osten", "westen", "oben", "unten"})[random(10)],
        ([EX_FUNC: "eingang"]));
}

string eingang()
{
  int x, y;
  string dest;

  dest = "";
  while (dest == "")
  {
    x = -7 + random(15);
    y = -7 + random(15);
    if (file_size(dest = ROOM "room" + x + "x" + y + "y.lpc") < 0)
      dest = "";
  }
  return dest;
}

