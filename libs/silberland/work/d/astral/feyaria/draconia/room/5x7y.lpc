#include "../def.h" 

inherit ROOM "std_steg";

void create()
{
  ::create();

  AddExit("osten", 
      ([EX_DEST: "./5x8y",
        EX_TESTFUNC: "drachentest"]));
  AddExit("nordwesten","./4x6y");
  AddExit("nordosten","./4x8y");
  AddExit("suedosten","./6x8y");
  AddExit("suedwesten",
      ([EX_DEST: "./lava",
        EX_PLMSG: FALL_DOWN_MSG]) );
  AddExit("norden", 
      ([EX_DEST: "./4x8y",
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Nordosten zu gelangen.\n\n"]));
  AddExit("sueden", 
      ([EX_DEST: "./6x8y",
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Suedosten zu gelangen.\n\n"]));
  AddExit("westen",
      ([EX_DEST: "./4x6y", 
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Nordwesten zu gelangen.\n\n"]));
  SetProp(P_HIDE_EXITS, ({"sueden", "westen", "suedwesten",  "norden"}));

  AddItem(NPC "statue", REFRESH_DESTRUCT);
}

int drachentest(string dir)
{
  return DRACONIAMASTER->check_all_dragons();
}
