#include "../def.h"

inherit ROOM "std_room";

void create() 
{
  ::create();
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INT_LONG, 
      "Du befindest Dich in Draconia, im Reich der Drachen. Du stehst auf "
      "einem breiten Sims, zwischen einer Felswand und einem Abgrund. "
      "Die Felswand reicht weit hinauf, sodass sich die Decke dieser Kaverne "
      "ausserhalb Deiner Sichtweite befindet. Tief unten im Abgrund brodelt "
      "heisse Lava, deren Hitze Du sogar von hier aus noch spueren kannst.");

  AddDetail( ({"boden"}),
      "Du stehst auf einem breiten Sims, zwischen einer Felswand und einem "
      "Abgrund.");
  AddDetail( ({"sims"}),
      "Das Sims ist breit fuer Dich, aber fuer einen Drachen ist es eher "
      "schmal.");
  AddDetail( ({"wand", "waende", "felswand", "fels"}),
      "Die Felswand reicht weit hinauf.");
  AddDetail( ({"decke"}),
      "Die Decke laesst sich von hier nicht erkennen, so hoch oben muss sie "
      "sein.");
  AddDetail( ({"kaverne"}),
      "Du befindest Dich in einer gigantischen Kaverne.");
  AddDetail( ({"sichtweite", "sicht"}),
      "Die Decke ist auser Sicht.");
  AddDetail( ({"abgrund"}),
      "Der Abgrund ist gefaehrlich nahe. Tief unten brodelt die Lava, "
      "Du kannst ihre Hitze von hier noch spueren.");
  AddDetail( ({"lava"}),
      "Die Lava brodelt tief unten in Abgrund.");
  AddDetail( ({"hitze"}),
      "Du kannst die Hitze der Lava sogar hier oben noch spueren.");

  AddSound( ({DEFAULT_SOUND, "lava", "brodeln"}),
      "Du hoerst das Brodeln der Lava und das Fauchen eines Drachen.");

  if (random(3))
    AddItem( ({NPC "draconier", NPC "babydrache", NPC "drachling"}),
        REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: file_name(TO), 
          P_MNPC_AREA: ROOM,
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES + MOV_BACKWARDS,
          ]) ); 
}

