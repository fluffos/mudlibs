#include "../def.h"

inherit ROOM "std_room";

void create() 
{
  ::create();
  SetProp(P_INT_LONG, 
      "Du befindest Dich in Draconia, im Reich der Drachen. Du stehst in "
      "einem breiten Gang, breit genug, um einem gewaltigen Drachen Platz "
      "zu bieten. Die Waende und der Boden sind dermassen glatt poliert, "
      "dass da vermutlich Magie im Spiel war. Die Decke kannst Du in dem "
      "schwachen Licht kaum erkennen, so hoch ist sie ueber Dir. Auch der "
      "groesste Drache koennte hier seinen langen Hals muehelos nach oben "
      "strecken, ohne der Decke nahe zu kommen.");

  AddDetail( ({"boden"}),
      "Der Boden ist extrem glatt poliert, dass da vermutlich Magie im "
      "Spiel ist. Du kannst gar nicht erkennen, aus welchem Material er "
      "besteht.");
  AddDetail( ({"waende", "wand"}),
      "Die Waende sind extrem glatt poliert, dass da vermutlich Magie im "
      "Spiel ist. Du kannst gar nicht erkennen, aus welchem Material sie "
      "bestehen.");
  AddDetail( ({"magie", "spiel"}),
      "Du vermutest Magie drachischen Ursprungs.");
  AddDetail( ({"ursprung", "drachenmagie"}),
      "Drachenmagie ist eine der maechtigsten Formen der Magie im ganzen "
      "SilberLand.");
  AddDetail( ({"silberland"}),
      "Alles um Dich herum ist das SilberLand.");
  AddDetail( ({"form", "formen"}),
      "Es gibt viele Formen von Magie.");
  AddDetail( ({"material"}),
      "Du kannst wirklich nicht erkennen, aus welchem Material hier alles "
      "besteht. Aber Du vermutest, dass es sich um magisch veraenderten "
      "Stein handelt.");
  AddDetail( ({"stein", "fels"}),
      "Der Fels wurde wohl durch Drachenfeuer so veraendert, dass er "
      "voellig glatt ist.");
  AddDetail( ({"feuer", "drachenfeuer"}),
      "Nur magisches Drachenfeuer kann Stein so veraendern.");
  AddDetail( ({"licht", "decke"}),
      "Das Licht reicht nicht aus, die Decke richtig zu erhellen.");
  AddDetail( ({"gang"}),
      "Du bist in einem Gang.");
  AddDetail( ({"platz"}),
      "Hier ist genug Platz fuer den groessten Drachen.");
  AddDetail( ({"hals"}),
      "Dein Hals ist viel kuerzer wie der eines Drachens.");
}

