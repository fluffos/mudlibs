#include "../def.h" 

inherit ROOM "std_steg";

void create()
{
  ::create();

  AddExit("norden","./3x6y");
  AddExit("suedosten","./5x7y");
  AddExit("suedwesten",
      ([EX_DEST: "./lava",
        EX_PLMSG: FALL_DOWN_MSG]) );
  AddExit("westen",
      ([EX_DEST: "./lava",
        EX_PLMSG: FALL_DOWN_MSG]) );
  AddExit("nordosten", 
      ([EX_DEST: "./3x6y",
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Norden zu gelangen.\n\n"]));
  AddExit("nordwesten",
      ([EX_DEST: "./3x6y", 
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Norden zu gelangen.\n\n"]));
  AddExit("sueden",
      ([EX_DEST: "./5x7y",
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Sueden zu gelangen.\n\n"]));
  AddExit("osten",
      ([EX_DEST: "./5x7y",
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Seuden zu gelangen.\n\n"]));
  SetProp(P_HIDE_EXITS, ({"osten", "westen", "nordwesten", "nordosten", 
        "suedwesten", "sueden"}));

}
