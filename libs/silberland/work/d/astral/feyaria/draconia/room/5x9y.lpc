#include "../def.h" 

inherit ROOM "std_steg";

void create()
{
  ::create();

  AddExit("westen", 
      ([EX_DEST: "./5x8y",
        EX_TESTFUNC: "drachentest"]));
  AddExit("nordwesten","./4x8y");
  AddExit("suedwesten","./6x8y");
  AddExit("osten",
      ([EX_DEST: "./lava",
        EX_PLMSG: FALL_DOWN_MSG]) );
  AddExit("nordosten",
      ([EX_DEST: "./lava",
        EX_PLMSG: FALL_DOWN_MSG]) );
  AddExit("suedosten",
      ([EX_DEST: "./lava",
        EX_PLMSG: FALL_DOWN_MSG]) );
  AddExit("norden", 
      ([EX_DEST: "./4x8y",
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Nordwesten zu gelangen.\n\n"]));
  AddExit("sueden",
      ([EX_DEST: "./6x8y", 
        EX_PLMSG: "\nFast waerst Du den Abgrund in die Lava hinuntergefallen, "
        "schaffst es aber\ngerade noch, nach Suedwesten zu gelangen.\n\n"]));
  SetProp(P_HIDE_EXITS, ({"osten", "sueden", "nordosten", "suedosten", 
        "norden"}));

  AddItem(NPC "statue", REFRESH_DESTRUCT);
}

int drachentest(string dir)
{
  return DRACONIAMASTER->check_all_dragons();
}
