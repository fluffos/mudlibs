#include "../def.h"

inherit ROOM "std_room";

void create() 
{
  ::create();
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INT_LONG, 
      "Du befindest Dich in Draconia, im Reich der Drachen. Du stehst auf "
      "einem breiten Steg, allerdings wuerde ein Drache ihn eher als schmal "
      "bezeichnen. Zu beiden Seiten geht es senkrecht nach unten in den "
      "Lavasee, hoeffentlich faellst Du da nicht runter! Selbst von hier "
      "aus ist die Hitze fast unertraeglich. Die Decke der Kaverne befindet "
      "sich irgendwo ueber Dir, ausserhalb Deiner Sichtweite.");

  AddDetail( ({"raum", "kaverne"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"steg", "boden"}),
      "Unter Dir befindet sich ein Steg, und noch weiter unten ist die Lava.");
  AddDetail( ({"decke"}),
      "Die Decke ist irgendwo da oben, weit ausserhalb Deiner Sichtweite.");
  AddDetail( ({"sichtweite"}),
      "Du siehst nicht weit genug, um die Decke sehen zu koennen.");
  AddDetail( ({"kavarne", "raum"}),
      "Du befindest Dich in einer gewaltigen Kaverne.");
  AddDetail( ({"wand", "waende"}),
      "Die Waende der Kaverne sind zu weit weg, um sie zu sehen.");
  AddDetail( ({"hitze"}),
      "Die Hitze ist hier fast unertraeglich, was wohl daran liegt, dass "
      "die Lava unter dir so nahe ist.");
  AddDetail( ({"lava", "see", "lavasee"}),
      "Die Lava ist direkt unter Dir und bildet einen richtigen See.");
  AddDetail( ({"seite", "seiten", "schritt"}),
      "Auf beiden Seiten geht es senkrecht nach unten, ein falscher Schritt "
      "und Du faellst in Dein Verderben!");
  AddDetail( ({"verderben"}),
      "In einen Lavasee fallen ist sicher nicht sehr angenehm.");
}

