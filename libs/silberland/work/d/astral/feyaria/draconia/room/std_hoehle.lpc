#include "../def.h"

inherit ROOM "std_room";

void create() 
{
  ::create();
  SetProp(P_INT_LONG, 
      "Du befindest Dich in Draconia, im Reich der Drachen. Du stehst in "
      "gewaltigen Kammer, die man nur als Drachenhoehle bezeichnen kann. "
      "Sie ist fast hundert Meter hoch und doppelt so breit, genug Platz "
      "um einem riesigen Drachen genug Bewegungsfreiheit zu geben. "
      "In der Mitte befindet sich ein gewaltiger Hort aus Muenzen, Gold "
      "und anderen Schaetzen.");

  AddDetail( ({"meter", "hundert", "schaetzung"}),
      "Hundert Meter war nur eine Schaetzung.");
  AddDetail( ({"boden"}),
      "Der Boden ist von den Krallen des Drachen aufgerissen.");
  AddDetail( ({"krallen", "kralle"}),
      "Es muessen gewaltige Krallen gewesen sein, die den Boden so "
      "aufgerissen haben.");
  AddDetail( ({"waende", "wand"}),
      "Die Waende bestehen, wie Boden und Decke auch, aus hartem Fels.");
  AddDetail( ({"fels"}),
      "Sehr harter Fels, aber nicht hart genug fuer die Krallen eines Drachen.");
  AddDetail( ({"decke"}),
      "Die Decke ist so weit ueber Dir, dass Du sie kaum erkennen kannst.");
  AddDetail( ({"kammer", "hoehle", "drachenhoehle"}),
      "Du stehst in einer riesigen Drachenhoehle.");
  AddDetail( ({"platz", "bewegungsfreiheit"}),
      "Hier ist genug Platz fuer einen Drachen.");
  AddDetail( ({"mitte", "hort"}),
      "In der Mitte befindet sich ein gewaltiger Hort aus Muenzen, Gold "
      "und anderen Schaetzen.");
  AddDetail( ({"muenzen", "gold", "schaetze", "muenze", "schatz"}),
      "Das gehoert dem Drachen, der hier wohnt.");
}

void dragoncheck()
{
  DRACONIAMASTER->check_dragon();
}

void init()
{
  ::init();
  dragoncheck();
}

