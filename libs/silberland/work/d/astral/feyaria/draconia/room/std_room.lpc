#include "../def.h"

inherit STDROOM;

string sound_fauchen();

void create() 
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT, NO_TPORT_IN);
  SetProp(P_NOQUIT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INT_SHORT, "In Draconia");
  SetProp(P_INT_LONG, "In Draconia.");

  AddDetail( ({"draconia", "reich"}),
      "Du befindest Dich in Draconia, dem Reich der Drachen. Hier werden die "
      "Drachen geboren und wachsen, bis sie gross genug sind, sich in die Welt "
      "der Sterblichen zu begeben. Nur die groessten und staerksten Drachen "
      "duerfen dann nach langer Zeit wieder hierher zurueckkehren.");
  AddDetail( ({"welt", "silberland"}),
      "Die Welt nennt sich SilberLand.");
  AddGenderDetail( ({"sterblichen", "sterblicher", "sterbliche"}),
      "Du bist eine Sterbliche.", "Du bist ein Sterblicher.");
  AddDetail( ({"zeit", "ewigkeit"}),
      "Es dauert eine halbe Ewigkeit, bis ein Drache so gross und maechtig "
      "geworden ist, um wieder hierher zurueckkehren zu duerfen.");
  AddDetail( ({"drache", "drachen"}),
      "Es gibt viele Arten von Drachen.");
  AddDetail( ({"arten", "art"}),
      "Es gibt die sogenannten Farbdrachen und die Metalldrachen. Es soll "
      "auch Edelsteindrachen geben, aber diese sind sehr selten.");
  AddDetail( ({"farbdrachen", "farbdrache"}),
      "Es gibt schwarze, weisse, gruene, blaue und rote Drachen. Sie sind "
      "meist sehr boese.");
  AddDetail( ({"schwarz", "schwarze drachen", "schwarzer drache", "saeure", 
        "saeureangriff"}),
      "Schwarze Drachen sind beruechtigt fuer ihren Saeureangriff.");
  AddDetail( ({"weiss", "weisse drachen", "weisser drache", "eisdrachen", 
        "eisdrache"}),
      "Weisse Drachen werden auch Eisdrachen genannt.");
  AddDetail( ({"gruen", "gruene drachen", "gruener drache", "giftdrachen", 
        "giftdrache"}),
      "Gruende Drachen werden auch Giftdrachen genannt.");
  AddDetail( ({"blau", "blaue drachen", "blauer drache", "blitzdrache",
        "blitzdrachen", "blitz", "blitze"}),
      "Blaue Drachen werden auch Blitzdrachen genannt, weil sie mit maechtigen "
      "Blitzen angreifen.");
  AddDetail( ({"rot", "rote drachen", "roter drache", "feuerdrachen", 
        "feuerdrache", "feueratem", "feuer"}),
      "Die roten Drachen werden auch Feuerdrachen genannt, denn sie haben "
      "einen maechtigen Feueratem.");
  AddDetail( ({"metalldrachen", "metalldrache"}),
      "Es gibt Kupferdrachen, Bronzedrachen, Messingdrachen, Silberdrachen "
      "und Golddrachen. Sie sind gut und freundlich." );
  AddDetail( ({"kupfer", "kupferdrache", "kupferdrachen", "hoehlendrachen", 
        "hoehle", "hoehlen", "hoehlendrache"}),
      "Kupferdrachen sind nur in den tiefsten Hoehlen zu finden, darum nennt "
      "man sie auch Hoehlendrachen.");
  AddDetail( ({"bronze", "bronzedrachen", "reitdrache", "reitdrachen", "flieger"}),
      "Bronzedrachen sind die besten Flieger unter den Drachen, daher werden "
      "sie oft als Reitdrachen verwendet.");
  AddDetail( ({"messing", "messingdrache", "messingdrachen", "wasserdrache",
        "wasserdrachen", "wasser"}),
      "Messingdrachen leben meist unter Wasser, daher nennt man sie auch "
      "Wasserdrachen.");
  AddDetail( ({"silber", "silberdrachen", "silberdrachen"}),
      "Silberdrachen sind die schoensten Drachen.");
  AddDetail( ({"gold", "golddrache", "golddrachen", "paladine", "paladin", 
        "paladinen"}),
      "Golddrachen sind richtig heilig, darum haben sie sich mit den Paladinen "
      "verbuendet.");
  AddDetail( ({"edelsteindrache", "edelsteindrachen"}),
      "Da gibt es Amethystdrachen, Smaragddrachen, Saphirdrachen, Rubindrachen "
      "und Diamantdrachen. Sie sind allen neutral gegenueber.");
  AddDetail( ({"amethyst", "amethystdrachen", "amethystdrache",
        "smaragd", "smaragddrachen", "smaragddrache",
        "spahir", "saphirdrachen", "saphidrache",
        "rubin", "rubindrachen", "rubindrache",
        "diamant", "diamantdrachen", "diamantdrache"}),
      "Alle Edelsteindrachen sind sehr selten.");
      

  AddSmell( ({DEFAULT_SMELL, "drachen"}),
      "Es riecht nach Drachen.");
  AddSound( ({DEFAULT_SOUND}),
      "Du hoerst das Fauchen eines Drachen.");
  AddSound( ({"fauchen", "drache", "drachen"}), #'sound_fauchen);

  SetProp(P_ZONE, "Draconia");
}

string sound_fauchen()
{
  object drache;
  if (drache = present("drache"))
    return drache->Name(WER,1) + " faucht Dich an.\n";
  else
    return "Das Fauchen ist leise, Du kannst ja auch den fauchenden Drachen "
      "nicht sehen.\n";
}
