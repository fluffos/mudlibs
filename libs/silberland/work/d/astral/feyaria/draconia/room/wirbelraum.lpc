#include "../def.h"

inherit ROOM "std_room";

void create() 
{
  ::create();
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NO_MNPC, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 33, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INT_SHORT, "Nahe der Decke in einer Drachenhoehle");
  SetProp(P_INT_LONG, 
      "Du befindest Dich in der Naehe der Decke der Drachenhoehle. Unter Dir "
      "ist nur Luft, es ist also nur eine Frage der Zeit, bis Du wieder "
      "hinunterfaellst.");
  
  AddDetail( ({"decke", "naehe"}),
      "Du bist sehr nahe an der Decke, aber erreichen kannst Du sie "
      "trotzdem nicht!");
  AddDetail( ({"wand", "waende"}),
      "Nicht zu sehen.");
  AddDetail( ({"boden", "hoehle", "drachenhoehle"}),
      "Weit unter Dir.");
  AddDetail( ({"luft", "frage", "zeit"}),
      "Unter Dir ist nur Luft, es ist also nur eine Frage der Zeit, bis Du "
      "wieder hinunterfaellst.");
}

void init()
{
  ::init();
  if (TP)
    call_out("runterfallen", 4 + random(7), TP);
}

void runterfallen(object ob)
{
  if (ob && present(ob))
  {
    tell_object(ob, "Du faellst wieder hinunter!\n");
    ob->move(ROOM "6x2y", M_GO|M_NO_ATTACK, "von oben herunter", "faellt",
        "faellt hinunter");
    if (ob->is_class_member(CL_FLYING))
      tell_object(TP, "Da Du fliegen kannst, kannst Du den Aufprall bremsen.\n");
    else
    {
      tell_object(ob, "Du schlaegst auf dem Boden auf, das tat WEH!!!\n");
      ob->SetProp(P_DISABLE_ATTACK, 1);
      ob->AddHp(-10 - random(25));
    }
  }
}

void reset()
{
  ::reset();
  filter_array(all_inventory(this_object()), "runterfallen");
}
