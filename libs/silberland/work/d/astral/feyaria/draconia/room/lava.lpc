#include "../def.h"

inherit ROOM "std_room";

void create() 
{
  ::create();
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "gluehend heisse Lava");
  SetProp(P_NO_MNPC, 1);
  SetProp(P_KILL_NAME, "Gluehend heisse Lava");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 333, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INT_SHORT, "Mitten im Lavasee");
  SetProp(P_INT_LONG, 
      "LAVA!!!!! Ueberall nur LAVA!!!! Du bist im Lavasee gelandet und "
      "verbrennst nun qualvoll!");
  
  AddDetail( ({"lava", "lavasee", "boden", "waende", "wand", "decke"}),
      "Die Lava ist gluehend heiss und verbrennt Dich!");
}
