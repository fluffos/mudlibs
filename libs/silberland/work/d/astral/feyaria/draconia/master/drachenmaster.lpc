#include "../def.h"

mapping npctimes = ([
    "vulak": 0,
    "vyemm": 0,
    "mirenilla": 0,
    "koidoken": 0,
    "eashen": 0,
    "lendinaria": 0,
    "kreizenn": 0,
    "dagarn": 0,
    "nevederia": 0,
    "sarekia": 0,
    "feshlak": 0,
    ]);

nosave mapping room2dragon = ([
    "5x8y" : "vulak",
    "1x4y" : "vyemm",
    "10x5y": "mirenilla",
    "6x12y": "koidoken",
    "6x2y" : "eashen",
    "3x11y": "lendinaria",
    "4x3y" : "kreizenn",
    "10x8y": "dagarn",
    "1x8y" : "nevederia",
    "1x9y" : "sarekia",
    "9x2y" : "feshlak",
    ]);


void create()
{
  if( is_clone(TO) )
  {
    destruct(TO);
    return;
  }
  SUID;
  restore_object(MASTERSAVE);
}

// Shout nur innerhalb der Zone
void ZoneShout(string str)
{
  write(str);
  domainshout(str, ZONE, 1);
}

void dead_dragon(string dragon)
{
  npctimes[dragon] = time() + DRAGON_DELAY;
  save_object(MASTERSAVE);
}

void check_dragon()
{
  string roomname;
  string dragon;
  object npc;

  roomname = explode(file_name(previous_object()), "/")[5];
  dragon = room2dragon[roomname];
  
  if (present(dragon, previous_object()))
    return;
  if (objectp(find_object("/room/npcasylraum")))
    if (present(dragon, find_object("/room/npcasylraum")))
      return;

  if (dragon == "vulak")
  {
    if (ASTRALMASTER->QueryTime("draconia") < 0) 
    {
      npc = clone_object(NPC + dragon);
      npc->move(previous_object(), M_NOCHECK|M_SILENT|M_GO);
      call_other(ROOM "5x7y", "???");
      call_other(ROOM "5x9y", "???");
      call_other(ROOM "6x8y", "???");
      call_other(ROOM "4x8y", "???");
      npc->AddWaechter(present("statue", find_object(ROOM "5x7y")));
      npc->AddWaechter(present("statue", find_object(ROOM "5x9y")));
      npc->AddWaechter(present("statue", find_object(ROOM "4x8y")));
      npc->AddWaechter(present("statue", find_object(ROOM "6x8y")));
    }
  }
  else if (npctimes[dragon] < time())
    clone_object(NPC + dragon)->move(previous_object(), M_NOCHECK|M_SILENT|M_GO);
}

int check_all_dragons()
{
  int i;
  string* raeume;
  object dragon;

  raeume = m_indices(room2dragon) - ({"5x8y"});

  for (i = 1; i <= 8; i++)
  {
    call_other(ROOM + raeume[i], "dragoncheck");
    if (dragon = present(room2dragon[raeume[i]], find_object(ROOM + raeume[i])))
    {
      if (this_player())
        tell_object(this_player(),
            "Die Macht von " + dragon->name(WEM) + " haelt Dich zurueck.\n");
      return 0;
    }
  }
  return 1;
}
