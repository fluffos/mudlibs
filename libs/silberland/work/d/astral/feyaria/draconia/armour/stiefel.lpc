// Stiefel von Dagarn
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Dagarns Stiefel der Zerstoerung");
  SetProp(P_LONG, 
    "Die Stiefel von Lord Dagarn dem Zerstoerer, einem maechtigen Drachen. "
    "Sie sind aus blauem Leder gefertigt, um das staendig kleine Blitze "
    "zucken. Sicher wurde hier maechtige Magie verwendet, um dieses "
    "wundervolle Artefakt zu erschaffen.");
  SetProp(P_NAME, ({"Dagarns Stiefel der Zerstoerung",
                    "Dagarns Stiefel der Zerstoerung",
                    "Dagarns Stiefel der Zerstoerung",
                    "Dagarns Stiefel der Zerstoerung"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 0);
  AddId (({"stiefel", "dagarns stiefel der zerstoerung", "dagarns stiefel",
        "stiefel der zerstoerung", "\ndraconiaruestung"}) );
  SetProp(P_INFO,
      BS("Diese Stiefeln schuetzen vor Blitz und Donner und verstaerken den "
        "Schaden Deiner Zauber im Kampf. Ausserdem verstaerken sie das "
        "Zertreten von Berserkern, elementare Feuerzauber und die "
        "Faehigkeiten der Amazonen."));

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 50, MAT_MAGIC: 50]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 7000);
  SetProp(P_MAGIC, 5);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + 
      ([DT_LIGHTNING: 1, DT_SOUND: 1, DT_ELECTRIC: 1]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_EFFECTIVE_WC, 150 + random(50));
  SetProp(P_BERSERKER_BONUS, (["zertreten": 20, "all": 5]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([FEUER: 10]) );
  SetProp(P_AMAZONEN_SPELLCOST, 3);
  SetProp(P_AMAZONEN_BONUS, (["all": 5]) );

  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{     
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{   
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( 
      ([DT_LIGHTNING: -0.05, DT_SOUND: -0.05, DT_ELECTRIC: -0.05]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Magie der Drachen fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  object pl;

  if (!pl = QueryProp(P_WORN))
    return 0;
  if (!random(20) && pl->QuerySkillAttribute(SA_DAMAGE) <= 100)
  {
    pl->ModifySkillAttribute(pl, SA_DAMAGE, 110 + random(10), 4 + random(7));
    tell_object(pl, Name(WER,1) + " verstaerkt Deine Zauber!\n");
  }
  return 2;
}

