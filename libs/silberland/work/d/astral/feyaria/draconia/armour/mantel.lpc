// Mantel von Koi'doken
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Koi'Dokens Mantel der Tiefsee");
  SetProp(P_LONG, 
    "Der Mantel vom Lord Koi'Doken dem Piratenjaeger, einem maechtigen Drachen. "
    "Er besteht aus dunkelblauen Schuppen, die fast wie die Wogen eines "
    "Meeres aussehen. Nur die maechtige Magie von Drachen hat so ein "
    "maechtiges Artefakt erschaffen koennen.");
  SetProp(P_NAME, "Koi'Dokens Mantel der Tiefsee");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId (({"mantel", "mantel der tiefsee", "koi'dokens mantel der tiefsee",
        "koidokens mantel der tiefsee", "koidokens mantel", ELEMENT_RING_WASSER,
        "\ndraconiaruestung", "\ndraconiawassermantel"}) );
  SetProp(P_INFO,
      BS("Dieser Mantel schuetzt nicht nur vor Saeure und Wasser, sondern "
        "laesst Dich auch unter Wasser atmen. Ausserdem erleichter er "
        "Wasserzauber, ermoeglicht das Beherrschen von Wasserelementaren, "
        "erleichtert Gebete an Dusty und verringert die Kosten von "
        "Zechprellerzaubern."));

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_HORN: 50, MAT_MAGIC: 50]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 7000);
  SetProp(P_MAGIC, 5);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 3, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_WATER: 1, DT_ACID: 1]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([WASSER: 10]) );
  SetProp(P_ZECHPRELLER_SPELLCOST, 10);
  SetProp(P_PALADIN_SPELLCOST, 6);
  SetProp(P_BARDEN_SPELLCOST, 10);

  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{     
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{   
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int WearFunc(object ruest,int silent)
{
  call_out("make_waterbreathe", 0);
  return 1;
}

public void make_waterbreathe() {
  object ob;
  environment()->AddResistanceModifier( ([DT_WATER: -0.05, DT_ACID: -0.05]) );
  if(ob = present("\nwaterbreath",  environment())) {
    if(strstr(file_name(ob), WATERBREATH, 0) != -1) {
      ob->remove();
    }
  } else {
    CLONE(WATERBREATH, environment());
  }
}

int RemoveFunc(object ruest,int silent)
{
  object ob;
  QueryProp(P_WORN)->RemoveResistanceModifier();
  if(ob = present("\nwaterbreath", QueryProp(P_WORN))) {
    if(strstr(file_name(ob), WATERBREATH, 0) != -1) {
      ob->ende();
    }
  }
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Magie der Drachen fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
}

int check_equip_time()
{
  if (time() - QueryProp(P_EQUIP_TIME) >= 10) 
    return 1;
  return 0;
}

