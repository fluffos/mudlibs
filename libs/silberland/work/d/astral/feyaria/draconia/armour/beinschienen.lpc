// Beinschienen von Feshlak
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Feshlaks Beinschienen der Hinterhaeltigkeit");
  SetProp(P_LONG, 
    "Die Beinschienen von Lord Feshlak dem Hinterhaeltigen, einem maechtigen "
    "Drachen. Sie bestehen aus perfekt verarbeiteten Drachenschuppen und "
    "passen sich an jede Koerpfeform automatisch an. Solch ein maechtiges "
    "Artefekt kann wohl nur durch drachische Magie entstanden sein.");
  SetProp(P_NAME, "Feshlaks Beinschienen der Hinterhaeltigkeit");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 0);
  AddId (({"beinschienen", "beinschienen der hinterhaeltigkeit", "feshlak beinschienen",
        "feshlaks beinschienen der hinterhaeltigkeit", "\ndraconiaruestung"}) );
  SetProp(P_INFO,
      BS("Diese Beinschienen schuetzen vor Saeure und Gift und koennen "
        "Dich auch im Kampf entgiften. Ausserdem erleichtern sie elementare "
        "Humuszauber, nekromantische Giftzauber und die Faehigkeiten der "
        "Amazonen."));
  

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_HORN: 50, MAT_MAGIC: 50]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 7000);
  SetProp(P_MAGIC, 5);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_ACID: 1, DT_POISON: 1]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  call_other(ITEMD_DFC "poison1", "???");
  SetProp(P_DEFEND_FUNC, find_object(ITEMD_DFC "poison1"));
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([HUMUS: 10]) );
  SetProp(P_NEKRO_BONUS, (["hauch der verwesung": 25, "all": 5]) );
  SetProp(P_AMAZONEN_SPELLCOST, 3);
  SetProp(P_AMAZONEN_BONUS, (["all": 5]) );

  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{     
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{   
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_ACID: -0.05, DT_POISON: -0.05]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;
  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    if (wer->QueryProp(P_POISON))
      wer->SetProp(P_POISON, 0);
    tell_object(wer, 
        "Die Magie der Drachen fliesst von Feshlaks Beinschienen der Hinterhaeltigkeiten "
        "auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
  if (!objectp(QueryProp(P_DEFEND_FUNC)))
  {
    call_other(ITEMD_DFC "poison1", "???");
    SetProp(P_DEFEND_FUNC, find_object(ITEMD_DFC "poison1"));
  }
}

