// Draconierruestung
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Draconierruestung");
  SetProp(P_LONG, 
    "Die Ruestung eines Draconiers. Sie besteht aus Drachenschuppen und ist "
    "so anschmiegsam, dass sie sich jeder Koerperform anpasst. ");
  SetProp(P_NAME, "Draconierruestung");
  SetProp(P_GENDER, FEMALE);
  AddId (({"ruestung", "draconierruestung", "\ndraconiaruestung"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 35);
  SetProp(P_MATERIAL, ([MAT_HORN: 100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 2000);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 4, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 40]) );

  if (!random(5) && find_object(ITEMD))
    find_object(ITEMD)->Identify(TO, -1, 100, 100, ({400,800,1000,1020,1023}));

  if (!QueryProp(P_M_HEALTH_MOD))
    SetProp(P_M_HEALTH_MOD, ([P_HP: 2, P_SP: 2]) );
  SUID;
}
