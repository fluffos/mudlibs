// Faeustlinge von Sarekia
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Sarekias Faeustlinge der Kaelte");
  SetProp(P_LONG, 
    "Die Faeustlinge von Lady Sarekia der Kaltherzigen, einer maechtigen "
    "Drachin. Sie bestehen aus einem weissen Material, das gewebter Schnee "
    "sein koennte. Gefaehrliche Eiszapfen machden diese Faeustlinge zu einer "
    "gefaehrlichen Waffe im Nahkampf. Nur maechtige Drachenmagie ist imstande, "
    "solch ein wundervolles Artefakt zu erschaffen.");
  SetProp(P_NAME, ({"Sarekias Faeustlinge der Kaelte",
                    "Sarekias Faeustlinge der Kaelte",
                    "Sarekias Faeustlinge der Kaelte",
                    "Sarekias Faeustlinge der Kaelte" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_ARTICLE, 0);
  AddId (({"faeustlinge", "faeustlinge der kaelte", "sarekias faeustlinge",
        "sarekias faeustlinge der kaelte", "\ndraconiaruestung",
        ELEMENT_RING_EIS}) );
  SetProp(P_INFO,
      BS("Diese Faeustlinge schuetzen vor Eis und Schrecken, erleichtern "
        "Eiszauber, erlauben die Beherrschung von Eiselementaren und "
        "verbessern den Handkampf. Ausserdem verbessern sie auch die "
        "Faehigkeiten von Nekromanten und Berserkern."));

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_AIR: 50, MAT_MAGIC: 50]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 7000);
  SetProp(P_MAGIC, 5);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: -1, T_HEAT_PROT: 5]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_COLD: 1, DT_TERROR: 1]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([EIS: 10]) );
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 35);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, EIS);
  SetProp(P_BERSERKER_BONUS, (["all": 7]) );
  SetProp(P_NEKRO_BONUS, (["all": 7]) );

  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{     
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{   
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_COLD: -0.05, DT_TERROR: -0.05]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;
  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Magie der Drachen fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
}

int check_equip_time()
{
  if (time() - QueryProp(P_EQUIP_TIME) >= 10) 
    return 1;
  return 0;
}

