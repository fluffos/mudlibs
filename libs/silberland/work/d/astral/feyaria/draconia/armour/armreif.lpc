// Armreif von Eashen
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

int flying;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eashens Armreif des Himmels");
  SetProp(P_LONG, 
    "Der Armreif von Lord Eashen von den Himmeln, einem maechtigen Drachen. "
    "Er besteht aus einem Luftwirbel, der durch drachische Magie "
    "zusammengehalten wird.");
  SetProp(P_NAME, "Eashens Armreif des Himmels");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId (({"armreif", "armreif des himmels", "eashens armreif",
        "eashens armreif des himmels", "\ndraconiaruestung", ELEMENT_RING_LUFT}) );
  SetProp(P_INFO,
      BS("Dieser Armreif schuetzt vor Luft und Blitz, laesst Dich "
        "durch den Himmel fliegen und Luftelementare beherrschen. "
        "Ausserdem erleichtert er elementare Luftzauber, Gebete an Dusty "
        "und die Faehigkeiten der Amazonen."));

  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_AIR: 50, MAT_MAGIC: 50]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 7000);
  SetProp(P_MAGIC, 5);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_AIR: 1, DT_LIGHTNING: 1]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([LUFT: 10]) );
  SetProp(P_PALADIN_SPELLCOST, 7);
  SetProp(P_AMAZONEN_SPELLCOST, 3);
  SetProp(P_AMAZONEN_BONUS, (["all": 5]) );


  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{     
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{   
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_AIR: -0.05, DT_LIGHTNING: -0.05]) );
  if(!MENV->is_class_member(CL_FLYING))
  {
    flying = 1;
    MENV->AddClass(CL_FLYING);
    tell_object(MENV, 
        "Mit Hilfe von Eashens Armreif des Himmels kannst Du nun fliegen!\n");
  }
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  if(flying)
  {
    QueryProp(P_WORN)->RemoveClass(CL_FLYING);
    flying = 0;
  }
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Magie der Drachen fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
}

int check_equip_time()
{
  if (time() - QueryProp(P_EQUIP_TIME) >= 10) 
    return 1;
  return 0;
}

