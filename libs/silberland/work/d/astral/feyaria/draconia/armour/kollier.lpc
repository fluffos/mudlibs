// Diamantkollier von Lady Mirenilla
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Mirenillas Diamantkollier der Schoenheit");
  SetProp(P_LONG, 
    "Das Diamantkollier von Lady Mirenilla der Schoenen, einer maechtigen "
    "Drachin. Es besteht aus riesigen, wunderschoenen Diamanten, eingefasst "
    "in Platin.");
  SetProp(P_NAME, "Lady Mirenillas Diamantkollier");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 0);
  AddId (({"kollier", "diamantkollier", "kollier der schoenheit", 
        "diamantkollier der schoenheit", "\ndraconiaruestung"}) );
  SetProp(P_INFO,
      BS("Dieses Kollier ist nicht nur wunderschoen, sondern schuetzt auch "
        "noch vor daemonischer Magie und Erblindung. Ausserdem erleichtert "
        "es Gebete zu Dusty, reduziert den Alkoholverbrauch von Zechprellern "
        "und verbessert die Faehigkeiten eines Berserkers.."));

  AddDetail( ({"diamanten", "schoenheit"}),
      "Die Diamanten dieses Kolliers sind von unglaublicher Schoenheit.");
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_PLATINUM: 50, MAT_DIAMOND: 50]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 23000);
  SetProp(P_MAGIC, 5);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1,P_LEVEL: 60]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + 
      ([DT_UNHOLY: 2, DT_MAGIC: 2, DT_LIGHT: 2]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  call_other(ITEMD_DFC "blind1", "???");
  SetProp(P_DEFEND_FUNC, find_object(ITEMD_DFC "blind1"));
  SetProp(P_PALADIN_SPELLCOST, 5);
  SetProp(P_BERSERKER_BONUS, (["all": 5]) );
  SetProp(P_ZECHPRELLER_REDUCE_ALC, 20);

  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{     
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{   
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( 
      ([DT_UNHOLY: -0.05, DT_MAGIC: -0.05, DT_LIGHT: -0.05]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Magie der Drachen fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
  if (!objectp(QueryProp(P_DEFEND_FUNC)))
  {
    call_other(ITEMD_DFC "blind1", "???");
    SetProp(P_DEFEND_FUNC, find_object(ITEMD_DFC "blind1"));
  }
}

