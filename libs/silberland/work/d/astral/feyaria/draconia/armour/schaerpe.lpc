// Schaerpe von Lendinaria
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"
#include "../../gilden.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Lendinarias Schaerpe der Ueberlegenheit");
  SetProp(P_LONG, 
    "Die Schaerpe von Lady Lendinaria der Wissensbewahrerin, einer maechtigen "
    "Drachin. Es handelt sich hierbei um ein Tuch aus feinster Seide, das mit "
    "magischen Schriftzeichen beschrieben ist. Was diese Zeichen bedeuten, "
    "kannst Du nicht ergruenden, aber Du fuehlst Dich anderen Leuten um "
    "einiges ueberlegen, nur dadurch dass Du dieses maechtige Artefakt "
    "angesehen hast.");
  SetProp(P_NAME, "Lendinarias Schaerpe der Ueberlegenheit");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId (({"schaerpe", "schaerpe der ueberlegenheit", 
        "lendinarias schaerpe der ueberlegenheit",
        "\ndraconiaruestung"}) );
  SetProp(P_INFO,
      BS("Diese Schaerpe schuetzt vor Magie und Feuer und laesst Dich "
        "Paralyse schneller ueberwinden. Ausserdem erleichtert sie "
        "elementare Erzzauber, Gebete an Dusty und nekromantische "
        "Fertigkeiten."));

  SetProp(P_ARMOUR_TYPE, AT_BELT);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_SILK: 50, MAT_MAGIC: 50]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 7000);
  SetProp(P_MAGIC, 5);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_FIRE: 2, DT_MAGIC: 2]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);
  call_other(ITEMD_DFC "paralyze1", "???");
  SetProp(P_DEFEND_FUNC, find_object(ITEMD_DFC "paralyze1"));
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([ERZ: 10]) );
  SetProp(P_NEKRO_BONUS, (["mysterium": 25, "all": 5]) );
  SetProp(P_NEKRO_SPELLCOST, 3);
  SetProp(P_PALADIN_SPELLCOST, 4);

  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{     
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{   
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int WearFunc(object ruest,int silent)
{
  environment()->AddResistanceModifier( ([DT_FIRE: -0.05, DT_MAGIC: -0.05]) );
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  QueryProp(P_WORN)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  call_out("heal", 10 + random(200)); 
} 

void heal()
{ 
  object wer;

  if (objectp(wer = QueryProp(P_WORN)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Magie der Drachen fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
  if (!objectp(QueryProp(P_DEFEND_FUNC)))
  {
    call_other(ITEMD_DFC "paralyze1", "???");
    SetProp(P_DEFEND_FUNC, find_object(ITEMD_DFC "paralyze1"));
  }
}

