// Babydrachenschild
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Babydrachenschild");
  SetProp(P_LONG, 
      "Ein Schild, gefertigt aus den Schuppen eines Babydrachens. "
      "Er ist sehr gross und trotzdem relativ leicht, sodass er Dich "
      "gut im Kampf schuetzen kann, aber keine grosse Behinderung "
      "darstellt.");
  SetProp(P_NAME, "Babydrachenschild");
  SetProp(P_GENDER, MALE);
  AddId (({"schild", "drachenschild", "babydrachenschild", 
        "\ndraconiaruestung"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 23);
  SetProp(P_MATERIAL, ([MAT_HORN: 100]) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 2000);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 5, T_HEAT_PROT: 3]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 40]) );

  if (!random(5) && find_object(ITEMD))
    find_object(ITEMD)->identify(TO, -1, 100, 100, ({400,800,1000,1022,1023}));

  if (!QueryProp(P_M_HEALTH_MOD))
    SetProp(P_M_HEALTH_MOD, ([P_HP: 2, P_SP: 2]) );
  SUID;
}
