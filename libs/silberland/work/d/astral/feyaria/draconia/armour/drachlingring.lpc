// Drachlingring
// 18.09.2004 Feyaria

inherit "/std/armour";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Drachlingring");
  SetProp(P_LONG, 
    "Ein kleiner Ring aus Gold, der wie ein Drachling aussieht, der sich "
    "selbst in den Schwanz beisst. Er ist wunderbar gefertigt und schaut "
    "richtig lebensecht aus, wie ein winzig kleiner Drachling eben.");
  SetProp(P_NAME, "Drachlingring");
  SetProp(P_GENDER, MALE);
  AddId (({"ring", "drachlingring", "\ndraconiaruestung"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_GOLD: 100]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 2000);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: 1, T_HEAT_PROT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 40]) );

  if (!random(5) && find_object(ITEMD))
    find_object(ITEMD)->identify(TO, -1, 100, 100, ({400,800,1000,1020,1023}));

  if (!QueryProp(P_M_HEALTH_MOD))
    SetProp(P_M_HEALTH_MOD, ([P_HP: 2, P_SP: 2]) );
  SUID;
}
