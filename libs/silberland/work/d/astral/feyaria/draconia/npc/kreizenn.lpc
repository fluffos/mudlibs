// Kreizenn der Flammende, Draconia
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lord Kreizenn");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lord Kreizenn der Flammende");
  SetProp(P_KILL_NAME, "Lord Kreizenn der Flammende");
  SetProp(P_LONG, 
    "Lord Kreizenn der Flammende traegt seinen Namen, weil er ein gewaltiger "
    "roter Drache ist. Er ist von einer flammenden Aura umgeben, die eine "
    "fast unertraegliche Hitze ausstrahlt. Die glaenzenden roten Schuppen "
    "bedecken seinen gewaltigen Koerper, seine scharfen Zaehne und Klauen "
    "floessen Dir Angst ein. Eine Aura der Macht und Magie umgibt ihn.");
  AddId(({"kreizenn", "lord", "lord kreizenn"}));

  create_default_dragon(5, 12, 0, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag Doch Lady Lendinaria.\n");
  AddInfo(({"kreizenn", "lord kreizenn", "kreizennoruwertasflammor"}) , 
      "Das bin ich!", "sagt: ");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " spuckt eine gewaltige Feuerwolke in den Raum.\n",
    Name(WER,1) + " spuckt eine gewaltige Feuerwolke in den Raum.\n",
    DT_FIRE);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_UNHOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 500, DS_DISARM,
    Name(WER,1) + " bringt Deine Waffe zum gluehen.\n",
    Name(WER,1) + " bringt @WESSEN Waffe zum gluehen.\n");
  AddDefaultSpell(1, 200, DS_PARALYZE,
    Name(WER,1) + " laesst Dich erstarren.\n",
    Name(WER,1) + " laesst @WEN erstarren.\n",
    2 );   

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(WEAPON "kreizenns_flamme");
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("kreizenn");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

