// Koi'Doken der Piratenjaeger, Draconia
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lord Koi'Doken");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lord Koi'Doken der Piratenjaeger");
  SetProp(P_KILL_NAME, "Lord Koi'Doken der Piratenjaeger");
  SetProp(P_LONG, 
    "Lord Koi'Doken der Piratenjaeger traegt seinen Namen, weil er der "
    "gefuerchteste Meeresdrache war, bevor er zurueck in das Reich der "
    "Drachen gerufen wurde. Er hat eine dicke Schuppenhaut, die wie "
    "poliertes Messing glaenzt. Zwischen seinen Klauen befinden sich "
    "Schwimmhaeute, damit er sich auch im Wasser sehr schnell fortbewegen "
    "kann. Eine Aura der Macht und Magie umgibt ihn.");
  AddId(({"koi'doken", "lord", "lord koi'doken", "koidoken", "lord koidoken", 
        "piratenjaeger"}));

  create_default_dragon(3, 12, 1, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag Doch Lady Lendinaria.\n");
  AddInfo(({"koi'doken", "lord koi'doken", "koi", "lord koi", "koidoken",
        "lord koidoken", "koirusqorez dokenerasquas", "koirusqorez",
        "dokenerasquas"}), "Das bin ich!", "sagt: ");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " laesst eine Flutwelle durch den Raum rasen.\n",
    Name(WER,1) + " laesst eine Flutwelle durch den Raum rasen.\n",
    DT_WATER);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_HOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 500, DS_FROG);
  AddDefaultSpell(1, 700, DS_ANTIMAGIC,
    Name(WER,1) + " verwirrt Deine Sinne.\n",
    Name(WER,1) + " verwirrt @WESSEN Sinne.\n",
    5);

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(ARMOUR "mantel");
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("koidoken");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60 );
  ::Attack(enemy);
}

