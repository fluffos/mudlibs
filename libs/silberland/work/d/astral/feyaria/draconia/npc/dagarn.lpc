// Dagarn der Zerstoerer, Draconia
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lord Dagarn");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lord Dagarn der Zerstoerer");
  SetProp(P_KILL_NAME, "Lord Dagarn der Zerstoerer");
  SetProp(P_LONG, 
    "Lord Dagarn der Zerstoerer traegt seinen Namen, weil er mit seinen "
    "gewaltigen Blitzen ganzen Landstrichen zerstoeren kann. Seine "
    "blaue Schuppenhaut ist staendig von kleinen Blitzen umgeben, so "
    "extrem steht er unter Spannung. Auch seine gewaltigen Klauen und Zaehne "
    "koennen sicherlich fuer viel Zerstoerung sorgen. Mit einem solchen "
    "Drachen sollte man sich wohl nicht anlegen. "
    "Eine Aura der Macht und Magie umgibt ihn.");
  AddId(({"dagarn", "lord", "lord dagarn"}));

  create_default_dragon(4, 12, 0, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag Doch Lady Lendinaria.\n");
  AddInfo(({"dagarn", "lord dagarn", "daganostrowitschoralauxxo"}) , 
      "Das bin ich!", "sagt: ");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " verwandelt den Raum in ein blitzendes Inferno.\n",
    Name(WER,1) + " verwandelt den Raum in ein blitzendes Inferno.\n",
    DT_LIGHTNING);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_UNHOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 1200, DS_REDUCE_WC,
    Name(WER,1) + " zerstoert Deine Waffe.\n",
    Name(WER,1) + " zerstoert @WESSEN Waffe.\n");
  AddDefaultSpell(1, 1200, DS_REDUCE_AC,
    Name(WER,1) + " zerstoert Deine Ruestung.\n",
    Name(WER,1) + " zerstoert @WESSEN Ruestung.\n");

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(ARMOUR "stiefel"); 
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("dagarn");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

