// std-npc fuer draconia
// 09-09-2004  Feyaria@SilberLand

inherit "/p/std/dragons/dragon";

#include "../def.h"

string info_liste();

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  if(member(ALLOWED_UIDS, getuid(previous_object())) == -1 &&
      !IS_ARCH(previous_object())) 
  {
    raise_error("Illegales Clonen!");
    destruct();
    return;
  }
  AddId( ({"\ndraconianpc"}) );
  SetProp(P_MNPC_AREA, ROOM  );
  SetProp(P_MNPC_DEFAULTROOM, (ROOM "9x9y") );
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_MAYLOAD + MOV_BACKWARDS);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:1000000]));

  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  AddInfo( ({"liste", "topliste", "draconialiste", "draconiatopliste"}),
       #'info_liste);
  AddLibrary(DRACHENLIB, 2);
  AddLibrary(NPC "draconia.lib", 1);
  SetProp(P_LOG_INFO, "feyaria/draconia");
  SetProp(P_HEAL, 300);
  SetProp(P_KILL_MSG, "Die Macht von Draconia ist unueberwindbar!");
  SetProp(P_MURDER_MSG, "Es war ein Fehler, sich mit den Drachen von "
      "Draconia anzulegen, %s!");
  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer==TO)
    write_file(LOG "kills",
      dtime(time())+": "+CAP(getuid(player))+" wird von "+name(WEM)+" getoetet.\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}

void reset()
{
  ::reset();
  if (!is_clone(TO)) return;

}

void init()
{
  ::init();
  if (!TP)
    return;
  if (TP->id("\ndraconianpc"))
    AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

int Defend(int dam, string dtype, int spell, object enemy)
{
  if (!interactive(enemy))
    dam /= 2;
  if (QueryProp(P_LEVEL) > 50) 
  {
    if (dam > 1000)
      dam = 1000;
    if (!random(80) && !present("drache 2"))
    {
      if (random(2))
        CLONE(NPC "drachling", MENV);
      else
        CLONE(NPC "draconier", MENV);
    }
  }
  return ::Defend(dam, dtype, spell, enemy);
}

void clone_items(string special)
{
  if (special && random(2)) CLONEME(special);
  if (!random(SCHUPP_CHANCE))
    CLONEME(OBJ "schuppe");
  if (random(3))
    CLONEME(WSALBE); 
  if (random(3))
    CLONEME(RSALBE);
  if (random(3))
    CLONEME(WAFFENBALSAM); 
  if (random(3))
    CLONEME(RUESTUNGSBALSAM);
  if (!random(7))
    CLONEME(ESSENZ);
  if (!random(2))
    CLONEME(SALBE); 
  if (!random(2))
    CLONEME(SALBE);
  if (random(3))
    CLONEME(({OBJ "revive", OBJ "heal", OBJ "restoration", OBJ "teleport",
          OBJ "ident", OBJ "damage"})[random(6)]);
  if (!random(2))
    CLONEME(RGA);
  if (!random(4))
    CLONEME(MITHRIL);
  if (random(3))
    CLONEME(MAGIESEIDE);
  GELD(10000 + random(20000), TO);
}

varargs void clone_special(int flag)
{
  if (flag)
  {
    return;
    CLONEME( ({ WEAPON "negocaxt", WEAPON "levischwert", WEAPON "elviradolch",
          ARMOUR "icyhelm", ARMOUR "sengirhose", ARMOUR "verdandiarmreif",
          ARMOUR "joscherlumhang", ARMOUR "conanring", ARMOUR "junyschild",
          ARMOUR "trintstiefel", ARMOUR "lamyrapanzer", ARMOUR "limguertel",
          ARMOUR "evehandschuhe", ARMOUR "tessaamulett" })[random(14)]);
  }
  else
  {
    CLONEME( ({WEAPON "kreizenns_flamme", WEAPON "vyemms_rache", 
          WEAPON "nevederias_horn", ARMOUR "armreif", ARMOUR "schaerpe",
          ARMOUR "kollier", ARMOUR "mantel", ARMOUR "faeustlinge", 
          ARMOUR "beinschienen", ARMOUR "stiefel"})[random(10)] );
    clone_items(0);
  }
}

string info_liste()
{
  call_out("liste", 0);
  return "versucht, sich an die Draconiatopliste zu erinnern.\n";
}

void liste()
{
  write(
    "Die Liste der beruehmtesten Helden in Draconia\n"
    "----------------------------------------------\n");
  ASTRALMASTER->FameList("draconia");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; // Nicht zu viele Reactions!
    switch(gruppe) 
    {
      case "fies":
      case "intim":
        if( random(2) )
          call_out("react", 0, "faucht Dich an.",
              "faucht "+TP->name(WEN)+" an.");
        else
          call_out("angriff",0);
      break;
      case "aergerlich":
        call_out("react", 0, "spuckt Dir ein kleines Flammenwoelkchen entgegen",
            "spuckt " +TP->name(WEM) + " ein kleines Flammenwoelkchen entgegen.");
      break;
      case "traurig":
        call_out("react", 0, "troestet Dich.",
            "troestet "+TP->name(WEN)+".");
      break;
      case "aengstlich":
        call_out("react", 0, "floesst Dir neuen Mut ein.",
            "floesst "+TP->name(WEM)+" neuen Mut ein.");
      break;
      case "albern":
      case "neutral":
      case "froh":
      case "frech":
      case "nett":
        if (random(2))
          call_out("react", 0, "scheint Dich anzulaecheln.", 
                               "scheint "+TP->name(WEN)+" anzulaechen.");
        else
          call_out("react", 0, "beachtet Dich nicht.", "beachtet "+TP->name(WEN)+" nicht.");
      break;
    }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" schreit: DAFUER WIRST DU STERBEN!\n");
    Kill(TP);
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void die(int poisondeath)
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  if (objectp(killer))
    ASTRALMASTER->AddFame(killer, "draconia", QueryProp(P_LEVEL));
  ::die(poisondeath);
}
