// Sarekia die Kaltherzige, Draconia
// 24-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lady Sarekia");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lady Sarekia die Kaltherzige");
  SetProp(P_KILL_NAME, "Lady Sarekia die Kaltherzige");
  SetProp(P_LONG, 
    "Lady Sarekia die Kaltherzige ist eine gewaltige weisse Drachin, "
    "beruechtigt fuer ihre eisigen Attacken, sowohl mit Klauen als auch "
    "mit ihren Worten. Ihre weisse Schuppenhaut ist von einer feinen "
    "Eisschicht umgeben. Sie strahlt eine geradezu toedliche Kaelte aus. "
    "Eine Aura der Macht und Magie umgibt sie.");
  AddId(({"sarekia", "lady", "lady sarekia"}));

  create_default_dragon(2, 12, 0, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag Doch Lady Lendinaria.\n");
  AddInfo(({"sarekia", "lady sarekia", "sarekiaworulesicarnoflyxia"}),
      "Das bin ich!", "sagt: ");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
      Name(WER,1) + " spuckt eine gewaltige Eiswolke in den Raum.\n",
      Name(WER,1) + " spuckt eine gewaltige Eiswolke in den Raum.\n",
      DT_COLD);
  AddSpell(2, 2000,
      Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
      Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
      ({DT_MAGIC, DT_UNHOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 1300, DS_SLOW,
      Name(WER,1) + " friert Dich ein.\n",
      Name(WER,1) + " friert @WEN ein.\n",
      4);
  AddDefaultSpell(1, 1000, DS_MASS_BLIND,
      Name(WER,1) + " erzeugt eine gleissende Reflexion an ihren weissen Schuppen.\n",
      "Du erblindest!\n",
      Name(WER,1) + " erzeugt eine gleissende Reflexion an ihren weissen Schuppen.\n",
      "Du erblindest!\n",
      3);

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(ARMOUR "faeustlinge");
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("sarekia");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

