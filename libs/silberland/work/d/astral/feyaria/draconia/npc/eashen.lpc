// Eashen von den Himmeln, Draconia
// 24-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lord Eashen");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lord Eashen von den Himmeln");
  SetProp(P_KILL_NAME, "Lord Eashen von den Himmeln");
  SetProp(P_LONG, 
    "Lord Eashen von den Himmeln traegt seinen Namen zureck, denn er war "
    "der maechtigste der Himmelsdrachen, bevor er zurueck in das Reich der "
    "Drachen gerufen wurde. Dass er ein meisterlicher Flieger ist, sieht man "
    "sofort an seinen gewaltigen Fluegeln, die seinen bronzefarbenen Koerper "
    "richtig klein aussehen lassen, obwohl er doch ein riesiger Drache ist. "
    "Eine Aura der Macht und Magie umgibt ihn.");
  AddId(({"eashen", "lord", "lord eashen", "himmelsdrache"}));

  create_default_dragon(2, 12, 1, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag Doch Lady Lendinaria.\n");
  AddInfo(({"eashen", "lord eashen", "eashenorustroflaf"}), 
      "Das bin ich!", "sagt: ");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " laesst einen Orkan durch den Raum rasen.\n",
    Name(WER,1) + " laesst einen Orkan durch den Raum rasen.\n",
    DT_AIR);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_HOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 900, DS_BLIND);
  AddSpell(2, 700,
    Name(WER,1) + " wirbelt Dich in die Luft.\n",
    Name(WER,1) + " wirbelt @WEN in die Luft.\n",
    DT_AIR, "spell_wirbeln", ([SP_SHOW_DAMAGE: 1]));

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(ARMOUR "armreif"); 
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("eashen");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

void spell_wirbeln(object enemy, int damage, mixed dam_type)
{
  enemy->move(ROOM "wirbelraum", M_GO, "hoch in die Luft gewirbelt", "wird",
      "wird von unten heraufgewirbelt");
}

