// Nevederia die Giftmischerin, Draconia
// 24-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lady Nevederia");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lady Nevederia die Giftmischerin");
  SetProp(P_KILL_NAME, "Lady Nevederia die Giftmischerin");
  SetProp(P_LONG, 
    "Lady Nevederia die Giftmischerin ist eine gewaltige gruene Drachin, "
    "beruechtigt fuer ihre giftigen Attacken, sowohl mit Klauen als auch "
    "mit ihren Worten. Ihre gruene Schuppenhaut scheint nur so von Gift zu "
    "triefen, schon eine Beruehrung kann Dich vergiften. "
    "Eine Aura der Macht und Magie umgibt sie.");
  AddId(({"nevederia", "lady", "lady nevederia"}));

  create_default_dragon(3, 12, 0, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag Doch Lady Lendinaria.\n");
  AddInfo(({"nevederia", "lady nevederia", "nevedariastrologrosmapoisa"}) , 
      "Das bin ich!", "sagt: ");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " spuckt eine gewaltige Giftwolke in den Raum.\n",
    Name(WER,1) + " spuckt eine gewaltige Giftwolke in den Raum.\n",
    DT_POISON);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_UNHOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 1300, DS_POISON,
      Name(WER,1) + " vergiftet Dich.\n",
      Name(WER,1) + " vergiftet @WEN.\n",
      7);
  AddDefaultSpell(1, 1000, DS_MASS_POISON,
      Name(WER,1) + " versprueht ihr toedliches Gift.\n",
      Name(WER,1) + " versprueht ihr toedliches Gift.\n",
      4);

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(WEAPON "nevederias_horn");
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("nevederia");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

void poison()
{
  tell_object(TP, 
      BS("Noch bevor Du Lady Nevederia beruehren kannst, wirst Du auch "
        "schon vergiftet."));
  TP->AddPoison(1);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch)
    poison();
  ::StartReaction( verb, gruppe, adverb, touch);
}

