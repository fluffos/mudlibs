// ein Draconier
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Draconier");
  SetProp(P_GENDER, MALE);
  color = random(10);
  SetProp(P_NAME_ADJ, ({"schwarz", "weiss", "gruen", "blau", "rot", "kupfern", 
        "messingfarben", "bronzen", "silbern", "golden"})[color]);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Dieser Draconier hat eine menschenaehnliche Form, allerdings ist er um "
    "einiges groesser. Von seinem drachischen Erbe kommen die Schuppenhaut, "
    "die Klauen an seinen Fingern, die scharfen Zaehne in seinem Maul und "
    "der lange, kraeftige Schwanz. Scheinbar sind Draconier Mischlinge "
    "zwischen Menschen und Drachen.");
  AddId(({"draconier"}));

  AddDetail( ({"klauen", "zaehne"}),
      "Scharf.");
  AddDetail( ({"haut", "schuppenhaut"}),
      "Schuppig.");
  AddDetail( ({"schwanz"}),
      "Kraeftig.");

  create_default_dragon(1 + color % 5, 2, color/5, 1 + random(2));
  SetProp(P_SIZE, 220 + random(50));

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weg");
  SetProp(P_MNPC_WAIT, ({ 15, 15, 15 }));

  SetProp(P_DIE_MSG,  " stirbt einen Draconiertod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an.\n");

  SetChats(1, ({
    Name(WER,1)+" sieht Dich misstrauisch an.\n",
    Name(WER,1)+" sagt etwas, aber Du verstehst es nicht.\n",
    Name(WER,1)+" zischt.\n",
    Name(WER,1)+" zeigt Dir seine Krallen.\n",
    Name(WER,1)+" zischelt etwas unverstaendliches.\n"}) );

  SUID;
  if (!random(3))
    CLONEME(ARMOUR "draconierruestung");
}

