// Vyemm der Gueldene, Draconia
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lord Vyemm");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lord Vyemm der Gueldene");
  SetProp(P_KILL_NAME, "Lord Vyemm der Gueldene");
  SetProp(P_LONG, 
    "Lord Vyemm der Gueldene traegt seinen Namen, weil er ein gewaltiger "
    "Golddrache ist, seine Schuppen strahlen wie reinstes Gold. Fuer einen "
    "Drachen seiner Groesse hat er einen extrem schlanken Koerper und einen "
    "sehr langen Hals, er sieht schon fast aus wie eine Schlange. Allerdings "
    "hat er vier kraeftige Beine und ein Paar gewaltiger Fluegel. Sein Maul "
    "ist mit spitzen Zaehnen nur so bestueckt und seine Krallen sind sicher "
    "nicht weniger scharf. Eine Aura der Macht und Magie umgibt ihn.");
  AddId(({"vyemm", "lord", "lord vyemm"}));

  create_default_dragon(5, 12, 1, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag doch Lady Lendinaria.\n");
  AddInfo(({"vyemm", "lord vyewmm"}) , 
      "Das bin ich!", "sagt: ");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " spuckt eine gewaltige Feuerwolke in den Raum.\n",
    Name(WER,1) + " spuckt eine gewaltige Feuerwolke in den Raum.\n",
    DT_FIRE);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_HOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 500, DS_DRAIN_MANA,
    Name(WER,1) + " laesst Deine Magie verschwinden.\n",
    Name(WER,1) + " laesst @WESSEN Magie verschwinden.\n");   
  AddDefaultSpell(1, 200, DS_PARALYZE,
    Name(WER,1) + " laesst Dich erstarren.\n",
    Name(WER,1) + " laesst @WEN erstarren.\n",
    2 );   

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(WEAPON "vyemms_rache");
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("vyemm");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

