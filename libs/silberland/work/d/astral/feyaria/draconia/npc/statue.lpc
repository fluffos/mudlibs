// eine Drachenstatue
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit "std/npc";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Drachenstatue");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Eine gewaltige Drachenstatue. Sie besteht aus Stein, trotzdem sieht sie "
    "fast wie ein Drache aus.");
  AddId(({"drachenstatue", "statue"}));

  set_living_name("\ndraconia_statue");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit steinernen Drachenklauen", 250, DT_BLUDGEON}) );
  SetProp(P_XP, 0);

  SetProp(P_DIE_MSG,  " kann doch gar nicht sterben.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, "" }) );
  AddInfo(DEFAULT_INFO, "kann ja gar nicht reden.\n");

  SUID;
}

int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  :: Defend(0, dam_type, spell, enemy);
}
