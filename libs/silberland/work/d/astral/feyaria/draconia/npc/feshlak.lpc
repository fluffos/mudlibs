// Feshlak der Hinterhaeltige, Draconia
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lord Feshlak");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lord Feshlak der Hinterhaeltige");
  SetProp(P_KILL_NAME, "Lord Feshlak der Hinterhaeltige");
  SetProp(P_LONG, 
    "Lord Feshlak der Hinterhaeltige traegt seinen Namen, weil er der "
    "Hinterhaeltigste aller schwarzen Drachen ist. Seine abgrundtief schwarzen "
    "Schuppen, seine grausamen Klauen und seine fuerchterlichen Zaehne machen "
    "ihn zu einer furchtvollen Erscheinung. "
    "Eine Aura der Macht und Magie umgibt ihn.");
  AddId(({"feshlak", "lord", "lord feshlak"}));

  create_default_dragon(1, 12, 0, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag Doch Lady Lendinaria.\n");
  AddInfo(({"feshlak", "lord feshlak", "feshlorusquafbaxxarolak"}) , 
      "Das bin ich!", "sagt: ");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " spuckt eine gewaltige Saeurewolke in den Raum.\n",
    Name(WER,1) + " spuckt eine gewaltige Saeurewolke in den Raum.\n",
    DT_ACID);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_UNHOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 1200, DS_CURSE_ARMOUR);
  AddDefaultSpell(1, 1500, DS_FEAR,
      Name(WER,1) + " macht einen hinterhaeltigen Angriff.\n"
      "Du fluechtest voller Panik.\n",
      "@WER fluechtet voller Panik vor " + name(WEM,1) + ".\n");

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(ARMOUR "beinschienen");
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("feshlak");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

