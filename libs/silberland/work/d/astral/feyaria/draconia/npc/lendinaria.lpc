// Lendinaria die Wissensbewahrerin, Draconia
// 24-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

string heldentaten();

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lady Lendinaria");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lady Lendinaria die Wissensbewahrerin");
  SetProp(P_KILL_NAME, "Lady Lendinaria die Wissensbewahrerin");
  SetProp(P_LONG, 
    "Lady Lendinaria die Wissensbewahrerin traegt ihren Namen zurecht, denn "
    "sie sieht wirklich sehr weise und belesen aus. Sie gibt dem Wort "
    "'Buecherwurm' eine ganz neue Bedeutung. Allerdings mag es kein Drache, "
    "als Wurm oder Lindwurm bezeichnet zu werden, das kann ganz schlimme "
    "Konsequenzen haben. Lady Lendinarias Koerper ist mit kupferfarbenen "
    "Schuppen bedeckt, ihre Krallen und Faenge sehen sehr gefaehrlich aus, "
    "aber durch ihren weisen und milden Blick macht sie Dir nicht so viel "
    "Angst wie die anderen grossen Drachen, allerdings strahlt sie eine "
    "Aura von Macht und Magie aus.");
  AddId(({"lendinaria", "lady", "lady lendinaria die wissensbewahrerin", "drachin"}));

  create_default_dragon(1, 12, 1, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, ({
        "sagt: Ich weiss vieles, aber darueber leider nichts.\n",
        "sagt: Ich wusste, dass Du das fragen wuerdest.\n",
        "sagt: Such die Antwort in Dir selbst.\n",
        "sagt: Darueber wurde schon alles gesagt.\n",
        "sagt: Nur die richtige Frage fuehrt zur Erkenntnis!\n",
        "sagt: Viele Wege fuehren zum Wissen.\n",
        "sagt: Reden ist Silber, Schweigen ist Gold, Wissen ist Kupfer!\n",
        }));
  AddLibrary(MATERIALLIB, 1);
  AddLibrary(SPIELERLIB, 1);
  AddLibrary(MACHTLIB, 1);
  AddLibrary(GILDENLIB, 3);
  AddLibrary(ITEMDLIB, 1);
  SetProp(P_LOG_INFO, "feyaria/lendinaria");

  AddInfo("lendinaria", "laechelt Dich freundlich an.");
  AddInfo("lady lendinaria", "lobt Deine Hoeflichkeit.");
  AddInfo("heldentaten", #'heldentaten);

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " speit eine riesige Saeurewolke in den Raum.\n",
    Name(WER,1) + " speit eine riesige Saeurewolke in den Raum.\n",
    DT_ACID);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_HOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 1100, DS_MASS_DEAF,
      Name(WER,1) + " erzaehlt Dir so komplizierte Dinge, dass Du taub wirst.\n",
      Name(WER,1) + " erzaehlt Dir so komplizierte Dinge, dass Du taub wirst.\n",
      6);
  AddDefaultSpell(1, 900, DS_DEAF,
      Name(WER,1) + " erklaert Dir einige komplexe Zusammenhaenge bis Du\n"
      "nicht mehr folgen kannst und Deine Ohren ihren Dienst aufgeben.\n",
      "@WER haelt sich die Ohren zu.\n", 20);   

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items(ARMOUR "schaerpe");
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("lendinaria");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

void catch_tell(string str)
{
  if (TP && strstr(str, "buecherwurm") != -1)
  {
    tell_room(MENV, BS("Lendinaria wird wuetend, weil Sie nicht als "
        "'Buecherwurm' bezeichnet werden will!\n"));
    Kill(TP);
  }
}

string heldentaten()
{
  ASTRALMASTER->FameCheck(getuid(TP));
  return "sagt: Ruhe Dich aber nicht auf Deinen Taten aus!\n";
}

