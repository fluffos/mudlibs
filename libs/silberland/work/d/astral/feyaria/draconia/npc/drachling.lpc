// ein Drachling
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Drachling");
  SetProp(P_GENDER, MALE);
  color = random(10);
  SetProp(P_NAME_ADJ, ({"schwarz", "weiss", "gruen", "blau", "rot", "kupfern", 
        "messingfarben", "bronzen", "silbern", "golden"})[color]);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Der Drachling sieht aus wie eine Schlange mit einem Drachenkopf "
    "und vier winzigen Beinchen. Allerdings hat er die gleiche Schuppenhaut "
    "wie die grossen Drachen und auch seine Klauen und scharfen Zaehne sind "
    "aehnlich scharf. Allerdings besitzt er keine Fluegel, sodass er Dir "
    "nicht davonfliegen kann.");
  AddId(({"drachling"}));

  AddDetail( ({"klauen", "zaehne"}),
      "Scharf.");
  AddDetail( ({"haut", "schuppenhaut"}),
      "Schuppig.");
  AddDetail( ({"kopf", "drachenkopf"}),
      "Sieht aus wie der Kopf eines Drachen, allerdings auf dem Koerper "
      "einer Schlange.");
  AddDetail( ({"koerper"}),
      "Schlangenfoermig.");
  AddDetail( ({"beine", "beinchen"}),
      "Winzig.");

  create_default_dragon(1 + color % 5, 1, color/5, 1 + random(3));

  SetProp(P_MSGIN, "schlaengelt sich herein");
  SetProp(P_MSGOUT, "schlaengelt sich");
  SetProp(P_MMSGIN, "schlaengelt sich herein");
  SetProp(P_MMSGOUT, "schlaengelt sich weg");
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }));

  SetProp(P_DIE_MSG,  " stirbt einen Drachlingtod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an.\n");

  SetChats(1, ({
    Name(WER,1)+" schlaengelt sich herum.\n",
    Name(WER,1)+" schlaengelt sich um Deine Beine.\n",
    Name(WER,1)+" zischt.\n",
    Name(WER,1)+" droht Dir mit seinem Drachenmaul.\n",
    Name(WER,1)+" versucht wie ein richtiger grosser Drache auszusehen.\n"}) );

  SUID;
  if (!random(3))
    CLONEME(ARMOUR "drachlingring");
  
}

