// Mirenilla die Schoene, Draconia
// 24-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Lady Mirenilla");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lady Mirenilla die Schoene");
  SetProp(P_KILL_NAME, "Lady Mirenilla die Schoene");
  SetProp(P_LONG, 
    "Lady Mirenilla traegt ihren Namen zurecht, denn sie ist wohl die "
    "schoneste Drachin, die Du je in Deinem Leben gesehen hast. Ihre "
    "silbernen Schuppen glaenzen und glitzern, ihre elegant geschwungener "
    "Hals, ihre unergruendlichen tiefblauen Augen... einfach unbeschreiblich "
    "wunderschoen. Aber trotz aller Schoenheit ist sie auch eine "
    "ehrfurchgebietende Drachin, umgeben von einer Aura der Macht und Magie.");
  AddId(({"mirenilla", "lady", "lady mirenilla", "drachin"}));

  create_default_dragon(4, 12, 1, 30);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 2);
  SetProp(P_XP, QueryProp(P_XP) * 2);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "sagt etwas in einer unverstaendlichen, aber wunderschoenen Sprache.\n");
  AddInfo(({"lady mirenilla", "mirenilla", "mirenillajelixosuzaras"}), 
      "laechelt Dich mit einem bezaubernden Laecheln an.");

  AddDefaultSpell(2, 1500, DS_MASS_DAMAGE,
    Name(WER,1) + " lasst einen gewaltigen Kettenblitz durch den Raum jagen.\n",
    Name(WER,1) + " lasst einen gewaltigen Kettenblitz durch den Raum jagen.\n",
    DT_LIGHTNING);
  AddSpell(2, 2000,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_HOLY}), ([SP_SHOW_DAMAGE: 1]));
  AddDefaultSpell(1, 1000, DS_MASS_BLIND,
      "Die unglaubliche Schoenheit von Lady Mirenilla laesst Dich erblinden.\n",
      "Die unglaubliche Schoenheit von Lady Mirenilla laesst Dich erblinden.\n",
      3);
  AddDefaultSpell(1, 700, DS_BLIND,
      "Die Schoenheit von Lady Mirenilla ist zu viel fuer Deine Augen.\n"
      "Du erblindest.\n",
      "@WER erblindet.\n", 5);   

  SUID;
  if (!random(DRAGON_SPECIAL_CHANCE))
    clone_special();
  else 
    clone_items (ARMOUR "kollier");
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  write_file( LOG "drachen.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  DRACONIAMASTER->dead_dragon("mirenilla");
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY);
  ::die(poisondeath);
}

void Attack(object enemy)
{
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

