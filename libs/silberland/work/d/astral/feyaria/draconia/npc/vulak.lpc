// Vulak Aerr der Maechtige
// 10-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";
inherit "std/npc/spells";

object *waechter = ({});

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, ({"Lord Vulak'Aerr der Maechtige", 
                    "Lord Vulak'Aerr des Maechtigen",
                    "Lord Vulak'Aerr dem Maechtigen",
                    "Lord Vulak'Aerr den Maechtigen"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Lord Vulak'Aerr der Maechtige, Herrscher ueber Draconia");
  SetProp(P_KILL_NAME, "Lord Vulak'Aerr, der Drachenherrscher");
  SetProp(P_LONG, 
    "Vor Dir steht der maechtigste Drache, den Du jemals in Deinem Leben "
    "gesehen hast. Ein titanenhafter Koerper, mit einem fast endlos langen "
    "Hals, der in einen riesigen Kopf muendet, dessen Maul mit spitzen "
    "Zaehnen bestueckt ist, und gewaltige Schwingen, die sogar diesen "
    "tonnenschweren Koerper mit Leichtigkeit in die Luft heben koennen. "
    "Aber was diesen Drachen zum wahrhaftig einzigartigen Ereignis macht, "
    "ist das strahlende Leuchten, das ihn umgibt und Dich vor Ehrfurcht "
    "fast in die Knie zwingt.");
  AddId(({"vulak", "aerr", "vulak aerr", "herrscher", "lord", "lord vulak aerr"}));

  AddDetail( ({"klauen", "zaehne"}),
      "Scharf!");
  AddDetail( ({"haut", "schuppenhaut"}),
      "Schuppig!");
  AddDetail( ({"kopf", "drachenkopf"}),
      "Riesig!");
  AddDetail( ({"koerper"}),
      "Titanenhaft!");
  AddDetail( ({"schwingen"}),
      "Gewaltig!");
  AddDetail( ({"hals"}),
      "Endlos lang!");
  AddDetail( ({"leuchten"}),
      "Ehrfucht einfloessend!");

  create_default_dragon(5, 12, 2, 100);
  SetProp(P_SIZE, 5000);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) * 3);
  SetProp(P_XP, QueryProp(P_XP) * 3);
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " stirbt einen Drachenherschertod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "zischt Dich an: Frag Doch Lady Lendinaria.\n");
  AddInfo(({"vulak", "vulak'aerr", "vulak aerr", "herrscher", "lord vulak",
        "lord vulak'aerr", "lord vulakaerr", "vulakorinoxifas aerroziroxusof",
        "vulakorinoxifas", "aerroziroxusof"}),
      "Das bin ich, Du Winzling!", "sagt: ");

  SetProp(P_SPELLRATE, 88);
  AddDefaultSpell(1, 900, DS_MASS_FEAR,
    Name(WER,1) + " schlaegt Dich in die Flucht!\n",
    Name(WER,1) + " schlaegt Dich in die Flucht!\n");
  AddDefaultSpell(1, 1200, DS_MASS_POISON,
    Name(WER,1) + " atmet ein giftgruene Wolke aus.\n",
    Name(WER,1) + " atmet ein giftgruene Wolke aus.\n",5);
  AddDefaultSpell(1, 1500, DS_MASS_DAMAGE,
    "Eine gewaltiger Kettenblitz saust durch den Raum.\n",
    "Eine gewaltiger Kettenblitz saust durch den Raum.\n", 
    DT_LIGHTNING);
  AddDefaultSpell(1, 1700, DS_SLOW,
    Name(WER,1) + " friert Dich ein.\n",
    Name(WER,1) + " friert @WEN ein.\n", 
    5 );   
  AddDefaultSpell(1, 1700, DS_ANTIMAGIC,
    Name(WER,1) + " verwirrt Dich.\n",
    Name(WER,1) + " verwirrt @WEN.\n", 
    5 );   
  AddDefaultSpell(1, 700, DS_PARALYZE,
    Name(WER,1) + " laesst Dich erstarren.\n",
    Name(WER,1) + " laesst @WEN erstarren.\n", 
    2);
  AddSpell(1, 2200,
    Name(WER,1) + " straft Dich mit der Macht der Drachen.\n",
    Name(WER,1) + " straft @WEN mit der Macht der Drachen.\n",
    ({DT_MAGIC, DT_HOLY, DT_UNHOLY}), ([SP_SHOW_DAMAGE: 1]));

  SUID;
  clone_special(0);
  clone_special(1);
  CLONEME(OBJ "schuppe");
  CLONEME(RGA);
  CLONEME(MITHRIL);
  CLONEME(MITHRIL);
  CLONEME(WSALBE);
  CLONEME(RSALBE);
  GEMMASTER->DistributeGem(10, 10, 1, 1, GEMARRAY);
  PEARLMASTER->DistributePearl(10, 10, 1, 1);
}

int Defend(int dam, string dtype, int spell, object enemy)
{
  int i;

  for (i = sizeof(waechter) - 1; i >= 0; i--)
  {
    if (!objectp(waechter[i]) || !waechter[i]->InFight())
    {
      tell_room(environment(), Name(WER,1) + " schuetzt sich durch die Magie "
          "der Drachenstatuen.\n");
      StopHuntFor(enemy);
      enemy->StopHuntFor(this_object());
      return 0;
    }
  }
  if (interactive(enemy))
    SetProp( P_PREFERED_ENEMY, ({90,enemy}));
  if (dam > 600) dam = 600;
  return ::Defend(dam, dtype, spell, enemy);
}

varargs void die( int poisondeath )
{
  object killer;

  killer = ((object) QueryProp(P_KILLER)) || this_player() || previous_object();
  ASTRALMASTER->AddFlag(killer, FLAG_VULAK,
      filter_array(PresentEnemies(), #'interactive));
  killer->SetProp(P_DRAGON_ENEMY, time() + DRAGON_DELAY * 3);
  if (0 && interactive(killer) && !present("\nschuppenhaut", killer))
  {
    CLONE(SCHUPPENHAUT, killer);
    tell_object(killer, BS(
        "\nDas Blut des Drachen sprudelt aus seiner zerstueckelten Leiche " 
        "heraus und bildet einen richtigen blutroten See vor Dir. Berauscht "
        "von Deinem glorreichen Sieg springst Du voller Freude in den See und "
        "beginnst Dich darin herumzuwaelzen, bis Dein gesamter Koerper vom "
        "Drachenblut bedeckt ist. Die Essenz des Drachen dringt in Dich ein "
        "und Du fuehlst. wie Deine Haut immer schuppiger wird. Die Magie des "
        "Drachens hat von Dir Besitz ergriffen.\n\n"));
    tell_room(environment(killer),BS( "\n\n" + killer->Name() + "%s waelzt "
          "sich im Blut des Drachen und bekommt eine ganz schuppige Haut.\n\\n\nn"),
        ({killer}));
  }
  write_file( LOG "vulak.kills",
        dtime(time())+": "+CAP(getuid(killer))+" toetet "+name(WEN)+".\n");
  ASTRALMASTER->SetTime("draconia");
  ::die(poisondeath);
}

void Attack(object enemy)
{ 
  if (enemy->QueryProp(P_DRAGON_ENEMY) < time() + 180 * 60)
    enemy->SetProp(P_DRAGON_ENEMY, time() + 180 * 60);
  ::Attack(enemy);
}

void AddWaechter(object w)
{
  waechter += ({w});
  waechter -= ({0});
}

int _query_disable_attack() { return 0; }
int _query_disable_spell() { return 0; }
int _query_paralyzed() { return 0; }

