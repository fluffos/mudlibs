// ein Babydrache
// 09-09-2004  Feyaria@SilberLand

#include "../def.h"

inherit NPC "std_draconia_npc";

void create()
{
  int color;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Drachenbaby");
  SetProp(P_GENDER, NEUTER);
  color = random(10);
  SetProp(P_NAME_ADJ, ({"schwarz", "weiss", "gruen", "blau", "rot", "kupfern", 
        "messingfarben", "bronzen", "silbern", "golden"})[color]);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Ein kleiner Babydrache, mit niedlichen kleinen Schueppchen und "
    "suessen Kulleraugen. Allerdings ist er schon groesser als Du, also "
    "sei vorsichtig, denn der kleine Drache koennte Dich leicht verletzen, "
    "auch wenn er nur mit Dir spielen will.");
  AddId(({"babydrache", "baby", "drachenbaby"}));

  AddDetail( ({"schueppchen"}),
      "Niedlich.");
  AddDetail( ({"kulleraugen", "augen"}),
      "Suess.");

  create_default_dragon(1 + color % 5, 0, color/5, 1);

  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft");
  SetProp(P_MMSGIN, "huepft herein");
  SetProp(P_MMSGOUT, "huepft weg");
  SetProp(P_MNPC_WAIT, ({ 30, 20, 20 }));

  SetProp(P_DIE_MSG,  " stirbt einen Babydrachentod.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" frisst @WEN auf.\n" }) );
  AddInfo(DEFAULT_INFO, "schaut Dich verwirrt mit seinen suessen Kulleraugen an.\n");

  SetChats(5, ({
    Name(WER,1)+" will mit Dir spielen.\n",
    Name(WER,1)+" hustet einen kleines Feuerwoelkchen.\n",
    Name(WER,1)+" flattert mit seinen noch sehr kleinen Fluegeln.\n",
    Name(WER,1)+" versucht, seinen eigenen Schwanz zu fangen.\n"}) );

  SUID;
  if (!random(3))
    CLONEME(ARMOUR "babydrachenschild");

  AddCmd( ({"spiel", "spiele"}), "cmd_spielen");
}

int cmd_spielen(string str)
{
  string wem;
  notify_fail("Mit wem willst Du spielen?\n");
  if (sscanf(str, "mit %s", wem) == 1)
    str = wem;
  if (!str || !id(str))
    return 0;
  notify_fail("Im Kampf kannst Du nicht spielen.\n");
  if (InFight() || TP->InFight())
    return 0;

  write("Du spielst etwas mit dem Babydrachen.\n"
      "Der Babdydrache huepft vergnuegt um Dich herum.\n");
  say(TPN + " spielt mit dem Babydrachen.\n", ({TP}));
  return 1;
}

