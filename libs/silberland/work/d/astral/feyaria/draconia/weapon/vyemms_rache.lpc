// Vyemms Rache - eine Axt 
// 16.9.2004 Feyaria

#include "../def.h"
#include "../../gilden.h"

inherit "/std/weapon";

void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Vyemms Rache");
  SetProp(P_NAME, "Vyemms Rache");
  SetProp(P_ARTICLE, 0);
  SetProp(P_LONG,
      "Vyemms Rache ist eine gewaltige Axt, mit einem doppelten Axtblatt und "
      "einem langen Stiel. Ein Axtblatt glaenzt golden, das andere silbern. "
      "Nur maechtige Drachenmagie kann so ein Wunderwerk erschaffen haben.");
  AddId( ({"rache", "axt", "vyemms rache", "\ndraconia_waffe"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, 
      "Da diese Axt drachischen Ursprungs ist, ist sie sicher nicht gut fuer "
      "den Kampf gegen Drachen geeignet, allerdings schuetzt sich aber gut "
      "gegen Drachenatem oder andere Feuerattacken. Alle Feinde der Drachen "
      "wird sie liebend gerne vernichten, vor allem wenn sie schon dem Tod "
      "nahe sind. Du kannst entweder das scharfe goldenene oder das gezackte "
      "silberne Axtblatt verwenden.");
  
  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 285);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_QUALITY_DECAY, 400);

  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 3300);
  SetProp(P_VALUE, 7000);
  SetProp(P_MAGIC, 7);
  SetProp(P_SIZE, 140);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60, A_STR: 35]) );
  SetProp(P_MATERIAL, ([MAT_GOLD: 20, MAT_SILVER: 20, MAT_STEEL: 20, MAT_IRON: 40]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_HIT_FUNC, this_object());
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp("waffenbalsam", 10);
  SetProp(P_BERSERKER_BONUS, (["all": 10]) );

  SUID;
  AddCmd( "verwende|verwend&goldenes|goldene|scharfes|scharfe|"
          "silbernes|silberne|gezacktes|gezackte&blatt|axtblatt|seite", 
      "cmd_verwenden");

  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
} 
  
void _set_autoloadobj(mixed data)
{ 
  SetProp(P_ITEMD_TMPMAGIC, data);
}   
  
mixed _query_autoloadobj()
{ 
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int cmd_verwenden(string str)
{
  if (strstr(str, "silber") != -1 || strstr(str, "gezackt") != -1)
  {
    if (member(QueryProp(P_DAM_TYPE), DT_SLASH) != -1)
    {
      SetProp(P_DAM_TYPE, QueryProp(P_DAM_TYPE) + ({DT_RIP}) - ({DT_SLASH}) );
      write("Du schlaegst nun mit der silbernen gezackten Axtklinge zu!\n");
    } 
    else
      write("Aber Du schlaegst ja bereits mit der silbernen gezackten Axtklinge zu!\n");
    return 1;
  }
  if (strstr(str, "gold") != -1 || strstr(str, "scharf") != -1)
  {
    if (member(QueryProp(P_DAM_TYPE), DT_RIP) != -1)
    {
      SetProp(P_DAM_TYPE, QueryProp(P_DAM_TYPE) - ({DT_RIP}) + ({DT_SLASH}) );
      write("Du schlaegst nun mit der goldenen scharfen Axtklinge zu!\n");
    }
    else
      write("Aber Du schlaegst ja schon mit der goldenen scharfen Axtklinge zu!\n");
    return 1;
  } 
  return 0;
}

int HitFunc(object enemy)
{
  object ob;
  mapping resists;

  if (enemy->id("drache"))
    return -50;
  else if (enemy->QueryProp(P_HP) < enemy->QueryProp(P_MAX_HP) / 10)
    return 10 + random(100);
  else
    return random(23);
}

int WieldFunc(object waffe, int silent)
{
  MENV->AddResistanceModifier( ([DT_FIRE:-0.1]) );
  return 1;
}

int UnwieldFunc(object waffe, int silent)
{
  QueryProp(P_WIELDED)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  object wer;
  if (!is_clone(this_object())) return;
  ::reset();

  if (objectp(wer = QueryProp(P_WIELDED)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Kraft der Drachen fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
}

