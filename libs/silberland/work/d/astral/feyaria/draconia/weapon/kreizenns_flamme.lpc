// Kreizenns Flamme - ein feuriges Schwert
// 16.9.2004 Feyaria

#include "../def.h"
#include "../../gilden.h"

inherit "/std/weapon";

void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Kreizenns Flamme");
  SetProp(P_NAME, "Kreizenns Flamme");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_LONG,
      "Dieses gekruemmte Schwert ist eine der beeidruckendesten Waffen, "
      "die Du jemals gesehen hast. Der elegante Griff besteht aus rotem "
      "Stahl, die Klinge scheint aber eine echte Flamme zu sein, sie "
      "glueht richtig und zuckt hin und her, wie es Feuer eben so tut. "
      "Nur maechtige Drachenmagie kann so ein Wunderwerk erschaffen haben.");
  AddId( ({"flamme", "schwert", "kreizenns flamme", "\ndraconia_waffe"}) );
  SetProp(P_INFO,
      "Dieses maechtige Schwert macht nicht nur Feuerschaden und schuetzt "
      "vor Feuer, sondern kann auch die Feuerresistenz der Gegner verringern. "
      "Ausserdem erleichtert es Gebete an Dusty.");
  
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 195);
  SetProp(P_WC_FIX, 60);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_FIRE}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 7000);
  SetProp(P_SIZE, 100);
  SetProp(P_MAGIC, 7);
  SetProp(P_QUALITY_DECAY, 400);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_MATERIAL, ([MAT_FIRE: 80, MAT_STEEL: 20]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_HIT_FUNC, this_object());
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp("waffenbalsam", 10);
  SetProp(P_PALADIN_SPELLCOST, 10);

  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int HitFunc(object enemy)
{
  object ob;
  mapping resists;

  if (enemy->id("drache"))
    return -50;
  else if (enemy->QueryProp(P_HP) < enemy->QueryProp(P_MAX_HP) / 10)
    return 10 + random(100);
  else if (!random(5) && !present("\ndruiden_resist_mod", enemy) && 
            (!mappingp(resists = enemy->QueryProp(P_RESISTANCE_STRENGTHS)) ||
            1.0 * (resists[DT_FIRE]) <= 0.3))
  {
    ob = clone_object("/gilden/druidenzirkel/obj/resist");
    ob->move(enemy, M_NOCHECK);
    ob->SetVariables(0, "wasser", enemy, random(15000));
  }
  else
    return random(23);
}

void reset()
{
  object wer;
  ::reset();
  if (!is_clone(this_object())) return;

  if (objectp(wer = QueryProp(P_WIELDED)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Feurige Energie fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
}

int WieldFunc(object waffe, int silent)
{
  MENV->AddResistanceModifier( ([DT_FIRE:-0.1]) );
  return 1;
}

int UnwieldFunc(object waffe, int silent)
{
  QueryProp(P_WIELDED)->RemoveResistanceModifier();
  return 1;
}

