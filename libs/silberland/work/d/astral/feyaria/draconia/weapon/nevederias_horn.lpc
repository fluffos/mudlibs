// Nevederias Horn - ein Dolch
// 16.9.2004 Feyaria

#include "../def.h"
#include "../../gilden.h"

inherit "/std/weapon";

void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Nevederias Horn");
  SetProp(P_NAME, "Nevederias Horn");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_LONG,
      "Nevederias Horn ist ein Dolch, der genauso aussieht, wie das Stirnhorn "
      "von Lady Nevederia. Ob es sich hier wirklich um ein Drachenhorn "
      "handelt, laesst sich so einfach nicht sagen. Auf jedenfall kann man "
      "die gewaltige Macht spueren, die in dieser Waffe steckt. "
      "Nur maechtige Drachenmagie kann so ein Wunderwerk erschaffen haben.");
  AddId( ({"dolch", "horn", "nevederias horn", "\ndraconia_waffe"}) );
  SetProp(P_INFO,
      "Diese maechtige Waffe kann dem Gegner einen Todestoss versetzen. "
      "Ausserdem schuetzt das Horn vor Gift und erleichtert nekromantische "
      "Anrufungen.");
  
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 135);
  SetProp(P_WC_FIX, 70);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_PIERCE, DT_UNHOLY, DT_POISON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_QUALITY_DECAY, 400);

  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 7000);
  SetProp(P_MAGIC, 7);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1, P_LEVEL: 60]) );
  SetProp(P_MATERIAL, ([MAT_HORN: 60, MAT_MAGIC: 40]) );
  SetProp(P_M_HEALTH_MOD, ([P_HP: 6, P_SP: 6]) );
  SetProp(P_HIT_FUNC, this_object());
  SetProp(P_WIELD_FUNC, this_object());
  SetProp(P_UNWIELD_FUNC, this_object());
  SetProp("waffenbalsam", 10);
  SetProp(P_NEKRO_SPELLCOST, 5);
  SetProp(P_NEKRO_BONUS, (["all": 5]) );

  SUID;
  SetProp(P_ITEMD_TMPMAGIC, ({2222, 2222}) );
  find_object(ITEMD)->RegisterNewItem(this_object(), TIME_ID);
}

void _set_autoloadobj(mixed data)
{
  SetProp(P_ITEMD_TMPMAGIC, data);
}

mixed _query_autoloadobj()
{
  return QueryProp(P_ITEMD_TMPMAGIC);
}

int HitFunc(object enemy)
{
  object ob;
  mapping resists;

  if (enemy->id("drache"))
    return -50;
  else if (enemy->QueryProp(P_HP) < enemy->QueryProp(P_MAX_HP) / 10)
    return 10 + random(100);
  else if (!random(3))
    return random(enemy->QueryProp(P_ALIGN) / 7);
  else
    return random(23);
}

int WieldFunc(object waffe, int silent)
{
  MENV->AddResistanceModifier( ([DT_POISON:-0.1]) );
  return 1;
}

int UnwieldFunc(object waffe, int silent)
{
  QueryProp(P_WIELDED)->RemoveResistanceModifier();
  return 1;
}

void reset()
{
  object wer;
  if (!is_clone(this_object())) return;
  ::reset();

  if (objectp(wer = QueryProp(P_WIELDED)) && interactive(wer) &&
      (wer->QueryProp(P_HP) < wer->QueryProp(P_MAX_HP) ||
       wer->QueryProp(P_SP) < wer->QueryProp(P_MAX_SP)))
  {
    tell_object(wer, 
        "Die Kraft der Drachen fliesst von " + name(WEM) + " auf Dich ueber.\n");
    wer->heal_self(100 + random(150));
  }
}

