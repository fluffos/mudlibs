// heal - Zauberstab zum Heilen
// 11.10.2004 - Feyaria@SilberLand
//
#include "../def.h"

inherit OBJ "std_zauberstab";

mapping dt = ([
    "rot": DT_FIRE; "feurige",
    "blau": DT_WATER; "waessrige",
    "gruen": DT_POISON; "giftige",
    "weiss": DT_COLD; "eisige",
    "grau": DT_TERROR; "schreckliche",
    "braun": DT_AIR; "luftige", 
    "orangen": DT_LIGHTNING; "blitzende", 
    "gelb": DT_LIGHT; "leuchtende", 
    "golden": DT_MAGIC; "magische", 
    "schwarz": DT_ACID; "aetzende", 
    "violett": DT_SOUND; "laermende", 
    "silber": DT_EXPLOSION; "explodierende",
    "tuerkis": DT_MIND; "geistige",
    ]);

void create()
{
  string adj;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp("ladungen", DAMAGE_LADUNGEN + random(DAMAGE_LADUNGEN));
  SetProp(P_NAME, "Zauberstab der Vernichtung");
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
      Name(WER,0) + ". Ob in diesem kleinen Stoeckchen "
      "wirklich soviel Macht liegt, um jemanden zu vernichten?");
  AddId (({"\nheal", "zauberstab der vernichtung", "vernichtungsstab",
        "vernichtungszauberstab", "zauberstab vernichtung"}));
  SetProp(P_INFO, BS(
        "Mit 'vernichtung <name>' kannst Du einen vernichtenden Zauber "
        "auf Deinen Gegner loslassen. Dazu musst Du aber den Zauberstab "
        "zuecken und " + DAMAGE_COST + " Magiepunkte uebrig haben."));

  AddCmd( ({"vernichtung"}), "cmd_vernichtung");
}

int cmd_vernichtung(string str)
{
  object pl;
  string wie;
  string type;

  if (!check())
    return 0;

  notify_fail("Wen willst Du vernichten?\n");
  if (!str)
    pl = sizeof(TP->PresentEnemies()) ? TP->PresentEnemies()[0] : 0;
  else 
    pl = present(str, ENV(TP));
  if (!pl || !living(pl) || query_once_interactive(pl))
    return 0;

  notify_fail("Deine Magie ist zu schwach fuer eine Vernichtung.\n");
  if (TP->QueryProp(P_SP) < DAMAGE_COST)
    return 0;

  if (TP->QueryProp(P_ATTACK_BUSY))
  {
    write("He! Nicht so schnell!\n");
    return 1;
  }
  TP->SetProp(P_ATTACK_BUSY, 5);

  wie = dt[QueryProp(P_NAME_ADJ)[0], 1];
  type = dt[QueryProp(P_NAME_ADJ)[0], 0];
  write("Eine " + wie + " Aura der Vernichtung rast auf " + pl->name(WEN,1) + " zu.\n");
  say(BS(TP->Name(WER) + " fuchtelt mit " + name(WEM,0) + " in der "
        "Luft herum, murmelt etwas in einer seltsamen Sprache und ploetzlich "
        "rast eine "+wie+" Aura der Vernichtung auf " + pl->name(WEN,1) + "zu."),
      ({pl, TP}));
  pl->Defend( DAMAGE_DAM + random(DAMAGE_DAM), type, 
      ([SP_NAME:"Vernichtung", SP_SHOW_DAMAGE:1]), TP);

  TP->AddSp(-DAMAGE_COST);
  TP->SetProp(P_NEXT_SPELL_TIME, time() + 4);

  after_spell();
  return 1;
}

