inherit "std/unit";

#pragma strong_types

#include "../def.h"

int _set_autoloadobj( mixed args )
{
  if (pointerp(args))
    args=args[0];
  if (stringp(args))
    args=to_int(args);
  if (!intp(args))
    return 0;
  return (int) SetProp(P_AMOUNT,args);
}

int _query_autoloadobj()
{
  return (int) QueryProp(P_AMOUNT);
}

void create()
{
  if (!is_clone(this_object()))
    return;
  
  ::create();

  SetProp(P_LONG, 
      "Solche perfekten Drachenschuppen sieht man nur aeusserst selten und "
      "meist nur bei den aeltesten Drachen. Irgendwie ist die Magie des "
      "Drachen in solchen Schuppen gefangen.");
  SetProp(P_NAME,({"Drachenschuppe","Drachenschuppen"}));
  SetProp(P_NAME_ADJ,({"perfekt"}));
  SetProp(P_SHORT,"Drachenschuppe");
  AddSingularId("schuppe");
  AddPluralId("schuppen");
  AddSingularId("drachenschuppe");
  AddPluralId("drachenschuppen");
  AddId("\nschupp");
  AddAdjective( ({"perfekt", "perfekte", "perfekten"}) );

  SetProp(P_GENDER,FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ({MAT_HORN, MAT_MAGIC}) );
  SetProp(P_MAGIC, 1);
  SetCoinsPerUnits(1,10000);
  SetGramsPerUnits(1,12);
}
