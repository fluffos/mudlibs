// restoration - Zauberstab, um unangehme zustaende zu beenden
// 11.10.2004 - Feyaria@SilberLand
//
#include "../def.h"

inherit OBJ "std_zauberstab";


void create()
{
  string adj;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp("ladungen", RESTORE_LADUNGEN + random(RESTORE_LADUNGEN));
  SetProp(P_NAME, "Zauberstab der Restoration");
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
      Name(WER,0) + ". Ob in diesem kleinen Stoeckchen "
      "wirklich soviel Macht liegt, um jemanden zu heilen?");
  AddId (({"\nrestore", "zauberstab der restoration", "restorationsstab",
        "restorationszauberstab", "zauberstab restoration"}));
  SetProp(P_INFO, BS(
        "Mit 'restoration' kannst Du Dich oder mit 'restoration <name>' einen "
        "anderen Spieler von unangehemen Zustaenden heilen. Dazu musst Du "
        "aber den Zauberstab zuecken und " + RESTORE_COST + 
        " Magiepunkte uebrig haben."));

  AddCmd( ({"restoration"}), "cmd_restoration");
}

int cmd_restoration(string str)
{
  object pl, y;

  if (!check())
    return 0;

  notify_fail("Wen willst Du heilen?\n");
  if (!str)
    pl = TP;
  else if (!objectp(pl = present(str, ENV(TP))) || !interactive(pl))
    return 0;

  notify_fail("Deine Magie ist zu schwach fuer eine Heilung.\n");
  if (TP->QueryProp(P_SP) < RESTORE_COST)
    return 0;

  write(BS("Du fuchtelst mit Deinem Zauberstab herum, deutest auf " + 
      (pl == TP ? "Dich" :  pl->name(WEN)) + " und murmelst etwas in einer "
      "seltsamen Sprache."));
  if (pl != TP)
    tell_object(pl, BS(TP->Name(WER,1) + " deutet mit " + name(WEM,0) + 
        " auf Dich und murmelt etwas in einer setlsamen Sprache."));
  say(BS(TP->Name(WER) + " fuchtelt mit " + name(WEM,0) + " in der "
        "Luft herum, deutet auf " + (TP == pl ? "sich" : pl->name(WEN) ) +
        " und murmelt etwas in einer seltsamen Sprache."), ({pl, TP}));
  if (pl->QueryProp(P_PARALYZED))
  {
    tell_object(pl, "Die Magie des Zauberstabes befreit "
        "Dich von der Paralyse.\n");
    pl->SetProp(P_PARALYZED, 0);
    tell_room(ENV(pl), "Die Magie des Zauberstabes befreit " +
        pl->name(WEN) + " von der Paralyse.\n", ({pl}));
  }
  else if (pl->QueryProp(P_FROG))
  {
    tell_object(pl, "Die Magie des Zauberstabes entfroscht Dich.\n");
    pl->SetProp(P_FROG, 0);
    tell_room(ENV(pl), "Die Magie des Zauberstabes entfroscht " +
        pl->name(WEN) + ".\n", ({pl}));
  }
  else if (pl->QueryProp(P_POISON))
  {
    tell_object(pl, 
        "Die Magie des Zauberstabes entgiftet Dich.\n");
    pl->SetProp(P_POISON, 0);
    tell_room(ENV(pl), "Die Magie des Zauberstabes entgiftet " +
        pl->name(WEN) + ".\n", ({pl}));
  }
  else if (pl->QueryProp(P_BLIND))
  {
    tell_object(pl, 
        "Die Magie des Zauberstabes gibt Dir Dein Augenlicht zurueck.\n");
    pl->SetProp(P_BLIND, 0);
    tell_room(ENV(pl), "Die Magie des Zauberstabes laesst " +
        pl->name(WEN) + " wieder sehen.\n", ({pl}));
  }
  else if (pl->QueryProp(P_DEAF))
  {
    tell_object(pl, 
        "Die Magie des Zauberstabes gibt Dir Dein Hoervermoegen wieder zurueck.\n");
    pl->SetProp(P_DEAF, 0);
    tell_room(ENV(pl), "Die Magie des Zauberstabes laesst " +
        pl->name(WEN) + " wieder hoeren.\n", ({pl}));
  }
  else if (present("\nstrengthdrain", pl))
  {
    tell_object(pl, 
        "Die Magie des Zauberstabes gibt Dir Deine Staerke wieder zurueck.\n");
    while (y = present("\nstrengthdrain", pl))
      y->remove_me();
    tell_room(ENV(pl), "Die Magie des Zauberstabes laesst " +
        pl->name(WEN) + " wieder Staerke gewinnen.\n", ({pl}));
  }
  else if (present("\nmanadrain", pl))
  {
    tell_object(pl, 
        "Die Magie des Zauberstabes befreit Dich von magischem Gift.\n");
    while (y = present("\nmanadrain", pl))
      y->remove_me();
    tell_room(ENV(pl), "Die Magie des Zauberstabes befreit " +
        pl->name(WEN) + " von magischem Gift.\n", ({pl}));
  }
  else if (present("\nbrainstorm", pl))
  {
    tell_object(pl, 
        "Die Magie des Zauberstabes befreit Dich von magischem Gift.\n");
    while (y = present("\nbrainstorm", pl))
      y->remove_me();
    tell_room(ENV(pl), "Die Magie des Zauberstabes laesst " +
        pl->name(WEN) + " wieder klare Gedanken fassen.\n", ({pl}));
  }
  else
  {
    tell_room(ENV(TP), "Die Magie zischt wirkungslos durch den Raum.\n");
  }
  TP->AddSp(-RESTORE_COST);
  TP->SetProp(P_NEXT_SPELL_TIME, time() + 6);

  after_spell();
  return 1;
}

