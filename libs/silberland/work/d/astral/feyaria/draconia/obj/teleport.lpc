// heal - Zauberstab zum Heilen
// 11.10.2004 - Feyaria@SilberLand
//
#include "../def.h"

inherit OBJ "std_zauberstab";

void create()
{
  string adj;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp("ladungen", TELE_LADUNGEN + random(TELE_LADUNGEN));
  SetProp(P_NAME, "Zauberstab der Teleportation");
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
      Name(WER,0) + ". Ob in diesem kleinen Stoeckchen "
      "wirklich soviel Macht liegt, um Dich teleportieren zu koennen?");
  AddId (({"\nheal", "zauberstab der teleportation", "teleport",
        "teleportstab", "teleportatiosstab", "zauberstab teleportation"}));
  SetProp(P_INFO, BS(
        "Mit 'teleportation' kannst Du Dich in den Nexus teleportieren. "
        "Dazu musst Du aber den Zauberstab "
        "zuecken und " + TELE_COST + " Magiepunkte uebrig haben."));

  AddCmd( ({"teleportation"}), "cmd_teleportation");
}

int cmd_teleportation(string str)
{
  object pl;
  string wie;
  string type;

  if (!check())
    return 0;

  notify_fail("Deine Magie ist zu schwach fuer eine Teleportation.\n");
  if (TP->QueryProp(P_SP) < TELE_COST)
    return 0;

  notify_fail("Du kannst Dich nicht im Kampf wegteleportieren!\n");
  if (TP->Infight())
    return 0;

  write(BS("Du fuchtelst mit Deinem Zauberstab in der Luft herum, murmelst "
        "etwas in einer seltsamen Sprache und bist ploetzlich von kleinen "
        "Lichtpunkten umgeben."));
  say(BS(TP->Name(WER) + " fuchtelt mit " + name(WEM,0) + " in der "
        "Luft herum, murmelt etwas in einer seltsamen Sprache und ploetzlich "
        "ist " + TP->QueryPronoun(WER) + " von kleinen Lichtpunkten umgeben."));

  TP->AddSp(-TELE_COST);
  TP->SetProp(P_NEXT_SPELL_TIME, time() + 60);
  call_out("tele", 2, 0);
  after_spell();
  return 1;
}

void tele(int nr)
{
  switch(nr++)
  {
    case 0:
      write(BS("Die Lichtpunkte kreisen wie wild um Deinen Koerper."));
      say(BS("Die Lichtpunkte kreisen wie wild um " + TP->name(WESSEN) + " Koerper."));
      call_out("tele", 2, nr);
      break;
    case 1:
      write(BS("Die Lichtpunkte verdichten sich um Deinen Koeper."));
      say(BS("Die Lichtpunkte verdichten sich um " + TP->name(WESSEN) + " Koeper."));
      call_out("tele", 2, nr);
      break;
    case 2:
      write(BS("Deine Gestalt wird immer heller und verwandelt sich in pures Licht."));
      say(BS(TP->Name(WESSEN) + " Gestalt wird immer heller und verwandelt sich in pures Licht."));
      call_out("tele", 2, nr);
      break;
    case 3:
      write(BS("Deine Gestalt zerfaellt in kleine Lichtpunkte, die sich langsam im Kreis "
            " bewegen."));
      say(BS(TP->Name(WESSEN) +" Gestalt zerfaellt in kleine Lichtpunkte, die sich langsam "
            "im Kreis bewegen."));
      call_out("tele", 2, nr);
      break;
     default: 
      write(BS("Deine Gestalt aus Lichtpunkten explodiert in einem wahren "
            "Lichtschauer.")+"\n");
      say(BS(TP->Name(WESSEN) +" Gestalt aus Lichtpunkten explodiert in einem wahren "
            "Lichtschauer."));
      TP->move(NEXUS, M_TPORT|M_NOCHECK);
  }
}
