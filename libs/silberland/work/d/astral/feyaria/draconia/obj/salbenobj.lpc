// Salbenobj fuer Wirkungen der Salben
// 4.3.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#define MAX_ATTR 3
#define MAX_HP 13

int str, dex, con, intel;
int hp, sp;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NAME, "Salbe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, 0);
  AddId( ({"\nsalbenobj"}) );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_NODROP, 1);

  str = dex = con = intel = hp = sp = 0;
  SUID;
}

int AddModifier(string prop, int value)
{
  if(getuid(previous_object()) != getuid(this_object()))
    return -1;
 
  switch(prop)
  {
    case A_STR: 
      if (str >= MAX_ATTR) return 1;
      str += value; 
      break;
    case A_DEX: 
      if (dex >= MAX_ATTR) return 1;
      dex += value; 
      break;
    case A_CON: 
      if (con >= MAX_ATTR) return 1;
      con += value; 
      break;
    case A_INT: 
      if (intel >= MAX_ATTR) return 1;
      intel += value; 
      break;
    case P_HP: 
      if (hp >= MAX_HEALTH) return 1;
      hp += value; 
      break;
    case P_SP: 
      if (sp >= MAX_HEALTH) return 1;
      sp += value; 
      break;
  }
  MENV->UpdateAttributes();
  return 0;
}

mapping _query_extern_attributes_modifier()
{
  return ([A_STR: str > MAX_ATTR ? MAX_ATTR : str, 
           A_DEX: dex > MAX_ATTR ? MAX_ATTR : dex, 
           A_CON: con > MAX_ATTR ? MAX_ATTR : con, 
           A_INT: intel > MAX_ATTR ? MAX_ATTR : intel]);
}

mapping _query_extern_health_modifier()
{
  return ([P_HP: hp > MAX_HEALTH ? MAX_HEALTH : hp, 
           P_SP: sp > MAX_HEALTH ? MAX_HEALTH : sp]);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  remove();
}

void init()
{
  ::init();
  if (!environment() || !query_once_interactive(environment()))
    remove();
}

void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if (!environment() || !query_once_interactive(environment()))
    remove();
}
