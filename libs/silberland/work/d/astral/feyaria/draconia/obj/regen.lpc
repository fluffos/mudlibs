// regen - Zauberstab fuer regeneration
// 11.10.2004 - Feyaria@SilberLand
//
#include "../def.h"

inherit OBJ "std_zauberstab";


void create()
{
  string adj;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp("ladungen", RESTORE_LADUNGEN + random(RESTORE_LADUNGEN));
  SetProp(P_NAME, "Zauberstab der Regeneration");
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
      Name(WER,0) + ". Ob in diesem kleinen Stoeckchen "
      "wirklich soviel Macht liegt, um sich schneller zu regenerieren?");
  AddId (({"\nregen", "zauberstab der regeneration", "regenstab",
        "regenerationsstab", "regenerationszauberstab",
        "zauberstab regeneration"}));
  SetProp(P_INFO, BS(
        "Mit 'regeneration' bzw 'regen' kannst Du Dich mit einer Aura der Regeneration "
        "umgeben, die Dich und alle anderen Spieler im Raum heilt. "
        "Dazu musst Du aber den Zauberstab zuecken und " + REGEN_COST + 
        " Magiepunkte uebrig haben."));

  AddCmd( ({"regeneration", "regen"}), "cmd_regen");
}

int cmd_regen(string str)
{
  if (!check())
    return 0;

  notify_fail("Deine Magie ist zu schwach fuer die Regenerationsaura.\n");
  if (TP->QueryProp(P_SP) < REGEN_COST)
    return 0;

  notify_fail("Du hast schon eine Regenerationsaura aktiv.\n");
  if (present("\nregenaura", TP))
    return 0;

  write(BS("Du fuchtelst mit Deinem Zauberstab herum, deutest auf "  
      "Dich und alle Awesenden und murmelst etwas in einer "
      "seltsamen Sprache."));
  say(BS(TP->Name(WER) + " fuchtelt mit " + name(WEM,0) + " in der "
        "Luft herum, deutet auf sich und alle Awesenden "
        "und murmelt etwas in einer seltsamen Sprache."), ({TP}));
  TP->AddSp(-REGEN_COST);
  TP->SetProp(P_NEXT_SPELL_TIME, time() + 8);
  CLONE(OBJ "aura", TP);
  after_spell();
  return 1;
}

