// Salben mit diversen Wirkungen
// 4.3.2004 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

int salbe;
mapping prop = ([
    0: "rot-blau"; "wandelt Kraft in Intelligenz"; A_STR; A_INT,
    1: "rot-gruen"; "wandelt Kraft in Ausdauer"; A_STR; A_CON,
    2: "rot-gelb"; "wandelt Kraft in Geschicklichkeit"; A_STR; A_DEX,
    3: "blau-rot"; "wandelt Intelligenz in Kraft"; A_INT; A_STR,
    4: "blau-gruen"; "wandelt Intelligenz in Ausdauer"; A_INT; A_CON,
    5: "blau-gelb"; "wandelt Intelligenz in Geschicklichkeit"; A_INT; A_DEX,
    6 :"gruen-rot"; "wandelt Ausdauer in Kraft"; A_CON; A_STR,
    7 :"gruen-blau"; "wandelt Ausdauer in Intelligenz"; A_CON; A_INT,
    8 :"gruen-gelb"; "wandelt Ausdauer in Geschicklichkeit"; A_CON; A_DEX,
    9 :"gelb-rot"; "wandelt Geschicklichkeit in Kraft"; A_DEX; A_STR,
    10:"gelb-blau"; "wandelt Geschicklichkeit in Intelligenz"; A_DEX; A_INT,
    11:"gelb-gruen"; "wandelt Geschicklichkeit in Ausdauer"; A_DEX; A_CON,
    12:"rot"; "erhoeht die Kraft bis zum naechsten Tod"; A_STR; 1,
    13:"blau"; "erhoeht die Intelligenz bis zum naechsten Tod"; A_INT; 1,
    14:"gruen"; "erhoeht die Ausdauer bis zum naechsten Tod"; A_CON; 1,
    15:"gelb"; "erhoeht die Geschicklichkeit bis zum naechsten Tod"; A_DEX; 1,
    16:"schwarz"; "erhoeht die Lebenspunkte bis zum naechsten Tod"; P_HP; 3,
    17:"weiss"; "erhoeht die Magiepunkte bis zum naechsten Tod"; P_SP; 3,
    ]);
/*
    18:"braun"; "erhoeht die Magenkapazitaet"; P_MAX_FOOD; 10,
    19:"orangen"; "erhoeht die Alkoholvertraeglichkeit"; P_MAX_ALCOHOL; 10,
    20:"violett"; "erhoeht das Trinkvermoegen"; P_MAX_DRINK; 10,
    21:"schwarzschimmernd"; "laesst Dich Lebenspunkte schneller zurueckgewinnen"; P_HP_DELAY; -1,  
    22:"weissschimmernd"; "laesst Dich Magiespunkte schneller zurueckgewinnen"; P_SP_DELAY; -1,
    23:"braunschimmernd"; "laesst Dich schneller hungrig werden"; P_FOOD_DELAY; -1,
    24:"orangeschimmernd"; "laesst Dich schneller nuechtern werden"; P_ALCOHOL_DELAY; -1,
    25:"violettschimmernd"; "laesst Dich schneller durstig werden"; P_DRINK_DELAY; -1,
*/

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  if (random(3))
    salbe = 11 + random(sizeof(prop) - 11);
  else
    salbe = random(sizeof(prop));
  SetProp(P_LONG,
    "Ein kleines Doeschen mit einer Salbe. Du fragst Dich, welche Wirkung "
    "sie haben wird, wenn Du Dich damit einschmierst.");
  SetProp(P_NAME, "Salbe");
  SetProp(P_NAME_ADJ, prop[salbe,0] );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  AddId( ({"salbe"}) );
  AddAdjective( ({prop[salbe,0], prop[salbe,0]+"e", prop[salbe,0]+"en", 
        prop[salbe,0]+"er"}) );
  SetProp(P_INFO, 
      "Diese Salbe "+prop[salbe,1]+"." );

  SetProp(P_MATERIAL, ([MAT_CERAMIC: 20, MAT_FAT:70, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_SIZE, 10);
  SetProp(P_VALUE, 1000);

  AddCmd( ({"schmiere", "schmier"}), "cmd_schmieren");

  SUID;
}

int cmd_schmieren(string str)
{
  string wen, was;
  int v, n;
  
  notify_fail("Wen oder Was willst Du mit Was einschmieren?\n");
  if(!str || sscanf(str, "%s mit %s ein", wen, was) != 2 || !id(was)) 
    return 0;
  notify_fail("Mit dieser Salbe kannst Du Dich nur selbst einschmieren!\n");
  if(wen != "mich" && wen != "mich selbst")
    return 0;
 
  write("Du schmierst Dich mit "+name(WEM)+" ein.\n");
  if(salbe<12)
  {
    v=TP->QueryRealAttribute(prop[salbe,2]);
    n=TP->QueryRealAttribute(prop[salbe,3]);
    if (n < A_MAX)
    {
      TP->SetRealAttribute(prop[salbe,2], --v);
      TP->SetRealAttribute(prop[salbe,3], ++n);
      // [Sat Oct 30 15:56:28 2004] dwarf:helm: dex [now 10] -> str [now 11]
      WLOG( LOG "attr-wandel", sprintf("%s [now %d] -> %s [now %d]",
            prop[salbe,2], v, prop[salbe,3], n));
      log_file("interactive/ATTR_CHANGED",
          sprintf("[%s] %O: %s [now %d] -> %s [now %d] (Salbe)\n",
            ctime(), TP, prop[salbe,2], v, prop[salbe,3], n));
    }
  }
  else
  {
    if(!present("\nsalbenobj", TP))
      CLONE(OBJ "salbenobj", TP);
    if (present("\nsalbenobj", TP)->AddModifier(prop[salbe,2], prop[salbe,3]))
    {
      write("Diese Salbe wuerde bei Dir keine Wirkung haben.\n");
      return 1;
    }
  }
  remove();
  return 1;
}
