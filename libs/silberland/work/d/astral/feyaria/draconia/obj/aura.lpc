// aura - regenerationsaura
// 11.10.2004 - Feyaria@SilberLand
//
#include "../def.h"

inherit "std/thing";

void create()
{
  string adj;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_NAME, "Aura");
  SetProp(P_WEIGHT, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddId (({"\nregenaura"}));
}

void init()
{
  ::init();
  call_out("regen", 2, 0);
}

void regen(int time)
{
  string* filenames;
  object* wer;

  if (time > 1000 ||
      !environment() || 
      !interactive(environment()) || 
      !environment(environment()) ||
      !(filenames = explode(file_name(environment(environment())), "/")) ||
      sizeof(filenames) < 6 || 
      filenames[2] != "feyaria" || 
      member(ALLOWED_ZONES, filenames[3]) == -1)
  {
    if (environment() && interactive(environment()))
      tell_object(environment(), "Deine Regenerationsaura laesst nach.\n");
    remove();
    return;
  }

  wer = filter_array(all_inventory(environment(environment())), #'interactive);
  filter_objects(wer, "heal_self", 2+random(4));
  call_out("regen", 2 + random(10), time + 1 + random(sizeof(wer) - 1));
}

