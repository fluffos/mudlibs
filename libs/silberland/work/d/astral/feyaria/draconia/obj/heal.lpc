// heal - Zauberstab zum Heilen
// 11.10.2004 - Feyaria@SilberLand
//
#include "../def.h"

inherit OBJ "std_zauberstab";


void create()
{
  string adj;

  if (!is_clone(this_object())) return;
  ::create();

  SetProp("ladungen", HEAL_LADUNGEN + random(HEAL_LADUNGEN));
  SetProp(P_NAME, "Zauberstab der Heilung");
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
      Name(WER,0) + ". Ob in diesem kleinen Stoeckchen "
      "wirklich soviel Macht liegt, um jemanden zu heilen?");
  AddId (({"\nheal", "zauberstab der heilung", "heilstab", "heilungsstab",
        "heilzauberstab", "heilungszauberstab", "zauberstab heilung"}));
  SetProp(P_INFO, BS(
        "Mit 'heilung' kannst Du Dich oder mit 'heilung <name>' einen "
        "anderen Spieler heilen. Dazu musst Du aber den Zauberstab "
        "zuecken und " + HEAL_COST + " Magiepunkte uebrig haben."));

  AddCmd( ({"heilung"}), "cmd_heilung");
}

int cmd_heilung(string str)
{
  object pl;
  string wie;

  if (!check())
    return 0;

  notify_fail("Wen willst Du heilen?\n");
  if (!str)
    pl = TP;
  else if (!objectp(pl = present(str, ENV(TP))) || !interactive(pl))
    return 0;

  notify_fail("Deine Magie ist zu schwach fuer eine Heilung.\n");
  if (TP->QueryProp(P_SP) < HEAL_COST)
    return 0;

  notify_fail("Du kannst Dich nicht im Kampf heilen!\n");
  if (TP->Infight() || pl->Infight())
    return 0;

  pl->AddHp(HEAL_HP + random(HEAL_HP));
  if (pl->QueryProp(P_HP) == pl->QueryProp(P_MAX_HP))
    wie = " vollstaendig";
  else
    wie = "";
  write("Du heilst " + (pl == TP ? "Dich" : pl->name(WEN)) + wie + ".\n");
  if (pl != TP)
    tell_object(pl, TP->Name(WER,1) + " heilt Dich" + wie + ".\n");
  say(BS(TP->Name(WER) + " fuchtelt mit " + name(WEM,0) + " in der "
        "Luft herum, murmelt etwas in einer seltsamen Sprache und ploetzlich "
        "schaut " + pl->name(WER) + " geheilt aus.\n"), ({pl, TP}));

  TP->AddSp(-HEAL_COST);
  TP->SetProp(P_NEXT_SPELL_TIME, time() + 4);

  after_spell();
  return 1;
}

