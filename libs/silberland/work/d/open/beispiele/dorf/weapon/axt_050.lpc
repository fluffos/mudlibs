// File:    axt_050.c
// Created by Feyaria@SL
//
// Project: testgebiet
//
// Eine axt mit einer Hitfunc, welche in einer anderen (zentralen) Datei
// liegt (axt_htfunc_051)
//
//=========================================================================

#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Eine Axt");
  SetProp(P_LONG,
    "Eine Axt mit einem kurzen Stiel und einen doppelten Axtblatt.");

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Axt");
  AddId( ({"axt"}) );

  AddDetail( ({"stiel"}),
    "Der Stiel dieser Axt ist sehr kurz."
  );

  AddDetail( ({"axtblatt"}),
    "Diese Axt hat eine doppeltes Axtblatt. Darum kann man auch mit "
    "Rueckhandhieben guten Schaden machen."
  );

//-------------------------------------------------------------------------
// Wenn eine Waffe irgendetwas besonderes kann, sollte man das beim
// identifizieren sehen (bzw erkenne, erblicke, waffenkunde etc.)
//-------------------------------------------------------------------------

  SetProp(P_INFO,
    "Diese Axt wurde von Zwergen geschmiedet und macht extra Schaden gegen "
    "ihre Erzfeinde, die Goblins.");

  SetProp(P_VALUE, 1700);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_MATERIAL, ([ MAT_MISC_WOOD:60, MAT_STEEL:40 ]) );

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_WC, 240);
  SetProp(P_WC_FIX, 20);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 20]) );

//-------------------------------------------------------------------------
// Diese tolle Axt bekommt man als Belohung vom Zwergenkoenig, darum soll
// man sie nicht verkaufen koennen. Setzt man P_NOSELL auf 1, so erhaelt
// man die Meldungen "Du kannst die Axt nicht verkaufen."
//-------------------------------------------------------------------------

  SetProp(P_NOSELL,
      "Du willst doch nicht das Geschenk des Zwergenkoenigs verkaufen!\n");

//-------------------------------------------------------------------------
// Diese tolle Axt bekommt man als Belohung vom Zwergenkoenig, darum soll
// man sie auch nicht jemand anderem geben koennen. Dafuer muss man P_NODROP
// setzen. Allerdings kann man sie dann auch nicht mehr in einen Beutel
// stecken. bei einem Wert von 1 wird kommt die Meldung "Du kannst die Axt
// nicht wegwerfen!".
//-------------------------------------------------------------------------

  SetProp(P_NODROP,
    "Du willst doch nicht das Geschenk des Zwergenkoenigs wegwerfen!\n");

//-------------------------------------------------------------------------
// P_NODROP verhindert nur das weglegen durch den Spieler, es bleibt
// trotzden in der Leiche liegen wenn man stirbt. So koennte man die Waffe
// durch einen Tod an jemanden anderen weitergeben, aber auch das laesst
// sich verhindern. P_NEVERDROP bedeutet, dass diese Waffe beim Tod nicht
// in der Leiche liegen bleibt.
//-------------------------------------------------------------------------

  SetProp(P_NEVERDROP, 1);

//-------------------------------------------------------------------------
// Die Hitfunc ist dieses mal in einem extra-file
// Das File mit der HitFunc darf man aber nicht updaten, sonst verlieren
// alle aktiven Clones der Axt die HitFunc! Um das zu verhindern, holen
// wir uns die hitfunc bei jeden reset neu.
//-------------------------------------------------------------------------

  SetProp(P_HIT_FUNC, find_object(WEAPON "axt_hitfunc_051"));

//-------------------------------------------------------------------------
// An Waffen kann man auch riechen und lauschen, allerdings geht das nicht
// ueber AddSmell und AddSound wie bei Raeumen, sondern mittels P_SMELL
// und P_SOUND
//-------------------------------------------------------------------------

  SetProp(P_SMELL, "Die Axt riecht nach Zwerg.");

}

void reset()
{
  // Auch im Reset braucht man die gleiche Abfrage wie im create
  if( !is_clone(this_object()) ) return;

  // Das Reset von /std/weapon rufen wird zuerst auf
  ::reset();

  // Fals das File mit der Hitfunc upgedatet wurde, steht kein gueltiges
  // Objekt in der Hitfunc und wir setzen sie einfach wieder neu.
  if( !objectp(QueryProp(P_HIT_FUNC)) )
    SetProp(P_HIT_FUNC, find_object(WEAPON "axt_hitfunc_051"));
}

//-------------------------------------------------------------------------
// Das wars vorlaeufig zu den Waffen, man kann zwar noch einige weitere
// Properties setzen, die dann zb Attribute, Lebenspunkte oder
// Gildenfertigkeiten veraendern, aber wenn man so etwas machen will,
// sollte man das sowieso vorher mit seinem Regionsmagier besprechen.
// In /p/weapon gibt es schon 110 vorgefertigte Waffen, sodass man in den
// meisten Faellen dort schon etwas passendes findet.
//-------------------------------------------------------------------------

