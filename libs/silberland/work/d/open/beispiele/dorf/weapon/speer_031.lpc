//
// Project: testgebiet
//
// Ein Speer, welchen man einhaendig und zweihaendig zuecken kann. Fuer
// beide Arten braucht man ungleich viel Staerke, fuer einhaendifzuecken
// viel mehr. Dafuer kann man noch etwas anderes tragen, zB einen Schild
//
//=========================================================================

#include "../def.h"

inherit "std/weapon";

void fuehren(int nr);  // Wir muessen diese Funktion deklarieren, weil wir
                       // sie aufrufen, bevor sie definiert ist.
int check(int nr);

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Speer");
  SetProp(P_LONG,
    "Ein langer Speer mit einer scharfen Spitze, Du kannst ihn mit einer "
    "oder mit beiden Haenden fuehren, allerdings braucht man mehr Kraft, "
    "um den Speer mit nur einer Hand effektiv im Kampf einzusetzen."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Speer");
  AddId( ({"speer"}) );

  AddDetail( ({"spitze", "stahl"}),
      "Die Spitze dieses Speers wurde aus Stahl gefertigt.");

  SetProp(P_VALUE, 200);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MATERIAL, ([ MAT_MISC_WOOD : 80, MAT_STEEL: 20 ]) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 45);
  SetProp(P_UNWIELD_TEXT, ({ "Du steckst den Speer zurueck.\n",
                            " steckt den Speer zurueck.\n" }) );

  AddCmd( ({"fuehre", "fuehr"}), "cmd_fuehren");
  fuehren(2);
}

//-------------------------------------------------------------------------
// Durch Einfuehren der beiden Unterfunktionen wird diese Funktion viel
// uebersichtlicher
//-------------------------------------------------------------------------

int cmd_fuehren(string str)
{
  string was;

  notify_fail("Was willst Du fuehren?\n");
  if(!str || str == "") return 0;

  if( sscanf(str, "%s mit beiden haenden", was) == 1 && id(was) )
  {
    if( !check(2) ) return -1;
    write("Du fuehrst den Speer jetzt mit beiden Haenden.\n");
    fuehren(2);
    return 1;
  }
  else if( sscanf(str, "%s mit hand", was) == 1 && id(was) )
  {
    if( !check(1) ) return -1;
    write("Du fuehrst den Speer jetzt mit einer Hand.\n");
    fuehren(1);
    return 1;
  }
  return 0;
}

//-------------------------------------------------------------------------
// Wir haben die Pruefung ausgelagert, damit der code nicht doppelt
// vorkommt
//-------------------------------------------------------------------------
int check(int nr)
{
  if( QueryProp(P_NR_HANDS) == nr )
  {
    write("Aber Du fuehrst den Speer doch schon mit " +
        (nr == 1 ? "einer Hand" : "beiden Haenden") + "!\n");
    // der (A ? B : C) Operator eignet sich gut, wenn man schnell zwischen 2
    // Moeglichkeiten waehlen will. Ist A wahr, so wird B ausgefuehrt,
    // ansonsten C. Der ? wird auch ternaerer Operator genannt
    return 0;
  }
  if( QueryProp(P_WIELDED) )
  {
    write("Du musst den Speer zuerst wegstecken, um ihn anders "
        "zu fuehren!\n");
    return 0;
  }
  return 1;
}

//-------------------------------------------------------------------------
// In dieser Funktion sieht man jetzt genau, welche Werte sich aendern
// wenn man den Speer anders fuehrt
//-------------------------------------------------------------------------
void fuehren(int nr)
{
  if( nr == 2 )
  {
    SetProp(P_NR_HANDS, 2);
    SetProp(P_WIELDED_TEXT, "mit beiden Haenden gezueckt");
    SetProp(P_WIELD_TEXT, ({ "Du zueckst den Speer mit beiden Haenden.\n",
                            " zueckt einen Speer mit beiden Haenden.\n" }) );
    SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10]) );
  }
  else if( nr == 1 )
  {
    SetProp(P_NR_HANDS, 1);
    SetProp(P_WIELDED_TEXT, "mit einer Hand gezueckt");
    SetProp(P_WIELD_TEXT, ({ "Du zueckst den Speer mit einer Hand.\n",
                            " zueckt einen Speer mit einer Hand.\n" }) );
    SetProp(P_WIELD_RESTRICTIONS, ([A_STR:15]) );
  }
}
