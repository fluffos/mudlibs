#include "../def.h"

inherit "std/weapon";

void create()
{
  if(is_clone(this_object())) return;
  // Wir greifen auf die HitFunc der Blueprint zu, darum sind clones sinnlos
}


// Ein Goblin zum testen findet man hier: /d/kristallwald/sargola/dorf/npc/goblin
int HitFunc(object enemy)
{
  // is_class_member prueft Rasse, Ids und mittels AddClass gesetzte Klassen
  // auf "goblin"
  if( enemy->is_class_member(CL_GOBLIN) )
    // mit WC 240 und 50 bleiben wir unter dem Maximalwert von 300, hoeher
    // sollte man in normalen Faellen nicht kommen, zumindest nicht im Schnitt.
    return 25+random(25);
    // Man koennte es ja auch so machen:
    // if( !random(2) ) return 50+random(50);
    // Jedes zweite Mal den doppelten Wert zurueckgeben.
  return 0;
}


