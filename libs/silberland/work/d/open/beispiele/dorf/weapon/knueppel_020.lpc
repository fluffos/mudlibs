//
// Project: testgebiet
//
//
// Ein einfacher Knueppel. Er wird als unhandlich beschrieben. Dies wird
// mittels zweier Properties beschrieben und auch textuell ueber zwei
// weitere Properties ausgedrueckt.
//
//=========================================================================

#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein unhandlicher Knueppel");
  SetProp(P_LONG,
    "Dieser Knueppel ist eigentlich nicht mehr als ein Baumast und "
    "daher sehr unhandlich und nicht sehr gut zum Kaempfen geeignet."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Knueppel");
  AddId( ({"knueppel", "baumast" }) );

//-------------------------------------------------------------------------
// In der Kurzbeschreibung wird der Knueppel mit dem Adjektiv "unhandlich"
// naeher beschreiben. Damit das Objekt weiss, das es unhandlich ist, und
// sich auch bei anderen Ausgaben als unhandlicher Knueppel ausgibt, sind
// ein paar Zusatzangaben noetig. P_NAME_ADJ gibt das Adjektiv in seiner
// Grundform an, die Mudlib ist in der Lage, in der allermeisten
// Faellen die richtige Konjugation zu ermitteln. Nur in Ausnaehmefaellen
// muss man Dativ Akuusativ usw slebst angeben. Naeheres dazu in der
// manpage zu P_NAME_ADJ
//-------------------------------------------------------------------------

  SetProp(P_NAME_ADJ, ({"unhandlich"}) );

//-------------------------------------------------------------------------
// Damit der Spieler nun auch "nimm unhandlichen knueppel" oder "untersuch
// unhandlichen knueppel" eingeben kann, ist eine weitere Angabe noetig.
// Hier muss man aber alle Faelle selbst angeben, man tut gut daran, einfach
// alle anzugeben. Damit sind dann zwar auch "untersuche unhandlichem knueppel"
// moeglich, aber das stoert eher weniger als vergessene oder vermeitlich
// nicht noetige Faelle.
//-------------------------------------------------------------------------

  AddAdjective( ({"unhandlichen","unhandlicher","unhandlichem"
                 ,"unhandliches","unhandliche"}) );

  SetProp(P_VALUE, 200);
  SetProp(P_WEIGHT, 1000);

//-------------------------------------------------------------------------
// Der Knueppel besteht aus Holz.
// Die Summer der Materialen sollte 100 ergeben (100%).
// Fuer eine Liste aller Materialien: man materialliste
//-------------------------------------------------------------------------

  SetProp(P_MATERIAL, ([ MAT_MISC_WOOD: 100 ]) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 0);  // unhandlich, daher schlechter Fixwert.
  SetProp(P_NR_HANDS, 1);

//-------------------------------------------------------------------------
// Die Abnutzung
// Standardwert ist 100, das bedeutet, dass die Waffe nach 100 Schlaegen
// einen Punkt bei P_WC verliert. Kleinere Werte bedeuten eine schnellere
// Abnutzung und groessere Werte eine langsamere. Der Wert 0 bedeutet
// gar keine Abnutzung, sollte aber nur in Ausnahmefaellen verwendet werden.
// Erreicht die WC 0, so wird die Waffe automatisch zerstoert, man kann es
// aber verhindern indem man P_NO_DAMAGE_DESTRUCT setzt.
//-------------------------------------------------------------------------

  SetProp(P_QUALITY_DECAY, 70); // Der Knueppel nuetzt sich viel schneller ab
                               //  als normale Waffen (100)


}

