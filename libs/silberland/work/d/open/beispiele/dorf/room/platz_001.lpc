//=========================================================================
//
// File:    platz_001.c
// Created by Ronja
//
// Project: testgebiet
//
// Der prinzipielle Aufbau eines Raum wird gezeigt. Kurz- und Lang-
// beschreibung, setzen der Umgebungsvariablen, einige Details sowie
// Ausgaenge werden beschrieben.
//
//=========================================================================

//-------------------------------------------------------------------------
// Definitionen laden
//-------------------------------------------------------------------------

#include "../def.h"

//-------------------------------------------------------------------------
// Als "Vaterobjekt" nehmen wir den Standardraum
//-------------------------------------------------------------------------

inherit "std/room"; //wir erben alle eigenschaften des Standardraumes

void create()

{

//-------------------------------------------------------------------------
// Das Vaterobjekt erstellen
//-------------------------------------------------------------------------

  ::create();

//-------------------------------------------------------------------------
// Kurz und Langbeschreibung angeben
//
// Fuer Gegenstaende, in denen sich die Spieler befinden, gibt man die
// Beschreibung als *INT*erne beschreibung an. Diese Beschreibung
// wird dem Spieler angezeigt, wenn er sich innerhalb der Objekte
// befindet. Gegenstaende, welche von aussen betrachtet werden (zB ein
// Schwert), erhalten P_SHORT und P_LONG. Da sich Spieler normalerweise
// innerhalb von Raeumen befinden, erhalten Raeume ihre Beschreibung
// ueber P_INT_LONG und P_INT_SHORT.
//
// Es gibt Raeume, die sowohl von aussen als auch von innen betrachtbar
// sind, zB Schiffe. Solche Objekte brauchen sowohl P_INT_LONG/P_INT_SHORT
// als auch P_LONG/P_SHORT, da sie der Spieler von aussen und von innen
// betrachten kann.
//-------------------------------------------------------------------------

  SetProp(P_INT_SHORT, "Vor einem Dorf");
  SetProp(P_INT_LONG,
    "Du stehst vor einem Dorf, welches von einer Palisade umgeben ist. "
    "Weitere Details der Landschaft verschwimmen in einem dichten Nebel, "
    "so dass es wohl besser ist, das Dorf in Richtung Norden zu betreten. ");

//-------------------------------------------------------------------------
// Hier soll es normal (=1) hell sein.
//-------------------------------------------------------------------------

  SetProp(P_LIGHT, 1);

//-------------------------------------------------------------------------
// Der Platz befindet sich unter freiem Himmel
//
// Sollte sich der Platz in geschlossenen Raeumen befinden (Haeuser, Hoehlen
// usw) so ist hier 1 statt 0 anzugeben.
//-------------------------------------------------------------------------

  SetProp(P_INDOORS, 0);

//-------------------------------------------------------------------------
// Naehere Angaben zur Umgebung, die Temperatur betraegt 25 Grad, und wir
// befinden und in oder an einer Stadt.
//-------------------------------------------------------------------------

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

//-------------------------------------------------------------------------
// Befindet man sich unter freiem Himmel (P_INDOORS!), so sollte man
// immer Boden und Himmel beschreiben.
//
// Befindet man sich in geschlossen Raeumen, so sollte immer Boden, Wand,
// Waende und Decke beschrieben werden. Teilweise wird in den Beispielen
// hiervon abgewichen, da es nicht Ziel der Beispiele ist, ausdetaillierte
// Raeume, sondern Programmloesungen aufzuzeigen.
//
// Die Funktion AddDetail erwartet 2 Parameter: eine Liste von zu
// untersuchenden Details und deren Beschreibung. Der erste Parameter
// kann auch ein einfacher String sein, man sollte sich aber gleich
// angewoehnen, eine Liste anzugeben. Dies vereinfacht spaeter die Pflege
// und Erweiterung.
//-------------------------------------------------------------------------

  AddDetail( ({"boden"}) ,
    "Du stehst darauf. ");

  AddDetail( ({"himmel"}) ,
    "Den kannst Du vor lauter Nebel nicht erkennen.");

//-------------------------------------------------------------------------
// Ein paar Details aus der Langbeschreibung naeher angeben, zB Nebel,
// Palisade
//-------------------------------------------------------------------------

  AddDetail( ({"palisade"}) ,
    "Sie umgibt das Dorf. Im Norden kann man hindurchgehen und das Dorf "
    "betreten. ");

  AddDetail( ({"nebel"}) ,
    "Dorthin gehst Du besser nicht zurueck.");

  AddDetail( ({"dorf"}) ,
    "Es liegt genau vor Dir.");

  AddDetail( ({"details","landschaft"}) ,
    "Weitere Details verschwimmen im Nebel.");

//-------------------------------------------------------------------------
// Es gibt einen Ausgang, der nach Norden fuehrt. Man landet dann in dem
// Raum "eingang.lpc". Die Extension '.c' sollte nicht mit angegeben werden.
//-------------------------------------------------------------------------

  AddExit("norden", ROOM "eingang_010");

//-------------------------------------------------------------------------
// Der Platz ausserhalb des Dorfes ist auch Landeplatz eines Transporters.
// Daher muss der Ballon auch hier geladen werden. Damit nun aber nicht
// ein Ballon im Start- und einer im Zielraum existiert, wird lediglich
// die Blueprint geladen (1). Dadurch gibt es letzlich nur ein
// Objekt.
//
// Naeheres spaeter zu den Transportern. Wers jetzt erstmal nicht
// verstanden hat, kein Problem, einfach ueberblaettern :)
// Transporter sind nicht ganz so einfach, also nicht an diesem Halte-
// punkt hier festbeissen.
//-------------------------------------------------------------------------

  AddItem(OBJ "ballon", REFRESH_DESTRUCT, 1);

}

