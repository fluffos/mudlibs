//
// AddCmd Beispiel. Es wird gezeigt, wie man Kommandos hinterlegt und
// den Spieler Sachen finden laesst.
//
//=========================================================================

#include "../def.h"

inherit "std/room";

//-------------------------------------------------------------------------
// In diesem Raum soll sich ein Hammer befinden, den man mittels des
// Kommandos "durchwuehlen" finden lassen soll. Damit man nicht unendlich
// oft einen Hammer nehmen kann, ist dieser beschraenkt und wird
// nur einem pro Reset zur Verfuegung gestellt.
//
// Der Muddriver ruft in mehr oder weniger regelmaessigen Abstaenden
// die Funktion void reset() in jedem der geladenenen Objekte auf.
// In diesen Mechanismus werden wir hier eingreifen.
//-------------------------------------------------------------------------

//-------------------------------------------------------------------------
// Die Variable hammer_da speichert, ob ein Hammer gefunden werden kann
// oder nicht.
//-------------------------------------------------------------------------

int hammer_da;

void create()
{
  ::create();

//-------------------------------------------------------------------------
// Wenn das Objekt geladen wird, legen wir fest, dass ein Hammer da sein soll
//-------------------------------------------------------------------------

  hammer_da = 1;

  SetProp(P_INT_SHORT, "Ein kleiner Schuppen" );
  SetProp(P_INT_LONG,
    "Du stehst mitten in einem kleinen Schuppen, der ein wenig Licht "
    "durch die offene Tuer hinter und ein kleines Fenster an der "
    "Ostwand bekommt. Der Boden ist mit Spaene und Dreck bedeckt, rechts "
    "von Dir unter dem Fenster siehst Du eine Werkbank und der Rest des "
    "Schuppens ist mit Geruempel voll geraeumt. Im großen und ganzen hast "
    "Du recht wenig Platz, um Dich zu bewegen.");

//-------------------------------------------------------------------------
// Im Gegensatz zum Eingang und Platz befinden wir uns innerhalb
// (P_INDOORS) und in einem Haus (TT_HOUSE).
//-------------------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 20]) );

  AddDetail( ({"licht"}) ,
    "Durch das Fenster und die Tuer gelangt genug Licht in den Schuppen, "
    "dass Du alles leicht erkennen kannst.");

  AddDetail( ({ "wand","waende" }),
    "Saemtliche Waende sind aus Holz und schlicht gehalten. Hinter Dir "
    "ist der Ausgang, rechts von Dir ein Fenster und eine Werkbank und "
    "entlang der beiden anderen Waende wurde Geruempel aufgestapelt.");

  AddDetail( ({"tuer"}),
    "Die Tuer hinter Dir steht offen und Du kannst jederzeit durch sie "
    "den Schuppen wieder verlassen.");

  AddDetail( ({"fenster"}),
    "Das Fenster ist ziemlich verschmutzt, dass Du gar nicht erkennen "
    "kannst, was draussen vor sich geht, aber immerhin gelangt genug "
    "Licht durch dieses nach Innen, dass Du Dich leicht umsehen kannst.");

  AddDetail( ({"ostwand"}),
    "An der Ostwand sind das Fenster und eine darunter aufgestellte "
    "Werkbank zu sehen.");

  AddDetail( ({ "boden","spaene","holzspaene","dreck" }),
    "Der Boden ist voll mit Holzspaene, als ob jemand kurz vor Dir einige "
    "Saegearbeiten erledigt haette. Ausserdem ist er total verdreckt, dass "
    "keine Ahnung darueber hast, wann hier das letzte Mal geputzt wurde. " );

  AddDetail( ({"werkbank"}),
    "Die Werkbank ist das reinste Chaos. Werkzeuge wurde achtlos "
    "liegengelassen, als ob jemand hier schnell aufbrechen hatte muessen. "
    "Viel brauchbares kannst Du nicht sehen, aber vielleicht bringt es "
    "etwas, wenn Du einmal die Werkzeuge durchwuehlst.");

  AddDetail( ({"rest"}),
    "So gross ist der Rest nicht, da der Schuppen recht klein ist und Du "
    "Dich ohnehin kaum bewegen kannst. Was Dir allerdings gleich klar wird, "
    "ist, dass der Rest des Schuppens Dich wegen des Geruempels nicht "
    "interessiert.");

  AddDetail( ({"geruempel"}),
    "Lauter sinnloses Geruempel fuellt den Schuppen und Du willst Dir "
    "nicht die Muehe machen, jedes einzelne Staubkorn umzudrehen, bis Du "
    "vielleicht etwas findest.");

  AddDetail( ({"platz"}),
    "Falls Du hier laufen wolltest, bist Du am falschen Platz. Du bist froh, "
    "dass Du Dich gerade noch ohne Schwierigkeiten einmal im Kreis "
    "drehen kannst.");

  AddDetail( ({"decke"}),
    "Die Decke ist schaebig, schlicht und aus Holz. Nichts daran erweckt "
    "Deine Aufmerksamkeit.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ziemlich stickig und ausserdem bemerkst Du den Geruch von "
    "Holzspaenen.");

  AddSound( DEFAULT_SOUND,
    "Im Schuppen ist es ganz still. Nicht ein einziges Rascheln ist zu "
    "hoeren.");

//-------------------------------------------------------------------------
// Mit AddCmd wird dem Objekt, hier einem Raum, ein weiteres Kommando
// zugefuegt. Der erste Teil besteht aus einem String oder einem Array mit
// Verben, mit denen die Funktion aufgerufen wird.
// Der zweite Teil ist der Name der Funktion, hier cmd_durchwuehlen, die
// ausgefuehrt werden soll. Der somit neu erzeute Befehl kann sowohl von
// Spielern als auch NPC ausgefuehrt werden. siehe auch: man AddCmd
//
// Damit am Funktionsnamen sofort erkennbar ist, dass es zu einem Kommando
// gehoert, sollte man einen eindeutigen Praefix waehlen.
// In diesen Beispielen wird dazu cmd_ gewaehlt. detail_ als praefix
// haben wir ja schon in einem aehnlichen Fall benutzt, um Funktionen
// einem Special Detail zuzuordnen. Man sollte eine durchgehende Notation
// in seinen Projekten verwenden.
//-------------------------------------------------------------------------

  AddCmd( ({ "durchwuehl","durchwuehle" }), "cmd_durchwuehlen" );

  AddExit( "raus", ROOM "eingang_010");
}

//-------------------------------------------------------------------------
// Hier definieren wir unseren Reset. In diesem wollen wir ja wieder einen
// Hammer zur Verfuegung stellen
//-------------------------------------------------------------------------

void reset()
{
  ::reset(); // nicht vergessen, den reset der Vorgaenger (hier: std/room)
             // aufzurufen. :: Vor einem Funktionsnamen ruft die Funktion
             // im inherit Objekt auf.

  hammer_da = 1; // Der Hammer ist jetzt wieder da
}

//*************************************************************************
// Generelles zum abarbeiten von Kommandos durch den Muddriver
// ===========================================================
// Gibt der Spieler ein Kommando ein, so fragt der Driver jedes Objekt
// im Einflussbereichs des Spielers (Inventar, Raum, NPC und Objekte im
// Raum), ob sie dieses Kommando kennen und behandeln mochten.
// Erhaelt der Driver als Rueckgabe bei dieser Abfrage eine 0, so
// fragt er das naechste Objekte, ob dieses das Kommando kennt bzw
// abarbeiten moechte. Ist kein weiteres Objekt mehr vorhanden und keines
// der Objekte hat das Kommando behandelt (= alle haben 0 zurueckgeliefert)
// so wird die Fehlermeldung ausgegeben, die das zuletzt gefragte
// Objekt mittels der Funktion notify_fail gesetzt hat.
//*************************************************************************

//-------------------------------------------------------------------------
// Die Funktion, welche der Driver aufruft. Die Information darueber
// hat er durch die Funktion AddCmd im Create erhalten.
// Die Funktion bekommt als Parameter die Spielereingabe ohne das
// Verb zur weiteren Syntaxpruefung uebergeben.
//
// Dieser String wird allerdings vom Muddriver veraendert. So werden folgende
// Worte entfernt:
// "das","der","die","des","dem","den","ein","eine","einer","eines"
// "in","aus","ueber","auf","unter","mit","durch","fuer","von","vom",
// "im","aufs","ein","weg","zurueck"
//
// zu guter letzt wird die Eingabe in Kleinbuchstaben umgewandelt.
//
// Gibt der Spieler also "durchwuehle die Werkzeuge" ein, so wird vom
// Driver irgendwann die Funktion cmd_durchwuehlen aufgerufen und ihr als
// Parameter "werkzeuge" uebergeben.
//
// Die Funktion muss nun ueberpruefen, ob sie das behandeln moechte, und
// teilt das dem Driver ueber den Rueckgabe wert mit:
//
//  0: 0 wird zurueckgegeben, wenn mit dem eingegebenen String nichts
//     angefangen werden konnte, also wenn Spieler zB "durchwuehle geruempel"
//     eingegeben hat, dann bekommt er als Rueckmeldung das notify_fail,
//     und dem Spieler sollte somit klar sein, dass er irgendetwas falsch
//     gemacht hat.
//
//  1: wird zurueckgegeben, wenn mit dem Kommando etwas Sinnvolles gemacht
//     werden konnte (im Bsp unten, wenn der Hammer da ist und der Spieler
//     ihn auch an sich nehmen kann). Wird 1 zurueckgegeben, ist es
//     moeglich, dass fuer diese Funktion ein Forscherpunkt vergeben wird.
//
// -1: wird zurueckgegeben, wenn zwar die richtige Syntax eingegeben
//     wurde, der Spieler aber trotzdem nichts dabei erzielt (im Bsp unten,
//     wenn der Spieler die Werkzeuge durchwuehlt, allerdings kein Hammer in
//     dem Augenblick da ist). Hier kann er auch keinen Forscherpunkt bekommen
//
// Anmerkung: Forscherpunkte werden von der Mudlib verwaltet und nicht
//            von den Objekten selbst. Man muss aber selber entscheiden
//            ob gegebenfalls ein FP (sofern vorhanden) vergeben werde soll
//            oder nicht.
//-------------------------------------------------------------------------

int cmd_durchwuehlen(string str)
{
//-------------------------------------------------------------------------
// Zum clonen brauchen wir eine Objekt-Variable.
//-------------------------------------------------------------------------

  object hammer;

//-------------------------------------------------------------------------
// Diese Meldung wird an Spieler ausgegeben, wenn ausser dem Raum auch
// kein anderes Objekt den Befehl verarbeiten konnte. In diesem Beispiel
// wird nach dem Verb der String "werkzeug" oder "werkzeuge" erwartet.
// Erfolgt etwas anderes, sieht Spieler "Was moechtest Du durchwuehlen?"
// Man sollte darauf achten, dass das notify_fail so gewaehlt ist, dass
// es auch einen Hinweis darauf gibt, was falsch gemacht wurde bei der
// Eingabe.
//-------------------------------------------------------------------------

  notify_fail("Was moechtest Du durchwuehlen?\n"); // \n nicht vergessen!

//-------------------------------------------------------------------------
// Wenn kein String uebergeben wurde oder der String leer ist, teilen
// wir dem Driver mit, dass wir uns nicht angesprochen fuehlen
//-------------------------------------------------------------------------

  if(!str || str == "") return 0;

//-------------------------------------------------------------------------
// Hat der Spieler nicht "werkzeug" oder "werkzeuge" eingegeben, ist
// eventuell jemand anderes zustaendig. Aber diese Funktion in diesem
// Objekt ist es nicht.
//-------------------------------------------------------------------------

  if(!(str == "werkzeug"  ||           //lies: wenn str nicht (werkzeug
       str == "werkzeuge" )) return 0; //      oder werkzeuge) ist, 0
                                       //      zurueckgeben

//-------------------------------------------------------------------------
// Der spieler hat an dieser Stelle im Programm also eine korrekte
// Syntax eingegeben. Jetzt schauen wir, ob ueberhaupt ein Hammer
// gefunden werden kann
//-------------------------------------------------------------------------

  if(hammer_da != 1)
  {
//-------------------------------------------------------------------------
// Jetzt teilen wir dem Spieler mit, dass es nichts zu finden gibt.
//
// TP ist ein Makro fuer this_player() und enthaelt den Spieler, der
// das Kommando eingegegen hat. BS ist ein Makro fuer break_string
// welches lange Strings so umbricht, dass sie in einem telnet Fenster
// lesbar sind (laengstens 78 Zeichen lange Zeilen.
//-------------------------------------------------------------------------

    tell_object(TP, BS("Du durchwuehlst die Werkzeuge, kannst aber nichts "
                       "finden, was Du gebrauchen koenntest."));

//-------------------------------------------------------------------------
// Jetzt noch eine Meldung fuer den Raum. TO ist ein Makro fuer
// this_object(). Zusaetzlich legen wir fest, dass TP (also der Spieler)
// die Meldung nicht bekommt (den haben wir ja schon unterrichtet)
//-------------------------------------------------------------------------

    tell_room(TO,BS(TP->Name()+" durchwuehlt etwas und macht einen "
                    "Mordslaerm dabei"), ({ TP }) ); // keine Ausgabe an TP!

//-------------------------------------------------------------------------
// Wenn der Hammer nicht da ist, so passiert auch nichts weiter. Es soll
// (sofern ein Forscherpunkt fuers durchwuehlen gesetzt wurde) aber
// in diesem Fall kein Forscherpunkt vergeben werden. Daher geben wir
// -1 zurueck.
//-------------------------------------------------------------------------

    return -1;
  }

//-------------------------------------------------------------------------
// Jetzt clonen wir den Hammer. Dabei sollte geschaut werden, ob es
// einen solchen Gegenstand schon gibt. Wenn ja, clonen wir natuerlich
// diesen statt unseren eigenen Hammer zu definieren. Eine Menge Sachen
// sind schon vorhanden. Bitte unbedingt vorher erkundigen und vorhandene
// Sachen wieder verwenden, statt andauernd das Rad neu zu erfinden.
//-------------------------------------------------------------------------

  hammer = clone_object("/p/weapon/club/hammer");

//-------------------------------------------------------------------------
// Jetzt haben wir den Hammer geclont. Er existiert nun im Nirwana,
// wir muessen den Hammer nun in des Inventar des Spielers bewegen.
// Dabei kann es natuerlich passieren, dass der Spieler den Hammer
// gar nicht mehr tragen kann. Wir rufen im Hammer die Funktion move
// auf, welcher wir den Spieler als Ziel angeben. Zusaetzlich
// setzen wir noch die richtige Methode, in diesem Fall bewegen
// wir ein Objekt vom Nirwana = leblos in einen Spieler = lebendes
// Objekt. Die Methode dazu ist M_GET. Wird ein Objekt von einem NPC
// zu einen Spieler bewegt, so ist M_GIVE zu nehmen. naeheres zu den
// Methoden findet man in der manpage zu move
//-------------------------------------------------------------------------

  if (hammer->move(TP,M_GET) < 0)
  {
//-------------------------------------------------------------------------
// Im hammer wird mit -> die Funktion move aufgerufen und
// somit in TP(=this_player()) mit M_GET bewegt.
// Das Gewicht des Objektes hammer, das dort mit P_WEIGHT gesetzt wurde,
// wird ueberprueft, wenn es zu schwer wird, komtt ein Rueckgabewert kleiner
// als 0, in diesem Fall ME_TOO_HEAVY.
// Man kann die Fehlermeldung auch genauer unterscheiden, aber meist genuegt
// die einfache < 0 Abfrage.
//
// Wenn der Hammer also zu schwer ist, laesst der Spieler den Hammer fallen.
// Fallenlassen bedeutet, wir muessen den Hammer in diesen Raum bewegen
// = this_object() = TO. Eine anderes Vorgehen waere, den Hammer
// wieder zurueckzulegen und ihn zu entfernen.
// Also:
//   - Ausgabe an den Spieler,
//   - Ausgabe an den Raum,
//   - hammer in den Raum bewegen.
//-------------------------------------------------------------------------

    tell_object(TP,BS("Du entdeckst einen Hammer in den Werkzeugen, "
                      "allerdings ist er Dir zu schwer und faellt zu "
                      "Boden."));

    tell_room(TP->Name()+" laesst einen Hammer zu Boden fallen.\n", ({ TP }) );

//-------------------------------------------------------------------------
// Da der Hammer in diesem Fall dem Spieler zu schwer ist, wird
// er in den Raum (TO = this_object()) mit M_NOCHECK (also keine
// Ueberpruefung, ob Objekt(=der Raum selbst) den Hammer
// aufnehmen kann) und M_SILENT (ohne weiterer Textausgabe)
// bewegt.
//-------------------------------------------------------------------------

    hammer -> move(TO, M_NOCHECK|M_SILENT);
  }
  else
  {
//-------------------------------------------------------------------------
// Konnte der Spieler den Hammer noch nehmen, teilen wir ihm dieses mit
//-------------------------------------------------------------------------

    tell_object(TP,BS("Beim Durchwuehlen der Werkzeuge entdeckst Du einen "
                      "Hammer, den Du gleich einsteckst."));

    tell_room(TO,BS(TP->Name()+" durchwuehlt die Werkzeuge auf der "
                    "Werkzeugbank und entdeckt etwas dabei, dass "
                    +TP->QueryPronoun(WER)+" sofort etwas einsteckt."),
                    ({ TP }) );
  }

//-------------------------------------------------------------------------
// So, der Spieler hat den Hammer oder er liegt im Raum, jetzt nicht
// vergessen, die Statusvariable auf 0 zu setzen, damit bis zum
// naechsten Reset kein Hammer mehr gefunden werden kann
//-------------------------------------------------------------------------

  hammer_da = 0;

  return 1;
}



