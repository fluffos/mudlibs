//=========================================================================
//
// File:    wiese_030.c
// Created by Ronja
//
// Project: testgebiet
//
// Mit Hilfe von all_inventory und filter_objects werden Haustiere auf
// einer Wiese gezaehlt. Gleichzeitig werden NPCs mit AddItem in den
// Raum gestellt.
//
//=========================================================================

#include "../def.h"

inherit "std/room"; //wir erben alle eigenschaften des Standardraumes

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer Wiese");
  SetProp(P_INT_LONG,
    "Du stehst auf einer kleinen Wiese. Hier finden wohl Versammlungen "
    "statt. Ansonsten wird sie wohl genutzt, um kleineren Haustieren "
    "ein wenig Auslauf zu geben. Im Nordwesten steht ein Baum.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"boden"}) ,
    "Du stehst auf einer Wiese.");

  AddDetail( ({"nordwesten"}) ,
    "Im Nordwesten steht ein Baum.");

  AddDetail( ({"baum"}) ,
    "Du bist zu weit weg.");

  AddDetail( ({"himmel"}) ,
    "Der Himmel zeigt nichts besonderes.");

  AddDetail( ({"gras"}) ,
    "Auf der Wiese waechst Gras.");

  AddDetail( ({"auslauf"}) ,
    "Auch kleinere Haustiere brauchen mal Auslauf.");

  AddDetail( ({"versammlung","versammlung"}) ,
    "Momentan findet wohl keine statt.");

//-------------------------------------------------------------------------
// Bei dem Detail "wiese" machen wir es uns einfach und geben einfach
// nochmal die Langbeschreibung aus. Dazu fragen wir einfach die
// Property (Eigenschaft) P_INT_LONG ab und fuegen sie als Beschreibung
// ein.
//-------------------------------------------------------------------------

  AddDetail( ({"wiese"}) ,
    QueryProp(P_INT_LONG)
  );

//-------------------------------------------------------------------------
// Bei der Beschreibung des Details "Haustier" geben wir nun nicht einfach
// einen Text aus, sondern schauen erst nach, ob und wieviele Haustiere
// sich ueberhaupt auf der Wiese befinden. Das geht wie schon beschrieben
// mit AddSpecialDetail
//-------------------------------------------------------------------------

  AddSpecialDetail( ({"haustiere","haustieren","tiere"}), "detail_tiere");

//-------------------------------------------------------------------------
// Auf dieser Wiese soll ein Schaf herumstehen. Zusaetzliche Objekte
// in Raeumen werden mit AddItem hinzugefuegt. Zu den REFRESH_* Werten
// bitte die Dokumentation mit "man AddItem" durchlesen. Und wo ein
// Schaf ist ist auch ein Schaefer nicht weit.
//-------------------------------------------------------------------------

  AddItem(NPC "schaf_010",    REFRESH_DESTRUCT);
  AddItem(NPC "lamm_040",     REFRESH_DESTRUCT);
  AddItem(NPC "schaefer_020", REFRESH_DESTRUCT);

//-------------------------------------------------------------------------
// Und nun noch die Ausgaenge
//-------------------------------------------------------------------------

  AddExit("sueden",     ROOM "eingang_010");
  AddExit("westen",     ROOM "schmiede_040");
  AddExit("suedwesten", ROOM "wiese_050");
  AddExit("nordosten",  ROOM "platz_060");
  AddExit("nordwesten", ROOM "baum_070");

  AddExit("kneipe",     ROOM "kneipe_120");
  AddExit("laden",      ROOM "laden_100");
}

//-------------------------------------------------------------------------
// Funktion zur Ausgabe des Details tiere
//-------------------------------------------------------------------------

string detail_tiere(string str)
{
  string s;

//-------------------------------------------------------------------------
// Um festzustellen, wieviel Tiere sich in diesem Raum befinden,
// brauchen wir ein Array, welches diese Tiere erstmal beinhaltet.
// Wir suchen nach Objekten, der Typ der Variablen ist also object.
// Ein * vor dem Variablnamen kennzeichnet ein Array, also eine Variable,
// die mehrere Werte speichern kann.
//-------------------------------------------------------------------------

  object *tiere;

//-------------------------------------------------------------------------
// Um nun alle Tiere im Raum zu bekommen, holen wir uns alle Objekte
// die sich im Raum befinden. Dies erledigt die Funktion all_inventory
// (siehe auch manpage), die von einem Objekt das komplette Inventar
// zurueckliefert. Das zu untersuchende Objekt ist also dieses Objekt,
// auf englisch this_object() oder als Makro TO.
//-------------------------------------------------------------------------

  tiere = all_inventory(TO);

//-------------------------------------------------------------------------
// So, nun haben wir alle Objekte, die sich in diesem Raum befinden, in
// einem Array. Doch dieses Array enthaelt auch alle Spieler, Waffen
// und sonstige Gegenstaende, die sich im Raum befinden. Wir wollen
// jedoch nur die Haustiere haben. Das Array muss also noch gefiltert
// werden. Dies erledigt die Funktion filter_objects (siehe
// man filter_objects). Diese Funktion ruft nun in jedem Element unseres
// Arrays eine Funktion auf und uebergibt ihr weitere Parameter:
//-------------------------------------------------------------------------

  tiere = filter_objects(tiere,"id","haustier");

//-------------------------------------------------------------------------
// Es wird also das Array tiere gefiltert. Fuer jedes Element in diesem
// Array wird die Funktion /id/ mit dem Parameter "haustier" aufgerufen.
// Gibt die Funktion /id/ 0 zurueck, so wird das Element herausgeflitert,
// ansonsten uebernommen.
//
// Die Funktion id identifiziert ein beliebiges Objekt und schaut nach,
// ob der Parameter, in diesem Fall "haustier" mit AddId zugefuegt
// wurde. Bitte lies unbedingt in den man pages /id/ und /AddId/ nach.
//
// Der Obige Funktionsaufruf liest sich folgerndermassen:
// Fuer jedes Objekt in dem Array "tiere" rufe die Funktion "id" in diesem
// Objekt auf und uebergebe ihm den Parameter "haustier". Gibt die
// Funktion "id" 0 zurueck, so uebernimm das Objekt nicht.
//-------------------------------------------------------------------------

//-------------------------------------------------------------------------
// So, an dieser Stelle haben wir nun ein Array, indem sich nur Objekte
// befinden, die auch die id "haustier" haben. Daran muessen wir bei der
// Programmierung unserer Haustiere denken. Wie nehmen nun die Anzahl
// (siehe sizeof) und geben lediglich aus, ob sich keines, ein oder einige
// Haustiere auf der Wiese befinden.
//-------------------------------------------------------------------------

  switch(sizeof(tiere))
  {
    case 0:
      s = "Es befinden sich zur Zeit keine Haustiere auf der Wiese.";
      break; //nicht vergessen, sonst werden die anderen cases auch noch
             //bearbeitet

    case 1:
      s = "Es befindet sich nur ein Haustier auf der Wiese.";
      break;

    default: // wird benutzt, sofern kein case zugetroffen hat.
      s = "Es laufen einige Haustiere auf der Wiese herum.";
      break;
  }

//-------------------------------------------------------------------------
// So, jetzt den String zurueckliefern, natuerlich ordentlich formatiert.
//-------------------------------------------------------------------------

  return BS(s);
}


