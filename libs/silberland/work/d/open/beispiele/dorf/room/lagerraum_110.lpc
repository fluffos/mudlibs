//
// Ein Lagerraum fuer den Laden. Jeder Laden muss einen Lagerraum
// zugeordnet haben, in welchem die Gegenstaende, die ein Spieler
// verkauft, zwischengelagert werden.
//
//=========================================================================

//-------------------------------------------------------------------------
// Der Lagerraum hat spezielle Funktionien und Einstellungen. Darum
// inheriten wir std/store
//-------------------------------------------------------------------------
inherit "std/store";

#include "../def.h"

void create()
{
  ::create();
//-------------------------------------------------------------------------
// Der Haendler hat am Anfang nur 3 Fackeln pro Reset zum Verkaufen. Alles
// andere muss von Spielern hier verkauft werden, um so das Angebot des
// Haendler zu erhoehen.
// Stempel und Geldboerse gibt es immer zu kaufen.
//-------------------------------------------------------------------------
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/fackel", REFRESH_REMOVE);
  AddItem("/obj/fackel", REFRESH_REMOVE);
}
