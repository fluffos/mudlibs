//
// AddSpecialDetail Beispiel. Beim untersuchen des Bodens ist manchmal
// ein kleiner Kaefer zu beobachten.
//=========================================================================

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Dorfplatz");
  SetProp(P_INT_LONG,
    "Du befindest Dich mitten im Dorf. Sehr gross ist es nicht. Ein paar "
    "Schuppen und ein paar aeltere Haeuser stehen hier. ");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"dorf"}) ,
    "Du stehst mittendrin.");

  AddDetail( ({"schuppen"}) ,
    "Du siehst mehrere Schuppen.");

  AddDetail( ({"haeuser"}) ,
    "Sie sind alt und teilweise verfallen, einige aber durchaus noch "
    "bewohnbar. ");

//-------------------------------------------------------------------------
// Ein besonderes Detail, das etwas Programmierung verlangt
//
// Hier wird kein Satz ausgegeben, sondern die Funktion "detail_boden"
// aufgerufen, wenn der Spieler den Boden untersucht. Diese Funktion
// erhaelt das untersuchte Detail als Parameter und muss selbst
// einen String zurueckliefern.
//-------------------------------------------------------------------------

  AddSpecialDetail( ({"boden"}), "detail_boden");

  AddExit("sueden",   ROOM "platz_001");    //zurueck zu dem platz vor dem dorf
  AddExit("norden",   ROOM "wiese_030");    //auf die Dorfwiese
  AddExit("schuppen", ROOM "schuppen_020"); //einen der Schuppen kann man betreten
}

//-------------------------------------------------------------------------
// Die Funktion, welche aufgerufen wird, wenn man den Boden untersucht.
// Es empfiehlt sich, am Funktionsnamen zu hinterlegen, woher die
// Funktion aufgerufen wird, hier wird das mit dem praefix "detail_"
// gemacht. Damit ist ersichtlich, dass diese Funktion aus einem
// Specialdetail heraus aufgerufen wird.
//-------------------------------------------------------------------------

string detail_boden(string str)
{
  string s;

//-------------------------------------------------------------------------
// Ab und zu soll sich auf dem Boden ein Kaefer aufhalten,
// der fluechtet, wenn man ihn entdeckt. Dazu waehlt man
// zB eine Zufallszahl zwischen 0 und 9, bei einer bestimmten Zahl
// gibt man einen speziellen Text aus.
//-------------------------------------------------------------------------

  if(random(10) == 5)
  {
    s = "Du stehst auf festem Boden. Du kannst einen kleinen Kaefer "
        "erkennen, der eilig fluechtet. ";
  }
  else
  {
    s = "Du stehst auf festem Boden. Du kannst nichts besonderes erkennen. ";
  }

//-------------------------------------------------------------------------
// Die Funktion BS ist eigentlich ein Makro, welches fuer die
// die Funktion break_string steht. Naeheres siehe /sys/moredef.h
// Hat man die def.h Dateien in seinem Gebiet und unter seinem Magier-
// namen korrekt angelegt, so wird diese Datei automatisch geladen.
//
// break_string bzw die Abkuerzung BS bricht einen String nach 78 Zeichen
// um, damit beim Spieler eine brauchbare Formatierung des Textes
// ankommt.
//-------------------------------------------------------------------------

  return BS(s);
}

