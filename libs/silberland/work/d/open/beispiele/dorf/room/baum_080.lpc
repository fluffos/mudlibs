//
// Project: Beispielgebiet
//
// Landeplatz fuer einen Transporter (Ballon). Siehe auch den Raum
// eingang_001.c und das objekt ballon.c. Desweiteren wird eine
// Tuer aufgezeigt (mittels NewDoor), die in ein Baumhaus fuehrt.
//
//=========================================================================

#include "../def.h"

inherit "std/room"; //wir erben alle eigenschaften des Standardraumes

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Baumkrone");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer Baumkrone. Du kannst wieder "
    "hinunterklettern.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"boden"}) ,
    "Der ist weit unter Dir. Hoffentlich faellst Du nicht hinunter.");

  AddDetail( ({"himmel"}) ,
    "Der Himmel zeigt nichts besonderes.");

  AddExit("runter", ROOM "baum_070");

//-------------------------------------------------------------------------
// Eine Tuer zu einem Baumhaus. Eine Tuer muss folgendes koennen:
//
// - sie braucht eine Richtung, die (sofern die Tuer geoeffnet ist)
//   in der Liste der Ausgaenge auftaucht. Dabei muss man nicht eine
//   der Himmelrichtungen benutzen.
// - Sie muss in einen anderen Raum fuehren
// - Sie muss vom Spieler ansprechbar sein
// - Sie sollte in der Langbeschreibung zu sehen sein, braucht also einen
//   einen Namen
// - damit sie korrekt behandelt wird, braucht sie ein Geschlecht
// - Sie braucht eine Lang- und eine Kurzbezeichnung. Weitere Details
//   muessen allerdings in die Raumdatei - also hier - eingefuegt werden
// - Wenn der Spieler die Tuer durchschreitet, dann kriegt er eine Meldung,
//   die Spieler im Raum, den er verlaesst, und natuerlich die Spieler
//   in dem Raum, den er betritt
// - Oeffnet der Spieler die Tuer, so erhaelt natuerlich er eine Meldung,
//   die Spieler im gleichen Raum und die Spieler im anderen Raum
// - Dasgleiche natuerlich auch, wenn die Tuer geschlossen wird
// - Evtl soll sich die Tuer im Reset oeffnen/scliessen, auch dafuer
//   gibt es eine Meldung.
//
// So, und nun das ganze in einen Funktionsaufruf packen. Dieser
// Funktionsaufruf befindet sich am Ende dieser Datei nochmals ohne
// die ganzen Zwischenkommentare.
//-------------------------------------------------------------------------

//Der eigentliche Funktionsaufruf:

  NewDoor(

//jetzt die "Richtung" baumhaus

  ({"baumhaus"}),

// die "andere" Seite ist das baumhaus_130

  ROOM "baumhaus_130" ,

// die Tuer soll als "tuer" und als "holztuer" ansprechbar sein

  ({"tuer","holztuer"}) ,

//-------------------------------------------------------------------------
// Die weiteren Parameter stehen in einem array, wobei der Name des
// Parameters und dessen Wert abwechselnd angegeben werden muessen:
//
//  ({paramater1, wert1
//   ,parameter2, wert2
//   ,parameter3, wert3
//   })
//-------------------------------------------------------------------------

// Array mit Parameter/Wert Paaren. Die Tuer soll am Anfang geschlossen
// sein und sich im Reset auch wieder schliessen

    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL

// Die Tuer braucht einen Namen

     ,D_NAME, "Holztuer"

// und ein Geschlecht

     ,D_GENDER, FEMALE

// die Kurzbeschreibung. %s wird sofern vorhanden, durch "geschlossen" bzw
// "geoeffnet" ersetzt. Der Tuer weiblich ist, muessen wir noch selbst
// ein "e" anhaengen, um "geoeffnete" oder "geschlossene" zu erhalten

     ,D_SHORT, "Eine %se Holztuer."

// Langbeschreibung

     ,D_LONG, "Durch diese Tuer kannst Du ein kleines Baumhaus "
              "betreten."

// Meldungen wenn der Spieler durch die Tuer geht. Die drei Werte
// enstprechen dir, textout und textin des move-Befehls.

     ,D_MSGS,    ({"in das Baumhaus","krabbelt","kommt hereingekrabbelt"})

// Meldungen wenn der Spieler die Tuer oeffnet. %s wird durch den Spieler-
// Namen ersetzt. Auf den Space am Anfang in der 3. Meldung fuer die
// andere Seite achten! Der Name der Tuer wird automatisch davir gesetzt.

     ,D_OPENMSG, ({"Du oeffnest die Holztuer.",
                   "%s oeffnet die Holztuer.",
                  " wird knarrend von draussen geoeffnet."})

// Jetzt das gleiche wenn die Tuer geschlossen wird.

     ,D_CLOSEMSG, ({"Du schliesst die Holztuer.",
                    "%s schliesst die Holztuer.",
                    " wird von draussen geschlossen."})

// Jetzt noch eine Meldung, wenn sich die Tuer im Reset schliesst. Muss
// Natuerlich entsprechend den Flags passen, d.h. Wenn in D_FLAGS festgelegt
// wird, das die Tuer im Reset aufgeht muss man natuerlich D_RESET_OPENMSG
// setzen.

     ,D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen."

// jetzt noch die Klammern fuer das Mapping schliessen

     })

// und diese Klammer schliessen den Funktionsaufruf NewDoor

  );

//-------------------------------------------------------------------------
// Der Aufruf von NewDoor ist sehr maechtig. Man kann damit Tueren machen
// die Schluessel brauchen, Tueren die nur in einem Raum existieren
// aber im anderen nicht, oder nur auf einer Seite einen Schluessel
// brauchen. Man kann Falltueren, Gitter, Tore, Deckel und viele andere
// Sachen machen. NewDoor sollte man immer in Erwaegung ziehen, wenn
// man etwas auf/zumachen kann und der Spieler anschliessend hindurchgehen
// kann.
//-------------------------------------------------------------------------

//-------------------------------------------------------------------------
// In der Longbeschreibung der Tuer taucht das Wort "Baumhaus" auf, das
// hier naeher beschreiben werden muesste:
//-------------------------------------------------------------------------

  AddDetail( ({"baumhaus"}) ,
    "Wie man das wohl hineinkommt?");

//-------------------------------------------------------------------------
// Auch hier wird der Ballon, allerdings nur die Blueprint, kein Clone
// Dadurch wird sichergestellt, dass es auch nur einen Ballon gibt.
//-------------------------------------------------------------------------

  AddItem(OBJ "ballon", REFRESH_DESTRUCT, 1);
}

//-------------------------------------------------------------------------
// Hier der Funktionsaufruf nochmals kompakt:
//
//  NewDoor( ({"baumhaus"}), ROOM "baumhaus_130" , ({"tuer","holztuer"}) ,
//    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
//     ,D_NAME, "Holztuer"
//     ,D_GENDER, FEMALE
//     ,D_SHORT, "Eine %se Holztuer."
//     ,D_LONG, "Durch diese Tuer kannst Du ein kleines Baumhaus "
//              "betreten."
//     ,D_MSGS,    ({"in das Baumhaus","krabbelt","kommt hereingekrabbelt"})
//     ,D_OPENMSG, ({"Du oeffnest die Holztuer.",
//                   "%s oeffnet die Holztuer.",
//                  " wird knarrend von draussen geoeffnet."})
//     ,D_CLOSEMSG, ({"Du schliesst die Holztuer.",
//                    "%s schliesst die Holztuer.",
//                    " wird von draussen geschlossen."})
//     ,D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen."
//     })
//  );
//-------------------------------------------------------------------------

