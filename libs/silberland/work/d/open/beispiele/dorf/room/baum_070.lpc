//=========================================================================
//
// File:    baum_070.c
// Created by Ronja
//
// Project: Beispielgebiet
//
// Ein Ausgang wird gezeigt, der nicht ueber AddExit realisiert ist,
// sondern ueber move. Der Spieler wird in einen anderen Raum bewegt.
//
//=========================================================================

#include "../def.h"

inherit "std/room"; //wir erben alle eigenschaften des Standardraumes

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem Baum");
  SetProp(P_INT_LONG,
    "Du stehst vor einem grossen Baum. Du koenntest hinaufklettern.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({"boden"}) ,
    "Der Boden ist von Wurzeln durchzogen.");

  AddDetail( ({"wurzel","wurzeln"}) ,
    "Das sind ziemlich maechtige Wurzeln.");

  AddDetail( ({"himmel"}) ,
    "Der Himmel zeigt nichts besonderes.");

//-------------------------------------------------------------------------
// Der Spieler soll mit dem kommando kletter auf den Baum hinaufklettern
// koennen
//-------------------------------------------------------------------------

  AddCmd( ({"kletter","klettere"})      , "cmd_klettern");

//-------------------------------------------------------------------------
// Und nun noch die Ausgaenge
//-------------------------------------------------------------------------

  AddExit("suedosten", ROOM "wiese_030");
}

//-------------------------------------------------------------------------
// Funktion fuers klettern
//-------------------------------------------------------------------------

int cmd_klettern(string str)
{
  notify_fail("Worauf moechtest Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf baum"         ||
       str == "auf baum hinauf"  ||
       str == "rauf"             ||
       str == "hinauf"           )) return 0; //wir wollen ja kein syntax
                                              //raetsel

//-------------------------------------------------------------------------
// Vorbedingungen gibt es keine, wir koennen also gleich loslegen. Der
// Spieler wird mit dem Kommando move bewegt, und zwar mittels der
// Methode M_GO. move bekommt dann noch drei weitere Parameter,
// naemlich die Richtung, den Text zum Verlassen und den text, den
// der Zielraum bekommt.
//-------------------------------------------------------------------------

  TP->move(ROOM "baum_080",M_GO,"den Baum hinauf","klettert",
    "kommt den Baum hinaufgeklettert");

//-------------------------------------------------------------------------
// Spieler am Baum bekommen nun:
// "<spieler> klettert den Baum hinauf."
//
// und Spieler, welche sich schon in der Krone befinden, bekommen den Text
// "<spieler> kommt den Baum hinaufgeklettert."
//
// Punkte werden im move Kommando nicht gesetzt.
//-------------------------------------------------------------------------

  return 1;
}



