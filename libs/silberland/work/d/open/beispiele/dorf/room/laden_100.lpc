//-------------------------------------------------------------------------
// Fuer einen Laden, wo Gegenstaende verkauft und gekauft werden koennen,
// erben wir nicht den std/room, sondern den bereits auf die Funktion vor-
// bereiteten std/laden.
//-------------------------------------------------------------------------

inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));

//-------------------------------------------------------------------------
// P_INT_LONG lassen wir auskommentiert, da wir die Long anpassen wollen.
// Je nachdem ob der Haendler da ist oder nicht kommt eine andere Lang-
// beschreibung (siehe funktion _query_int_long())
//-------------------------------------------------------------------------
  // SetProp(P_INT_LONG, "");

  SetProp(P_INT_SHORT,"In einem kleinen Laden");

//-------------------------------------------------------------------------
// Die P_SHOPKEEPER_ID entspricht einer eindeutigen ID des Npcs der in dem
// Laden den Haendler spielen wird. Man kann auch Ids wie "\ngerion" be-
// nutzen, diese koennen von einem Spieler allerdings nicht angesprochen
// werden (\n ist fuer einen spieler nicht zu tippen)
//-------------------------------------------------------------------------

  SetProp(P_SHOPKEEPER_ID, "tora");

//-------------------------------------------------------------------------
// Welcher Name soll fuer die Chats des Ladens hergenommen werden?
//-------------------------------------------------------------------------

  SetProp(P_SHOPKEEPER_NAME, "Tora");

//-------------------------------------------------------------------------
// Geschlecht des Shopkeepers. Default ist MALE
//-------------------------------------------------------------------------

  SetProp(P_SHOPKEEPER_GENDER, FEMALE);

//-------------------------------------------------------------------------
// P_SHOP_FLAGS geben an, ob der Shop ueberhaupt einen Keeper hat, und wenn
// ja, ob er einen braucht (dann kann nichts gekauft/verkauft werden, wenn
// der Shopkeeper nicht im Raum ist.
//-------------------------------------------------------------------------

  SetProp (P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

//-------------------------------------------------------------------------
// Der Storageroom ist der Raum, wo alle verkauften Items lagern. Wird
// dieser Raum upgedatet, wird auch der Laden aufgeraeumt. Die Items, die
// sich im Lagerraum befinden, werden NICHT ausgeswappt.
//-------------------------------------------------------------------------

  SetStorageRoom(ROOM "lagerraum_110" );

//-------------------------------------------------------------------------
// Mittels P_SPECIAL_SHOP kann man einstellen, was der Laden ankauft, 
// naeheres dazu in der man-page
//-------------------------------------------------------------------------

  
// Hier wuerden die Details stehen ...


  AddExit("westen", ROOM "platz_001");

  AddItem(NPC "ladenbesitzerin_060", REFRESH_DESTRUCT);
}

//-------------------------------------------------------------------------
// Anstatt die P_INT_LONG statisch zu setzen, nehmen wir eine dynamische
// Ausgabe der Long. Die Funktion hierfuer setzt sich aus dem Propertie-
// Namen mit vorgestelltem "_query_" zusammen.
// Bsp: P_INT_LONG "int_long" -> _query_int_long
//      P_LIGHT    "light"    -> _query_light
// Der Rueckgabewert muss immer der Propertie entsprechen, in unserem Fall
// string (im Fall von P_LIGHT waere ein Rueckgabewert von "integer"
// richtig). Es ist daher auf jeden Fall immer ratsam die man page der
// ensprechenden Propertie einzusehen.
// Wenn eine Propertie dermassen "ueberschrieben" wird, kann sie NICHT
// ueber SetProp veraendert werden. Es wird immer der return-wert der
// "_query_" Funktion hergenommen.
//-------------------------------------------------------------------------

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier in einem kleinen Laden. Unzaehlige Regale "
        "stehen herum. Du siehst eine kleine Tafel an einer Wand. ";

//-------------------------------------------------------------------------
// Wenn die Ladenbesitzerin nicht hier ist geben wir das in der Long an
//-------------------------------------------------------------------------

  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist momentan gerade niemand hier.";
    }
    else
    {
      txt += "";
    }
  }

  return BS(txt);
}
