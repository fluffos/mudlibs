#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "");
  SetProp(P_LONG,
    "");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId( ({"", ""}) );

  SetProp(P_NAME_ADJ, ({"xx-"}) );
  AddAdjective( ({"xx-en","xx-er","xx-em","xx-es","xx-e"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, MAT_ );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_ );
  SetProp(P_WC, nn);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, DT_ );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["": ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_:]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS(""));
}

int WieldFunc(object waffe) 
{
  return 0;
}

int UnwieldFunc(object waffe) 
{
  return 1;
}

int HitFunc( object enemy ) 
{
  return 0;
}
