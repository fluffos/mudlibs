// Project: testgebiet
//
// Beispiel fuer tragbare Nahrung. Tragbare Nahrung immer mit der Balance
// absprechen und fuer Limits sorgen!
//
//=========================================================================

#include "../def.h"

inherit "std/food";     // ist fuer tragbare Heilung immer zu inheriten!

#include <food.h>       // food.h wird *nicht* standardmaessig geladen,
                        // das muessen wir selber machen

void create()
{
  if(!is_clone(this_object())) return;  // Die Blueprint braucht keinerlei
                                        // (objektbezogenen) Properties

  ::create();

  SetProp(P_SHORT, "Ein roher Lammbraten");
  SetProp(P_LONG,
    "Ein roher Lammbraten. Naja, essbar auch roh."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Lammbraten");
  AddId( ({ "braten", "lammbraten" , "roher_lamm_braten"}) );

//-------------------------------------------------------------------------
// Ausfuehrliche Erklaerungen zu P_NAME_ADJ und AddAdjective finden sich
// in armour/umhang_010
//-------------------------------------------------------------------------

  SetProp(P_NAME_ADJ, ({"roh"}) );
  AddAdjective( ({"rohen","roher","rohem","rohes","rohe"}) );

//-------------------------------------------------------------------------
// Gewicht, wert und Material angeben, der lammbraten besteht aus
// Fleisch und Knochen. siehe man materialliste
//-------------------------------------------------------------------------

  SetProp(P_WEIGHT, 800);      // Ein kleiner Lammbraten
  SetProp(P_VALUE, 50);        // und ist hier 50 Muenzen wert.
  SetProp(P_MATERIAL, ([ MAT_FLESH:80, MAT_BONE:20 ]) );

  SetProp(P_SMELL,
    "Der Lammbraten riecht noch sehr blutig.\n");

//-------------------------------------------------------------------------
// Nun folgt der eigentlich interessante Teil fuer Nahrungsobjekte:
// Die Property, die alles nahrungsspezifische festlegt, P_FOOD_INFO.
// Wichtig ist hier, dass die durchschnittliche ((LP+MP)/2) Heilung max.
// den doppelten Wert der aufaddierten Saettigungen betragen sollte.
//-------------------------------------------------------------------------

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 20,10 }), // braten heilt 20 Lebens- und 10 Magiepunkte
         F_SOAK    : 30,          // saettigt dabei um 30 Punkte
         F_DRINK   : 0,           // Trinksaettigung 0
         F_ALCOHOL : 0,           // Alkohol auch keiner ;)
         F_POISON  : 0,           // Vergiftet ist sie auch nicht
         F_MSG     : "Du wuergst den rohen Braten hinunter.",
         F_MSG_ROOM: "verschlingt einen rohen Braten.",
         F_VERB    : "essen"      // Wird fuer Fehlermeldung "Was willst Du
      ]) );                       // essen" benoetigt
}


void Eating(object pl)
{
  // Diese Funktion wird automatisch aufgerufen, sobald der Spieler
  // die Nahrung verzehrt. Hier koennte man ihm etwa blut-
  // verschmierte Finger (unsichtbares Objekt) verpassen, oder
  // andere Dinge tun, Heilung, Saettigung und Texte hingegen
  // sollten nur via P_FOOD_INFO gesetzt werden.
}

