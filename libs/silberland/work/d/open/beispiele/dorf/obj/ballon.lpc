//=========================================================================
//
// File:    ballon.c
// Created by Protheg
//
// Project: testgebiet
//
// Transporter. AddRoute, AddMsg und AddFun werden gezeigt. Der Ballon
// fliegt zwischen platz_001 und baum_080 hin und her.
//
//=========================================================================

#include "../def.h"

inherit "std/transport";

#define LANDEPLATZ_1 ROOM "platz_001"
#define LANDEPLATZ_2 ROOM "baum_080"

void create()
{
  ::create();

//-------------------------------------------------------------------------
// Beschreibung von Innen
//-------------------------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem knallroten Heissluftballon");
  SetProp(P_INT_LONG,
    "Du stehst in einem knallroten Heissluftballon."
  );

//-------------------------------------------------------------------------
// Beschreibung von Aussen
//-------------------------------------------------------------------------

  SetProp(P_SHORT, "Ein knallroter Heissluftballon");
  SetProp(P_LONG,
    "Du siehst einen knallroten Heissluftballon."
  );

  AddId( ({"ballon", "heissluftballon"}) );

  SetProp(P_NAME, "Heissluftballon");
  SetProp(P_NAME_ADJ, ({"knallrot"}) );
  AddAdjective( ({"knallroten","knallroter","knallrotem"
                 ,"knallrotes","knallrote"}) );

  SetProp(P_GENDER, MALE);

  SetProp(P_LIGHT, 0);      //Das Licht wird von der Umgebung uebernommen!
  SetProp(P_TRANSPARENT,1); // Man kann hinein/hinaus schauen

  SetProp(P_DEPARTMSG, ({ // Der Ballon fliegt ab
    // Im Ballon
    "Der knallrote Heissluftballon beginnt zu steigen.\n"
    "Du haelst Dich fest.\n",
    // Ausserhalb vom Ballon
    "Der knallrote Heissluftballon steigt hoch.\n"}));

  SetProp(P_ARRIVEMSG, ({ // Der Ballon landet
    // Im Ballon
    "Der knallrote Heissluftballon landet nun in @@QueryArrived@@.\n",
    // Ausserhalb
    "Ein knallroter Heissluftballon landet vor Deinen Augen.\n"}));

  SetProp(P_ENTERMSG, ({ // Jemand betritt den Ballon
    // Ausserhalb
    "betritt den knallroten Heissluftballon",
    // Im Ballon
    "betritt den Ballonkorb"}));

//-------------------------------------------------------------------------
// Es duerfen nur bis zu 5 Wesen im Ballon
// sein, NPCs gelten auch. Fuer Gegenstaende gibt es keine Beschraenkung.
//-------------------------------------------------------------------------

  SetProp(P_MAX_PASSENGERS, 5);

//-------------------------------------------------------------------------
// Der Ballon ist bereits voll
//-------------------------------------------------------------------------

  SetProp(P_ENTERFAIL,
    BS("Es befinden sich bereits 5 Personen in dem Heissluftballon. Er "
       "wuerde dann zu schwer werden."));

  SetProp(P_LEAVEMSG, ({ // Jemand verlaesst den Ballon
    // Ausserhalb
    "verlaesst den knallroten Heissluftballon",
    // Im Ballon
    "verlaesst den Ballonkorb"}));

  SetProp(P_LEAVEFAIL, // Im Flug darf man den Ballon nicht verlassen
    // Meldung an den Spieler
    "Der knallrote Heissluftballon fliegt dafuer viel zu hoch.\n");

  // oder

  // SetProp(P_LEAVEFAIL, ({
  //   // Meldung an den Spieler
  //   "Der knallrote Heissluftballon fliegt dafuer viel zu hoch.\n");
  //   // Meldung an Ballon Insassen (ausser Spieler)
  //   "waere fast aus dem Heissluftballon gefallen.\n"}));

  AddCmd( ({"betret","betrete","betritt"}), "cmd_betreten");
  AddCmd( ({"verlasse", "verlass"}),        "cmd_verlassen");

  AddRoute(LANDEPLATZ_1, // Der Ballon landet zuerst in LANDEPLATZ_1
     30, // wartet dort 30 sek lang, dann P_DEPARTMSG und
     20, // nach 20 sek die naechste Meldung/Aktion
     "ein Platz vor dem Dorf", // wird bei QueryArrived zurueckgeliefert (siehe oben)
     ({"dorf","platz"}), // die einzelnen ids fuer 'reise nach/zu(m) bla'
     "zu einem Platz vor dem Dorf"); // Du reist jetzt 'nach Bla'

//-------------------------------------------------------------------------
// Meldung an alle im Ballon und 15 sek warten auf naechste Meldung/Aktion
//-------------------------------------------------------------------------

  AddMsg("Der Heissluftballon treibt nun zum Baum.\n", 15);

//-------------------------------------------------------------------------
// Aufruf von 'fun_fly' und 5 sek warten auf naechste Meldung/Aktion
//-------------------------------------------------------------------------

  AddFun("fun_fly", 5);

  AddMsg("Der Heissluftballon naehert sich dem Baum.\n", 10);

//-------------------------------------------------------------------------
// Naechster Landeplatz erreicht
//-------------------------------------------------------------------------

  AddRoute(LANDEPLATZ_2, 30, 20, "auf einem Baum", ({"baum"}), "zum Baum");

  AddMsg("Der Heissluftballon treibt nun zu einem Platz vor dem Dorf.\n", 15);

  AddMsg("Der Heissluftballon beginnt zu sinken.\n", 10);

//-------------------------------------------------------------------------
// Ende der Routen erreicht, ab hier gehts ab dem Anfangspunkt wieder weiter
//-------------------------------------------------------------------------

//-------------------------------------------------------------------------
// Der Heissluftballon wird sofort gestartet, sobald er geladen wird
//-------------------------------------------------------------------------

  Start();
}

//-------------------------------------------------------------------------
// Der Spieler will den Ballon betreten
//-------------------------------------------------------------------------

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if(!str || str == "") return 0;

//-------------------------------------------------------------------------
// Ist das Argument gleich der Id des Ballons? (siehe AddId oben)
// Wenn ja, dann darf der Spieler einsteigen (versuchen).
//-------------------------------------------------------------------------

  if(id(str)) return Enter();

  return 0;
}

//-------------------------------------------------------------------------
// Der Spieler will den Ballon verlassen
//-------------------------------------------------------------------------

int cmd_verlassen(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if(!str || str == "") return 0;

//-------------------------------------------------------------------------
// Ist das Argument gleich der Id des Ballons? (siehe AddId oben)
// Wenn ja, dann darf der Spieler aussteigen (versuchen).
//-------------------------------------------------------------------------

  if(id(str)) return Leave();

  return 0;
}

//-------------------------------------------------------------------------
// Init wird beim betreten des Ballons aufgerufen
//-------------------------------------------------------------------------

void init()
{
  ::init();

//-------------------------------------------------------------------------
// Sicherheitsmassnahme, dass die einzelnen Landepunkte geladen sind
//-------------------------------------------------------------------------

  if(interactive(TP))
  {
    catch(call_other(LANDEPLATZ_1, "???"));
    catch(call_other(LANDEPLATZ_2, "???"));
  }
}

void fun_fly()
{
  object *passagiere, opfer;

//-------------------------------------------------------------------------
// soll nicht immer passieren
//-------------------------------------------------------------------------

  if(random(5)) return;

//-------------------------------------------------------------------------
// Opfer auswaehlen
//-------------------------------------------------------------------------

  passagiere = QueryPassengers();

//-------------------------------------------------------------------------
// Wenn sich keiner im Ballon befindet, dann verlassen der Funktion
//-------------------------------------------------------------------------


  if(!sizeof(passagiere)) return;

  opfer = passagiere[random(sizeof(passagiere))];

  tell_object(opfer, BS("Ploetzlich fliegt Dir eine Fliege mitten ins "
                        "Auge..."));

  opfer->SetProp(P_BLIND,
    ([BLIND_TIME: 2+random(2)
     ,BLIND_MSG: "Du hast eine Fliege im Auge!\n"
     ,BLIND_END_MSG: "Endlich schaffst Du es, die Fliege aus "
                     "dem Auge zu holen.\n"
      ])
  );

  tell_room(TO, BS("Ploetzlich fliegt "+opfer->name(WEM)+" eine Fliege "
                   "ins Auge...") + CAP(opfer->QueryPronoun(WER))+" wischt "
                   "sich eine Traene aus dem Gesicht.");
}
