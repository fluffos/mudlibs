// Eine typische Ladenbesitzerin.
//
//=========================================================================

#include "../def.h"

inherit "std/npc";


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tora, die Ladenbesitzerin");
  SetProp(P_LONG,
    "Tora ist die Ladenbesitzerin des kleines Ortes. Obwohl ihr Sortiment "
    "nicht sehr gross ist, ist sie stets bemueht die Wuensche der Kunden "
    "zu erfuellen."
  );

  SetProp(P_NAME, "Tora");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));
//-------------------------------------------------------------------------
// Die ID "tora" muss gesetzt werden, da sie als P_SHOPKEEPER_ID im Laden
// (laden_110.c) gesetzt ist.
//-------------------------------------------------------------------------
  AddId( ({"tora","ladenbesitzerin"}) );
  AddClass(CL_HUMAN); // siehe /sys/class.h

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 167);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_WIMPY, 0);

//-------------------------------------------------------------------------
// NPC hat einen Namen, daher kein unbestimmter Artikel verwenden
//-------------------------------------------------------------------------
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  AddInfo(DEFAULT_INFO, "Was darf es sein?","fragt Dich: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
}

