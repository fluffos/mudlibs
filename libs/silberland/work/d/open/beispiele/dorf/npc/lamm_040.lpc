//
// Dieser NPC kann auf knuddeln, treten usw reagieren. Desweiteres
// hinterlaesst er keine Standardleiche.
//
//=========================================================================

#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein unschuldiges Lamm");

  SetProp(P_LONG,
    "Das Lamm schaut Dich mit seinen knuffigen Augen liebevoll an. "
    "Am liebsten wuerdest Du sofort das Lamm knuddeln, streicheln, "
    "kuessen und umarmen."
  );

  AddDetail( ({ "fell" }),
    "Das Fell des Schafes ist weiss, womit Du zu der Feststellung kommst, "
    "dass Du vielleicht selbst das schwarze bist ;-)"
  );

  AddDetail( ({ "blick" }),
    "Das Schaf blickt Dich leicht duemmlich an, aber was hast Du anderes "
    "erwartet?"
  );

  SetProp(P_NAME, "Lamm");
  SetProp(P_GENDER, NEUTER);
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -5, T_RANGE_MAX:30]) );

  AddId( ({ "lamm","haustier" }) );

  create_default_npc(5);

  SetProp(P_HANDS, ({ " mit seinen tappsigen Hufen", 100 }) );
  SetProp(P_RACE, "Schaf" );

  AddClass( ({CL_ANIMAL}) );

  SetProp(P_SIZE, 40+random(20) );
  SetProp(P_ALIGN, 600 );
  SetProp(P_MAX_HANDS, 4 );

  SetProp(P_NAME_ADJ, ({"unschuldig"}) );
  AddAdjective( ({"unschuldigen","unschuldiger","unschuldigem","unschuldiges","unschuldige"}) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Lamm kaut an @WEM ein wenig rum, laesst @WEN dann aber auf "
    "den Boden fallen.\n" }) );

  SetProp(P_MMSGIN, "tappst herein" );
  SetProp(P_MMSGOUT, "tappst auf eine andere Wiese" );

  SetProp(P_DIE_MSG, " schaut Dich nochmal mitleiderregend an und stribt dann.\n" );

  SetProp(P_KILL_NAME, "Ein suesses Lamm" );

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"frisst nur das Gras.\n"
     ,"guckt Dich kurz mit einem dummen Blick an.\n"
     }) );

  SetChats( 3,
    ({"Das Lamm grast auf der Wiese.\n"
     ,"Das Lamm versucht zu bloeken.\n"
     ,"Das Lamm blickt Dich kurz unschuldig an.\n"
     })
  );

  SetAttackChats( 3,
    ({"Das Lamm bloekt ganz leise.\n"
     ,"Das Lamm versucht Dich zu rammen.\n"
     })
  );

//-------------------------------------------------------------------------
// Wenn das Lamm stirbt, so soll es keine leiche hinterlassen, sondern
// einen Braten.
//-------------------------------------------------------------------------

  SetProp(P_CORPSE, OBJ "braten_010");

//-------------------------------------------------------------------------
// Jetzt stellen wir noch ein, wie sich diese andere "Leiche" = braten
// verhalten soll. Der Braten hat ein eigenes Gewicht, es soll nicht
// vom Lamm uebernommen werden. Fuer den Fall, das das Lamm doch
// items bei sich hat, sollen diese in Raum und nicht in die "Leiche"
// transferiert werden
//-------------------------------------------------------------------------

 SetProp(P_CORPSE_FLAGS, COR_NOSETWEIGHT|COR_NOINVTRANSFER);
}

//-------------------------------------------------------------------------
// Hier wird ueberprueft welche Reaktionsgruppe ausgeloest wurde und die
// entprechende Funktion wird dann aufgerufen. Der Funktion werden 4
// Parameter uebergeben: verb, gruppe, adverb und touch.
//
// verb ist immer das jeweile verb (in der kuerzesten form)
// gruppe ist die verbengruppe ( fies, intim, nett, froh, albern, neutral,
// traurig, aergerlich, frech )
// adverb ist das angegeben adverb
// touch ist 1, wenn beim verb eine Beruehrung dabei ist, ansonsten 0
//
// Bei StartReaction muss man eines beachten: Startreaction wird aufgerufen,
// *bevor* die Standardmeldungen der Mudlib ausgegeben werden, d.h. gibt
// man Text direkt in StartReaction aus, so erscheint dieser, bevor der
// Spieler bzw die Anwesenden sehen, was ueberhaupt gemacht wird.
//
// Ausdiesem Grund wird die eigentliche Reaktion des NPCs mittels
// call_out hinausgezoegert, so dass erst die Meldungen der Mudlib
// vollstaendig ausgegeben werden (und die umstehenden sehen, wer mit dem
// NPC was macht) und erst dann wird die Reaktion des NPCs gestartet.
//-------------------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) //reagieren wir bereits auf etwas?
    return; //abbrechen, verhindert scrolls

  if (verb == "streichel") //auf das verb streicheln besonders reagieren
  {
    call_out("react", 0, "schaut Dich sehr gluecklich an. Anscheinend " +
      "wird es gern gestreichelt.",
      "schaut " + TP->Name(WEN) + "sehr gluecklich an." +
      " Ob Du es auch mal streicheln solltest?");
    return; //wir haben reagiert, gruppe braucht nicht mehr ueberprueft werden
  }

  switch(gruppe) //ueber gruppe reagieren, je nach gruppe andere nachricht ausgeben
  {
    case "fies": //auf "fies" so reagiern:
      call_out("react", 0, "schaut Dich traurig an.", "schaut " +
        TP->Name(WEN) + " traurig an.");
      //call_out ruft nun die funkion "react" mit einer kurzen verzoegerung
      //(0-1 sekunde) auf und gibt die beiden nachrichten an sie. die erste
      //nachricht wird an den spieler ausgegeben, die zweite an alle anderen
      //im raum.
    break; //break verlaesst den "switch" teil, wir sind fertig.

    case "aergerlich":
      call_out("react", 0, "blickt aengstlich und geht einen Schritt von Dir weg.",
        "erschreckt sich vor " + TP->Name(WEM) +
        " und geht einen Schritt weg.");
    break;

    case "frech":
      call_out("react", 0, "blickt aengstlich und geht einen Schritt von Dir weg.",
        "erschreckt sich vor " + TP->Name(WEM) +
        " und geht einen Schritt weg.");
    break;

    case "nett":
      call_out("react", 0, "boelkt Dich zufrieden an.",
        "boelkt "+TP->Name(WEN) + " zufrieden an.");
    break;

    case "froh":
      call_out("react", 0, "boelkt Dich zufrieden an.",
        "boelkt "+TP->Name(WEN) + " zufrieden an.");
    break;

    default:
      call_out("react", 0, "kaut weiter friedlich sein Gras.",
        "kaut weiter friedlich sein Gras.");
    break;
  }
}

//-------------------------------------------------------------------------
// react: hilfsfunktion, die fuer jede reaktion aufgerufen wird. gibt
// dem spieler die erste nachricht aus, und allen im raum ausser dem
// spieler und dem objekt (dem lamm) die zweite nachricht aus
//-------------------------------------------------------------------------

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

//-------------------------------------------------------------------------
// in der dokumentation steht das StartReactionAll definiert sein muss
// und StartReaction aufrufen soll. warum ist mir unklar, geht auch ohne
// aber sicher ist sicher, deswegen ists auch hier definiert.
//-------------------------------------------------------------------------

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
