//
// Project: testgebiet
//
// Ein einfacher NPC(non playing character).
//
//=========================================================================

#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//-------------------------------------------------------------------------
// Kurzbeschreibung des NPCs
// sehen die Spieler, wenn sie "schau" in einem Raum machen
// Das Satzzeichen "\n" braucht nicht gesetzt werden, weil das von der
// zustaendigen Funktion erledigt wird.
//
// Da man NPCs von aussen sieht, muss man P_SHORT und P_LONG nehmen
//-------------------------------------------------------------------------

  SetProp(P_SHORT, "Ein Schaf");

//-------------------------------------------------------------------------
// Langbeschreibung, die man sieht, wenn man NPC untersucht
//-------------------------------------------------------------------------

  SetProp(P_LONG,
    "Das Schaf entspricht genau Deinen Vorstellungen eines Traumschafes. "
    "Es hat ein dickes, wollenes, weisses Fell, grast auf einer Wiese und "
    "hat meist einen duemmlichen Blick."
  );

//-------------------------------------------------------------------------
// Natuerlich kann man auch Details mitgeben
//-------------------------------------------------------------------------

  AddDetail( ({ "fell" }),
    "Das Fell des Schafes ist weiss, womit Du zu der Feststellung kommst, "
    "dass Du vielleicht selbst das schwarze bist ;-)"
  );

  AddDetail( ({ "blick" }),
    "Das Schaf blickt Dich leicht duemmlich an, aber was hast Du anderes "
    "erwartet?"
  );

//-------------------------------------------------------------------------
// Name: falls dieser unregelmaessig dekliniert wird, kann man ein Array aus
// vier Strings machen fuer Nom, Gen, Dat und Akk. Wichtig auch dafuer, dass
// bei einer Leiche nicht "Leiche von 0" dasteht.
//-------------------------------------------------------------------------

  SetProp( P_NAME, "Schaf" );

//-------------------------------------------------------------------------
//Geschlecht des NPCs: MALE, FEMALE oder NEUTER moeglich
//-------------------------------------------------------------------------

  SetProp( P_GENDER, NEUTER );

//-------------------------------------------------------------------------
// Temperaturbereich, in dem sich der NPC wohl fuehlt, also wo dieser keine
// Lebenspunkte durch Idlen verliert.
//-------------------------------------------------------------------------

  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN: -5, T_RANGE_MAX:30]) );

//-------------------------------------------------------------------------
// Jeder NPC braucht mindestens eine ID, damit es angesprochen werden kann,
// also dass fuer die Spieler moeglich ist "unt schaf" oder "toete schaf"
// einzugeben
//-------------------------------------------------------------------------

  AddId( ({ "schaf","haustier" }) );

//-------------------------------------------------------------------------
// Level des NPs setzen. Die Stats werden auf diesen Level gesetzt und
// weitere Werte werden davon beeinflusst.
// P_LEVEL entspricht dem level (bei uns 8)
// P_MAX_HP und P_MAX_SP: 42+8*level maximale Lebenspunkte und Magiepunkte
// des NPCs (bei uns jeweils 106)
// P_HANDS: 10*level (bei uns 80) (siehe auch unten)
// P_BODY: (20/3)*level (bei uns 53) Abwehrstaerke des blanken Koerpers
// des NPCs
//
// create_default_npc setzt die Werte fuer den NPC sehr brauchbar. Erst
// groesserer Erfahrung sollte man die Werte veraendern.
//-------------------------------------------------------------------------

  create_default_npc(8);

//-------------------------------------------------------------------------
// 3 teiliges Element fuer den Angriff
// 1. Teil: String mit Meldung, falls ohne Waffe angegriffen wird
// Das Space darin nicht vergessen!
// 2. Teil: Waffenklasse
// 3. Teil: Angriffstyp, default ist immer DT_BLUDGEON
// Waffenklasse auf 100 gesetzt, weil wir NPC ein bisschen staerker machen
// wollen, normal waere 10*level, also 80
//-------------------------------------------------------------------------

  SetProp( P_HANDS, ({ " mit seinem Kopf", 100 }) );

//-------------------------------------------------------------------------
// Die Rasse des NPCs: sollte man genau beachten, vorallem weil Waffen,
// Ruestungen oder auch Angriffsarten gegen spezielle Rassen anders wirken.
//-------------------------------------------------------------------------

  SetProp( P_RACE, "Schaf" );

//-------------------------------------------------------------------------
// Man sollte auch eine Klasse angeben. Verfuegbare Klassen finder man
// unter /sys/class.h
// Das Schaf ist ein Tier, es passt also CL_ANIMAL
//-------------------------------------------------------------------------

  AddClass( ({CL_ANIMAL}) );

//-------------------------------------------------------------------------
// Groesse des Lebewesens in cm; wichtig zum Beispiel beim Spell "kopfstoss"
// der Berserker oder auch bei anderen Spells
//-------------------------------------------------------------------------

  SetProp(P_SIZE, 70+random(30) );

//-------------------------------------------------------------------------
// Wert fuer Gut- oder Boesheit des NPCs
// sollte zwischen -1000(satanisch) und 1000(heilig) liegen
// Auch wichtig fuer die Anwendung bestimmter Zaubersprueche
//-------------------------------------------------------------------------

  SetProp(P_ALIGN, 100 );

//-------------------------------------------------------------------------
// Anzahl der "Haende", die ein Lebewesen hat. Bei Spinnen kann man durch
// aus auch 8 setzen. Begrenzt die Zahl der Waffen und Schilde, die man
// zuecken kann
//-------------------------------------------------------------------------

  SetProp(P_MAX_HANDS, 4 );

//-------------------------------------------------------------------------
// Array mit zwei Elementen, wo bestimmt wird, was mit Dingen passiert,
// die dem NPC gegeben werden:
// 1.Element: Art der Handlung
// 4 Moeglichkeiten:
// REJECT_GIVE: Der NPC gibt Objekt zurueck -> Spieler hat Objekt
// REJECT_DROP: Der NPC laesst Objekt fallen -> Objekt liegt im Raum
// REJECT_KEEP: Der NPC behaelt Objekt -> Npc hat Objekt
// REJECT_DESTRUCT: Der NPC zerstoert Objekt -> Objekt ist weg
// 2. Element: Meldung, mit der NPC die Handlung kommentiert.
// Mit @WER, @WESSEN, @WEM, @WEN kann man auch den Objektnamen in den
// Meldungen integrieren.
//-------------------------------------------------------------------------

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Schaf ist an @WEM nicht interessiert.\n" }) );

//-------------------------------------------------------------------------
// Meldung, die alle im Raum bekommen, wenn NPC reinteleportiert wird
// Auch wenn es sich nicht um einen bewegenden NPC handelt, sollte man
// diese Werte setzen. Ansonsten erscheint/verschwindet alles in "Knall
// und Schwefelduft"
//-------------------------------------------------------------------------

  SetProp(P_MMSGIN, "stapft herein" );

//-------------------------------------------------------------------------
//Meldung, die alle im Raum bekommen, wenn NPC wegteleportiert wird
//-------------------------------------------------------------------------

  SetProp(P_MMSGOUT, "stapft auf eine andere Wiese" );

//-------------------------------------------------------------------------
//Meldung, die ausgegeben wird, wenn NPC stirbt. Default ist:
//" faellt tot zu Boden.\n"
//-------------------------------------------------------------------------

  SetProp( P_DIE_MSG, " wird kein Gras mehr fressen.\n" );

//-------------------------------------------------------------------------
// Name, der beim Tod eines Spielers durch das Objekt als Killer auf
// [Tod:] verwendet wird.
// falls nicht gesetzt, wird P_NAME verwendet
// falls das auch nicht gesetzt ist, kommt "Etwas Geheimnisvolles und
// Unbekanntes"
//-------------------------------------------------------------------------

  SetProp( P_KILL_NAME, "Ein gereiztes Schaf" );

//-------------------------------------------------------------------------
//Antworten, die Spieler bekommt, wenn kein Schluesselwort angesprochen
//wird mit AddInfo
//aus dem Array wird per Zufall eine Meldung ausgewaehlt
//-------------------------------------------------------------------------

  AddInfo( DEFAULT_INFO,
    ({"beachtet Dich gar nicht.\n"
     ,"frisst nur das Gras.\n"
     ,"guckt Dich kurz mit einem dummen Blick an.\n"
     }) );

//-------------------------------------------------------------------------
//Meldungen, die vom NPC mit der Wahrscheinlichkeit von 3% an den Raum
//ausgegeben werden
//Zahl gibt also die prozentuelle Wahrscheinlichkeit eines Chat an.
//String ist ein Array mit allen moeglichen Meldungen, aus denen
//zufaellig eine gewaehlt wird
//-------------------------------------------------------------------------

  SetChats( 3,
    ({"Das Schaf grast auf der Wiese.\n"
     ,"Das Schaf bloekt.\n"
     ,"Das Schaf blickt Dich kurz duemmlich an.\n"
     })
  );

//-------------------------------------------------------------------------
// gleich wie SetChats, nur eben Meldungen, die vom NPC waehrend eines
// Kampfes ausgegeben werden. Sobald Kampf beginnt, wirken die
// SetAttackChats. SetChats werden automatisch zu dem Zeitpunkt beendet.
//-------------------------------------------------------------------------

  SetAttackChats( 3,
    ({"Das Schaf bloekt ganz laut.\n"
     ,"Das Schaf versucht Dich zu rammen.\n"
     })
  );
}

