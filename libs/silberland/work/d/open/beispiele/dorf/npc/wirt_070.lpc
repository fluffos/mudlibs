#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Roglar, der Wirt");
  SetProp(P_LONG,
      "Roglar ist hier der Wirt. Fuer einen Zwerg ist er ziemlich gross "
      "geraten. Er hat einen langen dichten Bart und buschige Augenbrauen, "
      "unter denen Dich 2 stahlgraue Augen mustern.");

  SetProp(P_NAME, "Roglar");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:80]));
//-------------------------------------------------------------------------
// Die ID "roglar" muss gesetzt werden, da er als P_PUBKEEPER_ID in der
// Kneipe (kneipe_120.c) gesetzt ist.
//-------------------------------------------------------------------------
  AddId( ({"roglar","wirt"}) );
  AddClass(CL_DWARF); // siehe /sys/class.h

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 145);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_WIMPY, 0);

//-------------------------------------------------------------------------
// NPC hat einen Namen, daher kein unbestimmter Artikel verwenden
//-------------------------------------------------------------------------
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht kurz weg");

  AddInfo(DEFAULT_INFO, "Was darf es sein? Ein Schnaps?","fragt Dich: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );
  SetAttackChats(10,
    ({Name(WER,1)+" zuernt: Das ist also der Dank!\n"
     })
  );
}

