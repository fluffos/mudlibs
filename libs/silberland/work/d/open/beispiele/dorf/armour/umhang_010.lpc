//=========================================================================
//
// File:    schaf_010.c
// Created by Woody@SL based on Boing@Morgengrauen
//
// Project: testgebiet
//
// Ein Umhang, der vor Kaelte schuetzt, einen dafuer bei Waerme mehr
// schwitzen laesst.
//=========================================================================

#include "../def.h"

inherit "std/armour";           // Ruestungsobjekt

void create()
{
  if(!is_clone(this_object())) return;   // Die Blueprint braucht keinerlei
                                         // (objektbezogenen) Properties

  ::create();

//-------------------------------------------------------------------------
// wie ueblich, kurz und lang beschreibung. Man achte aber auf das grau
// in der Kurzbeschreibung, da werden wir spaeter weiter drauf eingehen
//-------------------------------------------------------------------------

  SetProp(P_SHORT, "Ein grauer Umhang");
  SetProp(P_LONG,
    "Es ist ein langer grauer Umhang aus einem feinen Material."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Umhang");
  AddId("umhang");

//-------------------------------------------------------------------------
// In der Kurzbeschreibung wird der Umhang mit dem Adjektiv "grau" naeher
// beschreiben. Damit das Objekt weiss, das es grau ist, und sich auch
// bei anderen Ausgaben als grauen Mantel ausgibt, sind ein paar
// Zusatzangaben noetig. P_NAME_ADJ gibt das Adjektiv in seiner
// Grundform an, die Mudlib ist in der Lage, in der allermeisten
// Faellen die richtige Konjugation zu ermitteln. Nur in Ausnaehmefaellen
// muss man Dativ Akuusativ usw slebst angeben. Naeheres dazu in der
// manpage zu P_NAME_ADJ
//-------------------------------------------------------------------------

  SetProp(P_NAME_ADJ, ({"grau"}) );

//-------------------------------------------------------------------------
// Damit der Spieler nun auch "nimm grauen Umhang" oder "untersuch grauen"
// Umhang eingeben kann, ist eine weitere Angabe noetig. Hier muss man
// aber alle Faelle selbst angeben, man tut gut daran, einfach alle
// anzugeben. Damit sind dann zwar auch "untersuche graues umhang"
// moeglich, aber das stoert eher weniger als vergessene oder vermeintlich
// nicht noetige Faelle.
//-------------------------------------------------------------------------

  AddAdjective( ({"grauen","grauer","grauem","graues","graue"}) );

//-------------------------------------------------------------------------
// Beim erkennen/schaetzen/identifizieren teilen wir dem Spieler mit,
// dass der Mantel etwas besonderes ist.
//-------------------------------------------------------------------------

  SetProp(P_INFO,
      "Der graue Umhang waermt Dich gut bei Kaelte.\n");

//-------------------------------------------------------------------------
// Jetzt nicht Gewicht, Wert des Umhang und das Material vergessen, aus dem
// er besteht. Die Summe der Materialen soll 100 ergeben (100%).
//-------------------------------------------------------------------------

  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([ MAT_CLOTH : 100 ]) );

//-------------------------------------------------------------------------
// Jetzt die Eckwerte fuer die Ruestung
//-------------------------------------------------------------------------

//-------------------------------------------------------------------------
// 1. Der Ruestungstyp (Umhang, Schild, Panzer, ...)
//-------------------------------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);

//-------------------------------------------------------------------------
// 2. Die Ruestungsklasse (deren moegliches Maximum ist
//    Ruestungstyp-spezifisch, bei Umhaengen zB. max. 10)
//    Werte ueber 3/4 des Maximums sind balancepflichtig!
//-------------------------------------------------------------------------

  SetProp(P_AC, 6);

//-------------------------------------------------------------------------
// Und jetzt noch einige nicht so wichtige, aber moegliche Werte,
// fuer die aber seitens der Mudlib sinnvolle Defaultwerte vorgegeben
// sind, sie muessen daher nicht unbedingt gesetzt werden.
//-------------------------------------------------------------------------

//-------------------------------------------------------------------------
// 3. Die Abnutzung
//-------------------------------------------------------------------------

  SetProp(P_QUALITY_DECAY, 80); // nach 80 Schlaegen auf den Umhang: AC - 1

//-------------------------------------------------------------------------
// 4. Wogegen soll die Ruestung schuetzen? Achtung: Schutz gegen magische
//    Schadensarten bedarf Einwilligung der Balance!
//-------------------------------------------------------------------------

  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);

//-------------------------------------------------------------------------
// 5. Tragetext fuer "inv" -> "Ein grauer Umhang (umgehaengt)"
//    Default waere "getragen"
//-------------------------------------------------------------------------

  SetProp(P_WORN_TEXT, "umgehaengt");

//-------------------------------------------------------------------------
// 6. Anziehtext
//-------------------------------------------------------------------------

  SetProp(P_WEAR_TEXT, ({ "Du huellst Dich in den grauen Umhang.\n",
                          " huellt sich in einen grauen Umhang.\n" }) );
//-------------------------------------------------------------------------
// 7. Ausziehtext
//-------------------------------------------------------------------------

  SetProp(P_UNWEAR_TEXT, ({ "Du streifst den Umhang von Deinen Schultern.\n",
                            " streift einen Umhang von den Schultern.\n" }) );
//-------------------------------------------------------------------------
// 8. Temperaturschutz
//    +6 Punkte bei Kaelteschutz, aber -3 Punkte bei Waermeschutz
//    heisst: guter Schutz bei Kaelte, aber sehr schlecht bei Hitze
//
// Nicht jede Ruestung bietet Hitze/Kaelteschutz. Von daher nur sparsam
// verwenden und ggfls Sponsor/Regionsmagier/Balance fragen.
//-------------------------------------------------------------------------

  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:6,T_HEAT_PROT:-3 ]) );

//-------------------------------------------------------------------------
//
// weitere Moeglichkeiten:
//
//    - ruestungsspezifisch:
//      P_WEAR_FUNC, P_WEAR_RESTRICTIONS, P_REMOVE_FUNC, P_DEFEND_FUNC,
//    - sonstige moeglicherweise sinnvolle Properties:
//      P_CURSED, P_NODROP, P_NEVERDROP, P_NOSELL.
//
//    Genauere Informationen findest Du in der jeweiligen man Page
//    oder in /doc/SL/ruestungen.
//-------------------------------------------------------------------------


}

