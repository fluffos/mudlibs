//-DEFAULT DRACHEN NPC V0.1 LaMuerte
//-Abgestimmt von Feyaria
//-Metall Drachen von messinger auf messing Drache gestellt Lam
  
#define SCHUPPE "/d/ebene/lamuerte/drachen/schuppe.lpc"
#pragma strong_types

inherit "/std/npc";

#include <properties.h>
#include <wizlevels.h>
#include <npc.h>
#include <language.h>
#include <attributes.h>
#include <defines.h>
#include <combat.h>
#include <new_skills.h>

ENVCHECKPROC

nosave int _set_level(int arg);
int breathdamage;

void create()
{ 
  ::create();
  AddId(({"drache"}));
  SetProp(P_NAME,"Drache");
  SetProp(P_LONG,
  "Ein riesiges Ungetuem steht vor Dir. Es sieht nicht gerade recht feundlich "+
  "aus. Dieser Koloss wirkt wirklich aeusserst beeindruckend und zugleich auch "+
  "beaengstigend. Besser Du greifst es nicht an."); 
  SetProp(P_MSGIN, "kommt an.\nDu zitterst am ganzen Leib");
  SetProp(P_MSGOUT, "geht#.\nDir faellt ein Stein vom Herzen");
  SetProp(P_MMSGIN, "wird sichtbar");
  SetProp(P_MMSGOUT, "verschwindet vor Deinen Augen");
  SetProp(P_GENDER, MALE );
  SetProp(P_RACE, "Drache");
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_TEMPERATURE_RANGE, ([0:-10, 1:50]));

}

void create_default_dragon(int level,int age,int align,int scales)
{ 
  string *alter, *alter2, *farbe;
  int scalevalue;
  object *inv;  

  if(level < 1 || level > 5) level=1;
  if(age < 1 || age > 12) age=1;
  if(align < 0 || align > 1) align=1;
  
  create_default_npc(20+level*2+age*2);
//  SetProp(P_MAX_HP, (500 + level*50)+(age*70));
//  SetProp(P_MAX_SP, (300 + level*30)+(age*40));
  SetProp(P_HANDS, ({" mit seinen Klauen", 250+level*10+age*15, DT_RIP }) );
  SetProp(P_BODY, (250+(level*20)+(age*30)));
//  SetProp(P_XP, ((level*400)*(42 + level*30) ))*age;

  SetProp(P_WEIGHT, (level*1000*age / 2));
  SetProp(P_SIZE, 300+level*50+age*50);
  SetProp(P_SPELLRATE, ((level+age)*5));
  alter = ({ "jung", "erwachsen", "alt", "steinalt"});
  alter2= ({ "kundig", "erfahren", "weis"});
  farbe=({
          ({"schwarz", "weiss", "gruen", "blau", "rot"}),
          ({"kupfern", "bronzen", "messing", "silbern", "golden"})
        }); 
  if (align!=1)
   {
  SetProp(P_SHORT,"Ein "+alter[(age-1)/3]+"er "+alter2[age%3]+"er "+
    farbe[align][level-1]+"er Drache"); 

//beim alter 2 haut das net so richtig hin.... nochmal anschaun (lam)

  SetProp(P_NAME_ADJ, ({farbe[align][level-1]}) );
  AddAdjective( ({alter[(age-1)/3]+"er", alter2[age%3]+"er", 
    farbe[align][level-1]+"er"}) ); 
    }
  
  if (align==1)
   {
  SetProp(P_SHORT,"Ein "+alter[(age-1)/3]+"er "+alter2[age%3]+"er "+
    farbe[align][level-1]+" Drache"); 
  SetProp(P_NAME_ADJ, ({farbe[align][level-1]}) );
  AddAdjective( ({alter[(age-1)/3], alter2[age%3], 
    farbe[align][level-1]}) ); 
    }
    
    
  if (align==0) SetProp(P_ALIGN, -((age/2+1)*150));
  if (align==1) SetProp(P_ALIGN,  ((age/2+1)*150));

  if (align==0 )
  {
    switch ( level) 
    {   
      case 1:
        AddSpell(2,50*age,
          "  Der schwarze Drache speit Dir eine Saeurewolke entgegen.\n",
          "  Der schwarze Drache speit @WEN mit einer Saeurewolke an.\n",
          ({DT_ACID}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_ACID:-1]) );
        break;
      case 2: 
        AddSpell(2,75*age,
          "  Der weisse Drache speit Dir eine Eiswolke entgegen.\n",
          "  Der weisse Drache speit @WEN mit einer Eiswolke an.\n",
          ({DT_COLD}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-1]) );
        break;
      case 3:    
        AddSpell(2,100*age,
          "  Der gruene Drache speit Dir eine Giftwolke entgegen.\n",
          "  Der gruene Drache speit @WEN mit einer Giftwolke an.\n",
          ({DT_POISON}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_POISON:-1]) );
        break;
      case 4:
        AddSpell(2,125*age,
          "  Der blaue Drache speit Dir einen Blitz entgegen.\n",
          "  Der blaue Drache speit @WEN mit einem Blitz an.\n",
          ({DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_LIGHTNING:-1]) );
        break;
      case 5:    
        AddSpell(2,150*age,
          "  Der rote Drache speit Dir eine Flammenwolke entgegen.\n",
          "  Der rote Drache speit @WEN mit einer Flammenwolke an.\n",
          ({DT_FIRE}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:-1]) );
    }
  }
  else
  {
    switch(level)
    {
      case 1:
        AddSpell(2,50*age,
          "  Der kupferne Drache speit Dir eine Saeurewolke entgegen.\n",
          "  Der kupferne Drache speit @WEN mit einer Saeurewolke an.\n",
          ({DT_ACID}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_ACID:-1]) );
        break;
      case 2:    
        AddSpell(2,75*age,
          "  Der bronzene Drache speit Dir eine Eiswolke entgegen.\n",
          "  Der bronzene Drache speit @WEN mit einer Eiswolke an.\n",
          ({DT_COLD}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_COLD:-1]) );
        break;
     case 3: 
       AddSpell(2,100*age,
         "  Der messingne Drache speit Dir eine Giftwolke entgegen.\n",
         "  Der messingne Drache speit @WEN mit einer Giftwolke an.\n",
         ({DT_POISON}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_POISON:-1]) );
       break;
     case 4: 
       AddSpell(2,125*age,
         "  Der silberne Drache speit Dir einen Blitz entgegen.\n",
         "  Der silberne Drache speit @WEN mit einen Blitz an.\n",
         ({DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_LIGHTNING:-1]) );
       break;
     case 5:
       AddSpell(2,150*age,
         "  Der goldene Drache speit Dir eine Feuerwolke entgegen.\n",
         "  Der goldene Drache speit @WEN mit einer Feuerwolke an.\n",
         ({DT_FIRE}),([SP_SHOW_DAMAGE:1]));
        SetProp(P_RESISTANCE_STRENGTHS, ([DT_FIRE:-1]) );
    }
  }

  breathdamage=(200+(age*40)+(level*60));
  AddSpell(1,1,
    "Der Drache spuckt Feuer in den ganzen Raum.\n",
    "Der Drache spuckt Feuer in den ganzen Raum.\n",
    ({DT_FIRE}),"breath_spell");
  AddSpell(1,300+level*25+age*50, 
    "  Der Drache greift Dich mit seinem langen Schwanz an.\n",
    "  Der Drache greift @WEN mit seinem langen Schwanz an.\n",
    ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]) );

  if( scales>level*2+age*3 ) scales = level*2+age*3;
  if( scales<level+age)    scales = level+age;
 
  for(scalevalue=0;scalevalue<scales;scalevalue++)
    clone_object(SCHUPPE)->move(this_object());
} 


void breath_spell(object enemy,int damage, mixed dam_type)
{
  int i;
  object *inv; 

  inv=filter_array(all_inventory(environment(this_object())), #'living );
  for(i=sizeof(inv)-1;i>=0;i--) 
  {
    if(member_array("drache",inv[i]->QueryProp(P_IDS))!=-1) damage=0; 
    else 
     inv[i]->Defend(breathdamage, dam_type, 
       ([SP_SHOW_DAMAGE:1,SP_NAME:"Dragonbreath"]), this_object());
  }
  return;
}
  
