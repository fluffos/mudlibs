// Ein Drache aus Kyranda

inherit "/d/ebene/lamuerte/drachen/dnpc.lpc";

#include <properties.h>
#include <language.h>
#include <new_skills.h> // P_GUILD_LEVEL
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP

#define ELEMENT_SECURE "secure_prop"


create()
{ int zufall,x,y;
  string *gems;

  if (!is_clone(this_object())) return;
  ::create();    
   create_default_dragon(1,3,0,10);
    SetProp(P_AGGRESSIVE,1); 
    clone_object("/d/ebene/lamuerte/drachen/schmiedehammer.lpc")->
      move(this_object(),M_NOCHECK);

  gems=
  ({"amethyst.lpc","bergkristall.lpc","diamant.lpc","lapislazuli.lpc",
    "rubin.lpc","saphir.lpc","smaragd.lpc","topas.lpc"});
  y=random(9)+1;
  for(x=0;x<=y;x++)
   {
    zufall=random(7);
     clone_object("/obj/gems/"+gems[zufall])->
      move(this_object(),M_NOCHECK);
   }

}

void die(int poisondeath)
{

object spieler, ob;
spieler=this_object()->QueryProp(P_KILLER);
if((spieler->QueryProp(P_GUILD))=="druidenzirkel" &&
     (spieler->QueryProp(P_GUILD_LEVEL))==10)
  {
    ob=clone_object("/gilden/druidenzirkel/obj/task");
    ob->SetProp(ELEMENT_SECURE, 99);
    ob->move(spieler, M_NOCHECK);
  } 
::die(poisondeath);
}

