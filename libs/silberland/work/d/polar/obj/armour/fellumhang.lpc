#include "../../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Fellumhang");
  SetProp(P_LONG,  
    "Ein dicker Fellumhang, der gegen grimmige Kaelte schuetzt.");
  SetProp(P_NAME, "Fellumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"fell", "umhang", "fellumhang"}) );
  SetProp (P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:6, T_HEAT_PROT:-6 ]) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_FUR:100]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1500);

}
