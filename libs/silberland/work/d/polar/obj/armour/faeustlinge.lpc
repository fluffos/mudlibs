inherit "std/armour";

#include "../../def.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"faeustlinge", "faeustling"}));
  SetProp (P_SHORT, "Ein Paar Faeustlinge");
  SetProp (P_LONG, "Ein Paar warme Faeustlinge aus ganz flauschigem, "
	          +"weichem Fell.\n");
  SetProp (P_NAME, "Paar Faeustlinge");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 500);
  SetProp (P_MATERIAL, ([MAT_PELT:100]));
  SetProp (P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:3, T_HEAT_PROT:-3 ]) );
  SetProp (P_ARMOUR_TYPE, AT_GLOVE);
  SetProp (P_AC, 2);
}
