#include "../../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Pelzjacke");
  SetProp(P_LONG, 
    "Eine dicke, warme Pelzjacke. Sie ist wohl kein allzuguter "
   +"Ruestungschutz, dafuer bietet sie umsomehr Schutz gegen die grimmige "
   +"Kaelte hier oben.");
  SetProp(P_NAME, "Pelzjacke");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"jacke", "pelzjacke"}) );

  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:7, T_HEAT_PROT:-7 ]) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, ([MAT_PELT:100]));
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 2500);
}

