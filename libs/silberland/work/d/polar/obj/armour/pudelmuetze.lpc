inherit "std/armour";

#include "../../def.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"muetze", "pudelmuetze"}));
  SetProp (P_SHORT, "Eine Pudelmuetze");
  SetProp (P_LONG,
    "Eine lustige, warme Pudelmuetze. Sie hat einen grossen, bunten Quasten "
   +"oben angenaeht.");
  AddDetail( ({"quasten", "quaste"}),
	     "Die Pudelmuetze hat einen grossen, bunten Quasten. Irgendwie "
	    +"kommst Du Dir ein wenig bloed vor damit.");
  SetProp (P_NAME, "Pudelmuetze");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 250);
  SetProp (P_VALUE, 300);

  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:-1]));
  SetProp (P_ARMOUR_TYPE, AT_HELMET); 
  SetProp (P_AC, 2);

  SetProp (P_MATERIAL, ([MAT_COTTON:100]));
}
