inherit "std/armour";

#include "../../def.h"
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"stiefel","fellstiefel"}));
  SetProp (P_SHORT, "Ein Paar Fellstiefel");
  SetProp (P_LONG, "Ein Paar dicke Fellstiefel, die Deine Fuesse vor "
     +"eisiger Kaelte schuetzen. Mit ihnen solltest Du nie kalte "
     +"Zehen bekommen.");
  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:-2]));
  SetProp (P_NAME, "Paar Fellstiefel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 800);

  SetProp (P_MATERIAL, ([MAT_PELT:100]));
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 5);
}
