// Eisschlangenei zum Essen
// Filename: schlangenei.c
// File by Rage, Maerz 06

inherit "std/food";

#include "../def.h"
#include <food.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create("\brechen");

  SetProp( P_SHORT, "Ein Eisschlangenei" );
  SetProp( P_LONG,
    "Du hast ein seltenes Eisschlangenei entdeckt. Es passt leicht in "
    "Deine offene Hand und hat eine weiss schimmernde Schale." );
    
//DETAILS
  AddDetail( "hand",
    "In einer davon haeltst Du gerade ein Eisschlangenei." );
  AddDetail( "schale",
    "Beim Abtasten der Schale merkst Du, dass sie recht dick fuer ein Ei "
    "zu sein scheint, aber dennoch glaubst Du, dass Du sie aufbrechen "
    "kannst." );
  AddDetail( "abtasten",
    "Naja, Du tastest halt das Ei sehr sorgfaeltig und genau ab." );
//END DETAILS

  SetProp( P_SMELL, "Das Eisschlangenei stroemt gar keinen Geruch aus." );
  
  SetProp( P_NAME, "Eisschlangenei" );
  SetProp( P_GENDER, NEUTER );
  AddId( ({ "ei","schlangenei","eisschlangenei" }) );

  SetProp( P_MATERIAL, MAT_FOOD );
  SetProp( P_WEIGHT, 80 );
  SetProp( P_VALUE, 200 );
  SetProp( P_SIZE, 4 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_FOOD_INFO,([
           F_HEAL: ({ 8+random(3),8+random(3) }),
           F_SOAK: 3,
           F_ALCOHOL:0,
           F_POISON:0]) );

  AddCmd( "brich|brech|breche&ei|eisschlangenei|schlangenei|schale&auf",
          "cmd_brechen","Was willst Du aufbrechen?" );
}

int cmd_brechen(string str)
{
  eat();
  return 1;
}

eat()
{
  write( BS(
    "Geschickt brichst Du das Ei auf und schluerfst angewidert den "
    "eiskalten Inhalt. Obwohl Dir jetzt ziemlich schlecht ist, fuehlst "
    "Du Dich dennoch erfrischt.") );
  say(
    TPN+" schluerft ein Schlangenei aus. Waeh!\n");
  return ::eat("ei");
}
