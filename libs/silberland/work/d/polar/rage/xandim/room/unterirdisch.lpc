//Raum unter Eisschlange
//Filename: unterirdisch.c
//File by Rage, August 04

inherit "std/room";

#include "../def.h"
#include <verben.h>

int eier;
nosave string *kuhle_gemacht;

create()
{
  ::create();

  eier = random(3);
  kuhle_gemacht = ({});

  SetProp( P_INT_SHORT, "Unter dem Wachweg" );
  SetProp( P_INT_LONG,
    "Was fuer ein Anblick. Du stehst in einer kleinen, kugelartig geformten " 
    "Hoehle, die gerade so hoch ist, dass Du noch aufrecht stehen kannst. "
    "Alles um Dich herum besteht aus Eis und dementsprechend kalt ist es "
    "auch hier drinnen. Der Spalt, durch das Du hereingekommen bist, laesst "
    "einige Lichtstrahlen herein, die sich brechen, spiegeln und reflektiert "
    "werden, sodass Du fast geblendet wirst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );

//DETAILS
  AddDetail( "hoehle",
    QueryProp(P_INT_LONG) );
  AddDetail( "eis",
    "Nichts als gefrorenes Wasser." );
  AddDetail( "wasser",
    "... wuerde hier sofort erstarren." );
  AddDetail( ({ "spalt","spalte" }),
    "Durch den Spalt bist Du hier hereingerutscht. Ob Du auf diesem Weg "
    "auch wieder rauskommst, bleibt fraglich." );
  AddDetail( "weg",
    "Der einzige Weg, den Du siehst, fuehrt nach Nordosten." );
  AddDetail( "nordosten",
    "Trau Dich ruhig rein, es wird Dir schon nichts passieren!" );
  AddDetail( "anblick",
    "Dir bleibt fast der Mund offen stehen bei diesem wunderbaren Anblick. "
    "Das Licht bricht sich in alle nur erdenklichen Farben." );
  AddDetail( "mund",
    "Mach ihn wieder zu ;)" );
  AddDetail( ({ "farben","farbe" }),
    "Rot, Gruen, Blau, Gelb, Violett, Orange und Beige, um nur einige "
    "aufzuzaehlen." );
  AddDetail( ({ "rot","gruen","blau","gelb","violett","orange" }),
    "Ja, was fuer eine schoene Farbe." );
  AddDetail( "beige",
    "Beige? Sehr ungewoehnlich. Seit wann bricht sich Licht in Beige? "
    "Als Du etwas laenger darueber nachdenkst, faellt Dein Blick auf etwas, "
    "das _wirklich_ beige ist." );
  AddDetail( ({ "licht","lichtstrahl","lichtstrahlen","strahl","strahlen" }),
    "Nur etwas Licht von draussen reicht aus, um die ganze Hoehle in "
    "wundervolles Glitzern zu tauchen." );
  AddDetail( "glitzern",
    "Das Licht bricht sich in alle nur erdenklichen Farben." );
  AddDetail( "blick",
    "Dein Blick faellt auf zwei beige Gebilde, die sich in einer Mulde "
    "am Boden befinden, die Dir vorhin anscheinend entgangen ist." );
  AddSpecialDetail( "gebilde", "detail_Gebilde" );
  AddSpecialDetail( "mulde", "detail_Mulde" );
  AddSpecialDetail( ({ "eisschlangennest","schlangennest","nest" }),
    "detail_Nest" );
  AddDetail( "waerme",
    "Davon kannst Du hier wenig spueren." );
  AddDetail( ({ "eisfloeckchen","floeckchen" }),
    "Die Floeckchen sehen recht kuschelig aus. Gerade richtig, um "
    "Zerbrechliches weich zu betten." );
  AddDetail( "zerbrechliches",
    "Pass bloss auf, dass Du nichts zerbrichst." );
  AddDetail( "intuition",
    "Deine Intuition sagt Dir auch, dass Stehlen etwas sehr Verwerfliches "
    "ist!" );
  AddDetail( "stehlen",
    "Sowas wuerdest Du nie machen!" );
  AddDetail( "verwerfliches",
    "Es waere mehr als boese, Eisschlangeneier aus dem Nest zu stehlen!!" );
  AddDetail( "finger",
    "Du zaehlst ab. Puh, noch alle da!" );
  AddSpecialDetail( ({ "eisschlangeneier","eisschlangenei","eier","ei" }),
    "detail_Eier" );
  AddDetail( "kaelte",
    "Die bekommst Du hier deutlich zu spueren." );
  AddDetail( "boden",
    "Der Boden besteht - wie alles hier- aus blankem Eis. Dank Deines "
    "phaenomenalen Gleichgewichts schaffst Du es, nicht auszurutschen." );
  AddDetail( "gleichgewicht",
    "Patsch! Und schon liegst Du am Boden. Du bist anscheinend doch nicht "
    "so gut ausbalanciert, wie Du dachtest ;)" );
  AddDetail( "waende",
    "Die Waende sind... aus Eis! Richtig. Sie gehen nahtlos in einer "
    "Rundung in die Decke ueber. Nur eine Wand sieht irgendwie anders aus." );
  AddDetail( "wand",
    "In einer Wand befindet sich der Spalt, durch den die Lichtstrahlen "
    "hereinfallen und durch den auch Du ueber die Eisplatte hereingerutscht "
    "bist." );
  AddDetail( "decke",
    "Die Decke ist knapp ueber Dir und Du bist froh, aufrecht stehen zu "
    "koennen. Sie ist natuerlich auch aus Eis und komplett uninteressant." );
  AddDetail( ({ "eisplatte","platte" }),
    "Es sieht leider so aus, als waere die Platte zu rutschig, um an ihr "
    "wieder nach draussen zu kommen. Dabei braeuchtest Du doch nur eine "
    "einzige kleine Unebenheit in der Eisplatte, um raufzuklettern, denn "
    "so weit oben ist der Spalt nicht." );
  AddDetail( "unebenheit",
    "Akribisch untersuchst du die Eisplatte. Vielleicht solltest Du sie "
    "mal betasten?" );
  AddDetail( "rundung",
    "Du betaetschelst Deine Rundung am Bauch und gruebelst, wann Du "
    "zuletzt was gegessen hast. Die Rundung an der Decke hingegen "
    "verleiht der Hoehle ihr kugeliges Aussehen." );
  AddDetail( "bauch",
    "Wenn Du nach unten blickst, ist er das erste, was Dir in die Augen "
    "sticht." );
  AddDetail( ({ "auge","augen" }),
    "Du hast 2 davon. *klimper*" );
  AddDetail( ({ "aussehen","eiskugel" }),
    "Die Hoehle sieht aus wie eine grosse, hohle Eiskugel." );
  AddSpecialDetail( "kuhle", "detail_Kuhle" );
//END DETAILS
  
  AddCmd( ({ "stehl","stehle","stiehl" }), "cmd_stehlen" );
  AddCmd( ({ "tast","taste","betast","betaste" }), "cmd_betasten" );
  AddCmd( CMD_KLETTERN + CMD_KRAXELN, "cmd_klettern" );
}

string detail_Gebilde()
{
  if ( eier == 2 )
    return
      "Zwei beige Gebilde liegen in einer Mulde am Boden.\n";
  else if ( eier == 1 )
    return
      "Du hast Dich wohl getaeuscht, denn Du siehst nur eines.\n";
  else
    return
      "Du hast Dich wohl getaeuscht, denn Du siehst gar keines.\n";
}
string detail_Mulde()
{
  if ( eier == 2)
    return BS(
      "In der Mulde liegen - weich gebettet auf Eisfloeckchen - zwei "
      "Eisschlangeneier. HA! Hat Dich Deine Intuition vorhin doch nicht "
      "getaeuscht, dass sich hier das Eisschlangennest befindet." );
  else if ( eier == 1 )
    return BS(
      "In der Mulde liegt - weich gebettet auf Eisfloeckchen - ein "
      "Eisschlangenei. HA! Hat Dich Deine Intuition vorhin doch nicht "
      "getaeuscht, dass sich hier das Eisschlangennest befindet." );
  else
    return BS(
      "Du scheinst das Eisschlangennest gefunden zu haben, doch leider "
      "befinden sich derzeit keinerlei Eier darin." );
}
string detail_Nest()
{
  if ( eier == 2 )
    return BS(
      "Das Nest ist genau so positioniert, dass ein Lichtstrahl durch den "
      "Spalt auf die Eisschlangeneier faellt. Durch seine Waerme werden "
      "die Eier ausgebruetet." );
  else if ( eier == 1 )
    return BS(
      "Das Nest ist genau so positioniert, dass ein Lichtstrahl durch den "
      "Spalt auf das Eisschlangenei faellt. Durch seine Waerme wird "
      "das Ei ausgebruetet." );
  return BS(
      "Das Nest ist genau so positioniert, dass ein Lichtstrahl durch den "
      "Spalt auf das Nest faellt. Durch seine Waerme werden hier sicher "
      "die Eier ausgebruetet, von denen Du allerdings keine sehen "
      "kannst.");
}
string detail_Eier()
{
  if ( eier == 2)
    return BS(
      "Kleine, beige unscheinbare Eier. Kaum zu glauben, dass in dieser "
      "Kaelte die Eier nicht einfrieren." );
  else if ( eier == 1 )
    return BS(
      "Ein kleines, beiges unscheinbares Ei. Kaum zu glauben, dass es in "
      "dieser Kaelte nicht erfriert." );
  else      
    return
      "Wo genau siehst Du hier Eier?\n";
}
string detail_Kuhle()
{
  if ( member(kuhle_gemacht,getuid(TP)) != -1 )
    return BS(
      "Durch Deine warmen Finger konntest Du eine kleine Kuhle in "
      "das Eis schmelzen, an der Du sicher wieder aus dieser Hoehle "
      "rausklettern kannst." );
  return
    "Sowas siehst Du da nicht!\n";
}
//COMMANDS
int cmd_stehlen(string str)
{
  object ei;

  notify_fail( "Du willst etwas stehlen?\n" );

  if ( !str || str=="" ) return 0;
  if ( member( ({ "ei","schlangenei","eisschlangenei" }),str) != -1 )
  {
    write(
      "Woraus willst Du das Ei stehlen?\n" );
    return -1;
  }
  if ( member( ({ "ei aus nest","schlangenei aus nest",
		    "eisschlangenei aus nest"
                }),str) != -1 )  
  {
    if ( eier > 0 )
    {
      ei = clone_object(OBJ "schlangenei");
      if ( ME_TOO_HEAVY == ei->move(TP,M_GET|M_SILENT) )
      {
        write(
          "Da Du schon zuviel mitschleppst, brichst Du den "
          "Diebstahlversuch ab.\n" );
        ei -> remove();
      }  
      write( BS(
        "Nachdem Du Dich nicht beobachtet fuehlst, huschen Deine "
        "diebischen Finger ueber das Nest und schon hast Du ein "
        "Ei eingesteckt.") );
      say(
        TPN+" macht sich an dem Nest zu schaffen.\n" );
      eier--;
      return 1;
    }
    write( BS(
      "Deine diebische Veranlagung geht schon dermassen mit Dir "
      "durch, dass Du etwas stehlen willst, was gar nicht da ist.") );
    return -1;
  }
}

int cmd_betasten(string str)
{
  notify_fail( "Was wuerdest Du gerne betasten?\n" );
  
  if ( member( ({ "eisplatte","platte" }),str) != -1 )
  {
    write( BS(
      "Mit Deinen warmen Fingern tastest Du die Eisplatte ab und "
      "findest nichts. Enttaeuscht wendest Du Dich ab, als Du "
      "ploetzlich bemerkst, dass Du eine kleine Kuhle durch Deine "
      "warmen Finger in das Eis der Platte geschmolzen hast. An "
      "dieser Kuhle kannst Du nun sicher wieder rausklettern.") );
    say(
      TPN+" tastet das Eis ein wenig ab.\n" );
    kuhle_gemacht += ({ getuid(TP) });
    return 1;
  }
}

int cmd_klettern(string str)
{
  notify_fail( "Woran willst Du rausklettern?\n" );
  
  if ( member( ({ "an kuhle rauf","an kuhle raus",
                  "an kuhle nach oben","an kuhle nach draussen"
               }),str) != -1 )
  {
    if ( member(kuhle_gemacht,getuid(TP)) != -1 )
    {
      write( BS(
        "Ein geschickter Tritt in die Kuhle und schon kletterst Du durch "
        "den Spalt ins Freie.") );
      say(
        TPN+" klettert hinaus.\n" );
      TP -> move("/d/polar/thor/xandim/room/wachweg11", M_GO|M_SILENT);
      kuhle_gemacht -= ({ getuid(TP) });
      return 1;
    }
    write(
      "Du findest keine Kuhle, die Dir beim Klettern behilflich "
      "waere.\n" );
    return -1;
  }
}
//END COMMANDS

void reset()
{
  ::reset();
  
  eier = random(3);
  kuhle_gemacht = ({});
}
