//Ostweg von Yiqanuc, Rage Feb 00

#include "../def.h"
#include "../sturm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int norden;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Schneesturm" );
  SetProp( P_INT_LONG,
    "Du bist mitten in einen furchtbaren Schneesturm geraten. Die Sicht ist "
    "auf ein Minumum gesunken, Dir ist kalt und das einzige, woran Du denken "
    "kannst, ist: Wie komme ich hier wieder raus?" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -40]) );

//DETAILS
  AddDetail( ({ "boden" }),
    "In der kurzen Zeit, in der Du Dich hier befindest, sind sicher fuenf "
    "Zentimer Neuschnee gefallen, der alle Spuren verschwinden laesst." );
  AddDetail( ({ "himmel" }),
    "Wie schoen waere Sonnenschein, doch auf den wirst Du noch warten "
    "muessen." );
  AddDetail( ({ "sonnenschein","sonne" }),
    "Hier und Sonnenschein? Du bist wohl das erste Mal in einen Schneesturm "
    "geraten?" );
  AddDetail( ({ "spur","spuren" }),
    "Saemtliche Spuren werden sofort durch Wind und Schnee ausgeloescht." );
  AddDetail( ({ "schneesturm","sturm" }),
    "Du erkennst den Schneesturm daran, dass Du vor lauter Schnee nichts "
    "sehen kannst." );
  AddDetail( ({ "wind" }),
    "Wind ist noch milde ausgedrueckt. Du bist im aergsten Sturm, den Du je "
    "erlebt hast." );
  AddDetail( ({ "schnee" }),
    "Der ist mittlerweile in Deinem Gesicht und auf Deinem ganzen Koerper "
    "verteilt." );
  AddDetail( ({ "gesicht" }),
    "Du wischt Dir mal kurz den Schnee aus dem Gesicht. Wird zwar nicht "
    "viel helfen, aber Du fuehlst Dich sauberer dadurch." );
  AddDetail( ({ "koerper" }),
    "Du tastest Deinen Koerper ab und bist ziemlich froh, dass Du noch kein "
    "Gliedmass abgefroren ist." );
  AddDetail( ({ "gliedmass","gliedmasse" }),
    "Alles noch da und fuehlbar. Puuh, Glueck gehabt." );
  AddDetail( ({ "minimum","sicht" }),
    "Praktisch Null. Fast so, als ob Du blind waerst." );

  AddSound( DEFAULT_SOUND,
    "Der Schneesturm pfeift Dir gewaltig um die Ohren." );
  AddSound( ({ "schneesturm","sturm" }),
    "Es ist so hoellisch laut hier, dass Du nicht einmal jemanden "
    "verstehen koenntest, der direkt neben Dir steht. Jeder Schrei "
    "erstickt hier im Keim." );
  AddSound( ({ "schrei" }),
    "War da einer? Nein, sicher nicht. Das kann nur das Heulen des Sturms "
    "gewesen sein." );
  AddSound( ({ "heulen" }),
    "heuuuuuuuuuuuuuuuuuuuul wuuuuuuuuuuuuuuuuh" );
//END DETAILS
}

init()
{
  int i,  weiter, zurueck;

  for ( i=0; i<=7; i++ )
    AddExit(RICHTUNG[i],"./weg5");
  norden = random(8);
  weiter = (norden+2)%8;
  zurueck = (norden+6)%8;
  AddExit(RICHTUNG[weiter],"in den Schneesturm#"+"./weg6");
  AddExit(RICHTUNG[zurueck],"in den Schneesturm#"+"./weg4");
  ::init();
}

int nord_richtung() { return norden; }








