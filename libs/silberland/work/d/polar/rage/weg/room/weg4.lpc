//Ostweg von Yiqanuc, Rage Feb 00

#include "../def.h"
#include "../sturm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int norden;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Schneesturm" );
  SetProp( P_INT_LONG,
    "Du bist mitten in einen furchtbaren Schneesturm geraten. Die Sicht ist "
    "auf ein Minimum gesunken, Dir ist kalt und das einzige, woran Du denken "
    "kannst, ist: Wie komme ich hier wieder raus?" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -40]) );
//DETAILS
  AddDetail( ({ "boden" }),
    "Der ist natuerlich voller Schnee. Du kannst nicht einmal Deine eigenen "
    "Spuren erkennen, da der Sturm und der Schnee sie sofort unkenntlich "
    "machen." );
  AddDetail( ({ "himmel" }),
    "Himmel? Bei diesem Wetter willst Du einen Himmel sehen? Bei Dir zeigen "
    "sich wohl schon die ersten Erkaeltungserscheinungen?" );
  AddDetail( ({ "erkaeltungserscheinungen","erkaeltungserscheinung" }),
    "Solche wie Fieber und Delirium." );
  AddDetail( ({ "fieber","delirium" }),
    "Du fuehlst schon die ersten Anzeichen von Fieber." );
  AddDetail( ({ "anzeichen" }),
    "Hmm, war wohl doch noch nichts, aber zulange wuerde ich nicht in "
    "diesem Sturm verweilen." );
  AddDetail( ({ "wetter" }),
    "Du waerst jetzt sicher lieber am Strand auf der Felseninsel: Viel Sonne "
    "und angenehme Temperaturen." );
  AddDetail( ({ "temperatur","temperaturen" }),
    "Ein Thermometer koennte Dir sicher weiter helfen!" );
  AddDetail( ({ "strand","felseninsel","insel","sonne" }),
    "Traeum nur schoen! Wie gern waerst Du nur dort!" );
  AddDetail( ({ "spur","spuren" }),
    "Du siehst gerade noch Deinen letzten Fussstapfen." );
  AddDetail( ({ "fussstapfen","stapfen" }),
    "Der ist schon wieder weg." );
  AddDetail( ({ "schneesturm","sturm" }),
    "Der ist unuebersehbar. Schnee wird ueberall aufgewirbelt und nimmt Dir "
    "die Sicht." );
  AddDetail( ({ "schnee" }),
    "Schnee scheint das einzige zu sein, dass Du in diesem Sturm erkennen "
    "kannst." );
  AddDetail( ({ "minimum","sicht" }),
    "Praktisch Null. Fast so, als ob Du blind waerst." );

  AddSound( DEFAULT_SOUND,
    "Der Schneesturm pfeift Dir gewaltig um die Ohren." );
  AddSound( ({ "schneesturm","sturm" }),
    "Es ist so hoellisch laut hier, dass Du nicht einmal jemanden "
    "verstehen koenntest, der direkt neben Dir steht. Jeder Schrei "
    "erstickt hier im Keim." );
  AddSound( ({ "schrei" }),
    "War da einer? Nein, sicher nicht. Das kann nur das Heulen des Sturms "
    "gewesen sein." );
  AddSound( ({ "heulen" }),
    "heuuuuuuuuuuuuuuuuuuuul wuuuuuuuuuuuuuuuuh" );
//END DETAILS
}

init()
{
  int i,  weiter, zurueck;

  for ( i=0; i<=7; i++ )
    AddExit(RICHTUNG[i],"./weg4");
  norden = random(8);
  weiter = (norden+2)%8;
  zurueck = (norden+6)%8;
  AddExit(RICHTUNG[weiter],"in den Schneesturm#"+"./weg5");
  AddExit(RICHTUNG[zurueck],"in den Schneesturm#"+"./weg3");
  ::init();
}

int nord_richtung() { return norden; }








