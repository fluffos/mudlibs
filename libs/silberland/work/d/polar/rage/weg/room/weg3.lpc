//Ostweg von Yiqanuc, Rage Feb 00

#include "../def.h"
#include "../sturm.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int norden;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Schneesturm" );
  SetProp( P_INT_LONG,
    "Du bist mitten in einen furchtbaren Schneesturm geraten. Die Sicht ist "
    "auf ein Minumum gesunken, Dir ist kalt und das einzige, woran Du denken "
    "kannst, ist: Wie komme ich hier wieder raus?" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -40]) );

//DETAILS
  AddDetail( ({ "boden" }),
    "Der ist natuerlich voller Schnee. Du kannst nicht einmal Deine eigenen "
    "Spuren erkennen, da der Sturm und der Schnee sie sofort unkenntlich "
    "machen." );
  AddDetail( ({ "himmel" }),
    "Den siehst Du bei diesem Wetter sicher nicht!" );
  AddDetail( ({ "wetter" }),
    "Also so eines wie dieses wuerde ich als Sch..wetter bezeichnen." );
  AddDetail( ({ "spur","spuren" }),
    "Keine zu sehen." );
  AddDetail( ({ "schneesturm","sturm" }),
    "Du kannst gerade noch verhindern, dass Du davongetragen wirst. Nur "
    "bloss raus hier!" );
  AddDetail( ({ "schnee" }),
    "Der ist mittlerweile in Deinem Gesicht und auf Deinem ganzen Koerper "
    "verteilt." );
  AddDetail( ({ "gesicht","koerper" }),
    "Du siehst aus wie ein Schneemann." );
  AddDetail( ({ "schneemann" }),
    "Ausser Dir ist hier keiner zu sehen." );
  AddDetail( ({ "minimum","sicht" }),
    "Praktisch Null. Fast so, als ob Du blind waerst." );

  AddSound( DEFAULT_SOUND,
    "Der Schneesturm pfeift Dir gewaltig um die Ohren." );
  AddSound( ({ "schneesturm","sturm" }),
    "Es ist so hoellisch laut hier, dass Du nicht einmal jemanden "
    "verstehen koenntest, der direkt neben Dir steht. Jeder Schrei "
    "erstickt hier im Keim." );
  AddSound( ({ "schrei" }),
    "War da einer? Nein, sicher nicht. Das kann nur das Heulen des Sturms "
    "gewesen sein." );
  AddSound( ({ "heulen" }),
    "heuuuuuuuuuuuuuuuuuuuul wuuuuuuuuuuuuuuuuh" );
//END DETAILS
}

init()
{
  int i,  weiter, zurueck;

  for ( i=0; i<=7; i++ )
    AddExit(RICHTUNG[i],"./weg3");
  norden = random(8);
  weiter = (norden+2)%8;
  zurueck = (norden+6)%8;
  AddExit(RICHTUNG[weiter],"in den Schneesturm#"+"./weg4");
  AddExit(RICHTUNG[zurueck],"in den Schneesturm#"+"./weg2");
  ::init();
}

int nord_richtung() { return norden; }








