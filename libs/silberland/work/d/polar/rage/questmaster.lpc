// Questmaster fuer Eispalastquest, Rage Feb 00

#include "./palquest.h"

mapping queststats;

create()
{
  if ( IS_CLONE(TO) )
  {
    remove();
    return;
  }
  restore_object(QUESTMASTER);
  if ( !mappingp(queststats) )
  {
    queststats = ([]);
  }
}

void AddPlayer(object player)
{
  queststats += ([getuid(player):0]);
  save_object(QUESTMASTER);
}

int PlayerInQuest(object player)
{
  if ( member(queststats,getuid(player)) ) return 1;
  return 0;
}

int DelPlayer(string uid)
{
  if ( member(queststats,uid) ) return 0;
  queststats = m_delete(queststats,uid);
  return 1;
}