// Frettchen am Ostplatz
// Filename: frettchen.c
// File by Rage, April 03

inherit "std/npc";

#include "../def.h"
#include <combat.h>
#include <moving.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Frettchen" );
  SetProp( P_LONG,
    "Das Frettchen ist total weiss und hat rote Augen. Es sieht einem "
    "Iltis ziemlich aehnlich und ausserdem sieht es Dich sehr "
    "veraengstigt an. Es wuerde sicher gern wieder freigelassen werden." );

  SetProp( P_NAME, "Frettchen" );
  SetProp( P_GENDER, NEUTER );
  SetProp( P_TEMPERATURE_RANGE,([T_RANGE_MIN:-20,T_RANGE_MAX:18]) );
  AddId( ({ "frettchen","\nfrettchen" }) );

  create_default_npc(8);
  SetProp( P_HANDS, ({ " mit seinen kleinen Pfoten", 80, DT_RIP }) );
  SetProp( P_RACE, "Nagetier" );
  SetProp( P_SIZE, 30 );
  SetProp( P_ALIGN, 20 );
  SetProp( P_MAX_HANDS, 4 );
  SetProp( P_WEIGHT, 1000 );
  SetProp( P_NODROP, "Du musst das Frettchen schon frei lassen.\n" );

  SetProp( P_MSGIN, "wuselt herein" );
  SetProp( P_MSGOUT, "wuselt" );
  SetProp( P_MMSGIN, "wuselt herein" );
  SetProp( P_MMSGOUT, "wuselt davon" );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Frettchen beachtet den Gegenstand gar nicht.\n" }) );

  AddInfo( DEFAULT_INFO, " kann nicht reden.\n" );

  AddCmd( ({ "lasse","lass" }), "cmd_lassen" );
}

//COMMANDS
int cmd_lassen(string str)
{
  object sackerl;

  notify_fail( "Willst Du das Frettchen wieder frei lassen?\n" );

  if ( str == "frettchen frei" )
  {
    if ( present("\nfrettchenkind", ENV(TP)) )
    {
      write( BS(
        "Statt das Frettchen frei zu lassen, gibst Du es lieber dem Xandimkind, "
        "das sich sehr darueber freut und sich gleich bei Dir bedankt. ") );
      sackerl = clone_object( OBJ "kekssackerl" );
      if ( ME_TOO_HEAVY == sackerl->move(TP,M_GET|M_SILENT) )
      {
      	write( BS(
      	  "Das Kind will wir ein Sackerl geben, sieht aber, dass es Dir zu "
      	  "schwer ist und stellt es deshalb vor Dir ab.") );
        sackerl -> move(ENV(TP));
        return 1;
      }
      write(
        "Als Dankeschoen hast Du eine Kleinigkeit von ihm erhalten.\n" );
      tell_room(ENV(TP),
        TPN+" gibt dem Xandimkind ein Frettchen.\n", ({ TP }) );
      TO-> remove();
      return 1;
    }
    write( BS(
      "Endlich erloest Du das Frettchen von seinen Qualen, indem Du es wieder "
      "frei laesst. Kurz darauf laeuft es auch schon davon.") );
    tell_room(ENV(TP),
      TPN+" laesst ein Frettchen frei, das gleich davon rennt.\n", ({ TP }) );
     TO-> remove();
    return -1;
  }
}
//END COMMANDS

//RESET
void reset()
{
  ::reset();
  if ( ENV(ME) && query_once_interactive(ENV(ME)) )
  {
    write(
      "Das Fretchen reisst sich frei und laeuft davon.\n" );
    TO -> remove();
  }
}