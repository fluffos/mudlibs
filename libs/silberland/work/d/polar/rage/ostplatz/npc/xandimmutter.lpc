//Xandimmutter, Rage Nov00

inherit "std/npc";

#include "../def.h"
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <npcmaster.h>
#include <class.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Eine Xandimmutter" );
  SetProp( P_LONG,
    "Die Mutter traegt wie alle Xandim ein langes, hellbraunes Fell und "
    "hat in ihrer linken Hand ein Schwert gezueckt. Sie sieht nicht gerade "
    "freundlich aus, weil ihr Kind bedroht wurde und sie es nun zu schuetzen "
    "versucht." );
  SetProp( P_NAME, "Xandimmutter" );
  SetProp( P_NAME_ADJ, "besorgt" );
  AddAdjective( ({ "besorgte" }) );
  SetProp( P_GENDER, FEMALE );
  AddId( ({ "\nxandimmutter", "mutter", "xandim", "xandimmutter",
            "NOWIMPY", "NOCONTROL" }) );

  create_default_npc(19+random(3));
  SetProp(P_HANDS, ({" mit brutalen Faeusten", 150, DT_BLUDGEON}));
  SetProp( P_RACE, "Xandim" );
  AddClass( CL_HUMAN );
  SetProp( P_SIZE, 240 );
  SetProp( P_ALIGN, 200+random(50) );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_BODY, 130 );
  SetProp( P_HEAL, 0 );
  SetProp( P_AGGRESSIVE, 0 );
  SetProp( P_WIMPY, 0 );
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5, DT_FIRE:0.2]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15, T_RANGE_MAX:25]) );
  SetProp( P_NOMAGIC,0 );
  SetProp( P_MSGIN, "kommt von hinter dem Holzgeruest herbeigelaufen" );
  SetProp( P_MSGOUT, "verschwindet hinter dem Holzgeruest" );
  SetProp( P_MMSGIN, "kommt von hinter dem Holzgeruest herbeigelaufen" );
  SetProp( P_MMSGOUT, "verschwindet wieder hinter dem Holzgeruest" );
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n" );
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_NO_SCORE, 1 );
  

  AddInfo( DEFAULT_INFO, "blickt Dich nichteinmal an.\n" );
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Mutter nimmt nichts von Dir an.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(2, 200,
    "Die Xandimmutter bringt Dich mit einem Fusstritt zu Fall.\n",
    "Die Xandimmutter bringt @WEN mit einem Fusstritt zu Fall.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 250,
    "Die Xandimmutter schlaegt Dir brutal aufs Ohr.\n",
    "Die Xandimmutter schlaegt @WEM brutal aufs Ohr.\n",
     ({ DT_SOUND,DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 350,
    "Die Xandimmutter trifft Dich schmerzhaft im Genick\n",
    "Die Xandimmutter trifft @WEN schmerzhaft im Genick.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats( 10, ({
   "Die Xandimmutter will Dir den Hals umdrehen.\n",
   "Die Xandimmutter kaempft verbissen um das Leben ihres Kindes.\n",
   "Die Xandimmutter trachtet nach Deinem Tod.\n" }) );

  SUID;
  CLONEME( "/d/polar/thor/xandim/weapon/breitschwert" );
  command( "zuecke schwert" );
  if ( !random(9) ) CLONEME( OBJ "putzlappen" );
}

varargs die(object killer, int poisondeath)
{
  present("\nxandimkind",ENV(ME)) -> SetProp(P_WAISE_MUTTER, 1);
  ::die(killer, poisondeath);
}