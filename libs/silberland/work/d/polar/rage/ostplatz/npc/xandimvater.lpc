//Xandimvater, Rage Mär 00

inherit "std/npc";

#include "../def.h"
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <npcmaster.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Xandimvater" );
  SetProp( P_LONG,
    "Der Vater traegt ein langes, hellbraunes Fell, dessen Farbe eine Spur "
    "dunkler ist als jenes von Frauen. Er ist gross, stark und muskuloes, aber "
    "das beunruhigenste ist wohl, dass er sehr wuetend ist, da sein Kind "
    "angegriffen wurde. Er wird das Leben seines Kindes mit seinem eigenen "
    "verteidigen." );
  SetProp( P_NAME, "Xandimvater" );
  SetProp( P_NAME_ADJ, "wuetend" );
  AddAdjective( ({ "wuetender" }) );

  SetProp( P_GENDER, MALE );
  AddId( ({ "\nxandimvater", "vater", "xandim", "xandimvater",
            "NOWIMPY", "NOCONTROL" }) );

  create_default_npc(19+random(3));
  SetProp( P_HANDS, ({" mit brutalen Faeusten", 150, DT_BLUDGEON}) );
  SetProp( P_RACE, "Xandim" );
  SetProp( P_SIZE, 240 );
  SetProp( P_ALIGN, 200+random(50) );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_BODY, 130 );
  SetProp( P_HEAL, 0 );
  SetProp( P_AGGRESSIVE, 0 );
  SetProp( P_WIMPY, 0 );
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5, DT_FIRE:0.2]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15, T_RANGE_MAX:25]) );

  SetProp( P_NOMAGIC, 0 );

  SetProp( P_MSGIN, "stampft von einem Laden kommend herein" );
  SetProp( P_MSGOUT, "verschwindet in der Menge vor den Laeden" );
  SetProp( P_MMSGIN, "kommt von einem Laden hergelaufen" );
  SetProp( P_MMSGOUT, "verschwindet in der Menge vor den Laeden" );
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n" );
  SetProp( P_NOCORPSE, 0 );
  SetProp( P_NO_SCORE, 1 );
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Vater nimmt nichts von Dir.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1, 250,
    "Der Xandimvater nimmt Dich in den Schwitzkasten.\n",
    "Der Xandimvater nimmt @WEN in den Schwitzkasten.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 300,
    "Der Xandimvater tritt Dir genau in die Kniekehle.\n",
    "Der Xandimvater tritt @WEM genau in die Kniekehle.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats( 10, ({
    "Der Xandimvater versucht, Dich in den Schwitzkasten zu nehmen.\n",
    "Der Xandimvater verteidigt das Leben seines Kindes mit dem Tod.\n",
    "Der Xandimvater blickt Dir verachtenswuerdig in die Augen.\n" }) );
   
  CLONEME( "/d/polar/thor/xandim/weapon/kriegsaxt" );
  command( "zuecke axt" );
}

varargs die(object killer, int poisondeath)
{
  present("\nxandimkind",ENV(ME)) -> SetProp(P_WAISE_VATER, 1);
  ::die(killer, poisondeath);
}