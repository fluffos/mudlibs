// Herumspielendes Kind
// Filename: kind_laufend.c
// File by Rage, April 03

inherit "std/mnpc";

#include "../def.h"
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Xandimkind" );
  SetProp( P_LONG,
    "Das Xandimkind koenntest Du von der Groesse her und wegen des Felles fast "
    "fuer einen Teddybaeren halten. Es laeuft staendig herum, spielt mit den "
    "Schlittenhunden oder hat einfach so Spass." );
//DETAILS
  AddDetail( ({ "teddybaeren","teddybaer" }),
    "Beinahe hast Du gedacht, dass ein Teddybaer vor Dir steht, aber es ist "
    "doch nur ein Xandimkind." );
  AddDetail( "spass",
    "Da das Kind fast die ganze Zeit zu lachen scheint, wird es wohl eine "
    "Menge Spass haben." );
  AddDetail( "groesse",
    "Das Kind ist natuerlich kleiner als die Erwachsenen, aber man koennte "
    "es fast fuer einen groesseren Teddybaeren halten." );
//END DETAILS

  SetProp( P_NAME, "Xandimkind" );
  SetProp( P_GENDER, NEUTER );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:20]) );
  AddId( ({ "kind","xandimkind","\nfrettchenkind" }) );
  set_living_name("xandimkind");

  create_default_npc(9);
  SetProp( P_HANDS, ({ " mit seinen Haenden", 75, DT_BLUDGEON }) );
  SetProp( P_RACE, "Xandim" );
  SetProp( P_SIZE, 100+random(20) );
  SetProp( P_ALIGN, 250 );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_AGGRESSIVE, 0 );
  SetProp( P_WIMPY, 0 );
  SetProp( P_NOATTACK, "loest Schuldgefuehle bei Dir aus, und so verschonst Du es.\n" );


  SetProp( P_REJECT, ({ REJECT_GIVE,"Das Kind ist der Meinung, dass Du das "
	 		            "selbst noch brauchen wirst.\n" }) );

  SetProp( P_MSGIN, "laeuft herein" );
  SetProp( P_MSGOUT, "laeuft verspielt" );
  SetProp( P_MMSGIN, "rennt Dich fast ueber den Haufen" );
  SetProp( P_MMSGOUT, "laeuft ganz schnell zu seiner Mutter weg" );
  SetProp( P_MNPC_AREA, "/d/polar/rage/ostplatz/room" );
  SetProp( P_MNPC_WAIT, ({ 10, 10, 10 }) );
  SetProp( P_MNPC_DEFAULTROOM, ROOM "ostplatz_c1" );
  SetProp( P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS 
                         + MOV_SPECIAL + MOV_INFIGHT );


  SetChats( 2, ({
    "Das Kind laechelt Dich gluecklich an.\n",
    "Das Kind spielt mit einem Schlittenhund.\n",
    "Das Kind wird in eine kleine Schneeballschlacht verwickelt.\n",
    "Eine Mutter ruft ihr Kind zum Essen.\n",
    "Das Kind streichelt einen Schlittenhund am Bauch.\n"
                 }) );

  AddLibrary( NPC "ostplatz.lib", 1 );
  AddInfo( DEFAULT_INFO, ({
    "spielt lieber mit dem Hund, als mit Dir zu reden.\n",
    "versteht nicht ganz, was Du meinst.\n",
    "fragt ein anderes Kind danach.\n",
    "laesst sich von Dir nicht stoeren.\n",
    "hoert Dir nicht zu.\n"
                           }) );
  AddInfo( "spass",
    "Ohja, ich und alle anderen Kinder haben sehr viel Spass auf dem Ostplatz. "
    "Ich freu mich ueber jede Stunde, die ich hier verbringen kann.",
    "laechelt Dich an: " );
  AddInfo( ({ "ostplatz","platz" }),
    "Hihi. Auf dem stehst Du doch gerade!",
    "kichert frech: " );
  AddInfo( "rage",
    "Der kommt manchmal vorbei und bringt mir ein Eis mit. Der ist ganz nett.",
    "sagt: " );
  AddInfo( ({ "schlittenhund","schlittenhunde","hund","hunde","husky",
              "huskies" }),
    "Wir wachsen mit den Hunden von klein an auf, damit sie uns eines Tages "
    "respektieren, wenn wir mit ihnen auf die Jagd gehen.",
    "sagt: ",1 );
  AddInfo( "respekt",
    "Wenn die Hunde keinen Respekt vor Dir haben, dann darfst Du ihnen nicht "
    "zu nahe kommen. Schon manch einer hat seine Hand dabei verloren.",
    "erklaert Dir: ", 1 );
  AddInfo( ({ "jagd","eisbaerenjagd" }),
    "Wenn ich gross bin, dann gehe ich selbst mit einem Schlitten und den "
    "Hunden auf Eisbaerenjagd!",
    "sagt ganz stolz: ", 1 );
  AddInfo( ({ "eisbaer","eisbaeren" }),
    "Ein sehr gefaehrliches Tier. Mit dem sollte man sich freiwillig besser "
    "nicht anlegen.",
    "warnt Dich: ", 1 );
  AddInfo( ({ "schneemann","schneemaenner" }),
    "Auf dem Ostplatz bauen wir immer wieder unsere Schneemaenner, aber bist "
    "Du nicht schon zu gross dafuer?",
    "meint: ", 1 );
  AddInfo( "eltern",
    "Die sind immer in der Naehe und passen auf mich auf.",
    "warnt Dich: ", 1 );
}