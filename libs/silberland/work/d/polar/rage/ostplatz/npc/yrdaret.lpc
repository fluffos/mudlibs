//Questansprechperson Yrdaret, Rage Feb 00

#include "../def.h"

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

nosave string * tipp;
string tipp_erfasst(string key);

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();
  tipp = ({});

  SetProp( P_SHORT, "Yrdaret, Oberhaupt der Xandim" );
  SetProp( P_LONG,
    "Yrdaret, das Oberhaupt des Xandimdorfes, sitzt gemuetlich auf einem "
    "Eisbaerenfell und unterhaelt sich mit seinen Stammesgenossen. In Midas "
    "wuerde man seine Position wohl als Buergermeister bezeichnen, aber hier "
    "verzichtet man auf Titel. Er sieht sehr beschaeftigt aus. Ich wuerde ihn "
    "nur stoeren, wenn es unbedingt notwendig ist. Er unterscheidet sich von "
    "den anderen Xandim nur durch eine Taetowierung auf der Stirn." );

//DETAILS
  AddDetail( ({ "taetowierung" }),
    "Sie ist in schwarz gehalten und besteht aus drei Kreise, die in Form "
    "eines Dreiecks ineinander greifen." );
  AddDetail( ({ "stirn" }),
    "Genau in der Mitte der Stirn ist eine kleine Taetowierung." );
  AddDetail( ({ "form","kreise","dreieck" }),
    "Zwei der drei Kreise, die sich ueberschneiden, liegen knapp unterhalb des "
    "Haaransatzes, waehrend der dritte unter den beiden anderen liegt, und "
    "diese ebenfalls ueberschneidet. Das ganze kann man sich wie bei der "
    "Mengenlehre vorstellen mit den drei Mengen A, B und C." );
  AddDetail( ({ "haaransatz","ansatz" }),
    "Damit ist der Ansatz der Haare oberhalb der Stirn gemeint." );
  AddDetail( ({ "haare","haar" }),
    "Das Haar sollte man besser als Fell bezeichnen, denn jeder Xandim "
    "traegt ein Ganzkoerperfell, das in diesem Fall bereits die ersten "
    "Spuren von weiss enthaelt." );
//END DETAILS

  SetProp( P_NAME, "Yrdaret" );
  SetProp( P_GENDER, MALE );
  SetProp( P_TEMPERATURE_RANGE,([T_RANGE_MIN:-10,T_RANGE_MAX:25]) );
  SetProp( P_ARTICLE, 0 );
  AddId( ({ "yrdaret","oberhaupt","stammesoberhaupt","xandim" }) );
  set_living_name("yrdaret");

  create_default_npc(20);
  SetProp( P_RACE, "Xandim" );
  SetProp( P_SIZE, 220 );
  SetProp( P_ALIGN, 250 );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_NOATTACK, "kaempft nicht mit Dir.\n" );
  SetProp( P_SOUND, "Yrdaret diskutiert eifrig mit seinen Stammesgenossen.\n" );

//INFOS
  SetChats( 2, ({
    "Yrdaret redet von den alten Zeiten.\n",
    "Das Oberhaupt hoert sich genau an, was die anderen Xandim zu "
    "berichten haben.\n",
    "Yrdaret scheint in Gedanken verloren zu sein.\n",
    "Der Xandim bespricht etwas mit seinen Stammesgenossen.\n"
                }) );
  AddLibrary( NPC "ostplatz.lib", 5 );
  AddInfo( DEFAULT_INFO, ({
    "hat keine Zeit fuer so etwas.\n",
    "ist mit Wichtigerem beschaeftigt.\n",
    "nimmt Dich nicht zur Kenntnis.\n",
    "meint: Denke mal selbst einwenig nach!\n",
    "kann Dir nicht weiterhelfen.\n"
                           }) );
  AddInfo( ({ "maus","schneemaus" }),
    "Du meinst die kleine weisse Maus? Die lebt schon lange hier, denn sie "
    "laesst sich von niemandem einfangen.",
    "erzaehlt: ", 1 );
  AddInfo( ({ "stecken","holzstecken" }),
    "Der Holzstecken wird wohl aus Fichte sein. Das Holz kommt sicher aus dem "
    "Wald westlich von hier. Fuer eine Wirtshausschlaegerei sicher praktisch, "
    "aber wir Xandim halten nichts von solchen Gewalttaten.",
    "erklaert Dir: ", 1 );
  AddInfo( ({ "lederband","band" }),
    "Gewoehnlicherweise kann man mit einem Band etwas zusammenbinden. Manche "
    "Xandimfrauen binden sich die Haare damit zusammen, aber es wird auch zu "
    "anderen Zwecken verwendet.",
    "meint nur: ", 1 );
  AddInfo( ({ "zwecke","zweck" }),
    "Die anderen Zwecke wirst Du sicher noch erkennen.");
  AddInfo( ({ "stueck","elfenbeinstueck" }),
    "Das Elfenbein stammt sicher von den Walrossen, die wir als unsere "
    "Hauptnahrungsquelle jagen.",
    "sagt: ", 1 );
  AddInfo( ({ "fichte","fichten" }),
    "Eine der wenigen Nadelbaeume, die im hohen Norden waechst.",
    "antwortet: ", 1 );
  AddInfo( ({ "gewalttaten","wirtshausschlaegerei" }),
    "Von derartigen Dingen halten wir Xandim nichts. Wir sind ein ruhiges und "
    "friedliches Volk.",
    "erzaehlt Dir: ", 1 );
  AddInfo( ({ "kreise","taetowierung","symbol" }),
    "Die drei Kreise sind das Symbol fuer Geist, Verstand und Kraft, die "
    "durch das Ineinandergreifen zu einer Einheit verbunden werden.",
    "erklaert Dir: ",  1 );
  AddInfo( ({ "geist","seele" }),
    "Ist man mit seinem Geist nicht im Reinen, ist man nicht wuerdig, andere "
    "Leute zu fuehren.",
    "spricht: ", 1 );
  AddInfo( ({ "verstand" }),
    "Fuer gewisse Aufgaben ist es unumgaenglich, einen scharfen Verstand zu "
    "haben. Durch den Gebrauch des Verstandes wurden schon viele Gefahren "
    "abgewandt oder sogar vermieden.",
    "sagt weise: ", 1 );
  AddInfo( ({ "kraft" }),
    "Auch die physische Kraft ist wichtig, denn von Geist und Verstand allein "
    "kann man seine Familie nicht versorgen.",
    "meint: ", 1 );
  AddInfo( ({ "einheit" }),
    "Als Oberhaupt der Xandim verkoerpere ich diese Einheit.",
    "sagt: ", 1 );
  AddInfo( ({ "xandim" }),
    "Wir Xandim sind ein ruhiges und friedfertiges Volk, obwohl es einmal "
    "eine Zeit gab, da dies nicht so war.",
    "denkt laut: ", 1 );
  AddInfo( ({ "zeit" }),
    "Vor drei Generationen gab es einmal eine sehr schlechte Zeit. Aus "
    "unerklaerlichen Gruenden haben sich die Xandim untereinander bekaempft, "
    "was zuvor noch nie der Fall war.",
    "seufzt: ", 1 );
  AddInfo( ({ "generation","generationen" }),
    "Damals war Yrgalla, mein Urgrossvater, an meiner Stelle, nur war seine "
    "Amtszeit kurz, weil er einem grausamen Tod erlag.",
    "erklaert: ", 1 );
  AddInfo( ({ "grund","gruende" }), #'tipp_erfasst );
  AddInfo( ({ "yrgalla" }),
    "Der war vor drei Generationen Stammesoberhaupt der Xandim, dessen Tod "
    "wie auch der vieler anderer bis heute ungeklaert ist.",
    "sagt: ", 1 );
  AddInfo( ({ "tod" }),
    "Angeblich sollen die Xandim ihre eigenen Brueder und Schwester getoetet "
    "haben, aber wir wissen nicht weshalb. Vielleicht willst Du uns helfen, "
    "den Grund zu finden.",
    "blickt Dich an: ", 1 );
  AddInfo( ({ "palast" }),
    "Aufzeichnungen berichten, dass unsere Vorfahren von dort aufgebrochen "
    "sind, um dem Uebel, das den Palast befallen hat, zu entkommen. Sie sind "
    "dabei immer in Richtung Westen gezogen, bis sie zu diesem Platz kamen, "
    "wo heute unsere neue Heimat Yiqanuc ist.",
    "berichtet: ", 1 );
  AddInfo( ({ "yiqanuc" }),
    "Dieses Dorf wurde unsere Heimat und heisst in eure Sprache uebersetzt: "
    "Ein neues Leben.",
    "erzaehlt Dir: ", 1 );
  AddInfo( ({ "uebel" }),
    "Wir Xandim waeren Dir ewig dankbar, wenn Du den Grund dieses Uebels, das "
    "uns widerfahren ist, feststellen koenntest.",
    "hofft: ", 1 );
  AddInfo( ({ "islaor","eismagier" }),
    "Islaor ist unser Eismagier. Er ist der letzte seiner Gilde, denn die "
    "anderen sind auf der Flucht hierher gestorben. Frag ihn am besten "
    "selbst, wenn Du mehr wissen willst. Er lebt im Osten unseres Dorfes in "
    "seinem eigenen Iglu.",
    "sagt: ", 1 );
  AddInfo( ({ "gilde","eismagiergilde" }),
    "Vor langer Zeit hatten die Xandim eine eigene Eismagiergilde. Doch seit "
    "der Flucht aus dem Palast geht das Wissen nur mehr von einem Magier auf "
    "den naechsten. Derzeit ist dieser Magier Islaor, der einen Adepten in "
    "der Ausbildung hat.",
    "schildert Dir: ", 1 );
  AddInfo( ({ "flucht" }),
    "Was genau bei der Flucht passierte, weiss keiner so genau, aber Islaor "
    "koennte noch etwas davon wissen.",
    "spricht zu Dir: ", 1 );
  AddInfo( ({ "adept","adepten" }),
    "Der Adept ist bei Islaor in Ausbildung, um eines Tages der neue "
    "Eismagier zu werden.",
    "antwortet: ", 1 );
// INFOS END

  AddCmd( ({ "stoer","stoere" }), "stoeren" );
  AddCmd( ({ "zeige","zeig" }), "zeigen" );
  AddCmd( ({ "hilf","helf","helfe" }), "helfen" );

}

string tipp_erfasst(string key)
{
  tipp += ({ getuid(TP) });
  return 
    "Yrdaret schaut Dich erwartungsvoll an: Da sie unerklaerlich sind, suchen wir\n"
    "Yrdaret schaut Dich erwartungsvoll an: Abenteurer, die wagemutig genug sind,\n"
    "Yrdaret schaut Dich erwartungsvoll an: den Palast aufzusuchen, den wir einst\n"
    "Yrdaret schaut Dich erwartungsvoll an: bewohnt hatten, um dort nach Dokumenten\n"
    "Yrdaret schaut Dich erwartungsvoll an: zu suchen, die uns weiterhelfen koennen.\n";
}

int helfen(string str)
{
  notify_fail( "Wem willst Du helfen?\n" );

  if ( member(tipp,getuid(TP)) == -1 )
  {
    command_me("sag Hilf Dir mal selbst, dann kannst Du mir vielleicht helfen.\n");
    return -1;
  }
  if ( TP->QueryQuest(EISPALASTQUEST) )
  {
    write(
      "Yrdaret sagt dankbar: Du hast mir schon geholfen, "+TPN+".\n" );
    return -1;
  }
  if ( member( ({ "yrdaret","oberhaupt","stammesoberhaupt" }),str) != -1 )
  {
    if ( QUESTMASTER->PlayerInQuest(TP) )
    {
      write(
        "Yrdaret meint: Du hilfst mir bereits. Konntest Du schon etwas "
        "herausfinden?\n" );
      return -1;
    }
    write(
      "Yrdaret blickt Dich an: Du willst uns bei der Ahnenforschung helfen?\n"
      "\n"
      "Yrdaret spricht: Als erstes Versuch einmal den verlorenen Palast zu\n"
      "Yrdaret spricht: finden. Dort sollten noch einige Dokumente herumliegen.\n"
      "Yrdaret spricht: Am besten waere es, wenn Du mir immer gleich eines\n"
      "Yrdaret spricht: zurueckbringst, sobald Du eines findest, damit wir uns\n"
      "Yrdaret spricht: rasch an die Arbeit machen koennen. Schau auch einmal\n"
      "Yrdaret spricht: bei Islaor vorbei, der wird Dir helfen koennen.\n"
      "Yrdaret spricht: Falls Du weitere Fragen haben solltest, dann wende Dich\n"
      "Yrdaret spricht: an ihn oder an mich.\n" );
    tipp -= ({ getuid(TP) });
    QUESTMASTER -> AddPlayer(TP);
    return 1;
  }
}

int stoeren(string str)
{
  notify_fail( "Wen willst Du hier stoeren?\n" );

  if ( member( ({ "oberhaupt","stammesoberhaupt","yrdaret" }),str) != -1 )
  {
    write(
      "Ganz ungeniert gehst Du zu Yrdaret hin und klopfst ihm auf die Schulter,\n"
      "worauf er meint:\n"
      "\"Wenn Du mich schon stoeren musst, dann rede mit mir, denn ich hoere Dir auch\n"
      "zu, ohne dass Du mir auf die Schulter klopfen musst.\"\n" );
    tell_room( ENV(TP),
      TPN+" wird von Yrdaret zurechtgewiesen.\n", ({ TP }) );
    return 1;
  }
}

int zeigen(string str)
{
  object ob;
  string was, wem;

  if ( !str ) return 0;
  if ( sscanf(str,"%s %s", wem, was) != 2 ) return 0;

  if ( member( ({ "oberhaupt","stammesoberhaupt","yrdaret" }),wem) != -1 )
  {
    if( ob=present(was,TP) )
    {
      if ( ob->id("\nholzstecken") )
      {
        if ( ob->zusammengesteckt() )
          command_me("sag Wie ich sehe, hast Du die Spitze bereits. Dir fehlt "
                     "noch ein Lederband, damit sie im Stecken bleibt. Dann hast "
                     "Du einen ausgezeichneten Walfangspeer.");
        else
          command_me("sag Das ist ein Teil eines Walfangspeers. Dir fehlen noch "
                     "die Spitze und ein Lederband, um diese zu befestigen.");
          return 1;
      }
      else if ( ob->id("\nlederband") )
      {
        command_me("sag Falls Du bereits einen Holzstecken und eine Spitze aus "
                   "Elfenbein hast, dann kannst Du dieses Band um den Stecken "
                   "wickeln, und Du haettest somit einen Walfangspeer.");
        return 1;
      }
      else if ( ob->id("\nelfenbeinstueck") )
      {
        command_me("sag Das ist ein sehr schoenes Stueck aus Elfenbein. Nachdem "
                   "dies das Werk der Xandim ist, sollte es die Spitze eines "
                   "Walfangspeers sein.");
        return 1;
      }
      write(
        "Darueber kann ich Dir nichts erzaehlen.\n" );
      return -1;
    }
    write(
      "Du kannst Yrdaret nicht etwas zeigen, dass Du nicht hast.\n" );
    return -1;
  }
}

//COMMANDS END

void give_notify(object obj)
{
  command_me("sag Damit fange ich nichts an!");
  command_me(sprintf("gib %s an %s", lower_case(obj->name(RAW)), getuid(TP)));
  return ::give_notify(obj);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "umarmt Dich beschuetzend.",
        "umarmt "+TPN+".");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "seufzt.",
        "seufzt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schaut Dich boese an.",
        "schaut "+TPN+" boese an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Lass das doch bitte sein, "+TPN+".",
        "sagt: Lass diesen Unfug, "+TPN+".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "erroetet.",
        "erroetet.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "fragt Dich: Willst Du mit mir vielleicht reden?",
        "fragt "+TPN+": Willst Du mir eine Frage stellen?");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere)
{
  if ( present(ob, ENV(TO)) )
  {
    tell_object( ob, BS(Name(WER, 1)+" "+macher) );
    tell_room( ENV(TO), BS(Name(WER, 1)+" "+andere), ({ ob }) );
  }
}