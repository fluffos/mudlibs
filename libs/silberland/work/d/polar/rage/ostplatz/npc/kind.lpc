//Xandimkind, Rage Feb 00

inherit "std/npc";

#include "../def.h"
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>

#define HUSKYMASTER "/d/polar/rage/ostplatz/master/master"

string genehmigung(string key);

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Xandimkind" );
  SetProp( P_LONG,
    "Das Kind sieht einem Teddybaeren aehnlicher als einem lebenden Wesen. "
    "Seine Eltern achten wohl sehr darauf, dass es sich nicht erkaeltet, denn "
    "es traegt, obwohl es selbst schon ein dunkelbraunes Fell hat, Faeustlinge, "
    "Fellstiefel und einen dicken Fellumhang mit Kapuze." );
//DETAILS
  AddDetail( "faeustlinge",
    "Die hat das Kind an, damit seine Haende nicht frieren muessen." );
  AddDetail( ({ "fellstiefel","stiefel" }),
    "Die Stiefel sind fuer den Schnee ideal geeignet. So bekommt das Kind "
    "keine kalten Fuesse, ausserdem kann es mit ihnen bequem durch den "
    "Schnee gehen." );
  AddDetail( ({ "fellumhang","umhang" }),
    "Durch den Umhang, den das Kind anhat, kannst Du das Kind selbst fast gar "
    "nicht mehr sehen. Muss der aber flauschig warm sein!" );
  AddDetail( "teddybaer",
    "Beinahe hast Du gedacht, dass ein Teddybaer vor Dir steht, aber es ist "
    "doch nur ein Xandimkind." );
//END DETAILS

  SetProp( P_NAME, "Xandimkind" );
  SetProp( P_GENDER, NEUTER );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:20]) );
  AddId( ({ "kind","xandimkind","\nxandimkind", "NOWIMPY", "NOCONTROL" }) );

  create_default_npc(9);
  SetProp( P_HANDS, ({ " mit seinen Haenden", 75, DT_BLUDGEON }) );
  SetProp( P_RACE, "Xandim" );
  AddClass( CL_HUMAN );
  SetProp( P_SIZE, 110 );
  SetProp( P_ALIGN, 250 );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_AGGRESSIVE, 0 );
  SetProp( P_WIMPY, 0 );
  SetProp( P_WAISE_VATER, 0 );
  SetProp( P_WAISE_MUTTER, 0 );

  SUID;
  CLONEME( "/d/polar/obj/armour/fellstiefel" );
  CLONEME( "/d/polar/obj/armour/fellumhang" );
  CLONEME( "/d/polar/obj/armour/faeustlinge" );
  command("trage alles");

  SetProp( P_REJECT, ({ REJECT_GIVE,"Das Kind ist der Meinung, dass Du das "
	 		            "selbst noch brauchen wirst.\n" }) );

  SetProp( P_MSGIN, "spaziert herein" );
  SetProp( P_MSGOUT, "schlendert" );
  SetProp( P_MMSGIN, "kommt vom Holzgeruest hergelaufen" );
  SetProp( P_MMSGOUT, "laeuft zum Holzgeruest" );

  SetProp( P_DIE_MSG, " schreit noch einmal nach seiner Mutter und stirbt.\n" );
  SetProp( P_KILL_NAME, "Ein starkes Xandimkind" );

  SetProp( P_SPELLRATE, 5 );
  AddSpell( 1, 300,
    "Das Xandimkind tritt Dir gegen Dein Schienbein.\n",
    "Das Xandimkind tritt gegen @WESSEN Schienbein.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );

  SetProp(P_LOG_INFO, "/rage/xandimkind");
//INFOS
  SetChats( 2, ({
    BS("Das Kind will den Fellumhang ausziehen, da ruft seine Mutter: Lass "
    "ja den Umhang an, sonst verkuehlst Du Dich!"),
    "Das Kind spielt mit einem Schlittenhund.\n",
    "Das Kind baut an seinem Schneemann weiter.\n",
    "Das Kind ist in eine kleine Schneeballschlacht verwickelt.\n",
    "Eine Mutter ruft ihr Kind zum Essen.\n",
    "Das Kind streichelt einen Schlittenhund am Bauch.\n"
                }) );
  AddLibrary( NPC "ostplatz.lib", 1 );
  AddInfo( DEFAULT_INFO, ({
    "spielt lieber mit dem Hund, als mit Dir zu reden.\n",
    "versteht nicht ganz, was Du meinst.\n",
    "fragt ein anderes Kind danach.\n",
    "laesst sich von Dir nicht stoeren.\n",
    "hoert Dir nicht zu.\n"
                           }) );
  AddInfo( "spass",
    "Ohja, ich und alle anderen Kinder haben sehr viel Spass auf dem Ostplatz. "
    "Ich freu mich ueber jede Stunde, die ich hier verbringen kann.",
    "laechelt Dich an: " );
  AddInfo( ({ "ostplatz","platz" }),
    "Hihi. Auf dem stehst Du doch gerade!",
    "kichert frech: " );
  AddInfo( ({ "schneeball","schneebaelle","schneeballschlacht" }),
    "Wenn Du nicht aufpasst, bist Du gleich mitten in einer "
    "Schneeballschlacht verwickelt, denn wir haben koennen nicht immer auf "
    "andere achten.",
    "grinst Dich an: " );
  AddInfo( "rage",
    "Der kommt manchmal vorbei und bringt mir ein Eis mit. Der ist ganz nett.",
    "sagt: " );
  AddInfo( ({ "schlittenhund","schlittenhunde","hund","hunde","husky",
              "huskies" }),
    "Wir wachsen mit den Hunden von klein an auf, damit sie uns eines Tages "
    "respektieren, wenn wir mit ihnen auf die Jagd gehen.",
    "sagt: ",1 );
  AddInfo( "respekt",
    "Wenn die Hunde keinen Respekt vor Dir haben, dann darfst Du ihnen nicht "
    "zu nahe kommen. Schon manch einer hat seine Hand dabei verloren.",
    "erklaert Dir: ", 1 );
  AddInfo( ({ "jagd","eisbaerenjagd" }),
    "Wenn ich gross bin, dann gehe ich selbst mit einem Schlitten und den "
    "Hunden auf Eisbaerenjagd!",
    "sagt ganz stolz: ", 1 );
  AddInfo( ({ "eisbaer","eisbaeren" }),
    "Ein sehr gefaehrliches Tier. Mit dem sollte man sich freiwillig besser "
    "nicht anlegen.",
    "warnt Dich: ", 1 );
  AddInfo( ({ "schneemann","schneemaenner" }),
    "Hier bauen wir immer unsere Schneemaenner, weil wir genug Platz dazu "
    "haben. Hast Du auch Lust einen zu bauen?",
    "meint: ", 1 );
  AddInfo( "eltern",
    "Die sind immer in der Naehe und passen auf mich auf.",
    "warnt Dich: ", 1 );
  AddInfo( "mutter",
    "Meine Mutter passt immer und ueberall auf mich auf.",
    "sagt bestaerkend: " );
  AddInfo( ({ "moehre","moehren","karotten","karotte" }),
    "Karotten gibt es hier in Yiqanuc keine. Was willst Du denn damit "
    "ueberhaupt anfangen? Achso, brauchst sicher fuer Deinen Schneemann. Ich "
    "kann Dir da auch nicht weiterhelfen.",
    "guckt: ", 1 );
  AddInfo( ({ "kohle","kohlestueck","holzkohle","koehlerei" }),
    "Meine Eltern haben mir erzaehlt, dass es im Huegelland eine Koehlerei "
    "geben soll. Dort kann man bestimmt auch Holzkohle finden.",
    "sagt: ", 1 );
  AddInfo( "huegelland",
    "Das ist sehr weit weg. Vielleicht komme ich eines Tages hin, wenn ich "
    "gross bin.",
    "schaut auf: ", 1 );
  AddInfo( ({ "hut","zylinderhut","zylinder" }),
    "Du suchst einen Zylinderhut? Also in Yiqanuc gibt es sicher keinen.",
    "blickt Dich fragend an: ", 1 );
  AddInfo( ({ "schal","seidenschal" }),
    "Hmm, ein Schal... Ich habe einmal gehoert, dass sich die Feen immer "
    "schoen herrichten, weil sie so eitel sind. Die koennten einen solchen "
    "Schal haben, doch es koennte auch einer hier im Laden sein.",
    "denkt nach: ", 1 );
  AddInfo( "besen",
    "Wir brauchen hier keinen Besen. Wer will im Schnee schon Staub wischen?",
    "schaut Dich erstaunt an: ", 1 );
  AddInfo( ({ "bau","bauen","lust" }),
    #'genehmigung,
    "meint: ", 1 );
  AddInfo( ({ "kind","xandimkind" }),
    "Ich bin ein Xandimkind.",
    "sagt: ",1 );
  AddInfo( ({ "schnee","eis" }),
    "Jaja, Schnee haben wir mehr als genug hier. Ist aber auch gut so, denn "
    "wie sollten wir sonst unsere Schneemaenner bauen koennen?",
    "nickt: ",1 );
  AddInfo( ({ "yiqanuc","heimat" }),
    "Das ist die Heimat der Xandim.",
    "spricht: ", 1 );
  AddInfo( "xandim",
    "Ich bin stolz ein Xandim zu sein, denn wir sind die einzige Rasse, die "
    "im Polargebiet ueberleben kann. Das liegt auch daran, dass wir ein "
    "natuerliches Fell haben, das uns vor der Kaelte sehr gut schuetzt.",
    "sagt stolz: ", 1 );
//INFOS END
}

string genehmigung(string key)
{
  object ob;

  if ( ob = present("\nschneemann", TP) )
  {
    return
      "Bau ruhig Deinen Schneemann, wenn Du willst!\n";
  } 
  call_out( ("KinderFragen"), 10, TP );
  return
    "Du willst tatsaechlich einen Schneemann bauen?\n"
    "Bist Du nicht zu alt dafuer? Ich rede mal mit meinen\n"
    "Freunden, denn die sind Fremden gegenueber misstrauisch\n"
    "und die werden Dich mit Schneebaellen gleich verjagen.\n"
    "Wart mal einen Moment!\n";
}

void KinderFragen(object pl)
{
  object ob;
  
  if ( ENV(pl) == ENV(ME) )
  {
    write(
      "Das Kind kommt nach einem kurzen Gespraech zurueck und meint:\n"
      "'Geht klar, die anderen werden Dich nicht stoeren, bau ruhig Deinen\n"
      "Schneemann und viel Spass dabei.'\n");
    ob = clone_object(OBJ "schneemann");
    ob -> move(TP,M_NOCHECK|M_SILENT);
  }
  return;
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object vater, mutter;

  HUSKYMASTER -> ruf_um_hilfe(enemy);

  if ( QueryProp(P_WAISE_VATER) && QueryProp(P_WAISE_MUTTER) )
  {
    return ::Defend(dam,dam_type,spell, enemy); 
  }
  else
  {
    enemy -> StopHuntFor(TO, 1);
    StopHuntFor(enemy, 1);
    if ( !QueryProp(P_WAISE_VATER) )
    {
      if ( !vater=present("\nxandimvater", ENV(TO)) )
      {
        vater = clone_object(NPC "xandimvater");
        vater -> move( ROOM "ostplatz_b1", M_NOCHECK );
      }
      if ( !vater->IsEnemy(enemy) )
        vater -> Kill(enemy);
    }
    if ( !QueryProp(P_WAISE_MUTTER) )
    {
      if ( !mutter=present("\nxandimmutter", ENV(TO)) )
      {
        mutter = clone_object(NPC "xandimmutter");
        mutter -> move( ROOM "ostplatz_b1", M_NOCHECK );
      }
      if ( !mutter->IsEnemy(enemy) )
        mutter -> Kill(enemy); 
    }
  }
  return 0;
}

int remove(int arg)
{
  HUSKYMASTER -> remove_husky(TO);
  return ::remove(arg);
}

void reset()
{
  ::reset();

  if ( is_clone(TO) )
  {
    SetProp( P_WAISE_VATER, 0 );
    SetProp( P_WAISE_MUTTER, 0 );
  }
}

varargs void die(int poisondeath)
{
  write_file(LOG "kindtod",
         dtime(time())+": "+CAP(getuid(TP))+" toetet das Xandimkind.\n");
  return ::die(poisondeath);
}