int cmd_fangen(string str)
{
  notify_fail( "Wen willst Du fangen?\n" );

  if ( member( ({ "schneemaus","maus" }),str) != -1 )
  {
    if ( gefangen )
    {
      write( BS(
        "Die Schneemaus ist bereits von Dir gefangen worden. Wieviel "
        "willst Du sie noch quaelen?") );
      return -1;
    }
    if ( TP->QueryAttribute(A_DEX) > 15+random(20) )
    {
      if ( ME_TOO_HEAVY == TO -> move(TP,M_NOCHECK|M_SILENT) )
      {
        write(
          "Du erwischst die Maus zwar, aber leider ist sie Dir zu schwer.\n" );
        TO -> move(ENV(TP),M_GET|M_SILENT);
        return -1;
      }
      write(
        "Geschickt faengst Du die Schneemaus mit einer Hand ein.\n" );
      tell_room(ENV(TP),
        TPN+" faengt die Schneemaus.\n", ({ TP }) );
      SetProp( P_LONG,
        "Eine kleine weisse Schneemaus, die noch immer ganz erschrocken ist, "
        "nachdem Du sie eingefangen hast. Sie hat ganz kleine rote Augen, "
        "einen langen Schwanz und ein ganz feines, weisses Fell." );
      AddDetail( ({ "koerper" }),
        "Der ist circa so gross wie Deine Handflaeche. Am ganzen Koerper "
        "zittert sie und will bestimmt am liebsten wieder freigelassen "
        "werden." );
      SetProp( P_NODROP, "Du muesstest die Maus schon freilassen.\n" );
      gefangen = 1;
      return 1;
    }
    write( BS(
      "Mit all Deiner Geschicklichkeit versuchst Du die Schneemaus zu fangen, "
      "doch sie ist schneller als Du und laeuft davon.") );
    tell_room( ENV(TP),
      TPN+" will die Schneemaus fangen, schafft es aber nicht.\n",
      ({ TP }) );
    return -1;
  }
}

int cmd_lassen(string str)
{
  if ( member( ({ "schneemaus frei","maus frei" }),str) != -1 )
  {
    if ( !gefangen )
    {
      write( BS(
        "Die Schneemaus ist gar nicht gefangen. Wie willst Du sie dann "
        "frei lassen?") );
      return -1;
    }
    write( BS(
      "Endlich erloest Du die Maus von ihren Qualen, indem Du sie wieder "
      "frei laesst.") );
    tell_room(ENV(TP),
      TPN+" laesst eine Schneemaus frei.\n", ({ TP }) );
    SetProp( P_LONG,
      "Eine kleine weisse Schneemaus huscht durch die Gegend. Sie hat kleine "
      "rote Augen, einen langen Schwanz und ein ganz weisses Fell." );
    AddDetail( ({ "koerper" }),
      "Der ist circa so gross wie Deine Handflaeche." );
    TO->move(ENV(TP),M_GO|M_SILENT);
    gefangen = 0;
    return 1;
  }
  write( 
    "Willst Du die Schneemaus wieder frei lassen?\n" );
  return -1;
}

void reset()
{
  if ( !is_clone(TO) ) return;
  ::reset();

  if ( resetzaehler > 3 )
  {
     if (environment())
       environment()->Message(
      "Die Schneemaus laeuft aus Deinem Blickfeld.\n" );
    remove();
    return;
  }
  resetzaehler++;
  if ( ME && ENV(ME) && query_once_interactive(ENV(ME)) )
  {
    tell_object(ENV(ME),
      "Die Schneemaus schafft es, Dir zu entkommen.\n" );
    SetProp( P_LONG,
      "Eine kleine weisse Schneemaus huscht durch die Gegend. Sie hat kleine "
      "rote Augen, einen langen Schwanz und ein ganz weisses Fell." );
    AddDetail( ({ "koerper" }),
      "Der ist circa so gross wie Deine Handflaeche." );
    gefangen = 0;
    if (ENV(ENV(ME)))
      move(ENV(ENV(ME)),M_GO|M_SILENT);
  }
}

int frei()
{
  gefangen = 0;
}
