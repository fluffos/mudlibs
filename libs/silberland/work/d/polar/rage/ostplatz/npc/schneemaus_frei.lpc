  write( BS(
    "Wie ein wilder Berserker versuchst Du die Scheemaus in Grund und "
    "Boden zu stampfen, aber sie weicht Dir aus und laeuft davon.") );
  tell_room( ENV(TP),
    TPN+" versucht die Schneemaus zu toeten, doch diese weicht geschickt "
