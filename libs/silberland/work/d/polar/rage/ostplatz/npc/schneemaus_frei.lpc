// Schneemaus am Ostplatz
// Filename: schneemaus_frei.c
// File by Rage, Oktober 02

inherit "std/mnpc";

#include "../def.h"
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

int gefangen;
int resetzaehler;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  gefangen = 0;
  resetzaehler = 0;

  SetProp( P_SHORT, "Eine Schneemaus" );
  SetProp( P_LONG,
    "Eine kleine weisse Schneemaus huscht durch die Gegend. Sie hat kleine "
    "rote Augen, einen langen Schwanz und ein ganz weisses Fell." );
//DETAILS
  AddDetail( ({ "auge","augen" }),
    "Rote Augen, wie es fuer ein Albino ueblich ist. Die Maus sieht Dich "
    "mit ihnen erschrocken an." );
  AddDetail( ({ "schwanz" }),
    "Dieser ist etwa gleich lang wie der Koerper und bewegt sich staendig." );  
  AddDetail( ({ "koerper" }),
    "Der ist circa so gross wie Deine Handflaeche." );
  AddDetail( ({ "fell" }),
    "Das Fell ist ziemlich fein, duenn und klein. Du wunderst Dich, dass die "
    "Maus damit nicht friert." );
//END DETAILS

  SetProp( P_NAME, "Schneemaus" );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_TEMPERATURE_RANGE,([T_RANGE_MIN:-10,T_RANGE_MAX:20]) );
  AddId( ({ "schneemaus","maus","\nLOCKMAUS" }) );

  create_default_npc(3);
  SetProp( P_RACE, "Nagetier" );
  SetProp( P_SIZE, 12 );
  SetProp( P_ALIGN, 20 );
  SetProp( P_MAX_HANDS, 4 );
  SetProp( P_WEIGHT, 300 );
  SetProp( P_NOATTACK, "weicht Dir sehr geschickt aus." );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Schneemaus kann @WEN nicht nehmen.\n" }) );

  SetProp( P_MSGIN, "trippelt herein" );
  SetProp( P_MSGOUT, "trippelt" );
  SetProp( P_MMSGIN, "trippelt aufgeschreckt herein" );
  SetProp( P_MMSGOUT, "laeuft ganz schnell weg" );
  SetProp( P_MNPC_AREA, "/d/polar/rage/ostplatz/room" );
  SetProp( P_MNPC_WAIT, ({ 7, 5, 7 }) );
  SetProp( P_MNPC_DEFAULTROOM, ROOM "ostplatz_d1" );
  SetProp( P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS 
                         + MOV_SPECIAL + MOV_INFIGHT );

  AddInfo( DEFAULT_INFO, " schaut Dich nur mit grossen Augen an.\n" );
  SetChats( 7, ({
    "Die Schneemaus pinkelt Dich an.\n",
    "Die Schneemaus huscht zwischen Deinen Beinen durch.\n",
    "Die Schneemaus quiekt.\n",
    "Die Schneemaus knabbert an Deinem Fuss.\n",
    "Die Schneemaus sucht nach Fressen.\n",
                 }) );

  AddCmd( ({ "fange","fang","erwische","erwisch" }), "cmd_fangen" );
  AddCmd( ({ "lasse","lass" }), "cmd_lassen" );
}
 
