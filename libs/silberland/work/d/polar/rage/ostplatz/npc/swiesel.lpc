//Schneewiesel, Rage Mär01

inherit "std/mnpc";

#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include "../def.h"

string *zielraeume;
int bewegungen;

void create()
{
 
  if ( !is_clone(TO) ) return;
  ::create();
  
  zielraeume = ({ ROOM "huette", ROOM "ostplatz_b2", ROOM "fellladendach",
                  ROOM "schmuckladen_b3" });

  SetProp( P_SHORT, "Ein Schneewiesel" );
  SetProp( P_LONG,
      "Das Schneewiesel");
  SetProp( P_NAME, "Scheewiesel" );
  SetProp( P_GENDER, NEUTER );
  AddId( ({ "wiesel","schneewiesel","\nschneewiesel" }));
  set_living_name( "schneewiesel" );

  create_default_npc(3);
 
  SetProp( P_HANDS, ({ " mit seinen kleinen Krallen", 50, DT_RIP }) );

  SetProp( P_RACE, "Wiesel" );
  SetProp( P_SIZE, 40 );
  SetProp( P_ALIGN, -100+random(201) );
  SetProp( P_MAX_HANDS, 4 );
  SetProp( P_WIMPY, 0 );

  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.25]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20, T_RANGE_MAX:20]) );

  SetProp( P_MSGIN, "wuselt herein" );
  SetProp( P_MSGOUT, "wuselt" );
  SetProp( P_MMSGIN, "wuselt zwischen der Holzpalisade herein" );
  SetProp( P_MMSGOUT, "laeuft ganz schnell weg" );
  SetProp( P_MNPC_AREA, "/d/polar/rage/ostplatz/room" );
  SetProp( P_MNPC_WAIT, ({ 10, 5, 10 }) );
  SetProp( P_MNPC_DEFAULTROOM, ROOM "ostplatz_d1" );
  SetProp( P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS 
                         + MOV_SPECIAL + MOV_INFIGHT );
        
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n" );
  SetProp( P_NOCORPSE, 0 );

  AddInfo( DEFAULT_INFO, "blickt Dich nichteinmal an.\n" );
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Schneewiesel beachtet Dich nicht weiter.\n" }) );
}

int wandern()
{
  bewegungen++;
  return ::wandern();
}

init()
{
  int i;
 
  ::init();

  if ( bewegungen > 4 )
  {
    for ( i=0; i<sizeof(zielraeume); i++ )
    {
      if ( MENV && file_name(MENV) == zielraeume[i] )
      {
      	zielraeume[i] -> wieselkommt();
        call_out("wiesel_weg");
      }
    }
  }
}
void wiesel_weg()
{
  object obj;

  if ( obj=find_player("rage") )
    tell_object( obj, "Wiesel verschwand in "+file_name(environment())+"\n" );
  tell_room( ENV(TO),
    "Das Schneewiesel verkriecht sich ganz ploetzlich.\n" );
  TO -> remove();
}

varargs die(object killer, int poisondeath)
{
  int i;

  for ( i=0; i<sizeof(zielraeume); i++ )
    zielraeume[i] -> wieselweg();
  ::die(killer, poisondeath);
}

