// Schwarzmagier: wird spaeter bei quest eingebaut
// Filename: magier.c
// File by Rage,  November 00

#include "../def.h"

inherit "std/npc";

#include <combat.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  ::create();

  if ( find_call_out("verschwinden") == -1 )
    call_out("verschwinden",40);
  SetProp( P_SHORT, "Ein Magier" );
  SetProp( P_LONG,
    "Dieser Magier scheint Dir doch sehr seltsam zu sein. Das Geschlecht "
    "dieses Wesens kannst Du nicht erkennen, da es nur eine lange, dunkle Robe "
    "traegt. Eine Kapuze haengt weit ins Gesicht hinein, sodass Du dieses "
    "auch nicht sehen kannst. Als Du auf seine Beine blicken willst, faellt Dir "
    "auf, dass das Wesen keine Fuesse hat und irgendwie ueber dem Boden "
    "schwebt." );
  SetProp( P_NAME, "Magier" );
  SetProp( P_NAME_ADJ, "merkwuerdig" );
  AddAdjective( ({ "merkwuerdiger" }) );
  SetProp( P_GENDER, MALE );
  AddId( ({ "magier","\ndunkelmagier" }) );

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit brutalen Faeusten", 150, DT_BLUDGEON}));
  SetProp( P_RACE, "Xandim" );
  SetProp( P_SIZE, 200 );
  SetProp( P_ALIGN, -500 );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_HEAL,0 );
  SetProp( P_AGGRESSIVE,0 );
  SetProp( P_WIMPY, 0 );
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-30, T_RANGE_MAX:20]) );
  SetProp( P_NOMAGIC, 0 );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Magier laesst @WEN achtlos fallen.\n" }) );

  SetProp( P_MSGIN, "taucht, Dir das Mark ins Gebein treibend, auf" );
  SetProp( P_MSGOUT, "schwebt" );
  SetProp( P_MMSGIN, "erscheint in einer Rauchwolke" );
  SetProp( P_MMSGOUT, "verschwindet mit Knall und Schwefelduft" );

  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n" );
  SetProp( P_NOCORPSE, 0 );

  AddInfo( DEFAULT_INFO, " nimmt Dich nicht zur Kenntnis.\n" );
}

int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  write( BS(
    "Als Du versuchst, den Magier anzugreifen, lacht er nur schrill und "
    "verschwindet in einer schwarzen Rauchwolke.") );
  tell_room( ENV(TP),
    BS(TPN+" versucht den Magier anzugreifen, doch dieser lacht nur schrill "
    "und verschwindet in einer schwarzer Rauchwolke."), ({ TP }) );
  enemy -> StopHuntFor(ME,1);
  StopHuntFor(enemy);
  remove();
}

void verschwinden()
{
  say( BS(
    "Ploetzlich wird der Magier von einer schwarzen Rauchwolke umgeben und "
    "als sie sich verzieht, ist von ihm keine Spur mehr zu sehen.") );
  remove();
}
