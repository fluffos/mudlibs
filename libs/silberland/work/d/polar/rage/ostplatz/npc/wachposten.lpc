inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <new_skills.h>
#include <class.h>

#define HUSKYMASTER "/d/polar/rage/ostplatz/master/master"

int ausweichen;
int ausweich_ende;

void create()
{
  ::create();

  SetProp( P_SHORT, "Ein Wachposten" );
  SetProp( P_LONG,
    "Der Wachposten steht hier am Wachturm und haelt Ausschau nach Gefahren. "
    "Er hat ein dunkelbraunes Fell, traegt dicke Fellstiefel, einen "
    "Fellumhang und hat eine gewaltige Axt. Trotz der imposanten Erscheinung "
    "wirkt er sehr freundlich, aber anlegen sollte man sich trotzdem nicht "
    "mit ihm." );
//DETAILS
  AddDetail( "ausschau",
    "Der Posten haelt Ausschau auf moegliche Gefahren, aber frag ihn besser "
    "selbst danach." );
  AddDetail( "fell",
    "Auch der Wachposten traegt ein Fell, nur ist seines dunkler als die "
    "anderen, die Du bisher gesehen hast." );
  AddDetail( ({ "stiefel","fellstiefel" }),
    "Nachdem hier immer wieder frischer Schnee vom Wind hereingeweht wird, "
    "traegt dieser Xandim ausnahmsweise Stiefel." );
  AddDetail( ({ "umhang","fellumhang" }),
    "Der Fellumhang schuetzt den Posten bestimmt vor dem kuehlen Wind." );
  AddDetail( "axt",
    "Der Axt sollte man im Kampf besser nicht zu Nahe kommen." );
  AddDetail( "erscheinung",
    "Der Xandim wirkt schon ziemlich imposant, denn er ist bestimmt ueber 2 Meter "
    "gross und auch stark gebaut." );
//ENDDETAILS

  SetProp( P_NAME, "Wachposten" );
  SetProp( P_GENDER, MALE );
  AddId( ({ "\nwachposten","wachposten","posten","wache","\nxkrieger" }) );

  create_default_npc(23+random(5));
  SetProp( P_HANDS, ({" mit brutalen Faeusten", 210, DT_BLUDGEON}) );
  SetProp( P_RACE, "Xandim" );
  AddClass( CL_HUMAN );
  SetProp( P_SIZE, 240 );
  SetProp( P_ALIGN, 50+random(200) );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_HEAL, 0 );
  SetProp( P_AGGRESSIVE, 0 );
  SetProp( P_WIMPY, 0 );
  SetProp( P_BODY, 120 );
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5, DT_FIRE:-0.5]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15, T_RANGE_MAX:30]) );

  SetProp( P_NOMAGIC, 10 );

  SetProp( P_MSGIN, "kommt an" );
  SetProp( P_MSGOUT, "geht" );
  SetProp( P_MMSGIN, "loest einen anderen Posten ab" );
  SetProp( P_MMSGOUT, "laesst sich von einem anderen Xandim abloesen" );
  SetProp( P_DIE_MSG,  " faellt tot zu Boden.\n" );
  SetProp( P_NOCORPSE, 0 );
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wachposten braucht nichts von Dir.\n" }) );

  SetProp( P_SPELLRATE, 38 );
  AddSpell( 4,350,
    "Der Wachposten erwischt Dich brutal mit seinem Ellbogen an Deinem Kehlkopf.\n",
    "Der Wachposten erwischt @WEN brutal mit seinem Ellbogen an @WESSEN Kehlkopf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell( 4,380,
    "Der Wachposten schlitzt Deinen Oberschenkel auf.\n",
    "Der Wachposten schlitzt @WESSEN Oberschenkel auf.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell( 3,420,
    "Der Wachposten schwingt gekonnt die Axt gegen Deine Brust.\n",
    "Der Wachposten schwingt gekonnt die Axt gegen @WESSEN Brust.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell( 2, 460,
    "Die Axt des Wachposten schlaegt gewaltig gegen Deinen Arm.\n",
    "Die Axt des Wachposten schlaegt gewaltig gegen @WESSEN Arm.\n",
    DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell( 2,1,
    "Der Wachposten versucht Dich vom Wachturm zu stossen.\n",
    "Der Wachposten versucht @WEN vom Wachturm zu stossen.\n",
    DT_BLUDGEON, "spell_stossen" );
  AddSpell( 3,1,
    "",
    "",
    DT_MAGIC, "spell_ausweichen" );
  AddDefaultSpell( 1,1, DS_BLIND,
    "Der Wachposten wirft Dir Schnee in die Augen!\n",
    "Der Wachposten wirft @WEM Schnee in die Augen!\n",
    3 );
    

 SetAttackChats( 5, ({
    "Der Wachposten wirft Schnee nach Dir.\n",
    "Der Wachposten ist ziemlich wuetend auf Dich.\n",
    "Der Wachposten trachtet Dir nach Deinem Leben.\n" }) );

//INFOS
  SetChats( 2, ({
    "Der Wachposten lehnt sich ans Gelaender und blickt nach Osten.\n",
    "Der Wachposten schaut den Kindern beim Spielen zu.\n",
    "Der Wachposten geht von einer Seite zur anderen.\n",
    "Der Wachposten blickt Dich kurz an und haelt weiter Wache.\n"
                }) );
  AddInfo( DEFAULT_INFO, ({
    "kann nichts mit Deiner Frage anfangen.\n",
    "weiss nicht so recht, was Du meinst.\n",
    "versteht Dich nicht ganz.\n",
    "schaut Dich verwundert an.\n",
    "kann Dir leider nicht weiterhelfen.\n"
                           }) );
  AddLibrary( NPC "ostplatz.lib", 2 );
  AddInfo( ({ "wachturm","turm" }),
    "Vom Turm habe ich einen sehr guten Blick ueber das weite Land, das oestlich "
    "von mir liegt. Ausserdem kann ich hin und wieder auch ueber den Ostplatz "
    "schauen, denn ich schau den Kindern so gerne beim Spielen zu.",
    "spricht: " );
  AddInfo( ({ "blick","ausblick" }),
    "Schau Dich doch am besten selbst genauer um, dann wirst Du sehen, was ich "
    "meine.",
    "grinst: " );
  AddInfo( ({ "gefahr","gefahren","ausschau" }),
    "Es gibt nicht oft Gefahren rund um Yiqanuc. Die aergste ist immer noch, "
    "wenn ein Schneesturm aufzieht. Wilde Tiere in Rudeln verirren sich selten "
    "so nahe an das Dorf.",
    "erklaert Dir: " );
  AddInfo( ({ "sturm","schneesturm","stuerme","schneestuerme" }),
    "Vor den Schneestuermen muss man sich in Acht nehmen, denn oft tauchen sie "
    "ueberraschend auf und wenn man dann in der Wildnis unterwegs ist, kann "
    "man sich sehr leicht verirren. Man braucht schon ein geuebtes Auge, um "
    "einen rechtzeitig zu erkennen.",
    "erzaehlt ganz genau: " );
  AddInfo( "auge",
    "ich habe ein geuebtes Auge, weil ich schon lange hier lebe, und die "
    "Witterungsverhaeltnisse gut abschaetzen kann.",
    "nickt: " );
  AddInfo( "witterungsverhaeltnisse",
    "Die koennen sich oft in kurzer Zeit aendern, aber wenn Du hier am "
    "Ostplatz bleibst, brauchst Du Dir keine Sorgen darueber machen.",
    "antwortet: " );
  AddInfo( "fell",
    "Wie alle Xandim habe ich auch ein natuerliches Fell. Meines ist von "
    "Geburt an einfach dunkler als andere und es soll mich angeblich besser "
    "vor Feuer schuetzen.",
    "sagt zu Dir: " );
  AddInfo( ({ "stiefel","fellstiefel" }),
    "Die Stiefel trage ich privat sonst nicht, aber hier oben wird immer "
    "neuer Schnee hereingeweht und da sind Stiefel schon sehr vorteilhaft.",
    "kichert: " );
  AddInfo( ({ "umhang","fellumhang" }),
    "Der Umhang schuetzt mich noch zusaetzlich vom Wind, auch wenn mich mein "
    "Fell schon ziemlich warm haelt.",
    "zeigt den Umhang her: " );
  AddInfo( ({ "kriegsaxt","axt" }),
    "Ich bin mit der Axt gross geworden, denn ich verwende sie auf der Jagd "
    "auch immer.",
    "stellt die Axt ab: " );
  AddInfo( ({ "eisbaer","eisbaeren","jagd" }),
    "Wenn es auf die Jagd nach Eisbaeren geht, bin ich bisher fast immer "
    "dabei gewesen.",
    "sagt stolz: " );
  AddInfo( "wind",
    "Wie Dir selbst schon aufgefallen sein wird, blaest der Wind hier oben "
    "ordentlich durch, aber in Richtung Osten ist das noch viel schlimmer.",
    "antwortet: " );
  AddInfo( "rage",
    "Von Rage habe ich auch ein paar Tricks im Axtkampf gelernt. Willst Du "
    "diese einmal sehen?",
    "schaut Dich fragend an: " );
//END INFOS

  SUID;
  if ( !random(10) ) CLONEME( WEAPON "holzstange" );
  if ( !random(9) ) CLONEME( OBJ "putzlappen" );
  CLONEME( "/d/polar/thor/xandim/weapon/kriegsaxt" );
  command("zuecke axt");
  CLONEME("/p/armour/boots/fellstiefel");
  CLONEME("/p/armour/cloak/fellumhang");
  command("trage alles");
}

varargs void die(int poisondeath)
{
  write_file(LOG "wachpostentod",
         dtime(time())+": "+CAP(getuid(TP))+" toetet Schwarzfell.\n");
  return ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "wachposten_kills",
         sprintf( ctime()+": Schwarzfell hat gerade "+CAP(getuid(player))
                         +" umgebracht - %d EP!\n", lostexp));
  return ;
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  HUSKYMASTER -> ruf_um_hilfe(enemy);

  if ( ausweichen && (time() > ausweich_ende) )
    ausweichen = 0;
  if ( !ausweichen )
    return ::Defend(dam, dam_type, spell, enemy);

  if( !pointerp(dam_type) )
    dam_type = ({dam_type});
  if ( sizeof(filter_array(dam_type,PHYSICAL_DAMAGE_TYPES)) )
  {
    dam /= 3;
    if (dam < 10)
      tell_object(enemy, Name(WER)+" weicht Dir sehr gekonnt aus.\n");
    else if (dam < 20)
      tell_object(enemy, Name(WER)+" weicht Dir gekonnt aus.\n");
    else
      tell_object(enemy, Name(WER)+" weicht Dir ein wenig aus.\n");
  }
  return ::Defend(dam, dam_type, spell, enemy);
}

int remove(int arg)
{
  HUSKYMASTER -> remove_husky(TO);
  return ::remove(arg);
}

void spell_ausweichen(object enemy, int damage, mixed dam_type)
{
  if ( ausweichen ) return;
  ausweichen = 1;
  ausweich_ende = time()+3+random(8);
}

void spell_stossen(object enemy, int damage, mixed dam_type)
{
  if ( interactive(enemy) )
  {	
    switch( random(100) )
    {
      case 0..10:
        tell_object(enemy,
          "Du kannst gerade noch verhindern, dass Du runterstuerzt.\n");
        enemy->do_damage(6+random(12));
        tell_room(environment(TO),
          enemy->name(WER)+" kann gerade noch verhindern runterzustuerzen.\n",
          ({enemy}) );
      break;
      case 11..60:
        tell_object(enemy,
          "Du wirst vom Wachposten vom Wachturm gestossen.\n");
        enemy->do_damage(12+random(24));
        enemy->move( ROOM "ostplatz_d2",M_GO|M_SILENT);
        tell_room(environment(TO),
          enemy->name(WER)+" wird vom Wachposten vom Wachturm gestossen.\n",
          ({enemy}) );
      break;    
      case 61..99:
        tell_object(enemy,
          "Du wirst vom Wachposten vom Wachturm gestossen und landest hart.\n");
        enemy->do_damage(18+random(36));
        enemy->move( ROOM "ostplatz_d2",M_GO|M_SILENT);
        tell_room(environment(TO),
          enemy->name(WER)+" wird brutalst vom Wachposten vom Wachturm gestossen.\n",
          ({enemy}) );
      break;
      default: write("BUG!\n");
    }
  }
}