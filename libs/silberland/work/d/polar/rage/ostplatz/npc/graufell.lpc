// Graufell, Haendler am Weg
// Filename: graufell.c
// File by Rage, April 02

inherit "std/npc";

#include "../def.h"
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>

#define HUSKYMASTER "/d/polar/rage/ostplatz/master/master"

string Stangentausch(string str);
string *geholfenen;    // Graufell hilft diesen Spielern beim Austausch
nosave string *veraergert;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  geholfenen = ({});
  veraergert = ({});

  SetProp( P_SHORT, "Graufell, ein Xandimhaendler" );
  SetProp( P_LONG,
    "Schon auf den ersten Blick erkennst Du, woher Graufell seinen Namen hat. "
    "Sein Fell ist schon fast ueberall grau, was wahrscheinlich auf sein "
    "hoeheres Alter rueckschliessen laesst. Trotzdem wirkt er noch ziemlich "
    "tatkraeftig und schaut Dich auch sehr freundlich an." );
//DETAILS
  AddDetail( "blick",
    "Du starrst Graufell schon foermlich an, erkennt aber gleich, dass sein "
    "Blick sehr freundlich wirkt." );
  AddDetail( "fell",
    "Das Fell von Graufell ist bis auf ein paar Stellen schon ueberall "
    "grau." );
  AddDetail( ({ "stellen","stelle" }),
    "Dort wo das Fell nicht grau ist, ist noch immer braun geblieben." );
  AddDetail( ({ "jahre","alter" }),
    "Du tust Dich ziemlich schwer, sein Alter einzuschaetzen, aber Du meinst, "
    "dass er an die 80 Jahre schon sein muesste. Du kannst ihn natuerlich "
    "auch fragen, falls Du es genauer wissen willst." );
//END DETAILS
  SetProp( P_NAME, "Graufell" );
  SetProp( P_GENDER, MALE );
  SetProp( P_ARTICLE, 0 );
  AddId( ({ "graufell","xandim","haendler","xandimhaendler" }) );
  set_living_name("graufell");

  create_default_npc(15);
  SetProp( P_HANDS, ({ " mit seiner Faust", 125, DT_BLUDGEON }) );
  SetProp( P_RACE, "Xandim" );
  AddClass( CL_HUMAN );
  SetProp( P_SIZE, 200+random(10) );
  SetProp( P_ALIGN, 200+random(100) );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_BODY, 100 );
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5, DT_FIRE:0.2]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10, T_RANGE_MAX: 20]) );
 // SetProp( P_NO_SCORE, 0 );

  SetProp( P_MMSGIN, "kommt, um sich um sein Geschaeft zu kuemmern" );
  SetProp( P_MMSGOUT, "muss sich kurz um andere Angelegenheiten kuemmern" );

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Graufell steckt @WEN dankend ein.\n" }) );

  SetProp( P_DIE_MSG, " faellt krachend auf seinen Laden.\n" );

  SetProp( P_SPELLRATE, 15 );
  AddSpell( 2,222,
    "Graufell tritt Dir in den Bauch.\n",
    "Graufell tritt @WEN in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell( 1,222,
    "Graufell wirft eine Glaskugel auf Dich.\n",
    "Graufell wirft eine Glaskugel auf @WEN.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell( 2,222,
    "Graufell tritt Dir ins Schienbein.\n",
    "Graufell tritt @WEN ins Schienbein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
     
  SetAttackChats( 5, ({
    "Graufell schreit laut nach Hilfe.\n",
    "Graufell bewirft Dich mit seinen Waren.\n",
    "Graufell verflucht Dich, weil Du seine Geschaefte stoerst.\n"
                      }) );
  SetProp(P_LOG_INFO, "/rage/graufell");
//INFOS
  SetChats( 2, ({
    "Graufell unterhaelt sich gerade angeregt mit einer Kundschaft.\n",
    "Graufell fragt Dich: Hast Du schon eine Glaskugel gekauft?\n",
    "Graufell fragt Dich: Kann ich Dir behilflich sein?\n",
    "Graufell meint: Fuehle mal den Schal an, wie weich der ist!\n",
    "Graufell schlichtet ein paar Waren um.\n"
                }) );
  AddInfo( DEFAULT_INFO, ({
    "hoert Dir gerade nicht zu, weil er sich mit einem Kunden unterhaelt.\n",
    "weiss leider nicht, worauf Du hinaus willst.\n",
    "hoert Dir zwar zu, kann Dir aber nicht weiter helfen.\n",
    "schaut Dich verwundert an.\n",
    "ist gerade mit seinen Waren beschaeftigt.\n"
                           }) );
  AddLibrary( NPC "ostplatz.lib", 3 );
  AddInfo( "graufell",
    "Genau diese Person bin ich. Ich habe hier meinen eigenen Stand auf dem "
    "Ostplatz und erweitere regelmaessig das Angebot.",
    "grinst Dich an: " );
  AddInfo( "rage",
    "Rage hat sich immer um uns gekuemmert und schaut auch sehr oft bei mir "
    "vorbei.",
    "nickt Dir zu: " );
  AddInfo( ({ "eisdrachenschuppe","drachenschuppe" }),
    "In seltenen Faellen habe ich sogar eine Schuppe eines "
    "Eisdrachens in meinem Sortiment.",
    "sagt: " );
  AddInfo( "sortiment",
    "Noch ist mein Sortiment klein, aber ich bin gerade dabei, es "
    "ein wenig zu vergroessern.",
    "sagt schlicht: ");
  AddInfo( "haendler",
    "Auf dem Ostplatz gibt es mehrere Haendler, wie zum Beispiel Saphira, "
    "Schwarzfell oder mich.",
    "erklaert: " );
  AddInfo( "spass",
    "Ohja, ich und alle anderen Kinder haben sehr viel Spass auf dem "
    "Ostplatz. Ich freu mich ueber jede Stunde, die ich hier verbringen "
    "kann.",
    "laechelt Dich an: " );
  AddInfo( ({ "kugel","glaskugel","kugeln","glaskugeln" }),
    "Meist habe ich ein paar Glaskugeln mit Landschaftsdarstellungen darin, "
    "aber sie sind immer so schnell weg, weil die Nachfrage so gross ist, "
    "dass ich mit dem Bauen selbst kaum nachkomme.",
    "antwortet Dir: " );
  AddInfo( ({ "landschaftsdarstellung","landschaftsdarstellungen" }),
    "Regelmaessig bin ich mit dem Bauen von Glaskugeln beschaeftigt, in "
    "denen es die unterschiedlichsten Landschaftsdarstellungen gibt. Da "
    "ich dabei sehr genau bin, dauert es laenger, bis ich die Nachfrage "
    "befriedigen kann.",
    "spricht: " );
  AddInfo( ({ "nachfrage","bauen" }),
    "Die Nachfrage nach den Glaskugeln ist derzeit so gross, dass ich "
    "Dir derzeit leider keine anbieten kann.",
    "seufzt: " );
  AddInfo( ({ "schal","strickschal" }),
    "Meine Frau strickt sehr gerne und ihre Schals verkauf ich dann immer "
    "hier. Sie ist immer ein bisschen sauer auf mich, dass ich nie einen "
    "von ihr nehme,",
    "kichert: " );
  AddInfo( ({ "laden","stand","ladentisch" }),
    "Ganz genau! Das ist mein Stand, wo ich meine Waren anbiete. Wenn Du "
    "etwas kaufen willst, sieh Dich ruhig um.",
    "sagt stolz: " );
  AddInfo( ({ "angebot","ware","waren" }),
    "Mein Angebot ist derzeit noch nicht sehr gross, aber es wird "
    "staendig erweitert. Schau Dich einfach um!",
    "praesentiert seine Waren: " );
  AddInfo( "schwarzfell",
    "Schwarzfell ist der Fellhaendler auf dem Ostplatz. Wenn Du zu ihm "
    "willst, brauchst Du nur nach Sueden zu gehen.",
    "antwortet hilfsbereit: " );
  AddInfo( "saphira",
    "Saphira verkauft hauptsaechlich sehr alte Gegenstaende, aber ihr Laden "
    "ist derzeit noch im Umbau.",
    "gibt Dir Auskunft: " );
  AddInfo( ({ "sidra","wirt" }),
    "Sidra ist gleich im Westen von mir. Bei ihm bekommst Du einen "
    "ausgezeichneten Gluehwein, den ich nur empfehlen kann. Du findest "
    "aber auch Staerkung fuer Deinen Magen.",
    "meint: " );
  AddInfo( ({ "staerkung","gluehwein","essen" }),
    "in Richtung Westen.",
    "deutet ");
  AddInfo( "alter",
    "Du fragst Dich, wie alt ich bin? Ich bin 88 Jahre alt, aber das ist noch "
    "kein Alter fuer einen Xandim. Man sieht es mir hauptsaechlich auch nur "
    "an dem Fell an.",
    "antwortet: " );
  AddInfo( "fell",
    "Ab 70 in etwa wird das Fell der Xandim grau und bleibt dann so bis zu "
    "ihrem Lebensende.",
    "erzaehlt: " );
  AddInfo( ({ "lebensende" }),
    "Keiner kann so genau sagen, wann das sein wird.",
    "zwinkert Dir zu: ");
  AddInfo( ({ "kunde","kundin","kundschaft","kunden" }),
    "Du musst wohl eine Kundschaft sein, wenn Du Dich mit mir unterhaeltst.",
    "laechelt: " );
  AddInfo( ({ "wiesel","schneewiesel" }),
    "Ja, irgendwo auf dem Ostplatz muss auch ein Schneewiesel leben, denn "
    "es laeuft oefters hier vorbei.",
    "nickt Dir zu: ");
  AddInfo( ({ "murmel","murmeln" }),
    "Es tut mir leid, aber die, die Du hier sehen kannst, sind schon alle "
    "vorbestellt.",
    "entschuldigt sich: " );
  AddInfo( ({ "leiter","wachturm" }),
    "in Richtung Osten.",
    "deutet " );
  AddInfo( ({ "schuppen","schuppe" }),
    "Die Schuppe, die ich hier habe, stammt von einem Eisdrachen.",
    "sagt Dir: " );
  AddInfo( ({ "wuerstchen" }),
    "Am besten gehst Du zu Sidra und fragst ihn danach.",
    "sagt und deutet nach Osten: " );
  AddInfo( ({ "holzstange","stange","austausch","austauschen","austausch" }),
    #'Stangentausch,
    "antwortet Dir: ", 1 );
//END INFOS

  SUID;
  if ( !random(20) ) CLONEME( WEAPON "holzstange" );
  if ( !random(9) ) CLONEME( OBJ "putzlappen" );
}

string Stangentausch(string str)
{
  tell_room( ENV(TP),
    "Graufell scheint sich mit "+TP->Name(WEM)+" ueber Stangen zu "
    "unterhalten.\n", ({ TP }) );
  if ( "/d/polar/rage/ostplatz/room/ostplatz_c2"
       -> stange_tauschbar() )
    return 
      "Die Stangen an meinem Ladentisch sind alle in einem sehr guten "
      "Zustand, "+TPN+". Du brauchst keine auszutauschen.";
  if ( member(geholfenen, getuid(TP)) != -1 )
    return
      "Frag nicht so lange herum, sondern tausch endlich die Stange aus, "
      "wo Du den Sprung schon gefunden hast. Ich habe auch nicht den "
      "ganzen Tag Zeit, auf Dich zu warten.";
  geholfenen += ({ getuid(TP) });
  call_out( "graufell_hilft", 30, TP );
  return
    "Den Sprung in der Stange habe ich gar nicht gesehen. Falls Du "
    "so nett bist und mir die Stange austauschen koenntest, dann "
    "helfe ich Dir dabei, denn allein ist das sehr umstaendlich.";
}
void graufell_hilft()
{
  geholfenen -= ({ getuid(TP) });
}
QueryGeholfenen(object spieler)
{
  if ( member(geholfenen,getuid(spieler)) != -1 ) return 1;
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  HUSKYMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

int remove(int arg)
{
  HUSKYMASTER -> remove_husky(TO);
  return ::remove(arg);
}

//RESET
void reset()
{
  ::reset();

  geholfenen = ({});
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  switch (gruppe)
  {
    case "aengstlich":
      call_out( "reaction", 0, TP, 
        "troestet Dich kurz.",
        "troestet "+TP->Name(WEN)+" kurz." );
      break;
    case "aergerlich":
      call_out( "reaction", 0, TP,
        "seufzt.",
        "seufzt.");
      break;
    case "albern":
      call_out( "reaction", 0, TP,
        "sagt: Du bist aber heute extrem lustig gelaunt.",
        "sagt: Du bist aber heute extrem lustig gelaunt, "+TPN+"." );
      break;
    case "fies":
      if ( present("\nverbot",TP) )
        call_out( "reaction", 0, TP,
      	  "schnaubt Dich veraergert an und bedient Dich einfach nicht.",
      	  "schnaubt "+TP->name(WEN)+" veraergert an und bedient "+
      	  TP->QueryPronoun(WEN)+" einfach nicht." );
      else if ( member(veraergert,getuid(TP)) != -1 )
      	call_out( "reaction_kaufverbot", 0, TP,
      	  "hat genug von Deinen Frechheiten und bedient Dich nicht mehr.",
      	  "hat genug von "+TP->name(WESSEN)+" Frechheiten und bedient "+
      	  TP->QueryPronoun(WEN)+" nicht mehr." );
      else
      {
        call_out( "reaction", 0, TP,
          "warnt Dich: Noch so eine Frechheit und ich bediene Dich nicht!",
          "warnt "+TPN+": Noch so eine Frechheit und ich bediene Dich nicht!" );
        veraergert += ({ getuid(TP) });
      }
      break;
    case "frech":
      call_out( "reaction", 0, TP,
        "sagt erbost: Bitte verlasse meinen Stand, "+TPN+".",
        "sagt erbost: Bitte verlasse meinen Stand, "+TPN+"." );
      break;
    case "froh":
      call_out( "reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TPN+" an." );
      break;
    case "intim":
      call_out( "reaction", 0, TP,
        "schaut Dich erstaunt an.",
        "schaut ziemlich erstaunt drein." );
      break;
    case "nett":
      call_out( "reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;
    case "neutral":
      call_out( "reaction", 0, TP,
        "fragt Dich: Moechtest Du nicht lieber etwas kaufen?",
        "fragt "+TPN+": Moechtest Du nicht lieber etwas kaufen?" );
      break;
    case "traurig":
      call_out( "reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+"." );
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere)
{
  if ( present(ob, ENV(TO)) )
  {
    tell_object( ob, BS(Name(WER, 1)+" "+macher) );
    tell_room( ENV(TO), BS(Name(WER, 1)+" "+andere), ({ ob }) );
  }
}

void reaction_kaufverbot(object ob, string macher, string andere)
{
  object kaufverbot;

  if ( present(ob, ENV(TO)) )
  {
    tell_object( ob, BS(Name(WER, 1)+" "+macher) );
    tell_room( ENV(TO), BS(Name(WER, 1)+" "+andere), ({ ob }) );
  }
  kaufverbot = clone_object(OBJ "kaufverbot");
  kaufverbot -> move(TP,M_NOCHECK);
  veraergert -= ({ getuid(TP) }); 
}
