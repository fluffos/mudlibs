//Ein Schlittenhund, husky.c
//Rage, Mär 00

#include "../def.h"

inherit "std/mnpc";

#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

#define HUSKYMASTER "/d/polar/rage/ostplatz/master/master"

void create()
{
  object ob;

  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Schlittenhund" );
  SetProp( P_LONG,
    "Ein Schlittenhund, genau wie Du ihn Dir vorgestellt hast. Er hat ein "
    "schoenes, weissgraues Fell und aehnelt von allen Hunden einem Wolf "
    "am meisten, da seine Schneidezaehne auch aehnlich scharf wirken." );
//DETAILS
  AddDetail( "fell",
    "Das Fell vom Schlittenhund strahlt herrlich weiss im Licht der Sonne, "
    "sodass Du fast geblendet davon bist. Es ist nicht nur sehr dicht, "
    "sondern dient vorallem zur Tarnung im Schnee." );
  AddDetail( ({ "schneidezahn","schneidezaehne" }),
    "Anhand der scharfen Schneidezaehne, die Du deutlich sogar von weiter "
    "weg sehen kannst, erkennst Du, dass dieser Hund doch viele "
    "Gemeinsamkeiten mit einem Wolf aufweist." );
  AddDetail( ({ "gemeinsamkeiten","gemeinsamkeit" }),
    "Koenntest Du einen Wolf neben diesen Hund hinstellen, wuerden Dir "
    "bestimmt alle Gemeinsamkeiten auffallen. So erkennst Du zumindest "
    "die scharfen Schneidezaehne und die starken Pranken, von der Statur "
    "her ist der Schlittenhund doch kleiner als ein Wolf." );
  AddDetail( "wolf",
    "Der Schlittenhund wurde von Xandim erzogen, aber wenn solch ein Hund "
    "frei in der Wildnis herumlaeuft, koenntest Du ihn bestimmt fuer einen "
    "Wolf halten." );
//ENDDETAILS
  SetProp( P_NAME, "Schlittenhund" );
  SetProp( P_GENDER, MALE );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20, T_RANGE_MAX:18]) );
  AddId( ({ "schlittenhund","hund","husky","\nhusky" }) );
  set_living_name("husky");

  create_default_npc(17);
  SetProp( P_HANDS, ({ " mit seinen Pranken", 140, DT_RIP }) );
  SetProp( P_RACE, "Wolf" );
  SetProp( P_SIZE, 80+random(30) );
  SetProp( P_ALIGN, 100 );
  SetProp( P_MAX_HANDS, 4 );
  SetProp( P_AGGRESSIVE, 0 );
  SetProp( P_WIMPY, 0);
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD: -0.5]) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schlittenhund beachtet den Gegenstand gar nicht.\n" }) );
 
  SetProp( P_MSGIN, "laeuft herein" );
  SetProp( P_MSGOUT, "laeuft" );
  SetProp( P_MMSGIN, "taucht ueberraschend vor Dir auf" );
  SetProp( P_MMSGOUT, "laeuft ploetzlich davon" );
  SetProp( P_MNPC_AREA, ({ ROOM "ostplatz_a1", ROOM "ostplatz_b1",
                           ROOM "ostplatz_c1", ROOM "ostplatz_d1",
                           ROOM "ostplatz_b2", ROOM "ostplatz_c2",
                           ROOM "ostplatz_d2"
                         }) );
  SetProp( P_MNPC_WAIT, ({ 20, 20, 10 }) );
  SetProp( P_MNPC_DEFAULTROOM, ROOM "ostplatz_c1" );
  SetProp( P_MNPC_FLAGS, MOV_SPECIAL + MOV_BACKWARDS + MOV_OUTDOORS +
                         MOV_MOVES );

  SetProp( P_DIE_MSG, " faellt blutueberstroemt zu Boden.\n" );
  SetProp( P_KILL_NAME, "Ein gereizter Husky" );

  SetProp( P_SPELLRATE, 15 );
  AddSpell( 1, 250,
    "Der Schlittenhund schlaegt seine Krallen in Deinen Oberschenkel.\n",
    "Der Schlittenhund schlaegt seine Krallen in @WESSEN Oberschenkel.\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]) );
  AddSpell( 3, 375,
    "Der Schlittenhund beisst Dir tief in Deine Hand.\n",
    "Der Schlittenhund beisst tief in @WESSEN Hand.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]) );

  SUID;
  CLONEME( ARMOUR "huskyfell" );
  command( "trage alles" );

  AddInfo( DEFAULT_INFO, " beachtet Dich gar nicht.\n" );

  SetChats( 4, ({
    "Der Schlittenhund wuehlt ein wenig im Schnee.\n",
    "Der Schlittenhund wedelt aufgeregt mit seinem Schwanz.\n",
    "Der Schlittenhund legt sich kurz in den Schnee.\n",
    "Der Schlittenhund schnappt nach einem ihm zugeworfenen Schneeball.\n"
                }) );
  SetAttackChats( 5, ({
    "Der Schlittenhund knurrt Dich wild an.\n",
    "Der Schlittenhund heult laut auf, um seine Artgenossen zu rufen.\n"
                      }) );

  HUSKYMASTER -> add_husky();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  HUSKYMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void Attack(object enemy)
{
  int i;
  object ob;
  object *obs;
  string raum;
  string *raum2;
  mapping exits;
  string *ausgaenge;

  if ( sizeof(exits = environment()->QueryProp(P_EXITS)))
  {
    ausgaenge = m_indices(exits);
    for ( i = sizeof(ausgaenge)-1; i>=0; i-- )
    {
      if ( !objectp(enemy) ) return;
      raum2 = explode(exits[ausgaenge[i]], "#" );
      raum = raum2[sizeof(raum2)-1];
      
      if(objectp(ob = find_object(raum)))
      {
      	obs = filter_objects(all_inventory(ob), "id", "\nhusky");
      	if ( sizeof(obs) )
      	{
      	  obs[0]->move(ENV(TP), M_TPORT, 0, 
              "hoert ein Heulen aus der Ferne und laeuft davon",
              "kommt rasch herein gelaufen");	
          if ( enemy ) ::Attack(enemy);
          return;
        }
      }
    }
  }
  if ( enemy ) ::Attack(enemy);
}

int remove(int arg)
{
  HUSKYMASTER -> remove_husky(TO);
  return ::remove(arg);
}

void init()
{
  ::init();

  if ( TP && TP->id("\nhusky") ) AddDefender(TP);
  if ( HUSKYMASTER -> IsHuskyfeind(TP) ) Kill(TP);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if ( killer == TO ) HUSKYMASTER -> Sieg(player);
}
