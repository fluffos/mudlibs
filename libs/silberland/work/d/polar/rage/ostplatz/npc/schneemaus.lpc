// Schneemaus im Rathaus
// Filename: schneemaus.c
// File by Rage, Februar 00

inherit "std/npc";

#include "../def.h"
#include <combat.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Eine Schneemaus" );
  SetProp( P_LONG,
    "Eine kleine weisse Schneemaus, die noch immer ganz erschrocken ist. "
    "Sie hat ganz kleine rote Augen, einen langen Schwanz und ein ganz "
    "feines, weisses Fell." );
//DETAILS
  AddDetail( ({ "auge","augen" }),
    "Rote Augen, wie es fuer ein Albino ueblich ist. Die Maus sieht Dich "
    "mit ihnen erschrocken an." );
  AddDetail( ({ "schwanz" }),
    "Dieser ist etwa gleich lang wie der Koerper und bewegt sich staendig." );  
  AddDetail( ({ "koerper" }),
    "Der ist circa so gross wie Deine Handflaeche." );
  AddDetail( ({ "fell" }),
    "Das Fell ist ziemlich fein, duenn und klein. Du wunderst Dich, dass die "
    "Maus damit nicht friert." );
//END DETAILS

  SetProp( P_NAME, "Schneemaus" );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_TEMPERATURE_RANGE,([T_RANGE_MIN:-10,T_RANGE_MAX:20]) );
  AddId( ({ "schneemaus","maus" }) );

  create_default_npc(2);
  SetProp( P_RACE, "Nagetier" );
  SetProp( P_SIZE, 12 );
  SetProp( P_ALIGN, 20 );
  SetProp( P_MAX_HANDS, 4 );

  SetProp( P_MSGIN, "huepft erschrocken aus dem Fell" );

  SetChats( 7, ({
    "Die Schneemaus pinkelt Dich an.\n",
    "Die Schneemaus huscht zwischen Deinen Beinen durch.\n",
    "Die Schneemaus quiekt.\n",
    "Die Schneemaus knabbert an Deinem Fuss.\n",
    "Die Schneemaus sucht nach Fressen.\n",
    "Die Schneemaus versucht, sich in den Fellen zu verstecken.\n"
                 }) );

  AddCmd( ({ "fange","fang","erwische","erwisch" }), "cmd_fangen" );
}
 
int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  write( BS(
    "Wie ein wilder Berserker versuchst Du die Scheemaus in Grund und "
    "Boden zu stampfen, doch sie entkommt Dir, indem sie sich in den "
    "Fellen verkriecht.") );
  tell_room( ENV(TP),
    BS(TPN+" versucht die Schneemaus zu toeten, doch diese huscht in ein Fell "
    "und versteckt sich."), ({ TP }) );
  enemy -> StopHuntFor(ME,1);
  StopHuntFor(enemy);
  remove();
}

int cmd_fangen(string str)
{
  notify_fail( "Wen willst Du fangen?\n" );

  if ( member( ({ "schneemaus","maus" }),str) != -1 )
  {
    write( BS(
      "Mit all Deiner Geschicklichkeit versuchst Du die Schneemaus zu fangen, "
      "doch sie ist schneller als Du und verkriecht sich in einem Fell.") );
    tell_room( ENV(TP),
      TPN+" will die Schneemaus fangen, schafft es aber nicht.\n",
      ({ TP }) );
    remove();
    return 1;
  }
}