inherit "std/npc";

#include "../def.h"
#include "../felle.h"
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>

#define HUSKYMASTER "/d/polar/rage/ostplatz/master/master"

string BeginnFellsuche(string str);
nosave string *veraergert;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  veraergert = ({});

  SetProp( P_SHORT, "Schwarzfell, der Fellhaendler" );
  SetProp( P_LONG,
    "Vor Dir steht ein staemmiger Xandim, der seinem Namen alle Ehre macht. "
    "Sein Fell ist so schwarz wie die Nacht, darueber traegt er einen leichten, "
    "weiten, schwarzen Fellumhang, aus dem nur sein Kopf mit einem "
    "freundlichen Gesichtsausdruck herausragt. Ausserdem traegt er noch "
    "schwarze Fellstiefel, aber seltsamerweise keine Handschuhe. Er braucht "
    "wohl die blossen Haende, um besser mit seinen Fellen Handel betreiben "
    "zu koennen." );
//DETAILS
  AddDetail( ({ "knie","kniee" }),
    "Die kannst Du nur erahnen, denn sie werden vom Umhang verborgen." );
  AddDetail( ({ "hand","haende" }),
    "Das sind sehr starke Haende, mit denen Schwarzfell sicher schon einmal "
    "einen Baeren erlegt hat. Derzeit hantieren sie vielmehr mit den Fellen "
    "am Ladentisch herum." );
  AddDetail( ({ "fellumhang","umhang" }),
    "Dieser Umhang stammt sicher von einem Schwarzbaeren, denn das sind die "
    "einzigen Baeren, deren Fell aus derart dunklen, langen Haaren besteht. "
    "Er reicht vom Hals bis knapp ueber die Knie und verbirgt somit, was der "
    "Haendler darunter traegt." );
  AddDetail( ({ "fell","schwarzbaerenfell" }),
    "Das Fell vom Haendler ist beinahe schwarz, und das Fell des Umhangs "
    "besteht aus langen, dunklen Haaren, die typisch fuer ein "
    "Schwarzbaerenfell sind." );
  AddDetail( ({ "fellstiefel","stiefel" }),
    "Die Stiefel sind aus dem gleichen Fell wie der Umhang, was Du unschwer "
    "anhand der Farbe erkennen kannst, und halten Schwarzfell sicher immer "
    "gut seine Fuesse trocken." );
  AddDetail( "hals",
    "Ein ganz normaler Hals. Hast Dir echt etwas Besonderes erwartet?" );
  AddDetail( "kopf",
    "Schwarzfell hat tiefblaue Augen, langes, schwarzes Haar, eine leicht "
    "schiefe Nase und ein zernarbtes Gesicht." );
  AddDetail( "nase",
    "Die muss wohl schon einmal gebrochen sein." );
  AddDetail( "gesicht",
    "Mehrere Narben laufen ueber sein Gesicht. Dieser Mann muss schon "
    "einiges erlebt haben." );
  AddDetail( "narben",
    "Sicher mehr als 10, die meisten sind eher klein, nur eine groessere "
    "ist darunter." );
  AddDetail( ({ "groessere narbe" }),
    "Sie ist ca. 7cm lang und laeuft quer ueber seine linke Wange. "
    "Schwarzfell wird Dir sicher etwas darueber erzaehlen koennen." );
  AddDetail( ({ "wange","linke wange" }),
    "Eine groessere Narbe laeuft quer ueber die linke Wange." );
  AddDetail( ({ "haar","zopf" }),
    "Schwarzfells Haar ist schwarz, zu einem Zopf zusammengebunden und reicht "
    "ihm bis ueber die Schultern. Das Haar des Felles hat beinahe die "
    "gleiche Farbe." );
  AddDetail( "farbe",
    "Hier ist natuerlich schwarz gemeint (auch wenn manche meinen, dies sei "
    "keine Farbe)." );
  AddDetail( ({ "schulter","schultern" }),
    "Sie werden zwar vom Fellumhang verdeckt, doch siehst Du auch so, dass "
    "sie ziemlich breit sind." );
  AddSpecialDetail( ({ "augen","auge" }), "detailAugen" );
  AddDetail( ({ "gesichtsausdruck","ausdruck" }),
    "Sein Ausdruck ist offen und freundlich, was darauf schliessen laesst, "
    "dass er sicher gern mit Dir reden und handeln will." );
  AddDetail( "mann",
    "Vor Dir steht ein Mann mit Namen Schwarzfell." );
//END DETAILS
  SetProp( P_NAME, "Schwarzfell" );
  SetProp( P_GENDER, MALE );
  SetProp( P_ARTICLE, 0 );
  AddId( ({ "schwarzfell","haendler","fellhaendler","xandim" }) );
  set_living_name("schwarzfell");

  create_default_npc(20);
  SetProp( P_HANDS, ({ " mit seiner gewaltigen Faust", 180, DT_BLUDGEON }) );
  SetProp( P_RACE, "Xandim" );
  AddClass( CL_HUMAN );
  SetProp( P_SIZE, 200+random(10) );
  SetProp( P_ALIGN, 200+random(100) );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_BODY, 120 );
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5, DT_FIRE:0.2]) );
  
  SetProp( P_MMSGIN, "kommt vom Fellsortieren zurueck" );
  SetProp( P_MMSGOUT, "geht seine Felle sortieren" );

  SetProp( P_DIE_MSG, " stirbt und verflucht Dich noch fuer diese Tat.\n" );
  SetProp( P_KILL_NAME, "Der erzuernte Schwarzfell" );

  SetProp( P_SPELLRATE, 30 );
  AddSpell( 1, 400,
    "Schwarzfell trifft Dich mit einem gewaltigen Hieb genau im Nacken.\n",
    "Schwarzfell trifft @WEN mit einem gewaltigen Hieb genau im Nacken.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );

  SetProp(P_LOG_INFO, "/rage/schwarzfell");
//INFOS
  SetChats( 1, ({
    "Schwarzfell fragt Dich: Willst Du ein Fell kaufen?\n",
    "Der Fellhaendler sortiert seine Felle.\n",
    "Schwarzfell kratzt sich die Nase.\n",
    "Der Haendler murmelt: Mein Fellbestand sinkt auch schon wieder. Ich "
    "brauche\n"
    "Der Haendler murmelt: mal dringend Nachschub.\n",
    "Eine Frau kommt herein, bestellt ein Fuchsfell und geht wieder.\n",
    "Ein Mann streift sich den Schnee am Eingang ab und fragt Schwarzfell:\n"
    "Hast Du das Braunbaerenfell schon?\n"
                }) );
  AddInfo( DEFAULT_INFO, ({
    "beachtet Dich nicht und schlichtet weiterhin seine Felle.\n",
    "scheint Dich nicht gehoert zu haben.\n",
    "schaut Dir nur verwundert in die Augen.\n",
    "sagt: Tut mir leid, darueber weiss ich auch nichts.\n",
    "laechelt Dich an, gibt Dir aber keine Antwort.\n"
                          }) );
  AddLibrary( NPC "ostplatz.lib", 10 );
  AddInfo( ({ "bestellung","bestellungen" }),
    "Meine Stammkunden koennen Bestellungen aufgeben, falls ich etwas "
    "nicht gerade lagernd haben sollte. Willst Du auch eine "
    "Bestellung aufgeben?",
    "meint: " );
  AddInfo( ({ "stammkunde","stammkunden" }),
    "Einige der Xandim sind schon Stammkunden bei mir. Fuer sie besorge "
    "ich sogar ausgefallene Felle aus dem Dschungel. Bis jetzt erledige "
    "ich Bestellungen nur fuer Xandim, denn sonst koennte jeder daher "
    "kommen und ein Fell bestellen wollen. Aber vielleicht erweitere ich "
    "das Angebot fuer "+TP->QueryProp(P_RACE)+" wie Dich.",
    "antwortet Dir: " );
  AddInfo( "nebenkosten",
    "Die Nebenkosten muss ich von meinen Kunden verlangen, denn die "
    "Besorgung von aufgefallenen Fellen ist unweigerlich mit hoeheren "
    "Kosten verbunden. Ausserdem will ich sicher gehen, dass der Kunde "
    "das Fell dann auch kauft und ich mir nicht umsonst soviel Arbeit "
    "gemacht habe.",
    "erklaert Dir: " );
  AddInfo( "rage",
    "Den habe ich schon laenger nicht gesehen. Aber falls Du ihn mal sehen "
    "solltest, dann richte ihm aus, dass er mal wieder vorbei schauen "
    "koennte.",
    "grummelt: " );
  AddInfo( ({ "narbe","groessere narbe","kampf" }),
    "Diese Narbe habe ich bei einem Kampf gegen einen Eisbaeren abbekommen. "
    "Es war ein harter, schwerer Kampf, aber nach zehn Minuten konnte ich "
    "ihn schliesslich mit einer Axt niederstrecken. Das muss jetzt schon "
    "an die 15 Jahre zurueckliegen.",
    "erzaehlt: ", 1 );
  AddInfo( ({ "axt" }),
    "Mit meiner Axt konnte ich den Eisbaeren damals niederstrecken.",
    "nickt: ", 1 );
  AddInfo( ({ "fell","felle","fellen" }),
    "Das ist Dir sicher schon aufgefallen, dass ich ein gutes Sortiment hier "
    "habe. Ich kenne jedes Fell im Silberland. Falls Du Fragen zu einem haben "
    "solltest, dann frag mich ruhig.",
    "sagt stolz: ", 1 );
  AddInfo( "schwarzfell",
    "Richtig, das bin ich. Ich handel mit allen Fellen, die es im Silberland "
    "gibt. So einen wie mich, findest Du sicher kein zweites Mal.",
    "nickt Dir zu: ", 1 );
  AddInfo( "handel",
    "Wie Du Dir sicher schon denken konntest, handel ich mit Fellen.",
    "grinst Dich an: " );
  AddInfo( ({ "fellbestand","nachschub","nachfrage" }),
    "In letzter Zeit sind so viele Felle gekauft worden, dass ich mit der "
    "Nachfrage nicht mehr nachkomme. Falls Du mir helfen willst, dann frag "
    "mich nach der Liste, auf der ich zusammengeschrieben habe, welche Felle "
    "ich dringend benoetige.",
    "blickt Dich an: ", 1 );
  AddInfo( ({ "stange" }),
    "Du kannst gerne Felle bei mir kaufen oder verkaufen, aber mit einer "
    "Stange kann ich nicht dienen.",
    "stellt richtig: ");
  AddInfo( ({ "liste","fellliste" }),
    #'BeginnFellsuche,
    "sagt: ", 1 );
//END INFOS

  SUID;
  if ( !random(20) ) CLONEME( WEAPON "holzstange" );
  if ( !random(9) ) CLONEME( OBJ "putzlappen" );
}
//SPECIAL DETAILS
string detailAugen()
{
  if ( TP->QueryProp(P_GENDER) == FEMALE )
  {
    return BS(
      "Tiefblaue Augen blicken Dich an und Du hast das Gefuehl, das Meer "
      "darin zu sehen. Fuer einen kurzen Moment laesst Du Dich treiben und "
      "weisst gar nicht mehr, wo Du bist, bis Dir klar wird, dass Du noch "
      "immer vor Schwarzfell stehst, der noch immer darauf wartet, was Du "
      "von ihm willst.");
  }
  return BS(
    "Tiefblaue Augen blicken Dir entgegen. Schwarzfell hebt kurz die "
    "Augenbrauen, um anzudeuten, ob Du nicht vielleicht eine Frage haettest.");
}
//END SPECIAL DETAILS

string *FelleAuswahl()
{
  string *alle_felle, *ret;
  int i, fellanzahl, zufall;

  ret = ({});
  alle_felle = ({ "Ein Braunbaerenfell","Ein Wolfsfell",
		  "Ein Igelfell","Ein Pumafell",
		  "Ein Grizzlyfell","Ein Bueffelfell",
		  "Ein Otterfell","Ein kleines Fellchen",
		  "Ein Baerenfell","Ein raeudiges Wolfsfell",
		  "Ein Fuchsfell","Ein Biberfell",
		  "Ein Yetifell","Ein Tigerfell",
		  "Ein Jaguarfell","Ein Huskyfell"
              });
  fellanzahl = random(6)+4;

  for ( i=0; i<=fellanzahl; i++ )
  {
    zufall = random(sizeof(alle_felle));
    ret += ({ alle_felle[zufall] });
    alle_felle -= ({ alle_felle[zufall] });
  }
  return ret;
}

string BeginnFellsuche(string str)
{
  object liste;
  string *felle;

  if ( present("\nfellliste", TP) )
  {
    return 
      "Du hast den Zettel von mir schon bekommen. Falls Du ein Fell "
      "auf dem Zettel hast, dann gib es mir einfach.";
  }
  liste = clone_object(OBJ "fellliste");
  liste -> move(TP, M_NOCHECK);
  liste -> SetFelle(FelleAuswahl());
  return
    "Du willst mir helfen, "+TPN+"? Sehr gut!! Ich habe Dir einen Zettel "
    "gegeben, auf dem ich Dir die Felle aufgeschrieben habe, die ich im "
    "Moment brauche. Du kannst alle auf einmal oder auch einzelne bringen. "
    "Wenn Du mir eines besorgst, dann hake ich es als erledigt ab. "
    "Selbstverstaendlich werde ich Dich fuer Deine Hilfe auch reichlich "
    "belohnen.";
}

void give_notify(object ob)
{
  object liste;
  string ob_short;

  if ( ob->QueryProp(P_FELL_AUS_LADEN) )
  {
    if ( ob->QueryProp(P_VERSTAUBTES_FELL) )
    {
      command_me("sag Das Fell ist ja ziemlich verstaubt. Sei doch so nett "
        "und mach es fuer mich sauber." );
    }
    else
    {
      command_me("sag Zeig mal her! Ah, sehr gut, ich danke Dir fuer das "
        "Ausklopfen. Leg es einfach wieder ins Regal zurueck.");
    }
    command_me(sprintf("gib %s an %s", lower_case(ob->name(RAW)), getuid(TP)));
    return ::give_notify(ob);
  }      
  if ( ob->QueryProp(P_BEI_SCHWARZFELL_GEKAUFT) )
  {
    command_me("sag Dieses Fell wurde bei mir gekauft, damit fange ich nichts "
      "an. Ich brauche eines, das noch nicht weiterverarbeitet wurde.");
    command_me(sprintf("gib %s an %s", lower_case(ob->name(RAW)), getuid(TP)));
    return ::give_notify(ob);
  }
  if ( objectp(liste=present("\nfellliste", TP)) && 
    member(liste->QueryFelle(), ob_short=ob->QueryProp(P_SHORT)) > -1 )
  {
    if ( liste->QueryFelleErledigt(ob_short) )
    {
      command_me("sag Dieses Fell hast Du mir schon gegeben!");
      command_me(sprintf("gib %s an %s", lower_case(ob->name(RAW)),
                 getuid(TP)));
      return ::give_notify(ob);
    }   
    else
    {
      tell_room(MENV, 
        "Schwarzfell sagt: Was hast Du denn da? Das ist ja "+ob->name(WER)+
        ", das hat\n"
        "Schwarzfell sagt: mir noch gefehlt. Das hake ich auf Deinem Zettel "
        "gleich\n"
        "Schwarzfell sagt: einmal ab.\n");
      liste -> SetFelleErledigt(ob_short);
      ob -> remove();

      if ( liste->QueryErledigt() )
      {
        tell_room(MENV, 
          "Schwarzfell meint: Vielen Dank! Endlich ist mein Vorratslager wieder\n"
          "Schwarzfell meint: voll. Den Zettel wirst Du nun auch nicht mehr\n"
          "Schwarzfell meint: brauchen.\n");
        liste -> remove();
        command_me("sag Hier hast Du Deine wohlverdiente Belohnung.");
        clone_object( OBJ "kompass")->move(TP, M_NOCHECK);
      }
    }
  }
  else if ( ob ->id("\nfrettchen") )
  {
    command_me("sag Das Frettchen gehoert bestimmt einem Kind!");
    command_me(sprintf("gib %s an %s", lower_case(ob->name(RAW)), getuid(TP)));
    return ::give_notify(ob);
  }
  else
  {
    command_me("sag Damit fange ich nichts an!");
    command_me(sprintf("gib %s an %s", lower_case(ob->name(RAW)), getuid(TP)));
    return ::give_notify(ob);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  switch (gruppe)
  {
    case "aengstlich":
      call_out( "reaction", 0, TP, 
        "umarmt Dich.",
        "umarmt "+TPN+"." );
      break;
    case "aergerlich":
      call_out( "reaction", 0, TP,
        "seufzt.",
        "seufzt.");
      break;
    case "albern":
      call_out( "reaction", 0, TP,
        "kichert.",
        "kichert." );
      break;
    case "fies":
      if ( member(veraergert,getuid(TP)) != -1 )
      	call_out( "reaction_rauswurf", 0, TP,
      	  "hat genug von Deinen Frechheiten und wirft Dich raus.",
      	  "hat genug von "+TP->name(WESSEN)+" Frechheiten und wirft "+
      	  TP->QueryPronoun(WEN)+" raus." );
      else 
        call_out( "reaction", 0, TP,
          "warnt Dich: Noch so eine Frechheit und ich werfe Dich raus!",
          "warnt "+TPN+": Noch so eine Frechheit und ich werfe Dich raus!" );
        veraergert += ({ getuid(TP) });  
      break;
    case "frech":
      call_out( "reaction", 0, TP,
        "sagt erzuernt: Bitte verlasse meinen Laden, "+TPN+".",
        "sagt erzuernt: Bitte verlasse meinen Laden, "+TPN+"." );
      break;
    case "froh":
      call_out( "reaction", 0, TP,
        "laechelt Dich an.",
        "laechelt "+TPN+" an." );
      break;
    case "intim":
      call_out( "reaction", 0, TP,
        "schaut Dich erstaunt an.",
        "schaut ziemlich erstaunt drein." );
      break;
    case "nett":
      call_out( "reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;
    case "neutral":
      call_out( "reaction", 0, TP,
        "fragt Dich: Moechtest Du nicht lieber etwas kaufen?",
        "fragt "+TPN+": Moechtest Du nicht lieber etwas kaufen?" );
      break;
    case "traurig":
      call_out( "reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+"." );
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere)
{
  if ( present(ob, ENV(TO)) )
  {
    tell_object( ob, BS(Name(WER, 1)+" "+macher) );
    tell_room( ENV(TO), BS(Name(WER, 1)+" "+andere), ({ ob }) );
  }
}

void reaction_rauswurf(object ob, string macher, string andere)
{
  if ( present(ob, ENV(TO)) )
  {
    tell_object( ob, BS(Name(WER, 1)+" "+macher) );
    tell_room( ENV(TO), BS(Name(WER, 1)+" "+andere), ({ ob }) );
  }	
  veraergert -= ({ getuid(TP) }); 
  TP -> move(ROOM "ostplatz_d3",M_GO|M_SILENT);
}

varargs void die(int poisondeath)
{
  write_file(LOG "schwarzfelltod",
         dtime(time())+": "+CAP(getuid(TP))+" toetet Schwarzfell.\n");
  return ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "schwarzfell_kills",
         sprintf( ctime()+": Schwarzfell hat gerade "+CAP(getuid(player))
                         +" umgebracht - %d EP!\n", lostexp));
  return ;
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  HUSKYMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

int remove(int arg)
{
  HUSKYMASTER -> remove_husky(TO);
  return ::remove(arg);
}