// Sidra, Wirt am Weg
// Filename: sidra.c
// File by Rage, Oktober 02

inherit "std/npc";

#include "../def.h"
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <class.h>

#define HUSKYMASTER "/d/polar/rage/ostplatz/master/master"

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Sidra, der Wirt" );
  SetProp( P_LONG,
    "Sidra betreibt hier mitten auf dem Ostplatz ein kleines Wirtshaus. "
    "Er traegt wie alle Xandim ein braunes Fell und seine Augen blicken Dich "
    "gutmuetig an. Meist ist er damit beschaeftigt, auf den Grill aufzupassen, "
    "damit nichts anbrennt, aber er wird Deine Bestellung sicher gern annehmen." );
//DETAILS
  AddDetail( "fell",
    "Das Fell von Sidra ist wie die meisten andere Felle der Xandim braun." );
  AddDetail( ({ "auge","augen" }),
    "Diese blicken Dich sehr gutmuetig an, sodass Du selbst ganz ruhig wirst, "
    "wenn Du ihm laenger in die Augen schaust." );
//END DETAILS
  SetProp( P_NAME, "Sidra" );
  SetProp( P_GENDER, MALE );
  SetProp( P_ARTICLE, 0 );
  AddId( ({ "sidra","wirt","xandim" }) );
  set_living_name("sidra");

  create_default_npc(15+random(3));
  SetProp( P_HANDS, ({ " mit seiner Faust", 160, DT_BLUDGEON }) );
  SetProp( P_RACE, "Xandim" );
  AddClass( CL_HUMAN );
  SetProp( P_SIZE, 200+random(10) );
  SetProp( P_ALIGN, 200+random(100) );
  SetProp( P_BODY, 120 );
  SetProp( P_MAX_HANDS, 2 );
  SetProp( P_RESISTANCE_STRENGTHS, ([DT_COLD:-0.5, DT_FIRE:0.2]) );
  SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10, T_RANGE_MAX: 20]) );

  SetProp( P_MSGIN, "kommt herein" );
  SetProp( P_MSGOUT, "schlendert" );
  SetProp( P_MMSGIN, "kommt mit neuen Vorraeten an" );
  SetProp( P_MMSGOUT, "geht ein paar Zutaten holen" );

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Sidra steckt @WEN sofort ein.\n"}));

  SetProp( P_DIE_MSG, " schreit noch ein letztes Mal laut auf.\n" );

  SetProp( P_SPELLRATE, 20 );
  AddSpell( 2, 350,
    "Sidra schuettet Dir einen heissen Gluehwein ins Gesicht.\n",
    "Sidra schuettet @WEM einen heissen Gluehwein ins Gesicht.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell( 1, 280,
    "Sidra schreit Dir laut ins Ohr.\n",
    "Sidra schreit @WEM laut ins Ohr.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SetProp(P_LOG_INFO, "/rage/sidra");
//INFOS
  SetChats( 2, ({
    "Sidra ruehrt die Fluessigkeit im Tonkrug um.\n",
    "Ein Xandim bestellt einen Rentierhotdog.\n",
    "Sidra fragt: Darf ich etwas zu essen anbieten?\n",
    "Sidra fragt: Darf es etwas zu trinken sein?\n",
    "Sidra fragt: Schon das Walfischripperl probiert?\n",
    "Sidra wendet den Rentierbraten am Grill.\n"
    "Sidra sieht nach, ob die Glut noch ausreichend ist.\n"
                }) );
  AddInfo( DEFAULT_INFO, ({
    "muss sich gerade um die Steaks kuemmern.\n",
    "hoert Dich gerade nicht.\n",
    "kann Dir nicht weiterhelfen.\n",
    "weiss nicht, wovon Du sprichst.\n",
    "meint: Muss ich das kennen?\n",
    "scheint nicht zu wissen, was Du meinst.\n",
    "beachtet Dich nicht und ruehrt einmal im Krug um.\n",
    "versteht Dich einfach nicht.\n",
    "sagt: Vielleicht weiss ja Rage darueber Bescheid.\n"
                          }) );
  AddLibrary( NPC "ostplatz.lib", 5 );
  AddInfo( ({ "krug","tonkrug","fluessigkeit" }),
    "In dem Tonkrug wird der Gluehwein warm gehalten, den ich immer wieder "
    "neu aufstelle.",
    "schaut zum Tonkrug und sagt: " );
  AddInfo( "rage",
    "Rage kommt regelmaessig vorbei, wir plaudern ein wenig und trinken "
    "zusammen einen Gluehwein.",
    "plaudert frei dahin: " );
  AddInfo( ({ "getraenk","getraenke","trinken" }),
    "Ich habe keine grosse Auswahl an Getraenke, um genau zu sein, brodel ich "
    "immer nur einen Gluehwein.",
    "schmunzelt: " );
  AddInfo( ({ "speise","speisen","essen" }),
    "An Speisen kann ich folgendes empfehlen: Rentierhotdog, Rentierbraten, "
    "Karibusteak oder Walfischripperl. Am besten ist, Du probierst einfach "
    "alles durch.",
    "bietet Dir an: " );
  AddInfo( ({ "rezept","gluehwein","wein" }),
    "Das Rezept vom Gluehwein verrate ich Dir nicht, aber ich sage Dir gleich, "
    "dass er suesslich schmeckt und dass Dir recht bald warm wird, wenn Du "
    "ein paar Glaeser davon getrunken hast.",
    "grinst Dich an: " );
  AddInfo( ({ "hotdog","rentierhotdog","hotdogs","rentierhotdogs" }),
    "Wir hier im Norden haben die richtigen Hotdogs, naemlich jene aus "
    "Rentierfleisch, nicht so wie aus der Gegend von Midas mit "
    "Schweinefleisch.",
    "nickt Dir zu: " );
  AddInfo( ({ "rentierbraten","braten" }),
    "Vielen ist ein Rentiergulasch lieber, aber mir ist der gegrillte Braten "
    "am liebsten, weil so der natuerliche Geschmack am besten erhalten bleibt.",
    "schwaermt: " );
  AddInfo( "geschmack",
    "Mir ist eben der natuerliche Geschmack eines gegrillten Bratens lieber.",
    "schmatzt laut: " );
  AddInfo( ({ "gulasch","rentiergulasch" }),
    "Auf meine Grillflaeche kommt ganz sicher kein Rentiergulasch, das wird "
    "ausserdem gekocht und nicht gegrillt.",
    "winkt ab: " );
  AddInfo( ({ "grill","grillflaeche" }),
    "Wirf einfach einen Blick darauf, dann siehst Du, was ich hier alles "
    "grille.",
    "deutet auf die Grillflaeche: " );
  AddInfo( ({ "karibusteak","steak","steaks","karibusteaks" }),
    "Fuer den grossen Hunger ist ein Karibusteak gerade das richtige und "
    "das Fleisch ist noch dazu sehr nahrhaft.",
    "beantwortet Deine Frage: " );
  AddInfo( "hunger",
    "Ich werde schon dafuer sorgen, dass Du bald keinen mehr hast.",
    "kichert: " );
  AddInfo( ({ "walfischripperl","ripperl" }),
    "Also wenn Du das Ripperl auf einmal weg isst, dann muss ich Dir persoenlich "
    "gratulieren, denn das ist gewaltig, aber Du musst es unbedingt probieren, "
    "wenn Du eine Herausforderung brauchst.",
    "sagt: " );
  AddInfo( ({ "rentier","rentiere" }),
    "Wir halten hier selbst auf der Koppel die Rentiere, damit wir immer "
    "genug Fleisch haben, um uns selbst ernaehren zu koennen. In der Wildnis "
    "siehst Du sie auch nur in grossen Herden.",
    "antwortet: " );
  AddInfo( "rentierfleisch",
    "Wenn Du schon einmal Hirschfleisch gegessen hast, dann weisst Du, "
    "wovon ich spreche. Es ist im Gegensatz dazu nur ein bisschen mehr mit "
    "Fett durchzogen.",
    "gibt Dir Auskunft: " );
  AddInfo( ({ "walfisch","walfische","wal","wale" }),
    "Einmal im Jahr gibt es eine Walfischjagd und dabei fangen wir oft einen "
    "Wal. Die meisten sind im Polarmeer zu finden, aber viele schwimmen auch weit "
    "in den Sueden, bis in die Naehe von Derlim.",
    "erzaehlt: " );
  AddInfo( "polarmeer",
    "Das Polarmeer wirst Du auf der Reise hier her bestimmt schon gesehen haben, "
    "denn der ganze Kontinent ist davon umgeben.",
    "antwortet: " );
  AddInfo( ({ "hobbit","hobbits","derlim" }),
    "Fuer unsere Verhaeltnisse liegt die Stadt der Hobbits ziemlich weit im "
    "Sueden.",
    "meint nur: " );
  AddInfo( ({ "walfischfleisch","walfleisch" }),
    "Das Walfischfleisch ist weiss, hat wenig fett, aber das allein wird Dir "
    "nicht viel helfen, aber fuer Dich wuerde es wahrscheinlich aehnlich wie "
    "Huehnchenfleisch schmecken.",
    "erklaert: " );
  AddInfo( ({ "huehnchenfleisch","hirschfleisch","schweinefleisch" }),
    "Sowas kommt bei mir ganz sicher nicht auf den Grill!",
    "sagt empoert: " );
  AddInfo( ({ "karibus","karibu" }),
    "Karibus trifft man nur ganz selten an, eher weiter im Sueden von diesem "
    "Kontinent. Viele Touristen erledigen sie noch immer nur wegen ihres "
    "Geweihs, die Xandim aber nur wegen des Fleischs.",
    "sagt ernst: " );
  AddInfo( ({ "touristen","tourist" }),
    "Die meisten von ihnen sind ja ganz nett, aber ich aergere mich nur ueber "
    "jene, die keinen guten Umgang mit der Natur haben.",
    "blickt ernst drein: " );
  AddInfo( ({ "kontinent","polar","polarregion" }),
    "Mit dem Kontinent meine ich die Polarregion.",
    "antwortet Dir: " );
  AddInfo( "karibufleisch",
    "Das Karibufleisch ist jenem der Rentiere ziemlich aehnlich und wird "
    "auch oft aehnlich wie das Hirschfleisch zubereitet. Es ist zum "
    "Teil ein bisschen zaeher, haelt Dich dafuer allerdings wieder laenger "
    "satt.",
    "sagt: " );
  AddInfo( ({ "gesteinsart","gluehende steine" }),
    "Irgendwo im Gebirge suedlich von Yiqanuc ist diese Gesteinsart "
    "gefunden worden, die fast ewig warm bleiben. Ich weiss allerdings "
    "selbst nicht genau, woher sie ist.",
    "hebt die Schulter: " );
//END INFOS

  SUID;
  if ( !random(20) ) CLONEME( WEAPON "holzstange" );
  if ( !random(9) ) CLONEME( OBJ "putzlappen" );
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  HUSKYMASTER -> ruf_um_hilfe(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

int remove(int arg)
{
  HUSKYMASTER -> remove_husky(TO);
  return ::remove(arg);
}