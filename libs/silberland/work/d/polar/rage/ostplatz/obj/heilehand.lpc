//Feuerverletzung Rage, Jan00

inherit "std/thing";
#include "../def.h"
#include <combat.h>
#define P_TMP_HAND_INJURED "tmp_hand_injured"

object * player;

void create()
{
  ::create();

  SetProp( P_SHORT, 0 );
  SetProp( P_NAME, 0 );
  SetProp( P_NODROP, 1 );
  AddId( ({ "\nheilehand" }) );
}

StartCallOut(object pl)
{
  player = pl;
  call_out( "HeileHand", 3610 );
}

HeileHand()
{ 
  tell_object( player,
    "Endlich ist Deine Verbrennung zurueckgegangen und Du kannst wieder ohne "
    "Probleme kaempfen!\n");
  player -> SetProp(P_TMP_HAND_INJURED,0);
  remove();
}

remove()
{
  while ( remove_call_out("HeileHand") != -1 );
  return::remove();
}