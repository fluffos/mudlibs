// Holzbrett aus Lattenzaun
// Filename: holzbrett.c
// File by Rage, Maerz 00

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <wizlevels.h>

void create()
{
  if ( !is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Ein Holzbrett" );
  SetProp( P_LONG,
    "Das Holzbrett ist aus Fichte. Es ist etwa drei Meter lang und hat auf "
    "einer Seite einige Kratzspuren. An beiden Enden sind jeweils zwei Naegel "
    "geschlagen worden." );

//DETAILS
  AddDetail( ({ "seite" }),
    "Eine Seite des Brettes weist einige Kratzspuren auf." );
  AddDetail( ({ "kratzspuren","spuren" }),
    "Die Spuren koennten von einem Geweih eines Wildes stammen oder von den "
    "Klauen eines Wolfes. So genau kannst Du das nicht sagen." );
  AddDetail( ({ "ende","enden" }),
    "Beide Enden weisen zwei Naegel auf. Das Brett muss wohl wo befestigt "
    "gewesen sein." );
  AddDetail( ({ "naegel","nagel" }),
    "Ganz normale Naegel. Ein klein wenig rostig, aber sonst noch voll intakt." );
//END DETAILS

  SetProp( P_NAME, "Holzbrett" );
  SetProp( P_GENDER, NEUTER );
  AddId( ({ "brett","holzbrett","\nholzbrett" }) );

  SetProp( P_MATERIAL, MAT_WOOD );
  SetProp( P_WEIGHT, 6000 );
  SetProp( P_VALUE, 0 );
  SetProp( P_NOBUY, 1 );

//Naegel herausnehmbar !
  AddCmd( ({ "heb","hebe","stemme","stemm" }), "cmd_heben" );
}

// COMMANDS
int cmd_heben(string str)
{
  object *players, *lachseher, ob;
  int i;

  notify_fail( "Was willst Du hochheben?\n" );

  if ( member( ({ "brett hoch","holzbrett hoch",
		  "brett in die hoehe","holzbrett in die hoehe"
		}), str) != -1 )
  {
    write( BS(
      "Wie ein Gewichtsheber reisst Du mit beiden Haenden das Brett ueber "
      "Deinen Kopf und wartest darauf, dass die Kampfrichter Dir das Zeichen "
      "geben, es wieder auf den Boden fallen zu lassen. In diesem Moment "
      "kommst Dir ziemlich daemlich vor, wie Du so dastehst (denn "
      "Kampfrichter siehst Du auch keine) und so laesst Du das Brett fallen. "
      "Achja: Du meinst, dass das Gewicht des Brettes "+
      (5+random(2000)/1000.0)+" Kilo betragen muesste.") );
    say( BS(
      TPN+" stemmt ein Holzbrett in die Hoehe und steht damit wie ein Kasperl "
      "in der Gegend rum. Du kannst Dir das Lachen nicht mehr verkneifen.") );
    
    lachseher = ({});
    ob = ENV(TP);
    players = filter_array(all_inventory(ob), #'interactive);
    for ( i=0; i<sizeof(players); i++ )
    {
      if ( players[i] != TP )
      {
        if( IS_WIZARD(players[i]) )
        {
          tell_object( players[i],"Als Magier kannst du dir das Lachen "
          "natuerlich verkneifen.\n" );
        }
        else
        {
          if( !players[i]->CannotSee(1) )
          {
            lachseher += ({ TP });
            lachseher += ({ players[i] });
            tell_object( players[i],
              BS("Du versucht das Lachen noch zurueckzuhalten, doch Du beginnst "
              "unweigerlich damit, da "+TPN+" beim Gewichtheben einfach zu "
              "bloed dreinschaut.") );
            tell_object( TP,
              BS(players[i]->Name()+" lacht Dich aus, und Du weisst nicht "
              "weshalb.") );
            tell_room( ENV(TP),
              BS(players[i]->Name()+" waelzt sich am Boden, weil "+TPN+
              " sich so bloed auffuehrt."), lachseher );
            lachseher -= ({ players[i] });
            ME -> move(ENV(TP));
          }
        }
      }
    }
    return 1;
  }
}