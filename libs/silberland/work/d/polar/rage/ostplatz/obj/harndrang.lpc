// Harndrang: kriegt man erst los, wenn man auf Toilette war
// Filename: harndrang.c
// File by Rage, Februar 01

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  AddId( "\nharndrang" );
  SetProp( P_WEIGHT, 0);
  SetProp( P_VALUE, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NODROP, 1 );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_AUTOLOADOBJ, 1 );
  if ( find_call_out("drang") == -1 )
    call_out ( "drang", 5 );
}

//COMMANDS

int drang()
{
  string rasse;

  if ( is_clone(TO) )
  {
    if ( TP->QueryProp(P_GHOST) )
    {
      write( BS(
	"Du bist zwar nun tot, aber dafuer musst Du nicht mehr aufs Klo.") );
      remove();
      return 1;
    }
    switch( random(20) )
    {
      case 0:
        write(
          "Wenn Du nicht bald aufs WC kommst, machst Du Dir in die Hose.\n" );
      break;
      case 1:
        write(
          "Staendig musst Du an das Rauschen eines Baches denken.\n" );
      break;
      case 2:
        write(
          "Du musst ganz dringend! Wo ist denn bloss das naechste Klo?\n" );
      break;
      case 3:
        write(
          "Deine Blase hat wohl ein Leck, denn Du musst schon wieder aufs "
          "WC.\n" );
      break;
      case 4:
        write(
          "Du kneifst Dir die Beine zusammen, um dem Harndrang zu "
          "widerstehen.\n" );
      break;
      case 5:
        write( BS(
          "*argl* Haettest Du bloss nicht soviel getrunken, dann muesstest Du "
          "nicht schon wieder aufs Klo.") );
      break;
      case 6:
        write(
          "*plaetscher*plaetscher*plaetscher* Rinnt da schon wo was?\n" );
      break;
      case 7:
        write(
          "Wo ist denn eine Toilette? Du brauchst ganz dringend eine.\n" );
      break;
      case 8:
        write(
          "Du hoerst einen Wasserhahn tropfen. Oder ist das doch was "
          "anderes?\n" );
      break;
      case 9:
        write( BS(
          "Du beisst Dir auf die Lippen, damit Du nicht dran denkst, dass "
          "Du schon laengst eine Toilette aufsuchen solltest.") );
      break;
       case 10:
        write( BS(
          "Deine Nieren hatten wohl einen kleinen Aussetzer, denn Du hast "
          "das dringende Beduerfnis, auf die Toilette gehen zu muessen.") );
      break;
      case 11:
        write( BS(
          "Du denkst . o O (tropft da nicht irgendwo ein Wasserhahn oder ist "
          "das was anderes?)") );
      break;
      case 12:
        write( BS(
          "Du hast heute wohl zuviel getrunken, denn bald kannst Du den Harndrang "
          "nicht mehr zurueckhalten.") );
      break;
      case 13:
        write(
          "Du hast noch nie so dringend auf die Toilette muessen wie jetzt!\n" );
      break;
      case 14:
        write(
          "Bitte! Ganz rasch ein WC her, denn sonst ist es zu spaet!\n" );
      break;
      case 15:
        write( BS(
          "Entweder Du findest rasch ein Klo oder eine grosse Windel, denn "
          "bald machst Du Dich an.") );
      break;
      case 16:
        switch ( lower_case(TP->QueryProp(P_RACE)) )
        {
          case "oger":
            rasse = "kraeftige, verfressene Oger";
          break;
          case "troll":
            rasse = "starke, dumme Trolle";
          break;
          case "zwerg":
            rasse = "kleine, stinkende Zwerge";
          break;
          case "hobbit":
            rasse = "pelzige, dauernd plappernde Hobbits";
          break;
          case "fee":
            rasse = "kluge, eingebildete Feen";
          break;
          case "dunkelelf":
            rasse = "finstere, machthungrige Dunkelelfen";
          break;
          case "elf":
            rasse = "naturbewusste, gruenzeugkauende Elfen";
          break;
          case "mensch":
            rasse = "durchschnittliche, unscheinbare Menschen";
          break;
          default:
            rasse = "nichtdefinierbare, unbekannte Wesen";
          break;
        }
        write(
          "Du musst mal ganz dringend fuer "+rasse+".\n" );
      break;
      case 17:
        write( BS(
          "Wenn Du nicht bald Wasser ablassen kannst, dann ist es zu spaet "
          "fuer Dich.") );
      break;
      case 18:
        write( BS(
          "Du wirst bald Dein kleines Geschaeft machen muessen, sonst wird "
          "Deine Hose womoeglich noch nass.") );
      break;
      case 19:
        write( BS(
          "Du musst echt bald ein Toepfchen finden, auf das Du Dich setzen "
          "kannst, damit Du Wasser ablassen kannst.") );
      break;
    }
    if ( find_call_out("drang") == -1 )
      call_out( "drang", 5 );
    return 1;
  }
  return 0; 
}

void BecomesNetDead(object spieler)
{ 
  write(
    "Voruebergehend laesst Dein Harndrang nach.\n" );
  remove_call_out("drang");
}

void BecomesNetAlive(object spieler)
{
  write(
    "Du spuerst ganz deutlich, dass Du noch immer aufs WC musst.\n" );
  if ( find_call_out("drang") == -1 )
    call_out( "drang", 5);
}