// Graete, soll als Dietrich noch fuer Quest verwendbar sein
// Filename: graete.c
// File by Rage, Februar 01

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Eine Fischgraete" );
  SetProp( P_LONG,
    "Dies ist eine stinknormale Fischgraete. Sie ist 7cm lang, sehr biegsam und "
    "kaum zu brechen. Als Zahnstocher waere sie gar nicht so ungeeignet.");
    
  SetProp( P_INFO,
    "Fuer irgendetwas ist diese Graete sicher zu gebrauchen.\n" );
  SetProp( P_NAME, "Fischgraete" );
  SetProp( P_GENDER, FEMALE );

  AddId( ({ "graete","fischgraete","\nfischgraete", "QUESTOBJ" }) );
  SetProp( P_MATERIAL, MAT_BONE );
  SetProp( P_WEIGHT, 5 );
  SetProp( P_VALUE, 0 );

  AddCmd( ({ "stocher","stochere","stochre" }), "cmd_stochern" );
}
//COMMANDS
int cmd_stochern(string str)
{
  notify_fail( "Wo willst Du mit der Graete herumstochern?\n" );

  if ( member( ({ "im mund","im mund herum","in mund","in mund herum",
                  "zwischen den zaehnen","zwischen den zaehnen herum",
                  "in den zaehnen","in den zaehnen herum",
                  "im zahn","im zahn herum","in zaehnen"
                }),str) != -1 )
  {
    write( BS(
      "Du stocherst elegant mit der Graete in Deinem Mund herum, bis Du die "
      "letzten Speisereste herausbekommen hast.") );
    say( BS(
      TPN+" stochert mit einer Graete in "+TP->QueryPossPronoun(MALE,WEM,SINGULAR)+
      " Mund herum und haelt sich dabei nicht einmal die Hand davor.") );
    return 1;
  }
}