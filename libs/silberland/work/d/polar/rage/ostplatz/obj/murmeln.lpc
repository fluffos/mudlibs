// Paar Murmeln
// Filename: murmeln.c
// File by Rage, adaptiert von Feyaria: Juli 2003

inherit "std/thing";

#include "../def.h"

string farbe;

void create()
{
  if( !IS_CLONE(TO) ) return ;
  ::create();

  farbe=({ "schwarz","bunt","durchscheinend","blau","gruen" })[(random(5))];
  SetProp( P_SHORT, "Einige kleine "+farbe+"e Murmeln");
  SetProp( P_LONG,
    "Diese "+farbe+"en Murmeln faszinieren Dich. Sie lachen Dich schon "
    "foermlich an, dass Du einmal mit ihnen spielst." );
  SetProp( P_NAME, "Murmeln" );
  SetProp( P_PLURAL, 1 );
  SetProp( P_GENDER, FEMALE );
  AddId( ({"murmeln"}) );

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]) );

  AddCmd( ({"spiel", "spiele"}), "cmd_spielen");
}

int cmd_spielen(string str)
{
  notify_fail( "Womit willst Du spielen?\n");

  if( !str ) return 0;
  if( str=="mit murmeln" || str=="mit murmel" )
  {
    write(BS(
      "Du spielst begeistert mit den Murmeln. Wie wunderschoen diese "+farbe+
      "en kleinen Dinger doch herumrollen und im Sonnenlicht funkeln! " ) );
    say(
      CAP_TPN+" spielt mit kleinen Murmeln. Wie kindisch!\n");
    return 1;
  }
  return 0;
}