// Gucker: beim Betrachten des Himmel geclont und nur von Mitspieler
// wieder entfernbar
// Filename: gucker.c
// File by Rage, April 01

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();
  
  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  AddId( "\ngucker" );
  SetProp( P_WEIGHT, 0 );
  SetProp( P_VALUE, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NODROP, 1 );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_AUTOLOADOBJ, 1 );
}
string extra_look()
{
  if ( !ENV(TO) )
  {
    call_out( "remove", 0 );
    return 0;
  }
  return
    CAP( (ENV(TO)->name(WER))+" steht wie zur Salzsaeule erstarrt mitten im "
    "Schnee.\n" );
}