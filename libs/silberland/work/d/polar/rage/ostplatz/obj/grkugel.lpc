// Grosse Schneekugel fuer Schneemann
// Filename: grkugel.c
// File by Rage, Februar 00

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Eine grosse Schneekugel" );
  SetProp( P_LONG,
    "Eine grosse Kugel, die komplett aus Schnee geformt wurde. Sie hat einen "
    "Durchmesser von einem Meter, und wuerde sich gut als Unterleib eines "
    "Schneemannes eignen." );
  SetProp( P_NAME, "Schneekugel" );
  SetProp( P_NAME_ADJ, "gross" );
  AddAdjective( ({ "grosse" }) );
  SetProp( P_GENDER, FEMALE );
  AddId( ({ "kugel","schneekugel","\ngrkugel" }) );

  SetProp( P_MATERIAL, MAT_ICE );
  SetProp( P_WEIGHT, 30000 );
  SetProp( P_VALUE, 0 );
  SetProp( P_NOGET,"Die Kugel zu nehmen hat keinen Sinn, rolle sie besser "
	           "auf Dein Plaetzchen.\n" );
  
  AddCmd( ({ "roll","rolle" }), "cmd_rollen" );
}

//COMMANDS
int cmd_rollen(string str)
{
  object schneemann;

  if ( member( ({ "grosse schneekugel auf plaetzchen",
		  "grosse kugel auf plaetzchen",
		  "grosse schneekugel auf das plaetzchen",
		  "grosse kugel auf das plaetzchen",
	          "grosse schneekugel zum plaetzchen",
	          "grosse kugel zum plaetzchen"
	        }), str) != -1 )
  {
    if ( schneemann=present("\nschneemann",TP) )
    {
      if ( schneemann->GetState()> 0 )
      {
        write(
	  "Ein Unterleib sollte fuer Deinen Schneemann wohl genuegen.\n" );
        return -1;
      }
      write( BS(
        "Du rollst die grosse Schneekugel auf Dein Plaetzchen, womit Du die "
        "Grundlage fuer Deinen Schneemann geschafft hast.") );
      say(
	TPN+" rollt die Schneekugel wo anders hin.\n" );
      if ( schneemann->GetState() == 0 )
      {
        schneemann -> SetState();
      }
      remove();
      return 1;
    }
  write( BS(
    "Als Du die Schneekugel ins Rollen bringen willst, werfen alle Kinder "
    "Schneebaelle auf Dich und Du verstehst die Welt nicht mehr. Vielleicht "
    "ist es besser, wenn Du die Kugel dort liegen laesst, wo sie ist.") );
  say(
    "Aus keinem sichtbaren Grund wird "+TPN+" von Schneebaellen beschossen.\n" );
  return -1;
  }
  write( "Wohin willst Du die grosse Schneekugel rollen?\n" );
  return -1;
}