// Mahnmal
// Filename: mahnmal.c
// File by Rage, Oktober 00

inherit "std/thing";

#include "../def.h"

#define SCHNEE ({ ROOM "ostplatz_a1", ROOM "ostplatz_b1", \
                  ROOM "ostplatz_c1", ROOM "ostplatz_d1", \
                  ROOM "ostplatz_d3" \
                })

int gelbes_gesicht;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();
  
  gelbes_gesicht = 0;
    
  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  AddId( "\nmal" );
  SetProp( P_WEIGHT, 0 );
  SetProp( P_VALUE, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NODROP, 1 );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_AUTOLOADOBJ, 1 );
  
  AddCmd( ({ "reibe","reibe","entferne","entfern",
             "wische","wisch" }), "cmd_wischen" );
}

//COMMANDS
int cmd_wischen(string str)
{
  if ( !TP ) return 0;
  if ( !str || str == "" ) return 0;
  if ( member( ({ "mal","mal weg" }), str) != -1 )
  {
    if ( gelbes_gesicht )
    {
      write( BS(
        "Du musst Dir jetzt schon die ganze gelbe Farbe aus dem Gesicht "
        "wegwischen!") );
      return -1;
    }
    write(
      "Womit willst Du Dir das Mal wegwischen?\n" );
    return -1;
  }
  if ( gelbes_gesicht)
  {
    if ( member( ({ "farbe aus gesicht","gesicht ab","farbe weg",
                    "farbe aus gesicht weg"
                  }), str) != -1 )
    {
      write(
        "Womit willst Du Dir die Farbe aus dem Gesicht wischen?\n" );
      return -1;
    }
    notify_fail( "Hier kannst Du Dir die Farbe nicht aus dem Gesicht "
                 "wischen.\n" );
    if ( member_array(file_name(ENV(TP)), SCHNEE) == -1 )  return 0;
    if ( member( ({ "farbe mit schnee aus gesicht",
                    "gelbe farbe mit schnee aus gesicht",
                    "gesicht mit schnee ab",
                    "farbe mit schnee weg",
                    "gelbe farbe mit schnee weg",
                    "farbe mit schnee aus gesicht weg",
                    "gelbe farbe mit schnee aus gesicht weg",
                    "mit schnee farbe aus gesicht",
                    "mit schnee gelbe farbe weg",
                    "mit schnee gesicht ab",
                    "mit schnee farbe weg",
                    "mit schnee gelbe farbe weg",
                    "mit schnee farbe aus gesicht weg",
                    "mit schnee gelbe farbe aus gesicht weg"
                 }),str) != -1 )
    {
      write( BS(
        "Du fasst mit beiden Haenden in den Neuschnee, fuellst Deine Haende "
        "damit und reibst Dir ordentlich das Gesicht ein, bis die ganze "
        "Farbe sich im Schnee verteilt hat. Den Schnee wirfst Du anschliessend "
        "weg.\n") );
      say( BS(
        TPN+" reibt sich Schnee ueber "+
        TP->QueryPossPronoun(NEUTER,WEN,SINGULAR)+
        " ganzes Gesicht und atmet danach sehr erleichtert auf.") );
      gelbes_gesicht = 0;
      call_out( "mal_weg", 0 );
      return 1;
    }
    notify_fail( "Willst Du Dir die Farbe aus dem Gesicht wischen?\n" );
    return 0;
  }
  notify_fail( "Hier kannst Du Dir das Mal leider nicht wegwischen.\n" );
  if ( member_array(file_name(ENV(TP)), SCHNEE) == -1 )  return 0;
  if ( member( ({ "mal mit schnee weg","mal weg mit schnee",
                  "mal mit schnee","mit schnee mal"
                }), str) != -1 )
  {
    if ( gelbes_gesicht )
    {
      write( BS(
        "Du musst Dir jetzt schon die ganze gelbe Farbe aus dem Gesicht "
        "wegwischen!") );
      return -1;
    }
    write ( BS(
      "Du greifst tief in den Neuschnee, fuellst Deine Handflaeche damit und "
      "versuchst, das Mal durch laengeres Reiben mit dem Schnee "
      "wegzuwischen.") );
    if ( !random(2) )
    {
      write(
        "Du hast Glueck, und endlich bist Du das Mal wieder los.\n" );
      say(
        TPN+" reibt sich Schnee ueber "+
        TP->QueryPossPronoun(FEMALE,WEN,SINGULAR)+
        " Stirn und blickt erleichtert drein.\n" );
      call_out( "mal_weg", 0 );
      return 1;
    }
    else
    {
      write( BS(
        "Du reibst mit dem Schnee Deine Stirn, doch der Punkt geht einfach "
        "nicht weg. Ganz im Gegenteil. Er wird immer groesser und durch Deine "
        "kreisende Handbewegung ist nun Dein ganzes Gesicht voll.") );
      say( BS(
        TPN+" reibt sich Schnee ueber "+
        TP->QueryPossPronoun(FEMALE,WEN,SINGULAR)+
        " Stirn und schnieft danach ziemlich laut.") );
      gelbes_gesicht = 1;
      return 1;
    }
  }
}
//END COMMANDS

string extra_look()
{
  if ( !ENV(TO) )
  {
    call_out( "mal_weg", 0 );
    return 0;
  }
  if ( gelbes_gesicht )
    return
       CAP( (ENV(TO)->name(WER))+" hat ein total gelbes Gesicht.\n" );
  else
    return 
      CAP( (ENV(TO)->name(WER))+" hat ein grosses, gelbes Mal auf der "
      "Stirn.\n" );
}

void mal_weg()
{
  TO -> remove();
}