// Kleine Schneekugel fuer Schneemann
// Filename: klkugel.c
// File by Rage, Februar 00

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Eine kleine Schneekugel" );
  SetProp( P_LONG,
    "Eine kleine Kugel, die komplett aus Schnee geformt wurde. Sie hat"
    "einen Durchmesser von etwa 30 Zentimeter. Das passt sicher als Kopf "
    "fuer den Schneemann." );
  SetProp( P_NAME, "Schneekugel" );
  SetProp( P_NAME_ADJ, "klein" );
  AddAdjective( ({ "kleine" }) );
  SetProp( P_GENDER, FEMALE );
  AddId( ({ "schneekugel","kugel","\nklkugel" }) );

  SetProp( P_MATERIAL, MAT_ICE );
  SetProp( P_WEIGHT, 7500 );
  SetProp( P_VALUE, 0 );
  SetProp( P_NOGET, "Nehmen fuehrt zu nichts! Hebe die Kugel auf den "
 	            "Oberkoerper Deines Schneemannes.\n" );
}