// Putzlappen: Karaffe muss damit geputzt werden
// Filename: putzlappen.c
// File by Rage, Maerz 01

inherit "std/thing";

#include "../def.h"
#include <moving.h>

int verschmutzt, nass, geschneuzt;
string nom_eschneuzer, dat_eschneuzer, eschneuzer;
string nom_zschneuzer, dat_zschneuzer;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  verschmutzt = 0;
  nass = 0;
  geschneuzt = 0;
  nom_eschneuzer = "";
  dat_eschneuzer = "";
  nom_zschneuzer = "";
  dat_zschneuzer = "";

  SetProp( P_SHORT, "Ein Putzlappen" );

//DETAILS
  AddDetail( ({ "rand","raender" }),
    "Die Raender sind deshalb so ausgefranst, weil irgendein Kleidungsstueck "
    "einmal zerrissen worden ist, um diesen Putzlappen daraus zu formen." );
  AddDetail( ({ "kleidungsstueck","hemd","baumwollhemd" }),
    "Du nimmst an, dass es sich dabei um ein Baumwollhemd gehandelt hat, aber "
    "ganz sicher bist Du Dir dabei auch nicht." );
  AddDetail( ({ "wolle","baumwolle" }),
    "Der Putzlappen besteht zu 100 Prozent aus Baumwolle." );
  AddDetail( "prozent",
    "Jaja, aus 100 Prozent Baumwolle besteht der Putzlappen." );
//END DETAILS

  SetProp( P_NAME, "Putzlappen" );
  SetProp( P_GENDER, MALE );

  AddId( ({ "lappen","putzlappen","\nputzlappen" }) );
  SetProp( P_MATERIAL, MAT_COTTON );
  SetProp( P_WEIGHT, 30 );
  SetProp( P_VALUE, 0);
  SetProp( P_NOBUY, 1);

  AddCmd( ({ "wasch","wasche" }), "cmd_waschen" );
  AddCmd( ({ "mach","mache" }), "cmd_machen" );
  AddCmd( ({ "wring","wringe" }), "cmd_wringen" );
  AddCmd( ({ "putz","putze" }), "cmd_putzen" );
  AddCmd( ({ "schneuz","schneuze" }), "cmd_schneuzen" );
}

string _query_info()
{
  string infotext;
  
  infotext = "Mit dem Putzlappen kannst Du sicher alles moegliche sauber "
             "machen.";
  switch ( geschneuzt )
  {
    case 0:
      infotext += " Ansonsten faellt Dir nichts besonderes an ihm auf.";
    break;
    case 1:
      infotext += " Dir faellt auf, dass der Rotz von "+dat_eschneuzer+
                 " mitten im Lappen klebt.";
    break;
    default:
      if ( nom_eschneuzer != nom_zschneuzer )
        infotext += " Ausserdem faellt Dir auf, dass der Rotz von "+
                    dat_eschneuzer+" und "+dat_zschneuzer+" mitten im Lappen "
                    "klebt. Wie eklig!";
      else
        infotext += " Ausserdem faellt Dir auf, dass sich "+CAP(nom_eschneuzer)+
                    " mindestens zweimal in den Lappen geschneuzt hat. Wie "
                    "eklig.";
    break;
  }
  return BS( infotext );
}

string _query_long()
{
  string text;

  text = "Das ist ein ganz einfacher, quadratischer Lappen aus einem ehemaligen "
         "Kleidungsstueck mit ausgefransten Raendern. Derzeit ist er "; 
  switch ( verschmutzt )
  {
    case 0:
      text += "sehr sauber";
    break;
    case 1:
      text += "ziemlich sauber";
    break;
    case 2:
      text += "leicht verschmutzt";
    break;
    case 3:
      text += "sehr verschmutzt";
    break;
    default:
      text += "so verschmutzt, dass Du ihn nicht mehr verwenden kannst, "
              "ohne ihn vorher sauber zu machen,";
    break;
  }
   text += " und";
   switch ( nass )
   {
     case 0:
      text += " total trocken.";
    break;
    case 1:
      text += " leicht angefeuchtet.";
    break;
    default:
      text += " total nass.";
    break;
  }
  if ( geschneuzt )
    text += " Ausserdem hat sich jemand damit geschneuzt.";
  return BS( text );
}
//COMMANDS
int cmd_waschen(string str)
{
  string plong;

  plong = ENV(TP)->QueryProp(P_INT_LONG);

  notify_fail( "Willst Du den Lappen auswaschen oder nur nass machen?\n" );

  if ( !str || str=="" ) return 0;
  if ( id(str) )
  {
    write(
      "Willst Du den Lappen AUSwaschen?\n" );
    return -1;
  }
  if ( member( ({ "lappen aus","putzlappen aus" }),str) != -1 )
  {
    
    if ( strstr(plong,"Wasser") != -1 || 
         strstr(plong,"See") != -1 ||
         strstr(plong,"Brunnen") != -1 || 
         strstr(plong,"brunnen") != -1 ||
         strstr(plong,"Teich") != -1 ||
         strstr(plong,"Bach") != -1 )
    {
      if ( !verschmutzt )
      {
      	write(
      	  "Du brauchst den Putzlappen nicht auszuwaschen, denn er ist total "
      	  "sauber.\n" );
      	return -1;
      }
      if ( nass == 2 )
      {
        write(
          "Der Putzlappen wurde erst vor kurzem ausgewaschen. Einmal sollte "
          "doch reichen.\n" );
        return -1;
      }
      write( BS(
        "Du waeschst den Putzlappen im Wasser ordentlich aus, womit er nun "
        "wieder sehr sauber ist.") );
      say(
        TPN+" waescht einen Putzlappen im Wasser aus.\n" );
      nass = 2;
      verschmutzt = 0;
      geschneuzt = 0;
      nom_eschneuzer = "";
      dat_eschneuzer = "";
      nom_zschneuzer = "";
      dat_zschneuzer = "";
      return 1;
    }   
    else if ( strstr(plong,"Meer") != -1 )
    {
      write(
        "Du willst den Putzlappen besser nicht in Salzwasser auswaschen.\n" );
      return -1;
    }
    notify_fail( "Du siehst hier nirgends Wasser, um den Lappen auszuwaschen!\n" );
  }
}

int cmd_machen(string str)
{
  string plong;

  plong = ENV(TP)->QueryProp(P_INT_LONG);
  
  notify_fail( "Willst Du den Lappen auswaschen oder nur nass machen?\n" );

  if ( !str || str=="" ) return 0;
  if ( member( ({ "lappen nass","putzlappen nass" }),str) != -1 )
  {
    
    if ( strstr(plong,"Wasser") != -1 || 
         strstr(plong,"See") != -1 ||
         strstr(plong,"Brunnen") != -1 || 
         strstr(plong,"brunnen") != -1 ||
         strstr(plong,"Teich") != -1 ||
         strstr(plong,"Bach") != -1 )
    {
      if ( nass == 2 )
      {
        write( BS(
          "Der Putzlappen wurde erst vor kurzem ausgewaschen. Den auch noch "
          "nass machen zu wollen, hat wohl ueberhaupt keinen Sinn.") );
        return -1;
      }
      else if ( nass == 1 )
      {
        write( BS(
          "Der Putzlappen wurde bereits nass gemacht. Wenn er Dir zu wenig "
          "nass sein sollte, musst Du ihn schon auswaschen.") );
        return -1;
      }
      write( BS(
        "Du machst den Putzlappen ein wenig nass, damit Du ihn jetzt gut "
        "zum Putzen verwenden kannst.") );
      say(
        TPN+" macht einen Putzlappen im Wasser nass.\n" );
      nass = 1;
      return 1;
    }   
    else if ( strstr(plong,"Meer") != -1 )
    {
      write(
        "Du willst den Putzlappen besser nicht mit Salzwasser nass machen.\n" );
      return -1;
    }
    notify_fail( "Du siehst hier nirgends Wasser, um den Lappen nass zu "
                 "machen!\n" );
  }
}

int cmd_wringen(string str)
{
  notify_fail( "Willst Du den Putzlappen auswringen?\n" );

  if ( id(str) )
  {
    notify_fail ( "Du willst den Putzlappen wohl AUSwringen!\n" );
    return 0;
  }
  if ( member( ({ "lappen aus","putzlappen aus" }),str) != -1 )
  {
    if ( nass == 2 )
    {
      write( BS(
        "Du wringst den nassen Putzlappen kraeftig aus, sodass er fast "
        "wieder komplett trocken ist. Nun kannst Du ihn zum Putzen "
        "verwenden.") );
      say(
        TPN+" wringt einen Putzlappen aus.\n" );
      nass--;
      return 1;
    }
    else if ( nass == 1 )
    {
      write( BS(
        "Du wringst den Putzlappen solange aus, bis der schliesslich total "
        "trocken ist.") );
      nass--;
      return 1;
    }
    write(
      "Der Putzlappen ist total trocken. Den brauchst Du nicht mehr "
      "auszuwringen.\n" );
    return -1;
  }
}

int cmd_putzen(string str)
{
  object ob, akkob, nomob;

  notify_fail( "Was wuerdest Du gern putzen?\n" );

  if ( !str || str=="" ) return 0;
  ob = present(str,TP);
  if ( ob )
  {
    akkob = ob->name(WEN);
    nomob = ob->name(WER);
    if ( id(str) )
    {
      write(
        "Du kannst doch nicht den Lappen mit sich selber putzen!\n" );
      return -1;
    }
    if ( verschmutzt > 3 )
    {
      write( BS(
        "Der Lappen ist viel zu verschmutzt, um damit "+akkob+" zu putzen.") );
      return -1;
    }
    if ( ob -> QueryProp(P_WEAPON_TYPE) )
    {
      if ( nass == 2 )
      {
        write( BS(
          "Da der Lappen ganz nass ist, kannst Du einmal "+akkob+" von Dreck "
          "und Blut saeubern.") );
        say(
          TPN+" reinigt "+akkob+" von Dreck und Blut.\n" );
        nass--;
        verschmutzt++;
        return 1;
      }
      write( BS(
        "Der Lappen ist zu trocken, um "+akkob+" damit saeubern zu koennen.") );
      return -1;
    }
    else if ( ob -> QueryProp(P_ARMOUR_TYPE) )
    {
      if ( nass == 2 )
      {
        write( BS(
          "Der Lappen ist viel zu feucht, um "+akkob+" noch damit putzen "
          "zu koennen. Wring ihn besser einmal aus!") );
        return -1;
      }
      else if ( nass == 1 )
      {
        write(
          "Du putzt mit dem Putzlappen "+akkob+".\n" );
        say(
          TPN+" putzt "+akkob+" mit dem Putzlappen.\n" );
        nass--;
        verschmutzt++;
        return 1;
      }
      write( BS(
        "Der Lappen ist viel zu trocken, um "+akkob+" damit putzen zu "
        "koennen.") );
      return -1;
    }
    else if ( ob = present("\nkaraffe", TP) )
    {
      if ( verschmutzt > 3 )
      {
      	write(
      	  "Der Lappen ist zu dreckig, um damit auch noch die Karaffe "
      	  "abzuwischen.\n" );
      	return -1;
      }
      if ( !nass )
      {
        write(
          "Der Lappen ist zu trocken, um das Gefaess damit zu putzen.\n" );
        return -1;
      }
      if ( ob->dreck() == 2 )
      {
        write(
          "Auf dem Gefaess ist noch viel zu viel Dreck, um mit dem Putzen zu "
          "beginnen.\n" );
        return -1;
      }
      else if ( ob->dreck() == 1 )
      {
        write( BS(
          "Du putzt den letzten Dreck von der Karaffe. Nun kannst Du sicher gut "
          "daraus trinken.") );
        say(
          TPN+" putzt einen Karaffe mit einem Putzlappen ab.\n" );
        ob->dreckminimierer();
        ob->SetKaraffenzustand();
        verschmutzt++;
        return 1;
      }
      write( BS(
        "Die Karaffe wurde schon vollstaendig gereinigt. Goenn Dir lieber einen "
        "Schluck daraus.") );
      return -1;
    }
    write( BS(
      nomob+" eignet sich nicht, um mit dem Lappen geputzt zu werden.") );
    return -1;
  }
  else if ( str == "fenster" )
  {
    if ( member(ENV(TP)->QueryProp(P_DETAILS), "fenster") )
    {
      if ( verschmutzt > 3 )
      {
      	write(
      	  "Der Lappen ist viel zu verschmutzt, um damit noch ein Fenster "
      	  "putzen zu koennen.\n" );
      	return -1;
      }
      if ( nass == 2)
      {
        write(
          "Der Lappen ist viel zu feucht zum Fenster putzen. Wring ihn doch "
          "einmal aus!\n" );
        return -1;
      }
      else if ( nass == 1 )
      {
        write(
          "Du gehst zum Fenster hin und machst es mit Deinem Putzlappen "
          "richtig sauber.\n" );
        say(
          TPN+" macht sich daran, das Fenster zu putzen.\n" );
        verschmutzt ++;
        nass --;
        return 1;
      }
      write( BS(
        "Du willst doch nicht mit einem staubtrockenen Putzlappen die Fenster "
        "putzen! Mach ihn doch zuerst einmal nass!") );
      return -1;
    }
    write(
      "Hier gibt es kein Fenster zu putzen!\n" );
    return -1;
  }
  else if ( str == "nase" )
  {
    if ( nass )
    {
      write(
        "Du hast keine Lust, Dir mit einem feuchten Putzlappen die Nase zu "
        "putzen.\n" );
      return -1;
    }
    if ( verschmutzt > 3 )
    {
      write(
        "Der Putzlappen ist viel zu schmutzig, um Dir damit die Nase zu "
        "putzen.\n" );
      return -1;
    }
    if ( geschneuzt )
    {
      if ( CAP(getuid(TP)) == eschneuzer )
      {
        write( BS(
          "Du putzt Dir ein weiteres Mal mit dem Putzlappen die Nase, obwohl "
          "Du Dich schon einmal damit geschneuzt hast.") );
        nom_zschneuzer = nom_eschneuzer;
        dat_zschneuzer = nom_zschneuzer;
      }
      else
      {
        write( BS(
          "Du putzt Dir mit dem Putzlappen die Nase, obwohl sich "+
          nom_eschneuzer+" bereits einmal damit geschneuzt hat. Du Ferkel!") );
        nom_zschneuzer = TP->name(WER);
        dat_zschneuzer = TP->name(WEM);
      }
    }
    else
    {
      write(
        "Du putzt Dir mit dem Putzlappen die Nase.\n" );
      eschneuzer = CAP(getuid(TP));
      nom_eschneuzer = TP->name(WER);
      dat_eschneuzer = TP->name(WEM);
    }
    say(
      TPN+" putzt sich mit dem Putzlappen die Nase.\n" );
    verschmutzt = verschmutzt+2;
    geschneuzt++;
    return 1;
  }
}

int cmd_schneuzen(string str)
{
  if ( member( ({ "in lappen","in putzlappen" }),str) != -1 )
  {
    if ( nass )
    {
      write(
        "Du hast keine Lust, Dich in einen feuchten Putzlappen zu schneuzen.\n" );
      return -1;
    }
    if ( verschmutzt > 3)
    {
      write(
        "Der Putzlappen ist viel zu schmutzig, um Dich damit zu schneuzen.\n" );
      return -1;
    }
    if ( geschneuzt )
    {
      if ( CAP(getuid(TP)) == eschneuzer )
      {
        write( BS(
          "Du schneuzt Dich ein weiteres Mal in den Putzlappen, in den Du Dich "
          "schon einmal geschneuzt hast.") );
        nom_zschneuzer = nom_eschneuzer;
        dat_zschneuzer = nom_zschneuzer;
      }
      else
      {
        write( BS(
          "Du schneuzt Dich in den Putzlappen, obwohl sich "+nom_eschneuzer+
          " bereits einmal damit geschneuzt hat. Du Ferkel!") );
        nom_zschneuzer = TP->name(WER);
        dat_zschneuzer = TP->name(WEM);
      }
    }
    else
    {
      write(
        "Du schneuzt Dich in den Putzlappen.\n" );
      eschneuzer = CAP(getuid(TP));
      nom_eschneuzer = TP->name(WER);
      dat_eschneuzer = TP->name(WEM);
    }
    say(
      TPN+" schneuzt sich mit einem Putzlappen.\n" );
    verschmutzt = verschmutzt+2;
    geschneuzt++;
    return 1;
  }
}