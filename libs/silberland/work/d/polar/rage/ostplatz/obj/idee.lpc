// Idee, nur damit kann man Leiter umwerfen
// Filename: idee.c
// File by Rage, Januar 02

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  if ( find_call_out("ideenzeit") == -1 )
    call_out( "ideenzeit", 120 );  
  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  AddId( "\nidee" );
  SetProp( P_WEIGHT, 0 );
  SetProp( P_VALUE, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NODROP, 1 );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_AUTOLOADOBJ, 1 );
}

void ideenzeit()
{
  if ( is_clone(TO) )
  {
    write(
      "Irgendeine wichtige Idee ist Dir gerade entfallen!\n" );
    remove();
  }
  return;
}