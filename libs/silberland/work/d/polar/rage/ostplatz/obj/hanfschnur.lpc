//Hanfschnur
//Filename: hanfschnur.c
//File by Rage, Juni 00
//rauchen(string str) von Dantes Joint abgeleitet

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

int rauchen, dauer;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  rauchen = 0;

  SetProp( P_SHORT, "Eine Hanfschnur" );
  SetProp( P_LONG,
    "Diese Schnur wurde aus Hanf gedreht. Sie ist etwa 15cm lang und 5 "
    "Millimeter stark." );
  SetProp( P_INFO,
    "Woran erinnert Dich Hanf? Was koennte man damit machen?" );
  SetProp( P_NAME, "Hanfschnur" );
  SetProp( P_GENDER, FEMALE );

  AddId( ({ "hanfschnur","schnur","\nhanfschnur" }) );
  SetProp( P_MATERIAL, MAT_CANNABIS );
  SetProp( P_WEIGHT, 10 );
  SetProp( P_VALUE, 50 );

  AddCmd( ({ "rauch","rauche" }), "cmd_rauchen" );
}

//COMMANDS
int cmd_rauchen(string str)
{
  
  dauer = 5;

  notify_fail( "Du willst doch nicht ernsthaft die Hanfschnur rauchen?\n" );

  if ( member( ({ "schnur","hanfschnur" }),str) != -1 )
  {
    if (rauchen == 1)
    {
      write(
        "Aber Du rauchst doch schon an einer Schnur.\n" );
      return -1;
    }
    write( BS(
      "Da Du immer wieder gern etwas Neues ausprobierst, zuendest Du Dir "
      "die Hanfschnur an. Mal schauen, ob sie auch wirkt.") );
    say( 
	TPN+" beginnt, eine Hanfschnur zu rauchen. Du kommst aus dem "
        "Staunen nicht mehr raus.\n" );
    SetProp( P_NODROP, "Du gibst die angezuendete Schnur sicher nicht her.\n" );
    SetProp( P_NEVERDROP, 1 );
    SetProp( P_NOSELL, 1 );
    rauchen = 1;
    if ( find_call_out("rauch") == -1 )
      call_out( "rauch", 7 );
    return 1;
  }
}

int rauch()
{
  object hunger, durst;

  if ( dauer > 0 )
  {
    write( BS(
      "Du nimmst Dir einen tiefen Zug vom Hanf. Das macht Laune!") );
    switch ( random(4) )
    {
      case 0:
        write( BS(
          "Der Hanf ist besser als Du gedacht hast. Irgendwie fuehlst Du "
          "Dich leichter und glaubst, dass Du fliegen kannst.") );
      break;
      case 1:
        write( BS(
	  "Du schwebst ueber den Wolken. Traumhaft!") );
      break;
      case 2:
        write( BS(
          "Du verspuerst einen enormen Hunger. Du koenntest glatt einen Berg "
          "von Marillenknoedel verdruecken.") );
      break;
      case 3:
        write( BS(
          "Der Durst, den Du verspuerst, wird immer staerker. Du kommst Dir "
          "total ausgetrocknet vor. Ein Fass Bier wuerde Dir jetzt gerade "
          "passen.") );
      break;
    }
    say(
      TPN+" wird von dicken Rauchwolken aus "+TP->QueryPossPronoun(1,2)+
      " Hanf eingehuellt.\n");
    dauer--;
    if ( find_call_out("rauch") == -1 )
      call_out( "rauch", 10 );
    return 1;
  }
  write( BS(
    "Auch das Gute hat mal sein Ende, so wie dieser Hanf. Du fuehlst Dich "
    "einwenig benommen und orientierungslos. Ausserdem hast Du einen "
    "Riesenhunger, ganz zu schweigen vom Durst.") );
  say(
    TPN+" hat den Hanf fertiggeraucht und scheint, sich nicht ganz wohl "
    "zu fuehlen.\n" );
  rauchen = 0;

  if ( 2*TP->QueryProp(P_FOOD) < TP->QueryProp(P_MAX_FOOD) )
  {
    if ( !present("\nhunger", TP) )
      clone_object(OBJ "hunger") -> move(TP, M_NOCHECK);
  }
  if ( 2*TP->QueryProp(P_DRINK) < TP->QueryProp(P_MAX_DRINK) )
  {
    if ( !present("\ndurst", TP) )
      clone_object(OBJ "durst") -> move(TP, M_NOCHECK);
  }
  remove();
  return 1;
}