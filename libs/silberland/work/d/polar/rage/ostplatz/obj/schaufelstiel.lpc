// Stiel: Teil der Schneeschaufel
// Filename: schaufelstiel.c
// File by Rage, September 02

inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Holzstiel" );
  SetProp( P_LONG,
    "Dieser Stiel aus Birkenholz ist etwa so lang, wie Du gross bist, und laesst "
    "sich gut mit Deiner Hand umfassen, aber ansonsten faellt Dir nichts auf, "
    "ausser dass ein Ende schmaeler ist." );
  SetProp( P_NAME, "Holzstiel" );
  SetProp( P_GENDER, MALE );
  
//DETAILS
  AddDetail( ({ "holz","birkenholz" }),
    "Der Holzstiel ist aus robustem Birkenholz und weist kaum Kratzer auf." );
  AddDetail( "kratzer",
    "Ein paar Kratzer hat der Stiel schon abbekommen, weil er bestimmt oft "
    "verwendet wurde, doch wozu?" );
  AddDetail( "hand",
    "Du hast eine Hand und da noch eine zweite, also verloren hast Du "
    "zwischenzeitlich keine. Du atmest erleichtert auf." );
  AddDetail( "ende",
    "Die letzten Zentimeter von einem Ende sind schmaeler als der Rest des "
    "Stiels und weisen ein paar schmale Kerben auf." );
  AddDetail( "zentimeter",
    "Ein paar Zentimeter des Stiels sind an einem Ende schmaeler als der Rest. " );
  AddDetail( "rest",
    "Den dickeren Teil kann man als Rest bezeichnen." );
  AddDetail( "teil",
    "Der Holzstiel hat einen staerkeren und einen schmaeleren." );
  AddDetail( "kerben",
    "Die Kerben deuten darauf hin, dass dieses Ende einmal irgendwo hineingesteckt "
    "wurde." );
//END DETAILS

  AddId( ({ "stiel","holzstiel","\nHOLZSTIEL" }) );
  SetProp( P_MATERIAL, MAT_BIRCH_WOOD );
  SetProp( P_WEIGHT, 200 );
  SetProp( P_VALUE, 40 );
}