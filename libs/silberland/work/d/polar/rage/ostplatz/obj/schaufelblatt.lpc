// Teil der Schneeschaufel
// Filename: schaufelblatt.c
// File by Rage, September 02

inherit "std/thing";

#include "../def.h"
#include <moving.h>

int rostig;

void create()
{
  if (!is_clone(TO) ) return;
  ::create();

  rostig = random(36);

  SetProp( P_SHORT, "Ein Schaufelblatt" );
  SetProp( P_NAME, "Schaufelblatt" );
  SetProp( P_GENDER, NEUTER );
  
//DETAILS
  AddDetail( "teil",
    "Du haeltst einen Teil einer Schneeschaufel in Haenden." );
  AddDetail( ({ "haende","hand" }),
    "In Deinen Haenden haeltest Du derzeit ein Schaufelblatt, das Du Dir "
    "genauer ansiehst." );
  AddDetail( "schneeschaufel",
    "Haettest Du den Stiel zum Blatt, wuerdest Du eine Schneeschaufel "
    "besitzen." );
  AddDetail( "schnee",
    "Keiner auf dem Blatt zu finden, aber vielleicht wo anders." );
  AddDetail( "ansatz",
    "Ein zylindrischer Ansatz eben, in den bestimmt der Stiel hineingesteckt "
    "gehoert, um eine intakte Schneeschaufel zu erhalten." );
  AddDetail( ({ "stiel","stecken","holzstecken" }),
    "Ein Holzstecken, Stiel oder irgendetwas aehnliches wird schon in dem "
    "Ansatz hineinpassen." );
  AddSpecialDetail( "rost", "detailRost" );
 
//END DETAILS

  AddId( ({ "blatt","schaufelblatt","\nSCHAUFELBLATT"}) );
  SetProp( P_MATERIAL, MAT_IRON );
  SetProp( P_WEIGHT, 1300 );
  SetProp( P_VALUE, 200 );
  SetProp( P_ROSTZUSTAND, rostig );

  AddCmd( ({ "steck","stecke" }), "cmd_stecken" );
}

string _query_long()
{
  string text;

  text = "Dieses ";
  switch ( QueryProp(P_ROSTZUSTAND) )
  {
    case 0..4:
      text += "rostfreie ";
    break;
    case 5..13:
      text += "ganz leicht verrostete ";
    break;
    case 14..22:
      text += "zu einem betraechtlichen Teil verrostete ";
    break;
    case 23..31:
      text += "sehr stark vom Rost angegriffene ";
    break;
    default:
      text += "vom Rost uebersaehte ";
    break;
  }
  text += "Schaufelblatt scheint ein Teil einer Schneeschaufel zu sein. "
          "Das Blatt ist recht breit und leicht gewoelbt, um moeglichst viel "
          "Schnee damit wegschippen zu koennen. Auf der einen Seite ist ein "
          "kurzer Ansatz, wo wohl ein Holzstecken oder aehnliches hineingehoert, "
          "um daraus eine funktionstaugliche Schneeschaufel zu erhalten.";
  return BS( text );
}

//SPECIALDETAILS
string detailRost()
{
  string text;

  switch ( QueryProp(P_ROSTZUSTAND) )
  {
    case 0..4:
      text = "Von Rost ist auf dem Blatt keine Spur zu sehen.";
    break;
    case 5..13:
      text = "Die ersten Rostflecken zeichnen sich auf dem Blatt ab.";
    break;
    case 14..22:
      text = "Das Schaufelblatt muss schon oft verwendet worden sein, denn sie "
             "hat mittlerweile schon groessere Rostflecken.";
    break;
    case 23..31:
      text = "Grosse Rostflecken zeichnen sich schon ueberall auf dem "
             "Blatt ab, die dem Eisen immer staerker zusetzen.";
    break;
    default:
      text = "Das Blatt scheint schon aus mehr Rost als Eisen zu bestehen. "
             "Die wird sicher nicht mehr lange halten.";
    break;
  }
  return BS( text );
}
//END SPECIALDETAILS

//COMMANDS
int cmd_stecken(string str)
{
  object stiel, schaufel;

  if ( member( ({ "holzstiel in schaufelblatt","stiel in schaufelblatt",
                  "holzstiel in blatt","stiel in blatt",
                  "holzstiel in schaufelblatt hinein",
                  "stiel in schaufelblatt hinein",
                  "holzstiel in blatt hinein",
                  "stiel in blatt hinein",
                  "stiel in blatt",
                  "schaufelblatt auf holzstiel","blatt auf holzstiel",
                  "schaufelblatt auf stiel","blatt auf stiel"
                }),str) != -1 )
  {
    if ( stiel = present("\nHOLZSTIEL", TP) )
    {
      write(
        "Du nimmst den Holzstiel in die rechte und das Schaufelblatt in die "
        "linke Hand und mit einem kraeftigen Ruck steckst Du die beiden "
        "ineinander und erhaeltst somit eine Schneeschaufel.\n"
        "Du bist mal wieder maechtig stolz auf Deine Leistung.\n" );
      say(
        TPN+" bastelt sich aus Stiel und Blatt eine Schneeschaufel.\n" );
      schaufel = clone_object(WEAPON "schneeschaufel");
      schaufel -> SetProp( P_ROSTZUSTAND, QueryProp(P_ROSTZUSTAND) );
      schaufel -> move(TP,M_NOCHECK|M_SILENT);
      stiel -> remove();
      remove();
      return 1;
    }
    if ( present("holzstock",TP) )
    {
      write( BS(
        "Du versuchst den Holzstock in das Schaufelblatt zu stecken, doch er "
        "passt nicht hinein. Du wirst doch einen eigenen Stiel dafuer "
        "brauchen.") );
      say(
        TPN+" versucht einen Holzstock in ein Schaufelblatt zu stecken, doch "
        +TP->QueryPronoun(WER)+" hat kein Glueck damit.\n" );
      return -1;
    }
    write(
      "Du hast nicht den geeigneten Teil dabei, der in den Ansatz von dem "
      "Schaufelblatt passen wuerde.\n" );
    return -1;
  }                
}