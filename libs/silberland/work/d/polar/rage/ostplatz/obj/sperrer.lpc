// Sperrer, damit man Raum(ostplatz_c1) nicht von Zaun aus verlassen kann
// Filename: sperrer.c
// File by Rage, Februar 00

inherit "std/thing";

#include "../def.h"
#include <moving.h>

void create()
{
  if ( !is_clone(TO) )  return;
  ::create();

  if ( find_call_out("rentier1") == -1 )
    call_out( "rentier1", 8 );
  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  SetProp( P_NAME, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NEVERDROP, 1 );
  AddId( "\nsperrer" );

  AddCmd( "", "true", 1 );
}

int true()
{
   write( "Du beobachtest noch das Treiben der Rentiere!\n" );
   return 1;
}

void rentier1()
{
  if ( is_clone(TO) )
  {
    tell_object( TP, "\n\n\n" );
    tell_object( TP, BS(
      "Als Du Dir nun die Rentiere genauer ansiehst, bemerkst Du, dass sie "
      "sich nicht allzu sehr von den Rehen unterscheiden. Sie sind einwenig "
      "groesser und ihr Fell ist ein bisschen heller als jenes der Rehe.") );
    if ( find_call_out("rentier2") == -1 )
      call_out( "rentier2", 8 );
  } 
}

void rentier2()
{
  tell_object( TP, "\n\n\n" );
  tell_object( TP, BS(
    "Die meisten bewegen sich staendig von einer Stelle zu einer anderen, scheinbar "
    "ohne jeglichen Beweggrund (Hast Du tatsaechlich erwartet, dass Du das Verhalten "
    "der Rentiere binnen Minuten studieren koenntest?)") );
  if ( find_call_out("rentier3") == -1 )
    call_out( "rentier3", 8 );
}

void rentier3()
{
  tell_object( TP, "\n\n\n" );
  tell_object( TP, BS(
    "Einige scheinen zu aesen, denn es wurden eigens fuer die Tiere vier "
    "Futtertroege an der Innenseite des Zaunes angebracht, wieder andere sorgen "
    "sich um ihren Nachwuchs.") );
  if ( find_call_out("rentier4") == -1 )
    call_out( "rentier4", 8 );
}

void rentier4()
{
  tell_object( TP, "\n\n\n" );
  tell_object( TP, BS(
    "Ein paar sind so neugierig, dass sie sich Dir auf wenige Meter naehern und "
    "Dich genauso anschauen wie Du sie. Du meinst, dass Du dem Treiben lange genug "
    "zugesehen hast, und widmest Dich nun wieder anderen Dingen.") );
  say(
    TPN+" hat genug von der Rentierbeobachtung.\n");
  remove();
  return;
}