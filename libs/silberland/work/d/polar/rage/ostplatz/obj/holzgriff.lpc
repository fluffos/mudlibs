// Holzstiel fuer Kartoffelschaeler
// Filename: holzgriff.c
// File by Rage, Maerz 01

inherit "std/thing";

#include "../def.h"
#include <moving.h>

void create()
{
  if ( !is_clone(TO) ) return;

  ::create();

  SetProp( P_SHORT, "Ein kleiner Holzgriff" );
  SetProp( P_LONG,
    "Der Holzgriff ist etwa so lang wie Deine Hand breit ist und doppelt so "
    "dick wie Dein Daumen. Das Holz sieht ziemlich abgegriffen aus und an "
    "einem Ende weist der Griff ein Loch auf." );

//DETAILS
  AddDetail( "hand",
    "In einer Hand haeltst Du gerade den Griff." );
  AddDetail( "daumen",
    "Der Daumen haelt auch den Griff fest, denn sonst wuerde er Dir ja aus "
    "der Hand fallen." );
  AddDetail( "ende",
    "Der Griff hat natuerlich zwei Enden, aber nur das eine mit dem Loch scheint "
    "Dir interesseant zu sein." );
  AddDetail( "loch",
    "Du spaehst in das Loch, dass gerade mal 2cm lang ist, und fragst Dich, ob "
    "man nicht irgendwas hier reinstecken koennte." );
  AddDetail( "holz",
    "Das Holz ist schon ziemlich abgegriffen, aber Du tippst einmal auf Eiche." );
  AddDetail( "eiche",
    "Schon erstaunlich, wie ein Griff aus Eiche es hierher geschafft hat." );
//END DETAILS

  SetProp( P_INFO, "Fuer irgendetwas ist dieser Griff sicher gut!" );
  SetProp( P_NAME, "Holzgriff" );
  SetProp( P_GENDER, MALE );
  AddId( ({ "griff","holzgriff","\nholzgriff" }) );

  SetProp( P_MATERIAL, MAT_WOOD );
  SetProp( P_WEIGHT, 80 );
  SetProp( P_VALUE, 0 );

  AddCmd( ({ "steck","stecke" }), "cmd_stecken" );
}

// COMMANDS
int cmd_stecken(string str)
{
  object schaeler, teil;
  string was, worauf;

  if ( !str || str=="" ) return 0;
  if ( sscanf(str,"%s auf %s", was, worauf) != 2 ) return 0;
  if ( member( ({ "griff","holzgriff" }),was) != -1 )
  {
    if ( member( ({ "teil","metallteil" }),worauf) != -1 )
    {
      if ( teil=present("\nmetallteil",TP) )
      {
        write( BS(
          "Du steckst den Holzgriff ganz fest auf das Metallteil und als "
          "Belohnung haeltst Du nun ein Kuechengeraet in Haenden.") );
        say(
          TPN+" bastelt irgendetwas aus einem Holz- und einem Metallteil "
          "zusammen.\n" );
        schaeler = clone_object(OBJ "schaeler");
        schaeler -> move(TP,M_NOCHECK|M_SILENT);
        teil -> remove();
        TO -> remove();
        write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
          CAP(getuid(TP))+" baut sich einen Schaeler.\n");
        return 1;
      }
      write( BS(
        "Du hast nicht das richtige Teil bei Dir, auf den Du diesen Griff "
        "stecken koenntest.") );
      return -1;
    }
    write(
      "Worauf moechtest Du den Holzgriff stecken?\n" );
    return -1;
  }
}