// Schneemann: Checkliste fuer den Schneemannbau
// Filename: schneemann.c
// File by Rage, Februar 00

inherit "std/thing";

#include "../def.h"
#include "../schneemann.h"

int CheckThing(string thing);
int SetThing(string thing);

string things = "";
int State, Status, Coals, Coals2;

void create()
{
   if ( !is_clone(TO) )
      return;
   ::create();

   State = 0;
   Status = 0;
   Coals = 0;
   Coals2 = 0;

   SetProp( P_SHORT, 0 );
   SetProp( P_LONG, 0 );
   SetProp( P_INFO, 0 );
   SetProp( P_INVIS, 1 );
   SetProp( P_NAME, "Schneemann" );
   SetProp( P_GENDER, MALE );
   AddId( ({ "\nschneemann" }) );

   SetProp( P_MATERIAL, 0 );
   SetProp( P_WEIGHT, 0 );
   SetProp( P_VALUE, 0 );
   SetProp( P_NOBUY, 1 );
   SetProp( P_NEVERDROP, 1 );
   SetProp( P_NODROP, 1 );
}

int SetStatus(int item)
{
  if ( Status&item )
    return -1;
  Status |= item;
  return 1;
}

int GetStatus()
{
  return Status;
}

int QueryStatus(int item)
{
  return ( Status&item );
}

SetState()
{
   State++;
}

int GetState()
{
  return State;
}

SetCoals()
{
  Coals++;
}

int GetCoals()
{
  return Coals;
}

SetCoals2()
{
  Coals2++;
}

int GetCoals2()
{
  return Coals2;
}

int SetThing(string thing)
{
   int i;
   
   i = CheckThing(thing);
   if ( i <= 0 )
   {
      if ( i < 0 )
      {
         things = things+",";
      }
      things = things+thing;
   }
   return i;
}

int CheckThing(string thing)
{
   int i;
   string * str;
   
   if ( things == "" ) return 0;

   str = explode(things, ",");
   
   for ( i=0; i < sizeof(str); i++ )
   {
      if ( str[i] == thing )
      {
         return i+1;
      }
   }
   return -sizeof(str);
}