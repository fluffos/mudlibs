// Hunger, den man vom Hanfrauchen bekommt
// Filename: hunger.c
// File by Rage, Juni 00

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if ( !is_clone(TO) )  return;
  ::create();

  if ( find_call_out("hunger") == -1 )
    call_out( "hunger", 8 );
  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  SetProp( P_NAME, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NEVERDROP, 1 );
  AddId( "\nhunger" );
}

int hunger()
{
  if ( is_clone(TO) )
  {
    if ( 2*TP->QueryProp(P_FOOD) < TP->QueryProp(P_MAX_FOOD) )
    {
      if ( TP->QueryProp(P_GHOST) )
      {
        write( BS(
	  "Du bist zwar nun tot, aber dafuer hast Du keinen Hunger mehr.") );
        remove();
        return 1;
      }
      switch ( random(5) )
      {
      	case 0:
      	  write( BS(
            "Du bist vom Hanfrauchen so hungrig, dass Du dringend etwas "
            "essen musst, sonst verhungerst Du noch.") );
      	break;
      	case 1:
      	  write( BS(
      	    "Dein Magen knurrt schon so laut, dass ihn die anderen schon "
      	    "bestimmt hoeren koennen. Iss endlich was!") );
      	  tell_object( ENV(TP), BS(
      	    TP->Name(WESSEN)+" Magen knurrt sehr laut. "+TP->QueryPronoun(WER)+
      	    " sollte endlich einmal etwas essen.") );
      	break;
      	case 2:
      	  write( BS(
      	    "Du musst was essen! Du musst was essen! Du MUSST was essen! "
      	    "Wer haette gedacht, dass Hanfrauchen so hungrig macht.") );
      	break;
      	case 3:
      	  write( BS(
      	    "Bis jetzt hast Du noch nicht gewusst, was Hunger bedeutet, aber "
      	    "jetzt weisst Du es. Und wenn Du nicht bald etwas isst, dann "
      	    "koennte es zu spaet fuer Dich sein.") );
      	break;
      	case 4:
      	  write( BS(
      	    "Was war das fuer ein Grollen? Zieht ein Gewitter auf? Nein, doch "
      	    "nicht! Es war nur Dein Magen, der gerade sehr laut knurrte.") );
      	break;
      }     
      SetProp( P_KILL_NAME, "Hunger" );
      TP -> do_damage(5+random(6));
      if ( find_call_out("hunger") == -1 )
        call_out( "hunger", 7 );
      return 1;
    }
    write( BS(
      "Endlich hast Du Deinen Baerenhunger gestillt. Du haettest nicht "
      "gedacht, dass Hanf einen so hungrig machen kann.") );
    remove();
    return 1;
  }
  return 0;
}