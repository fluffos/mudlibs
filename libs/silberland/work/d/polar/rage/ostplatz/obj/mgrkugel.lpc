// Mittelgrosse Schneekugel fuer Schneemann
// Filename: mgrkugel.c
// File by Rage, Februar 00

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Eine mittelgrosse Schneekugel" );
  SetProp( P_LONG,
    "Eine mittelgrosse Kugel, die komplett aus Schnee geformt wurde. Sie hat "
    "einen Durchmesser von einem halben Meter, und wuerde sich gut als "
    "Oberkoerper fuer einen Schneemann eignen." );
  SetProp( P_NAME, "Schneekugel" );
  SetProp( P_NAME_ADJ, "mittelgross" );
  AddAdjective( ({ "mittelgrosse" }) );
  SetProp( P_GENDER, FEMALE );
  AddId( ({ "kugel","schneekugel","\nmgrkugel" }) );

  SetProp( P_MATERIAL, MAT_ICE );
  SetProp( P_WEIGHT, 15000 );
  SetProp( P_VALUE, 0 );
  SetProp( P_NOGET, "Die brauchst Du nicht zu nehmen, hebe sie einfach "
                    "auf den Unterleib Deines Schneemannes.\n" );
}