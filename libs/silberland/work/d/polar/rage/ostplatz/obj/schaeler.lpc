// Kartoffelschaeler: zum Augen rausschaelen
// Filename: schaeler.c
// File by Rage,  Maerz 01

inherit "std/thing";

#include "../def.h"
#include <moving.h>

string handwahl;

void create()
{ 
  if ( !is_clone(TO) ) return;

  ::create();
  
  if ( random(100) > 10 )
    handwahl = "rechtshaendig";
  else
    handwahl = "linkshaendig";

  SetProp( P_SHORT, "Ein "+handwahl+"er Kartoffelschaeler" );
  SetProp( P_LONG,
    "Mit diesem "+handwahl+"en Schaeler kannst Du ganz bestimmt ausgezeichnet "
    "Kartoffel schaelen. Der Holzgriff liegt gut in der Hand und in ihm steckt "
    "ein Metallteil, der einen laenglichen Schlitz hat." );

//DETAILS
  AddDetail( "kartoffel",
    "Die Kartoffel werden zu diesem Schaeler nicht automatisch mitgeliefert. Die "
    "musst Du schon selbst finden." );
  AddDetail( ({ "griff","holzgriff" }),
    "Der Holzgriff ist etwa so lang wie Deine Hand breit ist und doppelt so "
    "dick wie Dein Daumen. Das Holz sieht ziemlich abgegriffen aus." );
  AddDetail( "hand",
    "In einer Hand haeltst Du gerade den Kartoffelschaeler." );
  AddDetail( "daumen",
    "Der Daumen haelt auch den Griff fest, denn sonst wuerde er Dir ja aus "
    "der Hand fallen." );
  AddDetail( ({ "holz","eiche" }),
    "Das Holz ist schon ziemlich abgegriffen, aber Du tippst einmal auf Eiche." );
  AddDetail( ({ "teil","metallteil" }),
    "Das Metallteil ist etwa so lang und so breit wie Dein Mittelfinger. Es hat fast "
    "ueber seine gesamte Laenge einen Schlitz und sitzt ziemlich locker im Griff "
    "drin, sodass es sich leicht mitdreht beim Kartoffel schaelen und man es sicher "
    "auch wieder aus dem Griff heraus bekommt. Ausserdem faellt Dir auf, dass das "
    "Metallteil nach vorne hin spitz und leicht gewoelbt verlaeuft." );
  AddDetail( ({ "spitz","spitze" }),
    "Mit dieser gewoelbten Spitze koennte man vielleicht sogar ziemlich kleine "
    "Dinge aus Gemuese oder Obst schaelen." );
  AddDetail( "mittelfinger",
    "Der Metallteil des Kartoffelschaelers ist gleich breit wie Dein Finger." );
  AddDetail( "schlitz",
    "Als Du ueber den Schlitz faehrst, merkst Du, dass er ziemlich scharfkantig "
    "ist. Er sieht aus wie ein schmales, laenglisches Oval." );
  AddDetail( "oval",
    "Der scharfkantige Schlitz ist ovalfoermig." );
  AddDetail( "laenge",
    "Der Schlitz laeuft beinahe ueber die ganze Laenge des Metallteiles." );
//END DETAILS

  SetProp( P_INFO, "Mit einem Kartoffelschaeler kann man Kartoffel schaelen :-)" );
  SetProp( P_NAME, "Kartoffelschaeler" );
  SetProp( P_GENDER, MALE );
  SetProp( P_NAME_ADJ, handwahl );
  AddAdjective( ({handwahl+"er", handwahl+"en"}) );
  AddId( ({ "geraet","schaeler","kartoffelschaeler","\nkartoffelschaeler" }) );

  SetProp( P_MATERIAL, ([ MAT_IRON, MAT_WOOD ]) );
  SetProp( P_WEIGHT, 160 );
  SetProp( P_VALUE, 50 );

  AddCmd( ({ "schael","schaele" }), "cmd_schaelen" );
  AddCmd( ({ "zieh","ziehe" }), "cmd_ziehen" );
}

// COMMANDS
int cmd_schaelen(string str)
{
  object auge, kadaver;
  string was, woraus, womit;

  notify_fail( "Was willst Du mit welcher Hand abschaelen bzw woraus schaelen?\n" );

  if ( !str || str=="" ) return 0;
  if ( sscanf(str,"%s mit %s aus %s", was, womit, woraus) != 3 ) return 0;
  if ( member( ({ "auge","fischauge" }),was) != -1 )
  {
    if ( member( ({ "links","linker hand","rechts","rechter hand" }),womit) != -1 )
    {
      if ( member( ({ "kadaver","fischkadaver","augenhoehle" }),woraus) != -1 )
      {
        if ( kadaver = present("\nfischkadaver",TP) )
        {
          if ( kadaver->augenanzahl() )
          {
            write( BS(
              "Vorsichtig schaelst Du mit dem Schaeler ein Fischauge aus dem "
      	      "Fischkadaver und achtest darauf, das Auge nicht dabei zu zerschneiden.") );
      	    say(
      	      TPN+" seziert einen Fischkadaver.\n" );
      	    if ( (handwahl == "rechtshaendig") &&
      	         ((womit == "links") || (womit == "linker hand")) )
      	    {
      	      write( BS(
      	        "Leider schneidest Du Dir selbst in den Finger, da Du den "
      	        "rechtshaendigen Schaeler mit der linken Hand verwendet hast.") );
      	      say(
      	        TPN+" schneidet sich aber dummerweise dabei selbst.\n" );
      	      TP -> AddHp(-random(10));
      	    }
      	    if ( (handwahl == "linkshaendig") &&
      	         ((womit == "rechts") || (womit == "rechter hand")) )
      	    {
      	      write( BS(
      	        "Leider schneidest Du Dir selbst in den Finger, da Du den "
      	        "rechtshaendigen Schaeler mit der linken Hand verwendet hast.") );
      	      say(
      	        TPN+" schneidet sich aber dummerweise dabei selbst.\n" );
      	      TP -> AddHp(-random(10));
      	    }
      	    kadaver -> augenminimierer();
            auge = clone_object(OBJ "fischauge");
            auge -> move(TP,M_NOCHECK|M_SILENT);
            return 1;
          }
          write( BS(
            "Der Fischkadaver hat leider keine Augen, die Du aus der Augenhoehle "
            "herausschaelen koenntest.") );
          return -1;
        }
        write(
          "Du hast ja gar keinen Fischkadaver bei Dir!\n" );
        return -1;
      }
      write(
        "Woraus willst Du das Auge schaelen?\n" );
      return -1;
    }
  }
}

int cmd_ziehen(string str)
{
  object griff, teil;
  string was, woraus;

  notify_fail( "Willst Du das Metallteil wieder aus dem Griff ziehen?\n" );

  if ( !str || str=="" ) return 0;
  if ( sscanf(str,"%s aus %s", was, woraus) != 2 ) return 0;
  if ( member( ({ "teil","metallteil" }),was) != -1 )
  {
    if ( member( ({ "griff","holzgriff" }), woraus) != -1 )
    {
      write( BS(
        "Du ziehst das Metallteil aus dem Holzgriff heraus und haeltst wieder beide "
        "Einzelteile in Haenden.") );
      say(
        TPN+" zerlegt einen Kartoffelschaeler in seine Einzelteile.\n" );
      teil = clone_object(OBJ "metallteil");
      teil -> move(TP,M_NOCHECK|M_SILENT);
      griff = clone_object(OBJ "holzgriff");
      griff -> move(TP,M_NOCHECK|M_SILENT);
      TO -> remove();
      return 1;
    }
    write(
      "Woraus willst Du das Metallteil ziehen?\n" );
    return -1;
  }
}