// Eiskristall, als Schluessel fuer Eispalast
// Filename: eiskristall.c
// File by Rage, Februar 01

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Eiskristall" );
  SetProp( P_LONG,
    "Dieser kleine Eiskristall, der gerade mal so gross wie Dein Daumen "
    "ist, funkelt in der Sonne. Ausserdem scheint er erstaunlicherweise "
    "eine regelmässiges Form zu haben." );
    
//DETAILS
  AddDetail( "form",
    "Der Kristall ist einerseits nicht nur sehr flach, dass Du durchschauen "
    "kannst, sondern hat eine kleinen Innenkreis mit mehreren Strahlen nach "
    "aussen." );
  AddDetail( ({ "innenkreis","kreis" }),
    "Der Innenkreis ist sehr symmetrisch aufgebaut und von ihm gehen die "
    "sechs Strahlen nach aussen. Du kannst aber nicht sagen, ob das "
    "irgendeine besondere Bedeutung haben soll." );
  AddDetail( "bedeutung",
    "Vielleicht wirst Du irgendwann eine Bedeutung im Eiskristall erkennen, "
    "aber Du hast das Gefuehl, dass Du ihn nicht umsonst hast." );
  AddDetail( "gefuehl",
    "Manchmal kann man seinen Gefuehlen trauen, dann wieder nicht." );
  AddDetail( "strahlen",
    "Sechs Strahlen gehen vom Kreis nach aussen und wirken sehr zerbrechlich, "
    "doch Du stellst fest, dass sie mehr aushalten, als Du dachtest." );
//END DETAILS

  SetProp( P_NAME, "Eiskristall" );
  SetProp( P_GENDER, MALE );

  AddId( ({ "kristall","eiskristall","QUESTOBJ" }) );
  SetProp( P_MATERIAL, MAT_ICE );
  SetProp( P_WEIGHT, 2 );
  SetProp( P_VALUE, 0 );
  SetProp( P_SIZE, 2 );
}

int PreventFollow(object dest)
{
  object *env;

  env=all_environment(TO);
  if( (env[sizeof(env)-1]->QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE])>7 )
  {
    tell_object( ENV(TO),
      "Der Eiskristall schmilzt in der Waerme.\n");
    call_out("weg", 0);
    return 2;
  }
  else
    return 1;
}
void weg()
{
  TO->remove();
}