// Zettel fuer Fellbesorgung von Schwarzfell
// Filename: fellliste.c
// File by Rage, Mai 00

inherit "std/thing";

#include "../def.h"
#include "../felle.h"

string *felle;
mapping erledigt;

void create()
{
  if ( !is_clone(TO) )  return;
  ::create();

  SetProp( P_SHORT, "Ein Zettel von Schwarzfell" );
  SetProp( P_INFO, "Zettel sind zum Lesen da!" );
  SetProp( P_NAME, "Zettel" );
  SetProp( P_GENDER, MALE );
  AddId( ({ "zettel", "\nfellliste" }) );

  SetProp( P_MATERIAL, MAT_PAPER );
  SetProp( P_WEIGHT, 0 );
  SetProp( P_VALUE, 0 );
  SetProp( P_SIZE, 10 );
  SetProp( P_NOBUY, 0 );
  SetProp( P_NOSELL, 1 );
  SetProp( P_NODROP, 1 );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_MAGIC, 1 );

  AddCmd( ({"lies", "lese"}), "cmd_lesen");
}

int cmd_lesen(string str)
{
   if ( id(str) ) 
   {
     write( long() );
     return 1;
   }
   return 0;
}

string _query_long()
{
  string ret;
  int i, j;

  ret = "Auf dem Zettel ist eine Liste mit den Fellen, die Du Schwarzfell "
        "bringen sollst:\n\n"
        "   +-----------------------------------------+\n"
        "   |                                         |\n";
  for ( i=0; i<sizeof(felle); i++ )
  {
     ret += sprintf( "   | %40-s|\n",erledigt[felle[i]]?(felle[i]+"   (beschafft)"):(felle[i]+""));
  }
  ret += "   |                                         |\n"
         "   +-----------------------------------------+\n\n"
         "Falls Du irgendwelche Felle bereits gefunden hast, dann bring "
         "sie einfach\n"
         "dem Fellhaendler in Yiqanuc.\n";    
  return ret;
}

void SetFelle(string *arg)
{
  int i;  
  
  erledigt = ([]);
  felle = arg;
  for ( i=0; i<sizeof(felle); i++ )
    erledigt[felle[i]] = 0;
  return;
}

string *QueryFelle()
{
 return felle;
}

void SetFelleErledigt(string key)
{
  erledigt[key] = 1;
}

int QueryFelleErledigt(string key)
{
  return erledigt[key];
}

int QueryErledigt() 
{ 
  int i, done;

  done = 1;
  for ( i=0; i<sizeof(felle); i++ )
  {
    if( !erledigt[felle[i]] ) 
      done = 0;
  }
  return done;
}


mixed _query_autoloadobj()
{
  return ({ erledigt, felle });
}

void _set_autoloadobj(mixed arg)
{
  if ( sizeof(arg ) > 1)
  {
    erledigt = arg[0];
    felle = arg[1];
  }
}