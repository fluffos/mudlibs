//Durst, den man vom Hanfrauchen bekommt
//Filename: durst.c
//File by Rage, Juni 00

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  if ( !is_clone(TO) )  return;
  ::create();

  if ( find_call_out("durst") == -1 )
    call_out( "durst", 8 );
  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  SetProp( P_NAME, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NEVERDROP, 1 );
  AddId( "\ndurst" );
}

durst()
{
  if ( is_clone(TO) )
  {
    if ( 2*TP->QueryProp(P_DRINK) < TP->QueryProp(P_MAX_DRINK) )
    {
      if ( TP->QueryProp(P_GHOST) )
      {
        write( BS(
	  "Du bist zwar nun tot, aber dafuer hast Du keinen Durst mehr.") );
        remove();
        return 1;
      }
      switch ( random(5) )
      {
      	case 0:
      	  write( BS(
            "Du bist vom Hanfrauchen so durstig, dass Du dringend etwas trinken "
            "musst, denn sonst verdurstest Du vielleicht.") );
      	break;
      	case 1:
      	  write( BS(
      	    "Deine Kehle ist total trocken. Du solltest so bald wie moeglich "
      	    "etwas trinken!") );
      	break;
      	case 2:
      	  write( BS(
      	    "Du musst was trinken! Du musst was trinken! Du MUSST was trinken! "
      	    "Waer haette gedacht, dass Hanfrauchen so durstig macht.") );
      	break;
      	case 3:
      	  write( BS(
      	    "Du kommst Dir vor, als haettest Du seit Tagen nichts mehr "
      	    "getrunken. Du trocknest noch aus, wenn Du das nicht bald "
      	    "aenderst.") );
      	break;
      	case 4:
      	  write( BS(
      	    "Der uebermaechtige Durst laesst Dich schon ganz schwach werden. "
      	    "Trink besser bald was, dann geht es Dir wieder besser.") );
      	break;
      }     
      SetProp( P_KILL_NAME, "Durst" );
      TP -> do_damage(5+random(6));
      if ( find_call_out("durst") == -1 )
      call_out( "durst", 8 );
      return 1;
    }
    write( BS(
      "Endlich hast Du Deinen Durst gestillt. Du haettest nicht gedacht, dass "
      "Hanf einen so durstig machen kann.") );
    remove();
    return 1;
  }
  return 0;
}