// Drahtbuerste
// Filename: dbuerste.c
// File by Rage, Juni 00

inherit "std/thing";

#include "../def.h"
#include <moving.h>

int knoten;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  knoten = 1;

  SetProp( P_SHORT, "Eine Drahtbuerste" );
  SetProp( P_LONG,
    "Diese Buerste besteht aus einem Holzteil mit Griff und Borsten aus "
    "Metall. Die Haare oder sogar die Zaehne damit zu buersten, waere "
    "glatter Wahnsinn!" );
  SetProp( P_INFO,
    "Mit dieser Buerste kannst Du ganz sicher eine gute Tat vollbringen." );
  SetProp( P_NAME, "Drahtbuerste" );
  SetProp( P_GENDER, FEMALE );

//DETAILS
  AddDetail( ({ "holzteil","teil" }),
    "Der Holzteil ist etwa einen Zentimeter dick und 30cm lang. Auf der "
    "Haelfte, die breiter als die andere ist, sind die Drahtborsten "
    "befestigt. In der anderen ist ein Loch, durch das eine Schnur in Form "
    "einer Schlaufe gefuehrt wurde." );
  AddDetail( ({ "haelfte" }),
    "Meinst Du die dickere oder die duennere Haelfte?" );
  AddDetail( ({ "dickere haelfte" }),
    "In die dickere Haelfte sind die Borsten aus Metall gesteckt worden." );
  AddDetail( ({ "duennere haelfte" }),
    "Die duennere Haelfte ist gleichzeitig der Griff. Am Ende ist ein Loch, "
    "durch das eine Schnur gefuehrt wurde." );
  AddDetail( ({ "griff" }),
    "Der Griff hat ein Loch am Ende, durch das eine Schnur gefuehrt wurde." );
  AddDetail( ({ "borsten","drahtborsten" }),
    "Es sind sicher bei weitem mehr als hundert Borsten. Sie sind alle aus "
    "Metall und damit wohl nicht zum Haare buersten geeignet." );
  AddDetail( ({ "metall" }),
    "Aufgrund der Farbe und der Biegsamkeit schliesst Du, dass es Messing "
    "sein muesste." );
  AddDetail( ({ "farbe" }),
    "Messingfarben." );
  AddDetail( ({ "biegsamkeit" }),
    "Die Borsten lassen sich leichter als Stahlborsten biegen, aber weniger "
    "leicht als Borsten von Haarbuersten.");
  AddDetail( ({ "schnur","hanf" }),
    "Die Schnur ist aus Hanf und wurde durch das Loch des Griffes gefuehrt. "
    "Sie hat einen Knoten, damit sie auch an der Buerste bleibt." );
  AddDetail( ({ "form","schlaufe" }),
    "Da die Schnur einen Knoten hat, bildet sie eine Schlaufe, wodurch man "
    "die Buerste auch aufhaengen kann.");
  AddDetail( ({ "knoten" }),
    "Der verhindert, dass sich die Schnur von der Buerste trennt. Den kriegst "
    "Du sicher nie und nimmer auf.");
  AddDetail( ({ "loch" }),
    "Ein kleines Loch im Griff, gerade so gross, dass die Schnur durchpasst." );
//END DETAILS

  AddId( ({ "drahtbuerste","buerste","\ndrahtbuerste"}) );
  SetProp( P_MATERIAL, ([MAT_WOOD, MAT_BRASS]) );
  SetProp( P_WEIGHT, 300 );
  SetProp( P_VALUE, 100 );
  SetProp( P_SIZE, 20 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NOSELL, 1 );

  AddCmd( ({ "loes","loese" }), "cmd_loesen" );
  AddCmd( ({ "buerst","buerste" }), "cmd_buersten" );
  AddCmd( ({ "fuehr","fuehre","faedel","faedele","faedle" }), "cmd_fuehren" );
}

//COMMANDS
int cmd_buersten(string str)
{
  string was, womit;
  object zahn;
  	
  notify_fail( "Was willst Du mit der Buerste (ab-)buersten?\n" );

  if ( !str ) return 0;
  if ( str == "haar" || str == "haare" )
  {
    write( BS(
      "Du versuchst, Dir mit der Drahtbuerste Deine Haare zu buersten, "
      "was klaeglich scheitert. Statt einer tollen Frisur legst Du Dir "
      "nur einen kleinen Kratzer zu.") );
    say( BS(
      TPN+" versucht, sich mit einer Drahtbuerste zu buersten, flucht "
      "allerdings gewaltig dabei.") );
    TP -> AddHp(-random(8));
    return 1;
  }
  
  if ( str == "zahn" || str == "zaehne" )
  {
    if ( deep_present("\nlispeln", TP) )
    {
      write(
        "Du hast schon einen Zahn verloren, also laesst Du das mit dem "
        "Buersten lieber sein.\n" );
      return -1;
    }
    if ((zahn=present("zahnschutz",TP)) && zahn->QueryProp(P_WORN) )
    {
      write( BS(
        "Da Du einen Zahnschutz traegst, bringt Dir das Buersten der Zaehne "
        "wenig, aber dafuer hast Du Dir auch keinen abgekratzt.") );
      return -1;
    }
    write( BS(
      "Fleissig buerstest Du Dir die Zaehne, weil Du doch immer sehr "
      "auf diese achtest, aber die Idee, dies mit der Drahtbuerste zu "
      "machen, war weniger gut, denn Du verlierst dabei einen Zahn.") );
    say(
      TPN+" verliert beim Zaehneputzen einen Zahn.\n");
    TP -> AddHp(-5);
    zahn = clone_object ("/d/unterwelt/ronja/moor/obj/zahn");
    zahn->move(TP,M_GET|M_SILENT|M_NOCHECK);
    return 1;
  }
 
  if ( sscanf(str,"%s mit %s ab", was, womit) != 2 ) return 0;
  
  if ( member( ({ "matte","fussmatte" }), was) != -1 )
  {
    if ( !ENV(TP)->matte_da() )
    {
      write( BS(
        "Hier gibt es keine Matte, die man abbuersten koennte.") );
      return -1;
    }	
    if ( member( ({ "drahtbuerste","buerste" }), womit) != -1 )
    {	
      write( BS(
        "Da Du merkst, dass die Fussmatten schon so verschmutzt sind, nimmst "
        "Du jeweils eine, gehst mit ihr hinaus, buerstest sie ordentlich mit "
        "Deiner Buerste ab, klopfst noch den restlichen Dreck raus und legst "
        "sie dann wieder auf ihre Plaetze zurueck.") );
      say(
        TPN+" nimmt eine Fussmatte und macht sie wieder sauber.\n" );
      ENV(TP) -> Setdreck();
      return 1; 
    }
    notify_fail( "Womit willst Du die "+capitalize(was)+" abbuersten?\n" );
  }
}

int cmd_fuehren(string str)
{
  object schnur;
  string was, wodurch;

  notify_fail("Was willst Du wo durchfuehren?\n");

  if ( knoten )
  {
    write( BS(
      "Die Drahtbuerste hat bereits eine Schnur.") );
    return -1;
  }
  if ( !str ) return 0;
  if ( sscanf(str,"%s durch %s", was, wodurch) != 2 ) return 0;

  if ( member( ({ "hanfschnur","schnur" }), was) )
  {
    if ( schnur=present("\nhanfschnur",TP) )
    {
      if ( wodurch == "loch" )
      {
        write( BS(
          "Du nimmst die Hanfschnur und fuehrst sie geschickt durch "
          "das Loch in der Drahtbuerste. Um sicher zu gehen, dass die "
          "Schnur auch an der Buerste bleibt, machst Du noch rasch "
          "einen Spezialknoten rein.") );
        say(
          TPN+" bindet eine Schnur an einer Buerste fest.\n" );

        AddDetail( ({ "holzteil","teil" }),
          "Der Holzteil ist etwa einen Zentimeter dick und 30cm lang. Auf der "
          "Haelfte, die breiter als die andere ist, sind die Drahtborsten "
          "befestigt. In der anderen ist ein Loch, durch das eine Schnur in "
          "Form einer Schlaufe gefuehrt wurde." );
        AddDetail( ({ "duennere haelfte" }),
          "Die duennere Haelfte ist gleichzeitig der Griff. Am Ende ist ein "
          "Loch, durch das eine Schnur gefuehrt wurde." );
        AddDetail( ({ "griff" }),
          "Der Griff hat ein Loch am Ende, durch das eine Schnur gefuehrt wurde." );
        AddDetail( ({ "schnur","hanf" }),
          "Die Schnur ist aus Hanf und wurde durch das Loch des Griffes "
          "gefuehrt. Sie hat einen Knoten, damit sie auch an der Buerste bleibt." );
        AddDetail( ({ "form","schlaufe" }),
          "Da die Schnur einen Knoten hat, bildet sie eine Schlaufe, wodurch "
          "man die Buerste auch aufhaengen kann.");
        AddDetail( ({ "knoten" }),
          "Der verhindert, dass sich die Schnur von der Buerste trennt. Den "
          "kriegst Du sicher nie und nimmer auf.");
        AddDetail( ({ "loch" }),
          "Ein kleines Loch im Griff, gerade so gross, dass die Schnur "
          "durchpasst." );
        knoten = 1;
        schnur -> remove();
        write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
         CAP(getuid(TP))+" bastelt an der Buerste.\n");
        return 1;
      }
      notify_fail( "Wo willst Du jetzt die Hanfschnur durchfuehren?\n" );
      return 0;
    }
    write( BS(
      "Du hast nicht die richtige Schnur dabei.") );
    return -1;
  }
}

int cmd_loesen(string str)
{
  object schnur;
  int gesch, intel;

  gesch = 10+random(15);
  intel = 15+random(8);

  notify_fail( "Sag bloss, Du willst den Knoten loesen?\n" );
  if ( !knoten )
  {
    write( BS(
      "Die Drahtbuerste hat keine Schnur und somit auch keinen "
      "Knoten, den man loesen koennte.") );
    return -1;
  }
  if ( str == "knoten" )
  {
    if ( TP->QueryAttribute(A_INT) < intel )
    {
      write( BS(
        "Da es Dir in den Fingern so gejuckt hat, diesen Knoten loesen zu "
        "wollen, versuchst Du es auch gleich. Aber leider bleibt es beim "
        "Versuch, denn fuer Dich erweisst er sich wohl als gordischer. Du "
        "durschaust leider nicht das System des Knotens.") );
      say(
        TPN+" aergert sich, weil "+TP->QueryPronoun(WER)+" keinen Knoten "
        "aufmachen kann.\n");
      return 1;
    }
    else if ( TP->QueryAttribute(A_INT) >= intel &&
              TP->QueryAttribute(A_DEX) < gesch )
    {
      write( BS(
        "Da es Dir in den Fingern so gejuckt hat, diesen Knoten loesen zu "
        "wollen, versuchst Du es auch gleich. Aber leider bleibt es beim "
        "Versuch, denn fuer Dich erweisst er sich wohl als gordischer. Du "
        "durschaust zwar, wie der Knoten geloest werden koennte, aber Deine "
        "Fingerfertigkeit spielt nicht mit. Sehr schade.") );
      say(
        TPN+" aergert sich, weil "+TP->QueryPronoun(WER)+" keinen Knoten "
        "aufmachen kann.\n");
      return 1;
    }
    write( BS(
      "Mit Deinen geschickten Fingern und Deiner ueberragenden Intelligenz "
      "gelingt es Dir, den Knoten zu loesen. Als Belohnung haeltst Du nun "
      "eine Schnur in Haenden.") );
    say(
      TPN+" freut sich gerade ueber eine herausragende Leistung.\n");
    schnur = clone_object(OBJ "hanfschnur");
    schnur -> move(TP,M_NOCHECK|M_SILENT);

  AddDetail( ({ "holzteil","teil" }),
    "Der Holzteil ist etwa einen Zentimeter dick und 30cm lang. Auf der "
    "Haelfte, die breiter als die andere ist, sind die Drahtborsten "
    "befestigt. In der anderen ist ein kleines Loch." );
  AddDetail( ({ "duennere haelfte" }),
    "Die duennere Haelfte ist gleichzeitig der Griff. Am Ende ist ein kleines "
    "Loch." );
  AddDetail( ({ "griff" }),
    "Der Griff hat ein kleines Loch am Ende." );
  RemoveDetail( ({ "schnur","hanf" }) );
  RemoveDetail( ({ "form","schlaufe" }) );
  RemoveDetail( ({ "knoten" }) );
  AddDetail( ({ "loch" }),
    "Ein kleines Loch im Griff, gerade so gross, dass man eine Schnur "
    "durchfuehren koennte." );
  knoten = 0;
  write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
    CAP(getuid(TP))+" loest einen Knoten.\n");
  return 1;
  }
}

int knoten()
{
  return knoten;
}