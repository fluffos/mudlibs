// Schluessel aus Elfenbein für Eispalast
// Filename: elfschluessel.c
// File by Rage, Februar 02

inherit "std/thing";

#include "../def.h"

create()
{
  if ( !is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Ein Elfenbeinschluessel" );
  SetProp( P_LONG,
    "Dieser Schluessel ist vollstaendig aus Elfenbein und bestimmt recht "
    "wertvoll. Er ist sehr fein bearbeitet, hat keinerlei Kratzer oder "
    "andere Abnuetzungserscheinungen und fuenf kleine Zaehne." );
  SetProp( P_NAME, "Elfenbeinschluessel" );
  SetProp( P_GENDER, MALE );
  
//DETAILS
  AddDetail( "elfenbein",
    "Der gesamte Schluessel wurde aus Elfenbein gefertigt." );
  AddDetail( "kratzer",
    "Du kannst tatsaechlich keinerlei Kratzer auf dem Schluessel "
    "entdecken." );
  AddDetail( ({ "abnuetzungserscheinung","abnuetzungserscheinungen" }),
    "Auch von Abnuetzungserscheinungen ist nichts zu sehen, aber Du meinst, "
    "dass auf der Griffseite etwas waere." );
  AddDetail( ({ "griffseite","griff","seite" }),
    "Mit dieser Seite kannst Du den Schluessel angenehm halten und auch "
    "verwenden, wenn es notwendig sein sollte." );
  AddDetail( "etwas",
    "Mit dem Sehsinn laesst es sich leider nicht erkennen." );
  AddDetail( "zaehne",
    "Du zaehlst nochmals die Zaehne ab und stellst eindeutig fest, dass es "
    "ganz genau fuenf sind." );
  AddReadDetail( "schriftzug",
    "Es muss sich um eine sehr alte Sprache handeln, die Du leider nicht "
    "lesen kannst, aber vielleicht kann Dir dabei wer helfen." );
//END DETAILS  
  AddId( ({ "schluessel","elfenbeinschluessel","\nelfenbeinschluessel","QUESTOBJ" }) );
  SetProp( P_MATERIAL, MAT_IVORY );
  SetProp( P_WEIGHT, 100 );
  SetProp( P_VALUE, 700 );
  SetProp( P_SIZE, 9 );

  AddCmd( ({ "tast","taste","ertast","erstaste","fuehl","fuehle" }), "cmd_tasten" );
}

int cmd_tasten(string str)
{
  notify_fail ( "Was willst Du ertasten?\n" );

  if ( str == "etwas" )
  {
    write( BS(
      "Vorsichtig tastest Du ueber den Griff des Schluessels und spuerst sehr feine "
      "Linien.") );
    say(
      TPN+" sieht sich einen Schluessel genauer an." );
    return -1;
  }
  if ( str == "linie" || str == "linien" )
  {
    write( BS(
      "Schoen langsam bist Du davon ueberzeugt, dass es sich bei den Linien um "
      "einen Schriftzug handeln muss.") );
    say(
      TPN+" sieht sich einen Schluessel genauer an." );
    return 1;
  }
}