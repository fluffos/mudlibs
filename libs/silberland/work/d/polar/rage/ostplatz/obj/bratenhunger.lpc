// Hunger, der mit Braten gestillt werden muss
// Filename: bratenhunger.c
// File by Rage, Maerz 2002

inherit "std/thing";

#include "../def.h"
#include <moving.h>

create()
{
  if ( !is_clone(TO) )  return;
  ::create();

  if ( find_call_out("bhunger") == -1 )
    call_out( "bhunger", 8 );
  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  SetProp( P_NAME, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NEVERDROP, 1 );
  AddId( "\nbratenhunger" );
}

int bhunger()
{
  if ( is_clone(TO) )
  {
    if ( TP->QueryProp(P_GHOST) )
    {
      write( BS(
	"Du bist zwar nun tot, aber dafuer hast Du keinen Hunger mehr.") );
      remove();
      return 1;
    }
    switch ( random(4) )
      {
      	case 0:
      	  write( BS(
            "Du musst staendig an den Bratengeruch denken. Wenn Du nicht bald "
            "ein Stueck vom Braten abbekommst, verhungerst Du noch womoeglich!") );
      	break;
      	case 1:
      	  write(
      	    "Du denkst . o O (ich habe den totalen Appetit auf "
      	    "Rentierbraten)\n" );
      	break;
      	case 2:
      	  write( BS(
      	    "Deine Gedanken kreisen nur mehr um den Braten. Um diese los zu "
      	    "werden, solltest Du einfach einen essen.") );
      	break;
      	case 3:
      	  write( BS(
      	    "Wo ist der Braten? WO ist der Braten? Dir geht kein anderer "
      	    "Gedanke mehr durch den Kopf.") );
      	break;
      }     
    if ( find_call_out("bhunger") == -1 )
      call_out( "bhunger", 6 );
    return 1;
  }
  return 0;
}