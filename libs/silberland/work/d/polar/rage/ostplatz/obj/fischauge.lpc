// Fischauge zum Essen
// Filename: fischauge.c
// File by Rage, Maerz 01

inherit "std/food";

#include "../def.h"
#include <food.h>

int resetzaehler;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  resetzaehler = 0;

  SetProp( P_SHORT, "Ein Fischauge" );
  SetProp( P_LONG,
    "Das ist ein Auge eines seltenen Fisches aus den polaren Gewaessern. Es "
    "soll als besonders nahrhaft in diesen Breitengraden gelten." );
    
//DETAILS
  AddDetail( "fisch",
    "Vom Fisch ist nichts mehr da. Du weisst auch nicht, von welchem Fisch das "
    "Auge stammte." );
//END DETAILS

  SetProp( P_SMELL, "Das Fischauge riecht noch immer stark nach Fisch." );
  
  SetProp( P_NAME, "Fischauge" );
  SetProp( P_GENDER, NEUTER );
  AddId( ({ "auge","fischauge" }) );

  SetProp( P_MATERIAL, MAT_FOOD );
  SetProp( P_WEIGHT, 20 );
  SetProp( P_VALUE, 250 );
  SetProp( P_SIZE, 1 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_FOOD_INFO,([
           F_HEAL: ({ 15+random(10),20+random(15) }),
           F_SOAK: 4,
           F_ALCOHOL:0,
           F_POISON:0]) );
}

void BeimEssen()
{
  write(
    "Du schluckst das Auge als Ganzes, fuehlst Dich aber ziemlich gestaerkt.\n");
  say(
    TPN+" steckt sich ein Fischauge in den Mund und verschlingt es. Waeh!\n");
  return ::BeimEssen();
}

int PreventFollow(object dest)
{
  object *allenv;

  allenv = all_environment(TO);
  if ( (allenv[sizeof(allenv)-1] -> QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE]) > 12 )
  {
    tell_object( ENV(TO),
      "Das Fischauge vedirbt wegen der zu großen Wärme.\n" );
    call_out("weg", 0);
    return 2;
  }
  else
    return 1;
}
void weg()
{
  TO->remove();
}

void reset()
{
  ::reset();

  if ( resetzaehler > 2 )
  {
    write(
      "Das Fischauge trocknet komplett aus, weshalb Du es wegwirft.\n" );
    TO -> remove();
  }
  else
    resetzaehler ++;
}