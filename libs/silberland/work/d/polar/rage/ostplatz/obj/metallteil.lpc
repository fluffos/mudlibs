// Metallteil fuer Kartoffelschaeler
// Filename: metallteil.c
// File by Rage, Maerz 01

inherit "std/thing";

#include "../def.h"
#include <moving.h>

void create()
{
  if ( !is_clone(TO) ) return;

  ::create();

  SetProp( P_SHORT, "Ein kurzes Metallteil" );
  SetProp( P_LONG,
    "Das Metallteil ist etwa so lang und so breit wie Dein Mittelfinger. Das "
    "eine Ende hat einen kleinen zylindrischen Ansatz, waehrend das andere Teil "
    "einen Schlitz ueber fast die gesamte Laenge des Metallteiles aufweist. "
    "Nach vorne hin verlaeuft es spitz und leicht gewoelbt." );

//DETAILS
  AddDetail( "mittelfinger",
    "Du haeltst praktisch einen Mittelfinger aus Metall in Deiner Hand." );
  AddDetail( "hand",
    "Genau dort haeltst Du dieses Teil und betrachtest es." );
  AddDetail( "ende",
    "An einem Ende des Metallteiles ist ein kurzer, zylindrischer Ansatz." );
  AddDetail( "ansatz",
    "Der Ansatz ist keine 2cm lang. Vielleicht ist er dazu gedacht, das ganze "
    "Teil irgendwo reinzustecken." );
  AddDetail( ({ "spitz","spitze" }),
    "Mit dieser gewoelbten Spitze koennte man vielleicht sogar ziemlich kleine "
    "Dinge aus Gemuese oder Obst schaelen." );
  AddDetail( "schlitz",
    "Als Du ueber den Schlitz faehrst, merkst Du, dass er ziemlich scharfkantig "
    "ist. Er sieht aus wie ein schmales, laenglisches Oval." );
  AddDetail( "oval",
    "Der scharfkantige Schlitz ist ovalfoermig." );
  AddDetail( "laenge",
    "Der Schlitz laeuft beinahe ueber die ganze Laenge des Metallteiles." );
//END DETAILS

  SetProp( P_INFO, "Das Metallteil kannst Du sicher fuer irgendwas gebrauchen!" );
  SetProp( P_NAME, "Metallteil" );
  SetProp( P_GENDER, NEUTER );
  AddId( ({ "teil","metallteil","\nmetallteil" }) );

  SetProp( P_MATERIAL, MAT_IRON );
  SetProp( P_WEIGHT, 80 );
  SetProp( P_VALUE, 0 );

  AddCmd( ({ "steck","stecke" }), "cmd_stecken" );
}

// COMMANDS
int cmd_stecken(string str)
{
  object schaeler, teil;
  string was, wohin;

  if ( !str || str=="" ) return 0;
  if ( sscanf(str,"%s in %s", was, wohin) != 2 ) return 0;
  if ( member( ({ "teil","metallteil" }),was) != -1 )
  {
    if ( member( ({ "griff","holzgriff","loch" }),wohin) != -1 )
    {
      if ( teil=present("\nholzgriff",TP) )
      {
        write( BS(
          "Du steckst das Metallteil ganz fest in den Holzgriff hinein und als "
          "Belohnung haeltst Du nun ein Kuechengeraet in Haenden.") );
        say(
          TPN+" bastelt irgendetwas aus einem Holz- und einem Metallteil "
          "zusammen.\n" );
        schaeler = clone_object(OBJ "schaeler");
        schaeler -> move(TP,M_NOCHECK|M_SILENT);
        teil -> remove();
        TO -> remove();
        return 1;
      }
      write( BS(
        "Du hast nicht das richtige Teil bei Dir, in den Du dieses Teil "
        "stecken koenntest.") );
      return -1;
    }
    write(
      "Wohin moechtest Du das Metallteil stecken?\n" );
    return -1;
  }
}