// Fischkadaver
// Graeten als Dietrich fuer Quest dann verwendbar
// Filename: fkadaver.c
// File by Rage, Februar 01

inherit "std/thing";

#include "../def.h"
#include <moving.h>

int graetenanzahl, augenanzahl;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  graetenanzahl = random(3);
  augenanzahl = random(3);

  SetProp( P_SHORT, "Ein Fischkadaver" );
  SetProp( P_LONG,
    "Du haeltst in Deinen Haenden einen uebelriechenden Fischkadaver. Vom "
    "Kopf sind nur mehr die Augen und ein paar Schuppen zu erkennen. Vom Rest ist "
    "nur mehr das Gerippe ueber." );
    
//DETAILS
  AddDetail( ({ "kopf","kopfform" }),
    "Vom Kopf kannst Du nur mehr die Augen und ein paar einzelne Schuppen "
    "erkennen. Es muss sich um irgendeinen Polarfisch handeln, denn solch eine "
    "breite Kopfform hast Du bisher nicht gesehen." );
  AddDetail( "polarfisch",
    "Um welchen Polarfisch es sich beim Kadaver handelt, kannst Du mit Deinem "
    "Wissen nicht feststellen." );
  AddDetail( "wissen",
    "Du hast ein umfassendes Wissen, aber trotzdem kommst Du nicht drauf, um "
    "welchen Fisch es sich beim Kadaver handelt." );
  AddSpecialDetail( ({ "auge","augen" }), "detailAuge" );
  AddDetail( "grund",
    "Den Grund siehst Du nicht gleich so. Da musst Du Dir schon selbst was "
    "ueberlegen." );
  AddDetail( "schuppen",
    "Auf dem Kopf sind noch ein paar Schuppen, die silbern schimmern." );
  AddDetail( ({ "rest","gerippe" }),
    "Neben dem Kopf blieb vom Fisch nur mehr die Mittelgraete mitsamt den anderen "
    "kleinere Graeten ueber." );
  AddDetail( "mittelgraete",
    "Nach der Mittelgraete zu schliessen, muss der Fisch ca. 40cm lang gewesen "
    "sein. Von ihr gehen alle anderen kleineren Graeten weg." );
  AddDetail( "graeten",
    "An den Graeten des Kadavers ist nichts besonderes, ausser der Tatsache, dass "
    "ein paar von ihnen, knapp hinter dem Kopf, extrem biegsam aussehen." );
  AddDetail( "graete",
    "Willst Du irgendeine bestimmte Graete am Kadaver untersuchen?" );
  AddSpecialDetail( ({ "biegsame graete","biegsamen graeten",
                       "biegsame graeten" }),"detailGraete" );
  
  SetProp( P_SMELL, "Der Kadaver stinkt bestialisch. *wuerg*\n" );
//END DETAILS

  SetProp( P_INFO,
    "Der Kadaver stinkt bestialisch. Am besten gleich wegwerfen.\n" );
  SetProp( P_NAME, "Fischkadaver" );
  SetProp( P_GENDER, MALE );

  AddId( ({ "fisch","fischkadaver","kadaver","\nfischkadaver" }) );
  SetProp( P_MATERIAL, MAT_BONE );
  SetProp( P_WEIGHT, 40 );
  SetProp( P_VALUE, 10 );
  SetProp( P_SIZE, 20+random(11) );

  AddCmd( ({ "brich","breche","brech","reiss","reisse" }), "cmd_brechen" );
}
//SPECIAL DETAILS
string detailGraete()
{
  if ( graetenanzahl )
  {
    return BS(
      "Die Graeten direkt hinter dem Kopf sind einerseits biegsam, andererseits "
      "sehen sie nicht so aus, als ob sie leicht brechen koennten. Vielleicht "
      "waer es gar nicht schlecht, so eine Graete zu haben? Die kann man sicher "
      "noch brauchen." );
  }
  return BS(
    "Direkt hinter dem Kopf sind merkwuerdigerweise keine Graeten. Es sieht fast "
    "so aus, als ob sie jemand abgebrochen haette." );
}
string detailAuge()
{
  if ( augenanzahl == 2 )
    return BS(	
      "Seltsamerweise sind die Augen weder verwest, noch wurden sie gefressen. "
      "Ob sie giftig sind oder ob es einen anderen Grund dafuer gibt? Auf alle "
      "Faelle blicken sie Dich leer und trostlos an. Vielleicht kommst Du "
      "sogar mit dem passenden Geraet an die Augen ran." );
  else if ( augenanzahl == 1 )
    return BS(
      "Seltsamerweise hat der Kadaver nur mehr ein Auge, das weder verwest, noch "
      "gefressen wurde. Ob es giftig ist oder ob es einen anderen Grund dafuer "
      "gibt? Auf alle Faelle blickt es Dich leer und trostlos an. Vielleicht "
      "kommst Du sogar mit dem passenden Geraet an das Auge ran." );
  return BS(
    "Der Fischkadaver hat nur mehr leere Augenhoehlen, in denen keine Augen mehr "
    "vorhanden sind." );
}
// END SPECIAL DETAILS
int augenanzahl()
{
  return augenanzahl;
}
int augenminimierer()
{
  augenanzahl --;
}
//COMMANDS
int cmd_brechen(string str)
{
  object graete;

  notify_fail( "Was moechtest Du abbrechen?\n" );

  if ( member( ({ "graete","graete ab" }),str) != -1 )
  {
    write(
      "Du musst schon genauer werden. Welche Graete willst Du abbrechen?\n" );
    return -1;
  }
  else if ( member( ({ "mittelgraete","mittelgraete ab" }),str) != -1 )
  {
    write( BS(
      "Die Mittelgraete abzubrechen fuehrt zu ueberhaupt nichts. Such Dir eine "
      "andere Graete aus.") );
    return -1;
  }
  else if ( member( ({ "biegsame graete","biegsame graete ab" }),str) != -1 )
  {
    if ( graetenanzahl )
    {
      write( BS(
        "Mit einem raschen Ruck brichst Du eine biegsame Graete von der "
        "Mittelgraete ab.") );
      say(
        TPN+" spielt sich mit einem Fischkadaver herum. *WAEH*\n" );
      graete = clone_object(OBJ "graete");  
      graete -> move(TP,M_GET|M_SILENT);
      graetenanzahl --;
      write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
        CAP(getuid(TP))+" bricht eine Graete ab.\n");
      return 1;
    }
    write( BS(
      "Leider gibt es am Fischkadaver keine Graeten mehr, die Du irgendwie "
      "verwenden koenntest.") );
    return -1;
  }
}

varargs int move(mixed dest, int method)
{
  int ret;
  
  ret = ::move(dest, method);
  while( remove_call_out("tier_kommt") != -1 );
  if ( MENV && MENV->id("Raum") )
    call_out( "tier_kommt", 10 );
  return ret;
}
void tier_kommt()
{
  switch( MENV -> QueryTerrain() )
  {
    case TT_CAVE:
      write(
        "Eine riesige Spinne taucht auf, sieht zum Glueck den Kadaver und nicht "
        "Dich, verpackt ihn in einem Netz und verschwindet damit.\n" );
      say(
        "Eine riesige Spinne taucht auf, sieht zum Glueck den Kadaver und nicht "
        "Dich, verpackt ihn in einem Netz und verschwindet damit.\n" );
    break;
    case TT_HILL:
      write(
        "Ein Raubvogel kommt im Sturzflug auf den Kadaver zugeflogen, packt "
        "ihn mit seinen Krallen und ist schon wieder aus Deiner Sichtweite "
        "verschwunden.\n" );
      say(
        "Ein Raubvogel kommt im Sturzflug auf den Kadaver zugeflogen, packt "
        "ihn mit seinen Krallen und ist schon wieder aus Deiner Sichtweite "
        "verschwunden.\n" );
    break;
    case TT_TOWN:
      write(
        "Ein streunender Hund laeuft herein, schnappt sich den Kadaver und laeuft "
        "damit davon.\n" );
      say(
        "Ein streunender Hund laeuft herein, schnappt sich den Kadaver und laeuft "
        "damit davon.\n" );
    break;
    case TT_DESERT:
      if ( random(2) )
      {
        write(
          "Eine Klapperschlange schlaengelt herein, verschluckt den Kadaver und "
          "schlaengelt davon.\n" );
        say(
          "Eine Klapperschlange schlaengelt herein, verschluckt den Kadaver und "
          "schlaengelt davon.\n" );
      }
      else
      {
        write(
           "Ein Aasgeier kommt im Sturzflug herbeigeflogen, schnappt den "
           "Kadaver und hebt sich wieder in die Luefte.\n" );
        say(
           "Ein Aasgeier kommt im Sturzflug herbeigeflogen, schnappt den "
           "Kadaver und hebt sich wieder in die Luefte.\n" );
      }
    break;
    case TT_SWAMP:
      write(
        "Ein Storch landet vor Dir, schnappt den Kadaver und fliegt damit "
        "davon.\n" );
      say(
        "Ein Storch landet vor Dir, schnappt den Kadaver und fliegt damit "
        "davon.\n" );
    break;
    case TT_ARCTIC:
      write(
        "Ein Polarwolf schleicht herein, erspaeht den Fischkadaver, schnueffelt "
        "daran und schleppt ihn schliesslich davon.\n" );
      say(
        "Ein Polarwolf schleicht herein, erspaeht den Fischkadaver, schnueffelt "
        "daran und schleppt ihn schliesslich davon.\n" );
    break;
    case TT_ROAD:
      write(
        "Ein Wiesel taucht ploetzlich auf, findet den Kadaver und verschwindet "
        "mit diesem wieder.\n" );
      say(
        "Ein Wiesel taucht ploetzlich auf, findet den Kadaver und verschwindet "
        "mit diesem wieder.\n" );
    break;
    case TT_HOUSE:
      write(
        "Zwei Ratten trippeln daher, riechen am Kadaver und schleppen ihn "
        "dann davon.\n" );
      say(
        "Zwei Ratten trippeln daher, riechen am Kadaver und schleppen ihn "
        "dann davon.\n" );
    break;
    case TT_FOREST:
      write(
        "Ein Fuchs schleicht herein, erspaet den Kadaver, schnappt ihn sich "
        "und verschwindet wieder im Wald.\n" );
      say(
        "Ein Fuchs schleicht herein, erspaet den Kadaver, schnappt ihn sich "
        "und verschwindet wieder im Wald.\n" );
    break;
    case TT_MOUNTAIN:
      write(
        "Ein junger Wolf sucht nach Beute, entdeckt den Kadaver und "
        "verschwindet damit.\n" );
      say(
        "Ein junger Wolf sucht nach Beute, entdeckt den Kadaver und "
        "verschwindet damit.\n" );
    break;
    case TT_JUNGLE:
      write(
        "Ein Schimpanse springt vor Dir nieder, nimmt den Kadaver an sich "
        "und laeuft damit davon.\n" );
      say(
        "Ein Schimpanse springt vor Dir nieder, nimmt den Kadaver an sich "
        "und laeuft damit davon.\n" );
    break;
    case TT_PLAIN:
      write(
        "Eine Katze kommt herein, spielt sich mit dem Kadaver und schleppt "
        "ihn davon.\n" );
      say(
        "Eine Katze kommt herein, spielt sich mit dem Kadaver und schleppt "
        "ihn davon.\n" );
    break;
    case TT_UNDERWATER:
      write(
        "Ein grosser Fisch schwimmt vorbei, schnappt den Kadaver und "
        "verschwindet wieder.\n" );
      say(
        "Ein grosser Fisch schwimmt vorbei, schnappt den Kadaver und "
        "verschwindet wieder.\n" );
    break;
    case TT_OTHER:
      write(
        "Ein seltsames, fellbedecktes Tier huscht herein, packt den "
        "Kadaver und verschwindet damit.\n" );
      say(
        "Ein seltsames, fellbedecktes Tuer huscht herein, packt den "
        "Kadaver und verschwindet damit.\n" );
    break;
    default:
      write(
        "Ein Tier kommt daher, schnappt sich den Kadaver und verschwindet "
        "damit.\n" );
      say(
        "Ein Tier kommt daher, schnappt sich den Kadaver und verschwindet "
        "damit.\n" );
    break;
  } 
  remove();
}