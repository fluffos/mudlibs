// Lederschnur: Teil fuer Speer
// Filename: lederband.c
// File by Rage, Februar 00



inherit "std/thing";

#include "../def.h"
#include <moving.h>

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Lederband" );
  SetProp( P_LONG,
    "Ein kurzes Band aus Leder. Eindeutig! Die Frauen in Midas wuerden sich "
    "damit die Haare zusammenbinden." );
  SetProp( P_INFO,
    "Wenn Du nicht weisst, was Du mit diesem Gegenstand anfangen sollst, dann "
    "hilft Dir sicher Yrdaret weiter." );
  SetProp( P_NAME, "Lederband" );
  SetProp( P_GENDER, NEUTER );

//DETAILS
  AddDetail( ({ "leder","rentierleder" }),
    "Es duerfte sich hierbei wohl um Rentierleder handeln, denn soviele "
    "andere Wildarten gibt in Yiqanuc nicht." );
//END DETAILS

  AddId( ({ "lederband","band","\nlederband","QUESTOBJ" }) );
  SetProp( P_MATERIAL, MAT_LEATHER );
  SetProp( P_WEIGHT, 10 );
  SetProp( P_VALUE, 50 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NODROP, "Behalt es mal lieber!\n" );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_NOSELL, 1 );
  SetProp( P_SMELL, "Eigenartig, es riecht ganz leicht nach Fisch.\n" );

  AddCmd( ({ "wickel","wickle","rolle","roll" }), "cmd_wickeln" );
}

//COMMANDS
int cmd_wickeln(string str)
{
  object holzstecken, walfangspeer;

  notify_fail( "Was willst Du wo herumwickeln?\n" );

  if( member( ({ "lederband um holzstecken herum","lederband um holzstecken",
                 "lederband um stecken herum","lederband um stecken",
                 "band um holzstecken herum","band um holzstecken",
                 "band um stecken herum","band um stecken"
               }), str) != -1 )
  {
    notify_fail( "Den Holzstecken brauchst Du aber auch dazu!\n" );

    if ( !present("\nholzstecken",TP) ) return 0;

    if ( (holzstecken=present("\nholzstecken",TP)) && 
         (holzstecken->zusammengesteckt()) )
    {
      write( BS(
        "Du wickelst das Lederband um das Ende des Holzsteckens herum, an dem "
        "das Elfenbeinstueck steckt, ziehst es ganz fest zu und machst zur "
        "Sicherheit sogar noch einen Knoten rein.\n") );
      say( BS(
        TPN+" scheint sich ueber eine neugewonnene Waffe zu freuen.\n") );
      holzstecken -> remove(1);
      walfangspeer = clone_object(WEAPON "walfangspeer");
      walfangspeer -> move(TP,M_NOCHECK|M_SILENT);
      remove();
      return 1;
    }
    write( BS(
      "Du wickelst das Lederband ein paar Mal um den Holzstecken herum, "
      "doch was soll ein Stecken mit Lederband bringen? Genau, nichts! Du "
      "entschliesst Dich das Band wieder abzumachen und ueberlegst Dir, ob "
      "da nicht noch etwas fehlt.\n") );
    say( BS(
      TPN+" muss es ja sehr langweilig sein, wenn "+TP->QueryPronoun(WER)+
      " sich bereits mit einem Lederband unterhaelt.\n") );
    return -1;
  }
}