// Eisschuppe
// Filename: eisschuppe.c
// File by Rage, April 03

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Eine Eisdrachenschuppe" );
  SetProp( P_LONG,
    "Diese Schuppe stammt wohl von einem Eisdrachen, denn sie ist vollstaendig "
    "aus Eis. Sie scheint ein schoenes Souvenir zu sein, aber ob Du sie noch "
    "zu etwas anderem brauchen kannst, bleibt Dir ein Raetsel." );
    
//DETAILS
  AddDetail( ({ "eisdrache","eisdrachen","drache","drachen" }),
    "Von dem siehst Du derzeit nichts." );
  AddDetail( "eis",
    "Die gesamte Schuppe besteht vollstaendig aus Eis." );
  AddDetail( "souvenir",
    "Mit der Eisdrachenschuppe haeltst Du ein huebsches Souvenir in Haenden." );
  AddDetail( ({ "haende","hand" }),
    "Deine Hand ist noch nicht aus Eis, nur die Schuppe." );
  AddDetail( "raetsel",
    "Vielleicht kommst Du irgendwann sogar einmal dahinter." );
//END DETAILS

  SetProp( P_NAME, "Eisdrachenschuppe" );
  SetProp( P_GENDER, FEMALE );

  AddId( ({ "schuppe","drachenschuppe","eisdrachenschuppe","QUESTOBJ" }) );
  SetProp( P_MATERIAL, MAT_ICE );
  SetProp( P_WEIGHT, 40 );
  SetProp( P_VALUE, 5000+random(5000) );
  SetProp( P_SIZE, 10+random(10) );
  SetProp( P_NOSELL, "Der Haendler will Dir die Eisschuppe nicht abkaufen.\n" );
}

int PreventFollow(object dest)
{
  object *env;

  env=all_environment(TO);
  if( (env[sizeof(env)-1]->QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE])>25 )
  {
    tell_object( ENV(TO),
      "Leider schmilzt Dir die Eisdrachenschuppe in der Hitze.\n");
    call_out("weg", 0);
    return 2;
  }
  else
    return 1;
}
void weg()
{
  TO->remove();
}