// Elfenbeinteil: Teil fuer Speer)
// Filename: stueck.c
// File by Rage, Februar 00

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Elfenbeinstueck" );
  SetProp( P_LONG,
    "So ein feinbearbeitetes Stueck aus Elfenbein hast Du noch nie in Haenden "
    "gehalten. Es ist nicht groesser als Deine Hand und voll mit wertvollen "
    "Schnitzereien. An einem Ende laeuft es spitz zu, am anderen Ende ist "
    "ein kleiner Ansatz." );
  SetProp( P_INFO,
    "Wenn Du nicht weisst, was Du mit diesem Gegenstand anfangen sollst, dann "
    "hilft Dir sicher Yrdaret weiter." );
  SetProp( P_NAME, "Elfenbeinstueck" );
  SetProp( P_GENDER, NEUTER );

//DETAILS
  AddDetail( ({ "schnitzerei","schnitzereien" }),
    "Die Schnitzereien stellen in feinsaeuberlichster Weise Eisbaeren und "
    "Wale dar." );
  AddDetail( ({ "wal","wale","eisbaer","eisbaeren" }),
    "Die Xandim muessen die wohl oft jagen, sonst waeren die Darstellungen "
    "von ihnen wohl nicht in Elfenbein geschnitzt worden." );
  AddDetail( ({ "darstellung","darstellungen" }),
    "Eisbaeren und Wale werden durch Schnitzerei dargestellt." );
  AddDetail( ({ "ansatz" }),
    "Der Ansatz hat einen Durchmesser von knapp einem Zentimeter und eine "
    "Laenge von 3 Zentimeter. Du meinst, dass er sicher eine Bedeutung hat." );
  AddDetail( ({ "ende","enden" }),
    "Welches Ende meinst Du? Das spitze oder den Ansatz?" );
  AddDetail( ({ "hand","vergleich" }),
    "Das war doch nur ein Vergleich." );
  AddDetail( ({ "spitze ende","spitzes ende" }),
    "Du schneidest Dir zwar nicht damit in die Finger, aber man kann sicher "
    "jemanden damit verletzen." );
//END DETAILS

  AddId( ({ "stueck","elfenbeinstueck","\nelfenbeinstueck","QUESTOBJ" }) );
  SetProp( P_MATERIAL, MAT_IVORY );
  SetProp( P_WEIGHT, 50 );
  SetProp( P_VALUE, 5000 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NODROP, "Dieses Stueck ist vielleicht noch fuer etwas gut.\n" );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_NOSELL, 1 );
  SetProp( P_SMELL, "Eigenartig, es riecht ganz leicht nach Fisch.\n" );

  AddCmd( ({ "steck","stecke","verbind","verbinde" }), "cmd_stecken" );
}

//COMMANDS
int cmd_stecken(string str)
{
  object holzstecken;

  if( member( ({ "stueck in loch","stueck in stecken",
		 "stueck in holzstecken",
	         "elfenbeinstueck in loch",
	         "elfenbeinstueck in stecken",
	         "elfenbeinstueck in holzstecken",
	         "elfenbeinstueck mit holzstecken",
	         "stueck mit stecken","stueck mit holzstecken",
	         "elfenbeinstueck mit stecken"
	       }),str) != -1 ) 
  {
    if ( !(holzstecken=present("\nholzstecken",TP)) ) return 0;
    write( BS(
      "Das Elfenbeinstueck passt wie angegossen in das Loch am Holzstecken. "
      "Nur ob das Teil von allein drin haelt?") );
    holzstecken -> verbunden();
    say( BS(
      TPN+" hat irgendwas mit "+TP->QueryPossPronoun(NEUTER,WEM,SINGULAR)+
      " Elfenbeinstueck gemacht. Bloss was?") );
    remove();
    return 1;
  }
}