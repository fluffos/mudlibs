// Sackerl mit Keks
// Filename: kekssackerl.c
// File by Rage, April 03 (adaptiert von Bonbonsackerl)

inherit "std/thing" ;

#include "../def.h"
#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <language.h>

#define MAXFILL 25

int fill;

create()
{
  if (!is_clone(TO)) return;
  ::create() ;

  fill = MAXFILL;

  SetProp( P_SHORT, "Ein Sackerl, voll mit guten Keksi" ) ;
  SetProp( P_LONG,
    "Ein seltsames Kekssackerl aus Leinen.  \n"+
    "Es enthaelt @@wieviel@@ Kekse.\n");

  SetProp( P_WEIGHT, 20 + 10*MAXFILL) ;
  SetProp( P_NOBUY, 1) ;
  SetProp( P_NODROP, "Nein, Du willst doch nicht dieses Geschenk weggeben!?\n");
  SetProp( P_NEVERDROP, 1) ;
  SetProp( P_NAME, "Sackerl") ;
  SetProp( P_GENDER, NEUTER ) ;
  AddId( ({ "kekssackerl","sackerl" }) ) ;

  AddCmd( ({ "greif","greife","fass","fasse" }), "cmd_greifen" );
}


int cmd_greifen(string str)
{
  notify_fail ( "Wo hinein moechtest Du greifen?\n" );
  
  if ( str != "sackerl" && str != "in sackerl" && str != "in kekssackerl")
    return 0;
  write(
    "Du greifst in Dein Sackerl und holst ein Keksi heraus.\n");
  say(
    TPN+" holt ein Keksi aus einem Sackerl.\n" );
  clone_object(OBJ "keksi")->move(TP, M_NOCHECK);
  SetProp(P_WEIGHT, QueryProp(P_WEIGHT) - 10);	
  fill--;
  if (!fill)
  {
    write("Oooooooooch.... das war das letzte Keksi *ohje*\n");
    say(PL->name(WESSEN)+"Kekssackerl entschwindet.\n");
    return remove();
  }
  return 1;
}

string wieviel()
{
  return ""+fill+"";
}