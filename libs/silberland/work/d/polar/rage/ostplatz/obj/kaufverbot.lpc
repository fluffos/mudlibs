// Kaufverbot bei Graufell
// Filename: kaufverbot.c
// File by Rage, April 03

inherit "std/thing";

#include "../def.h"
int resetzaehler;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  resetzaehler = 0;

  SetProp( P_SHORT, 0 );
  SetProp( P_LONG, 0 );
  AddId( "\nverbot" );
  SetProp( P_WEIGHT, 0 );
  SetProp( P_VALUE, 0 );
  SetProp( P_INVIS, 1 );
  SetProp( P_NODROP, 1 );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_AUTOLOADOBJ, 1 );
}

void reset()
{
  if ( is_clone(TO) && resetzaehler>3 )
    remove();
  resetzaehler++;
  return;
}