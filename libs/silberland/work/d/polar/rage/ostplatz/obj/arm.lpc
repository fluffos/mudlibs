// Rolle aus Schnee fuer Schneemann
// Filename: arm.c
// File by Rage, Februar 00

inherit "std/thing";

#include "../def.h"

create()
{
  if ( !is_clone(TO) )  return;

  ::create();

  SetProp( P_SHORT, "Eine Rolle aus Schnee" );
  SetProp( P_LONG,
    "Wenn sie nicht aus Schnee waere, wuerdest Du sie glatt fuer eine "
    "Biskuitroulade halten. Sie ist ungefaehr 50 Zentimeter lang mit "
    "einem Durchmesser von 20 Zentimeter und eignet sich sicher als "
    "Arm fuer Deinen Schneemann." );
  SetProp( P_NAME, "Schneerolle" );
  SetProp( P_GENDER, FEMALE );
  AddId( ({ "rolle","schneerolle","\narm" }) );

  SetProp( P_MATERIAL, MAT_ICE );
  SetProp( P_WEIGHT, 3000 );
  SetProp( P_VALUE, 0 );
  SetProp( P_SIZE, 40 );
  SetProp( P_NOGET, "Die brauchst Du nicht zu nehmen. Stecke sie einfach "
                    "in den Oberkoerper vom Schneemann.\n" );
  
  AddCmd( ({ "steck","stecke" }), "cmd_stecken" );
}

int cmd_stecken(string str)
{
  object schneemann;

  if ( schneemann=present("\nschneemann",TP) )
  {
    if ( member( ({ "rolle in oberkoerper","schneerolle in oberkoerper",
		    "rolle in schneemann","schneerolle in schneemann"
		  }),str) != -1 )
    {
      if ( schneemann->GetState() < 3 )
      {
        write( BS(
          "Vielleicht solltest Du zuerst den Koerper und den Kopf machen, "
          "bevor Du mit den Gliedmassen beginnst.") );
        return -1;
      }
      else if ( schneemann->GetState() == 3 )
      {
        write( BS(
          "Du nimmst die Schneerolle und steckst sie in den Oberkoerper "
          "Deines Schneemannes. Fehlt nur noch der zweite Arm.") );      
        schneemann -> SetState();
        say(
	  TPN+" baut an "+(TP->QueryProp(P_GENDER)==FEMALE?"ihrem":"seinem")+
          " Schneemann.\n" );
        remove();
        return 1;
      }
      else if ( schneemann->GetState() == 4 )
      {
        write( BS(
          "Du nimmst die Schneerolle und steckst sie genau gegenueber vom "
          "anderen Arm in den Oberkoerper des Schneemannes.") );
	schneemann -> SetState();
        say(
	  TPN+" baut an "+(TP->QueryProp(P_GENDER) == FEMALE?"ihrem":"seinem")+
          " Schneemann.\n" );
        remove();
        return 1;
      }
      else if ( schneemann->GetState() > 4 )
      {
        write(
	  "Dein Schneemann hat schon zwei Arme. Mehr braucht er sicher "
          "nicht.\n" );
        return -1;
      }
    }
    write(
      "Wo willst Du die Schneerolle hinstecken?\n" );
    return -1;
  }
  write( BS(
    "Du willst gerade die Schneerolle vom Boden aufheben, doch ploetzlich "
    "beschiessen Dich die Kinder mit Schneebaellen, und Du laesst "
    "vorlaeufig von Deinem Vorhaben ab.") );
  say(
    TPN+" wird von den Kindern mit Schneebaellen beschossen.\n" );
  return -1;
}