// Keks
// Filename: keksi.c
// File by Rage, April 03

inherit "std/thing";

#include "../def.h"

int bisse;

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  bisse = 5+random(3);

  SetProp( P_SHORT, "Ein Keksi" );
  SetProp( P_LONG,
    "Dieses Keksi wartet schon darauf, von Dir verspeist zu werden. Es ist sogar "
    "richtig gross, dass Du bestimmt fuenf oder sechs Bisse davon nehmen kannst. "
    "Es schaut einfach lecker aus und Du musst so schnell wie moeglich "
    "reinbeissen." );

  SetProp( P_NAME, "Keksi" );
  SetProp( P_GENDER, NEUTER );

  AddId( ({ "keksi" }) );
  SetProp( P_MATERIAL, MAT_FOOD );
  SetProp( P_WEIGHT, 20 );
  SetProp( P_VALUE, 0 );
  SetProp( P_SIZE, 8 );

  AddCmd( ({ "iss","ess","esse" }), "cmd_essen" );
}

int cmd_essen(string str)
{ 
  notify_fail( "Was willst Du essen?\n" );
  
  if( str=="keksi" )
  {
    write( BS(
      "Voller Genuss beisst Du in das Keksi rein und die Broesel stauben "
      "nur so um Dich herum. *lecker* Das macht Gusto auf mehr!") );
    say(
      TPN+" mampft genuesslich an einem Keksi.\n" );
    bisse--;
    if( bisse == 0 )
    {
      write(
	"Leider war das der letzte Biss.\n" );
       TO->remove();
    }
    return 1;
  }
}