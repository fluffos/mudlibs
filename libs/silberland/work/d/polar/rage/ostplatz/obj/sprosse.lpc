// Sprosse fuer Leiter
// Filename: sprosse.c
// File by Rage, Januar 02

inherit "std/thing";

#include "../def.h"

void create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Eine einfache Holzsprosse" );
  SetProp( P_LONG,
    "Die Holzsprosse ist einfach gehalten. Sie ist ungefaehr fuenf Zentimeter "
    "dick und etwa 40 lang. Die letzten Zentimeter der beiden Enden sind "
    "ein wenig duenner, damit man sie in einen anderen Gegenstand stecken "
    "kann." );
  SetProp( P_NAME, "Sprosse" );
  SetProp( P_GENDER, FEMALE );
  SetProp( P_INFO,
    "Diese Sprosse kann man sicher zwischen zwei Holme einer Leiter stecken." );

//DETAILS
  AddDetail( "zentimeter",
    "Die Sprosse ist eben etwa fuenf Zentimeter dick und etwa 40 lang." );
  AddDetail( ({ "enden","ende" }),
    "Die Enden der Sprosse sind eindeutig duenner, womit man sie bestimmt "
    "irgendwo hineinstecken kann." );
  AddDetail( "gegenstand",
    "Das wirst Du wohl am besten selbst wissen, wo man Sprossen braucht." );
//END DETAILS

  AddId( ({ "leitersprosse","holzsprosse","sprosse","\nleitersprosse" }) );
  SetProp( P_MATERIAL, MAT_FIR );
  SetProp( P_WEIGHT, 700 );
  SetProp( P_VALUE, 10 );
  SetProp( P_NOBUY, 1 );
}