// Huskyfell: Fell von Husky
// Filename: huskyfell.c
// File by Rage, Februar 03

inherit "std/armour";

#include "../def.h"
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp( P_SHORT, "Ein Huskyfell" );
  SetProp( P_LONG, 
    "Dieses weisse, zottelige Fell kann Dich sicher gut bei Kaelte "
    "schuetzen, denn es wurde einmal einem Husky abgenommen." );
  SetProp( P_NAME, "Huskyfell" );
  SetProp( P_GENDER, NEUTER );
  AddId (({ "fell","huskyfell" }));
  
  SetProp( P_ARMOUR_TYPE, AT_CLOAK );
  SetProp( P_AC, 6 );
  SetProp( P_MATERIAL, ([MAT_PELT:100]) );
  SetProp( P_WEIGHT, 800 );
  SetProp( P_VALUE, 450 );
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5, T_HEAT_PROT:0]) );
}