// Gestrickter Schal
// Filename: strickschal.c
// File by Rage Sep02

inherit "std/armour";

#include "../def.h"
#include <combat.h>

void create()
{
  string farbe;

  if(!is_clone(TO)) return;
  ::create();
 
  farbe=({ "schwarz","weiss","grau","dunkelbraun","hellbraun" })[random(5)];
  SetProp( P_SHORT, "Ein "+farbe+"er Strickschal");
  SetProp( P_LONG,
    "Das ist ein kuschliger, "+farbe+"er Schal, der aus Schafswolle "
    "gestrickt wurde und Dich sicher im Winter oder kalten Gebieten waermen "
    "wird." );
  SetProp( P_NAME, "Strickschal" );
  SetProp( P_NAME_ADJ, farbe );
  SetProp( P_GENDER, MALE);
  AddAdjective( ({farbe+"er", farbe+"en"}) );

//DETAILS
  AddDetail( "winter",
    "Im Winter ist es zumeist kalt und da kann ein solcher Schal nicht "
    "schaden." );
  AddDetail( ({ "gebiete","polar" }),
    "Polar ist ganz bestimmt ein kaltes Gebiet." );
  AddDetail( ({ "wolle","schafswolle" }),
    "Der Schal ist aus Schafswolle, die sicher dafuer sorgt, dass Du es "
    "schoen warm hast, wenn Du ihn Dir um den Hals wickelst." );
  AddDetail( "hals",
    "Der Schal ist - wohl wie viele seiner Sorte - dazu gedacht, ihn sich um "
    "den Hals zu wickeln." );
  AddDetail( ({ "sorte","sorten" }),
    "Es gibt viele verschiedene Sorten von Schals. Dieser ist gestrickt und "
    "aus Schafswolle." );
//ENDDETAILS

  AddId( ({"schal", "strickschal","\nSTRICKSCHAL"}) );
  SetProp( P_ARMOUR_TYPE, AT_AMULET );
  SetProp( P_AC, 1);
  SetProp( P_MATERIAL, MAT_WOOL );
  SetProp( P_WEIGHT, 90 );
  SetProp( P_VALUE, 20 );
  SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:5, T_HEAT_PROT:-3 ]) );
  SetProp( P_WEAR_TEXT, ({
    "Du wickelst Dir %s um den Hals.\n",
    " wickelt sich %s um den Hals.\n"
                         }) );
  SetProp( P_UNWEAR_TEXT, ({
    "Du wickelst Dir %s vom Hals.\n",
    " wickelt sich %s vom Hals.\n"
                         }) );
}