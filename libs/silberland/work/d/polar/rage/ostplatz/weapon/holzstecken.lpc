// Holzstecken (Teil fuer Speer)
// Filename: holzstecken.c
// File by Rage Februar 00

inherit "std/weapon";

#include "../def.h"
#include <combat.h>
#include <moving.h>

nosave int verbunden;

create()
{
  if ( !is_clone(TO) ) return;
  ::create();
  verbunden = 0;

  SetProp( P_SHORT, "Ein Holzstecken" );
  SetProp( P_LONG,
    "Dieser Stecken sieht aus wie jeder gewoehnliche Stock aus Holz. Das eine "
    "Ende scheint allerdings doch anders zu sein. Ein Unterschied faellt Dir "
    "schon auf: Der Holzstecken liegt besonders gut in der Hand." );
  SetProp( P_INFO,
    "Wenn Du nicht weisst, was Du mit diesem Gegenstand anfangen sollst, dann "
    "hilft Dir sicher Yrdaret weiter." );
  SetProp( P_NAME, "Holzstecken" );
  SetProp( P_GENDER, MALE );

//DETAILS
  AddDetail( ({ "holz" }),
    "Aus Deinen Fachkenntnissen zu schliessen, meinst Du, dass es sich um "
    "Fichte handeln muesste." );
  AddDetail( ({ "ende" }),
    "Das Ende hat ein Loch, das etwa 3 Zentimeter ins Holz reingeht und einen "
    "Durchmesser von 1 Zentimeter hat." );
  AddDetail( ({ "loch" }),
    "Sauber ausgearbeitet. Das ist sicher nicht zufaellig entstanden. Ob da "
    "was reingehoert?" );
  AddDetail( ({ "zentimeter" }),
    "Wenn Du es genau wissen willst, so ist der Stecken 150 Zentimeter lang "
    "und hat einen Durchmesser von 4 Zentimeter." );
  AddDetail( ({ "durchmesser" }),
    "Dieser betraegt vier Zentimeter." );
//END DETAILS

  AddId( ({ "stecken","holzstecken","\nholzstecken","QUESTOBJ" }) );
  SetProp( P_MATERIAL, MAT_WOOD );
  SetProp( P_WEIGHT, 500 );
  SetProp( P_VALUE, 0 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NODROP, "Den Stecken gibst Du sicher nicht her.\n" );
  SetProp( P_NEVERDROP, 1 );
  SetProp( P_NOSELL, 1 );
  SetProp( P_ITEMD_NO_MAGIC, 1 );

  SetProp( P_WEAPON_TYPE, WT_CLUB );
  SetProp( P_WC, 40 );
  SetProp( P_DAM_TYPE, DT_BLUDGEON );
  SetProp( P_NR_HANDS, 2 );

  SetProp( P_SMELL, "Eigenartig, er riecht ganz leicht nach Fisch.\n" );
}

verbunden()
{
  SetProp( P_SHORT, "Ein Holzstecken mit einer Elfenbeinspitze" );
  SetProp( P_LONG, "Im Holzstecken steckt jetzt an einem Ende das "
                   "Elfenbeinstueck. ");
  SetProp( P_HIT_FUNC, TO );
  verbunden = 1;

  AddDetail( "ende",
    "Dort, wo vorher noch das Loch war, steckt jetzt das Elfenbeinstueck drin. "
    "Schaut allerdings nicht so aus, als ob das von allein da drinbleibt." );
  AddDetail( ({ "elfenbeinspitze","spitze" }),
    "Sie wackelt einwenig im Loch. Vielleicht solltest doch noch etwas machen, "
    "damit sich das aendert.");
  AddDetail( "loch",
    "Der Holzstecken hat nun kein Loch mehr, weil das Elfenbeinstueck drin "
    "steckt." );
}

zusammengesteckt()
{
  return verbunden;
}

int HitFunc(object enemy)
{
  if ( !random(8) )
  {
    tell_object( TP,
      "Das hast Du nun davon! Das Elfenbeinstueck ist nun mitten im Kampf "
      "verloren\n"
      "gegangen, weil Du es nicht richtig festgemacht hast.\n");
    tell_room( ENV(TP),
      TP->Name()+" flucht ziemlich stark.\n", ({ TP }) );
    verbunden = 0;

    SetProp(P_SHORT, "Ein Holzstecken");
    SetProp(P_LONG,
      "Dieser Stecken sieht aus wie jeder gewoehnliche Stock aus Holz. Das "
      "eine Ende scheint allerdings doch anders zu sein." );

    AddDetail( ({ "holz" }),
      "Aus den Fachkenntnissen zu schliessen, meinst Du, dass es sich um "
      "Fichte handeln muesste.");
    AddDetail( ({ "ende" }),
      "Das Ende hat ein Loch, das etwa 3 Zentimeter ins Holz reingeht und "
      "einen Durchmesser von 1 Zentimeter hat.");
    AddDetail( ({ "loch" }),
      "Sauber ausgearbeitet. Das ist sicher nicht zufaellig entstanden. Ob da "
      "was reingehoert?");
    AddDetail( ({ "zentimer" }),
      "Wenn Du genau wissen willst, so ist der Stecken 150 Zentimeter lang "
      "und hat einen Durchmesser von 4 Zentimeter.");
    RemoveDetail( ({ "elfenbeinspitze","spitze" }) );
  }
  return 0;
}