// Teppichklopfer
// Filename: klopfer.c
// File by Rage, August 00


inherit "std/weapon";

#include "../def.h"
#include <combat.h>
#include <moving.h>

create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Teppichklopfer" );
  SetProp( P_LONG,
    "Ein Teppichklopfer wie man ihn vom Teppich klopfen kennt. Er besteht "
    "aus Holzfasern, mit denen er geflochten wurde. Sein Griff ist aehnlich "
    "gedreht wie ein Seil, das aus vielen Schnueren besteht, und der Kopf "
    "sieht wie ein ueberdimensionales dreiblaettriges Kleeblatt aus." );
  SetProp( P_INFO,
    "Mit dem Klopfer kann man nicht nur Teppiche klopfen, sondern auch einem "
    "Gegner eine pracken." );
  SetProp( P_NAME, "Teppichklopfer" );
  SetProp( P_GENDER, MALE );

//DETAILS
  AddDetail( ({ "holz","holzart","balsa","balsaholz" }),
    "Vom Gewicht her zu urteilen, meinst Du, dass der Teppichklopfer aus "
    "Balsaholz gefertigt wurde." );
  AddDetail( ({ "holzfasern","fasern" }),
    "Die Fasern schlaengeln sich ueber unterschiedlichste Windungen ueber den "
    "ganzen Klopfer. Und irgendwie haelt das ganze scheinbar recht gut "
    "zusammen, womit Du Teppiche und aehnliches damit klopfen bzw. pracken "
    "kannst." );
  AddDetail( ({ "windung","windungen" }),
    "Die Fasern sind so gewunden, dass sie oben drei Schlaufen und unten "
    "einen Griff bilden." );
  AddDetail( ({ "schlaufen","kopf" }),
    "Der Kopf besteht aus drei Schlaufen, die dafuer sorgen, dass der Staub "
    "aus den Teppichen verschwindet, vorausgesetzt, man haut selbst "
    "ordentlich damit zu." );
  AddDetail( "griff",
    "Der Griff wurde aus Holzfasern gedreht und ist so dick, dass man mit dem "
    "Klopfer ordentlich klopfen kann." );
  AddDetail( ({ "blatt","kleeblatt" }),
    "Der Kopf des Teppichklopfers hat eine gewisse Aehnlichkeit mit einem "
    "Kleeblatt. Ob er Dir Glueck bringen mag?" );
//END DETAILS

  AddId( ({ "pracker","klopfer","teppichklopfer","\nklopfer" }) );
  SetProp( P_MATERIAL, MAT_WOOD );
  SetProp( P_WEIGHT, 300 );
  SetProp( P_VALUE, 50 );
  SetProp( P_ITEMD_NO_MAGIC, 1 );

  SetProp( P_WEAPON_TYPE, WT_CLUB );
  SetProp( P_WC, 40 );
  SetProp( P_DAM_TYPE, DT_BLUDGEON );
  SetProp( P_NR_HANDS, 1 );

  AddCmd( ({ "klopf","klopfe","prack","pracke" }), "cmd_klopfen" );
}

//COMMANDS
cmd_klopfen(string str)
{
  object ob, fell;
  string was;
  	
  notify_fail( "Was willst Du ausklopfen?\n" );

  if ( !str || str == "" ) return 0;
  if ( sscanf( str, "%s aus", was) != 1 ) return 0;

  if ( ENV(TP)->fell_da() )
  {
    if ( member( ({ "raeudiges wolfsfell","raeudiges fell",
                    "wolfsfell","fell"
                  }), was) != -1 )
    {
      if ( ENV(TP)->fell_zustand() )
      {
        write( BS(
          "Du holst mit dem Teppichklopfer aus und klopfst das Wolfsfell "
          "auf dem Zaun durch. Es staubt maechtig bei jedem Schlag von Dir, "
          "aber nach "+(random(100)+10)+" Schlaegen hast Du es geschafft. "
          "Du bist sehr stolz auf Dich, dass Du ganz allein ein Wolfsfell "
          "ausgeklopft hast.") );
        say( BS(
          "Aus unerklaerlichen Gruenden entsteht ploetzlich eine grosse "
          "Staubwolke. Nach kurzer Zeit verzieht sie sich und Du siehst "
          "die Ursache. "+TPN+" hat gerade ein Wolfsfell mit einem "
          "Teppichklopfer ausgeklopft.") );
        ENV(TP)->saubergemacht();  
        return 1;
      }
      write( BS(
        "Das Fell auf dem Lattenzaun ist doch schon sauber. Ein weiteres Mal "
        "braucht es nicht ausgeklopft zu werden.") );
      return 1;
    }
  }
  ob = present(was, TP);
  if ( !ob )
  {
    write( BS(
      "Du kannst nur Sachen ausklopfen, die Du bei Dir hast!") );
    return 1;
  }
  if ( ob->id("raeudiges wolfsfell") )
  {
    write( BS(
      "Du holst mit dem Teppichklopfer aus und versuchst das Fell "
      "auszuklopfen, was allerdings nicht nach Wunsch klappt. Da Du mit "
      "einer Hand das Fell haeltst und mit der anderen den Teppichklopfer, "
      "wickelt sich das Fell bei jedem Klopfen ueber Deinen Unterarm. Es "
      "waere besser, das Fell vorher irgendwo aufzuhaengen oder "
      "drueberzulegen.") );
    say( BS(
      TPN+" versucht ein Fell mit einem Teppichklopfer auszuklopfen, "
      "aber es wickelt sich beim Zuschlagen um "+
      TP->name(WESSEN)+" Arm.") );
    return 1;
  }
  write( BS(
    CAP(ob->name(WEN))+" auszuklopfen macht keinen Sinn. Klopfe besser "
    "etwas anderes aus!") );
  return 1;
}
