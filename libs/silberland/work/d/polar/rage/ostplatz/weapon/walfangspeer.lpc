// Walfangspeer
// Filename: walfangspeer.c
// File by Rage, Februar 00

inherit "std/weapon";

#include "../def.h"
#include <combat.h>
#include <moving.h>

create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  SetProp( P_SHORT, "Ein Walfangspeer" );
  SetProp( P_LONG,
    "Ein Speer, wie er fuer den Walfang nicht besser sein koennte. Die "
    "Schnitzereien des Elfenbeinstuecks haben nur den Zweck, als Widerhaken "
    "zu dienen." );
  SetProp( P_INFO,
    "Der Speer ist sicher nicht nur zum Zustechen oder schlagen gedacht, man "
    "kann ihn sicher auch gut werfen." );
  SetProp( P_NAME, "Walfangspeer" );
  SetProp( P_GENDER, MALE );

//DETAILS
  AddDetail( ({ "elfenbeinstueck" }),
    "Das sitzt ganz fest, da Du es mit einem Lederband am dem Holzstecken "
    "befestigt hast." );
  AddDetail( ({ "lederband" }),
    "Es sorgt dafuer, dass das Elfenbeinstueck im Holzstecken bleibt." );
  AddDetail( ({ "holzstecken" }),
    "Der ist wohl dazu da, damit Du die Waffe auch halten kannnst." );
  AddDetail( ({ "schnitzerei","schnitzereien" }),
    "Sie sind nicht nur schoen, sondern auch gefaehrlich, insbesondere fuer "
    "Wale." );
  AddDetail( ({ "widerhaken" }),
    "Wenn diese Spitze einmal in die dicke Haut der Wale eingedrungen ist, "
    "geht sie sicher nicht mehr leicht raus.");
//END DETAILS

  AddId( ({ "speer","walfangspeer","\nwalfangspeer","QUESTOBJ" }) );
  SetProp( P_MATERIAL, ([MAT_WOOD:89, MAT_LEATHER:2, MAT_IVORY:9]) );
  SetProp( P_WEIGHT, 560 );
  SetProp( P_VALUE, 0 );
  SetProp( P_NOBUY, 1 );
  SetProp( P_NOSELL, 1 );

  SetProp( P_WEAPON_TYPE, WT_CLUB );
  SetProp( P_WC, 40 );
  SetProp( P_DAM_TYPE, DT_BLUDGEON );
  SetProp( P_NR_HANDS, 1 );
}