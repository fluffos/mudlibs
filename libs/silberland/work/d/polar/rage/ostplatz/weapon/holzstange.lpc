// Holzstange, zum Austauschen bei Laden
// soll gleichzeitig ein "versteckter" Quarterstaff sein
// Filename: holzstange.c
// File by Rage, Maerz 02

inherit "std/weapon";

#include "../def.h"
#include <combat.h>
#include <moving.h>

int angeknackst;
int muster_gefunden;
int stange_nass;

create()
{
  if ( !is_clone(TO) ) return;
  ::create();

  angeknackst = 0;
  muster_gefunden = 0;
  stange_nass = 1;

  SetProp( P_SHORT, "Eine Holzstange" );
  SetProp( P_LONG,
    "Diese Stange aus Holz scheint nichts weiter zu sein als ein "
    "staerkerer Ast, der eines Tages von einem Baum abgehackt worden ist. "
    "Sie ist etwa zwei Meter lang, wirkt sehr stabil und ist - nebenbei "
    "erwaehnt - ziemlich nass." );
  SetProp( P_NAME, "Holzstange" );
  SetProp( P_GENDER, FEMALE );
  
//DETAILS
  AddDetail( ({ "holz","fichtenholz" }),
    "Als Du Dir die Maserung des Holzes naeher ansiehst und das Gewicht "
    "in Deiner Hand abwaegst, bist Du fest davon ueberzeugt, dass Du "
    "eine Stange aus Fichtenholz in Haenden haeltst." );
  AddDetail( "ast",
    "Die Stange ist, um genau zu sein, nichts anderes als ein staerkerer "
    "Ast. Dieser scheint allerdings sehr stabil zu sein." );
  AddDetail( "baum",
    "Du haeltst nur einen Teil eines Baumes in der Hand, naemlich einen "
    "langen Ast." );
  AddDetail( "meter",
    "Etwa zwei Meter wird die Stange schon lang sein." );
  AddDetail( "maserung",
    "Du versuchst, Dir die Maserung genauer anzusehen, aber nachdem die "
    "Stange noch immer so nass ist, kannst Du mit Sehen allein nicht "
    "viel erkennen." );
  AddSpecialDetail( ({ "maserung genauer","muster genauer" }),
                       "detailMuster" );
  
//END DETAILS

  AddId( ({ "stange","holzstange","\nholzstange" }) );
  SetProp( P_MATERIAL, MAT_FIR );
  SetProp( P_WEIGHT, 1500 );
  SetProp( P_VALUE, 200 );
  SetProp( P_SIZE, 180+random(30) );

  SetProp( P_WEAPON_TYPE, WT_CLUB );
  SetProp( P_WC, 80 );
  SetProp( P_DAM_TYPE, DT_BLUDGEON );
  SetProp( P_NR_HANDS, 2 );
  SetProp( P_HIT_FUNC, TO );

  AddCmd( ({ "streif","streife" }), "cmd_streifen" );
  AddCmd( ({ "fuehl","fuehle","spuer","spuere" }), "cmd_fuehlen" );
}
//SPECIAL DETAILS
string detailMuster()
{
  tell_room( ENV(TP),BS(
      TPN+" schaut so intensiv eine Holzstange an, die "+
      TP->QueryPronoun(WER)+" in "+TP->QueryPossPronoun(FEMALE, WEM)+" Hand "
      "haelt, dass es so aussieht, als ob "+TP->QueryPronoun(WER)+" durch "
      "sie hindurchsehen koennte."), ({ TP }) );
  return BS(
    "Du musst ziemlich neugierig sein, dass Du Dir die Maserung so "
    "genau ansiehst, aber mit Sehen wirst Du trotz genauerster "
    "Betrachtung nicht weiterkommen. Versuch es besser mit anderen "
    "Sinneswahrnehmungen." );
}

//END SPECIAL DETAILS

schlechter_Zustand()
{
  SetProp( P_SHORT, "Eine angeknackste Holzstange" );
  SetProp( P_LONG,
    "Diese Holzstange hat einen Sprung und wird im Kampf nicht lange "
    "halten." );
  SetProp( P_VALUE, 50 );
  SetProp( P_WC, 50 );
  Damage(20);
  angeknackst = 1;
}

guter_Zustand()
{
  SetProp( P_SHORT, "Eine Holzstange" );
  SetProp( P_LONG,
    "Diese Stange aus Holz scheint nichts weiter zu sein als ein "
    "staerkerer Ast, der eines Tages von einem Baum abgehackt worden ist. "
    "Sie ist etwa zwei Meter lang, wirkt sehr stabil und ist nebenbei "
    "erwaehnt ziemlich nass." );
  SetProp( P_VALUE, 200 );
  SetProp( P_WC, 80 );
  angeknackst = 0;
}

int Stange_kaputt()
{
  return angeknackst;
}

//COMMANDS
int cmd_streifen(string str)
{
  notify_fail ( "Worueber willst Du mit Deinen Fingern streifen?\n" );

  if ( !str || str=="" ) return 0;
  if ( member( ({ "stange","holzstange","ast","oberflaeche" }),str) != -1 )
  {
    write( BS(
      "Du streifst mit Deinen Finger ueber die Oberflaeche der Holzstange "
      "und erkennst nicht nur, dass das Holz eindeutig Fichtenholz sein "
      "muss, sondern dass die Maserung bestimmte Muster aufweist.") );
    return 1;
  }
  else if ( member( ({ "muster","maserung" }),str) != -1 )
  {
    write( BS(
      "Du streifst mit Deinen Fingern ueber das Muster der Maserung und "
      "hast das Gefuehl, dass da mehr dahinterstecken koennte. Doch Du "
      "muesstest schon irgendwie das Muster noch genauer untersuchen.") );
    return 1;
  }
}

int cmd_fuehlen(string str)
{
  object wem, pulsgemessener;
  string was;

  notify_fail( "Was außer Deinem Puls moechtest Du fuehlen?\n" );

  if ( !str || str=="" ) return 0;
  if ( str == "puls" )
  {
    write( BS(
      "Voll gespannt fuehlst Du Deinen eigenen Puls und kommst drauf, dass "
      "Du im Moment einen von "+(50+random(100))+" hast. Es waere bestimmt "
      "interessant zu wissen, welchen Puls andere Leute haben.") );
    say(
      TPN+" fuehlt "+TP->QueryPossPronoun(MALE,WEN)+" eigenen Puls.\n" );
    return 1;
  }
  else if ( member( ({ "maserung","muster" }),str) != -1 )
  {
    if ( (TP->QueryAttribute(A_INT)+random(20)) > 25 )
    {
      write( BS(
        "Du ziehst mit Deinem Finger die Muster auf der Holzstange nach "
        "und bist davon ueberzeugt, ein paar Runen erkannt zu haben.") );
      muster_gefunden = 1;
      return 1;
    }
    write( BS(
      "Du ziehst mit Deinem Finger die Muster auf der Holzstange nach, "
      "kannst allerdings nichts weiter erkennen.") );
    return 1;
  }
  else if ( member( ({ "rune","runen" }),str) != -1 )
  {
    if ( muster_gefunden && stange_nass )
    {
      write( BS(
        "Du weisst mit Sicherheit, dass es Runen sein muessen, aber die "
        "Holzstange ist noch zu nass und zu schmutzig, um mehr zu "
        "erkennen. ") );
      return 1;
    }
    write( BS(
      "Es sind tatsaechlich Runen auf der Holzstange, doch leider kannst Du "
      "sie nicht entziffern, aber vielleicht hilft Dir ja jemand weiter.") );
    return 1;
  }
  else if ( sscanf(str,"%s von %s",was,wem) == 2 )
  {
    if ( was == "puls" )
    {
      pulsgemessener = find_living(wem);
      if ( present(wem,ENV(TP)) )
      {
        if ( pulsgemessener == TP )
        {
          write( BS(
            "Voll gespannt fuehlst Du Deinen eigenen Puls und kommst drauf, "
            "dass Du im Moment einen von "+(50+random(100))+" hast.") );
          say(
            TPN+" fuehlt "+TP->QueryPossPronoun(MALE,WEN)+" eigenen Puls.\n" );
          return 1;
        }
       	write( BS(
      	  "Du fuehlst den Puls von "+pulsgemessener->Name(WEM)+" und "
      	  "stellst fest, dass "+pulsgemessener->QueryPronoun(WER)+" einen "
      	  "von "+(50+random(100))+" hat.") );
      	tell_object( pulsgemessener,
      	  TPN+" kommt zu Dir und misst Dir den Puls.\n" );
      	tell_room(ENV(TP),
      	  TPN+" geht zu "+pulsgemessener->Name(WEM)+" und misst "+
      	  pulsgemessener->QueryPossPronoun(MALE,WEN)+" Puls.\n",
      	  ({ pulsgemessener,TP }) );
      	return 1;
      }
      write( BS(
        "Du kannst nur von Personen den Puls fuehlen, die sich im selben "
        "Raum wie Du selbst befinden.") );
      return 1;
    }
  }
}

//END COMMANDS

int HitFunc(object enemy)
{
  if ( angeknackst && !random(5) )
  {
    tell_object( TP,
      "Die Holzstange zerbricht Dir mitten im Kampf, weshalb Du sie, weil "
      "sie nun unbrauchbar ist, wegwirfst.\n");
    tell_room( ENV(TP),
      TP->Name(WESSEN)+" Waffe zerbricht mitten im Kampf, worauf "+
      TP->QueryPronoun(WER)+" wegwirft.\n", ({ TP }) );
    call_out( "waffe_weg", 0 );
  }
}
void waffe_weg()
{
  remove(1);
}

//Stange ist ein Quarterstaff von 6 der ehemaligen Eismagier
//Eismagier am Platz erzaehlt einem mehr darueber
//durch reinstecken von Magiepunkten sollen ein paar Eissprueche moeglich sein