//Osterweiterung des Xandimdorf, Rage Feb 00

inherit "std/room";
inherit "d/polar/rage/ostplatz/room/rundgang";

#include "../def.h"
#include <combat.h>

int silber_da;
int exit_test();

void create()
{
  ::create();

  silber_da = random(2);

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Du bist nun auf der Rueckseite des Felladens angelangt. Viel Aufregendes "
    "faellt Dir nicht auf, ausser der zwei Meter breiten Eisflaeche, die von "
    "Westen nach Osten verlaeuft. Du musst schon fast aufpassen, dass Du nicht "
    "darauf ausrutscht, denn zwischen Rueckwand und Holzpalisade sind nur drei "
    "Meter Platz. Du hast auf alle Faelle schon interessantere Plaetze als "
    "diesen gesehen, und sich lange hier aufzuhalten lohnt sicher nicht, oder "
    "etwa doch?" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -8]) );

//DETAILS
  AddDetail( "himmel",
    "Du siehst zwar nur einen drei Meter Streifen davon, da Dein Blick durch "
    "das Dach des Ladens beeintraechtigt wird, doch dieser strahlt dafuer in "
    "einem wundervollen blau." );
  AddDetail( "blick",
    "Dein Blick nach oben wird durch das vorstehende Dach stark "
    "beeintraechtigt. Das soll Dich aber nicht daran hindern, dich trotzdem "
    "ein bisschen umzusehen." );
  AddDetail( ({ "himmelsstreifen","streifen" }),
    "Vom Himmel siehst Du nur einen schmalen Streifen, da Du unter dem "
    "Dach der Huette stehst. Der Himmelsstreifen ist genau so blau wie der "
    "Rest vom Himmel." );
  AddDetail( ({ "dach","vordach" }),
    "Das Dach wird wie die Waende aus Baumstaemmen gebildet. Sie stehen ueber "
    "der Rueckwand drueber, womit Du unter einem Teil vom Dach stehst." );
  AddDetail( ({ "baumstaemme","baumstamm" }),
    "Durch das Uebereinanderlegen der Baumstaemme ist diese Rueckwand vor Dir "
    "entstanden. Sie sind alle aus Fichtenholz, wie so manches auf dem "
    "Ostplatz." );
  AddDetail( "uebereinanderlegen",
    "Ein Baumstamm wurde jeweils auf den vorigen gelegt." );
  AddDetail( "teil",
    "Ein Teil vom Dach steht ueber die Rueckwand drueber. Du kannst auch "
    "Vordach dazu sagen." );
  AddDetail( ({ "huette","blockhuette" }),
    "Von der Huette wirst Du nicht mehr als Rueckwand sehen, wenn Du ewig "
    "hier stehen bleibst. Aufgrund der Uebereinanderstapelung von "
    "Baumstaemmen weisst Du, dass es sich um eine Blockhuette handelt." );
  AddDetail( ({ "uebereinanderstapelung","stapelung" }),
    "Das kann ich Dir ganz einfach erklaeren. Baumstaemme werden "
    "uebereinander gestapelt, daher die Bezeichnung." );
  AddDetail( ({ "bezeichnung","bezeichnungen" }),
    "Dingen einen Namen geben." );
  AddDetail( ({ "dinge","ding" }),
    "Jedes Ding hat einen Namen. Ein paar davon habe ich selbst erfunden, "
    "falls Du Dich wundern solltest, wieso Du nicht alle Bezeichnungen "
    "gleich verstehst." );
  AddDetail( ({ "name","namen" }),
    "Du heisst "+TPN+"." );
  AddDetail( "rest",
    "Der Rest vom Himmel ist genauso blau wie dieser Himmelsstreifen. Wenn Du "
    "mir nicht glauben solltest, dann schau ihn Dir einfach anderswo an." );
  AddDetail( "boden",
    "Am Boden fuehrt eine zwei Meter breite Eisflaeche von Westen nach Osten. "
    "Daneben liegt wie ueberall auf dem Ostplatz eine dicke Schneeschicht, in "
    "der Du nur vereinzelte Spuren sehen kannst, und Du wunderst Dich ein "
    "bisschen, wieso es nicht mehrere gibt. Vielleicht findest Du den Grund "
    "noch heraus." );
  AddDetail( "grund",
    "Noch kennst Du den Grund nicht, weshalb neben der Eisflaeche keine "
    "Spuren sind, aber Du gibst noch nicht auf. Du wirst sicher irgendwann "
    "draufkommen." );
  AddDetail( "ostplatz",
    "Du bist nachwievor auf dem Ostplatz von Yiqanuc. Um genau zu sein, stehst "
    "Du hinter dem Felladen." );
  AddDetail( "schneeschicht",
    "Auch hinter dem Laden liegt eine dicke Schneeschicht, die nur an manchen "
    "Stellen durch Deine ungeschickten Bewegungen zusammengedrueckt wurde. "
    "Direkt neben der Eisflaeche ist sie" );
  AddDetail( "bewegungen",
    "Durch Dein staendiges auf- und abgehen hast Du natuerlich die neue "
    "Schneeschicht zusammengedrueckt." );
  AddDetail( "stellen",
    "Die Stellen im Schnee lassen sich auch als Deine eigene Spur "
    "bezeichnen." );
  AddDetail( "spur",
    "Welche Spur willst Du Dir im speziellen ansehen?" );
  AddSpecialDetail( "eigene spur", "detailEigenespur" );
  AddSpecialDetail( ({ "abdruck","abdruecke" }), "detailAbdruck" );
  AddSpecialDetail( ({ "schnee","pulverschnee" }),"detailSchnee" );
  AddDetail( "spuren",
    "Neben der Eisflaeche sind nur wenige Spuren im Schnee zu sehen. Die "
    "meisten stammen von Dir, naemlich durch Dein staendiges Auf- und "
    "Abgehen. Komischerweise kannst Du keine Spuren von den Xandim sehen." );
  AddDetail( ({ "abgehen","aufgehen" }),
    "Durch Deine viele Spuren, die Du im Schnee hinterlaesst, weisst Du, dass "
    "Du auf- und abgehst." );
  AddDetail( ({ "xandimspuren","xandimspur" }),
    "Du untersuchst den ganzen Boden neben der Eisflaeche und willst sogar "
    "auf der Eisflaeche nach Xandimspur suchen, als Du ploetlich beinahe "
    "ueber eine Schnur stolperst. Xandimspuren hast Du trotzdem keine "
    "gefunden." );
  AddDetail( "rueckseite",
    "Du schaust Dich momentan auf der Rueckseite des Felladens um, und "
    "dementsprechend wunderst Du Dich auch nicht, dass Du von diesem nur die "
    "Rueckwand sehen kannst." );
  AddDetail( "rueckwand",
    "Die Rueckwand des Felladens sieht gleich wie alle Waende einer "
    "Blockhuette aus. Sie besteht aus mehreren Lagen Baumstaemme, an deren "
    "Enden die Baumstaemmen der Seitenwaende ein kleines Stueck drueber "
    "stehen. Nein, nein, das brauchst Du keinem zu melden; ich versichere "
    "Dir, dass das so gehoert." );
  AddDetail( ({ "enden","ende" }),
    "Die Enden stehen ein kleines Stueck ueber die Rueckwand und koennten "
    "Dir so das Klettern auf das Dach ermoeglichen." );
  AddDetail( "klettern",
    "Das sollst Du nicht untersuchen, sondern machen." );
  AddDetail( ({ "lagen","reihen" }),
    "Jede Wand der Blockhuette besteht aus mehreren Lagen Baumstaemme." );
  AddDetail( "stueck",
    "Die Seitenwaende stehen an der Rueckwand ein kleines Stueck drueber "
    "und die Rueckwand steht genauso an den Seitenwaende drueber. Wenn "
    "man geschickt anstellt, kann man das sicher dazu ausnuetzen, auf das "
    "Dach der Huette zu klettern." );
  AddDetail( "seitenwaende",
    "Von den Seitenwaenden siehst Du nur deren Enden, die ein Stueck ueber "
    "die Rueckwand ragen." );
  AddDetail( ({ "waende","wand" }),
    "Die Waende einer Blockhuette sehen sich alle aehnlich. Baumstamm fuer "
    "Baumstamm wurde aufeinander gelegt und die Summe dieser Lagen bildet "
    "eine Wand." );
  AddDetail( "summe",
    "Aus der Summe der uebereinander gelegten Baumstaemme ergibt sich eine "
    "Wand." );
  AddDetail( ({ "felladen","fellladen" }),
    "Da Du Dich gerade auf der Rueckseite des Felladens aufhaelst, kannst "
    "Du nicht viel erkennen. Im Felladen selbst ist bestimmt mehr los als "
    "dahinter." );
  AddDetail( "aufregendes",
    "Wenn nicht einmal die Eisflaeche da waere, meintest Du, dass es ein "
    "langweiliges Fleckchen waere." );
  AddDetail( "fleckchen",
    "Bis auf die Eisflaeche, die vor Dir vorbeilaeuft, ist das Fleckchen, auf "
    "dem Du stehst, ziemlich langweilig. Geh am besten gleich weiter." );
  AddDetail( "meter",
    "Drei Meter entspricht in etwa dem Abstand von der Rueckwand des "
    "Felladens bis zu der Holzpalisade. Zwei Meter davon werden von der "
    "Eisflaeche am Boden in Anspruch genommen." );
  AddDetail( "anspruch",
    "Die Eisflaeche nimmt zwei von den drei Meter am Boden in Anspruch." );
  AddDetail( "eisflaeche",
    "Die Eisflaeche verlaeuft parallel zur Holzpalisade, geht westlich und "
    "oestlich von Dir weiter und ist gute zwei Meter breit." );
  AddDetail( "westen",
    "Du verfolgst den Verlauf der Eisflaeche und blickst nach Westen. Sie "
    "scheint ihren Anfang kurz vor der Eispalisade zu haben, und genau dort "
    "stehen mehrere Xandim." );
  AddDetail( "anfang",
    "Der Anfang der Eisflaeche ist um vieles weiter im Westen, knapp vor "
    "der Eispalisade." );
  AddDetail( "xandim",
    "Weiter im Westen am Anfang der Eisflaeche stehen ein paar Xandim "
    "beisammen. Ausserdem steht ein Stueckchen weiter im Osten ein Mann auf "
    "der Eisflaeche mit einem Stock in der Hand." );
  AddDetail( "hand",
    "Der Mann im Osten haelt den Stock mit seiner Hand." );
  AddDetail( "stock",
    "Der Mann auf der Eisflaeche haelt einen Stock in der Hand, den er mal "
    "kurz auf die Eisflaeche aufsetzt und dann gleich wieder wegnimmt." );
  AddDetail( ({ "mann","xandimmann" }),
    "Ein maennlicher Xandim steht am Ende der Eisflaeche und stellt seinen "
    "Stock hin und wieder darauf ab. Wahrscheinlich ist er so alt, dass er "
    "sich damit stuetzen muss, aber wieso steht er ausgerechnet auf der "
    "Eisflaeche, wo man so leicht ausrutschen kann. Komisch, komisch." );
  AddDetail( "stueckchen",
    "Geh doch nach Osten, dann hast Du dieses kleine Stueckchen ueberwunden." );
  AddDetail( "osten",
    "Den Verlauf der Eisflaeche folgenend schaust Du nach Osten. In der "
    "suedostlichen Ecke der Holzpalisade hat sie wohl ihr Ende. Dort betritt "
    "auch hin und wieder ein Mann die Eisflaeche mit einem Stock und haelt "
    "diesen auf die Eisflaeche. Du denkst . o O (die Xandim werde ich nie "
    "verstehen." );
  AddDetail( "holzpalisade",
    "Die Holzpalisade besteht aus einer grossen Anzahl von Pfaehlen, die "
    "nebeneinander in den Boden gerammt wurden und mit zahlreichen Seilen "
    "miteinander verbunden wurden, um ihnen einen zusaetzlichen Halt zu "
    "geben. Sie umschliesst den gesamten Ostplatz und wurde als Schutz fuer "
    "die Kinder vor den Gefahren der Wildnis errichtet." );
  AddDetail( "anzahl",
    "Um die Anzahl der Pfaehle festzustellen, muesstest Du schon saemtliche "
    "abzaehlen, aber das waere ein grosser Aufwand." );
  AddDetail( "aufwand",
    "Der Aufwand, alle Pfaehle abzaehlen zu wollen, ist sicher sehr gross. "
    "Probier es aus, dann wirst Du es sicher sehen." );
  AddDetail( "gefahren",
    "Die Gefahren warten hinter der Holzpalisade. Du glaubst nicht, dass Du "
    "auf dem Ostplatz allzu grossen Gefahren ausgeliefert sein wirst." );
  AddDetail( "halt",
    "Der Holzpalisade wird durch die Seile ein zusaetzlicher Halt gegeben." );
  AddDetail( ({ "xandimkinder","kinder" }),
    "Die Kinder sind diesseits der Palisade sicher, doch sehen tust Du "
    "trotzdem keine." );
  AddDetail( ({ "palisade","palisaden" }),
    "Vor Dir ist die Holzpalisade und weiter im Westen ist die Eispalisade." );
  AddDetail( "eispalisade",
    "Dir ist leider nicht moeglich, mehr zu erkennen, als dass sie Yiqanuc "
    "umgibt." );
  AddDetail( ({ "pfaehle","holzpfaehle" }),
    "Die Pfaehle wurden nebeneinander in den Boden geschlagen und bilden "
    "so die Holzpalisade. Sie sind wie vieles auf dem Ostplatz aus "
    "Fichtenholz." );
  AddDetail( ({ "holz","fichtenholz" }),
    "Sowohl die Pfaehle der Holzpalisade als auch die Baumstaemme der Huette "
    "sind aus Fichtenholz." );
  AddDetail( "schutz",
    "Die Holzpalisade wurde als Schutz fuer die Kinder vor den Gefahren der "
    "Wildnis errichtet." );
  AddDetail( ({ "seil","seile" }),
    "Unzaehlige Seile wurden durch die Pfaehle der Holzpalisade gefaedelt, "
    "um ihnen einen zusaetzlichen Halt zu gewaehren. Das Schema der "
    "Seilwindungen bleibt Dir allerdings ein Raetsel." );
  AddDetail( ({ "seilwindungen","seilwindung" }),
    "Die Seile winden sich einmal vor die Pfaehle, dann verschwinden sie "
    "wieder dahinter. Ein Schema erkannst Du darin nicht." );
  AddDetail( "schema",
    "Es gibt bei den Seilen in der Palisade sicher ein Schema, doch Dir "
    "gelingt es nicht, es zu durchschauen." );
//  AddDetail( "raetsel",
//    "" );
  AddDetail( "wildnis",
    "Die Wildnis liegt hinter der Holzpalisade. Welche Gefahren darin auf "
    "Dich lauern, kannst Du nur feststellen, wenn Du Dich dort hin "
    "begibst." );
  AddDetail( ({ "platz","abstand" }),
    "Der Platz bzw der Abstand von der Rueckwand des Ladens bis zur "
    "Holzpalisade betraegt drei Meter." );
  AddDetail( ({ "laden","laeden" }),
    "Es gibt einige Laeden auf dem Ostplatz, aber derzeit stehst Du nur "
    "hinter einem, der, um genau zu sein, ein Felladen ist." );
  AddDetail( "plaetze",
    "Zu den interessantesten Plaetzen in Yiqanuc zaehlt dieser Ort nicht, aber "
    "dafuer kann man sich gut entspannen, da selten irgendwer vorbeikommt, und "
    "die Ruhe geniessen." );
  AddDetail( "ort",
    "Dieser Ort ist zwar schoen ruhig, aber interessant ist er nicht. Was "
    "will man sich auch viel hinter einem Laden erwarten?" );
  AddDetail( "ruhe",
    "Du geniesst die angenehme Ruhe. Das tut Dir ganz gut nach all dem "
    "bunten Treiben auf dem Ostplatz." );
  AddDetail( "treiben",
    "Vom Treiben ist derzeit nichts zu sehen. Du kannst endlich die Ruhe "
    "geniessen." );
  AddDetail( "faelle",
    "Du bist Dir hundertprozentig sicher. Du hast schon interessantere "
    "Plaetze gesehen als die Rueckseite eines Ladens." );
  AddDetail( "yiqanuc",
    "Yiqanuc nennt sich das Heimatdorf der Xandim und bist gerade auf dem "
    "Ostplatz davon." );
  AddDetail( ({ "dorf","heimatdorf" }),
    "Das Heimatdorf der Xandim heisst so." );
  AddDetail( ({ "seitenwaenden","seilen","pfaehlen","ladens","dingen",
                "felladens","auf" }),
    "Das kannst Du nicht untersuchen." );

  AddSound( DEFAULT_SOUND,
    "" );

  AddSmell( DEFAULT_SMELL,
    "" );
//END DETAILS
  AddExit( "westen", "./ostplatz_b4" );
  AddExit( "osten", "./ostplatz_d3" );
  AddExit( "norden", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : ROOM "fellladen_c3",
          EX_MSG      : "unter einem Baumstamm durch in den Felladen" ]) );
  AddExit( "oben", ([
        EX_TESTFUNC : #'exit_test,
        EX_DEST     : ROOM "fellladendach",
        EX_MSG      : "ueber einen Baumstamm hinauf auf das Dach" ]) );    
  SetProp( P_HIDE_EXITS, ({ "norden","oben" }) );

  AddCmd( ({ "zieh","ziehe" }), "ziehen" );
  AddCmd( ({ "grab","grabe","schaufel","schaufle" }), "graben" );
  AddCmd( ({ "geniess","geniesse" }), "geniessen" );
  AddCmd( ({ "zaehl","zaehle" }), "zaehlen" );
}

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "So einfach kommst Du nicht dort hin!\n" );
    return 0;
  }
  return 1;
}
//SPECIAL DETAILS
string detailSchnee()
{
  object *handschuh;
  int i, handschuh_getragen;

  handschuh = TP->QueryProp(P_ARMOURS);
  for ( i = sizeof(handschuh); i-->0; )
  {
    if ( handschuh[i]->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE )
    {
      handschuh_getragen = 1;
      break;
    }
  }
  if ( handschuh_getragen )
  {
    return BS(
      "Du greifst mit "+handschuh[i]->name(WEM)+" in den Schnee und "
      "versuchst den Schnee zu fuehlen, aber mit "+handschuh[i]->name(WEM)+
      " an, geht das natuerlich nicht besonders gut." );
  }
  return BS(
    "Du greifst mit Deinen Haenden in den Schnee und merkst erst jetzt "
    "wie pulvrig er ist. Als Kind wurde Dir immer gesagt, dass Du den Schnee "
    "nicht essen solltest, aber irgendwie verspuerst Du die volle Lust "
    "dazu. Wenn Du es nicht besser wuesstest, koenntest Du ihn fast fuer "
    "Zucker halten." );
}

string detailEigenespur()
{
  if ( silber_da )
  {
    return BS(
      "Du bleibst einmal kurz stehen und siehst Dir Deine eigene Spur hinter "
      "Dir genauer an. Hat da nicht etwas bei einem Abdruck gefunkelt?" );
  }
  return BS(
    "Du bleibst einmal kurz stehen und siehst Dir Deine eigene Spur hinter Dir "
    "genauer an und stellst fest, dass sich an Deinen Abdruecken nichts "
    "geaendert hat." );
}

string detailAbdruck()
{
  if ( silber_da )
  {
    return BS(
      "Du gehst ganz nah an den Abdruck hin, um rauszufinden, was da eben "
      "gefunkelt hat, und da steckt doch tatsaechlich etwas silberschimmerndes "
      "im Schnee drin." );
  }
  return BS(
    "Deine Abdruecke sehen ganz normal aus. Nichts daran festzustellen, was "
    "Dich beunruhigen koennte oder sollte." );
}
//END SPECIAL DETAILS

//COMMANDS
int ziehen(string str)
{
  notify_fail( "Woran moechtest Du gern ziehen?\n" );
}

int graben(string str)
{
  notify_fail( "Was willst Du ausgraben?\n" );
}

int geniessen(string str)
{
  notify_fail( "Das Du ein Geniesser bist, ist mir schon klar. Nur was willst "
               "Du geniessen?\n" );
}

int zaehlen(string str)
{
  notify_fail( "Du moechtest etwas abzaehlen?\n" );
}
//END COMMANDS

void reset()
{
  ::reset();

  silber_da = random(2);
}
