//Osterweiterung des Xandimdorf, Rage Feb 00

inherit "std/room";
inherit "d/polar/rage/ostplatz/room/rundgang";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>

int exit_test();

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Jetzt hast Du den Treffpunkt der Erwachsenen gefunden. 17 Xandim "
    "sitzen in einem grossen Kreis versammelt auf dem Boden und "
    "unterhalten sich miteinander. Westlich von Dir ist ein Seiteneingang "
    "vom Felladen und oestlich und suedlich wird der Platz von der "
    "Holzpalisade umgeben. Knapp vor der Palisade im Sueden ist eine "
    "Eisflaeche, deren Ende hier ist und deren Anfang weiter im Westen liegen "
    "muss. Neben der Eisflaeche steht ein Xandim, der einen Stock in einer "
    "Hand haelt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -4]) );

//DETAILS
  AddDetail( "boden",
    "Der Boden ist selbstverstaendlich, wie nicht anders zu erwarten, ueber "
    "und ueber mit Schnee bedeckt. Und eben genau auf diesen mit Schnee "
    "bedeckte Boden haben sich 17 Xandim in einem Kreis hingesetzt." );
  AddDetail( "schnee",
    "Du bist immer mehr davon ueberzeugt, dass der gesamte Ostplatz mit "
    "Schnee bedeckt ist, denn ueberall, wo Du hinblickst, erkennst Du die "
    "weisse Farbe des Schnees und solltest Du etwas braunes sehen, weisst "
    "Du, dass es sich dabei um Holz handelt. Im Bereich des Kreises ist der "
    "Schnee zwar niedergetreten, aber vor der Holzpalisade liegt doch noch "
    "ein Streifen mit Neuschnee." );
  AddDetail( "bereich",
    "Im Bereich des Kreises ist der Schnee natuerlich niedergetreten, da "
    "die Xandim staendig aufstehen und weggehen, waerend andere neu "
    "dazukommen und sich sitzen." );
  AddDetail( ({ "farben","farbe" }),
    "Zwei Farben scheinen auf dem Ostplatz zu ueberwiegen, naemlich weiss "
    "und braun. Du hast schon eine groessere Farbenvielfalt gesehen als "
    "hier." );
  AddDetail( "farbenvielfalt",
    "Nein, praechtig ist die nicht. Kein blau, kein gelb, kein violett, "
    "kein rosa, kein gruen, kein rot, kein orange, kein gar nichts." );
  AddDetail( "holz",
    "Mal schauen, was Du alles aus Holz entdeckst. Da waer zum einen der "
    "Felladen, zum anderen die Holzpalisade und ausserdem noch der Wachturm." );
  AddDetail( "neuschnee",
    "Neben der Holzpalisade ist ein Streifen mit Neuschnee uebergeblieben, "
    "weil keiner dort vorbeikommt und den Schnee niedertritt." );
  AddDetail( "streifen",
    "Direkt vor der Holzpalisade liegt ein Streifen mit einer frischen "
    "Neuschneeschicht." );
  AddDetail( ({ "neuschneeschicht","schneeschicht" }),
    "Direkt neben der Holzpalisade liegt eine Neuschneeschicht und wenn Du "
    "gerade Lust hast, koenntest Du sogar nachmessen, wieviel es letztens" 
    "geschneit hat." );
  AddDetail( "lust",
    "Ich weiss nicht, ob Du Lust hast, rauszufinden, wieviel Schnee letztens "
    "gefallen ist." );
  AddDetail( "himmel",
    "Einfach prachtvoll! Die Sonne scheint, der Himmel ist so blau wie "
    "die Augen eines Babys und nur die paar Wolken im Norden zerstoeren "
    "das fast perfekte Bild." );
  AddDetail( "augen",
    "Der Himmel ist so blau wie die Augen eines neugeborenen Babys." );
  AddDetail( "baby",
    "Ist keines zu sehen." );
  AddDetail( "bild",
    "Das fast perfekte Bild des blauen Himmels wird nur durch ein paar "
    "Wolken im Norden zerstoert." );
  AddDetail( "norden",
    "In diese Richtung weitet sich der Platz noch aus. Dir faellt natuerlich "
    "gleich der Wachturm auf, auf dem eine Wache ihre Arbeit verrichtet." );
  AddDetail( "arbeit",
    "Eine Wache verrichtet auf dem Wachturm ihre Arbeit." );
  AddDetail( ({ "wachturm","turm" }),
    "Der Wachturm besteht aus vier Pfosten, einer Plattform, einem Dach und "
    "einer Leiter, um auf ihn raufklettern zu koennen." );
  AddDetail( "leiter",
    "Eine Leiter wurde an die Plattform gelehnt, um auf selbige hinaufklettern "
    "zu koennen." );
  AddDetail( "pfosten",
    "Die Pfosten tragen die Plattform." );
  AddDetail( "plattform",
    "Die Plattform wird von den Pfosten getragen und auf ihr steht eine "
    "Wache." );
  AddDetail( "dach",
    "Als Du Dir das Dach so ansiehst, faellt Dir irgendetwas Rundliches darauf "
    "auf." );
  AddDetail( ({ "irgendetwas","rundliches" }),
    "Das ist von hier nicht zu erkennen. Geh am besten auf den Wachturm und "
    "schau es Dir von dort an." );
  AddDetail( "wache",
    "Die Wache passt wohl darauf auf, dass Eindringlinge rechtzeitig erkannt "
    "werden." );
  AddDetail( "eindringlinge",
    "Wird es sicher nicht viele geben. Wer will schon dem friedvoll lebenden "
    "Volk der Xandim etwas antun?" );
  AddDetail( "sonne",
    "Die Sonne macht das, was sie ueblicherweise so macht, sie scheint." );
  AddDetail( ({ "wolken","wolke" }),
    "Ganz weiten im Norden ueber der Holzpalisade sind ein paar Wolken, die "
    "das perfekte Bild des blauen Himmels stoeren." );
  AddDetail( "treffpunkt",
    "Eines ist Dir auf Anhieb klar. Dieser Bereich vom Ostplatz ist sicher "
    "der Treffpunkt fuer die erwachsenen Xandim. Sie haben sich in einem "
    "grossen Kreis hingesetzt und unterhalten sich angeregt miteinander." );
  AddDetail( "anhieb",
    "Wenn Dir etwas sofort klar ist, dann sagt man auch dazu, dass es Dir "
    "auf Anhieb klar ist." );
  AddDetail( ({ "erwachsene","erwachsenen" }),
    "17 (in Worten siebzehn) Erwachsene aus dem Xandimvolk kannst Du hier "
    "auf einem Fleck erblicken." );
  AddDetail( ({ "fleck","haufen" }),
    "17 erwachsene Xandim siehst Du auf einem Haufen bzw. Fleck." );
  AddDetail( ({ "xandim","xandimvolk","volk" }),
    "Im Moment erblickst Du 17 Erwachsene. Sie tragen langes, wuschliges, "
    "hellbraunes Fell, das ihnen bei dieser Kaelte gut schuetzt. Wie Du "
    "Dir die Xandim so einzeln ansiehst, faellt Dir auf, dass sie nicht "
    "auf dem Boden sitzen, sondern auf kleinen Steinen, die Du wegen "
    "ihres Fells vorher nicht gesehen hast." );
  AddDetail( "fell",
    "Die Xandim tragen ein langes, wuschliges, hellbraunes Fell." );
  AddDetail( "kaelte",
    "Den Xandim wird es nicht so schnell kalt, was man von Dir bald nicht "
    "mehr behaupten kann. Wahrscheinlich waere es doch besser fuer Dich, in "
    "den Dschungel zu gehen, denn diese Kaelte tut Dir nicht gut." );
  AddDetail( "dschungel",
    "Der ist sehr weit weg." );
  AddDetail( "moment",
    "Momentan erblickst Du 17 Erwachsene. Das kann sich spaeter schon wieder "
    "aendern." );
  AddDetail( ({ "steine","stein" }),
    "Die Xandim haben auf kleinen Steinen Platz genommen, damit sie nicht "
    "mitten im Schnee sitzen muessen." );
  AddDetail( "kreis",
    "Die Xandim haben sich kreisfoermig auf dem Boden hingesetzt." );
  AddDetail( ({ "eingang","seiteneingang" }),
    "Nachdem der Eingang auf der Seite des Felladens ist, nennt man ihn "
    "auch Seiteneingang. Er ist eine offenstehende Tuer, durch die Du "
    "ohne weiteres den Laden betreten kannst." );
  AddDetail( "seite",
    "Du bist auf der Seite des Felladens. Willst ihn von vorne sehen, musst Du "
    "nach Nordwesten gehen!" );
  AddDetail( "nordwesten",
    "In diese Richtung kannst Du gehen und dort wirst Du mehr vom Ostplatz "
    "sehen." );
  AddDetail( "tuer",
    "Die Tuer des Ladens steht angelweit nach innen offen und in ihrer "
    "Schwelle wurde eine Fussmatte abgelegt." );
  AddDetail( ({ "fussmatte","matte" }),
    "In die Tuerschwelle wurde eine Fussmatte gelegt, damit man seine "
    "Schuhe abstreifen kann und so den Schnee nicht mit in den Laden "
    "hineintragt." );
  AddDetail( "schuhe",
    "Entweder Du hast welche an oder nicht. Die Xandim tragen zumindest "
    "keine." );
  AddDetail( ({ "tuerschwelle","schwelle" }),
    "In der Tuerschwelle wurde eine Fussmatte ausgebreitet." );
  AddDetail( ({ "felladen","fellladen","laden" }),
    "Der Felladen ist jetzt westlich von Dir. Du erblickst nur dessen "
    "Seitenwand, die auch wie die Vorderfront keine Fenster hat. Dafuer "
    "ist genau in der Mitte eine offenstehende Tuer, die Dich zum "
    "Betreten des Ladens richtig gehend einlaedt." );
  AddDetail( "betreten",
    "Betritt ruhig den Laden, ich hindere Dich nicht daran." );
  AddDetail( "fenster",
    "Auch nachdem Du die ganze Wand nochmals abgesucht hast, entdeckst Du kein "
    "Fenster an ihr. Schade, da waren Deine Muehen ganz umsonst." );
  AddDetail( ({ "muehe","muehen" }),
    "Du muehst Dich ganz schoen ab, um alles zu entdecken. Brav! Nur weiter "
    "so!" );
  AddDetail( "mitte",
    "Ziemlich genau in der Mitte der Seitenwand ist eine offenstehende Tuer." );
  AddDetail( ({ "seitenwand","wand" }),
    "Die Seitenwand des Felladens besteht aus mehreren Lagen Baumstaemme und "
    "ist aeusserst schmucklos. Sich diese Wand genauer anzusehen, lohnt "
    "garantiert nicht." );
  AddDetail( ({ "baumstaemme","staemme" }),
    "Die Baumstaemme wurden uebereinander gelegt und bilden somit die "
    "Seitenwand des Felladens." );
  AddDetail( ({ "reihen","lagen" }),
    "Mehrere Lagen Baumstaemme wurden derart uebereinander gelegt, dass sie nun "
    "die Seitenwand des Ladens bilden." );
  AddDetail( "vorderfront",
    "Die Vorderfront des Felladens wirst Du nur sehen, indem Du nach "
    "Nordwesten gehst." );
  AddDetail( ({ "platz","ostplatz" }),
    "Du befindest Dich in der suedoestlichen Ecke vom Platz, und er wird "
    "hier im Osten und Sueden von der Holzpalisade begrenzt." );
  AddDetail( "ecke",
    "Du bist derzeit in der suedoestlichen Ecke des Ostplatzes. Eine eher "
    "ruhige Ecke noch dazu." );
  AddDetail( "osten",
    "Der Ostplatz wird in diese Richtung von der Holzpalisade begrenzt." );
  AddDetail( ({ "palisade","holzpalisade" }),
    "Die Holzpalisade begrenzt den Platz in diesem Teil im Osten und Sueden. "
    "Zahlreiche Pfaehle wurden nebeneinander in den Boden gerammt und mit "
    "Seilen zusaetzlich zusammen gebunden, um so die Palisade zu bilden und "
    "die Kinder vor den Gefahren in der Wildnis zu schuetzen." );
  AddDetail( ({ "gefahren","gefahr" }),
    "Die Gefahren der Wildnis wirst Du noch frueh genug kennenlernen, "
    "vorausgesetzt Du traust Dich einmal aus Yiqanuc raus." );
  AddDetail( ({ "xandimkinder","kinder" }),
    "Die Xandimkinder sollen sich auf dem Ostplatz sicher fuehlen, deshalb "
    "wurde die Holzpalisade errichtet, um sie vor den Gefahren der Wildnis "
    "zu schuetzen." );
  AddDetail( ({ "pfaehle","holzpfaehle","pfahl","holzpfahl" }),
    "Die Holzpfaehle wurden nebeneinander in den Boden gerammt und mit "
    "Seilen zusaetzlich zusammen gebunden. Jeder Pfahl sieht gleich wie sein "
    "Vorgaenger bzw. sein Nachfolger aus, also auch keiner dabei, an dem Du "
    "etwas entdecken koenntest." );
  AddDetail( ({ "vorgaenger","nachfolger" }),
    "Jeder Holzpfahl in der Holzpalisade hat einen Vorgaenger bzw. einen "
    "Nachfolger, die sich um nichts von dem anderen Pfahl unterscheiden." );
  AddDetail( ({ "seil","seile" }),
    "Die Pfaehle der Holzpalisade werden zusaetzlich mit Seilen zusammen "
    "gehalten. Sie schlaengeln sich bei den Holzpfaehlen durch als ob sie "
    "Schlangen waeren." );
  AddDetail( "schlangen",
    "Die Seile schlaengeln sich wie Schlangen zwischen den Pfaehlen durch. Dir "
    "wird es schon so schlangelig, aehm schwindelig, dass Du sogar meinst, "
    "dass sich eine Schlange vor der Holzpalisade bewegt." );
  AddDetail( "schlange",
    "Ist es tatsaechlich moeglich, dass sich eine Schlange oder ein anderes "
    "kleines, laengliches Lebewesen im tiefen Neuschnee vor der Holzpalisade "
    "bewegt?" );
  AddDetail( "lebewesen",
    "Du bist Dir nicht sicher, ob es nicht eine Sinnestaeuschung war oder ob "
    "sich tatsaechlich etwas im Neuschnee bewegt hat." );
  AddDetail( ({ "sinnenstaeuschung","sinne" }),
    "Keine Sinne taeuschen Dich hin und wieder, trotzdem bist Du Dir ziemlich "
    "sicher, dass sich etwas im Neuschnee bewegt." );
  AddDetail( ({ "bewegung","bewegungen" }),
    "Verfolge doch am besten die Bewegungen des Lebewesen, dann kommst Du "
    "ganz bestimmt rasch drauf, wer oder was sich im Neuschnee verbirgt." );
  AddDetail( "teil",
    "Da Du in der suedoestlichen Ecke des Ostplatzes stehst, wird er im Osten "
    "und im Sueden von der Holzpalisade begrenzt." );
  AddDetail( "wildnis",
    "Die Wildnis erwartet Dich ausserhalb von Yiqanuc. Solange Du auf dem "
    "Ostplatz bleibst, wird es kaum wild her gehen." );
  AddDetail( "yiqanuc",
    "Du befindest Dich derzeit auf dem Ostplatz von Yiqanuc." );
  AddDetail( "sueden",
    "Vor der Holzpalisade im Sueden siehst Du das Ende einer Eisflaeche, "
    "auf der ein Xandim mit einem Stock steht." );
  AddDetail( "eisflaeche",
    "Die Eisflaeche ist circa zwei Meter breitet und scheint hier ihr "
    "Ende zu haben. Der Zweck der Eisflaeche ist fuer Dich allerdings "
    "nicht ganz klar. Sie fuehrt hinter dem Laden vorbei in Richtung "
    "Westen." );
  AddDetail( "meter",
    "Die Eisflaeche, die hier endet -oder beginnt sie hier?-, ist etwa zwei "
    "Meter breit." );
  AddDetail( "westen",
    "In diese Richtung erblickst Du einen Laden und die Eisflaeche, die hinter "
    "dem Laden verschwindet." );
  AddDetail( "zweck",
    "Ganz ist Dir der Zweck der Eisflaeche nicht klar. Ob man darauf "
    "eislaufen kann?" );
  AddDetail( "ende",
    "Ist das nun das Ende oder der Anfang? Ganz sicher bist Du Dir jetzt "
    "auch nicht mehr." );
  AddDetail( "anfang",
    "Du nimmt an, dass Du das Ende der Eisflaeche siehst, womit der Anfang "
    "weiter im Westen liegen muss." );
  AddDetail( "westen",
    "Westlich von Dir steht nicht nur der Laden, sondern Du siehst auch, "
    "wie die Eisflaeche hinter dem Laden parallel zur Holzpalisade weiter "
    "nach Westen verlaeuft." );
  AddDetail( "stock",
    "Der Xandim auf der Eisflaeche hat einen Stock in der Hand. Immer wenn "
    "ein Eisstock auf der Eisflaeche auftaucht, setzt er ihn ab und danach "
    "nimmt er ihn wieder weg. Was der bloss da macht?" );
  AddDetail( "eisstock",
    "Falls ein Eisstock vom Westen her kommend ploetzlich auftaucht, wartet "
    "der Xandim bis der Eisstock stillt steht, geht dann hin, setzt den "
    "Stock auf der Eisflaeche direkt neben dem Eisstock ab und stellt "
    "anschliessen den Eisstock neben der Eisflaeche ab." );
  AddDetail( "hand",
    "Die Hand kannst Du von dieser Entfernung nicht genau erkennen, doch "
    "Dir ist klar, dass der Xandim den Stock nicht mit dem Fuss haelt." );
  AddDetail( "entfernung",
    "Die Entfernung zu dem Xandim mit der Stock in der Hand ist zwar nicht "
    "gross, aber ob er nun ein Muttermal auf der Hand hat oder nicht, siehst "
    "Du von hier aus nicht." );
  AddDetail( "muttermal",
    "Das geht Dich ueberhaupt nichts an, ob der Xandim ein Muttermal hat "
    "oder nicht. Kuemmere Dich um Deinen eigenen Kram!" );
  AddDetail( "kram",
    "Bleib bei Deinem!" );
  AddDetail( "fuss",
    "Ich glaube auch nicht, dass Du es schaffst, einen Stock mit dem Fuss "
    "zu halten, obwohl ich nur zu gern wuesste, wie ungeschickt Du Dich "
    "dabei anstellen wuerdest." );
  AddDetail( ({ "felladens","worten","steinen","seilen","babys" }),
    "Das kannst Du nicht untersuchen." );

  AddSound( DEFAULT_SOUND,
    "" );

  AddSmell( DEFAULT_SMELL,
    "" );
//END DETAILS

  AddExit( "westen", "./fellladen_c3" );
  AddExit( "norden", "./ostplatz_d2" );
  AddExit( "nordwesten", "./ostplatz_c2" );
  AddExit( "hinten", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : "./ostplatz_c4",
          EX_MSG      : "hinter den Felladen" ]) );
  SetProp( P_HIDE_EXITS, ({ "hinten" }) );  
  
  AddCmd( ({ "sitz","sitze","setz","setze" }), "setzen" );
  AddCmd( ({ "miss","mess","messe" }), "messen" );
  AddCmd( ({ "streif","streife" }), "cmd_streifen" );
}

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "So einfach kommst Du dort nicht hin!\n" );
    return 0;
  }
  return 1;
}
//COMMANDS
int setzen(string str)
{
  notify_fail( "Wohin willst Du Dich setzen?\n" );
}

int messen(string str)
{
  notify_fail( "Was moechtest Du abmessen?\n" );
}

int cmd_streifen(string str)
{
  int i;
  int schuhwerk_getragen;
  string was, dummy, worauf;
  object *schuhwerk;

  schuhwerk = TP->QueryProp(P_ARMOURS);
  for ( i=sizeof(schuhwerk); i-->0; )
  {
    if ( schuhwerk[i]->QueryProp(P_ARMOUR_TYPE) == AT_BOOT )
    {
      schuhwerk_getragen = 1;
      break;
    }
  }

  notify_fail( "Was willst Du wo abstreifen?\n" );

  if ( !str ) return 0;
  if ( sscanf(str, "%s %s %s ab", was, dummy, worauf) != 3 ) return 0;
  if ( member( ({ "an","auf" }),dummy) == -1 ) return 0;
  if ( member( ({ "fuesse" }),was) != -1 )
  {
    if ( member( ({ "matte","fussmatte" }), worauf) != -1 )
    {
      if ( schuhwerk_getragen )
      {
        write( BS(
          "Du hast doch "+schuhwerk[i]->name(WER)+" an. Das musst Du schon "
          "ausziehen, um die Fuesse abstreifen zu koennen.") );
        return 1;
      }
      write( BS(
        "Da Du gut erzogen worden bist, streifst Du Dir zuerst die Fuesse auf "
        "der Matte ab und betrittst erst dann den Laden.") );
      say(
        TPN+" streift sich "+TP->QueryPossPronoun(MALE,WEN,PLURAL)+
        " Fuesse ab und betritt den Laden.\n" );
      if ( "/d/polar/rage/ostplatz/room/fellladen_c3"->Getdreck() < 4 )
        "/d/polar/rage/ostplatz/room/fellladen_c3" -> schriftzug();
      "/d/polar/rage/ostplatz/room/fellladen_c3" -> Dreckiger();
      TP -> move(ROOM "fellladen_c3", M_GO|M_SILENT);
      return 1;
    }
    notify_fail( "Worauf willst Du Deine Fuesse abstreifen?\n" );
  }

  if ( member( ({ "stiefel","schuhe","sandalen" }),was) != -1 )
  {
    if ( member( ({ "matte","fussmatte" }), worauf) != -1 )
    {
      if ( !schuhwerk_getragen )
      {
        write(
  	  "Du bist doch barfuss! Du kannst Dir nur Deine Fuesse abstreifen.\n" );
        return -1;
      }
      write( BS(
        "Deine Eltern haben Dich gut erzogen, denn bevor Du den Laden betrittst "
        "streifst Du Deine "+schuhwerk[i]->QueryProp(P_NAME)+" auf der Matte ab.") );
      say(
        TPN+" streift sich "+TP->QueryPossPronoun(FEMALE,WEN,PLURAL)+
        schuhwerk[i]->QueryProp(P_NAME)+" ab und betritt den Laden.\n" );
      if ( "/d/polar/rage/ostplatz/room/fellladen_c3"->Getdreck() < 4 )
        "/d/polar/rage/ostplatz/room/fellladen_c3" -> schriftzug();
      "/d/polar/rage/ostplatz/room/fellladen_c3" -> Dreckiger();
      TP -> move(ROOM "fellladen_c3", M_GO|M_SILENT);
      return 1;
    }
    if ( !schuhwerk_getragen )
    {
      write(
        "Du bist doch barfuss! Du kannst Dir nur Deine Fuesse abstreifen.\n" );
      return -1;
    }
    notify_fail( "Worauf willst Du Deine "+schuhwerk[i]->QueryProp(P_NAME)+
                 " abstreifen?\n" );
  }
}
//END COMMANDS

/*Aenderungen:
  Init fuer variable Raumbeschreibung
  Detail: Xandim, Erwachsene, Steine, Moment
*/