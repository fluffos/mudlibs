// Osterweiterung des Xandimdorf,
// Filename: ostplatz_a1.c
// File by Rage, Februar 00

inherit "std/room";
inherit "d/polar/rage/ostplatz/room/rundgang";

#include "../def.h"
#include <verben.h>
#include <moving.h>

#define TOROOM (["osten":ROOM "ostplatz_b1", "suedosten":ROOM "ostplatz_b2"])

int fisch_weg;           //Kein Fisch mehr da
int *verrenkt;           //Spieler kann sich nun Sonne anschauen
int *fisch_gerochen;     //Spieler hat Fischgeruch entdeckt
int spalt_da;            //Im Iglu wurde ein Spalt erzeugt
int kristallmenge;       //Anzahl an Eiskristalle, die gefunden werden kann
string fisch(string key);
int exit_test();         //Test fuer Schneewiesel
object spaltraum;

void create()
{
  ::create();

  fisch_weg = random(3);
  verrenkt = ({});
  fisch_gerochen = ({});
  spalt_da = 0;
  kristallmenge = random(4);
  spaltraum = 0;

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Waehrend sich hinter Dir die Kinder auf dem Ostplatz tummeln, kommt "
    "nur selten eines hier vorbei. Vor Dir steht ein grosses Iglu, wie es "
    "typischer fuer Yiqanuc nicht sein koennte, in dem leicht abgeschiedenen "
    "Eck zwischen Eis- und Holzpalisade. Es ist fast so gross, dass ein "
    "Troll drin aufrecht stehen kann und weist, soweit Du das von hier "
    "sehen kannst, keinen Eingang auf." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -4]) );

//DETAILS
  AddDetail( "boden",
    "Der Grossteil des Bodens ist mit Neuschnee bedeckt, es sind nur wenige "
    "Spuren darin zu erkennen, von denen ein paar links und rechts um das "
    "Iglu herumfuehren." );
  AddDetail( "grossteil",
    "Der Grossteil des Bodens ist mit Neuschnee bedeckt, nur dort, wo Spuren "
    "im Schnee hinterlassen wurden, laesst es sich nicht beurteilen, ob es "
    "sich um Neuschnee oder laenger liegendem Schnee handelt." );
  AddDetail( "neuschnee",
    "Der Neuschnee ist sehr pulvrig und eignet sich ideal, um jemanden das "
    "Gesicht damit einzureiben." );
  AddDetail( "gesicht",
    "Hmmm, jemand anderem das Gesicht mit Schnee einzureiben, koennte Dir "
    "Spass machen, aber so gemein bist Du nicht, oder etwa doch?" );
  AddDetail( "schnee",
    "Der Schnee bedeckt den ganzen Boden und an vielen Stellen liegt sogar "
    "noch der pulvrige Neuschnee. Der Schnee wurde auch zum Bau der "
    "Eispalisade verwendet, die hinter dem Iglu hoch ragt." );
  AddDetail( "bau",
    "Fuer den Bau der Eispalisade wurde neben Eis auch Schnee verwendet." );
  AddDetail( "stellen",
    "Dort, wo der Schnee nicht niedergetreten wurde, liegt noch der pulvrige "
    "Neuschnee." );
  AddDetail( "spuren",
    "Da der Boden mit Neuschnee bedeckt ist, erkennst Du ohne weiteres ein "
    "paar Spuren, die links und rechts um das Iglu herumfuehren. Kinder- oder "
    "Hundespuren sind keine zu sehen. Achja, beinahe haettest Du Deine eigene "
    "Spur uebersehen." );
  AddDetail( ({ "kinderspur","kinderspuren","hundespuren","hundespur" }),
    "Es sind weder Kinder- noch Hundespuren zu sehen." );
  AddDetail( ({ "eigene spur","spur" }),
    "Deine Spur zeichnet sich im Schnee eindeutig ab, da sie noch ganz frisch "
    "ist." );
  AddDetail( "himmel",
    "Er ist wunderschoen klar und blau, keine Wolken sind zu sehen und die "
    "Sonne steht im Zenit." );
  AddDetail( ({ "wolken","wolke" }),
    "Es sind nicht 1000, nicht 100, nicht 10, nicht 5 oder nur eine einzige "
    "Wolke zu sehen." );
  AddDetail( "zenit",
    "Um die Sonne zu sehen, musst Du Deinen Kopf ziemlich verrenken, denn sie "
    "steht genau ueber Dir." );
  AddDetail( "kopf",
    "Dein Kopf sitzt genau dort, wo er sein sollte. Du koenntest ihn auch "
    "kurz verrenken, um genau in die Sonne zu schauen." );
  AddSpecialDetail( "sonne", "detailSonne" );
  AddDetail( ({ "kinder","xandimkinder" }),
    "Oestlich von Dir tummeln sich zahlreiche Kinder. Sie spielen "
    "miteinander, bauen Schneemaenner und werfen Schneebaelle, doch in die "
    "Naehe des Iglus kommt nur selten eines." );
  AddDetail( "naehe",
    "Du stehst ganz in der Naehe des Iglus, um nicht zu sagen, genau davor. "
    "Dir faellt nur auf, dass die Kinder nicht so nah herankommen." );
  AddDetail( ({ "schneeball","schneebaelle" }),
    "Wenn Du nach Osten gehst, koennte es durchaus passieren, dass Du von "
    "einem Schneeball mitten im Gesicht getroffen wirst." );
  AddDetail( "osten",
    "Nach Osten breitet sich der Ostplatz aus, und Du siehst einige Kinder, "
    "die sich gut unterhalten." );
  AddDetail( ({ "schneemann","schneemaenner" }),
    "Weiter im Osten, wo sich die Kinder tummeln, sind einige Schneemaenner "
    "gebaut worden und an einigen wird gerade gearbeitet." );
  AddDetail( ({ "ostplatz","platz" }),
    "Du bist derzeit in der nordwestlichen Ecke des Ostplatzes. Er ist ein "
    "Treffpunkt fuer jung und alt, um sich nach einem anstrengenden Arbeitstag "
    "ein wenig zu entspannen." );
  AddDetail( "arbeitstag",
    "Weisst Du ueberhaupt was ein schwerer Arbeitstag ist? Falls nicht, dann "
    "frag doch einmal einen Xandim." );
  AddDetail( "treffpunkt",
    "Der Ostplatz ist ein Treffpunkt fuer jung und alt, aber auch einer fuer "
    "Abenteurer, die sich erholen wollen." );
  AddSpecialDetail( "abenteurer", "detailAbenteurer" );
  AddDetail( "iglu",
    "Wenn Du schon immer wissen wolltest, wie ein Iglu aus der Naehe "
    "aussieht, dann weisst Du es spaetestens seit heute. Vor Dir wurde "
    "wahrlich ein Prachtexemplar errichtet. Es hat wie alle Iglus die Form "
    "eines Kugelsegmentes, es ist etwa so hoch wie ein Troll und misst "
    "unglaubliche 10 Meter im Durchmesser. Es wurde aus mehreren Reihen fein "
    "saeuberlich ausgeschnittener Schneebloecke gebaut, zwischen denen es nicht "
    "den geringsten Spalt gibt. Es sieht fast so aus, als ob das Iglu aus "
    "einem grossen Schneeblock bestehe." );
  AddDetail( "durchmesser",
    "Das Iglu hat am Boden einen Durchmesser von 10 Meter." );
  AddDetail( ({ "schneebloecke","schneeblock" }),
    "Das Iglu wurde aus zahlreichen Schneebloecken gebaut, die neben- und "
    "uebereinander gelegt und so genau geschnitten wurden, dass kein Spalt "
    "zwischen zwei Schneebloecken blieb und es deshalb fast so aussieht, als ob "
    "das Iglu aus einem grossen Schneeblock bestehe." );
  AddDetail( ({ "kugelsegment","form","form in raum" }),
    "Die Form des Iglus ist ein Kugelsegment, das mit seinem 10 Meter "
    "Durchmesser auf dem Boden aufliegt." );
  AddDetail( "meter",
    "Du willst es natuerlich ganz genau wissen, und so stellst Du fest, dass "
    "das Iglu am Boden einen Durchmesser von 10 Meter hat, die Holzpalisade "
    "drei Meter hoch ist, ebenso das Iglu, dass die Eispalisade sicher "
    "groesser als drei Meter sein muss, denn sonst koenntest Du sie nicht "
    "hinter dem Iglu sehen und dass die Xandimkinder sich etwa 10 Meter vom "
    "Iglu weiter im Osten aufhalten." );
  AddDetail( "prachtexemplar",
    "Das Iglu ist wahrlich ein Prachtexemplar. Es ist eine Paradebeispiel "
    "fuer die Iglubaukunst und faellt nicht zuletzt wegen der ueberragenden "
    "Groesse auf." );
  AddDetail( "groesse",
    "Die Groesse des Iglus vor Dir ist ueberragend. Bestimmt ist das Iglu so "
    "hoch wie ein Troll." );
  AddDetail( ({ "paradebeispiel","iglubaukunst","kunst","iglubau" }),
    "Das Iglu ist ein Paradebeispiel fuer die Iglubaukunst. Die Schneebloecke "
    "wurden fein saeuberlich ausgeschnitten und ebenso sorgfaeltig auf- und "
    "nebeneinander gereiht, sodass keine Spalte zwischen den einzelnen "
    "Schneebloecken blieb. Solch eine Kunst des Iglubaus beherrschen nur die "
    "Xandim." );
  AddDetail( ({ "reihe","reihen" }),
    "Reihe fuer Reihe wurden Schneebloecke uebereinander gelegt, bis sie als "
    "ganzes schliesslich dieses gewaltige Iglu bilden." );
  AddSpecialDetail( ({ "spalten","spalt","spalte" }), "detailSpalt" );
  AddSpecialDetail( "gegenstand", "detailGegenstand" );
  AddDetail( ({ "yiqanuc","westen" }),
    "Hinter der Eispalisade im Westen liegt die Heimat der Xandim, Yiqanuc." );
  AddDetail( ({ "heimat","heimatdorf" }),
    "Die Heimat bzw. das Heimatdorf der Xandim heisst Yiqanuc." );
  AddDetail( "xandim",
    "Ueberall auf dem Platz werden Dir Xandim begegnen, da Yiqanuc ihr "
    "Heimatdorf ist. Aufgrund ihres zotteligen, langen Fells macht ihnen die "
    "Kaelte nicht so viel aus wie Dir." );
  AddDetail( "fell",
    "Die Xandim tragen ein langes, zotteliges Fell, dass sie vor der eisigen "
    "Kaelte schuetzt." );
  AddDetail( "kaelte",
    "Im Polargebiet ist es sehr kalt, doch die Kaelte macht den Xandim "
    "ueberhaupt nicht aus. Das mag wohl an ihrem langen, wuscheligen Fell "
    "liegen." );
  AddDetail( ({ "eck","ecke" }),
    "Du stehst nun im nordwestlichen Eck des Ostplatzes, das einerseits von "
    "der hohen Eispalisade, andererseits von der drei Meter hohen "
    "Holzpalisade gebildet wird. Im Gegensatz zu dem restlichen Platz kommt "
    "hier selten jemand vorbei, was Dir seltsam vorkommt, in Anbetracht der "
    "Tatsache, dass keine 10 Meter weiter im Osten soviele Kinder in der "
    "Gegend herumlaufen und miteinander spielen." );
  AddDetail( "gegensatz",
    "Im Gegensatz zu dem ganzen restlichen Ostplatz kommt hier selten jemand "
    "vorbei, worauf Du aufgrund der wenigen Spuren im Schnee schliesst." );
  AddDetail( ({ "anbetracht","tatsache" }),
    "Tatsache ist, dass, obwohl so viele Kinder in der Gegend herumlaufen, "
    "keines von ihnen in die Naehe des Iglus kommt. Es muss wohl jemand ganz "
    "besonderes darin leben." );
  AddDetail( "gegend",
    "Die Kinder laufen halt einfach in der Gegend herum. Lass ihnen doch "
    "ihren Spass." );
  AddDetail( "eispalisade",
    "Die Eispalisade, die hinter dem Iglu hoch ragt, ist gewaltig. Sie misst "
    "sicher an die fuenf Meter, ist komplett aus Eis und Schnee errichtet und "
    "schuetzt Yiqanuc vor jeglichen, moeglichen Eindringlingen. Suedlich von "
    "Dir wurde sie unterbrochen, um Raum fuer ein Tor zu lassen." );
  AddDetail( "eindringlinge",
    "Moegliche Eindringlinge werden es schwer haben, ueber die Eispalisade zu "
    "kommen, die Yiqanuc umgibt." );
  AddDetail( "eis",
    "Sowohl die Eispalisade als auch geringe Anteile des Iglus bestehen aus Eis." );
  AddDetail( ({ "anteil","anteile" }),
    "Hauptsaechlich besteht das Iglu aus festem, gepresstem Schnee, aber an der "
    "Oberflaeche bildete sich auch ein wenig Eis." );
  AddDetail( "oberflaeche",
    "Die Oberflaeche des Iglus hat zeitweise geringe Anteile von Eis." );
  AddDetail( "raum",
    "Die Eispalisade wurde suedlich von Dir unterbrochen, um genuegend Raum "
    "fuer ein Tor zu lassen." );
  AddDetail( "tor",
    "Das Tor selbst kannst Du nicht sehen, da Du in der Ecke des Ostplatzes "
    "stehst. Du merkst nur, dass die Eispalisade unterbrochen wurde. Am "
    "besten gehst Du nach Suedosten, dann siehst Du das Tor bestimmt." );
  AddDetail( "suedosten",
    "Dorthin kannst Du gehen, wenn Du willst." );
  AddDetail( "holzpalisade",
    "Durch das Aneinanderreihen unzaehliger Pfaehle, die in den Boden "
    "geschlagen wurden, ist diese Palisade entstanden. Sie fuehrt noerdlich "
    "an Dir vorbei und umgibt zusammen mit der Eispalisade den ganzen "
    "Ostplatz, um den Kindern ausreichenden Schutz vor wilden Tieren zu "
    "geben." );
  AddDetail( "aneinanderreihen",
    "Unzaehlige Pfaehle wurden aneinander gereiht und bilden in ihrer "
    "Gesamtheit die Holzpalisade." );
  AddDetail( "gesamtheit",
    "Die Gesamtheit der nebeneinander in den Boden gerammten Pfaehle ist die "
    "Holzpalisade." );
  AddDetail( "norden",
    "Dort fuehrt die Holzpalisade an Dir vorbei." );
  AddDetail( "palisade",
    "Eine Holzpalisade fuehrt direkt im Norden an Dir vorbei, waehrend eine "
    "Eispalisade hinter dem Iglu hoch ragt." );
  AddDetail( ({ "holzpfaehle","pfaehle" }),
    "Die Pfaehle aus Holz wurden nebeneinander in den Boden geschlagen und "
    "bilden so die Holzpalisade." );
  AddDetail( ({ "holz","fichtenholz" }),
    "Das Holz der Holzpalisade ist Fichtenholz und riecht sehr frisch." );
  AddDetail( ({ "baeume","fichtenbaeume" }),
    "Nein, auf dem Ostplatz wachsen keine Baeume." );
  AddDetail( "schutz",
    "Die Holzpalisade, die den Ostplatz umgibt, bietet den Kindern, die "
    "darauf ihren Spass haben, ausreichend Schutz vor den wilden Tieren des "
    "Polargebiets." );
  AddDetail( "polargebiet",
    "Im Polargebiet gibt es einige wilde Tiere, denen Du sicher noch begegnen "
    "wirst, wenn Du Dich laengere Zeit ausserhalb von Yiqanuc aufhaeltst." );
  AddDetail( "zeit",
    "Verbring ruhig mal einige Zeit in Yiqanuc und im Polargebiet, dann "
    "lernst Du sicher viel Neues kennen." );
  AddDetail( "neues",
    "Wenn man sich genau umsieht, trifft man immer wieder auf etwas Neues." );
  AddDetail( "spass",
    "Schau Dir ruhig mal die Kinder genauer an oder frag sie am besten, dann "
    "weisst Du, dass sie viel Spass haben und sehr gluecklich sind." );
  AddDetail( "tiere",
    "Die wilden Tiere werden durch die Eispalisade daran gehindert, auf den "
    "Ostplatz zu kommen. Auf dem Platz machst Du nur ein paar Schlittenhunde "
    "aus, die doch eher harmlos aussehen, da alle Kinder mit ihnen zu spielen "
    "scheinen." );
  AddDetail( ({ "schlittenhunde","hunde" }),
    "Auf dem Platz laufen einige Schlittenhunde umher und lassen sich von den "
    "Kindern streicheln, doch kommen auch von ihnen keine in die Naehe des "
    "Iglus." );
  AddDetail( ({ "troll","trolle" }),
       ([ 0: "Der Troll diente nur als Vergleich, um Dir zu veranschaulichen, "
	     "wie gross das Iglu vor Dir ist.",
    "troll": "Das Iglu ist beinahe ebenso gross wie Du, also doch ziemlich "
 	     "gewaltig." ]) );
  AddDetail( "vergleich",
    "Du vergleichst Dich mit einem Troll." );
  AddDetail( "eingang",
    "Merkwuerdigerweise kannst Du keinen Eingang zum Iglu finden. Entweder "
    "hat das Iglu keinen oder er liegt auf der Dir abgewandten Seite." );
  AddDetail( "seite",
    "Auf dieser Seite des Iglus liegt kein Eingang, denn den haettest Du ganz "
    "bestimmt gesehen. Er koennte ja auch auf der Dir abgewandten Seite "
    "liegen." );
  AddSpecialDetail( ({ "fisch","kadaver" }), "detailKadaver" );
  AddDetail( "ohren",
    "Deine Ohren sind ein bisschen kalt, doch das hoeren mit ihnen, faellt "
    "Dir noch nicht schwer." );
  AddDetail( ({ "faeulnisgeruch","geruch" }),
    "Vielleicht solltest Du doch besser daran riechen." );
  AddDetail( ({ "schreie","woerter" }),
    "Besser waere es doch, daran zu lauschen." );
  AddDetail( ({ "tieren","iglubaus","polargebiets","fells","eindringlingen",
                "schreien","bodens","schneebloecken","iglus","kindern",
                "ostplatzes" }),
    "Das kannst Du nicht untersuchen." );

  AddSound( DEFAULT_SOUND,
    "Es ist abgesehen von den Schreien der Kinder sehr ruhig." );
  AddSound( ({ "schreie","kinder" }),
    "Die Schreie der Kinder dringen von Osten her auf Deine Ohren, doch "
    "einzelne Woerter lassen sich nicht erkennen." );
  AddSound( "woerter",
    "Du kannst keine einzelnen Woerter aus dem Schreien heraus erkennen." );

  AddSmell( ({ DEFAULT_SMELL,"winterluft","luft" }),
    "Die Winterluft ist zwar kalt, trotzdem atmest Du sie tief ein." );
  AddSmell( ({ "holz","fichtenholz","geruch" }),
    "Das Holz der Pfaehle riecht sehr frisch, beinahe so, als ob die Baeume "
    "noch wachsen wuerden. Du willst diesen frischen Geruch in Dich "
    "aufnehmen, als Du ploetzlich einen Faeulnisgeruch wahrnimmst, der direkt "
    "von der Holzpalisade zu kommen scheint." );
  AddSmell( "faeulnisgeruch", #'fisch );
//ENDDETAILS

  AddSpecialExit( "osten", "raus" );
  AddSpecialExit( "suedosten", "raus" );
  AddExit( "hinten", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : "./hostplatz_a1",
          EX_MSG      : "hinter das Iglu" ]) );
  SetProp( P_HIDE_EXITS, ({ "hinten" }) );

  AddCmd( ({ "verrenk","verrenke" }), "cmd_verrenken" );
  AddCmd( CMD_GEHEN, "cmd_gehen" );
  AddCmd( ({ "reib","reibe" }), "cmd_reiben" );
  AddCmd( CMD_NEHMEN, "cmd_nehmen" );
  AddCmd( ({ "zaubre","zauber","zaubere" }), "cmd_zaubern" );
  AddCmd( CMD_GREIFEN, "cmd_greifen" );
}

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "Du kommst dort so nicht hin!\n" );
    return 0;
  }
  return 1;
}

//SPECIAL DETAILS
string detailSonne()
{
  if ( member(verrenkt,getuid(TP)) != -1 )
  {
    verrenkt -= ({ getuid(TP) });
    say( BS(
      TPN+" blickt fuer einen kurzen Augenblick gebannt in die hochstehende "
      "Sonne.") );
    return BS(
      "Da Du Dir zuvor den Kopf verrenkt hast, kannst Du direkt in der Sonne "
      "schauen. Du wendest Deinen Blick sofort wieder ab, bevor Du noch "
      "irgendwelche bleibenden Hornhautschaeden davontraegst." );
  }
  return BS(
    "Da die Sonne genau im Zenit steht, kannst Du sie auch nicht sehen, ohne "
    "Dir dabei den Kopf zu verrenken." );
}

string detailAbenteurer()
{
  switch ( TP -> QueryProp(P_XP) )
  {
    case 0..100000:
      return BS(
        "Dir fehlt noch einiges, um ein richtiger Abenteurer zu werden. Es "
        "kann natuerlich auch sein, dass Du das Forschen dem Toeten von "
        "anderen Lebewesen vorziehst." );
    break;
    case 100001..500000:
      return BS(
        "Du hast zwar schon ein paar Kaempfe miterlebt, aber Du bist noch "
        "lange nicht erfahren genug, um es gegen alle Feinde aufnehmen zu "
        "koennen." );
    break;
    case 500001..1000000:
      return BS(
	"Du weisst, was es heisst, den Tod vor Augen zu sehen, doch Du bist "
	"noch nicht so weit, um irgendwelche waghalsigen Selbstmordkommandos "
        "durchzufuehren." );
    break;
    case 1000001..5000000:
      return BS(
        "Du hast schon einige Erfahrung gemacht, was das Kaempfen anbelangt, "
        "und ebenfalls ein paar Tricks auf Lager, um auch staerkeren Gegnern "
        "das Fuerchten zu lehren." );
    break;
    case 5000001..10000000:
      return BS(
	"Du nimmst es bereits mit so ziemlich jedem Gegner im Silberland auf. "
	"Bei ein paar wuerdest Du noch von einem Angriff absehen, doch mit "
	"ein paar Freunden schaffst Du auch den staerksten Gegner." );
    break;
    case 10000001..50000000:
      return BS(
	"Du bist ein wackerer Abenteurer, der sich jeder Gefahr stellt. Deine "
        "Freunde koennen in einer sogar aussichtslosen Schlacht auf Dich "
        "zaehlen." );
    break;
    case 50000001..300000000:
      return BS(
        "Egal, wer Dir ueber den Weg laeuft, er wird von Dir in kleinste "
        "Stuecke zerlegt. Ob Drachen, Soordhin, Tireks oder Fraggle, Du "
        "schickst sie alle in die ewigen Jagdgruende." );
    break;
    default:
      return BS(
        "Du bist sicher einer der besten Abenteurer im Silberland. Dich kann "
        "nichts und niemand aufhalten, geschweige denn erschrecken." );
    break;
  }
}

string fisch(string key)
{
  if ( !fisch_weg )
  {
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " riecht den Kadaver.\n");
    fisch_gerochen += ({ getuid(TP) });
    return BS(
      "Du gehst naeher an die Holzpalisade heran und folgst dem Geruch, der "
      "Dir in die Nase gestiegen ist. Direkt neben der Palisade findest Du "
      "den Kadaver eines Fisches, von dem der Faeulnisgeruch ausgeht." );
  }
  return BS(
    "Du gehst zu der Holzpalisade hin, um herauszufinden, woher genau der "
    "Faeulnisgeruch kommt, doch Deine Nase hat Dir wohl einen Streich "
    "gespielt, denn Du findest absolut nichts an." );
}

string detailKadaver()
{
  if ( !fisch_weg && member(fisch_gerochen,getuid(TP)) != -1 )
  {
    return BS(
      "Jetzt siehst Du den Kadaver ganz genau. Der Fisch, dessen Gattung Du "
      "nicht erkennen kannst, ist ca. 30cm lang, und bis auf den Kopf des "
      "Fisches ist nichts mehr von ihm uebrig." );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

string detailSpalt()
{
  if ( spalt_da )
  {
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " findet einen Spalt.\n");
    return BS(
      "Du hast ja unwahrscheinliches Glueck, denn Du findest tatsaechlich "
      "einen urkleinen Spalt am Iglu, der aber schmaler als ein Blatt "
      "Papier ist." );
  }
  return BS(
    "Auch wenn Du noch so gern einen Spalt finden wuerdest, in den Du wie "
    "ueblich hineingreifen koenntest, um einen wunderbaren Gegenstand daraus "
    "hervor zu zaubern, so muss ich Dich schwer enttaeuschen, denn das Iglu "
    "wurde makellos und ohne Spalten errichtet." );
}

string detailGegenstand()
{
  if ( spalt_da )
  {
    return BS(
      "Nachdem Du jetzt eine Spalte an dem Iglu entdeckt hast, wuerdest Du "
      "nur allzu gern einen Gegenstand daraus hervorzaubern." );
  }
  return BS(
    "Du wuerdest schon gerne einen Gegenstand aus einer Spalte hervorzaubern, "
    "doch leider findest Du keine einzige Spalte an dem Iglu an. Das ist aber "
    "aeusserst schade." );
}
//END SPECIAL DETAILS
//COMMANDS
int cmd_verrenken(string str)
{
  notify_fail( "Wen oder was willst Du verrenken?\n" );

  if ( str == "kopf" )
  {
    if ( member(verrenkt,getuid(TP)) != -1 )
    {
      write( BS(
        "Du hast Dir Deinen Kopf schon komplett verrenkt. Es reicht schoen "
        "langsam.") );
      return -1;
    }
    write( BS(
      "Du verrenkst Deinen Kopf so, dass Du nun in die Sonne blicken kannst, "
      "die genau im Zenit steht.") );
    verrenkt += ({ getuid(TP) });
    call_out( "verrenkung", 8 );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " verrenkt sich den Kopf.\n");
    return 1;
  }
}
void verrenkung()
{
  if ( member(verrenkt,getuid(TP)) != -1 )
  {
    verrenkt -= ({ getuid(TP) });
    write( BS(
      "Du renkst Dir Deinen Kopf wieder ein, weil die Schmerzen schon zu "
      "gross werden.") );
  }
}       

int cmd_gehen(string str)
{
  notify_fail( "Wohin moechtest Du gehen?\n" );

  if ( member( ({ "um iglu","um iglu herum","hinter iglu"
                }),str) != -1 )
  {
    write(
      "Willst Du lieber links oder rechts um das Iglu gehen?\n" );
    return -1;
  }
  if ( member( ({ "links um iglu","links um iglu herum",
                  "rechts um iglu","rechts um iglu herum",
                  "um iglu links","um iglu links herum",
                  "um iglu rechts","um iglu rechts herum"
                }),str) != -1 )      
  {
    if ( member(fisch_gerochen,getuid(TP)) != -1 )
      fisch_gerochen -= ({ getuid(TP) });   
    write(
      "Du folgst den Spuren am Boden und gehst um das Iglu herum.\n" );
    TP -> move(ROOM "hostplatz_a1", M_GO,
     	       "hinter dem Iglu",
      	       "verschwindet",
      	       "kommt um das Iglu herum" );
    return 1;
  }
}
int cmd_reiben(string str)
{
  object wer, wen, wem, einzureibender;
  string was, womit;

  notify_fail( "Was willst Du von wem womit einreiben?\n" );

  if ( !str || str == "" ) return 0;
  if ( sscanf(str,"%s von %s %s ein", was, wer, womit) == 3 )
  {
    einzureibender = present(wer);
    if ( was == "gesicht" )
    {
      if ( member( ({ "mit schnee","mit neuschnee"}),womit) != -1 )
      {
      	if ( einzureibender )
        {
      	  if ( einzureibender == TP )
      	  {
      	    write( BS(
      	      "Weil Du grad lustig bist und sowieso von den anderen fuer "
      	      "leicht verrueckt angesehen wirst, nimmst Du ein Haeufchen "
      	      "Neuschnee und reibst Dir selbst das Gesicht damit ein.") );
      	    say( BS(
      	      TPN+" reibt sich grad selbst aus unerklaerlichen Gruenden das "
      	      "Gesicht mit Schnee ein.") );
      	    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      	      " reibt wen ein.\n");
      	    return 1;
          }
       	  write( BS(
      	    "Du fasst kurz in den Neuschnee, nimmst ein Haeufchen und "
      	    "reibst ganz hinterhaeltig das Gesicht von "+
      	    einzureibender->name(WEM)+" ein.") );
          tell_object( einzureibender,
      	    TPN+" reibt Dein Gesicht hinterhaeltig mit Neuschnee ein.\n" );
      	  tell_room( ENV(TP),
      	    TPN+" reibt das Gesicht von "+einzureibender->name(WEM)+
      	    " mit Schnee ein.\n",({ einzureibender, TP }) );
      	  write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      	    " reibt wen ein.\n");
          return 1;
        }
        write( BS(
          "Du kannst das Gesicht von "+wer+" gar nicht mit Schnee einreiben, "
          "weil "+wer+" gar nicht hier ist. So ein Pech aber auch!") );
        return -1;
      }
    }
  }
  if ( sscanf(str,"%s von %s ein", was, wer) == 2 )
  {
    einzureibender = present(wer);
    if ( was == "gesicht" )
    {
      if ( einzureibender == TP )
      {
      	write(
      	  "Womit willst Du Dir selbst das Gesicht einreiben?\n" );
      	return -1;
      }
      if ( einzureibender )
      {
        write(
          "Womit willst Du das Gesicht von "+einzureibender->Name(WEM)+
          " denn einreiben?\n" );
        return -1;
      }
      write( BS(
        "Ist nett, dass Du das Gesicht von "+wer+" einreiben willst, nur leider "
        "ist "+wer+" gar nicht da.") );
      return -1;
    }
  }
  if ( sscanf(str,"%s %s ein",was, womit) == 2 )
  {
    if ( was == "gesicht" &&
         member( ({ "mit schnee","mit neuschnee" }),womit) != -1 )
    {
      write(
        "Wem wuerdest Du gern das Gesicht mit Schnee einreiben?\n" );
      return -1;
    }
  }
  if ( sscanf(str,"%s %s ein", wer, womit ) == 2 )
  {
    einzureibender = present(wer);
    if ( member( ({ "mit schnee","mit neuschnee" }),womit) != -1 )
    {
      if ( einzureibender )
      {
        write(
      	  "Was genau an "+einzureibender->name(WEM)+" willst Du mit Schnee "
          "einreiben?\n" );
        return -1;
      }
      write(
        "Du kannst nicht jemanden mit Schnee einreiben, der gar nicht da "
        "ist.\n" );
      return -1;
    }
  }
  if ( sscanf(str,"%s ein", wer ) == 1 )
  {
    if ( einzureibender = present(wer) )
    {
      write(
        "Was genau an "+einzureibender->name(WEM)+" willst Du womit "
        "einreiben?\n" );
        return -1;
    }
    write(
      "Du kannst nicht jemanden einreiben, der gar nicht da ist.\n" );
    return -1;   
  }
}

int cmd_nehmen(string str)
{
  object fisch;

  if ( member( ({ "fischkadaver","kadaver","fisch" }),str) != -1 )
  {
    if ( !fisch_weg && member(fisch_gerochen,getuid(TP)) != -1 )
    {
      fisch = clone_object(OBJ "fkadaver");  
      if ( ME_TOO_HEAVY == fisch->move(TP,M_GET|M_SILENT) )
      {
        write( BS(
          "Du musst etwas ablegen, denn Du kannst den Fischkadaver nicht "
          "mehr tragen.") );
        fisch -> remove();
        return -1;
      }
      write( BS(
        "Du gehst zur Holzpalisade hin und hebst den uebelriechenden "
        "Fischkadaver auf.") );
      say(
        TPN+" hebt was Uebelriechendes vor der Holzpalisade auf.\n" );
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " hat den Fischkadaver genommen.\n");
      fisch_gerochen -= ({ getuid(TP) });
      fisch_weg = 1;
      return 1;
    }
  }
}

int cmd_zaubern(string str)
{
  object kristall;

  if ( TP->QueryProp(P_GENDER) == FEMALE )
    notify_fail( "Was moechtest Du machen grosse Zaubermeisterin?\n" );
  else
    notify_fail( "Was moechtest Du machen grosser Zaubermeister?\n" );

  if ( str == "gegenstand" || str == "gegenstand hervor" )
  {
    write(
      "Woraus moechtest Du einen Gegenstand zaubern?\n" );
    return -1;
  }
  if ( member( ({ "gegenstand aus spalte hervor",
                  "gegenstand aus spalte",
                  "gegenstand aus spalt hervor",
                  "gegenstand aus spalt"
                }),str) != -1 )
  {
    if ( spalt_da )
    {
      if ( kristallmenge )
      {
        kristall = clone_object(OBJ "eiskristall");  
        if ( ME_TOO_HEAVY == kristall->move(TP,M_GET|M_SILENT) )
        {
          write( BS(
            "Der zu hervorzaubernde Gegenstand ist wohl zu schwer, denn der "
            "Zaubertrick misslingt Dir.") );
          kristall -> remove();
          return -1;
        }
        write( BS(
          "Du machst ein paar wirre Handbewegungen, murmelst noch etwas "
          "Unverstaendliches dazu und ploetzlich hast Du einen Gegenstand aus "
          "der Spalte hervorgezaubert.") );
        say( BS(
          TPN+" macht ein paar wirre Handbewegungen, murmelt noch etwas "
          "Unverstaendliches dazu und setzt ploetzlich einen schelmischen "
          "Grinser auf, weil der Zaubertrick scheinbar funktioniert hat.") );
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " zaubert sich einen Eiskristall.\n");
        kristallmenge --;
        return 1;
      }
      write( BS(
        "Leider gelingt es Dir nicht, irgendetwas aus der Spalte hervor zu "
        "zaubern. Ich denke, dass Du sicher etwas falsch gemacht hast oder "
        "einfach einen schlechten Tag hattest.") );
      return -1;
    }
    write( BS(
      "Muss ich schon zugeben. Ist eine interessante Idee, die Du hast. "
      "Einfach einen beliebigen Gegenstand aus der Spalte hervorzuzaubern, "
      "doch eines hast Du dabei vergessen. Es gibt noch keine Spalte!") );
    return -1;
  }
  else if ( member( ({ "spalte","spalt" }),str) != -1 )
  {
    write(
      "Wo moechtest Du die Spalte hinzaubern?\n" );
    return -1;
  }
  else if ( member( ({ "spalte in iglu","spalt in iglu",
                       "spalte ins iglu","spalt ins iglu"
                     }),str) != -1 )
  {
    if ( spalt_da )
    {
      write(
        "Das Iglu hat schon einen magischen Spalt. Du brauchst keinen mehr zu "
        "zaubern.\n" );
      return -1;
    }
    write( BS(
      "Du machst ein paar wirre Handbewegungen und ploetzlich ist ein ganz "
      "kleiner Spalt im Iglu entstanden. Du haettest nie gedacht, dass solche "
      "Kraefte in Dir verborgen schlummern.") );
    say( BS(
      TPN+" macht ein paar eigenartige Handbewegungen und ploetzlich ist ein "
      "kleiner Spalt im Iglu.") );
    spalt_da = 1;
    if ( find_call_out("spalt_weg") == -1 )
    {
      spaltraum = ENV(TP);
      call_out( "spalt_weg", 7 );
    }
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " zaubert eine Spalte herbei.\n");
    return 1;
  }
}
void spalt_weg()
{
  spalt_da = 0;
    tell_room( spaltraum,
    "Der Spalt im Iglu verschwindet genauso ploetzlich, wie er zuvor "
    "entstanden ist.\n", ({ TP }) );
  if ( !objectp(TP) ) return;
  if ( ENV(TP) == spaltraum )
  {
    write( BS(
      "Der Spalt im Iglu verschwindet genauso ploetzlich, wie er zuvor "
      "entstanden ist.") );
    spaltraum = 0;
  }
  else
    return;
}

int cmd_greifen(string str)
{
  notify_fail( "Wohin moechtest Du schon wieder greifen, Du Grabscher?\n" );

  if ( member( ({ "in spalte","in spalten","spalte","spalten",
                  "in spalt","spalt","in spalte rein","in spalt rein"
                }),str) != -1 )
  {
    if ( spalt_da )
    {
      write(
        "Die Spalte am Iglu ist so klein, dass Du nicht einmal mit Deinem "
        "kleinen Finger hineinkommst.\n" );
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " will in Spalte greifen.\n");
      return 1;
    }
    write( BS(
      "Auch wenn Du noch so gern in irgendwelche Spalten reingreifen "
      "wuerdest, muss ich Dich dennoch enttaeuschen, denn das Iglu wurde "
      "einwandfrei gebaut und weist keinerlei Spalten auf.") );
    return -1;
  }
}
//END COMMANDS
int raus(string str)
{
  if ( member(fisch_gerochen,getuid(TP)) != -1 )
    fisch_gerochen -= ({ getuid(TP) }); 
  return ( TP->move(TOROOM[str], M_GO, "nach "+CAP(str)) );
}

void reset()
{
  ::reset();

  if ( fisch_weg ) fisch_weg = random(3);
  kristallmenge = random(4);
}

void BecomesNetDead(object spieler)
{
  fisch_gerochen -= ({ getuid(TP) });
}