    "einem Tor in dieser, und in dieser keine Pfaehle sind, "+bewegen+"st Du "
    "gleich nach Nordwesten weiter, um dort weiter zu zaehlen.") );
  pl -> move( "./hostplatz_a1", M_GO, "hinter dem Iglu im Nordwesten",
        "verschwindet","kommt um das Iglu herum" );
}
