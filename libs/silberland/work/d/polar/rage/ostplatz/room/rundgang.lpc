//Rundgang um Platz, Rage Feb 00

#include "../def.h"
#include <moving.h>


string bewegen;

void init()
{
  if ( TP -> QueryProp(P_RUNDGANG) )
    call_out( "weiter_gehts", 3, TP );
}

void weiter_gehts(object pl)
{
  write ("RUNDGANG: "+pl -> QueryProp(P_RUNDGANG)+"\n");
  switch ( pl -> QueryProp(P_RUNDGANG) )
  {
    case 1:
      call_out( "zaehlen11", 3, pl );
    break;
    case 2:
      call_out( "zaehlen21", 3, pl );
    break;
    case 3:
      call_out( "zaehlen31", 3, pl );
    break;
    case 4:
      call_out( "zaehlen41", 3, pl);
    break;
    case 5:
      call_out( "zaehlen51", 3, pl );
    break;
    case 6:
      call_out( "zaehlen61", 3, pl );
    break;
    case 7:
      call_out( "zaehlen71", 3, pl );
    break;
    case 8:
      call_out( "zaehlen81", 3, pl );
    break;
    case 9:
      write( BS(
        "Du schaetzt die Pfaehle hinter dem Lattenzaun auf 120 und kommst so "
        "auf 244 Pfaehle.") );
      say(
        TPN+" hat das Abzaehlen der Pfaehle der Holzpalisade beendet.\n" );
      pl -> SetProp( P_RUNDGANG, -1 );
      pl -> move( "./ostplatz_d1", M_GO );
    break;
    default:
      write( "Da ist ein schwerer Fehler!\n" );
    break;
  }
  pl -> SetProp( P_RUNDGANG, pl->QueryProp(P_RUNDGANG)+1 );
}
string bewegungen()
{
  switch ( TP -> QueryProp(P_RACE) )
  {
    case "fee":
      bewegen = "flatter";
    break;
    case "dunkelelf":
      bewegen = "schleich";
    break;
    case "troll":
      bewegen = "trampel";
    break;
    case "oger":
      bewegen = "stapf";
    break;
    default:
      bewegen = "geh";
    break;
  }
  return bewegen;
}
void zaehlen11(object pl)
{
  bewegungen();
  write(
    "16, 17,...\n\n"
    "Du "+bewegen+"st am Tor in der Holzpalisade weiter und zaehlst auf der "
    "anderen Seite weiter.\n" );
  say( BS(
    TPN+" murmelt ein paar Zahlen, "+bewegen+"t am Tor vorbei und zaehlt "
    "auf der anderen Seite weiter.") );
  call_out( "zaehlen12", 3, pl );
}
void zaehlen12(object pl)
{
  write(
    "          18, 19...\n\n" );
  say(
    TPN+" murmelt ein paar Zahlen vor sich dahin.\n" );
  bewegungen();
  write(
    "Du "+bewegen+"st nach Sueden, um dort weiter zu zaehlen.\n" );
  pl -> move( "./ostplatz_d3", M_GO, "nach Sueden, um dort weiter zu "
        "zaehlen" );
}
