//SPECIAL DETAILS
string detailWieselspur()
{
  if ( member(spur_gefunden,getuid(TP)) != -1 )
  {
    return BS(
      "Die Spur sieht einer Wieselspur zum Verwechseln aehnlich. Wenn Du "
      "Glueck hast, kommst Du sogar dahinter, wer hinter den Spuren steckt. "
      "Du brauchst nur draufkommen, wohin sie fuehren, dann weisst Du sicher "
      "mehr." );
  }
  return BS(
    "Eine derartige Spur kannst Du nirgends sehen." );
}

string detailKinderspur()
{
  if ( member(kinderspur_gefunden,getuid(TP)) != -1 )
  {
    return BS(
      "Jetzt, wo Du Dir die Kinderspur genauer ansiehst, faellt Dir auf, "
      "dass hier irgendwo ein Kind sein muss, das als einziges Fellstiefel "
      "traegt, denn die anderen Kinderspuren weisen eindeutig darauf hin, "
      "dass die Kinder -wie auch die Erwachsenen- sich barfuss fortbewegen." );
  }
  return BS(
    "Du musst zuerst eine Spur von einem Kind finden, bevor Du sie "
    "untersuchen kannst." );
}

string detailWache()
{
  call_other( ROOM "wachturm","???" );
  if ( find_object(ROOM "wachturm") &&
      present("\nwachposten",find_object(ROOM "wachturm")) )
    return BS(
      "Ein kraeftiger Xandim haelt Wache auf der Plattform des Turmes und "
      "spaeht dabei immer wieder ueber die Holzpalisade nach Osten." );
  return BS(
    "Derzeit ist keine Wache auf dem Wachturm oben." );
}

string detailWachturm()
{
  string text;
  
  text = "Auf vier Pfeilern aus Holz, die beinahe gleich lang sind, wie die "
         "Holzpalisade hoch ist, liegt eine Plattform, auf der ein Gelaender "
         "befestigt wurde. In den Ecken der Plattform sind weitere vier "
         "Pfeiler, die das Dach des Turmes tragen. Auf der Dir abgewandten "
         "Seite fuehrt eine Leiter nach oben, damit man den Turm ohne "
         "Probleme besteigen kann.";
  
  call_other( ROOM "wachturm","???" );
  if ( find_object(ROOM "wachturm") &&
      present("\nwachposten",find_object(ROOM "wachturm")) )
   text += " Auf der Plattform des Turmes scheint ein Wachposten Wache zu "
           "halten.";
  return BS(text);
}

string detailLeiter()
{
  object leiter;
  
  call_other( ROOM "ostplatz_d2","???" );
  if ( find_object(ROOM "ostplatz_d2") &&
      (leiter=present("\nwachturmleiter", find_object(ROOM "ostplatz_d2"))) &&
       (leiter->leiter_an_ort()) )
    return BS(
      "Eine Leiter wurde an der Dir abgewandten Seite angelehnt, damit man "
      "ohne Schwierigkeiten auf den Wachturm raufsteigen kann." );
  return
    "Die Leiter liegt neben dem Wachturm und muss wohl umgefallen sein.";
}

string detailHunde()
{
  string text;

  text = "Die meisten liegen nur im Schnee, doch ein paar wirken ziemlich "
         "aufgeregt, weil sie staendig hin und her gehen. Anscheinend wittern "
         "sie, dass es bald wieder Zeit fuer die Baerenjagd ist.";

  if ( hund_da )
    text += " Ein anderer hingegen liegt mit dem Ruecken auf dem Schnee und "
            "laesst sich von ein paar Kinder streicheln.";
  return BS(text);
}

string detailHund()
{
  if ( hund_da )
    return BS(
      "Ein Schlittenhund liegt auf dem Ruecken und laesst sich seinen Bauch "
      "von ein paar Kindern streicheln, die nicht die geringste Angst vor "
      "dem Hund haben." );
  return BS(
    "Ein Schlittenhund gleicht dem anderen oder anders gesagt: fuer Dich "
    "sehen sie alle gleich aus." );
}

string detailBauch()
{
  if ( hund_da )
    return BS(
      "Der Schlittenhund laesst sich den Bauch von ein paar Kindern "
      "streicheln. Von Deinem fangen wir am besten gar nicht zu sprechen "
      "kann." );
  return BS(
    "Du kraulst Dir einmal selbst den Bauch, weil es sonst niemand bei Dir "
    "tut." );
}

string detailRuecken()
{
  if ( hund_da )
    return BS(
      "Der Schlittenhund liegt auf dem Ruecken und deshalb ist er nicht zu "
      "sehen. Und Deinem geht es zum Glueck auch ganz gut, was verwunderlich "
      "ist bei der Last, die Du mit Dir herumschleppst." );
  return BS(
    "Du wirst Dir schwer dabei tun, den eigenen Ruecken anzusehen." );
}

string detailAngst()
{
  if ( hund_da )
    return BS(
      "Du wirst doch keine Angst davor haben, einem Schlittenhund den Bauch "
      "zu streicheln. Der Hund liegt ja ganz friedlich da." );
  return BS(
    "Angst? So was kennst Du doch gar nicht oder etwa doch?" );
}

int filterfun(object ob)
{
  if ( ob->QueryProp(P_SHORT) == 0 ) return 0;
  return 1;
}
string detailLast()
{
  object *last;
  int i;
  string *artikel;
  string str;

  last = filter_array(all_inventory(TP),"filterfun");
  switch( i=sizeof(last) )
  {
    case 0:
    break;
    case 1:
      str = "Du schleppst "+last[i]->name(WEN)+".";
    break;
    default :
      str = "Du schleppst ";
      for ( i=0; i<sizeof(last)-2; i++ )
      {
        str = str+last[i]->name(WEN)+", ";
      }
      str = str+last[i]->name(WEN)+" und "+
            last[i+1]->name(WEN)+" mit Dir herum.";
      artikel = new_explode( str, "Ein" );
      str = implode( artikel, "ein" );
      artikel = new_explode( str, "Der" );
      str = implode( artikel, "der" );
      artikel = new_explode( str, "Die" );
      str = implode( artikel, "die" );
      artikel = new_explode( str, "Das" );
      str = implode( artikel, "das" );
    break;
  }  
  return BS( str );
}

string detailSchema()
{
  string text;
  
  text = "Du gehst zur Holzpalisade hin und versuchst den Verlauf eines "
         "Seils zu verfolgen, was Dir am Anfang noch gut gelingt, doch "
         "nach der vierten Windung hast Du die Uebersicht komplett "
         "verloren.";
  if ( seil_da )
  {
    text += " Aber Deine Muehen hatten auch ihre gute Seite, denn bei der "
            "letzten Windung steht etwas von einem Seil weg.";
  }
  else
  {
    text += " Deine Muehen hatten auch Vorteile, denn Du meinst, dass Dir "
            "etwas sehr merkwuerdig vorkommt. Es scheint etwas zu fehlen.";
  }
  return BS( text );
}

string detailWindung()
{
  string text;
  
  text = "Du verfolgst die Windungen eines Seils, doch bei der vierten bist "
         "Du Dir nicht mehr sicher, ob es sich noch um dasselbe Seil handelt "
         "oder bereits um ein anderes. ";
  if ( seil_da )
    text += "Dafuer faellt Dir allerdings auf, dass bei einem Seil eine "
            "Schnur oder etwas aehnliches wegsteht.";
  else
    text += "Du bist Dir allerdings sicher, dass in der Palisade ein Seil "
            "fehlt, denn beim Schema der Windungen stimmt eindeutig etwas "
            "nicht. Am besten meldest Du das einem Xandim, damit das "
            "schleunigst behoben wird. Sonst haelt die Palisade gerade wegen "
            "dieses Fehlers dem naechsten Schneesturm nicht Stand.";
//Xandimmeldung!!!!
  return BS( text );
}

string detailEtwas()
{
  if ( seil_da )
  { 
    return BS(
      "Das Etwas entpuppt sich als Schnur, die mitten aus den Windungen "
      "hervor schaut." );
  }
  return BS(
    "Jetzt weisst Du, was das etwas ist, das hier fehlt. Ein Seil ist "
    "irgendwie aus der Holzpalisade abhanden gekommen. Melde doch am "
    "besten einem Xandim diesen Fehler, damit die Sicherung der Palisade "
    "wieder schnell hergestellt wird." );
}

string detailSchnur()
{
  if ( seil_da )
  {
    return BS(
      "Dort, wo die Seile genau durch die Pfaehle durchgefuehrt werden, "
      "steht ein Stueck Schnur hervor. Ob es zu einem der Seile gehoert?" );
  }
  return "Sowas siehst Du da nicht!\n";
}

string detailSeil()
{
  if ( member( seil_gefunden,getuid(TP) ) != -1 )
  {
    return BS(
      "Dieses Seil scheint ein bisschen locker in der Holzpalisade zu sein." );
  }
  return BS(
    "Mit diesen werden die Pfaehle der Holzpalisade zusaetzlich zusammen "
    "gehalten. Sie sind einmal in einem Meter Hoehe und ein weiteres Mal bei "
    "zwei Meter um die Pfaehle gewickelt worden, aber das Schema, das "
    "dahinter steckt, kannst Du einfach nicht erkennen." );
}

string detailLattenzaun()
{
  string text;
  
  text = "Der Lattenzaun ist recht schlicht, erfuellt allerdings dafuer "
         "seinen Zweck. Kleine Pfosten wurden in Abstaenden von drei "
         "Metern in den Boden geschlagen, und an diese wurden Holzbretter "
         "mit deren Enden befestigt.";
  if ( fell_auf_zaun )
    text += " Ueber den Lattenzaun hat jemand ein Wolfsfell gelegt.";
  return BS( text );
}

string detailWolfsfell()
{
  if ( fell_auf_zaun )
  {
    if ( verstaubt )
      return BS(
        "Das raeudige Wolfsfell, das ueber den Lattenzaun gelegt wurde, "
        "sieht ziemlich verstaubt aus. Vielleicht solltest Du es einmal "
        "ausklopfen!" );
    return BS(
      "Ueber den Lattenzaun wurde ein raeudiges Wolfsfell gelegt. Es ist "
      "ganz sauber und man koennte fast meinen, dass es erst vor "
      "kurzem ausgeklopft wurde." );
  }
  return BS(
    "Hier laufen Hunde herum und keine Woelfe, folglich kannst Du "
    "auch kein Wolfsfell sehen." );
}
//END SPECIAL DETAILS

//COMMANDS
int cmd_lehnen(string str)
{
  notify_fail( "Woran moechtest Du Dich lehnen?\n" );
  
  if ( member( ({ "zaun","lattenzaun",
                  "an zaun","an lattenzaun"
                }),str) != -1 )
  {
    write( BS(
      "Da Du siehst, dass der Lattenzaun zeitweise recht morsch ist, siehst "
      "Du davon ab, Dich an den Zaun zu lehnen. Schliesslich willst Du ja "
      "nicht schuld dran sein, dass der Zaun womoeglich ruiniert wird.") );
    say( BS(
      TPN+" geht zum Lattenzaun hin, macht Anstalten, sich daran anzulehnen, "
      "und ueberlegt es sich im letzen Augenblick doch noch anders.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " will sich an Zaun lehnen.\n");
    return 1;
  }
}

int cmd_streicheln(string str)
{
  object hund;
  string was, wem, nm;

  notify_fail( "Was willst Du von wem streicheln?\n" );

  if ( !str || str=="" ) return 0;
  if ( member( ({ "schlittenhund","hund","husky" }), str) != -1 )
  {
    write(
      "Was willst Du am Schlittenhund streicheln?\n" );
    return -1;
  }
  if ( sscanf(str,"%s vo%s %s", was, nm, wem) != 3 ) return 0;
  if ( member( ({ "m","n" }), nm) == -1 ) return 0;
  if ( was == "bauch" )
  {
    if ( member( ({ "schlittenhund","hund","husky" }),wem) != -1 )
    {
      if ( hund_da )
      {
        if ( random(3) )
	{
          write( BS(
            "Du streichelst den Bauch von einem Schlittenhund, worauf der "
            "mit seinem Schwanz zu wedeln beginnt und Dich mit grossen Augen "
            "ansieht. Das hat ihm sicherlich gut gefallen.") );
          say( BS(
            TPN+" streichelt den Bauch eines Hundes, der mit dem "
            "Ruecken im Schnee liegt.") );
          return 1;
        }
        hund_da = 0;
        hund = clone_object(NPC "faulerhusky");
        hund -> move(TO,M_NOCHECK|M_SILENT);
        hund -> Kill(TP);
        write( BS(
          "Gerade als Du dem Schlittenhund den Bauch streicheln willst, "
          "bellt dieser Dich an, springt auf und greift Dich an.") );
        say( BS(
          TPN+" versuchte einen Hundeschlitten zu streicheln, hat diesen "
          "allerdings in seiner Ruhe gestoert und wird deshalb von ihm "
          "angegriffen.") );
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " findet Husky.\n");
        return 1;
      }
      write( BS(
        "Es laesst sich derzeit kein Schlittenhund von Dir am Bauch "
        "streicheln, weil alle herumlaufen und Du keinen zu fassen "
        "kriegst.") );
      return -1;
    }
    write(
      "Von wem wuerdest Du gerne den Bauch streicheln?\n" );
    return -1;
  }
}

int cmd_ritzen(string str)
{
  object ob;
  
  ob = TP->QueryProp(P_WEAPON);
  str = TP->_unparsed_args();

  notify_fail("Was moechtest Du auf das Holzbrett ritzen?\n ");
  
  if( !str ) return 0;
  if( !present("messer",TP) )
  {
    tell_object(TP,
      "Du hast doch gar kein Messer bei Dir.\n");
    return 1;
  }
  if( !objectp(ob) )
  {
    write(
      "Du hast ja gar nichts gezueckt, womit Du etwas ritzen koenntest.\n" );
    return -1;
  }
  if( !ob->id("messer") )
  {
    write( BS(
      "Das Messer zu zuecken, koennte sich als aeussert vorteilhaft "
      "herausstellen.") );
    return -1;
  }
  if ( btextzaehler > 9 )
  {
    write( BS(
      "In das Brett wurden schon soviele Texte geritzt, dass fuer Deinen "
      "leider kein Platz mehr ist. Versuch es doch spaeter!") );
     return -1;
  }
  write( BS(
    "Voller Elan und ueberschwenglicher Freude ritzt Du Deinen Text in das "
    "Holzbrett ein.") );
  if ( strlen(str) > 35 )
  {
    write( BS(
      "Nach dem 35. Buchstaben bist Du so vom Ritzen erschoepft, dass Du "
      "Deinen Text nicht vollenden kannst.") );
    TP -> do_exhaust(30);
    str = str[0..34];
  }
  say(
    TPN+" ritzt etwas in einem Holzbrett am Lattenzaun ein.\n" );
  pos = random(sizeof(alle_positionen));
  btext[alle_positionen[pos]] = str;
  alle_positionen -= ({ alle_positionen[pos] });
  btextzaehler++;
  write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
    " ritzt etwas ins Holzbrett.\n");
  return 1;
}
string bretttext()
{
  int i;
  string gesamttext;
  
  gesamttext = "+---------------------------------------------------------------------------+\n";
  gesamttext += sprintf( "|                    %55-s|\n",btext[0]);
  gesamttext += sprintf( "|                                     %38-s|\n",btext[1]);
  gesamttext += sprintf( "|%75-s|\n",btext[2]);
  gesamttext += sprintf( "|           %64-s|\n",btext[3]);
  gesamttext += sprintf( "|     %70-s|\n",btext[4]);
  gesamttext += sprintf( "|                       %52-s|\n",btext[5]);
  gesamttext += sprintf( "|                                   %40-s|\n",btext[6]);
  gesamttext += sprintf( "|   %72-s|\n",btext[7]);
  gesamttext += sprintf( "|                              %45-s|\n",btext[8]);
  gesamttext += sprintf( "|                         %50-s|\n",btext[9]);
  gesamttext += "+---------------------------------------------------------------------------+\n";
  return gesamttext;
}

int cmd_studieren(string str)
{
  object wen, *zuseher;
  int i, zufall;
  
  notify_fail( "Von wem willst Du das Verhalten studieren?\n" );

  if ( !str || str == "" ) return 0;
  if ( str == "verhalten" )
  {
    write( BS(
      "Welches Verhalten willst Du studieren? Dein eigenes, das eines "
      "Spielers oder jenes von den Rentieren?") );
    return -1;
  }
  if ( member( ({ "rentiere","rentier" }), str) != -1 )
  {
    write(
      "Willst Du das Verhalten der Rentiere studieren?\n" );
    return -1;
  }
  if ( member( ({ "verhalten von den rentieren",
                  "verhalten von rentieren",
                  "verhalten von rentiere"
                }), str) != -1 )
  {
    write( BS(
      "Um das Verhalten der Rentiere zu studieren, willst Du Dich an den "
      "Lattenzaun lehnen, doch dann siehst Du, dass die oberste "
      "Bretterreihe ziemlich morsch aussieht. Und einfach so im Schnee "
      "stehen und zusehen, gefaellt Dir im Moment auch nicht. Aber der Zaun "
      "geht ohnehin in Richtung Westen noch weiter und wer weiss, "
      "vielleicht ergibt sich dort eine bessere Moeglichkeit.") );
    say( BS(
      TPN+" will sich an den Lattenzaun anlehnen, um die Rentiere zu "
      "beobachten, aber "+TP->QueryPronoun(WER)+" ueberlegt es sich dann "
      "doch anders.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " studiert Rentierverhalten.\n");
    return 1;
  }
  if ( member( ({ "verhalten von dir selbst",
                  "verhalten von dir",
                  "eigenes verhalten",
                  "dein eigenes verhalten"
                }), str) != -1 )
  {
    write( BS(
      "Du siehst Dich kurz selbst an und stellst, nicht weiter "
      "ueberraschend, fest, dass Du gerade jetzt, exakt in diesem "
      "Moment des Augenblicks Dich selbst beim Studieren Deines "
      "Dir eigenen Verhaltens ertappt hast.") );
    say(
      TPN+" erforscht gerade "+TP->QueryPossPronoun(NEUTER,WER,SINGULAR)
      +" eigenes Verhalten.\n");
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " studiert eigenes Verhalten.\n");
    return 1;
  }
  if ( sscanf(str,"verhalten von %s",str) != 1 ) return 0;
  wen = present(str,TO);
  if ( !wen )
  {
    write(
      "Du kannst "+CAP(str)+" nirgends sehen.\n" );
    return -1;
  }
  if ( wen && interactive(wen) )
  {
    write(
      "Angestrengt studierst Du das Verhalten von "+CAP(str)+".\n" );
    tell_object( wen,
      TPN+" scheint Dich ganz genau zu beobachten.\n" );
    zufall = random(10);
    switch ( zufall )
    {
      case 0:
        write( BS(
          "Du ertappst "+CAP(str)+" gerade dabei, wie "+wen->QueryPronoun(WER)+
          " ungeniert in "+(wen->QueryPossPronoun(FEMALE,WEM,SINGULAR))+
          " Nase bohrt.") );
        tell_object( wen,
          CAP(TP->QueryPronoun(WER))+" ertappt Dich gerade beim Nasebohren.\n" );
      break;
      case 1:
        write( BS(
          CAP(wen->QueryPronoun(WEM))+" muss es wohl fad sein, denn "+
          wen->QueryPronoun(WER)+" steht nur in der Gegend rum und blickt "
          "sich planlos um.") );
        tell_object( wen, BS(
          "Viel lernen wird "+TP->QueryPronoun(WER)+" dabei nicht, denn Du "
          "machst im Moment ueberhaupt nichts.") );
      break;
      case 2:
        write( BS(
          CAP(wen->QueryPronoun(WER))+" richtet sich gerade die Frisur "
          "zurecht. Du denkst . o O ("+CAP(str)+" hat wohl auch nichts "
          "besseres zu tun?)") );
        tell_object( wen, BS(
          "Du denkst . o O (Was findet "+TPN+" so interessant daran, wenn ich "
          "mir die Haare richte?)") );
      break;
      case 3:
        write( BS(
          CAP(wen->QueryPronoun(WER))+" ueberprueft in aller Ruhe "+
          (wen->QueryPossPronoun(FEMALE,WEN,SINGULAR))+" Ausruestung, "
          "wahrscheinlich, um sich auf eine groessere Reise vorzubereiten.") );
        tell_object( wen, BS(
          CAP(TP->QueryPronoun(WER))+" scheint es interessant zu finden, "
          "Dich beim Ueberpruefen Deiner Ausruestung zu beobachten.") );
      break;
      case 4:
        if ( wen->QueryProp(P_GENDER) == MALE )
        {
          write( BS(
            "Das gibt es doch nicht. "+CAP(str)+" will doch tatsaechlich "
            "neben der Holzpalisade hinpinkeln.") );
          tell_object( wen, BS(
            "Mist! Ich wollte gerade neben der Holpalisade hinpinkeln. "+
            TPN+" soll gefaelligst woanders hinsehen.") );
        }
        else
        {
          write( BS(
            "Sie muss wohl schon ziemlich dringend auf die Toilette, denn sie "
            "kneift schon ganz verbissen ihre Beine zusammen.") );
          tell_object( wen, BS(
            "Du muesstest schon ganz dringend mal aufs WC. Hoffentlich merkt "
            "es "+TPN+" Dir nicht an, dass Du schon so verkniffen die Beine "
            "zusammenkneifst.") );
        }
      break;
      case 5:
        write( BS(
          CAP(wen->QueryPronoun(WER))+" kratzt sich zum wiederholten Male den "
          "Hintern. Du musst unwillkuerlich grinsen.") );
        tell_object( wen, BS(
          "Kratze Dir den Hintern besser dann, wenn Dich "+TPN+" nicht mehr "
          "beobachtet. "+CAP(TP->QueryPronoun(WER))+" grinst schon hinter "+
          (TP->QueryPossPronoun(FEMALE,WEM,SINGULAR))+" vorgehaltenen "
          "Hand.") );
      break;
      case 6:
        write( BS(
          "Dir faellt auf, dass "+CAP(str)+" beim Gehen die Arme im gleichen "
          "Rhythmus schwingt, wie er die Beine bewegt. Nun gut, soll es "
          "jeder machen, wie es einem gefaellt.") );
        tell_object( wen, BS(
          CAP(TP->QueryPronoun(WER))+" sieht Dir ganz genau beim Gehen zu. "
          "Wahrscheinlich hat "+TP->QueryPronoun(WER)+" es nie richtig "
          "gelernt und nimmt deshalb bei Dir Nachhilfe.") );
      break;
      case 7:
        write( BS(
          CAP(str)+" massiert sich staendig den Nacken. Wahrscheinlich hat "+
          wen->QueryPronoun(WER)+" letzte Nacht nicht gut geschlafen. Du "
          "koenntest "+wen->QueryPronoun(WEM)+" netterweise die Arbeit "
          "erleichtern.") );
        tell_object( wen, BS(
          "Als Du merkst, dass Dir "+TPN+" zusieht, massierst Du Dir so "
          "auffaellig den Nacken, weil Du hoffst, dass "+TP->QueryPronoun(WER)+
          " das fuer Dich macht.") );
      break;
      case 8:
        write( BS(
          CAP(wen->QueryPronoun(WER))+" kramt verzweifelt in "+
          (wen->QueryPossPronoun(MALE,WEM,PLURAL))+
          " Ausruestungsgegenstaenden herum. Was "+wen->QueryPronoun(WER)+
          " bloss nur sucht? Wahrscheinlich ein Taschentuch, denn "+
          wen->QueryPronoun(WER)+" wischt sich "+
          (wen->QueryPossPronoun(FEMALE,WER,SINGULAR))+" laufende Nase "
          "mit dem Handruecken weg.") );
        tell_object( wen, BS(
          "Deine Nase rinnt schon wieder einmal und Du findest kein "
          "Taschentuch. "+TPN+" faellt auch schon auf, dass Du verzweifelst "
          "nach etwas suchst. Sag "+TP->QueryPronoun(WEM)+" doch, dass Du "
          "ein Taschentuch brauchst.") );
      break;
      case 9:
        write( BS(
          CAP(wen->QueryPronoun(WER))+" hat den Kopf zurueckgelegt, "
          "betrachtet den Himmel und seufzt dabei auf. "+
          CAP(wen->QueryPossPronoun(MALE,WEM,SINGULAR))+" Gesichtsausdruck "
          "nach sieht es so aus, als ob "+wen->QueryPronoun(WER)+
          " irgendwo dort oben eine Antwort finden koennte.") );
        tell_object( wen, BS(
          "Ich will nur einmal die Sonnenstrahlen geniessen und mir ein "
          "paar Gedanken durch den Kopf gehen lassen, da muss mir "+TPN+
          " dabei zusehen. Hat "+wen->QueryPronoun(WER)+" nichts besseres "
          "zu tun?") );
      break;
    }
    tell_room( ENV(TP),
      TPN+" studiert das Verhalten von "+CAP(str)+" ganz genau.\n",
      ({ wen,TP }) );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " studiert Spielerverhalten.\n");
    return 1;
  }
}

int cmd_beobachten(string str)
{
  notify_fail( "Wen oder was willst Du beobachten?\n" );
  
  if ( member( ({ "rentier","rentiere","verhalten der rentiere"
                }),str) != -1 )
  {
    write( BS(
      "Irgendwie macht Dir das Beobachten der Rentiere keinen Spass. "
      "Um wirklich mehr von dem Verhalten der Rentiere zu erfahren, "
      "muesstest Du schon etwas anderes machen.") );
    say( BS(
      TPN+" blickt kurz ueber den Lattenzaun zu den Rentieren, wendet "
      "sich aber gleich wieder ab.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " beobachtet die Rentiere.\n");
    return 1;
  }    
}

int cmd_ziehen(string str)
{
  object seil;
  int zufall;
  
  notify_fail( "Woran willst Du ziehen?\n" );

  if ( member( ({ "schnur","an schnur" }), str) != -1 )
  {
    if ( seil_da )
    {
      write( BS(
        "Du ziehst kurz an der Schnur an und erkennst, dass es sich um "
        "einen Teil eines Seils handelt.") );
      say(
        TPN+" schaut sich an der Holzpalisade etwas genauer an.\n" );
      seil_gefunden += ({ getuid(TP) });
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " zieht an einer Schnur.\n");
      return 1;
    }
    write( BS(
      "Hier ist weit und breit keine Schnur, an der Du ziehen koenntest.") );
    return -1;
  }
  else if ( member( ({ "seil","an seil","am seil" }), str) != -1 )
  {
    if ( member( seil_gefunden,getuid(TP) ) == -1 )
    {
      write(
        "Du findest kein Seil, an dem Du ziehen koenntest.\n" );
      return -1;
    }
    if ( seil_da )
    {
      write( BS(
        "Du ziehst am Seil, aber so leicht kriegst Du das auch wieder "
        "nicht aus der Holzpalisade heraus. Ohne Kraftaufwand wird sich "
        "das Seil keinen Millimeter ruehren.") );
      return -1;
    }
    write(
      "Leider ist hier kein Seil, an dem Du ziehen koenntest.\n" );
    return -1;
  }
  else if ( member( ({ "mit gewalt an seil","mit gewalt am seil",
                       "kraeftig am seil","kraeftig an seil"
                     }), str) != -1 )
  {
    if ( member( seil_gefunden,getuid(TP) ) == -1 )
    {
      write(
        "Du findest kein Seil, an dem Du ziehen koenntest.\n" );
      return -1;
    }
    if ( seil_da )
    {
      if ( TP->QueryAttribute(A_STR) > 19 )
        zufall = 5;
      else
        zufall = 10;
      if ( !random(zufall) )
      {
        seil = clone_object("obj/seil");
        if ( ME_TOO_HEAVY == seil->move(TP,M_GET|M_SILENT) )
        {
          write(
            "Das Seil kannst Du nicht mehr tragen!\n" );
          seil -> move(ENV(TP));
          return -1;
        }
        write( BS(
          "So stark Du kannst, ziehst Du am Seil, und ... endlich gibt es "
          "nach und nach ein paar kraeftigen Zuegen haeltst Du es in "
          "Haenden.") );
        say( BS(
          TPN+" reisst und ruettelt solange an der Holzpalisade herum, "
          "bis "+TP->QueryPronoun(WER)+" ein Seil in Haenden haelt.") );
        seil_da = 0;
        seil_gefunden -= ({ getuid(TP) });
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " findet ein Seil.\n");
        return 1;
      }
      write( BS(
        "So stark Du kannst, ziehst Du am Seil, und ... es ruehrt sich "
        "trotzdem keinen Millimeter von Stelle.") );
      say( BS(
        TPN+" reisst und ruettelt an der Holzpalisade herum, ohne "
        "irgendetwas dabei zu erreichen.") );
      return -1;
    }
    write(
      "Leider ist hier kein Seil, an dem Du ziehen koenntest.\n" );
    return -1;
  }     
}
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, this_object(), "freeze_in_place"}) );
}
string freeze_in_place()
{
  return "Du zaehlst gerade die Pfaehle!\n";
}


int cmd_zaehlen(string str)
{
  mixed res;

  notify_fail( "Ja, du kannst zaehlen. Aber was genau willst Du nun "
               "abzaehlen?\n" );

  if ( member( ({ "holzpfaehle","pfaehle" }),str) != -1 )
  {
    write(
      "Willst Du die Holzpfaehle abzaehlen?\n" );
    return -1;
  }
  if ( member( ({ "holzpfaehle ab","pfaehle ab" }),str) != -1 )
  {
    write( BS(
      "Willst Du die Holzpfaehle wirklich einzeln abzaehlen? Das kann schon "
      "einige Zeit brauchen!") );
    return -1;
  }
  if ( member( ({ "holzpfaehle einzeln ab","pfaehle einzeln ab" }),str) != -1 )
  {
    if ( res=TP->QueryProp(P_TMP_MOVE_HOOK) )
    {
      if ( pointerp(res) && sizeof(res) >= 3
           && intp(res[0]) && time() < res[0]
           && objectp(res[1]) && stringp(res[2]) )
      {
        if ( res[1] == TO )
        {
          notify_fail( "Du zaehlst die Pfaehle schon ab!\n");
          return 0;
        }
        else
        {
           notify_fail("Irgendwie kannst Du Dich derzeit nicht bewegen!\n");
           return 0;
        }
      }
    }
    write( BS(
      "Nachdem es Dir gerade sehr fad ist, beginnst Du damit, die Holzpfaehle "
      "in der Holzpalisade einzeln abzuzaehlen.") );
    say( BS(
      TPN+" geht zur Holzpalisade und scheint dort die Pfaehle abzaehlen zu "
      "wollen.") );
    paralyze (10, TP);
    if ( find_call_out("zaehlStart") == -1 )
      call_out( "zaehlStart", 3, TP );
    // Funktion zum Festhalten von Gegnern
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " zaehlt die Holzpfaehle.\n");
    return 1;
  }
}
void zaehlStart()
{
  write(
    "Du zeigst auf die einzelnen Pfaehle und zaehlst laut mit.\n\n"
    "1, 2, 3, 4, 5,...\n" );
  say(
    TPN+" murmelt ein paar Zahlen vor sich dahin.\n" );
  if ( find_call_out("weiterzaehlen") == -1 )
    call_out( "weiterzaehlen", 3, TP );
}
void weiterzaehlen()
{
  write(
    "                 6, 7, 8, 9, 10,...\n" );
  say(
    TPN+" murmelt ein paar Zahlen vor sich dahin.\n" );
  if ( find_call_out("weiterzaehlen2") == -1 )
    call_out( "weiterzaehlen2", 3, TP );
}
void weiterzaehlen2()
{
  write(
    "                                   11, 12, 13, 14, 15,...\n\n" );
  say(
    TPN+" murmelt ein paar Zahlen vor sich dahin.\n" );
  write(
    "Irgendwie ist Dir das Zaehlen doch zu bloed und Du brichst es lieber "
    "ab.\n" );
  //if ( find_call_out("weiterzaehlen3") == -1 )
  //  call_out( "weiterzaehlen3", 2, TP );
}
void weiterzaehlen3()
{
  string bewegen;

  TP -> SetProp( P_RUNDGANG, 1 );
  switch ( TP->QueryProp(P_RACE) )
  {
    case "fee":
      bewegen = "flatterst";
    break;
    case "dunkelelf":
      bewegen = "schleichst";
    break;
    case "troll":
      bewegen = "trampelst";
    break;
    case "oger":
      bewegen = "stapfst";
    break;
    default:
      bewegen = "gehst";
    break;
  }  
  write( "Du "+bewegen+" nach Sueden, um dort weiter zu zaehlen.\n" );
  TP -> move( ROOM "ostplatz_d2", M_GO, "nach Sueden, um dort weiter zu "
        "zaehlen" );
}

int cmd_messen(string str)
{
  notify_fail( "Was willst Du abmessen?\n" );
  
  if ( member( ({ "neuschneeschicht","schneeschicht",
                  "neuschneeschicht ab","schneeschicht ab",
                  "neuschnee","neuschnee ab"
                }),str) != -1 )
  {
    write( BS(
      "Fuer einen ganz kurzen Augenblick denkst Du daran, die "
      "Neuschneeschicht messen zu gehen, aber dann bist Du doch zu faul "
      "dazu. Ausserdem willst Du den Xandim nicht die Arbeit wegnehmen "
      "und nebenbei bemerkt: so interessant waere das Messen einer "
      "Neuschneeschicht ohnehin nicht gewesen.") );
    say(
      TPN+" geht leicht planlos zur Holzpalisade und wieder zurueck.\n" );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " will den Neuschnee abmessen.\n");
    return 1;
  }
}

int cmd_legen(string str)
{
  object ob;
  string was, wo;

  notify_fail( "Was moechtest Du wo drueberlegen?\n" );
  
  if ( !str || str == "" ) return 0;
  if ( sscanf( str,"%s ueber %s", was, wo) != 2 ) return 0;
  ob = present(was, TP);
  if ( member( ({ "lattenzaun","zaun" }), wo) != -1 )
  {
    if ( !ob )
    {
      write( BS(
        "Du kannst nur Dinge ueber den Lattenzaun legen, die Du auch "
        "bei Dir hast.") );
      return -1;
    }
    if ( ob->id("raeudiges wolfsfell") && ob->QueryProp(P_FELL_AUS_LADEN) )
    {
      if ( ob->QueryProp(P_VERSTAUBTES_FELL) )
      {
        write( BS(
          "Du legst das raeudige Wolfsfell ueber den Lattenzaun, damit Du "
          "es jetzt ohne Probleme ausklopfen kannst.") );
        say( BS(
          TPN+" legt ein Fell ueber den Lattenzaun. Was bezweckt "+
          TP->QueryPronoun(WER)+" damit?") );
        verstaubt = 1;
        fell_auf_zaun = 1;
        ob->remove(1);
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " legt Fell ueber Zaun.\n");
        return 1;
      }
      write( BS(
        "Das Fell ist zwar schon sauber, aber Du legst es trotzdem zum "
        "Lueften noch einmal ueber den Lattenzaun.") );
      say( BS(
        TPN+" legt ein Fell ueber den Lattenzaun. Was bezweckt "+
        TP->QueryPronoun(WER)+" damit?") );
      verstaubt = 0;
      fell_auf_zaun = 1;
      ob->remove(1);
      return -1;
    }
    write( BS(
      "Es bringt eigentlich nicht viel, "+ob->name(WEN)+" ueber den "
      "Lattenzaun legen zu wollen.") );
    return -1;
  }
  if ( ob )
  {
    write(
      "Ueber was willst Du "+ob->name(WEN)+" legen?\n" );
    return -1;
  }
}

int cmd_nehmen(string str)
{
  object ob;

  if ( !str || str == "" ) return 0;

  if ( member( ({ "raeudiges wolfsfell","wolfsfell","fell"
                }),str ) != -1 )
  {
    if ( fell_auf_zaun )
    {
      ob = clone_object(FELLE[12]);  
      if ( ME_TOO_HEAVY == ob->move(TP,M_GET|M_SILENT) )
      {
        write( BS(
          "Du musst etwas ablegen, denn Du kannst das Fell nicht "
          "mehr tragen.") );
        ob -> remove();
        return -1;
      }       	
      write(
        "Du nimmst das raeudige Wolfsfell vom Zaun herunter.\n" );
      say(
        TPN+" nimmt ein raeudiges Wolfsfell vom Zaun herunter.\n" );
      fell_auf_zaun = 0;  
      ob -> SetProp( P_FELL_AUS_LADEN, 1 );
      if ( verstaubt )
      {     
        ob -> SetProp( P_VERSTAUBTES_FELL, 1 );
        ob -> SetProp( P_LONG, ob->QueryProp(P_LONG)+"Es ist sehr staubig, "
          "denn es ist schon lange herumgelegen." );
        ob -> SetProp( P_INFO, "Das Fell ist ja wirklich furchtbar staubig. "
          "Vielleicht sollte man etwas gegen den Staub machen?" );  
        return -1;
      }
      ob -> SetProp( P_VERSTAUBTES_FELL, 0 );
      ob -> SetProp( P_LONG, ob->QueryProp(P_LONG)+"Auf dem Fell ist kein "
        "einziges Staubkorn mehr zu sehen." );
      ob -> SetProp( P_INFO, "Das Fell ist endlich wieder sauber. Bring es "
        "doch am besten Schwarzfell zurueck." );
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " nimmt das Fell vom Zaun.\n");
      return 1; 
    }
  }  
}

int cmd_finden(string str)
{
  notify_fail( "Was wuerdest Du gern finden?\n" );

  if ( !str || str == "" ) return 0;
  if ( member( ({ "spur","spuren" }),str) != -1 )
  {
    notify_fail( "Welche Spur moechtest Du finden?\n" );
    return 0;
  }
  if ( sscanf(str,"%s spur",str) != 1 ) return 0;
  if ( str != "eigene" )
  {
    write(
      "Welche Spur moechtest Du im Schnee finden?\n" );
    return -1;
  }
  write( BS(
    "Du versuchst Deine eigene Spur im Schnee zu finden, aber das ist nicht "
    "so einfach, denn bevor man etwas finden kann, muss man erst gezielt "
    "danach suchen.") );
  write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
    " will eigene Spur finden.\n");
  return 1;
}

int cmd_suchen(string str)
{
  if ( !str || str == "" ) return 0;
  if ( member( ({ "spur","spuren" }), str) != -1 )
  {
    notify_fail( "Welche Spur willst Du suchen?\n" );
    return 0;
  }
  if ( member( ({ "xandimspur","xandimspuren",
                  "spur vom xandim","spuren vom xandim",
                  "spur von xandim","spuren von xandim",
                  "spur von einem xandim","spuren von einem xandim"
                }), str) != -1 )
  {
    write( BS(
      "Die Spuren der Xandim brauchst Du nicht lange zu suchen, denn obwohl "
      "in diesem Bereich wenige sind, so kannst Du sie klar von den anderen "
      "unterscheiden. Nachdem sie sogar im Schnee barfuss herumgehen, haben "
      "ihre Abdruecke keinerlei Aehnlichkeit mit denen, die von Stiefeln, "
      "Schuhen oder anderem Schuhwerk hinterlassen werden.") );
    say( BS(
      TPN+" durchsucht einwenig den Schnee. Wahrscheinlich hat "+
      TP->QueryPronoun(WER)+" etwas verloren.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " sucht Xandimspuren.\n");
    return 1;
  }
  else if ( member( ({ "kinderspur","kinderspuren",
                       "xandimkindspur","xandimkindspuren",
                       "xandimkinderspur","xandimkinderspuren",
                       "spur von kinder","spuren von kinder",
                       "spur von xandimkinder","spuren von xandimkinder"
                       "spur von einem xandimkind",
                       "spuren von einem xandimkind",
                       "spur von einem kind","spuren von einem kind",
                       "spur vom kind","spuren vom kind",
                       "spur von kind","spuren von kind",
                       "spur vom xandimkind",
                       "spur von xandimkind","spuren von einem xandimkind"
                     }), str) != -1 )
  {
    write( BS(
      "Du suchst die Spuren, die im Boden zurueckgelassen wurden, nach "
      "Kinderspuren ab und entdeckst sogar einige davon, was auch kaum "
      "anders zu erwarten war, wenn man bedenkt, wieviele Kinder hier im "
      "Laufe des Tages vorbeikommen. Eine Spur eines Kindes schaut "
      "allerdings ein bisschen anders aus, nur kannst Du im Moment nicht "
      "sagen, was der Unterschied ist.") );
    say( BS(
      TPN+" sucht den Boden nach etwas ab. Wonach "+TP->QueryPronoun(WER)+
      " sucht, laesst sich vom Zusehen nicht erkennen.") );
    kinderspur_gefunden += ({ getuid(TP) });
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " entdeckt Kinderspuren.\n");
    return 1;
  }                
  else if ( member( ({ "eigene spur","eigene spuren",
                       "die eigene spur","die eigenen spuren",
                       "nach eigener spur","nach eigenen spuren"
                     }), str) != -1 )
  {
    if ( random(5) )
    {
      write( BS(
        "Du suchst die Spuren im Schnee nach Deinen eigenen ab, ... findest "
        "sie allerdings leider nicht.") );
      say(
	TPN+" sucht irgendetwas im Schnee.\n" );
      return -1;
    }
    write( BS(
      "Du suchst die Spuren im Schnee nach Deinen eigenen ab, ... und hast "
      "enormes Glueck dabei. Irgendwie hast Du trotz des Durcheinanders der "
      "unterschiedlichen Spuren Deine eigene gefunden. Du bist maechtig "
      "stolz auf Dich!") );
    say(
      TPN+" hat etwas im Schnee gefunden und blickt ganz stolz drein.\n" );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " sucht eigene Spur.\n");
    return 1;
  }
  else if ( member( ({ "hundespuren",
                       "schlittenhundespur","schlittenhundespuren",
                       "spur von schlittenhunden","spuren von schlittenhunden",
                       "spur von hunden","spuren von hunden"
                    }), str) != -1 )
  {
    write( BS(
      "Nach Hundespuren zu suchen, ist nicht weiter schwierig, denn schon "
      "nach 20 Sekunden hast Du mindestens sieben verschiedene davon "
      "gefunden. Such doch nach einer einzelnen und nicht nach allen "
      "zugleich, dann kommst Du viel schneller an Dein Ziel, was auch "
      "immer Dein Ziel sein mag.") );
    say( BS(
      "Du weisst nicht genau, was "+TPN+" vorhat, aber "+TP->QueryPronoun(WER)+
      "sucht nach irgendwas im Schnee.") );
    return -1;
  }
  else if ( member( ({ "hundespur",
                       "schlittenhundspur","schlittenhundspuren",
                       "spur von einem hund","spuren von einem hund",
                       "spur vom hund","spuren vom hund",
                       "spur von hund","spuren von hund",
                       "spur von einem schlittehund",
                       "spuren von einem schlittenhund",
                       "spur vom schlittenhund","spuren vom schlittenhund",
                       "spur von schlittenhund","spuren von schlittenhund"
  	             }), str) != -1 )
  {
    write( BS(
      "Ganz gezielt suchst Du nach einer Hundespur, die sich vielleicht von "
      "den anderen Spuren unterscheidet. Eine solche findest Du zwar nicht, "
      "dafuer entdeckst Du eine merkwuerdige Spur eines Dir unbekannten "
      "Tieres.") );
    say(
      TPN+" sucht den Boden nach irgendetwas ab.\n" );
    spur_gefunden += ({ getuid(TP) });
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " sucht Hundespur.\n");
    return 1;
  }
}

//noch einbauen, dass man Spur tatsaechlich folgen kann
int cmd_verfolgen(string str)
{
  notify_fail( "Welcher Spur willst Du folgen?\n" );

  if ( str=="wieselspur" || str == "wieselspuren" )
  {
    if ( member(spur_gefunden,getuid(TP)) != -1 )
    {
      write( BS(
        "Nachdem Du die Wieselspur entdeckt hast, versuchst Du dieser zu "
        "folgen, aber leider verlierst Du sie bald aus den Augen, weil so "
        "viele unterschiedliche Spuren im Schnee sind.") );
      say(
        TPN+" scheint auf Faehrtensuche zu sein.\n" );
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " verfolgt Wieselspur.\n");
      return 1;
    }
    write(
      "Du hast leider keinerlei Wieselspuren entdeckt, denen Du folgen "
      "koenntest.\n" );
    return -1;
  }
  else if ( member( ({ "hundespur",
                       "schlittenhundspur","schlittenhundspuren",
                       "spur von einem hund","spuren von einem hund",
                       "spur vom hund","spuren vom hund",
                       "spur von hund","spuren von hund",
                       "spur von einem schlittehund",
                       "spuren von einem schlittenhund",
                       "spur vom schlittenhund","spuren vom schlittenhund",
                       "spur von schlittenhund","spuren von schlittenhund",
                       "hundespuren",
                       "schlittenhundespur","schlittenhundespuren",
                       "spur von schlittenhunden","spuren von schlittenhunden",
                       "spur von hunden","spuren von hunden"
  	             }), str) != -1 )
  {
    write( BS(
      "Es gibt viel zu viele Hundespuren, als dass es Dir gelingen wuerde, "
      "gezielt einer zu folgen.") );
    say(
      TPN+" irrt ein wenig planlos durch den Schnee.\n" );
    return -1;
  }
  else if ( member( ({ "xandimspur","xandimspuren",
                       "spur vom xandim","spuren vom xandim",
                       "spur von xandim","spuren von xandim",
                       "spur von einem xandim","spuren von einem xandim"
                     }), str) != -1 )
  {
    write( BS(
      "Es gibt viel zu viele Xandimspuren, als dass es Dir gelingen wuerde, "
      "gezielt einer zu folgen.") );
    say(
      TPN+" irrt ein wenig planlos durch den Schnee.\n" );
    return -1;
  }
  else if ( member( ({ "kinderspur","kinderspuren",
                       "xandimkindspur","xandimkindspuren",
                       "xandimkinderspur","xandimkinderspuren",
                       "spur von kinder","spuren von kinder",
                       "spur von xandimkinder","spuren von xandimkinder"
                       "spur von einem xandimkind",
                       "spuren von einem xandimkind",
                       "spur von einem kind","spuren von einem kind",
                       "spur vom kind","spuren vom kind",
                       "spur von kind","spuren von kind",
                       "spur vom xandimkind",
                       "spur von xandimkind","spuren von einem xandimkind"
                     }), str) != -1 )
  {
   write( BS(
     "Die Spuren der Kinder zu finden, ist nicht weiter schwer gewesen, aber "
     "einer einzelnen davon zu folgen, ist Dir unmoeglich.") );
   say(
     TPN+" irrt ein wenig planlos durch den Schnee.\n" );
   return -1;
  }               
}

int cmd_schauen(string str)
{
  notify_fail( "Wohin willst Du schauen?\n" );
  
  if ( !str || str == "" ) return 0;
  if ( str == "stellen genau an" )
  {
    write( BS(
      "Du machst Dir die Muehe und schaust Dir ein paar Stellen, wo die Seile "
      "zwischen den Pfaehlen zum Vorschein kommen, genau an. Und "
      "tatsaechlich: an einer Stelle entdeckst Du eine Schnur, die scheinbar "
      "von einem Seil weghaengt. Du denkst Dir . o O (jetzt kann man den "
      "Magiern auch nicht mehr trauen!)") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " schaut Stellen genau an.\n");
    return 1;
  }
  if ( sscanf(str,"zulange %s",str) != 1 ) return 0;
  if ( str != "in sonne" && str != "in die sonne" )
  {
    write(
      "Wohin willst Du zulange schauen?\n" );
    return -1;
  }
  if ( member(sonnenanbeter, getuid(TP)) == -1 )
  {
    sonnenanbeter += ({ getuid(TP) });
    if ( find_call_out("blind") == -1 )
      call_out( "blind", 0 );
  }
  return 1;
}
void blind()
{
  if ( member(sonnenanbeter, getuid(TP)) != -1 )
    sonnenanbeter -= ({ getuid(TP) });
  if( ENV(TP) != find_object(ROOM "ostplatz_d1") )
    return;
  sonnenanbeter += ({ getuid(TP) });
  write( BS(
    "Wunderbar, dieses schoene gelb, das von der Sonne ausgestrahlt wird.") );
  if ( find_call_out("blind1") == -1 )
    call_out( "blind1", 3 );	
}
void blind1()
{
  if ( member(sonnenanbeter, getuid(TP)) != -1 )
    sonnenanbeter -= ({ getuid(TP) });
  if( ENV(TP) != find_object(ROOM "ostplatz_d1") )
    return;
  sonnenanbeter += ({ getuid(TP) });
  write( BS(
    "Unglaublich, die Farbe der Sonne wechselt von gelb auf rot.") );
  if ( find_call_out("blind2") == -1 )
    call_out( "blind2", 3 );
}
void blind2()
{
  if ( member(sonnenanbeter, getuid(TP)) != -1 )
    sonnenanbeter -= ({ getuid(TP) });
  if( ENV(TP) != find_object(ROOM "ostplatz_d1") )
    return;
  sonnenanbeter += ({ getuid(TP) });
  write( BS(
    "Und jetzt wird sie sogar ein bisschen braun.") );
  if ( find_call_out("blind3") == -1 )
    call_out( "blind3", 3 );
}
void blind3()
{
  if ( member(sonnenanbeter, getuid(TP)) != -1 )
    sonnenanbeter -= ({ getuid(TP) });
  if( ENV(TP) != find_object(ROOM "ostplatz_d1") )
    return;
  sonnenanbeter += ({ getuid(TP) });
  write( BS(
    "Huch, ploetzlich wird es ganz finster. Wie gibt es das?") );
  if ( find_call_out("blind4") == -1 )
    call_out( "blind4", 3 );
}
void blind4()
{
  write( BS(
    "Du hast jetzt viel zulange in die Sonne geschaut und deshalb bist Du "
    "blind.") );
  TP -> SetProp( P_BLIND, "Du siehst im Moment nur weisse Flecken auf "
                          "schwarzem Hintergrund.\n" );
  if ( find_call_out("blind5") == -1 )
    call_out( "blind5", 20 );
}
void blind5()
{
  write( BS(
    "Du blinzelst ein paar Mal, siehst aber nur stark verschwommene "
    "Konturen.") );
  if ( find_call_out("blind6") == -1 )
  call_out( "blind6", 30 );
}
void blind6()
{
  TP -> SetProp( P_BLIND, 0 );
  write( BS(
    "Schoen langsam haben sich Deine Augen wieder angepasst und Du "
    "kannst sogar ohne bleibenden Schaeden sehen. Zuoft wuerde ich an "
    "Deiner Stelle nicht so lange in die Sonne schauen.") );
}
//COMMANDS END
void reset()
{
  int i, wiesel_im_raum;
  object obj, wiesel, hund;

  ::reset();
 
  if ( resetcounter > 20 )
  {
    gesamttext = "";
    btext = ({ "", "", "", "", "", "", "", "", "", "" });
    resetcounter = 0;
  }
  
  if ( !seil_da )
    seil_da = 1;
  if ( hund = present("\nfaulerhusky") )
  {
    say(
      "Der Schlittenhund legt sich wieder in den Schnee.\n" );
    hund -> remove();
  }

  resetcounter++;
  sonnenanbeter = ({});
  kinderspur_gefunden = ({});
  spur_gefunden = ({});
  seil_gefunden = ({});
  wiesel_im_raum = 0;
  hund_da = random(2);
/*  for ( i=0; i<sizeof(zielraeume); i++ )
  {
    if ( obj = find_object(zielraeume[i]) )
    {
      if ( wiesel = present("\nschneewiesel", obj) )
        wiesel_im_raum = 1;
    }
  }
  if ( !wiesel_im_raum )
  {
    AddItem( XNPC("swiesel"), REFRESH_DESTRUCT );
    for ( i=0; i<sizeof(zielraeume); i++ )
      zielraeume[i] -> wieselweg();
  }*/
}

int fell_da()
{
  return fell_auf_zaun;
}

int fell_zustand()
{
  return verstaubt; 
}

void saubergemacht()
{
  verstaubt = 0;
}

