// Rathaus, Rage November 99

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Ahnengalerie des Rathauses" );
  SetProp( P_INT_LONG,
    "");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: 10]) );

// DETAILS
  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSmell( DEFAULT_SMELL,
    "");

//END DETAILS

  AddExit( "westen", ROOM "rathaus" );
}

//COMMANDS




