//Osterweiterung des Xandimdorf, Rage Nov 00

#include "../def.h"

inherit "std/room";

#include <moving.h>

int exit_test();
int swiesel_da;
int erhebung_da;

void create()
{
  ::create();

  swiesel_da = 0;
  erhebung_da = !random(4);

  SetProp( P_INT_SHORT, "Auf einem Dach" );
  SetProp( P_INT_LONG,
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -4]) );

//DETAILS
AddSpecialDetail( "erhebung","detailErhebung" );
//END DETAILS

  AddExit( "sueden", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : ROOM "hfellladen_c4",
          EX_MSG      : "ueber die Baumstaemme nach unten in Richtung Sueden" ]) );
  AddExit( "norden", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : ROOM "ostplatz_b2",
          EX_MSG      : "ueber die Baumstaemme nach unten in Richtung Norden" ]) );
  AddExit( "osten", ([
         EX_TESTFUNC : #'exit_test,
         EX_DEST     : ROOM "ostplatz_a3",
         EX_MSG      : "ueber die Baumstaemme nach unten in Richtung Osten" ]) );
         SetProp( P_HIDE_EXITS, ({ "sueden","norden","osten" }) );
         
  AddCmd( ({ "test" }), "testen" );
}

//SPECIAL DETAILS
string detailErhebung()
{
  if ( call_other(ROOM "wachturm","Erhebung_entdeckt",getuid(TP)) )
    return
      "Hier ist eine Erhebung.\n";
  return
    "Hier ist keine Erhebung.\n";
}
//END SPECIAL DETAILS

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "Wenn Du runter willst, musst Du das schon anders machen!\n" );
    return 0;
  }
  return 1;
}



//COMMANDS
int testen(string str)
{
  object wiesel;
  
  notify_fail( "Was testen?\n" );

  if ( str == "wiesel" )
  {
    if ( swiesel_da )
    {
      wiesel = clone_object(NPC "swiesel");
      wiesel -> move(TO,M_GO);
      swiesel_da = 0;
      return 1;
    }
    write( BS(
      "Hier ist kein Wiesel.\n") );
    return 1;
  }
}
//END COMMANDS
//VARIABLES
int wieselstatus()
{
  return swiesel_da;
}
int wieselkommt()
{
  swiesel_da = 1;
}
int wieselweg()
{
  swiesel_da = 0;
}

int erhebungstatus()
{
  return erhebung_da;
}
//END VARIABLES