//Osterweiterung des Xandimdorf, Rage Feb 00

inherit "std/room";
inherit "d/polar/rage/ostplatz/room/rundgang";

#include "../def.h"
#include <moving.h>

int haufen_da, harz_da;

void create()
{
  ::create();

  haufen_da = 0;
  harz_da = random(2);

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Auf der einen Seite von Dir ist die Rueckwand des Schmuckladens, auf "
    "der anderen die Holzpalisade. Auf dem Boden verlaeuft eine Eisflaeche "
    "von Westen nach Osten, die so glatt ist, dass sich die Sonne darin "
    "spiegelt. Xandim kommen anscheinend nicht allzu oft vorbei, denn im "
    "Schnee sind nur wenige Spuren zu sehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -8]) );

//DETAILS
  AddDetail( "boden",
    "Ausnahmsweise ist der Boden nicht nur mit einer Schicht Pulverschnee "
    "bedeckt, sondern auf ihm kannst Du auch eine breite Eisflaeche "
    "ausmachen, die parallel zur Holzpalisade verlaeuft." );
  AddDetail( ({ "schneeschicht","schicht" }),
    "Dort, wo der Boden mit Schnee bedeckt ist, liegt eine feine Schicht mit "
    "Pulverschnee. Wahrscheinlich hat es erst letzte Nacht wieder "
    "geschneit." );
  AddDetail( "nacht",
    "Du glaubst, dass es letzte Nacht geschneit hat, aber genau weisst Du "
    "es auch nicht. Da kommt Dir die Idee, dass die Xandim das schon eher "
    "wissen muessten." );
  AddDetail( "idee",
    "Hin und wieder bekommt man eine Auskunft von anderen, wenn man sie "
    "nach den richtigen Sachen fragt." );
  AddDetail( "auskunft",
    "Frag wen, dann solltest Du sicher Auskunft bekommen." );
  AddDetail( "sachen",
    "Fragen kannst Du jeden, doch nur einige werden Dich ueber bestimmte "
    "Sachen, wie eben, ob es letzte Nacht geschneit hat oder nicht, Auskunft "
    "geben." );
//Xandim ueber Nacht bzw Neuschnee fragen
  AddDetail( "pulverschnee",
    "Es liegt zwar viel Schnee da, doch nur die oberste Schicht ist mit "
    "Pulverschnee versehen, was auf einen erst vor kurzem stattgefundenen "
    "Schneefall hindeutet." );
  AddDetail( "schneefall",
    "Du blickst zum Himmel hinauf und weisst, dass es derzeit ganz sicher "
    "nicht schneit und auch nicht so bald anfangen wird. Nur der Pulverschnee "
    "deutet darauf hin, dass es vor kurzem geschneit haben muss." );
  AddDetail( ({ "himmel","abschnitt" }),
    "Es ist zwar nur ein schmaler Abschnitt vom Himmel sichtbar, da Dir das "
    "Ladendach und die Holzpalisade die weitere Sicht nehmen, aber Du stellst "
    "anhand der blauen Himmelsfaerbung trotzdem fest, dass die Sonne "
    "scheinen muss." );
  AddDetail( ({ "himmelsfaerbung","faerbung" }),
    "Der Himmel ist nachwievor blau gefaerbt." );
  AddDetail( ({ "ladendach","dach" }),
    "Das Dach nimmt Dir ein wenig die Sicht auf den Himmel, da es ein Stueck "
    "ueber die Rueckwand steht. Wie die Waende, besteht das Dach auch aus "
    "Baumstaemmen." );
  AddDetail( "stueck",
    "Ein Stueck steht vom Dach ueber die Rueckwand und nimmt Dir so ein "
    "bisschen die Sicht auf den blauen Himmel." );
  AddDetail( ({ "waende","wand" }),
    "Die Waende sind bei Blockhuette meist recht schlicht. Mehrere Baumstaemme "
    "werden uebereinander gelegt, bis sie hoch genug sind, um als Wand einer "
    "Huette zu dienen. Da eine einzelne Wand sofort umfallen wuerde, werden "
    "immer alle gleichzeitig errichtet und an den Ecken werden die Baumstaemme "
    "ueberlappt." );
  AddDetail( "ecken",
    "An den Ecken der Huette ueberlappen sich Baumstaemme und ermoeglichen "
    "es einem sicher, irgendwie auf das Dach der Huette zu klettern." );
  AddDetail( "baumstaemme",
    "Du faehrst mit der Hand ueber die Baumstaemme und in dem Baumstamm in "
    "der siebten Reihe stoesst Du auf ein kleines Loch." );
  AddDetail( ({ "siebte reihe","reihe" }),
    "Die siebte Reihe der Rueckwand weisst ein kleines, fast unscheinbares "
    "Loch auf." );
  AddDetail( "baumstamm",
    "Im Baumstamm der siebten Reihe ist ein faustgrosses Loch. Es scheint "
    "natuerlichen Ursprungs zu sein." );
  AddDetail( "ursprung",
    "Der Ursprung vom Loch ist natuerlich." );
  AddDetail( "hand",
    "Jetzt, wo Du Deine Hand untersuchst, macht sie gar nichts." );
  AddDetail( ({ "huette","blockhuette" }),
    "Die Huette neben Dir ist in ihrer Art gleich gebaut wie eine Blockhuette. "
    "Man koennte sie auch als solche bezeichnen. Blockhuetten zeichnen sich "
    "dadurch aus, dass vier Waende aus Baumstaemme gleichzeitig errichtet "
    "werden, deren Enden sich derart ueberlappen, dass so dem ganzen Halt "
    "gegeben wird." );
  AddDetail( "halt",
    "Die Baumstaemme wurden derart ueberlappt angeordnet, dass sie nicht "
    "verrutschen koennen und der Huette einen guten Halt bieten." );
  AddDetail( "art",
    "Ich meine damit die Art, eine Blockhuette zu errichten." );
  AddDetail( "enden",
    "Die Enden der Waende ueberlappen sich und ein Ende steht beim anderen "
    "drueber." );
  AddDetail( "sicht",
    "Die Sicht auf den gesamten Himmel wird Dir durch das Ladendach und die "
    "Holzpalisade genommen." );
  AddDetail( "sonne",
    "Du stehst zu nah an der Rueckwand des Ladens, wodurch Du sie nicht "
    "sehen kannst. Doch dafuer meinst Du, ein Abbild der Sonne auf der "
    "Eisflaeche auszumachen." );
  AddDetail( "abbild",
    "Ja, Du erkennst tatsaechlich ein verschwommenes Abbild der Sonne auf "
    "der Eisflaeche. Jetzt bist Du Dir ganz sicher, dass sie scheint." );
  AddDetail( "seite",
    "Auf der einen Seite von Dir ist die Rueckwand des Schmuckladens und auf "
    "der anderen die Holzpalisade." );
  AddDetail( "rueckwand",
    "Die Rueckwand besteht aus mehreren Baumstammreihen, wie es fuer eine "
    "Blockhuette ueblich ist. Fenster oder andere Oeffnungen gibt es keine, "
    "was Dich auch nicht ueberrascht, denn die Aussicht hier heraus waere "
    "nicht berauschend." );
  AddDetail( ({ "baumstammreihen","reihen" }),
    "Du zaehlst die Baumstammreihen einzeln ab und kommst so zur Erkenntnis, "
    "dass es 17 Reihen gibt. Ob Du mit dieser Erkenntnis auch etwas anfangen "
    "kannst, wagst Du zu bezweifeln." );
  AddDetail( "erkenntnis",
    "Deine letzte Erkenntnis war, dass die Rueckwand aus 17 Baumstammreihen "
    "besteht." );
  AddDetail( "aussicht",
    "Die Aussicht vom Laden hier heraus waere nicht berauschend, deshalb hat "
    "man auch davon abgesehen, ein Fenster in die Rueckwand zu machen." );
  AddDetail( "fenster",
    "Es sind keine Fenster an der Huette oder anderswo zu sehen." );
  AddDetail( "oeffnungen",
    "Wie Du die gesamte Rueckwand nach Fenster und Oeffnungen absuchst, Du "
    "kannst einfach nicht glauben, dass es sowas nicht gibt, stoesst Du auf "
    "ein etwa faustgrosses Loch." );
  AddSpecialDetail( "loch", "detailLoch" );
  AddDetail( ({ "schmuckladen","laden" }),
    "Von diesem siehst Du im Moment nur die Rueckwand, vor der Du direkt "
    "stehst. Du muesstest schon um die Ecke gehen, damit Du ihn betreten "
    "kannst." );
  AddSpecialDetail( "ecke","detailEcke" );
  AddDetail( "moment",
    "Jetzt! Nun! Derzeit!" );
  AddDetail( "holzpalisade",
    "Die Holzpalisade umgibt den gesamten Ostplatz, um den Kinder Schutz vor "
    "wilden Tieren zu bieten. Sie ist jenseits der Eisflaeche und besteht "
    "aus einer Vielzahl nebeneinander in den Boden gerammter Pfaehle." );
  AddDetail( ({ "kinder","xandimkinder" }),
    "Von den Xandimkindern kommt keines hier vorbei, woran auch immer das "
    "liegen mag." );
  AddDetail( "ostplatz",
    "Noch immer bist Du am Ostplatz von Yiqanuc und siehst Dich darauf um. Du "
    "bist schon gespannt, was Du wieder alles finden und erleben wirst." );
  AddDetail( ({ "heimatdorf","yiqanuc" }),
    "Das Heimatdorf der Xandim, Yiqanuc, liegt hinter der Eispalisade." );
  AddDetail( "eispalisade",
    "Die maechtige Eispalisade liegt westlich von Dir und dahinter ist der "
    "Dir bekannte Teil von Yiqanuc." );
  AddDetail( "teil",
    "Den Teil hinter der Eispalisade hast Du Dir doch sicher schon "
    "angesehen. Falls nicht, solltest Du das schleunigst nachholen." );
  AddDetail( ({ "pfaehle","holzpfaehle" }),
    "Die Pfaehle wurden nebeneinander in den Boden gerammt und werden mit "
    "Seilen zusaetzlich zusammengehalten." );
  AddDetail( "seile",
    "Die Seile wurden um die Holzpfaehle der Palisade gewickelt, damit sich "
    "die Pfaehle nicht gegenseitig verschieben." );
  AddDetail( ({ "tiere","wilde tiere" }),
    "Es sind weder wilde noch andere Tiere zu sehen. Es ging nur darum, Dir "
    "zu zeigen, dass die Holzpalisade einen guten Schutz vor wilden Tieren "
    "bietet." );
  AddDetail( "schutz",
    "Die Holzpalisade scheint stabil zu sein und somit bietet sie sicher "
    "allen, die sich auf dem Ostplatz aufhalten, einen hervoragenden Schutz "
    "vor wilden Tieren." );
  AddDetail( "vielzahl",
    "Du schaetzt einmal ganz grob, dass sehr viele Pfaehle zur Vollendung "
    "der Holzpalisade verwendet worden sind." );
  AddDetail( "vollendung",
    "Um diese Holzpalisade zu vollenden, hat man einerseits viele Pfaehle "
    "gebraucht, andererseits auch sehr viele arbeitskraeftige Xandim, die "
    "schwere Arbeit nicht scheuen." );
  AddDetail( "arbeit",
    "Die Xandim scheuen schwere Arbeit nicht, Du vielleicht?" );
  AddDetail( "eisflaeche",
    "Die Eisflaeche ist zwei Meter breit und schaut sehr glatt aus. Sogar "
    "Dein Spiegelbild kannst Du leicht verschwommen darin vernehmen. Sie "
    "wird links und rechts von aufgehaeuften Schnee begrenzt und fuehrt noch "
    "nach Westen und Osten weiter." );
  AddDetail( "meter",
    "Die Eisflaeche ist zwei Meter breit." );
  AddDetail( "spiegelbild",
    "Du bist zu weit von der Eisflaeche weg. Wenn Du es genauer sehen willst, "
    "musst Du schon auf die Eisflaeche blicken. Du bist schon gespannt, wie "
    "gut Du heute wieder aussiehst." );
  AddDetail( "westen",
    "Du blickst nach Westen und siehst dort den Anfang der Eisflaeche knapp "
    "vor der Eispalisade. Neben der Eisflaeche steht eine Gruppe von Xandim, "
    "die ueber irgendetwas zu diskutieren scheint." );
  AddDetail( "gruppe",
    "Neben der Eisflaeche im Westen steht eine kleine Gruppe von Xandim, "
    "die sich unterhaelt oder ueber irgendetwas zu diskutieren scheint." );
  AddDetail( "anfang",
    "Der Anfang der Eisflaeche ist knapp vor der Eispalisade im Westen." );
  AddDetail( "osten",
    "Du meinst das Ende der Eisflaeche knapp vor der Holzpalisade im "
    "suedoestlichen Eck des Ostplatzes zu erkennen, wo eine Gestalt auf der "
    "Eisflaeche steht." );
  AddDetail( "gestalt",
    "Wer die Gestalt ist oder was sie macht, bleibt Dir von der Entfernung "
    "vorlaeufig ein Geheimnis." );
  AddDetail( "entfernung",
    "Die Entfernung von Dir bis zur Gestalt ist zu gross, als dass Du "
    "genaueres erkennst." );
  AddDetail( "geheimnis",
    "Luefte das Geheimnis und bewege Dich auf die Gestalt zu." );
  AddDetail( "eck",
    "Wenn Du nach Osten blickst, siehst Du das suedoestliche Eck des "
    "Ostplatzes. Dort ist auch das Ende der Eisflaeche." );
  AddDetail( "ende",
    "Das kannst Du nicht genau erkennen, doch glaubst Du kaum, dass die "
    "Eisflaeche durch die Holzpalisade durchgeht. Eine Gestalt bewegt sich "
    "dort auf der Eisflaeche hin und her." );    
  AddDetail( "xandim",
    "Da Du kaum Spuren im Schnee siehst, nimmst Du einfach an, dass die Xandim "
    "selten hier vorbeikommen. Dafuer steht aber eine kleine Gruppe weiter "
    "im Westen beisammmen." );
  AddDetail( "schnee",
    "Sehr viel Schnee liegt am Boden, da kaum wer in diesem Bereich des "
    "Ostplatzes kommt. Neben der Eisflaeche sind mehrere kleine Schneehaufen, "
    "die sicher dadurch entstanden ist, dass die Eisflaeche irgendwie "
    "freigelegt werden musste." );
  AddDetail( "bereich",
    "In diesem Bereich des Ostplatzes, hinter dem Schmuckladen ist wenig "
    "los." );
  AddSpecialDetail( ({ "schneehaufen","haufen" }), "detailHaufen" );
  AddSpecialDetail( ({ "schneehaeufchen","haeufchen" }), "detailHaeufchen" );
  AddDetail( "sand",
    "An vieles erinnerst Du Dich nicht mehr, nur an die Tatsache, dass Du "
    "gerne im Sand gebuddelt hast, weil es so lustig war und Du immer "
    "glaubtest, Du koenntest etwas finden." );
  AddDetail( "kind",
    "Ja, damals. Da war noch alles so unbeschwerlich fuer Dich. Du konntest "
    "in der Sonne liegen, das Meeresrauschen hoeren und vergnuegt im Sand "
    "buddeln. *seufz* Lang, lang ist es her." );
  AddDetail( ({ "meeresrauschen","rauschen" }),
    "Sowas kannst Du doch nicht untersuchen. Da musst schon mal hinhoeren!" );
  AddDetail( "eltern",
    "Die hast Du schon lange nicht mehr gesehen. Wie es ihnen derzeit wohl "
    "geht?" );
  AddDetail( ({ "felseninsel","insel" }),
    "Die ist sehr weit weg. Finde Dich damit ab, dass es nicht so rasch "
    "waermer wird." );
  AddDetail( "freilegen",
    "Die Eisflaeche ist nicht natuerlich entstanden, sondern wurde von den "
    "Xandim fuer irgendwelche Zwecke freigelegt." );
  AddDetail( ({ "zwecke","zweck" }),
    "Ganz umsonst haben die Xandim die Eisflaeche sicher nicht freigelegt. Du "
    "wirst sicher schon bald hinter den Zweck kommen." );
  AddDetail( "spuren",
    "Im Schnee kannst Du nur Deine eigenen Spuren sehen und auch eine "
    "irgendeines kleinen Tieres. " );
  AddDetail( ({ "tieres","tieren","schmuckladens","seilen","baumstaemmen",
                "xandimkindern","ladens","ursprungs","ostplatzes" }),
    "Das kannst Du nicht untersuchen." );

  AddSound( DEFAULT_SOUND,
    "" );
  AddSound( ({ "meeresrauschen","rauschen" }),
    "Das Meer ist viel zu weit weg, um das Rauschen von ihm zu hoeren." );

  AddSmell( DEFAULT_SMELL,
    "" );
//END DETAILS
  AddExit( "osten", "./ostplatz_c4" );
  AddExit( "nordwesten", "./ostplatz_a3" );

  AddCmd( ({ "blick","blicke" }), "blicken" );
  AddCmd( ({ "beug","beuge" }), "beugen" );
  AddCmd( ({ "wuehl","wuehle","buddel","buddle" }), "wuehlen" );
  AddCmd( ({ "kletter","klettere","klettre","kraxl","kraxle" }), "klettern" );
}

//SPECIAL DETAILS
string detailEcke()
{
  if ( harz_da )
  {
    return BS(
      "" );
  }
  return BS(
    "" );
}
string detailLoch()
{
  return BS(
    "Ein Loch." );
}

string detailHaufen()
{
  if ( haufen_da )
  {
    return BS(
      "Am Rand der Eisflaeche haben sich mehere Schneehaufen gebildet, die "
      "durch das Freilegen der Eisflaeche entstanden sind. Seltsamerweise "
      "liegt auch mitten auf der Eisflaeche ein kleines Haeufchen." );
  }
  return BS(
    "Am Rand der Eisflaeche haben sich mehrere Schneehaufen gebildet, die "
    "durch das Freilegen der Eisflaeche entstanden sind. Unwillkuerlich "
    "fuehlst Dich daran erinnert, wie Du einmal als Kind mit Deinen Eltern "
    "zur Felseninsel gefahren bist und dort im Sand gespielt hast." );
}

string detailHaeufchen()
{
  if ( haufen_da )
  {
    return BS(
      "Irgendwie ist ein kleines Haeufchen aus Schnee auf die Eisflaeche "
      "gelangt, das sicher nicht dort hin gehoert. Am besten waere es, Du "
      "machst es gleich schnell wieder weg." );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}
//END SPECIAL DETAILS
//COMMANDS
int blicken(string str)
{
  notify_fail( "Wohin willst Du blicken?\n" );
}

int beugen(string str)
{
  notify_fail( "Worueber moechtest Du Dich beugen?\n" );
}

int wuehlen(string str)
{
  notify_fail( "Wo willst Du herumwuehlen?\n" );
}

int klettern(string str)
{
  notify_fail( "Wohin moechtest Du klettern?\n" );

  if ( member( ({ "auf dach","dach" }), str) != -1 )
  {
    if ( "/d/polar/rage/ostplatz/master/master" -> klettern_moeglich(1) )
    {
      write( BS(
        "Du nuetzt die ueberstehenden Stuecke der Baumstaemme aus, um auf "
        "das Dach zu klettern.") );
      TP -> move( ROOM "schmuckladendach", M_GO, "auf das Dach", "klettert",
                  "steigt an der Ecke auf das Dach" );
      return 1;
    }
    write( BS(
      "Du rutschst leider bei den Baumstaemmen ab. Vielleicht geht es "
      "anderswo besser.") );
    say( BS(
      TPN+" versucht auf das Dach vom Laden zu klettern, rutscht dabei "
      "allerdings ab.") );
    return 1;
  }
}
//END COMMANDS
