int stopp(string dir)
{
  write(
    "Eine magische Kraft haelt Dich davon ab, in diese Richtung zu gehen.\n" );
  return 1;
}

int braten_essen(object zahler, object esser)
{
  object bratenhunger;

  tell_object( esser, BS(
    "Braunfell wendet den Braten noch einmal, schneidet ein sehr grosses "
    "Stueck runter, wirft dieses dann auf ein Schneidbrett und reicht es Dir "
    "samt dem Stueck. Du kannst gar nicht fassen, wie zart der Rentierbraten "
    "ist, und wuerdest am liebsten gleich noch einen essen.") );
  tell_room( ENV(esser),
    esser->Name()+" isst voller Genuss ein zartes Stueck Rentierbraten.\n"
    "Du musst sowas auch unbedingt probieren.\n",({ esser }) );
  if ( bratenhunger = present("\nbratenhunger",esser) )
  {
    tell_object( esser,
      "Endlich konntest Du Deinen kaum zu baendigenden Hunger stillen.\n" );
      "/d/polar/rage/ostplatz/room/ostplatz_c2" -> hunger_weg();
    bratenhunger->remove();
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " ist nicht mehr hungrig.\n");
  }
}
int ripperl_essen(object zahler, object esser)
{
  if ( ripperl_anzahl )
  {
    tell_object( esser, BS(
      "Du bekommst von Sidra ein gewaltiges Walfischripperl in die Haende "
      "gedrueckt, dass so schwer ist, dass Du Dich zum Essen auf den Boden "
      "setzen musst. Du beginnst mal zu essen und schaust, wie weit Du mit "
      "dem Stueck kommen wirst.") );
    tell_room( ENV(esser),
      esser->Name()+" macht sich dran, ein ganzes Walfischripperl zu essen.\n",
      ({ esser }) );
    esser -> SetProp( P_PARALYZED,
      ([
         PARALYZE_TIME : 5+random(10),
         PARALYZE_MSG  : "Du kannst momentan nur an das Ripperl denken!\n",
         PARALYZE_MSG_OTHER : "%s ist total mit dem Essen vom Ripperl "
                              "beschaeftigt.\n",
         PARALYZE_END  :
           "Du hast Dein Bestes gegeben, aber Du schaffst es nicht "
           "einmal ansatzweise, das ganze Ripperl aufzuessen.\n",
         PARALYZE_END_OTHER : "%s gibt es auf, das Ripperl aufessen zu "
                              "wollen.\n"
      ]) );
    ripperl_anzahl--;
  }
  else
  {
    tell_object( esser, BS(
      "Sidra hat die Walfischripperl erst vor kurzem zum Grillen begonnen "
      "und die sind noch lange nicht fertig. Iss in der Zwischenzeit was "
      "anderes!") );
    tell_object( esser,
      "Der Wirt gibt Dir Dein Geld wieder zurueck.\n" );
    zahler -> AddMoney(100);
  }
}

int wieselstatus()
{
  return swiesel_da;
}
int wieselkommt()
{
  swiesel_da = 1;
}
int wieselweg()
{
  swiesel_da = 0;
}

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "Du musst Dir schon etwas ueberlegen, um dort hin zu kommen!\n" );
    return 0;
  }
  return 1;
}
//SPECIAL DETAILS
string detailForschtechnik()
{
  string text;

  text = "";
  switch( random(5) )
  {
    case 0:
      text = "Deine Forschtechnik ist garantiert die beste von allen.";
    break;
    case 1:
      text = "Deine hervorragende Forschtechnik wurde bestimmt noch von "
             "niemanden erreicht.";
    break;
    case 2:
      text = "Mit Deiner Forschtechnik laesst Du die anderen weit hinter Dir "
             "zurueck.";
    break;
    case 3:
      text = "Die anderen waeren sicher ganz neidisch auf Dich, wenn sie "
             "Deine tolle Forschtechnik kennen wuerden.";
    break;
    default:
      text = "Deine Forschtechnik ist so ueberragend, dass Du sogar selbst "
             "ueber Dich staunen musst.";
    break;
  }
  return BS(text);
}

string detailFrettchen()
{
  if ( member(anschleicher,getuid(TP)) != -1 && frettchen_da )
    return BS(
      "Das Frettchen blickt Dich neugierig an, laeuft allerdings nicht davon. "
      "Wenn Du es hervorlocken koenntest, wuerdest Du es bestimmt auch "
      "irgendwie fangen koennen." );
  if ( member(frettchen_gesehen,getuid(TP))!=-1 && frettchen_da )
    return BS(
      "Nachdem Du weisst, dass das Frettchen unter der Stufe einen "
      "Unterschlupf hat, wirst Du Dich diesem vorsichtig naehern, um es nicht "
      "zu verscheuchen." );
  
  if ( member(frettchen_gesehen,getuid(TP)) != -1 )
    return BS(
      "Von dem Frettchen siehst Du nichts mehr, nur die Spuren, die um die "
      "Ecke fuehren." );
  return
    "Wo siehst Du schon wieder ein Frettchen?\n";
}

string detailUnterschlupf()
{
  object *spieler;
  int i, n;

  if ( frettchen_da )
  {
    if ( member(frettchen_gesehen,getuid(TP)) != -1 )
      return BS(
        "Du stellst Dich so zum Unterschlupf, dass Du von weiter weg "
        "hineinschauen kannst, und merkst, dass sich darin ein Frettchen "
        "aufhaelt. Vielleicht gelingt es Dir sogar, es irgendwie zu fangen?" );
    if ( member(anschleicher,getuid(TP)) != -1 )
      return BS(
        "Nachdem Du Dich an den Unterschlupf herangeschlichen hast, kannst Du "
        "unter den Stufen ein Frettchen sehen, das Dich lauernd anblickt, "
        "allerdings nicht davonlaeuft. Ob Du es vielleicht sogar irgendwie "
        "fangen kannst?" );	
    spieler = filter_array(all_inventory(ENV(TP)), #'interactive);
    n = sizeof(spieler);
    for ( i=0; i<n; i++ )
    {
      frettchen_gesehen += ({ getuid(spieler[i]) });
    }
    frettchen_da = 0;
    say( BS(
      TPN+" hat ein Frettchen vor dem Laden erschreckt, das davonlaeuft und "
      "nach der naechsten Ecke aus Deinem Blickfeld verschwindet.") );
    return BS(
      "Als Du naeher an die Stufe herangehst, um Dir den Raum darunter "
      "anzusehen, springt ein Frettchen erschrocken daraus hervor, laeuft "
      "um die naechste Ecke und ist verschwunden. Vielleicht solltest Du "
      "Dich besser das naechste Mal leise der Stufe annaehern." );
  }
  if ( member(kuegelchen_gesehen,getuid(TP)) == -1 )
    kuegelchen_gesehen += ({ getuid(TP) });
  if ( member(anschleicher,getuid(TP)) != -1 )
    return BS(
      "Du schleichst Dich an die Stufe heran und blickst Dir den Raum "
      "darunter an. Du findest zwar kein Tier, doch ein paar kleine "
      "Kuegelchen, die doch beweisen, dass dieser Raum als Unterschlupf "
      "fuer ein Tier dient." );
  return BS(
    "Du gehst an die Stufe heran und blickst Dir den Raum darunter an. Du "
    "findest zwar kein Tier, doch ein paar kleine Kuegelchen, die doch "
    "beweisen, dass dieser Raum als Unterschlupf fuer ein Tier dient." );
}

string detailSpuren()
{
  string text;

  text = "Es sind schon so viele Spuren im Neuschnee, dass Du sie nicht mehr "
         "voneinander unterscheiden kannst.";
  if ( member(frettchen_gesehen,getuid(TP))!=-1 && !frettchen_da )
    text += " An der rechten Ecke des Schmuckladens siehst Du die Spuren "
            "eines Frettchens.";
  return BS( text );
}

string detailEcke()
{
  if ( member(frettchen_gesehen,getuid(TP))!=-1 && !frettchen_da )
    return BS(
      "Du merkst, dass frische Spuren eines Frettchens um das rechte Eck der "
      "Schmuckladens fuehren. Ob es sich dahinter versteckt, kannst Du nur "
      "rausfinden, wenn Du um die Ecke schaust." );
  return BS(
    "Die Ecken des Schmuckladens sehen alle gleich aus, so wie bei jeder "
    "Blockhuette halt." );
}

string detailKuegelchen()
{
  if ( member(kuegelchen_gesehen,getuid(TP)) != -1 )
  {
    if ( kuegelchen > 1 )
      return BS(
        "Es liegen "+kuegelchen+" Kuegelchen unter der Stufe. Wer die wohl "
        "dort gelassen hat?" );
    return BS(
      "Es liegt genau ein Kuegelchen unter der Stufe. Wer das wohl dort "
      "gelassen hat?" );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}
//END SPECIAL DETAILS
//COMMANDS
int cmd_stolpern(string str)
{
  notify_fail( "Du willst freiwillig stolpern? Worueber denn?\n" );

  if ( member( ({ "ueber stufe","ueber kleine stufe" }),str) != -1 )
  {
    write( BS(
      "Bewusst stolperst Du ueber die Stufe vor dem Laden und faellst "
      "dadurch fast foermlich in diesen hinein.") );
   /* TP -> move( ROOM "schmuckladen_b3", M_GO,
                "nach Sueden in den Schmuckladen",
                "stolpert", "stolpert ueber die Stufe herein" );*/
    write( BS(
      "Du blickst Dich um, ob es wohl niemandem weiter aufgefallen ist. "
      "Da sich keiner nach Dir umdreht, bist Du einigermassen beruhigt.") );
    return 1;
  }
}

int cmd_schleichen(string str)
{
  notify_fail( "An was willst Du Dich anschleichen?\n" );

  if ( member( ({ "an stufe","an stufe heran","zur stufe","zu stufe",
                  "an frettchen","an frettchen heran","an stufen an",
                  "an frettchen an","an stufen","an stufen heran",
                  "zu stufen","an stufe an"
               }),str) != -1 )
  {
    if ( member(anschleicher,getuid(TP)) != -1 )
    {
      write( BS(
        "Du hast Dich bereits an die Stufen angeschlichen. Ein zweites Mal "
        "ist ganz sicher nicht notwendig.") );
      return -1;
    }
    if ( frettchen_da )
      anschleicher += ({ getuid(TP) });
    write( BS(
      "Vorsichtig schleichst Du Dich an die Stufen vor dem Laden an, damit "
      "Du das Frettchen nicht aufscheuchst.") );
    say( BS(
      TPN+" schleicht sich an die Eingangstuer vom Schmuckladen an. Was das "
      "wohl bringen soll?") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " schleicht sich an Stufe.\n");
    return 1;
  }
}

int cmd_locken(string str)
{
  object maus;
  string was, womit, her;

  notify_fail( "Was willst Du womit herauslocken?\n" );

  if ( !str || str=="" ) return 0;
  if ( sscanf(str,"%s mit %s %s",was,womit,her) != 3 ) return 0;
  if ( was == "frettchen" )
  {
    if ( womit=="schneemaus" || womit=="maus" )
    {
      if ( member( ({ "heraus","heran","hervor" }),her) == -1 )
      {
        write(
          "Willst Du das Frettchen heran-/herauslocken?\n" );
        return -1;
      }
      if ( !frettchen_da )
      {
      	write( BS(
      	  "Es gibt doch gar kein Frettchen, das Du hervorlocken koenntest. "
      	  "Halt beim naechsten Mal Deine Augen besser offen.") );
      	return -1;
      }
      if ( !maus=present("\nLOCKMAUS",TP ) )
      {
      	write(
      	  "Ohne die Maus wirst Du das Frettchen nicht hervorlocken "
      	  "koennen.\n" );
      	return -1;
      }
      if ( frettchen_fangbar )
      {
        write(
          "Das Frettchen wurde bereits herausgelockt.\n" );
        return -1;
      }
      if ( member(anschleicher,getuid(TP)) == -1 )
      {
      	write(
      	  "Du muesstest Dich noch vorher naeher zum Frettchen bewegen.\n" );
      	return -1;
      }
      write( BS(
        "Nachdem Du Dich angeschlichen hast, lockst Du das Frettchen mit "
        "Deiner gefangenen Schneemaus unter der Stufe hervor. Wenn Du "
        "schnell bist, koenntest Du es sogar fangen.") );
      say(
        TPN+" lockt ein frettchen an.\n" );
      if ( find_call_out("angelockt") == -1 )
        call_out("angelockt",10);
      frettchen_fangbar = 1;
      locker += ({ getuid(TP) });
      frettchenraum = ENV(TP);
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " lockt Frettchen hervor.\n");
      return 1;
    }
    write(
      "Womit willst Du das Frettchen hervorlocken?\n" );
    return -1;
  }
}
void angelockt()
{
  write(
    "Du hast Deine Chance verpasst, das Frettchen zu fangen.\n" );
  tell_room( frettchenraum,
    "Das Frettchen verschwindet wieder unter der Stufe.\n", ({ TP }) );
  locker -= ({ getuid(TP) });
  anschleicher -= ({ getuid(TP) });
  frettchen_fangbar = 0;
}

int cmd_fangen(string str)
{
  object frettchen, maus;
  
  notify_fail( "Bist Du auf der Jagd oder was willst Du fangen?\n" );
  
  if ( str == "frettchen" )
  {
    if ( !frettchen_da )
    {
      write(
        "Es gibt hier weit und breit kein Frettchen, das Du fangen "
        "koenntest.\n" );
      return -1;
    }
    if ( !maus=present("\nLOCKMAUS",TP ) )
    {
      write(
        "Ohne der Maus ist das Frettchen nicht abgelenkt, um es fangen zu "
      	"koennen.\n" );
      return -1;
    }
    if ( !frettchen_fangbar )
    {
      write(
        "Locke das Frettchen zuerst einmal an, bevor Du es fangen kannst.\n" );
      return -1;
    }
    if ( member(locker,getuid(TP)) == -1 )
    {
      write( BS(
        "Du hast nicht einmal das Frettchen angelockt, so wirst Du es "
        "sicher nicht fangen koennen.") );
      return -1;
    }
    frettchen = clone_object(NPC "frettchen");
    if ( ME_TOO_HEAVY == frettchen -> move(TP,M_NOCHECK|M_SILENT) )
    {
      write(
        "Leider ist Dir das Frettchen zu schwer und so entkommt es Dir." );
      frettchen -> remove();
      return -1;
    }
    write( BS(
      "Nachdem Du das Frettchen mit der Maus abgelenkt hast, gelingt es Dir, "
      "es endlich einzufangen und Du bist ganz schoen stolz auf Dich.") );
    say(
      TPN+" schafft es, ein Frettchen einzufangen.\n" );
    maus -> frei();
    maus -> move(ENV(TP), M_GO|M_SILENT);
    write(
      "Da die Schneemaus ihren Zweck erfuellt hat, laesst Du sie wieder "
      "frei.\n" );
    remove_call_out("angelockt");
    locker = ({});
    anschleicher = ({});
    frettchen_fangbar = 0;
    frettchen_da = 0;
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " faengt Frettchen.\n");
    return 1;
  }
}

int cmd_beruehren(string str)
{
  notify_fail( BS("Was moechtest Du schon wieder beruehren? Kannst Deine "
                  "Finger wohl nicht dort lassen, wo sie sind?") );

  if ( member( ({ "stein","steine" }),str) != -1 )
  {
    write( BS(
      "Nachdem Du Deine Finger nicht lassen kannst, wo sie sind, musst Du "
      "unbedingt herausfinden, wie heiss die Steine sind, die kreisfoermig "
      "aufgeschlichtet worden sind. Wenig ueberraschend verbrennst Du Dir "
      "dabei den Zeigefinger und kannst froh sein, dass nicht mehr passiert "
      "ist.") );
    say( BS(
      TPN+" beruehrt mit der Hand einen Stein der Labestation und verbrennt "
      "sich dabei einen Finger.") );
    SetProp( P_KILL_NAME, "Eine Verbrennung" );
    TP -> do_damage(5+random(10));
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " beruehrt heisse Steine.\n");
    return 1;
  }
}

int cmd_lachen(string str)
{
  notify_fail( "Wem magst Du freundlich entgegen lachen?\n" );

  if ( str == "sonne freundlich entgegen" )
  {
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " lacht die Sonne an.\n");
    if ( TP->QueryProp(P_RACE) == "Dunkelelf" )
    {
      write( BS(
        "Nachdem Du es der Sonne gleich tun willst, lachst Du ihr auch "
        "freundlich entgegen. Irgendwie wird Dir ganz schlecht bei so viel "
        "Freundlichkeit und Sonnenschein. Daraufhin wuerdest Du gleich "
        "wieder am liebsten einen Paladin ermorden.") );
      say(
        TPN+" lacht die Sonne an und grinst dabei finster. Was "+
        TP->QueryPronoun(WEM)+" wohl gerade durch den Kopf ging?\n" );
      return 1;
    }
    write( BS(
      "Nachdem Du es der Sonne gleich tun willst, lachst Du ihr auch "
      "freundlich entgegen. In dem Moment denkst Du, dass die Sonne nur "
      "fuer Dich scheint und sonst fuer niemand. Du fuehlst Dich richtig "
      "wohl.") );
    say(
      TPN+" lacht die Sonne an und blickt gluecklich drein.\n" );
    return 1;
  }
}

int cmd_lenken(string str)
{
  notify_fail( "Willst Du Dich etwa ablenken?\n" );

  if ( str == "dich ab" )
  {
    switch( random (5) )
    {
      case 0:
        write(
          "Um Dich auf andere Gedanken zu bringen, bohrst Du mal kurz in "
          "Deiner Nase.\n" );
        say(
          TPN+" bohrt in "+TP->QueryPossPronoun(FEMALE,WEM,SINGULAR)+
          " Nase.\n" );
      break;
      case 1:
        write(
          "Um Dich abzulenken, kratzt Du Dir den Kopf.\n" );
        say(
          TPN+" kratzt sich den Kopf.\n" );
      break;
      case 2:
        write( BS(
          "Um Dich auf andere Gedanken zu bringen, zaehlst Du ganz gespannt "
          "Deine Finger ab.") );
        say(
          TPN+" zaehlt wie in Trance "+TP->QueryPossPronoun(MALE,WEN,PLURAL)+
          " Finger ab.\n" );
      break;
      case 3:
        write(
          "Um Dich abzulenken, kratzt Du Dir am Hintern.\n" );
        say(
          TPN+" kratzt sich ganz ungeniert am Hintern.\n" );
      break;
      default:
        write(
          "Um Dich auf andere Gedanken zu bringen, bellst Du wie ein "
          "Schlittenhund.\n" );
        say( BS(
          TPN+" beginnt ploetzlich zu bellen und Du kannst Dir nur noch an "
          "den Kopf greifen.\n") );
      break;
    }
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " lenkt sich ab.\n");
    return 1;
  }
}

int cmd_heben(string str)
{
  notify_fail( "Was willst Du gerne auf- oder hochheben?\n" );

  if ( member( ({ "deckel hoch","holzdeckel hoch",
                  "deckel auf","holzdeckel auf"
                }),str) != -1 )
  {
    if ( present(("sidra"),ENV(TP)) )
    {
      write( BS(
        "Du willst den Deckel zwar hochheben, der auf dem Tonkrug liegt, aber "
        "Sidra schlaegt Dir vorher auf Deine Hand, damit Du die Finger davon "
        "laesst.") );
      say( BS(
        "Sidra schlaegt "+TP->Name(WEM)+" auf die Hand, weil "+
        TP->QueryPronoun(WER)+" sich am Tonkrug zu schaffen machen wollte.") );
      return -1;
    }
    write( BS(
      "Neugierig wie Du bist, hebst Du den Deckel hoch, aber bevor Du etwas "
      "erkennen kannst, steigt der heisse Dampf aus dem Tonkrug hoch und "
      "verbrennt beinahe Dein Gesicht. Du beschliesst, den Deckel rasch "
      "wieder auf den Tonkrug zu setzen.") );
    say( BS(
      TPN+" hebt den Holzdeckel des Tonkruges hoch und wird sogleich in eine "
      "Dampfwolke eingehuellt. "+CAP(TP->QueryPronoun(WER))+" schreit wegen "
      "der Hitze auf und bekommt kurzzeitig ein feuerrotes Gesicht.") );
    return 1;
  }
}

int cmd_schauen(string str)
{
  if ( member( ({ "hinter ecke","um ecke" }),str) != -1 )
  {
    if ( !frettchen_da && member(frettchen_gesehen,getuid(TP))!=-1)
    {
      write( BS(
        "Du blickst um die Ecke des Schmuckladens und siehst ein paar "
        "Xandim, die neben einer grossen Eisflaeche stehen und sich "
        "anscheinend ueber irgendetwas unterhalten. Ausserdem siehst Du "
        "die frischen Spuren eines Frettchens, das sich zwischenzeitlich "
        "wohl einen anderen Unterschlupf gesucht hat.") );
      say(
        TPN+" blickt kurz um die Ecke vom Schmuckladen.\n" );
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " hat um Ecke geschaut.\n");
      return 1;
    }
    write( BS(
      "Du blickst um die Ecke des Schmuckladens und siehst ein paar Xandim, "
      "die neben einer grossen Eisflaeche stehen und sich anscheinend ueber "
      "irgendetwas unterhalten.") );
    say(
        TPN+" blickt kurz um die Ecke vom Schmuckladen.\n" );
    return -1;
  }
}

int cmd_bauen(string str)
{
  if ( str == "schneemann" )
  {
    write( BS(
      "Du hast so richtig Lust, einen Schneemann zu bauen, aber der Platz "
      "kommt Dir nicht so geeignet vor, weil hier soviele Leute "
      "vorbeigehen. Du ueberlegst Dir, ob Du nicht deswegen nach Norden zu "
      "den Kindern gehen solltest.") );
    say( BS(
      TPN+" formt eine kleine Schneekugel, laesst es aber gleich wieder sein "
      "und zerstampft sie.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " baut eine Kugel.\n");
    return 1;
  }
  write(
    "Ein Luftschloss oder doch etwas anderes?\n" );
  return -1;
}

int testen(string str)
{
  object wiesel;
  
  notify_fail( "Was testen?\n" );

  if ( str == "wiesel" )
  {
    if ( swiesel_da )
    {
      wiesel = clone_object(NPC "swiesel");
      wiesel -> move(TO,M_GO);
      swiesel_da = 0;
      return 1;
    }
    write( BS(
      "Hier ist kein Wiesel.\n") );
    return 1;
  }
}
//END COMMANDS
void reset()
{
  ::reset();

  kuegelchen_gesehen = ({});
  if ( resetzaehler > 3 )
  {
    frettchen_gesehen = ({});
    resetzaehler = 0;
  }
  anschleicher = ({});
  kuegelchen = 6+random(10);
  ripperl_anzahl = 2+random(3);
  if ( !frettchen_da ) frettchen_da = random(2);
  resetzaehler++;
}
