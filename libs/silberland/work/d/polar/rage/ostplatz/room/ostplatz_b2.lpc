// Osterweiterung des Xandimdorf
// Grillstand
// Filename: ostplatz_b2.c
// File by Rage, Februar 00

inherit "std/pub";
inherit "d/polar/rage/ostplatz/room/rundgang";

#include "../def.h"
#include <moving.h>
#include <pub.h>

int frettchen_da;             //frettchen ist unter Stufe
int frettchen_fangbar;
string *kuegelchen_gesehen;  //Spieler sieht Kuegelchen unter Stufe
string *frettchen_gesehen;    //Spieler hat frettchen gesehen
string *anschleicher;        //Spieler hat sich an Stufen angeschlichen
string *locker;              //Spieler, der frettchen angelockt hat
int kuegelchen, swiesel_da;
int exit_test();
int ripperl_anzahl = 2+random(3);
object frettchenraum;
int resetzaehler;

void create()
{
  ::create();

  frettchen_da = random(2);
  kuegelchen_gesehen = ({});
  frettchen_gesehen = ({});
  anschleicher = ({});
  locker = ({});
  kuegelchen = 6+random(10);
  swiesel_da = 0;
  frettchen_fangbar = 0;
  frettchenraum = 0;
  resetzaehler = 0;

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Die Torfluegeln des gewaltigen Tores sind weit geoeffnet, womit man "
    "problemlos zwischen Yiqanuc und dem Ostplatz hin und her gehen kann. Vor "
    "Deinen Augen spielt sich ein Treiben ab, das Du noch nie gesehen hast. "
    "Xandimkinder laufen ueberall herum und spielen miteinander, Erwachsene "
    "spazieren des Weges entlang und betreten die Laeden, die suedlich von "
    "Dir stehen, oder sehen sich nur von draussen um. Ausserdem kommen immer "
    "wieder auch Schlittenhunde vorbeigerannt, die sich ohne Leinen frei auf "
    "dem Platz bewegen duerfen. Wegen des ganzen Durcheinanders haettest Du "
    "beinahe das kleinste Wirtshaus im Silberland uebersehen, das unscheinbar "
    "am Wegesrand steht. Ausserdem fuehrt ein kurzer Pfad in Richtung Sueden "
    "zu einem Eingang eines groesseren Ladens." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -1]) );
  SetProp( P_PUB_FLAGS, PUB_HASKEEPER|PUB_NEEDSKEEPER );
  SetProp( P_PUBKEEPER_ID, "sidra" );
  SetProp( P_PUBKEEPER_NAME, "Sidra" );
  SetProp( P_PUBKEEPER_GENDER, MALE );
  SetProp( P_PUBMSG_NOKEEPER, BS(
             "Der Wirt des kleinen Wirtshauses scheint wohl gerade nicht da zu "
             "sein, womit Dich niemand bedienen kann.") );
  SetProp( P_PUBMSG_NOENEMY,
             "Sidra ist derzeit nicht bereit, Dich zu bedienen.\n" ); 
  SetProp( P_PUBMSG_NOINVITE, "Sidra schaut Dich nur finster an.\n" );
  SetProp( P_PUBMSG_FIGHTING,
             "Der Wirt kann sich leider im Augenblick nicht um Dich "
             "kuemmern.\n" );

//DETAILS
  AddDetail( "boden",
    "Es liegt an vielen Stellen eine dicke Neuschneeschicht, doch an den "
    "meisten wurde sie bereits festgetreten, denn ein breiter Weg fuehrt vom "
    "Tor schnurgerade nach Osten, ein kurzer Pfad zweigt nach Sueden zu einem "
    "Laden ab, viele Spuren verzweigen sich nach Norden und eine schmaler "
    "Pfad fuehrt nach Suedwesten." );
  AddDetail( ({ "neuschneeschicht","neuschnee" }),
    "Neben den Pfaden liegt doch ein dicker Batzen Neuschnee. Es muss hier "
    "regelmaessig schneien, das ist sogar Dir klar." );
  AddDetail( "batzen",
    "Ganz schoen viel Neuschnee halt." );
  AddDetail( "schnee",
    "Ueberall liegt Schnee. Am Boden, auf dem Dach der Laeden und auf Deinem "
    "Kopf." );
  AddDetail( ({ "daecher","dach","ladendach","ladendaecher" }),
    "Du siehst, dass auf den Daechern der Laeden auch Schnee liegt. War "
    "eigentlich auch nicht anders zu erwarten." );
  AddDetail( "kopf",
    "Du greifst kurz auf Deinem Kopf und merkst, dass doch kein Schnee drauf "
    "liegt. Da habe ich Dich jetzt wieder hineingelegt. :-)" );
  AddDetail( ({ "da","der" }),
    "Du untersuchst wohl wirklich alles, um zu Deinen Forscherpunkten zu "
    "kommen." );
  AddDetail( ({ "forscherpunkte","forscherpunkt" }),
    "Geschenkt wird Dir hier keiner, Du musst Dich schon anders drum bemuehen." );
  AddSpecialDetail( "spuren","detailSpuren" );
  AddDetail( "pfade",
    "Einer fuehrt schnurgerade nach Osten und ein kurzer Pfad zweigt nach Sueden "
    "ab und endet vor einer grossen Blockhuette." );
  AddDetail( "osten",
    "Der Pfad fuehrt schnurgerade nach Osten, wo Du noch mehrere Laeden wie "
    "diesen im Sueden erblickst." );
  AddDetail( "westen",
    "Nach Westen kannst Du durch das offenstehende Tor auf den Marktplatz von "
    "Yiqanuc schauen." );
  AddDetail( "marktplatz",
    "Er ist zu weit weg, um mehr zu erkennen als ein paar Xandim, die sich "
    "daraus bewegen." );
  AddDetail( "sueden",
    "Ein kurzer Pfad zweigt vom grossen ab und endet vor einer grossen "
    "Blockhuette." );
  AddDetail( ({ "blockhuette","blockhuetten" }),
    "Dem Stil nach sind die Holzhuetten dem von Blockhuetten nachempfunden." );
  AddDetail( "suedwesten",
    "Auch nach Suedwesten zweigt ein schmaler Pfad vom grossen ab. Du musst "
    "schon in diese Richtung gehen, damit Du mehr sehen kannst." );
  AddDetail( ({ "richtung","richtungen" }),
    "Sieh Dir die Ausgaenge an, dann siehst Du die moeglichen Richtungen, in "
    "die Du gehen kannst." );
  AddDetail( "stellen",
    "An vielen Stellen liegt Neuschnee. Nur nicht auf dem Pfad der vom Tor "
    "nach Westen fuehrt, und auch nicht auf dem kurzen Pfad, der zu dem "
    "Laden im Sueden abzweigt." );
  AddDetail( "himmel",
    "Du laesst Dich vom Anblick voll hinreissen. Die Sonne leuchtet hell, "
    "taucht den gesamten Horizont in ein schoenes blau, und nur im Norden "
    "kannst Du ganz kleine Wolken erblicken." );
  AddDetail( "anblick",
    "Der Anblick des Himmels ist einfach maerchenhaft." );
  AddDetail( "norden",
    "Noerdlich von Dir spielen viele Xandimkinder. Sie bauen Schneemaenner, "
    "werfen Schneebaelle und lachen froehlich. Ueber ihnen und der "
    "Holzpalisade machst Du kleine Wolken aus." );
  AddDetail( ({ "schneebaelle","schneeball" }),
    "Noerdlich von Dir fliegen ganz schoen viele Schneebaelle herum, aber das "
    "wundert Dich nicht, denn einige Xandimkinder sind in einer "
    "Schneeballschlacht verwickelt. Hier fuehlst Du Dich allerdings noch "
    "sicher, sodass Du von keinem Schneeball getroffen werden solltest." );
  AddDetail( "holzpalisade",
    "Der gesamte Ostplatz wird von einer Holzpalisade umgeben." );
  AddDetail( "horizont",
    "Der gesamte Horizont ist blau, abgesehen von den paar Wolken im Norden." );
  AddDetail( "sonne",
    "Die Sonne lacht Dir freundlich entgegen. Am liebsten wuerdest Du es ihr "
    "gern gleich tun." );
  AddDetail( "wolken",
    "Ueber der Holzpalisade im Norden erblickst Du ganz kleine Wolken, die "
    "vielleicht einen neuerlichen Schneefall mit sich bringen." );
  AddDetail( "schneefall",
    "Ob die Wolken einen neuerlichen Schneefall mit sich bringen?" );
  AddDetail( ({ "torfluegel","torfluegeln","fluegel","fluegeln" }),
    "Die Torfluegel des gewaltigen Tores sind im Gegensatz zur Eispalisade aus "
    "Holz und stehen weit nach innen geoeffnet, sodass Du jederzeit nach "
    "Yiqanuc zurueckgehen kannst." );
  AddDetail( ({ "palisade","palisaden" }),
    "Welche der beiden Palisaden willst Du Dir naeher ansehen? Die "
    "Eispalisade oder doch lieber die Holzpalisade?" );
  AddDetail( "eispalisade",
    "Die Eispalisade ragt im Westen hoch in den Himmel und umgibt das Dorf "
    "Yiqanuc. Sie besteht nur aus Eis und Schnee und wurde hier unterbrochen, "
    "damit das gewaltige Tor den Durchgang zwischen Yiqanuc und Ostplatz "
    "ermoeglicht." );
  AddDetail( "dorf",
    "Das Dorf liegt weiter im Westen, zumindest was das Wohngebiet anbelangt, "
    "denn dieser Platz zaehlt auch zu Yiqanuc." );
  AddDetail( "wohngebiet",
    "Das Wohngebiet von Yiqanuc liegt hinter der Eispalisade." );
  AddDetail( "durchgang",
    "Da das Tor offen steht, gibt es einen Durchgang von Yiqanuc zu diesem "
    "Platz." );
  AddDetail( "eis",
    "Wie nicht anders zu erwarten, besteht die Eispalisade aus Eis." );
  AddDetail( ({ "gegensatz","gegensaetze" }),
    "Die Torfluegel des Tores sind aus Holz und die Eispalisade ist aus Eis. "
    "Sowas nennt sich Gegensatz. Angeblich sollen sich Gegensaetze anziehen, "
    "aber das weiss man nie so genau." );
  AddDetail( ({ "dinge","holz" }),
    "Vieles auf dem Ostplatz ist aus Holz. Dir fallen folgende Dinge aus Holz "
    "auf: die Torfluegel des Tores, die Holzpalisade, der Holzdeckel des "
    "Tonkruges, die Holzhuetten und auch die Ladentische. Du bist maechtig "
    "stolz auf Deine Beobachtungsgabe." );
  AddDetail( "beobachtungsgabe",
    "Deine ist hervorragend. Das steht ausser Frage." );
  AddDetail( ({ "frage","fragen" }),
    "Stellen, nicht untersuchen!" );
  AddDetail( ({ "tore","tor","osttor" }),
    "Das Osttor von Yiqanuc ist beinahe so gewaltig wie die Eispalisade. Es "
    "besteht aus zwei grossen Torfluegel, die derzeit nach innen geoeffnet sind." );
  AddDetail( "yiqanuc",
    "Yiqanuc ist die Heimat der Xandim. Durch das offenstehende Tor siehst Du "
    "sogar die Hauptstrasse." );
  AddDetail( "hauptstrasse",
    "Gehe durch das Tor durch, dann gelangst Du dort hin." );
  AddDetail( "heimat",
    "Yiqanuc ist die Heimat der Xandim. Deine ist allerdings weit weg und Du "
    "bekommst leichtes Heimweh." );
  AddDetail( "heimweh",
    "Du sehnst Dich nach Deiner Heimat. Wenn Du bloss etwas finden wuerdest, "
    "womit Du Dich ablenken koenntest, damit Du nicht staendig an Deine "
    "Heimat denken musst." );
  AddDetail( ({ "ostplatz","platz" }),
    "Du bist mitten auf dem Ostplatz und erfreust Dich an dem bunten Treiben, "
    "das sich auf diesem Platz abzuspielen scheint. Der Ostplatz wird von "
    "einer Holzpalisade umringt und ist Treffpunkt fuer jung und alt." );
  AddDetail( "treffpunkt",
    "Der Ostplatz ist Treffpunkt fuer jung und alt, wie Du bereits nach "
    "wenigen Minuten feststellen kannst. Xandim spazieren bei den Laeden "
    "vorbei, waehrend die Kinder ueberall herumlaufen." );
  AddDetail( ({ "minute","minuten" }),
    "Du bist erst wenige Minuten auf dem Ostplatz, doch hast Du schon bald "
    "erkannt, dass das ein Treffpunkt fuer jung und alt ist." );
  AddDetail( ({ "auge","augen" }),
    "Deine Augen sehen noch ganz gut und deshalb ist es Dir auch moeglich, "
    "das Treiben auf dem Ostplatz naeher zu betrachten." );
  AddDetail( "treiben",
    "Das Treiben vor Deinen Augen ist wirklich gewaltig. Erwachsene spazieren "
    "vor Laeden dahin, andere betreten diese, wieder andere essen etwas. Die "
    "Kinder laufen ueberall vergnuegt herum, bauen Schneemaenner oder sind "
    "in eine Schneeballschlacht verwickelt. Und zwischen all den Xandim "
    "laufen auch noch ein paar Schlittenhunde umher, die an keinen Leinen "
    "festgehalten werden." );
  AddDetail( ({ "schneeballschlachten","schneeballschlacht" }),
    "Einige Kinder sind in eine Schneeballschlacht verwickelt. Du bist schon zu "
    "alt fuer solche Kindereien." );
  AddDetail( "kindereien",
    "Obwohl Du hin und wieder ein kindliches Gemuet hast, so findest Du, dass "
    "Du fuer Schneeballschlachten zu alt bist. Es gibt sicher noch viel "
    "anderes, das Du auf dem Ostplatz machen kannst." );
  AddDetail( "gemuet",
    "Dein Gemuet kann beizeiten recht kindlich werden." );
  AddDetail( ({ "bauen","schneemaenner" }),
    "Direkt neben dem Pfad, noerdlich von Dir, bauen die Kinder eifrig an "
    "ihren Schneemaennern. Sie scheinen eine wahre Freude daran zu haben." );
  AddDetail( "freude",
    "Die Kinder haben eine wahre Freude am Bauen von Schneemaennern. "
    "Vielleicht waere das auch was fuer Dich?" );
  AddDetail( "xandim",
    "Viele Xandim gehen gemuetlich an den Laeden vorbei, sehen sich um, und "
    "zeitweise betreten sie einen Laden, um etwas darin zu kaufen." );
  AddDetail( ({ "xandimkinder","kinder" }),
    "Es laufen zwar auch ein paar auf diesem Pfad herum, doch die meisten "
    "befinden sich noerdlich von Dir, wo sie entweder Schneemaenner bauen, "
    "in einer Schneeballschlacht verwickelt sind oder mit den "
    "Schlittenhunden spielen." );
  AddDetail( ({ "erwachsene","erwachsenen" }),
    "Die Erwachsenen spazieren auf dem ausgetretenen Weg entlang und sehen "
    "sich bei den Laeden um. Dir faellt auf, dass sie, obwohl sie sich "
    "anscheinend um andere Sachen kuemmern, stets ein Auge auf ihre Kinder "
    "geworfen haben." );
  AddDetail( ({ "sache","sachen" }),
    "Auch wenn sich die Erwachsenen um andere Sachen kuemmern, haben sie "
    "stets ein Auge auf ihre Kinder geworfen." );
  AddDetail( ({ "weg","pfad" }),
    "Der Weg ist ein ausgetretener Pfad im Schnee, der eine Breite von ein "
    "paar Metern hat und der von dem Tor in der Eispalisade genau nach Osten "
    "verlaeuft, wo er vor einem weiteren Tor in der Holzpalisade endet. Von "
    "dem Weg zweigt ein kurzer Pfad zu dem Laden suedlich von Dir ab und "
    "ein schmaler Pfad nach Suedwesten." );
  AddDetail( "breite",
    "Der Weg, der von Westen nach Osten fuehrt, hat eine Breite von ein paar "
    "Meter." );
  AddDetail( ({ "hoehe","meter" }),
    "Die Steine am Wegesrand sind zu einer Hoehe von einem Meter "
    "aufgestapelt und der Weg ist mehrere Meter breit." );
  AddDetail( "laeden",
    "Suedlich vom Weg sind einige Laeden errichtet worden. Einige davon sind "
    "ganze Holzhuetten, andere wiederum haben sich mit einem Ladentisch "
    "zufrieden gegeben." );
  AddDetail( ({ "holzhuetten","huetten","holzhuette","huette" }),
    "Manche Laeden werden durch Holzhuetten repraesentiert, andere wiederum "
    "nur durch Ladentische." );
  AddDetail( ({ "ladentisch","ladentische","tisch","tische" }),
    "Die einfacheren Laeden bestehen nur aus einem Ladentisch, doch soll man "
    "den Wert der dort verkauften Waren nicht unterschaetzen." );
  AddDetail( "groesse",
    "Du solltest von der Groesse des Laeden nicht automatisch auf den Wert "
    "der Waren schliessen. Und falls Du die Groesse vom Tonkrug meinst, so "
    "ist diese so hoch wie eine Fee gross ist." );
  AddDetail( "wert",
    "Die Groesse eines Ladens sagt nichts ueber den Wert der dort verkauften "
    "Waren aus." );
  AddDetail( ({ "schlittenhunde","hunde" }),
    "Sie laufen ueberall frei herum, hin und wieder stosst einer an Deinem "
    "Bein an und verschwindet wieder. Vor diesen Tieren hast nicht einmal "
    "Du Angst, denn sogar die Kinder streicheln sie neben dem Pfad und den "
    "Hunden scheint es zu gefallen." );
  AddDetail( "bein",
    "Ach, dem geht es ganz gut. Sieh Dich besser auf dem Ostplatz um." );
  AddDetail( "angst",
    "Vor den Schlittenhunden hast Du keine Angst. Die sehen ja auch alle sehr "
    "friedlich aus." );
  AddDetail( ({ "tier","tiere" }),
    "Die Schlittenhunde sind anscheinend die einzigen Tiere auf dem Platz. "
    "Katzen werden wohl keine gehalten." );
  AddDetail( ({ "katze","katzen" }),
    "Katzen kannst Du wirklich keine sehen." );
  AddDetail( ({ "leinen","leine" }),
    "Du suchst bei den Schlittenhunden nach Leinen, kannst aber beim besten "
    "Willen keine finden." );
  AddDetail( ({ "wille","willen" }),
    "Du kannst beim besten Willen keine Leinen an den Schlittenhunden "
    "finden." );
  AddDetail( "durcheinander",
    "Das Durcheinander bzw das Treiben auf dem Ostplatz ist so gross, dass Du "
    "das kleine Wirtshaeuschen am Wegesrand beinahe uebersehen haettest." );
  AddDetail( ({ "wirtshaus","wirtshaeuschen" }),
    "Der Ausdruck Wirtshaus ist mehr als uebertrieben. Kleine Labestation "
    "waere schon zutreffender. Mehrere Steine wurden in Kreisform hingelegt "
    "und zu einer Hoehe von einem Meter hoch gestapelt. Darauf wurde ein "
    "Gestell aus Eisen aufgebaut, um darauf das Essen grillen zu koennen. "
    "Daneben steht noch ein riesiger Tonkrug, aus dem irgendeine Fluessigkeit "
    "geschoepft werden kann, und hinter beiden steht der Wirt des "
    "Wirtshauses." );
  AddDetail( "essen",
    "Kannst Du nur daran denken? Sieh Dir halt das Fleisch auf dem Gestell an "
    "oder mach <menue>, dann weisst Du, was es gibt." );
  AddDetail( "ausdruck",
    "Labestation ist treffender als Wirtshaus." );
  AddDetail( "gestell",
    "Das Gestell hat vier Fuesse, die auf den Steinen aufliegen, und eine "
    "Grillflaeche, auf die der Wirt das Fleisch grillen kann. Das ganze ist "
    "aus Eisen, es koennte aber auch Stahl sein." );
  AddDetail( ({ "eisen","stahl" }),
    "Du bist Dir nicht sicher, ob das Gestell aus Eisen oder Stahl ist, aber "
    "das ist Dir ziemlich egal, solange das Fleisch gut schmeckt." );
  AddDetail( "grillflaeche",
    "Die Grillflaeche ist kreisrund, hat einen Aussenring, an dem die vier "
    "Fuesse sind, und mehrere Querstreben, zwischen denen das Fett vom "
    "Fleisch abtropft." );
  AddDetail( "aussenring",
    "Am Aussenring der Grillflaeche halten sowohl die Querstreben als auch "
    "die Fuesse." );
  AddDetail( "querstreben",
    "Die Querstreben sind innerhalb von Aussenring angebracht. Einerseits "
    "liegt das Fleisch auf ihnen auf, andererseits tropft das Fett in den "
    "Zwischenraeumen nach unten ab." );
  AddDetail( ({ "zwischenraeume","zwischenraum" }),
    "Durch die Zwischenraeume tropft das Fett nach unten ab." );
  AddDetail( "fett",
    "Viel Fett scheint das Fleisch nicht zu haben, denn es zischt nur selten, "
    "wenn das Fett auf das Feuer darunter trifft." );
  AddDetail( "fuesse",
    "Die Fuesse vom Gestell sitzen auf den Steinen auf und sitzen so "
    "praezise, sodass das Gestell kein bisschen wackelt." );
  AddDetail( "labestation",
    "An der Labestation kannst Du Dich laben. Mit <menue> weisst Du, welche "
    "Speisen und Getraenke derzeit verkauft werden." );
  AddDetail( "speisen",
    "Einige leckere Speisen kannst Du auf der Grillflaeche sehen, wie "
    "Hotdogs, Braten, Steaks und Ripperl." );
  AddDetail( ({ "hotdogs","hotdog","rentierhotdogs","rentierhotdog",
                "wuerstchen","wurst" }),
    "Zahlreiche Wuerstchen liegen auf der Grillflaeche, die nur darauf "
    "warten, als Hotdog in Deine Haende gelangen zu koennen." );
  AddDetail( ({ "haende","hand" }),
    "Deine Haende koennen es nicht mehr erwarten, bald einen Hotdog halten zu "
    "koennen, und Dein Magen wird sich erst recht freuen." );
  AddDetail( "magen",
    "Sehen wirst Du ihn nicht koennen, aber hoeren vielleicht." );
  AddDetail( ({ "braten","rentierbraten" }),
    "Ein ziemlich grosser Rentierbraten bruzzelt vor Deinen Augen dahin und "
    "Du willst unbedingt ein Stueck davon kosten." );
  AddDetail( "stueck",
    "Kauf Dir doch ein Stueck vom Rentierbraten, dann weisst Du wie gut er "
    "ist." );
  AddDetail( ({ "steak","steaks","karibusteaks","karibusteak" }),
    "Ein paar saftige Steaks liegen auch auf der Grillflaeche und scheinen "
    "sehr wenig Fett zu haben. Hoffentlich sind sie nicht zu trocken ..., "
    "aber das wirst Du schon sehen, wenn Du eines isst." );
  AddDetail( ({ "fleisch","fleischsorten","fleischsorte" }),
    "Mehrere Fleischsorten werden gerade gegrillt, wie Rentierfleisch, "
    "Karibufleisch und Walfischfleisch." );
  AddDetail( "karibufleisch",
    "Dieses Fleisch ist deutlich dunkler als die anderen Fleischsorten, was "
    "aber auch daran liegen kann, dass es laenger auf der Grillflaeche liegt "
    "als die anderen." );
  AddDetail( ({ "walfleisch","walfischfleisch" }),
    "Dieses Fleisch ist fettreicher als die anderen, denn bei den Ripperl "
    "tropft es ab und zu nach unten, dass es dort kurzzeitig zischt." );
  AddDetail( "rentierfleisch",
    "Es ist heller als das Karibufleisch und auch noch ein bisschen magerer, "
    "aber wenn Du mehr davon wissen willst, wuerde ich es einfach kosten." );
  AddDetail( ({ "ripperl","walfischripperl","ripperln","walfischripperln" }),
    "Die Walfischripperl sind nicht zu uebersehen, denn sie bedecken fast die "
    "ganze Grillflaeche und Teile davon stehen ohnehin drueber hinaus. Ob "
    "irgendwer es schon geschafft hat, ein ganzes aufzuessen? Vorstellen "
    "kannst Du es Dir nicht." );
  AddDetail( ({ "teil","teile" }),
    "Die Walfischripperl sind so gross, dass ein Teil von ihnen ueber die "
    "Grillflaeche hinaussteht. Der Wirt muss diese wohl regelmaessig "
    "weiterschieben, damit auch das ganze Fleisch ordentlich durch ist." );
  AddDetail( "getraenke",
    "Sehr viele unterschiedliche Getraenke wird es hier kaum geben, denn Du "
    "siehst nur einen riesigen Tonkrug, aus dem es dampft, aber Du wirst "
    "sicher mehr erfahren, wenn Du Sidra fragst oder <menue> tippst." );
  AddDetail( "gluehwein",
    "Den kannst Du derzeit nur riechen, weil er im Tonkrug ist." );
  AddDetail( ({ "stein","steine" }),
    "Neben dem Weg wurden mehrere Steine zu einer Hoehe von einem Meter in "
    "Kreisform hingelegt, um darin ein Feuer zu schueren. Von dort strahlt "
    "auch eine angenehme Waerme ab, wobei man darauf achten sollte, sich "
    "nicht an den Steinen die Finger zu verbrennen." );
  AddDetail( "feuer",
    "Hin und wieder siehst Du, wie Flammen nach oben zuengeln, wohl deshalb, "
    "weil das Fett des Fleisches auf das Feuer tropft. Wie das Feuer gemacht "
    "wurde bzw welches Brennmaterial verwendet wird, siehst Du nicht." );
  AddDetail( ({ "flammen","flamme" }),
    "Flammen zuengeln hin und wieder nach oben und bringen das Fleisch zum "
    "Bruzzeln." );
  AddDetail( "bruzzeln",
    "Das Fleisch bruzzelt vor sich dahin." );
  AddDetail( "brennmaterial",
    "Auch wenn Du es gern wissen wuerdest, siehst Du nicht, welches "
    "Brennmaterial im Ofen verwendet wird." );
  AddDetail( ({ "kohle","heisses" }),
    "Du versuchst in den Ofen hineinzuschauen, aber durch das viele Fleisch "
    "erkennst Du nicht, ob hier tatsaechlich mit Kohle gegrillt wird. Dir "
    "kam es sogar eher so vor, als ob gluehende Steine verwendet werden." );
  AddDetail( ({ "gluehende steine","gluehenden steine" }),
    "Angestrengend blickst Du in den Ofen hinein und Du merkst, dass eine "
    "spezielle Gesteinsart verwendet wurde, die anscheinend so stark gluehen "
    "kann, dass sie viel Hitze von sich abstrahlt." );
  AddDetail( "hitze",
    "Eine sehr starke Hitze geht von den Steinen im Ofen aus, sodass Sidra "
    "darauf alle moeglichen Fleischsorten grillen kann." );
  AddDetail( "gesteinsart",
    "Du kommst leider nicht drauf, um welche Gesteinsart es sich handelt, "
    "aber Sidra muesste es wohl wissen." );
  AddDetail( "finger",
    "Du willst Dir doch sicher nicht die Finger an den Steinen verbrennen?" );
  AddDetail( ({ "kreis","kreisform" }),
    "Die Steine wurden kreisfoermig aufgelegt, damit das Gestell aus Eisen "
    "genau drauf passt." );
  AddDetail( "waerme",
    "Durch den Ofen am Wegesrand ist es hier ein bisschen waermer." );
  AddDetail( "ofen",
    "Die in einem Kreis aufgestellten Steine dienen dem Wirt als Ofen. Wie "
    "sonst sollte er bei dieser Kaelte etwas grillen koennen." );
  AddDetail( "kaelte",
    "Ganz schoen kalt hier, aber vor dem Wirtshaus laesst es sich gut "
    "aushalten." );
  AddDetail( ({ "tonkrug","krug" }),
    "Der Tonkrug ist nicht ganz einen Hobbit hoch und hat einen Durchmesser, "
    "der der Groesse einer Fee entspricht. Auf ihm liegt ein Deckel aus Holz "
    "mit einem Griff und einem kleinen Loch, aus dem Dampf entweicht. Was "
    "fuer ein koestliches Getraenk wohl darin verborgen ist?" );
  AddDetail( "dampf",
    "Da Dampf aus dem Tonkrug entweicht, bist Du Dir sicher, dass ein warmes "
    "Getraenk darin aufbewahrt wird." );
  AddDetail( "ton",
    "Der Tonkrug ist wenig erstaunlich aus Ton." );
  AddDetail( ({ "fee","feen" }),
     ([ 0: "Der Durchmesser des Tonkruges entspricht in etwa der Groesse "
           "einer Fee.",
    "fee": "Der Durchmesser des Tonkruges entspricht in etwa Deiner Groesse. "
           "Dir behagt dieser Vergleich ganz und gar. Tonkruege mit "
           "zierlichen Feen zu vergleichen. *pah*" ]) );
  AddDetail( "durchmesser",
    "Der Durchmesser des Tonkrug entspricht der Groesse einer Fee." );
  AddDetail( ({ "getraenk","fluessigkeit" }),
    "Nur zu gern wuesstest Du, welches Getraenk in dem Tonkrug ist. Ich rate "
    "Dir, Sidra danach zu fragen oder am besten es gleich bei ihm zu "
    "bestellen." );
  AddDetail( "griff",
    "Ohne Griff koennte man den Holzdeckel schwierig heben, denn er sitzt "
    "fest im Tonkrug drin." );
  AddDetail( ({ "hobbit","hobbits" }),
        ([ 0: "Der Tonkrug ist nicht ganz so hoch wie ein Hobbit gross ist.",
    "hobbit": "Der Tonkrug ist fast so hoch wie Du. *hmmmm*schleck* Da ist "
              "ganz bestimmt etwas Koestliches drin." ]) );
  AddDetail( ({ "holzdeckel","deckel" }),
    "Auf dem Tonkrug liegt ein Deckel aus Holz, der die Fluessigkeit im Krug "
    "warmhaelt und der mit einem Griff versehen ist, damit Sidra ihn stets "
    "auf- und zumachen kann." );
  AddDetail( "loch",
    "Durch das Loch im Holzdeckel des Tonkrugs kann der Dampf entweichen. Es "
    "ist aber zu klein, um zu sehen, welche Fluessigkeit sich drinnen "
    "verbirgt." );
  AddDetail( ({ "sidra","wirt" }),
    "Du wunderst Dich doch sehr, dass der Wirt derzeit nicht da ist. So wird "
    "er mit seinem Wirtshaus nie einen Gewinn erzielen. Es koennte auch "
    "sein, dass er neues Fleisch geholt hat, da er so einen reissenden Absatz "
    "hat." );
  AddDetail( "absatz",
    "Ob der Wirt einen reissenden Absatz hat oder nicht, musst Du ihn schon "
    "selber fragen." );
  AddDetail( "gewinn",
    "Nicht alle denken so gewinnorientiert wie Du. Sidra ist eben wichtig, "
    "dass alle, die bei ihm vorbeikommen, zufrieden gehen und gern wiederkommen." );
  AddDetail( "silberland",
    "Das Silberland ist zwar gross, aber dieses Wirtshaus am Wegesrand "
    "zaehlt sicher zu den kleinsten, die Dir bisher untergekommen sind." );
  AddDetail( ({ "wegesrand","rand" }),
    "Der Wegesrand ist ueberhaupt nicht aufregend. Der Unterschied zum Pfad "
    "ist nur der, dass der Neuschnee noch nicht niedergetreten wurde. Das "
    "einzige, dass Deine Aufmerksamkeit erregt, ist die Labestation, die "
    "im Treiben beinahe Deinen Blick entgangen waere." );
  AddDetail( "aufmerksamkeit",
    "Deine Aufmerksamkeit wird oft erregt, aber dieses Mal insbesondere "
    "durch die Labestation am Wegesrand." );
  AddDetail( "mal",
    "Nein, das beschreibe ich Dir dieses Mal nicht." );
  AddDetail( "blick",
    "Beinahe waere Deinem sonst so aufmerksamen Blick die Labestation am "
    "Wegesrand entgangen." );
  AddDetail( "unterschied",
    "Der Unterschied zwischen Wegesrand und Pfad ist einfach erklaert. Auf "
    "dem Pfad wurde der Neuschnee niedergetreten, waehrend er daneben noch "
    "so daliegt, als ob es erst vor Stunden geschneit haette." );
  AddDetail( "stunden",
    "Du glaubst nicht, dass es erst vor wenigen Stunden geschneit hat, denn "
    "sonst muessten noch mehr Wolken da sein. Andererseits, Wetterexperte "
    "bist Du noch lange keiner." );
  AddDetail( "wetterexperte",
    "Du bist ganz sicher keiner. Die Xandim kennen sich beim Wetter sicher "
    "besser aus als Du." );
  AddDetail( "wetter",
    "Schau den Himmel an, dann kennst Du das momentane Wetter." );
  AddDetail( ({ "kurzer pfad","kurzen pfad" }),
    "Ein kurzer, ebenfalls im Schnee ausgetretener Pfad fuehrt nach Sueden "
    "zu einer Stufe vor die Tuer des Ladens." );
  AddDetail( ({ "stufe","holzstufe" }),
    "Vor der Eingangstuer ist eine kleine Stufe. Gib bloss acht, dass Du "
    "nicht darueber stolperst, wenn Du den Laden betrittst. Der Raum unter "
    "der Stufe eignet sich ideal als Unterschlupf fuer ein kleines Tier." );
  AddSpecialDetail( ({ "raum","unterschlupf" }), "detailUnterschlupf" );
  AddSpecialDetail( "frettchen", "detailFrettchen" );
  AddDetail( ({ "eingangstuer","tuer" }),
    "Die Eingangstuer vom Laden steht nach innen geoeffnet, also kannst Du "
    "ohne Schwierigkeiten in ihn eintreten, vorausgesetzt Du stolperst nicht "
    "ueber die Stufe." );
  AddDetail( "schwierigkeiten",
    "Wenn Du keine Schwierigkeiten machst, dann wirst Du auch sicher keine "
    "mit den Xandim haben." );
  AddDetail( ({ "richtung","richtungen","himmelsrichtung",
                "himmelsrichtungen" }),
    "Dir bleibt es natuerlich ueberlassen, in jede Himmelsrichtung zu "
    "blicken, doch verlasse Dich nicht darauf, dass jede einzelne auch von "
    "mir beschrieben wird." );
  AddDetail( ({ "nordwesten","nordosten","suedosten" }),
    "Gratuliere, Du hast geschafft! Du hast eine Himmelsrichtung entdeckt, "
    "zu der es keine weitere Beschreibung gibt. Ein Hoch auf Deine "
    "Forschtechnik!" );
  AddDetail( "hoch",
    "Du kommst noch hoch hinaus, wenn Du so weitermachst wie bisher." );
  AddSpecialDetail( "forschtechnik", "detailForschtechnik" );
  AddDetail( "sueden",
    "Nach Sueden fuehrt ein kurzer Pfad, an dessen Ende eine Holzhuette "
    "errichtet wurde." );
  AddDetail( "ende",
    "Am Ende des kurzen Pfades nach Sueden wurde eine Holzhuette errichtet. "
    "Geh ruhig rein." );
  AddDetail( "eingang",
    "Der Eingang ist eine Tuer im Laden und die steht weit offen. Also, "
    "falls Du Dich traust, dann tritt ruhig ein." );
  AddDetail( "laden",
    "Der Laden wurde im Stil einer Blockhuette gebaut und sieht nicht viel "
    "anders aus als die anderen Laeden auf dem Platz. Vielleicht verraet "
    "Dir das Schild, das neben der Eingangstuer angebracht wurde, mehr "
    "ueber die Waren, die drinnen angeboten werden." );
  AddDetail( "schild",
    "Das Schild ist rechteckig und wurde neben der Eingangstuer festgenagelt." );
  AddReadDetail( "schild",
    "          +-----------------------------------+\n"
    "          |             Saphiras              |\n"
    "          |           Schmuckladen            |\n"
    "          |                                   |\n"
    "          | Machen Sie ihrer Frau eine Freude |\n"
    "          |   und schenken sie ihr doch ein   |\n"
    "          |     huebsches Schmuckstueck.      |\n"
    "          +-----------------------------------+\n" );
  AddDetail( "stil",
    "Der Laden wurde im typischen Stil einer Blockhuette gebaut. Sieh Dir "
    "ruhig noch andere Laeden auf dem Platz an, dann wirst Du wissen, was "
    "ich meine." );
  AddDetail( ({ "waren","ware" }),
    "Welche Waren im Laden verkauft werden, kannst Du von aussen natuerlich "
    "nicht erkennen, aber um einen Hinweis zu kriegen, koenntest Du "
    "eventuell das Schild neben der Eingangstuer lesen." );
  AddDetail( "hinweis",
    "Willst Du wissen, welche Waren im Laden verkauft werden, dann rate ich "
    "Dir das Schild zu lesen." );
  AddDetail( "blickfeld",
    "Mach doch am besten <schau>, dann kennst Du Dein Blickfeld." );
  AddSpecialDetail( ({ "eck","ecke" }), "detailEcke" );
  AddSpecialDetail( "kuegelchen", "detailKuegelchen" );
  AddDetail( "menge",
    "Man koennte auch sagen, dass sich ziemlich viel um Dich herum "
    "abspielt, denn ueberall, wo Du hinsiehst, halten sich Xandim auf. "
    "Erwachsene, die an den Laeden vorbeispazieren oder Kinder, die im "
    "Norden von Dir spielen." );
  AddDetail( ({ "ohr","ohren" }),
    "Was Du immer mit Deinen Ohren hast? Die sind noch immer dort, wo sie "
    "bislang waren, also bloss nicht unnoetig nervoes deswegen werden." );
  AddDetail( "moment",
    "Welchen meinst Du? Diesen, den eben oder den, der gleich kommen wird?" );
  AddDetail( ({ "herumschreien","schreie","unterhaltungen","unterhaltung",
                "gespraech","gespraeche","zischen" }),
    "Du wirst Dich leichter tun, wenn Du Dich eher auf Deine Ohren denn auf "
    "Deine Augen in diesem Fall verlaesst." );
  AddDetail( "fall",
    "Fall nicht auf jeden Bloedsinn rein!" );
  AddDetail( "bloedsinn",
    "Jetzt bist Du erst drauf reingefallen! *zungerausstreck*" );
  AddDetail( "stille",
    "Die wirst Du auf diesem Platz sicher nicht so schnell finden." );
  AddDetail( "freund",
    "Du bist Dir selbst der beste Freund." );
  AddDetail( "forschen",
    "Forsch mal schoen!" );
  AddDetail( ({ "polar","polargebiet" }),
    "Da Du nicht weit von den Toren Yiqanucs entfernt bist, weisst Du, "
    "dass Du Dich noch immer im Polargebiet aufhaeltst." );
  AddDetail( ({ "winterluft","luft" }),
    "Die Luft, die Dich umgibt, kannst Du vorallem anhand des Hauchs vor "
    "Deinem Gesicht erkennen." );
  AddDetail( "hauch",
    "Es ist dermassen kalt, dass Du den Hauch direkt vor Deinem Gesicht "
    "sehen kannst. Erstaunlicherweise ist das bei den Xandim nicht einmal "
    "ansatzweise so arg wie bei Dir." );
  AddDetail( "gesicht",
    "Du tastest kurz ueber Dein Gesicht und es scheint noch immer alles zu "
    "passen." );
  AddDetail( "nase",
    "Glaub es mir! Sie ist noch dran, denn ansonsten wuerdest Du Dir bei "
    "weitem schwerer tun, etwas zu riechen." );
  AddDetail( "liebhaber",
    "Ob Du gegrillte Speisen magst oder nicht, musst Du selbst wissen." );
  AddDetail( ({ "stadt","midas" }),
    "Midas liegt ganz ganz weit weg von hier, dass Du die Stadt nie und "
    "nimmer von hier aus sehen wirst koennen." );
  AddDetail( "geschmack",
    "Den Geschmack kannst Du nicht untersuchen, entweder Du hast einen oder "
    "eben nicht." );
  AddDetail( ({ "tores","hunden","schlittenhunden","wirtshauses","weges",
                "tieren","ladens","koestliches","durcheinanders",
                "zwischenraeumen","schneemaennern","vergleich","daechern",
                "forscherpunkten","tonkrugs","tonkruges","steinen","pfaden",
                "himmels","fleisches","pfades","yiqanucs","toren","hauchs" }),
    "Das kannst Du nicht untersuchen." );

  AddSound( ({ "ostplatz", DEFAULT_SOUND }),
    "Soviele unterschiedliche Geraeusche treffen auf Deine Ohren, dass Du im "
    "ersten Moment nicht einmal weisst, worauf Du Dich konzentrieren sollst. "
    "Du hoerst das Herumschreien der Kinder, die spielen, die Unterhaltungen "
    "zwischen den Erwachsenen, ein paar Schlittenhunde, die bellen, und "
    "direkt neben Dir das Bruzzeln von Fleisch, das wohl gegrillt wird." );
  AddSound( "geraeusche",
    "Ein Freund von Stille darfst Du nicht sein, denn hier es alles andere "
    "als ruhig. Kinder schreien, Erwachsene unterhalten sich und "
    "Schlittenhunde bellen, aber trotzdem fuehlst Du Dich angenehm wohl in "
    "der Menge." );
  AddSound( ({ "ohren","ohr" }),
    "Du kannst zwar mit ihnen lauschen, aber sie selbst zu hoeren, ist doch "
    "ziemlich schwierig." );
  AddSound( ({ "moment","freund","forschen","polargebiet" }),
    "Bitte versuch nicht jedem und allem zu lauschen, denn nicht alles wird "
    "beschrieben sein." );
  AddSound( ({ "herumschreien","schreie","kinder","xandimkinder" }),
    "Die Kinder schreien sehr ausgelassen herum und niemanden scheint es zu "
    "stoeren, ausser Dir vielleicht, denn es lenkt Dich sehr vom Forschen ab." );
  AddSound( ({ "unterhaltungen","unterhaltung","gespraech","gespraeche",
               "xandim","erwachsene","erwachsenen" }),
    "Ueberall rund um Dich herum unterhalten sich die Xandim miteinander. "
    "Worueber sie reden, kannst Du allerdings nicht feststellen, da "
    "einerseits viele gleichzeitig sprechen und andererseits sehr schnell "
    "reden." );
  AddSound( ({ "schlittenhunde","hunde","schlittenhund","hund","husky",
               "huskies" }),
    "Vorallem im Norden und weiter oestlich von Dir hoerst Du sehr viele "
    "Schlittenhunde bellen. Es klingt fast so, als ob hier saemtliche Hunde "
    "aus dem Polargebiet versammelt waeren." );
  AddSound( ({ "fleisch","bruzzeln" }),
    "Von der Grillflaeche am Wegesrand hoerst Du das Bruzzeln von Fleisch "
    "und auch das Zischen von Fett, das von dem Fleisch auf etwas Heisses "
    "darunter tropft." );
  AddSound( ({ "zischen","fett" }),
    "Du kannst nicht direkt dem Fett lauschen, sondern nur dem Zischen, das "
    "dadurch erzeugt wird, dass das Fett auf etwas Heisses trifft, das unter "
    "der Grillflaeche ist. Ob es sich dabei um Kohle oder ein anderes "
    "Brennmaterial handelt, kannst Du vom Zischen her nicht erkennen." );
  AddSound( ({ "kohle","heisses","brennmaterial","ofen" }),
    "Du lehnst Dein Ohr ganz nahe an die Grillflaeche vom Ofen, doch die "
