    "sich." );
  AddSound( ({ "ton","toene" }),
    "Du hoerst sehr viele Toene und Geraeusche, nur vom Brennmaterial hoerst "
    "Du keinen." );
  AddSound( "stille",
    "Ganz abgesehen davon, dass Du Dir schwer dabei tun wirst, Stille hoeren "
    "zu wollen, ist auf dem Ostplatz so viel los, dass Du sie hier ganz "
    "sicher nicht finden wirst." );
  AddSound( "menge",
    "Du kannst der ganzen Menge nicht auf einmal zuhoeren, sondern Du "
    "solltest Dich vielleicht auf spezielle Geraeusche konzentrieren." );
  AddSound( "magen",
    "Dein Magen knurrt ganz leise." );

  AddSmell( DEFAULT_SMELL,
    "Die meisten Gerueche, die Du aufnehmen kannst, kommen vom Fleisch auf "
    "der Grillflaeche neben dem Wegesrand. Von der frischen Winterluft "
    "bekommst Du dafuer eher weniger mit." );
  AddSmell( ({ "grillflaeche","wegesrand" }),
    "So sehr Du Dich bemuehst, kannst Du nichts daran erriechen." );
  AddSmell( ({ "winterluft","luft" }),
    "Du versuchst tief einzuatmen, um die Winterluft riechen zu koennen, "
    "doch diese ist vom Geruch des gegrillten Fleisches ueberlagert, dass Du "
    "nicht sagen kannst, ob sie hier anders riecht als in Midas." );
  AddSmell( ({ "geruch","gerueche" }),
    "Dir steigt vor allem der Geruch von gegrilltem Fleisch in die Nase und "
    "daneben noch der vom Gluehwein." );
  AddSmell( "nase",
    "Vergiss es!" );
  AddSmell( ({ "dampf","gluehwein","duft" }),
    "Du gehst ganz nah zum Tonkrug hin, um den Gluehwein riechen zu koennen. "
    "Ein angenehmer, leicht suesslicher Duft steigt daraus empor." );
  AddSmell( ({ "rentierbraten","braten","rentierhotdog","hotdog",
               "walfischripperl","ripperl","karibusteak","steak","fleisch" }),
    "Der Geruch von gegrilltem Fleisch steigt von der Grillflaeche empor, und "
    "wenn Du ein Liebhaber von solchen Speisen bist, dann solltest Du so "
    "schnell wie moeglich etwas von den Speisen ausprobieren." );
