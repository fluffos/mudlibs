//Osterweiterung des Xandimdorf, Rage Feb 00

inherit "std/room";
inherit "d/polar/rage/ostplatz/room/rundgang";

#include "../def.h"
#include <moving.h>

int exit_test();

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Du bist in der suedwestlichen Ecke des Ostplatzes zwischen der "
    "Eis- und Holzpalisade und haettest nicht gedacht, dass die Xandim so "
    "ausgelassen sein koennten, aber Du wirst eines besseren belehrt. Eine "
    "Gruppe von sechs Erwachsenen steht neben einer Eisflaeche, die hier "
    "den Anfang hat und hinter dem Laden verschwindet, und, man soll es kaum "
    "glauben, sie messen sich im Eisstockschiessen. Derjenige, der gerade "
    "dran ist, wird von den anderen immer kraeftig angefeuert. Direkt im "
    "Osten von Dir wurde eine Holzhuette errichtet, die Du sicher durch die "
    "Tuer betreten kannst.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -4]) );

//DETAILS
  AddDetail( "boden",
    "Weite Teile des Bodens sind mit Schnee bedeckt. Ein kleiner im Schnee "
    "ausgetretener Pfad fuehrt nach Nordosten auf den Hauptweg des Platzes. "
    "Ausserdem hat keine zwei Meter vor Deinen Fuessen eine Eisflaeche ihren "
    "Anfang." );
  AddDetail( ({ "fuss","fuesse" }),
    "Weniger als zwei Meter von Deinen Fuessen entfernt hat eine Eisflaeche "
    "ihren Anfang." );
  AddDetail( "hauptweg",
    "Den Hauptweg, der quer ueber den Ostplatz fuehrt, kannst Du erreichen, "
    "indem Du dem kleinen Pfad nach Nordosten folgst." );
  AddDetail( "nordosten",
    "Dorthin fuehrt ein kleiner Pfad und bringt Dich auf den Rest des Ostplatzes "
    "zurueck." );
  AddDetail( "rest",
    "Sieh ihn Dir an." );
  AddDetail( "meter",
    "Nein, nein und nochmals nein! Ich beschreibe Dir Meter nicht. Ein Meter "
    "ist Meter und damit hat es sich." );
  AddDetail( "pfad",
    "Ein im Schnee ausgetretener Pfad fuehrt nach Nordosten auf den "
    "Hauptweg des Platzes zurueck. Der Pfad verliert sich vor der Eisflaeche "
    "und geht in einzelne Spuren ueber." );
  AddDetail( ({ "spur","spuren" }),
    "Dort, wo der Pfad endet, verliert er sich in einzelne Spuren, von denen "
    "saemtlich den Xandim gehoeren. Natuerlich sind Deine eigenen mittlerweile "
    "auch darunter." );
  AddDetail( "schnee",
    "Der Schnee ist nicht zu uebersehen. Er liegt auf dem Boden, auf den "
    "Daechern der Laeden und ist auch beim Bau der Eispalisade verwendet "
    "worden." );
  AddDetail( "bau",
    "Beim Bau der Eispalisade wurde neben Eis auch Schnee verwendet." );
  AddDetail( ({ "dach","daecher" }),
    "Auf den Daechern der Laeden liegt, wie auch auf dem Boden, Schnee." );
  AddDetail( "laeden",
    "Laeden gibt es auf dem Ostplatz wie Sand am Meer. Vor Dir steht zum "
    "Beispiel der Schmuckladen, aber Du wirst sicher auch auf andere treffen." );
  AddDetail( "beispiel",
    "Vor Dir steht zum Beispiel der Schmuckladen und die Xandim erholen sich "
    "zum Beispiel beim Eisstockschiessen." );
  AddDetail( ({ "sand","meer" }),
    "Weder Sand noch Meer wirst Du in Yiqanuc finden, obwohl... man kann ja "
    "nie wissen und ploetzlich spuelt Dich eine Flutwelle weg." );
  AddSpecialDetail( ({ "flutwelle","welle" }), "detailFlutwelle" );
  AddDetail( ({ "teile","grossteil" }),
    "Der Grossteil vom Boden ist mit Schnee bedeckt und dort, wo keiner ist, "
    "ist eine Eisflaeche." );
  AddDetail( "himmel",
           ([ 0: "Der Himmel lacht Dich in all seiner Pracht foermlich an. "
                 "Die Sonne steht ziemlich hoch und Wolken sind keine zu "
                 "sehen.",
    "dunkelelf": "Dieser immer strahlend blaue Himmel stoert Dich schon "
                 "gehoerig. Stets scheint die Sonne und Wolken sind auch "
                 "keine zu sehen. Du freust Dich schon auf einen richtigen "
                 "Scheesturm, wo die anderen verweichlichten Rassen jammern "
                 "und klagen werden, waehrend Du unverwegt mit gehobenen "
                 "Haupt durchschreitest." ]) );
  AddDetail( "sonne",
           ([ 0: "Die Sonne steht hoch am strahlend blauen Himmel und lacht "
                 "Dich an.",
    "dunkelelf": "Die Sonne geht Dir langsam, aber sicher auf die Nerven. "
                 "Immer dieses Klischee von schoener, heiler Welt. *wuerg*" ]) );
  AddDetail( "pracht",
    "Der Himmel gibt heute mal wieder sein bestes." );
  AddDetail( ({ "wolken","wolke" }),
    "Es sind keine Wolken zu sehen, die das Blau des Himmels stoeren koennten." );
  AddDetail( "blau",
    "Blau ist nicht nur der Enzian, sondern auch der Himmel." );
  AddDetail( "enzian",
    "Du spinnst wohl! Hier im Dorf gibt es doch keinen Enzian, sondern nur "
    "Veilchen, Rosen, Orchideen und Tulpen." );
  AddDetail( ({ "dorf","xandimdorf" }),
    "Das Dorf der Xandim, in dem Du Dich gerade aufhaelst, heisst Yiqanuc." );
  AddDetail( "rassen",
    "Im Silberland gibt es viele Rassen, und ich meine, dass Du auch schon "
    "auf einige gestossen sein wirst." );
  AddDetail( ({ "eck","ecke" }),
    "Du befindest Dich im Moment in der suedwestlichen Ecke des Ostplatzes, die "
    "von der Eis- und der Holzpalisade gebildet wird." );
  AddDetail( "moment",
    "Im Moment befindest Du Dich in der suedwestlichen Ecke des Ostplatzes. Das "
    "kann sich aber schlagartig aendern, wenn Du nach Nordosten gehst." );
  AddDetail( ({ "ostplatz","platz" }),
    "Der Ostplatz ist der Treffpunkt fuer junge und alte Xandim, um sich nach "
    "schwerer Arbeit erholen zu koennen. Die Xandim, die Du vor Dir stehen "
    "siehst, erholen sich zum Beispiel, indem sie sich im Eisstockschiessen "
    "messen." );
  AddDetail( "arbeit",
    "Xandim muessen immer wieder harte, schwere Arbeit leisten, um sich und "
    "ihre Kinder zu versorgen, deshalb freuen sie sich umso mehr, wenn sie "
    "sich einmal erholen koennen." );
  AddDetail( "treffpunkt",
    "Schau Dich ein wenig auf dem Ostplatz um, dann wirst Du rausfinden, dass "
    "es ein Treffpunkt fuer jung und alt ist." );
  AddDetail( "eispalisade",
    "Die gewaltige Eispalisade, die Dir die Sicht nach Norden und Westen "
    "nimmt, ist etwa fuenf Meter hoch und umgibt ganz Yiqanuc. Sie wird aus "
    "groben, grossen Eisbloecken gebildet, deren Anzahl Du gar nicht wissen "
    "willst, und die Zwischenraeume wurden mit Schnee gefuellt." );
  AddDetail( "anzahl",
    "Die Anzahl der Eisbloecke willst Du gar nicht wissen, das ist viel zu "
    "uninteressant." );
  AddDetail( "sicht",
    "Nach Norden wird Dir durch die Eispalisade die Sicht genommen und durch "
    "den Schnee in der Eispalisade bleibt Dir auch die Sicht auf die "
    "Zwischenraeume verwehrt." );
  AddDetail( "yiqanuc",
    "Die Eispalisade umgibt ganz Yiqanuc und schuetzt so deren Einwohner vor "
    "Eindringlingen. Falls Du es noch nicht weisst: dieses Dorf ist die Heimat "
    "der Xandim." );
  AddDetail( ({ "eindringlinge","eindringling" }),
    "Es sind keine Eindringlinge zu sehen und weisst auch nicht, wer Yiqanuc "
    "angreifen koennte. Du weisst nur, dass die Eindringlinge nicht leicht "
    "ueber die Eispalisade kommen werden." );
  AddDetail( "einwohner",
    "Die Einwohner von Yiqanuc sind die Xandim." );
  AddDetail( "heimat",
    "Fuer diejenigen, die es immer noch nicht durchschaut haben: Die Heimat "
    "der Xandim ist Yiqanuc." );
  AddDetail( ({ "eisbloecke","eisblock","bloecke","block" }),
    "Zahlreiche Eisbloecke wurden verwendet, um die Eispalisade fertigstellen "
    "zu koennen. Sie sind grob aus dem Eis geschlagen und dann neben- und"
    "aufeinander gestapelt worden. Ein einzelner Eisblock misst etwa 1x1 "
    "Meter. Schoen langsam merkst Du, wie gross der Aufwand gewesen sein muss, "
    "um dieses Werk zu vollenden." );
  AddDetail( "aufwand",
    "Der Aufwand, um die Eispalisade fertig zu stellen, muss gigantisch "
    "gewesen sein. Du waerst gern beim Bau der Eispalisade dabeigewesen, aber "
    "leider warst Du das nicht." );
  AddDetail( ({ "werk","werke" }),
    "Ich weiss zwar nicht, welche Werke Du bisher erschafft hast, aber diese "
    "Eispalisade war sicher das Werk vieler Xandim. Allein wuerdest Du damit "
    "auch sicher nie fertig werden." );
  AddDetail( "zwischenraeume",
    "Da die Eisbloecke grob und gross sind, entstanden einige Zwischenraeume "
    "zwischen den einzelnen Bloecken. Die meisten von ihnen sind mit "
    "Schnee gefuellt wurden, doch bei manchen ist der Schnee mit der Zeit "
    "herausgebrochen und deshalb ist die Eispalisade leicht loechrig." );
  AddDetail( "zeit",
    "Mit der Zeit ist der Schnee aus den Zwischenraeumen herausgebrochen oder "
    "geschmolzen, und dadurch wird die Sicht auf die Zwischenraeume wieder"
    "freigegeben." );
  AddDetail( "loecher",
    "Die Loecher in der Eispalisade sind nicht groesser als Dein Finger, "
    "abgesehen von einer Stelle, wo mehr Schnee herausgebrochen ist und "
    "demzufolge der urspruengliche Zwischenraum geblieben ist." );
  AddDetail( "zwischenraum",
    "Dort wo der ganze Schnee zwischen zwei Eisbloecken herausgebrochen ist, "
    "ist der Zwischenraum so gross, dass Dein Arm leicht hinpasst. Leider "
    "siehst Du von aussen nicht, ob sich irgendetwas darin befindet." );
  AddDetail( "holzpalisade",
    "Sie hat ihren Anfang genau an der Eispalisade und umringt den Ostplatz. "
    "Sie besteht aus nebeneinander gereihten Holzpfaehlen, die in den Boden "
    "gerammt wurden und mit Seilen noch zusaetzlich gestuetzt werden." );
  AddDetail( ({ "holzpfaehle","pfaehle" }),
    "Die Holzpfaehle wurden nebeneinander gereiht in den Boden gerammt und mit "
    "Seilen noch zusaetzlich gestuetzt, damit sie nicht umfallen koennen." );
  AddDetail( "seile",
    "Eine Unmenge von Seilen wurden um die Holzpfaehle gewickelt, um sie "
    "zusaetzlich zu stuetzen." );
  AddDetail( "unmenge",
    "Sehr, sehr viele. Nicht mehr ueberschaubar." );
  AddDetail( ({ "rasse","xandim" }),
    "Fuer Dich waren die Xandim eher eine eisige, starke und verschlossene "
    "Rasse, doch hier siehst Du sie sehr ausgelassen bei einer sportlichen "
    "Betaetigung." );
  AddDetail( "gruppe",
    "Sechs erwachsene Xandim gehoeren dieser kleinen Gruppe an und sie messen "
    "sich gerade im Eisstockschiessen." );
  AddDetail( ({ "erwachsene","erwachsenen" }),
    "Zum Eisstockschiessen haben sich sechs Erwachsene eingefunden. Du bist "
    "Dir nicht sicher, ob Kinder bei dieser Betaetigung erwuenscht sind oder "
    "ob das Eisstockschiessen ihnen nicht interessiert und zu langeweilig "
    "erscheint." );
  AddDetail( ({ "xandimkinder","kinder" }),
    "Es sind keine Kinder in der Naehe des Eisflaeche zu sehen." );
  AddDetail( "naehe",
    "In Deiner und in der Naehe der Eisflaeche sind keine Xandimkinder zu "
    "sehen." );
  AddDetail( ({ "bahn","eisflaeche" }),
    "Die Eisflaeche, die hier ihren Anfang hat, ist zwei Meter breit und "
    "verlaeuft nach Osten. Sie ist spiegelglatt und dient den Xandim als Bahn "
    "fuer ihre Eisstoecke." );
  AddDetail( "eisstoecke",
    "Mehrere Eisstoecke stehen auf dem Anfang der Eisflaeche. Wenn ein Xandim "
    "an der Reihe ist, nimmt er sich einen und schiesst ihn die Eisflaeche "
    "entlang nach Osten." );
  AddDetail( "eisstock",
    "Um mitspielen zu koennen, wirst Du sicher Deinen eigenen Eisstock "
    "brauchen." );
  AddDetail( ({ "anfang","beginn" }),
    "Nicht nur die Eisflaeche hat hier ihren Beginn, sondern auch die "
    "Holzpalisade." );
  AddDetail( ({ "laden","schmuckladen" }),
    "Der Laden oestlich von Dir ist im Stil einer Blockhuette gebaut und eine "
    "Tuer laedt Dich foermlich ein, den Laden zu betreten." );
  AddDetail( "tuer",
    "Die Tuer, die in den Schmuckladen fuehrt, ist auch mit vielen "
    "Schnitzereien verziert. Anscheinend wurden sie erst spaeter "
    "reingeschnitten, da sie uebergangslos auf der Wand weitergefuehrt werden. "
    "Komischerweise siehst Du kein Schluesselloch und zwischen Tuer und Wand "
    "sind auch keine Spalten." );
  AddDetail( "schluesselloch",
    "Sogern Du eines finden wuerdest, die Tuer hat keines." );
  AddDetail( "eisstockschiessen",
    "Die Xandim messen sich gerade im Eisstockschiessen, eine "
    "Freizeitbeschaeftigung die in Yiqanuc sehr beliebt ist. Ganz verstehst "
    "Du die Regeln auf Anhieb nicht, Du weisst nur, dass jeder der Reihe "
    "nach dran ist, man sich einen Eisstock nehmen muss und diesen dann auf "
    "der Eisflaeche nach Osten schiesst." );
  AddDetail( "anhieb",
    "Nur durch blosses Zusehen verstehst Du die Regeln vom Eisstockschiessen "
    "nicht." );
  AddDetail( ({ "betaetigung","freizeitbeschaeftigung" }),
    "Auch die Xandim haben hin und wieder Freizeit, und dann messen sie sich "
    "gern im Eisstockschiessen, wie Du selbst gut sehen kannst." );
  AddDetail( "freizeit",
    "Manchmal haben sie mehr, manchmal weniger. Wird bei Dir nicht viel "
    "anders sein." );
  AddDetail( ({ "regeln","regel" }),
    "Nur durch das Zusehen verstehst Du die Regeln dieses Spiels nicht. Du "
    "weisst nur, dass jeder der Reihe nach dran ist, man sich einen Eisstock "
    "nehmen muss und diesen dan auf der Eisflaeche nach Osten schiesst. Durch "
    "Fragen kann Dir sicher besser geholfen werden." );
  AddDetail( ({ "fragen","frage" }),
    "Fragen sollte man nicht allzu oft untersuchen, sondern besser stellen." );
  AddDetail( "spiel",
    "Eisstockschiessen laesst sich als Spiel bezeichnen, vorallem dann, wenn "
    "man es nicht besser weiss." );
  AddDetail( "zusehen",
    "Vom Zusehen lernt man zwar auch viel, aber bei weitem nicht alles." );
  AddDetail( "reihe",
    "Nachdem Du die Gruppe beobachtet hast, weisst Du, dass jeder abwechselnd "
    "dran. Am besten ist es, wenn Du einen aus der Gruppe fragst, ob er Dir "
    "mehr verraten kann." );
  AddDetail( "osten",
    "Im Osten wurde eine Holzhuette errichtet und hinter dieser verschwindet "
    "die Eisflaeche, die parellel zur Holzpalisade noch um einiges weiter nach "
    "Osten verlaeuft." );
  AddDetail( ({ "holzhuette","huette","blockhuette" }),
    "Diese Holzhuette wurde wie alle andere Huetten auf dem Ostplatz im "
    "typischen Blockhuettenstil gebaut. Sie unterscheidet sich von den "
    "anderen nur insofern, dass es zahlreiche Schnitzereien auf den Waenden "
    "gibt." );
  AddDetail( ({ "holzhuetten","huetten","blockhuetten" }),
    "Auf dem Ostplatz stehen einige Holzhuetten, in denen Laeden untergebracht "
    "sind, wie eben der Schmuckladen in der Holzhuette vor Dir." );
  AddDetail( ({ "schnitzereien","schnitzerei" }),
    "Sie stellen zahlreiche, verschiedene Motive aus der Geschichte der Xandim "
    "dar." );
  AddDetail( ({ "motive","geschichte" }),
    "Ein Motiv stellt eine Walfangszene nach, bei einem anderen sieht man "
    "viele Schlittenhunde ueber eine weite Ebene fahren, wieder ein anderes "
    "zeigt einen Kampf zwischen drei Xandim und einem maechtigen Eisbaeren, "
    "ausserdem faellt Dir noch ein Motiv auf, auf dem ein grosser Palast "
    "abgebildet ist." );
  AddDetail( ({ "kampf","kampfmotiv" }),
    "Drei Xandim befinden sich in einem Kampf mit einem maechtigen Eisbaeren. "
    "Sie tragen ausser ihrem natuerlichen Fell keine Ruestung und kaempfen nur "
    "mit einem Messer." );
  AddDetail( "ruestung",
    "Die Xandim tragen bei weitem nicht soviel Ruestung mit sich herum wie Du." );
  AddDetail( "messer",
    "Die drei Xandim sind allein mit einem Messer zum Kampf gegen einen "
    "Eisbaeren angetreten." );
  AddDetail( "fell",
    "Alle Xandim tragen ein langes, natuerliches Fell." );
  AddDetail( ({ "eisbaer","eisbaeren" }),
    "Der Eisbaer ueberragt die Xandim um mindestens zwei Koepfe und wirkt "
    "nicht besonders freundlich." );
  AddDetail( "koepfe",
    "Es kann schon passieren, dass bei einem Kampf gegen einen Eisbaeren die "
    "Koepfe sprichwoertlich rollen." );
  AddDetail( ({ "palast","palastmotiv" }),
    "Der Palast ist quadratisch, hat einen Innenhof und eine Treppe, die zu "
    "einer grossen Eingangstuer fuehrt." );
  AddDetail( "treppe",
    "Eine breite, weisse Treppe fuehrt zur Eingangstuer des Palastes." );
  AddDetail( ({ "eingangstuer","holzpforten","pforten" }),
    "Die Eingangstuer hat zwei Holzpforten, die fasst doppelt so gross wie die "
    "Xandim sind. Ob in diesem Palast tatsaechlich so eine hochgewachsene "
    "Rasse lebt." );
  AddDetail( "innenhof",
    "Der Innenhof ist wie der Palast auch quadratisch und in ihm wurde ein "
    "Garten angelegt." );
  AddDetail( "garten",
    "Du erkennst nur ein paar niedrige Pflanzen und Baeume." );
  AddDetail( "baeume",
    "Neben den kleineren Pflanzen sind auch ein paar Baeume in dem Garten "
    "gepflanzt worden." );
  AddDetail( ({ "pflanzen","pflanze" }),
    "Straeucher, Buesche und Blumen sind im Garten, doch welche es sind, weisst "
    "Du nicht, denn das Motiv ist nicht so exakt geschnitzt." );
  AddDetail( ({ "straeucher","buesche","blumen" }),
    "Dies alles waechst im Garten des Palastes. Dir kommt der Gedanke, dass der "
    "kaum im Polargebiet liegen kann, denn wie sollte hier etwas wie ein Garten "
    "wachsen?" );
  AddDetail( "polargebiet",
    "Im Polargebiet ist es sehr kalt und es liegt viel Schnee. Nahezu unmoeglich "
    "einen Garten anzulegen." );
  AddDetail( "gedanke",
    "Dir kommt ein Gedanke! Boah! Toll! Gratuliere!" );
  AddDetail( ({ "schlittenhunde","schlittenhund","schlittenhundemotiv" }),
    "Auf dem Ostplatz siehst Du derzeit keinen, dafuer mehrere auf einem "
    "Motiv an der Wand. Zahlreiche Schlittenhunde laufen, einen Hundeschlitten "
    "mit sich ziehend, ueber eine weite Ebene. Sind die Xandim auf der Jagd oder "
    "tragen sie ein Rennen aus?" );
  AddDetail( ({ "hundeschlitten","schlitten" }),
    "Die Hundeschlitten werden von den Schlittenhunden gezogen und von einem "
    "Xandim, der ganz hinten oben steht, gesteuert." );
  AddDetail( "ebene",
    "Die Ebene koennte ueberall sein, denn rund um Yiqanuc ist fast nur weites, "
    "ebenes Land." );
  AddDetail( "land",
    "Das Land um Yiqanuc ist eben." );
  AddDetail( "jagd",
    "Du entdeckst keine Waffen auf dem Motiv. Wahrscheinlich ist es doch ein "
    "Rennen, das dargestellt werden soll." );
  AddDetail( "waffen",
    "Die Xandim haben auf dem Schlittenhundemotiv keine Waffen dabei." );
  AddDetail( "rennen",
    "Es sieht fast so aus, als ob die Xandim ein Rennen bestreiten wuerden. Frag "
    "sie doch einfach danach, vielleicht erzaehlen sie Dir etwas darueber." );
  AddDetail( "walfangszene",
    "Du erkennst zwei kleine Schiffe, auf denen mehrere Xandim mit Harpunen "
    "in der Hand stehen, waehrend knapp vor dem Bug ein Wal gerade auftaucht." );
  AddDetail( ({ "schiffe","schiff" }),
    "Die Schiffe sind schlank gebaut und nur mit zwei Segel besetzt." );
  AddDetail( "segel",
    "Die Schiffe der Xandim haben zwei Segel. Ob Du ein solches Schiff "
    "irgendwann einmal sehen wirst?" );
  AddDetail( ({ "harpune","harpunen" }),
    "Die Xandim versuchen mit Harpunen, den Wal zu toeten." );
  AddDetail( "bug",
    "Vor dem Bug der Schiffe taucht gerade ein Wal auf." );
  AddDetail( "wal",
    "Der Wal hat grosse Ausmasse. Du wunderst Dich, dass die Xandim ihn nur mit "
    "zwei Schiffen jagen. Trotzdem verspuerst Du auch die Lust, auf ein Schiff "
    "zu steigen und den naechsten Wal zu jagen." );
  AddDetail( "ausmasse",
    "Viel groesser als Du." );
  AddDetail( "lust",
    "Du verspuerst Lust, auf ein Schiff zu steigen und einen Wal zu jagen." );
  AddDetail( "motiv",
    "Es gibt mehr als nur ein Motiv. Welches willst Du Dir ansehen?" );
  AddDetail( ({ "blockhuettenstil","stil" }),
    "Den Stil einer Blockhuette erklaere ich Dir jetzt nicht. Entweder Du "
    "weisst wie eine aussieht oder Du laesst es Dir von jemand anderen "
    "erzaehlen." );
  AddDetail( ({ "wand","waende" }),
    "Die Waende der Huette, die im Osten von Dir aufgestellt wurde, sind voller "
    "kunstvoller Schnitzereien. Du wunderst Dich, dass sie Dir auf der "
    "Vorderseite noch nicht aufgefallen sind. Das muss daran gelegen sein, dass "
    "Du vom herrschenden Treiben auf dem Ostplatz abgelenkt warst. Ansonsten "
    "sind die Waende gleich gebaut wie alle Waende einer Blockhuette, es "
    "wurden einfach mehrere Baumstaemme uebereinander gelegt, bis man die "
    "gewuenschte Wandhoehe hatte." );
  AddDetail( ({ "baumstamm","baumstaemme" }),
    "Die Baumstaemme wurden solange uebereinander gelegt, bis die noetige "
    "Wandhoehe erreicht wurde. Du siehst sie Dir sogar genauer an, aber bis "
    "auf die Schnitzereien ist nichts an ihnen zu finden." );
  AddDetail( "treiben",
    "Vom Treiben am dem Ostplatz kriegst Du nicht mehr soviel mit. Du hoerst "
    "zwar noch ein paar Laute aus dem Nordosten, doch bis auf die Gruppe der "
    "sechs Xandim ist es hier doch eher ruhig." );
  AddDetail( "vorderseite",
    "Um diese zu sehen, musst Du schon nach Nordosten gehen." );
  AddDetail( "wandhoehe",
    "Die Wandhoehe dieser Blockhuette betraegt so ziemlich genau "+
    (3.5+random(100)/100.0)+" Meter." );
  AddDetail( ({ "spalten","spalte" }),
    "Zwischen der Tuer und der Wand sind leider keine Spalten, in die Du "
    "eventuell Deine Hand hineinstecken haettest koennen, um so die Tuer "
    "auf zu bekommen. Aber ganz gibst Du die Hoffnung nicht auf, als Du drei "
    "schmale Ritzen auf der linken Seite der Tuer entdeckst." );
  AddDetail( "hand",
    "Deiner Hand geht es heute ganz gut. Keine Gicht und auch sonst keine "
    "Beschwerden." );
  AddDetail( ({ "gicht","beschwerden" }),
    "Dich freut es, dass Du heute keinerlei Beschwerden hast. Das wird sicher "
    "noch ein herrlicher Tag." );
  AddDetail( "tag",
    "Ja, heute ist herrlicher Tag. Sieh Dir doch mal den Himmel an!" );
  AddDetail( "hoffnung",
    "Du hast noch nicht die Hoffnung aufgegeben, durch diese Tuer in den "
    "Schmuckladen zu gelangen." );
  AddDetail( "ritzen",
    "Drei Ritzen sind zwischen der Tuer und der Wand entstanden. Eine davon ist "
    "ein bisschen breiter als die anderen. Wahrscheinlich hat sich die Tuer "
    "verzogen, dass diese Ritzen zurueckgeblieben sind." );
  AddDetail( "ritze",
    "Eine Ritze ist so lang wie Deine Hand doch schmaeler als ein Finger von "
    "Dir. Du siehst nicht durch und mit Deiner Hand wirst da auch niemals "
    "reinkommen, aber ich kenne Deinen Einfallsreichtum nicht, deshalb koennte "
    "es ja auch sein, dass Du irgendwie anders dazu kommst." );
  AddDetail( "einfallsreichtum",
    "Wie einfallsreich Du bist, wirst Du oder Deine Freunde am besten wissen." );
  AddDetail( "freunde",
    "Dein Freundschaftsband wird Dir mehr Auskunft darueber geben koennen." );
  AddDetail( ({ "auskunft","freundschaftsband" }),
    "Willst Du mehr ueber Deine Freunde im Silberland wissen, sieh Dir Dein "
    "Freundschaftsband genauer an." );
  AddDetail( "silberland",
    "Darin bist Du gerade." );
  AddDetail( ({ "linke seite","seite" }),
    "An der linken Seite der Tuer sind drei schmale Ritzen." );
  AddDetail( "eis",
    "Wie ihre Namen schon sagen, bestehen die Eisflaeche und die Eispalisade "
    "aus Eis. Leider keines, von dem man schlecken koennte." );
  AddDetail( ({ "namen","name" }),
    "Um etwas zu benennen, werden Namen vergeben." );
  AddDetail( ({ "eisbloecken","waenden","bloecken","seilen","spiels","platzes",
                "ostplatzes","holzpfaehlen","nerven","klischee","welt",
                "fuessen","eindringlingen","daechern","palastes" }),
    "Das kannst Du nicht untersuchen!" );

  AddSound( DEFAULT_SOUND,
    "" );
  AddSound( "treiben",
    "" );
  AddSound( "laute",
    "" );

  AddSmell( DEFAULT_SMELL,
    "" );
//END DETAILS

  AddExit( "nordosten", ROOM "ostplatz_b2" );
  AddExit( "osten", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : ROOM "schmuckladen_b3",
          EX_MSG      : "unter einem Baumstamm durch in den Schmuckladen" ]) );
  AddExit( "oben", ([
        EX_TESTFUNC : #'exit_test,
        EX_DEST     : ROOM "schmuckladendach",
        EX_MSG      : "ueber einen Baumstamm hinauf auf das Dach" ]) );
  AddExit( "hosten", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : ROOM "ostplatz_b4",
          EX_MSG      : "hinter den Schmuckladen" ]) );   
  SetProp( P_HIDE_EXITS, ({ "osten","oben","hosten" }) );

  AddCmd( ({ "steck","stecke" }), "stecken" );
  AddCmd( ({ "zaehl","zaehle" }), "zaehlen" );
  AddCmd( ({ "schleck","schlecke","leck","lecke" }), "schlecken" );
}

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "So einfach kommst Du nicht dort hin!\n" );
    return 0;
  }
  return 1;
}
//SPECIAL DETAILS
string detailFlutwelle()
{
  say( BS(
    TPN+" bleibt ploetzlich wie gebannt stehen und bewegt sich nicht mehr.") );
  TP -> SetProp( P_PARALYZED,
       ([ PARALYZE_TIME : 30,
           PARALYZE_MSG : "Du stehst total gebannt da und kannst Dich nicht "
                          "bewegen!\n",
     PARALYZE_MSG_OTHER : "%s wirkt wie erstarrt.\n",
           PARALYZE_END : "Uff, jetzt hattest Du aber Glueck, denn das alles "
                          "war nur ein schrecklicher Tagtraum.\n",
     PARALYZE_END_OTHER : "%s erwacht ploetzlich wieder aus der Starre.\n"
       ]) );
  call_out( "tagtraum1", 5 );
  return BS(
    "Oh nein! Was ist denn jetzt los? Du hoerst ploetzlich das Rauschen vom "
    "Meer, das immer lauter und lauter wird." );
}
void tagtraum1()
{
  write( BS(
    "Das darf doch nicht war sein! Von Nordosten her kommt eine gewaltige "
    "Flutwelle auf Dich zu.") );
  call_out( "tagtraum2", 5 );
}
void tagtraum2()
{
  write( BS(
    "Jetzt ist sie direkt ueber Dich und im naechsten Augenblick wirst Du "
    "unter ihr begraben werden und gegen die Eispalisade gespuelt werden.") );
  call_out( "tagtraum3", 5 );
}
void tagtraum3()
{
  TP -> SetProp( P_PARALYZED, 0 );
}
//END SPECIAL DETAILS

