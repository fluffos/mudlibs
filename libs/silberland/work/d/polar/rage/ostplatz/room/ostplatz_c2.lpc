  AddItem( NPC "graufell", REFRESH_DESTRUCT );
  RemoveItem( "/obj/entsorg" );
}

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "Du musst Dir schon eine bestimmte Methode ueberlegen, um dort hin zu "
      "kommen!\n" );
    return 0;
  }
  return 1;
}
//SPECIAL DETAILS
string detailGefahr()
{
  if ( rutschgefahr )
    return BS(
      "Mitten auf dem Weg gibt es schon sehr grosse Stellen mit Eis, wo die "
      "Gefahr des Ausrutschens schon sehr gross ist." );
  return
    "Die Gefahr ist sehr gering, weil die eisigen Stellen noch klein sind.\n";
}

string detailStellen()
{
  if ( rutschgefahr )
  {
    return BS(
      "Manche Stellen wurden schon sooft betreten, dass der Schnee sich "
      "verfestigt hat und irgendwann zu Eis geworden ist. Einige von diesen "
      "Stellen wiederum scheinen gaenzlich von Schnee freigeschaufelt worden "
      "zu sein, dass man sicher gut darauf dahinrutschen kann." );
  }
  return BS(
    "Manche Stellen wurden schon sooft betreten, dass der Schnee sich "
    "verfestigt hat und irgendwann zu Eis geworden ist. Zum Glueck sind die "
    "Stellen noch sehr klein und die Gefahr des Ausrutschens dadurch gering. "
    "Wie das wohl waere, wenn die Stellen groesser werden? Gar nicht "
    "auszudenken, wie leicht man sich da dann das Bein brechen koennte." );
}

string detailHunger()
{
  string text;
  object hunger;

  switch ( hungrig[getuid(TP)] )
  {
    case 1:
      text = "Also, wenn Du es Dir recht ueberlegst, bekommst Du allmaehlich "
             "Hunger bei diesem Geruch.";
    break;
    case 2:
      text = "Irgendwie scheint der Geruch in der Nase staerker geworden zu "
             "sein und Dein Hunger steigt.";
    break;
    case 3:
      text = "Der Geruch von Braten ist schon sehr intensiv. Die "
             "Speichelbildung wird bei Dir schon merklich staerker.";
    break;
    case 4:
      text = "Bald wirst Du verrueckt, wenn dieser Bratengeruch noch laenger "
             "in Deine Nase steigt. Dein Hunger steigt ins Unermaessliche.";
    break;
    default:
      text = "Du drehst durch. Du musst sofort etwas vom dem Braten essen, "
             "sonst verhungerst Du am Ende noch.";
      if ( hunger = present("\nbratenhunger",TP) )
      {
      	text += " Du kannst nur mehr an einen grossen Rentierbraten denken.";
      }
      else
      {
      	if ( (3/4)*TP->QueryProp(P_FOOD) < TP->QueryProp(P_MAX_FOOD) )
      	{
      	  hunger = clone_object(OBJ "bratenhunger");
      	  hunger -> move(TP,M_NOCHECK|M_SILENT);
      	  write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      	    " wird hungrig.\n");
      	}
      }
    break;
  }
  hungrig[getuid(TP)] ++;
  return BS( text );
}
hunger_weg()
{
  hungrig[getuid(TP)] = 1;
}

string detailKoenig()
{
  if ( TP->QueryProp(P_GENDER) == FEMALE )
  {
    return BS(
      "Du bist zwar eine potentielle Kundin, aber noch lange keine Koenigin. "
      "Dazu gehoert schon mehr, als nur ein Detail zu untersuchen." );
  }
  return BS(
    "Du bist zwar ein potentieller Kunde, aber noch lange kein Koenig. Dazu "
    "gehoert schon mehr, als nur ein Detail zu untersuchen." );
}

string detailSprung()
{
  if ( stange_getauscht )
  {
    return BS(
      "Sowas siehst Du da nicht!" );
  }
  return BS(
    "Mitten in der Stange ist bereits ein grosser Sprung drin. Wenn nicht "
    "bald irgendwer etwas dagegen macht, dann bricht die Stange sicher bald "
    "ab." );
}

string detailStangen()
{
  string text;

  text = "Zwei Stangen sind an den Breitseiten der Ladentische befestigt "
         "worden, indem sie durch ein Loch gesteckt wurden und so am Boden "
         "aufliegen. Am oberen Ende ist mit einer staerkeren Schnur die "
         "Querstange festgebunden.";
  if ( !stange_getauscht )
    text += " Eine der beiden Stangen hat einen nicht gerade unbedeutenden "
            "Sprung, was darauf hinweist, dass die Stange nicht mehr lange "
            "halten wird.";
  return BS( text );
}

string detailSchnee()
{
  if ( stein_frei )
  {
    return BS(
      "Dass auf dem ganzen Platz Schnee liegt ist nicht weiter "
      "verwunderlich, in Anbetracht der Tatsache, dass Du Dich im "
      "Polargebiet aufhaeltst. Wohl aber fallen Dir die Spuren im "
      "Schnee neben dem Pfad auf. Sowohl der Boden als auch die "
      "Huetten sind in weiss getaucht." );
  }
  return BS(
    "Dass auf dem ganzen Platz Schnee liegt ist nicht weiter verwunderlich, "
    "in Anbetracht der Tatsache, dass Du Dich im Polargebiet aufhaeltst. "
    "Wohl aber fallen Dir die Spuren im Schnee neben dem Pfad auf. Der "
    "Boden, die Holzhuetten, auch der Stein am Wegesrand sind in weiss "
    "getaucht." );
}

string detailWegesrand()
{
  if ( stein_frei )
  {
    return BS(
      "Direkt neben dem Weg liegt ein Stein im Schnee. Irgendetwas scheint "
