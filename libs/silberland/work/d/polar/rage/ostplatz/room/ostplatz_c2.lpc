string HaendlerLauschen(string key)
{
  switch( random(5) )
  {
    case 0:
      return "Ein Haendler ruft: Treten Sie ein und kaufen sie das neueste "
             "Fell.\n";
    break;
    case 1:
      return "Ein Verkaeufer schreit: Heisse Wuerstchen! Heisse Wuerstchen!\n";
    break;
    case 2:
      return "Ein Haendler ruft: Hereinspaziert! Heute gibt es Ringe im "
             "Sonderangebot!\n";
    break;
    case 3:
      return "Ein Haendler schreit: Dieses Fuchsfell kostet heute "
             "tatsaechlich nur\n"
             "Ein Haendler schreit: 1200 Muenzen!\n";
    case 4:
      return "Ein Verkaeufer bruellt: Rentierkeule! Frisch vom Grill!";
    break;
    default: return 0;
  }
}
