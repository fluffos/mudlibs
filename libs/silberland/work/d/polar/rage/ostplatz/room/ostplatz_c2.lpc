//Laden, der alles moegliche hat, Rage Nov 00
// Laden: nur Verkauf, kein Ankauf !!!
// Filename: ostplatz_c2.c
// File by Rage, Juni 00

inherit "std/laden";

#include "../def.h"
#include <combat.h>
#include <moving.h>
#include <laden.h>
#include <mail.h>

#define TOROOM (["norden":ROOM "ostplatz_c1", "nordwesten":ROOM "ostplatz_b1", \
                 "westen":ROOM "ostplatz_b2", "sueden":ROOM "fellladen_c3", \
                 "osten":ROOM "ostplatz_d2", "suedosten":ROOM "ostplatz_d3", \
                 "nordosten":ROOM "ostplatz_d1"])

string *scherz;                   //1 Scherz gefunden 
string *meldbar;                  //Scherz laesst sich melden
string *gemeldet;                 //Spieler hat Scherz gemeldet
string *paare;                    //moegliche Detailpaare fuer Vergleich
string richtiges_paar;
mapping vergleichstexte;
string *vergleich_gefunden;       //Spieler hat richtiges Detailpaar
string HaendlerLauschen(string key);
string ErwachseneLauschen(string key);
string GravurLesen(string key);
int stein_frei, stange_getauscht;
int rutschgefahr;
int blatt_da;                     //Schaufelblatt ist auffindbar
int glas_eingeschlagen;           //Glas bei Laterne ist eingeschlagen
mapping hungrig;                  //Hungrige Spieler
int resetcounter;
int exit_test();
int geldregen;                    //Spieler kann Geld bekommen

void create()
{
  ::create();

  resetcounter = 0;
  rutschgefahr = 0;
  blatt_da = 1;
  hungrig = ([]);
  hungrig[getuid(TP)] = 1;
  scherz = ({});
  meldbar = ({});
  gemeldet = ({});
  vergleich_gefunden = ({});
  stein_frei = 0;
  stange_getauscht = 0;
  glas_eingeschlagen = 0;
  geldregen = 1;
  paare = ({ "eispalisade:holzpalisade","kurzer pfad:pfad",
             "osten:westen","sonne:wolke","eis:schnee",
             "tor:tuer","seitenwand:vorderfront","matte:schild",
             "erwachsener:kind","verkaeufer:kundin" });
  richtiges_paar = paare[random(sizeof(paare))];
  vergleichstexte =
    ([ "eispalisade:holzpalisade":
       BS("Beim Vergleich der beiden Palisaden stellst Du folgendes fest: die "
       "Eispalisade ist hoeher und stabiler als die Holzpalisade. Erstere "
       "ist aus Eis und Schnee und letztere aus Fichtenholz. Dir faellt auch "
       "auf, dass die Eispalisade Yiqanuc und die Holzpalisade den "
       "Ostplatz umgibt."),
       "kurzer pfad:pfad":
       BS("Du vergleichst die beiden Pfade und bemerkst, dass der Hauptpfad "
       "um einiges breiter ist, bei weitem mehr begangen wird und "
       "dementsprechend fest im Schnee ausgetreten wurde. Erst jetzt "
       "faellt Dir eine kleine Erhebung an der Kreuzung der beiden Wege "
       "auf."),
       "osten:westen":
       BS("Durch den Vergleich der beiden Himmelsrichtungen Osten und Westen "
       "stellst Du wenig ueberraschend fest, dass es zwei "
       "entgegengesetzte sind."),
       "sonne:wolke":
       BS("Ich weiss nicht, welche sensationellen Entdeckungen Du Dir "
       "erwartet hast, wenn Du die Sonne mit den Wolken vergleichen "
       "wolltest, zumal Du keine Wolken siehst. Ueberleg Dir beim "
       "naechsten Mal besser, was Du vergleichen willst."),
       "eis:schnee":
       BS("Du findest keine grossen Unterschiede zwischen dem Eis und dem "
       "Schnee, ausser dass das Eis fester und glatter ist und man "
       "darauf leichter ausrutschen kann als auf Schnee."),
       "tor:tuer":
       BS("Zwischen den beiden Toren und der Tuer zum Laden stellst Du "
       "folgenden Vergleich an: die beiden Tore sind um einiges hoeher "
       "und breiter und sicher auch schwieriger zu oeffnen als die Tuer."),
       "seitenwand:vorderfront":
       BS("Die Seitenwaende und die Vorderfront des Ladens sehen sich sehr "
       "aehnlich. Beide bestehen aus gleich vielen Baumstammreihen und keine "
       "der Waende weist ein Fenster auf. Ein paar vereinzelte Kratzer "
       "entdeckst Du noch links von der Tür, aber das war es dann auch "
       "schon."),
       "matte:schild":
       BS("Als Du die Matte mit dem Schild vergleichst, merkst Du, dass beide "
       "etwa gleich gross sind und dass auf beidem etwas geschrieben steht."),
       "erwachsener:kind":
       BS("Waehrend die Erwachsenen nicht nur groesser als die Kinder sind "
       "und deshalb auch ein dunkleres, laengeres Fell als sie haben, "
       "spazieren sie gemuetlich an den Laeden vorbei, um vielleicht was zu "
       "kaufen oder zu tauschen, und die Kinder tummeln sich dafuer noerdlich "
       "von Dir und sind alle sehr gut gelaunt."),
       "verkaeufer:kundin":
       BS("Normalerweise verkauft der Verkaeufer dem Kunden etwas bzw. der "
       "Kunde kauft dem Verkaeufer was ab. Auch am Ostplatz von Yiqanuc "
       "ist dies nicht anders als anderorts."),
     ]);

  SetStorageRoom( ROOM "mischlager" );
  SetBuyFact( 5 );

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Ein im Schnee ausgetretener Pfad fuehrt von der Eispalisade im Westen "
    "zu der Holzpalisade im Osten. Suedlich von Dir sind einige Holzhuetten "
    "und Ladentische, wo Haendler ihre Waren anbieten, waehrend genau "
    "noerdlich von Dir ein Holzgeruest aufgestellt wurde, auf dem Kinder "
    "herumtollen. Xandim gehen an Dir vorbei und bleiben vor den Laeden "
    "stehen, und Kinder laufen an Dir vorueber und spielen Fangen. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -4]) );

  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp( P_SHOPKEEPER_ID, "graufell" );
  SetProp( P_SHOPKEEPER_NAME, "Graufell" );
  SetProp( P_SHOPKEEPER_GENDER, MALE );

//DETAILS
  AddDetail( "fangen",
    "Die Kinder sind halt sehr verspielt und spielen deshalb fangen. Pass "
    "nur, dass sie nicht Dich erwischen." );
  AddDetail( ({ "platz","ostplatz" }),
    "Der gesamte Ostplatz dient als Treffpunkt, wohin man sich nach einer "
    "arbeitsreichen Zeit zurueckziehen kann. Kinder spielen vergnuegt, "
    "Erwachsene kaufen etwas ein und Schlittenhunde laufen staendig frei "
    "herum." );
  AddDetail( ({ "schlittenhund","schlittenhunde","hunde","hund" }),
    "Die Schlittenhunde laufen frei am Platz herum. Dir faellt allerdings "
    "auf, dass sie den Pfad kaum betreten, sondern sich immer im tieferen "
    "Schnee aufhalten. Ob sie speziell trainiert worden sind oder gefaellt "
    "ihnen der Schnee einfach besser?" );
  AddDetail( ({ "erwachsene","erwachsener","erwachsenen" }),
    "Die Erwachsenen schlendern gemuetlich an Dir vorbei, sehen sich bei den "
    "Laeden um, manche treten in einen ein, andere wiederum unterhalten sich "
    "miteinander. Und auch wenn sie ihre Kinder allein auf den Platz "
    "herumlaufen lassen, hat man das Gefuehl, dass sie doch stets ein Auge "
    "auf ihre Kinder geworfen haben." );
  AddDetail( "gefuehl",
    "Du hast das Gefuehl, dass man Gefuehle nicht so einfach sehen kann." );
  AddDetail( "gefuehle",
    "Auch die Gefuehle lassen sich genauso schwer untersuchen wie ein "
    "einzelnes Gefuehl." );
  AddDetail( ({ "auge","augen" }),
    "Deine eigenen siehst Du schwer, doch wenn Du in die Augen der Xandim "
    "blickst, meinst Du, dass sie ein Auge stets auf ihre Kinder geworfen "
    "haben." );
  AddDetail( "treffpunkt",
    "Die Xandim treffen sich auf diesem Platz, um sich mit ihrer Familie von "
    "einer harten Arbeit zu erholen." );
  AddDetail( ({ "familie","familien","gruppe" }),
    "Nicht immer sind die Kinder getrennt von deren Eltern unterwegs, sondern "
    "Du siehst ab und zu sogar eine groessere Gruppe vorbeigehen, von "
    "Kleinkinder, ueber Kinder, Eltern und Grosseltern. Die Xandim sind mit "
    "ihrer Familie sicher stark verbunden." );
  AddDetail( "eltern",
    "Die Eltern passen sicher gut auf ihre Kinder auf." );
  AddDetail( "grosseltern",
    "Die kannst Du nur deshalb von den anderen auseinanderhalten, weil ihr "
    "Fell schon grau wird, waehrend das Fell der anderen eine hellbraune Farbe "
    "hat." );
  AddDetail( ({ "farbe","fell" }),
    "Die Xandim haben ein natuerliches, wuscheliges, hellbraunes Fell." );
  AddDetail( ({ "kleinkinder","kleinkind" }),
    "Im Moment siehst Du nur zwei, die in einem Rucksack auf den Schultern von "
    "Erwachsenen wieder zurueck in Richtung Yiqanuc getragen werden. Ihnen "
    "scheint die Kaelte auch ueberhaupt nichts auszumachen." );
  AddDetail( "kaelte",
    "Im ganzen Polargebiet ist es kalt. Nur wenige koennen bei dieser Kaelte "
    "ueberleben." );
  AddDetail( ({ "richtung","richtungen","himmelsrichtung",
                "himmelsrichtungen" }),
    "In Richtung Westen liegt die Eispalisade, in Richtung Sueden ein Laden, "
    "in Richtung Norden ein Holzgeruest und in Richtung Osten die "
    "Holzpalisade." );
  AddDetail( "norden",
    "In diese Richtung weitet sich der Platz aus und ein Holzgeruest steht "
    "da, auf dem sich viele Kinder tummeln." );
  AddDetail( "yiqanuc",
    "So heisst das Dorf der Xandim, das hinter der Eispalisade im Westen "
    "liegt." );
  AddDetail( "dorf",
    "Das Dorf der Xandim nennt sich Yiqanuc, aber das solltest Du "
    "mittlerweile doch schon wissen." );
  AddDetail( "moment",
    "Genau jetzt!" );
  AddDetail( "rucksack",
    "Zwei Erwachsene haben einen Rucksack auf ihren Schultern, in den sie "
    "ihre Kleinkinder hineingesetzt haben." );
  AddDetail( ({ "schulter","schultern" }),
    "Die Schultern der Xandim sind breit und fellbedeckt, wie auch ihr "
    "gesamter Koerper." );
  AddDetail( "koerper",
    "Der Koerper der Xandim ist fellbedeckt. Man darf sich von diesem "
    "Erscheinungsbild nicht taeuschen lassen, denn die Xandim sind sehr "
    "stark, nicht zuletzt deshalb, weil sie gelernt haben, in einer so "
    "rauhen Umgebung wie im Polargebiet zu ueberleben." );
  AddDetail( "umgebung",
    "Die naehere Umgebung, in der Du Dich gerade aufhaeltst, ist der "
    "Ostplatz. Gesamt betrachtet bist Du im Polargebiet." );
  AddDetail( ({ "polargebiet","polar","region" }),
    "Das Polargebiet zeichnet sich dadurch aus, dass es viel Schnee gibt, "
    "sehr kalt ist und das Wetter stets unberechenbar ist." );
  AddDetail( "erscheinungsbild",
    "Jedes Wesen hat ein gewisses Erscheinungsbild, nur sollte man sich davon "
    "nie taeuschen lassen." );
  AddDetail( "wesen",
    "Derzeit siehst Du Xandim und Schlittenhunde." );
  AddDetail( "arbeit",
    "Die Xandim haben immer genug harte Arbeit, da es in einer eisigen Region "
    "wie Polar nicht gerade leicht ist, sich Nahrung zu besorgen." );
  AddDetail( "nahrung",
    "Wenn Du an Nahrung denkst, kriegst Du Hunger. Sehen tust Du keine, "
    "dafuer steigt Dir ein Essensgeruch in die Nase. Die Xandim koennen Dir "
    "sicher etwas ueber ihre Nahrungsmittelbeschaffung erzaehlen." );
  AddSpecialDetail( "hunger", "detailHunger" );
  AddDetail( "nase",
    "Indem Du mit den Augen schielst, kannst Du sie sogar sehen." );
  AddDetail( "zeit",
    "Die Zeit im Polargebiet vergeht gleich schnell wie ueberall, auch wenn "
    "sie hier zeitweise still zu stehen scheint." );
  AddDetail( "boden",
    "Es fuehrt ein im Schnee ausgetretener Pfad genau von Westen nach Osten "
    "oder umgekehrt, je nach Betrachtungsweise. Zur Holzhuette im Sueden "
    "zweigt ein kurzer Pfad ab, der genau bis zu einer Tuer fuehrt, in deren "
    "Schwelle eine Fussmatte hingelegt wurde. Neben dem Pfad liegt eine "
    "frische Neuschneeschicht." );
  AddDetail( ({ "tuerschwelle","schwelle" }),
    "In der Tuerschwelle vom Laden wurde eine grosse Fussmatte "
    "ausgebreitet." );
  AddDetail( ({ "matte","fussmatte" }),
    "Die Fussmatte in der Tuerschwelle vom Laden wurde wohl deshalb "
    "hingelegt, damit man beim Betreten des Ladens seine Schuhe vorher darauf "
    "abstreifen kann." );
  AddReadDetail( ({ "matte","fussmatte" }),
    "Du musst den Laden schon betreten, um zu sehen, was auf der Fussmatte "
    "geschrieben steht." );
  AddDetail( "schuhe",
    "Ob Du welche hast oder nicht, weisst Du selbst am besten - nehme ich "
    "einmal an." );
  AddDetail( "betreten",
    "Gehe in den Laden oder nicht. Das bleibt ganz allein Dir ueberlassen." );
  AddDetail( "tuer",
    "Die Tuer zu dem Laden suedlich von Dir steht nach innen offen. Du kannst "
    "jederzeit den Laden betreten, wenn Du willst." );
  AddDetail( ({ "neuschneeschicht","schneeschicht" }),
    "Dort, wo der Schnee nicht als Pfad niedergetreten wurde, liegt noch "
    "immer eine frische Neuschneeschicht. Es kann sich kaum einer darueber "
    "beschweren, dass es hier einmal zuwenig Schnee geben koennte." );
  AddDetail( ({ "kurzer pfad","kurzer weg","kurzen pfad","kurzen weg" }),
    "Dieser Pfad zweigt vom Hauptpfad ab und endet genau vor der Tuer. "
    "Direkt daneben, ganz knapp neben der Vorderfront der Huette fuehrt eine "
    "Spur im Schnee vorbei, die anders aussieht als die, die Du bisher auf "
    "dem Ostplatz gesehen hast." );
  AddDetail( "vorderfront",
    "Die Vorderfront der Huette ist nicht sonderlich aufregend. Sie besteht "
    "aus mehreren Baumstammreihen, hat fast genau in der Mitte eine Tuer, "
    "ueber der ein Schild angebracht wurde, und seltsamerweise keine "
    "Fenster." );
  AddDetail( "fenster",
    "Du kannst noch solange zu der Vorderfront hinsehen und es tauchen "
    "trotzdem keine Fenster auf." );
  AddDetail( "mitte",
    "Die Tuer ist fast genau in der Mitte der Vorderfront." );
  AddDetail( "schild",
    "Das Schild wurde ueber der Tuer montiert und enthaelt eine Aufschrift." );
  AddDetail( "aufschrift",
    "Schon manch einer meinte, dass man eine Aufschrift lesen kann." );
  AddReadDetail( ({ "aufschrift","schild" }), 
    "          +---------------------------+\n"
    "          |       Schwarzfells        |\n"
    "          |         FELLADEN          |\n"
    "          |                           |\n"
    "          | Felle aus der ganzen Welt |\n"
    "          +---------------------------+\n" );
  AddDetail( "baumstammreihen",
    "Da die Holzhuette eine Blockhuette ist, besteht die Vorderfront aus "
    "mehreren Baumstammreihen. So zehn in etwa werden es sicher sein." );
  AddDetail( ({ "spuren","wieselspuren","spur","wieselspur" }),
    "Die Spur fuehrt direkt neben der Vorderfront der Huette vorbei und "
    "erinnert Dich an die eines Wiesels. Wie kommt ein Wiesel in das "
    "Polargebiet? Irgendwie waere es doch interessant zu erfahren, woher es "
    "gekommen bzw. wohin es gegangen ist." );
  AddDetail( "wiesel",
    "Nein, Wiesel siehst Du keines. Du meinst nur, die Spur eines erkannt zu "
    "haben." );
  AddDetail( "westen",
    "Im Westen ragt die gewaltige Eispalisade aus dem Boden heraus und "
    "versperrt Dir die Sicht auf das Dorf. Durch das Tor darin kannst Du nur "
    "vereinzelte Gestalten erahnen. Ein Pfad fuehrt vom Tor bis zu Dir." );
  AddDetail( ({ "gestalten","gestalt" }),
    "Um welche Gestalten es sich handelt, die Du durch das Tor im Westen "
    "sehen kannst, laesst sich nur erahnen. Aber es erscheint Dir als sehr "
    "wahrscheinlich, dass es Xandim sind." );
  AddDetail( ({ "tor","tore" }),
    "Wenn Du Dich nach Westen drehst, siehst Du ein grosses Tor in der "
    "Eispalisade, drehst Du Dich hingegen nach Osten, erkennst Du ein fast "
    "genauso grosses Tor in der Holzpalisade. Um mehr daran zu erkennen, "
    "musst Du allerdings schon naeher hingehen." );
  AddDetail( "osten",
    "Der Pfad im Schnee fuehrt schnurgerade bis zu einem verschlossenen Tor "
    "in der Holzpalisade. Auch in diese Richtung siehst Du noch immer "
    "zahlreiche Kinder, aber auch ein paar Erwachsene." );
  AddDetail( "betrachtungsweise",
    "Es bleibt Dir ueberlassen, ob der Weg fuer Dich von Westen nach Osten "
    "oder von Osten nach Westen fuehrt." );
  AddDetail( "sueden",
    "Ein kurzer Weg fuehrt nach Sueden und endet genau vor der Tuer des "
    "Ladens. Du hebt Deinen Blick und siehst nun die komplette Vorderfront "
    "der Holzhuette." );
  AddDetail( "blick",
    "Du kannst Deinen Blick zwar heben, aber nicht untersuchen, also lass es "
    "besser lieber." );
  AddDetail( ({ "laden","huette","blockhuette","holzhuette" }),
    "Am Ende eines kurzen Weges in Richtung Sueden wurde eine Holzhuette "
    "gebaut, die einem Haendler als Laden dient. Das erkennst Du daran, dass "
    "ueber der Tuer, an der Vorderfront der Huette, ein Schild mit einer "
    "Aufschrift montiert wurde." );
  AddDetail( "ende",
    "Dein Ende ist noch nicht gekommen, sondern nur das Ende des kurzen "
    "Weges, an dem eine Holzhuette errichtet wurde." );
  AddDetail( "laeden",
    "Laeden gibt es entlang des Pfades mehrere. Einige sind schlichte "
    "Ladentische, die ueber Nacht abgebaut werden, andere wiederum sind "
    "groessere Holzhuetten. Ueberall werden verschiedenste Waren angeboten." );
  AddDetail( "nacht",
    "Die kannst Du nicht sehen, weil es Tag ist." );
  AddSpecialDetail( "schnee", "detailSchnee" );
  AddSpecialDetail( ({ "rand","wegesrand" }), "detailWegesrand" );
  AddSpecialDetail( "stein", "detailStein" );
  AddSpecialDetail( "haelfte", "detailHaelfte" );
  AddSpecialDetail( "gravur", "detailGravur" );
  AddReadDetail( "gravur", #'GravurLesen );
  AddDetail( ({ "pfad","weg","hauptpfad" }),
    "Der Pfad fuehrt vom Tor in der Eispalisade zum Tor in der Holzpalisade "
    "und ist etwa so breit wie ein Oger gross ist. Er wurde im Schnee "
    "ausgetreten und ist an manchen Stellen so hart, sodass man aufpassen "
    "muss, nicht auf irgendwelchen Eisplatten auszurutschen." );
  AddSpecialDetail( ({ "stellen","eisplatten" }), "detailStellen" );
  AddSpecialDetail( ({ "ausrutschen","gefahr" }), "detailGefahr" );
  AddDetail( "glueck",
    "Dein Glueck ist, dass die Eisplatten klein sind und Du nicht darauf "
    "ausgerutscht bist." );
  AddDetail( "oger",
    "Der Oger diente nur als Vergleich, um die Breite des Pfades in einer Dir "
    "bekannten Groesseneinheit zu verdeutlichen." );
  AddDetail( "vergleich",
    "Die Breite des Pfades wurde mit der Groesse eines Oger verglichen. Ich "
    "nehme an, dass Du diesen Vergleich verstehen kannst." );
  AddDetail( "vergleiche",
    "Vergleiche kannst Du sicher ueberall finden, Du brauchst Dich dazu nur "
    "genau umzusehen." );
  AddDetail( ({ "breite","pfadbreite" }),
    "Die Breite das Pfades entspricht der Groesse eines Oger." );
  AddDetail( ({ "groesse","ogergroesse" }),
    "Die Groesse eines Oger entspricht der Breite des Pfades." );
  AddDetail( ({ "groesseneinheit","einheit","groesseneinheiten","einheiten" }),
    "Es gibt unterschiedliche Groesseneinheiten und Vergleiche. Du kannst "
    "auch gern eigene Vergleiche anstellen, wenn Dir das lieber ist." );
  AddDetail( "eispalisade",
    "Viel faellt Dir an dieser Palisade nicht auf, ausser dass sie "
    "vollstaendig aus Schnee und Eis zu bestehen scheint. Ein Tor darin steht "
    "weit offen und am oberen Abschluss des Palisade zeichnet sich eine "
    "Silhouette gegen den blauen Himmel ab oder war das nur eine "
    "Sinnestaeuschung?" );
  AddDetail( "abschluss",
    "Am oberen Abschluss der Eispalisade meinst Du, eine Silhouette gesehen "
    "zu haben." );
  AddDetail( "silhouette",
    "Du koenntest wetten, dass sich am oberen Abschluss der Eispalisade eine "
    "Silhouette gegen den Himmel abgezeichnet hat." );
  AddDetail( "sinnestaeuschung",
    "Taeuschten Dich Deine Sinne oder hast Du auf der Eispalisade "
    "tatsaechlich eine Silhouette gesehen?" );
  AddDetail( "sinne",
    "Meist konntest Du ihnen trauen, doch haben sie Dich dieses Mal "
    "nicht vielleicht getaeuscht?" );
  AddDetail( "mal",
    "Was soll ich dazu schon sagen? Dieses Mal eben!" );
  AddDetail( "eis",
    "Die gesamte Eispalisade wurde aus Schnee und Eis errichtet, aber auch "
    "der Pfad weist hin und wieder Stellen von Eis auf." );
  AddDetail( "holzpalisade",
    "Da Du mitten auf dem Ostplatz stehst, kannst Du keine Details der "
    "Palisade erkennen. Eines ist jedoch sicher: sie umschliesst den "
    "ganzen Platz und oestlich von Dir erblickst Du ein Tor." );
  AddDetail( "details",
    "Details gibt es mehr als genug, da musst Du schon um einiges praeziser "
    "werden." );
  AddDetail( ({ "palisaden","palisade" }),
    "Welche der beiden Palisaden willst Du Dir genauer ansehen? Die Holz- "
    "oder die Eispalisade?" );
  AddDetail( ({ "holzhuetten","huetten","blockhuetten" }),
    "Die Holzhuetten, die suedlich von Dir aufgestellt bzw gebaut wurden, "
    "sind schlichte Blockhuetten, in denen Haendler ihre Waren feil bieten. "
    "Sie haben eine quadratische Grundflaeche, werden von vier Holzwaenden "
    "umgeben, haben ein Flachdach und keine Fenster. Wenn Du schon immer "
    "wissen wolltest, wie Blockhuetten aussehen, dann weisst Du es ab "
    "heute." );
  AddDetail( ({ "flachdach","dach","flachdaecher","daecher" }),
    "Was soll ich viel dazu sagen? Die Daecher der Blockhuetten sind flach, "
    "aber wenn Du es genau wissen willst, dann ist es natuerlich leicht "
    "wellig, da das Dach aus nebeneinander gereihten Baumstaemmen besteht." );
  AddDetail( "baumstaemme",
    "Baumstaemme bilden sowohl die Waende als auch die Daecher der "
    "Blockhuetten. Die Baumstaemme auf den Daechern stehen ein wenig drueber, "
    "sodass man so einen kleinen Unterstand gegen Schneefaelle hat." );
  AddDetail( "baumstamm",
    "Es faellt Dir bei all den Baumstaemmen keiner besonders auf, ausser jener "
    "vielleicht, wo eine Laterne neben der Tuer aufgehaengt wurde." );
  AddDetail( "unterstand",
    "Dadurch, dass einige Baumstaemme vom Dach ueber die Waende hinausragen, "
    "entsteht ein kleiner Unterstand. Wie Du Dir den von dem Laden vor Dir "
    "genauer ansiehst, faellt Dir auf, dass genau an der Ecke, rechts von "
    "der Tuere, eine kleine Laterne aufgehaengt wurde. Bei starkem "
    "Schneefall ist es sicher praktisch, wenn man sich hier unterstellen "
    "kann." );
  AddDetail( "ecke",
    "An der Ecke, rechts von der Tuer vom Laden vor Deinen Augen, unter dem "
    "Dach, wurde eine Laterne auf einem Nagel aufgehaengt." );
  AddDetail( "nagel",
    "Der Nagel ist wie jeder andere. Ein bisschen rostig und irgendwo hinein "
    "geschlagen worden. Um genau zu sein, wurde er in einen Baumstamm "
    "geschlagen und eine Laterne auf ihn aufgehaengt." );
  AddDetail( "laterne",
    "Jetzt weisst Du, wieso Dir die Laterne nicht frueher aufgefallen ist. "
    "Sie leuchtet nicht mehr und deshalb ist sie ganz unscheinbar. Sie hat "
    "ein Metallgehaeuse und auf allen Seiten gelbfarbene Glaeser, die, wenn "
    "ein Sonnenstrahl drauffaellt, fuer eine ganz kurze Zeit leuchten." );
  AddDetail( "seiten",
    "Die Laterne hat an allen Seiten gelbfarbene Glaeser." );
  AddDetail( ({ "sonnenstrahl","sonnenstrahlen","strahl","strahlen" }),
    "Es faellt nur ganz selten ein Sonnenstrahl auf die Laterne, da sie ja "
    "unter dem Dach aufgehaengt wurde." );
  AddDetail( ({ "metallgehaeuse","gehaeuse" }),
    "Zu dem Metallgehaeuse der Laterne koennte man auch Fassung sagen, denn "
    "es dient dazu, die zahlreichen Glaeser einfassen zu koennen und die "
    "Laterne irgendwo aufhaengen zu koennen." );
  AddDetail( "fassung",
    "So kann man auch zu dem Metallgehaeuse der Laterne sagen." );
  AddDetail( ({ "glas","glaeser" }),
    "Die Glaeser sorgen dafuer, dass das Licht der Laterne nach aussen "
    "dringen kann und dass es nicht bei einer Windboe gleich ausgeht. Sie "
    "sind gelb und verhindern die Sicht ins Innere." );
  AddDetail( ({ "innere","inneres" }),
    "Ins Innere der Laterne kannst Du nicht sehen." );
  AddDetail( ({ "windboe","boe" }),
    "Es ist fast komplett windstill. Die Laterne muss schon laenger "
    "ausgegangen sein." );
  AddDetail( "licht",
    "Es ist zwar Licht, aber das hast Du nicht der Laterne, sondern der "
    "Sonne zu verdanken." );
  AddDetail( "sicht",
    "Die Sicht auf das Innere der Laterne wird Dir wegen der Glaeser "
    "genommen." );
  AddDetail( ({ "schneefall","schneefaelle" }),
    "Es ist sehr stark anzunehmen, dass es im Polargebiet haeufig schneit. "
    "Da kommt einem so ein Unterstand doch sehr gelegen." );
  AddDetail( ({ "grundflaeche","flaeche" }),
    "Nachdem Du kurz die Vorderfront einer Huette abwanderst und Dir die "
    "Seitenwaende dabei ansieht, kommst Du zu dem Schluss, dass die "
    "Grundflaeche der Blockhuetten quadratisch sein muss." );
  AddDetail( "schluss",
    "Fuer Dich ist noch lange nicht Schluss. Du kommst nur zu dem Schluss, "
    "dass die Grundflaeche der Holzhuetten quadratisch ist." );
  AddDetail( ({ "seitenwaende","seitenwand" }),
    "Die Seitenwaende der Huetten sind gleich lang wie die Vorderfront und "
    "sehen auch gleich aus." );
  AddDetail( ({ "waende","holzwaende","wand","holzwand" }),
    "Die Huetten sind quadratisch gebaut und haben deshalb vier Waende. Jede "
    "Wand besteht aus mehreren Baumstammreihen." );
  AddDetail( ({ "ladentisch","ladentische" }),
    "Manche Haendler haben sich nur einen Ladentisch als Verkaufsflaeche "
    "aufgestellt, der abends dann wieder abgebaut und weggetragen wird. An "
    "die Breitseiten wurde jeweils eine Stange gesteckt, die einen Meter "
    "ueber der Tischflaeche mit einer Querstange verbunden sind, auf der "
    "noch weitere Waren aufgehaengt wurden." );
  AddDetail( ({ "breitseiten","breitseite"}),
    "In den Breitseiten der Ladentische wurden durch Loecher Stangen "
    "gesteckt." );
  AddDetail( ({ "loecher","loch" }),
    "Jede Breitseite eines Ladentisches weist ein Loch auf, durch das eine "
    "Stange gesteckt wurde." );
  AddDetail( "meter",
    "Muss ich Dir jedes Mal Meter erklaeren? Das wird doch langweilig, aber "
    "ich will nicht so sein. Die Querstange ist einen Meter ueber der "
    "Tischflaeche." );
  AddDetail( "querstange",
    "Eine Querstange wurde an ihren Enden mit den beiden Stangen am "
    "Ladentisch mit einigen Schnueren verbunden, damit man darauf noch "
    "zusaetzlich einige Waren unterbringen kann." );
  AddDetail( ({ "enden","querstangenenden" }),
    "Die Enden der Querstange sind genauso wenig besonders wie die "
    "Querstange selbst, nur mit dem Unterschied, dass an den Enden die "
    "Schnuere gewickelt wurden." );
  AddDetail( ({ "unterschied","unterschiede" }),
    "Obwohl Du Dir die Stange jetzt sehr oft angesehen hast, findest Du "
    "trotzdem keine weiteren Unterschiede. Nicht hinter jedem Detail ist "
    "ein Forscherpunkt versteckt." );
  AddDetail( "detail",
    "Hinter diesem Detail ist kein Forscherpunkt!" );
  AddDetail( "forscherpunkt",
    "Der Forscherpunkt taucht auch trotz Untersuchens nicht auf." ); 
  AddDetail( ({ "schnur","schnuere" }),
    "Um die Enden der Stangen und der Querstange wurden starke Schnuere "
    "derart gewickelt, sodass gewaehrleistet ist, dass die Querstange nicht "
    "runterfallen kann." );
  AddSpecialDetail( "stangen", "detailStangen" );
  AddSpecialDetail( ({ "stange","sprung" }), "detailSprung" );
  AddDetail( "tischflaeche",
    "Die Tischflaeche dient den Haendlern als Verkaufsflaeche." );
  AddDetail( "verkaufsflaeche",
    "Ein Ladentisch reicht einigen Haendlern als Verkaufsflaeche vollkommen "
