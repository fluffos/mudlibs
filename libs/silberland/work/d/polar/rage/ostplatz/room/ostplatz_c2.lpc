  AddDetail( ({ "wolken","wolke" }),
    "Du kannst keine Wolken sehen. Endlich mal ein schoenes Wetter." );
  AddDetail( "wetter",
    "Das Wetter gefaellt Dir ganz gut." );
  AddDetail( "preis",
