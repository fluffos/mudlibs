  AddSound( "haendler", #'HaendlerLauschen );
  AddSound( ({ "erwachsene","erwachsenem","erwachsenen" }),
    #'ErwachseneLauschen );
    
  AddSmell( DEFAULT_SMELL,
    "Die Winterluft ist so klar wie ueberall auf dem Ostplatz, doch der "
