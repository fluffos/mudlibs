  }	
}

string detailErhebung()
{
  if ( member(vergleich_gefunden, getuid(TP)) != -1 )
  {
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " entdeckt Erhebung.\n");
    return BS(
      "Du schaust Dir die Erhebung genauer an, merkst aber gleich, dass "
      "einfach nur Schnee angeweht wurde, der sich hier gesammelt hat. Es "
      "war aber trotzdem eine gute Leistung von Dir, dass Du das gefunden "
      "hast!" );
  }
  return BS(
    "Du siehst Dich ein wenig um, aber Du findest keine Erhebung an, die "
    "Dir irgendwie auffallen wuerde." );
}

string detailKratzer()
{
  if ( member(vergleich_gefunden, getuid(TP)) != -1 )
  {
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " entdeckt Kratzer.\n");
    return BS(
      "Dort wo die Vorderfront auf die Seitenwand trifft, siehst Du mehrere "
      "Kratzer von unten nach oben verlaufen, als ob irgendein Tier nach "
      "oben geklettert waere." );
  }
  return
    "Sowas siehst Du da nicht!\n";
}

string detailTier()
{
  if ( member(vergleich_gefunden, getuid(TP)) != -1 )
  {
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " entdeckt Tier.\n");
    return BS(
      "Du kannst anhand der Kratzer nicht erkennen, durch welches Tier diese "
      "hinterlassen wurde, aber Hund war es bestimmt keiner, sondern um "
      "vieles kleiner." );
  }
  return BS(
    "Die Tiere, die Dir am Ostplatz staendig auffallen, sind natuerlich die "
    "Schlittenhunde, die ueberall zu sein scheinen." );
}

string detailScherz()
{
  if ( member (scherz, getuid(TP)) == -1 )
    scherz += ({ getuid(TP) });
  return BS(
    "Ueber den Tod scherzt man nicht und solche Scherze findest Du einfach "
    "geschmacklos. Wenn Du noch so einen ueblen Scherz findest, dann "
    "meldest Du das einem Magier." );
}
//END SPECIAL DETAILS

//COMMANDS
int cmd_streifen(string str)
{
  int i, schuhwerk_getragen;
  string was, dummy, worauf;
  object *schuhwerk;

  schuhwerk = TP->QueryProp(P_ARMOURS);
  for ( i=sizeof(schuhwerk); i-->0; )
  {
    if ( schuhwerk[i]->QueryProp(P_ARMOUR_TYPE) == AT_BOOT )
    {
      schuhwerk_getragen = 1;
      break;
    }
  }

  notify_fail( "Was willst Du wo abstreifen?\n" );

  if ( !str ) return 0;
  if ( sscanf(str, "%s %s %s ab", was, dummy, worauf) != 3 ) return 0;
  if ( member( ({ "auf","an" }),dummy) == -1 ) return 0;
  if ( member( ({ "fuesse" }),was) != -1 )
  {
    if ( member( ({ "matte","fussmatte" }), worauf) != -1 )
    {
      if ( schuhwerk_getragen )
      {
        write( BS(
          "Du hast doch "+schuhwerk[i]->name(WER)+" an. Das musst Du schon "
          "ausziehen, um die Fuesse abstreifen zu koennen.") );
        return -1;
      }
      write( BS(
        "Da Du gut erzogen worden bist, streifst Du Dir zuerst die Fuesse "
        "auf der Matte ab und betrittst erst dann den Laden.") );
      say(
        TPN+" streift sich "+TP->QueryPossPronoun(MALE,WEN,PLURAL)+" Fuesse "
        "ab und betritt den Laden.\n" );
      if ( "/d/polar/rage/ostplatz/room/fellladen_c3"->Getdreck() < 4 )
        "/d/polar/rage/ostplatz/room/fellladen_c3" -> schriftzug();
      "/d/polar/rage/ostplatz/room/fellladen_c3" -> Dreckiger();
      TP -> move(ROOM "fellladen_c3", M_GO|M_SILENT);
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " streift die Fuesse draussen ab.\n");
      return 1;
    }
    notify_fail( "Worauf willst Du Deine Fuesse abstreifen?\n" );
  }

  if ( member( ({ "stiefel","schuhe","sandalen" }),was) != -1 )
  {
    if ( member( ({ "matte","fussmatte" }), worauf) != -1 )
    {
      if ( !schuhwerk_getragen )
      {
        write(
  	  "Du bist doch barfuss! Du kannst Dir nur Deine Fuesse "
  	  "abstreifen.\n" );
        return -1;
      }
      write( BS(
        "Deine Eltern haben Dich gut erzogen, denn bevor Du den Laden "
        "betrittst streifst Du Deine "+schuhwerk[i]->Name(WEN)+
        " auf der Matte ab.") );
      say(
        TPN+" streift sich "+TP->QueryPossPronoun(FEMALE,WEN,PLURAL)+" "+
        schuhwerk[i]->Name(WEN)+" ab und betritt den Laden.\n" );
      if ( "/d/polar/rage/ostplatz/room/fellladen_c3"->Getdreck() < 4 )
        "/d/polar/rage/ostplatz/room/fellladen_c3" -> schriftzug();
      "/d/polar/rage/ostplatz/room/fellladen_c3" -> Dreckiger();
      TP -> move(ROOM "fellladen_c3", M_GO|M_SILENT);
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " streift die Stiefel draussen ab.\n");
      return 1;
    }
    if ( !schuhwerk_getragen )
    {
      write(
        "Du bist doch barfuss! Du kannst Dir nur Deine Fuesse "
  	"abstreifen.\n" );
      return -1;
    }
    notify_fail( "Worauf willst Du Deine "+schuhwerk[i]->Name(WER)+
                 " abstreifen?\n" );
  }
}

int cmd_melden(string str)
{
  mixed *mail_melder, *mail_magier;
  string wem, was, text_melder, text_magier;

  notify_fail( "Wem willst Du was melden?\n" );

  if ( !str || str=="" ) return 0;
  if ( member( ({ "scherz","scherze" }),str ) != -1 )
  {
    write(
      "Wem willst Du die Scherze melden?\n" );
    return -1;
  }
  if ( sscanf(str,"%s %s",wem,was) != 2 ) return 0;
  if ( member( ({ "magier","rage" }), wem ) != -1 )
  {
    if ( member( ({ "scherz","scherze"}), was) != -1 )
    {
      if ( member(gemeldet,getuid(TP)) != -1 )
      {
      	write( BS(
      	  "Du brauchst nicht staendig die Scherze zu melden. Auch Rage "
      	  "braucht ein wenig Zeit, um Deine Beschwerde zu bearbeiten.") );
      	return -1;
      }
      if ( member(meldbar,getuid(TP)) != -1 )
      {
        write( BS(
          "Nachdem Dir die Scherze von Rage eindeutig zu weit gegangen sind, "
          "schickst Du ihm gleich eine Mail, damit er nicht mehr so dumme "
          "Scherze mit Dir macht.") );
        say(
          TPN+" macht sich daran, jemandem eine Mail zu schreiben.\n" );
        text_melder = "Hallo "+TPN+"!\n"
                      "\n"
                      "Deine Beschwerde ueber die hinterhaeltigen und "
                      "gemeinen Witze sind bei Rage\n"
                      "eingelangt.\n"
                      "Er wird sich sobald wie moeglich darum kuemmern, dass "
                      "Dir solche\n"
                      "Unannehmlichkeiten nicht wieder passieren.\n"
                      "\n"
                      "Beschwerdebuero Yiqanuc - stets um ihre Anfragen "
                      "bemueht";                    
        text_magier = "Hallo Rage!\n\n"
                      "Wieder einmal hat sich ein Spieler bei Dir wegen "
                      "Deiner dummen Scherz\n"
                      "aufgeregt.\n";
        mail_melder = allocate(9);
        mail_melder[MSG_FROM] = "Beschwerdebuero Yiqanuc";
        mail_melder[MSG_SENDER] = "rage";
        mail_melder[MSG_RECIPIENT] = getuid(TP);
        mail_melder[MSG_SUBJECT] = "Beschwerdeeingang";
        mail_melder[MSG_DATE] = dtime(time());
        mail_melder[MSG_BODY] = text_melder;
        "/secure/mailer" -> DeliverMail(mail_melder, 1);
        mail_magier = allocate(9);
        mail_magier[MSG_FROM] = getuid(TP);
        mail_magier[MSG_SENDER] = getuid(TP);
        mail_magier[MSG_RECIPIENT] = "rage";
        mail_magier[MSG_SUBJECT] = "Beschwerdeeingang";
        mail_magier[MSG_DATE] = dtime(time());
        mail_magier[MSG_BODY] = text_magier;
        "/secure/mailer" -> DeliverMail(mail_magier, 1);
        gemeldet += ({ getuid(TP) });
        return 1;
      }
      write(
        "Du musst zuerst einen Scherz finden, um diesen melden zu "
        "koennen.\n" );
      return -1;
    }
    write(
      "Was moechtest Du gerne Rage melden?\n" );
    return -1;
  }
}

int cmd_suchen(string str)
{
  if ( member( ({ "scherz","scherze" }),str ) != -1 )
  {
    if ( member(scherz,getuid(TP)) != -1 )
    {
      write( BS(
        "Als Du auf die Suche nach einem Scherz gehst, trifft Dich "
        "auf einmal von hinten ein Schneeball im Genick! Jetzt reicht "
        "es Dir endgueltig und Du wirst solche Scherze einem Magier "
        "unverzueglich melden.") );
      say( BS(
        TPN+" spaziert mit weitaufgerissenen Augen an Dir vorbei, als ob "+
        TP->QueryPronoun(WER)+" auf der Suche nach etwas wäre, doch "
        "ploetzlich wird "+TP->QueryPronoun(WER)+" von einem Schneeball "
        "im Genick getroffen und bricht die Suche ab.") );
      meldbar += ({ getuid(TP) });
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " hat Scherz gefunden.\n");
      return 1;
    }
    if ( member(meldbar,getuid(TP)) != -1 )
    {
      write( BS(
        "Du machst Dich ein weiteres Mal auf die Suche nach einem Scherz, "
        "aber dieses Mal ueberrascht Dich keiner. Meld doch besser zuerst "
        "die beiden, die Du bisher erlebt hast.") );
      say(
        TP+" scheint auf der Suche nach etwas zu sein.\n" );
      return -1;
    }
    write( BS(
      "Du suchst zwar ganz verbissen nach einem Scherz, aber weit und breit "
      "laesst sich keiner finden. Sowas aergerliches!") );
    return -1;
  }
}

int cmd_stellen(string str)
{
  notify_fail( "Willst Du irgendeinen Vergleich anstellen?\n" );
  
  if ( str == "" || !str ) return 0;

  if ( member( ({ "vergleich","vergleiche",
                  "vergleich an","vergleiche an"
                }),str) != -1 )
  {
    write( BS(
      "Wenn Du tatsaechlich irgendeinen Vergleich anstellen willst, "
      "dann verwende bitte die Syntax < vergleiche x mit y >.") );
    return 1;
  } 
}

int cmd_vergleichen(string str)
{
  string was, womit, text;
  string *det;
  mapping uniq;

  uniq = ([ "kurzer weg":"kurzer pfad",
                   "weg":"pfad","hauptpfad":"pfad",
                "wolken":"wolke",
                  "tore":"tor",
          "seitenwaende":"seitenwand",
             "fussmatte":"matte",
          "xandimkinder":"kind","kinder":"kind",
            "erwachsene":"erwachsener","erwachsenen":"erwachsener",
                "kunde":"kundin" ]);

  notify_fail( "Was moechtest Du womit vergleichen?\n" );

  if ( !str || str=="" ) return 0;
  if ( sscanf(str,"%s mit %s", was, womit) != 2 ) return 0;

  det = m_indices(QueryProp(P_DETAILS))+
        m_indices(QueryProp(P_SPECIAL_DETAILS));

  if ( member(det,was) != -1 && member(det,womit) != -1 )
  {
    if  (was == womit)
    {
     write( "Ein und dasselbe miteinander zu vergleichen hat wenig Sinn.\n");
     return -1;
    }
    if ( QueryProp(P_DETAILS)[was]==QueryProp(P_DETAILS)[womit] )
    {
      write(
        "Zwei aehnliche Dinge miteinander zu vergleichen bringt nicht "
        "viel.\n" );
      return -1;
    }
    was = uniq[was] || was;
    womit = uniq[womit] || womit;
    if ( sizeof(paare & ({ was+":"+womit, womit+":"+was })) )
    {
      if ( (was+":"+womit == richtiges_paar) ||
           (womit+":"+was == richtiges_paar) )
      {
        text = vergleichstexte[was+":"+womit] ||
               vergleichstexte[womit+":"+was];
        write(text);
    	vergleich_gefunden += ({ getuid(TP) });
        return 1;
      }
      write( BS(
        "Es ist gar keine dumme Idee, diese beiden zu vergleichen, dennoch "
        "faellt Dir nichts Besonderes auf.") );
      return -1;
    }
    else
    {
      write(
        "Du vergleichst "+CAP(was)+" mit "+CAP(womit)+", aber Du entdeckst "
        "dabei keine Aehnlichkeiten.\n" );
      return -1;
    }
  }
  write( BS(
    "Du kannst nur Dinge miteinander vergleichen, die Du im Raum "
    "auch siehst.") );
  return -1; 
}

int cmd_folgen(string str)
{
  notify_fail( "Wem oder was willst Du folgen?\n" );

  if ( str=="" || !str ) return 0;
  if ( member( ({ "dem beispiel","beispiel" }),str) != -1 )
  {
    write(
      "Dem Bespiel von wem willst Du folgen?\n" );
    return -1;
  }
  if ( member( ({ "dem beispiel der xandim","beispiel der xandim",
                  "dem beispiel von xandim","beispiel von xandim",
                  "dem beispiel vom xandim","beispiel vom xandim"
                }),str) != 1 )
  {
    write(
      "Ja, folge ihrem Beispiel endlich! Was machen die meisten Erwachsenen "
      "hier?\n" );
    say(
      TPN+" will zwar was machen, weiss aber selbst noch nicht genau was.\n" );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " will dem Beispiel folgen.\n");
    return 1;
  }
}
  
int cmd_rutschen(string str)
{
  int i, schuhwerk_getragen;
  object *schuhwerk, blatt;

  notify_fail( "Worauf willst Du aus- bzw dahinrutschen?\n" );

  schuhwerk = TP->QueryProp(P_ARMOURS);
  for ( i=sizeof(schuhwerk); i-->0; )
  {
    if ( schuhwerk[i]->QueryProp(P_ARMOUR_TYPE) == AT_BOOT )
    {
      schuhwerk_getragen = 1;
      break;
    }
  }
  if ( str == "aus" )
  {
    write(
      "Worauf willst Du ausrutschen?\n" );
    return -1;
  }
  if ( str == "dahin" )
  {
    write(
      "Worauf willst Du dahinrutschen?\n" );
    return -1;
  }
  if ( member( ({ "auf eis aus","auf stellen aus",
                  "auf eisstellen aus"
                }),str) != -1 )
  {
    write( BS(
      "Du weisst zwar nicht, was es bringen soll, aber Du rutschst bewusst "
      "auf einer Eisflaeche aus und landest dabei auf Deinem "
      "Allerwertesten.") );
    say( BS(
      TPN+" bewegt sich ganz kurz auf einer Eisflaeche, rutscht allerdings "
      "gleich darauf aus.") );
    return -1;
  }
  if ( member( ({ "auf eis dahin","auf stellen dahin",
                  "auf eisstellen dahin"
                }),str) != -1 )
  {
    if ( schuhwerk_getragen )
    {
      if ( TP->QueryAttribute(A_DEX) < 10+random(10) )
      {
      	write( BS(
      	  "Du versuchst, elegant auf der kleinen Eisflaeche dahinzugleiten, "
      	  "doch Du stellst Dich so ungeschickt an, dass Du nach einem "
      	  "halben Meter ausrutschst und ziemlich dumm auf Deinem Ruecken "
      	  "dabei landest.") );
      	say(
      	  TPN+" versucht sich als Eiskunstlaeufer, rutscht aber "
      	  "peinlicherweise aus und landet auf "+
      	  TP->QueryPossPronoun(MALE,WEM,SINGULAR)+" Ruecken.\n" );
      	return -1;
      }
      write( BS(
        "Elegant gleitest Du auf "+schuhwerk[i]->name(WEM)+" von einem Ende "
        "der Eisflaeche zur anderen und fuehlst Dich phantastisch dabei. Du "
        "wuerdest das am liebsten gleich wiederholen.") );
      say( BS(
        "Anmutig gleitet "+TPN+" ueber die kleine Eisflaeche am Weg und "
        "beweist, wie gut "+TP->QueryPronoun(WER)+" eislaufen kann.") );
      if ( !random(4) && blatt_da )
      {
      	write( BS(
      	  "Du hast zu viel Anlauf genommen und gleitest ueber Dein Ziel "
      	  "hinaus in einen Schneehaufen hinein, wo Dein Schienbein auf etwas "
      	  "trifft, das dort schon laenger gelegen haben muss, und Du es nun "
      	  "durch Deinen Schwung zu Tage gefoerdert hast.") );
      	say( BS(
      	  "Dabei schlittert "+TP->QueryPronoun(WER)+" in einen Schneehaufen "
      	  "hinein und stoesst dabei etwas auf den Weg.") );
      	blatt = clone_object(OBJ "schaufelblatt");
      	blatt -> move(ENV(TP),M_SILENT);
      	blatt_da = 0;
      	write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      	  " findet Schaufelblatt.\n");
      }
      return 1;
    }
    write( BS(
      "Du ueberlegst es Dir doch nochmals, ob es so ratsam waere, barfuss ueber "
      "das Eis gleiten zu wollen.") );
    say( BS(
      TPN+" will "+TP->QueryPossPronoun(MALE,WEN,SINGULAR)+" nackten Fuss aufs "
      "Eis setzen, laesst es aber dann doch bleiben.") );
    return -1;
  }
}

int cmd_putzen(string str)
{
  notify_fail( "Was moechtest Du wovon raeumen?\n" );

  if ( str=="" || !str ) return 0;
  if ( member( ({ "schnee von stein","schnee vom stein",
                  "schnee von stein ab","schnee vom stein ab"
                }),str) != -1 )
  {
    if ( stein_frei )
    {
      write( BS(
        "Auf dem Stein liegt kein Schnee mehr. Mach doch besser Deine Augen "
        "das naechste Mal auf, bevor Du was unternimmst!") );
      return -1;
    }
    write( BS(
      "Mit Deiner Hand wischst Du mehrere Male ueber den Stein, bis Du ihn "
      "ganz vom Schnee befreit hast, da merkst Du, dass etwas auf dem Stein "
      "eingraviert wurde.") );
    say( BS(
      TPN+" stellt sich an den Wegesrand und befreit dort mit "+
      TP->QueryPossPronoun(FEMALE,WEM,SINGULAR)+" Hand einen Stein "
      "vom Schnee.") );
    stein_frei = 1;
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " putzt Schnee von Stein.\n");
    return 1;
  }
}

int cmd_beseitigen(string str)
{
  notify_fail( "Willst Du den Schnee vom Stein beseitigen?\n" );

  if ( str=="" || !str ) return 0;
  if ( str == "schnee" )
  {
    if ( stein_frei )
    {
      write(
        "Der Schnee wurde bereits vom Stein beseitigt.\n" );
      return -1;
    }
    write( BS(
      "So einfach geht das auch wieder nicht, sondern Du musst Dir "
      "schon eine andere Methode ueberlegen, aber Du bist fest davon "
      "ueberzeugt, dass Du den Schnee noch vom Stein bringst.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " will Schnee beiseitigen.\n");
    return 1;
  }
}

int cmd_geniessen(string str)
{
  notify_fail( "Was willst Du geniessen?\n" );

  if ( str=="" || !str ) return 0;
  if ( str == "tag" )
  {
    write( BS(
      "Den Tag kannst Du am besten geniessen, indem Du Dich gemuetlich auf "
      "dem Ostplatz umsiehst und Dich von der angenehmen Atmosphaere "
      "mitreissen laesst.") );
    say(
      TPN+" schaut sich gerade um und blickt dabei zufrieden drein.\n" );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " geniesst den Tag.\n");
    return 1;
  }
}

int cmd_wetten(string str)
{
  int geld;
    
  geld = 500+random(1000);

  notify_fail( "Was moechtest Du wetten?\n" );
  
  str = TP->_unparsed_args();
    if ( str == "dass sich am oberen abschluss der eispalisade eine silhouette gegen den himmel abgezeichnet hat" )
  {
    if ( geldregen )
    {
      write( BS(
        "Du wettest, dass sich am oberen Abschluss der Eispalisade eine "
        "Silhouette gegen den Himmel abgezeichnet hat, und Du hast "
        "tatsaechlich recht, denn Du siehst sie ein zweites Mal. Ausserdem "
        "scheint irgendwer gegen Dich gewettet zu haben, denn ploetzlich "
        "prasseln "+geld+" Muenzen vom Himmel herunter, die Du natuerlich "
        "gleich alle einsteckst.") );
      say( BS(
        "Auf "+TP->Name(WEN)+" prasseln ploetzlich Muenzen vom Himmel "
        "herunter, die "+TP->QueryPronoun(WER)+" natuerlich gleich "
        "einsteckt.") );
      geldregen = 0;
      TP -> AddMoney(geld);
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " hat Wette gewonnen.\n");
      return 1;
    }
    write( BS(
      "Du wettest, dass sich am oberen Abschluss der Eispalisade eine "
      "Silhouette gegen den Himmel abgezeichnet hat, und Du hast "
      "tatsaechlich recht, denn Du siehst sie ein zweites Mal. Schade, dass "
      "dieses Mal niemand gegen Dich gewettet hat, weil sonst haettest "
      "sicher viel gewinnen koennen.") );
    return -1;
  }
}

int cmd_tauschen(string str)
{
  string was, wovon;
  object stange, graufell;

  notify_fail( "Was moechtest Du gerne austauschen?\n" );

  if ( !str || str=="" ) return 0;
  if ( sscanf(str, "%s aus", was) != 1 ) return 0;
  if ( member( ({ "stange","holzstange" }),was) != -1 )
  {
    write(
      "Meinst Du die Holzstange vom Ladentisch?\n" );
    return -1;
  }
  if ( sscanf(str, "%s %s aus", was, wovon) != 2 ) return 0;
  {
    if ( member( ({ "stange","holzstange" }),was) != -1 )
    {
      if ( member( ({ "vom ladentisch","von ladentisch",
                      "beim ladentisch","am ladentisch"
                    }),wovon) != -1 )
      {
        if ( stange = present("\nholzstange",TP) )
        {
          if ( graufell = present("graufell",ENV(TP)) )
          {
            if ( stange -> Stange_kaputt() )
            {
              graufell -> command_me( "sage He, "+TPN+"! Was "
                          "machst Du an meinem Ladentisch! Eine angeknackste "
                          "Stange kann ich nicht brauchen, denn da bricht "
                          "mir noch alles zusammen." );
              return -1;
            }
            if ( graufell -> QueryGeholfenen(TP) )
            {
              write( BS(
                "Waehrend Graufell die Schnuere losbindet und die Querstange "
                "haelt, tauschst Du die angebrochene Stange aus. "
                "Anschliessend bindet Graufell die Schnuere wieder fest.") );
              say( BS(
                TPN+" tauscht mit der Hilfe von Graufell eine angebrochene "
                "Stange vom Ladentisch aus.") );
              graufell -> command_me("sage Vielen Dank fuer Deine Hilfe, "+
                                     TPN+".\n");
              stange_getauscht = 1;
              stange -> schlechter_Zustand();
              write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
                " tauscht Stange aus.\n");
              return 1;
            }
            write( BS(
              "Als Du die Stangen austauschen moechtest, scheint Graufell "
              "nicht ganz einverstanden damit zu sein.") );
            say(
              TPN+" greift gerade zum Ladentisch von Graufell, worauf der "
              "entsprechend reagiert.\n" );
            graufell -> command_me("emote sagt erbost: "+TPN+", Haende weg "
                                   "von meinem Ladentisch!\n");
            return -1;
          }
          if ( stange -> Stange_kaputt() )
          {
            write( BS(
              "Nachdem Graufell gerade nicht da ist, machst Du Dich an die "
              "Arbeit und tauscht die ganze Stange gegen Deine angeknackste "
              "aus. Das ganze dauert ein wenig, weil Du alles allein machen "
              "musst, deshalb grinst Du umso schelmischer nach Vollendung "
              "deines Streiches.") );
            say( BS(
              TPN+" tausch am Ladentisch von Graufell eine Stange gegen eine "
              "andere aus und grinst dabei schelmisch.") );
            stange_getauscht = 0;
            stange -> guter_Zustand();
            return 1;
          }
          else
          {
            write(
              "Ohne der Hilfe von Graufell wirst Du die Stange nicht "
              "austauschen koennen.\n" );
            return -1;
          }
        }
        write( BS(
          "Es ist sehr lobenswert von Dir, dass Du die Holzstange mit dem "
          "Sprung austauschen moechtest, aber Du hast leider keine "
          "Passende zum Austauschen dabei.") );
        return -1;
      }
      write(
        "Wo moechtest Du eine Holzstange austauschen?\n" );
      return -1;
    }
  }
}
int stange_tauschbar()
{
  return stange_getauscht;
}

int gehen(string str)
{
  object *players;
  int i, n;

  if ( str == "suedosten" )
  {
    write( BS(
      "Eine magische Barriere haelt Dich derzeit noch ab, in diese Richtung "
      "zu gehen.") );
    return -1;
  }
  if ( rutschgefahr && !random(4) )
  {
    write(
      "Als Du nach "+CAP(str)+" gehen willst, rutscht Du auf einer "
      "Eisplatte aus, die Du in\n"
      "Deiner Hektik uebersehen hast.\n"
      "Du denkst . o O (hoffentlich hat das jetzt niemand gesehen).\n" );
    say( BS(
      TPN+" rutscht sehr tolpatschig auf einer Eisplatte aus, sodass "
      "Du Dir das Lachen nicht verkneifen kannst.") );
    
    players = ({});
    players = filter_array(all_inventory(ENV(TP)), #'interactive);
    n = sizeof(players);
    for ( i=0; i<n; i++ )
    {
      if ( players[i] != TP )
      {
      	write(
          players[i]->Name(WER)+" lacht Dich aus.\n" );
        tell_object( players[i],
          "Du musst total laut drauf loslachen, als Du siehst, wie "+TPN+
          " hinfaellt.\n" );
        tell_room( ENV(TP),
          players[i]->Name(WER)+" lacht "+TP->Name(WEN)+" aus.\n",
          ({ TP, players[i] }) );
      }
    }
    return 1;
  }
  return ( TP->move(TOROOM[str], M_GO, "nach "+CAP(str)) );
}

int cmd_betreten(string str)
{
  notify_fail( "Ich bin mir sicher, dass Du den Laden betreten willst!\n" );

  if ( member( ({ "laden","felladen","fellladen","huette","blockhuette"
               }),str) != -1 )
  {
    write(
      "Sehr entschlossen betrittst Du den Felladen.\n" );
    TP->move( ROOM "fellladen_c3", M_GO, "nach Sueden" );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " betritt den Laden.\n");
    return 1;
  } 
}

int cmd_vergroessern(string str)
{
  notify_fail( "Was wuerdest Du gerne vergroessern wollen?\n" );

  if ( member( ({ "stellen","stelle" }),str) != -1 )
  {
    write( BS(
      "Das ist zwar eine gemeine Idee, die Dir da durch den Kopf geht, "
      "aber mach nur, wenn es Dir Spass macht, doch Du wirst wohl "
      "irgendein Utensil dazu brauchen, um genug Eis freilegen zu koennen.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " will das Eis vergroessern.\n");
    return 1;
  }
}
//END COMMANDS
int schneebedeckt()
{
  return 1;
}
int schnee_da()
{
  return rutschgefahr;
}
void SetEisfrei()
{
  rutschgefahr = 1;
}
//RESET
void reset()
{
  ::reset();
  
  rutschgefahr = 0;
  if ( ! stange_getauscht )
  {
    say( BS(
      "Ein riesiger Tumult entsteht bei einem Laden, weil ploetzlich eine "
      "Querstange mit Waren runterbricht und es sehr laut klirrt und kracht. "
      "Der Handler macht sich gleich daran, wieder alles in Ordnung zu "
      "bringen, um seinen Geschaeften nachkommen zu koennen.") );
  }
  if ( resetcounter > 9 )
  {
    gemeldet = ({});
    resetcounter = -1;
  }
  scherz = ({});
  meldbar = ({});
  vergleich_gefunden = ({});
  stange_getauscht = 0;
  geldregen = 1;
  richtiges_paar = paare[random(sizeof(paare))];
  resetcounter++;
}

do_sell(object ob, int force, no_reg)
{
  write(
    "Graufell erklaert Dir, dass er nur Waren verkauft.\n" );
  return -1;
}

buy(str)
{
  if ( present("\nverbot",TP) )
  {
    write( BS(
      "Graufell bedient Dich derzeit nicht, weil er nicht vergessen hat, wie "
      "hinterhaeltig Du ihm gegenueber warst.") );
    return -1;
  }
  return ::buy(str);
}

