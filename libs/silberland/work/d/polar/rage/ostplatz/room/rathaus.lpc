// Rathaus, Rage November 99

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>

#define P_TMP_HAND_INJURED "tmp_hand_injured"
#define P_TMP_GLOVE_BURNED "tmp_glove_burned"

nosave string * maus_gehoert;
nosave string * stein_plaziert;
string mausda(string key);

void create()
{
  ::create();
  maus_gehoert = ({});
  stein_plaziert = ({});

  SetProp( P_INT_SHORT, "Im Rathaus" );
  SetProp( P_INT_LONG,
    "Endlich sind die Umbauarbeiten abgeschlossen und das Rathaus ist der "
    "Oeffentlichkeit wieder zugaenglich.\n"
    "Dir fallen zwei Sachen auf der Stelle auf. Einerseits ist es hier "
    "gemuetlich warm, was an dem Feuer in der Mitte des Raumes liegt, "
    "andererseits hast Du noch nie soviele Felle auf einen Haufen gesehen. "
    "Und auf den Fellhaufen verteilt sitzen einige Xandim, die sich angeregt "
    "unterhalten und diskutieren, unter ihnen auch das Stammesoberhaupt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: 10]) );

// DETAILS
  AddDetail( ({ "ecke","ecken" }),
    "In einem Iglu gibt es keine Ecken. Wo hast Du den Bloedsinn her?" );
  AddDetail( ({ "bloedsinn" }),
    "Du untersucht wohl auch jeden Bloedsinn?" );
  AddDetail( ({ "stelle" }),
    "Momentan stehst Du an einer Stelle und siehst Dich im Iglu um." );
  AddDetail( ({ "stammesoberhaupt" }),
    "Das ist derzeit nicht hier." );
  AddDetail( ({ "papier","papierzettel","dokumente","blaetter","blatt" }),
    "Ueberall liegen zahlreiche Papierzettel herum. Es duerfte sich dabei um "
    "wichtige Dokumente handeln, da jeder einen in der Hand haelt und mit "
    "seinem Sitznachbarn darueber spricht." );
  AddDetail( ({ "sitznachbar","sitznachbarn" }),
    "Damit ist einer der Xandim gemeint." );
  AddDetail( ({ "sachen","sache" }),
    "Selbstverstaendlich das Feuer in der Mitte und die schier endlose "
    "Ansammlung von Fellen in allen Arten." );
  AddDetail( ({ "ansammlung" }),
    "Diese Vielfalt an Fellen kannst nicht einmal Du uebersehen." );
  AddDetail( ({ "waerme" }),
    "Die geht von der Feuerstelle in der Mitte des Iglus aus." );
  AddDetail( ({ "feuerstelle" }),
    "In der Mitte ist eine schlichte Feuerstelle. Einzelne Holzscheite lodern "
    "uebereinander gehaeuft, und damit die Eisdecke am Boden nicht weiter "
    "schmilzt, sind sie von einem Steinkreis umgeben. Dir faellt auf, dass "
    "der Platz, an dem die Feuerstelle ist, wohl der einzige ist, an dem man "
    "den Erdboden sehen kann." );
  AddDetail( ({ "feuer","flamme","flammen" }),
    "Das Feuer gibt dem Raum einerseits Waerme, andererseits auch Licht." );
  AddDetail( ({ "rauch" }),
    "Einwenig Rauch steigt von der Feuerstelle auf, der aber gleich durch den "
    "Abzug abzieht." );
  AddDetail( ({ "eisdecke" }),
    "Die kannst Du derzeit nicht sehen, denn der Boden ist ueber und ueber "
    "mit Fellen bedeckt. Drum ist er hier auch nicht so kalt." );
  AddDetail( ({ "platz" }),
    "Natuerlich der, wo die Scheite liegen und Du darunter die Erde sehen "
    "kannst." );
  AddDetail( ({ "erdboden" }),
    "Ja, Du hast es geschafft! Du hast nach langer Suche Erde im Polargebiet "
    "gefunden. Damit ist bewiesen, dass dieser Kontinent im Grund genommen "
    "auch gleich aufgebaut ist wie die anderen. Gratuliere!" );
  AddDetail( ({ "grund" }),
    "Du bist aber heute wieder gruendlich!" );
  AddDetail( ({ "suche","sucherei" }),
    "Dank Deiner eifrigen Sucherei hast Du Erde im Polargebiet entdeckt." );
  AddDetail( ({ "kontinent","breiten","gegenden" }),
    "Nach reiflicher Ueberlegung meinst Du, dass Polar damit gemeint sein "
    "muesste." );
  AddDetail( ({ "ueberlegung" }),
    "Du ueberlegst und ueberlegst und ueberlegst und ..." );
  AddDetail( ({ "mitte" }),
    "Die Feuerstelle ist dort." );
  AddDetail( ({ "holzscheit","holzscheite","scheit","scheite" }),
    "Die brennen nicht richtig, sondern gluehen viel mehr, aber reingreifen "
    "wuerde ich trotzdem nicht, denn da verbrennst Du Dich sicher dabei." );
  AddSpecialDetail( ({ "steinkreis","kreis","steine" }),"detailSteinkreis" );
  AddDetail( ({ "licht" }),
    "Ist es hier, dank des Feuers und des Abzugs an der Decke." );
  AddSpecialDetail( ({ "stein" }),"detailStein" );
  AddDetail( ({ "umbauarbeiten","umbauarbeit","arbeiten","arbeit" }),
    "Die sind wohl vorbei, aber was genau gemacht wurde, kannst Du nicht sagen." );
  AddDetail( ({ "rathaus" }),
    "In diesem befindest Du Dich im Moment. In keinem anderen Rathaus hast Du "
    "Dich so wohl gefuehlt wie hier, denn es ist richtig gemuetlich "
    "eingerichtet. Und trotz der lockeren Stimmung wird fleissig gearbeitet." );
  AddDetail( ({ "moment" }),
    "Derzeit." );
  AddDetail( ({ "stimmung","atmosphaere" }),
    "Eine entspannte Atmosphaere herrscht hier. Die Xandim unterhalten sich "
    "angeregt, nur leider verstehst Du kaum etwas, da sie alle scheinbar wirr "
    "durcheinander sprechen." );
  AddDetail( ({ "oeffentlichkeit" }),
    "Damit sind Personen wie Du gemeint, denn sonst wuerdest Du Dir noch "
    "immer draussen in der Kaelte den Hintern abfrieren." );
  AddDetail( ({ "personen","leute" }),
    "Damit sind die Xandim gemeint, die hier auf Fellen verteilt im Iglu "
    "sitzen, wie Dir sicher schon aufgefallen ist." );
  AddDetail( ({ "kaelte" }),
    "Die hast Du fuer einen Augenblick hinter Dich gelassen und bist sehr "
    "froh darueber." );
  AddDetail( ({ "augenblick" }),
    "Eben jetzt." );
  AddDetail( ({ "hintern","hinterteil" }),
    "Nach kurzer Abtastung deines Hinterteils merkst Du, dass er langsam am "
    "Auftauen ist." );
  AddDetail( ({ "boden" }),
    "Der Boden ist so mit Fellen ausgelegt, dass Du ihn gar nicht mehr "
    "siehst. Du kannst nicht einmal sagen, ob er aus Erde oder Schnee "
    "besteht, aber Du vermutest, dass es zweiteres sein muss. Nur in der "
    "Mitte gibt es eine Feuerstelle, die sich von den Fellhaufen durch ihre "
    "strahlende Waerme abhebt." );
  AddDetail( ({ "waende","wand" }),
    "Wie nicht anders zu erwarten, gibt es in diesem Iglu nur eine Wand in "
    "Form einer ausgeschaelten Halbkugel. Im Osten deckt ein Vorhang einen "
    "Gang ab." );
  AddDetail( ({ "form","form in raum" }),
    "Eben die einer Halbkugel. Muss ich Dir alles doppelt erzaehlen?" );
  AddDetail( ({ "halbkugel" }),
    "Stell Dir einfach Deinen Kopf vor, wenn Du nur die obere Haelfte "
    "betrachtest. Aussen schoen rund und innen hohl. :-)" );
  AddDetail( ({ "kopf","haelfte" }),
    "Du klopfst zweimal kurz drauf. Ja, er ist tatsaechlich hohl." );
  AddDetail( ({ "vorhang" }),
    "Der Vorhang ist aus der Haut eines Tieres gemacht und verbirgt den "
    "dahinter liegenden Gang." );
  AddDetail( ({ "gang" }),
    "Der ist nur zu erahnen, aber aufgrund des Vorhanges nicht zu sehen." );
  AddDetail( ({ "haut","robbenhaut" }),
    "Du siehst Dir den Vorhang genauer an und schaetzt, dass es Robbenhaut "
    "sein muesste." );
  AddDetail( ({ "decke","kuppel","igludecke" }),
    "Die Decke ist keine Decke im herkoemmlichen Sinn, da Du in einem Iglu "
    "stehst. Sie ist vielmehr als Kuppel zu bezeichnen, in der die Waende, "
    "besser gesagt die Wand, zu einem grossen Punkt zusammenlaeuft. Weiters "
    "faellt Dir ein kleiner Abzug auf, der wohl dafuer sorgt, dass es hier "
    "nicht zu stickig wird." );
  AddDetail( ({ "sinn","mudden" }),
    "Einen Sinn beim Mudden siehst Du nicht!" );
  AddDetail( ({ "punkt" }),
    "Hier gibt es keinen Punkt, sondern nur den Abzug." );
  AddDetail( ({ "abzug" }),
    "Der Abzug dient dazu, dass der Rauch, der von der Feuerstelle ausgeht, "
    "ohne Probleme nach Aussen abziehen kann. Theoretisch koenntest Du durch "
    "ihn auch den Himmel sehen, wenn der Rauch nicht die Sicht nehmen wuerde. "
    "Erst jetzt faellt Dir ein Gestell auf, das in Mannhoehe neben dem Abzug "
    "befestigt wurde." );
  AddDetail( ({ "aussen" }),
    "Mit Aussen ist alles ausserhalb dieses Iglus gemeint. Wenn Du davon "
    "mehr sehen willst, brauchst Du nur das Iglu zu verlassen." );
  AddDetail( ({ "probleme" }),
    "Probleme kann man nicht sehen. Entweder man hat welche, oder man hat "
    "keine." );
  AddDetail( ({ "sicht" }),
    "Die Sicht auf den Himmel ist Dir durch den Rauch verwehrt." );
  AddDetail( ({ "himmel" }),
    "Der ist kaum wegen des Rauchs zu sehen, doch die Sonne scheint zu "
    "scheinen, da es draussen licht ist." );
  AddDetail( ({ "sonne" }),
    "Du vermutest, dass sie scheint, da Licht von oben hereinfaellt." );
  AddSpecialDetail("mannhoehe", "detailMannhoehe" );
  AddDetail( ({ "gestell","waffengestell" }),
    "Das Gestell besteht aus zwei u-foermigen Holzteilen, deren Enden in die "
    "Igludecke so fest reingerammt wurden, dass sie sicher nicht "
    "runterfallen. Die beiden Holzteile sind etwa 1,5 Meter voneinander "
    "entfernt, sodass die Gebrauchsgegenstaende, die darauf gelagert sind, "
    "leicht Platz haben. Man koennte sich das ganze wie ein Waffengestell "
    "vorstellen, nur nicht an der Wand wie ueblich, sondern an der Decke." );
  AddDetail( ({ "meter" }),
    "Wieviel ein Meter ist, musst Du selbst wissen. Immer kann ich Dir auch "
    "nicht helfen." );
  AddDetail( ({ "enden","ende" }),
    "Die Enden der Holzteile stecken in der Decke, sodass Du sie "
    "genaugenommen gar nicht siehst, und ich dieses Detail wieder rausnehmen "
    "muesste, was mir allerdings viel zu muehsam ist." );
  AddDetail( ({ "detail","details" }),
    "Details gibt es hier mehr als genug, schau Dich endlich einmal um!" );
  AddDetail( ({ "holzteil","holzteile","holzteilen" }),
    "Einfache Holzteile, die leicht wie ein U gebogen sind. Mehrere kleine "
    "Schlaufen aus Leder sind daran befestigt, damit die "
    "Gebrauchsgegenstaende nicht gleich runterfallen." );
  AddDetail( ({ "u" }),
    "                _   _           __        __    \n"
    "               | | | |          \\ \\      / /  \n"
    "So sieht ein:  | | | |  aus, Du  \\ \\ /\\ / /  \n"
    "               | |_| |            \\ V  V /     \n"
    "                \\___/              \\_/\\_/    \n" );
  AddDetail( ({ "schlaufen" }),
    "Sie sorgen dafuer, dass die Gebrauchsgegenstaende nicht verrutschen oder "
    "runterfallen." );
  AddDetail( ({ "leder" }),
    "Die Schlaufen sind aus Leder gemacht." );
  AddDetail( ({ "waffen" }),
    "Waffen sind auf den ersten Blick keine dabei." );
  AddDetail( ({ "gebrauchsgegenstaende","geruempel","dinge" }),
    "Du weisst nicht recht, ob Du mit diesen Gegenstaenden was anfangen "
    "kannst. Es muss sich dabei um Dinge handeln, die dem Fischfang oder der "
    "Jagd dienen. Du siehst Netze, Angel, Holzstecken, Ruder, verrostete "
    "Jagdfallen und ein paar Seile. Ist eher wohl Geruempel, als etwas "
    "ernsthaft Brauchbares dabei." );
  AddDetail( ({ "jagd","fischfang" }),
    "Wie Du anhand der Gebrauchsgegenstaende sehen kannst, leben die Xandim "
    "wohl von der Jagd und vom Fischfang." );
  AddDetail( ({ "netz","netze" }),
    "Die werden sicher fuer den Fischfang benoetigt." );
  AddDetail( ({ "angel" }),
    "Wozu die gut sein kann?" );
  AddDetail( ({ "holzstecken","stecken" }),
    "Verschiedene Stecken aus unterschiedlichen Holzarten. Die Xandim werden "
    "sicher eine Verwendung fuer sie haben." );
  AddDetail( ({ "holzarten" }),
    "Du tippst auf Fichte, Tanne und Zeder." );
  AddDetail( ({ "fichte","tanne","zeder" }),
    "Daraus sind wohl die Stecken gemacht." );
  AddDetail( ({ "verwendung" }),
    "Die ist Dir schleierhaft." );
  AddDetail( ({ "ruder" }),
    "Row, row, row a boat, row a boat ashore, ..." );
  AddDetail( ({ "jagdfallen","jagdfalle","fallen","falle" }),
    "Die Fallen haben schon einiges mitgemacht, nach dem Rost zu urteilen, "
    "der sich auf ihnen gebildet hat." );
  AddDetail( ({ "rost" }),
    "Der muss sich bilden, wenn die Fallen solange im Schnee herumliegen." );
  AddDetail( ({ "seile","seil" }),
    "Sicher kein neuer Gegenstand fuer Dich, also weisst Du, wozu man es "
    "verwenden kann." );
  AddDetail( ({ "brauchbares" }),
    "Vielleicht findest Du doch etwas Brauchbares." );
  AddDetail( ({ "erde" }),
    "Immer schoen die Augen offenhalten, und Du entdeckst sie schneller als "
    "Du denkst." );
  AddDetail( ({ "augen" }),
    "Die haeltst Du offen... huch, jetzt hast Du doch geblinzelt :-(" );
  AddDetail( ({ "haufen","fellhaufen" }),
    "Du kannst Deine Geldgier kaum noch zuegeln, wenn Du daran denkst, "
    "wieviel Muenzen Du fuer all die Felle kriegen muesstest. Es sieht aber "
    "nicht so aus, als ob Dir irgendwer eines ueberlassen wuerde." );
  AddDetail( ({ "geldgier" }),
    "In Deinen Gedanken siehst Du Dich, wie Du in Millionen von Muenzen "
    "ein Geldbad nimmst." );
  AddDetail( ({ "gedanke","gedanken","millionen","geldbad" }),
    "Das ist nur ein Gedanke, nicht die Wirklichkeit." );
  AddDetail( ({ "wirklichkeit" }),
    "Die Wirklichkeit sieht meistens anders aus." );
  AddDetail( ({ "muenzen","boerse" }),
    "Schau mal in Deine Boerse, dann weisst Du, wieviel Muenzen Du hast." );
  AddDetail( ({ "fell","felle","fellen","palette","arten","art","vielfalt" }),
    "Die Palette reicht von Eisbaerenfell ueber Wolfsfelle bis zu "
    "Eisfuchsfellen. Und auf den ganzen Fellen verteilt sitzen mehrere "
    "Xandim, die mit unterschiedlichen Blaetter und Gegenstaenden in den "
    "Haenden herumartikulieren." );
  AddDetail( ({ "gegenstaende","gegenstaenden","gegenstand" }),
    "Du kannst nicht genau erkennen, um welche es sich dabei handelt." );
  AddDetail( ({ "hand","haende" }),
    "Keiner von den hier Anwesenden scheint eine freie Hand zu haben. "
    "Entweder sie reichen ein Blatt zum naechsten oder sie deuten auf "
    "irgendwelche Gegenstaende, die im gesamten Raum verteilt herumliegen." );
  AddDetail( ({ "anwesende","anwesenden" }),
    "Hauptsaechlich sind es Xandim, was Dich aber auch nicht weiter "
    "ueberrascht, da Du Dich in ihrem Dorf aufhaeltst." );
  AddDetail( ({ "xandim","volk","bewohner" }),
    "Die Xandim sind ein starkes Volk und fuehlen sich in diesen Gegenden im "
    "eisigen Norden wohl. Sie lieben die Gemeinschaft und jeder lebt mit "
    "seiner Familie in einem Iglu." );
  AddDetail( ({ "familie","familiensinn","familien","mitglied","mitglieder",
                "gemeinschaft" }),
    "Die Xandim haben einen ausgepraegten Familiensinn. Ihre Familie geht "
    "ihnen ueber alles. Man koennte schon fast sagen, sie ist ihnen heilig. "
    "Hat man Schwierigkeiten mit einem Mitglied der Familie, so sollte man "
    "damit rechnen, dass die anderen Mitglieder auf Dich nicht gut zu "
    "sprechen sind." );
  AddDetail( ({ "schwierigkeit","schwierigkeiten" }),
    "Die willst Du doch ganz bestimmt nicht haben, oder etwa doch?" );
  AddDetail( ({ "iglu","iglus" }),
    "Du stehst in einem der zahlreichen Iglus von Yiqanuc." );
  AddDetail( ({ "dorf","yiqanuc" }),
    "Das schoene Dorf, in dem, bis auf wenige Ausnahmen, alles aus Eis "
    "besteht." );
  AddDetail( ({ "ausnahmen" }),
    "Ja, nicht alles in Yiqanuc ist aus Eis und Schnee, aber die Ausnahmen "
    "musst Du schon noch selbst finden." );
  AddDetail( ({ "eis","schnee" }),
    "Dass hier alles aus Eis bzw. Schnee erbaut wurde, verwundert nicht "
    "weiter, wenn man bedenkt, in welcher Klimazone das Polargebiet und somit "
    "auch Yiqanuc liegt." );
  AddDetail( ({ "polargebiet","polarregion","gebiet","klimazone","zone","polar" }),
    "Ein kaltes Gebiet, in dem man nur ueberleben kann, wenn man sich den "
    "oertlichen Begebenheiten anpassen kann." );
  AddDetail( ({ "begebenheiten","begebenheit" }),
    "Niedrige Temperaturen, eisige Winde und verschiedene Tiere. Ausserdem "
    "faellt Dir dazu noch eine Begebenheit aus deiner Kindheit ein." );
  AddDetail( ({ "kindheit","kind" }),
    "Wenn Du darueber nachdenkst, erinnerst Du Dich, dass Du als Kind immer "
    "gern in Decken und aehnlichem gewuehlt hast." );
  AddDetail( ({ "decken" }),
    "Die Xandim verwenden die Wolfsfelle als Decken." );
  AddDetail( ({ "temperatur","temperaturen","wind","winde","tiere" }),
    "Schau Dich mal im Polargebiet um, dann wirst Du mehr darueber erfahren." );
  AddDetail( ({ "raum" }),
    "Damit ist natuerlich das Rathaus gemeint." );
  AddDetail( ({ "eisbaerenfell","eisbaerenfelle","eisbaerenfellen" }),
    "Unschwer erkennst Du diese Felle aufgrund ihrer weissen Farbe und ihrer "
    "Groesse. Die Xandim scheinen ein starkes und tapferes Volk zu sein, dass "
    "sie sich mit Eisbaeren anlegen." );
  AddDetail( ({ "eisbaer","eisbaeren","baer","baeren" }),
    "Bist Du aber doof! Hier siehst Du natuerlich keine, sondern nur die "
    "Felle von ihnen." );
  AddDetail( ({ "farbe" }),
    "Mal scharf nachdenken. Schnee? Eisbaerenfell? Hm... das muesste weiss "
    "sein, genau!" );
  AddDetail( ({ "groesse" }),
    "Wenn Du die Groesse der Eisbaerenfelle mit denen der anderen "
    "vergleichst, stellst Du fest, dass sie doch um einiges groesser sind. "
    "Und wenn Du erst nachdenkst, wie gross die dazugehoerigen Baeren gewesen "
    "sein muessen, dann willst Du lieber keinem begegnen." );
  AddDetail( ({ "wolfsfell","wolfsfelle","wolfsfellen" }),
    "Waehrend die Eisbaerenfelle hauptsaechlich als Unterlage dienen, decken "
    "sich die Xandim mit diesen Fellen zu. So hat die Schlachtung jedes "
    "Tieres neben dem Fleisch noch eine weitere Nutzung." );
  AddDetail( ({ "unterlage" }),
    "Die Eisbaerenfelle dienen als solche." );
  AddDetail( ({ "schlachtung" }),
    "Die Xandim schlachten nur soviel, damit sie ueberleben koennen." );
  AddDetail( ({ "fleisch" }),
    "Das wird natuerlich bei der Schlachtung gewonnen." );
  AddDetail( ({ "nutzung" }),
    "Einerseits die Nutzung der Felle, andererseits die des Fleisches." );
  AddDetail( ({ "eisfuchsfell","eisfuchsfelle","eisfuchsfellen" }),
    "Im Polargebiet leben keine Fuechse, wie Du sie vielleicht aus dem "
    "Silberwald kennst, sondern Eisfuechse, die sich den rauhen Bedingungen "
    "in diesen Breiten angepasst haben." );
  AddDetail( ({ "fuechse","eisfuechse","fuchs","eisfuchs" }),
    "Eben Tiere aus der Polarregion" );
  AddDetail( ({ "silberwald" }),
    "Den hast Du weit hinter Dir zurueckgelassen." );
  AddDetail( ({ "bedingungen" }),
    "Zum Beispiel Kaelte und eisige Winde." );
  AddDetail( ({ "beispiel" }),
    "Brauchst Du zu jedem Beispiel ein Beispiel?" );
  AddDetail( ({ "buecher" }),
    "Die Xandim blaettern regelmaessig in Dir unbekannten Buechern." );
  AddDetail( ({ "essen" }),
    "Wo?" );
  AddDetail( ({ "eislutscher" }),
    "Leider keiner da. Sehr schade :-(" );
  AddDetail( ({ "v","tieres","so","raumes","nein","hinterteils","haenden",
    "auftauen","abtastung" }),
    "Das kannst Du nicht untersuchen!" );

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Prasseln des Feuers, das Rascheln von Papier, "
    "unterschiedliche Stimmen und ein Wuehlen, als ob jemand was suchen "
    "wuerde." );
  AddSound( ({ "prasseln","feuer" }),
    "Das ist unverkennbar das Prasseln eines Feuers. Du wunderst Dich doch, "
    "dass das Iglu noch nicht weggeschmolzen ist." );
  AddSound( ({ "rascheln","papier","durchblaettern" }),
    "Ueberall hoerst Du das Rascheln von Papier. Die Leute scheinen wohl "
    "dabei zu sein, wichtige Dokumente durchzustoebern." );
  AddSound( ({ "stimme","stimmen","stimmenwirrwarr" }),
    "Du kannst leider keine genau heraushoeren. Das Stimmenwirrwarr ist "
    "einfach zu gross. Aber es muss sehr wichtig sein, denn sonst geht es bei "
    "den Xandim nicht so laut zu." );
  AddSound( ({ "wuehlen" }),
    "Ein Wuehlen in Gegenstaenden in der einen Ecke, dort wiederum ein "
    "Durchblaettern von Buecher und anderswo klingt es, als ob eine Maus in "
    "der Erde wuehlt, aber dabei musst Du Dich doch verhoert haben." );
  AddSound( ({ "maus" }), #'mausda );

  AddSmell( DEFAULT_SMELL,
    "Was glaubst Du zu riechen, wenn Du mitten in einem Iglu stehst? Eis? "
    "Schnee?" );
  AddSmell( ({ "eis" }),
    "Da das Eis, an dem Du riechst, kein Eislutscher ist, stellst Du keinen "
    "Geruch daran fest." );
  AddSmell( ({ "schnee","schneegeruch" }),
    "Neben dem typischen Schneegeruch (weiss, kalt, feucht), nimmst Du "
    "tatsaechlich den Geruch von uralten Buecher wahr, der eher als Moder zu "
    "bezeichnen ist, und einen leicht stechenden, der von dem Feuer ausgeht." );
  AddSmell ( ({ "buecher","geruch" }),
    "Du siehst sie zwar besser, als dass Du sie riechen kannst, aber dafuer "
    "kannst aufgrund des von ihnen ausgehenden modrigen Geruchs darauf "
    "schliessen, dass sie sehr alt sein muessen." );
  AddSmell ( ({ "moder" }),
    "Wie halten die Bewohner es bei diesem Moder nur solange hier aus? "
    "Anscheinend gewoehnt man sich daran, wenn man sich lange genug in diesem "
    "Iglu aufhaelt." );
  AddSmell ( ({ "feuer" }),
    "Du hast doch sicher einmal an einem Feuer gerochen, dann kannst Du Dir "
    "sicher vorstellen, wie es riecht. Und Nein, Essen pruzzelt keines "
    "darueber, also schau selbst, wie Du zu einem kommst." );


//END DETAILS

  AddExit( "norden", "nach Norden#" + "/d/polar/thor/xandim/room/hstrasse11.lpc" );
  AddSpecialExit( "osten", "go_east" );

  AddItem( NPC "yrdaret", REFRESH_DESTRUCT );

  AddCmd( ({ "greif","greife" }), "greifen" );
  AddCmd( ({ "wuehl","wuehle" }), "wuehlen" );
  AddCmd( ({ "hebe","heb","fuelle","fuell","plazier","plaziere" }), "heben" );
  AddCmd( ({ "nimm","nehm","nehme" }), "nehmen" );
}

int go_east(string dir)
{
  write(
    "Zwei Xandim stehen auf und halten Dich davon ab, die Ahnengalerie zu "
    "betreten.\n" );
  say( BS(
    "Zwei Xandim stehen auf und halten "+TPN+" davon ab, die Ahnengalerie zu "
    "betreten.") );
  return 1;
}

//SPECIAL DETAILS 
nosave string detailSteinkreis()
{
  if ( member(stein_plaziert,getuid(TP)) != -1 )
  {
    return BS(
      "Der Steinkreis wird, wie nicht anders zu erwarten, aus Steine "
      "gebildet. Diese sind in einem schoenen Kreis rund um die Holzscheite "
      "verteilt. Das ist nicht zuletzt Deiner Aufmerksamkeit zu verdanken." );
  }
  return BS(
    "Der Steinkreis wird, wie nicht anders zu erwarten, aus Steine gebildet. "
    "Diese sind in einem schoenen Kreis rund um die Holzscheite verteilt. "
    "Ganz perfekt ist der Kreis auch wieder nicht, denn ein Stein liegt "
    "naeher beim Feuer. Das solltest Du rasch aendern. Das darf doch nicht so "
    "unordentlich bleiben!" );
}

nosave string detailStein()
{
  if ( member(stein_plaziert,getuid(TP)) != -1 )
  {
    return BS(
      "Der Stein faellt nicht mehr besonders auf, weil er den Steinkreis wie "
      "alle anderen perfekt ausfuellt." );
  }
  return BS(
    "Er sieht aus wie alle anderen hier, allerdings fuellt er den Steinkreis nicht "
    "aus." );
}
string detailMannhoehe()
{
  string text;
  
  text = "Die bezieht sich natuerlich auf die Groesse der Xandim und nicht auf "
         "die "+TP->QueryArticle(WESSEN,0,1)+TP->QueryProp(P_RACESTRING)[WESSEN]+
         ".";
  if ( TP->QueryProp(P_GENDER) == FEMALE )
    text +=  " Ausserdem kannst Du Dich mit dem Wort \"Mannhoehe\" nicht ganz "
             "abfinden und wuerdest Rage am liebsten davon berichten.";
  return BS(text);
}
//END SPECIAL DETAILS

string mausda(string key)
{
  maus_gehoert += ({ getuid(TP) });
  return BS(
    "Hmm... Das klingt doch wie eine Maus, die sich irgendwo versteckt haben "
    "muss. Wenn Du Glueck hast, findest Du sie sogar." );
}

//COMMANDS
int nehmen(string str)
{
  object stecken, speer;
  string was;

  if ( !str ) return 0;
  if ( sscanf(str, "%s aus gestell", was) != 1 ) return 0;
  if ( member( ({ "ruder","falle","fallen","netz",
                  "netze","angel","jagdfalle","jagdfallen"
		}), was) != -1 )
  {
    write( BS(
      "Diesen Gegenstand wirst Du nicht brauchen, drum laesst Du ihn dort, wo "
      "er ist.") );
    return -1;
  }
  if ( member( ({ "seil","seile" }), was) != -1 )
  {
    write(
      "Du wirst es Dir wohl noch leisten koennen, selbst ein Seil zu "
      "kaufen.\n" );
    return -1;
  }
  if ( member( ({ "stecken", "holzstecken" }), was) != -1 )
  {
    if ( stecken = present("\nholzstecken",TP) || speer = present("\nwalfangspeer",TP) )
    {
      write( BS(
        "Noch einen Holzstecken brauchst Du nicht. Du willst die Xandim "
        "schliesslich nicht pluendern.") );
      return -1;
    }
    stecken = clone_object(WEAPON "holzstecken");
    if ( ME_TOO_HEAVY == stecken->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Den Stecken kannst Du nicht mehr tragen!\n" );
      stecken -> remove();
      return -1;
    }
    write( BS(
      "Du nimmst den Holzstecken aus dem Gestell. Irgendwie schien es Dir, "
      "als ob gerade dieser noch zu etwas zu gebrauchen waere.") );
    say(
      TPN+" nimmt sich einfach etwas. Was war das bloss?\n" );
    return 1; 
  }
}

int heben(string str)
{
  object lederband;

  notify_fail( "Wo soll der Stein hin?\n" );

  if ( member( ({ "stein in steinkreis","stein in kreis","steinkreis mit stein",
	       	  "kreis mit stein","stein zum kreis","stein zu kreis",
		  "stein zum steinkreis","stein zu steinkreis"
                }), str) != -1 )
  {
   if ( member(stein_plaziert,getuid(TP)) != -1 )
  {
    write(
      "Der Stein ist schon dort, wo er sein sollte.\n" );
    return -1;
  }
    stein_plaziert += ({ getuid(TP) });
    lederband = clone_object(OBJ "lederband");
    if ( ME_TOO_HEAVY == lederband->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Leg mal was ab, damit Du es auch nehmen kannst.\n" );
      lederband -> move(TO,M_NOCHECK|M_SILENT);
      return -1;
    }
    write( BS(
      "Du hebst den Stein wieder in den Kreis hinein. Ordnung muss ja "
      "schliesslich sein! Hoppla, was entdeckst Du denn da, wo gerade der "
      "Stein noch lag? Du steckst es schnell ein. Wer weiss, wozu es noch gut "
      "sein kann?") );
    say(
      TPN+" grinst schelmisch ueber einen geheimen Fund.\n" );
    return 1;
  }
}

int greifen(string str)
{
  object * handschuh;
  object heilehand;
  int i,handschuh_getragen;
  int hand_injured,glove_burned;

  notify_fail( "Wohin willst Du greifen?\n" );

  if ( member( ({ "in feuer","ins feuer","in feuer rein","ins feuer rein",
	      	  "in flamme","in flammen"
                }), str) != -1 )
  {
    handschuh = TP->QueryProp(P_ARMOURS);
    for ( i = sizeof(handschuh); i-->0; )
    {
      if ( handschuh[i]->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE )
      {
        handschuh_getragen = 1;
        break;
      }
    }
    write( BS(
      "Dumm wie Du bist, greifst Du mitten in die Flammen rein, und Du "
      "verbrennst Dich ordentlich dabei.") );
    say( BS(
      TPN+" verbrennt sich furchtbar die Hand.") );
    if ( handschuh_getragen == 1)
    { 
      if ( 50 >= handschuh[i]->QueryMaterialGroup(MATGROUP_INFLAMMABLE) )
      {
        write( BS(
          "Gratuliere! Deiner Hand ist zwar nichts passiert, aber dafuer ist "
          "Dein Handschuh verbrannt. Da Du mit einem auch nichts anfaengt, "
          "schleuderst Du ihn voller Wut in die Flammen.") );
        say(
          TPN+" ist furchtbar sauer.\n" ); 
        handschuh[i] -> remove(1);
        return 1;
      }
      write( BS(
        "Dein Handschuh glueht zwar kurz, aber gluecklicherweise ist nicht "
        "mehr passiert.") );
      SetProp( P_KILL_NAME, "Spiel mit dem Feuer" );
      TP -> do_damage(2+random(5));
      return 1;
    }
    SetProp( P_KILL_NAME, "Spiel mit dem Feuer" );
    TP -> do_damage(7+random(10));
    hand_injured = TP->SetProp(P_TMP_HAND_INJURED,TP->QueryProp(P_TMP_HAND_INJURED)+1);
    switch (hand_injured)
    {
      case 1:
      write( BS(
        "Kleine Brandblasen sind nun auf deiner Hand. Zuoft wuerde ich das an "
        "Deiner Stelle nicht machen.") );
      break;
      case 2:
      write( BS(
        "Die Brandblasen werden schon groesser. Greife besser kein weiteres "
        "Mal hinein! Ich uebernehme dann keine Verantwortung.") );
      break;
      default:
      write( BS(
        "Habe ich Dich nicht ausdruecklich gewarnt! Jetzt hast Du Dir die "
        "Hand total verbrannt. Die sieht nun aus wie ein aufgeganger "
        "Pizzateig.") );
      if ( !heilehand = present("\nheilehand",TP) )
      {
        heilehand = clone_object(OBJ "heilehand");
        heilehand -> move(TP,M_NOCHECK|M_SILENT);
        heilehand -> StartCallOut(TP);
        TP -> SetProp( P_TMP_ATTACK_HOOK, ({ time()+3600, TO,
                       "PreventAttack", hand_injured }) );
      }
      break;
    }
    return 1;
  }
}

int PreventAttack(object enemy)
{
  int hand_injured;
  hand_injured = TP->QueryProp(P_TMP_HAND_INJURED);
  if ( random(10) > 11-hand_injured )
  {
    tell_object( TP,
      BS("Die Verbrennung ist noch so stark, dass Dein Angriff ins Leere "
         "geht.") );
    tell_room( ENV(TP),
      TP->Name(WESSEN)+" Verbrennung hindert "+TP->QueryPronoun(WEN)+
      " daran, einen gezielten Angriff zu fuehren.\n",({ TP }) );
    return 0;
  }
  else return 1;
}

int wuehlen(string str)
{

  object elfenbeinstueck, maus;

  notify_fail( "Wo willst Du wuehlen?\n" );

  if ( member( ({ "in decke","in decken" }), str) != -1 )
  {
    write(
      "Decken siehst Du hier keine, aber dafuer etwas anderes.\n" );
    return -1;
  }
  if ( member( ({ "in felle","in fell","im fell","in fellen" }), str) != -1 )
  {
    write(
      "In welchen Fellen willst Du wuehlen?\n" );
    return 1;
  }
  else if ( member( ({ "in wolfsfell","in wolfsfelle",
		       "im wolfsfell","in wolfsfellen"
                     }), str) != -1 )
  {
    write( BS(
      "Abgesehen davon, dass Dich die Xandim komisch anschauen, bringt Deine "
      "Suche nichts ein.") );
    say(
      TPN+" wuehlt wie ein verspieltes, kleines Kind in den Fellen.\n");
    return -1;
  }
  else if( member( ({ "in eisbaerenfell","in eisbaerenfelle",
		      "im eisbaerenfell","in eisbaerenfellen"
                    }), str) != -1 )
  {
    if ( !present("maus",TO) && member(maus_gehoert,getuid(TP)) != -1 )
    {
      say(
	TPN+" schreckt eine Maus aus ihrem Versteck.\n" );
      maus = clone_object(NPC "schneemaus");
      maus -> move(TO,M_GO);
      maus_gehoert -= ({ getuid(TP) });
      return 1;
    }
    write(
      "Du wuehlst in den Eisbaerenfellen, findest aber dabei nichts.\n" );
    return -1;
  }
  else if( member( ({ "in eisfuchsfell","in eisfuchsfelleeisfuchsfelle",
		      "im eisfuchsfell","in eisfuchsfellen"
                    }), str) != -1 )
  {
    if ( elfenbeinstueck=present("\nelfenbeinstueck",TP) )
    {
      write(
        "Du wuehlst in den Eisfuchsfellen, findest allerdings nichts mehr.\n" );
      return -1;
    }
    elfenbeinstueck = clone_object(OBJ "stueck");
    if ( ME_TOO_HEAVY == elfenbeinstueck->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Das Teil ist Dir im Moment zu schwer.\n" );
      elfenbeinstueck -> move(TO,M_NOCHECK|M_SILENT);
      return -1;
    }
    write(
      "Mitten beim Durchwuehlen der Felle entdeckst Du ein Elfenbeinstueck.\n" );
    say(
      TPN+" hat wohl etwas entdeckt.\n" );     
    return 1;
  }
}