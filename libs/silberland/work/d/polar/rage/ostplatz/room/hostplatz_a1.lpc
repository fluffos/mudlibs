//Osterweiterung des Xandimdorf
// Filename: hostplatz_a1.c
// File by Rage, Februar 00

inherit "std/room";
inherit "d/polar/rage/ostplatz/room/rundgang";

#include "../def.h"
#include <verben.h>
#include <moving.h>
#include <lightsource.h>

int block_verschoben;    //Schneeblock wurde verschoben
int kraft, kraft_vorher; //notwendige Kraft zum Verschieben des Schneeblocks
int block_verschiebbar;  //Schneeblock laesst sich verschieben
object kuehlraum;

void create()
{
  ::create();

  block_verschoben = random(3);
  block_verschiebbar = 0;
  kraft = 15+random(20);
  kuehlraum = 0;

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Du bist ganz im Eck zwischen der Eis- und Holzpalisade. Hinter Dir "
    "ragt die maechtige Eispalisade in die Hoehe und vor Dir wurde ein "
    "nicht weniger imposantes Iglu gebaut, das fast so gross wie ein Troll "
    "ist. Auf dieser Seite ist auch der Eingang zum Iglu, der die Form "
    "eines kurzen Rohransatzes hat. Die Schreie der Kinder sind auch nicht "
    "mehr zu hoeren und sehen tust Du auch keines mehr. Alles in allem ist "
    "es beinahe unnatuerlich ruhig.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -4]) );

//DETAILS
  AddDetail( "boden",
    "Selbstverstaendlich ist der Boden mit Schnee bedeckt. Seltsamerweise "
    "liegt hier keine Neuschneeschicht, denn die gesamte Schneeschicht vor "
    "und neben dem Eingang des Iglus wurde platt gewalzt. Wie dies gemacht "
    "wurde, bleibt Dir ein Raetsel." );
  AddDetail( "schnee",
    "Natuerlich ist der Boden mit Schnee bedeckt, nur ist er weitgehenst "
    "irgendwie platt gewalzt worden. Nur wie das gemacht wurde und weshalb, "
    "bleibt Dir ein Raetsel." );
  AddDetail( "raetsel",
    "Du kennst sehr viele Raetsel und hast schon fast ebenso viele geloest, "
    "doch dieses bleibt Dir trotz anstrengenden Nachdenkens eines." );
  AddDetail( "nachdenken",
    "Du denkst nach, aber es bringt nichts." );
  AddDetail( ({ "neuschneeschicht","schneeschicht" }),
    "Anstelle der Neuschneeschicht gibt es eine plattgewalzte Schneeschicht, "
    "die sehr fest und eben ist. Wie das zustande kam, kannst Du Dir nicht "
    "so recht erklaeren. Ob da sogar Magie im Spiel war?" );
  AddDetail( "magie",
    "Magie ist fast ueberall im Spiel, doch ob es hier auch so war, bleibt "
    "Dir ein Raetsel." );
  AddDetail( "spiel",
    "Es koennte sein, dass Magie beim Erzeugen der plattgewalzten "
    "Schneeschicht im Spiel war. Vielleicht kannst Du das noch herausfinden." );
  AddDetail( "erzeugen",
    "Irgendwie, auf seltsame Weise, wurde der Schnee vor und rund um das Iglu "
    "platt gewalzt." );
  AddDetail( "weise",
    "Seltsame und Dir nicht bekannte." );
  AddDetail( "himmel",
    "Der ist strahlend blau. Nur ein Aquamarin koennte dieses blau noch "
    "uebertreffen." );
  AddDetail( "sonne",
    "Da Du so nahe an der Eispalisade stehst, kannst Du die Sonne nicht "
    "direkt sehen, aber Du weisst, dass sie da ist, denn es ist hell." );
  AddDetail( "aquamarin",
    "Entweder Du hast einen oder Du hast keinen." );
  AddDetail( ({ "eck","ecke" }),
    "In diesem Eck treffen Eis- und Holzpalisade im Nordwesten aufeinander. "
    "Die Sicht in die verschiedenen Himmelsrichtungen wird Dir komplett "
    "genommen, denn im Osten steht das riesige Iglu, westlich und "
    "suedwestlich erhebt sich die gewaltige Eispalisade und im Norden "
    "befindet sich die Holzpalisade." );
  AddDetail( "osten",
    "Genau oestlich von Dir ist ein riesiges Iglu, dass Du nicht uebersehen "
    "kannst." );
  AddDetail( ({ "westen","suedwesten" }),
    "Im Westen und im Suedwesten verlaeuft die gewaltige Eispalisade." );
  AddDetail( "norden",
    "Dort ist die Holzpalisade." );
  AddDetail( "himmelsrichtungen",
    "Es gibt einige Himmelsrichtungen, doch beschreiben werde ich Dir nicht "
    "alle." );
  AddDetail( "sicht",
    "Deine Sicht ist momentan ziemlich eingeschraenkt, nicht zuletzt wegen "
    "der Eis- bzw. Holzpalisade und dem gewaltigen Iglu." );
  AddDetail( "eispalisade",
    "Vor Deinen weit aufgerissenen Augen reicht die Eispalisade scheinbar "
    "bis zum Himmel. Sogar fuer Riesen stellt diese fuenf Meter hohe Palisade "
    "ein Hindernis dar. Die Bauweise entspricht derjenigen von den Iglus, mit "
    "dem Unterschied, dass die Bloecke aus Eis bei weitem groesser sind und "
    "auch nicht so exakt geschnitten sind wie die Igluschneebloecke." );
  AddDetail( "bauweise",
   "Die Bauweise der Eispalisade entspricht derjeniger von Iglus, doch sind "
   "die Bloecke in der Eispalisade groesser und nicht so genau geschnitten "
   "wie die Igluschneebloecke." );
  AddDetail( "eis",
    "Die Eispalisade besteht, wie nicht anders zu erwarten war, aus Eis." );
  AddDetail( "hindernis",
    "Die Eispalisade ist nicht nur fuer Dich ein gewaltiges Hindernis, "
    "sondern auch fuer Riesen." );
  AddSpecialDetail( ({ "schneebloecke","igluschneebloecke" }), "detailIgluschneebloecke" );
  AddSpecialDetail( "ritze", "detailRitze" );
  AddSpecialDetail( ({ "schneeblock","igluschneeblock" }), "detailIgluschneeblock" );
  AddDetail( "meter",
    "Du siehst Dich noch einmal extra genauestens um, um festzustellen, was "
    "alles ein Vielfaches von einem Meter sein koennte, und kommst zu "
    "folgendem Schluss: Die Hoehe des Iglus betraegt etwa drei Meter, wie "
    "auch die Hoehe der Holzpalisade. Die Eispalisade ist fuenf Meter hoch "
    "und der Eingang 1x1 Meter. Du bist ganz stolz auf Dich, dies alles "
    "herausgefunden zu haben." );
  AddDetail( "schluss",
    "Schluss ist noch lange nicht, musst erst sagen, wie alt Du bist." );
  AddDetail( ({ "vielfaches","vielfache" }),
    "Vielfache von einem Meter eben. 2, 3, 4 oder sogar 5 Meter." );
  AddDetail( ({ "riesen","riese" }),
    "Du bist froh darueber, dass Du keinen siehst. Und gleichzeitig fuehlst "
    "Du Dich sicher, weil Du weisst, dass Du Dich im Notfall hinter der "
    "Eispalisade in Sicherheit bringen koenntest." );
  AddSpecialDetail( "notfall", "detailNotfall" );
  AddDetail( "sicherheit",
    "Bei einem Riesenangriff kannst Du Dich ganz gewiss hinter der "
    "Eispalisade in Sicherheit bringen." );
  AddDetail( ({ "angriff","riesenangriff" }),
    "Wo ist einer?" );
  AddDetail( ({ "palisade","palisaden" }),
    "Zwei Palisaden kannst Du ausmachen. Einerseits die Eispalisade im Westen "
    "und Sueden, andererseits die Holzpalisade im Norden." );
  AddDetail( "unterschied",
    "Du siehst Dir die Bloecke in der Eispalisade und im Iglu genauer an und "
    "erkennst, dass der Unterschied darin besteht, dass die "
    "Eispalisadeneisbloecke groeber und groesser sind als die "
    "Igluschneebloecke." );
  AddDetail( ({ "eispalisadeneisbloecke","eispalisadenbloecke",
                "palisadeneisbloecke" }),
    "Die Eisbloecke der Eispalisade sind groeber gehauen als die Schneebloecke vom "
    "Iglu, doch trotzdem gibt es keine Moeglichkeit auf die Palisade zu "
    "klettern, da das Gefaelle zu steil ist." );
  AddDetail( "moeglichkeit",
    "Nein, leider keine." );
  AddDetail( "gefaelle",
    "Die Eispalisade steigt beinahe senkrecht vor Dir in die Hoehe, womit "
    "Du keine Moeglichkeit hast, um nach oben zu klettern." );
  AddDetail( "holzpalisade",
    "Im Vergleich zur Eispalisade wirkt diese mickrig, doch sie erfuellt "
    "ihren Zweck trotzdem sehr gut. Sie besteht aus vielen nebeneinander in "
    "den Boden geschlagenen Baumstaemmen, die mit Seilen auf zwei "
    "unterschiedlichen Hoehen zusaetzlich zusammen gebunden wurden." );
  AddDetail( ({ "baumstaemme","staemme" }),
    "Bei den Baumstaemmen, mit denen die Holzpalisade errichtet wurde, "
    "handelt es sich um Fichtenholz. Sie sind nebeneinander tief in den Boden "
    "geschlagen worden und wurden zusaetzlich mit Seile zusammengebunden." );
  AddDetail( ({ "fichtenholz","holz" }),
    "Die Baumstaemme der Holzpalisade sind aus Fichtenholz." );
  AddDetail( "seile",
    "Auf zwei unterschiedlichen Hoehen wurden starke Seile um die Baumstaemme "
    "der Holzpalisade gewickelt." );
  AddDetail( "vergleich",
    "Die Holzpalisade wirkt im Vergleich zur Eispalisade mickrig, da sie um "
    "gute zwei Meter niedriger ist und bei weitem nicht so stabil erbaut "
    "wurde." );
  AddDetail( ({ "zweck","schutz" }),
    "Der Zweck der Holzpalisade ist sogar Dir klar. Sie soll ein Schutz vor "
    "wilden Tieren sein, die ausserhalb der Palisade leben." );
  AddDetail( ({ "tiere","gezaemhte tiere","wilde tiere" }),
    "Es sind weder wilde, noch gezaehmte Tiere zu sehen." );
  AddDetail( ({ "hoehen","hoehe" }),
    "Das kannst nicht einmal Du leugnen. Die Eispalisade ragt eindeutig "
    "maechtig in die Hoehe. Als Du Dir die Palisade genauer ansiehst, fallen "
    "Dir die unterschiedlichen Hoehen der Palisaden, der Seile an der "
    "Holzpalisade und des Iglus auf." );
  AddDetail( "iglu",
    "Dieses Iglu ist wegen seiner Groesse doch imposant. Das grosse "
    "Kugelsegment hat einen Durchmesser am Boden von 10 Meter und die Hoehe in "
    "der Mitte betraegt circa drei Meter. Eine Unzahl fein saeuberlicher "
    "Schneebloecke wurden nebeneinander gereiht, um dieses Iglu zu bauen. Ein "
    "ein Meter hoher, gleich breiter und doppelt so langer Ansatz ragt aus "
    "dem Iglu heraus und soll wohl der Eingang sein." );
  AddDetail( "bloecke",
    "Meinst Du nun die Eisbloecke der Eispalisade oder die Schneebloecke des "
    "Iglus?" );
  AddDetail( "durchmesser",
    "Der Durchmesser des Iglus am Boden betraegt ungefaehr 10 Meter." );
  AddDetail( "groesse",
    "Sieh Dir das Iglu an, dann weisst Du, was ich meine." );
  AddDetail( "kugelsegment",
    "Das Iglu sieht wie ein Kugelsegment aus." );
  AddDetail( "mitte",
    "Das Iglu hat in der Mitte, also genau am hoechsten Punkt, eine Hoehe "
    "von circa drei Meter." );
  AddDetail( "punkt",
    "Das ist ein Punkt --> . <---." );
  AddDetail( "unzahl",
    "Das gewaltige Iglu wurde aus einer Unzahl von Schneebloecken errichtet. "
    "Nicht einmal Du verspuerst Lust dazu, herauszufinden, wieviele "
    "Schneebloecke hier fuer den Bau des Iglus verwendet wurden." );
  AddDetail( "bau",
    "Der Bau dieses gewaltigen Iglus war sicher sehr aufwendig, vorallem wenn "
    "man die Unzahl an genau ausgeschnittener Schneebloecke bedenkt." );
  AddDetail( "lust",
    "Lust verspuerst Du oft, doch keine dazu, herauszufinden, wieviele "
    "Schneebloecke fuer den Bau des Iglus verwendet wurden." );
  AddDetail( ({ "troll","trolle" }),
       ([ 0: "Das riesige Iglu vor Dir ist beinahe so gross wie ein Troll.",
    "troll": "Irgendwie freut es Dich, dass das Iglu so gross ist. Endlich "
             "kannst Du Deinen Ruecken beim Stehen in einem Gebaeude "
             "durchstrecken. Du machst Dir nur ein paar Sorgen, als Du Dir "
             "den Eingang ansiehst." ]) );
  AddDetail( "gebaeude",
    "Das Iglu, vor dem Du stehst, ist auch ein Gebaeude." );
  AddDetail( "ruecken",
    "Deinem Ruecken geht es heute echt gut." );
  AddDetail( "stehen",
    "Es ist immer angenehm, wenn man aufrecht stehen kann und sich nicht zu "
    "buecken braucht." );
  AddDetail( ({ "sorgen","sorge" }),
       ([ 0: "Du hast ueberhaupt keine Sorgen. Ach, ist das schoen!",
    "troll": "Du machst Dir ein paar Sorgen, wenn Du daran denkst, wie Du "
             "durch diesen Eingang passen sollst." ]) );
  AddDetail( "seite",
    "Auf dieser Seite des Iglus befindet sich der Eingang zum Iglu. Deshalb "
    "konntest Du auf der anderen keinen sehen." );
  AddDetail( ({ "eingang","iglueingang" }),
           ([ 0: "Der Eingang ist 1x1 Meter gross und etwa doppelt so lang. "
                 "Zum Glueck bist Du nicht besonders gross und wirst ohne "
                 "Probleme durchpassen.",
          "elf": "Der Eingang ist 1x1 Meter gross und etwa doppelt so lang. "
                 "Zum Glueck bist Du ziemlich schlank und wirst schon "
	         "irgendwie durchkommen.",
    "dunkelelf": "Der Eingang ist 1x1 Meter gross und etwa doppelt so lang. "
                 "Zum Glueck bist Du sehr gelenkig und wirst ohne Probleme "
	         "durchkommen",
       "mensch": "Der Eingang ist 1x1 Meter gross und etwa doppelt so lang. "
                 "Zum Glueck bist Du nicht besonders breit, womit Du Dich "
	         "sicher durchrobben kannst.",
        "troll": "Der Eingang ist 1x1 Meter gross und etwa doppelt so lang. "
                 "Du machst Dir ernsthafte Gedanken darueber, wie Du da "
 	         "durchkommen sollst und das, wo Du sonst kaum nachdenkst.",
         "oger": "Der Eingang ist 1x1 Meter gross und etwa doppelt so lang. "
                 "Du machst Dir ernsthafte Gedanken darueber, wie Du da "
                 "durchkommst, aber es wird schon irgendwie klappen." ]) );
  AddDetail( ({ "gedanken","gedanke" }),
    "Deine Gedanken sind unergruendbar." );
  AddDetail( "glueck",
    "Hin und wieder hast Du ja doch Glueck." );
  AddDetail( ({ "form","form in raum" }),
    "Die Form des Einganges erinnert Dich an ein Rohr, aber wenn es Du Dir "
    "recht ueberlegst, dann doch mehr an ein Fenster mit einem Bogen "
    "darueber. Nur eben wie ein Rohr in die Laenge gezogen." );
  AddDetail( "laenge",
    "Die Laenge des rohrfoermigen Eingangs ist doppelt so lang, wie der "
    "Eingang breit bzw. hoch ist." );
  AddDetail( "fenster",
    "Bist Du noch zu retten? Im Iglu sind keine Fenster, da waere es ja dann "
    "viel zu kalt. Du hast vielleicht merkwuerdige Ansichten!" );
  AddDetail( ({ "ansichten","ansicht" }),
    "Deine Ansichten sind mehr als merkwuerdig, aber das ist ja Deine Sache." );
  AddDetail( ({ "sache","sachen" }),
    "Deine Sachen gehen mich nichts an und Du kuemmer Dich auch besser um "
    "Deine eigenen." );
  AddDetail( ({ "ansatz","rohransatz","rohr" }),
    "Beim ersten Anblick dachtest Du, der Eingang sieht einem Rohransatz "
    "aehnlich, der aus dem Iglu ragt, doch dann vergleichst Du ihn mit "
    "einem Tuerbogen, der eben breiter als die ueblichen Boegen ist." );
  AddDetail( "anblick",
    "Der erste Anblick kann Dich oft taeuschen, aber oft sollte man sich doch "
    "darauf verlassen." );
  AddDetail( "boegen",
    "Du wolltest eigentlich nur den Eingang mit den ueblichen Boegen "
    "vergleichen, die Du bisher gesehen hast, doch kannst Du nicht sagen, "
    "ob er mehr einem Tuerbogen oder doch eher einem Torbogen gleicht." );
  AddDetail( ({ "bogen","tuerbogen","torbogen" }),
    "Dir ist nur eingefallen, dass man den Eingang des Iglus mit einem "
    "Tuerbogen vergleichen kann. Natuerlich kannst Du ihn genauso gut mit "
    "einem Torbogen vergleichen. Die Bogengroesse liegt irgendwo zwischen "
    "diesen beiden. Ausserdem wird Dir erst jetzt die kleine Tafel bewusst, "
    "die genau ueber dem Eingang in den Rohransatz geschlagen wurde." );
  AddDetail( ({ "holztafel","tafel" }),
    "Eine huebsche, kleine Holztafel, auf der etwas geschrieben steht." );
  AddReadDetail( ({ "holztafel","tafel" }),
    "     +--------------------------------+\n"
    "     |     Wichtige Experimente!      |\n"
    "     |  Aus Sicherheitsgruenden ist   |\n"
    "     |  das Betreten des Iglus nicht  |\n"
    "     |  gestattet!                    |\n"
    "     +--------------------------------+\n" );
  AddDetail( "bogengroesse",
    "Die Bogengroesse des Eingangs liegt irgendwo zwischen der Groesse eines "
    "Tuerbogens und der eines Torbogens. Eines ist klar: groessere Rassen "
    "wie Menschen, Dunkelelfen, Elfen, Trolle und Oger koennten Probleme "
    "haben, wenn sie das Iglu betreten wollen." );
  AddDetail( ({ "rassen","menschen","dunkelelfen","elfen","trolle","oger" }),
    "Rassen wie Menschen, Dunkelelfen, Elfen, Trolle und Oger koennten einige "
    "Probleme bekommen, wenn sie in das Iglu wollen, denn der Eingang sieht "
    "nicht gerade besonders gross aus." );
  AddDetail( "probleme",
        ([ 0: "Du koenntest schon ein paar Probleme haben, wenn Du das Iglu "
              "betreten willst.",
    "hobbit": "Du hast sicher keine, wenn Du in das Iglu willst.",
     "zwerg": "Du hast sicher keine, wenn Du in das Iglu willst.",
       "fee": "Du hast sicher keine, wenn Du in das Iglu willst." ]) );    
  AddDetail( ({ "kinder","xandimkinder" }),
    "Seltsamerweise sind hier keine Kinder zu sehen, wo doch so viele auf "
    "dem ganzen Ostplatz herumlaufen." );
  AddDetail( "ostplatz",
    "Du bist gerade auf einem etwas abgelegenen Winkel des Ostplatzes. Vom "
    "ueblichen Treiben ist nichts zu sehen." );
  AddDetail( "winkel",
    "Du stehst in einem abgelegenen Winkel des Ostplatzes. Es kommt selten "
    "jemand vorbei, ausser ein paar neugierigen Spielern, wie Du einer bist. "
    "Eigentlich kommt Dir erst jetzt in den Sinn, dass es auch hier ein "
    "paar andere Winkel gibt, wie den Winkel zwischen Eis- und Holzpalisade "
    "oder die Winkel zwischen Iglueingang und dem eigentlichen Iglu." );
  AddDetail( "sinn",
    "Dir kommt vieles in den Sinn, doch derzeit nur, dass es in dieser Ecke "
    "noch andere Winkel gibt." );
  AddGenderDetail( ({ "spieler","spielerin" }),
    "Du bist ein neugieriger Spieler.\n",
    "Du bist eine neugierige Spielerin.\n" );
  AddDetail( "treiben",
    "Von Treiben kann man nicht gerade reden, denn es ist momentan ueberhaupt "
    "nichts los. Ganz schoen fade. *schnief*" );
  AddDetail( ({ "lunge","lungen" }),
    "Also wie bitte schoen willst Du die sehen?" );
  AddDetail( "nase",
    "Du fasst Dir an die Nase und merkst, dass sie ziemlich kalt ist." );
  AddDetail( "baeume",
    "Baeume siehst Du mitten in Yiqanuc keine, sondern nur deren Staemme." );
  AddDetail( "yiqanuc",
    "Du stehst derzeit am Ostplatz von Yiqanuc." );
  AddDetail( ({ "geruch","winterluft","luft","geruch","faeulnisgeruch" }),
    "Daran riechen waere wahrscheinlich schlauer." );
  AddDetail( "gesamtheit",
    "Die Gesamtheit der Igluschneebloecke stellt ein Iglu fuer Dich dar." );
  AddDetail( ({ "schreie","rohransatzes","seilen","tieren","nachdenkens",
                "iglus","baumstaemmen","augen","einganges","eingangs",
                "schneebloecken","ostplatzes","torbogens","tuerbogens","spielern" }),
    "Das kannst Du nicht untersuchen." );

  AddSound( DEFAULT_SOUND,
    "Es ist ausnahmsweise komplett ruhig." );
  AddSound( ({ "schreie","schrei","kinder" }),
    "Die Schreie der Kinder sind nicht mehr zu hoeren, was Du als ziemlich "
    "angenehm empfindest." );

  AddSmell( DEFAULT_SMELL,
    "Die frische Winterluft tut Deinen Lungen so richtig gut. Du atmest ganz "
    "kraeftig ein *mmmmmmmmmmh* und total entspannt aus *aaaaaaaaaaaaah*." );
  AddSmell( ({ "winterluft","luft" }),
    "Sie beisst zwar in der Nase, riecht aber gut und gesund." );
//END DETAILS

  AddExit( "osten", "./ostplatz_a1" );

  AddCmd( ({ "zaehl","zaehle" }), "cmd_zaehlen" );
  AddCmd( ({ "kuemmer","kuemmere" }), "cmd_kuemmern" );
  AddCmd( CMD_KLETTERN , "cmd_klettern" );
  AddCmd( ({ "schieb","schiebe","drueck","druecke","stoss",
             "stosse","ramm","ramme" }), "cmd_schieben" );
  AddCmd( ({ "waerm","waerme","erwaerm","erwaerme",
             "schmelz","schmelze" }), "cmd_waermen" );
  AddCmd( ({ "reib","reibe" }), "cmd_reiben" );
}
//SPECIAL DETAILS
string detailIgluschneeblock()
{
  if ( block_verschoben )
  {
    return BS(
      "Jeder Schneeblock des Iglus scheint genau so auszusehen wie jeder "
      "andere. Zumindest kommt es Dir so vor." );
  }
  return BS(
    "Du kannst es kaum glauben, aber ein Schneeblock steht tatsaechlich ein "
    "klein wenig hervor. Wie das wohl passieren konnte?" );
}

string detailRitze()
{
  if ( block_verschoben )
  {
    return BS(
      "Sowas siehst Du da nicht!" );
  }
  return BS(
    "Als Du Dir die Ritze genauer unter die Lupe nimmst, bemerkst Du, dass "
    "ein Schneeblock ein klein wenig weiter hervorsteht als die anderen." );
}

string detailIgluschneebloecke()
{
  if ( block_verschoben )
  {
    return BS(
      "Die Igluschneebloecke sind exakt geschnitten und fein saeuberlich "
      "nebeneinander gereiht und aufeinandergeschichtet und in ihrer "
      "Gesamtheit stellen sie ein Iglu dar." );
  }
  return BS(
    "Die Igluschneebloecke sind exakt geschnitten und fein saeuberlich "
    "nebeneinander gereiht und aufeinandergeschichtet und in ihrer "
    "Gesamtheit stellen sie ein Iglu dar. Kann das sein? Ist da tatsaechlich "
    "eine Ritze zwischen zwei Schneebloecken?" );
}

string detailNotfall()
{
  object drang;

  if ( !present("\nharndrang", TP) )
  {
    drang = clone_object( OBJ "harndrang" );
    drang -> move( TP, M_SILENT|M_NOCHECK );
    write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
      CAP(getuid(TP))+" muss dringend aufs Klo.\n");
    return BS(
      "Du hast eher einen anderen Notfall. Du muesstest schon mal ganz "
      "dringend auf die Toilette." );
  }
  return BS(
    "Oja, Du hast schon einen ganz schlimmen Notfall, wenn Du nicht "
    "bald auf die Toilette kommst, wird es zu spaet sein." );
}
//END SPECIAL DETAILS
//COMMANDS
int cmd_zaehlen(string str)
{
  notify_fail( "Was moechtest Du bitte zaehlen?\n" );

  if ( member( ({ "igluschneebloecke","schneebloecke" }),str) != -1 )
  {
    write( BS(
      "Da Du Dich nicht entscheiden kannst, wo Du mit dem Zaehlen der "
      "Schneebloecke anfangen sollst, laesst Du es doch gleich bleiben. Du "
      "wirst schon nichts versaeumen, wenn Du die genaue Anzahl der "
      "Schneebloecke nicht kennst.") );
    say(
      TPN+" steht ein wenig unschluessig vor dem Iglu herum.\n" );
    write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
      CAP(getuid(TP))+" zaehlt die Schneebloecke.\n");
    return 1;
  }
}

int cmd_kuemmern(string str)
{
  notify_fail( "Worum willst Du Dich kuemmern?\n" );

  if ( member( ({ "dich um eigene sachen","um eigene sachen",
                  "dich um eigene sache","um eigene sache",
                  "dich um eigene angelegenheiten",
                  "um eigene angelegenheiten"
                }),str) != -1 )
  {
    write( BS(
      "Da Du der Meinung bist, dass es doch besser ist, Dich um Deine "
      "eigenen Sachen zu kuemmern, machst Du Dich gleich mal dran, Dein "
      "Seherhaus aufzuraeumen.") );
    say(
      TPN+" muss sich wohl kurz um etwas anderes kuemmern.\n" );
    TP -> move("/d/polar/rage/ostplatz/room/ostplatz_a1", M_GO, "nach Osten");
    write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
      CAP(getuid(TP))+" kuemmert sich um eigene Sachen.\n");
    return 1;
  }
}

int cmd_klettern(string str)
{
  object pickel, steigeisen;

  pickel = present("pickel", TP);
  steigeisen = present("steigeisen", TP);
  
  notify_fail( "Wohin oder auf was moechtest Du klettern?\n" );

  if ( member( ({ "auf eispalisade","eispalisade",
                  "auf eispalisade rauf"
                }),str) != -1 )
  {
    if ( pickel && steigeisen )
    {
      if ( pickel->QueryProp(P_WIELDED) && steigeisen->QueryProp(P_WORN) )
      {
      	write( BS(
      	  "Mit dem Pickel in der Hand und den Steigeisen auf Deinen Fuessen "
      	  "kletterst Du stark keuchend, aber mit Erfolg, auf die "
      	  "Eispalisade.") );
      	TP -> move("/d/polar/thor/xandim/room/wachweg13", M_GO,
      	           "vor Anstrengung keuchend auf die Eispalisade",
      	           "klettert",
      	           "klettert ueber die Eispalisade auf den Wachweg" );
      	write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
          CAP(getuid(TP))+" klettert auf Eispalisade.\n");
      	return 1;
      }
      else if ( pickel->QueryProp(P_WIELDED) && 
                !steigeisen->QueryProp(P_WORN) )
      {
      	write( BS(
          "Voller Zuversicht schlaegst Du den Pickel ins Eis und beginnst "
          "loszuklettern. Leider hast Du aber nicht die Steigeisen angezogen, "
          "wodurch Deine Kraefte recht bald nachlassen und Du runterrutschst. "
          "Leider schuerfst Du Dich dabei leicht auf.") );
        SetProp( P_KILL_NAME, "Ein unangenehmer Kratzer" );
        TP -> do_damage(4+random(10));
        return -1;
      }
      else if ( !pickel->QueryProp(P_WIELDED) &&
                steigeisen->QueryProp(P_WORN) )
      {
        write( BS(
          "Voller Zuversicht rammst Du Deine Steigeisen fest ins Eis und "
          "beginnst loszuklettern. Leider hast Du vergessen, Deinen Pickel zu "
          "zuecken, weshalb Du keinen Halt hast und so nach hinten "
          "ueber- und brutal auf dem Boden aufschlaegst.") );
        SetProp( P_KILL_NAME, "Ein dummer Aufschlag" );
        TP -> do_damage(10+random(20));
        return -1;
      }
      write( BS(
        "Du rutschst gleich am Anfang am Eis der Palisade aus. Du hast zwar "
        "alles dabei, das Du zum Klettern brauchst, doch hast Du weder den "
        "Pickel gezueckt noch die Steigeisen angezogen.") );
      return -1;
    }
    else if ( pickel )
    {
      if ( pickel -> QueryProp(P_WIELDED) )
      {
        write( BS(
          "Voller Zuversicht schlaegst Du den Pickel ins Eis und beginnst "
          "loszuklettern. Leider rutschst Du dennoch mit den Fuessen immer "
          "weg, wodurch Deine Kraefte recht bald nachlassen und Du "
          "runterrutschst. Leider schuerfst Du Dich dabei leicht auf.") );
        SetProp( P_KILL_NAME, "Ein unangenehmer Kratzer" );
        TP -> do_damage(4+random(10));
        return -1;
      }
      write( BS(
        "Du kommst keinen Zentimeter auf die Eispalisade rauf, denn nur den "
        "Pickel zu haben und nicht zu zuecken, hilft Dir nicht weiter.") );
      return -1;
    }
    else if ( steigeisen )
    {
      if ( steigeisen -> QueryProp(P_WORN) )
      {
        write( BS(
          "Voller Zuversicht rammst Du Deine Steigeisen fest ins Eis und "
          "beginnst loszuklettern. Leider hast Du mit Deinen Haenden "
          "ueberhaupt keinen Halt, wodurch Du bald nach hinten ueber- "
          "und brutal auf dem Boden aufschlaegst.") );
        SetProp( P_KILL_NAME, "Ein dummer Aufschlag" );
        TP -> do_damage(10+random(20));
        return -1;
      }
      write( BS(
        "Du kommst keinen Zentimeter auf die Eispalisade rauf, denn nur die "
        "Steigeisen zu haben und nicht zu tragen, hilft Dir nicht weiter.") );
      return -1;
    }
    if ( present("seil",TP) )
    {
      write( BS(
        "Du versuchst loszuklettern, kommst aber keinen Meter weit. Ein Seil "
        "beim Klettern dabei zu haben, ist keine schlechte Idee, doch bei der "
        "Eispalisade wird es Dir nicht weiterhelfen koennen. Du wirst eine "
        "Ausruestung brauchen, die sich besser fuer Eis eignet.") );
      return -1;
    }
    write( BS(
      "Dein Kletterversuch scheitert klaeglich, denn das Eis ist so glatt, "
      "dass Du nicht einmal vom Boden wegkommst.") );
    return -1;
  }
}

int cmd_schieben(string str)
{
  notify_fail( "Was genau wuerdest Du gern machen?\n" );

  if ( member( ({ "schneeblock","igluschneeblock" }),str) != -1 )
  {
    if ( block_verschoben )
    {
      write(
        "Es gibt keinen Schneeblock, den Du irgendwie verschieben koenntest.\n" );
      return -1;
    }
    write( BS(
      "Ok, Du willst den Schneeblock verschieben, das ist schon mal ein guter "
      "Ansatz, aber vielleicht koenntest Du noch irgendeine Art von "
      "Richtungsangabe hinzufuegen.") );
    return -1;
  }
  if ( member( ({ "schneeblock rein","schneeblock zurueck",
                  "schneeblock hinein","schneeblock an",
                  "îgluschneeblock rein","igluschneeblock zurueck",
                  "iglusschneeblock hinein","igluschneeblock an"
                }),str) != -1 )
  {
    if ( block_verschoben )
    {
      write(
        "Es gibt keinen Schneeblock, den Du irgendwie verschieben koenntest.\n" );
      return -1;
    }
    if ( TP->QueryAttribute(A_STR) < kraft )
    {
      write( BS(
        "Du bist leider zu schwach, um den Schneeblock hineinzudruecken. "
        "Probier es entweder ein wenig kraftvoller oder denk Dir ein "
        "Hilfsmittel aus.") );
      return -1;
    }
    write( BS(
      "Du spannst Deine Muskeln bis zum Zerbersten an, bis sich der Schneeblock "
      "auch nur ein Stueck ruehrt... doch als Du dich so richtig noch einmal "
      "dagegen stemmen willst, gibt der Schneeblock endlich nach, und er rutscht "
      "schliesslich ganz leicht, sich in das Gefuege der anderen Bloecke "
      "anpassend, hinein.") );
    say( BS(
      TPN+" stemmt sich gegen das Iglu, als ob "+TP->QueryPronoun(WER)+" das "
      "ganze Iglu umwerfen wolle. "+(TP->QueryProp(P_GENDER)==FEMALE?"Ihr":
      "Sein")+" Kopf laeuft schon ganz rot an und scheint in jedem Moment "
      "zu platzen, doch dann blickt "+TP->QueryPronoun(WER)+" zufrieden "
      "drein, als ob "+TP->QueryPronoun(WEM)+" eine schwere Last genommen "
      "worden waere.") );
    write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
      CAP(getuid(TP))+" hat den Schneeblock verschoben.\n");
    block_verschoben = 1;
    return 1;
  }  
}

int cmd_waermen(string str)
{
  object fackel;

  fackel = present("fackel",TP);
  notify_fail( "Welches Herz willst Du zum Schmelzen bringen?\n" );

  if ( member( ({ "schneeblock","igluschneeblock" }),str) != -1 )
  {
    if ( fackel )
    {
      if ( fackel->QueryProp(P_LIGHTED) )
      {
      	if ( block_verschoben )
      	{
      	  write(
      	    "Du findest keinen Schneeblock an, bei dem es sich lohnen wuerde, "
      	    "ihn zu erwaermen.\n" );
      	  return -1;
      	}
      	if ( block_verschiebbar )
      	{
      	  write( BS(
      	    "Du brauchst den Schneeblock nicht mehr weiter zu erwaermen, denn "
      	    "das wurde bereits gemacht, und er muesste sich jetzt leichter "
      	    "verschieben lassen.") );
      	  return -1;
      	}
        write( BS(
          "Du stellst Dich mit Deiner angezuendeten Fackel neben den Schneeblock "
          "und faehrst damit ganz langsam dreimal zwischen Block und Iglu "
          "herum, bis Du meinst, dass der Schneeblock sich nun leichter "
          "bewegen muesste.") );
        say( BS(
          TPN+" bewegt eine brennende Fackel vor dem Iglu auf und ab. Ob "+
          TP->QueryPronoun(WER)+" das Iglu zum Schmelzen bringen will?") );
        kraft_vorher = kraft;
        kraft = 10+random(10);
        block_verschiebbar = 1;
        kuehlraum = ENV(TP);
        if ( find_call_out("erwaermt") == -1 )
          call_out ("erwaermt", 14);
        write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
          CAP(getuid(TP))+" erwaermt den Schneeblock.\n");
        return 1;
      }
      write( BS(
        "Es ist zwar gut, dass Du eine Fackel dabei hast, aber anzuenden "
        "waere auch keine bloede Idee.") );
      return -1;
    }
    write( BS(
      "Du hast keine Fackel dabei, um den Schneeblock zu erwaermen, aber "
      "es gibt ja auch Reibungswaerme zur Not.") );
    return -1;
  }
}
void erwaermt()
{
  tell_room( kuehlraum,
    "Der Schneeblock kuehlt wieder komplett aus.\n", ({ TP }) );
  kraft = kraft_vorher;
  block_verschiebbar = 0;
  if ( !objectp(TP) ) return;
  if ( ENV(TP) == kuehlraum )
  {
    write(
      "Der Schneeblock kuehlt wieder komplett aus.\n" );
    kuehlraum = 0;
  }
  else
    return;
}

int cmd_reiben(string str)
{
  if ( member( ({ "schneeblock","igluschneeblock" }),str) != -1 )
  {
    if ( block_verschoben )
    {
      write( BS(
        "Du reibst zwar eifrig mit Deiner Hand am Iglu herum, doch Sinn "
        "macht das ueberhaupt keinen, weshalb Du es auch gleich wieder "
        "bleiben laesst.") );
      say( BS(
        TPN+" reibt wie "+(TP->QueryProp(P_GENDER)==FEMALE?"eine Verrueckte":
        "ein Verrueckter")+" mit "+TP->QueryPossPronoun(FEMALE,WEM,PLURAL)+
        " Haenden am Iglu herum, weil "+TP->QueryPronoun(WER)+" wohl meint, "
        "damit das Iglu zum Schmelzen zu bringen.") );
      return -1;
    }
    if ( block_verschiebbar )
    {
      write( BS(
        "Du brauchst den Schneeblock nicht mehr weiter zu erwaermen, denn "
      	"das wurde bereits gemacht, und er muesste sich jetzt leichter "
      	"verschieben lassen.") );
      return -1;
    }
    if ( !random(5) )
    {
      write( BS(
        "Du reibst wie verrueckt am Schneeblock und meinst, dass der Block "
        "leicht nachgegeben hat. Du solltest ihn jetzt schnell reinschieben, "
        "bevor die Wirkung nachlaesst.") );
      say( BS(
        TPN+" reibt eifrig mit "+TP->QueryPossPronoun(FEMALE,WEM,PLURAL)+
        " Haenden am Iglu herum und scheint mit der Arbeit zufrieden zu "
        "sein.") );
      kraft_vorher = kraft;
      kraft = 10+random(10);
      block_verschiebbar = 1;
      kuehlraum = ENV(TP);
      if ( find_call_out("erwaermt") == -1 )
        call_out ("erwaermt", 10);
      write_file("/d/polar/rage/ostplatz/log/forsch.log",ctime()+": "+
        CAP(getuid(TP))+" reibt am Schneeblock.\n");
      return 1;
    }
    write( BS(
      "Du reibst zwar wie verrueckt am Schneeblock herum, doch Du kannst leider "
      "nicht genuegend Reibungswaerme erzeugen, um den Block irgendwie "
      "leichter zu verschieben.") );
    say( BS(
      TPN+" reibt wie "+(TP->QueryProp(P_GENDER)==FEMALE?"eine Verrueckte":
      "ein Verrueckter")+" mit "+TP->QueryPossPronoun(FEMALE,WEM,PLURAL)+
      " Haenden am Iglu herum, weil "+TP->QueryPronoun(WER)+" wohl meint, "
      "damit das Iglu zum Schmelzen zu bringen.") );
    return -1;
  } 
}
//END COMMANDS
//RESET
void reset()
{
  ::reset();

  block_verschoben = random(3);
  kraft = 15+random(20); 
}
//END RESET
