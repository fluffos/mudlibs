// Osterweiterung des Xandimdorf
// Filename: wachturm.c
// File by Rage, Februar 00

inherit "std/room";

#include "../def.h"
#include <moving.h>
#include <verben.h>
#include <wizlevels.h>

int besen_da, schnee_da;
int holzbrett_locker;
nosave string *Lippen_geschuerzt; //Spieler hat Lippen geschuerzt
string kalteLuft(string key);
mapping entdecker;
object wache;
int bewacht;

void create()
{
  ::create();

  besen_da = random(2);
  schnee_da = 1;
  holzbrett_locker = random(2);
  Lippen_geschuerzt = ({});
  entdecker = ([]);
  bewacht = 0;
  
  SetProp( P_INT_SHORT, "Auf dem Wachturm" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -10]) );
  SetProp( P_NO_TPORT, NO_TPORT_OUT );
  SetProp( P_NOQUIT, 1);

//DETAILS
  AddDetail( "boden",
    "Du stehst auf einer nicht aufregenden Plattform aus Holz. Mehrere "
    "Holzbretter wurden aneinander gelegt, festgenagelt und bieten Dir damit "
    "einen festen Stand in dieser lueftigen Hoehe." );
  AddDetail( "hoehe",
    "Bist Du auch noch ganz auf der Hoehe bei dieser luftigen Hoehe? Immerhin "
    "bist ja schon etwa drei Meter ueber dem Erdboden." );
  AddDetail( ({ "holz","fichtenholz" }),
    "Da die Plattform aus Holzbretter besteht, ist es klar, dass sie aus Holz "
    "bestehen muss. Es ist auch nicht irgendein Holz, sondern Fichtenholz." );
  AddSpecialDetail( ({ "holzbretter","bretter" }), "detailHolzbretter" );
  AddSpecialDetail( ({ "holzbrett","brett" }), "detailHolzbrett" );
  AddSpecialDetail( "naegel", "detailNaegel" );
  AddDetail( "stand",
    "Du bist sehr beruhigt, dass Du auf der Plattform einen festen Stand hast. "
    "Solange Du Dich nicht auf das Gelaender setzt oder Dich weit darueber "
    "beugst, faellst Du auch ganz bestimmt nicht runter." );
  AddDetail( "himmel",
    "Jetzt hast Du mal einen schoenen Ausblick auf den gesamten Himmel. Er ist "
    "maerchenhaft blau, die Sonne scheint, nur weit im Norden kannst Du ein "
    "paar Wolken ausmachen." );
  AddDetail( "sonne",
    "Nicht zu sehen, und trotzdem ist es hell. Wie geht denn das schon wieder? "
    "Hier muss sich wohl wer mit der Magie gespielt haben." );
  AddDetail( "magie",
    "Dass man die Sonne nicht sehen kann, hat ueberhaupt nichts mit Magie zu "
    "tun. Das Dach ist Dir im Weg und durch das kannst ja ganz schwer "
    "durchschauen." );
  AddDetail( "wolken",
    "Sehr weit im Norden, ueber einer Huegelkette machst Du ein paar Wolken "
    "aus. Es sieht so aus, als ob sie von hinter der Huegelkette heraufziehen "
    "wuerden." );
  AddDetail( "norden",
    "Du stellst Dich ans Gelaender und blickst nach Norden. Innerhalb von der "
    "Holzpalisade siehst Du die weite Koppel mit den Rentieren und dahinter nur "
    "oedes, schneebedecktes Flachland. In mehr als zwei oder drei Kilometer "
    "Entfernung erkennst Du eine Huegelkette und ueber dieser ziehen ein paar "
    "Wolken herauf." );
  AddDetail( "entfernung",
    "In einiger Entfernung siehst Du im Norden eine Huegelkette, ueber der sich "
    "ein paar Wolken zu tuermen beginnen." );
  AddDetail( "holzpalisade",
    "Wie Dir schon laengst aufgefallen ist, aber was Du von hier oben nun "
    "endgueltig sehen kannst, ist der Ostplatz von einer Holzpalisade "
    "umgeben." );
  AddDetail( ({ "rentiere","rentier" }),
    "Die Rentiere befinden sich auf der Koppel noerdlich von Dir." );
  AddDetail( "koppel",
    "Auf der Koppel bewegen sich einige Rentiere, die Du Dir sicher besser "
    "ansehen kannst, wenn Du naeher an ihnen herangehst." );
  AddDetail( "flachland",
    "Direkt hinter der Holzpalisade ist in allen Himmelsrichtungen oedes, "
    "schneebedecktes Flachland. Was kann einen nur bewegen, sich hier "
    "umzusehen?" );
  AddDetail( ({ "kilometer","huegelkette" }),
    "Die Huegelkette im Norden ist mehr als einen Kilometer von Yiqanuc "
    "entfernt. Darueber erkennst Du die einzigen Wolken weit und breit." );
  AddDetail( ({ "xandimdorf","yiqanuc" }),
    "Du bist nachwievor im Xandimdorf, oder, um genau zu sein, auf dem "
    "Ostplatz davon." );
  AddDetail( "osten",
    "Der Blick nach Osten bietet Dir wohl eine der langweiligsten Landschaften, "
    "die Du bisher gesehen hast. Du fragst Dich ernsthaft, wieso die Xandim "
    "ueberhaupt ein Tor haben, dass sich in diese Richtung oeffnet. Weiss, "
    "weiss und nochmals weiss. Du bist von dem vielen Schnee sogar fuer kurze "
    "Zeit geblendet. Weit weg scheint sich das weiss in ein sich bewegendes "
    "Grau zu aendern. Was das wohl sein kann?" );
  AddDetail( "blick",
    "Du wirst doch sicher schon wissen, was Du mit Deinen Augen zu tun hast." );
  AddDetail( ({ "auge","augen" }),
    "Mit denen kannst Du untersuchen, schauen, blicken, starren, ... aber "
    "weiter helfe ich Dir jetzt nicht mehr." );
  AddDetail( ({ "landschaft","landschaften" }),
    "Die Landschaft ausserhalb der Holzpalisade ist sehr monoton. Weiss, weiss "
    "und nochmals weiss. Ob Du jemals durch das Tor in der Holzpalisade "
    "schreiten wirst, wagst Du bei der Eintoenigkeit zu bezweifeln." );
  AddDetail( "eintoenigkeit",
    "Die Landschaft rund um Yiqanuc schaut auf den ersten Blick ziemlich "
    "eintoenig aus." );
  AddDetail( "zeit",
    "Du warst nur fuer eine kurze Zeit geblendet. Du siehst bereits wieder "
    "einwandfrei." );
  AddDetail( "grau",
    "Du siehst Dir das sich bewegende Grau genauer an und raetselst darueber, "
    "was es sein koennte. Eigentlich kommt bei der Groesse des ganzen nur ein "
    "Schneesturm in Frage. Hoffentlich bleibt der auch dort, wo er jetzt ist." );
  AddDetail( "groesse",
    "Du bist zwar auch eine echte Groesse, doch an die Groesse des Schneesturms "
    "kommst auch Du nicht ran." );
  AddDetail( ({ "frage","fragen" }),
    "Fragen ueber Fragen. Wer wird sie alle beantworten koennen?" );
  AddDetail( ({ "schneesturm","sturm" }),
    "Viel weiter im Osten braut sich ein maechtiger Schneesturm zusammen." );
  AddSpecialDetail( "schnee","detailSchnee" );
  AddSpecialDetail( ({ "haeufchen","schneehaeufchen" }),
                       "detailSchneehaeufchen" );
  AddDetail( "tor",
    "Ein Tor in der Holzpalisade trennt Dich von den grenzenlosen Weiten im "
    "Polargebiet. Ausserdem koennte der Balken, der quer ueber das Tor liegt, "
    "Dich auch daran hindern, durch dieses Tor zu schreiten." );
  AddDetail( "balken",
    "Scheinbar schwebend liegt ein Balken quer ueber das Tor, der dieses somit "
    "versperrt." );
  AddDetail( ({ "polargebiet","polar" }),
    "Was glaubst Du, wird Dich im Polargebiet erwarten? Es wird kalt sein, "
    "Schnee wird es geben, und ausserdem blaest meist ein kuehler Wind." );
  AddDetail( "weiten",
    "Ausserhalb der Holzpalisade sind die Weiten des Polargebiets. Schau in "
    "die verschiedenen Richtungen, dann erfaehrst Du sicher mehr ueber diese "
    "Weiten." );
  AddDetail( "xandim",
    "Viele von ihnen siehst Du am Ostplatz. Irgendwie gefallen sie Dir mit "
    "ihren langen, wuschligen -und sich auf total weichen- Fellen." );
  AddDetail( ({ "fell","felle" }),
    "Die Xandim tragen ein langes, wuschliges Fell." );
  AddDetail( ({ "ostplatz","platz" }),
    "Unter Dir im Westen breitet sich der Ostplatz aus, auf dem ein reges "
    "Treiben herrscht." );
  AddDetail( "sueden",
    "Nach Sueden bietet sich Dir ein ebenso interessantes Bild wie nach Osten. "
    "Eine endlos weite, breite, grosse Ebene, die mit Schnee bedeckt ist. "
    "Beinahe am Horizont verschwindend siehst Du eine gewaltige Bergkette." );
  AddDetail( "bild",
    "Ich rede vom Bild der Landschaft und nicht von einem gemalten. Dieses "
    "zeigt Dir eine endlos weite, breite, grosse Ebene, die mit Schnee bedeckt "
    "ist. Gluecklicherweise taucht in dem Bild auch eine gewaltige "
    "Bergkette auf, was das ganze schon wieder interessant erscheinen laesst." );
  AddDetail( ({ "bergkette","horizont" }),
    "Am suedlichen Horizont machst Du eine gewaltige Bergkette aus, die sich "
    "fast ueber den ganzen Horizont spannt. Genaueres kannst Du von hier aus "
    "leider nicht erkennen." );
  AddDetail( "ebene",
    "Das Xandimdorf wurde mitten in diese weite Ebene gebaut. Dass man hier "
    "nicht frueher oder spaeter zum Durchdrehen beginnt, ist wahrlich ein "
    "Wunder." );
  AddDetail( "wunder",
    "Ja, Wunder gibt es. Vielleicht wiederfaehrt Dir auch eines." );
  AddDetail( "durchdrehen",
    "Ist es bei Dir schon so weit?" );
  AddDetail( "westen",
    "In diese Richtung hast Du einen guten Ueberblick ueber den Ostplatz. "
    "Xandim gehen auf dem Pfad auf und ab, suedlich von Dir scheint eine "
    "kleine Versammlung zu sein, Kinder laufen ueberall vergnuegt herum, die "
    "Schlittenhunde koennen sich auch frei bewegen und die Laeden sind gut "
    "besucht." );
  AddDetail( ({ "schlittenhund","schlittenhunde" }),
    "Zwischen den ganzen Xandim bewegen sich auch zahlreiche Schlittenhunde. "
    "Andere liegen faul in der Sonne und lassen sich dort von den Kindern "
    "streicheln." );
  AddDetail( ({ "versammlung","kreis" }),
    "Mehrere Xandim haben sich kreisfoermig zusammengesetzt und halten wohl "
    "eine Versammlung ab, denn Du siehst, wie sie ab und zu mit den Haenden "
    "gestikulieren." );
  AddDetail( "haende",
    "Die Xandim, die im Kreis beisammen sitzen, bewegen waehrend ihrer "
    "Gespraeche ihre Haende." );
  AddDetail( ({ "gespraech","gespraeche" }),
    "Lauschen waere besser." );
  AddDetail( "ueberblick",
    "Da Du auf dem Wachturm stehst, hast Du einen guten Ueberblick ueber den "
    "Ostplatz. Ein froehliches Treiben ist darauf zu sehen." );
  AddDetail( ({ "richtung","richtungen","himmelsrichtung","himmelsrichtungen" }),
    "Es gibt im Silberland meist 8 Himmelsrichtungen und einige von ihnen "
    "wirst Du untersuchen koennen." );
  AddDetail( ({ "nordosten","nordwesten","suedwesten","suedosten" }),
    "Diese Himmelsrichtung kannst Du hier nicht naeher untersuchen." );
  AddDetail( ({ "laeden","laden" }),
    "Manche Laeden sind einfache Ladentische, andere wiederum ganze "
    "Holzhuetten. Auf dem Ladendach einer der Holzhuetten ist eine fast "
    "unscheinbare Erhebung." );
  AddDetail( ({ "holzhuette","holzhuetten" }),
    "Die Haendler, die regelmaessig mehr einnehmen, konnten es sich leisten, "
    "eine Holzhuette als Laden aufzustellen. Natuerlich sind nicht so viele "
    "wie Ladentische, aber schlecht scheint das Geschaeft nicht zu laufen." );
  AddDetail( "geschaeft",
    "Willst Du eines abschliessen, dann besuche einen der Laeden neben dem "
    "Weg." );
  AddSpecialDetail( ({ "ladendach","ladendaecher","daecher" }), "detailLadendach" );
  AddSpecialDetail( "schmuckladendach", "detailSchmuckladendach" );
  AddSpecialDetail( "felladendach", "detailFellladendach" );
  AddSpecialDetail( "erhebung", "detailErhebung" );
  AddDetail( ({ "ladentische","ladentisch" }),
    "Entlang des Weges stehen mehrere Ladentische, an denen die Haendler ihre "
    "Waren feilbieten." );
  AddDetail( "haendler",
    "Da es Laeden gibt, duerfen die Haendler natuerlich auch nicht fehlen." );
  AddDetail( "erwartung",
    "Deine Erwartung auf einen schoenen Ausblick war ziemlich gross, aber bei "
    "einem kurzem Rundumblick wirst Du jaeh enttaeuscht. Koenntest Du nicht "
    "einmal das Treiben auf dem Platz beobachten, waere das Heraufsteigen "
    "womoeglich umsonst gewesen." );
  AddDetail( "heraufsteigen",
    "Das ist eine Taetigkeit wie auch das Hinunterklettern." );
  AddDetail( "hinunterklettern",
    "Musst Du frueher oder spaeter machen, wenn Du wieder nach unten willst." );
  AddDetail( ({ "taetigkeit","taetigkeiten" }),
    "Taetigkeiten macht man und untersucht man nicht." );
  AddDetail( "rundumblick",
    "Du drehst Dich einmal um die eigene Achse und stellst enttaeuscht fest, "
    "dass der Ausblick doch nicht so toll ist, wie Du Dir das urspruenglich "
    "vorgestellt hattest." );
  AddDetail( "achse",
    "Nachdem Du Dich um die Achse gedreht hast, hast Du zwar den Rundumblick "
    "genossen, dafuer ist Dir nun leicht schwindlig." );
  AddDetail( "treiben",
    "Du weisst gar nicht, wo Du zuerst hinblicken sollst, so ein grosses "
    "Treiben ist auf Ostplatz. Auf dem Weg, der von Osten nach Westen fuehrt, "
    "schlendern viele Erwachsene dahin, die sich die Waren bei den Laeden "
    "ansehen. Suedlich von Dir, in der suedoestlichen Ecke sitzen mehrere "
    "Xandim in einem Kreis zusammen, und der noerdlich Teil des Platzes scheint "
    "den Kinder zu gehoeren, die wild herumlaufen, Schneeballschlachten machen, "
    "Schneemaenner bauen, Spiele miteinander spielen oder sich auch einfach "
    "nur unterhalten. Doch auch das Treiben hinter der Koppel im Norden ist "
    "nicht zu uebersehen." );
  AddDetail( ({ "eck","ecke","ecken" }),
    "In den vier Ecken des Wachturms stehen Pfosten, die das Dach tragen, und in "
    "der suedoestlichen Ecke des Ostplatzes sitzen Xandim im Kreis zusammen." );
  AddDetail( ({ "erwachsene","erwachsener","erwachsenen" }),
    "Einige Erwachsene schlendern zwischen den Laeden durch, andere haben sich "
    "in einem Kreis im suedoestlichen Eck des Ostplatzes zusammen gesetzt." );
  AddDetail( ({ "xandimkinder","kinder" }),
    "Die Kinder laufen wild herum, bauen Schneemaenner, fuehren "
    "Schneeballschlachten, klettern auf einem Geruest herum oder unterhalten "
    "sich." );
  AddDetail( "geruest",
    "Das Geruest ist fast so hoch wie die Holzpalisade und sehr viele Kinder "
    "klettern darauf herum." );
  AddDetail( ({ "schneeballschlacht","schneeballschlachten" }),
    "Bei den Schneeballschlachten geht es wild her. Du bist sehr froh "
    "darueber, nicht in einer verwickelt zu sein." );
  AddDetail( ({ "schneemann","schneemaenner" }),
    "Die Xandimkinder bauen unter anderem auch Schneemaenner. Man muss das ja "
    "ausnuetzen, wenn es soviel Schnee gibt." );
  AddDetail( ({ "spiele","spiel" }),
    "Welche Spiele die Kinder spielen, weisst Du nicht, dafuer weisst Du, dass "
    "Du im Moment im Silberland spielst." );
  AddDetail( "silberland",
    "Du bist mitten im Silberland und falls Du es noch nicht weisst, es "
    "handelt sich hierbei um ein Spiel, also bitte nicht alles zu ernst zu "
    "nehmen." );
  AddDetail( "teil",
    "Auf dem noerdlichen Teil halten sich vorallem sehr viele Kinder auf. Die "
    "meisten von ihnen klettern auf einem Geruest herum." );
  AddDetail( ({ "waren","ware" }),
    "Du bist zu weit weg, um zu erkennen, welche Waren verkauft werden." );
  AddDetail( ({ "weg","pfad" }),
    "Musst Du schon weg? Das ist aber schade. Achso, doch nicht. Du meinst den "
    "Weg auf dem Ostplatz. Also..., der fuehrt von dem Tor, das direkt unter "
    "Dir ist, genau in Richtung Westen bis zu der Eispalisade." );
  AddDetail( "eispalisade",
    "Die Eispalisade begrenzt den Ostplatz nach Westen hin. Du bist viel zu "
    "weit weg, um naeheres zu erkennen." ); 
  AddDetail( "ausblick",
    "Du hast zwar einen guten Ausblick auf das umliegende Land, doch viel "
    "interessantes gibt es nicht zu sehen, wie Du feststellen wirst, wenn "
    "Du Dich nach den einzelnen Himmelsrichtungen umsiehst." );
  AddDetail( "land",
    "Du hast einen weiten und guten Ausblick auf das umliegende Land. Sieh es "
    "Dir an, wenn Du mehr darueber erfahren willst." );
  AddSpecialDetail( "plattform", "detailPlattform" );
  AddSpecialDetail( ({ "seite","seiten" }), "detailSeite" );
  AddSpecialDetail( "pfosten", "detailPfosten" );
  AddSpecialDetail( ({ "besen","etwas" }), "detailBesen" );  
  AddDetail( "wachturm",
    "Auf dem stehst Du gerade und geniesst den Ausblick. Schau Dich um, "
    "vielleicht lohnt es sich sogar." );
  AddDetail( "meter",
    "Du bist nun drei Meter ueber dem Erd- besser gesagt Schneeboden. Deine "
    "Knie beginnen zu schlottern." );
  AddDetail( "knie",
    "Die schlottern Dir ein klein wenig, aber keine Bange: Du hast noch immer "
    "einen festen Stand auf der Plattform." );
  AddDetail( "bange",
    "Bleib einfach ruhig und es wird nichts passieren." );
  AddDetail( ({ "erdboden","schneeboden" }),
    "Der Erdboden laesst sich auch als Schneeboden bezeichnen, bei der Menge an "
    "Schnee, die auf ihm liegt. Zeitweise ist er zertreten, anderswo liegt noch "
    "eine Neuschneeschicht und hin und wieder sieht man auch gelbe Flecken." );
  AddDetail( "flecken",
    "Hin und wieder gibt es gelbe Flecken im Schnee. Wie kommen die dort hin? "
    "*gruebel*" );
  AddDetail( "menge",
    "Eine unglaubliche Menge an Schnee liegt auf dem Erdboden, womit er sich "
    "genauso gut als Schneeboden bezeichnen laesst." );
  AddDetail( ({ "neuschneeschicht","neuschnee","schicht" }),
    "Dort, wo der Schnee nicht zertreten wurde, liegt noch immer eine Schicht "
    "von Neuschnee." );
  AddDetail( ({ "wachposten","wache" }),
    "Der ist im Moment nicht da. Wahrscheinlich ist er bei der Wachabloese." );
  AddSpecialDetail( "moment", "detailMoment" );
  AddDetail( ({ "wachabloese","abloese" }),
    "Der Wachposten ist sicher bei der Wachabloese, denn ansonsten waere der "
    "Wachturm nicht leer. Du koenntest ja Wache halten, bis der Wachposten "
    "zurueck kommt." );
  AddDetail( "dach",
    "Das Dach wird aus einer Vielzahl von Aesten gebildet, die in Form einer "
    "flachen Pyramide angeordnet wurden. Weiter unten sind noch die langen "
    "Aeste und bis zur Spitze werden sie ganz kurz." );
  AddDetail( ({ "form","form in raum" }),
    "Die Form des Daches entspricht der einer Pyramide." );
  AddDetail( "pyramide",
    "Selbstverstaendlich gibt es im Polargebiet keine Pyramide oder sollte doch "
    "irgendwo eine versteckt sein? Zumindest hat das Dach des Wachturms die "
    "Form von einer." );
  AddDetail( "spitze",
    "Da das Dach pyramidenfoermig ist, hat es natuerlich auch eine Spitze, "
    "neben genau -erstaunlicherweise- ueber Dir." );
  AddDetail( "vielzahl",
    "Zahlreiche Aeste bilden das Dach des Wachturms." );
  AddDetail( "gelaender",
    "Das Gelaender des Wachturm ist aeusserst schlicht. Zwischen zwei "
    "Pfosten wurde jeweils nur ein starker Ast in Huefthoehe angebracht." );
  AddDetail( ({ "ast","aeste" }),
    "Das Dach besteht aus vielen, kleinen Aesten, die nach oben hin immer "
    "kuerzer werden. Ausserdem sind zwischen zwei Pfosten jeweils ein starker "
    "Ast angebracht wurden, die als Gelaender dienen. Nur auf der Suedseite "
    "wurde der starke Ast durchgeschnitten, damit man wieder nach unten klettern "
    "kann. An den so entstandenen Enden stehen zwei kleinere Pfosten, denn sonst "
    "wuerde ja der Ast in der Luft schweben." );
  AddDetail( ({ "ende","enden" }),
    "Die Enden des durchschnittenen Astes wurden mit Seilen an kleinere "
    "Pfosten fest gezurrt." );
  AddSpecialDetail( "suedseite", "detailSuedseite" );
  AddSpecialDetail( "leiter", "detailLeiter" );
  AddDetail( "luft",
    "Die musst Du riechen." );
  AddDetail( "huefthoehe",
    "Die starken Aeste, die das Gelaender bilden, sind in Huefthoehe "
    "angebracht worden." );
  AddDetail( "witterungen",
    "Da Du den Witterungen, insbesondere dem Wind, hilflos ausgeliefert bist, "
    "ist es hier deutlich kuehler." );
  AddDetail( "wind",
    "Der ist sehr schwer zu sehen. Viel leichter ist er zu spueren und zu "
    "hoeren." );
  AddDetail( "gewicht",
    "Ueber das Gewicht spricht man doch nicht!" );
  AddDetail( ({ "querstrebe","querstreben" }),
    "Unter der Plattform muessen Querstreben sein, auf denen die Holzbretter "
    "festgenagelt wurden." );
  AddDetail( ({ "seil","seile" }),
    "Seile sind einige zu sehen, doch findest Du sie nicht weiter interessant. "
    "Die Plattform ist mit Seilen an den Pfosten gebunden und der "
    "durchgeschnittene Ast ist an den neu entstanden Enden ebenfalls mit Seilen "
    "an kleinere Pfosten befestigt." );
  AddDetail( ({ "kleinerer pfosten","kleineren pfosten","kleinere pfosten" }),
    "Zwischen diesen Pfosten kannst Du wieder nach unten gehen. Am besten waere "
    "es, Du haeltst Dich an diesen fest, wenn Du Dich dann umdrehst und nach "
    "unten kletterst, denn sonst faellst Du womoeglich noch runter." );
  AddDetail( ({ "ohren","ohr" }),
    "Du merkst zwar, dass sie noch da sind, aber wenn Du zulange hier oben "
    "stehen bleibst, dann wirst Du sie bald nicht mehr spueren." );
  AddDetail( "nase",
    "Die ist noch immer genau mitten im Dreieck von Deinen Augen und Deinem Mund." );
  AddSpecialDetail( "dreieck", "detailDreieck" );
  AddSpecialDetail( ({ "lippen","lippe","oberlippe","mund" }), "detailMund" );
  AddDetail( "schluss",
    "Nein, Schluss ist noch lange nicht, es geht ganz normal weiter. Vorausgesetzt Du "
    "stellst keine Dummheiten an." );
  AddDetail( ({ "dummheit","dummheiten" }),
    "Solange Du keine Dummheiten anstellst, wird Dir hier sicher auch nichts "
    "passieren." );
  AddDetail( "idee",
    "Die ist bekanntlich schwer zu sehen, aber hast Du gerade eine?" );
  AddDetail( "schmuckladen",
    "Vom Schmuckladen kannst Du nur dessen Dach sehen. Wenn Du ihn Dir "
    "genauer ansehen willst, dann wuerde ich einfach hingehen." );
  AddDetail( "gesicht",
    "Du kannst Dein Gesicht nicht sehen, sondern nur spueren." );
  AddDetail( "gaensehaut",
    "Ueberall an Dir spuerst Du momentan eine Gaensehaut. *zitter*" );
  AddDetail( ({ "aesten","wachturms","rentieren","schneesturms","kindern",
                "weges","haenden","fellen","erd","seilen","astes","daches",
                "ostplatzes","polargebiets","platzes","gespraechen",
                "schmuckladens" }),
    "Das kannst Du nicht untersuchen!" );
  
  AddSound( DEFAULT_SOUND,
    "Von dem hektischen Treiben und den Gespraechen am Platz unter Dir kriegst "
    "Du nicht mehr viel mit, dafuer blaest Dir der Wind ordentlich um die Ohren, "
    "sodass er unueberhoerbar fuer Dich ist." );
  AddSound( "wind",
    "Der Wind pfeift hier ziemlich stark, sodass sogar Du ihn hoeren kannst." );
  AddSound( "treiben",
    "Am Platz unter Dir ist einiges los, aber wenn Du mehr davon hoeren willst, "
    "solltest Du besser wieder nach unten steigen." );
  AddSound( ({ "gespraech","gespraeche","gespraechen" }),
    "Du kriegst nicht genau mit, worueber die Xandim sprechen, aber dass mehrere "
    "sich unterhalten, ist eindeutig. Wenn Du mehr hoeren willst, solltest Du "
    "besser wieder runtergehen." );

  AddSmell( DEFAULT_SMELL,
    "Unglaublich aber wahr, aber ausser der kuehlen Luft riechst Du hier "
    "ueberhaupt nichts. Oder war da nicht eben kurzzeitig ein Bratengeruch, "
    "der Dir an Deine Nase herangetragen wurde." );
  AddSmell( "nase",
    "Angestrengt versuchst Du Deine Nase zu riechen und kommst sofort zum "
    "Schluss, dass sie gleich wie immer riecht." );
  AddSmell( ({ "bratengeruch","geruch","braten" }),
    "Du bildest Dir ein, dass der Bratengeruch irgendwo vom Ostplatz kommen "
    "muss. Etwas essen waere keine dumme Idee!" );
  AddSmell( "luft", #'kalteLuft );
//END DETAILS

  AddSpecialExit( "runter", "gehen" );

  AddCmd( ({ "spuer","spuere" }), "cmd_spueren" );
  AddCmd( ({ "halt","halte" }), "cmd_halten" );
  AddCmd( ({ "loes","loese" }), "cmd_loesen" );
  AddCmd( ({ "fluch","fluche" }), "cmd_fluchen" );
  AddCmd( ({ "sitz","sitze","setz","setze" }), "cmd_sitzen" );
  AddCmd( ({ "beug","beuge" }), "cmd_beugen" );
  AddCmd( CMD_NEHMEN, "cmd_nehmen" );
  AddCmd( ({ "stell","stelle" }), "cmd_stellen" );
  AddCmd( ({ "kehr","kehre","feg","fege" }), "cmd_kehren" );
  AddCmd( ({ "nagel","nagle","haemmer","haemmere","schlag","schlage" }), "cmd_nageln" );
  AddCmd( ({ "schuerz","schuerze" }), "cmd_schuerzen" );
  AddCmd( ({ "spring","springe" }), "cmd_springen" );
//  AddCmd( CMD_GREIFEN, "cmd_greifen" );

  AddItem( NPC "wachposten", REFRESH_DESTRUCT );
}

_query_int_long()
{
  string text;
  text = "Voller Erwartung bist Du heraufgestiegen, um den schoenen, weiten "
         "Ausblick zu geniessen. Du stehst nun auf einer Plattform, die drei "
         "Meter ueber dem Erdboden ist und von einem Dach bedeckt wird.";
  if ( present("wachposten",ENV(TP)) )
    text += " Die Plattform ist bis auf den Wachposten leer, der am Gelaender "
            "steht und Dich freundlich anlaechelt.";
  if ( objectp(wache) && bewacht && interactive(wache) )
  {
    if ( TP == wache )  
      text += " Der Wachposten ist zwar nicht da, aber Du haeltst stattdessen "
              "fuer ihn Wache.";
    else
      text += " "+wache->Name(WER)+" steht auch hier oben und haelt Wache.";   
  }
  text += " Es ist hier oben auch merklich kuehler, weil Du den Witterungen "
          "hilflos ausgeliefert bist.";
  return BS( text );
}
//SPECIAL DETAILS
string kalteLuft(string key)
{
  string text;
  text = "Tief saugst Du die Luft in Dir ein!";
  if ( random(2) )
  {
    text += " Das war wohl zu viel des guten, denn Du musst unwillkuerlich "
            "husten.";
    say(
      TPN+" muss ploetzlich ganz kraeftig husten.\n" );
  }
  return BS( text );
}

string detailDreieck()
{
  say(
    TPN+" kneift sich spasshalber in "+TP->QueryPossPronoun(FEMALE,WEN,SINGULAR)+
    " Nase.\n" );
  return BS(
    "Die beiden Augen und Dein Mund bilden ein Dreieck und Deine Nase ist mitten "
    "drin. Sicherheitshalber kneift Du Dir in die Nase und nachdem es piekst, stellst "
    "Du fest, dass sie noch immer da ist. Puuuuuh!" );
}

string detailMund()
{
  if ( member(Lippen_geschuerzt,getuid(TP)) != -1 )
    return BS(
      "Da Du Deine Lippen im Moment geschuerzt hast, sieht Du Deine eigene "
      "Oberlippe. Unglaublich, was Du alles im Laufe eines Tages an Dir entdeckst!" );
  return BS(
    "Deinen Mund wirst Du nur dann sehen koennen, wenn Du Deine Lippen schuerzt und "
    "dann wahrscheinlich nicht mehr als Deine Oberlippe." );
}

string detailSchnee()
{
  string text;

  text = "Der Schnee ist nicht zu uebersehen. Egal, wo Du hinblickst, ueberall "
         "ist der Boden vom Schnee bedeckt, abgesehen vielleicht von dem Boden "
         "des Wachturms,";
  if ( !schnee_da )
    text += " der komplett frei von Schnee ist.";
  else
    text += " auf dem nur kleine Schneehaeufchen liegen.";
  return BS( text );
}

string detailSchneehaeufchen()
{
  if ( !schnee_da )
  {
    return BS(
      "Wo siehst Du schon wieder Schneehaeufchen? Ausser dem Schnee am Platz "
      "unter Dir oder dem hinter der Holzpalisade siehst Du keinen." );
  }
  return BS(
    "Auf dem Boden des Wachturms liegen tatsaechlich ein paar kleine "
    "Schneehaeufchen. Ob man dagegen etwas machen koennte?" );
}

string detailPlattform()
{
  string text;
  object leiter;

  text = "Die Plattform ist der Boden des Wachturms, ohne die Du nicht hier "
         "stehen koenntest.";
  if ( besen_da )
    text += " In einer Ecke, neben einem Pfosten, wurde etwas abgestellt.";
  call_other( ROOM "ostplatz_d2","???" );
  if ( (leiter=present("\nwachturmleiter",
                      find_object("/d/polar/rage/ostplatz/room/ostplatz_d2"))) &&
       (leiter->leiter_an_ort()) )
    text += " Auf der Suedseite wurde eine Leiter angelehnt, ueber die Du nach oben "
            "gekommen bist.";
  else
    text += " Interessanterweise ist die Leiter nicht mehr da, ueber die Du nach "
            "oben geklettert bist. Du wirst wohl runterspringen muessen, wenn Du "
            "halbwegs sicher unten ankommen willst.";
  return BS( text );
}

string detailSuedseite()
{
  object leiter;
  
  call_other( ROOM "ostplatz_d2","???" );
  if ( (leiter=present("\nwachturmleiter",
                      find_object("/d/polar/rage/ostplatz/room/ostplatz_d2"))) &&
       (leiter->leiter_an_ort()) )
    return
      "Auf der Suedseite kannst Du auf der Leiter wieder nach unten steigen.\n"; 
  return
    "Dir faellt auf, dass die Leiter nicht mehr da ist, wo sie noch eben "
    "angelehnt war.\n";
}

string detailPfosten()
{
  string text;

  text = "An allen vier Ecken des Wachturms steht ein Pfosten, auf dem "
         "denen einerseits das Dach aufliegt, andererseits die Plattform "
         "selbst mit Seilen festgebunden wurde, woraus Du schliesst, dass "
         "die Pfosten bis zu dem Erdboden hinunterreichen."; 
  if ( besen_da )
  {
    text += " Neben einem der Pfosten wurde ein Besen angelehnt.";
  }
  return BS( text );
}

string detailBesen()
{
  if ( besen_da )
  {
    return BS(
      "In einer der Ecken steht tatsaechlich ein Besen. Was hat denn der mitten "
      "in Yiqanuc verloren?" );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

string detailMoment()
{
  string text;
  
  switch ( random(5) )
  {
    case 1:
      text = "Das war grad einer.";
    break;
    case 2:
      text = "Der ist schon wieder vorbei.";
    break;
    case 3:
      text = "Ach! Jetzt hast Du ihn wieder verpasst.";
    break;
    case 4:
      text = "Moment einmal. Was wollte ich eigentlich jetzt?";
    break;
    default:
      text = "Als Du den Moment untersuchen willst, entwischt er Dir gerade "
             "noch.";
    break;
  }
  return BS( text );
}

string detailLadendach()
{
  if ( "/d/polar/rage/ostplatz/room/fellladendach" -> erhebungstatus() )
    return BS(
      "Auf den Ladendaechern liegt wie ueberall auch Schnee. Was Dir allerdings "
      "auffaellt ist eine kleine Erhebung auf dem Felladendach." );
  return BS(
    "Auf den Ladendaechern liegt wie ueberall auf dem Ostplatz auch Schnee, "
    "aber das war offensichtlich, denn wer steigt schon auf ein Dach, um "
    "diesen wegzuschaufeln." );
}

string detailFellladendach()
{
  object *spieler;
  string text;
  int i, j;

  if ( "/d/polar/rage/ostplatz/room/fellladendach" -> erhebungstatus() )
    text = "Schnee bedeckt das Dach, doch haeuft sich mehr davon zu einer kleinen "
           "Erhebung am Rand an.";
  else
    text = "Schnee bedeckt das Dach und wird bestimmt noch lange dort liegen "
           "bleiben.";
  call_other( ROOM "fellladendach", "???" );
  spieler = filter_array(all_inventory(find_object("/d/polar/rage/ostplatz/room/fellladendach")),
            lambda(({'x}), ({#'&&, ({#'query_once_interactive, 'x}),
            ({#'!, ({#'call_other, 'x, "QueryProp", P_INVIS})})})));

  switch( i=sizeof(spieler) )
  {
    case 0:
    break;
    case 1:
      text += " Mitten auf dem Dach steht "+spieler[0]->name()+".";
    break;
    case 2:
      text += " Mitten auf dem Dach stehen "+spieler[0]->name()+" und " +
              spieler[1]->name() + ".";
    break;
    default:
      text += " Mitten auf dem Dach stehen"+ spieler[0]->name();
              for( j=1; j<i-1; j++)
                text += ", " + spieler[i]->name();
              text += " und " + spieler[j-1]->name() + ".";
    break;
  }
  return BS( text );
}

string detailSchmuckladendach()
{
  object *spieler;
  string text;
  int i, j;

  text = "Das Dach des Schmuckladens ist wie die anderen Daecher auch, die Du "
         "von hier aus sehen kannst, mit Schnee bedeckt.";
  call_other( ROOM "schmuckladendach", "???" );
  spieler = filter_array(all_inventory(find_object("/d/polar/rage/ostplatz/room/schmuckladendach")),
            lambda(({'x}), ({#'&&, ({#'query_once_interactive, 'x}),
            ({#'!, ({#'call_other, 'x, "QueryProp", P_INVIS})})})));

  switch( i=sizeof(spieler) )
  {
    case 0:
    break;
    case 1:
      text += " Mitten auf dem Dach steht "+spieler[0]->name()+". Du fragst "
              "Dich, wie "+spieler[0]->QueryPronoun(WER)+" wohl da raufgekommen ist?";
    break;
    case 2:
      text += " Mitten auf dem Dach stehen "+spieler[0]->name()+" und " +
              spieler[1]->name() + ". Du fragst Dich, wie die beiden wohl "
              "da raufgekommen sind.";
    break;
    default:
      text += " Mitten auf dem Dach stehen"+ spieler[0]->name();
              for( j=1; j<i-1; j++)
                text += ", " + spieler[i]->name();
              text += " und " + spieler[j-1]->name() + ". Du fragst Dich, wie "
              "die alle da raufgekommen sind.";
    break;
  }
  return BS( text );
}

string detailErhebung()
{
  if ( "/d/polar/rage/ostplatz/room/fellladendach" -> erhebungstatus() )
  {
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " erkennt was am Fellladendach.\n");
    entdecker[ getuid(TP) ] = 1;	
    return BS(
      "Am Rand vom Felladendach hat sich der Schnee zu einer kleinen Erhebung "
      "angehaeuft. Ob das natuerlich entstanden ist oder ob darunter etwas "
      "verboren liegt, kannst Du von hier nicht feststellen." );
  }
  return BS(
    "Deine Augen muessen Dich wohl getaeuscht haben, denn Du siehst ueberhaupt "
    "nichts auffaelliges auf dem Felladendach." );
}

string detailHolzbretter()
{
  if ( holzbrett_locker )
  {
    return BS(
      "Die Holzbretter wurden nebeneinander gereiht und bilden so die "
      "Plattform und damit den Boden des Wachturms. Eines der Bretter sieht "
      "lose aus, denn es woelbt sich nach oben. Womoeglich stolpert einer noch "
      "darueber und faellt vom Turm hinunter." );
  }
  return BS(
    "Die Holzbretter wurden nebeneinander gereiht und bilden so die Plattform "
    "und damit auch den Boden des Wachturms. Sie sehen stabil aus und koennen "
    "bestimmt Dein Gewicht halten." );
}

string detailHolzbrett()
{
  if ( holzbrett_locker )
  {
    return BS(
      "Ein Holzbrett ist halsbrecherisch nach oben gewoelbt. Als Du Dir das "
      "Brett naeher ansieht, merkst Du, dass zwei Naegel fehlen. Waere doch "
      "nett von Dir, dagegen etwas zu unternehmen." );
  }
  return BS(
    "Da alle Holzbretter gleich aussehen, weisst Du nicht, welches Du "
    "untersuchen sollst." );
}

string detailNaegel()
{
  string text;

  text = "Die Holzbretter werden mit Naegeln niedergehalten. Darunter muessen "
         "wohl Querstreben verlaufen, auf denen die Bretter festgenagelt sind.";
  if ( holzbrett_locker )
  {
     text += " Leider fehlen zwei Naegel an einem Brett, womit dieses ein wenig "
             "hochsteht.";
  }
  return BS( text );
}

string detailLeiter()
{
  object leiter;
  
  call_other( ROOM "ostplatz_d2","???" );
  if ( (leiter=present("\nwachturmleiter",
                      find_object("/d/polar/rage/ostplatz/room/ostplatz_d2"))) &&
       (leiter->leiter_an_ort()) )
    return BS(
      "An der Suedseite der Plattform wurde eine Leiter angelehnt, ueber die man "
      "rauf- und auch wieder runterklettern kann." );
  return BS(
    "Die Leiter, die beim Raufsteigen noch an der Suedseite der Plattform angelehnt "
    "war, liegt nun merkwuerdigerweise am Boden." );
}
//END SPECIAL DETAILS
//COMMANDS
int cmd_spueren(string str)
{
  notify_fail( "Willst Du etwas aufspueren?\n" );

  if ( str=="" || !str ) return 0;
  if ( str == "wind" )
  {
    write( BS(
      "Du spuerst den kuehlen Wind, wie er an Deinem Gesicht vorbeiweht und "
      "unweigerlich steigt eine Gaensehaut an Dir hoch.") );
    say( BS(
      TPN+" zittert vor Kaelte. Du denkst . o O ("+TPN+" haelt auch gar nichts "
      "mehr aus).") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " spuert den Wind.\n");
    return 1;
  }
  if ( str == "kaelte" )
  {
    write( BS(
      "Die Kaelte ist auf dem Wachturm deutlich zu spueren und Du willst nicht "
      "laenger als notwendig hier oben stehen bleiben.") );
    say(
      TPN+" reibt sich kurz die Haende. "+CAP(TP->QueryPronoun(WEM))+" muss ganz "
      "schoen kalt sein.\n" );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " spuert die Kaelte.\n");
    return 1;
  }
}

int cmd_halten(string str)
{
  notify_fail( "Moechtest Du Dich wo festhalten oder doch etwas anderes "
               "halten?\n" );

  if ( str == "wache" )
  {
    if ( present("wachposten",ENV(TP)) )
    {
      write(
        "Du brauchst keine Wache zu halten, denn der Wachposten ist ohnehin "
        "da.\n" );
      return -1;
    }	
    if ( !bewacht )
    {
      write( BS(
        "Nachdem der Wachposten nicht da ist, entschliesst Du Dich, ab jetzt "
        "Wache zu stehen, bis eine Abloese kommt.") );
      say(
        TPN+" macht sich wohl daran, aber jetzt Wache auf dem Wachturm zu "
        "halten.\n" );
      wache = TP;
      bewacht = 1;
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+" haelt Wache.\n");
      return 1;
    }
    if ( TP == wache )
    {
      write(
        "Du haeltst doch schon selbst Wache!\n" );
      return -1;
    }
    write( BS(
      "Du brauchst nicht Wache zu stehen, denn "+wache->Name(WER)+" macht das schon, "
      "oder willst Du "+wache->QueryPronoun(WEN)+" abloesen?") );
    return -1;
  }
  else if ( str == "dich fest" || str == "am gelaender fest" )
  {
    write( BS(
      "Du gehst kurz zum Gelaender und haeltst Dich sicherheitshalber fest. "
      "Du kommst Dir dabei allerdings ziemlich bloed und verweichlicht vor, "
      "deshalb laesst Du gleich wieder los und stellst Dich wieder tapfer "
      "mitten in die Plattform.") );
    say( BS(
      TPN+" haelt sich kurz am Gelaender an, ueberlegt es sich aber gleich "
      "wieder anders.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " haelt sich am Gelaender fest.\n");
    return 1;
  }
}

int cmd_loesen(string str)
{
  object spieler;
  string wen;

  notify_fail( "Wen wuerdest Du gerne abloesen?\n" );

  if ( str=="" || !str ) return 0;
  if ( sscanf(str,"%s ab",wen) != 1 ) return 0;

  if ( present("wachposten",ENV(TP)) &&
       member( ({ "wachposten","posten","wache" }),wen) != -1 )
  {
    write( BS(
      "Das ist zwar nett von Dir, dass Du den Wachposten abloesen willst, "
      "doch er laechelt Dir nur zu, wohl als Zeichen dafuer, dass er seine "
      "Arbeit alleine schafft.") );
    return -1;
  }
  spieler = present(wen,TO);
  if ( !spieler )
  {
    write(
      capitalize(wen)+" kann ich hier weit und breit nicht sehen. Du "
      "halluzinierst wohl.\n" );
    return -1;
  }
  if ( spieler && interactive(spieler) )
  {
    if ( spieler == wache )
    {
      if ( spieler == TP )
      {
        write(
          "Du kannst Dich nicht selbst als Wache abloesen.\n" );
        return -1;
      }
      write( BS(
        "Du entschliesst Dich dazu, "+wache->Name(WEN)+" als Wache "
      	"abzuloesen und diese selbst zu halten.") );
      tell_object( wache,
        TPN+" loest Dich endlich als Wache ab.\n" );
      tell_room( ENV(TP),
        TPN+" loest "+wache->Name(WEN)+" als Wache ab.\n",
        ({ wache, TP }) );
      wache = TP;
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " loest Wache ab.\n");
      return 1;
    }
    if ( spieler == TP )
    {
      write( BS(
        "Du haeltst doch gar nicht Wache und was soll das bringen, wenn "
        "Du Dich selbst abloest?") );
      return -1;
    }
    write(
      spieler->Name(WER)+" haelt gar nicht Wache, also brauchst Du "+
      spieler->QueryPronoun(WEN)+" auch nicht abzuloesen.\n" );
    return -1;
  }
}

int cmd_fluchen(string str)
{
  if ( !random(5) && TP==wache )
  {
    write(
      "Nachdem Du die Schnauze davon voll hast, auf dem Wachturm Wache "
      "zu halten,\n"
      "beginnst Du ganz stark zu fluchen.\n"
      "Du denkst . o O (soll doch wer anders diese bloede Arbeit machen!)\n"
      "Mit diesem Gedanken widmest Du Dich wieder anderen Taetigkeiten.\n" );
    say(
      TPN+" flucht ganz stark, weil "+TP->QueryPronoun(WEM)+" irgendetwas "
      "wohl nicht passt.\n" );
    wache = 0;
    bewacht = 0;
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+" flucht.\n");
    return 1;
  }
}

int cmd_sitzen(string str)
{
  notify_fail( "Willst Dich schon wieder ausruhen?\n" );
  
  if ( member( ({ "auf gelaender","gelaender" }),str) != -1 )
  {
    if ( TP == wache )
    {
      write( BS(
        "Du hast keine Zeit fuer solche Spaesse, weil als Wache musst Du "
        "Dich auf die Gefahren hinter der Holzpalisade konzentrieren.") );
      return -1;
    }
    write( BS(
      "Du setzt Dich fuer einen Augenblick auf das Gelaender, um so einen "
      "Blick ueber den Ostplatz zu werfen.") );
    if ( random(3) )
    {
      write( BS(
        "Leider lehnst Du Dich dabei ein bisschen zu weit drueber, dass Du "
        "abrutschst und hinunter faellst. Zum Glueck ist der Boden mit Schnee "
        "bedeckt, dass Du Dich nicht schlimm verletzen konntest.") );
      say( BS(
        TPN+" setzt sich kurz auf das Gelaender, lehnt sich dabei allerdings "
        "zu weit zurueck, sodass "+TP->QueryPronoun(WER)+" hinunter faellt.") );
      SetProp( P_KILL_NAME, "Ein ungluecklicher Sturz" );
      TP -> move( ROOM "ostplatz_d2", M_GO,
              "vom Wachturm runter",
     	      "faellt",
      	      "faellt vom Wachturm runter und landet vor Dir" );
      TP -> do_damage(25+random(20));
      return 1;
    }
    write( BS(
      "Doch gleich darauf stehst Du wieder auf, weil Du nicht mehr siehst, als "
      "wenn Du beim Beobachten stehen wuerdest.") );
    say( BS(
      TPN+" setzt sich kurz auf das Gelaender, steigt aber gleich wieder davon "
      "runter.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " setzt sich auf Gelaender.\n");
    return 1;
  } 
}

int cmd_beugen(string str)
{
  notify_fail( "Ist Dir gerade uebel? Oder willst Du Dich nur irgendwo "
               "drueberbeugen?\n" );

  if ( str=="" || !str ) return 0;
  if ( member( ({ "dich ueber gelaender","ueber gelaender",
                  "dich ueber gelaender drueber","ueber gelaender drueber"
                }),str) != -1 )
  {
    write( BS(
      "Du beugst Dich nur ein klein wenig ueber das Gelaender, weil Du Angst "
      "davor hast, ansonsten runterzufallen. Was fuer ein Feigling! Weiter traust "
      "Du nicht?") );
    say( BS(
      TPN+" beugt sich wie ein Angsthase nur ein bisschen ueber das Gelaender, als "
      "ob "+TP->QueryPronoun(WER)+" Angst davor haette, runterfallen zu koennen.") );
    return -1;
  }
  if ( member( ({ "dich weiter ueber gelaender","weiter ueber gelaender",
                  "dich weiter ueber gelaender drueber",
                  "weiter ueber gelaender drueber",
                  "dich weit ueber gelaender","weit ueber gelaender",
                  "dich weit ueber gelaender drueber",
                  "weit ueber gelaender drueber"
                }),str) != -1 )
  {
    if ( TP == wache )
    {
      write( BS(
        "Du hast keine Zeit fuer solche Spaesse, weil als Wache musst Du "
        "Dich auf die Gefahren hinter der Holzpalisade konzentrieren.") );
      return -1;
    }
    write(
      "Mutig wie Du bist beugst Du Dich ganz weit ueber das Gelaender.\n" );
    if ( random(3) )
    {
      write(
        "Dummerweise hast Du Dich zu weit nach vorne gebeugt, denn Du verlierst "
        "den Halt und stuerzt brutal nach unten.\n"
        "Gluecklicherweise konnte der Schnee das meiste noch abdaempfen, doch ein "
        "paar Knochen tun Dir schon weh.\n");
      say( BS(
        TPN+" beugt sich soweit ueber das Gelaender, dass "+TP->QueryPronoun(WER)+
        "den Halt verliert und abrutscht.") );
      SetProp( P_KILL_NAME, "Leichtsinn" );
      TP -> move( ROOM "ostplatz_d2", M_GO,
              "vom Wachturm runter",
     	      "faellt",
      	      "faellt vom Wachturm runter und landet vor Dir" );
      TP -> do_damage(30+random(30));
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " beugt sich zu weit vor.\n");
      return 1;
    }
    say( BS(
      TPN+" beugt sich wagemutig weit ueber das Gelaender und faellt dabei nicht "
      "einmal runter.") );
    return 1;
  }
}

int cmd_nehmen(string str)
{
  object besen;

  if ( str=="besen" && besen_da )
  {
    if ( present("\nBESEN",TP) )
    {
      write(
        "Da Du bereits einen Besen hast, laesst Du den in der Ecke stehen.\n" );
      return -1;
    }
    besen = clone_object("/d/ebene/ronja/feenquest/weapon/besen");
    if ( ME_TOO_HEAVY == besen->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Der Besen wuerde Dir zu schwer werden, deshalb laesst Du ihn stehen.\n" );
      besen -> remove();
      return -1;
    }
    write( BS(
      "Du nimmst den Besen aus der Ecke, denkst allerdings daran, ihn wieder "
      "zurueckzustellen, wenn Du ihn nicht mehr brauchst.") );
    say(
      TPN+" nimmt einen Besen aus der Ecke der Plattform.\n" );
    besen_da = 0;
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " nimmt einen Besen.\n");
    return 1;
  }	
}

int cmd_stellen(string str)
{
  string was;
  object besen;

  notify_fail( "Willst Du etwas zurueckstellen?\n" );

  if ( !str || str=="" ) return 0;
  if ( sscanf(str,"%s zurueck", was ) != 1 ) return 0;
  if ( was == "besen" )
  {
    if ( besen = present("\nBESEN",TP) )
    {
      if ( !besen_da )
      {
        write( BS(
          "Da Du der Meinung bist, dass wer anders auch einen Besen brauchen "
          "koennte, stellst Du Deinen in die Ecke des Wachturms.") );
        say(
          TPN+" stellt einen Besen in die Ecke des Wachturms.\n" );
        besen -> remove(1);
        besen_da = 1;
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " stellt Besen zurueck.\n");
        return 1;
      }
      write(
        "Du brauchst keinen Besen in die Ecke stellen, denn dort steht "
        "bereits einer.\n" );
      return -1;
    }
    write(
      "Du hast gar keinen Besen bei Dir, den Du zurueckstellen koenntest.\n" );
    return -1;
  }
}

int cmd_kehren(string str)
{
  object besen;
  string was, wovon;

  notify_fail( "Bist Du wieder in Putzlaune oder was magst Du wegkehren?\n" );

  if ( str=="" || !str ) return 0;
  if ( member( ({ "schnee","schneehaeufchen","haeufchen" }),str) != -1 )
  {
    write(
      "Willst Du den Schnee von der Plattform kehren?\n" );
    return -1;
  }
  if ( sscanf(str,"%s %s", was, wovon ) != 2 ) return 0;
  if ( member( ({ "schnee","schneehaeufchen","haeufchen" }),was) != -1 )
  {
    if ( member( ({ "von plattform","von wachturm","vom wachturm",
                   "weg"
                  }),wovon) != -1 )
    {
      if ( schnee_da )
      {
      	if ( besen = present("\nBESEN",TP) )
      	{
      	  if ( besen -> QueryProp(P_WIELDED) )
      	  {
      	    write( BS(
      	      "Da Du nicht willst, dass jemand in die Schneehaeufchen "
      	      "hineinsteigen muss, kehrst Du diese mit dem Besen von der "
      	      "Plattform runter.") );
      	    say(
      	      TPN+" kehrt saemtliche Schneehaeufchen mit einem Besen von "
      	      "der Plattform.\n" );
      	    schnee_da = 0;
      	    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      	      " kehrt die Plattform.\n");
      	    return 1;
      	  }
      	  write( BS(
      	    "Du willst zwar den Schnee wegkehren, doch dazu solltest Du "
      	    "den Besen auch noch zuecken.") );
      	  return -1;
      	}
      	write( BS(
      	  "Hilfsbereit wie Du bist, willst Du den Schnee von der Plattform "
      	  "beseitigen, doch ohne Besen wird das nicht so gut klappen.") );
      	return -1;
      }
      write( BS(
        "Das naechste Mal halt Deine Augen besser offen, denn dann haettest Du "
        "gleich gesehen, dass gar kein Schnee auf der Plattform ist.") );
      return -1;
    }
    write(
      "Willst Du den Schnee von der Plattform kehren?\n" );
    return -1;
  }
}

int cmd_nageln(string str)
{
  object hammer, naegel;

  notify_fail( "Moechtest Du etwas festnageln?\n" );

  if ( str=="" || !str ) return 0;
  if ( member( ({ "holzbrett fest","brett fest","naegel in brett",
                  "naegel in holzbrett","naegel ins holzbrett",
                  "naegel ins brett"
                }),str) != -1 )
  {
    if ( holzbrett_locker )
    {
      if ( (hammer=present("hammer",TP)) && (naegel=present("naegel",TP)) )
      {
        write( BS(
          "Da Du einen Hammer und ein paar Naegel dabei hast, nagelst Du das Holzbrett, "
          "das schon ein wenig hochgestanden ist, fest, damit niemand darueber "
          "stolpern kann. Sicherheitshalber schlaegst Du gleich alle Naegel hinein, "
          "denn es soll ja laenger halten.") );
        say(
          TPN+" nagelt pflichtbewusst ein Holzbrett des Bodens fest.\n" );
        naegel->remove();
        holzbrett_locker = 0;
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " repaiert Holzbrett am Wachposten.\n");
        return 1;
      }
      if ( (!hammer=present("hammer",TP)) && (naegel=present("naegel",TP)) )
      {
        write(
          "Ohne einen Hammer wirst Du die Naegel nicht in das Brett schlagen "
          "koennen.\n" );
        return -1;
      }
      if ( (hammer=present("hammer",TP)) && (!naegel=present("naegel",TP)) )
      {
        write(
          "Ohne Naegel macht das Haemmern wenig Sinn.\n" );
        return -1;
      }
      else
      {
        write(
          "Ohne Naegel und Hammer wirst Du kein Holzbrett festnageln koennen!\n" );
        return -1;
      }
    }
    write(
      "Du brauchst hier nichts festzunageln, denn es ist gar nichts locker.\n" );
    return -1;
  }
}

int cmd_schuerzen(string str)
{
  notify_fail( "Magst Du Deine Lippen schuerzen?\n" );

  if ( !str || str=="" ) return 0;
  if ( str == "lippen" )
  {
    if ( member(Lippen_geschuerzt,getuid(TP)) != -1 )
    {
      write( BS(
        "Du hast Deine Lippen bereits geschuerzt und noch weiter nach vorne "
        "bekommst Du sie nicht.") );
      return -1;
    }
    write( BS(
      "Du schuerzt Deine Lippen, um somit zumindest einen Teil Deines Mundes "
      "sehen zu koennen.") );
    say(
      TPN+" schuerzt "+TP->QueryPossPronoun(FEMALE,WEN,PLURAL)+" Lippen, als ob "+
      TP->QueryPronoun(WER)+" darauf warten wuerde, von jemandem gekuesst zu "
      "werden.\n" );
    Lippen_geschuerzt += ({ getuid(TP) });
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " schuerzt die Lippen.\n");
    return 1;  	
  }
}

int cmd_springen(string str)
{
  object besen;
  
  besen = deep_present("\nBESEN", TP);
  if ( member( ({ "runter","nach unten","von wachturm","vom wachturm",
                  "von plattform"
                }),str) != -1 )
  {
    if ( TP == wache )
    {
      write(
        "Du kannst jetzt nicht nach unten springen, weil Du Wache halten "
        "musst.\n" );
      return -1;
    }
    if ( member(Lippen_geschuerzt,getuid(TP)) != -1 )
      Lippen_geschuerzt -= ({ getuid(TP) });
    if ( besen && !besen_da )
    {
      write( BS(
        "Bevor Du nach unten springst, stellst Du Deinen Besen in die Ecke, "
        "damit andere ihn auch noch benuetzen koennen.") );
      besen -> remove(1);
      besen_da = 1;
    }
    write(
      "Elagant schwingst Du Dich ueber das Gelaender und springst nach "
      "unten.\n" );
    TP -> move( ROOM "ostplatz_d2", M_GO,
            "vom Wachturm runter",
     	    "springt",
      	    "springt vom Wachturm runter und landet vor Dir" );
    if ( TP->QueryAttribute(A_DEX) < 10+random(15) )
    {
      SetProp( P_KILL_NAME, "Ein ungeschickter Sprung von einem Wachturm" );
      TP -> do_damage(30+random(30));
    }
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " springt vom Wachturm.\n");
    return 1;  	    
  }
}

/*int cmd_greifen(string str)
{
  notify_fail( "Wonach moechtest Du schon wieder fassen?\n" );

  if ( str=="" || !str ) return 0;
}*/

int gehen(string str)
{
  object leiter, besen;

  besen = deep_present("\nBESEN", TP);
  call_other( ROOM "ostplatz_d2","???" );
  if ( (leiter=present("\nwachturmleiter",
                      find_object("/d/polar/rage/ostplatz/room/ostplatz_d2"))) &&
       (!leiter->leiter_an_ort()) )
  {
    if ( TP == wache )
    {
      write( BS(
        "Du kannst jetzt nicht weg, weil Du Wache hier halten musst, bis Du "
        "abgeloest wirst.") );
      return -1;
    }
    if ( besen && !besen_da )
    {
      write( BS(
        "Bevor Du nach unten gehst, stellst Du Deinen Besen in die Ecke, "
        "damit andere ihn auch noch benuetzen koennen.") );
      besen -> remove(1);
      besen_da = 1;
    }
    if ( member(Lippen_geschuerzt,getuid(TP)) != -1 )
      Lippen_geschuerzt -= ({ getuid(TP) });
    SetProp( P_KILL_NAME, "Ein schwerer Sturz von einem Wachturm" );
    TP -> move( ROOM "ostplatz_d2", M_GO,
            "vom Wachturm runter",
     	    "faellt",
      	    "faellt vom Wachturm runter und landet vor Dir" );
    TP -> do_damage(50+random(50));
    return 1;
  }
  else
  {
    if ( TP == wache )
    {
      write( BS(
        "Du kannst jetzt nicht weg, weil Du Wache hier halten musst, bis Du "
        "abgeloest wirst.") );
      return -1;
    }
    if ( besen && !besen_da )
    {
      write( BS(
        "Bevor Du nach unten gehst, stellst Du Deinen Besen in die Ecke, "
        "damit andere ihn auch noch benuetzen koennen.") );
      besen -> remove(1);
      besen_da = 1;
    }
    if ( member(Lippen_geschuerzt,getuid(TP)) != -1 )
      Lippen_geschuerzt -= ({ getuid(TP) });
    TP -> move( ROOM "ostplatz_d2", M_GO,
       	    "die Leiter nach unten auf den Ostplatz",
      	    "klettert",
      	    "kommt ueber die Leiter heruntergeklettert" );
    return 1;
  } 
}
//END COMMANDS

//VARIABLES
Erhebung_entdeckt(string player)
{
  return entdecker[player];
}
//END VARIABLES

//RESET
void reset()
{
  ::reset();

  entdecker = ([]);
  say(
    "Durch eine starke Brise wird ziemlich viel Schnee auf die Plattform "
    "geweht.\n" );
  schnee_da = 1;
  if ( !besen_da ) besen_da = random(2);
  if ( holzbrett_locker) holzbrett_locker = random(2);
  if ( bewacht && interactive(wache) )
  {
    tell_object( wache,
      "Endlich wirst Du vom Wachposten abgeloest und Du kannst wieder von "
      "hier weg.\n" );
    tell_room( ENV(wache),
      wache->Name(WER)+" wird vom Wachposten wieder abgeloest.\n",
      ({ wache }) );
  }
  wache = 0;
  bewacht = 0;
}
