  AddDetail( ({ "stelle","stellen" }),
    "Drei Stellen auf der Tischplatte sind frei geblieben, damit Saphira "
    "der Kundschaft die Waren besser praesentieren kann." );
  AddDetail( "groessere stelle",
    "Auf dem Tisch rechts von Dir ist eine groessere, freie Stelle, an der "
