int wieselstatus()
{
  return swiesel_da;
}
int wieselkommt()
{
  swiesel_da = 1;
}
int wieselweg()
{
  swiesel_da = 0;
}

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "Du kannst dort nicht so ohne weiteres hin!\n" );
    return 0;
  }
  return 1;
}
//SPECIAL DETAILS
string detailTeile()
{
  return BS(
    "Die Teile siehst Du von hier oben im stehen nicht so gut." );
}

string detailBauwerk()
{
  string text;
  int zufall;
  
  text = "Die Miniaturbauwerke in den Regalen sind ausschliesslich aus Jade "
         "und sind bestimmt recht wertvoll.";
  switch( TP->QueryProp(P_EP_NUM) )
  {
    case 0..130:
      zufall = 1;
    break;
    case 131..260:
      zufall = 2;
    break;
    case 261..390:
      zufall = 3;
    break;
    case 391..520:
      zufall = 4;
    break;
    case 521..650:
      zufall = 5;
    break;
    case 651..780:
      zufall = 6;
    break;
    case 791..910:
      zufall = 7;
    break;
    case 911..1040:
      zufall = 8;
    break;
    case 1041..1170:
      zufall = 9;
    break;
    default:
      zufall = 10;
    break;
  }
  return BS( text );
}
//END SPECIAL DETAILS

//COMMANDS
int cmd_buecken(string str)
{
  write("Du bueckst Dich.\n");
  return 1;
}

int cmd_stehlen(string str)
{
  notify_fail( "Was willst Du machen, Du Dieb?\n" );
}

int cmd_belasten(string str)
{
  notify_fail( "Was moechtest Du hier belasten?\n" );

  if ( member( ({ "kronleuchter","leuchter","lampe" }),str) != -1 )
  {
    write( BS(
      "Du denkst wohl, Du brauchst nur die Syntax: <belaste kronleuchter> "
      "tippen, und der Rest geht von allein? Du musst Dir schon eine andere "
      "Methode ueberlegen, wie Du den Kronleuchter belasten koenntest.") );
    return 1;
  }
}

int cmd_schwingen(string str)
{
  notify_fail( "Womit oder worauf willst Du schwingen?\n" );
}

int cmd_oeffnen(string str)
{
}

int cmd_leihen(string str)
{
  notify_fail( "Du moechtest Dir etwas ausleihen?\n" );
}

int cmd_wuehlen(string str)
{
  notify_fail( "Wo willst Du durch Du Maulwurf?\n" );
}

int cmd_durchsuchen(string str)
{
  notify_fail( "Was genau moechtest Du durchsuchen?\n" );
}

int cmd_vergleichen(string str)
{
  notify_fail( "Was moechtest Du womit vergleichen?\n" );
}

int cmd_ahnen(string str)
{
  notify_fail( "Hast Du wieder keine Ahnung, was Du machen sollst?\n" );
}

int cmd_pusten(string str)
{
  notify_fail( "Willst Du irgendwelche Geburtstagskerzen ausblasen oder "
               "doch etwas anderes?\n" );
}

int testen(string str)
{
  object wiesel;
  
  notify_fail( "Was testen?\n" );

  if ( str == "wiesel" )
  {
    if ( swiesel_da )
    {
      wiesel = clone_object(NPC "swiesel");
      wiesel -> move(TO,M_GO);
      swiesel_da = 0;
      return 1;
    }
    write( BS(
      "Hier ist kein Wiesel.\n") );
    return 1;
  }
}
//END COMMANDS

