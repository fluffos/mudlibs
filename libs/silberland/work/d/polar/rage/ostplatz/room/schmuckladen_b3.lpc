// Osterweiterung des Xandimdorf
// Filename: schmuckladen_b3
// File by Rage, Februar 00

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <exploration.h>

int exit_test();
int swiesel_da;

void create()
{
  ::create();

  swiesel_da = 0;

  SetProp( P_INT_SHORT, "Im Schmuckladen" );
  SetProp( P_INT_LONG,
    "Der Schmuckladen erscheint Dir wie ein grosser Ausstellungsraum. "
    "Die Waende wurden mit Bilder, Schmuckstuecken und anderen "
    "Gegenstaenden behaengt, sodass eine Vielzahl unterschiedlicher "
    "Farben Deine Aufmerksamkeit erregt. Ausserdem wurden zwei lange "
    "Tische aufgestellt, auf denen noch weitere Waren verteilt wurden und "
    "auf denen die laufenden Geschaefte abgewickelt werden. Licht dringt "
    "ueber die offen stehenden Tueren herein, durch die auch staendig "
    "neue Kundschaft kommt und wieder geht. Zwei Frauen unterhalten sich "
    "und sehen sich im Laden um." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: 15]) );

//DETAILS
  AddDetail( ({ "bretterboden","boden" }),
    "Ausnahmsweise ist der Boden nicht mit Schnee bedeckt. Das ist "
    "wenigstens eine angenehme Ueberraschung. In der Huette wurde ein "
    "stabiler Bretterboden ausgelegt, der die Kaelte von draussen etwas "
    "isoliert und den von den Kunden hereingebrachten Schnee abrinnen "
    "laesst." );
  AddDetail( ({ "huetten","huette","blockhuette","blockhuetten" }),
    "Diese Huette ist gleich gebaut wie alle anderen Blockhuetten, die Du "
    "bisher auf dem Ostplatz gesehen hast. Innen gibt es eindeutig einen "
    "Unterschied, denn soviele unterschiedliche Gegenstaende hast Du "
    "schon lange nicht mehr gesehen." );
  AddDetail( "unterschied",
    "Zum Unterschied zu anderen Blockhuetten kannst Du hier sehr viele "
    "verschiedene Gegenstaende ausmachen." );
  AddDetail( "ostplatz",
    "Diese Huette steht auf dem Ostplatz und da Du selbst in der Huette stehst, "
    "folgst Du logisch daraus, dass Du auch am Ostplatz bist. Du freust "
    "Dich ungemein ueber diese Schlussfolgerung, auf die Du ganz allein "
    "gekommen bist." );
  AddDetail( "schlussfolgerung",
    "Auch Dir gelingt es hin und wieder die richtigen Schluesse zu folgern." );
  AddDetail( ({ "schluesse","schluss" }),
    "Mit den Schluessen ist jetzt Schluss." );
  AddDetail( "kaelte",
    "Die Kaelte von draussen wird durch den Bretterboden teils isoliert." );
  AddDetail( ({ "kunde","kunden", "kundin" }),
    "Kunden hat Saphira mehr als genug. Wenn einer gerade den Laden durch "
    "eine Tuer verlaesst, kommt die naechste bei einer anderen schon wieder "
    "herein." );
  AddDetail( "schnee",
    "Den siehst Du, wenn Du bei der offen stehenden Tuer im Norden nach "
    "draussen blickst." );
  AddDetail( "ueberraschung",
    "Die Ueberraschung ist, dass der Boden nicht mit Schnee bedeckt ist. "
    "Jetzt, wo Du es aber weisst, ist es leider keine Ueberraschung mehr." );
  AddDetail( "decke",
    "Die Decke wurde nach demselben Prinzip wie die Waende errichtet. "
    "Genau in der Mitte, im Schnittpunkt der beiden Deckendiagonalen, wurde "
    "eine Lampe aufgehaengt, die Dir Licht spendet." );
  AddDetail( "prinzip",
    "Das Prinzip ist folgendes: mehrere Baumstaemme werden aneinander bzw. "
    "uebereinander gereiht, bis schliesslich genug Lagen vorhanden sind "
    "und so eine Wand oder die Decke bilden." );
  AddDetail( ({ "lagen" }),
    "Mehrere Lagen aus Baumstaemme bilden eine Wand oder die Decke des "
    "Ladens." );
  AddDetail( "mitte",
    "Genau in der Mitte der Decke baumelt eine Lampe an einer Messingkette." );
  AddDetail( ({ "deckendiagonale","deckendiagonalen","diagonale",
                "diagonalen" }),
    "Die Deckendiagonalen sieht man ansich nicht. Das ist nur die imaginaere "
    "Linie einer Ecke zu der gegenueberliegenden." );
  AddDetail( "linie",
    "Da sie imaginaer ist, kannst Du sie auch nicht untersuchen." );
  AddDetail( ({ "ecke","ecken" }),
    "In den Deckenecken findest Du ausnahmsweise keine Spinnweben, dafuer "
    "stehen in zwei Ecken am Boden zwei Staender, auf denen weitere "
    "Schmuckstuecke haengen." );
  AddDetail( ({ "deckenecke","deckenecken" }),
    "An den Deckenecken gibt es ueberhaupt nichts, das Deine Aufmerksamkeit "
    "erregt." );
  AddDetail( "aufmerksamkeit",
    "Vielleicht solltest Du diese auf die Tische oder auf die Waende "
    "lenken." );
  AddDetail( "spinnweben",
    "Du findest keinerlei Spinnweben an, zumindest nicht in den Ecken an der "
    "Decke." );
  AddDetail( ({ "kronleuchter","lampe","leuchter" }),
    "Ein nicht uebersehbarer Kronleuchter haengt von der Decke an einer "
    "Messingkette herab. Komischerweise sind keine Kerzen darauf und Du "
    "fragst Dich, wie der ueberhaupt Licht spenden kann. Dann erst merkst "
    "Du, dass das Licht, das von draussen hereinkommt, auf den zahlreichen "
    "Kristallen des Kronleuchters reflektiert wird und sich so im ganzen "
    "Laden verbreitet." );
  AddDetail( ({ "kerzen","kerze" }),
    "Der Kronleuchter kommt ohne Kerzen aus und spendet trotzdem Licht." );
  AddDetail( ({ "kristall","kristalle" }),
    "Die Kristalle im Leuchter wurden so angeordnet, dass sie das Licht in "
    "jeden Winkel des Raumes reflektieren. Einen dieser Kristalle selbst "
    "zu besitzen waere sicher nicht schlecht. Bei den Tausenden faellt es "
    "sicher auch nicht auf, dass einer fehlt oder nicht." );
  AddDetail( "tausende",
    "Tausende Kristalle schmuecken den Kronleuchter und reflektieren das "
    "Licht." );
  AddDetail( "winkel",
    "Du willst jetzt nicht jeden einzelnen Winkel im Raum ansehen, doch Dir "
    "kommt es so vor, als ob tatsaechlich ueberall im Raum hell waere, "
    "obwohl es unwahrscheinlich hinter den Bildern finster sein wird." );
  AddDetail( "messingkette",
    "Die Messingkette haengt genau in der Mitte der Decke von dieser herab "
    "und an ihr haengt der Kronleuchter. Ein Kettenglied sieht nicht mehr so "
    "aus, als ob sie den Leuchter noch lange tragen wird koennen. Schon eine "
    "geringfuegige, zusaetzliche Belastung koennte reichen, dass der ganze "
    "Leuchter herunterfaellt." );
  AddDetail( ({ "kettenglied","kettenglieder" }),
    "Ein Kettenglied haengt schon relativ locker im naechsten drin. Es ist "
    "leicht moeglich, dass bei der geringsten Belastung der gesamte "
    "Kronleuchter herunterfaellt." );
  AddDetail( "belastung",
    "Wenn der Kronleuchter zu sehr belastet wird, muss man damit rechnen, "
    "dass die Messingkette reissen wird." );
  AddDetail( "schnittpunkt",
    "Dort, wo sich die beiden Deckendiagonalen schneiden, wurde eine Lampe "
    "aufgehaengt." );
  AddDetail( ({ "schmuckladen","laden" }),
    "Du stehst mitten in diesem schmucken Laden und weisst gar nicht so "
    "recht, wo Du als erstes hinsehen sollst. Der ganze Raum gleicht "
    "einem Ausstellungsraum eines Museums. Ueberall haengen Bilder, "
    "Schmuckstuecke werden zur Schau gestellt und ausserdem gibt es noch "
    "eine Reihe von Gegenstaenden, die auf den Tischen verteilt liegen." );
  AddDetail( "museum",
    "Du bist zwar in keinem Museum, doch der Laden gleicht einem, wenn Du "
    "all die Bilder und diversen Schmuckstuecke betrachtest, die sich hier "
    "befinden." );
  AddDetail( "schau",
    "Viele Bilder, Schmuckstuecke und andere Gegenstaende werden im Laden "
    "zur Schau gestellt, damit die Kundschaft einen Ueberblick ueber das "
    "Angebot erhaelt." );
  AddDetail( "ueberblick",
    "Nachdem alle Gegenstaende schoen im Laden von Saphira verteilt wurden, "
    "hat die Kundschaft und somit auch Du einen guten Ueberblick ueber das "
    "vorhandene Angebot." );
  AddDetail( "reihe",
    "Eine Reihe von Gegenstaenden liegen auf den Tischen verstreut. Am "
    "besten siehst Du Dir die Tische genauer an, um zu erfahren, was es "
    "alles gibt." );
  AddDetail( ({ "raum","ausstellungsraum" }),
    "Du kommst Dir vor, als ob Du mitten in einem Ausstellungsraum eines "
    "Museums stuendest. Bilder, Schmuckstuecke und andere "
    "Kunstgegenstaende, wohin Dein Auge reicht." );
  AddDetail( ({ "auge","augen" }),
    "Deine Augen reichen nicht sehr weit, eher deren Blick." );
  AddDetail( "blick",
    "Blicken tut man mit den Augen, aber das ist Dir sicher schon gesagt "
    "worden." );
  AddDetail( "waende",
    "Die Waende bestehen aus uebereinander gelegten Baumstaemmen, doch von "
    "denen ist nur wenig zu sehen, da eine Unzahl an Bilder, Schmuckstuecke "
    "und andere Gegenstaende an den Waenden aufgehaengt wurde." );
  AddDetail( ({ "baumstaemme","baumstamm" }),
    "Sowohl die Waende als auch die Decke bestehen aus Baumstaemmen. Und "
    "dreimal darfst Du raten, um welches Holz es sich dabei handelt." );
  AddDetail( ({ "holz","holzart","holzarten" }),
    "Viele Holzarten gibt es nicht im Polargebiet, also wirst Du schon allein "
    "rausfinden, aus welchem Holz die Baumstaemme sind." );
  AddDetail( "polargebiet",
    "Der Ostplatz liegt im Polargebiet." );
  AddDetail( ({ "unzahl","menge" }),
    "Eine gewaltige Menge an Bilder, Schmuckstuecke und andere Gegenstaende "
    "ist an den Waenden zu sehen. Irgendwie meinst Du, dass Du Dich in einem "
    "Museum und nicht in einem Laden aufhältst. Vielleicht sind ja auch "
    "irgendwelche Kostbarkeiten darunter? Neugierig wie Du bist, siehst Du "
    "Dir ohnehin alles genau an." );
  AddDetail( ({ "kostbarkeit","kostbarkeiten" }),
    "Die Kostbarkeiten endeckst Du natuerlich nicht mit einem einzigen Blick, "
    "sondern da musst Du Dir schon alles genau ansehen." );
  AddDetail( "wand",
    "Welche soll es sein?" );
  AddDetail( "nordwand",
    "Direkt neben der Tuer haengt eine grosse Wetteruhr, die vorne zwei "
    "kleine Tueren hat und ausserdem zwei Anzeigen aufweist. Ausserdem "
    "wurden noch ein doppeltes Kreuz aus Silber und ein kopfgrosser "
    "Holzring mit einem kleinen Ansatz aufgehaengt." );
  AddDetail( ({ "kleine tuer","kleinen tueren" }),
    "Die kleinen Tueren sind derzeit geschlossen. Du moechtest nur zu gern "
    "wissen, was sich dahinter verbirgt." );
  AddDetail( ({ "anzeige","anzeigen" }),
    "Die Wetteruhr hat drei Anzeigen. Die eine hat ein Rohr mit einer "
    "Fluessigkeit und weist Zahlen von -30 bis +40 auf, waehrend die andere "
    "kreisfoermig ist, einen Zeiger hat und Prozentzahlen von 0 bis 100 "
    "aufweist. Die letzte Anzeige zeigt die momentane Uhrzeit an." );
/*  AddDetail( "uhrzeit",
    "" );*/
  AddDetail( ({ "rohr","glasrohr","quecksilberanzeige" }),
    "Eine der beiden Anzeigen hat ist ein Glasrohr, das in das Holz der "
    "Wetteruhr eingelassen wurde und daneben Zahlen von -30 bis +40 "
    "aufweist. Im Rohr ist eine graue Fluessigkeit, deren Pegel bei 15 "
    "steht." );
  AddDetail( ({ "fluessigkeit","pegel" }),
    "Eine graue Fluessigkeit befindet sich im Rohr und ihr Pegel steht "
    "bei 15. Welche Fluessigkeit koennte das wohl sein?" );
  AddDetail( "quecksilber",
    "Gescheit wie Du bist, hast Du sofort erkannt, dass nur Quecksilber in "
    "dem Glasrohr sein kann und somit bist Du Dir ganz sicher, dass mit "
    "15 die momentane Temperatur gemeint sein muss." );
  AddDetail( "temperatur",
    "Hier im Laden hat es laut Quecksilberanzeige 15°C." );
  AddDetail( "zeiger",
    "Der Zeiger steht derzeit bei der Markierung mit der Prozentzahl 70." );
  AddDetail( "luftfeuchtigkeit",
    "Die momentane, relavite Luftfeuchtigkeit betraegt 70 Prozent." );
  AddDetail( "zahlen",
    "Die Zahlen der Anzeige mit dem Rohr reichen in Fuenferschritten von "
    "-30 bis +40." );
  AddDetail( "fuenferschritte",
    "Damit meine ich, dass der Abstand zwischen zwei Markierungen fuenf "
    "Einheiten entspricht. Welche Einheit das ist, musst Du selbst "
    "herausfinden." );
  AddDetail( ({ "markierungen","markierungen" }),
    "Beide Anzeigen weisen ganz feine, in das Holz eingeritzte Markierungen "
    "auf." );
  AddDetail( "abstand",
    "Der Abstand zwischen zwei Markierungen bei beiden Anzeigen entspricht "
    "fuenf Einheiten." );
  AddDetail( ({ "einheit","einheiten" }),
    "Tja, welche Einheiten verbergen sich hinter den beiden Anzeigen?" );
  AddDetail( ({ "prozentzahlen","prozentzahl","prozent" }),
    "Die Prozentzahlen reichen von 0 bis 100." );
  AddDetail( ({ "kreuz","silberkreuz","doppelkreuz","doppeltes kreuz" }),
    "Dieses Kreuz ist aus purem Silber und unterscheidet sich von anderen "
    "Kreuzen dadurch, dass es zwei Querbalken hat, wobei der obere "
    "Querbalken kuerzer als der untere ist. Ob es hier im Polargebiet eine "
    "eigene Glaubensrichtung gibt?" );
  AddDetail( "glaubensrichtung",
    "Sehen kannst Du die ganz bestimmt nicht, Du muesstest Dich schon ein "
    "bißchen umhoeren, ob nicht irgendwer etwas darueber weiss." );
  AddDetail( "querbalken",
    "Das Silberkreuz hat zwei Querbalken, wobei der obere kuerzer als der "
    "untere ist. Dadurch laesst es sich auch als Doppelkreuz bezeichnen. "
    "Wahrscheinlich kann man so seinen Glauben doppelt so gut kraeftigen, aber "
    "frag da besser wen anders und nicht mich :-)." );
  AddDetail( "glauben",
    "Deinen kenne ich nicht, und wenn Du den von den Xandim wissen willst, dann "
    "wirst Du das mit untersuchen allein sicher nie erfahren." );
  AddDetail( "holzring",
    "Der Holzring ist etwa kopfgross und hat einen kleinen Ansatz. Irgendwie "
    "erinnert Dich das an ein Joch. Doch wer brauch sowas schon mitten in "
    "Yiqanuc?" );
  AddDetail( "joch",
    "Ja, ganz genau! Der Holzring mit dem Ansatz kann nur ein Joch sein. Das "
    "kann man einem Lasttier, wie einem Maulesel oder Dir sicherlich gut "
    "umhaengen, damit es -oder Du- brav die Aecker pfluegt." );
  AddDetail( ({ "lasttier","maulesel" }),
    "Siehst Du grad einen Maulesel? Das geht aber nur, wenn Du einen Spiegel "
    "dabei hast." );
  AddDetail( "spiegel",
    "Keiner zu sehen." );
  AddDetail( ({ "acker","aecker" }),
    "Spinnst Du?!? Im Polargebiet willst Du einen Acker sehen? Du traeumst "
    "wohl!!!" );
  AddDetail( ({ "stummel","ansatz" }),
    "Der Holzring hat aussen einen kleinen Ansatz, der sicher auch fuer "
    "irgendetwas gut ist." );
  AddDetail( ({ "wetteruhr","uhr" }),
    "Neben der Nordtuer wurde eine grosse Wetteruhr aufgehaengt. Sie ist "
    "fast so gross wie ein Zwerg, hat ein Pendel, das regelmaessig hin und "
    "her schwenkt, zwei kleine Tueren, vor denen eine ovale Holzplatte "
    "montiert wurde, und drei Anzeigen." );
  AddDetail( "pendel",
    "Unten aus der Wetteruhr schaut ein langes Pendel hervor, dass sich "
    "staendig hin und her bewegt. Das muss wohl sein, damit die Anzeigen "
    "auch richtig funktionieren." );
  AddDetail( "holzplatte",
    "Vor den beiden kleinen Tueren ist eine kleine, ovale Holzplatte "
    "montiert worden, auf der sich zwei gebogene Schienen aus Eisen "
    "befinden." );
  AddDetail( ({ "eisenschienen","schienen" }),
    "Die Schienen kommen bei einer Tuer heraus und verschwinden wieder hinter "
    "dem anderen. Es waere gut moeglich, dass sich irgendetwas darauf "
    "bewegt. Du koenntest auch warten und schauen, ob etwas passiert." );
  AddDetail( "eisen",
    "Die beiden Schienen auf der Holzplatte vor der Wetteruhr sind aus "
    "Eisen." );
  AddDetail( ({ "zwerg","zwerge","knirpse","giftzwerg","giftzwerge" }),
       ([ 0: "Die Zwerge kennst Du sicher, die kleinen Knirpse, die immer "
             "so stinken.",
    "zwerg": "Ich meine damit solche Giftzwerge wie Dich." ]) );
  AddDetail( "ostwand",
    "Auch an dieser Wand haengen wie an der Westwand zwei Birkenregale, nur "
    "liegen in diesem zahlreiche Buecher und diverse Pergamentrollen liegen." );
  AddDetail( ({ "buch","buecher" }),
    "Beide Regale an der Ostwand sind mit Buecher und Pergamentrollen "
    "ueberfuellt. Das passt kaum mehr ein weiteres rein. Manche sind schoen "
    "aneinander gereiht, sodass man die Buchruecken sehen kann, andere liegen "
    "irgendwie uebereinander, ohne dass Du eine Ordnung darin erkennen "
    "koenntest. Viele sind dicke Waelzer, andere hingegen sind nicht viel mehr "
    "als ein paar lose, zusammengeheftete Blaetter." );
  AddDetail( "buchruecken",
    "Ein paar Buchruecken sind schon so zerfetzt, dass Du keinen Titel mehr "
    "darauf erkennen kannst, waehrend andere noch gut erhalten und auch "
    "leserlich sind. Die zerfetzten Buchruecken deuten wohl darauf hin, dass "
    "solche Buecher sehr oft genutzt bzw. ausgeliehen werden." );
  AddDetail( ({ "titel","buchtitel" }),
    "Einige der Buchtitel sind noch immer gut leserlich." );
  AddReadDetail( ({ "buecher","buch" }),
    "Du verspuerst nicht die geringte Lust, jetzt ein ganzes Buch "
    "durchzulesen." );
  AddDetail( ({ "lust","sex" }),
    "Lust auf Sex hast Du eigenlich immer, doch nicht die geringste, ein Buch "
    "komplett auszulesen." );
/*AddReadDetail( ({ "titel","buchtitel" }),
    "" );*/
  AddDetail( "ordnung",
    "Einige Buecher sind schoen nebeneinander geordnet, waehrend andere "
    "scheinbar ohne Ordnung uebereinander liegen. Du denkst . o O (jeder "
    "soll es so halten, wie es ihm richtig erscheint)." );
  AddDetail( "waelzer",
    "Es sind soviele Waelzer im Birkenholzregal verteilt, dass Du gar nicht "
    "weisst, wo Du am besten beginnen solltest. Einige von ihnen haben sicher "
    "mehr als 1000 Seiten und Du hoffst, dass Du diese nie lesen musst." );
  AddDetail( "seiten",
    "Einige Buecher sind echt dicke Waelzer und haben mehr als 1000 Seiten, "
    "dafuer gibt es andere, die nicht mehr als aus ein paar bestehen und die "
    "man nicht einmal das Buch bezeichnen kann." );
  AddDetail( ({ "blaetter","blatt" }),
    "Viele Blaetter liegen lose herum. Da ist es sicher nicht einfach, das "
    "richtige zu finden." );
  AddDetail( ({ "pergamentrolle","pergamentrollen","rolle","rollen" }),
    "Neben den Buechern liegen auch einige Pergamentrollen in den Regalen. "
    "Einige davon sind mit einem duennen Band umwickelt, andere mit einem "
    "Wachsstempel versiegelt. Viele der Rollen sind schon sehr vergilbt und "
    "durch andere sieht man schon fast durch. Entweder Saphira gibt sie nicht "
    "her oder sie interessieren niemanden." );
  AddDetail( ({ "band","baender" }),
    "Einige Pergamentrollen sind mit einem Band verschlossen, damit sie sauber "
    "zusammen gerollt in das Regal passen." );
  AddDetail( ({ "wachsstempel","stempel","siegel" }),
    "Ein paar Rollen tragen einen Wachsstempel bzw. ein Siegel, was vielleicht "
    "darauf schliessen laesst, dass es sich um wichtige Dokumente handelt." );
  AddDetail( ({ "dokument","dokumente" }),
    "Ob die Dokumente fuer Dich wichtig sind oder nicht, kannst Du nicht "
    "beurteilen, da Du nicht siehst, was innen auf den Pergamentrollen "
    "geschrieben steht." );
  AddDetail( ({ "birkenregale","birkenregal","birkenholzregale",
                "birkenholzregal" }),
    "Die Birkenregale sind schlicht bearbeitet, fallen nicht besonders auf "
    "und sind nur deshalb an der Wand aufgehaengt, damit viele Buecher "
    "und Pergamentrollen untergebracht werden konnten." );
  AddDetail( "suedwand",
    "Die gesamte Suedwand ist mit Bilder unterschiedlichster Groessen und "
    "Motiven ausgehaengt." );
  AddDetail( "westwand",
    "An dieser Wand haengen zwei Regale, in denen viele kleine "
    "Miniaturbauwerke stehen. Eines links und das andere rechts von der "
    "Tuer." );
  AddDetail( ({ "regal","regale" }),
    "An der Westwand haengen zwei Regale, beide aus Birkenholz, und sehen "
    "gleich aus wie die Regale an der Ostwand. Sie haben drei Faecher, auf "
    "denen lauter kleine Miniaturbauwerke stehen." );
  AddDetail( ({ "fach","faecher" }),
    "Die Regale an der Westwand haben genau drei Faecher, um so genuegend "
    "unterschiedliche, kleine Bauwerke reinstellen zu koennen." );
  AddSpecialDetail( ({ "miniaturbauwerk","miniaturbauwerke","bauwerk",
                       "bauwerke" }),"detailBauwerk" );
//unterschiedliche Bauwerke fehlen
  AddDetail( ({ "bilder","bild","gemaelde" }),
    "Bilder mit unterschiedlichsten Motiven und Groessen wurden auf den "
    "Waenden aufgehaengt. Zeitweise werden Landschaften dargestellt, dann "
    "wieder Portraits und anderswo eine Schlachtszene. Sie sind gross und "
    "klein, rund und eckig, im Quer- und Hochformat und die Malstile sind "
    "so unterschiedlich wie das Material von den Gemaelden." );
  AddDetail( ({ "motiv","motive" }),
    "Zu den Motiven gehoeren wie ueblich die typischen Schlachtszenen, aber "
    "es sind auch einige sehr schoen gemalte Landschaftsmotive dabei." );
  AddDetail( ({ "groesse","groessen" }),
    "So wie es grosse Bilder gibt, gibt es natuerlich auch viele kleine. Du "
    "brauchst sie Dir nur anzusehen und schon weisst Du, was darauf gemalt "
    "wurde." );
  AddDetail( ({ "landschaft","landschaften","landschaftsmotive",
                "landschaftsbilder","landschaftsbild" }),
    "Alle Landschaftsbilder scheinen eine Thematik gemeinsam zu haben: "
    "Schnee, Schnee und nochmals Schnee. Schneedeckte Huegel, schneebedeckte "
    "Berge und schneebedeckte Ebenen. Die Xandim muessen einen besonderen "
    "Bezug zu Schnee haben." );
  AddDetail( "huegel",
    "Die Huegel kommen Dir irgendwie bekannt vor. Waren bzw. sind die nicht in "
    "der Naehe von Yiqanuc?" );
  AddDetail( "naehe",
    "Momentan bist Du in der Naehe des Schmuckladens. Naja, so stimmt das auch "
    "nicht ganz, Du stehst eigentlich mitten drin." );
  AddDetail( ({ "berge","bergkette","gebirge" }),
    "Auf einigen Landschaftsbildern sind gewaltige Berge abgebildt. "
    "Wahrscheinlich ist damit das Gebirge im suedlichen Polargebiet gemeint. "
    "Steile Haenge, tiefe Schluchten und weite Risse praegen das "
    "Landschaftsbild." );
  AddDetail( ({ "hang","haenge" }),
    "Die Haenge, die Du auf den Bildern siehst, sind sehr steil. Dort "
    "kommt man ohne Kletterausruestung sicher nicht weiter." );
  AddDetail( "kletterausruestung",
    "Wo siehst Du eine?" );
  AddDetail( ({ "schlucht","schluchten" }),
    "In so eine Schlucht reinzufallen, ist sicher aeusserst unangenehm, denn "
    "manche sehen so aus, als ob sie 100m tief waeren." );
  AddDetail( "risse",
    "Die Risse sind nicht weniger gefaehrlich als die Schluchten. Zwar sind "
    "sie nicht so tief, doch wenn man in eine faellt, kann es einem schon "
    "passieren, dass man nicht mehr rauskommt und elendig darin verhungert." );
  AddDetail( ({ "ebenen","ebene" }),
    "Die Ebenen wirken sehr oed und einschlaefernd auf Dich. Du musst "
    "bereits unwillkuerlich gaehnen, wenn Du nur daran denkst, dass Du "
    "irgendwann einmal selbst ueber so eine Ebene spazieren musst." );
  AddDetail( "bezug",
    "Die Xandim muessen einen besonderen Bezug zu Schnee haben, denn sonst "
    "wuerden sie kaum im Polargebiet lieben." );
  AddDetail( "thematik",
    "Die Thematik der Landschaftsbilder ist eindeutig Schnee." );
  AddDetail( ({ "portrait","portraits" }),
    "Auf vielen der kleinen Bilder sind Portraits von Mitgliedern des Stamms "
    "der Xandim. Das wird so eine Art Ahnengalerie sein oder auch nur eine "
    "bunte Mischung vieler verschiedene derzeitiger oder ehemaliger "
    "Einwohner." );
  AddDetail( ({ "mitglieder","stamm" }),
    "Natuerlich sind Mitglieder des Stamms der Xandim gemeint, von denen "
    "Portraits angefertigt wurden. Wieso sollten die Xandim auch Bilder "
    "von anderen Rassen haben." );
  AddDetail( "rassen",
    "Ich denke, dass Du sicher auf unterschiedliche Rassen bereits "
    "getroffen bist, deshalb erspare ich mir eine Aufzaehlung." );
  AddDetail( "aufzaehlung",
    "Nein, nein und nochmals nein! Die Aufzaehlung erfolgt auch dann nicht, "
    "wenn Du sie untersuchst." );
  AddDetail( ({ "art","ahnengalerie" }),
    "Bei den Portraits handelt es ich um eine Art Ahnengalerie. Unter vier "
    "Portraits sind auch Plaketten angebracht worden." );
  AddDetail( ({ "plaketten","plakette" }),
    "Welche der aus Holz gefertigten Plaketten willst Du Dir ansehen? "
    "Falls Du das Portrait auch noch dazu betrachten willst, dann verfahre "
    "gleich wie mit den Plaketten." );
  AddDetail( "plakette 1",
    "      &%&%&%&%&%&%\n"
    "    %&%          &%&\n"
    "   %&%            &%&\n"
    "  %&%              &%&\n"
    " %&%     YRSTAL     &%&\n"
    "%&%       der        &%&\n"
    " %&%  Wolfsfreund   &%&\n"
    "  %&%              &%&\n"
    "   %&%            &%&\n"
    "    %&%          &%&\n"
    "      &%&%&%&%&%&%\n");
  AddDetail( ({ "portrait 1","yrstal","wolfsfreund" }),
    "Ueber der Plakette siehst Du einen weisen, alten Mann, dessen Fell "
    "bereits weiss ist." );
  AddDetail( ({ "mann","maenner" }),
    "Auf den Portraits kannst Du auch verschieden Maenner ausmachen. Sieh "
    "Dir doch ein paar Portraits genauer an." );
  AddDetail( "fell",
    "Alle Xandim tragen ein natuerliches Fell, nur dieses auf dem Bild ist "
    "bereits weiss, ein Zeichen dafuer, dass der Mann sehr alt ist oder "
    "wurde." );
  AddDetail( ({ "zeichen","alter" }),
    "Das weisse Fell ist ein Zeichen hohen Alters." );
  AddDetail( "plakette 2",
    "+~~~~~~~~~~~~~~~~~~~+\n"
    "|                   |\n"
    "|      YRGALLA      |\n"
    "|  der Schweigsame  |\n"
    "|                   |\n"
    "+~~~~~~~~~~~~~~~~~~~+\n");
  AddDetail( ({ "portrait 2","yrgalla","schweigsame" }),
    "Der Mann auf diesem Portrait blickt sehr grimmig und ernst drein. "
    "Seine blauen Augen liegen weit in den Augenhoehlen drin, und es scheint "
    "stets ein Glitzern von ihnen auszugehen. Irgendetwas hat er mit einem "
    "Mann auf einem anderen Portrait gemeinsam, doch ohne sie direkt "
    "miteinander zu vergleichen, kannst Du es nicht sehen." );
  AddDetail( ({ "glitzern","blaue augen" }),
    "Ein blaues Glitzern geht von seinen Augen aus, das magisch auf Dich "
    "wirkt.");
  AddDetail( "augenhoehlen",
    "Die Augen liegen tief in den Augenhoehlen von Yrgalla." );
//Randomversteck fuer Edelstein oder was anderes
  AddDetail( "plakette 3",
    "  oooooooooooooooooooooooooooo\n"
    " o                            o\n"
    "o          MINDERA II          o\n"
    "o   Bewahrerin der Schriften   o\n"
    " o                            o\n"
    "  oooooooooooooooooooooooooooo\n" );
  AddDetail( "portrait 3",
    "Die Frau auf diesem Portrait blickt Dich weise und geduldig an und "
    "irgendwie sieht es so aus, als ob sie Dir gut zuhoeren koennte." );
  AddDetail( "plakette 4",
    "=============================\n"
    "\\\\                         //\n"
    " \\\\       YRDARET         //\n"
    " //  Sprecher der Xandim  \\\\\n"
    "//                         \\\\\n"
    "=============================\n" );
  AddDetail( "portrait 4",
    "Der Mann traegt sein Fell ziemlich lang und sieht recht jung aus. Auf "
    "seiner Stirn hat er einen Abdruck oder eine Taetowierung, von der Du "
    "meinst, sie auf einem anderen Portrait auch gesehen zu haben." );
  AddDetail( "stirn",
    "Die meisten Xandim haben eher eine hohe Stirn, so auch dieser Mann auf "
    "dem Portrait. Ausserdem hat dieser noch einen Abdruck oder eine "
    "Tatoewierung darauf." );
  AddDetail( ({ "abdruck","taetowierung" }),
    "Ob es ein Abdruck oder eine Taetowierung ist, darueber bist Du Dir "
    "nicht ganz sicher. Du siehst auch nur einen Kreis, denn die Haare "
    "haengen in die Stirn herein." );
  AddDetail( "haare",
    "Die Haare des Mannes haengen in die Stirn herein und verdecken den "
    "Abdruck." );
  AddDetail( "kreis",
    "Ein wenig von einem Kreis ist auf der Stirn zu sehen." );
  AddDetail( "mischung",
    "Auf den Bildern ist eine bunte Mischung von ehemaligen und "
    "derzeitigen Einwohnern aus Yiqanuc. Vier Portraits fallen Dir "
    "besonders auf." );
  AddDetail( "einwohner",
    "Einige Einwohner aus Yiqanuc sind auf den Portraits zu sehen und vor "
    "Dir steht auch eine, naemlich Saphira." );
  AddDetail( "querformat",
    "Auf den Bildern im Querformat sind meinst Landschaften oder "
    "Schlachtszenen dargestellt." );
  AddDetail( "hochformat",
    "Die meisten Portraits wurden in Hochformat gemalt. Du findest nur "
    "vereinzelte Landschaftsbilder darunter." );
  AddDetail( ({ "malstil","malstile" }),
    "Du bist zwar selbst kein Kunstexperte, doch erkennst Du, dass die "
    "meisten Bilder mit Oel- bzw. Wasserfarben gemalt wurden. Ein paar "
    "wenige scheinen auch mit Graphit gezeichnet worden zu sein." );
  AddDetail( ({ "kunstexperte","experte" }),
    "Du bist ganz bestimmt keiner, und deshalb wirst Du auch nicht "
    "draufkommen, welche Bilder besonders wertvoll sind und welche nicht." );
  AddDetail( ({ "oelfarben","oelfarbe" }),
    "Vorallem die Schlachtszenen wurden mit Oelfarben gemalt, um die "
    "kraeftigen Farben besonders hervorzuheben, doch auch die Portraits "
    "wurden mit Oelfarben gemalt." );
  AddDetail( ({ "wasserfarben","wasserfarbe" }),
    "Bei den Landschaftsbildern wurden hauptsaechlich Wasserfarben "
    "verwendet, um die Geheimnisse, die sich hinter gewissen Landschaften "
    "verbergen, besser hervorheben zu koennen." );
  AddDetail( "geheimnisse",
    "Jaja, kann ich mir denken, dass Du gern hinter die Geheimnisse des "
    "Silberlandes kommen willst, aber dazu wirst Du schon mehr machen "
    "muessen, als nur ein paar Bilder zu untersuchen, oder ist vielleicht "
    "doch in irgendeinem Bild ein Geheimnis versteckt?" );
  AddDetail( "graphit",
    "Eher die kleinen Gemaelde sind mit Graphit gezeichnet. Man koennte "
    "sie auch eher als Zeichnungen, denn als Gemaelde bezeichnen." );
  AddDetail( ({ "zeichnung","zeichnungen" }),
    "Bei vielen der kleinen Gemaelde handelt es sich um verschiedene "
    "Zeichnungen aus Graphit. Die Motive darauf sind dieselben wie bei den "
    "Gemaelden aus Oel- und Wasserfarben." );
  /*AddDetail( "geheimnis",
    "" );*/
//noch ein Randomversteck
  AddDetail( ({ "materialien","material" }),
    "Habe ich schon erwaehnt, dass Du kein Kunstexperte bist? Dennoch "
    "meinst Du, folgende Materialien zu erkennen: Leinwand, Papier, Holz "
    "und Tuch." );
  AddDetail( "leinwand",
    "Selbstverstaendlich wurden bei den meisten Gemaelden Leinwand "
    "verwendet, da die Farben darauf am besten zur Geltung kommen." );
  AddDetail( "geltung",
    "Die Farben kommen auf Leinwand besonders gut zur Geltung." );
  AddDetail( ({ "grosse bilder","grosses bild","grosser gemaelde" }),
    "Wie nicht anders zu erwarten, sind auf den grossen Bildern "
    "zahlreiche Schlachtszenen und Landschaften zu sehen." );
  AddDetail( ({ "kleine bilder","kleines bild","kleine gemaelde" }),
    "Auch wenn auf den kleinen Bildern keine grossen Landschaften "
    "gemalt wurden, so erkennt man an ihnen doch die sehr grosse "
    "Detailtreue." );
  AddDetail( "detailtreue",
    "Die kleinen Bilder sind so detailgetreu, dass Du bei einem Portrait "
    "sogar eine ganz kleine Narbe am Hals entdeckst." );
  AddDetail( ({ "narbe","hals" }),
    "Die Narbe am Hals sieht einer Schnittwunde aehnlich." );
  AddDetail( "schnittwunde",
    "Du glaubst, dass die Narbe am Hals eine Schnittwunde ist, doch nur "
    "der Traeger von dieser koennte Dir mehr darueber sagen." );
  AddDetail( "traeger",
    "Wer das wohl ist?" );
//NPC einbauen
  AddDetail( ({ "runde bilder","rundes bild","runde gemaelde" }),
    "Die runden Bilder unterscheiden sich von den Motiven her kein "
    "bisschen von den eckigen." );
  AddDetail( ({ "eckige bilder","eckiges bild","eckige gemaelde" }),
    "Auf den eckigen Bildern sind die gleichen Motive wie auf den den "
    "runden." );
  AddDetail( ({ "schlachtszene","schlachtszenen" }),
    "Auf den Bildern wurden unter anderen unterschiedliche Schlachtszenen "
    "dargestellt, eben die ueblichen, die jeder kennt, wie das Toeten eines "
    "Eisdrachens, Kaempfe zwischen Gut und Boes oder eine Szene, wo "
    "Xandim gegen ihre Brueder und Schwestern kaempfen." );
  AddDetail( ({ "toeten","eisdrachen","eisdrache" }),
    "Bei dieser Schlachtszene siehst Du wie sechs wackere Xandim nur mit "
    "Lanzen und Schwerter bewaffnet gegen einen riesigen Eisdrachen "
    "kaempfen. Einem fehlt bereits ein Arm und ein anderer hat eine tiefe "
    "Brustwunde und weitere zwei liegen bereits tot am Boden. Der "
    "Eisdrache hingegen blutet erst aus ein paar kleinen Wunden neben "
    "seinem Auge." );
  AddDetail( "wunden",
    "Der Eisdrache blutet nur aus Wunden neben seinem Auge. Anscheinend "
    "ist dort irgendwo seine einzige Schwachstelle, da die Xandim nur "
    "dorthin zielen." );
  AddDetail( "schwachstelle",
    "Entweder ist die Schwachstelle das Auge des Eisdrachen oder direkt "
    "daneben. Du muesstest Dich schon selbst mit ihm kaempfen, um das "
    "bestaetigen zu koennen." );
  AddDetail( ({ "lanzen","schwerter" }),
    "Die sechs Xandim stellen sich mutig mit ihren Lanzen und Schwerter "
    "dem Eisdrachen entgegen, doch sieht es nicht so aus, als ob sie "
    "tatsaechlich eine Chance haetten." );
  AddDetail( "chance",
    "Wenn Du bedenkst, wie stark die Xandim verwundet sind, schaetzt Du "
    "ihre Chance gering, dass sie den Eisdrachen besiegen." );
  AddDetail( "arm",
    "Ein Arm eines Xandims wurde bereits von den kraeftigen Klauen des "
    "Eisdrachens abgetrennt, doch der Xandim kaempft verbissen weiter." );
  AddDetail( "klauen",
    "Von den Klauen des Eisdrachens moechtest Du lieber nicht getroffen "
    "werden." );
  AddDetail( ({ "brustwunde","brust" }),
    "Bei dieser tiefen Brustwunde und dem Blut, das aus der Brust heraus "
    "rinnt, ist der Tod fuer den Xandim schon sehr nahe." );
  AddDetail( "blut",
    "Das Blut wirkt total echt. Ob da tatsaechlich wer Blut ueber dem "
    "Gemaelde verloren hat?" );
//Blut riechen
  AddDetail( "tod",
    "Fuer den Xandim auf der Schlachtszene ist er sehr nahe, fuer Dich "
    "zum Glueck nicht." );
  AddDetail( "glueck",
    "Du hast Glueck, denn der Tod ist Dir sitzt Dir derzeit nicht im "
    "Nacken." );
  AddDetail( "nacken",
    "Sicherheitshalber greifst Du an Deinen Nacken, aber der Tod ist "
    "wirklich nicht dort." );  
  AddDetail( ({ "kaempfe","gut","boes" }),
    "Du siehst Kaempfe von Dunkelelfen gegen Feen, Nekromanten gegen "
    "Paladine, Orks gegen Zwerge und noch viele andere." );
  AddDetail( ({ "dunkelelfen","dunkelelf","feen","fee" }),
    "Waehrend die Dunkelelfen mit ihren Dunkellanzen oder Peitschen auf "
    "die Feen losgehen, versuchen die Feen ihnen geschickt im Fliegen "
    "auszuweichen und sie mit Zaubersprueche zu bewerfen." );
  AddDetail( ({ "dunkellanzen","schlangenpeitsche","schlangenpeitschen" }),
    "Die Dunkellanzen und Schlangenpeitschen sind scheinbar sehr effektiv "
    "gegen die Feen, denn viele liegen bereits tot oder schwer verwundet "
    "am Boden." );
  AddDetail( ({ "fliegen","fluegel" }),
    "Mit ihren Fluegel gelingt es den Feen, oft die Angriffe der Dunkelelfen "
    "auszuweichen." );
  AddDetail( ({ "angriffe","angriff" }),
    "Oft koennen die Feen den Angriffen der Dunkelelfen ausweichen, indem "
    "sie davon fliegen." );
  AddDetail( "zaubersprueche",
    "Die Feen werfen Zaubersprueche auf die Dunkelelfen. Ein paar von "
    "ihnen wurden schon von einem getroffen, denn sie haben sich in "
    "Froesche verwandelt." );
  AddDetail( ({ "froesche","frosch" }),
    "Mit ihren Zauberspruechen sollen Feen andere in Froesche verwandeln "
    "zu koennen und das scheint auch zu stimmen." );
  AddDetail( ({ "nekromanten","nekromant","paladine","paladin" }),
    "Die Nekromanten kaempfen mit gewaltigen Peitschen, waehrend die "
    "Paladine sich vehement mit Mithrilschwert und -schild verteidigen. "
    "Viele Leichen liegen haufenweise am Boden verstreut und ein paar von "
    "ihnen stehen auch wieder auf." );
  AddDetail( ({ "mithrilschwert","mithrilschwerter","mithrilschild",
                "schild" }),
    "Die Paladine kaempfen mit Mithrilschwerter und verteidigen sich "
    "gleichzeitig dabei mit ihrem Schild. Sie verteidigen die Ehre Dustys "
    "bis in ihren Tod." );
  AddDetail( "ehre",
    "Die Paladine halten sehr viel von Ehre und sind Dusty immer treu." );
  AddDetail( ({ "dusty","goettin" }),
    "Dusty ist die Goettin vom Silberland, aber nicht auf den Gemaelden zu "
    "sehen." );
  AddDetail( ({ "peitschen","peitsche" }),
    "Mit einer Hand fuehren sie die Peitsche und mit der anderen beschwoeren "
    "sie maechtige Zauber, die die Leichen wieder zu neuem Leben erwecken." );
  AddDetail( "hand",
    "Alle Nekromanten kaempfen mit einer Peitsche in der Hand." );
  AddDetail( "zauber",
    "Die Zauber, die gesprochen werden, muessen sehr maechtig sein, denn "
    "sonst wuerden nicht die Leichen ploetzlich aufstehen." );
  AddDetail( ({ "leiche","leichen" }),
    "Nicht, dass nur zahlreiche Leichen auf den Bildern dargestellt wurden, "
    "sondern einige von ihnen erwachen sogar zu neuem Leben." );
  AddDetail( "leben",
    "Ob das Leben als Leiche noch sehr lebenswert ist?" );
  AddDetail( ({ "ork","orks","zwerg","zwerge" }),
    "Du siehst eine Hoehle, in der die Orks mit Keulen wild auf die "
    "Zwerge losgehen und die dafuer einen Gegenangriff mit ihren Aexten "
    "fuehren." );
  AddDetail( "hoehle",
    "Es muss eine sehr groesse Hoehle sein, da bestimmt mehr als 150 Orks "
    "und Zwergen zu sehen sind." );
  AddDetail( ({ "keule","keulen" }),
    "Die Orks schlagen mit ihren Keulen brutal zu und manche Zwergenkoepfe "
    "sind darunter schon zermalmt worden." );
  AddDetail( ({ "zwergenkoepfe","keulenhieb" }),
    "Viele Zwergenkoepfe wurden durch einen schweren Keulenhieb zermalmt, "
    "aber das aendert nichts an der Kampfeskraft der restlichen Zwerge." );
  AddDetail( "kampfeskraft",
    "Die Kampfeskraft der Zwerge ist legendaer. Sie kaempfen auch dann noch "
    "weiter, wenn sie keinen Ausweg sehen." );
  AddDetail( ({ "gegenangriff","aexte" }),
    "Mit ihren Aexten fuehren die Zwerge einen ebenso brutalen Gegenangriff "
    "und viele Orks werden dabei gespalten, dass nur mehr vereinzelte "
    "Koerperteile von ihnen herumliegen." );
  AddDetail( "koerperteile",
    "Viele einzelne Koerperteile der Orks liegen verstreut herum. Ein "
    "erbarmungsloser Kampf findet hier statt." );
  AddDetail( ({ "kampf","ausweg" }),
    "Der Kampf ist erbarmungslos, doch ist nicht zu erkennen, wie er enden "
    "wird." );
  AddDetail( ({ "szene","brueder","schwester","schwestern" }),
    "Du kannst es nicht glauben, aber Du siehst, wie Xandim in einem "
    "Garten ihre eigenen Brueder und Schwestern umbringen. Irgendwas muss "
    "da passiert sein, dass es soweit kommen konnte." );
  AddDetail( ({ "garten","innenhof" }),
    "Der Garten ist gleichzeitig der Innenhof eines Palastes. Und ueberall "
    "kaempfen Xandim gegen Xandim." );
  AddDetail( "palast",
    "Diesen Palast hast Du bisher noch nie gesehen, doch wie es aussieht, "
    "leben oder lebten ein paar Xandim dort." );
  AddDetail( "xandim",
    "Auf vielen Bildern wurden Xandim gemalt, die durch ihr natuerliches "
    "Fell leicht zu erkennen sind." );
  AddDetail( ({ "schmuck","schmuckstuecke" }),
    "Die Schmuckstuecke wurden sowohl auf Staender und Waenden "
    "aufgehaengt und einige liegen auch auf den Tischen. Die Palette reicht "
    "von Amulette, Ringe fuer Ohren und Finger, Ketten jeglicher Art bis "
    "kleinen Stangen, die man sich durch die Nase stecken kann." );
  AddDetail( "staender",
    "Es stehen mehrere Staender im Laden verteilt, auf denen Schmuckstuecke "
    "aufgehaengt wurden, die weder an den Waenden noch auf den Tischen "
    "Platz gefunden haben." );
  AddDetail( "platz",
    "Die Huette ist zwar relativ gross, aber durch die langen Tische und "
    "die Staender in den Ecken bleibt nicht mehr viel Platz." );
  AddDetail( ({ "stange","stangen", "birkenholzstange","birkenholzstangen" }),
    "Auf einem Tisch liegen auch ein paar bis zu 1cm dicke Stangen, die aus "
    "Birkenholz sind und auch unterschiedliche Laengen haben. Ich bin "
    "mir nicht sicher, ob Du Dir traust, so eine Stange durch die Nase "
    "stecken zu lassen." );
  AddDetail( "birkenholz",
    "Die Regale an den Waenden sind aus Birkenholz, aber auch die Stangen, "
    "die auf dem Tisch liegen." );
  AddDetail( "nase",
    "Du fasst Dir an die Nase. Ob da so eine Stange durchpasst?" );
  AddDetail( ({ "laenge","laengen" }),
    "Die Laengen der Birkenholzstangen reichen von 3 bis 20 Zentimeter." );
  AddDetail( "zentimeter",
    "Manche Stangen sind 20cm lang. Du ueberlegst Dir ernsthaft, wer sowas "
    "noch als Schmuck tragt." );
  AddDetail( ({ "gegenstaende","gegenstand","kunstgegenstaende",
                "kunstgegenstand" }),
    "Bei den Gegenstaenden bist Du Dir nicht ganz sicher, worum es sich "
    "dabei handeln soll. Einer ist beispielsweise ein kopfgrosser Holzring, "
    "der einen kleinen Ansatz hat. Ein anderer stellt ein doppeltes "
    "Kreuz aus Silber dar, dessen Bedeutung Du nur erahnen kannst. "
    "Ausserdem gibt es noch weitere zahlreiche Gegenstaende, die auf den "
    "Tischen verteilt liegen, die Du Dir naeher betrachten solltest." );
  AddDetail( ({ "bedeutung","ahnung" }),
    "Du koenntest die Bedeutung des Kreuzes erahnen, aber eigentlich hast "
    "Du keine Ahnung, was so besonders daran sein soll." );
  AddDetail( "silber",
    "Das doppelte Kreuz aus Silber, das an der Nordwand aufgehaengt wurde, "
    "glitzert und sticht Dir in die Augen, als ob es sagen wolle: Kauf mich! "
    "Kauf mich doch!" );
  AddDetail( "vielzahl",
    "Die Vielzahl der Farben ist genauso reichhaltig wie das Angebot an "
    "unterschiedlichen Schmuckstuecke." );
  AddDetail( "angebot",
    "Das Angebot an Schmuckstuecke ist so umfassend, dass Du Dir am besten "
    "die Tische und die Staender naeher betrachtest oder mit <zeige> Dir "
    "eine Liste der Waren geben laesst." );
  AddDetail( "liste",
    "Tippe <zeige> und Du erhaeltst eine Liste der Gegenstaende, die Du "
    "kaufen kannst." );
  AddDetail( "farben",
    "Jede nur erdenkliche Farbe kannst Du in diesem Raum sehen." );
  AddDetail( "farbe",
    "Denk Dir irgendeine Farbe aus und die wirst Du im Raum sehen." );
  AddDetail( "aufmerksamkeit",
    "Die ganzen Farben in dem Laden erwecken Deine Aufmerksamkeit. Schon "
    "nach kurzer Zeit geht Dir nur mehr ein Gedanke durch den Kopf: 'Ich "
    "muss etwas kaufen! Ich muss etwas kaufen!'" );
  AddDetail( ({ "gedanke","gedanken" }),
    "Du kriegst den Gedanken nicht mehr aus dem Kopf, dass Du unbedingt "
    "irgendetwas in diesem Laden kaufen musst." );
  AddDetail( "kopf",
    "Dein Kopf passt Dir echt ausgezeichnet." );
  AddDetail( "zeit",
    "Du findest, es wird Zeit, etwas im Laden zu kaufen. Es wird sicher "
    "etwas fuer Dich dabei sein." );
  AddDetail( "tische",
    "Zwei lange Tische, beide aus Fichtenholz, wurden im Laden aufgestellt, "
    "auf denen weitere Waren zum Verkauf angeboten werden. Sie sind sehr "
    "massiv gebaut, haben eine dicke Tischplatte und die Tischbeine sind "
    "so dick wie ein Menschenbein." );
  AddDetail( "fichtenholz",
    "Beide Tische sind aus massivem Fichtenholz und muessen einiges "
    "aushalten, wenn man die Gegenstaende betrachtet, die auf ihnen "
    "liegen." );
  AddDetail( "menschenbein",
    "Die Tischbeine der Tische sind etwa so dick wie ein Menschenbein." );
  AddDetail( "tisch",
    "Du stehst genau zwischen beiden Tischen. Welchen der beiden Tische "
