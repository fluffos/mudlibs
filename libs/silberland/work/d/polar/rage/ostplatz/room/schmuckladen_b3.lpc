    "" );*/
  AddSpecialDetail( "teile", "detailTeile" );
  AddDetail( "zustand",
    "Der Zustand der Tischbeine ist makellos. Die Tische brechen auch bei "
    "noch so grosser Last sicher nicht zusammen." );
  AddDetail( "last",
    "Die Tische brechen auch bei noch so grosser Last sicher nicht "
    "zusammen." );
  AddDetail( "verkauf",
    "Viele der Waren, die Du um Dich verteilt sehen kannst, stehen zum "
    "Verkauf frei. Welche es sind, wird Dir der Befehl <zeige> verraten." );
  AddDetail( "befehl",
    "Gib einen Befehl ein statt ihn zu untersuchen." );
  AddDetail( ({ "waren","ware" }),
    "Um Dir saemtliche Waren in aller Ruhe anzusehen, kannst Du natuerlich "
