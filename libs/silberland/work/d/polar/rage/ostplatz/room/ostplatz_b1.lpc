// Osterweiterung des Xandimdorf
// Filename: ostplatz_b1.c
// File by Rage, Februar 00

inherit "std/room";
inherit "d/polar/rage/ostplatz/room/rundgang";

#include "../def.h"
#include "../schneemann.h"

#include <moving.h>

string player;                     //Spieler, die Schneemann bauen können
string KinderLauschen(string key);
string Geraeusche(string key);

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Dieser Platz scheint der Treffpunkt der Kinder der Xandim zu sein. "
    "Sie spielen mit Schlittenhunden, bauen Schneemaenner oder laufen nur "
    "in der Gegend herum. Die Nordseite ist von einer Holzpalisade begrenzt, "
    "im Westen steht vor der Eispalisade ein einzelnes Iglu, im Sueden "
    "fuehrt ein Weg durch diverse Laeden durch und nach Osten breitet sich "
    "der Platz noch weiter aus." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -4]) );

//DETAILS
  AddDetail( "sueden",
    "Suedlich von Dir fuehrt ein Weg durch diverse Laeden." );
  AddDetail( ({ "kinder","xandimkinder","kind","xandimkind" }),
    "Mit ihrem zottelig wuscheligen Fell sehen sie alle wie zu gross "
    "geratene Teddybaeren aus. Sie spielen mit Schlittenhunden, bauen "
    "Schneemaenner oder laufen nur in der Gegend herum. Es scheint, als ob "
    "sie ueberhaupt keine Sorgen haetten - im Gegensatz zu Dir." );
  AddDetail( "fell",
    "Die Kinder tragen, natuerlich gleich wie alle Xandim, ein natuerliches "
    "Fell, das sie ueberall schoen warm haelt." );
  AddSpecialDetail( ({ "teddybaeren","teddybaer" }), "detailTeddybaeren" );
  AddDetail( "gegensatz",
    "Du hast doch nicht etwa irgendwelche Sorgen? Falls ja, hoffe ich, "
    "dass Du bald jemanden findest, mit dem Du darueber reden kannst." );
  AddDetail( "sorgen",
    "Die Kinder haben sicher keine Sorgen, dazu haben sie viel zu viel "
    "Spass." );
  AddDetail( ({ "gegend","fall" }),
    "Mit Gegend ist in diesem Fall der Platz gemeint." );
  AddDetail( "westen",
    "Mit einem Blick nach Westen erkennst Du die Eispalisade, die Yiqanuc "
    "umgibt, und ein einzelnes Iglu, das davor steht." );
  AddDetail( "blick",
    "Du blickst ganz gespannt nach Westen und siehst ein einzelnes Iglu." );
  AddDetail( "iglu",
    "Es sieht eigentlich nicht anders aus, als die anderen, die Du bisher "
    "gesehen hast. Wenn Du mehr sehen willst, koenntest Du naeher hingehen, "
    "vorausgesetzt Du traust Dir das zu." );
  AddDetail( ({ "weg","pfad" }),
    "Der Weg ist mehr oder weniger ein ausgetretener Pfad im Schnee, der "
    "durch die Laeden durchfuehrt." );
  AddDetail( ({ "laden","laeden","holzhuetten","huetten","blockhuetten",
                "blockhuette","holzhuette" }),
    "Ja, ja. Die sind alle suedlich von Dir. Schlichte Huetten aus Holz, die "
    "wohl in typischer Blockhuettenbauweise gebaut wurden." );
  AddDetail( ({ "blockhuettenbauweise","bauweise" }),
    "Die Bauweise der Holzhuetten entspricht genau der von Blockhuetten.");
  AddDetail( ({ "holz","holzart" }),
    "Da Du kein Holzspezialist bist, erkennst Du auf diese Entfernung die "
    "Holzart nicht." );
  AddDetail( "entfernung",
     "Sie ist eindeutig zu gross, um die Holzart zu erkennen." );
  AddDetail( ({ "holzspezialist","spezialist","sawer" }),
    "Du bist ganz sicher keiner. Sawer wuesste sicher mehr, doch glaube ich "
    "kaum, dass der sich die Muehe machen wird, nach Yiqanuc zu reisen." );
  AddDetail( "muehe",
    "Nachdem Sawer sich kaum die Muehe machen wird, nach Yiqanuc zu kommen, "
    "um Dich zu sehen, koenntest Du ja bei ihm vorbeischauen." );
  AddDetail( "osten",
    "In diese Richtung breitet sich der Platz noch weiter aus. Kinder spielen "
    "auch dort und einige von ihnen klettern auf einem grossen Holzgeruest "
    "herum." );
  AddDetail( ({ "richtung","richtungen" }),
    "Richtungen gibt es genug, aber Du musst schon eine spezielle angeben." );
  AddDetail( ({ "holzgeruest","geruest" }),
    "Von hier siehst Du nur, dass es die Form eines Dreiecks hat, und die "
    "Kinder rauf und runterklettern. Irgendwie meinst Du, dass das Geruest "
    "noch einen weiteren Sinn hat." );
  AddDetail( "dreieck",
    "Das Holzgeruest hat die Form eines Dreiecks." );
  AddDetail( ({ "sinne","sinn" }),
    "Du weisst, dass Du fuenf hast, aber sehen kannst Du Deine eigenen und "
    "den des Geruestes auch nicht." );
  AddDetail( ({ "form","form in raum" }),
    "Die eines Dreiecks." );
  AddDetail( ({ "nordseite","norden" }),
    "Die Nordseite wird von einer Holzpalisade begrenzt." );
  AddDetail( ({ "palisade","palisaden" }),
    "Du siehst eine Eispalisade, die das Xandimdorf umgibt, und eine "
    "Holzpalisade, die diesen Platz umgibt." );
  AddDetail( "holzpalisade",
    "Sie wird aus Pfaehlen aus Holz gebildet, die nebeneinander in den Boden "
    "gerammt und mit starken Seilen zusammengebunden wurden. Sie soll diesen "
    "Platz vor gefaehrlichen Tieren schuetzen, damit die Kinder unbesorgt "
    "spielen koennen." );
  AddDetail( ({ "seil","seile" }),
    "Starke Seile halten neben dem Halt der Pfaehle im Boden diese "
    "zusaetzlich zusammen. Das Schema, wie sie um die Pfaehle gewickelt sind, "
    "kannst Du beim besten Willen nicht durchschauen." );
  AddDetail( "halt",
    "Du gehst zur Holzpalisade hin, ruettelst kurz daran und merkst, dass "
    "der Halt der Pfaehle im Boden sehr gut ist, denn die Holzpfaehle "
    "geben nicht nach." );
  AddDetail( ({ "wille","willen" }),
    "Dein Wille ist zwar stark, aber doch nicht gross genug, um das Schema, "
    "wie die Seile um die Pfaehle gewickelt wurden, zu durchschauen." );
  AddDetail( "schema",
    "Einmal wurde das Seil um einen Pfahl gewickelt, dann wieder um zwei, ..."
    "Dir ist es zu bloed, das Schema genau durchschauen zu wollen, die Xandim "
    "werden schon gewusst haben, was sie da machen." );
  AddDetail( ({ "pfahl","pfaehle","holzpfahl","holzpfaehle" }),
    "Die Holzpfaehle sitzen tief im Boden fest und schuetzen diesen Platz vor "
    "gefaehrlichen Tieren." );
  AddDetail( "eispalisade",
    "Die umgibt das Xandimdorf und manchmal kannst Du einen Schatten "
    "erblicken, der sich hinter der Palisade auf und ab bewegt." );
  AddDetail( "schatten",
    "Da Du nicht glaubst, dass sich in dem Dorf ein 4 Meter grosses Ungetuem "
    "aufhaelt, meinst Du, dass dieser Schatten wahrscheinlich ein "
    "Xandimwaechter ist, der auf dem Wachweg seinen Dienst verrichtet." );
  AddDetail( "dienst",
    "Ein Xandimwaechter marschiert auf der Eispalisade auf und ab." );
  AddDetail( "meter",
    "Ein Meter in Yiqanuc ist gleich lang wie ein Meter in Midas." );
  AddDetail( "midas",
    "Midas kannst Du von hier ganz sicher nicht sehen." );
  AddDetail( "wachweg",
    "Den siehst Du nicht, sondern kannst ihn nur erahnen, da er sich hinter "
    "der Eispalisade befindet." );
  AddDetail( "ungetuem",
    "Hier ist sicher keines, auch nicht hinter der Eispalisade." );
  AddDetail( ({ "xandimwaechter","waechter" }),
    "Der Schatten, den Du gesehen hast, ist wohl ein Waechter." );
  AddDetail( ({ "xandimdorf","dorf" }),
    "Die Heimat der Xandim. Wenn Du wieder durchs Stadttor gehst, bist Du "
    "dort." );
  AddDetail( ({ "stadt","yiqanuc" }),
    "Du kannst Yiqanuc als Stadt oder als Dorf ansehen. Das bleibt Dir "
    "ueberlassen." );
  AddDetail( ({ "stadttor","tor","zugang" }),
    "Das Stadttor ermoeglicht Dir den Zugang nach Yiqanuc, damit Du Dir ein "
    "Ueberklettern der Palisade ersparst (dass Du Dank Deiner "
    "Ungeschicklichkeit sicher nicht schaffst)." );
  AddDetail( "dank",
    "Ich moechte Dir persoenlich danken, dass Du Dir diesen Ostplatz so "
    "genau ansiehst. Danke." );
  AddDetail( ({ "ungeschicklichkeit","reflexe" }),
    "Du warst schon einmal geschickter als heute, aber jeder wird aelter "
    "und da lassen dann die Reflexe mit der Zeit nach." );
  AddDetail( "heimat",
    "Das Dorf und dieser Platz zaehlen zur Heimat der Xandim." );
  AddDetail( "xandim",
    "Aufgrund der zahlreichen Xandim, die Du in letzter Zeit gesehen hast, "
    "kommst Du zu dem verwegenen Schluss, dass sie die Einwohner dieses "
    "Dorfes sind." );
  AddDetail( "schluss",
    "Wie schon gesagt, Du kommst zu dem Schluss, dass die Einwohner dieses "
    "Dorfes Xandim sind." );
  AddDetail( "zeit",
    "In letzter Zeit hast Du ziemlich viele Xandim gesehen. Das gibt Dir "
    "doch zu denken." );
  AddDetail( "einwohner",
    "Die Xandim wohnen hier. Ganz genau!" );
  AddDetail( ({ "tier","tiere" }),
    "Hier siehst Du keine gefaehrlichen Tiere, sondern nur ein paar "
    "Schlittenhunde, mit denen die Kinder herumtollen." );
  AddDetail( ({ "hunde","hund","schlittenhunde","schlittenhund" }),
    "Es laufen sehr viele hier herum. Doch ich an Deiner Stelle wuerde nicht "
    "so mit ihnen spielen, wie die Kinder dies tun. Sie koennten womoeglich "
    "aggressiv reagieren." );
  AddDetail( "stelle",
    "Damit meine ich: Wenn ich Du waere." );
  AddDetail( "schlitten",
    "Die sind sicher verstaut, denn sonst wuerdest Du sicher welche sehen." );
  AddDetail( "treffpunkt",
    "Eben dieser Platz!" );
  AddDetail( ({ "platz","ostplatz" }),
    QueryProp(P_INT_LONG) );
  AddDetail( "himmel",
    "Praechtig klarer Himmel." );
  AddDetail( "sonne",
    "Die spendet hauptsaechlich Licht, von der Waerme merkst Du nicht viel." );
  AddDetail( "waerme",
    "Obwohl die Sonne so hell strahlt, bekommst Du von der Waerme leider gar "
    "nichts mit." );
  AddDetail( "licht",
    "Waere es dies nicht, wuerdest Du wohl nichts sehen." );
  AddDetail( ({ "boden","grund" }),
    "Ueberall, wo Du hinsiehst, ist er mit einer dicken Schneeschicht "
    "bedeckt. Ausserdem siehst Du ein Durcheinander unterschiedlicher Spuren, "
    "die durch das Herumlaufen der Kinder entstanden sind." );
  AddDetail( "durcheinander",
    "Trotz des Durcheinanders der Spuren kannst Du Deine eigene erkennen, die "
    "dadurch auffaellt, dass sie einen Kreis bildet." );
  AddDetail( "herumlaufen",
    "Die Kinder laufen ueberall herum und scheinen, eine Menge Spass zu haben." );
  AddDetail( ({ "spass","menge" }),
    "Die Kinder laufen ueberall herum, lachen dabei, werfen Schneebaelle, "
    "bauen Schneemaenner, spielen mit den Schlittenhunden,...ja, die "
    "haben sicher eine Menge Spass." );
  AddDetail( ({ "schneeball","schneebaelle" }),
    "Hui, jetzt hast Du Glueck gehabt! Ein Schneeball flog ganz knapp an "
    "Dir vorbei." );
  AddDetail( "glueck",
    "Hin und wieder hast auch Du Glueck." );
  AddDetail( ({ "spur","spuren" }),
    "Es sind hauptsaechlich Spuren der Kinder und Spuren der Schlittenhunde "
    "zu sehen. Natuerlich sieht man Deine Spur auch schon ueberall, weil Du "
    "hier staendig im Kreis herumrennst." );
  AddDetail( "kreis",
    "Da Du dauernd im Kreis gehst, hast Du schon eine schoene Spur im Schnee "
    "hinterlassen." );
  AddDetail( ({ "schneeschicht","schnee" }),
    "Es liegt soviel Schnee, dass Du am liebsten dem Beispiel der Kinder "
    "folgen wuerdest. Ein eigener Schneemann waere schon was feines, aber "
    "fuer solche Spielereien hast Du eigentlich keine Zeit." );
  AddDetail( "beispiel",
    "Lass Dich doch einmal von den Kindern mitreissen und folge ihrem "
    "Beispiel und baue einen Schneemann." );
  AddDetail( ({ "spielerei","spielereien" }),
    "Die Kinder spielen mit den Schlittenhunden, aber fuer soetwas hast Du "
    "keine Zeit." );
  AddDetail( "schneemaenner",
    "Die Kinder bauen immer wieder neue Schneemaenner. Wenn sie keinen Platz "
    "mehr haben, reissen sie einen nieder und stellen dort sofort einen neuen "
    "auf. Du findest sogar ein Plaetzchen, wo Du Deinen eigenen hinstellen "
    "koenntest." );
  AddDetail( "markt",
    "Geh einfach nach Sueden, dann kriegst Du bestimmt mehr davon mit!" );
  AddDetail( ({ "zug","ueberklettern","schlittenhunden","pfaehlen",
                "marktes","dorfes","dreiecks","geruestes","seilen","tieren",
                "durcheinanders","kindern" }),
    "Das kannst Du nicht untersuchen!" );
  AddSpecialDetail( "plaetzchen", "Plaetzchen" );
  AddSpecialDetail( "schneemann", "Schneemann" );
  AddSpecialDetail( "gesicht", "Gesicht" );

  AddSound( DEFAULT_SOUND,
    "Hauptsaechlich hoerst Du die Kinder schreien und die Schlittenhunde "
    "bellen. Vom Sueden hoerst Du die typischen Geraeusche eines Marktes." );
  AddSound( ({ "geraeusche","geraeusch","gerede","schreien" }), #'Geraeusche );
  AddSound( "markt",
    "Du kannst von hier nur das lautere Gerede bzw. das Schreien hoeren." );
  AddSound( ({ "schlittenhunde","hunde","bellen" }),
    "Wrrrrrrrrrrrrrufff! Wruff! Wruff!" );
  AddSound( "kinder", #'KinderLauschen );

  AddSmell( DEFAULT_SMELL,
    "Du atmest die frische Winterluft ein!" ); 
  AddSmell( ({ "winterluft","luft" }),
    "Du nimmst einen ganz tiefen Zug von dieser herrlichen Luft. Aaaah, tut "
    "das gut." );
//END DETAILS

  AddExit( "osten", "./ostplatz_c1" );
  AddExit( "westen", "./ostplatz_a1" );
  AddExit( "sueden", "./ostplatz_b2" );
  AddExit( "suedosten", "./ostplatz_c2" );

  AddItem( NPC "kind", REFRESH_DESTRUCT );
  AddItem( NPC "kind_laufend", REFRESH_DESTRUCT );

  AddCmd( ({ "bau","baue" }), "cmd_bauen" );
  AddCmd( ({ "mach","mache","form","forme" }), "cmd_formen" );
  AddCmd( ({ "stecke","steck" }), "cmd_stecken" );
  AddCmd( ({ "spiel","spiele" }), "cmd_spielen" );
  AddCmd( ({ "setz","setze" }), "cmd_setzen" );
  AddCmd( ({ "wickel","wickl","wickle","bind","binde","knot","knote" }),
          "cmd_wickeln");
  AddCmd( ({ "heb","hebe" }), "cmd_heben" );
}

//SPECIAL DETAILS
string detailTeddybaeren()
{
  if ( present("teddy", TP) )
  {
    return BS(
      "Ausser Deinem Teddy, den Du staendig dabei hast, siehst Du keine "
      "Teddybaeren auf dem Ostplatz. Du hast nur die Kinder kurzzeitig fuer "
      "welche gehalten." );
  }
  return BS(
    "Selbstverstaendlich kannst Du auf dem Ostplatz keine Teddybaeren sehen. "
    "Du hast nur die Kinder kurzzeitig fuer welche gehalten." );
}
string Plaetzchen(string key)
{
  object ob;
  string text;

  text = "Das Plaetzchen eignet sich ideal, um darauf einen Schneemann zu "
         "bauen, denn der Schnee wurde zusammen getreten und die Kinder "
         "laufen Dir nicht staendig im Weg herum.";
  ob = present("\nschneemann",TP);
  if ( ob )
  {
    switch ( ob->GetState() )
    {
      case 0:
        text += " Worauf wartest Du noch? Fang mit dem Bauen an!";
      break;
      case 1:
        text = "Eine grosse Schneekugel liegt auf dem Plaetzchen.";
      break;
      case 2:
        text = "Eine grosse Schneekugel liegt auf dem Plaetzchen und darauf "
               "eine weitere Kugel, die halb so gross ist.";
      break;
      case 3..5:
        text = "Drei Schneekugeln liegen schoen uebereinandergestapelt auf "
	       "dem Plaetzchen.";
      break;
      case 6..9:
        text = "Drei Schneekugeln liegen schoen uebereinandergestapelt auf "
	       "dem Plaetzchen. Ein paar Sachen fehlen dem Schneemann schon "
               "noch!";
      break;
      case 10..12:
        text = "Drei Schneekugeln liegen schoen uebereinandergestapelt auf "
	       "dem Plaetzchen. Das ganze auf Deinem Plaetzchen kann man "
               "schon fast fuer einen Schneemann halten.";
      break;
      case 13..16:
        text = "Drei Schneekugeln liegen schoen uebereinandergestapelt auf "
	       "dem Plaetzchen. Beinahe ist der Schneemann fertig. Es fehlen "
               "nur mehr ein paar Kleinigkeiten.";
      break;
      case 17:
        text = "Ein herrlicher Schneemann, den Du ganz allein gebaut hast, "
	       "steht auf dem Plaetzchen.";
      break;
    }
  }
  return BS( text );
}

string Schneemann(string key)
{
  object ob;
  string text;
  
  text = "";
  ob = present("\nschneemann",TP);
  if ( ob )
  {
    switch ( ob->GetState() )
    {
      case 0:
        text = "Auf dem Plaetzchen wuerde sich ein Schneemann gut machen.";
      break;
      case 1:
        text = "Der Schneemann hat bereits einen Unterleib.";
      break;
      case 2:
        text = "Der Schneemann hat einen Unterleib und einen Oberkoerper.";
      break;
      case 3:
        text = "Der Schneemann hat schon einen Unterleib, einen Oberkoerper "
               "und einen Kopf.";
      break;
      case 4:
        text = "Der Schneemann hat einen Unterleib, einen Oberkoerper und "
	       "einen Kopf. Auf der einen Seite ragt bereits ein Arm heraus.";
      break;
      case 5:
        text = "Der Koerper des Schneemannes ist soweit fertig. Er hat einen "
               "Unterleib, einen Oberkoerper, einen Kopf und zwei Arme. Der " 
               "Kopf allerdings wirkt noch leer.";
      break;
      case 6..16:
        text = "Der Koerper des Schneemannes ist fertig. Er hat einen "
               "Unterleib, einen Oberkoerper, einen Kopf und zwei Arme.";
        if ( ob->QueryStatus(CARROT) )
          text += " Eine schoene Nase ziert das Gesicht.";
        if ( ob->QueryStatus(BROOM) )
          text += " In einer Hand haelt der Schneemann einen Besen.";
        if ( ob->QueryStatus(HAT) )
          text += " Der Schneemann hat einen Zylinderhut auf dem Kopf.";
        if ( ob->QueryStatus(SCARF) )
          text += " Ein Schal wurde um den Hals des Schneemannes gewickelt.";
        switch ( ob->GetCoals() )
	{
          case 1:
            text += " Ein Kohlestueck im unteren Drittel des Kopfes koennte "
                    "auf einen Mund hindeuten.";
	  break;
          case 2:
            text += " Zwei Kohlestuecke im Gesicht deuten einen Mund an.";
	  break;
          case 3:
            text += " Ein Mund aus drei Kohlestuecken laechelt Dich an.";
          break;
          case 4:
            text += " Ein Mund aus drei Kohlestuecken laechelt Dich an. Ein "
                    "Auge blickt Dich an und scheint auf ein zweites zu "
                    "warten.";
	  break;
          case 5:
            text += " Ein Mund aus drei Kohlestuecken laechelt Dich an. Auch "
                    "zwei Augen schmuecken das Gesicht. Eines scheint Dir "
                    "sogar zuzuzwinkern.";
	  break;
        }
        switch ( ob->GetCoals2() )
	{
          case 1:
            text += " Ein Kohlestueck im Oberkoerper stellt wohl einen Knopf "
                    "dar.";
	  break;
          case 2:
            text += " Zwei Kohlestuecke im Oberkoerper stellen wohl Knoepfe "
                    "dar.";
	  break;
          case 3:
            text += " Drei schoene Kohlestueck im Oberkoerper blinzeln Dich "
                    "an. Es sieht so aus, als ob der Schneemann einen Mantel "
                    "traegt."; 
	  break;
        }
      break;
      case 17:
        text = "Vor Dir steht ein Schneemann, den Du ganz allein gebaut hast. "
               "Er hat einen Unterleib, einen Oberkoerper, einen Kopf und "
               "zwei Arme. Aus dem Gesicht blicken Dir zwei Augen entgegen, "
               "ein Mund laechelt Dich an und eine Nase nimmt die Mitte des "
               "Gesichtes ein. Drei Knoepfe im Oberkoerper weisen darauf hin, "
               "dass er einen Mantel traegt. In einer Hand haelt er einen "
               "Besen, auf dem Kopf hat er einen Zylinder und um seinen Hals "
               "hat er einen Schal gewickelt.";
      break;
    }
  return BS( text );
  }
  else
    text = "Noch ist nichts von Deinem eigenen Schneemann zu sehen.";
  return BS( text );
}
   
string Geraeusche(string key)
{
  int i;

  i = random(5);
  switch (i)
  {
    case 0:
      return "Eine Frau ruft empoert: Was? So teuer ist das?\n";
    break;
    case 1:
      return "Ein Mann ruft: Das ist ja Diebstahl!\n";
    break;
    case 2:
      return "Eine Frau klagt: Der totale Wucher! Soviel zahle ich sicher "
             "nicht!\n";
    break;
    case 3:
      return "Ein schlechtgelaunter Mann meint: Bist Du wahnsinnig, soviel "
             "zu verlangen?\n";
    break;
    case 4:
      return "Eine Frau sagt: Mehr als 1000 Muenzen gebe ich Dir dafuer "
             "nicht!\n";
    break;
    default: return 0;
  }
}   

string KinderLauschen(string key)
{
  int i;

  i = random(5);
  switch (i)
  {
    case 0:
      return "Ein Kind ruft: Na warte! Der naechste Schneeball ist fuer "
             "Dich!\n";
    break;
    case 1:
      return "Ein Kind haenselt ein anderes: Trau Dich doch, Du Feigling!\n";
    break;
    case 2:
      return "Ein Kind sagt: Schau mal den Fremden an! Guckt der aber bloed "
             "drein!\n";
    break;
    case 3:
      return "Ein Kind ruft: Brutus! Platz!\n";
    break;
    case 4:
      return "Ein Kind meint: Wetten, ich bin schneller auf der Huette!\n";
    break;
    default: return 0;
  }
}
//END SPECIAL DETAILS

int CheckPlayer(string name)
{
  int i;
  string * names;

  if ( player != "" )
  {
    names = explode(player,";");
    for ( i=0; i < sizeof(names); i++ )
    {
      if ( names[i] == name ) return 1;
    }
  }
  return 0;
}

int SetPlayer(string name)
{
  player = player+";"+name;
}

//COMMANDS
int cmd_spielen(string str)
{
  string wem;

  notify_fail( "Mit wem willst Du hier spielen?\n" );

  if ( !str ) return 0;
  if ( sscanf(str, "mit %s", wem) != 1 ) return 0;
  if ( member( ({ "kind","kindern","kinder" }), wem) != -1 )
  {
    write( BS(
      "Die Kinder wollen aber nicht mit Dir spielen, weil sie von ihren "
      "Eltern gelernt haben, dass sie sich nicht mit Fremden unterhalten "
      "sollen.") );
    return 1;
  }
  else if ( member( ({ "schlittenhund","schlittenhunde","schlittenhunden",
                       "hunden","hund","hunde","husky","huskies"
		     }), wem) != -1 )
  {
    write( BS(
      "Wahnsinnig wie Du bist, versuchst Du mit den Schlittenhunden zu "
      "spielen. Sie scheinen allerdings nicht so zutraulich zu sein, wie Du "
      "Dir das vielleicht dachtest, denn ein Hund bellt Dich an, waehrend ein "
      "anderer Dich ins Bein beisst.") );
    SetProp( P_KILL_NAME, "Ein Hundebiss" );
    TP -> do_damage(random(21));
    write( BS(
      "Du hast noch einmal ein riesen Glueck gehabt, dass Dir nicht mehr "
      "passiert ist. Ich hoffe, das war Dir eine Lehre.") );
    say(
      TPN+" wird von einem Hund gebissen.\n" );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " will mit einem Hund spielen.\n");
    return 1;
  }
}    

int cmd_heben(string str)
{
  object schneemann, klkugel, mgrkugel;
  string was, wohin;

  notify_fail( "Welche Kugel moechtest Du wohin heben?\n" );

  if ( !str ) return 0;
  if ( sscanf(str, "%s auf %s", was, wohin) != 2 ) return 0;
  switch(was)
  {
    case "kleine kugel":
    case "kleine schneekugel": if ( klkugel = present(was, TO) )

      if ( member( ({ "oberkoerper","mittelgrosse kugel",
		      "mittelgrosse schneekugel"
		    }), wohin) != -1 )
      {
        if ( !schneemann = present("\nschneemann",TP) )
	{
          write( BS(
            "Als Du die Schneekugel hochhebst, geraetst Du sofort unter den "
            "Beschuss von Schneebaellen, die die Kinder auf Dich schleudern. "
            "Lass die kleine Kugel dort, wo sie ist!") );
          say( BS(
            "Einige Kinder laufen daher und beschiessen "+TPN+" mit "
            "zahlreichen Schneebaellen.") );
          return -1;
        }
        if ( schneemann->GetState() < 2 )
        {
          write( BS(
            "Das Raufheben bringt im Moment noch nichts, Du musst noch "
            "vorher was anderes machen.") );
          return -1;
        }
        else if ( schneemann->GetState() == 2 )
        {
          write( BS(
            "Du musst Dich ziemlich anstrengen, damit Du die Kugel so hoch "
            "hinauf hebst, aber es gelingt Dir.") );
          say(
	    TPN+" arbeitet fleissig an einem Schneemann.\n" );
          schneemann -> SetState();
          klkugel -> remove();
          write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
            " hat die dritte Kugel vom Schneemann.\n");
          return 1;
        }
        else if ( schneemann->GetState() > 2 )
        {
          write(
	    "Der Kopf sitzt schon auf dem richtigen Platz.\n" );
          return -1;
        }
      }
      else
      {
        write(
	  "Wohin willst Du die kleine Kugel heben?\n" );
	return -1;
      }
    else
    {
      write(
        "Du musst zuerst einmal eine kleine Kugel formen!\n" );
      return -1;
    }
    break;

    case "mittelgrosse kugel":
    case "mittelgrosse schneekugel": if ( mgrkugel = present(was, TO) )

      if ( member( ({ "unterleib","grosse kugel",
		      "grosse schneekugel"
		    }), wohin) != -1 )
      {
        if ( !schneemann=present("\nschneemann",TP) )
	{
          write( BS(
            "Als Du die Schneekugel hochhebst, geraetst Du sofort unter den "
            "Beschuss von Schneebaellen, die die Kinder auf Dich schleudern. "
            "Lass die mittelgrosse Kugel dort, wo sie ist!") );
          say( BS(
            TPN+" geraet unter Beschuss zahlreicher Schneebaelle, die die "
            "Kinder auf "+QueryProp(WEN)+" werfen.") );
          return -1;
        }
        if ( schneemann->GetState() == 0 )
        {
          write( BS(
            "So geht das nicht! Solange kein Unterleib vorhanden ist, hat "
            "der Oberkoerper keinen Sinn.") );
          return -1;
        }
        else if ( schneemann->GetState() == 1 )
        {
          write( BS(
            "Mit all Deiner Kraft hebst Du die Kugel auf den Unterleib des "
            "Schneemannes.") );
          say(
	    TPN+" nimmt die Kugel und baut damit am Schneemann weiter.\n" );
          schneemann -> SetState();
          mgrkugel -> remove();
          write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
            " hebt mittelgrosse Kugel rauf.\n");
          return 1;
        }
        else if ( schneemann->GetState() > 1 )
        {
          write(
	    "Mehr als einen Oberkoerper braucht Dein Schneemann nicht.\n" );
          return -1;
        }
      }
      else
      {
        write(
	  "Wohin willst Du die mittelgrosse Kugel heben?\n" );
	return -1;
      }
    else
    {
      write(
        "Du musst zuerst einmal eine mittelgrosse Kugel formen!\n" );
      return -1;
    }
    break;
  }
}

int cmd_stecken(string str)
{
  object schneemann, karotte, besen, kohle;
  string was, wohin;

  notify_fail( "Was moechtest Du wohin stecken?\n" );

  if ( !str ) return 0;
  if ( sscanf(str, "%s in %s", was, wohin) != 2 ) return 0;
  
  switch(was)
  {
    case "karotte" : if ( karotte = present(was,TP) )

      if ( member( ({ "gesicht","kopf" }),wohin) != -1 )
      {
        if ( !schneemann=present("\nschneemann",TP) )
	{
          write( BS(
            "Die Xandimkinder beschiessen Dich mit Schneebaellen und Du "
            "weisst nicht genau weshalb.") );
          say(
            TPN+" wird mit Schneebaellen beworfen.\n" );
          return -1;
        }
        if ( schneemann->GetState() < 5 )
        {
          write( BS(
            "Zuerst bau einmal den Koerper mit den Gliedmassen, dann kannst "
            "Du am Rest des Schneemannes weiterarbeiten.") );
          return -1;
        }
        if ( schneemann->QueryStatus(CARROT) )
	{
          write(
	    "Dein Schneemann hat schon eine Nase.\n");
          return -1;
        }
        write( BS(
          "Du steckst die Karotte genau in die Mitte vom Gesicht, womit Dein "
          "Schneemann nun eine schoene Nase hat.") );
        say(
          TPN+" arbeitet verbissen an "+
          TP->QueryPossPronoun(MALE,WEM,SINGULAR)+" Schneemann.\n" );
        schneemann -> SetState();
        schneemann -> SetStatus(CARROT);
        karotte -> remove();
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " steckt Karotte in Schneemann.\n");
        return 1;
      }
      else
      {
       write(
         "Die Karotte ergibt dort, wo Du sie hinstecken willst, keinen "
         "Sinn.\n" );
       return -1;
      }
    else
    {
      write(
        "Du hast ja gar keine Karotte dabei.\n" );
      return -1;
    }
    break;

    case "holzkohle":
    case "kohle": if ( kohle = present(was,TP) )
      if ( member( ({ "gesicht","kopf" }),wohin) != -1 )
      {
        if ( !schneemann = present("\nschneemann",TP) )
        {
          write( BS(
            "Die Xandimkinder beschiessen Dich mit Schneebaellen und Du "
            "weisst nicht genau weshalb.") );
          say(
            TPN+" wird mit Schneebaellen beworfen.\n");
          return -1;
        }
        if ( schneemann->GetCoals() < 3 )
	{
          write( BS(
            "Du steckst das Kohlestueck in das untere Drittel des Kopfes, "
            "um damit einen Mund zu formen.") );
          say(
            TPN+" arbeitet verbissen an "+
            TP->QueryPossPronoun(MALE,WEM,SINGULAR)+" Schneemann.\n" );
          schneemann->SetState();
          write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
            " steckt Kohle in Schneemann.\n");
          if ( schneemann->GetCoals() == 0 )
	  {
            schneemann -> SetStatus(COAL1);
            schneemann -> SetCoals();
            kohle -> remove();
            return 1;
          }
          if ( schneemann->GetCoals() == 1 )
	  {
            schneemann -> SetStatus(COAL2);
            schneemann -> SetCoals();
            kohle -> remove();
            return 1;
          }
          if ( schneemann->GetCoals() == 2 )
	  {
            schneemann -> SetStatus(COAL3);
            schneemann -> SetCoals();
            kohle -> remove();
            return 1;
          }
	}
        else if ( schneemann->GetCoals() > 2 && schneemann->GetCoals() < 5 )
	{
          write( BS(
            "Du steckst das Kohlestueck in das obere Drittel des Kopfes, "
            "womit der Schneemann ein Auge erhaelt.") );
          say(
            TPN+" arbeitet verbissen an "+
            TP->QueryPossPronoun(MALE,WEM,SINGULAR)+" Schneemann.\n" );
          schneemann->SetState();
          write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
            " steckt die Kohle ins Gesicht.\n");
          if ( schneemann->GetCoals() == 3 )
	  {
            schneemann -> SetStatus(COAL4);
            schneemann -> SetCoals();
            kohle -> remove();
            return 1;
          }
          if ( schneemann->GetCoals() == 4 )
	  {
            schneemann -> SetStatus(COAL5);
            schneemann -> SetCoals();
            kohle -> remove();
            return 1;
          }
        }
        write( BS(
          "Du brauchst keine Kohlestuecke mehr ins Gesicht des Schneemannes "
          "zu stecken. Er hat schon Augen und einen Mund.") );
        return -1;
      }
      else
      {
        if ( member( ({ "oberkoerper","mittelgrosse schneekugel",
                        "mittelgrosse kugel"
                      }), wohin) != -1 )
        {
          if ( !schneemann = present("\nschneemann",TP) )
          {
            write( BS(
              "Die Xandimkinder beschiessen Dich mit Schneebaellen und Du "
              "weisst nicht genau weshalb.") );
            say(
              TPN+" wird mit Schneebaellen beworfen.\n" );
            return -1;
          }
          if ( schneemann->GetCoals2() < 3 )
	  {
            write( BS(
              "Du steckst das Kohlestueck in den Oberkoerper, damit sein "
              "Mantel auch Knoepfe bekommt.") );
            say(
              TPN+" baut anscheinend gern Schneemaenner.\n" );
            schneemann -> SetState();
            write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
              " steckt die Kohle in den Oberkoerper.\n");
            if ( schneemann->GetCoals2() == 0 )
	    {
              write(
		"Weitere zwei waeren nicht schlecht.\n" );
              schneemann -> SetStatus(COAL6);
              schneemann -> SetCoals2();
              kohle -> remove();
              return 1;
            }
            if ( schneemann->GetCoals2() == 1 )
	    {
              write(
		"Noch ein Knopf waer vorteilhaft.\n" );
              schneemann -> SetStatus(COAL7);
              schneemann -> SetCoals2();
              kohle -> remove();
              return 1;
            }
            if ( schneemann->GetCoals2() == 2 )
	    {
              write(
		"Nun hat er genug Knoepfe.\n" );
              schneemann -> SetStatus(COAL8);
              schneemann -> SetCoals2();
              kohle -> remove();
              return 1;
            }
	  }
          write(
            "Der Oberkoerper Deines Schneemannes hat schon genug Knoepfe.\n" );
          return -1;
        }
        else
        {
          write(
            "Stecke die Kohle an eine andere Stelle. So bringt sie nichts.\n" );
          return -1;
        }
      }
    else
    {
      write(
        "Du hast ja gar keine Kohle dabei.\n" );
      return -1;
    }
    break;

    case "besen": if ( besen = present(was,TP) )
    if ( member( ({ "arm","linker arm","linken arm",
                    "rechten arm","rechter arm"
                  }), wohin) != -1 )
    {
      if ( !schneemann = present("\nschneemann",TP) )
      {
        write( BS(
          "Die Xandimkinder beschiessen Dich mit Schneebaellen und Du weisst "
          "nicht genau weshalb.") );
        say(
          TPN+" wird mit Schneebaellen beworfen.\n" );
        return -1;
      }
      if ( schneemann->QueryStatus(BROOM) )
      {
        write(
	  "Dein Schneemann hat schon einen Besen.\n" );
        return -1;
      }
      write( BS(
        "Zuerst bohrst Du mit Deinem Zeigefinger ein kleines Loch in das "
        "Ende des Armes, setzt den Besen rein, drehst ihn ein paar Mal hin "
        "und her, damit er durchpasst, und sobald das Loch gross genug ist, "
        "steckst Du den Besen durch.") );
      say(
        TPN+" hat dem Schneemann einen schicken Besen verpasst.\n" );
      schneemann -> SetState();
      schneemann -> SetStatus(BROOM);
      besen -> remove();
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " gibt dem Schneemann einen Besen.\n");
      return 1;
    }
    else
    {
      write(
        "Der Besen passt besser an einer anderen Stelle.\n" );
      return -1;
    }
    else
    {
     write(
       "Ohne Besen kannst Du das nicht machen.\n" );
     return -1;
    }
    break;
  }
}

int cmd_wickeln(string str)
{
  object schneemann, schal;
  string was, wohin;

  notify_fail( "Was willst Du um wen wickeln?\n" );

  if ( !str || str == "" ) return 0;
  if ( sscanf(str,"%s um %s", was, wohin) != 2 ) return 0;
  if ( member( ({ "schal","seidenschal" }), was) == -1 )
  {
    notify_fail(" Was willst Du um wen wickeln?\n" );
    return 0;
  }
  if ( member( ({ "kopf","hals" }), wohin) == -1 )
  {
    write(
      "Um was willst Du den Schal wickeln?\n" );
    return -1;
  }
  else
  {
    if ( !schneemann=present("\nschneemann",TP) )
    {
      write( BS(
        "Leider gelingt es Dir nicht, den Schal um den Hals des Schneemannes "
        "zu wickeln, weil die Kinder Dich mit Schneebaellen bewerfen.") );
      say(
	TPN+" wird ploetzlich von Schneebaellen beworfen.\n" );
      return -1;
    }
    if ( (!schal=present("\nSCHAL",TP)) &&
         (!schal=present("\nSTRICKSCHAL",TP)) )
    {
      write(
	"Du hast keinen Schal dabei.\n" );
      return -1;
    }
    if ( schneemann->GetState() < 5 )
    {
      write( BS(
        "Zuerst bau einmal den Koerper mit den Gliedmassen, dann kannst "
        "Du am Rest des Schneemannes weiterarbeiten.") );
      return -1;
    }
    if ( schneemann->QueryStatus(SCARF) )
	{
          write(
	    "Ein Schal wurde bereits um den Hals des Schneemannes "
	    "gewickelt.\n" );
          return -1;
        }
    write( BS(
      "Du wickelst den Schal um den Hals des Schneemannes, damit es ihm "
      "nicht kalt wird.") );
    say(
      TPN+" sorgt dafuer, dass dem Schneemann nicht kalt wird.\n" );
    schneemann -> SetState();
    schneemann -> SetStatus(SCARF);
    schal -> remove();
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " wickelt einen Schal um den Schneemann.\n");
    return 1;
  }
}

int cmd_setzen(string str)
{
  object schneemann, hut;

  notify_fail( "Wem willst Du was aufsetzen?\n" );

  if ( member( ({ "schneemann hut auf",
		  "schneemann zylinderhut auf",
	          "schneemann zylinder auf",
	          "kopf hut auf","kopf zylinder auf",
	          "kopf zylinderhut auf",
	          "hut auf schneemann",
	          "zylinderhut auf schneemann",
                  "zylinder auf schneemann",
                  "hut auf kopf","zylinder auf kopf",
                  "zylinderhut auf kopf"
	        }),str) != -1 )
  {
    if ( !schneemann = present("\nschneemann",TP) )
    {
      write( BS(
        "Kurz bevor Du dem Schneemann den Hut aufsetzen willst, laufen ein "
        "paar Kinder herbei und beschiessen Dich mit Schneebaellen. Du "
        "denkst nur noch: Was habe ich jetzt wieder falsch gemacht?") );
      say(
	TPN+" geraet in eine Schneeballschlacht und geht als Verlierer vom "
        "Platz.\n" );
      return -1;
    }
    if ( !hut = present("\nZYLINDER",TP) )
    {
      write(
	"Dieser Hut ist nicht fuer den Schneemann geeignet.\n" );
      return -1;
    }
    if ( schneemann->GetState() < 5 )
    {
      write( BS(
        "Zuerst bau einmal den Koerper mit den Gliedmassen, dann kannst "
        "Du am Rest des Schneemannes weiterarbeiten.") );
      return -1;
    }
    if ( schneemann->QueryStatus(HAT) )
    {
      write(
	"Auf dem Kopf des Schneemannes sitzt schon ein Hut.\n" );
      return -1;
    }
    write(
      "Du setzt dem Schneemann einen schoenen Zylinder auf, der ihm ganz "
      "gut passt.\n" );
    say(
      TPN+" sorgt dafuer, dass dem Schneemann nicht kalt wird.\n");
    schneemann -> SetState();
    schneemann -> SetStatus(HAT);
    hut -> remove();
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " setzt dem Schneemann einen Hut auf.\n");
    return 1;
  }
}

int cmd_bauen(string str)
{
  object schneemann;  

  if ( member( ({ "schneemann" }), str) != -1 )
  {
    if ( !schneemann = present("\nschneemann",TP) )
    {
      write( BS(
        "Genau in dem Moment, in dem die Kinder Deine Absicht erkennen, "
        "formen sie rasch Schneebaelle und werfen sie auf Dich! Da Du "
        "so beim besten Willen nicht arbeiten kannst, brichst Du das "
        "ganze gleich wieder ab.") );
      say( BS(
          TPN+" versucht einen Schneemann zu bauen, "+
          TP->QueryPronoun(WER)+" wird aber durch zahlreiche Schneebaelle, "
          "die die Kinder auf "+TP->QueryPronoun(WEN)+" werfen, daran "
          "gehindert.") );
      return -1;
    }
    write( BS(
      "Halt! Halt! So einfach geht das nicht, wie Du Dir das vorstellst. "
      "Glaubst Du, Du kannst ruckzuck einen Schneemann hinstellen? "
      "Ueberlege mal, was alles zu einem Schneemann gehoert, dann faengst "
      "Du noch einmal von vorne an. Ein Tip: Koerper, Arme, Kopf waeren "
      "sicher eine gute Idee!") );
    return 1;
  }
  write( BS(
    "Was moechtest Du gern bauen?\n" ) );
  return -1;
}

int cmd_formen(string str)
{
  object schneemann;
  object grkugel, mgrkugel, klkugel, arm;
  
  if ( schneemann = present("\nschneemann",TP) )
  {
    if ( member( ({ "schneeball","ball aus schnee","ball",
                    "kugel","schneekugel","kugel aus schnee"
	          }), str) != -1 )
    {
      write( BS(
        "Schoen und gut, aber wie gross soll die Schneekugel sein? Willst Du "
        "eine grosse, eine mittelgrosse oder eine kleine formen?") );
      return -1;
    }  
    else if ( member( ({ "grosse kugel","grosse schneekugel",
                         "grosse kugel aus schnee"
          	       }), str) != -1 )
    {
      if ( !present("\ngrkugel", TO) )
      {
        write( BS(
          "Du greifst in den Schnee, formst Dir einen kleinen Schneeball, "
          "rollst ihn ueber den Schnee, bis er einen Durchmesser von "
          "einem Meter hat, und stellst ihn vor Dir ab.") );
        say(
          TPN+" formt eine Kugel aus Schnee.\n" );
        grkugel = clone_object(OBJ "grkugel");
        grkugel -> move(TO,M_GO);
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " formt grosse Kugel.\n");
        return 1;
      }
      write( BS(
        "Du brauchst keine grosse Schneekugel zu formen, es liegt ohnehin "
        "eine vor Deinen Augen.") );
      return -1;
    }
    else if ( member( ({ "mittelgrosse kugel","mittelgrosse schneekugel",
                         "mittelgrosse kugel aus schnee"
          	       }), str) != -1 )
    {
      if ( !present("\nmgrkugel", TO) )
      {
        write( BS(
          "Du greifst in den Schnee, formst einen Schneeball, den Du darauf "
          "ueber den Platz rollst, bis er einen Durchmesser von einem "
          "halben Meter hat. Da das so anstrengend war, stellst Du ihn "
          "vorlaeufig vor Dir ab.") );
        say(
          TPN+" formt eine Kugel aus Schnee.\n" );
        mgrkugel = clone_object(OBJ "mgrkugel");
        mgrkugel -> move(TO,M_GO);
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " formt mittelgrosse Kugel.\n");
        return 1;
      }
      write( BS(
        "Du brauchst keine mittelgrosse Schneekugel zu formen, es liegt "
        "eine vor Deinen Fuessen.") );
      return -1;
    }
    else if ( member( ({ "kleine kugel","kleine schneekugel",
                         "kleine kugel aus schnee"
            	       }), str) != -1 )
    {
      if ( !present("\nklkugel", TO) )
      {
        write( BS(
          "Du greifst in den Schnee, formst einen Schneeball, rollst ihn "
          "ihn kurz ueber den Schnee, bis er einen Durchmesser von 30 "
          "Zentimter hat, und laesst ihn vor Dir liegen.") );
        say(
          TPN+" formt eine Kugel aus Schnee.\n" );
        klkugel = clone_object(OBJ "klkugel");
        klkugel -> move(TO,M_GO);
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " formt kleine Kugel.\n");
        return 1;
      }
      write( BS(
        "Du brauchst keine kleine Schneekugel zu formen, es liegt "
        "eine genau vor Dir herum.") );
      return -1;
    }
  else if ( member( ({ "arm","arm aus schnee",
		       "arme", "arme aus schnee",
                       "rolle","rolle aus schnee",
                       "schneerolle"
            	     }), str) != -1 )
    {
      if ( !present("\narm", TO) )
      {
        write( BS(
          "Du greifst in den Schnee, formst einen Schneeball, rollst ihn "
          "zu einer 50 Zentimeter langen Rolle aus und goennst Dir eine "
          "kleine Pause.") );
        say(
          TPN+" formt eine Rolle aus Schnee.\n" );
        arm = clone_object(OBJ "arm");
        arm -> move(TO,M_GO);
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " formt einen Arm.\n");
        return 1;
      }
      write( BS(
        "Du brauchst keine Schneerolle zu formen, es liegt eine genau vor "
        "Dir herum.") );
      return -1;
    }
    write(
      "Was wuerdest Du gern formen?\n ");
    return -1;
  }
  write( BS(
    "Genau in dem Moment, in dem die Kinder Deine Absicht erkennen, formen "
    "sie rasch Schneebaelle und werfen sie auf Dich! Da Du so beim besten "
    "Willen nicht arbeiten kannst, brichst Du das ganze gleich wieder ab.") );
  say(
    TPN+" geraet in eine kleine Schneeballschlacht.\n");
  return -1;
}
//END COMMANDS

void reset()
{
  ::reset();
  player = "";
}

void exit()
{
  ::exit();
  
  call_out("aruhis", 0);
}
void aruhis()
{
  object vater, mutter;
  
  if ( vater = present("\nxandimvater") )
  {
    if ( !vater -> InFight() )
    {
      vater -> move("/room/npcasylraum", M_GO|M_NOCHECK );
      vater -> remove();
    }
  }
  if ( mutter = present("\nxandimmutter") )
  {
    if ( !mutter -> InFight() )
    {
      mutter -> move("/room/npcasylraum", M_GO|M_NOCHECK );
      mutter -> remove();
    }
  }
}
