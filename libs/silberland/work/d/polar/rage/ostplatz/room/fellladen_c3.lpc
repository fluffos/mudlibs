void Setdreck()
{
  schrift = "HERZLICH WILLKOMMEN!";
  dreck = 0;	
}

int Getdreck()
{
  return dreck;
}
int Dreckiger()
{
  dreck++;
}

int matte_da()
{
  return 1;
}

void Setverstaubt()
{
  verstaubt = 1;
}
//COMMANDS
int cmd_streifen(string str)
{
  int i, schuhwerk_getragen;
  string was, dummy, worauf;
  object *schuhwerk;

 
  schuhwerk = TP->QueryProp(P_ARMOURS);
  for ( i=sizeof(schuhwerk); i-->0; )
  {
    if ( schuhwerk[i]->QueryProp(P_ARMOUR_TYPE) == AT_BOOT )
    {
      schuhwerk_getragen = 1;
      break;
    }
  }

  notify_fail( "Was willst Du wo abstreifen?\n" );

  if ( !str ) return 0;
  if ( sscanf(str, "%s %s %s ab", was, dummy, worauf) != 3 ) return 0;
  if ( member( ({ "auf","an" }), dummy) == -1 ) return 0;
  if ( member( ({ "fuesse" }),was) != -1 )
  {
    if ( member( ({ "matte","fussmatte" }), worauf) != -1 )
    {
      if ( schuhwerk_getragen )
      {
        write( BS(
          "Du hast doch "+schuhwerk[i]->name(WER)+" an. Das musst Du schon "
          "ausziehen, um die Fuesse abstreifen zu koennen.") );
        return -1;
      }
      write( BS(
        "Aufmerksam und reinlich wie Du bist, gehst Du zu einer Fussmatte hin "
        "und streifst Dir Deine Fuesse darauf ab, damit Du nicht den ganzen "
        "Schnee von draussen im Laden verbreitest.") );
      say(
        TPN+" streift sich "+TP->QueryPossPronoun(MALE,WEN,PLURAL)+
        " Fuesse ab.\n" );
      if ( Getdreck() < 4 ) schriftzug();
      dreck++;
      if ( Getdreck() > 3 )
        write(
      	  "Die Fussmatte ist dadurch schon ganz schoen schmutzig "
      	  "geworden!\n" );
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " streift sich draussen Fuesse ab.\n");
      return 1;
    }
    notify_fail( "Worauf willst Du Deine Fuesse abstreifen?\n" );
  }

  if ( member( ({ "stiefel","schuhe","sandalen" }),was) != -1 )
  {
    if ( member( ({ "matte","fussmatte" }), worauf) != -1 )
    {
      if ( !schuhwerk_getragen )
      {
        write(
  	  "Du bist doch barfuss! Du kannst Dir nur Deine Fuesse abstreifen.\n" );
        return -1;
      }
      write( BS(
        "Aufmerksam und reinlich wie Du bist, gehst Du zu einer Fussmatte "
        "hin und streifst Dir Deine "+schuhwerk[i]->Name(WEN)+" darauf "
        "ab, damit Du nicht den ganzen Schnee von draussen im Laden "
        "verbreitest.") );
      say(
        TPN+" streift sich "+TP->QueryPossPronoun(FEMALE,WEN,PLURAL)+" "+
        schuhwerk[i]->Name(WEN)+" ab.\n" );
      if ( Getdreck() < 4 ) schriftzug();
      dreck++;
      if ( Getdreck() > 3 )
        write(
      	  "Die Fussmatte ist dadurch schon ganz schoen schmutzig "
      	  "geworden!\n" );
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " streift sich draussen Stiefel ab.\n");
      return 1;
    }
    if ( !schuhwerk_getragen )
    {
      write(
        "Du bist doch barfuss! Du kannst Dir nur Deine Fuesse abstreifen.\n" );
      return -1;
    }
    notify_fail( "Worauf willst Du Deine "+schuhwerk[i]->Name(WEN)+
                 " abstreifen?\n" );
  }
}

int cmd_sitzen(string str)
{
  notify_fail( "Worauf willst Du Dich setzen?\n" );
  
  if ( member( ({ "auf bank","auf holzbank",
                  "auf die bank","auf die holzbank",
                  "dich auf bank","dich auf holzbank",
                  "dich auf die bank","dich auf die holzbank"
                }),str) != -1 )
  {
    write( BS(
      "Fuer einen Augenblick ueberlegst Du Dir, Dich auf die Bank zu setzen, "
      "aber dann bist Du der Meinung, dass sie Dir doch zu unbequem "
      "erscheint, weshalb Du stehenbleibst.") );
    say( BS(
      TPN+" scheint sich, auf die Bank setzen zu wollen, ueberlegt es sich "
      "allerdings doch anders.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " will sich auf die Bank setzen.\n");
    return 1;
  }
}  

int cmd_stehlen(string str)
{
  int zufall;	
  object fell, schwarzfell;
  
  notify_fail( "Du willst doch nicht etwa ein Fell mitgehen lassen?\n" );
  
  if ( !str || str == "" ) return 0;

  fell = FindInStore(str);

  if ( !objectp(fell) )
  {
    write( BS(
      "Du bist mir vielleicht ein Dieb! Du willst was klauen, was nicht "
      "einmal da ist. Du bist eine Schande fuer alle Diebe.") );
    return -1;
  }
  if ( str == "fell" )
  {
    write( BS(
      "Du musst schon genauer sein, alle Felle auf einmal kannst Du nicht "
      "stehlen. Also: Welches Fell willst Du nun stehlen?") );
    return -1;
  }
  if ( !schwarzfell=present("schwarzfell",ENV(TP)) )
  {
    write( BS(
      "Ein Fell zu stehlen, ohne dass Schwarzfell da ist, ist kein "
      "Anreiz fuer Dich, deshalb laesst Du es bleiben.") );
    return -1;
  }
  switch ( TP->QueryAttribute(A_DEX) )
  {
    case -20..5:
      zufall=28;
    break;
    case 6..10:
      zufall=24;
    break;
    case 11..15:
      zufall=20;
    break;
    case 16..20:
      zufall=16;
    break;
    case 21..25:
      zufall=12;
    break;
    case 26..30:
      zufall=8;
    break;
    case 31..50:
      zufall=4;
    break;
    default:
      zufall=70;
    break;    
  }
  if ( !random(zufall) )
  {
    if ( ME_TOO_HEAVY == fell->move(TP,M_GET|M_SILENT) )
    {
      write( BS(
        "Du kannst den Moment der Unaufmerksamkeit des Haendlers ausnuetzen, "
        "um "+fell->name(WEN)+" zu stehlen, doch es ist Dir zu schwer und Du "
        "musst den Versuch abbrechen.") );
      return -1;
    }
    write( BS(
      "In einem Augenblick, in dem Dich Schwarzfell nicht beobachtet, nimmst "
      "Du ganz unauffaellig "+fell->name(WEN)+" aus dem Regal und freust Dich "
      "ungemein ueber diese Schurkerei.") );
    say( BS(
      "Du kannst es gar nicht fassen, aber "+TPN+" klaut einfach so "
      +fell->name(WEN)+" aus dem Regal.") ); 
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " stiehlt ein Fell.\n");
    return 1;
  }
  if ( member(verwarnt,getuid(TP)) != -1 )
  {
    write(
      "Obwohl Du vom Haendler gewarnt wurdest, es kein zweites Mal zu "
      "probieren, ein\n"
      "Fell zu stehlen, versuchst Du es noch einmal und ... scheiterst "
      "klaeglich.\n"
      "Schwarzfell sieht Dich naemlich gerade, wie Du "+fell->name(WEN)+
      " einstecken\n"
      "willst.\n"
      "Schwarzfell schreit: DAS WARS, "+upperstring(TPN)+"! RAUS MIT DIR!\n" );
    /*if ( random(2) )*/
      TP -> move( ROOM "ostplatz_c2", M_GO, "", "wird von Schwarzfell bei "
            "einem Diebstahlversucht ertappt und aus dem Laden verwiesen",
            "fliegt aus dem Laden");
    /*else
      TP -> move(ROOM "ostplatz_d3", M_GO|M_SILENT);*/
    write( BS(
      "Das hast Du ja jetzt spitze hingekriegt! Nun musst Du bei der "
      "Kaelte im Schnee stehen, weil Du zu dumm bist, ein Fell zu klauen.") );
    laden_verbot += ({ getuid(TP) });
    verwarnt -= ({ getuid(TP) });
    return -1;
  }
  write(
    "Du versuchst unauffaellig "+fell->name(WEN)+" zu stehlen, doch der "
    "Haendler ertappt\n"
    "Dich dabei.\n"
    "Schwarzfell sagt erzuernt: Wenn ich Dich noch einmal dabei ertappe, "
    "dann werfe\n"
    "Schwarzfell sagt erzuernt: ich Dich aus dem Laden raus!\n" );
  say(
    TPN+" wird von Schwarzfell beim Diebstahl ertappt.\n"
    "Schwarzfell sagt erzuernt: Wenn ich doch nocheinmal erwische, "
    +TPN+", dann werfe\n"
    "Schwarzfell sagt erzuernt: ich Dich aus meinem Laden raus!\n");
  verwarnt += ({ getuid(TP)} );
  return -1;
}

int cmd_schliessen(string str)
{
  notify_fail( "Was moechtest Du hier schliessen?\n" );
  
  if ( !str || str == "") return 0;
  
  if ( str == "tueren" )
  {
    write( BS(
      "Du kannst doch nicht alle Tueren auf einmal schliessen. Nur eine "
      "nach der anderen.") );
    return -1;
  }
  if ( str == "tuer" )
  {
    write( BS(
      "Du gehst zur Tuer hin, versuchst sie zu schliessen, aber sie bewegt "
      "sich keinen Millimeter. Probier es mal mit Gewalt!") );
    say(
      TPN+" will anscheinend die Tuer schliessen, was "+
      TP->QueryPronoun(WEM)+" nicht gelingen will.\n" );
    return -1;
  }
  if ( str == "tuer mit gewalt" )
  {
    write( BS(
      "Du zerrst und ruettelst an der Tuer, aber sie laesst sich trotzdem "
      "nicht schliessen. Du meinst, dass sich die Unterseite der Tuer mit "
      "dem Boden verklemmt hat und laesst deshalb von Deinem Versuch ab.") );    
    say( BS(
      TPN+" ruettelt und zerrt wie wild an der Tuer, doch die Tuer bleibt "
      "offen. Wahrscheinlich klemmt die Tuer oder "+TPN+" ist einfach zu "
      "schwach dazu und Du solltest es am besten versuchen.") );
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " will Tuer schliessen.\n");
    return 1;
  }  
}

int cmd_haengen(string str)
{
  object buerste, klopfer;
  string was, dummy, wohin;

  notify_fail( "Was moechtest Du wo aufhaengen?\n" );

  if ( !str ) return 0;
  if ( sscanf(str, "%s %s %s", was, dummy, wohin) != 3 ) return 0;

  if ( member( ({ "buerste","drahtbuerste" }), was) != -1 )
  {
    if ( member( ({ "auf","an" }), dummy) == -1 )
    {
      write(
        "Willst Du etwas irgendwo AUFhaengen?\n" );
      return -1;
    }
    if ( member( ({ "haken","den haken",
                    "haken auf","den haken auf"
                  }), wohin) != -1 )
    {
      if ( !buerste=present("\ndrahtbuerste",TP) )
      {
        write( BS(
  	  "Zuerst einmal die Buerste besitzen, die fuer diesen Haken "
          "gedacht ist.") );
        return -1;
      }
      if ( buerste_da )
      {
        write( BS(
          "Auf dem Haken haengt doch schon eine Buerste. Eine zweite passt "
          "nicht drauf.") );
        return -1;
      }
      if ( buerste->knoten() )
      {
      	write( BS(
          "Du meinst, dass Du die Drahtbuerste nicht mehr brauchen wirst und "
          "haengst sie deshalb auf den Haken zurueck.") );
        say(
          TPN+" haengt eine Buerste auf einen Haken auf.\n");
        buerste -> remove(1);
        buerste_da = 1;
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " haengt Buerste auf.\n");
        return 1;
      }
      write( BS(
        "Deine Buerste hat leider keine Schnur und somit kannst Du sie auch "
        "nicht auf den Haken zurueckhaengen.") );  
      return -1;
    }
    notify_fail( "Willst Du etwas auf den Haken haengen?\n" );
  }
  if ( member( ({ "pracker","klopfer","teppichklopfer" }), was) != -1 )
  {
    if ( member( ({ "nagel","den nagel",
                    "nagel auf","den nagel auf"
                  }), wohin) != -1 )
    {
      if ( !klopfer=present("\nklopfer",TP) )
      {
        write( BS(
  	  "Ohne Teppichklopfer wird das nichts werden!") );
        return -1;
      }
      if ( klopfer_da )
      {
        write( BS(
          "Wenn Du Dich vorher genauer umgesehen haettest, haettest Du auch "
          "gesehen, dass auf dem Nagel bereits ein Klopfer ist. Fuer zwei ist "
          "eindeutig kein Platz.") );
        return -1;
      }
      write( BS(
        "Sorgfaeltig wie Du bist, haengst Du den Teppichklopfer wieder auf "
        "den Nagel zurueck, weil Du meinst, dass Du ihn nicht mehr brauchen "
        "wirst.") );
      say(
        TPN+" haengt einen Teppichklopfer auf einen Nagel auf.\n");
      klopfer -> remove(1);
      klopfer_da = 1;
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " haengt Klopfer auf.\n");
      return 1;
    }
    notify_fail( "Willst Du etwas auf den Nagel haengen?\n" );
  }
}

int cmd_legen(string str)
{
  object ob;
  string was, wohin;
  int geld;

  notify_fail( "Was moechtest Du wo hinlegen?\n" );
  
  if ( !str || str == "" ) return 0;
  if ( sscanf( str,"%s in %s", was, wohin) != 2 ) return 0;
  ob = present(was, TP);
  if ( !ob )
  {
    write( BS(
      "Das hast Du gar nicht bei Dir!") );
    return -1;
  }
  if ( ob->id("raeudiges wolfsfell") && ob->QueryProp(P_FELL_AUS_LADEN) )
  {
    if ( member( ({ "regal","in das regal" }), wohin) != -1 )
    {
      write( BS(
        "In welches Regal willst Du das raeudige Wolfsfell legen? Es gibt "
        "schliesslich vier verschiedene im Laden.") );
      return -1;
    }
    else if ( member( ({ "breites regal","weisses regal",
                         "das breite regal","das weisse regal",
                         "kleines regal","dunkelbraunes regal",
                         "das kleine regal","das dunkelbraune regal",
                         "grosses regal","schwarzes regal",
                         "das grosse regal","das schwarze regal"
                       }), wohin) != -1 )
    {
      write( BS(
        "Schwarzfell sagt: "+TPN+", das Fell gehoert in das hohe Regal.") );
      return -1;
    }
    else if ( member( ({ "hohes regal","hellbraunes regal",
                         "das hohe regal","das hellbraune regal"
                       }), wohin) != -1 )
    {
      if ( present("\nhqwfell", find_object(ROOM "felllager")) )
      { 
      	write( BS(
      	  "Genau dort, wo Du das Fell hinlegen willst, liegt bereits eines.") );
      	return -1;
      }
      if ( ob->QueryProp(P_FELL_AUS_LADEN) )
      {
        if ( ob->QueryProp(P_VERSTAUBTES_FELL) )
        {
          write( BS(
            "Du willst doch nicht das verstaubte Fell wieder ins Regal "
            "zuruecklegen? Was soll den Schwarzfell von Dir denken? Mach es "
            "einfach sauber und lege es dann ins Regal!") );
          return -1;
        }
        if ( ob->QueryProp(P_FELL_ABGELEGT) )
        {
          write(
            "Du legst das saubere Wolfsfell ins Regal zurueck.\n" );
          say( BS(
            TPN+" legt ein raeudiges Wolfsfell in das Regal an der "
            "Nordwand.") );
          verstaubt = 0;
          ob -> move(ROOM "felllager", M_SILENT);
          return -1;
        }
        geld = 50 + random(100);
        write(
          "Du legst das saubere Wolfsfell ins Regal zurueck.\n"
          "Schwarzfell sagt: Hier ein kleines Dankeschoen fuer Deine Muehen, mir das\n"
          "Schwarzfell sagt: Fell wieder sauber zurueckzugeben.\n"
          "Schwarzfell ueberreicht Dir "+geld+" Muenzen.\n" );
        say( BS(
          TPN+" ein raeudiges Wolfsfell in das Regal an der Nordwand.") );
        TP -> AddMoney(geld);
        verstaubt = 0;
        ob -> SetProp( P_FELL_ABGELEGT, 1 );
        ob -> move(ROOM "felllager", M_SILENT);
        write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
          " legt sauberes Fell zurueck.\n");
        return 1;
      }
      write( BS(
        "Dieses Fell brauchst Du nicht in das Regal zu legen, denn es wurde "
        "nicht von hier genommen.") );
      return -1;
    } 
    write( BS(
      "Du musst das Fell schon in ein Regal legen!") );
    return -1;
  }
  /* write( BS(
    "Es bringt nichts, "+ob->name(WEN)+" hier irgendwo hinzulegen.") );
    return -1;*/
}

int cmd_nehmen(string str)
{
  object buerste, klopfer, ob;

  if ( !str || str == "" ) return 0;

  ob = FindInStore(str);

  if ( objectp(ob) )
  {
    if ( ob->id("raeudiges wolfsfell") )
    {
      if ( ME_TOO_HEAVY == ob->move(TP,M_GET|M_SILENT) )
      {
      	write( BS(
          "Du aegerst Dich furchtbar, weil das Fell Dir im Moment zu "
          "schwer ist.") );
        return -1;
      }
      if ( ob->QueryProp(P_FELL_ABGELEGT) )
      {
        write(
          "Du nimmst ein raeudiges Wolfsfell aus dem Regal.\n" );
        say(
          TPN+" nimmt sich ein Fell aus dem Regal.\n" );
        return -1;
      }
      write( BS(
        "Du nimmst das Wolfsfell aus dem Regal, um es fuer den Haendler "
        "sauber zu machen.") );
      say(
        TPN+" nimmt sich ein Fell aus dem Regal.\n" );
      ob -> SetProp( P_FELL_AUS_LADEN, 1 );
      ob -> SetProp( P_VERSTAUBTES_FELL, 1 );
      ob -> SetProp( P_LONG, ob->QueryProp(P_LONG)+"Es ist sehr staubig, denn "
        "es ist schon lange herumgelegen." );
      ob -> SetProp( P_INFO, "Das Fell ist ja wirklich furchtbar staubig. "
        "Vielleicht sollte man etwas gegen den Staub machen?" );  
      write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
        " nimmt Wolfsfell.\n");
      return 1;
    }
    write( BS(
      "Du kannst "+ob->name(WEN)+" nicht einfach so nehmen. Wenn Du es haben "
      "willst, musst Du es schon kaufen oder stehlen.") );
    return -1;
  }  
  else if ( member( ({ "klopfer","teppichklopfer" }),str) != -1 )
  {
    if ( !klopfer_da )
    {
      write( BS(
	"Auf dem Nagel des Regals ist im Moment kein Teppichklopfer zu sehen.") );
      return -1;
    }
    if ( klopfer = present("\nklopfer",TP) )
    {
      write( BS(
        "Du meinst, dass Dir ein Teppichklopfer reicht, weshalb Du diesen "
        "fuer andere zuruecklaesst.") );
      return -1;
    }
    klopfer = clone_object(WEAPON "klopfer");
    if ( ME_TOO_HEAVY == klopfer->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Du schleppst zuviel mit Dir rum. Lege zuerst was weg.\n" );
      klopfer -> remove();
      return -1;
    }
    write( BS(
      "Du nimmst den Teppichklopfer vom Nagel und meinst, dass Du ihn "
      "sicher noch brauchen wirst.") );
    say( BS(
      TPN+" geht zu dem Regal an der Nordwand und holt etwas von dort.") );
    klopfer_da = 0;
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " nimmt einen Teppichklopfer.\n");
    return 1;
  }
  else if ( str == "buerste" )
  {
    if ( !buerste_da )
    {
      write( BS(
	"Auf dem Haken ist keine Buerste, die Du nehmen koenntest.") );
      return -1;
    }
    if ( buerste = present("\ndrahtbuerste",TP) )
    {
      write( BS(
        "Bitte sei doch nicht so gierig. Eine Drahtbuerste wird Dir "
        "doch reichen.") );
      return -1;
    }
    buerste = clone_object(OBJ "dbuerste");
    if ( ME_TOO_HEAVY == buerste->move(TP,M_GET|M_SILENT) )
    {
      write(
        "Die Buerste ist Dir zu schwer.");
      buerste -> remove();
      return -1;
    }
    write( BS(
      "Du gehst zur Wand, in die der Haken geschlagen wurde, und nimmst die "
      "Buerste vom Haken herunter.") );
    say( BS(
      TPN+" geht zu dem Regal an der Rueckwand und nimmt sich etwas von "
      "einem Haken.") );
    buerste_da = 0;
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " nimmt eine Buerste.\n");
    return 1;
  }
}

int cmd_trinken(string str)
{
  notify_fail( "Was willst Du trinken?\n" );

  if ( str == "wasser" )
    notify_fail( "Du willst das Wasser aus der Pfuetze trinken?\n" );

  if ( member( ({ "wasser aus pfuetze",
                  "wasser aus der pfuetze"
                }), str) != -1 )
  {
    if ( !wasser )
    {
      write( BS(
        "Das Wasser in der Pfuetze reicht nicht aus, um Deinen Durst stillen "
        "zu koennen.") );
      return -1;
    }
    write( BS(
      "Du legst Dich auf den Boden und schleckst wie ein Hund aus einem Napf "
      "das Wasser auf dem Boden.") );
    say( BS(
      TPN+" kriegt wohl zuhause nichts zum Trinken, denn "
      +TP->QueryPronoun(WER)+" kriecht wie ein Hund vor einem Napf am Boden, "
      "um das Wasser aufzuschlecken.") );
    wasser--;
    write_file(LOG "forsch.log",ctime()+": "+CAP(getuid(TP))+
      " trinkt Wasser aus einer Pfuetze.\n");
    return 1;
  }
}
void init()
{
  ::init();
  if ( TP && interactive(TP) )
    call_out( "rauswerfen", 0, TP );
} 

void rauswerfen()
{
  object schwarzfell;
  
  if ( member(laden_verbot,getuid(TP)) != -1 &&
       schwarzfell = present("schwarzfell",ENV(TP)) )
  {
    tell_room( ENV(TP),
      "Schwarzfell bruellt: "+upperstring(TPN)+", DU DIEB! VERSCHWINDE AUS "
      "MEINEM LADEN!\n");
    write( BS(
      "Du wirst hochkannt aus dem Laden geworfen. Schwarzfell scheint noch "
      "nicht vergessen zu haben, dass Du ihn bestehlen wolltest.") );
    say(
      TPN+" wird hochkannt von Schwarzfell aus dem Laden geworfen.\n" );
    /*if ( random(2) )*/
      TP -> move( ROOM "ostplatz_c2", M_GO|M_SILENT);
  /*  else
      TP -> move(ROOM "ostplatz_d3", M_GO|M_SILENT); */
  }
}

void reset()
{
  ::reset();

  if ( buerste_da != 1 ) buerste_da = 1;
  if ( klopfer_da != 1 ) klopfer_da = 1;
  wasser = 5+random(6);
  verwarnt = ({});
  laden_verbot = ({});
  staub_entdeckt = ({});
}
//COMMANDS END

//Ladenspezifische COMMANDS
int show_obj(string str)
{
  int i;
  string was, dummy, beschreibung;
  mixed ob;
  string prefix;
  mapping restr;

  if ( !str ) return 0;
  prefix = CheckKeeper(1);
  if ( sscanf(str,"%s in laden",was) > 0 )
  {
    if ( TP->InFight() ) 
    {
      write( BS(
        "Du bist mitten in einem Kampf, konzentriere Dich besser darauf!") );
      return 1;
    }
    if ( !prefix ) return CheckKeeper(), 1;
    if ( !ob = FindInStore(was) )
    {
      write( BS(
        prefix+"Es tut mir leid, aber so etwas habe ich nicht lagernd.") );
      return 1;
    }
  }
  else if ( sscanf(str,"%d",i) > 0 && (i > 0) && (to_string(i) == str) )
  {
    if ( TP->InFight() ) 
    {
      write( BS(
        "Du bist mitten in einem Kampf, konzentriere Dich besser darauf!") );
      return 1;
    }
    if ( !prefix)  return CheckKeeper(), 1;
    if ( !ob = FindInStore(i) )
      return _notify_fail( prefix+"Es tut mir leid, aber so etwas habe ich "
                           "nicht lagernd.\n" ), 0;
  }
  else return 0;
  i = QueryBuyValue(ob);
  
  if ( ob->id("\nhqbfell") )
  {
    write( BS(
      "Im mittleren Fach des Regals an der Rueckwand wurden ein paar "
      "Baerenfelle gestapelt.") );
  }    
  else if ( ob->id("braunbaerenfell") )
  {
    write( BS(
      "Die Braunbaerenfelle liegen in dem Regal an der Rueckwand, "
      "da dieses gross genug ist.") );
  }
  else if ( ob->id("\nhqwfell") )
  {
    if ( verstaubt )
    {	
      write( BS(
        "Ein einzelnes Fell liegt scheinbar schon seit Ewigkeiten im zweiten "
        "Fach des hohen Regals, denn es ist einwenig mit Staub bedeckt.") );
      staub_entdeckt += ({ getuid(TP) });
    }
    else
      write( BS(
        "Das Fell liegt im zweiten Fach des hohen Regals.") );
  }
  else if ( ob->id("wolfsfell") )
  {
    write( BS(
      "In dem dritten Fach des Regals an der Nordwand wurden einige "
      "Wolfsfelle gestapelt.") );
  }
  else if ( ob->id("igelfell") )
  {
    write( BS(
      "Ein paar Igelfelle liegen ganz oben im kleinen Regal an "
      "der Ostwand.") );
  }
  else if ( ob->id("pumafell") )
  {
    write( BS(
      "Die Pumafelle liegen ganz oben im Regal an der Nordwand.") );
  }
  else if ( ob->id("grizzlyfell") )
  {
    write( BS(
      "Die Grizzlyfelle hat Schwarzfell direkt hinter sich im Regal an der "
      "Rueckwand eingeschlichtet.") );
  }
  else if ( ob->id("bueffelfell") )
  {
    write( BS(
      "Praechtige Bueffelfelle liegen im Regal an der Westwand. Du denkst "
      ". o O (Woher Schwarzfell die wohl hat? Bueffel im Polargebiet?)") );
  }
  else if ( ob->id("otterfell") )
  {
    write( BS(
      "Im untersten Fach des kleinen Regals liegen ein paar Otterfelle.") );
  }
  else if ( ob->id("fellchen") )
  {
    write( BS(
      "Ein Wuslerfell liegt im obersten Fach des Regals an der Ostwand.") );
  }
  else if ( ob->id("fuchsfell") )
  {
    write( BS(
      "Im untersten Fach des Regals an der Nordwand liegen ein paar schoene "
      "Fuchsfelle.") );
  }
  else if ( ob->id("biberfell") )
  {
    write( BS(
      "Mehrere Biberfelle wurden in das mittlere Fach des Regals an der "
      "Ostwand geschlichtet.") );
  }
  else if ( ob->id("yetifell") )
  {
    write( BS(
      "Im unteren Fach des Regal an der Westwand liegen ein paar Yetifelle.") );
  }
 
  write((QueryProp(P_SHOP_FLAGS) & (SHOP_HASKEEPER | SHOP_NEEDSKEEPER)
        ? KeeperPrefix("holt "+ob->name(WEN)):ob->Name())+" aus dem Regal "
        "und zeigt es Dir:\n"+ob->long());

  if ( ob->QueryProp(P_ARMOUR_TYPE) &&
     (restr = ob->QueryProp(P_WEAR_RESTRICTIONS)) &&
     RESTR_CHECKER->check_restrictions(TP, restr) )
    write( break_string(
      "Du koenntest "+ob->name(WEN,1)+" allerdings nicht anziehen!", 78,
      KeeperPrefix("warnt Dich: ", "Der Haendler warnt Dich: ")) );
  return 1;
}

do_sell(object ob, int force, no_reg)
{
  if ( ob->QueryProp(P_WC) )
  {
    write( "Schwarzfell sagt: Ich handle nicht mit Waffen.\n" );
    return 1;
  }
  if ( ob->id("raeudiges wolfsfell") )
  {
    write( BS(
      "Schwarzfell meint: Solch ein schaebiges Fell kauf ich Dir sicher nicht "
      "ab!") );
    return 1;
  }
  if ( ob->id("fell") )
  {
    return ::do_sell(ob, force);
  }
  write( "Schwarzfell meint: Ich handle nur mit Fellen.\n" );
  return 1;
}

UpdateCounter(ob,bla)
{
  if ( objectp(ob) && !ob->QueryProp(P_BEI_SCHWARZFELL_GEKAUFT) )
  {
    ob -> SetProp(P_BEI_SCHWARZFELL_GEKAUFT, 1);
    ob -> SetProp(P_LONG, ob->QueryProp(P_LONG)+"Es traegt auf der Innenseite "
          "das Guetesiegel von Schwarzfell.");
  }
  return ::UpdateCounter(ob,bla);
}

buy(str)
{
  return ::buy(str);
}

varargs AddFixedObject(string str, int val, mixed ids)
{
  return;
}
