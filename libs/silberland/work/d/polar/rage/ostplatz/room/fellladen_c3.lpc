// Fellladen
// Filename: fellladen.c
// File by Rage, Mai 00

inherit "/std/laden";

#include "../def.h"
#include "../felle.h"
#include <combat.h>
#include <moving.h>
#include <verben.h>
#include <laden.h>

#define RESTR_CHECKER "/std/restriction_checker"

int wasser, dreck, verstaubt;
int buerste_da, klopfer_da;
string schrift;
nosave string *staub_entdeckt, *verwarnt, *laden_verbot;
int Getdreck();
string ReadDetailFussmatte(string str);
int exit_test();

void create()
{
  ::create();

  schrift = "HERZLICH WILLKOMMEN!";
  wasser = 3;
  dreck = 0;
  buerste_da = 1;
  klopfer_da = 1;
  staub_entdeckt = ({});
  verwarnt = ({});
  laden_verbot = ({});

  SetStorageRoom( ROOM "felllager" );
  SetBuyFact( 5 );

  SetProp( P_INT_SHORT, "Der Laden von Schwarzfell" );
  SetProp( P_INT_LONG,
    "Du stehst in der Holzhuette von Schwarzfell. Dich umgeben vier schlichte "
    "Waende, die Du aufgrund der zahlreichen mit Fellen gefuellten Regale "
    "kaum sehen kannst. In der Mitte des Raumes steht ein grosser Ladentisch, "
    "auf dem auch noch ein paar Felle liegen. Licht kommt durch drei Tueren "
    "in den Laden, der Haendler scheint wohl darauf zu achten, dass seine "
    "Kundschaft leicht zu ihm kommen kann." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: 15]) );

  SetProp( P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp( P_SHOPKEEPER_ID, "schwarzfell" );
  SetProp( P_SHOPKEEPER_NAME, "Schwarzfell" );
  SetProp( P_SHOPKEEPER_GENDER, MALE );

  AddDetail( "licht",
    "Durch die drei Tueren faellt genug Licht in den Laden, dass Du Dich "
    "sehr leicht umsehen kannst." );
  AddDetail( "mitte",
    "Genau in der Mitte des Raumes steht ein grosser Ladentisch, auf dem der "
    "Haendler seine neuesten Felle aus- und in die Regale einsortiert." );
  AddDetail( ({ "ladentisch","tisch" }),
    "Der Ladentisch ist schlicht, aber sehr massiv. Er ist, wie vieles im Laden, "
    "aus Fichtenholz gemacht, hat drei Seitenwaende und auf der Tischplatte "
    "liegen einige Felle." );
  AddDetail( ({ "tischplatte","platte" }),
    "Hier liegen die neu in den Laden gekommenen Felle, die der Haendler erst "
    "in die Regale einordnen muss." );
  AddDetail( "seitenwaende",
    "Diese drei Seitenwaende nehmen Dir die Sicht auf das, was hinter dem Tisch "
    "ist. Auf der vorderen Seitenwand haengt ein Zettel." );
  AddDetail( "sicht",
    "Die Sicht hinter den Tisch bleibt Dir wegen der drei Seitenwaende "
    "versperrt." );
  AddDetail( ({ "hinter tisch","hinter ladentisch" }),
    "Du bist zwar urneugierig, weil Du wissen willst, was hinter dem Tisch "
    "vorgeht, aber Schwarzfell stellt sich Dir in den Weg und laesst Dich nicht "
    "naeher hin." );
  AddDetail( ({ "vordere seitenwand","seitenwand" }),
    "Auf der vordereren Seitenwand des Tisches ist ein Zettel angebracht, den "
    "Du lesen kannst." );
  AddDetail( "zettel",
    "Lies ihn ruhig." );
  AddReadDetail( "zettel",
    "+---------------------------------------+\n"
    "| Bei Bestellungen muessen wir fuer die |\n"
    "| laufenden Nebenkosten 50 Prozent des  |\n"
    "| Kaufpreises im voraus verlangen.      |\n"
    "|                                       |\n"
    "| Gezeichnet: Schwarzfell, bemueht um   |\n"
    "|             jeden Kundenwunsch        |\n"
    "+---------------------------------------+\n" );
  AddDetail( ({ "waende","wand" }),
    "Die Waende kannst Du nur zu einem geringen Teil sehen, da vor jeder Wand "
    "mindestens ein Regal steht, in dem zahlreiche Felle eingeschlichtet "
    "wurden. Mitten in den Waenden im Westen, Norden und Osten ist jeweils "
    "eine Tuer, die weit offen steht." );
  AddDetail( "teil",
    "Von den Waenden siehst Du nur einen geringen Teil, weil so viele Regale "
    "vor ihnen stehen." );
  AddDetail( "regal",
    "Welches Regal willst Du Dir naeher ansehen? Das grosse, schwarze an der "
    "Rueckwand, das kleine, dunkelbraune an der Ostwand, das breite, weisse "
    "an der Westwand oder das hohe, hellbraune Regal an der Nordwand?" );
  AddDetail( "regale",
    "Einfach gezimmerte, aber sehr robuste Regale aus Fichtenholz stehen an "
    "allen Waenden im Raum. In ihnen sollen moeglichst viele Felle auf wenig "
    "Raum Platz finden. Das Regal an der Rueckwand scheint schon fast wegen "
    "der zahlreichen darin untergebrachten Felle zu platzen der Du denkst: "
    "Ob es Schwarzfell auffiele, wenn Du ganz unauffaellig ein Fell stehlen "
    "wuerdest?" );
  AddSpecialDetail( ({ "hohes regal","hellbraunes regal" }), "detailNordregal" );
  AddSpecialDetail( ({ "klopfer","teppichklopfer" }), "detailKlopfer" );  
  AddDetail( ({ "fichte","fichten","fichtenholz" }),
    "Neben dem Boden und der Huette scheint auch das Regal an der Nordwand "
    "aus Fichtenholz gefertigt worden zu sein." );
  AddSpecialDetail( ({ "kleines regal","dunkelbraunes regal" }), "detailOstregal" );
  AddSpecialDetail( ({ "breites regal","weisses regal" }), "detailWestregal" );
  AddDetail( ({ "linde","linden","lindenholz" }),
    "Du musst daran denken, wie es damals war, als Du das erste Mal verliebt "
    "warst und unter einer Linde lagst. Dort hast Du dann mit einem Messer "
    "ein Herz hineingeschnitzt, um Dich immer an Deine grosse Liebe erinnern "
    "zu koennen. Vielleicht solltest Du einmal bei der Linde vorbeischauen "
    "und nachsehen, ob das Herz noch immer da ist.");
  AddSpecialDetail( ({ "grosses regal","schwarzes regal" }), "detailRueckregal" );
  AddDetail( ({ "raum","platz" }),
    "In diesem Raum ist genug Platz fuer Dich und die Felle. Also brauchst Du "
    "keine Platzangst zu bekommen." );
  AddDetail( ({ "platzangst","angst" }),
    "Du bist zwar sonst recht aengstlich, aber Platzangst hast Du in diesem "
    "Raum nicht, obwohl... die vielen Felle wirken doch bedrohlich... huch! "
    "Ist da nicht eines naeher auf Dich zugekommen?... Langsam beruhigst Du "
    "Dich wieder und siehst Dich weiter um." );
  AddDetail( ({ "felle","fell" }),
    "Wo Du auch hinblickst, ueberall scheinen Felle zu sein. Wenn Du mehr "
    "ueber ein Fell wissen willst, dann kann Dir Schwarzfell sicher Auskunft "
    "darueber geben." );
  AddSpecialDetail( "rueckwand", "detailRueckwand" );
  AddSpecialDetail( "haken", "detailHaken" );
  AddSpecialDetail( "buerste", "detailBuerste" );
  AddDetail( "auskunft",
    "Auskunft bekommt man, indem man jemanden nach etwas fragt, aber nicht "
    "indem man sie untersucht." );
  AddDetail( ({ "laden","felladen","fellladen" }),
    "Du stehst mitten in einem Felladen. Der Laden scheint beinahe aus Felle "
    "gemacht worden zu sein, so viele liegen hier herum." );
  AddDetail( ({ "boden","holzboden" }),
    "Der Boden ist ein schlichter Holzboden, der keinerlei Besonderheiten "
    "aufweist, abgesehen von ein paar Pfuetzen, die sich an einigen Stellen "
    "gebildet haben." );
  AddDetail( "stellen",
    "An einigen Stellen am Boden haben sich Pfuetzen gebildet." );
  AddDetail( "holz",
    "Sowohl der Boden wie auch die gesamte Huette wurden aus Fichtenholz "
    "errichtet." );
  AddDetail( ({ "huette","holzhuette" }),
    "Richtig erkannt! Du stehst inmitten einer Huette und blickst Dich gerade "
    "darin um. Wer weiss, vielleicht findest Du etwas, wenn Du Dich genau "
    "umsiehst." );
  AddDetail( ({ "besonderheiten","besonderheit" }),
    "Kannst mir glauben: Wenn ich keinerlei sage, dann meine ich es auch so." );
  AddDetail( ({ "pfuetzen","pfuetze" }),
    "Diese Pfuetzen sind eindeutig durch das Schmelzen von Schnee entstanden. "
    "Ist aber auch kein Wunder, wenn die Kundschaft mit ihren Schnee "
    "ueberhaeuften Stiefeln den Laden betritt und nicht dran denkt, sie "
    "vorher abzustreifen." );
  AddDetail( ({ "schnee","schneehaeufchen" }),
    "Ganz kleine Schneehaeufchen liegen am Boden, die durch die Kundschaft "
    "hereingetragen wurden. Erst jetzt kommt es Dir in den Sinn, dass Du wohl "
    "auch an diesen Schneehaeufchen schuld bist. Das ist Dir direkt peinlich, "
    "wo Du sonst so darauf achtest, dass Du keinen Dreck machst." );
  AddDetail( "sinn",
    "Dir kommt in den Sinn, dass Du an den Schneehaeufchen nicht ganz "
    "unschuldig bist." );
  AddDetail( "dreck",
    "Erst als Du Dir den Dreck am Boden ansiehst, fallen Dir die Fussmatten "
    "auf, die bei jedem Eingang liegen. Hier sind die Schuhe wohl so oft "
    "abgestreift worden, dass man die Matten selbst kaum mehr sieht." );
  AddDetail( ({ "eingang","ausgang" }),
    "Offene Tueren lassen sich auch als Eingang bzw Ausgang bezeichnen, je "
    "nachdem ob man im oder vorm Laden steht." );
  AddDetail( ({ "schuhe","stiefel","stiefeln" }),
    "Schuhe bzw. Stiefel wirst Du hier nur sehen, falls Du selbst welche "
    "an hast. Im Felladen stehen eindeutig keine herum." );
  AddDetail( ({ "fussmatten","fussmatte","matten","matte" }),
    "Die Fussmatten haben den Zweck, dass man sich den Dreck von den Schuhen "
    "abstreift, bevor man den Laden betritt. Es schaut sogar so aus, als ob "
    "etwas auf ihnen steht." );
  AddDetail( "zweck",
    "Der Zweck der Fussmatten ist leicht zu erkennen. Kunden von Schwarzfell "
    "sollten darauf den Dreck abstreifen, den sie sonst im ganzen Laden "
    "verteilen." );
  AddReadDetail( ({ "fussmatten","fussmatte","matten","matte" }),
                    #'ReadDetailFussmatte );
  AddDetail( ({ "kundschaft","kunde","kunden" }),
    "Fuer Schwarzfell bist Du ein potentieller Kunde, also lass Dir doch "
    "etwas von ihm aufschwaffeln." );
  AddDetail( "wunder",
    "Es ist aber ein Wunder, dass das Wasser gut abrinnen kann, und die "
    "Pfuetzen nie lange bleiben." );
  AddDetail( ({ "schmelzen","vorgang" }),
    "Gebannt schaust Du Dir den Schnee an, den Du erst in den Laden "
    "hereingeschleppt hast, und wartest, dass etwas passiert. Und siehe da !"
    "Aus dem Schnee wird Wasser !!! Du hast nun den Vorgang des Schmelzens "
    "endlich einmal genau unter die Lupe genommen." );
  AddDetail( "lupe",
    "Du brauchst noch keine Lupe. Du siehst auch ohne noch gut genug. Sei "
    "doch froh darueber!" );
  AddSpecialDetail( "wasser", "detailWasser" );
  AddSpecialDetail( "staub", "detailStaub" );
  AddDetail( "nordwand",
    "An der Nordwand steht neben der Tuer ein hohes, hellbraunes Regal. Auf "
    "der anderen Seite von der Tuer wurde ein kleines Bild aufgehaengt." );
  AddDetail( ({ "bild","kleines bild" }),
    "Das Bild ist etwa Handlaenge mal doppelte Handbreite gross und zeigt "
    "eine Gestalt, die gemuetlich auf einem Fell vor einem Kamin liegt." );
  AddDetail( ({ "handlaenge","handbreite","haende" }),
    "Du schaust Deine Haende an und denkst . o O (bin ich wieder gewachsen "
    "oder sind die einfach nur angeschwollen?)" );
  AddDetail( ({ "seite","andere seite","anderen seite" }),
    "Auf der einen Seite der Tuer im Norden steht ein Regal und auf der "
    "anderen wurde ein Bild aufgehaengt." );
  AddDetail( "gestalt",
    "Irgendwie kommt Dir die Gestalt bekannt vor. Aja, richtig, das ist doch "
    "der Haendler von diesem Laden. Auf dem Bild scheint es ihm ziemlich gut "
    "zu gehen. Ob das ein Ausschnitt aus seinem privaten Leben ist?" );
  AddDetail( ({ "leben","ausschnitt" }),
    "Auch Schwarzfell hat ein privates Leben, genauso wie Du." );
  AddDetail( "kamin",
    "Im Laden ist kein Kamin zu sehen, nur auf dem kleinen Bild an der "
    "Nordwand. Vor einem Kamin liegen und die Waerme geniessen, waere sicher "
    "nicht schlecht, aber aus diesem Grund bist Du nicht im Polargebiet "
    "unterwegs." );
  AddDetail( "waerme",
    "Du fuehlst die nicht vorhandene Waerme. Du frierst ein wenig." );
  AddDetail( "grund",
    "Den Grund, weshalb Du hier bist, musst Du wissen, den kannst Du nicht "
    "sehen." );
  AddDetail( ({ "polargebiet","gebiet" }),
    "Das ist das Gebiet, in dem Du Dich derzeit befindest. Mehr davon kannst "
    "Du sicher vor der Tuer sehen." );
  AddDetail( "westwand",
    "An der Westwand sticht Dir das breite Regal aufgrund seiner weissen "
    "Farbe foermlich in die Augen. Es reicht von der Tuer, die in den Laden "
    "nebenan fuehrt, bis an die Rueckwand zurueck. Auf der anderen Seite von "
    "der Tuer steht eine Holzbank." );
  AddDetail( ({ "holzbank","bank" }),
    "Diese Bank ist auesserst schmucklos. Sie hat keine Rueckenlehne und "
    "ausserdem liegen keine Felle darauf, dass es zumindest bequem waere. "
    "Anscheinend regelt Schwarzfell mit seinen Kunden alles so schnell, dass "
    "keiner lange warten muss." );
  AddDetail( ({ "rueckenlehne","lehne" }),
    "Diese Holzbank hat keine Rueckenlehne. Sie wurde so nahe an die Wand "
    "gestellt, sodass diese als Lehne dienen kann." );
  AddDetail( ({ "farbe","farben" }),
    "Farben siehst Du hier mehrere. So ist das Regal an der Rueckwand "
    "schwarz, jenes an der Ostwand dunkelbraun, das an der Nordwand hellbraun "
    "und jenes an der Westwand weiss. Die Farbe des Wasserdreckgemisches am "
    "Boden ist nicht so genau zu definieren. Du tippst mal auf graubraun mit "
    "einem kleinen Stich von schwarz." );
  AddDetail( ({ "stich","farbstich" }),
    "Das Wasserdreckgemisch hat einen kleinen, schwarzen Farbstich." );
  AddDetail( "wasserdreckgemisch",
    "Am Boden haben sich halt ein paar Pfuetzen mit Wasser gebildet und hin "
    "und wieder liegt Dreck am Boden." );
  AddDetail( "ostwand",
    "Direkt an der Ostwand neben der Tuer steht ein eher kleines, "
    "dunkelbraunes Regal. Es scheint, als ob sich ein paar Felle darin "
    "befinden." );
  AddDetail( ({ "nagel","naegel" }),
    "Saemtlich Regale wurden mit Naegeln zusammengebaut. Du kannst Dich beim "
    "besten Willen nicht entschliessen, welchen Nagel Du davon anschauen "
    "solltest, also laesst Du es auch sein." );
  AddDetail( ({ "tuer","tueren" }),
    "An saemtlich Waenden, abgesehen von der Rueckwand, sind Tueren "
    "eingelassen worden. Sie stehen nach Innen geoeffnet, sodass die "
    "Kundschaft ohne Probleme den Laden betreten kann." );
  AddDetail( ({ "probleme","problem" }),
    "Auch Du hast kein Problem, den Laden durch die Tueren zu betreten und "
    "zu verlassen." );
  AddDetail( "innen",
    "Ja, hier innen im Laden ist gar nicht mal so kalt." );
  AddDetail( ({ "kind","kinder" }),
    "Wie Dir sicher aufgefallen ist, laufen immer wieder Kinder durch den "
    "Laden. Es schaut fast so aus, als ob draussen noch mehr von ihnen "
    "waeren. Schwarzfell laesst sich zumindest nicht von ihnen stoeren." );
  AddDetail( ({ "decke","zimmerdecke" }),
    "Du wirfst nur einen fluechtigen Blick auf die Decke und stellst fest, "
    "das sie eindeutig nicht interessant ist. Sie besteht aus nebeneinander "
    "gereihten Holzbrettern aus Fichtenholz und das wars auch schon." );
  AddDetail( "blick",
    "Du blickst nochmal auf die Decke und meinst: Nein, die ist wirklich "
    "nicht interessant." );
  AddDetail( ({ "holzbrett","holzbretter" }),
    "Die langen Holzbretter, die die Decke des Ladens bilden, sind aus "
    "Fichtenholz." );
  AddDetail( ({ "yiqanuc","dorf" }),
    "Das Dorf, in dem Du Dich befindest, wird Yiqanuc genannt. Es ist die "
    "Heimat der Xandim." );
  AddDetail( "xandim",
    "Vor Dir steht ein typischer Xandim. Schau ihn genauer an!" );
  AddDetail( "arbeit",
    "Arbeit gibt es immer genug. Hast Du keine?" );
  AddDetail( "heimat",
        ([ 0 :"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Du bist ein Vagabund und fuehlst Dich ueberall und nirgends "
              "zuhause.",
        "fee":"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Wie gern waerst Du doch im Feenschloss, den Dienern bei der "
              "Arbeit zusehen und ein bisschen necken. Sich einmal "
              "wieder an den Steg setzen und die Libellen ueber dem Teich "
              "beobachten. Oder nur durchs Labyrinth spazieren und "
              "eine Freude dabei zu haben, zu sehen, wie sich ein paar "
              "Ahnungslose wieder verlaufen.",
      "zwerg":"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Ach, wo sind hier die gemuetlichen Hoehlen? Ein paar Ripperl "
              "essen, ein paar Bierchen dazu, das waere doch viel besser "
              "als dieses eisige Yiqanuc. Und ausserdem: wie soll ich hier "
              "einen Profit machen? Nur ein paar lausige Felle, keine "
              "Edelsteine, kein Gold, kein Silber, ueberhaupt nichts.",
  "dunkelelf":"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Duester, heiss, finster, da fuehle ich mich wohl! Was soll "
              "ich ueberhaupt in diesem Kaff? Ich will Elfen und Paladine "
              "metzeln, ihnen die Ohren abschneiden, das Herz herausreissen, "
              "das Gute vom Antlitz dieser Welt ausloeschen. Lloth soll der Weg "
              "auf diese Welt geebnet werden. Ein paar finstere Plaene "
              "schmieden, waere auch nicht schlecht.",
      "troll":"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Die Kaelte macht mir nichts, aber das Trollager im Gebirge "
              "ist doch besser, denn da habe ich immer gleich einen Goblin "
              "oder einen Ork auf dem Bratspiess. Beim Schlaechter wollte ich "
              "auch einmal vorbeischauen, um zu sehen, ob er ein paar "
              "neue Foltermethoden entwickelt hat. Ich sollte mich eines "
              "Tages zum Trollwaechter ausbilden lassen, damit ich unser "
              "Lager ehrenvoll verteidigen und unsere Feinde in Grund und "
              "Boden stampfen kann.",
       "oger":"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Hier gibt es ja ueberhaupt nichts zu essen! In den Hoehlen im "
              "Ogerlager wartet ein Mensch am Marterpfahl schon darauf, dass "
              "er von mir verspeist wird. Bei Beorn vorbeischauen und mir ein "
              "blutiges Herz einwerfen und einen guten Schnaps dazutrinken, "
              "waere auch nicht zu verachten. Mein Magen knurrt schon, wird "
              "Zeit, dass ich etwas Essbares finde.",
     "mensch":"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Irgendwie waere ich jetzt gern in Midas, ein bisschen der "
              "Gilde mit Freunden zusammensitzen, vielleicht in die Kapelle "
              "schauen, um ein paar Idler zu besuchen oder ein Besuch bei "
              "Max, um dort eine kleine Party zu feiern, aber ich muss jetzt "
              "hier sein, wo ueberhaupt nichts los ist, und man kaum andere "
              "Leute als Xandim sieht, die ja so verschwiegen sind.",
     "hobbit":"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Die Leute hier in Yiqanuc sind alle viel zu ernst, die goennen "
              "sich ueberhaupt keinen Spass und keine Ruhe. Waere es schoen, "
              "jetzt zuhause am Hang eines Weinberges zu sitzen, gemuetlich "
              "eine Pfeife zu rauchen und den Tag zu geniessen. Oder sich mit "
              "ein paar Freunden im 'Zum Goldenen Drachen' treffen und ein "
              "bisschen plaudern und ein, zwei Glaeschen Wein dazu zu trinken.",
        "elf":"Unwillkuerlich musst Du an Deine Heimat denken.\n"
              "Sind die Xandim alle Banausen? Keiner spielt Musik oder hegt "
              "ein Gaertchen. Da ist mir meine Wohnung hoch in Baeumen bei "
              "Elassar viel lieber, ich werde rundum von den Schauspielen der "
              "Natur umgeben, kann den Voegeln bei ihren Gesaengen zuhoeren, "
              "mich um die Pflanzen auf der Lichtung kuemmern oder an meinem "
              "neuen Gedicht weiterschreiben." ]) ); 
  AddDetail( ({ "schwarzfell","haendler" }),
    "Sehr merkwuerdig. Der Haendler des Ladens ist gar nicht anwesend." );
  AddDetail( "schmuck",
    "Bist Du so eitel, dass Du Dir schon im Polargebiet Schmuck suchen musst? ");
  AddDetail( "nachbarladen",
    "Du wirfst einen kurzen Blick in den Nachbarladen im Westen und siehst, wie "
    "sich zwei Frauen miteinander unterhalten." );
  AddDetail( "frauen",
    "Durch die offene Tuer im Westen siehst Du zwei Frauen im Laden stehen. "
    "Da sie staendig ihre Muender auf und zu machen, glaubst Du, dass sie "
    "sich angeregt unterhalten." );
  AddDetail( ({ "muender","mund" }),
    "Die zwei Frauen haben einen Mund, der Haendler vor Dir und Du auch!" );
  AddDetail( ({ "wasserdreckgemisches","riechen","raumes","o","kindern",
    "holzart","geruchsinn","fellen","augen","abhilfe","holzbrettern" }),
    "Das kannst Du nicht untersuchen!" );

  AddSmell( DEFAULT_SMELL,
    "In diesem Laden riecht es stark nach Holz, was Dich auch nicht weiter "
    "verwundert, da die Huette aus Holz erbaut wurde." );
  AddSmell( ({ "holz","fichtenholz" }),
    "Du weisst, dass hier alles aus Holz ist, aber so einen guten "
    "Geruchsinn hast Du nicht, dass Du die Holzart durch Riechen bestimmen "
    "kannst." );

  AddSound( DEFAULT_SOUND,
    "Von draussen hoerst Du immer wieder das Bellen von Hunden und das "
    "Geschreie von Kindern. Auch aus dem Laden von nebenan klingen hin und "
    "wieder Gespraechsfetzen herueber. Und ganz leise kannst Du den Wind "
    "hoeren, der durch die offenen Tueren hereinweht." );
  AddSound( ({ "bellen","hunde","hunden","hund" }),
    "Aus dem Laerm, der durch das Bellen erzeugt wird, schliesst Du, dass "
    "vor dem Laden ziemlich viele Hunde sein muessen." );
  AddSound( "laerm",
    "Der meiste Laerm entsteht sicher durch das Bellen der Hunde, doch hier "
    "im Laden ist er nicht so schlimm und man kann sich normal unterhalten." );
  AddSound( ({ "geschreie","geschrei","kinder" }),
    "Die Kinder scheinen alle sehr gluecklich zu sein, denn es dringen nur "
    "froehliche Laute von draussen in den Laden herein." );
  AddSound( ({ "laute","laut" }),
    "Ist doch schoen, wenn Kinder gluecklich sind." );
  AddSound( "gespraechsfetzen",
    "Viel kannst Du nicht erkennen, ausser dass zwei Frauen ueber Schmuck "
    "reden." );
  AddSound( "frauen",
    "Die Frauen im Nachbarladen reden ueber den neuesten Schmuck, den es in "
    "Yiqanuc gibt." );
  AddSound( "wind",
    "Ganz leise kannst Du den Wind hoeren, der durch die offenen Tueren weht. "
    "Vielleicht koenntest Du da sogar Abhilfe schaffen?" );

  AddRoomMessage( ({
    "Ein Kind laeuft bei einer Tuer rein und gleich bei einer anderen wieder "
    "raus.\n"
                   }), 60, "roommessage" );

  AddSpecialExit( "westen", "stopp" );
  AddSpecialExit( "osten", "stopp" );
//  AddExit( "westen","./schmuckladen_b3" );
//  AddExit( "osten","./ostplatz_d3" );
  AddExit( "norden","./ostplatz_c2" );
  AddExit( "sueden", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : "./ostplatz_c4",
          EX_MSG      : "unter einen Baumstamm nach Sueden ins Freie" ]) );
  SetProp( P_HIDE_EXITS, ({ "sueden" }) );
  
  AddCmd( ({ "streif","streife" }), "cmd_streifen" );
  AddCmd( ({ "sitze","sitz","setze","setz" }), "cmd_sitzen" );
  AddCmd( ({ "stehl","stehle","klau","klaue" }), "cmd_stehlen" );
  AddCmd( ({ "schliess","schliesse" }), "cmd_schliessen" );
  AddCmd( ({ "trink","trinke" }), "cmd_trinken" );
  AddCmd( ({ "haeng","haenge" }), "cmd_haengen" );
  AddCmd( ({ "lege","leg" }), "cmd_legen" );
  AddCmd( CMD_NEHMEN, "cmd_nehmen" );

  AddItem( NPC "schwarzfell", REFRESH_DESTRUCT );
  RemoveItem( "/obj/entsorg" );
}

int stopp(string dir)
{
  write(
    "Eine magische Kraft haelt Dich davon ab, in diese Richtung zu gehen.\n" );
  return 1;
}
int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "Du musst schon einen Umweg machen, wenn Du dort hin willst!\n" );
    return 0;
  }
  return 1;
}
//SPECIAL DETAILS
string ReadDetailFussmatte(string str)
{
  if ( Getdreck() > 5 )
  {
    return ( "+------------------------+\n"
             "|                        |\n"
             "|                        |\n"
             "|                        |\n"
             "+------------------------+\n"
             "Die Fussmatte ist bereits so verdreckt, dass man die Schrift "
             "nicht mehr\n"
             "lesen kann. Aber wenn Du nett bist, koenntest Du sie wieder "
             "sauber machen.\n");
  }          
  return ( "+------------------------+\n"
           "|                        |\n"
           "|  "+schrift+"  |\n"
           "|                        |\n"
           "+------------------------+\n");
}
schriftzug(string str)
{
  int i, pos;
  for ( i=0; i<3; i++ )
  {
    pos = random(18)+1;
    while( schrift[pos .. pos] == " " )
      pos = random(18)+1;
    schrift[pos .. pos] = " ";
  }
}

string detailWasser()
{
  if ( wasser )
  {
    return BS(
      "Die Pfuetzen auf dem Boden bestehen aus Wasser. Und auch wenn es "
      "noch so verlockend wirkt, trinken wuerde ich es nicht!" );
  }
  return BS(
    "In der Huette siehst Du kein Wasser, sondern nur eine feste Form davon, "
    "naemlich Schnee." );
}

string detailBuerste()
{
  if ( buerste_da )
  {
    return BS(
      "Die Buerste haengt auf einem Haken an der Rueckwand der Huette." );
  }
  return BS(
    "Wo siehst Du hier eine Buerste?" );
}

string detailKlopfer()
{
  if ( klopfer_da )
  {
    return BS(
      "Der Teppichklopfer haengt auf einem Nagel, der in das Regal an der "
      "Nordwand geschlagen wurde." );
  }
  return BS(
    "Bitte wie? Du siehst einen Teppichklopfer hier im Raum? In diesem Laden "
    "gibt es ganz sicher keinen Teppichklopfer, Du Klopfer!" );
}

string detailRueckwand()
{
  if ( buerste_da )
  {
    return BS(
      "Neben dem langen Regal an der Rueckwand haengt an einem Haken an der "
      "Wand eine Buerste." );
  }
  return BS(
    "Neben dem langen Regal an der Rueckwand wurde ein kleiner Haken in die "
    "Wand geschlagen. Ob da mal etwas draufgehangen hat?" );
}

string detailStaub()
{
  object fell;

  fell = FindInStore("\nhqwfell");

  if ( !present("\nhqwfell", find_object(ROOM "felllager")) )
  {
    if ( member(staub_entdeckt,getuid(TP)) != -1 )
      return BS(
        "Dort, wo frueher das verstaubte, raeudige Wolfsfell lag, liegt auch "
        "kein Staub mehr. Den muss Schwarzfell in der Zwischenzeit "
        "weggewischt haben." );
    else
      return BS(
        "Du suchst Staub im Polargebiet? Da in diesem Laden alle Tueren offen "
        "stehen, kommt hin und wieder auch eine leichte Brise der frischen, "
        "sauberen Polarluft herein, die eine Staubbildung unmoeglich macht." );
  }
  if ( member(staub_entdeckt,getuid(TP)) != -1 )
  {
    if ( fell -> QueryProp(P_FELL_ABGELEGT) )
    {
      return BS(
        "Das raeudige Wolfsfell wurde wohl geputzt, denn man kann kein "
        "Staubkorn mehr daran erkennen." );
    }
    return BS(
      "Das raeudige Wolfsfell muss schon laenger hier liegen, denn es ist "
      "ueber und ueber mit Staub bedeckt. Der Haendler hat anscheinend keine "
      "Zeit (oder Lust) dazu, es auszuklopfen, aber er freut sich sicher, "
      "wenn er wen findet, der ihm die Arbeit abnimmt." );
  }
  else
    return BS(
      "Du suchst Staub im Polargebiet? Da in diesem Laden alle Tueren offen "
      "stehen, kommt hin und wieder auch eine leichte Brise der frischen, "
      "sauberen Polarluft herein, die eine Staubbildung unmoeglich macht." );
}

string detailRueckregal(string text)
{
  text =  "Dieses Regal ist aus Ebenholz, wie Du aus der Farbe gleich "
          "schliessen kannst. Es ist sehr hoch und breit und fuellt fast die "
          "gesamte Rueckwand aus. Es bietet reichlich Platz fuer viele Felle.";

  if ( present("braunbaerenfell", find_object(ROOM "felllager")) )
    text += " Einige Braunbaerenfelle liegen im oberen Teil des Regals.";
    
  if ( present("\nhqbfell", find_object(ROOM "felllager")) )
    text += " In den Faechern in der Mitte liegen mehrere Baerenfelle.";
    
  if ( present("grizzlyfell", find_object(ROOM "felllager")) )
     text += " Im unteren Teil des Regals liegen wunderschoene Grizzlyfelle.";
     
  if ( !present("braunbaerenfell", find_object(ROOM "felllager"))
    && !present("\nhqbfell", find_object(ROOM "felllager"))
    && !present("grizzlyfell", find_object(ROOM "felllager")) )
    text += " Im Moment liegen allerdings keine Felle darin. Der Umsatz "
            "bei Schwarzfell ist wohl ziemlich gut.";
  return BS( text );
}

string detailOstregal(string text)
{
  text = "Dieses Regal aus Nussbaumholz ist das kleinste von allen. Es "
         "besteht aus drei Faechern und ist nur etwa einen Meter hoch und "
         "genauso breit. Aber fuer die kleinen Felle, die darin gelagert "
         "werden sollen, reicht es allemal.";

  if ( present("igelfell", find_object(ROOM "felllager")) )
    text += " Ein paar kleine Igelfelle liegen im oberen Fach.";
    
  if ( present("fellchen", find_object(ROOM "felllager")) )
  {
    if ( present("igelfell", find_object(ROOM "felllager")) )
      text += " Neben den Igelfellen liegt auch ein Wuslerfell.";
    else
      text += " Ein Wuslerfell liegt im oberen Fach.";
  }      
    
  if ( present("biberfell", find_object(ROOM "felllager")) )
     text += " Im mittleren Fach sind ein paar Biberfelle gelagert, die "
             "noch immer einwenig glaenzen.";
     
  if ( present("otterfell", find_object(ROOM "felllager")) )
     text += " Die Otterfelle hat Schwarzfell ganz unten im Regal gestapelt.";
     
  if ( !present("igelfell", find_object(ROOM "felllager"))
    && !present("wuslerfell", find_object(ROOM "felllager"))
    && !present("biberfell", find_object(ROOM "felllager"))
    && !present("otterfell", find_object(ROOM "felllager")) )
    text += " Im Moment liegen allerdings keine Felle darin. Der Umsatz "
            "bei Schwarzfell ist wohl ziemlich gut.";
  return BS( text );
}

string detailNordregal(string text)
{
  text = "Dieses Regal steht direkt neben der Tuer im Norden. Es reicht bis "
         "an die Decke, hat vier Faecher und Du vermutest, dass es aus "
         "Fichtenholz hergestellt wurde.";

  if ( klopfer_da )
    text += " In die Seitenwand des Regals wurde ein Nagel geschlagen, an "
            "dem ein Teppichklopfer haengt.";
  else
    text += " In die Seitenwand des Regals wurde ein Nagel geschlagen, der "
            "sicher nicht ohne Grund da ist.";
               
  if ( present("pumafell", find_object(ROOM "felllager")) )
    text += " Mehrere Pumafelle liegen im oberen Teil des Regals.";
    
  if ( present("\nhqwfell", find_object(ROOM "felllager")) )
    text += " Ein einzelnes, raeudiges Wolfsfell liegt im zweiten Fach.";
    
  if ( present("/p/armour/cloak/wolfsfell", find_object(ROOM "felllager")) )
     text += " Im dritten Fach hat Schwarzfell ein paar schoene Wolfsfelle "
             "gestapelt.";

  if ( present("fuchsfell", find_object(ROOM "felllager")) )
     text += " Ganz unten liegen einige Fuchsfelle, die sich durch ihre "
             "roetliche Farbe von den anderen Fellen deutlich abheben.";
     
  if ( !present("pumafell", find_object(ROOM "felllager"))
    && !present("\nhqwfell", find_object(ROOM "felllager"))
    && !present("/p/armour/cloak/wolfsfell", find_object(ROOM "felllager"))
    && !present("fuchsfell", find_object(ROOM "felllager")) )
    text += " Da die Geschaefte von Schwarzfell wohl blendend laufen muessen, "
            "siehst Du in diesem Regal im Moment keine Felle.";
  return BS( text );
}

string detailWestregal(string text)
{
  text = "Du bist zwar kein Meister des Holzfaches, bist aber der Meinung, "
         "dass das Regal aus Lindenholz sein muesste. Es hat zwar nur zwei "
         "Faecher, ist aber sehr breit und bietet somit - wie das Regal "
         "an der Rueckwand - Platz fuer grosse Felle.";

  if ( present("bueffelfell", find_object(ROOM "felllager")) )
    text += " Im oberen Bereich sind ein paar Bueffelfelle gestapelt worden.";
    
  if ( present("yetifell", find_object(ROOM "felllager")) )
    text+=" Im unteren Fach liegen mehrere Yetifelle.";
     
  if ( !present("bueffelfell", find_object(ROOM "felllager"))
    && !present("yetifell", find_object(ROOM "felllager")) )
    text += " Derzeit befinden sich in diesem Regal keine Felle. Der Umsatz "
            "bei Schwarzfell ist wohl ziemlich gut.";
  return BS( text );
}

nosave string detailHaken()
{
  if ( buerste_da )
  {
    return BS(
      "Auf dem Haken wurde eine Buerste mit einer Schlaufe aufgehaengt. "
      "Nimm sie ruhig, vielleicht brauchst Du sie ja noch!" );
  }
  return BS(
    "Der Haken ist sicher nicht zum Spass in die Wand geschlagen worden. "
    "Wer weiss, vielleicht war sogar etwas drauf?" );
}
