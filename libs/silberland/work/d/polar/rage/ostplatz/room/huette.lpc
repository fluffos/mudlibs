// Osterweiterung des Xandimdorf
// Filename: huette.c
// File by Rage, Mai 00

inherit "std/room";

#include "../def.h"
#include <verben.h>
#include <moving.h>

int vorstehender_scheit, vogel_weg, swiesel_da;
int *nest_entdeckt;

void create()
{
  ::create();

  vorstehender_scheit = random(2);
  vogel_weg = random(5);
  nest_entdeckt = ({});
  swiesel_da = 0;

  SetProp( P_INT_SHORT, "In einer Huette auf dem Ostplatz" );
  SetProp( P_INT_LONG,
    "Es ist zwar ein wenig duster hier, da wenig Licht durch die Baumstaemme "
    "von draussen hereinfaellt, doch es reicht aus, dass Du Dich in aller "
    "Ruhe umsehen kannst. Du stehst mitten in einer Huette der Xandim. Hinter "
    "Dir haengen die Baerenfelle, die den Eingang verdecken, links wurden "
    "Unmengen von Holzscheiten aufgestapelt und rechts stehen zahlreiche "
    "Hundeschlitten." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: 5]) );

//DETAILS
  AddDetail( "boden",
    "Ein schmaler Gang fuehrt vom Eingang bis an die Rueckwand der Huette. "
    "Dieser wurde komplett mit Stroh ausgelegt und es scheint keine Spur von "
    "Schnee zu geben. Links vom Gang wurden Holzscheite aufgestapelt und rechts "
    "davon stehen viele Hundeschlitten." );
  AddDetail( "gang",
    "Ein schmaler Gang fuehrt vom Eingang bis zur Rueckwand, der vollkommen mit "
    "Stroh ausgelegt ist." );
  AddDetail( "rueckwand",
    "Die Rueckwand sieht vom weiten gleich aus wie die Vorderwand, nur dass sie "
    "keinen Eingang hat. Du bildest Dir ein, dass Du darauf einen Schatten "
    "gesehen hast, der irgendwie nicht dort hin passt. Du ueberlegst Dir, das "
    "genauer unter die Lupe zu nehmen." );
  AddDetail( ({ "redewendung","lupe" }),
    "'Unter die Lupe nehmen' ist nur eine Redewendung. Man haette auch sagen "
    "koennen: 'Schau Dir das gefaelligst genauer an!', nur haette das bei "
    "weitem nicht so gut geklungen wie ersteres." );
  AddDetail( "schatten",
    "Da kein klares Licht in die Huette faellt, sondern nur wenige Sonnenstrahlen "
    "durch die Baumstaemme herein dringen, bist Du Dir nicht sicher, ob der "
    "Schatten so gehoert oder nicht. Du gehst an die Rueckwand, siehst darauf den "
    "Schatten eines schmaeleren Baumstamms (einer der Staemme, die die "
    "Seitenwaende tragen - nur zur Erinnerung) und daneben einen kleinen, fast "
    "unauffaelligen, ovalen Schatten. Du willst unbedingt herausfinden, wer oder "
    "was diesen Schatten wirft." );
  AddDetail( "erinnerung",
    "Daran erinnert man sich. Das kann man doch nicht untersuchen!" );
  AddDetail( "sonnenstrahlen",
    "Die wenigen Sonnenstrahlen, die zwischen den Baumstaemmen durch in die Huette "
    "eindringen, reichen aus, um Dir genuegend Licht zu spenden." );
  AddSpecialDetail( ({ "kleinen schatten","kleiner schatten",
                       "unauffaelligen schatten","unauffaelliger schatten",
 		       "ovalen schatten","ovaler schatten" }), "detailSchatten" );
  AddSpecialDetail( "nest", "detailNest" );
  AddSpecialDetail( "loch", "detailLoch" );
  AddSpecialDetail( "aeste", "detailAeste" );
  AddSpecialDetail( ({ "liebe","arbeit" }), "detailLiebe" );
  AddSpecialDetail( ({ "art","kokon","unterschlupf" }), "detailKokon" );
  AddSpecialDetail( ({ "vogeleltern","voegel" }), "detailVoegel" );
  AddDetail( "schnee",
    "Du bist den Schnee schon so gewohnt, dass es Dir merkwuerdig erscheint, "
    "keinen mehr siehst. Du atmest erleichtert auf, als Du feststellst, dass auf "
    "den Kufen der Hundeschlitten doch noch ein paar Schneekristalle sind." );
  AddDetail( "schneekristalle",
    "Ganz kleine Schneekristalle sind noch auf den Kufen der Hundeschlitten, was "
    "darauf schliessen laesst, dass die Xandim in den letzten Tagen mit den "
    "Schlitten unterwegs waren." );
  AddDetail( "tage",
    "Irgendwann in den letzten Tagen waren die Xandim sicher mit Hundeschlitten "
    "unterwegs, denn sonst koennte kein Schnee auf den Kufen drauf sein." );
  AddDetail( "spur",
    "Da der Boden komplett mit einer dicken Strohschicht ausgelegt wurde, siehst "
    "Du nicht die geringste Spur von Schnee." );
  AddDetail( ({ "strohschicht","stroh" }),
    "Soweit Du es erkennen kannst, wurde der gesamte Boden mit Stroh ausgelegt. "
    "Dies geschah wohl aus dem Grund, um die Holzscheite trocken zu halten, damit "
    "diese dann letztendlich als Brennholz verwendet werden koennen. Ein Tier "
    "haette es in dem Stroh sicherlich auch recht warm, doch sehen kannst Du "
    "keines." );
  AddDetail( "brennholz",
    "Die Holzscheite dienen ganz bestimmt als Brennholz. Weshalb hast Du geglaubt, "
    "dass die hier gelagert werden?" );
  AddDetail( "grund",
    "Das Stroh wurde aus dem Grund ausgelegt, damit die Holzscheite immer trocken "
    "bleiben und als Brennholz dienen koennen." );
  AddDetail( "tier",
    "Du suchst das Stroh nach einem Tier ab, findest leider keines. Wenn eines "
    "hier ist, dann hat es sich sicher bei Deinen Schritten so schnell wie "
    "moeglich verkrochen und wartet darauf, bis Du wieder aus der Huette hinaus "
    "gehst." );
  AddDetail( "schritte",
    "Bei Deinen Schritten knistert es ein bisschen im Schnee." );
  AddDetail( "licht",
    "Es faellt durch die Baumstaemme genug Licht herein, was auch gut ist, "
    "denn stelle Dir mal vor, was alles passieren koennte, wenn man sich mit "
    "einer Fackel oder einem aehnlichen Gegenstand umsehen wuerde." );
  AddDetail( ({ "fackel","fackeln" }),
    "Fackeln kann man anzuenden und wieder loeschen. Jetzt hast Du wieder was "
    "dazugelernt!" );
  AddDetail( "gegenstand",
    "Wenn man mit einer Fackel oder einem Gegenstand, der auch ein offenes Feuer "
    "hat, hier herumspielt, koennte das unabsehbare Folgen haben." );
  AddDetail( "feuer",
    "Nicht auszudenken, wenn in dieser Huette ein Feuer ausbrechen wuerde." );
  AddDetail( "folgen",
    "Ich glaube, Du kannst selbst gut abschaetzen, was passieren wuerde, wenn das "
    "Stroh Feuer faengt." );
  AddDetail( ({ "baumstaemme","staemme" }),
    "Das Dach bzw die Waende der Huette werden aus Baumstaemmen gebildet. Von "
    "draussen wunderste Du Dich, wie die Baumstaemme aufeinander liegen "
    "koennen, jetzt weisst Du es endlich. Auf beiden Wandseiten sind jeweils "
    "zwei schmaelere Baumstaemme, die mit dem Boden ein Dreieck bilden, die an "
    "den oberen Enden verbunden wurden und auf denen die anderen Baumstaemme "
    "einfach aufliegen." );
  AddDetail( "dach",
    "Das Dach wird von den beiden Seitenwaenden gebildet." );
  AddDetail( "dreieck",
    "Die schmaeleren Baumstaemme bilden gemeinsam mit dem Boden ein Dreieck." );
  AddDetail( "enden",
    "An den oberen Enden wurden die schmaeleren Baumstaemme irgendwie verbunden. "
    "Ob verleimt, zusammengenagelt oder mit Seile zusammengehalten kannst Du "
    "nicht sagen." );
  AddDetail( "seile",
    "Vielleicht wurden die schmaeleren Baumstaemme oben mit Seile zusammen "
    "gebunden, doch sehen kannst Du keine." );
  AddDetail( ({ "baumstamm","stamm" }),
    "Egal welchen Baumstamm Du Dir ansiehst, bis auf die vier schmaeleren "
    "Baumstaemme, die die beiden Seitenwaende tragen, unterscheiden sie sich "
    "nicht." );
  AddDetail( ({ "schmaelerer baumstamm","schmaeleren baumstamm","traeger" }),
    "Die schmaeleren Baumstaemme beginnen am Boden und fuehren schraeg nach oben, "
    "wo sie mit den gleichen Baumstaemmen der anderen Seitenwand zusammen "
    "treffen. Irgendwie wurden sie an den oberen Enden miteinander verbunden, doch "
    "Du kannst nicht erkennen, wie das gemacht wurde, und es ist ausnahmsweise "
    "sogar egal." );
  AddDetail( ({ "wandseite","wandseiten","seitenwaende" }),
    "Die beiden Wandseiten links und rechts von Dir treffen genau ueber Deinem "
    "Kopf zusammen. Sie werden von jeweils zwei schmaeleren Baumstaemmen "
    "getragen, denn sonst wuerden sie nach innen zusammenfallen und Dich "
    "lebendig begraben." );
  AddDetail( "kopf",
    "Dein Kopf sitzt wie angegossen und weiter darueber treffen die beiden "
    "Wandseiten aufeinander." );
  AddDetail( "ruhe",
    "Die kannst Du in dieser Huette ganz bestimmt finden, denn es ist "
    "ueberhaupt nichts los." );
  AddDetail( "huette",
    "Die Huette ist eine einfache Variante einer Blockhuette. Die Seitenwaende "
    "sind schraeg und treffen genau ueber Deinem Kopf zusammen, womit sie "
    "gleichzeitig das Dach bilden. Vor Dir erblickst Du die Rueckwand und "
    "hinter Dir befindet sich die Vorderwand, die nach demselben Prinzip "
    "aufgestellt wurden wie bei einer typischen Blockhuette." );
  AddDetail( "prinzip",
    "Die Huette ist nach demselben Prinzip erbaut wie jede andere typische "
    "Blockhuette." );
  AddDetail( ({ "blockhuette","variante" }),
    "Die Huette ist eine einfachere Variante einer Blockhuette, denn man konnte "
    "sich das Dach ersparen." );
  AddDetail( "vorderwand",
    "An der Vorderwand befindet sich der Eingang zu dieser Huette. Sie weist "
    "keinerlei Besonderheiten auf und wurde nach demselben Prinzip aufgestellt "
    "wie die anderen Waende." );
  AddDetail( "besonderheiten",
    "Nur durch das Untersuchen von Besonderheiten heisst das noch lange nicht, dass "
    "Du welche findest." );
  AddDetail( "untersuchen",
    "Du untersuchst eindeutig zu viel." );
  AddDetail( "xandim",
    "Keiner zu sehen. Die Huette wurde allerdings sicher von ihnen gebaut." );
  AddDetail( ({ "baerenfelle","baerenfell","braunbaerenfell",
                "braunbaerenfelle","felle","fell" }),
    "Durch die beiden Baerenfelle bist Du in das Innere der Huette geschluepft. "
    "Den ehemaligen Inhaber dieser Felle waerst Du nicht gern ueber den "
    "Weg gelaufen, denn sie sind groesser als alle Felle, die Du bisher "
    "gesehen ist. Ihrer braunen Farbe nach zu urteilen, stammen sie von "
    "gewaltigen Braunbaeren." );
  AddDetail( "farbe",
    "Die Farbe der Felle vor dem Eingang sind braun, wie eigentlich alles, was Du "
    "in diese Huette siehst." );
  AddDetail( ({ "inhaber","braunbaeren" }),
    "Die Inhaber der Braunbaerenfelle waren gewaltige Braunbaeren." );
  AddDetail( ({ "innere","inneres" }),
    "Du bist im Inneren der Huette, was Dir aber sicher selbst auch schon laengst "
    "aufgefallen ist." );
  AddDetail( "weg",
    "Weg gibt es in der Huette keinen, nur einen Gang, der von vorne nach "
    "hinten fuehrt." );
  AddDetail( "eingang",
    "Der Eingang ist eine in der Vorderwand freigelassene Oeffnung, durch die "
    "man die Huette betreten und auch wieder verlassen kann. Er wird "
    "groesstteils von den beiden Braunbaerenfellen verdeckt." );
  AddDetail( "oeffnung",
    "Du weisst nur, dass hinter den Braunbaerenfellen eine Oeffnung ist, durch "
    "die Du ins Innere der Huette gelang bist." );
  AddDetail( ({ "unmenge","unmengen" }),
    "Es sind soviele Holzscheite gestapelt, dass Du glaubst, dass Du in "
    "jeder Sekunde unter ihnen begraben wirst." );
  AddDetail( "sekunde",
    "Jede Sekunde koennte es soweit sein und Du bist unweigerlich unter den "
    "Holzscheiten begraben." );
  AddDetail( ({ "holzscheite","scheite" }),
    "Eine Unmenge an Holzscheiten wurde links vom Gang gestapelt. Sie reichen "
    "vom Boden bis zu einer Hoehe von fast zwei Meter. Du befuerchtest, dass "
    "der Stapel in jedem Augenblick umfallen koennte, also vermeidest Du "
    "jede unnoetige, ausschweifende Geste. Die Holzscheite sind aus "
    "Fichtenholz, und obwohl sie alle gleich lang sind, haben sie "
    "unterschiedlichste Durchmesser, ganz kleine, kleine, mittlere, grosse und "
    "sehr grosse." );
  AddDetail( "augenblick",
    "Im Augenblick steht der Stapel ganz ruhig da. Ist wohl besser, wenn das so "
    "bleibt." );
  AddDetail( "durchmesser",
    "Die Holzscheite in den verschiedenen Stapeln haben unterschiedliche "
    "Durchmesser. Willst Du Dir die ganz kleinen, die kleinen, die mittlere, die "
    "grossen oder die sehr grossen ansehen?" );
  AddDetail( ({ "ganz kleine durchmesser","ganz kleinen durchmesser",
                "ganz kleiner durchmesser","erster stapel","ersten stapel" }),
    "Die Holzscheite mit den ganz kleinen Durchmesser liegen in dem vordesten "
    "Stapel, der gleichzeitig der niedrigste von allen ist. Diese werden wohl "
    "verwendet, um einmal ein Feuer in einer Feuerstelle zu erhalten. Bei diesen "
    "Holzscheiten ueberhaupt von Scheiten zu reden, ist ein wenig uebertrieben." );
  AddDetail( "feuerstelle",
    "In der Huette ist keine zu sehen." );
  AddDetail( ({ "kleine durchmesser","kleinen durchmesser","kleiner durchmesser",
                "zweiter stapel","zweiten stapel" }),
    "Als zweiter Stapel folgt einer mit Holzscheiten von kleinem Durchmesser. Er "
    "ist etwa gleich hoch wie der erste und die Scheite sind nicht staerker als "
    "5cm im Durchmesser. Wenn Du in den Stapeln etwas anderes als Holzscheite "
    "finden willst, dann reicht ein normales untersuchen nicht aus." );
  AddDetail( ({ "mittlere durchmesser","mittleren durchmesser",
                "mittlerer durchmesser","dritter stapel","dritten stapel" }),
    "Die Holzscheite mittleren Durchmesser liegen im mittleren Stapel, der bereits "
    "eine Hoehe von zwei Meter erreicht. Wenn man diese Scheite nachlegt, dann "
    "werden sie fuer eher kurze Zeit reichen, um das Feuer zu erhalten." );
  AddDetail( ({ "zeit","minuten" }),
    "Etwa 15 bis 20 Minuten wird ein solcher Scheit brennen, bis er dann nur mehr "
    "glueht. Ideal, wenn man gerade zu Bett gehen will." );
  AddDetail( "bett",
    "Musst Du immer daran denken?" );
  AddDetail( ({ "grosse durchmesser","grossen durchmesser","grosser durchmesser",
                "vierter stapel","vierten stapel","vorletzter stapel",
                "vorletzten stapel" }),
    "Die Holzscheite im vorletzten Stapel sind schon ziemlich gross. Auch dieser "
    "Stapel erreicht eine Hoehe von zwei Meter. Diese Scheite haben schon "
    "Durchmesser groesser als 15cm. Wenn man einen von ihnen in die Glut legt, dann "
    "kann man noch lange die Waerme geniessen." );
  AddDetail( "waerme",
    "Ich meine natuerlich die Waerme eines Feuers, nicht die nichtvorhandene in "
    "der Huette." );
  AddDetail( "glut",
    "Will man in einer Feuerstelle viel Waerme haben, braucht man eine gute Glut." );
  AddDetail( ({ "sehr grosse durchmesser","sehr grossen durchmesser",
                "sehr grosser durchmesser","fuenfter stapel","fuenften stapel",
                "letzter stapel","letzten stapel" }),
    "Die Holzscheite im letzten Stapel sind ja schon sehr gross. Sie sind zwar "
    "gleich lang wie alle anderen, naemlich etwa 30cm, doch ihr Durchmesser ist "
    "mindestens genau so gross. Ob diese auch als Brennholz verwendet werden?" );
  AddDetail( ({ "fichtenholz","holz" }),
    "Alle Holzscheite sind aus Fichtenholz, wie auch die Baumstaemme, die diese "
    "Huette formen." );
  AddDetail( ({ "geste","gesten" }),
    "Du vermeidest jede ausschweifende Geste, wie mit den Armen herum zu fuchteln, "
    "damit der Stapel nicht durch Deine Schuld umfaellt." );
  AddDetail( ({ "arm","arme" }),
    "Du hast Deine Arme zwar nicht immer unter Kontrolle, aber dieses Mal "
    "unterlaesst Du es, ausschweifende, wilde Gesten zu machen." );
  AddDetail( "schuld",
    "Noch ist nichts passiert, also brauchst Du Dir auch keine Schuld zu geben." );
  AddDetail( ({ "hoehe","meter" }),
    "Die Holzscheite sind etwa zwei Meter hoch gestapelt." );
  AddDetail( ({ "holzstapel","stapel" }),
    "Eigentlich ist es nicht nur ein Stapel, sondern es sind fuenf verschiedene, "
    "wobei in einem Stapel nur Holzscheite aehnlichen Durchmessers sind. Wenn "
    "man da einen Scheit an der falschen Stelle herauszieht, koennte das sicher "
    "schlimme Folgen haben." );
  AddSpecialDetail( ({ "holzscheit","scheit" }), "detailHolzscheit" );
  AddDetail( "stelle",
    "Also wenn man weiter unten im Stapel einen Holzscheit herauszieht, koennte "
    "es schon zu einem Unglueck kommen." );
  AddDetail( "unglueck",
    "Noch ist keines zu sehen, aber ein Unglueck kommt oft schneller, als Dir "
    "lieb ist." );
  AddDetail( ({ "hundeschlitten","schlitten" }),
    "Etwa zehn Hundeschlitten haben auf der rechten Seite vom Gang Platz "
    "gefunden. Sie haben zwei lange Kufen, aehnlich wie bei einem normalen "
    "Schlitten, vorne einen Aufbau, um Gepaeck darauf zu befestigen, und "
    "hinten eine einfache Holzkonstruktion, an der sich der Lenker waehrend "
    "der Fahrt anhalten kann. Um solch einen Schlitten irgendwann einmal selbst "
    "fahren koennen, brauchst Du sicher genaue Anweisungen von einem Xandim." );
  AddDetail( ({ "anweisungen","anweisung" }),
    "Um einmal einen Hundeschlitten steuern zu koennen, brauchst Du vorher sicher "
    "Anweisungen von einem Xandim." );
  AddDetail( "aufbau",
    "Die Hundeschlitten haben vorne einen Aufbau, um darauf Gepaeck befestigen "
    "zu koennen." );
  AddDetail( "fahrt",
    "Eine Fahrt mit so einem Hundeschlitten ist sicher toll. Hoffentlicht kommst "
    "Du irgendwann auch in den Genuss." );
  AddDetail( "genuss",
    "Mit einem Hundeschlitten zu fahren, muss einfach ein Genuss sein." );
  AddDetail( "gepaeck",
    "Auf dem Aufbau des Hundeschlitten kann man das Gepaeck befestigen. Ausserdem "
    "koennte sich -bei weniger Gepaeck- eine zweite Person darauf setzen." );
  AddDetail( "person",
    "Also neben den Lenker koennte zusaetzlich eine zweite Person mitfahren." );
  AddDetail( ({ "holzkonstruktion","konstruktion" }),
    "Die Holzkonstruktion ist ein einfaches Geruest, an dem sich der Lenker "
    "waehrend der Fahrt festhalten kann. Mach Dir doch selbst ein Bild davon, "
    "wie Du Dir das Geruest vorstellst." );
  AddDetail( ({ "geruest","bild" }),
    "Bilde ich mir das ein, oder habe ich nicht gerade eben gesagt, Du sollst Dir "
    "selbst ein Bild von dem Geruest machen. Du kriegst keine Beschreibung von "
    "mir. Basta!" );
  AddDetail( "beschreibung",
    "Du kriegst keine mir! Lass es doch einfach bleiben!" );
  AddDetail( ({ "kufe","kufen" }),
    "Die Kufen sind 2,5 bis 3 Meter lang, damit die Schlitten eine grosse "
    "Laufflaeche im hohen Schnee haben. Vorne sind sie leicht nach oben "
    "gebogen, wahrend sie hinten ein bisschen breiter sind, damit sich der "
    "Lenker draufstellen und den Schlitten steuern kann. Auf ein paar liegt "
    "noch einwenig Schnee, ein Zeichen dafuer, dass die Schlitten in den "
    "letzten Tagen verwendet wurden." );
  AddDetail( "laufflaeche",
    "Die Unterseite der Kufen bezeichnet man als Laufflaeche, obwohl der Ausdruck "
    "Gleitflaeche besser passt, da der Schlitten auf dem Schnee gleiten soll." );
  AddDetail( "ausdruck",
    "Ob Dir der Ausdruck Laufflaeche oder Gleitflaeche besser gefaellt, musst Du "
    "selbst entscheiden." );
  AddDetail( "gleitflaeche",
    "Die Unterseite der Kufen kann man als Lauf- oder als Gleitflaeche bezeichnen, "
    "was Dir grad lieber ist." );
  AddDetail( "unterseite",
    "Die Unterseite der Kufen interessiert Dich nicht weiter und deshalb siehst Du "
    "sie Dir auch nicht naeher an." );
  AddDetail( "zeichen",
    "Der Schnee auf den Kufen der Hundeschlitten ist ein Zeichen dafuer, dass die "
    "Schlitten in den letzten Tagen gebraucht wurden." );
  AddDetail( ({ "lenker","fahrer" }),
    "Es ist derjenige gemeint, der den Hundeschlitten steuert. Vielleicht bist "
    "Du irgendwann einmal auch einer. Man kann ja nie wissen." );
  AddDetail( "platz",
    "Rechts vom Gang ist soviel Platz, dass zehn Hundeschlitten dort untergebracht "
    "werden konnten." );
  AddDetail( "seite",
    "Welche Seite vom Gang willst Du Dir ansehen?" );
  AddDetail( "linke seite",
    "Auf der linken Seite vom kurzen Gang sind zahlreiche Holzscheite zu einem "
    "Stapel aufgestapelt." );
  AddDetail( "rechte seite",
    "Rechts vom Gang wurden mehrere Hundeschlitten untergestellt, damit sie nicht "
    "den Witterungen ausgesetzt sind." );
  AddDetail( "witterungen",
    "Witterungen wie Kaelte, Schnee und Feuchtigkeit." );
  AddDetail( "kaelte",
    "In der Huette ist es merklich waermen als auf dem Ostplatz draussen." );
  AddDetail( ({ "relative feuchte","feuchtigkeit" }),
    "Die relative Feuchte ist hier ziemlich gering, da die meiste Feuchtigkeit vom "
    "Stroh aufgenommen wird." );
  AddDetail( "waende",
    "Du drehst Dich einmal langsam im Kreis und siehst dabei: eine Seitenwand, "
    "eine Rueckwand, eine weitere Seitenwand und eine Vorderwand. Alle "
    "bestehen aus mehreren Baumstammreihen." );
  AddDetail( ({ "baumstammreihen","baumstammreihe" }),
    "Alle Waende dieser Huette bestehen aus mehreren Baumstammreihen. Sie ist ja "
    "schliesslich vom Prinzip her gleich gebaut wie eine Blockhuette." );
  AddSpecialDetail( "kreis", "detailKreis" );
  AddDetail( "seitenwand",
    "Die von Dir aus linke Seitenwand sieht genau gleich aus wie die rechte." );
  AddDetail( "himmel",
    "Um den zu sehen, muesstest Du allerdings wieder aus der Huette raus gehen." );
  AddDetail( ({ "nasenspitze","nase" }),
    "Du schielst zu Deiner Nase hinunter, kannst aber leider nicht mehr als "
    "die Nasenspitze erkennen." );
  AddDetail( ({ "holzscheiten","braunbaerenfellen","schritten","tagen",
                "baumstamms","neues","lauf","armen","strohs","durchmessers",
                "inneren","baumstaemmen","seitenwaenden","stapeln" }),
    "Das kannst Du nicht untersuchen." );

  AddSound( DEFAULT_SOUND,
    "" );
  //Schritte, Stroh, Tier, Schneewiesel
  AddSmell( DEFAULT_SMELL,
    "Dir steigt natuerlich der Duft des Strohs in die Nase, ausserdem auch "
    "der vom Fichtenholz." );
  AddSmell( "nase",
    "Du versuchst verzweifelt an Deiner Nase zu riechen, um irgendwann "
    "festzustellen, dass es leichter geht mit ihr als sie selbst zu riechen." );
  AddSmell( ({ "duft","duefte" }),
    "Hier gibt es mehrere Duefte." );
//END DETAILS

  AddExit( "raus", "nach draussen#" + "./ostplatz_c1" );

  AddCmd( ({ "zieh","ziehe" }), "cmd_ziehen" );
  AddCmd( ({ "schieb","schiebe" }), "cmd_schieben" );
  AddCmd( ({ "mach","mache" }), "cmd_machen" );
  AddCmd( ({ "heb","hebe" }), "cmd_heben" );
  AddCmd( CMD_GREIFEN, "cmd_greifen" );
  AddCmd( CMD_DURCHSUCHEN, "durchsuchen" );
  AddCmd( ({ "zuend","zuende" }), "cmd_zuenden" );
  AddCmd( ({ "verscheuch","verscheuche","scheuch","scheuche" }), "cmd_verscheuchen" );
  AddCmd( ({ "spiel","spiele" }), "cmd_spielen" );
  AddCmd( ({ "erinner","erinnere" }), "cmd_erinnern" );
  AddCmd( ({ "test" }), "cmd_testen" );
}

int wieselstatus()
{
  return swiesel_da;
}
int wieselkommt()
{
  swiesel_da = 1;
}
int wieselweg()
{
  swiesel_da = 0;
}

//SPECIAL DETAILS
string detailHolzscheit()
{
  if ( vorstehender_scheit )
  {
    return BS(
      "Einen Scheit aus dem Stapel herauszuziehen, koennte doch gefaehrlich "
      "werden. Einer im Stapel mit den Holzscheiten von grossem Durchmesser sitzt "
      "locker und steht ein bisschen hervor." );
  }
  return BS(
    "Einen Scheit aus dem Stapel herauszuziehen, koennte doch gefaehrlich "
    "werden. Aber wenn Du unbedingt willst, dann trau Dich ruhig." );
}

string detailKreis()
{
  string text;

  text = "Weil Du es so lustig fandest, drehst Du Dich nochmals im Kreis.";
  //aehlich aufbauen wie bei Hunger !!!
  return BS( text );
}

string detailSchatten()
{
  if ( member(nest_entdeckt,getuid(TP)) == -1 )
    nest_entdeckt += ({ getuid(TP) });
  return BS(
    "Du drehst Deinen Kopf und blickst nach oben und staunst nicht schlecht, als "
    "Du neben dem schmalen Baumstamm ein Nest entdeckst." );
}

string detailNest()
{
  string text;

  text = "Ein wunderschoenes Nest wurde zwischen einem Baumstamm der Seitenwand "
         "und einem schmaeleren Baumstamm errichtet. Viele kleine Aeste wurden "
         "gesammelt und mit viel Liebe und Arbeit zu einer Art Kokon geformt, in "
         "dem sicherlich Vogeleltern mit zwei, drei Kuecken Unterschlupf finden. "
         "Ausserdem weist das Nest ein Loch auf, durch welches die Voegel hinein- "
         "und hinausfliegen koennen.";

  if ( !vogel_weg )
    text += " Im Nest scheint sich gerade etwas bewegt zu haben.";
  return BS( text );  
}

string detailLoch()
{
  if ( member(nest_entdeckt,getuid(TP)) != -1 )
  {
    return BS(
      "Das Nest hat ein kleines Loch, doch das die Voegel wahrscheinlich genau "
      "durch passen." );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

string detailAeste()
{
  if ( member(nest_entdeckt,getuid(TP)) != -1 )
  {
    return BS(
      "Viele kleine Aeste mussten gesammelt werden, um dieses wunderschoene Nest "
      "zu formen. Ganz genau wurden sie angereiht, sodass sich daraus eine Art "
      "Kokon gebildet hat." );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

string detailLiebe()
{
  if ( member(nest_entdeckt,getuid(TP)) != -1 )
  {
    return BS(
      "Das Nest wurde mit sehr viel Arbeit, aber noch mehr Liebe gebaut." );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

string detailKokon()
{
  if ( member(nest_entdeckt,getuid(TP)) != -1 )
  {
    return BS(
      "Von der Art her erinnert Dich das Nest an ein Kokon, als ob gleich etwas "
      "Neues darin entstehen wuerde." );
  }
  return BS(
    "Sowas siehst Du da nicht!" );
}

string detailVoegel()
{
  return BS(
    "Voegel." );
}
//END SPECIAL DETAILS
