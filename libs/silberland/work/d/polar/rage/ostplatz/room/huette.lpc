{
  notify_fail( "Was moechtest Du wo herausziehen?\n" );
}

int cmd_schieben(string str)
{
  notify_fail( "Was willst wo hinschieben?\n" );
}

int cmd_machen(string str)
{
  notify_fail( "Was moechstest Du nun schon wieder anstellen?\n" );
}

int cmd_heben(string str)
{
  notify_fail( "Willst Du jemanden hochheben?\n" );
}

int cmd_greifen(string str)
{
  notify_fail( "Wo moechtest Du reingreifen?\n" );
}

int cmd_durchsuchen(string str)
{
  notify_fail( "Was genau willst Du bitte durchsuchen?\n" );
}

int cmd_zuenden(string str)
{
}

int cmd_verscheuchen(string str)
{
  notify_fail( "Wen moechtest Du gern ver- oder aufscheuchen?\n" );
}

int cmd_spielen(string str)
{
  notify_fail( "Du bist ja ganz schoen verspielt! Womit willst Du herumspielen?\n" );
}

int cmd_erinnern(string str)
{
  notify_fail( "Hast Du schon wieder irgendetwas vergessen?\n" );
}

int cmd_testen(string str)
{
  object wiesel;
  
  notify_fail( "Was testen?\n" );

  if ( str == "wiesel" )
  {
    if ( swiesel_da )
    {
      wiesel = clone_object(NPC "swiesel");
      wiesel -> move(TO,M_GO);
      swiesel_da = 0;
      return 1;
    }
    write( BS(
      "Hier ist kein Wiesel.\n") );
    return 1;
  }
}
//END COMMANDS
void reset()
{
  ::reset();

  if ( !vogel_weg )
  {
    say( BS(
      "Ein Vogel fliegt aus den hinterem Teil der Huette ueber Deinen Kopf und "
      "verschwindet durch ein ganz kleines Loch direkt ueber dem Eingang nach "
      "draussen.") );
  }
  vogel_weg = random(5);
  nest_entdeckt = ({});
}
