//Osterweiterung des Xandimdorf, Rage Nov 00

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int exit_test();

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Dach" );
  SetProp( P_INT_LONG,
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TERRAIN:TT_TOWN, ENV_TEMPERATURE: -4]) );

  AddExit( "sueden", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : ROOM "hschmuckladen",
          EX_MSG      : "ueber die Baumstaemme nach unten in Richtung Sueden" ]) );
  AddExit( "norden", ([
          EX_TESTFUNC : #'exit_test,
          EX_DEST     : ROOM "ostplatz_b2" ,
          EX_MSG      : "ueber die Baumstaemme nach unten in Richtung Norden" ]) );
  AddExit( "westen", ([
         EX_TESTFUNC : #'exit_test,
         EX_DEST     : ROOM "ostplatz_a3",
         EX_MSG      : "ueber die Baumstaemme nach unten in Richtung Westen" ]) );
         SetProp( P_HIDE_EXITS, ({ "sueden","norden","westen" }) );
}

int exit_test()
{
  if ( !TP -> id("\nschneewiesel") )
  {
    write(
      "Wenn Du runter willst, musst Du das schon anders machen!\n" );
    return 0;
  }
  return 1;
}