// Lagerraum fuer Fellladen
// Filename: felllager.c
// File by Rage, Mai 00

inherit "std/store.lpc";

#include "../def.h"
#include "../felle.h"
#include <rooms.h>

int i;
int fellanzahl, zufall;

void create()
{
  ::create();
  
  if ( random(100) < 50 )
    AddItem( FELLE[12], REFRESH_REMOVE );
    
  fellanzahl = random(4)+2;
  for ( i=0; i<=fellanzahl; i++ )
  {
    zufall = random(12);
    AddItem( FELLE[zufall], REFRESH_REMOVE );
    "/d/polar/rage/ostplatz/room/fellladen_c3"->Setverstaubt();
  }
}

void reset()
{
  ::reset();

  return; // Das macht immer too long eval, waren hunderte Felle im Lager - Feyaria
  
  if ( random(100) < 50 )
    AddItem( FELLE[12], REFRESH_REMOVE );
    
  fellanzahl = random(4)+2;
  for ( i=0; i<=fellanzahl; i++ )
  {
    zufall = random(12);
    AddItem( FELLE[zufall], REFRESH_REMOVE );
    "/d/polar/rage/ostplatz/room/fellladen_c3"->Setverstaubt();
  }
}
