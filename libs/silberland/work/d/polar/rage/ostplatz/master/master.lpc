//Master auf Ostplatz, Rage Nov 00

#include "../def.h"
#include <moving.h>

int dach;
object *huskys;
object *huskyfeinde;

void create()
{
  if (is_clone(TO))
  {
    destruct(TO);
    return;
  }

  huskys = ({});
  huskyfeinde = ({});
  dach = random(6)+1;
  seteuid(getuid(TO));
  return;
}

//HUSKYMASTER
add_husky()
{
  huskys += ({ PO });
}
ruf_um_hilfe(object spieler)
{
  if ( member(huskyfeinde,spieler) == -1 )
    huskyfeinde += ({ spieler });
}
remove_husky()
{
  huskys -= ({ PO });
}
int IsHuskyfeind(object enemy)
{
  if ( member(huskyfeinde,enemy) != -1 )
    return 1;
  else
    return 0;
}
void Sieg(object player)
{
  huskyfeinde -= ({ player });
}
//ENDHUSKYMASTER

//KLETTERMASTER
int klettern_moeglich(int raumnummer)
{
  return( raumnummer == dach );
}
//ENDKLETTERMASTER

void reset()
{
  huskyfeinde = ({});
  dach = random(6)+1;
  return;
}
