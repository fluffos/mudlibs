//Eispalast, Rage Jan00

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

//ROOM DESCRIPTION

  SetProp( P_INT_SHORT, "Im Eispalast." );
  SetProp( P_INT_LONG,
    "");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -20, ENV_TERRAIN: TT_CAVE]) );

//END ROOM DESCRIPTION

//DETAILS

//END DETAILS

  AddExit( "osten", EROOM("palast_ebene1_b1") );
  NewDoor( "sueden", EROOM("palast_ebene1_a2"),
	 ({ "holztuer","tuer" }),
	 ({ D_LONG, "Die massive Fichtenholztuer soll sicher dafuer sorgen, "
                    "dass nicht jeder gleich durchspaziert.\n",
            D_GENDER, FEMALE,
            D_SHORT, "Eine %se massive Holztuer.",
            D_NAME, "massive Holztuer",
            D_MSGS, "nach Sueden",
	  }) );

}

//COMMANDS







