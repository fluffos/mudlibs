//Eispalast, Rage Jan00

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

//ROOM DESCRIPTION

  SetProp( P_INT_SHORT, "Im Eispalast." );
  SetProp( P_INT_LONG,
    "");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -20, ENV_TERRAIN: TT_CAVE]) );

//END ROOM DESCRIPTION

//DETAILS

//END DETAILS

  AddExit( "westen", EROOM("palast_ebene2_b2") );
  AddExit( "osten", EROOM("palast_ebene2_d2") );
  NewDoor( "norden", EROOM("palast_ebene2_c1"),
	 ({ "tuer" }),
         ({ D_LONG, "Eine Tuer.\n",
            D_GENDER, FEMALE,
            D_SHORT, "Eine %se Tuer.",
            D_NAME, "Tuer",
            D_MSGS, "nach Norden",
	  }) );
}

//COMMANDS




