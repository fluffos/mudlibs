#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

//ROOM DESCRIPTION

  SetProp( P_INT_SHORT, "Im Eispalast." );
  SetProp( P_INT_LONG,
    "");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -20, ENV_TERRAIN: TT_CAVE]) );

//END ROOM DESCRIPTION

//DETAILS

//END DETAILS

  AddExit( "norden", EROOM("palast_ebene1_c3") );
  AddExit( "sueden", EROOM("palast_ebene1_c5") );
  AddExit( "osten", EROOM("palast_ebene1_d4") );
  AddExit( "westen", EROOM("palast_ebene1_b4") );
  AddExit( "nordosten", EROOM("palast_ebene1_d3") );
}

