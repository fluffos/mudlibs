//Eispalast, Rage Jan00

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

//ROOM DESCRIPTION

  SetProp( P_INT_SHORT, "Im Eispalast." );
  SetProp( P_INT_LONG,
    "");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: -20, ENV_TERRAIN: TT_CAVE]) );

//END ROOM DESCRIPTION

//DETAILS

//END DETAILS

  NewDoor( "norden", EROOM("palast_ebene1_a1"),
         ({ "holztuer","tuer" }),
	 ({ D_LONG, "Die massive Fichtenholztuer sorgt dafuer, dass die hier "
                    "gelagerten Vorraete nicht so schnell abhanden kommen.\n",
            D_GENDER, FEMALE,
            D_SHORT, "Eine %se massive Holztuer.",
            D_NAME, "massive Holztuer",
            D_MSGS, "nach Norden",
	  }) );
}

