inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Paar Eisstiefel");
  SetProp(P_LONG,
        "Stiefel aus einem eisig schimmernden Material. Hoffentlich zerrinnen sie "+
        "in der Waerme nicht. Die Stiefel gehoerten einst einem Eismann. Komisch, dass sie "+
        "nicht schmelzen.");
  SetProp(P_NAME, "Eisstiefel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"stiefel","eisstiefel" }));

  SetProp(P_AC, 6);
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 2500); 
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-3, T_HEAT_PROT:4]) );
  AddProp(P_DAM_PROTECTION, ([DT_COLD:1]) );
  SetProp("itemd_elemental_value", (["eis":2]) );

}


