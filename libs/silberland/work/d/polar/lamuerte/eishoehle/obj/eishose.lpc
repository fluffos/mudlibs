inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"hose"}));
  SetProp(P_SHORT,"Eine Eishose");
  SetProp(P_LONG,
        "Eine Hose aus einem eisig schimmernden Material. Hoffentlich zerrinnt sie "+
        "in der Waerme nicht. Die Hose gehoerte einst einem Eismann. Komisch, dass sie "+
        "nicht schmilzt.");
  SetProp(P_NAME, "Eishose");
  SetProp(P_IDS, ({"hose","eishose"}) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AC, 5);
  SetProp(P_WEIGHT, 500);         
  SetProp(P_VALUE, 2500); 
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-4, T_HEAT_PROT:5]) );
  AddProp(P_DAM_PROTECTION, ([DT_COLD:1]) );
  SetProp("itemd_elemental_value", (["eis":2]) );
}
