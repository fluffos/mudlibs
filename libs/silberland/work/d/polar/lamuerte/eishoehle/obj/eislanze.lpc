inherit "std/weapon";

#include <properties.h>
#include <combat.h>

create()
{ 
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Eislanze");
  SetProp(P_LONG,
        "Die Eislanze ist ziemlich lang und schwer. Man braucht schon zwei "+
        "Haende um diese Waffe fuehren zu koennen. Die Lanze besteht aus reinstem, "+
        "hartem und sehr kaltem Eis. Verwunderlich, sie schmilzt gar nicht. ");
  SetProp(P_NAME, "Eislanze");
  AddId( ({"lanze","eislanze" }));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WC, 183 + random(67) );	
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 2500); 
  SetProp(P_NOBUY,1);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_COLD}));
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,MAT_ICE);
  SetProp(P_INFO, 
   "Diese Eislanze hat die Eislanzenklasse "+
   this_object()->QueryProp(P_WC)/10 +
   ". Was das wohl heissen mag.\n");
}
