inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Baerenzahn");
  SetProp(P_LONG, 
   "Ein grosser, scharfer Baerenzahn. Es scheint als wuerde dieser Zahn "+
   "von einem Hoehlenbaeren stammen. Viele Abenteurer sind diesem "+
   "Zahn schon zum Opfer gefallen. Du musst ein wahrer Held sein da Du diesen Zahn "+
   "erobert hast.");

  SetProp(P_VALUE,100);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Zahn");
  SetProp(P_MATERIAL, MAT_BONE );  
  SetProp(P_INFO,
   "Der Zahn schimmert in magischem Weiss.\n");
  
  AddId (({"zahn","baerenzahn"}));
 
  seteuid(getuid());
  
}

