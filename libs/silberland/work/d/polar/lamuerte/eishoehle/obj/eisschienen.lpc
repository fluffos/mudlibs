inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId( ({"schienen","eisschienen","armschienen"}) );

  SetProp(P_SHORT,"Eisschienen");
  SetProp(P_LONG,
        "Das sind Armschienen aus einem eisig schimmernden Material. Hoffentlich "
        "zerrinnen sie in der Waerme nicht. Die Schienen gehoerten einst einem "
        "Eismann. Komisch, dass sie nicht schmelzen.");

  SetProp(P_NAME, "Eisschienen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_AC, 5 ); 
  SetProp(P_WEIGHT, 500); 
  SetProp(P_VALUE, 2500); 
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-2, T_HEAT_PROT:3]) );
  AddProp(P_DAM_PROTECTION, ([DT_COLD:1]) );
  SetProp("itemd_elemental_value", (["eis":2]) );
}

