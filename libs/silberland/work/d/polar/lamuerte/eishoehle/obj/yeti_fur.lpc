inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Yetifell");
  SetProp(P_LONG, 
       "Ein grosses, warmes, kuscheliges Yetifell. Es schimmert hellbraun "+
       "bis weiss. Viele Grosswildjaeger waeren froh, solch ein schoenes "+
       "Yetifell zu besitzen. Auf der Unterseite des Fells findest Du einen "+
       "kleinen Zettel.");

  AddDetail("zettel",
   "Tokoyama Naroshi Yeti Fur's.\nMade in China.\n");

  SetProp(P_VALUE,100);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Yetifell");
  SetProp(P_MATERIAL, MAT_FUR ); 
  SetProp(P_INFO,
   "Das Yetifell schimmert Weiss.\n");
  
  AddId (({"fell","yetifell","\nfell_is_gerb_able"}));
 
  seteuid(getuid());
  
}

