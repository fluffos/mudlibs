inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Eisschluessel");
  SetProp(P_LONG, 
   "Ein kleiner eisiger Schluessel. Passt wohl zu einer Eistuere.");

  SetProp(P_NOGET,0);
  SetProp(P_NODROP,0);
  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schluessel");
  SetProp(P_MATERIAL, MAT_ICE);  
  AddId( ({"\neiskey","schluessel","eisschluessel"}));
 
  seteuid(getuid());
  

}


