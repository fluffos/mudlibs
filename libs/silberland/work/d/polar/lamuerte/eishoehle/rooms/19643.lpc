inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "Ein eisiger Durchgang" );
   SetProp(P_INT_LONG,  "Die eisigen Waende glitzern im Licht Deiner Fackel. Der Boden ist weich "+
         "und sieht aus als waere er poliert worden. Nicht eine Schneeflocke kann hier "+
         "ausgemacht werden. Du hoerst ein eisiges Geraeusch aus einiger Entfernung. Diese Hoehle "+
         "setzt sich im Osten und Sueden fort." );

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -10]));

   AddItem( NPC("ice_cubes"), REFRESH_DESTRUCT );
   AddItem( NPC("iceman"), REFRESH_REMOVE );
   
   AddSound( ({DEFAULT_SOUND, "geraeusche"}),
    "Du hoerst ein seltsames Picken.");
   AddSound("picken",
    "Es hoert sich an als ob man mit einem Eiszapfen auf den eisigen Boden klopft.");
   
   AddDetail(({"wand","waende"}),
    "Die Waende sind hier blitzblank.");
   AddDetail("licht",
    "Das Licht ist verblueffenderweise hell!");
   AddDetail("boden",
    "Der Boden ist hier aeusserst sauber.");
   AddDetail(({"schnee","flocke","schneeflocke"}),
    "Keine einzige Schneeflocke zu sehen.");
   AddDetail("decke",
    "Selbst die Decke scheint geputzt worden zu sein.");

   AddExit( "sueden", "./19646" );
   
   AddGuardedExit( "osten", ROOM("19647") , "enpc",
    "Das eisige Wesen laesst Dich nicht vorbei.\n" );
        
        
}
