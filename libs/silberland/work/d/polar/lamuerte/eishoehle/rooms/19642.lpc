inherit "std/room";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
   ::create();
    

   SetProp(P_INT_SHORT,  "Eine eisige sehr kalte Hoehle" );
   SetProp(P_INT_LONG,  "Du wanderst in eine mit Eis ausgekleidete Hoehle herein. Der Tunnel "+
         "zeigt hier eine magische Schoenheit welche ihm durch viele Lichtreflektionen "+
         "im Boden, in den Waenden und in den vielen Eiszapfen, welche sich auf der "+
         "Decke befinden, verliehen wird. Im Westen liegt eine grosse Eistuer. "+
         "Die Hoehle setzt sich im Westen und Sueden fort."); 
     
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -13]));
   
   AddDetail("eis",
    "Das Eis foerdert hier die Lichtreflektionen.");
   AddDetail("hoehle",
    "Sie besteht vollstaendig aus glaenzendem Eis.");
   AddDetail("schoenheot",
    "Du bist ueberwaeltigt.");
   AddDetail(({"licht","reflektionen","lichtreflektionen"}),
    "Die Reflektionen sind so hell, dass sie Dich fast blenden.");
   AddDetail("boden",
    "Der Boden besteht aus hartem Eis.");
   AddDetail(({"wand","waende"}),
    "Die Waende bestehen aus glaenzendem Eis.");
   AddDetail("decke",
    "Die Decke traegt viele Eiszapfen in denen sich Licht reflektiert.");
   AddDetail(({"zapfen","eiszapfen"}),
    "In den vielen Eiszapfen bricht sich das Licht.");
   AddDetail(({"tuer","eistuer"}),
    "Die Eistuer sieht ziemlich massiv aus.");
   AddDetail("tunnel",
    "Der gesammte Tunnel besteht hier aus Eis."); 
   
   
   AddExit( "sueden", "./19644" );
   AddExit( "westen", "./19641" );
 
}
