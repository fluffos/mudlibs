inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Du stehst in einer kleinen eisigen Hoehle. Kleine Kristalle aus "+
         "Eis befinden sich auf den Waenden, am Boden und auf der Decke. Der Boden "+
         "ist mit Steinen und Eis uebersaeht. Ein Geruch der Verwesung haengt in "+
         "der Luft. Ein eisiger Tunnel fuehrt vom Norden kommend in den Osten.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -7]));

   AddSmell(DEFAULT_SMELL,
    "Hier stinkt es erbaermlich.");
   AddSmell("verwesung",
    "Dir wird uebel.");
   AddSmell("luft",
    "Es riecht nach verwesten Leichenteilen.");
   
   AddDetail("tunnel",
    "Hauptbestandteil des Tunnels ist wohl oder uebel Eis.");      
   AddDetail("boden",
    "Er ist mit Eis, Schnee und Steinen vollgestopft.");
   AddDetail(({"eis","eisbrocken"}),
    "Das Eis ist glatt und hat ca. -15 Grad.");
   AddDetail("schnee",
    "Der Schnee ist weiss und kalt.");
   AddDetail("steine",
    "Die Steine liegen ueberall in der Gegend herum.");
   AddDetail(({"wand","waende"}),
    "Die Waende bestehen aus Eis und Steinen.");
   AddDetail("decke",
    "Die Decke besteht aus purem Eis.");
   AddDetail(({"gasse","sackgasse"}),
    "Nada, nix. Umkehren ist angesagt.");
   AddDetail(({"raum","hoehlenraum"}),
    "Der Raum besteht grossteils aus Eis.");
   AddDetail(({"ausgang","ausgaenge"}),
    "Im Westen gehts raus aus dem Hoehlenraum.");
   AddDetail("schneehaufen",
    "Die Schneehaufen sind weiss, kalt und gross. *grins*");
   AddDetail("hoehle",
    "Es ist kalt hier drinnen.");
   AddDetail("kristalle",
    "Verblueffend, diese Kristalle funkeln ganz und gar nicht.");
   AddDetail("gegend",
    "Ausser kalt ist es in der Gegend nur kalt.");
   
   AddExit( "norden", "./19619" );
   AddExit( "osten", "./19616" );


}
