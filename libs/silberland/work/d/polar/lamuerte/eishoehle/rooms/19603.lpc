inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer erdigen Hoehle" );
   SetProp(P_INT_LONG,  "Die Waende der Hoehle sind kalt und nass. In einer Ecke "+
         "liegt eine schleimige gruene Masse. Der Boden fuehlt sich hier drinnen "+
         "sehr weich an. Wildes Geheule ist aus der Ferne zu hoeren, welches Dich "+
         "zusammenzucken laesst. Die Hoehle setzt sich im Osten, Westen und Sueden "+
         "fort." );

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));
   AddSound(DEFAULT_SOUND,
    "Uhhhhhhhiiiooooooooooooiiiiuuuuuuuuuu!!!");
   AddSound("geheule",
    "Uhhhhhhhiiiooooooooooooiiiiuuuuuuuuuu!!!");
   
   AddDetail("hoehle",
    "Hier drinnen ist alles voll Matsch und Schlamm.");
   AddDetail("matsch",
    "Sieht ziemlich ekelig aus.");
   AddDetail("schlamm",
    "Der Schlamm sieht noch ekeliger aus als der Matsch.");
   AddDetail(({"eck","ecke", "ecken"}),
    "In einer der Ecken siehst Du eine schleimige Masse liegen.");
   AddDetail("schleim",
    "Als Du den Schleim naeher untersuchest, musst Du Dich beinahe "+
    "uebergeben.");
   AddDetail("masse",
    "Nein, das ist zu ekelig um es zu untersuchen.");
   AddDetail("boden",
    "Der ganze Boden ist hier weicher als im Rest der Hoehle. Wahrscheinlich "+
    "wurde er von der schleimigen Masse aufgeweicht.");
   AddDetail("decke",
    "Es ist zu dunkel um die Decke genauer untersuchen zu koennen.");
   AddDetail(({"wand","waende"}),
    "Ihh. Diese Waende sind ja auch ganz schleimig, schnell raus von hier.");
    


   AddExit( "osten", "./19604" );
   AddExit( "sueden", "./19602" );
   AddExit( "westen", "./19605" );



}
