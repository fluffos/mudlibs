inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Die Hoehle verjuengt sich ein wenig im Sueden. "+
         "Es muss wohl ein Teil der Hoehle eingestuerzt sein. Riesige Eisbrocken "+
         "versperren einen Grossteil des Weges in den Sueden. Du hoerst lautes "+
         "Brummen hinter den Eisbrocken. Der Tunnel setzt sich in den Norden "+
         "und Sueden fort. " );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -3]));
   
   AddSound(DEFAULT_SOUND,
    "Brummmmmmmmmmmmm!");
   
   AddDetail("hoehle",
    "Sie wird um einiges schmaeler im Sueden, bedingt durch riesige Eisbrocken.");
   AddDetail("teil",
    "Ein Teil der Hoehle ist tatsaechlich eingestuerzt.");
   AddDetail("grossteil",
    "Der Grossteil des Weges in den Sueden wird von riesigen Eisbrocken "
    "versperrt." );
   AddDetail(({"eisbrocken","brocken", "eismassen"}),
    "Sie sind schwer, kalt und riesig.");
   AddDetail("weg",
    "Der Weg in den Sueden ist von Eismassen grossteils verschuettet.");
   AddDetail("tunnel",
    "Du stehst inmitten drinnen.");
   AddDetail("boden",
    "Der Boden ist mit Schnee und Eis bedeckt.");
   AddDetail("schnee",
    "Der Schnee ist ziemlich kalt hier drinnen.");
   AddDetail("eis",
    "Das Eis ist noch kaelter als der Schnee.");
   AddDetail("decke",
    "Keine Eiszapfen zu sehen. Die sind wahrscheinlich beim Einsturz "+
    "von der Decke gefallen.");
   AddDetail("einsturtz",
    "Sei froh das Du zum Zeitpunkt des Einsturtzes nicht hiergesatanden bist.");
   AddDetail("zeitpunkt",
    "Keine Ahnung wann das war.");
   AddDetail(({"wand","waende"}),
    "Kalt, glatt und mit Eis bedeckt.");
   AddDetail("eis",
    "Brrr ist das Kalt..");
    
   
   AddExit( "norden", "./19614" );
   AddExit( "sueden", "./19616" );

}
