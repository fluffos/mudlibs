raus()
 {object *things,*people,*all;
 int i;
 
 all=all_inventory(this_object()); 
 people=filter_array(all_inventory(this_object()), #'query_once_interactive ); 

 things=all-pople;
 
 for(i=sizeof(things)-1;i>=0;i--)
     things[i]->move(ROOM("./blah.lpc"), M_NOCHECK);
 
 }                                                                                                                                                         
