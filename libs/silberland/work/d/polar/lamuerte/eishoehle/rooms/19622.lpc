inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer schmutzigen, gefrorenen Hoehle" );
   SetProp(P_INT_LONG,  "Die Hoehle verlaeuft hier gerade vom Osten in den Westen. "+
         "Du erkennst Fusspuren im matschigen Boden. Viele der Spuren sehen aus "+
         "als wuerden sie von Menschen stammen, aber Du bist Dir nicht ganz sicher. "+
         "Du hoerst schuerfende Geraeusche aus einiger Entfernung.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -4]));
   
   AddSound(DEFAULT_SOUND,
    "Du hoerst ein schabendes Geraeusch.");
   AddSound("geraeusch",
    "SCHHAAAAAAAAAAAAAAAAAABBBB!");

   AddDetail("hoehle",
    "Die besteht teilweise aus Eis und teilweise aus Erde.");
   AddDetail("eis",
    "Das Eis ist weiss und furchtbar kalt.");
   AddDetail("erde",
    "Die Erde ist steinhart. Duerfte gefroren sein."); 
   AddDetail(({"spuren","fusspuren"}),
    "Man kann nicht genau erkennen wer oder was diese Spuren hinterlassen hat.");
   AddDetail("menschen",
    "Keine da, oder doch?!");
   AddDetail("boden",
    "Der Boden ist matschig.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind eiskalt.");
   AddDetail("decke",
    "Die Decke duerfte aus Erde bestehen.");
   
   AddExit( "osten", "./19623" );
   AddExit( "westen", "./19621" );

}
