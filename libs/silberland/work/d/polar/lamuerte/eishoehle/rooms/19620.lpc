inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer schmutzigen, gefrorenen Hoehle" );
   SetProp(P_INT_LONG,  "Du findest Dich inmitten kleiner Schneeverwehungen, auf duennen "+
         "Eisschollen dahinschlitternd, in einer kleinen Hoehle wieder. Die Luft ist brennend "+
         "kalt. Du hoerst undefinierbare Klaenge aus der Ferne. Die Hoehle setzt sich "+
         "im Norden und Westen fort. " );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -8]));

   AddItem(NPC("snowman.lpc"), REFRESH_DESTRUCT);
   
   AddSound(DEFAULT_SOUND,
    "Wirklich undefinierbar diese Geraeusche.");
   AddSound("klaenge",
    "Du kannst sie nicht zuordnen.");
   
   AddDetail("decke",
    "Nichts besonderes zu sehen.");
   AddDetail("schnee", 
    "Der Schnee ist beissend kalt.");
   AddDetail(({"schneeverwehungen","verwehungen"}),
    "Sie pfeifen Dir um die Ohren.");
   AddDetail("ohren",
    "Deine Ohren sind schon fast abgefroren.");
   AddDetail(({"schollen","eisschollen"}),
    "Sie bestehen aus ziemlich duennen Eis.");
   AddDetail("eis",
    "Es ist durchsichtig und ziemlich kalt.");
   AddDetail("hoehle",
    "Dank dem vielen Eis ist es relativ hell hier drinnen.");
   AddDetail("luft",
    "Die Luft ist fast am gefrieren.");
   AddDetail("ferne",
    "Das Gegenteil von Naehe.");
   AddDetail("boden",
    "Er ist mit Eis bedeckt.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind eisig kalt.");
     
   AddExit( "norden", "./19621" );
   AddExit( "westen", "./19614" );

}
