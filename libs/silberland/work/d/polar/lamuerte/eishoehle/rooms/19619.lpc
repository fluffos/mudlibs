inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "Ein eisiger Hoehlenraum" );
   SetProp(P_INT_LONG,  "Du erreichst einen eisigen Hoehlenraum. Eine "+
   	 "schwarze Suppe aus Matsch, Schnee und Dreck bedeckt den Boden. "+
   	 "Es sieht so aus als ob hier etwas oder jemand wohnt. Auf jeden "+
   	 "Fall kann es nichts sein, was Reinlichkeit "+
         "liebt. Der Ausgang aus dem Hoehlenraum befindet sich im Sueden." );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddSmell(DEFAULT_SMELL,
    "Wie wars anders zu erwarten bei dem ganzen Dreck, es stinkt.");
   
   AddDetail("fall",
    "Wo willst Du hinfallen?");
   AddDetail("ausgang",
    "Der Ausgang liegt im Sueden.");
   AddDetail( ({"hoehlenraum","raum"}),
    "Es scheint etwas waermer zu sein hier drinnen.");
   AddDetail("boden",
    "Igitt! Lauter Dreck am Boden. Und wie das stinkt!");
   AddDetail(({"dreck","suppe"}),
    "Matsch und Schnee vereinigen sich zu herrlichem Dreck.");
   AddDetail("matsch",
    "Der Matsch sieht sehr unappetitlich aus.");
   AddDetail("schnee",
    "Vermischt mit dem Matsch ist das ein grauenhafter Anblick.");
   AddDetail(({"etwas","jemand"}),
    "Keiner da?! Oder doch!");
   AddDetail("reinlichkeit",
    "Na von Sauberkeit kann man hier wohl kaum reden.");
   AddDetail(({"wand","waende"}),
    "Ihh.. Sind die Waende dreckig.");
   AddDetail("decke",
    "Es darf doch nicht wahr sein, sogar die Decke steht vor lauter Dreck.");
       
    
   AddExit( "sueden", "./19618" );  

}
