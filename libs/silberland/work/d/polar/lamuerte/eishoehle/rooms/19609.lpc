inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "Eine Sackgasse in der Hoehle" );
   SetProp(P_INT_LONG,  "Ein kleiner, einigermassen gemuetlicher Raum im Hoehlensystem. "+
         "Sogar der sonst in der Hoehle so verschmutzte Boden ist hier halbwegs sauber. "+
         "Nur ein Fell und eine Anhaeufung von Knochen tummeln sich hier am Boden herum. "+
         "Du bemerkst einen Vorhang vor dem Ausgang, welcher wohl eine Art von "+
         "Privatsphaere ermoeglichen soll. Du kannst aus einiger Entfernung ein Kind schreien hoeren. Es muss "+
         "ganz in der Naehe, irgendwo im Hoehlensystem versteckt sein. Der einzige Ausgang "
         "aus diesem Hoehlenraum liegt im Osten. " );

      
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddSound(DEFAULT_SOUND,
    "Du hoerst ein Kind laut schreien.");
   AddSound("kind",
    "Wahhhhhhh Wahhhhhhhh Wahhhh!!!");
   
   AddSmell(DEFAULT_SMELL,
    "Huch, hier stinkts nicht mal?!");
   
   AddDetail("system",
    "Scheint gar nicht mal so klein zu sein.");
   AddDetail(({"anhaeufung","haufen"}), 
    "Viele, viele Knochen.");
   AddDetail(({"raum","hoehlenraum"}),
    "Der erste Raum in dieser Hoehle in dem es halbwegs ordentlich aussieht.");
   AddDetail("hoehle",
    "Du stehst inmitten drinnen.");
   AddDetail("boden",
    "Es sieht aufgeraeumt aus am Boden.");
   AddDetail("fell",
    "Es ist weich und kuschelig.");
   AddDetail("knochen",
    "Die Knochen sehen nicht gerade appetitlich aus.");
   AddDetail("vorhang",
    "Naja, der ist doch dreckig, besser Du greifst ihn nicht an.");
   AddDetail("ausgang",
    "Es haengt ein Vorhang beim Ausgang. Der Ausgang fuehrt nach Osten.");
   AddDetail("privatsphaere",
    "Nein, bestimmt nicht in dieser Hoehle.");
   AddDetail("kind",
    "Du kannst es nur hoeren, nicht aber sehen.");
   AddDetail("hoehlensystem",
    "Schoen langsam wird Dir klar, dass die Hoehle nicht gerade "+
    "klein ist.");
   AddDetail(({"wand","waende"}),
    "Tja, hier sind die Waende zwar sehr kalt, aber sauber!");
   AddDetail( "decke",
    "Die ist ueber Dir.");   
      

   AddExit( "osten","./19608" );

}
