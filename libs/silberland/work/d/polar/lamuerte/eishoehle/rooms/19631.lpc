inherit "std/room";
#include <properties.h> 
#include <language.h> 

#include "files.h"


create()
{
   ::create();
   SetProp(P_INT_SHORT,  "In einer gefrorenen Schneehoehle" );
   SetProp(P_INT_LONG,  "Du stehst in einem kleinen Raum, eingehuellt in Eis. "+
         "Die Waende schimmern nahezu magisch wenn das Licht Deiner Fackel auf "+
         "sie scheint. Die Luft ist fuerchterlich kalt und feucht. Die Chancen hier "+
         "einzufrieren stehen gut fuer Dich. Am Boden sind grosse Schneeverwehungen "+
         "zu sehen. Ausserdem sind viele Fusspuren im Schnee, welche sehr nach menschlichen "+
         "Wesen aussehen." );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -16]));

   AddItem(NPC("snowman.lpc"), REFRESH_DESTRUCT);
   AddItem( NPC("iceman"), REFRESH_REMOVE );
   
   AddDetail(({"raum","hoehle","schneehoehle"}),
    "Du hast wohl den Kaeltepol der Hoehle erreicht. Hier ist es wirklich kalt.");
   AddDetail("kaelte",
    "Du spuerst wie sich Dir alles zusammenzieht bei der Kaelte.");
   AddDetail("alles",
    "Ja, wirklich alles, sogar Dein aehm.. Dings."); 
   AddDetail("kaeltepol", 
    "Schaetzomativ hat es -10 bis -20 Grad.");
   AddDetail( ({"wand","waende"}),
    "Die Waende scheinen kurz vorm zerspringen zu sein. Wen wunderts bei der "+
    "Kaelte.");
   AddDetail("eis",
    "Eis, Eis und nochmal Eis. Soweit das Auge reicht.");
   AddDetail("licht",
    "Das Licht ist... hell!");
   AddDetail("luft",
    "Sie scheint schon fast zu gefrieren.");
   AddDetail(({"chance","chancen"}),
    "Denk besser nicht daran. Vielleicht ueberlebst Du ja auch.");
   AddDetail("boden",
    "Am Boden sind einige Schneeverwehungen zu sehen.");
   AddDetail(({"verwehungen", "schneeverwehungen"}),
    "Pfoa, sind die gross.");
   AddDetail("schnee",
    "Im Schnee waechst kein Klee. Drum gibts hier auch kein Re(h)");
   AddDetail(({"klee","re","re(h)","reh"}),
    "Nein, gibts hier wirklich nicht.");
   AddDetail(({"fusspuren","spuren","spur"}),
    "Hmm.. Diese sind irgendwie groesser als Deine.");
   AddDetail("wesen",
    "Keiner da, oder doch?!");
   AddDetail("decke",
    "Die Decke wirkt irgendwie erdrueckend hier drinnen.");
   AddDetail("auge",
    "Du greifst Dir ins Auge. Autsch!! Das hat wehgetan.");
   
   AddGuardedExit( "westen", ROOM("19630") , "enpc", 
    "Das eisige Wesen laesst Dich nicht vorbei.\n" );
   AddExit( "norden", "./19632" );

}
