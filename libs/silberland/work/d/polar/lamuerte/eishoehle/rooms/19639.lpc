inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Eine duenne Schneeschicht liegt hier am Boden. Darunter verbirgt sich "+
         "eine harte Eisschicht. Die Schneeschicht ist hier ziemlich hart, nicht so weich und "+
         "flaumig wie in den anderen Teilen der Hoehle. Im Osten siehst Du eine kleine "+
         "Hoehle, in welche Fusspuren fuehren. Die Hoehle setzt sich im Norden, Osten und "+
         "Sueden fort.");

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -16]));
   
   AddDetail(({"teil","teile","teilen"}),
    "Jo, in diesem Teil ist der Schnee weicher, oder?!");
   AddDetail("schnee",
    "Der Schnee ist ziemlich hart hier.");
   AddDetail("schneeschicht",
    "Die Schicht ist zwar duenn, aber sehr hart.");
   AddDetail("boden",
    "Er ist mit einer duennen Schneeschicht ueberzogen.");
   AddDetail("eis",
    "Das Eis ist haerter als der haerteste Schnee.");
   AddDetail("eisschicht",
    "Hoffentlich rutscht Du nicht aus auf dieser bloeden Eisschicht.");
   AddDetail("hoehle",
    "Es ist sehr sehr kalt hier.");
   AddDetail(({"spuren","fusspuren"}),
    "Die Fusspuren fuehren in den Osten.");
   AddDetail("decke",
    "Die Decke ist total vereist.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind ziemlich kalt, da sie ja gefroren sind."); 

   AddExit( "norden", "./19638" );
   AddExit( "osten", "./19641" );
   AddExit( "sueden", "./19640" );

}
