inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Du wanderst in eine eisige Hoehle. Der Boden ist ziemlich "+
         "rauh und uneben und an einigen Stellen ist es ziemlich glatt und rutschig. "+
         "Der Durchgang in den Norden ist einwenig verjuengt, da grosse Eisbloecke "+
         "herumliegen. Einige Steine schauen unter der Schneedecke hervor, welche "+
         "grossteils mit Eiskristallen ueberzogen sind. Der Weg fuehrt im "+
         "Norden, Osten und Westen weiter." );

      
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -5]));
   
   AddDetail("stellen",
    "An einigen Stellen ist es ziemlich glatt und rutschig.");   
   AddDetail("durchgang",
    "Es liegt viel Schnee herum im Durchgang.");
   AddDetail(({"stein","steine"}),
    "Die Steine sind mit Eis ueberzogen.");
   AddDetail(({"eiskristalle","kristalle"}),
    "Sie funkeln in allen Farben.");
   AddDetail("farben",
    "Rot, blau, gelb, gruen... alles da.");
   AddDetail("hoehle",
    "Sie wird um einiges schmaeler im Norden, bedingt durch riesige Eisbrocken.");
   AddDetail("teil",
    "Ein Teil der Hoehle ist tatsaechlich eingesteutzt.");
   AddDetail(({"eisbrocken","brocken", "eismassen"}),
    "Sie sind schwer, kalt und riesig.");
   AddDetail("weg",
    "Der Weg in den Sueden ist von Eismassen grossteils verschuettet.");
   AddDetail("tunnel",
    "Du stehst inmitten drinnen.");
   AddDetail("boden",
    "Der Boden ist mit Schnee und Eis bedeckt.");
   AddDetail(({"schnee","schneedecke"}),
    "Der Schnee ist ziemlich kalt hier drinnen.");
   AddDetail("decke",
    "Keine Eiszapfen zu sehen. Die sind wahrscheinlich beim Einsturz "+
    "von der Decke gefallen.");
   AddDetail("einsturtz",
    "Sei froh das Du zum Zeitpunkt des Einsturtzes nicht hiergesatanden bist.");
   AddDetail("zeitpunkt",
    "Keine Ahnung wann das war.");
   AddDetail(({"wand","waende"}),
    "Kalt, glatt und mit Eis bedeckt.");
   AddDetail("eis",
    "Brrr ist das kalt..");
   AddDetail("eisbloecke",
    "Die Eisbloecke sind gross, kalt und weiss."); 

   

   AddExit( "norden", "./19615" );
   AddExit( "osten", "./19617" );
   AddExit( "westen", "./19618" );
   
}
