inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer erdigen Hoehle" );
   SetProp(P_INT_LONG,  "Du wanderst in dieser kleinen schmalen Hoehle herum. "+
         "Die Waende und der Boden sind hier mit einer dicken Moosschicht "+
         "ueberzogen. Dieser bekannte, modernde Geruch laesst Dich auch hier "+
         "nicht in Frieden. Am Boden erkennst Du viele Fussabdruecke welche"+
         ", so wie es aussieht, von mehreren unterschiedlichen Kreaturen stammen. "+
         "Eine Spur am Boden laesst vermuten, dass durch diesen Raum etwas "+
         "durchgeschleift wurde. Die Hoehle macht hier eine Biegung vom Sueden "+
         "in den Westen.");
     
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddSmell(DEFAULT_SMELL,
    "Es stinkt nach Tod.");
   
   AddDetail("rille",
    "Du kannst nichts besonderes an der Rille finden.");
   AddDetail(({"kreatur","kreaturen"}),
    "Du kannst keine 'crea tur' sehen, oder doch?");
   AddDetail("Die Spuren sind von aehm... keine Ahnung von wem die sind.");
   AddDetail("hoehle",
    "Hmm.. Die Spur am Boden weckt Deine Neugierde.");
   AddDetail("biegung",
    "Sieht ziemlich verbogen aus diese Biegung.");
   AddDetail("boden",
    "Es befindet sich eine Schleifspur am moosueberwachsenen Boden. Ausserdem "+
    "sind hier viele Fusspuren zu sehen.");
   AddDetail(({"spur","schleifspur"}),
    "Eine tiefe Rille im Moos.");
   AddDetail(({"moos","moosschicht"}),
    "Eine Schleifspur und etwas Blut faellt Dir sofort ins Auge.");
   AddDetail("blut",
    "Nachdem das Blut direkt in der Schleifspur ist, wird wahrscheinlich "+
    "jemand eine Leiche durch diesen Raum geschleift haben.");
   AddDetail("leiche",
    "Keine Leiche zu sehen. Nur eine Schleifspur.");
   AddDetail("raum",
    "Es ist praktisch der ganze Raum mit Moos ueberzogen.");
   AddDetail(({"spur","fusspur","abdruecke","fussabdruecke"}),
    "Es muss mehr als eine Kreatur gewesen sein. Es sind einfach zu viele "+
    "Spuren.");   
   AddDetail(({"wand","waende"}),
    "Die Waende sind mit Moos bewachsen.");
   AddDetail("decke",
    "Man kann es nicht genau erkennen, doch es sieht so aus als ob selbst "+
    "die Decke mit Moos bewachsen waere.");
  
   AddExit( "sueden", "./19607" );
   AddExit( "westen", "./19609" );


}
