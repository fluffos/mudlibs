inherit "std/room";
#include <properties.h>
#include <language.h>
#include "files.h"
#include <moving.h>

int i;

create()
 { 

   ::create();

   SetProp(P_INT_SHORT, "Eine eisige Hoehle" );
   SetProp(P_INT_LONG,  "Du stehst in einer kleinen eisigen Hoehle. Der Boden ist mit einer "+
         "duennen Schicht aus eisigem Schnee bedeckt. Viele Eiszapfen haengen hier von der "+
         "Decke herunter. Im Osten siehst Du eine massive Eistuer, welche wirklich beeindruckend "+
         "aussieht. Das Eis aus dem die Tuer besteht scheint fast durchsichtig zu sein. "+
         "Der Ausgang liegt im Westen." );

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -12]));

   AddDetail("hoehle",
    "Es ist wirklich bitterkalt hier drinnen. Die Eistuer faellt Dir hier "+
    "sofort ins Auge.");
   AddDetail("boden",
    "Der Boden ist mit einer harten Schneeschicht bedeckt.");
   AddDetail(({"schnee","schneeschicht","schicht"}),
    "Der Schnee ist hier aeusserst hart.");
   AddDetail(({"zapfen","eiszapfen"}),
    "Sie sind sehr lang, eiskalt und fast durchsichtig.");
   AddDetail("decke",
    "Sie ist mit hunderten Eiszapfen gespickt.");
   AddDetail(({"tuer","eistuer"}),
    "Was da wohl dahinter sein wird?!");
   AddDetail("ausgang",
    "Der Ausgang befindet sich im Westen.");
   AddDetail(({"wand","waende"}),
    "Die Waende bestehen grossteils aus Eis. In einer Wand befindet sich "+
    "eine grosse Eistuer.");
   AddDetail("eis",
    "Das Eis ist steinhart und saukalt.");
   AddDetail("auge",
    "Hast Du was auf den Augen? Die Tuer dort drueben sieht toll aus.");

  AddSpecialDetail(({"tuer","eingang","tor","eistuere","eistuer"}),"tfunc");

   //AddExit( "eistuer", "./19642" ); // TUER EINBAUN NICHT VERGESSEN!
   AddSpecialExit("osten","ofunc");
   AddExit( "westen",  "./19639" );

   AddCmd("oeffne","aufunc");
}

tfunc()
 {if (i==0)
   {write("Die Eistuere, "+
    "ist fest verschlossen.\nMal mit oeffnen versuchen?\n");
    return "";
   }

  if (i!=0)
   {write("Die Eistuere steht offen.\n");
    return "";
   }
  write ("error in Door, contact WIZARD!!");
  return "";
  }



aufunc(str)
{object ob;


 if (!str)
 {notify_fail("So nicht!\n");
  return 0;
 }

 if (str=="ruere" || str=="tuer" || str == "tor" || str=="eistuer" || str =="eistuere")
  {if (!ob=present("\neiskey",this_player()))
    {write ("Du brauchst den richtigen Schluessel um hier durchzukommen.\n");
     return 1;
    }

    write("Du steckst den Schluessel ins Schloss, sperrst auf und oeffnest\n"+
          "die Tuer. Durch magische Kraefte verschwindet der Schluessel.\n");
    say(this_player()->QueryProp(P_NAME)+" oeffnet eine Tuer.\n");
    ob->remove();
    i=1;
    return 1;
   }
  notify_fail("Was willst Du denn oeffnen?\n");
 return 0;
 }


ofunc()
 {if (i==0)
  {
   write("WUMMMS. Du rennst mit voller Wucht gegen die Eistuere!\n");
   this_player()->reduce_hit_point(20);
   return 1;
   }

   this_player()->move(ROOM("19642.lpc"),M_GO,"durch die Tuere");
   return 1;
 }

reset()
{::reset();
 i=0;
}

