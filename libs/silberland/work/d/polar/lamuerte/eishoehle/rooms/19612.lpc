inherit "std/room";

#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "Eine eiskalte Schneehoehle" );
   SetProp(P_INT_LONG,  "Du findest Dich in einer eiskalten Schneehoehle wieder. "+
         "Riesige Schnee- und Eishaufen liegen hier herum. Das alles hast Du dieser "+
         "bloeden Lawine zu verdanken, welche Dich hier hergebracht hat. Du fuehlst, "+
         "dass es ziemlich kalt hier drinnen ist. Hoffentlich holst Du Dir keine Frost"+
         "beulen." );

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -15]));

   AddItem(NPC("original_yeti"), REFRESH_DESTRUCT);

   AddDetail(({"hoehle","schneehoehle"}),
    "Hier liegen dank der Lawine, welche Dich hier heruntergebracht hat, "
    "Unmengen von Schnee herum. ");
   AddDetail("schnee",
    "Weiss, weisser, schneeweiss ist er hier.");
   AddDetail("eis",
    "Das eis ist glatt, kalt und durchsichtig.");
   AddDetail(({"haufen","schneehaufen","eishaufen"}),
    "Die Haufen sind ueberdimensional gross.");
   AddDetail("lawine",
    "Tja, die hat Dich wohl erwischt.");
   AddDetail(({"beulen","frostbeulen"}),
    "Du hast noch keine.");
   AddDetail("richtung",
    "Bist Du ein Untersuchescript?");
   AddDetail(({"wand","waende"}),
    "Ein Grossteil der Waende ist von der Lawine verschuettet worden.");
   AddDetail("boden",
    "Alles voller Schnee. Dank der Lawine, oder besser, dank Dir!");
   AddDetail("decke",
    "Keine Eiszapfen zu sehen auf dieser Decke. Entweder es ist zu kalt, "+
    "oder sie sind runtergefallen als Du mit der Lawine runtergeplumpst "+
    "bist.");
   AddDetail("boden",
    "Der Boden ist mit Schnee ueberfuellt.");
   AddDetail("palme",
    "Pfoa! Also Du kannst fast kein Spieler sein.");

   AddExit( "rauf", "./19626" );

}
