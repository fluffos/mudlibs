inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Als Du so durch die Hoehle in dieser eisigen Welt gehst, "+
         "kannst Du es Dir nicht verkneifen, ueber diese seltsamen Umstaende nachzudenken. "+
         "Was fuer Kreaturen koennen das nur sein die in solch einer Hoehle leben? "+
         "Vor allem bei diesen Temperaturen? Naja, hoffentlich empfangen sie Dich mit "+
         "einer heissen Tasse Tee. Hoffentlich... Die Hoehle fuehrt weiter in den "+
         "Norden und Osten. ");

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -10]));

   AddItem( NPC("iceman") , REFRESH_REMOVE );

   AddDetail("hoehle",
    "Du untersuchst die Hoehle. Es scheint ihr hervorragend zu gehen.");
   AddDetail("boden",
    "Der Boden besteht aus hartem Eis.");
   AddDetail("decke",
    "Selbst die Decke besteht hier aus Eis.");
   AddDetail(({"wand","waende"}),
    "Selbst die Waende sind aus kaltem Eis geformt.");
   AddDetail("eis",
    "Das Eis ist steinhart und sehr kalt.");
   AddDetail( ({"hohele","welt"}),
    "Brrr... Das es auch ueberall so kalt ist hier drinnen.");
   AddDetail("kreaturen",
    "Keine da, oder doch?!?");
   AddDetail(({"temperatur","temperaturen"}),
    "Naja, doch einigermassen kuehl hier.");
   AddDetail(({"tasse","tee"}),
    "Na, das war wohl eine Illusion.");

   AddExit( "osten", "./19645" );
   AddExit( "norden", "./19642" );

}
