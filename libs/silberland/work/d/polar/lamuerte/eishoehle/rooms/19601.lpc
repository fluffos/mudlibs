
inherit "std/room";

#include <properties.h> 
#include <language.h> 
#include "files.h"

void create()
{
   ::create();
   SetProp(P_INT_SHORT,  "In einer kleinen Erdhoehle" );
   SetProp(P_INT_LONG,  
       "Du naeherst Dich dem Eingang einer kleinen, sehr abgelegenen " 
       "Hoehle, weit weit weg vom guten alten Midas. Die vielen Spuren, welche sich am " 
       "Boden befinden, lassen darauf schliessen, das doch einige Menschen oder Kreaturen " 
       "hier drinnen leben koennten. Die Hoehle fuehrt hier von Osten nach Westen weiter. "
       "Im Sueden scheint es zum Eingang der Hoehle zu gehen.");
     
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddDetail("menschenspuren",
    "Die Spuren scheinen tatsaechlich von Menschen zu stammen.");
   AddDetail("eingang",
    "Hmm.. Sieht interessant aus. Vielleicht solltest Du Dich weiter rein " 
    "wagen.Oder besser doch nicht?! ");
   AddDetail("hoehle",
    "Tjo, Du stehst inmitten drinnen. ");
   AddDetail("midas",
    "*schluchz* Du hast irgendwie Heimweh.");
   AddDetail(({"spur","spuren"}),
    "Sieht nach Menschenspuren aus. Fuer Dich jedenfalls.");
   AddDetail("boden",
    "Du erkennst einige Spuren im erdigen Boden.");
   AddDetail(({"mensch","menschen"}),
    "Hmm.. War da nicht noch eben wer?!");
   AddDetail(({"kreatur","kreaturen"}),
    "Na hoffentlich sind es doch Menschen und keine Kreaturen.");
   AddDetail("decke",
    "Es ist zu dunkel. Du kannst die Decke nicht genau erkennen.");
   AddDetail(({"wand","waende"}),
    "Fuehlen sich feucht an.");  
   AddDetail( "eingang",
    "Der Eingang zu dieser Hoehle scheint im Sueden zu sein.");   
   
   AddExit( "osten","./19606" );
   AddExit( "sueden","./19600" );
   AddExit( "westen","./19602" );


}
