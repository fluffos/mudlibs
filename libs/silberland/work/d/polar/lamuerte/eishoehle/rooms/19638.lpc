inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "A eisige Hoehle" );
   SetProp(P_INT_LONG,  "Die Umgebung hier ist karg und monoton. Die einzigen Dinge "+
         "die hier zu sehen sind, sind die grossen Schneehaufen, welche am Boden "+
         "herumliegen. An manchen Stellen bilden die Eiskristalle richtige Muster an "+
         "den Waenden. Die Hoehle fuehrt weiter in den Sueden und Westen.");   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -10]));

   AddItem(NPC("snowman.lpc"), REFRESH_DESTRUCT);
   
   AddDetail("umgebung",
    "Du fragst Dich, was Dich bloss veranlasst hat, in solch eine langweilige "+
    "Gegend zu gehen.");
   AddDetail("gegend",
    "Vielleicht waren es die Fp? Oder Ep? *grins*");
   AddDetail( ({"ep", "fp"}),
    "Du hast jetzt sicher einen mehr!");
   AddDetail("dinge",
    "Nein, die sind wirklich nicht spannend.");
   AddDetail(({"schnee","haufen","schneehaufen"}),
    "Weiss und ziemlich kalt.");
   AddDetail("boden",
    "Einige Schneehaufen liegen am Boden herum.");
   AddDetail("stellen",
    "Naja, an den Waenden zum Beispiel.");
   AddDetail(({"wand","waende"}),
    "An manchen Stellen der Waende sine Eiskristalle zu sehen.");
   AddDetail(({"kristalle","eiskristalle"}),
    "Sie sehen sternfoermig aus.");
   AddDetail("muster",
    "Die Muster sehen zufaellig aus.");
   AddDetail("decke",
    "Du findest nichts Besonderes an der Decke."); 
   
   AddExit( "sueden", "./19639" );
   AddExit( "westen", "./19635" );



}
