inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

    

   SetProp(P_INT_SHORT,  "Ein Durchgang in der Hoehle" );
   SetProp(P_INT_LONG,  "Die Luft in diesem Hoehlendurchgang scheint kaelter zu werden, "+
         "viel kaelter als Du gedacht hast. Teilweise scheinen die Waende schon gefroren "+
         "zu sein. Einige Eisblumen haben sich auf einer der Waende geformt. Die oestliche "+
         "Wand scheint durch die Kaelte einen grossen Riss zu haben. Der Durchgang "+
         "verlaeuft weiter in westlicher Richtung.");
     
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddDetail("luft",
    "Brrr.. ganz schoen kalt hier drinnen.");
   AddDetail(({"gang","durchgang","hoehlendurchgang"}),
    "Teilweise ist der Durchgang schon vereist.");
   AddDetail(({"wand","waende"}),
    "Auf einer der Waende haben sich Eisblumen gebildet. Auffallend ist auch "+
    "die oestliche Wand mit dem grossen Spalt.");
   AddDetail(({"blumen","eisblumen"}),
    "Wow! Welche Pracht! Besser man greift sie nicht an, sonst schmelzen sie.");
   AddDetail(({"riss","spalt"}),
    "Hmm.. Der Riss scheint gross genug zu sein um in den Osten weiterzukommen.");
   AddDetail("kaelte",
    "Man kann sie zwar nicht sehen, aber spuern tut man sie auf jeden Fall.");
   AddDetail("boden",
    "Selbst der Boden scheint teilweise gefroren zu sein.");
   AddDetail("decke",
    "Ein langer Eiszapfen haengt von der Decke herunter.");
   AddDetail("eiszapfen",
    "Er glitzert im Licht Deiner Fackel.");
   AddDetail("licht",
    "Es ist hell.");
       

   SetProp(P_HIDE_EXITS, ({"osten"}) );
   AddExit( "osten", "./19611" );
   AddExit( "westen", "./19607" );

}
