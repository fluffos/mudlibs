inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Riesige, spitze Eiszapfen haengen hier von der Decke, anscheinend "+
         "nur um Deinen Koerper zu stechen und Deine Seele zu quaelen. Am Boden sind einige "+
         "Schneehaufen und Eisbrocken zu sehen. Ein unheimliches tappendes Geraeusch ist ganz "+
         "in Deiner Naehe zu hoeren. Die Hoehle fuehrt im Osten, Norden und Westen weiter. ");

   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -13]));

   AddItem( NPC("ice_cubes"), REFRESH_DESTRUCT );
   AddItem( NPC("iceman"), REFRESH_REMOVE  );
   
   AddSound(DEFAULT_SOUND,
    "Du hoerst ein Knirschen.");
   AddSound("knirschen",
    "Hoert sich an als ob da jemand im Schnee herumlaeuft.");
   
   AddDetail("abenteurer",
    "Den hats erwischt.");
   AddDetail("decke",
    "Viele spitze Eiszapfen haengen herunter.");
   AddDetail(({"zapfen","eiszapfen"}),
    "Hoffentlich faellt keiner herunter und erschlaegt Dich.");
   AddDetail("koerper",
    "Also, mehr als Kaelte spuerst Du von Deinem Koerper nicht mehr.");
   AddDetail("kaelte",
    "Kalt...Ja...Sehr kalt...");
   AddDetail("seele",
    "Du bist Dir nicht sicher ob Du sowas ueberhaupt besitzt.");
   AddDetail("boden",
    "Einige Schneehaufen sind zu sehen, nichts aufregendes.");
   AddDetail("schnee",
    "Brrrr.. ist der kalt.");
   AddDetail("eis",
    "Das Eis ist hier weiss!");
   AddDetail(({"schneehaufen","haufen"}),
    "Pass auf, dass Du nicht reinsteigst, sonst wird Dir noch kaelter "+
    "als Dir eh schon ist.");
   AddDetail(({"eisbrocken","brocken"}),
    "Die Eisbrocken sind ganz schoen gross. Unter einem der Eisbrocken "+
    "ist eine Leiche zu sehen.");
   AddDetail("leiche",
    "Tja, da hat es einen Abenteurer erwischt. Lass ihm seinen Frieden.");
   AddDetail("frieden",
    "Du sollst ihn einfach in Ruhe lassen.");
   AddDetail("ruhe",
    "Lass ihn einfach!");
   AddDetail(({"wand","waende"}),
    "Die Waende sind mit Eis ueberzogen. Das hast Du doch schonmal wo gesehen.");
   AddDetail(({"hoehle","eishoehle"}),
    "Die Hoehle fuert von hier aus nach Westen, Norden und Osten.");

   AddExit( "norden", "./19636" );
   AddExit( "westen", "./19632" );

   AddGuardedExit( "osten", ROOM("19634") , "enpc",
    "Das eisige Wesen laesst Dich nicht vorbei.\n" );
        
        
}
