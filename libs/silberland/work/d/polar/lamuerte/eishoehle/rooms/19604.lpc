inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"


create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer erdigen Hoehle" );
   SetProp(P_INT_LONG,  "Ein Gang der Hoehle endet hier. Du stellst fest, dass dieser Raum hier "+
         "vergroessert wurde. Wahrscheinlich hatte sich hier eine grosse Kreatur eingenistet. "+
         "Einige Knochenhaufen liegen hier am Boden herum. Dem Zustand der Knochen "+
         "nach zu urteilen, wurden sie gewaltsam auseinandergebrochen. Sieht so aus als "+
         "haette hier ein Hoehlenbaer gefruehstueckt." );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddItem( NPC("bear_cave"), REFRESH_REMOVE);
 
   AddDetail("gang",
    "Der Gang endet hier in einem etwas groesseren Raum.");
   AddDetail("kreatur",
    "Keine da? Glueck gehabt. Oder?!");
   AddSpecialDetail(({"knochen","haufen","knochenhaufen"}),
    "wfunc"); 
   AddDetail("boden",
    "Einige gebrochene Knochen liegen am Boden herum.");
   AddDetail(({"baer","hoehlenbaer"}),
    "Nein?! Wo is einer?! HILFE! Schnell weg!!!");
   AddDetail("decke",
    "Du kannst nichts besonderes an der Decke finden.");
   AddDetail(({"hoehle","raum"}),
    "Der Raum hier ist etwas groesser als die anderen.");
   AddDetail(({"wand","waende"}),
    "Fuehlt sich kuehl und feucht an.");
   
   AddExit( "westen", "./19603" );

}

wfunc()
{
  string text;

  text = "Als Du die Knochen untersuchst, stellst Du fest, dass es sich um ";
  if ( member( ({ "Fee","Oger","Troll","Magier","Hobbit" }),
                  this_player()->QueryProp(P_RACE)) != -1 )
    text += this_player()->QueryProp(P_RACE)+"knochen ";
  else if ( this_player()->QueryProp(P_RACE) == "Untoter" )
    text += "Untotenknochen ";
  else
    text += this_player()->QueryProp(P_RACE)+"enknochen ";
    /*write(break_string("Als Du die Knochen untersuchst, stellst Du fest, dass es sich um "+
      this_player()->QueryProp(P_RACE)+"enknochen\nhandelt.",78));*/
  text += "handelt.";
  return (break_string(text)); 
}
