inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einem kleinen Spalt" );
   SetProp(P_INT_LONG,  "Du befindest Dich in einem kleinen Spalt. Dieser "+
         "Raum scheint keinen Boden zu haben. Wie kann das sein? Du kannst "+
         "den Raum unter Dir ganz genau sehen. Oh! Du stehst auf einer Eisplatte. "+
         "Wieso hat denn das keiner frueher gesagt... Du dachtest schon, dass Du "+
         "schweben wuerdest. Durch eine kleine Oeffnung im Eis kann man runter, "+
         "im Westen gehts durch den Spalt raus. " );

   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 0]));

   AddDetail( ({"spalt","raum"}),
    "Ziemlich eng hier drinnen.");
   AddDetail("raum",
    "Uff.. Fuer einen Moment dachtest Du, Du haettest den Boden unter "+
    "den Fuessen verloren.");
   AddDetail("boden",
    "Du stehst auf einer Eisplatte.");
   AddDetail(({"eisplatte","platte"}),
    "Eine wirklich dicke Eisplatte, man koennte denken man schwebt, wenn man "+
    "hindurchschaut.");
   AddDetail("oeffnung",
    "Man kann durch die Oeffnung nach unten.");
   AddDetail("eis",
    "Ziemlich kalt das Eis. Schade, dass es nicht Schokoladeneis ist...");
   AddDetail(({"wand","waende"}),
    "Die Waende in dem Spalt erdruecken Dich fast.");
   AddDetail("decke",
    "Du hast nicht genug Bewegungsraum um Deinen Kopf nach oben zu drehen.");
    
   SetProp(P_HIDE_EXITS, ({"runter", "unten"}) );  
 
   AddExit( "runter", "./19613" );
   AddExit( "unten", "./19613" );
   AddExit( "westen", "./19610" );

}



