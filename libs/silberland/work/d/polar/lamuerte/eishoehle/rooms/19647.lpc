inherit "std/room";
#include <properties.h>
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Du betrittst einen riesigen Saal. Es scheint aber nur "+
         "eine Art Vorraum zu sein. Kleine drachenfoermige Muster sind hier ueberall "+
         "eingeritzt. So kalt wie hier war es sonst noch nirgends in dieser "+
         "Hoehle. Schnell lauf weg, sonst erfrierst Du! Die Kaelte hier bringt "+
         "Deinen Atem beinahe zum stillstehen.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -28]));
   
   AddCmd(({"unt","untersuche","schaue"}),"sfunc");
    
   AddItem( NPC("ice_cubes"), REFRESH_DESTRUCT );
   AddItem( NPC("iceman"), REFRESH_DESTRUCT );
   AddItem( NPC("sloth_ice"), REFRESH_REMOVE);
   
   AddGuardedExit( "osten", ROOM("19648") , "enpc",
    "Das eisige Wesen laesst Dich nicht vorbei.\n" );
   AddExit( "westen", "./19643" );

}

sfunc()
{write("Dein Geist ist willig, das Fleisch jedoch schon schwach. Du hast einfach\n"+
 "nicht die Nerven, Dich bei dieser Kaelte umzusehen. Schnell geh weiter sonst\n"+
 "erfrierst Du wirklich noch. Ausgaenge sind im Osten und Westen. \n");
 return 1;
}

