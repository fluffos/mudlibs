inherit "std/room";

#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer erdigen Hoehle" );
   SetProp(P_INT_LONG,  "Der Tunnel im Hoehlensystem endet hier schlagartig in einer "+
         "Sackgasse. Die Waende dieses Hoehlenraums bestehen aus dunkelroter Erde. "+
         "Tiefe Rillen in den erdigen Waenden lassen darauf zurueckschliessen, dass "+
         "dieser Raum erst vor kurzem entstanden ist. Kalter, erdiger Geruch erfuellt "+
         "den Raum. Die Hoehle verlaeuft im Osten weiter. " );

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddSmell(DEFAULT_SMELL,
    "Es riecht nach Erde.");
   AddSmell("erde",
    "Riecht ziemlich humusreich.");
   AddSmell("geruch",
    "Es riecht erdig.");   
   
   AddDetail("boden",
    "Du untersuchst den Boden, findest aber nichts.");
   AddDetail("system",
    "Scheint weit verzweigt zu sein.");
   AddDetail("krallen",
    "Pfoa, das muessen verdammt grosse Krallen gewesen sein.");
   AddDetail("tunnel",
    "Aehm, hier ist es eher ein Raum, kein Tunnel.");
   AddDetail( ({"hoehle","raum","hoehlenraum"}),
    "Es sieht aus, als waere dieser Raum erst vor kurzem entstanden.");
   AddDetail("hoehlensystem",
    "Das Hoehlensystem endet hier in einer Sackgasse.");
   AddDetail("erde",
    "Die Erde ist dunkelrot und ziemlich kuehl.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind feucht und sehr kuehl.");
   AddDetail(({"gasse","sackgasse"}),
    "Ende, finito, aus. Hier gehts nicht weiter.");
   AddDetail("rillen",
    "Du fragst Dich, welches Ungetuem so grosse Klauen hat um solche "+
    "Rillen zu hinterlassen."); 
   AddDetail("decke",
    "Es ist zu dunkel um genaueres von der Decke zu erkennen.");
   AddDetail("ungetuem",
    "Wo? Ist eins da?! Hilfe! Schnell weg!");
   AddDetail("klauen",
    "Hmm.. Kein Ungetuem, keine Krallen.");
 
   AddExit( "osten", "./19603" );
 


}
