inherit "/std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer kleinen, schmutzigen Hoehle" );
   SetProp(P_INT_LONG,  "Kleine Schneekristalle und duenne Eisplatten bilden sich hier ueber "+
         "den rauhen, kalten Waenden. Die Luft ist duenn, bitterkalt und mit einem Geruch erfuellt "+
         "welcher Dich an verrottetes Fleisch erinnert. Kleine Haufen von Schnee und Eis liegen am "+
         "Boden, obwohl, eigentlich kann es ja kaum Schnee geben in einer Hoehle. Die Hoehle "+
         "verlaeuft in suedwestlicher Richtung weiter." );

   AddItem( NPC("ice_cubes"), REFRESH_DESTRUCT);   

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -8]));

   AddSmell(DEFAULT_SMELL,
    "Es riecht ekelhaft.");
   AddSmell("fleisch",
    "Ja, Du hast recht, es riecht tatsaechlich nach verrottetem Fleisch.");
    

   AddDetail(({"eiskristalle","kristalle","schneekristalle"}),
    "Die Kristalle reflektieren das Licht Deiner Fackel.");
   AddDetail("licht",
    "Es ist hell.");
   AddDetail(({"eisplatten","platten"}),
    "Die Eisplatten sind hier hauchduenn. Man kann die Waende hinter ihnen sehen.");
   AddDetail(({"wand","waende"}),
    "Die Waende sehen rauh und uneben aus.");
   AddDetail("luft",
    "Man kann sie nicht sehen, aber trotzdem, sie ist furchtbar kalt.");
   AddDetail("fleisch",
    "Kein Fleisch zu sehen.");
   AddDetail("schnee",
    "Der Schnee ist weiss und bitterkalt.");
   AddDetail("eis",
    "Du untersuchst das Eis, findest aber nichts.");
   AddDetail("haufen",
    "Die Haufen bestehen aus Schnee und Eis.");
   AddDetail("hoehle",
    "Die Hoehle waer nicht gerade der richtige Ort fuer ein Picknick. "+
    "Brr.. Ist es hier kalt.");
   AddDetail("picknick",
    "Hoer schon auf, hier kann man nicht Picknicken.");
   AddDetail("boden",
    "Der Boden ist steinhart. Sieht so aus als ob er gefroren sei.");
   AddDetail("decke",
    "Die Decke ist mit vielen winzigen Eiskristallen ueberzogen.");
          

   AddExit( "sueden", "./19624");
   AddExit( "westen", "./19622" );

}
