inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eiskalten Hoehle" );
   SetProp(P_INT_LONG,  "Die Luft ist hier feurig kalt. Einige weisse Woelkchen steigen aus "+
         "Deinen Nasenloechern auf. Der Aufbau dieser Hoehle ist verwirrend. Es gibt ja nicht "+
         "gerade viele Anhaltspunkte die es Dir ermoeglichen, Dich zu orientieren. Die Hoehle "+
         "fuehrt nach Sueden und Westen.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -13]));

   AddItem( NPC("iceman"), REFRESH_REMOVE );
   
   AddSmell(DEFAULT_SMELL,
    "Es ist zu kalt um noch irgendwas zu riechen.");
   
   AddDetail("luft",
    "Die Luft ist wirklich beissend kalt.");
   AddDetail("woelkchen",
    "Die Woelkchen steigen im Takt Deiner Atemfrequenz aus Deiner Nase "+
    "empor.");
   AddDetail("takt",
    "Einatmen, Ausatmen, Einatmen, Ausatmen...");
   AddDetail("atem",
    "Dein Atem stockt ein wenig bei dieser Kaelte.");
   AddDetail(({"frequenz","atemfrequenz"}),
    "Naja, wird so ungefaehr bei 30 mal in der Minute liegen.");
   AddDetail("minute",
    "Hmm.. Ja? Echt? Schau mal auf Deine Uhr.");
   AddDetail("uhr",
    "Hast Du keine? Probier mal zeit aus.");
   AddDetail("nase",
    "Deine Nase gleicht einem Eisklotz.");
   AddDetail(({"klotz","eisklotz"}),
    "Ein quaderfoermiges Ding aus Eis.");
   AddDetail("ding",
    "Dooooooooonnnnnnnnnnnnnngggggggggggggggggg!");
   AddDetail("hoehle",
    "Bald kennst Du Dich ueberhaupt nicht mehr aus hier drinnen.");
   AddDetail(({"punkte","anhaltspunkte"}),
    "Wie willst Du die untersuchen, wenn doch kaum welche da sind.");
   AddDetail("boden",
    "Der Boden besteht aus Schaumstoff.");
   AddDetail("schaumstoff",
    "OH! Typo! War doch Eis.");
   AddDetail("eis",
    "Das Eis ist eisig kalt.");
   AddDetail("decke",
    "Nix besonderes zu finden an der Decke. Nur Eis.");
   AddDetail("aufbau",
    "Wirklich ziemlich konfus.");   
   AddDetail(({"wand","waende"}),
    "Du kannst diese eisigen Waende schon nicht mehr anschauen.");
   
   AddExit( "sueden", "./19635" );
   AddExit( "westen", "./19633" );


}
