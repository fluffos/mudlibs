inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "Eine eiskalte Hoehle" );
   SetProp(P_INT_LONG,  "Diese Hoehlen scheinen in den Schnee und das Eis gegraben "+
         "worden zu sein. Das scheint aber nur so, denn in Wirklichkeit sind es Erdhoehlen "+
         "welche ueber die Jahre mit Schnee und Eis ueberzogen worden sind. Es ist auffaellig, "+
         "dass der Schnee am Boden reinweiss und flaumig ist. Komisch wenn man bedenkt, "+
         "dass es in einer Hoehle ja eigentlich gar nicht schneien kann.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -3]));

   AddItem( NPC("sloth_ice"), REFRESH_REMOVE );
   
   AddDetail(({"hoehle","hoehlen","eishoehle"}),
    "Es ist eisig kalt hier drinnen, schnell, pack Deine Sachen und "+
    "lauf wieder raus.");
   AddDetail("sachen",
    "Du solltest ja schon selbst wissen was Deine Sachen sind.");
   AddDetail("schnee",
    "Der Schnee ist hier ganz locker und weich.");
   AddDetail("eis",
    "Das Eis ist hart wie Granit.");
   AddDetail("granit",
    "Du wirst wohl nie aufgeben nach FPs zu suchen...");
   AddDetail(({"erdhoehle","erde","erdhoehlen"}),
    "In diesem Zustand der Hoehle wuerde man doch eher von Eishoehle "+
    "als von Erdhoehle sprechen.");
   AddDetail("zustand",
    "Der Zustand der Hoehle ist: VEREIST");
   AddDetail("wirklichkeit",
    "Nur in Mud Wirklichkeit, keine Angst.");
   AddDetail("angst",
    "Was soll ANGST Sein?");
   AddDetail("jahre",
    "Muss schon einige Zeit her sein, dass diese Hoehlen entstanden sind.");
   AddDetail("boden",
    "Der Boden ist mit flauschigem Schnee bedeckt.");
   AddDetail("decke",
    "Oh ja, eine Decke waer jetzt genau das Richtige. Brrrr.. Ist es kalt hier.\n"+
    "Jemand grinst Dich an.\n");
   AddDetail(({"wand","waende"}),
    "Die Waende sehen irgendwie karg aus.");

   AddExit( "osten", "./19633" );
   AddExit( "sueden", "./19631" );

}
