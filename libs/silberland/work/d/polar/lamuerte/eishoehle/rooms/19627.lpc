inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer kalten Eishoehle" );
   SetProp(P_INT_LONG,  "Es ist ziemlich kalt hier drinnen. Die Waende und der Boden sind "+
         "hier komplett zugefroren. Ueberall haengen lange Eiszapfen herum. Aus dem Osten hoerst "+
         "den dumpfen heulenden Klang des Windes. Eine kalte Brise weht durch diesen Tunnel. "+
         "Der Tunnel erweitert sich in den Norden, Osten und Sueden." );

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -1]));

   AddSound(DEFAULT_SOUND,
    "Du hoerst den Wind blasen.");
   AddSound("wind",
    "Der Wind blaest Dir in die Ohren.");
   AddSound("klang",
    "*****>>>>  K  L   A  NN GGGG G!! ! !! <<<<<******");
    
   AddDetail(({"wand","waende"}),
    "Die Waende sind gefroren. Viele Eiszapfen haengen herum.");
   AddDetail("boden",
    "Selbst der Boden ist gefroren.");
   AddDetail("eiszapfen",
    "Die Eiszapfen bestehen aus reinem, durchsichtigen Eis.");
   AddDetail("eis",
    "Hier gibts so viel Eis, dass Du gar nicht weisst wo Du anfangen sollst "+
    "zu schauen.");
   AddDetail("brise",
    "Du schaetzt, dass sogar die Luft unter null Grad hat.");
   AddDetail("luft",
    "Die Luft ist wirklich kalt hier drinnen.");
   AddDetail("tunnel",
    "Als Du den Tunnel genauer betrachtest faellt Dir ein Spalt auf.");
   AddDetail("spalt",
    "Der Spalt ist ca. 10 cm. lang. Du erkennst ein Schimmern in ihm.");
    AddDetail("schimmern",
     "Das Schimmern ist hell. Es sieht aus als wuerde ein Diamant in dem "+
     "Spalt stecken.");
    AddDetail("diamant",
     "Oh, welch ein Pech, es war doch nur ein Eiskristall.");
    AddDetail(({"kristall","eiskristall"}),
     "Die Kristalle funkeln im Licht Deiner Fackel.");
    AddDetail("licht",
     "Das Licht ist hell.");
    AddDetail("decke",
     "Einige Eiszapfen haengen von der Decke.");
    
   AddExit( "norden", "./19628");
   AddExit( "osten", "./19629");
   AddExit( "sueden", "./19626");

}
