inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer erdigen Hoehle" );
   SetProp(P_INT_LONG,  "Wildes Geheule einer schrecklichen Kreatur schallt durch die "+
         "Gaenge der Hoehle. Es scheint als wuerden diese schrecklichen Laute immer naeher "+
         "kommen und dann wieder verstummen. Du fuehlst, dass es hier wirklich gefaehrlich "+
         "werden koennte. Wenn es einen Zeitpunkt fuer die Umkehr gibt, dann ist jetzt "+
         "der Richtige dafuer. Die Hoehle fuehrt im Norden und Westen weiter. " );
      
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddSound(DEFAULT_SOUND,
    "Du hoerst ein lautes: Huuuuuuujhuuuuuuuuuhuuauuuuu!!!");
   AddSound(({"geheule","laute"}),
    "Du bekommst eine Gaensehaut, als Du genauer hinhoerst.");
   
   AddDetail("erde",
    "Die Erde ist braun und matschig.");
   AddDetail( ({"laute","geheule"}),
    "Uiii, das hoert sich gar nicht gut an.");
   AddDetail("hoehle",
    "Du befindest Dich in hier.\n");
   AddDetail(({"gang","gaenge"}),
    "Du untersuchst alles, findest aber nichts.\n"); 
   AddDetail("zeitpunkt",
    "Los, schnell weg von hier!");
   AddDetail("umkehr"
    "Jaja, bloss weg!");
   AddDetail(({"richtig","richtige"}),
    "Mach schon, hau ab bevor Dich die Kreatur erwischt.");
   AddDetail("hohle",
    "Du bist von lauter Erde umgeben. Boden, Waende, Decke, alles "+
    "aus Erde.");
   AddDetail("boden",
    "Du untersuchst den Boden, findest aber nichts.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind warm und bestehen aus Erde.");
   AddDetail("decke",
    "Die Decke besteht aus reinster Erde."); 
   AddDetail("kreatur",
    "Hmm.. Keine wirkliche Kreatur da. Oder?");

   
   AddExit( "norden", "./19607" );
   AddExit( "westen", "./19601" );
}
