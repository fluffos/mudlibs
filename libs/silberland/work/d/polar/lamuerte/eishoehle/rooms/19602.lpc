
inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

string efunc;

create()
{
   ::create();

    

   SetProp(P_INT_SHORT,  "In einer erdigen Hoehle" );
   SetProp(P_INT_LONG,  "Du befindest Dich in einer kleinen Hoehle. Jetzt wo Du schon "+
         "weiter ins Innere der Hoehle vorgedrungen bist, stellst Du fest, dass die "+
         "Hoehle gar nicht so klein ist. Sieht so aus als ob das Hoehlensystem doch "+
         "um einiges groesser ist als Du dachtest. Ein modernder Geruch haengt in der "+
         "Luft. Die Hoehle erstreckt sich in nordoestlicher Richtung weiter. ");

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddExit( "norden", "./19603" );
   AddExit( "osten", "./19601" );

   AddSmell(DEFAULT_SMELL,
    "Es riecht nach faulen Eiern.");
   
//   AddSmell(({"eier","ei"}),
//    #'efunc);

    AddSmell(({"eier","ei"}),
    "Das stinkt wirklich fuerchterlich.");
    AddSmell("geruch",
    "Igitt! Hier stinkts fuerchterlich.");
 
   
   AddDetail("inneres",
    "Du stehst im Inneren innen drinnen.");
   AddDetail("berg",
    "Du stehst in ihm."); 
   AddDetail("hoehle",
    "Huiii, die Hoehle ist doch ganz schoen gross!");
   AddDetail( ({"innen","innere"}),
    "Es ist ziemlich dunkel hier. Hoffentlich passiert Dir nichts.");
   AddDetail(({"system","hoehlensystem"}),
    "Es scheint noch viel tiefer in den Berg hinein zu fuehren.");   
   AddDetail( ({"boden", "erde"}),
    "Der erdige Boden fuehlt sich feucht an.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind ziemlich kuehl.");
   AddDetail("decke",
    "Du siehst ein Funkeln auf der Decke.");
   AddDetail("funkeln",
    "Hin und wieder scheint sich auf der Decke ein Lichtstrahl "+
    "zu reflektieren.");
   AddDetail(({"licht","lichtstrahl"}),
    "Nur ab und an ist ein Lichtstrahl zu erkennen.");
   AddDetail("luft",
    "Es stinkt."); 
}

string efunc()
{if (this_player()->QueryProp(P_GENDER)!=FEMALE)
  {return ("Ihhh... Das stinkt... Sind das Deine?");
   //hehe
  }
  else
  {return("Das stinkt wirklich fuerchterlich.");
  }
}
