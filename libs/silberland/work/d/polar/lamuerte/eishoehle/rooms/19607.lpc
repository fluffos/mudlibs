inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

    

   SetProp(P_INT_SHORT,  "In einer erdigen Hoehle" );
   SetProp(P_INT_LONG,  "Dickfluessiger, brauner, zaehfluessiger Schleim rinnt langsam "+
         "von einer Wand in der Hoehle. Ein komischer nach verrottetem Fleisch riechender "+
         "Duft steigt Dir in die Nase. Aus dem Osten sind laute, kreischende "+
         "Schreie zu hoeren, welche Dir irgendwie bekannt vorkommen. Es scheint "+
         "als wuerde jeder Schrei auf einer eiskalten Windboe in den Raum "+
         "getragen, welche Du bis tief in Deine Knochen fuehlen kannst. "+
         "Ein Gang fuehrt weiter in den Norden und Osten."); 

   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));

   AddSound(DEFAULT_SOUND,
    "Du hoerst ein lautes: AAARGHHHHH!!!");
   AddSound("schreie",
    "Sie sind so laut, dass sie beinahe in den Ohren schmerzen.");
   AddSound("wind",
    "Brrrr.. Kalt!");
    
  
   AddSmell(DEFAULT_SMELL,
    "Es riecht nach verfaultem Fleisch.");
   AddSmell("fleisch", 
    "Als Du einen tiefen Atemzug nimmst, wird Dir kotzuebel.");
   AddSmell("duft",
    "Lieber nicht, Dir ist schon schlecht.");
   
   AddSpecialDetail("schleim",
    "sfunc");
   AddDetail("windboee",
    "Sie ist kalt. Ob es hier irgendwo ein warmes Plaetzchen gibt?");
   AddDetail("plaetzchen",
    "Schade, scheint keines da zu sein.");
   AddDetail("fleisch",
    "Es riecht nach verfaultem Fleisch, obwohl Du keines finden kannst.");
   AddDetail("wind",
    "Der Wind pfeift durch Deine Ohren.");
   AddDetail("knochen",
    "Deine Knochen scheinen aus Butter zu sein.");
   AddDetail("gang",
    "Die Erde aus der der Gang besteht, ist hier ziemlich kalt.");
   AddDetail("hoehle",
    "Die Hoehle besteht aus reiner Erde.");
   AddDetail("erde",
    "Hier ist die Erde dunkelbraun.");
   AddDetail("boden",
    "Du findest einige Fussabdruecke am Boden.");
   AddDetail(({"abdruecke","fussabdruecke","abdruck"}),
    "Hmm.. Ganz schoen gross, diese Abdruecke.");
   AddDetail("decke",
    "Es ist ziemlich dunkel hier drinnen, darum kann man nichs "+
    "genaueres von der Decke sehen.");
   AddDetail(({"wand","waende"}),
    "Die Waende bestehen aus Erde. Sie sind ziemlich kalt, fast schon "+
    "gefroren.");
     
   
   AddExit( "norden", "./19608" );
   AddExit( "osten", "./19610" );
   AddExit( "sueden", "./19606" );

}

sfunc()
{this_player()->reduce_hit_point(10+random(20));
 return("Autsch! Der Schleim veraetzt Dir die Finger.\n");
}
