inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "in einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Das ewige Durchstapfen von Schnee und Eis in dieser Hoehle ist "+
         "ein Alptraum. Die Chance sich hier drinnen zu verirren steigt mit jedem Schritt "+
         "den Du machst. Einige Spuren sind am Boden zu erkennen, doch Du kannst Dir einfach "+
         "nicht vorstellen, dass irgendeine Lebensform aus Fleisch und Blut hier unten in "+
         "dieser Kaelte ueberleben kann. Die Hoehle fuehrt in den Norden und "+
         "Osten weiter.");
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -16]));

   AddItem( NPC("yeti"),REFRESH_DESTRUCT );
   AddItem( NPC("ice_cubes"), REFRESH_DESTRUCT );
   
   AddDetail("eis",
    "Das Eis hat eine schoene Farbe.");
   AddDetail("farbe",
    "Die Farbe ist weiss.");
   AddDetail("schnee",
    "Es ist schon mehr Schnee als Eis zu sehen hier unten, da es schon so "+
    "kalt ist.");
   AddDetail(({"traum","alptraum"}),
    "Nicht traeumen, weitergehn!");
   AddDetail("chance",
    "Du wirst bald erfrieren. Du kannst es schon direkt spueren.");
   AddDetail("schritt",
    "Jeder Schritt ist eine Qual.");
   AddDetail("qual",
    "Es ist nicht angenehm bei dieser Kaelte hier rumzulaufen.");
   AddDetail("kaelte",
    "Du kannst nicht genau sagen wie kalt es ist, auf jeden Fall ist "+
    "es saukalt.");
   AddDetail("lebensform",
    "Ist da wer?!");
   AddDetail("fleisch",
    "Naja, Dein Fleisch fuehlt sich irgendwie schon gefroren an.");
   AddDetail("blut",
    "Dein Blut ist schon so zaeh wie Dicksaft.");
   AddDetail("dicksaft",
    "Ihhh.. Du hasst das Zeugs.");
   AddDetail("zeugs",
    "Na den Dicksaft, schon vergessen?!");
   AddDetail("hoehle",
    "Es is kalt hier drinnen.");
   AddDetail("boden",
    "Der Boden ist zugefroren. Einige Spuren sind zu erkennen.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind auch zugefroren. Welch ein Wunder!");
   AddDetail("wunder",
    "Naja, bei der Kaelte ist es ja eigentlich keins.");
   AddDetail("decke",
    "Es ist zu dunkel um etwas genaueres auf der Decke ausmachen "+
    "zu koennen.");
  AddDetail(({"spur","spuren"}),
    "Keine Ahnung von wem die sind.");
  AddDetail("ahnung",
    "Hast DU ja so und so keine.");
    
   AddExit( "norden", "./19634" );
   AddExit( "osten", "./19638" );


}
