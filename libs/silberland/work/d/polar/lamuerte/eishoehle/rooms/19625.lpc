inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Du erblickst eine kleine, enge Hoehle. Dieser Teil wurde in die "+
         "pure gefrorene Erde gegraben. Grosse Eismassen, Kristalle und Schnee haben aus dieser "+
         "Erdhoehle eine magisch funkelnde Eishoehle gemacht. Das Hoehlensystem setzt sich "+
         "im Norden und Westen fort. " );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -5]));

   AddItem( NPC("bear_polar"), REFRESH_REMOVE );
   
   AddDetail( ({"hoehle","eishoehle","teil"}),
    ([ 0:"Dieser Teil der Hoehle ist wunderschoen. Das Eis, die "
         "Kristalle und der Schnee lassen das Licht Deiner Fackel um "
         "ein Vielfaches heller erscheinen.",
    "dunkelelf":"Dieser Teil der Hoehle ist wunderschoen. Das Eis, die "
                "Kristalle und der Schnee scheinen zu funkeln.\n" ]));
   AddDetail( ({"eis","eismassen"}),
    "Die Eisgebilde in diesem Teil der Hoehle sind sagenhaft schoen.");
   AddDetail("eisgebilde",
    "Viele verschiedene Formen, geschaffen von Mutter Natur.");
   AddDetail("formen",
    "Sie sind einfach unbeschreiblich.");
   AddDetail(({"mutter","natur"}),
    "Sie hat ihr Bestes getan.");
   AddDetail("bestes",
    "Meinst Du jetzt die Formen? Oder wie?");
   AddDetail(({"kristall","kristalle"}),
    "Sie funkeln wunderhuebsch.");
   AddDetail("schnee",
    "Ueberall dieser Schnee, wo der nur herkommt?!");
   AddDetail("erde",
    "Eigentlich ist ja gar keine Erde mehr zu sehen, da sie mit Eis "+
    "ueberzogen ist.");
   AddDetail(({"erdhoehle","system","hoehlensystem"}),
    "Es fuehrt in den Westen weiter. Aja und im Norden auch noch.");
   AddDetail("boden",
    "Er besteht aus reinstem Eis.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind mit Eis beschichtet.");
   AddDetail("decke",
    "Da haengt ne Schnecke von der Decke.");
   AddDetail("schnecke",
    "Die Schnecke haengt im Eck he!");
   AddDetail("eck",
    "Schwapp! Das Eck ist ploetzlich weg.");
    


   AddExit( "norden", "./19626" );
   AddExit( "westen", "./19624" );


}
