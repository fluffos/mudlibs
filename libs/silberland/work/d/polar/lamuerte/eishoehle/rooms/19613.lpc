
inherit "std/room";

#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer Eishoehle" );
   SetProp(P_INT_LONG,  "Es ist eiskalt hier in der Hoehle. Kleine Eiskristalle "+
         "funkeln Dir von den Waenden entgegen. Als Du Dich wunderst warum Dir "+
         "ploetzlich so kalt auf den Fuessen wird, bemerkst Du, dass der Boden "+
         "mit weissem Schnee bedeckt ist. Die Hoehle fuehrt weiter in den Osten.");
      
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: 1]));
   
   AddDetail("licht",
    "Das Licht leuchtet hell.");
   AddDetail(({"hoehle","eishoehle"}),
    "Juhuu! Es liegt Schnee in der Hoehle!");
   AddDetail("schnee",
    "Der Schnee ist weiss und aeusserst kalt.");
   AddDetail(({"kristalle","eiskristalle"}),
            ([ 0 : "Im Licht Deiner Fackel sehen sie wundervoll aus.",
      "dunkelelf": "Du merkst, wie die Eiskritalle wundervoll funkeln."]));
   AddDetail(({"wand","waende"}),
    "Auf den Waenden befinden sich lauter kleine Eiskristalle.");
   AddDetail(({"fuss","fuesse"}),
    "Sehen schon ziemlich gefroren aus.");
   AddDetail("boden",
    "Es liegt Schnee am Boden.");
   AddDetail("decke",
    "Viele Eiszapfen haengen von der Decke.");   
   AddDetail("eiszapfen",
    "Es muessen mindestes 1, 2, 3.... 30 sein.");
    
   AddExit( "rauf", "./19611" );
   AddExit( "osten", "./19614" );

}
