inherit "std/room";
#include <properties.h>
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "In einer eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Du betrittst einen kleinen Raum. "+
         "Kleine geometrische Muster sind in die Waende eingeritzt. Das ist einer "+
         "der wenigen netten Raeume die Du in letzter Zeit gesehen hast. Irgendwie ist "+
         "es hier aber wirklich eisig kalt. Du denkst, dass man einfrieren wuerde, wenn "+
         "man laenger hier herumsteht. Die Hoehle verlaeuft im Norden und im Westen "+
         "weiter." );
   
   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -23]));
   
   AddCmd(({"unt","untersuche","schau","schaue"}),"sfunc");
    
   AddItem( NPC("ice_cubes"), REFRESH_DESTRUCT );

   AddExit( "norden", "./19643" );
   AddExit( "westen", "./19645" );
      


}

sfunc()
{write("Dein Geist ist willig, das Fleisch jedoch schon schwach. Du hast einfach\n"+
 "nicht die Nerven, Dich bei dieser Kaelte umzusehen. Schnell geh weiter sonst\n"+
 "erfrierst Du wirklich noch. Ausgaenge sind im Norden und Westen.\n");
 return 1;
}

