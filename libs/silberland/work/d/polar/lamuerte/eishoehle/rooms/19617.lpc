inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "Eine Sackgasse in der eisigen Hoehle" );
   SetProp(P_INT_LONG,  "Der Hoehlengang endet hier in einer Sackgasse. Dieser Raum "+
         "ist verhaeltnismaessig klein. Ueberall liegen Eisbrocken, Steine und "+
         "Schneehaufen herum welche alle Ausgaenge bis auf einen versperren. Es scheint "+
         "als ob es hier ziemlich rutschig waere. Der einzige Ausgang aus dem "+
         "Hoehlenraum liegt im Westen." );

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -3]));

   AddDetail(({"gang","hoehlengang"}),
    "Am Boden des Hoehlengangs liegen einige Steine und Eis herum.");
   AddDetail("boden",
    "Er ist mit Eis, Schnee und Steinen vollgestopft.");
   AddDetail(({"eis","eisbrocken"}),
    "Das Eis ist glatt und hat ca. -20 Grad.");
   AddDetail("schnee",
    "Der Schnee ist weiss und kalt.");
   AddDetail("steine",
    "Die Steine liegen ueberall in der Gegend herum.");
   AddDetail(({"wand","waende"}),
    "Die Waende bestehen aus Eis und Steinen.");
   AddDetail("decke",
    "Die Decke besteht aus purem Eis.");
   AddDetail(({"gasse","sackgasse"}),
    "Nada, nix. Umkehren ist angesagt.");
   AddDetail(({"raum","hoehlenraum"}),
    "Der Raum besteht grossteils aus Eis.");
   AddDetail(({"ausgang","ausgaenge"}),
    "Im Westen gehts raus aus dem Hoehlenraum.");
   AddDetail("schneehaufen",
    "Die Schneehaufen sind weiss, kalt und gross. *grins*");
      
   
   AddExit( "westen", "./19616" );


}
