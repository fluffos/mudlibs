inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "Die Hoehle des weissen Drachen" );
   SetProp(P_INT_LONG,  "Du betrittst eine klirrend eisige Hoehle. Dieser Raum "+
         "wird normalerweise von einem Eisdrachen bewohnt. Dein Atem begennt hier "+
         "drinnen langsam aber sicher zu stocken. Solch eine Kaelte hast Du auf "+
         "Deinem Koerper noch nie gespuert. Du wunderst Dich das ein Eisdrache "+
         "solche Temperaturen aushalten kann. Der einzige Ausgang liegt im Westen.");

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -30]));
   
   AddItem( NPC("ice_dragon"), REFRESH_REMOVE );
  
   AddDetail(({"eisschicht","schicht","eis"}),
    "Du kannst nichts Besonderes daran finden.");
   AddDetail(({"hoehle","raum"}),
    "Dies ist das zu Hause eines Eisdrachen.");
   AddDetail("atem",
    "Atem? Welcher Atem?");
   AddDetail("kaelte",
    "Also, Du schaetzt das es hier so um die -30 Grad hat.");
   AddDetail("koerper",
    "Das soll ein Koerper sein? Du fuehlst Dich eher wie ein Eisberg.");
   AddDetail(({"drache","eisrache","eisdrachen"}),
    "Sei froh wenn er nicht da ist!");
   AddDetail("ausgang",
    "Der Ausgang liegt im Westen.");
   AddDetail(({"temperatur","temperaturen"}),
    "Es ist furchtbar fuerchterlich eisig kalt hier. BRRRRRRR!");
   AddDetail("boden",
    "Der Boden ist mit einer dicken Eisschicht ueberzogen.");
   AddDetail("decke",
    "Die Decke besteht aus purem Eis.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind eisig kalt. Klar, sie bestehen auch aus Eis.");
   AddDetail("eisberg",
    "Ja, Du, Du fuehlst Dich wie einer.");  
   
   
   AddExit( "westen", "./19647" );

}
