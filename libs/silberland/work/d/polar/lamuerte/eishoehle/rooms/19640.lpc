inherit "std/room";
#include <properties.h> 
#include <language.h> 
#include "files.h"

create()
{
   ::create();

   SetProp(P_INT_SHORT,  "Eine eiskalte Hoehle" );
   SetProp(P_INT_LONG,  "Du fuehlst Dich ein bisschen verloren in dieser einsamen "+
         "kalten Hoehle. Du freust Dich schon darauf, wieder im guten alten Midas zu sein, "+
         "Dich zuruecklehnen zu koennen und ein gemuetliches Bier mit Deinen Freunden "+
         "geniessen zu koennen. Doch von hier ist es ein weiter Weg bis Midas. Leider. "+
         "Die Hoehle setzt sich im Norden fort." );

   SetProp(P_INDOORS,1);
   SetProp(P_LIGHT,0);
   SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE: -14]));

   AddItem( NPC("ice_cubes"), REFRESH_DESTRUCT );
   
   AddDetail("hoehle",
    "Du willst nur noch eins. RAUS aus dieser verdammten Hoehle.");
   AddDetail("midas",
    "Jaja, dort waers jetzt schoen.");
   AddDetail("bier",
    "Was solls, hier ist es so und so zu kalt fuer Bier.");
   AddDetail(({"freund","freunde","freunden"}),
    "Das einzige was Dich an sie erinnert ist Dein Freundschaftsband.");
   AddDetail("weg",
    "Bis Midas? Unendliche Weiten. ;-)");
   AddDetail("weiten",
    "Na, weit halt.");
   AddDetail("boden",
    "Pass auf das Du nicht anfrierst auf dem eisigen Boden.");
   AddDetail(({"wand","waende"}),
    "Die Waende sind zu tiefgefroren.");
   AddDetail("eis",
    "Schade, das ist nicht gerade Deine Lieblingssorte.");
   AddDetail(({"sorte","lieblingssorte"}),
    "Das muesstest Du doch selbst wissen, oder?!");
   AddDetail("decke",
    "Es gibt absolut nix auffaelliges an der Decke.");
    
   AddExit( "norden", "./19639" );


}
